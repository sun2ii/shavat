{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":18,"content":[{"type":"heading","content":["Etiopía-yargi-yoedse-ibmar-guoedgi sunmaklesad"]},{"type":"verse","number":1,"content":["Isaías sogdebalid:",{"text":"“Gwimar-uurmaked-yala, ¡nue-wilessun!","poem":1},{"text":"Cus-diwarba-bukmalad, ¡be duledar-wilesmar!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ur-nagwaryob-daklegedgi-sobaledba Nilo-diwarba","poem":1},{"text":"dule-garda-berbemalad-barmimalad, ¡be duledar-wilesmar!","poem":2},{"lineBreak":true},{"text":"”Dule-garda-berbemalad-gandik-nanamalad be gwae-namar,","poem":1},{"text":"dule-mullusurmaladse be namar,","poem":2},{"text":"uka-sichigwadba-uka-dakaar-gamaladse be namar,","poem":1},{"text":"we-dulemar-bela-dobesar-daklemaladse be namar,","poem":2},{"text":"dulemar-gargandikmaladse be namar,","poem":1},{"text":"dulegi-obin-san-sadimaladse be namar,","poem":2},{"text":"yala-emargi-obinsiidse be namar.","poem":1},{"text":"A-yala, diwarmar-iirmakmaid-yalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"”Bemar, bela we-napneggi-bukmalad, yar-imbaba bander-nakwiali be dakalile,","poem":1},{"text":"degi, gar-trompeta-gollali be itoarmalale,","poem":2},{"text":"asiki be atakbukwa imakmalo,","poem":1},{"text":"Napneggi-bela-bukmalad, nue be dakmalo, nue be itomalo.”","poem":2}]},{"type":"verse","number":4,"content":["Bab-Jehová weyob anga sogsad:",{"text":"“Isaías, an-neg-maid-akale, dulemar-nue-dakmai an imakoed.","poem":1},{"text":"An golosulid, bogi-mai an dulemar-dakmai imakoed.","poem":2},{"text":"Dad-ibeler yorgi-duurmaknadaeyobi,","poem":1},{"text":"bogidik-mai an dulemar-dakmai guoed.","poem":2},{"text":"Ibmar-welenaidgi dad-ibeler duurmaknaile, boo-mileardaeyobi,","poem":1},{"text":"bogidik-mai an dulemar-dakmai guoed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ar uva-weleged-iduale, e-dutu batialir, degi, nue-uva-san-nagualir, e-anagan an sike-sike imaknonikoed.","poem":1},{"text":"E-anagan-binigan an sike-sike imakoed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Deyobi, bela we-dulemar gumogoed.","poem":1},{"text":"Ibdurgan-sapurbarmaladga miledoed.","poem":2},{"text":"Yorgi, nuu-ibmar-burgwarmalad-gunmalad-masga guoed.","poem":1},{"text":"Dii-wied-ibagangine, bela ibdurgan-sapurbarmalad-masga guoed.”","poem":2}]},{"type":"verse","number":7,"content":["A-ibagangine, we-dulemar Bab-Jehová-Bela-Gangued-Nikadga ibmar-ukleged sedmaloed. We-dulemarde, dule-mullusurmaladid, uka-sichigwadba uka-dakaar-gamaladid. We-dulemar, bela-dobesar-daklemaladid, dulemar-gargandikmaladid, dulegi-obin-san-sadimaladid. A-yala, diwarmar-iirmakmaid-yalad. A-dulemarde, Bab-Jehová-Bela-Gangued-Nikadga ibmar-ukleged sedmaloed. Sión-yalase ega sedmaloed, bia Bab-Jehová-Bela-Gangued-Nikad-e-nug-obarilege, ase Bab-Jehováʼga ibmar-ukleged sedmaloed."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/17.json","previousChapterAudioLinks":{},"numberOfVerses":7}