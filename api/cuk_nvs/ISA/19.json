{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":19,"content":[{"type":"heading","content":["Egiptoʼgi-yoedse-ibmar-guoedgi sunmaklesad"]},{"type":"verse","number":1,"content":["Egipto-yar-guoedgi iduakwaa sunmaklesad:",{"text":"Bab-Jehová be dakmala.","poem":1},{"text":"Mogir-gwae-gwae-iirmakmaid-birgi-sii, Egipto-yalase danikid.","poem":2},{"text":"Egipto-e-bab-dummagan e-abin wawanmakbukwad.","poem":1},{"text":"Egipto-dulemar nue dobe-itomalad.","poem":2}]},{"type":"verse","number":2,"content":["Bab-Jehová soged:",{"text":"“Egipto-dulemar na abin-abin-urwemalaga an imakoed,","poem":1},{"text":"na e-gwenad-e-gwenad-egi-gwisgumalaga an imakoed,","poem":2},{"text":"dulemar-na-e-aimarbo-urwega an imakoed,","poem":1},{"text":"neggweburmar-na-abin-abin-urwemalaga an imakoed,","poem":2},{"lineBreak":true},{"text":"yalamar-na abin-abin-urwemalaga an imakoed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Egipto-dulemar suli-suli itodamaloed,","poem":1},{"text":"bab-dummadyob-imaklemaladse idakdemaloed.","poem":2},{"text":"Dule-burgwarmalad-e-burbase idakdemaloed,","poem":1},{"text":"bab-dummad-gayaburba-barsoged-bundorse idakdemaloed.","poem":2},{"text":"Yoo-ibmar-guoed-soged-dulese idakdemaloed, anmar ibu imakoye.","poem":1},{"text":"Degi-inigwele, e-igarmar igarga-guega an imakosulid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Egipto-dulemargi dule-bulegan yar-seega an imakoed.","poem":1},{"text":"Rey-isgana yar-seega an imakoed.","poem":2},{"text":"Ani Bab-Jehová-Bela-Gangued-Nikad soged.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"”Demar-naid dingudoed,","poem":1},{"text":"Nilo-diwar-maid bela dinna naoed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dian-akwiar-mamaid sunnasuli yapanne gudoed,","poem":1},{"text":"Nilo-diimar-iirmakmaidi, iremai gudoed, bela dinna naoed.","poem":2},{"lineBreak":true},{"text":"Nallayob-daklemaladi, degi, nagwaryob-daklemaladi, bela burgwidoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nilo-diwar-gakaba ibmar-digarmaladi, bela burgwidoed,","poem":1},{"text":"Nilo-diwar-gakaba ibmar-nanaidi, bela bergudoed,","poem":2},{"lineBreak":true},{"text":"bela swiri naoed, bar daklegosulid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bela dule Nilo-diwargi-ua-somaladi, degi, bela saki-miar-ua-gamaladi, bukib binsadmaloed,","poem":1},{"text":"bela bodmaloed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bela dule lino-mor-nued-sobedgi-arbamaladi, degi, saki-sobedgi-arbamaladi,","poem":1},{"text":"suli-suli itodamaloed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ua-galugi-arbamaladi, nue-wiles itodamaloed,","poem":1},{"text":"ar bela e-sakimar itiridoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”Zoán-neggwebur-e-dummagan, dule-binsaed-ibedye be sogdimalad,","poem":1},{"text":"bemar dule-gegeganad.","poem":2},{"text":"Ar bemar Faraónʼga binsaed-isgana ukdimalad.","poem":1},{"text":"Ar igi yogasaar bemar sogmalosunna:","poem":2},{"lineBreak":true},{"text":"‘Anmar binsaed-ibedye, epenne-reymar-binsaed-ibegan-megismaladse binsaed amismaladye.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"”Egipto-rey, ¿be-dule-binsaed-ibegande bega igigudmarsunna?","poem":1},{"text":"Emide, be-dule-binsaed-ibegan bega sogmardo,","poem":2},{"text":"ibu Bab-Jehová-Bela-Gangued-Nikadi, Egipto-dulemargi imaksokali,","poem":1},{"text":"igi-Egipto-dulemar-idu igar-amismaidi, bega sogmarbardo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Zoán-neggwebur-e-dummagan dule-binsaedsulidga nadmalad,","poem":1},{"text":"Menfis-neggwebur-e-dummagan ese yamolesmalad.","poem":2},{"text":"We-neggwebur-e-dummagan, Egipto-yala noar sesmalad.","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Ani an Bab-Jehová dule-binsaed-dakmaladgine, suli-suli-neg-itoged-burba egi nasiksad.","poem":2},{"text":"Bela Egipto-dulemar-ibmar-imakedi, noarsaila imakdemalad.","poem":1},{"text":"Igi-dule-mummudi, agar-agar banamakdii,","poem":2},{"lineBreak":true},{"text":"debayobi, Egipto-yala banamaksiid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Gege bar Egipto-yar-ulale, ibmar imakleged.","poem":1},{"text":"Ar dule-dummagana, dule-ibmar-wismaladi,","poem":2},{"text":"dulamar-bukwadi, degi, sordamala,","poem":1},{"text":"gege bar Egipto-yar-bendakega ibmar imakmalad.”","poem":2}]},{"type":"verse","number":16,"content":["A-ibagangine, Egipto-dulemar, Bab-Jehová-Bela-Gangued-Nikad sabsur-e-odurdakega egi gwisgualile, omeganyobi dobe itodmaloed."]},{"type":"verse","number":17,"content":["Egipto-dulemar Judá-dulemar-dobe itodamaloed. Ar Judá-dulemargi wis binsadmalale, bato dobed egi nagudmaloed. Ar ade, Bab-Jehová-Bela-Gangued-Nikadi Egipto-dulemar-idu igar-bulegan amisad."]},{"type":"verse","number":18,"content":["A-ibagangine, Egiptoʼgi neggwebur-gwaatale Canaán-dulemar-gayaba sunmakdemaloed, degi, ise-sogar Bab-Jehová-Bela-Gangued-Nikadga sogdemaloed: Anmar be-sogedba damaloye. A-neggwebur-gwagwenad nugguoed, Herez-neggweburye."]},{"type":"verse","number":19,"content":["A-ibagangine, Egipto-yalagi Bab-Jehováʼga ibmar-ogumakar-ukleged-aila sigoed. Geb degine, yar-abingunaid-nagaba Bab-Jehováʼga akwa-dummad ogwismarbaloed."]},{"type":"verse","number":20,"content":["Ar a-akwa-dummadi Egipto-dulemarga e-wilubga guoed. Adi, oyogega, Egipto-dulemar Bab-Jehová-Bela-Gangued-Nikad-e-nug odummomarmoye. Ar Egipto-dulemar Bab-Jehováʼse mesagwar-dule-e-imakmaladgi e-ollor-imakega gotemaloed. Bab-Jehová ega dule-e-abonoged, degi, dule-e-ular-gwisgued barmidagoed, adi, mesagwar-dule-e-imakmaladgi ollor-imakegar."]},{"type":"verse","number":21,"content":["A-ibagangine, Bab-Jehová Egipto-dulemar magar-e-dakega imakoed, ede, nue-Bab-Dummad guye. Geb Egipto-dulemar magar daknonimaloed, wede, Bab-Jehová nue-Bab-Dummad guye. Degi, Bab-Jehováʼga ibmar-oburgwar ukdemaloed, ibmar-gwagmar ega ukdemaloed. Bab-Jehováʼga ise-ibmar-imakoye-sogmaloedi, na sogedba ega imakmaloed."]},{"type":"verse","number":22,"content":["Bab-Jehová bonigi Egipto-dulemar-naibi-imaknonikoed, geb a-sorbali, onugubaloed. Geb degi, Egipto-dulemar Bab-Jehováʼba gannar nagudmaloed, degine, Bab-Dummad wile amar-dakoed, degi, onuguoed."]},{"type":"verse","number":23,"content":["A-ibagangine, Egipto-akale, Asiria-yalase igar-dummad megoed. Geb Asiria-dulemar Egiptoʼse nanabukwa gumaloed, degi, Egipto-dulemar Asiriaʼse nanabukwa gumarmogoed. Egipto-dulemar, Asiria-dulemarbo Bab-Jehová-nug odummobukwa gumaloed."]},{"type":"verse","number":24,"content":["A-ibagangine, yala-sogapaa ambikumaloed: Egipto, Asiria, Israel. Degi, wemar-yalagi neggwebur-bamaladba egi nued binsalegoed."]},{"type":"verse","number":25,"content":["Ar ade, Bab-Jehová-Bela-Gangued-Nikad bela we-yalamargi ise-nued binsaoed, weyob sogdoed: “Egipto an-dulamarga gued. Egi nued binsalesun. Asiria-dulemargi nued binsalesun, ani an urbisad. Degi, Israel-dulemargi nued binsalesun, wedi angadid. Ani an we-dulemar susad.”"]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/18.json","previousChapterAudioLinks":{},"numberOfVerses":25}