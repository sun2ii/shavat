{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":2,"content":[{"type":"heading","content":["Bab-Jehová bela napneg-naid semaid"]},{"type":"verse","number":1,"content":["Amoz-machi-Isaías, Judá-yargi, degi, Jerusalén-neggweburgi neg-guoed-daksad, sogsad:"]},{"type":"verse","number":2,"content":[{"text":"“Ibagan-bergued-mosale, Bab-Jehováʼse-goled-neg-yala bur yala-sunsogedga sii guoed,","poem":1},{"text":"yala-mulluganba bur nug-dummarba sii guoed,","poem":2},{"lineBreak":true},{"text":"dulemar-yar-baid-baidgi-bukmalad bela we-yalase duurmaknonikoed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bukidar neggwebur-bamalad nonimaloed, sognonimaloed: ‘Dagmar, anmar Bab-Jehová-yalase nakwenamar,","poem":1},{"text":"Jacob-e-Bab-Dummadse-goled-negse nakwenamar.","poem":2},{"text":"Ar Bab-Jehová, e-Igar-Maidgi anmar-odurdakoed,","poem":1},{"text":"adi, anmar e-igargi nanadii guegar.’","poem":2},{"text":"Ar ade, Sión-yalagi Bab-Jehová-igar-maid-odurdakleged nodagoed,","poem":1},{"text":"Jerusalénʼgi Bab-Jehová-gayaburba ainidagoed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová, dulemar-yar-baid-baidsik-bukmaladga igar-nabogoed,","poem":1},{"text":"neggwebur-bukibgi-nakulegega guoed.","poem":2},{"text":"Dulemar, e-es-suidmar napa-imuedga obinyemaloed,","poem":1},{"text":"eswar-swiswidikmalad gagan-sikedga gudoed.","poem":2},{"text":"Yar-gwensak, yar-baidbo bar na abin-abin urwosurmalad.","poem":1},{"text":"Bila-onogega bar odurdaklenai guosurmalad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Jacob-wagan be dagmar,","poem":1},{"text":"Bab-Jehová-anmar-nidiguega, anmar imakmar.”","poem":2}]},{"type":"heading","content":["Bab-Jehová dule-san-dummarba-imakmaladga igar-itoged"]},{"type":"verse","number":6,"content":[{"text":"Bab-Dummad, be-dulamar be obachad,","poem":1},{"text":"be Jacob-e-wagan obachad.","poem":2},{"text":"Ar be-dulamar-yargi, dad-nakwed-dorgan-niisgwagi-nerguarmaladi, bukidar bukwad.","poem":1},{"text":"Filistea-dulemaryob, yoo-ibmar-guoedgi-sunmakmalad-bukidar nikamalad,","poem":2},{"lineBreak":true},{"text":"Be-dulamar, ar dule-bamaladbo igar mesdamalad.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E-yalagi, mani-sunnabi engus bukwad,","poem":2},{"lineBreak":true},{"text":"olo-sunnabi engus bukwad,","poem":2},{"lineBreak":true},{"text":"e-ibmar-nuegan gege ebisleged.","poem":2},{"lineBreak":true},{"text":"E-yalagine, moli-bukidar nikad,","poem":2},{"lineBreak":true},{"text":"e-moli-ur-bila-onomalad gege ebisleged.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"A-ukinbali, e-yala ibmar-bab-dummadyob-imaklemalad-sunnabi engus bukwad,","poem":1},{"text":"ar dulemar, e-argangi-ibmar-sobsamalad-asabin sindigale, sigdimalad,","poem":2},{"lineBreak":true},{"text":"e-googi-ibmar-obinnismalad-asabin sindigale sigdimalad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ar weyob, dulemar, e-asabin sindigar-sigedba na nug-wiodimalad,","poem":1},{"text":"ar dulemar, e-asabin na nug-bipii imakdimalad.","poem":2},{"lineBreak":true},{"text":"Begi-isgusadi, melle ega be elio.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"¡Israel-dulemar! Bab-Jehová-e-gangued-sabsur-oyoged-idu be dukumar,","poem":1},{"text":"e-gangued-dobesaila-dakleged-idu be dukumar,","poem":2},{"text":"akwasailagan-ollogan-yaba be dogmar,","poem":1},{"text":"e-idu be napa-yaba dukumar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dule-san-dummarba-imakmalad, sabsur-obingegsalemaloed,","poem":1},{"text":"dule-san-dummarba-imakmalad, san-bipii imaklemaloed.","poem":2},{"text":"A-ibagangi, unnila Bab-Jehová-e-nugbi odummolegoed.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bab-Jehová-Bela-Gangued-Nikad ibagwengi nonikoed,","poem":1},{"text":"bela-dulemar-na-san-dummarba-imakmaladgi, dulegi-mesagwar-sunmakmaladgi, gwichigunonikoed,","poem":2},{"text":"dule-na-san-bule-bule-samaladgi, gwichigunonikoed.","poem":1},{"text":"A-e-nugmar bipii imaknonikoed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bela dulemar Líbano-yalagi-urwar-suigan-gwichiyob-san-imakmaladgi, gwichigunonikoed,","poem":1},{"text":"bela urwar-matusurmalad-bukwadyob-san-imakmaladgi, gwichigunonikoed.","poem":2},{"lineBreak":true},{"text":"Bela Basán-nebagangi sapi-dummaganyob-san-imakmaladgi, gwichigunonikoed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bela dulemar yala-dummagan-matusurmaladyob-san-imakmaladgi,","poem":1},{"text":"bela yala-mullu-mullugan-nuga-nikamaladyob-san-samaladgi, gwichigunonikoed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bela dulemar neg-suigan-bukwadyob-san-imakmaladgi,","poem":1},{"text":"bela galu-matusur-akwabiidmalad-gandikidba-bukwadyob-san-imakmaladgi, gwichigunonikoed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bela dulemar Tarsis-ulu-dummaganyob-san-imakmaladgi,","poem":1},{"text":"bela ulu-dummagan-yeerdaklemaladyob-san-imakmaladgi, gwichigunonikoed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dule-san-dummarba-imakmalad, nug-bipii gudoed,","poem":1},{"text":"dule-dogdar-obicha-san-imakmalad san-bipii gudoed.","poem":2},{"text":"A-ibagangi, unnila Bab-Jehová-e-nugbi odummolegoed.","poem":1}]},{"type":"verse","number":18,"content":[{"text":"Bab-dummadyob-ibmar-imaklemalad bela-naitinaga obelolegoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Bab-Dummad dulemar-sabsur-odurdaksokalile,","poem":1},{"text":"dulemar Bab-Jehová-e-gangued-sabsur-oyoged-idu,","poem":2},{"lineBreak":true},{"text":"e-gangued-dobesaila-dakleged-idu,","poem":2},{"text":"akwasailagan-ollogan-yaba ubodmaloed,","poem":1},{"text":"idu napa-ollogana-yaba dogdemaloed.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"A-ibagine, dulemar e-bab-dummagan-nug-odummogega-orgi-sobsamaladi, manigi-sobsamaladi,","poem":1},{"text":"sapur-nusaga, degi, uksirga midmaloed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bab-Dummad dulemar-sabsur-odurdaksokalile,","poem":1},{"text":"dulemar, Bab-Jehová-e-gangued-sabsur-oyoged-idu,","poem":2},{"lineBreak":true},{"text":"e-gangued-dobesaila-dakleged-idu,","poem":2},{"text":"dulemar akwasailagan-ollogana-imbaba ubodmaloed,","poem":1},{"text":"akwasailagan-ollormalad-yaba dogdemaloed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Degisoggu, melle be dulegi bensuli-gudii guo.","poem":1},{"text":"Ar duledi, unnila sikwas dula gudiid.","poem":2},{"lineBreak":true},{"text":"E-dula-gudiidi, unnila buu naddaed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}