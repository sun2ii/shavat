{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":21,"content":[{"type":"heading","content":["Nega-dulesulidgan-demar-dikarba-naidgi yoedse-ibmar-guoed"]},{"type":"verse","number":1,"content":["Bab-Dummad Isaíasʼga nega-dulesulidgan-demar-dikarba-naidgi-neg-guoedi oyosad:",{"text":"Neguevʼba burwa-bipirmakaled-nanaedyobi,","poem":1},{"text":"dule-yar-sumalad nega-dulesulidganba-danikidi, bato modanikid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Anga yeer-gangue negburgan oyolesad:","poem":1},{"text":"Dule-emar-yardakedi, dule-yardaked.","poem":2},{"text":"Dule-wiogedi, dule-wioged.","poem":1},{"text":"Elam-dulemar, ¡gwichigunae!","poem":2},{"text":"Media-dulemar, ¡oitonae!","poem":1},{"text":"Dule-wile-itogedba-bodimalad bar boega imaklegosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"A-ulale, an-abagan nunmakedba wawanmaked,","poem":1},{"text":"an nunmaked-dummad itoged.","poem":2},{"text":"Sior muu-neggi-ugakgunair abagan nunmakdaeyobi,","poem":1},{"text":"an nunmak itoged.","poem":2},{"text":"An dule-sunmaked-itogedi, suli-suli-ito an-imaked.","poem":1},{"text":"An ibmar-dakedi, dobed-dummad anga uked.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"An aku-itogusad.","poem":1},{"text":"Dobedba an wanwan-itoged.","poem":2},{"text":"Sedogusale, negdambegwad an yeer-itodaenad.","poem":1},{"text":"Emide, aka gwayed anga uked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sorda-dummagan iba-ononanaid,","poem":1},{"text":"mas-bukidar gullenaid.","poem":2},{"text":"¡Sorda-dummagan, be guagwarmalo!","poem":1},{"text":"¡Be-sigu-abgamalad be nudakmala!","poem":2}]},{"type":"verse","number":6,"content":["Ar Bab-Jehová anga weyob sogsad:",{"text":"“Dule-nakuleged be ogwicho.","poem":1},{"text":"Bela-ibmar-dakoedi, bega-sogega be imako.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Moli-ur-bila-onomaladgi dulemar ebo-ebo moli-uayasuigan-birgi-sii-dani be dakalile,","poem":1},{"text":"igi dulemar ebo-ebo moli-yargan-muremalad-birgi-sii-dani be dakalile, yog-gollar be imako.”","poem":2}]},{"type":"verse","number":8,"content":["Degi, dule-nakuleged binnasuli goted:",{"text":"“Dummad, bane-bane nakuleged-neg-suid-niba an nakulegwisguad.","poem":1},{"text":"Mutikidbali, an nakulegwisguad. An bangusisulid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"¡Be dake! Dulemar moli-ur-bila-onomaladgi danimalad,","poem":1},{"text":"ebo-ebo danimalad.”","poem":2},"Geb dule-gwensak binnasuli goted:",{"text":"“¡Babilonia-neggwebur bergus!","poem":1},{"text":"¡Babilonia-neggwebur bela oitoles!","poem":2},{"text":"Bela ibmar-wilub-sobarmalad e-bab-dummadga-imakmalad napagi omileded.”","poem":1}]},{"type":"verse","number":10,"content":["Geb Isaías sogded:",{"text":"“Sordagan, ibmar-gwagyob napagi-omilede be gusmaladid.","poem":1},{"text":"Israel-e-Bab-Dummad-Jehová-Bela-Gangued-Nikad an-uayagwar anga we-ibmar-sogsadi, an bemarga sognaid.”","poem":2}]},{"type":"heading","content":["Edom-yala-yoedse-berguoedgi sunmaklesad"]},{"type":"verse","number":11,"content":["Isaías, Duma-yalagi neg-guoedgi iduakwaa sunmaksad:",{"text":"Dule anse binnasuli Seir-neggwebur-akale goled:","poem":1},{"text":"“Nakuleged-dule, ¿sana neg-mutikid berguoe?","poem":2},{"lineBreak":true},{"text":"Nakuleged-dule, ¿sana neg-ibguoe?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Geb an-abin sogded:","poem":1},{"text":"“Neg-ibgued omodani, neg-mutikgued omodanibar.","poem":2},{"text":"Ar be gannar anse egisbiele, gannar egisbalodo.","poem":1},{"text":"Gannar be anse egisbiele, gannar be anse dagodo.”","poem":2}]},{"type":"heading","content":["Arabiaʼgi-yoedse-neg-guoedgi sunmaklesad"]},{"type":"verse","number":13,"content":["Arabia-dulemargi iduakwaa sunmaklesad:",{"text":"Dedánʼginmalad, danar-danar duurmakmadaed,","poem":1},{"text":"nega-dulesulidganba sapur-moodonaidgi ambikumalad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Uku-uku-itodimalad-abin be ainimarsun,","poem":1},{"text":"ega be dii ukmarsun.","poem":2},{"lineBreak":true},{"text":"Tema-yarginmalad, dule-wakinmamaidga be mas ukmarsun.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ar ade, es-suidgi-gwakialidba duurmakmamaid,","poem":1},{"text":"es-suid-daarmakaledgi-gwakialidba duurmakmamaid.","poem":2},{"text":"Ar ade, e-idu warsi yaa-gwichidgi-gwakialidba duurmakmamaid,","poem":1},{"text":"bila-onolegedgi-gwakialidba duurmakmamaid.","poem":2}]},{"type":"verse","number":16,"content":["Ar Bab-Jehová weyob anga soged: “Birgagwensega, Cedar-yala-e-yeerdakleged an obelogoed. Igi dule-manigi-arbaed birgagi e-arbaed ega bergunonidae, deyobi an imakoed."]},{"type":"verse","number":17,"content":["Dule-sigugi-urwemalad-bulegan-Cedarʼginmalad, napi-ichee durgumaloed.” Ar ade, Israel-dulemar-e-Bab-Dummad-Jehová deyob soged."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}