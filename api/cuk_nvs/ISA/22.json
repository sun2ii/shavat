{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":22,"content":[{"type":"heading","content":["Negburgan-Daked-Nebagi yoedse-ibmar-guoed"]},{"type":"verse","number":1,"content":["Isaías, Negburgan-Daked-Nebagi yoedse-ibmar-guoedgi sunmaksad:",{"text":"¿Igi be itomala? Emide, bela bemar neg-uas-birgi be nakwemamaigu.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Bemar, dulemar-e-itoleged-damalad-neggweburad,","poem":2},{"text":"bemar, oimakedginbi-gudidamaladid,","poem":1},{"text":"ibagibi be negdakdimalad.","poem":2},{"text":"Ar be-dule-burgwismaladi, es-suidgi gwen burgwissurmalad,","poem":1},{"text":"bila-ononanaidgi gwen burgwissurmalad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bela be-dummagandi, danar duurmakdemalanad,","poem":1},{"text":"degi-inigwele, gwen egi warsi-miledsuli galedapmalad.","poem":2},{"text":"Bela be-dulemar-galesmaladi, aisaar wakinye sokarmalanad,","poem":1},{"text":"bela galedapmalad.","poem":2}]},{"type":"verse","number":4,"content":["A-ulale, Bab-Jehová weyob sogsad:",{"text":"“Be angi bangumar.","poem":1},{"text":"Mer be anse gormar.","poem":2},{"text":"Melle an-gwage baisur-itoge be imakmar.","poem":1},{"text":"An-dulamar-bela-bergusad-ular, an boesii imakgwelo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ar Bab-Dummad-Jehová-Bela-Gangued-Nikad, Negburgan-Daked-Nebaga gwayed-dummad-iba nasiksad,","poem":1},{"text":"suli-suli-itoged-iba nasiksad,","poem":2},{"text":"nug-bipi-gued-iba nasiksad.","poem":1},{"text":"Galu-matusulid-earleged-iba nasiksad,","poem":2},{"lineBreak":true},{"text":"yalaganba binnasuli-gordigued-iba nasiksad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Elam-yar-sorda-bila-onomalad moli-birgi-sii e-warsi oniarmalad.","poem":1},{"text":"Kir-yar-sorda-bila-onomalad e-sigu-abgamalad oniarmalad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Be-neba-yeerdaklemaladgi ur-bila-onomaladi, engus nanaid.","poem":1},{"text":"Sorda-bila-onomaladi, degi, e-molimala, bela neggwebur-yawagak-doged-ebilis bukwad.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Judá-dulemar bendakleged-sate gudmalad.","poem":2},{"lineBreak":true},{"text":"A-ibagine, bemala Sapurba-Neg-Dummad-siidgine,","poem":1},{"text":"bila-onogedgi-gingimar-ebulemalad-bukwadi, be daksagusmalad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"David-neggwebur-e-galu-matusulid bukidar marar-marale be daksa gusmarbalid.","poem":1},{"text":"Degine, dii-saboleged-urbalid-siidgine, dii be wesmarbalid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Jerusalén-negmar-bukwad be ebichismarbalid.","poem":1},{"text":"Galu-matusulid-mararmalad-nudakmalaga, abala, a-negmar-bukwad be earismarbalid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Galu-matusulid-abinnidgi, be dia sobsamalad,","poem":1},{"text":"adi, dii dia-epennegwadgi-sabolesiid, dia-soblesadse ogwaegar.","poem":2},{"text":"Degi-inigwele, we-dule-ibmarmar-imaksadgi be binsaed-nikaa gwen gussurmalad.","poem":1},{"text":"Degine, we-dule dikasurgus-we-ibmar-guoed-mesisadi, aku be daksamalad.","poem":2}]},{"type":"verse","number":12,"content":["Isaías sogdebalid:",{"text":"“A-ibagangine, Bab-Dummad-Jehová-Bela-Gangued-Nikadi, boega bemarse gochanad,","poem":1},{"text":"bukib-binsaega bemarse gochanad.","poem":2},{"text":"Sailagia-swiri-saega bemarse gochanad,","poem":1},{"text":"mor-sommed-yoega bemarse gochanad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Degi-inigwele, aka bemar weligwar itodmalad.","poem":1},{"text":"Yeer-itogedba be iba onodmalad.","poem":2},{"text":"Moli-bebe-nikad be oburgwidmalad,","poem":1},{"text":"sibad-wawaad be oburgwidmalad.","poem":2},{"text":"Moli-sana be gutemalad,","poem":1},{"text":"vino be gobdemalad.”","poem":2},"Degine, be weyob sogdemalad:",{"text":"“Anmar mas-gunmala, anmar gobed-gobmala,","poem":1},{"text":"ar anmar banedse burgwemalosursi.”","poem":2}]},{"type":"verse","number":14,"content":["A-ulale, Bab-Jehová-Bela-Gangued-Nikad an-uayagwar anga weyob sogsad: “We-isguedi an bemarga osulogosulid. Ani, Bab-Dummad-Jehová-Bela-Gangued-Nika-Maid, an soged.”"]},{"type":"heading","content":["Eliaquim, Sebna-muchub dummadga onaklesad"]},{"type":"verse","number":15,"content":["Bab-Jehová-Bela-Gangued-Nikad weyob Isaíasʼga soged: “Sebna be aminae, ar ade, reyneg-daked-dummadid. Ega be weyob sogo:"]},{"type":"verse","number":16,"content":[{"text":"‘¿Ibu be wegi sanai?","poem":1},{"text":"¿Doa bega igar-uksa neg-uangi be yaa-gwisega?","poem":2},{"text":"¿Ibiga be nibali ise-sobale be yaa gwisnai?","poem":1},{"text":"¿Ibiga be akwasailagi nuesaale-megega be yaa gwisnai?","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"” ’Ar Bab-Jehová dikasuli be-barmetoed.","poem":1},{"text":"Dule-gandikid-emar-gaeyobi, Bab-Jehová be-gaoed,","poem":2},{"lineBreak":true},{"text":"ise-sabsur be-metoed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ogob-baparmakeyob be-imakoed,","poem":1},{"text":"yar-dummadgi be-balimetoed.","poem":2},{"text":"Agi, be burgoed.","poem":1},{"text":"Agi be-ur-bila-onomalad-yeerdaklemalad bedapoed.","poem":2},{"lineBreak":true},{"text":"Be-dummadga binged-dummad be guoed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Be-gangi be siidgine, an be-onogoed.","poem":1},{"text":"Be dummadga-maidi, an be-oberguoed.’","poem":2}]},{"type":"verse","number":20,"content":["”A-ibagine, an-mai-Hilcías-machi-Eliaquimʼse an goloed."]},{"type":"verse","number":21,"content":["Be-mor-dummad-suid an ega yooed. Be-molidub an ega nasikoed, degine, be-negseed-igar an ega ukoed. Jerusalén-dulemarga, degi, Judá-dulemarga, e-babayob guoed."]},{"type":"verse","number":22,"content":["Rey-David-waganga-ibmar-sogega an ega igar ukoed. Eliaquim igar-ukele, dule igar-gaosulid, gwen dule egi akar sunmakosulid. Eliaquim igar-uksulile, ibmar guosulid."]},{"type":"verse","number":23,"content":["Igi esgoro ise-bioklegar-gwisdae, deyob an Eliaquim dummadga-megega imakoed. Egine, e-neg-yaginmalad nug-gannarba itomaloed."]},{"type":"verse","number":24,"content":["Bela e-neg-yaginmalad egi weligwar-itomaloed, degi, bendakdemarmogoed: E-masmala, e-wagan, bela-e-gwenadgan-bamalad, degine, e-aimarse-bakale, bendakdemaloed.”"]},{"type":"verse","number":25,"content":["Bab-Jehová-Bela-Gangued-Nikad weyob sogbali: “A-ibagine, ani an, Eliaquim, bela-e-gwenadgan, bela dulemar-egi-bengussurmalad obelononikoed. Ani an Bab-Jehová-guedgi, deyob an soged.”"]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/21.json","previousChapterAudioLinks":{},"numberOfVerses":25}