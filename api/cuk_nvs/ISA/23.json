{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":23,"content":[{"type":"heading","content":["Tiroʼgi-yoedse-neg-guoedgi sunmaklesad"]},{"type":"verse","number":1,"content":["Bab-Jehová Isaíasʼga Tiro-neggwebur-guoedi oyosad:",{"text":"Quitim-yar-akale, Tarsis-ur-selaganse gayaburbamar nonikid.","poem":1},{"text":"Tiro-neggwebur bergussiid,","poem":2},{"text":"e-negmar, degi, e-ur-nagumalad, bela ei bibichisad.","poem":1},{"text":"Abali, amar bukib-binsabukwad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Tiro-dorgan, boo be ambikumar.","poem":1},{"text":"Sidón-dulemar-ibmar-ukedgi-arbamalad, boo be ambikumar.","poem":2},{"text":"Be-selamar bega ibmar-nuegan-bukidar berbesmalad.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"E-masgullemaladi, Nilo-diwar-e-ana-gwensakgi danikid.","poem":2},{"text":"Tiro-neggwebur, dulemar-yar-baid-baid-bukwadbo, mani-onobukwa gusad.","poem":1},{"text":"Nilo-diwargi-ibmar-gwag-welegedgi mani-amibukwa gusmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Sidón-dulemar, be bingedar itomarsun,","poem":1},{"text":"bemar, muu-billi-ibedga gumalad.","poem":2},{"text":"Emidi, muu-billi weyob sogsad:","poem":1},{"text":"“An bipisaale gwen abganba an galitodisulid,","poem":2},{"text":"an gwen mimmi bakdisulid.","poem":1},{"text":"An gwen mimmigan odummodisulid,","poem":2},{"lineBreak":true},{"text":"an gwen bunamala ibmargi odurdakdisulid.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Egipto-yalase, Tiro-neggwebur-bergusad-gayaburba warmaksale,","poem":1},{"text":"Egipto-dulemar Tiro-neggweburga bukib-binsadmaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tarsis-neggweburse be namar,","poem":1},{"text":"demar-gakagi-bukwamalad, be bukib-binsamar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tiro-neggweburde, ¿neggwebur-weligwaledinsursi?","poem":1},{"text":"We-neggweburde, ¿bur dikasurgus siidinsursi?","poem":2},{"lineBreak":true},{"text":"We-dulemarde, ¿dikasur-aineba bur nanadimaladinsursi?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"¿Doa Tiro-neggwebur-weyob-guega igar amisa?","poem":1},{"text":"We-neggwebur nuga-nika siidinad.","poem":2},{"text":"E-dulemar-ibmar-ukedgi-arbamaladi, dule-nuga-nikamaladinad.","poem":1},{"text":"Dulemar-ese-ibmar-bakmaladi, bela mag-dakedbimalanad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bab-Jehová-Bela-Gangued-Nikad we-igar mesisad,","poem":1},{"text":"adi, dulemar-nug-gannarba-nikad ei obelogega,","poem":2},{"lineBreak":true},{"text":"bela dule-napneggi-nuga-nikamalad-e-nug bipii imakegar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tarsis-dulemar, sapurgi be arbamarsun,","poem":1},{"text":"ar ur-nagumaladde, bela be-ibe bergusad.","poem":2},{"lineBreak":true},{"text":"Ar bar bemarse Tiro-urmar dognonikosulid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar Bab-Jehová muu-billigi e-gangued oyosad,","poem":1},{"text":"dulemar-yar-baid-baidgi-bukmalad-ogwayega imaksad.","poem":2},{"lineBreak":true},{"text":"Bab-Jehová, Canaán-neggwebur-gandikmalad-obelogega imaksad.","poem":2}]},{"type":"verse","number":12,"content":["Degi, Bab-Jehová, Sidón-dulemarga weyob sogsad:",{"text":"“Sidón-dulemar, be wese bergunonisun.","poem":1},{"text":"Be-neggwebur-dummad bela bergussun,","poem":2},{"lineBreak":true},{"text":"bar be weligwar itogosurmalad.","poem":2},{"lineBreak":true},{"text":"”Ar be Quitim-neggweburse obakmalo-inigwele,","poem":1},{"text":"amba bogidiki gwen be itogosurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”¡Caldea-neggweburgusadi be dakmala!","poem":1},{"text":"¡Bar we-neggwebur sisulid!","poem":2},{"text":"Ar Asiria-sordamar we-neggwebur bela obelosad.","poem":1},{"text":"Ibmar-durgan-ursilimalad nega-dulesulidganba-gudimalad-e-negga imaksad.","poem":2},{"text":"Neg-matusulid-gandikmalad sobsa gusmalad.","poem":1},{"text":"Reyneg-gandikmalad bela ei earis gusmalad,","poem":2},{"lineBreak":true},{"text":"akwamarbi ganna-ganna napi-obesmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"”Tarsis-ur-selagan bukib-binsabukwamalad,","poem":1},{"text":"ar e-ur-nagumalad bela bergusad.","poem":2}]},{"type":"verse","number":15,"content":["”A-ibagangine, Tiro-neggwebur ieles-guoed, bar egi binsalegosulid. Rey-birga-dulapaa-gakambe (70) dula-gudiguedyobi, e-ieleged-iba guoed. Geb birga-dulapaa-gakambegwad-sorba (70), Tiro-neggweburgi, gambasamalad-e-namaklegedyobi egi namaklegoed:"]},{"type":"verse","number":16,"content":[{"text":"‘Gambasaed-ieles-gudiid,","poem":1},{"text":"gar-arpa be sue, neggwebur be ebirnae.","poem":2},{"text":"Namaked-bur-nued be ogolo,","poem":1},{"text":"namaklemalad-bukidar be namako,","poem":2},{"lineBreak":true},{"text":"adi, dulemar bee-ebinsamalagar.’ ”","poem":2}]},{"type":"verse","number":17,"content":["Birga-dulapaa-gakambegwad (70) bergunonikile, Bab-Jehová Tiro-dulemar gannar e-ibmar-ukedgi-arbamalaga imakdebaloed. Degine, bela-neggwebur-baiganbo gannar ibmar-ukedgi arbadmaloed."]},{"type":"verse","number":18,"content":["Ar e-mani-onogoeddina, degi, e-ibmar-ukoeddina, Bab-Jehováʼga ukdemaloed. E-manimar, degi, e-ibmarmar gwen sabolesii guosulid. Ar e-mani-onomaladi, dule-Bab-Jehová-nug-odummomaladga uklegoed, adi, nue-immedik-gudii gumalagar, degi, mor-nuegan-yoi-gudii gumalagar."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}