{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":24,"content":[{"type":"heading","content":["Bab-Jehová napneg-sabsur-odurdakoed"]},{"type":"verse","number":1,"content":[{"text":"Dakmalana, Bab-Jehová napneg-swaana imaksad,","poem":1},{"text":"bela napneg obelonaid.","poem":2},{"lineBreak":true},{"text":"Bab-Dummad e-dulamar-ononnonaid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bela deyobi we-dulemala gumarmogoed:","poem":1},{"text":"Dule-irwa-Bab-Dummadse-gormalad, degi, bela dulamar.","poem":2},{"lineBreak":true},{"text":"Mai-e-dummadga-gudimalad, degi, e-maimar.","poem":2},{"lineBreak":true},{"text":"Dummagan-omeganmar, degi, mai-omeganmar.","poem":2},{"lineBreak":true},{"text":"Ibmar-ukedgi-arbamalad, degi, ibmar-bakedgi-arbamalad.","poem":2},{"lineBreak":true},{"text":"Mani-gaar-ukmalad, degi, dulegi-mani-gamalad.","poem":2},{"lineBreak":true},{"text":"Mani-ibegan, degi, dule-wileganamar.","poem":2},{"text":"Wemala, bela deyob gumarmogoed.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Napanega bela swaanga naguoed,","poem":1},{"text":"bela e-ibmarmar sulegoed.","poem":2},{"lineBreak":true},{"text":"Ar Bab-Jehová deyob sogsad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Napneg ibitosad, napneg bela-bela oitolesad.","poem":1},{"text":"Dule-gala-ibegan, bela e-gangued bergusad,","poem":2},{"lineBreak":true},{"text":"dule-napneggi-nuga-nikamaladi, bela yogguded.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Napneggi, bela isgued neg-gagasnaid,","poem":1},{"text":"ar ade, e-dulemar, Bab-Dummad-Igar-Maidba gwen nanassurmalad.","poem":2},{"text":"Igar-Maidgi annasmalad.","poem":1},{"text":"Dule bipisaale Bab-Dummad-Ebo-Degisadegu-Igar-Mesisadba gwen nanassurmalad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"A-ulale, napnega ukabsales naid,","poem":1},{"text":"ar e-dulamar-nukad deyob gusad.","poem":2},{"text":"Agala, soo napneggi aidesad,","poem":1},{"text":"unnila dulemar napi-ichee bukusmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Uva-nainumar isgus naid,","poem":1},{"text":"vino-binid bar daklesulid.","poem":2},{"text":"Dulemar-yeer-itogedba-namakdidamaladi,","poem":1},{"text":"emidi, bukib-binsaedba ogormakdimalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Damborʼmar-goledi, bergus-nanaed,","poem":1},{"text":"gar-arpaʼmar-goledi, bergus-nanaed,","poem":2},{"lineBreak":true},{"text":"dulemar-oimakedi, bela bergusad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Namakbukmalale, bar vino gobsurmalad.","poem":1},{"text":"Dule-mummuganga inna-gagbid isguded.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Neggwebur nue-bergus siid, olloo selenaid.","poem":1},{"text":"Bela neg-yawagakmar, atiar-atiar bubukwad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Galimbabali, dulemar vinoʼbina binnasuli oimakdimalad,","poem":1},{"text":"wergulegedi bela bergusad,","poem":2},{"lineBreak":true},{"text":"yeer-itolegedi bela yogguded.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Neggwebur bela-bela nue-bergus sigisad,","poem":1},{"text":"neggwebur-yawagak-dummad bela daas-daas gusad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Weyob napneggi dulemar-yar-baid-baidgi-bukmalad imaklemaloed.","poem":1},{"text":"Igi olivo-sapi-san gwallealir, e-san obatega, binnasuli-osiamaklege, deyobi gumaloed.","poem":2},{"lineBreak":true},{"text":"Uva-batisbukwayob gumaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dulemar napi-ichee-besmaladi, weligwaledbali binnasuli oimakdemaloed.","poem":1},{"text":"Dad-ibeler-argwanedsiki, Bab-Jehová-e-gangued-yeerdakleged weligwaledba oimakmaloed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Degisoggu, nebaganba Bab-Jehová-nug be odummomar.","poem":1},{"text":"Demar-gakaba, Bab-Jehová-Israel-dulemar-e-Bab-Dummad-nug be ogannomar.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bela napneg-naidgine, anmar namakleged itoged. Weyob soged:","poem":1},{"text":"“Dule-innikigwad odummolesun.”","poem":2},{"text":"Ar andi an sogdo, an duledar-wilesye.","poem":1},{"text":"Bela-bela an nunmak-itogedba, an burgwebied.","poem":2},{"text":"Dule-yardakmaladi, unnila dule-yardakdimalad.","poem":1},{"text":"Dule-yardakmaladi, emar-yardakedginbi binsadimalad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dulemar-napneggi-bukmalad, gwayed-dummad be-edarbebukmalad,","poem":1},{"text":"be-iduar neg-bulegan naid,","poem":2},{"lineBreak":true},{"text":"yardakleged-igar be-idu naid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Dule gwayed-dummadgi unni-nosale, igar-buleganse galedapoed.","poem":1},{"text":"Dule igar-bulegangi unni-nosbalile, amba yardakleged-igarse galedapbaloed.","poem":2},{"text":"Ar ade, dii-dummad wioed.","poem":1},{"text":"Dii-dummadi napneg-sailagan owawanmakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Negabandur-dummadi napneg mamaroed,","poem":1},{"text":"napa-daas-daas-imakedse saoed,","poem":2},{"lineBreak":true},{"text":"bela napa goa-goa guoed.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dule-mummu-banamakdiiyobi, napneg naguoed.","poem":1},{"text":"Neg-uas-baisursunna-ayaredyobi, napneg ayaridoed.","poem":2},{"text":"Dulemar-isguedbali napneg bergudoed,","poem":1},{"text":"napneg gannarse bar guosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"A-ibagangine, Bab-Jehová nibagi-negsemamaid sabsur-odurdakoed,","poem":1},{"text":"napneggi, reymar-yar-semamaid sabsur-odurdakbaloed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Esgaryaba odolemaloed,","poem":1},{"text":"agine, mellesii gumaloed.","poem":2},{"lineBreak":true},{"text":"Geb sorbali, sabsur-odurdaklemaloed.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bab-Jehová-Bela-Gangued-Nikadi, Sión-yalagi, Jerusalén-neggweburgi, gandikid-yeerdaklegedba yala seoed.","poem":1},{"text":"Degiidbali, dad-ibeler sichii nadoed,","poem":2},{"text":"nii sichii nadmogoed.","poem":1},{"text":"E-girmar-dummagan bela Bab-Dummad-e-gangued dakmaloed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}