{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":25,"content":[{"type":"heading","content":["Bab-Jehová-nug-ogannogedgi namaked"]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová, be an-Bab-Dummadid.","poem":1},{"text":"An bega namakoed, an be-nug odummogoed,","poem":2},{"text":"ar be ibmar-gegerdaklemalad imaksad.","poem":1},{"text":"Be-Igarmar epennegwad-akale bela napiragwadbiid, degi, inniki maiguad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neggwebur akwamarbi ganna-ganna be urbisad,","poem":1},{"text":"neggwebur-gandikid, bela oitolesad.","poem":2},{"text":"Dule-bamalad-e-neggwebur bela oitolesad,","poem":1},{"text":"neggweburga bar sigissulid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"A-ulale, dule-gandikmalad be-nug odummoged,","poem":1},{"text":"a-ulale, neggweburgi dule-gandikmalad be-dobee itomalad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ar be dule-wileged-suli-suli-itodiidga be niga ogannosad.","poem":1},{"text":"Dule-ibmar-abesa-gudiid, be bendaksa gusad.","poem":2},{"text":"Igar-bulegan-idu be, e-bendakedga gusad,","poem":1},{"text":"dad-ibeler-gaed-irwa ibmar-nagueyob ega be gusad.","poem":2},{"text":"Dule-isganamar-e-bunnoedi, burwa-dummad-noeyobi, galu-matusulidgi-gwichigueyobi gued,","poem":1},{"text":"nega-dulesulidganba neg-diopisur-itolegeyobi gued.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Igi nega-dulesulidganba neg-diopisuli itoledae,","poem":1},{"text":"deyobi, be dule-yar-baidginmalad-oimakedi, bogidik imaked.","poem":2},{"text":"Igi mogir dad-ibeler-idu negsichii imakdae,","poem":1},{"text":"deyobi, dule-bulegan be obeloged.","poem":2}]},{"type":"verse","number":6,"content":["Bab-Jehová-Bela-Gangued-Nikadi sogded:",{"text":"“Sión-yalagine, bela dulemar-yar-baid-baidgi-bukmaladga, an mas-nuegan-yeer-gullemalad bukidar imakoed.","poem":1},{"text":"Vino-nuegan-sunsogmalad an bukidar imakoed.","poem":2},{"lineBreak":true},{"text":"Mas-bur-yeer-gullemalad-nuegan, degi, bur vino-sunsogmalad-sulearmalad an imakobaloed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ani we-yalagine, mor-dummad dulemar-odukunaidi, esirmakoed.","poem":1},{"text":"Mor-dummad-dulemar-yar-baid-baidgi-bukmalad-odukunaidi, esirmakoed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ani Bab-Jehová, burgwed-igar degisadegu obelogoed.","poem":1},{"text":"Degi, bela dulemarga ibyanis elioed,","poem":2},{"text":"bela napneggi, e-dulamar-mesagwar-gudiid onogoed.”","poem":1},"Ar Bab-Jehová, e-sunnad deyob sogsad."]},{"type":"verse","number":9,"content":["A-ibagangine, weyob sogledagoed:",{"text":"“Eye, ar we, anmar-Bab-Dummadid.","poem":1},{"text":"Anmar egi bensulid, ar we, anmar-abonosad.","poem":2},{"text":"We, Bab-Jehová gued, egi anmar bengussulid.","poem":1},{"text":"Anmar wergumarsun,","poem":2},{"lineBreak":true},{"text":"Bab-Jehová-anmar-abonosadgi anmar weligwar itomarsun.”","poem":2}]},{"type":"verse","number":10,"content":["Isaías sogdebalid:",{"text":"“Bab-Jehová we-yala akoed,","poem":1},{"text":"Moab-yaladi sabsur-odurdaklegoed,","poem":2},{"text":"igi durgangi annaledii dae,","poem":1},{"text":"deyob Moab-yala imaklegoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Igi dule-dapumaknadapir, sakwa-onakwiddae,","poem":1},{"text":"degine, aka dii-urba dogdedae,","poem":2},{"text":"deyobi, Moab-dulemar e-san-dummarba-itogedbali,","poem":1},{"text":"aisaar sakwa-onakwesii gumaloenad.","poem":2},{"text":"Degi-inigwele, Bab-Jehová, we-dulemar e-san-dummarba-imakmalad ei obelogoed.","poem":1},{"text":"Gannarse we-dulemar barguosulid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bab-Jehová ei galu-matusurmalad, degi, neg-gandikmalad bibisgoed,","poem":1},{"text":"bela napaga obinyoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/24.json","previousChapterAudioLinks":{},"numberOfVerses":12}