{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":26,"content":[{"type":"heading","content":["Isdarmaladgi-nakwedgi-namakleged"]},{"type":"verse","number":1,"content":["A-ibagine, dulemar Judá-yargi we-namaked namakdemaloed:",{"text":"“Anmardi neggwebur-gandikid nikamalad.","poem":1},{"text":"Bab-Jehová, neggwebur-gandikidi,","poem":2},{"lineBreak":true},{"text":"galu-matusulidyobi, degi, neg-abingaed-gandikidyobi anmar-bendakega imaksad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jerusalén-neggwebur-e-yawagak egamar,","poem":1},{"text":"adi, dule-nuegan innikii-Bab-igargi-nanamalad ubomalagar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dule-beginbi-binsaedi, bogidikidgi-gudisaega be imakoed,","poem":1},{"text":"ar begi bensulid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Jehováʼgi-bensuli be gudii gumar,","poem":1},{"text":"ar Bab-Jehováʼbi akwasailayobi degisadegu gued.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová, dule-gannarba-san-sadimaladi sabsur-imaked,","poem":1},{"text":"neggwebur-san-dummarba-imakedi, ogalakued.","poem":2},{"text":"Napase-balimetega imaked,","poem":1},{"text":"napabi-nai imaked.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dule-wilegana, degi, dule-nollogana,","poem":1},{"text":"we-neggweburgi dii-dii annamaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"”Dule-innikimalad-e-igar innikigwadbiid,","poem":1},{"text":"Bab-Jehová, bedi dule-innikigwad gued,","poem":2},{"lineBreak":true},{"text":"bee be, dule-innikigwadga igar inniki imaked.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová, anmar begi bensurmalad.","poem":1},{"text":"Be-igar-nabolemalad-innikimaladgi bensurmarbalid.","poem":2},{"text":"Anmar begi-binsadii gubied,","poem":1},{"text":"be-nuggi-binsadii gubied.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mutikidbali, degi, ibginedbali, an be-amidaed.","poem":1},{"text":"Be igar-innikigwad napneggi ukdele,","poem":2},{"lineBreak":true},{"text":"bela dule-napnegginmalad durdakdedamalad, ibi igar-innikigwadi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Jehová, be dule-isganamar wiledakda-inigwele,","poem":1},{"text":"degite, amba igar-innikigwad durdaksurmalad.","poem":2},{"text":"Napneggi dule-nuegan-abargi-gudimar-inigwele, galagwensuli gudimalad,","poem":1},{"text":"Bab-Jehová-Bela-Gangued-Nikadsuliyob be-dakdamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”Bab-Jehová, be sabsur-odurdaked-igar guagwar ega be nasiksad,","poem":1},{"text":"ar emardi degite aku dakmalad.","poem":2},{"text":"Be anmar-bela-bela-sabed we-dulemarse be oyoge,","poem":1},{"text":"adi, bingedar itomalagar.","poem":2},{"lineBreak":true},{"text":"Dule-isganamar-idu be soo-sisadgi obeloge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"”Bab-Jehová, be anmarga bogidikid uked,","poem":1},{"text":"ar bela anmar-ibmar-imakedi, be-ganguedba anmar imaked.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bab-Jehová, be anmar-Bab-Dummadid.","poem":1},{"text":"Dummagan-baigan anmar-dummaganga gusmalanad,","poem":2},{"lineBreak":true},{"text":"degi-inigwele, anmar bur be-nugbi odummoged.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"We-dummagan bato burgwismalad, bar durguosurmalad.","poem":1},{"text":"Bato napaga gusmalad, bar gwisguosurmalad.","poem":2},{"text":"Ar be we-dummagan sabsur-odurdaksad, bela be obelosad.","poem":1},{"text":"Dulemar melle egi bar binsaega be imaksad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bab-Jehová, be anmar-yala onasguega imaksad,","poem":1},{"text":"be anmar-yala onasgusad, dule-gandikidga be gusad.","poem":2},{"lineBreak":true},{"text":"Bela yarmar-abingunanaid-onasguega be imaksad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bab-Jehová, anmar suli-suli-itodigua, anmar bese gochagusad.","poem":1},{"text":"Be anmar-sabsur-odurdaknaigua, anmar ulubgi-nunmaked-abalagi bese gochagusad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Igi sior-gurgin-nikad e-boni-itoalile, nunmakedba binnasuli gollardae,","poem":1},{"text":"deyob, Bab-Jehová, anmar be-asabinni nunmakedba binnasuli gorsii gusad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Anmar binnasuli bese gochamar-inigwele, degi, nunmakedgi bese gocha-inigwele,","poem":1},{"text":"unnila boniganbi anmar abingasad.","poem":2},{"text":"Gwen anmar napnegse emar-bendaked senonisulid,","poem":1},{"text":"napneggi-dulemar-bukib-bukuega gwen gwalulessurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"”Degi-inigwele, Bab-Jehová, be-dula-burgwarmalad gannar dula gudii gumaloed.","poem":1},{"text":"E-muimar gannarse dula gumaloed.","poem":2},{"text":"¡Dulemar-burgwar-mamaidi, be gwisgumar!","poem":1},{"text":"¡Weligwaledgi binnasuli be gormar!","poem":2},{"text":"Bab-Jehová, igi be bolegoedba, be-boo-miedi, gaganmar odungudae,","poem":1},{"text":"deyobi, be-dula-burgwarmalad gannar be odulogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"”¡An-dulamar! Be-negyaba be ubomar.","poem":1},{"text":"Yawagak be edumalo.","poem":2},{"text":"Wis ichee be dukumalo,","poem":1},{"text":"Bab-Jehová e-urwed-berguedse be dukumalo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Itoakwaa be bukumalo,","poem":1},{"text":"ar Bab-Jehová e-maidgi noesokalid.","poem":2},{"text":"Dulamar we-napneggi-bukmalad egi isgusadba sabsur-odurdakdasokalid.","poem":1},{"text":"Napnega ablis-aryosadi, oyogoed,","poem":2},{"lineBreak":true},{"text":"napnega dulemar-burgwismaladi, bar odukumai guosulid.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}