{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":27,"content":[{"type":"heading","content":["Israel-dulemar-ollor-guoed"]},{"type":"verse","number":1,"content":["Isaías sogded:",{"text":"“A-ibagangine, Bab-Jehová, naibe-dummad-Leviatánʼye-nugad sabsur-odurdakoed.","poem":1},{"text":"Naibe-sinni-sinnid-Leviatánʼye-nugad sabsur-odurdakoed.","poem":2},{"text":"Bab-Jehová e-es-suid-gandikidgi,","poem":1},{"text":"degi, e-es-suid-dummadgi achu-simudubaled muu-billi-yagi-maidi oburgoed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"A-ibagangine, Bab-Jehová weyob sogdoed:","poem":1},{"text":"‘Uva-nainu-nued-sulealedga be namakmar:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ani, an Bab-Jehová, uva-nainu-edarbedga an gued.","poem":1},{"text":"Bali-bali an-uva-nainu an oged.","poem":2},{"lineBreak":true},{"text":"Melle dule ani oakalogega, mutikidbali, ibginedbali, an-nainu an edarbed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"An ese bar urwesulid.","poem":1},{"text":"Ar amba ikomar uva-nainugi nikana,","poem":2},{"text":"gagan-ikobimalad amba uva-nainugi nikana,","poem":1},{"text":"an ebo ulusaled, an bela ogumaksaled.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ar Israel-dulemar e-irwar gwisgubi an-abegele,","poem":1},{"text":"anbo igar nudakergebed.","poem":2},{"lineBreak":true},{"text":"Anbo igar nabogergebed.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"”Yoo ibagan nonikoed, Jacob-wagan ambikunonikoed,","poem":1},{"text":"Israel-dulemar gannar ainidagoed,","poem":2},{"text":"nue-nasgumai gudagoed.","poem":1},{"text":"E-ibmar-nuegan napneg-dirbirmakar-naidgi iirmakmai gudoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ar igi Bab-Jehová dule-baigan-sabsur-imaksa,","poem":1},{"text":"¿deyobi Bab-Jehová Israel-dulemar-sabsur-imaksasi? Suli.","poem":2},{"text":"Ar igi Bab-Jehová dule-baigan-ogilosgusa,","poem":1},{"text":"¿deyobi Bab-Jehová Israel-dulemar-ogilossi? Suli.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ar Bab-Jehová e-dula-sabsur-odurdaksad, e-yalagi-bukwadgi onosad.","poem":1},{"text":"Igi burwa-ued nega-dulesulidganba-gordae,","poem":2},{"lineBreak":true},{"text":"deyobi, Bab-Jehová, Israel-dulemar-neggwebur-dikasurmaladse-odurdaklegega barmeted.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jacob-wagan-e-isgued, weyob osulolenonikoed,","poem":1},{"text":"e-isgued-osulolegegala, weyob imakmalargebed:","poem":2},{"text":"Bela bab-dummagan-e-ailamar-bukwad obelomalargebed,","poem":1},{"text":"we-ailamar, akwasib-ebillegeyob imakmalargebed.","poem":2},{"text":"Deginbali, Jacob-wagan, bab-bundor-Asera-e-wilub bipisaale bar ogwissulirgebed,","poem":1},{"text":"degine, bali ina-wawadikmalad-aila obukusulirgebed.","poem":2},{"lineBreak":true},{"text":"Geb degidbali, Bab-Jehová, Jacob-wagan-e-isgued osulogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Ar neggwebur-gandikid-siid bela oitoles siid,","poem":1},{"text":"neg olloo mellesiid.","poem":2},{"text":"Igi-nega-dulesulidganba dule sate, deyobi siid.","poem":1},{"text":"Moli-bebe-nikad-senigwad-gagan-maed-negga guded,","poem":2},{"text":"moli-bebe-nikad-senigwad-obunnoged-negga guded.","poem":1},{"text":"Sapi-gaganmar bela ese bergued.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Geb sapi dingudele, e-anagan bibichiddaed.","poem":1},{"text":"Geb omegan, sapanga aminonidamalad.","poem":2},{"text":"Ar Israel-dulemar neg-gunaid nue-akusunna itomalad.","poem":1},{"text":"A-ulale, e-Bab-Dummad-e-obinnisadi, we-dulemar-wiledaksulid,","poem":2},{"lineBreak":true},{"text":"a-ulale, e-Bab-Dummad-e-obinnisadi, we-dulemarga igi-barsaye sogosulid.”","poem":2}]},{"type":"verse","number":12,"content":["A-ibagangine, Bab-Jehová, Éufrates-diwar-suke-aryomaid-akale, degi, Egipto-dian-maidse dulemar-egwaoed. Ar bemar Israel-dule-gumaladdi, igi-dule-sapurgi-arbaed ibmar-gwag gagagwen weedae, deyob bemar war-wargwen welemaloed."]},{"type":"verse","number":13,"content":["A-ibagangine, gar-trompeta-dummad gordagoed. Asiria-yalase, degi, Egipto-yalase, dulemar-galesa-selesgusadi, Jerusalén-Yala-Islidikidse Bab-Jehová-nug odummononimaloed."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/26.json","previousChapterAudioLinks":{},"numberOfVerses":13}