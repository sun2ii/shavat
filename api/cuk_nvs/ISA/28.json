{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":28,"content":[{"type":"heading","content":["Efraín-yala sabsur-odurdaklegoed"]},{"type":"verse","number":1,"content":[{"text":"Efraín-dule-mummugan san-dummarba-imakdimalad, ¡duledar-wilesmar!","poem":1},{"text":"E-dummagan neba-nued-mullu-birgi dutu-dinnagana-bukwayobi gumalad.","poem":2},{"lineBreak":true},{"text":"Dulemar-vinoʼse-ebipiledimalad, ¡be duledar-wilesmar!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová dule-gwensak-yeer-gangued, be-idu amisad,","poem":1},{"text":"dule-dutusulid be-idu amisad:","poem":2},{"text":"We-dule, bela ise-urwedgi sabsur-be-imaknonikoed,","poem":1},{"text":"we-dule, dii-gwamakar-wieyobi gangued,","poem":2},{"text":"burwa-dummad-dule-obelogedyobi gangued,","poem":1},{"text":"dii-burwaba-mesa-wiedyobi gangued,","poem":2},{"lineBreak":true},{"text":"diwar-dummad-noedyobi gangued.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Efraín-dule-mummugan san-dummarba-imakdimalad, ¡duledar-wilesmar!","poem":1},{"text":"Egi dii-dii annalegoed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"We-dutu e-gangued-yeerdaklegedi, neba-nued-mullugwagi-gwichidi, dingudoed.","poem":1},{"text":"Igi higo-san-gorogwad gwallegoed-iduar dule bato daksayalaba, gwandae,","poem":2},{"text":"degi, geb gundae,","poem":1},{"text":"deyobi gumaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"A-ibagangine, Bab-Jehová-Bela-Gangued-Nikadi, e-dula-napi-ichee-bemaloedgala, ologurgin-yeerdaklegedga guoed,","poem":1},{"text":"ibmar-yeerdakleged-bebegi-nagued-gandikidga guoed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Dummadi, dule-igar-nabogedga igar-innikii-imaked-burba ukoed.","poem":1},{"text":"Neggwebur-yawagakgi-nakulemaladga niga-ogannogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Amba dule-irwa-Bab-Dummadse-gormaladi,","poem":1},{"text":"degi, Bab-Dummad-gayaburba-barsogmaladi,","poem":2},{"text":"vinoʼba bipirmakdemarmogad,","poem":1},{"text":"inna-gagbid ebipiledimarmogad.","poem":2},{"text":"Vinoʼba binsaedsuli nadmalad","poem":1},{"text":"Inna-gagbid-gobedba yoledimalad.","poem":2},{"text":"Negburgan-dakalile, wawanmakdedamalad,","poem":1},{"text":"ibmar-sokarmalale, suli-suli-ito naddamalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bela mesemar aged-sunnabi bukwad,","poem":1},{"text":"gwen neg daarmakar naisulid, bela isgusnaid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Deginbali, an-annik weyob sogmalad:","poem":1},{"text":"“¿Ar wis doamar-odurdaknai itoge?","poem":2},{"text":"¿Doamarga Bab-Dummad-gayaburba-barsognai itoge?","poem":1},{"text":"¿Burwigan-gebe-mam-iargusayobi anmargi binsae?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"¿Burwigan-gebe-garda-absoged-durdaknaidyobi anmargi binsae?","poem":1},{"text":"Gannar-gannar anmarga igar-mamaid sognaid,","poem":2},{"text":"ise-sogar-ise-sogar we-igargi anmar-odurdaknaid.","poem":1},{"text":"Nugmargi gwagwagwen-gwagwagwen anmar-odurdaknaid.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Emigindi nabir, ar bemar Bab-Dummadba ibsasulile, Bab-Dummad bemarga gaya-baidba sunmakoed,","poem":1},{"text":"a-gaya bemar aku itomaloed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bab-Dummad bemarga bato weyob sogsa gusad: “Wegine, neg-bogidikid-negad.","poem":1},{"text":"Dule-yegusgudiid wegi obunnogoed.”","poem":2},{"text":"Degi, sogsabalid: “We-neg, obunnoged-negad.”","poem":1},{"text":"Degi-inigwele, bemar gwen itossurmalad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Degisoggu, Bab-Jehová, burwigana-gebe-garda-absoalidga-sunmakedyob ega sunmakoed.","poem":1},{"text":"Gannar-gannar ega igar-mamaid sognai guoed,","poem":2},{"lineBreak":true},{"text":"ise-sogar-ise-sogar we-igargi amar-odurdaknai guoed.","poem":2},{"text":"Nugmargi gwagwagwen-gwagwagwen amar-odurdaknai guoed.","poem":1},{"text":"Amar nanadmalale, gebe-burwigan-nag-obialidyob gumaloed:","poem":2},{"text":"Yarganba ailadmaloed, nailikgumaloed,","poem":1},{"text":"gege bar gwisgue gumaloed.","poem":2}]},{"type":"heading","content":["Jerusalén-dulemarse-nuedgi-gorlesad"]},{"type":"verse","number":14,"content":[{"text":"Jerusalén-neggwebur-e-dummagan-bingedsulidamalad,","poem":1},{"text":"Bab-Jehová-gayaburba be itomar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ar bemar weyob sogmalad: “Anmar burgwed-igarbo igar amisad,","poem":1},{"text":"anmar burgwed-galubo igar amismalad.","poem":2},{"text":"Boni-dummagan anmargi danikile, anmarse warmakosulid,","poem":1},{"text":"ar ade, anmar-gakansaedi anmar napiragwadyobi daksad,","poem":2},{"lineBreak":true},{"text":"anmar-emar-yardakedi anmar igar-nuediyobi daksad.”","poem":2}]},{"type":"verse","number":16,"content":["A-ulale, Bab-Jehová-Bela-Gangued-Nika-Maid weyob soged:",{"text":"“¡Be dakmala! Ani an Sión-yalagi akwa-bur-nued-sulealed negsailaga mesisad.","poem":1},{"text":"Akwa neg-gaega, akwa-nued an ebusad,","poem":2},{"lineBreak":true},{"text":"adi, neg gandik sii guegar.","poem":2},{"text":"Ar dule agi bensulile, suli-suli itogosulid.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ar ade, we-neg-soblegoedi igar-napiragwad-wilubsaega an imakoed,","poem":1},{"text":"igar-innikigwad-wilub-imakega an imakoed.","poem":2},{"text":"Dii-gwamakar-wimaladi bela bemar-gakansaed-igar-napiragwadyob-imakdimalad obelogoed,","poem":1},{"text":"diimala, bela bemar-neg-dukued odogoed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Degidbali, bemar burgwed-igarbo-igar-mesisadi bar igarga-guosulid.","poem":1},{"text":"Burgwed-galubo-igar-amismaladi bar gangued-nika guosulid.","poem":2},{"text":"Boni-dummagan bemargi danikile,","poem":1},{"text":"bela bemargi gwichigunonikoed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Be-isdarmalad bemargi-gwichigued-ilibali, ese be bergudii guoed.","poem":1},{"text":"Bane-bane, mutikidbali, ibginedbali, bemargi nanagwichi guoed.”","poem":2},{"lineBreak":true},{"text":"Bonigan-daniye itoarmalale,","poem":1},{"text":"bela-belad nue-dobe itodmaloed.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Gas-bipigwadgi-megeyob gumaloed,","poem":1},{"text":"atued-bipigwadgi-atueyob gumaloed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bab-Jehová, Perazim-yalagi-ulusadyob, uludagoed.","poem":1},{"text":"Gabaón-nebagi e-urwed-oyosadyob, oyodagoed.","poem":2},{"text":"Bab-Dummad bato guagwarmaid,","poem":1},{"text":"ukiarmakale, weyob-ibmar-imakdisulid imakoed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Emigindi, bemar melle bar Bab-Jehováʼgi dodomalo,","poem":1},{"text":"adi, melle bur bule be sabsur-odurdaklemalagar.","poem":2},{"lineBreak":true},{"text":"Ar Dummad-Bab-Jehová-Bela-Gangued-Nikadi, bela neggweburmar-obelolegoedgi-sunmaksa an itosad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Be itomar, nue be an-gayaburba itomar.","poem":1},{"text":"Nue be bogi an-itomar,","poem":2},{"lineBreak":true},{"text":"an-ibmar-soged be itomar:","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Sapurgi-arbaed-dule, ibmar-digega napa imued.","poem":1},{"text":"A-dule, ¿obunnosuli napa-imuedginbi alamakdii guode? Suli.","poem":2},{"lineBreak":true},{"text":"¿Unnila bane-bane napa-swaana, degi, gwisar-gwisar imaknai guode? Suli.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ar bela napa guakwaa imaksale, ¿gagan-wawagan-gwag-eneldoʼye-nugad mie-mie imakdasursi?","poem":1},{"text":"¿Ibmar-gwag-cominoʼye-nugad digdasursi?","poem":2},{"text":"Geb a-sorba, ¿ilekwaa-orosgi-dakleged-trigo digdasursi?","poem":1},{"text":"¿Orosgisaar-dakleged-cebada digdasursi?","poem":2},{"text":"¿Nainu-gakabali orosgi-saardakleged-centenoʼye-nugad digdasursi?","poem":1},{"text":"Eye, deyob imakdado.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ar ade, Bab-Dummad weyob ibmar-imakega dule-odurdaked,","poem":1},{"text":"igi dule ibmar imakoe, aba odurdaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ar gagan-wawagan-eneldo-gwag, orosyob omukulesulid.","poem":1},{"text":"Ibmar-gwag-cominoʼye-nugad-birgine, e-gwag-oniega ibmar-ukusulid obipirmaklesulid.","poem":2},{"text":"Ar ade, gagan-wawagan-eneldo-e-gwagmar suar-bipigwadgi obateledaed,","poem":1},{"text":"Ibmar-gwag-cominoʼye-nugad suar-nollogwadgi obateledaed.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Oros-gwagmar omukulenaile, sabsur-ubikwaa imaklesulid.","poem":1},{"text":"Deginbali, ibmar-gwag naglenaidbi geg gued.","poem":2},{"text":"E-birgine, ibmar-ukusulid-nanaega imakleged,","poem":1},{"text":"ar molimardi, ibmar-gwagmar ubimaksulid.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"We-binsaedi, bela Bab-Jehová-Bela-Gangued-Nikadgi danibalid.","poem":1},{"text":"E-binsaed-dakedi, innikigwadid,","poem":2},{"lineBreak":true},{"text":"e-binsaed-nikadaedi, sunsogedid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/27.json","previousChapterAudioLinks":{},"numberOfVerses":29}