{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":29,"content":[{"type":"heading","content":["David-neggwebur-ibitogoed"]},{"type":"verse","number":1,"content":["Bab-Jehová sogdebalid:",{"text":"“Ariel-neggwebur, be nue-wilegoed.","poem":1},{"text":"We-neggwebur, David-sorda-ambikusad-negad.","poem":2},{"lineBreak":true},{"text":"Gatik birga-irba iba-onodii be nanamar.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Degi-inigwele, Ariel-dorgan, an begala bonigan onogoed.","poem":1},{"text":"Ar ogormaksii be guoed, bukib-binsasii be guoed.","poem":2},{"text":"Bela neggwebur soose ogumaklegoed,","poem":1},{"text":"ibmar-ogumakar-ukleged-ailagi ibmar-ogumaklegeyob guoed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"An-sorda-bila-onomalad bela be-ebilis an urboed.","poem":1},{"text":"Bela neggwebur-dikarbali, bila-onoged-galumar an emakoed,","poem":2},{"lineBreak":true},{"text":"bila-onoged-aila an be-iduar soboed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mesagwar be imaklegoed,","poem":1},{"text":"napagi mellemai be guoed.","poem":2},{"text":"Be-ibmar-biedi wis-bollee-itolege guoed.","poem":1},{"text":"Be-gayaburba galudor-sunmakedyob itolege guoed.","poem":2},{"lineBreak":true},{"text":"Napayala be sunmakmaile, unnila wis bipi-bollee itolege guoed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Be-isdarmalad-ichesulidi, ukub-buruyob guoed.","poem":1},{"text":"Dule-gandikmalad-bukidaradi, gagan-durgan-dinnagana burwaba seleddaedyobi, imaklegoed.","poem":2},{"lineBreak":true},{"text":"Ukiarmakagwale, ilagwen-saale imaklegoed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Jehová-Bela-Gangued-Nikadi, bese nonikoed.","poem":1},{"text":"Mala-abalagi, negabandur-abalagi nonikoed.","poem":2},{"lineBreak":true},{"text":"Neg-oimakagwaled-abalagi nonikoed,","poem":2},{"text":"burwa-ololed-abalagi, burwa-dummad-abalagi nonikoed.","poem":1},{"text":"Degine, soo-duurmakwichid-abalagi nonikoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dula-bukidar-yar-baid-baidgi-bukmalad Ariel-neggweburgi-gwisgumaladi, bela e-neg-gandikmalad-ei-earbimaladi, bela neggwebur-ebirdimaladi, bela bergudmaloed.","poem":1},{"text":"Boo-dadabin-berguddaeyobi, bergudmaloed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dula-bukidar-yar-baid-baidgi-bukmaladi, Sión-yalagi-bila-onomaladi, ukudba burgwidmaloed.","poem":1},{"text":"Dule gabidele, na mas-gunsiiye gabdakdamaloed,","poem":2},{"lineBreak":true},{"text":"gobsiiye gabdakdamaloed.","poem":2},{"text":"Degi-inigwele, ataas-nadele, ukudmaada itodamaloed.","poem":1},{"text":"Gammu dinare itodamaloed.","poem":2}]},{"type":"heading","content":["Israel-dulemar burbar aku-atakmalad, degi, wagar-darbo damalad"]},{"type":"verse","number":9,"content":[{"text":"Bemar Bab-Dummad-gayaburba-barsogmalad, dule-binsaedsulidyob be gudii gumarsun.","poem":1},{"text":"Dule-aku-atakedyob, ibmar-akudake be gudii gumarsun.","poem":2},{"text":"Mummuyobi be aibandii gumarsun","poem":1},{"text":"Inna-gagbid gobsabayobi be aibandii gumarsun.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Jehová bela-belad bar-ibmar-daksuli be-imaksad.","poem":1},{"text":"Bab-Dummad-gayaburba-barsogmalad-ibe burbar-geg-ibmar-dake imaksad.","poem":2},{"lineBreak":true},{"text":"Negburgan-dakmalad bar negburgan-daksuli imaksad.","poem":2}]},{"type":"verse","number":11,"content":["Negburgan-bemarga-oyolegedi, garda-bipirmakaled-sakdigaleyobi guoed, be aku itomaloed. Ar dule-garda-wisidga, we-garda-bipirmakar-maid be uksale, ega be sogele: “Wis be anga absoye.” We-dule, be-abin weyob sokaliled: “An bega absogosurye. Ar ade, sakdigar maiddeeye.”"]},{"type":"verse","number":12,"content":["Ar dule-garda-wissulidga, we-garda-bipirmakar-maid be ukye sogele, ega be sogele: “Wis be anga absoye.” We-dule, be-abin weyob sokaliled: “An garda wissur-absoye.”"]},{"type":"verse","number":13,"content":["Bab-Jehová weyob Isaíasʼga sogded:",{"text":"“We-dulemar an-nug-odummoye soged.","poem":1},{"text":"E-sunmakedgi an-nug-ogannoye soged.","poem":2},{"text":"Degi-inigwele, unnila asginbi an-nug odummomalad.","poem":1},{"text":"E-gwage-ulubgindi angi gwen binsasurmalad.","poem":2},{"text":"An-dobee-nanaye-sogmaladi, ar gwen an-igar-maidba nanasurmalad.","poem":1},{"text":"Unnila dulemar-igar-mamaidba nanamalad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"A-ulale, we-dulemar gannar ibmar-gegerdaklemalad-dakega an imakoed,","poem":1},{"text":"geb geger dakdemaloed.","poem":2},{"text":"E-dule-binsaed-ibegan e-binsaed-nikadi, an ei osulogoed,","poem":1},{"text":"degi, e-dule-nue-ibmar-wismalad ibmar-wissulidga an imakoed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dulemar Bab-Jehová-idu-dukumaloye-na-bimaladi, ¡be duledar-wilesmar!","poem":1},{"text":"E-igar-dukuar-imakdimaladi, negsichigi igar-isgana-imakdimaladi, ¡be dule-wilesmar!","poem":2},{"text":"Ar we-dulemar na binsadimalad:","poem":1},{"text":"“¿Ar doa anmar-dakoe? ¿Doa anmar-wisguoe?","poem":2},{"text":"Gwen dule anmar-dakosuli.","poem":1},{"text":"Gwen dule anmar-wisguosuli.”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"¡Ibiyob be gakansadamala!","poem":1},{"text":"¿Ar dule-napsagi-arbaed, napsabo emarsi?","poem":2},{"text":"Ar ibmar-soblesadde, dule-e-sobsadga sogosi:","poem":1},{"text":"“Be an-sobsasuli.”","poem":2},{"text":"Napsa-sobaled, sunna dule-napsagi-arbaedga sogosi:","poem":1},{"text":"“Amba be ibmar wissuli.”","poem":2},{"lineBreak":true},{"text":"Suli, gege deyob soged.","poem":2}]},{"type":"heading","content":["Israel-dulemar abonolegoed"]},{"type":"verse","number":17,"content":[{"text":"Líbano-yala emisgwasaale, napa-nuedga guoed, gadi-ibmar-sanmakedga guoed.","poem":1},{"text":"Napa-gadi-ibmar-sanmakedi, sapurga naguoed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"A-ibagangine, uaya-satemaladi, dule ega garda-bipirmakar-maid absoalile, magar itodmaloed.","poem":1},{"text":"Dule-ibyasurmaladi, magar atakdemaloed,","poem":2},{"lineBreak":true},{"text":"negasichid bar ega naguosulid.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Dule-wilemaladi, gannar Bab-Jehováʼgi yeer-itodmaloed,","poem":1},{"text":"dule-ibmar-abesa-gudimalad Israel-e-Bab-Jehová-Isligwaledgi weligwar-itodmaloed.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"A-ibagangine, sabsur-dule-imakmaladi, dule-isgudimaladi, bela yoggudoed.","poem":1},{"text":"Ibmar-isgana-saedginbi-binsadidamaladi, bela obelolegoed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yogabinne-dulegi-gakansaar-gwisgumaladi, dule-igar-nabomalad-yamoged-dulemala,","poem":1},{"text":"degi, dule-e-bendaked-satedgi yamo-gakansaale-sunmakmaladi, bela obelolegoed.","poem":2}]},{"type":"verse","number":22,"content":["A-ulale, Bab-Jehová Abraham-bendaksadi, weyob Jacob-waganga soged:",{"text":"“Emi-iba-onodoedgi, bemar Jacob-wagan bar bingedar itogosulid,","poem":1},{"text":"dobedba bar niga-argwanosulid.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Israel-e-mimmigan bela e-dulemargi an-ibmar-imaksad magar daksamalale, bela an-nug-odummodmaloed,","poem":1},{"text":"degi, bela Israel-dulemar Jacob-e-Bab-Dummad-Isligwaled-nug odummodmaloed.","poem":2},{"lineBreak":true},{"text":"Israel-e-Bab-Dummadgine binsaed-nikaa gudmaloed.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Dulemar aku-neg-itodimalad, magar neg-itoge namaloed.","poem":1},{"text":"Dule-geg-boo-gudidamaladi, an-igar-maid itodmaloed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/28.json","previousChapterAudioLinks":{},"numberOfVerses":24}