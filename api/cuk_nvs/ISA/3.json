{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":3,"content":[{"type":"heading","content":["Bab-Jehová Judá-dulemar, degi, Jerusalén-dulemar nue-wiogoed"]},{"type":"verse","number":1,"content":["Isaías Jerusalén-dulemarga, degi, Judá-dulemarga sogded:",{"text":"“¡Nue bogi be an itomalo!","poem":1},{"text":"Bab-Jehová-Bela-Gangued-Nikadi Jerusalén-neggweburgi, degi, Judá-yargi, bela ibmar-nabir-gullemalad obelogoed:","poem":2},{"lineBreak":true},{"text":"Bela masgullemalad, bela gobedmarse-bakale, obelogoed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová, bela we-dulemala, Jerusalén-neggweburgi, degi, Judá-yargi, osulogoed:","poem":1},{"text":"Bela dule-gandikmalad,","poem":2},{"lineBreak":true},{"text":"bela dule-bila-onomalad,","poem":2},{"lineBreak":true},{"text":"dule-igar-nabomalad,","poem":2},{"lineBreak":true},{"text":"e-gayaburba-barsogmalad,","poem":2},{"lineBreak":true},{"text":"dule-ibmar-guoedgi-iduakwaa-sunmakmalad,","poem":2},{"lineBreak":true},{"text":"girmar-dummagan,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"sorda-bila-onomalad-e-idumalad,","poem":2},{"lineBreak":true},{"text":"dule-nug-nikamalad,","poem":2},{"lineBreak":true},{"text":"dule-binsaed-dakmalad,","poem":2},{"lineBreak":true},{"text":"galagwensuli-ibmar-sobmalad,","poem":2},{"lineBreak":true},{"text":"degine, dule-burgwismaladse-gabgin-ibmar-egismalad,","poem":2},{"text":"wemar, bela obelogoed.”","poem":3}]},{"type":"verse","number":4,"content":["Bab-Jehová soged:",{"text":"“An negsemalaga, sapingana urboed.","poem":1},{"text":"Dule-dummaganga-gumalaga, masmala-ibmar-abes-abesdamalad urboed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dulemar na muchub-muchub sabsur-imakdemaloed:","poem":1},{"text":"Dule e-neg-dikarba-maidbo, na abin-abin nagudmaloed.","poem":2},{"text":"Sapingwa, dador-sarsodoed.","poem":1},{"text":"Dule-binsaled, dule-nug-nikadbo na sabsur-imakdemaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"”Dule-gwensak e-bab-neggi e-gwenadga sogdagoed:","poem":1},{"text":"‘Ar bedi mor-nued-ise-nudakar be yoisoggu, we-neg-gagalenaid nudake,","poem":2},{"lineBreak":true},{"text":"be anmar-dummadga gue.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Geb e-gwenaddi e-abin sogdagoed:","poem":1},{"text":"‘An nersuli.","poem":2},{"text":"Ar an-neggi mas sated, morbela satebalid.","poem":1},{"text":"Melle neggwebur-dummadga-guega be an-imake.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ar Jerusalén-neggwebur nue-bergus mellesiid,","poem":1},{"text":"Judá-yar nue-oitoles naid.","poem":2},{"text":"Ar e-sunmakedi, e-ibmar-imakedi, Bab-Jehováʼgi ise-yolegaled.","poem":1},{"text":"Amarde, Bab-Dummad-e-gangued-yeerdakleged bai daksulid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"E-ichakwadamaladgi na dukin e-daed barsoged.","poem":1},{"text":"Sodoma-dulemar-isgusadyobi, e-isguedgi bule-bule-gudiid odukusurmalad.","poem":2},{"text":"¡Emar na dummad-wilesmar!","poem":1},{"text":"Na dukin sabsur-odurdaklegega gunanaid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dule-napira-nanadiidga be sogmalo, “bega ibmar nueganbi guoye.”","poem":1},{"text":"Ar na e-arbadiidgi nue-ibmar nikuoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"¡Dule-isgana, be nue-wiles!","poem":1},{"text":"Ar bega ibmar-nuegan guosulid,","poem":2},{"lineBreak":true},{"text":"ar be-arbasadgi na be odurdaklegoed.","poem":2}]},{"type":"verse","number":12,"content":["Bab-Jehová sogbalid:",{"text":"“¡An-dulamar, be nue-wilesmar!","poem":1},{"text":"Sapinganse mesagwar-gudimalad,","poem":2},{"lineBreak":true},{"text":"Omegan ega dummadga-negdakmamaid.","poem":2},{"text":"¡An-dulamar, be nue-wilesmar!","poem":1},{"text":"Ar dule-be-idumaladi begi dododimalad,","poem":2},{"lineBreak":true},{"text":"ar igar-isganaba be-nidimalad.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bab-Jehová, e-dulemarga-igar-nabogega, gwichigudasokalid.","poem":1},{"text":"Dulemar-sabsur-odurdakega, gwichigudasokalid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bab-Jehová, girmar-dummagangi,","poem":1},{"text":"degi, dummagan-negsemamaidgi, gwichigudasokalid.","poem":2},{"text":"Bab-Dummad ega weyob sognonikoed: “Ar bemar uva-nainu-naid bela obelosmalad.","poem":1},{"text":"Be-negyagi dule-wilemalad-ibe-be-ibmar-atursasmalad bukwad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"¿Doa bega sogsa, an-dulamar mesagwar imakmaloye?","poem":1},{"text":"¿Doa bega sogsa, dule-wilesagwar-gudimalad be wiomaloye?”","poem":2}]},{"type":"heading","content":["Bab-Dummad, omegan-Sión-yalaginmalad sabsur-odurdakoed"]},{"type":"verse","number":16,"content":["Bab-Jehová weyob sogbalid:",{"text":"“Omegan-Sión-yalaginmalad san-bule-bule-imakmaladi, emargi-obine-itogedba bule-bule nanamalad.","poem":1},{"text":"A-omegan dule-mesagwale dakdaed.","poem":2},{"text":"San-bule-bule-imakedba, e-maligi ibmar-nanaid-ogolegala, yamo nag-bana-bana nadapdamalad,","poem":1},{"text":"adi, e-ibmar-maligi-naid-goled itomalagar.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"A-ulale, ani, omegan-Sión-yalaginmalad-e-nonogi, boni-yaa-dummagan yaisur-nikuega imakoed,","poem":1},{"text":"an bela amar-nono swana imakoed.”","poem":2}]},{"type":"verse","number":18,"content":["A-ibagine, Bab-Jehová, we-ibmarmar osulogoed:",{"text":"Maligi-ibmar-nagumalad,","poem":2},{"lineBreak":true},{"text":"bebegi-ibmar-nasiklemalad,","poem":2},{"lineBreak":true},{"text":"morgi-ibmar-nasiklemalad.","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Bela dukargi-ibmar-nasiklemalad,","poem":2},{"lineBreak":true},{"text":"sakwagi-ibmar-nasiklemalad,","poem":2},{"lineBreak":true},{"text":"muswe-wagar-odukumalad.","poem":2}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Dunwemar,","poem":2},{"lineBreak":true},{"text":"maligi-ordubyob-ibmar-nasiklemalad,","poem":2},{"lineBreak":true},{"text":"saderba-mordub-atillemalad.","poem":2},{"lineBreak":true},{"text":"Ina-wawagan-nuegan,","poem":2},{"lineBreak":true},{"text":"olargan-matar-dummagan,","poem":2}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"olarganmar,","poem":2},{"lineBreak":true},{"text":"olasumar.","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ibagi-mor-yoleged-gargerbamalad,","poem":2},{"lineBreak":true},{"text":"mor-dummagan,","poem":2},{"lineBreak":true},{"text":"mor-suigan,","poem":2},{"lineBreak":true},{"text":"mor-sakwa-metegana.","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Isbe-wagar-dakmalad,","poem":2},{"lineBreak":true},{"text":"lino-mor-nued,","poem":2},{"lineBreak":true},{"text":"mor-obipirmakar-nonogi-silemalad,","poem":2},{"lineBreak":true},{"text":"degi, dukarba-biar-mor-nasiklemalad.","poem":2},{"text":"Bela e-ibe we-ibmarmar osulolegoed.","poem":3}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"A-ibagine, ina-wawadikidbi-yapannedi, nunu-yapanne naoed.","poem":1},{"text":"Saderba-mordub-atillemalad-muchubbi, saderba gasdub nasikdemaloed.","poem":2},{"text":"Ise-gwialed-muchubbi, sailagia-sate gumaloed.","poem":1},{"text":"Ibagi-mor-gargerbamalad-yoleged-muchubbi, wilegedba mor-yaara-dakle yodmaloed.","poem":2},{"lineBreak":true},{"text":"Wagar-yeerdakleged-muchubbi, bingedar-dakle itodmaloed.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Be-machergan es-suidgi oburgwiledmaloed.","poem":1},{"text":"Be-dule-bulegan bila-onolenaidgi oburgwiledmaloed.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bela dulemar ogormakdemaloed,","poem":1},{"text":"burgwed-ibagi-mor-yoleged yodmaloed.","poem":2},{"lineBreak":true},{"text":"Neggwebur bela olloo dakle nadoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}