{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":30,"content":[{"type":"heading","content":["Dule-uayasatemalad, duledar-wilesmar"]},{"type":"verse","number":1,"content":["Bab-Jehová weyob sogsad:",{"text":"“Bemar-uayasuli-damaladi, ¡be duledar-wilesmar!","poem":1},{"text":"An-wissuli-igar-imakmaladi, an-ega-ibmar-sogsulidba ibmar-imakdimaladi, isguedginbi-nanadimaladi, ¡dule-wilesmar!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Anse-idaksuli Egipto-yalase igar amibukmalad.","poem":1},{"text":"Faraónʼgi bendakleged-amiega ese naddamalad.","poem":2},{"lineBreak":true},{"text":"Egipto-dulemargi bendakleged amibukmalad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"We-Faraón-be-bendakedi, be-bingeguega guoed","poem":1},{"text":"Egipto-dulemargi be dukued-amiedi, nug-bipii be-imakoed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Zoán-neggweburgi e-dummagan ega mamai-inigwele,","poem":1},{"text":"Hanes-neggweburse e-garda-berbemalad mosa-inigwele, gwen bendakosurmalad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bela Israel-dulemala, neggwebur ega ibmar-nued-imaksulidba bingedar itodmaloed.","poem":1},{"text":"Ar Egipto-dulemar wis gwen ega ibmar-nued imakosulid.","poem":2},{"text":"Unnila we-dulemala, emar-obingegsaedginbi binsadimalad,","poem":1},{"text":"dulemar-isdar-obelogedgi binsadimalad.”","poem":2}]},{"type":"verse","number":6,"content":["Isaías sogdebalid: “Bab-Jehová weyob Neguev-e-ibmar-durgan-guoedgi sunmaksad:",{"text":"‘Israel-dulemar, Egipto-yalase bela e-ibmar-nuegan, moli-uayasuidgi semamaid,","poem":1},{"text":"bela e-manimar moli-yargan-muregedgi semamaid.","poem":2},{"text":"Nega-dulesulidganba obakmamaid,","poem":1},{"text":"ar ade, nega-bulegan naed,","poem":2},{"text":"ar a-nega, achumigur-bulegan nika-naed,","poem":1},{"text":"naibe-bulegan nika-naed,","poem":2},{"lineBreak":true},{"text":"degi, naibe-gukuar-gukuar-nanamalad nika-naed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Egipto-neggwebur gwen emar-bendakosulid.","poem":1},{"text":"A-ulale, weyob an bied:","poem":2},{"lineBreak":true},{"text":"Ibdula-ursiliye, gwen dule-oakalosulidye.’ ”","poem":2}]},{"type":"verse","number":8,"content":["Bab-Dummad weyob Isaíasʼga sogdebalid:",{"text":"“Emisgwa be, we-ibmar dulemar-wagab narmak.","poem":1},{"text":"Urgogi be narmakar-omeso,","poem":2},{"lineBreak":true},{"text":"adi, ibagan-danikoed-idu degisadegu narmakar-oyomai guegar.”","poem":2}]},{"type":"verse","number":9,"content":["Geb Isaías sogdebalid:",{"text":"“Ar we-dulemar uayasulidamalad, dule-isgana gumalad,","poem":1},{"text":"Bab-Jehová-Igar-Maid itobisurmalad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Emide, dulemar-yoedse-ibmar-guoed-sogedga sogdamalad:","poem":1},{"text":"‘Melle bar be negburgan-daked sogmarye.’","poem":2},{"text":"Bab-gayaburba-barsogmaladga sogdamarbalid:","poem":1},{"text":"‘Melle bar be anmarga Bab-Dummad-gayaburba-napiragwad sogmarye.","poem":2},{"text":"Binsa nabir ibmar-nuegangi be anmarga sunmakmarye,","poem":1},{"text":"binsa gakangi be anmarga sunmakmarye.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Muchub-muchub sokarmalad:","poem":1},{"lineBreak":true},{"text":"‘Bab-Igargi be bangumar,","poem":1},{"text":"melle Bab-Dummadba be ibsamar.","poem":2},{"lineBreak":true},{"text":"Melle bar be anmarga Israel-dulemar-e-Bab-Dummad-Isligwaledgi sunmake.’ ”","poem":2}]},{"type":"verse","number":12,"content":["A-ulale, Israel-dulemar-e-Bab-Dummad-Isligwaled weyob soged:",{"text":"“An-bemarga-ibmar-soged be itobisurmalad,","poem":1},{"text":"mesagwar-gued bur be abemalad.","poem":2},{"text":"Igar-isgana bur be itodmalad.","poem":1},{"text":"Bur be we-igar-isganaba be akasmalad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"A-ulale, we-isguedi, bemargi gwichiguoed.","poem":1},{"text":"Igi-galu-matusulid marar-gwichile, ukiagwar ailaddae,","poem":2},{"text":"deyob bemargi isgued gwichigudagoed.","poem":1},{"text":"Ukiagwale, ilagwensaale bemargi babatedagoed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"We-isguedi, napsa-bormo ise bela-belad goa-goa-mareyob guoed.","poem":1},{"text":"Igi napsa-bormo bipisaale, gwen e-goa bar sogun-weega abelesurdae,","poem":2},{"text":"igi bar diagi dii-weedga ebulesurdae,","poem":1},{"text":"deyob we-isgued guoed.”","poem":2}]},{"type":"verse","number":15,"content":["Ar weyob Bab-Jehová-Israel-dulemar-e-Bab-Dummad-Isligwaled soged:",{"text":"“Dule e-isguedga-bukib-binsaedgi bendaklegoed,","poem":1},{"text":"nued-nanaedgi, bendaklegoed.","poem":2},{"text":"Bargaagwar-gudiidgine, degi, angi-bensuli-nanaedgine, gannaleged siid.","poem":1},{"text":"Ar degi-inigwele, bemar an-abesulid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ar bemardi weyob sogmalad: ‘Anmar moligi wakinmaloe.’","poem":1},{"text":"Degisoggu, deyob bemar wakinmalargebdo.","poem":2},{"text":"Bemar weyob sogmarbalid: ‘Moli-gwae-gwae-abarmakedgi anmar wakinmaloe.’","poem":1},{"text":"Degi-inigwele, dule-be-baleginmaloedi, beba bur bule abarmake gumaloed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dule-gwensak-bemar-oburgwebied-asabinni, bemar-milibalidi (1,000), dobedba duurmakdemaloed.","poem":1},{"text":"Dule-e-ataled-bemar-oburgwebied-asabinni, bela bemar, dobedba duurmakdemaloed.","poem":2},{"text":"Igi yar-birgi suarbi ganna-gwisdae,","poem":1},{"text":"deyobi be gumaloed.","poem":2},{"text":"Igi-yar-mullugi ibmar-wilub gwisdae,","poem":1},{"text":"deyobi bemar napi-bemaloed.","poem":2},{"lineBreak":true},{"text":"Deyobi bela neg-olloo nadoed.”","poem":2}]},{"type":"heading","content":["Bab-Dummad Israel-dulemarga wiledaked-igar mesisad"]},{"type":"verse","number":18,"content":["Isaías sogdebalid:",{"text":"“Degi-inigwele, Bab-Jehová, wile-bemar-dakegala, bemar-abitomaid.","poem":1},{"text":"Bemarga e-sabgued-nikadi, oyobied.","poem":2},{"text":"Ar Bab-Dummad-Jehová, igar-innikigwad imakedid.","poem":1},{"text":"Dule-Bab-Dummadgi-bensuli-gudimaladgi, nued binsalesad.”","poem":2}]},{"type":"verse","number":19,"content":["Sión-dulemar Jerusalén-neggweburgi-mamaid, bipisaale, bar be boosurmalad. Bab-Dummad be-bendakega ese binnasuli be gornanaile, Bab-Dummad-dule-wiledakedi, wile be-dakoed. Be-itosayalabali, be-abinsaoed."]},{"type":"verse","number":20,"content":["Ar Bab-Jehová igar-bulegan bemarga barmidago-inigwele, degi, wile-itoged-ibagan bemarga barmidago-inigwele, be-odurdaked-saila bar bemargi dukuosulid, bemar-sunnagwad be dakmaloed."]},{"type":"verse","number":21,"content":["Ar be igar-noar aibatedibele, be-yarganbali dule bese-gole be itogoed, weyob bega soge be itogoed: “Noar be aibatemala, wesik igar-mai. Wesik be namala.”"]},{"type":"verse","number":22,"content":["Degisoggu, be-ibmar-sobarmalad-bab-dummadyob-imaklemalad-manibiidi, be-ibmar-wilubgan-orbimaladi, bela ibmar-isedyob be metemaloed. Be sogdemaloed: “Wegi-bukwad be nae.”"]},{"type":"verse","number":23,"content":["Degisoggu, be ibmar-gwag digele, Bab-Jehová bemarga dii barmidagoed. Ibmar sanmakdagogu, nue-sanmakoed, degi, yeer-gullemaladbi guoed. A-ibagangine, be moli-bebe-nikamalad nainu-dummagangine, gagan-madii gudoed."]},{"type":"verse","number":24,"content":["Moli-bebe-nikad-alugwasuarmalad, degi, moli-uayasuigan be-nainugi-arbamaladi, gagan-nuegan bato egwaar-guagwar-bukwad-madii gumaloed."]},{"type":"verse","number":25,"content":["Bab-Dummad be-isdarmalad-obeloged-ibagine, e-neg-suigan ayaridele, yala-matusurmaladbali, degi, bela yala-mulluganbali dianmar megidoed, diimar iirmakdoed."]},{"type":"verse","number":26,"content":["A-ibagangine, Bab-Jehová bemar-nailikgusmalad bemarga nudakoed, ar bemar e-dulaga gumalad. Nii-gaedi, dad-ibeler-gaeyob mee gadoed, degi, dad-ibeler-e-gaedi, ilagugle-wilub bur bule mee-gaeyob (7) gadoed. Dad-ibeler-gwagugle-mee-ganaiyob (7) dad-ibeler gaoed."]},{"type":"heading","content":["Bab-Jehová Asiria-dulemargi gwichigusad"]},{"type":"verse","number":27,"content":["Isaías sogdebalid:",{"text":"“Be dakmar, Bab-Jehová-sunnagwad bannaba-dikasuli danikid.","poem":1},{"text":"E-urwedi, soo-gwabunye-gwichidyobi, waa-bupurmakgwichiyob danikid.","poem":2},{"lineBreak":true},{"text":"E-gaya, degi, e-gwabin-duku, soo-ginnitibi-gwichiyobi dakleged.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Bab-Dummad-e-ibmar-sogedi, diwar-nollosur-uurmakmaid-neg-odogeyob gued.","poem":1},{"text":"Bab-Dummadi, dulemar-yar-baid-baidgi-bukmalad-oros-omukueyobi-imakega danikid,","poem":2},{"lineBreak":true},{"text":"adi, bela obelogega danikid.","poem":2},{"text":"Moli-gaya-bargaed-yoiyobi dulemar imaksad,","poem":1},{"text":"adi, igar-baidsig sedegar, adi, yoggumalagar.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ar bemardi, Islidikid-Iba-onolegedgi-namaklegedyob namakdemaloed,","poem":1},{"text":"gwage-ulubgi, be weligwar-itodmaloed.","poem":2},{"text":"Igi dule, Bab-Jehová-yalase-nadapile, Bab-Jehová-Israelʼga-akwasailayobi-guedse-nadapile,","poem":1},{"text":"gar-gammu ogornadapdae, deyobi bemar itomaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"”Bab-Jehová, e-gayaburba-gandikid-itomalaga dulemar-imakoed.","poem":1},{"text":"Bemarga e-gangued weyob oyogoed:","poem":2},{"text":"Soo-ginnitibi gwichigudoed,","poem":1},{"text":"malamar aidedoed,","poem":2},{"text":"diimar suamakdoed,","poem":1},{"text":"dii-gwamakarmaladi babatidagoed.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Bab-Jehová e-gayaburbaba, Asiria-yala obelogoed.","poem":1},{"text":"E-ganguedba obelogoed.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Bab-Jehová we-dulemar-sabsur-odurdaked-ilibali, gar-panderoʼmar gotoed,","poem":1},{"text":"degi, gar-arpaʼmar gotoed.","poem":2},{"text":"Bab-Jehová Asiria-dulemarbo-urwenaile,","poem":1},{"text":"e-sakwa minaidbioed.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ar Bab-Jehová, Asiria-dulemarga, degi, e-reyga, sabsur-odurdakleged-neg bato dikasurgus guagwar sisad.","poem":1},{"text":"Yaa-dummad-matusulid-yabali soo-duurmaked sobsad,","poem":2},{"text":"degi, sapanmar-ichesuli urbisad.","poem":1},{"text":"Bab-Jehová soogi buu imakdogu, soo-azufre-gwabunye-gwichiyobi, gadoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}