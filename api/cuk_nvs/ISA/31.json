{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":31,"content":[{"type":"heading","content":["Egipto-dulemargi-bensurmaladi, duledar-wiles"]},{"type":"verse","number":1,"content":["Isaías weyob sogded:",{"text":"“Egipto-dulemarse-bendakleged-amibukmaladi, ¡duledar-wilesmar!","poem":1},{"text":"Egipto-molimargi-bensurmaladi, degi, e-moli-ur-bila-onomalad-bukidar-nikadgi-bensurmaladi, ¡duledar-wilesmar!","poem":2},{"text":"E-sorda-bila-onomalad-ganguedgi bensurmaladi, ¡duledar-wilesmar!","poem":1},{"text":"Ar Israel-dulemar-e-Bab-Dummad-Isligwaleddi baisur-dakmalad,","poem":2},{"lineBreak":true},{"text":"ar Bab-Jehová-amiedgindi gwen binsasurmalad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Degi-inigwele, dule Bab-Dummad yamogosulid,","poem":1},{"text":"ar ade, dule-binsaed-ibed maid.","poem":2},{"text":"Boni-dummagan barmidagoed,","poem":1},{"text":"ar ibmar-sogsale, sogedba imakedsedaed.","poem":2},{"text":"Bab-Dummadi, dule-isganamar-e-neguyagi gwichiguoed,","poem":1},{"text":"dule-ibmar-isgana-imakmalad-bendakdamaladgi gwichiguoed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ar Egipto-dulemardi, unnila dule gumalad, Bab-Dummadsurmalad.","poem":1},{"text":"E-molimala, sanakwaa gumalad, burbarsurmalad.","poem":2},{"text":"Ar Bab-Jehová, e-ganguedba dulemar-sabsur-odurdakdele,","poem":1},{"text":"dule-isgana-bendakmalad-obelogoed,","poem":2},{"text":"ese-bendaklesmarmogad-obelobaloed,","poem":1},{"text":"bela ebobela bergumaloed.”","poem":2}]},{"type":"verse","number":4,"content":["Bab-Jehová weyob anga sogsad:",{"text":"“Igi achumigur-nono-wawaad sibad-wawaad-gasa-uurmaknaile,","poem":1},{"text":"dule-sibad-edarbemalad ese urwed itodasuli,","poem":2},{"text":"degi, igi-achumigur-nono-wawaad-senigwad mas-gasa-uurmaknaile,","poem":1},{"text":"dulemar ogwayenaile, gwen dobdasuli,","poem":2},{"text":"deyobi, ani an-Bela-Gangued-Nikadi, Sión-yalabina-urwega,","poem":1},{"text":"e-yar-mulluganbina-urwega, an aidenonikoed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Igi-nuumar e-mimmigan uugi-bukwale, edarbesidae,","poem":1},{"text":"deyobi, ani Bab-Jehová-Bela-Gangued-Nikadi, Jerusalén-dulemar-edarbemogoed,","poem":2},{"text":"dule-isganamargi ollorsaoed,","poem":1},{"text":"e-ular gwisguoed, bendakoed.”","poem":2}]},{"type":"verse","number":6,"content":["Israel-dulemar, ar doagi bemar dummad-nosmala, ase be gannar namarsun."]},{"type":"verse","number":7,"content":["A-ibagangine, bemar war-wargwen, bab-dummadyob-imaklemalad-manigi-sobaled, degine, orbi-sobaled, be metemaloed. Bab-Dummadgi-yolediidba bemar-sunnagwad be sobsagusmalad."]},{"type":"verse","number":8,"content":["Bab-Jehová weyob soged:",{"text":"“A-ibagine, Asiria-dulemar es-suidgi burgwemaloed,","poem":1},{"text":"degi-inigwele, dulemar imakosulid.","poem":2},{"text":"Es-suidgi-wakinnegala, duurmakdemaloed.","poem":1},{"text":"E-sapingan-bila-onomaladdi, maiga imaklemaloed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"E-rey bela-belad nue-dobe itodoed,","poem":1},{"text":"e-dummagana e-bander-ies wakitemaloed.”","poem":2},{"text":"Bato guagwar Sión-yalagi Bab-Jehová-e-soo gasiid,","poem":1},{"text":"Jerusalén-neggweburgi soo-yaa-matusulid bato dule-isdarmalad-idu guagwar siid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/30.json","previousChapterAudioLinks":{},"numberOfVerses":9}