{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":32,"content":[{"type":"heading","content":["Rey-innikigwad yar-seoed"]},{"type":"verse","number":1,"content":[{"text":"Be dakmar. Rey-wargwen innikigwadba yar-seoed,","poem":1},{"text":"degi, dummagan-neggwebur-semaladi, napiragwadba negsemaloed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dummagan-neggwebur-semaladi, burwa-irwa dulemar-odukueyobi, dulemarga gumaloed.","poem":1},{"text":"Burwa-dummagan-noed-irwa dulemar-odukueyobi, ega gumaloed.","poem":2},{"text":"Neg-dinnagwadba dian-maidaeyobi, ega gumaloed.","poem":1},{"text":"Nega-dulesulidganba akwa-dummad-negsichi-imaksidaeyobi, ega gumaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bela-belad nue-nakuledii gumaloed,","poem":1},{"text":"nue-bogimakar dulemar-sunmaked-itodii gumaloed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nue-itoakwaa ibmar-imake gumaloed.","poem":1},{"text":"Nuekwa-sunmake, magar-nue-neg-itoge gumaloed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dulemala, dule-binsaedsulidaed dule-nuga-nikadye bar biosurmalad.","poem":1},{"text":"Gadi-dule-yamogedi, sae-dakledoed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ar dule-binsaedsulidaedi, binsaedsuli sunmaked, yogasaar sunmaked.","poem":1},{"text":"Igar-isganaginbi binsadidaed,","poem":2},{"lineBreak":true},{"text":"igar-isganabi imakdidaed.","poem":2},{"text":"Bab-Jehováʼgi gakansaar sunmakdidaed.","poem":1},{"text":"Dule-masgunbigudiid ogunbidasulid,","poem":2},{"lineBreak":true},{"text":"dule-ukudmaada-itodiid ogobbidasulid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gadi-dule-yamogedi, dule-yamogedgi alamakdidaed,","poem":1},{"text":"igar-isgana-imakedgi alamakdidaed,","poem":2},{"text":"e-gakansaedgi dule-wilemalad-wiodidaed.","poem":1},{"text":"Dule-gakansaedi, dule-ibmarbina-sogdiid ega igar-naboye-gordidamaladga, gakansadidaed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ar dule-nuga-nikaddi, degisulid.","poem":1},{"text":"Igar-nueganbi imakdidaed,","poem":2},{"lineBreak":true},{"text":"e-igar-nuegan-imakedba e-nug dunguoed.","poem":2}]},{"type":"heading","content":["Jerusalén-omeganga iduakwaa ibmar soglesad"]},{"type":"verse","number":9,"content":[{"text":"Omegan-gwen-bai-itosurmalad, ¡be nue an-itomar!","poem":1},{"text":"Bunamala-gwen-bai-binsadisurmalad, an bemarga-ibmar-sogoedi nue bogimakar be an-itomalo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Emide, bemar bela nueganbi-bukwa daklemalad,","poem":1},{"text":"birgagwensega bemar, dobedba-wawanmakdemaloed.","poem":2},{"text":"Ar ade, uva-sanmar bar welegosulid,","poem":1},{"text":"ibmar-gwagmar bar welegosulid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Omegan-gwen-bai-itosurmalad, ¡be nue dobee itomarsun!","poem":1},{"text":"Bemar-baisur-itodimalad, ¡dobedba be wawanmakmarsun!","poem":2},{"text":"We-mor be yoimalad esumarsun,","poem":1},{"text":"wile-itoged-mor be yomarsun.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nainu-yeerdaklege-naidga, degi, uva-nainu-nuegan-naidga,","poem":1},{"text":"be bukib-itogedba binasgar be bibyomarsun.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Degine, an-dulamar-e-yar ikomar-yaisulidga gudoed,","poem":1},{"text":"gagan-ikobimalad-yaisulidga gudoed.","poem":2},{"text":"Deginbali, bela neg-yagi weligwar-gudimaladga,","poem":1},{"text":"neggweburgi ibabi-dakdimaladga be wile-itomarsun.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ar reynegmar olloo melledoed,","poem":1},{"text":"dulemar-neggwebur bela olloo sigoed.","poem":2},{"text":"Reyneg, degi, neg-gandikmalad, akwa-dummagan-ollogan-bukwayobi degisadegu bukuoed.","poem":1},{"text":"Sapur-moli-uayasuid-obunnoged-negga guoed,","poem":2},{"lineBreak":true},{"text":"sibadmar-mas-maed-negga guoed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Geb Bab-Dummad-Burba anmargi aidenonikoed,","poem":1},{"text":"nega-dulesulidi, napa-nuedga gudoed,","poem":2},{"lineBreak":true},{"text":"napa-nuedi, nainu-nued-daklege nadoed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Degisoggu, bela neggweburmar-ilibali,","poem":1},{"text":"igar-napiramalad, degi, igar-innikimalad oyolemai guoed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Igar-napiragwadi, bega gwage-bogidikid ukoed.","poem":1},{"text":"Baisur-itoge be-imakoed,","poem":2},{"lineBreak":true},{"text":"degisadegu dobsuli-nanadii be-imakoed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"An-dulamar neg-bogidikidgi-gudii gumaloed,","poem":1},{"text":"nega-nuedgi-mamai gumaloed,","poem":2},{"lineBreak":true},{"text":"neg-boo-itolegedgi-obunnomamai gumaloed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ar amba sapurdi egi dii-gwamakaled babatidoed-inigwele,","poem":1},{"text":"bela neggwebur ibitogoed-inigwele, bemargindi nued binsalemarsun.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bemar, dii-gakanaba-ibmar-digmaladi, moli-bebe-nikad-alugwasualed-esikar-imakdimaladi,","poem":1},{"text":"degi, moli-uayasuid-esikar-imakdimaladi, bemargindi nued binsalemarsun.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/31.json","previousChapterAudioLinks":{},"numberOfVerses":20}