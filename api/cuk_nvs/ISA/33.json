{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":33,"content":[{"type":"heading","content":["Bab-Jehováʼgi abonoleged danikid"]},{"type":"verse","number":1,"content":[{"text":"Asiria-dulemar-dule-wiodimalad, gwen be wioledisulidi, ¡be duledar-wilesmar!","poem":1},{"text":"Asiria-dulemar-dule-yamodimaladi, gwen be yamoledisulidi, ¡be dule-wilesmar!","poem":2},{"text":"Be dulemar-obelosale, be bergumarmogoed.","poem":1},{"text":"Be dulemar-yamosale, be yamolemarmogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bab-Jehováʼye, wile be anmar-dake.","poem":1},{"text":"Ar anmar begi bendakleged edarbediid.","poem":2},{"text":"Bane-bane wakudaryalabali, anmarga be niga-ogannoged.","poem":1},{"text":"Suli-suli-itoged-ibagine, anmar-abonogega be gued.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Be-gayaburba mala-goledyob-goledbali,","poem":1},{"text":"dulemar gwakiar duurmakdedamalad.","poem":2},{"text":"Be-gangued be oyodele,","poem":1},{"text":"dulemar-yar-baid-baidgi-bukmalad aisakiddamalad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"We-dulemar-e-ibmar-nikadgi, e-isdarmalad ses-burwigana-bateyobi egi nonimaloed.","poem":1},{"text":"E-ibe bela ibmar-nuegan sunonimaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová-e-nug odummolegoed,","poem":1},{"text":"ar nibneggi negdakmaid.","poem":2},{"text":"Bab-Jehová, igar-innikigwad-imakega Sión-yala-imakmaid,","poem":1},{"text":"emarga-ibmar-nabir-guega imakmaid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Dummadi, dobsuli-gudiguega anmar-imaked.","poem":1},{"text":"E-binsaed-nikadaed, degi, bela e-ibmar-wisid,","poem":2},{"text":"bela-bela bendakleged anmarga uksad.","poem":1},{"text":"Bab-Jehová-dobee-nanaedi, anmarga ibmar-nuedga gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Be nue dule-gandikmalad-gordidiid itomar,","poem":1},{"text":"ibiyobi neg-galimbaba binnasuli oimakdemala.","poem":2},{"text":"Neg-bogidik-saedgi-sunmakdimaladi,","poem":1},{"text":"bela-belad ogormakdemalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dulemar bar igarba daklesulid, igar-ollo maid,","poem":1},{"text":"dulemar bar igarba iirmaksulid.","poem":2},{"text":"Na-ebo-igar-mesismaladi bichismalad.","poem":1},{"text":"Dulemar, dule-we-igar-maid-wismalad isdar dakdemalad.","poem":2},{"lineBreak":true},{"text":"Dulemargi bar binsaed-nika dasurmalad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bela dulemar bukib-binsaedbimalad,","poem":1},{"text":"Líbano-yala bela dinguded, e-dakleged bela yogguded.","poem":2},{"text":"Sarón-neba bela nega-dulesulidga naded.","poem":1},{"text":"Basán-yala, degi, Carmelo-yala, e-yeer-ara-ara-dakleged yogguded.","poem":2}]},{"type":"verse","number":10,"content":["Bab-Jehová weyob soged:",{"text":"“Emisgindi, an ibmar imakgwersunno.","poem":1},{"text":"Emisgindi, an-nug odummolesunnoed,","poem":2},{"lineBreak":true},{"text":"emisgindi, an-nug ogannolesunnoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Asiria-dulemar igar-amimaladi, unnila e-igarmar binsaledga gued,","poem":1},{"text":"igarmar-isganaga gued.","poem":2},{"lineBreak":true},{"text":"Ar an buu imakdogua, bergudoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"E-sorda-bila-onomaladi, ikomar-sooyagi-gummaknaidyobi, gumaloed.","poem":1},{"text":"Bela burubi gumaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”Bemar, dikasuli-bukwamalad, an ibmar-imaksad, be nue itomar.","poem":1},{"text":"Bemar, itaka-bukmalad, an-gangued be dakmar.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dule-isgumalad Sión-yalagi dobe itobukmalad.","poem":1},{"text":"Dule-isganamar dobedba wawanmakbukmalad.","poem":2},{"text":"Weyob sogbukwamalad: ‘¿Doa-anmar, soo-dule-obeloged-nagaba megoe?","poem":1},{"text":"¿Doa-anmar, soo-dummad-gege-bergued-duurmaksiid-nagaba megoe?’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Unnila dule-igar-innikigwadba-nanadiidbi, degi, napiragwadba-sunmakdiidbi, nibneggi mai guoed.","poem":1},{"text":"Dule ibmar-isganagi-mani-onodisulidbi, dule emarse-manigi-bakledisulidbi, nibneggi mai guoed.","poem":2},{"text":"Dule emar-gindakmaladba ibsadisulidbi, ibmar-isgana-imakleged dakbidasulidbi,","poem":1}]},{"type":"verse","number":16,"content":[{"text":"dule-weyob-daedi, nibneggi mai guoed.","poem":2},{"text":"Akwasaila-gandikmalad e-dukued-negga guoed,","poem":1},{"text":"masgullemalad ega uklegoed,","poem":2},{"lineBreak":true},{"text":"gobed ega gwen surguosulid.”","poem":2}]},{"type":"verse","number":17,"content":["Isaías, Israel-dulemarga sogdebalid:",{"text":"“Bemar-sunnagwad, rey-e-gangued-yeerdaklegoed be dakmaloed,","poem":1},{"text":"bemar-yala dungumai be dakmarbaloed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bemar dobee-itosadgi-binsadmardibe, na be sogdemaloed:","poem":1},{"text":"‘¿Bia wede mani-ebisged nade?","poem":2},{"text":"¿Bia wede mani-daked nade?","poem":1},{"text":"¿Bia wede nakuleged-neg-matusurmalad-dakdiid nade?’","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bar be we-dulemar-isgana dakosurmalad.","poem":1},{"text":"We-dulemar, e-gwabinduku-aku-itolemaladid,","poem":2},{"text":"e-sunmakedi, magar-itolesurmaladid,","poem":1},{"text":"ber oburagwar sunmakmaladid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"”Sión-yala be dakmar,","poem":1},{"text":"ar a, anmar-ibamar-onoged-neggweburad.","poem":2},{"text":"Bemar-sunnagwad Jerusalén-neggwebur be dakmaloed.","poem":1},{"text":"A-neggwebur, bogi-meged-negad, nuesaale sobar siid.","poem":2},{"text":"Bipisaale e-abgamalad-suar ungosulid,","poem":1},{"text":"e-abgamalad-dubmar itirosurbalid.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Jerusalénʼgi, Bab-Jehová anmarga e-gangued oyogoed.","poem":1},{"text":"Diwar-dummagan-maiyob, degi, diimar-iirmakmaiyob guoed.","poem":2},{"text":"Ar a-diwargine, ur-gammi-nikamalad iirmakosulid,","poem":1},{"text":"degine, ur-gandikmalad egine iirmakosulid.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ar ade, Bab-Jehová, anmar-idugedid.","poem":1},{"text":"Ar Bab-Jehová, anmarga dummadga negdakmaidid.","poem":2},{"text":"Ar Bab-Jehová, anmar-e-reyd.","poem":1},{"text":"¡E na anmar-abonogoedid!","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"”Asiria-ulumar-e-dub nollomakded.","poem":1},{"text":"E-urmor-buar geg-nue-gwisgue egemakwichid,","poem":2},{"text":"degine, e-urmormar geg argaed.","poem":1},{"text":"E-isdarmaladi, degi, dule-muya-muyamaladse-bakale, ei ibmar atursamaloed.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ar Bab-Dummad bela dulemar-Siónʼgi-mamaid-e-isgued osulogoed,","poem":1},{"text":"degine, bipisaale dule-gwensak sogosulid: ‘An uelleye.’ ”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/32.json","previousChapterAudioLinks":{},"numberOfVerses":24}