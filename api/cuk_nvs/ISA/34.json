{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":34,"content":[{"type":"heading","content":["Dulemar-yar-baid-baidgi-bukmalad sabsur-odurdaklegoed"]},{"type":"verse","number":1,"content":[{"text":"Dulemar-yar-baid-baidgi-bukmalad, gayaburba-itogega wese be walikgudamar.","poem":1},{"text":"Dulamar, nue-bogimakar be itomar.","poem":2},{"text":"Napneg-naid, nue itogo.","poem":1},{"text":"Bela-egi-ibmar-bukwamalad, nue-itomarmogo.","poem":2},{"text":"Napneg-bipirmaknaidgi-bukmalad, bela itomogo.","poem":1},{"text":"Bela-napneggi-ibmar-sanmakedi, nue-itomarmogo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová, dulemar-yar-baid-baidgi-bukmaladse bela urwemaid.","poem":1},{"text":"Amar-sorda-bila-onomaladse bela urwemaid.","poem":2},{"text":"Bab-Dummad, bela bemar-obeloged sogmaid,","poem":1},{"text":"bela bemar-ogiloged sogmaid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dule-girgumaloedi, bela omiledoed,","poem":1},{"text":"e-muimar nunusaila yapatoed,","poem":2},{"lineBreak":true},{"text":"e-ablismar yalaganba suurmakdoed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Niismar-mogir-imbaba-nanaid bar daklegosulid,","poem":1},{"text":"bela mogir atudoed.","poem":2},{"text":"Igi garda obipirmakledae, mogir deyob guoed.","poem":1},{"text":"Bela niismar-e-dakarmakmalad berguoed.","poem":2},{"text":"Uva-sapi-gagan-dinguddaedyobi, dakle naoed.","poem":1},{"text":"Higuera-sapigi e-san-dingusnai-daedyobi, dakle naoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová weyob sogye:","poem":1},{"text":"“Bato mogir-imbaba, an-es-suid guagwar naid.","poem":2},{"text":"Be dakmalana, Edom-dulemargi es-suid igi-gwichigudani be dake,","poem":1},{"text":"ar an we-dulemar bela ogilogoye sogsad.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bab-Jehová-e-es-suid bela ablisbi naid,","poem":1},{"text":"sibad-omemar-ablisgi obagwar naid,","poem":2},{"text":"sibad-wawaad-senigana-ablisgi obagwar naid.","poem":1},{"text":"Bela e-es-suidgi e-gwallu darwagwar magaled.","poem":2},{"text":"Sibad-wawaad-machered-mirwa-gwallugi darwagwar magaled.","poem":1},{"text":"Ar Bab-Jehová, Edom-yargi Bosra-neggweburgi ibmar-durgan oburgwenaid.","poem":2},{"lineBreak":true},{"text":"Edom-yalagi ibmar-durgan yeer ogilonaid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Moli-bebe-nikad-ursirmalad egi gwichigudmaloed.","poem":1},{"text":"Moli-bebe-nikad-sapingana, degi, moli-bebe-nikad-machergan egi gwichigudmaloed.","poem":2},{"text":"Edom-yalagi ablisbi bipirmaknai guoed,","poem":1},{"text":"e-napagi, e-gwallumarbi neg-ganai guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ar ade, Bab-Jehováʼga buged-imaked-iba gued,","poem":1},{"text":"buged-saed-birga gued, adi, Sión-yala bendaklegegar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Edom-yar-e-dianmala baryaga binnidoed,","poem":1},{"text":"e-ukub, azufreʼyob uediki naguoed,","poem":2},{"lineBreak":true},{"text":"barya-uedikidyobi diopisuli napa naguoed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bane-bane barya uediki-ganaidbi guoed, gwen akinnosulid,","poem":1},{"text":"e-waa bupurmagwichidbi guoed.","poem":2},{"text":"E-yala degisadegu ollobi-nai guoed,","poem":1},{"text":"bipisaale, bar dulemar egi iirmakosurmalad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Noomargii-daklemalad egi neg-egwannoed,","poem":1},{"text":"akwanuku-negga gudoed.","poem":2},{"text":"Egine, irmonmar e-uu sobdoed,","poem":1},{"text":"degi, sikwisichimar e-uu urbidoed.","poem":2},{"text":"Bab-Dummadi we-yala bela gagaoed,","poem":1},{"text":"degi, walagwen-ollobi-selenai imakoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dule-nuga-nikamalad-sate guoed, yalaye bar bilegosulid.","poem":1},{"text":"Bela dule-gandikmalad bar daklegosulid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"E-reynegmargine ikomarbi bipirmakdoed,","poem":1},{"text":"e-neg-gandikmaladgi dakemar-sunnabi bipirmakdoed,","poem":2},{"lineBreak":true},{"text":"degi, gagan-iko-ikomaladbi engudoed.","poem":2},{"text":"Achu-sapur-uaya-gannagana-e-negga gudoed,","poem":1},{"text":"nuu-dummad-malisuigan-megega gudoed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nega-dulesulidganba ibmar-durgan-ursilimalad-bukwadi, achu-sapurmarbo atodoed.","poem":1},{"text":"Sibad-sapurmar, e-sordaganse gotemaloed.","poem":2},{"text":"Irmon agi ambikumarmogoed,","poem":1},{"text":"a-neggine signonimaloed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"A-neggine, irmonmar e-uu soboed,","poem":1},{"text":"degi, e-akwamar urbidoed.","poem":2},{"text":"E-sakan-urbali, nuekwa e-akwamar urboed,","poem":1},{"text":"nuekwa e-mimmigan akoed.","poem":2},{"text":"Agine, mulamar ambikumogoed,","poem":1},{"text":"abirgunar-abirgunar ambikumogoed.","poem":2}]},{"type":"verse","number":16,"content":["Bab-Jehová-gardase be idako, agi be nue-absogo:",{"text":"“Bipisaale we-ibmar-durgan gwen beosulid,","poem":1},{"text":"abirgin-abirgin egad-egad nikamaloed.","poem":2},{"text":"Ar Bab-Jehová-sunnagwad igar weyob uksad,","poem":1},{"text":"Bab-Dummad-Burba weyob oambikusad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ar Bab-Dummad ega negmar amisad, ega yala uksad.","poem":1},{"text":"Degisadegu, wemar we-yalagi bukwa gumaloed,","poem":2},{"lineBreak":true},{"text":"degisadegu, egi gudii gumaloed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":17}