{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":35,"content":[{"type":"heading","content":["Dule-bendaklesmalad weligwar itosmalad"]},{"type":"verse","number":1,"content":[{"text":"Nega-dulesulid weligwale itodoed,","poem":1},{"text":"napa-dinnagwad weligwale itodoed,","poem":2},{"text":"nega-dulesulidgi gagan ainidoed,","poem":1},{"text":"dutu-achunnedyob dakledoed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bela nega-dulesulid weligwar itodoed.","poem":1},{"text":"Ar Bab-Dummadi nega-dulesulidga Líbano-yalayobi neg-dakle imakoed.","poem":2},{"text":"Degi, igi Carmelo-yala daklege, deyobi, neg-dakle ega imakoed.","poem":1},{"text":"Igi Sarón-neba yeerdaklege, deyobi, neg-dakle ega nasikoed.","poem":2},{"text":"Ar Bab-Jehová-e-gangued-yeerdakleged dakmaloed.","poem":1},{"text":"Anmar-Bab-Dummad-e-gangued bela dakmaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dule-argan-nollo-itomalad, be ogannomarsun.","poem":1},{"text":"Yokor-wanwanmalad, be ogannomarsun.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dule-dobeganaga weyob be sogmar:","poem":1},{"lineBreak":true},{"text":"“Gandik be samala, melle be dobgumar.","poem":1},{"text":"Be-Bab-Dummad danikoed,","poem":2},{"text":"bemarga buged-imakega danikoed.","poem":1},{"text":"Bab-Dummad-sunnagwad bemar-bendaknonikoed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Geb degine, dulemar-aku-atakmalad magar atakdemaloed,","poem":1},{"text":"dule-uaya-yallirmalad magar dule-itoge gumaloed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Geb deginbali, dule-muya-muyamalad, goe-sapuryob ichomake gumaloed.","poem":1},{"text":"Dule-geg-sunmakmalad, weligwaledba binnasuli gotemaloed.","poem":2},{"text":"Ar nega-dulesulidganba diimar suurmakdoed,","poem":1},{"text":"nega-dinnaganba diimar aryodagoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Napa-dinnagana dii egi sigega an imakoed.","poem":1},{"text":"Neg-dinnagana-naigusadgi, ibe makumakar aryogwichioed.","poem":2},{"text":"Achu-sapur-uaya-gannagan e-negga-gusadgi, nargammugi-daklemaladbi guoed,","poem":1},{"text":"degi, naiwargi-daklemalad-negga guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Agine, igar-dummadsaar mai guoed.","poem":1},{"text":"A-igar, Igar-Islidikidye bilegoed.","poem":2},{"text":"Dule-isgudimalad egi gwen nanaosulid.","poem":1},{"text":"Dulemar-uaya-satedamalad egi gwen iirmakosurmogad.","poem":2},{"text":"Unnila dulemar we-Igarbarbi-nanadimaladbi egi nanamaloed.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bipisaale, agi achumigur-nono-wawaad gwen nika-guosulid,","poem":1},{"text":"ibmar-durgan-dulegi-aibined ese gwen nonikosurmogad.","poem":2},{"text":"Ibmar-degimalad gwen daklegosulid,","poem":1},{"text":"unnila dulemar-bendaklesmaladbi iirmakmai guoed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Jehováʼgi dulemar-bendaklesmaladbi, gannar Sión-yalase yeer-itogedgi dognonimaloed.","poem":1},{"text":"Weligwale itodmaloed, yeer itodmaloed.","poem":2},{"text":"Bukib-binsaedi egi yoggudoed,","poem":1},{"text":"wiles-itogedi egi yoggudbaloed.","poem":2},{"lineBreak":true},{"text":"Bela weligwaledbi itodmaloed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}