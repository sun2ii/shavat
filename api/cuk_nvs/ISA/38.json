{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":38,"content":[{"type":"heading","content":["Ezequías-boni-nikad"]},{"type":"verse","number":1,"content":["A-ibagangine, Ezequías bela-bela nailikgumai burgwednaga gusad. Geb Bab-Dummad-gayaburba-barsoged-Isaías Amoz-e-machi, Ezequías-dakega ese nade gusad. Degi, ega sogdapid: “Bab-Jehová weyob soged: ‘Be bar-gwisguosurye, be burgoye. Degisoggu, be-neg-yaginmaladga igargan napi-nue be ukoye.’ ”"]},{"type":"verse","number":2,"content":["Geb degine, Ezequías, galusik aibilisa imaksad. Weyob, Bab-Jehováʼse isedar-gollar imaksad:"]},{"type":"verse","number":3,"content":["“Bab-Jehováʼye, be an-ebinsao. Andi be-sogedba bega arbasad. Napiragwadba an beba nanasad. Be-ibmar-abegedba andi bega ibmar imaksad.” Degi Ezequías bela-belad isedar-boale meremai gusad."]},{"type":"verse","number":4,"content":["Geb degine, Isaíasʼse Bab-Jehová-gayaburba nonikid, ega weyob sognonikid:"]},{"type":"verse","number":5,"content":["“Ezequíasʼse be nae, ega be sogo: ‘Bab-Jehová, be-dad-dummad-David-e-Bab-Dummad weyob sogye: Anse be gochadi, bela an be-itosye, be-ibyanis-aryosadi an daksabarye. Degiirdi, birgambe-gakatar (15) napi-gudii-guega an be-imakoye."]},{"type":"verse","number":6,"content":["Asiria-e-reygi an be-ollorsaoed, we-Asiria-neggwebur-e-reygi an be-bendakoed. Ani an, we-neggwebur-irwa gwisguoed.’ ”"]},{"type":"verse","number":7,"content":["Geb Isaías, Ezequíasʼga sogded: “Bab-Jehová-bega-ibmar-sogsad mag be dakegala, we-ibmar-wilub Bab-Jehová bega oyogoed:"]},{"type":"verse","number":8,"content":["Acaz-wachi an gannar sorsik wachi-irgwen-wilub osikirmakoed.” Geb agine, dad-ibeler-naidi gannar wachi-irgwen-wilub sorsik sikirmaksad."]},{"type":"heading","content":["Ezequías-ibmar-narmaksad"]},{"type":"verse","number":9,"content":["Judá-e-rey-Ezequías, nailikgumaigusad-sorbali, gwisgusgua, weyob garda narmaksad:"]},{"type":"verse","number":10,"content":[{"text":"“An weyob sogmai gusad: ‘¿An nabir-gudiid-ibagangi nue-an-burgwesunnode?","poem":1},{"text":"¿Burgwed-galuse an megnaedgadsunde?","poem":2},{"lineBreak":true},{"text":"¿Bar an wegi daklegosuli gusunnode?’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"An sogsabalid: ‘We-napneggi bar an Bab-Jehová-dakosulid.","poem":1},{"lineBreak":true},{"text":"We-napneggi-dulemar-bukwad bar an dakosurbalid.’","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"An-annik an-neg susmalad,","poem":1},{"text":"urwedigi an-annik susmalad.","poem":2},{"text":"Sibad-wawaad-edarbed-e-dordoneg-obipirmaklegeyobi an-neg imaksamalad.","poem":1},{"text":"Dule-mormaked, mor-maknaiyobi be an-san imaksad.","poem":2},{"text":"Emide, Bab-Dummad, mor-maknaid-bergusadgi-e-dikarmar-sike-sike-imaklegeyobi an-imaksad.","poem":1},{"text":"An-ibagan baisursunna be obelononikid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ogormaksii an neg-oiboalid.","poem":1},{"text":"Achumigur-nono-wawaad-garmar-bibisgeyobi an-imaknonikid.","poem":2},{"lineBreak":true},{"text":"Irgwennaar be an-obelononikid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wirsob-boedyobi an bosad,","poem":1},{"text":"nuu-dabgalayob-dakleged-boedyobi an bosad,","poem":2},{"lineBreak":true},{"text":"nuu-sibu-uurmakedyobi an bosad.","poem":2},{"text":"An-ibya niba-atakedbali, yegusad.","poem":1},{"text":"Bab-Jehová an suli-suli-itogusad, be an-bendakdage.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"”Ar ¿igi bar an sogosunna?","poem":1},{"text":"Ar e-sunnagwad anga sogsad.","poem":2},{"text":"Ar deyob imaksado.","poem":1},{"text":"Ulubgi an-isdar-itogedi, bar gabbisuli an-imaksad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bab-Jehová, be-sogedbali dulemar dula gudidimalad.","poem":1},{"text":"An deyobi be-sogedba an dula-gudii gumogoed.","poem":2},{"text":"Bee be, anga san nudaksad,","poem":1},{"text":"bee be, anga burba uksad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"An suli-suli-itosad,","poem":1},{"text":"emidi, an bogidik itoged.","poem":2},{"text":"Be an-sabedbali yaa-dummad-dule-obelogedgi be an-bendaksad,","poem":1},{"text":"begi isgussuliyob be an-daksad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Neg-uan-mamaidi, gwen be-nug ogannogosulid.","poem":1},{"text":"Dule-burgwarmaladi, gwen be-nug odummosulid.","poem":2},{"text":"Dule-yaa-dummadse-batemamaidi, be-innikigwadba-daedgi gwen sunmakosurmalad.","poem":1}]},{"type":"verse","number":19,"content":[{"text":"Unnila dula-gudimaladi, be-nug-ogannoged,","poem":2},{"text":"igi an emi-ibagi be-ogannoge, deyob be-ogannomarmogad.","poem":1},{"text":"Bela babgan na e-mimmiganga be-innikidaedgi sunmakmaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"”Bab-Jehová an-abonogoed.","poem":1},{"text":"Degisoggu, anmar bane-bane Bab-Jehováʼse-goled-neggi, igar-dub-nikamaladba namakmaloed.”","poem":2}]},{"type":"verse","number":21,"content":["Geb degi, Isaías sogded:",{"text":"—Higo-san ollimakmalo,","poem":1},{"text":"geb rey-abagangi yaa-siidgi be mage-mage imakmalo.","poem":2},{"lineBreak":true},{"text":"Agine nabir nugudoed.","poem":2}]},{"type":"verse","number":22,"content":["Geb degi, Ezequías, Isaíasʼga sokalid:",{"text":"—An nabir Bab-Jehováʼse-goled-negse naknaega,","poem":1},{"text":"¿ibi-wilubgi nabir magar an daksale?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}