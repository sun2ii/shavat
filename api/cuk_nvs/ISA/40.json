{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":40,"content":[{"type":"heading","content":["Bab-Jehová, Israel-dulemarga gwage-armaked"]},{"type":"verse","number":1,"content":["Anmar-Bab-Dummad soged:",{"text":"“An-dulamar-e-gwage ogannomar,","poem":1},{"text":"baisur-ito be imakmar.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jerusalén-dulemarga nue-sabedgi be sunmakmar,","poem":1},{"text":"ega be sogmar:","poem":2},{"text":"‘Be maiga-arbadigusmalad-ibagan wese bergunoniye,","poem":1},{"text":"be-isgusmalad bato bega bennuklesye.","poem":2},{"text":"Bemar isgusad-nukad unniguar bato ilabo-wilub sabsur-odurdaklesye.","poem":1},{"text":"Bab-Jehová bemarga isgued elisye.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gayaburba binnasuli goled, weyob soged:","poem":1},{"text":"“Bab-Jehováʼga nega-dulesulidganba igar mayemar,","poem":2},{"text":"anmar-Bab-Dummadga nega-dinnaganba igar swilidik mesmar.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"Bela nebagan swilidik imakmarsun,","poem":2},{"text":"yalamar, degi, neg-mullugana omatolesun.","poem":1},{"text":"Degine, napa-muru-muru-mamaid innikii imakmarsun,","poem":2},{"lineBreak":true},{"text":"igar-bire-bire-mamaid innikii imakmarsun.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Agine geb Bab-Jehová-e-gandikid-yeerdakleged bela dulemarga oyolegoed.”","poem":1},{"text":"Ar Bab-Jehová-sunnagwad deyob sogsad.","poem":2}]},{"type":"verse","number":6,"content":["Gayaburba weyob soged:",{"text":"“Binnasuli be soge.”","poem":1},"An ega weyob soged:",{"text":"“¿Ibu an binnasuli sogosunna?”","poem":1},"Geb anga soged:",{"text":"“Bela dulemarga be soge: ‘Dulemar gaganyobi gued.","poem":1},{"text":"E-yeerdaklegedi, nainugi-dutu-achunneyobi gued.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová-e-buu-imaked egi nasale, gagan baisur-dinguddaed,","poem":1},{"text":"dutumala, baisur-dinguddamogad.","poem":2},{"lineBreak":true},{"text":"Ar dulemar gagan-ara-aramaladyobi gued.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gaganmala baisur-dinguddaed,","poem":1},{"text":"dutumala, baisur-dinguddamogad.","poem":2},{"lineBreak":true},{"text":"Ar anmar-Bab-Dummad-Gayaburbadi, degisadegu maiguad, berguosulid.’ ”","poem":2}]},{"type":"verse","number":9,"content":["Bab-Dummad sogded:",{"text":"“Sión-yalagi be nakwenae,","poem":1},{"text":"gayaburba-nuegangi be sunmaknae.","poem":2},{"text":"Yala-matusulidse be nakwenae,","poem":1},{"text":"Jerusalén-neggweburga, gayaburba-nuegangi be sunmaknae.","poem":2},{"text":"Ise-gandikidba be sunmaknae,","poem":1},{"text":"binnasuli be sunmako,","poem":2},{"lineBreak":true},{"text":"melle be dobe itogo.","poem":2},{"text":"Judá-neggweburmarga be soge: ‘Be nue-dakmar.","poem":1},{"text":"Wegi anmar-Bab-Dummad-danikid be dakmar.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Bab-Jehová-gandikidba-danikid, be dakmar.","poem":1},{"text":"Bab-Jehová e na negsemaid.","poem":2},{"text":"E-dulamar-ollor-imaksadi, ebali nidanikid.","poem":1},{"text":"Ibidar-nued-amisadi eba sedanikid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Jehová e-dulamar-bendakdanikid.","poem":1},{"text":"Igi sibad-wawaad-edarbedi, e-sibad-wawaad-mimmi nakwaa imakdae, geb e-binasgargi semaidae,","poem":2},{"text":"degi, sibad-wawaad-milesmalad nue nimaidae.","poem":1},{"text":"Deyobi, Bab-Jehová e-dulamar bendakdanikid.”","poem":2}]},{"type":"heading","content":["Dule, Israel-e-Bab-Dummadyobid sulid"]},{"type":"verse","number":12,"content":[{"text":"¿Doa dii-naid e-argangi wilubsasa?","poem":1},{"text":"¿Doa mogir-naid e-goomargi wilub-imaksa?","poem":2},{"text":"¿Doa ibmar-wilubsaedgi ukub-naid urbisa?","poem":1},{"text":"¿Doa ibmar-wilubsaedgi yar-dummagan wilubsasa?","poem":2},{"lineBreak":true},{"text":"¿Doa ibmar-wilubsaedgi yar-mullugana wilub-imaksa?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"¿Doa Bab-Jehová-E-Burba bela balamioe?","poem":1},{"text":"¿Doa ega binsaed-ukedga guoe?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"¿Ar doase Bab-Jehová ibmar-magar-itogega binsaed-amissunna?","poem":1},{"text":"¿Ar doa igar-inniki-imaked-igarba Bab-Jehová-odurdaksasunna?","poem":2},{"text":"¿Doa ega ibmar-nue-wisigued uksasunna?","poem":1},{"text":"¿Doa binsaed-nikaa-daed-igarba Bab-Jehová-odurdaksasunna?","poem":2},{"lineBreak":true},{"text":"Suli, dule bipisaale wegiid-igarba Bab-Jehová-odurdaksasulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ar dulemar-yar-baid-baidgi-bukmaladi, Bab-Jehová-asabinni unnila bormoyagi dii-gwagwen-argwachayobi gumalad.","poem":1},{"text":"Degi, ibmar-wilubsalegedgi ukub-ichesaar wilubsalegedyob gumalad.","poem":2},{"lineBreak":true},{"text":"Ar Bab-Jehová dupgan-nanaidi, ukub-buru-aidikueyobi daked.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Líbano-yargi-sapanmar-nikadi, Babga-ibmar-ogumaklegedgi-ebulegega unnisulid.","poem":1},{"text":"Líbano-e-ibmar-durgan-nikadi, Bab-Dummadga-ogumaklegega, unnisurbalid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bab-Jehová-asabinni, bela dulemar-yar-baid-baidgi-bukmaladi, ibigwensuli gumalad.","poem":1},{"text":"Egala, gwen ibmar-nuedga gusulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"¿Doa-ebo be Bab-Dummad-wilubdakoe?","poem":1},{"text":"¿Ibu-ibmar-sobaledbo be wilub-imakoe?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Dule-ibmar-sobmaladi, esgorogi ibmar-bab-dummadyob-imakleged sobmalad.","poem":1},{"text":"A-sorba, dule-or-sobedi, a-ibmar-birgi or-nasikmalad,","poem":2},{"lineBreak":true},{"text":"geb ega manidubmar sobbalid.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ar dule-wilegeddi, e-bab-dummad-sobega suar-gege-nunguedi amied.","poem":1},{"text":"A-sorbali, dule-wileged, dule-ibmar-nued-sobed amied.","poem":2},{"lineBreak":true},{"text":"Adi, ega nuekwaa suar-bab-dummadyob sobega, melle ege-ege gwisguegar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"¿Ar ade, bemar wissurmarsi?","poem":1},{"text":"¿Bemar itossurmarsi?","poem":2},{"text":"¿Bato gebesailagine bemarga soglessursi?","poem":1},{"text":"¿Napneg-nagusad-akar bemar odurdaklessurmarsi?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ar Bab-Jehováʼdi napneg-dirbir-naidbirgi negdaksiid,","poem":1},{"text":"dulemar-bukwadi sesmaryobi ega gued, bai daksulid.","poem":2},{"text":"Bab-Jehová mor-dummad-nallaa-imaklegedyobi mogir-imaked.","poem":1},{"text":"Bab-Jehová mor-neg-egalegedyobi, mogir-billi egadaed,","poem":2},{"lineBreak":true},{"text":"adi, egi megegar.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bab-Jehová, dule-gandikmalad obelodaed.","poem":1},{"text":"Dule napneggi-dummadga-negsemamaidi, ibmar-isganayobi obeloged.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"A-dummagan sapiwar-nue-diglessuliyobi gumalad,","poem":1},{"text":"ibmar-gwag-nue-diglessuliyobi gumalad,","poem":2},{"text":"sapi-saila napa-yaba e-malimar-nue-ainissulidyobi gumalad.","poem":1},{"text":"Ar Bab-Jehová egi buu-imakdele, dingudmaloed,","poem":2},{"lineBreak":true},{"text":"ar gagan-dinnaganayobi burwa-dummadba seledoed.","poem":2}]},{"type":"verse","number":25,"content":["Bab-Jehová-Isligwaled weyob soged:",{"text":"“Degite, ¿doabo bemar an-wilubdakmalosunna?","poem":1},{"text":"¿Doa anyobi-daklege gusunna?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Niba be nue atakmar,","poem":1},{"text":"¿doa bela we-ibmarmar obinnisa?","poem":2},{"text":"Bab-Jehová e na niisgwamar-onied,","poem":1},{"text":"sog-soggwen ilemaked,","poem":2},{"lineBreak":true},{"text":"e-nugbali ese goled.","poem":2},{"text":"Bab-Jehová-e-ganguedi, ibiyobi dummarba gue.","poem":1},{"text":"E-garganguedi, ibiyobi gandiki negsemai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Jacob-wagan, ¿ibiga be Bab-Jehová-dikarba sunmake?","poem":1},{"text":"Israel-dulemar, ¿ibiga be urwakwaa Bab-Jehová-dakmala?","poem":2},{"text":"Be sogmalad: “An-igarmar Bab-Jehováʼgi dukumaiye.","poem":1},{"text":"An-Bab-Dummad an-ibmar-imaked baisurdakye.”","poem":2}]},{"type":"verse","number":28,"content":[{"text":"¿Ar ade, be wissursi?","poem":1},{"text":"¿Be wisgussursi?","poem":2},{"text":"Ar Bab-Jehová Bab-Dummad-degisadeguadid,","poem":1},{"text":"napneg-bipirmaknaid bela obinnisadid,","poem":2},{"text":"budar-itoged nikasulid, gege geggubalid,","poem":1},{"text":"e-nue-ibmar-wisidi, gege balamileged.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Bab-Jehová dule-yegusmaladga gangued uked,","poem":1},{"text":"E na dule-nollo-itomaladga gandikidba gangued uked.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Sapingana dutusur-inigwele, geggusdamalad, budar-itogusdamalad.","poem":1},{"text":"Masmala yoleddamalad, aimukuddamalad.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Degi-inigwele, dule-Bab-Jehováʼgi-bensurmaladdi, gannarse gangued nikumaloed,","poem":1},{"text":"sulubagi-gukueyobi gumaloed:","poem":2},{"text":"Abarmakdii gumaloed,","poem":1},{"text":"gwen gegguosurmalad,","poem":2},{"text":"igala-suid-nanadii gumaloed,","poem":1},{"text":"gwen gegguosurmalad.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}