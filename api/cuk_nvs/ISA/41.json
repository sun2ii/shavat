{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":41,"content":[{"type":"heading","content":["Bab-Dummad Israel-dulemar-edarboed"]},{"type":"verse","number":1,"content":["Bab-Dummad weyob soged:",{"text":"“Neggwebur-demar-gakaba-bukmalad, bogi an-abin ambikumalo.","poem":1},{"text":"Dulemar-yar-baid-baidgi-bukmalad, gandik be imakmar.","poem":2},{"text":"Walikaa be dagmar,","poem":1},{"text":"be sunmakmar.","poem":2},{"lineBreak":true},{"text":"Anmar igar-nabogega ambikumar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"”¿Doa dad-nakwedsik, dule-gusgu-emargi-obinmaid wese-dagega imaksa?","poem":1},{"text":"¿Doa we-dulega dulemar-yar-baid-baidgi-bukmalad urmaksa?","poem":2},{"text":"¿Doa reymar-seega imaksa?","poem":1},{"text":"¿Doa ukub-milegeyobi es-suidgi dulemar-obelogega imaksa?","poem":2},{"text":"¿Doa e-warsi-abin-ibmar-durgan-mileddaedyob dulemar-imaksa?","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Gwen nanadisulid-igarba, binnasuli dule-balegindanikid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"¿Doa weyob imaksa? ¿Doa nabir we-ibmar bursuli-guega imaksa?","poem":1},{"text":"¿Doa gebesailaunni dulamar-ainakwedanikidse gocha?","poem":2},{"text":"Ani an Bab-Jehová guedi, bela we-ibmarmar imaksad.","poem":1},{"text":"Ani an gebesailaginedid,","poem":2},{"lineBreak":true},{"text":"ani an berguedse gudii gubaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"”Neggwebur-demar-gakaba-bukmaladi, dani-daksamalad,","poem":1},{"text":"dobe-itodmalad.","poem":2},{"text":"Napneg-naid-ugakaase abin giglimakded.","poem":1},{"text":"Bato egi danimalad, bato walikgusmalad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Muchub-muchub e-aimar-bendakdemalad,","poem":1},{"text":"muchub-muchub burba-ogannodmalad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dule-ibmar-sobedi, dule-orgi-arbaed ogannoged.","poem":1},{"text":"Dule-mardogi-ibmar-sobedi, dule-esgorogi-arbaed-ogannoged, ega weyob soged: ‘Arbaed-nued be imaksa.’","poem":2},{"text":"Geb sorba, ibmar-sobaled-bab-dummadyob-imakleged nue-esgorogi bioked,","poem":1},{"text":"adi, melle ege-ege gwisguegar.”","poem":2}]},{"type":"verse","number":8,"content":["Bab-Jehová sogdebalid:",{"text":"“Israel, bedi an-maiga gued.","poem":1},{"text":"Be, Jacob-wagan, an bemar-susadid,","poem":2},{"lineBreak":true},{"text":"An-ai-Abraham-wagan be gumalad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ar napneg-naid-ugakaase an be-susad,","poem":1},{"text":"nega-sukungan-dikasulidba an bese gochad.","poem":2},{"text":"An bega sogsad: ‘Be an-maiga gued.’","poem":1},{"text":"Ani an be-susad, an be-obachasulid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Melle be gwayo.","poem":1},{"text":"An beba gudiguad.","poem":2},{"text":"Melle be suli-suli-itogo.","poem":1},{"lineBreak":true},{"text":"Ani an be-Bab-Dummadid.","poem":1},{"text":"An be-ogannogoed,","poem":2},{"text":"an be-bendakoed,","poem":1},{"text":"an-sakwa-gandikid-nuedsikidgi an be-ganikioed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”Dule-isdar-be-dakmaladi, bingegudmaloed,","poem":1},{"text":"nug-mesagwar gudmaloed.","poem":2},{"text":"Dule-begi-gwisgudimaladi, bela bergudoed,","poem":1},{"text":"gudisurmaladyobi naoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Be be-isdarmalad-amidiguo-inigwele, gwen be amiosulid.","poem":1},{"text":"Bebo-bila-onomaladi, bela bergudoed,","poem":2},{"lineBreak":true},{"text":"gudisurmaladyobi naoed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ar ani an be-Bab-Dummad-Jehová gued.","poem":1},{"text":"An be-argan-nuedsikid-ganikidid.","poem":2},{"text":"Ani an bega soged: ‘Melle be gwayo,","poem":1},{"text":"ani an be-bendakoed.’ ”","poem":2}]},{"type":"verse","number":14,"content":["Bab-Jehová soged:",{"text":"“Bemar-Israel-dulemar ichee-gue-inigwele,","poem":1},{"text":"melle be gwayemalo.","poem":2},{"text":"Bemar-Jacob-wagan-gandik-gusur-inigwele,","poem":1},{"text":"melle be gwayemalo.","poem":2},{"lineBreak":true},{"text":"Ar an-sunnagwad an be-bendakoed.","poem":2},{"text":"Ani an Israel-dulemar-e-Bab-Dummad-Isligwaled gued.","poem":1},{"text":"Ar an be-Bendakedid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"”Ibmar-gwag-egwaed-binidyobi an be-imakmaloed,","poem":1},{"text":"e-nugar-abinbela-datarmakar-nikayobi an be-imakmaloed.","poem":2},{"text":"Yarmar be obelogoed, swana be imakoed.","poem":1},{"text":"Yar-mullugana gaganbi naguega be imakoed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Oros-gwag-burwaba-mileddaedyobi be imakoed.","poem":1},{"text":"Burwa-noedba aisakidmaloed.","poem":2},{"text":"Ar bedi, angi weligwar itogoed.","poem":1},{"text":"Bedi, angi Israel-dulemar-e-Bab-Dummad-Isligwaledgi nug-gannarba itomaloed.”","poem":2}]},{"type":"verse","number":17,"content":["Bab-Dummad sogdebalid:",{"text":"“Dule-wilemalad, degi, dule-ibmar-abesa-gudimalad, gobega dii amididamalad,","poem":1},{"text":"degi-inigwele, amidasurmalad.","poem":2},{"text":"Uku-uku-itogedba gwabin-dinna itogusdamalad.","poem":1},{"text":"Degi-inigwele, ani Bab-Jehová-guedgi an amar-itogoed.","poem":2},{"text":"Ani an Israel-dulemar-e-Bab-Dummad-guedgi,","poem":1},{"text":"an amar walagwen metosulid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yalamar-biribali, diwarmar-iirmakega an imakoed,","poem":1},{"text":"nebaganba ibemargi-dii-aryogega an imakoed,","poem":2},{"text":"nega-dulesulidganba dii-ambikuega an imakoed.","poem":1},{"text":"Neg-dinnaganba ibemar-aryomai an imakoed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nega-dulesulidganbali, urwarmar, acacia-sapimar, an digoed.","poem":1},{"text":"Baryawarmar, degine, olivo-sapimar an digoed.","poem":2},{"text":"Napa-isganagi, ciprés-sapimar an digoed,","poem":1},{"text":"pino-warmar, degi, abeto-sapimar an digoed.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Adi, dulemar dakega, degi, wisgumalaga,","poem":1},{"text":"egi binsamalaga, degi, magar-itomalagar,","poem":2},{"text":"Bab-Jehová we-ibmarmar-imaksaye,","poem":1},{"text":"Israel-dulemar-e-Bab-Dummad-Isligwaledi, we-ibmarmar obinnisye.”","poem":2}]},{"type":"heading","content":["Bab-Dummadi, bab-dummagan-baigangi obined"]},{"type":"verse","number":21,"content":["Bab-Jehová Jacob-dulemar-e-Rey, ibmar-sobaled-bab-dummadyobi-imaklemaladga sogded:",{"text":"“Be-igar be sogmardo.","poem":1},{"text":"E-wilubmar be oyomardo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Wese be dagmar, ibmar-guoed be sogmar.","poem":1},{"text":"Gebesailagi ibmarmar-gusnanaedi, anmarga be soge,","poem":2},{"text":"anmar egi binsaegar, degi, ibmar-gusadi, anmar magar-itomalagar.","poem":1},{"text":"Igi-neg-guoe anmarga be sogmar.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yoedse-negguoed be anmarga sogmar,","poem":1},{"text":"adi, anmar wisgumalagar, bemar bab-dummagan gumarye.","poem":2},{"text":"Bemar ibmar imakmala, nueddibe, ichakwadibe,","poem":1},{"text":"adi, anmar dakega, degi, anmar ese gwayegar.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ar bemar binsarmaladid,","poem":1},{"text":"ar be-ibmar-imakmaladi, binsa ibmar-imaklemaladid.","poem":2},{"lineBreak":true},{"text":"Ar dule-begi-bensurmaladga ibmar-nuedga be gusurmalad.”","poem":2}]},{"type":"verse","number":25,"content":["Bab-Dummad sogdebalid:",{"text":"“Dad-nakwed-argan-sapiledsik, dule-gwensak-dagega an imaksad.","poem":1},{"text":"An-ese-gochad, an-itosad.","poem":2},{"text":"We-dule, dad-nakwedsik an-nug odummogoed.","poem":1},{"text":"We-dule, dule-dummagan-negsemamaid-birgi dule-napsa-sobed-napsagi-dii-dii-annanaiyob imakoed.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"¿Ar doa we-ibmar-guoed gebesailaunni anmar-owisosa?","poem":1},{"text":"¿Ar doa abgayala we-ibmar-guoed anmar-owisosa?","poem":2},{"text":"Adi, anmar sogega, eye, nabir sogye.","poem":1},{"text":"Ar dule gwen we-ibmar-guoed sogsasulid,","poem":2},{"text":"dule gwen owisossurbalid.","poem":1},{"text":"Dule-we-ibmar-guoed-soged, gwen dule itossurbalid.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ar ani an abgasaila Sión-dulemarga bato an sogsad: ‘Be dakmarye, bato wegi bukmarye.’","poem":1},{"text":"Ani an Jerusalén-neggweburse dule-gayaburba-berbeged-nued barmisad.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"An-dikarbali an atakded,","poem":1},{"text":"dule gwen an daksulid.","poem":2},{"text":"Emar-imbagi dule-ega-binsaed-daked gwen an daksulid.","poem":1},{"text":"An ibmar-ese-egichidgu, gwen an-abinsassurmalad.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ar bela we-bab-dummagan-baigana binsa-ibmar-imaklemaladyobi gued.","poem":1},{"text":"E-ibmar-imakmaladi, gwen nabirsulid.","poem":2},{"text":"E-ibmar-sobarmalad-bab-dummadyob-imaklemaladi, unnila uka-olloo daklemaladid.","poem":1},{"text":"Binsa-ibmar-daklemalad gued.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":29}