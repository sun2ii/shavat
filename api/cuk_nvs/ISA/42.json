{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":42,"content":[{"type":"heading","content":["Bab-Jehová-e-mai"]},{"type":"verse","number":1,"content":["Bab-Jehová soged:",{"text":"“We, an-mai-gued.","poem":1},{"text":"Ani an we-dule-sediid.","poem":2},{"text":"Ani na susad.","poem":1},{"text":"An egi yeer itoged.","poem":2},{"text":"An-burba an ega uksad.","poem":1},{"text":"Ani Bab-Jehová, dulemar-yar-baid-baidgi-bukmaladga igar-innikigwad imakoed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"We-dule, binnasuli golosulid, sabsuli sunmakosulid.","poem":1},{"text":"Galimbaba binnasuli sunmakdii itolegosulid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nargammu-bisgedanigwichidi bar bisgosurmalad.","poem":1},{"text":"Gwallu-gwillo-binnagamaidi gwen oginnosulid.","poem":2},{"lineBreak":true},{"text":"Igar-napiragwadbali igar nabogoed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"We-dule, napneggi igar-napiragwad-omesedse gwen wieguosulid, gwen galakuosulid.","poem":1},{"text":"Demar-gakaba-neggwebur-bukmalad, we-dule-e-odurdaked abdakbukwad.”","poem":2}]},{"type":"verse","number":5,"content":["Bab-Dummad-Jehová mogir-billi obinnisadid, mogir-billi nasiksadid, napneg onasosadid, bela egi-ibmar-sanmaked onasosadid, dulemar-bukwadga niga-ogannogedid, dulemarga burba-dulad-ukedid. We-Bab-Dummad-Jehová weyopira soged:"]},{"type":"verse","number":6,"content":[{"text":"“Ani an Bab-Jehová gued.","poem":1},{"text":"Ani an bese gochad,","poem":2},{"text":"igar-innikigwad-imakega an be-semai gusad.","poem":1},{"text":"Ani an be-odenonikid,","poem":2},{"text":"an-dulamarga an dulemarbo-igar-mesisad-e-wilubga-guega an be-imaksad.","poem":1},{"text":"Dule-yar-baid-baidgi-bukmalad-magar-neg-itomalaga, gwallu-meegwadyobi an be-ogwisgunonikid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Adi, be dulemar-aku-atakmaladga ibya egaegar,","poem":1},{"text":"be dule-esgaryagi-bukmalad onogegar,","poem":2},{"lineBreak":true},{"text":"degi, be dule-esgaryaba-negsichidgi-bukmalad onogegar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”¡Ani an Jehová gued!","poem":1},{"text":"¡Deyob an nugad!","poem":2},{"text":"An-nug-odummolegedi, dule-baidgadga guosulid.","poem":1},{"text":"An-nug-odummolegedi, ibmar-sobaled-bab-dummadyob-imaklemaladga an ukosurbalid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ibmar-iduar-an-sogsagusmalad bela gusad.","poem":1},{"text":"Emisgindi, ibmar-gwapidmarbi an sogbalid.","poem":2},{"lineBreak":true},{"text":"Iduakwaa ibmar-guoed an bemar-owisoged.”","poem":2}]},{"type":"heading","content":["Bab-Jehová-nug-odummogedgi namakleged"]},{"type":"verse","number":10,"content":[{"text":"Bab-Jehováʼga namakleged-gwapidgi be namakmar.","poem":1},{"text":"Bemar-muu-billigi-iirmakbukwad, ega be namakmar.","poem":2},{"text":"Demar-yagi-ibmar-dula-bukmalad, Bab-Jehová-nug odummomar.","poem":1},{"text":"Napneg-ugakagi-bukmalad, Bab-Jehová-nug ogannomar.","poem":2},{"text":"Bemar demar-gakaba-bukmalad, Bab-Jehová-nug be odummomar.","poem":1}]},{"type":"verse","number":11,"content":[{"text":"Nega-dulesulidganba-bukwamalad, bemar binnasuli gormar.","poem":2},{"text":"Cedar-dulemar neggwebur-burwigangi-bukmalad, bemar binnasuli gormar.","poem":1},{"text":"Sela-dorgan, yeer-itogedba be namakmar,","poem":2},{"lineBreak":true},{"text":"yeer-itogedba yala-birgi binnasuli be gormar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Gandikidba be Bab-Jehová-nug odummomar,","poem":1},{"text":"neggwebur-demar-gakaba-bukmaladgi binnasuli Bab-Jehová-nug be odummomar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bab-Jehová dule-bila-onogedyob nodagoed.","poem":1},{"text":"Dule-bila-onoged-urweyobi uludagoed.","poem":2},{"text":"Binnasuli urwedgi bila-onodagoed,","poem":1},{"text":"e-isdarmaladgi obinoed.","poem":2}]},{"type":"verse","number":14,"content":["Bab-Jehová soged:",{"text":"“An dikasurgusa bogidik gudigusad,","poem":1},{"text":"an gwen sunmaksasulid, an gwen ibmar sogsasulid.","poem":2},{"text":"Emisgindi, an binnasuli goloed.","poem":1},{"text":"Ome-ugakgunair binnasuli-bunnonaiyobi, akus-akus-bunnonaiyobi, binnasuli gornai an guoed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yalamar, degi, yar-mullugana, an obelogoed.","poem":1},{"text":"E-gaganmar bela an odinnogoed.","poem":2},{"text":"Diwarmar neg-dinnaganaga an imakoed,","poem":1},{"text":"dii-wilagana an odinnogoed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dule-aku-atakmalad, igar-dakdisurmaladba an nidoed,","poem":1},{"text":"nanaledisulid-igarba an nidoed.","poem":2},{"text":"Amar-asabinni, negsichidi neg-meegwadga an imakoed.","poem":1},{"text":"Amar-idu, neg-muru-murumalad an innikii imakoed.","poem":2},{"lineBreak":true},{"text":"Deyob an imakoed, an gwen amar-obanosulid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dulemar ibmar-sobaled-bab-dummadyob-imaklemaladgi bengudisurmaladi,","poem":1},{"text":"nue-bingegus bangudmaloed.","poem":2},{"text":"Akwa-sobarmaladga-sokardamaladi, ‘be anmar-bab-dummaganaye,’","poem":1},{"text":"a-dulemala, nue-bingegus bangudmaloed.”","poem":2}]},{"type":"heading","content":["Israel-dulemar amba gwen-durdaksurmalad"]},{"type":"verse","number":18,"content":["Bab-Dummad weyob soged:",{"text":"“¡Dule-uaya-yallirmalad! Nue be itomarsun.","poem":1},{"text":"¡Dule-aku-atakmalad! Nue be atakmarsun.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"¿Doa an-maiba bur bule akusunna ataksunna?","poem":1},{"text":"¿Doa an-gayaburba-berbergedba bur bule uaya-yallirsunna?","poem":2},{"text":"¿Doa an-nuggi-barmilesadba bur bule akusunna ataksunna?","poem":1},{"text":"¿Doa Bab-Jehová-e-maiba bur bule akusunna ataksunna?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Be ibmar-bukidar-daksa-inigwele, degite, be amba aku daked.","poem":1},{"text":"Uaya be olloo-sii-inigwele, be ibmar-itosulid.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Bab-Jehová, e-igar-innikigwad-sabedbali, yeer-itosad.","poem":1},{"text":"E-igar-maid-dummarba-guedbali, degi, gandikid-guedbali, yeer-itosad.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ar we-dulemarde atursaledidimalad,","poem":1},{"text":"sabsur odurdakledidimalad.","poem":2},{"text":"Bela akwa-dummagan-yaba gales-bukwamaladid,","poem":1},{"text":"esgaryaba mellesmaladid.","poem":2},{"text":"Ei-ibmar atursales gudidimalad, dule gwen bendakdisurmalad.","poem":1},{"text":"Ei ibmar sules gudidimalad.","poem":2},{"lineBreak":true},{"text":"Gwen dulemar gannar-ega-ibmar-ukmarye sogdisurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"¿Doa bemar we-ibmar itogoe?","poem":1},{"text":"¿Doa bemar yoedse-we-ibmar-guoed nue-itogoe?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"¿Doa ibmar-sulesmaladyobi Jacob-wagan-uksa?","poem":1},{"text":"¿Doa ibmar-atursalealedyobi Israel-dulemar-uksa?","poem":2},{"text":"¿Ar Bab-Jehová e-dulamar egi isgusgusad urmaksasursi? Eye, urmaksa.","poem":1},{"text":"Ar ade, Bab-Jehová-igarba nanassurmalad,","poem":2},{"lineBreak":true},{"text":"e-Igar-Maid-sogedba ibsassurmalad.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"A-ulale, Bab-Jehová egine ulusad,","poem":1},{"text":"bila egi onosad.","poem":2},{"text":"Soogine sabsur-odurdaksad, degi-inigwele, amba aku-itosmalad.","poem":1},{"text":"Sabsur-odurdakles-inigwele, amba eba ibsassurmalad.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/41.json","previousChapterAudioLinks":{},"numberOfVerses":25}