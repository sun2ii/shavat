{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":43,"content":[{"type":"heading","content":["Bab-Jehováʼbi unnila Israel-Dule-Abonogedid"]},{"type":"verse","number":1,"content":["Jacob-wagan, Bab-Jehová-be-obinnisadi soged, Israel-dulemar, Bab-Dummad-be-urbisadi, weyob soged:",{"text":"“Melle be dobguo,","poem":1},{"text":"ar ani an be-nudaksad.","poem":2},{"text":"Be-nugba an bese gochad.","poem":1},{"text":"Be an-mimmi gued.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Be dii-obaknaile, an beba nadapmogoed.","poem":1},{"text":"Be diwar-obaknaile, be gundilegosulid.","poem":2},{"text":"Soo-birgi be nadapile, gwen be gummakosulid.","poem":1},{"text":"Soo-duurmakedi gwen begi naguosulid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ar ade, ani an be-Bab-Dummad-Jehová gued,","poem":1},{"text":"an Israel-dulamar-e-Bab-Dummad-Isligwaledid,","poem":2},{"lineBreak":true},{"text":"an be-Abonogedid.","poem":2},{"text":"Ani an, be-onogega, Egipto-dulemar-urmaksad.","poem":1},{"text":"Be-muchub Etiopía-yar, degi, Seba-yar an urmaksad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"An be-muchubbi dulemar-urmakoed,","poem":1},{"text":"an be-san-burba-muchubbi, dule-bamalad an urmakoed.","poem":2},{"text":"Ar an bela-belad bemar-sabed.","poem":1},{"text":"Be an-asabinni, ibiyob be yeerdaklege, be duledar-nued gued.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Melle be dobguo.","poem":1},{"text":"Ar an beba gudiid.","poem":2},{"text":"Dad-nakwed-akale, an be-anagan sedagoed.","poem":1},{"text":"Dad-argwaned-akale, an be-urboed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dulemar-dad-nakwed-argan-sapiledsik yar-baid-baidgi-bukmaladga an sogoed:","poem":1},{"text":"‘¡An-dulamar anga udage!’","poem":2},{"text":"Dulemar-dad-nakwed-argan-nuedsik yar-baid-baidgi-bukmaladga an sogoed:","poem":1},{"text":"‘¡Melle an-dulamar gamalo!’","poem":2},{"text":"Be anga an-masmala-dikasuli-bukwad sedage,","poem":1},{"text":"be anga an-bunamala-napneg-ugakaase-bukwad sedage.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"An-nugba-ese-gollemaladi, be anga bela seda.","poem":1},{"text":"An-nug-odummogega an obinnisadi, be anga seda.","poem":2},{"text":"Ani an obinnisad,","poem":1},{"text":"ani an urbisad.”","poem":2}]},{"type":"heading","content":["Israel-dulemar, Bab-Dummad-barsogega gued"]},{"type":"verse","number":8,"content":["Bab-Dummad soged:",{"text":"“Dule-aku-atakmalad, amba ibya-nika-inigwele, be anga onimar.","poem":1},{"text":"Dule-uaya-yallirmalad, amba uaya-nika-inigwele, be anga onimar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dule-yar-baid-baidgi-bukmalad bela be oambikumar.","poem":1},{"text":"Bela dulemar danar ambikumar.","poem":2},{"text":"¿Doa we-dulemar-abargi we-ibmar-guoedgi iduakwaa anmarga sunmaksa?","poem":1},{"text":"¿Doa ibmar-gusmalad anmarga sogsa gusa?","poem":2},{"text":"E-daksamalad be oyomardo,","poem":1},{"text":"nabir-sogmarye be sogmardo,","poem":2},{"text":"adi, dule-baigan itomalagar,","poem":1},{"text":"degi, sogmalagar: ‘Napiraye.’ ”","poem":2}]},{"type":"verse","number":10,"content":["Bab-Jehová Israel-dulemarga soged:",{"text":"“Bemar an-barsogega be gumar,","poem":1},{"text":"anga-arbaega an bemar-susad,","poem":2},{"text":"adi, bemar magar-an-dakmalagar,","poem":1},{"text":"melle angi bengumalagar.","poem":2},{"text":"Adi, be magar-itomalagar, an doa gue.","poem":1},{"text":"An-iduale, bab-dummad-baid gwen megissulid,","poem":2},{"lineBreak":true},{"text":"gwen an-sorba bab-dummad-baid megosurbalid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ani an Bab-Jehová gued.","poem":1},{"text":"An-imbagi, dule-abonoged-baid sated.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ani an bemar-owisosad,","poem":1},{"text":"ani an bemar-bendaksad.","poem":2},{"text":"Ani an bemarga sunmaksad.","poem":1},{"text":"Bemar-abargi, gwen bab-dummad-baid gudii gussulid.","poem":2},{"text":"Ani an gudii gusad.","poem":1},{"text":"Ani an Bab-Jehová-guedgi soged:","poem":2},{"text":"‘Bemar an-barsogega be gumarye,","poem":1},{"text":"Ani an Bab-Dummad guye.’","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ani an gebe-negasaila-akale Bab-Dummad gued.","poem":1},{"text":"Dule gwen angi wakinnosulid.","poem":2},{"lineBreak":true},{"text":"An-ibmar-imakedi, dule gwen obelogosulid.”","poem":2}]},{"type":"heading","content":["Bab-Dummad Israel-dulemar-ise-wile daksad"]},{"type":"verse","number":14,"content":["Israel-dulemar-e-Bab-Dummad-Jehová-Isligwaled bemar-bendakmaidi, weyob soged:",{"text":"“Bemar-ulale, Babilonia-neggweburse sorda-bamalad an barmidoed.","poem":1},{"text":"Dulemar-wakindiiyobi an bela Babilonia-dulemar-imakoed.","poem":2},{"text":"Caldea-dulemar urmar-nikadba na nug-dummarba-itodimalad,","poem":1},{"text":"bela an obelomogoed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ani an Bab-Dummad-Jehová-Isligwaledid.","poem":1},{"text":"Ani an bemar-e-rey gued, Israel-dulemar-obinnisad gued.”","poem":2}]},{"type":"verse","number":16,"content":["Bab-Jehová sogdebalid:",{"text":"“Ani an demargi igar-mesisgusad,","poem":1},{"text":"dii-wilasailadgi igar-egasgusad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Egipto-sordamar, moli-birgi, degi, moli-ur-bila-onomaladgi, Israel-dulemar-bargananai-gusmargua,","poem":1},{"text":"Bab-Jehová, Egipto-sordamar-bela-obelosgusad.","poem":2},{"lineBreak":true},{"text":"Gwallu-gwillo-akichayob amar-imaksagusad.”","poem":2}]},{"type":"verse","number":18,"content":["Bab-Jehová weyob soged:",{"text":"“Ibmar-nasmalad be iemar,","poem":1},{"text":"melle bar ibmar-gusmaladgi be binsadii gumar.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ibmar gwapidmar an imakoed.","poem":1},{"text":"¿Ar bato ibmar-imaklenaid aku be dakmarsi?","poem":2},{"text":"Ar nega-dulesulidganba an igar mesnaid,","poem":1},{"text":"neg-dinnaganba an diwarmar mesnaid.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ibmar-durgan-sapurbarmalad-ursilimalad, an-nug ogannomalad.","poem":1},{"text":"Achu-sapur-uaya-gannagana, nuu-dummad-dukar-suid-avestruzʼye-nugmalad, an-nug odummomalad.","poem":2},{"text":"An an-dulamar-susad-ogobega, nega-dulesulidganba dii-suurmakega an imaked,","poem":1},{"text":"neg-dinnaganba diwarmar-megega an imaked.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"We-dulemar angadga-guega an urbisad,","poem":1},{"text":"an-nug ogannomalaga an urbisad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"”Degi-inigwele, bemar, Jacob-wagan, gwen an-nug odummossurmalad.","poem":1},{"text":"Israel-dulemar, bemar angi wiegudmalad.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Anga bemar sibad-wawaad-sapingana-ogumakar uksasurmalad,","poem":1},{"text":"ibmar-durgan-anga-ukedgi gwen be an-nug ogannosurmalad.","poem":2},{"text":"An bese-ibmar-gwag-ukleged-egichedgi-wieguega, an bemar-imaksasulid.","poem":1},{"text":"Ina-wawagan-oburmakedgi-budar-itogega, an bemar-imaksasulid.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Be anga gwen masar-wawadikmalad baksasulid.","poem":1},{"text":"Gwen be ibmar-durgan-oburgwileged-e-gwallugi an-yeer-itogega, be an-imaksasulid.","poem":2},{"text":"Aka bur be be-isgumaladgi isdarsunna-itogega be an-imaksamalad.","poem":1},{"text":"Be-isgumaladi, budarsunna-be-dakega an-imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"”Degi-inigwele, ani, an nue-be-sabsoggu, a-ulale, an bega isgued elied.","poem":1},{"text":"An be-isguedgi bar binsaosulid.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Be angi ibmar-soged-nikale, igar-nabogedneggi be anga sogdado.","poem":1},{"text":"Be ibmar sogdo, adi, magar-daklegega, bule-nabir be ibmar imaksasuli.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ar be-dad-sailaginedi isgusad.","poem":1},{"text":"Be-odurdakmaladi, angi dummad-nosmalad.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"A-ulale, anse-goled-neg-dakmalad-dummagan nug-bipii an imaksad.","poem":1},{"text":"Jacob-wagan-bela-obelolegega an imaksad.","poem":2},{"lineBreak":true},{"text":"Israel-dulemar-mesagwar-imaklegega an imaksad.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":28}