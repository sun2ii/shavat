{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":44,"content":[{"type":"heading","content":["Bab-Jehováʼbi, Bab-Dummadid"]},{"type":"verse","number":1,"content":["Bab-Jehová soged:",{"text":"“An-mai-Jacob-dulamar, Israel-dulamar-an-na-susad.","poem":1},{"text":"¡Emigi, nue be an-itogo!”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Weyob Bab-Jehová-be-obinnisadi, sapibeneggi be-omesisadi,","poem":1},{"text":"be-bendakmaidi, soged:","poem":2},{"text":"“Jacob-dulamar, melle be dobgu,","poem":1},{"text":"be an-mai gued,","poem":2},{"lineBreak":true},{"text":"Jesurún, ani an be-susad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Napa-dinnaganaba dii-suurmakega an imakoed,","poem":1},{"text":"nega-dinnaganaba dianmar an omesoed.","poem":2},{"text":"Be-wagangine, An-Burba an odegoed,","poem":1},{"text":"be-anagangine, ise-nued an binsaoed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gagan-oglegwichiyobi gumaloed,","poem":1},{"text":"dianmar-gaka-nagaba sapi-senigana-gwigwichi-daeyobi gumaloed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dule-gwensak sogdagoed: ‘An Bab-Jehováʼgad gued.’","poem":1},{"text":"Dule-baiddi ‘Jacobʼye’ nugguoed.","poem":2},{"text":"Dule-baidmoga e-argangi weyob narmakoed:","poem":1},{"text":"‘Ani an, Bab-Jehováʼgadi.’","poem":2},{"lineBreak":true},{"text":"Geb Israel-nug e-nugga imakoed.”","poem":2}]},{"type":"heading","content":["Bab-Jehová, degi, bab-dummagan"]},{"type":"verse","number":6,"content":["Weyobi, Bab-Jehová, Israel-dulemar-e-Rey, Israel-dulemar-Bendakmaidi, degi, Bela-Gangued-Nikadi, soged:",{"text":"“Ani an gebesailadid, anse bergunaibalid,","poem":1},{"text":"Bab-Dummad-baidi sulid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"¿Doa anyob gusunna?","poem":1},{"text":"¡Dule anyobile, sunmakdo!","poem":2},{"text":"An an-dulamar-urbisad-akale, ibmarmar-gusad sogdo.","poem":1},{"text":"¡An-asabin, yoo-ibagan-guoedgi sunmakdo!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"¡Melle be gwayemar,","poem":1},{"text":"gandik be imakmar!","poem":2},{"text":"¿Ar bato an bega sogsasursi?","poem":1},{"text":"¿Dikasurgus an be-owisossursi?","poem":2},{"text":"Ar bemar an-barsogega gumalad.","poem":1},{"text":"¿Ar Bab-Dummad-baid maisi? Suli.","poem":2},{"text":"¿Bab-Dummad-baid bebina-sogedi maisi? Suli.","poem":1},{"text":"Gwen Bab-Dummad-baid-gudii an dakdisulid.”","poem":2}]},{"type":"heading","content":["Bab-dummaganyob-soblesmalad-binsarmalad"]},{"type":"verse","number":9,"content":[{"text":"Dule ibmar-bab-dummadyob-imakleged-sobmaladi, ibmar-nuedga gusulid.","poem":1},{"text":"E-ibmar-bur-yeerdakle-sobarmaladi, gwen ibmar-nuedga gusulid.","poem":2},{"text":"E-sobmaladi, na wismalanad,","poem":1},{"text":"we-ibmar-bab-dummadyob-imaklegedde, aku atakmalad, uaya yallirmalad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dule-bab-dummad-baid-sobedi, we-ibmar ega ibmar-nuedga gusulid.","poem":1},{"text":"Degi, esgoro-diregwadgi bab-dummadyob-imakleged-sobedi, we-ibmar ega ibmar-nuedga gusulid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bela dule-ega-san-uksamaladi, bingedar itomaloed,","poem":1},{"text":"we-ibmar-sobedgi-arbamaladi, unnila dulemar gumalad.","poem":2},{"text":"Bela bular ambikudamarsun, bela dagmarsun.","poem":1},{"text":"Ar bela ise-gwayar bukudmaloed, nue-bingedar itodmaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dule-esgoro-sobed, esgoro amied.","poem":1},{"text":"Geb soo-ginnitibidgine, esgoro mesed.","poem":2},{"text":"Geb mardogi sarsogar bab-dummadyob-imakleged sobed.","poem":1},{"text":"Ise nuesaar imaked.","poem":2},{"lineBreak":true},{"text":"Ar dule-esgoro-sobedi, mas-gunsuli-arbanaile, gobsurbalile, nolloleddaed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dule-ibmar-sobedi, suargi-ibmar-soboed dubgi wilub-imaked.","poem":1},{"text":"Geb esgoro-garagwadgi ibmar sobed, ibmar-orokwaa-saedgi wagar-wilub-onoged.","poem":2},{"text":"Geb a-sorbali, akwa duleyob-daklege, degi, yeerdaklege sobed,","poem":1},{"text":"adi, neg-bipigwad-yaba ogwisegar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dule-baigan nikabalid, urwar-digmalad.","poem":1},{"text":"Geb dii-wiedi a-urwarmar odummoged.","poem":2},{"text":"Geb urwar siklegega bukidar nika gunonikoed.","poem":1},{"text":"Ciprés-warmardibe, barya-warmardibe, sapurba digdamalad,","poem":2},{"lineBreak":true},{"text":"nue-odummogedse imakdamalad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Geb dulemar e-anagan soo-ogaega imakdamalad.","poem":1},{"text":"Dule waegala, sapan-negabala ogadamalad.","poem":2},{"lineBreak":true},{"text":"Egi soo-ogasale, madu yodamarbalid.","poem":2},{"lineBreak":true},{"text":"Deginbali, egi suar-nuchu sobdamarbalid.","poem":1},{"text":"Geb e-nug-odummoddamalad.","poem":2},{"text":"Ibmar-sobaled-bab-dummadyob-imakleged sobdamarbalid.","poem":1},{"text":"Geb asabin yokorgi-sindigar sigdamalad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abala, a-suar, sapanga imakdamalad.","poem":1},{"text":"Egine, geb na mas dudamalad,","poem":2},{"text":"degi, san nariddamarbalid,","poem":1},{"text":"geb nue-immelesdamalad.","poem":2},{"text":"Geb deginbali, egi wadamarbalid.","poem":1},{"text":"Sogdedamalad: “Soo-gasgu, wis uka-uegus-itole.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Geb suar-gwabgusadgi, suar-nuchu sobdamalad,","poem":1},{"text":"e-bab-dummadga imakdamalad.","poem":2},{"text":"Geb asabinni yokorgi-sindigar sigdamalad,","poem":1},{"text":"e-nug odummoddamalad.","poem":2},{"text":"Geb ise-wilegar ega sogdedamalad: “Be an-bendake,","poem":1},{"text":"ar bee be, an-bab-dummadid.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ar we-dulemar ibmar wissurmalad.","poem":1},{"text":"Akusunna ibmar itomalad.","poem":2},{"text":"Ar nue-atakmar-inigwele, akusunna ibmar dakmalad.","poem":1},{"text":"Neg-aku-itomaladid, akusunna ibmar-itomaladid.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Amba ibmar-wisgued napid.","poem":1},{"text":"Amba magar-ibmar-itoged abeged.","poem":2},{"text":"Ar gwen weyob binsasurmalad,","poem":1},{"text":"weyob sogsurmalad: “Suar, abala madu-yoega an ebusad,","poem":2},{"text":"abala an egi san-narisbalid, a-san an guchad.","poem":1},{"text":"¿A-suar-gwabgusadgi, an ibmar-isgana sobode?","poem":2},{"lineBreak":true},{"text":"¿Ar we-suar-asabin ande yokorgi-sindigar sigode?”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ar we-dulemar sooburu-maeyobi gumalad.","poem":1},{"text":"Dukin e-binsaedbali yamoledimalad.","poem":2},{"text":"Geg na-dukin agi onomalad,","poem":1},{"text":"degi, geg sogbalid: “¡We an-argan-nuedsik-ibmar-ganikidi, ibmar-binsaledid!”","poem":2}]},{"type":"verse","number":21,"content":["Bab-Dummad weyob sogded:",{"text":"“Jacob-wagan, we-ibmar be insao.","poem":1},{"text":"Ani an be-obinnisad, be an-maiga-gued,","poem":2},{"text":"Israel-dulemar, an gwen be-iegosulid.","poem":1},{"text":"Israel-wagan, ar be an-maiga gued.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Burwa-sibugana-yogguddaedyobi, an bega be-ibmar-isgana-imaked, osulosad.","poem":1},{"text":"Degi, boo-aisakiddaedyobi, an bega be-isgued osulosad.","poem":2},{"text":"Gannar be anse dage,","poem":1},{"text":"ani an be-nudaksad.”","poem":2}]},{"type":"verse","number":23,"content":["Isaías weyob sogded:",{"text":"“Mogir-billi, Bab-Jehová-ibmar-imaksadgi weligwaledgi be namak.","poem":1},{"text":"Napa-yaa-matusurmalad, gandikidba be gormakmar.","poem":2},{"text":"Yalamar, sapurmar, degi, bela e-sapimar, binnasuli be namakmar.","poem":1},{"text":"Ar ade, Bab-Jehová Jacob-dulemar-bendaksad,","poem":2},{"lineBreak":true},{"text":"Bab-Dummadi e-gandikid-yeerdakleged Israel-yalagi oyosad.”","poem":2}]},{"type":"heading","content":["Jerusalénʼgi dulemar gannar ambikuoed"]},{"type":"verse","number":24,"content":[{"text":"Weyob Bab-Jehová-be-bendakedi, sapibeneggi-be-omesisadi soged:","poem":1},{"text":"“Ani an Bab-Jehová gued, bela ibmar-obinnisadid.","poem":2},{"text":"Ani an wargwen mogir-billi egasadid.","poem":1},{"text":"Ani an dukin napneg onasosadid.","poem":2},{"lineBreak":true},{"text":"Dule gwen an-bendaksasulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"”Ani an Bab-Dummad-gayaburba-barsogedyob-san-imakdamalad-e-ibmar-sogedi, ega guega an imakdasulid.","poem":1},{"text":"Nergan an obingesadaed.","poem":2},{"text":"Dule-binsaed-ibegana sikirmakega an imakdaed.","poem":1},{"text":"E-binsaed-nikaa-daedi, gannar-gannar-ibmar-obaredga an imakdaed.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ani an an-maimar-gayaburba ogannodaed.","poem":1},{"text":"Degi, anga-gayaburba-berbemalad anse-ibmar-egisedi, sogedba-guega an imakdaed.","poem":2},{"lineBreak":true},{"text":"”Ani an soged, ‘Jerusalén-neggwebur gannar sigoye,","poem":1},{"text":"Judá-neggweburmar gannar bukuoye,","poem":2},{"lineBreak":true},{"text":"e-neg-bibichismalad, gannar an nudakoye.’","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ani an demar-wilasailad odinnoged.","poem":1},{"text":"Degi, diwar-odinnogega an igar ukbalid.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ani an Rey-Ciroʼgi soged: ‘Anga sibad-wawaad-edarbed guye.","poem":1},{"text":"An-ibmar-abegedi anga sogedba imakoye.","poem":2},{"text":"Jerusalén-neggwebur gannar sigoye.","poem":1},{"text":"Anse-goled-neg-e-saila gannar megoye.’ ”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/43.json","previousChapterAudioLinks":{},"numberOfVerses":28}