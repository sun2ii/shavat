{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":45,"content":[{"type":"heading","content":["Bab-Dummad Ciroʼga igar-uked"]},{"type":"verse","number":1,"content":["Isaías soged:",{"text":"“Bab-Jehová, dulemar-yar-baid-baidgi-bukwamalad Ciro-urbalikwaa-nanaega imaksad.","poem":1},{"text":"Ciroʼde, Bab-Jehová-nuggi-reyga-nugsalesadid.","poem":2},{"lineBreak":true},{"text":"Degi, Bab-Jehová, Ciro reymar-e-gangued-obelogega imaksadid,","poem":2},{"text":"Ciro-abinni, yawagakmar-argaega-imaksadid,","poem":1},{"text":"yawagakmar-mer-bar-atuega-imaksabalidid.”","poem":2}]},{"type":"verse","number":2,"content":["Bab-Jehová weyob Ciroʼga soged:",{"text":"“Ani an be-idunadapi guoed,","poem":1},{"text":"ani an yalamar-omatogoed.","poem":2},{"text":"Ani an bega esgoro-gordikid-yawagakmar mamaroed,","poem":1},{"text":"ani an bega yawagak-eduged-esgorobiid bibisgoed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ibmar-nuegan-gargerbamalad-dukuar-bukwad an bega ukoed.","poem":1},{"text":"Ibmar-nuegan-dukuar-bukwad an bega ukoed.","poem":2},{"text":"Adi, be wisguegar, ani an Bab-Jehová gued.","poem":1},{"text":"Ani an Israel-dulamar-e-Bab-Dummadid.","poem":2},{"text":"An be-nugba bese goledid.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"An, an-mai-Jacob-sabedbali, degi, an Israel-dulamar-susadbali, an bese be-nugba goled.","poem":2},{"text":"Be aku an-dak-inigwele, an bega nug-gandikid uked.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Anbi an Bab-Jehová gued, dule-baid sulid.","poem":2},{"text":"An-imbagi, Bab-Dummad-baid sulid.","poem":1},{"text":"Be aku an-dak-inigwele, an be-ogannogoed,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"adi, dulemar dad-nakwedsik-bukmalad, degi, dad-argwanedsik-bukmalad wisgumalagar, an-imbagi Bab-Dummad-baid sulid.","poem":1},{"text":"Anbi an Bab-Jehová gued, dule-baid sulid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ani an neg-meegwad nasiksad,","poem":1},{"text":"ani an negsichid nasikbalid.","poem":2},{"text":"Ani an dulemar-nued-gudiguega imakbalid,","poem":1},{"text":"ani an boni-dummagan ukbalid,","poem":2},{"lineBreak":true},{"text":"ani an Bab-Jehová-guedi, bela we-ibmarmar imakmaid.”","poem":2}]},{"type":"heading","content":["Bab-Jehová ibmar-obinnisadid"]},{"type":"verse","number":8,"content":["Bab-Jehová soged:",{"text":"“¡Nibali, dii-boomiedyobi igar-innikigwad an barmidsun!","poem":1},{"text":"¡Mogir-imbaba dii-wiedyobi igar-napiragwad an barmidsun!","poem":2},{"text":"¡Napneggi igar-innikigwad maiguguega an imaksun!","poem":1},{"text":"¡Abonoleged an barmidsun!","poem":2},{"lineBreak":true},{"text":"An Bab-Jehová-guedgi an we-ibmarmar obinnisad.”","poem":2}]},{"type":"verse","number":9,"content":["Bab-Dummad sogbalid:",{"text":"“Dule na e-obinnisadbo urwele, ¡duledar-wiles-dakle!","poem":1},{"text":"Ar dule napsa-nog-goayobi, napsa-nog-goamar-abargi-milediidyob gued.","poem":2},{"text":"Ar napsa dule-e-sobedga weyob sogosi: ‘¿Ibu be imaknai?","poem":1},{"text":"Be-ibmar-imaknaid nue be imaknaisulid.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Dule e-babga sogele: ‘Ibiga be an-baksa.’","poem":1},{"text":"Dule-deyob-sogedi, ¡duledar-wiles-dakle!","poem":2},{"text":"Dule e-nanga sogele: ‘Ibiga be napnegse an-odesa.’","poem":1},{"text":"Dule-deyob-sogedi, ¡duledar-wiles-dakle!”","poem":2}]},{"type":"verse","number":11,"content":["Bab-Jehová Israel-dulemar-e-Bab-Dummad-Isligwaled, Israel-dulemar-urbisad, weyob soged:",{"text":"“¿Ar igi-an-mimmigan-yoedse-guoed be anse egichosi?","poem":1},{"text":"¿An-ibmar-obinnisadgi bemar anga igar-ukosi? Suli.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ar ani an napneg nasiksad.","poem":1},{"text":"Ani an dulemar urbisad.","poem":2},{"text":"An-argangine, mogir-billi an nasiksad.","poem":1},{"text":"E-niisgwamarga ani an igar uksad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ani an gandikidba Rey-Ciro-ogwichisad,","poem":1},{"text":"an ega igarmar nudakoed.","poem":2},{"text":"Ciro anga an-neggwebur gannar urboed,","poem":1},{"text":"an-dulamar-gales-bukwad anga onogoed.","poem":2},{"text":"Ciro, an-dulamar-onogoedi, manigi-baklegar onogosulid.","poem":1},{"text":"Ani an Bab-Jehová-Bela-Gangued-Nikad deyob soged.”","poem":2}]},{"type":"verse","number":14,"content":["Weyob Bab-Jehová soged:",{"text":"“Egipto-e-ibmar-nuegan, degi, Etiopía-e-ibmar-nuegan, begadga gumaloed.","poem":1},{"text":"Sabeo-dule-burwisurmaladi, be-sorba esgoro-dubgi ebipilemai gumaloed.","poem":2},{"text":"Bemar-asabinni yokorgi-sindigar bukumaloed,","poem":1},{"text":"ise-wilesakwaa bemarga sogdamaloed:","poem":2},{"text":"‘Unnila Bab-Dummad wargwenna-mai, Bab-Dummad-baid suli.","poem":1},{"text":"We-Bab-Dummadi, bemarba naid.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Bab-Dummad, be, Israel-dulemar-Abonogedid,","poem":1},{"text":"be Bab-Dummad-akudaklegedid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bela dulemar ibmar-bab-dummadyob-imaklemalad-sobmaladi, bingedar-itoge gumaloed,","poem":1},{"text":"degi, san-bipii gumaloed.","poem":2},{"lineBreak":true},{"text":"Bela bular na san-bipi gumaloed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Israel-dulemar Bab-Jehováʼgi-nue-bendaklesmalad, bendakles sadegumaloed.","poem":1},{"text":"Bali-bipisaale, bingedar-itogosurmalad, bali-san-bipi imaklegosurmalad.","poem":2}]},{"type":"verse","number":18,"content":["Ar ade, weyob Bab-Jehová soged:",{"text":"“Ani an Bab-Jehová gued,","poem":1},{"text":"Bab-Dummad-baid sulid.","poem":2},{"text":"Ani an mogir-billi-obinnisadid.","poem":1},{"text":"Ani an napneg-nasiksadid.","poem":2},{"text":"Ani an napneg-ilemakar nasiksadid,","poem":1},{"text":"binsa-ollobi-nasikega an imaksasulid,","poem":2},{"lineBreak":true},{"text":"dulemar egi ambikuega an imaksad.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Gwen an bemarga we-napneg-naidgi negsichidgi-dukuar an sunmaksasulid.","poem":1},{"text":"Degi, gwen an Jacob-waganga weyob sogsasulid: ‘Neg-olloledgi be an-amimalo.’","poem":2},{"text":"Ani an Bab-Jehová-guedgi igar-napiragwadbi an soged,","poem":1},{"text":"degi, an igar-innikigwadbi soged.”","poem":2}]},{"type":"heading","content":["Bab-Jehová, degi, ibmar-sobarmalad-bab-dummadyob-imaklemalad"]},{"type":"verse","number":20,"content":["Bab-Jehová sogbalid:",{"text":"“Dule-yar-baid-baidginmalad bemar-wakindimalad be atomar,","poem":1},{"text":"be anse dagmar.","poem":2},{"text":"Akusunna-ibmar-itomaladi, ibmar-sobarmalad-bab-dummadyob-imakleged sedimalad.","poem":1},{"text":"Degine, bab-dummagan-gwen-e-abonogosulidse gordimalad.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Be sunmakmar, ibmar-imaksad be sogmar,","poem":1},{"text":"na be muchub-muchub egisnanai be samalo.","poem":2},{"text":"¿Doa bato dikasurgus iduakwaa we sogsa?","poem":1},{"text":"¿Doa epenne bato we-ibmar sogsa?","poem":2},{"text":"¿Ar ade, ani an Bab-Jehová we-ibmar sogsasursi?","poem":1},{"text":"Baid Bab-Dummad sulid.","poem":2},{"text":"Ani an Bab-Dummad-Innikidaedid.","poem":1},{"text":"Ani an Dule-Abonogedid.","poem":2},{"lineBreak":true},{"text":"Baid Bab-Dummad sated.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"”Bela napneg-ugakagi-bukmalad be abonolemalagala, anse be gannar dagmar.","poem":1},{"text":"Ar ade, ani an Bab-Dummadid, Bab-Dummad-baid sated.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"An-nuggi an ise-sogar-imaksad,","poem":1},{"text":"an napiragwadba ibmar-sogsad,","poem":2},{"lineBreak":true},{"text":"ibmar gusuli-guosulid guedsegad.","poem":2},{"text":"Bela-dulemar an-asabin yokorgi-sindigar sigmaloed,","poem":1},{"text":"bela-dulemar anga ise-sogar imakmaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"”Wemar angi sogmaloed: ‘Unnila Bab-Jehováʼgi igar-innikigwad danikid,","poem":1},{"text":"degi, gargangued eginbi danibalid.’ ”","poem":2},{"text":"Dulemar isdar Bab-Dummad-daksamaladi, Bab-Dummad-asabin nonimaloed,","poem":1},{"text":"bingedar itomaloed.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bela Israel-e-wagan bendaklegoed,","poem":1},{"text":"degi, bela Bab-Jehová-nuggi gannarba gumaloed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}