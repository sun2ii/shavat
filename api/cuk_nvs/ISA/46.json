{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":46,"content":[{"type":"heading","content":["Babilonia-dulemar-e-bab-dummagan"]},{"type":"verse","number":1,"content":[{"text":"Babilonia-dulemar e-bab-dummad-Belʼye-nugad dugdir naded,","poem":1},{"text":"bab-dummad-Neboʼye-nugad balimelleded.","poem":2},{"text":"Wemar-e-wilubgan-sobarmalad, ibmar-durgan-nabir-ibmar-semaladgi sesmalad.","poem":1},{"text":"Ar ade, wemar-e-wilubgan yeer-aidikued,","poem":2},{"text":"bela ibmar-durgan-nabir-ibmar-semalad-ebilis nasikdamalad,","poem":1},{"text":"ibmar-durgan nue-yegus itodamalad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-dummadyob-imaklemalad dugdir nadmalad,","poem":1},{"text":"napagi babatided,","poem":2},{"text":"gwen dukin na bendaksasurmalad,","poem":1},{"text":"degidba gales selesmalad.","poem":2}]},{"type":"verse","number":3,"content":["Bab-Dummad weyob soged:",{"text":"“Jacob-wagan, be an-itomar,","poem":1},{"text":"bela Israel-dulemar be an-itomar.","poem":2},{"text":"Sapibeneggi be maigu, an nue-be-akwisad,","poem":1},{"text":"an nue-be-nidii gusad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Amba bemar seredgusale,","poem":1},{"text":"bato bemar nono-dagudikgusale,","poem":2},{"text":"amba an nue-be-nidii guoed.","poem":1},{"text":"Amba an-sunnagwad an be-sedioed.","poem":2},{"text":"Ani an bemar-obinnisad,","poem":1},{"text":"ani an bemar-bendakdii guoed.","poem":2},{"text":"Ani an be-sedioed.","poem":1},{"text":"Ani an igar-bulegangi be-ollorsaoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"”¿Doa-ebo be an-wilubdakoe?","poem":1},{"text":"¿Doa-ebo emar-daklege be an-imakoe?","poem":2},{"text":"¿Doa-yopira an-daklege be an-imakoe?","poem":1},{"text":"Suli. Gege be emaryob be an-imaked.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ar dulemar gwenna-gwenna, binsa e-or sagumargi-bukwadi, obelodamalad,","poem":1},{"text":"e-manidi, nibirgi wilubsadamalad.","poem":2},{"text":"Geb dule-ibmar-sobed amidamalad,","poem":1},{"text":"adi, bab-dummadyob-imakleged sobegar.","poem":2},{"lineBreak":true},{"text":"A-bab-dummadyob-imakleged-nug-odummogega, e-asabinni yokorgi-sindigar sigdamalad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Geb a-sorbali, a-bab-dummadyob-imakleged, gukingi-mai seddamalad.","poem":1},{"text":"Geb e-gwisguedgi ogwisgudapdamalad, bar onirdasurmalad.","poem":2},{"text":"Ar dule amba we-ibmar-sobaledse binnasuli-gornaile, amba e-abinsaosulid.","poem":1},{"text":"Degine, amba dule-bukib-binsadiid egi gwen bendaklegosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”Bemar, uyasulidamalad. We-ibmar be ebinsamalo.","poem":1},{"text":"¡Nue na be binsamalo, nue be itomalo!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Epenne ibmar-dikasurgus-gusmalad be ebinsamalo.","poem":1},{"text":"Ani an Bab-Dummadid, dule-baid sated,","poem":2},{"lineBreak":true},{"text":"Ani an Bab-Dummadid, dule-anyobid sulid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani an sailanagi yoedse-ibmar-guoed owisoged.","poem":1},{"text":"Ibmar yoedse-guoedi amba dikasuli-gued-idu an soged.","poem":2},{"text":"An soged: An-ibmar-abegedi sogedba guoed,","poem":1},{"text":"an-ibmar-abegedba an imakoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dule-gwensakse dikasuli dad-nakwedsik an gochad,","poem":1},{"text":"sulubagiyob dikasuli danikoed,","poem":2},{"text":"a-dule, anga an-ibmar-abeged-imakoed.","poem":1},{"text":"An-ibmar-sogsadi, sogedba-guega an imakoed.","poem":2},{"lineBreak":true},{"text":"An-igar-amisadi, an imakoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Gwage-dutusurmalad, be an-itomar.","poem":1},{"text":"Igar-napiragwadgi-dikasurgudimalad, be an-itomar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"An-igar-napiragwadi dikasur maisulid,","poem":1},{"text":"an-abonogedi bato warmaksad.","poem":2},{"text":"Sión-yala-abonoleged an imakoed,","poem":1},{"text":"Israel-dulemarga an-gandikid an ukoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/45.json","previousChapterAudioLinks":{},"numberOfVerses":13}