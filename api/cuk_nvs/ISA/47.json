{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":47,"content":[{"type":"heading","content":["Babilonia-yala berguoed"]},{"type":"verse","number":1,"content":["Bab-Jehová sogbalid:",{"text":"“Babilonia-yala yagwa-yoo-sui-nikuedyobi be guedi,","poem":1},{"text":"be aidege, napagi be sige.","poem":2},{"text":"Caldea-dulemar-e-sisgwayobi be guedi,","poem":1},{"text":"napagi be sige, ar be-ologana bergusad.","poem":2},{"text":"Bar bese ome-nued-dakleye gorlegosulid,","poem":1},{"text":"degi, ome-bakagwaledye gorlegosulid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Obnaged-akwa be sue,","poem":1},{"text":"ibmar-gwag egi be nage.","poem":2},{"text":"Muswe be unge,","poem":1},{"text":"sabure-bayaa be sae,","poem":2},{"text":"dua swiri be imake,","poem":1},{"text":"diwargi be obake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Be-uka-swiligwadi bela daklegoed,","poem":1},{"text":"bela be-abganse-bakale, daklegoed.","poem":2},{"text":"Be dummad-bingeguoed.","poem":1},{"text":"An buged be-imakoed.","poem":2},{"text":"Bela dulemar isgusadbi an dakoed,","poem":1},{"text":"an ega e-isgued gwen eliosulid.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Anmar-Bendakedi, Israel-dulemar-e-Bab-Dummad-Isligwaledid.","poem":1},{"text":"Bab-Jehová-Bela-Gangued-Nikadye nugad.","poem":2}]},{"type":"verse","number":5,"content":["Bab-Dummad weyob soged:",{"text":"“Caldea-dulemar-sisgwa bogi be sige.","poem":1},{"text":"Neg-gubyagwaled-yaba be doge.","poem":2},{"text":"Ar dule bar be-biosulid:","poem":1},{"text":"‘Rey-bundor yar-baid-baid-nanaid semaidye.’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"An-dulamala an-oulus gusad.","poem":1},{"text":"A-ulale, a-dulemar an obachagusad.","poem":2},{"text":"Be-argan-yaurgi an uksagusad.","poem":1},{"text":"Degi-inigwele, gwen be wiledaksasulid.","poem":2},{"lineBreak":true},{"text":"Dule-sergangala arbaed-dummad be uksagusad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Weyob be sogsa gusad:","poem":1},{"text":"‘¡Gusgu bela yar-semaigu an guoye!’","poem":2},{"text":"Degi-inigwele, gwen be binsassulid, an berguodeeye,","poem":1},{"text":"gwen weyob-guodeeye be binsassulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”Emigindi, Rey-bundor-ibmarbina-surbinsa-itoged, be nue-itogo:","poem":1},{"text":"Emide, na be nued-gudii itoged,","poem":2},{"text":"na be dukin-weyob sogdiid:","poem":1},{"text":"‘Anbi an weyob guye, dule-baid anyobid surye.","poem":2},{"text":"Bipisaale, an gwen machered-sate guosurye,","poem":1},{"text":"an gwen mimmigansuli guosurbarye.’","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ar ibagwennaa ukiarmakale, ibmar-sogbobela bega guoed:","poem":1},{"text":"Mimmigansuli be gunonikoed,","poem":2},{"lineBreak":true},{"text":"degi, machered-sate be gunonikoed.","poem":2},{"text":"Ar be bukidar ina-isgana-imako-inigwele, degi, bela ibmar-burbamar be oyogo-inigwele,","poem":1},{"text":"we-ibmar be-bendakosulid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ar be be-ibmar-isgana-imakedgi be bengussulid.","poem":1},{"text":"Ar be sogsagusad: ‘We-ibmar-isgana-imakedgi dule an-dakdisuli.’","poem":2},{"text":"Be-binsaed-nikadaedi, be-ibmar-wisidaedi, dukin be-yardaksad.","poem":1},{"text":"Ulubgine na be weyob sogsad: ‘Anbi an weyob guye, dule-baid anyobid surye.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Begine, boni-dummad nonikoed,","poem":1},{"text":"mer begi-yolegega be imakoenad,","poem":2},{"lineBreak":true},{"text":"degi-inigwele, we-boni begi yolegedsegad.","poem":2},{"text":"Begine, boni-dummad-nagunonikoed, gwen be gaosulid.","poem":1},{"text":"Boni-dummad begi danikoye gwen be binsadisulidgi, ukiarmakale begi gwisgunonikoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"”Ibmar-burbamar-wisid-oyogedgi be alamakdii gudo.","poem":1},{"text":"Ina-isgana-imakedgi be alamakdii gudo.","poem":2},{"text":"Ar nuchukwagwad-akale, egi be arbadiid.","poem":1},{"text":"Abakar wis be-ibmar be-bendakalile,","poem":2},{"lineBreak":true},{"text":"abakar wis be nabir bonigan-ogwayealile.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bukidar-bega-binsaed-uklesadba, be budar-itogusad.","poem":1},{"text":"Emisgi, dule-niisgwaba-bega-ibmar-dakar-sogmalad dagmarsun:","poem":2},{"text":"We-dulemar mogirmargi-ibmar-nanaidba-nergumaladid,","poem":1},{"text":"niisgwa-dakedba-ibmar-sogmaladid, degi, nii-irba iduakwaa-ibmar-guoed-sogmaladid.","poem":2},{"lineBreak":true},{"text":"We-dulemar boni-dummagan begi-danikoedgi be-bendakmarsun.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Be-dake, we-dulemar gagan-durganyob-gumalad,","poem":1},{"text":"bela soo obelogoed.","poem":2},{"text":"Na-dukin soo-gwabunyedgi san-onogosurmalad.","poem":1},{"text":"Ar we-soo, neg-uee-imakedyobsulid, geg be walik siged.","poem":2},{"lineBreak":true},{"text":"Geg be we-soo-asabin siged.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Weyob dulemar-bebo-alamakdigusad gumaloed.","poem":1},{"text":"Ar be nuchukwagwad-akale, bebo-ina-isganagi-arbasmalad weyob gumaloed.","poem":2},{"text":"Na wala-walagwen e-itolegedba nademaloed,","poem":1},{"text":"ar dule-wargwensaale be-bendakosulid.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}