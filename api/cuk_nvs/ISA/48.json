{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":48,"content":[{"type":"heading","content":["Israel-dulemar-uayasulidaed"]},{"type":"verse","number":1,"content":[{"text":"Jacob-wagan, we-igar-an-bega-sogoedi, nue be itomalo.","poem":1},{"text":"Judá-wagan Israel-dulemarye-biledimalad, nue an-itomalo.","poem":2},{"text":"Bemar Bab-Jehová-nuggi be ise-sogar-ibmar-sogdimaladi, Israel-e-Bab-Dummadse be gordimaladi, napiragwadgi be imakdisurmalad.","poem":1},{"text":"Igar-innikigwadgi be imakdisurmalad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bemar neggwebur-islidikidginmaladye na be sogdimalad,","poem":1},{"text":"degine, Israel-e-Bab-Dummadgi-bensurmalad,","poem":2},{"text":"Bab-Dummad-Bela-Gangued-Nikadye-nugadgi be bensurmalad,","poem":1},{"text":"nue be itomalo.","poem":2}]},{"type":"verse","number":3,"content":["Bab-Dummad weyob soged:",{"text":"“Ibmar-gusmaladi, bato an dikasurgus egi an sunmaksad.","poem":1},{"text":"Yoo-ibmar-guoed-iduale, bato an egi iduakwaa sunmaksad.","poem":2},{"text":"An-sunnagwad dulemarga an oyosad.","poem":1},{"text":"Ukiarmakale, an imaksad.","poem":2},{"lineBreak":true},{"text":"Bela deyob gunonikid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ar ade, bato an wisid, bede nue gwage-dutusulid,","poem":1},{"text":"be-dukar-war esgoro-gannaregedyobid,","poem":2},{"lineBreak":true},{"text":"be-bebe-gar esgoro-gordikidyobid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"A-ulale, an bega dikasurgus we-ibmar sogsad.","poem":1},{"text":"Iduakwaa we-ibmar-guoed an bega oyosad,","poem":2},{"text":"adi, melle be sogegar: ‘An-ibmar-bab-dummadyob-sobaled, we-ibmar imaksaye.","poem":1},{"text":"An-ibmar-wilub-sobaled, degi, an-suar-sobaled we-ibmar-guoed sogsaye.’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bela we-ibmarmar-gusad be itosad, bela be daksad.","poem":1},{"text":"Degite, ¿bemar we-ibmarmar-gusad sogosursi?","poem":2},{"lineBreak":true},{"text":"”Emisgi, an ibmar-binigan bemarga an sogoed.","poem":1},{"text":"Be-idu ibmar-dukuar-mamaidi, akudaklemaladi, an bemarga sogoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"We-ibmarmar emiskwaa imaklesmaladid,","poem":1},{"text":"dikasurgus imaklesurmaladid.","poem":2},{"text":"Emi-ibagine, amba egi-sunmakleged be itodisulid,","poem":1},{"text":"adi, melle be sogegar: ‘Eye, dika bato an wisbinye.’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bipisaale, gwen we-ibmar be itodisulid,","poem":1},{"text":"gwen be wissurbalid.","poem":2},{"text":"We-ibmar gwen be iduar itodisulid,","poem":1},{"text":"gwen bega iduar be-uaya, magasar-itogega argassulid.","poem":2},{"text":"Ar an nue be-wisid, be emar-yardakmaladid,","poem":1},{"text":"be gwalulesad-akale, uayasulidaedye be-bimalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"”An, an-nug-sabed-ulale, an-urwed an bargaed.","poem":1},{"text":"An-nug-odummoleged-ulale, an na san-bargaed,","poem":2},{"lineBreak":true},{"text":"adi, melle be-obelogegar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"¡Be dakena! An swilidik be-imaksad.","poem":1},{"text":"Degi-inigwele, mani-swilidik-imaklegedyob an be-imaksasulid,","poem":2},{"lineBreak":true},{"text":"sabsur-wile-itolegedgi an be-wilubdaksad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"An we-ibmar-imaksadi, an-ulale an imaksad,","poem":1},{"text":"an na dukin-sabed-ulale, an deyob imaksad.","poem":2},{"text":"¿Sunna an-nug obanagwar-imakmalaga an imakosi? Suli.","poem":1},{"text":"An-nug-odummolegedi, dule-baidgadga an ukosulid.”","poem":2}]},{"type":"heading","content":["Israel-dulemar-ollorgunonikid"]},{"type":"verse","number":12,"content":["Bab-Jehová weyob sogbalid:",{"text":"“Jacob-wagan, be an-itoge,","poem":1},{"text":"Israel-wagan, ani an bese gochad.","poem":2},{"text":"Ani an Bab-Dummadid.","poem":1},{"text":"Ani an gebesailaginedid, anse bergunaibalid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"An-argangine, napneg an nasiksad,","poem":1},{"text":"an-argan-nuedsiki, mogir-billi an egasad.","poem":2},{"lineBreak":true},{"text":"Ani an e-nugba ese gochagu, bela nagunonikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"”Bela bemar ambikumar, be an-itomar:","poem":1},{"text":"¿Doa we-ibmar-guoed iduakwaa sogsa?","poem":2},{"text":"Ani Bab-Jehová, an dule-gwensak-susad Babilonia-yalagi an-ibmar-imakbied imakoed,","poem":1},{"text":"Caldea-dulemargi gwichiguoed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ani an we-ibmarmar sogsad.","poem":1},{"text":"Unnila ani an we-dulese gochad.","poem":2},{"text":"Dagega, an imakoed,","poem":1},{"text":"e-ibmar-imakoedgi emargi obinoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"”Anse be walikgudamar,","poem":1},{"text":"an ibmar-sogoedi, nue itomalo:","poem":2},{"text":"Gebesailaunni an gwen dukuar sunmaksasulid,","poem":1},{"text":"ibmarmar gualile, bato an gunaidaed.”","poem":2},"Emide, Bab-Jehová-Bela-Gangued-Nikad, E-Burba-gandikidba an-barmialid."]},{"type":"verse","number":17,"content":["Weyobi Bab-Jehová be-Bendakedi, degi, Israel-dulemar-e-Bab-Dummad-Isligwaled, soged:",{"text":"“Ani an Bab-Jehová gued,","poem":1},{"text":"bemar-Bab-Dummadid.","poem":2},{"text":"Ibmar-nueganba be-odurdakedid,","poem":1},{"text":"ibu-igarba be nanaoe, a-igarba be-iduedid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"An-igarmar-mamaidba be uaya-nika gudigusana,","poem":1},{"text":"diwar-aryomadaedyobi ulubgi bogidikid be nikuoenad,","poem":2},{"lineBreak":true},{"text":"demar-mullumakmadaedyobi be baisur-itodii guoenad.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Be-wagan ukub-naidyob-mergu guoenad,","poem":1},{"text":"be-mimmigan ukub-merguedyob-mergu guoenad.","poem":2},{"text":"E-nuga gwen-alliosulinad,","poem":1},{"text":"an-asabinni, gwen weyob guosulinad.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"¡Babilonia-yalagi be ainimar!","poem":1},{"text":"¡Caldea-dulemargi be wakinmar!","poem":2},{"text":"Bemar Babilonia-yalagi-noedgi binnasuli weligwaledba be we-igargi sunmakmalo.","poem":1},{"text":"We-ibmar dulemar-wisguega be imakmalo,","poem":2},{"lineBreak":true},{"text":"bela yala-naid-ugakaase gayaburba be mimimalo.","poem":2},{"text":"Weyob be sogmalo:","poem":1},{"text":"“Bab-Jehová, e-mai-Jacob-wagan bendaksaye.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nega-dulesulidganba-seargua, gwen ukud mechasurmalad.","poem":1},{"text":"Bab-Jehová emargala, akwasailagi dii-aryogega imaksad.","poem":2},{"lineBreak":true},{"text":"Akwa-marisgusadgi dii-binnasur ega aryogega imaksad.","poem":2}]},{"type":"verse","number":22,"content":["Bab-Jehová soged:",{"text":"“Dule-isganagardi gwage-bogidikid sateye.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/47.json","previousChapterAudioLinks":{},"numberOfVerses":22}