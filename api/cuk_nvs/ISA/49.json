{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":49,"content":[{"type":"heading","content":["Bab-Jehová-e-mai"]},{"type":"verse","number":1,"content":[{"text":"Dikasur-demar-gakaba-bukmaladi, be an-itomar.","poem":1},{"text":"Neggwebur-bannaba-bukmaladi, an-ibmar-sogoed itomalo:","poem":2},{"text":"Gwaluleged-iduale, Bab-Jehová bato anse gochad.","poem":1},{"text":"Sapibeneggi-mai, bato an-nug bisad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Es-suid-swiswidikidyobi an-gayaburba imaksad.","poem":1},{"text":"E-argan-yaurgine an-odukusad.","poem":2},{"text":"Sigu-daarmakaledyob an-imaksad,","poem":1},{"text":"e-sigumar-saboged-yaba an-odukusad.","poem":2}]},{"type":"verse","number":3,"content":["Bab-Dummad anga weyob sogsad:",{"text":"“Israel-wagan, be an-maiga gued.","poem":1},{"text":"Begine, an-nug odummolegoed.”","poem":2}]},{"type":"verse","number":4,"content":["Geb an abinsaded:",{"text":"“Binsarsunna an arbasad.","poem":1},{"text":"Binsarsunna an gar-itosad,","poem":2},{"lineBreak":true},{"text":"gwen ibmar-nued an nikgussulid.","poem":2},{"text":"Degi-inigwele, an-ibmar-imakedi, Bab-Jehováʼgi siid.","poem":1},{"text":"Bab-Dummad anga-ibmar-nuegan-ukoed bato guagwar sisad.”","poem":2}]},{"type":"verse","number":5,"content":["Emide, Bab-Jehová soged:",{"text":"“An e-maiga-guegala,","poem":1},{"text":"sapibeneggi-mai anga burba uksad.","poem":2},{"text":"Adi, Jacob-wagan gannar eba nanaegar,","poem":1},{"text":"Israel-dulemar gannar ese ambikudagegar.","poem":2},{"text":"Ar ande Bab-Jehová-asabin an-nug gannarba gued.","poem":1},{"text":"Agala, an-Bab-Dummad anga niga-ogannoged.”","poem":2}]},{"type":"verse","number":6,"content":["Bab-Dummad weyob e-maiga soged:",{"text":"“Be an-maiga-guedgi, unnila be anga Jacob-waganbi gannarse nudakosulid.","poem":1},{"text":"Unnila be anga Israel-dulemarbi gannar-e-yarse sedagosurbalid.","poem":2},{"text":"Dulemar-yar-baid-baidgi-bukmaladga, neg-meegwadga-guega an be-imakbalid,","poem":1},{"text":"degi, bela napaneg-naid-ugakaasega, an-abonoleged-igar-sedega an be-imakbalid.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová, Israel-dulemar-ollor-imakedi, Bab-Dummad-Isligwaledi, weyob soged,","poem":1},{"text":"dulemar-yar-baid-baidgi-bukmaladse mesagwar-gulediidga, isdar-daklediidga,","poem":2},{"lineBreak":true},{"text":"degine, dummagan-negdakmamaid-e-maiganga, weyob soged:","poem":2},{"text":"“Reymar be-dakdamalogu, gwisgudmaloed.","poem":1},{"text":"Dule-dummagan-nuga-nikamalad be-dakdamalogu, be-abin dulluu imakmaloed.","poem":2},{"text":"Israel-dulemar-e-Bab-Jehová-Isligwaled-ular, be-nug odummodmaloed.","poem":1},{"text":"Ar ade, Bab-Dummad, dule-napiragwadid,","poem":2},{"lineBreak":true},{"text":"degi, na e be-susadid.”","poem":2}]},{"type":"heading","content":["Bab-Dummad Israel-dulemar gannarse urbisad"]},{"type":"verse","number":8,"content":["Bab-Jehová weyob soged:",{"text":"“Iba-nuegangi an be-itosad,","poem":1},{"text":"degi, abonoleged-ibagangi an be-bendaksad.","poem":2},{"text":"Emigindi, an nue-be-akoed,","poem":1},{"text":"degi, an begine dulemarga igar mesoed,","poem":2},{"text":"adi, be gannarse neggwebur-urbegar,","poem":1},{"text":"degine, nainumar-olloo-nanaid be mimiegar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Adi, dule-galesmaladga weyob be sogegarba: ‘Be ainimarye.’","poem":1},{"text":"Degi, dulemar-negsichidgi-bukmaladga weyob be sogegarba: ‘Bemar ollorgusmarye.’","poem":2},{"lineBreak":true},{"text":"”Bemar, igarbali, be-ibdurganga gagan-ara-aramalad amimaloed,","poem":1},{"text":"bela nega-dulesulid-yar-mullugangi gagan-ara-aramalad be amimaloed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bemar ukudmaada itogosurmalad.","poem":1},{"text":"Dad-ibeler-gaedi, degi, neg-ueguedi, budar-itoge be-imakosurmalad.","poem":2},{"text":"Ar dule-wile-be-daked, be-nioed,","poem":1},{"text":"dian-aryomamaidba be-sedoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bela an-sapurmar-nanaidgi igar-mamai an imakoed,","poem":1},{"text":"an-igarmar an omesoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"¡Be dakmalana!","poem":1},{"text":"Wemarde dikasuli danimaloed.","poem":2},{"text":"Gwen-gwen dad-nakwed-argan-sapiledsik danimaloed,","poem":1},{"text":"baigandi, dad-argwanedsik danimarmogoed,","poem":2},{"lineBreak":true},{"text":"degi, baigandina, Sinim-yar-akar danimaloed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nibneg-naid, be weligwaledba, ¡binnasuli gole!","poem":1},{"text":"Napneg-naid, ¡be wergusun!","poem":2},{"text":"Sapurmar, ¡gandikidba be namakmar!","poem":1},{"text":"Ar Bab-Jehová e-dulemar-gwage armaked,","poem":2},{"lineBreak":true},{"text":"e-dulemar-wilesagwa-gudimalad wiledaked.","poem":2}]},{"type":"verse","number":14,"content":["Degi-inigwele, Sión-yalagi-bukmalad weyob sogsad:",{"text":"“Bab-Jehová walagwen an-meted,","poem":1},{"text":"Bab-Jehová an-iesad.”","poem":2}]},{"type":"verse","number":15,"content":["Bab-Jehová sogdebalid:",{"text":"“¿Ar sunna nan-gwensakde e-mimmi-iesi?","poem":1},{"text":"¿Ar sunna e-mimmi-baksad sabgusuli gusi?","poem":2},{"text":"Ar we-nande, e-mimmi-nue-ieye-sogele,","poem":1},{"text":"andi an gwen be-iegosulid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"An-argangi-sobar-naiyobi an be-sediid.","poem":1},{"text":"Be-galu-matusurmaladi, an iedisulid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bega-neg-sobmaladi, begi gwae-gwae danimalad.","poem":1},{"text":"Be-obelomaladdi, begi bangudmalad,","poem":2},{"lineBreak":true},{"text":"bei neg-ollomaksamalad begi bangudmalad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nue be-atake, be-dikarba nue be neg-dake.","poem":1},{"text":"Bela bulakwaa ambikunonimalad, bese danimalad.”","poem":2},"Bab-Jehová soged:",{"text":"“An dula-maisoggu, bela wemar, ibmar-nuegan-ebulegedyobi gumaloed,","poem":1},{"text":"abirgin-nikued-mor-yolegedyobi gumaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"”Be-yala obelosmar-inigwele,","poem":1},{"text":"akwamarbi ganna-ganna obesmar-inigwele,","poem":2},{"text":"degi, olloo nasiksamar-inigwele, be-yala be-dulemarga unniguosulid.","poem":1},{"text":"Dule-be-wiosmaladdi, dikasuli bemargi bukwa gumaloed.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Be-mimmigan-bei-yoggusye-na-be-bisadi, bega sogdamaloed:","poem":1},{"text":"‘Dogdar we-yala anga bipii noye.","poem":2},{"text":"Anga be neg-amiye,","poem":1},{"text":"agi nabir an gudisaegarye.’","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Geb degi, be binsadoed:","poem":1},{"text":"‘¿Doa we-mimmigande anga baksasunna?","poem":2},{"text":"An mimmi satenad,","poem":1},{"text":"ar an geg mimmi bakenad.","poem":2},{"text":"An ononnoles gudiinad,","poem":1},{"text":"emarse-obanagwar an gudiinad.","poem":2},{"text":"Ar we-mimmigande, ¿doa anga odummossunna?","poem":1},{"text":"Ar an walagwen gudiinad,","poem":2},{"lineBreak":true},{"text":"emide, ¿ar bia wemarde danimarsunna?’ ”","poem":2}]},{"type":"verse","number":22,"content":["Bab-Jehová-Bur-Biriginedi weyob soged:",{"text":"“Dulemar-yar-baid-baidgi-bukmaladga an igar ukoed,","poem":1},{"text":"neggwebur-bukmaladsik an-bander an onakoed,","poem":2},{"text":"adi, wemar, e-sakwagi-mai bega be-mimmigan-sedamalagar,","poem":1},{"text":"degi, e-gukingi-mai bega be-bunamala-sedamarbaligar.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Reymar e-mimmiganga be-imakmaloed,","poem":1},{"text":"degi, rey-omegan be-nanga gumaloed.","poem":2},{"text":"Be-asabinni, dulluu napase imakmaloed.","poem":1},{"text":"Degi, maligi ukub-naile, bega elimaloed.","poem":2},{"text":"Geb agi, be wisgumaloed, ani an Bab-Jehová gued.","poem":1},{"text":"Dule-angi-bensurmaladi, bingedar itogosurmalad.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Dule-bila-onomalad bila-onogedgi-ibmar-susadi, ¿sunna e-ibe be susi? Geg gue.","poem":1},{"text":"Dule-galesadi, ¿sunna dule-isgana-e-gasadgi wakinnosi? Suli.","poem":2}]},{"type":"verse","number":25,"content":["Degi-inigwele, Bab-Jehová weyob soged:",{"text":"“Dule-bila-onoged bila-onogedgi-ibmar-susadi, e-ibe sulegoed.","poem":1},{"text":"Deginbali, dule-isgana dule-gasa-sesadi, gannar e-annik sulegoed.","poem":2},{"text":"Ar andi, dule-begi-urwedimaladgi an be-bendakoed.","poem":1},{"text":"An-sunnagwadi, an be-mimmigan bendakoed.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Be-isdarmalad na dukin e-san-gunmalaga an imakoed.","poem":1},{"text":"Vino-gobeyobi, na dukin e-ablisgi-mumgumalaga an imakbaloed.","poem":2},{"text":"Degisoggu, bela dulemar wisgumaloed, ani an Bab-Jehová gued.","poem":1},{"text":"Ani an be-Abonogedid.","poem":2},{"text":"Ani an Jacob-waganga dule-gandikid gued.","poem":1},{"text":"Ani an be-bendakedid.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/48.json","previousChapterAudioLinks":{},"numberOfVerses":26}