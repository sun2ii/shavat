{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":5,"content":[{"type":"heading","content":["Uva-nainugi burbar-namakleged"]},{"type":"verse","number":1,"content":[{"text":"An-ai-nued-nuggi an namakoed,","poem":1},{"text":"e-uva-nainugi an namakoed.","poem":2},{"text":"An-ai-nued-e-uva napa-nuedgi digar naigusad.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Na napa nudaksagusad, akwa-murugan obelosgusad.","poem":2},{"lineBreak":true},{"text":"Uva-dub-sailagan-nuegan digsagusad.","poem":2},{"text":"Nainu-abargine neg-suid sobsagusad,","poem":1},{"text":"uva-egured-galu sobsagusbalid.","poem":2},{"text":"Uva-san-nuegan-ega-sanmaked abedii gusanad,","poem":1},{"text":"aka ega uva-soledbi sanmaksad.","poem":2}]},{"type":"verse","number":3,"content":["Bab-Jehová soged:",{"text":"“Judá-dulemar, Jerusalén-dulemar, be anga sogmardo.","poem":1},{"text":"Emide, uva-soledbi-sanmaksadi, ¿wede doagine?","poem":2},{"lineBreak":true},{"text":"¿Angine? ¿Uva-nainugine?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"¿Ar ibu-ibmar an-uva-nainuga an imaksasuli?","poem":1},{"text":"¿Ibu-ibmar bar an ega imakosunna?","poem":2},{"text":"Ar uva-san-nuegan-anga-sanmaked an abesanad.","poem":1},{"text":"Ar degite, ¿ibiga uva-san-soled sanmaksasunna?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"An bega sogmalodo, igi an-uva-nainu an imakoe:","poem":1},{"text":"An e-ibe galu-emakaled earoed, adi, bela berguegar.","poem":2},{"text":"An e-galu-matusulid e-ibe earbaloed,","poem":1},{"text":"adi, bela egi annalegegar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bela swanga-nai an imakoed,","poem":1},{"text":"bar uva-dub diglegosulid,","poem":2},{"lineBreak":true},{"text":"bar nuekwaa emilegosulid.","poem":2},{"text":"Ikomarbi, degi, gagan-ikobimaladbi ainidagoed,","poem":1},{"text":"bar mogirmar egi dii-owiega an imakosulid.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Israel-dulemar Bab-Jehová-Bela-Gangued-Nikad-e-uva-nainu gued.","poem":1},{"text":"Judá-machergandi ega uva-yeerdakle-digaledga gued.","poem":2},{"text":"Bab-Jehová Israel-dulemar ega igar-innikigwad-imaked edarbediinad,","poem":1},{"text":"emide dakalid, unnila dule-ablis-eodimaladbi gudimala.","poem":2},{"text":"Bab-Jehová, ega igar-napiragwadba-nanaed edarbediinad,","poem":1},{"text":"emide dakalid, unnila suli-suli-itogedba binnasuli gormakdimala.","poem":2}]},{"type":"heading","content":["Dule-wiodimalad ukabsalesad"]},{"type":"verse","number":8,"content":[{"text":"Dulemar emar-idu neg-sobe-sobe-gudimalad, ¡dule-wilesmar!","poem":1},{"text":"Emar-ibe nainu-sue-sue-gudimalad, ¡be duledar-wilesmar!","poem":2},{"text":"Dule-bamaladga wis napaneg-ollogwad nasiksulid.","poem":1},{"text":"Na wargwen we-neggweburgi-gudimaladyob itoged.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Jehová-Bela-Gangued-Nikad weyob an-uayagwar anga ibmar-sogsad:","poem":1},{"text":"“Negamar-bukidara obelolegoed.","poem":2},{"lineBreak":true},{"text":"Neg-dummagangi, neg-yeerdaklegedgi, dule gwen megosulid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Uva-nainu-dummagan sogapaa naidi,","poem":1},{"text":"unnila bari-gwagwen wis vino egi amilegoed.","poem":2},{"text":"Ibmar-gwag galón-gwaambe-diglegoedgi (10),","poem":1},{"text":"unnila galón-gwagwen wis egi welegoed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dulemar wakudaryalaba-mumguega-gwisguardamaladi, ¡duledar-wilesmar!","poem":1},{"text":"Mumgusii mutikguddamaladi, ¡be duledar-wilesmar!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Be-iba-onomaladgi vino-bukidar nikadamalad,","poem":1},{"text":"gar-arpaʼmar ogorleddaed,","poem":2},{"lineBreak":true},{"text":"degi, gar-liraʼmar, damborʼmar,","poem":2},{"lineBreak":true},{"text":"degine, gar-flautaʼmar ogorleddaed.","poem":2},{"text":"Degi-inigwele, bemar Bab-Jehová-ibmar-imaksadgindi, binsadasurmalad,","poem":1},{"text":"e-ibmar-saedginbela bar binsadasurbalid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"An-dulamar an-itobisurmalad-ulale, gales seledmaloed.","poem":1},{"text":"E-dule-nuga-nikamalad mas-gunsulidba burgwidmaloed,","poem":2},{"lineBreak":true},{"text":"dule-bukidar gobsulidba burgwidmaloed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"A-ulale, burgwarmalad-meged-galu-e-yaa sabsur-argas maid.","poem":1},{"text":"Agine, dule-nuga-nikamalad, e-mumguedgi-yeer-itodimalad, neg-uanse doledmaloed.","poem":2},{"lineBreak":true},{"text":"Dule-binsarmalad, e-isguedgi-wergudimaladba neg-uanse doledmaloed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Dulemar sabsur-ibitomaloed, emarse ibmarbina-wiledii gudmaloed.","poem":1},{"text":"Dule-san-dummarba-imakdimalad, binge itodmaloed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ar Bab-Jehová-Bela-Gangued-Nikadi igar-innikigwadba e-nug ogannolegoed,","poem":1},{"text":"Bab-Dummad-Isligwaled igar-napiragwadba na san-swilidikid oyogoed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sibad-wawaad-senigana, e-nainu-sunnadyobi, egi gagan-ara-aramalad-madii gudmaloed.","poem":1},{"text":"Sibad-omemardi, dule-mani-ibmala-e-neg-ollo-ollo-bukmaladgi gagan-madii gudmaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Dule isguedse-ebipiledimalad, ¡duledar-wilesmarsun!","poem":1},{"text":"Dule urdubgi-isgued-ebipidimalayob-gudidiid, ¡be dule-wilesmar!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Na sogdimalad: “Bab-Dummad gwae dagye.","poem":1},{"text":"Gwae ibmar imakdaye, adi, anmar e-ibmar-imakoed dakegarye.","poem":2},{"text":"Israel-dulemar-e-Bab-Isligwaled e-ibmar-imakbied gwae imakdaye,","poem":1},{"text":"adi, anmar e-ibmar-imakoed wisguegarye.”","poem":2},{"text":"Deyob-sogdidiid, ¡duledar-wilesmarsun!","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dulemar, igar-isgana igar-nueganga-imakdidiidi, ¡duledar-wilesmar!","poem":1},{"text":"Dulemar, igar-nuegan igar-isganaga-imakdimaladi, ¡dule-wilesmar!","poem":2},{"text":"Dulemar, negsichid neg-meegwadga-imakdimaladi, ¡duledar-wilesmar!","poem":1},{"text":"Neg-meegwaddi, negsichidga-imakdimaladi, ¡dule-wilesmar!","poem":2},{"text":"Dulemar, ibmar-gagbireged ochigwadga-imakdimaladi, ¡duledar-wilesmar!","poem":1},{"text":"Dulemar, ibmar-ochigwad gagbiregedga-imakdimaladi, ¡dule-wilesmar!","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Dule, binsaed-ibedga na san-sadimaladi, ¡duledar-wilesmar!","poem":1},{"text":"Dule, nue-ibmar-wisidga na san-imakdimaladi, ¡dule-wilesmar!","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Bemar vino-gobedsik-bulegan-gudimaladi, ¡be duledar-wilesmar!","poem":1},{"text":"Bemar inna-gagbid-sobedsik-bulegan-sogdimaladi, ¡dule-wilesmar!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bemar dule-baiganse-manigi-baklegar, dule-ibmar-isgana-imaksad-galessiid-onodamaladi, ¡duledar-wilesmar!","poem":1},{"text":"Bemar dule-ibmar-oakalossulid-obanagwar-imakdimaladi, ¡dule-wilesmar!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"A-ulale, igi-soo-ditismaked gagan-ogumakdedae,","poem":1},{"text":"igi-gagan-dinnagwad soo-abin gummakdedae,","poem":2},{"lineBreak":true},{"text":"deyobi, bemar gummakmaloed.","poem":2},{"text":"Igi sapi-mali napa-urba-nunguddae,","poem":1},{"text":"igi e-dutu, ukub-miledeyob-mileddae,","poem":2},{"lineBreak":true},{"text":"deyob bemar berguoed.","poem":2},{"lineBreak":true},{"text":"Ar bemar, Bab-Jehová-Bela-Gangued-Nikad-Maid-e-Igar obatemalad,","poem":1},{"text":"Israel-e-Bab-Jehová-Isligwaled-e-gayaburba isdar-itodmalad.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"A-ulale, Bab-Jehová e-dulemarse sabsur-urwed,","poem":1},{"text":"a-ulale, sabsur-odurdaked, yalagan ese giglimaked.","poem":2},{"lineBreak":true},{"text":"Muigan, durgan-milegeyob, galimbaba omileded.","poem":2},{"lineBreak":true},{"text":"Deyob-imaksa-inigwele, Bab-Jehová, amba sae-itomaid,","poem":1},{"text":"amba dulemar-sabsur-odurdakmaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Bab-Jehováʼdi, dulemar-yar-baid-baidgi-dikasur-bukwadse-golegala, bander onakoed.","poem":1},{"text":"Bela yar-naidgi-bukwamaladse wigooed,","poem":2},{"lineBreak":true},{"text":"we-dulemar gwae-gwae abarmakar-abarmakar nonimaloed.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"We-dulemar, dutusurmalad, gwen yeguosurmalad.","poem":1},{"text":"Unnila, guagwar gudii gumaloed, gwen gabbie itogosurmalad.","poem":2},{"text":"E-musirba-mor-atinnaimalad gwen ei achikosulid.","poem":1},{"text":"Nag-uka-e-dubmar e-ibe gwen itirosurbalid.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"E-sigumar ise-swiswidikidbioed,","poem":1},{"text":"e-warsimar bela gachii ganikidbimaloed.","poem":2},{"text":"E-molimar-e-sapat akwayobi dutusulidbioed,","poem":1},{"text":"e-moli-ur-bila-onomalad-e-yandamar burwa-bipirmakaledyobi guoed.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Sorda-bila-onomalad-e-goledi, achumigur-nono-wawaadyob goledbioed.","poem":1},{"text":"Achumigur-nono-wawaad-e-mimmigan-uurmakeyobmaloed,","poem":2},{"text":"e-nugar ogotemaloed.","poem":1},{"text":"Dule ese-galesale, dule gwen egi suosulid.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"A-ibagangine, we-dulemar Israel-dulemargi demar-dummad-arwemaiyobi gwichigunonikoed.","poem":1},{"text":"Dule, Israel-yar-naid-dakalile, bela negsichidbi-nai dakdagoed,","poem":2},{"lineBreak":true},{"text":"dad-ibeler-idu mogir-sichid nai guoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/4.json","previousChapterAudioLinks":{},"numberOfVerses":30}