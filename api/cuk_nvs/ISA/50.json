{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":50,"content":[{"type":"heading","content":["Bab-Jehová dulemar-egi-bensulid bendaked"]},{"type":"verse","number":1,"content":["Bab-Jehová weyob soged:",{"text":"“Israel-dulemar, ¿an bemar-nan obachasi?","poem":1},{"text":"Degite, ¿bia abirgin-meted-gardade nadsunna? Anga be oyodo.","poem":2},{"text":"¿An doa-dulemarga bemar-egi-mani-ganikidyobi an be-uksamarsunna?","poem":1},{"text":"An deyob be-uksasurmalad.","poem":2},{"text":"Ar be-isgued-ular, na be dukin uksamalad.","poem":1},{"text":"Bemar uaya-sate-gusad-ulale, be-nan oballedsunnad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"An nonigua, ¿ibiga dule-sate an daknonisunna?","poem":1},{"text":"An gotegua, ¿ibiga dule gwen an-abin-imaksasursunna?","poem":2},{"text":"¿Ar bemar-bendakosurye, be angi binsamala?","poem":1},{"text":"¿An bemar-onogega, garganguedsuli be an-dakmala?","poem":2},{"text":"Ar an sunna, demar, ilagwensaale dinna saed.","poem":1},{"text":"Ar an sunna, diwarmar, nega-dulesulidga-nai imaked.","poem":2},{"text":"Uamar e-mas-satedba burgwideled.","poem":1},{"text":"Dii-dingudedba uamar bela nungudeled.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"An sunna mogir-billi nega-gubyagwaledbi-nai an imaked,","poem":1},{"text":"mor-sichid-naidyobi an imaked.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová binsaed-ibegan-sunmaked-gwabinduku anga uksad,","poem":1},{"text":"adi, dulemar-geggus-gudimalad-e-gwage gadi-gadi-imakegar.","poem":2},{"text":"Bab-Dummad bane-bane wakudaryalabali an-odaked,","poem":1},{"text":"ibmar-itogega an-imaked,","poem":2},{"lineBreak":true},{"text":"adi, dule-ibmar-durdaknaidyobi an ibmar durdakegar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová ibmar-magar-itogega an-imaksad,","poem":1},{"text":"an eba uayasuli gussulid,","poem":2},{"lineBreak":true},{"text":"an eba ibsassuli gwen gussulid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dulemar-an-bibyonanaidga an-yargan an oyosad.","poem":1},{"text":"Dulemar-an-siga-sabsur-ungemaladgi, an-aku an gwen odukussulid.","poem":2},{"lineBreak":true},{"text":"Degine, dule-angi-dodomaladgi, degi, angi-wiakmaladgi, an-wagar an gwen odukussulid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ar Bab-Jehová-Bur-Birigined an-bendaked,","poem":1},{"text":"degisoggu, mesagwar-imaklenaidgi an bai itossulid.","poem":2},{"text":"A-ulale, akwasailayob an na gandik imaksad.","poem":1},{"text":"Ar an wisid, an bingeguosulid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dule-an-irwa-gwisguedi, an-nagaba gudiid.","poem":1},{"text":"¿Degisoggu, doa anbo gala-itobie?","poem":2},{"text":"Dule anbo-gala-itobiele, ¡anse dagdo!","poem":1},{"text":"Dule angi gwisgubiele, ¡anga ibmar sogdado!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"¡Ar Bab-Jehová-Bur-Birigined an-bendakdaed!","poem":1},{"text":"¿Doa sabsur-odurdakleged-igar anga mesosunna?","poem":2},{"text":"Ar an-isdarmaladdi, ilagwen-berguar gudoed,","poem":1},{"text":"igi mor suuse-gulledae, deyobi namaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"¿Doa bemar-abargi Bab-Jehová-dobee gudii?","poem":1},{"text":"¿Doa Bab-e-mai-sogedba nanadii? Dule sated.","poem":2},{"text":"Dule-negasichidba-nanadiidi, neg-meegwadba-nanadisulidi, a-dule, Bab-Jehováʼgi bensuli guoed,","poem":1},{"text":"e-Bab-Dummadgi alakwaa naguoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar bemar na soo ogadamalad,","poem":1},{"text":"na be gwinnur ogadamarbalid.","poem":2},{"text":"Bemar na be soo-ogadamaladgi be nanabukmalad,","poem":1},{"text":"na be gwinnur-ogadamaladgi be nanabukmalad.","poem":2},{"text":"Degi-inigwele, an we-ibmarmargi sabsur-bemar-odurdakoed:","poem":1},{"text":"Igar-bulegangi be sabsur-odurdaklemaloed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":11}