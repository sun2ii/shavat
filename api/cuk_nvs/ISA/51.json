{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":51,"content":[{"type":"heading","content":["Sión-yala-abonolegoed"]},{"type":"verse","number":1,"content":["Bab-Dummad weyob soged:",{"text":"“Bemar, igar-innikigwadba-nanadimalad, be an-amidimalad, be an-itomar:","poem":1},{"text":"Bemar, dad-Abraham-wagan gumalad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Be nue-dakmar,","poem":1},{"text":"ar dad-Abraham bemar dad-dummadid,","poem":2},{"lineBreak":true},{"text":"degi, muu-Sara bemar-urbisadid.","poem":2},{"text":"An Abrahamʼse gochagua, na sana-walagwen gudiinad.","poem":1},{"text":"Degi-inigwele, an egi nued binsasad,","poem":2},{"lineBreak":true},{"text":"an ega dula omelosad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ani Bab-Jehová, Sión-yala wiledakedsegad.","poem":1},{"text":"Bela e-neg-bibichismaladi, wiledakoed.","poem":2},{"text":"E-nega-dulesulidgan Edénʼgi-nainu-nued-naigusayobi, imakoed.","poem":1},{"text":"E-nainu-geg-ibmar-egi-sanmakedi, an-nainuga guoed.","poem":2},{"text":"A-nainugine weligwar-itomaloed, egi wergumaloed.","poem":1},{"text":"Anga namaklegedgi namakmaloed,","poem":2},{"lineBreak":true},{"text":"dog-nuedye anga sogmaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"”An-dulamar, nue be an-itomar.","poem":1},{"text":"An-neggweburmar, nue be an-itomar:","poem":2},{"text":"Ar ani an ibmargi-odurdakleged-igar onioed,","poem":1},{"text":"an-igar-napiragwadi, dulemar-yar-baid-baidgi-bukmaladga neg-meegwadga guoed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"An-igar-naboged, bato walik-gusad.","poem":1},{"text":"An-abonoleged-igar bato igarba abarmakdanikid.","poem":2},{"text":"An-ganguedi, dule-yar-baid-baidgi-bukmaladga igar nabogoed.","poem":1},{"text":"Dule-demar-gakaba-bukmaladi, angi bensurmalad,","poem":2},{"lineBreak":true},{"text":"an-ganguedgi, bendakleged abdakmalad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Niba be atakmar,","poem":1},{"text":"napneggi be atakmarbar.","poem":2},{"text":"Waa-berguddaedyobi, mogir-billi bergudoed,","poem":1},{"text":"mor-nunguddaedyobi napneg nungudoed.","poem":2},{"text":"Gukur-burgweyobi, e-dulemar burgwidoed.","poem":1},{"text":"Degi-inigwele, an-abonogeddi, degisadegu maiguoed.","poem":2},{"lineBreak":true},{"text":"Degi, an-igar-napiragwaddi, noargumai gwen guosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"”Bemar, igar-napiragwad-wismalad, be an-itomar.","poem":1},{"text":"Gwagegi-an-igar-sedidimalad, be an-itomar.","poem":2},{"text":"Dulemar-begi-ichakwa-sunmakedi, melle be dobgumalo,","poem":1},{"text":"sabsur-e-ibmar-sogedgi, melle be niga argwanmalo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ar we-dulemar unnila mor suuse-gulledaedyob gumaloed,","poem":1},{"text":"mor-wawaad nusmarse-gulledaedyob gumaloed.","poem":2},{"text":"Ar an-igar-napiragwaddi, degisadegu maiguoed,","poem":1},{"text":"an-abonoged-igardi, maigu guoed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bab-Jehová, ¡be atake! ¡Be atake!","poem":1},{"text":"¡Gandikid-mola be yoe!","poem":2},{"text":"Epenne be-gangued be-dulamarga-be-oyosayob be oyoge.","poem":1},{"text":"¿Ar bee be, Rahab-obelossursi?","poem":2},{"lineBreak":true},{"text":"¿Ar bee be, ibdula-demargined obelossursi?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"¿Ar bee be, demar-odinnosgussursi?","poem":1},{"text":"¿Ar bee be, a-dii-wilasailad odinnossursi?","poem":2},{"lineBreak":true},{"text":"¿Ar bee be, dule-bendaklesmalad-obakega demar-wilasailadgi igar-omesisgussursi?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Jehováʼgi-bendaklesmalad gannar nonimaloed,","poem":1},{"text":"weligwaledgi namakagwale Sión-yalase dognonimaloed.","poem":2},{"text":"Weligwar-itodiidi, magasar na e-wagargi oyomaloed.","poem":1},{"text":"Wergudii gumaloed,","poem":2},{"text":"na yeer itomaloed.","poem":1},{"text":"Bukib-binsadiidi, gwage-nunmak-itodiidi, bela bergudoed.","poem":2}]},{"type":"verse","number":12,"content":["Bab-Jehová weyob soged:",{"text":"“Ani an bemar-gwage baisur-itoge imakedid.","poem":1},{"text":"¿Ar ibiga be dulemar-dobe?","poem":2},{"lineBreak":true},{"text":"Ar wemardi, unnila gagan-durganyob gumalad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"¿Bab-Jehová-be-obinnisad be iesde?","poem":1},{"text":"¿Bab-Jehová-mogir-billi-nasiksad bato be iesde?","poem":2},{"text":"¿Bab-Dummad-napneg-nasiksad bato be iesde?","poem":1},{"text":"¿Bane-bane be-isdarad-be-obelobi-gudiidgi be gwayedii guode? ¡Adi surbali!","poem":2},{"lineBreak":true},{"text":"¿Sabsur-dule-odurdakdiid-e-urwedde, bia nadsunna?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dulemar-esgaryagi-gales-bukmaladi, emiskwaa onolemaloed.","poem":1},{"text":"Esgaryagi burgosurmalad, gwen ega mas galakuosurmalad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ani an be-Bab-Dummad-Jehová gued.","poem":1},{"text":"Ani an demar-osukamakedid,","poem":2},{"text":"ani an demar-uurmakega imakedid.","poem":1},{"text":"Bab-Jehová-Bela-Gangued-Nikadye an nugad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Be-gwabindukugine, an-gayaburba an nasiksad.","poem":1},{"text":"An-ganguedbali an be-anar gwisgusad.","poem":2},{"text":"Ani an mogir-billi nasiksad,","poem":1},{"text":"ani an napneg nasiksad.","poem":2},{"text":"Degine, Sión-yalagi-bukmaladga an weyob sogsad:","poem":1},{"text":"‘Be an-dulamar guye.’ ”","poem":2}]},{"type":"heading","content":["Bab-Dummad-e-urwed"]},{"type":"verse","number":17,"content":[{"text":"¡Jerusalén-dulemar! Be gwisgumar, be gwisgumar.","poem":1},{"text":"Bab-Dummad-e-urwed be itosad.","poem":2},{"text":"Be bela-belad ulubse surbinsa-itoge be gusad,","poem":1},{"text":"geg bar be gwisgu gusad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bela be mimmigan-nikusadi, gwen wargwensaale, be-idugega gussulid.","poem":1},{"text":"Bela be mimmigan-odummosadi, bipisaale, gwen argangi be-gassulid.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"We-bonigan-sogbogwad begi nonigusad:","poem":1},{"text":"Be-neggwebur bibichisgusad,","poem":2},{"lineBreak":true},{"text":"degi, be-neggwebur obelolesgusad.","poem":2},{"text":"Ukudba be gala-itosgusad,","poem":1},{"text":"es-suidgi oburgwilesgusad.","poem":2},{"text":"¿Doa wile be-dakoe?","poem":1},{"text":"¿Doa be-gwage baisur-itoge imakoe?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Be-mimmigan galakusmalad.","poem":1},{"text":"Goe-sapur-bebe-suid sakigi-galesnaidaeyob gusmalad,","poem":2},{"lineBreak":true},{"text":"galimba-dikarba mellemamaid.","poem":2},{"text":"Egine, bela Bab-Jehová-e-urwedi gwichigusad,","poem":1},{"text":"bela be-Bab-Dummad-urwedi egi gwichigusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Emisgindi, dule-bukib-binsadiid, vino-gobedginsuli be mummu-gudiid.","poem":1},{"text":"An-bega-ibmar-sogoed be ito.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Be-Bab-Dummad-Jehová-Bur-Birigined, e-dulemar-ular-sunmakedi, weyobi soged:","poem":1},{"text":"“An-urwedgi an sabsur-bemar-odurdaksad an obelosad.","poem":2},{"lineBreak":true},{"text":"We-an-urwedi bipisaale bar be itogosulid.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Dulemar-sabsur-be-odurdakdimalad an odurdakoed.","poem":1},{"text":"Ar we-dulemar bega weyob sogsa gusmalad:","poem":2},{"text":"‘Napagi balimellemai be imakmarye,","poem":1},{"text":"adi, anmar begi annamalagarye.’","poem":2},{"text":"Ar deyob be imaksa gusmalad,","poem":1},{"text":"ega napagi mellemai be gusmalad,","poem":2},{"lineBreak":true},{"text":"bela dulemar be-birgi annas gusmalad.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":23}