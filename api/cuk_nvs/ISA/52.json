{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":52,"content":[{"type":"heading","content":["Bab-Dummad Sión-dulemar-ollor-imaksad"]},{"type":"verse","number":1,"content":[{"text":"Sión-dorgan, ¡be atake! ¡Be atake!","poem":1},{"text":"¡Gandikid-mola be yoe!","poem":2},{"text":"Neggwebur-islidikid-Jerusalén, be-mor-gargerbamalad be yoe.","poem":1},{"text":"Ar dule-abgan-uka-duku-sikarsurmaladi, degi, dule-Bab-Dummad-wissurmaladi, bar bemarse dogosurmalad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"¡Jerusalén-neggwebur, be gwichigue!","poem":1},{"text":"¡Olli be obate!","poem":2},{"text":"¡Gannar ologanagi be sige!","poem":1},{"text":"Sión-yala-sisgwa, be galesgua, dukargi-esgoro-dub-nasiklesad be unge.","poem":2}]},{"type":"verse","number":3,"content":["Ar Bab-Jehová weyob soged:",{"text":"“Bemar manigi be uklessulid,","poem":1},{"text":"bemar manigi be onolegosurbalid.","poem":2},{"lineBreak":true},{"text":"Bemar binsa-onolegoed.”","poem":2}]},{"type":"verse","number":4,"content":["Ar Bab-Dummad-Bur-Birigined-Jehová weyob soged:",{"text":"“Epenne an-dulamar, Egipto-yalase nadegusad.","poem":1},{"text":"Agine, na megisgusmalad.","poem":2},{"lineBreak":true},{"text":"Emide, Asiria-sordamar binsarsunna an-dulemar-mesagwar imakalid.”","poem":2}]},{"type":"verse","number":5,"content":["Emide, Bab-Jehová soged:",{"text":"“¿Ibi an wegi imakdii?","poem":1},{"text":"Ar binsarsunna, an-ibe an-dulamar-gasa sesmalad.","poem":2},{"text":"E-negsemamaid an-dulamargi dodomalad.","poem":1},{"text":"Bane-bane an-nuggi dododigudamalad, bogigudisurmalad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Degisoggu, a-ulale, a-ibagangine, an-dulamar an-nug wisgunonikoed.","poem":1},{"text":"A-ibagangine, ani an ega sunmaknaidi, an e-walik gwisgunonikoed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dule yar-imbaba-gayaburba-nued-sedanikidi, dule-gayaburba-bogidikid-berbegedi, ibiyobi yeer daklemala.","poem":1},{"text":"Dule gayaburba-nuegan-barsogedi, degine, dule abonoleged-igargi-sunmakedi, ibiyobi yeer daklemala.","poem":2},{"text":"Dule, Sión-dulemarga weyob-sogedi: “Be-Bab-Dummad negdakmaiye.”","poem":1},{"text":"Dule-deyob-sunmakmaladi, ibiyobi yeer daklemala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"¡Be itoge! Be-dule-nakulemalad binnasuli-gorbukmalad,","poem":1},{"text":"weligwaledbali gandikidba gorbukmalad.","poem":2},{"text":"Ar ade, na e-ibyagwale dakbukmalad,","poem":1},{"text":"Bab-Jehová gannar Sión-yalase daniki.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jerusalén-dulemar, na be bular-weligwar-namaklegedgi be namakmar.","poem":1},{"text":"Ar ade, Bab-Jehová e-dulemar-baisur-itogega imaksad,","poem":2},{"lineBreak":true},{"text":"degi, Jerusalén-neggwebur bendaksad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Jehová, bela dulemar-yar-baid-baidgi-bukmaladga e-gangued oyogoed.","poem":1},{"text":"Bela napneg-naid-ugakaase-bukmaladi, anmar-Bab-Dummad-e-abonoged dakmaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bemar, Babse-goled-neggi-ibmar-ebulemalad-semaladi, be nomar,","poem":1},{"text":"be agi ainimar.","poem":2},{"text":"¡E-dulemar-abargi-gudiidgi be nomar!","poem":1},{"text":"¡Be san-urukmar!","poem":2},{"lineBreak":true},{"text":"¡Melle ibmar-swilidiksulid be ebumalo!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Degi-inigwele, mer be gwae-gwae itomalo.","poem":1},{"text":"Mer be gwae-gwae-abarmakdemarbalo.","poem":2},{"text":"Ar Bab-Jehová bemar-idumai guoed.","poem":1},{"text":"Israel-e-Bab-Dummad be-sorba-nai guoed.","poem":2}]},{"type":"heading","content":["Bab-Jehová-e-mai-wilegoed"]},{"type":"verse","number":13,"content":["Bab-Jehová soged:",{"text":"“An-mai emargi nakoed.","poem":1},{"text":"E-nug odummolegoed, dule-dummadga guoed,","poem":2},{"lineBreak":true},{"text":"degi, ologanagi sigoed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dulemar dakdamalogu, bukidar geger-dakmaloed,","poem":1},{"text":"ar e-wagar-daklegedi bar aa daklegosulid,","poem":2},{"lineBreak":true},{"text":"ar e-daklegedi, bar dule-daklegosulid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Amba deyob dulemar-yar-baid-baidgi-bukmaladi, geger dakmarmogoed.","poem":1},{"text":"E-asabinni, reymar gwen-sunmakosurmalad,","poem":2},{"text":"ar weyob-ega-ibmar-soglessulid dakdamaloed,","poem":1},{"text":"degi, weyob-ibmar-itossurmalad na magar itononimaloed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}