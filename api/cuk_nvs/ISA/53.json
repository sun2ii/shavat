{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":[{"text":"¿Doa anmar-ibmar-sogsad bengussuli?","poem":1},{"text":"¿Doase Bab-Jehová na e-gangued oyosa?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová, e-mai sapi-e-nii-dutugwad-dungueyobi odummosad.","poem":1},{"text":"Sapi-e-mali napa-isganagi dogdedaeyobi, e-mai-odummosad.","poem":2},{"text":"E-mai yeer daklesulid,","poem":1},{"text":"gandik daklesurbalid.","poem":2},{"text":"E-daklegedi, wilubba dakleged.","poem":1},{"text":"Dulemar baisur-dakmalad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dulemarse obanagwale gusad.","poem":1},{"text":"Mesagwale gusad.","poem":2},{"text":"Gwage-nunmaked-itodii gusad.","poem":1},{"text":"Undar-odurdakledii gusad.","poem":2},{"text":"Dulemar gwen-dakbisuli gusmalad.","poem":1},{"text":"Dulemarse obanagwale gusad.","poem":2},{"lineBreak":true},{"text":"Gwen anmar bai daksasurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Degi-inigwele, anmarga anmar-bonigan sesad,","poem":1},{"text":"anmar-anar, anmar-nunmaked itosad.","poem":2},{"text":"Anmardi egi binsaed,","poem":1},{"text":"Bab-Dummad we-dule-naibi-imaksaye,","poem":2},{"text":"sabsur-imaksaye,","poem":1},{"text":"degi, mesagwar-imaksaye.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"E na, anmar-uaya-sated-ular, naibigusad.","poem":1},{"text":"E na, anmar-isgued-ular, bela-bela sabsur-bibyolesgusad.","poem":2},{"text":"Anmarga gwage-bogidikid-ukegala, anmar-ular, bela-bela sabsur-odurdaklesad.","poem":1},{"text":"Anmar e-naibigusadgi nugunonimalad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Anmar bela sibad-wawaad-yoggusgudidaedyobi, yoggus gudimalanad.","poem":1},{"text":"Na wala-walagwen e-itolegedba gudidimalanad.","poem":2},{"lineBreak":true},{"text":"Degi-inigwele, Bab-Jehová bela e-maigi anmar-isgued nasiksad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sabsur-imaklenaigu, mesagwar-imaklenaigu, gwen e-gaya itolessulid.","poem":1},{"text":"Igi-sibad-wawaad-senigwad e-oburgwilegedse selesdae, deyobi, gaya-itosuldgi selemai gusad.","poem":2},{"text":"Igi-sibad-wawaad ega-e-absar-siked-abin, gordasuli, deyobi, dulemar-asabin Bab-Jehová-e-mai gaya nikussulid,","poem":1},{"text":"degi, dulemar-asabin gwen gochasurbalid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gasmargua, ega igar-amismargua, oburgwismalad.","poem":1},{"text":"Gwen bai daksasurmalad,","poem":2},{"text":"e-bina sogsasurmalad.","poem":1},{"text":"E-wagan-danikoedgi gwen binsassurmalad.","poem":2},{"text":"Dulemar-bukwad-abargi gandikidgi onolesad,","poem":1},{"text":"an-dulamar-isgued-anar, oburgwilesad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gwen e-sunmakedgi emar-yardaksasur-inigwele,","poem":1},{"text":"gwen ibmar-isgana-imaksasur-inigwele,","poem":2},{"text":"dule-ibmar-isgana-imakmalad-abargi burgwisad,","poem":1},{"text":"degi-inigwele, mani-ibgan-abargi diglesad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ar Bab-Jehová, mesagwar-guega imaksad,","poem":1},{"text":"sabsur-wilegega imaksad.","poem":2},{"text":"E na dulemar-isgued-anar san-uksasoggu, a-ulale, na suitiba gudii guoed,","poem":1},{"text":"bela e-waganmar-dakoed,","poem":2},{"lineBreak":true},{"text":"Bab-Jehová-sogedba bela ibmar imakoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sabsur-wilegoed-sorbali, magar-daknonikoed,","poem":1},{"text":"e-sabsur-wilesadi, binsa wilessuli, degidbali na yeer-itononikoed.","poem":2},"Bab-Jehová soged:",{"text":"“An-mai-innikigwadi, e-ibmar-wisidbali, dulemarga igarmar nabogoed.","poem":1},{"text":"E na dule-ibmar-isgana-imaked sedoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"A-ulale, dule-dummagan-abargi an osimogoed,","poem":1},{"text":"e-ibmar-suoedi dule-gandikmaladbo mimioed.","poem":2},{"text":"Ar ade, na burgwegala, e-san uksad.","poem":1},{"text":"Dulemar-isgumaladyob imaklesmogad.","poem":2},{"text":"Dule-bukidarad-e-isgumalad na sesad,","poem":1},{"text":"dule-isgumalad-irwa gwisgusad.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/52.json","previousChapterAudioLinks":{},"numberOfVerses":12}