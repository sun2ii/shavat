{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":54,"content":[{"type":"heading","content":["Bab-Jehová Israel-dulemar-sabgumaiguad"]},{"type":"verse","number":1,"content":["Bab-Jehová sogded:",{"text":"“Be, omegwa-geg-baked, gwen be mimmi-nikudisulid, weligwaledba be binnasuli-gole.","poem":1},{"text":"Be, gwen-muu-neggi-boniba-galitodisulid, binnasuli be namake.","poem":2},{"text":"¡Weligwaledba be binnasuli-gole!","poem":1},{"text":"Ar ani Bab-Jehová soged: Ome-wilesagudiid, bur bule ome-sui-nikadba mimmigan nikuoye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"”Be-dordoneg-siidi, be odummo,","poem":1},{"text":"be-dordoneg-siidgi atued-dummagan-nanaid be egae.","poem":2},{"text":"¡Melle dobe-dobe be imako!","poem":1},{"text":"Dordoneg-e-dubamar be osugue,","poem":2},{"lineBreak":true},{"text":"e-dordoneg-bargamalad be ogannoge.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ar be-argan-nuedsiki, degi, be-argan-sapiledsiki be nasgudoed.","poem":1},{"text":"Be-wagana yar-baigan suoed,","poem":2},{"lineBreak":true},{"text":"be-wagana neggweburmar-olloganagi ambikudoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"”Melle be dobe-itogo,","poem":1},{"text":"ar be bingeguosulid.","poem":2},{"text":"Melle be gwayo,","poem":1},{"text":"ar be-nug mesagwar guosulid.","poem":2},{"text":"Be yagwaunni bingegusadi be iegoed.","poem":1},{"text":"Bei-machered-burgwisgu, bingedar be itosadgi bar be binsaosulid.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ar Bab-be-obinnisadi, be-suiga gued.","poem":1},{"text":"A nugad: “Bab-Jehová-Bela-Gangued-Nikadye.”","poem":2},{"text":"Be-bendakedi, Israel-dulamar-e-Bab-Dummad-Isligwaledid.","poem":1},{"text":"A bilegoed: “Bela-napneg-naid-e-Bab-Dummadye.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Be ome-wilesakwagudiidyob Bab-Jehová bese gornonikoed.","poem":1},{"text":"Ome-suli-suli-itodiidyob Bab-Jehová bese gornonikoed.","poem":2},{"text":"Igi ome dogdar yagwa-guedgi machered-nikusale, machered gannar metedae,","poem":1},{"text":"deyob gudiidgi Bab-Dummad bese gornonikoed.","poem":2}]},{"type":"verse","number":7,"content":["Bab-Jehová-be-ollor-imakedi soged:",{"text":"“Unnila sikwas an be-obachad.","poem":1},{"text":"Degi-inigwele, na bela-belad ulubgi wile-be-dakedgi gannar an be-abingaoed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Unnila sikwas-sae-itogedgine, an be-idu bangusad.","poem":1},{"text":"Degi-inigwele, sabgued-degisadeguad-nikadgine, an wile be-dakoed.”","poem":2}]},{"type":"verse","number":9,"content":["Bab-Dummad sogdebalid:",{"text":"“Angardi Noé-ibaganyobi gued,","poem":1},{"text":"igi an Noéʼga ise-sogar sogsa gusa, muu-dummad bar napneggi murosurye.","poem":2},{"text":"Deyobi, an bega ise-sogar soged, bar an bebo urwosulid,","poem":1},{"text":"bar an iisedi bega ibmar sogosulid.”","poem":2}]},{"type":"verse","number":10,"content":["Bab-Jehová-wile-be-dakedi soged:",{"text":"“Amba yalamar-bukwad baidsik ainirye-sogele, degi, yar-mullugana giglimakdele, andi amba an be-sabedi gwen gwagosulid.","poem":1},{"text":"Anbo be igar-bogidikid-omesisadi, andi obelogosulid.”","poem":2}]},{"type":"verse","number":11,"content":["Bab-Jehová-soged:",{"text":"“¡Be dake! Neggwebur-nue-wilesagwa, burwa-dummadba oitolesad.","poem":1},{"text":"Dule a-neggwebur baisur-itogega-imaked sated.","poem":2},{"text":"¡Akwa-nuegan-yeerdaklemaladgi an be-soboed!","poem":1},{"text":"Akwamar-zafiros-birgi an be-sioed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Be-galu-matusulid-birgine, an akwa-rubí-nuegan e-bargaedga mesoed.","poem":1},{"text":"Be-yawagakmar akwa-gargemalad-gaemaladgi an soboed.","poem":2},{"lineBreak":true},{"text":"Degi, bela be-galu-matusurmalad, akwa-gargemaladgi an soboed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ani Bab-Jehová, bela be-mimmigan odurdakoed,","poem":1},{"text":"be-mimmigan gwage-bogidikid nika gudii guoed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Igar-napiragwadi gannarbaa an be-imakoed.","poem":1},{"text":"Mesagwar-gudii bar be itogosulid.","poem":2},{"text":"Bali dobee be itogosulid.","poem":1},{"text":"Begine, gwayed-dummadi bangudoed, gwen be-walikaa guosulid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Dule begi gwichigualile, an eba-nai guosulid,","poem":1},{"text":"dulemar-yogasaar begi gwichiguarmalale, bese galakudmaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"”Ani an dule-esgoro-sobed-soo-oduurmakedi obinnisad.","poem":1},{"text":"We-dule, na bilagi-ibmar-ebulemalad sobed.","poem":2},{"text":"Ani an dule-emar-obeloged obinnisbalid,","poem":1},{"text":"adi, bela dule-obelogegar.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dule begi-nakwega, bila-onogedgi-ibmar-ebuleged-yeer-ganguedi, gwen begi obinosulid.","poem":1},{"text":"Dulemar begi yogasaar-sunmakmaladi, boo-sigega be imakoed.","poem":2},{"text":"We-ibmarmala anga-arbadimaladga an ukoed.","poem":1},{"text":"Angine, igar-innikigwad danikid.”","poem":2},"Deyobi, Bab-Jehová soged."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}