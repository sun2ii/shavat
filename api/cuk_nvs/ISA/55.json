{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":55,"content":[{"type":"heading","content":["Bab-Dummad wiledaked ukmaid"]},{"type":"verse","number":1,"content":["Bab-Jehová sogbalid:",{"text":"“¡Dule-uku-uku-itodimaladi, dii gobdamar!","poem":1},{"text":"Dule-mani-surmaladi, ibmar-sudamar,","poem":2},{"text":"vino be sudamar,","poem":1},{"text":"moli-nunis be sudamar.","poem":2},{"text":"Gwen be bennukosulid,","poem":1},{"text":"binsa bega uklegoed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"¿Ar ibiga be binsarsunna mas-nuedsulidgi be mani-oesunna?","poem":1},{"text":"¿Ar ibiga binsarsunna be ibmar-yeer-ito-be-imaksulidgi mani-misunna?","poem":2},{"text":"Be nue an-itomar,","poem":1},{"text":"bur be mas-nued gunmar,","poem":2},{"lineBreak":true},{"text":"ar be mas-nuegan-gullegedgi na be yeer itomaloed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nue be bogi itomar,","poem":1},{"text":"be anse dagmar.","poem":2},{"text":"Be nue an-itomar,","poem":1},{"text":"adi, be dula gudii gumaloed.","poem":2},{"text":"An bemar-ebo degisadegu igar mesoed,","poem":1},{"text":"adi, an-mai-David-sabedba an-ega-ibmar-sogsa-gusadba guegar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dulemargala, we-David, an-barsogega an nug-imaksad,","poem":1},{"text":"degi, dule-yar-bamaladga-e-odurdaked-sailaga-guega an nug-imaksad,","poem":2},{"lineBreak":true},{"text":"degine, dummadga an nug-imaksad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Israel-dulemar, dulemar-dakdisurmaladbina be goloed,","poem":1},{"text":"degi, dule-aku-be-dakdimarmogadi, bese abarmakdanimaloed.","poem":2},{"lineBreak":true},{"text":"Ar ani an be-Bab-Dummad-Jehová Israel-dulemar-e-Bab-Dummad-Isligwaled, be-nug odummosad.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bab-Jehová be amimar,","poem":1},{"text":"ar emisgwa, Bab-Dummad amilegedgined,","poem":2},{"text":"Bab-Dummadse be gormar,","poem":1},{"text":"ar ade, be-walikaa gudiid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dule-ibmar-isgana-imaked, e-igar-isgana-imakedgi bangusun,","poem":1},{"text":"dule-isgana, e-binsaed-isganagi bangusun.","poem":2},{"text":"Bab-Jehová amisun,","poem":1},{"text":"ar ade, Bab-Jehová dule-nuedid, isgued-eliedid.","poem":2},{"lineBreak":true},{"text":"Ar anmar-Bab-Dummad wile be-dakoed.","poem":2}]},{"type":"verse","number":8,"content":["Bab-Jehová soged:",{"text":"“An-binsaedi, bemar-binsaedyobsulid,","poem":1},{"text":"an-daedi, bemar-daedyobsulid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Igi mogir, napneggi dikasur nai,","poem":1},{"text":"deyobi, an-daedi, bemar-daedba bur-dikasur-akalad.","poem":2},{"lineBreak":true},{"text":"Deginbali, deyobi an-binsaedi, bemar-binsaedba bur-dikasur-akarbalid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ar dii-wiedi, degi, dambed-sibudikid-batedi, ibmar-imaksasuli geg gannar ainakwedaed.","poem":1},{"text":"Bina we-ibmar imakgwelergebed:","poem":2},{"text":"Napa-owardikuergebed,","poem":1},{"text":"napagi-ibmar-oniergebed,","poem":2},{"text":"ibmar-gwag-osanmakergebed,","poem":1},{"text":"adi, dule-ibmar-digedga, ibmar-gwag-ukega,","poem":2},{"lineBreak":true},{"text":"degine, dulega masgunned ukegarbar,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"deyobi, gayaburba an-gayagi nodele:","poem":1},{"text":"Anse ollobi nonikosulid,","poem":2},{"text":"an-ibmar-abegedba ibmar saoed,","poem":1},{"text":"an-ibmar-sogedba ibmar imakoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bemar weligwaledba ainidmaloed,","poem":1},{"text":"bogidikidgi gannar be-yalase be momaloed.","poem":2},{"text":"Be-nadapidbali yalamar, degi, yar-mullugan, binnasuli-weligwaledba namakdemaloed.","poem":1},{"text":"Degi, bela sapimar-bukwadi, argan ogotemaloed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gagan-ikobimalad-muchubbi, ciprés-sapimar ainidagoed.","poem":1},{"text":"Dakemar-muchubbi, mirto-sapimar dungudagoed.","poem":2},{"text":"We-ibmarmala, ani an-Bab-Jehová-nug ogannogoed,","poem":1},{"text":"we-ibmarmala, degisadegu e-wilubga naiguoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}