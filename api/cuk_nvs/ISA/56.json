{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":56,"content":[{"type":"heading","content":["Dule-baigan-abonoleged-igar"]},{"type":"verse","number":1,"content":["Bab-Jehová weyob soged:",{"text":"“Igar-innikigwad be imakmar,","poem":1},{"text":"igar-nued be oyomar.","poem":2},{"text":"Ar an-abonolegedi, warmakdanigusad,","poem":1},{"text":"an-igar-innikigwadi, sanar-guoed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dule, an-igarmarba nanadiile, degi, sogedba eba gudiile,","poem":1},{"text":"we-dule, dule-weligwaledid.","poem":2},{"text":"Dule, obunnoged-ibagi obunnodiile, gwen egi nodisulile,","poem":1},{"text":"degi, dule ibmar-isgana-imakdisulile, we-dule dule-weligwaledid.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dule-ainebalidi e-binsaedba Bab-Jehová-nug-odummodiile, geg weyob binsaed:","poem":1},{"text":"“Bab-Jehová e-dulemar-imbagi an-obanguoye.”","poem":2},{"text":"Dule-alugwasualed geg weyob sogmogad:","poem":1},{"text":"“Sapi-dingus-gwichidyob, an dakleye.”","poem":2}]},{"type":"verse","number":4,"content":["Ar Bab-Jehová weyob soged:",{"text":"“Ar dule-alugwasuarmalad obunnoged-ibagi obunnodimalale,","poem":1},{"text":"an-ibmar-abegedba ibmar-imakdimalale, an-igar-mesisadba nue-nanadimalale,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"an-neggweburgi, anse-goled-negyaba, galugi an ega e-nuga ise-narmakar nasikoed.","poem":1},{"text":"We-ibmala ega mimmigan-nikuedba bur bule guoed,","poem":2},{"text":"degine, an ega nug-degisadeguad ukbaloed,","poem":1},{"text":"bipisaale gwen e-nuga ielegosulid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dule-ainebarmalad anga-arbaega anba-akasmaladi,","poem":1},{"text":"an-nug-ogannogega anba-akasmaladi,","poem":2},{"text":"an-nug-odummogega anba-akasmaladi,","poem":1},{"text":"an-yalase an nidoed.","poem":2},{"text":"Bela obunnoged-ibagi-obunnodimalad gwen angi-nodisurmaladi,","poem":1},{"text":"degi, anbo-igar-mesisad-sogedba-gudimaladi,","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"an-yala-islidikidse an nidoed.","poem":2},{"text":"Anse-goled-neggi an weligwar-imakoed.","poem":1},{"text":"Anga ibmar-ogumakar-ukleged-ailagi ibmar-ukmaloedi an abingaoed.","poem":2},{"text":"Degi, anga-ibmar-ogumakar-ukmaloedi, an abingabaloed,","poem":1},{"text":"ar an-nega, bela dulemarga anse-goled-negye nugguoed.”","poem":2}]},{"type":"verse","number":8,"content":["Bab-Dummad-Bur-Birigined-Jehová weyob soged:",{"text":"“Israel-dulemar e-yargi-gudisurmaladi, gannar e-yargi-ambikuega imaked.","poem":1},{"text":"An-dulamar dagega an imakoed,","poem":2},{"lineBreak":true},{"text":"bato an Israel-dulemar-baigan-urbisadbo, an oatogoed.”","poem":2}]},{"type":"heading","content":["Bab-Dummad dule-isganagi sunmaknaid"]},{"type":"verse","number":9,"content":["Bab-Jehová weyob soged:",{"text":"“Bela ibmar-durgan-sapurgi-gudimaladi, degi, bela ibmar-durgan-ursirmaladi,","poem":1},{"text":"be dagmar, an-dulamar be obelodamar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bela Israel-dulemar-nakulemaladi aku-atakmalad, ar wargwensaale, ibmar-daksurmalad.","poem":1},{"text":"Ar bela achu-gwabinsulidyob gumalad,","poem":2},{"lineBreak":true},{"text":"ar geg urwemalad.","poem":2},{"text":"Gadi-gabmalad, wiegalamalad,","poem":1},{"text":"yeer gabed itodamalad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bemar achumar-gadi-mas-gunnedyobmalad, immeleged itodasurmalad.","poem":1},{"text":"Bemar sibad-wawaad-edarbemalad, ibmar akusunna itomalad.","poem":2},{"text":"Na war-wargwen e-itolegedba gudidii nanaed,","poem":1},{"text":"bela na e-ibmar-abegedba wala-walagwengi gudidiid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Binnasuli be gormar,","poem":1},{"text":"bemar sogmala: ‘¡Dagmar,","poem":2},{"text":"anmar vino sunamar!","poem":1},{"text":"¡Anmar mumgue, inna-gagbid gobe!","poem":2},{"text":"Anmar banedse emiyobi ibmar imakbaloed,","poem":1},{"text":"emiba anmar bur bule imakmaloed.’ ”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}