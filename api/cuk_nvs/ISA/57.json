{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":57,"content":[{"type":"heading","content":["Israel-dulemar ibmar-sobarmaladse gormalad"]},{"type":"verse","number":1,"content":[{"text":"Dule-innikidaedi burgwemamaigusad,","poem":1},{"text":"dule gwen bai daksurmalad,","poem":2},{"text":"dule-bega-arbamalad-nuegan, burgwemamaigusad.","poem":1},{"text":"Ar dule aku itodamalad, ibiga dule-nuegan isgued-ular burgwiddamala.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ar dule-igar-nuedba-nanaedi, nuedgi burgwemalad,","poem":1},{"text":"neg-uangi obunnomegisdamalad.","poem":2}]},{"type":"verse","number":3,"content":["Bab-Jehová sogded:",{"text":"“Bemar, ome-ina-isgana-imaked-mimmigan,","poem":1},{"text":"negsichigi-galagwensuli-gambanuchuganba-nanamalad-e-wagan, be anse walikgudamar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"¿Doagi be dodoye sogmala?","poem":1},{"text":"¿Doaga be binnasur gaya-maa-maa-imake?","poem":2},{"text":"¿Doaga be gwabin buud-buud-imake?","poem":1},{"text":"¿Ar bemar isgued-mimmigansursi?","poem":2},{"lineBreak":true},{"text":"¿Ar bemar gakansamalad-wagansursi?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bemar wag-ulu-sapi-urba, degi, bela sapi-dummagan-urba, galagwensuli guddamalad.","poem":1},{"text":"Bab-dummadsurmalad-e-nug-odummogega diangangi, degi, akwa-yaa-ollogangi burwigana be oburgwiddamalad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dian-akwa-swirimalad, begadga gumaloed.","poem":1},{"text":"We-akwa-swirigangi be bergudmaloed.","poem":2},{"text":"We-ibmar-asabinni, vino be eosmalad,","poem":1},{"text":"degi, ega be ibmar-gwag-uklemalad uksamalad.","poem":2},{"lineBreak":true},{"text":"Degite, ande we-ibmarmar-abinni, ¿bogi sigode? ¡Adi surbali!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yar-matusulid-birigine, be-meged be omesisad,","poem":1},{"text":"yar-matusulidse be nakwisad,","poem":2},{"lineBreak":true},{"text":"agi bab-dummadsulidga ibmar-ogumakar-ukega be nakwisad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Be-yawagak-daksiki, degi, e-suarmargine, bab-dummadyob-imaklemalad be nasiksad.","poem":1},{"text":"Be angi bangusad,","poem":2},{"text":"dule-baid-asabinni uka-swili be gwisgusad.","poem":1},{"text":"Be-meged-dummad-omesisadgine, be megisad.","poem":2},{"text":"Doamarbo be megbigusa, amarbo be igar nabosad.","poem":1},{"text":"Amarbo be megisgua, e-abgan be daksad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-dummad-Molocʼse be nanasad.","poem":1},{"text":"Ega be olivo-gwallu berbedii gusad,","poem":2},{"lineBreak":true},{"text":"be-ina-wawagan ega be omelosad.","poem":2},{"text":"Be be-nuggi-sunmakmalad dikasuli barmisad.","poem":1},{"text":"Amala, dule-burgwarmalad-burbase binsaed-amiega, be barmisad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bali-bali-nanaedba be yegus-inigwele,","poem":1},{"text":"degite, gwen be sogsasulid: ‘An wesegoye.’","poem":2},{"text":"Aka bur be gangusad.","poem":1},{"text":"A-ulale, gwen be galakussulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”¿Doa be-ogwayisa?","poem":1},{"text":"¿Doa dobguega be-imaksa?","poem":2},{"text":"Emide, be an-yardakdiid.","poem":1},{"text":"Gwen be angi bar binsassurmalad.","poem":2},{"lineBreak":true},{"text":"Gwen bai be an-daksasurmalad.","poem":2},{"text":"¿Ar be an-dobsurmarsunde?","poem":1},{"text":"¿Ar an undar bogi-gudigusadba be deyob damarsunde?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Emisgi, an be-ibmar-imakedi an barsogoed,","poem":1},{"text":"gwen bega ibmar-nuedga guosulid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ar dule-be-bendakega be binnasuli gollalile,","poem":1},{"text":"we-ibmar-sobarmalad-bab-dummadyob-imaklemalad gwen be-bendakosulid.","poem":2},{"text":"Bela we-ibmarmala burwaba seledoed,","poem":1},{"text":"unnila buu-imakedgi yoggudoed.","poem":2},{"text":"Ar dule angi-bensuli guele, napaneg egadga guoed,","poem":1},{"text":"an-yala-islidikid na egadga suoed.”","poem":2}]},{"type":"heading","content":["Bukib-binsadimalad baisur-itoge imaked"]},{"type":"verse","number":14,"content":["Bab-Jehová sogded:",{"text":"“Weyob sogdamaloed: ‘Igar-nudakmar, igar-nudakmar, igar-mesmar,","poem":1},{"text":"an-dulamar-idu igar-isgana nudakmar.’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ar ade, ani an Bab-Dummad-degisadegu-maidid, an-nuga Isligwaledid, weyob an soged:","poem":1},{"text":"Ani an niba-maid, neg-isligwaledgi an maid,","poem":2},{"text":"degi, dulemar-bukib-binsadimaladgi, degi, gwage-eikwaa-imakmaladgi an burbar maibalid.","poem":1},{"text":"Adi, dulemar-gwage-eikwaa-imakmaladga niga-ogannogegar,","poem":2},{"lineBreak":true},{"text":"degi, dule-bukib-binsadimalad baisur-ito imakegar.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"An degisadegu an-dulamargi gwisgudii guosulid,","poem":1},{"text":"degisadegu an amarse urwedii guosurbalid.","poem":2},{"lineBreak":true},{"text":"Ar degisulile, bela an dulemar-obinnisadi an-abin bergudo-itole.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Emar-isgued-ular, an ese ulusad.","poem":1},{"text":"An-urwedgine, an sabsur-imaksad.","poem":2},{"text":"An egi bangusgusad,","poem":1},{"text":"degi-inigwele, aka igar-isganaba bur nanadmalad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"E-damaladi, an daksad,","poem":1},{"text":"degi-inigwele, an ega nudakoed.","poem":2},{"text":"Idudii an guoed,","poem":1},{"text":"baisur-itoge an imakoed.","poem":2},{"text":"Degine, dule-ega-bukib-binsadimalad,","poem":1}]},{"type":"verse","number":19,"content":[{"text":"weligwaledgi weyob namakmalaga an imakoed:","poem":1},{"text":"‘Dikasuli-bukmaladga gwage-bogidik gusun,","poem":2},{"lineBreak":true},{"text":"degi, walikaa-bukmaladga gwage-bogidik gusun.’","poem":2},{"text":"An-dulamar an isgussulidyob-dakoed.","poem":1},{"text":"Ani, an Bab-Jehová-guedgi, deyob soged.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ar dule-ibmar-isgana-imakmaladi, demar-arwemaiyob gued,","poem":1},{"text":"geg bogi meged.","poem":2},{"text":"Igi demar-arwemair, ibmar-isgana mie,","poem":1},{"text":"degi, ollimar-miardae,","poem":2},{"lineBreak":true},{"text":"deyob dule-isganamar gued.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"An Bab-Dummadi soged:","poem":1},{"text":"‘Dule-isganamargala gwage-bogidikid sulid.’ ”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":21}