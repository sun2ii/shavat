{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":58,"content":[{"type":"heading","content":["Mas-gunsuli-gudigued-Bab-Dummad-yeerdaked"]},{"type":"verse","number":1,"content":["Bab-Dummadi Isaíasʼga sogded:",{"text":"“Gandikidba be binnasuli gole,","poem":1},{"text":"melle be bogguo,","poem":2},{"lineBreak":true},{"text":"gar-trompetaʼyob be binnasuli gole.","poem":2},{"text":"An-dulamarga e-nodiid be soge,","poem":1},{"text":"Jacob-waganga e-isgudiid be soge.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ar bane-bane anse gordimalad,","poem":1},{"text":"dulemar igar-innikigwad-imakdiiyobi,","poem":2},{"text":"degi, An-Igar-Mesisadgi bangussurmalayobi,","poem":1},{"text":"An-Igar-Mamaid wisgubimalad.","poem":2},{"text":"Igar-inniki-imakleged anse egismalad,","poem":1},{"text":"ar anse walikgudabimalad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Degi, ar anga weyob sogmalad: ‘¿Ar ibiga anmar mas-gunsuli bese-golega gudiguoe?","poem":1},{"text":"Ar bede aku-anmar-daked.","poem":2},{"text":"¿Ar ibiga anmar be-ular san-wiomarsunna?","poem":1},{"text":"Ar bede baisur anmar-dakbalid.’","poem":2},{"lineBreak":true},{"text":"”Bemar mas-gunsuli-gudigued-ibagi, mani-onogedgi be arbadamalad,","poem":1},{"text":"degi, dule-bega-arbamalad be sabsur-imakdedamalad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ar unnila bemar urwegala, degi, abin-abin-imakmalagala,","poem":1},{"text":"na sarsomalagala, be mas-gunsuli gudii damalad.","poem":2},{"text":"Ar be-itobi be an-abemalale, be mas-gunsuli-gudigued imakmardo.","poem":1},{"text":"Degi-inigwele, melle emi-imakedyobi be imako.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Weyob mas-gunsuli-gudiguedgi, ¿dule na dukin san-wiodii imakoye an sogsasi?","poem":1},{"text":"Nargammu-dopee-daklegedyobi, ¿nono-dullu-gudiguoye an sogsasi?","poem":2},{"text":"Gwage-naibid-oyogega, ¿wile-itoged-mor-yoi gudiguoye an sogsasi?","poem":1},{"text":"¿We be bimarsunde, mas-gunsuli-gudigued an yeer dakye?","poem":2},{"lineBreak":true},{"text":"Degi, ¿Bab-Jehová-iba-nued guye?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"”An-ular-mas-gunsuli-gudigued-iba an susadi, ¿igar-isgana obelogegarsursi?","poem":1},{"text":"¿Dule-sabsur-arbaega-imakleged onogegarsursi?","poem":2},{"text":"¿Dule-mesagwar-saledimalad bendakegarsursi?","poem":1},{"text":"Degine, ¿bela igar-isganaba-ebipiledimalad onogegarsursi?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ar mas-gunsuli-gudiguedi, ¿dule-ukudmaada-gudiidga be-mas be ukegarsursi?","poem":1},{"text":"¿Dule-negsuli-gudimalad akwegarsursi?","poem":2},{"text":"¿Dule-morsatemaladga mor-ukegarsursi?","poem":1},{"text":"Degine, ¿melle be-gwenadgan-obanegarsursi?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ar be weyob mas-gunsuli-gudigued imakele, igi-wakudar-dad-ibeler noardae, deyobi be guoed.","poem":1},{"text":"Boni-be-nikadi, yog-bega nugudoed.","poem":2},{"text":"Be-igar-inniki-imakedi bega igar egaoed,","poem":1},{"text":"gandikidba-an-yeerdaklegedi beba gudioed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Be anse golele, an be-abinsaoed.","poem":1},{"text":"Be anse-bendakleged-egisele, an bega sogoed: ‘¡Wegi an gwichiye!’","poem":2},{"lineBreak":true},{"text":"”Dule-mesagwar-imaked-igargi be banguele,","poem":1},{"text":"dulegi-gwisgued-igargi be noele,","poem":2},{"text":"degi, yogasaar-emargi-gakansaedgi be banguele,","poem":1},{"text":"igi-negsichidgi neg-ibegwar-naddae, deyobi be-daedi naoed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dule-ukudmaada-gudimalad be bendakdele, degi, dule-ibmar-abesa-gudiidga be ibmar-ukdele,","poem":1},{"text":"igi-yoruku-neg-mee-dakledae, deyobi be-daedi guoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ani an Bab-Jehová gusgu be-idudii guoed.","poem":1},{"text":"Nega-dinnaganba an bega mas-ukdii guoed,","poem":2},{"lineBreak":true},{"text":"an bega be-garmar ogannogoed.","poem":2},{"text":"Igi-dutugalu ogles-naidae, deyobi be guoed,","poem":1},{"text":"igi-ibe-aryomaidaedi, geg dii-bergue, deyobi be guoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dikasurgus-neg-bibichismaladi gannar bemar soboed.","poem":1},{"text":"E-sailamar dikasurgus-mamaidi, ogannomaloed.","poem":2},{"text":"Be weyob bilemaloed: ‘Galu-matusurmalad-bibichisad-nudakmaladye,","poem":1},{"text":"negmar-bibichisad-gannar-sobmaladye.’ ”","poem":2}]},{"type":"heading","content":["Obunnoged-ibagi, obunnoged-igar"]},{"type":"verse","number":13,"content":["Bab-Jehová weyob soged:",{"text":"“Obunnoged-ibagi be obunnodimalale,","poem":1},{"text":"gwen egi be nodisurmalale,","poem":2},{"text":"an-iba-islidikidgi be-itolegedba be ibmar-baigan-imaksulile,","poem":1},{"text":"be ani Jehováʼgine wergued amimaloed.","poem":2},{"text":"Weyob be obunnoged-iba-bimalale:","poem":1},{"text":"‘Weligwaled-ibaye.’","poem":2},{"text":"Degi, weyob be iba-islidikid-bimarbalile:","poem":1},{"text":"‘Bab-Jehová-nug-odummoged-ibaye.’","poem":2},{"lineBreak":true},{"text":"Be angine, wergued amimaloed.","poem":2},{"text":"Obunnoged-ibaga be bagagwar-gumalale,","poem":1},{"text":"mani-onogedgi-arbasulidgi be an-nug-odummomalale,","poem":2},{"text":"degine, walagwengi be-itolegedba-yogasaar-sunmaksulidgi be an-nug-odummomalale,","poem":1}]},{"type":"verse","number":14,"content":[{"text":"be angine, wergued amimaloed.","poem":2},{"text":"Neggwebur-e-dummaganga an be-imakmaloed,","poem":1},{"text":"degi, be-dad-Jacobʼba be ibmar-nikuoedgi be yeer itomaloed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/57.json","previousChapterAudioLinks":{},"numberOfVerses":14}