{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":59,"content":[{"type":"heading","content":["Israel-dulemar e-isgued barsogsad"]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová anmar-abonogega, ganguedsurye soglesulid.","poem":1},{"text":"Degi, aku-anmar-itoye soglesurbalid,","poem":2},{"lineBreak":true},{"text":"ar bela magar anmar-itoged.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ar bemar-isguedi, Bab-Dummadgi-banguega bemar-imaked.","poem":1},{"text":"Ar be-isgumaladi, Bab-Dummad bemar-idu wagar-aibirar-megega imaked,","poem":2},{"lineBreak":true},{"text":"adi, melle bemar-itogegar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ar bemar ablisbi argan sedimalad,","poem":1},{"text":"degi, goonumar isguedbi na be sedimalad.","poem":2},{"text":"Be-gwabin-duku unnila gakansaedgi sunmaked,","poem":1},{"text":"be-gaya unnila igar-isganaginbi sunmaked.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dule igar-innikigwadgi-sunmaked sulid,","poem":1},{"text":"dule napiragwadgi-igar-naboged sulid.","poem":2},{"text":"Gakansalegedgi bensurmalad,","poem":1},{"text":"na muchub-muchub gakansamalad.","poem":2},{"text":"Binsaed-isganagi binsadamalad,","poem":1},{"text":"degi, igar-isgana imakdedamalad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dulemar, naibe-nuegan-e-akwa-bukwayobi binsaed-isgana sedimalad,","poem":1},{"text":"diba-nagueyob, igar-isgana amimalad.","poem":2},{"text":"Dule, binsaed-isgana we-naibe-akwayob gunnele, burgoed.","poem":1},{"text":"Ar dule, we-naibe-akwa marele, ega naibeyob binsaed-isgana ainidagoed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dibagi geg mor sobleged,","poem":1},{"text":"dule diba-soblealed geg e-morga imaked.","poem":2},{"text":"Dule-ibmar-imakedi ibmar-isganabi-imakmalad,","poem":1},{"text":"e-ibmar-samaladi, unnila sabsur-neg-gagaed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"A-dulemar ibmar-isgana bur-imakmalad,","poem":1},{"text":"bur dule-ibmar-akalodisulid-ibe ablis eomalad.","poem":2},{"text":"E-binsaedi, galagwensur-igar-isganagi binsamalad.","poem":1},{"text":"E-ibmar-imakedi bela neg-oichoged.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gwage-bogidikid-igar gwen wissurmalad.","poem":1},{"text":"E-ibmar-imakedgi igar-innikimalad naisulid,","poem":2},{"lineBreak":true},{"text":"unnila igar-noarmaladbi onoardaed.","poem":2},{"text":"Ar dule we-igar-isganamarba nanadiile,","poem":1},{"text":"gwage-bogidikid-igar wisguosulid.","poem":2}]},{"type":"verse","number":9,"content":["Isaías sogded:",{"text":"“A-ulale, igar-napira-maid anmargi banguded.","poem":1},{"text":"Degi, igar-innikigwadi anmargi aibated.","poem":2},{"text":"Neg-meegwadi anmar abdakdii gusanad.","poem":1},{"text":"Degi-inigwele, neg-gubyagwaledgi anmar bukudapid.","poem":2},{"text":"Neg-ibegwaledi anmar abdakdii gusanad.","poem":1},{"text":"Degi-inigwele, anmar negsichidgi bukudapid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dule-aku-atakmaladyobi, anmar galu-ebu-ebu gudimalad.","poem":1},{"text":"Dule-ibyasurmaladyobi, anmar negsichidgi acha-acha gudimalad.","poem":2},{"text":"Neg-mutikidyobi, anmar neg-ibgine yoleddamalad.","poem":1},{"text":"Anmar bonisuli-inigwele, burgwaleyob na gudimalad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bela anmar wiob-uurmakedyob, uurmakbukwad.","poem":1},{"text":"Nuu-sibu akiginnedyob, anmar akiginbukwad.","poem":2},{"text":"Aisaar igar-innikigwad-imaked anmar na abdakbukwanad, gwen imaklessulid.","poem":1},{"text":"Ollorgued-igala anmargi amba dikasulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"”Be wisid, anmar-isguedi bukidarad.","poem":1},{"text":"Anmar-isguedi, anmargi aibined.","poem":2},{"text":"Anmar-ibmar-isgana-imaked anmarba gudiguad.","poem":1},{"text":"Anmar isguedgi-gudiidi, na magar itomalad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Anmar, uayasuli gusad.","poem":1},{"text":"Anmar, Bab-Jehová-obachamalad.","poem":2},{"text":"Anmar, Bab-Dummad-iedmalad.","poem":1},{"text":"Anmar, dogdar dule-mesagwar imakmalad,","poem":2},{"text":"degi, dogdar dule-yardaksamalad.","poem":1},{"text":"Anmar-binsaedgi-gakansaed-ainiedi, anmar dulemarga sogsamalad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Igar-napira-maidi isdar-daklege gusad,","poem":1},{"text":"degi, igar-napiragwadi amba anmargi dikasulid.","poem":2},{"text":"Dulemar-ambikuedgi igar-nabirid-oyoleged bergusad.","poem":1},{"text":"Binsaed-nikadaedi, bar anmar oyosurgusad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Dule ibmar-nabir-imaked, bar daklesulid.","poem":1},{"text":"Ar dule isguedgi bangudele, bela e-ibmar-nikadi ei obelodamalad.","poem":2},{"lineBreak":true},{"text":"”Bab-Jehová bela igar-innikimalad-bergusa-dakargu, nabir-itossulid.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Bab-Dummadi, dule igar-nuegangi bar-binsasuli dakargu, geger dakalid.","poem":2},{"text":"A-ulale, Bab-Dummad na e-gangued oyogoye binsaalid.","poem":1},{"text":"Adi, anmar-abonogegar, e-igar-innikigwadba anmar-abingaegar.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bab-Dummadi e-igar-innikigwadi, sigu-abgaedyobi yooed,","poem":1},{"text":"degi, bormo-gurginyobi abonoleged-igar sioed,","poem":2},{"text":"buged-imaked-mola yooed,","poem":1},{"text":"urwed-mola yooed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Dule-ibmar-imaksamaladba sabsur-odurdakoed.","poem":1},{"text":"Neggwebur-demar-gakaba-bukmaladga buged-imakoed:","poem":2},{"text":"E-isdarmaladse urwoed,","poem":1},{"text":"degi, e-isdarmaladgi buged-imakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"”Dad-argwanedsikmalad Bab-Jehová-nug dobgudmaloed.","poem":1},{"text":"Dad-nakwedsikmalad Bab-Jehováʼgi binsaed-nikaa gudmaloed.","poem":2},{"text":"Ar ade, diwar-gwichigudanidaedyobi Bab-Jehová na e-buu-imakedba danikoed.”","poem":1}]},{"type":"verse","number":20,"content":["Bab-Jehová weyob soged:",{"text":"“Dule-bendakedi, Sión-yalase danikoed,","poem":1},{"text":"Jacob-wagan-e-isguedga-bukib-binsaega imaknonikoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"”An bemarbo igar mesed,","poem":1},{"text":"An-Burba bemargi maigu guoed.","poem":2},{"text":"Be-gwabindukugine, an bega an-gayaburba-nasiksadi, bar begine alliosulid.","poem":1},{"text":"Degi, be-mimmigangine, be-wagangine, bar an-gayaburba alliosulid,","poem":2},{"lineBreak":true},{"text":"emi-ibadse degisadegu guoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/58.json","previousChapterAudioLinks":{},"numberOfVerses":21}