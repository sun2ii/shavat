{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":6,"content":[{"type":"heading","content":["Isaías, Bab-Dummad-ologanagi-sii daksad"]},{"type":"verse","number":1,"content":["Rey-Uzías-burgwisad-birgagine, ani Isaías, Bab-Dummad ologana-biriginedgi-sii an daksad. E-mola-duku ese-goled-neggi bela batenai an daksad."]},{"type":"verse","number":2,"content":["E-birgine, dule-nibnegginmalad-Serafínʼye-nugmalad gukunanai an daksad. A-dulemar sakan-nergwa (6) nikamaladbiid: Sakan-warbogwadgi e-wagar odukunanaid, sakan-warbogwad-baidgine, e-malimar odukunanaibalid, degine, sakan-warbogwad-baidgindi, gukunanaid."]},{"type":"verse","number":3,"content":["Muchub-muchubbi, binnasuli sognanaid:",{"text":"“Bab-Jehová-Bela-Gangued-Nikadi, Bab-Jehová-Isligwaledid, Isligwaledid, Isligwaledid.","poem":1},{"text":"Bela napneggi e-gangued-yeerdaklegedi neg-gasa naid.”","poem":2}]},{"type":"verse","number":4,"content":["Serafínʼmar-binnasur-gornanaidbali, Bab-Dummadse-goled-neg-yawagak-bargamalad e-sailamarse-bakale, giglimakded, geb Bab-Dummadse-goled-neg bela waa daasa sigisad."]},{"type":"verse","number":5,"content":["Geb an binnasuli goted:",{"text":"“¡An duledar-wiles! ¡An bergussun!","poem":1},{"text":"Ar ande ibmar-isganabi-sogdiid-duled,","poem":2},{"lineBreak":true},{"text":"dulemar-ibmar-isganabi-sogdimalad-abargi an gudiid.","poem":2},{"text":"Emide, an Rey-daksad,","poem":1},{"text":"Bab-Jehová-Bela-Gangued-Nikad an daksad.”","poem":2}]},{"type":"heading","content":["Isaíasʼse-gorlesad"]},{"type":"verse","number":6,"content":["Degidgine, Serafín-gwensak ansik gukualid. Bab-Dummadga-ibmar-ogumakar-ukleged-ailagi soo-gasiidgi soo-weed-esgorogi sogun-ara-arad-wesadi sedanikid."]},{"type":"verse","number":7,"content":["Geb a-sogungine, an-gakuli ebunonikid, agi anga sogded:",{"text":"“Be dake, we-sogun-ara-arad be-gakuli-ebusadi, bega isgued elinonisunnad.","poem":1},{"text":"Bab-Dummadgi be isgudiidi, emide isgussulidyobi be daklenadsunnad.”","poem":2}]},{"type":"verse","number":8,"content":["Geb degidgine, Bab-Jehová-e-sunmaked an itosad. Weyob soge an itosad:",{"text":"—¿An doa-dule barmidoe?","poem":1},{"text":"¿Doa anmar-anar naoe?","poem":2},"Geb abin an sogded:",{"text":"—Ani be an-barmide,","poem":1},{"text":"ani an naoe.","poem":2}]},{"type":"verse","number":9,"content":["Geb Bab-Jehová anga sogded:",{"text":"—Be nae, we-dulemarga be sogna:","poem":1},{"lineBreak":true},{"text":"” ‘Be ibmar nue-itomalo-inigwele, akusunna be itomaloed.","poem":1},{"text":"Be ibmar nue-dakmalo-inigwele, akusunna be dakmaloed.’","poem":2}]},{"type":"verse","number":10,"content":[{"text":"We-dulemar-e-gwage dutusuli be imako,","poem":1},{"text":"akusunna ibmar-itogega be imako,","poem":2},{"lineBreak":true},{"text":"akusunna ibmar-dakega be imako.","poem":2},{"text":"Degisulile, e-ibyagwale ibmar-dakdoed,","poem":1},{"text":"e-uayagwale ibmar-itodoed,","poem":2},{"text":"degi, e-gwagegi magar-ibmar-itodoed,","poem":1},{"text":"e-isguedga bukib binsadmaloed.","poem":2},{"lineBreak":true},{"text":"Degidbali, nudake an dakledagoed.”","poem":2}]},{"type":"verse","number":11,"content":["Geb an ese egichided:",{"text":"—Bab-Jehová, ¿sanagwadse an be-nuggi sunmakdii gusunnoe?","poem":1},"Bab-Jehová anga sogded:",{"text":"—Bela neggweburmar-obelolegedse be an-nuggi sunmakdii guoed.","poem":1},{"text":"Bela negmar-ollo-ollo-ambikuedse be angi sunmakdii guoed.","poem":2},{"text":"Dulemar a-neggweburmargi-bar-gudii-guosulidse be an-nuggi sunmakdii guoed.","poem":1},{"text":"Nainumarbela-swiri-naguedse be angi sunmakdii guoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"An bela-dulemar-e-yalagi dikasuli ononnogoedse be angi sunmakdii guoed.","poem":1},{"text":"Bela e-yala-olloo-naguedse be an-nuggi sunmakdii guoed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ar dulemar e-dulataledgi (100) amba e-ambe (10) besale,","poem":1},{"text":"bela amba amar berguoed.","poem":2},{"text":"Ar sapi-emisgwa-siklesad-e-sailabi gannaa-siidaedyobi wis bemaloed.","poem":1},{"text":"Geb we-dulemar-bemaloedi neggwebur-islidikidga guoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}