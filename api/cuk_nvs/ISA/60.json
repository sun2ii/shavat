{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":60,"content":[{"type":"heading","content":["Jerusalén neggwebur-gwapidga guoed"]},{"type":"verse","number":1,"content":["Bab-Jehová soged:",{"text":"“¡Jerusalén-dulemar, be gwichigu!","poem":1},{"text":"¡Bela ibegwale be gumar!","poem":2},{"text":"¡Be-neg-ibegwaledi bese warmaknonikid!","poem":1},{"text":"Ani Bab-Jehová-gued.","poem":2},{"lineBreak":true},{"text":"An-gangued-yeerdaklegedi begi ibegwar naid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Be dake, neg-gubyagwaledi napneg-gasanaid.","poem":1},{"text":"Degi, negsichidi, dulemargi naid.","poem":2},{"text":"Degi-inigwele, an-ibegwaledi begi mee-gaoed.","poem":1},{"text":"¡Begine, an-gangued-yeerdaklegedi oyolegoed!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dule-yar-baid-baidgi-bukmaladi, be-neg-meegwadba gudii gumaloed,","poem":1},{"text":"degi, reymar be-neg-ibegwaledba nanadii gumaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"”Nue be atake, be-dikarba be nue neg-dake:","poem":1},{"text":"Bela danar-ambikusmalad, bese danimalad.","poem":2},{"text":"Be-mimmigana dikasuli bese danimaloed.","poem":1},{"text":"Be-bunamala argangi-annikaa nidanimaloed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Weyob be dakoed,","poem":1},{"text":"degi, weligwaledba be yeer itodoed,","poem":2},{"text":"ise-weligwaledba be-gwage dik-dik naguoed.","poem":1},{"text":"Degi, be-gwage ise-yeer itonaoed.","poem":2},{"text":"Ar begala neggwebur-demar-gakagi-bukmalad-e-ibmar-nuegan senonimaloed.","poem":1},{"text":"Degi, dulemar-yar-baid-baidgi-bukmalad-e-ibmar-nuegan bese warmaknonikoed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Be-walik moli-yargan-muremalad engudoed.","poem":1},{"text":"Madián-dulemar-e-moli-yargan-muremalad, Efa-dulemar-moli-yargan-muremalad engudoed.","poem":2},{"text":"Bela Sabá-neggweburginmaladi bese nonimaloed,","poem":1},{"text":"bega ina-wawagana, degi, ormar senonimaloed.","poem":2},{"lineBreak":true},{"text":"Degine, an-nug-odummogagwale danimaloed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bega, Cedar-neggwebur-e-sibad-wawaadmar ambikunonikoed.","poem":1},{"text":"Degi, Nebaiot-neggwebur-e-sibad-wawaad-machergan bega ibnuedga guoed.","poem":2},{"text":"Adi, an-ailagi anga ibmar-nued-uklegedga guegar.","poem":1},{"text":"Degi, ani an, an-nug-odummoleged-neg yeerdaklege an imakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”Mogiryob-nasdamalad, ¿wede doamala?","poem":1},{"text":"Nuu-sibuyob e-uuse nadapdamalad, ¿wede doamala?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neggwebur-demar-gakaba-bukmaladi angi benguosurmalad.","poem":1},{"text":"Tarsis-ur-dummagan, ur-dummagan-idudanikid.","poem":2},{"text":"We-urmar, dikasuli be-mimmigan-sedanikid,","poem":1},{"text":"degi, e-ormar, e-manimar sedanikid,","poem":2},{"lineBreak":true},{"text":"adi, an-nug-odummolegegar.","poem":2},{"text":"Ar ani an Israel-dulemar-e-Bab-Dummad-Isligwaledid,","poem":1},{"text":"ar ani an gandikidga be-imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Dule-ainebarmalad bega gannar galu-matusurmalad soboed,","poem":1},{"text":"degi, e-reymar bega arbamaloed.","poem":2},{"text":"An-urwedgi an sabsur-be-odurdaksa-inigwele,","poem":1},{"text":"an-sabguedgi an ise-wile be-dakoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Be-yawagak argasigu guoed,","poem":1},{"text":"mutikidbali, degi, ibginedbali gwen atiosulid.","poem":2},{"text":"Bega dulemar-yar-baid-baidgi-bukmalad-e-ibmar-nuegan seledanikoed,","poem":1},{"text":"e-reymar bese ilekwaa seledanikoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dulemar-yar-baid-baidgi-bukmaladi, degi, yalamar-nanaidi,","poem":1},{"text":"beba ibmar-imaksulile, bela obelolegoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”Líbano-yala-e-ibmar-nuegan-nikadi, bese warmakoed,","poem":1},{"text":"ciprés-sapi-warmar, baryawarmar, degi, abeto-sapi-warmar bese warmakoed.","poem":2},{"text":"Adi, an-neg-islidikid yeerdakle imakega,","poem":1},{"text":"an-mali-onakwed-gana-neg-siid-e-nug ogannogegar.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dulemar-mesagwar-be-imakmalad-e-mimmigan, bese dulluu-ambikunonimaloed.","poem":1},{"text":"Bela dulemar isdar-be-dakmaladi, be-asabin sindigar-signonimaloed,","poem":2},{"text":"degi, weyob be-bimaloed, ‘Bab-Jehová-neggweburye,","poem":1},{"text":"Sión-yala, Israel-dulamar-e-Bab-Dummad-Isligwaledgadye.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"”Be walagwen-melledgus-inigwele,","poem":1},{"text":"degi, be isdardakles-inigwele,","poem":2},{"text":"dule gwen be-igarba nanassur-inigwele,","poem":1},{"text":"degisadegu nug-dummarba-guega an be-imakoed,","poem":2},{"lineBreak":true},{"text":"degi, dulemar weligwar be-imakega an imakoed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dule-yar-baid-baidgi-bukmalad-e-mas be gunnoed,","poem":1},{"text":"reymar-e-ibmar-nuegan bega uklegoed.","poem":2},{"text":"Degisoggu, na be wisguoed, ani an Bab-Jehová be-Abonogedid.","poem":1},{"text":"Ani an Jacob-wagan-e-Bab-Dummad-gandikid be-bendakedid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"”Esgoro-gordikid-muchubbi an bega olo sedagoed,","poem":1},{"text":"esgoro-muchubbi an bega mani sedagoed.","poem":2},{"text":"Urgo-muchubbi an bega esgoro-gordikid sedagoed,","poem":1},{"text":"degi, akwamar-muchubbi an bega esgoro sedagoed.","poem":2},{"text":"Neg-bogidikid-naguega an imakoed.","poem":1},{"text":"Degi, igar-innikigwadi negseega an imakoed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bipisaale bar be-yargi sabsur-imaklegedi, be itogosulid.","poem":1},{"text":"Bar be-yalagi neg-bibichedgi, degi, neg-obelogedgi sunmaklegosulid.","poem":2},{"text":"Ar ade, weyob be-galu-matusurmaladgi soglegoed:","poem":1},{"text":"‘Abonolegedye.’","poem":2},{"text":"Degi, be-yawagakmardi weyob bimarbaloed:","poem":1},{"text":"‘Bab-Dummad-nuggi-namaklegedye.’","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bar dad-ibeler bega neg-ibgi, neg-meegwadga guosulid,","poem":1},{"text":"degi, nii bar bega mee gaosurbalid.","poem":2},{"text":"Ar Bab-Jehová bega gwallu-meegwad-degisadeguadga guoed.","poem":1},{"text":"Be-Bab-Dummad be-gangued-yeerdaklegedga guoed.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dad-ibeler bar bega argwanosulid,","poem":1},{"text":"degi, nii-gaedi gwen mommolegosurbalid.","poem":2},{"text":"Ar ani Bab-Jehová be-gwallu-meegwadga degisadegu guoed.","poem":1},{"text":"Geb agi be-wile-itodiidi bergunonikoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"”Degisoggu, bela innikigwadga be-dulemar guoed,","poem":1},{"text":"degi, bela be-dulemar napneg gaoed.","poem":2},{"text":"Sapi-ainiedyob ainidamaloed.","poem":1},{"text":"Ani an deyob imakoed.","poem":2},{"text":"An-sunnagwad an imakoed,","poem":1},{"text":"an-nug odummolegoed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Dula-ichegwadi bur miliba (1,000) mergudoed,","poem":1},{"text":"bur-neggwebur-bipigwadi, neggwebur-gandikidga guoed.","poem":2},{"text":"Ani an Bab-Jehová gued.","poem":1},{"text":"We-ibmarmar-guoed-e-ibagan warmaknonikile, gwae-gwae-guega an imakoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/59.json","previousChapterAudioLinks":{},"numberOfVerses":22}