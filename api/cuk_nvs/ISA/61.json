{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":61,"content":[{"type":"heading","content":["Israel-yarga bendaklegedgi sunmaklenaid"]},{"type":"verse","number":1,"content":[{"text":"“Bab-Dummad-Jehová-Bur-Birigined-E-Burba angi maid.","poem":1},{"text":"Ar ade, dule-wilemaladga gayaburba-nuegangi-sunmakega, Bab-Dummad an-susad.","poem":2},{"text":"Bab-Dummad an-barmialid,","poem":1},{"text":"dule-gwage-nunmak-itodimaladga gwage-armakegar.","poem":2},{"text":"An-barmialid, dule-galesbukmalad-onogedgi sunmakega,","poem":1},{"text":"degi, dule-esgaryagi-galesbukmalad onogegar.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Dummad an-barmiarbalid, Bab-Jehová-birga-nuedgi sunmakega,","poem":1},{"text":"degi, anmar-Bab-Dummad-buged-mai-imakoed-e-ibagi sunmakegar.","poem":2},{"text":"An-barmiarbalid, bela dule-wile-itodimalad-e-gwage armakega,","poem":1}]},{"type":"verse","number":3,"content":[{"text":"degi, Sión-dulemar-gwage-nunmak-itodimalad-niga ogannoegar.","poem":2},{"text":"An-barmialid, nonogi-buru-biin-gudiid-muchub, ega ologurgin ukegar.","poem":1},{"text":"An-barmialid, wile-itoged-muchub, weligwaledba ega gwallu-wawad ukegar.","poem":2},{"lineBreak":true},{"text":"An-barmialid, bukib-binsadiid-muchub, ega weligwar-itoged ukegar.","poem":2},{"text":"Geb degine, wemar weyob biledmaloed: ‘Igar-innikigwad-urwar-sapimarye.’","poem":1},{"text":"Bab-Jehová na e-gangued-oyogega digsad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"”Negmar-epennemalad-bibichis-bukwadi, gannar sobmaloed.","poem":1},{"text":"Negmar-birgabargus-akwamarbi-omilededi, gannar nudakmaloed.","poem":2},{"text":"Neggweburmar-bibichis-bukwadi, gannar obinomaloed.","poem":1},{"text":"Dikasurgus akwamarbi-neggwebur-omilededi, gannar nudakmaloed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dule-ainebarmaladi, be-sibad-wawaadmar akwemaloed.","poem":1},{"text":"Dule-neggwebur-baidsikmaladi, be-nainumargi, degi, be-uva-nainumargi, bega arbamaloed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ar bemardi weyob biledmaloed: ‘Dule-irwa-Bab-Dummadse-goled Bab-Jehováʼgadye.’","poem":1},{"text":"Bemarga sogdemaloed: ‘Anmar-Bab-Dummadga ibmar-imakmaladye.’","poem":2},{"text":"Dulemar-yar-baid-baidgi-bukmalad-e-ibmar-nuegangi, be yeer itomaloed.","poem":1},{"text":"E-ormar-sunsogmaladi, be yomaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"”An-dulamar, e-binged-dummad-itosmalad-muchub, ibmar-nuegan ilabo-wilub abingamaloed.","poem":1},{"text":"An-dulamar, e-nug-isgusad-muchub, ibmar-ega-uklegoedgi yeer itomaloed.","poem":2},{"text":"Deyobi, na e-napagine ibmar-ega-uklegoedi, ilabo-wilub abingamaloed,","poem":1},{"text":"degisadegu weligwale gudii gumaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”Ani an Bab-Jehová, igar-innikigwad-sabedid,","poem":1},{"text":"ar ibmar-atursaeddi, degi, igar-isgana-imaklegeddi, an isdar-daked.","poem":2},{"text":"An-inniki-daedgi an bemarga ibmar-buged-ukleged ukoed.","poem":1},{"text":"An bemarbo igar-degisadeguad mesoed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Be-wagana, dulemar-yar-baid-baidgi-bukmalad-imbagi, nug-nika gumaloed.","poem":1},{"text":"Be-mimmigan neggweburmar-imbagi nug-nika gumaloed.","poem":2},{"text":"Dulemar dakarmalale, magar dakmaloed, sogmaloed:","poem":1},{"text":"‘We-dulemar, Bab-Jehová dulemargi-nued-binsasmalad e-waganad.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Bab-Jehováʼgi an bela-bela yeer itoged,","poem":1},{"text":"an-Bab-Dummadgi an weligwar itoged.","poem":2},{"text":"Ar ade, abonoleged-mormar anga yosad,","poem":1},{"text":"degi, igar-innikigwad-imaked-morgi an-edusad.","poem":2},{"text":"Machered ome-nikunair, igi ibmar-yeerdakleged bebegi-yoidae, deyobi an gued.","poem":1},{"text":"Ome sui-nikunair, igi ormar-nasikdae, deyobi an gued.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar igi napa ibmar-muugan-oniega imake, degi, igi nainu ibmar-gwag-niega imake,","poem":1},{"text":"deyobi, Bab-Jehová-Bur-Birigined, bela dulemar-yar-baid-baidgi-bukmalad-abargi, igar-innikigwad, degi, namakleged, ainidagega imakoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}