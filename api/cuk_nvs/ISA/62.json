{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":62,"content":[{"type":"heading","content":["Sión-neggwebur-nug-gwapid"]},{"type":"verse","number":1,"content":[{"text":"An Sión-neggwebur-sabed-ulale, an bogiguosulid.","poem":1},{"text":"An Jerusalén-neggwebur-sabed-ulale, an obunnogosulid.","poem":2},{"text":"Geb Bab-Dummad-e-Igar-innikigwad-imaked magar-daklegedse, an bogiguoed.","poem":1},{"text":"Geb Bab-Dummad-bendakleged, gwinnur-gaedyob-guedse, an obunnogoed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dulemar-yar-baid-baidgi-bukmaladi, be-igar-innikigwad-imaked dakmaloed.","poem":1},{"text":"Bela reymala be-gangued-be-yeerdakleged dakmaloed.","poem":2},{"text":"Nug-gwapid be nikuoed,","poem":1},{"text":"Bab-Jehová-sunnad bega nug ukoed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová-e-argangine, ologurgin-yeer-gaedyob, be guoed.","poem":1},{"text":"Be-Bab-Dummad-e-argan-yaurgine, ibmar-yeerdakleged-reymar-bebegi-nasiklegedyob, be guoed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wargwen-mellededye, bar be-biosurmalad.","poem":1},{"text":"Napabi-naidye, be-yala biosurmarbalid.","poem":2},{"text":"An egi-yeer-itogedye, be bilegoed.","poem":1},{"text":"An-sanwaye, be-yala bilegoed.","poem":2},{"text":"Ar Bab-Jehová begi yeer itogoed,","poem":1},{"text":"be-yala sui nikuoed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ar sapingwa na e-yagwabo-nikunaiyobi, gannar-be-urbed,","poem":1},{"text":"deyobi bebo nikuoed.","poem":2},{"text":"Ar igi-sapingwa yagwa-ebo-nikuoedgi weligwar-itodae,","poem":1},{"text":"deyobi, be-Bab-Dummad, begi yeer itogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Jerusalén-neggwebur, be-galu-matusurmaladgi, sorda-nakulemalad an urbisad.","poem":1},{"text":"Wemala, bipisaale gwen mutikidbali, ibginedbali, gaya bogiguosurmalad.","poem":2},{"lineBreak":true},{"text":"Bemar, Bab-Jehováʼse-gormalad melle be obunnomalo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ar Jerusalén-neggwebur gannar urbedse, degi, Jerusalén-neggwebur-nug-nika imakedse,","poem":1},{"text":"melle be, Bab-Dummad obunnogega imakmalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová na e-argan-gangued-nikadba, weyob ise-sogar imaksad:","poem":1},{"text":"“Bipisaale be-ibmar-gwag be-isdarmalad-e-masga-guega bar an ukosulid,","poem":2},{"lineBreak":true},{"text":"degi, vinoʼgi be nue-arbasgusadi, dule-ainebarmaladi be-ibe gobosurmalad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dule ibmar-gwag-wesmaladi, an nug odummobukwa ibmar-gwag gunmaloed.","poem":1},{"text":"Dule uva-san-wesmaladi, anse-goled-neg-islidikid-neg-imbagi, vino gobmaloed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"¡Jerusalénʼginmalad, be ainimar!","poem":1},{"text":"¡Yawagak-bukwadgi, be ainimar!","poem":2},{"text":"¡Dulemar-idu igar nudakmar!","poem":1},{"text":"¡Igar-dummad be mesmar!","poem":2},{"text":"¡Bela akwamar be onirmar!","poem":1},{"text":"¡Dulemar igar-maid-magar-dakega be bander onakwe!","poem":2}]},{"type":"verse","number":11,"content":["Bab-Jehová bela-dulemar-napneggi-bukwadga, weyob sogsad:",{"text":"“Jerusalén-dorganga be sogmar:","poem":1},{"text":"‘¡Bato be-abonoged danikid!","poem":2},{"text":"Na e-nakwisad-ibmar eba sedanikid,","poem":1},{"text":"na e-ibmar-buged-ukleged eba danikid.’","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dulemar-islidikidye, be bilemaloed.","poem":1},{"text":"Bab-Jehováʼse bendaklesmaladye, be bilemaloed.","poem":2},{"text":"Neggwebur-abelegedye, be-neggwebur bilegoed.","poem":1},{"text":"Neggwebur bipisaar wargwen-melledsulidye, be-neggwebur bilegoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}