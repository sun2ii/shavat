{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":63,"content":[{"type":"heading","content":["Bab-Jehová Edom-dulemargi nakwisad"]},{"type":"verse","number":1,"content":[{"text":"Edom-yar-akar danikid, ¿wede doawa?","poem":1},{"text":"Bosra-neggwebur-akar mor-ginnidbi-yoi danikid, ¿wede doawa?","poem":2},{"text":"Mor-nudakar-yoi danikid, ¿wede doawa?","poem":1},{"text":"Gandikidba binna-binnagwad danisulid, ¿wede doawa?","poem":2},{"lineBreak":true},{"text":"“Ani an danikid. An igar-innikigwadba-sunmakedid,","poem":1},{"text":"an dule-abonogega-gangued-nikadid.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"¿Ar ibiga be-mor ginnitibi daklege?","poem":1},{"text":"Ar be-mor, uva-egured-galugi dule-uva-egured-e-moryob dakleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“An walagwen uva-egured-galugi uva-egurusad,","poem":1},{"text":"dule-bamalad gwen anba gunai gussulid.","poem":2},{"text":"An-sae-itogedgi an egi annasad.","poem":1},{"text":"An-urwedgi an maataa imaksad.","poem":2},{"text":"E-ablis an-morgine milesad,","poem":1},{"text":"degi, bela an-mor ese isgusad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Buged-mai-imaked-iba bato an mesisad.","poem":1},{"text":"An-dulamar-bendakleged-iba bato warmaksad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dule-an-bendaked an edarbisanad, degi-inigwele, dule gwen an-bendaksasulid,","poem":1},{"text":"dule-wargwensaar-an-bendakbi-gussulid geg an itoged.","poem":2},{"text":"Dukin an-ganguedgine an emargi obichad.","poem":1},{"text":"An-urwedi sikirmakega an-imaksasulid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"An-sae-itogedgi, dulemar-yar-baid-baidgi-bukmalad-birgi an annasad,","poem":1},{"text":"an-urwedgi an amar-obelosad.","poem":2},{"lineBreak":true},{"text":"E-ablis napagi-milegega an imaksad.”","poem":2}]},{"type":"heading","content":["Bab-Jehová Israel-dulemargi nued-binsaed"]},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová-e-sabgued-dummad an ebinsaoed,","poem":1},{"text":"e-ibmar-dummagan-imaksadgi an namakoed.","poem":2},{"text":"Bab-Jehová bela anmarga ibmar-imaksad-ular, an ega namakoed.","poem":1},{"text":"Wile-anmar-daked-ular, degi, dummad-anmar-sabed-ular, an ega namakoed.","poem":2},{"text":"Bab-Jehová Israel-dulemarga ibmar-nuegan-bukidar-imaksad-ular, an ega namakoed.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Ar Bab-Dummad weyob sogsad:","poem":2},{"text":"“Ar napiragwa, wemar an-dulamalad, mimmigan-an-yardakmalosulidid.”","poem":1},{"text":"Deyobi, e-suli-suli-itogedgine, Bab-Dummad bendaknonikid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Dummad dule-abonogega, dule-e-nuggi-sunmaked, degi, baliwitur, barmiarsulid,","poem":1},{"text":"na e-sunnad dule-abonosad.","poem":2},{"text":"E-sabedgine, degi, e-wile-dule-dakedgine, bendaknonikid.","poem":1},{"text":"Gannarse ogwichisad, na e-ganguedba sesad.","poem":2},{"lineBreak":true},{"text":"Epennegwadyobi deyob imaksad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Degi-inigwele, Israel-dulemar Bab-Jehováʼba ibsassurmalad,","poem":1},{"text":"E-Burba-Isligwaled-wile-itogega imaksamalad.","poem":2},{"text":"A-ulale, Bab-Jehová Israel-dulemar-e-isdaradga gunonikid,","poem":1},{"text":"Bab-Dummad e-sunnad egi bila-onosad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"E-dulamar, epenne neg-gusmalad-ebinsadmalad,","poem":1},{"text":"degi, Moisés-ibagangi neggusad-ebinsadmalad, weyob sogdemalad:","poem":2},{"text":"“Dule demar-obakega anmar-idunadap-gusadi, emide, ¿bia gudii?","poem":1},{"text":"Dule Israel-dulemar-e-iduedi, ¿bia nade?","poem":2},{"text":"Bab, E-Burba-Isligwaled-Moisésʼgi-mesisad, ¿wede bia nade?","poem":1}]},{"type":"verse","number":12,"content":[{"text":"Dule e-gangued-nikadba Moisés-argan-nuedsik, Moisésʼba nadapigusad, emide, ¿bia nade?","poem":2},{"text":"Bab, dulemar-asabin demar-egasad,","poem":1},{"text":"adi, degisadegu e-nug-dummarba-guega, ¿wede bia nade?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Igi-moli nega-dulesulidganba gwen ibmargi-yolesuli nadapdae,","poem":1},{"text":"deyobi, muu-billi-odinnosadba dulemar-obakega-imaksadi, ¿wede bia nade?”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Igi-moli-bebe-nikamalad nebase gagan-manonidamala, deyobi,","poem":1},{"text":"Bab-Jehová-E-Burba, Israel-dulemarga obunnoged uksad.","poem":2},{"lineBreak":true},{"text":"Bab-Jehová, be-nug-dummarba-guega, weyobi, be-dulamar-idumai be gusad.","poem":2}]},{"type":"heading","content":["Bendaklegega Bab-Dummadse goled"]},{"type":"verse","number":15,"content":[{"text":"Bab-Dummadye, mogir-billi-akale, be nue atake.","poem":1},{"text":"Be-neggandikid-islidikid-yeerdakleged-akale, be nue negdake.","poem":2},{"text":"¿Bia be-sabed-dummarbad, degi, be-gangued nade?","poem":1},{"text":"Be-wile-dule-daked, degi, be-sabgued anmar daksulid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Degi-inigwele, be, anmar-Babad,","poem":1},{"text":"ar Abraham amba aku-anmar-dakele, degi, dad-Israel amba aku-anmar-dakbalile,","poem":2},{"text":"be, Bab-Jehová, be anmar-Babad.","poem":1},{"text":"Gusgu be Anmar-Ollor-Imakedye nugad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bab-Jehová, ¿ibiga be-igargi banguega be anmar-imake?","poem":1},{"text":"Bab-Jehová, ¿ibiga be, mer be-dobgumalaga, anmar-gwage-dutusur imake?","poem":2},{"text":"Be-maigan-sabed-ulale, be gannar dage.","poem":1},{"text":"Be-dulamar-danar-danar-bukwad-sabed-ulale, be gannar dage.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Be-dulamar ichesaale be-neg-islidikid akwisad.","poem":1},{"text":"Emidi, anmar-isdarmalad bela be-neg-islidikidyaba ubosad.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Emidi, anmala, be-anmar-dummad-iduedga-megissulidyob bukwad.","poem":1},{"text":"Anmala, begadga-gussulidyob bukwad.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/62.json","previousChapterAudioLinks":{},"numberOfVerses":19}