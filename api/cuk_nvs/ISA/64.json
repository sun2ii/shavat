{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":64,"content":[{"type":"verse","number":1,"content":[{"text":"Anmar-Bab-Dummadye, bitigi be nibneg egasana gadin,","poem":1},{"text":"bitigi be aidealina gadin.","poem":2},{"lineBreak":true},{"text":"Ar be-abin yarmar giglimakdeled.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Be-isdarmalad-abargi be-nug be oyodele,","poem":1},{"text":"igi soo sapan-ogader dii-ogwakgwarmakdae,","poem":2},{"text":"deyobi, be-abin dulemar-yar-baid-baidgi-bukmaladi gudmalaled,","poem":1},{"text":"be-abin wawanmakdemalaled.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Be aidenonigu, ibmar-geger-itolemalad, ibmar-gegerdaklemalad, anmar abdakbuksulid be imaksad,","poem":1},{"text":"be-asabin yarmar giglimakded.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Negasaila-akale, dule-egi-bensurmaladga ibmar-dummagan-imaked dakledisulid,","poem":1},{"text":"dule-baid-beyobid gwen itoledisurbalid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dule-weligwaledgi-igar-innikigwad-imakdiid be abingaed,","poem":1},{"text":"be-igarba-nanadimalad be abingabalid.","poem":2},{"text":"Ar anmar isgussoggu, be sae-itoded.","poem":1},{"text":"Ar anmar dikasurgus isguedginbi gudidimalad.","poem":2},{"text":"¿Ar wede anmar sunna abonolede?","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Ar anmarde bela ibmar-isganayob gumalad.","poem":2},{"text":"Bela anmar-igar-inniki-imakedi, siamar-yokor-bisgemalad-e-mor-ebusadyob gued.","poem":1},{"text":"Bela anmar gagan-dinguedyob gumalad.","poem":2},{"lineBreak":true},{"text":"Anmar-isguedi, burwayobi anmar-oseleged.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dule-wargwensaale, be-nug obarsulid,","poem":1},{"text":"begi-bendakleged-amiegala gwen gandik-imaksurmarbalid.","poem":2},{"text":"A-ulale, be-wagar be anmar-idu odukusad,","poem":1},{"text":"degi, anmar-isguedba-berguega be anmar-imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Degi-inigwele, Bab-Jehová, bee be anmar-Babad.","poem":1},{"text":"Anmar napsa gumalad.","poem":2},{"text":"Bedi napsa-sobedga gued,","poem":1},{"text":"bela be anmar-obinnisad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Jehová, melle be bela-bela sae-itoge.","poem":1},{"text":"Melle be degisadegu anmar-isgued ebinsadii gue.","poem":2},{"text":"Wis be wile-anmar-dake,","poem":1},{"text":"ar anmar bela be-dula gumalad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Be-neggweburmar-islidikmalad nega-dulesulidganga gunonikid.","poem":1},{"text":"Siónʼse-bakale, nega-dulesulidganga gunonikid,","poem":2},{"lineBreak":true},{"text":"Jerusalén-neggwebur ollobi-daarmakarnai gunonikid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Anmar-bese-goled-neg-yeerdakleged-islidikid, bia an-babgan bega namakbukdamala, bela soose gummaksa siid.","poem":1},{"text":"Bela anmar-ibmar-bur-nuegan-nikadi, bergusad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bab-Jehová, weyob-ibmarmar-gusadgine, bede, ¿gwen ibmar akar imakosuli?","poem":1},{"text":"Bede, ¿ibmar sogosurde? ¿Binsarsunna be bukib-binsaega anmar-imakode?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/63.json","previousChapterAudioLinks":{},"numberOfVerses":12}