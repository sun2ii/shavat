{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":65,"content":[{"type":"heading","content":["Uayasulidamalad-odurdaklegoed"]},{"type":"verse","number":1,"content":["Bab-Jehová soged:",{"text":"“Dule-an-egisdisurmaladse an magarosad, an doa-dule gue.","poem":1},{"text":"Dule-an-amidisurmalad an-amiega an imaksad.","poem":2},{"text":"Dule-baigan-an-nug-odummodisurmaladga, an sogsad,","poem":1},{"text":"wegi an gwichiye.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dule-uayasulidamaladse, igar-isganaba-nadapmaladse, e-binsaedba-nanadimaladse,","poem":1},{"text":"bane-bane, an-argan an oyomai gusanad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"We-dulemar, bali-bali an-ourwega an-imakmalad.","poem":1},{"text":"Dutugalumargine, bab-dummadyob-ibmar-imaklemaladga ibmar ukmalad.","poem":2},{"lineBreak":true},{"text":"Ibmar-ogumakar-ukleged-ailamargi, ina-wawadikmalad ogumakmalad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"We-dulemar, neg-uangi sigmalad,","poem":1},{"text":"mutikidbali, dukuar oibosii damalad.","poem":2},{"text":"Sin-san gundamalad,","poem":1},{"text":"e-esmedmargi ibmar-nis-isgana dudamalad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"We-dulemar sogmalad: ‘¡Be anmargi bannabagudii samalo!","poem":1},{"text":"¡Melle be anmarse walikaa gumalo!’","poem":2},{"lineBreak":true},{"text":"An bemarba bela-bela dule-islidikid gued.","poem":2},{"lineBreak":true},{"text":"”We-dulemar, waayobi gwen-nabir-ito an-asu-imaksulid,","poem":1},{"text":"bane-bane soo-duurmaksiiyob gued.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"An-asabin bela e-ibmar-imaked narmakar naid, an sunmaksuli guosulid.","poem":1},{"text":"An sabsur-odurdakoed, na nunmak itomaloed.”","poem":2}]},{"type":"verse","number":7,"content":["Bab-Jehová soged:",{"text":"“Bemar-isgued-ulale, degi, be-babgan isgusad-ulale, an sabsur-be-odurdakoed.","poem":1},{"text":"Ar we-dulemar yar-birgi ina-wawadikmalad-ogumakdii gusmalad,","poem":2},{"text":"yar-mullugangi angi-gwisgudii gusmalad.","poem":1},{"text":"Epenne e-ibmar imaksamaladba, na dukin sabsur-odurdaklemalaga an imakoed.”","poem":2}]},{"type":"verse","number":8,"content":["Bab-Jehová weyob soged:",{"text":"“Dule-wargwen uva-san-dukgwen-nued-amisale, sogdaed:","poem":1},{"text":"‘An oichogosurye, ar ade, amba nis nikaye.’","poem":2},{"text":"Deyopira, an an-maimar-sabed-ulale,","poem":1},{"text":"belamakale, an-maimar an obelogosulid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jacob waganmar-nikuega an imakoed,","poem":1},{"text":"Judáʼgi, dulemar-an-yarmar-gamaloedi, an onidagoed.","poem":2},{"text":"Anse-sulegarmaladi we-napaneg gamaloed,","poem":1},{"text":"a-napagine, an-maimar megmaloed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"An-dulamar-an-amidimaladga, Sarón-neba sibad-wawaad-galuga guoed,","poem":1},{"text":"Acor-neba-naidi, moli-bebe-nikamalad-galuga guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”Ar bemar angi-banguddamaladdi, bemar an-yala-islidikid-ieddamaladdi,","poem":1},{"text":"es-suidgi-oburgwilegega an be-imakmaloed.","poem":2},{"text":"Bemar bab-dummad-ibmar-bukidar-ukedgala, degine, bab-dummad-deyob-guoye-sogmaidgala,","poem":1},{"text":"guagwar mas, degi, vino ukdamaladdi,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"es-suidgi-oburgwilegega an be-imakbaloed.","poem":1},{"text":"Bela bemar dukar-egwallegega sindigar sigmaloed.","poem":2},{"text":"Ar an bemarse gochamalanad,","poem":1},{"text":"bemardi gwen an-abin-imaksasurmalad.","poem":2},{"text":"An bemarga sunmaksanad,","poem":1},{"text":"bemardi, gwen an-itossurmalad.","poem":2},{"text":"Aka bur an-asabin ibmar-isgana imaksamalad,","poem":1},{"text":"degi, an-ibmar-abesulidi bemar imaksabalid.”","poem":2}]},{"type":"verse","number":13,"content":["A-ulale, Bab-Jehová-Bur-Gangued-Nikad weyob soged:",{"text":"“An-maimar mas-gunmaloed,","poem":1},{"text":"bemardi, ukudmaad gudigumaloed.","poem":2},{"text":"An-maimar gobed-nika gudimaloed,","poem":1},{"text":"bemardi, gobedsuli gudigumaloed.","poem":2},{"text":"An-maimardi, weligwar-itodii gumaloed,","poem":1},{"text":"bemardi, bingedar-itodii gumaloed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"An-maimar weligwaledgi namakmaloed,","poem":1},{"text":"bemardi, suli-suli-itogedgi binnasuli gormaloed,","poem":2},{"lineBreak":true},{"text":"nue wiles-itogedba akiginmaloed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Anse-sulegarmaladi, emar-ukabsamalaga bemar-nug ebumaloed.","poem":1},{"text":"Ani Bab-Dummad-Jehová-Bur-Birigined bemar-oburgoed,","poem":2},{"lineBreak":true},{"text":"ar an-maimargardi, nug-baid an ukoed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dule, neggweburgi ise-nued-binsaleged egichialile, an-innikigwad-gued-nuggi egisoed.","poem":1},{"text":"Dule, neggweburgi ise-sogar-ibmar-imakalile, an-innikigwad-gued-nuggi imakoed.","poem":2},{"text":"Suli-suli-itolesadi, bela ielesad,","poem":1},{"text":"an-asabin an bela elisad.”","poem":2}]},{"type":"heading","content":["Nibneg-binid, napneg-binid"]},{"type":"verse","number":17,"content":["Bab-Jehová weyob soged:",{"text":"“Nue an-itomalo.","poem":1},{"text":"An nibneg-binid, napneg-binid, an obinyesokalid.","poem":2},{"text":"Ibmar-nasmalad bar obarilegosulid,","poem":1},{"text":"bar egi binsalegosurbalid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"An-ibmar-obinyesokalidba bur be weligwar-itomala,","poem":1},{"text":"degisadegu be yeer-itomala.","poem":2},{"text":"An Jerusalén-neggweburga yeer-itoged nasiksokalid,","poem":1},{"text":"an e-dulemarga weligwar-itoged uksokalid.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"An Jerusalén-neggweburba, weligwar itogoed,","poem":1},{"text":"an-dulamarbo an yeer itogoed.","poem":2},{"text":"Jerusalénʼgi bar boed itolegosulid,","poem":1},{"text":"deginbali, suli-suli-itogedba-gormaked bar itolegosurbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"”Jerusalénʼgi mimmigan gwalulesale, bipigwadgi bar burgosurmalad,","poem":1},{"text":"deginbali, dadormar bar sapingwaa burgosulid, selebaa megmaloed.","poem":2},{"text":"Ar dule birga-dulatar-nika (100) burgwele, amba nuchukwaa burgwisye soglegoed.","poem":1},{"text":"Ar dule birga-dulatarse (100) warmaksasulirdi, dule-isganaye egi soglegoed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"An-dulamar, negmar sobmaloed, egi megmaloed.","poem":1},{"text":"Uva-dubmar digmaloed, e-san gunmaloed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Dule-baid-megega neg bar sobosurmalad.","poem":1},{"text":"Deginbali, dule-bamalad uva-san-gunnega, uva-dubmar bar digosurmarbalid.","poem":2},{"text":"Ar an-dulamar-e-ibagan, sapimar-ibaganyob guoed.","poem":1},{"text":"Anse-sulegarmaladi, na e-ibmar-imakmaladgi yeer itomaloed.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Binsarsunna arbanai guosurmalad,","poem":1},{"text":"deginbali, mimmigan-wiogega, mimmigan nikuosurmalad.","poem":2},{"text":"An-dulamar na e-sunnagwad, degi, e-waganmoga,","poem":1},{"text":"Bab-Jehová egi ise-nued-binsasad-dulemarga guoed.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Anse-goled-iduale, ani an abinsaoed.","poem":1},{"text":"Amba sunmaknanaidgine, bato an itogoed.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Achu-sapur, sibad-wawaad-senigwadbo mas-gundii gumaloed.","poem":1},{"text":"Achumigur-nono-wawaad, moli-bebe-nikad-alugwasualedyob gagan-madii guoed,","poem":2},{"lineBreak":true},{"text":"degi, naibe unnila ukub-burubi madii guoed.","poem":2},{"text":"Bela an-yar-islidikidgine, dule, dule-baid-onailiksadii guosulid,","poem":1},{"text":"degi, ibmar-obelodii guosurbalid.","poem":2},{"lineBreak":true},{"text":"Ani an Bab-Jehová-guedi deyob soged.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/64.json","previousChapterAudioLinks":{},"numberOfVerses":25}