{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":66,"content":[{"type":"heading","content":["Bab-Jehová-e-igar-naboged, degi, Sión-yala-gannar-sigoed"]},{"type":"verse","number":1,"content":["Bab-Jehová weyob soged:",{"text":"“Nibnega an-ologana gued,","poem":1},{"text":"napneg an-nag-onakwed gued.","poem":2},{"text":"¿Ibi-neg be anga sunna sobsamarsunnale?","poem":1},{"text":"An-obunnoged-neg, ¿bia be anga sobmalosunna?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ani Bab-Jehová soged: Ar belagwable we-ibmarmar ani an obinnisad,","poem":1},{"text":"deyobi nagunonikid.","poem":2},{"lineBreak":true},{"text":"”Ani an dule-wilemalad, dule-suli-suli-itodimalad,","poem":1},{"text":"degi, an-gayaburbaba binsaed-nika-nanadimalad, an yeer-daked.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ar dulemar anga moli-bebe-nikad-machered ogumakar ukedi,","poem":1},{"text":"dule-gindakmaladyob gumalad.","poem":2},{"text":"Ar dulemar anga sibad-wawaad-senigana-oburgwedamaladi,","poem":1},{"text":"bab-dummadyob-imaklemaladga achu-nono-bisgar-ukmaladyob gumalad.","poem":2},{"text":"Ar dulemar anga ibmar-gwag ukdamaladi,","poem":1},{"text":"bab-dummadyob-imaklemaladga sin-ablis-ukdamaladyob gumalad.","poem":2},{"text":"Ar dulemar an-nug odummogega anga ina-wawadikid obupurmakdamaladi,","poem":1},{"text":"bab-dummadyob-imaklemalad-e-nug-odummomaladyob gumalad.","poem":2},{"text":"We-dulemar na dukin e-itolegedba igar susmalad,","poem":1},{"text":"e-ibmar-isgana-imakedgi na yeer itodimalad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"An ega sabsur-odurdakleged ukmogoed,","poem":1},{"text":"bela-belad-ibmar-dobmalad an egi barmidoed.","poem":2},{"text":"Ar an gochagua, gwen dule an-abin-imaksasulid.","poem":1},{"text":"Ar an sunmaksagua, gwen dule an-itossulid.","poem":2},{"text":"Aka bur an-asabin ibmar-isgana imaksamalad,","poem":1},{"text":"an-ibmar-abesulid imaksamarbalid.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bemar Bab-Jehová-gayaburba-dobee-nanadimalad, Bab-Jehová-gayaburba be itomala:","poem":1},{"text":"“Be-gwenadgan-sae-be-dakdimaladi, degi, an-nug-ular-be-obandimaladi, dodoakwaa weyob sogmalad:","poem":2},{"text":"‘Bab-Jehová, e-gargangued oyoge,","poem":1},{"text":"adi, anmar bemar-weligwar-itoged dakegar.’","poem":2},{"lineBreak":true},{"text":"Ar isdar-be-dakmaladdi bingegumaloed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Neggwebur-akale, gayaburba binnasuli goled,","poem":1},{"text":"Bab-Dummadse-goled-neggi gayaburba goled:","poem":2},{"text":"“We-gaya, Bab-Jehová-gayaburba gued,","poem":1},{"text":"e-isdarmaladga sabsur-ibmar sognaid.”","poem":2}]},{"type":"verse","number":7,"content":["Bab-Jehová soged:",{"text":"“Jerusalén, boni-itodaged-iduale, bato mimmi nikusad.","poem":1},{"text":"Jerusalén, yoo-bonigan-itodaged-iduale, goe-susugwa baksad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"¿Doa weyob ibmar-soglege itodii?","poem":1},{"text":"¿Doa weyob ibmar-oyolege dakdii?","poem":2},{"text":"¿Ar dulemar-yargi-bukued ilagwen-bukuar bukusi?","poem":1},{"text":"¿Ar neggwebur-gwagwen ukiagwale gwalulesi?","poem":2},{"lineBreak":true},{"text":"Degi-inigwele, Sión-yardi abga-bonigan-itoaliyalaba mimmigan nikusad.”","poem":2}]},{"type":"verse","number":9,"content":["Bab-Jehová soged:",{"text":"“Ar ani an sikwi-aidegega imaked,","poem":1},{"text":"degite, ¿an geg sikwi-odegega imakde?","poem":2},{"text":"Ar ani an dula-nikuega-imaked,","poem":1},{"text":"degite, ¿an sikwimar-aideged-igar gaode?","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Bemar, Jerusalén-neggwebur-sabmaladi, Jerusalénʼba be weligwar-itomala,","poem":1},{"text":"e-ular, be yeer-itomala.","poem":2},{"text":"Bemar, Jerusalénʼba bukib-binsadimaladi, be weligwaledgi ichomakmala.","poem":1}]},{"type":"verse","number":11,"content":[{"text":"Ar Jerusalén-neggwebur nanyobi e-mamgi be-onumaloed, immerbaa be gumaloed.","poem":2},{"text":"E-nunis-ena-ena-nanaid immelegedse bemar gobmaloed,","poem":1},{"text":"egi be nue-yeer itomaloed.”","poem":2}]},{"type":"verse","number":12,"content":["Ar Bab-Jehová weyob soged:",{"text":"“An Jerusalén-neggweburgi dii-nollosur-aryomaidyobi gwage-bogidikid nasikoed.","poem":1},{"text":"Dulemar-yar-baigangi-bukmalad-e-ibmar-nuegan diwar-engumaidyobi, Jerusalénʼga-ukega an imakoed.","poem":2},{"text":"Jerusalén, goemaryobi mamgi be-onumaloed,","poem":1},{"text":"e-sakwagi angaagwar be-semai guoed,","poem":2},{"lineBreak":true},{"text":"e-nukugi be-mesmaloed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nan igi na e-mimmi-gwage armake, deyobi an bemar-gwage armakoed.","poem":1},{"text":"Bemar Jerusalén-neggweburgi gwage armaklemaloed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Bemar weyob ibmar-dakalile, gwagegi bemar weligwar itodmaloed,","poem":1},{"text":"gagan-aramakdedyobi bemar gannar gannaledmaloed.","poem":2},{"text":"Bab-Jehová e-maimar-abargi e-gangued oyogoed,","poem":1},{"text":"e-isdarmalad-abargi e-urwed oyogoed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bab-Jehová bato soo-abargi danikid.","poem":1},{"text":"E-bila-onoged-ur-napagined burwa-ooredyob dakleged.","poem":2},{"text":"Bab-Dummad, e-sae-itoged urwedgi oyononikoed,","poem":1},{"text":"e-sabsur-odurdaked soo-aramakwichiyob guoed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bab-Jehová, bela dulemarga soogi, degi, es-suidgi igar-nabogoed.","poem":1},{"text":"Bukidar Bab-Jehováʼse burgwemaloed.","poem":2}]},{"type":"verse","number":17,"content":["Bab-Jehová soged: “Dulemar-san-islidik-imakmaladi, degi, san-swilidik-imakmaladi, dule-negabargi-nadapidba nadapmalad, adi, bab-dummadyob-imaklemalad-dudumar-galuse-dogega. Bela-wemar na mesa burgwemaloed. Dulemar-sin-gunmalad, nusa-gunmalad, degi, ibmar-baigan-isemalad-gunmalad, bela-mesa bergumaloed."]},{"type":"verse","number":18,"content":["”Ani, an e-ibmar-imaked-ulale, degi, e-binsaed-ulale, bela dulemar-yar-baid-baidgi-bukmalad, degi, gaya-akar-akar-sunmakmaladi oatosokalid. We-dulemar danimaloed. An-gangued-yeerdakleged dakmaloed."]},{"type":"verse","number":19,"content":["”An ega wilub-oyogoed, abala dule dula-bemaloedi, we-yarmarse an barmidoed:",{"text":"Tarsisʼse, Futʼse,","poem":2},{"lineBreak":true},{"text":"Ludʼse (we-dulemarde sigu-mied-dulemalad),","poem":2},{"lineBreak":true},{"text":"Tubalʼse, Javánʼse,","poem":2},{"lineBreak":true},{"text":"dikasur demar-gakaba-neggwebur-bukmalad an-nug-itodisurmaladse,","poem":2},{"lineBreak":true},{"text":"degi, an-gangued-yeerdakleged-dakdisurmaladse an barmidoed.","poem":2},"”Wemala, dulemar-yar-baid-baidgi-bukmaladga, an-gangued-yeerdaklegedgi sunmakmaloed."]},{"type":"verse","number":20,"content":["Dulemar be-gwenadgan-yar-baid-baidgi-gudidimalad, an-yala-islidikid-Jerusalénʼse, anga ibmar-uklegedyobi seledagega imakmaloed:",{"text":"Abala, molimargi be-gwenadgan-sedamaloed.","poem":2},{"lineBreak":true},{"text":"Bamaladdi, moli-ur-napagined-bila-onomaladgi,","poem":2},{"lineBreak":true},{"text":"e-gabmaladgi,","poem":2},{"lineBreak":true},{"text":"moli-uaya-senigwadmargi,","poem":2},{"lineBreak":true},{"text":"degi, moli-yargan-muremaladgi sedamaloed.","poem":2},"”Ar igi-Israel-dulemar anse-goled-negse bormo-swilidikidgi anga ibmar-gwag-ukleged sedanidamala, deyobi, be-gwenadgan-sedamaloed. Ani Bab-Jehová deyob soged."]},{"type":"verse","number":21,"content":["”We-be-gwenadgan-seledamaloedi, abala dule-irwa-anse-golemaladga, degi, Levita-dulemarga an suoed."]},{"type":"verse","number":22,"content":["Ar igi an-asabinni nibneg-gwapid, degi, napneg-gwapid degisadegu-nai-guoe, deyobi, be-waganmar degisadegu-bukwa an imakoed. Degi, bemar-nug degisadegumogoed. Ani Bab-Jehová deyob soged.”"]},{"type":"verse","number":23,"content":["Bab-Jehová soged:",{"text":"“Nii-binid-gwisgued-ilibali, degi, obunnoged-ibagan-ilibali, bela dulemar an-nug-odummodii gumaloed.","poem":1}]},{"type":"verse","number":24,"content":[{"text":"Ainidmaloed, geb dule-angi-gwisgusmalad-e-muigan omilede dakmaloed.","poem":2},{"lineBreak":true},{"text":"”Ar nus-e-san-gunnedi gwen burgosulid,","poem":1},{"text":"deginbali, soo-e-san-ogumaknaidi gwen ginnosurbalid.","poem":2},{"lineBreak":true},{"text":"Bela dulemarga ibmar-imadga guoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JER/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/65.json","previousChapterAudioLinks":{},"numberOfVerses":24}