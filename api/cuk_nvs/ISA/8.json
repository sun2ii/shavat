{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":8,"content":[{"type":"heading","content":["Bab-Jehová-dobekwaa be nanamar"]},{"type":"verse","number":1,"content":["Bab-Jehová anga sogsad: “Urgo-matar-dummad be sue, agine be nug-narmako, nuekwaa magar-daklege be narmako. ‘Maher-Salal-Hasbazʼye be narmako.’"]},{"type":"verse","number":2,"content":["Degine, dule-irwa-anse-goled-Urías, degi, Jeberequías-machi-Zacarías, be-barsoged-innikigwadga-gumalaga an bega amioed.”"]},{"type":"verse","number":3,"content":["Geb agine, an Bab-gayaburba-barsoged-bundorse an gochad, geb gurgin-nika gunonikid, geb susugwa ega uklenonikid. Geb degi, Bab-Jehová anga sogded: “Maher-Salal-Hasbazʼye be onugsae."]},{"type":"verse","number":4,"content":["Ar mimmi nanaye-gordagoed-iduale, babaye-gordagoed-iduale, bela Damasco-neggwebur-e-ibmar-nuegan-nikadi Asiria-e-reyse sulegoed. Degi, Samaria-neggwebur-ibe ibmar-nuegan seledbaloed.”"]},{"type":"verse","number":5,"content":["Bab-Jehová gannar anga sogdebalid:"]},{"type":"verse","number":6,"content":[{"text":"“We-Judá-neggwebur, Siloé-dii-binnalee-aryomaidgi bangudmalad,","poem":1},{"text":"bur Rezín-dobee nanadmalad,","poem":2},{"lineBreak":true},{"text":"bur Remalías-machi-dobee gudmalad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"A-ulale, Bab-Dummadi, we-dulemargi Éufrates-diwala-dummad onosokalid:","poem":1},{"text":"Ar Asiria-e-rey, bela e-garganguedba, Judá-yalagi-yolegega barmidagoed.","poem":2},{"text":"Bela e-diangan-mamaid odogoed,","poem":1},{"text":"bela e-dii-gakamar akudaklege imakoed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Judá-yalase, bela swada-dogoed,","poem":1},{"text":"dii dukarba-engus naguoed.","poem":2},{"text":"¡Emanuel! Be-yala-naidgi, Asiria-sordamar dognonikoed.","poem":1},{"text":"We-Asiria-rey sulubagi-sakan-nalla-napase-aidedanidaedyobi, begi dognonikoed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dulemar-yar-baid-baidgi-bukmalad, bela-yar-baid-baidgi-dikasur-bukmalad,","poem":1},{"text":"we-ibmar-an-sogoedi nue be itomalo:","poem":2},{"text":"Aisaar bemar bila-onodamaloenad,","poem":1},{"text":"degi-inigwele, be bergumaloed.","poem":2},{"text":"Aisaar be guagwar bila-onoged-iduar bukumaloenad,","poem":1},{"text":"degi-inigwele, bemar girgumaloed.","poem":2},{"text":"Aisaar be guagwar bila-onoged-iduar bukumaloenad,","poem":1},{"text":"Degi-inigwele, bemar nue-ibitomaloed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Be igarmar-amimalo-inigwele, bega igarga guosurmalad.","poem":1},{"text":"Aisaar be ibmargi sunmakmalo-inigwele, bega igarga guosurmalad.","poem":2},{"lineBreak":true},{"text":"Ar ade, Bab-Dummad anmarba gudiid.","poem":2}]},{"type":"heading","content":["Be Bab-Dummad-dobegwa nanae"]},{"type":"verse","number":11,"content":["Bab-Jehová weyobi anga sabsur ibmar sogsad, iduakwaa anga sogsad, melle we-dulemar-daedba be nanaoye. Weyob anga sogsad:"]},{"type":"verse","number":12,"content":[{"text":"“Melle bemar we-dulemar-sogedyob be sogmalo, we angi gwisgunaye.","poem":1},{"text":"Ar bela ibmarmar-guedi, egi gwisgunaiye sogdamalad.","poem":2},{"text":"Melle be we-dulemar-ibmar-dobedi, dobgumalo,","poem":1},{"text":"melle be gwayebalo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Unnila be ani Bab-Jehová-Bela-Gangued-Nikadbi dobguo,","poem":1},{"text":"bur be anga islidik nanamalo.","poem":2},{"text":"Unnila an-nugbi be odummomalo,","poem":1},{"text":"unnila anbi be dobgumalo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ani an bemar-neg-islidikidga guoed.","poem":1},{"text":"Degi-inigwele, Israel-dulemar-sogabogwadga akwasailaga an guoed,","poem":2},{"text":"adi, agi goo-warmakmalagar.","poem":1},{"text":"A-akwa-dummad, dule-omukuedga guoed.","poem":2},{"text":"Jerusalén-dulemar-idu sakinaiyobi an naguoed,","poem":1},{"text":"amar-idu galu-ibmar-gaed-siidyob an guoed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bukidar goo-warmakmaloed,","poem":1},{"text":"bukidar aimukumaloed,","poem":2},{"text":"bukidar wilemaloed.","poem":1},{"text":"Sakigi-galesayobi, ibmar-gaed-galugi-galesayobi, gales nagumaloed.”","poem":2}]},{"type":"verse","number":16,"content":["Geb degi, Isaías, eba-nanaimaladga sogded:",{"text":"“An bemarga ibmar-sogsamaladi, gwagegi be sedii imakmalo.","poem":1},{"text":"An be-odurdaksamalad, melle be sogmalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"”Ar Bab-Jehová, urwedba Jacob-wagan-idu wagar-aibiris sigisad.","poem":1},{"text":"Bab-Jehováʼgi an benguosulid,","poem":2},{"lineBreak":true},{"text":"ar an wisid, an egi bendaklegoe.”","poem":2}]},{"type":"verse","number":18,"content":["Be an-dakmalana, emisgindi wegi an Bab-Jehová-anga-mimmigan-uksadmala an gudiid. Anmar, Israel-yargi, Bab-Jehová-Bela-Gangued-Nikad-Sión-yalagi-maidga ibmar-guoed-e-wilubga gumalad, iduakwaa-ibagan-guoed-sogedga anmar ega gumalad."]},{"type":"verse","number":19,"content":["Dule bemarga sokarmalale: “Dule-ibmar-e-burbagan-wismaladse be ibmar-wilubagan egisnamarye, yoedse-ibmar-guoed-barsogmaladse be ibmar-wilubagan egisnamarye.” Weyob be sogo: “¿Ar dulemar e-bab-dummaganse geg idakmarsogeye? ¿Ar dulemar dule-burgwarmaladse geg idakmarsogeye?”"]},{"type":"verse","number":20,"content":["An bemarga sogdo: “Bab-Dummad-Igar-Mesisadgi bur be nanamalo, e-ibmar-sogsadgi bur be binsamalo.” Ar dule, we-igarmargi-nanasulile, igar-napiragwad amiosulid."]},{"type":"verse","number":21,"content":["Bemar, napneggi suli-suli-itoarmalale, ukudmaada-itoarmalale, be uludamaloed. Niba atakgwichi, be-reygi be gwisgudmaloed, Bab-Dummadgi be ukabsaar sunmakdemaloed."]},{"type":"verse","number":22,"content":["Be napneg-dakdagogua, unnila boniganbi-nai be dakdemaloed, negsichidbi-nai be dakdemaloed. Bemar negasichidginbi-gudii gumaloed."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}