{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":9,"content":[{"type":"heading","content":["Mimmi-gwensak anmarga gwalules"]},{"type":"verse","number":1,"content":["We-ibmarmar-guoed-sorbali, dule-suli-suli-itodigusadga bar negsichid naguosulid. Epennegwa, Bab-Dummad, Zabulón-dulemar-yala sabsur-odurdaksa gusad, Neftalí-dulemar-yala sabsur-odurdaksa gusbalid. We-yarmar Galilea-yargi bukwamalad. Yoedsega, Galilea-yargi nued binsanonikoed, e-nug-dummarbaa imakoed. Galilea-yala, Jordán-diwarsik, degi, demarse-nalemaidsik naid. A-yalagi, dule-Bab-wissurmalad bukwad."]},{"type":"verse","number":2,"content":[{"text":"Dulemar-negsichidgi-gudigusmaladi, neg-meegwad daksamalad.","poem":1},{"text":"Negsichidgi-bukwagusmaladga, neg mee gunonikid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová, bee be, dulemar-omelosad,","poem":1},{"text":"bee be, bela-bela-weligwar-itogega imaksad.","poem":2},{"text":"Igi dule ibmar-gwag-weenaile, weligwar itodae,","poem":1},{"text":"deyobi, be-asabinni weligwale na itomaloed.","poem":2},{"text":"Igi dule ibmar-nuegan-miminaile, weligwar itodae,","poem":1},{"text":"deyobi, be-asabinni weligwale na itomaloed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bee be, dulemar-wilebukwagusad ollor-imaksad,","poem":1},{"text":"sabsur-imaklebukwadgi be bendaksad,","poem":2},{"lineBreak":true},{"text":"mesagwar-imaklebukwadgi be ollor-imaksad.","poem":2},{"text":"Ar igi be, Madián-dulemar-obelosgusa,","poem":1},{"text":"deyobi, be e-isdarmalad imaksad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bila-onolegedgi-sapat-yolesmaladi, degi, bela mor-ablisbi-gusmaladi, soo-yagi ogumaklegoed,","poem":1},{"text":"sooga bela binyoed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ar susugwa-gwensak anmarga gwalulesad,","poem":1},{"text":"mimmi-gwensak anmarga uklesad.","poem":2},{"text":"A-machi gandikidba negseoed,","poem":1},{"text":"weyob nugguoed:","poem":2},{"lineBreak":true},{"text":"Binsaed-Daked-Wilub-Obichadye,","poem":2},{"lineBreak":true},{"text":"Bab-Dummad-Bela-Gangued-Nikadye,","poem":2},{"lineBreak":true},{"text":"Bab-Degisadeguadye,","poem":2},{"lineBreak":true},{"text":"Neg-Bogidikid-E-Dummadye, nugguoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"E-gangued bela nasguoed,","poem":1},{"text":"e-neg-bogidik-seoed bela nasguoed, gwen berguosulid.","poem":2},{"text":"David-ologangi dummadga sigoed.","poem":1},{"text":"E-yalagi dummadga negseoed.","poem":2},{"text":"E-negseoedi, igar-napiragwadba yar-seoed,","poem":1},{"text":"innikigwadba negseoed,","poem":2},{"text":"emi-ibase, degisadegu negseoed.","poem":1},{"text":"Bab-Jehová-Bela-Gangued-Nikad we-ibmar-imakoedi, e-sabgued-oyomaidba, deyob imakoed.","poem":2}]},{"type":"heading","content":["Bab-Jehová Israel-dulemarse urwemaid"]},{"type":"verse","number":8,"content":["Isaías, Israel-dulemarga sogdebalid:",{"text":"“Bab-Jehová Jacob-waganse e-gayaburba barmialid,","poem":1},{"text":"Israel-dulemarse e-gayaburba nonikid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"We-ibmar bela dulemar wisgumaloed,","poem":1},{"text":"Efraín-dulemar bela wisgumaloed,","poem":2},{"lineBreak":true},{"text":"Samaria-dulemar bela wisgumaloed.","poem":2},{"text":"Ar we-dulemar-san-dummarba-imakdimalad,","poem":1},{"text":"yeer-sogdimalad,","poem":2},{"text":"weyob sogdimalad:","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"‘Ar negmar ayarele, akarsulid.","poem":1},{"text":"Ar anmar gannar akwagi-nuesaar sobmaloed.","poem":2},{"text":"Ar higuera-sapiwar-nagubirga-mamaid babatidele, baisulid.","poem":1},{"text":"Ar anmar a-muchub urwar mesoed.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”Degi-inigwele, Bab-Jehová, Rezín-sordamargi e-isdarmalad barmidagoed","poem":1},{"text":"Bab-Dummad e-sunnad Rezín-sordamargi e-isdarmalad-gwisguega imakoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Siria-dulemar dad-nakwedsik-bukwadi, degi, Filistea-dulemar dad-argwanedsik-bukwadi,","poem":1},{"text":"ilagwen-obeloga Israel-dulemar-imaksamalad.","poem":2},{"lineBreak":true},{"text":"”Weyob-gus-inigwele, Bab-Dummad-urwedi amba bogigumaisulid.","poem":1},{"text":"Amba Israel-dulemargi urwemaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”Degi-inigwele, dulemar Bab-Dummad-sabsur-e-odurdaksad amba aku daksamalad.","poem":1},{"text":"Bab-Jehová-Bela-Gangued-Nikad e-bendakega gwen amissurmalad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"A-ulale, Bab-Jehová, ibagwen-nuedi Israel-dulemar-obelogoed.","poem":1},{"text":"Ibmar-dula-e-nono-egwanneyobi imakoed,","poem":2},{"lineBreak":true},{"text":"ibmar-dula-e-bunnu-immieyobi imakoed.","poem":2},{"text":"Sapi-ana-sikeyobi imakoed,","poem":1},{"text":"sapi-e-war-immieyobi imakoed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ar ibmar-dula-e-nono, girmar-dummagan-e-wilubganad, dule-nuga-nikamalad-e-wilubganad.","poem":1},{"text":"Ibmar-dula-e-bunnu, Bab-Dummad-gayaburba-barsogmalad-gakansaar-odurdakmaladid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"We-neggwebur-idumaladi, igar-noaledba dulemar-sesmalad.","poem":1},{"text":"Dule-eba-selesmaladi, aku neg-itodmalad, yoggudmalad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"A-ulale, Bab-Jehová, sapingan-gwen-yeer dakosulid,","poem":1},{"text":"dule-sergan-satemalad-gwen-yeer dakosulid.","poem":2},{"lineBreak":true},{"text":"Siamar-ei-sui-burgwismalad-gwen-yeer dakosulid.","poem":2},{"text":"Ar bela wemala, isgumaladbiid,","poem":1},{"text":"ibmar-isgana-imakmaladbiid,","poem":2},{"lineBreak":true},{"text":"galagwensuli sunmakmaladbiid.","poem":2},{"lineBreak":true},{"text":"”Weyob dulemar imakles-inigwele, Bab-Dummad-urwedi amba bogigumaisulid.","poem":1},{"text":"Amba anmargi urwemaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"”Ibmar-isgana sooyobi gued.","poem":1},{"text":"Igi-soo-gadele, gagan-ikobiid bela biin-imake,","poem":2},{"text":"ikomar bela biin-imake,","poem":1},{"text":"deyobi, ibmar-isgana-imaklegedi gued.","poem":2},{"text":"Igi soo-gaedi sapurgi sapi-bukwadi bela obeloge,","poem":1},{"text":"degi, geb burwa-bipirmakaledyob, waa ainakwiddae,","poem":2},{"lineBreak":true},{"text":"deyobi, ibmar-isgana-imakedi gued.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ar Bab-Jehová-Bela-Gangued-Nikad-urwedbali yala duu gadoed.","poem":1},{"text":"Dulemar e-sapanga guoed.","poem":2},{"lineBreak":true},{"text":"Dulemar na e-gwenadgan wiledakosulid.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Gwen-gwen, mas-satedba e-argan-nuedsik ibmar-bukwad gutemaloed.","poem":1},{"text":"Degi-inigwele, amba ukudmaada itomaloed.","poem":2},{"text":"Baigana, e-argan-sapiledsik ibmar-bukwad gutemarbaloed.","poem":1},{"text":"Degi-inigwele, amba immelegosurmarbalid.","poem":2},{"text":"Dulemar e-mimmigangi aibitemaloed,","poem":1},{"text":"e-mimmigan-gutemaloed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Manasés, sabsur-Efraín-imakoed,","poem":1},{"lineBreak":true},{"text":"Efraín, sabsur-Manasés-imakmogoed.","poem":1},{"text":"Geb ebobela Judá-yalagi sabsur-gwichigudmaloed.","poem":2},{"lineBreak":true},{"text":"”Weyob dulemar imakles-inigwele, Bab-Dummad-urwedi amba bogigumaisulid.","poem":1},{"text":"Amba anmargi urwemaid.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}