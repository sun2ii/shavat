{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JDG","translationId":"cuk_nvs","name":"Jueces","commonName":"Jueces","title":"DULE-IGAR-NABOMALAD-GARDA JUECES","order":7,"numberOfChapters":21,"sha256":"d74bdc41f60877e46eec0b7c2491d9306b8ae91e1a7ddef416d0be16373ddcc9","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/cuk_nvs/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":5,"content":[{"type":"heading","content":["Débora, Barac-ebo namaksad"]},{"type":"verse","number":1,"content":["A-ibagine, Débora, Abinoam-machi-Barac-ebo namaksad. Weyob namaksamalad:"]},{"type":"verse","number":2,"content":[{"text":"“Israel-dummagan sordagan-idu-nadapile,","poem":1},{"text":"dulemar e-binsaedba bila-onogedgi-urwenadele,","poem":2},{"lineBreak":true},{"text":"Bab-Jehová-nug-odummodii guo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"”¡Reymar, nue be an-itomar!","poem":1},{"text":"¡Dummagan, nue be an-itomar!","poem":2},{"text":"An namaksokalid, Bab-Jehováʼga an namaksokalid.","poem":1},{"text":"Israel-dulemar-e-Bab-Dummad-Jehováʼga an gar-ogorsokalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"”Bab-Jehová, be Seir-yalagangi nodgua, be Edom-nainugangi nadgua, napneg wawanmakde gusad,","poem":1},{"text":"nibneg giglimakde gusad,","poem":2},{"lineBreak":true},{"text":"mogirmar dii owide gusad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová Israel-dulemar-e-Bab-Dummad, be-abin Sinaí-yala wawanmaksagusadyobi,","poem":1},{"text":"Be-abin yalamar wawanmaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"”Dulemar Anat-e-machi-Samgar-ibagangi, degi, Jael-ibagangi, igarmar-dummaganba bar nanassurmalad,","poem":1},{"text":"igar-burwiganba nanadii gusmalad, adi, melle boni-amimalagar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Israel-yalagi neggwebur-burwigana ollo-ollo ambikusad,","poem":1},{"text":"dule-sate ambikusad, an dummadga megnonikidse.","poem":2},{"text":"Ani an Débora, dulemar-anar an gwichigusad,","poem":1},{"text":"Israel-dulemar-e-nanayobi an gunonikid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Dummadye, anmar-Israel-dulemar, bab-dummad-baigan-e-nug-odummosad-ulale,","poem":1},{"text":"be anmar-neggweburmargi bila-onoleged barmiar gusad.","poem":2},{"text":"Israel-sordamar mili-dulabo-bukwad-abargi (40,000), dule gwen sigu-abgaed-yoi bila-ononai daklessulid,","poem":1},{"text":"dule gwen ilawar-swiswidik-annika bila-ononai daklesulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"”Israel-dummaganba an naid,","poem":1},{"text":"dulemar na e-binsaedba bila-onogedgi-urwemaladba an naibalid.","poem":2},{"lineBreak":true},{"text":"¡Bab-Jehová-nug be odummomar!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Bemar moli-uayasuid-ome-sipugwadgi nanamaladi,","poem":1},{"text":"e-birgi mor-nuegangi be sigmaladi,","poem":2},{"text":"be nue dulemar-namaked itomar.","poem":1},{"text":"Degine, bemar nagab-nanamalad, be nue dulemar-namaked itomarmo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dulemar molimar-dii-gobnonidaed-nagaba namakbukwadi, Bab-Dummad-e-igar-innikigwadba-ibmar-imakedgi namakmalad.","poem":1},{"text":"Degi, Israel-sorda-bila-onomalad-igar-innikigwadba-ibmar-imakedgi namakmalad.","poem":2},{"lineBreak":true},{"text":"”Geb Bab-Jehová-e-dulamar, neggwebur-yawagakse nadmalad,","poem":1},{"text":"sogdemalad:","poem":2}]},{"type":"verse","number":12,"content":[{"text":"‘Débora, namake, namake,","poem":1},{"text":"namaklegedgi be namake.","poem":2},{"text":"Abinoam-machi-Barac, ogusa,","poem":1},{"text":"dule-gasmalad be sede.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”Dule-besmaladi, dule-nuga-nikamaladba nonimalad.","poem":1},{"text":"Bab-Jehová-e-sorda-bila-onomaladi, dule-gandikmaladba anse nonimalad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Efraín-sordamar-Amalec-dulemargi-danikid nonimalad,","poem":1},{"text":"a-sorbali, Benjamín-sordamar danigusmogad.","poem":2},{"text":"Maquir-wagan-sorda-dummagan nonimalad,","poem":1},{"text":"Zabulón-neg-akar dule-idumalad-gangued-nikamalad nonimarmogad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Isacar-e-dummagan, Déboraʼba nadmarmogad.","poem":1},{"text":"Baracʼba, Isacar-e-sordagan nadmarmogad,","poem":2},{"text":"bila-onogedgi Baracʼba nebase duurmakdemalad.","poem":1},{"text":"Rubén-e-sordamardi, mer-naega yamo arbaed-dummad onosmalad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"¿Ibiga bemar sibad-wawaad-edarbemalad-e-goled-itogega, sibad-wawaad-e-galugi be besmala?","poem":1},{"text":"Ar Rubén-e-sordamar nue-dobe itosmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"”Galaad-e-sordagandi, Jordán-diwar-obakar besmalad.","poem":1},{"text":"Dan-e-sordagandi, ur-dummagan-walik besmalad,","poem":2},{"text":"Aser-e-sordagandi, demar-gaka-naba besmalad,","poem":1},{"text":"sukunyaba e-urmar-edarbemamai gusmalad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Zabulón-e-sordamala, bila-onogedgi burgwed-naga gusmalad.","poem":1},{"text":"Neftalí-e-sordamala, bila-onogedgi burgwed-naga gusmarmogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"”Canaán-dulemar-e-reymar Taanac-neggweburse nonimalad,","poem":1},{"text":"Meguido-dian-asabin bila-onosmalad.","poem":2},{"lineBreak":true},{"text":"Degi-inigwele, manimala, degi, ibmar-nuegana gwen sessurmalad.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nibaneg-akale, niisgwamar ulusad.","poem":1},{"text":"Niisgwamar e-nanaid-akale, Sísaraʼgi gwichigusad.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Canaán-sordamar, Cisón-diwar obelolesmalad.","poem":1},{"text":"Cisón-diwarde, gusgu dikasurgus-maid.","poem":2},{"text":"Ani an Débora-gued,","poem":1},{"text":"¡Gandikidgi an naoed!","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"”Sísara-e-molimar binnasuli abarmakmamaidba","poem":1},{"text":"e-nagmar binnasuli-gornadapi gusad.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bab-Jehová-e-baliwitur weyob sogded:","poem":1},{"text":"‘Meroz-dulemar be sabsur-ukabsasun.","poem":2},{"text":"We-dulemar gwen Bab-Jehová-sordamar-bendakapsurmalad,","poem":1},{"text":"degi, dule-gandikmaladgi gwen bendakapsurmarbalid.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"”Israel-dulemar-omegan-abargi, Heber-e-ome-Jaelʼgi nued binsalesun,","poem":1},{"text":"omegan-dordonegyaba-bukwamaladba bur bule egi nued binsalesun.","poem":2},{"lineBreak":true},{"text":"Heberʼde Ceneo-duled.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Sísara, Jaelʼse dii-egichis gusad,","poem":1},{"text":"Jaelʼdi moli-nunisgi ogobsad,","poem":2},{"lineBreak":true},{"text":"dule-nuga-nikamaladbi-gobed-noggi moli-nunis-ollikwagwadgi ogobsad.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Jael e-argan-sapiledsik dordoneg-abingaed-suar susgusad,","poem":1},{"text":"e-argan-nuedsik mardo-dummad susgusad.","poem":2},{"text":"Geb a-ibmargi Sísara-sarsosad,","poem":1},{"text":"e-nono daasa imaksad.","poem":2},{"text":"Dordoneg-suargi uaya-matarba Sísara-bioksad,","poem":1},{"text":"daksik-noedse imaksad.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Jael-asabin Sísara sinnii napagi-melleded,","poem":1},{"text":"napagi meremai gusad,","poem":2},{"lineBreak":true},{"text":"napagi-meremai burgwisad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"”Sísara-e-nan, yawagak-bipigwad-dale-daledba atakalid,","poem":1},{"text":"e-machi-yoggud-dakedbali sabsur sogded:","poem":2},{"text":"‘¿Ibiga an-machi-e-ur-napagined yoggumai?","poem":1},{"text":"¿Ibiga e-ur-napaginmalad-goled itolesuli?’","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Omegan-binsaed-ibegan-e-walik-gudimalad ega sunmaksamalad.","poem":1},{"text":"Geb e-nan omegan-sunmaksadba sogdemogad:","poem":2}]},{"type":"verse","number":30,"content":[{"text":"‘Ibmarmar-nued amismarsua, a-miminanairgebed:","poem":1},{"text":"Sordamar-iliba, yagan-war-wargwen mimilenairgebed, igi, war-warbodibe.","poem":2},{"text":"Sísaraʼgardi, mor-nuegan-akar-akar-dakleged uklenairgebed.","poem":1},{"text":"An-dukargi-nasikega mor-akar-akar-dubgi-sobarmalad,","poem":2},{"lineBreak":true},{"text":"mor-yeerdakleged-bela-dubgi-sobarmalad uklenairgebed.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"”Bab-Jehová, bela wegibi be-isdarmalad bergusun.","poem":1},{"text":"Be-sabmaladdi dad-ibeler-gaardaedyob be imako,","poem":2},{"lineBreak":true},{"text":"yorukudba dad-ibeler-gaedyob be sao.”","poem":2},"Degi, bela we-ibmarmar-gusad-sorbali, birga-dulabo (40) Israel-yargi neg-bogidikid nagusad."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}