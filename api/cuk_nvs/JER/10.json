{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JER","translationId":"cuk_nvs","name":"Jeremías","commonName":"Jeremías","title":"JEREMÍAS-GARDA JEREMÍAS","order":24,"numberOfChapters":52,"sha256":"75584cc634e682f16d689c79332a191baf65045db96e9e927452315ef9b2d123","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cuk_nvs/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":10,"content":[{"type":"heading","content":["Bab-Dummad-napiragwad, degi, bab-dummagan-binsarmalad"]},{"type":"verse","number":1,"content":["Israel-dulemar, Bab-Jehová-sunmaked be itomar,"]},{"type":"verse","number":2,"content":["weyob soged:",{"text":"“Dulemar-yar-baid-baidsik-bukmalad-e-daedba melle be damalo.","poem":1},{"text":"Nibneg-akar ibmar-yogasaar-oyolegar-be-dakele, melle be gwayemalo.","poem":2},{"lineBreak":true},{"text":"Dule-bamalad-dobee-itodamaladyob, melle be dobgumalo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ar dulemar-e-bab-dummaganse-goled-igar-maidi binsaled gued.","poem":1},{"text":"We-dulemala, sapurba-nadele, suar-immidamalad,","poem":2},{"lineBreak":true},{"text":"geb dule-ibmar-sobed, esbipigi suar-sobdaed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Geb egi mani matak-matak nasikdamalad,","poem":1},{"text":"ormar matak-matak nasikdamarbalid.","poem":2},{"lineBreak":true},{"text":"Melle-aimukuegala, esgorogi biokdamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"”We-bab-dummagan, ibmar-digar-naidgi, ibmar-sikwimar-ogwayed-gwichidaeyob gued, geg sunmaked.","poem":1},{"text":"We-ibmarmar dule yamo sear imakergebed, geg walagwen nanamalad.","poem":2},{"text":"Melle be we-ibmarmar dobgumalo,","poem":1},{"text":"ar gwen be-oakalogosulid,","poem":2},{"lineBreak":true},{"text":"bemarga gwen ibmar-nued imakosurbalid.”","poem":2}]},{"type":"verse","number":6,"content":["Ani Jeremías sogded:",{"text":"“Bab-Jehováʼye, dule beyobid sulid,","poem":1},{"text":"bedi dule-dummadid, be-nuga gandiki gued.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dule-yar-baid-baidgi-bukwamalad-e-Rey-be-gued, ¿doa be-dobguosuli?","poem":1},{"text":"¡Bela be-dobgumalargebed!","poem":2},{"text":"Ar be dulemar-binsaed-ibegan-abargi, reymar-negsemamaid-abargi, dule-beyobid sulid.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Bela dulemala, gegeganad, binsaedsurmaladid,","poem":2},{"lineBreak":true},{"text":"suar-sobarmalad-ibmarga-gusurmaladse ibmar-durdaksamaladid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tarsis-yala-akale, mani-matargana sedanidamalad,","poem":1},{"text":"Ufazʼye-neg-nugad-akale, olo sedanidamarbalid.","poem":2},{"text":"We-ibmarmargine, bab-dummadyob-imaklemalad sobdamalad.","poem":1},{"text":"Geb ega mor-arad, mor-ginnid makdamalad.","poem":2},{"text":"Dulemar-orgi-arbamaladi, manigi-arbamaladi, degi, ibmar-sobedgi-arbamaladi, bela we-ibmarmar imakmalad.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Degi-inigwele, Bab-Jehováʼdi, Bab-Dummad-napiragwadid,","poem":2},{"text":"Bab-Dummad-dulasaila-maidid,","poem":1},{"text":"e-Reyga-maigu degisadeguadid.","poem":2},{"text":"Bab-Dummad uludele, napaneg ogiglimaked,","poem":1},{"text":"dulemala, e-urwed-abin gege gwisgumalad.”","poem":2}]},{"type":"verse","number":11,"content":["Bab-Jehová sogdebalid: “Jeremías, weyob be Israel-dulemarga sogo: ‘Bab-dummagan-gwen-nibneg-imaksasulidi, degi, gwen napneg-nasiksasulidi, nibneg-urbali bela we-napneggi berguoed.’ ”"]},{"type":"heading","content":["Bab-Jehováʼga namakleged"]},{"type":"verse","number":12,"content":[{"text":"Bab-Dummad, e-ganguedba napneg nasiksad,","poem":1},{"text":"e-binsaed-nikadbali, napneg ilemaksad,","poem":2},{"lineBreak":true},{"text":"e-ibmar-wisidbali, nibneg nasiksad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bab-Dummad sunmakdele, nibneggi diimar uurmakardaed,","poem":1},{"text":"magatibali, mogirmar ainakwiardaed,","poem":2},{"text":"mala-ibyed-abalagi, dii owidaed,","poem":1},{"text":"burwa-galumargi, burwa onidaed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bela dulemar binsaedsulidamaladid,","poem":1},{"text":"aku-neg-itomaladid.","poem":2},{"text":"Bela-dule-orgi-arbamaladi, e-ibmar-sobedgi bingedar itomalad,","poem":1},{"text":"e-ibmar-sobarmaladi, dule-yardakmaladid, burba satemalad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"We-ibmarmala binsaledid, binsa dodolegedid.","poem":1},{"text":"E-sabsur-odurdakleged-iba-nonikile, bela berguoed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Jacob-e-Bab-Dummaddi deyobsulid,","poem":1},{"text":"ar e, bela ibmar-imaksadid.","poem":2},{"text":"E-nuga, Bab-Jehová-Bela-Gangued-Nikadye nugad,","poem":1},{"text":"Israel-dulemardi, egadiga gued.","poem":2}]},{"type":"heading","content":["Judá-dulemar bergunonikoed"]},{"type":"verse","number":17,"content":["Bab-Dummad weyob soged:",{"text":"“Be-ebiris bukwamalad,","poem":1},{"text":"be-ibmarmar-napagi-omileded be sue-sue imakmar.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ar ani Bab-Jehová weyob soged:","poem":1},{"text":"Emisgindi, an we-neggweburginmalad we-yargi dikasuli an barmidoed.","poem":2},{"text":"Suli-suli-itogega an imakoed,","poem":1},{"text":"dule-bamaladse-galegega an imakoed.”","poem":2}]},{"type":"verse","number":19,"content":["Ani Jeremías sogded:",{"text":"“¡An duledar-wiles! ¡An nue-ibitos!","poem":1},{"text":"An boni-nikadi geg-nudaklegedid.","poem":2},{"lineBreak":true},{"text":"Ar an-bonisoggu, an na gala-itosunnodo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"An-dordoneg ayaris siid,","poem":1},{"text":"bela dordoneg-e-dubmala itiris bukwad.","poem":2},{"text":"An-mimmigan-an-obachamaladi, bela amar girgusmalad.","poem":1},{"text":"Anga-neg-sobed dule sated,","poem":2},{"lineBreak":true},{"text":"anga-mor-dummagan-onakwed dule sated.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Dule-negdakmamaidi, binsaedsulidga gusmalad,","poem":1},{"text":"gwen Bab-Dummad-amiedgi binsassurmalad.","poem":2},{"text":"A-ulale, igar-nued ega gussulid,","poem":1},{"text":"e-dulemala, yogasaar-aisakis gudimalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"”¡Be itomar! ¡Gayaburba-gwensak noni!","poem":1},{"text":"Dad-nakwed-argan-sapiledsik, sorda-bila-onomalad danikid.","poem":2},{"text":"Judá-neggwebur achu-sapur-uaya-gannagana-e-negga guoed,","poem":1},{"text":"bela Judá-neggwebur akwabi ganna-ganna sigoed.”","poem":2}]},{"type":"heading","content":["Jeremías-Bab-Dummadse-gochad"]},{"type":"verse","number":23,"content":["Ani Jeremías weyob Bab-Dummadse goted:",{"text":"“Bab-Jehováʼye, an wisid, dule-e-san-burba dulegadsulid.","poem":1},{"text":"Deginbali, e-guoedi na wissurbalid.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bab-Jehová, igar-maidba be an-odurdake,","poem":1},{"text":"melle urwedgi be an-odurdako.","poem":2},{"lineBreak":true},{"text":"Ar urwedgi be an-odurdakele, be an-wiogoed.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bur be dulemar-aku-be-dakmaladgi be-urwed be oyoge.","poem":1},{"text":"Dule-be-nug-odummosurmaladgi be-urwed be barmidage.","poem":2},{"text":"Ar Jacob-wagan-wiosmalad, bela naitinagase obelosmalad,","poem":1},{"text":"degine, bela e-negmar obelosmarbalid.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JER/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JER/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JER/9.json","previousChapterAudioLinks":{},"numberOfVerses":25}