{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JER","translationId":"cuk_nvs","name":"Jeremías","commonName":"Jeremías","title":"JEREMÍAS-GARDA JEREMÍAS","order":24,"numberOfChapters":52,"sha256":"75584cc634e682f16d689c79332a191baf65045db96e9e927452315ef9b2d123","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cuk_nvs/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":12,"content":[{"type":"heading","content":["Jeremías-gandikidba-ibmar-sogsad"]},{"type":"verse","number":1,"content":["Ani Jeremías Bab-Jehováʼga sogded:",{"text":"“Bab-Jehová, an bebo abin-abin-imakdele, be gusgu nabir-ibmar-sogdaed,","poem":1},{"text":"ar bedi dule-innikigwadid.","poem":2},{"text":"Degi-inigwele, an bese igar-soggwen wis egisgwersunno.","poem":1},{"text":"¿Ar ibiga dule-isganamarga ibmar-nueganbi naddae?","poem":2},{"lineBreak":true},{"text":"¿Ar ibiga dule-emar-yardakmalad gwen-bai itodasurmala?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bee be we-dulemar urbedaed,","poem":1},{"text":"sapimaryobi bonisuli ganguddamalad,","poem":2},{"text":"deyob dunguddamalad,","poem":1},{"text":"sapi-sunmakedyobi nasguddamalad.","poem":2},{"text":"Unnila asginbi be-nug-ogannodimalad,","poem":1},{"text":"e-gwage-ulubgindi begi binsadisurmalad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová, bedi be an-wisid.","poem":1},{"text":"Be an-dakdiid, be an-wisid igi an begi binsae.","poem":2},{"text":"Igi sibad-wawaad e-oburgwileged-negse-selemaidae, deyob be we-dulemar sede.","poem":1},{"text":"Oburgwileged-ibaga be we-dulemar saboge.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"¿Sanagwadse we-napade gannar sanmakdoe?","poem":1},{"text":"¿Sanagwadse wede gaganmar gannar ainidagoe?","poem":2},{"text":"Emide, bela we-dulemar-isgued-ulale, ibmar-durgan girgumamaid,","poem":1},{"text":"degi, bela nuumar burgwemamaid.","poem":2},{"text":"Ar we-dulemarde sogmalad:","poem":1},{"text":"‘Bab-Dummad anmar-ibmar-imaked dakmaisurye.’ ”","poem":2}]},{"type":"heading","content":["Bab-Dummad-sogsad"]},{"type":"verse","number":5,"content":["Bab-Dummad, Jeremíasʼga sogded:",{"text":"“Dule-abarmakmaladbo be abarmaknaile, be yegusdaedde,","poem":1},{"text":"degite, ¿igi-be dule-moligi-abarmakmaladbo be benguosunna?","poem":2},{"text":"Yar-bogidikidginbela be dobe-itodaedde,","poem":1},{"text":"degite, ¿igi be Jordán-bula-naidgi be dobe itogosuli?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ar be-gwenadganbela, be-galagwenmalad-inigwele, begi dododimalad, begi yoledimalad.","poem":1},{"text":"Ar we-dulemar ibmar-nuegangi amba bega sunmakmalale, melle be we-dulemar itogo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"”An-dulamargi an bangusad, an-dulamar an na obachad.","poem":1},{"text":"An-dulamar-na-sabesailadi e-isdarmaladga an urmaksad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ar an-dulamar, achumigur-nono-wawaad sapurba-gudiiyob angi gudmalad.","poem":1},{"text":"Binnasuli angi uurmakdemalad, a-ulale, an isdar-daked.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"An-dulamar, igi nuu-e-absar-akar-akar-daklemalad sulubagise-balegilledidaeyobi gued.","poem":1},{"text":"¡Bela be dagmar!","poem":2},{"lineBreak":true},{"text":"Bela ibmar-durgan-ursirmalad, dulemargi-aibinega egi be dagmarsun.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bukidar dule-isdarmalad-e-dummagan, an-uvaʼmar-digaled obelosad,","poem":1},{"text":"an-nainu bela oichosmalad.","poem":2},{"text":"An-nainu-yeerdaklegedi, nega-dulesulid-ollonaidga imaksamalad.","poem":1}]},{"type":"verse","number":11,"content":[{"text":"Bela an-nainu wiosmalad.","poem":2},{"text":"An-sunnagwad an daksad,","poem":1},{"text":"bela nainu-olloo imaksamalad,","poem":2},{"text":"bela swanga imaksamalad.","poem":1},{"text":"Ar dulemar yala gwen bai-daksurmarsoggu, bela yala swanga nagusad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bela yala-mullugan-negasulidganba, dule-isganamar nonimalad.","poem":1},{"text":"Bab-Jehová-e-es-suid bela we-yala obelogoed,","poem":2},{"text":"bela naga-nagase obelogoed,","poem":1},{"text":"gwen dule-wargwenga neg-bogidikid naguosulid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bemar orosgi-dakleged-digsamalan-inigwele, ikomarbi bega ainisad.","poem":1},{"text":"Be arbasmaladi, binsa be arbasmalad.","poem":2},{"lineBreak":true},{"text":"Bab-Jehová-e-urwed-ulale, bemar-ibmar-wessulidbali be bingegumaloed.”","poem":2}]},{"type":"verse","number":14,"content":["Bab-Jehová weyob soged: “Dule-isganamar yar-baigan-dikarba-bukmaladi, an-dulamar-ibe an-yar-uksad-obelosmaladi, an bela e-yalagi we-dulemar-onogoed. Deyob an Judá-dulemar we-dulemar-abargi onomogoed."]},{"type":"verse","number":15,"content":["Geb an onosad-sorbali, wile an an-dulamar dakoed, gannar na e-negmarse-dagega an imakoed, e-yalamarse-dagega an imakoed."]},{"type":"verse","number":16,"content":["Ar we-dulemar-yarmar-baidginmaladi, an-dulamar-Baal-nuggi-ise-sogar-ibmar-imakleged odurdaksa-gusmaladid. Ar we-dulemar, an-dulamar-abargi gudigubimalale, an-igarmar-mamaid abingamalargebed, ise-sogar an-nuggi imakmarmogargebed. Weyob sogmalargebed, ¡Bab-Jehová-dula-maid-nugginye!”"]},{"type":"verse","number":17,"content":["Bab-Jehová soged: “Ar dule an-sogedba dasulirdi, bela an obelogoed.”"]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JER/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JER/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JER/11.json","previousChapterAudioLinks":{},"numberOfVerses":17}