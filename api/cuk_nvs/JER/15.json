{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JER","translationId":"cuk_nvs","name":"Jeremías","commonName":"Jeremías","title":"JEREMÍAS-GARDA JEREMÍAS","order":24,"numberOfChapters":52,"sha256":"75584cc634e682f16d689c79332a191baf65045db96e9e927452315ef9b2d123","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cuk_nvs/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":15,"content":[{"type":"heading","content":["Judá-dulemar-sabsur-odurdaklegoed"]},{"type":"verse","number":1,"content":["Bab-Jehová anga sogsad: “Amba Moisés anse danidibe, Samuelʼdibe, Judá-dulemar-ular-sunmakega, amba an Judá-dulemar bendaksasuliled. ¡Judá-dulemar, angi be obane! Ega be soge, ‘¡be namarye!’"]},{"type":"verse","number":2,"content":["Bega sokarmalale: ‘¿Bia anmar naosunna?’ Ega be sogo, weyob Bab-Jehová sogye:",{"text":"‘Dule bonigi-burgwemaloye ega-igar-maidi, bonigi burgwemaloed.","poem":1},{"text":"Dule es-suidgi-burgwemaloye ega-igar-maidi, es-suidgi burgwemaloed.","poem":2},{"text":"Dule ukudba-burgwemaloye ega-igar-maidi, ukudba burgwemaloed.","poem":1},{"text":"Dule gales-seledoye ega-igar-maidi, galesa seledmaloed.’ ”","poem":2}]},{"type":"verse","number":3,"content":["Bab-Jehová soged:",{"text":"“We-dulemargine, we-boni-dummagan-sogabake an barmidoed:","poem":1},{"text":"Bila-onoleged, adi, agi-burgwemalagar.","poem":2},{"lineBreak":true},{"text":"Achumar, adi, e-muimar-ebipiegar.","poem":2},{"lineBreak":true},{"text":"Mulamar, adi, e-san-gunmalagar.","poem":2},{"lineBreak":true},{"text":"Geb ibdurgan-sapurbarmalad, adi, bela e-san-obelomalagar.","poem":2}]},{"type":"verse","number":4,"content":["”We-dulemargi an ibmar-imakoedi, Ezequías-machi-Manasés Judá-e-reyga-megisadi, Jerusalénʼgi ibmar-isgana-imaksad-ular, bela dulemar-yar-baid-baidgi-bukmalad dobee-itogegala an we-bonigan barmidoed."]},{"type":"verse","number":5,"content":[{"text":"Jerusalén-dulemar, ¿doa wile be-dakoe?","poem":1},{"text":"¿Doa bebina booe?","poem":2},{"lineBreak":true},{"text":"¿Doa be-egisoe, bede nueganbi-sogeye?”","poem":2}]},{"type":"verse","number":6,"content":["Bab-Jehová soged:",{"text":"“Bemar an-obachamalad,","poem":1},{"text":"be angi bangudmalad.","poem":2},{"text":"Degisoggu, an bemargi gwichiguoed,","poem":1},{"text":"an bemar-obelogoed.","poem":2},{"text":"An wile-bemar-dakdiid budar-itogusad.","poem":1},{"text":"Wese-ugaksun.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gagan-durgan-burwaba-mileddaedyobi, neggweburgi an bemar-oaisakioed.","poem":1},{"text":"Mimmigansuli an bemar-imakoed,","poem":2},{"text":"bela an bemar-obelogoed,","poem":1},{"text":"ar be-daedi na be ogwassurmalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Omegan-ei-sui-burgwismaladi, demargakaba-ukub-naiyob an omelogoed.","poem":1},{"text":"Yorukudbali, sapingana-e-nangangine, burgwed-igar an egi barmidoed.","poem":2},{"text":"Ukiagwale, an egi suli-suli-itoged nasikoed,","poem":1},{"text":"an egi dobed-dummad nasikoed.”","poem":2}]},{"type":"verse","number":9,"content":["Bab-Jehová soged:",{"text":"“Bukidar-mimmigan-nikusmaladi, negoedmaloed, burgwidmaloed.","poem":1},{"text":"Na bingedar itodmaloed, san-bipii itodmaloed.","poem":2},{"text":"Dad-ibeler-gaedi ukiagwar ega akitoed.","poem":1},{"text":"Dule-burgosurmaladdi, e-isdarmaladse-es-suidgi-oburgwilegega an imakoed.”","poem":2}]},{"type":"verse","number":10,"content":["Jeremías binnasuli sogded:",{"text":"“¡Nana! Nue-nunmak an itoged.","poem":1},{"text":"We-napnegse unnila dulemarbo-abin-abin-naguega be an-odesad.","poem":2},{"text":"¡Dulemarbo-urwega be an-odesad!","poem":1},{"text":"¡Bur an gwalulessulina nabirinad!","poem":2},{"text":"Gwen dulemargi an mani gadisulid,","poem":1},{"text":"gwen dulemar angi mani gadisurmogad, degite, bela dulemar an-ukabsadimalad.”","poem":2}]},{"type":"verse","number":11,"content":["Bab-Jehová soged:",{"text":"“Napira an bega soged, we-ibmarmargi an be-ollorsaoed.","poem":1},{"text":"An be-isdarmaladi, boni-dummagan-ibagangine, suli-suli-itoged-ibagangine, begi-wilegega an imakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"”¿Sunna dule esgoro-dad-nakwed-argan-sapiledsik-danikid bisgesi?","poem":1},{"text":"¿Sunna dule esgoro-gordikid-dad-nakwed-argan-sapiledsik-danikid bisgesi?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bemar-isgumalad-ulale, an be-isdarmaladga binsa maniginsuli, be-manimar, be-ibmar-nuegan, an ukoed.","poem":1},{"text":"Bela be-neggweburgi be ibmar-nikamaladi, an ega binsa be-isdarmaladga ukoed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yar be dakdisurmaladgi, be-isdarmaladga mailedigumalaga an bemar-imakoed.","poem":1},{"text":"An-sae-itogedi soo-gwabunye-gwichiyobi bemarbina itosnaid.”","poem":2}]},{"type":"verse","number":15,"content":["Ani Jeremías, Bab-Jehováʼga sogded:",{"text":"“Bab-Jehová an be-ular-wilediid be nue-wisid.","poem":1},{"text":"¡Melle be an-iege!","poem":2},{"text":"¡Be an-bendakdage!","poem":1},{"text":"¡Dulemar an-balegindimalad buged-mai be imake!","poem":2},{"text":"Be-gwae-gwae-itosurdaedba, melle we-dulemarse-burgwega be an-imake.","poem":1},{"text":"Be nue-an-dake, an be-ular uasoledid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"”Bab-Dummad-Jehová-Bela-Gangued-Nikad, be-anga sunmaksagua, bela-belad sogedba an abingasad.","poem":1},{"text":"An be-gayaburba-itoargua, yeer-ito an-imaksad, ar an begadga gued.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dule-ibagibi-gudimaladba an gwen akadisulid.","poem":1},{"text":"Gwen an amarba wergudisurbalid.","poem":2},{"text":"Be anse nonikid-akale, an walagwen nanadiid,","poem":1},{"text":"ar bebi be anba gudiid.","poem":2},{"text":"Isgued-sae-dakega be an-imaksamogad.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"”¿Ar ibiga an-nunmaked geg bergue?","poem":1},{"text":"¿Ar ibiga an-naibigusad gege nugue?","poem":2},{"lineBreak":true},{"text":"¿Ar ibiga an-nuguedde ganna-nai?","poem":2},{"text":"Be anga dian-dinnaa maiyob naded,","poem":1},{"text":"ar be dii-aryomaisulidyob guded.”","poem":2}]},{"type":"verse","number":19,"content":["A-ulale, Bab-Jehová weyob soged:",{"text":"“Gannar be anse dagye-sogele, gannarse an be-onudakoed,","poem":1},{"text":"be anga arbadii guoed.","poem":2},{"text":"Yogasaar be-itolegedba be sunmaksulile, unnila napiragwadba be sunmakele,","poem":1},{"text":"bee be, anga gayaburba-berbegedga guoed.","poem":2},{"text":"We-dulemarba be mer ibsao,","poem":1},{"text":"ar wemar bur be-sunmakedba ibsamaloedid.”","poem":2}]},{"type":"verse","number":20,"content":["Bab-Jehová soged:",{"text":"“Galu-esgoro-gordikid-matusulidyobi, we-dulemarga an be-imakoed.","poem":1},{"text":"We-dulemar bebo urwemaloed, degi-inigwele, begi obinosurmalad.","poem":2},{"text":"Ar ani an be-bendakega guoed.","poem":1},{"text":"We-dulemargi ollorguega an be-imakoed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Dulemar-isganamargi an be-onogoed,","poem":1},{"text":"dulemar-bulegangi an be-ollorsaoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JER/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JER/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JER/14.json","previousChapterAudioLinks":{},"numberOfVerses":21}