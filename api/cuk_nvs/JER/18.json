{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JER","translationId":"cuk_nvs","name":"Jeremías","commonName":"Jeremías","title":"JEREMÍAS-GARDA JEREMÍAS","order":24,"numberOfChapters":52,"sha256":"75584cc634e682f16d689c79332a191baf65045db96e9e927452315ef9b2d123","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cuk_nvs/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":18,"content":[{"type":"heading","content":["Napsagi-ibmar-sobed-dulegi burbar-sunmakleged"]},{"type":"verse","number":1,"content":["Bab-Jehová weyob anga sognonikid:"]},{"type":"verse","number":2,"content":["“Jeremías, napsagi-ibmar-sobed-dule-negse be nae, agi an bega ibmar sogo.”"]},{"type":"verse","number":3,"content":["Geb an napsagi-ibmar-sobed-dule-negse nadsunnad, degi, an modapgu, napsa-e-obipirmakedgi ibmar-sobnai an dakdapid."]},{"type":"verse","number":4,"content":["Napsagi-ibmar-sied-sobnaid e-ibe isgunonikile, gannar sobdedabalid, egi bela nued-noedse imakdaed."]},{"type":"verse","number":5,"content":["Agine Bab-Jehová-gayaburba anse nonikid, anga weyob sognonikid:"]},{"type":"verse","number":6,"content":["Bab-Jehová soged: “Israel-dulemar, ¿geg an napsagi-ibmar-sobed-duleyob an bemar-imakmosi? Bemar Israel-dulemar, igi-napsagi-ibmar-sobed-dule napsa-imake, deyobi, bemar an-argangi gumalad."]},{"type":"verse","number":7,"content":["”An dula-bukwad-gwensak-obelogedgi-sunmakbiele, yar-gwensakgindibe, an-itogedba sunna an sunmaked. Sunna an bela we-dulemar-sabsur-odurdakedgi an sunmakbalid."]},{"type":"verse","number":8,"content":["Ar we-dula-bukwad-gwensak-bukwadi, e-isguedga-ulubgi-bukib-binsaele, ibmar-isgana-imaked iemarsogele, an sabsur-odurdakoye-sogsad bar an odurdakosulid."]},{"type":"verse","number":9,"content":["”Deginbali, an sunna bega neggwebur-onasguedgi sunmakbalid. An sunna neggwebur gangued-nika-imakedgi sunmakbalid."]},{"type":"verse","number":10,"content":["Degi-inigwele, ar emar an-asabin ibmar-isgana-imakele, an-sogedba dasurmalale, bar an emarga ibmar-nued-imakedgi binsaosulid."]},{"type":"verse","number":11,"content":["”Jeremías, emisgindi, Judá-dulemarga be sogo, degine, Jerusalén-dulemarga be sogbalo. Bab-Jehová weyob sogye ega be sogo: ‘An bemar-idu boni-dummagan urbenaiye, bemar-sabsur-odurdakedgi an binsanaiye. Bemar igar-isganagi bangumarye, be-daed be ogwamarye, be-ibmar-imaked nue be imakmarye.’"]},{"type":"verse","number":12,"content":["Degi-inigwele, bega sogdamaloed: ‘Suli, anmar imakosuli. Anmar, anmar-itolegedba ibmar imakoed, anmar ibmar-isgana-abegedba na ibmar-imakdii gumaloed.’ ”"]},{"type":"verse","number":13,"content":["Ar Bab-Jehová weyob soged:",{"text":"“Dule-yar-baid-baidgi na be egismardo:","poem":1},{"text":"‘¿Doa weyob ibmar-imakdimar be itosa?’","poem":2},{"lineBreak":true},{"text":"¡Suli! Weyob ibmar itoledisulid.","poem":2},{"text":"Ar Israel-dulemar, ibmar-isgana yeer-gangu imaksamalad.","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Ar Líbano-yalaganba boo-sibudik-bated, ¿berguoe be insae?","poem":2},{"lineBreak":true},{"text":"Yalaganba dii-dammipegwad-aryomaid, ¿berguo be insae? ¡Suli! Berguosuli.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Degi-inigwele, an-dulamar an-iedmalad.","poem":1},{"text":"Bab-dummagan-binsagumaladga ina-wawadikmalad ogumakar ukdemalad.","poem":2},{"text":"Igar-nued gebesailagi an ega-uksadgi bangudmalad.","poem":1},{"text":"E-igar-isganaba nanadmalad,","poem":2},{"lineBreak":true},{"text":"igar-gwen-nabirsulidgi gudii gudmalad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"A-ulale, e-yar-naid nega-dulesulidga imaksamalad,","poem":1},{"text":"egi-dodolegega imaksamalad.","poem":2},{"lineBreak":true},{"text":"Dulemar egi nasdamaladi, geger-dakedbali, nono-ege-ege imakdemaloed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dad-ibeler-nakwedsik burwa-goled-neg-imakedyobi, an bemar-imakoed,","poem":1},{"text":"an be-isdarmalad-asabin bemar-oaisakioed.","poem":2},{"text":"Be sabsur-odurdaklemaloed-ibagi an bemar-bendakosulid,","poem":1},{"text":"an bemar-idu wagar-biir imakoed.”","poem":2}]},{"type":"heading","content":["Jeremíasʼgi-gwichigubiguarmalad-igar"]},{"type":"verse","number":18,"content":["Dulemar weyob Jeremíasʼgi sogdemalad: “Anmar Jeremíasʼgi-gwisguega igar amimargwelo. Amba anmarga dule-irwa-Bab-Dummadse-gormalad igar-maidgi-anmar-odurdakega surguosulid. Degine, dule-binsaed-ibed anmarga-binsaed-uked surguosurbalid. Anmarga Bab-Dummad-gayaburba-barsoged surguosurbalid. Anmar melle we-dule-ibmar-soged itomalo. Anmar naibid ega ukega, e-sunmaked-egi-aibinega imakmalo.”"]},{"type":"heading","content":["Jeremías Bab-Dummadse-gochad"]},{"type":"verse","number":19,"content":["Ani Jeremías Bab-Dummadga weyob sogded:",{"text":"“¡Bab-Jehováʼye, nue be an-itoge!","poem":1},{"text":"¡Dulemar angi-gwichigunanaid nue be itoge!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"¿Ar ibmar-nued-imaklegedi, ibmar-isgana-imaklegedga gunonidasi?","poem":1},{"text":"Ar we-dulemala an-metemalaga, an-idu yaa-dummad-akwisa gunanaid.","poem":2},{"text":"Bab-Dummad, an bese-gochagusad be ebinsae,","poem":1},{"text":"adi, melle we-dulemar be sabsur-odurdakegar.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Agala, e-mimmigan, ukudba be oburgwesunna,","poem":1},{"text":"e-isdarmaladse es-suidgi-burgwega be imaksunna.","poem":2},{"text":"E-omegan-ibe, e-suimar-oburgwega be imake,","poem":1},{"text":"e-omegan, e-mimmigansuli be imake.","poem":2},{"text":"E-suimar, gindaklegar be oburgwe.","poem":1},{"text":"E-masmala, bilagi es-suidgi-burgwega be imake.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Egi, ukiagwale dulemar-ibmar-atursamalad be barmidage,","poem":1},{"text":"adi, gwakidedba binnasuli oimakde gumalagar.","poem":2},{"text":"An-gamalaga an-idu yaa-dummad akwismalad,","poem":1},{"text":"an-nag-gaega an-idu dubmar nasiksamalad.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bab-Jehová, bedi we-dulemar-an-oburgwedgi-binsananaidi be wisid.","poem":1},{"text":"Melle e-ibmar-isgana-imaksamalad be baisur-dako,","poem":2},{"lineBreak":true},{"text":"melle be e-isgusmalad iego.","poem":2},{"text":"Bab-Jehová, be-asabin galakumalaga be imako.","poem":1},{"text":"Sae-itogedgi be sabsur-odurdako.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JER/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JER/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JER/17.json","previousChapterAudioLinks":{},"numberOfVerses":23}