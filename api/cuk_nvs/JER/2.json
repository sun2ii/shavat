{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JER","translationId":"cuk_nvs","name":"Jeremías","commonName":"Jeremías","title":"JEREMÍAS-GARDA JEREMÍAS","order":24,"numberOfChapters":52,"sha256":"75584cc634e682f16d689c79332a191baf65045db96e9e927452315ef9b2d123","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cuk_nvs/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":2,"content":[{"type":"heading","content":["Judá-dulemar Bab-Jehováʼgi banguded"]},{"type":"verse","number":1,"content":["Bab-Jehová-gayaburba weyob anse nonikid:"]},{"type":"verse","number":2,"content":["“Be nae, Jerusalén-dulemarga be sunmakna, ega weyob be sogna, Bab-Jehová weyob-sogye:",{"text":"‘An ebinsado. Be yagwa-unni anbinarbi be-sogdidaed.","poem":1},{"text":"Ome machered-abesiidyobi, nega-dulesulidganba be an-balimaksa gusad.","poem":2},{"lineBreak":true},{"text":"Napaneg-ibmar-digar-sulidganba be an-balimaksa gusad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ani an Bab-Jehová-guedgi an bega soged: Bemar-Israel-dulemar, anga be dule-gwage-swilidikmalad gumalanad.","poem":1},{"text":"Bemar anga, gebe-ibmar-sanmakedyob gumalanad.","poem":2},{"text":"Dulemar ibigwensur-bemar-imakalile, anse sabsur-odurdakledaed,","poem":1},{"text":"boni-dummagan an egi barmiardaed.’ ”","poem":2}]},{"type":"verse","number":4,"content":["Ani Jeremías sogded: Jacob-wagan, Bab-Jehová-gayaburba be nue itomar, Israel-dulamar bela be an-itomar."]},{"type":"verse","number":5,"content":["Bab-Jehová weyob soged:",{"text":"“Be-dadgande, ¿ibigi egi-nosa an-daksamarsunna?","poem":1},{"text":"Emide, angi bangusmalad.","poem":2},{"text":"Bab-dummagan-ibmarga-gusurmaladba nadegusmalad,","poem":1},{"text":"agala, be-dadgan ibmarga gussurmarmogad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bipisaale, be-dadgan gwen-egichasurmalad: Bab-Jehová-Egipto-yalagi-anmar-onosadi, ¿bia-nadye?","poem":1},{"text":"Bab-Jehová-nega-dulesulidganba-anmar-idusadi, napa-dii-sateganba, degi, nega-buleganba-anmar-seargusadi, bia-nadye, gwen egichasurmalad.","poem":2},{"text":"Bab-Jehová-nega-dinnaganba, degi, negasichidganba-anmar-seargusadi, bia-nadye, gwen egichasurmalad.","poem":1},{"text":"Nega-dulemar-iirmaksurmaladba, degine, dulemar-bukwasulidba-anmar-seargusadi, bia-nadye, be-dadgan gwen egichasurmalad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Napa-gadi-ibmar-sanmakedse ani an bemar-sealid,","poem":1},{"text":"bemar agi ibmar-san gunmalagar,","poem":2},{"lineBreak":true},{"text":"degi, e-ibmarmar-nuegan gunmalagar.","poem":2},{"text":"Degi-inigwele, bemar an-yalase-nonimargua, be an-yala oichononimalad.","poem":1},{"text":"Ib-isganaga be an-yala imaksamalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dule-irwa-anse-gormalad bipisaale gwen sogsasurmalad:","poem":1},{"text":"‘Bab-Jehová ¿bia-nadye?’","poem":2},{"text":"Dule-bulegan-an-igar-mamaid-wisimaladi, Bab-Dummadsuliyobi an-daksamalad.","poem":1},{"text":"Dulemar-idumaladi, angi yoledmalad.","poem":2},{"text":"An-gayaburba-barsogmaladi, bab-dummad-Baal-nuggi sunmakdemalad,","poem":1},{"text":"degine, bab-dummad-baigan-ibnuedga-gusurmaladba nanadmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"”Ani an Bab-Jehová-guedgi bemarga soged: A-ulale, an bemargi gwisguoed,","poem":1},{"text":"degi, amba an be-wagangi gwisgubaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Quitim-dup-gakase be obakmar,","poem":1},{"text":"nue be atakmalo.","poem":2},{"text":"Cedar-yalase dule-gayaburba-berbemalad be barmidmar,","poem":1},{"text":"nue be igar amimalo.","poem":2},{"text":"Nue be egismalo,","poem":1},{"text":"we-dulemarde deyob gusmarmodibe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar neggwebur-gwensak e-bab-dummagan Bab-Dummadsunnadsur-inigwele, e-bab-dummagan-ogwasye gwen an itossulid.","poem":1},{"text":"Ar bemardi, bab-dummagan-ibnuedga-gusurmaladba-nanaed-ular, be an-obatemalad.","poem":2},{"text":"Andi bur Bab-Dummad-napiragwadid,","poem":1},{"text":"Bab-Dummad-gandikidid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ani an Bab-Jehová-guedgi bemarga soged:","poem":1},{"text":"¡Nibneggi-bukwamalad, weyob-neg-gunaidgi be gwayemar!","poem":2},{"text":"¡Be wawanmakmar!","poem":1},{"text":"¡Weyob-neg-gunaid geger be dakmar!","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”An-dulamala, ilabo dummad-nosmalad:","poem":1},{"text":"Ani an bemarga dii-burba-dulad ukedid,","poem":2},{"text":"emide be angi bangudmalad.","poem":1},{"text":"Dia-geg-dii-siged be sobsamalad,","poem":2},{"text":"egi dii-sigsulid.","poem":1},{"text":"Na-be-walagwengi a-dia be sobsamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"”Ar bemarde, Israel-dulemar, ¿be emar-maimarsii?","poem":1},{"text":"¿Ar bemarde, maiga-gubukwadgi gwalulesmarsi?","poem":2},{"lineBreak":true},{"text":"Degite, ¿ibiga be galenonimarsunna?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Dule-baigan achumigur-nono-wawaad-uurmakeyobi bemargi oimaksamalad.","poem":1},{"text":"Achumiguryob bemargi akigichamalad.","poem":2},{"text":"Bela-swanga be-yala-imaksamalad,","poem":1},{"text":"be-neggweburmar bela ogumaksamalad.","poem":2},{"lineBreak":true},{"text":"Bar dulemar agi bukwa gussurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"”Menfis-dulemarbela, degi, Tafnes-dulemarbela be-nono mamarismalad.","poem":1}]},{"type":"verse","number":17,"content":[{"text":"Ani an bemar-Bab-Dummad-Jehová gued.","poem":2},{"text":"Ani an igarba-danigu bemar-idusadid.","poem":1},{"text":"Bemar an-obachamalad-ular, weyob be gusmalad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Emide bemar, Egipto-yalase Nilo-diwar-gobnabiye-sogedde,","poem":1},{"text":"¿ibi-nued egi be amimalo na be itoge?","poem":2},{"text":"Emide bemar, Asiria-yalase Éufrates-diwar-gobnabiye-sogedde,","poem":1},{"text":"¿ibi-nued egi be amimalo na be itoge?","poem":2},{"lineBreak":true},{"text":"Ar gwen egi ibmar-nued be amiosurmalad.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ani an Bab-Dummad-Jehová-Bela-Gangued-Nikad an bemarga soged: Be-isguedgi na be dukin sabsur-odurdaklemaloed,","poem":1},{"text":"be angi-yolenanaidgi na be dukin wilemaloed.","poem":2},{"text":"Nue be binsamar, ‘dule Bab-Jehováʼgi-bangudele, Bab-Dummad-dobsuli-nanadele, we nuedsulid,","poem":1},{"text":"Bab-Dummad-ieged yeer gangued.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"”Bato dikasurgus bemar angi gwisgusmalad,","poem":1},{"text":"dikasurgus be angi bangusmalad.","poem":2},{"text":"Ar bemarde weyob sogsamalad: ‘¡Anmar beba daosuli!’","poem":1},{"text":"Bela yar-mullugangi, bela sapi-dummagan-urba, gambanuchu-imakdii be gusmalad.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Uva-dub-nuediyobi, an bemar-digsanad.","poem":1},{"text":"Bela uva-muu-nueganyobi an bemar-digsanad.","poem":2},{"lineBreak":true},{"text":"Ibiga emide be, ¿uva-muu-isgana-diglesayobi, be gusa?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ani an Bab-Dummad-Jehová-Bela-Gangued-Nikad an bemarga soged:","poem":1},{"text":"Amba ibmar-dagudik-imakmaladgi be-isgued be elimarye-sogele,","poem":2},{"text":"degi, morgaukgi ise-makumakar na be imakmarye-sogele,","poem":1},{"text":"amba an-asabin be-isgued-e-gutumar nai guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"”Ar bemarde igi be sogosunna:","poem":1},{"text":"‘An isgussurmarye, bab-dummagan-Baal-e-nugmar an odummossurmarye.’","poem":2},{"text":"¡Nebagi ibmar-imaksamalad be ebinsamar!","poem":1},{"text":"¡Be ibmar-isgana-imaksamalad be magar-itomar!","poem":2},{"text":"Bemar moli-yargan-mureged-abarmakwisdaedyob be gumalad,","poem":1},{"text":"geg boo be gudii gumalad.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bemar, igi-moli-sapur-uayasuid-ome nega-dulesulidganba machered-amiegala, burwa-goledba machered-yapanned-itodidae,","poem":1},{"text":"deyob be gumalad.","poem":2},{"text":"We-moli-ome nagubigudiile, dule geg e-igar gaed.","poem":1},{"text":"Ar moli-ome nagubigudiile, machereddi baisursunna ome-amied.","poem":2},{"lineBreak":true},{"text":"Bemar debayobi, gumalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"”Bemar, Israel-dulemar, melle nag-swili be gudii gumar,","poem":1},{"text":"ar degiile, na be dukin naibigumaloed.","poem":2},{"text":"Melle be-gammu na dinguega be imakmar.","poem":1},{"text":"Ar be sogsad: ‘¡Suli! ¡Geg an na san bargaed!","poem":2},{"text":"Bur an bab-dummad-baiganbina soged,","poem":1},{"text":"bur amar-e-nug an na odummodii guoed.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"”Igi dule-ibmar-atursaed daklesale, nue-bingegudae,","poem":1},{"text":"deyobi, bemar Israel-dulemar, nue-bingegumaloed.","poem":2},{"text":"Be-reymar-abargi, be-dummagan-abargi, bemar bingegumaloed.","poem":1},{"text":"Be-irwa-bab-dummadse-gormalad-abargi, degine, be-bab-dummad-gayaburba-barsogmalad-abargi, bemar nue-bingegumaloed.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bemar, Israel-dulemar, suarga be sokardamalad:","poem":1},{"text":"‘Be an-babad.’","poem":2},{"text":"Akwaga be sokardamarbalid:","poem":1},{"text":"‘Be an-nana, begi an gwalulesad.’","poem":2},{"text":"Andi wagar-biriar be an-dakdemalad,","poem":1},{"text":"gwen ansikdi be aibirbisurmalad.","poem":2},{"text":"Boni-dummagan-noalirdi, negoe be gollardamalad:","poem":1},{"text":"‘¡Gwae-gwae be anmar-bendakdage!’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Emide, Judá-dulemar, ¿bia be-bab-dummagan-sobsamalad nadsunna?","poem":1},{"text":"Neggweburmar-merguedyob bemar bab-dummagan nikamalad.","poem":2},{"text":"Amarga be soge, bemar-bendakye,","poem":1},{"text":"adi, be dakmaloed, bule we-bab-dummagan boni-dummagangi bemar-bendakmalodibe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"”Ani an Bab-Jehová-guedgi bemarga soged: ¿Ibiga bemar angi urwenanai?","poem":1},{"text":"Bela bemar angi yoledmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"”Binsarsunna an-dulamar an sabsur-odurdaksad, gwen an-itossurmalad.","poem":1},{"text":"Achumigur-nono-wawaadyobi, bemar, be-es-suidgi an-gayaburba-barsogmalad oburgwismalad.”","poem":2}]},{"type":"verse","number":31,"content":["Bemar, wegi-an-itobukmarmogadi, Bab-Jehová-gayaburba nue be itomarmogo. Bab-Jehová weyob soged:",{"text":"“Emide, an Israel-dulamarga, ¿nega-dulesulidyob an gussi?","poem":1},{"text":"¿Negasichidyob an gussi?","poem":2},{"text":"Ibiga an-neggwebur weyob-soge: ‘Anmar na e-itolegedba gudigumaloye,","poem":1},{"text":"anmar bar be-nug-odummogosurye,’ anga sogmalad.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"¿Ar yagwa sui-nikunair, na olo-nuegan-yooedi iego be insae?","poem":1},{"text":"¿Sui-nikued-mor-yoed iego be insae? Suli, gege iege.","poem":2},{"lineBreak":true},{"text":"Ar bemar-an-dulamardi, dikasurgus an-ies bukwamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"”Bemar, Judá-dulemar, omegan-dikarba-amied nue-wismalad.","poem":1},{"text":"Omegan-gambasamaladse-bakale, bese ibmar durdaksamalad.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Bela be-morgi dule-wilemalad-e-ablis nanaid,","poem":1},{"text":"dule-ibmar-oakalossurmalad-e-ablis be-morgi nanaid.","poem":2},{"text":"Ar wemar gwen-ibmar-atursanai be daksasurmalanad,","poem":1},{"text":"degite, be oburgwismalad.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Degite, amba be sogmalad: ‘Anmar ibmar-oakalossurye,","poem":1},{"text":"Bab-Dummad anmarse urwosurye.’","poem":2},{"text":"Ar be ibmar-oakalossurmarye-sogmarsoggu, an bemargi gwisguoed.","poem":1}]},{"type":"verse","number":36,"content":[{"text":"Ar bemar baisursunna binsaed-ogwaddamalad.","poem":2},{"text":"Ar igi Asiria-dulemar bemar-yardaksa,","poem":1},{"text":"deyobi, Egipto-dulemar bemar-yardakmogoed.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Binged-abalagi be Egipto-yargi nodmaloed.","poem":1},{"text":"Ar ande, we-dulemar-egi-be-bensurmaladi, obachad.","poem":2},{"lineBreak":true},{"text":"Gwen be we-dulemar-abargi nasguosurmalad.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JER/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JER/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JER/1.json","previousChapterAudioLinks":{},"numberOfVerses":37}