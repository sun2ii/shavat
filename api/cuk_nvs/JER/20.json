{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JER","translationId":"cuk_nvs","name":"Jeremías","commonName":"Jeremías","title":"JEREMÍAS-GARDA JEREMÍAS","order":24,"numberOfChapters":52,"sha256":"75584cc634e682f16d689c79332a191baf65045db96e9e927452315ef9b2d123","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cuk_nvs/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":20,"content":[{"type":"heading","content":["Jeremías, dule-Pasurʼye-nugad-seledoedgi sunmaksad"]},{"type":"verse","number":1,"content":["Dule-irwa-Bab-Dummadse-goled-Pasur Bab-Jehováʼse-goled-neggi dummadga-gudiid. Pasurʼde Imer-machid. Pasur, Jeremías Bab-Dummad-gayaburba-barsoggwichi-itosgua,"]},{"type":"verse","number":2,"content":["Jeremías-sarsomalaga dulemar-barmisad. Geb Benjamín-neggwebur-yawagak-biribalid-nagaba, Bab-Dummadse-goled-negmobin sepo-maidgi Jeremías-odosad."]},{"type":"verse","number":3,"content":["A-bangine, Pasur, Jeremías-sepogi-galessiidgi-onosgua, Jeremías ega sogded: “Bab-Jehová bar Pasurʼye be-biosulid, emisgi Magor-Misabibʼye be-bioed. A-sogleged: ‘Gwayed-dummad-neg-naidye.’"]},{"type":"verse","number":4,"content":["”Ar Bab-Jehová weyob soged: ‘Na be dukin gwayed-dummadga guoed, degi, be-aimar-ogwayedga be gubaloed. Be-aimar e-isdarmaladse es-suidgi oburgwilegoed, be-sunnagwad be dakoed. Bela Judá-dulemar, Babilonia-e-reyga an urmakoed, geb a-rey, Babilonia-yarse bemar-sedoed, sulile, es-suidgi be-oburgwemaloed."]},{"type":"verse","number":5,"content":["” ’Deginbali, be-isdarmaladga an bemar-neggwebur-e-ibmar-nuegan ukoed. Bela be-ibmar-sanmakmaladi, be-ibmar-gargemaladi, degi, bela Judá-dulemar-e-reymar-ibmar-nuegana an ega urmakoed. Bela we-ibmala, atursamaloed, Babilonia-yalase bela sedmaloed."]},{"type":"verse","number":6,"content":["Pasur, bedina, bela-be-negyaginmaladbo, Babilonia-yalase gales be ebipiledmaloed. A-yalagi be burgoed, agine be diglegoed. Be-aimarga be gakansaale ega sunmaksadi, deyob gumarmogoed.’ ”"]},{"type":"heading","content":["Jeremías, Bab-Dummad-abin bukib-binsasad"]},{"type":"verse","number":7,"content":["Ani Jeremías Bab-Dummadga weyob sogded:",{"text":"“¡Bab-Jehová, be nue an-binsaed gasad!","poem":1},{"text":"¡Nue an bese binsaed galesad!","poem":2},{"text":"Ar be anba bur dutusurgusoggu, be angi obichad.","poem":1},{"text":"Bela-dulemar angi dodogedbimalad, anga alledibidamalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"An sunmaked-ilibali, unnila an sogdedaed.","poem":1},{"text":"¡Belamarye! ¡Ibagan-bulegan daniye!","poem":2},{"text":"Agala, be-gayaburba mesagwar-guega an-imaked,","poem":1},{"text":"degi, angi-dodolegega an-imaked.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"An sogdibe: ‘Bar an begi binsaosurye,","poem":1},{"text":"bar be-nuggi an sunmakosurye,","poem":2},{"text":"aka bur bule be-gayaburba an-ulubgi soo-duurmaksiiyobi naddaed,","poem":1},{"text":"an-galamarse-bakale, ebuged.","poem":2},{"text":"Aisaar an-sunmaked na bargaye sogdaenad,","poem":1},{"text":"degi-inigwele, gege an na bargaed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dule-bukidar sabsur-uasogagwar-sunmake an itoged.’","poem":1},{"text":"Weyob sogmalad: ‘¡Bela gwayed-dummad neg-naiye!’","poem":2},{"text":"Weyob sogmarbalid: ‘¡We-dulegi anmar gwisgunamala!","poem":1},{"text":"¡Anmar dummaganga barsognamala!’","poem":2},{"text":"An-aimar-nueganbela begi-isguega an-imakbimalad,","poem":1},{"text":"amarbela weyob sogmalad:","poem":2},{"text":"‘Sunna Jeremías anmarse binsaed galeged.","poem":1},{"text":"Deyobile, anmar egi obinoed,","poem":2},{"lineBreak":true},{"text":"anmar buged-mai imakoed.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”Degi-inigwele, Bab-Jehová, bee be anba gudiid,","poem":1},{"text":"bila-onoged-gandikidyob be anba garmakdiid.","poem":2},{"text":"Degisoggu, dulemar an-balegindimaladi, angi obinosulid, anse galakumaloed,","poem":1},{"text":"igarga guosurmalad, bingedar itomaloed.","poem":2},{"text":"Degisadegu, suli-suli-itodii gumaloed,","poem":1},{"text":"bipisaale dulemar we-ibmar iegosurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"”Be, Bab-Jehová-Bela-Gangued-Nikadid.","poem":1},{"text":"Bedi dule-innikigwad-e-daed balamied.","poem":2},{"text":"E-gwage-ulubgi-ibmar-itoged be wisid,","poem":1},{"text":"degi, e-binsaed magar be daked.","poem":2},{"text":"Degisoggu, be we-dulemar-buged-mai-imakoed-dakega be an-imake.","poem":1},{"text":"Ar an-bonigan an bega uksad,","poem":2},{"lineBreak":true},{"text":"emidi, begi siid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”¡Bab-Jehová-nuggi be namakmala!","poem":1},{"text":"¡E-nug be odummomala!","poem":2},{"text":"Ar Bab-Dummad dule-wilemalad abonoged,","poem":1},{"text":"dule-isganamar-e-ganguedgi ollorsaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"”¡Ibiga an we-ibagi gwalulesdibe!","poem":1},{"text":"¡Iba-isganaga gusun!","poem":2},{"text":"¡Ibiga we-ibagi an-nan an-odesdibe!","poem":1},{"text":"¡Iba-isganaga gusun!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Dule an-bab-weligwar-imaksadi, deun ega weyob sogsagusgu, susugwa bega uklesye.","poem":1},{"text":"¡We-dule iwigusun!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"We-dule, Bab-Jehová-neggweburmar-sabsur-obelosgusadyob gumosun.","poem":1},{"text":"Degi, we-dule, wakdaradbali, neg-oimake itosun,","poem":2},{"lineBreak":true},{"text":"yorukudbali, dule-bila-onomalad-oimake itosun.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"¿Ibiga Bab-Dummad, an sapidukugi-maidgi burgwega an-imaksasuli?","poem":1},{"text":"Adi, an burgwar aidesanad.","poem":2},{"lineBreak":true},{"text":"An-nan anga neg-uanga gusanad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"¡Ibiga an sapibeneggi-maid aidesdibe!","poem":1},{"text":"¿Unnila an boniganba-galitogega nonide?","poem":2},{"text":"¿Unnila bukib-binsaega an nonide?","poem":1},{"text":"¿Unnila emarse bingegudiguega an nonide?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JER/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JER/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JER/19.json","previousChapterAudioLinks":{},"numberOfVerses":18}