{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JER","translationId":"cuk_nvs","name":"Jeremías","commonName":"Jeremías","title":"JEREMÍAS-GARDA JEREMÍAS","order":24,"numberOfChapters":52,"sha256":"75584cc634e682f16d689c79332a191baf65045db96e9e927452315ef9b2d123","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cuk_nvs/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":22,"content":[{"type":"heading","content":["Judá-e-reymar-sabsur-odurdaklegoed"]},{"type":"verse","number":1,"content":["Bab-Jehová weyob anga sogsad: “Jeremías, reynegse be nae, agi Judá-dulemar-e-rey dad-David-ologanagi-siid-asabin be we-gayaburba sogo."]},{"type":"verse","number":2,"content":["Deginbali, Rey-e-dummaganga-arbamaladga, degi, e-dulamar-we-yawagakba-ubomaladga be sogmogo: ‘Bab-Jehová-gayaburba be nue itomarye.’"]},{"type":"verse","number":3,"content":["”Weyob Bab-Jehová soged: ‘Igar-innikigwad be imakmarye, igar-napiragwadba be nanamarye. Dule-mesagwar-gudiid, mesagwar-imaked-dulegi be ollor-imakmarye. Melle Judíoʼsurmalad be sabsur-imakmaloye, degi, melle be babgan-satemalad wiomaloye, degine, melle be siamar-e-sui-burgwismalad wiomarbaloye. Deginbali, melle wegine dulemar-ibmar-oakalossulid-ablis eomarbaloye."]},{"type":"verse","number":4,"content":["” ’Ar bemar we-ibmar-sogedba-damalale, we-reyneg-yawagakbali reymar-ubomai, Rey-David-e-ologanagi sigmai gumaloed. Reymar, e-dummagan-abargi, degi, e-dulamar-abargi moli-urgi-sii, degine, moli-birgi-sii ubomai gumaloed."]},{"type":"verse","number":5,"content":["Ani an, Bab-Jehová-guedgi soged: Ar bemar we-gayaburba-bega-soged be itosurmalale, an-sunnagwad an bemarga innikigwadgi ibmar-sogdo, we-reynega bela akwamarbi-bukwa an imakoed.’ ”"]},{"type":"verse","number":6,"content":["Bab-Jehová, weyob Judá-e-reyneg-annik soged:",{"text":"“Be angala Galaad-yaryobi gued.","poem":1},{"text":"Líbano-yala-biriyobi, be anga gued.","poem":2},{"text":"Degi-inigwele, napira an bega soged,","poem":1},{"text":"nega-dulesulidga an be-imakoed,","poem":2},{"lineBreak":true},{"text":"neggweburmar-dulesulidga an be-imakoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dulemar-be-obeloged an begi barmidoed,","poem":1},{"text":"e-gingimar-nika-nika begi namaloed.","poem":2},{"text":"Be-urwar-buarmar-bur-yeerdaklemalad bei omukumaloed,","poem":1},{"text":"geb bela soogi bei ogumakmaloed.","poem":2}]},{"type":"verse","number":8,"content":["”Dule-bukidar we-neggweburgi nasmalogua, e-sordaganga sogdamaloed: ‘¿Ibiga Bab-Jehová weyob we-neggwebur-dummad imaksa?’"]},{"type":"verse","number":9,"content":["Geb na e-sordagan sogdamaloed: ‘Ar we-dulemala, e-Bab-Dummad-Jehová-ebo-igar-mesisadi obachamaladdeeye, bab-dummagan-baiganba ibsasmaladdeeye, a e-nug-odummodii gusmaladdeeye. A-ulale, weyob we-neggwebur gusye.’"]},{"type":"verse","number":10,"content":[{"text":"Melle rey-burgwaledga be bomalo,","poem":1},{"text":"melle a-ular be bukib binsamalo.","poem":2},{"text":"Bur be rey-gales-selesadga be bomala,","poem":1},{"text":"we-rey bar gannar wese-aibirosulidga bur be bomala,","poem":2},{"lineBreak":true},{"text":"degi, e-gwalulesad-yar-bar-dakosulidga bur be bomala.”","poem":2}]},{"type":"verse","number":11,"content":["Bab-Jehová weyob Josías-machi-Salum, e-bab-sorba-Judá-e-reyga-megisadga-annik soged: “Salum, bar wese gannar aibirosulid."]},{"type":"verse","number":12,"content":["Bia gales-selesa, agine burgoed, we-yarse bar gannar nonikosulid."]},{"type":"verse","number":13,"content":[{"text":"Dule igar-maisulidba-e-neg-sobdiidi, degi, ibmar-isgana-imakedgi e-gabedneg-nibalid-sobdiidi, ¡we-dule, duledar-wiles!","poem":1},{"text":"Dule, ega-binsa-dule-arbaega-imakdiidi, degi, ega-arbaed-bennukdisulidi, ¡we-dule, duledar-wiles-ini!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dule na sogdiid: ‘An na neg-dummadi-soboye,","poem":1},{"text":"neg-obunnomalad burwisuli aila-dummad-birgi imakoye.’","poem":2},{"text":"We-dule, e-neg yawagak-atakmalad-dummagan-nika imakele, deginbali, urwar-urgo ebirgi nasikele, geb e-maged-ginnidgi magbalile,","poem":1},{"text":"¡we-dule, duledar-wiles-ini!","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"”¿Ar be urwar-neggi-maidba, be reyga megode?","poem":1},{"text":"Ar be-babdi amba iba-dummagan-onodigusan-inigwele, ar degite, amba igar-innikigwadba nanadii gusad,","poem":2},{"text":"igar-nuegan-mamaidba nanadii gusad,","poem":1},{"text":"igar-innikigwad-imakdii gusbalid.","poem":2},{"lineBreak":true},{"text":"A-ulale, ega nueganbi ibmar gusad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Deginbali, dule-wilemalad-bendakdii gusbalid,","poem":1},{"text":"dule-ibmar-satemalad-wile-dakdii gusbalid.","poem":2},{"text":"¿Ar we-soglesursi, we-dule magar-an-daksaye?","poem":1},{"text":"Ani Bab-Jehová soged: We sogleye, magar an-dakdii gusye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"”Unnila bedi maniginbi be binsadiid,","poem":1},{"text":"mani-amiegala yogasaar be ibmar imakdiid.","poem":2},{"text":"Ar bedi dulemar-gindakedginbi be binsaed,","poem":1},{"text":"unnila mesagwar be emar-imakdiid,","poem":2},{"lineBreak":true},{"text":"sabsur-emar-imaked be gudiid.”","poem":2}]},{"type":"verse","number":18,"content":["A-ulale, Bab-Jehová Judá-e-rey-Josías-machi-Joacim-annik weyob soged:",{"text":"“Dule bipisaale Joacim-burgoedbina bukib-binsaosulid,","poem":1},{"text":"ega weyob binnasuli boosurmalad:","poem":2},{"text":"‘¡Gwenadye! ¡Duledar-wilesmarye!","poem":1},{"text":"¡Bunaye! ¡Dule-wilesmarye!’","poem":2},{"text":"Degi, ega weyob binnasuli boosurmarbalid:","poem":1},{"text":"‘¡Dummadye! ¡Be bergudsunye!","poem":2},{"lineBreak":true},{"text":"¡Anmar-rey, be anmar-idu nadsunye!’","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Moli-uayasuid-diglegeyobi diglegoed, illi-illir ebipimaloed.","poem":1},{"text":"Jerusalén-neggwebur-magaba metemaloed.”","poem":2}]},{"type":"heading","content":["Jerusalén-dulemargi sunmaklenaid"]},{"type":"verse","number":20,"content":["Bab-Jehová, Jerusalén-dulemarga weyob sogdemogad:",{"text":"“Líbano-yarse be naknamar,","poem":1},{"text":"agi be binnasuli ogormaksii gumalo,","poem":2},{"text":"Basán-yargine, be binnasuli bosii gumalo,","poem":1},{"text":"Abarim-yarmar-akale, be bodii gumalo.","poem":2},{"lineBreak":true},{"text":"Ar dulemar-be-bendakmalo-sogmaladi, bela ogilolesmalad.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bemar nued-gudiunni, an bega sunmaksamalanad.","poem":1},{"text":"Aka be sogdegusmalad: ‘Anmar be-itobisurye.’","poem":2},{"text":"Ar be dungudanikid-akale, deyob be damalad,","poem":1},{"text":"gwen be an-itobisurgusmalad.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Be-sapin-dummagan-gudimaladi, burwa-dummadse ebipiledmaloed.","poem":1},{"text":"Bebina-sogdimaladi, gales seledmarmogoed.","poem":2},{"text":"Na be-isgued-ulale, bingedar be itodoed,","poem":1},{"text":"mesagwar be imakledoed.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Emide be, Líbano-yargi be maid, urwargi be uu-sobsayobi be gued.","poem":1},{"text":"Ar emisgindi, be dummad-naibid itosunnoed,","poem":2},{"text":"igi ome-muu-neggi-nai, nunmaked-itonaidyobi,","poem":1},{"text":"be nunmaked itonai guoed.”","poem":2}]},{"type":"verse","number":24,"content":["Judá-Rey-Conías, Joacim-e-machid. Bab-Jehová, Coníasʼnik weyob soged:",{"text":"“An-dula-maidgi inniki an bega soged:","poem":1},{"text":"Amba an bela-bela bebina-soged-inigwele, be wegi-gudiidgi amba an be-bar-metedsegad.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Be-oburgwebi-gudimaladga an be-urmakoed,","poem":1},{"text":"be bela-bela-dule-dobgudimaladga an be-urmakoed.","poem":2},{"text":"We-Babilonia-e-rey-Nabucodonosorʼga, degi, Caldea-dulemarga an be-ukmaloed.","poem":1}]},{"type":"verse","number":26,"content":[{"text":"Be, be-nanbogwa, yar-baid-gwen-be-dakdisulidse an be-barmetoed.","poem":2},{"text":"Be gwalulessulid-yargi, be-nanbogwa an be-oburgwemaloed.","poem":1}]},{"type":"verse","number":27,"content":[{"text":"Gwen bipisaale be-yar-naidse be gannar aibirosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"”¿Ar we-Coníasʼde nog-maraled-gwen-bar-dule-abesulidyob gude?","poem":1},{"text":"¿Ar ibiga wede yar-baid-gwen-dakdisulidse, e-mimmiganmala barmelledsunna?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"¡Israel-dulemar! Bab-Jehová-e-gayaburba be itomar.”","poem":1}]},{"type":"verse","number":30,"content":["Weyob Bab-Jehová soged:",{"text":"“We-dule, dule-wargwenadye be gardagi narmakar meso,","poem":1},{"text":"dule gwen igarga gudsulidye be gardagi sogo.","poem":2},{"lineBreak":true},{"text":"Ar e-mimmigan-wargwensaale, Judá-yar-seegala David-e-ologangi sigosurguoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JER/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JER/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JER/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}