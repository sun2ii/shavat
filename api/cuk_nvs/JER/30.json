{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JER","translationId":"cuk_nvs","name":"Jeremías","commonName":"Jeremías","title":"JEREMÍAS-GARDA JEREMÍAS","order":24,"numberOfChapters":52,"sha256":"75584cc634e682f16d689c79332a191baf65045db96e9e927452315ef9b2d123","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cuk_nvs/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":30,"content":[{"type":"heading","content":["Judá-dulemar-gales-bukwad gannar nonikoed"]},{"type":"verse","number":1,"content":["Bab-Jehová Jeremíasʼga sognonikid."]},{"type":"verse","number":2,"content":["“Ani Israel-dulemar e-Bab-Dummad-Jehová soged: An bela bega ibmar-sogsad gardagi be narmako."]},{"type":"verse","number":3,"content":["Ar ibagan danikid, an-dula-Israel-dorgan, degi, an-dula-Judá-dorgan gales-bukmalad gannar an wese sedagoed. An e-dadganga-yala-uksadse an sedagoed, a-yalagi na yeer-itobukwa gumaloed.”"]},{"type":"verse","number":4,"content":["Bab-Jehová Jeremíasʼga Israel-dulemargi sunmaksad, degi, Judá-dulemargi sunmaksad."]},{"type":"verse","number":5,"content":["Weyobi Bab-Jehová soged:",{"text":"“Dule dobedba binnasuli-gorbukwa itolesad,","poem":1},{"text":"gwayale-gwayale oimakbukwa itolesad,","poem":2},{"lineBreak":true},{"text":"neg-bogidikid itolesulid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yamo be dakena, ese be egisena,","poem":1},{"text":"machergan, omeganyobi muu-neggi nagusogeye.","poem":2},{"text":"Degite, ¿ibiga machergana, siamar-muuneggi-nagueyobi, musiragi alamaknanai an daksunna?","poem":1},{"text":"¿Ar ibiga e-wagarmar bela sipuu daklesunna?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"¡Duledar-wiles! Ibagan-bulegan, ibagan-weyobid-dakledisulid omos.","poem":1},{"text":"Jacob-dulemarga, suli-suli-itoged-ibaga guoed, degi-inigwele, we-ibagan-bulegangi ollorgumaloed.”","poem":2}]},{"type":"verse","number":8,"content":["Bab-Jehová-Bela-Gangued-Nikad soged:",{"text":"“An-dulamar mailediidgi an onogoed,","poem":1},{"text":"atinnaryob-ebipilediid an esikoed.","poem":2},{"lineBreak":true},{"text":"Dulemar-baigan-e-maiga bar guosurmalad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Unnila bemar be-Bab-Dummad-Jehováʼsebi, be gordii gumaloed.","poem":1},{"text":"Be-e-reyga be arbadii gumaloed.","poem":2},{"lineBreak":true},{"text":"Rey, Davidʼyobid an bemarga barmidagoed.”","poem":2}]},{"type":"verse","number":10,"content":["Bab-Jehová soged:",{"text":"“An-dula-Jacob-wagan, melle be gwayemar.","poem":1},{"text":"An-dula-Israel-wagan, melle be dobee itomar.","poem":2},{"text":"Jacob-wagan, ar an we-yargi be-onogoed,","poem":1},{"text":"ar be-wagan-Babiloniaʼse-gales-selesmalad an onogoed.","poem":2},{"text":"Gannar be bogidik-gudii guoed.","poem":1},{"text":"Dobedsuli be garmakdii guoed,","poem":2},{"lineBreak":true},{"text":"dulemar bar be-ogwayosurmalad.”","poem":2}]},{"type":"verse","number":11,"content":["Bab-Jehová soged:",{"text":"“An be-bendakega be-yalaba gwichid.","poem":1},{"text":"Bia an be-oaisakismala, a-yarmala an bela-naitinagase obelogoed.","poem":2},{"text":"Degi-inigwele, bemardi an be-obelogosulid,","poem":1},{"text":"unnila igar-innikigwadba an sabsur-bemar-odurdakoed,","poem":2},{"text":"an bemar-odurdaksuli an guosulid,","poem":1},{"text":"an bemar-odurdakedsegad.”","poem":2}]},{"type":"verse","number":12,"content":["Bab-Jehová weyob soged:",{"text":"“Be-boni-amisad geg nudakleged,","poem":1},{"text":"be-boni-yaa-siidga bendakleged-igar sulid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bega-igar-nudakega dule-be-ulagwisgued sated,","poem":1},{"text":"ar be-boniga bendakleged-igar sulid,","poem":2},{"lineBreak":true},{"text":"ar be-boni-nikadga nugued-igar sated.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bela bebo-galagwensur-nanasmalad be-iesmalad,","poem":1},{"text":"bar bemar-amiedgi binsasurmalad.","poem":2},{"text":"Be, dummad-ibmar-isgana-imaksad-ulale, degi, be, dummad-isgusad-ulale, an be-sarsosad,","poem":1},{"text":"degi, a-ulale, an be-odurdaksad.","poem":2},{"lineBreak":true},{"text":"Igi dule-isgana dule-sabsur-imakdamalayob an bemar-imaksad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"¿Ibiga nunmakedba be binnasuli gole?","poem":1},{"text":"Ar be-bonide gege-nudakleged.","poem":2},{"text":"Be, dummad-ibmar-isgana-imaksad-ulale, degi, be dummad-isgusad-ulale,","poem":1},{"text":"an weyobi bemar-imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"”Bela be-wiomaladi, bela wiolemarmogoed,","poem":1},{"text":"bela be-isdarmalad gales-seledmaloed.","poem":2},{"text":"Begi-dii-dii-annamaladi, egi dii-dii annalemarmogoed,","poem":1},{"text":"bela dulemar-bei-ibmar-sumaladi, bela ei ibmar sulemarmogoed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Gannarse an be-onudakoed,","poem":1},{"text":"be-boni-amisadi an bega osulogoed.","poem":2},{"text":"Ar be-isdarmalad sogmalale, Sión-yala oballessiiye,","poem":1},{"text":"dule bar Sión-yalagi binsasurmarye.","poem":2},{"lineBreak":true},{"text":"Deyob sokarmalar, gwen akarsulid.”","poem":2}]},{"type":"verse","number":18,"content":["Bab-Jehová weyob soged:",{"text":"“Jacob-wagan-gales-bukmalad gannar an sedagoed,","poem":1},{"text":"Jacob-wagan an nue-wiledakoed.","poem":2},{"text":"Neggweburmar gannar e-ambikusadgi ambikuoed,","poem":1},{"text":"reyneg gannar iduar-sii gusadgi sigoed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Neg-galimbabali, dog-nuedgi-namakleged itoledagoed,","poem":1},{"text":"degi, weligwaledba binnasuli-oimake itoledagoed.","poem":2},{"text":"Be-anagan an bega omelomai imakoed,","poem":1},{"text":"bega ichegumai guosulid.","poem":2},{"text":"Be-nug-ogannodii an imakoed,","poem":1},{"text":"mesagwar-imakledii be guosurmalad.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Be-mimmigana, idualedyobi gumaloed,","poem":1},{"text":"an-asabinni gannarse-bukwa gumaloed.","poem":2},{"lineBreak":true},{"text":"Ani an, bela dule-mesagwar-be-imakmalad obelogoed.”","poem":2}]},{"type":"verse","number":21,"content":["Bab-Jehová soged:",{"text":"“Bemar-abargi, bemar-iduged nodagoed,","poem":1},{"text":"a-dulegine, bemarga-negseed danikoed.","poem":2},{"text":"An-walikaa-guega an imakoed, anba gudii guoed.","poem":1},{"text":"Degite, ¿doa an-walikaa anse-dagega guakwasunna?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bemar anse alile, be an-dulaga gumaloed,","poem":1},{"text":"ani an, bemar-Bab-Dummadga gumogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"”An-urwedi burwa-dummad-goleyob gued.","poem":1},{"text":"Burwa-bipirmakaledyobi gwichigualid,","poem":2},{"lineBreak":true},{"text":"dule-ibmar-isgana-imakmaladgi, gwichigunonikoed.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"An-urwedi gwen-bogguosulid,","poem":1},{"text":"bela an-ibmar-abemaid-imakedse, an-urwed bogguoed.","poem":2},{"lineBreak":true},{"text":"Geb bela we-ibmarmar-gusadgi, be magar itononimaloed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JER/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JER/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JER/29.json","previousChapterAudioLinks":{},"numberOfVerses":24}