{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JER","translationId":"cuk_nvs","name":"Jeremías","commonName":"Jeremías","title":"JEREMÍAS-GARDA JEREMÍAS","order":24,"numberOfChapters":52,"sha256":"75584cc634e682f16d689c79332a191baf65045db96e9e927452315ef9b2d123","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cuk_nvs/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":31,"content":[{"type":"heading","content":["Israel-dulemar-e-yarse-gannar-nonikid"]},{"type":"verse","number":1,"content":["Bab-Jehová weyob soged: “A-ibagangine, ani an bela Israel-dulemar-e-Bab-Dummadga guoed, Israel-dulemala an-dulaga gumarmogoed.”"]},{"type":"verse","number":2,"content":["Bab-Jehová weyob soged:",{"text":"“Es-suidgi-burgwissurmaladi, nega-dulesulidganba obunnoged-aminadapmargu,","poem":1},{"text":"egi-nued an binsasad.”","poem":2}]},{"type":"verse","number":3,"content":["Bab-Jehová anmarse dikasurgus magarosad, anmarga weyob sogsad:",{"text":"“Gusgu degisadegu an be-sabgudanikid,","poem":1},{"text":"a-ulale, amba nue-wile an be-dakdiid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Israel-dulemar, gannar an be-urbemaloed.","poem":1},{"text":"Gannar neggweburga an be-imakoed.","poem":2},{"text":"Gannale gar-pandereta be suoed,","poem":1},{"text":"weligwaledba be dodonai guoed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gannar Samaria-yala-mullugangi, uvaʼmar be nasikmaloed.","poem":1},{"text":"Dulemar uva-digmaloedi, e-uvaʼgi yeer-itodii gumaloed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ibagwengine, dule-nakulemaladi, binnasuli Efraín-yala-mulluganba weyob gormakgwichi gumaloed:","poem":1},{"text":"‘Be dagmar. Sión-yalase anmar nakwenamar,","poem":2},{"lineBreak":true},{"text":"anmar-Bab-Dummad-Jehová-yalase anmar namar.’ ”","poem":2}]},{"type":"verse","number":7,"content":["Weyob Bab-Jehová soged:",{"text":"“Weligwaledba be Jacob-wagan-nuggi namakmar,","poem":1},{"text":"yeer-itogedgi neggwebur-biriginedga be gormakmar.","poem":2},{"text":"Bab-Dummad-nug-odummoleged-itolegega be imakmar,","poem":1},{"text":"weyob be gormar:","poem":2},{"text":"‘Bab-Jehová, be-dulamar be bendake,","poem":1},{"text":"Israel-dulemar-napi-besad be bendake.’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bemar dad-nakwed-argan-sapiledsik-bukmaladi ani an bemar sedagoed.","poem":1},{"text":"Bela napneg-ugakaase be bukmaladi, gannar danar wegi an bemar-urbemaloed.","poem":2},{"text":"¡Bela-belad-bur-ichesuli gannar nonimaloed!","poem":1},{"text":"Amar-abargi, dala-satemalad danimarmogoed.","poem":2},{"text":"Muya-muya-nanamaladi, siamar-gurgin-nikamaladi,","poem":1},{"text":"degine, muugan-sikwigamaladi, danimarmogoed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Boed-abalagi danimaloed.","poem":1},{"text":"Igar-nuedba sedaniki an saoed,","poem":2},{"text":"igar-olloo-maidba dii-maidse an bemar-idudani guoed,","poem":1},{"text":"a-igarbali, be gowarmaknadapi guosurmalad.","poem":2},{"text":"Ani an, Israel-e-Babad,","poem":1},{"text":"an-machi-sailanaginedi, Efraínʼad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Dulemar-yar-baid-baidgi-bukmalad, Bab-Jehová-sunmaked be itomar.","poem":1},{"text":"Neggwebur-dikasuli-bukmaladga be weyob gayaburba sogmar:","poem":2},{"text":"‘Israel-dulemar-oaisakisadi, a-dule gannar Israel-dulemar danar-oambikubaloed,","poem":1},{"text":"igi sibad-wawaad-edarbed na e-sibad-akwe,","poem":2},{"lineBreak":true},{"text":"deyobi, e-dulamar-akwemogoed.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar Bab-Jehová Jacob-wagan-abonosad,","poem":1},{"text":"dule-gandikidgi ollor-imaksad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nonimaloed, Sión-yala-birse weligwar namaknonimaloed,","poem":1},{"text":"Bab-Jehová-ega-ibmar-nuegan-ukedgi yeer-itomaloed.","poem":2},{"text":"Bab-Dummad ega we-ibmar ukoed:","poem":1},{"text":"Orosgi-dakleged-trigo-nugad,","poem":2},{"lineBreak":true},{"text":"vino-binid, olivo-gwallu,","poem":2},{"lineBreak":true},{"text":"sibad-wawaadmar, moli-bebe-nikmalad,","poem":2},{"text":"ega ukoed.","poem":3},{"text":"Nainu-senigwad-nue-egi-arbalediidyob gumaloed,","poem":1},{"text":"bar abgan-galagan itogosurmalad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Weligwaledba yagana gwirdemaloed,","poem":1},{"text":"sapingana, weligwaledba serganmala gwirdemarmogoed.","poem":2},{"text":"E-naibi-itodimalad bar nunmake itogosurmalad,","poem":1},{"text":"gwagegi-baisur-itomalaga an imakoed.","poem":2},{"lineBreak":true},{"text":"E-nunmak-itomalad, yeer-itogega an saoed.”","poem":2}]},{"type":"verse","number":14,"content":["Bab-Jehová soged:",{"text":"“Dule-irwa-anse-gormaladga ise-obinagwar ibmar an ukoed,","poem":1},{"text":"an-ibmar-nuegangi an-dulamar yeer-itogoed.”","poem":2}]},{"type":"verse","number":15,"content":["Weyob Bab-Jehová soged:",{"text":"“Dulemar Ramáʼgi binnasuli-oimake itoleged,","poem":1},{"text":"dulemar ise-boale, degi, nunmakedba-bukib-binsae itoleged.","poem":2},{"text":"Wede Raquel, e-mimmiganga bonaid,","poem":1},{"text":"dule-e-gwage-gadi-gadi-imaked abesulid,","poem":2},{"lineBreak":true},{"text":"e-mimmigana bela ei girgusad.”","poem":2}]},{"type":"verse","number":16,"content":["Weyob Bab-Jehová soged:",{"text":"“Raquel, melle bar be boe,","poem":1},{"text":"be-boed be bargae, ganna be sae.","poem":2},{"text":"Ar be-wile-itogedi, bega ibmar-nuedga guoed.","poem":1},{"text":"Be-mimmigan, e-isdarmalad-yargi nonikoed.”","poem":2}]},{"type":"verse","number":17,"content":["Bab-Jehová soged:",{"text":"“Yoedse bega ibmar-nueganbi guo-dakleged,","poem":1},{"text":"be-mimmigana gannale e-yalase nonimaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"”Efraín-dulemar weyob binnasuli-ogormake an itosad:","poem":1},{"text":"‘Sabsur-be-an-imaksad,","poem":2},{"text":"moli-bebe-nikad-bipi binnasur-gunaidaedyob an gudinad,","poem":1},{"text":"emide be an-odurdaksad an nued-itosad.","poem":2},{"text":"Gannar bese-dagega be an-sae, adi, gannar an beba gudioed.","poem":1},{"text":"Ar bee be an-Bab-Dummad-Jehová gued.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"An begi bangusad,","poem":1},{"text":"degi-inigwele, an magar-itosgua, bukib an binsasad,","poem":2},{"text":"binasgar dataa dukin an imaksad.","poem":1},{"text":"Bingedar an itoged,","poem":2},{"text":"mesagwar an itoged,","poem":1},{"text":"sapingwa-akar an isgudaniguad.’ ”","poem":2}]},{"type":"verse","number":20,"content":["Bab-Jehová soged:",{"text":"“¿Ar Efraín an-Machi-sabed-sunnadsursi?","poem":1},{"text":"¿Bur Efraínʼbina an nue-itosursi?","poem":2},{"text":"Gandikidba an ega ibmar-sokalile, an ebinsaardaed.","poem":1},{"text":"Efraín bur bela-belad an-gwage-ebudaed,","poem":2},{"lineBreak":true},{"text":"we bur an nue-wiledaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"”Israel-dulemar, igarba wilubgan be nasikmar,","poem":1},{"text":"bia be nasmala,","poem":2},{"text":"agine be-gannar be nasikmar,","poem":1},{"text":"igargi nue be atakmalo.","poem":2},{"text":"Israel-dulemar-yeerdaklegedi, gannar be dagmala,","poem":1},{"text":"be-neggweburse gannar be dagmala.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bunagwa-uayasulidaedi, ¿ar sanagwadse be yoggus-gudiguoye be soge?","poem":1},{"text":"Bab-Jehová, ibmar-gwapid we-napneggi imaksad.","poem":2},{"lineBreak":true},{"text":"Ome sui-ebirdii guoed.”","poem":2}]},{"type":"verse","number":23,"content":["Israel-dulemar-Bab-Dummad-Jehová Bela-Gangued-Nikadi soged: “Judá-dulemar gannar-we-yalase an senonikile, Judá-yalagi, degi, e-neggweburmargi weyob gannar sogdamarbaloed:",{"text":"‘Yala-islidikid, igar-innikigwadba-ibmar-imakleged-neg,","poem":1},{"text":"Bab-Jehová begi nued binsasun.’","poem":2}]},{"type":"verse","number":24,"content":["”Agine Judá-dulemar ambikumaloed, bela dule sapurgi-arbamalad, degi, moli-edarbemalad ambikumaloed."]},{"type":"verse","number":25,"content":["Dule uku-uku-itomaladi, an ogoboed. Dule ukumaada-itomaladi, masgi an ogunnoed.”"]},{"type":"verse","number":26,"content":["Ani Jeremías, nue-gabmai, an ataas naded. Ibiyobi, negburgan-daksadi an nued-daksa."]},{"type":"heading","content":["Igar-Binid-megisad"]},{"type":"verse","number":27,"content":["Bab-Jehová weyob soged: “Ibagan-dani, Israel-yalagine, degi, Judáʼgine dulemar-bukidar-ambikuega an imakoed, degi, ibmar-durgan bukidar-merguega an sabaloed.”"]},{"type":"verse","number":28,"content":["Bab-Jehová soged: “Igi an bemarbina bemar-obelogega, bemar-wiogega, sabsur-bemar-imakega, degi, bemargi-gwichiguega, degine, bemargi bonigan-barmidagega an ibmar-imaksagusa, deyobi, an bemarbina bemar-urbega, degine, bemarga neggweburmar-sobega ibmar-imakdii gubaloed."]},{"type":"verse","number":29,"content":["A-ibagangine bar soglegosulid:",{"text":"‘Babgan uva-soled guchaye,","poem":1},{"text":"a-ulale, e-mimmigan nugar-iii-naddaye, bar soglegosulid.’","poem":2}]},{"type":"verse","number":30,"content":["”Emisgindi, bar deyob soglegosulid. Dule uva-soled-guchale, na-ee nugar-iii naoed. Wegisundo, na wala-walagwena e-isguedba burgwemaloed.”"]},{"type":"verse","number":31,"content":["Bab-Jehová weyob soged: “Israel-dulemarbo, degi, Judá-dulemarbo an igar-binid-mesoed-ibagan dani."]},{"type":"verse","number":32,"content":["E-dadganbo-igar-mesisadyobi, an igar mesosulid. Deunni, Egipto-yalagi an e-dadgan-onosgu, anbo-igar mesisgusad. Angadga gusmar-inigwele, anbo-igar-mesisad bichismalad.”"]},{"type":"verse","number":33,"content":["Bab-Jehová soged: “A-ibagangine, Israel-dulemar-ebo an weyob igar mesoed: E-gwage-ulubgi an-igar an ega nasikoed, e-binsaedgi an-igar an ega narmakoed. Ani an e-Bab-Dummadga guoed, emar an-dulaga gumarmogoed."]},{"type":"verse","number":34,"content":["Bar dule, dule-baid odurdakosulid, degi, bar dule, e-gwenad odurdakosulid, ega weyob bar sogosulid: ‘Bab-Jehová be amimala.’ Ar bela burwiganase, degi, serganse-bakale, an-amimaloed. Ar e-isgumaladi, isgussulidyob an dakoed, bipisaale bar an e-isgusadgi binsaosulid.”"]},{"type":"verse","number":35,"content":[{"text":"Bab-Jehová, Bab-Jehová-Bela-Gangued-Nikad,","poem":1},{"text":"dad-ibeler-ibgi-gaega-nasiksadi,","poem":2},{"text":"degi, nii, niisgwamar, mutik-gaega-imaksadi,","poem":1},{"text":"degine, demar-uurmakega-osukamakedi, weyob soged:","poem":2}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"“We-igarmar-mamaidgi anga gwatirnonikile,","poem":1},{"text":"a-ibagine, Israel-dulemar bar an-dulamarga gussuliled.”","poem":2}]},{"type":"verse","number":37,"content":["Bab-Jehová soged:",{"text":"“Dule, nibneg-matugued wilubsasale,","poem":1},{"text":"degi, napneg-urba napneg-sailagan-mamaid wisgusale,","poem":2},{"text":"ibmar-isgana-imaksamalad-ulale,","poem":1},{"text":"an Israel-dulemar obachaled.”","poem":2}]},{"type":"verse","number":38,"content":["Bab-Jehová weyob soged: “An-neggwebur gannar soblegoed-ibagan dani. Nakuleged-galu-Hananeelʼye-nugad-akar yawagak-Ánguloʼye-nugadse neggwebur ambikuoed."]},{"type":"verse","number":39,"content":["We-akale, ibmar-wilubsaed-dub-baksa, Gareb-yar-mulluse naguoed. Geb Garebʼgi-baksa Goa-neggweburse aibiridoed."]},{"type":"verse","number":40,"content":["Bela neba-naidgi bia dulemar-mui-diglege, degi, burumar-milege bela angadga nugsalegoed. Degine, bela-nainumarnanaid-akale, Cedrón-dian-maidse, degine, dad-nakwedsik molimar-yawagak-gwichidse angadga nugsalegoed. Bipisaale, we-neggwebur bar berguosulid, degi, bar bibisgosulid. Degisadegu sii guoed.”"]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JER/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JER/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JER/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}