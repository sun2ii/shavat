{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JER","translationId":"cuk_nvs","name":"Jeremías","commonName":"Jeremías","title":"JEREMÍAS-GARDA JEREMÍAS","order":24,"numberOfChapters":52,"sha256":"75584cc634e682f16d689c79332a191baf65045db96e9e927452315ef9b2d123","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cuk_nvs/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":["Ani an Bab-Jehová-guedgi bemarga soged:",{"text":"“Bemar Israel-dulemar, gannar be anse-dagmarye-sogele,","poem":1},{"text":"mer bar be isgumalo.","poem":2},{"text":"Be an-asabin ibmar-isgana-bab-dummadyob-imaklemalad-osulogele,","poem":1},{"text":"mer bar be angi bangumalo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ar gakansulidgi, igar-napiragwadgi, innikigwadgi,","poem":1},{"text":"‘Bab-Jehová-nuggi an ise-sogar-sogmarye,’ be sogmalale,","poem":2},{"text":"ar degidbali, ‘dulemar-yar-baid-baidsik-bukwamaladgi anbali egi yeer binsalegoed,","poem":1},{"text":"degine, anbali egi weligwar itomaloed.’ ”","poem":2}]},{"type":"verse","number":3,"content":["Bab-Jehová weyob Judá-dulemarga, degi, Jerusalén-dulemarga soged:",{"text":"“Napa-ebuledisulidgi be ibmar digmala.","poem":1},{"text":"Melle bar iko-imbaba be ibmar digmalo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Judá-dulemar, Jerusalén-dulemar, an-bemarbo-igar-mesisadbarbi be nue-nai gumala,","poem":1},{"text":"be-gwage-ulubgi a-igarbarbi nue-nai be gumala.","poem":2},{"text":"Melle be-ibmar-isgana-imaksamalad-ular, an-urwed sooyobi begi-nodagega be imakmalo.","poem":1},{"text":"An-urwed, soo-gamaiyob, dule geg oginned.”","poem":2},"Judá-dulemar-sae-dakmaladba egi ubolesad Bab-Jehová sogdebalid:"]},{"type":"verse","number":5,"content":[{"text":"“Judá-yalagi, bela be sunmako.","poem":1},{"text":"Jerusalén-neggweburgi, bela gayaburbamar be mimimar.","poem":2},{"text":"‘¡Bela yalamargi gar-trompeta be ogormar!’","poem":1},{"text":"Binnasuli gandikidba be gormakmar.","poem":2},{"text":"Weyob sogmar:","poem":1},{"text":"‘Anmar danar-ambikumar, neg-gandikmaladse ubonamar.’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sión-yarsik bander be oyomar,","poem":1},{"text":"melle be gannaa sigmala,","poem":2},{"text":"gwae be duurmakdemar.","poem":1},{"text":"An bela-belad-dulemar-wiogega dad-nakwed-argan-sapiledsik boni-dummagan an barmidasokalid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bato achumigur-nono-wawaad gagan-imbaba nodanikid,","poem":1},{"text":"dule, dulemar-akar-akar-bukwamalad-obeloged bato igarba danikid.","poem":2},{"text":"Be-yala-obelogega, e-yalagi bangualid.","poem":1},{"text":"Be-neggweburmar akwamarbi ganna-ganna ambikuoed,","poem":2},{"lineBreak":true},{"text":"dulemar bar bukwasuli guoed.”","poem":2}]},{"type":"verse","number":8,"content":["Ani Jeremías sogded:",{"text":"“A-ulale, wile-itoged-mola be yomar,","poem":1},{"text":"bukib be binsamar, wile-itogedba be akiginmar,","poem":2},{"text":"ar Bab-Jehová-bela-bela-urwedi, anmargi urwemaid.”","poem":1}]},{"type":"verse","number":9,"content":["Bab-Jehová sogbalid:",{"text":"“Ani an Bab-Jehová-guedgi bemarga soged:","poem":1},{"text":"A-ibagan warmaknonikile, rey, degi, dummagan-negsemamaid bela dobedba wawanmakdemaloed.","poem":2},{"text":"Dule-irwa-anse-gormalad gwakidmaloed.","poem":1},{"text":"An-gayaburba-barsogmalad geger dakdemaloed.”","poem":2}]},{"type":"verse","number":10,"content":["Ani Jeremías sogded:",{"text":"“An-Bab-Dummad-Jehová, nue be we-dulemar yardaksad,","poem":1},{"text":"nue be Jerusalén-dulemar yardaksad.","poem":2},{"text":"Ega be sogsagusanad: ‘Bonisuli be gudii gumaloye.’","poem":1},{"text":"Emide be dakena, boni-dummaganba galitonanaid.”","poem":2}]},{"type":"verse","number":11,"content":["Bab-Dummad an-abin sogded:",{"text":"“Sabsur-odurdakleged-iba warmaknonikile, we-Jerusalén-dulemarga weyob soglegoed:","poem":1},{"text":"‘An-neggwebursik nega-dulesulidganba yar-mullugan-bukmalad-akar burwa-uereged gordanikid.","poem":2},{"text":"We-burwa-gormaid ibmar-gwag-miegarsulid,","poem":1},{"text":"degi, neg-swiri imakega gormaisulid.’","poem":2}]},{"type":"verse","number":12,"content":[{"text":"An we-burwa-barmidagoedi, binnasuli goled.","poem":1},{"text":"Ar an-sunnagwad, sabsur-odurdakega an we-dulemar imakoed.”","poem":2}]},{"type":"verse","number":13,"content":["Israel-dulemar weyob sogdemaloed:",{"text":"“Be dake, anmar-isdarmalad mogiryob danikid.","poem":1},{"text":"E-ur-napagined-bila-onomalad, burwa-ooregedyob gwichigudanikid.","poem":2},{"text":"E-molimar, sulubagi-gukuedba bur binnasuli abarmakdanikid.","poem":1},{"text":"¡Anmar duledar-wilesmar! ¡Anmar bela!”","poem":2}]},{"type":"verse","number":14,"content":["Bab Jehová soged:",{"text":"“Jerusalén-dulemar, be-gwage-isgudiid be urukmala, adi, be, abonolemalagar.","poem":1},{"text":"¿Ar sana be binsaed-isganamargi-binsaed iemaloye be sogmala?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Dan-neggwebur-akale, Efraín-yalagan-akale,","poem":1},{"text":"gayaburba boni-dummagan-danikidgi-sunmaked noalid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dulemar-yar-baid-baidsik-bukwamalad be owisomar,","poem":1},{"text":"Jerusalén-dulemarga be sogmar:","poem":2},{"text":"‘Dulemar-dikasurmalad begi ubodani,","poem":1},{"text":"Judá-neggweburmargi binnasuli gormakdanimar.’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ani an Bab-Jehová-guedgi soged:","poem":1},{"text":"Dulemar nainu-ebiris-ambikuedyob bela be-ebiris ambikumaloed,","poem":2},{"lineBreak":true},{"text":"ar ade, be angi uayasuli gusmalad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Be-daed-ular, be-ibmar-isgana-imaked-ular, bemar weyob gunanaid.","poem":1},{"text":"¡Ibmar-isgana-imaked bega nunmaked-dummad uksad!","poem":2},{"lineBreak":true},{"text":"¡Gwage-ulubgi nue nunmak be-imaksad!”","poem":2}]},{"type":"verse","number":19,"content":["Ani Jeremías sogded:",{"text":"“¡Nue-nunmak itoleged! ¡Suli-suli an itoged!","poem":1},{"text":"¡An-gwage-ulub nue-nunmak an itogusad!","poem":2},{"text":"¡An-ulubgi an-gwage-ulub nakwamaknaid!","poem":1},{"text":"¡An sunmaksulir guosulid!","poem":2},{"lineBreak":true},{"text":"¡An sunmakergebed!","poem":2},{"text":"Gar-trompeta-goled an itoged,","poem":1},{"text":"bila-onomalad-gormaked an itoged.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Sabsur-wilegedi, ukin-ukin danikid,","poem":1},{"text":"ar bela yalagan sabsur-gusa nagusad.","poem":2},{"text":"Ukiagwale, an-dordoneg maluded,","poem":1},{"text":"an-meged-neg ukiagwale ayarided.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"¿Ar sanagwadse an-isdarmalad-e-bander bar daksuli an guoe?","poem":1},{"text":"¿Ar sanagwadse an-isdarmalad-e-gar-trompeta-goled bar an itogosuli guoe?”","poem":2}]},{"type":"verse","number":22,"content":["Bab-Jehová soged:",{"text":"“An-dulamar binsaedsurmaladid, aku an-dakmalad.","poem":1},{"text":"Mimmigan-binsaedsurmaladid, aku neg-itomalad.","poem":2},{"text":"Ibmar-isgana-imakedsikdi binsaed-ibegan nanamalad.","poem":1},{"text":"Ibmar-nued-imakeddi wissurmalad.”","poem":2}]},{"type":"verse","number":23,"content":["Ani Jeremías sogded:",{"text":"“An napneg-dakdegu, bela napaneg gagales-nai an dakalid.","poem":1},{"text":"Niba an atakdebargu, bela negsichidbi-nai an dakalid.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yalasik an atakdebargu, yalamar giglimakbukwa an dakalid.","poem":1},{"text":"Bela yar-mullugan nakwamakbukwa an dakalid.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"An atakdegu, dulemar sate an dakalid,","poem":1},{"text":"bela nuumar duurmaksa nanaed.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"An nue-dakdebargu, napa-gadi-sanmakedi nega-dulesulidbi-nai an dakalid.","poem":1},{"text":"Bab-Jehová ibmar-imaksadbali, bela neggweburmar akwamarbi ganna-ganna-bukwa gusad.","poem":2},{"lineBreak":true},{"text":"Bab-Dummad-urwedbali, bela deyob gusad.”","poem":2}]},{"type":"verse","number":27,"content":["Bab-Jehová weyobi soged:",{"text":"“Bela yalamar swanga imaklegoed,","poem":1},{"text":"degi-inigwele, naitinagase an obelogosulid.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"A-ulale, bela-yar-naid wile-itonai guoed,","poem":1},{"text":"nibnega negsichidbi naguoed.","poem":2},{"text":"An bato sogsabinned, an-ibmar-sogsad bar an ogwaosulid.","poem":1},{"text":"Bato an imakoye sogsad, bar an igar ogwaosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"”Sorda-sigugi-bila-onomalad binnasuli-goledba, degi, sorda-moligi-sii-urwemalad binnasuli-goledba, dulemar bela duurmakdemaloed.","poem":1},{"text":"Gwenna-gwenna dulemar, bulaganba-doge-doge wakitemaloed,","poem":2},{"lineBreak":true},{"text":"baigandi, akwa-dummagangi nakwidmaloed.","poem":2},{"text":"Bela neggwebur ollobi naguoed,","poem":1},{"text":"dule-wargwensaale bar egi gudii guosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"”Bemar, Jerusalén-dorgan nue be wilesmalad:","poem":1},{"text":"¿Ar igi be binsamala?","poem":2},{"text":"¿Ibiga be mor-gargemalad yomala?","poem":1},{"text":"¿Ibiga be ormar-nuegan nasikmala?","poem":2},{"text":"¿Ibiga be ibya-sigamar magmala?","poem":1},{"text":"Ar binsarsunna yeerdaklege na be san-imaknanaid.","poem":2},{"text":"Ar dule-be-abesmalad, isdar be-dakmalad,","poem":1},{"text":"unnila be-oburgwega be-abemalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"”Igi-ome na gebe e-igargi-boni-itonaile, binnasuli-gornaidae,","poem":1},{"text":"deyobi, dulemar-gole an itoged.","poem":2},{"text":"We-binnasuli-gornanaidi, Sión-dulemar gornaid,","poem":1},{"text":"akus-akus bunnonaid.","poem":2},{"text":"Na e-argan-onakwale, weyob sognanaimalad: ‘¡An duledar-wiles-ini! ¡An bela!","poem":1},{"text":"¡Dule-gindakmalad an-gasmalad!’ ”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JER/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JER/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JER/3.json","previousChapterAudioLinks":{},"numberOfVerses":31}