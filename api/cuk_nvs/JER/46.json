{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JER","translationId":"cuk_nvs","name":"Jeremías","commonName":"Jeremías","title":"JEREMÍAS-GARDA JEREMÍAS","order":24,"numberOfChapters":52,"sha256":"75584cc634e682f16d689c79332a191baf65045db96e9e927452315ef9b2d123","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cuk_nvs/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":46,"content":[{"type":"heading","content":["Egipto-dulemargi iduakwaa-sunmaklesad"]},{"type":"verse","number":1,"content":["Bab-Jehová-gayaburba, e-gayaburba-barsoged-Jeremíasʼse nonikid, neggwebur-baigangi ega sunmaknonikid."]},{"type":"verse","number":2,"content":["Josías-machi-Judá-rey-Joacim, Judá-yalagi birgabakegus dummadga maigua, Babilonia-rey-Nabucodonosor, Egipto-rey-Faraón-Necao-ogalakus gusad. Deunni, Faraón-Necao, Carquemis-neggweburgi Éufrates-diwar-nagaba maigusad. Bab-Jehová, Faraón-Necao-sordamargi, degi, Egipto-dulemargi weyob sognonikid:"]},{"type":"verse","number":3,"content":[{"text":"“Guakwaa sigu-abgaed amimar,","poem":1},{"text":"bila-onogega namar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Guakwaa moli nasikmar.","poem":1},{"text":"Moligi-nanamalad, moligi be nakwemar.","poem":2},{"text":"Guakwaa gudii be imakmar,","poem":1},{"text":"bormo-gurgin be yomar.","poem":2},{"text":"Eswarmar be oswiswimakmar.","poem":1},{"text":"Esgoro-mor be yomar.”","poem":2}]},{"type":"verse","number":5,"content":["Bab-Jehová soged:",{"text":"“¿Ar wede igidi?","poem":1},{"text":"Be-sorda-bila-onomalad galakudmalad,","poem":2},{"lineBreak":true},{"text":"gannar sorsik sikirmakdemalad.","poem":2},{"text":"Ise-gwayale, sorsik-ataksuli duurmakmamaid.","poem":1},{"text":"Bela dobegwar neg itoleged.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dule-binnasuli-yeer-abarmakedi, geg wakinned,","poem":1},{"text":"dule-gandikidi, geg dukued.","poem":2},{"text":"Dad-nakwed-argan-sapiledsik Éufrates-diwar-gakaba, yoledapdamalad,","poem":1},{"text":"aimukuddamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"”¿Ar wede doawa? Nilo-diwar-nodanikidyob nodaniki.","poem":1},{"text":"¿Wede doa diwar-sukamakdanikidyob daniki?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Egipto-sordamar danikid,","poem":1},{"text":"Nilo-diwar-engudanikidyob danikid,","poem":2},{"lineBreak":true},{"text":"diwar-sukamakdanikidyob danikid.","poem":2},{"text":"Ar Egipto-sordamar soged: ‘Yar-birise an nakoed,","poem":1},{"text":"bela yalamar-naid an odogoed.","poem":2},{"text":"Neggweburmar an osulogoed,","poem":1},{"text":"degi, an e-dulemar obelogoed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"¡Molimar, be urwemar!","poem":1},{"text":"¡Bila-ur-napaginmalad, binnasuli be abarmakmar!","poem":2},{"text":"¡Sorda-bila-onomalad, ginemar!","poem":1},{"text":"¡Cus-sordamar, be-sigu-abgaed be gamar!","poem":2},{"text":"¡Fut-sordamar, be-sigu-abgaed be sumar!","poem":1},{"text":"¡Lidia-sordamar, be-warsi be yaa imakmar!’","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”We-iba, Bab-Jehová-Bela-Gangued-Nikad-ibad.","poem":1},{"text":"Buged-mai-imaked-ibaga guoed,","poem":2},{"lineBreak":true},{"text":"e-isdarmaladgi buged-mai imakoed.","poem":2},{"text":"Es-suid geg-itogusadse dulemar-gindakoed,","poem":1},{"text":"es-suid na dulemar-ablisgine immelegoed.","poem":2},{"text":"Dad-nakwed-argan-sapiledsik, Éufrates-diwar-gakaba,","poem":1},{"text":"Bab-Jehová-Bela-Gangued-Nikadi, dulemar-oburgoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”Egipto-dulemar, Galaad-yalase be namar,","poem":1},{"text":"ase, ina-wawadikid be aminamar.","poem":2},{"text":"Inamar bukidar be amimalo-inigwele,","poem":1},{"text":"gwen be nuguosurmalad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bato neggwebur-baigan be-galakusad wismalad,","poem":1},{"text":"binnasuli be-boedi bela napaneg-naidgi itoleged.","poem":2},{"text":"Sorda-bila-onoged, sorda-baidbo-yolenanaidi,","poem":1},{"text":"ebobela napagi aimukumamaid.”","poem":2}]},{"type":"verse","number":13,"content":["Bab-Dummad-gayaburba-barsoged-Jeremíasʼse weyob Bab-Jehová-gayaburba nonikid. Deunni, Babilonia-rey-Nabucodonosor, Egipto-yalagi gwichigudanigu, ega weyob sognonikid:"]},{"type":"verse","number":14,"content":[{"text":"“Egipto-yalagi we-ibmar be sogmalo,","poem":1},{"text":"Migdol-neggweburgi, Menfis-neggweburgi, degine, Tafnes-neggweburgi be weyob sogmalo:","poem":2},{"text":"‘¡Guakwaa bukumalo, ise-neg-itogar ambikumalo!","poem":1},{"text":"¡Be-dikarbali, es-suidmar neg-gagadagoed!’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"¿Ar ibiga be-sorda-bila-onomalad aimukumamai?","poem":1},{"text":"Ar gege gannaa gwisgumalad,","poem":2},{"lineBreak":true},{"text":"ar Bab-Jehová we-dulemar-omukusad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Be-sordamar, egi yolenanaid,","poem":1},{"text":"na birgi-birgine aimukumamaid.","poem":2},{"text":"Weyob sogmalad: ‘Gwichibin sae,","poem":1},{"text":"anmar-neggweburse anmar nae,","poem":2},{"text":"anmar-gwalulesad-yarse anmar nae,","poem":1},{"text":"anmar-isdarmalad-es-suid-idu anmar wakinne.’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Degi, binnasuli weyob sogmalad:","poem":1},{"text":"‘¡Faraón unnila binsa ee gordii!","poem":2},{"lineBreak":true},{"text":"¡Egipto-reyga-ibmar-soglesad bergusad!’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ani an Rey gued, dula-maidid,","poem":1},{"text":"Bab-Jehová-Bela-Gangued-Nikadye an nugad.","poem":2},{"text":"An soged:","poem":1},{"text":"“Igi yar-baiganba bur Tabor-yar-dummad nosii,","poem":2},{"text":"igi demar-gakaba Carmelo-yar bipisur nosii,","poem":1},{"text":"deyob-dungueyobi, be-isdarmalad begi danimaloed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bemar Egipto-yalagi-bukmaladi, gales-ebipiledmaloed-idu be guakwaa ambikumalo.","poem":1},{"text":"Ar Menfis-neggwebur bela ollobi naguoed,","poem":2},{"lineBreak":true},{"text":"bela bibisgoed, dulemar egi megosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"”Egipto-yala, moli-bebe-nikad-bunolo-yeerdaklegeyob dakleged,","poem":1},{"text":"degi-inigwele, obelolegegala dad-nakwed-argan-sapiledsik, moliburyobi egi danimalad.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"E-sordamar-manigi-bennuklegarmalad ilemakar-bukwad,","poem":1},{"text":"moli-bebe-nikad-bunolomar-wardada-daklegedyob dakleged,","poem":2},{"text":"amarmoga, gannar sorsik duurmakmaimarmogad,","poem":1},{"text":"bela danagwena gwen gwisgusuli duurmakmamaid,","poem":2},{"text":"ar e-bergued-ibagan ega mosad,","poem":1},{"text":"degi, sabsur-odurdakleged-ibagan ega nagunonikid.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Egipto-sordamar naibe-goleyobi-itolege duurmakmamaid,","poem":1},{"text":"e-isdarmaladdi gandikidgi egi warmakdanikid.","poem":2},{"lineBreak":true},{"text":"Sapi-sikmaladyobi, akan annik-annik e-bina danimalad.”","poem":2}]},{"type":"verse","number":23,"content":["Bab-Jehová soged:",{"text":"“Be-sapimar ise-gwamakar-bukwa-inigwele,","poem":1},{"text":"bela naitinagase obelolegoed.","poem":2},{"text":"Sapi-sikmaladi, bur bule sesmarba mergued,","poem":1},{"text":"dule geg we-dulemar ebised.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Egipto-yala-yeerdaklegedi, nue obingegsalegoed.","poem":1},{"text":"Dulemar-dad-nakwed-argan-sapiledsikmaladga uklegoed.”","poem":2}]},{"type":"verse","number":25,"content":["Israel-dulemar-e-Bab-Dummad-Jehová Bela-Gangued-Nikadi soged: “An Tebas-dulemar-e-bab-dummad-Amónʼye-nugad sabsuli odurdakoed. Degi, Egipto-dulemar, e-bab-dummagan, degine, e-reymar an sabsur-odurdakbaloed. Degine, Faraón, degi, dulemar-Faraónʼgi-bensurmalad an sabsur-wiobaloed.”"]},{"type":"verse","number":26,"content":["Bab-Jehová soged: “Dulemar-be-oburgwebi-gudimaladga an be-urmakoed, Babilonia-Rey-Nabucodonosorʼga, degi, ega-arbamaladga an be-ukoed. Geb a-sorbali, Egipto-neggwebur epennegwadyobi gannar ambikuoed."]},{"type":"verse","number":27,"content":[{"text":"Be an-dula-Jacob-wagan-gumaladi, melle be gwayemar,","poem":1},{"text":"Israel-wagan, melle be dobee itomar.","poem":2},{"text":"Jacob-wagan, ar an we-yargi bemar-onogoed,","poem":1},{"text":"ar be-wagan Babiloniaʼgi-gales-bukmaladgi an onogoed.","poem":2},{"text":"Gannar be bogidik-gudii guoed,","poem":1},{"text":"dobedsuli be garmakdii guoed.”","poem":2}]},{"type":"verse","number":28,"content":["Bab-Jehová soged:",{"text":"“Be an-dula-Jacob-wagan-gumaladi, melle be gwayemar.","poem":1},{"text":"Be-bendakega an be-yalaba gudiid.","poem":2},{"text":"Bia an be-oaisakismala, a-yalamar an bela-naitinagase obelogele,","poem":1},{"text":"bemardi an be-obelogosulid.","poem":2},{"text":"Unnila igar-innikigwadba an sabsur-bemar-odurdakoed,","poem":1},{"text":"an bemar-odurdaksuli an guosulid, an bemar-odurdakedsegad.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JER/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JER/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JER/45.json","previousChapterAudioLinks":{},"numberOfVerses":28}