{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JER","translationId":"cuk_nvs","name":"Jeremías","commonName":"Jeremías","title":"JEREMÍAS-GARDA JEREMÍAS","order":24,"numberOfChapters":52,"sha256":"75584cc634e682f16d689c79332a191baf65045db96e9e927452315ef9b2d123","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cuk_nvs/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":47,"content":[{"type":"heading","content":["Jeremías, Filistea-dulemargi iduakwaa-sunmaksad"]},{"type":"verse","number":1,"content":["Faraón, Gaza-neggweburgi-gwichigued-iduale, Bab-Jehová-gayaburba, e-gayaburba-barsoged-Jeremíasʼse nonikid, adi, Filistea-dulemargi ega sunmakegar."]},{"type":"verse","number":2,"content":["Bab-Jehová weyob soged:",{"text":"“¡Dad-nakwed-argan-sapiledsiki, diwar-nodanikid be dakmala!","poem":1},{"text":"Bela yala-ododanikid, bela yalagi-ibmar-bukwad ododanikid,","poem":2},{"lineBreak":true},{"text":"neggweburmar, degi, e-dulemar-bukwad ododanikid.","poem":2},{"text":"¡Dulemar bela oimakdemalad!","poem":1},{"text":"¡Napneggi-dulamar-bukwad bela ogormakdemalad!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Babgan molimar-nag-gole itoarmargu,","poem":1},{"text":"ur-napaginmalad-e-nagmar-bipirmaknaid-gole itoarmargu,","poem":2},{"text":"degine, ur-napaginmalad-gole itoarmargu,","poem":1},{"text":"babgan dobedbali niga-argwatemalad,","poem":2},{"lineBreak":true},{"text":"na e-mimmigan iedmalad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bela Filistea-dulemar-obeloged-iba nonikid,","poem":1},{"text":"Tiro-sorda-bendakmalad-obeloged-iba, degi, Sidón-sorda-bendakmalad-obeloged-iba nonikid.","poem":2},{"text":"Bab-Jehová, Filistea-dulemar obelogoed,","poem":1},{"text":"Caftor-demar-gakaba-dulemar-bukmalad obelobaloed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gaza-dulemar nono-swiri imakdemalad, Ascalón-dulemar geg-sunmake gudmalad.","poem":1},{"text":"Bemar-nebagi-bukmaladi, ¿sanagwadse na be dukin san-daas-daas imaksuli gumaloe?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"”¡Duledar-wiles! Bab-Jehová-es-suid begi nosa.","poem":1},{"text":"¿Ar sanagwadse be bar anmar-oburgosurye soge?","poem":2},{"text":"¡Es-suid, be-ukayaba be doge!","poem":1},{"text":"¡Boo be mege, melle be anmar-gindake!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"”¿Ar sunna es-suidde boo megosi?","poem":1},{"text":"Ar Bab-Jehová, Ascalón-dulemar-ogilogega, demar-gakaba-bukmalad-oburgwega ega igar uksad.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}