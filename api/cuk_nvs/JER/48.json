{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JER","translationId":"cuk_nvs","name":"Jeremías","commonName":"Jeremías","title":"JEREMÍAS-GARDA JEREMÍAS","order":24,"numberOfChapters":52,"sha256":"75584cc634e682f16d689c79332a191baf65045db96e9e927452315ef9b2d123","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cuk_nvs/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":48,"content":[{"type":"heading","content":["Moab-dulemargi-iduakwaa-sunmaklesad"]},{"type":"verse","number":1,"content":["Bab-Jehová-Bela-Gangued-Nikadi weyob Moab-dulemarnik soged:",{"text":"“¡Nebo-neggwebur, be duledar-wiles!","poem":1},{"text":"Ar bela be berguoed.","poem":2},{"text":"¡Quiriataim-neggwebur galegoed, obingegsalegoed!","poem":1},{"text":"E-neggwebur-galu-matusulid-akwabiid, bela omukulegoed,","poem":2},{"lineBreak":true},{"text":"bela obelolegoed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Moab-neggwebur-yeerdakleged, bela yogguded.","poem":1},{"text":"Hesbón-neggweburgi egi weyob igar aminanaid: ‘¡Dagmar, anmar we-neggwebur obelonamala!’","poem":2},{"text":"Madmena-neggwebur, be amba gumogoed,","poem":1},{"text":"be obelolemogoed,","poem":2},{"lineBreak":true},{"text":"ar es-suid begi gwisgusuli guosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"”Horonaim-neggwebur-akale, binnasuli dule-gole itoleged, weyob soged:","poem":1},{"text":"¡Neg bela! ¡Neg bibichide!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Moab-neggwebur bibichisad,","poem":1},{"text":"bato e-burwigan-binnasuli-boed itoleged.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Luhitʼye-neg-nugad-nakwemaidbali, dulemar ogormakar-ogormakar nakwemamaid.","poem":1},{"text":"Moab-neggwebur-obelolenaid-ulale,","poem":2},{"text":"Horonaim-neggwebur-aidemaidbali,","poem":1},{"text":"dulemar nunmakedba-binnasuli-goled itoleged.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"¡Be wakinmala! ¡San-onogega be abarmakdemala!","poem":1},{"text":"¡Moli-uayasuid-sapurbalidyob be abarmakdemala!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Moab, be-ibmar-imakedgi be bensursoggu,","poem":1},{"text":"degi, be-ibmar-nuegan-nikadgi be bensursoggu, be galemogoed.","poem":2},{"text":"Be-bab-dummad-Quemos, e-dule-irwa-gormaladbo, degi, ega-arbamaladbo, gales seledmogoed.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Bela neggweburmargine, dule-obeloged gwichigunonikoed.","poem":2},{"text":"Neggwebur-gwagwensaale, gwen san onogosulid.","poem":1},{"text":"Bab-Jehová-sogsadyob guoed:","poem":2},{"text":"Neba-naidi bela swanga naguoed,","poem":1},{"text":"neg-duturgan-naid bela berguoed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Moab-neggweburga be guakwaa napa mese,","poem":1},{"text":"ar bato bergus siid.","poem":2},{"text":"Bato e-neggweburmar bela ollo-ollo naid,","poem":1},{"text":"ar dulemar neggweburmargi bar gudisulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Dule an-sogedba ibmar-imaksulile, a-dule iwigusun.","poem":1},{"text":"Dule an-sogedba dulemar-oburgwebisulile, a-dule iwigusun.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”Moab-dulemar ambikuded-akale, bonisuli bukwad.","poem":1},{"text":"E-dulemala wargwensaale, neggwebur-baidse gales seledisulid.","poem":2},{"text":"Vino-nuedyob Moab-dulemar gued.","poem":1},{"text":"Igi vino gusgu siigudae, deyob, Moab-dulemar gumogad.","poem":2},{"text":"A-ulale, bela ega nueganbi ibmar nadegusad,","poem":1},{"text":"e-damalad gwen gwagmaisulid.”","poem":2}]},{"type":"verse","number":12,"content":["Bab-Jehová soged:",{"text":"“Ibagan dani. Moab-dulemar-isdarmalad, Moab-dulemargi an barmidagoed,","poem":1},{"text":"adi, Moab-dulemar yar-baidse sedmalagar.","poem":2},{"text":"Moab-yala ollomaklegoed,","poem":1},{"text":"e-neggwebur bela bibisgoed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Geb agine, Moab-dulemar e-bab-dummad-Quemosʼye-nugadgi bingedar itomaloed.","poem":1},{"text":"Igi Israel-dulemar bab-Betelʼye-nugadgi bingegusmala, deyob Moab-dulemar gumaloed.","poem":2},{"text":"Deun, Israel-dulemar bab-dummad-Betelʼgi bengussurmalad,","poem":1},{"text":"e-bendakoye bismalanad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"”Mer be sogmalo: ‘Anmar dule-bila-onomalad-buleganye,","poem":1},{"text":"anmar bila-onoged-gandikmaladye.’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ani an Rey-guedi, Bab-Jehová-Bela-Gangued-Nikadye an nugad.","poem":1},{"text":"Weyob an soged:","poem":2},{"text":"Moab-dulemar bela oitolegoed,","poem":1},{"text":"e-neggweburmar bela sulegoed.","poem":2},{"text":"E-sapingana, oburgwileged-negse seledoed.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Moab-neggwebur-bergued omosad.","poem":2},{"lineBreak":true},{"text":"E-bonigan bato egi walikgusad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bemar, Moab-yar-dikarba-bukmaladi, Moab-dulemarga be bomar.","poem":1},{"text":"Moab-dulemar-nug-dummarba-nikad-wismalad, Moab-dulemarga be bomar.","poem":2},{"text":"Weyob be sogmar: ‘Be dake, ibibayobi Moab-neggwebur bergusa.","poem":1},{"text":"Ar Moab-neggwebur yeer-ganguedinad, degite bergusad.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"”Bemar, Dibón-neggweburgi-bukmaladi, be-mamaidgi be ainidamar,","poem":1},{"text":"napa-dinnaregedgi be bukudamar.","poem":2},{"text":"Ar Moab-e-isdarmaladi, bemargi yolenaid,","poem":1},{"text":"be-neg-gandikmalad bemar-ibe bibisgenaid.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bemar, Aroer-neggweburgi-bukmaladi,","poem":1},{"text":"igarba be gwisgudamar, be dakdamar.","poem":2},{"text":"Machergan-wakinmamaidse, omegan-wakinmamaidse, be weyob egisdamar:","poem":1},{"text":"‘¿Wede igi neg gunai?’","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Moab-dulemar oitolesmalad,","poem":1},{"text":"dule-baiganse galakusmalad.","poem":2},{"text":"¡Ega be bomala!","poem":1},{"text":"¡Ega be nunmak itomala!","poem":2},{"text":"Arnón-diwarba be sogmalo,","poem":1},{"text":"Moab-dulemar nue-oitolesye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"”Nebagi neggweburmar-bukmaladi, ega odurdakleged-iba omosad.","poem":1},{"text":"We-neggweburmar odurdaklegoed:","poem":2},{"lineBreak":true},{"text":"Holón-neggwebur, Jahaza-neggwebur,","poem":2},{"lineBreak":true},{"text":"degi, Mefaat-neggwebur,","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Dibón-neggwebur, Nebo-neggwebur,","poem":2},{"lineBreak":true},{"text":"Bet-Diblataim-neggwebur,","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Quiriataim-neggwebur, Bet-Gamul-neggwebur,","poem":2},{"lineBreak":true},{"text":"degine, Bet-Meón-neggwebur,","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Queriot-neggwebur, Bosra-neggwebur,","poem":2},{"text":"degi, bela Moab-neggweburmarga odurdakleged-iba omosad.","poem":3},"”Neggwebur itikiganaga, degine, dikasurmaladga odurdakleged-iba omosad.”"]},{"type":"verse","number":25,"content":["Bab-Jehová soged:",{"text":"“Moab-neggwebur-gangued bergusad,","poem":1},{"text":"e-garganguedi surgunonikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"”Be Moab-dulemar-omumsamar","poem":1},{"text":"ar Bab-Jehováʼba uayasuli nanasmalad.","poem":2},{"text":"Moab-dulemar e-agedgi bindumakega be samar.","poem":1},{"text":"Moab-dulemargi dodolegega gusun.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Moab, ¿ar bede Israel-dulemargi dodoardasursi?","poem":1},{"text":"¿Egi mesagwar be sunmakardasursi?","poem":2},{"text":"Dule-atursamaladbo-daklesayob,","poem":1},{"text":"¿egi be sunmakardasursi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"”Moab-dulemar, neggweburmargi be ainimar,","poem":1},{"text":"akwa-dummagan-imbaba be megnamar.","poem":2},{"text":"Nuu-gudiiyobi, be garmakdii imaknamar,","poem":1},{"text":"akwa-yaba e-uu-sii-damaladyob be gudii imaknamarsun.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Moab-dulemar-san-dummarba-imakedi anmar wisid,","poem":1},{"text":"doggus na san-dummarbaa imakmalad.","poem":2},{"text":"San-bule-bule samalad, san-dummarbaa imakmalad,","poem":1},{"text":"san-gandiki samalad, dule-buled san-imakmalad.”","poem":2}]},{"type":"verse","number":30,"content":["Bab-Jehová soged:",{"text":"“Moab-dulemar-san-dummarba-imaked an wisid,","poem":1},{"text":"ar e-bule-buledaedi gwen e-bendakosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"”A-ulale, Moabʼga an bukib-binsaoed,","poem":1},{"text":"bela Moab-dulemarga an booed,","poem":2},{"text":"degi, a-ulale, Kir-Hares-neggweburga an osgomakoed.","poem":1}]},{"type":"verse","number":32,"content":[{"text":"Sibma-neggwebur-uva-nainu, an Jazer-neggweburga-boedba, an bega bur bule booed.","poem":2},{"text":"Be-anagan bela demarse warmaked, bela Jazerʼse warmaked.","poem":1},{"text":"Degi-inigwele, dule-obelogedi be-uva-nainugi, degi, be-uvaʼmargi gwichiguoed.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Moabʼgi nainu-gadi-sanmakmalad-nanaidgi, yeer-itolegedi, degi, weligwar-itolegedi bar itolesulid.","poem":1},{"text":"Uva-egured-galu an obelosad,","poem":2},{"text":"bar dule weligwaledba uva-egurnai guosulid,","poem":1},{"text":"binnasuli-dule-goledi bar weligwaledba golosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"”Hesbón-dulemar-boedi, Eleale-neggweburse itoleged,","poem":1},{"text":"Jahaza-neggweburse e-boed warmaked.","poem":2},{"text":"E-goledi, Zoar-neggwebur-akar, Horonaim-neggweburse itoleged,","poem":1},{"text":"degi, Eglat-Selesiyáʼse warmaked.","poem":2},{"lineBreak":true},{"text":"Ar Nimrim-diwarbela dinna guoed.”","poem":2}]},{"type":"verse","number":35,"content":["Bab-Jehová soged:",{"text":"“Moab-dulemar bab-dummadgan-aila-matusulidgi ibmar-ogumakar-ukmalad an obelogoed.","poem":1},{"text":"Degine, e-bab-dummaganga ina-wawadikmalad-ukmalad an obelobaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"”A-ulale, gar-gammu-goledba, an-ulubgi an Moab-dulemarga boed.","poem":1},{"text":"Gar-gammu-goledba, an-ulubgi an Kir-Hares-dulemarga boed.","poem":2},{"lineBreak":true},{"text":"Ar e-ibmar-nuegan-onmaksadi bela bergusad.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Bela Moab-dulemar bukib-itogedba sailagia-swiri ialedbimalad,","poem":1},{"text":"degi, bela sigamar ialedbimalad.","poem":2},{"text":"Bela arganmar daas-daas galadbimalad,","poem":1},{"text":"degi, bela bukib-binsaed-mor yoyoidbimalad.”","poem":2}]},{"type":"verse","number":38,"content":["Bab-Jehová soged:",{"text":"“Mete-isgana-mamarisayobi, an Moab-dulemar imaksad.","poem":1},{"text":"A-ulale, Moab-dulemar-negmar-birgine, degi, neg-galimbabali, unnila dulemar-boedbi itoleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"”Moab-dulemarga be bomala.","poem":1},{"text":"Moab ibiyobi bibichisa-sii be dake,","poem":2},{"text":"ibiyobi bingegudmala,","poem":1},{"text":"gannar sorsik aibiris imaksamalad.","poem":2},{"text":"Dulemar-e-yar-dikarba-mamaidga, dodogedga guded,","poem":1},{"text":"dule-ogwayedga guded.”","poem":2}]},{"type":"verse","number":40,"content":["Bab-Jehová weyob soged:",{"text":"“Be dakmar, Moab-isdarmaladi, suluba-gukuedyobi danimalad.","poem":1},{"text":"Moab-dulemarbina guakwaa danimalad.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Moab-neggweburmar bela sulegoed,","poem":1},{"text":"e-neg-gandikmalad bela egadga imakmaloed.","poem":2},{"text":"A-ibagine, Moab-sorda-bila-onomaladi, ome-ugakgunair boniganba-galitonaidaeyobi,","poem":1},{"text":"wile itomaloed.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Moab-dulemar bela berguoed,","poem":1},{"text":"ar Bab-Jehováʼgine san-dummarbaa imaksad.”","poem":2}]},{"type":"verse","number":43,"content":["Bab-Jehová soged:",{"text":"“Moab-dulemar-iduale, yaa-dummadi e-abindaksiid,","poem":1},{"text":"gwayed-dummadi e-abindaksiid,","poem":2},{"lineBreak":true},{"text":"yardakleged-galu e-abindaksiid.”","poem":2}]},{"type":"verse","number":44,"content":["Bab-Jehová soged:",{"text":"“Dule, dobedba wakinmaile, yaa-dummadgi argwandapoed,","poem":1},{"text":"dule, yaa-dummadgi-nosale, yardakleged-galugi galegoed.","poem":2},{"lineBreak":true},{"text":"Ar ani an, Moab-dulemargi sabsur-odurdakleged-iba barmidagoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"”Gwenna-gwenna nue-yegus Hesbónʼse modapmaloed.","poem":1},{"text":"Ar Rey-Sehón-neggwebur-Hesbónʼgi, bela soo gwichiguoed.","poem":2},{"text":"Soo bela Moab-yarsik-gwagmai,","poem":1},{"text":"Moab-dulemar-san-dummarba-samalad obelogoed.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Moab, be duledar-wiles,","poem":1},{"text":"bab-dummad-Quemos-e-neggwebur bela bibichisad.","poem":2},{"text":"Be-mimmigan, yar-baidse-selesmalad,","poem":1},{"text":"be-bunamala, gales selesmalad.”","poem":2}]},{"type":"verse","number":47,"content":["Bab-Jehová soged:",{"text":"“Ibagan-danikoedgine,","poem":1},{"text":"an Moab-dulemar gannar e-yarse-dagega an imakoed.”","poem":2},"Wese, Moab-dulemar-sabsur-odurdaklegoedgi sunmaklenaid."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}