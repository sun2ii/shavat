{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JER","translationId":"cuk_nvs","name":"Jeremías","commonName":"Jeremías","title":"JEREMÍAS-GARDA JEREMÍAS","order":24,"numberOfChapters":52,"sha256":"75584cc634e682f16d689c79332a191baf65045db96e9e927452315ef9b2d123","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cuk_nvs/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":49,"content":[{"type":"heading","content":["Amón-dulemargi-iduakwaa-sunmaklesad"]},{"type":"verse","number":1,"content":["Bab-Jehová weyob Amón-dulemarnik soged:",{"text":"“¿Ar Israel-dulemarde mimmigan satesi?","poem":1},{"text":"¿Ar e-sorba ibmar-gamaladde satesi?","poem":2},{"text":"¿Ar ibiga bab-dummad-Milcomʼde Gad-neggwebur-susa?","poem":1},{"text":"¿Ar ibiga Milcom-e-dulemar we-neggweburmargi mamai?”","poem":2}]},{"type":"verse","number":2,"content":["Bab-Jehová soged:",{"text":"“Ibagan dani, Rabáʼgi Amón-dulemar-bukmaladgi bila-onoleged-itolegega an imakoed.","poem":1},{"text":"Bela e-neggweburmar bibisgoed,","poem":2},{"lineBreak":true},{"text":"bela e-neggweburmar gummakoed.","poem":2},{"text":"Israel-dulemar, dulemar e-annik neg-susmalad-annik,","poem":1},{"text":"gannar neggwebur sumaloed.”","poem":2}]},{"type":"verse","number":3,"content":["Bab-Jehová soged:",{"text":"“Hesbón-dulemar, Hai-neggwebur-bibichisadga be bomar.","poem":1},{"text":"Rabá-bunamala, Haiʼga be binnasuli gormakmar.","poem":2},{"text":"Bukib-binsaed-mor be yomar,","poem":1},{"text":"ega be bukib binsamar.","poem":2},{"text":"Gannar-gannar abarmakgwichi be imakmar.","poem":1},{"text":"Ar bab-dummad-Milcom dule-irwa-ese-gormaladbo, degi, ega-arbamaladbo-galesa selesad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Amón-dulemar, ¿ibiga be be-nebaganba san-dummarba imake?","poem":1},{"text":"¿Ibiga be be-nebagan-gadi-sanmakedba nug-dummarba itoge?","poem":2},{"text":"Amón-dulemar-uayasulidaed, unnila be be-ibmar-nuegan-nikadgi-bensuli gudiid,","poem":1},{"text":"be weyob soged:","poem":2},{"text":"‘¿Doa angi gwichiguoe?","poem":1},{"text":"Dule angi gwichiguosuli.’ ”","poem":2}]},{"type":"verse","number":5,"content":["Bab-Jehová-Bela-Gangued-Nikadi soged:",{"text":"“Dulemar-be-yar-nagaba-bukmaladi, be-ogwayega an imakoed,","poem":1},{"text":"degine, be-baleginnega an saoed.","poem":2},{"text":"Bela bemar we-yalagi onilemaloed.","poem":1},{"text":"Dule-wakinmaloedi, dule gwen gannarse bar-urbosulid.”","poem":2}]},{"type":"verse","number":6,"content":["Bab-Jehová soged:",{"text":"“Bela we-ibmar-guoed-sorbali,","poem":1},{"text":"Amón-dulemar-gales-selesmaladi, gannar an sedagoed.”","poem":2}]},{"type":"heading","content":["Jeremías, Edom-dulemargi iduakwaa-sunmaksad"]},{"type":"verse","number":7,"content":["Bab-Jehová-Bela-Gangued-Nikadi weyob Edom-dulemar-annik soged:",{"text":"“¿Temán-yargi dule-binsaed-ibegan satesi?","poem":1},{"text":"¿Dule-binsaed-ibegan-ebinsaedde bergussi?","poem":2},{"lineBreak":true},{"text":"¿E-binsaed-nikad bela bergussi?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dedán-dulemar, be wakinmala,","poem":1},{"text":"gannar sorsik be namala.","poem":2},{"lineBreak":true},{"text":"Yaa-ollogan matusur-bukmaladba be dukunamala.","poem":2},{"text":"An Esaú-wagangi boni-dummad barmidsokalid,","poem":1},{"text":"sabsur-odurdakleged-iba ega omosad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Uvaʼmar welealile, abala obatilesdaed.","poem":1},{"text":"Mutikidba atursaed-dule ibmar-atursanonikile, unnila e-ibmar-abegedbi na sesdaed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Degi-inigwele, andina, bela Esaú-dulemar obelogoed.","poem":1},{"text":"E-dukubukmalad an balamioed, gwen bar dukuosurmalad.","poem":2},{"text":"E-mimmigana, e-gwenadgana, degine, dulemar-e-neg-dikarba-mamaidi, an obelogoed,","poem":1},{"text":"bar bukwa guosurmalad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Be anga be-mimmi-babgan-satemalad obego,","poem":1},{"text":"ani an bega akoed,","poem":2},{"lineBreak":true},{"text":"be-omegan-ei-sui-burgwismalad, ani an bega nioed.”","poem":2}]},{"type":"verse","number":12,"content":["Weyob Bab-Jehová soged: “Sabsur-odurdakleged-igar-ega-maisurmaladbela sabsur-odurdaklesad. Edom-dulemar, be-bulesunna, ¿sunna be sabsur-odurdaklegosur be insae? Be sabsur-odurdaklegergebed, be agi wakinnosulid.”"]},{"type":"verse","number":13,"content":["Bab-Jehová soged: “An-nuggi an-dukin ise-sogar weyob soged: Bosra-neggwebur ukabsalegoed, isdar-daklegedga guoed, degi, mesagwar-daklegedga guoed, degine, ollobi-selenai guoed. Degisadegu, e-neggweburmar bibichis bukuoed.”"]},{"type":"verse","number":14,"content":[{"text":"Bab-Jehová-gayaburba an itosad,","poem":1},{"text":"dule-gayaburba-nued-berbegedi dulemar-abargi weyob ibmar-soge an itosad:","poem":2},{"text":"“Be danar-ambikumar,","poem":1},{"text":"Edomʼgi be gwichigudamar.","poem":2},{"lineBreak":true},{"text":"Bila-onoged-idu be guagwar bukumar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"”Edom, an, neggwebur-baiganba bipii be-imakoed,","poem":1},{"text":"dulemar-abargi mesagwar an be-imakoed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Akwasaila-dummagan-olloganba be bukwamaladi, yala-dummaganba be mamaidi, be dukin emar-ogwayedgi yamolesmalad,","poem":1},{"text":"be san-dummarba-samaladgi yamolesmalad.”","poem":2},"Bab-Jehová soged:",{"text":"“Bemar sulubagiyobi nibaduku be-neg be sismalale,","poem":1},{"text":"amba an bemar-ibe obelogoed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Edom-yala-wilegoedi, bela-belad wilegoed.","poem":1},{"text":"Dulemar a-yar-nagaba-nasmaloedi, geger Edom-yala-wilesadi dakdamaloed.”","poem":2}]},{"type":"verse","number":18,"content":["Bab-Jehová soged:",{"text":"“Sodoma-neggwebur-wilesadyobi,","poem":2},{"lineBreak":true},{"text":"Gomorra-neggwebur-wilesadyobi,","poem":2},{"lineBreak":true},{"text":"degine, neggweburmar-e-dikarba-bukmalad-wilesadyobi,","poem":2},{"text":"Edom-yala gumogoed.","poem":3},{"text":"Dulemar, agine gwen bar gudii guosulid,","poem":1},{"text":"degi, dulemar egi gwen bar ambikuosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"”Achumigur Jordán-diwar-bulaganba, gagan-nuegan-naidse nodanidaedyobi,","poem":1},{"text":"ukiagwale, an Edom-dulemargi gwichigudagoed.","poem":2},{"text":"Edom-dulemargi an dule-nug-imaksadi dummadga an mesoed.","poem":1},{"text":"Ar ade, ¿doa anyobsunna?","poem":2},{"text":"¿Doa angi obinosunna?","poem":1},{"text":"¿Biti-sibad-edarbed angi gwisguosunna? Dule angi obinosuli.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Be an-itomar.","poem":1},{"text":"An Edom-dulemarga igar-mesisad be itomar.","poem":2},{"text":"Temán-dulemarga igar-mesilesad be itomar:","poem":1},{"text":"Emar-imbagi sapingan-senigana ebipiledmaloed,","poem":2},{"lineBreak":true},{"text":"e-gagan-nanaidi, swanga naguoed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Edom-neggwebur-berguoedi neg-ogiglimakoed,","poem":1},{"text":"Demar-Ginnidye-nugadse e-gollomaked itolegoed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Sulubagi sakan-nallaa-danidaeyobi Bosra-e-isdarmaladi, Bosra-neggweburgi gwichigudanikid.","poem":1},{"text":"A-ibagangine, Edom-sorda-gandikmaladi, ome-e-boniganba-galitonaidaeyobi gumaloed.”","poem":2}]},{"type":"heading","content":["Damasco-neggweburgi-iduakwaa-sunmaklenaid"]},{"type":"verse","number":23,"content":["Bab-Jehová weyob Damasco-dulemar-annik soged:",{"text":"“Hamat-neggwebur, degi, Arfad-neggwebur, bato garda-isgana-wisgusmaladba suli-suli itobukwad.","poem":1},{"text":"Ar bela-belad nue-dobe itomalad,","poem":2},{"lineBreak":true},{"text":"geg bogi na ambikumalad.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Damasco-dulemar geger itogusad,","poem":1},{"text":"aisaar wakinye sokalinad,","poem":2},{"lineBreak":true},{"text":"degi-inigwele, dobedbali geg wakinne gusad.","poem":2},{"text":"Ome-e-boniganba-galitonaidaeyobi,","poem":1},{"text":"Damasco-dulemar dobed itobukwad.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ibiyobi neggwebur-nuga-nikad-idu duurmakmamai.","poem":1},{"text":"We-neggweburde weligwar itosiidid.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ani Bab-Jehová-Bela-Gangued-Nikadi soged:","poem":1},{"text":"A-ibagangine, e-sapingana, neg-imbabali, omilede guoed,","poem":2},{"lineBreak":true},{"text":"degi, bela e-sorda-bila-onomaladi girgumaloed.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Damasco-e-neg-gandikmalad an ogumakoed,","poem":1},{"text":"Ben-Adad-negmar an obelogoed.”","poem":2}]},{"type":"heading","content":["Cedar-neggweburgi, Hazor-neggweburgi, iduakwaa-sunmaklesad"]},{"type":"verse","number":28,"content":["Cedar-neggwebur, degi, Hazor-neggwebur, Babilonia-rey-Nabucodonosorʼse oitolesgusad. Emide, Bab-Jehová weyob we-neggweburmar-annik soged:",{"text":"“¡Dakebinne! Cedarʼgi be gwichigumar.","poem":1},{"text":"Be dad-nakwe-dorgan-obelomar.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"E-ibe e-dordonegmar, e-molimar, ei sulegoed.","poem":1},{"text":"E-ibe e-atued-dummagan seledoed,","poem":2},{"lineBreak":true},{"text":"degi, e-ibmar-nuegan, e-moli-yargan-muremalad seledoed.","poem":2},{"text":"Dulemar ega weyob oimakdemaloed:","poem":1},{"text":"‘Bela aineba neg-dobegwale itoleged.’ ”","poem":2}]},{"type":"verse","number":30,"content":["Bab-Jehová soged:",{"text":"“Hazor-dulemar, gwae be abarmakdemar,","poem":1},{"text":"be gwae wakinmar, yaa-ollogan-matusur-bukmaladba be dukunamar.","poem":2},{"text":"Babilonia-rey-Nabucodonosor bemarbina igar aminaid,","poem":1},{"text":"bemarbina igar amisgunaid.”","poem":2}]},{"type":"verse","number":31,"content":["Bab-Jehová soged:",{"text":"“Dakebinne, we-neggwebur-san-dummarba-itogedgi be gwichigunamar,","poem":1},{"text":"amar na dukin bensuli gudidimalad.","poem":2},{"text":"We-dulemar dobe itosulid, baisur itomalad,","poem":1},{"text":"bannabaa bachikii mamaimalad,","poem":2},{"lineBreak":true},{"text":"amargi be gwichigunamar.”","poem":2}]},{"type":"verse","number":32,"content":["Bab-Jehová soged:",{"text":"“E-moli-yargan-muremalad ei be sumalo,","poem":1},{"text":"bela e-moli-bebe-nikamalad ei be sumalo.","poem":2},{"text":"E-dulemar an yogasaar oaisakioed,","poem":1},{"text":"napa-neg-bergunaidse an barmidoed,","poem":2},{"lineBreak":true},{"text":"amba bia gudimalale, bonigan an egi barmidoed.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Hazor-neggwebur, achu-sapur-uaya-gannagan-negga guoed,","poem":1},{"text":"degisadegu olloo neg naguoed.","poem":2},{"text":"Dule-wargwensaale, egi gudii guosulid,","poem":1},{"text":"gwen dule egi bukwa guosurbalid.”","poem":2}]},{"type":"heading","content":["Elam-dulemargi-iduakwaa-sunmaklesad"]},{"type":"verse","number":34,"content":["Judá-e-rey-Sedequías gebe reyga megidedgine, Bab-Jehová, e-gayaburba-barsoged-Jeremíasʼga Elam-dulemargi sunmaknonikid."]},{"type":"verse","number":35,"content":["Ega weyob sognonikid: Bab-Jehová-Bela-Gangued-Nikadi soged:",{"text":"“Elam-e-warsi an bibisgoed,","poem":1},{"text":"e-gangued-sunsogedi, an ei obelogoed.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Burwa-dummagan an egi barmidoed,","poem":1},{"text":"bela-napaneg-ebilis an egi burwa sedoed.","poem":2},{"lineBreak":true},{"text":"Napaneg-ugakaase an oaisakioed.","poem":2},{"text":"Elam-dulemar bela neggwebur-ugakaase ambikuoed,","poem":1},{"text":"bela neggweburmargi ambikuoedbiid.”","poem":2}]},{"type":"verse","number":37,"content":["Bab-Jehová soged:",{"text":"“Elam-dulemar, e-isdarmalad-abin gwayega an imakoed,","poem":1},{"text":"dule-e-oburgwebigudimalad-abin dobguega an saoed.","poem":2},{"text":"An-sae-itogedi an egi oyogoed,","poem":1},{"text":"boni-dummagan an egi barmidoed.","poem":2},{"text":"Bila-onoleged an egi barmidoed,","poem":1},{"text":"bela obelogedse an imakoed.”","poem":2}]},{"type":"verse","number":38,"content":["Bab-Jehová soged:",{"text":"“Elamʼgi an-ologana an sioed.","poem":1},{"text":"Elam-e-rey an obelogoed,","poem":2},{"lineBreak":true},{"text":"e-dummagana an obelobaloed.”","poem":2}]},{"type":"verse","number":39,"content":["Bab-Jehová soged:",{"text":"“Ibagan nonikoed,","poem":1},{"text":"Elam-dulemar-gales-selesmaladi, gannar an sedagoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JER/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JER/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JER/48.json","previousChapterAudioLinks":{},"numberOfVerses":39}