{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JER","translationId":"cuk_nvs","name":"Jeremías","commonName":"Jeremías","title":"JEREMÍAS-GARDA JEREMÍAS","order":24,"numberOfChapters":52,"sha256":"75584cc634e682f16d689c79332a191baf65045db96e9e927452315ef9b2d123","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cuk_nvs/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":5,"content":[{"type":"heading","content":["Jerusalén-dulemar-isgusad, Judá-dulemar-isgusad"]},{"type":"verse","number":1,"content":["Bab-Dummad soged:",{"text":"“Jerusalén-galimbaba be bipirmaknamar,","poem":1},{"text":"nue be miamakmalo.","poem":2},{"text":"Dulemar-ambikuedgi nue be dulemar amimalo.","poem":1},{"text":"Bemar dule-ibmar-inniki-imaked,","poem":2},{"text":"dule-ibmar-napira-soged amismalale,","poem":1},{"text":"an, Jerusalén-neggwebur bar an sabsur-imakosulid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ar dulemar sogdamalanad: ‘Bab-Jehová-nuggi an napira sogye,’","poem":1},{"text":"degi-inigwele, yamo sogdamalad.”","poem":2}]},{"type":"verse","number":3,"content":["Ani Jeremías sogded:",{"text":"“Bab-Dummadga an weyob sogded:","poem":1},{"text":"Bab-Jehová, ¿ar be dule-innikidamalad amisursi? Eye, be amienad.","poem":2},{"text":"Ar dulemar be sabsur-odurdaksa-inigwele, degite, gwen bai-itossurmalad.","poem":1},{"text":"Be we-dulemar-e-ibmarmar-obelos-inigwele, gwen gwage-nuguedgi binsasurmalad.","poem":2},{"text":"Akwaba bur bule e-gwage dutusuli nadmalad,","poem":1},{"text":"gwen e-isguedga bukib itossurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"”An weyob binsaenad:","poem":1},{"text":"‘Unnila dule-wilemaladbi, binsaedsuli ibmar imakye.","poem":2},{"text":"Be-Igar-Maid gwen magar itosurmarye.","poem":1},{"text":"Be-ibmar-abemaid gwen imaksurmarbarye.’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Agala, sapin-dummaganse an naoed,","poem":1},{"text":"an ega sunmaknaoed.","poem":2},{"text":"Ar we-dulemardi, Be-Igar-Maid wismalad,","poem":1},{"text":"be-ibmar-abemaidi, wismarbalid.","poem":2},{"lineBreak":true},{"text":"”Degi-inigwele, amba be-sogedba ibmar-imaksasurmarmogad,","poem":1},{"text":"Be-Igar-Maidgi annasmarmogad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"A-ulale, achumigur-nono-wawaadse gullemaloed,","poem":1},{"text":"achu-burburud-nega-dulesulidganbalidse ichimaklegoed.","poem":2},{"text":"Achu-barbad e-neggwebur-ebiris bina itos gudiid.","poem":1},{"text":"Bela dulemala neggweburgi-nodmalale, ese ibitolegoed.","poem":2},{"text":"Ar we-dulemar dogdar begi yolesmalad,","poem":1},{"text":"ar we-dulemar dogdar begi uayasuli gusmalad.”","poem":2}]},{"type":"verse","number":7,"content":["Bab-Dummad sogded:",{"text":"“¿Ibiga isgussulidyob an bemar-dakosunna?","poem":1},{"text":"Ar be-mimmigan an-obachamalad,","poem":2},{"text":"bab-dummagansurmalad-nuggi ise-sogar sogdamalad.","poem":1},{"text":"An bemarga mas unnitiba uksad,","poem":2},{"text":"degite, bemar galagwensuli gudmalad.","poem":1},{"text":"Bela bemar danagwen galagwensuli gambanuchumarba be gudii gusmalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Moli omegi-nakwebigudiyobi, be gudimalad.","poem":1},{"text":"Dule-baigan-omeganbina be yaisur-gordii damalad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ani an Bab-Jehová bemarga soged:","poem":1},{"text":"A-ular, ¿an bemar-sabsur-odurdakosur be insae?","poem":2},{"text":"¿Buged-mai an bemar-imakosurde?","poem":1},{"text":"An bemar-odurdakergebed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Israel-dulemar-e-uvaʼdub-digarmaladba be dagmar,","poem":1},{"text":"maad-maad be imakdamar,","poem":2},{"lineBreak":true},{"text":"degi-inigwele, mer bela be obelomalo.","poem":2},{"text":"E-muumar be ungemalo,","poem":1},{"text":"ar we-muumar bar angadsulid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ani an Bab-Jehová soged:","poem":1},{"text":"Israel-dulemar, Judá-dulemar, uayasuli angi gudmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"”Bemar an-obachamalad,","poem":1},{"text":"‘Bab-Dummad maisurye’ be sogmalad.","poem":2},{"text":"‘Bilagi anmar odurdaklegosurye’ be sogdamalad.","poem":1},{"text":"‘Ukumesedgi anmar odurdaklegosurye’ be sogmarbalid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"‘Bab-Dummad-gayaburba-barsogmaladdi, binsa-ee-gordimarye’ be sogmarbalid,","poem":1},{"text":"‘ar Bab-Jehová-gayaburba egi naisurye’ be sogmalad.","poem":2},{"text":"‘Bab-Dummad-gayaburba-barsogmalad deyob-sunmaksamaladba sabsur-odurdaklemarsunye,’ be sogmalad.”","poem":1}]},{"type":"verse","number":14,"content":["Degisoggu, ani an Bab-Dummad-Jehová-Bela-Gangued-Nikad bega soged:",{"text":"“Weyobi, dulemar sogsamarsoggu, Jeremías, an-gayaburba be-gayagi sooyobi guoed.","poem":1},{"text":"We-dulemardi, sapanyobi gumaloed, bela bergumaloed.”","poem":2}]},{"type":"verse","number":15,"content":["Ani an Bab-Jehová bemarga soged:",{"text":"“Israel-dulemar, dule-dikasurmalad an bemarse barmidagoed.","poem":1},{"text":"Neggwebur-gandikmalad, undargus-bukwamalad an bemargi barmidagoed.","poem":2},{"text":"Dule gaya-akarsaila-sunmakmalad,","poem":1},{"text":"e-gaya-be-aku-itomalad an bemarse barmidagoed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bela we-dulemala bila-onogedgi buleganad,","poem":1},{"text":"e-sigumala, dule-ogilogednanaed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Be-ibmar-wesmalad bei obelomaloed,","poem":1},{"text":"be-masgullemalad bei obelomarbaloed.","poem":2},{"text":"Be-masmala, be-bunamala, bei oburgwemarbaloed.","poem":1},{"text":"Degine, be-sibadmar, be-moli-bebe-nikamalad, bei ogilomarbaloed.","poem":2},{"text":"Deginbali, be-uvaʼmar, be-higuera-sapimar, bei obelomarbaloed.","poem":1},{"text":"Be-neggwebur-gandikmaladgi, dule-oakalogosurye-egi-be-binsaedi,","poem":2},{"lineBreak":true},{"text":"bela es-suidgi bei obelolebaloed.”","poem":2}]},{"type":"verse","number":18,"content":["Ani an Bab-Jehová soged: “A-ibagangine, an belallaa dulemar-obelogosulid."]},{"type":"verse","number":19,"content":["Dule bese egichiarmalale, ‘¿ibiga anmar-Bab-Dummad-Jehová weyob anmar-imaksaye?’ Jeremías, ega be sogo: ‘Bab-Dummad sogye: Ar igi-bemar an-obachamala, degine, be-neggweburgi bab-dummad-baiganba be ibsadii gusmala, deyobi, neggwebur-baidgi, dule-baiganga-arbadii be gumaloye.’"]},{"type":"verse","number":20,"content":[{"text":"Jacob-waganga be soge,","poem":1},{"text":"Judá-dulemarga be sunmake:","poem":2}]},{"type":"verse","number":21,"content":[{"text":"‘Dule-binsaed-satemalad, dule-aku-neg-itomalad, be itomala.","poem":1},{"text":"Ar bemar ibya-nika-inigwele, be aku-ibmar-dakmalad.","poem":2},{"lineBreak":true},{"text":"Ar bemar uaya-nai-inigwele, be aku-ibmar-itomalad.’ ”","poem":2}]},{"type":"verse","number":22,"content":["Ani an Bab-Jehová soged:",{"text":"“Ar bemar, ¿bar an-dobsurmarde?","poem":1},{"text":"Ar bemar, an-dobguewilubmalanad.","poem":2},{"lineBreak":true},{"text":"Ani an ukub nasiksad, adi, demar-abingunaidga guegar.","poem":2},{"text":"Demar-abingunanaid degisadegu-mai guoed, gwen berguosulid.","poem":1},{"text":"Amba demar binnasur-arwedago-inigwele, degine, uurmakdago-inigwele, e-igar-abingunanaidgi gwen dogosulid.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ar we-dulemar gwage-dutusurmaladid, uayasuli angi damaladid.","poem":1},{"text":"Angi bangus gudimalad, angi aibatemalad.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Wis binsasurmalad, na sogsurmalad:","poem":1},{"text":"‘Anmar, anmar-Bab-Dummad-Jehová dobee nanamarye.","poem":2},{"text":"Anmarga dii-owimaiye, ibagan-sekalaa dii barmimaiye.","poem":1},{"text":"Degine, anmarga ibmar-weed-ibagan sekalaa nasikmaiddeeye,’ gwen binsasurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"”Be-isgumaladi, bemargi we-ibmar-nuegan obelosad.","poem":1},{"text":"Be-isgumaladi, bei ibmar-nuegan gasa siid.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"An bensuli, ar bemar-abargi dule-ibmar-isgana-imakmalad gudidiid,","poem":1},{"text":"nuu-gaega-nakulemaladyob nakuledimalad,","poem":2},{"lineBreak":true},{"text":"dule-gaega yamo emar-yardakmalad gudidiid.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Sikwimar garbagi-ena-bukwadyobi, e-negmargi ibmar-atursasmaladi, ena-ena bubukwad.","poem":1},{"text":"A-ulale, bemar dule-buleganga gudmalad,","poem":2},{"lineBreak":true},{"text":"deyob, dule-mani-ibmalaga gudmalad.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Be wardungudmalad, san-dummarbaa be gudmalad.","poem":1},{"text":"Bemar-ibmar-isgana-imakmaladi gege bergued.","poem":2},{"text":"Dule-babgan-satemalad nabir-nued-gudigumalaga ega be igar nabosurmalad.","poem":1},{"text":"Dule-wilegana-e-ibmar-nikue-wilubmogad be bendaksurmarbalid.”","poem":2}]},{"type":"verse","number":29,"content":["Ani an Bab-Jehová soged:",{"text":"“¿We-ulale, sabsur-bemar-odurdakosur be an-insae?","poem":1},{"text":"Weyob-dule-damaladi, buged-mai ¿imakosur be an-insae? An imakoe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"”Be dakmala we-napneggi, gwayed-dummad naid.","poem":1},{"text":"¡We-ibmar-gunaid gwen nabir-daklesulid!","poem":2}]},{"type":"verse","number":31,"content":[{"text":"An-gayaburba-barsogmalad, unnila gakansaale sunmakmalad.","poem":1},{"text":"Dule-irwa-anse-gormalad, na e-itolegedba negsemamaid.","poem":2},{"text":"An-dulamarde, weyob-abeye soged.","poem":1},{"text":"Ar bela ibmar bergunonikile, ¿bemar igi-gudmalosunna?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JER/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JER/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JER/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}