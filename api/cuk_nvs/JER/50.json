{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JER","translationId":"cuk_nvs","name":"Jeremías","commonName":"Jeremías","title":"JEREMÍAS-GARDA JEREMÍAS","order":24,"numberOfChapters":52,"sha256":"75584cc634e682f16d689c79332a191baf65045db96e9e927452315ef9b2d123","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cuk_nvs/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":50,"content":[{"type":"heading","content":["Babilonia-dulemargi-iduakwaa-sunmaklesad"]},{"type":"verse","number":1,"content":["Bab-Jehová weyob e-gayaburba-barsoged-Jeremíasʼga Babilonia-yar-Caldea-dulemar-neggwebur-annik soged:"]},{"type":"verse","number":2,"content":[{"text":"“Dulemar be owisogo,","poem":1},{"text":"dulemar bela-wisguega be imako.","poem":2},{"text":"Dulemar-owisoged-bander be onako,","poem":1},{"text":"melle be soggwenad odukuo.","poem":2},{"text":"Weyob be sogo:","poem":1},{"text":"‘¡Babilonia-yala sulegoed!","poem":2},{"text":"¡Bab-dummad-Bel nue-bingedar itogoed!","poem":1},{"text":"¡Bab-dummad-Merodac nue-gwakidoed!","poem":2},{"text":"E-wilubgan-sobarmaladi, bingedar itomaloed,","poem":1},{"text":"e-babyob-imaklemaladi, bela wawanmakdoed.’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dad-nakwed-argan-sapiledsik-bukmaladi egi gwichiguoed,","poem":1},{"text":"bela ollobi e-yala nasikoed.","poem":2},{"text":"Dulemar, degi, ibmar-durganmar duurmakdemaloed,","poem":1},{"text":"dulemar agi bar ambikuosulid.”","poem":2}]},{"type":"verse","number":4,"content":["Bab-Jehová soged:",{"text":"“A-ibagangine, Israel-dulemar, Judá-dulemar, ise-boale, an-e-Bab-Dummad-guedgi anse abarmakdanimaloed.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Ansega egisdanimaloed,","poem":2},{"text":"bia Siónʼse-naed-igar maiye.","poem":1},{"text":"Ar a-igarbali nadapi gumaloed.","poem":2},{"text":"Siónʼse modapile, anbo igar degisadegu omesmaloed,","poem":1},{"text":"a-igar bar iegosurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"”An-dulamar sibad-wawaad-yoggus-gudiiyobi gusmalad.","poem":1},{"text":"E-edarbemaladi yogasaar-sesmalayob gusmalad,","poem":2},{"text":"igar-oes sapurba-gudiiyobi imaksamalad.","poem":1},{"text":"Yala-mulluganba-bipirmakdiiyobi gusmalad,","poem":2},{"lineBreak":true},{"text":"e-galu-ies-gudimalayobi wilesmalad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"E-isdarmalad dakarmalale, obelodamalad,","poem":1},{"text":"e-isdarmaladi sokardamalad:","poem":2},{"text":"‘Anmargi sisuli.","poem":1},{"text":"Ar wemar Bab-Jehováʼgi isgusmalad.","poem":2},{"text":"Bab-Dummad ega ibmar ukmainad,","poem":1},{"text":"e-dadgan we-Bab-Jehováʼgi ibmar-abdakdii gusmaladinad.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”Mimmigan, Babiloniaʼgi-gudimalad be ainimar,","poem":1},{"text":"we-yalagi be wakinmar.","poem":2},{"text":"Sibad-machered, sibad-wawaad-idunadapdaeyobi,","poem":1},{"text":"be dulemar-idumar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ar ani an, Babilonia-idu, dad-nakwed-argan-sapiledsik, neggwebur-dummagan-bukwad gilamaknaid.","poem":1},{"text":"Babilonia-yalabina guakwaa bukumaloed,","poem":2},{"text":"dad-nakwed-argan-sapiled-akale, Babilonia-yalagi gwichigumaloed.","poem":1},{"text":"E-sigumala, sunsogmaladid,","poem":2},{"lineBreak":true},{"text":"sigu-miledele, nosaa maksurmaladid.”","poem":2}]},{"type":"verse","number":10,"content":["Bab-Jehová soged:",{"text":"“Babilonia-ibe bela ibmarmar welegoed,","poem":1},{"text":"dulemar-ibmar-weemaloedi na yeer itomaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”Bemar, Babilonia-dulemar, an-dulamar-ibe-ibmar-atursamalad,","poem":1},{"text":"be weligwar itomar, be wergumar.","poem":2},{"text":"Moli-bebe-nikad-sapingwagwadyobi, gagan-ara-aramalad-birgi be gwirmar,","poem":1},{"text":"molimar-goleyobi be gormar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ar bemar-yala, bela mesagwar guoed,","poem":1},{"text":"egi be gwalulesmaladi, nue bingedar itogoed.","poem":2},{"text":"Bemar-yala napa-negadulesulidga naguoed,","poem":1},{"text":"nega-dinnaregedga, degi, bela napabi-nai guoed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"An-urwed-ulale, bemar bar-ambikuosulid,","poem":1},{"text":"bela swanga naguoed.","poem":2},{"text":"Dulemar Babilonia-yalagi-nasmalale, geger dakdamaloed,","poem":1},{"text":"nue-oitolesnai dakdamaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"”Bemar-sigugi-urwemalad, guagwar be Babilonia-dikarba ambikumar.","poem":1},{"text":"Egi be sigu mimar,","poem":2},{"text":"melle be sigu sabomalo,","poem":1},{"text":"ar we-dulemar angi dummad-isgusmalad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Binnasuli be Babilonia-dikarba gormakmar,","poem":1},{"text":"weyob be sogmar:","poem":2},{"text":"‘¡Babilonia-sordamar galakude!","poem":1},{"text":"¡E-neg-suigan marwide!","poem":2},{"text":"¡E-galu-matusulid-akwabimalad ayaride!’","poem":1},{"text":"We-ibmar-gunaidi Bab-Jehová buged imaknaid.","poem":2},{"text":"Igi Babilonia-dulemar bemar-imaksa, deyobi bemar Babilonia-dulemar imakmogo.","poem":1},{"text":"Bemar-wiosayobi be wiomarmogo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Babiloniaʼgi ibmar-digmalad be obelomar,","poem":1},{"text":"degi, Babiloniaʼgi ibmar-gwag-wemalad be osulomar.","poem":2},{"text":"Dulemar, bila-onolenaid dakdamalogu,","poem":1},{"text":"Babiloniaʼginsurmaladi e-yalase gannar namaloed,","poem":2},{"lineBreak":true},{"text":"e-neggweburse wakitemaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"”Israel-dulemar sibad-wawaad-yoggus-gudimalayob gued,","poem":1},{"text":"achumigur-nono-wawaadse balegilledimaladyob gumalad.","poem":2},{"text":"Gebegine, Israel-dulemar Asiria-reyse dolesad,","poem":1},{"text":"geb sorba, Babilonia-rey-Nabucodonosorʼse bela e-garmar bibichilesad.”","poem":2}]},{"type":"verse","number":18,"content":["A-ulale, Israel-dulemar-e-Bab-Dummad-Jehová Bela-Gangued-Nikadi weyob soged:",{"text":"“An Babilonia-rey sabsur-odurdakoed,","poem":1},{"text":"degi, an e-yala sabsur-wiobaloed,","poem":2},{"text":"igi an Asiria-rey sabsur-odurdaksa,","poem":1},{"text":"deyobi, an imakmogoed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"An Israel-dulemar gannar e-yalase-naega imakoed,","poem":1},{"text":"Carmelo-yalagi, Basán-yalagi nue mas-gunbukwa an imakoed.","poem":2},{"lineBreak":true},{"text":"Degine, Efraín-yalagi, Galaad-yalagi nue-immelebukwa an imakoed.”","poem":2}]},{"type":"verse","number":20,"content":["Bab-Jehová soged:",{"text":"“A-ibagangine, Israel-dulemar-e-isguedi amilegoenad,","poem":1},{"text":"degi-inigwele, amilegosulid.","poem":2},{"text":"A-ibagangine, Judá-dulemar-e-isguedi amilegoenad,","poem":1},{"text":"degi-inigwele, amilegosulid.","poem":2},{"lineBreak":true},{"text":"Ar ani an bemaloedga isgued elioed.”","poem":2}]},{"type":"verse","number":21,"content":["Bab-Jehová soged:",{"text":"“Merataim-yalagi be gwichigunamar,","poem":1},{"text":"degi, Pecod-dorgangi be gwichigunamar.","poem":2},{"text":"¡Ogilomalo, bela naitinagase be obelomalo!","poem":1},{"text":"An bega igar-uksadba be imakmalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"”Neggweburgine bila-onolegega binnasuli-oimake itoleged,","poem":1},{"text":"nue-dummad wilemaloed.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Babilonia-yala, be mardoyobi, dulemar-sabsur-imakedinad,","poem":1},{"text":"emigindi, be yarmar-bamalad-imbagi olloo mellesiid.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bee be, yamoleged-galu sisad, agine na be dukin galesad.","poem":1},{"text":"Galesadi gwen be itossulid,","poem":2},{"lineBreak":true},{"text":"ukiagwale be galesad.","poem":2},{"text":"Babilonia, ar be angi-gwisgusadba be daklenonikid,","poem":1},{"text":"degidbali, be galesad.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"An-gingi-sabolebukwad an egasad, an-sae-itoged-gingimar an onisad.","poem":1},{"text":"Ani an Bab-Jehová-bur-dutusulidi, Bela-Gangued-Nika-Maidi, Babilonia-yalagi igar-soggwen an imakergebed.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Napneg-ugakagi-bukmalad, Babilonia-yalagi be gwichigumar.","poem":1},{"text":"E-ibmar-gwag-sabolebukwad ei be egamar,","poem":2},{"lineBreak":true},{"text":"ibmar-gwag-weemaloedi, danar-danar be oambikumalo.","poem":2},{"text":"Bela nagase be obelomalo.","poem":1},{"text":"¡Melle ibmar be obemalo!","poem":2}]},{"type":"verse","number":27,"content":[{"text":"E-moli-bebe-nikad-sapingana bela be oburgwemar.","poem":1},{"text":"Oburgwileged-negse be sedmar.","poem":2},{"lineBreak":true},{"text":"Babilonia-dulemar, duledar-wilesmalad, sabsur-odurdakleged-iba ega nonikid.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Dulemar-duurmakmaid-e-sunmakedi be itomar.","poem":1},{"text":"Babiloniaʼgi-wakinmamaid-e-sunmakedi be itomar:","poem":2},{"text":"‘Bab-Jehová, ese-goled-neg-earismalad-ular, Babilonia-yar buged-imaknaiye,’","poem":1},{"text":"Sión-yalase sogdanimalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"”Be Babilonia-sordamar-idu sigugi-urwemalad danar oambikumar,","poem":1},{"text":"dulemar-warsi-yaa-saemaladi bela be urbemar.","poem":2},{"text":"Babilonia-ebilis be ambikumar,","poem":1},{"text":"melle dulemar-wakinnega be samalo.","poem":2},{"text":"E-ibmar-imaksamaladba be sabsur-imakmarmogo,","poem":1},{"text":"dulemar-wiosmaladba be wiomarmogo.","poem":2},{"lineBreak":true},{"text":"Ar we-dulemarde Israel-dulemar-e-Bab-Jehová-Gwage-Isligwaledgi gwichigusmalad.”","poem":2}]},{"type":"verse","number":30,"content":["Bab-Jehová soged:",{"text":"“A-ulale, a-ibagangine, e-sapingana neg-imbaba omiledoed,","poem":1},{"text":"degi, bela e-sorda-bila-onomaladi, girgumaloed.”","poem":2}]},{"type":"verse","number":31,"content":["Bab-Jehová-Bela-Gangued-Nikad soged:",{"text":"“San-dummarba-imakmalad-yala, an begi gwichiguoed.","poem":1},{"text":"Emide, sabsur-odurdakleged-ibagan bega nagunonikid.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"San-dummarba-imakedi, gowarmakdoed, aimukudoed,","poem":1},{"text":"dule e-ogwisega bendakosulid.","poem":2},{"text":"Bela e-neggweburmargi an soo ogaoed,","poem":1},{"text":"bela e-neggwebur an soogi ogumakoed.”","poem":2}]},{"type":"verse","number":33,"content":["Bab-Jehová-Bela-Gangued-Nikadi, weyob soged:",{"text":"“Israel-dulemar, Judá-dulemar, mesagwar gudidimalad.","poem":1},{"text":"E-isdarmaladi gasa bukwad, gwen onobisurmalad.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ar dule-e-bendakeddi, dule-dutusulidid,","poem":1},{"text":"ani an Bab-Jehová-Bela-Gangued-Nikadye nugad.","poem":2},{"text":"Gandikidgi an bendakoed,","poem":1},{"text":"nega-bogidikid an ega nasikoed.","poem":2},{"lineBreak":true},{"text":"Babilonia-yalagindina, an dobed-dummad nasikoed.”","poem":2}]},{"type":"verse","number":35,"content":["Bab-Jehová soged:",{"text":"“Babilonia-dulemar oburgwilegoed,","poem":1},{"text":"e-dummagan, degi, e-dule-binsaed-ibegan, ogilolegoed.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ega-gayaburba-gakansaar-barsogmaladi, oburgwilegoed,","poem":1},{"text":"amar binsaedsulidga naddamalad.","poem":2},{"lineBreak":true},{"text":"E-sorda-bila-onomaladi nue-dobe-itomaladi ogilolegoed.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"E-molimar, oburgwilegoed,","poem":1},{"text":"e-ur-napaginmaladi, osulolegoed.","poem":2},{"text":"Sorda-bila-onomalad-ainebarmalad-bennuklegarmaladi, bela girgumaloed.","poem":1},{"text":"Omeganyob dobgudmaloed.","poem":2},{"text":"E-ibmar-nuegana obelolegoed,","poem":1},{"text":"e-ibe atursalegoed.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"E-diimar dinguoed,","poem":1},{"text":"bela dinna guoed.","poem":2},{"text":"Ar Babilonia-yala bab-dummadyob-imaklemalad-yalad,","poem":1},{"text":"amala, suli-suli dule-imakmaladid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"”A-ulale, nega-dulesulidganba ibdurgan-ursirmaladi, achu-sapurmarbo gudii gumaloed.","poem":1},{"text":"Agine nuu-dummad-dukar-suidmar gudii gumarmogoed.","poem":2},{"text":"Dulemardi Babiloniaʼgi bar-bukwa guosulid,","poem":1},{"text":"degisadegu, olloo nai guoed.”","poem":2}]},{"type":"verse","number":40,"content":["Bab-Jehová soged:",{"text":"“An Sodoma-neggwebur-imaksayobi,","poem":1},{"text":"Gomorra-neggwebur-imaksayobi,","poem":2},{"text":"degine, amar-dikarbali neggweburmar-bukwad-wiosayobi,","poem":1},{"text":"an Babilonia-yala imakoed.","poem":2},{"text":"Bar agine dulemar bukwa guosulid,","poem":1},{"text":"agine bipisaale dulemar bar megosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"”Dad-nakwed-argan-sapiledsiki, sorda-bila-onomalad danikid,","poem":1},{"text":"napneg-ugaka-akale, bela neggwebur-dummagan-bukwad,","poem":2},{"lineBreak":true},{"text":"degine, reymar-bukidar danikid.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Sigumar-annik-annik danimalad,","poem":1},{"text":"eswar-swiswidikmalad annik-annik danimalad.","poem":2},{"text":"Dule-ursirmalad nanaed,","poem":1},{"text":"wile-dule-daksurmaladid.","poem":2},{"text":"Moligi-sii danimalad.","poem":1},{"text":"E-uurmakedi, demar-uurmakmaidyobi gordanikid.","poem":2},{"text":"Babilonia-yeerdakleged, we-dulemar bebina danimalad,","poem":1},{"text":"we-dulemar begi gwichigudanimalad,","poem":2},{"text":"bila-onoledanikiyob ilemakar danimalad,","poem":1},{"text":"dule-wargwenadyob ilemakar danimalad.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Babilonia-rey, dulemar-egi-bila-onodanikid wisgusad,","poem":1},{"text":"deyob-itosgua, dobedbali wawanmakded,","poem":2},{"text":"na egine suli-suli-itoged nagusad,","poem":1},{"text":"ome-e-boniganba-galitonaidaeyobi, itoalid.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Achumigur Jordán-diwar-bulaganba, gagan-nuegan-naidse danidaeyobi,","poem":1},{"text":"ukiagwale an Babilonia-dulemargi gwichigudagoed.","poem":2},{"text":"Babilonia-dulemargi an dule-susadi an onugsaoed.","poem":1},{"text":"¿Ar doa anyobsunna?","poem":2},{"text":"¿Doa angi obinosunna?","poem":1},{"text":"¿Biti-sibad-edarbed angi gwisguosunna? Dule angi obinosuli.”","poem":2}]},{"type":"verse","number":45,"content":["Ani Jeremías soged:",{"text":"“Bab-Jehová Babilonia-dulemarga-igar-mesisad, be itomar.","poem":1},{"text":"Babilonia-dulemarga igar-mesilesad, be itomar:","poem":2},{"text":"‘Emar-imbagi sapingan-senigana ebipiledmaloed,","poem":1},{"text":"e-gagan-nanaidi, swanga naguoed.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Babilonia-neggwebur-berguoedi neg-ogiglimakoed,","poem":1},{"text":"e-gollomakoedi neggwebur-baiganse itolegoed.’ ”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JER/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JER/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JER/49.json","previousChapterAudioLinks":{},"numberOfVerses":46}