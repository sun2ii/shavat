{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JER","translationId":"cuk_nvs","name":"Jeremías","commonName":"Jeremías","title":"JEREMÍAS-GARDA JEREMÍAS","order":24,"numberOfChapters":52,"sha256":"75584cc634e682f16d689c79332a191baf65045db96e9e927452315ef9b2d123","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cuk_nvs/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":51,"content":[{"type":"heading","content":["Babilonia-dulemar sabsur-odurdaklegoed"]},{"type":"verse","number":1,"content":["Weyob Bab-Jehová soged:",{"text":"“Babilonia-yalagi dule-obeloged-burwa an ogoloed,","poem":1},{"text":"Caldea-dulemar-angi-yoledimaladgi an burwa barmidoed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dulemar oros-uka-milegedyob-dulemar-imakedi, Babilonia-dulemargi an barmidagoed.","poem":1},{"text":"Adi, Babilonia-dulemar bela sate imakegar.","poem":2},{"lineBreak":true},{"text":"E-sabsur-odurdaklegoed-ibagi, igar-baid-baidsik egi ainidamaloed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dule-sigumiedi, melle warsi-yaa-imakega be imakmalo,","poem":1},{"text":"degi, melle esgoro-mor-yoega be samalo.","poem":2},{"text":"Melle e-sapingana wile be dakmalo,","poem":1},{"text":"bela naitinagase e-sorda-bila-onomalad be obelomalo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Babilonia-yalagi burgwar omiledmaloed,","poem":1},{"text":"neg-galimbabali e-muimar omiledoed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Israel-dulemar, degi, Judá-dulemala, angi-isgusmar-inigwele, we-yalagi isgued-omelosmar-inigwele,","poem":1},{"text":"degite, ani Bab-Jehová-Bela-Gangued-Nikadi, Israel-dulemar-e-Bab-Dummadi, gwen an egi bangussulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"”Babilonia-neggweburgi be wakinmar,","poem":1},{"text":"be wala-walagwengi san bendakmar,","poem":2},{"lineBreak":true},{"text":"melle Babilonia-isguedba be burgwemalo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Babilonia-dulemar an-argan-yaurgine, nog-gobed-orbiidyobi gued.","poem":1},{"text":"Bela napaneg-naid-omumsadiid.","poem":2},{"text":"Neggwebur-dummagana bela a-vino gobsamalad,","poem":1},{"text":"degidbali, neggweburmar suli-suli itodmalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Degi, ukiagwale, Babilonia-dulemar galakude gusmalad,","poem":1},{"text":"degine, bela oitoles gusad.","poem":2},{"lineBreak":true},{"text":"A-ulale, akigindemalad, ega be ina sedamala, nabir sunna nugualile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"” ‘Babilonia-dulemarga anmar ina-nued daksanad,","poem":1},{"text":"degi-inigwele, gwen nugussulid.","poem":2},{"text":"Anmar mete nasunna,","poem":1},{"text":"e-yala-yalase gannar namarsun.","poem":2},{"text":"Ar Babilonia-dulemar-e-isguedi bela nibnegse warmaknaid,","poem":1},{"text":"degi, bela mogirsega warmaknaid.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Israel-dulemar soged:","poem":1},{"text":"‘Bab-Jehová anmarga igar nudaksad.","poem":2},{"text":"Be dagmar,","poem":1},{"text":"Sión-yalagine, Bab-Jehová-ibmarmar-imaksadgi anmar sunmakoed.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”¡Sigumar be oswiswimakmar!","poem":1},{"text":"¡Sigu-abgamalad be nasikmar!","poem":2},{"text":"Bab-Jehová, Babilonia-dulemar-obelogega, Medo-dulemar-e-reymar ogannosad.","poem":1},{"text":"We-ibmar-guoedi, Bab-Jehová buged imakegalad,","poem":2},{"text":"ar Babilonia-dulemar ese-goled-neg-bibichismalad-ular,","poem":1},{"text":"deyob imakoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Babilonia-galu-matusulidgi-gwichiguega, bander be oyomar.","poem":1},{"text":"¡Sordamar be ogannomar!","poem":2},{"text":"¡Dule-nakulemalad be urbemar!","poem":1},{"text":"¡Dukued-galu be sobmar!","poem":2},{"text":"Bab-Jehová ibmar-imakbiedi imakoed,","poem":1},{"text":"Babilonia-dulemargi-ibmar-sogsadi, sogedba imakoed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bemar, Babilonia-dulemar, diwar-dummagan-nagaba be mamaimalad,","poem":1},{"text":"ibmar-nuegan-bukidar be nikamalad.","poem":2},{"text":"Emide, be-ibagan-bergued warmaknonikid,","poem":1},{"text":"be-gudigued wese gwinmaknonikid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bab-Jehová-Bela-Gangued-Nikad e-sunnad weyob ibmar-imakedse sogsad:","poem":1},{"text":"‘Ses-bukibayobi, an be-neggweburgine be-isdarmalad enogoed,","poem":2},{"lineBreak":true},{"text":"begine obinmaloedbali, binnasuli gormakdemaloed.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"”Bab-Jehová, e-ganguedgi, napneg nasiksad,","poem":1},{"text":"e-binsaed-nikadbali, napneg ilemaksad,","poem":2},{"lineBreak":true},{"text":"e-ibmar-wisidbali, nibneg obinnisad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bab-Dummad binnasur-sunmakedbali, nibneggi diimar-uurmakega imakdaed,","poem":1},{"text":"magatibali, mogir-ainakwega imakdaed.","poem":2},{"text":"Mala-ibyed-abalagi, dii-owiardaed,","poem":1},{"text":"burwa-galumargi, burwa-oniardaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"”Bela dulemar binsaedsulidamaladid, aku-neg-itomaladid.","poem":1},{"text":"Bela dulemar-orgi-arbamaladi, e-ibmar-sobedgi bingedar itomalad,","poem":2},{"text":"e-ibmar-sobarmaladi, dule-yardakmaladid,","poem":1},{"text":"gwen burba-dulad nikasulid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"We-ibmarmala, binsaledid, binsa egi dodolegedid,","poem":1},{"text":"e-sabsur-odurdakleged-iba-nonikile, bela obelolemaloed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Jacob-e-Bab-Dummaddi, we-ibmar-sobarmaladyobsulid.","poem":1},{"text":"Ar Jacob-e-Bab-Dummadi, bela ibmar-saedid,","poem":2},{"text":"Bab-Jehová-Bela-Gangued-Nikadye nugad.","poem":1},{"text":"A-Bab-Dummad Israel-dulemar, egadiga-guega na susad.”","poem":2}]},{"type":"verse","number":20,"content":["Bab-Jehová soged:",{"text":"“Babilonia, bemar anga mardoyobi gued,","poem":1},{"text":"be angala bila-onogedgi ibmar-ebulegedyob gued.","poem":2},{"text":"Bebali, an neggwebur-dummagan bibisged,","poem":1},{"text":"degi, dulemar-baid-baid-bukmaladi beba an obelobalid.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bebali, molimar, degi, sorda-moligi-sii-urwemaladi, an obelobalid.","poem":1},{"text":"Bebali, ur-napaginmalad-bila-onogedgi-ebulemaladi, degi, e-onanamaladi, an obelobalid.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Degi, bebali, machergana, omeganse-bakale, an osulobalid.","poem":1},{"text":"Bebali, sergana, sapingana an obelobalid.","poem":2},{"lineBreak":true},{"text":"An bebali, masmala, yagana, obelobalid.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bebali, sibad-edarbemaladi, degi, e-sibad-wawaadmar an osulobalid.","poem":1},{"text":"Bebali, sapurba-arbamaladi, e-moli-bebe-nikamalad-abin-abinnid-napa-imumaladse-bakale, an obelobalid.","poem":2},{"text":"De-ukinbali, dummagan-negsemamaid,","poem":1},{"text":"degine, dummadga-arbamaladi, bebali an obelobalid.”","poem":2}]},{"type":"verse","number":24,"content":["Bab-Jehová soged: “Babilonia-dulemar Sión-yalagi-ibmar-imaksadba, bemar-wagab an Babilonia-buged-imakoed, bela e-dulemar an buged-imakoed.”"]},{"type":"verse","number":25,"content":["Bab-Jehová soged:",{"text":"“Babilonia, an begi-gwichid,","poem":1},{"text":"be emar-obeloged-yalad, bela be napa-obelogedid.","poem":2},{"text":"Begine an-surgan an oyodoed,","poem":1},{"text":"akwasaila-akale an be-balimetoed,","poem":2},{"lineBreak":true},{"text":"degi, yala-gummakaledga an be-imakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"”Ani Bab-Jehová soged:","poem":1},{"text":"Be-akwamar, neg-sobega suosurmalad.","poem":2},{"text":"Be-akwamar negsailaga-sigega bei suosurmalad.","poem":1},{"text":"Ar bela be-yala ollobi naguoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"”Neggweburgi bander be onakmar.","poem":1},{"text":"Dulemar-imbagi gar-trompeta be ogormar.","poem":2},{"text":"Babilonia-sordamargi-gwichiguega, Ararat-sordamar be urbemar.","poem":1},{"text":"Mini-sordamar, degine, Askenaz-sordamar be urbemar.","poem":2},{"text":"Bila-onolegedgi sorda-idued-dummad-dule-idugega be amimar.","poem":1},{"text":"Sesmar-duurmakmaiyobi, molimar egi duurmakmai be imakmar.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Babilonia-neggweburgi-gwisguega, neggweburmar guagwar be urbemar.","poem":1},{"text":"Babilonia-sordamargi-gwisguega, Media-yar-e-reymarse be gormar.","poem":2},{"text":"Degine, Media-e-dummagan, Media-e-negsemamaid be onmakmar,","poem":1},{"text":"degi, Babilonia-neggweburgi gwisguega bela yalamarse be gormar.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Napa wawanmaknaid,","poem":1},{"text":"bela giglimaknaid.","poem":2},{"text":"Bab-Dummadi, Babilonia-dulemargi-ibmar-sogsad imaknaid,","poem":1},{"text":"Babilonia-yala nega-dulesulidga, degi, dulemar bar egi bukuosulidga imaknaid.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Babilonia-sorda-bila-onomaladi, bila-onoged boggusmalad.","poem":1},{"text":"Neg-gandikmaladba dukus bukusmalad.","poem":2},{"text":"E-gala-ganguedi, nollomakdemalad,","poem":1},{"text":"omeganyobi dobe itodmalad.","poem":2},{"text":"E-negmar dule-isganamarse ogumaklesad,","poem":1},{"text":"e-yawagak-bargamalad ei bibichismalad.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Gayaburba-berbegedi, baid-gayaburba-berbeged-sorbali abarmakmaid,","poem":1},{"text":"Babilonia-reyga-sogega: ‘Bela dule-baigan be-ibe neggwebur susye,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"dule-isdarmaladi, diwar-obaklemamaidgi bukusmarye,","poem":1},{"text":"nakuleged-negmar-bukwad ogumaksamarye,","poem":2},{"lineBreak":true},{"text":"degi, bela sorda-bila-onomaladi gwakidmarye.’ ”","poem":2}]},{"type":"verse","number":33,"content":["Ar Israel-dulemar-e-Bab-Dummad-Jehová-Bela-Gangued-Nikadi weyob soged:",{"text":"“Babilonia-yalaga odurdakleged-iba omosad,","poem":1},{"text":"Babilonia-yala-yeerdaklegedi, orosgisaar-dakleged-welesayobi daklegoed. Bela swanga naguoed.”","poem":2}]},{"type":"verse","number":34,"content":["Jerusalén-dulemar soged:",{"text":"“Babilonia-rey-Nabucodonosor an-obelosmalad,","poem":1},{"text":"suli-suli an-imaksamalad, bate-olloo-mellesiiyobi an-imaksamalad.","poem":2},{"text":"Ibdula-dummad-demargined-dule-doeyob an-dosad,","poem":1},{"text":"angi-immelesadba, a-sorbali, gannar agsad.”","poem":2}]},{"type":"verse","number":35,"content":["Jerusalén-dulemar sogmalad:",{"text":"“Babilonia-dulemala igi anmar-wiosa,","poem":1},{"text":"deyobi, Babilonia-dulemar gumarmosun.”","poem":2},"Sión-dulemar sogmalad:",{"text":"“Igi Babilonia-dulemar anmar-ablis eosmala,","poem":1},{"text":"deyob e-ablis ei ariomosun.”","poem":2}]},{"type":"verse","number":36,"content":["A-ulale, Bab-Jehová weyob soged:",{"text":"“Israel-dulemar, be-ibmar-imaksadgi an bemar-bendakoed,","poem":1},{"text":"ani an bemarga buged-mai imakoed.","poem":2},{"text":"Ani an Babilonia-demar odinguoed,","poem":1},{"text":"e-dii-sailagan-ariomamaid ani an dinnaa saoed.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Babilonia-neggwebur akwamar-dunnumake-bukwadga gudoed,","poem":1},{"text":"achu-sapur-uaya-gannagan-negga gudoed.","poem":2},{"text":"Neg-dobed-dummadga gudoed,","poem":1},{"text":"egi dodolegega gudoed.","poem":2},{"lineBreak":true},{"text":"Nega-dulesulidga, gudoed.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Babilonia-dulemar bulale achumigur-uurmakebayobi uurmakdemaloed,","poem":1},{"text":"achumigur-bipiganabayobi akigindemaloed.”","poem":2}]},{"type":"verse","number":39,"content":["Bab-Jehová soged:",{"text":"“Neg-diopisur-itoarmalale, ani an ega gobed dakoed.","poem":1},{"text":"Wergumalaga an omumsaoed,","poem":2},{"text":"suitii gabemai-saegala,","poem":1},{"text":"geg atake an imakoed.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Igi sibad-wawaad-senigana e-oburgwileged-negse seleddae, debayobi, an sedoed.","poem":1},{"text":"Igi sibad-machergana, degi, sibad-wawaad-machergana, e-oburgwileged-negse seleddae, debayobi an sedoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"”¡Be dakena! Babilonia-neggwebur napneg-naidgi-nuga-nika-siidi, igi bergus-sii be dake.","poem":1},{"text":"Igi dule-baiganse sabsuli-sules be dake.","poem":2},{"lineBreak":true},{"text":"Be dake, igi Babilonia-yala, dulemar-baiganga dobed-yalaga-gude be dake.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"E-isdarmaladi Babiloniaʼgi demaryobi mulusad.","poem":1},{"text":"Demar-weleganyobi egi arwisad.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Babilonia-neggweburmar bela olloo nagusad.","poem":1},{"text":"Nega-dinnaregedyobi-dakle nagusad,","poem":2},{"lineBreak":true},{"text":"nega-dulesulidyob-dakle nagusad.","poem":2},{"text":"Dulemar bar egi bukwasulid,","poem":1},{"text":"a-yalagi dulemar gwen bar iirmakbuksulid.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Babiloniaʼgine an bab-dummad-Bel sabsuli-odurdakoed.","poem":1},{"text":"Ibmar-dosadi gannar agega an imakoed.","poem":2},{"text":"Dulemar-baigan bar ese dagosurmalad,","poem":1},{"text":"degine, Babilonia-galu-matusulid-akwabiid bela ayaroed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"”¡Mimmigan, Babiloniaʼgi be ainimar!","poem":1},{"text":"Na be wala-walagwengi Bab-Dummad-urwedgi be san bendakmalo.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Neggweburgine, dulemar-sunmakedgi, melle dobgumalo, melle gegegwa be itomalo.","poem":1},{"text":"Birga-ilibali gayaburbamar baid-baid ainimai guoed.","poem":2},{"text":"Babilonia-yalagi galagwensuli-neg-gued-gaya ainimai guoed,","poem":1},{"text":"Dummagan-negsemaladi na muchub-muchub yolenanai gumaloed.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Babilonia-bab-dummagan-obelogoed-ibagan bato omosad.","poem":1},{"text":"Bela Babilonia-yala bingegunai guoed,","poem":2},{"lineBreak":true},{"text":"muimarbi yala-enosa naguoed.”","poem":2}]},{"type":"verse","number":48,"content":["Bab-Jehová soged:",{"text":"“Babilonia-galakuoedga, nibnega, napnega, degi, bela egi ibmarmar-bukwadi, weligwaledba binnasuli namakmaloed.","poem":1},{"text":"Ar e-isdarmaladi dad-nakwed-argan-sapiledsiki Babiloniaʼgi danimaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"”Babilonia-dulemala, Israel-dulemar-oburgwisadbali, oburgwilemarmogargebed.","poem":1},{"text":"Degine, bukidar dulemar-baigan-oburgwisbalidbali, Babilonia-dulemar oburgwilemarmogargebed.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Israel-dulemar, be es-suidgi-burgwissurmaladi, gwae be wakitemala.","poem":1},{"text":"Ar bemar dikasuli be bukwamalale, Bab-Jehová-nug be odummomalo.","poem":2},{"lineBreak":true},{"text":"Melle Jerusalén-neggwebur be iemarbalo.”","poem":2}]},{"type":"verse","number":51,"content":["Bemar sogmalad:",{"text":"“Anmargi dulemar isdar-sunmake-itogedba anmar bingedar itoye.","poem":2},{"text":"Anmar-mesagwar-imaklegedi anmar-wagar-gisii imakye.","poem":1},{"text":"Ar dule-bamaladi bese-goled-negse dogsamalad-ulale, anmar bingedar itoye.”","poem":2}]},{"type":"verse","number":52,"content":["A-ulale, Bab-Jehová soged:",{"text":"“Ibagan danikid, a-ibagi, an Babilonia-bab-dummagan obelogoed.","poem":1},{"text":"Babilonia-yalagine dulemar-naibigumaloedi bukidara akigitemaloed.”","poem":2}]},{"type":"verse","number":53,"content":["Bab-Jehová soged:",{"text":"“Ar Babilonia amba e-galu-matusulid-akwabiidi nibnegse imakye-sogele, degi, nibali e-bubawarmar ogwisye-sogele,","poem":1},{"text":"amba an e-obelogega e-isdarmaladi an egi barmidoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":54,"content":[{"text":"”Babilonia-yala-akale, binnasuli e-dulemar-sabsurgunaidba-bobukwadi magar itoleged.","poem":1}]},{"type":"verse","number":55,"content":[{"lineBreak":true},{"text":"Bab-Jehová Babilonia-yala bela obelonaid,","poem":1},{"text":"dulemar-oimakbukwad bela obelonaid.","poem":2},{"text":"Babilonia-e-isdarmaladi demar-mullugan-uurmakmaiyobi,","poem":1},{"text":"e-dolewar binnasuli uurmakbukwad.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Babilonia-e-isdarmaladi Babilonia-yala-obelogega, egi gwichigudanimalad.","poem":1},{"text":"Babilonia-sordamar-bulegan bela galemaloed,","poem":2},{"text":"e-sigumala bela ei bibisgelegoed.","poem":1},{"text":"Ar Bab-Dummad-Jehová dulemar na e-odurdaklemaloedbali ega ibmar imaked.”","poem":2}]},{"type":"verse","number":57,"content":["Ani an Rey-guedi, Bab-Jehová-Bela-Gangued-Nikadi weyob soged:",{"text":"“Babilonia-e-dummagan, degi, e-binsaed-ibegan, an omumsaoed.","poem":2},{"text":"Ega-negsemamaid, an omumsaoed.","poem":1},{"text":"E-sordamar-dummagan, degi, e-sorda-bila-onomaladi an omumsabaloed.","poem":2},{"text":"We-dulemar degisadegu gabidmaloed,","poem":1},{"text":"bali gannale atakosurmalad.”","poem":2}]},{"type":"verse","number":58,"content":["Bab-Jehová-Bela-Gangued-Nikadi weyob soged:",{"text":"“Babilonia-galu-matusulid-akwabiid e-mata-dummad, bela nagase babatoed.","poem":1},{"text":"Degi, e-yawagak-matusurmaladi ogumaklegoed.","poem":2},{"text":"Dulemar binsarsunna alamaksamalad,","poem":1},{"text":"degine, binsarsunna gar-itosmalad, unnila sooga alamaksamalad.”","poem":2}]},{"type":"verse","number":59,"content":["Weyobi Bab-Dummad-gayaburba-barsoged-Jeremías, Nerías-machi-Seraíasʼga igar uksad. Deunni, Sedequías birgabakegus-negsemaidgined. Seraías, Judá-rey-Sedequíasʼbo Babiloniaʼse nadmalad. Agine Seraías dulemar-idumai gusad. Seraíasʼde Maasías-wagwad."]},{"type":"verse","number":60,"content":["Jeremías bela Babiloniaʼgi boni-dummagan-danikoedi garda-suid-bipirmakaledgi narmaksagusad. Wegisundo, Babilonia-yalagi ibmarmar-gumaloedi bela narmaklesad."]},{"type":"verse","number":61,"content":["Jeremías, Seraíasʼga weyob sogsad: “Babiloniaʼse be modapile, bela we-gardagi ibmarmar-sognaid be absogo."]},{"type":"verse","number":62,"content":["”Seraías, geb a-sorbali, Bab-Jehováʼga weyob be sogo:",{"text":"‘Bab-Jehováʼye, bede sogsa gusad:","poem":2},{"lineBreak":true},{"text":"Ani an bela we-yala obelogoye,","poem":2},{"lineBreak":true},{"text":"degisadegu ollobi-nai an imakoye.","poem":2},{"lineBreak":true},{"text":"Dulemar, bipisaale bar urbega an imakosurye,","poem":2},{"lineBreak":true},{"text":"degine, ibmar-durganse-bakale, dulemarba ambikuosurye.","poem":2},{"lineBreak":true},{"text":"Bela ibmar-sate guoye, be sogsad.’","poem":2}]},{"type":"verse","number":63,"content":["”Bela be we-garda-suid-bipirmakaled-absosale, egine be akwa edinno. Geb agine Éufrates-diwargine be a-garda metoed."]},{"type":"verse","number":64,"content":["Geb a-sorbali, be weyob sogo: ‘Igi we-garda dii-ulak-dogde, deyobi, Babilonia-yala dogdemogoed, bipisaale bar gannale Bab-Dummad egi bonigan barmidagoedgi san-onogosulid.’ ” Wesega Jeremías-sunmaksadi bergunaid."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":64}