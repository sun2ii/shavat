{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JER","translationId":"cuk_nvs","name":"Jeremías","commonName":"Jeremías","title":"JEREMÍAS-GARDA JEREMÍAS","order":24,"numberOfChapters":52,"sha256":"75584cc634e682f16d689c79332a191baf65045db96e9e927452315ef9b2d123","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cuk_nvs/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":6,"content":[{"type":"heading","content":["Isdarmalad, Jerusalén-neggwebur-ebilis-bukwad"]},{"type":"verse","number":1,"content":["Bab-Jehová soged:",{"text":"“¡Benjamín-wagan, Jerusalén-neggweburgi be ainimar!","poem":1},{"text":"¡Tecoa-neggweburgi be gar-trompeta ogormar!","poem":2},{"lineBreak":true},{"text":"¡Bet-Haqueremʼgi be waa-obupurmakmar!","poem":2},{"text":"Ar dad-nakwed-argan-sapiledsiki boni-dummad danikid,","poem":1},{"text":"neg-obeloged danikid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jerusalén-neggwebur-yeerdakleged an obelosokalid,","poem":1},{"text":"gagan-aradikid-naid-yeerdaklegedyobidi, an obelosokalid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sibad-edarbemalad, degi, e-sibadmar ese danimalad, neggwebur-ebilis ambikunonimaloed,","poem":1},{"text":"na wala-walagwen e-itolegedba ibmar imakdemaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"”Be-isdarmalad, e-sordamarga sogdemaloed:","poem":1},{"text":"‘¡Jerusalén-neggweburgi-bila-onogega guakwamalo!","poem":2},{"text":"¡Yorukudbali anmar egi gwisgumaloed!","poem":1},{"text":"¡Emide, gwen nabir itolesulid,","poem":2},{"text":"dad nae-naegusad!","poem":1},{"text":"¡Bato neg sedomaid!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"¡Anmar nae! ¡Anmar mutiki egi gwisgudapoed!","poem":1},{"text":"¡Anmar e-neg-gandikmalad obelogoed!’ ”","poem":2}]},{"type":"verse","number":6,"content":["Deyob Bab-Jehová-Bela-Gangued-Nika-Maid soged:",{"text":"“¡Suarmar be immimar!","poem":1},{"text":"Jerusalénʼgi-dogega napa-nakwemai be sobmalo.","poem":2},{"text":"Ar e-dulemar ibmar-isgana-imakedbi wismarsoggu,","poem":1},{"text":"we-neggwebur sabsur-odurdaklegergebed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Igi dia-yaagi dii-mummurmakmaidae,","poem":1},{"text":"debayobi, Jerusalén-neggweburgi isgued ainimaid.","poem":2},{"text":"A-neggweburgi sabsur-imaklegedbi itoleged,","poem":1},{"text":"unnila ibmar-obelolegedbi itoleged.","poem":2},{"text":"Ibmar-nued-imakleged an daksulid,","poem":1},{"text":"unnila boniganbi nomamai an daked,","poem":2},{"lineBreak":true},{"text":"nailikguedbi nomamai an daked.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"¡Jerusalén-dulemar! An-bemargi-melle-banguega, be-daed be ogwamala.","poem":1},{"text":"Ar degisulile, an bela bemar-obelogoed,","poem":2},{"lineBreak":true},{"text":"dulemar bar-ambikuega an imakosulid.”","poem":2}]},{"type":"verse","number":9,"content":["Bab-Jehová-Bela-Gangued-Nika-Maid weyob soged:",{"text":"“Israel-dulemar-dula-bemaloedi, bela amiledii gulemaloed.","poem":1},{"text":"Igi uva-san belallaa weledae,","poem":2},{"text":"e-gaagi gwen gwagwenad obeledasuli,","poem":1},{"text":"debayobi, dule-wargwenad gwen obelegosulid.”","poem":2}]},{"type":"verse","number":10,"content":["Ani Jeremías sogded:",{"text":"“Bab-Dummad, an bese egisdo,","poem":1},{"text":"¿wede doaga an sunmakoe?","poem":2},{"text":"¿An doa owisogoe?","poem":1},{"text":"¿Doa an-itogoe?","poem":2},{"text":"Ar yamo itogosurmalad,","poem":1},{"text":"an ega-ibmar-soged aku-itomaloed.","poem":2},{"text":"Ar be-gayaburbagi dododamalad,","poem":1},{"text":"ar be-gayaburba itobisurmalad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar Bab-Dummad-isdar-itogeyobi an isdar itogusmogad,","poem":1},{"text":"agala, geg na san bargagusad.”","poem":2},"Bab-Jehová anga sogded:",{"text":"“Be-sae-itoged be soge, burwigana-neg-imbaba-gudimaladga be soge,","poem":1},{"text":"sapingan-danar-danar-gudimaladga be oyoge.","poem":2},{"text":"Ome e-suibogwa gales seledmaloed,","poem":1},{"text":"degine, dule-uka-selebamalad, dadgan-sergan-ebo, gales seledmarmogoed.”","poem":2}]},{"type":"verse","number":12,"content":["Bab-Jehová soged:",{"text":"“E-negmar, e-nainumar, degi, e-omegan dule-baigangadga guoed.","poem":1},{"text":"Ar ani, an-dulamar-we-neggweburgi-bukmalad sabsur-odurdakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”Bipiganase-bakale, degi, serganse-bakale,","poem":1},{"text":"igar-maisulidba-ibmar-nikuedgi yaisur-itodimalad.","poem":2},{"text":"An-gayaburba-barsogmaladse-bakale,","poem":1},{"text":"dule-irwa-anse-gormaladse-bakale,","poem":2},{"lineBreak":true},{"text":"dule-yardakedgi arbadimalad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Unnila asginbi an-dulamarga sokardamalad:","poem":1},{"lineBreak":true},{"text":"‘Be-isguedgi be ollorgusye, nueganbiye.’","poem":1},{"lineBreak":true},{"text":"Sokardamarbalid: ‘Neg nueganbiye.’","poem":1},{"text":"Degi-inigwele, neg nueganbi dasulid.”","poem":2}]},{"type":"verse","number":15,"content":["Ani an Bab-Jehová soged:",{"text":"“¿Bemar ibmar-isgana-imaksadbali, be bingegusmala?","poem":1},{"text":"Ar bemar, bingedar itossurmalad.","poem":2},{"text":"¡Bingeguodeeye gwen binsasurmalad!","poem":1},{"text":"A-ulale, wemar dulemar-sabsur-odurdaklegoedba, sabsur-odurdaklemogoed.","poem":2},{"lineBreak":true},{"text":"An we-dulemar sabsur-odurdakalile, bela wilemaloed.”","poem":2}]},{"type":"verse","number":16,"content":["Bab-Jehová weyob soged:",{"text":"“Ibmar-imakdimalad be melle bar imakmar,","poem":1},{"text":"be-gudiid be nue itomar.","poem":2},{"text":"Igar-epennegana be egismar, igid-igar bur nuedye.","poem":1},{"text":"Melle a-igargi be bangumalo.","poem":2},{"text":"Deyobi, bonisuli garmakdii be gumaloed.","poem":1},{"text":"Degi-inigwele, ‘bemar we-igarba nanaosurye’ sogsamalad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"An bemarga gayaburba-berbemalad barmisad, weyob bemarga sogegar: ‘Nue gar-trompeta-goled be itomalo.’","poem":1},{"text":"Degi-inigwele, bemar gar-trompeta-goledba ibsaosurmarye sogsamalad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"¡Degisoggu, dulemar-neggwebur-akar-akar-bukmalad be itomar!","poem":1},{"text":"¡An-dulamar-wilegoed be nue itomalo!","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"”Dulemar, bela be an-itomar:","poem":1},{"text":"Boni-dummad an Jerusalén-neggweburga sedanikid.","poem":2},{"text":"E-isgudimalad-ulale, boni-dummad an ega sedanikid.","poem":1},{"text":"Ar an ega ibmar-soged itossurmalad,","poem":2},{"lineBreak":true},{"text":"aka an-igar-maid obachamalad.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ina-wawadikid Sabá-neggweburgi be sedanidamaladi, ¿ibi-nuedga wis anga guoe?","poem":1},{"text":"Masaryob-dakleged-wawadikmalad, dikasur-neggwebur-baidgi be sedanidamaladi, ¿ibi-nuedga wis anga guoe?","poem":2},{"text":"Be anga we-ibmarmar ogumakar-ukmalad an abesulid.","poem":1},{"text":"We-ibmarmar an yeer daksulid.”","poem":2}]},{"type":"verse","number":21,"content":["A-ulale, Bab-Jehová weyob soged:",{"text":"“An Jerusalén-dulemar-igar oburoed, egi yolemalaga an imakoed.","poem":1},{"text":"Babgan, e-mimmiganmala, e-aimarmala, degine, e-neg-dikarba-mamaimalad, bela girgumaloed.”","poem":2}]},{"type":"verse","number":22,"content":["Bab-Jehová weyob soged:",{"text":"“¡Be dakmar! Dad-nakwed-argan-sapiledsik sorda-bila-onomalad danikid.","poem":1},{"text":"Bela napaneg-ugakaase sordamar-bukib duurmakdanimalad.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Warsiyalaba duurmakdanimalad","poem":1},{"text":"eswarmar-annik-annik melledanimalad.","poem":2},{"text":"Dule-isganamalad, wile dule-daksurmaladid.","poem":1},{"text":"Demar-uurmakemaiyobi, binnasuli oimakdanimalad,","poem":2},{"text":"e-molimar-birgi abarmakdanimalad.","poem":1},{"text":"Jerusalén-dulemar, we-dulemar begi-bila-onogega duurmakdanimalad.”","poem":2}]},{"type":"verse","number":24,"content":["Jerusalén-dulemar sogdemalad:",{"text":"“Anmarse gayaburba nonikid,","poem":1},{"text":"degidbali, anmar niga argwated.","poem":2},{"text":"Anmargi dobe-itogedi obined,","poem":1},{"text":"igi-ome-ugakgunair boniganba-galitonaidae, deyobiyob anmar itoged.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Melle be sapurba ainimalo,","poem":1},{"text":"melle aineba namalo.","poem":2},{"text":"Ar anmar-isdarmalad es-suid-guagwar danikid.","poem":1},{"text":"¡Bela neg-imbaba neg dulagwar naid!","poem":2}]},{"type":"verse","number":26,"content":[{"text":"An-dulamar, wile-itoged-mor be yomala.","poem":1},{"text":"Burugi baparmakmai be imakmala.","poem":2},{"text":"Igi-dule na e-mimmi-wargwennagwad-ei-burgwisar bina boe, debayobi be ise-boale bomala.","poem":1},{"text":"Ar dulemar-anmar-obelogedi, emisgwa anmargi danikid.”","poem":2}]},{"type":"verse","number":27,"content":["Bab-Dummad anga sogded:",{"text":"“Jeremías, be an-dulamar-daed-argaega, e-daed-balamiega, amar-abargi-egi-nakulegega, an-be-ogwichisad.","poem":1}]},{"type":"verse","number":28,"content":[{"text":"Bela we-dulemala uayasulidamalad,","poem":2},{"text":"gakansaedbi dakdimalad.","poem":1},{"text":"Na dule-nuedga san-imakmar-inigwele, bela dule-isganamarbiid.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ar soo-binnasur gadele, gingwa soo-abin daluddaed.","poem":1},{"text":"Ar dulemardina, gwen san-islididik gusulid.","poem":2},{"lineBreak":true},{"text":"Gwen igarga gusurmalad.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"A-ulale, we-dulemar ibmar-isganaye bileged.","poem":1},{"text":"Ar angala ibmar-isganaga gumalad.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}