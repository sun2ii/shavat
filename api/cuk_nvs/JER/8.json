{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JER","translationId":"cuk_nvs","name":"Jeremías","commonName":"Jeremías","title":"JEREMÍAS-GARDA JEREMÍAS","order":24,"numberOfChapters":52,"sha256":"75584cc634e682f16d689c79332a191baf65045db96e9e927452315ef9b2d123","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cuk_nvs/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["Bab-Jehová soged: “A-ibagangine, reymar-garmar, degi, Judá-dulemar-garmar-neg-uangi-mamaid bela onomaloed. Degine, dule-irwa-Bab-Dummadse-gormalad-garmar, Bab-Dummad-gayaburba-barsogmalad-garmar-mamaid bela onomarbaloed. Deginbali, Jerusalén-dulemar-garmar bela onomarbaloed."]},{"type":"verse","number":2,"content":["Bela-a-garmar dad-abin, degi, nii-abin, degine, niisgwamar-abin urbilegoed. Ar ade, wemar dad, nii, degine, niisgwamar sabgusmalad, ega ibmar imaksamalad, degine, we-ibmarmarse ibmar egichismalad, e-nugmar odummosmarbalid. Dulemar we-garmar-digega bar garmar weosulid. ¡Ibmar-isganamaryob napagi omiledoed!"]},{"type":"verse","number":3,"content":["Ani an Bab-Jehová-Bela-Gangued-Nikad soged: An we-dule-isganamar galagwensuli aisakis urboed. Amar dula bar gudii gubigudagosurmalad, burgwebi bur gudamaloed. Ar deyob guoed.”"]},{"type":"heading","content":["Isgued, degi, sabsur-odurdakleged"]},{"type":"verse","number":4,"content":["“Jeremías, we-dulemarga be sogbalo, Bab-Jehová weyob sogye:",{"text":"‘Dulemar aimukusale, ¿gwichibin imakdasursi?","poem":1},{"text":"Dule wis igar-noaledba-aibatele, ¿gannar igar-nabirid-amidasursi?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Degite, ¿ibiga bemar igar-noaledba aibatemarsunna?","poem":1},{"text":"Jerusalén-dulemar, ¿ibiga be nue-an-obachamarsunna?","poem":2},{"text":"Unnila gakan-igargi be alamakdimalad,","poem":1},{"text":"gwen anse gannar be dagbisurmalad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dule-sunmaked nue an itodii gusanad,","poem":1},{"text":"dakega, dule-wargwen igar-nuedba sunmakdiidibeye.","poem":2},{"text":"Dulemar e-isguedga gwen bukib binsasurmalad,","poem":1},{"text":"e-ibmar-isgana-imaksamalad aku itomalad.","poem":2},{"text":"Bela dulemar, igi moli bila-onolenaidgi-abarmakwisdae,","poem":1},{"text":"deyobi, e-itoleged-e-itolegedba nanabukmalad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ar dabgalamarbela ibagan-nagumaid wisid.","poem":1},{"text":"Sapur-nuumar, degi, wirsobmarbela wisid,","poem":2},{"text":"sanase neg-baidse obakmaloe.","poem":1},{"text":"Ar bemardi, an-dulamar-gumaladi, an-igar-mamaiddi gwen wissurmalad.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”Ar ibiga be sokardamala:","poem":1},{"text":"‘Anmar binsaed-ibegana, anmar Bab-Jehová-Igar-Maid sedimala.’","poem":2},{"text":"Ar dule-garda-narmakmaladbela gakansaar odurdakmalad,","poem":1},{"text":"Bab-Dummad-igar weyob-maiye sogdidamalad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"We-dule-binsaed-ibegan nue-bingegumaloed,","poem":1},{"text":"na dukin ise-yardaklegar gumaloed.","poem":2},{"text":"Ar an-gayaburba itossurmalad,","poem":1},{"text":"degisoggu, ¿bia e-binsaed-nikagued nadsunna?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"A-ulale, an e-omegan machergan-baiganga ukoed,","poem":1},{"text":"degi, an e-nainumar dule-baiganga ukbaloed.","poem":2},{"text":"Ar bipigana, serganse-bakale, igar-maisulidba ibmar-nikuedgi binsamalad.","poem":1},{"text":"Bab-Dummad-gayaburba-barsogmalad,","poem":2},{"lineBreak":true},{"text":"dule-irwa-Bab-Dummadse-gormaladse-bakale,","poem":2},{"lineBreak":true},{"text":"ibmar-amimalagala, emar-yardakar arbadimalad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Unnila asginbi an-dulamar-nudakdimalad.","poem":1},{"text":"Unnila ega sokardamalad: ‘Nueganbi, bonisuli.’","poem":2},{"text":"Ar degi-inigwele, nueganbi-dasulid,","poem":1},{"text":"aka bur bule neg ege naid.”","poem":2}]},{"type":"verse","number":12,"content":["Bab-Jehová soged:",{"text":"“Weyob ibmar-isgana-imaksamaladba, degite, ¿bingedar-itosurmarde?","poem":1},{"text":"Suli, degite amba bingedar itosurmalad.","poem":2},{"lineBreak":true},{"text":"¡Ar bingegued wissurmalad!","poem":2},{"text":"A-ulale, dulemar-sabsur-odurdaklegoedba, wemar sabsur-odurdaklemogoed.","poem":1},{"text":"An we-dulemar sabsur-odurdakalile, bela wilemaloed.”","poem":2}]},{"type":"verse","number":13,"content":["Bab-Jehová soged:",{"text":"“Bela an bemar-obelogoed,","poem":1},{"text":"uva-san e-nainugi berguedyob an bemar-obelogoed.","poem":2},{"lineBreak":true},{"text":"Higo-san e-sapigi satedaeyob an bemar-imakoed.","poem":2},{"text":"Degine, e-gagan-dinnaganbi-nanaidaeyob an bemar-imakoed.","poem":1},{"text":"A-ulale, an bela bemarga ibmarmar-uksadi, gannar an bemar-annik suoed.”","poem":2}]},{"type":"verse","number":14,"content":["Geb dulemar sogdemalad:",{"text":"“¿Ibi anmar wegi gannaa sabukwa?","poem":1},{"text":"Dage, anmar neggwebur-gandikmaladse nae,","poem":2},{"lineBreak":true},{"text":"agi anmar itoba burgwemaloed.","poem":2},{"text":"Ar anmar Bab-Dummadgi dummad-isgusad-ular, anmar-Bab-Dummad-Jehová anmar-obelonaid.","poem":1},{"text":"Dii-ina-nusubiid-gobega anmar-imaksad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nueganbi-naoye anmar bisanad,","poem":1},{"text":"degi-inigwele, anmar ibmar-nued gwen daksasulid.","poem":2},{"text":"San-nued-gumaloye an bisanad,","poem":1},{"text":"degi-inigwele, anmarga dobed-dummad uksad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dan-neggwebur-akale, molimar-abarmakdanikid itoleged.","poem":1},{"text":"Molimar gotele, bela yala giglimakdedaed.","poem":2},{"text":"Yala-naid obelodanikid, bela yalagi-ibmar-bukwad obelodanikid.","poem":1},{"text":"Neggweburgi-siid, degi, bela e-dulemar-bukwad obelodanikid.”","poem":2}]},{"type":"verse","number":17,"content":["Bab-Jehová soged:",{"text":"“An bemargi naibe-nuegan barmidoed, bemargi warmakoed.","poem":1},{"text":"We-bonigan-nudakegala, inamar sulid.”","poem":2}]},{"type":"heading","content":["Jeremías, e-dulemar-ular nue-wile-itoged"]},{"type":"verse","number":18,"content":[{"text":"An bela-belad nue-nunmak-itogedbali,","poem":1},{"text":"an-gwage-ulubgi an burgwebidar itogusad.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bela neggwebur-imbaba an-dulemar-ogormakbukwad itoleged,","poem":1},{"text":"“¿Bab-Jehová Sión-yalagi bar gudisursi?","poem":2},{"lineBreak":true},{"text":"¿E-reyde a-yargi bar maisurmosi?”","poem":2},"Bab-Dummad abin-sogded:",{"text":"“¿Ar ibiga bemar be-bab-dummagangi an-ourwega an-imakmala?","poem":1},{"text":"¿Ibiga be-bab-dummagan-ibmar-nuedga-gusurmaladgi an-ourwega an-imakmala?”","poem":2}]},{"type":"verse","number":20,"content":["Israel-dulemar sogded:",{"text":"“Ibmar-weed-ibagan bergus, neg-yolad bergus,","poem":1},{"text":"ar anmardi gwen bendaklessurmalad.”","poem":2}]},{"type":"verse","number":21,"content":["Geb an abin-imaksad:",{"text":"“An-dulemar-nunmak-itogedbali, an nunmak-itomogad.","poem":1},{"text":"An nue bukib-binsaedba, bela-belad angi dobednagusad.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"¿Ar Galaad-yalagi ina-wawadikid sursi?","poem":1},{"text":"¿Agi ina-duledmarde sursi?","poem":2},{"lineBreak":true},{"text":"¿Ar ibiga an-dulemarde bonigan-abgadii gumalosunna?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JER/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JER/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JER/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}