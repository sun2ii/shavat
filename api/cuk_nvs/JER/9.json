{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JER","translationId":"cuk_nvs","name":"Jeremías","commonName":"Jeremías","title":"JEREMÍAS-GARDA JEREMÍAS","order":24,"numberOfChapters":52,"sha256":"75584cc634e682f16d689c79332a191baf65045db96e9e927452315ef9b2d123","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cuk_nvs/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"Ani Jeremías, an-neggweburginmalad-girgusadba, ibginedba, degi, mutikidba, an bodii guega,","poem":1},{"text":"an-nono, dii-aryomaiyob guena yeerban.","poem":2},{"lineBreak":true},{"text":"An-ibyanis, dii-aryogwisdaeyobi gusana yeerban.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"An nega-dulesulidganba, obunnoged-neg nikana yeerban.","poem":1},{"text":"An-neggwebur-mete an naoenad.","poem":2},{"lineBreak":true},{"text":"We-dulemargi an banguoenad.","poem":2},{"text":"Ar bela we-dulemala, galagwensur-nanamaladid,","poem":1},{"text":"ar bela we-dulemala, dule-yardakmaladid.","poem":2}]},{"type":"verse","number":3,"content":["Bab-Jehová soged:",{"text":"“Gakansamalaga guakwaa gudidamalad,","poem":1},{"text":"warsi-guagwar-ganikidyob gudidamalad.","poem":2},{"text":"We-yalagine, igar-napiragwad sated,","poem":1},{"text":"gakansaed neg-gagas naid.","poem":2},{"text":"Aka bur nue-ege neg-nadapid.","poem":1},{"text":"Ani an Bab-Dummad-gued gwen an-daksurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"”Be-aimar-warwargwengi nue salakarmar,","poem":1},{"text":"melle gwenadganse-bakar, egi be bensuli guo.","poem":2},{"text":"Ar bela gwenadganmar dule-yardakedbiid.","poem":1},{"text":"Bela aimar, na e-aimar-dikarba yogasaar sunmakdimalad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Na muchub-muchub yardakdimalad,","poem":1},{"text":"dule-wargwensaale, napiragwadgi sunmaksurmalad.","poem":2},{"text":"Na gakansaedgi nue-durdaksa gudimalad,","poem":1},{"text":"gakansaedginbi binsadimalad.”","poem":2}]},{"type":"verse","number":6,"content":["Bab-Jehová soged:",{"text":"“Be, Jeremías, dulemar-yardakmalad-abargi be gudiid,","poem":1},{"text":"amar emar-yardakmaladba magar an-dakbisurmalad.”","poem":2}]},{"type":"verse","number":7,"content":["A-ulale, ani Bab-Jehová-Bela-Gangued-Nikad weyob soged:",{"text":"“¿Ibu-ibmar-baid bar an-dulamarga an imakbalosunna?","poem":1},{"text":"An we-dulemar urukergebed,","poem":2},{"lineBreak":true},{"text":"an we-dulemar wilubdakergebed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ar e-gwabin-duku sigu-dule-gindakedyobid,","poem":1},{"text":"unnila gakansaar-sunmakedbi wismalad.","poem":2},{"text":"E-aibo nuedgi sunmakdaed,","poem":1},{"text":"ar e-ulubgindi yamogedgi binsadamalad.”","poem":2}]},{"type":"verse","number":9,"content":["Bab-Jehová soged:",{"text":"“Degite, a-ulale, ¿an sabsur-odurdakosurde?","poem":1},{"text":"An sabsur-odurdakergebed.","poem":2},{"text":"¿We-dulemar an buged-mai imakosurde?","poem":1},{"text":"An imakergebed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Yalaganga boega an be-imakoed,","poem":1},{"text":"yalaganga akiginnega an be-imakoed.","poem":2},{"text":"Nega-dulesulidgan-e-gaganmarga oakudii an be-imakoed,","poem":1},{"text":"ar bela neg-olloo nai guoed.","poem":2},{"text":"Ar dulemar bar agi gudii guosulid,","poem":1},{"text":"molimar-goledi bar itolegosurbalid.","poem":2},{"lineBreak":true},{"text":"Bela nuumarse-bakale, ibmar-durganse-bakale, duurmakdemaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”Jerusalén-neggwebur napi akwabi ganna-ganna-bukwa an imakoed,","poem":1},{"text":"achu-sapur-uaya-ganna-ganna-e-negga an imakoed.","poem":2},{"text":"Judá-neggweburmar-e-sailaga-gubukwad neg-ollobi an sioed,","poem":1},{"text":"dulemar-sate an imakoed.”","poem":2}]},{"type":"heading","content":["Judá-dulemar, degi, dulemar-baigan sabsur-odurdaklegoed"]},{"type":"verse","number":12,"content":["Ani Jeremías weyob sogded: Ar we-ibmar magar-itogegala, ¿doa binsaed-ibed-gudii? ¿Ar doaga Bab-Dummad sunmaksa, adi, dule-baidga we-ibmar-sogmogagar? ¿Ar ibiga anmar-yar bergusnai? ¿Ibiga anmar-yar nega-dulesulid-naidyobi dule gwen nanasuli ollo-nai?"]},{"type":"verse","number":13,"content":["Bab-Jehová soged: “Ar Israel-dulemar an-Igar-Maid an ega uksadgi aibatemalad. An-sogedba ibsassurmalad, a-Igarba nanassurmalad."]},{"type":"verse","number":14,"content":["Aka e-binsaed-isganaba nadmalad, bab-dummagan-Baalʼmarba nanasmalad. E-babgan-e-odurdaksadba nanasmalad.”"]},{"type":"verse","number":15,"content":["Israel-e-Bab-Dummad-Jehová-Bela-Gangued-Nikad weyob sogbalid: “We-dulemar ibmar-gagbiremalad-gunnega an imakoed, degine, dii-ina-nusubiid-gobega an imakbaloed."]},{"type":"verse","number":16,"content":["Wemar, yar-baid-baid-nanaidgi-aisakiega an imakoed. Wemar, degi, e-babgan we-yarmar-gwen-dakdisurmaladse an oduurmakoed. Es-suidyalaba an baleginnoed, bela obelogedse an imakoed.”"]},{"type":"verse","number":17,"content":["Bab-Jehová-Bela-Gangued-Nikad weyob soged:",{"text":"“Nue be itomar. Omegan-dule-burgwismaladga-bomaladse be gornamar.","poem":1},{"text":"‘Bur nue-yeer-bomalad dagmaloye,’ be sogo:","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Gwae-gwae dagmalo.","poem":1},{"text":"Anmar-ular bodamala.","poem":2},{"text":"Anmar-ibyanis bela-bela aryogoed,","poem":1},{"text":"anmar-ibyanis ena-ena naoed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sión-yala-akale, dule-boedi, degi, dule-akiginnedi, weyobi, itoleged:","poem":1},{"text":"Anmar nue oitolesmar, nue-anmar-obingegsasmalad.","poem":2},{"text":"Anmar we-yalagi nomalargebed,","poem":1},{"text":"ar bela anmar-neguyamar obelosmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"”Omegan, an-gayaburba nue be itomar.","poem":1},{"text":"An-ibmar-soged nue be itomalo.","poem":2},{"text":"Be-bunamala, bukid-binsaleged-namakedgi be odurdakmar.","poem":1},{"text":"Be-aimar muiga-bolegedgi weyob be odurdakmar:","poem":2}]},{"type":"verse","number":21,"content":[{"text":"‘Burgwedi, anmar-negse dognoniki,","poem":1},{"text":"anmar-neg-yawagakba dogsad.","poem":2},{"text":"Burwigana-magaba-gudidimalad obelolesad,","poem":1},{"text":"sapingana-magaba-ambikulegedgi-bukmalad obelolesad.’ ”","poem":2}]},{"type":"verse","number":22,"content":["Bab-Jehová soged:",{"text":"“Muimar, napagi ibmar-isganayob omilede guoed.","poem":1},{"text":"Igi dule-ibmar-gwag-wesale, napagi-babatismalad-omileddae,","poem":2},{"text":"gwen bar dule wedasuli,","poem":1},{"text":"deyobi, muimar napagi omilede guoed.”","poem":2}]},{"type":"verse","number":23,"content":["Bab-Jehová weyob soged:",{"text":"“Dule-binsaed-ibed, melle na e-binsaed-nue-nikadgi san-dummarba itogo.","poem":1},{"text":"Dule-gandikid, melle na e-gangued-nikarbadgi san-dummarba itomogo.","poem":2},{"lineBreak":true},{"text":"Dule-mani-ibed, melle na e-mani-nikarbadgi san-dummarba imakmogo.”","poem":2}]},{"type":"verse","number":24,"content":["Bab-Jehová soged:",{"text":"“Ar dule na nug-dummarba-imakbiele, magar-an-dakedgi na nug-dummarbaa imakdo.","poem":1},{"text":"Ar dule na wergubiele, ani Bab-Dummad-Jehová-gued-magar-an-dakbalidgi, wergusundo.","poem":2},{"text":"Ani an dulemar-sabgumaiye,","poem":1},{"text":"degi, ani an igar-innikii-imakedye, be wisidba, be wergusundo.","poem":2},{"text":"Ani an igar-maidba we-napneggi-ibmar-imakedgi be wergusundo.","poem":1},{"text":"Ar weyob ibmar-imaklegedi, an yeer daked.”","poem":2}]},{"type":"verse","number":25,"content":["Bab-Jehová soged: “Bela dule-abgan-uka-duku-sikarmalad, anse-sabsur-odurdakleged-ibagan ega danikid."]},{"type":"verse","number":26,"content":["An we-dulemar sabsur-odurdakoed:",{"text":"Egipto-dulemar, Judá-dulemar,","poem":2},{"lineBreak":true},{"text":"Edom-dulemar, Amón-dulemar,","poem":2},{"lineBreak":true},{"text":"Moab-dulemar,","poem":2},{"lineBreak":true},{"text":"degine, bela dulemar-nega-dulesulidganba-bukwamalad,","poem":2},{"lineBreak":true},{"text":"dulemar-burgwarmaladse-golega na nono-swiri-imakmaladi,","poem":2},{"text":"wemar an sabsur-odurdakoed.","poem":3},{"text":"Ar bela dulemar-yar-baid-baidgi-bukwamalad, degi, Israel-dulemarse-bakale, e-gwage-ulubgine anba dasurmalad.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JER/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JER/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JER/8.json","previousChapterAudioLinks":{},"numberOfVerses":26}