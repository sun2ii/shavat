{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":10,"content":[{"type":"heading","content":["Job e-boni-nikadba bukib binsaed"]},{"type":"verse","number":1,"content":["Job, Bildadʼga sogdebalid:",{"text":"“¡An budar wegi-gudiidi itogusad!","poem":1},{"text":"Agala, yogasaar an sunmakargussunnad.","poem":2},{"lineBreak":true},{"text":"An-nabir-itosulid na dukin barsognagussunnad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"”Bab-Dummadga an sogoed: ‘Mer weyob be an-wioye.","poem":1},{"text":"Anga be sogye, ¿ibiga weyob be an-imaknai?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Dummadga an sogbaloed: ¿Weyob be an-imaknaid yeer be an-dake?","poem":1},{"text":"¿Isdarsunna be dule-obinnisadi dake?","poem":2},{"lineBreak":true},{"text":"¿Dule-isganamar isdarsunna-angi-binsananaidi, be baisur-dake?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"¿Dulemar-daeyob be emar-dake?","poem":1},{"text":"¿Anmar-ibmar-dakeyob be dakmoga?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"¿Ar be-ibagande, anmar-ibaganyobmoga?","poem":1},{"text":"¿Ar bega birgamar-nanamaid dulega-nanamaidyobmoga?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Degite, ¿ibiga be an-isguedi wisgubisunna?","poem":1},{"text":"¿Ar ibiga be an-isguedi bela be bar-amibisunna?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"¿Ar be nue-wissursi, ani an ibmar-oakalossulid?","poem":1},{"text":"¿Ar be nue-wissursi, begine geg an dukued?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"” ’Ar be-sunnad be an-imaksad,","poem":1},{"text":"be-sunnad be an-obinnisad.","poem":2},{"text":"Degite, be-binsaed be gwagdode,","poem":1},{"text":"¿ar an-obelogedgi be binsadode?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Be ebinsao, igi sianar napsagi soblege, deyob be-sunnagwad be an-sobsad.","poem":1},{"text":"Degite, ¿gannar napsaga be an-obinyebalode?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"¿Moli-nunis-owirmaklegedyob be an-imaksasursi?","poem":1},{"text":"¿Moli-nunis-gwamaklegedyob be an-imaksasursi?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bee be, anga sanmar nasiksad.","poem":1},{"text":"Bee be, anga ukamar enirisad.","poem":2},{"text":"Ar bee be, an-garmar gwadisad.","poem":1},{"text":"Bee be, anga an-san-dubagan mesisbalid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Burba-dulad be anga uksad,","poem":1},{"text":"be-sabguedi be anga oyosbalid.","poem":2},{"text":"Degine, be nue-an-akwisbalid,","poem":1},{"text":"be an-niga ogannosbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"” ’Degi-inigwele, ibmar-soggwendi be angi odukusad.","poem":1},{"text":"Ar an wisid, be weyob binsadigusad:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Angi be nakuledii gusad,","poem":1},{"lineBreak":true},{"text":"abakale an begi isgunonikirye.","poem":1},{"text":"Ar an isgunonikile, be baisur-dakosulid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"An nue-isgunonikile, an dule-wiles.","poem":1},{"text":"Ar an isgussur-daklenonikile, amba geg an weligwar itoged.","poem":2},{"text":"Nue-binged-dummad angi naid.","poem":1},{"text":"Nunmakedba-an-galitodiid nue magar an na itodiid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"An gwisguye-sogele, achumiguryob be anbina melleardaed,","poem":1},{"text":"be-gargangued be angi oyononidaed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Be-isdar-itoged aka angi barbulomaid,","poem":1},{"text":"dule-angi-yolemalad aka be gatik amisbalid.","poem":2},{"lineBreak":true},{"text":"Be-sordamar angi ukin-ukin yolenanaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"” ’¿Ar ibiga gwalulegega be an-imaksa?","poem":1},{"text":"Bur an burgwisana gadinad, adi, dule bar an-dakosulinad.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bur an gudisulina gadinad,","poem":1},{"text":"an burgwar-aidenonikina gadinad, adi, yog-diglegar an guoenad.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"¿Ar an-ibagande bergued-mossursi?","poem":1},{"text":"Degisoggu, mer bar be anse gole.","poem":2},{"lineBreak":true},{"text":"An nasokalid-idu napi an wis-yeer itodigweled.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Emide an-nasokalid, bar an dagegarsulid.","poem":1},{"text":"Negsichidse an naesokalid.","poem":2},{"lineBreak":true},{"text":"We-an-naesokalidi, bar an aibiregarsulid.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Neg-gubyagwaledse an naesokalid,","poem":1},{"text":"neg-gagalesnaidse an naesokalid.","poem":2},{"lineBreak":true},{"text":"Amba neg-meegwad-negsichidyob-daklegedse, an naesokalid.’ ”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/9.json","previousChapterAudioLinks":{},"numberOfVerses":22}