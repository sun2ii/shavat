{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":11,"content":[{"type":"heading","content":["Zofar-sunmaknaid"]},{"type":"verse","number":1,"content":["Naamat-neggweburgined-Zofar Jobʼga sunmakded, ega sogded:"]},{"type":"verse","number":2,"content":[{"text":"“¿Ar be we-ibmar-sognaidi, abin-imaklegosurde?","poem":1},{"text":"¿Ar we-dule gadi-sunmakedba, nodisuliyob daklegode? Sulirgebed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"¿Bela-we-ibmar-soglesad-abin anmar gaya-maklegode?","poem":1},{"text":"¿Dule-be-abin-imakosulidba emargi-dodogoye be soge? Gege be emargi dodoged.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Emide, be soged: ‘An-ibmar-soged innikigwadye,","poem":1},{"text":"Bab-Dummad-asabinni an ibmar-oakalossurye.’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bitigi Bab-Dummad begi gwichigunonikina gadin.","poem":1},{"text":"Bitigi begi sabsur-sunmaknonikina yeerban,","poem":2},{"lineBreak":true},{"text":"yeer an be-daksaled.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ar Bab-Dummad binsaed-nikadba bega ibmar sogoed.","poem":1},{"text":"Ar we-igar-dukuarmamaid akusunna itoleged.","poem":2},{"text":"Agi, be geb magar Bab-Dummad-be-odurdaknaidi, be itosaled,","poem":1},{"text":"be-isguedba bur bule, be odurdaklegewilubbinye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"”¿Sunna be Bab-Dummad-e-ibmar-burbar-mamaid wisguosi?","poem":1},{"text":"¿Sunna be Bab-Dummad-Bela-Gangued-Nikad-ibmar-wisiyob be guosi? Gege be deyob gued.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ar Bab-Dummad-e-binsaed, nibnegba obined,","poem":1},{"text":"degite, ¿igi be wisguega imakosunna?","poem":2},{"text":"Bab-Dummad-e-binsaed yaa-matusulidba obined.","poem":1},{"text":"Degite, ¿igi be e-binsaed wisguosunna?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Deginbali, Bab-Dummad-e-ibmar-burbar-mamaidi, napneg-naidba bur dummadid,","poem":1},{"text":"demar-matasuid-naidba bur bipisulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Ar Bab-Dummad esgaryase be-metedibe,","poem":1},{"text":"degine, igar-nabogega bese gollarbardibe,","poem":2},{"text":"¿doa ega sogoe, mer deyob be imakye?","poem":1},{"text":"Dule geg ega soged.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar Bab-Dummadi dule-yardakdimalad magasar daked,","poem":1},{"text":"degine, e-ibmar-isgana-imaked baisur-dakosulid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Moli-uayasuid-sapurbalidgine dule gwalulenonikile,","poem":1},{"text":"geb dule-binsaedsulidaedi, binsaed-ibedga guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”Ar Bab-Dummadga be gwage ukele,","poem":1},{"text":"be-argan ese be onakwele,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ibmar-isgana-imaksadgi be banguele,","poem":1},{"text":"geb be-neguyagi ibmar-isgana be osulobalile,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"be bar bingeguosulid,","poem":1},{"text":"bar be dobgudii guosulid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Naibid-itodigusadgi bar be binsaosulid,","poem":1},{"text":"ukiagwar-ibmar-gusayob be itogoed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Neg-ibegwar-naiyob bega neg nagunonikoed, weligwar be itononikoed.","poem":1},{"text":"Negsichidi, bolegoe neg-ainakwiardaeyobi bega mee nagunonikoed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ar be bendaklegoed-wissoggu, be Bab-Dummadgi bensuli-gudii guoed.","poem":1},{"text":"Bab-Dummad be-dikarba bega nakuledii guoed,","poem":2},{"lineBreak":true},{"text":"degidbali be nue-gabdii guoed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Dule gwen bar be-ogwayedii guosulid, nued be obunnodii guoed.","poem":1},{"text":"Deginbali, dulemar bese wilenonimarbaloed.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dule-isganamardina wakinnosulid.","poem":1},{"text":"E-ibyamar bela akitoed.","poem":2},{"lineBreak":true},{"text":"Unnila burgwed-edarbedimalad.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}