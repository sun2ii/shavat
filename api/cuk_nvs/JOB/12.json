{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":12,"content":[{"type":"heading","content":["Job, Zofar-abin-imakdemogad"]},{"type":"verse","number":1,"content":["Agine Job, Zofarʼga weyob sogded:"]},{"type":"verse","number":2,"content":[{"text":"“Ar bemar odurdaked-sailaye be sogmarsunde.","poem":1},{"text":"Ar bemar burgwidele, ¿bemarba binsaed-nikaa-dalegedi burgwidmosunnode?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"An bemaryobi binsaed nikamogad, gwen be angi obinsurmalad.","poem":1},{"text":"Ar bemar-ibmar-sogsamaladi, ¿doa we-ibmar wissur be ebinsae? Bela wismala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"”Gebeunni an Bab-Dummadse-gotele, Bab-Dummad an-abin-imakdaenad.","poem":1},{"text":"Emigindina, aka an-aimar-oallega an guded.","poem":2},{"lineBreak":true},{"text":"An ibmar-oakalossulin-inigwele, aka an-aimarga an dodogedga guded.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dule-gwen-boni-itodisurmaladi weyob sogdemalad:","poem":1},{"text":"‘Dule-boni-itodiidi mer bai be dake,","poem":2},{"lineBreak":true},{"text":"dule-aimukubi-gudiid gatik be egee imake.’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dule-ibmar-atursamaladi, e-negyagi na yeer itodimalad.","poem":1},{"text":"Ar wemar Bab-Dummad-ourwedimaladid,","poem":2},{"lineBreak":true},{"text":"Bab-Dummad-gege-anmar-oakaloye, sogdimaladid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"”Ibdurganse be ibmar egismalana,","poem":1},{"text":"ar wemar bemar-odurdaksamalaled.","poem":2},{"text":"Sikwimarse be ibmar egismalana,","poem":1},{"text":"ar wemar bega ibmar sogsamalaled.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Napneg-naidbogwa be sunmakena,","poem":1},{"text":"ar we bemar-odurdaksaled.","poem":2},{"text":"Demargi uamar-bukwadbogwa be sunmakena,","poem":1},{"text":"wemar bemarga ibmar sogsamalaled.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ar wemar Bab-Jehová-bela-ibmar-imaksad,","poem":1},{"text":"bela wismalad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Dummadgine, bela burba-dulad siid.","poem":1},{"text":"Bab-Dummadgine, bela dule dula-gued siid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar uaya, ibmar-goled magar itoged,","poem":1},{"text":"degi, gwabin, ibmar-igi-gulleged magar itoged.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Deginbali, dule-selebagus-gudimaladi, magasar neg-itomalad,","poem":1},{"text":"binsaed-ibegan nanamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”Ar Bab-Dummaddi bur bule binsaed-nikaa gued.","poem":1},{"text":"Abi gargangued bur bule nikabalid.","poem":2},{"text":"Binsaed-nued-ukleged Bab-Dummadgadbiid,","poem":1},{"text":"degine, magar-neg-itoleged egadbibalid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ar Bab-Dummad ibmar-earisale, dule-wargwensaale bar sobosulid.","poem":1},{"text":"Ar Bab-Dummad esgaryagi dule-metele, dule-wargwensaale gege bar onoged.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ar Bab-Dummad dii-owisulile, bela ibmar dingudeled.","poem":1},{"text":"Ar dii-owierdi, bela neg-dogdebaliled.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bab-Dummadgine gargangued maid,","poem":1},{"text":"degine, binsaed-nikagued egi danibalid.","poem":2},{"text":"Bab-Dummadgi-siid, emar-yardaked,","poem":1},{"text":"degi, dule-emarse-yardaklediid, igi imakoe.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ar Bab-Dummadi dule-binsaed-ibedmar-obingegsaed,","poem":1},{"text":"degine, dule-igar-nabomalad suli-suli obinsabalid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bab-Dummad, reymar-ibe e-negsemamaid osuloged,","poem":1},{"text":"degine, rey maiga imakbalid.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bab-Dummad dule-irwa-Bab-Dummadse-gormalad-obingegsaed,","poem":1},{"text":"degine, dule-bulegan-surbinsa-itogega imakbalid.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bab-Dummad dule-binsaed-dakmalad-e-gaya-maked,","poem":1},{"text":"degine, girmar-dummagan-binsaedsuli imakbalid.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bab-Dummad dule-nuga-nikamalad-obingegsaed,","poem":1},{"text":"degi, dule-gandik-gudimalad gargangued-sate imakbalid.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bab-Dummad ibmar-yaa-matusurmaladgi-bukwad magar-dakle imaked,","poem":1},{"text":"degine, negasichidgi ibmar-bukwad magar-daklegega imaked.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bab-Dummad neggwebur-merguega imaked,","poem":1},{"text":"neggweburmar obelobalid.","poem":2},{"text":"Bab-Dummad neggweburmar-oambikuega imaked,","poem":1},{"text":"neggweburmar-aisakiega imakbalid.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bab-Dummad dule-dummagan-yar-sedimalad-ibe e-binsaed-oburega imaked.","poem":1},{"text":"Degidbali, negsulidganba-gudiiyobi imakbalid.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Negsichigangi-unimakdiiyobi imaked,","poem":1},{"text":"mummuganyob banamakdiiyobi imaked.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}