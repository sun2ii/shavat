{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":13,"content":[{"type":"heading","content":["Job san-bendakded"]},{"type":"verse","number":1,"content":["Job sogdebalid:",{"text":"“Bela bemar ibmar-sogsamaladi bato an itosad,","poem":1},{"text":"bato an we-ibmar daksad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ar bemaryopira an wismogad,","poem":1},{"text":"gwen be angi obinsurmalad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bur an Bab-Dummad-Bela-Gangued-Nikadbogwa an sunmakbied,","poem":1},{"text":"Bab-Dummadbogwa an-igar bur an nudakbied.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ar bemardi unnila gakansamaladid,","poem":1},{"text":"ina-durgan-ibmar-wissurmaladyobi be gumalad, gwen an-bendaksulid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ar bemar wis boo ambikuele,","poem":1},{"text":"degidba, bemar binsaed-nikagued oyosmalaled.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Emisgindi, nue an-sunmaked itomalo,","poem":1},{"text":"an-ibmar-bega-soged-nikad be itomarmogo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"¿Bemar Bab-Dummad-nuggi gakansaode?","poem":1},{"text":"¿Gakansaedgi bemar Bab-Dummad-bendaknaimarye sogode?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"¿Ar bemar ega ibmar-nued imaknaiye binsasunde?","poem":1},{"text":"¿Ar bemar Bab-Dummad-bendakmaladye sogmarsunde?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ar Bab-Dummad bemar-wilubdaknonikile, ¿igi be gusmalale?","poem":1},{"text":"Ar bemar dulemargi-dodolegeyob, ¿Bab-Dummadgi be dodomarye sogmarsunde?","poem":2},{"lineBreak":true},{"text":"Gege bemar Bab-Dummadgi dodoged.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ar bemar arbakee dule-wargwenbi bendakbigualile,","poem":1},{"text":"Bab-Dummad bemargi sabsur-gwichigusaled.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar Bab-Dummad-e-gargangued-yeerdakleged be-ogwayenonimalaled.","poem":1},{"text":"Bemar e-abinni bela-belad gwayidmalaled.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ar bemar binsaed-nued-nika-sunmakedi binsaledid,","poem":1},{"text":"bemar-ibmar-sognaidi gwen gangued nikasulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”Mer bar sunmakmala, an sunmakmogwelo.","poem":1},{"text":"Ar igi an-guoe, ar deyob an guodo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ar an naibigubier, an naibiguodo,","poem":1},{"text":"bar san-bendaklegedgi an binsasulid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ar Bab-Dummad an-oburgwebiele, an-oburgodo.","poem":1},{"text":"An bendaklegodeeye, bar an binsasulid, bato an bela gudiid.","poem":2},{"lineBreak":true},{"text":"Unnila Bab-Dummad-asabinni, an-gudiid na barsogoed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ar Bab-Dummad na e an-bendakoedid.","poem":1},{"text":"Ar dule-isganadi, Bab-Dummad-asabinni gwen gwisgunonikosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"”An-binsaed nue itomalo,","poem":1},{"text":"an-ibmar-sognaid be nue itomalo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"An-sunmakoed bato guakwaa an ilemaksad.","poem":1},{"text":"Bato an wisid, Bab-Dummad ibmar-oakalossuli an-daknonikoed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ar dule-angi-yoleged-nikardina, bar an golosurdo,","poem":1},{"text":"an burgwed-edarbesunnodo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"”Bab-Dummadye, ibmar-sogbo an bese egised.","poem":1},{"text":"Ar we-ibmar be anga ukele, an bar begi dukuosulid:","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Soggwengi: Mer bar be sabsur-an-odurdako.","poem":1},{"text":"Sogbogi: Mer bar be sabsur-an-ogwayo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Na san-bendakegala, be-asabin-gwisgudagega be anse gole,","poem":1},{"text":"adi, nabir an be-asabin sunmakoed.","poem":2},{"text":"Be anse gorsulile, an-inse an bega sunmakodo,","poem":1},{"text":"geb bee be an-abin-imakoed.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Be anga soge, ibugi an begi isgusa, ibu ibmar-isganamar an imaksa,","poem":1},{"text":"biti-be-igargangi an annasa, ibugi an begi yoledii gusa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bab-Dummadye, ¿ar ibiga be angi dukue?","poem":1},{"text":"¿Ar ibiga be-isdaradyob be an-dake?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ar andi gagan-dinnagana burwaba-seledaedyob gued.","poem":1},{"text":"Degisoggu, ¿ibiga be an-obelobisunna?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Emide be, nunmaked-dummad-itogega be an-imaknaid.","poem":1},{"text":"Sapingwaun an ibmar-isgana-imaksad-ular, ¿deyob be an-imaknaisunde?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Sepo-yaba be an-nag-odosad.","poem":1},{"text":"Bia an nadesogele, bela be angi nakuleged,","poem":2},{"lineBreak":true},{"text":"an-nag-gannarmarba be angi nakulediid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"”Dule urgo-nunguddaeyob berguddaed,","poem":1},{"text":"mor udubiin-gusar-bergudaedyobi, dulemar berguddaed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}