{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":14,"content":[{"type":"heading","content":["Job sikwas-gudiguedgi sunmaknaid"]},{"type":"verse","number":1,"content":["Job sogdebalid:",{"text":"“Dule gwalulenonikile, unnila sikwas gudii gued,","poem":1},{"text":"ar bonigandi bukidar daed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dulemar dutumaryobid.","poem":1},{"text":"Dutumar argadele, bato dinguddaed,","poem":2},{"text":"debayobi, dulemar gued.","poem":1},{"text":"Sikwas-negsichid-nagunonidaeyobi, dulemar berguddaed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Dummad, ¿be deyob duledaedgi ataknasunde?","poem":1},{"text":"¿Be-asabin-igar-nabodagega be anse gornasunde?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Degite, ¿ar doa ibmar-nued, ibmar-isganagi onogoe?","poem":1},{"text":"Gege dule deyob imaked.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dulega ibagan-bergued bato sogles maid,","poem":1},{"text":"bee be, bato ega niiwarbigwa-wilub-gudiguega ega ibagan mesisad.","poem":2},{"text":"Degisoggu, gege a-ibagan-obicha gudii gued,","poem":1},{"text":"ar deyob be imaksad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mer bar egi be nakulege, ies be sae,","poem":1},{"text":"na e-arbadiid-manigi wergudii be imakgwele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"”Ar sapimarbela amba siklesale, gannar ainiardaed,","poem":1},{"text":"degi, e-anagan dunguddaed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ar sapi-e-malimar nungumai-inigwele,","poem":1},{"text":"e-saila nungumai-inigwele,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"egi dii-aryoderdi, gannar sunna durgued.","poem":1},{"text":"Sapi-gebe-diglesadyob e-anagan ainiardaed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ar duledina, burgwisar bar daklegosulid.","poem":1},{"text":"Ar dule burgwisale, ¿bia nadoe?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar igi demar dinguddae,","poem":1},{"text":"degine, igi diwar dinguddabali,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"deyob dulemar berguddaed,","poem":1},{"text":"bar gwisgusurdamalad.","poem":2},{"text":"Ar mogir-arad-naid-berguedsega, geb dule-burgwismalad gwisgumaloed.","poem":1},{"text":"Dule-burgwismalad e-gabmamaidgi geb atakdemaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”Be-urwemaid-berguedse neg-uangi be an-odukuena yeerban.","poem":1},{"text":"Bitigi an-ebinsaega be ibagan nasikena yeerban.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dule burgwisale, geg bar gannar durgued.","poem":1},{"text":"A-ulale, an-bendakleged-iba an bane-bane edarbedii gusaled.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Geb agi be anse gornonikoed.","poem":1},{"text":"An be-abin-imaknonikoed.","poem":2},{"text":"Ar bee be, an-obinnisadsoggu,","poem":1},{"text":"be yeer an-daknonikoed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Be an-gudiid emi be daked,","poem":1},{"text":"an-isguedgindi bar be binsassulid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ibmar-sagugi-ise-atinnar-melleddaedyobi, be an-isgued dikasuli meted.","poem":1},{"text":"An-isgumalad bela be anga elisad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"”Ar igi yar-dummad-mamaridele, akwamar-babatidele, baidsik ambakusdae,","poem":1},{"text":"deyobi, be dule-e-ibmar-edarbediid be imaked.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ar igi-diimar akwamar-sabsursae,","poem":1},{"text":"deginbali, diwar-dummad-nomaile, bela ese ibmarmar ebipilege,","poem":2},{"lineBreak":true},{"text":"deyobi, dule-ibe e-bendakleged be osuloged.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bela-bela be we-dule oitoged,","poem":1},{"text":"be we-dule-obelogega imaked,","poem":2},{"text":"bar e-wagar-daklesuli be imaked.","poem":1},{"text":"Deyob, be we-dule neg-uanse barmeted.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ar e-mimmigan-nug ogannolenaile, we-duledi gwen bar wisguosulid.","poem":1},{"text":"Ar e-mimmigan mesagwar-imaklenaile, we-duledi gwen wisguosulid.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Unnila e-san-nunmakedbi itoged,","poem":1},{"text":"na e-nunmakdiidbali, wile-itodiid.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}