{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":15,"content":[{"type":"heading","content":["Elifaz, Jobʼga-sabsur-ibmar-sogded"]},{"type":"verse","number":1,"content":["Geb agine, Temánʼgined-Elifaz, Jobʼga weyob sogded:"]},{"type":"verse","number":2,"content":[{"text":"“Dule-binsaed-ibedi yogasaar sunmaksulid.","poem":1},{"text":"Dule-binsaed-ibed yogasaar urwesulid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dule-binsaed-ibedi, dule-baidbo abin-abin-imaknaidgine, yogasaar sunmaksulid.","poem":1},{"text":"Dule-binsaed-ibedi, igar-nudakedgi sunmaksuli gusulid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bedina, aka be Bab-Dummad-dobekwaa-nanaedi obelonaid.","poem":1},{"text":"Aka be dule-bamalad mer Bab-Dummadse-golega imaknaid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Be-sunmakedi be-isguedba be sunmaknaid,","poem":1},{"text":"dule-galagwensulidamaladyobi be sunmaked.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Be-sunmakedi dukin begi yolenaid, andi begi yolenaisulid.","poem":1},{"text":"Be-gwabin-duku dukin be-wioged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"”¿Be-inse gwalules be itoge?","poem":1},{"text":"¿Yarmar-nanaid-idu, be-inse gwalules be itoge?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"¿Bebi binsaed-ibed be itosi?","poem":1},{"text":"¿Bab-Dummadde bese binsaed egissi?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anmar bela be-ibmar-wisidi wismogad,","poem":1},{"text":"bela be-ibmar-magar-itogedi anmar magar itomogad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Anmar-abargine dadagan bukwad,","poem":1},{"text":"be-babba bur selegan nanaed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"¿Bab-Dummad gadi-gadi be-gwage-imaked be baisurdaksunde?","poem":1},{"text":"¿Bab-Dummad bega binnalegwadgi sunmaked be baisurdaksunde?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"¿Ibiga be surbinsa urwed-itoge?","poem":1},{"text":"¿Ibiga be urwakwaa atake?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"¿Ibiga be Bab-Dummadse urwe?","poem":1},{"text":"¿Ibiga egi be yogasaar sunmake?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"”¿Igi-dule na ibmar-oakalodisurye sogosunna?","poem":1},{"text":"¿Doa nodisurye sogosunna?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bab-Dummad e-nug-odummodimaladginbela bengued,","poem":1},{"text":"amba nibnegbela swilidik daksulid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dulemarginbulesunna, e-abin swilidikidsulid.","poem":1},{"text":"Duledi, gobedbinagudiiyobi, isguedbina gudiid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"”Job, nue be an-itogo, an bega ibmar soggwelo.","poem":1},{"text":"An-ibmar-daksad an bega sogesokalid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"We-ibmar dule-binsaed-ibegan anmar-odurdaksadi,","poem":1},{"text":"na e-babganba durdaksamaladid.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Agala, Bab-Dummadi a-dulemarga yala uknonikid.","poem":1},{"text":"Dule-ainebarmalad a-yargi eba bukwa gussulid.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dule-isganadina, bane-bane nunmakedba-gar-itodii gudoed,","poem":1},{"text":"degine, dule-sabsur-emar-imakdiidgala, e-ibagan-bergued bato sogles naid.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Dule-isgana ibmargoled-emar-ogwayed itoged,","poem":1},{"text":"degine, na bogidik-gudiidgine, dule-atursamalad egi gwisgunonikoed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Dule-isgana negsichidgi-wakinnodeeye gwen binsasulid,","poem":1},{"text":"es-suidse-ibitogoed ega igar maid.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Igar-wissuli garmakdiid, mula-masga-guega gudiid.","poem":1},{"text":"Dule-isgana e-oburgwileged-ibagan-mosad na wisid.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Wileged-dummad, suli-suli-itoged, bela-bela dobe-itogega imaked.","poem":1},{"text":"We-ibmarmala, rey-egi-yolesokaliyob itoge imaked.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ar Bab-Dummadgi ise-urwar argan-oyonai-gusad-ulale,","poem":1},{"text":"na san-bule-bule Bab-Dummad-Bela-Gangued-Nikadga imaknai-gusad-ulale,","poem":2},{"lineBreak":true},{"text":"ede na dobe itodiid.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ar dule-isgana Bab-Dummad-asabin ise-urwar gunaigusad,","poem":1},{"text":"ar Bab-Dummad-ourwega, sigu-abgaed-sommed urwedgi ega oyonai gusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"”Ar dule-isgana amba wagar-dukwa-dukwa-nika-inigwele,","poem":1},{"text":"degi, saban-dummad-inigwele,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"neggwebur-ayaraledgi mai guoed,","poem":1},{"text":"negmar-ollo-ollo-siidgi gudii guoed,","poem":2},{"lineBreak":true},{"text":"negmar-aimukudanimaladgi mai guoed.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"We-dule-isgana, bar ibmar-ibedga guosulid,","poem":1},{"text":"e-ibmar-nuegan-nikadi bela e-ibe bergudoed,","poem":2},{"lineBreak":true},{"text":"e-nainumar, bela e-ibe surgudbaloed.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Burgwedgi wakinnosulid, sapi-gannar-ainiardaed soogi-gummakeyob guoed.","poem":1},{"text":"Ar Bab-Dummad unnila e-bunnogedgi we-dule-obelogoed.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Dule-isgana, ibmar-baisurmaladgi-yardaklediid iege,","poem":1},{"text":"ibmar-baisurmaladgi-bengudisulid iege.","poem":2},{"text":"Ar we-ibmarmargi gwen ibmar-nued amiosulid,","poem":1},{"text":"we-ibmarmar, binsaledid.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Igi sapi e-sikleged-ibagan-idu sikleddae, e-anagan aramakosuli sikleddae,","poem":1},{"text":"deyob, we-dule-isgana burgwidoed.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Igi uva-dub-e-san, amba yoo-nue-gue batiddae,","poem":1},{"text":"degi, igi olivo-sapi e-durbamar-ainissuli berguddae,","poem":2},{"lineBreak":true},{"text":"deyob, dule-isgana bergudoed.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Degidbali, dule-isganamar e-anagan nikuosulid,","poem":1},{"text":"degine, manigi-emar-binsaed-gamaladdina, e-neguya bela soogi gummakoed.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Dule ibmar-isgana-imakedgi-binsaed, ibmar-isgana imaknonikoed,","poem":1},{"text":"e-gwagegi unnila emar-yardakedgi binsadiid.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}