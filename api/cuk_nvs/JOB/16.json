{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":16,"content":[{"type":"heading","content":["Job e-aimar-abin-imakded"]},{"type":"verse","number":1,"content":["Job Elifaz-abin weyob sogded:"]},{"type":"verse","number":2,"content":[{"text":"“We-ibmar bukidargus an weyob itodanikid,","poem":1},{"text":"bemar-ibmar-soged gwen an-bendaksulid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"¿Ar bemar-yogasaar-sunmaked geg bergumarsi?","poem":1},{"text":"¿Ar ibiga geg bemar an-ies imakmala?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ar bemar an-gunaiyob be gunanaimogana,","poem":1},{"text":"an bemarga deyob sunmaksamogaled.","poem":2},{"text":"An bemargi-yolelega, gaya-nueganbi bemarga sunmaksamogaled.","poem":1},{"text":"Bemar-wiledakeyob an bemarga nono-ege-ege imaksabaliled.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"An-sunmakedgi an bemar-ogannosmalaled.","poem":1},{"text":"Bemar ibmar-nunmak-itodimaladi, an-sunmakedbali gadi-gadi be itosmalaled.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"”Ar an sunmaknaid gwen an-bendaksulid,","poem":1},{"text":"ar gwen anga ibmar-nunmak-itonaidi osulosulid,","poem":2},{"lineBreak":true},{"text":"ar an sunmaksurbalile, gwen anga surgusurbalid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Dummad napiragwadba an-obelosad,","poem":1},{"text":"an-neguyaginmaladse-bakale bela obelosad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Dummadse nue an galesgunaid, nue angi yolesgunaid.","poem":1},{"text":"An-uka-dunnumakega an-ibe imaksad, degisoggu, garagus an dakleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"”Bab-Dummad nue anse urwed, an ese balegillenaid, nue-ibitos itoleged.","poem":1},{"text":"Achu-angi-nugar-oyonaiyob gunaid, e-isdaradga an-imaksad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"An-isdarmalad angi dododmalad, an-wagar ogotemalad.","poem":1},{"text":"We-dule-isdarmalad buladik angi yoledmalad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Dummad dule-isganamarse-ibitogega an-imaksad,","poem":1},{"text":"dule-gakansamaladse ibitogega an-imaksad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iduardina, an bogidik gudiinad,","poem":1},{"text":"emisgindi, Bab-Dummad nue an-wiosad,","poem":2},{"text":"dukar-walaba an-ganonikid, saga-saga an-imaksad.","poem":1},{"text":"Bela-bela angi yolenonikid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"E-sigu-mimalad nue an-ebirisad,","poem":1},{"text":"e-sigumar, an-sabangi sabe-sabe-yolenonisulid,","poem":2},{"lineBreak":true},{"text":"bela an-samurmar, napase yaarmakded.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bia an naibigusa, agi gannar angi yolenonidaed,","poem":1},{"text":"bila-onoged-duleyob angi gwisgunonikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"”An-naibi-itodiid-oyogegala, an wile-itoged-mor-yonai gualid.","poem":1},{"text":"Napayala an gudii gualid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"An boedba an-wagar ginnitibigusad,","poem":1},{"text":"an-ibyamar-dakleged guduregus dakleged.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Degi-inigwele, an dule-emar-sabsur-imakedsulid,","poem":1},{"text":"Bab-Dummadse innikigwadgi an gordiid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"”Ar an burgwenonisundibe,","poem":1},{"text":"napnega, an-ibmar-oakalossulid-barsognai gusana gadin.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ar dule-an-barsogoedi nibneggi maid.","poem":1},{"text":"Nibneggine, dule-an-ular-sunmakoedi maid.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ar an-ai an-irwa-goledid,","poem":1},{"text":"an an-ai-asabin ise-boar an gunaid,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"adi, an-ai an-ular Bab-Dummadse golegar.","poem":1},{"text":"Ar igi dule na e-ai-bendakega sunmake,","poem":2},{"lineBreak":true},{"text":"deyobi, an-ular sunmakegar.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bar an birga-suitii naosulid,","poem":1},{"text":"an-burgwed-ibagande, bato mosad.","poem":2},{"lineBreak":true},{"text":"Gwen an bar aibirosulid.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}