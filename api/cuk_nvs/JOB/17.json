{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":["Job sogdebalid:",{"text":"“Napi an iche-iche bunnomaid,","poem":1},{"text":"an-ibagande nue-bergudanikid,","poem":2},{"lineBreak":true},{"text":"neg-uan bato an-edarbemaid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dule-emargi-dodomaladbi unnila an-ebiris-gunanaid,","poem":1},{"text":"emide, a-dulemarbi an dakdisunnad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"”Bab-Dummad, be an-ular mani-bennukega be an-bendakdage.","poem":1},{"text":"¿Ar doa bar an-bendakdagosunna?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Dummad, we-dulemar-ibe be ebinsaed oburusad.","poem":1},{"text":"A-ulale, amar nakwegala be imakosulid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ar dule manibina e-ai-urmakdibe,","poem":1},{"text":"na e-mimmigan-burgwed daknonikoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"”Bab-Dummad, dulemar-angi-dodogar-sunmakega be imaksad,","poem":1},{"text":"aka an-wagargi-wiiakmalaga be imaksad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ibmar-nunmakedba bar an nue ataksurgusad,","poem":1},{"text":"bela an garbigus dakleged.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dule-nuegan an-dakalile, geger an-dakardamalad.","poem":1},{"text":"Degidbali, we-dulemar dule-isganamargi uluddamalad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Degi-inigwele, ar dule-innikidaedi, e-gudiidbali, bur nued gudii guoed.","poem":1},{"text":"Dule-ibmar-oakalossulidi, bur bule gangumaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”¡Dagmala! Anse gatik gwisgudamala.","poem":1},{"text":"Ar an wisid, ar bemar-abargi dule-binsaed-ibed gwen gudisulid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"An-bergued-ibagan nue-walikgusad,","poem":1},{"text":"an-ibmar-abeged gwen anga gusulid,","poem":2},{"lineBreak":true},{"text":"degine, an-ibmar-imakoye-sogsad, gwen anga gusurbalid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"We-dulemar neg-mutikid neg-ibginedyob dakdamalad.","poem":1},{"text":"Amba neg mutikile, sogdedamalad, neg oibodaniye.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"¿Ibu bar an edarbosunna?","poem":1},{"text":"Unnila napa-yaba-dogedbi an napid,","poem":2},{"lineBreak":true},{"text":"negsichidgi an mai guoed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ar neg-uan an-babga guoed,","poem":1},{"text":"nusmar an-nanga, an-gwenadganga gunonimogoed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Degisoggu, ¿bia bendakleged-igar an amiosunna?","poem":1},{"text":"¿Bia ibmar-nued bar anga danikosunna?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"An ibmar-nued-edarbediid anba bergudoed,","poem":1},{"text":"anba napaga gudmogoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}