{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":18,"content":[{"type":"heading","content":["Bildad, dule-isganamargi sunmaksad"]},{"type":"verse","number":1,"content":["Degine, geb Bildad Súah-neggweburgined, Job-abin-sogded:"]},{"type":"verse","number":2,"content":[{"text":"“¿Sana be sunmaked bogilegoe?","poem":1},{"text":"Binsaed-nikaa be sunmakena, anmar nuedgi sunmaksaled.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"¿Ibiga ibdulamaryob be anmar-dake?","poem":1},{"text":"¿Ibiga binsaedsurmaladyob be anmar-dake?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ar be urwed doggussoggu,","poem":1},{"text":"abali, na be dukin wionaid.","poem":2},{"text":"¿Ar degidbali, napaneg swiri naguoye be binsasi?","poem":1},{"text":"¿Ar be-sogedba akwamar ainiroye be binsasi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"”Ar dule-isganamar-e-gwallu akitoed,","poem":1},{"text":"e-soo-gaedi baligaosulid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dule-isgana-e-neguyagine neg sichiledoed,","poem":1},{"text":"e-gwallu-gasiid akitoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dule-isgana gandikidba-nanaed bergudoed,","poem":1},{"text":"degine, e-igar-mesisadgi dukin yardaklegoed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Na e-nanadiidba dukin yardakledii guoed,","poem":1},{"text":"dukin e-sakigi galenai guoed,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"e-nagmatarba galegoed,","poem":1},{"text":"egi bar noosulid, bela egi apurnai guoed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dule-isgana-iduale, napagi dukuar dub bukwad,","poem":1},{"text":"adi, nadapile, egi galegegar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dule-isganaga neg-gwayed nagunonikid,","poem":1},{"text":"gwayed eba sorba gudiguad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bonigan-egi-yoleged bogigunaisulid,","poem":1},{"text":"dule-isgana ukudba belagus nadapid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"E-ukamar, boniganse ibitonaid,","poem":1},{"text":"e-arganmar, e-nagmar, burgwedanikid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dule-isgana na neguyagi-baisur-binsadiid bergusad,","poem":1},{"text":"emisgindina, burgwed-igarse nadapsunnad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Dule-isgana-e-neguya, soo-sailase bela ibitosad.","poem":1},{"text":"E-ibmar-nikadi, soo-azufreʼse bergusad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Igi sapi-saila, e-malimar, e-anagan, dinguddae,","poem":1},{"text":"debayobi, dule-isgana gued.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"We-napneggi bar dule-isganagi binsalegosulid,","poem":1},{"text":"e-nug-dummarba-megisad bela bergunonikoed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Dule-isgana neg-meegwadgi-gudiidi, negasichidse barmelledoed,","poem":1},{"text":"we-napneggi-gudiidgi ononnolegoed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Dule-isgana na e-neggweburgi mimmigan, gwen obegosulid,","poem":1},{"text":"e-gudigusadgi, gwenadgan gwen obegosurbalid.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dulemar dad-nakwedsik-bukwamaladi, degine, dad-argwanedsik-bukwamaladi, dule-isgana-deyob-gusad geger itomaloed.","poem":1},{"text":"Degisoggu, gwayed egi nagunonimaloed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Weyob dule-isgana bergued,","poem":1},{"text":"dulemar-Bab-Dummad-akudakdimalad weyob bergued.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}