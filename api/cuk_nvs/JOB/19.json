{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":19,"content":[{"type":"heading","content":["Job, ibmar-oakalossurye-egi-sogleged abeged"]},{"type":"verse","number":1,"content":["Degidbali Job, Bildad-abin-imakded. Weyob sogded:"]},{"type":"verse","number":2,"content":[{"text":"“¿Sanagwadse bemar an-wionai guoe?","poem":1},{"text":"¿Sanagwadse bemar angi-sunmaknaid indakmaloe?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bemar angi gannar-gannar yolenanaidi,","poem":1},{"text":"¿bemar bingesurmarsi?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ar an nue-isgusye soglegele, angi siido,","poem":1},{"text":"an na wargwen gunaid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bemar bur anba dule-nuedye sogmarsunde,","poem":1},{"text":"emide, an-isgusadba be angi dododmalad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bemar wisgumalargebed, Bab-Dummad weyob an-imaknaid,","poem":1},{"text":"ar Bab-Dummad e-sakigi an-gasa gunaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"”Aisaar an binnasuli gornainad: ‘¡An-oburgwebimarye!’","poem":1},{"text":"Dule-wargwensaale, gwen an-itosulid.","poem":2},{"text":"An bendakleged egisnai-inigwele,","poem":1},{"text":"gwen an-bendaksurmalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Dummadi an-idu igar edusad,","poem":1},{"text":"gege bar an obake gusad.","poem":2},{"lineBreak":true},{"text":"An-nanaedbali negasichidbi an-idu nasiksad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Dummadi, an-ibmar-bukidar-nikadi bela an-ibe sunonikid.","poem":1},{"text":"An-nug-dummarba-gued bela an-ibe obelononibalid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sapiyobi, bela an-obelosad.","poem":1},{"text":"An-ibmar-edarbediid, sapi-e-saila-bergusayobi an-ibe obelosad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Dummadi nue angi dummad-urwenaid,","poem":1},{"text":"e-isdaradga an-imaksa gunaid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bela e-bila-onomalad an-ebiris ambikunonimalad,","poem":1},{"text":"an-dordoneg-ebiris bukunonimalad.","poem":2},{"text":"Napa-arsanyob-nakwemai sobsamalad","poem":1},{"text":"degi, angi gwisgunonimalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”Bab-Dummadi an-gwenadgan-angi-banguega imaksad,","poem":1},{"text":"an-aimarse-bakale, angi bangudmalad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"An-gwenadgan an-iedmalad,","poem":1},{"text":"dule-magar-an-dakdimalad an-iedmarmogad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"An-neggi-gudimalad aku an-dakdemalad,","poem":1},{"text":"bunormar-anga-arbadimaladse-bakale, dule-baidiyob an-dakdemalad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"An-maiga-gudiidse an gotedaenad, gwen an-abin-imaksurdaed.","poem":1},{"text":"Amba ise-wilegar an gordibe, amba an-itodasulid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"An-gaya-yapannedde gwen nabir-yapansulid, an-ome ima an-itoged.","poem":1},{"text":"An-gwenadgan-gargwenmaladse-bakale, imasun an-daked.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Burwiganase-bakale, angi dododmalad.","poem":1},{"text":"An-dakarmalale, biir naddamalad.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"An-aimarbela imasar an-dakdemarmogad,","poem":1},{"text":"an-gwenadganbela angi aibitemalad.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"An-garmar bus-bus gusad,","poem":1},{"text":"an-san bar daklesurgusad.","poem":2},{"lineBreak":true},{"text":"Unnila napi an bunnodiid.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"An-aimar, nue-wile be an-dakmala,","poem":1},{"text":"ar Bab-Dummad nue an-wionaid.","poem":2},{"lineBreak":true},{"text":"¡Nue-wile be an-dakmala!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"¿Ar ibiga Bab-Dummad-an-wionaidyob bemar an-imaknaimarmoga?","poem":1},{"text":"¿Ar bemar an-wionanaid baisur-itomala?","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"”Bitigine an-sunmakedi gardagi narmaklegena yeerban,","poem":1},{"text":"gardagi narmakar megisana yeerban.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"An-sunmakedi akwagi degisadegu narmakar megisana yeerban,","poem":1},{"text":"esgoro-madaregedgi degisadegu narmakar megisana yeerban.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"An nue-wisid, an-Bab-Dummad-An-Ollor-Imaked dula maid.","poem":1},{"text":"We-dule dummad-an-wilenaidgi an-ogwisguoed an nue-wisid.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"An-san bela bergussundibele,","poem":1},{"text":"amba an-ibyagwar an Bab-Dummad-dakedsegad.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Amba Bab-Dummad-dakoedi an nue-wisid,","poem":1},{"text":"an-sunnagwad an dakoed, dule-baid dakosulid.","poem":2},{"lineBreak":true},{"text":"We-ibagan an nue bela-bela edarbediid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"”Bemar sogbalid: ‘Anmar egi yolegoe,","poem":1},{"text":"ar a-dulegi isgued nue-maid.’","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Nue salakarmalo, es-suidse ibitodamalar.","poem":1},{"text":"We-es-suidgi Bab-Dummad dule-isgana obeloged.","poem":2},{"text":"Bemar wisgumar,","poem":1},{"text":"Bab-Dummad anmar-wilub-daked maid.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}