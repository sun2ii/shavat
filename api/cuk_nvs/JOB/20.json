{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":20,"content":[{"type":"heading","content":["Zofar, dule-isganamargi sunmaksad"]},{"type":"verse","number":1,"content":["Weyobi, Zofar Naamat-neggweburgined, Job-abin sogded:"]},{"type":"verse","number":2,"content":[{"text":"“An we-ibmar-itosad sunmakebier an-imaked.","poem":1},{"text":"An-binsaed-oburusadba sunmakebier an itoged.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"We-ibmar-sunmaklesad-an-itosadi, isdarsunna an-imaked.","poem":1},{"text":"An ibmar-wismogadba an abinsamogargebed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"”Neg-gusad be nue-wisimakaled,","poem":1},{"text":"gebesailanagine, we-napneggi dule-aidenonikid-akale,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"dule-isgana-werguedi sikwas nagudaed.","poem":1},{"text":"Unnila sikwas yeer-itodii gudidaed, bato yog-berguar naddaed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dule-isgana-e-san-dummarba-imakedi, amba nibnegse warmakdibe,","poem":1},{"text":"dule-isgana-e-nono amba mogir-ebudibe,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"we-dule, e-ibmar-isgana-berguddaedyobi bergudoed.","poem":1},{"text":"E-aimar sogdemaloed: ¿Bia we-dule nade?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"We-dule gabdaklegedyobi bergudoed,","poem":1},{"text":"negburgan-daklegedyobi sikwas daklegoed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dulemar, we-dule-isgana-daksagusmalad bar dakosurmalad.","poem":1},{"text":"E-neguyagi-gudigusmaladse-bakale, bar dakosurmalad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"We-dule-isgana-e-mimmigan, dule-wilegana-wiolesad bendakedsegad.","poem":1},{"text":"We-dule-isgana-e-mimmigan, dule-wilesmalad-ibe ibmar-nuegan-susmaladi gannar ukedsegad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dule-isgana sapingwagwadgine, gandik na itodiile,","poem":1},{"text":"ibagwengi amba neg-urba dogedsegad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"”We-dule ibmar-isgana ibnuedga imakdiid,","poem":1},{"text":"ibmar-ochiganayob dakdiid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gwen ibmar-isgana metebigudisulid,","poem":1},{"text":"aka egi wergudiid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Igi-dule ibmar-ochigwad dogdar-masale, saban-nunmaked ega ukdae,","poem":1},{"text":"deyobi, ibmar-isgana dule-isganaga naibe-e-gichiyob gunonikoed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ibmar-bukidar-emar-yardakedgi-amisad gannar e-ibe sulegoed.","poem":1},{"text":"Bab-Dummad-sogedba gannar e-ibe bela sulegoed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dule-isgana-e-isguedi naibe-e-gichiyob gued,","poem":1},{"text":"we-gichigi dukin burgoed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bela moli-nunis-bukidar, achanis-bukidar,","poem":1},{"text":"diwar-ariomaiyob-guedgi gwen wergudii guosulid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ibmar-bukidar-amisadi, gannar uknai dakledagoed,","poem":1},{"text":"gwen egi werguosulid, egi ibmar-nued amiosulid.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Dule-isgana dogdar dule-wilemalad wiosad,","poem":1},{"text":"gwen negmar-e-sobsasulid emar-ibe susbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"”We-dule-isgana sulibinsa ibmarbina-itodii gusad,","poem":1},{"text":"gwen ibmar-nikad itossulid.","poem":2},{"lineBreak":true},{"text":"Bela ese ibmar sulemai gusad.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ibmar gwen abin sigissulid, bela ese sulesad.","poem":1},{"text":"A-ulale, e-ibmar-nasgumaid bergudoed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ibmar-bukidar-nikadbali, sulibinsa-itodii gudoed,","poem":1},{"text":"degidbali, ega boni-dummagan nonikoed.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Dule-isgana ibmarba nue-yeer-itodiidgine,","poem":1},{"text":"Bab-Dummad egi yolenonikoed, egi ise-urwar gwichigunonikoed.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Dule-isgana aisaar gingimar-esgorogi-sobaledgi wakinbi-gudagoenad,","poem":1},{"text":"sigu-esgoro-gordikidgi ibitogoed.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Sigu-esgoro-gordikidbiid egi yolenonikoedi, ungebigudagoenad,","poem":1},{"text":"sigu-duku binagi buudu-noedi ungebigudagoenad.","poem":2},{"lineBreak":true},{"text":"Dobedbali, surbinsa itodoed.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Negasichidi, dule-isgana-edarbenaid,","poem":1},{"text":"soo-dule-ogaed-abesulidi, dule-isgana-obelogoed,","poem":2},{"lineBreak":true},{"text":"e-negse-bakale, ogumakoed.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nibneg, dule-isgana-e-isgusad magar-dakle imaknonikoed.","poem":1},{"text":"Napneg, dule-isgana-isgusad barsognonikoed.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Bab-Dummad-urwenonikoed-ibagine, dule-isgana-e-neg-bukwad,","poem":1},{"text":"dii-dummad-muredba seledoed.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Weyobi, Bab-Dummad dule-isganaga bergued nasiksad.","poem":1},{"text":"Weyobi, Bab-Dummad, dule-isganaga bergued-igar mesisad.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}