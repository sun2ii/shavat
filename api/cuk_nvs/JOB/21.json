{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":21,"content":[{"type":"heading","content":["Dule-isganamar-nasguedgi, degi, ibmar-sate-guedgi sunmaklenaid"]},{"type":"verse","number":1,"content":["Agine Job abin-sogded:"]},{"type":"verse","number":2,"content":[{"text":"“Bemar nue an-sunmaked itomala,","poem":1},{"text":"adi, bemar nabir gadi-gadi an-imakmaloed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"An sunmaknaile, mer sulibinsa alled-itomalo.","poem":1},{"text":"An sunmaked-bergusale, bemar allebier, allemaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"”An-urwenaidi, dulemarbo an urwenaisulid.","poem":1},{"text":"A-ulale, geg an san bargaed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nue be an-dakmar.","poem":1},{"text":"Geger be an-dakmaladba, gaya be gamaloed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"We-ibmargi an binsaddibe an gwakiddaed,","poem":1},{"text":"bela an-abaganmar iii naddaed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"¿Ibiga dule-isganamar amba dula-gudinanae?","poem":1},{"text":"Aka bur bule nasgumamaid, deyob seredgumamaid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dule-isganamar e-mimmigan-nasgumai daked,","poem":1},{"text":"e-waganmar-nasgumai daked.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dule-isganamar e-neguyagi neg-bogidikid-nika gudidamalad, dobedsuli gudidamalad,","poem":1},{"text":"Bab-Dummadse gwen sabsur-odurdaklesurmalad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dule-isgana-e-molimar-bebe-nikad e-dula-bakmalad sunsogmaladid.","poem":1},{"text":"E-moli-omegandina, mimmigan-nikualile, gwen e-ibe mellesulid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dule-isgana-e-mimmigan sibad-wawaadyob abarmakdidamalad,","poem":1},{"text":"dodonaigusmalale, oallenagusdamalad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Gar-tambor-goledbali, gar-arpa-goledbali, namakdedamarbalid.","poem":1},{"text":"Gar-gammu-goledbali, wergunaidamarbalid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ar dule-isganamar-e-gudiidi, nueganbi gudidamalad.","poem":1},{"text":"Burgwidmalale, nuedgi burgwiddamalad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dule-isganamar Bab-Dummadga sogdedamalad:","poem":1},{"text":"‘Mer be anse gole, anmar Be-Igar-Maidba nanabisurmalad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Anmar e-nug-odummogega, Bab-Dummad-Bela-Gangued-Nikadde, ¿doasunna?","poem":1},{"text":"Anmar ese gorye sogele, ¿ibu-nued egi amilesunna?’","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dule-isganamar na e-ibmar-nuegan-nika-guega egi sisulid.","poem":1},{"text":"Bipisaale, amar-binsaed-isgana-ukedba an binsaed galegosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"”Dule-isganamar geg burgwe gudimalad. Undar iba-suitii gudidamalad.","poem":1},{"text":"Dule-isganamar boni-dummaganba-gar-itodii dasurmalad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Dule-isganamar, gagan-dinnagwadyob, burwa-dummadba-selemai dakledisulid.","poem":1},{"text":"Dule-isganamar, burwa-ooredba gaganyob-selemai dakledisurbalid.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Anga sogdamaloed, Bab-Dummad dule-isgana-e-mimmiganbi sabsur-odurdakoye, e-babgandi, odurdakosurye.","poem":1},{"text":"Bab-Dummad bur bule e-babgan sabsur-odurdakena gadin,","poem":2},{"lineBreak":true},{"text":"adi, magar na itomaloed.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dule-isgana e-wilegoed, e-ibyagwar na daksun.","poem":1},{"text":"Dule-isgana, Bab-Dummad-Bela-Gangued-Nikad-sabsur-e-odurdaked itosun.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Dule-isganamar bar undar-gudii guosulidbali,","poem":1},{"text":"e-sorba-e-gwenadgan-beoedi, gwen bai dakosulid,","poem":2},{"lineBreak":true},{"text":"gwen egi binsaosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"”¿Doa Bab-Dummad binsaed-nuegan-nikuega odurdakosunna?","poem":1},{"text":"Bab-Dummad bur emar-wilubdaked maid,","poem":2},{"lineBreak":true},{"text":"nuga-nikamaladse-bakale, ese wilub-daklemalad.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Abar-dulemar nuchukwagwadgi burgwemalad,","poem":1},{"text":"nue yeer-neg-itodimaladgi burgwemalad,","poem":2},{"lineBreak":true},{"text":"nue bogidikid-gudiidgi burgwiddamalad.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ibmar-bukidar-nikaa gudidamalanad,","poem":1},{"text":"san-nuedi, bonisuli gudidamalanad, deyob burgwiddamalad.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Abar-dule sulibinsa-isdar-itodii burgwiddabalid,","poem":1},{"text":"gwen ibmar-nuedgi-wergudsuli burgwiddamalad.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bela we-dulemar napa-yaba-burgwarmamaile, emarbi gumalad.","poem":1},{"text":"Napa-urba nusbiini mamai gumaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"”Ar bemar-binsabukwadi an wisid,","poem":1},{"text":"unnila bemar an-wiogedgi binsabukwad.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Bemar-binsananaid an wisbalid.","poem":1},{"text":"Bemar binsabukwad: ‘¿Bia we-dule-nuga-nikad-e-neg-dummad nade?","poem":2},{"lineBreak":true},{"text":"¿Bia we-dule-isgana-e-neg nade?’","poem":2}]},{"type":"verse","number":29,"content":[{"text":"¿Dule-bukidar-igarba-nanamaladse be egissurmarsi?","poem":1},{"text":"¿A-dulemar-sunmaked be nue-itosurmarsi?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Dule-isgana bonigan-nonikile, akar-gusurdamalad.","poem":1},{"text":"Sabsur-odurdakleged-ibagi, san-onosdamalad.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"¿Doa dule-isganaga e-gudiidgi akar sogosunna?","poem":1},{"text":"¿Doa ega asabinmakar ibmar sogosunna?","poem":2},{"lineBreak":true},{"text":"¿Doa dule-isgana sabsur-odurdakosunna?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Dule-isgana-burgwisar, neg-uanse-selesdibe,","poem":1},{"text":"e-neg-uangi dule-nakulemalad ogwichilesdaed.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Neg-uanse-e-bardakmalad bukidar ainiardaed.","poem":1},{"text":"Napa-nuedgi digles mesilesdaed, nuedgi bogidik mesilesdaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"”Degite, ¿igi bemar an-gwage gadi-gadi imakosunna?","poem":1},{"text":"Yogasaar be anga sunmaknanaimalad, bemar anga ibmar-sognaid inniki anga sunmaknanaisurmalad.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/20.json","previousChapterAudioLinks":{},"numberOfVerses":34}