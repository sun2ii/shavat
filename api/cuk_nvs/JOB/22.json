{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":22,"content":[{"type":"heading","content":["Elifaz, gannar Jobʼgi yolenaigusad"]},{"type":"verse","number":1,"content":["Agine, Temán-neggweburgined-Elifaz, Job-abin sogded:"]},{"type":"verse","number":2,"content":[{"text":"“Dule-gwensak binsaed-nikarbadibe, ¿Bab-Dummadgala ibnuedga gue? Suli.","poem":1},{"text":"Dule-deyobid na dukin ega ibnuedga gued.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"¿Be-innikidaedgi Bab-Dummad-Bela-Gangued-Nikad ibmar-nued amisi? Suli. Ar gwen ibmar-nued egi amisulid.","poem":1},{"text":"¿Be-nued-nanaedgi Bab-Dummad ibmar-nued amisi? Suli. Ar gwen ibmar-nued egi amisulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"”Ar Bab-Dummad sabsur bega ibmar-sognaile, degi, bega igar itonaile,","poem":1},{"text":"ar be e-dobegudiidbarsulid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ar be-isgued-doggus-merguedba, degi, be-isgued-bargalesulidba,","poem":1},{"text":"deyob be-imaknaid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Be-gwenadgan bese ibmar-egisdanidibe,","poem":1},{"text":"gwen be ibmar-abesulidgi, gandikidgi, e-ibe ibmar-anar, mor be susdaed.","poem":2},{"text":"Dule-wilemalad-ibe mor bela be susdaed,","poem":1},{"text":"uka-swana be metedaed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dule-ukudmaad-gudimaladga, gwen gobed be ukdasurbalid.","poem":1},{"text":"Dule-masbina-gudimaladga, be gwen mas ukdasurbalid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Be dule-buled megissoggu, dule-nainu-ibed be megissoggu, be binsasanad,","poem":1},{"text":"ani an napa-ibedye.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Omegan-ei-sui-burgwismaladga, gwen ibmar-uksasuli be barmiddaed.","poem":1},{"text":"Sergan-satemalad-ibe be ibmar bela susdabalid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"A-ulale, emisgindi galesnaiyob be itoged,","poem":1},{"text":"ukiagwar nue-dobe be itoardaed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Negsichidgi-gudiiyob be itoged,","poem":1},{"text":"a-ulale, ibmar-daksuli be-imaked.","poem":2},{"lineBreak":true},{"text":"Diwar-dummadse-selemaiyob be itoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"”¿Bab-Dummadi nibneggi maisursi?","poem":1},{"text":"¡Be dakena! Niisgwamar-dikasurnanaid matusuli begi nanaid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Emide be soged: ‘Bab-Dummad, ¿ibi wissunna?","poem":1},{"text":"¿Bab-Dummad sunna negsichid-abalagi emar-wilubdaksi?’","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Be sogbalid: ‘Mogirmar Bab-Dummad-idu bipirmaknaiye, mogir-gudureged ebirisnaiye.","poem":1},{"text":"Agala, Bab-Dummad gege anmar-dakye.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"”Dule-isganamar-galagwensuli-nanasmaladba, ¿be nanamogode?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Be ebinsao, we-dulemar nuchukwagwadgi burgwisgusmalad,","poem":1},{"text":"diwar-dummadba ibmar-selegedyobi bergusmalad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Aka Bab-Dummadga sogdegusmalad:","poem":1},{"text":"‘Mer be anmarse gorye,","poem":2},{"lineBreak":true},{"text":"Bab-Dummad-Bela-Gangued-Nikad, ¿ibu be anmarga imaksunnoye?’","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bab-Dummad ega ibmar-nuegan-ukdii gusanad.","poem":1},{"text":"Andina, dule-isgana-e-binsaed-isganaba binsaed-galeged, sate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"”Dule-nuegan, dule-isganamar-ibitonanaid-daksagua, yeer-itosmalad,","poem":1},{"text":"dule-ibmar-oakalodisurmalad egi dododmalad, sogdemalad:","poem":2}]},{"type":"verse","number":20,"content":[{"text":"‘Anmar-isdarmalad burgwismalad,","poem":1},{"text":"e-ibmar-nikad soose bela ei-gummaksad.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"”Job, Bab-Dummad-urbaligwa be nanae, ebo be igar nudake,","poem":1},{"text":"Bab-Dummad gannar ibmar-nikuega be-imakoed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bab-Dummad-e-sunmakmaid be nue abingae,","poem":1},{"text":"e-igar-durdakleged be-gwagegi nue-sedii be gue.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bab-Dummad-Bela-Gangued-Nikadse be gannar wilesakwaa atakdedibe,","poem":1},{"text":"be-neguyagi ibmar-isgana be obangusbardibe,","poem":2},{"text":"bela be nugunonikoed,","poem":1},{"text":"weligwar be gunonikoed.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Be or-nuegan-nikadi napagi be miele,","poem":1},{"text":"Ofir-e-ormar diwar-akwamar-imbagi be miele,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bab-Dummad-Bela-Gangued-Nikad be-or-nuedga gunonikoed,","poem":1},{"text":"Bab-Dummad be-mani-nuedga gunonikoed.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bab-Dummad-Bela-Gangued-Nikad yeer-ito be-imakoed.","poem":1},{"text":"Bab-Dummad-asabinni bar be bingeguosulid.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bab-Dummadse be gotele, be-itogoed.","poem":1},{"text":"Bedi ega ibmar-imakoye-sogsad be imakedsegad.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Be ibmar-imaksokalile, bega ibmar-nueganbi gudoed.","poem":1},{"text":"Be-iduale gwallu-ganaiyob bega neg-nagunonikoed.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Bab-Dummadi, dule-san-dummarba-imakdiid, san-bipii imaked.","poem":1},{"text":"Dule-na-san-bipi-imakdimalad-e-nugdi, odummoged.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Bab-Dummadi, dule-ibmar-oakalodisurmalad bendaked.","poem":1},{"text":"Be dule-innikidaedba Bab-Dummad be-bendakoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}