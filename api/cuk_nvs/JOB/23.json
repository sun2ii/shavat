{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":23,"content":[{"type":"heading","content":["Job, Bab-Dummad-asabin san-bendaksad"]},{"type":"verse","number":1,"content":["Job, Elifaz-abin-imakded:"]},{"type":"verse","number":2,"content":[{"text":"“Emi amba an naibi-itoged-abalagi sunmakoed,","poem":1},{"text":"amba Bab-Dummad sabsur-an-imaknaid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"An wisina, bia Bab-Dummad mai,","poem":1},{"text":"degi, an e-maidse sunna nabir moena,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"an san-bendakegala","poem":1},{"text":"an bela ega ibmar sogsaled.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Dummad-ibmar-sogbied an wisgusaled.","poem":1},{"text":"Degidbali, an magar itononikiled.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Dummad angi sabsur-gwisguega, ¿e-gangued angi oyogergebsi?","poem":1},{"text":"¡Suli! Angi gwisgussuliled, unnila an-itonai gusaled.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dule-innikidaedi, Bab-Dummad-asabinni sunna na san-bendaked.","poem":1},{"text":"Andina, anga-igar-naboged-asabin degisadegu ollorgusaled,","poem":2},{"lineBreak":true},{"text":"ibmar-oakalossuliyob an-daksaled.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”Aisaar an Bab-Dummad-amidiinad.","poem":1},{"text":"An dad-nakwedsik nadele, an daksulid,","poem":2},{"lineBreak":true},{"text":"dad-argwanedsik nadbalile, an daksurbalid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Dummad dad-nakwed-argan-sapiledsik-gunaile, an daksurbalid.","poem":1},{"text":"Dad-nakwed-nuedsik-gunaile, an daksurbalid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Dummaddi bela an-gudiid nue-wisimakaled.","poem":1},{"text":"Bab-Dummad an-wilubdakye-sogele, or-swilimakaleyob an gusaled.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Dummad-Igarba an nue-nanadiid,","poem":1},{"text":"e-sogedba an nanadiid, an egi bangudisulid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"E-Igar-sogsagusadgi an bangudisulid.","poem":1},{"text":"E-ibmar-sogsadi, an-gwage-ulubgi an sediid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”Bab-Dummad na ibmar-imakbiedba imakmaid,","poem":1},{"text":"¿doa ega akar-sogoe?","poem":2},{"lineBreak":true},{"text":"Na e-abegedba ibmar imakmaid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bab-Dummad, igi-an-imakoye na sogsa, deyob an-imakoed.","poem":1},{"text":"Ibmar-baigan-bukidar ayobi, na e-abegedba imakoed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Agala, an Bab-Dummad-asabin dobee itodaed.","poem":1},{"text":"We-ibmargi an bela binsaddibe, nue-dobe an itoddaed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bab-Dummad-Bela-Gangued-Nikadi an-niga-egwachad,","poem":1},{"text":"nue-dobed anga uksad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"We-ibmar-bela-angi-gunaidi, an-gayamakosulid,","poem":1},{"text":"an nunmaked-dummad-itonai-inigwele, amba an ibmar sogedsegad.”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}