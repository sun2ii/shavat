{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["Job sogdebalid:",{"text":"“¿Ibiga Bab-Dummad-Bela-Gangued-Nikadi, dule-isgana-odurdakleged-iba nasiksuli?","poem":1},{"text":"Adi, dule-Bab-Dummadba-nanaimalad dakmaloenad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dule-isganamar nainu-suegala, nainu-dikar-abingunaidgi dogdedamalad,","poem":1},{"text":"degine, molimar-atursasmalad akwedidamalad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sergan-satemalad-ibe moli-uayasuid susdamalad.","poem":1},{"text":"Ome-ei-sui-burgwisad-ibe ibmar-ganikid-anar moli-bebe-nikadi susdamarbalid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dule-isganamar dule-wilemalad-igarba-abingualir, e-idu ainirmalaga imaked,","poem":1},{"text":"e-dobedba e-idu dukumalaga imaked.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dule-wilemalad, moli-uayasuid-sapurbalidyobi wakudaryalaba negsulidganba masbina gudidamalad.","poem":1},{"text":"Nega-dulesulidganba e-mimmiganga mas amied.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dule-wilemalad emar-nainuganse ibmar-obichad-weegala, naddamalad.","poem":1},{"text":"Dule-isganamar-e-uva-nainugi uva-san-babatisad weenai damalad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dule-wilemalad mutikgusale, morsurmaladbali uka-swana megiddamalad.","poem":1},{"text":"Atued-sulidbali dambed-abalagi neg-oiboardamalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yalaganba dii-wiedba waradik gudidamalad,","poem":1},{"text":"dukued-sate gudidamalad, unnila akwa-imbaba dukubukwadamalad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dule-isganamala, goe-bab-sated e-nan-annik sumalad.","poem":1},{"text":"Egi-mani-ganikid-anar dule-wilemalad-ibe mimmigan sudamalad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dule-wilegana mor-satedbali, uka-swiri gudidamalad.","poem":1},{"text":"Emar-nainugi ibmar-gwag gwaada semaidamalad.","poem":2},{"lineBreak":true},{"text":"Degidbali, ukudbali burgwiddamalad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"We-dule-wilegana, olivo-gwallu-egurega e-naged-akwa obipirmaknagusdamalad.","poem":1},{"text":"Uva-e-nis-onogegala egi annanagus damarbalid,","poem":2},{"lineBreak":true},{"text":"degi-inigwele, ukudmaada gunanaidba burgwiddamalad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Neggweburgine dule-burgwedanimamaid-e-akiginned magar itoleged.","poem":1},{"text":"Dule-undar-naibigusmalad aisaar Bab-Dummadse bendakleged egisnaidamalanad,","poem":2},{"lineBreak":true},{"text":"degi-inigwele, Bab-Dummad gwen bai dakdasulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”Gwenna-gwenna dulemar igar-nued abedasurmalad, isdarsunna dakdamalad.","poem":1},{"text":"Igar-innikigwadba nanabisurdamalad,","poem":2},{"lineBreak":true},{"text":"ibmar-isgana-imakdiid magar itosurmalad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dule-emar-gindaked dule-wilemalad-oburgwega, degi, ibmar-abesa-gudimalad-oburgwega, oibosayala gwisguardaed.","poem":1},{"text":"Neg-mutikgudele, dule-ibmar-atursaedga binyiddabalid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Dule-galagwensuli-e-omesulidbo-nanaed neg-mutikgued edarbedidaed,","poem":1},{"text":"weyob sogdidaed: ‘Dule gwen an-dakosuli.’","poem":2},{"lineBreak":true},{"text":"Deyob dukuakwaa gudidaed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dule-ibmar-atursaed mutikidba emar-negse dogdaed.","poem":1},{"text":"Neg-ibgindina e-negyaba dukumaidaed.","poem":2},{"lineBreak":true},{"text":"Isdar neg-ibgined dakdaed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bela we-dule-isganamargala, neg-ibginedi mutikidyob gued.","poem":1},{"text":"Neg-mutikid-neg-galagwensur-guardaed bur abedamalad.”","poem":2}]},{"type":"heading","content":["Zofar, Jobʼgi gaya-egwannonikid"]},{"type":"verse","number":18,"content":["Zofar weyob sogded:",{"text":"“Dule-isganamar dii-iirmakmaiyobi gwae-gwae wakitedamalad,","poem":1},{"text":"e-nainu-naidi nue-ukabsales naid.","poem":2},{"lineBreak":true},{"text":"A-ulale, gwen dule e-uva-nainugi gannar bar arbabidasulid.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Igi dad-dummad-gaedi, neg-diopisulidi, boo-batenaid berguega-imake,","poem":1},{"text":"deyobi, dule-isgudimaladi burgwedse berguddamalad.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dule-isganamar-bergudele, e-nangan bar egi binsaosulid.","poem":1},{"text":"Amar napa-urba-dogdele, nus-masga gudoed.","poem":2},{"text":"Dulemar gwen dule-isganamargi bar binsadii guosurmalad.","poem":1},{"text":"Igi sapimar olaledae, deyobi, gumaloed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Dule-isganamar ome-geg-mimmi-baked, sabsur-imakdidamalad.","poem":1},{"text":"Degi, omegan-ei-sui-burgwismalad-sabsur imakdidamarbalid.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Degi-inigwele, Bab-Dummad e-garganguedba dule-isganamargi yoleged.","poem":1},{"text":"Bab-Dummad uluddibe, dule-isganamar geg abin gwisgued.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bab-Dummad dule-bulegan-dobsuli imaked, degi, egi bensuli imaked,","poem":1},{"text":"degi-inigwele, Bab-Dummad amba we-dulemargi nakuleged.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Amar-e-nug unnila sikwas odummoleged, yog-berguar naddaed.","poem":1},{"text":"Dule-isganamar oros-welegeyob gumalad,","poem":2},{"lineBreak":true},{"text":"gagan-gummakeyob gummakmalad, yoga-berguar naddaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"”¿Doa anga sogosunna, an-sunmaknaidi gakanye?","poem":1},{"text":"Dule gege anga soged, we gakanye.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}