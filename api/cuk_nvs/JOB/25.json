{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"heading","content":["Bildad-ilapaagus-sunmaked"]},{"type":"verse","number":1,"content":["Súah-neggweburgined-Bildad, Job-abin weyob sogded:"]},{"type":"verse","number":2,"content":[{"text":"“Bab-Dummadi, dule-gandikidid.","poem":1},{"text":"Dobesar dule-imakedid.","poem":2},{"lineBreak":true},{"text":"Bab-Dummadi bela nibneggine igar-ilemakmaidid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"E-sordagan-merguedi, gege ebisleged.","poem":1},{"text":"Bela dulemargi Bab-Dummad-e-gwallu gaed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"¿Sunna dule ibmar-oakalossuliyob Bab-Dummad-asabinni gwisgusi?","poem":1},{"text":"¿Sunna dule Bab-Dummad-asabinni islidikidga na san-imaksi?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ar niibela Bab-Dummad-asabinni bollee gaed,","poem":1},{"text":"niisgwamarbela e-asabinni gannarba gasurmogad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dule-bulesunna, nus-musgimakmaiyob gudiid,","poem":1},{"text":"dulede, napa-nusyob gued.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}