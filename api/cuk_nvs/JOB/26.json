{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"heading","content":["Job, Bildad-abin-sogded"]},{"type":"verse","number":1,"content":["Job Bildad-abin weyob sogded:"]},{"type":"verse","number":2,"content":[{"text":"“¿Weyob be dule-gegudiid-bendaksunde?","poem":1},{"text":"¿Weyob be dule-nollogudiid nue-bendakye be sogsunde?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ibiyobi dule-ibmar-wissulidga binsaed-nued-uke an be-dake.","poem":1},{"text":"Ibiyobi nue-binsaed-nikaye na be san oyoge.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"¿Doa weyob-sunmakedgi be-odurdaksa?","poem":1},{"text":"¿Doa weyob sunmakega be-imaksa?”","poem":2},"Bildad, Job-abin-sogdebalid Bildad, Job-abin-sogdebalid:"]},{"type":"verse","number":5,"content":[{"text":"“Dule-burgwarmalad demar-wilad-urbali-mamaidi,","poem":1},{"text":"Bab-Dummad-asabinni, wawanmakmaid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Burgwarmalad-meged-galumar bela Bab-Dummad-asabinni, magar daklemamaid.","poem":1},{"text":"Burgwed-igar Bab-Dummad-asabinni, dukumaisulid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Dummadi, bela nibneg-naid neg-olloledgi nasiksad,","poem":1},{"text":"napnegdi, ibmargi-akanaisuli nasiksabalid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Dummadi, mogirmargi dii nasiksabalid,","poem":1},{"text":"Bab-Dummadi, mogir nabir dii-bargae imaksabalid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Dummadi, nii-dalunaid-eduegala,","poem":1},{"text":"irwa mogir nasiked.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Dummadi, magatibali demargi igar-maiyob imaksad,","poem":1},{"text":"adi, nabir neg-ibgined, neg-mutikidgi bachiki-nai guegar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Dummad-urwed-abinni nibneg-bargamaladi,","poem":1},{"text":"dobedbali wawanmakdedamalad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bab-Dummadi, e-ganguedgi demar-uurmaked obogileged.","poem":1},{"text":"Bab-Dummadi, e-ibmar-wisidbali ibdula-Rahabʼye-nugad ese ibitosad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bab-Dummadi, e-bunnogedgi mogir oaisakied.","poem":1},{"text":"E-argangine, ibdula-dummad-demargined oitoged.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"We-ibmar unnila-sikwas Bab-Dummad-e-gangued oyonaid.","poem":1},{"text":"Anmar unnila-sikwas, Bab-Dummad-e-gangued itonaid.","poem":2},{"text":"¿Doa Bab-Dummad-e-gangued bela magar itogosunna?","poem":1},{"text":"Dule gege magar itoged.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}