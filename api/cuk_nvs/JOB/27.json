{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":27,"content":[{"type":"heading","content":["Job, dule-isganamar-guoedgi sunmaksad"]},{"type":"verse","number":1,"content":["Job weyob sogdebalid:"]},{"type":"verse","number":2,"content":[{"text":"“Bab-Dummad-Bela-Gangued-Nikad-nuggine,","poem":1},{"text":"degine, anga igar-nudaksulid-nuggine,","poem":2},{"text":"sae-itogega an-imaked-nukine,","poem":1},{"text":"ise-sogar an soged:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Amba an dula-gudiidgine,","poem":1},{"text":"an nue garmakdiidgine,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"an gaya-isgana sogosulid,","poem":1},{"text":"gakansaale an ibmar sogosulid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bemar-angi-sunmakedi nabir be sogmarye an sogosulid.","poem":1},{"text":"Amba an dula-gudiidgine an ibmar-oakalossurye an sogoed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"An ibmar-oakalossursoggu, an sikirmakosulid,","poem":1},{"text":"gwen akar an binsanaisulid.","poem":2},{"lineBreak":true},{"text":"An dula-gudiidgine gwagegi akar an itogosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"”Bab-Dummad, dule-isganamaryobi an-isdarmalad be obeloge.","poem":1},{"text":"Dule-inniki-nanasurmaladyobi an-isdarmalad be obeloge.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Dummad dule-isganamar-oburgweye-sogele,","poem":1},{"text":"¿bia bar bendakleged amimalosunna?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Amargi boni-dummagan gwichigunonikile,","poem":1},{"text":"Bab-Dummad amar-ese-binnasuli-goled itogosulid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"¿Ar dule-isgana Bab-Dummad-Bela-Gangued-Nikadgi wergudisi?","poem":1},{"text":"¿Ar Bab-Dummadse bane-bane gordibarsi?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"An bega Bab-Dummad-e-gangued oyogwelo.","poem":1},{"text":"Bab-Dummad-Bela-Gangued-Nikad-e-igarmar an bega odukuosulid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ar bela bato bemar we-igarmar daksabinmaladde,","poem":1},{"text":"degite, ¿ibiga bemar yogasaar sunmaknanaisunna?”","poem":2}]},{"type":"heading","content":["Zofar-ilapaagus-sunmaked"]},{"type":"verse","number":13,"content":["Zofar Job-abin weyob sogded:",{"text":"“Bab-Dummad-Bela-Gangued-Nikadi dule-isganamarga we-igarmala sabosad.","poem":1},{"text":"Bab-Dummadi dule-galagwensurdamaladga sabsur-odurdakleged-igala, weyob mesisad:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ar dule-isgana mimmigan-ichesur-nika-inigwele, amba es-suidgi burgwemaloed,","poem":1},{"text":"a-e-mimmigandi, ukudmaada gudii gudmaloed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Dule-isgana amba besmalale, boniganse burgwemaloed.","poem":1},{"text":"E-omegan-bemaloedi, gwen e-suimar-burgwismaladga boosurmaloed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dule-isganamar, amba mani-bukib ukubyob-onmaksale,","poem":1},{"text":"mormar suar-ena-ena nikuele,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"dule-nued-daedi a-mormar yononikoed,","poem":1},{"text":"dule-inniki-gudiid a-mani sunonibaloed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Dule-isgana-neg-sobedi sikwi-uu-baisur-ayareyob gued,","poem":1},{"text":"dule-nakuleged-neg-matar-baisur-ayared-sobsadyob e-neg dakleged.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Dule-isganamar, napi-mani-ibed-gudii gabiddamalad, neg-oibosale, mani-sate oiboardamalad.","poem":1},{"text":"Dule-wilegedga nadmalad.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dule-isgana neg-ibgine, gwayed-dummad egi nagunonidaed.","poem":1},{"text":"Neg-mutikgusale, burwa-dummad egi gordanikiyob itodaed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Burwa-uereged sabsur-gornonikile, we-dule-isgana gwen abin gwisguosulid,","poem":1},{"text":"burwa-dummadi e-neg-maid sedoed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bab-Dummadi, dule-isganagi sabsur-yoleged,","poem":1},{"text":"dule-isgana Bab-Dummadgi, aisaar wakinnoeyob itodaenad.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Weyobi, dulemar, dule-isgana-ibitonai-dakarmalale, yeer dakdamalad,","poem":1},{"text":"ega argan ogotedamalad, ega sabsur-wigoddamalad.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}