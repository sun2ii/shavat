{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":28,"content":[{"type":"heading","content":["Binsaed-nuedgi yeer-sunmaklenaid"]},{"type":"verse","number":1,"content":["Job sogdebalid:",{"text":"“Manimala, ormala napa-urba amileged,","poem":1},{"text":"sooyagi diree imaklesiid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Esgoromala, napa-yaba onolesiid,","poem":1},{"text":"esnon-goromardi akwamargi onolesiid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dule-akwa-nuegan-amimaladi, bar negsichid-nai daksurmalad.","poem":1},{"text":"Negsichidgi-akwamar-bukwadi ese onilebukwad.","poem":2},{"lineBreak":true},{"text":"Yaamargi-akwa-nuegan-nikadi bela onimalad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Neg-uluba-nanaledisulidgi yaamar akwimalad.","poem":1},{"text":"Matusuli yaa akwimalad.","poem":2},{"text":"Dubba bannumakar aidedamalad.","poem":1},{"text":"Dulemargi dikasuli neg-urba gunanaidamalad","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yaa-matusulidgine arbananaidamalad,","poem":1},{"text":"neg-uere-itoledaed-yabali gunanaidamalad,","poem":2},{"lineBreak":true},{"text":"abali, masgunned amididamalad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"A-yabali, akwa-dummagangine akwa-nued-zafiroʼye-nugad onomalad,","poem":1},{"text":"a-napa-yabali, or amimarbalid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sulubmar we-yaa-gwisaled dakdisurmalad,","poem":1},{"text":"sulub-e-atakedi, we-yaa-gwisaled-e-gulluse ataksulid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ibdula-ursirmaladbela, a-yaa-gwislegaledyaba dogdisulid.","poem":1},{"text":"Achumigurbela ese walikgudisulid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dule-akwa-nuegan-amimaladi akwa-nuegan-amiegale, akwa-dutusulid sarsonagusdamalad,","poem":1},{"text":"akwa-e-sailamarse-bakale, onodamalad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Akwa-dummagan-akwimalad a-yaba dii-oiirmakega yaa-dummagan omesdamalad.","poem":1},{"text":"Dii-iirmakmaidbali akwa-nuegan-bukwadi bela magar dakdamalad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Akwa-nuegan-amiegala, diwar-e-sailase warmakdamalad.","poem":1},{"text":"Ibmar-dukuar-bubukwad bela negache onodamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"”Degite, ¿bia binsaed-nued-nikagued danisunna?","poem":1},{"text":"¿Bia gurgin-nuegan-nikulegedde danimosunna?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Binsaed-nued-gargeguedi dule wissulid.","poem":1},{"text":"We-binsaed-nuedi we-napneggi danisulid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Muu-billi-maidbela soged:","poem":1},{"text":"‘Binsaed-nuedi, angi danisurye.’","poem":2},{"text":"Demarbela sogmogad:","poem":1},{"text":"‘Binsaed-nuedi, angi amilesurmoye.’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Or-nuegangine, binsaed-nuegana amilesulid,","poem":1},{"text":"manigine, binsaed-nuegana baklesulid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"We-napneggi amba or-Ofir-bukwadgi binsaed-nuegan gege bakleged.","poem":1},{"text":"Amba akwa-nued-óniceʼye-nugadginbela gege bakleged,","poem":2},{"lineBreak":true},{"text":"akwa-nued-zafiroʼye-nugadginbela gege baklebalid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Binsaed-nuedi, bur or-nueganba, akwa-diamanteʼye-nugadba bur gargerbasailad.","poem":1},{"text":"Olua-or-nuegangi-sobaledbo geg binsaed-nuedi ogwaleged.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Binsaed-nuedi, akwa-bisgi-nueganba ibnuedid,","poem":1},{"text":"dimmurgiid-e-akwa-yeerdaklegedba bur sunsogedid.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Akwa-nued-topacioʼye-nugad Etiopíaʼgi-nikadi, gege binsaed-nued-nikagued-ebo yobi gued.","poem":1},{"text":"Binsaed-nued-nikaguedi gege or-sunsogedgi bakleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"”Degite, ¿bia binsaed-nued-nikaguedde danisunna?","poem":1},{"text":"¿Bia gurgin-nuegan-nikulegedde noarsunna?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Binsaed-nued-nikagued bela emargi dukumaid,","poem":1},{"text":"nuumarbela gege binsaed-nued-nikagued baramimogad.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bergulegedi, degi, burgwedi, weyob soged:","poem":1},{"text":"‘Unnila, anmar binsaed-nikagued-e-nug-dummarba-guedbi itodimoye.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"”Unnila Bab-Dummadbi binsaed-nikagued-igar wisid.","poem":1},{"text":"Binsaed-nuedi bia daniki, bia binsaed-nikaguedi amilebali, nue-wisbalid.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bab-Dummadi, we-napneggi galu-sukunmar-bubukwadse-bakale, wisid.","poem":1},{"text":"Soggwensaale, napneggi-ibmar-bukwad gwen egi yoggusisulid.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bab-Dummadi, burwaga e-gangued mesnaigua, degine, muu-billiga e-dungued mesnaibargua,","poem":1},{"text":"binsaed-nued-nikaguedi daksagusad.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bab-Dummad, dii-wiedga igar mesnaibargua,","poem":1},{"text":"mar-goledga igar mesnaibargua,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"binsaed-nued-nikaguedi daksagusbalid.","poem":1},{"text":"Bab-Dummadi binsaed-nued-e-gargegued daknaigusbalid,","poem":2},{"text":"degine, binsaed-nued-nikagued wilubdaknaigusbalid,","poem":1},{"text":"geb binsaed-nued-nikagued bargannononikid.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Bab-Dummad dulemarga sogded: ‘An-dobekwaa-nanaedi, binsaed-nued-nikaadaedye.","poem":1},{"text":"Degine, ibmar-isgana-imakedgi-banguedi, ibmar-wisi-daedbarye.’ ”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}