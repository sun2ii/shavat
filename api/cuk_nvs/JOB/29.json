{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":29,"content":[{"type":"heading","content":["Job iduar-gudigusad obarnaid"]},{"type":"verse","number":1,"content":["Job gannar sunmakdebalid, weyob sogded:"]},{"type":"verse","number":2,"content":[{"text":"“Bitigi Bab-Dummad-nue-an-akwedigusad-ibagan-nasadyobi,","poem":1},{"text":"gannar an gudigusana gadin.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ar negsichiganba dobsuli an gudidaed,","poem":1},{"text":"ar Bab-Dummad gwalluyob an-idudidaed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"An sapingwaunni, amba an gannarba-gudidaeunni,","poem":1},{"text":"Bab-Dummad nued-angi-binsaedba an-neguya mer akarguega imakdaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"”Bab-Dummad-Bela-Gangued-Nikad anba gudidaeunni,","poem":1},{"text":"an-mimmigan an-ebiris gudidaed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Deyob-gudiidgine, an-mesegine wilub-obicha mas an nikagudaed.","poem":1},{"text":"Olivo-gwallumar e-akwa-eguredgi wilub-obicha ariomaidaed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Igar-itogegala, neggwebur-e-yawagak-noedse an signadele,","poem":1},{"text":"dule-igar-nabomalad-abargi an signadele,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"sapingan, yog-ainiar an-iduar imakdamalad,","poem":1},{"text":"sergana, yog-gwichibin an-abin imakdamarmogad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dule-nuga-nikamaladi, bogi-ambikusdamalad, bar-sunmakdasurmalad.","poem":1},{"text":"An-abin e-gaya gasa imakdedamalad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dummadga-negdakmamaidse-bakale, an-asabinni binnasdikii sunmakdedamalad,","poem":1},{"text":"imbagwenale bar-sunmaksurdamalad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dulemar an-sunmaked itodmalale, nued angi sunmakdamalad.","poem":1},{"text":"An-dakdemalale, an-nug ogannoddamalad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dule-wilegana, anse wiledanikile, an bendakdaed.","poem":1},{"text":"Sergan-sated, an bendakdabalid.","poem":2},{"lineBreak":true},{"text":"Ar dule-e-bendakmalad sated.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dule-na-bela-itodimaladi, angi ise-nued binsadamalad.","poem":1},{"text":"Omegan-ei-sui-burgwismalad, an yeer-ito imakdabalid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"An gusgu igar-innikigwad an imakdaed,","poem":1},{"text":"an igar-sogmaidba ibmar imakdaed.","poem":2},{"text":"An we-ibmar-imakedi, mor-nued-yoeyobi anga gudaed,","poem":1},{"text":"gurgin-nued-sieyob anga gudaed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Dule-aku-atakmaladga e-ibyayobi an gudii gusad.","poem":1},{"text":"Dule-yaku-yaku-nanamaladga, e-maliyobi an gudii gusbalid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dule-ibmar-abesa-gudimaladga, an e-babyobi gudii gusad.","poem":1},{"text":"Dule-yar-baidsikmaladi, an bendaksabalid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dule-isganamar-e-gangued an obelosdabalid.","poem":1},{"text":"We-dulemar, bar emar-wiogega an imaksasulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"”An weyob binsadii gualid: ‘Undar an gudii guoye,","poem":1},{"text":"an-neggi nuedgi sereddii an burgoye.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Andi sapi-diwar-naba-gwichiyobi gued,","poem":1},{"text":"sapi-anagan boo-mutik-batedgi-obgwichiyobi an gued.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"An-nug-dummarba-maid berguosurye,","poem":1},{"text":"an-gargangued berguosurye,’ an binsadii gualid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"”Dulemar an-sunmaked-itodmalale, ise-itogar bukusdamalad.","poem":1},{"text":"Bogidikgi an-binsaed-uknaid itosigisdamalad.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"An-gayaburba-sunmakedi nue yeer itodamalad,","poem":1},{"text":"dule gwen an-abin-imakdasulid.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"An-sunmaked edarbedidamalad.","poem":1},{"text":"Igi dii-wied-edarbeledae,","poem":2},{"lineBreak":true},{"text":"deyobi, an-sunmaked-edarbedidamalad.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"An dulemarga allee gualile,","poem":1},{"text":"geger an-dakdamalad.","poem":2},{"lineBreak":true},{"text":"An-ega-allee gusale, e-niga ganguddamalad.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ani an ega igar oyodaed, ibi-igarba namaloe,","poem":1},{"text":"degi, ani an idumaidaed.","poem":2},{"text":"Rey e-sordamar-abargigudiiyobi, an emar-abargi gudidaed.","poem":1},{"text":"Dule-gwage-naibi-itodiid-baisur-itoge-imakedyob an gued.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/28.json","previousChapterAudioLinks":{},"numberOfVerses":25}