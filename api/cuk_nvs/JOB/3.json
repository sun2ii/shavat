{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":3,"content":[{"type":"heading","content":["Job e-iba-gwalulesadgi-isdar-sunmaknaid"]},{"type":"verse","number":1,"content":["Job na boniganba geg-itogusadgine, e-iba-gwalulesadgi isdar sunmakded."]},{"type":"verse","number":2,"content":["Job weyob sogded:"]},{"type":"verse","number":3,"content":[{"text":"“Ibiga an-iba-gwalulesad geg bergudibe.","poem":1},{"text":"Ibiga a-mutikidba soglenaigusdibe, ‘susugwa gwalulesye,’","poem":2},{"lineBreak":true},{"text":"a-mutikid nagussulina gadinad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"A-iba, negasichidga nagusana nuedinad.","poem":1},{"text":"Bab-Dummad, a-ibagi binsassulina gadinad,","poem":2},{"lineBreak":true},{"text":"a-ibagi negsichidbi nagusana nuedinad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"A-iba neg-gubyagwaledga nagusana gadinad,","poem":1},{"text":"a-iba mogir-sichidga nagusana nuedinad.","poem":2},{"lineBreak":true},{"text":"A-iba dad-ibeler-galegedyobi nagusana nuedinad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"A-neg-mutikidgi nega-gudureged nagusana gadinad.","poem":1},{"text":"A-iba, nii-gardamar-abargi-naidgi elilesunna,","poem":2},{"lineBreak":true},{"text":"a-iba, birgamar-ibagangi-naid elilesunna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"We-neg-mutikidgi geg dule gwalulegena gadinad.","poem":1},{"text":"We-neg-mutikidgi mer dule wergusunna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ibiga dule-ina-isgana-imakmaladi, we-iba-ukabsassurdibe.","poem":1},{"text":"Ibiga we-dulemar-ibdula-demarginedgi-gangued-nikamaladi, a-iba-ukabsassurdibe.","poem":2},{"lineBreak":true},{"text":"A-iba ukabsalesana, nuedinad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ibiga a-ibagi niisgwamar-bolego-noardaed nodibe,","poem":1},{"text":"ibiga a-ibagi dad-ibeler gasdibe,","poem":2},{"lineBreak":true},{"text":"dad-ibeler gassulina bur nuedin.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ibiga a-mutikidbali an gwalulesdibe,","poem":1},{"text":"emide, bonigan-gunaid mag-dakega an-imaknaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”Ibiga an sapidukugi-maigu, burgwissurdibe,","poem":1},{"text":"ibiga an gwalulenaigu, burgwissurdibe,","poem":2},{"lineBreak":true},{"text":"burgwisana bur nabirinad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ibiga an gwalulenaigu, an-abingasmardibe,","poem":1},{"text":"ibiga an gwalulesgua, an-onusmardibe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"An burgwisana, nue-imas an meremainad,","poem":1},{"text":"gwen itomaisulinad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Reymar-gannar-neg-dummagan-sobmalad-burgwismalad-abargi an obunnomainad.","poem":1},{"text":"Dule-dummagan-gannar-negdummagan-sobmalad-burgwismalad-abargi, an gabmainad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ar dule-nuga-nikamalad or-ibed-gudigusmalad-abargi, na e-neg-dummagangi ena mani-urbisgusmalad-abargi,","poem":1},{"text":"an nue-imas meremainad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Igi sikwi amba yoo aideged-iba-omoe burgwar-aidenonidae,","poem":1},{"text":"gwen-neg-daksasuli digleddae,","poem":2},{"lineBreak":true},{"text":"ayobi, ibiga an gussurdibe.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ar dule-isganamar burgwenonikile, ase e-ibmar-isgana-imaked bergusiid.","poem":1},{"text":"Ar dule-gegus-gudimalad burwa-dulega gunonikile, ase obunnosiid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ar dule-galesgudimalad burgwenonikile, ase na obunnosiid.","poem":1},{"text":"Degine, we-dulemar dummad-e-wiodiid-ese-iseedi-goledi, asega bar itogosurmalad.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ar dule-bulegana, degi, dule-belagwamaladi burwa-dulega gunonikile, bela na emarbi daklesiid, dule egi obined sulid.","poem":1},{"text":"Degine, dule-maiga-gudiidi burgwenonikile, geb na e-dummadgi ollorgusiid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"”Bab-Dummad, ¿ar ibiga be dule-naibi-itodiid gwalulegega be imaksa?","poem":1},{"text":"¿Ar ibiga be dule-isdar-itodiid dula-gudiguega be imake?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ar wemar burgwebigudidaenad, ar geg burgwesunnad.","poem":1},{"text":"Aisaar gwae burgwebigudidaenad, ibmar-nued-amidiiyobi, burgwed amididaenad.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ar wemar yeer itosmalaled,","poem":1},{"text":"geb neg-urba-aidedele, weligwar itogoed.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ar Bab-Dummad dulega igar-obured,","poem":1},{"text":"negsichigi aka-aka-gudidaeyobi, emar-imaked.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"An-akiginnedi dii-aryomaiyobi gued,","poem":1},{"text":"bane-bane-masgullegedyobi, an naibid itodiid.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Aka bur bule an ibmar-dobgudiid anga nagunonikid,","poem":1},{"text":"ar an ibmargi-gwayediid anga daklenonikid.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Neg-bogidikid bar anga naisulid, nue bar an obunnodisulid.","poem":1},{"text":"Unnila surbinsa-itogedbi an dakedisunnad.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}