{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":30,"content":[{"type":"heading","content":["Job, e-wilenaidba bukib-binsaed"]},{"type":"verse","number":1,"content":[{"text":"“Emisgindi, sapingan-burwigana anga alliardamalad.","poem":1},{"text":"Ar we-sapingan-e-babgana an-achu-sibad-wawaad-edarbemalad-edarbega an imaksasuliled.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ar anga-arbamarye-sogele, ¿ar ibu wis anga imaksamalale?","poem":1},{"text":"Ar bar gargangued nikasurmalad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"We-dulemar, neg-mutikidba negsulidganba gaamakdidamalad,","poem":1},{"text":"ukudmaada gudidamalad, boniganba galitodidamalad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"We-dulemar ibmar-gunnegala, gagan-moododba ibmar-gwag wedidamalad,","poem":1},{"text":"gagan-e-malimarse-bakale, gundii damarbalid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neggweburginbela isdar we-dulemar-dakdamalad,","poem":1},{"text":"atursamaladye gin sogdamalad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Agala, we-dulemar dian-dinnaganaba gudidamalad,","poem":1},{"text":"akwa-yaba, degi, ibegan-imbaba gudii damarbalid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Moli-uayasuid-goledyobi gagan-bulaba gormakdidamalad,","poem":1},{"text":"degine, ikoganba doge-doge gudidamarbalid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"We-dulemar dule-abelesurmaladid,","poem":1},{"text":"agala, neggweburgi ononnolesmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"”Emisgindi, aka we-sapinganga an dodogedga gued,","poem":1},{"text":"amar-oalledga an gued.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ima an-dakdemalad, deyob-an-dakedbali angi bangudmalad,","poem":1},{"text":"angi wii-minanai gusdamalad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Emidi, Bab-Dummad bela-bela mesagwar an-imaksasoggu, dule-an-bendaked-satesoggu,","poem":1},{"text":"anga bela-bela sabsur-ibmar sognanaid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dule-isganamar an-argan-nuedsiki angi noarmalad,","poem":1},{"text":"an-oitogegala, an-idu dukuar ambikusmalad.","poem":2},{"lineBreak":true},{"text":"Angi-gwisguegala, napa-nakwemai sobsamalad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"An-obelogegala, an-iduar gwisgunonimalad.","poem":1},{"text":"Dule-bargaed-sate, an-obelononimalad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Igi bila-onomalad igar-ollo-imaksamaladba danidae,","poem":1},{"text":"degi, galumar-ese-ailasmalad-birgi danidae,","poem":2},{"lineBreak":true},{"text":"deyobi angi gwisgunonimalad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ise an gwayale gusad,","poem":1},{"text":"an nug-nika bar an itonadsulid,","poem":2},{"lineBreak":true},{"text":"an-bendakleged mogirmar-yoggudeyob berguded.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"”Emisgindi, nue an-san bergudani an itoged,","poem":1},{"text":"nunmaked-dummad-ibagan an-wionaid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"An-garmarse-bakale, nunumaker an itogusad.","poem":1},{"text":"Abali, an mutikidba galitomaidaed.","poem":2},{"lineBreak":true},{"text":"Nunmaked gwen anga bergu an itosulid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bab-Dummadi dukarba-an-gasagunaiyob an-wionaid.","poem":1},{"text":"Akus-akus-bunnonaiyob an-imaknaid.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bab-Dummad olligangi an-barmeted,","poem":1},{"text":"ukubyobi, degi, buruyobi an-imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"”Bab-Dummad, an bese gornainad, gwen be an-itosulid.","poem":1},{"text":"Be-asabinni an gwisgunonikinad, gwen be an-daksulid.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bab-Dummad, gwen-sabe be an-imaksulid,","poem":1},{"text":"be-gangued-nikadba be an-baregindiid.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Igi ibmar burwaba-seleddae, deyobi, be an-imaksad.","poem":1},{"text":"Burwa-oored-dummad-abarse be an-barmeted.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bab-Dummad, neg-uan-urba be an-semaid an nue-wisid.","poem":1},{"text":"Dule-burgwisar-seleddaedse be an-semaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"”Dule-galakusmaidi, geg be bar sarsoged,","poem":1},{"text":"dule-suli-suli-itogedgi-bendakleged-egisnaidi, geg be bar wioged.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"¿Dule-boniba-galitodimaladba an bonai gussursi?","poem":1},{"text":"¿Dule-wilemalad an wiledaksasursi?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Anga-ibnued-gued an edarbediidgine, aka ibmar-isgana anga gunonikid.","poem":1},{"text":"Ibagan-nuegan an edarbediidgine, aka ibagan-isgana anga nagunonikid.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bane-bane sulibinsa an itodiid,","poem":1},{"text":"gwen baisur-itoge an gudisulid.","poem":2},{"lineBreak":true},{"text":"Unnila boniganba bane-bane an galitodiid.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"An wile-itodiid, an bodiidbiid.","poem":1},{"text":"Aisaar an, an-dulemarse bendakleged egisnaidaenad,","poem":2},{"text":"degi, an bendakleged abenaidaenad,","poem":1},{"text":"gwen an-bendaksurdamalad.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Emide, achu-sapur-e-gwenadganayob an gunonisunnad,","poem":1},{"text":"irmon-senigan-e-gwenadganayob an gunonisunnad.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"An-ukamar bela gudure naded, an-ukamar an-ibe yaas-yaas naded.","poem":1},{"text":"Uellegedbali an-uka-diopisuli an itoged.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"An-gar-arpa-goledi, wilesakwaa gorgusad,","poem":1},{"text":"an-gar-gammu-goledi, wilesakwaa gorgusbalid.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/29.json","previousChapterAudioLinks":{},"numberOfVerses":31}