{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":31,"content":[{"type":"heading","content":["Job, e-nanadiidba sunmaknaid"]},{"type":"verse","number":1,"content":["Job sogdebalid:",{"text":"“An weyob sogsanad:","poem":1},{"text":"‘An ome-gwensak-dakalile, bipisaale galagwensuli an egi binsaosurye.’","poem":2}]},{"type":"verse","number":2,"content":[{"text":"¿Ibu-ibmar-nued Bab-Dummad-Bur-Biriginedgine amilege?","poem":1},{"text":"¿Ibu-ibmar-nued Bab-Dummad-Bela-Gangued-Nikadgi nikulege?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"¿We-odurdaklegedde dule-isganamargadsursi?","poem":1},{"text":"¿Boni-dummagan-amilegedi dule-isganamargadsursi?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Dummad, ¿an-ibmar-nued-imakdiid daksursi?","poem":1},{"text":"Bab-Dummad, ¿an-nanadiid daksursi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"”An igar-isganaba nanasale,","poem":1},{"text":"an gakanginbi sunmaksale,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Dummad an-wilubdaksundo.","poem":1},{"text":"Geb agi Bab-Dummadi, an-ibmar-isgana-imakdisulidi dakoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"An ibmar-nued-imakedgi bangusale,","poem":1},{"text":"ibmar-isgana-imakedgi an binsadiile,","poem":2},{"lineBreak":true},{"text":"ibmar an atur-imaksa gudiile,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"an-ibmar-digsadi bela ani gunmarsundo.","poem":1},{"text":"An-nainugi-ibmar-naidi bela ani sumarsundo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"”Ome-gwensakse an binsaed galesale,","poem":1},{"text":"dule-an-neg-dikarbamaid-e-ome an argadii gusale,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"an-ome dule-baid-omega gusunnodo,","poem":1},{"text":"dulemar an-omebo galagwensuli gumarsunnodo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar deyob an ibmar imaknonikile, binged-dummad anga gunonikiled.","poem":1},{"text":"An sabsur-odurdaklegergebed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Soo-dummad-neg-gasayob gusaled,","poem":1},{"text":"an-nainumar bela gummaksayob gusaled.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”An-maiga-gudimalad anga sognonimalale,","poem":1},{"text":"be anga igar-maidba imaksasurye,","poem":2},{"lineBreak":true},{"text":"an ega igar nudakedsedaed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Degisulile, Bab-Dummad igar-itogega anse gollalile,","poem":1},{"text":"¿igi an abin sogosunna?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bab-Dummadi, we-napnegse-an-odenonikidid,","poem":1},{"text":"an-maiga-gudiid-odenonimogadid,","poem":2},{"lineBreak":true},{"text":"¿A-Bab-Dummadi emarbi sapidukugi anmar-mesissursi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"”Dule-wilemaladi ibmar-abealile, an ega ukdidaed.","poem":1},{"text":"Omegan-ei-sui-burgwismaladi, an ukudmaada imakdisulid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bipisaagwale walagwen an mas gundisulid,","poem":1},{"text":"sergan-satedga an mas ukdii gusad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"An sapingwad-akale, we-dulemarga e-babyob an gudii gusad.","poem":1},{"text":"An gwalulesad-akale, omegan-ei-sui-burgwismalad-bendakdii an gusad.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Dule-wilemaladi an morsuli imakdii gussulid,","poem":1},{"text":"an-wagab dule-wilegedi morsulidbali dambedba burgwissurgusad.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"An dule-wilegedga an-sibad-wawaad-mor uksagusad.","poem":1},{"text":"Degidbali, nuedye anga sogsagusad.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Dule-sergan-satedgi an dodossulid,","poem":1},{"text":"igar-itolealir, an-garganguedgi egi yolegodeeye an binsassulid.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"An yamo-gakansanaile, an-swidamar bela batesunnodo,","poem":1},{"text":"an-surgan-e-garmar-abingunanaidi bela bus-bus nosunnodo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"An gusgu Bab-Dummad-emar-sabsur-odurdakedgi dobekwaa gudiid.","poem":1},{"text":"Bab-Dummad uludele, e-gangued-asabin an gwisgussuliled.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"”Orginbi an atakdii gussulid,","poem":1},{"text":"orbina sulibinsa an itodii gussulid.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"An ibmar-bukidar-nikadba an na san dummarba imaksasulid.","poem":1},{"text":"An-arbasadba bukidar-ibmar-amisadgi an na san-dummarba imaksasulid.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Deginbali, dad-ibeler-ganai an dakdaed,","poem":1},{"text":"nii-bela-bela-ganaid nadapi an dakdaed.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Degi-inigwele, bipisaagwale, an emar-wagab we-e-nugmar odummodisulid,","poem":1},{"text":"arbakebela an odummodisurbalid.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"An we-ibmar-nug odummosana, an odurdaklegedinad.","poem":1},{"text":"Bab-Dummad-Bur-Biriginedgi an dummad-nosan-itole.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"”An-isdarmalad boniganse sabsur-odurdaklenaile, egi burgunai an gudisulid.","poem":1},{"text":"Egi boni-dummagan danikile, ega gwen an yeer itodisurbalid.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Degine, an-isdaradgi ukabsaale, an sunmakdisulid.","poem":1},{"text":"Ibiga wemar geg burgwedibeye, an sogdisurbalid.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Dule-gwensak an-negse-ataknadele, masgi an ogunnedsedaed.","poem":1},{"text":"Ukudmaada an barmidisulid.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Dule-ainebalid an-neggi an nuekwaa ogabdiid,","poem":1},{"text":"neg-magaba an ogabdisulid.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Dulemar-isgued-odukuedyobi an-isgued an odukudisulid.","poem":1},{"text":"Dulemar-dobedba, an-ibmar-oakalosad odukuodeeye an binsadisulid.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"An-gwenadgan-isdar-an-dakmalad-abin an boo sigissulid,","poem":1},{"text":"amar-abin an gayamaklessulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"”Bitigi Bab-Dummadi an-itosana gadin.","poem":1},{"text":"Bab-Dummad-Bela-Gangued-Nikadi an-abin-imaksun.","poem":2},{"text":"An-sunmaksadi, gardagi ise-narmakar an messunnad.","poem":1},{"text":"Bab-Dummad angi akar-sogbiele, anga narmakar mesmosunna.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Bab-Dummad-akar-angi-sogoedi, nuedgi an sedii guoed,","poem":1},{"text":"ologurginyobi an sii gudigusaled.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Bab-Dummad-asabin an gwisgudapile, bela an na barsogoed.","poem":1},{"text":"Gwen an Bab-Dummad-asabin bingeguosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"”An-nainumar angi gwisgunanaile,","poem":1},{"text":"bela napa-imulesmaladi boedbimalale,","poem":2}]},{"type":"verse","number":39,"content":[{"text":"gwenadgan-ibe, ibmar-gwag-bennussuli an guchale,","poem":1},{"text":"degine, e-ibmala-yardaknai an gusale,","poem":2}]},{"type":"verse","number":40,"content":[{"text":"an-nainugi trigo-digaled-muchubbi, gagan-ikobiid ainisundo.","poem":1},{"text":"An-nainugi cebada-digaled-muchubbi, gagan-isgana ainisundo.”","poem":2},{"lineBreak":true},"Job-sunmaked wese bergunaid."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}