{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":32,"content":[{"type":"heading","content":["Eliú sunmakdemogad"]},{"type":"verse","number":1,"content":["Job-e-aimar-warbaagwadi magar-itosmargua, Job na ibmar-oakalodisurye-sognaidi, bar abin-imaksasurmalad."]},{"type":"verse","number":2,"content":["Degine, sapin-gwensak Eliúʼye-nugadi, Job-sunmaked-itosgua, Jobʼde inniki-gudiiye, degine, Bab-Dummad egi ichakwa-binsamaye sogsad-itosgua, Jobʼse sabsur-uluded. Eliúʼde Baraquel-machid, Buz-e-wagwad, dad-dummad-Ramʼgi danikidid."]},{"type":"verse","number":3,"content":["Deginbali, Eliú, Job-e-aimar-warbaagwad nue-Job-abin-imaksasurmaladba, degi, Jobʼgi-ataknaigusmaladba amargi uludbalid."]},{"type":"verse","number":4,"content":["Eliú iduar sunmakbigusanad. Ar Eliúʼdi bur sapingwasoggu, e-aimar-eba-selegan-inse Jobʼga sunmaked edarbisgweled, adi, a-sorba sunmakegar."]},{"type":"verse","number":5,"content":["Ar Eliú dakdegua, e-warbaagwadi, gwen bar sunmaksurmala, degidbali, na san bargassuli, nue-ulude gusad."]},{"type":"verse","number":6,"content":["Geb Buz-e-wagwa Baraquel-machi-Eliú sunmakded. Weyob sogded:",{"text":"“Andi amba bemar-imbagi sapingwagwad, bemardi bato uka-sele-selebagusad.","poem":1},{"text":"A-ulale, an bemar-abin-sunmakegala, dobe sunmakdaed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"‘Bur ibmar-wismalad-inse sunmakmaloye, an binsasad.","poem":1},{"text":"Uka-selebamalad-binsaed-nikamalad-inse, neg-dakdiidba sunmakmaloye an sogsad.’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Dummad-Bela-Gangued-Nikad-e-burba,","poem":1},{"text":"dulegi-maidi magar neg-ito emar-imaked.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dule-serganbi binsaed-ibegan gusulid,","poem":1},{"text":"dule-birga-seleganbi magar-ibmar-ito gusulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Degisoggu, bemar, nue be an-itomalo,","poem":1},{"text":"an ibmar-soggwen-soged nikamogad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bemar sunmaknaigua, boo an bemar-itosad.","poem":1},{"text":"Bemar-binsamalad, degine, bemar binsaed-akar-akar-sognanaigusmalad, an nue itosad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nue an bemar-itosii gusad, bemar gwen oyossulid, Jobʼde nue-nodii gusye.","poem":1},{"text":"Deginbali, Job-sunmaksad bemar nue-abin-imaksasurbalid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mer be anga sogmalo:","poem":1},{"text":"‘Anmar binsaed-nikaa gumarye.","poem":2},{"text":"Bab-Dummadbi Job-abin-imakye,","poem":1},{"text":"dulemardi Job-abin-imaksurye.’","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Job anga sunmaksasursoggua,","poem":1},{"text":"an bemaryob Jobʼga ibmar sogosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"”Job, wemar-warbaagwadi gege bar be-abin-imakmalad,","poem":1},{"text":"ar aku itonanaid, e-binsaed galakudmalad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wemarde bar sunmaksurmarsoggua,","poem":1},{"text":"¿geg an bar sunmakmosunde? Suli. Andi sunmakoe.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"An ibmar-soged nikamogad,","poem":1},{"text":"an-binsaed an bega sogmogoed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"An ibmar sogebier-itosoggua, burba-angi-maidi sunmakebier an-imaksoggua,","poem":1},{"text":"an ibmar sogmogoed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"An-gwage-itolegedi, vino-e-bugluyaba-mus-musmaksiiyob an itoged.","poem":1},{"text":"Vino e-buglu-binidgi-siidyob-marebieyob an itoged.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"An sunmakergebed, adi, an nabir ollorgudoed.","poem":1},{"text":"An bega ibmar sogergebed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Emarba-nai an sunmakosulid,","poem":1},{"text":"emar-nabir-obinsaega an sunmakosurbalid.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yogasaar-gakansaale an emargi nued sunmakosulid.","poem":1},{"text":"An deyob imakdele, Bab-Dummad-we-napnegse-an-odenonikid, sabsur-an-odurdako itole.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/31.json","previousChapterAudioLinks":{},"numberOfVerses":22}