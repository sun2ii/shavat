{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":33,"content":[{"type":"heading","content":["Eliú, Jobʼse ulusad"]},{"type":"verse","number":1,"content":["Eliú sogdebalid:",{"text":"“Job, wis be an-itomogo,","poem":1},{"text":"an-sunmakoed nue be itogo,","poem":2},{"lineBreak":true},{"text":"bela an bega ibmar-sogoed nue be itogo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Emiskwaa an bega sunmaksokalidi,","poem":1},{"text":"bela an bega ibmar sogedsegad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"An-sunmakoedi, an-gwagegi innikigwadba an bega sunmakoed.","poem":1},{"text":"An-gwabinduku gakansaale bega ibmar sogosulid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Dummad-Burba an-obinnisad,","poem":1},{"text":"Bab-Dummad-Bela-Gangued-Nikad burba anga uksad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Be nabir an-abin-imakele, be an-abin-imakodo.","poem":1},{"text":"Sunmakega be guakwaa sigo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Dummad-asabinni, anmar anbogwa na emalad,","poem":1},{"text":"anmar napsagi danikid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Degisoggu, mer be an-abin gwayo,","poem":1},{"text":"an begi obinsurmogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”Job, be-sunmaked an wis-itosad,","poem":1},{"text":"weyob sognaiyob an be-itosad:","poem":2}]},{"type":"verse","number":9,"content":[{"text":"‘An isgudisurye, isgued angi maisurye,","poem":1},{"text":"an ibmar oakalodisurye.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Emisgindi, Bab-Dummad, ibmar-oakalosadyob an-dakdeeye,","poem":1},{"text":"e-isdaradyob emisgindi an-dakmaiye.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Dummadi naggi esgoro-dubgi an-edichaye,","poem":1},{"text":"bane-bane angi nakuledigussunye.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":["Eliú sogdebalid:",{"text":"“Job, degiirdi nabir, an bega sogo.","poem":1},{"text":"Be we-ibmar-sogsad, be noar soged.","poem":2},{"lineBreak":true},{"text":"Ar Bab-Dummadi dulemarba bur dumma maid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"¿Ibiga Bab-Dummadgi be deyob sunmake?","poem":1},{"text":"¿Bab-Dummad be-abin-imakergebye, be sogsunde? Degisuli, be dummad nodiid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ar Bab-Dummad anmarga sunmaked,","poem":1},{"text":"gusgu bane-bane anmarga sunmakmaid,","poem":2},{"lineBreak":true},{"text":"degi-inigwele, dule itosurdaed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Imbagwena, anmar-ise-gabar-maidgine, yakumaksiidgine, Bab-Dummad gabdakedba anmarga sunmaked,","poem":1},{"text":"negburgan-dakedgine anmarga sunmakdabalid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bab-Dummad anmarga sunmaked,","poem":1},{"text":"ibmar-danikidgi anmar-owisogedba dule-ogwayed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bab-Dummad ibmar-isganagi-banguegala anmar-owisobalid,","poem":1},{"text":"mer anmar san-dummarba-imakdiguegala, anmarga sunmaked.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mer burgwed-igar-itogegala,","poem":1},{"text":"mer es-suidse-burgwegala, anmarga sunmaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"”Imbagwenale, Bab-Dummad anmar-odurdakegala, boniganba gala-itogega anmar-imaked","poem":1},{"text":"anmarga abagan-nunmakedi uked.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Degidbali, san-nuegan-gullemalad, isdarsunna be dakdoed,","poem":1},{"text":"degisoggu, mas-gunbi bar be itogosulid.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Anmar-abaganmar bela malemai gudoed,","poem":1},{"text":"garmar-mamaid magar-daklege gudoed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Be-burba burwaga-gued-ibaganse warmakdanikid,","poem":1},{"text":"neg-uangi-meged modanikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"”Baliwiturmar-miligwen-bukwad-abargine (1,000), baliwitur-gwensak dule-bendakegala gwisgunonisunnad.","poem":1},{"text":"We-baliwiturde, ibu-imakoye ega sognonisunnad.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"We-baliwitur wile-dule-dakedbali, Bab-Dummadse weyob wilesakwaa egisdesunnad:","poem":1},{"text":"‘Bab-Dummadye, we-dule mer napa-urba-megega be imakye.","poem":2},{"lineBreak":true},{"text":"Ar we-dulega ollor-gued-igar maiye.’","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Agine geb, dule gannar nuchukwaa gunonikiled,","poem":1},{"text":"bipigwaun-gudigusayob gunonikiled.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Agine, geb dule Bab-Dummadse gotoed, geb Bab-Dummad na abinsaoed.","poem":1},{"text":"Degidbali, dule Bab-Dummad-wagar nabir daknonikoed.","poem":2},{"text":"Degi, weligwar-itogedba na binnasur-gornai gudoed.","poem":1},{"text":"Geb Bab-Dummad ibmar-oakalossuliyob dule-daknonikoed.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Deyob geb dule, dulemarga weyob sognai gudoed:","poem":1},{"text":"‘Amba an nue isgus-inigwele, an igar-inniki-maidgi yolenoni-inigwele,","poem":2},{"text":"an sabsur-odurdaklegewilubbinye,","poem":1},{"text":"degite, an deyob odurdaklessurye.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ar Bab-Dummad burgwedgi nue-an-bendaknonisoggua,","poem":1},{"text":"emisgindi, an dula-gudiidi, an nabir neg-itodisunnad.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":["Eliú sogdebalid:",{"text":"“Bela we-ibmarmar, Bab-Dummad imakmaid,","poem":1},{"text":"ilabigwa dulemarga imakbie, Bab-Dummad na e-sogedba imakmaid.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Burgwedgi anmar-bendakmaid,","poem":1},{"text":"degine, nued-gudii anmar-imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"”Job, nue be an-itoge.","poem":1},{"text":"Mer be sunmake. Ani an sunmaknaid.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Be ibmar-soged-nikamogale, be an-abin-imakmogodo.","poem":1},{"text":"Be nabir sogele, an nuedgi be-itogoed.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Degisulile, nue-bogimakale, be an-itoge.","poem":1},{"text":"Nabir-binsaed-nued-nikuega an be-imakoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/32.json","previousChapterAudioLinks":{},"numberOfVerses":33}