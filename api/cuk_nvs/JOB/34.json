{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":34,"content":[{"type":"heading","content":["Eliú soged, Bab-Dummad ibmar napira sogye"]},{"type":"verse","number":1,"content":["Eliú sogdebalid:"]},{"type":"verse","number":2,"content":[{"text":"“Bemar-binsaed-ibegan-gumalad, nue an-sunmaked be itomalo.","poem":1},{"text":"Bemar-nue-ibmar-wismalad, nue be an-itomalo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ar igi anmar-gwabin magasar yeer masgulleged-itoge,","poem":1},{"text":"deyobi, uaya magasar gayaburba yeer itomogad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Degisoggu, anmar, we-igar bulakwaa daksunnodo,","poem":1},{"text":"anmar igar-nuedse bulakwaa onogoed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":["Eliú sogdebalid:",{"text":"“Ar Job weyob sogye:","poem":1},{"text":"‘An ibmar-oakalossurye,","poem":2},{"lineBreak":true},{"text":"Bab-Dummaddina deyob an-daksurye.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"An dule-nued-gudi-inigwele, dule-gakansaedyob daklesunye.","poem":1},{"text":"Amba an ibmar-akar-imaksasur-inigwele, Bab-Dummaddi nue-naibi an-imaknaiye.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"¿Ar bia be dule Jobʼyobid dakdimala?","poem":1},{"text":"Ar we-dule unnila Bab-Dummadgi dododiid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”Ar Jobʼde, dule-isganaba akadigued bur yeer itodaed,","poem":1},{"text":"dule-isganamarba bur gudii gubidaed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Job anmarga sogbalid,","poem":1},{"text":"‘Bab-Dummadba-ibsalegedi, dule gwen ibmar-nued egi amisurye.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Bemar dule-machergan-nue-binsaed-nikamalad, nue be an-itomalo:","poem":1},{"text":"Anmar geg soged, Bab-Dummaddi, ibmar-isgana nabir-imakye,","poem":2},{"lineBreak":true},{"text":"Bab-Dummad-Bela-Gangued-Nikaddi, sunna ibmar noar-imakye.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Dummad dule-na-ibmar-imakedbali, dulega ibmar uked.","poem":1},{"text":"Dule-daedbali dulega ibmar imaked.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Geg anmar sogbalid, Bab-Dummad ibmar-isgana imakye.","poem":1},{"text":"Bab-Dummad-Bela-Gangued-Nikadi, igar-inniki-maid oichobarye.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bab-Dummad we-napneg-seega, ¿doa ega gargangued uksa?","poem":1},{"text":"¿Doa Bab-Dummadga negseed-igar uksa?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ar Bab-Dummad anmargi burba-dula-maid gannar suye-sogele,","poem":1},{"text":"anmar-bunnodiidi obeloye-sogele,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"bela dule-gudimaladi bergudmalaled,","poem":1},{"text":"dulemar bela napaga binnidmalaled.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"”Job, be we-ibmar magasar-itodibe,","poem":1},{"text":"an-ibmar-sogoed, nue be itogodo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"¿Sunna dule ibmar-isgana-imakdiidi, nabir negseosi? Suli. Geg gue.","poem":1},{"text":"Degisoggu, gege be Bab-Dummad-innikigwadgi, bela-gangued-nikadgi be yoleged.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Reymar, degi, dule-dummagan isganamalale,","poem":1},{"text":"ar Bab-Dummad gwen binsaosulid mer an oakalogodeeye.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bab-Dummad dule-negsemaidba nagusulid.","poem":1},{"text":"Degi, dule-mani-ibedba nagusulid,","poem":2},{"text":"dule-mani-satedba nagusurbalid, bela emarbi daked.","poem":1},{"text":"Bab-Dummad bela emarbi amar-imaksad.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dulemar ukiagwar mutikidba burgwiddamalad.","poem":1},{"text":"Dulemar oimakbukwadamalad, degi, berguddamalad.","poem":2},{"lineBreak":true},{"text":"Dule-bulegan-negsedimaladi, negsediidgi dule-oakalossuli ukiagwar egwalleddamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"”Bab-Dummad bela dulemar-gudiid dakmaid,","poem":1},{"text":"bela dulemar-e-gudiidgi nakulediid.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Dule-isganamarde negsichidgi, neg-guduregedgi dukuye-sogele,","poem":1},{"text":"gege amba Bab-Dummadgi dukued.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bab-Dummad, dulega igar-nabogega","poem":1},{"text":"dulega iba messulid.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bab-Dummad dule-bulegan-negsemamaid-onogegala, igar-amiegala, emarse idaksulid.","poem":1},{"text":"Amar-muchub dule-baid omesed.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bab-Dummad dulemar-ibmar-imaked bela wisid,","poem":1},{"text":"mutikidbali egi gwisgued, bela ese ibitomalad.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bab-Dummadi, bela dulemar dakmalaga,","poem":1},{"text":"dule-e-isguedbali, dule-sabsur-odurdaked.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Dulemar Bab-Dummadgi-banguddamaladbali, degi, eba ibsasurdamaladbali,","poem":1},{"text":"deyob gunonidamarsunnad.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Degine, wemar sabsur dule-wilemalad-obosmalad, sabsur dule-ibmar-abese-gudimalad-wiosmalad.","poem":1},{"text":"Degidbali, Bab-Dummad dule-wilemalad-e-ogormaked itosad.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ar Bab-Dummad ibmar sogsulile,","poem":1},{"text":"¿doa ega akar sogosunna? Dule geg ega akar soged.","poem":2},{"text":"Ar Bab-Dummad dule-idu wagar-odukuele, ¿doa e-wagar dakosunna?","poem":1},{"text":"Bab-Dummadi, bela dulemargi nakulemaid,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"adi, dule-isganamar mer negsemalagar,","poem":1},{"text":"degi, mer dulemar-yardakdii gumalagar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"”Job, amba be Bab-Dummadga weyob sogele:","poem":1},{"text":"‘Nabirye, nue an nosye, bar an begi yolegosurye.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Be an-odurdaksunye, magar-neg-itogedse be an-imakye.","poem":1},{"text":"An ibmar-isgana-imaksadi, bar an imakosurye.’","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Job, be deyob sogdibe, degite, be Bab-Dummad-obacha-inigwele,","poem":1},{"text":"¿Bab-Dummad bega be-ibmar-abeged uked abesunde? Sulirgebed.","poem":2},{"text":"Andi be-ular sogosulid, ar bee be sogoedid.","poem":1},{"text":"Degisoggu, na be-binsaedi be soge, igi na be binsae.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"”Bemar, an-itobukwadi dule-binsaed-ibeganad, be magar neg-itomaladid.","poem":1},{"text":"Degisoggu, be anga sogmardo:","poem":2}]},{"type":"verse","number":35,"content":[{"text":"‘Job yogasaar sunmakye,","poem":1},{"text":"e-sunmakedi gwen binsaed-nika itolesurye.’","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ar Job-e-sunmakedi dule-isganayobi anmarga sunmaked.","poem":1},{"text":"Degisoggu, bela-bela Job-gudiid nue-wisguleged abeleged.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Job unnila dule-isganabisulid, uayasulidbalid. Ar anmar-wagab anmargi dododiid.","poem":1},{"text":"Ar Bab-Dummadgi, bela-belad ise-yolegar sunmaksad.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/33.json","previousChapterAudioLinks":{},"numberOfVerses":37}