{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":35,"content":[{"type":"heading","content":["Eliú-sunmaked-ilapaagwad"]},{"type":"verse","number":1,"content":["Eliú sunmakdebalid, weyob sogded:"]},{"type":"verse","number":2,"content":[{"text":"“Job, nabir ibmar-sognaiye be sogsunde, bede soged:","poem":1},{"text":"‘Bab-Dummadba bur an ibmar innikii imakdiiye.’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Emisgindi, be Bab-Dummadga weyob sogbalid:","poem":1},{"text":"‘¿An isguye sogele, akarsi?","poem":2},{"lineBreak":true},{"text":"An-isguedde, ¿igi-be-imaksunna?’","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Job, degiir nabir, an bega ibmar soggwelo,","poem":1},{"text":"be-aimarga an ibmar sogmogwelo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Niba be atakena, nue nuu be dakena,","poem":1},{"text":"mogir-naid be dakena.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ar be isguye-sogele, ¿ibugi be Bab-Dummad oakalogosunna?","poem":1},{"text":"Ar be ichesur isgudisogele, gwen be Bab-Dummad-oakalogosulid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ar be nued-ibmar-imakdiiye sogele, Bab-Dummadga ¿ibu be ukosunna?","poem":1},{"text":"Ar Bab-Dummad egi ibmar-nued amiosulid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ar be ibmar-isgana imakdibe, be ibmar-nued imakdibe,","poem":1},{"text":"unnila be-abargi-gudimaladi, beba wilegoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"”Ar neg nue-isgusnaisoggua, dulemar na bendakleged amidimalad.","poem":1},{"text":"Dule-bulegan-emar-wionaidgi-noegala, bendakleged egisnanaid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Degi-inigwele, dule gwen sogsulid:","poem":1},{"text":"‘Bia Bab-Dummad-an-obinnisad nadye.","poem":2},{"text":"Mutikidba an-niga-ogannoardaedi,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ibmar-durganba, bur ibmar-wisi-anmar-imakedi, ¿bia nadsunye?","poem":1},{"text":"Sikwimarba bur binsaed-nued-anga-ukedi, ¿bia nadsunye?’","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ar dulemar Babse gornanai-inigwele, dule-isganamarsoggu, na san-odummogedginbi binsadimarsoggu,","poem":1},{"text":"a-ulale, Bab-Dummad we-dulemar-abin-imaksulid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"A-ulale, Bab-Dummad-Bela-Gangued-Nikadi, binsarsunna-ibmar-egisnanaid itosulid,","poem":1},{"text":"Bab-Dummad a-dulemar baisur-daked.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Amba be sogdibe: ‘An Bab-Dummad daksurye,’","poem":1},{"text":"degi-inigwele, amba be-igar itolegedsegad,","poem":2},{"lineBreak":true},{"text":"degisoggu, be Bab-Dummad-edarbedsegad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bede soged, ‘Bab-Dummad wissur-urweye,","poem":1},{"text":"wissur-emar-sabsur-odurdakye, degine, ibmar-isgana baisurdakye.’","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Job, be yogasaar sunmaked,","poem":1},{"text":"binsa-ee-be gwichid, binsaedsuli be sunmaked.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}