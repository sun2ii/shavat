{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":36,"content":[{"type":"heading","content":["Eliú-sunmaksad-ilabakegwad"]},{"type":"verse","number":1,"content":["Eliú sunmakdebalid, weyob sogded:"]},{"type":"verse","number":2,"content":[{"text":"“Ar an Bab-Dummadgi amba an nued bega ibmar-soged-nikasoggu,","poem":1},{"text":"mer be budar itogo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"An-bela-bela-nue-ibmar-wisid an bega oyogwelo.","poem":1},{"text":"Abali an bega oyogoed, Bab-Dummad-an-obinnisadi innikii ibmar imakmaiye.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inniki an bega soged, bega an gakansaosulid,","poem":1},{"text":"an be-asabinni dule-binsaed-ibed gwichid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"”Bab-Dummad dule-gandikidid, dule-ibmar-oakalodisulid obandisulid.","poem":1},{"text":"Bab-Dummad gandikidid, bela magar neg-itomaid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Dummad dule-isgana gudiguega imaksulid.","poem":1},{"text":"Dule-wiledimaladgardi igar nabiroged.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Dummad dule-nuegan nue-akwed,","poem":1},{"text":"dule-nuegan reymar-abargi-sigega imaked,","poem":2},{"lineBreak":true},{"text":"degine, dule-nuegan-nugmar odummoged.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ar we-dulemar esgaryagi-sigega galenonikirdi,","poem":1},{"text":"wile-itoged egi dognonikirdi,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Dummad we-dulemarga e-isgusad ega oyonaido,","poem":1},{"text":"degine, ega oyonaibardo, na san-dummarba-imakedbali igi-isgusmala.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Degidbali na magar itomaloed, wede Bab-Dummad ega sunmaknai,","poem":1},{"text":"be nue-nanamarye, ibmar-isganagi be bangumarye.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar we-dulemar Bab-Dummadba ibsaele, Bab-Dummadga arbadele, e-burgwedse nasgumai gumaloed,","poem":1},{"text":"weligwar-gudii gumaloed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ar Bab-Dummadba ibsasurmalardi, wisguosuli ukiagwar es-suidgi burgwenonimaloed,","poem":1},{"text":"binsaedsulidbali burgwenonimaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”Dule-isganamar na sae-itodamalad.","poem":1},{"text":"Amba Bab-Dummadse sabsur-odurdaklenaile, bipisaale bendakleged egisdasurmalad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bab-dummaganse-goled-neggi-dule-gambasamalad-burgweyobi,","poem":1},{"text":"nuchukwaa burgwiddamalad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bab-Dummad dule-wiledimalad e-wilediidgi bendaked.","poem":1},{"text":"E-nunmaked-itodiid, baisur-itogega imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"”Job, ar Bab-Dummad bonigangi be-bendakoed,","poem":1},{"text":"neg-nuedse be-ogwisgunonikoed,","poem":2},{"lineBreak":true},{"text":"bega mas-nuegan ena be-mesegi urboed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Emide, dule-isganamar-wilubdaklegedyob be gunaisunnad,","poem":1},{"lineBreak":true},{"text":"igar-nabolegedse be gales gunaisunnad,","poem":1},{"text":"igar-inniki-imaklegedse be odurdaklegega gunaisunnad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"¡Degisoggu, nue salak!","poem":1},{"text":"Abakalegi be manibina surbinsa itodager,","poem":2},{"text":"manise be binsaed-galenai gudager,","poem":1},{"text":"ese be baklenai gudager.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Be mani-ibedguedgi be bendaklegosulid,","poem":1},{"text":"be-garganguedgine be bendaklegosurbalid.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Neg-mutikid be edarbedii gudager, mer abdako.","poem":1},{"text":"Ar mutikidba dulemar obeloleged.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nue salakar. Mer be gannar ibmar-isgana-imakedgi binsao.","poem":1},{"text":"Ar be ibmar-isgana-imakdigusadba be wilesad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"”Bab-Dummad na e-ganguedba gannarba maid.","poem":1},{"text":"¿Dule Bab-Dummadyob dule-odurdaked-saila gudii? Sate.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"¿Doa Bab-Dummadga sogoe, ibiga be deyob ibmar imaknaiye?","poem":1},{"text":"Gege dule Bab-Dummadga weyob sogbalid,","poem":2},{"lineBreak":true},{"text":"noar be ibmar-imaksaye.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bab-Dummad-ibmar-imaked be gatik-ogannogo,","poem":1},{"text":"ar namaklegedba we-ibmar-ogannolenai gusad.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bela dulemar Bab-Dummad-ibmar-imaksadi dakmalad.","poem":1},{"text":"Ar dulemar dikasuli Bab-Dummad-ibmar-imaksadi sunna bela dakmalad.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bab-Dummad dule-dummad-maisoggu, degidbali, gege anmar e-daed baramied,","poem":1},{"text":"e-birga-nikadi gege anmar wisgubalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"”Bab-Dummad anmarga dii barmimaid,","poem":1},{"text":"dii-wiedbali diwar-enguega imakmaid.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Mogirmar-dii-owiega imaked,","poem":1},{"text":"bela-belad dulemargi dii-owiega imaked.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"¿Doa wisguoe, ibiga mogirmar nanae?","poem":1},{"text":"¿Doa wisgubaloe, mar-gollalile bia noardae?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Bab-Dummadi, demargine mar-gaedi barmied,","poem":1},{"text":"degidbali, magatiba demar-naid magar-daklege imaked.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Bab-Dummad bela dulemar-yar-baid-baidgi-bukwamalad semaid,","poem":1},{"text":"mas-bukib ega ukmaid.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Bab-Dummad mar-dakarmakmaid e-argangi gaed,","poem":1},{"text":"bia mar-odebie, na e-sogedba mar-odeged.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Mar-goled Bab-Dummad-maid oyoged,","poem":1},{"text":"mar-goledi, Bab-Dummad-sae-itogedi oyoged.”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}