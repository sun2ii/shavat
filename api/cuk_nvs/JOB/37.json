{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":37,"content":[{"type":"verse","number":1,"content":["Eliú sogdebalid:",{"text":"“An we-ibmar-dakdedbali, an-gwage dik-dik-naded,","poem":1},{"text":"ber an-gwage noebieyob an itoged.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Be nue itomala, Bab-Dummad-e-sunmaked mar-gollomakeyob-sunmaked be itomala,","poem":1},{"text":"binnasuli-sunmaked be itomala.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Dummad e-mala-ibyedi, bela nibneg-gaed,","poem":1},{"text":"e-ibyemaidi, bela napneg-ugakaasega ibyed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Dummad-e-sunmakedi, binnasur-itoleged,","poem":1},{"text":"e-mala-ibyedi, galesulid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Dummad binnasuli-sunmakdele, ibmar-gegerdakleged oyoardaed.","poem":1},{"text":"Anmar-ibmar-magar-itosulid oyoardaed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Dummadi, boo-batedga igar-ukdaed,","poem":1},{"text":"‘¡Napase batemaloye!’ ega sogdaed.","poem":2},{"text":"Dii-wiedga igar-ukdabalid,","poem":1},{"text":"‘¡Be-gangued-oyomaloye!’ ega sogdaed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Dummad deyob ibmar-imakedbali, dulemar bar aineba ainidasurmalad,","poem":1},{"text":"adi, Bab-Dummad-ibmar-imakmaid magasar dakdamalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ibmar-durgan na dukuegala, e-dukued-yaba na bukusdamalad,","poem":1},{"text":"agine na dukubukusdamalad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dad-nakwed-argan-nuedsik burwa-goledba, burwa-oored danidaed.","poem":1},{"text":"Dad-nakwed-argan-sapiledsik burwa-goledba, neg-dambed danidaed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Dummad-bunnogedbali, dii gwamakleddaed.","poem":1},{"text":"Bela dii-dummad-naidi negdammipegwadba dutusuli naddaed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Dummadi dii-wiedi mogirmargi urbed,","poem":1},{"text":"degidbali, a-mogirmargi mar-ibyedi onoged.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"We-mogirmar napneg-naid ebirbukwad.","poem":1},{"text":"Bab-Dummad-ega-igar-mesisadba iirmakbukwad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bab-Dummad na e-sogedba dii owied,","poem":1},{"text":"imbagwenale, dulemarga dii-wiedi ibnuedga gued,","poem":2},{"lineBreak":true},{"text":"imbagwenale, dulemarga dii-wiedi dule-wiogega gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"”Job, nue be itogo,","poem":1},{"text":"Bab-Dummad-ibmar-gegerdakle-imaksadgi be binsagwelena.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"¿Be wisi, igi Bab-Dummad mogirmar see?","poem":1},{"text":"¿Be wisi, Bab-Dummad mar-ogaega igi imake?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Degite, be soged, bela an ibmar wisye.","poem":1},{"text":"Be anga sogdo, ¿igi Bab-Dummad niba mogirmar-naguega imake?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Emide, dad-nakwed-argan-nuedsik burwa-ued-danikidbali,","poem":1},{"text":"mor-yoid be geger itodaed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bab-Dummad nibneg-egasadgi, esgoro-gordikidiyob daarmakar-nasiksadgi,","poem":1},{"text":"¿be Bab-Dummad-bendaksasi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"”Anmarga be soge, igi anmar Bab-Dummad-abin-saoe.","poem":1},{"text":"Anmardi ibmar-wissursoggu, geg anmar Bab-Dummad-abin-imaked.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ar Bab-Dummadi an-ibmar-sogedi, ¿dule-baid-ega-soged abege? Suli.","poem":1},{"text":"¿Doa ega ibmar akala sogosunna? ¿Doa ese burgwebisunna?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"”Mogir dad-irwa-naid dadgi banguddibe,","poem":1},{"text":"gege dule dad-ganaidgi ataked.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Emide, dad-nakwed-argan-sapiledsiki neg dakarmakdanikid.","poem":1},{"text":"Bab-Dummad danikid, bela-bela e-gargangued-yeerdaklegedba danikid.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Anmar gege Bab-Dummad-Bela-Gangued-Nikadyob gued.","poem":1},{"text":"E-gangued-maidi bipisuli maid.","poem":2},{"text":"E-ibmar-inniki-imakedi, degine, e-igar-nabogedi yeer gangu maid,","poem":1},{"text":"mesagwar emar-imaksulid.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bab-Dummad, dule-na-ibmar-wisirbaye-sogdiidi, gwen ibmar-wisi daksulid.","poem":1},{"text":"A-ulale, dulemar Bab-Dummad-dobmalad.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/36.json","previousChapterAudioLinks":{},"numberOfVerses":24}