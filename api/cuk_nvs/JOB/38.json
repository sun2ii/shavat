{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":38,"content":[{"type":"heading","content":["Bab-Dummad dulemar-sunmaksad-abin-sogsad"]},{"type":"verse","number":1,"content":["Bab-Dummad burwa-ooreged-bipirmaknaidba Jobʼga sunmakded. Weyob ega sogded:"]},{"type":"verse","number":2,"content":[{"text":"“¿Be doasunna? Emide be, an-binsaed-nikarbadgi be bengunaigu.","poem":1},{"text":"Emide be, binsaedsuli sunmaknaigu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Be an-abin gwisgudena, an bese egisodo,","poem":1},{"text":"bule be an-abin-imakodibe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"”An napneg-e-sailamar-urbenaigua, ¿bia be gudiinsunna?","poem":1},{"text":"¡Anga be sogena, be nue-ibmar-wisye soged!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"¿Doa napneg-naid-e-dungued imaksa?","poem":1},{"text":"¿Doa napneg-dungued wilubdaknai gusa?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Napneg-e-sailamar, ¿ibu-birgi bukwasunna?","poem":1},{"text":"¿Doa degite, e-akwasaila sisasunna?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Deunni, niis-buksurmar namaknanaigu,","poem":1},{"text":"degi, baliwiturmar yeer-itogedba oichomaknanaigu, ¿be gudii? Be gudisulid, be sated.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”Deunni, demar napagi-nagudgua,","poem":1},{"text":"¿doa ega abingued-igar mesissunna?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"An demargala moryobi mogirmar nasiksagua,","poem":1},{"text":"degi, ega garsonyobi mogirmar-gudureged nasiksabargua, ¿be gudii?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani an demarga abingued-igar nasiksagua, yawagak-dummaganyob ega an nasiksagua,","poem":1},{"text":"e-yawagakgi yabiyob ega an nasiksabargua, ¿be gudii?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Demarga an weyob sogsagua: ‘Wese be warmakoed, bar be naosurye.","poem":1},{"text":"Be-daomakedi, wese iirmakbukwa guoye,’ ¿deunni be gudii?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"”¿Negmeegwad-naguega bolegoedga be sogsa,","poem":1},{"text":"naguye?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"¿Negmeegwad bela napneggi-naguye be sogsa,","poem":1},{"text":"adi, dule-isganamar magar daklegegar?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Neg-meegwadbali napneg-e-yar-mullugana magar daklenonidaed,","poem":1},{"text":"e-daklegedi morgi-morgomar-akar-akar-odolesayob daklenonidaed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Degidbali, dule-isganamar negmeegwad-abin ambikuosurmalad,","poem":1},{"text":"dule-isgana-e-garganguedi, bela bergunonikoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"”¿Ar be wila-arad-naid-solase be aideapi?","poem":1},{"text":"¿Bela be dii-ulakbali bipirmaksa?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Deginbali, ¿burgwed-negse be aideapbali?","poem":1},{"text":"¿Dule-burgwarmalad-e-galuse be arbi?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"¿Napneg-dungued be wisi?","poem":1},{"text":"Ar be we-ibmar nue-wisile, degite, be anga sogdo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"”Deginbali, ¿be wisbali, bia gwallu-meegwad-neg sii?","poem":1},{"text":"¿Be wisbali, bia negsichid-neg sibali?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"¿Sunna be we-ibmarmar e-igarmarba-moed be imake?","poem":1},{"text":"¿Sunna be gannar e-negse sedabali?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Be wisirgebed, ar be deunni bato be gwalulesargebed.","poem":1},{"text":"Ar be dikasurgus gudisursi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"”¿Ar dambed-sibudikmalad-sabolebukwad be dakapsi?","poem":1},{"text":"¿Dii-ologan-akwaga-binyarmalad-sabolebukwad be dakapsi?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"An dii-ologan-sabolebukwadi,","poem":1},{"text":"naibid-dummad-ibagi-ebugega an sabobukwad.","poem":2},{"text":"Degi, bila-onoged-ibagangi-ebugega,","poem":1},{"text":"urweleged-ibagi-ebugega an sabobukwad.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"¿Be wisi, negmeegwad bia noardae, degi, igi nasguddae?","poem":1},{"text":"¿Be wisi, dad-nakwedsik-burwa-goled igi onoardae?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"”¿Be wisbali, doa dii-dummad owie?","poem":1},{"text":"¿Doa dii-dummadba-mesa mar-ogollomakmai imake?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"¿Doa nega-dulesulidganba dii owie?","poem":1},{"text":"¿Doa dule-buksurmaladba napaneg oge?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"¿Doa gaganmar-aradik-oniega, dii owie?","poem":1},{"text":"¿Doa napa-dutuu-imakega, dii owie?","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"”¿Dii-wiedde bab nikasi?","poem":1},{"text":"¿Doa boo ogwalulesibali?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Be anga sogena, ¿bia dii-gwamakaled soblesii?","poem":1},{"text":"¿Doa dii-sibudikid onisibali?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"¿Doa dii akwayob-dutusuli imake?","poem":1},{"text":"¿Doa demar-dummad-naid osatelegega imake?","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"”¿Sunna be niisgwamar-Pléyadesʼye-nugad danar-danar-naguega imake?","poem":1},{"text":"¿Sunna be niisgwamar-Oriónʼye-nugad aisakiega be imake?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"¿Sunna be bolegoedba niisgwamar-danar-danar-nanaid,","poem":1},{"lineBreak":true},{"text":"e-wachiba-onogega be imake?","poem":1},{"text":"¿Sunna be niisgwamar-Osa-Mayorʼye-nugad, degi, Osa-Menorʼye-nugad nabir-bipirmakega be imake?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"¿Be nibneg-seleged-igarmar-mamaid, be wisi?","poem":1},{"text":"¿Sunna be a-igarmar-mamaidba be napneg see?","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"”¿Sunna be mogirga sogsale,","poem":1},{"text":"begi dii-dummad owiye?","poem":2}]},{"type":"verse","number":35,"content":[{"text":"¿Be-sogedba mar gotedae?","poem":1},{"text":"¿Be sunmakdele, bebali mala yoga ibsaardae?","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Degite, be anga sogdo, ¿doa gannir-macheredga binsaed uksa?","poem":1},{"text":"¿Doa sikwi-gikamarga binsaed daksa?","poem":2}]},{"type":"verse","number":37,"content":[{"text":"¿Sunna be mogirmar ebise?","poem":1},{"text":"¿Doa napamar-sergudele, dinnaa nadele,","poem":2}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"dutuu-imakegala dii owie?","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"”¿Sunna be achumigurmarga masgunned amie?","poem":1},{"text":"¿Sunna e-mimmigan masgi be omae?","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Achumigur e-negyaba dukumamaile, sapur-yaba masbina gudimalale,","poem":1},{"text":"¿sunna ega be mas amie?","poem":2}]},{"type":"verse","number":41,"content":[{"text":"¿Ar bee be sikwisichimar masgi omae?","poem":1},{"text":"E-burwigana yoggusgudimalale,","poem":2},{"text":"degi, mas-satedba ukudmaad-gudiidba, anse gordimalale,","poem":1},{"text":"¿ega be mas amie?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/37.json","previousChapterAudioLinks":{},"numberOfVerses":41}