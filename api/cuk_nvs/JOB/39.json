{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":39,"content":[{"type":"verse","number":1,"content":["Bab-Jehová sogdebalid:",{"text":"“¿Be wisi, ibu-ibagine sibad-sapurbarmalad milege?","poem":1},{"text":"¿Goe-sapur-mileged be dakdii?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"¿Be wisi, goe-sapur milegega nii-walabigwa nanae?","poem":1},{"text":"¿Be wisi sana milegoe?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ar goe-sapur milesokalile, ega nued-aidegega, sinni sigisdaed.","poem":1},{"text":"Degiid-bergusale, geb ega nunmaked bergued.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Geb e-mimmigan sapurba dungudamalogua, na gannarbagus itomalale, e-nangi banguddamalad,","poem":1},{"text":"bar e-nanse nonidasurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"”¿Doa moli-uayasuid-sapurbarmalad yogasaar gudiguega imaksa?","poem":1},{"text":"¿Doa achikar-gudigumalaga imaksabali?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani an moli-uayasuidmarga, nega-dulesulidgan e-negga imaksad,","poem":1},{"text":"agi gudigumalaga an imaksad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Na wargwen e-itolegedba-gudimarsoggua, neggweburgi-neg-oimaked bai itodasurmalad,","poem":1},{"text":"degi, dule-moli-seed-ese-goledi baisur itodamalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Deyob moli-uayasuidmar yalaganba gudidamalad,","poem":1},{"text":"gagan-ara-arad amididamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"”Ar moli-bebe-nikad-ursilid, ¿sunna bega arbasar be ebinsae?","poem":1},{"text":"¿Sunna be-molimar-gabedgi megisar be ebinsae?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"¿Ar we-moli-ursilid, sunna be e-dukarba edinne?","poem":1},{"text":"¿Sunna be-sorba napa-imudaniguega be imake?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"¿Ar we-moli-e-garganguedgi be bengusuli guoe?","poem":1},{"text":"¿Ar we-moli-ursilid bega be-arbaed imako be ebinsae?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"¿Sunna be we-moli ibmar-gwag-onmakega be imake?","poem":1},{"text":"Degine, ¿ibmar-gwag-welesad e-neg-sabolegedse bega danakwaa-urbenaega be imake?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”Ar nuu-avestruzʼye-nugadi, weligwaledba na e-sakan mer-mer imakardaed,","poem":1},{"text":"dabgalayob-gukuega sakan niksulid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"We-nuu-dummad-dukar-suid e-akwa ukubgi urbed,","poem":1},{"text":"ukubgi-uee-siega, urbed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"We-nuu-dummad e-akwa-sisad-birgi na annaele, gwen bai itosulid.","poem":1},{"text":"Ibmar-durgan-egi-annaele, gwen bai daksulid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"We-nuu-dummad e-mimmigan egadsuliyobi sabsur-imaked,","poem":1},{"text":"e-ibe surgudele, gwen bai itodasulid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ar Bab-Dummadi, nuu-dummad-dukar-suidga binsaed uksasulid.","poem":1},{"text":"Magar-neg-itoged ega uksasulid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Degi-inigwele, we-nuu, sakan-nallaa-imakdele, degi, abarmakde-sogele, molimarba bur bule abarmaked,","poem":1},{"text":"dule-moligi-abarmakedgi burgued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"”¿Ar be, molimarga gargangued uksasi?","poem":1},{"text":"¿Ar be moliga sailagia nasiksabarsi?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"¿Ar be, moli ses-ichomakeyobi be imaksasi?","poem":1},{"text":"¿Ar be we-moli, sabsur-e-bunnogedgi emar-ogwayed be imaksasi?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Moli sabsur-annanagusdaed, e-gargangued-nikadba weligwar itonadaed,","poem":1},{"text":"deyobi, neba-naidbali, ise-abarmakar naddaed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Moli dobed wissulid, ibmar dobsulid,","poem":1},{"text":"urwelenaile, es-suid-abin sikirmaksulid.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Sigumar moli-dikargi-nanaidi gornanaid,","poem":1},{"text":"arbon-suarmar, degi, eswarmar-moli-dikargi-nanaidi, dakarmaknanaid.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Sabsur-abarmakedbali, dikasur-abarmakdedaed.","poem":1},{"text":"Gar-gotele, gege bar galeged.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ar moli gargote-itogele, abarmakega aka binnasur-bunnogar-gotedaed.","poem":1},{"text":"Bila-onolenaile, dikasuli magar-itoged,","poem":2},{"lineBreak":true},{"text":"bilagi-dulemar-oimaknanaile, dikasur magar-itobalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"”¿Ar bee be, noomar-gukuega imaksa?","poem":1},{"text":"¿Ar be-binsaedba noomar dad-nakwed-argan-nuedsik-gukuega be imaksa?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"¿Ar be-sogedbali sulubagimar dikasuli-gukuega be imaksasi?","poem":1},{"text":"¿Ar be-sogedbali sulubagimar matusuli e-uu-sobega be imaksasi?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ar sulubagi akwasaila-dummagan e-negga imaked, agi na e-gabed siid.","poem":1},{"text":"A-akwasaila-dummad-birgi e-neg-gandikid siid.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"A-akale, bannaba na e-mas-gaega","poem":1},{"text":"masbina ataksidaed.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Sulubagi-e-mimmigan ibmar-durgan-e-ablisgi ibmeremalad.","poem":1},{"text":"Ar bia ibdurgan-burgwar-mai-sogele, agi mula gudidaed.”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}