{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":4,"content":[{"type":"heading","content":["Elifaz Jobʼga sabsur-ibmar-sogsad"]},{"type":"verse","number":1,"content":["Elifaz Temán-neggweburgined, weyob Jobʼga sogded:"]},{"type":"verse","number":2,"content":[{"text":"“Job, an bega ibmar-sogoedi, be isdar-itogodibe,","poem":1},{"text":"degi-inigwele, an bega ibmar sogergebed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Emide, be emar-bukidar odurdakdidaed,","poem":1},{"text":"be emar-niga-ogannodidaed,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"be-sunmakedgi wile-itodimalad-ogannodidaed,","poem":1},{"text":"degine, be dule-gege-itomalad-bendakdidaed,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"degite, emisgindi, begi bonigan-yolenonikidi geger be itoged.","poem":1},{"text":"Bonigan begi obin na be itoged.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ar Bab-Dummadgi be dobekwaa gudiiye-sog-inigwele, degite, ¿ibiga be Bab-Dummadgi bensunna?","poem":1},{"text":"Na be nued gudiiye-binsadiidde, degite, ¿igi be gudsunna?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"”Nue be itogena: Ar dule ibmar-oakalodsulile, ¿sunna we-dule oburgwiledasi?","poem":1},{"text":"Dule ibmar-inniki-imakdiile, ¿sunna we-dule oakaloledasi? Suli.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bato an nue neg-daksamogad,","poem":1},{"text":"ar dule ibmar-isgana-imakdidibe, ibmar-isgana egi aibined.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ar Bab-Dummad dule-isganagi-uludele,","poem":1},{"text":"unnila e-bunnogedgi sunna oburgwed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Amba achumigur-nono-wawaad uludele, degi, e-mimmigan uludmogale, e-nugarmar bibisgoed.","poem":1},{"text":"Bab-Dummad deyob dule-isgana-imakoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar igi-achumigurmar, mas-satedba burgwiddae, degi, e-mimmigan banna-banna aineba duurmakdedae,","poem":1},{"text":"Bab-Dummad deyob dule-isgana-imakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"”Gayaburba-gwensak anse arbakee nonikid,","poem":1},{"text":"unnila an sikwas-bollee itosad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Deunni, mutiki dulemar bela gabmamaigua, negburgan an dakalid,","poem":1},{"text":"agine, an sulibinsa-itoalid,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"angi dobed-dummad nagunonikid,","poem":1},{"text":"an wawanmakded, bela an-niga batided.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ibmar-burba an-ebus an itononigu,","poem":1},{"text":"bela an-abagan iko-iko itonaded.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Agine, geb an-asabinni duleyob gwisgunoniki an itoged,","poem":1},{"text":"e-daklegeddi aku dakleged.","poem":2},{"text":"Gwisgunonigu, bela neg boo nagunonikid,","poem":1},{"text":"e-sunmaked sikwas-soge an itoged:","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"” ‘¿Ar dule Bab-Dummadba bur bule innikidaed nikasi?","poem":1},{"text":"¿Ar dule we-napnegse-e-odenonikidba bur bule dule-islidikga gusi?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ar Bab-Dummadi, e-maiga-gudimaladginbela bengudiid.","poem":1},{"text":"Ar Bab-Dummadi, e-baliwiturmarbela egi yole daked.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Degisoggu, dulemargin-bulesunna, dulemardi unnila napsa gued,","poem":1},{"text":"dule ukub-birgi neg-soblessiidyob gued,","poem":2},{"lineBreak":true},{"text":"samuyob baisursunna abulemaladid.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wakdaradbali, nued-gudii gued,","poem":1},{"text":"sedogidbali, bato bergus gued.","poem":2},{"text":"Unnila dulemar sikwas wis-dula gudii gued.","poem":1},{"text":"Ar burgwidele, bar dulegi binsalegosulid,","poem":2},{"lineBreak":true},{"text":"deyob dule yoggudoed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Na e-mormar-nikad bela e-ibe miledoed,","poem":1},{"text":"gwen binsaed-nikagussuli burgwidoed.’ ”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}