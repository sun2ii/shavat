{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":["Bab-Jehová, Jobʼga sunmakdebalid, weyob ega sogded:"]},{"type":"verse","number":2,"content":[{"text":"“¿Ar dule Bab-Dummad-Bur-Biriginedgi-urwenaidi, gan-bipigi Bab-Dummad-osioye binsasunde?","poem":1},{"text":"Ar degite, we-dule, Bab-Dummad-abinsado.”","poem":2}]},{"type":"verse","number":3,"content":["Geb Job, Bab-Dummad-abin sunmakded, weyob sogded:"]},{"type":"verse","number":4,"content":[{"text":"“¿Igi an be-abin-imakosunna?","poem":1},{"text":"Ar an dule-nuedsulid. Geg an be-abin-imaked.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bato ilagwen an sunmaksabinned, bar an sunmakosuli.","poem":1},{"text":"Bato an ibmar sogsabinned, bar an gannar-gannar ibmar sogosuli.”","poem":2}]},{"type":"heading","content":["Bab-Dummad-e-gangued-oyolenaid"]},{"type":"verse","number":6,"content":["Bab-Jehová burwa-gammuba Jobʼga sunmakded. Weyob ega sogded:"]},{"type":"verse","number":7,"content":[{"text":"“An-abin, machered na be san-imako.","poem":1},{"text":"Be an-odurdakega, emisgi ani an bese ibmar egisgwelo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”¿Be an-ibmar-inniki-imaked be osulosunnode?","poem":1},{"text":"Na be sogega, bedi ibmar inniki-imakdiiye, ¿aga be angi gwisgusunnode?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"¿Be-surgande an-surganyob gangude?","poem":1},{"text":"Ar be-sunmakedde, ¿an-sunmakedyob gangu-sunmakde?","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Ar deyobile, be-gangued-yeerdakleged be oyodo,","poem":1},{"text":"be-ganguedba be-nug-dummarba be imakdo.","poem":2},{"text":"Be-gangued-yeerdakleged be oyodo,","poem":1},{"text":"bela-bela be-yeerdakleged be oyodo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Be-isdarsun-itodiid mer be bargae,","poem":1},{"text":"dule-san-dummarba-itodimalad be dake, mesagwar be imake.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dule na san-bule-bule-imakdiid be dake, a-dule be obingegsae.","poem":1},{"text":"Dule-isganamar bia gudii be dakalir, bela be obeloge.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bela we-dulemar be dige-dige imake,","poem":1},{"text":"napa-urba ise digar be imake.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ar deyob ibmar-saele, magar an be-dakodo, be dule-buledye,","poem":1},{"text":"be-ganguedgine be bendakleged amiye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"”Be dakena, ibdula-Behemotʼye-nugad, moli-bebe-nikadyob unnila gaganbi maed,","poem":1},{"text":"igi an be-obinnisa, deyob an we-ibdula obinnismogad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"We-ibdula-e-garganguedi","poem":1},{"text":"bela e-sorgargi, degine, e-saderba siid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"E-bunnu urwaryob banamaked,","poem":1},{"text":"e-dua-gasimar yeer gangu nikabalid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"E-gar-nikadi esgoro-gordikidyobi nikad,","poem":1},{"text":"e-nagmar esgoroyob-gangue nikad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"”An ibmar-durgan-obinnisad-abargi we-ibdula emargi obinmaid.","poem":1},{"text":"An we-ibdula oburgwebiele, sunna an oburgwed.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Sapurmar-nanaidi, ega masgunned uked,","poem":1},{"text":"a-sapurgi ibdurganmar ichomakdididamalad.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"We-ibdula negsichigi obunnomaidaed,","poem":1},{"text":"masar-matagan-imbaba dukumaidaed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Sapimar-urba obunnomaidaed,","poem":1},{"text":"gaganmar-mata-imbaba gudidaed.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"We-ibdula diwar-noalile, gwen bai itodasulid,","poem":1},{"text":"diwar-Jordán e-gayase ubomaile, gwen bai itodasulid.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"¿Doa we-ibdula nuu-e-dakmai gaoe?","poem":1},{"text":"¿Doa ega asu udkoe?”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":24}