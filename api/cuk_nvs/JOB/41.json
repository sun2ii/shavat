{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":["Bab-Jehová weyob sogdebalid:",{"text":"“¿Sunna be ibdula-Leviatánʼye-nugadi, achwergi be sosale?","poem":1},{"text":"¿We-ibdula-e-gwabin sunna dubgi be edichale?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"¿Sunna e-asumurgi dub be nasiksale?","poem":1},{"text":"¿E-aku sunna esgoro-swiswidikidgi be boodo imaksale?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ar we-ibdula-Leviatánʼde, ¿nuedgi bese ibmar-egisosi?","poem":1},{"text":"Ar bega sogosi, wile be an-dakye.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ar be-maiga-guega,","poem":1},{"text":"¿bebo igar-mesosi?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"¿Sikwibo-dodolegeyob be we-ibdulabo dodosale?","poem":1},{"text":"¿Be-bunamala egi dodogega, ega be dubgi edichale?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"¿Sunna dule-ibmar-ukmaladi we-ibdula uksamalale?","poem":1},{"text":"¿Sunna dule-ibmar-ukmaladi ibdula-Leviatán-goamakar uksamalale?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"¿Sunna we-ibdula-e-uka esgi-siksar be itoge?","poem":1},{"text":"¿Sunna arbon-suargi-makar e-nono bayosar be itoge?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ese be achaena, ebo be urwena.","poem":1},{"text":"Ar bar be ese achaedgi binsassuliled, mer bar deyob guena gadinye be binsasaled.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mer be binsao, an we-ibdula baisursunna gaoye, unnila e-daklegedbi unnid.","poem":1},{"text":"Ar unnila be dakdele, bato be negoedbinneled.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"We-ibdula-Leviatánʼse dule gege achaed.","poem":1},{"text":"Degite, ¿doa an-abindi nabir gwisguosunna?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar bela napneggi-ibmar-bukwadi angadbiid.","poem":1},{"text":"Degisoggu, doa anga sogosunna, be angi ibmar ganiye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"”Ibdula-Leviatán-e-malimargi an sunmakergebed,","poem":1},{"text":"e-gargangued-dutusulidgi, e-dakleged-yeerdunguedgi an sunmakergebed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"¿Doa e-ibe e-uka edarisale?","poem":1},{"text":"¿Doa ese warmaksale?","poem":2},{"lineBreak":true},{"text":"¿Doa e-ibe e-gaya edichabalile?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ibdula-Leviatán-e-nugarmar-swiswimakaled-dakegala,","poem":1},{"text":"¿doa e-ibe e-gaya-mee imakoe?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ibdula-Leviatán-e-yargan, sigu-abgaed-senigana-daklegeyob madar-madar nanaid,","poem":1},{"text":"akwayob dachak-dachak nanaid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bela e-ukamar-madar-madar-nanaidgi ollor naisulid,","poem":1},{"text":"degine, burwabela egi geg doged.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bela e-ukamar-abingunanaid, ise achamakar nanaid.","poem":1},{"text":"Gege dule e-ibe ollo-ollo imaked.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"We-ibdula-Leviatán asmidele, mar-ibyeyob asmied.","poem":1},{"text":"E-ibya-gaedi, dad-ibelergaeyob gaed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"E-gayabali, soo gwabunyeardaed,","poem":1},{"text":"ditismakar soo ainiardaed.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"E-asa-yabali, waa bupurmakardaed,","poem":1},{"text":"dii-gwakwarmaknaid-birgi waa-bupurmaknaidyobi bupurmakardaed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"E-bunnogedgi soo ogaed,","poem":1},{"text":"e-gaya-yabali, soo mied.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ibdula-Leviatán-e-gargangued e-dukargi siid,","poem":1},{"text":"e-abinni bela dulemar niga argwatedamalad.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"E-san-nikadi sommereged, egi geg ibmar doged.","poem":1},{"text":"E-sanmar-bur-dutugwadbela, amba selelleged.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ibdula-Leviatán-e-binasgar akwayob dutusulid,","poem":1},{"text":"ibmar-gwag-naged-akwayob gangued.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ibdula gwisgudele, ese gwakiddamalad.","poem":1},{"text":"Binnasurgualile, bela idu duurmakdedamalad.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Es-suid egi gwisgunonikile, gege bayoged.","poem":1},{"text":"Arbon-suarmarbela, sigubela, degi, ibmar-swiswidikidbela, gwen bayosulid.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ibdula-Leviatán esgoro-suar gaganyobi ibigwensur daked","poem":1},{"text":"esgoro-gordikidbela urgo-nunudyob daked.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"We-ibdula-Leviatán sigumar dobsulid,","poem":1},{"text":"akwamied-dubgi-akwa-milegedbela ibmar-dutukwayob daked.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Mardo-dummadgi sarsolenaile, baisur-itoged,","poem":1},{"text":"egi gagan iir-iir-gunaiyob itoged,","poem":2},{"lineBreak":true},{"text":"eswar-suid-goled yeer-itodaed.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ibdula-Leviatán-e-dikarmar nugaryobi swichwi-swichwi dakleged.","poem":1},{"text":"Unimakdedibele, gwala-esgorobiidgi neg-durwilesayob e-gannarmar megisdaed.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ibdula dii-urba-burdidele, dii-gwakwarmaknaiyob neg-imaked,","poem":1},{"text":"ina-wawad butegi-sik-sik-imaklenaidyob neg-imaked.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"E-sorbali, e-igar dagudik diigi megisdaed,","poem":1},{"text":"sailagia-sibudikidyob e-igar makumakar megisdaed.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"We-ibdula-Leviatán gwen ibmar dobsulid,","poem":1},{"text":"ibdulamar we-ibdulayob-dakleged gwen nikasulid.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"We-ibdula-Leviatán, dule-bulegan-sogdimalad-mesagwar imaked,","poem":1},{"text":"degine, bela ibdula-ursilimalad-e-reyga maid.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":34}