{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":["Elifaz sogdebalid:",{"text":"“Job, emisgindi be binnasuli golena,","poem":1},{"text":"doa be-abin-imakdagodibe.","poem":2},{"lineBreak":true},{"text":"Ar biti-baliwitur-gwensakse be golodibe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ar emargi-isdar-binsalegedi, dule-binsaedsulid-oburgwed.","poem":1},{"text":"Emargi-nobgulegedi, dule-binsaedsulid-oburgwed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"An-sunnad an dakdaed,","poem":1},{"text":"dule-binsaedsulidaedi igi nasgumaidae,","poem":2},{"lineBreak":true},{"text":"degite, sikwas-naogua, e-neguya wioleddabalid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dule-binsaed-sulidaed-e-mimmigandina, dule-e-bendaked satedaed,","poem":1},{"text":"igar-naboleged-neggine nue-ibitodamalad,","poem":2},{"lineBreak":true},{"text":"dule-e-irwa-gwisgued satedaed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Deginbali, dule-binsaedsulidaed-e-ibmar-digarmaladi, dule-ukudmaada-gudimalad e-ibe wedamalad.","poem":1},{"text":"Gunmalagala iko-abargi e-ibe wedamalad.","poem":2},{"lineBreak":true},{"text":"Dule-uku-uku-itodimaladi, a-dule-ibmar-nuegan-bukidar-nikadgi nue-nobe itodamalad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ar ibmar-isgana, yogasaar ainisulid.","poem":1},{"text":"Ar bonigan-abingalegedi, walagwen noardasulid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ar igi soo-e-ditismakedi soogi daniki,","poem":1},{"text":"debayobi, naibi-itolegedi dulegi danimogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”Ani an weyob gunaina,","poem":1},{"text":"bato an dika Bab-Dummadga an-bonigan an sogsabinnena.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ar Bab-Dummad ibmar-gegerdaklemalad imaked,","poem":1},{"text":"bukidar ibmar-dakledisurmalad imaked.","poem":2},{"lineBreak":true},{"text":"Akusunna-itoge anmar-imaked.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ar Bab-Dummadi dii owimaid,","poem":1},{"text":"sapurgi dii-wiega imakmaid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Dummadi, dule-san-dummarba-imaksulid-e-nug ogannoged,","poem":1},{"text":"degine, dule-naibi-itodimalad bendakbalid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bab-Dummadi, dule-emar-binsaed-gaed-ibe binsaed obured,","poem":1},{"text":"adi, e-ibmar-imakedgi mer nasguegar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bab-Dummadi, dule-emar-binsaed-gaed-e-binsaed, egi aibinega imaked,","poem":1},{"text":"degi, ibmar-isgana-imakbied e-ibe oburbalid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bab-Dummadi, a-dule ibgine yolegega imaked.","poem":1},{"text":"Ar amba neg-meegwadgi-gudiiyob-gudiile, mutikidba-gudiiyob yolegega imaked.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bab-Dummadi, dule-wileged bendaked,","poem":1},{"text":"dule-isdar-sunmakdimaladgi bendakbalid,","poem":2},{"lineBreak":true},{"text":"degi, dule-sabsur-emar-imakdimaladgi bendakbalid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ar Bab-Dummadi, dule-wileged ogannoged,","poem":1},{"text":"degine, dule-ibmar-isgana-imaked-gaya-maklegega imakbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"”Dule Bab-Dummadse-nuguega-odurdaklegedi, ¡egi nued binsalesadid!","poem":1},{"text":"Degisoggu, Bab-Dummad-Bela-Gangued-Nikadi be-odurdakele,","poem":2},{"lineBreak":true},{"text":"mer be isdar itoge.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ar Bab-Dummadi, naibi-emar-imak-inigwele, emar-nudakbalid.","poem":1},{"text":"Bab-Dummadi, amba emargi-yole-inigwele, emarga nunmaked osulobalid.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bab-Dummadi, bonigangi be-ollorsamaiguad.","poem":1},{"text":"Ar amba be bonigan-abalagi-gunaile, be-bendakoed.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ukud-dummad-nagunonikile, Bab-Dummadi be-oburgwega be-imakosulid.","poem":1},{"text":"Bila-onoleged-nagualile, es-suidgi-burgwega be-imakosurbalid.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Gaya-isgana begi milealile, Bab-Dummadi, akarguega be-imakosulid.","poem":1},{"text":"Degine, neg-isgued-nonikile, bai be itogosulid.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Aka be neg-isgued-abin alledii guoed,","poem":1},{"text":"ukud-abin be werguoed.","poem":2},{"lineBreak":true},{"text":"Degine, ibdurgan-ursirmar-abin be gwayosulid.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ar akwamar be-nainu oichogosulid, ibnuedga bega guoed.","poem":1},{"text":"Ibdurgan-ursirmar be-ibmar-digarmalad be-ibe ebugosulid.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Be-neguyagine, nueganbi be garmakdii guoed,","poem":1},{"text":"degine, be-sibad-wawaadmar be ebichialile, bega sogedba bukwa be dakoed.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mimmigan-bukidar be nikuoed,","poem":1},{"text":"waganmar gaganmar-aineyobi be nikuoed.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Seredgi amba nollosuli be neg-uangi megdapoed.","poem":1},{"text":"Igi ibmar-gwag-goresadgine, e-iba-sogedbali welege, deyobi, be-iba-sogedba be burgwidoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"”Ar anmar bela we-ibmar bega sogedi, bato anmar nue-daksad, we nue-napiragwadid.","poem":1},{"text":"Degisoggu, nue be itoge, be-sunnad be itoge.","poem":2},{"lineBreak":true},{"text":"Ar bega ibmar-nuedga guoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}