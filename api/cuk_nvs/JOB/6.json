{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":6,"content":[{"type":"heading","content":["Job e-aimar-abin sunmakded"]},{"type":"verse","number":1,"content":["Degine, Job ega-sunmaknaid-abin weyob sogded:"]},{"type":"verse","number":2,"content":[{"text":"“An-naibi-itodiidi, an-wiles-itodiidbogwa,","poem":1},{"text":"nabir nibirgi-aidolegena nuedinad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ar nabir-aidolegena, demar-ukubba bur bule aidikueled.","poem":1},{"text":"An-sunmakedi bemar geger itogewilubsulid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ar Bab-Dummad-Bela-Gangued-Nikad-e-sigumar naibi-an-imaksad.","poem":1},{"text":"E-sigu-bonimar, bela an-sangi gwichigunonikid.","poem":2},{"lineBreak":true},{"text":"Bab-Dummadi dobed-dummadi anga barmialid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Moli-uayasuidi gagan-dikarba-gunaile, ¿masbina bonaidae?","poem":1},{"text":"Moli-bebe-nikadi, e-mas-bukwad-dikarba, ¿masbina bonaidae? Suli. Deyobsuli.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"¿Ar mas balu-sulile, nued-gulle be ebinsae? Suli. Nued gullesuli.","poem":1},{"text":"¿Ar gannir-akwa-e-sipugwadi nued gulle be ebinsae? Suli.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"An bonigan-abganaid-abesulidi,","poem":1},{"text":"emide, an-masga gunonikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”Bitigi Bab-Dummadi, an-ibmar-egisnaidi, anga imaksana gadin.","poem":1},{"text":"Bitigi Bab-Dummadi, an-ibmar-abegedi, anga uksana gadin.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Dummad ilagwen an-obelosunnana gadin,","poem":1},{"text":"an-oburgwedse an-imaksunnana yeerban.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ar adi, anga bonigan ibnuedga gusaled, an yeer-itosaled.","poem":1},{"text":"Ar Bab-Dummad-isligwaledgi an yolessurgusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”Bato an bela gudisoggu, ¿ibu bar an edarbosunna?","poem":1},{"text":"¿Ibiga bar an gudii guosunna?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"¿Ar an akwayob gangusi?","poem":1},{"text":"¿Ar an-ukade, esgoro-gordikidyob gangusi?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"An wargwen geg na dukin bendaked,","poem":1},{"text":"an-bendakmalad bela bergusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"”Dule-naibi-itodidbela, e-ai ega-gwage-armaked nikad.","poem":1},{"text":"Amba dule-Bab-Dummad-Bela-Gangued-Nikadba-dasulidbela, e-ai-egi-bangusulid nikamogad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ar bemardina, an-aimar-inigwele, be baisur an-dakdemalad.","poem":1},{"text":"Ar diwar-dinguddaeyobi, degi, noddabaliyobi be damalad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ar dii-gwamakar-bukwad daludele, dii-amuregedga naddae,","poem":1},{"text":"degine, diwar engudedae, deyobi, be gumalad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ar igi yor-mosale, diwar-dinnamaile geg bar iirmake,","poem":1},{"text":"degi, neg-uedikidbali bela dinguddae, deyob, be gudmalad,","poem":2},{"lineBreak":true},{"text":"baisur be an-dakdemalad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Dulemar-danagwen-dummad-nadapdamaladi, e-igar-nadapidgi aibatele,","poem":1},{"text":"nega-dulesulidganba yogguddamalad, agi burgwiddamalad.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Temánʼginmalad-danagwenmaladi, dii-amiegala naddamalad,","poem":1},{"text":"Sabá-neggweburginmalad-ibmar-ukmaladi, na binsadamalad,","poem":2},{"lineBreak":true},{"text":"bitigi dii an amisana gadinye.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dii-nue-amio-itosmalanad, degi-inigwele, dii-dinna-mai dakdapmalale,","poem":1},{"text":"nabir-itoardasurmalad.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Debayobi, bemar gudmarmogad,","poem":1},{"text":"ibmar-gacharsuli-dakebayobi be angi gwakidmalad.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"¿An bemarse ibmar egichasi, wis be anga ibmar udamarye?","poem":1},{"text":"¿An-bendakmalaga an bemarse mani egichisbarsi? Suli.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"¿An bemarse gochasi, an-isdarmaladgi be an-bendakdamarye?","poem":1},{"text":"¿An bemarse egichisbarsi, dule-sabsur-emar-imakmaladgi","poem":2},{"lineBreak":true},{"text":"be an-bendakye? Suli. An bemarse ibmar egichissulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"”Be anga sogmardo, ibugi nodii be an-dake.","poem":1},{"text":"Ar an nodiile, bar an sunmakosurdo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bemar innikigwadba be anga ibmar sognaina, an bemar-abin isdar itogosulinad.","poem":1},{"text":"Emide, be yogasaar angi sunmaknanaid.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mer an-sunmakedba be angi yolemala,","poem":1},{"text":"ar an surbinsa-itogedba an deyob soged.","poem":2},{"lineBreak":true},{"text":"We-ibmar-an-sogedi bela bergudoed.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"An be-dakedi, sunna be dule-sergan-sated ibmargi-dodoar-wilubdakar be uksamalar an be-dakdo,","poem":1},{"text":"degine, bemar sunna ibmarbina be-ai be uksamalar an be-dakbardo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"”Nue be ise-nuu an-dakmala.","poem":1},{"text":"Be anga sogmala, bule an bemarga gakansanai.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Be nue itomala, mer yogasaar be angi yolemala.","poem":1},{"text":"An ibmar-oakalodisulid, be magar an-dakmala.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"An-bemarga-ibmar-sogedi, gakansulid.","poem":1},{"text":"¿Ar an napira-ibmar-sogedi, gakansaed-ebo emarbi-dakye be angi binsamarde? Suli, degisuli.”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}