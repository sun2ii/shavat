{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":["Job sogdebalid:",{"text":"“Ar dule we-napneggi bela arbamalargebed.","poem":1},{"text":"E-ibagan, dule-undar-arbadiid-e-ibaganyob gued.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Igi maigagudiid gwae-neg-mutikgusana gadinye binsadidae,","poem":1},{"text":"igi dule-arbadiid e-bennukleged-iba edarbedidae,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"deyobi, an nii-irbali wile-itodii gusad,","poem":1},{"text":"mutikidbali nunmakedba an galitodii gusad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"An mutikidba megisale, an binsamaidaed,","poem":1},{"text":"sana anga neg oibogodibeye.","poem":2},{"text":"Mutikid anga bergusurdaed.","poem":1},{"text":"Deyobi, an bindumakmai gabsuli oiboardaed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bela an-san nus biinid.","poem":1},{"text":"An-uka sommere-sommere itoleged.","poem":2},{"lineBreak":true},{"text":"An-uka-daas-dasadba sibudik-sibudik nis ariomamaid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"An-bergued-ibagan binna-binna nadapsulid,","poem":1},{"text":"e-ibagan omosad.","poem":2},{"text":"Gwen an bar-gannarsegued itosulid,","poem":1},{"text":"bato an bela itoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"”Bab-Dummad, be ebinsao,","poem":1},{"text":"an-gudiidi, unnila bunnolegedyob an gudiid.","poem":2},{"lineBreak":true},{"text":"Neg-nued bar an dakosulid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"An bergudele, dulemar gwen bar an-dakosulid.","poem":1},{"text":"Be an-amidii gumaloenad,","poem":2},{"text":"be an-amiosurmalad.","poem":1},{"text":"Ar andi bar gudii guosulid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Igi mogirmar aisakiddae, gwen bar dakleddasuli,","poem":1},{"text":"debayobi, dule neg-uangi-digledele, geg bar gannar noed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"E-negse geg gannar bar aibired,","poem":1},{"text":"bar egi binsalegosulid, deyob yoggudoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”Degisoggu, an sunmakedi gege bar an boggued.","poem":1},{"text":"Nue-bukib-binsaed sunmakega an-imaked.","poem":2},{"lineBreak":true},{"text":"Neg-nued-dakdisulid-abalagi an ibmar sogoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"¿Demargi ibdula-dummad-gudiiyob be an-daksi?","poem":1},{"text":"Emide, be angi nakulebukwad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Imbagwenar an binsaardaed:","poem":1},{"text":"‘An gabidele, we an-bendakoye.","poem":2},{"lineBreak":true},{"text":"Gabedi, anga naibid osulogoye.’","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Amba an gabmaidibe, be an-ogwayeardaed,","poem":1},{"text":"gabgi gwayed-dummadi be anga ukdaed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bur an-gammu-gasmarsunnana gadin,","poem":1},{"text":"adi, an-gudiidi bar an itogosulid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"An-gudiidi, nabir an gwen itosulid,","poem":1},{"text":"bar an dula-gudii gubisulid, burgwisa an binsaed.","poem":2},{"text":"Ies be an-imake,","poem":1},{"text":"an wegi-gudiidi gwen-nabirsulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"”¿Wede dule ibusunna, bede dummarbaa imaked?","poem":1},{"text":"¿Ar ibiga duleba be bukib binsae?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"¿Ar ibiga be bane-bane egi be atakdii?","poem":1},{"text":"¿Ar ibiga be bane-bane wilubdakdibali?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bab-Dummad, ¿sana be angi-nakulediid iegoe?","poem":1},{"text":"Wis gwen be an-indaksulid,","poem":2},{"lineBreak":true},{"text":"gwen wii-doega be an-imaksulid.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ar an begi nosye-sogele, ¿igi an-isguedde be-imakosunna?","poem":1},{"text":"Ar be dulegi nakuleged gudiid.","poem":2},{"text":"¿Ibiga be sabsur an-imake?","poem":1},{"text":"¿Isdarsunna be an-dake?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bab-Dummad, ¿ibiga geg be an-isgued elisunna?","poem":1},{"text":"¿Ibiga geg be an-isgued ies imaksunna?","poem":2},{"lineBreak":true},{"text":"Bato an-burgwed omosad.","poem":2},{"text":"Bato an napaga binyesokalid.","poem":1},{"text":"Be an-amidagoenad, bato satebin be an-dakdagoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/6.json","previousChapterAudioLinks":{},"numberOfVerses":21}