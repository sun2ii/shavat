{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":8,"content":[{"type":"heading","content":["Bildad, Jobʼga sunmaksad"]},{"type":"verse","number":1,"content":["Súah-neggweburgined-Bildad, Jobʼga sogded:"]},{"type":"verse","number":2,"content":[{"text":"“¿Ar sanagwadse weyob be sunmakmai guoe?","poem":1},{"text":"Be-sunmakedi, burwa-dummad-noedyobi be sunmaked.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Dummad-Bela-Gangued-Nikadi, ¿ibmar-inniki-maid oichogo be ebinsasi?","poem":1},{"text":"Bab-Dummadi, ¿ibmar-inniki-imaklegedgi yolego be ebinsasi? Gege yoleged.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ar be-masmala, Bab-Dummadgi yolesmalargebed.","poem":1},{"text":"Ar degubinne Bab-Dummadse nabir odurdaklesmalad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Dummad-Bela-Gangued-Nikad be baramiele,","poem":1},{"text":"ega be sogele, wile be an-dakye,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"be islidik-gudiile, be ibmar akar-imakdisulile,","poem":1},{"text":"Bab-Dummad be-bendakoed.","poem":2},{"lineBreak":true},{"text":"Bega gannar ibmar-iduar-nikusadi ukoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ar yoedse be ibmar-nikuoedi, ibmar-nikusadba bur bule be nikuoed.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”Dadganse be nue ibmar egise,","poem":1},{"text":"be-babgan-ibmar-bar-amismaladi, be durdake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ar anmardi geb emicharmaladid, gwen we-ibmar wissurmalad.","poem":1},{"text":"Anmar we-napneggi-gudiidi, unnila an sikwas gudimalad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ar we-dulemardi sunna be-odurdakoed,","poem":1},{"text":"ibmar-bukidar-wisguega be-imakoed.","poem":2},{"lineBreak":true},{"text":"E-ibmar-wismalad bega sogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”Gagan-papiroʼye-nugad neg-matagangi-dungumaladi, ega neg-mata dingudele, ¿sunna dungusi?","poem":1},{"text":"Gagan-diigi-dungumaladi, ega dii-dingudele, ¿sunna dungusi?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ar we-gaganmala, amba aramaksiile, degi, amba siklessuli, ega dii-dingudele, yog-dinguar naddaed.","poem":1},{"text":"Gagan-bamaladba bur bule itosur dinguddaed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dulemar Bab-Dummad-ieddamaladi, we-gaganmaryob gumalad.","poem":1},{"text":"Dule-isganamar na e-ibmar-edarbediidi degibergudoed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dule-isgana e-ibmar-edarbediidi ega dub-garagwadyobi gued.","poem":1},{"text":"E-bensulid-nikadi, dibamaryob baisursunna e-ibe berguddaed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ar dule dibagi akaye-sogele, gege egi akaed, ar yoga-itirar naddaed.","poem":1},{"text":"Debayobi, e-bensulid-nikadi ega yoga-berguar naddaed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dule-isganamar, sapi dad-duurmaknaid-abin-gwichiyob gued.","poem":1},{"text":"E-anagan-nasgudele, bela napagi-gagan-naid odukued.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Degine, e-malimar akwa-imbaba uboddaed,","poem":1},{"text":"sabsur-akwagangi e-malimar diglesdaed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ar dule we-sapi-olasale, dulemar gwen egi bar binsaosurmalad,","poem":1},{"text":"we-sapide wegi gwichidaeddeeye.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Deyobi, dule-isganamar weligwar-itodiid berguddamogad,","poem":1},{"text":"e-sorba baigan dunguardaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"”Bab-Dummad gwen dule-innikidaed iedisulid,","poem":1},{"text":"degine, dule-isganadi ese obanledaed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bab-Dummad gannar yeer-itogega be-imakoed,","poem":1},{"text":"degine, yeer-itogedbali be binnasuli gordii guoed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Dule-isdar-be-dakdimaladi, binge-gudii gumaloed,","poem":1},{"text":"degine, dule-isdarmalad-e-neguyamar bela bergudoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}