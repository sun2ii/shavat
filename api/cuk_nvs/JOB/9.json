{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOB","translationId":"cuk_nvs","name":"Job","commonName":"Job","title":"JOB-GARDA JOB","order":18,"numberOfChapters":42,"sha256":"724a449dbec54ed524269788dea822a79073aae0913a9bee3a1ad4bec7eaea0e","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cuk_nvs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":9,"content":[{"type":"heading","content":["Job-sunmaksad-irbaagwad"]},{"type":"verse","number":1,"content":["Job, deyob Bildad-sunmaksad-itosgua, weyob abin-sogded:"]},{"type":"verse","number":2,"content":[{"text":"“An nue-wisimakar-inigwele, we nue-napiragwa,","poem":1},{"text":"degite, ¿igi dule Bab-Dummad-asabin isgussuliyob na san-oyogosunna? Gege dule na deyob san-oyoged.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ar dule Bab-Dummad-ebo gachimakye-sogele,","poem":1},{"text":"gwen dule Bab-Dummadgi, nakwissuliled.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ar Bab-Dummad binsaed-ibed maid,","poem":1},{"text":"e-gargangued dutusulid.","poem":2},{"text":"Degisoggu, ¿ar doa-dule, Bab-Dummadgi obichar be ebinsasunna?","poem":1},{"text":"Dule egi obichasuliled.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ar Bab-Dummad uludele, yar-dummagan-bukwad onired.","poem":1},{"text":"Yar-dummagan bato ainirisbin daklenonidaed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Dummad napneg-naid ogiglimaked,","poem":1},{"text":"degi, napneg-e-sailagan-mamaid ogiglimakbalid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Dummad dad-ibeler-mer-noega imaked,","poem":1},{"text":"niisgwamar mer-bar-gaega imakbalid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Dummad na e-ganguedba nibneg nasiksad,","poem":1},{"text":"degine, Bab-Dummad bogi demar-sabalid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Dummad bela niisgwamar danar-danaled nasiksad:","poem":1},{"text":"Niisgwa-danaled-Osaʼye-nugad, niisgwa-danaled-Oriónʼye-nugad nasiksad.","poem":2},{"text":"Degi, bela niisgwa-danaled-Pléyadesʼye-nugad-naguega imaksabalid.","poem":1},{"text":"Bela dad-nakwed-argan-nuedsik niisgwa-danar-danar nasiksabalid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ar Bab-Dummad ibmar-dummagan-magar-itolesulid imaked,","poem":1},{"text":"degine, bukidar ibmar-gegerdaklemalad-geg-ebisleged imaked.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar Bab-Dummad an-nagaba nadapye-sogele, an daksasuliled.","poem":1},{"text":"Angi bangudye-sogele, an itossurbaliled.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bab-Dummad ibmar-suye-sogele, ¿doa ega sogoe: ‘Mer be suye?’","poem":1},{"text":"¿Doa ega sogoe: ‘Ibu be imaknaiye?’ Dule ega soged, sate.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ar Bab-Dummad uludele,","poem":1},{"text":"ibdula-dummad-demargined, degi, e-sordaganse-bakale,","poem":2},{"lineBreak":true},{"text":"Bab-Dummad-asabin dulluu ambikumalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"”Ar deyobile, degite, ¿igi an Bab-Dummad-abin-imakosunna?","poem":1},{"text":"An abin-imakegala, ¿igi an sogsale? Geg an abin-imake.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Amba an ibmar-akar-imaksasuli-inigwele, Bab-Dummad-asabin geg an san-bendaked.","poem":1},{"text":"Ar unnila an Bab-Dummadse ise-wilegar bendakleged an egised.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ar an Bab-Dummadse igar-itogega gorye-sogele,","poem":1},{"text":"degine, anse nonikile, gwen an-itosar an ebinsasulid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Aka bur angi burwa-dummadiyob yolenonikiled,","poem":1},{"text":"aka bur an-naibid-itodiid anga omelonai gualiled.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Gwen obunnogega an-imaksasuliled,","poem":1},{"text":"aka bur wile-itoged anga omelononikiled.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ar garganguedgi sunmakleye-soglegele, Bab-Dummad bur bule emarba gargangued nikad.","poem":1},{"text":"Ar Bab-Dummadga igar-itoleye-soglegele, ¿doa igar-itoleged-abarse Bab-Dummad-ogwichosunna?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Amba an ibmar-akar-imaksasurye sogele, an-sunmaked angi dukin aibinnonikoed.","poem":1},{"text":"Amba an innikigudiiye-sogele, Bab-Dummad nosadga an-imakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"”Ar an ibmar oakalossur-inigwele, degite, Bab-Dummad amba deyob angi binsasulid.","poem":1},{"text":"A-ulale, an burgwebigussunnad.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ar bela dulemar emarbiid, degisoggu, an sogdo:","poem":1},{"text":"‘Ar Bab-Dummad dule-nued, dule-isgana obeloged.’","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ar boni-gwensak ukiagwar dule-oburgwenonikile,","poem":1},{"text":"an sogdo, Bab-Dummad, dule-ibmar-oakalodisulid-surbinsa-itogedga allesii guoye.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Dule-isgana yar-ganonikile, Bab-Dummad dule-igar-nabomalad igar-noar-imakmalaga imaked.","poem":1},{"text":"Ar Bab-Dummad weyob-imaksulile, degite, ¿doa imaksunna?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"”An-ibagan-bergued bato mosad,","poem":1},{"text":"an-ibagan binna-binnagwad bar abarmaksisulid.","poem":2},{"lineBreak":true},{"text":"Weligwaled an gwen-itogosuli an-ibagan bergudoed.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"An-ibagan, ur-binnasur-nadapiyobi, nadapid.","poem":1},{"text":"Sulubagi e-masbina-gwichigumaiyobi, an-ibagan gued.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Amba an sogdibe: ‘We-ibmar-nabir-an-itodisulidi, an iegoye.","poem":1},{"text":"An-wagar-wile-itoged, an ogwaoye, an alledii guoye,’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"degite, an bela-bela-nunmaked-itodiidba, amba an dobe itodaed.","poem":1},{"text":"An wisbalid, ar Bab-Dummad-asabinni, amba an ibmar-oakalossuliyob daklegosulid.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ar an ibmar-oakalosye soglesoggu,","poem":1},{"text":"ar ¿ibiga bar an alamaknai guosunna?","poem":2},{"lineBreak":true},{"text":"Binsarsunna bar an alamaknai guo itole.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Amba an-uka an dii-diregwadgi ise-enukye-sogele,","poem":1},{"text":"morgaukgi an-argan dagur-dagur an imakye-sogele,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"amba Bab-Dummad, ibmar-isgana-milegedse an-bar-meteled,","poem":1},{"text":"ar an-mormarse-bakale, ima an-itosaled.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"”Ar Bab-Dummaddi anyobsulid, andi dule gued.","poem":1},{"text":"Degite, ¿igi an igar-nabolegedse Bab-Dummad-sedosunna?","poem":2},{"lineBreak":true},{"text":"Gege an seded, ar Bab-Dummad dulesulid.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ar anmarga-igar-nabogega igar-naboged-dule,","poem":1},{"text":"wargwensaar gudisulid.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ar Bab-Dummad-angi-urwenaid-osulogega, dule-wargwensaale, gudisulid.","poem":1},{"text":"Adi, mer an Bab-Dummad-e-urwed dobguegar.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Aisaar an dobsuli sunmakbienad,","poem":1},{"text":"geg an gued, ar an dobe itoged.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOB/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOB/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/8.json","previousChapterAudioLinks":{},"numberOfVerses":35}