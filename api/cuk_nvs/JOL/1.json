{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOL","translationId":"cuk_nvs","name":"Joel","commonName":"Joel","title":"JOEL-GARDA JOEL","order":29,"numberOfChapters":3,"sha256":"d8fd606abe9b04d050ec1e54936861f20dc87915a9da2838fee6f9319578b4ac","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cuk_nvs/JOL/3.json","totalNumberOfVerses":71},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Bab-Jehová Petuel-machi-Joelʼga gayaburba sognonikid. Sesmar neg-oitosad Joel, Israel-dulemarga weyob sogded:"]},{"type":"verse","number":2,"content":[{"text":"“Bemar, sapin-dummagan-gumalad, nue itomalo.","poem":1},{"text":"Bela we-yargi-gudidimalad, nue itomalo.","poem":2},{"text":"Ses-danagwen-gudimalad-ibmar-guchagusad-obesadi,","poem":1},{"text":"sorba ses-dummagan-gudidimalad gunnonimalad.","poem":2},{"text":"Geb ses-dummagan-gudidimalad-ibmar-guchagusad-obesadi,","poem":1},{"text":"sorba ses-sapingana gunnonimarmogad.","poem":2},{"text":"Geb ses-sapingana-ibmar-guchagusad-obesadi,","poem":1},{"text":"sorba ses-burwigana gunnonimarmogad.","poem":2},{"text":"Be-dadgan-ibagangi, ¿ar weyobi neg-gusa?","poem":1},{"text":"Bemar-emi-dulagudimaladgi, ¿ar bemar weyob neg-dakdimala?","poem":2},{"text":"Emi, be-mimmigangala, be we-ibmar sogmala,","poem":1},{"text":"adi, be-mimmigan na e-mimmiganga sogmarmogaga,","poem":2},{"lineBreak":true},{"text":"deginmoga, a-mimmigan na e-wagan-danimaloedga sogmarmogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"”¡Mummugan, atakmala, be bomala!","poem":1},{"text":"Bela-gadi-vino-gobmalad be nunmak itomala,","poem":2},{"text":"ar ade, vino-binid bemar-annik sulesad.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Ar dule-yar-baidgi-bukmalad-gandikmalad-bukidar, an-yargine ubononikid.","poem":2},{"text":"E-nugarmar, achumigur-nugarmaryobi nikamalad.","poem":1},{"text":"E-nugar-suigan, achumigur-e-ome-nugaryobi nikamalad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"An-uva-dubmar-digar-naid obelosmalad.","poem":1},{"text":"An-higuera-sapimar daas-daas-imaksad.","poem":2},{"text":"Bela e-uka yaas-yaas-imaksamalad,","poem":1},{"text":"e-anagan swanga imaksamalad.","poem":2},{"lineBreak":true},{"text":"Bela omukusmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”An-dulemar, yagwa wile-itoged-mor-yoi na machered-abesiid-ei-burgwisadba-boedyobi, bomalad.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Bab-Jehováʼse-goled-neggi ibmar-gwag-orosgi-dakleged-ukleged bar uklesulid,","poem":2},{"lineBreak":true},{"text":"degi, vinoʼmar bar uklesurbalid.","poem":2},{"text":"Dule-irwa-Bab-Dummadse-gormalad Bab-Jehováʼga-arbamaladi, bomarmogad.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Nainumar bela swanga nanaid,","poem":2},{"lineBreak":true},{"text":"e-napamar bela dinna naded.","poem":2},{"text":"Bela ibmar-gwag-orosgi-dakleged bergusad,","poem":1},{"text":"vinoʼmar bela dinguded,","poem":2},{"lineBreak":true},{"text":"olivoʼmar bela berguded.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”Bemar, sapurgi-arbamalad, bemar uva-dubgi-arbamalad, ibmar-gwag-trigoʼye-nugad-bela-dingusadba,","poem":1},{"text":"ibmar-gwag-cebadaʼye-nugad-bela-dingusadba, be bomala.","poem":2},{"text":"Ar bela ibmar-gwagmar-welesadi oitolesad.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Uva-dubmar bela dinguded,","poem":1},{"text":"sapi-higueraʼye-nugad, bela burgwided.","poem":2},{"text":"Sapi-granadoʼye-nugad bela dingudmogad,","poem":1},{"text":"ogobgi-dakleged, manzana-sapimar, dingudmalad.","poem":2},{"text":"Bela sapimar-gwigwichid dingudmalad.","poem":1},{"text":"Dulemar-e-yeer-itodiidse-bakale, e-ibe bergunonikid.”","poem":2}]},{"type":"heading","content":["Isgued-barsogmarye gorlenaid"]},{"type":"verse","number":13,"content":[{"text":"Dule-irwa-Bab-Dummadse-gormalad, be wile-itomar,","poem":1},{"text":"wile-itoged-mor be yomar.","poem":2},{"text":"Bab-Jehováʼga-ibmar-ukleged-ailagi-arbamalad,","poem":1},{"text":"naibid-dummad be itomar.","poem":2},{"text":"An-Bab-Dummadga-arbadimalad, be dagmala,","poem":1},{"text":"wile-itoged-mor-yoi, be oibomar,","poem":2},{"text":"ar ibmar-gwagmar, degi, vinoʼmar","poem":1},{"text":"Bab-Dummadse-goled-neggi bar uklesulid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bela dulemarse gormala,","poem":1},{"text":"mer-bar-mas-gulleged-iba be nasikmalo.","poem":2},{"text":"Be-Bab-Dummad-Jehováʼse-goled-neggi, girmar-dummagan be onmakmala,","poem":1},{"text":"bela dulemar-we-yargi-gudidimalad be onmakmala,","poem":2},{"text":"agi Bab-Jehováʼse ise-gollar imakmala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"¡Iba-buledi danikid!","poem":1},{"text":"¡Bab-Jehová-e-iba bato warmakdanikid!","poem":2},{"text":"Bab-Dummad-Bela-Gangued-Nika-Maid-e-iba,","poem":1},{"text":"ibmar-bergued-iba guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Anmar-masgulleged, ¿anmar-wagab anmar-ibe sulenai gussursi?","poem":1},{"text":"Anmar-Bab-Dummadse-goled-neggi anmar-wergued, anmar-yeer-itoged,","poem":2},{"lineBreak":true},{"text":"¿anmar-ibe osulolessursi?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ibmar-gwag diglesa-inigwele, degite, bela nungusad.","poem":1},{"text":"Ibmar-saboleged-neg isgus-sii.","poem":2},{"text":"Ibmar-gwag-saboleged-negmar bela bibichisad.","poem":1},{"text":"Ar ibmar-gwagmar bela dingusmalad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ibiyobi molimar masbina gornanai.","poem":1},{"text":"Moli-bebe-nikamalad masgunned satedbali oes gaamakdidimalad.","poem":2},{"text":"Sibad-wawaadmar deyobi gudidimarmogad.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Bab-Jehováʼye, an bese ise-wilegar goled,","poem":1},{"text":"ar ade, nainumargi gagan-nanaid soo ogumaksad,","poem":2},{"lineBreak":true},{"text":"bela sapimar-gwigwichid ogumaksad.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bab-Jehová, amba ibmar-durganse-bakale, bela-bela be-amimalad,","poem":1},{"text":"ar ade, bela diwarmar-mamaidi dingusad,","poem":2},{"lineBreak":true},{"text":"nainumargi gagan-nanaid soo ogumaksad.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":18}