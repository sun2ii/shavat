{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOL","translationId":"cuk_nvs","name":"Joel","commonName":"Joel","title":"JOEL-GARDA JOEL","order":29,"numberOfChapters":3,"sha256":"d8fd606abe9b04d050ec1e54936861f20dc87915a9da2838fee6f9319578b4ac","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cuk_nvs/JOL/3.json","totalNumberOfVerses":71},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Sión-yargine gar-trompeta ogormar,","poem":1},{"text":"an-yar-islidikidgi neg-owisoleged-gar be ogormar.","poem":2},{"text":"Bela dulemar-we-yargi-gudimalad wawanmakmar,","poem":1},{"text":"ar ade, Bab-Jehová-danikid-e-iba mosad,","poem":2},{"lineBreak":true},{"text":"ar bato nue-warmaksad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"A-ibagi, negasichid nagunonikoed,","poem":1},{"text":"neg gudure sigoed.","poem":2},{"text":"Mogirmar-gudureged nagunonikoed,","poem":1},{"text":"neg daas sigoed.","poem":2},"2. BAB-JEHOVÁ-E-IBA-DANIKIDGI GANNAR SUNMAKLENAID (2:2b-11)",{"text":"Igi neg-oibodanikile, bela yarmargi neg-mee imakdanidae,","poem":1},{"text":"deyobi, dule-bukidar dule-bulegana danimaloed.","poem":2},{"text":"Epenne we-dulemaryobid dulemar gwen dakledisulid,","poem":1},{"text":"deginbali, yoedsega dulemar-deyobid gwen daklegosurbalid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"We-dulemar sooyobi gumalad,","poem":1},{"text":"bela ese ibmar gummaked.","poem":2},{"text":"We-dulemar-nonikoed-iduale, soo bela ibmar-ogumaked,","poem":1},{"text":"we-dulemar-nasad-sorbali, soo bela ibmar-obeloged.","poem":2},{"text":"We-dulemar, amba yoo dagegua,","poem":1},{"text":"we-yar-naidi, Edén-nainuyobi daklegenad.","poem":2},{"text":"We-dulemar, we-yargi-nasmargua,","poem":1},{"text":"e-sorbali, yar, nega-dulesulidganyob nagusad.","poem":2},{"lineBreak":true},{"text":"E-ganguedgi ibmarmar geg wakinned.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"E-gangued, moliyob gangumalad.","poem":1},{"text":"Dulemar-moli-birgi-abarmakmaidyob abarmakmalad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yar-birgi ichomakdemalale, bila-onomalad-ur-napagined-gollomakedyob, oimakmalad.","poem":1},{"text":"Igi-gagan-dinnagana soose-gummakdele, gormamaidae,","poem":2},{"lineBreak":true},{"text":"deyobi gollomakmalad.","poem":2},{"text":"Igi-bila-onomalad-bulegan, bila-onogega guagwar bukmala,","poem":1},{"text":"deyobi gumalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"We-dulemar-asabin bela dulemar-we-napneggi-bukmalad gwakidmalad,","poem":1},{"text":"bela e-niga argwatemalad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bila-onomalad-buleganyobi urwemalad,","poem":1},{"text":"bila-onomaladyobi galumar-birgi nakwe-nakwe imakmalad.","poem":2},{"text":"Bela ilekwaa na e-igarba namaloed","poem":1},{"text":"gwen igar-baid-baidsik-nadapi gumalosulid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Na muchub-muchub-yolenanai gumalosulid,","poem":1},{"text":"na ilemakar nadapmaloed.","poem":2},{"text":"Sigu-egi-milemamaid-abinni,","poem":1},{"text":"amba ilekwaa nadapi gumaloed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"We-dulemar neggweburgi sabsur ubononimaloed,","poem":1},{"text":"galumar-matusulid-mamaid-birgi abarmakdimaloed.","poem":2},{"text":"Negmargi nakwe-nakwe imaknonimaloed,","poem":1},{"text":"dule-atursamaladyobi, yawagak-seniganaba dognonimaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"We-dulemar-bila-onomalad-abin napneg wawanmakdoed,","poem":1},{"text":"nibneg giglimakdoed.","poem":2},{"text":"We-dulemar-abin dada, degi, nii sichii nadoed,","poem":1},{"text":"bela niisgwamala bar gaosulid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Jehová, e-sordamar-idu-nadapi,","poem":1},{"text":"maryob e-gaya-goled itogega imakoed.","poem":2},{"text":"Bab-Jehová-e-sordamala bukidarad,","poem":1},{"text":"e-igar-uksadba-ibsamaladi, gege ebisleged.","poem":2},{"text":"Bab-Jehová-danikid-e-iba gwayed-dummadid, dobed-dummadid.","poem":1},{"text":"¿Doa abin-gwisguoe?","poem":2}]},{"type":"heading","content":["Isgued na be barsogmarsun"]},{"type":"verse","number":12,"content":["Bab-Jehová weyob soged:",{"text":"“Emigindi, bela-bela be-gwage-ulubgine be an-amimala,","poem":1},{"text":"mas-gunsuli be gudii gumar,","poem":2},{"lineBreak":true},{"text":"be bomar, degi, be naibi itomar.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Wile-itogedbali, mer mor-esirmakedgi be binsamar.","poem":1},{"text":"Unnila gwagegi nunmaked-dummad-itonai be gumar.","poem":2},{"text":"Be-Bab-Dummad-Jehová be gannar amimar,","poem":1},{"text":"ar ade, Bab-Dummad, dule-nuedid, dule-wiledakedid,","poem":2},{"text":"Gwae-gwae urwesulid, bela-bela emar-sabgumaid,","poem":1},{"text":"sabsur-odurdakoye-sogda-inigwele, igi-barsaye sogdedaed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Abakale, Bab-Dummad binsaed gwakalile, igi-barsaye sokalile,","poem":1},{"text":"deyobi, anmargi ise-nued binsaoed.","poem":2},{"text":"Ibmar-gwag-ukleged, degi, vinoʼmar,","poem":1},{"text":"Bab-Dummad-Jehováʼgadga guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Sión-yar-birgi gar-trompeta ogormalo,","poem":1},{"text":"dulemar-onmakega ese gormalo,","poem":2},{"lineBreak":true},{"text":"masgullesulid-iba nasikmalo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bela dulemar-bukwad-onmakega imakmalo,","poem":1},{"text":"bela dulemar swilidik ambikumalo.","poem":2},{"text":"Sapin-dummagan bela onmakmalo,","poem":1},{"text":"burwigana onmakmalo,","poem":2},{"lineBreak":true},{"text":"goemarse-bakale, onmakmalo.","poem":2},{"text":"Emisgwa-ome-nikusad e-gabedneggi nodage,","poem":1},{"text":"emisgwa-sui-nikusad e-gabedneggi-maidgi nodamoga.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bab-Dummad-neg-yawagak-siid,","poem":1},{"text":"degi, ibmar-ukleged-aila-siid,","poem":2},{"text":"amar-imbagi, dule-irwa-Babse-gormalad Bab-Jehováʼga-arbamaladi, be bomala.","poem":1},{"text":"Weyob sognanai be gumala:","poem":2},{"text":"“Bab-Jehováʼye, be wile be-dulamar dake.","poem":1},{"text":"Mer be-dulamar-nug-oichogega be imake,","poem":2},{"lineBreak":true},{"text":"mer dulemar-yar-baid-baidgi-bukmalad be-dulamargi dodogega be imake.","poem":2},{"text":"Ibiga dulemar-yar-baid-baidgi-bukmalad sogmaloe:","poem":1},{"text":"‘¿Ar bia e-Bab-Dummad nadsunna?’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Geb degine, Bab-Jehová na e-sabgued e-yarga oyosad,","poem":1},{"text":"e-dulamar egi-isgussuliyobi daksad.","poem":2}]},{"type":"heading","content":["Bab-Jehová e-dulamar-ese-wilenaid-abin-imaksad"]},{"type":"verse","number":19,"content":["Bab-Jehová e-dulamarga weyob sogded:",{"text":"“An bemarga ibmar-gwag ukoed,","poem":1},{"text":"vinoʼmar, degi, olivo-gwallu ukbaloed.","poem":2},{"text":"Bemar we-ibmarmargi immelemaloed.","poem":1},{"text":"Dulemar-yar-baid-baidgi-bukmalad bemargi dodomalaga bar an imakosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"”Dule-dad-nakwed-argan-sapiledsik-danikid an bemargi-banguega imakoed,","poem":1},{"text":"a-dule, dule-buksurmaladsik, dule-negasulidganba an balimetoed.","poem":2},{"text":"E-sordamar-idu-danimalad, dad-nakwedsik-demar-naidgi, didulegega an imakoed.","poem":1},{"text":"E-sordamar-sorba-danimaladdi, dad-argwanedsik-demar-naidgi, didulegega an imakoed.","poem":2},{"text":"E-muimar nunguega an imakoed,","poem":1},{"text":"sunnasuli-yapannega an imakoed.”","poem":2},{"text":"Bab-Jehová ibmar-dummagan imakoed.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"An-yargi-bukmalad mer-dobgumala,","poem":1},{"text":"bur weligwar itomala, wergumala.","poem":2},{"lineBreak":true},{"text":"Ar Bab-Jehová ibmar-dummagan imakoed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ibdula-sapurbarmalad, mer dobgumala,","poem":1},{"text":"ar gaganmar aramakdagoed.","poem":2},{"text":"Sapimar bela sanmakdagoed,","poem":1},{"text":"sapi-higueraʼye-nugadi, degi, uva-dubmar yeer sanmakdagoed.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Sión-dulemar weligwar-itomar,","poem":1},{"text":"be-Bab-Dummad-Jehováʼba be wergumarsun.","poem":2},{"text":"Ar be-Bab-Jehová e-iba-sogedba bega dii owioed.","poem":1},{"text":"Ar igi epenneunni, ibmar-digleged-idu dii owidae,","poem":2},{"text":"degi, ibmar-gwag-weleged-idu dii owidae,","poem":1},{"text":"deyobi bemarga dii-wied-ibagan nasikoed.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ibmar-gwag-saboged-negmar ibmar-gwag ena sigoed.","poem":1},{"text":"Ibmar-gwagmar-egured-negmar vino ena sigoed.","poem":2},{"lineBreak":true},{"text":"Olivo-gwallu ena sigbaloed.","poem":2}]},{"type":"verse","number":25,"content":["Bab-Jehová soged:",{"text":"“Ses-danagwen-gudimalad, ses-dummagan,","poem":1},{"text":"ses-sapingana, ses-burwigan,","poem":2},{"text":"birga-nasmaladgine bemar-ibe bela ibmar-gwag guchagusad,","poem":1},{"text":"gannar bemar a-ibmarmar-nikuega an be-imakoed.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bemar obinebaka, nue-immelegedse gunmaloed,","poem":1},{"text":"geb be-Bab-Dummad-Jehová-nug be odummomaloed.","poem":2},{"text":"Ar ani be-Bab-Dummad-Jehová, bemarga ibmar-gegerdakleged imakoed.","poem":1},{"text":"An-dulamar bar bipisaale, bingeguosurmalad.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Geb degine, wisgumaloed,","poem":1},{"text":"ani an Israel-dulemar-abargi gudiiye.","poem":2},{"lineBreak":true},{"text":"Ani an e-Bab-Dummad-Jehová gued.","poem":2},{"text":"Anyobid dule-baid sated.","poem":1},{"text":"An-dulamar bar bipisaale, bingeguosurmalad.”","poem":2}]},{"type":"verse","number":28,"content":["Bab-Jehová sogdebalid:",{"text":"“We-ibmar-gusad-sorbali, An-Burba bela-dulemargi an odenonikoed.","poem":1},{"text":"Be-masmala, degi, be-bunamala, an-gayaburbagi sunmakdemaloed.","poem":2},{"text":"Selebagusmalad gabdakdemaloed,","poem":1},{"text":"sapingana negburgan dakdemaloed.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"A-ibagangi, An-Burba, mai-machergangi, mai-omegangi, an odenonibaloed.","poem":1}]},{"type":"verse","number":30,"content":[{"text":"Ibmar-gegerdakleged nibneggine, napneggine, an oyogoed.","poem":2},{"text":"Ablisbi neg-nagunonikoed,","poem":1},{"text":"soo-dummad oyolegoed,","poem":2},{"lineBreak":true},{"text":"degi, waa-bupurmagwichi neg gudoed.”","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Bab-Jehová-e-iba-dobegwar-itoleged-danikoed-idu,","poem":1},{"text":"e-iba-gwayed-dummad-danikoed-idu,","poem":2},{"text":"dad-ibegwar-ganaidi negasichidga gudoed,","poem":1},{"text":"nii-ganaidi ablisgi-oglesayobi ginnitibi daklenonikoed.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Bela dulemar e-Bab-Dummadga Bab-Jehová-imakmaladi, abonolemaloed.","poem":1},{"text":"Ar igi Bab-Jehová sogsagusa,","poem":2},{"lineBreak":true},{"text":"deyobi, Sión-yargi, Jerusalén-neggweburgi, abonoleged nikaoed.","poem":2},{"text":"Bab-Jehová na dulemar-susagusadi,","poem":1},{"text":"dulemar-dula-bemaloed-abargi gudii imakoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}