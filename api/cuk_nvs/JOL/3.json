{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JOL","translationId":"cuk_nvs","name":"Joel","commonName":"Joel","title":"JOEL-GARDA JOEL","order":29,"numberOfChapters":3,"sha256":"d8fd606abe9b04d050ec1e54936861f20dc87915a9da2838fee6f9319578b4ac","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cuk_nvs/JOL/3.json","totalNumberOfVerses":71},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["Bab-Jehová weyob soged:",{"text":"“A-iba-nonikile, Judá-yarginmalad, degi, Jerusalén-dulemar,","poem":1},{"text":"yar-baid-baidse-gales-selesgusmaladi, an gannar e-yarse senonikoed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bela dulemar-yar-baid-baidgi-bukmalad an onmakoed,","poem":1},{"text":"Josafat-Nebase-ambikuega an imakoed.","poem":2},{"text":"Agine, an-Israel-dulamar-sabed-nukad,","poem":1},{"text":"an we-dulemala sabsur-odurdakoed.","poem":2},{"text":"Ar we-dulemar, an-dulamar yar-baid-baidse-oaisakiega imaksamalad,","poem":1},{"text":"an-yar-naid mimismalad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"We-dulemar ibmargi-wilubdakar an-dulamar-mimismalad.","poem":1},{"text":"Omegan-gamba-imaked-muchub, burwigana uksamalad.","poem":2},{"text":"We-dulemar na mumgumalaga,","poem":1},{"text":"vino-muchub, bunamala manigi uksamalad.","poem":2}]},{"type":"verse","number":4,"content":["”Sidón-neggwebur, Tiro-neggwebur, degi, bela Filistea-yarginmalad, ¿ibiga bemar angi yolenanai? ¿Ar bemar bugedmai an-imakbimala? Ar deyob be an-imakbimalale, bemar-bugedmai-an-imakbimalad, bemargi emiskwaa aibinega an imakoed."]},{"type":"verse","number":5,"content":["Ar bemar an-ibe or, mani atursasmalad. Deginbali, bemar an-ibmar-nuegan be-bab-dummadgan-negse be sesmarbalid."]},{"type":"verse","number":6,"content":["E-yargi-dikasur-banguega bemar Grecia-dulemarga Judá-dulemar, degi, Jerusalén-dulemar uksamalad."]},{"type":"verse","number":7,"content":["”Emigindi, bemar wisgubi an abedo, bemar doa-dulemarga Israel-dulemar-uksamala, amar a-yargi-bukwadgi an onogoed. Ar igi bemar an-dulamar-imaksamala, deyobi an bemar-imakmarmogoed."]},{"type":"verse","number":8,"content":["Judá-dulemarga be-masmala, be-bunamala, an manigi ukoed. Geb Judá-dulemar, Sabá-dulemarga ukmarmogoed. We-Sabá-dulemar dikasur yar-baidgi bukmalad.” Bab-Jehová weyob sogsad:"]},{"type":"verse","number":9,"content":[{"text":"“Dulemar-yar-baid-baidgi-bukwamaladga, be weyob sogmala:","poem":1},{"text":"‘Bila-onogega guakwaa ambikumala,","poem":2},{"text":"Sordamar bila-onogega be barmide,","poem":1},{"text":"Bela dule-bila-onomalad-bulegan urwega be guagwar bukumala.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Napa-imumaladgi es-suigan be sobmala,","poem":1},{"text":"es-doperegwadgi eswar be sobmala.’","poem":2},{"text":"Dule-gegegwad soge:","poem":1},{"text":"‘¡An dule-gandikidye!’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dulemar-anmar-yar-dikarba-bukwamalad, gwae be dagmala,","poem":1},{"text":"Josafat-Nebase be ambikudamala.”","poem":2},{"lineBreak":true},{"text":"Bab-Jehová, be-dule-gandikmalad be odedage.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Dulemar-yar-baidgi-bukwamalad, be dagmala,","poem":1},{"text":"Josafat-Nebase be dagmala.","poem":2},{"text":"A-nebagine, dulemar-yar-baidgi-bukwamaladga igar-nabogega an signonikoed.","poem":1}]},{"type":"verse","number":13,"content":[{"text":"Orosgi-dakleged-trigo goresale, igi es-doperegwadgi weledae,","poem":2},{"lineBreak":true},{"text":"ayobi, an we-dulemar-imakoed.","poem":2},{"text":"Uva-goresale e-nis-eguregala igi birgi gwirlege,","poem":1},{"text":"ayobi, an we-dulemar-imakoed.","poem":2},{"text":"Igi vino e-sigedgi engusadba dikarba aryomaidae,","poem":1},{"text":"ayobi, we-dulemar-e-isgusad doggus wilub-obichad.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Neba-Decisiónʼye-nugadgine,","poem":1},{"text":"dulemar-bukidara onmakdanikid.","poem":2},{"text":"Neba-Decisiónʼye-nugadgine","poem":1},{"text":"Bab-Jehová-e-iba warmakdanikid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Dad-ibeler-ganaid, degi, nii-ganaid bar gaosulid.","poem":1},{"text":"Niisgwamar bar gaosurbalid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bab-Jehová Sión-yar-akale, achumigur-nono-wawaadyobi binnasuli gordagoed.","poem":1},{"text":"Jerusalén-neggwebur-akale, mar-goleyobi binnasuli sunmakdagoed.","poem":2},{"lineBreak":true},{"text":"Bela napneg-naid, nibneg-naid, giglimakdoed.","poem":2},{"text":"Ar Bab-Jehováʼdi e-dulamarga dukued-negga gunonikoed,","poem":1},{"text":"Israel-dulemarga ganguedga gunonikoed.","poem":2}]},{"type":"heading","content":["Bab-Jehová e-dulamargi ise-nued-binsamaid"]},{"type":"verse","number":17,"content":["Bab-Jehová e-dulamarga sogded:",{"text":"“Geb degine, bemar wisgunonikoed, ani an be-Bab-Dummad-Jehová,","poem":1},{"text":"an-yar-Sión-islidikidgi an maid.","poem":2},{"text":"Jerusalén-neggwebur islidikidga gunonikoed.","poem":1},{"text":"Sordamar-yar-baidginmalad gandikidba bar egi ubogosurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"”A-ibagi, yarmargine, vino-osidikid aryonai gudoed,","poem":1},{"text":"yar-seniganagine, moli-nunismar aryomai gudoed,","poem":2},{"lineBreak":true},{"text":"Judá-dianmargine, diimar aryomai gudoed.","poem":2},{"text":"Anse-goled-neggine, dii aryodagoed,","poem":1},{"text":"we-dii, neba-Sitimʼye-nugad-ognai gudoed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Egipto-yar-naidi, sabsur-Judá-dulemar-imaksamalad-nukad, bela ibitogoed.","poem":1},{"text":"Edom-yar-naidi, sabsur-Judá-dulemar-imaksamalad-nukad, nega-dulesulidganga binyoed.","poem":2},{"text":"Ar wemar, Judá-yargine dulemar-gwen-ibmar-oakalossurmalad-ibe ablis eos gusmalad.","poem":1}]},{"type":"verse","number":20,"content":[{"text":"Judá-yargi, degi, Jerusalén-neggweburgi, degisadegu dulemar bukwa gudoed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Dulemar-ibe-ablis-eosmalad, ¿baisur an dakoe?","poem":1},{"text":"Suli, baisur geg an daked. An buged-mai imakedsegad.”","poem":2},{"text":"Bab-Jehová, Sión-yargi megnonikoed.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}