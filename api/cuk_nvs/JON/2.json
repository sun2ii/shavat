{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"JON","translationId":"cuk_nvs","name":"Jonás","commonName":"Jonás","title":"JONÁS-GARDA JONÁS","order":32,"numberOfChapters":4,"sha256":"816985a49589097178b43ce26c5577a4b7052212d319db21729bf59b865b0cf6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/cuk_nvs/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Geb degine, Jonás ua-sabanyaba-mai, e-Bab-Dummad-Jehováʼse goted."]},{"type":"verse","number":2,"content":["Ega sogded:",{"text":"“An dummad-wilenaidgi, an bese gochad.","poem":1},{"text":"An bese gochagua, be an-itononikid.","poem":2},{"text":"Bato an burgwarmalad-neg-gullugi-mai an gochad.","poem":1},{"text":"Agi, Bab-Jehová be an-bendaknonikid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Demar-wilasolase, dii-ulak be an-barmeted.","poem":1},{"text":"Be-demar-ebilemaid, bela angi nasad.","poem":2},{"text":"Be-demar-dummagan-nukamakmaidi, bela angi bipirmaksad.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"Weyob an binsanonikid:","poem":2},{"text":"Bab-Jehová nue an-obachasunye.","poem":1},{"text":"Degi-inigwele, an gannar ese-goled-neg-swilidikidsik an nabaloye.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bela diimar dukarse an-ebiris-nagusad,","poem":1},{"text":"demar-wilasailad bela an-ebirisad,","poem":2},{"text":"demar-gaganmar an-nonogi bela bipirmaksad.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Bela-bela demar-napa-ulubse an megdapid.","poem":2},{"text":"¡Bato an napa-ulubgi-mellesigua, gwen bar noed an itossulid!","poem":1},{"text":"Degi-inigwele, be an-Bab-Dummad-Jehová-gued,","poem":2},{"lineBreak":true},{"text":"an gulluba-mellesiidgi be an-onononikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"”An na nue-burgwe-itogua, Bab-Jehová, an begi binsaded,","poem":1},{"text":"agi an bese goted.","poem":2},{"text":"An-bese-goled, bese mosad,","poem":1},{"text":"bese-goled-neg-swilidikidse warmaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”Dulemar-bab-dummaganse-gormaladdi, Bab-Dummad-e-sabgued gwen bai daksurmalad.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Andina, an weligwar-namakedgi, an bega ibmar-ogumakar ukoed.","poem":2},{"text":"An bega ibmar-imakoye ise-sogar an sogsad, an imakedsegoed.","poem":1},{"text":"¡Bab-Jehová, unnila bebi sunna dule-abonoged!”","poem":2}]},{"type":"verse","number":10,"content":["Geb agine, Bab-Jehová Jonás-onogegala, ua-dummad-agega imaksad. Geb neg-dinnagwadgi ua agsagua, Jonás neggunasse nononikid."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}