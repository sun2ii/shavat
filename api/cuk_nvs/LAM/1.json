{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"LAM","translationId":"cuk_nvs","name":"Lamentaciones","commonName":"Lamentaciones","title":"NAIBI-ITOLEGED-GARDA LAMENTACIONES","order":25,"numberOfChapters":5,"sha256":"0492aaa92e8ddff49499b97fff64edca51875bc19315f151bddc19e006330ece","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/cuk_nvs/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"heading","content":["Sión-neggwebur-galessiid naibi-itosiid"]},{"type":"verse","number":1,"content":[{"text":"Sión-neggwebur dulemar-bukidar-nikagusanad,","poem":1},{"text":"emidi, ibiyobi walagwen-ganna sigisa.","poem":2},{"text":"Jerusalén-neggwebur, neggwebur-bamaladba-bur-nuga-nika-sigisanad,","poem":1},{"text":"emidi, ome-ei-sui-burgwisadyobi siid.","poem":2},{"text":"Jerusalén-neggwebur, neggwebur-bamalad-e-dummadga-sigisanad,","poem":1},{"text":"emidi, neggwebur-bamalad-e-maiga siid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mutikidbali, naibid-dummad-itogedbali bela-bela boed,","poem":1},{"text":"e-wagarbali e-ibyanis suurmakmaid.","poem":2},{"text":"Dulemar-nue-sabye-sogdimalad-abargi, e-gwage-baisur-ito-imakedi, wargwensaale sated.","poem":1},{"text":"Bela e-aimar egi aibichamalad, e-isdarmaladga gunonimalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Judá-dulemar esgoro-dubgi-atinnale,","poem":1},{"text":"yar-baidse gales selesmalad.","poem":2},{"text":"Dule-ainebarmalad-abalagi-gudidimalad,","poem":1},{"text":"gwen obunnoged amisurmalad.","poem":2},{"text":"Bela-balegindimalad, Judá-dulemar-bargasmalad,","poem":1},{"text":"sabsur-odurdaksamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Sión-neggweburse-naega igarmar-mamaidi, wiles dakleged,","poem":1},{"text":"ar e-itoakwaa-ibagan-onolegedse dulemar bar nanasurmalad.","poem":2},{"text":"Bela e-yawagakmar bergus gwigwichid.","poem":1},{"text":"E-dule-irwa-Bab-Dummadse-gormalad bodimalad.","poem":2},{"text":"E-yagana, wile itodimalad.","poem":1},{"text":"Jerusalén-neggweburgi bela nunmakedbi neg-nagusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"E-isdarmalad, e-dummaganga gunonimalad,","poem":1},{"text":"e-isdar-dakmalad, ibmar bur bule nikudmalad.","poem":2},{"text":"E-isgued-bukidar-nikad-ulale, Jerusalén-dulemar Bab-Dummadse sabsur-odurdaklenonimalad.","poem":1},{"text":"E-mimmigan gales aineba selesmalad, e-isdarmaladse ebipilesmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sión-neggwebur epenne e-yeerdaklesigusadi, bela bergunonikid.","poem":1},{"text":"E-dummagan, goe-sapur-gagan-maega-amididamaladyob gaamakdimalad.","poem":2},{"lineBreak":true},{"text":"E-balegindimalad-abin geggus wakitemalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Jerusalén-neggwebur, e-ibagan-isgana-nasad ebinsaed,","poem":1},{"text":"e-dulemar-gales-selemamaigusad, ebinsaed.","poem":2},{"text":"Epenne bela-ibmar-nuegan-bukidar-nikagusad, ebinsaed.","poem":1},{"lineBreak":true},{"text":"E-dulemar, e-isdarmaladse-galesmargua,","poem":1},{"text":"dule-bamalad gwen bendaksasulid.","poem":2},{"text":"E-isdarmalad, Jerusalén-dulemar-galakus-daksagua,","poem":1},{"text":"egi dodonai gusmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jerusalén-neggwebur bela-bela isgusad.","poem":1},{"text":"A-ulale, ib-isganaga gunonikid.","poem":2},{"text":"Jerusalén-neggwebur-ayaris-sii-dakarmargua, dulemar, iduar Jerusalén-nug-odummodimalad,","poem":1},{"text":"emidi, isdar dakmalad.","poem":2},{"text":"Jerusalén-dulemar na boed,","poem":1},{"text":"binge-itogedba na wagar odukued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bela e-mor nue-isgusad,","poem":1},{"text":"na e-berguoedgi binsassulid.","poem":2},{"text":"Ukiagwar oitolenonikid,","poem":1},{"text":"dule-bamalad gwen-wile daksasulid.","poem":2},{"text":"Emidi, soged: “Bab-Jehováʼye, an-wile-itoged be dake.","poem":1},{"text":"An-isdarmalad angi obichad.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Jerusalén-neggwebur e-ibmar-nuegan-nikadi,","poem":1},{"text":"e-isdarad bela e-ibe susad,","poem":2},{"text":"E-Bab-Dummadse-goled-neggi, dulemar-Bab-Dummad-akudakmalad-ubosmalad","poem":1},{"text":"Jerusalén-dulemar daksamalad.","poem":2},{"text":"Bab-Jehová, be a-dulemarga igar-mesisanad,","poem":1},{"text":"mer an-igar-itoged-negse dogmaloye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bela Jerusalén-dulemar bodimalad, masgunned amidimalad.","poem":1},{"text":"Na dulagudigumalaga, e-ibmar-bur-nuegan masbina ogwaed.","poem":2},{"text":"Ise-boale sogmalad:","poem":1},{"text":"“Bab-Jehováʼye, be dake, ibiyobi an-wionanai.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Sogdebalid: “Bemar-igarba-nadapmalad, be an-dakmala,","poem":1},{"text":"¿gwen-bai be an-daksuli?","poem":2},{"text":"Bab-Dummad-sabsur-an-wionaiyobi,","poem":1},{"text":"¿bia be deyob dule-wilenai daksamala?","poem":2},{"text":"Ar Bab-Jehová na nue-uludgua,","poem":1},{"text":"we-nunmaked anga barminonikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”Bab-Jehová, nibneg-akale, soo barmialid.","poem":1},{"text":"A-soo, garmarse-bakale, an-ogumaksad.","poem":2},{"text":"An-iduale, saki nasiksad,","poem":1},{"text":"gannar sikirmakega an-imaksad.","poem":2},{"text":"Walagwen an-meted,","poem":1},{"text":"bali-bali nunmaked-itogega an-imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"”Bab-Jehová-sunnad an-isgued oatosad,","poem":1},{"text":"an-isgued akwa-dummad-aidikuedyob angi naid.","poem":2},{"text":"An-dukarba anga nasiksad,","poem":1},{"text":"an-gargangued nolloo imaksad.","poem":2},{"text":"Bab-Jehová, an-isdarmaladga an-urmaksad,","poem":1},{"text":"an geg amar-abin-imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"”Bab-Jehová, an-neggweburgi bela sordamar-bulegan onisad.","poem":1},{"text":"Angi yolemalagala, dule-bamaladse gochad,","poem":2},{"lineBreak":true},{"text":"an-sapingan-oitogegala, dule-baiganse gochad.","poem":2},{"text":"Igi uva-nis-egurega uva-birgi annaledae,","poem":1},{"text":"deyobi Bab-Jehová, Judá-e-bunamala imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"”Bela we-ibmala boega an-imaked,","poem":1},{"text":"boedba nue an ataksurgusad.","poem":2},{"text":"Dule-an-gwage-baisur-ito-imaked an-walik gudisulid,","poem":1},{"text":"dule-wis-gadi-gadi-an-imaked, an daksulid.","poem":2},{"text":"Ar an-isdarmalad anmargi nakwissoggu,","poem":1},{"text":"an-mimmigan wargwen melledmarsunnad.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Sión-dulemar, bendaklegegala gornanaid,","poem":1},{"text":"ar dule-e-gwage-baisur-ito-imaked sated.","poem":2},{"text":"Bab-Jehová-igar-mesnonikidba, Jacob-yar-naid-dikarba-neggwebur-bukmalad,","poem":1},{"text":"emidi, Jacob-e-isdarmaladga gunonikid.","poem":2},{"text":"Jerusalén-neggwebur ibmar-durwaga gunonikid,","poem":1},{"text":"ibmar-isganaga gunonikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Bab-Jehová, innikigwadba ibmar-imakedid,","poem":1},{"text":"ar andi, e-igar-mamaidgi aibichad.","poem":2},{"text":"Bemar bela dulemar, nue an-itomala,","poem":1},{"text":"an-wile-itonaid be nue dakmala.","poem":2},{"text":"An-sapingana, bela-gales aineba selesmalad,","poem":1},{"text":"an-bunamala, bela-gales aineba selesmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"”An-aimarse, an iseedi gornai gusanad,","poem":1},{"text":"aka bur angi aibichamalad.","poem":2},{"text":"An-dule-irwa-Bab-Dummadse-gormalad, an-girmar-dummagan, na dulagudigumalaga mas-amidigu,","poem":1},{"text":"neggweburgi burgwismalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"”Bab-Jehová, an-nunmak-itonaid, be dake.","poem":1},{"text":"An burgwe itoged.","poem":2},{"text":"An beba bela-bela ibsassursoggu, an-gwage suli-suli-ito naded.","poem":1},{"text":"Neg-magabali, an-mimmigan, es-suidgi oburgwilenanaid,","poem":2},{"lineBreak":true},{"text":"wegi negyabali, burgwed neg-gasa naid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"”Dulemar an-gormaknaid itosmalad,","poem":1},{"text":"ar dule-an-gwage-baisur-ito-imaked sated.","poem":2},{"text":"Bela an-isdarmaladi, an-wilenaid wismalad,","poem":1},{"text":"be igi-an-imaksadgi wergumalad.","poem":2},{"text":"An igi-wilesa, deyobi wilemarmosun.","poem":1},{"text":"Be sabsur-odurdaklemaloye-sogsagusadi,","poem":2},{"lineBreak":true},{"text":"an-isdarmaladgi gwae be barmidasun.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"”Bab-Jehová, bela an-isdarad-e-isgumalad be dake.","poem":1},{"text":"An-isgusad-ular, igi be sabsur-an-odurdaksagusa,","poem":2},{"lineBreak":true},{"text":"deyobi be an-isdarmalad imakmoga.","poem":2},{"text":"Bato an bukidargus nunmaked-itodanikid,","poem":1},{"text":"nue-angi obin an itogusad.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}