{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"LAM","translationId":"cuk_nvs","name":"Lamentaciones","commonName":"Lamentaciones","title":"NAIBI-ITOLEGED-GARDA LAMENTACIONES","order":25,"numberOfChapters":5,"sha256":"0492aaa92e8ddff49499b97fff64edca51875bc19315f151bddc19e006330ece","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/cuk_nvs/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"heading","content":["Bab-Jehová, Israel-dulemar-ogilosad"]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová na e-uludedbali, ibiyobi Sión-neggwebur-yeerdaklegedgi negsichid nasiksa.","poem":1},{"text":"Bab-Jehová nibneg-akale, Jerusalén-neggwebur-yeerdakle-siid omukusad.","poem":2},{"lineBreak":true},{"text":"Bab-Jehová e-iba-uludedgi na ese-goled-neg, we-napneggi-siideeye binsassulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová bela Jacob-wagan-e-negmar-bukwadi, gwen-wile-daksasuli obelosad.","poem":1},{"text":"Bab-Jehová na e-uludedbali, Judá-yar-yeerdakleged-e-neg-gandikmalad bibichisad.","poem":2},{"text":"Bab-Jehová, Judá-e-rey-dummadga-maid-egwachadba, Judá-yar-nug bipii imaksad.","poem":1},{"text":"Judá-e-dummaganga-mamaid-egwachadba, Judá-yar-nug bipii imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová, uludgua, bela Israel-e-gargangued obelosad.","poem":1},{"text":"Anmar an-isdarmaladbo-urwenaigua, Bab-Jehová anmar-bendaksasulid.","poem":2},{"text":"Soo-dummad-bela-ibmar-obelogedyobi,","poem":1},{"text":"Jacob-e-yar-naidgi soo ogasad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová anmar-isdaradyob warsi guagwar gasad,","poem":1},{"text":"e-swida-nuedsikid guagwar oyosgwichid.","poem":2},{"text":"Bab-Jehová anmar-isdaradyob, anmar-gwenadgan-ogilosad.","poem":1},{"text":"Bab-Jehová na e-urwedi, sooyobi Sión-yeerdakleged-e-negmargi odesad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová anmar-isdaradyob na imaked:","poem":1},{"text":"Israel-yar obelosad.","poem":2},{"text":"Bela Israel-e-reynegmar bibichisad, Israel-e-neg-gandikmalad omukusad.","poem":1},{"text":"Bab-Jehová Judá-yar-yeerdaklegedgi boedbi, wile-itolegedbi, neg nasiksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bab-Jehová e-maid-neg sosganeg-siiyobi earisad,","poem":1},{"text":"e-onmakedneg-siidi omukusad.","poem":2},{"text":"Bab-Jehová, Sión-dulemar na e-iba-itoakwaa-onoleged-iegega imaksad,","poem":1},{"text":"e-obunnoged-iba-iegega imaksad.","poem":2},{"text":"Bab-Jehová nue-uludedbali, rey-maid obachad.","poem":1},{"text":"Dule-irwa-ese-goled obachad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová, na e-ibmar-ogumakar-ukleged-aila obachad,","poem":1},{"text":"na e-neg-islidikid isdar daksad.","poem":2},{"text":"E-reynegmar-e-galumar, e-isdarmaladga urmaksad.","poem":1},{"text":"E-isdarmalad, iba-dummad-nonaiyob, Bab-Jehová-neggi oimakdemalad,","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová, Sión-neggwebur-yeerdakleged-e-galu-matusur-ebirmaidi, omukuedgi binsasad.","poem":1},{"text":"Obeloged-igar ilemakar mesisad,","poem":2},{"lineBreak":true},{"text":"gwen-wile-daksasuli galu-matusur-maid obelosad.","poem":2},{"text":"E-arsanyob-maidgi, e-galumar-birgi nunmak-itoged nagusad,","poem":1},{"text":"bela we-ibmarmar malusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Jerusalén-neggwebur-e-yawagakmar bela aimukusad,","poem":1},{"text":"Bab-Jehová bela yawagak-edimalad bibichisad.","poem":2},{"text":"Jerusalén-e-rey yar-baidsik yoggus gudiid,","poem":1},{"text":"e-sapin-dummagan, yar-baidsik yoggus gudidimalad.","poem":2},{"text":"Bab-Dummad-igar bergusad,","poem":1},{"text":"Bab-Jehová, e-gayaburba-barsogmaladga bar negburgan oyossulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Sión-neggwebur-yeerdaklegedgi girmar-dummagan, napayala bogidik sigismalad.","poem":1},{"text":"Girmar-dummagan, nunmak-itogedba na e-nonogine, sogun-buru eosmalad,","poem":2},{"text":"wile-itoleged-mor yosmalad.","poem":1},{"text":"Bunamala-Jerusalénʼginmalad, bingedbali, napase dulluu nono imaksamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Boedbali, bar an nue ataksurgusad,","poem":1},{"text":"an bela-bela gwage nunmak itoged.","poem":2},{"text":"An-neggwebur-ibitosadbali, an-niga bela argwachad.","poem":1},{"text":"Burwigana, degi, goemala, neg-imbabali, burgwemamaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Burwigana e-nanganse egichardamalad:","poem":1},{"text":"“¿Bia masde? ¿Bia gobedde?”","poem":2},{"text":"Mas-satedbali, burwigana neg-imbabali, binna-binna burgwiddamalad.","poem":1},{"text":"E-nan-nukugi napi-bunnomai burgwiddamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Jerusalén-yeerdakleged, ¿ibu an begi obarosunna?","poem":1},{"text":"¿Doabogwa an be-wilubsaosunna?","poem":2},{"text":"Jerusalén-neggwebur-swilidikid, be-gwage-baisur-itogega, ¿ibu an bega oyogergebe?","poem":1},{"text":"Be-naibi-gusad, demar-wiladyob gued.","poem":2},{"lineBreak":true},{"text":"¿Doa gannar be-nudakoe?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Be-Bab-Dummad-gayaburba-barsogmalad, gakansaale negburgan-daksad bega sogsamalad,","poem":1},{"text":"be-yardakale bega sogsamalad.","poem":2},{"text":"Be-isgued gwen barsogsasurmalad,","poem":1},{"text":"melle be-gamalaga gwen be-bendaksasurmalad.","poem":2},{"text":"Bemarga gayaburba-gakansaaled sogsamalad,","poem":1},{"text":"a-gayaburbagi, melle be bensuliguega be-imaksamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dulemar-igarba-nadapmalad,","poem":1},{"text":"be-dakarmalale, begi dodoar argan ogotedamalad.","poem":2},{"text":"Jerusalén-neggwebur-yeerdakleged, be-asabin akar-akar gunanadaed.","poem":1},{"text":"Wigoar-wigoar sognanaidaed:","poem":2},{"text":"“¿Ar we-neggwebur nue-yeerdaklegedye sogmaladi?","poem":1},{"text":"¿Ar we-neggwebur, bela napneg-yeer-ito-imakedye sogmaladi?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Jerusalén-dulemar, bela be-isdarmalad begi-sunmakdemalale,","poem":1},{"text":"begi isdar sunmakdedamalad.","poem":2},{"text":"Nue-sae-be-dake, dodoar weyob sognanaid:","poem":1},{"text":"“Anmarse dula dolesad.","poem":2},{"text":"Anmar bela-bela-iba-edarbediid nonikid,","poem":1},{"text":"anmar-sunnad daksasunnad.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Bab-Jehová ibmar-imakega na igar-amisadi, sogedba imaksad,","poem":1},{"text":"na dikasurgus ibmar-sogsadi, bela imaksad.","poem":2},{"text":"Bab-Jehová be-wiledaksasuli, be-obelosad,","poem":1},{"text":"be-isdarmalad begi-dodogega imaksad,","poem":2},{"lineBreak":true},{"text":"begi-yolenanaid-e-gangued ogannosad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Sión-dulemar, Bab-Dummadse, ise-wilegar gornanaid.","poem":1},{"text":"Sión-neggwebur-yeerdakleged-galu-matusulid-nika-siid,","poem":2},{"text":"mutikidbali, ibginedbali, diwaryobi be-ibyanis aryomai be imake.","poem":1},{"text":"Mer be boed bogigue, mer be be-ibyanis-aryomaid bogiguega imake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Be gwisgue, mutikidbali be ise-gollar imake,","poem":1},{"text":"wachi-iliba be ise-gollar imake.","poem":2},{"text":"Bab-Jehová-asabin ibmar-ukleged-uknaiyob, gwage-nunmaked-itogedbali na be bosii imake.","poem":1},{"text":"Be-mimmigan-mer-burgwegala, Bab-Dummadse argan-onakwar be gorsii imake.","poem":2},{"text":"Be-mimmigan ukudbali burgwemamaid,","poem":1},{"text":"neg-imbaba burgwis mellemamaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Bab-Jehováʼye, be dake, nue be itogena:","poem":1},{"text":"¿Doa-dule be weyob imaksagusa?","poem":2},{"text":"¿Ar omegan na e-mimmigan gunmarsunnode?","poem":1},{"text":"¿Na e-mimmigan-egi-danimalad gunmarsunnode?","poem":2},{"text":"Bab-Jehováʼse-goled-neggi, ¿ar dule-irwa-Bab-Dummadse-gormalad oburgwilemalode?","poem":1},{"text":"¿Ar Bab-Dummad-gayaburba-barsogmalad oburgwilemalode?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"”Sapingana, degi, dule-serganse-bakale, neg-imbaba burgwar mellemamaid.","poem":1},{"text":"An-sapingana, degi, an-yagana, es-suidgi oburgwilesmalad.","poem":2},{"text":"Be-uludedbali, be wemar oburgwisad,","poem":1},{"text":"bela-bela-wiledaksuli, be wemar oburgwisad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"”Iba-dummad-onolegedse-danimalayob bela bonigan angi dagega be imaksad.","poem":1},{"text":"Bab-Jehová-Ulusad-ibagi, dule-wargwensaale, san-onossulid, bela burgwismalad.","poem":2},{"text":"An-gwenadgan an odummosadi, an ibmargi-odurdaksagusadi,","poem":1},{"text":"an-isdarmalad, bela an-ibe ogilosad.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}