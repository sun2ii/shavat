{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"LAM","translationId":"cuk_nvs","name":"Lamentaciones","commonName":"Lamentaciones","title":"NAIBI-ITOLEGED-GARDA LAMENTACIONES","order":25,"numberOfChapters":5,"sha256":"0492aaa92e8ddff49499b97fff64edca51875bc19315f151bddc19e006330ece","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/cuk_nvs/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"heading","content":["Ollorgued-igar Bab-Dummadgi edarbileged"]},{"type":"verse","number":1,"content":[{"text":"An-sunnagwad, Bab-Jehová-uludedbali sabsur-dule-odurdaked an itosad.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Negsichiganaba an-nimai gusad,","poem":2},{"text":"neg-meegwadba an-nimai gussulid.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Bali-bali, wachi-iliba, sabsur-an-odurdaknai gusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová, an-san, degi, an-uka-dunnumakega imaksad,","poem":1},{"text":"an-ibe an-garmar bibichisad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová angi bonigan ebiris nasiksad,","poem":1},{"text":"angi wileged-dummad ebiris nasiksad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dulemar-undargus-burgwismaladyob,","poem":1},{"text":"negsichigangi-gudiguega an-imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová negyaba-mellesii an-imaksad,","poem":1},{"text":"gege an wakinned,","poem":2},{"lineBreak":true},{"text":"esgoro-dub-dummagangi an-edichad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"An-bendakegala, an binnasuli gornai-inigwele,","poem":1},{"text":"Bab-Jehová an-ese-gornaid budar an-itoged.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"An-iduar, an-igargi akwamar misad,","poem":1},{"text":"an-ibe an-igar oburusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bab-Jehová, wiob mas-gaega matarmakdiidyobi anbina gudiid,","poem":1},{"text":"achumigur-nono-wawaad masbina matarmakdiidyobi anbina gudiid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"An-san-oichimakega igargi an-obachad,","poem":1},{"text":"mer bendakleged-amiega, walagwen an-obesad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Guagwar warsi-gasad,","poem":1},{"text":"e-sigumar an-makega imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"E-saboged-yaba sigumar-onosadgi gwagegi an-maksad.","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Bela an-dulemarga an dodoedga gunonikid,","poem":2},{"lineBreak":true},{"text":"bane-bane angi-dodolegar namakmalad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bab-Jehová nunmaked-dummad anga uksad,","poem":1},{"text":"ina-gagbidgi an-ogobsad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bab-Jehová napagi an-omukusad,","poem":1},{"text":"olli-maega an-imaksad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Gwage-bogidikid an-ibe obelosad,","poem":1},{"text":"weligwar-itoleged bar an ebinsasulid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"A-ulale, an soged: “An-gargangued bergusad,","poem":1},{"text":"Bab-Dummadgi an ibmar-edarbediid bar an dakosulid.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"An-wile-itodiid, an-neg-sate-gaamakdiid, be ebinsao.","poem":1},{"text":"Ar we-ibmarmar, naibid-dummad anga uked.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bane-bane an we-ibmargi binsadiid,","poem":1},{"text":"a-ulale, bar an ibmar imakbisuli itoged.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Degi-inigwele, an ibmar-soggwendi ebinsaed,","poem":1},{"text":"we, mer suli-suli-itogega an-imaked.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bab-Jehová-sabgued-dummad-nikad-ular, anmar bergussulid,","poem":1},{"text":"e-wile-emar-daked gege bergued.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bab-Jehová-e-wile-emar-daked bane-bane binoleged.","poem":1},{"text":"Bab-Jehová-sogedba-ibmar-imaked dummarba gued.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Degisoggu, an soged:","poem":1},{"text":"“Bab-Jehováʼbi anga unni gued,","poem":2},{"lineBreak":true},{"text":"agala, an egi bensulid.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Bab-Jehová, dule-egi-bensur-gudimaladgi nued daed,","poem":1},{"text":"bela dule-e-amidimaladgi nued daed.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bur-nuedid, anmar doga-doga-itosulidgi, Bab-Jehová-anmar-bendakdagoed edarbed.","poem":1}]},{"type":"verse","number":27,"content":[{"text":"Bur-nuedid, dule sapingwagwad-akale, bonigan-abalagi ganna-gudigued durdaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Melle ese be gole, itoba bogidik sigoed,","poem":1},{"text":"ar Bab-Jehová deyob ega igar mesisad.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Nue-bingegusa, wagar napase dulluu imakoed,","poem":1},{"text":"abakale, amba Bab-Dummad e-bendakalile.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Dule-e-ibe-wagar-bibyonaidga, baid-wagar oyobalo,","poem":1},{"text":"deyobi, nue bingeguoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Bab-Jehová anmar-obachad, degi-inigwele, deyob-anmar-imakmai sadeguosulid.","poem":1}]},{"type":"verse","number":32,"content":[{"text":"Nunmak-itoge anmar-imaked, degi-inigwele, anmar-wile dakbalid,","poem":2},{"lineBreak":true},{"text":"ar e-sabgued dummarba gued.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Bab-Jehová anmar-naibi imaked, anmar-wile-ito imaked,","poem":1},{"text":"ar deyob-anmar-imakedgi wergudeeye soglesulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Bab-Jehová weyob-ibmar-imaklemalad abemaisulid:","poem":1},{"text":"We-napneggi bela-dulemar-esgaryagi-mellebukwad sabsur-imakleged, abemaisulid.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Bab-Dummad-Bur-Birigined-asabin dulega-igar-nabolesulid, abemaisulid.","poem":1}]},{"type":"verse","number":36,"content":[{"text":"Bab-Dummad-Bur-Birigined-asabin dulega-innikigwadba-igar-itolesulid, abemaisulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"¿Doa Bab-Dummad-ega-igar-uksuli ibmar-soged nabir imakoe?","poem":1}]},{"type":"verse","number":38,"content":[{"text":"¿Ar Bab-Dummad-Bur-Birigined-igar-ukedbali ibmar-nuegan, degi, ibmar-isgana gusursi?","poem":2}]},{"type":"verse","number":39,"content":[{"text":"¿Ar ibiga dule na e-isgusadba sabsur-odurdaklealir","poem":1},{"text":"urwedii guoe?","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Anmar na anmar-daedgi nue-binsasii imakmala,","poem":1},{"text":"anmar Bab-Jehová-amimala, gannar ese dagmala.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Anmar, Bab-Dummad-nibneggi-maidse-golega argan onakwe.","poem":1},{"text":"Anmar, Bab-Dummad-nibneggi-maidga anmar-binsaed soge.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Anmar isgusad, anmar uayasuli nanadii gusad,","poem":1},{"text":"Bab-Jehová, be anmarga anmar-isgued elissulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Bab-Jehová, be nue-urwedbali be anmar-baleginned,","poem":1},{"text":"wile-be-anmar-daksuli,","poem":2},{"lineBreak":true},{"text":"be anmar-obeloged.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Anmar-bese-goled mer be itogegala, be mogir-imbaba dukusad.","poem":1}]},{"type":"verse","number":45,"content":[{"text":"Dulemar-yar-baid-baid-bukwamalad-abargine, ibmar-isganayob be anmar-barmeted.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"Bela-anmar-isdarmalad sunmakdemalale,","poem":1},{"text":"anmargi ichakwaa sunmakdedamalad.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Anmar, dobgued-dummad itosmalad.","poem":1},{"text":"Anmar, omukulesmalad.","poem":2},{"text":"Anmar, ibmar-sate gusmalad.","poem":1},{"text":"Anmar, nunmaked-dummad itosad.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"An-neggwebur-e-saila-gusiid-nue-ibitosadbali,","poem":1},{"text":"an-wagarba diwar-aryomaiyob ibyanis aryomaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"An-ibyanis gwen bogigusuli aryomaid,","poem":1},{"text":"dule-an-gwage-baisur-ito-imaked sated.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Bab-Jehová nibneggi-maid-akale, geb anmar-dakedse an gadi-gadi itononikoed.","poem":1}]},{"type":"verse","number":51,"content":[{"text":"An-neggweburgi-omegan-gudidiid sabsur-odurdaklenaid-ulale, bela-bela an-gwage an nunmak itoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"An ibmar-akar-imaksasuli an-isdarmalad binsa an-baleginnanaid,","poem":1},{"text":"nuuyobi an-gasmalad.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Dula napa-urba an-odosmalad,","poem":1},{"text":"an-iduar noed akwa-dummadgi edismalad.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Bela diiba an-nono-dogdegua,","poem":1},{"text":"an na belaye sogded.","poem":2}]},{"type":"line_break"},{"type":"verse","number":55,"content":[{"text":"Bab-Jehová, an dia-dummadgi gulluyaa mellesigua,","poem":1},{"text":"an bese gochagusad.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"An-bese-wilesagwa-gornaid be itosad,","poem":1},{"text":"an-ise-gollar-gornaid be itononikid.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"An bese gochad, be anse nonikid,","poem":1},{"text":"be anga sognonikid: “Mer be dobguye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":58,"content":[{"text":"Bab-Jehová, bee be anbali nagusad,","poem":1},{"text":"be an-bendaksad.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Bab-Jehová, nue-an-wiosmalad be daksad,","poem":1},{"text":"be anga innikigwadba igar nudake.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Buged-mai angi-imakbimalad be daksad,","poem":1},{"text":"an-oakalobimalad be daksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":61,"content":[{"text":"Bab-Jehová, dule-angi-urwe-nanaid be itosad,","poem":1},{"text":"an-oakalobimalad be daksad.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"Bab-Jehová, an-isdarmalad angi-sunmaknanai-osedoddaed be wisid,","poem":1},{"text":"angi-gwisgumalaga igar-aminanaid be wisid.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Bab-Jehová, be dake, na ibu imaknanadibe, angi dodonanadamalad,","poem":1},{"text":"e-namakedgi angi-dodoar namakmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":64,"content":[{"text":"Bab-Jehová, wemar na bela e-ibmar-isgana-imaksad-ulale,","poem":1},{"text":"be sabsur-odurdake.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Ibmar-aku-itogega be imake,","poem":1},{"text":"be ukabsasunna.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Bab-Jehová, be-sae-itogedbali be wemar baleginne,","poem":1},{"text":"we-napneggi be bela obeloge.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}