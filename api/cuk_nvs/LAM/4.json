{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"LAM","translationId":"cuk_nvs","name":"Lamentaciones","commonName":"Lamentaciones","title":"NAIBI-ITOLEGED-GARDA LAMENTACIONES","order":25,"numberOfChapters":5,"sha256":"0492aaa92e8ddff49499b97fff64edca51875bc19315f151bddc19e006330ece","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/cuk_nvs/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"heading","content":["Sión-neggwebur-sabsur-odurdaklesad"]},{"type":"verse","number":1,"content":[{"text":"¡Or gudure daklegusad!","poem":1},{"text":"¡Or-nued e-gaed bar nue dakarmaksulid!","poem":2},{"text":"Bab-Dummadse-goled-neggi ormar-bukwadi,","poem":1},{"text":"bela negmar-imbaba omileded.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Sión-dulemar bur bule epenne olo-nueganba e-bina soglegenad,","poem":1},{"text":"emidi, napsa-nogyob daklemalad,","poem":2},{"lineBreak":true},{"text":"dule-napsagi-arbaed e-ibmar-imakedyob dakleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Achu-sapurmarbela na e-mimmigan-onuegala ega mam uked.","poem":1},{"text":"Ar Jerusalén-omegandina, igi nuu-dummad-dukar-suidmar dule-negasulidganba na e-mimmigan-mete-naddamala,","poem":2},{"lineBreak":true},{"text":"deyobi, e-mimmigan metemalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Burwigana ukudmaad-itogedbali,","poem":1},{"text":"e-gwabinmar achaa gayagi nagusad.","poem":2},{"text":"Burwigana aisaar mas egisenad,","poem":1},{"text":"degi-inigwele, dule gwen ega uksulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dulemar iduar mas-nuegan gundidamalanad,","poem":1},{"text":"emidi, igarbali ukudba burgwemamaid.","poem":2},{"text":"Dulemar iduar mor-nuegan-gargerbamalad yodamalanad,","poem":1},{"text":"emidi, ibmar-isgana-abargine gudimalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Jerusalén-dulemar-e-isguedi, bur bule Sodoma-dulemar-e-isgusadba gued.","poem":1},{"text":"Sodoma-neggwebur yog-berguar gusad,","poem":2},{"lineBreak":true},{"text":"gwen dule bendaksasulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Jerusalén-e-dummagan, boobali bur sibudik daklenanaenad,","poem":1},{"text":"moli-nunisba bur sibudik daklenanaenad.","poem":2},{"text":"E-abagan akwa-bisgi-ginnigwadba bur bule gisii daklenanaenad,","poem":1},{"text":"akwa-nued-zafiroʼyob daklemalanad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Emidi, e-daklegedi negsichidba bur gudure daklemalad,","poem":1},{"text":"igarbali aku daklemalad.","poem":2},{"text":"E-uka, sapanyobi dinnaa dakleged.","poem":1},{"text":"E-uka-dinnagwadbali e-garmar buus-buus dakleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dulemar-es-suidgi-burgwismalad bur nuedid,","poem":1},{"text":"dulemar-ukudba-burgwismaladba.","poem":2},{"text":"Ar wemala, napaneg ega ibmar-gwag-osanmaksasulid-ulale,","poem":1},{"text":"binna-binna ukudba burgwemamai gusmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nangan-sabed-nikamalad, na dukin e-mimmigan-dunanai gusmalad.","poem":1},{"text":"Jerusalén-neggwebur-ibitonaigua, we-nangan na e-mimmigan masga imaksamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bab-Jehová bela-bela e-sae-itoged bar bargassulid,","poem":1},{"text":"bela-bela e-sabsur-urwed oyosad.","poem":2},{"text":"Sión-neggwebur ogumaksad,","poem":1},{"text":"bela Sión-neggwebur-e-neg-sailase-bakar, ogumaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Reymar-we-napneggi-negsemamaidi,","poem":1},{"text":"Jerusalén-e-isdarmalad, Jerusalén-e-yawagakgi dognonimaloye-soglesad, bengusmalad.","poem":2},{"text":"Dulemar-we-napneggi-gudidimaladi, Jerusalénʼgi-gwisgudidimalad,","poem":1},{"text":"Jerusalén-e-yawagakgi dognonimaloye-soglesad, bengusmarmogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Neg-gunonikidi, Bab-Dummad-gayaburba-barsogmalad-e-isgusad-ulale, deyob neg-gunonikid.","poem":1},{"text":"Dule-irwa-Bab-Dummadse-gormalad-e-isgusad-ulale, deyob neg-gunonikid.","poem":2},{"text":"Neggwebur-neg-imbaba dule-ibmar-oakalossurmalad-e-ablis-eosmalad-ulale,","poem":1},{"text":"deyob neg-gunonikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"We-dulemar ibyasuliyob igarba gudidimalad,","poem":1},{"text":"e-argan ablis-sunnabi gudidimalad.","poem":2},{"text":"Deyob-gudimaladbali,","poem":1},{"text":"dule-wargwensaale, e-morse-bakale, gwen e-ibe ebubisulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dulemar iseed ega sogmalad: “Dule-swilidiksurmalad, wegi be namala.","poem":1},{"text":"Be nomala, be nomala. Mer be anmarse achamala.”","poem":2},{"text":"Dulemar-Bab-Dummad-akudakmalad yar-baid-baid-bukwamaladi sogmalad:","poem":1},{"text":"“We-dulemar neg-sate gaamakdidimaladid, wakindimaladid.","poem":2},{"lineBreak":true},{"text":"Wegi geg bar gudii gumalad.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bab-Jehová uludedba wemar-obachad,","poem":1},{"text":"bar we-dulemargi binsassulid.","poem":2},{"text":"Dule-irwa-Bab-Dummadse-gormaladdeeye bar egi binsalesulid,","poem":1},{"text":"dule-selebagusmalad bar wile daksurmarbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Anmar binsarsunna bendakleged-edarbediidbali, geg nue atakgusad.","poem":1},{"text":"Aisaale, anmar, anmar-neg-matusulid-birgi dule-gwen-anmar-bendakmalosulidsik atakgwis damalanad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ar anmargi nakuledidii nanaed,","poem":1},{"text":"geg bar anmar galimbaba nanaed.","poem":2},{"text":"Anmar-bergued modanikid,","poem":1},{"text":"anmar-bergued-wachi bato nonikid,","poem":2},{"lineBreak":true},{"text":"anmar-ibagan bato belad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Anmar-balegindimalad, sulubagimarba bur bule nanamalad.","poem":1},{"text":"Yalaganba anmar-balegichamalad,","poem":2},{"lineBreak":true},{"text":"nega-dulesulidganba anmar-iduar dukuar bukus gusmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dule-Bab-Jehováʼse-nug-imaklesad,","poem":1},{"text":"a-dule-isganamar-e-sakigi galesmogad.","poem":2},{"text":"We-dule, anmar-bendakoedinad.","poem":1},{"text":"Ar anmar we-dulegi sogdimalanad:","poem":2},{"text":"“Dulemar-yar-baid-baidgi-bukmaladgi,","poem":1},{"text":"we-dule, anmar-bendakdii guoye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Edom-dulemar, Uz-yargi rey-bundoryob be gudimalad,","poem":1},{"text":"be yeer-itomala, be wergumala.","poem":2},{"text":"Ar bemar sabsur-odurdaklegedsemarmogad.","poem":1},{"text":"Be-ibmar-nikadi bela be-ibe surgunonikoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Sión-neggwebur-yeerdakleged, be-sabsur-odurdakleged bergunonisunnad.","poem":1},{"text":"Bab-Dummad aineba gales-selemai bar be-imakosulid.","poem":2},{"text":"Bedina, Edom-dulemar, Bab-Dummad, be-isgusadbali sabsur-be-odurdaknonikoed,","poem":1},{"text":"bela be-isgusad magar-daklege imaknonikoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}