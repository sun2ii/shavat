{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"LAM","translationId":"cuk_nvs","name":"Lamentaciones","commonName":"Lamentaciones","title":"NAIBI-ITOLEGED-GARDA LAMENTACIONES","order":25,"numberOfChapters":5,"sha256":"0492aaa92e8ddff49499b97fff64edca51875bc19315f151bddc19e006330ece","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/cuk_nvs/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"heading","content":["Dulemar-wilebukwad Bab-Dummadse-goled"]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼye, anmar-gusadi be ebinsae,","poem":1},{"text":"anmar-wiolenaid nue be dake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Anmarga-ibmar-uklegoye-soglesadi, dule-bamalad anmar-ibe susad.","poem":1},{"text":"Anmar-negmar, dule-anmar-yarginsurmalad anmar-ibe susad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Anmar bab-sated, anmar dule-sergan-satedga gunonikid.","poem":1},{"text":"Anmar-nangan suisuli gunonimalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Anmar dii-gobedi bennukergebed,","poem":1},{"text":"anmar sapanmar bakergebed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Anmar-balegindimaladi, bato anmar-bargadanikid.","poem":1},{"text":"Anmar nue-geggus gudidimalad, anmar obunnoged sated.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Anmar mas-gunned-amiegala, Egipto-dulemarse argan-oyonai gualid.","poem":1},{"text":"Anmar mas-gunned-amiegala, Asiria-dulemarse argan-oyonai gualid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Anmar-babgan isgusmaladba burgwismalad.","poem":1},{"text":"Anmardi, amar-isgusad-ulale, Bab-Dummadse sabsur-odurdaklesmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Emide, maiga-gudidimalad, anmar-dummadga gunonimalad.","poem":1},{"text":"Amargi anmar-onogega dule sated.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Anmar mas-amiegala,","poem":1},{"text":"nega-dulesulidganba burgwednaga gudii gusmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Anmar ukudmaad-itogedbali, uelledmalad.","poem":1},{"text":"Anmar-abagan diopi-diopisur itoleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Sión-neggweburgi omegangi nue-dodolesad,","poem":1},{"text":"Judá-neggweburmargi yagangi nue-dodolesbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Anmar-dummagan argangi-atinnar bannu-bannu nasiklesmalad,","poem":1},{"text":"anmar-dadormargi dadormardeeye gwen binsalessulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Anmar-sapingan ibmar-gwag-nagega imaksamalad.","poem":1},{"text":"Burwigana sapan-gwaad-seedbali ibitodii guarmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Neggwebur-yawagak-noedgi sapin-dummagan bar ambikusurmalad.","poem":1},{"text":"Sapingan bar namaksurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Anmar bar weligwar itosulid,","poem":1},{"text":"anmar-weligwaledgi-gwiled wile-itogedga binyenonikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Anmar ologurgin bar sisurgusad.","poem":1},{"text":"¡Anmar duledar-wiles! ¡Anmar isgusad!","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Anmar gargangued bergumaid,","poem":1},{"text":"a-ulale, anmar nolloo atakgusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ar Sión-yargi bar dule gudisulid,","poem":1},{"text":"Sión-yargine, unnila ibdurgan-sapurbarmaladbi gudinanaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Degi-inigwele, be Bab-Jehová, degisadegu negsemaid,","poem":1},{"text":"be reyga degisadegu maid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Bab-Dummad, ¿ibiga be anmar-iesdae?","poem":1},{"text":"¿Ibiga be undar anmar-iege?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Bab-Jehová, gannar anmar bese-dagega be anmar-imake,","poem":1},{"text":"geb gannar anmar bese dagoed.","poem":2},{"text":"Anmar iduar igi-gudigusa,","poem":1},{"text":"deyob be gannar anmar-imake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Innikigwadba be anmar-obachad,","poem":1},{"text":"bela-bela be anmar-isdar daksad.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}