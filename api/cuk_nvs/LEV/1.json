{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"LEV","translationId":"cuk_nvs","name":"Levítico","commonName":"Levítico","title":"LEVÍTICO-GARDA LEVÍTICO","order":3,"numberOfChapters":27,"sha256":"bda206ed610b7d708899cfc86c6e9aa0c8bf006ef53033d5fbff783526727ca0","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/LEV/1.json","lastChapterNumber":27,"lastChapterApiLink":"/api/cuk_nvs/LEV/27.json","totalNumberOfVerses":859},"chapter":{"number":1,"content":[{"type":"heading","content":["Bab-Dummadga-ibmar-ogumakar-ukleged-igar"]},{"type":"verse","number":1,"content":["Bab-Jehová dulemarbo-ambikued-neg-akar Moisésʼse gochad. Agi ega sunmaksad, ega sogsad:"]},{"type":"verse","number":2,"content":["“Israel-dulemarga be sunmake, ega be soge:",{"text":"‘Bemar Bab-Jehováʼga ibmar-ukleged ukega sedanimalale,","poem":1},{"text":"sunna moli-bebe-nikad-sedamalad, igi, sibad-wawaaddibe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ar dule-gwensak Bab-Jehováʼga moli-bebe-nikad ogumakar ukele,","poem":1},{"text":"we-moli-bebe-nikad machered guergebed, swilidik, gwen boni-nikasuli guergebed.","poem":2},{"text":"We-ibmar-uklenaid, Bab-Jehová-dulemarbo-ambikued-neg-e-yawagak-dogedgi uklegoed,","poem":1},{"text":"adi, Bab-Jehová nabir we-ibmar abingaegar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dule, moli-bebe-nikad-sapingwagwad-ogumakar-uklegoed-e-nonogi na e-argan mesoed.","poem":1},{"text":"Deyobi, dule-e-isgued-elilegegala, Bab-Jehová we-moli-bebe-nikad abingaoed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Geb degine, dule, Bab-Jehová-asabin we-moli-bebe-nikad-sapingwagwad-e-dukar egwannoed.","poem":1},{"text":"Geb Aarón-masmala-dule-irwa-Bab-Dummadse-gormalad, Bab-Jehováʼga we-moli-e-abe ukoed.","poem":2},{"lineBreak":true},{"text":"Geb sorbali, moli-abe ibmar-ogumakar-ukleged-aila-e-dikarmargi bomi-bomi imakoed.","poem":2},{"text":"We-ailade, Bab-Dummad-dulemarbo-ambikued-neg-yawagak-dogedgi siid.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"A-sorbali, moli-bebe-nikad-sapingwagwad-e-uka edaroed,","poem":1},{"text":"geb e-san goa-goa imakoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Aarón-masmala-dule-irwa-Bab-Dummadse-gormalad, ibmar-ogumakar-ukleged-aila-birgi sapanmar urboed,","poem":1},{"text":"geb soo ogamaloed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Geb Aarón-masmala-dule-irwa-Bab-Dummadse-gormalad, moli-e-san-goamakaled,","poem":1},{"text":"e-nono, degi, e-samurgi-gwallu-nanaid ibmar-ogumakar-ukleged-ailagi soo-gasiid-birgi urboed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dule-ibmar-uknaid, moli-e-samurmar, degi, e-malimar, diigi enukoed.","poem":1},{"text":"Geb dule-irwa-Bab-Dummadse-goled ibmar-ogumakar-ukleged-aila-birgi bela ogumakoed.","poem":2},{"text":"We, ibmar-ogumakar-uklegedid, Bab-Jehováʼga soogi-ogumakar ibmar-ukleged yeer-yapannedid.’ ”","poem":3}]},{"type":"verse","number":10,"content":["Bab-Jehová Moisésʼga sogdebalid: “Ar dule-gwensak anga sibad-wawaad, igi, sibaddibe ogumakar ukele, we-ibdurgan-machered swilidik, gwen boni-nikasuli guergebed."]},{"type":"verse","number":11,"content":[{"text":"We-dule, Bab-Jehová-asabin ibmar-ogumakar-ukleged-aila-dad-nakwed-argan-sapiledsik, sibad-wawaad-machered-e-dukar egwannoed.","poem":1},{"text":"Geb Aarón-masmala-dule-irwa-Bab-Dummadse-gormalad, sibad-wawaad-e-abe, ibmar-ogumakar-ukleged-aila-e-dikarmargi bomi-bomi imakoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Geb sorbali, we-dule, sibad-wawaad-e-san goa-goa imakoed.","poem":1},{"text":"Geb dule-irwa-Bab-Dummadse-gormalad, sibad-wawaad-e-san-goamakaled,","poem":2},{"lineBreak":true},{"text":"e-nono, degi, e-samurgi-gwallu-nanaid ibmar-ogumakar-ukleged-ailagi, soo-gasiid-birgi urboed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dule-ibmar-uknaid, sibad-wawaad-e-samurmar, degi, e-malimar, diigi enukoed.","poem":1},{"text":"Geb dule-irwa-Bab-Dummadse-goled ibmar-ogumakar-ukleged-aila-birgi bela ogumakoed.","poem":2},{"text":"We, ibmar-ogumakar-uklegedid, Bab-Jehováʼga soogi-ogumakar ibmar-ukleged yeer-yapannedid.”","poem":3}]},{"type":"verse","number":14,"content":["Bab-Jehová Moisésʼga sogdebalid: “Israel-dulemarga be sogo: ‘Dule-gwensak Bab-Dummadga nuumar-ogumakar-ukele, sunna sapur-nuu, igi, wagnuu-mimmidibe, Bab-Jehováʼga uked."]},{"type":"verse","number":15,"content":[{"text":"Dule-irwa-Bab-Dummadse-goled ibmar-ogumakar-ukleged-aila-birgi nuu mesoed,","poem":1},{"text":"geb agi e-ibe dukar ungoed.","poem":2},{"lineBreak":true},{"text":"Geb nuu-abe ibmar-ogumakar-ukleged-aila-dikarba eogoed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dule-irwa-Bab-Dummadse-goled, nuu-e-masgammu, degi, e-samurmar onioed.","poem":1},{"text":"Geb bia buru milege, ibmar-ogumakar-ukleged-aila-dikarba, dad-nakwedsik mioed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Agine, nuu-saban egaoed,","poem":1},{"text":"geb sakangi-gani negabar onaboed.","poem":2},{"lineBreak":true},{"text":"Geb degine, dule-irwa-Bab-Dummadse-goled, we-nuu, ibmar-ogumakar-ukleged-aila-birgi soo-gasiidgi ogumakoed.","poem":2},{"text":"We, ibmar-ogumakar-uklegedid, Bab-Jehováʼga soogi-ogumakar ibmar-ukleged yeer-yapannedid.’ ”","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/LEV/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/LEV/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/EXO/40.json","previousChapterAudioLinks":{},"numberOfVerses":17}