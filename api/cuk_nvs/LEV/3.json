{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"LEV","translationId":"cuk_nvs","name":"Levítico","commonName":"Levítico","title":"LEVÍTICO-GARDA LEVÍTICO","order":3,"numberOfChapters":27,"sha256":"bda206ed610b7d708899cfc86c6e9aa0c8bf006ef53033d5fbff783526727ca0","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/LEV/1.json","lastChapterNumber":27,"lastChapterApiLink":"/api/cuk_nvs/LEV/27.json","totalNumberOfVerses":859},"chapter":{"number":3,"content":[{"type":"heading","content":["Gwenatigwar-guega ibmar-ukleged"]},{"type":"verse","number":1,"content":["Bab-Jehová Moisésʼga sogdebalid: “Israel-dulemarga be soge: ‘Dule-gwensak gwenatigwar-guega anga moli-bebe-nikad ukele, we-moli machereddibe, omedibe, swilidik, gwen boni-nikasulid anga ukoed."]},{"type":"verse","number":2,"content":["We-dule, moli-bebe-nikad-ogumakar-uklegoed-e-nonogi na e-argan mesoed. Bab-Dummad-dulemarbo-ambikued-neg-yawagak-dogedgi we-moli-e-dukar egwannoed. Geb sorbali, Aarón-masmala-dule-irwa-Bab-Dummadse-gormalad, moli-e-abe ibmar-ogumakar-ukleged-aila-dikarmargi bomi-bomi imakoed."]},{"type":"verse","number":3,"content":["” ’Geb dule-gwenatigwar-guega Bab-Jehováʼga we-moli-ibmarmar soogi-ogumakar ukoed:",{"text":"Samurgi-gwallumar-nanaid,","poem":2},{"lineBreak":true},{"text":"bela samur-bukwad-e-dikarmargi-gwallumar-nanaid,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"e-mirwa-gwabogwad,","poem":2},{"lineBreak":true},{"text":"mirwa-birgi-gwallumar-nanaid,","poem":2},{"lineBreak":true},{"text":"e-dikarmargi-gwallumar-nanaid,","poem":2},{"lineBreak":true},{"text":"bina-dutugwadgi-gwallumar-nanaid.","poem":2},{"text":"We-bina-dutugwad mirwa-gwabogwadba-mesa onolegoed.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Geb degine, Aarón-masmala bela we-ibmarmala ibmar-ogumakar-ukleged-ailagi ogumakoed.","poem":1},{"text":"We-ibmarmar, soo-gasiid-birgi ibmar-ogumakar-ukleged-bukwadmala ogumaklegoed.","poem":2},{"text":"We, Bab-Jehováʼga soogi-ibmar-ukleged, Bab-Jehová yeer-yapanne itogedid.","poem":3}]},{"type":"verse","number":6,"content":["” ’Ar dule-gwenatigwar-guega Bab-Jehováʼga sibad-wawaad-ukele, we-sibad-wawaad machereddibe, omedibe, swilidik, gwen boni-nikasulid ukoed."]},{"type":"verse","number":7,"content":[{"text":"Ar sibad-wawaad-sapingwagwad ukele, Bab-Jehováʼga uknaidgi","poem":1}]},{"type":"verse","number":8,"content":[{"text":"dule-ibmar-uknaidi, sibad-wawaad-sapingwagwad-e-nonogi na e-argan mesoed.","poem":1},{"text":"Geb Bab-Dummad-dulemarbo-ambikued-neg-yawagak-asabin we-sibad-wawaad-e-dukar egwannoed.","poem":2},{"lineBreak":true},{"text":"Geb sorbali, Aarón-masmala ibmar-ogumakar-ukleged-aila-e-dikarmargi sibad-wawaad-e-abe bomi-bomi imakoed.","poem":2}]},{"type":"verse","number":9,"content":["” ’Dule-gwenatigwar-guega Bab-Jehováʼga we-sibad-wawaad-ibmarmar ogumakar ukoed:",{"text":"E-gwallu,","poem":2},{"lineBreak":true},{"text":"e-bunnusaila-nagase-sikaled,","poem":2},{"lineBreak":true},{"text":"samur-birgi-gwallumar-nanaid,","poem":2},{"lineBreak":true},{"text":"degi, bela samur-bukwad-e-dikarmargi-gwallumar-nanaid,","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"e-mirwa-gwabogwad,","poem":2},{"lineBreak":true},{"text":"degi, mirwa-birgi-gwallumar-nanaid,","poem":2},{"lineBreak":true},{"text":"e-dikarmargi-gwallumar-nanaid,","poem":2},{"lineBreak":true},{"text":"deginbali, bina-dutugwadgi-gwallumar-nanaid.","poem":2},{"text":"We-bina-dutugwad mirwa-gwabogwadba-mesa onolegoed.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Geb degine, dule-irwa-Bab-Dummadse-goled bela we-ibmarmar ibmar-ogumakar-ukleged-ailagi ogumakoed.","poem":1},{"text":"We-ibmar-ogumaklegedi, Bab-Jehováʼga masga gued.","poem":2}]},{"type":"verse","number":12,"content":["” ’Ar dule Bab-Jehováʼga sibad ukele, Bab-Jehováʼga we-sibad uknaidgine,"]},{"type":"verse","number":13,"content":["na e-argan sibad-e-nonogi mesoed.",{"text":"Geb Bab-Dummad-dulemarbo-ambikued-neg-asabin sibad-e-dukar egwannoed.","poem":1},{"text":"Sorbali, Aarón-masmala ibmar-ogumakar-ukleged-aila-e-dikarmargi sibad-e-abe bomi-bomi imakoed.","poem":2}]},{"type":"verse","number":14,"content":["” ’Dule-gwenatigwar-guega Bab-Jehováʼga we-sibad-ibmarmar soogi ogumakar ukoed:",{"text":"Samur-birgi-gwallumar-nanaid,","poem":2},{"lineBreak":true},{"text":"bela samur-bukwad-e-dikarmargi-gwallumar-nanaid,","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"e-mirwa-gwabogwad,","poem":2},{"lineBreak":true},{"text":"mirwa-birgi-gwallumar-nanaid,","poem":2},{"lineBreak":true},{"text":"e-dikarmargi-gwallumar-nanaid,","poem":2},{"lineBreak":true},{"text":"bina-dutugwadgi-gwallumar-nanaid.","poem":2},{"text":"We-bina-dutugwad mirwa-gwabogwadba-mesa onolegoed.","poem":3}]},{"type":"verse","number":16,"content":["” ’Geb degine, dule-irwa-Bab-Dummadse-goled bela we-ibmarmar ibmar-ogumakar-ukleged-ailagi ogumakoed. We-ibmar-ogumaklegedi, Bab-Jehováʼga masga gued, yeer-yapannedid. Bela we-gwallumala Bab-Jehováʼgadid."]},{"type":"verse","number":17,"content":["” ’Ar bia bemar ambikuoe, bemarga, degi, be-waganga, degisadegu weyob igar megoed: Bemar bipisaale, ibmar-e-gwallu, degi, ibmar-abe gunnosurmalad.’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/LEV/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/LEV/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/ap