{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"MAT","translationId":"cuk_nvs","name":"Mateo","commonName":"Mateo","title":"MATEO-GAYABURBA-NUED MATEO","order":40,"numberOfChapters":28,"sha256":"9997554f2c13dac73f0937e9be3705588357cde2ff3b66b92ea624a1565ef758","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/cuk_nvs/MAT/28.json","totalNumberOfVerses":1071},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Jesucristo e-dadgansiki ilekwaa-danikid-e-garda. Jesucristo, David-e-wagwad, degi, Abraham-e-wagwabalid."]},{"type":"verse","number":2,"content":[{"text":"Abraham-machidi, Isaacʼye nugad,","poem":2},{"lineBreak":true},{"text":"Isaac-machidi, Jacobʼye nugad,","poem":2},{"lineBreak":true},{"text":"Jacob-machidi, Judáʼye nugad,","poem":2},{"lineBreak":true},{"text":"degi, e-masmala-baigan.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Judá-machidi, Faresʼye nugad,","poem":2},{"lineBreak":true},{"text":"degi, e-machi-baiddi, Zaraʼye nugad.","poem":2},{"text":"We-machi-warbogwad-e-nandi, Tamarʼye nugad.","poem":3},{"text":"Fares-machidi, Esromʼye nugad,","poem":2},{"lineBreak":true},{"text":"Esrom-machidi, Aramʼye nugad.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aram-machidi, Aminadabʼye nugad,","poem":2},{"lineBreak":true},{"text":"Aminadab-machidi, Naasónʼye nugad,","poem":2},{"lineBreak":true},{"text":"Naasón-machidi, Salmónʼye nugad.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Salmónʼdi, Rahab-ebo Booz-baksad.","poem":2},{"lineBreak":true},{"text":"Boozʼdi, Rut-ebo Obed-baksad.","poem":2},{"lineBreak":true},{"text":"Obed-machidi, Isaíʼye nugad.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Isaí-machidi, Rey-Davidʼye nugad,","poem":2},{"lineBreak":true},{"text":"Rey-David-machidi, Salomónʼye nugad.","poem":2},{"text":"Salomón-e-nandi Urías-e-omega-gusadid.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Salomón-machidi, Roboamʼye nugad,","poem":2},{"lineBreak":true},{"text":"Roboam-machidi, Abíasʼye nugad,","poem":2},{"lineBreak":true},{"text":"Abías-machidi, Asaʼye nugad,","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asa-machidi, Josafatʼye nugad,","poem":2},{"lineBreak":true},{"text":"Josafat-machidi, Joramʼye nugad,","poem":2},{"lineBreak":true},{"text":"Joram-machidi, Uzíasʼye nugad,","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Uzías-machidi, Jotamʼye nugad,","poem":2},{"lineBreak":true},{"text":"Jotam-machidi, Acazʼye nugad,","poem":2},{"lineBreak":true},{"text":"Acaz-machidi, Ezequíasʼye nugad,","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ezequías-machidi, Manasésʼye nugad,","poem":2},{"lineBreak":true},{"text":"Manasés-machidi, Amónʼye nugad,","poem":2},{"lineBreak":true},{"text":"Amón-machidi, Josíasʼye nugad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Judíoʼmar Babiloniaʼse gales ebipilesmargu, Josías machimala-nikunonikid:","poem":3},{"text":"Jeconías, degi, e-masmala-baigan.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Judíoʼmar gales Babiloniaʼse ebipilesmalad-sorba,","poem":3},{"text":"Jeconías, Babiloniaʼgi e-machi-Salatiel-baknonikid.","poem":2},{"lineBreak":true},{"text":"Salatiel-machidi, Zorobabelʼye nugad.","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zorobabel-machidi, Abiudʼye nugad,","poem":2},{"lineBreak":true},{"text":"Abiud-machidi, Eliaquimʼye nugad,","poem":2},{"lineBreak":true},{"text":"Eliaquim-machidi, Azorʼye nugad.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Azor-machidi, Sadocʼye nugad,","poem":2},{"lineBreak":true},{"text":"Sadoc-machidi, Aquimʼye nugad,","poem":2},{"lineBreak":true},{"text":"Aquim-machidi, Eliudʼye nugad.","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Eliud-machidi, Eleazarʼye nugad,","poem":2},{"lineBreak":true},{"text":"Eleazar-machidi, Matánʼye nugad,","poem":2},{"lineBreak":true},{"text":"Matán-machidi, Jacobʼye nugad.","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Jacob-machidi Joséʼye nugad.","poem":2},{"lineBreak":true},{"text":"José, María-e-suiga gusadid, geb agi Jesús gwalulesad.","poem":2},{"text":"We-Jesús, Cristoʼye nugad.","poem":3}]},{"type":"verse","number":17,"content":["Degisoggu, Jesús-e-dadgan, Abraham-akar, Davidʼse, e-ambe-gakabake (14) gued. Degi, David-akar, Judíoʼmar gales Babiloniaʼse-ebipilesmaladse, Jesús-e-dadgan e-ambe-gakabakebalid (14). Degi, Judíoʼmar gales Babiloniaʼse ebipilesmalad-akar, Cristoʼse, Jesús-e-dadgan e-ambe-gakabakebalid (14)."]},{"type":"verse","number":18,"content":["Jesucristo weyob gwalulesad: María, Jesús-e-nan, deun José-ebo igar nabosmalad na nikumaloye. Nikued-idu, María daklealid, Bab-Dummad-Burba-Isligwaled-egi-ataksadba bato gurgin-nika gudii."]},{"type":"verse","number":19,"content":["María-e-sui-José, dule-gwage-nuedsoggu, yapa-María-obingegsaedba arbakee mete-sokalinad."]},{"type":"verse","number":20,"content":["Ar José degi-binsadii, gabgi Bab-Dummad-e-baliwitur ese nonikid, ega sognonikid: “David-wagwa-José, mer be dobgu. María be-omega-guega be abingae. Ar María-bonigwar be dakedi, Bab-Dummad-Burba-Isligwaled-sogedba deyob gusad."]},{"type":"verse","number":21,"content":["María, machi-wargwen nikuoed, Jesúsʼye be onugsaoed, ar ade, isguedgi e-neggwebur abonogoed.”"]},{"type":"verse","number":22,"content":["Weyob bela ibmar-gusadi, deyob gusad, adi, Bab-Dummad na e-gayaburba-barsogedba ibmar-sogsadba guegar, deun sogsagusgu:"]},{"type":"verse","number":23,"content":[{"text":"“Emi be dake, yagwa-wargwen gurgin-nika guoed, goe nikunonikoed.","poem":1},{"text":"Emanuelʼye onugsaoed.”","poem":2},"Isaías 7:14",{"text":"Emanuel sogleged, “Bab-Dummad anmarba gudiiye.”","poem":3}]},{"type":"verse","number":24,"content":["José gabdakmai ataksagu, ar igi Bab-Dummad-e-baliwitur ega sogsa, deyob imaksad. José, María-nikunonisunnad."]},{"type":"verse","number":25,"content":["Degi-inigwele, amba Maríaʼse gochasurgweled. José, María-machi-gebe-nikusad-sorba geb Maríaʼse gochad. Machigwa-gwalulesadi, Jesúsʼye onugsasad."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/MAL/4.json","previousChapterAudioLinks":{},"numberOfVerses":25}