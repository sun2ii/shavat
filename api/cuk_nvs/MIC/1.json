{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"MIC","translationId":"cuk_nvs","name":"Miqueas","commonName":"Miqueas","title":"MIQUEAS-GARDA MIQUEAS","order":33,"numberOfChapters":7,"sha256":"72259932c62f7170ed64f5a114d82870929f59690414d6a82654e225df89e669","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/cuk_nvs/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"heading","content":["Samariaʼga, degi, Jerusalénʼga naibi-itosad"]},{"type":"verse","number":1,"content":["Judá-dule-e-reymar Jotam, Acaz, degi, Ezequías, negsemamaid-ibagangine, Bab-Jehová dule-Moreset-neggweburgined-Miqueasʼye-nugadga sunmaksad. Miqueas, Samaria-yalagi-negguoed, degi, Jerusalén-yalagi-negguoed weyob negburgan daksad. Bab-Jehová-danikoed Miqueas, Bab-Jehová-ega-sogsadba weyob sogded:"]},{"type":"verse","number":2,"content":[{"text":"“Dulemar, bela we-yalagi-bukmalad be an-itomar,","poem":1},{"text":"bela napneggi-bukmalad, nue-bogimakar be itomalo.","poem":2},{"text":"Bab-Dummad-Jehová-Bela-Gangued-Nika-Maid, ese-goled-neg-akale, bemargi-gwisguega sunmakoed.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"¡Dakmala! Bab-Jehová, e-maidgi bato noalid, bato aidealid,","poem":2},{"lineBreak":true},{"text":"yar-mullugan-imbaba gannamakdanikid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"E-nanaedbali yarmar abin maludoed.","poem":1},{"text":"Ibmar-gwallu-soo-abin-daluddaedyobi yar gudoed,","poem":2},{"text":"igi diwar-noedbali, nebagan negabar-argaddae,","poem":1},{"text":"deyobi, nebagan argadoed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bela we-ibmarmar Jacob-wagan-Bab-Dummadgi-gwisgusadbali guoed.","poem":1},{"text":"Israel-dulemar-isgued-ular, deyob, guoed.","poem":2},{"text":"¿Ar bia Jacob-wagan Bab-Dummadgi gwisgusmala?","poem":1},{"text":"¿Ar Samaria-neggweburgi isgusmarsursi?","poem":2},{"text":"¿Ar Jerusalén-neggweburgi, Judá-dulemar e-bab-dummaganse-gorleged-neggi isgusmarsursi?","poem":1}]},{"type":"verse","number":6,"content":[{"text":"A-ulale, Bab-Jehová soged:","poem":2},{"text":"‘An Samaria-neggwebur akwamarbi dunnumaksii an imakoed.","poem":1},{"text":"E-akwamar nebaganba an mioed,","poem":2},{"text":"bela swanga an imakoed.","poem":1},{"text":"Unnila e-yala uvaʼmar-digega guoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bela e-bab-dummadyob-imaklemalad bibislegoed.","poem":1},{"text":"Bela bab-dummagan-neggi-gambasamaladga ibmar-uklesmalad, ogumaklegoed.","poem":2},{"text":"Bela we-ibmarmar-soblesmalad an obelogoed.","poem":1},{"text":"Ar ade, galagwensuli-nanamalad-manigi, we-ibmarmar-soblesadi, gannar amar-maniga an imakoed.’ ”","poem":2}]},{"type":"heading","content":["Miqueas, Israel-dulemar-ular, bukib-itosad"]},{"type":"verse","number":8,"content":["Miqueas sogded:",{"text":"“Agala, an booed,","poem":1},{"text":"bukib-binsaedba an binnasuli goloed,","poem":2},{"text":"nag-swili an gudii guoed,","poem":1},{"text":"uka-swili an gudii guoed.","poem":2},{"text":"Achu-boeyobi an gordii guoed.","poem":1},{"text":"Irmonyobi an akigindii guoed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ar ade, Samaria-e-naibigusadi, gege nudakleged.","poem":1},{"text":"E-naibigusadi, bela Judá-yalase warmaksad.","poem":2},{"lineBreak":true},{"text":"Bela Jerusalén-neggweburse an-dulemar-bukwadse nasgusad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Melle be bomalo,","poem":1},{"text":"melle Gat-neggweburgi be ibmar sogmalo.","poem":2},{"text":"Napayala nunmakedba, Bet-Le-Afra-neg-ukubgi be bindumakmar.","poem":1}]},{"type":"verse","number":11,"content":[{"text":"Safirʼginmalad, uka-swiri binged-abalagi be-yargi be nomar.","poem":2},{"text":"Zaanánʼginmaladdi, ainiega sikirmaksamalad.","poem":1},{"text":"Betesel-neggweburgi ogormakdemalad, bar bemar bendaklegosulid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Marotʼginmalad, ibmar-nued-gued abebukwad,","poem":1},{"text":"ar Bab-Jehováʼdi, Jerusalén-neggwebur-dogedse bonigan barmialid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”Laquis-dorgan, bemar ur-bila-onomaladgi moli be nasikmar.","poem":1},{"text":"Ar ade, be-neggwebur-Jerusalénʼgi isgued noalid,","poem":2},{"lineBreak":true},{"text":"bemargine, Israel-dulemar-e-isgued noalid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Degisoggu, Moreset-Gat-neggweburga degimaloye be sogmalo.","poem":1},{"text":"Aczib-neggwebur-e-negmar, Israel-dulemar-e-reymar-yardakega gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"”Maresa-dorgan, dule-wargwen be-ibe-yarsuega, an bemargi barmidoed.","poem":1},{"text":"Adulam-akwasaila-yaa-ollogwadyaba Israel-dule-bulegan dukunamaloed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Degisoggu, be-mimmigan-sabed-ulale, be bukib-binsae,","poem":1},{"text":"aku-siga be esie,","poem":2},{"text":"mula-nono-swirigwadyobi be-nono swiri be imake,","poem":1},{"text":"ar ade, be-mimmigan yogasaar-gales dikasuli begi seledmaloed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}