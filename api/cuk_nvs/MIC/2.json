{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"MIC","translationId":"cuk_nvs","name":"Miqueas","commonName":"Miqueas","title":"MIQUEAS-GARDA MIQUEAS","order":33,"numberOfChapters":7,"sha256":"72259932c62f7170ed64f5a114d82870929f59690414d6a82654e225df89e669","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/cuk_nvs/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":2,"content":[{"type":"heading","content":["Dule, dule-wileged-mesagwar-imakdiid, duledar-wiles"]},{"type":"verse","number":1,"content":[{"text":"Dule, igar-isgana-imakedgi-binsamalad, duledar-wilesmar.","poem":1},{"text":"Ar megidele, igar-isgana-imakedgi, binsamaidamalad.","poem":2},{"text":"Neg-oibosale, igar-isgana imakdedamalad,","poem":1},{"text":"ar ade, e-ibmar-imakbiedba imakdamalad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"We-dulemar, emar-nainubina sokalile, e-ibe susdamalad, egadga imakdedamalad.","poem":1},{"text":"Emar-ibe negmar susdamalad, egadga imakdedamalad.","poem":2},{"text":"E-neg-ibed-mesagwar imakdedamalad,","poem":1},{"text":"degi, e-neg-ibed-mimmigan-mesagwar imakdedamarbalid.","poem":2},{"text":"E-nainu-ibed-mesagwar imakdedamalad,","poem":1},{"text":"degi, e-nainu e-ibe susdamarbalid.","poem":2}]},{"type":"verse","number":3,"content":["Degisoggu, Bab-Jehová weyob soged:",{"text":"“Emigine, ani, an we-dulemar-isganagi bonigan barmidamogoed,","poem":1},{"text":"we-bonigangi gwen wakinnosurmalad.","poem":2},{"text":"Bar san-dummarbaa na itogosurmalad,","poem":1},{"text":"ar ade, e-sabsur-odurdakleged-wachimar omosad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"A-ibagan-omosale, dule-bamalad egi dododmaloed,","poem":1},{"text":"ega we-naibi-itoleged-namakleged weyob egi dodoar namakmaloed:","poem":2},{"text":"‘Anmar bela bergusmala.","poem":1},{"text":"An-dulamar-ibe nainumar miminanaid,","poem":2},{"text":"ibiyobi anmar-ibe nainumar sunanai.","poem":1},{"text":"Dule-isganamar, anmar-nainumar miminanaid.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"A-ulale, Bab-Jehová-sordagan-onmakbukwad-abargi,","poem":1},{"text":"we-dulemarga napa-mimilegedgi ega napa uklegosulid.","poem":2}]},{"type":"heading","content":["Bab-Dummad-gayaburba-barsoged-napiragwadsurmalad"]},{"type":"verse","number":6,"content":["We-gayaburba-barsoged-napiragwadsurmalad anga soged:",{"text":"“Mer bar be anmarga ee-gordii samala.","poem":1},{"text":"Mer be anmarga soge, be wilemaloye.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Jacob-wagan weyob sogmalad:","poem":1},{"lineBreak":true},{"text":"“¿Bab-Jehová e-san-bargaagwar-imaked bergussi? E-daedde, ¿weyobsi?","poem":1},{"text":"¿Ar dule-inniki-nanadiidga Bab-Dummad-gayaburba ibnuedga gusursi?”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová soged: “Ar bemar an-dulamarga gumalanad,","poem":1},{"text":"degi-inigwele, emi-ibagi be an-isdarmaladga gudmalad.","poem":2},{"text":"Dulemar-igarba-baisurbinsa-nadapdamalad-ibe sordamar-be-isdarmaladyobi, e-ibe be mor-nuegan atursasdamalad.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"An-dulamar-omegan e-neg-nuegangi be ononnosmalad.","poem":2},{"lineBreak":true},{"text":"A-omegan-e-mimmigan-ibe, be e-wergued osulosmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”¡Ogusmar! ¡Be namar!","poem":1},{"text":"We-nega, obunnoged-negsulid.","poem":2},{"text":"Bela nue-isgus naid,","poem":1},{"text":"bela oitoles siid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar dule-gwensak yogasaar-gakansaedgi","poem":1},{"lineBreak":true},{"text":"weyob sognonikile:","poem":1},{"text":"‘An bemarga-sunmakega, vino be anga udamaloye,","poem":2},{"lineBreak":true},{"text":"sisa be anga udamaloye.’","poem":2},{"text":"We-neggwebur Bab-Dummad-gayaburba-barsogedyobi, we-dule-dakdoed.”","poem":1}]},{"type":"heading","content":["Gales-bukwadgi onolemaloye soglesad"]},{"type":"verse","number":12,"content":["Bab-Jehová sogdebalid:",{"text":"“Jacob-wagan, an bemarga nue-napira-soged,","poem":1},{"text":"bela be-dulemar gannar nuekwa an urboed.","poem":2},{"text":"Israel-wagan, an bemarga nue-napira-soged,","poem":1},{"text":"bemar-napi-besmaladi, an gannar danar urboed.","poem":2},{"text":"Igi sibad-wawaad galu-yaba danale-bukwadae,","poem":1},{"text":"deyobi, an bemar-urboed.","poem":2},{"text":"Degi, igi sibad-wawaad gagan-araramaladgi bukwadae,","poem":1},{"text":"deyobi, an bemar-urboed,","poem":2},{"lineBreak":true},{"text":"degine, binnasuli dule-bukidarayob oimakdemaloed.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ega igar-mayedi, emar-idumai guoed,","poem":1},{"text":"deginbali, emarmoga, igar-egamai gumarmogoed.","poem":2},{"text":"Amar, igar-bulegangi ollorgumaloed, degi, namaloed.","poem":1},{"text":"E-reydi, amar-idumai guoed.","poem":2},{"lineBreak":true},{"text":"Bab-Jehová, na e-sunnagwadi emar-idumai guoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/MIC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/MIC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/MIC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}