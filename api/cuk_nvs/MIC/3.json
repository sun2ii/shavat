{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"MIC","translationId":"cuk_nvs","name":"Miqueas","commonName":"Miqueas","title":"MIQUEAS-GARDA MIQUEAS","order":33,"numberOfChapters":7,"sha256":"72259932c62f7170ed64f5a114d82870929f59690414d6a82654e225df89e669","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/cuk_nvs/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"heading","content":["Dule-negsemamaid-isganamar sabsur-odurdaklegoed"]},{"type":"verse","number":1,"content":["Geb degine, an sogded:",{"text":"“Jacob-dulemar-negsemamaid, Israel-dulemar-e-dummagan, nue be an-itomar:","poem":1},{"text":"Bemar bur igar-innikigwad-imaked-durdaked ¿nabirsursi?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ar bemar igar-nued bur isdar dakmalad,","poem":1},{"text":"igar-isgana aka be yeer dakmalad.","poem":2},{"text":"An-dulamar be wiodimalad,","poem":1},{"text":"mesagwar be imakdimalad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bemar ibgwensur an-dulamar imakdimalad.","poem":1},{"text":"E-ukamar e-ibe be edared.","poem":2},{"lineBreak":true},{"text":"E-garmar bis-bis e-ibe be imaked.","poem":2},{"text":"Igi san-olomakar esmed-yagi onakledae, deyobi, an-dulamar be wiodimalad.","poem":1},{"text":"San-narilegedyobi, an-dulamar be imakdimalad.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bemar ibagwengi Bab-Jehováʼse gotemaloed,","poem":1},{"text":"edina, bemar-abin imakosulid.","poem":2},{"text":"Ar bemar dogdar isgusgudiidba,","poem":1},{"text":"a-ibagangine, bemar-idu banguoed.","poem":2}]},{"type":"heading","content":["Bab-Dummad-gayaburba-barsogmalad"]},{"type":"verse","number":5,"content":["Bab-Jehová weyob bemar-annik soged:",{"text":"“Bemar Bab-gayaburba-barsogmalad,","poem":1},{"text":"dulemar-yamodimalad, igar-noaledba an-dulamar-sedimalad:","poem":2},{"text":"Unnila dule-bega-masgunned-ukmaladgarbi, igar-bogidikidgi be sunmakdamalad,","poem":1},{"text":"ar dule-bega-masgunned-uksurmaladgardi, bila-onoged be obariddamalad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Degisoggu, an bar bemarga an-ibmar-sabiedi sogosulid.","poem":1},{"text":"Bipisaale bar an bemarga an-gayaburba sogosulid.","poem":2},{"text":"Bar anga-gayaburba-barsogmalad bemarga yoedse-ibmar-guoedgi sunmakosurmalad.","poem":1},{"lineBreak":true},{"text":"”An-gayaburba-barsogmalad bar sunmaksuli guoed","poem":1},{"text":"e-ibagan bergudoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"An-gayaburba-barsogmaladi, bingedar itodmaloed.","poem":1},{"text":"Nergan aku neg-dake gudmaloed.","poem":2},{"text":"Ar bela wemar bar-ibmar sogosurmalad,","poem":1},{"text":"ar ade, an gwen ega ibmar sogosulid.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Andi, Miqueas, Bab-Jehová-Burba nue-nika gudiid.","poem":1},{"text":"Igar-napiragwadi, degi, garganguedi, an nue-nika gudiid.","poem":2},{"text":"Adi, Jacob-dulemar ibmar-isgana-imakmaladgi an sunmakegar,","poem":1},{"text":"degi, Israel-dulemar-isgudiidgi an sunmakegar.","poem":2}]},{"type":"heading","content":["Jerusalén-neggwebur oitolesad"]},{"type":"verse","number":9,"content":[{"text":"Jacob-dulemar-negsemamaid, Israel-dulemar-e-dummagan, be nue an-itomalo.","poem":1},{"text":"Bemar igar-innikimalad bur be obandimalad.","poem":2},{"lineBreak":true},{"text":"Bipisaale, bemar igar-maidgi binsaed-nika dasurmalad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ablis-eogedgi Sión-neggwebur be sobsamalad","poem":1},{"text":"igar-isgana-imaklegedba be Jerusalén-neggwebur sebukmalad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Be-dummagan-negsemaladi, dule-baiganse-manigi-baklegar igar nabomalad.","poem":1},{"text":"Be-dule-irwa-Bab-Jehováʼse-gormaladi, manigi-bennuklegar dule-odurdakmalad,","poem":2},{"text":"degi, be-Bab-Jehová-gayaburba-barsogmaladi, manigi-bennuklegar dulega sunmakmalad,","poem":1},{"text":"aka bur Bab-Jehováʼga weyob sogdedamalad:","poem":2},{"text":"“¿Ar Bab-Jehováʼde anmarba gudisursi?","poem":1},{"text":"Degisoggu, anmar akar-guosulid.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"A-ulale, bemar-nukine Sión-neggwebur nainu-imuar-naidaedyob guoed.","poem":1},{"text":"Jerusalén-neggwebur akwamarbi ganna-ganna-bubukwa guoed.","poem":2},{"lineBreak":true},{"text":"Bab-Jehováʼse-goled-neg-e-yala, gannar sapurbi moodo naguoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}