{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"MIC","translationId":"cuk_nvs","name":"Miqueas","commonName":"Miqueas","title":"MIQUEAS-GARDA MIQUEAS","order":33,"numberOfChapters":7,"sha256":"72259932c62f7170ed64f5a114d82870929f59690414d6a82654e225df89e669","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/cuk_nvs/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["Sión-yala nug-dummarbaa guoed"]},{"type":"verse","number":1,"content":[{"text":"Ibagan-bergued-mosale, Bab-Jehováʼse-goled-neg-yala bur yala-biriginedga guoed,","poem":1},{"text":"yala-mulluganba bur nuga-nika guoed.","poem":2},{"text":"Dulemar-yar-baid-baidgi-bukmalad bela ase nonimaloed.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Dule-yar-baid-baidgi-bukmalad-bukidar-nonikoedi, sognonimaloed:","poem":2},{"text":"“Dagmar, anmar Bab-Jehová-yalase nakwenamar,","poem":1},{"text":"Jacob-e-Bab-Dummadse-goled-negse anmar namar.","poem":2},{"text":"Bab-Dummad, e-sunnad, e-igar-maidba anmar-odurdakoed,","poem":1},{"text":"degi, anmar e-igarba nanadii gumaloed.”","poem":2},{"text":"Ar ade, Sión-yalagi Bab-Dummad-Igar-Maid-odurdakleged danikid,","poem":1},{"text":"Jerusalén-neggweburgi Bab-Jehová-gayaburba ainidagoed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Dummad, dulemar-yar-baid-baid-abargi dulemarga igar-nabogoed,","poem":1},{"text":"neggwebur-gandikmalad-bukibga, degi, dikasurmaladga igar-nabogega guoed.","poem":2},{"text":"E-es-suidmar napa-imuedga gudoed,","poem":1},{"text":"e-ila-swiswidikmalad es-dopegwadga gudoed.","poem":2},{"text":"Dule-yar-baid-baidginmalad, bar abin-abin urwosurmalad.","poem":1},{"text":"Bila-onogega, bar guagwar-gudii guosurmalad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bela dulemar bogidik e-uva-dubmar-urba-bukwa gumaloed,","poem":1},{"text":"degi, bogidik e-higuera-sapi-urba-bukwa gumaloed,","poem":2},{"text":"dule-bamaladi, gwen amar-ogwayosulid,","poem":1},{"text":"ar ade, deyobi, Bab-Jehová-Bela-Gangued-Nikad sogsad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ar bela dulemar e-bab-dummagan-nug ogannomalale, akarsulid,","poem":1},{"text":"ar anmardi, anmar-Bab-Dummad-Jehová-Bela-Gangued-Nikad-e-nugbi odummodii guoed.","poem":2}]},{"type":"heading","content":["Bab-Jehová, Israel-dulemar-gales-selesmalad onogoed"]},{"type":"verse","number":6,"content":["Bab-Jehová weyob sogded:",{"text":"“A-ibagangine, dulemar-nailikguarmalad nuekwa an urboed.","poem":1},{"text":"Dulemar-yar-baid-baidse-mimilesmalad bulakwaa an oambikuoed,","poem":2},{"lineBreak":true},{"text":"degi, sabsur-imakledimalad nuekwa an oambikuoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dulemar-nailikguarmalad napi besmaloed.","poem":1},{"text":"Amarde, neggweburga an imakoed.","poem":2},{"text":"Dulemar-yar-baid-baidse-mimilesmaladgi,","poem":1},{"text":"dulamar-bela-bela-gangued-nikadga an imakoed.","poem":2},{"text":"Ani Bab-Jehová ega Sión-yalagi yar-seoed,","poem":1},{"text":"degisadegu yar-semai guoed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sión-yala, Jerusalén-neggweburgi be siid,","poem":1},{"text":"neg-matusulid-nakulegedga be gunonikid.","poem":2},{"text":"Be epennegwadyobi, gannar gangued-nika be guoed,","poem":1},{"text":"Jerusalén, epenne be negsesadyobi, gannar be negseoed.”","poem":2}]},{"type":"heading","content":["Sión-yala sabsur-wilegoed, geb weligwar-itobaloed"]},{"type":"verse","number":9,"content":[{"text":"Emide, Jerusalén, ¿ibiga be binnasuli gole?","poem":1},{"text":"¿Ar be, rey satesi?","poem":2},{"text":"¿Ibiga begi naibid-dummad noniki?","poem":1},{"text":"¿Ar bega-binsaed-uked burgwissi?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sión-dulemar, ome-ugakgunaidaedyob, be binnasuli gole,","poem":1},{"text":"be binnasuli akiginne.","poem":2},{"text":"Ar be-neggweburgi be nooed,","poem":1},{"text":"magabali gaamakdii be guoed.","poem":2},{"text":"Babilonia-yalase be naoed.","poem":1},{"text":"Geb agine, be ollorgunonikoed,","poem":2},{"lineBreak":true},{"text":"Bab-Jehová be-isdarmaladgine be-onogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Emigindi, dulemar-yar-baid-baidgi-bukwad-bukidar begi-gwisguega atosmalad.","poem":1},{"text":"Weyob sogmalad:","poem":2},{"text":"“Sión-yala-ibe anmar ibmar sunae.","poem":1},{"text":"¡Bitigi, Sión-yala galakusa an daksamalana yeerbanye!”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Degi-inigwele, we-dulemar Bab-Jehová-e-binsanaidi, degi, e-ibmar-imakbiedi wissurmalad.","poem":1},{"text":"Ar wemar wissurmalad, Bab-Jehová oros-dugmaklegedyobi e-saboleged-neggi e-urbemaloed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bab-Jehová sogdebalid: “Sión-dulemar, ¡ogusmar!","poem":1},{"text":"Oros-omukueyob be dulemar imaknamar.","poem":2},{"text":"Ar ani an moli-bebe-esgorogi-sobaledyobi gargangued an bega ukoed.","poem":1},{"text":"Moli-e-nag-goonasi-esgoro-gordikidgi-sobaledyobi, an bega gargangued ukbaloed.","poem":2},{"text":"Adi, bukidar neggwebur-bamalad napabi-nai be imakegar,","poem":1},{"text":"degi, bela e-ibmar-nuegan be ei subaligar.","poem":2},{"text":"Geb agine, a-ibmarmar anga be ukoed.","poem":1},{"text":"Ani an Bab-Jehová Napneg-E-Dummadga gued.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}