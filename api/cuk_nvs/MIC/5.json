{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"MIC","translationId":"cuk_nvs","name":"Miqueas","commonName":"Miqueas","title":"MIQUEAS-GARDA MIQUEAS","order":33,"numberOfChapters":7,"sha256":"72259932c62f7170ed64f5a114d82870929f59690414d6a82654e225df89e669","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/cuk_nvs/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"heading","content":["Dule-emar-onoged negseoed"]},{"type":"verse","number":1,"content":[{"text":"Jerusalén-dorgan, be-sorda-bila-onomalad guagwar be urbemar.","poem":1},{"text":"Ar ade, anmar-isdarmalad bela anmar-ebiris bukmalad.","poem":2},{"text":"Israel-dulemar-e-dummad-negsemaidi, sabsur-wiolegoed.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová sogdebalid:","poem":2},{"text":"“Belén-Efrata, ar bedi Judá-yargi-neggweburmar-bukwadba bur bipigwadid.","poem":1},{"text":"Begine, dule-Israel-yala-seoed nodagoed.","poem":2},{"lineBreak":true},{"text":"We-dulede, amba yoo-napaneg-nague bato gudibinned.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"A-ulale, Bab-Dummad, omegwa-goe-baknonikoedse be-isdarmaladga be-urmakmaloed.","poem":1},{"text":"Geb degine, Israel-dulemar-yar-baid-baidgi-napi-besmaladi, Israel-dulemar-baiganbo bular bukunonikoed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Geb a-dule Bab-Jehová-e-ganguedba,","poem":1},{"text":"e-Bab-Dummad-Jehová-e-nug-gandikidba, e-dulemar-idugoed.","poem":2},{"text":"Dulemar, dobedsuli gudii gumaloed,","poem":1},{"text":"ar ade, a-dule bela napaneg-naid seoed.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ar a-dule neg-bogidikid senonikoed.","poem":2},{"text":"Ar Asiria-dulemar anmar-yar-subiguarmalale, anmar-neg-gandikmalad-bibisbiguarmalale, a-dule, anmar-bendaknonikoed.","poem":1},{"text":"E-abin e-gugle (7) dummagan barmidoed,","poem":2},{"lineBreak":true},{"text":"degi, e-baabak (8) neggwebur-sapin-dummagan barmidabaloed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wemala, gandikidba dadsaila-Nimrod-yala Asiriaʼye-nugad semai gumaloed,","poem":1},{"text":"Asiria-dulemar anmar-yar subiguarmalale, degi, anmar-yar-abingunanaidgi dogbiguarmalale, a-dule, anmar-bendakoed.","poem":2}]},{"type":"heading","content":["Israel-dulemar-napi-besmalad"]},{"type":"verse","number":7,"content":[{"text":"Igi Bab-Jehová wakudaryala boo-bomiardae,","poem":1},{"lineBreak":true},{"text":"degi, igi gagangi dii-owiardabali,","poem":1},{"text":"debayobi, Jacob-wagan-napi-besmaladi, neggwebur-bamalad-abargine gudii gumaloed.","poem":2},{"text":"Gaganmar gwen dule-eoged abdakdasulid","poem":1},{"text":"deyobi, gumaloed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Igi achumigur-nono-wawaad, ibdurgan-sapurbarmalad-imbagi gudidae,","poem":1},{"text":"debayobi, Jacob-wagan-napi-besmaladi gumaloed.","poem":2},{"text":"Igi achumigur-senigwad sibad-wawaad-bukwadgi-gudiidgi,","poem":1},{"text":"sibad-wawaad-gasadae,","poem":2},{"text":"gwen-odulodasuli,","poem":1},{"text":"debayobi, Jacob-wagan neggwebur-bamalad-imbagine gudigumaloed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Jehová, bee be, be-isdarmaladgi gwichiguoed,","poem":1},{"text":"bela be-isdarmalad be obelogoed.","poem":2}]},{"type":"heading","content":["Bab-dummaganga-imaklemalad berguoed"]},{"type":"verse","number":10,"content":["Bab-Jehová weyob Israel-dulemarga sogded:",{"text":"“A-ibagangine, an be-molimar ogilogoed,","poem":1},{"text":"degi, be-moli-ur-bila-onomalad an obelogoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"An bela be-neggweburmar obelogoed,","poem":1},{"text":"degi, be-neg-gandikmalad bela an obelogoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bela dulemar ina-isgana-imakmalad an obelogoed,","poem":1},{"text":"degi, bar be nergan-nika guosurmalad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"An bela be-bab-dummadyob-imaklemalad obelogoed,","poem":1},{"text":"degi, akwa-dummagan-islidikmalad an bela obelobaloed.","poem":2},{"text":"Bipisaale, be-ibmar-sobsamalad-asabin bar sindigar be sigosurmalad.","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Be-bab-bundor-Asera-e-wilub-gwismalad an bemar-ibe ungoed,","poem":2},{"text":"degi, bela be-neggweburmar an obelogoed.","poem":1}]},{"type":"verse","number":15,"content":[{"text":"Dule-yar-baid-baidgi-bukmalad an-sogedba-dasurmalad ise-urwedgi, degi, sae-itogedgine, an buged imakoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}