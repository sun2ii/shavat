{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"MIC","translationId":"cuk_nvs","name":"Miqueas","commonName":"Miqueas","title":"MIQUEAS-GARDA MIQUEAS","order":33,"numberOfChapters":7,"sha256":"72259932c62f7170ed64f5a114d82870929f59690414d6a82654e225df89e669","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/cuk_nvs/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":6,"content":[{"type":"heading","content":["Bab-Dummad Israel-dulemarse ulusad"]},{"type":"verse","number":1,"content":["Israel-dulemar, Bab-Jehová-ibmar-sogedi be nue itomar:",{"text":"“Be gwichigumar. Be boni-nikagudiid yarmar-asabin be sognamar.","poem":1},{"text":"Yar-mullugana be-itogega be imakmar.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yalamar, Bab-Jehová-urwed be itomar,","poem":1},{"text":"napa-e-saila-gandikmalad, nue be bogimakar itomar,","poem":2},{"text":"Bab-Jehová, e-dulemarga igar itosokalid,","poem":1},{"text":"Israel-dulemargi gwisgusokalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová sogded: “An-dulamar, ¿igi an bemar-imaksa?","poem":1},{"text":"Be anga-sogmala, ¿ibigi an begi nosa?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ar ani an Egipto-yalagi bemar-onosadid,","poem":1},{"text":"maigagudiid-yalagi an bemar-ollor-imaksadid.","poem":2},{"text":"Ani an bemarga Moisés, Aarón, María, barmisgusadid,","poem":1},{"text":"adi, amar bemar-idumalagar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"An-dulamar, be-ebinsamala,","poem":1},{"text":"Moab-dulemar-e-rey-Balac bemar-wiogega bemar-idu igar amisgusanad.","poem":2},{"text":"Beor-machi-Balaam, igi Balac-abin sogsagusa,","poem":1},{"text":"a be nue-ebinsamala.","poem":2},{"text":"Deginbali, Sitimʼye-neg-nugad-akale, Gilgal-neg-nugadse-be-nonigusmaladi, be ebinsabali.","poem":1},{"text":"Magar be an-dakmala,","poem":2},{"lineBreak":true},{"text":"ani an, Bab-Jehová bemar-onosadid.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Emide be sogmalad:","poem":1},{"lineBreak":true},{"text":"“Anmarde, ¿igi Bab-Jehová-walikaa gumalosunna?","poem":1},{"text":"¿Igi anmar Bab-Dummad-Bur-Birigined-asabin sindigar sigmalosunna?","poem":2},{"text":"¿Moli-bebe-nikad-birgagwenad-ogumakar-ukleged, an ega ukega sedoe?","poem":1}]},{"type":"verse","number":7,"content":[{"text":"An sibad-wawaad-machered miliba (1000) Bab-Jehováʼga uker, Bab-Jehová ¿yeer itogoe?","poem":2},{"text":"Olivo-gwallu bute-miliambe (10,000) an ega uker, ¿yeer itogoe?","poem":1},{"text":"An ibmar-isgana-imaksad-ular, ¿an-machi-sailagined an ukoe?","poem":2},{"lineBreak":true},{"text":"An-machi-sunnad, ¿an-isgued-ular, an ukoe?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ar Bab-Jehová bato bega sogsad ibu ibmar-nuedi.","poem":1},{"text":"Bab-Jehová be-daed-abemaidi, bato bega sogsad:","poem":2},{"text":"Igar-napiragwad-imaked be-abemaid,","poem":1},{"text":"dule-wiledaked be-abemaid,","poem":2},{"lineBreak":true},{"text":"e-asabin gwage-eikwadaed be-abemaid.","poem":2}]},{"type":"heading","content":["Jerusalén-dulemar sabsur-odurdaklegoed"]},{"type":"verse","number":9,"content":[{"text":"Jerusalén-dulemar, Bab-Jehová-ibmar-soged nue be itomar:","poem":1},{"text":"Dule Bab-Dummad-dobee-nanadiile,","poem":2},{"lineBreak":true},{"text":"a-dule, dule-binsaed-ibedid.","poem":2},{"text":"Sabsur-odurdaklenaid nue be itomala.","poem":1},{"text":"Bega dule-odurdakleged-barmialidi, nue be itomala.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“¡Dule-isganamar! Ande be-ibmar-nuegan ibmar-isgana-imakedba-amisad, ¿baisurdakode?","poem":1},{"text":"Degi, ande be ibmar-wilubsamalad-isgana, ¿baisurdakode? ¡Adi surbali!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar ande, dule ibmar-wilubsaed-nuegansulid-ebudiid ¿igi yeer dakosunna?","poem":1},{"text":"Degi, ibmar-wilubdaked-ebudiid, ¿an igi yeer dakosunna? ¡Geg an yeer daked!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dule-mani-ibegan, sabsur dule-imakedid.","poem":1},{"text":"Bela neggweburginmalad, gakansilimalad.","poem":2},{"lineBreak":true},{"text":"Na e-ibmar-sogedi bela gakansaedbiid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Emisgine, ani an sabsur-be-imakmaloed,","poem":1},{"text":"bemar-isgued-ular, an bemar-obelogoed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Na be mas-gunmalo-inigwele, gwen be immelegosurmalad,","poem":1},{"text":"amba ukudmaada be gudii gumaloed.","poem":2},{"text":"Be ibmar-gwag weemaloe-inigwele, be-ibe berguoed.","poem":1},{"text":"Ar be ibmar-soggwensaar-gaoedi, ani an bila-onolegedgi be-ibe obelogoed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Be ibmar-digmaloedi, gwen be weosurmalad,","poem":1},{"text":"degi, be olivo-gwallu-egurmaloedi, gwen be ebugosurmalad.","poem":2},{"lineBreak":true},{"text":"Vino-onogega uva-nis-egurusadi, be gobosurmarbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"”Rey-Omri-igar-mesisadba be nanadimalad,","poem":1},{"text":"bela Rey-Acab-e-wagan-ibmar-isgana-imaksadba be ibmar-imakdimalad.","poem":2},{"text":"Amar-ibmar-imaksadyobi be nanadiid.","poem":1},{"text":"A-ulale, an bemar-obeloged imakoed.","poem":2},{"text":"Be-dulemar bingedar-itogega an saoed.","poem":1},{"text":"Dulemar-begi-dodoedi, an imakoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/MIC/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/MIC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/MIC/5.json","previousChapterAudioLinks":{},"numberOfVerses":16}