{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"MIC","translationId":"cuk_nvs","name":"Miqueas","commonName":"Miqueas","title":"MIQUEAS-GARDA MIQUEAS","order":33,"numberOfChapters":7,"sha256":"72259932c62f7170ed64f5a114d82870929f59690414d6a82654e225df89e669","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/cuk_nvs/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["Miqueas, dulemar-isgudiidga bukib-itoged"]},{"type":"verse","number":1,"content":["Miqueas sogded:",{"text":"“¡An duledar-wiles!","poem":1},{"text":"Ibmar-gwag-yorgi-weleged-abin an nonisulid.","poem":2},{"lineBreak":true},{"text":"Uva-solagan-weleged-abin an nonisulid.","poem":2},{"text":"Degisoggu, uva-san-dukgwenad bar an daksulid,","poem":1},{"text":"degi, an higuera-san-gunnegala gwen an daksurbalid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dule-wiledakmalad bela neggweburgi obelolesad, we-yargi dule-innikimalad bergusad.","poem":1},{"text":"Bela dule-oburgwedgi-binsadimaladi, na muchub-muchub yamodidimalad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ibmar-isgana-imakedgi dule gwen egi obinsulid.","poem":1},{"text":"Dule-dummagan-negsemamaid, degi, dule-igar-nabomalad, dule-bamaladse manigi-baklegar, igar nabomalad.","poem":2},{"text":"Dule-gandikmalad e-itolegedba ibmar egismalad,","poem":1},{"text":"e-ibmar-abegedba ega ukdamalad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"A-dulemar-abargi wis-dule-nuegan-gudimaladdina,","poem":1},{"text":"bur bule sapi-ikobiidyob gued.","poem":2},{"text":"A-dulemar-abargi dule-bur-innikigwaddina, bur bule ikomaryob gued.","poem":1},{"text":"Suli-suli-itoleged-e-ibadi begi danikid,","poem":2},{"text":"Bab-gayaburba-barsogmalad bega-ibmar-sogsadyobi, sabsur-odurdakleged-iba bato bega warmaksad.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Degisoggu, melle be-ai-ibmar-soged be itogo,","poem":2},{"text":"degi, melle dule-baid-bega-ibmar-soged be itogo.","poem":1},{"text":"Be-ome-ebo be sunmakalile, nue-itoakwaa be sunmako.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ar ade, masmala, e-sergangi binsaedsuli guded,","poem":1},{"text":"bunamala, nangangi obited,","poem":2},{"text":"balamar, sak-omegangi obited,","poem":1},{"text":"degi, e-isdarmaladi, e-neguyaginmalad nanaed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Degi-inigwele, ani Miqueas, Bab-Jehováʼgi an bensulid,","poem":1},{"text":"Bab-Dummad-an-abonogedi, an edarbedii guoed.","poem":2},{"lineBreak":true},{"text":"An-Bab-Dummadi, an-itogoed.”","poem":2}]},{"type":"heading","content":["Israel-dulemar bendaklegoed"]},{"type":"verse","number":8,"content":["Miqueas weyob sogded:",{"text":"“An-isdarmalad-yar-baid-baidgi-bukmalad, mer be an-odurdaklegedgi weligwar itomala.","poem":1},{"text":"Ar an galakus-inigwele, amba an gannar gwisguoed.","poem":2},{"text":"An negsichidgi gudii-inigwele, ar Bab-Jehová neg-meegwadga anga gued.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Ar Bab-Jehováʼgi an isgusad,","poem":2},{"text":"degisoggu, Bab-Dummad-anga-igar-nudakedse,","poem":1},{"text":"degi, anga-igar-nabogedse an e-urwed itogoed.","poem":2},{"text":"Geb Bab-Jehová, igar-nued anga oyogoed,","poem":1},{"text":"degi, e-an-abonosadgi an werguoed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"An-isdarad anga sokardaed: ‘¿Bia be-Bab-Jehováʼde?","poem":1},{"text":"A-dule, an-dakalile, bingedar itodoed.’","poem":2},{"text":"An-sunnagwad an-ibya-nuki e-wilegoed an dakoed.","poem":1},{"text":"A-dule, neg-imbaba-olligi-annalegedyobi guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”Jerusalén, gannar be-galu-matusurmalad-sobledele,","poem":1},{"text":"be-yar-abingunanaid nasgudoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"A-ibagangine, dule-bamalad, Asiria-yala-akale, Egipto-yalase-dulemar-bukwad, bese nonimaloed.","poem":1},{"text":"Nilo-diwar-akale, Éufrates-diwarse-dulemar-bukwad, bese nonimaloed.","poem":2},{"text":"Demarsik-bukmalad-akale, demar-baidsik-bukmaladse-dulemar-bukwad, bese nonimaloed.","poem":1},{"text":"Deginbali, yar-dummagansik-bukmalad-akale, yar-dummagan-baidsik-bukmaladse-dulemar-bukwad, bela bese nonimaloed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dule-isgusmalad-ular, we-napneg olloo naguoed,","poem":1},{"text":"deyobi, neg naguoed.”","poem":2}]},{"type":"heading","content":["Bab-Jehová, Israel-dulemar-wiledakoed"]},{"type":"verse","number":14,"content":[{"text":"Bab-Jehová, be-dulamar be nue ako,","poem":1},{"text":"be-mimmigan walagwengi sapur-nuedgi-bukmalad be nue akwedii be guo.","poem":2},{"text":"Epennegwadyobi be Basán-yalase, degi, Galaad-yalase be sede.","poem":1}]},{"type":"verse","number":15,"content":[{"text":"Egipto-yalagi Israel-dulemar-onosgu, ibmar-dakledisurmalad-oyosayobi, be oyoge.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dulemar-yar-baid-baidgi-bukmaladi, be-ibmar-gegerdaklemalad dakmaloed.","poem":1},{"text":"Be-gandikid-dakoedba bingedar itodmaloed,","poem":2},{"text":"geger-dakedba gaya-gadmaloed,","poem":1},{"text":"degi, uaya-atidmaloed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Igi-naibe napagi yaarmakar-nanae, deyobi, nanamaloed.","poem":1},{"text":"Ibdula-unimalad-unimakedyob gumaloed.","poem":2},{"text":"E-dukued-neggi dobed-abalagi nodamaloed,","poem":1},{"text":"be-asabin dobedgi ainidamaloed.","poem":2},{"text":"Anmar-Bab-Dummad-Jehová, bese, gannar we-dulemar nonimaloed.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Bab-Dummad, ¿ar doa beyobid e-mimmigan-besmaladga isgusad-elied gudii?","poem":1},{"text":"¿Doa beyobid ibmar-isgana-imaksad bela ei-ieged gudii?","poem":2},{"text":"Ar be degisadegu, urwedii guosulid,","poem":1},{"text":"ar ade, bur bule anmar-sabguedgi be binsaed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Gannar wile be anmar-dake.","poem":1},{"text":"Anmar-isgued be osuloge,","poem":2},{"lineBreak":true},{"text":"anmar-isguedgi mer bar be binsae.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Jacob-waganga, be-ibmar-inniki-imaked, be oyoge,","poem":1},{"text":"Abraham-waganga, dule-ise-wiledaked be oyoge.","poem":2},{"text":"Epennegwa anmar-dadganga ise-sogar-imaksayobi, be ibmar imake.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}