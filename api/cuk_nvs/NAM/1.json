{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"NAM","translationId":"cuk_nvs","name":"Nahúm","commonName":"Nahúm","title":"NAHÚM-GARDA NAHÚM","order":34,"numberOfChapters":3,"sha256":"9f82cbfed348282ac43c7d62e7d7c83c00992b4ae587639b0bd48b6d117d2630","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cuk_nvs/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Nahúm-negburgan-daksad-e-garda. Nahúmʼde Elcos-neggweburgined. We-gardagi Bab-Jehová Nínive-neggweburgi neg-guoed sogsad."]},{"type":"heading","content":["Bab-Jehová-magarosad"]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová, unnila dule-ebarbi-nanabi abeged,","poem":1},{"text":"buged-mai dule-imakedbalid.","poem":2},{"text":"Bab-Jehová dule-buged-mai-imakedid,","poem":1},{"text":"e-isdarmaladse urwedid.","poem":2},{"text":"Bab-Jehová, dule-egi-yoledimalad buged-mai imaked,","poem":1},{"text":"e-isdarmalad ese sabsur-odurdakleged.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová wissur gwae-gwae urwed.","poem":1},{"text":"Bab-Jehová bela-bela gangued nikad.","poem":2},{"lineBreak":true},{"text":"Bab-Jehová dule-ibmar-oakalosad sabsur-odurdakedsegad.","poem":2},{"text":"Bab-Jehová burwa-oored-abargi, burwa-dummad-abargi gudidaed,","poem":1},{"text":"mogir Bab-Jehová-e-nanaedba ukub-ainakweyobi gued.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová demarga ibmar binnasur sogdele, demar dinnaa naddaed.","poem":1},{"text":"Bela diwarmar dinnaa guega imakbalid.","poem":2},{"text":"Basán-yar, degi, Carmelo-yar bela dinguded,","poem":1},{"text":"Líbano-yar-dutumar bela dingudbalid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová-asabin yarmar giglimakdedaed,","poem":1},{"text":"yar-mullugan babatiddaed.","poem":2},{"text":"Bab-Jehová-asabin napneg giglimakdedaed,","poem":1},{"text":"Bab-Jehová-asabin napneg-dirbir-naid,","poem":2},{"lineBreak":true},{"text":"degi, bela egi bukmalad wawanmakdedaed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Jehová-e-urwed-abin, ¿doa gwisguoe?","poem":1},{"text":"Bab-Jehová-e-sae-itoged-abin, ¿doa gannarbaa gwisguoe?","poem":2},{"text":"Bab-Jehová-e-urwedi, soo-gwabunye-gwichidyobi gued,","poem":1},{"text":"e-asabin akwasailagan bela ese ubigwar gued.","poem":2}]},{"type":"heading","content":["Nínive-neggwebur berguoed"]},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová, duledar-nuedid,","poem":1},{"text":"suli-suli-itogedgine, anmar-odukuedid.","poem":2},{"lineBreak":true},{"text":"Dule-egi-bensurmalad-bendakedid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová Nínive-neggwebur diwar-dummad-noedbali obelogoed.","poem":1},{"text":"Bab-Jehová amba negsichidgine e-isdarmalad-baleginnoed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Jehováʼgi-gwisguega, ¿ibiga bemar igar-isgana aminanai?","poem":1},{"text":"Bab-Jehová bela bemar-giir imakoed,","poem":2},{"lineBreak":true},{"text":"bemar-wiledakega bar iba-baid nasikosulid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bemar gagan-dinnagwadyobi bergumaloed, ikomar-dinnagwadyobi bergumaloed,","poem":1},{"text":"Dule vino-doggus-gobsadba bar-itodisurdaedyobi bemar guoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Be, Nínive-neggwebur, begi dule-binsaed-uked-isgana gwalulesad.","poem":1},{"text":"A-dule, Bab-Jehováʼgi igar-isgana amied.","poem":2}]},{"type":"heading","content":["Mesagwar-dule-imakdiidgi ollorgued"]},{"type":"verse","number":12,"content":["Bab-Jehová weyob soged:",{"text":"“Asiria-dulemar nollosurgumala-inigwele, bergumaloed.","poem":1},{"text":"Asiria-dulemar dula-bukidar-inigwele, burgwemaloed.","poem":2},{"text":"Bedi, Judá-dulemar, an sabsuli-be-wiosmala-inigwele,","poem":1},{"text":"bar deyobi, an be-wiogosurmalad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dulemar-sabsur-be-imakdimaladgi an be-ollor-imakoed,","poem":1},{"text":"bar be maiga-gudii guosurmalad.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Bemardi, Nínive-dorgan, Bab-Jehová bemarga igar-mesisad:","poem":1},{"text":"“Mimmigan bar be nikuosurmarye,","poem":2},{"lineBreak":true},{"text":"adi, be-nug mer bar degisadegu obarledii guegarye.","poem":2},{"text":"Be-bab-dummadse-goled-neggi ibmar-wagar-sobarmar-bukwad,","poem":1},{"text":"esgoro-gordikidgi ibmar-bab-dummadyob-sobar-bukwad, an obelogoed.","poem":2},{"text":"Ar be dule-isganasoggu,","poem":1},{"text":"an bega neg-uan guagwar sioed.”","poem":2}]},{"type":"heading","content":["Nínive-dorgan-galakuoed-igar"]},{"type":"verse","number":15,"content":[{"text":"¡Be dakmala! Dule-gayaburba-nuegan-berbegedi,","poem":1},{"text":"dule neg-bogidik-naguoedgi-sunmakedi, bato yalaganba danikid.","poem":2},{"text":"Judá-dulemar, be-iba-onomaladgi, be wergumala,","poem":1},{"text":"Bab-Jehováʼga be ibmar-ukoye-sogsad be uke.","poem":2},{"text":"Ar dule-isganamar bar be-yarse ubogosurmalad,","poem":1},{"text":"ar bela Bab-Jehováʼse giir gusmalad.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/NAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/NAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/MIC/7.json","previousChapterAudioLinks":{},"numberOfVerses":15}