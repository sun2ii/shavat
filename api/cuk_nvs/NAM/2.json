{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"NAM","translationId":"cuk_nvs","name":"Nahúm","commonName":"Nahúm","title":"NAHÚM-GARDA NAHÚM","order":34,"numberOfChapters":3,"sha256":"9f82cbfed348282ac43c7d62e7d7c83c00992b4ae587639b0bd48b6d117d2630","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cuk_nvs/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["Nínive-neggwebur berguoed"]},{"type":"verse","number":1,"content":[{"text":"Nínive-dorgan, bemargi dule-ibmar-obeloged gwichigudanikid,","poem":1},{"text":"be-neggandikidgi, be nakulegwichi imake.","poem":2},{"text":"Be-igarmarba be nakulemala, es-suid be guagwar gamala,","poem":1},{"text":"bela bemar na niga ogannomala.","poem":2},{"text":"Danale be ambikumala,","poem":1},{"text":"adi, na be gargangued nikumalagar.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ar Bab-Jehová Jacob-dulemar-e-yeerdakleged gannar obinoged.","poem":1},{"text":"Israel-dulemar-e-yeerdakleged gannar obinoged.","poem":2},{"text":"Ar dule-atursamalad e-ibe ibmar susmalanad,","poem":1},{"text":"bela e-ibe uva-dub obelosmalanad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"E-sorda-bila-onomalad-bulegan-e-sigu-abgamalad, ginnitibi magaled,","poem":1},{"text":"sordamar-bila-onomalad mor-ginnigan yoimalad.","poem":2},{"text":"E-ur-napaginmalad guagwar bila-onogega-nanaidi, soo-gaeyobi dakarmaknanaid.","poem":1},{"text":"Sorda-bila-onomalad e-eswarmar-gani-gani, sakwa bipinmakdanimalad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"E-ur-napaginmalad neg-imbaba gwae-gwae oabarmakdemalad,","poem":1},{"text":"binnasuli dulemar-danar-bukumaladgi iirmakdidimalad.","poem":2},{"text":"Acha-gwallu-gaeyobi urmar daklenanaed,","poem":1},{"text":"mar-gaeyobi dakar-dakar gamalad.","poem":2}]},{"type":"heading","content":["Nínive-neggwebur-bergusad, degi, e-ibe ibmar-sulesad"]},{"type":"verse","number":5,"content":[{"text":"Nínive-e-rey e-sordagan-bila-onomalad-buleganse goled,","poem":1},{"text":"we-sordagan duurmakdegua, na muchub-muchub yolenanai gusad.","poem":2},{"text":"Egi-ubodanimalad-abin-bukuega, galu-matusulidsik abarmakdemalad,","poem":1}]},{"type":"verse","number":6,"content":[{"text":"degi-inigwele, yawagak-dummagan-diwar-abgamaid argaded, reyneg aimukuded.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Rey-ome gales selemaid,","poem":1},{"text":"omegan-ega-arbamaladi nuu-akiginmaiyobi selemamaid,","poem":2},{"lineBreak":true},{"text":"nue-nunmak-itogedbali bonadapmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nínive-neggwebur dii-sied-mamarisadyob gued, e-diimar ariomaid.","poem":1},{"text":"Ese gornanaid: “¡Mer be abarmakmala! ¡Be gannar dagmala!”","poem":2},{"lineBreak":true},{"text":"Ar dule-wargwensaar gwen gannar aibirsulid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"¡Mani be sumala!","poem":1},{"text":"¡Or be atursamala!","poem":2},{"text":"Nínive-neggwebur e-ibmar-nuegan yaisulid,","poem":1},{"text":"manimar bukidar nikad, ibmar-yeerdaklemalad bukidar nikbalid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nínive-neggwebur bergus siid,","poem":1},{"text":"dule-sate siid, napabi-nai nagusad.","poem":2},{"text":"Dobedbali dulemar nig-argwatemalad,","poem":1},{"text":"e-yokormar nollomakded.","poem":2},{"text":"Bela e-abagan wawanmakded,","poem":1},{"text":"e-wagarmar bela sibudiki daklenaded.","poem":2}]},{"type":"heading","content":["Achumigur-nono-wawaad-obelolegoed"]},{"type":"verse","number":11,"content":[{"text":"Achumigur-nono-wawaad-e-neg, ¿bia nade?","poem":1},{"text":"Achumigur-e-mimmigan-e-neg, ¿bia nade?","poem":2},{"text":"A-neggine, achumigur-machered, e-ome, degi, e-mimmigan, dule-e-ogwayed-sate, dobsuli mamaidaenad.","poem":1}]},{"type":"verse","number":12,"content":[{"text":"Achumigur-machered na e-mimmiganga san-goa-goa-imakdidaedi, ¿bia nade?","poem":2},{"text":"Na e-omeganga ibdurgan-oburgwedaedi, ¿bia nade?","poem":1},{"text":"Na e-megedgi ibdurgan-oburgwisad-urbedidaedi, ¿bia nade?","poem":2},{"lineBreak":true},{"text":"Na e-neggi san-sabodidaedi, ¿bia nade?","poem":2}]},{"type":"verse","number":13,"content":["Bab-Jehová Bela-Gangued-Nikad weyob soged:",{"text":"“Emigindi, an bemargi gwisguega danikid.","poem":1},{"text":"Be-urmar-napagined-bila-onomalad burubi-sii an imakoed,","poem":2},{"lineBreak":true},{"text":"be-achumigur-burwigana an es-suidgi oburgoed.","poem":2},{"text":"Ibmar-atursamaladi be-yargi an osulogoed,","poem":1},{"text":"be-dule-gayaburba-barsogmalad bar bipisaale itolegosulid.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}