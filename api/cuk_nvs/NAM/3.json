{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"NAM","translationId":"cuk_nvs","name":"Nahúm","commonName":"Nahúm","title":"NAHÚM-GARDA NAHÚM","order":34,"numberOfChapters":3,"sha256":"9f82cbfed348282ac43c7d62e7d7c83c00992b4ae587639b0bd48b6d117d2630","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cuk_nvs/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"heading","content":["Nínive-neggwebur-berguoedgi sunmaklenaid"]},{"type":"verse","number":1,"content":[{"text":"Neggwebur-dulemar-ablis-eogedbi-siid, be ¡duledar-wiles!","poem":1},{"text":"Bela begi neg-gakansalegedbi naid,","poem":2},{"text":"begi bela-bela ibmar-atursalegedbi naid,","poem":1},{"text":"ibmar-atursaedi gwen be indaksulid.","poem":2},{"lineBreak":true},{"text":"Be deyob gusiidi, be ¡duledar-wiles!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Molidub-suid-goledi bato itoleged.","poem":1},{"text":"Ur-napaginmalad-e-nagmar-bipirmaknaid-goled bato itoleged.","poem":2},{"text":"Moli-nag-goledi bato itoleged,","poem":1},{"text":"bila-onomalad-ur-napaginmalad e-gollomakedi bato itoleged.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sorda-moli-birgi-sii-bila-onomalad-danimalad itoleged.","poem":1},{"text":"Es-suid-e-dakarmaked mag dakleged,","poem":2},{"text":"eswar-dakar-dakar-gaed mag dakleged.","poem":1},{"text":"Dulemar-burgwarmaladi yaisulid.","poem":2},{"text":"Muimar odunnumakded,","poem":1},{"text":"muimar baid-baidsik omileded,","poem":2},{"lineBreak":true},{"text":"dulemar a-muimargi yolenanaid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ar ome-gambasaed macherganga yamo-yamo-gudidaed-ular, deyobi neg-gunonikid.","poem":1},{"text":"We-omede, dule-binsaed-gaed-buledid.","poem":2},{"text":"E-gambanuchu-saedgi dulemar-yardaksad,","poem":1},{"text":"e-inamar-isgana-imakedgi dulemar-yardaksabalid.","poem":2}]},{"type":"verse","number":5,"content":["Bab-Jehová-Bela-Gangued-Nikad weyob soged:",{"text":"“¡An bemargi gwisguega danikid!","poem":1},{"text":"Be-sabure wagarse an be-ibe onakoed,","poem":2},{"text":"adi, dulemar-yar-baid-baidgi-bukmalad uka-swiri be-dakmalaga,","poem":1},{"text":"dule-yar-dummaganginmalad be-binge-itoged dakmalagar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Begine an ibmar-isgana mioed,","poem":1},{"text":"an be-nug oichogoed,","poem":2},{"lineBreak":true},{"text":"dulemar-abargi-oyolegega an be-imakoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bela dule-be-dakmaloedi begi bangudoed.","poem":1},{"text":"Sogdemaloed: ‘Nínive-neggwebur bergusye.","poem":2},{"text":"¿Doa eba wile itogoe?","poem":1},{"text":"¿Bia dule-wile-e-daked an ega amioe?’ ”","poem":2}]},{"type":"heading","content":["Nínive-neggwebur-bela-obelolesad"]},{"type":"verse","number":8,"content":[{"text":"¿Ar bede Tebas-neggweburba bur-nuedsi?","poem":1},{"text":"Ar Tebas-neggweburde diimar-abargi siinad,","poem":2},{"lineBreak":true},{"text":"Nilo-diwar-sukamakmaid-walik siinad,","poem":2},{"text":"Demar e-napa-odinnogaledyob guenad,","poem":1},{"text":"diimar e-galu-matusulidyob guenad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Etiopía-yar, Egipto-yar, Tebas-neggwebur-bendaksimalanad,","poem":1},{"lineBreak":true},{"text":"bela-bela gangued nikamalanad.","poem":1},{"text":"Fut-yar, Libia-yar, Tebasʼba naimalanad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Degi-inigwele, Tebas-dulemar yar-baidse ononnolesmalad,","poem":1},{"text":"yar-baidse gales-selesmalad.","poem":2},{"text":"E-mimmigan igar-abingunanaidgi","poem":1},{"text":"sabsur-omukulenai gusmalad.","poem":2},{"text":"E-dule-nuga-nikamalad ibmarba-wilubdakar mimilesgusmalad,","poem":1},{"text":"e-dule-dummagan-negsediid esgoro-dubgi edilles gusmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Be, Nínive-neggwebur, be-omumsamarmogoed,","poem":1},{"text":"neg-itosuli be gudii guoed.","poem":2},{"text":"Be-isdarmalad-ulale,","poem":1},{"text":"neg-dukued amidii be gumogoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bela be-neg-gandikmaladi","poem":1},{"text":"higuera-sapi-san-gordik-siiyobi gued,","poem":2},{"text":"ar dule osiamakele,","poem":1},{"text":"dule-gunnega-gwichid-e-gaya-yaba argwaned.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Be dake, be-isdarmaladbo be bila-ononaidgi,","poem":1},{"text":"be-sorda-bila-onomalad omeganyobi damalad.","poem":2},{"text":"Be-neggwebur-e-yawagakmar argasii guoed,","poem":1},{"text":"ar be-yawagakgi-suar-biir-biir-megmalad soose gummakoed.","poem":2}]},{"type":"heading","content":["Binsa neg-bendaked amimaloed"]},{"type":"verse","number":14,"content":[{"text":"Nínive-neggwebur, be-isdarmalad be-neggwebur-ebiris-ambikunonimaloed-iduar, dii be enomar,","poem":1},{"text":"be-neg-gandikmalad be ogannomala.","poem":2},{"text":"Napa-olli-ollid-birgi be gwisgue, napsa-ginnid-birgi be annae,","poem":1},{"text":"akwa-napsa-ginnidgi-sobaled be sobe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Degi-inigwele, soogi be burgwemaloed,","poem":1},{"text":"es-suidgi be girgumaloed,","poem":2},{"lineBreak":true},{"text":"be-isdarmalad sesmaryobi giir be-imakmaloed.","poem":2},{"text":"Ses-burwiganayobi be mergumai gumala,","poem":1},{"text":"sesmaryobi be gwalulemai gumala.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Be-dula ibmar-ukedgi-arbamaladi,","poem":1},{"text":"bur bule nibneggi-niisgwamar-nanaidba merguded.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Be-dummagan seseyobi gumalad,","poem":1},{"text":"be-sordamar-e-dummagan ibmar-gukumalad-gar-satedyobi gumalad.","poem":2},{"lineBreak":true},{"text":"We-ibmarmar neg-dambegwadgine galu-matusurmaladgi achaa nagudamalad.","poem":2},{"text":"Ar dad-nakwialirdi gukuddamalad, bar daklegosulid,","poem":1},{"text":"dule wissulid bia naddamala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Asiria-e-Rey,","poem":1},{"text":"dule-bega-negdakmamaid bela-bela gabmamaid,","poem":2},{"lineBreak":true},{"text":"be-sordamar-ise-welegar-imaklesmalad gabidmalad.","poem":2},{"text":"Be-dulamar yala-imbaganba aisakis gudidiid,","poem":1},{"text":"amar-onmakega dule sated.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Be-nailikgusadi gege nudakleged,","poem":1},{"text":"be-yaa-siid-nudakega ina sated.","poem":2},{"lineBreak":true},{"text":"Dulemar deyob-be-gusadi be-wisgumaloedi,","poem":1},{"text":"bega yeer-itomaloed.","poem":2},{"text":"Ar ade, dulemar-yar-baid-baidgi-bukmalad-bukidara","poem":1},{"text":"be sabsur-imaksa gusad.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}