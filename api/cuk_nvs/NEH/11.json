{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"NEH","translationId":"cuk_nvs","name":"Nehemías","commonName":"Nehemías","title":"NEHEMÍAS-GARDA NEHEMÍAS","order":16,"numberOfChapters":13,"sha256":"7a7d16db36198388241b308c4e64142ab1d56b2c7ff3e72196cbe081c1169b57","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/NEH/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/cuk_nvs/NEH/13.json","totalNumberOfVerses":406},"chapter":{"number":11,"content":[{"type":"heading","content":["Jerusalén-neggweburginmalad"]},{"type":"verse","number":1,"content":["Dulemar-neggweburgi-dummaganga-gudidimalad Jerusalén-neggweburgi megnonimalad. Ar Jerusalén-neggwebur, neggwebur-swilidikid-gued. Degi, dulemar-baigandi, na wilubdaknanai-guarmalad, doa-dule, dule-e-ambegine gwensak (10%) Jerusalén-neggwebur-islidikidse megnamaloe, degine, baigan-walabakebakaddi (9) e-neggwebur-baiganse megnamaloed."]},{"type":"verse","number":2,"content":["Bela-dulemar na dukin-dukin sogsamalad, emarde Jerusalén-neggweburgi megmaloye. A-ular, Israel-dulemar nue-yeer a-dulemargi binsasmalad."]},{"type":"verse","number":3,"content":["Dulemar Judá-yar-neggwebur-baigangi na e-nainu-nainugi-megismaladi, degi, na e-neggwebur-e-neggweburgi-megismaladi, wemar-dake: Dule-irwa-Bab-Dummadse-gormalad, Levita-dulemar, Bab-Dummadse-goled-neggi-dule-arbamalad, degi, Salomón-maigan-e-wagan. Israel-yar-e-dummaganga-gudimaladi, Jerusalén-neggweburgi megismalad."]},{"type":"verse","number":4,"content":["Amala, abala Judá-waganad, degi, abala Benjamín-waganmogad.",{"text":"Judá-wagandi, wemalad:","poem":1},{"text":"Uzías-machi-Ataías. Uzíasʼde, Zacarías-machid.","poem":2},{"lineBreak":true},{"text":"Zacaríasʼdi, Amarías-machid. Amaríasʼdi, Sefatías-machid.","poem":2},{"lineBreak":true},{"text":"Sefatíasʼdi, Mahalaleel-machid. Mahalaleelʼdi, Fares-wagwad.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Degine, Baruc-machi-Maasías, Barucʼde, Colhoze-machid.","poem":2},{"lineBreak":true},{"text":"Colhozeʼdi, Hazaías-machid. Hazaíasʼdi, Adaías-machid.","poem":2},{"lineBreak":true},{"text":"Adaíasʼdi, Joiarib-machid. Joiaribʼdi, Zacarías-machid.","poem":2},{"lineBreak":true},{"text":"Zacaríasʼdi, Siloni-machid.","poem":2}]},{"type":"verse","number":6,"content":["Bela Fares-wagan, Jerusalén-neggweburgi dulataled-ilabake gaka dulapaa-gakabaabak (468) mergu megismalad. Bela wemala, bila-onomalad-sorda-gumalad."]},{"type":"verse","number":7,"content":[{"text":"Benjamín-wagan Jerusalénʼgi megismaladi, wemalad:","poem":1},{"text":"Mesulam-machi-Salú, Mesulamʼde, Joed-machid.","poem":2},{"lineBreak":true},{"text":"Joedʼdi, Pedaías-machid. Pedaíasʼdi, Colaías-machid.","poem":2},{"lineBreak":true},{"text":"Colaíasʼdi, Maasías-machid. Maasíasʼdi, Itiel-machid.","poem":2},{"lineBreak":true},{"text":"Itielʼdi, Jesaías-machid.","poem":2}]},{"type":"verse","number":8,"content":["Degine, Jesaías-gwenadgan-gargwenmaladdi, Gabai, degi, Salai, bela amarse-bakale, dulataled-ilabakebak gaka dulagwen-gakabaabak (928) mergumalad."]},{"type":"verse","number":9,"content":["Zicri-machi-Joel, wemar-e-dummadga gued. Degine, Senúa-machi-Judá, dummad-sorbali Jerusalén-neggweburgi negdakedmogad."]},{"type":"verse","number":10,"content":[{"text":"Dule-irwa-Bab-Dummadse-gormaladdi, wemalad:","poem":1},{"text":"Joiarib-machi-Jedaías, Jaquín,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hilcías-machi-Seraías.","poem":2},{"lineBreak":true},{"text":"Hilcíasʼde, Mesulam-machid. Mesulamʼdi, Sadoc-machid.","poem":2},{"lineBreak":true},{"text":"Sadocʼdi, Meraiot-machid. Meraiotʼdi, Ahitob-machid.","poem":2},{"lineBreak":true},{"text":"We-Ahitobʼde, Bab-Dummadse-goled-neg-e-dummadid.","poem":2}]},{"type":"verse","number":12,"content":["Degine, bela e-gwenadgan Bab-Dummadse-goled-neggi-arbananaid, dulataled-ilabaabak gaka dulagwen-gakabo (822) mergued.",{"text":"Deyobi, Jeroham-machi-Adaías, Jerusalénʼgi megismogad.","poem":1},{"text":"Jerohamʼde, Pelalías-machid. Pelalíasʼdi, Amsi-machid.","poem":2},{"lineBreak":true},{"text":"Amsiʼdi, Zacarías-machid. Zacaríasʼdi, Pasur-machid.","poem":2},{"lineBreak":true},{"text":"Pasurʼdi, Malquías-machid.","poem":2}]},{"type":"verse","number":13,"content":["Degine, Adaías-gwenadgan, e-neg-yaurgi na negsedimalad, bela dulataled-ilabo gaka dulabo-gakabo (242) mergue megismarmogad.",{"text":"Deginbali, Azareel-machi-Amasai, megismogad,","poem":1},{"text":"Azareelʼde, Azai-machid. Azaiʼdi, Mesilemot-machid.","poem":2},{"lineBreak":true},{"text":"Mesilemotʼdi, Imer-machid.","poem":2}]},{"type":"verse","number":14,"content":["Degine, Amasai-gwenadgan, dule-gala-ibeganad, bela dulanergwa-gakabaabak (128) mergued. Gedolim-machi-Zabdiel amar-dummadga-gued."]},{"type":"verse","number":15,"content":[{"text":"Levita-dulemardi, wemalad:","poem":1},{"text":"Hasub-machi-Semaías, Hasubʼde, Azricam-machid.","poem":2},{"lineBreak":true},{"text":"Azricamʼdi, Hasabías-machid. Hasabíasʼdi, Buni-machid.","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Sabetai, Jozabadʼbo, megismarmogad.","poem":2},"Wemar, Levita-dulemar-e-dummagan-gumalad, degi, Bab-Dummadse-goled-neg-magabalid-soblenaid, e-dummaganga-gumalad."]},{"type":"verse","number":17,"content":["Micaía-machi-Matanías, a-dule-namaked-e-iduedid. Bab-Dummadse-goter, a-inse Bab-Dummad-nug ogannoddaed, degi, dog-nuedye Bab-Dummadga sogdedaed.",{"text":"Micaíaʼde, Zabdi-machid. Zabdiʼdi, Asaf-machid.","poem":2},{"lineBreak":true},{"text":"Degi, Bacbuquías Matanías-sorbalidi, Jerusalénʼgi megismogad.","poem":2},{"lineBreak":true},{"text":"Degi, Samúa-machi-Abda, Samúaʼde, Galal-machid.","poem":2},{"lineBreak":true},{"text":"Galalʼdi, Jedutún-machid.","poem":2}]},{"type":"verse","number":18,"content":["Bela Levita-dulemala, Jerusalén-neggwebur-islidikidgi, dulataled-ilabo gaka dulabake-gakabake (284) mergue megismalad."]},{"type":"verse","number":19,"content":[{"text":"Yawagak-dakmaladdi, wemalad:","poem":1},{"text":"Acub, Talmón, degine, e-urbamar.","poem":2},"Wemala, yawagakgi-nakulemaladid. Amar, dulabaabak-gakambe-gakabo (172) bela mergumalad."]},{"type":"verse","number":20,"content":["Geb Israel-dulemar-baigandi, dule-irwa-Bab-Dummadse-gormalad-baigandi, degi, Levita-dulemar-baigandi, Judá-yargi baigan-neggweburmargi, na e-nainu-e-nainugi mamai-gusmalad."]},{"type":"verse","number":21,"content":[{"text":"Bab-Dummadse-goled-neggi-arbamaladdi, Ofel-yargi megismalad.","poem":1},{"text":"Ziha, degi, Gispa, amar, amar-dummadga gusmalad.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bani-machi-Uzi Jerusalén-neggweburgi, Levita-dulemar-e-dummadid.","poem":1},{"text":"Baniʼde, Hasabías-machid. Hasabíasʼdi, Matanías-machid.","poem":2},{"lineBreak":true},{"text":"Mataníasʼdi, Micaía-machid. We-Micaíaʼde, Asaf-wagwa-gwensakadid.","poem":2},"Wemarde, Bab-Dummadse-goled-neggi dule-namakmalad-gumalad."]},{"type":"verse","number":23,"content":["Ar ade, rey igar-uksagusad, degi, bane-bane dule-namakmalad igarmar-mamaidba ibmar imakmaloed."]},{"type":"verse","number":24,"content":["Rey, e-nuggi Mesezabeel-machi-Petaías bela-dulemarga-igar-nabogegala, onug-imaksad.",{"text":"Mesazabeelʼde, Zera-wagwa-gwensakad-gued.","poem":1},{"lineBreak":true},{"text":"Zeraʼde, Judá-wagwa-gumogad.","poem":1}]},{"type":"heading","content":["Neggwebur-baigangi Israel-dulemar ambikusbalid"]},{"type":"verse","number":25,"content":["Israel-dulemar-baigandi, Judá-yargi neggwebur-dummagangi, degi, e-neggwebur-burwigangi megismalad.",{"text":"A-neggweburmardi, wemalad:","poem":1},{"text":"Quiriat-Arba-neggwebur, Dibón-neggwebur, Jecabseel-neggwebur.","poem":2}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Jesúa-neggwebur, Molada-neggwebur, Bet-Pelet-neggwebur.","poem":2}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Hazar-Sual-neggwebur, Beerseba-neggwebur,","poem":2}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Siclag-neggwebur, Mecona-neggwebur,","poem":2}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"En-Rimón-neggwebur, Zora-neggwebur, Jarmut-neggwebur,","poem":2}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Zanoa-neggwebur, Adulam-neggwebur,","poem":2},{"lineBreak":true},{"text":"Laquis-neggwebur, Azeca-neggwebur.","poem":2},{"lineBreak":true},{"text":"Beerseba-neggwebur-akar, Hinom-nebase ambikusmalad.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Benjamín-wagandi we-neggweburmargi ambikusmalad:","poem":1},{"text":"Geba-neggweburgi, Micmas-neggweburgi, Aía-neggweburgi,","poem":2},{"lineBreak":true},{"text":"Betelʼgi, degi, e-neggwebur-burwigangi ambikusmalad.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Neggwebur-baigan, wemarbalid:","poem":1},{"text":"Anatot-neggwebur, Nob-neggwebur, Ananías-neggwebur,","poem":2}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Hazor-neggwebur, Ramá-neggwebur, Gitaim-neggwebur,","poem":2}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Hadid-neggwebur, Seboim-neggwebur, Nebalat-neggwebur.","poem":2}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Lod-neggwebur, Ono-neggwebur,","poem":2},{"lineBreak":true},{"text":"degi, Argangi-Ibmar-Sobmalad-Nebagi ambikusmalad.","poem":2}]},{"type":"verse","number":36,"content":["Levita-dulemar gwen-gwena Judá-yargi megismalad, degine, Benjamín-dulemarba megismarbalid."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/NEH/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/NEH/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/NEH/10.json","previousChapterAudioLinks":{},"numberOfVerses":36}