{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"NEH","translationId":"cuk_nvs","name":"Nehemías","commonName":"Nehemías","title":"NEHEMÍAS-GARDA NEHEMÍAS","order":16,"numberOfChapters":13,"sha256":"7a7d16db36198388241b308c4e64142ab1d56b2c7ff3e72196cbe081c1169b57","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/NEH/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/cuk_nvs/NEH/13.json","totalNumberOfVerses":406},"chapter":{"number":7,"content":[{"type":"heading","content":["Nehemías dule-dummagan-onugsasad"]},{"type":"verse","number":1,"content":["Jerusalén-galu-matusulid bela nudaklesgua, e-yawagakmar ogwichilesad. Geb e-yawagak-dakmalad onugsalesad, degi, dule-namakmalad onugsalesbalid, degi, Levita-dulemar amilesbalid."]},{"type":"verse","number":2,"content":["Geb degine, an-urba-Hanani, Jerusalén-neggwebur-e-dummadga-megega an nugsasad. Degi, Hananíasʼdi, Jerusalénʼgi reyneg-siid-dakedga an nugsasad. Hananíasʼde, dule-napiragwadid, dule-baiganba bur bule Bab-Dummad-dobee nanadiid-duled. We-dulemar-warbogwadga an igar-uksad."]},{"type":"verse","number":3,"content":["Amarga an sogsad: “Dad-nakwialile, Jerusalén-neggwebur-e-yawagakmar argadoed. Geb, dad-argwaned-idu, dule-yawagak-dakmalad amba arbananai, e-yawagakmar sakdiledoed, degi, be urgo iduar-mesoed nue edilegega. ”Deginbali, Jerusalénʼginmalad neggweburgi-nakulegega an onugsasad, amala gwenna-gwenna ega-soglesad bia nakulegoe, abala na e-neg-e-neg-asabin nakulemaloed.”"]},{"type":"verse","number":4,"content":["Jerusalén-neggweburde bipisursoggu, olloo-dakleged. Ar ade amba yoo negmar gannar soblesoggu, dulemar-ichee bukwad."]},{"type":"heading","content":["Zorobabelʼba gannar Jerusalénʼse nonimalad"]},{"type":"verse","number":5,"content":["Geb degidgine, Bab-Dummad an-gwage ebusad, dule-dummagan, dule-nuga-nikamalad, degi, bela dulemar na e-gwenadgan-e-gwenadganba urbega, adi, e-dadgan-e-dadganba amar-ebisega. Geb agine, an garda amisad, dulemar an-idu-nonimalad-e-dadgan-nugmar narmakar-nanai. Agi, narmakar-naid:"]},{"type":"verse","number":6,"content":["Wemar, Babilonia-e-rey-Nabucodonosorʼse-galesa, Babiloniaʼse-selesmalad. Amar gannar Judá-yarse, degi, Jerusalén-neggweburse-nonimalad-e-nugmar narmakar-nai an dakalid.",{"text":"Wemar, na e-neggwebur-e-neggweburse gannar nonimalad:","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Zorobabelʼba, Jesúaʼba, Nehemíasʼba,","poem":2},{"lineBreak":true},{"text":"Azaríasʼba, Raamíasʼba, Nahamaniʼba nonimalad.","poem":2},{"lineBreak":true},{"text":"Degine, Mardoqueoʼba, Bilsánʼba, Misperetʼba,","poem":2},{"lineBreak":true},{"text":"Bigvaiʼba, Nehumʼba, degi, Baanaʼba nonimalad.","poem":2},{"text":"Israel-dulemar gannar nonimalad, wemalad:","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Paros-wagan, milibo gaka dulabaabak-gakambe-gakabo (2,172).","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sefatías-wagan, dulataled-ilapaa gaka dulapaa-gakambe-gakabo (372).","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ara-wagan, dulataled-ilanergwa gaka dulabo-gakambe-gakabo (652).","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pahat-Moab-wagan, a sogleged, Jesúa-waganye, degi, Joab-waganye, milibo gaka dulataled-ilabaabak gakambe-gakabaabak (2,818).","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Elam-wagan, miligwen gaka dulataled-ilabo gaka dulabo-gakambe-gakabake (1,254).","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zatu-wagan, dulataled-ilabaabak gaka dulabo-gakatar (845).","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Zacai-wagan, dulataled-ilagugle gaka dulapaa (760).","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Binúi-wagan, dulataled-ilanergwa gaka dulabo-gakabaabak (648).","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bebai-wagan, dulataled-ilanergwa gaka durgwen-gakabaabak (628).","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Azgad-wagan, milibo gaka dulataled-ilapaa gaka durgwen-gakabo (2,322).","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Adonicam-wagan, dulataled-ilanergwa gaka dulapaa-gakagugle (667).","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Bigvai-wagan, milibo gaka dulapaa-gakagugle (2,067).","poem":2}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Adín-wagan, dulataled-ilanergwa gaka dulabo-gakambe-gakatar (655).","poem":2}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ater-wagan, a sogleged, Ezequías-waganye, dulabake-gakambe-gakabaabak (98).","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Hasum-wagan, dulataled-ilapaa gaka durgwen-gakabaabak (328).","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Bezai-wagan, dulataled-ilapaa gaka durgwen-gakabake (324).","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Harif-wagan, dulatar-gakambe-gakabo (112).","poem":2}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Gabaón-wagan, dulabake-gakambe-gakatar (95).","poem":2}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Belénʼginmalad, degi, Netofaʼginmalad, dulabakebak-gakabaabak (188).","poem":2}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Anatotʼginmalad, dulanergwa-gakabaabak (128).","poem":2}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Bet-Azmavetʼginmalad, dulabo-gakabo (42).","poem":2}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Quiriat-Jearimʼginmalad, Cafiraʼginmalad, degi, Beerotʼginmalad, dulataled-ilagugle gaka dulabo-gakapaa (743).","poem":2}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ramá-neggweburginmalad, degi, Geba-neggweburginmalad, dulataled-ilanergwa gaka durgwen-gakagwensak (621).","poem":2}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Micmas-neggweburginmalad, dulanergwa-gakabo (122).","poem":2}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Betel-neggweburginmalad, degi, Hai-neggweburginmalad, dulanergwa-gakapaa (123).","poem":2}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Nebo-neggwebur-baidginmalad, dulabo-gakambe-gakabo (52).","poem":2}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Elam-baid-wagan, miligwen gaka dulataled-ilabo gaka dulabo-gakambe-gakabake (1,254).","poem":2}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Harim-wagan, dulataled-ilapaa gaka durgwen (320).","poem":2}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Jericó-wagan, dulataled-ilapaa gaka dulabo-gakatar (345).","poem":2}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Lod-wagan, Hadid-wagan, degi, Ono-wagan,","poem":2},{"lineBreak":true},{"text":"dulataled-ilagugle gaka durgwen-gakagwensak (721).","poem":2}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Senaa-wagan, milipaa gaka dulataled-ilabakebak gaka durgwen-gakambe (3,930).","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Dule-irwa-Bab-Dummadse-gormalad-nonimalad, wemalad:","poem":1},{"text":"Jedaía-wagan, Jesúa-gwenadgansikid, dulataled-ilabakebak gaka dulapaa-gakambe-gakapaa (973).","poem":2}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Imer-wagan, miligwen gaka dulabo-gakambe-gakabo (1,052).","poem":2}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Pasur-wagan, miligwen gaka dulataled-ilabo gaka dulabo-gakagugle (1,247).","poem":2}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Harim-wagan, miligwen gakambe-gakagugle (1,017).","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Levita-dulemar, wemalad:","poem":1},{"text":"Jesúa-wagan, degi, Cadmiel-wagan, amala, Hodavías-e-waganad, dulapaa-gakambe-gakabake (74) mergued.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Dule-namakmalad, wemalad:","poem":1},{"text":"Asaf-wagan, dulagugle-gakabaabak (148).","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Dule-yawagak-dakmalad, wemalad:","poem":1},{"text":"Salum-wagan, Ater-wagan, Talmón-wagan,","poem":2},{"lineBreak":true},{"text":"Acub-wagan, Hatita-wagan, degi, Sobai-wagan,","poem":2},{"lineBreak":true},{"text":"dulanergwa-gakambe-gakabaabak (138).","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Dule-Bab-Dummadse-goled-neggi-arbamalad, wemalad:","poem":1},{"text":"Ziha-wagan, Hasufa-wagan, Tabaot-wagan,","poem":2}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Queros-wagan, Siaha-wagan, Padón-wagan,","poem":2}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Lebana-wagan, Hagaba-wagan, Salmai-wagan,","poem":2}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"Hanán-wagan, Gidel-wagan, Gahar-wagan,","poem":2}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Reaía-wagan, Rezín-wagan, Necoda-wagan,","poem":2}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Gazam-wagan, Uza-wagan, Paseah-wagan,","poem":2}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"Besai-wagan, Mehunim-wagan, Nefisesim-wagan,","poem":2}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"Bacbuc-wagan, Hacufa-wagan, Harhur-wagan,","poem":2}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"Bazlut-wagan, Mehída-wagan, Harsa-wagan,","poem":2}]},{"type":"verse","number":55,"content":[{"lineBreak":true},{"text":"Barcos-wagan, Sísara-wagan, Tema-wagan,","poem":2}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"Nezía-wagan, degine, Hatifa-wagan.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Salomón-maimar-wagan, wemalad:","poem":1},{"text":"Sotai-wagan, Soferet-wagan, Perida-wagan,","poem":2}]},{"type":"verse","number":58,"content":[{"lineBreak":true},{"text":"Jaala-wagan, Darcón-wagan, Gidel-wagan,","poem":2}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"Sefatías-wagan, Hatil-wagan,","poem":2},{"lineBreak":true},{"text":"Poqueret-Hazebaim-wagan, Amón-wagan.","poem":2}]},{"type":"verse","number":60,"content":["Dule Bab-Dummadse-goled-neggi-arbamalad, degi, Salomónʼga-arbamalad-wagan, dulataled-ilapaa gaka dulabake-gakambe-gakabo (392)."]},{"type":"verse","number":61,"content":[{"text":"Baigandi:","poem":1},{"text":"Tel-Melaʼgi, Tel-Harsaʼgi, Querubʼgi,","poem":2},{"lineBreak":true},{"text":"Adónʼgi, degi, Imer-neggweburmargi noarmarmogad.","poem":2},{"text":"Amarde, geg oyogusmalad, doamar e-dadganmala, degi, emar Israel-dulemar-gumarbardibe.","poem":3}]},{"type":"verse","number":62,"content":[{"text":"Amardi, wemardo:","poem":1},{"text":"Delaía-wagan, Tobías-wagan, degi, Necoda-wagan,","poem":2},{"lineBreak":true},{"text":"dulataled-ilanergwa gaka dulabo-gakabo (642).","poem":2}]},{"type":"verse","number":63,"content":["Dule-irwa-Bab-Dummadse-gormaladmoga, geg oyogusmarmogad, emarde Israel-dulemar-gumardibe.",{"text":"Amardi, wemardo:","poem":1},{"text":"Habaía-wagan, Cos-wagan, degi, Barzilai-wagan.","poem":2},"Barzilai-wagwa-gwensakde, Barzilai-sisgwa-wargwen nikusad. We-Barzilaiʼde, Galaadʼginedid. Abali, na e-nug susad."]},{"type":"verse","number":64,"content":["Wemala, na e-dadgan-nug amidmargu, amissurgusmalad. Degisoggu, dule-irwa-Bab-Dummadse-goledga bar gussurmardo, ar ade, swilidikidsuryenik soglesad."]},{"type":"verse","number":65,"content":["Degidgine, saila-dummadga-maid igar-uksamogad, we-dulemar melle Bab-Dummadga-ibmar-uklegaled gunnamaloye. Geb dule-irwa-Bab-Dummadse-goled-wargwen Urimʼba, degi, Tumimʼba Bab-Dummadse-egisedse nabir we-dulemar mas-swilidikid gunmalodibe, surdibe."]},{"type":"verse","number":66,"content":[{"text":"Bela dulemar-danar, mili-dulabo-gakabo gaka dulataled-ilapaa gaka dulapaa (42,360) mergu ambikunonimalad.","poem":1}]},{"type":"verse","number":67,"content":[{"text":"Wemar-abargi, e-mai-machergan, degi, e-mai-omegan obarilenaisulid.","poem":2},{"text":"Emarbi, miligugle gaka dulataled-ilapaa gaka durgwen-gakambe-gakagugle (7,337) mergued.","poem":3},{"text":"E-namakmalad-machergan, degi, e-namakmalad-omegan,","poem":2},{"text":"dulataled-ilabo gaka dulabo-gakatar (245) mergu nikad.","poem":3}]},{"type":"verse","number":68,"content":[{"text":"Molimar weyob mergued:","poem":2},{"text":"Dulataled-ilagugle gaka dulagwen-gakambe-gakanergwa (736) mergu nikad.","poem":3},{"text":"Moli-uaya-senigwadmardi,","poem":2},{"text":"dulataled-ilabo gaka dulabo-gakatar (245) mergu nikad.","poem":3}]},{"type":"verse","number":69,"content":[{"text":"Moli-yargan-muremaladdi,","poem":2},{"text":"dulataled-ilabake gaka durgwen-gakambe-gakatar (435) mergued.","poem":3},{"text":"Moli-uayasuiddi,","poem":2},{"text":"milinergwa gaka dulataled-ilagugle gaka durgwen (6,720) mergumogad.","poem":3}]},{"type":"verse","number":70,"content":["Bukidar babgan-na-neguya-sedimalad, Bab-Dummadga arbaed-imakega ibmar uksamalad.",{"text":"Jerusalén-neggweburgi dummadga-maid ibmar-uksad:","poem":1},{"text":"Or-nibirambe-gakabakebak (19) uksad,","poem":2},{"lineBreak":true},{"text":"nogmar gwadulabo-gakambe (50) uksabalid,","poem":2},{"lineBreak":true},{"text":"degine, dule-irwa-Bab-Dummadse-gormalad-e-mor-yomalad,","poem":2},{"text":"goadulataled-ilatar gaka dulagwen-gakambe (530) uksabalid.","poem":3}]},{"type":"verse","number":71,"content":[{"text":"Babgan-na-neguya-sedimalad, Bab-Dummadga weyob-arbaed-imakega ibmar-uksamarmogad:","poem":1},{"text":"Or, nibir-dulataled-ilapaa gaka dulapaa-gakambe-gakatar (375) aidiku uksad.","poem":2},{"lineBreak":true},{"text":"Mani, nibir-milibo gaka dulataled-ilagugle (2,700) aidiku uksabalid.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"Dule-baiganmoga:","poem":1},{"text":"Or, nibir-dulataled-ilapaa gaka dulapaa-gakambe-gakatar (375) aidiku uksamarmogad,","poem":2},{"lineBreak":true},{"text":"Mani, nibir-milibo gaka dulataled-ilabo gaka dulabo-gakambe (2,250) aidiku uksamarbalid.","poem":2},{"lineBreak":true},{"text":"Degine, dule-irwa-Bab-Dummadse-gormalad-e-mor-yomalad,","poem":2},{"text":"goadulapaa-gakagugle (67) uksamarbalid.","poem":3}]},{"type":"verse","number":73,"content":[{"text":"Degine,","poem":1},{"text":"dule-irwa-Bab-Dummadse-gormalad,","poem":2},{"lineBreak":true},{"text":"Levita-dulemar,","poem":2},{"lineBreak":true},{"text":"dule-yawagak-dakmalad,","poem":2},{"lineBreak":true},{"text":"dule-namakmalad,","poem":2},{"lineBreak":true},{"text":"dule-neggweburginmalad,","poem":2},{"lineBreak":true},{"text":"dule-Bab-Dummadse-goled-neggi-arbamalad,","poem":2},{"lineBreak":true},{"text":"degi, bela Israel-dulemar, na e-neggwebur-e-neggweburse megnadmalad.","poem":2},"Nii-walaguglegusgu (7), bela Israel-dulemar na e-neggwebur-e-neggweburgi bato mamaimalad."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/NEH/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/NEH/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/NEH/6.json","previousChapterAudioLinks":{},"numberOfVerses":73}