{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"NEH","translationId":"cuk_nvs","name":"Nehemías","commonName":"Nehemías","title":"NEHEMÍAS-GARDA NEHEMÍAS","order":16,"numberOfChapters":13,"sha256":"7a7d16db36198388241b308c4e64142ab1d56b2c7ff3e72196cbe081c1169b57","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/NEH/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/cuk_nvs/NEH/13.json","totalNumberOfVerses":406},"chapter":{"number":9,"content":[{"type":"heading","content":["Israel-dulemar Bab-Dummadga na e-isgusad barsogdemalad"]},{"type":"verse","number":1,"content":["Nii-walagugled iba-durgwen-gakabakegi, Israel-dulemar na bular ambikunonimalad, adi, mas-gunsuli Bab-Dummadse-golega. Geb emar bela-bela bukib-itoged-oyogega, mor-sommed yosmalad, degi, e-nonogi buru eosmarbalid."]},{"type":"verse","number":2,"content":["Israel-dulemar dule-baigangi bachikii ambikusmargua, gwichi na e-isgued Bab-Dummadga barsogdemalad, degi, e-dadgan-isgusad Bab-Dummadga barsogdemarbalid."]},{"type":"verse","number":3,"content":["Deyob-gwichi, E-Bab-Dummad-Jehová-Igar-Maid-garda wachi-ilapaa absosmalad. Geb baid-wachi-ilapaa, e-isgued e-Bab-Dummad-Jehováʼga barsogsamarbalid, degi, baid-wachi-ilapaa, e-Bab-Dummad-Jehová-nug odummosmarbalid."]},{"type":"verse","number":4,"content":[{"text":"Agine, Levita-dule:","poem":1},{"text":"Jesúa, Bani, Cadmiel, Sebanías, Buni, Serebías, Bani,","poem":2},{"lineBreak":true},{"text":"degi, Quenani, nibakwaa urgo-aila-soblealid-birgi nakwismalad.","poem":2},"Agi, binnasuli e-Bab-Dummad-Jehováʼse gotemalad."]},{"type":"verse","number":5,"content":[{"text":"Weyobi, Levita-dulemar:","poem":1},{"text":"Jesúa, Cadmiel, Bani, Hasabnías, Serebías, Hodías,","poem":2},{"lineBreak":true},{"text":"Sebanías, degi, Petaías sogdemalad:","poem":2},"“Bemar gwisgumar. Bab-Jehová-gusgu-maiguad, degisadegu-maigubaloed, a-e-nug be odummomar.",{"text":"‘Bab-Jehová, be-nug odummolesun.","poem":1},{"text":"Bur bule be-nug-gandikidgi, nued binsaledii gusana yeerban,","poem":2},{"lineBreak":true},{"text":"ibmar-baiganba bur bule be-nug odummolesana yeerban.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"” ’Unnila bebi Bab-Jehová-gued.","poem":1},{"text":"Nibneg be nasiksadid:","poem":2},{"text":"Bela nibneg-naid ugakaase, bela e-niisgwamar ega be nasiksad.","poem":1},{"text":"Be, be napneg nasiksabalid,","poem":2},{"lineBreak":true},{"text":"degi, bela ibmarmar-bukwad be obinnisbalid.","poem":2},{"text":"Deginbali, demar-nanaidi, degi, bela agi ibmarmar-bukwad be obinnisbalid.","poem":1},{"text":"Bela we-ibmarmala dula-gued be imaksad.","poem":2},{"text":"A-ulale, sordamar-nibnegginmalad bese gotemalad,","poem":1},{"text":"bela-belad be-nug-odummomalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"” ’Be, Bab-Dummad-Jehová-gued.","poem":1},{"text":"Be, be Abram-susad.","poem":2},{"text":"Be, Abram Caldea-dulemar-neggwebur-Urʼgi be onosad.","poem":1},{"text":"A-dulega be nug-ogwasad, Abrahamʼye be onugsasad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Be, Abraham-e-gwage-ulub be daksad,","poem":1},{"text":"nue-inniki beba nanadii guo be daksad.","poem":2},{"text":"A-ulale, Abraham-ebogwa be igar-mesisad,","poem":1},{"text":"e-waganga we-yarmar ukoye be sogsad:","poem":2},{"lineBreak":true},{"text":"Canaán-dulemar-yar, Het-dulemar-yar,","poem":2},{"lineBreak":true},{"text":"Amorreo-dulemar-yar, Ferezeo-dulemar-yar,","poem":2},{"lineBreak":true},{"text":"Jebuseo-dulemar-yar, degi, Gergeseo-dulemar-yar.","poem":2},{"text":"We-yarmar, Abraham-waganga ukoye be sogsad.","poem":3},{"text":"Bab-Dummad, be-ibmar-sogsad be imaksad.","poem":1},{"text":"Ar ade, be dule-innikigwadid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"” ’Anmar-dadgan-Egipto-yargi-wilebukwa-gusadi, be daksad.","poem":1},{"text":"Demar-Ginnidye-nugad-gakaba bese binnasur gotemargu, be itosad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Be, be ibmar-gegerdaklemaladi, degi, ibmar-dakledisurmaladi Faraónʼgi be imaksad.","poem":1},{"text":"Faraón-e-dummagangi, degine, bela Egipto-yargi-dule-bukmaladgi be imaksabalid.","poem":2},{"text":"Ar ade, Egipto-dulemar be-dulamargi na-san dummarba-itogedba, gandikidgine-ibmar-imaksamalad be daksad.","poem":1},{"text":"A-ulale, emi-ibadse, be-nug dummarba gued.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Israel-dulemar-wagab, demar negabar be egasad.","poem":1},{"text":"A-demar-abargi, Israel-dulemar neg-dinnagwadgi obaksagusmalad.","poem":2},{"text":"Ar Israel-dulemar-baregindanimaladdi, dii-ulakse be egwachad,","poem":1},{"text":"igi akwa dii-ulakse egwalleddaedyob be imaksad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ibgine, mogir-bubawaryob-gwichidba be semai-gusad.","poem":1},{"text":"Mutikdi, soo-bubawaryob-gwichid-gwabunyemaidba be semai-gusad,","poem":2},{"lineBreak":true},{"text":"adi, igar-namaloedba, ega neg-mee imakegar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"” ’Sinaí-yarse be aidenonigusad,","poem":1},{"text":"Israel-dulemarga nibneg-akar be sunmaksad.","poem":2},{"text":"Igar-innikimalad, igar-napiramalad ega be uksa-gusad.","poem":1},{"text":"Igar-Mesisad, igarmar-be-anmarga-sogsad, ber nuegan-gued.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Israel-dulemarga be sogsagusad, obunnoged-iba-islidikidgi be obunnomaloye.","poem":1},{"text":"Beba-nanadiid-Moisésʼba, be igarmar-sogsadi, igarmar-be-mesisadi, degine, Igar-Maidi be uksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"” ’Madu-nibneggined Israel-dulemarga be uksad.","poem":1},{"text":"A-madugine be Israel-dulemar oimmosad.","poem":2},{"text":"E-uku-uku-itoged-osulogega, akwa-dummadgi ega be dii onosad.","poem":1},{"text":"Ega be sogsagusad, bemar yar-suegala na be a-yarse-dognamarye.","poem":2},{"text":"Ega be ise-sogar sogsagusad, an bega we-yar ukedseye,","poem":1},{"text":"a-yar ega be uksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"” ’Ar anmar-dadgandi, na san-dummarba imaksamalad.","poem":1},{"text":"Be-Igar-Mamaidba ibsassurmalad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Anmar-dadgan yapa be-ito gusmalad.","poem":1},{"text":"Degine, ibmar-dakledisulid-ega-be-imaksadi, gwen ebinsassurmalad.","poem":2},{"text":"Ar be-itossurmarsoggu, amar begi-yoledmalad.","poem":1},{"text":"Geb na e-dummad-amismalad,","poem":2},{"lineBreak":true},{"text":"adi, gannar Egiptoʼse na maiga-wiledii gunamalagar.","poem":2},{"text":"Degi-inigwele, Bab-Dummad, bedi amargi bangussulid.","poem":1},{"text":"Ar Bab-Dummad, bedi dule-wiledaked maid.","poem":2},{"text":"Bedi sabedgi igar-nudaked,","poem":1},{"text":"dule-wiledakedba sabedgi be ibmar imaked.","poem":2},{"text":"Be wissur gwae-gwae sae-itodaed.","poem":1},{"text":"Be-sabgueddi bur dummarba gued.","poem":2},{"lineBreak":true},{"text":"A-ular, be-dulamar, be iessulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"” ’Ar moli-bebe-nikad-sapingwagwad-orbiid na ega imaksagua, na sogsamalad:","poem":1},{"text":"We, anmar-bab-dummad-dake,","poem":2},{"lineBreak":true},{"text":"Egipto-yargi anmar-onosmalad-dake.","poem":2},{"text":"Anmar-dadgan begi bela-bela yolesmargua,","poem":1},{"text":"begi nue-dummad-nosmalad.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bab-Dummad, ar be-sabgued bur-dummarbasoggu,","poem":1},{"text":"nega-dulesulidgangi gwen be-dulamar be metesulid.","poem":2},{"lineBreak":true},{"text":"” ’Mogir-bubawaryob-gwichid igarba e-idumai-guega, ibginedba gwen egi aibachasulid,","poem":1},{"text":"degine, mutikidba mogir-bubawaryob-gwabunne-gwichid gwen egi aibachasurbalid,","poem":2},{"lineBreak":true},{"text":"adi, emar igar-namaloedba ega igar-mee imakegar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"” ’Bab-Dummad, Be-Burba-Nued be-dulamarga be barmialid,","poem":1},{"text":"adi, inniki amar-odurdakegar.","poem":2},{"text":"Be madu-maná ega ukmai-gusadi, gwen ega be osulossulid,","poem":1},{"text":"degine, uku-uku-itogedgi ega be dii ukmai-gusad.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Birga-dulabo (40) nega-dulesulidganba Israel-dulemar-akwedii be gusad.","poem":1},{"text":"Emarga gwen ibmarmar akussulid.","poem":2},{"text":"E-mormala gwen nungussulid.","poem":1},{"text":"Degine, e-nagmar gwen engussurbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"” ’Neggwebur-dummagan, ega be uksad,","poem":1},{"text":"dule-baigan-bukwad-yarmar ega be uksabalid.","poem":2},{"text":"Bela negmar bachik-bachik ega be uksa-gusad.","poem":1},{"text":"Hesbón-yala susagusmalad,","poem":2},{"lineBreak":true},{"text":"a-yar, Rey-Sehón-yarga gusanad.","poem":2},{"text":"Degine, Basán-yala be uksagusbalid.","poem":1},{"text":"A-yar, Rey-Og-yarga gusanad.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Israel-dulemarga mimmigan be omelos gusad.","poem":1},{"text":"Niisgwamar-nibneggi-nanaidyob, ega be omelosad.","poem":2},{"text":"Be napa ukoye, e-dadganga ise-sogar-sogsadse be amar-sesa gusad.","poem":1}]},{"type":"verse","number":24,"content":[{"text":"Geb e-mimmigan a-yalagi ubos-gusmalad,","poem":2},{"lineBreak":true},{"text":"degine, a-yala egadga gunonikid.","poem":2},{"text":"Canaán-dulemar-a-yargi-bukwamalad, be, Israel-dulemar-wagab ibgwensuli be imaksad.","poem":1},{"text":"Israel-dulemarga a-dulemar be urmaksa-gusad.","poem":2},{"text":"Amba e-reymar, degi, dulemar-a-yargi-bukwad Israel-dulemarga be urmaksa-gusad.","poem":1},{"text":"Adi, Israel-dulemar na igi we-dulemar-imakbimala, deyob imakega.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Neggweburmar-nue-sakdigar-siid susagusmalad.","poem":1},{"text":"Napa-gadi-ibmar-sanmakmalad susagusmarbalid.","poem":2},{"text":"Negmar ibmar-nuegan-ena-bukwad egadga-gunoni gusmalad.","poem":1},{"text":"Diamar-soblearbukwad, uvaʼmar-digar-nanaid, olivo-nainumar, degine, sapi-durgan akar-akarmalad, bela na egadga gunoni gusmalad.","poem":2},{"text":"Nue guchamalad, nue immediki gusmalad,","poem":1},{"text":"degi, nue wardungus gusmarbalid.","poem":2},{"lineBreak":true},{"text":"Degine, nued-egi be binsasadgi, nue-wergus gusmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"” ’Ega be ibmar-nueganbi imaksa-inigwele, degite, be-sogedba dassurmalad,","poem":1},{"text":"begi gwisgusmalad.","poem":2},{"text":"Be-Igar-Maid obacha gusmalad,","poem":1},{"text":"be-gayaburba-barsogmaladi gannar be-igarba-nanaega ega sunmaksamalanad, emide, oburgwis gusmalad.","poem":2},{"lineBreak":true},{"text":"¡Anmar-dadgan bela-belad be-nug oichosmalad!","poem":2}]},{"type":"verse","number":27,"content":[{"text":"A-ulale, e-isdarmaladga be urmakde gussunnad.","poem":1},{"text":"Amar, anmar-dadgan-nue-wiosmalad.","poem":2},{"text":"Anmar-dadgan nue wile-itobukmaladgi bese gotegusmalad.","poem":1},{"text":"Bedi nibneg-akar amar-itosad.","poem":2},{"text":"Degine, be sabgued-dummarba-nikadba, be-dulamar-wilebukwadgi-onogegala, ega be dule-barmimai gusad,","poem":1},{"text":"adi, anmar-dadgan-isdarmaladgi emar-bendakegar.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Anmar-dadgan, gales-bukwadgi ollorgunonimalale, gannar be-asabin isguddamalad.","poem":1},{"text":"Degidgine, e-isdarmaladga be urmakdedasunnad,","poem":2},{"lineBreak":true},{"text":"amarse wilebukwa guddamalad.","poem":2},{"text":"Anmar-dadgan gannar bese binnasuli gotedamalad.","poem":1},{"text":"Bedi nibneg-akar amar-itodaed.","poem":2},{"text":"Be sabgued-dummarba-nikadba,","poem":1},{"text":"an-dadgan gannar-gannar be abonomai gusad.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ega be sogsanad, be-Igar-Maidba be damarye.","poem":1},{"text":"Ar anmar-dadgandi, na san-dummarba imaksamalad.","poem":2},{"text":"Ega be-Igarmar-Uksadba gwen ibsassurmalad,","poem":1},{"text":"ar Be-Igarmar-Mamaidgi bur annadmalad.","poem":2},{"text":"Dule-be-Igar-Mamaidba-nanamaladdi, dula be imaked.","poem":1},{"text":"Anmar-babgan begi nosmalad,","poem":2},{"text":"uaya-sate-daedba be-obachamalad.","poem":1},{"text":"Binsaed-sate gusmalad, be-itobi gussurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"” ’Epennegwa, be anmar-dadgangi gwae-gwae urwedii gussulid.","poem":1},{"text":"Bedi, be-Burbaba be-gayaburba-barsogmaladga sunmaksad,","poem":2},{"text":"adi, anmar-dadganga be ibmar-sogegar.","poem":1},{"text":"Ar degite, gwen be-itossurmalad.","poem":2},{"lineBreak":true},{"text":"A-ulale, anmar-dadgan be dulemar-baigan-we-napneggi-bukmaladga be urmaksa gusad.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Degi-inigwele, ar be-sabgued dummarba-gusoggu, be anmar-dadgan-obelossulid,","poem":1},{"text":"degine, wargwen be metesurbalid,","poem":2},{"text":"Bab-Dummad, ar ade bede-sabedgi igar-nudaked,","poem":1},{"text":"nue-wile be dule-daked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"” ’Emigindi, anmar-Bab-Dummad, bedi, Bab-Dummad-bur-dummadid, bur-dutusulidid,","poem":1},{"text":"bela dulemardi, be-dobdaed.","poem":2},{"text":"Bab-Dummad, bedi, dule-napiragwadid,","poem":1},{"text":"dulemarbo be igar-mesisale, be imakedse-daed,","poem":2},{"lineBreak":true},{"text":"degine, be anmar-sabgumaiguad.","poem":2},{"text":"Bab-Dummadye, be-asabin anmar dummad-wilediid.","poem":1},{"text":"Degisoggu, anmar-reymar, anmar-saila-dummagan, anmarga-dule-irwa-bese-gormalad-wilediid, melle be baisursunna dako.","poem":2},{"text":"Degine, anmarga-be-gayaburba-barsogmalad, anmar-babgan, degi, bela be-dulamar,","poem":1},{"text":"Asiria-reymar-maigusad-akar, emi-ibadse nue-wilediidi, melle be baisursunna dako.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Bela-anmargi-ibmar-gusmaladi, igar-innikigwadba be imaksad.","poem":1},{"text":"Ar bedi dule-innikigwadba be ibmar-imaked,","poem":2},{"lineBreak":true},{"text":"ar anmardi begi nue-dummad nosmalad.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Anmar-reymar, anmar-saila-dummagan, anmar-irwa-bese-gormalad, anmar-babgan, Be-Igar-Maidba nanassurmalad.","poem":1},{"text":"Amarde, Be-Igar-Mamaid itossurmalad,","poem":2},{"lineBreak":true},{"text":"degine, iduakwaa be owisonai-gusadi gwen itossurmarbalid.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Bab-Dummadye, amar-negsemaigu, ibmar-nuegan ega be uksad.","poem":1},{"text":"Anmar-babganga be yar-dummad gadi-ibmar-sanmaked-yala be uksagu, degite, bese gochasurmalad,","poem":2},{"lineBreak":true},{"text":"degine, igar-isgana-imakdimalad gwen metesurmarbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"” ’A-ulale, emi anmar maiga-gusa-bukwamalad.","poem":1},{"text":"Anmar-dadganga be yala-uksadgi, anmar maiga-gusa-bukwamalad.","poem":2},{"text":"We-yala anmar-dadganga be uksanad,","poem":1},{"text":"e-ibmar-sanmaked-gunmalagar,","poem":2},{"lineBreak":true},{"text":"bela ibmar-agi-nikadi gunmalagar.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Emigindi, we-napagi ibmar-sanmakedde, bela reymarga uklemaid.","poem":1},{"text":"We-reymarde, anmar-dummadga be onugsanonikid.","poem":2},{"lineBreak":true},{"text":"Anmar-isgusadba we-reymar anmar-dummadga gunonikid.","poem":2},{"text":"We-reymarde, gangued nikasoggu, na e-ibmar-imakbiedba anmargi, degi, anmar-ibdurgangi imakdedamalad.","poem":1},{"text":"Emide, anmar nue-bukib itobukmarsunnad.’ ”","poem":2}]},{"type":"heading","content":["Dulemar soged, emarde Bab-Dummad-Igar-Maidba nanamaloye"]},{"type":"verse","number":38,"content":["Israel-dummagan Bab-Dummadse gotebalid: “Bela wemar-ulale, anmar ise-sogar sogbukmalad, anmarde imakedseye, degine, anmar narmakar messundo. A-ulale, anmar-saila-dummagan, anmar-Levita-dulemar, degi, anmar-irwa-bese-gormalad, we-garda-anmar-narmaksadgi anmar-dummagan-e-goo-burba omeslesundo.”"]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/NEH/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/NEH/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/NEH/8.json","previousChapterAudioLinks":{},"numberOfVerses":38}