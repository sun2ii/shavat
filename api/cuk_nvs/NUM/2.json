{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"NUM","translationId":"cuk_nvs","name":"Números","commonName":"Números","title":"NÚMEROS-GARDA NÚMEROS","order":4,"numberOfChapters":36,"sha256":"a795ffb09db2b9e1029b874e0c959951ecb1dd8e2ed0e4d9e6cfa666663744ff","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/cuk_nvs/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":2,"content":[{"type":"heading","content":["Israel-dulemar-danar-danar-ambikusmalad-igar"]},{"type":"verse","number":1,"content":["Bab-Jehová Moisésʼga, degi, Aarónʼga sunmakded, amarga sogded:"]},{"type":"verse","number":2,"content":["“Israel-dulemala dulemar-anbo-ambikued-neg-ebilis ambikumaloed, na egad-egad, e-dadgan-e-dadgan-e-bander-urba bukwa gumaloed."]},{"type":"verse","number":3,"content":["”Wemala, dulemar-anbo-ambikued-neg-siid-dad-nakwedsik ambikumaloed:",{"text":"Gebedgi, Judá-wagan, na e-bander-urba e-sordamarba ambikumaloed.","poem":1},{"text":"Judá-wagan-e-dummad Naasónʼye nugad. Naasónʼde Aminadab-e-machid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"E-sordamar ebislesmaladba,","poem":3},{"lineBreak":true},{"text":"mili-dulapaa-gakambe-gakabake gaka dulataled-ilanergwa (74,600) mergued.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"”Judá-wagan-dikarba, Isacar-wagan ambikuoed.","poem":1},{"text":"Isacar-wagan-e-dummad Natanaelʼye nugad. Natanaelʼde Zuar-e-machid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"E-sordamar ebislesmaladba,","poem":3},{"lineBreak":true},{"text":"mili-dulabo-gakambe-gakabake gaka dulataled-ilabake (54,400) mergued.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"”Baid-dikarsik Zabulón-wagan ambikumarmogoed.","poem":1},{"text":"Zabulón-wagan-e-dummad Eliabʼye nugad. Eliabʼde Helón-e-machid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"E-sordamar ebislesmaladba,","poem":3},{"lineBreak":true},{"text":"mili-dulabo-gakambe-gakagugle gaka dulataled-ilabake (57,400) mergued.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"”Bela Judá-wagan-bukwamaladgi, sordamar-sogapaa-ebislesmaladba,","poem":1},{"text":"bular mili-dulabakebak-gakanergwa gaka dulataled-ilabake (186,400) mergued.","poem":2},{"text":"Judá-wagan, na e-sordamar-nanadapmalad idunadapi gumaloed.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Rubén-wagan, na-e-bander-urba, e-sordamarba dulemar-anbo-ambikued-neg-siid-dad-nakwed-argan-nuedsik ambikumaloed.","poem":1},{"text":"Rubén-wagan-e-dummad Elisurʼye nugad. Elisurʼde Sedeur-e-machid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"E-sordamar ebislesmaladba,","poem":3},{"lineBreak":true},{"text":"mili-dulabo-gakanergwa gaka dulataled-ilatar (46,500) mergued.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"”Rubén-wagan-dikarba, Simeón-wagan ambikuoed.","poem":1},{"text":"Simeón-wagan-e-dummad Selumielʼye nugad. Selumielʼde Zurisadai-e-machid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"E-sordamar ebislesmaladba,","poem":3},{"lineBreak":true},{"text":"mili-dulabo-gakambe-gakabakebak gaka dulataled-ilapaa (59,300) mergued.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"”Baid-dikarsik Gad-wagan ambikumarmogoed.","poem":1},{"text":"Gad-wagan-e-dummad Eliasafʼye nugad. Eliasafʼde Reuel-e-machid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"E-sordamar ebislesmaladba,","poem":3},{"lineBreak":true},{"text":"mili-dulabo-gakatar gaka dulataled-ilanergwa gaka dulabo-gakambe (45,650) mergued.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"”Bela Rubén-wagan-bukwamaladgi, sordamar-sogapaa-ebislesmaladba,","poem":1},{"text":"bular mili-dulagugle-gakambe-gakagwensak gaka dulataled-ilabake gaka dulabo-gakambe (151,450) mergued.","poem":2},{"text":"Rubén-wagan, Judá-sordamar-sorba, na e-sordamar-nanaimaladba nadapi gumaloed.","poem":3}]},{"type":"verse","number":17,"content":["”Geb degine, a-sorbali, Levita-dulemar, dulemar-anbo-ambikued-neg semai gumaloed. We-negde, Israel-dulemar-negabargi siidaed. Ar igi Levita-dulemar na bukwa-daniki, deyob na e-bander-e-bander senadapi gumaloed."]},{"type":"verse","number":18,"content":[{"text":"Efraín-wagan e-bander-urba, dulemar-anbo-ambikued-neg-siid-dad-argwanedsik ambikumaloed.","poem":1},{"text":"Efraín-wagan-e-dummad Elisamaʼye nugad. Elisamaʼde Amiud-e-machid.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"E-sordamar ebislesmaladba,","poem":3},{"lineBreak":true},{"text":"mili-dulabo gaka dulataled-ilatar (40,500) mergued.","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"”Efraín-wagan-dikarba, Manasés-wagan ambikuoed.","poem":1},{"text":"Manasés-wagan-e-dummad Gamalielʼye nugad. Gamalielʼde Pedasur-e-machid.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"E-sordamar ebislesmaladba,","poem":3},{"lineBreak":true},{"text":"mili-dulagwen-gakambe-gakabo gaka dulataled-ilabo (32,200) mergued.","poem":3}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"”Baid-dikarsik Benjamín-wagan ambikumarmogoed.","poem":1},{"text":"Benjamín-wagan-e-dummad Abidánʼye nugad. Abidánʼde Gedeoni-e-machid.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"E-sordamar ebislesmaladba,","poem":3},{"lineBreak":true},{"text":"mili-dulagwen-gakambe-gakatar gaka dulataled-ilabake (35,400) mergued.","poem":3}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"”Bela Efraín-wagan-bukwamaladgi, sordamar-sogapaa-ebislesmaladba,","poem":1},{"text":"bular mili-dulatar-gakabaabak gaka dulataled (108,100) mergued.","poem":2},{"text":"Efraín-wagan, na e-sordamar-nanaimaladba danakwaa-nadapmalad-sogapaagi nadapi gumaloed.","poem":3}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"”Dan-wagan e-bander-urba, dulemar-anbo-ambikued-neg-siid-dad-nakwed-argan-sapiledsik ambikuoed.","poem":1},{"text":"Dan-wagan-e-dummad Ahiezerʼye nugad. Ahiezerʼde Amisadai-e-machid.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"E-sordamar ebislesmaladba,","poem":3},{"lineBreak":true},{"text":"mili-dulapaa-gakabo gaka dulataled-ilagugle (62,700) mergued.","poem":3}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"”Dan-wagan-dikarba, Aser-wagan ambikuoed.","poem":1},{"text":"Aser-wagan-e-dummad Pagielʼye nugad. Pagielʼde Ocrán-e-machid.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"E-sordamar ebislesmaladba,","poem":3},{"lineBreak":true},{"text":"mili-dulabo-gakagwensak gaka dulataled-ilatar (41,500) mergued.","poem":3}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"”Degine, baid-dikarsik Neftalí-wagan ambikumarmogoed.","poem":1},{"text":"Neftalí-wagan-e-dummad Ahiraʼye nugad. Ahiraʼde Enán-e-machid.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"E-sordamar ebislesmaladba,","poem":3},{"lineBreak":true},{"text":"mili-dulabo-gakambe-gakapaa gaka dulataled-ilabake (53,400) mergued.","poem":3}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"”Bela Dan-wagan-bukwamaladgi, sordamar-sogapaa-ebislesmaladba,","poem":1},{"text":"bular mili-dulagugle-gakambe-gakagugle gaka dulataled-ilanergwa (157,600) mergued.","poem":2},{"text":"Dan-wagan, napi-solaba na e-bander senadapi gumaloed.”","poem":3}]},{"type":"verse","number":32,"content":["Wemala, Israel-dulemar na e-gwenad-e-gwenadganba ebislesmaladid. Bela danar-danar-bukwamaladgi, na e-sorda-e-sordamar-ebislesmaladba, mili-dulataled-ilanergwa-gakapaa gaka dulataled-ilatar gaka dulabo-gakambe (603,550), bela mergued."]},{"type":"verse","number":33,"content":["Ar igi Bab-Jehová Moisésʼga igar-uksadba, Leví-wagandi we-Israel-dulemarba ebislessurmalad."]},{"type":"verse","number":34,"content":["Israel-dulemala bela Bab-Jehová-Moisésʼga-igar-uksadba imaksamalad. Bela na e-bander-e-bander-urba ambikusmalad, degine, na e-dadgan-e-dadganba, na e-gwenad-e-gwenadganba nadapi gusmalad."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/NUM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/NUM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/NUM/1.json","previousChapterAudioLinks":{},"numberOfVerses":34}