{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"NUM","translationId":"cuk_nvs","name":"Números","commonName":"Números","title":"NÚMEROS-GARDA NÚMEROS","order":4,"numberOfChapters":36,"sha256":"a795ffb09db2b9e1029b874e0c959951ecb1dd8e2ed0e4d9e6cfa666663744ff","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/cuk_nvs/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["Balaam dakargu, Bab-Jehová bur Israel-dulemargi-ise-nued-binsaed bur yeer-itodae, Balaam bar idualedyob Bab-Dummadbo abingunadsulid. Ilagwen-nega-dulesulidgansik atakdeguad."]},{"type":"verse","number":2,"content":["Balaam Israel-dulemar-bukwad-dakdegu, dakded, Israel-dulemar na e-dadgan-e-dadganba danar-danar bukwamala. Agine, Bab-Dummad-Burba Balaamʼgi aidenonikid."]},{"type":"verse","number":3,"content":["Geb Balaam, Bab-Jehová-ega-ibmar-sogsadba sunmakded:",{"text":"“Ani, Beor-machi-Balaam-guedi weyob soged,","poem":1},{"text":"ani, dikasur-ataked-dule-guedi weyob soged.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ani, Bab-Dummad-ibmar-soge-itosad-guedi soged,","poem":1},{"text":"Bab-Dummad-Bela-Gangued-Nikad ibmar-guoed-oyoged dakedid,","poem":2},{"lineBreak":true},{"text":"dule negoesayob an megisdaedid,","poem":2},{"lineBreak":true},{"text":"negburgan-dakdegudaedid, weyob an soged:","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"”¡Jacob-dulemar, ibibayobi be-negmar","poem":1},{"lineBreak":true},{"text":"yeerdaklege,","poem":1},{"text":"Israel-dulemar, ibibayobi be-danar-danar-bukmalad","poem":2},{"lineBreak":true},{"text":"yeerdaklege!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yala-imbaba neba-nuegan-yeerdaklegeyobi,","poem":1},{"lineBreak":true},{"text":"Israel-dulemar-danar-danar-bukwad dakleged.","poem":1},{"text":"Nainu-nuegan diwar-gakaba-naiyobi,","poem":2},{"lineBreak":true},{"text":"Israel-dulemar-bukwad dakleged.","poem":2},{"text":"Degi, Bab-Jehová bii-áloeʼye-nugad-digsadyobi","poem":1},{"lineBreak":true},{"text":"Israel-dulemar yeerdakleged.","poem":1},{"text":"Degine, sapi-urwarmar diwar-gakaba-bubukwayobi","poem":2},{"lineBreak":true},{"text":"yeerdakleged.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Israel-dulemar-e-gwidumala dii ena-ena bubukwad,","poem":1},{"text":"e-ibmar-digarmaladi dii unniguar nikad.","poem":2},{"text":"Israel-dulemar-e-rey, Rey-Agagʼba bur-dutusulid.","poem":1},{"text":"Na e-yar-ganikid bur-dummad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”Ar Bab-Dummad Egipto-yargi onosad.","poem":1},{"text":"Israel-dulemar-e-ganguedi, moli-bebe-nikad-sapurbalidyobid.","poem":2},{"text":"Israel-dulemar e-isdarmaladgi nakoed,","poem":1},{"text":"e-isdarmalad-e-garmar bela bibisgoed.","poem":2},{"lineBreak":true},{"text":"Degine, e-sigumargi e-isdarmalad-naibi-saoed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Israel-dulemar, achumigur-macheredyobi obunnomeged.","poem":1},{"text":"Achumigur-omeyobi megisdaed.","poem":2},{"lineBreak":true},{"text":"¿Wede doa ese achaoe? Gege dule ese achae.","poem":2},{"text":"¡Dulemar-begi-ise-nued-sunmakmaladi egi nued sunmaklemogoed.","poem":1},{"text":"Dulemar-be-ukabsamaladdi, ukabsalemogoed!”","poem":2}]},{"type":"verse","number":10,"content":["Geb degidgine, Balac, Balaamʼse uluded. Sae-itogedba e-argan-sarsodgu, Balaamʼga sogded: —An-isdarmalad-ukabsaega an bese gochad. Emide, wese ilapaagus egi be ise-nued sunmakdanikid."]},{"type":"verse","number":11,"content":["Emis-emis be-negse gannar be nae. An bega ibmar-nuegan ukoye sogsanad, ar Bab-Jehová ibmar-nikubisuli be-abesad."]},{"type":"verse","number":12,"content":["Balaam, Balac-abin sogded: —Ar be-dulemar-be-anse-barmismaladga iduakwaa weyob an sogsad:"]},{"type":"verse","number":13,"content":["‘Ar amba anga Balac e-neg-ena olo, degi, mani ukye sogele, gege an, an-Bab-Dummad-Jehová anga-sogsulidba an ibmar saye. Ar Bab-Jehová anga ibmar-sogedbarbi an ibmar saergebye.’"]},{"type":"verse","number":14,"content":["Degir nabir. Gannar an-negse an naed-iduale, an bega soggwelo, igi we-dulemar ibagan-danikoedgi be-imakmaloe."]},{"type":"heading","content":["Balaam irbakegi-sunmaksad"]},{"type":"verse","number":15,"content":["Geb Balaam, Bab-Jehová-ega-ibmar-sogsadba sunmakded:",{"text":"“Ani, Beor-machi-Balaam-guedi weyob soged,","poem":1},{"text":"ani, dikasur-ataked-dule-guedi weyob soged.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ani, Bab-Dummad-ibmar-soge-itosad-guedi soged,","poem":1},{"text":"Bab-Dummad-Bur-Birigined e-ibmar-wisguega an-imaksadid.","poem":2},{"lineBreak":true},{"text":"Bab-Dummad-Bela-Gangued-Nikad ibmar-guoed-oyoged dakedid,","poem":2},{"lineBreak":true},{"text":"dule negoesayob an megisdaedid,","poem":2},{"lineBreak":true},{"text":"negburgan-dakdegudaedid, weyob an soged.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yoedse-ibmar-guoed an daked, ibmar-guoedi amba dikasulid.","poem":1},{"text":"An nue-daked, degi-inigwele, itakasulid.","poem":2},{"text":"Israelʼgi rey-wargwen gwisgudagoed,","poem":1},{"text":"Jacob-wagan-abargi niisgwayobi nodagoed,","poem":2},{"text":"We-rey, Moab-uaya-matar-sagamakoed,","poem":1},{"text":"bela we-reyse Set-wagan-nono-sagamakoed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"We-rey, Edom-yala-suoed,","poem":1},{"text":"e-isdarmalad-Seir-yala ese sulebaloed.","poem":2},{"text":"Israel-dulemar bur-dule-buleganga gumaloed.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Jacob-wagangi rey-wargwen nodagoed.","poem":1},{"text":"We-rey, dulemar-neggweburgi-oburgwilessurmalad-obelogoed.”","poem":2}]},{"type":"heading","content":["Balaam napi-sunmaksad"]},{"type":"verse","number":20,"content":["Degine, Balaam Amalec-dulemarsik atakded, geb Bab-Jehová-ega-sogsadba weyob sunmakded:",{"text":"“Amalec-dulemarde dulemar-baiganba bur dutusulid,","poem":1},{"text":"degi-inigwele, obelolegoed.”","poem":2}]},{"type":"verse","number":21,"content":["Geb degi, Balaam Ceneo-dulemar-bukwadsik atakdegua, Bab-Jehová-ega-sogsadba weyob sunmakdebalid:",{"text":"“Be-neggweburde dutusulid.","poem":1},{"text":"Be-uumar akwasaila-imbaba bukwayobid.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Asiria-dulemar e-maiga-guega be-sedmaloed,","poem":1},{"text":"bemar, Ceneo-dulemar, bela girgumaloed.”","poem":2}]},{"type":"verse","number":23,"content":["Berguegala, Balaam, Bab-Jehová-ega-sogsadba weyob napi sogded:",{"text":"“¡Wilesdakle! Bab-Dummad weyob neg-imakdele, ¿doa san-onogoe?","poem":1},{"text":"Dule geg san-onoge.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Quitim-yar-demar-gakaba ur-dummagande danikoed,","poem":1},{"text":"Asiria-yala-obelogoed, degi, Heber-yala-obelogoed.","poem":2},{"lineBreak":true},{"text":"Degi-inigwele, Quitim-dulemarde bela bergumarmogoed.”","poem":2}]},{"type":"verse","number":25,"content":["Geb we-ibmar-sogsad-sorbali, Balaam e-negse gannar nade gusad. Balacʼdi e-yarse nade gusmogad."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/NUM/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/NUM/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/NUM/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}