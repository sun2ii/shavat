{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"NUM","translationId":"cuk_nvs","name":"Números","commonName":"Números","title":"NÚMEROS-GARDA NÚMEROS","order":4,"numberOfChapters":36,"sha256":"a795ffb09db2b9e1029b874e0c959951ecb1dd8e2ed0e4d9e6cfa666663744ff","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/cuk_nvs/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":26,"content":[{"type":"heading","content":["Moabʼgi-bukwa Israel-dulemar-ebislesad"]},{"type":"verse","number":1,"content":["Bukidar-Israel-dulemar-burgwismalad-sorbali, Bab-Jehová Moisésʼga, degi, Eleazarʼga sunmakded. Eleazarʼde dule-irwa-Bab-Dummadse-goled-Aarón-e-machid. Amarga weyob sogded:"]},{"type":"verse","number":2,"content":["“Israel-dulemar birga-dulagwen-nikamalad (20), degi, birga-dulagwen-obine-nikamalad (20+) sunna nabir bila-onomalad be ebismalo. Amar be na e-gwenad-e-gwenadganba ebismaloed.”"]},{"type":"verse","number":3,"content":["Moisés, dule-irwa-Bab-Dummadse-goled-Eleazarʼbogwa Jordán-diwar-naba Moab-nebagan-naidgi Jericó-neggwebur-asabin, Israel-dulemarga igar-uksamalad. Ega weyob sogsamalad:"]},{"type":"verse","number":4,"content":["“Machergan birga-dulagwen-nikamalad (20), degi, birga-dulagwen-obine-nikamalad (20+) be ebismaloye, igi-Bab-Jehová, Moisésʼga igar-uksagusa, deyob imakmaloye.” Ebichismargu, Israel-machergan Egipto-yalagi-noarmalad wemalad:"]},{"type":"verse","number":5,"content":[{"text":"Israel-machi-sailagined-Rubén, a-wagan e-dadganba-ebislesmalad, wemalad:","poem":1},{"text":"Enoc-wagan, Falú-wagan,","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hezrón-wagan, degi, Carmi-wagan.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wemala dad-dummad-Rubénʼgi danimalad.","poem":3},{"lineBreak":true},{"text":"Mili-dulabo-gakapaa gaka dulataled-ilagugle gaka dulagwen-gakambe (43,730) mergued.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Falú unnila machigwa wargwenna nikusad, Eliabʼye nugad.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Eliab-masmala, wemalad:","poem":1},{"text":"Nemuel, Datán, Abiram.","poem":2},{"text":"We-Datán, Abiram-ebogwa Israel-dulemarga binsaed-dakega gusmaladid.","poem":3},"Wemala, Coré, Moisésʼgi, Aarónʼgi, degi, Bab-Jehováʼgi gwisgusgu, Coréʼba akas-gusmalad. Wemarde Bab-Jehováʼgi gwisgusmogad."]},{"type":"verse","number":10,"content":["Degidbali napa-argadgu, Coréʼmala napa-yaba ammurud gusmarmogad. Dulemar-dulataled-ilabo gaka dulabo-gakambe (250) Coréʼba-nanaimalad soogi-gummakar burgwis gusad. Bela Coréʼba-nanaimalad burgwisgusmalad. We-ibmar-gusadi, Israel-dulemar-odurdakega deyob gusad, adi, Bab-Dummad-dobee nanamalagar."]},{"type":"verse","number":11,"content":["Coré-wagandi burgwissurmalad."]},{"type":"verse","number":12,"content":[{"text":"Dad-dummad-Simeónʼgi-danimalad-ebislesmalad wemalad:","poem":1},{"text":"Nemuel-wagan, Jamín-wagan, Jaquín-wagan,","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zera-wagan, degi, Saúl-wagan.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wemala, dad-dummad-Simeónʼgi danimalad.","poem":3},{"lineBreak":true},{"text":"Mili-dulagwen-gakabo gaka dulataled-ilabo (22,200) mergued.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Dad-dummad-Gadʼgi-danimalad-ebislesmalad wemalad:","poem":1},{"text":"Zefón-wagan, Hagui-wagan, Suni-wagan,","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ozni-wagan, Eri-wagan,","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Arod-wagan, degi, Areli-wagan.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wemala, dad-Gadʼgi danimalad.","poem":3},{"lineBreak":true},{"text":"Mili-dulabo gaka dulataled-ilatar (40,500) mergued.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Judá-masmala Canaán-yalagi mimmi-nikussuli-burgwismalad, wemalad:","poem":1},{"text":"Er, degi, Onán.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dad-dummad-Judáʼgi-danimalad-ebislesmaladi, wemalad:","poem":1},{"text":"Sela-wagan, Fares-wagan, degi, Zera-wagan.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Faresʼgi-danimaladdi, wemalad:","poem":1},{"text":"Hezrón-wagan, degi, Hamul-wagan.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bela wemala, dad-dummad-Judáʼgi danimalad.","poem":3},{"lineBreak":true},{"text":"Mili-dulapaa-gakambe-gakanergwa gaka dulataled-ilatar (76,500) mergued.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Dad-dummad-Isacarʼgi-danimalad-ebislesmalad, wemalad:","poem":1},{"text":"Tola-wagan, Fúa-wagan,","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Jasub-wagan, degi, Simrón-wagan.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bela wemala, dad-dummad-Isacarʼgi danimalad.","poem":3},{"lineBreak":true},{"text":"Mili-dulapaa-gakabake gaka dulataled-ilapaa (64,300) mergued.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Dad-dummad-Zabulónʼgi-danimalad-ebislemalad, wemalad:","poem":1},{"text":"Sered-wagan, Elón-wagan, degi, Jahleel-wagan.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bela wemala, dad-dummad-Zabulónʼgi danimalad.","poem":3},{"lineBreak":true},{"text":"Mili-dulapaa gaka dulataled-ilatar (60,500) mergued.","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Dad-dummad-Joséʼgi-danimalad-ebislesmalad, wemalad:","poem":1},{"text":"Manasés-wagan, degi, Efraín-wagan.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Manasés, wargwenna machi nikusad.","poem":1},{"text":"A-machigwade, Maquirʼye nugad.","poem":2},{"text":"Agine, Maquir-wagan danikid.","poem":3},{"text":"Maquir, wargwenna machi nikusmogad.","poem":1},{"text":"A-machigwade, Galaadʼye nugad.","poem":2},{"text":"Agine, Galaad-wagan danikid.","poem":3}]},{"type":"verse","number":30,"content":[{"text":"Dad-Galaadʼgi-danimalad-ebislesmalad, wemalad:","poem":1},{"text":"Jezer, degi, e-wagan, Helec-wagan,","poem":2}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Asriel-wagan, Siquem-wagan,","poem":2}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Semida-wagan, degi, Hefer-wagan.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Hefer-machi-Zelofehad masmala-nikussulid, unnila bunamalabi nikusad. A-bunamala-ebislesmalad, wemalad:","poem":1},{"text":"Maala, Noa, Hogla, Milca, degi, Tirsa.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Bela wemala, dad-dummad-Manasésʼgi danimalad.","poem":3},{"lineBreak":true},{"text":"Mili-dulabo-gakambe-gakabo gaka dulataled-ilagugle (52,700) mergued.","poem":3}]},{"type":"verse","number":35,"content":[{"text":"Dad-dummad-Efraínʼgi-danimalad-ebislesmalad, wemalad:","poem":1},{"text":"Sutela-wagan, Bequer-wagan, degi, Tahán-wagan.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Sutelaʼgi-danimalad, wemalad:","poem":1},{"text":"Erán-wagan.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Bela wemala, dad-dummad-Efraínʼgi danimalad.","poem":3},{"lineBreak":true},{"text":"Mili-dulagwen-gakambe-gakabo gaka dulataled-ilatar (32,500) mergued.","poem":3},"Bela wemala sogabobela, dad-dummad-Joséʼgi danimalad."]},{"type":"verse","number":38,"content":[{"text":"Dad-dummad-Benjamínʼgi-danimalad-ebislesmalad, wemalad:","poem":1},{"text":"Bela-wagan, Asbel-wagan, Ahiram-wagan,","poem":2}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Sufam-wagan, Degi, Hufam-wagan.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Belaʼgi-danimalad, wemalad:","poem":1},{"text":"Ard-wagan, degi, Naamán-wagan.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Bela wemala, dad-dummad-Benjamínʼgi danimalad.","poem":3},{"lineBreak":true},{"text":"Mili-dulabo-gakatar gaka dulataled-ilanergwa (45,600) mergued.","poem":3}]},{"type":"verse","number":42,"content":[{"text":"Dad-dummad-Danʼgi-danimalad-ebislesmalad, wemalad:","poem":1},{"text":"Súham-wagan.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Wemala, dad-dummad-Danʼgi danimalad.","poem":3},{"lineBreak":true},{"text":"Mili-dulapaa-gakabake gaka dulataled-ilabake (64,400) mergued.","poem":3}]},{"type":"verse","number":44,"content":[{"text":"Dad-dummad-Aserʼgi-danimalad-ebislesmalad, wemalad:","poem":1},{"text":"Imna-wagan, Isúi-wagan, degi, Bería-wagan.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Beríaʼgi-danimalad wemalad:","poem":1},{"text":"Heber-wagan, degi, Malquiel-wagan.","poem":2}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Dad-dummad-Aser, bunagwa wargwen nikusbalid, a-bunagwa Seraʼye nugad.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Bela wemala dad-dummad-Aserʼgi danimalad.","poem":3},{"lineBreak":true},{"text":"Mili-dulabo-gakambe-gakapaa gaka dulataled-ilabake (53,400) mergued.","poem":3}]},{"type":"verse","number":48,"content":[{"text":"Dad-dummad-Neftalíʼgi-danimalad-ebislesmalad, wemalad:","poem":1},{"text":"Jahzeel-wagan, Guni-wagan,","poem":2}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"Jezer-wagan, degi, Silem-wagan.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Wemala, Dad-dummad-Neftalíʼgi danimalad.","poem":3},{"lineBreak":true},{"text":"Mili-dulabo-gakatar gaka dulataled-ilabake (45,400) mergued.","poem":3}]},{"type":"verse","number":51,"content":["Belamakar-machergan-ebislesmaladi weyob mergued: Mili-dulataled-ilanergwa gaka gwensak gaka dulataled-ilagugle gaka dulagwen-gakambe (601,730) mergued."]},{"type":"heading","content":["Yar-mimilesokalidga igar-uklenaid"]},{"type":"verse","number":52,"content":["Bab-Jehová Moisésʼga sunmakded, ega sogded:"]},{"type":"verse","number":53,"content":["“Be dulemar-ebichismaladga, na e-dula-mergumaladba we-yarmar be mimioed."]},{"type":"verse","number":54,"content":["Na dadgan-wargwengi dulemar-bur-melu-nikale, amarga yala bur dumma be ukoed. Na dulemar-bur-ichee-nikardi, amarga yala senii be ukoed. Na emar-mergu-ebislesmaladba ega yala be ukoed."]},{"type":"verse","number":55,"content":["Degi-inigwele, wilubdakar ega yarmala be mimioed. Na e-dad-dummaganba-ebislesmaladba yarmar nikumaloed."]},{"type":"verse","number":56,"content":["Dulemar-mergumaladba ega yarmar wilub-daklear uklegoed.”"]},{"type":"heading","content":["Leví-wagan-ebislesmalad"]},{"type":"verse","number":57,"content":[{"text":"Dad-dummad-Levíʼgi-danimalad-ebislesmalad, wemalad:","poem":1},{"text":"Gersón-wagan, Coat-wagan, degi, Merari-wagan.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Dad-dummad-Leví-wagangi-danimarmogad, wemarmogad:","poem":1},{"text":"Libni-dulemar, Hebrón-dulemar, Mahli-dulemar,","poem":2},{"lineBreak":true},{"text":"Musi-dulemar, degi, Coré-dulemar.","poem":2},"Coat, machi-wargwen-Amramʼye-nugad nikusad."]},{"type":"verse","number":59,"content":["Amramʼde Leví-wagwa-Jocabedʼye-nugad nikusad. Jocabedʼde, Egipto-yalagi gwalulesad. Amram, Jocabedʼbo mimmigan warbaa nikusmalad. Amala, wemalad:",{"text":"Aarón, Moisés, degi, e-bun-María.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Aarón masmala-nikunonimogad. Amar, wemalad:","poem":1},{"text":"Nadab, Abiú,","poem":2},{"lineBreak":true},{"text":"Eleazar, degi, Itamar.","poem":2}]},{"type":"verse","number":61,"content":["Degi-inigwele, Nadab, Abiú-ebogwa Bab-Jehová-ega-igar-uksasulidba soo-isgana Bab-Jehováʼga-ogasmargu, burgwismalad."]},{"type":"verse","number":62,"content":["Wemala Dad-dummad-Levíʼgi danimalad, mili-dulagwen-gakapaa (23,000) mergued. Nii-wargwen-nikamaladse-bakar ebislesad. Wemardi, Israel-dulemar-baiganba bular ebislessulid. Ar we-dulemargardi yar uklessulid."]},{"type":"verse","number":63,"content":["We-nugmala Moisés, dule-irwa-Bab-Dummadse-goled-Eleazarʼbogwa ebichismaladid. Deunni, Jordán-diwar-naba Moab-nebagan-naidgi Jericó-neggwebur-asabin-bukwamargu ebislesad."]},{"type":"verse","number":64,"content":["Degine, Moisés, dule-irwa-Bab-Dummadse-goled-Aarónʼbogwa, Sinaí-nega-dulesulidgangi, gebe-dulemar-ebichisgusad-nugmardi wemar-ebislesmalad-imbagi naisulid."]},{"type":"verse","number":65,"content":["Ar ade, Bab-Jehová sogsagusad: We-dulemala, nega-dulesulidganba burgwemaloye. Unnila Jefone-machi-Calebʼbi, degi, Nun-machi-Josuéʼbi dula-gudii gusad. Baigandi bela burgwisad."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/NUM/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/NUM/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/NUM/25.json","previousChapterAudioLinks":{},"numberOfVerses":65}