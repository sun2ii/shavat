{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"NUM","translationId":"cuk_nvs","name":"Números","commonName":"Números","title":"NÚMEROS-GARDA NÚMEROS","order":4,"numberOfChapters":36,"sha256":"a795ffb09db2b9e1029b874e0c959951ecb1dd8e2ed0e4d9e6cfa666663744ff","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/cuk_nvs/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":7,"content":[{"type":"heading","content":["Bab-Dummadse-goled-negga ibmar-uksamalad"]},{"type":"verse","number":1,"content":["Moisés Bab-Dummadse-goled-neg-seleged-sobsad-obelosgu, ina-wawadikid a-neggi bomi-bomi imaksad. Degine, bela agi ibmarmar-bukwad Bab-Dummadga nug-imaksad. Agi, we-neg Bab-Dummadgarbi-ebulegega nug-imaksasunnad. Geb ibmar-ogumakar-ukleged-ailagi ina-wawadikid egi bomi-bomi imaksabalid, degine, bela ailagi-ibmarmar-ebulemalad Bab-Dummadga nug-imaksabalid. Agi, we-ibmar bela Bab-Dummadgarbi-ebulegega nug-imaksad."]},{"type":"verse","number":2,"content":["Geb degine, Israel-dulemar-e-dummagan, a sogleged, na e-gwenad-e-gwenadgan-e-dummaganye, amala, e-dadgan-dummaganba-dulemar-ebislesmalad-e-dummagan gumalad. Amala, Bab-Jehováʼga ibmar uknonimalad."]},{"type":"verse","number":3,"content":[{"text":"We-ibmarmar senonimalad:","poem":1},{"text":"Dummagan ebo-ebo ur-napagined-ibmar-seed-wargwen senonimalad,","poem":2},{"lineBreak":true},{"text":"degine, dummagan-iliba moli-bebe-nikad-alugwasualed-war-wargwen senonimalad.","poem":2},{"lineBreak":true},{"text":"Degisoggu, bela ur-napagined-ibmar-seed walanergwasundo (6),","poem":2},{"lineBreak":true},{"text":"degine, moli-bebe-nikad-alugwasualed warambe-gakabosundo (12).","poem":2},{"text":"We-ibmarmala, Bab-Jehováʼga-ukega Bab-Dummadse-goled-neg-sunna-selegedse senonimalad.","poem":3}]},{"type":"verse","number":4,"content":["Bab-Jehová Moisésʼga sunmakded, ega sogded:"]},{"type":"verse","number":5,"content":["“We-ibmarmar-bega-uknanaid e-abin be sue, adi, dulemar-anbo-ambikued-neggi ebulegegar. We-ibmarde Leví-wagan-baiganga, na e-ibmar-ebulegedba ega be ukoed.”"]},{"type":"verse","number":6,"content":["Geb Moisés, we-urmar, degi, moli-alugwasuarmalad sussunnad. Geb degine, Leví-wagan-baiganga uksasunnad."]},{"type":"verse","number":7,"content":["Gersón-e-waganga urmar-napagined-ibmar-seed walabo ega uksad, degine, moli-bebe-nikad-alugwasualed walabake ega uksabalid, arbagedgi-ibmar-abemaladba ebugegar."]},{"type":"verse","number":8,"content":["Merari-e-waganga urmar-napagined-ibmar-seed walabake ega uksad, degine, moli-bebe-nikad-alugwasualed walabaabak (8) uksabalid, arbagedgi ibmar-abemaladba ebugegar. We-Leví-wagan-baigande dule-irwa-Bab-Dummadse-goled-Aarón-machi-Itamar-sogedba arbananai gusmalad."]},{"type":"verse","number":9,"content":["Moisés, Coat-wagangardi we-ibmarmar uksasulid, ar ade, wemala e-gukingi ibmarmar-Bab-Dummadgadga-gusadi, semamai gumaloed."]},{"type":"heading","content":["Ibmar-ogumakar-ukleged-aila Bab-Dummadga-nugsalesad"]},{"type":"verse","number":10,"content":["Ibmar-ogumakar-ukleged-aila Bab-Dummadga nugsalesgu, we-dummagan ibmar-ogumakar-ukleged-aila-asabin, Bab-Dummadga ibmarmar uksamalad."]},{"type":"verse","number":11,"content":["Ar ade, Bab-Jehová, Moisésʼga sogsagusad: “Ibmar-ogumakleged-aila-anga-nugsalesadga-ibmar-ukegale, iba-ibagwengi dummagan-war-wargwen anga ibmar ukoed.”"]},{"type":"heading","content":["Judá-wagan-e-dummad Bab-Jehováʼga-ibmar-uksad"]},{"type":"verse","number":12,"content":["Iba-gebe-onodedgine, Aminadab-machi-Naasón-inse Bab-Jehováʼga ibmar senonikid. We-Naasónʼde, e-dad-dummad-Judáʼgi danikid."]},{"type":"verse","number":13,"content":[{"text":"Naasón Bab-Jehováʼga-ibmar-uksadi, wemalad:","poem":1},{"text":"Mani-bate-gwagwen, dulanergwa-gakambe-aidikued (130) senonikid.","poem":2},{"text":"E-aidikuedi, Bab-Dummadse-goled-neggi mani-aidikued-ebislegedyobid.","poem":3},{"text":"Degine, mani-nog-dummad, dulapaa-gakambe-aidikued (70) senonibalid.","poem":2},{"text":"E-aidikuedi, Bab-Dummadse-goled-neggi mani-aidikued-ebislegedyobid.","poem":3},{"text":"A-ibmargi, madubur-olivo-gwalluba-omukuar Bab-Dummadga-uklegedi, Bab-Dummadga-ukega senonikid.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Degine, or-wesar-dummad gagwen, mani-sibugan-gwaambe-aidikue-wilub (10) senonibalid.","poem":2},{"text":"A-or-wesargi, ina-wawadikid ena senonibalid.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Deginbali, Bab-Dummadga ibmar-ogumakar-ukega we-ibmarmar senonibalid:","poem":1},{"text":"Moli-bebe-nikad-sapingwagwad, wargwen.","poem":2},{"lineBreak":true},{"text":"Sibad-wawaad-machered, wargwen.","poem":2},{"lineBreak":true},{"text":"Sibad-wawaad-sapingwagwad-birgagwen-nikad, wargwen.","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Deginbali, e-isgued-osulogega, sibad-machered wargwen, Bab-Dummadga-ukega senonibalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Deginbali, gwenatigwar-guega, we-ibdurgan senonibalid:","poem":1},{"text":"Moli-bebe-nikad-alugwasualed, warbo.","poem":2},{"lineBreak":true},{"text":"Sibad-wawaad-machered, walatar.","poem":2},{"lineBreak":true},{"text":"Sibad-machered, walatar.","poem":2},{"lineBreak":true},{"text":"Degi, sibad-wawaad-sapingwagwad-birgagwen-nikad, walatar senonikid.","poem":2},{"text":"We-ibmarmala, Aminadab