{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"OBA","translationId":"cuk_nvs","name":"Abdías","commonName":"Abdías","title":"ABDÍAS-GARDA ABDÍAS","order":31,"numberOfChapters":1,"sha256":"037403d9cc12720291f06fad84601b5f68dce61d4b651941f16ff72ada3c5fd5","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/OBA/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/cuk_nvs/OBA/1.json","totalNumberOfVerses":21},"chapter":{"number":1,"content":[{"type":"heading","content":["Edom-yar-bergunonikid"]},{"type":"verse","number":1,"content":["Abdías-negburgan-daksad. Anmar, Bab-Jehová-e-ibmar-soged itosad. E-gayaburba-berbeged-wargwen, dulemar-yar-baid-baidgi-bukwadse barmilesad. A-dule, weyob soged: “Anmar ogusmar. Anmar we-neggweburgi bila-ononamar.” Bab-Jehová-Bela-Gangued-Nikad Edom-dulemarnik weyob soged:"]},{"type":"verse","number":2,"content":[{"text":"“Dulemar-yar-baid-baidgi-bukwamalad-abargi an bur san-bipii be-imakoed.","poem":1},{"text":"Bela dulemar isdarsunna be-dakmaloed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Na be-gwage-ulubgi be-san-dummarba-itogedi be-yardaksad,","poem":1},{"text":"Akwa-dummagan-imbaba be-siid, nibaduku be siid.","poem":2},{"text":"A-ulale, na be binsaed,","poem":1},{"text":"‘¿doa napagulluse an-egwannosunna?’ ”","poem":2}]},{"type":"verse","number":4,"content":["Bab-Jehová soged:",{"text":"“Sulubagiyob amba be matusuli gukudiile,","poem":1},{"text":"amba niisgwamar-imbaba be-uu siile,","poem":2},{"lineBreak":true},{"text":"agi-gudiidgi amba an be-egwannoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"”Ar dule-ibmar-atursaed mutikidba be-ibe ibmar atursadanikile, ¿unnila ibmar-abegedbi be-ibe sussulir be insae? Eye. Ibmar-abegedbi be-ibe susaled.","poem":1},{"text":"Ar bedi bur bule ibitogoed.","poem":2},{"text":"Ar uva-weemalad, be uva-nainuse nonikile, ¿uva-e-solamar obessulir be insae? Obesale.","poem":1},{"text":"Ar bedi bur bule ibitogoed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Esaú-e-ibmar-nuegandi, bela sulegoed.","poem":1},{"text":"Bela e-ibmar-nuegan-gargerbamalad e-ibe sulegoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bela dule-beba-nanaidi, be-yar-abingunaidse be-ononnomaloed.","poem":1},{"text":"Be-aimala be-yardakmaloed, be-dummadga gunonimaloed.","poem":2},{"text":"Dulemar-bebo-masgundimalad, begi aibinmalaga be-yardakmaloed.","poem":1},{"text":"Edom-dulemarde deyob-guoed itogosurmalad.”","poem":2}]},{"type":"verse","number":8,"content":["Bab-Jehová soged:",{"text":"“A-ibagi, Edom-dulemar-dule-binsaed-ibegan, an obelogoed,","poem":1},{"text":"Esaú-yargi dule-ibmar-wisimaladi, an obelogoed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Temán-neggwebur, be-sorda-bila-onomalad, dobedba wawanmakdemaloed.","poem":1},{"text":"Esaú-yargi bila-onolenaidgi bela dulemar burgwemaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Esaú, be be-urba-Jacob-nue-wiosadbali, be dummad-bingeguoed,","poem":1},{"text":"degisadegu be berguoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jacob-e-sorda-bila-onomalad dule-baiganse gales-selemamaigua, bedi agi, unnila dakgwichi gusad,","poem":1},{"text":"gwen be bendaksasulid.","poem":2},{"text":"Dule-baigan, Jerusalén-e-yawagakba ubomamaigua, e-ibmar-nuegan-susmalad-miminanaigua, gwen be bendaksasulid.","poem":1},{"text":"A-dulemaryob be gusmogad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Esaú, be-urba-sabsur-imaklenaigusad-ibagi, ega be allewilubsulinad.","poem":1},{"text":"Be-urba-sabsur-obingelenaigusad-ibagi, ega be allewilubsulinad.","poem":2},{"text":"Judá-dulemar-ogilolenaigusad-ibagi, be yeer-itogewilubsulinad.","poem":1},{"text":"E-suli-suli-itonaigusad-ibagi, egi be dodogewilubsulinad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Esaú, an-dulamar-sabsur-odurdaklenaigusad-ibagi,","poem":1},{"text":"e-neggwebur-yawagakba be dogewilubsulinad.","poem":2},{"text":"E-sabsur-odurdaklenaigusad-ibagi,","poem":1},{"text":"be yeerdakgwichi guewilubsulinad.","poem":2},{"text":"E-wilenanaigusad-ibagi,","poem":1},{"text":"e-ibe be ibmar-nuegan-gargerbamalad suewilubsulinad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jacob-dulemar-wakinmamaid-oburgwegala,","poem":1},{"text":"igarmar-abingunanaidgi idu be gwisguewilubsulinad.","poem":2},{"text":"E-suli-suli-itonaigusad-ibagi,","poem":1},{"text":"dule-burgwissurmalad e-isdarmaladga be urmakewilubsulinad.”","poem":2}]},{"type":"verse","number":15,"content":["Bab-Jehová soged:",{"text":"“Ar bela dulemar-sabsur-odurdaked-e-ibagan warmaksad,","poem":1},{"text":"Edom, ar igi be dule-imaksa, deyobi, be gumogoed.","poem":2},{"lineBreak":true},{"text":"Igi be dulemar-imaksagusa, emigi be bela itomogoed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Israel-dulemar, igi-bemar anse an-yar-islidikidgi sabsur-odurdaklesgusmala,","poem":1},{"text":"deyobi, dulemar-yar-baid-baidgi-bukmalad anse sabsur-odurdaklemogoed.","poem":2},{"text":"Sabsur-odurdaklegoedba bergudmaloed.","poem":1},{"text":"Dule-bukussuliyobi gumaloed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ar Sión-yargindina, dule-gwenna-gwenna san-onomaloed, amala swilidikidga gumaloed.","poem":1},{"text":"Jacob-wagan gannar e-ibmar sumaloed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Jacob-wagana, sooyobi gumaloed,","poem":1},{"text":"José-wagandi, soo-gaeyobi gumaloed.","poem":2},{"text":"Esaú-wagandina, gagan-dinnagwadyob gumaloed,","poem":1},{"text":"soogi gummakmaloed, soose bergumaloed.","poem":2},{"text":"Degisoggu, Esaú-wagan-abargine, dule-wargwensaar durguosulid.","poem":1},{"text":"Ani an Bab-Jehová deyob soged.”","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Neguevʼginmalad, Esaú-yar sumaloed.","poem":1},{"text":"Sefelaʼginmaladdi, Filistea-dulemar-yar sumaloed.","poem":2},{"text":"Israel-dulemar, Efraín-yar sumaloed,","poem":1},{"text":"Samaria-yar sumarbaloed.","poem":2},{"lineBreak":true},{"text":"Benjamín-wagan, Galaad-yar sumarmogoed.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Israel-sorda-bila-onomalad-gales-selesgusmalad Canaán-dulemar-abargi-gudimaladi,","poem":1},{"text":"Sarepta-neggweburse yar-sumaloed.","poem":2},{"text":"Jerusalén-dorgan-Sefarad-neggweburse-selesmaladdi,","poem":1},{"text":"Neguev-neggweburmar sumaloed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Israel-dulemar-galebukwa-nosmaladi,","poem":1},{"text":"Esaú-e-yar-semai-gumalaga Sión-yarse naknonimaloed.","poem":2},{"lineBreak":true},{"text":"Bab-Jehová na we-yar-dakmai guoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/OBA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JON/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/AMO/9.json","previousChapterAudioLinks":{},"numberOfVerses":21}