{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"David-machi-Salomón Israel-e-rey, we-binsaed-nuegan narmaksad:","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Adi, binsaed-nikaa guega,","poem":2},{"lineBreak":true},{"text":"igarmar-nuegan-mamaidba nanaega,","poem":2},{"lineBreak":true},{"text":"gayaburba-dummagan-mamaid mamarega,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"igar-mamaid-wisguega,","poem":2},{"lineBreak":true},{"text":"itoakwaa ibmar-imakega,","poem":2},{"lineBreak":true},{"text":"igar-innikii-mamaidba ibmar-imakega,","poem":2},{"lineBreak":true},{"text":"igar-nabolegedgi igar-maidba imakega,","poem":2},{"lineBreak":true},{"text":"emarbi-dulemar-dake nanaega.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dule-nue-ibmar-wissulid ibmar-dukuar-maid-wisi imakega,","poem":2},{"lineBreak":true},{"text":"sapingan nue-ibmar-wisi guega,","poem":2},{"lineBreak":true},{"text":"sapingan mag-neg-itoakwaa nanaegar.","poem":2},{"text":"Agala, Salomón, we-binsaed-nuegan narmaksad.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Dule-binsaed-ibedi, dule-nue-ibmar-wisidi, we-binsaed-nued itodaed,","poem":1},{"text":"adi, gatik binsaed-nikaa guega, egi durdakbaligar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Adi, binsaed-nuegan magar-itogega,","poem":1},{"text":"e-burbagan-mamaid magar-itogega,","poem":2},{"text":"dule-binsaed-nikaa-e-ibmar-soged magar itogega,","poem":1},{"text":"oegedgi-sunmakleged magar-itobaligar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Binsaed-nikaguedi, Bab-Jehová-dobee-nanaedgi danikid.","poem":1},{"text":"Dule-binsaedsurmaladi, binsaed-nikagued abesulid,","poem":2},{"lineBreak":true},{"text":"binsaed-nueganba nanabisulid.","poem":2}]},{"type":"heading","content":["Be-bab-be-unaed be itogo"]},{"type":"verse","number":8,"content":[{"text":"Machi, be-bab-be-unaed nue be itogo.","poem":1},{"text":"Be-nan-be-odurdakedba be dao.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Be-ibmar-durdaksad bega orgurginyobi ibnuedga guoed,","poem":1},{"text":"bega ordubyobi ibnuedga guoed.","poem":2}]},{"type":"heading","content":["Dule-isganamarse melle binsaed-galego"]},{"type":"verse","number":10,"content":[{"text":"Machi, dule-isganamar be-yardakbi-gualile,","poem":1},{"text":"melle ese binsaed galego.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bega sokarmalale: “Anmarba be dage.","poem":1},{"text":"Anmar dule-ibmar-oakalossulid oburgwenae.","poem":2},{"lineBreak":true},{"text":"Anmar binsa-nabir-itogedba dule-baisur-binsadiid oburgwenae.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Igi napa dule-burgwaled-doe,","poem":1},{"text":"deyob, anmar dule-neg-oakalossulid oburgwenamoga.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Anmar ibmar-nuegan ichesuli sumaloed.","poem":1},{"text":"Anmar ibmar-sumaloedi, anmar-neggi ichesuli urbemaloed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Anmarba be akae.","poem":1},{"text":"Anmar ibmar-suoedi, anmar bega ukmogoed.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Machi, melle amarba be akao,","poem":1},{"text":"amar-igar-isganagi be banguo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ar we-dule-isganamar, ibmar-isgana bur gwae imakbidamalad,","poem":1},{"text":"gwae dule-oburgwebidamalad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ar sikwimar e-wagab e-gaedsinai daksale,","poem":1},{"text":"egi gwen dogosulid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ar we-dule-isganamardi, na dukin yardakledimalad,","poem":1},{"text":"emar na dukin oburgwedimalad.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Dulemar-dogdar-maniginbi-binsamalad, deyob gunonidamalad.","poem":1},{"text":"Dulemar-dogdar-maniginbi-binsamalad, dule-baidse burgwenonidamogad.","poem":2}]},{"type":"heading","content":["Binsaed-nikaguedgi sunmaklenaid"]},{"type":"verse","number":20,"content":[{"text":"Binsaed-Nikaguedi, binnasuli galimbaba goled,","poem":1},{"text":"dulemar-bukidar-ambikued-abargi isseed sunmaked.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Binsaed-Nikaguedi, dulemar-igar-itoged-abargi sunmaked,","poem":1},{"text":"neggweburse-doged-yawagakgi sunmaked.","poem":2},"Weyob soged:"]},{"type":"verse","number":22,"content":[{"text":"“Sapingan, bemar-amba-nue-ibmar-wissurmalad,","poem":1},{"text":"¿ar sanagwadse, ibmar-wissuli be gudii gumaloe?","poem":2},{"text":"¿Ar sanagwadse, be dulemargi-dododiid, bar dulemargi dodosuli gumaloe?","poem":1},{"text":"Dule-binsaed-satemalad, bemar, ¿sanagwadse ibmar-wisigued-isdar-daked sae be dakmalode?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"¡An-ibmar-sabsur-soged be itomala!","poem":1},{"text":"An-burba-nued an bega unnitiba ukoed.","poem":2},{"lineBreak":true},{"text":"An-binsaed-wisguega an be-imakoed.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"An bese gochamar-inigwele, yapa be an-itogusmalad.","poem":1},{"text":"An bese achasmar-inigwele, gwen be amba ibsassurmalad.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Binsaed-nuegan-an-bega-uknaigusmaladi, aka be obachamalad.","poem":1},{"text":"An-sabsur-bega-ibmar-sogsadi, gwen be itossurmalad.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"A-ulale, bemar sabsur-odurdaklealile, an bemarga binnasuli alloed.","poem":1},{"text":"Bemargi dobed nagunonikile, an bemarga alloed.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Burwa-dummad-goledyob bemargi dobed nagunonikile, an bemarga alloed.","poem":1},{"text":"Burwa-ololedyobi bemargi nunmak-itoleged-dummad nagunonikile, an bemarga alloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"”A-ibagine, geb be anse gordamaloed.","poem":1},{"text":"Degi-inigwele, andi bemar-abin-imakosulid.","poem":2},{"text":"Be an-amidii gumaloenad,","poem":1},{"text":"degi-inigwele, be an-amiosurmalad.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ar bemar binsaed-nikagued abessurmalad,","poem":1},{"text":"Bab-Jehová-dobee be nanassurmalad.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"An-bemarga-binsaed-nued-uked be itossurmalad,","poem":1},{"text":"an-bemarga-sabsur-ibmar-sogsad be abessurmalad.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Na be-daed begi gannar aibinoed,","poem":1},{"text":"be dule-yardakdimaladgi, na dukin be yardaklemaloed.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Be-isgusadba, be-ibmar-wissulidba, na be dukin berguoed.","poem":1},{"text":"Be baisur-ibmar-dakedba, na be dukin oburgoed.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ar dule anba-ibsaerdi, bogidik gudii guoed.","poem":1},{"text":"Ibmar-isgana-dobsuli gudii guoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}