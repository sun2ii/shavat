{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":["Salomón-e-binsaed-nuegan-narmaklesad:",{"text":"Machi-binsaed-ibedi, e-bab-gwage-weligwar imaked.","poem":1},{"text":"Machi-binsaedsuliddina, e-nanga gwage-nunmaked-ukega gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ibmar-isganagi-mani-amilegedi, ibnuedga gusulid.","poem":1},{"text":"Ibmar-inniki-imaklegeddina, burgwedgi-san-onogega emar-imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová, dule-innikidaedi, ukudmaada-gudiguega imaksulid.","poem":1},{"text":"Dule-isgana-sulibinsa-ibmarbina-itodimaladdi obaned.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dule-wiesailamaladi, wilegega gued.","poem":1},{"text":"Dule-gadi-arbamaladdina, e-ibmar ega nasgumai gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dule-binsaed-nikadaedi, yorgine ibmar-gwag-gullemalad na onmaked.","poem":1},{"text":"Dule ibmar-gwag-weleged-e-ibagangi gabedbi-gudiiddi, we-dule, na dukin binged-amied.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bab-Dummadi, dule-innikidaedgi, nued binsaed.","poem":1},{"text":"Gaya-isgana-sunmaklegedi, unnila dule-wiogega emar-imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dule-innikidaed-e-nuggi nued sunmakledidaed.","poem":1},{"text":"Dule-isgana-e-nuggindina, bar-egi-binsalesulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dule-binsaed-ibed igar-maidba ibsaed.","poem":1},{"text":"Dule-binsaedsulidaeddi, e-sunmakedgi na dukin san-wioged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dule-nuekwa-nanadiidi, bonisuli nanadiid.","poem":1},{"text":"Dule-galagwensuli-nanadiiddina, ibagwengi e-isgued magar-daklenonikoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dule ibmar-isgana-gunaid baisur-dakedi, emarga naibid-uked.","poem":1},{"text":"Dule-binsaedsulid e-sunmakedgi na boni-amioed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dule-innikidaed-e-sunmakedi, dulega ibnuedga gued.","poem":1},{"text":"Dule-isgana-e-sunmakeddina, unnila yamo dule-ourwega sunmaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Sae-emar-dakedgi, urwed amileged.","poem":1},{"text":"Sabgueddina, isgussuliyob emar-dake imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dule-itoakwaa-gudiid-e-sunmakedgine, binsaed-nikagued amileged.","poem":1},{"text":"Dule-binsaedsulidaeddina, e-yargan-gordii gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dule-binsaed-ibegan, e-ibmar-wisigued bur bule amied.","poem":1},{"text":"Dule-binsaedsulidaeddina, e-sunmakedgi ukiagwar boni-onogedsedaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dule-mani-ibedi, manigi e-gangued siid.","poem":1},{"text":"Dule-wilegeddina, wileged ega boniga-gumogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dule-innikidaed-e-ibmar-imakedi, ega ibnuedga gued.","poem":1},{"text":"Dule-isgana-e-ibmar-imakeddina, ega ib-isganaga gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Dule igar-odurdaklegedba-ibsaele, burba-dulad-nikaa gudii gued.","poem":1},{"text":"Dule igar-odurdaklegedba-ibsasuliddina, igar-isganaba naddaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Dule-gakansaerbadi, sae-emar-daked odukued.","poem":1},{"text":"Dule-emargi-isdar-sunmakedi, binsaedsuli gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Dule-gadi-sunmaked, gege isgued sogsuli gued.","poem":1},{"text":"Dule gwabinduku-bargaed-nikaddina, we-dule, dule-binsaed-ibedid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dule-innikidaed-e-sunmakedi, mani-nuedyobid.","poem":1},{"text":"Dule-isgana-e-binsaeddina, ibnuedga gusulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Dule-innikidaed-e-sunmakedi, dulemarga binsaed-nued uked.","poem":1},{"text":"Dule-binsaedsuliddina, noar-binsaedba na dukin burgwed-amied.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Bab-Jehová-nued-emargi-binsaedi, ibmar-nuegan uked,","poem":1},{"text":"bukib-binsaed-igar egi maisulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Dule-binsaedsulidaedi, na galagwensuli-gudiidgi wergudiid.","poem":1},{"text":"Dule-binsaed-nikarbaddina, e-binsaed-nikarbadgi na wergudimogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Dule-isgana, na ibmar-dobgudiid egi aibined.","poem":1},{"text":"Dule-innikidaeddina, na ibmar-abediid ega nabir gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Dule-isgana boni-dummagan-abin gwen gwisguosulid, yog-berguar gued.","poem":1},{"text":"Dule-innikidaeddina, boni-dummagan-abin gwen-sikirmaksuli degisadeguoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Igi-ina-soled nugar-iii-imake,","poem":1},{"text":"igi waabali ibya aurmake,","poem":2},{"lineBreak":true},{"text":"deyobi, dule-wiegala e-dummadga gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Dule-Bab-Jehováʼgi-dobekwaa-nanadiidi, ibagan-suitii gudii gued.","poem":1},{"text":"Dule-isganamardina, ibagan-suitii gudii gusulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Dule-innikidaedgala, iba-nuegan ega danidaed.","poem":1},{"text":"Dule-isganagardina, iba-isganamar ega nonidaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Bab-Jehová-Igar-Maidi, dule-innikidaedga bendakleged-igar gued.","poem":1},{"text":"Dule-ibmar-isgana-imakdimaladgardina, ega boniga binyed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Dule-innikidamaladi, bonigan-abin akar-guosulid.","poem":1},{"text":"Dule-isganamardina, we-napneggi gudii guosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Dule-innikidaed-e-sunmakedi, binsaed-nika sunmaked.","poem":1},{"text":"Dule-galagwensuli-sunmakeddina, gaya-maklemaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Dule-innikidaed-e-sunmakedi, yeer-ito dule-imaked.","poem":1},{"text":"Dule-isganamardina, galagwensuli ibmar-isganagi sunmaked.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/9.json","previousChapterAudioLinks":{},"numberOfVerses":32}