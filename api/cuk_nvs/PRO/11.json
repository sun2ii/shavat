{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"Bab-Jehová nibir-innikisulid isdar daked.","poem":1},{"text":"Nibir-innikigwaddina, nued daked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"San-odummolegedgi, nug-oicholeged danikid.","poem":1},{"text":"San-bipi-imaklegedgindina, binsaed-nikagued danikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dule-innikidaedgala, e-daed e-iduedga gued.","poem":1},{"text":"Dule-isganadina, na e-isguedgi dukin boni-amied.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Igar-naboleged-ibagan-nonikile, be-ibmar-bukidar-nikadi be-bendakosurguoed.","poem":1},{"text":"Ibmar-inniki-imaklegedgindina, burgwed-igar amilesulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dule-innikidaedgala, e-ibmar-inniki-imakedi ega igar-nuegan oyoged.","poem":1},{"text":"Dule-isganadina, e-ibmar-isgana-imakdiidgi na dukin wilegoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dule-innikidamaladi, ibmar-inniki-imakedgi bendaklemalad.","poem":1},{"text":"Dule-isganamardina, sulibinsa-ibmarbina-sogedgi bipirmakmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dule-isgana-burgwidele, na ibmar-edarbediid eba-yoggudoed,","poem":1},{"text":"na e-nug-dummarba-guedgi-gabdakdiid bela eba-bergudbaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dule-innikidaedga, bonigan-noalile, akar-gusulid.","poem":1},{"text":"Dule-isganadina, boniganse ibitogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dule-isgana, e-gwabin-dukugi dule-e-neg-nabamaid wioged.","poem":1},{"text":"Dule-innikidaeddina, e-binsaed-nued-nikarbadgi na san-onoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dule-innikidaed-nasgudele, bela dulemar wergued.","poem":1},{"text":"Dule-isgana-burgwiderdina, wergued-dummad nagued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dule-innikidaedi, e-ibmar-nued-oyogedgi neggwebur-ogannoged.","poem":1},{"text":"Dule-isgana-e-gwabin-dukudina, neggwebur-wioged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dule-inniki-binsasulidi, mesagwar emar-imaked.","poem":1},{"text":"Dule-itoakwaa-binsaeddina, na e-gwabin-bargaed wisid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dule-yogasaar-sunmakedi, ibmar-soged odukusulid.","poem":1},{"text":"Dule-na-burba-bargaed-nikaddina, itoakwaa sunmaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Negseleged-igar inniki-maisulile, dulemar galagwensuli guddaed.","poem":1},{"text":"Dule-binsaed-nued-dakmaladgi neg-inniki-seleged danikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Be dule-akudaked-mani-gasad-anar, mani be bennukoye sogsale, na be dukin boni-amioed.","poem":1},{"text":"Be dule-akudaked-mani-gasad-anar, be mani bennukosurye sogsardi, be bonisuli gudii guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ome gwage-nued-nikad-oyodiile, e-nug ogannoledii guoed.","poem":1},{"text":"Dule ibmar-imakerbaddi, unnila ibmar-bukidar-nika-gudii guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Dule gwage-nued-nikad-oyodiile, ega ibmar-nuedga gued.","poem":1},{"text":"Dule-sabsurdaeddina, na dukin nunmaked amied.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Dule-isgana ibmar-isgana-imakedgi-ibmar-amied binsaledid.","poem":1},{"text":"Dule-ibmar-inniki-imakedgi-ibmar-amied, ega ibnuedga gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Dule-innikidaed, burba-dulad-nika gudiid.","poem":1},{"text":"Dule-ibmar-isganabina-sogdiiddina, burgwed-igar ega ukleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Bab-Jehová dule-gwage-isgana-nikadi, nabir-daksulid,","poem":1},{"text":"ar we-dulemar, ibmar-isganaginbi binsadimalad.","poem":2},{"lineBreak":true},{"text":"Bab-Dummad dule-inniki-gudiiddina yeerdaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Dule-isgana, amba sabsur odurdaklegedsegad.","poem":1},{"text":"Dule-innikidamaladdina, sabsur-odurdaklegosurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Olo-nued-sin-e-asugi-yoiyobi,","poem":1},{"text":"ome-yeerdakleged-binsaedsulidaed gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Dule-innikidaedi, unnila ibmar-nued-imakedbi abeged.","poem":1},{"text":"Dule-isganamar-e-ibmar-abegeddina, unnila urwedginbi binsadiid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Dule-wilub-obicha-ibmar-ukedi, aka ibmar-bukidar ega ukleged.","poem":1},{"text":"Dule, mani-ganikid gwen-bennukdisulile, dule-wilegedga gudoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Dule-wilub-obicha-ibmar-ukedi, ibmar ega nasgued.","poem":1},{"text":"Dule emar-ogannodiile, ogannoledii gumogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Dule ibmargwag-gulleged na ebi gaasa-imakele, dulemar egi isdar sunmaked.","poem":1},{"text":"Dule ibmargwag-gulleged emarga weligwaledgi manigi-ukdibe, dulemar egi nued binsaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Dule ibmar-nued-imakedi, aimar-nued amied.","poem":1},{"text":"Dule ibmar-isganabina-gudiiddi, ibmar-isgana egi aibined.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Dule e-ibmar-nikadgi-alakwaa-naidibe, we-dule galakudoed.","poem":1},{"text":"Dule-innikidaeddina, sapi-durbamakgwichidyob gudoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Dule dukin e-neguya-oichogedi, na e-neguya-obelogega imaked.","poem":1},{"text":"Dule-binsaedsulidaeddi, dule-binsaed-ibed-e-maiga gudii gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Dule-innikidaed-e-ibmar-imakedi, nued-gudii e-imaked.","poem":1},{"text":"Dule, dule-bamalad-ibmar-nued-imake-saedi, dule-binsaed-ibedid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Dule-innikidaedga, we-napneggi ibmar-nued ukleged.","poem":1},{"text":"Dule-isganamar-bulesunna, ar e-ibmar-isgana-imakdiidba we-napneggi sabsur-odurdaklemaloed.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/10.json","previousChapterAudioLinks":{},"numberOfVerses":31}