{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Dule igar-nuegan-mamaidbina-itogerbadi, binsaed-nikaguedbina nue-soged.","poem":1},{"text":"Dule igar-nuegan-mamaid-isdar-dakeddi, dule-binsaedsulidaedid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Dule-nueddaedgi Bab-Jehová nabir-binsaed.","poem":1},{"text":"Dule-galagwensuli-binsaeddi, Bab-Dummadse apor-gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dule ibmar-isgana-imakedgi gargangued amiosulid.","poem":1},{"text":"Dule-innikidaed-e-gargangueddi, gwen gigli guosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ome-innikidaedi, e-sui-nug odummoged.","poem":1},{"text":"Ome-galagwensulidaeddina, e-sui-nug oichoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dule-innikidaed-e-igarmar-amiedi, ibmar-inniki-imakedgi binsaed.","poem":1},{"text":"Dule-isgana-e-sunmakeddina, unnila emar-yardakedgi sunmaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dule-isgana-e-sunmakedi, emar-yardakar sunmaked, ablis-eogedgi sunmaked.","poem":1},{"text":"Dule-nuegan-e-sunmakeddina, dulemar egi bendakleged amied.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bab-Dummad sulibinsa dule-isganamar-imaked, degidba berguddamalad.","poem":1},{"text":"Dule-innikidaed-e-mimmigandina, gwen-berguosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dule e-binsaed-nikaguedba, e-nug odummoleged.","poem":1},{"text":"Dule-gwage-isgana-nikaddina, isdar dakleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dule-san-dummarba-imaked-masgunned-satedba,","poem":1},{"text":"bur nuedid, dule-mesagwar-gudiid wis-e-mai-ega-ibmar-imaked-nikar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dule-innikidaedi, na e-moli-nikad nued akwediid.","poem":1},{"text":"Dule-isganadina, baisur e-ibmar daked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dule-sapurba-gadi-arbaedi, mas nikagudaed.","poem":1},{"text":"Dule, dule-gegeganaba-gudiiddina, binsaedsuli gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ibmar-isganabina-surbinsa-itolegedi, dule-isganaga boniga gued.","poem":1},{"text":"Dule-innikidaeddina, sapi-nued-durbamakgwichiyob gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dule-isgana na dukin gakansaar-sunmakedgi boni-amied.","poem":1},{"text":"Dule-innikidaeddina, boniganse galakusulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dulemar-na-e-sunmakedba ibmar abingaed.","poem":1},{"text":"E-ibmar-imakedba ibmar abingabalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dule-binsaedsulidaed na e-igar inniki-maiye bidaed.","poem":1},{"text":"Dule-binsaed-nikarbaddina, unaleged-igarba ibsaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dule-binsaedsulidaedi, baisursunna uluddaed.","poem":1},{"text":"Dule-itoakwaadaeddina, egi-dule-urwed igi-barsaye sogdaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Dule-inniki-gudiid ibmar-napiragwad sunmaked,","poem":1},{"text":"dule ibmar-gusad-gakansaar-barsogeddina, unnila gakanbi-sunmaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Dule-yogasaar-sunmakedi, es-suidse-naibigulegeyob emar-imaked.","poem":1},{"text":"Dule-binsaed-nikarbad-e-sunmakeddina, ina-nuedyob gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Dule-ibmar-napiragwad-sunmakedi, sereddii megoed.","poem":1},{"text":"Dule-gakanbi-sunmakeddina, sikwas gudii guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dule-galagwensuli-binsaedi, emar-yardakedgi binsaed.","poem":1},{"text":"Dulemar-neg-bogidik-imakmaladdina, werguleged uked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Dule-innikidaedi, boniganse akar-guosulid.","poem":1},{"text":"Dule-isganamardina, boniganse ibitomaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Bab-Jehová dule-gadi-gakansamaladi, gwen-nabir daksulid.","poem":1},{"text":"Dule-inniki-gudiiddi, nued daked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Dule-binsaed-nikarbadi, ibmar-wisirba na san-imaksulid.","poem":1},{"text":"Dule-binsaed-sulidaeddina, galagwensulidaed na oyoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Dule-gadi-arbaedi, negseoedid.","poem":1},{"text":"Dule-wiegaladina, maiga gudii guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Sulibinsa-itogedi, dule-gwage wioged.","poem":1},{"text":"Gaya-nueddina, emar-weligwar imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Dule-innikidaedi, binsaed-nued emarga uked.","poem":1},{"text":"Dule-isganadina, e-isguedgi emar-oichoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Dule-wiegala masgunnedsuli gudidaed,","poem":1},{"text":"dule-arbaegaladina, ibmar-nikagu daed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ibmar-inniki-imakleged-igargi undar-dula-gudiid amileged,","poem":1},{"text":"we-igargine burgwed-igar amilesulid.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/11.json","previousChapterAudioLinks":{},"numberOfVerses":28}