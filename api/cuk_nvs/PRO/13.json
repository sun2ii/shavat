{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"Machi-binsaed-ibed, e-bab-ega-binsaed-uked nabir-itoged.","poem":1},{"text":"Machi-uayasuliddina, ega-binsaed-uked isdar-itoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Dule-inniki-sunmaked, na e-sunmakedgi ibnued amidii guoed.","poem":1},{"text":"Dule-emargi-yolemaladdina, unnila urwedginbi gudii guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dule-na-e-gwabinduku-nabir-bargaed, na dukin e-san bendakdiid.","poem":1},{"text":"Dule-na-e-gwabinduku-wissur-bargaeddina, na dukin e-san wioged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dule-wiegala, na e-ibmar-abediid gwen-abingaosulid.","poem":1},{"text":"Dule-gadi-arbaeddina, na e-ibmar-abediid abingaedsegad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dule-innikidaed gakan-igar gwen nabir-daksulid.","poem":1},{"text":"Dule-isganadina, binged-amiedid, degine, emar-wiogedid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ibmar-inniki-imakleged dule-inniki-gudiid-bendakedid.","poem":1},{"text":"Ibmar-isganadina, dule-isgudiid-wiogega imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Abar-dulemar mani-nikayob gudidamalad,","poem":1},{"text":"degi-inigwele, ibmardi gwen nikasurmalad.","poem":2},{"text":"Abar-dulemar ibmarsuliyob gudidamalad,","poem":1},{"text":"degi-inigwele, ibmardi nue-nika gudidamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dule-mani-ibed mani-nikadbali, sunna dule-isganase galesar gudiid.","poem":1},{"text":"Dule-wilegeddina, we-boni nikasulid, ar dulemar bai daksulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dule-innikidaed-e-gudiidi, gwallu-gaeyob weligwaled oyodiid.","poem":1},{"text":"Dule-isgana-gudimaladdina, negsichid-naiyob gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dule-san-dummarba-imaked emarga urwed-amied.","poem":1},{"text":"Dule-na-san-bipi-imakeddi, binsaed-nikaguedba gudiid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mani-yogasaar-amileged baisursunna-berguddaed.","poem":1},{"text":"Dule-mani-saboged-wisiddina, binnasdikii ibmar-nikumaidaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ibmar-edarbelediid-abingalesulile, gwage-nunmaked emarga uked.","poem":1},{"text":"Ibmar-edarbelediid-abingalenonikile, weligwaled anmarga uked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dule igar-soglemaid isdar-dakele, na dukin boni-amied.","poem":1},{"text":"Dule igar-soglemaidba ibsaele, ibmar-nued ega ukleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dule-binsaed-ibed-e-ibmar-odurdaked, burba-dulad emarga uked.","poem":1},{"text":"Dule-binsaed-ibed-e-ibmar-odurdaked, burgwed-igargi nabir emar-bendakbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Unaleged-igar-innikigwad-uklegedi, nabir-itole neg-imaked.","poem":1},{"text":"Dule-igar-maidba-ibsadisuliddina, boni-dummad na abgadii guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dule-itoakwaadaed, binsaed-nued-nikadgi ibmar imaked.","poem":1},{"text":"Dule-binsaed-sulidaeddina, galagwensulidaed na oyoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Dule-gayaburba-berbeged-isgana, boni emarga amied.","poem":1},{"text":"Dule-gayaburba-berbeged-nueddina, ibmar-nued emarga uked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Dule, unaleged-igar isdar-dakele, dule-wilegedga gued, e-nuggi dodolebalid.","poem":1},{"text":"Dule, unaleged-igar nabir-itogele, nug-dummarba nikuoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ibmar-abeleged-abingalesale, emar-gwage-weligwar imaked.","poem":1},{"text":"Ibmar-isganagi-banguleged, dule-binsaedsulidga gwen nabir-nosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dule, dule-binsaed-nued-nikadba akaele, binsaed-nued-nika gumogoed.","poem":1},{"text":"Dule, dule-binsaedsulidba akaele, na dukin boni-amied.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Dule-isgana, ibmar-isganase bargaledidaed.","poem":1},{"text":"Dule-innikidamaladdina, ibmar-nuegan abingaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Dule-nued-daed e-wagangala, ibmar-nuegan obeged.","poem":1},{"text":"Dule-isgana-e-ibmar-nikaddina, dule-innikidaedga obeged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Dule-wilemalad-e-nainugi, nue-ibmar sanmaked.","poem":1},{"text":"Degi-inigwele, dule-ibmar-isgana-imakedba, bela we-ibmar yoggued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Dule, e-machi-odurdaksulile, e-machi-isdar-dakeyob gued.","poem":1},{"text":"Dule, e-machi-sabele, e-machi yolenonikile, igar-maidba odurdakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Dule-innikidaed, nue-immee masgunned.","poem":1},{"text":"Dule-isganadina, amba ukudmaada gudii guoed.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/12.json","previousChapterAudioLinks":{},"numberOfVerses":25}