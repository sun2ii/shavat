{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Ome-binsaed-ibed e-neguya onasgued.","poem":1},{"text":"Ome-binsaed-sulidaeddina, na dukin e-neguya obeloged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Dule-inniki-nanadiid, Bab-Jehová-sogedba gudiid.","poem":1},{"text":"Dule-igar-isganaba-gudiiddina, isdar Bab-Dummad-dakdiid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dule-binsaedsulidaed-e-sunmaked, unnila na san-odummogedgi sunmaked.","poem":1},{"text":"Dule-binsaed-ibeddina, e-sunmakedgi bendakleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dule moli-bebe-nikad-satele, e-ob-aila binsa ollo sigoed.","poem":1},{"text":"Ar moli-bebe-nikad-e-arbaedgi masgulleged nue-amileged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dule-ibmar-gusad-barsoged-innikigwad, wissur-gakansaed.","poem":1},{"text":"Dule-ibmar-gusad-barsoged-napiragwadsuliddi, unnila gakangi sunmaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dule-galagwensulidaedi aisaar binsaed-nued nikubi gudidaenad, degi-inigwele, gwen amiosur guoed.","poem":1},{"text":"Dule-binsaed-nued-nikarbaddina, baisursunna ibmar durdaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dule-binsaedsulidaedgi be bannaba gudisae,","poem":1},{"text":"ar a-dulegi, gwen be binsaed-nued amiosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dule-itoakwaadaedi, binsaed-nued-nikadba na magar neg-itoge gudiid.","poem":1},{"text":"Dule-binsaedsulidaeddina, na e-binsaedgi yardaklediid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dule-binsaedsulidaedi, unnila isguedgi burgudiid.","poem":1},{"text":"Dule-nuedmargindina, Bab-Dummad nued-binsaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dule, na sana-walagwen e-nunmaked magar itoged.","poem":1},{"text":"E-wergued, dule-baid eba itogosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dule-isgana-e-neguya bela bergudoed.","poem":1},{"text":"Dule-innikidaed-e-neguyadina, nasgumai gudoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Imbagwenale, dule na e-ibmar-imakedi, inniki-imakye bidaed,","poem":1},{"text":"degi-inigwele, e-ibmar-imakedgine, sunna burgwed-igar amied.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Imbagwenale, alled-abalagine, gwage-nunmaked itoleged.","poem":1},{"text":"Imbagwenale, weligwar-itogedgine, nunmak itoledabalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dule-binsaedsulidaedi, na e-igar-isganagi wergudiid.","poem":1},{"text":"Dule-nued-daeddina, na ibmar-nued-imakedgi wergudimogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dule-baisur-binsaedi, baisursunna binsaed-galeged.","poem":1},{"text":"Dule-itoakwaa-binsaeddina, ibmar-imaked-iduale itoakwaa binsaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dule-binsaed-ibedi, ibmar-isgana-abin dobekwaa nanaed,","poem":1},{"text":"igar-isganagi bachikii gudidaed.","poem":2},{"text":"Dule-binsaedsulidaeddina, na san-buled imaked,","poem":1},{"text":"gwen-akar-guosurye na binsadabalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Dule-baisursunna-urwedi, galagwensuli ibmar imaked.","poem":1},{"text":"Dule-itoakwaa-binsaeddina, na san-bargaed oyoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Dule-baisur-binsaedi, unnila galagwensur-binsaleged abingaoed.","poem":1},{"text":"Dule-itoakwaa-binsaedgala binsaed-nikarbad uklegoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Dule-isganamar, dule-nued-asabin yokorgi-sindigar sigmaloed.","poem":1},{"text":"Dule-isganamar, dule-innikidamalad-e-igar-itogedgi, gan-bipigi sii gumaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dule-wilegedi, e-aimarbela isdarsunna dakdamalad.","poem":1},{"text":"Dule-mani-ibeddina, bukidar e-aimar nikad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Dule, dule-mesagwar-imakdiile, bato isgusye sogleged.","poem":1},{"text":"Dule, dule-wileged-sabgudiile, we-dulegi ise-nued binsalesad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Dule-galagwensuli-binsadiid igar-noar imaked.","poem":1},{"text":"Dule-ibmar-inniki-imakdiiddi, sabgued-igar amied, igar-innikigwad amibalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Nue-arbalegedgine, ibmar-nuegan amileged.","poem":1},{"text":"Binsa-gayaginbi-soglegeddina, wilegedga emar-imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Dule-binsaed-ibedi, e-binsaed-nikaguedgi e-nug dungued.","poem":1},{"text":"Dule-binsaedsulidaeddina, e-binsaedsulidaedgi na e-wileged amied.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Dule-ibmar-gusad-barsoged-innikigwadi, burgwedgi nue-emar-bendaked.","poem":1},{"text":"Dule-ibmar-gusad-barsoged-napiragwadsuliddi, unnila gakansaedba emar-wioged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Bab-Jehováʼgi-dobekwaa-nanalegedgine, bela-bela bendakleged siid.","poem":1},{"text":"E-mimmigana, Bab-Dummadgi bendakleged nue-amimarmogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Bab-Jehováʼgi-dobekwaa-nanalegedgine, nued-gudiguleged amileged.","poem":1},{"text":"Dule-deyob-gudiile, muis burgosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Rey-e-garganguedi e-dulemar-bukidarad-nikadba siid.","poem":1},{"text":"Dule-nuga-nikadi e-dulemar-satedba, bingesaar dakleged, agi nollomaksiid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Dule baisursunna-urwesulidi, magasar neg-itoged.","poem":1},{"text":"Dule-bargaedsuli-gudiiddina, galagwensuli-binsaed yoga-oyogar imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Dule-gwage-bogidik-nikadi, nued-gudii gued.","poem":1},{"text":"Dule-nobgueddina, bela na san-oichoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Dule-wileged-apor-imakedi, Bab-Dummadgine-yolenaid.","poem":1},{"text":"Dule-wileged-sabgudiiddina, Bab-Dummad-e-nug odummodiid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Dule-isgana e-ibmar-isgana-imakedgi boni-amied.","poem":1},{"text":"Dule-innikidaeddina, e-daedgine na san-bendaked amied.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Dule-binsaed-ibed-e-gwagegine binsaed-nikagued naid.","poem":1},{"text":"Dule-binsaedsulidaeddina, binsaed-nikagued magar-itosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Ibmar-inniki-imaklegedgi neggwebur ogannolesiid.","poem":1},{"text":"Isguedgindina, neggweburmar wiolesiid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Rey, e-mai-itoakwaa-gudiidgi, nued-binsaed oyoged.","poem":1},{"text":"Dule-e-nuggi-dododiidgardina, e-urwed oyoged.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/13.json","previousChapterAudioLinks":{},"numberOfVerses":35}