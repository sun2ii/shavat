{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"Binnalegwadgi dule-urwenaid-abin-imakedi, urweleged bargaleged.","poem":1},{"text":"Urwedgi dule-urwenaid-abin-imakeddi, urweleged baligannoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Dule-binsaed-ibed-e-sunmakedi, binsaed-nuegan uked.","poem":1},{"text":"Dule-binsaedsulidaed-e-sunmakeddina, binsaed-isgana uked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová bela negdakmaid.","poem":1},{"text":"Dule-nuedgi nakulemaid, dule-isganagi nakulemaibalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gayaburba-gwage-gadi-gadi-imakedi, ina-nuediyobid.","poem":1},{"text":"Gayaburba-isganadina, emarga gwage-naibid uked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dule-binsaedsulidaedi, e-bab-e-unaed isdarsunna itodaed.","poem":1},{"text":"Dule-e-bab-e-unaed-nabir-itogeddina, itoakwaadaed oyoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dule-innikidaed-e-neggine, ibmar-bukidar nikaguad.","poem":1},{"text":"Dule-isganadina, na e-ibmar-bukidar-amiedgine, bonigan ega noed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dule-binsaed-ibegan-e-sunmakedgi, binsaed-nuegan ainied.","poem":1},{"text":"Dule-binsaedsulidamaladdina deyob sunmaksulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová dule-isgana-ega-ibmar-ogumakar-ukedi, gwen nabir-daksulid.","poem":1},{"text":"Bab-Jehová, dule-innikidaed-ese-goledgindina, yeer itodaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bab-Jehová dule-isgana-e-daed gwen nabir-daksulid.","poem":1},{"text":"Dule-igar-inniki-imakdiiddina, nue-sabed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dule-galagwensuli-gudiidga, sabsur-odurdakleged-igar maid.","poem":1},{"text":"Dule-odurdakleged-igar-isdar-dakdiiddi, unnila oburgweleged-igar ega maid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bab-Jehováʼgi, neg-uan dukumaisulid,","poem":1},{"text":"burgwed-igar dukumaisurbalid.","poem":2},{"lineBreak":true},{"text":"Degite, ¡dule-gwage-bule-sunna!","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dule-gwen-nabir-dasulidi, dule-ese-goled isdar-itodaed,","poem":1},{"text":"degite, dule-binsaed-ibedbali, akasurbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Gwage-weligwaledi, wagargi magar dakleged.","poem":1},{"text":"Gwage-wile-itogedi, wagargi magar daklebalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dule-magar-neg-itogedi, unnila binsaed-nuedbina gudidaed.","poem":1},{"text":"Dule-binsaed-sulidaeddina, ibmar-galagwensulid na e-masgunnedyob imakdiid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dule-wile-itodiidgala, iba-nuegan gwen naisulid.","poem":1},{"text":"Dule-weligwaledgardina, bane-bane ibabi neg-naid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dule ibmar-bukidar-nikad-ular, sulibinsa-itodiidba bur nuedid,","poem":1},{"text":"dule wis-ibmar-belagwa-nika-gudiir, Bab-Jehová-dobekwaa-gudigubalir.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Isdar-itogedgi, moli-san-isesaar-gunsiidba bur nuedid,","poem":1},{"text":"sabedgi wis mas-yoaledbi gunsiir.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Dule-gadi-urwedi, emarga gadi-urwed amied.","poem":1},{"text":"Dule na san-bargaed-nikaddina, neg-bogidik imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Dule-wiegalaga neg ikoganbi gued.","poem":1},{"text":"Dule-innikidaedgardina, akwan-eogaleyob igar-maid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Machi-binsaed-ibedi, e-bab-weligwar imaked.","poem":1},{"text":"Machi-binsaedsulidaeddina, e-nan-mesagwar imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Dule-binsaedsulidaedi, e-binsaedsulidba na wergudiid.","poem":1},{"text":"Dule-magar-neg-itogeddina, na dukin e-daed-gudiid nudaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Binsaed-nuegan-satele, igarmar apurnonidaed.","poem":1},{"text":"Dule-binsaed-nuegan-bukidaradbali, neg nasguddaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ibmar-nued-soglegedi yeer-itole emar-imaked.","poem":1},{"text":"Ibmar-nued-soglegedi, e-ibagi-sogledele, bur bule nuedid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Dule-binsaed-ibedi, igar-nueganba nakwemaid.","poem":1},{"text":"Degidbali, burgwisale, odurdakleged-neg dakosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Bab-Jehová, dule-san-dummarba-imakdiid-e-neg obeloged.","poem":1},{"text":"Omegan-ei-sui-burgwismalad e-napaneg-abingunanaiddi, Bab-Jehová akar-guega imakosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Bab-Jehová, dule-isgana-e-binsaed isdarsun-daked,","poem":1},{"text":"gayaburba-nuegandi, nued itoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Dule-ibmarbina-suli-binsa-itogedi e-neguyaga boni-uked.","poem":1},{"text":"Dule manigi-binsaed-galeged-isdarsun-dakeddina, nued-gudii gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Dule-innikidaedi, emar-abin-imaksokalile, ise-binsaar imaked.","poem":1},{"text":"Dule-isganadina, e-sunmaked ibmar-isganaginbi sunmaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Bab-Jehová dule-isganamar-itosulid.","poem":1},{"text":"Dule-innikidaed-ese-goterdi, nue-itoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Dule, weligwaledba-emar-dakedi, emar-gwage-weligwar imaked.","poem":1},{"text":"Gayaburba-nuegana, emar-niga-ogannoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Dule, emar-ega-ibmar-nabir-sogedi nabir-itogele,","poem":1},{"text":"dule-binsaed-ibegan-abargi gudii guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Dule, odurdakleged-igar isdarsunna dakele, na dukin isdarsunna dakdiid.","poem":1},{"text":"Dule, odurdakleged-igar nued-abin-gaele, ibmar-nue-wisidga gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Bab-Jehováʼgi-dobekwaa-nanalegedgi binsaed-nikagued amileged, egi odurdakleged-igar-nued amilebalid.","poem":1},{"text":"Ar dule na e-nug-odummoleged-abegele, na san-bipii imakgwelergebed.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/14.json","previousChapterAudioLinks":{},"numberOfVerses":33}