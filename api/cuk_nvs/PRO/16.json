{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"Dule na e-gwagegine-soged, ibmar-imakoye,","poem":1},{"text":"degi-inigwele, ibmar-imakleged Bab-Jehováʼse bergusiid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Dule na bela-ibmar-imakedi, inniki-imakdiiye-bied,","poem":1},{"text":"degi-inigwele, Bab-Jehová sogoed, bule ibmar-inniki-imakdidibe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Be ibmar-imakbied, Bab-Jehováʼga be uke,","poem":1},{"text":"deyob be imakele, nabir bega igarga gunonikoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová-ibmar-imakedi, igar-nikaa imaked.","poem":1},{"text":"Ar dule-isganagase-bakale, odurdakleged-iba ega imaklesmogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová dule-na-san-buled-imakdiid gwen-nabir-daksulid,","poem":1},{"text":"ar we-dule sogedba-odurdaklegedsegad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Isgued-nudaklegegala, unnila sabgued-nikadba, degi, innikigwadba nudakleged.","poem":1},{"text":"Bab-Jehová-dobekwaa-gudiidgine, isguedgi banguleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová dule-e-daed nued-dakele,","poem":1},{"text":"dule-e-isdarmaladse-bakale, ebo-nued-gudii imakbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dule ibmar-isgana-imakdiidgi ibmar-bukidar-amied,","poem":1},{"text":"aba bur nuedid, dule ibmar-inniki-imakdiidba wis-belagwasaar-gudii gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dule ibmar-imakoye na sogedi,","poem":1},{"text":"Bab-Jehová-sogedba we-dulega ibmar-gumai guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ar rey-sogdibe, ibmar deyob guoye,","poem":1},{"text":"rey-igar-mesnonikidi irgwen-sogar meged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nibir-innikigwadi, nibir-e-bate-sogedbalid, Bab-Jehováʼgadid,","poem":1},{"text":"ar Bab-Dummad bela ibmar-wilubsaleged imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Rey, ibmar-isgana-imaklegedi nabir-daksulid,","poem":1},{"text":"ar e-garganguedi, unnila ibmar-inniki-imaklegedgi siid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Rey, gayaburba-innikigwad-sunmakleged yeer daked,","poem":1},{"text":"dule-napiragwad-sunmakedi, nued dakbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Rey-e-urwedi, burgwed-igar-daged obared.","poem":1},{"text":"Dule-binsaed-ibeddina, rey-e-gwage bogidik imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Rey weligwaledba-emar-dakedi, igar-nuegan-oyoged.","poem":1},{"text":"Rey-emargi-nued-binsaedi, dii-wieyob gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Or-nued-nikuedba, binsaed-nued-nikued bur-nuedid.","poem":1},{"text":"Mani-nikuedba, ibmar-nue-wisigued bur-nuedid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Dule-innikidaedi ibmar-isganaba nanadisulid.","poem":1},{"text":"Dule-deyob-gudiidi na san-burba-bendakdiid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"San-odummolegedgine, ibitoged-igar maid.","poem":1},{"text":"San-dummarba-imaklegedgine, yoleged-igar maid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Dule san-dummarba-imakdimalad-abargi ibmar-nuegan-abingaedba,","poem":1},{"text":"bur nuedid, dule-mesagwar-gudimalad-abargi wilesakwasaar-gudii gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dule gayaburba-itogedi ibmar-nuegan amied.","poem":1},{"text":"Dule Bab-Jehováʼgi bengudisulile, ise-nued egi binsalesad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Dule-binsaed-ibed-sunsogedgindi, sogleged, dule-gurgin-nued-nikadye.","poem":1},{"text":"Dule gayaburba-nuedgi-sunmaked, dule-eba-daega imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Dule-itoakwaa-ibmar-imakedi, undar-gudiguoed.","poem":1},{"text":"Dule-binsaedsulidaeddina, e-binsadiidgi na sabsur-odurdaklegoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Dule-binsaed-ibed-sunsoged, e-sunmaked nabir na bargaed.","poem":1},{"text":"E-gayaburba-sunmakedgine, ibmar-nuegan-wisguleged onisiid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Gayaburba-nuegan achanis-malegedyobi, gwage-ulubgine yeer-ito emar-imaked.","poem":1},{"text":"Gayaburba-nuegan, san-burbagala ina-nuediyob gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Imbagwenale, dule, na e-ibmar-imakedi inniki-imakye bidaed,","poem":1},{"text":"degi-inigwele, e-ibmar-imakedgine, sunna burgwed-igar amied.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Dule-arbadiid mas-gunnega arbaergebed,","poem":1},{"text":"ar e-ukumaad-itoged oarbaega-imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Dule-isgana, unnila igar-isgana-imaked amidiid.","poem":1},{"text":"E-sunmakedi, igi-soo-ibmar-ogumake, deyob emar-imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Dule-isgana, emarga urwed-amied.","poem":1},{"text":"Dule-binsa-yogasaar-ibmar-sogedi, ai-nuegan-mamaredid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Dule-gadi-urwed e-ai-yardakerbad,","poem":1},{"text":"e-ai-galagwensulidae imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Dule-ibyagi-sunmaked, ibmar-isgana-imakedgi binsadaed.","poem":1},{"text":"Dule-gaya-gunnar-imaked, ibmar-isgana bato imaksa gudiid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Dule-selebagus-nono-sipu-gudiidi, ologurgin-nikayob gudiid.","poem":1},{"text":"Ibmar-inniki-imakdiidbali, e-nug ogannolediid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Dule-na-niga-gandik-oyodiidba bur-nuedid,","poem":1},{"text":"dule-na-e-gwage-bargaed-nika gudigued.","poem":2},{"text":"Dule gandikidgi neggwebur-suedba bur nuedid,","poem":1},{"text":"dule na san-bargaed-wisi gudigued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Ibmar-imaklegegala, wilub-daklegar imakleged.","poem":1},{"text":"Degi-inigwele, ibmar-guoed, Bab-Jehováʼse bergusiid.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/15.json","previousChapterAudioLinks":{},"numberOfVerses":33}