{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"Urwed-abargi san-nued-gunsiidba","poem":1},{"text":"bur-nuedid, weligwaledgi madu-dutusulid-gunsiir.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mai-binsaed-ibedi, machi-galagwensurdaed-e-dummadga gudiguoed.","poem":1},{"text":"Mai-binsaed-ibedi, machi-galagwensurdaed-e-gwenadganba e-babgan-ega-ibmar-obesad nikumogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Olo, soogi wilubdakleged, bormo-crisolʼgi mani wilubdaklebalid.","poem":1},{"text":"Dule-e-binsaeddina, Bab-Jehováʼse wilubdaklemogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dule-isgana, dulemar-gaya-isgana-sunmakedba ibsaed.","poem":1},{"text":"Dule-gakansaegwa, dule-gaya-isgana-sogedba gudiid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dule dule-wilegedgi-dododiidi, Bab-Dummadgi dodoged.","poem":1},{"text":"Dule, dule-wileged-naibi-itodiidga-allediidi, odurdaklegedsegad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dad-e-werguedi, e-wagan-nikadgi siid.","poem":1},{"text":"Mimmigan-e-werguedi, e-babgangi simogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dule-binsaedsulidaedi, gaya-nuegan-sunmakedi egi nosulid.","poem":1},{"text":"Dule-dummagan-negsemamaid, gakansaar-sunmakedi, egi nosurmogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dule manigi-emar-binsaed-gaed-gudiidi, na binsadaed, ede, ina-nika-gudiiye.","poem":1},{"text":"Ar deyobi, yogasaar ibmar-amididaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dule, dule-egi-isgusad-egi-isgussuliyob-dakedi, ai-nikued-igar ogannoged.","poem":1},{"text":"Ar dule, dule-egi-isgusadga ibmar gannar-gannar-obarele, aimar-isdaradga imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dule-itoakwaa-binsaedga sabsur-ibmar-soglegele, irgwen-itogaled.","poem":1},{"text":"Dule-binsaedsulidaeddina, molidubgi ila-dulataledse (100) bibyolenaidibe, amba itosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dule-uayasatedaedi, gusgu urwed-amididaed.","poem":1},{"text":"Ibagwengine, dule-eba-bur-egi-obined abingunonikoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dule-binsaedsulidaed e-ibmar-imakedgi-alamakdiid-abinguedba","poem":1},{"text":"bur-baisulid, wiob-urwediid-abingued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dule, ibmar-nued-ega-imaklesad-ular, ibmar-ichakwa-ukdibe,","poem":1},{"text":"e-neguyagine, bipisaale bonigan berguosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dule, urwed-onoye-sogele, diwar-dummad-noedyobi, dummad-neg-gagaed.","poem":1},{"text":"Degisoggu, bur-nuedid urwedgi yog-banguar-imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Bab-Jehová ibmar-sogbo isdar daked:","poem":1},{"text":"Dule, dule-ibmar-oakalosad, ibmar-oakalossulidyob daked.","poem":2},{"lineBreak":true},{"text":"Dule, dule-ibmar-oakalossulid, ibmar-oakalosadyob daked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dule-binsaedsulidaedga mani-uklenonikile, ¿igi imako na itoge?","poem":1},{"text":"¿Egi binsaed-nikagued amio na itoge? Suli.","poem":2},{"lineBreak":true},{"text":"Ar edi, dule-ibmar-wissulidid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Dule, ai-guedgine, gusgu ai-sabguerbad.","poem":1},{"text":"Degisoggu, boni-dummad-ibagan-nonikile, gwenad-gargwenadyob gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Dule-itoakwaa-binsasulidi, yogasaar emarbogwa igar-mesed,","poem":1},{"text":"dule-mani-gasad-anar mani-bennukega gubalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Dule-isguedbina-itogerbadi, unnila urwedbina gudidaed.","poem":1},{"text":"Dule-san-dummarba-imakedi, na dukin boni-amidaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dule-gwage-isgana, bipisaagwale ibmar-nued amiosulid.","poem":1},{"text":"Dule-gadi-gakansaar-sunmakedi, ibmar-isgana egi aibinoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Dule, machi-binsaedsulidaed-nikale, bukib-binsaed ega uked.","poem":1},{"text":"Dule-binsaedsulidaed-e-babga-guedi, wergued egi amilesulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Dule, gwage-weligwaled-nikale, ina-nuedga gued.","poem":1},{"text":"Gwage-wile-itolegeddi, niga-obated.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Dule-isgana dukuar dule-baidse manigi binsaed galeged.","poem":1},{"text":"Agala, ibmar-galagwensuli-imakleged geg bergued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Dule-itoakwaa-binsaedi, binsaed-nued-nikuedginbi binsaed.","poem":1},{"text":"Dule-binsaedsulidaeddina, aku neg-itoged, gabdakedginbi gudiid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Dule-binsaedsulidaedi, e-bab-ourwed gudiid.","poem":1},{"text":"E-nanga, gwage-nunmaked-uked gudibalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Dule-ibmar-oakalossulid sabsur-odurdaklegele, ibnuedsulid.","poem":1},{"text":"Dule-ibmar-innikidamalad naibi-imaklegele, ibnuedsurbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Dule-magar-neg-itogedi, nabir na e-gwabinduku bargaed.","poem":1},{"text":"Dule-itoakwaa-binsaedi, nabir na san-bargamogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Dule-binsaedsulidaedi bogidik gudiile, binsaed-ibedyob daklemogad.","poem":1},{"text":"Sunmaksurbalile, dule-itoakwaa-binsaedye, egi binsalebalid.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/16.json","previousChapterAudioLinks":{},"numberOfVerses":28}