{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":[{"text":"Dule-na-eginbi-binsaedi, unnila egarbi ibmar-nued abeged,","poem":1},{"text":"dule-ega-binsaed-nued-ukeddi, abesulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Dule-binsaedsulidaedi, magar-ibmar-itoged baisur-daked,","poem":1},{"text":"unnila e-ibmar-sogedgi na san-odummodiid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ibmar-isgana-imaklegedgine, dule-sae-dakleged nononidaed.","poem":1},{"text":"Bingegulegedba-mai dule-nug-gagaleged danidaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dule-e-gayaburba, dii-wiladyob gued.","poem":1},{"text":"Diwar-iirmakemaiyob egi binsaed-nikagued ainimaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dule-ibmar-oakalosad ibmar-oakalossuliyob-imakedi, ibnuedsulid.","poem":1},{"text":"Dule-ibmar-oakalossulidga ega igar-innikigwad-imaksulile, ibnuedsurbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dule-binsaedsulidaed-e-sunmakedi, unnila neg-urwed onoged,","poem":1},{"text":"e-sunmaked emarga urwed-amied.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dule-binsaedsulidaed e-sunmakedgi na dukin san-wioged,","poem":1},{"text":"e-sunmaked na dukin egi aibinega-imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gakangi-sunmaklegedi, mas-nued-gullegeyobid.","poem":1},{"text":"Gakangi-sunmaklegedi, ulubse uboged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dule, e-arbaedgi nue-arbasulile,","poem":1},{"text":"dule-ibmar-ogiloged-e-sordaga gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bab-Jehová-e-nug, neg-matusulid-gandikid-geg-ayaredyobid.","poem":1},{"text":"Dule, bendakleged-amiegala, a-negse abarmakdedaed.","poem":2},{"lineBreak":true},{"text":"Bab-Jehová-e-nug dule-innikimaladga deyob gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Igi neggwebur-e-akwa-galu-matusulid-ebirnai,","poem":1},{"lineBreak":true},{"text":"mani-ibmalad na deyob e-ibmar-nikad egi ebirnai itoged.","poem":1},{"text":"Degisoggu, gwen akar-guosuliyob na binsamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dule, ibitoged-idu, e-daed bule-bule na san-oyoged.","poem":1},{"text":"Dule, e-nug-ogannoleged-idu, e-daed na san-bipii oyoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yogasaar gwen ibmar-itossuli-emar-abinsaele, binsaedsulidalegedid,","poem":1},{"text":"dule-emar-obingeg-saedid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dule-uelleged bonigan-itomaidgi niga-gandikgudele, gwae nugudoed.","poem":1},{"text":"Ar dule-uelleged niga-batismaile, ¿adi, igi nuguosunna?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dule-itoakwaadaed ibmar-nuegan baramied.","poem":1},{"text":"Dule-binsaed-ibed gatik ibmar-wisgued-nikuegala, nue ibmar-itodaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ibmar-binsa-uklegedba belagwable yawagakmar argaed,","poem":1},{"text":"abali, dule-dummaganse warmakleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Dule-na-e-inse-san-bendakedi, e-ibmar-sogedi, e-gussuliyob sunmaked.","poem":1},{"text":"Geb dule-baid-ebo-boni-nikadi, sorba ibmar-sognonimogale, akar egi sunmaknonimogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ibmargi-wilubdaklegar-imakleged igar-apurnaid nabir nudaked.","poem":1},{"text":"Dule-gandikidga, dule-gandikid-baidbo boni-nika-gunair, nabir ega igar-nudakbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Neggwebur-e-akwa-galu-ebiris-bukwad-earedba bur undarad, gwenad-oululesad-e-gwage gadi-gadi-imaked.","poem":1},{"text":"Neggwebur-yawagak-geg-argaedba bur undarad, gwenadgan-na-muchub-muchub-urwemalad walikaa-gudigued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dule na e-sunmakedba yeer-itodiid,","poem":1},{"text":"na e-sunmakedba immee gudiid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Sunmaklegedgine, burba-dulad maid, burgwed-igar maibalid.","poem":1},{"text":"Dule na e-sunmakedbali, e-igar abingaoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Dule ome-nikunonikile, ibnued nikued.","poem":1},{"text":"Bab-Jehová-egi-nued-binsaed ega oyoleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Dule-wileged wilesakwaa ibmar egised.","poem":1},{"text":"Dule-mani-ibeddina, sabsur dule-abin-imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Dule, aimar-nikale, aigwar guergebed.","poem":1},{"text":"Abar-aimar nikad, gwenad-gargwenadba bur bule walikaa daed.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}