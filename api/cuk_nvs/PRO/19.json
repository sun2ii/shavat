{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"Dule-emargi-gakansaar-sunmakedba,","poem":1},{"text":"bur nuedid, dule-wileged inniki-nanadii gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Itoakwaa ibmar-imaksulidi, nuedsulid.","poem":1},{"text":"Dule gwae-gwae-ibmar-imakedi, gadi noar-ibmar-imakdaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dule-binsaedsulidaedi, e-binsaedsulidba yogasaar nanaddaed.","poem":1},{"text":"Geb sogdedaed: “An-akargusadi, Bab-Jehováʼginye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dule, ibmar-nuegan-nikadba bukidar aimar-nikuega gued.","poem":1},{"text":"Ar dule-wilegeddi, na e-aise-bakale, egi bangued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dule-ibmar-daksad-gakansaar-sogedi, sabsur-odurdaklegosuli guosulid.","poem":1},{"text":"Dule-gakansili na gwen san-onogosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dulemar-bukidar, dule-obinebak-ibmar-uked-e-aiga-guega amimalad.","poem":1},{"text":"Bela dulemar, dule-ibmar-binsa-uked-e-aiga gumalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ar bela dule-wileged-e-gwenadgan, dule-wileged-isdar-dakele, e-aimar-bursunna, bur bule isdar dakoed.","poem":1},{"text":"Dule-wilegedi, na e-bendakega e-aimar-amidiguo-inigwele, bipisaar amiosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dule ibmar-magar-itoged-amiedi, na e-san sabed.","poem":1},{"text":"Na ibmar-durdaksad imakele, ibmar-nued amioed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dule-ibmar-daksad-gakansaar-sogedi, sabsur-odurdaklegosuli guosulid.","poem":1},{"text":"Dule-gakansaar-sunmakedi, na burgwed-amioed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dule-binsaedsulidaedi, ibmar-mani-gargerbad-nikuedi, egi nosulid.","poem":1},{"text":"Dule-maiga-gudiid-bursunna, bur bule dule-dummagan-e-dummadga-guedi egi nosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dule-binsaed-nikadaedi, na urwed wisi bargaed.","poem":1},{"text":"Dule-egi-nosad-egi-nossuliyob-dakeddi, e-nug dummarbaa imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Rey-urwedi, achumigur-nono-wawaad-uurmakedyob gued.","poem":1},{"text":"Ar rey-e-nued-binsaeddi, gagangi boo-bateyobi neg-imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Machi-binsaedsulidaedi, na e-bab-wile-itogega imaked.","poem":1},{"text":"Ome-e-ulus-ulusdaedi, dii-yakedyob gued, binna-binna sui-wioged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Nega, degi, ibmar-nuegan, babgan uked.","poem":1},{"text":"Ome-binsaed-nikadaeddi, Bab-Jehová uked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Wieguedi, dulega gabed-uked.","poem":1},{"text":"Dule-wiegala ukudmaada gudii guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dule-Bab-Dummad-Igar-Maidba-ibsaedi, dukin san-bendaked.","poem":1},{"text":"Dule-Bab-Jehová-Igar-Mesisad-isdar-dakeddi, burgoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Dule-wilegedga-ibmar-ukedi, Bab-Jehováʼga-ibmar-uknaiyob gued.","poem":1},{"text":"Bab-Jehová dule-ibmar-uksadga gannar ibmar uked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Be-machi nued-nanaegala, bipigwadgi be unao.","poem":1},{"text":"Be sabsur-odurdakalile, melle oburgwedse be imako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Dule-gadi-urwedi, sabsur-odurdaklegoed.","poem":1},{"text":"E-urwed-bargaega egi binsa alamakleged, aka bur bule uluddaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Bega-binsaed-uklegedi, be itoge.","poem":1},{"text":"Be-unaedi mer be isdar-itoge, ar dule-binsaed-ibedga be guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Dule ibmar-imakega bukidar igar-amied,","poem":1},{"text":"degi-inigwele, Bab-Jehová-ibmar-imakbiedbi imakleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Dule emar-innikii-eba-daed abeged.","poem":1},{"text":"Dule-gakansiliba, bur nuedid, dule-wilegedga-gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Bab-Jehová-dobekwaa-nanaedi, dula-gudii dule-imaked.","poem":1},{"text":"Bogidik-gudii dule-imaked,","poem":2},{"lineBreak":true},{"text":"mer-bonigan-nikuega dule-imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Dule-wiegala mas-gunnega bateyagi e-argan ododaenad,","poem":1},{"text":"degi-inigwele, wiedba e-gayaba mas odosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Dule-binsaedsulidaedi, unnila sabsur-odurdakedgi ibmar-durdaked.","poem":1},{"text":"Dule-binsaed-nikagueddi, na ibmar-durdakega irgwen-ounaed abeged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Dule e-bab-ibe-ibmar-atursaedi, neggi e-nan-ononnobalidi,","poem":1},{"text":"a-dule, machi-isganad, dule-binged-satedid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Machi, dule-be-unaed be itosulile,","poem":1},{"text":"binsaed-nikaguedgi be bangudoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Dule-ibmar-daksad-gakansaar-soged igar-nabolenaidgi dodoged.","poem":1},{"text":"Dule-isgana ibmar-isganaginbi sunmaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Dule-emargi-dododimaladga sabsur-odurdakleged-igar guagwar maid.","poem":1},{"text":"Dule-binsaedsulidaedga bibyoleged-igar guagwar maimogad.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}