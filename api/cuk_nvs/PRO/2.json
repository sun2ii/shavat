{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":2,"content":[{"type":"heading","content":["Binsaed-nikagued-amileged ibnuedid"]},{"type":"verse","number":1,"content":[{"text":"Machi, an ibmar-bega-soged be itogele,","poem":1},{"text":"an-igar-maidba be nanaele,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"binsaed-nikaguedba be ibsaele,","poem":1},{"text":"be-ulubgi bela-bela ise-itoagwar be ibmar imakele,","poem":2},{"text":"geb be Bab-Jehováʼba-ibsaleged magar be itononikoed,","poem":1},{"text":"magar be Bab-Dummad daknonikoed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Machi, nue-ibmar-wisigued be egisele,","poem":1},{"text":"magar-ibmar-itoged be egisele,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"binsaed-nikagued maniyob be e-bina-sogdiile,","poem":1},{"text":"or-nuegan-dukuar-bukwadyob be amiele,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"geb be Bab-Jehováʼba-ibsaleged magar be itononikoed,","poem":1},{"text":"magar be Bab-Dummad daknonikoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ar Bab-Jehováʼbi binsaed-nikagued uked,","poem":1},{"text":"Bab-Dummadbi nue-ibmar-wisi be-imaked.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová dule-ibmar-innikii-imakmaladga binsaed-nikagued uked.","poem":1},{"text":"Bab-Jehová amar-bendakdaed,","poem":2},{"lineBreak":true},{"text":"amarba gudidaed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová dule-igar-maidba-ibmar-imakmalad nue-dakdidaed,","poem":1},{"text":"Bab-Jehová dule-eba-nanadimalad edarbedidaed.","poem":2}]},{"type":"heading","content":["Igar-inniki-imakleged-wisguleged"]},{"type":"verse","number":9,"content":[{"text":"Geb agine, igar-inniki-mamaidba-imakleged,","poem":1},{"text":"igar-nabolegedgi-igar-maidba-imakleged,","poem":2},{"text":"emarbi-dulemar-dakleged,","poem":1},{"text":"magar-itoge be guoed, wede ibi-obare.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Binsaed-nikagued be-ulubgi nagunonikile,","poem":1},{"text":"nue-ibmar-wisidi, yeer-itoge be-imakoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Itoakwaadaedi be-bendakoed,","poem":1},{"text":"nue-ibmar-wisiguedi be-bendakbaloed.","poem":2}]},{"type":"heading","content":["Dulemar-isganagi-bangued"]},{"type":"verse","number":12,"content":[{"text":"Binsaed-nikagued, igar-isganaba-nanaega be-imakosulid,","poem":1},{"text":"dulemar-sunnasur-sunmakmaladgi be-ollor-imakoed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dulemar-igar-isganaba-bur-nanaega, igar-nuedgi-banguddamaladgi,","poem":1},{"text":"binsaed-nikaguedi, be-ollor-imakoed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dulemar-ibmar-isgana-saedgi-wergumaladgi, ibmar-isgana-imakedba iba-onodamaladgi,","poem":1},{"text":"binsaed-nikaguedi, be-ollor-imakoed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Dulemar-igar-noar-noar-gudidamaladgi, igarmar-innikisulidba-gudidamaladgi,","poem":1},{"text":"binsaed-nikaguedi, be ollor-imakoed.","poem":2}]},{"type":"heading","content":["Dule-baid-e-omegi-bangued"]},{"type":"verse","number":16,"content":[{"text":"Machi, binsaed-nikaguedi, dule-baid-e-omegi be-ollor-imakoed.","poem":1},{"text":"Binsaed-nikaguedi, ome-agumakedba-emar-binsaed-gaedgi, be-ollor-imakoed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"A-ome, Bab-Dummad-asabin na abirgunagwar-gued-igar-mesisad ieded,","poem":1},{"text":"degidbali, na e-suigi bar binsassulid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"A-ome-negse naye be sogele,","poem":1},{"text":"burgwed-igarse be-sedoed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Dule a-omese-gochale, bar gannarse guosulid,","poem":1},{"text":"bar gannaryob nued-gudii guosulid.","poem":2}]},{"type":"heading","content":["Nued-gudigued, degi, sabsur-odurdakleged"]},{"type":"verse","number":20,"content":[{"text":"Machi, deyobi, dule-nued-nanadimalad-igarba be nanaoed,","poem":1},{"text":"igar-innikigwadbi be imakdii guoed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ar dule-igar-maidba-ibmar-imakmaladi we-napneggi gudii gumaloed.","poem":1},{"text":"Dule-egi-ibmar-akar-soged-satemaladi, we-napneggi undar-suitii gudii gumaloed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Dule-isganamardi we-napneggi bergumaloed,","poem":1},{"text":"dule-ichomaladdi oburgwilemaloed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}