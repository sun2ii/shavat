{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"Inna-gagbidi, bingedsuli dule-imaked.","poem":1},{"text":"Sisa neg-gagaega dule-imaked.","poem":2},{"lineBreak":true},{"text":"Dule, wemar-gobsale, binsaedsuli naddaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Rey-urwedi, achumigur-nono-wawaad-uurmakedyob gued.","poem":1},{"text":"Dule rey-ourwega-imakedi, na dukin boni amied.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dule-e-urwedgi-banguedi, bur nug-dummarba gued.","poem":1},{"text":"Dule-binsaedsulidaeddi, urwed-amied.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dule-wiegala yorgi neg imaksulid,","poem":1},{"text":"ibmar-gwag-weleged-ibagangi ibmar-gwag weosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dule-binsaedi, dii-wiladyob gued,","poem":1},{"text":"dule-ibmar-nue-wisiddi irgwensuli dule-binsaed-baramied.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dule-bukidar sogdamalad, ede dule-nuedye.","poem":1},{"text":"Degi-inigwele, dule-inniki-ibmar-sogeddi, ¿doa amioe?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dule-nuedi, innikigwadba nanaed.","poem":1},{"text":"E-mimmigan e-bab-nanaedba-nanadimarmogadi, egi ise-nued binsalesad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ar rey igar-nabogega e-ologanagi sigisale,","poem":1},{"text":"unnila e-atakedgi bela ibmar-isgana baramied.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dule geg soged: “Andi gwage swilidik-nikaye,","poem":1},{"text":"andi isgued sateye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bab-Jehová ibmar-sogbogwad nabir daksulid:","poem":1},{"text":"Nibir-noaled, wilubsaed-noaled.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Machigwa e-ibmar-imakedba magar dakleged,","poem":1},{"text":"e-daed innikigwadid, degi, nuedbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bab-Jehová ibmar-sogbo yeerdakle obinnisad:","poem":1},{"text":"Uaya, ibmar-itogegar.","poem":2},{"lineBreak":true},{"text":"Ibya, ibmar-dakegar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mer be dule-wilegedga-guega, mer be gabedginbi binsae.","poem":1},{"text":"Bur be arbaedginbi binsae,","poem":2},{"lineBreak":true},{"text":"adi, mas obinebaka be nikuoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dule-ibmar-bakedi, yamo sogdedaed: “¡Wedi nuedsuli! ¡Wedi ibmar-isgana!”","poem":1},{"text":"Ar we-ibmar-baksad-sorbardi, weligwar itodaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"We-napneggi, ormar-nika-inigwele, akwa-nuegan-nika-inigwele,","poem":1},{"text":"dule-binsaed-ibed-e-sunmakeddi, we-ibmarmarba bur nuedid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dule-akudaked-anar dule-mani-bennukoye-sogsad-ibe, ibmar-nued be sue.","poem":1},{"text":"Mani-bennukegala, dule-e-ibmar-nued be gae.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Dule, emar-yardakedgi masgunned-amiedi yeer-itoged,","poem":1},{"text":"degi-inigwele, a-masgunnedi durgan-gunneyob gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Igarmar-nuegan-amilegedi, binsaed-nued-dakedba amileged.","poem":1},{"text":"Bila-onolegegala, igar-nikaa imaklegergebed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Dule-galagwensuli-sunmakedi, ibmar odukusulid.","poem":1},{"text":"Degisoggu, dulemar-gadi-galagwensuli-sunmakmaladba mer be akae.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dule e-bab-ukabsaele, e-nan-ukabsaele,","poem":1},{"text":"nuchukwaa burgoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Gebegi ibmar-irgwensursunna-nikulegedgi,","poem":1},{"text":"be yeer itogosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Mer be sogo, an buged-mai imakoye.","poem":1},{"text":"Mer be Bab-Jehováʼgi bensuli gue,","poem":2},{"lineBreak":true},{"text":"ar e be-bendakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Bab-Jehová nibirmar-noaled isdar-daked,","poem":1},{"text":"ibmar-wilubdaked-noaled abesulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Bab-Jehová, dule-iduega gued.","poem":1},{"text":"Degisoggu, dule na yoedse igi-guoed wissulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Nue-binsassuli Bab-Dummadga-ibmar-imakoye-soged bonidar-dummadid.","poem":1},{"text":"Geb sogsad-sorba, binsadele, an ibiga deyob sogsadibeye.","poem":2},{"lineBreak":true},{"text":"Deyob-binsaedi, bonidar-dummadid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Rey-binsaed-ibedi, dule-isganamar-oaisakied.","poem":1},{"text":"Ob-ubigwar-imaklegeyob ese ubigwar gumalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Dule-burba, Bab-Jehová-anmarga-uksadi, bela gwage-ulubse binsaed-baramied.","poem":1},{"text":"Ar a-burba, gwallu-meegwadyob dulega uksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Wile-dule-daklegedi, degi, napiragwadgi-ibmar-soglegedi, rey-bendakega gued.","poem":1},{"text":"Rey-e-negdakmaidi, wile-dule-daklegedgi gangumaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Sapingan-e-werguedi, e-garganguedgi siid.","poem":1},{"text":"Sergan-e-werguedi, e-ibmar-wisidgi simogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Bibyolegedgi, degi, naibisalegedgi, dule-isgana nudakleged.","poem":1},{"text":"Sabsur-imaklegedgi, galagwensur-binsaleged nudakleged.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/19.json","previousChapterAudioLinks":{},"numberOfVerses":30}