{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼgi, rey-e-binsaed diwar-iirmakmaiyob gued.","poem":1},{"text":"Deyobi, rey, Bab-Dummad-ibmar-abegedba ibmar-imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Dule na war-wargwengi e-ibmar-imaked nueganbi-imakye binsaed.","poem":1},{"text":"Ar Bab-Jehováʼdi, dule-ibiga-ibmar-imakbied, bato wisid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bab-Dummad ibdurgan-ogumakar-ukedba, bur nued-daked,","poem":1},{"text":"igar-inniki-imakleged, degi, innikigwadba-ibmar-imakleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Emar-ibgwensur-dakedi, san-dummarba-imakedi, dule-isganamar-e-binsaedi,","poem":1},{"text":"bela wemar isgumaladid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nue-itoakwaa-igarmar-amilegedi, ibmar-nuedga gued.","poem":1},{"text":"Gwae-gwae-igar-amilegeddi, ibmar-nuedga gusulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Gakansaedgi ibmar-nuegan-ichesur-nikuedi, booyob berguddaed,","poem":1},{"text":"dule-oburgwega gubalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dule-isganamar, dukin e-sabsur-ibmar-imakedse berguoed.","poem":1},{"text":"Ar igar-inniki-imaklegedi, imakbisurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dule-isgana-e-daedi, innikisulid, boni-nikad.","poem":1},{"text":"Dule-nued-daeddi, innikigwadid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Neg-dummadgi ome-gadi-urwedbo-gudisaedba,","poem":1},{"text":"bur nuedid, neg-bipigwadgi-gudisaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dule-isgana unnila ibmar-isganaginbi binsaed.","poem":1},{"text":"Ar bipisaale, wile dule-bamalad-daksulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dule-ibmar-nue-wissulid, dule-emargi-dododiid-sabsur-odurdaklegedgi ibmar durdaked.","poem":1},{"text":"Dule-binsaed-nikagued ibmargi-odurdaklegele, dule-ibmar-nue-wissulidi ibmar durdaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dule-nued, dule-isgana-e-neg dakdedaed,","poem":1},{"text":"igi dule-isgana e-ibmar-nikadi berguddae.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dule, dule-wileged-e-ibmar-egised itosulile,","poem":1},{"text":"na ibmar-egichiarmogar, dulemar e-itogosurmarmogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ibmar-binsa-uklegedi dulemar-wagab-uksulidi, sae-itoged boo imaked.","poem":1},{"text":"Ibmarbina-sogdiidgi a-ibmar bega-uklenonikile, sabsur-urwed boo imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Igar-innikigwad-imaklesale, dule-nued na yeer-itodaed.","poem":1},{"text":"Dule-isganagardi, dobed nagunonidaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dule, itoakwaa nanadisulile,","poem":1},{"text":"burgwarmai dakledagoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Dule, galagwensuli-gudiguedginbi-binsaedi, dule-wilegedga guoed.","poem":1},{"text":"Dule, mummudbi-gaamakdiidi, degi, ina-wawadginbi-mani-oediidi, bipisaale, mani-ibedga gwen guosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Dule-isgana, dule-nued-anar sabsur-odurdaklegoed.","poem":1},{"text":"Dule-emargi-aibined dule-inniki-nanadiid-anar, sabsur-odurdaklegoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ome-gadi-urwed-nikuedba, ome-gadi-isdar-itoged-nikuedba,","poem":1},{"text":"bur nuedid, ome-sate walagwen-gudisaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dule-binsaed-nikagued-e-neggi ibmar-nuegan obinebaka nikad,","poem":1},{"lineBreak":true},{"text":"ina-wawadikmalad obinebaka nikabalid.","poem":1},{"text":"Dule-binsaedsulidaeddi, bela ibmar-nikad binsa diiga imakdaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Dule, igar-inniki-imakleged-amidiile, wile-dule-dakleged-amidibalile, san-dula-gudiguleged amied.","poem":1},{"text":"Igar-inniki-imakleged amied.","poem":2},{"lineBreak":true},{"text":"Nug-dummarba-guleged amibalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Dule-binsaed-ibed dulemar-gandikmalad-ibe neggwebur sued.","poem":1},{"text":"Dule-binsaed-ibed dule-gandikmalad-e-ibmargi-bensuli-gudiid-ibe e-ibmar obelobalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Dule na itoakwaa-sunmaked, e-gwabinduku-bargabalid,","poem":1},{"text":"bonigangi ollorgued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Dule-na-doggus-san-buled-imakedi, dule-na-san-dummarba-imakedi, dule-emar-mesagwar-imakedi, weyob egi sogleged,","poem":1},{"text":"wilub-obicha sabsur-isdar-nanadiidye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Dule-wiegala bela ibmar nikubienad,","poem":1},{"text":"degi-inigwele, budar arbaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Dule-wiegala, dule-baid-ibe ibmar-abedii osedoddaed.","poem":1},{"text":"Dule-nueddi, wilub-obicha ibmar uked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Bab-Dummad, dule-isganamar-ega-ibmar-ukedi, isdar-daked.","poem":1},{"text":"Bur bule isdar daked, nabiridgi ega uksurmalar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Dule-ibmar-daksad-gakansaar-soged burgoed.","poem":1},{"text":"Dule, a-duleba-ibsaeddi, deyob guedsemogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Dule-isgana na ibmar-sogsadi gege ogwadaed.","poem":1},{"text":"Dule-nueddi, na e-daed nudaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Nue-binsaed-nikaguedi, nue-ibmar-wisiguedi,","poem":1},{"text":"degi, binsaed-nuegana, gwen Bab-Jehováʼgi obinsulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Dule bila-onogega moli guakwaa nasiked.","poem":1},{"text":"Degi-inigwele, bila-onogedgi-nakwegala, Bab-Jehováʼgi siid.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":31}