{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":[{"text":"Ibmar-nuegan-bukidar-nikadba, bur nuedid, nug-nued nikued.","poem":1},{"text":"Bukidar-or-nikuedba, degi, mani-nikuedba, bur nuedid begi dulemar nued sunmaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mani-ibed, degi, dule-wileged, ¿ibugi emar gumala?","poem":1},{"text":"Bab-Jehová-ebobela-obinnisadgi emar gumalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dule-itoakwaadaed magar bonigan-daked, bonigangi banguddaed.","poem":1},{"text":"Dule-binsaedsulidaeddi, bonigan-idu bangusulid,","poem":2},{"lineBreak":true},{"text":"degisoggu, boni amisdasunnad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"San-bipi-imaklegedgi, Bab-Jehová-nug-odummolegedgi we-ibmar-sogbaagwad danikid:","poem":1},{"text":"Ibmar-nuegan-nikued, nug-dummarba-gued, dula-gudii-saed, danikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dule-isganamar-gudiidbina, ikomar bukwad, sakimar bukwad.","poem":1},{"text":"Dule-na-san-sabgudiiddi, a-ibmarmargi bangued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Igar-innikigwadgi mimmigan be odurdake.","poem":1},{"text":"Amba sered-ugakgusale, we-ibmargi banguosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dule-mani-ibed, dule-wilemalad-e-dummad gued.","poem":1},{"text":"Dule-mani-ganikid, dule-mani-ega-uksad-e-maiga gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dule-ibmar-isgana-imaked, bonigan amied.","poem":1},{"text":"Bab-Dummad isdar-itogedgi we-dule-obelogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dule emar-wiledakele, egi nued binsalegoed.","poem":1},{"text":"Ar we-dule, dule-wilemaladga masgunned uked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dule-gadi-urwed-amied be ononnoge,","poem":1},{"text":"adi, na abin-abin-imaklegedi, urwelegedi, degi, sabsur-ibmar-soglegedi, berguoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dule innikigwadgi-ibmar-sogedi, e-sunmaked-yeer-itolegedi,","poem":1},{"text":"rey e-aiga imakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bab-Jehová dule-binsaed-ibedgi nakuleged.","poem":1},{"text":"Bab-Jehová, dule-gakansili-e-ibmar-sogeddi oyoged, e-sunmaked gakanye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dule-wiegala yapa-arbaedba sogdaed: “Achumigur-nono-wawaad magaba gudiiye.","poem":1},{"text":"An noddibe, an-gunnoye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ome-sui-dikarba-yoleged-e-gaya, yaa-matusur-siidyob gued.","poem":1},{"text":"A-yaagine, dule-Bab-Jehová-ourwega-imakedi, argwanoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Uayasulidaedi, gusgu burwigana-e-daedid.","poem":1},{"text":"Molidubgi-bibyolegedgi uayasulidaed surgued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dule, mani-bur bule-nikuega, dule-wileged-mesagwar imaked.","poem":1},{"text":"Dule, mani-ibedga binsa-ibmar-ukedi, na dule-wilegedga guoed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dule-binsaed-ibed-e-sunmakedi, nuekwaa be itoge.","poem":1},{"text":"An be-odurdakedba, be ibmar imake.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ar be we-ibmar nonogi-gaele,","poem":1},{"text":"bela be gannar-gannar sogdiile, be yeer-itogoed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bab-Jehováʼgi be mer benguega,","poem":1},{"text":"emi an be-owisonaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Emi, an bega durgwen-gakambe (30) binsaed-nuegan-ibmar-wisigued narmaksad.","poem":1}]},{"type":"verse","number":21,"content":[{"text":"Adi, be gayaburba-napiragwadi, wisi guega,","poem":2},{"lineBreak":true},{"text":"adi, dule-bese-ibmar-egised-abin nabir be ibmar sogegar.","poem":2}]},{"type":"heading","content":["1"]},{"type":"verse","number":22,"content":[{"text":"Melle dule-wileged-ibe be ibmar-atursae, ar wede, dule-wilegedid.","poem":1},{"text":"Melle igar-naboleged-neggi dule-ibmar-sate-gudiid be sabsur-imakbalo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ar Bab-Jehová wemar-ular gwisguoed,","poem":1},{"text":"geb dule-wileged-ibe-ibmar-susad-annik ibmar sumogoed.","poem":2}]},{"type":"heading","content":["2"]},{"type":"verse","number":24,"content":[{"text":"Melle be dule-emar-sabsur-imaked-e-aiga gue.","poem":1},{"text":"Melle be dule-emar-wiogedba akabali.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ar e-ichakwadamalad be durdaksale,","poem":1},{"text":"na be dukin boni-dummad amioed.","poem":2}]},{"type":"heading","content":["3"]},{"type":"verse","number":26,"content":[{"text":"Melle be emar-anar ibmar-imakoye sogo.","poem":1},{"text":"Melle be emar-anar mani-bennukega gubalo.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ar be bennukega mani-sate-gualile,","poem":1},{"text":"be-gabedse-bakale, be-ibe sumaloed.","poem":2}]},{"type":"heading","content":["4"]},{"type":"verse","number":28,"content":[{"text":"Melle be-dadgan dikasurgus-nainu-abingunaidgi","poem":1},{"text":"ibmar-ogwichismalad be oniro.","poem":2}]},{"type":"heading","content":["5"]},{"type":"verse","number":29,"content":[{"text":"¿Dule e-arbaedgi nued-arbaed be dakdii?","poem":1},{"text":"Dule-deyob-arbaedi, reymarga arbadii guoed, dule-binsarmaladga arbaosulid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/21.json","previousChapterAudioLinks":{},"numberOfVerses":29}