{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":23,"content":[{"type":"heading","content":["6"]},{"type":"verse","number":1,"content":[{"text":"Be dule-dummadbo mas-gunsokalile,","poem":1},{"text":"nue ebinsao, doa-asabin be sii.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ar be gadi-mas-gunnele,","poem":1},{"text":"masgunned bargao.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Melle be e-mas-yeer-gullegedbina soge,","poem":1},{"text":"ar we-masdi, unnila dule-yardakedid.","poem":2}]},{"type":"heading","content":["7"]},{"type":"verse","number":4,"content":[{"text":"Melle be ibmar-nuegan-nikuega surbinsa-itodii gue.","poem":1},{"text":"Melle be ibmar-gargerbamaladginbi binsadii gue.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ar be nuekwaa dakdele, be daksaled,","poem":1},{"text":"ibmar-gargerbamalad baisursunna berguddaed.","poem":2}]},{"type":"heading","content":["8"]},{"type":"verse","number":6,"content":[{"text":"Melle be dule-nallegaladbo mas-gunne.","poem":1},{"text":"Melle be e-mas-yeer-gullegedbina sogbalo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ar e-masde, gammugi-sailagia-megeyob gued.","poem":1},{"text":"Bega sogoed: “Mas-gunne, gobe.”","poem":2},{"lineBreak":true},{"text":"Degi-inigwele, gwen gwage-nuedgi bega sogosulid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"A-sorbali, be bela mas-guchad agoed,","poem":1},{"text":"ega be nuedgi-sunmaksadi, binsa be sunmakoed.","poem":2}]},{"type":"heading","content":["9"]},{"type":"verse","number":9,"content":[{"text":"Melle be dule-binsaedsulidaedga binsaed dako.","poem":1},{"text":"Ega be ibmar-sogoedi, be-abin isdar-itogoed.","poem":2}]},{"type":"heading","content":["10"]},{"type":"verse","number":10,"content":[{"text":"Melle dikasurgus-nainu-abingunaidgi ibmar-ogwichismalad be oniro.","poem":1},{"text":"Mer be dule-sergansated-e-nainugi dogbalo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar wemar Dule-E-Bendaked-Gandikid nikad.","poem":1},{"text":"Dule-sergansated-bendakegala, be-abin gwisguoed.","poem":2}]},{"type":"heading","content":["11"]},{"type":"verse","number":12,"content":[{"text":"Ibmar-durdaksadba be ibmar imake,","poem":1},{"text":"binsaed-nued-uklegedi, be nue-itoge.","poem":2}]},{"type":"heading","content":["12"]},{"type":"verse","number":13,"content":[{"text":"Melle be mimmigan-odurdaksuli gue,","poem":1},{"text":"molidubgi-bibyolegedba burgosulid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ar bur be molidubgi-bibyogele,","poem":1},{"text":"burgwed-igargi be ollor-imaknaid.","poem":2}]},{"type":"heading","content":["13"]},{"type":"verse","number":15,"content":[{"text":"Machi, be dule-binsaed-ibedga gunonikile, gwagegi an weligwar itomogoed.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Be-sunmakedi, napiragwadba be sunmakele, ulubgi an yeer itononikoed.","poem":2}]},{"type":"heading","content":["14"]},{"type":"verse","number":17,"content":[{"text":"Melle be dule-isganamargi nobgue,","poem":1},{"text":"bur be bane-bane Bab-Dummad-nug odummodii imake.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Adi, yoedse bega ibmar nueganbi guoed,","poem":1},{"text":"na be ibmar-edarbediid nikudapoed.","poem":2}]},{"type":"heading","content":["15"]},{"type":"verse","number":19,"content":[{"text":"Machi, nue be itoge, binsaed-nikaa be dae,","poem":1},{"text":"igar-innikigwadbarbi be nanadii sae.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dule-gadi-mumgumaladba mer be akae.","poem":1},{"text":"Dule-gadi-masgunmaladba mer be akadii gubali.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ar dule-gadi-mumgumaladi, degi, gadi-mas-gunmaladi, dule-wilegedga gumaloed.","poem":1},{"text":"Ar dule-gabedginbi-binsaedi, unnila mor-siir-siir-yoi gudiguoed.","poem":2}]},{"type":"heading","content":["16"]},{"type":"verse","number":22,"content":[{"text":"Be-bab-we-napnegse-be-odenonikid be itoge,","poem":1},{"text":"be-nan seredgusale, mer be isdar-dako.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Igar-napiragwad, nue-binsaed-nikagued, be amie.","poem":1},{"text":"Ibmar-durdaked, nue-ibmar-wisigued, be amie.","poem":2},{"lineBreak":true},{"text":"Wemala, mer be ibmar-baid-anar ogwao.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Dule-nued-e-baba na bela-bela yeer itoged.","poem":1},{"text":"Dule na machi-binsaed-ibed-nikad, weligwar itoged.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Be-bab, degi, be-nan, werguega be imake.","poem":1},{"text":"Be-sergan-we-napnegse-be-senonikid wergumalaga be imake.","poem":2}]},{"type":"heading","content":["17"]},{"type":"verse","number":26,"content":[{"text":"Machi, an-bega-binsaed-dakdiidgi be binsae,","poem":1},{"text":"an-nanadiid be dake.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ar ome-gambanuchu-imakedi, yaa-dummad-matusursiidyob gued.","poem":1},{"text":"Dule-baid-ome-galagwensur-nanaedi, dia-garagwad-matusursiidyob gued.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"We-omedi, dule-atursaedyob matarmakdidaed.","poem":1},{"text":"We-ome, machergan-bukidar-e-ome-dikarba-yolemalaga imaked.","poem":2}]},{"type":"heading","content":["18"]},{"type":"verse","number":29,"content":[{"text":"Dule-mumgued-iedisulidi, dule-sisamar-galagwensuli-gobedi,","poem":1},{"text":"boed amied,","poem":2},{"lineBreak":true},{"text":"ibmar-nunmaked-itoged amied,","poem":2},{"lineBreak":true},{"text":"urwed amied,","poem":2},{"lineBreak":true},{"text":"isdar-itoged amied,","poem":2},{"lineBreak":true},{"text":"binsa-nailikgued amied,","poem":2},{"lineBreak":true},{"text":"ibya-gudure-gued amied.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Dule-mumgued-iedisulidi, dule-sisamar-galagwensuli-gobedi, deyob gued.","poem":3}]},{"type":"verse","number":31,"content":[{"text":"Vino-gisi-daklesidaedbina mer be soge,","poem":1},{"text":"vino-noggi-dakarmaksidaedbina mer be sogbali.","poem":2},{"lineBreak":true},{"text":"E-goblegedi, nolloo gobleged.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Degi-inigwele, dubgi-warmakeyobi, be itogoed.","poem":1},{"text":"Naibe-e-gichi-begi-ubodeyobi, be itogoed.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ibya-apurega be-imakoed,","poem":1},{"text":"galagwensuli-binsaega be-imakoed.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Magadba-yakumaknadapiyob be itogoed,","poem":1},{"text":"urmor-suar-dukugi-maiyob be itogoed.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Be sogdagoed: “An-naibi-imaksamala,","poem":1},{"text":"degite, gwen nunmak an itosulid.","poem":2},{"text":"An-bibyosmala, degite, gwen bai an itosulid.","poem":1},{"text":"An dadakusale, gannar an mumgunabaloed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}