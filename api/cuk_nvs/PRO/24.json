{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":24,"content":[{"type":"heading","content":["19"]},{"type":"verse","number":1,"content":[{"text":"Melle be dule-isganamargi nobgue,","poem":1},{"text":"melle be eba-akaedgi binsabali.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ar e-gwagegi unnila emar-sabsur-imakedgi binsamalad,","poem":1},{"text":"unnila ibmar-isgana-imakedgi sunmakmalad.","poem":2}]},{"type":"heading","content":["20"]},{"type":"verse","number":3,"content":[{"text":"Nue-binsaed-nikaguedba neg sobleged.","poem":1},{"text":"Nue-ibmar-wisidba neg-e-sailamar mesleged.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Itoakwaa-binsalegedba e-gabednegmaryaba","poem":1},{"text":"ibmar-gargermaladi, degi, ibmar-yeerdaklemaladi enoleged.","poem":2}]},{"type":"heading","content":["21"]},{"type":"verse","number":5,"content":[{"text":"Dule-binsaed-ibedi, dule-gandikidid.","poem":1},{"text":"Dule-nue-ibmar-wisidi, dule-dutusulidid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nue-igar-amiale, bila onoleged.","poem":1},{"text":"Bukidar-dulemar-binsaed-dakmaladgi nakwileged siid.","poem":2}]},{"type":"heading","content":["22"]},{"type":"verse","number":7,"content":[{"text":"Dule-binsaedsulidaedi, dule-binsaed-ibedga gwen guosurguoed.","poem":1},{"text":"Igar-itolegedgi sunmakosulid, ar aku-itoged na ibi obaroe.","poem":2}]},{"type":"heading","content":["23"]},{"type":"verse","number":8,"content":[{"text":"Dule unnila ibmar-isganaginbi-binsaedi, egi-soglegoed:","poem":1},{"text":"“Dule-isganaye.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dule-binsaedsulidaedi, unnila isguedginbi binsaed.","poem":1},{"text":"Bela dulemar dule-emargi-dododiid isdar-dakmalad.","poem":2}]},{"type":"heading","content":["24"]},{"type":"verse","number":10,"content":[{"text":"Ar be bonigan-abin sikirmakele,","poem":1},{"text":"amba be-gangued nollogwad.","poem":2}]},{"type":"heading","content":["25"]},{"type":"verse","number":11,"content":[{"text":"Dulemar-burgwed-igarse-nadapmalad be ollor-imake,","poem":1},{"text":"dulemar e-burgwed-modanimalad be bendake.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ar amba be sogele: “An wissulinye.”","poem":1},{"text":"¿Dule-gwage-wilubdakedi, gwen wisguosur be insae?","poem":2},{"text":"Dule-begi-nakulegedi gwen wisguosur, ¿be insae?","poem":1},{"text":"Bab-Jehová dulemar-e-daedba dulemarga ibmar-uked.","poem":2}]},{"type":"heading","content":["26"]},{"type":"verse","number":13,"content":[{"text":"Machi, achanis be mae, ar yeer-maleged,","poem":1},{"text":"achanis ochii maleged.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Binsaed-nikaguedi, achanisyob bega ochii gumogoed.","poem":1},{"text":"Binsaed-nikagued be amisale, yoedse bega ibmar nueganbi guoed,","poem":2},{"lineBreak":true},{"text":"be-ibmar-edarbediid be nikudapoed.","poem":2}]},{"type":"heading","content":["27"]},{"type":"verse","number":15,"content":[{"text":"Dule-isgana, melle be dule-nued-oakalogedgi binsae.","poem":1},{"text":"Melle be e-neg-obelogedgi binsabali.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dule-nuedi, amba ilagugle (7) aimukuele, gannar gwisgubaloed.","poem":1},{"text":"Dule-isganamardi aimukusale, geg bar gannar gwisgued.","poem":2}]},{"type":"heading","content":["28"]},{"type":"verse","number":17,"content":[{"text":"Be-isdaradi aimukusale, mer be yeer-itogo.","poem":1},{"text":"Be-isdarad akar-gusale, mer be wergubalo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ar Bab-Jehová egi-be-wergue be-dakalile, be-daed nabir-dakosulid.","poem":1},{"text":"Ar egi be werguele, Bab-Jehová be-isdarad bar sabsur odurdakosulid.","poem":2}]},{"type":"heading","content":["29"]},{"type":"verse","number":19,"content":[{"text":"Melle be dule-isganamarba akae.","poem":1},{"text":"Melle be egi nobgubalo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ar dule-isgana nuedgi berguosulid.","poem":1},{"text":"Dule-isgana gwallu-akitedaedyob bergudoed.","poem":2}]},{"type":"heading","content":["30"]},{"type":"verse","number":21,"content":[{"text":"Machi, Bab-Jehová-dobekwaa be nanae,","poem":1},{"text":"rey-nug be odummoge.","poem":2},{"lineBreak":true},{"text":"Uayasulidamaladba mer be akae.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ar wemar ukiagwale, sabsur-odurdaklemaloed.","poem":1},{"text":"Ar dule wissulid, ibi-bonigan egi danikoe.","poem":2}]},{"type":"verse","number":23,"content":["Dule-binsaed-ibegan amba we-ibmar sogsamarbalid:",{"text":"Igar-nabirolegedgi dule-wargwenbarbi-nagued nuedsulid.","poem":1}]},{"type":"verse","number":24,"content":[{"text":"Dule-igar-naboged, dule-ibmar-oakalosad ibmar-oakalossuliyob dakele,","poem":2},{"text":"neggweburmarse ukabsalegoed,","poem":1},{"text":"dulemarse isdar daklebaloed.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ar dule-igar-nabogedi, dule-ibmar-oakalosad-sabsur-odurdakerdi, dulemar yeer dakmaloed,","poem":1},{"text":"dulemar egi ise-nued binsamaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Napiragwadgi dule-abinsaed,","poem":1},{"text":"yeer-itole dule-imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ibmar-digoed guakwa be urbe,","poem":1},{"text":"ibmar-digega be-nainumar guakwa be nasike,","poem":2},{"lineBreak":true},{"text":"geb a-sorbali, be-neg be soboed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Melle be ibmar-daksasuli dule-baidgi sunmako,","poem":1},{"text":"melle be egi gakansabalo.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Melle be sogo: “Igi be an-imaksa, deyob an be-imakmogoed.","poem":1},{"text":"An deyopira imaked nikamoga.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Dule-wiegala-e-nainu-dikarba an nasad,","poem":1},{"text":"dule-binsaedsulidaed-e-uva-digaled-dikarba an nasad.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"A-nainugine, ikomar yaisur an daksad,","poem":1},{"text":"e-nainu bula-moodo-nai an daksabalid,","poem":2},{"lineBreak":true},{"text":"e-galu-emakaled-nainu-ebiris-naidi aimukumai an daksabalid.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"An weyob ibmar-daksadi bipisaale, an iessulid.","poem":1},{"text":"We-ibmargine, ibmar-soggwen an durdaksad:","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ar be sikwas gabele,","poem":1},{"text":"ar be sikwas megele,","poem":2},{"text":"ar be sikwas obunnogele,","poem":1},{"text":"unnila be sakwa-obirmasmaile,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"wilegedi, dule-atursaedyob begi nonikoed,","poem":1},{"text":"ibmar-sate-guedi, dule-gingi-nikadyob begi nonikoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}