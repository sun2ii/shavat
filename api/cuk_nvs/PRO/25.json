{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":["We-binsaed-nuegana Salomón onosbalid. Judá-rey-Ezequíasʼga dule-garda-narmakmaladi we-binsaedmar nue-ilemakar narmaksad."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ibmar-dukuar-mamaidi, Bab-Dummad-e-gandikid-e-wilub oyoged.","poem":1},{"text":"Reymar, igar-dukuar-mamaid-balamiedi, dule-gandikmaladga gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dule, nagase nibneg-nibgued balamiosulid,","poem":1},{"text":"degi, nagase napneg-e-ulub-naid balamiosulid.","poem":2},{"lineBreak":true},{"text":"Amba deyobi, reymar-binsaedi gege ulubse balamilemogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mani-dulenaidgi-durgan-welegoed be mie.","poem":1},{"text":"Geb a-manigine, dule-mani-sobedi, nog soboed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Rey-asabin dule-isgana be onoge.","poem":1},{"text":"Geb rey igar-innikigwadba yar-seoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Melle rey-asabin dule-nug-nikadga be san-imako.","poem":1},{"text":"Melle dule-dummagan-imbagi yogasaar sigis be imako,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"rey bur bega soged nabirid: “Wese be sigda”","poem":1},{"text":"adi, melle dule-dummagan-abin rey be-obingegsaegar.","poem":2},{"lineBreak":true},{"text":"Be-sunnagwad be ibmar-daksale,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"melle gwae-gwae dummaganse-odonao.","poem":2},{"text":"Ar dule yamo be-abin osulosale, igi be saoe.","poem":1},{"text":"Aka dukin be bingeguoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bebogwa igar-gwatirisad be nudako.","poem":1},{"text":"Degi-inigwele, melle dule-bega-ibmar-sogedi, dule-baidga sogmogo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ar be dule-baidga ibmar-sogele, we-dule, sunna be-nug oichoged.","poem":1},{"text":"Degidbali, bar be, nug-nued-nika guosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Iba-sogedba ibmar-soglegedi,","poem":1},{"text":"galimbaba dutumar-oyapateyobi gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dule-binsaed-ibedi, nuedgi dulega gannabasaar-ibmar-sogsiile, dulega olargan-dummaganba bur bule ibnuedid,","poem":1},{"text":"ega ormadaremaladba bur bule sunsogedid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Igi-neg-diopisulidgi, neg-diopigwad yeer-itoledae,","poem":1},{"text":"debayobi, dule-garda-berbeged-innikigwadi, e-dummadga niga-gandikid ukmogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Igi-dii-wioeyobi neg-ainakwis sii dakledae,","poem":1},{"text":"debayobi, dule ibmar-ukoye-sogdidaedi, gege ibmar-ukdaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Gwae-gwaesuli, binnasdikigwadgi, dule-nuga-nikad-e-binsaed ogwaleged.","poem":1},{"text":"Nuedgi, urwedginsuli-sunmaklegedi, bela igar-bulegangi obilleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Be achanis amisale, melle dogdar-mao.","poem":1},{"text":"Ar doggus be masale, be agdoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Melle bali-bali dule-baid-negse nanao.","poem":1},{"text":"Ichakwagwad, bali-bali-nanaer, abakalegi budar-be-dakedba, isdar be-dakalile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Dule, e-aigi gakansaar-sunmakedi, akwa-mamaredyob gued.","poem":1},{"text":"Es-suidyobi, degi, es-swiswidikidyob gubalid. Emar-wioged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Dule, suli-suli-itogedgine, dule-isganagi bensuli gunonikile, nugar-nunmakedyob gued.","poem":1},{"text":"Degi, nailik-mali-bisgar-gudiidyobi gued. Binsaedsuli daed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dule-bukib-binsaedba-wile-itodiidgala namaklemaladgi-namakedi, nuedsulid.","poem":1},{"text":"Ega ukagi-yaa-siidgi balu-eogeyobid.","poem":2},{"text":"Degi, neg-dambipigwadgi mor-esuedyobid.","poem":1},{"text":"Gwen gadi-gadi imakosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Be-isdarad ukudmaada-itogele, masgi ogunno,","poem":1},{"text":"uku-uku-itogele, ogobo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Deyob be a-dule-imakele, be nue-obingegsaoed,","poem":1},{"text":"Bab-Jehováʼdi bega ibmar-buged ukoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Dii-burwa-goledbali dii-wied danidaed.","poem":1},{"text":"Gaya-isgana-sunmakedbali, neg-urwed noardaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ome-ursili-ebo neg-dummadgi-megedbali, bur nabirsursi,","poem":1},{"text":"neg-sukungwaba-meremair.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Igi-uku-uku-itolegedgi dii-dambipigwad gobledae,","poem":1},{"text":"deyobi, gayaburba-nuegan dikasur-danikir, itoledaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Dule-innikidaedi, dule-isgana-abin sikirmakele, dii-isgumaidaeyobi gued.","poem":1},{"text":"Diagi-ib-isgana-mileddaeyobi gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Achanis-gadi-maele, ichakwagwad.","poem":1},{"text":"Dukin-san-dummarba-imaked-amiedi, ichakwabalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Dule-san-bargaed-wissulidi,","poem":1},{"text":"neggwebur-galu-matusulid-sateyobi gued.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/24.json","previousChapterAudioLinks":{},"numberOfVerses":28}