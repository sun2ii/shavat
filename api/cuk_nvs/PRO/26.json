{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"Dambed-sibudik-sibudik-bated, yorgi batesulid.","poem":1},{"text":"Ibmar-gwag-weleged, dii-wiedgi welesurmogad.","poem":2},{"lineBreak":true},{"text":"Dule-binsaedsulidaed-e-nuga gwen odummolesurmogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Igi-sikwigolo igarsuli gukudidae, igi-wirsob uu-suli gudidae,","poem":1},{"text":"debayobi, yogasaar-ukabsalegedi, gwen igarga guosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Moli-bibyoged-duba, moli-bibyogega gued.","poem":1},{"text":"Moli-gaya-bargaedi, moli-uayasuid-gaya-bargaega gued.","poem":2},{"lineBreak":true},{"text":"Suardi, dule-binsaedsulidaed-bibyogega gumogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Melle be dule-binsaedsulidaed barwisogo,","poem":1},{"text":"aka be bur dule-binsaedsulidaedga gudoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dule-binsaedsulidaedga, bakar be ibmar-sogo,","poem":1},{"text":"adi, melle e-ibmar-sogedba binsaed-ibedga na san-imakegar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dule, dule-binsaedsulidaedba garda barmiele, mali-siklegar-maiyob gued.","poem":1},{"text":"Duleba garda-barmissuliyobi gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dule-binsaedsulidaedi, binsaed-nuegangi-sunmakele, nabirsulid.","poem":1},{"text":"E-sunmakedi, mali-burgwar-bellemaknaidyobi itoleged. Baisursunna itoleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dule-binsaedsulidaedga nug-odummolegedi, akwa gunnu-akwa-miedgi-atinnar-naidyob gued.","poem":1},{"text":"Dule-binsaedsulidaed-e-nug-odummolegedi, gwen nabirsulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dule-binsaedsulidaedi, binsaed-nuegangi-sunmakele, aku-itodabalid.","poem":1},{"text":"E-sunmakedi, dule-mummud e-argangi iko-yolesayobid, aku-itodaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dule, e-neggi dule-binsaedsulidaed-oarbaele, sigu-mied-dule yogasaar sigu-miedba dule-onailiksaedyobid.","poem":1},{"text":"Wissulid bia sigu argwatapoe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Igi achu na e-agsad gannar maddae,","poem":1},{"text":"debayobi, dule-binsaedsulidaedi, gannar-gannar ibmar-nabirsulid obariddaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"¿Dule-binsaed-ibedye-na-sogdiid be dakdii?","poem":1},{"text":"Dule-binsaed-ibedye-na-sogdiidba bur baisursunna, dule-binsaedsulidaedi ibmargi odurdakleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dule-wiegala, yamo wiedbali weyob sogdedaed:","poem":1},{"text":"“¡Igarba achu-sapur gudii daklesa!","poem":2},{"lineBreak":true},{"text":"¡Neg-galimbaba achumigur achiksa-gudii daklesa!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Igi yawagak, e-naidgi egemakwisdae,","poem":1},{"text":"debayobi, dule-wiegala e-megedgi nikwamakmaidaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dule-wiegala mas-gunnega bateyagi e-argan ododaenad,","poem":1},{"text":"degi-inigwele, wiedba e-gayaba mas odosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dule-wiegala, dule-binsaed-ibegan-e-walagugledba (7),","poem":1},{"text":"bur binsaed-ibediyob itodaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Igi achu uaya-ebilenaidgi emargi aibine,","poem":1},{"text":"deyobi, dule, dulemar-urwenaid-imbagi gotemogale, boni-amied.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Igi dule oes yogasaar sigu-soo-nikad mie,","poem":1}]},{"type":"verse","number":19,"content":[{"text":"deyobi, dule, e-ai-yamoged.","poem":2},{"text":"Geb sorba ega sogdaed,","poem":1},{"text":"“unnila, binsa an begi dodonaiye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dule, soo-yagi sapan urbesulile, soo akitedaed.","poem":1},{"text":"Deyobmodo, gakansaleged satele, urwed satedaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Sogungi soo oaramakledaed, sapangi soo ogaledaed.","poem":1},{"text":"Deyobmodo, dule-ursilidgi urwed noardamogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Gakangi-sunmaklegedi, mas-nued-gullegeyobid.","poem":1},{"text":"Gakangi-sunmaklegedi, ulubse uboged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Igi yamo napsa-nog manigi oglege,","poem":1},{"text":"debayobi, dule-gwage-isgana-e-sunmakedi yamo nabiridyobi sunmakdaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Sae-dule-dakedi, yamo nueganbi dulega sunmakdaed,","poem":1},{"text":"ar e-ulubgindina, sae dule-dakdaed.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ar sae-dule-dakedi, yamo bega nueganbi sunmakele, melle be itogo,","poem":1},{"text":"ar e-gwage-ulubgindi, dogdar isdar binsadaed.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Amba yamo sae-dule-daksuliyob na san-saele,","poem":1},{"text":"dulemar-abargindi e-isgued magar daklenonikoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Dule yaa-dummad-akwiele, na dukin a-yaagi-argwanega guoed.","poem":1},{"text":"Ar dule akwa-dummad obaparmakele, na dukin e-birgi-sigega imakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Gakansaed-gwabin-duku, gayaburba-nuegan isdar-itodaed.","poem":1},{"text":"Yamo-nabiridyob-sunmaklegedi bela neg-oichoddaed.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/25.json","previousChapterAudioLinks":{},"numberOfVerses":28}