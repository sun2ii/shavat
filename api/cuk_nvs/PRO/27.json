{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"Melle be san-dummarba-imakedgi binsao,","poem":1},{"text":"ar be wissulid, ibagan begi igi-daniki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Melle be dukin san-dummarba-imako,","poem":1},{"text":"dule-baigan be-nug-odummogedi, bur nabirid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Akwa ukusulid, ukubbela ukusurbalid,","poem":1},{"text":"dule-binsaedsulid-e-urweddi, aba bur bule yeer-gangued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Urwedi, yeer-gangued.","poem":1},{"text":"Sae-itogedgi-urwedi, dule-wioged.","poem":2},{"lineBreak":true},{"text":"Nobeddi, geg bargaleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Arbakee-sabgulegedba,","poem":1},{"text":"bur nuedid, bakar-bega-ibmar-soged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Be-isdarad-yamo-be-wagar-uedba,","poem":1},{"text":"bur nuedid, be-ai-nued sabsur-bega-ibmar-soged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dule, nue-immeles-gudiile, bar ibmar abedasulid.","poem":1},{"text":"Achanisse-bakar, budar madaed.","poem":2},{"text":"Dule, ukudmaada-gudiirdi, ibmar-gagbiregedse-bakar gunned,","poem":1},{"text":"ochigwayobi itodaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dule, dikasuli aineba gaamakdiidi, dikasuli nuu e-uugi gaamakdiyobid,","poem":1},{"text":"neguyagi sate daed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Gwallu-wawadikmaladi, ina-wawadikmaladi, e-yapanned weligwar dule-saed,","poem":1},{"text":"debayobi, ai-nued-binsaed-ukedi, dulega niga-ogannoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Melle be-ai-obanedgi be binsao.","poem":1},{"text":"Melle be-bab-e-ai-obanedgi be binsabalo.","poem":2},{"lineBreak":true},{"text":"Melle be-boni-itodiidi,","poem":1},{"text":"be-gwenad-negse be sedo.","poem":2},{"lineBreak":true},{"text":"Bur be-gwenad-bebo-urwediidba,","poem":1},{"text":"bur nabirid, dule-be-neg-dikarba-maidse be naed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Machi, dule-binsaed-nikaa be dae, weligwar be an-imake.","poem":1},{"text":"Adi, an deebali, mesagwar-an-imakdimalad-gayamakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dule-itoakwaa-binsaedi, boni-noed bato daksabindaed.","poem":1},{"text":"Degisoggu, mer boni-noega imakdaed.","poem":2},{"text":"Dule-binsaed-sateddi, boni-noalir akudakdaed.","poem":1},{"text":"Degisoggu, egi nue wileddasunnad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dule, dule-baid-ular mani-gasad-bennukoye-sogsale, mani-bennuksulile, e-ibe be mor weenao,","poem":1},{"text":"dule-baid-mani-gasad-ular, be e-mor sioed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dule bolegoedba binnasuli e-aise nuedgi-goler,","poem":1},{"text":"e-ai-gabmaidga ukabsalegedyob gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ome-ursili, dii-wied-ibagi, dii-gargarmaknaiyobi gued.","poem":1},{"text":"Urwedbi wisdaed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dule, e-igar-gaye-sogele, geg gaed,","poem":1},{"text":"burwayobid, burwadi geg galeged.","poem":2},{"lineBreak":true},{"text":"Argangi ibmar-gwallu-geg-abingalegeyobid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Esgoro, esgoro-baidgi oswiswimakleged.","poem":1},{"text":"Dule na ebo-idakmalale, igar-nuedse onomalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Dule, sapi-nue-akwele, e-san gunnoed,","poem":1},{"text":"dule, e-dummadga nue-nakulediile, e-nug odummolegoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Igi diigi, magar wagar dakledae,","poem":1},{"text":"deyobi, dule e-binsaedbali, na magar-daklesimogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Igi-neg-uan ollorgusisuli, degi, burgwed-igar galemaisuli,","poem":1},{"text":"debayobi, dule ibmarbin-gadisogedi, napi-ibmar abedaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Bormo-crisolʼgi mani wilubdakleged, soogi or wilubdaklemogad,","poem":1},{"text":"duledi, e-nug-odummolegedgi mag-daklemogad, igid-dule gue.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Dule-binsaedsulid be nagele, amba uki be nagbalile, degi, ibmar-gwagyob be osarwele,","poem":1},{"text":"amba e-binsaed-sateddi, e-ibe be osulogosurguoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Be-sibad-wawaadmar nue be dakdii sao,","poem":1},{"text":"be-molimar gatik nue be akwedii sao.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ar ibmar-nuegana, degisadeguadsulid.","poem":1},{"text":"Manimala, degisadeguadsurbalid.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Sapur emilesale, gagan-aradik ainidagoed.","poem":1},{"text":"Sapurgi gagan-dutugana weledagoed.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Sibad-wawaadmar bega mor-yoed ukoed.","poem":1},{"text":"Sibaddi, bega nainu-bakega guoed.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Sibad-e-nunis bukidar be nikuoed,","poem":1},{"text":"adi, bedi, be-ome, be-mimmigana egi nabir itomaloed,","poem":2},{"lineBreak":true},{"text":"degine, bela-bega-arbamaladi, yeer-itomarmogoed.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":27}