{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"Dule-isgana dule-e-balegin-danikiyobi, oes abarmakmaidaed.","poem":1},{"text":"Dule-nueddina, achumigur-nono-wawaadyobi, dobsurdaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yargi, nue-neg-isgusnaile, dummagan-negdakmalad ogwalemaidaed.","poem":1},{"text":"Dule-yar-seed nue-binsaed-nikale, igar-nikaa yar-selemaidaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dule-isgana mesagwar-dule-wilediid-imakedi, dii burwaba-mesa ibmar-digar-naidgi wieyobid,","poem":1},{"text":"bela ibmar-naid obeloged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dule, Igar-maidgi-banguddamaladi, dule-isgana-nug odummoddamalad.","poem":1},{"text":"Dule, Igar-Maidba-nanadimaladdi, dule-isganamarbo gaardamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dule-isganamar, igar-innikigwad aku itodamalad.","poem":1},{"text":"Dule, Bab-Jehová-Igarba-nanadimaladdi, bela magar ibmar-itodamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dule-mani-ibed-sunnasurdaedba,","poem":1},{"text":"bur nuedid, dule-wileged-nueddaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dule, Igar-Maidba-nanadiile, dule-binsaed-nikadaedid.","poem":1},{"text":"Dule, dule-galagwensurdamaladba-nanaeddi, e-bab-obingegsaedid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dule, dule-baidga-mani-gaar-ukedi, e-gakagi mani-onogele, yamolegoed.","poem":1},{"text":"Aka wiledimalad-bendakega, dule-wilemalad-bendakedga, omelodaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dule, Igar-Maid-itobisulile,","poem":1},{"text":"Bab-Dummad, a-dule-ese-goled itogosurmogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dule, igar-isganaba dule-innikidaed-nidele, dukin egi igar-isgana aibinmogoed.","poem":1},{"text":"Dule-gwage-nuegandi ibmar-nued abingaoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dule-mani-ibedi, na binsadaed, ede, binsaed-ibedye.","poem":1},{"text":"Dule-wileged-ibmar-nue-wisiddi, bela wisid, we-dulede, doa-dule.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dule-innikidamalad nakwisale, iba-dummad onoleddaed.","poem":1},{"text":"Dule-isganamar nakwenonikirdi, bela dulemar dobedba dukuddaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dule, e-isgued gwageginbi sediile, nued-gudii guosulid.","poem":1},{"text":"Dule, e-isgued na barsogerdi, egi banguerdi, Bab-Dummad wiledakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dule, gusgu Bab-Jehová-dobee nanadiidi, egi ise-nued binsalesad.","poem":1},{"text":"Dule, gwage-dutusuliddi, nue-wilegoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dule-yar-seed-isgana, dule-wilemalad-mesagwar-imakmaile,","poem":1},{"text":"achumigur-nono-wawaad mas-gaeyobid, wiob mas-gasa gunaiyobid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dummadga-negsemaid aku-neg-itogedi, bur bule dulega neg-gagaed.","poem":1},{"text":"Dummadga-negsemaid ibmar-nueganbina surbinsa-itosuliddi, undar suitii gudigued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Emar-gindaksad-ular, dule balegillediile, oburgwilegedsegad.","poem":1},{"text":"Gwen dule e-ular-gwisguosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Dule, igar-nuedba napira nanadiidi, bendaklegoed.","poem":1},{"text":"Dule-galagwensur-garmakdiiddi, ibagwengi dummad-wiolegoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Dule, arbaele, mas-bukidar-nika guoed.","poem":1},{"text":"Dule, arbasulile, wilegedga gudoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dule-nueddaedi, egi-ise-nued-binsaledii guoed.","poem":1},{"text":"Dule, gwae-gwae mani-ibedga-gubieddi, sabsur-odurdaklesuli guosulid, odurdaklegedsegad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Dulemar bela emarbi be dakoed,","poem":1},{"text":"akar-akar be dakosulid.","poem":2},{"text":"Akar-akar be dakele, igar-nuedsulid.","poem":1},{"text":"Ar madu-wargwengi bato binsaed-galeddamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Dule-manibina-surbinsa-itogedi, gwae mani-ibedga gubidaed,","poem":1},{"text":"ar egi wileged-dummad danikodeeye binsasurdaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Dule, dule-baidga, nuedgi-sabsur-ibmar-sogele, sorba egi nued sunmakleged.","poem":1},{"text":"Dulega-nuedgi-sunmakedba bur bule egi nued sunmakledaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Dule, e-sergan-ibe, ibmar-atursaele, ede, ibmar-oakalossurye sogbalile,","poem":1},{"text":"we-dule, dule-isgana-e-aid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Dule, ibmarbin-sogerbadi, neg-gagaedid.","poem":1},{"text":"Dule Bab-Jehováʼgi bensulirdi, Bab-Dummadgi nasgumai guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Dule, dukin na egi-bensulile, dule-binsaedsulidaedid.","poem":1},{"text":"Dule, binsaed-nikaguedgi ibmar-saele, bendakleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Dule, dule-wilemalad-bendakedi, wilegedga guosulid.","poem":1},{"text":"Dule, dule-wilemalad-bendaksuliddi, sabsur-ukabsalegoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Dule-isganamar nakwisale, bela dulemar dobedba dukuddaed.","poem":1},{"text":"Dule-isganamar bergunonikirdi, dule-innikidamalad nasguddaed.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}