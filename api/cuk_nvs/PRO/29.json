{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"text":"Dule, nuedgi-ega-ibmar-sogleged amba itossulile,","poem":1},{"text":"wiledaklesuli, sabsur ukiagwale, sarsolegoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Dule-innikidamalad nasgudele, neggwebur yeer itodaed.","poem":1},{"text":"Dule-isganamar negsealile, neggwebur bukib binsaddaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dule, binsaed-nueganbina itogerbale, weligwar e-bab-saed.","poem":1},{"text":"Dule, gambanuchu-samaladgi mani-miele, bela na mani-nikadi obeloged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Rey, igar-innikigwadba-negseedi, yar-nue-innikii sedaed.","poem":1},{"text":"Ar rey, unnila neggweburgi mani-gaedginbi binsaerdi, neggwebur-wioddaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dule, e-aiga yamo-nueganbi-sunmakedi,","poem":1},{"text":"e-ai-yardakega sunmakdaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dule-ibmar-isgana-imakedi, dukin e-isguedse yamoleged.","poem":1},{"text":"Dule-innikiidaeddi, weligwaledba namakdaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dule-nueddaedi, dule-wilemalad-bendakdidaed.","poem":1},{"text":"Dule-ibmar-isgana-imakeddi, dule-wilemaladgi binsadasulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Aimargi-gadi-dodomaladi, neggwebur-oimaker saed.","poem":1},{"text":"Dule-binsaed-ibegandi, bogidik neg-imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dule-binsaed-ibedi, dule-binsaedsulidbo abin-abin-imakele,","poem":1},{"text":"amba ebo-urwodibe, ebo alledibe, gwen igar nudakosurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dule-gindakmaladi, dule-nuegan-sae dakdamalad,","poem":1},{"text":"dule-nuegan-oburgwebidamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dule-binsaedsulidi uludele, bar galedasulid.","poem":1},{"text":"Dule-binsaed-ibeddi, nabir san-bargaed wisid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dummadga-negdakmaid gakansaedba-ebipiledele,","poem":1},{"text":"bela ega dummaganga-arbamaladi ibmar-isgana-imakedga guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dule-wilegedi, mesagwar-dule-imakedbogwa emarbimalad.","poem":1},{"text":"Bab-Jehová ebobela magar-atake imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Rey, igar-innikigwadba dule-wilemaladga igar nabogele,","poem":1},{"text":"e-yar-seedi, degisadeguoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Sarsolegedi, nuedgi-sabsur-ibmar-sogedi, binsaed-nikaa dule-imaked.","poem":1},{"text":"Mimmi-uayasulidaeddi, e-nan-bingedar imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ibmar-isgana-imakmalad bukidarale, isgued bukidardaed.","poem":1},{"text":"Dule-nueddamaladdi, dule-isganamar-bergued dakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Be-mimmi be unaele, bonisuli-gudii be-imakoed,","poem":1},{"text":"weligwaled bega ukoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Bab-Dummad-gayaburba barsoglesulile, neggwebur yogasaar nanaddaed.","poem":1},{"text":"Dule Igar-Maid-sogedba nanadiile, egi ise-nued binsaleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mai, uayasuli-gualile, gayaginbi-ega-ibmar-soged unnisurdaed.","poem":1},{"text":"Nabir ibsaegala, wis bibyoleged abeledabalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dule nue-binsasulidgi-sunmakedi, nue be dake.","poem":1},{"text":"Ar dule-binsaedsulid-sunmaked-bursunna, bur bule yogasaar sunmakdaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Dule, na e-mai, bipigwad-akar unadii nanassulile,","poem":1},{"text":"sorba, bukib-binsaed-dummad ega ukoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Dule-urwegala, urwed onogerbadaed.","poem":1},{"text":"Dule-yaisur-urwedi, yeer-isguddaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Dule-san-dummarbadaedi, nug-bipii guoed.","poem":1},{"text":"Dule-san-bipi-imakeddi, nug-dummarbaa guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Dule, ibmar-atursaed-duleba-akaedi, dukin na san-wioged.","poem":1},{"text":"Dule-ibmar-atursaed-galenonikile, amba dule-eba-akadidse ise-egisar-gunanaidibe geg barsoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ar be dulemar-dobee-itogele, dukin be yamolegoed.","poem":1},{"text":"Be Bab-Jehováʼgi-bensulile, bonigangi be ollorgudoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Dule-bukidar, dummadga-negdakmaid ega-ibmar-imakegala amidamalad.","poem":1},{"text":"Unnila Bab-Jehováʼbi dulemarga igar-nabomaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Dule-innikimaladi, dule-ibmar-isgana-imakmalad isdar dakdaed.","poem":1},{"text":"Dule-ibmar-isgana-imakmaladi, dule-innikimalad isdar dakdamogad.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/28.json","previousChapterAudioLinks":{},"numberOfVerses":27}