{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":3,"content":[{"type":"heading","content":["Uaya-nikaa-daedgi unaed"]},{"type":"verse","number":1,"content":[{"text":"Machi, melle an-igar-odurdaked be iego,","poem":1},{"text":"be-gwage-ulubgi an-igar-maid be sedigu guo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ar deyob be imakele, we-napneggi suitii mai be guoed,","poem":1},{"text":"weligwar-itodii be guoed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sabgued-igar melle be iego,","poem":1},{"text":"napiragwad-igar melle be iebalo.","poem":2},{"text":"Igi wingwa be-dukargi-naigu be gudidae, deyobi be imako,","poem":1},{"text":"be-gwage-ulubgi sedigu be imako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Deyob be imakele, Bab-Dummad nabir be-dakoed,","poem":1},{"text":"dulemar nabir be-dakmogoed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Melle be-ibmar-wisidba be nanadii guo.","poem":1},{"text":"Bab-Jehováʼgi bela-belad-ulubgi-bensuli be nanadii imako.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bela be ibmar-imakedgi Bab-Jehováʼse idakdii be imako.","poem":1},{"text":"Deyob be imakele, Bab-Jehová bega igar nueganbi imakoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mer be binsao, “An ibmar nue-wisye.”","poem":1},{"text":"Bur be Bab-Jehová dobee nanae,","poem":2},{"lineBreak":true},{"text":"bur be ibmar-isgana-imakedgi bangue.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Deyob be nanaele, we-igala, bela bega ina-nuedga guoed,","poem":1},{"text":"bela bega be-abagan ogannogoed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Be-ibmar-nikad-Bab-Jehováʼga-ukedgi Bab-Jehová-nug be odummoge.","poem":1},{"text":"Gebe be-ibmar-sanmaked-Bab-Jehováʼga-ukedgi Bab-Jehová-nug be odummoge.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Deyob be imakele, be-ibmar-gwag-saboged-uu ena sii guoed,","poem":1},{"text":"be-vino-binigan e-galugi ena sii guoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Machi, Bab-Jehová sabsur-be-odurdakalile, melle isdar be itogo,","poem":1},{"text":"melle be urwebalo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Igi baba na e-mimmi-sabedba sabsur-odurdakdae,","poem":1},{"text":"deyobi, Bab-Jehová dulemar-sabedi sabsur-odurdakdamogad.","poem":2}]},{"type":"heading","content":["Binsaed-nikagued-odummoleged"]},{"type":"verse","number":13,"content":[{"text":"Dule binsaed-nikagued nikunonikile, we-dulegi nued binsalegoed.","poem":1},{"text":"Dule ibmar-nue-wisi gunonikir, we-dulegi nued binsalegoed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Binsaed-nikagued maniba bur bule ibnuedid,","poem":1},{"text":"orba bur bule egi ibmar-nuegan amileged.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Binsaed-nikagued, akwa-nuegan-manisailadba bur ibnuedid.","poem":1},{"text":"Ibmar-nue-wisigued, ibmar-nueganbina-sogleged-ebo yobsulid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ar binsaed-nikagued we-napneggi suitii mai be-imakoed.","poem":1},{"text":"Deginbali, mani-ibedga be-imakbaloed,","poem":2},{"lineBreak":true},{"text":"nug-nued-nikaguedga be-imakbaloed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"A-igarmarba-nanalegedi, yeer-ito dule-saedid,","poem":1},{"text":"bela e-igarmar bogidik-gudii dule-imakedid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Dule binsaed-nikagued-amisale, egi burba-dula-gudigued nikued.","poem":1},{"text":"Dule binsaed-nuedgi-akas-gudiile, Bab-Dummad, we-dulegi nued binsaed.","poem":2}]},{"type":"heading","content":["Binsaed-nikagued, degi, napneg-nagusad"]},{"type":"verse","number":19,"content":[{"text":"Bab-Jehová binsaed-nikaguedgi, napneg nasiksad.","poem":1},{"text":"Nue-ibmar-wisiguedgi, nibneg nasiksabalid.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Na ibmar nue-wisidba, diimar bachik-bachik nasiksad,","poem":1},{"text":"nibneg-akale, dii-wiega imaksad.","poem":2}]},{"type":"heading","content":["Binsaed-nikaguedgi-ibmar-imakedi weligwar dule-imaked"]},{"type":"verse","number":21,"content":[{"text":"Machi, nue-binsakwaa be ibmar imako.","poem":1},{"text":"Itoakwaa-ibmar-imaked melle be iego.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Deyob be imakele, burba-dula-gudii be-imakoed.","poem":1},{"text":"Bega ordubyobi ibnuedga guoed.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Geb agine, bonisuli be nanadii gudoed,","poem":1},{"text":"be yoledii guosulid.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Be megid-sogele, be dobguosulid.","poem":1},{"text":"Be gabidogu, bogidikidgi be gabidoed.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ukiagwar-bonigan-noardaedi, be dobguosulid,","poem":1},{"text":"dule-Bab-wissurmaladgi ukiagwar boni-dummagan-noardaedi, be dobguosurbalid.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ar Bab-Jehová beba gudiguoed,","poem":1},{"text":"dulemar-isganase yardaklegega be-imakosulid.","poem":2}]},{"type":"heading","content":["Igi be dulemargi daergebe"]},{"type":"verse","number":27,"content":[{"text":"Dule-baidga-ibmar-nued-imaked begi siile, ega be imako,","poem":1},{"text":"melle ega imaksuli be guo.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Melle ega be sogo: “Be nagwerye, banedse an be-bendakoye.”","poem":1},{"text":"Ar emi sunna be a-dule-bendakele, bendaksabin be imako.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Melle be-ai-begi-bensuli-gudiidgi be aibino.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Melle dule-gwen-be-oakalossulidbo be urwo,","poem":1},{"text":"ar dule gwen-be-oakalossulid.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Melle dule-sabsurdamalad-e-ibmar-imakdiidgi be nobguo,","poem":1},{"text":"melle e-daedba be nanabalo.","poem":2}]},{"type":"heading","content":["Bab-Dummad dule-isgana-isdar-daked, dule-nueddi bendaked"]},{"type":"verse","number":32,"content":[{"text":"Ar Bab-Jehová dule-isganamar nue isdar-dakdaed.","poem":1},{"text":"Ar dule-nuegan-ebodi walikaa gudidaed.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Bab-Jehová, dule-nued-daed-e-neguyagi nued binsadaed,","poem":1},{"text":"dule-isgana-e-neguyadi, ukabsadaed.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Bab-Jehová, dule-emargi-dododimaladgi dododamogad,","poem":1},{"text":"ar dule-san-bipi-imakmaladdi, bendakdaed.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Dule-binsaed-ibegan-nug odummolegergebed.","poem":1},{"text":"Ar dule-binsaedsulidamaladdi, egi dodoleddaed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}