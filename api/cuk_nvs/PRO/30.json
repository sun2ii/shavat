{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":["Jaqué-machi-Agur-ibmarmar-sogsad. Agur, Itielʼga, degi, Ucalʼga weyob sunmaksad:"]},{"type":"verse","number":2,"content":[{"text":"“Andi dulemarba bur bule ibmar-wissulid,","poem":1},{"text":"akusunna an ibmar itoged.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Binsaed-nikaguedi an durdaksasulid,","poem":1},{"text":"Bab-Dummad-Isligwaledbela an akusunna itoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"”¿Doa nibnegse nakwiapi?","poem":1},{"text":"¿Doa nibneg-akar aidenoniki?","poem":2},{"text":"¿Doa e-argangi burwa gaoe?","poem":1},{"text":"¿Doa e-mor-dummadgi demar gaoe?","poem":2},{"text":"¿Doa napneg-naid-dikarmar omesisa?","poem":1},{"text":"¿Ar be wisi, doa we-ibmarmar-imaksa, degi, e-machi-nug be wisbali?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"”Bela Bab-Dummad-gayaburbagi bensuli guleged.","poem":1},{"text":"Bab-Dummadi, sigu-abgaedyob dule-egi-bendakleged-amimalad-irwa gwisgued.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Melle Bab-Dummad bega-sabsur-ibmar-sogega,","poem":1},{"text":"degi, melle dule-gakansaedga be-imakbaliga,","poem":2},{"lineBreak":true},{"text":"melle-e-gayaburbamar-maid be obulogo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"”Bab-Dummadye, unnila ibmar-sogbo an bese egised.","poem":1},{"text":"An burgwed-iduale, melle be anga imaksuli guo,","poem":2},{"lineBreak":true},{"text":"be anga we-ibmar-sogbogwad imakedsego:","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Igar-isganagi, gakan-igargi, be an-ollor-imake.","poem":1},{"text":"Melle dule-wilegedga, dule-mani-ibedga be an-imakbalo.","poem":2},{"lineBreak":true},{"text":"Unnila ibmar-nue-abelemaladi be anga ukmai imako.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ar an mani-ibedga gudele, abakar na be-iealile,","poem":1},{"text":"abakale an sokalile: ¿Ar doa wede Bab-Jehováʼye?","poem":2},{"text":"Degine, an wiledibalile, abakar ibmar-atursaarbalile,","poem":1},{"text":"degidbali, an be-nug-ichoge dakledagoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Melle mai-e-dummad-asabinni e-maigi ichakwa sunmako,","poem":1},{"text":"adi, melle, we-mai be-ukabsaega, degidbali, be dummad-wilegoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”Ar gwen-gwena dulemar gadi-e-bab-ukabsadaed,","poem":1},{"text":"degi, e-nangi ise-nued binsasurdabalid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ar gwen-gwena dulemar san-swilidikye na bidamalad.","poem":1},{"text":"Degi-inigwele, isguedginbi gudidamalad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ar gwen-gwena nuga-nikamaladye na sogdidamalad,","poem":1},{"text":"yamo bule-bule dulemarga gudidamalad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Gwen-gwena dulemar dule-wilemalad-wiogega, dule-ibmar-nue-abedimalad-wiogega,","poem":1},{"text":"es-suidyobi, e-nugar-imaksa gudidamalad, estinyobi, e-akugar-imaksa gudidamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"”Nus-abe-gobed, mimmigan warbo nikad,","poem":1},{"text":"amala unnila weyob sokardamalad: ‘Udage, napi-udage.’","poem":2},{"lineBreak":true},{"text":"”Ibmarmar geg wis-nubin-itodamaladi, sogbaa nikabalid.","poem":1},{"text":"Ibmar-sogbakegwaddi, ‘gusye’ geg sogdaed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"A-ibmarmar, wemalad:","poem":1},{"lineBreak":true},{"text":"Burgwarmalad-meged-galu, napi-dule-burgwarmalad-abedaed.","poem":1},{"text":"Ome-geg-mimmi-baked, mimmigan-abedaed.","poem":2},{"text":"Napa diibina napi-sogdaed.","poem":1},{"text":"Soo-duurmaksiid napi-sapan-abedaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"”Dule, urwakwaa e-bab-dakele, degi, e-nan-sogedba dasulile,","poem":1},{"text":"sikwisichid e-ibe ibya-onosun,","poem":2},{"lineBreak":true},{"text":"mula-non-ginnid, dula-gunsun.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"”Ibmar-sogbaagwad an geger itoged,","poem":1},{"text":"ibmar-sogbakegwaddi, an nue-aku itoged.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"A-ibmarmar, wemalad:","poem":1},{"lineBreak":true},{"text":"Mogir-billiba-sulubagi-nalla-naguedi, igi an magar itogoe.","poem":1},{"text":"Akwasaila-dummadgi-naibe-nakwedi, igi an nabir magar itogoe.","poem":2},{"text":"Demargi-ur-dummad-nadapir-geg-dogedi, igi an nabir magar itogoe.","poem":1},{"text":"Degine, igi an magar itobaloe, dule abirgunagwar-gudii gubidaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"”Ome, machered-dikarba-yoleged-e-daed weyobdo:","poem":1},{"text":"Ome, machered-baid-ebo nog-gobdedaed,","poem":2},{"text":"a-sorbali, na abalukdedaed.","poem":1},{"text":"An neg-oakalossurye sogdedaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"”Dulemar-ibmar-abedasulid-sogbaa nikadi, napneg-wawanmaker saed.","poem":1},{"text":"Sogbakegwaddi, napneg-giglimaker imaked.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"A-ibmarmar, wemalad:","poem":1},{"lineBreak":true},{"text":"Mai reyga megider, geger dakleged.","poem":1},{"text":"Dule-binsaedsulid mani-ibedga-guder, geger dakleged.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ome-galagwensuli-nanaed sui-nikuder, geger dakleged.","poem":1},{"text":"Mai-ome e-dummad-omegi dummadga-guder, bur bule geger dakleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"”Napneggi ibdurgan-burwigwad sogabake nikad,","poem":1},{"text":"dule-binsaed-ibedbali bur binsaed-ibeganad.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"A-ibdurgan wemardo:","poem":1},{"lineBreak":true},{"text":"Iglimar, sorda-gandikidsurmaladid,","poem":1},{"text":"degi-inigwele, yor-mosale, e-mas saboddamalad.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nubimar, dogdar sorda nikasurmalad,","poem":1},{"text":"degi-inigwele, akwa-ollogana-yaba e-gabedneg sobmalad.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Sesmar, e-idued satemalad,","poem":1},{"text":"degi-inigwele, darekwaa nadapdamalad.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Asbanmar, baisursunna argangi galemalad,","poem":1},{"text":"degite, reyneggi gudidamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"”Ibmar-sogbaa nikabalid, yeerdakle-gandikidba garmakdidaed.","poem":1},{"text":"Sogbakegwaddi, gandikidba nanadidaed.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"A-ibmarmar, wemalad:","poem":1},{"lineBreak":true},{"text":"Achumigur-nono-wawaad, ibmar-durgan-bamaladba bur buledid, ibmar-abin sikirmaked satedaed.","poem":1}]},{"type":"verse","number":31,"content":[{"text":"Gannir-machered, san-dummarbaa imakdidaed.","poem":2},{"text":"Sibad-machered, e-bebe burwisur-dakledaed.","poem":1},{"text":"Degine, rey, e-sorda-bila-onomalad-asabin e-ologurgin-sii nadapdaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"”Dule-binsaedsuliyobi be san-odummosale, melle bar egi be binsao.","poem":1},{"text":"Ibmar-isgana-imakedgi be binsas-gudiile, melle bar egi be binsao.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Dule, moli-nunis-eguredi, egi e-nunis-gwamakaled amied.","poem":1},{"text":"Binnasur be asa-ogolele, bega abe ariodagoed.","poem":2},{"text":"Be urwed-amiele,","poem":1},{"text":"urwenai be gudoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}