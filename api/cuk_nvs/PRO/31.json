{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":["Rey-Lemuel-ibmarmar-sogsad. E-nana we-igargi Lemuel-odurdaksad:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Machi, ¿igi an bega ibmar sogsale?","poem":1},{"text":"An-nukugi-dungued, ¿igi an be-unasale?","poem":2},{"text":"Bab-Dummadse-ise-egislegaled-mimmi-gued,","poem":1},{"text":"¿igi na bega binsaed uksale?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"”Melle omeganbina surbinsa itogo.","poem":1},{"text":"Bukidar reymar omeganse galakumaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"”Lemuel, reymar sisa-gobedi, igar-nuedsulid.","poem":1},{"text":"Dule-dummagan-negdakmaidi mumguedi, igar-nuedsurbalid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abakale, mumgudedgi, igar-maid iedmalale,","poem":1},{"text":"dule-wilemaladgi bar binsasuli gudmalale.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bur be dulemar-burgwedanigus-maidga sisa uke,","poem":1},{"text":"bur be dulemar-sae-itodiidga vino uke,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"adi, itoba na mumgumalagar, ibmar-abesa-gudiid, iemalagar,","poem":1},{"text":"ise-wilegar-gudiidgi mer bar binsamalagar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”Dule-belagwadamalad-ular be sunmake,","poem":1},{"text":"dule-sergan-sated-ibmar-ular be gwisgue.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wemar-ular be sunmake,","poem":1},{"text":"igar-napiragwadba ega be igar itoge,","poem":2},{"text":"dule-wilese-gudimalad be bendake.","poem":1},{"text":"Dule-ibmar-nue-abesagudimalad be bendake.”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ome-innikigwadba-e-daed-oyogedi, ¿doa amioe?","poem":1},{"text":"Ar akwa-nuegan-gargerbamaladba bur sunsogedid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"E-sui egi bensurdaed.","poem":1},{"text":"E-omeba ibmar nikagudaed, ega ibmar galakusurdaed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ome e-suiga, bane-bane ibidar-nuedga gued,","poem":1},{"text":"ibmar-isganaga ega gusulid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ome, lino-dub-baknaddaed, sibad-wawaad-e-absar baknaddabalid,","poem":1},{"text":"na yeer-itogedba e-gonugargi morgi arbadaed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Igi-ur-dummagan-ibmar-ukedi, dikasuli-mas-sedanidae,","poem":1},{"text":"debayobi, ome mas sedanidaed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bolegoedba gwichiguardaed,","poem":1},{"text":"masgi na e-mimmigan ogunnardaed,","poem":2},{"lineBreak":true},{"text":"e-maimarga, neggi-ibmar-imaklegedi urmakdaed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nainu-nued amidaed, geb nainu bakdaed,","poem":1},{"text":"nainugi, uvaʼbi bipirmaknai imakdaed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ome, arbaega, guagwar gunaidaed,","poem":1},{"text":"gandikidba na surgan-minaidaed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ome, e-ibmar-ukedi nueganbi nasgumaidaed.","poem":1},{"text":"Mutikidbali, e-neggi gwallu-dummad akinsisulid,","poem":2},{"lineBreak":true},{"text":"ar mutik-mutik arbasidaed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Argan-nailik mor-sobed-naku gani sidaed.","poem":1},{"text":"Argan-baidsik, dub ebisidaed.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ome, dule-wileged-bendakdaed,","poem":1},{"text":"dule-ibmar-abesaagudiid-bendakdaed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Dambed-sibudik-sibudik batealile, e-mimmiganga bukib-binsadasulid.","poem":1},{"text":"Ar bela e-mimmigan dambed-mor yoyoidbi damalad.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ome na dukin, ubsan-mor-uki mor-baid makdaed,","poem":1},{"text":"mor-suir-akwagiid yoidaed, lino-mor-sunsogmalad yoidabalid.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Dulemar bela neggweburgi e-sui mag-dakedbimalad.","poem":1},{"text":"E-sui, ibmar-dummadga dummagan-abargi simogad.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ome, lino-mor-nued-sobedi, saderba-mor-nagumalad-imakedi,","poem":1},{"text":"dulemar-ibmar-ukmaladga manigi ukdaed.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ome, innikigwadba gudidaed. E-nug dummarbaa gued.","poem":1},{"text":"Ibmar-guoedga, bukib binsadasulid, ega alledaed.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Sunmakdele, binsaed-nikaa sunmakdedaed,","poem":1},{"text":"dule-odurdakdele, sabekwaa dule-odurdakdaed.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"E-neguya-selemaidgi nue-nakuledaed,","poem":1},{"text":"e-mani-amiedginbi na mas-gundaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"E-mimmigan, e-nanga sokardaed, bedi nan-nuedye.","poem":1},{"text":"E-sui, e-ome-nug odummodamogad. Ega sogdaed:","poem":2}]},{"type":"verse","number":29,"content":[{"text":"“Ome-nuegan bukidar nikaye,","poem":1},{"text":"degi-inigwele, bedi amarba bur bule ome-nuedye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Yeerdaklegedi, dule-yamogedid. Yeerdaklegedi, sikwas yeer dakledaed.","poem":1},{"text":"Ome Bab-Jehová-dobee-nanaeddi, e-nug odummolegoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Dulemar, ome-e-ibmar-imaked magar dakmarsun.","poem":1},{"text":"Bela dulemar-abargi e-nug odummolesun.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}