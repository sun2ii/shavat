{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":4,"content":[{"type":"heading","content":["Be-bab-be-unaed be itoge"]},{"type":"verse","number":1,"content":[{"text":"Machimala, bab-be-unaed nue be itomala,","poem":1},{"text":"ibmar-nue-wisiguega nue-ise-itogale be imakmala.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Igar-nuegangi an be-odurdakgwelo,","poem":1},{"text":"melle an-ibmar-odurdaked be itosuli guo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"An bipigwaunni, an-babba-an-gudigusgua,","poem":1},{"text":"an-nana anbina bela-belad-sogdigusgua,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"an-bab an-odurdaksad, weyob anga sogsad:","poem":1},{"text":"“An-bega-ibmar-soged, ulubgi be nue-sedii imako.","poem":2},{"text":"An-bega-ibmar-soged be imako.","poem":1},{"text":"Deyob be imakele, we-napneggi suitii be gudiguoed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Binsaed-nikagued be amie,","poem":1},{"text":"ibmar-nue-wisigued be amie.","poem":2},{"text":"Melle be an-gayaburba iego,","poem":1},{"text":"melle egi be banguo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Binsaed-nikaguedgi melle be bangue,","poem":1},{"text":"ar a, be-bendakdii guoed.","poem":2},{"text":"Binsaed-nikaguedbina bur be soge,","poem":1},{"text":"ar a, be-edarbedii guoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ibmar-baigan-idu, nue-binsaed-nikagued bur be amie.","poem":1},{"text":"Bela ibmar baiganba, ibmar-nue-wisigued bur be amie.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Binsaed-nikaguedbina bur be soge,","poem":1},{"text":"ar a, be-nug-odummogoed.","poem":2},{"text":"Binsaed-nikagued bur be sabgue,","poem":1},{"text":"ar a, be-nug-ogannogoed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Binsaed-nikaguedi bega akwa-nuegan-ologurgingi-sigeyob gued.","poem":1},{"text":"Ologurgin-nonogi sigeyobi bega gued.”","poem":2}]},{"type":"heading","content":["Binsaed-nikaguedi burba-dulad-uked, nued-gudii be-imakbalid"]},{"type":"verse","number":10,"content":[{"text":"Machi, we-napneggi suibaksaar be gudiguega,","poem":1},{"text":"an bega-ibmar-soged, nue be itoge.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Binsaed-nikagued-igarba an be-semaid,","poem":1},{"text":"igar-innikigwadba-nanaega an be-imaked.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Be binnaa nadapsogele, bega ibmar-nueganbi guoed.","poem":1},{"text":"Amba be gwae-gwae nadapsogele, bega ibmar-nueganbi gubaloed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"An be-odurdaked mer be iego, melle be indako,","poem":1},{"text":"nue be sedio, we burba-dulagudiguega be-imaked.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dule-isganamarba melle be akae.","poem":1},{"text":"Amar-igarba melle be nanae.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"A-dulemargi be bangue.","poem":1},{"text":"Melle a-dulemar-walikaa be gudigue.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dule-isganamar ibmar-isgana-imaksurmalale, geg gabdamalad,","poem":1},{"text":"dule-oakalosurmalale, geg gabdamalad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ibmar-isgana-imaked mas-gunnedba bur-yeer itodamalad.","poem":1},{"text":"Sabsur-emar-imaked, vino-gobedba bur-yeer itodamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Igi bolegoe neg-ainakwiardae, deyobi, dule-nuegan-e-nanaedi gued.","poem":1},{"text":"Dule-nuegan-e-daedi, neg ibegwaledse-nasgumai-nasgumai-daeyobi gued.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Dulemar-isgana-e-nanaeddi negsichid-naidyobi gued,","poem":1},{"text":"wissurmalad, ibigi na yoledimala.","poem":2}]},{"type":"heading","content":["An-be-unaed nue be itogo, ina-nuedga bega guoed"]},{"type":"verse","number":20,"content":[{"text":"Machi, an bega binsaed-uked, nue be itoge,","poem":1},{"text":"ibmar-bega-an-soged, nuekwaa be itoge.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"An be-odurdakedgi melle be bangue,","poem":1},{"text":"gwage-ulubgi nue-sedii be imake.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ar dule binsaed-nikagunonikile, ega burba-duladga gued,","poem":1},{"text":"we-dulega ina-nuedga gubalid.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bela ibmar-sunsogmalad-baiganba, be-binsaedi nue-itoakwaa be ebugo.","poem":1},{"text":"Ar we-binsalegedgine, gudiguleged danikid.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Gaya-isgana-sunmaked be indake,","poem":1},{"text":"melle bar be gakansadii nanae.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ibmar-nueganginbi be atake,","poem":1},{"text":"yoo ibmar-danimaloedgi-atakdii be sae.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Be-nanadiid nue be dake.","poem":1},{"text":"Bela be-ibmar-imakedi innikigwadbi be imake.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Melle igar-nuedgi be aibane.","poem":1},{"text":"¡Igar-isganagi be bangue!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}