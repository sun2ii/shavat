{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":5,"content":[{"type":"heading","content":["Abirgunagwarsuli-nanaedgi bangued"]},{"type":"verse","number":1,"content":[{"text":"Machi, an-binsaed-nikagued an bega-ukedi, nue be itoge,","poem":1},{"text":"an ibmar-nue-wisidi an bega-sogedi, nue-ise-itogar be imake.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Adi, be sunmakalile, nue-itoakwaa sunmakegar,","poem":1},{"text":"nue-ibmar-wisi be guegar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ome-sui-dikarba-yoleged-e-agumakedi, ibmar-nuediyob sunmaked.","poem":1},{"text":"E-gwabin-ibmar-biedi, ibmar-nueganbi sogdaed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dule ese-binsaed-galesale, ina-gagbisailadyobi ega gued,","poem":1},{"text":"es-suid-nugar-darbogwadba bur bule dule-naibi-saeyob gued.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dule a-ome-ebogwa negsichidgi nanaele, burgwedse nilemaid.","poem":1},{"text":"Neg-uanse selemaid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"A-ome dule-egi-sunmakmalad bai-itosulid.","poem":1},{"text":"E-sunnasur-daedi, na bargasulid,","poem":2},{"lineBreak":true},{"text":"e-ichakwa-nanadiidi na aku itoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Machi, emigi nue be an-itoge.","poem":1},{"text":"An-ibmarmar-bega-sogedba be nanae.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ome-e-sui-yardakdiidgi, be bangue.","poem":1},{"text":"Melle e-neg-yawagakse be warmako,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"adi, melle dule-baid-aku-be-dakedga be-arbasadgi-ibmar-nikusad be ukegar,","poem":1},{"text":"melle be-burba-gandikid dule-baidga be ukegar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Degiile, dule-baid be-ganguedgi yeer-itogoed.","poem":1},{"text":"Degiile, be-arbasad-mani dule-baid-negse dogoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Geb agine, bela binna-binna be-san bergumaidba,","poem":1},{"text":"be bodii gudoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Agi be sogdoed: “Ar wede, ibiga dule-anga-binsaed-uksamalad an itossuli.","poem":1},{"text":"Ar wede, ibiga dule-sabsur-an-odurdaknaigua, an itossuli.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dule-anga-binsaed-daknanai-gusmalad an itossulid.","poem":1},{"text":"Dule-an-odurdaknanai-gusmaladba an ibsassulid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Emide, dulemar-abargi, an oitolegednaga gudiid,","poem":1},{"text":"wis ugak an gudiid.”","poem":2}]},{"type":"heading","content":["Ome-dikarba-yolesulid"]},{"type":"verse","number":15,"content":[{"text":"Be nog-gobbigualile,","poem":1},{"text":"be-ome-ebo be nog gobo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Unnila be-omesebi be golo,","poem":1},{"text":"melle be-omesulidse be golo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Be-ome unnila begadbiid,","poem":1},{"text":"melle dule-baidga be-ome be urmakdii nanao.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ome-bega-uklesadgi nued-binsalesun.","poem":1},{"text":"Nuchukwagwadgi bega abirgin-uklesad-ebo be wergudii gusun.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ome goe-sapuryob, yeer dakleged.","poem":1},{"text":"Ome wasa-omeyob, yeer dakleged.","poem":2},{"text":"Bele-bele be-imakar-sogele, egi be wergudii sao.","poem":1},{"text":"E-sabguedgi be wergudii guo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Machi, melle ome-baidse-binsaed-galedii be guo,","poem":1},{"text":"melle ome-baid be-werguega, be imako.","poem":2}]},{"type":"heading","content":["Dule-isganamar-e-odurdaklegoed"]},{"type":"verse","number":21,"content":[{"text":"Bab-Jehová bela dulemar-e-daed nue-wisid.","poem":1},{"text":"Dulemar-nanaedi egi gwen yoggumaisulid.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ibmar-isgana, dule-isganagi aibinoed,","poem":1},{"text":"e-isguedgi ollorguosulid.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Dule-isgana, igar-maidba-nanabisulidbali burgwidoed.","poem":1},{"text":"Na e-binsaed-satedbali, burgwidsunnoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}