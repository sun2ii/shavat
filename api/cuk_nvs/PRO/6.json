{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":6,"content":[{"type":"heading","content":["Emar-anar-mani-bennukedgi mer be binsao"]},{"type":"verse","number":1,"content":[{"text":"Machi, dule-mani-gasad-anar, be bennukoye sogsale,","poem":1},{"text":"igidibe, dule-baidga, be bennukoye igar mesisale,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"na be imakoye sogsadgi,","poem":1},{"text":"na be dukin yardaklesdo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Degisoggu, machi, emidi be-aise be yardaklesad.","poem":1},{"text":"Ar agi be ollorgubiele, weyob be imaksunna:","poem":2},{"text":"Ese be nae, egi be wilenae, ega be sognae,","poem":1},{"text":"an-bega-bennukoye-sogsadi, be anga osuloye.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Melle be ogabe,","poem":1},{"text":"melle be banega saboge.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Igi goe-sapur, dule-e-makbied-idu wakinne,","poem":1},{"text":"deyobi, dule-be-yardakbiedgi be wakinmoga.","poem":2},{"text":"Igi nuu dule e-gabied-idu wakinne,","poem":1},{"text":"deyobi, dule-be-yardakbiedgi be wakinmoga.","poem":2}]},{"type":"heading","content":["Melle dule-wiegalaga guo"]},{"type":"verse","number":6,"content":[{"text":"Dule-wiegala, nue be igli dake,","poem":1},{"text":"e-ibmar-imaked nue be dake,","poem":2},{"lineBreak":true},{"text":"binsaed-nikaguega eba be durdake.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Igli, ega-igar-uked sated,","poem":1},{"text":"e-dummad sated, e-idued satebalid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Degi-inigwele, dii-wisulidgine na e-mas onmaked,","poem":1},{"text":"ibmar-durba-weleged-ibagine na e-mas onmakdaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dule-wiegala, be meremaidi, ¿sanadse gwisguoye be soge?","poem":1},{"text":"¿Sanadse gabmaid be atakoe?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Be gabsiile, nono-yakumaksiile, sikwas napi-gabele,","poem":1},{"text":"sakwa-bipirmakar wis obunnosiile,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ukiarmakale, dule-atursaeyobi, begi wileged nonikoed.","poem":1},{"text":"Ukiarmakale, dule-negsuligudiidyobi, begi ibmarsuligued yolenonikoed.","poem":2}]},{"type":"heading","content":["Dule-isganamar-e-odurdaklegoed"]},{"type":"verse","number":12,"content":[{"text":"Dule-isgana, dule-galagwensuli-nanaed,","poem":1},{"text":"dule-gakansaedginbi-gudiid,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"dule-yardakega, ibya-biri-emar-daked,","poem":1},{"text":"dule-yardakega googi sunmaked, naggi sunmaked.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"We-dulemar unnila ibmar-isgana-imakedginbi binsadidaed,","poem":1},{"text":"aimar-ourwed yeer-itodaed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"A-ulale, ukiagwar egi bonigan yolenonikoed,","poem":1},{"text":"ukiagwar berguoed.","poem":2}]},{"type":"heading","content":["Bab-Dummad ibmar-sogagugle (7) isdar-daked"]},{"type":"verse","number":16,"content":[{"text":"Bab-Jehová ibmar soganergwa (6) sae-daked,","poem":1},{"text":"napi-ibmar-sogagwenad-baid bur-bela-bela isdar daked.","poem":2},{"text":"We-ibmarmar-sogagugled (7) isdar daked:","poem":1}]},{"type":"verse","number":17,"content":[{"text":"Dule-na-san-dummarba-imaked,","poem":2},{"lineBreak":true},{"text":"dule-gadi-gakansaed,","poem":2},{"lineBreak":true},{"text":"dule-binsarsunna-aimar-gindaked,","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"dule-galagwensuli-dule-baidgi-binsaed,","poem":2},{"lineBreak":true},{"text":"dule-ibmar-isganabi-imakdidaed,","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"dule-ibmar-daksad-gakansaar-ibmar-soged,","poem":2},{"lineBreak":true},{"text":"gwenadgan-gwenadgan-ourwed-dule.","poem":2},{"text":"We-ibmarmar, Bab-Jehová isdar daked.","poem":3}]},{"type":"heading","content":["Be-sergan-bega-sunmakedba be ibsae"]},{"type":"verse","number":20,"content":[{"text":"Machi, be-bab-be-odurdakedba be ibsae.","poem":1},{"text":"Be-nan-be-unaedba, be dae.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Be-gwagegi-sedigu, be imake,","poem":1},{"text":"ordub-be-dukargi-naiyob, be imake.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"We-binsaed-nuegan, be bia nadele, be-idumai guoed.","poem":1},{"text":"Be gabidele, be-edarboed.","poem":2},{"text":"We-binsaed-nuegan, be atakar-sogele, bega sunmaknai guoed.","poem":1}]},{"type":"verse","number":23,"content":[{"text":"Igarmar-Mamaidi, gwalluyobi gued,","poem":2},{"text":"ibmar-odurdakleged neg-meegwadyobi gued.","poem":1},{"text":"Igar-nuegan-mamaidba-nanalegedi, be-odurdakoed igi be nanaergebe.","poem":2}]},{"type":"heading","content":["Abirgunagwarsuli-nanalegedgi bangued"]},{"type":"verse","number":24,"content":[{"text":"We-binsaed-nuegan, melle be ome-isganabo galagwensuli nanadiguega be-imakoed.","poem":1},{"text":"Melle be ome-sui-dikarba-galagwensuli-gudiidbo nanaega be-imakoed.","poem":2},{"lineBreak":true},{"text":"Melle we-ome-e-ibmar-nued-sogedgi be binsaed-galediguega be-imakoed.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Melle ome-isgana-e-yeerdaklegedbina be sogo.","poem":1},{"text":"Ome-isgana be-dakedgi, melle ese be-binsaed galego.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ar ome-gambanuchu-imaked unnila masbina gudiid.","poem":1},{"text":"Ome-sui-dikarba-yolegeddi, bela be-sanbina sogdiid.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ar dule na e-nukugi soo-sisale,","poem":1},{"text":"¿ei mor gummaksasulir be insae?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ar dule soo-birgi nanaele, ¿ei nag gummaksasulir be insae? Ei gummaksale.","poem":1}]},{"type":"verse","number":29,"content":[{"text":"Dule, dule-baid-ome-ebo negsichigi nanaedi, soogi-gummakeyob boni-amiedsemogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Dule-atursaed ukudmaada-itogedba ibmar-atursasale,","poem":1},{"text":"¿isdar dakdamarsursi?","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Dule-atursaed daklesardi, ilagugle (7) ibmar-atursasad bennukoed.","poem":1},{"text":"Sulirdi, bela e-neggi-ibmar-nikad ukoed.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Dule ome-baidbo negsichidgi nanaele, we-dule, binsaed-satedid.","poem":1},{"text":"Dule deyob-daedi, na dukin san-wioged.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Unnila binged-amiedid, na dukin naibid-amiedid.","poem":1},{"text":"E-nug-gagalesad gwen ega alliosulid.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ar we-ome-e-sui nobedba uludele, na san gwen bargaosulid,","poem":1},{"text":"igi-barsaye gwen sogosulid.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Dule amba ome-e-suiga ibmar-ukye sogele,","poem":1},{"text":"gwen abingaosulid.","poem":2},{"text":"Ar amba ega ibmar-dummarba-ukye sogele,","poem":1},{"text":"igi-barsaye gwen sogosulid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}