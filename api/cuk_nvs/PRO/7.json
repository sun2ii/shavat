{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":7,"content":[{"type":"heading","content":["Binsaed-nikaguedi, ome-negsichigi-nanaedgi be-ollorsaoed"]},{"type":"verse","number":1,"content":[{"text":"Machi, bega-an-ibmar-sogedba be dae,","poem":1},{"text":"igargan-an-bega-ukedba be nanae.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Igargan-an-bega-ukedba be nanaele, be dula gudiguoed.","poem":1},{"text":"Be-ibyagwag be akweyobi, an-bega-ibmar-sogedba be ibsae.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"An-be-unaedi, olargan-googi-yoiyobi, be sedii sae,","poem":1},{"text":"be-gwagegi nue-ebinsadii be imake.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Binsaed-nikaguedga be soge: “Be an-bunye.”","poem":1},{"text":"Ibmar-wisiguedga be soge: “Be an-ai-nuedye.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Adi, wemar, ome-sui-dikarba-yolediidgi, be-ollor-imakoed,","poem":1},{"text":"ome-e-agumakedba-emar-binsaed-gaedgi, be-ollor-imakoed.","poem":2}]},{"type":"heading","content":["Ome-emar-binsaed-gaed, degi, sapingwa-binsaedsulidaed"]},{"type":"verse","number":6,"content":[{"text":"An-neggi, yawagak-bipigwad-imbaba an atakded.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"An dakalid, sapingana-binsaedsurmalad-abargi, machi-wargwen bur-binsaed-sated gudii.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"We-sapingwade, igar-abingunaidse warmakdapid,","poem":1},{"text":"agi ome-e-sui-dikarba-yolediid-negse naded.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Deunni, neg-sedomaid, neg nue-gutuleded,","poem":1},{"text":"degi, neg nue-mutikguded.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Geb agine, ome e-abin-noalid. Ome gambanuchu-imakedyob mor-yoid.","poem":1},{"text":"E-daedi, mag-dakleged, macherganbina sognadapid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"We-ome neg-gagadidaed, gwinni-gwinni daed,","poem":1},{"text":"geg neggi siged, galimbabi wisid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Galimbaba gudidaed, dulemar-bukidar-ambikuedgi gudidabalid.","poem":1},{"text":"Igi-saele machered-wargwen-yardakodibeye binsadidaed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"We-ome, sapingwa-daksagua, gadebinne imaksad,","poem":1},{"text":"ei wagar usa imaksad.","poem":2},{"lineBreak":true},{"text":"Ega bingesuli sogded:","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Gwenatigwar-guega Bab-Dummadga an ibmar-ukoye an sogsad.","poem":1},{"text":"Deyob an sogsadi, emi deyob an imaksad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"A-ulale, an be-abin noalid.","poem":1},{"text":"An be-amidii gusad,","poem":2},{"lineBreak":true},{"text":"emide an be-abingunonisunnad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"An-gabedgi atue-nued-yeerdakleged, lino-dubgi-sobaled-Egiptoʼgi-danikid an ogichad.","poem":1}]},{"type":"verse","number":17,"content":[{"text":"An-gabedgi ina-wawadikmalad, mirraʼye-nugad, áloeʼye-nugad, degine, canelaʼye-nugad an eosad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Anba be dage. Anmar nog-gobmai oibodagoed.","poem":1},{"text":"Oibogedse anmar nog-gobmai imakmaloed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ar an-sui neggi gudisulid,","poem":1},{"text":"dikasuli neggwebur-baidse naded.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mani-ichesuli sesa-naded,","poem":1},{"text":"geb nii-dalu-naidse gannar negse aibiroed.”","poem":2}]},{"type":"heading","content":["Sapingwa ome-ega-agumakedgi binsaed-galesad"]},{"type":"verse","number":21,"content":[{"text":"Weyobi, ome, agumaksadgi,","poem":1},{"text":"machigwa-binsaed-gasad.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Moli-alugwasualedi, e-oburgwilegedse ebipilemaiyobi, machigwa ome-sorba-nai nadapid.","poem":1},{"text":"Goe-sapur galesgunaidgi sigu egi yolenonikiyobi, machigwa gued.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Igi nuu burgwed-wissuli saki-naidse naddae,","poem":1},{"text":"machigwa deyobi gued.","poem":2}]},{"type":"heading","content":["Ome-emar-binsaed-gaedgi banguo, degisulile, be burgoed"]},{"type":"verse","number":24,"content":[{"text":"Machi, emigi nue be an-itoge,","poem":1},{"text":"an-be-unaed nue-itosii be imake.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Melle a-omegi-binsadii be sae,","poem":1},{"text":"melle a-omese be binsaed galege.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ar a-omese bukidar machergan yardaklediid.","poem":1},{"text":"Machergan-bukidargus ese burgwedanikid.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"We-ome-negse be nadele, be burgoed.","poem":1},{"text":"A-igar burgwedse dule-semaid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}