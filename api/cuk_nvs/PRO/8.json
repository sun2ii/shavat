{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":8,"content":[{"type":"heading","content":["Binsaed-Nikagued dulemarse gornaid"]},{"type":"verse","number":1,"content":[{"text":"Binsaed-Nikagued, ¿anmarse iseedi gornaisursi?","poem":1},{"text":"Ibmar-wisigued, ¿iseedi gornaisursi?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Binsaed-Nikagued, igarba yar-birigwagi gorgwisdaed,","poem":1},{"text":"igarmar-abingunanaidgi gorgwisdaed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Neggwebur-doged-e-yawagakmar-dikarba ise-gollar gornaidaed.","poem":1},{"text":"E-yawagak-dogedgine binnasuli weyob-gornaid:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Machergan, bemarse an gornaid,","poem":1},{"text":"bela-dulemar-bukwadse an gornaid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bemar-ibmar-wissurmalad, itoakwaa be gudisamala.","poem":1},{"text":"Bemar-binsaedsate-gudimalad, ibmar-magar-itoged be amimala.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nue an-itomalo, an ibmar-nuegan sogesokalid.","poem":1},{"text":"An-gwabinduku igar-innikigwadba sunmaksokalid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"An ibmar-sogedi gakangi sunmakosulid,","poem":1},{"text":"ar gakanmar an nabir-daksulid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"An-gayaburbamar, igar-innikigwadbi sunmaked,","poem":1},{"text":"darbo sunmaksulid, ibmar-isganagi sunmaksulid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"An-gayaburbamar, dule-magar-neg-itogedgala baisursunna-noed.","poem":1},{"text":"Dule-binsaed-ibeganga, an-gayaburbamar innikigwadbi ega noed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mani-abelegedba an-ibmar-odurdakedbina bur bule be sogmala.","poem":1},{"text":"Olo-nued-abelegedba ibmar-wisgulegedbina bur bule be sogmala.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar Binsaed-Nikagued, dimmurgiid-e-akwa-yeerdaklegedba bur bule ibnuedid.","poem":1},{"text":"Ibmar-bur-nued egi obinsulid,","poem":2},{"lineBreak":true},{"text":"ar ibmar-baid-ebo geg wilub-imakleged.”","poem":2}]},{"type":"heading","content":["Binsaed-Nikagued-e-damalad"]},{"type":"verse","number":12,"content":[{"text":"“Ani an Binsaed-Nikaguedi, itoakwaa-binsaedbogwa an gudiid.","poem":1},{"text":"Ibmar-wisigued an nikad, itoakwaadaed an nikabalid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dule, Bab-Jehová-dobekwaa nanadiile,","poem":1},{"text":"isdar ibmar-isgana daked.","poem":2},{"text":"Ar san-dummarba-imaked, an isdarsun daked,","poem":1},{"text":"san-bule-bule-saed, an isdar dakbalid.","poem":2},{"lineBreak":true},{"text":"Sunnasur-daed, galagwensur-sunmaked, an isdarsun dakbalid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Binsaed-uklegeddi, angi maid,","poem":1},{"text":"nuekwa-igar-nabolegeddi, angi maibalid.","poem":2},{"text":"Neg-magar-itolegeddi, angi maid,","poem":1},{"text":"gargangueddi, angi maibalid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ani an Binsaed-Nikaguedi, an-sogedba reymar wis negsedimalad.","poem":1},{"text":"An-sogedba dule-nug-nikamalad, wis igar-innikii nabodimalad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"An-sogedba dule-nug-nikamalad negsedimalad,","poem":1},{"text":"an-sogedba dule-negsedimalad napneg-sedimalad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dule-an-sabmaladi, an sabmogad.","poem":1},{"text":"Dule-an-amidimaladi, baisursunna an-amimalad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ibmar-bukidar-nikuleged angi danikid,","poem":1},{"text":"nuga-nued-nikuleged angi danibalid.","poem":2},{"text":"Nue-nasguleged-degisadeguad angi danikid,","poem":1},{"text":"igar-inniki-imakleged angi danibalid.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"An-binsaed-ukedi, olo-nuedba bur-nuedid.","poem":1},{"text":"Angi-binsaed-nued-amilegedi, mani-nuedba bur-nuedid.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ani an Binsaed-Nikaguedi, igar-inniki-imaklegedba an nanaed,","poem":1},{"text":"igar-inniki-naboleged-igarba an gudiid.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Dule-an-sabesar-gudimalad an onasgudiid,","poem":1},{"text":"ibmar-nued-bukidar-nikubaliga an imakdiid.”","poem":2}]},{"type":"heading","content":["Binsaed-Nikagued-e-danikid"]},{"type":"verse","number":22,"content":[{"text":"“Bab-Jehová ibmar-obinyed-iduale, bato anga burba-dulad uksad.","poem":1},{"text":"Amba-yoo ibmar-obinyegua, bato an-obinnisad.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yoo neg-nagued-iduale, Bab-Jehová an-obinnisad.","poem":1},{"text":"Napneg amba yoo nagugua, sailanagi an-obinnisad.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"An gwalulesgua, demar-wilagan amba yoo nagued.","poem":1},{"text":"An gwalulesgua, suke-dummagan amba yoo megmalad.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yala-dummagan-nagued-idu, an gwalulesad,","poem":1},{"text":"yala-senigana-ambikued-idu, an gwalulesad.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bab-Dummad amba yoo napneg-nasikgua,","poem":1},{"text":"amba yoo sapurmar-bukwad-nasikgua,","poem":2},{"text":"amba yoo napa-buru-napneg-sobsad-obinyegua,","poem":1},{"text":"bato an gwalulesad.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bab-Dummad mogir-arad-nasiknaigua, a-idu, bato an gudiid.","poem":1},{"text":"Mogir-demarbo-abingunaid-nasiknaigua, a-idu, bato an gudiid.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Bab-Dummad mogirmar-nasiknaigua, a-idu, bato an gudiid.","poem":1},{"text":"Demar-wiladgine suke-dummagan-ogannonaigua, a-idu, bato an gudiid.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Bab-Dummad demar-mer-murega, demargala igar-abingunanaid-ilemaknaigua, a-idu, bato an gudiid.","poem":1},{"text":"Napneg-e-sailagan-mesnaigua, a-idu, bato an gudiid.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Bab-Dummadbogwa bela igar-ilemaknai an gusad.","poem":1},{"text":"Iba-ilibali weligwar an-itodidaed.","poem":2},{"lineBreak":true},{"text":"Bab-Dummad-asabinni iba-ilibali an wergudidaed.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Bab-Dummad-napneg-obinnisadgi an wergudiid,","poem":1},{"text":"dulemar-gudimaladba an wergudiid.”","poem":2}]},{"type":"heading","content":["Burba-dula-gudigued amie, melle burgwedgi binsae"]},{"type":"verse","number":32,"content":["Ani an Binsaed-Nikaguedi sogbalid:",{"text":"“Degisoggu, mimmigan, nue an-itomalo:","poem":1},{"text":"Dule an-igar-maidba-nanadiile, egi ise-nued binsalesad.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"An-binsaed-uked be-nue-itomala,","poem":1},{"text":"binsaed-nikaa be damala, mer baisur-dakmala.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Dulemar-nabir-an-itodimalad, bane-bane an-yawagak-naba an-edarbedimalad,","poem":1},{"text":"we-dulemargi ise-nued binsalesad.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ar dule an-aminonidibe, burba-dula-maid aminonikoed.","poem":1},{"text":"Bab-Jehová we-dulegi nabir binsanonikoed.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Dule an-obandibe, na dukin bonigan-amioed.","poem":1},{"text":"Dule isdar an-dakdibe, na burgwed-amied.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}