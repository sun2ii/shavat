{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PRO","translationId":"cuk_nvs","name":"Proverbios","commonName":"Proverbios","title":"BINSAED-NUEGAN-GARDA PROVERBIOS","order":20,"numberOfChapters":31,"sha256":"c9db394f04f6ed7cb8db42e54a14c7d17b1ebd1dd9d29df51c155d1cb77fbbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cuk_nvs/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":9,"content":[{"type":"heading","content":["Binsaed-Nikagued, binsaedsulidaedse gochad"]},{"type":"verse","number":1,"content":[{"text":"Binsaed-Nikagued na e-neg-sobsad,","poem":1},{"text":"e-buarmar walagugle (7) ogwichisad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Binsaed-Nikagued iba-dummad onosad,","poem":1},{"text":"vino-nued imaknai gualid,","poem":2},{"lineBreak":true},{"text":"mese guakwaa siinai guarbalid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Binsaed-Nikagued, e-garda-berbemalad barmisad,","poem":1},{"text":"neggwebur-siid-birise barmisad","poem":2},{"lineBreak":true},{"text":"agi iseedi gorbukwa gumalagar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dule-binsaedsurmaladga weyob sogded:","poem":1},{"text":"“Dule-binsaedsurmalad, anse be dagmala.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dagmala, an-mas-nued gundamala,","poem":1},{"text":"an-vino-oburusad be gobdamala.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ar be nabir-gudii gubimalale, be binsaedsuli-gudimalad osulomalargebed,","poem":1},{"text":"binsaed-nikaa be gudigumalargebed.","poem":2},{"lineBreak":true},{"text":"Deyobi, geb be nabir-gudii guoed.”","poem":2}]},{"type":"heading","content":["Dule-isgana-e-daed, degi, dule-binsaed-ibed-e-daed"]},{"type":"verse","number":7,"content":[{"text":"“Be dule-gwen-nabir-dasurmaladse be gotedibe,","poem":1},{"text":"melle ibmar-isgana be imakye,","poem":2},{"lineBreak":true},{"text":"aka bese-urwega ese be goloed.","poem":2},{"text":"Ar be dule-isganase uluddibe,","poem":1},{"text":"aka bese-urwega guoed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dule-gwen-nabir-dasulidse, mer be gole.","poem":1},{"text":"Aka sae-be-dakega ese be goloed.","poem":2},{"text":"Dule-binsaed-nikadse be gotedibe, mer ibmar-isgana be imakye,","poem":1},{"text":"we-duledi, be-sabguoed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dule-binsaed-nikagued be odurdakele, a-dule, bur bule binsaed-nikaa naoed.","poem":1},{"text":"Dule-inniki-gudiid be odurdakele, a-dule, bur bule binsaed-nikaa naoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Dule binsaed-nikarba-gubidibe, Bab-Jehová-dobekwaa-gudii guergebed,","poem":1},{"text":"Dule, Bab-Dummad-Isligwaled wisgubiele, ibmar-wisirba-gued na oyonaid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar ani, Binsaed-Nikagued, angi be-ibagan-gudiid suitii guoed,","poem":1},{"text":"an-nukad deyob guoed.","poem":2},{"lineBreak":true},{"text":"Be-burba-dula-gudiid birgaba sugumai guoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Be nabir-binsaed-nikarbaddibe, we-binsaed-nikagued ibnuedga bega gunonikoed.","poem":1},{"text":"Be galagwensulidaeddibe, na be dukin nunmaked-itodii guoed.”","poem":2}]},{"type":"heading","content":["Binsaedsulidi, binsaed-satemaladse gornaid"]},{"type":"verse","number":13,"content":[{"text":"Binsaedsulid, yaisur neg-gagadaed,","poem":1},{"text":"gwen ibmar wissulid,","poem":2},{"lineBreak":true},{"text":"gwen nabir binsasurbalid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Binsaedsulid, e-neg-yawagak-naba sigoed.","poem":1},{"text":"Neggwebur-dogedgine, bela-e-dakmalagala, neggwebur-birigwagi sigoed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Binsaedsulid, dule-igarba-gudidamaladse gorsidaed,","poem":1},{"text":"binsaedsate-gudidamaladse gorsidaed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Weyob dule-binsaed-satemaladga sogdedaed:","poem":1},{"text":"“Be anse dagmala.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dii-atursaaled bur-nued gobleged,","poem":1},{"text":"mas-nued arbakee-dukuar-gullegedi, bur-nued gulleged.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ar we-dule-binsaed-satemaladdina, agi burgwed-amileged wissurmalad.","poem":1},{"text":"Ar dule-binsaedsulidba-ibsasmaladi, emisgindi neg-urba mamaid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}