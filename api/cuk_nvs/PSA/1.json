{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"heading","content":["Dule-nuegan, dule-isganamar"]},{"type":"verse","number":1,"content":[{"text":"Dule, dule-binsaed-isganaba nanadisulile, dule-isgudimaladba akadisulile, dule-Bab-Dummadgi-dododimalad-abargi gudisulile,","poem":1},{"text":"we-dulegi, Bab-Jehová nued binsadiid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"We-dule, Bab-Jehová-Igar-Maidgi bur wergudisunnad.","poem":1},{"text":"A-igargi, mutikidbali, ibginedbali, egi binsadisunnad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"We-dule, igi sapi diwar-naba aramakgwisdae,","poem":1},{"text":"e-iba-sogedba sanmakdedae, deyobi gued.","poem":2},{"text":"Bela na e-ibmar-imaked ega nueganbi naddaed.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dule-isganamardi, degisulid.","poem":1},{"text":"Igi oros-uka burwaba mileddae, deyobi, dule-isganamardi guoed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"A-dule-isganamarga igar-itolealile, gwen san-onogosurmalad.","poem":1},{"text":"Degisoggu, dule-isganamar dule-nuegan-abargisii guosurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bab-Jehová dule-nued-damalad nue-bendakmaid.","poem":1},{"text":"Dule-isganamardi, degi-bergudmaloed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}