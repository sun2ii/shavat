{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":10,"content":[{"type":"heading","content":["Bab-Dummadse bendaklegega goled"]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼye, ¿ibiga be angi yoggus gudii? ¿Ibiga be an-idu dukue?","poem":1},{"text":"An bonigan-abalagi-gunaidgi, aisaar an bebina bela-bela gudidaenad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Dule-isgana na-san-bule-bule-imakedgi, sabsur dule-wileged-baregindaed.","poem":1},{"text":"Degi-inigwele, we-dule-isgana, na dukin e-ibmar-isgana-imakedgi yoleged.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dule-isgana, sulibinsa-ibmarbina-sogedgi na san-ogannodiid.","poem":1},{"text":"Dule-isgana, dule-ibmarbina-suli-suli-itodimalad-e-nug ogannoged,","poem":2},{"lineBreak":true},{"text":"Dule-isganadi, isdar be-daked.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Dummadye, dule-isgana bule-bule-san-imakedbali, be-amisulid.","poem":1},{"text":"Bipisaale begi binsasulid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bela-ibmar-imakdele, ega ibmar-nueganbi naddaed.","poem":1},{"text":"Bab-Dummad, we-dule-isgana, Be-Igar-Mamaidgi gwen binsadisulid,","poem":2},{"text":"ar akusunna daked.","poem":1},{"text":"Ar dule-isgana, mesagwar e-isdarmalad-imakdaed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"E-gwagegi weyob binsadaed:","poem":1},{"text":"“Dulemar gwen-an-oakalogosurye,","poem":2},{"text":"bipisaale an boni nikuosurye,","poem":1},{"text":"unnila, an weligwar gudii guoye.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"E-sunmakedi, unnila dule-ukabsaedginbi sunmaked,","poem":1},{"text":"gakansaedginbi sunmaked,","poem":2},{"text":"dulemar-sabsur-imakedginbi sunmaked.","poem":1},{"text":"E-gayaburba unnila emar-oakalogedginbi sunmaked.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dule-isgana emar-naibi-imakega, galimbaba gudidaed.","poem":1},{"text":"Arbakee dulemar-argadidaed, emar-idu dukusidaed,","poem":2},{"lineBreak":true},{"text":"adi, ukiar emar-oburgwegar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"We-dule, igi achumigur dule-baisur-binsadiidgi-ichomakegala, e-dukued-yaba-dukusidae,","poem":1},{"text":"dule-ganonikir, ebipiddae,","poem":2},{"lineBreak":true},{"text":"deyobi, we-dule-isgana, emar-naibi-imakega gudiid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ar deyobi, dule-e-bendakedsuli-gudiidi, dule-isganase-galenonikile, ese nue sabsur-ibitoged.","poem":1}]},{"type":"verse","number":11,"content":[{"text":"We-dule-isgana ulubgi binsaed:","poem":2},{"text":"“Bab-Dummad we-ibmargi gwen binsamaisurye.","poem":1},{"text":"We-ibmar-mer-dakegala, e-wagar biir imakdaye.","poem":2},{"lineBreak":true},{"text":"Ar Bab-Dummad neg-gunaid gwen dakmaisurye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"¡Bab-Jehováʼye, be dake!","poem":1},{"text":"¡Bab-Dummadye, be-gangued be oyoge!","poem":2},{"text":"¡Melle be dule-wilediid iege!","poem":1}]},{"type":"verse","number":13,"content":[{"text":"¿Ibiga we-dule-isganade, e-sunmakedgi mesagwar be-imakosunna?","poem":2},{"text":"¿Ibiga we-dule-isganade, ulubgi binsaosunna:","poem":1},{"text":"“Bab-Dummad gwen anga akar sogosurye?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Bab-Jehováʼye, ar bedi bato neg-gunaid daksad,","poem":1},{"text":"sabsur-ibitonanaid bato be daksad,","poem":2},{"lineBreak":true},{"text":"nunmakedba-galitonanaid be daksad.","poem":2},{"text":"Ar bedi, sogedba be we-ibmar nudakoed.","poem":1},{"text":"Dule-ibmar-suli-gudimaladi, begi bensur gudimalad.","poem":2},{"lineBreak":true},{"text":"Ar be, dule-sergan-sated-bendakedid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"¡Bab-Dummadye, dule-isgana-ibe be e-gangued-osuloge!","poem":1},{"text":"¡Dule-isgana e-isgued-imakedba be sabsur odurdake!","poem":2},{"lineBreak":true},{"text":"¡We-dulemar we-napneggi-obelogedse be imake!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bab-Jehováʼye, be degisadegu Reyga maid.","poem":1},{"text":"Dulemar-aku-be-dakmaladdina, be-yargi bela obelolemaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Bab-Jehováʼye, dule-wilegana-bese-goled be itodaed.","poem":1},{"text":"Dule-wilegana-e-niga be ogannodaed.","poem":2},{"lineBreak":true},{"text":"Bese ibmar-egisder ega be ukdaed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bab-Jehová dule-sergan-satedga, degi, dule-wiledimaladga, igar-innikigwad imakdaed,","poem":1},{"text":"adi, dule-we-napnegginmaladi, melle bar emar-wiodii gumalagar.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}