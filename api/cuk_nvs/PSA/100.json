{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":100,"content":[{"type":"heading","content":["Bab-Dummadga doggus-nuedye soged"]},{"type":"hebrew_subtitle","content":["Bab-Dummadse-goled-negse-dognadapidgi, we-namaked-doggus-nuedye-sogleged namakleged."]},{"type":"verse","number":1,"content":[{"text":"Bela-napneggi-dulemar-bukmalad, weligwaledgi, be Bab-Dummadga namakmala.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Weligwaledgi, Bab-Jehová-nug be odummomala.","poem":1},{"text":"Yeer-itogedgi, e-asabinni be namakdamala.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová-Bab-Dummad-gued be magar-dakmala.","poem":1},{"text":"E anmar-obinnisad. Anmar, egadid.","poem":2},{"text":"Anmar e-dulamalad.","poem":1},{"text":"Anmar, e-sibad-wawaadyob gumalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Doggus-nuedye-sognai, ese-goled-negyaba be dogmala,","poem":1},{"text":"Namakar e-nug-odummonai,","poem":2},{"lineBreak":true},{"text":"e-neg-imbase be dagmala.","poem":2},{"text":"¡Ega be doggus-nuedye sogmala!","poem":1},{"text":"¡E-nug be odummomala!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ar Bab-Jehová dule-nuedid, e-sabguedi degisadeguad.","poem":1},{"text":"E-innikidaedi gege bergued.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}