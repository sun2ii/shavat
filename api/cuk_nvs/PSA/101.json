{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"heading","content":["Bab-Dummadga-innikii-nanaoye-soged"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová, namaklegedgi an bega namakoed.","poem":1},{"text":"Sabguedgi, an namakoed,","poem":2},{"lineBreak":true},{"text":"igar-innikii-imaklegedgi an namakoed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nued nanadii an gubied.","poem":1},{"text":"¿Wede sana be anse ataknonikoe?","poem":2},{"lineBreak":true},{"text":"An-neggi gwage-napiragwadgi an nanadii gubied.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ibmar-isganagi an atakbisulid.","poem":1},{"text":"Igar-isgana an imakbisulid.","poem":2},{"text":"Dule-Bab-Dummad-Igargi-banguddamalad an sae-daked.","poem":1},{"text":"Amala anse-warmaked an imakosulid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Binsaed-isganamargi an banguoed.","poem":1},{"text":"Ibmar-isgana an imakbisulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dule dule-baidgi-arbak-sunmaked an obelogoed.","poem":1},{"text":"Dule-san-dummarba-saed, anse-warmaked an imakosulid.","poem":2},{"lineBreak":true},{"text":"Dule-baigangi-obinye-soged, anse-warmaked an imakosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"We-yargi dule-be-igarba-nanamalad, anba-gudigumalaga an amioed.","poem":1},{"text":"Dule-be-igar-maidba-nanadimaladbi, anga arbamaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dule, dule-yardakmaladgi-arbamaladi, an-negyagi gudii guosulid.","poem":1},{"text":"Dule gakansaar-sunmakedi an-asabin gudii guosulid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bane-bane we-yargi dule-isganamar-gudimalad obelomai an imakoed.","poem":1},{"text":"Bela dule-ibmar-isgana-imakmalad, Bab-Jehová-neggweburgi an onogoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}