{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":102,"content":[{"type":"heading","content":["Dule-naibi-itodiid Bab-Dummadse-goled"]},{"type":"hebrew_subtitle","content":["Dule-naibi-itodiid, gege-bar-gugusadgi Bab-Jehováʼse ise-boar gornaid."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼye, an bese-gornaid be itoge,","poem":1},{"text":"wilesagwar-an bese-gornaid bese mosana gadin.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bonigan angi-yolenonikile, mer be an-idu dukuo, nue be an-itogo.","poem":1},{"text":"An bese-gornaile, gwae be an-abin-imako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"An-ibagande, waayob bergudedaed.","poem":1},{"text":"An-garmardina, soogi-gummaknaiyob itoleged.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"An-gwage ber nollomakded,","poem":1},{"text":"gaganyob dinguded,","poem":2},{"text":"ukuddi bar an itosurgusad.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"An binnasuli-akiginnedbali, an-garmardi daledgusad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Noo-negsulidganba-gukudiidyobi, an wargwen itoged.","poem":1},{"text":"Irmon-neg-ayaraledgangi-gudiidyobi, an wargwen garmakdiid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bar an gabdisulid,","poem":1},{"text":"sikwi-walagwen-uas-birgi-gudidaedyobi, an gudiid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"An-isdarmalad bane-bane mesagwar an-imakdimalad,","poem":1},{"text":"yogasaar an-nug-oichogega an-nug-gadimalad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Degisoggu, sooburu an madisunnad.","poem":1},{"text":"An-ibyanisde, an-gobedba-mesa an gobdisunnad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Dummad, be sabsur-uludedbali, sabsur-an-imaksa gusad.","poem":1},{"text":"Sabsur-nakwaa be an-imaksagu, be an-barmeted.","poem":2},{"lineBreak":true},{"text":"Deyob be an-wiosad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"An-ibagande, negsichiledanikiyobi, bato bergudanikid.","poem":1},{"text":"Gagan-dinguddaedyobi, an guded.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bab-Jehová, ar bedina, degisadegu be negsemai guoed.","poem":1},{"text":"Be-nugdina berguosulid, degisadeguoed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Be, Sión-dulemar bendaknonikoed,","poem":1},{"text":"be-sabgued ega be oyononikoed.","poem":2},{"lineBreak":true},{"text":"Ar a-ibagan bato nagunonikid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Anmar-be-maimar, Jerusalén-neggweburbina nue-sogmalad.","poem":1},{"text":"E-negmar-ayarar-bukwadi, nunmaked-dummad anmarga uked.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bela dulemar-yar-baid-baidgi-bukwamaladi, Bab-Jehová-nug-dobe-nanadii gumaloed.","poem":1},{"text":"Bela-yar-baid-baidgi-reyga-mamaid, Bab-Jehová-e-gangued-yeerdakleged magar-dakmaloed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ar Bab-Jehová, Sión-neg-ayarar-siid gannar soboed,","poem":1},{"text":"e-gangued-nikad oyononikoed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dule-ibmar-suli-gudimalad-ese-goledi itogoed,","poem":1},{"text":"dule-ese-wilesagwar-gornaidi itogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Wagan-danimalad wisgumalaga, we-ibmar narmaklego.","poem":1},{"text":"Dulemar-gwalulemaloed, Bab-Jehová-nug-odummomalaga, we-ibmar narmaklego.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ar Bab-Jehová, dulemar-gales-gorbukwad-itogega, e-neg-islidikid-akale, napneg-naid nue-dakded.","poem":1}]},{"type":"verse","number":20,"content":[{"text":"Bab-Jehová, dulemar-oburgwilegega-galesbukwad-onogegala, napneg-naid nue-dakded.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bab-Jehová, dulemar Sión-yargi-e-nug-barsogmalagala, napneg-naid nue-dakded.","poem":1},{"text":"Jerusalén-neggweburgi e-nug-odummomalagala, napneg-naid nue-dakded.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bab-Jehová-nug-odummomalagala, bela we-dulemala danakwaa ambikudmaloed,","poem":1},{"text":"reymar-negsemamaidi, bela ambikudmaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"An gudiidgine, Bab-Dummad, an-ibe an-niga onollomaksad,","poem":1},{"text":"an-ibagan osikirmaksad.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Agala, an ise-wilegar ega sogded: “An-Bab-Dummadye, mer be an-ibe an-ibagan osikirmakye.","poem":1},{"text":"Bab-Dummad, ar begardina ibagan geg bergued.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Gebesailaunni, napneg be nasiksad,","poem":1},{"text":"degi, nibneg-naid be-argangi be nasiksabalid.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"We-napnegdina, berguoed, nibnegmoga bergumogoed.","poem":1},{"text":"Bedina berguosulid.","poem":2},{"text":"Igi mormar serguddae, deyobi, bela nibneg, degi, napneg, sergudoed.","poem":1},{"text":"Mormar-ogwalegeyob be ogwaoed.","poem":2},{"lineBreak":true},{"text":"Mormar-milegeyob be imakoed.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bab-Dummad, bedina amba gannar maid,","poem":1},{"text":"be-ibagan gwen berguosulid.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Be-nug-odummodimalad-e-mimmigandina, nued-gudii gumaloed.","poem":1},{"text":"E-waganmala, be-asabinni gudii gumarmogoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}