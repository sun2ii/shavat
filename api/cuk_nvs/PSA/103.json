{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":103,"content":[{"type":"heading","content":["Bab-Dummad-nug odummoleged"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová-nug, an odummoged,","poem":1},{"text":"Bab-Jehová-nug-isligwaledi, bela an-ganguedbali an odummoged.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová-nug, an odummoged.","poem":1},{"text":"Anga ibmar-nuegan-uksad an iegosulid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová, bela an-isgusad isgussuliyob daked.","poem":1},{"text":"Bela bonigangi an-nudaked,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"burgwedgi an-ollorsaed.","poem":1},{"text":"Nue-an-sabed,","poem":2},{"lineBreak":true},{"text":"nue-wile an-daked,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Dummad bela ibmar-nueganbi anga uked,","poem":1},{"text":"sulubagi-gannar-ganguddaedyobi an-imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bab-Jehová, igar-innikigwad-imakedid,","poem":1},{"text":"dule-baidse-wiledimaladbina urwedid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Moisésʼga e-igarmar oyosad,","poem":1},{"text":"Israel-dulemarga e-ibmar-imaksad oyosad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová dule-wiledakedid, dule-nuedid,","poem":1},{"text":"irgwensuli urwesulid, e-sabguedi dummarbad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Degisadegu urwemai guosulid.","poem":1},{"text":"Dule-egi-nosale, degisadegu ebinsabalosulid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Jehová anmar-isguedba anmar-sabsur-odurdaksulid,","poem":1},{"text":"anmar-ibmar-isgana-imakedba anmar-sabsur-odurdaksulid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar igi mogir napneggi matusur-nai,","poem":1},{"text":"debayobi, e-sabgued dulemar-e-nug-odummodimaladgi dummarba nikad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ar igi dad-ibeler-nakwed, dad-ibeler-argwanedgi dikasur nai,","poem":1},{"text":"debayobi, anmar-isgued anmargi obachad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ar igi bab na e-mimmigan sabe,","poem":1},{"text":"debayobi, Bab-Jehová na dulemar-e-nug-odummodidimaladi sabgued.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ar Bab-Jehová anmar-wisid, anmar ibu gue.","poem":1},{"text":"Nue wisid, anmardi unnila napa gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dule-dula-gudiguedi gaganyob gued, yog-berguar naddaed.","poem":1},{"text":"E-ibagan, dutu-achutedaedyob gued.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ar burwa gornaisale, dutu yoga babatiar naddaed,","poem":1},{"text":"e-nagusad bar dakledasulid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ar Bab-Jehová-e-sabgueddi, degisadeguad.","poem":1},{"text":"E-nug-odummodimaladgardi, e-sabgued-oyoged berguosulid.","poem":2},{"text":"Wemar-e-wagangardi, Bab-Dummad-e-igar-innikigwad degisadeguad.","poem":1}]},{"type":"verse","number":18,"content":[{"text":"Ebo-Igar-Mesisadba-nanadimaladga,","poem":2},{"lineBreak":true},{"text":"e-Igar-Islidikid-Mesisad-ebinsadimaladga,","poem":2},{"text":"eba-ibmar-imakdimaladga,","poem":1},{"text":"Bab-Dummad-e-Igar-innikigwad degisadeguad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Bab-Jehová e-ologan nibneggi sisad.","poem":1},{"text":"Bab-Jehová bela neg-dirbir-naidgi dummadga negdakmaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Bemar, Bab-Dummad-e-baliwiturmar-dule-bulegan,","poem":1},{"lineBreak":true},{"text":"bemar, Bab-Dummad-sogedba-ibmar-imakmaladi,","poem":1},{"lineBreak":true},{"text":"bemar, e-igar-uksadba-nanadimaladi,","poem":1},{"text":"Bab-Jehová-nug odummomar.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bemar, bela e-sordamar,","poem":1},{"text":"ega-arbamalad,","poem":2},{"text":"e-sogedba-ibmar-imakmalad,","poem":1},{"text":"Bab-Jehová-nug odummomala.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bemar, bela ibmar-obinnilesmaladi, bela dummadga-negdakmaidgi,","poem":1},{"text":"Bab-Jehová-nug odummomala.","poem":2},{"lineBreak":true},{"text":"Bab-Jehová-nug an odummoged.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}