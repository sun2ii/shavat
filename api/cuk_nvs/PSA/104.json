{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":104,"content":[{"type":"heading","content":["Bab-Dummad e-ibmar-obinnisad akwemaid"]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová-nug an odummoged.","poem":1},{"lineBreak":true},{"text":"An-Bab-Dummad-Jehová, duledar-gandikid be gued,","poem":1},{"text":"gandikidba yeerdakleged-mola be yosad,","poem":2},{"lineBreak":true},{"text":"ibiyobi-mola-yeerdakle be yosa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mola-dummad-yoiyobi nega-ibegwaledi begi ebirnaid,","poem":1},{"text":"mola-dummad-nallaa-imaklegeyobi mogir-billi be imaked.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Diigine, be-nega-dummagan-urbega be imaked,","poem":1},{"text":"mogirmala, be-moli-ur-bila-onomaladga be saed.","poem":2},{"lineBreak":true},{"text":"Bedi burwa-ooreged-birgi-sii nanaed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Burwamala, be-gayaburba-berbegedga be imaked,","poem":1},{"text":"soo-gwabunyemaladi, be-maiganga be saed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Napanega, e-saila-birgi be sisad,","poem":1},{"text":"e-siidgi, bipisaale gwen bar ainirosulid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Napanegga e-mor-dummad-naiyobi, muu-billi egi be nasiksad.","poem":1},{"text":"Diimala, yalamar-birise nagusad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Diimarse be uludedbali, diimala ilided.","poem":1},{"text":"Be-dolewala-gollomakedbali, diimala uboded.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Diimala, yalamar-birise engusad,","poem":1},{"text":"nebagansega diimala ilisbalid.","poem":2},{"text":"Bia be ega neg-amisa,","poem":1},{"text":"agi be diimala oambikusbalid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dii melle bar napneg-odogega,","poem":1},{"text":"ega be igar mesisad, adi, a-igarse galegegar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bedi, ibe-diimar-ariogwichidi, dianganbali, oiirmakega be saed.","poem":1},{"text":"Yalaganbali, suurmakega be imaked.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ibdurgan-sapurbarmaladi, a-dii gobmalad.","poem":1},{"text":"A-diigine, moli-uayasuid-sapurmar immelemalad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"A-dii-gakabali, sikwimala e-uu urbe damalad.","poem":1},{"text":"Sapi-anagan-imbabali, nuumala namakbukwa damalad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Be-nega-akale, yalamar be ogmaid.","poem":1},{"text":"Be-ibmar-saedbali, napaneg yeer itoged.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Molimarga gagan-ara-aramalad-oniega be imaked,","poem":1},{"text":"dulega ibmar-durgan-sanmakega be saed.","poem":2},{"text":"Adi, agi we-masgunned amiega:","poem":1}]},{"type":"verse","number":15,"content":[{"text":"Vino-weligwar-emar-saed-amiega,","poem":2},{"lineBreak":true},{"text":"olivo-gwallu-wagar-daarmakar-imaked-amiega,","poem":2},{"lineBreak":true},{"text":"mas-burba-dula-uked-amiega be imakbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bab-Jehová e-sapimala-urbisadi, sapi-urwarmala Líbano-yargi urbisadi","poem":1},{"text":"nue-obagwale gwigwichid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"A-sapimargine, nuumala e-uu sobbukwad,","poem":1},{"text":"e-anagangine, dabgalamar ambikubukwad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yala-dummaganbali, sibad-sapurbarmalad bukwad.","poem":1},{"text":"Akwa-olloganbali, nubimar dukubukwad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Bab-Jehováʼye, yolamar-nagumaid-magar-daklegega, bee be nii nasiksad.","poem":1},{"text":"Bee be dad-ibeler e-doged-wisguega be imaksad.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Neg-mutik-imakegala, be negsichidi nasikdaed.","poem":1},{"text":"Agine, ibmar-durgan sapurba ainiardaed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Achumigur-nono-wawaamalad e-masbina uurmakdidaed.","poem":1},{"text":"Bab-Dummadse na e-masgunned egisdidaed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Dad-ibeler-nakwialile,","poem":1},{"text":"geb e-neg-olloledyaba gannar dogdedaed.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Geb dulemala, arbaega gwisguardamarmogad,","poem":1},{"text":"neg-gutulegedse e-arbaed gadapdamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Bab-Jehová, ibiyobi be ibmarmar-imaksadi, ichesur mergue.","poem":1},{"text":"Be ibmar-wisidbali, bela we-ibmarmar be imaksad.","poem":2},{"lineBreak":true},{"text":"Be ibmar-obinnisadi, bela napneggi nanaid.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Agine muu-billi-dummadi naid, a-yagine ibmar-durgan-bukidar bukwad.","poem":1},{"text":"Ibmar-durgan-dummagan, ibmar-durgan-bipigana bukwananaed.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Muu-billigine, ulu-dummagan iirmakbukwad,","poem":1},{"text":"agine, be, baka-dummaganyobid-obinnisadi gudiid,","poem":2},{"lineBreak":true},{"text":"ulu-dummagangi dodogega be obinnisad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Bela we-ibmar-durgana begi gudidiid,","poem":1},{"text":"ega be sogedba e-masgunned ukmaid.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ega be masgunned ukmaid, emardi be-abin gundidiid.","poem":1},{"text":"Ega be-argan be oyomaid, nue-immeledidiid.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Be wagar-biriar-dakdele, be-abin gwayiddamalad.","poem":1},{"text":"Be e-annik-mas-susale, burgwiddamalad,","poem":2},{"lineBreak":true},{"text":"gannar napaga binniddamalad.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Be-Burba be barmialile, bela gannarse napneg obinoleddaed.","poem":1},{"text":"Deyob gannarse napneg naguddaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Bab-Jehová-e-gangued-yeerdakleged degisadegusun.","poem":1},{"text":"Bab-Jehová, e-ibmar-imaksadgi wergusun.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Bab-Dummadi napneg-dakdele, ese napneg wawanmakdedaed.","poem":1},{"text":"Yalamar-ebudele, waa daasa sigisdaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"An dula-gudiidgine, Bab-Jehováʼga an namakoed.","poem":1},{"text":"Amba an dula-gudiidgine, namaklemaladgi an-Bab-Dummadga an namakoed.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ulubgi-an-egi-binsaedi, Bab-Dummad yeer-itogoed,","poem":1},{"text":"Bab-Jehováʼgi an weligwar itoged.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Dule-isgudimalad napneggi bergumarsun.","poem":1},{"text":"Napneggi, dule-isgudimalad bar daklesuli gusun.","poem":2},{"lineBreak":true},{"text":"¡Bab-Jehová-nug an odummoged!","poem":1},{"lineBreak":true},{"text":"¡Bab-Jehová-nug odummolesun!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}