{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":105,"content":[{"type":"heading","content":["Bab-Jehová Israel-dulemarga ibmar-dakledisurmalad imaksad"]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼga dog-nuedye be soge, e-nug be odummomala.","poem":1},{"text":"Bab-Jehová-ibmar-imaksad be dulemar-yar-baid-baidgi-bukwamaladga soge.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Be namakmala, Bab-Jehová-e-nug-odummogega be namakmala.","poem":1},{"text":"Bela e-ibmar-dakledisurmalad-imaksadgi be sunmakmala.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová-nug-isligwaledgi be san-dummarba itomala.","poem":1},{"text":"Dulemar-Bab-Jehová-amidimalad ulubgi wergumala.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová be amimala, e-gangued be amimala.","poem":1},{"text":"Bab-Jehová-amidigu be imakmala.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová-ibmar-gegerdaklemalad-imaksad be insamalo.","poem":1},{"text":"E-ibmar-dummagan-imaksad be insamalo.","poem":2},{"lineBreak":true},{"text":"E-igarmar-sogsad be insamalo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bemar, Bab-Jehová-mai-Abraham-e-wagan gumalad.","poem":1},{"text":"Bemar, Jacob-e-wagan gumalad.","poem":2},{"lineBreak":true},{"text":"Bab-Jehová e-dulemarga bemar-imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová anmar-Bab-Dummad gued.","poem":1},{"text":"Bela we-napneggine, Bab-Dummad-e-igarmar oyolemamaid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wagan miliba-gwago-inigwele, Bab-Dummad Israel-Dulemarbo-Igar-Mesisadi gwen iegosulid.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Bab-Jehová Abraham-ebo igar-mesisgusad,","poem":2},{"text":"Isaacʼga ise-sogar-imaksad,","poem":1},{"text":"an bega a-igar imakedseye.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Jehová, Jacobʼga igar-mesisgua,","poem":1},{"text":"Israelʼbo degisadegu igar mesisgua,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ega sogsagusad:","poem":1},{"text":"“Canaán-yala begadga-guega an bega ukoed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Anmar ichee-guen-inigwele,","poem":1},{"text":"anmar yar-sate gudigusmar-inigwele,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"anmar yar-baid-baidgi-gudigusmaladgi,","poem":1},{"text":"neggwebur-baid-baidgi gudigusmaladgi,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bab-Jehová, sabsur-anmar-imaklegega gwen imaksasulid.","poem":1},{"text":"Anmar-ulale, reymarga sabsur-ibmar-sogsad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Weyob sogsa gusad: “Melle an-dulamar-nugsalegarmaladse achao,","poem":1},{"text":"melle an-gayaburba-barsogmalad naibi-imako.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bab-Jehová, Canaán-yalagi ukud-dummad nasiksad,","poem":1},{"text":"agi masgunned sate imaksad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Degi-inigwele, Bab-Jehová, dule-wargwen-Joséʼye-nugad emar-idu Egipto-yalase barmisgusad.","poem":1},{"text":"José maiga manigi ukles gusad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Egipto-dulemar José-e-nag esgoro-dubgi edichagusmalad,","poem":1},{"text":"geb esgaryagi metegusmalad.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"José-ibmar-sogsa-gusadba neg-gunonigua, Bab-Dummad agi oyosad,","poem":1},{"text":"ede idu-ibmar-sogsad, we napiraye.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Geb Egipto-rey sognonigusad, José esgaryagi-siid onomarye.","poem":1},{"text":"A-rey, deunni, dule-bukidaradga negsemaid.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Rey, José bela e-neggi ega ibmar-dakega onugsanonigusad,","poem":1},{"text":"bela e-dulemar-e-dummadga-guega imaksad.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Adi, José reyga-arbamalad-dummagan-odurdakega imaksad,","poem":1},{"text":"e-girmar-selegan-binsaed-nikagued-odurdakega imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Geb a-sorbali, Israel, Egipto-yalase nonigusad.","poem":1},{"text":"We-Jacobʼde, Cam-yalagi, e-yarsulidgi maigusad.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Agine, Bab-Jehová, e-dulamar-bukidar-merguega imaksad,","poem":1},{"text":"e-isdarmaladba bur-dutusuli imaksabalid.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bab-Jehová, Egipto-dulemar-e-binsaed ogwasad,","poem":1},{"text":"isdar anmar-dakega imaksad,","poem":2},{"lineBreak":true},{"text":"degisoggu, anmar-wioar gussunnad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Agine, Bab-Dummad, e-mai-Moisés-susagusadi, Aarón-susagusadi, Egipto-yarse barmiargusad.","poem":1}]},{"type":"verse","number":27,"content":[{"text":"Agine, Bab-Dummad, wemar-ebogwad, Cam-yalagi ibmar-dakledisulid-imakega imaksad.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Bab-Jehová, Egiptoʼgi negsichid nasiksagusad, bela neg-gudure imaksagusad,","poem":1},{"text":"degite, Egipto-dulemar Bab-Dummad-gayaburba itosurgusmalad.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Egipto-diwarmar abega obinnisgusad,","poem":1},{"text":"e-uamala ogilosgusad.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Bela Egipto-yala ammanoo yaisur-nika imaksad,","poem":1},{"text":"rey-e-negyaginse-bakar, ammanoomar-nika imaksad.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Bab-Dummad-sunmaksagu, gukurmar-bukidar ainiargusad,","poem":1},{"text":"bela Egipto-yalagangi, guumar yaisur-nika imaksad.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Dii-wied-anar, dii-gwamakaled-wiega imaksad.","poem":1},{"text":"Egipto-yalagi mar-dakarmakmai imaksabalid.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Uvaʼmar-digar-bukwadi, higueraʼmar-bukwadi ei obelosgusad.","poem":1},{"text":"E-yalagangi sapimar-bukwad ei bibichisgusad.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Bab-Dummad sunmakdegua, ses-dummagan onisad.","poem":1},{"text":"We-sesmarde, bela-bela-mergu batisad.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Sesmar, bela Egipto-yargi gagan-obelosad.","poem":1},{"text":"Ibmar-durba-e-sanmar, bela obelosbalid.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Bab-Jehová, Egipto-yalagi bela machi-sailaginmalad oburgwisgusad,","poem":1},{"text":"bela gebesailagi-gwalulesmalad ogilosgusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Bab-Jehová, Israel-dulemar or-bukidar-semamai, mani-bukidar-semamai onosgusad.","poem":1},{"text":"E-dulemar-wargwensaale, gwen-burgwissurgusad.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Egipto-dulemala nue-dobe itomarsoggu,","poem":1},{"text":"Israel-dulemar ainide-daksamargua, yeer itosgusmalad.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Bab-Jehová Israel-dulemarga mogir nasiksad,","poem":1},{"text":"adi, a-urba ambikumalagar.","poem":2},{"lineBreak":true},{"text":"Neg-mutik ega neg-mee imakega ega soo ogasad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Bab-Dummadse mas-egichismargu, nuu-codornizʼye-nugad ega uksagusad.","poem":1},{"text":"Madu-nibnegginedgi immeles gusmalad.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Ega akwasaila egasgusad, agi dii aryoargusad.","poem":1},{"text":"Nega-dulesulidganba ega dii aryomai imaksad.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Bab-Dummad deyob imaksadi,","poem":1},{"text":"e-mai-Abrahamʼga gayaburba-ise-sogar-sogsad gwen iessulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Bab-Dummad e-dulamar weligwaledgi onosgusad,","poem":1},{"text":"ber yeer-itogedgi e-dulamar-susadi onosgusad.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Dulemar-baigan-yala na e-dulamarga uksad.","poem":1},{"text":"Dulemar-baigan-arbasad-e-ibmar-sanmaksamalad na e-dulamarga uksabalid.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Bab-Jehová, na e-dulamar e-igar-uksadba binsaed-nika-gudi-imakmalaga imaksad,","poem":1},{"text":"eba nanamalaga imaksabalid.","poem":2},{"lineBreak":true},{"text":"¡Degisoggu, Bab-Jehová-nuggi wergumarsun!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":45}