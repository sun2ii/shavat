{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":106,"content":[{"type":"heading","content":["Israel-dulemar Bab-Dummadba dasurmalad"]},{"type":"verse","number":1,"content":[{"text":"¡Aleluya! ¡Bab-Dummad-e-nug odummomar!","poem":1},{"text":"Bab-Jehová-nug dummarba imakmarsun.","poem":2},{"lineBreak":true},{"text":"Bab-Jehováʼga dog-nuedye sogmar.","poem":1},{"text":"Ar Bab-Dummad, dule-nuedid,","poem":2},{"lineBreak":true},{"text":"e-sabgued, degisadeguad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"¿Doa, Bab-Jehová-e-ibmar-bulegan-imaksad sogedba nabir barsogoe?","poem":1},{"text":"¿Doa, Bab-Jehováʼga-namaklegedgi sogedba sunmakoe? Dule barsoged sate.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dule-igar-inniki-imakdimaladgi,","poem":1},{"text":"igar-maidba gusgu ibmar-imakdimaladgi nued-binsalesad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová, wile be-dulamar be dakalile, wis be angi binsao.","poem":1},{"text":"Be, be-dulamar-bendakdanikile, mer be an-iemogo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Adi an, be-dulamar-susa-gudiidba, e-wergudimaladba wergumogoed.","poem":1},{"text":"Be-dulamar-na-be-nug-imaksa-gudiid-abargi namakmogagala, be an-bendakdage.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Anmar, anmar-dadganyob isgusad,","poem":1},{"text":"anmar, ibmar-isgana imaksad,","poem":2},{"lineBreak":true},{"text":"anmar, galagwensuli-gudii gusad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Anmar-dadgan Egipto-yargi-bukwagu, bela aku be-ibmar-gegerdaklemalad-imaksad daksamalad.","poem":1},{"text":"Degi, be-sabgued-dummarbadgi gwen binsassurmarbalid.","poem":2},{"lineBreak":true},{"text":"Aka Demar-Ginnidye-nugad-dikarba begi-yolenai gusmalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Degi-inigwele, Bab-Jehová na e-nug-sabed-maidba bendaknonikid,","poem":1},{"text":"na e-gangued-dummarbad-oyogega deyob imaksad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Dummad Demar-Ginnidye-nugadse gotegua, demar argaas naded, geb dinnaa megisad.","poem":1},{"text":"Bab-Dummad demar-wilasaila-maigusadba, e-dulamar-semai gusad.","poem":2},{"lineBreak":true},{"text":"Neg-dulesulidganba-nadapiyob, e-dulamar-semai gusad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Dummad anmar-dadgan-bendaksad,","poem":1},{"text":"e-isdarmalad-argan-yaurgi-bukwa bendaknonikid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"E-isdarmalad-birgi demar gannar-arwega imaksad,","poem":1},{"text":"degisoggu, wargwensaale durgussulid, bela burgwismalad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Geb anmar-dadgan Bab-Dummad-ibmar-imakoye-sogsadgine, bar bengussurgusmalad,","poem":1},{"text":"agi, Bab-Dummadga namakde gusmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Sikwas ibagan-nasgua, Bab-Dummad-ibmar-imaksad ienonimarbalid.","poem":1},{"text":"Bab-Dummad-e-igar-imakbied edarbissurmalad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Anmar-dadgan negsulidganba-gudigua, e-itolegedba ibmar imaksamalad.","poem":1},{"text":"Wargwen-gudimaladbali, Bab-Dummad-wilubdaksamalad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Degisoggu, Bab-Dummad, ese-ibmar-egisnanaidba ega ukdesunnad,","poem":1},{"text":"Bab-Dummad, boni-buled-emar-ogiloged ega barmiarsunnad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Deunni, negsulidganba gudidimargua, Moisésʼgi nobguargusmalad,","poem":1},{"text":"Bab-Jehová-nug-imaksad-Aarónʼgi nobguargusmalad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Geb agine, napa argadgusad, degidbali, Datán napase dolesgusad.","poem":1},{"text":"Abiramʼye-nugad, degi, e-sordamarse-bakale, napa-yaba barmellede gusmarmogad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"We-dulemardi, soose bergus gusmalad.","poem":1},{"text":"Bela-we-dule-isganamar soose gummaksa gusmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Anmar-dadgan, Horeb-yargi, moli-bebe-nikad-sapingwagwad e-bab-dummadga-imakegala, sobsagusmalad.","poem":1},{"text":"Bormo-sobaled-asabin dulluu imaknanai gusmalad.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bab-Dummad-e-nug-odummoleged-anar,","poem":1},{"text":"moli-bebe-nikad-gagan-maed-sobaled-e-nug odummodmalad.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"E-Bab-Dummad-e-abonosaddi iedemalad,","poem":1},{"text":"Egipto-yargi ega ibmar-gegerdakleged-imaksad bela iedemalad.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Cam-yar-naidgi, Bab-Dummad ega ibmar-dakledisulid-imaksad bela iedemalad.","poem":1},{"text":"Demar-Ginnidye-nugad-dikarba, ega ibmar-bulegan-imaksad, iedemarbalid.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ar Bab-Dummad Israel-dulemar-oburgwedgi binsasanad.","poem":1},{"text":"Degi-inigwele, Moisés, Bab-Dummadgadga-nug-imaklesadi, wemar-irwa Bab-Dummad-asabin gwisgusad.","poem":2},{"text":"Agala, Moisés wis Bab-Dummad-barganonikid,","poem":1},{"text":"adi, Israel-dulemar, mer Bab-Dummadse ibitomalagar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Deginbali, napneg-nued-ega-uklesadi, isdar-daksamarbalid.","poem":1},{"text":"Bab-Dummad-ega-ibmar-imakoye-sogsadgi, bengusmarbalid.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ar Bab-Jehová-ega-ibmar-sogsadba ibsassurmalad,","poem":1},{"text":"aka e-dordonegyaba uurmakbukwa gusmalad.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Degisoggu, Bab-Dummad amargi yolenonisunnad.","poem":1},{"text":"Adi, negasulidganba sabsur-odurdaklemalagar.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Adi, e-wagan dule-bamaladse sabsur-wilemalagar.","poem":1},{"text":"Degi, yar-akar-akar-bukwadba mimilemalaga imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Baal-Peorʼye-nugad na-e-bab-dummadga imaksamarbalid.","poem":1},{"text":"Bab-dummagan-burbasulidga ibmar-ukleged guchamarbalid.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"E-ibmar-isgana-imakedbali, Bab-Jehová-nue-oulusmalad.","poem":1},{"text":"Degisoggu, boni-dummad ega nagunonisunnad.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Agine, Finees igar-innikigwad imaknonikid,","poem":1},{"text":"geb bonigan bargalenonikid.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Finees we-ibmar-nued-imaksadbali,","poem":1},{"text":"degisadegu, egi nued-binsalemai gulesunnoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Meriba-dii-naid-dikarba, Bab-Jehová-oulusmarbalid.","poem":1},{"text":"We-dulemar-nukad Moisésʼga neg isgunonikid.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Moisés-surbinsa-itogega imaksamalad,","poem":1},{"text":"abali, Moisés bar-nue-binsassuli ibmar-soge-soge sunmaknai gusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Bab-Jehová ega sogsa gusanad, dulemar-bamalad-bukwad oburgwemaloye.","poem":1},{"text":"Degi-inigwele, eba ibsassurmalad, oburgwissurmalad.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Aka e-dulesurmaladba apurudmalad,","poem":1},{"text":"a-ibmar-imakmaladba akadmalad.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Dule-baigan-e-bab-dummagan-e-nug odummodmalad.","poem":1},{"text":"Degisoggu, we-ibmar egi aibinnonisunnad.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Niamarga e-bunamala, e-masmala,","poem":1},{"text":"oburgwenanai guarmalad.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Dule-ibmar-okalodisulid-e-ablis eosmalad,","poem":1},{"text":"a-e-masmala-e-ablis eosmalad,","poem":2},{"lineBreak":true},{"text":"a-e-bunamala-e-ablis eosmarbalid.","poem":2},{"text":"Canaán-dulemar-e-bab-dummaganga amar-oburgwenanai guarmalad.","poem":1},{"text":"Degidbali, ablis-aryosad-ular, napneg isgunonikid.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Weyob neg-imaksamaladbali, neg isgunonikid,","poem":1},{"text":"bela isgunonimarsunnad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Degisoggu, Bab-Jehová e-dulemargi nue-uluded,","poem":1},{"text":"isdar e-dulemar-sunonikid-dakdesunnad.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Agala, Israel-dulesurmaladga urmaknonikid,","poem":1},{"text":"e-isdarmaladse nilebukwa gusmarsunnad.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"E-isdarmaladse sabsur-imaklebukwa guarmalad,","poem":1},{"text":"amarse apor-imakledii gusmarsunnad.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Bab-Jehová bukidargus Israel-dulemar-bendakdii gusanad.","poem":1},{"text":"Degi-inigwele, emardi, Bab-Dummadgi bur bule yoledgusmalad.","poem":2},{"lineBreak":true},{"text":"Degidbali, isguedgi bur bule nanadmarsunnad.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Bab-Dummad e-dulamar-surbinsa-itonanai-dakdegua,","poem":1},{"text":"gormaknanaid-itononigua,","poem":2}]},{"type":"verse","number":45,"content":[{"text":"e-dulamarbo-igar-mesisad ebinsaded.","poem":1},{"text":"Sabbarsoggua, wile dakded.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Bab-Dummad, Israel-dulemar-e-isdarmalad","poem":1},{"text":"Israel-dulemar-wiledakega imaksabalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Anmar-Bab-Jehováʼye, anmar-bendakdage,","poem":1},{"text":"anmar-yar-baid-baidgi-mimiles-bukwadgi gannar be anmar-yarse be anmar-barmide,","poem":2},{"text":"adi, anmar be-nug-isligwaled odummogega,","poem":1},{"text":"weligwaledgi bega namakegar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"Israel-e-Bab-Dummad-Jehová-nug dummarba gusun.","poem":1},{"text":"¡Degisadegu, e-nug odummolesun!","poem":2},{"text":"Bela dulemar weyob sogmar: “¡Napira deyob gusun!”","poem":1},{"text":"¡Bab-Jehová-nug odummomar!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}