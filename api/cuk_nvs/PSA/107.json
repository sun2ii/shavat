{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":107,"content":[{"type":"heading","content":["Bab-Dummad wile-itolegedgi dule-ollorsaoed"]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼga dog-nuedye sogmala,","poem":1},{"text":"ar edi, dule-nuedid. E-sabgued, degisadeguad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehováʼse-abonolesmalad,","poem":1},{"text":"Bab-Jehováʼse-e-isdarmalad-ganguedgi-bela-bela-bendaklesmalad,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová bela-Israel-dulemar-yar-baid-baidgi-bukwad senonikid:","poem":1},{"text":"Dad-nakwedsikmalad, dad-argwanedsikmalad,","poem":2},{"lineBreak":true},{"text":"dad-nakwed-argan-sapiledsikmalad, dad-nakwed-argan-nuedsikmalad.","poem":2},{"text":"Amar Bab-Jehováʼga dog-nuedye sogmala,","poem":1},{"text":"ar edi, dule-nuedid. E-sabgued, degisadeguad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dulemar-abala nega-dulesulidganba yoggus gaamakdii gusmalad.","poem":1},{"text":"Neggwebur-megdapmaloedse-momalaga, gwen igar-amisuli-gudii gusmalad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Na mas-gunbigudii gusmalad, uku-uku-itodii gusmarbalid,","poem":1},{"text":"gwen san-bar-onoged itossurmalad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Geb surbinsa-itogusmaladba Bab-Jehováʼse gochamalad,","poem":1},{"text":"geb Bab-Jehová e-wiledimaladgi bendaknonikid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová neggwebur-megdapmaloedse-momalaga,","poem":1},{"text":"igar-innikigwadba idumai gusad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dule-nue-wiledakmaid-ulale, Bab-Jehováʼga doggus-nuedye be sogmala.","poem":1},{"text":"Dulemarga-ibmar-gegerdaklemalad-imakdiid-ulale, Bab-Jehováʼga doggus-nuedye be sogmala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bab-Jehová dule-uku-uku-itodimaladga ukud obeloged.","poem":1},{"text":"Dule-ukudmaad-itodimaladga bur mas-nued uked.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abala nue-wile-itobukwa, emar-maiga-bukwa gusmalad.","poem":1},{"text":"Negasichidgi, burgwednaga-bukwa gusmalad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar Bab-Jehová-Bur-Birigined-igar-sogsadba ibsassurmalad.","poem":1},{"text":"Ar Bab-Jehová-binsaed-uked isdar itosmalad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"A-ulale, Bab-Jehová arbaed-dummad ega urmaksad,","poem":1},{"text":"aimukumai gusmalad, dule gwen bendaksasulid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Geb surbinsa-itogusmaladba Bab-Jehováʼse gochamalad.","poem":1},{"text":"Geb Bab-Jehová, e-wiledimaladgi bendaknonikid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Negasichidgi-burgwednaga-bukwamaladgi onosad,","poem":1},{"text":"emar-maiga-gudidiidgi onosad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Dule-nue-wiledaked-ulale, Bab-Jehováʼga doggus-nuedye be sogmala.","poem":1},{"text":"Dulemarga-ibmar-gegerdaklemalad-imakdiid-ulale, Bab-Jehováʼga doggus-nuedye be sogmala.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ar yawagakmar-esgoro-gordikidgi-sobaled bibichisad,","poem":1},{"text":"yawagak-edimalad-esgorobiid ubi-ubi imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Anmar-dadgan Bab-Jehová-Igar-Sogsadba gwen ibmar-imaksasurmarsoggu, binsaed-satedyob gusmalad.","poem":1},{"text":"Ibmar-isgana-imaked-ulale, wiledii gusmalad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bela ibmar-gullemaladi ega aged ukdaed.","poem":1},{"text":"Bato e-bergued-ibagan ese warmaksa itosgusad.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Geb surbinsa-itogusmaladba Bab-Jehováʼse gochamalad.","poem":1},{"text":"Geb Bab-Jehová, e-wiledimaladgi bendaknonikid.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bab-Dummad na e-sunmakedba dulemar-nudaksad,","poem":1},{"text":"deyobi, burgwedgi bendaksad.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Dule-nue-wiledaked-ulale, Bab-Jehováʼga doggus-nuedye be sogmala.","poem":1},{"text":"Dulemarga-ibmar-gegerdaklemalad-imakdiid-ulale, Bab-Jehováʼga doggus-nuedye be sogmala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Bab-Jehováʼga doggus-nuedye-sogleged-ibmar-ukleged be ukmala,","poem":1},{"text":"weligwaledgi e-ibmar-imaksad be sogmala.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Dulemar muu-billi-dummaganba mani-amiegala,","poem":1},{"text":"muu-billiba urgi nanadimalad.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Wemala, Bab-Jehová-e-ibmar-imaksad daksamalad.","poem":1},{"text":"Muu-billi-wilasailadgi e-ibmar-gegerdaklemalad-imaksad daksamalad.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bab-Dummad e-sunmakedba burwa binnasur ogochad,","poem":1},{"text":"demardi bela-bela dunguded.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Urdi mogirmar-naidse nakwiddaed,","poem":1},{"text":"muu-billi-wilaganse gannar aidenonidabalid.","poem":2},{"lineBreak":true},{"text":"Ar dulemardi burgwe-itomaladba niga-argwatemalad.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mummuyobi banamakdidii guarmalad.","poem":1},{"text":"Aimukumamai guarmalad.","poem":2},{"text":"E-ibmar-wisidi binsa-wismalad,","poem":1},{"text":"gwen e-bendaksasulid.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Geb surbinsa-itogusmaladba Bab-Jehováʼse gochamalad,","poem":1},{"text":"geb Bab-Jehová e-wile-itomaladgi bendaknonikid.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Bab-Dummad burwa-dummad bogidik imaksad,","poem":1},{"text":"demar bipii imaksabalid.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ar burwa-bogiledgua, dulemar yeer itosmalad.","poem":1},{"text":"Deyobi, Bab-Jehová ur-naguedse dulemar-sesad.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Dule-nue-wiledaked-ulale, Bab-Jehováʼga doggus-nuedye be sogmala.","poem":1},{"text":"Dulemarga-ibmar-gegerdaklemalad-imakdiid-ulale, Bab-Jehováʼga doggus-nuedye be sogmala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Bemar, dulemar-onmakbukwad-abargi, Bab-Jehová-e-nug odummomala.","poem":1},{"text":"Girmar-dummagan-danar-bukwad-abargi, e-nug odummomala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Bab-Dummadi, e-dulamar-ichakwadamalad-ular, diwarmar nega-dulesulidganga obinnisad,","poem":1},{"text":"dianmar neg-dinnaganaga obinnisbalid.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Bab-Dummadi, e-dulamar-ichakwadamalad-ular,","poem":1},{"text":"napa-gadi-ibmar-sanmakedi, napa-ichakwaga imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Bab-Dummad nega-dulesulidgan diimarga obinnisad,","poem":1},{"text":"neg-dinnagwad dianmarga obinnisad.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Agi dulemar-uku-uku-itodimalad urbisad,","poem":1},{"text":"geb we-dulemar megmalaga negmar sobsamalad.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Nainumargi ibmar-gwag digsamalad, uva-dubmar digsamarbalid.","poem":1},{"text":"A-ibmardi ega bela-bela sanmaksad.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Bab-Dummad we-dulemargi nued-binsasad,","poem":1},{"text":"e-dulamar mergudmalad,","poem":2},{"lineBreak":true},{"text":"e-molimar merguega imaksabalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Ar e-dulemar icheleddibe, ibgwensur-imakleddibe, mesagwar-imaklebukwad-ular, deyob guoed.","poem":1},{"text":"Sabsur-imaklebukwad-ular, nue-wilebukwad-ular, deyob guoed.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Bab-Dummad dulemar-nue-nug-nikamalad ibgwensur-daked,","poem":1},{"text":"nega-dulesulidganba gaamakdii imaked.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Ar Bab-Dummad, dule-wilegeddi na e-wilediidgi onoged.","poem":1},{"text":"E-gwenadgan, sibad-wawaad-mergueyobi, bukidar-nika imaked.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Dule-nuegan weyob-ibmar-dakoedba weligwar itomaloed.","poem":1},{"text":"Ar dule-isganamardi, bar-sunmakosurmalad.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Ar dule, binsaed-ibedile, we-ibmar gwagegi sedii guoed,","poem":1},{"text":"Bab-Jehová-e-sabgued magar itogoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/107.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/108.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/106.json","previousChapterAudioLinks":{},"numberOfVerses":43}