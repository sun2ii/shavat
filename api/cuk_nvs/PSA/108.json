{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":108,"content":[{"type":"heading","content":["Dule-isgudimaladgi an-bendakye Bab-Dummadga soged"]},{"type":"hebrew_subtitle","content":["We-Namaked, David narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummad, an-gwage guagwar-naid,","poem":1},{"text":"an bega namaklemaladgi an namakoed,","poem":2},{"lineBreak":true},{"text":"ar we, an-gandikidga gued.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"¡Gar-arpa, gar-salterio be atakmala!","poem":1},{"text":"Iba-gwapid-onodedga ogolega an imakoed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová, an be-nug neggweburmar-abargi odummogoed.","poem":1},{"text":"Dulemar-yar-baid-baidgi-bukwad-abargi an bega namaklemaladgi namakoed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Be-sabgued nibneg-naidba bur-dummarba gued.","poem":1},{"text":"Be-innikidaed nibnegse warmaknaid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Dummad, bedi nibneggi maid.","poem":1},{"text":"Gandikidba-be-yeerdakleged bela napneg-ebilis naid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Dummad, be-neggwebur-be-nue-sabed-bendakega, be anmar-bendake,","poem":1},{"text":"be anmar-abinsae.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bab-Dummad e-neg-islidikid-akale sogsad: “Weligwaledgi an Siquem-neggwebur mimioed,","poem":1},{"text":"weligwaledgi an Sucot-neba-naid ilemakoed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Galaad-yala, angadi gued,","poem":1},{"text":"Manasés-yala, angadi gued,","poem":2},{"text":"Efraín-yala, an-bormo-gurginga gued,","poem":1},{"text":"Judá-yala, an-gaapoledga gued.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Moab-yala, an-argan-enukedga gued,","poem":1},{"text":"Edom-yargi, an-sapat bikiin an metoed,","poem":2},{"lineBreak":true},{"text":"Filistea-sordamargi-nakwisadba, gandikidba an gormakoed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"¿Doa, neggwebur-gandikidse an-idugoe?","poem":1},{"text":"¿Doa, anga Edom-yarse-aibillemaid oyogoe?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Dummad, ¿bee be anmar-obachagussursi?","poem":1},{"text":"Bab-Dummad, bar be anmarga sorda-bila-onomalad-bendakdisurgusad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dule-isdarmaladgi-nakwega be anmar-imake.","poem":1},{"text":"Ar dulemar anmar-bendakele, gwen anmarga igarga guosulid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Unnila, Bab-Dummadbali, anmar, anmar-isdarmaladgi nakoed.","poem":1},{"text":"E anmarga, anmar-isdarmalad obelogoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}