{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":109,"content":[{"type":"heading","content":["Bab-Dummad an-bendake"]},{"type":"hebrew_subtitle","content":["David, we-namaked narmaksad. Namakmalad-e-iduedga soglenaid."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummad, an be-nug ogannoged.","poem":1},{"text":"Melle be an-abin-imaksuli gue.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dule-isganamar, dule-gakansamalad, angi gakansaar sunmakdimalad.","poem":1},{"text":"Gakansaedgi an-nug oichodimalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Sae-an-dakmaladbali, sunnasur angi sunmakdimalad.","poem":1},{"text":"Binsarsunna angi yolenanaid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Andi, we-dulemar-nue-sabed,","poem":1},{"text":"degite, emardi angi yolenanaid.","poem":2},{"lineBreak":true},{"text":"Bab-Dummad, andi emarga bese gorsii daed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Andi, ibmar-nued ega imaked,","poem":1},{"text":"emardi, ibmar-isgana anga imaked.","poem":2},{"text":"Andi, wemar-sabed,","poem":1},{"text":"emardi, sae-an-daked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bab-Dummad, we-dulemarga-igar-nabogega, dule-isgana ega be ogwiche,","poem":1},{"text":"dule-e-bendaknaid egi aibined be imake.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ega igar-nabolealir, we-dulegi isgusye-sogleged be imake,","poem":1},{"text":"bese-goledse-bakar, ega isguedga-guega be imake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gwae be oburgwe.","poem":1},{"text":"Dule-baid ei arbaed-sued be imake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"E-mimmigan, bab-sate be imake.","poem":1},{"text":"E-ome, suisuli be imake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"E-mimmigan, neg-sate be imake.","poem":1},{"text":"Dule-baiganse mani-egisdii be imake.","poem":2},{"lineBreak":true},{"text":"E-neg-bibisgar-siidgi ononnoged be imake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dule-ega-idu-mani-ukdidaed,","poem":1},{"text":"bela ei ibmar-seled be imake.","poem":2},{"text":"Na e-ibmargi-arbasad,","poem":1},{"text":"ei dule-baigan-suega be imake.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dule-baigan we-dule-wiledaksuli be imake.","poem":1},{"text":"Dule-baid bipisaale e-mimmigan-sergan-sated, melle wiledaked be imake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"E-wagan bela be ogiloge.","poem":1},{"text":"Dulemar we-dulemar-bela-ieged be imake.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bab-Jehová, e-bab-ibmar-isgana-imakdigusad, mer be iego,","poem":1},{"text":"e-nan-isgudigusad, melle be iebalo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bab-Jehová, melle e-isgued be iego.","poem":1},{"text":"We-napneggi, dulemar we-dule-ieged be imake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ar we-dulede, dule-baigan-baisur-daksa gusad.","poem":1},{"text":"Dule-wilegana-baregindii gusad,","poem":2},{"lineBreak":true},{"text":"dule-ibmarbina-sogdimalad-baregindii gusad.","poem":2},{"text":"Dule-gwage-naibi-itodiid-baregindii gusad.","poem":1},{"text":"We-dulemar-oburgwedse baregindii gusad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ar aimar-ukabsaed yeer itodasoggu,","poem":1},{"lineBreak":true},{"text":"dulemar-baigan e-ukabsamosun.","poem":1},{"text":"Ar egi nued-binsaed abessursoggu, melle egi nued binsamarsun.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Dule, emar-ukabsaedi na e-mor-dummadyob ega gusun.","poem":1},{"text":"Emar-ukabsaedi, dii-goblegeyob egi ubosun.","poem":2},{"lineBreak":true},{"text":"Emar-ukabsaedi, ina-abagalaganse-ubogeyob ega gusun.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"We-ukabsaedi, e-mor-dummadyobi gusun.","poem":1},{"text":"Sadergi-molidub-guur-naiyob egi nagubarsun.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Weyobi, Bab-Jehová an-isdarmalad imaksun,","poem":1},{"text":"weyobi, dulemar-sunnasur-angi-sunmakdimalad imaksun.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Bab-Jehová, bee be an-Dummadid,","poem":1},{"text":"Be-nug-dummarba-nikadba wile be an-dake,","poem":2},{"text":"dule-angi-sunmakdimaladgi be an-onoge,","poem":1},{"text":"ar be-sabgued dummarba gued.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"An wilegedid, an ibmar-sate gudiid,","poem":1},{"text":"ulubgi ise-nue-naibi an itoged.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Binna-binna neg-gutulemaiyobi, an nolloo gumaid,","poem":1},{"text":"ses burwa-goledba-seled-daedyobi, an selemaid.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"An mas-gunsulidba an gaaragusad.","poem":1},{"text":"An mas-gunsulidba an-yokor nue-nollogusad.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Dulemar an-dakalile,","poem":1},{"text":"angi dodoardamalad, anga alliardamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"An-Bab-Dummad-Jehováʼye, be an-bendake.","poem":1},{"text":"Sabgued-dummarba-nikadba be an-bendake.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bab-Jehováʼye, magar-itogega be dulemar-imake,","poem":1},{"text":"ar bee be we-ibmar imaksad.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Be angi ise-nued binsae.","poem":1},{"text":"Ar emardi an-ukabsaele, akarsulid.","poem":2},{"text":"An-isdarmaladdi be obingegsae,","poem":1},{"text":"andi be-maiga-guedi, weligwar-itoge be an-imake.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"¡An-isdarmaladdi be dummad-obingegsae!","poem":1},{"text":"¡Bela-belad-bingeguega be imake!","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Bab-Jehová-e-nug an-gayagi an odummogoed.","poem":1},{"text":"Dule-bukidar-abargi be-nug an ogannogoed.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ar dule-isgana dule-wilegana-oburgweye-sokalile, bee be dulemar-wilegana bendakdaed.","poem":1},{"text":"A-ulale, be-nug an odummogoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}