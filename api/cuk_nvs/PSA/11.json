{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"heading","content":["Dule-nued, Bab-Dummadgi bensulid"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad. Namakmalad-e-iduedga soglenaid."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼgi, an bendakleged amied.","poem":1},{"text":"Degisoggu, ¿ibiga anga sogmalosunna,","poem":2},{"lineBreak":true},{"text":"sikwiyob yalaganba be wakinye?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Be dakmala, dule-isganamar e-warsi guagwar ganimalad, e-sigu guagwar warsigi-yoi ganimalad.","poem":1},{"text":"Dule-gwage-innikii-gudimaladgi sigu-miega, negsichigi dukuar gwichimalad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ar we-napneggi, igar-innikii-selemaid-bergudele,","poem":1},{"text":"dule-innikidaed, geg bar ibmar imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová, e-neg-islidikidgi maid.","poem":1},{"text":"Bab-Jehová, nibneggi ologanagi siid,","poem":2},{"lineBreak":true},{"text":"e-ibyagwar dulemar-ibmar-imaked nue-dakmaid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová, dule-innikidaed, degi, dule-isganadaed bela baramied.","poem":1},{"text":"Bab-Jehová, dule-sabsur-emar-imakdiidgi-wergudiid isdardaked.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Jehová, dule-isganamargi, soo azufreʼba-mesa odegoed.","poem":1},{"text":"Dule-isganamar bela burwa-ueregedba burgwemaloed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová, dule-innikigwadid, igar-inniki-maid-sabedid.","poem":1},{"text":"A-ulale, dule-inniki-nanadiiddi, Bab-Jehová-e-wagar dakoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}