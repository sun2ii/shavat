{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"heading","content":["Bab-Jehová reyga gargangued uknonikid"]},{"type":"hebrew_subtitle","content":["David, we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová an-Dummadga sogsad: “An-argan-nuedsik be sige,","poem":1},{"text":"be-isdarmalad an bela ogalakuedse be sige.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová Sión-yar-akale, bega be-negsemaid-e-gargangued oyononikoed:","poem":1},{"text":"Be-isdarmalad-be-urbalikwaa-nanaega, be imako.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Be-sordamala bila-onoleged-ibagi, sogedbali guakwaa bukumaloed,","poem":1},{"text":"ilekwaa yeerdakle ambikumaloed.","poem":2},{"text":"Bolegoedba boo-bateyobi,","poem":1},{"text":"be-niga bega gannolemai-gannolemai guoed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová ise-sogar-imaksad","poem":1},{"text":"e-sogsad bar ogwaosulid:","poem":2},{"text":"“Be, Bab-Dummad-asabin Dule-Irwa-Gwisgued-Dummad-Degisadeguadid.","poem":1},{"text":"Igi Melquisedec maigusa, deyob be gumogad.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová, Dule-Dummad be-argan-nuedsik siid.","poem":1},{"text":"Sabsur-urwenonikoed-e-ibagi reymar-mamaid ese ibitomaloed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dulemar-yar-baid-baidgi-bukwamalad ese odurdaklemaloed.","poem":1},{"text":"Muimar bukidar-omiledmaloed.","poem":2},{"lineBreak":true},{"text":"Napneggi-dulemar-bukwad bela ese ibitolemaloed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Igarbali, rey, dian-aryomaid goboed,","poem":1},{"text":"degidba, e-niga gangunonikoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}