{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"heading","content":["Bab-Dummad e-dulamar-bendaked"]},{"type":"hebrew_subtitle","content":["¡Bab-Dummad-nug odummolesun!"]},{"type":"verse","number":1,"content":[{"text":"Dulemar-abargi, dule-nueganbo","poem":1},{"text":"an bela-bela gwagegi Bab-Jehová-nug odummogoed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová-e-ibmarmar-imaksad doggus dungued,","poem":1},{"text":"we-ibmarbina-itogerbamaladi, egi nergumalad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Na e-ibmar-imaksad doggus gangu-dakleged, doggus yeerdakleged,","poem":1},{"text":"na e-Igar-innikigwad degisadegu-maigu guoed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Dummad, e-ibmar-gegerdaklemalad-imaksad, degisadegu ebinsamalaga imaked.","poem":1},{"text":"Bab-Jehová nued-binsaedgi-dulemar-bendakedid, dule-wiledakedid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Dummad dulemar-e-nug-odummodimaladga mas uked,","poem":1},{"text":"na Ebo-Igar-Mesisad degisadegu ebinsaed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Na e-dulamarga e-ibmar-imaksadgi e-gangued oyosad.","poem":1},{"text":"Dulemar-yar-baid-baidgi-bukwamalad-e-yar ega uksadba, e-gangued oyosad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Na e-ibmar-imaksad, napiragwadid, innikigwadid.","poem":1},{"text":"Bela e-Igar-Islidikid-Mesisad egi bengulesulid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"E-Igar-Mesisad degisadegu gangu maid, gege gwaged,","poem":1},{"text":"napiragwadgi, innikigwadgi mesisad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Dummad na e-dulemar-galebukwad ollor-imaksad.","poem":1},{"text":"Degisadegu na ebo Igar mesisad.","poem":2},{"lineBreak":true},{"text":"¡E-nug-isligwaled, bur gannarbadid!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bab-Jehová-dobee-nanaedgi binsaed-ibed-guedi danikid.","poem":1},{"text":"Bab-Jehová-Igar-Mesisadba-ibmar-imakdimalad nue-ibmar-wisi gumalad.","poem":2},{"lineBreak":true},{"text":"¡Bab-Jehová-nug degisadegu odummoledii guoed!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}