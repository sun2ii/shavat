{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"heading","content":["Dule-Bab-Jehová-dobee-nanadiid ibmar-bukidar nikued"]},{"type":"verse","number":1,"content":[{"text":"¡Aleluya! ¡Bab-Jehová-nug odummolesun!","poem":1},{"lineBreak":true},{"text":"Dule Bab-Jehová-dobee-nanadiidgi, Bab-Jehová nued binsasad.","poem":1},{"text":"Dule Bab-Igar-Mesisadba bela-belad yeer-itodiidgi, Bab-Jehová nued binsasad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Napneggi e-wagan dule-gandikidga guoed,","poem":1},{"text":"dule-gwage-innikimalad-e-anagangi ise-nued-binsalegoed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"E-neggi ibmar-nuegan-bukidar-nika guoed,","poem":1},{"text":"e-Igar-Inniki-Imaked degisadeguoed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"We-dulede, dule-innikidaedsoggu, wile-dule-dakdaedsoggu, itoakwaa-ibmar-imakedsoggu,","poem":1},{"text":"dule-nueganga negasichidgi neg-meegwadyob gued.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dule-nued-daedi, emarga obinagwar ibmar-ukedid.","poem":1},{"text":"Igar-innikigwadba e-ibmar-baklemaid semaid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bipisaale gwen-galakuosulid","poem":1},{"text":"dule-nued-daedi, degisadegu ebinsalegoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Garda-isganamar-itoalile, dobee itogosulid. E-gwagegi baisur-itogoed,","poem":1},{"text":"Bab-Dummadgi bensuli guoed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Na e-ulubgi gandik itogoed, dobee itogosulid.","poem":1},{"text":"E-isdarmalad ese galakusad na dakoed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"E-ibmar-nikadi, dule-wilemaladga mimied.","poem":1},{"text":"E-Igar-Inniki-Imaked degisadegu maigu guoed.","poem":2},{"lineBreak":true},{"text":"E-ganguedi, gandikidba-yeerdakle ogannolegoed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Deyob dule-isgudiid we-ibmar dakoed,","poem":1},{"text":"na sae-itodoed,","poem":2},{"text":"nugar-gormai na bergudoed.","poem":1},{"text":"Dule-isgudiid-e-ibmar-abegedi bela bergudoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}