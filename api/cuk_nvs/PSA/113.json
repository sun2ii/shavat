{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"heading","content":["Bab-Dummad-nued-daed-nug odummoged"]},{"type":"verse","number":1,"content":[{"text":"¡Aleluya! ¡Bab-Jehová-nug odummolesun!","poem":1},{"lineBreak":true},{"text":"Bab-Dummad-Jehová-e-maimar, Bab-Jehováʼse be gormar,","poem":1},{"text":"Bab-Jehová-nug be odummomar.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Emi-iba-akale, Bab-Jehová-nuggi","poem":1},{"text":"degisadegu nued-binsalesun.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dad-nakwed-akar, dad-argwanedse,","poem":1},{"text":"Bab-Jehová-nugdi dummarba gusun.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová bela dulemar-yar-baid-baidgi-bukwad semaid,","poem":1},{"text":"Nibneggi e-gangued-yeerdakleged bur dummarba gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Anmar-Bab-Dummad-Jehová-nibneggi-maidyobi, dule sated.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Bab-Jehová, e-maid-akale, nibneg dakmaid,","poem":2},{"lineBreak":true},{"text":"napneg dakmaibalid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová, dule-wileged e-wilediidgi bendakdaed,","poem":1},{"text":"Bab-Dummad, dule-ibmar-abesa-gudiid e-ibmar-abediidgi bendakdaed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Adi, neggwebur-e-dummagan-abargi siegar.","poem":1},{"text":"Dule-nuga-nikamalad-abargi siegar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ome geg mimmi-bakedi, nabir mimmi-bake imaked,","poem":1},{"text":"nabir neguya-nika imaked.","poem":2},{"lineBreak":true},{"text":"¡Aleluya! ¡Bab-Jehová-nug odummolesun!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}