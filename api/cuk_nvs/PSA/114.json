{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"heading","content":["Egipto-yargi ibmar-gegerdaklemalad-oyolesad"]},{"type":"verse","number":1,"content":[{"text":"Israel-dulemar Egipto-yargi nosmargua,","poem":1},{"text":"Judá-yar Babse-goled-negga gunonikid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jacob-wagan dule-baigan-yargi-bukwa nosmargua,","poem":1},{"text":"Israel-yar-naid bela Bab-Dummadgadga gunonikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Demar-naid Israel-dulemar-dakdegua, Israel-dulemar-abin argaded.","poem":1},{"text":"Jordán-diwar-ariomaid","poem":2},{"lineBreak":true},{"text":"e-abin gales megisad, bar aryossulid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sibad-wawaad-macheredyob yar-dummagan ichomakded,","poem":1},{"text":"sibad-wawaad-mimmiganyob yar-senigana ichomakdemalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Demar, ¿ibiga be argade?","poem":1},{"text":"Jordán-diwar, ¿ibiga be gales-megismoga?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bemar yar-bukwamaladi, ¿ibiga bemar sibad-wawaad-macheredyob ichomakdemala?","poem":1},{"text":"Bemar yar-senigana, ¿ibiga bemar sibad-wawaad-mimmiganyob ichomakdemarmoga?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Napneg-naid, Bab-Jehová-asabin be giglimake,","poem":1},{"text":"Jacob-e-Bab-Dummad-asabin be giglimake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ar Bab-Jehová akwasaila dii-siedga imaksad,","poem":1},{"text":"akwasailagi dii-aryomai imaksad.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}