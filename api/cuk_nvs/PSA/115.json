{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"heading","content":["Anmar-Bab-Dummad-nibneggi-maid"]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová, be-nug-odummolegega bega namakleged.","poem":1},{"text":"Anmar-nug-odummolegega namaklesulid.","poem":2},{"text":"Be dule-wiledakedba, be ibmar-innikigwad-sogedba,","poem":1},{"text":"a-ular, bega namakleged.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ar ibiga dulemar-yar-baid-baidgi-bukwamalad anmarga sogoe:","poem":1},{"text":"“¿Bia be-Bab-Dummad nadsunna?”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Anmar-Bab-Dummad nibneggi maid,","poem":1},{"text":"ar ibi na imakbigusa, bela imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dule-baigan ibmarmar-e-bab-dummadga-imakbukwadi, manigi sobaled, orgi sobaled,","poem":1},{"text":"dulemar e-argangi sobsananaed.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"We-ibmardi, gaya nikamalanad, degite, sunmaksurmalad.","poem":2},{"lineBreak":true},{"text":"Ibya nikamalanad, degite, aku-atakmalad.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Uaya nikamalanad, degite, itosurmalad.","poem":2},{"lineBreak":true},{"text":"Asu nikamalanad, degite, ibmar-yapanned usurmalad.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Argan nikamalanad, degite, ibmar ebusurmalad.","poem":2},{"lineBreak":true},{"text":"Nag nikamalanad, degite, nanasurmalad.","poem":2},{"lineBreak":true},{"text":"E-dolewar nikamalanad, degite, ibmar-soggwensaar bisurmalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"E-sobmalad, deyobi gumarmogad,","poem":1},{"text":"bela-egi-bengusurmalad, deyobi gumarmogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Israel-dulemar, ¡mer Bab-Jehováʼgi bengumala!","poem":1},{"text":"Na e be-bendaked gued,","poem":2},{"lineBreak":true},{"text":"be-sigu-abgaedga gued.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Aarón-wagan, dule-irwa-Bab-Dummadse-gormalad, ¡mer Bab-Jehováʼgi bengumala!","poem":1},{"text":"Na e be-bendaked gued,","poem":2},{"lineBreak":true},{"text":"be-sigu-abgaedga gued.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Jehová-urbali-gudimalad, ¡mer Bab-Jehováʼgi bengumala!","poem":1},{"text":"Na e be-bendaked gued,","poem":2},{"lineBreak":true},{"text":"be-sigu-abgaedga gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bab-Jehová anmar-ebinsaed,","poem":1},{"text":"anmargi nued binsaed,","poem":2},{"text":"Israel-dulemargi nued binsaed,","poem":1},{"text":"Aarón-wagangi nued binsaed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bab-Jehová, e-urbali-gudimaladgi nued binsaed,","poem":1},{"text":"dule-nuga-nikamaladgi nued binsaed,","poem":2},{"lineBreak":true},{"text":"dule-binsarmaladgi nued binsabalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Bab-Jehová bemarga bur bule mimmigan-mergumai imaksun,","poem":1},{"text":"be-waganga mimmigan-mergumai imakbarsun.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bab-Jehová-nibneg-obinnisadi, bemargi nued-binsaena gadin.","poem":1},{"text":"Bab-Jehová-napneg-obinnisadi, bemargi nued-binsaena gadin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nibneg, Bab-Jehováʼgadid.","poem":1},{"text":"Napnegdi, Bab-Jehová dulemarga uksad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dule-burgwarmalad Bab-Jehová-nug odummosurmalad.","poem":1},{"text":"Dulemar-neg-urba-diglesmamaidi, Bab-Jehová-nug odummosurmalad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ar anmardi, emi-akale, Bab-Jehová-nug","poem":1},{"text":"degisadegu odummodii gumaloed.","poem":2},{"lineBreak":true},{"text":"¡Aleluya! ¡Bab-Jehová-nug odummolesun!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}