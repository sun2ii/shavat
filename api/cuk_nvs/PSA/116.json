{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"heading","content":["Bab-Dummadga-doggus-nuedye-soged"]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼbina, an bela-belad soged.","poem":1},{"text":"An-ese-wilesakwaa-goledi an-itoged.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ar Bab-Dummad an-itodasoggu,","poem":1},{"text":"bane-bane an burgwedse ese gordii guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Burgwed-igar nue an-ebiris nagusad.","poem":1},{"text":"Burgwarmalad-meged-galu anbina nue-itos naid.","poem":2},{"text":"Degidbali, surbinsa an itoded,","poem":1},{"text":"gwage-nunmak an itonaded.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Degidgine, Bab-Jehováʼse an goted:","poem":1},{"text":"“Bab-Jehováʼye, wis be an-bendakye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová, wile-dule-dakedid,","poem":1},{"text":"dule-innikidaedid.","poem":2},{"lineBreak":true},{"text":"Anmar-Bab-Dummad, ise-wile-dule-dakedid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Jehová, dule-belagwadamalad akwemaid.","poem":1},{"text":"An nue-bela-maidgi, an-abonosad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Emigindi, an bar bukib-binsaosulid, gwage-bogidik-gudii guoed.","poem":1},{"text":"Ar Bab-Jehová angi nued binsasad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová, bee be burgwedgi an-san-burba-onosad,","poem":1},{"text":"an-ibyanis be elisad,","poem":2},{"lineBreak":true},{"text":"galagwensuli-gudiidgi be an-onosad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Degisoggu, dule-bukwamalad-abargi,","poem":1},{"text":"Bab-Jehová-asabin an gudii guoed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"An nue-bukib-itodiiye an sog-inigwele,","poem":1},{"text":"amba an Bab-Dummadgi bensulid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"An sulibinsa-itogedgi an sogsad:","poem":1},{"text":"Bela dulemar gakansaedbiiye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bab-Jehová bela-belad angi nued-binsasadi,","poem":1},{"text":"¿ibugi an bennukoe?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Unnila abonolesad-ular, Bab-Jehováʼga dog-nuedye-sogega, noggi an vino ukoed.","poem":1},{"text":"Unnila Bab-Jehová-nuggi an goloed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Unnila Bab-Jehováʼga an ibmar-imakoye ise-sogar-sogsadi,","poem":1},{"text":"bela dulemar-asabin an imakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Bab-Jehová dule-eba-nanaimalad-burgwedi","poem":1},{"text":"bela-bela yeer daked, ega ibnuedid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bab-Jehová, ani an be-maiga gued.","poem":1},{"text":"An be-machi-innikigwadid,","poem":2},{"text":"an be-maiga gudiid.","poem":1},{"text":"Galessiidgi be an-ollor-imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Bab-Jehová, an bega doggus-nuedye-sogega, ibmar-ogumakar-ukleged ukoed.","poem":1},{"text":"Bab-Jehová, be-nuggi an goloed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bab-Jehováʼga an ibmar-imakoye ise-sogar-sogsadi,","poem":1},{"text":"bela e-dulamar-asabin an imakoed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bab-Jehováʼse-goled-neg-imbagi an imakoed,","poem":1},{"text":"Jerusalén-neggwebur-abargi an imakoed.","poem":2},{"lineBreak":true},{"text":"Aleluya, ¡Bab-Dummad-nug odummolesun!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}