{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":118,"content":[{"type":"heading","content":["Bab-Jehováʼga dog-nuedye sogleged"]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová-e-nug odummomar.","poem":1},{"text":"Ar Bab-Jehová dule-nuedid.","poem":2},{"lineBreak":true},{"text":"Ar Bab-Jehová-e-sabgued, degisadeguad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Israel-dulemar, emisgi be sogmala:","poem":1},{"text":"“Bab-Dummad-e-sabgued, degisadeguye.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Aarón-e-wagan, emisgi be sogmala:","poem":1},{"text":"“Bab-Dummad-e-sabgued, degisadeguye.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová-dobekwaa-gudimalad, emisgi be sogmala:","poem":1},{"text":"“Bab-Dummad-e-sabgued, degisadeguye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"An bonigan-abalagi-gudiidgi, Bab-Jehováʼse an gochagusad.","poem":1},{"text":"An gochagua, an-abin-imaksad, neg-olloledgi an-ogwisgunonikid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Jehová anba gudiid, degisoggu, an ibmar dobsulid,","poem":1},{"text":"ar dule akar an-imakosulid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová anba gudiid, ar nue-an-bendakdiid.","poem":1},{"text":"Degisoggu, isdar-an-dakdimalad, napayala-baparmakdii an dakoed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dulemargi-bensuliguedba bur Bab-Jehováʼgi-bengusuligued abeleged.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Dule-nug-nika-gudimaladgi-bensuliguedba bur Bab-Jehováʼgi-bengusuligued abeleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dulemar-yar-baid-baidginmalad an-ebiris gusmalanad,","poem":1},{"text":"degi-inigwele, Bab-Jehová-nuggi anse ogilolesmalad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bela an-ebirismalanad,","poem":1},{"text":"degi-inigwele, Bab-Jehová-nuggi anse ogilolesmalad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Burmaryobi an-ebirismalanad,","poem":1},{"text":"degi-inigwele, gagan-soogi-gummakeyob anse gusmalad.","poem":2},{"lineBreak":true},{"text":"Bab-Jehová-nuggi anse ogilolesmalad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"An-egwanmalagala, sabesuli an-barmete gusmalanad,","poem":1},{"text":"degi-inigwele, Bab-Jehová an-bendaknonikid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ar Bab-Jehová an-niga-gandikidga gued, an-namakedga gued.","poem":1},{"text":"Ar Bab-Jehová an-abonogedid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dule-inniki-gudimalad, weligwaledgi oimakdemalad,","poem":1},{"text":"bendaklenonimaladba e-neg-e-neggi weyob binnasur-gotemalad:","poem":2},{"lineBreak":true},{"text":"“Bab-Jehová e-garganguedgi ibmar-bulegan imaked.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bab-Jehová-e-gargangued, biriginedid.","poem":1},{"text":"Bab-Jehová-e-gargangued ibmar-bulegan imaked.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"An burgosulid, an dula-gudii guoed.","poem":1},{"text":"Bab-Jehová-ibmar-imaksad-barsogega an dula-gudii guoed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bab-Jehová undar-naibi an-imaksad,","poem":1},{"text":"degi-inigwele, an-oburgwissurgusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Anga yawagak egamar,","poem":1},{"text":"Bab-Dummadse-goled-neg-e-yawagak anga egamar,","poem":2},{"lineBreak":true},{"text":"Bab-Jehová-nug-odummogegala, agi an dogoed.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"We, Bab-Jehová-e-yawagak gued,","poem":1},{"text":"agi dule-inniki-gudimaladbi dogmaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Bab-Jehová, be an-abin-imaksasoggu,","poem":1},{"text":"an bega dog-nuedye soged, ar be an-abonosad.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Akwa dule-neg-sobmaladse-oballesadi,","poem":1},{"text":"neg-sobleged-e-akwasailaga gunonikid.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bab-Jehová deyob we-ibmar imaknonikid,","poem":1},{"text":"anmarga geger-dakle gunonikid.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"We-ibagi Bab-Jehová anmarga ibmar imaksad,","poem":1},{"text":"¡anmar egi wergumarsun, yeer-itomarsun!","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Bab-Jehováʼye, wilesakwaa an bese gornaid, be anmar-abonoge.","poem":1},{"text":"Bab-Jehová, anmar-onasguega be anmar-imake.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bab-Jehová-nuggi-dule-danikid, Bab-Jehová egi nued-binsasun.","poem":1},{"text":"Bab-Jehová-e-neg-akale, anmar ega sogsun: “Bab-Jehová begi nued-binsasunye.”","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bab-Jehová, Bab-Dummadid.","poem":1},{"text":"Anmarga gwallu-meegwadyobi gued.","poem":2},{"text":"Igarba bipirmaknamalo, sapi-e-anagan semamai gumalo,","poem":1},{"text":"Bab-Jehováʼga-ibmar-ogumakar-ukleged-ailagi moli-bebeyob-nonaidse sedmalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Bab-Jehová, ar be an-Bab-Dummadid,","poem":1},{"text":"agala, an bega dog-nuedye soged.","poem":2},{"text":"Bab-Jehová, ar be an-Bab-Dummadid,","poem":1},{"text":"agala, an be-nug-odummoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Bab-Jehová-e-nug odummomar,","poem":1},{"text":"ar Bab-Jehová, dule-nuedid,","poem":2},{"lineBreak":true},{"text":"ar Bab-Jehová-e-sabgued, degisadeguad.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}