{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":119,"content":[{"type":"heading","content":["Bab-Dummad-Igar-Nued-Maidgi namaked"]},{"type":"verse","number":1,"content":[{"text":"Dulemar-inniki-nanadimalad, Bab-Jehová-Igar-Maidba nanadimalad.","poem":1},{"text":"Amargi, Bab-Jehová, ise-nued binsaed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dulemar-Bab-Dummad-Igar-Maidba-gudimaladi, bela-bela-ulubgi-be-amidimaladi,","poem":1},{"text":"amargi, Bab-Jehová, be ise-nued binsaed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"We-dulemar, bipisaale ibmar-isgana imakdisurmalad,","poem":1},{"text":"unnila, Bab-Dummad-Igarbarbi nanadimalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bee be Be-Igar-Islidik-Mamaid mesisad,","poem":1},{"text":"adi, a-sogedba nanamalagar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Be-Igar-Mamaidba an nanadiguega,","poem":1},{"text":"bitigi bela-bela eba an innikii nanadii gusana gadin.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bela Be-Igar-Islidik-Mesisadba an nanaele,","poem":1},{"text":"an binge-itogosulid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Be-Igar-Inniki-Nabolemalad-Mamaid an durdaksale,","poem":1},{"text":"an innikigwadbali ulubgi be-ogannogoed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"¡Be-Igar-Mamaid-Sogedba, an nanaoed!","poem":1},{"text":"¡Bipisaale melle be an-iego!","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"¿Igi-sapingwa melle-isguega, na nuekwaa nanadii guergebe?","poem":1},{"text":"Unnila, Be-Gayaburba-Maidbarbi nanadii guergebed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"An gwage-ulubgi bela-belad, an be-amidiid.","poem":1},{"text":"Be-Igar-Islidik-Mamaidgi, melle aibanega be an-imako.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Melle begi-isguegala,","poem":1},{"text":"Be-Gayaburba an-gwage-ulubgi an na sediid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"¡Bab-Jehová, be-nug-odummolesun!","poem":1},{"text":"¡Be-Igar-Mamaidgi be an-odurdake!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Igar-Megisadba bela be ibmar-sogsadi,","poem":1},{"text":"dulemarga an sogsad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bela ibmar-nikadba bur bule Be-Igar-Mamaidba-nanadiidgi","poem":1},{"text":"an weligwar itodiid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Be-Igar-Islidik-Mamaidgi an binsaoed,","poem":1},{"text":"Be-Igarbarbi an nue-nanadii guoed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Be-Igar-Mamaidgi an weligwar itogoed.","poem":1},{"text":"Bipisaale, an Be-Gayaburba gwen iegosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"An be-mai-guedi, nue-wile be dakdii guo,","poem":1},{"text":"deyobi, an nabir gudii guoed,","poem":2},{"lineBreak":true},{"text":"be-Gayaburba-sogedba an nanadii guoed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Be-Igar-Biriginmalad-Mamaid,","poem":1},{"text":"magar-itogega be an-imake.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"We-napneggine, an dule-baid gued,","poem":1},{"text":"melle angi Be-Igar-Islidik-Mamaid be odukue.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bane-bane an Be-Igar-Nabolemalad bei-durdakbiedbali,","poem":1},{"text":"an yaisur-itoged.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Dule-san-dummarba-imakmaladse be urwemaid.","poem":1},{"text":"Dule-isganamar, Be-Igar-Islidik-Mamaidgi-banguder, ega be sabsur-ibmar soged.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Melle we-dulemar isdar-an-dakmalaga, be imako.","poem":1},{"text":"Melle ibgwensur-an-samalaga be imako,","poem":2},{"lineBreak":true},{"text":"Ar an Be-Igar-Mamaidba an nanadiid.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Dule-gandikmalad angi ichakwa-sunmakmar-inigwele,","poem":1},{"text":"andi be-mai-guedi, Be-Igar-Mamaidginbi binsadii guoed.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Be-Igar-Mamaid, weligwar an-imaked,","poem":1},{"text":"anga binsaed-ukedid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"An san bela-itoged,","poem":1},{"text":"Be-Anga-Ibmar-Sogsadba be an-ogannoge.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"An-gudiidgi an bega sunmaksagua, be an-abin-imaksad.","poem":1},{"text":"¡Be-Igar-Mamaidgi be an-odurdake!","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Be-Igar-Islidik-Mamaidi, magar-itogega be an-imake,","poem":1},{"text":"adi, be-ibmar-gegerdaklemaladgi an binsaegar.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"An ulubgi wile-itogedba bodiid,","poem":1},{"text":"degisoggu, Be-Gayaburbagi baisur-itogega be an-imake.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Gakan-igarmargi mer-nanaega be an-imake.","poem":1},{"text":"Be-wile-dule-dakmaidba Be-Igar-Nuegan-Maidgi be an-odurdake.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Igar-Napiragwad-Maid an susad.","poem":1},{"text":"Be-Igar-Mamaid angadga an imaksad.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Bab-Jehová, Be-Igar-Sogsadgi an alamaknaid,","poem":1},{"text":"melle bingeguega be an-imako.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Be-Igar-Islidik-Mamaidba an gwae ibsaoed,","poem":1},{"text":"ar gwage-weligwar an-imakdaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Bab-Jehová, Be-Igar-Mamaidgi be an-odurdake,","poem":1},{"text":"an eba nanadii guoed.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Be-Igar-Maidba-nanaegala, Be-Igar-Maid magar-itogega be an-imake.","poem":1},{"text":"Geb gwage-ulubgi bela-belad eba an nanadii guoed.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Be-Igar-Islidik-Mamaidba be an-iduge,","poem":1},{"text":"ar agi an wergued amied.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Unnila Be-Igar-Mamaidbarbi-binsaega be an-imake.","poem":1},{"text":"Melle ibmar-baiganbina-surbinsa-itoged be an-imake.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Melle ibmar-binsarmaladbina-sogega be an-imake.","poem":1},{"text":"Be-Igar-Maidba-nanaega be an-imake.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Igi be dule-be-dobee-nanadimaladga be ibmar imaksa,","poem":1},{"text":"deyobi, an-be-mai-guedga be Ibmar-Imakoye-Sogsad, be imake.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Mesagwar-imaklegedgi an dobe-itodiidgi be an-onoge,","poem":1},{"text":"ar Be-Igar-Nabogedi, we, ibnuedid.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Be-Igar-Islidik-Mamaidbina an nue-soged.","poem":1},{"text":"Be-igar-innikii-imakedba dula-gudii be an-imake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"Bab-Jehová, igi na be Sogsa-Gusa,","poem":1},{"text":"deyob be-sabgued be anse oyoge,","poem":2},{"lineBreak":true},{"text":"deyob dule-bendaked be anse oyoge.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Deyobi, dule-isdar-an-dakmaladga an sogoed.","poem":1},{"text":"Ar Be-Ibmar-Sogsadgi an bensulid.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"An-gwabinduku, ibmar-inniki-soged be imake.","poem":1},{"text":"Ar Be-Igar-Mamaidgi an bensulid.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Be-Igar-Mamaidba an degisadegu ibsadii guoed,","poem":1},{"text":"Deyob degisadegu an imakoed.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"An bonisuli nanadii guoed,","poem":1},{"text":"ar an Be-Igar-Islidik-Mamaid amisad.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Be-Igar-Mamaidgi reymar-asabin an sunmakoed,","poem":1},{"text":"gwen an bingeguosulid.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Be-Igar-Islidik-Mamaidbina an nue-soged,","poem":1},{"text":"an egi wergued.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Be-Igar-Islidik-Mamaid an nue-sabedbali, an-argan an onakoed,","poem":1},{"text":"Be-Igar-Maidgi an binsaoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"An-be-mai-guedga be Ibmar-Sogsa-Gusadi be ebinsao,","poem":1},{"text":"a-Gayaburba-abdakagwar-gudiguega, be an-imaksad.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"An bukib-binsaedba-wile-itodiidgi, a-Gayaburba baisur-itogega an-imaked,","poem":1},{"text":"Be-Ibmar-Sogedi, an-ogannodaed.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Dule-san-dummarba-imakmalad angi nue-isdar sunmakdimalad,","poem":1},{"text":"degi-inigwele, andi Be-Igargi bangudisulid.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Bab-Jehová, be epenne Be-Igar-Nabosadi an ebinsaed.","poem":1},{"text":"A-Igarmala, an-gwage-baisur-itogega imaked.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Dule-isganamar Be-Igar-metemaladi,","poem":1},{"text":"sae-itogega an-imaked.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"An we-napneggi sikwas-gudiidgi,","poem":1},{"text":"Be-Igar-Mamaid, an-namakedga gusad.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Bab-Jehová, mutikgusale, an be-ebinsaardaed.","poem":1},{"text":"Be-Igar-Sogedba an nanabied.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Be-Igar-Islidik-Mamaid-sogedba-nanadiguedi, angi siid,","poem":1},{"text":"an imakedsegad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":57,"content":[{"text":"Bab-Jehová, bebi angadga gued,","poem":1},{"text":"Be-Gayaburbaba-nanaoye an sogsad.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Bela-bela gwagegi an be-amidiid.","poem":1},{"text":"Be-Ibmar-Sogsadba ise-wile be an-dake.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"An-daedgi an binsaargua,","poem":1},{"text":"Be-Igar-Mamaidba an gannar nanaded.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Be-Igar-Islidik-Mamaid-sogedba nanaegala,","poem":1},{"text":"an undar-binsadii gussulid.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"Dule-isganamar an-gaegala, an-ebirdimalad.","poem":1},{"text":"Degi-inigwele, Be-Igar-Maidi an gwen-iessulid.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"Be-Igar-Inniki-Maid-nukad, an bega dog-nuedye-sogegala,","poem":1},{"text":"nega-gabigwenbali an gwichiguardaed.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Ani an, dulemar-be-dobekwaa-nanadimalad-e-aid.","poem":1},{"text":"Ani an, Be-Igar-Islidik-Mamaidba-nanadimalad-e-aid.","poem":2}]},{"type":"verse","number":64,"content":[{"text":"Bab-Jehová, ¡Be-Igar-Mamaidgi be an-odurdake!","poem":1},{"text":"We-napneg-naidgi bela be-sabgued-nikadi oyolenaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":65,"content":[{"text":"Bab-Jehová, bee be, Be-Ibmar-Sogsadbali,","poem":1},{"text":"be nued an-nidii gusad.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"An Be-Igar-Islidik-Mamaidgi an bensulid.","poem":1},{"text":"Agala, gatik-ibmar-wisgued be an-imake,","poem":2},{"lineBreak":true},{"text":"ibmar-mag-itoged be an-imake.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"An sabsur-odurdakleged-iduale, an-itolegedba galagwensuli an gudii daed.","poem":1},{"text":"Emigindi, Be-Gayaburba-Sogedba an nanadiid.","poem":2}]},{"type":"verse","number":68,"content":[{"text":"Bab-Dummad, bedi dule-nuedid.","poem":1},{"text":"Be, ibmar-nuegan-imakedid.","poem":2},{"lineBreak":true},{"text":"¡Be-Igar-Mamaidgi be an-odurdake!","poem":2}]},{"type":"verse","number":69,"content":[{"text":"Dule-san-dummarba-imakmaladi angi isdar-sunmakmalad.","poem":1},{"text":"Degi-inigwele, andi gwagegi bela-belad Be-Igar-Islidik-Mamaid-sogedba an nanaed.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"We-dulemar, gwage-dutusurmaladid.","poem":1},{"text":"Andina, Be-Igar-Maidgi wergudiid.","poem":2}]},{"type":"verse","number":71,"content":[{"text":"Bur-nueddo, an sabsur-odurdaklesgu.","poem":1},{"text":"Abali, an Be-Igar-Mamaid durdaknonikid.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"Be-Igar-Maidi, olo-mili-milibalidba bur bule ibnuedid.","poem":1},{"text":"Be-Igar-Maidi, mani-mili-milibalidba bur bule anga ibidar-nuedga gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":73,"content":[{"text":"Bee be, we-napnegse an-barmialid, bee be, anga burba uksad.","poem":1},{"text":"Be-Igar-Mamaid-durdakegala, nono-nued be anga udage.","poem":2}]},{"type":"verse","number":74,"content":[{"text":"Dulemar-be-nug-ogannodimalad an-dakalile, weligwar-itodmaloed,","poem":1},{"text":"ar an, Be-Gayaburbagi, bensuli gudiid.","poem":2}]},{"type":"verse","number":75,"content":[{"text":"Bab-Jehová, an wisid, Be-Igar-Mamaidi innikigwadbiid.","poem":1},{"text":"Degisoggu, nabiridba sabsur-be-an-odurdaksado.","poem":2}]},{"type":"verse","number":76,"content":[{"text":"Be-sabguedi, an-gwage-baisur-itoge imaked.","poem":1},{"text":"Ar Be-Anga-Sogsagusadba be imaksad.","poem":2}]},{"type":"verse","number":77,"content":[{"text":"Be-wile-dule-dakedi, anse be oyodage.","poem":1},{"text":"Dula-gudii be an-imakdage.","poem":2},{"lineBreak":true},{"text":"Ar Be-Igala, weligwar an-imakedid.","poem":2}]},{"type":"verse","number":78,"content":[{"text":"Dule-san-dummarba-imakmalad, obingegsalesun,","poem":1},{"text":"ar binsarsunna an-ogakansadimalad.","poem":2},{"lineBreak":true},{"text":"Andi Be-Igar-Islidik-Mamaidgi bur binsaoed.","poem":2}]},{"type":"verse","number":79,"content":[{"text":"Dulemar-be-nug-ogannodimalad, gannar anbo-atogega be imaksun.","poem":1},{"text":"Dulemar-Be-Igar-Mamaid-wismalad, gannar anbo-atogega be imaksun.","poem":2}]},{"type":"verse","number":80,"content":[{"text":"An-gwage Be-Igar-Mamaidba innikii nanasun,","poem":1},{"text":"adi, an melle bingeguegar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":81,"content":[{"text":"Bab-Jehováʼye, bela-belad be-an-bendaked an abdakdiid,","poem":1},{"text":"Be-Ibmar-Sogsadgi an bensulid.","poem":2}]},{"type":"verse","number":82,"content":[{"text":"Be Anga-Ibmar-Sogsad-abdakdiidbali, an-dala galakuded.","poem":1},{"text":"An weyob soged: “¿Sana wede gwage-baisur-itogega be an-imaknonikoe?”","poem":2}]},{"type":"verse","number":83,"content":[{"text":"Bato an seredgus-inigwele, wagar-bapigwargus-inigwele,","poem":1},{"text":"amba Be-Igar-Mamaid gwen an iedisulid.","poem":2}]},{"type":"verse","number":84,"content":[{"text":"¿Bule napi an dula gudii guoe?","poem":1},{"text":"¿Sana be, dule-an-balegindimalad-sabsur-odurdakoe?","poem":2}]},{"type":"verse","number":85,"content":[{"text":"Dule-san-dummarba-imakdimaladi, an-yardakega igar amismalad.","poem":1},{"text":"Be-Igar-Sogedba-nanadisurmaladi, an-yardakega igar amismalad.","poem":2}]},{"type":"verse","number":86,"content":[{"text":"Bela Be-Igar-Mamaidi innikigwadbiid.","poem":1},{"text":"¡Bab-Dummadye, be an-bendake!","poem":2},{"lineBreak":true},{"text":"Binsarsunna an-balegindimalad.","poem":2}]},{"type":"verse","number":87,"content":[{"text":"Napneggi an-oburgwednaga gusmalad.","poem":1},{"text":"Degi-inigwele, andi Be-Igar-Mamaidgi gwen bangussulid.","poem":2}]},{"type":"verse","number":88,"content":[{"text":"Be-sabed-dummarba-nikadbali, be anga burba-ogannosun.","poem":1},{"text":"Be-Igar-Mamaid-sogedba an nanaoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":89,"content":[{"text":"Bab-Jehová, Be-Gayaburbadi degisadeguad,","poem":1},{"text":"nibneggi, Be-Gayaburbadi gwen gwagmaisulid.","poem":2}]},{"type":"verse","number":90,"content":[{"text":"Be-innikidaedi, degisadeguad.","poem":1},{"text":"Napneg be nasiksad, innikigwadba nagusad.","poem":2}]},{"type":"verse","number":91,"content":[{"text":"Be-Igar-Uksadbali, emi-iba-akale, we-ibmarmar amba bukwad.","poem":1},{"text":"Bela we-ibmarmala be-sogedba ibmar-imakbukwad.","poem":2}]},{"type":"verse","number":92,"content":[{"text":"Be-Igar-Maid, weligwar an-imaksasulina,","poem":1},{"text":"bukib-binsaedba an bato bergusbinnenad.","poem":2}]},{"type":"verse","number":93,"content":[{"text":"Bipisaale, Be-Igar-Mamaid an gwen iegosulid,","poem":1},{"text":"ar we-igarbali, be an-san-burba dula imaksad.","poem":2}]},{"type":"verse","number":94,"content":[{"text":"Bab-Jehováʼye, be an-bendake,","poem":1},{"text":"andi, begadga-gued.","poem":2},{"lineBreak":true},{"text":"Andi, Be-Igar-Islidik-Mamaid ulubse baramidiid.","poem":2}]},{"type":"verse","number":95,"content":[{"text":"Dule-isganamar an-obelobigudimalad.","poem":1},{"text":"Andi, Be-Igar-Mamaid-magar-itogega alamakdiid.","poem":2}]},{"type":"verse","number":96,"content":[{"text":"Bela ibmarmar e-bergued-nika an dakdiid.","poem":1},{"text":"Unnila, Be-Igar-Islidik-Mamaidbi gege bergued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":97,"content":[{"text":"¡Be-Igar-Maidbina an nue soged!","poem":1},{"text":"Bane-bane an egi binsadaed.","poem":2}]},{"type":"verse","number":98,"content":[{"text":"Be-Igar-Mamaidi, an-isdarmaladbali bur bule binsaed-nika an-imaked.","poem":1},{"text":"Ar Be-Igar angadga an imaksad.","poem":2}]},{"type":"verse","number":99,"content":[{"text":"Bela an-odurdakmaladba bur bule an ibmar magar-itoged.","poem":1},{"text":"Ar an Be-Igar-Mamaidgi binsadigu daed.","poem":2}]},{"type":"verse","number":100,"content":[{"text":"Girmarba bur bule an ibmar magar-itoged.","poem":1},{"text":"Ar an Be-Igar-Mamaid-sogedba nanadiid.","poem":2}]},{"type":"verse","number":101,"content":[{"text":"Be-Gayaburba-Sogedba-nanaegala,","poem":1},{"text":"bela igar-isganagi an bangusad.","poem":2}]},{"type":"verse","number":102,"content":[{"text":"Be-Igar-Mamaidgi an bangussulid,","poem":1},{"text":"ar bee be an-odurdaksad.","poem":2}]},{"type":"verse","number":103,"content":[{"text":"Ibibayobi Be-Gayaburba anga ochii gue.","poem":1},{"text":"Achanis-maedba bur bule anga ochii gued.","poem":2}]},{"type":"verse","number":104,"content":[{"text":"Be-Igar-Mamaidbali, an binsaed-nuegan amidiid.","poem":1},{"text":"A-ulale, bela gakan-igarmar an isdar daked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":105,"content":[{"text":"Be-Gayaburba gwallu-meegwadyobi an-iduedga gued.","poem":1},{"text":"Neg-ibegwalebayobi anga igar oyoged.","poem":2}]},{"type":"verse","number":106,"content":[{"text":"An bega ibmar-ise-sogar-sogsadi, an imakedsegad.","poem":1},{"text":"Be-Igar-Mamaid-sogedba an nanadii guoed.","poem":2}]},{"type":"verse","number":107,"content":[{"text":"Bab-Jehová, an bela-bela bato nue dummad-wilediid.","poem":1},{"text":"¡Be-Gayaburba-sogedba be an-ogannoge!","poem":2}]},{"type":"verse","number":108,"content":[{"text":"Bab-Jehová, an bega ibmar-sogedi be abingasana gadin.","poem":1},{"text":"Be-Igar-Mamaidgi be an-odurdake.","poem":2}]},{"type":"verse","number":109,"content":[{"text":"Bonigan-abargi an-sandi gudiid,","poem":1},{"text":"degi-inigwele, Be-Igar-Maiddi an iedisulid.","poem":2}]},{"type":"verse","number":110,"content":[{"text":"Dule-isganamar an-yardakbimalad,","poem":1},{"text":"degi-inigwele, Be-Igar-Mamaidgi andi bangudisulid.","poem":2}]},{"type":"verse","number":111,"content":[{"text":"Be-Igar-Mamaidi, degisadegu angadga-guega an susad,","poem":1},{"text":"ar an-gwage-weligwar imakdaed.","poem":2}]},{"type":"verse","number":112,"content":[{"text":"Degisadegu, an-burgwedsega","poem":1},{"text":"gwage-ulubgi Be-Igar-Mamaid-sogedba nanadioye an sogsad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":113,"content":[{"text":"Dule-wagar-darbo-damaladi, an isdar daked.","poem":1},{"text":"Be-Igar-Islidikiddi, an nue-sabed.","poem":2}]},{"type":"verse","number":114,"content":[{"text":"Bab-Dummad, bedi an-odukuega gued,","poem":1},{"text":"bedi an-sigu-abgaedibayobi anga gued,","poem":2},{"lineBreak":true},{"text":"Be-Ibmar-Sogsadi, an edarbediid.","poem":2}]},{"type":"verse","number":115,"content":[{"text":"“¡Dule-isganamar, be angi bangue!","poem":1},{"text":"An-Bab-Dummad-Igar-Mamaidba an nanabied.”","poem":2}]},{"type":"verse","number":116,"content":[{"text":"Be-Gayaburba-Maidbali, be an-ogannoge, agi an dula gudiguoed.","poem":1},{"text":"An-ibmar-edarbediidgine, melle bingeguega be an-imake.","poem":2}]},{"type":"verse","number":117,"content":[{"text":"Be an-bendake, adi, an bendaklegoed.","poem":1},{"text":"Be-Igar-Mamaidgi, an weligwar itodiguoed.","poem":2}]},{"type":"verse","number":118,"content":[{"text":"Dulemar-Be-Igar-Mamaidgi-nodimaladi, be isdar dakdaed.","poem":1},{"text":"Ar gakansaedginbi binsadidamalad.","poem":2}]},{"type":"verse","number":119,"content":[{"text":"Napneggi dule-isganamar-bukwadi, ibmar-isgana-milediidyob be daked.","poem":1},{"text":"A-ulale, an Be-Igar-Mamaidbina nue-soged.","poem":2}]},{"type":"verse","number":120,"content":[{"text":"An be-dobedbali, be-asabin an wawanmakgwichid,","poem":1},{"text":"Be-Igar-Nabolemalad-dobee an itoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":121,"content":[{"text":"Igar-inniki-imaklemalad an imakdiid.","poem":1},{"text":"Melle dule-mesagwar-an-imakdimaladga be an-urmako.","poem":2}]},{"type":"verse","number":122,"content":[{"text":"An-be-mai-guedga, igar-nueganbi-guega be imako.","poem":1},{"text":"Melle dule-san-dummarba-imakmaladi mesagwar-an-imakega be imako.","poem":2}]},{"type":"verse","number":123,"content":[{"text":"Be an-abonogega, an be-abdakdiidba an-dala mommoleded.","poem":1},{"text":"Be-Igar-Sogsad anga-guedi, an edarbediid.","poem":2}]},{"type":"verse","number":124,"content":[{"text":"Sabed-dummarba be nikadbali, be-mai be sabguo.","poem":1},{"text":"Be-Igar-Mamaid be an-odurdake.","poem":2}]},{"type":"verse","number":125,"content":[{"text":"Andi be-mai gued.","poem":1},{"text":"An Be-Igar-Mamaid-durdakega, Be-Igar-Mamaid mag-itoge be an-imake.","poem":2}]},{"type":"verse","number":126,"content":[{"text":"Bab-Jehová, ar Be-Igar-Mamaidba nanasurmarsoggu,","poem":1},{"text":"be-ibmar-imakbied be imaksunna.","poem":2}]},{"type":"verse","number":127,"content":[{"text":"Bela ibmarmar-baiganba bur bule Be-Igar-Mamaid bur an sabed.","poem":1},{"text":"Be-Igar-Mamaidbina olobali bur bule an bina soged.","poem":2},{"lineBreak":true},{"text":"Olo-sunnadbali bur bule an bina itoged.","poem":2}]},{"type":"verse","number":128,"content":[{"text":"A-ulale, Be-Igar-Mamaidbali an nanaed.","poem":1},{"text":"Bela Be-Igar ibmar-baiganbali nueganbi an daked.","poem":2},{"lineBreak":true},{"text":"Bela gakan-igarmardi an isdar daked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":129,"content":[{"text":"Be-Igar-Mamaidi doggus-ibnuedid.","poem":1},{"text":"A-ulale, an e-sogedba nanadiid.","poem":2}]},{"type":"verse","number":130,"content":[{"text":"Be-Gayaburbagi sunmakledele, magar ibmar-itogega anmar-imaked.","poem":1},{"text":"Dule-ibmar-wissulid magar-ibmar-itogega imakbalid.","poem":2}]},{"type":"verse","number":131,"content":[{"text":"An bela-bela Be-Igar-Mamaid-durdakbiedbali,","poem":1},{"text":"Be-Gayaburbabina an nue soged.","poem":2}]},{"type":"verse","number":132,"content":[{"text":"Bab-Dummad, wile-be-an-dake.","poem":1},{"text":"Igi be gusgu dule-be-nug-odummodimaladi wile be dakdae,","poem":2},{"lineBreak":true},{"text":"deyobi, be an-dakmoga.","poem":2}]},{"type":"verse","number":133,"content":[{"text":"Be-Igar-Sogsadba-nanaega be an-imake.","poem":1},{"text":"Melle igar-isgana angi obinega be imake.","poem":2}]},{"type":"verse","number":134,"content":[{"text":"Dule-ibmar-sabsur-imakedgi be an-ollor-imake,","poem":1},{"text":"ar an Be-Igar-Mamaidba an nanabied.","poem":2}]},{"type":"verse","number":135,"content":[{"text":"Be-ise-nued-binsaedi be-maiga be oyoge.","poem":1},{"text":"¡Be-Igar-Mamaidgi be an-odurdake!","poem":2}]},{"type":"verse","number":136,"content":[{"text":"Be-Igar-Mamaidba bar nanasurgusmalad-ulale,","poem":1},{"text":"an-ibyanis suurmakemaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":137,"content":[{"text":"Bab-Jehová, bedi dule-innikigwadid,","poem":1},{"text":"innikigwadba bedi igarmar nabogedid.","poem":2}]},{"type":"verse","number":138,"content":[{"text":"Be-Igar-Mamaid-be-uksadi, bela innikigwadbiid.","poem":1},{"text":"Be-Igar-Mamaidgi bengulesulid.","poem":2}]},{"type":"verse","number":139,"content":[{"text":"An-isdarmalad Be-Gayaburba-Maid-iedmaladbali,","poem":1},{"text":"an bela-bela nue sae-itoged.","poem":2}]},{"type":"verse","number":140,"content":[{"text":"Be-Gayaburba isedar-swilidikidid,","poem":1},{"text":"a-ulale, an Be-Gayaburba nue-sabed.","poem":2}]},{"type":"verse","number":141,"content":[{"text":"Andi san-bipi-imakdiidbali, ibgwensur daklediid,","poem":1},{"text":"degi-inigwele, Be-Igar-Mamaidi, an iedisulid.","poem":2}]},{"type":"verse","number":142,"content":[{"text":"Be Igar-Inniki-Imakedi, degisadegu innikigwadbiid.","poem":1},{"text":"Be-Igar-Mamaidi, napiragwadid.","poem":2}]},{"type":"verse","number":143,"content":[{"text":"Surbinsa an itononikile, Be-Igar-Mamaiddi weligwar an-imaked.","poem":1},{"text":"Suli-suli an itononikile, Be-Igar-Mamaiddi weligwar an-imaked.","poem":2}]},{"type":"verse","number":144,"content":[{"text":"Be-Igar-Mamaiddi, gusgu innikigwadbiid.","poem":1},{"text":"A-igarba nabir gudiguega, a-igar-magar-itoge be an-imake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":145,"content":[{"text":"Bab-Jehová, bela-bela gwagegine an bese goled. Be an-abinsae.","poem":1},{"text":"Be-Igar-Mamaid-sogedba an nanabied.","poem":2}]},{"type":"verse","number":146,"content":[{"text":"An-bendakye an bese goled.","poem":1},{"text":"Ar Be-Igar-Mesisad-sogedba an nanabied.","poem":2}]},{"type":"verse","number":147,"content":[{"text":"Bese bendakleged egisegala, wakudaryalaba an gwisguardaed.","poem":1},{"text":"An Be-Gayaburbagi bensulid.","poem":2}]},{"type":"verse","number":148,"content":[{"text":"Be-Igar-Mamaidgi-binsaedba,","poem":1},{"text":"mutikidbali, an gabdasulid.","poem":2}]},{"type":"verse","number":149,"content":[{"text":"Be dule-wile-nue-dakdasoggu, be an-itoge.","poem":1},{"text":"Bab-Jehová, Be-Igar-Innikigwadba be an-ogannoge.","poem":2}]},{"type":"verse","number":150,"content":[{"text":"Dule-isganamar-an-balegindimaladi, an-walikgudanikid.","poem":1},{"text":"Amar, Be-Igar-Mamaidgi bangus gudimalad.","poem":2}]},{"type":"verse","number":151,"content":[{"text":"Bab-Jehová, be an-walikaa gudiid.","poem":1},{"text":"Be-Igar-Mamaidi, belagwable napiragwadbiid.","poem":2}]},{"type":"verse","number":152,"content":[{"text":"Dikasurgus, an Be-Igar-Mamaid wisi gudiid,","poem":1},{"text":"ar gusgu be a-Igar omesisad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":153,"content":[{"text":"An-wile-itodiidi be dake,","poem":1},{"text":"bonigangi be an-ollor-imake,","poem":2},{"lineBreak":true},{"text":"ar an Be-Igar-Mamaidi gwen an iedisulid.","poem":2}]},{"type":"verse","number":154,"content":[{"text":"Be an-irwa gwisgue, be an-bendake.","poem":1},{"text":"Be-Gayaburba-sogsadba be an-ogannoge.","poem":2}]},{"type":"verse","number":155,"content":[{"text":"Dule-isganamargi, burbar-bendakleged-igar dikasur naid,","poem":1},{"text":"ar Be-Igar-Mamaidi gwen-amisurmalad.","poem":2}]},{"type":"verse","number":156,"content":[{"text":"Bab-Jehová, be-dule-wiledakedi dummarbaa gued.","poem":1},{"text":"Be Igar-Nabomaidba, burba-dulad be anga uke.","poem":2}]},{"type":"verse","number":157,"content":[{"text":"Dule-an-balegindimalad bukidarad, an-isdardakmalad bukidarad,","poem":1},{"text":"degi-inigwele, Be-Igar-Mamaidgi an bangudisulid.","poem":2}]},{"type":"verse","number":158,"content":[{"text":"An dule-yardakdimalad-dakalile, an sae-dakdaed,","poem":1},{"text":"ar Be-Gayaburba-sogedba gwen nanadisurmalad.","poem":2}]},{"type":"verse","number":159,"content":[{"text":"¡Bab-Jehová, be dake! Ibiyobi Be-Igar-Mamaid an sabe.","poem":1},{"text":"Be sabgued-dummarba-nikadbali, burba-dulad wis be anga uke.","poem":2}]},{"type":"verse","number":160,"content":[{"text":"Bela Be-Gayaburba-Mamaidi napiragwadid,","poem":1},{"text":"Be-Igar-Maidi bela innikigwadba degisadegu maid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":161,"content":[{"text":"Ar binsarsunna dule-gandikmaladi an-balegindiid,","poem":1},{"text":"an-gwage-ulubgine an Be-Gayaburba-dobekwaa nanadiid.","poem":2}]},{"type":"verse","number":162,"content":[{"text":"Be-Gayaburbagi an weligwar-itoged,","poem":1},{"text":"dule-ibmar-nuegan-gargerbamalad-amisadyobi, an egi wergued.","poem":2}]},{"type":"verse","number":163,"content":[{"text":"Gakan-igar an sae-daked, an nue-isdarsunna-dakdaed.","poem":1},{"text":"Degi-inigwele, Be-Igar-Maiddi an nue-sabed.","poem":2}]},{"type":"verse","number":164,"content":[{"text":"Be-Igarmar nue-napiragwad-guedbali,","poem":1},{"text":"an bali-bali be-nug odummoged.","poem":2}]},{"type":"verse","number":165,"content":[{"text":"Dule-Be-Igar-Mamaid-sabgudimaladi, gwagegi bogidik itodimalad.","poem":1},{"text":"Wemar igar-isganaba gege selemalad.","poem":2}]},{"type":"verse","number":166,"content":[{"text":"Bab-Jehováʼye, wis be an-bendakena gadin.","poem":1},{"text":"Ar Be-Igar-Mamaidbali an ibmar imakdiid.","poem":2}]},{"type":"verse","number":167,"content":[{"text":"Bela-belad an Be-Igar-Mamaid-sogedba nanadiid,","poem":1},{"text":"ar an Be-Igar nue-sabed.","poem":2}]},{"type":"verse","number":168,"content":[{"text":"Bela Be-Igarmar-Mamaidba an nanadiid,","poem":1},{"text":"ar bela be an-ibmar-saedi wisid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":169,"content":[{"text":"Bab-Jehováʼye, gandikidba an bese-goledi, bese warmaksun.","poem":1},{"text":"Be-Gayaburba-Maidba magar-ibmar-itogega be an-imake.","poem":2}]},{"type":"verse","number":170,"content":[{"text":"An bese ise-wilesakwaa-goledi bese warmaksun.","poem":1},{"text":"Be-Ibmar-Sogsadba be an-bendake.","poem":2}]},{"type":"verse","number":171,"content":[{"text":"Be-Igarmar-Mamaidgi be an-odurdaksad.","poem":1},{"text":"A-ulale, an-gwabinduku be-nug ogannoged.","poem":2}]},{"type":"verse","number":172,"content":[{"text":"Ar bela Be-Igar-Mamaid innikigwadbisoggu,","poem":1},{"text":"Be-Ibmar-Sogsadgi an namaked.","poem":2}]},{"type":"verse","number":173,"content":[{"text":"Bab-Jehováʼye, Be-Igar-Mamaidi angadga an imaksasoggu,","poem":1},{"text":"gwae be an-bendakdage.","poem":2}]},{"type":"verse","number":174,"content":[{"text":"Bab-Jehováʼye, wis be an-bendaked an be-abeged.","poem":1},{"text":"Be-Igar-Maidi weligwar an-imakedid.","poem":2}]},{"type":"verse","number":175,"content":[{"text":"Be-nug-odummogega, dula-gudii be an-imake,","poem":1},{"text":"Be-Igar-Nabolemaladi, an-bendakega gusun.","poem":2}]},{"type":"verse","number":176,"content":[{"text":"Sibad-wawaad-yoggus-gudibayobi, an gudiid.","poem":1},{"text":"An-be-maiga-gudiid be amidage,","poem":2},{"lineBreak":true},{"text":"ar Be-Igar-Mamaidi an gwen iedisulid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/120.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":176}