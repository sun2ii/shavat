{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"heading","content":["Bab-Dummadse bendakleged-egised"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad. Namakmalad-e-iduedga soglenaid:"]},{"type":"hebrew_subtitle","content":["We-namakleged, Seminitʼba namaklegoye."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼye, be anmar-bendake.","poem":1},{"text":"Dule-be-sogedba-nanamalad bergusad.","poem":2},{"lineBreak":true},{"text":"We-napneggine, dule-napiragwad bar-daklesulid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dulemar na muchub-muchub gakangi sunmakmalad,","poem":1},{"text":"nue-nabiridyob sunmakmalad.","poem":2},{"text":"Asginbi nued sunmakmalad,","poem":1},{"text":"ulubgindi, emar-yardakedgi binsamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bab-Jehováʼye, dule-nue-nabiridyob-sunmakmalad, bela be obeloge.","poem":1},{"text":"Dule-san-dummarba-sunmakmalad, bela be osuloge.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"We-dulemar sogdimalad:","poem":1},{"text":"“Sunmakedgi anmar dulemargi obinoed.","poem":2},{"text":"Aga anmar gwabin-duku nikasursi.","poem":1},{"text":"Anmar-gwabin-duku dule-baidgadsulid.","poem":2},{"text":"¿Degite, doa anmargi obinosunna?","poem":1},{"text":"Dule anmargi-obined sate.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Emide, Bab-Jehová, bede soged:","poem":1},{"text":"“Dule-e-bendaked-satemalad mesagwar-imaklediid-ular, an gwisguoye.","poem":2},{"text":"Dule ibmar-sate-gudimaladba bela-belad-bodimalad,","poem":1},{"text":"an bendakoye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bab-Jehová-gayaburba isedar-swilimakaledid.","poem":1},{"text":"Igi mani swilimakar-imaklegega, soo-yagi gannar-gannar ilagugle (7) dulege,","poem":2},{"lineBreak":true},{"text":"aba bur bule Bab-Dummad-gayaburba swilidik gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bab-Jehováʼye, bebi-unnila dule-isganamar-idu, be anmar-edarboed.","poem":1},{"text":"We-dule-isganamar-idu, degisadegu, be anmar-irwa gwisguoed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dule-isganamar anmar-ebirdiile, bee be anmar-edarboed.","poem":1},{"text":"We-napneggi igar-isganamar bur yeerdaklealile, bee be anmar-bendakoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}