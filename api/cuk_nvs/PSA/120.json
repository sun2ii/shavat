{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"heading","content":["Dule-gakansilimargi e-ollor-imakega Babse-goled"]},{"type":"hebrew_subtitle","content":["We-namaked, Jerusalénʼse-nakwe-nadapir, namakleged."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼse an surbinsa-itogedgi gochad,","poem":1},{"text":"Bab-Jehová an-abin-imaksad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová, dule-gakansilimargi be an-ollorsae,","poem":1},{"text":"dule-emar-yardakmaladgi be an-ollorsae.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dule-yardakmalad, ¡be dule-wilesmar!","poem":1},{"text":"¿Ar ibu bemarga uklegoe?","poem":2},{"lineBreak":true},{"text":"¿Ar ibu egi bemar nikuoe?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bila-onomalad-e-sigu-swiswidikid-ginnitibi-aramakmaidi,","poem":1},{"text":"begi mioed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¡Andi, duledar-wiles! Andi dule-ibmar-wissurmalad-abargi gudiid.","poem":1},{"text":"An Mesec-neggweburgi-maiyobi gudiid,","poem":2},{"lineBreak":true},{"text":"an Cedar-dulemar-abargi-maiyobi gudiid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dule-neg-bogidikid-abesurmalad-abargi","poem":1},{"text":"bato an dikasurgus maid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Andi, dule-belagwadaedid.","poem":1},{"text":"Ar an neg-bogidikid-nasikedgi sunmakele, emardi bila-onomaladgi sunmakmalad.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}