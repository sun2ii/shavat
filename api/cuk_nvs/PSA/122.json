{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"heading","content":["Jerusalén-neggwebur-bogidik-sigega, Bab-Dummadse gorlenaid"]},{"type":"hebrew_subtitle","content":["We-namaked, Jerusalénʼse-nakwe-nadapir, namakleged."]},{"type":"verse","number":1,"content":[{"text":"Dule anga sogdemalale: “¡Bab-Jehová-e-negse anmar namarye!”","poem":1},{"text":"An weligwar-itoddaed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jerusalén-neggwebur,","poem":1},{"text":"be-neg-e-yawagak-asabin bato anmar gwichid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Jerusalén neggwebur-gandikidid,","poem":1},{"text":"be-soblesadi, nuekwaa soblesad.","poem":2},{"lineBreak":true},{"text":"Begi nabir ambikumalaga be soblesad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Jerusalén-neggwebursega dadgan-warambe-gakabogwad-e-wagan (12) Bab-Jehová-e-nug-odummogegala, ese nakwemai damalad.","poem":1},{"text":"Igi Bab-Jehová Israel-dulemarga igar-uksagusa, deyobi, gunonikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Jerusalén-neggweburgine igar-naboged-e-ganmar siid,","poem":1},{"text":"agi David-e-wagan-igar-naboged-e-ganmar siid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Jerusalén-neggweburga anmar neg-bogidikid ega egise.","poem":1},{"text":"Be-sabgudimaladga ibmar nasgumaigusun.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Be-galu-matusulidga, neg-bogidik nagusun.","poem":1},{"text":"Be-neg-dummagan-bukwadga, neg-bogidik nagusun.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"An-gwenadgan-sabed-nuggi, an-aimar-sabed-nuggi, an soged:","poem":1},{"text":"“¡Neg bogidikid bega gusun!”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anmar-Bab-Dummad-Jehová-e-neg-sabedba,","poem":1},{"text":"bega nueganbi-ibmar-guega an imakoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}