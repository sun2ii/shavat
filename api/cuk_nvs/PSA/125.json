{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"heading","content":["Bab-Dummad e-dulemargi nakulediid"]},{"type":"hebrew_subtitle","content":["We-namaked, Jerusalénʼse-nakwe-nadapir, namakleged."]},{"type":"verse","number":1,"content":[{"text":"Dulemar Bab-Jehováʼgi-bensurmalad Sión-yalayobi gued.","poem":1},{"text":"Sión-yala degisadegu sii guoed, bipisaale ainirosulid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Igi yarmar Jerusalén-ebirbukwananae,","poem":1},{"text":"deyobi, Bab-Jehová e-dulemar-edarbedii degisadegu gumogoed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dulemar-isgana, dule-nueganga degisadegu negsemai guosulid,","poem":1},{"text":"adi, melle dule-nuegan ibmar-isganamarse binsaed galemalagar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Jehováʼye, dule-nueganga ibmar-nuegan be imake.","poem":1},{"text":"Dule-gwage-swilidikmaladga ibmar-nuegan be imake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Jehováʼye, dule igar-isganaba-naddamaladdi,","poem":1},{"text":"dule-isganamarba bergued be imakmoga.","poem":2},{"lineBreak":true},{"text":"¡Israel-yargi neg-bogidikid nai be imaksun!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}