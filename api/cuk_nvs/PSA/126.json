{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"heading","content":["Neg-nugunonikidba weligwaled nagunonikid"]},{"type":"hebrew_subtitle","content":["We-namaked, Jerusalénʼse-nakwe-nadapir, namakleged."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová dule-galesbukwamalad Sión-yarse gannar senonigusgua,","poem":1},{"text":"anmar gabdakmaiye bismalanad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Anmar nue-alledii gusmalad.","poem":1},{"text":"Anmar weligwaledba onamakde gusmarbalid.","poem":2},{"text":"Dule-Bab-wissurmaladi sunmakdemalad:","poem":1},{"text":"“Bab-Jehová we-dulemarga ibmar-dummagan-nuegan imaksaye.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Napiragwa, Bab-Jehová anmarga ibmar-dummagan-nuegan imaksad,","poem":1},{"text":"agala, anmar weligwar itoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Emisgine, Bab-Jehová, anmar-dulemar-galesbukwad gannar be sedage.","poem":1},{"text":"Igi be nega-dulesulidganba yar-Neguevʼye-nugad-e-dianmar gannar-dii-nikuega be imakdae,","poem":2},{"lineBreak":true},{"text":"deyobi, be anmar-dulemar-galesbukwad, gannar be sedage.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dule boed-abalagi ibmar-gwag-digedi,","poem":1},{"text":"weligwaledgi e-sanmardi weed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ibmar-gwag-digegala, boed-abalagi alamaknai-damalad,","poem":1},{"text":"ibmar-sanmar-wesmalale, weligwaledba namakdaniki damalad.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}