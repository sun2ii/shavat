{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"heading","content":["Bab-Jehováʼgi ibmar-nasguleged danikid"]},{"type":"hebrew_subtitle","content":["Jerusalénʼse-nakwe-nadapir-namaklegega, Salomón, we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Ar Bab-Jehová neg-sobsulile, binsarsunna neg-sobmalad arbananaid.","poem":1},{"text":"Ar Bab-Jehová neggweburgi nakulesulile, binsarsunna neggweburgi-nakulemalad nakulebukmalad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bemar mas-gunnega binsarsunna arbaed-dummad-imakega,","poem":1},{"text":"bolegoedba gwisgumalad, mutiksaila be gabmalad.","poem":2},{"text":"Ar Bab-Jehová, e-dule-sabeddi","poem":1},{"text":"bukib-binsasuli nue-gabdii imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Anmar mimmigan-nikadi, Bab-Jehová anmarga uksad,","poem":1},{"text":"Bab-Jehová anmargi doggus-nued-binsaedbali, mimmigan anmarga gwalulemaid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Igi-dule bila-onogedgi sigu-bukidar-ganikile, dobsuli-itoge,","poem":1},{"text":"debayobi, sapingwagwadgi dule mimmigan-bukidar-nikale, dobsuli gued.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dule, mimmigan-bukidar-nikale, we-dulegi, nued binsalesad.","poem":1},{"text":"We-dule, dulemar-abargi na e-isdarmaladbo abin-abin-imakalile, e-isdarmalad-abin suli-suli itogosulid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}