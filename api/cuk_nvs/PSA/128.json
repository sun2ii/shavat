{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":128,"content":[{"type":"heading","content":["Bab-Jehová-dobee-nanadimaladgi nued-binsalesad"]},{"type":"hebrew_subtitle","content":["We-namaked, Jerusalénʼse-nakwe-nadapir, namakleged."]},{"type":"verse","number":1,"content":[{"text":"Dule-Bab-Jehová-dobee-nanadimalad, we-dulegi nued binsalesad.","poem":1},{"text":"Bab-Dummad-igarba-nanadimalad, we-dulegi nued binsalesad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Be-arbadiidgi na be mas gunnoed,","poem":1},{"text":"dule-weligwaledga be guoed,","poem":2},{"lineBreak":true},{"text":"nueganbi bega igarmar naoed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Be-neguyagi, be-ome, uva-dub-san-nikuedyobi guoed.","poem":1},{"text":"Olivo-sapi-e-muugan, e-saila-ebilideyobi, be-mimmigan be-mese-ebilidmogoed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Weyob, dule-Bab-Jehová-dobee-nanadiidgi","poem":1},{"text":"ise-nued binsalegoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová, Sión-yar-akale, begi ise-nued-binsasun.","poem":1},{"text":"Be dula-gudiidgi, bane-bane Jerusalén-nasgumaid-dakdii be gusun.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Be-wagan-dakedse be dula-gudii gusun.","poem":1},{"lineBreak":true},{"text":"¡Israel-yargi neg-bogidikid nagusun!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}