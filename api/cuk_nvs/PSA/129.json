{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"heading","content":["Bab-Dummadse egised, Sión-isdarmalad obeloye"]},{"type":"hebrew_subtitle","content":["We-namaked, Jerusalénʼse-nakwe-nadapir, namakleged."]},{"type":"verse","number":1,"content":[{"text":"Sapingwagwad-akar, nue-an-wiodimalad,","poem":1},{"text":"degi-inigwele, gwen an-oakalossurgusmalad.","poem":2},{"lineBreak":true},{"text":"Israel-dulemar weyob be sogmarmosun.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sapingwagwad-akar, nue an-wiodimalad,","poem":1},{"text":"degi-inigwele, gwen an-oakalossurgusmalad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"An-isdarmalad yargangi an-bibyosmalad, yargangi an-naibi-imaksamalad.","poem":1},{"text":"Igi dule napa-akwie, debayobi, an-naibi-imaksad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ar Bab-Jehováʼdi ibmar-napiragwad imaksoggu,","poem":1},{"text":"an-isdarmaladse-wilediidgi an-onosad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bela Sión-yar-isdar-dakmalad, sabsur-mesagwar-gusadba","poem":1},{"text":"gannar sorsik be oduurmake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wemala, uas-birgi gagan-ainiedyobi gumalad.","poem":1},{"text":"Ainidagogu, baisursunna dingued.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dule-ibmar-gwag-wemalad we-gagan sikosurmalad,","poem":1},{"text":"weosurmarbalid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dulemar ibmar-gwag-wenanaid begi nasmalogu, bega sogosurmalad: “Bab-Jehová begi nued-binsaena gadin.”","poem":1},{"text":"Ega be sogosurmarmogad: “Bab-Jehová begi nued-binsamogana gadin.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}