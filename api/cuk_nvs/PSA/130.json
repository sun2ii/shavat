{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"heading","content":["Bab-Jehová Israel-dulemar-bendaknonikoed"]},{"type":"hebrew_subtitle","content":["We-namaked, Jerusalénʼse-nakwe-nadapir, namakleged."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼye, an bese wilesagwar goled.","poem":1},{"text":"Ulubgi nunmaked-dummad-itonaidgi an bese goled.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehováʼye, be an-itoge,","poem":1},{"text":"an-sabsuli-gornaid wis be itoge,","poem":2},{"lineBreak":true},{"text":"ise-wilesagwar an bese gornaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová, be dule-e-isguedgi atakdele,","poem":1},{"text":"¿doa be-asabin sogosunna, an isgudisurye?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ar bedi isgussuliyob dule-daknonidaed,","poem":1},{"text":"degisoggu, dobekwaa be-asabinni nanamalargebed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová an-bendakega an edarbed,","poem":1},{"text":"an-gwagegi an Bab-Jehová edarbed.","poem":2},{"lineBreak":true},{"text":"Bab-Jehová-ibmar-imakoye-sogsadgi an bensulid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"An Bab-Jehová edarbed.","poem":1},{"text":"Igi dule-mutik-nakuleged neg-ibgued-edarbesidae,","poem":2},{"lineBreak":true},{"text":"aba bur bule an Bab-Jehová edarbed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Deyobi, Israel-dulemar,","poem":1},{"text":"Bab-Jehová be edarbemala.","poem":2},{"lineBreak":true},{"text":"Ar bela-bela Bab-Jehová anmar-sabgumaid,","poem":1},{"text":"bela isguedgi emar-ollor-imakbalid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Dummad-sunnagwad isguedgi","poem":1},{"text":"Israel-dulemar-ollor-imaknonikoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}