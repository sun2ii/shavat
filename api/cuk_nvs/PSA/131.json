{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":131,"content":[{"type":"heading","content":["Burwiganayob Bab-Dummadgi bensulid"]},{"type":"hebrew_subtitle","content":["We-namaked, Jerusalénʼse-nakwe-nadapir, namakleged. David we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová, andi na san-dummarba imaksulid,","poem":1},{"text":"andi, dulemar-ibgwensur daksurbalid,","poem":2},{"text":"andi, nug-dummarba imakdisulid,","poem":1},{"text":"andi, ibmar-gegerdaklemalad-dummagan imakdisurbalid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Andi bur, igi goe mam-nusale e-nan-nukugi-bogidik megisdae,","poem":1},{"text":"debayobi, an bogidik megisad, an yakirgus-megisad.","poem":2},{"lineBreak":true},{"text":"¡Andi goe-mam-nusar-bogidik-megisdaedyob gued!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Israel-dulemar, Bab-Jehováʼgi emi-ibad-akale, degisadegu bensuli be gumala.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}