{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":132,"content":[{"type":"heading","content":["Bab-Dummad Davidʼga ibmar-imakoye sogsad"]},{"type":"hebrew_subtitle","content":["We-namaked, Jerusalénʼse-nakwe-nadapir, namakleged."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová, David be ebinsao,","poem":1},{"text":"e-bukib-binsaedba-wile-itoged bela be ebinsao.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová, David bega-ibmar-ise-sogar-imaksad be ebinsae,","poem":1},{"text":"Jacob-e-Bab-Dummad-Bur-Birigined bega ibmar-imakoye-sogsad be ebinsae,","poem":2},{"lineBreak":true},{"text":"deun, David weyob sogsad:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“An-negse an nag-obiosulid,","poem":1},{"text":"bipisaale an gasgi obunnogosulid,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"gabemai an saosulid,","poem":1},{"text":"wis-ibya-muruu an imakosulid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Jehováʼga-neg-amiedse, an deyob guoed.","poem":1},{"text":"Jacob-wagan-e-Bab-Dummadga-neg-amiedse, an deyob guoed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Anmar Efrata-neggweburgi-gudigu, Bab-Dummad-Dulemarbo-Igar-Mesisad-Ulugi dulemar-sunmake an itosmalad.","poem":1},{"text":"Geb anmar Quiriat-Yearimʼgi Ulu-amismalad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Geb anmar sogdemalad: “Anmar Babse-goled-negse namar,","poem":1},{"text":"e-asabin sindigale anmar signamar.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová, be-obunnoged-negse be dage,","poem":1},{"text":"be-Ulu-gandikidmala be asega dage.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Be-dule-irwa-bese-gormalad, e-mor-yomalayobi, igar-innikigwad imakmar.","poem":1},{"text":"Bega-innikigwadba-nanadimalad, weligwaledba namakmar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Be, be-mai-David-sabedbali,","poem":1},{"text":"be-nuggi-nugsalegaled, melle wagar-biriar be dako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bab-Jehová Davidʼga ibmar-ise-sogar-sogsa-gusadi, bar osulogosulid.","poem":1},{"text":"Weyob ega sogsad: “Be-wagan-gwensak beyob reyga an omesoye.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"An bemarbo-igar-mesisad-sogedba be-wagan nanaele, an-igar-mamaidgi-an-e-odurdakoedba nanaele,","poem":1},{"text":"e-mimmigan reyga degibi megmarmogoed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ar Bab-Jehová, Sión-yala-nug-imaksad,","poem":1},{"text":"egi-megega abesad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Weyob sogsad: “We, an-obunnoged-negga degisadegu gudii guoed.","poem":1},{"text":"Wegi an-ologana an sioed, ar an deyob abeged.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"E-mas gatik-obinebaka-merguega an imakoed,","poem":1},{"text":"e-dule-wilegana masgi an oimmogoed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Amba deyob, e-dule-irwa-Bab-Dummadse-gormaladga bendakleged-mola an ega yooed,","poem":1},{"text":"e-dule-nuegan, weligwaledba namakmaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"”Wegine, David-e-gangued-gannar-nikuega an imakoed.","poem":1},{"text":"An-nuggi-nugsalegaled gwallu-meegwadyob negsemai-guega an imakoed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"E-isdarmalad, binged-dummad-nikuega an imakoed.","poem":1},{"text":"Davidʼdina e-ologurgin-dakarmakaled yooed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}