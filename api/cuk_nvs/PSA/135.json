{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":135,"content":[{"type":"heading","content":["Bab-Dummad-e-ibmar-dummagan-imaksad"]},{"type":"verse","number":1,"content":[{"text":"¡Aleluya! ¡Bab-Jehová-nug odummolesun!","poem":1},{"lineBreak":true},{"text":"¡Bab-Jehová-e-nug odummomala!","poem":1},{"text":"Bab-Jehová-e-maimar, Bab-Jehová-nug odummomala.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová-e-neggi-gudidimalad, ¡Bab-Jehová-e-nug odummomala!","poem":1},{"text":"Anmar-Bab-Dummad-neg-imbagi-gudidimalad, Bab-Jehová-nug odummomala.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová-nug odummomala,","poem":1},{"text":"ar Bab-Jehováʼdi, dule-nuedid.","poem":2},{"text":"E-nuggi-namaklegedgi namakmala,","poem":1},{"text":"ar Bab-Jehováʼdi nued-binsaedgi dulemar-bendakedid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ar Bab-Jehová Jacob-wagan-egadga-guega susad.","poem":1},{"text":"Israel-dulemar na egadga imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nue an wisid, Bab-Jehová, dule-dummadid.","poem":1},{"text":"Ibmar-bab-dummadyob-imaklemaladba anmar-Bab-Dummad bur bule dule-dummadid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Jehová bela nibneggi, napneggi, muu-billigangi, degi, muu-billigan-wila-dummagangi","poem":1},{"text":"e-ibmar-abeged imaked.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová neg-oagnakwiardaed,","poem":1},{"text":"dii-owiegala mar-odakarmakardaed,","poem":2},{"lineBreak":true},{"text":"burwa e-galugi-bukwadgi barmiardaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bab-Dummad Egipto-dulemar-e-machi-sailaginmalad oburgwisadid.","poem":1},{"text":"Dulemarse-bakale, ibmar-durganse-bakale, oburgwisadid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Egipto-dulemar, Bab-Dummad be-abargi Faraónʼga, bela e-maimarga oyosad,","poem":1},{"text":"ibmar-wilubgan-dummagan, ibmar-dakledisurmalad oyosad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Jehová dulemar-yar-baid-baidgi-bukwad bukidar obelosad.","poem":1},{"text":"We-reymar-gandik-mamaid-oburgwisbalid:","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amorreo-e-rey-Sehónʼye-nugad,","poem":1},{"text":"Basán-e-rey-Ogʼye-nugad,","poem":2},{"lineBreak":true},{"text":"bela reymar-Canaán-yargi-mamaid obelosad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bab-Dummad we-reymar-e-yarmar mimisad,","poem":1},{"text":"e-Israel-dulamarga mimisad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bab-Jehová, be-nug degisadeguad.","poem":1},{"text":"Bab-Jehová, dulemar degisadegu be-ebinsadii gumaloed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bab-Jehová na e-dulamarga igar nabogoed,","poem":1},{"text":"e-maimar-wiledakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dulemar-yar-baid-baidgi-bukwamalad na e-bab-dummadyob-ibmar-imakbukwadi, orgi sobaled, manigi sobaled.","poem":1},{"text":"Dulemar na e-argangi sobsa nanaed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"We-ibmarmar gaya-nikamalanad,","poem":1},{"text":"degite, geg sunmakmalad.","poem":2},{"text":"Ibya-nikamalanad,","poem":1},{"text":"degite, ibmar-daksurmalad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Uaya-nikamalanad,","poem":1},{"text":"degite, ibmar-itosurmalad,","poem":2},{"lineBreak":true},{"text":"deginbali, bunnosurmarbalid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"E-sobmalad, deyob gumarmogad,","poem":1},{"text":"bela a-ibmargi-bengusurmalad deyob gumarmogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Israel-dulemar, ¡Bab-Jehová-nug odummomala!","poem":1},{"text":"Aarón-wagan, ¡Bab-Jehová-nug odummomala!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Leví-wagan, ¡Bab-Jehová-nug odummomala!","poem":1},{"text":"Bab-Jehová-dobee-nanadimalad, ¡Bab-Jehová-nug odummomala!","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Sión-akale, Bab-Jehová-nug odummomala.","poem":1},{"text":"Bab-Jehová, Jerusalénʼgi maid.","poem":2},{"lineBreak":true},{"text":"¡Aleluya! ¡Bab-Jehová-nug odummolesun!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}