{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"heading","content":["Babilonia-diwar-naba bobukdamalad"]},{"type":"verse","number":1,"content":[{"text":"Babilonia-diwar-naba anmar ambakudapdaed.","poem":1},{"text":"Agi, anmar Siónʼgi-binsabukwadba, bobukwadaed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Anmar, anmar-gar-arpa sapi-Sauceʼye-nugadgi,","poem":1},{"text":"an nasikdamalad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dule-anmar-gasa-sesmaladi, anmarga sokardaed, namakmarye.","poem":1},{"text":"Dule-anmar-ibe-ibmar-susmaladi, anmarga sokardaed, anmarde wergumarye.","poem":2},{"text":"Anmarga sokardaed:","poem":1},{"text":"“Be-Sión-yargi-namaklemaladi, be anmarga namakye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"¿Wede igi anmar yar-baidgi Bab-Jehováʼga namakosunna?","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Jerusalén-neggwebur, an be-iedele, an argan mer bar gar-ogolega gusun.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Jerusalén-neggwebur, an be-iedele, an-wergudiidba bar begi an binsasulile,","poem":1},{"text":"geg bar namake an gusun.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová, Babilonia-dulemar Jerusalénʼgi-nakwisgu, Edom-dulemar-sognanai-gusad, be insao:","poem":1},{"text":"“¡Jerusalén-neggwebur bela be obelomarye!","poem":2},{"lineBreak":true},{"text":"¡Swanga be nasikmarye!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Babilonia-neggwebur, ibagwengi be bibisgelemogoed.","poem":1},{"text":"Bemar anmar-imaksayob be imaklemarmogoed.","poem":2},{"lineBreak":true},{"text":"Dule-deyob-bemar-imakoedi, egi nued binsalegoed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dule be-mimmigan-gani akwagi-sabsur-omukuoed.","poem":1},{"text":"Dule-deyob-be-mimmigan-imakoedi, egi nued binsalegoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}