{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"heading","content":["Bab-Jehová-egi-nued-binsasadba dog-nuedye-soged"]},{"type":"hebrew_subtitle","content":["David namakleged narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová bela-bela an-ulubgi an be-nug odummoged.","poem":1},{"text":"Baliwiturmar-asabin an bega namakoed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bese-gorleged-neg-islidikid-siidsiki an dulluu napagi sigoed.","poem":1},{"text":"Be-sabed-dummarba-maidbali, sogedba be ibmar-imakmaidbali, an be-nug odummogoed.","poem":2},{"text":"Bab-Dummad, be ibmar-imakoye-sogsad, bela ibmar-birgi, sogedba be imaksad.","poem":1},{"text":"Degidba be-nug na be ogannosad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Dummad, an bese gochagua, be an-abin-imaksad,","poem":1},{"text":"be an-niga ogannononikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová, bela-reymar-we-napneggi-mamaid, bela be-sunmaked-itomaloedba,","poem":1},{"text":"be-nug odummodmaloed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová-Igar-Mamaidgi namakdemaloed.","poem":1},{"text":"Ar Bab-Jehová-e-gargangued dummarba gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bab-Jehová, dule-biriginedid.","poem":1},{"text":"Bab-Dummad, dule-na-san-dummarba-imaksulidgi, nued binsaed.","poem":2},{"lineBreak":true},{"text":"Bab-Dummad, dule-na-san-dummarba-imakdiiddina, obaned.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Amba an bonigan-abalagi-gudidibe,","poem":1},{"text":"amba dula-gudii be an-imakoed.","poem":2},{"text":"Bab-Jehová, an-isdarmalad-urwedgi, be an-bendakoed.","poem":1},{"text":"Be-ganguedba be an-bendakoed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová, angine bela ibmar-imakoye-sogsad imakedsegad.","poem":1},{"text":"Bab-Jehová, be-sabgued gege gwaged, degisadeguad.","poem":2},{"text":"Bab-Dummad, be an-obinnissoggu,","poem":1},{"text":"mer wargwen be an-meto.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}