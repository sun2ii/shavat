{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":139,"content":[{"type":"heading","content":["Bab-Dummad bela-neg-ugakaase-gudiid"]},{"type":"hebrew_subtitle","content":["Namakmalad-e-iduedga narmaklesad. David we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová, be an-baramied.","poem":1},{"text":"An-gudiid bela be wisid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sana an sigoe, sana an gwisguoe,","poem":1},{"text":"be nue-wisimakaled.","poem":2},{"text":"An begi dikasur-gudi-inigwele,","poem":1},{"text":"bedi an-binsaed nue-wisimakaled.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"An-nanaed, an-obunnoged, be nue-wisimakaled,","poem":1},{"text":"bela an-igarmar be nue-wisid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová, ar amba yoo an ibmar-soge,","poem":1},{"text":"bato bedi bela wisdaed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bela-belad be an-irwa gwisgudiguad.","poem":1},{"text":"Be-argan-yaurgi be an-sediid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Weyob be ibmar-wisidi, an bela-bela geger-itoged,","poem":1},{"text":"¡Bela-bela be ibmar-wisidi, an aku-itoged!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bab-Dummad, ¿Ar bia be-Burbagi an banguoe?","poem":1},{"text":"¿An bia begi wakinnoe?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ar an nibnegse naele, bedi agi maid.","poem":1},{"text":"Ar an burgwarmalad-meged-galuse an naele, bedi agi gudibalid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ar an dad-nakwedsik naeyesogele,","poem":1},{"text":"ar an magatiba naeyesogele,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"amba be agine an-idu gudiid,","poem":1},{"text":"be-ganguedgi be an-sedii guoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"An sogdibe: Negsichid an-odukuoye,","poem":1},{"text":"neg-meegwad anga neg-mutikidga guoye, an binsa-sogsaled.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ar begardi negasichid negsichidga gusulid,","poem":1},{"text":"begardi neg-mutikid neg-ibginedyob gued.","poem":2},{"text":"Begardi negasichidi, neg-meegwadi, emarbi gued.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bab-Dummad, bee be bela an-abagangi-ibmar-bukwad obinnisad.","poem":1},{"text":"Bee be, sapidukugi an-mesisad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Doggus-nuedye an bega soged,","poem":1},{"text":"be-ibmar-obinnisadi, andi geger-daked.","poem":2},{"text":"Be ibmarmar-imaksadi, geger-dakleged,","poem":1},{"text":"ar we-ibmar an nue-wisid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ise-dukuale, an-abagangi arbalenaigu, an-garmardi begi odukulessulid.","poem":1},{"text":"Ise-dukuale, an sapidukugi-mai angi-arbalenaigu, anga abgan-dubagan gwadilenai gusad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"An sapidukugi-maigua, bedi an-daksad.","poem":1},{"text":"Amba yoo an we-napnegse aidedage,","poem":2},{"text":"birgabigwa an dula-gudii guoe,","poem":1},{"text":"bela bato be-gardagi narmakar maid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bab-Dummad, be-binsaed ibiyobi anga doggus-nued gue.","poem":1},{"text":"¡Be-binsaedi, ibiyobi mergue!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ar be-binsaed an ebisye-sogele, bur bule ukubba mergueled.","poem":1},{"text":"Ar an be-binsaed-ebised an obelo-sogele, amba be an-walik gudiiled.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Bab-Dummad, dule-isganamar be oburgwe.","poem":1},{"text":"Dule-ablis-eomalad, angi be obangue.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wemar-begi-dodoar-sunmakdimaladi,","poem":1},{"text":"binsarsunna begi gwisgumalad.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bab-Dummad, dulemar-isdar-be-daked,","poem":1},{"text":"¿an isdar-daksurmo be insae?","poem":2},{"text":"Dulemar-be-abingasulid,","poem":1},{"text":"¿an sae-daksurmo be insae?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"An bela-bela isdar-daked,","poem":1},{"text":"an-isdarmaladga gunonimalad.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bab-Dummad, be an-baramie,","poem":1},{"text":"an-gwage-ulub be dake,","poem":2},{"text":"be an-wilubdake,","poem":1},{"text":"be an-binsaed dake.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"An igar-isganaba nadapi be an-dakele,","poem":1},{"text":"geg-igar-berguedba be an-sede.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}