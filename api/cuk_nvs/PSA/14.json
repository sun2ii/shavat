{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"heading","content":["Dule-isganamar Bab-Dummad-obaned"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad. Namakmalad-e-iduedga soglenaid."]},{"type":"verse","number":1,"content":[{"text":"Dule-binsaedsulidaed, weyob e-gwagegi sogdiid:","poem":1},{"text":"“Bab-Dummad maisulid.”","poem":2},{"text":"Dulemar nue-isgus gudimalad, unnila ibmar-isganabi imakdimalad.","poem":1},{"text":"Dule-wargwensaale, ibmar-nued-imaked gudisulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová nibneg-akale, dulemar-napneggi-gudimalad dakmaid,","poem":1},{"text":"abakale, dule-gwensak magar-neg-itoged gudiile,","poem":2},{"lineBreak":true},{"text":"abakale, dule-gwensak magar-Bab-Dummad-dakbied gudiile.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Degi-inigwele, dulemar Bab-Dummadgi bela bangus gudimalad,","poem":1},{"text":"dule ibmar-nued-imaked gwen wargwensaale, gudisulid,","poem":2},{"lineBreak":true},{"text":"bela nue isgus gudimalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"¿Ar dule-isganamar na ibmar-isgana-imakdimalad, nue wismalansursi?","poem":1},{"text":"Ar nue wismalanad.","poem":2},{"text":"Emide, igi dulemar madu-gunmala, deyob an-dulemar ese dolediid.","poem":1},{"text":"We-dule-isganamar, gwen bipisaagwar Bab-Jehováʼse gordisurmarbalid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Emisgindi, be dakmalana, emide, wawanmakbukwad.","poem":1},{"text":"Ar Bab-Dummaddi dule-innikidamaladba gudisoggu, dule-isganamardi, dobgubukwad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dule-isganamar dule-wilemalad-e-igar obured,","poem":1},{"text":"degi-inigwele, dule-wilemaladdi Bab-Jehováʼgi bendaklegoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bitigi Bab-Jehová, Israel-dulemarga abonoleged-igar, Sión-yala-akale, barmialina gadin.","poem":1},{"text":"Bab-Jehová na e-dulamar-galesbukwad,","poem":2},{"text":"gannar na e-yarse-senonikile, Jacob-e-wagan wergudmaloed,","poem":1},{"text":"Israel-dulemar weligwar itodmaloed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}