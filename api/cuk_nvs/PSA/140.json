{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":140,"content":[{"type":"heading","content":["An-bendakye, Bab-Dummadse-goled"]},{"type":"hebrew_subtitle","content":["David namakmalad-e-iduedga namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová, dule-isganamargi be an-ollor-imake.","poem":1},{"text":"Sabesur-dule-imakmalad-idu be an-odukue.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ar unnila e-gwagegi, ibmar-isgana-imakedginbi binsadii daed.","poem":1},{"text":"Bane-bane urwed-onodii daed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Naibe-nued-gangueyobi, e-gwabin-duku gued.","poem":1},{"text":"Naibe-nued-e-gichi-boniyobi, e-sunmaked sedimalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová, dule-isganamar-e-gangued-idu be an-odukue.","poem":1},{"text":"Sabesur-dule-imakmaladgi be an-ollor-imake,","poem":2},{"lineBreak":true},{"text":"ar an-ogalakuedgi binsadidamalad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dule-san-dummarba-imakmalad, an-yardakmalaga, an-idu dub nasiksamalad.","poem":1},{"text":"An-idu igargi saki nasiksamalad.","poem":2},{"lineBreak":true},{"text":"An-nanaedgi an-idu yardakleged-galu osismalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"An Bab-Jehováʼga sogsad: “Be an-Bab-Dummadid.","poem":1},{"text":"Bab-Jehová, wilesakwaa an bese-goledi be an-itoge.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová-Dule-Dummad, be an-Bab-Dummad-bur-gandikidid.","poem":1},{"text":"Bila-onolegedgi be an-bendakedid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová, dule-isganamar e-ibmar-imakbiedi, melle imakega be imake.","poem":1},{"text":"Melle na san-dummarba-itomalaga be imake,","poem":2},{"lineBreak":true},{"text":"melle e-igarmar-nasgumai be imake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bab-Dummad, dule-an-balegindimalad, an-wiogega-igar-isgana-amismalad","poem":1},{"text":"egi dukin-aibinega be imake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wemargine, sogun-ginnitibiid babatega be imaksun.","poem":1},{"text":"Soo-yagine balimelledega be imaksun.","poem":2},{"lineBreak":true},{"text":"Melle bar noega yaa-matusulidgi-argwanega be imaksun.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dule-geg-gwabin-duku-bargaed, napneggi gudigu guosulid.","poem":1},{"text":"Sabsur-dule-imakmalad, boni-dummaganse obelolesun.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"An wisid, Bab-Jehová, dule-wile-itodiidga igar naboged,","poem":1},{"text":"dule-ibmarbina-sogdimalad, Bab-Dummad bendaked.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dule-nuegan, be-nug-odummomaloed.","poem":1},{"text":"Dule-innikimalad be-walik-gudii gumaloed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}