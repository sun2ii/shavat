{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":141,"content":[{"type":"heading","content":["Bab-Dummadse-goled ibmar-isganagi be an-onoye"]},{"type":"hebrew_subtitle","content":["David, we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová, sabsuli an bese goled: ¡Gwae be an-bendakdage!","poem":1},{"text":"An bese gotele, be an-itoge.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"An-bese-goledi, ina-wawadikid-nakwemaidaeyob bese nakwemai gusun.","poem":1},{"text":"An-argan-bese-onakwedi, sedo-ibmar-ogumakar-ukledaeyob be dake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová an-gwabinduku-bargaed be an-imake.","poem":1},{"text":"Bab-Jehová, mer ibmar-yogasaar-sunmaked be an-imake.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Melle an-gwage ibmar-isganagi-binsaega be imake,","poem":1},{"text":"dulemar-ibmar-isgana-imakbiedba melle akaed be an-imake.","poem":2},{"text":"Dulemar-ibmar-isgana-imaked-abargi,","poem":1},{"text":"melle ibagi-masgulleged-gunnega be an-imake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dule-ibmar-innikii-imaked an-bibyoye-sogele, sabsur ibmar anga sogele,","poem":1},{"text":"we, ibmar-nued anga imaknaid.","poem":2},{"text":"Dulemar-isgana-e-gwallu-wawamar, an-nonogi, mer eolegega be imako.","poem":1},{"text":"Bab-Dummad, mer an dule-isgana-e-ibmar-isgana-imakedgi-yolegega, an bese gornai guoed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"E-dummagan-negsemamaid akwasaila-birgi-gwichi gulluse barmelledmalale, agi geb itomaloed,","poem":1},{"text":"an-ibmar-sogsadi, napiragwad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Geb sogdemaloed:","poem":1},{"text":"Anmar-garmar, napa-imules-argaarmaiyobi, anmar-garmar neg-uangi omiledoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová-Dule-Dummad, bebi an-bendakedid.","poem":1},{"text":"Bendakleged beginbi an amied.","poem":2},{"lineBreak":true},{"text":"¡Melle dulemar an-oburgwed be imako!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dulemar an-idu dub-nasiksamaladgi mer aimukued be an-imako.","poem":1},{"text":"Dule-isganamar yamo dule-yardakega-ibmar-imakmaladgi, melle yardakleged be an-imako.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dule-isganamar na dukin e-sakigi-argwaned be imake.","poem":1},{"text":"Bab-Dummadye, be an-bendake.","poem":2},{"lineBreak":true},{"text":"Mer ese galegega be an-imako.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}