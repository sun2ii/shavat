{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"heading","content":["David Bab-Dummadse bendakleged-egisnaid"]},{"type":"hebrew_subtitle","content":["David we-namaked-Masquilʼye-nugad narmaksad. David akwasailayaba-dukusigu, Bab-Dummadse gornai gusad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼse ise-gollar bendakleged an egised,","poem":1},{"text":"Bab-Jehováʼse ise-wilegar an e-sabgued egisnaid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Dummadga naibi-itodiid, an sogoed,","poem":1},{"text":"an-sulibinsa-itodiid, an ega sogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bab-Dummad, an geggus-itogele, bato be an-daksabinnedaed.","poem":1},{"text":"An bia nadele, abala dulemar an-yardakega, an-iduar ibmar-sisadamalad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"An-argan-nuedsik an atakdele, dule-an-bendaked wargwensaale gwen daklesurdaed.","poem":1},{"text":"Neg-dukued an sulid,","poem":2},{"lineBreak":true},{"text":"dule-wargwensaale angi binsasulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová, be-an-bendakegala, an bese gochad.","poem":1},{"text":"An bega sogsad: “Bebi unnila an-bendaked maid.","poem":2},{"lineBreak":true},{"text":"We-napneggi dulemar-bukwad-abargi bebi unnila anga gudiid.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Dummadye, an-gornaid be itoge,","poem":1},{"text":"an sulibinsa itoged.","poem":2},{"text":"An-bareginnanamaladgi be an-bendake,","poem":1},{"text":"ar anba bur bule gangumalad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"An be-nug-odummogega, wegi-an-galessiidgi be an-onodage.","poem":1},{"text":"Ar be-sabed be anga oyononikile, dule-inniki-gudimalad weligwar an-ebiris ambikunonimaloed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}