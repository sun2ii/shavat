{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":143,"content":[{"type":"heading","content":["E-bendakega, degi, e-iduega Babse-goled"]},{"type":"hebrew_subtitle","content":["David, we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼye, an bese-goled be itoge,","poem":1},{"text":"an-wilesakwaa-goled, be itoge.","poem":2},{"text":"Be-ibmar-soged-imakedba, be an-abinsae.","poem":1},{"text":"Be-Igar-innikigwadba, be an-abinsae.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dummad, mer be anga igar-itoge.","poem":1},{"text":"Ar be-asabindi, dule-wargwensaale na nuedye sogosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"An-isdarmalad an-oburgwebied,","poem":1},{"text":"napayala bikiin an-metemalad.","poem":2},{"text":"Dule-dikasurgus-burgwismaladyob","poem":1},{"text":"negasichidgi-megega an-imaksamalad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bar an nue-bunnosurgusad,","poem":1},{"text":"an-gwage bogiled an-itoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Epenne ibagan-nasmalad an ebinsaded.","poem":1},{"text":"Belagwable be-ibmar-dummagan-imaksadgi an binsaded.","poem":2},{"lineBreak":true},{"text":"Be-ibmarmar-imaksad, nue an ebinsaded.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"An-argan an besik oyoged,","poem":1},{"text":"ar igi napa-dinnagwad dii-abedae,","poem":2},{"lineBreak":true},{"text":"deyobi, an bebina soged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová, gwae be an-abinsae,","poem":1},{"text":"ar an geg-sagusad.","poem":2},{"text":"Be-wagar mer be angi odukue,","poem":1},{"text":"ar degiile, dule-napa-yaba-digarmaidyobi, an guoed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wakudaryalaba be-sabgued be anga oyoge,","poem":1},{"text":"ar andi begi bensulid.","poem":2},{"text":"Ar andi bese goled,","poem":1},{"text":"be anga oyoye, ibu-igarba an naoe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Jehová, an-isdarmaladgi be an-ollorsae,","poem":1},{"text":"ar andi begi dukued amied.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Be-sogedba-ibmar-imakedgi be an-odurdake,","poem":1},{"text":"ar be an-Bab-Dummadid.","poem":2},{"lineBreak":true},{"text":"Be-Burba-nued neg-bonigan-satedba an-idue.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bab-Jehová, be-nug-ular, dula-gudii be an-imake.","poem":1},{"text":"Be-Igar-innikigwad-ular, surbinsa-itogedgi be an-onoge.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Be-dule-wiledaked-ular, an-isdarmalad be ogiloge.","poem":1},{"text":"Bela an-balengindimalad be obeloge, ar andi be-mai gued.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}