{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":144,"content":[{"type":"heading","content":["Yar-onasguye, Bab-Dummadse-goled"]},{"type":"hebrew_subtitle","content":["David, we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová-nug odummolesun,","poem":1},{"text":"an-akwasailaga guedid.","poem":2},{"text":"Bila-onoged-idu, an-surgan-ogannogedid,","poem":1},{"text":"urwed-idu, an-arganmar-ogannogedid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová, an-sabguedid, an-edarbedid,","poem":1},{"text":"bonigan-idu an-odukuedid,","poem":2},{"text":"bonigangi an-ollor-imakedid,","poem":1},{"text":"an-sigu-abgaedyob an egi dukuedid,","poem":2},{"text":"an egi bensulid-nikadid,","poem":1},{"text":"an-urbaligwa-nanaega dulamar-imakedid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová, ¿wede, dule ibusunna, egi be binsanonigu?","poem":1},{"text":"¿Wede, dule ibusunna, be akwenonigu?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ar dule unnila gayagi buu-imaklegaledid.","poem":1},{"text":"Ar e-ibagan unnila negsichigwad-ukiar-nasdaeyobid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová, be-mogir be egae, be aidedage.","poem":1},{"text":"Yalamar be ebuge, waa-obupurmake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mala-ibyemakale be odege,","poem":1},{"text":"dule-isdardakmalad be oaisakie,","poem":2},{"text":"be-sigumala egi be mie,","poem":1},{"text":"dule-isdarmalad-oduurmakega be imake.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nibneg-akale, be-gangued be anse oyoge,","poem":1},{"text":"dii-wiladgine be an-onoge,","poem":2},{"lineBreak":true},{"text":"dule-isganamargi be an-ollor-imake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ar sunmakdemalale, gakansaddamalad,","poem":1},{"text":"argan-onakwidmalale, nabiridyob ibmar-ise-sogar imakdamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bab-Dummad, na begala namaked-gwapidgi an namakoed.","poem":1},{"text":"Gar-arpa-dub-giambe-nikadba (10) an bega namakoed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bila-onolegedgi be reymar-onakwemaidid.","poem":1},{"text":"Be-mai-David-melle-es-suidgi-burgwega be imakedid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Be an-bendake,","poem":1},{"text":"dule-isganamargi be an-ollorsae.","poem":2},{"text":"Ar sunmakdemalale, gakansaddamalad,","poem":1},{"text":"argan-onakwidmalale, nabiridyob ibmar-ise-sogar imakdamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Anmar-mimmigan, e-dungumaidba sapimar-binnasuli-dungumaiyob be imako.","poem":1},{"text":"Anmar-bunamala, reyneg-e-buarmar-sobarmaladyob, yeerdaklege be imako.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Anmar-ibmar-gwag-sabomaladgi bukidar masmar-akar-akar ena-ena bukuega be imake.","poem":1},{"text":"Anmar-sibad-wawaadmar, mili-miliba-omelomai (1,000-1,000) be imake.","poem":2},{"lineBreak":true},{"text":"Anmar-nainugi, mili-miliba-bukuega be imake.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Anmar-moli-bebe-nikad-omegan, obargudiguega be imake.","poem":1},{"text":"Mileged-ibagan-iduar, melle milegega be imako.","poem":2},{"text":"Melle anmar-neg-imbabali,","poem":1},{"text":"bar dule, suli-suli-itogedba-gordiguega be imako.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Neggwebur we-ibmarmar bela nikale, egi-nued-binsalesdo.","poem":1},{"text":"Neggwebur, Bab-Jehová e-Bab-Dummadga-imakdiile, egi-nued-binsalesdo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}