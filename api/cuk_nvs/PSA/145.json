{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":145,"content":[{"type":"heading","content":["Bela dulemar Bab-Dummad-nug-odummomar"]},{"type":"hebrew_subtitle","content":["Bab-Dummad-nug odummomar. David, we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"An-Bab-Dummad, an-Rey, be-nug an odummogoed.","poem":1},{"text":"Degisadegu, be-nuggi nued sunmakdigu an guoed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bane-bane degisadegu,","poem":1},{"text":"be-nug-odummodii an guoed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová, Dule-Dummadid.","poem":1},{"text":"E-nug nue-odummolegergebed.","poem":2},{"lineBreak":true},{"text":"E-nug-dungued dule magar itogosurguoed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Dummad, babgan be-ibmar-imaksamaladi, e-mimmiganga sogoed.","poem":1},{"text":"Be-ibmar-dummagan-imaksamaladi, e-mimmiganga sogoed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Be-ganguedgi, be-yeerdaklegedgi, an sunmakdii guoe.","poem":1},{"text":"Be-ibmar-dummagan-imaksamaladgi, an binsadii guoe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Be-ibmar-dummagan-imakedgi dulemar, sunmakmaloed,","poem":1},{"text":"be dule-dummad-guedgi, an sunmakoe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Be-sabgued-dummarba-nikadgi, sunmakmaloed,","poem":1},{"text":"be-ibmar-inniki-imakedgi, namakmaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová wile dulemar-dakdaed,","poem":1},{"text":"nue dulemar-sabdaed.","poem":2},{"text":"Bab-Jehová wissur gwae-gwae urwed,","poem":1},{"text":"nue dulemar-sabgumaid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Jehová bela dulemargi nueddaed.","poem":1},{"text":"Bela na e-ibmar-imaksad nue-sabed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bab-Jehová, bela be-ibmar-obinnisadi, be-nug odummosunna.","poem":1},{"text":"Be-sordamar-napiramalad be-nug odummomarmosunna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Be gannarba-negsemaidgi, sunmakmarsunna.","poem":1},{"text":"Be-ganguedgi sunmakmala.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Adi, dulemar be-ibmar-dummagan-imaksad wisgumalaga,","poem":1},{"text":"be-yeerdakleged, be-gangued wisgumarbaligar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Be-negsemaidi, degisadeguoed,","poem":1},{"text":"be-neg-ganikidi, berguosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Bab-Jehová dule-wis-gwatirisdibe, dule-ogwisdaed,","poem":1},{"text":"dule-nollo-itomalad ogannodaed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bab-Jehová bela ibmarmala ega be mas ukega bese atakbubuk-naed.","poem":1},{"text":"Ega be iba-sekalaa masgunned ukmaid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nalledginsuli ega be mas ukmaid.","poem":1},{"text":"Bela ibmar-dulaga mas unnitibali be ukmaid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bab-Jehová, bela-be-ibmar-imakedi, innikigwadbi imaked.","poem":1},{"text":"Bela nue-sabedgi be ibmar imaked.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bab-Jehová, dule-ese-napiragwadgi-gordimalad-bendakega","poem":1},{"text":"egi walikaa gudidaed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bab-Jehová, dule-e-sabee-gudimaladga ibmar-abemalad ukdaed.","poem":1},{"text":"Amar-ese-ibmar-egisedi ega ukdaed.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bab-Jehová, dule-e-sabgudimalad-edarbedii daed.","poem":1},{"text":"Ar dule-isganadi bela obelogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Bab-Jehová, an be-nugdi ogannosunna.","poem":1},{"text":"Bela ibmarmar be-nug ogannomarmosunna.","poem":2},{"lineBreak":true},{"text":"Degisadegu, be-nug ogannodii gumarsunna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}