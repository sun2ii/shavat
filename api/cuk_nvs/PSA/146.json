{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"heading","content":["Bab-Dummad-Igar-inniki-nabogedga namakleged"]},{"type":"verse","number":1,"content":[{"text":"¡Aleluya! ¡Bab-Dummad-e-nug-odummomarsun!","poem":1},{"text":"Bab-Jehová, an-gwagegi an be-nug odummoged.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"An dula-gudiidgi Bab-Jehová-nug an odummogoed.","poem":1},{"text":"Bab-Dummadga-namaklegedgi an Bab-Dummadga namakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mer girmar-dummagangi be bensulid-nika guo,","poem":1},{"text":"bipisaale mer dule-gwensakgi be bensulid-nika gubalo,","poem":2},{"lineBreak":true},{"text":"ar wemargi bendakleged-igar maisulid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ar we-dulemar bergunonikile, gannar napaga binnidmaloed.","poem":1},{"text":"Bela na ibmar-imako-sogsamalad, a-ibagi berguus ega naoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dule Jacob-e-Bab-Dummadgi bendaklediile, we-dulegi nued-binsalesad.","poem":1},{"text":"E-Bab-Dummad-Jehováʼginbi bensuli gudiid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ar Bab-Dummad napneg-nasiksadid, nibneg-nasiksabalidid.","poem":1},{"text":"Demar-naidi, bela-egi-ibmar-bubukwadi urbisbalid.","poem":2},{"text":"Bab-Dummad ibmar-imakoye-sogsad,","poem":1},{"text":"sogedba imaked, gakansamaisulid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová dule-sabsur-imakledimaladga sogedba ega igar naboged.","poem":1},{"text":"Dule-ukud-itodimaladga masgunned uked.","poem":2},{"lineBreak":true},{"text":"Dule-gales-bubukwad onobalid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová dulemar-ibyasulid nabir-atakega imaked.","poem":1},{"text":"Dule-yore-nanamalad inniki-nanaega imaked.","poem":2},{"lineBreak":true},{"text":"Bab-Jehová dule-innikidamalad nue-sabed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Jehová Israel-dulesurmalad nue-akwed.","poem":1},{"text":"Dule-babgansuli-gudimalad nue-bendakbalid.","poem":2},{"text":"Ome-ei-sui-burgwisgudiid nue-bendakbalid.","poem":1},{"text":"Bab-Dummad dule-isganamarga igar obured.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Sión-dulemar, be-Bab-Jehová degisadegu, negsemai gusun.","poem":1},{"text":"¡Aleluya! ¡Bab-Dummad-nug odummomarsun!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}