{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":147,"content":[{"type":"heading","content":["Bab-Dummad-nug-odummolesun"]},{"type":"verse","number":1,"content":[{"text":"¡Aleluya! Bab-Jehová-nug odummolesun.","poem":1},{"lineBreak":true},{"text":"Ar anmar, anmar-Bab-Dummadga-namaked ibnuedid.","poem":1},{"text":"E-nug-odummoleged yeer-itolegedid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová Jerusalén-neggwebur gannar sobed,","poem":1},{"text":"Israel-dulemar-e-yargi-onolesmalad gannar senonikoed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Dummad, dule-gwage-nunmak-itodimalad nudaked.","poem":1},{"text":"E-wile-itodiid baisur-itoge imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová bela wisid igi mergu niisgwamar nai,","poem":1},{"text":"bela ega nug nasiksad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Anmar-Bab-Jehová, dule-dummadid,","poem":1},{"text":"e-gangued bipisurbalid,","poem":2},{"lineBreak":true},{"text":"e-ibmar-wisid degisadeguad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Jehová dule-wilegana bendaked.","poem":1},{"text":"Dule-isgana-e-nugdi bipii imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bab-Jehováʼga yeer-itogedgi namakmala.","poem":1},{"text":"Anmar-Bab-Dummadga gar-arpaʼba namakmala.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Dummad, nibneggi mogirmar nasiked,","poem":1},{"text":"napaneggi dii owied,","poem":2},{"lineBreak":true},{"text":"sapurgi gaganmar onied.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Dummad, ibmar-durganga mas uked.","poem":1},{"text":"Sikwisichii-mimmigan mas-abealile, ega mas ukbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bab-Jehová moli-e-ganguedgi yeer-itosulid,","poem":1},{"text":"dule-ibmar-bursur-imakedgi yeer-itosurbalid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Jehová, e-nug-odummomaladgi yeer-itoged,","poem":1},{"text":"e-sabgued-bensurmaladgi yeer-itobalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Jerusalén-neggwebur, Bab-Jehová-nug odummoge.","poem":1},{"text":"Sión-yar, be Bab-Dummad-nug odummoge.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bab-Jehová be-yawagak-bargamalad-e-suarmar bega ogannosad.","poem":1},{"text":"Dule-be-yargi-gudidimaladgi nued-binsalesad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bab-Dummad be-yargi neg-bogidikid nasiked,","poem":1},{"text":"orosgi-dakleged-trigo-bur-nuedgi immerba be-imaked.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bab-Dummad napnegga ibmar-soged,","poem":1},{"text":"e-ibmar-soged yog-imakar imakledaed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bab-Dummad ubsan-daklegedyob boo-sibudiki obated.","poem":1},{"text":"Buru-bateyob boo-gwamakaled obated.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bab-Dummad dii-gwamakaled akwanyob obated.","poem":1},{"text":"Dii-gwamakaled-e-dambed, ¿doa baisur-itogoe?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bab-Dummad-e-ibmar-sogedba dii-gwamakaled diree imaked.","poem":1},{"text":"Burwa-golega imaked, geb dii gannar suurmakega imaked.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bab-Dummad Jacob-waganga e-gayaburba uksad,","poem":1},{"text":"Israel-dulemarga na E-Igar-Maid, E-Igar-Inniki-imaklemalad, uksad.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bab-Dummad dulemar-yar-baid-baidgi-bukwamaladdi, deyob imaksasulid.","poem":1},{"text":"Amardi, bipisaale E-Igar-Mesisad wisgussurmalad.","poem":2},{"lineBreak":true},{"text":"¡Aleluya! ¡Bab-Jehová-nug odummolesun!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}