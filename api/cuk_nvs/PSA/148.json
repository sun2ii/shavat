{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":148,"content":[{"type":"heading","content":["Bela-ibmar-obinnilesadi, Bab-Jehová-nug-odummoged"]},{"type":"verse","number":1,"content":[{"text":"¡Aleluya! ¡Bab-Jehová-nug odummolesun!","poem":1},{"text":"Nibneg-akar, Bab-Jehová-nug be odummomar.","poem":2},{"lineBreak":true},{"text":"Nibneg-matusulid-akar,","poem":1},{"text":"Bab-Jehová-nug be odummomar.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bela Bab-Jehová-baliwiturmar, Bab-Jehová-nug odummomar.","poem":1},{"text":"Bela Bab-Jehová-sorda-bilagi-urwemalad, Bab-Jehová-nug odummomar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dad-ibeler, Bab-Jehová-nug odummosun.","poem":1},{"text":"Nii, Bab-Jehová-nug odummosun.","poem":2},{"lineBreak":true},{"text":"Niisgwamar, Bab-Jehová-nug odummomar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bela mogirmar-ugakaase-nanaid, Bab-Jehová-nug odummomar.","poem":1},{"text":"Diimar-mogirmar-niba-nanaid, Bab-Jehová-nug odummomar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová-nug odummomarsun,","poem":1},{"text":"ar e-ibmar-sogsadba, ibmarmar obinnilesad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Degisadegu ibmarmar innikii urbilesad.","poem":1},{"text":"E-igar-omesisadi, bar egi annalegegarsulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Napneg-akale, Bab-Jehová-nug odummomar:","poem":1},{"text":"Demargi ibdula-dummagan-bukwad, Bab-Jehová-nug odummomar.","poem":2},{"lineBreak":true},{"text":"Demar-wilagana, Bab-Jehová-nug odummomar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mala-ibyemalad, dii-gwamakarmalad, Bab-Jehová-nug odummomar.","poem":1},{"text":"Boo-gwamakaled, boo-batemalad, Bab-Jehová-nug odummomar.","poem":2},{"lineBreak":true},{"text":"Burwa-dummagan-be-sogedba-ibmar-imakedi, Bab-Jehová-nug odummomar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yalamar, bela yala-mullugan, Bab-Jehová-nug odummomar.","poem":1},{"text":"Sapi-san-nikamalad, bela urwarmar, Bab-Jehová-nug odummomar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ibmar-dula-sapurbarmalad, ibmar-durgan-negginmalad, Bab-Jehová-nug odummomar.","poem":1},{"text":"Ibdula-unimalad, nuumar, Bab-Jehová-nug odummomar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Reymar-napneggi-mamaid, Bab-Jehová-nug odummomar.","poem":1},{"text":"Bela dulemar-yar-baid-baidgi-bukmalad, Bab-Jehová-nug odummomar.","poem":2},{"lineBreak":true},{"text":"Dule-nuga-nikamalad, dule-dummagan-yar-semamaid, Bab-Jehová-nug odummomar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sapingana, yagana, Bab-Jehová-nug odummomar.","poem":1},{"text":"Dadormar, mimmigan, Bab-Jehová-nug odummomar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bab-Jehová-nug odummomar, ar a-nugbi unnila dummarba gued.","poem":1},{"text":"E-gandik-yeerdakleged, napnegba, nibnegba, bur-gandik dakleged.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bab-Jehová, e-neggweburga gangued uksad.","poem":1},{"lineBreak":true},{"text":"Israel-wagan-bela-Bab-Jehováʼba-nanadimalad, e-dulamar-walikagwadga-gubalid,","poem":1},{"text":"Bab-Jehová-nug odummomar.","poem":2},{"lineBreak":true},{"text":"¡Aleluya! ¡Bab-Jehová-nug odummolesun!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}