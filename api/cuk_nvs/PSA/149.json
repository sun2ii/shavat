{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"heading","content":["Bab-Jehová-nug ogannomar"]},{"type":"verse","number":1,"content":[{"text":"¡Aleluya! ¡Bab-Jehová-nug odummolesun!","poem":1},{"lineBreak":true},{"text":"Bab-Jehováʼga namaked-binid namakmala.","poem":1},{"text":"Bab-Jehová-sordamar-abargi Bab-Jehová-nug odummomala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Israel-dulemar, dule-bega-burba-uksadgi be wergumala,","poem":1},{"text":"Israel-dulemar Sión-yargi-bukmalad, be-e-Reygi be wergumala.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nue-weligwaledgi-dodonai,","poem":1},{"text":"Bab-Dummad-e-nug ogannomala.","poem":2},{"text":"Gar-pandero-ogornai ega be namakmala.","poem":1},{"text":"Gar-arpa-ogornai ega be namakmala.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ar Bab-Jehová e-dulemargi yeer itodaed.","poem":1},{"text":"Dule-wiledimaladi e-isdarmaladgi-nakwega imakdaed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Dummad-sordagan na be emargi-obichamaladgi, wergumala.","poem":1},{"text":"Gachigi amba be maile, namakmai be imakmala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Be-gammu-galagi Bab-Dummad-nug odummomala.","poem":1},{"text":"Be-argangi es-suid-nugar-darbogwad-gani Bab-Dummad-nug odummomala:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Adi, dulemar-baigan buged-mai be imakmalaga,","poem":1},{"text":"dulamar-baigan sabsur-odurdakega,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"esgoro-dubgi e-reymar-edinnega,","poem":1},{"text":"esgoro-dubgi e-dummagan-edinnegar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Adi, Bab-Dummad, dulemar-sabsur-odurdakoye-sogsadba imaklegegar.","poem":1},{"text":"Weyob gunonikile, bela bemar Bab-Dummad-sorda-gumaladi egi be wergumaloed.","poem":2},{"lineBreak":true},{"text":"¡Aleluya! ¡Anmar-Bab-Jehová-nug ogannomar!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}