{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":15,"content":[{"type":"heading","content":["Bab-Dummadse-goled-neggi-gudimaloed"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼye, ¿doa bese-goled-neg-selegedgi nabir mai guoe?","poem":1},{"text":"¿Doa be-yar-islidikidgi nabir gudii guoe?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Unnila weyob-damaladbi gudii guoed:","poem":1},{"text":"Dule-inniki-nanadiid,","poem":2},{"lineBreak":true},{"text":"dule-igar-innikigwad-imakdiid,","poem":2},{"lineBreak":true},{"text":"dule-napiragwadba-ibmar-soged.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dule-baidgi-wissur-gakansaed,","poem":2},{"lineBreak":true},{"text":"dule-aimar-naibi-imakdisulid,","poem":2},{"lineBreak":true},{"text":"dule-emar-mesagwar-imakdisulid.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dule, dule-Bab-Jehováʼse-obanlesad obanmogad.","poem":2},{"lineBreak":true},{"text":"A-dule, Bab-Jehová-dobekwaa-nanadiid-e-nugdi ogannoged.","poem":2},{"lineBreak":true},{"text":"Dule, ibmar-imakoye-sogsad,","poem":2},{"lineBreak":true},{"text":"ega nuedga-guosur-inigwele, imakedse-daed.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dule, dule-baidga mani-uksale,","poem":2},{"lineBreak":true},{"text":"e-gaka egi-onosulid.","poem":2},{"lineBreak":true},{"text":"Dule, dule-ibmar-oakalossulidgi-aibinega","poem":2},{"lineBreak":true},{"text":"dule-baiganse manigi-bakledisulid.","poem":2},{"text":"Ar dule weyob-daedi, bipisaale gwen galakuosulid.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}