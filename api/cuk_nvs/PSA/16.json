{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":16,"content":[{"type":"heading","content":["Bab-Dummadgi an bensulid"]},{"type":"hebrew_subtitle","content":["David namaked-Mictam narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummadye, be an-bendake,","poem":1},{"text":"an begi dukued amidiid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bab-Jehováʼga an sogsad:","poem":1},{"text":"“Bebi unnila be an-Dummadga-guye,","poem":2},{"text":"dule-baidgi ibnued an amisurye,","poem":1},{"text":"unnila beginbi ibnued an amiye.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dule-gwage-swilidikmalad we-yargi-bukmaladgi an yeer-itoged.","poem":1},{"text":"Dule-gwage-inniki-gudimaladgi an yeer-itoged.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dulemar ibmar-bab-dummadyob-imaklemaladga nue-alamakdimaladdi, dukin nunmaked-onasguega imakdimalad.","poem":1},{"text":"Andi, ibmar-bab-dummadyob-imaklemaladga ablis-uklegedi, bipisaale gwen ukosulid.","poem":2},{"lineBreak":true},{"text":"An-gwabindukubela, gwen e-nug biosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová, bela ibmar-nueganba","poem":1},{"text":"be anga ibmar-biriginedga gued.","poem":2},{"text":"Be angi doggus ise-nued-binsamaid.","poem":1},{"text":"An-san-burba, bela be-argan-yaurgi siid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Napa-nuegan be anga uknonikid,","poem":1},{"text":"napadar-nued be anga daksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová-anga-binsaed-ukmaid-nug an odummogoed.","poem":1},{"text":"E-binsaedi, mutikidba an-ulubgi, anga ibmar-soge an itodaed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gusgu Bab-Jehováʼse an idaked, ar anba-gudiguad.","poem":1},{"text":"Ar an-yalaba gwichigusoggu, dule gwen an-oakalogosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"A-ulale, an-gwagegi an yeer-itoged.","poem":1},{"text":"Bela an-ulubgi an weligwar itoged.","poem":2},{"lineBreak":true},{"text":"Bela an-san-burba begi-bensuli gudii guoed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gwen be an-san-burba neg-uangi oyogsaosulid,","poem":1},{"text":"ar be-mai-gwage-swilidikid-e-mui gwen neg-uangi onunsaega be imakosulid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Igar-nuedba-gudigued be anga oyosad,","poem":1},{"text":"be-asabinni bela-belad weligwar-gudii be an-imaked.","poem":2},{"lineBreak":true},{"text":"Be-yalaba degisadegu-gudiid an yeer-itoged.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}