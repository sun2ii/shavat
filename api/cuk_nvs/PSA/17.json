{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":17,"content":[{"type":"heading","content":["Bab-Dummadse goled, an-bendakye"]},{"type":"hebrew_subtitle","content":["David, Bab-Dummadse goled."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼye, an bese napiragwadgi wilesagwa-goledi, wis be an-itoge.","poem":1},{"text":"An bese-binnasuli-goledi, be an-itoge.","poem":2},{"text":"An bese-goledi, nue be itoge,","poem":1},{"text":"yamo an be-yardaknaisulid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Dummadye, be ibmar-innikigwad-magar-daked-ular,","poem":1},{"text":"bee be an-bendakedga gue.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Be an-binsaed nue-dakdaed.","poem":1},{"text":"Mutikidba an nue-ulubgi-binsamaid be baramidaed.","poem":2},{"text":"Nue be an-wilubdaksad, ibmar-isgana be angi amissurgusad.","poem":1},{"text":"An na sogsad, an-sunmakedgi an begi isguosurye.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Be-igar-nued-mesisad-ular, dulemar-baigan-daedyobi an dasulid,","poem":1},{"text":"ibmar-isgana-imakedgi an nanadisulid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Be-Igar-Maidba bur an nanadiid,","poem":1},{"text":"a-igargi gwen an bangudisulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bab-Dummad, ar be an-abin-imakdasoggu, a-ular, an bese binnasuli goled.","poem":1},{"text":"Wis be an-itoge, an bese-goled nue be itoge.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"¡Be-sabed-sunsoged be anga oyoge!","poem":1},{"text":"Dulemar begi-bendakleged-amididamaladi,","poem":2},{"text":"dulemar-isganamarse baregilledidamaladi,","poem":1},{"text":"a-dulemar, be-ganguedgi be bendakdaed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ar dule-isganamar angi dummad-yolenanaisoggu,","poem":1},{"text":"igi be-ibyagwag na be akwe, deyobi, be an-akwemoga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ar dule-an-oburgwebimalad bato an-walik guakwaa gudimarsoggu,","poem":1},{"text":"igi gannir e-sakan-urba na e-mimmigan odukue, deyobi, be an-odukumoga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"A-dulemar, dule-wiledaked satemalad,","poem":1},{"text":"unnila na san-dummarba-imakedgi sunmakmalad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"An-isdarmalad-an-baregindimalad an-walikagusad,","poem":1},{"text":"angi ukiar sabsur-yolemalaga, guakwaa gudimalad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Achumigur mas-gabiedyobi, an-isdarmaladde anbina gudimalad.","poem":1},{"text":"Achumigur e-mas-gaega balidakagwar maidaedyobi, anbina gudimalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bab-Jehováʼye, ginebinne, an-isdarmalad-abin be nodage,","poem":1},{"text":"an-isdarmalad be obelodage.","poem":2},{"text":"Bab-Dummadye, be an-abonogega,","poem":1},{"text":"be-es-suidgi an-isdarmalad be oburgwedage.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bab-Jehováʼye, be-gangued-nikadba, an-isdarmaladgi be an-onoge.","poem":1},{"text":"We-dulemar unnila we-napnegginbi ibmar-nika gudimalad.","poem":2},{"lineBreak":true},{"text":"We-dule-isganamar, be-ibmar-nuegan nue-nika gudimalad.","poem":1},{"text":"E-mimmigan, e-babgan-sorba, a-ibmar-nuegan abingadimarmogad.","poem":2},{"lineBreak":true},{"text":"Degine, e-wagangarmoga bela ibmar-nuegan obine abingadimarmogad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bab-Jehováʼye, andi, ibmar-oakalossurye be angi-sogsadba, an be-wagar dakoed.","poem":1},{"text":"Sikwas an be-wagar-daksale, bato gusbin an itogoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}