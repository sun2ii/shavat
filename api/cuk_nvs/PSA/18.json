{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":18,"content":[{"type":"heading","content":["Bab-Jehováʼga dog-nuedye sogleged"]},{"type":"hebrew_subtitle","content":["Bab-Dummad-e-mai-David, Bab-Jehováʼga we-namaked narmaksad."]},{"type":"hebrew_subtitle","content":["Deunni, Bab-Jehová Saúlʼgi David-bendaknonigu, degi, e-isdarmaladgi bendaksabargu."]},{"type":"hebrew_subtitle","content":["David weyob Bab-Jehováʼga sogded:"]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼye, nue an be-sabed,","poem":1},{"text":"be an-niga-ogannoged maid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bab-Jehováʼye, be an-akwasailaga gued.","poem":1},{"text":"Be an-garganguedsoggu, an begi bensulid.","poem":2},{"text":"Bab-Jehováʼye, be an-neggandikidid.","poem":1},{"text":"Sigu-abgaedyob be an-idu bonigan-irwa gwisgued.","poem":2},{"text":"Be-garganguedgi be an-bendaked.","poem":1},{"text":"Bebi unnila bonigan-idu an-odukued-birigined maid.","poem":2},{"text":"Bab-Jehováʼye, be an-ollor-imakedid.","poem":1},{"text":"Bonigangi be an-ollor-imakdiid.","poem":2},{"text":"Ar an bese gotele,","poem":1},{"text":"an-isdarmaladgi-nakwega be an-imaked.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Jehováʼye, be-nug an ogannoged,","poem":1},{"text":"ar be-nug innikigwadba odummoleged maid.","poem":2},{"lineBreak":true},{"text":"Bab-Jehováʼye, an-isdarmaladgi an bendaklegoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Burgwed-igar nue an-ebiris gunaid.","poem":1},{"text":"Diwar-dummad-nomaiyobi, burgwed angi gwisgunonikid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bato an gachiyala megis-itoged,","poem":1},{"text":"gwillo angi-biles-maiyob an itoged,","poem":2},{"text":"gwen bar san-onoged an itosulid.","poem":1},{"text":"Burgwed-igar, an-idu saki-milesnaiyob naid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"An surbinsa-itodiidgi Bab-Jehováʼse an gote gusad,","poem":1},{"text":"Bab-Dummadse ise-gollar an imaksad.","poem":2},{"text":"Agine, e-neg-akale, an-itononikid.","poem":1},{"text":"Bab-Jehováʼse-an-gornaidi, e-uayagwar an-itosad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová-uludgua, neg giglimakded,","poem":1},{"text":"yar-sailagan-mamaidse-bakale, giglimakded.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová-bunnodedbali waa bupurmakded,","poem":1},{"text":"e-gaya-yaba soo-gwabunyeded, ginnitibi soo-mialid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bab-Jehová mee mogir-egasad,","poem":1},{"text":"geb abali aidealid, mogir-gudureged-birgi aidealid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Jehová baliwitur-querubinʼye-nugad-birgi-sii, mogir-imbaba nadapid.","poem":1},{"text":"Burwa-gandik-gormaidba gukumai gualid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Dummad neg-gudureged-abargi nadapid.","poem":1},{"text":"E-irwa mor-dummad-naiyob mogir nagusad.","poem":2},{"lineBreak":true},{"text":"We-mogir dii-dummad-widanikiyob dakle sigisad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bab-Jehová-sabsur-gadedbali, mogirmar aisakided,","poem":1},{"text":"mogirmar dii-akwamaryob mileded,","poem":2},{"lineBreak":true},{"text":"sogunmar ginnitibi mileded.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bab-Jehová nibneg-akale, mogirmar-dii-akwamaryob-milemaid-abalagine,","poem":1},{"text":"sogunmar-ginnitibi milemaid-abalagine, mala-gollomakmaiyob binnasuli sunmakded.","poem":2},{"text":"Bab-Jehová-Bur-Birigined-e-sunmaked bela neg-gaded.","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Bab-Jehová sigu-milegeyob e-isdarmaladgi mar-odealid.","poem":2},{"text":"Bab-Dummad e-isdarmalad-oduurmaksad,","poem":1},{"text":"e-isdarmalad-oabarmakega imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Bab-Jehová, be-uludedbali demar-urba-napa-naid mag-dakle gunonikid.","poem":1},{"text":"Bab-Jehová, be-bunnodedbali, napasaila daled gunonikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bab-Jehová nibneg-akale, anse e-argan oyononikid.","poem":1},{"text":"An demar-wilagi-gundilenai an-ononnonikid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bab-Jehová an-isdarad-buledgi an-bendaksad.","poem":1},{"text":"Bab-Jehová isdar-an-dakdimaladgi, an-ollor-imaknonikid.","poem":2},{"lineBreak":true},{"text":"An-isdarmalad-angi-obinmaladgi an-abonononikid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Boniganba-an-galitonaidgi an-isdarmalad angi gwisgunonikid.","poem":1},{"text":"Agine, Bab-Jehová an-bendaknonikid.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bab-Jehová wile-an-dakedbali, an-bendaknonikid,","poem":1},{"text":"neg-nuedgi an-ogwisgunonikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Bab-Jehová an ibmar-nued-imakedba anga ibmar-nued uked.","poem":1},{"text":"Ibmar-isgana-imakdisulidba nued angi binsaed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ar Bab-Jehová-Igar-Maidba an gudiid,","poem":1},{"text":"ibmar-isgana an imakdisulid,","poem":2},{"lineBreak":true},{"text":"Bab-Dummadgi an bangudisulid.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ade, bela e-igar-uksad an nue-gasa gudiid,","poem":1},{"text":"e-Igar-Maidgi an bangudisulid.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bab-Jehováʼga sogedba an gudiid,","poem":1},{"text":"ibmar-isgana-imaklegedgi an na san-bargas gudiid.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bab-Jehová an ibmar-nued-imakedba anga ibmar-nued uked.","poem":1},{"text":"Ibmar-isgana-imakdisulidba nued angi binsamaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Bab-Jehová, dule-beba-bane-bane-inniki-nanadiidgine, egi be bane-bane inniki damogad.","poem":1},{"text":"Bab-Jehová, dule-igar-innikigwadba-nanadiidga, ega be inniki ibmar-imaked.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bab-Jehová, dule-bega-gakansasulidga, be gakansasurmogad.","poem":1},{"text":"Be dule-emar-yardakedgardi, e-igar e-ibe be obured.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bab-Jehová, dulemar na-san-bipi-imakdimalad, bonigangi-obinega be imaked.","poem":1},{"text":"Dule-na-san-dummarba-imakdimaladdina, be sabsur-wioged.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Bab-Dummad-Jehová, be dula-gudii an-imaked.","poem":1},{"text":"Bab-Jehová, an bonigan-abalagi-gudiidgi, san-burba-dula-gudii be an-imaked.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Bab-Jehová, be-an-bendakedbali, sordamar-danar-bila-onomalad an ogilogoed.","poem":1},{"text":"An-Bab-Dummad, be-an-bendakedbali, neggweburmar-galu-matusulid-nikad an obelogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Bab-Dummad-e-ibmar-imakedi innikigwad imaked, e-gayaburba sunsogedid.","poem":1},{"text":"Bab-Jehová dule-egi-dukumaladga sigu-abgaedyob gued.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"¿Doa Bab-Jehováʼyob Bab-Dummadga mai? Dule sate. Unnila Bab-Jehováʼbi maid.","poem":1},{"text":"¿Doa Bab-Dummadyob-gangued mai? Dule sate. Unnila Bab-Jehováʼbi maid.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Bab-Jehováʼbi unnila anga gargangued ukmaid,","poem":1},{"text":"Bab-Dummadbi dobsuligudii an-imaked.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Bab-Dummad goe-sapur-abarmakedyob an-oabarmaked,","poem":1},{"text":"yar-billiganaba geg baparmakega an-imaked.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Bab-Jehová an-surgan ogannoged,","poem":1},{"text":"adi, an nabir bila-onogegar.","poem":2},{"text":"Bab-Jehová an-swidamar ogannoged,","poem":1},{"text":"adi, nabir warsi-esgoro-gordikidbiid an dopee imakegar.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Sigu-abgaedyob be an-irwa gwisgued,","poem":1},{"text":"be-garganguedgi be an-bendaked.","poem":2},{"text":"Be nued-angi-binsaedba nasguega be an-imaked.","poem":1}]},{"type":"verse","number":36,"content":[{"text":"Bab-Jehová, an nabir nanaega, melle an aimukuega, anga be neg-ollor-dummad nasiksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"An an-isdarmalad-baregitegusgua, an indaksasulid, an bargadapid.","poem":1},{"text":"Bela an-isdarmalad-obelogedse an imaksad.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Bela-bela an an-isdarmalad naibi-imaksad,","poem":1},{"text":"degisoggu, gege bar angi gwisgu gusmalad.","poem":2},{"lineBreak":true},{"text":"An-isdarmalad anse nue-galakusmalad.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Bab-Jehová, bila-onogega be an-ogannosad,","poem":1},{"text":"an-isdarmalad anse-ibitogega be imaksad.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"An-isdarmalad anse-galakudedba, wakinnega be imaksad.","poem":1},{"text":"Deyob isdar-an-dakdimalad an obelosad.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"An-isdarmalad aisaar dule-e-bendakegala, emarse gornanai gusmalanad,","poem":1},{"text":"dule-e-bendaked sate gusmalad.","poem":2},{"text":"Bab-Jehováʼse gochamalanad,","poem":1},{"text":"Bab-Jehováʼdi abin-imaksasulid.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"An-isdarmalad anse sanyob ichi-ichi gusad.","poem":1},{"text":"Amar ukub burwa-abin-mileddaedyob anse gusmalad,","poem":2},{"lineBreak":true},{"text":"sabsur-enalenai anse gusmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Bab-Jehová, dule-angi-urwedimaladgi be an-bendaksad,","poem":1},{"text":"dule-yar-baid-baidgi-bukwamalad-e-dummadga be an-imaksad.","poem":2},{"lineBreak":true},{"text":"Dulemar-aku-an-dakmalad an-maiga gunonimalad.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Ibmar-imakoye an sogsale, a-dulemar, yog anba ibmar-imakar damalad.","poem":1},{"text":"Wemar-Israel-dulesurmaladi, an-nug odummodimalad.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"We-Israel-dulesurmaladi, an-gaya-itosale, nig-argwate damalad,","poem":1},{"text":"e-dukued-yaba-bukwa-noarmalale, wawanmakdani noardamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"¡Bab-Jehová dula-mai!","poem":1},{"text":"¡Bab-Jehová, unnila bebi an-bendaked maid!","poem":2},{"lineBreak":true},{"text":"¡Be-nug an odummosun!","poem":2},{"text":"Bab-Jehová, be an-abonogedid.","poem":1},{"text":"Be-nug bela-bela odummolesun.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Bab-Dummad anga an-isdarmalad-buged-mai imaksad,","poem":1},{"text":"Bab-Dummad, dule-yar-baid-baidgi-bukmalad an-maiga-gumalaga anga imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"Bab-Dummadye, an-isdarmalad-angi-gwisguargua, be an-abonononikid.","poem":1},{"text":"An-isdarmaladgi-obinega be an-imaksad,","poem":2},{"lineBreak":true},{"text":"dule-ursilimaladgi be an-ollor-imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"Degisoggu, Bab-Jehová, Israel-dulesurmalad-abargi an be-nug ogannoged,","poem":1},{"text":"Be-nug-odummogegala an namaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":50,"content":[{"text":"Bab-Jehová, e-rey bela-bela e-isdarmaladgi-obinega na imaked.","poem":1},{"text":"Na nug-imaksa-gudiidga, e-sabgued oyoged.","poem":2},{"text":"Davidʼga, degi, e-waganga, e-sabgued oyoged.","poem":1},{"text":"Degisadegu, e-sabgued ega oyodii guoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/17.json","previousChapterAudioLinks":{},"numberOfVerses":50}