{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":19,"content":[{"type":"heading","content":["Bab-Dummad-neg-obinnisad"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad. Namakmalad-e-iduedga soglenaid."]},{"type":"verse","number":1,"content":[{"text":"Mogir-naidi, Bab-Dummad-e-gangued-yeerdaklegedgi sunmaknaid.","poem":1},{"text":"Mogir-billi-aradgi bela-ibmar-naidi, Bab-Dummad-e-ibmar-obinnisad oyonaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bela-ibmar-naidi, bane-bane ibginedbali, Bab-Dummad-e-gangued-yeerdaklegedgi na sunmaknanaid,","poem":1},{"text":"Bela-ibmar-naidi, bane-bane mutikidbali, Bab-Dummad-e-gangued-yeerdakleged na barsognanaid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"We-ibmarmar duleyob-sunmaksur-inigwele,","poem":1},{"text":"ibmar-bisurmar-inigwele, e-gaya-goled-itolesur-inigwele,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"we-ibmarmar-naid-e-sunmakedi, napneggi bela itoleged,","poem":1},{"text":"bela napneg-dirbir-naid-ugakaase warmaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bab-Dummad dad-ibelerga mogir-billigi neg-nasiksad.","poem":1},{"text":"Ar igi machered-ome-nikusad neg-oibosale, e-gabedneggi weligwar-noardae,","poem":2},{"lineBreak":true},{"text":"deyobi, dad-ibeler wakudaryalaba noardaed.","poem":2},{"text":"Ar Igi dule-abarmaked abarmaksokalir, yeer-itodae,","poem":1},{"text":"deyobi, dad-ibeler nakwiardaed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dad-ibeler mogir-billi-nagagi nakwidagogu, mogir-billi-bergunaidse argwandapdaed.","poem":1},{"text":"Dad-ibeler-e-ueregedgi ibdula gwen dukuosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová-Igar-Maidi, napiragwadid,","poem":1},{"text":"dule-burba-ogannogedid.","poem":2},{"text":"Bab-Jehová-Igar-Maidi, sunsogedid,","poem":1},{"text":"egi geg benguleged.","poem":2},{"text":"Bab-Jehová-Igar-Maidi,","poem":1},{"text":"dule-binsaedsulidaed binsaed-ibedga imaked.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová-Islidik-Igar-Mesisad innikigwadid,","poem":1},{"text":"gwage-weligwar dule-saed.","poem":2},{"text":"Bab-Jehová-e-Igar swilidikidid,","poem":1},{"text":"magar-ibmar-itoge dule-imaked.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Jehová-dobee-nanaed-igar swilidikidid,","poem":1},{"text":"degisadegu mai guoed.","poem":2},{"text":"Bab-Jehová-igar-naboged, napiragwadid,","poem":1},{"text":"bela innikigwadbiid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Jehová-e-Igar orba bur bule nuedid,","poem":1},{"text":"or-nuedba bur bule e-bina sogleged.","poem":2},{"text":"Bab-Dummad-e-Igar achanisba bur bule ochigwad,","poem":1},{"text":"achanis-aryomaidba bur bule osidikid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Be-Gayaburba anga iduakwaa ibmar-soged:","poem":1},{"text":"“Nue salakarye.”","poem":2},{"text":"Ar dule a-Gayaburbaba ibmar-imakele,","poem":1},{"text":"bukidar ibmar-nuegan nikuoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"¿Doa e-nodiid na magar-itoge?","poem":1},{"text":"Bab-Jehováʼye, ibugi an begi nodidibe, an na wissulid.","poem":2},{"lineBreak":true},{"text":"Agi be an-ollorsae.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Deginbali, an yamo-begi-yoledaedgi, be an-ollorsabali.","poem":1},{"text":"We-isgued mer angi obined be sae.","poem":2},{"text":"Adi, dulemar bar angi sunmakosulid,","poem":1},{"text":"bar an isgued-dummad imakosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Bab-Jehová, be an-edarbedid,","poem":1},{"text":"be an-odukuedid.","poem":2},{"text":"Degisoggu, an-sunmaked be yeer-itosana gadin,","poem":1},{"text":"ulubgi-an-binsaed be yeerdaksana gadin.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}