{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"heading","content":["Bab-Jehová, rey-nug-imaksad"]},{"type":"verse","number":1,"content":[{"text":"¿Ibiga dulemar-yar-baid-baidgi-bukwamalad, Bab-Jehováʼgi binsarsunna urwebukwa?","poem":1},{"text":"¿Ibiga dulemar Bab-Jehováʼgi-aibinedgi binsarsunna binsabukwa?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Reymar-negsemamaid, Bab-Jehováʼgi aibitemalad.","poem":1},{"text":"Dulemar-nuga-nikamalad, Bab-Jehováʼgi isdar-binsadmalad.","poem":2},{"lineBreak":true},{"text":"Bab-Jehová-na-nug-imaksadgi aibitemarbalid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"We-dulemar, weyob sogdemalad: “Anmar e-gangued obeloge,","poem":1},{"text":"e-negsemaidgi anmar ollorgumala.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová-Niba-Neg-Dakmaid ega alled,","poem":1},{"text":"Bab-Dummad amargi dodoged.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová a-dulemarse urwed.","poem":1},{"text":"A-dulemar, Bab-Dummad-urwedba abin gwakidmalad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Jehová weyob ega sogded:","poem":1},{"text":"“Ani an-yar-islidikid-Siónʼye-nugadgi, an-rey an mesisad.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová-Igar-Mesisad an soggwelo.","poem":1},{"text":"Bab-Dummad weyob anga sogsad:","poem":2},{"text":"“Be an-machi gued,","poem":1},{"text":"emi-ibagi, an be-babga gunonikid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Anse be ibmar egise,","poem":1},{"text":"ar bela dulemar-yar-baid-baidgi-bukwamalad an bega ukoed,","poem":2},{"lineBreak":true},{"text":"yarmar-nanaid bela ugakaase an bega ukbaloed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sabsur-gandikidba be negseoed,","poem":1},{"text":"sianar-irgwensur-mamariddaedyobi, be a-dulemar-imakoed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Reymar, degisoggu, wisigarmar,","poem":1},{"text":"nue-binsaed-nikaa damalo.","poem":2},{"text":"Dulemar-negsemamaid, ¡nue salakarmar!","poem":1},{"text":"Bab-Jehová bega ibmar-sognaidba be damar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bemar, Bab-Jehová-e-nug nue-itoakwaa odummomalo,","poem":1},{"text":"ise-itoakwaa Bab-Jehová-mag-dakedgi be wergudii gumalo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bab-Jehová-mer-urwega, E-Machi-urbalikwaa be nanamarsun.","poem":1},{"text":"Ar Bab-Jehová bemarse-uludele, bemar sunna ese oburgwilemalad.","poem":2},{"lineBreak":true},{"text":"¡Bab-Jehová dule-egi-bensuli-nanamaladgi, nued binsadaed!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}