{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"heading","content":["Boni-dummagangi-obinega Bab-Dummadse goled"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad. Namakmalad-e-iduedga soglenaid."]},{"type":"verse","number":1,"content":[{"text":"Dobedba be suli-suli itogele, Bab-Jehová be-itogena gadin.","poem":1},{"text":"Jacob-e-Bab-Dummad-nuggi, be bendaklegena gadin.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová e-neg-islidikid-akale, bega bendakleged barmidagena gadin.","poem":1},{"text":"Bab-Dummad Sión-yar-akale, be-bendakena gadin.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ega be ibmar-ukedi, Bab-Dummad bela insaena gadin,","poem":1},{"text":"ega be ibmar-ogumakar-ukedi, be-abin nuedgi abingaena gadin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Be ibmar-abediidbali, Bab-Dummad bega ukena gadin.","poem":1},{"text":"Be ibmar-imakedgi-binsaedi, bega bela nueganbi guena gadin.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Boni-dummagangi be obichale, anmar weligwar-itogedba oimakdemaloed.","poem":1},{"text":"Anmar-Bab-Dummad-nuggi, olo-bander omemmermakdemaloed.","poem":2},{"lineBreak":true},{"text":"Bab-Jehováʼse be ibmar-egichisadi, bela bega sogedba imakena gadin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ar emigindi an wisdo, Bab-Jehová, e-nuggi-rey-nugsalegaled bendakoed.","poem":1},{"text":"Bab-Jehová e-ganguedgi, bila-onolegedgi, rey-nakwemai-guega imakoed.","poem":2},{"lineBreak":true},{"text":"Bab-Jehová e-nibneg-islidikid-akale, rey-abinsaoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dulemar gwenna-gwenna unnila moli-ur-bila-onomaladginbi bensurmalad,","poem":1},{"text":"baigandi e-molimarginbi bensurmarmogad.","poem":2},{"lineBreak":true},{"text":"Anmardina, unnila anmar-Bab-Dummad-Jehováʼgi bensurmalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"We-dulemardi nue geg gugus galakudmalad.","poem":1},{"text":"Anmardina, amba Bab-Jehováʼgi-bensulidba ganna gudimalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bab-Jehováʼye, sorda-bila-onomaladgi, rey-nakwega be imako.","poem":1},{"text":"Bab-Jehováʼye, anmar bese gotele, be anmar-abinsao.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}