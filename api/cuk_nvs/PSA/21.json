{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":21,"content":[{"type":"heading","content":["Bab-Dummad Rey-David-nakwega imaksad"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad. Namakmalad-e-iduedga soglenaid."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová, be-ganguedgi rey weligwar itoged.","poem":1},{"text":"E-isdarmaladgi-nakwega be imaksadba, rey nue-weligwar itoged.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová, e-ulubgi ibmar-abediid ega be uksad.","poem":1},{"text":"Ibmar-bese-egichisadi, mer an ega gwen ukodeeye be sogsasulid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová, reygi be nued binsasad.","poem":1},{"text":"E-nonogi, gurgin-olobiid ega be sisad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"We-reyde, san-burba-dula-gudigued bese egichisad.","poem":1},{"text":"Suitii degisadegu dula-gudiguega be imaksad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová, be rey-bendakedba, rey bila-ononanaidgi-nakwega be imaksad.","poem":1},{"text":"Be-bendakedba, e-gangued dummarba naded.","poem":2},{"text":"Be-bendakedba, e-nug nue be odungusad.","poem":1},{"text":"Bela-bela e-gangued-yeerdakleged reyga be uksabalid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Dummad, reygi nuedbi degisadegu be binsamaid.","poem":1},{"text":"Eba be gudiidbali, rey weligwar itodaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová-Bur-Birigined-e-sabgued geg bergusoggu,","poem":1},{"text":"rey a-Bab-Jehováʼgi bensulidbali, gandik megoed, onolegosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová, be-ganguedgi bela be-isdarmalad bese galegoed,","poem":1},{"text":"bela begi gwisgudidimalad bese galebaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bab-Jehová, be nonikile, be-isdarmalad sooga be obinyoed.","poem":1},{"text":"Bab-Jehová, be ulude-sogele, igi soo bela ibmar-obelodae,","poem":2},{"text":"deyobi, bela be-isdarmalad bese bergumaloed,","poem":1},{"text":"bela bese girgumaloed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Dummad, bela we-napneggi be-isdarmalad-e-mimmigan be osulogoed,","poem":1},{"text":"dulemar-abargi bela e-anagan be sate imakoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amba akar be-imakbimalandibe, amba gwen be-oakalogosurmalad.","poem":1},{"text":"Ibmar-isgana-imakega igar-amimardibe, gwen imakosurmalad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Be-warsi be-isdarmaladgi be oyodogu,","poem":1},{"text":"be-abin yogasaar duurmakdemaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"¡Bab-Jehováʼye, be-nug-odummolegega be-gangued be oyoge!","poem":1},{"text":"¡Be-ganguedgi namakar anmar be-nug odummomaloed!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}