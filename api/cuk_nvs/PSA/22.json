{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":22,"content":[{"type":"heading","content":["Nunmaked-abalagi Bab-Dummad-nug odummoged"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad. Namakmalad-e-iduedga soglesad:"]},{"type":"hebrew_subtitle","content":["We-namaked Ajelet-Saharʼye-nugadba namaklegoye."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummadye, ¿ibiga be an-obacha?","poem":1},{"text":"Be an-bendakegala, ¿ibiga be angi dikasur-gunai?","poem":2},{"lineBreak":true},{"text":"¿Ibiga an-gormaknaid gwen be itosuli?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Dummadye, ibginedba an bese gornadaenad,","poem":1},{"text":"gwen be an-abin-imakdasulid.","poem":2},{"text":"Mutikidba an bese gornadabalinad,","poem":1},{"text":"gwen be an-abin-imakdasurbalid.","poem":2},{"lineBreak":true},{"text":"An obunnodisulidba nue-geggus itolegusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Be dule-islidikidid,","poem":1},{"text":"Israel-dulemar bega namakmalad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Anmar-dadgan begi bensurgusmalad.","poem":1},{"text":"Begi-bensurgusmaladba be bendaknonikid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bese-gochamaladba be bendaknonikid.","poem":1},{"text":"Begi-bensurgunonimargu, be obinge-imaksasulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"An dulesuliyob itoleged,","poem":1},{"text":"napa-nus-musgimakdiidyob itoleged.","poem":2},{"text":"Dulemar ibmar-dodogedga an-imaknanaid,","poem":1},{"text":"bela dulemar isdarsun an-dakmalad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"An-dakarmalale, anga alliardamalad.","poem":1},{"text":"Anga akar-akar gunanai damarbalid,","poem":2},{"lineBreak":true},{"text":"nono ege-ege gunanai damarbalid.","poem":2},{"text":"Weyob sogmalad:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"“Bab-Jehováʼgi bensurye-sogdiid,","poem":1},{"text":"degite, Bab-Dummad e-bendakdado.","poem":2},{"text":"Bab-Dummadgi-wergudiiye-sogdiid,","poem":1},{"text":"degite, Bab-Dummad-e-sunnagwad we-ibmargi e-ollor-imakdado.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bab-Dummadye, sapidukugi-an-maigu, bee be an-odenonikid.","poem":1},{"text":"An-nan-nukugi nue-obunnogega be an-imaksabalid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Dummadye, sapidukugi-an-maigu, be nue an-akwisad.","poem":1},{"text":"Amba sapidukugi-an-maigu, bato be an-Bab-Dummadid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Dummadye, mer wargwen be an-mete,","poem":1},{"text":"ar an surbinsa itoged,","poem":2},{"lineBreak":true},{"text":"ar dule-an-bendaked gwen nikasulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"An-isdarmalad an-ebiris gudimalad,","poem":1},{"text":"Basán-moli-bebe-nikad-ursirmaladyobi an-ebiris gudimalad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Igi-achumigur masbina uurmaknagusdae,","poem":1},{"text":"igi-san-gasale, ichimaknagusdae,","poem":2},{"lineBreak":true},{"text":"deyob, an-isdarmalad angi gwisgunonimalad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dii-napagi-eolenaiyob bela an-san na itoged,","poem":1},{"text":"bela an-garmar nue-gwatiris itolebalid.","poem":2},{"text":"Igi-baka-gwallu soo-abin daluddae,","poem":1},{"text":"deyob, an-ulubgi an-gwage nade an itoged.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Dobedba bela an-gaya dinguded.","poem":1},{"text":"An-gwabinse-bakale, gege bar banamakgusad.","poem":2},{"lineBreak":true},{"text":"Napa-urba bato ber an megisayob na itoged.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dule-isganamar achu-soemaladyob an-ebiris gunanaid.","poem":1},{"text":"Bela an-argan, an-nag-matarse-bakale, uudu imaksamalad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"An-garmar daled daklegusad.","poem":1},{"text":"An-isdarmaladi an-indaknanaisulid,","poem":2},{"lineBreak":true},{"text":"an-ebiris an-dakbukwad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"An-mormar mimismarsunnad,","poem":1},{"text":"an-mor-suega, egi wilubdaknanai gusmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Bab-Jehováʼye, be an-niga-ogannogedid.","poem":1},{"text":"¡Mer be angi bangue! ¡Gwae be an-bendakdage!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mer es-suidse-oburgwilegega be an-imake.","poem":1},{"text":"Dule-achumaryob-gudimaladgi be an-bendake.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Achumigur-nono-wawaadyob-gudimaladgi be an-bendake.","poem":1},{"text":"Moli-bebe-nikad-ursirmaladyob-gudimaladgi be an-ollor-imake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Bab-Jehováʼye, an-gwenadganga an begi sunmakoed.","poem":1},{"text":"Dulemar-onmaked-abargi an be-nug-odummogoed.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bemar, Bab-Jehová-dobekwaa-gudimalad, Bab-Jehová-e-nug odummomar.","poem":1},{"text":"¡Jacob-e-wagan! Bab-Jehová-magar-dakdii nanamar.","poem":2},{"lineBreak":true},{"text":"¡Israel-e-wagan! Bab-Jehová-e-nug odummomar.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bab-Jehová, dule-wileged-e-naibi-itodiid baisur-daksulid, wagar-biria daksulid.","poem":1},{"text":"We-dule-ese-gollalile, abin-imaked.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bab-Jehová, be-dulamar-onmaked-abargine,","poem":1},{"text":"be-nug-odummogega be an-imaked.","poem":2},{"text":"An bega ibmar-imakoye-sogsadi,","poem":1},{"text":"dulemar-be-nug-odummodimalad-asabin an bega imakoed.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Dule-wilemalad nue immeledmaloed.","poem":1},{"text":"Dule-Bab-Jehová-amidimalad, Bab-Jehová-e-nug-odummodimalad, e-ulubgi weligwar-itodmaloed,","poem":2},{"lineBreak":true},{"text":"deyob sadegu gudmaloed.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bela we-napneggi-dulemar-yar-baid-baidgi-bukwamalad, dulemar-ablis-akar-akar-bukwamalad-ugakaasega, Bab-Jehová-ebinsadmaloed,","poem":1},{"text":"Bab-Jehováʼse gannar aibirnonimaloed, sindigar abin ambikunonimaloed.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ar Bab-Jehová bela we-napneg ganikid,","poem":1},{"text":"bela dulemar-bukwad, e-argan-yaurgi gudidiid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Dule burgwesuli geg gued.","poem":1},{"text":"Degisoggu, bela we-napneggi ibmar-bukidar-nikagudimalad, dulemar-burgwedani-gudimalad,","poem":2},{"text":"Bab-Jehová-asabin sindigar sigmaloed,","poem":1},{"text":"e-nuggi iba onomaloed.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Bela mimmigan-danimalad, Bab-Jehová-e-nug odummomaloed.","poem":1},{"text":"Yoedse-danimalad, Bab-Jehová-e-nug-odummodii gumaloed.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Amba-yoo-dulemar-gwalulemaladga soglemogoed,","poem":1},{"text":"Bab-Jehová ibmar-innikigwad imakmaiye,","poem":2},{"lineBreak":true},{"text":"degi, ibmar-dummagan oyomaiye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}