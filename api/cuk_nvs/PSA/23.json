{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"heading","content":["Bab-Jehová an-edarbedid"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Dule-sibad-wawaad-edarbedyobi, Bab-Jehová, an-edarbed gued.","poem":1},{"text":"Unniguar ibmar-nika an-imaked.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Igi sibad-wawaad gagan-ara-aradgi obunnomegisdae,","poem":1},{"text":"deyobi, Bab-Jehová egi-obunnogega an-imaked.","poem":2},{"text":"Degi, igi dule dii-boo-naidse sibad-wawaad-niddae,","poem":1},{"text":"deyobi, Bab-Jehová neg-bogidikidse an-niddaed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová an-san-burba anga ogannodaed.","poem":1},{"text":"Igar-innikimaladba an-seddaed.","poem":2},{"lineBreak":true},{"text":"Mer e-nug-isguega, deyob an-imakdaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ar neg-gudureged-sunnasulid-imbaba an nadapile, amba an dobguosulid.","poem":1},{"text":"Bab-Jehová, ar be anba gudisoggu, an akar-guosulid.","poem":2},{"text":"Be-suar-gaapoled an-niga-ogannoged,","poem":1},{"text":"dobsuli an-imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová, be an-isdarmalad-asabin, mas-bur-nued be anga ukdaed.","poem":1},{"text":"Be-nonikidi nued-an-be-dakye be anga-sogega, gwallu-wawad an-nonogi be eodaed.","poem":2},{"text":"Degi, igi gobed noggi-engudele, aryomaidae,","poem":1},{"text":"deyobi, an-ulubgi ise-weligwar an itodaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bab-Jehová, nue-napira bane-bane an-burgwedse wile be an-dakdii guoed,","poem":1},{"text":"an-burgwedse be angi nued-binsadii gubaloed.","poem":2},{"lineBreak":true},{"text":"Geb Bab-Jehová-neggine, degisadegu an maiguoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}