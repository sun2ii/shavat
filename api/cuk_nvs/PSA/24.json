{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":24,"content":[{"type":"heading","content":["Bab-Dummad napneg-naid-e-ibedid"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bela we-napneg-naidi, bela egi ibmarmar-bukwadi, Bab-Jehováʼgadid.","poem":1},{"text":"Bela yalagan-nanaidi, dulemar-egi-bukwadi, bela Bab-Dummadgadbiid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová, demar-naidgi napaneg onakwisad,","poem":1},{"text":"dii-wilagangi napaneg nasiksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"¿Doa Bab-Jehová-yarse nakoe?","poem":1},{"text":"¿Doa Bab-Jehováʼse-goled-neg-islidikidgi gudiguoe?","poem":2},{"text":"Unnila weyob-gudimaladbi gudii guoed:","poem":1}]},{"type":"verse","number":4,"content":[{"text":"Dule-ibmar-nueganbi-imaked,","poem":2},{"lineBreak":true},{"text":"dule-gwage-swilidikid,","poem":2},{"lineBreak":true},{"text":"dule-ibmar-bab-dummadyob-imaklemaladse-gordisulid,","poem":2},{"lineBreak":true},{"text":"yamo-ibmar-ise-sogar-imakdisulid,","poem":2},{"text":"amarbi unnila, Bab-Jehováʼse-goled-negse dogoed.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dule-deyob-daedgi, Bab-Jehová ise-nued-binsaoed,","poem":1},{"text":"Bab-Jehová-e-abonogedid ega nuedgi igar-nabogoed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Dummad, dule-be-amidimaladi, weyob damalargebed,","poem":1},{"text":"dulemar Jacob-e-Bab-Dummad-dakbi-gudimaladi, weyob nanamalargebed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yawagak-dummagan, be argamarsun,","poem":1},{"text":"yawagak-degisadegu-gwichimalad, be argamarsun,","poem":2},{"lineBreak":true},{"text":"we-yawagakgi, Rey Gandikidba-Yeerdakleged dogesokalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"¿We doawa, Rey Gandikidba-Yeerdakleged?","poem":1},{"text":"We-Rey, Bab-Jehová-Dule-Gandikidid, dule-buledid.","poem":2},{"lineBreak":true},{"text":"Bab-Jehová bila-onogedgi dule-buledid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yawagak-dummagan, be argamarsun,","poem":1},{"text":"yawagak-degisadegu-gwichimalad, be argamarsun,","poem":2},{"lineBreak":true},{"text":"we-yawagakgi Rey Gandikidba-Yeerdakleged dogesokalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"¿We doawa, Rey Gandikidba-Yeerdakleged?","poem":1},{"text":"We-Rey, Bab-Jehová-Bela-Gangued-Nika-Maidid.","poem":2},{"lineBreak":true},{"text":"We, Rey Gandikidba-Yeerdaklegedid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}