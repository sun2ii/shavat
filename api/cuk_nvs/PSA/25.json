{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":25,"content":[{"type":"heading","content":["Bab-Dummad be an-bendake"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼye, an be-bensuli","poem":1},{"text":"an bese goled.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"An-Bab-Dummadye, an begi bendakleged amied,","poem":1},{"text":"mer bingeguega be an-imake.","poem":2},{"lineBreak":true},{"text":"¡An-isdarmalad mer angi-dodoged be imake!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ar begi-bendakleged-amimalad bipisaar bingeguosulid,","poem":1},{"text":"dulemar igarsuli emargi-gwisgudimaladdi bingegumaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová, Be-Igarmar be anga oyoge,","poem":1},{"text":"Be-Igarmargi be an-odurdake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Be-Igar-innikigwadba be an-nide,","poem":1},{"text":"a-Igargi be an-odurdake.","poem":2},{"text":"Bedi, an-Bab-Dummad-an-abonogedid,","poem":1},{"text":"andi, gusgu beginbi bendakleged amied.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bab-Jehová, be-ebinsao, be wile-dule-dakedid, be dule-sabguedid.","poem":1},{"text":"Weyob be-daedi, anga be oyodiguad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"An sapingwaun isgudigusaddi, an begi-yolesaddi, mer be ebinsao.","poem":1},{"text":"Bab-Jehová, be-wile-dule-dakedba, wile be an-dako.","poem":2},{"lineBreak":true},{"text":"Bab-Jehová, ar bedi dule-nuedid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová dule-nuedid, dule-innikigwadid,","poem":1},{"text":"a-ular, dule-isganamarga igar-maid-imakega oyoged.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Jehová igar-innikigwadba dulemar-san-bipi-imakdimalad nied,","poem":1},{"text":"Bab-Dummad e-igargi dulemar-san-dummarba-imakdisurmalad odurdakbalid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Jehová-Igar-Mesisadba-ibsadimaladga, Bab-Jehová-Igar-Islidikid-Mesisadba-nanadimaladga,","poem":1},{"text":"bela Bab-Jehová-e-Igarmar, sabgued-igalad, napiragwad-igalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bab-Jehová, na be-nug-sabedba,","poem":1},{"text":"an-nue-isgusadi, be anga osuloge.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bab-Jehová, dule-e-dobee-nanadiidga oyogoed,","poem":1},{"text":"biti-igarba nanaoe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"A-dule, nued-gudii guoed,","poem":1},{"text":"e-wagandi nainumar gamaloed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bab-Jehová dulemar-e-nug-odummodimaladbo walikaa gued,","poem":1},{"text":"amarga e-igar-mesisad sogbalid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ar Bab-Dummaddi emar-yamoged-igargi an-ollorsaed.","poem":1},{"text":"A-ular, Bab-Jehováʼginbi an ataked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bab-Jehováʼye, be wile-an-dake,","poem":1},{"text":"andi walagwen gudiid, an wile itodiid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bab-Jehováʼye, an-suli-suli-itoged bur bule gangumaid.","poem":1},{"text":"An-bukib-binsadiid, be anga osuloge.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bab-Jehováʼye, an-ulubgi-naibi-itoged be dake,","poem":1},{"text":"an boniganba-galitodiid be dake.","poem":2},{"lineBreak":true},{"text":"Bela an-isgued be anga elie.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bab-Jehováʼye, be dake, ibiyobi an-isdarmalad mergusa,","poem":1},{"text":"bela-bela nue-isdar an-dakmalad.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"¡We-dulemar-idu be an-odukue!","poem":1},{"text":"¡We-dulemargi be an-ollorsae!","poem":2},{"text":"Mer bingegued be an-imake,","poem":1},{"text":"ar andi begi bensulid.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"An-ibmar-oakalossulid, an-inniki-daedi,","poem":1},{"text":"an-bendakedga gued. Ar andi begi bensulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"¡Bab-Dummadye, Israel-dulemar suli-suli-itogedgi, be bendake!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}