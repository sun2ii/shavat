{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"heading","content":["Innikidaedgi-sunmaklenaid"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼye, an-akar-akar-gudisulid be oyoge.","poem":1},{"text":"Begi an bengussulid,","poem":2},{"lineBreak":true},{"text":"begi gwen an bangussulid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehováʼye, be an-wilubdake,","poem":1},{"text":"an-ulubse be an-dake,","poem":2},{"text":"bela an-binsanaid be dake,","poem":1},{"text":"an-gwage-naid bela ulubse be dake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Be-sabed an nue wisid,","poem":1},{"text":"an be-igar-napiragwadba nanadiid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dule-galagwensurdamaladbali an nanadisulid,","poem":1},{"text":"wagar-darbodamaladbali an sigdisurbalid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dule-galagwensurdamalad an isdarsun-daked,","poem":1},{"text":"dule-isganamar an-aiga an imakdisulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"An ibmar-isganase-achadisulidba, an-argan swilidik gued.","poem":1},{"text":"Agala, an sunna nabir be-ibmar-ogumakleged-aila-ebirdii gued.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová, agi be-nug-odummogegala, an binnasur namakdii guoed,","poem":1},{"text":"be-ibmar-dakledisulid-imaksad-barsogegala, an binnasur gordii guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová, bese-gorleged-neggi-be-maidbina an nue-soged,","poem":1},{"text":"be-gargangued-oyomaid-negbina an nue-soged.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"An burgwisale, dule-galagwensulid-abargi, dule-gindakmalad-abargi,","poem":1},{"text":"mer megega be an-imako.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ar unnila, we-dulemar ibmar-isganabi imakdimalad,","poem":1},{"text":"emar-yardakedginbi binsadimalad,","poem":2},{"lineBreak":true},{"text":"manigi emar-binsaed-gaed gudimalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bab-Jehováʼye, andi innikigwadba gudiid.","poem":1},{"text":"Be an-bendake, wile be an-dake,","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ar an inniki nanadiid.","poem":2},{"text":"Bab-Jehová, dulemar-onmakmalad-abargi,","poem":1},{"text":"an be-nug-odummodii an guoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}