{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":27,"content":[{"type":"heading","content":["Bab-Jehová an-gwallu-meegwadid, an-abonogedid"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová anga burba-dulad ukedid, an-abonogedid.","poem":1},{"text":"¿An doa dobguosunna?","poem":2},{"text":"Bab-Jehová an-gandikidga gued.","poem":1},{"text":"¿An doase gwayosunna?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dule-isganamar an-obelogega angi gwisguarmargu, an-isdarmalad an-oburgwega angi gwisguarmargu,","poem":1},{"text":"aka bur amar burgwismalad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ar amba sordamar-bila-onoged, an-ebiris-bukwa-inigwele, andi an dobguosulid.","poem":1},{"text":"Amba angi bila-onolealile, andi an bukib-binsaosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Jehováʼse unni ibmar-soggwen an egichisad,","poem":1},{"text":"abi an abeged:","poem":2},{"text":"E-neggi-degisadegu-gudigued an abeged.","poem":1},{"text":"Adi, an Bab-Jehová-e-yeerdakleged dakega,","poem":2},{"lineBreak":true},{"text":"e-neggi ese gordii gubaligar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ar Bab-Jehová, ibagan-bulegangi na ese-goled-neggi an-odukuoed,","poem":1},{"text":"na e-neg-megedgi an-odukuoed,","poem":2},{"lineBreak":true},{"text":"akwasaila-birgi an-ogwichoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"A-sorbali, an-isdarmalad-an-ebiris-bukwamaladgi-nakwega an-imakoed.","poem":1},{"text":"Ese-goled-neggi, an e-nug odummogoed,","poem":2},{"lineBreak":true},{"text":"Bab-Jehováʼga andi namakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"¡Bab-Jehováʼye, an bese-goled, be itoge!","poem":1},{"text":"¡Be wile-an-dake, be an-abinsae!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"An-gwage anga-soge an itoged: “Be Bab-Jehová-amie.”","poem":1},{"text":"Bab-Jehová, an be-amied.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"¡Bab-Jehováʼye mer be angi dukue!","poem":1},{"text":"¡Mer be isdar-itogedgi be an-obane! Ar be an-bendakedid.","poem":2},{"text":"Bab-Jehová an-abonogedye, mer be walagwen an-obege,","poem":1},{"text":"mer be an-mete.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ar amba an-bab, degi, an-nan an-obachale,","poem":1},{"text":"Bab-Jehováʼdi an-suoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bab-Jehová, an-oburgwebimalad-ulale, be-igarba be an-nide,","poem":1},{"text":"igar-nueganba be an-idue.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bab-Jehová, an-isdarmaladga mer be an-urmake,","poem":1},{"text":"ar gakansaar-emar-barsogmalad, emar-sabsur-imakmalad, angi gwisgunanaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Degisoggu, an nue-wisimakaled,","poem":1},{"text":"an we-napneggi-gudiidgi Bab-Jehová-dulemargi-nued-binsamaid an dakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"¡Bab-Jehováʼgi mer be bengue!","poem":1},{"text":"¡Be gangue! ¡Be niga-gandik sae!","poem":2},{"lineBreak":true},{"text":"¡Eye, Bab-Jehováʼgi mer be bengue!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}