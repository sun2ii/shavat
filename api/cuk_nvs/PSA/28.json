{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":28,"content":[{"type":"heading","content":["Bab-Dummad ese wilesakwaa-goled itoged"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼye, an bese gole,","poem":1},{"text":"ar bedi an-bendakedga gued.","poem":2},{"text":"Bab-Dummadye, melle be an-itosuli gue.","poem":1},{"text":"Be an-itosulile, bato dule-burgwarmaladba, e-galuse-nadapiyob an guoed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehováʼye, an bese wilesakwaa-gotele,","poem":1},{"text":"bitigine, be an-itosana gadin.","poem":2},{"text":"Bab-Dummadye, an-bendakega an bese-gotele,","poem":1},{"text":"an bese-golega be-Neg-Ise-Islidikidsik argan onakwidele, bitigine, be an-daksana gadin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bab-Jehováʼye, dule-isgudimaladba melle be sabsur-an-wiogo,","poem":1},{"text":"dule-ibmar-isgana-imakdimaladba, melle be sabsur-an-imako.","poem":2},{"text":"We-dulemar, unnila asgi dule-baiganga nueganbi sunmakdidamalad.","poem":1},{"text":"E-gwage-ulubgindina, egi isdar-binsadidamalad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dule-isgudimalad e-ibmar-isgana-imakedba, e-galagwensuli-nanaedba, be buged imake.","poem":1},{"text":"Dule-isgudimalad e-ibmar-galagwensuli-imakedba, be buged sae.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ar Bab-Jehová-ibmar-imaksadgi bar binsasurgusmarsoggu,","poem":1},{"text":"Bab-Jehová-ibmar-imaksad baisur-dakarmarsoggu,","poem":2},{"text":"Bab-Jehová bela a-dulemar obelogoed,","poem":1},{"text":"baligannarse imakosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bab-Jehová-nug odummolesun,","poem":1},{"text":"an ese wilesakwaa-goled an-itosad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová, an-ogannogedid,","poem":1},{"text":"sigu-abgaedyob an-irwa-gwisguedid.","poem":2},{"text":"Bela-belad gwage-ulubgi an egi bensulid,","poem":1},{"text":"Bab-Jehováʼgi an bendaklesad.","poem":2},{"text":"An-gwage-ulubgi, bela-belad-weligwale an itoged,","poem":1},{"text":"an-namakedgi dog-nuedye an ega soged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová, na e-mimmiganga dule-gandikidga gued,","poem":1},{"text":"Bab-Jehová, na e-nuggi rey-nugsalegaledga abonoged-gandikidga gued.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Jehováʼye, be-dula be abonoge,","poem":1},{"text":"be-mimmigangi be ise-nued binsae.","poem":2},{"text":"Sibad-wawaad-edarbed e-sibad-edarbedyobi, be-mimmigan be edarbe,","poem":1},{"text":"degisadegu bendakdii be gusun.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}