{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"heading","content":["Bab-Jehová-e-gangued-yeerdakleged"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bemar baliwiturmar, Bab-Jehová-e-nug odummomar,","poem":1},{"text":"Bab-Jehová-e-ganguedgi, e-yeerdaklegedgi be sunmakmar.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová, Bab-Dummad-gued-ulale, e-nug be odummomar,","poem":1},{"text":"Bab-Jehová-e-neg-islidikidgi, be Bab-Dummad-nug ogannomar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová-sunmakedi muu-billigi gollomakemaid.","poem":1},{"text":"Bab-Dummad-Bela-Gangued-Nikad gollomakemaid.","poem":2},{"lineBreak":true},{"text":"¡Bab-Jehová muu-billi-dummad-birgi negsemaid!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová-sunmaked dutusur sunmaked,","poem":1},{"text":"Bab-Jehová-sunmaked dutusur goled.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová-sunmaked iksiwar-bibisged.","poem":1},{"text":"¡Líbano-Yar-e-iksiwarmar Bab-Jehová-sunmakedba bibisged!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Jehová, Líbano-yar, Sirión-yar ogiglimaked.","poem":1},{"text":"Moli-bebe-nikad-sapingana-ichomakeyob Bab-Jehová we-yarmar-oichomaked.","poem":2},{"text":"Moli-bebe-nikad-sapurbarmalad-ichomakeyob Bab-Jehová we-yarmar-oichomaked.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová-sunmaked ginnitibi milemaid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová-sunmaked nega-dulesulidgan ogiglimaked,","poem":1},{"text":"¡Bab-Jehová nega-dulesulidgan-Cadesʼye-nugad ogiglimaked!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Jehová-sunmaked sapi-encinaʼmar bibisged, sapurmar swanga nasiked.","poem":1},{"text":"Bab-Jehováʼse-goled-neggi bela-dulemar Bab-Dummad-nug odummomalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bab-Jehová dii-barigan-e-sailaga gued,","poem":1},{"text":"Bab-Jehová bela negsemai degisadeguoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Jehová na e-dulemarga gangued ukoed,","poem":1},{"text":"Bab-Jehová e-dulemarga bela neg-bogidikid nasiked.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}