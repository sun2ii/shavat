{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"heading","content":["Bab-Dummadse bensulidgi goled"]},{"type":"hebrew_subtitle","content":["David e-machi-Absalón-idu-wakindigu, we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"¡Bab-Jehová, an-isdarmalad dogdar mergued!","poem":1},{"text":"¡An-isdarmalad bukidar angi aibitemalad!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"An-isdarmalad bukidar an-annik sogmalad:","poem":1},{"text":"“Bab-Dummad bendakosulid.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová, bedi an-isdarmalad-idu, sigu-abgaedyob be an-irwa gwisguedid.","poem":1},{"text":"Be, an-ganguedid. Be, an-niga-ogannogedid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Jehováʼse binnasur an goled.","poem":1},{"text":"Na e-neg-islidikid-akale, an-abin-imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ar Bab-Jehová an-edarbedsoggu, an dobsuli meged, nue an gabed.","poem":1},{"text":"Neg-oibosale, bogidikidgi an gwisgued.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Degisoggu, an-isdarmalad miliambe (10,000) an-ebiris-bukwamalad, an dobsulid.","poem":1},{"text":"¡Bab-Jehováʼye, wis be an-itoge!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"¡Bab-Jehováʼye, be an-bendakdage!","poem":1},{"text":"¡Bab-Dummadye, an-isdarmaladgi be an-ollor-imakdage!","poem":2},{"text":"An-isdarmalad-e-akugar be sarsodage,","poem":1},{"text":"we-dule-isganamar-e-nugar be obatedage.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová, beginbi abonoleged danikid.","poem":1},{"text":"¡Be-sordamargi be nued-binsao!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}