{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":30,"content":[{"type":"heading","content":["An-wile-itoged, weligwaledga be imaksad"]},{"type":"hebrew_subtitle","content":["David, Bab-Dummadse-goled-neg-nugsalegega namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová, an be-nug ogannoged,","poem":1},{"text":"ar be an-bendaksad.","poem":2},{"lineBreak":true},{"text":"An-isdarmalad mer angi wergumalaga be imaksad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"An-Bab-Dummad-Jehová, an bese gochagu,","poem":1},{"text":"be an-nudaknonikid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová, an burgwedani-maigu,","poem":1},{"text":"be an-bendaknonikid.","poem":2},{"text":"Burba-dulad be anga uksad.","poem":1},{"text":"Mer burgwarmalad-abargi-megega, be gannar an-ogwisgusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bemar Bab-Dummad-e-sordagan, Bab-Jehováʼga be namakmar,","poem":1},{"text":"e-nug-islidikid be ogannomar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Dummad uludele, unnila sikwas-urwed.","poem":1},{"text":"Ar nued-emargi-binsaeddina, degisadeguad.","poem":2},{"text":"Ar mutikidba, boed nagunonidibe,","poem":1},{"text":"neg-oibosardi, wergued nagunonikoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Anga ibmar-nasgumaigu, an weyob sogsagusad:","poem":1},{"text":"“Bipisaale dule an-osikirmakosurye.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová, ar be-nued-angi-binsaedba, yar-dummad-siidyobi, ganna be an-osisad.","poem":1},{"text":"Be angi aibategua, suli-suli an itonaded.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová, an bese goled,","poem":1},{"text":"Bab-Dummadye, an bese ise-wilegar goled.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ar an burgwisale,","poem":1},{"text":"¿ibu-ibmar-nued egi amilegoe?","poem":2},{"text":"An neg-uanse diglenader,","poem":1},{"text":"¿ibu-ibmar-nued egi amilegoe?","poem":2},{"text":"¿Ar dule-burgwaledde be-nug odummogoe?","poem":1},{"text":"¿Ar dule-burgwaledde be-igar-innikigwad barsogoe?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Jehováʼye, be an-itoge, wile be an-dake.","poem":1},{"text":"Bab-Jehováʼye, ¡be an-bendake!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bab-Dummad, an-gwage-naibi-itonaid,","poem":1},{"text":"be weligwar imaknonikid.","poem":2},{"text":"An nunmaked-mor-yoid be anga ungenonikid,","poem":1},{"text":"weligwaled-mor be anga yononikid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bab-Dummad, degisoggu, an bega namaked,","poem":1},{"text":"be-nug-odummoged bar an galegosulid,","poem":2},{"lineBreak":true},{"text":"Bab-Dummad-Jehová, degisadegu, an bega dog-nuedye sogdii guoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}