{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":31,"content":[{"type":"heading","content":["Bab-Jehováʼgi bengusulid"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad. Namakmalad-e-iduedga soglenaid."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová, an begi bensulid.","poem":1},{"text":"Mer bingeguega be an-imake.","poem":2},{"lineBreak":true},{"text":"¡Be-igar-innikigwadgi, be an-bendake!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehováʼye, be an-itoge,","poem":1},{"text":"gwae be an-bendakdage.","poem":2},{"text":"¡Be an-akwasaila-gandikidyob gued,","poem":1},{"text":"be an-abonoged-gandikidyob gued!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová, be an-akwasaila-gandikid-dukuedid,","poem":1},{"text":"an-abonoged-neggandikidid.","poem":2},{"text":"Degisoggu, be-nug-sabed-ular,","poem":1},{"text":"be an-idue, be an-nide.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Jehováʼye, an-isdarmaladi emar-yamoged-igar-an-idu-mesismaladgi be an-ollor-imake,","poem":1},{"text":"ar bedi an-dukuedid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Dummad, be-argangi an-san-burba an uksun.","poem":1},{"text":"Bab-Dummad-Jehová-napiragwad, bee be an-abonosad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dule-ibmar-babyob-imakleged-e-nug-odummodimalad an isdar-daked.","poem":1},{"text":"Ar andi, Bab-Jehováʼgi bensulid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová, an be-sabguedgi yeer itoged,","poem":1},{"text":"an egi wergubalid.","poem":2},{"text":"Ar bedi an-ulubgi-naibi-itoged daksad,","poem":1},{"text":"an-ulubgi-surbinsa-itoged be wisid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová an-isdarmaladga be an-uksasulid,","poem":1},{"text":"be an-ollor-imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bab-Jehováʼye, wile be an-dake,","poem":1},{"text":"ar andi surbinsa-itoged.","poem":2},{"text":"An wile-itogedba an-ibya mommoleded,","poem":1},{"text":"an-abagan, an-ulub bela nunmaked.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"An-naibi-itogedba bela an-abagan nollomakded,","poem":1},{"text":"an bukib-binsaedbi birgamar onamaid.","poem":2},{"text":"An-isgued-ular, an-gangued bela berguded,","poem":1},{"text":"an-garmar bela nollomakded.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bela an-isdarmaladga an ibmar-dodogedga gued,","poem":1},{"text":"an-neg-dikarba-mamaid bur bule angi dodomalad.","poem":2},{"text":"Dulemar-magar-an-dakmalad an-dakalile, an-dobguddamalad,","poem":1},{"text":"¡Dulemar igarba an-abingualile, angi gwakiddamalad!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Burgwisayobi dulemar bar angi binsasulid,","poem":1},{"text":"nog-mamarisayobi an gunonikid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dulemar-bukidar emargi-gakansaar-sunmakmar an itoged.","poem":1},{"text":"An bia naddibe, an dobee itoged.","poem":2},{"text":"Ar dulemar angi-aibinega na atosmalad,","poem":1},{"text":"an-oburgwedgi binsamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Bab-Jehová, ar andi begi bensulid.","poem":1},{"text":"Andi soged: “¡Be an-Bab-Dummadye.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"An be-nugginbi gudiiye!”","poem":1},{"text":"An-isdarmaladgi, an-balegindimaladgi, be an-ollor-imake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bab-Jehováʼye, angi be nued binsae,","poem":1},{"text":"¡Be-sabgued-dummad-nikadba be an-abonoge!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bab-Jehováʼye, ar an bese gochasoggu,","poem":1},{"text":"mer bingeguega be an-imake.","poem":2},{"text":"Dule-isganamardi bingeguega be imake,","poem":1},{"text":"gaya-bogidiki burgwarmalad-meged-galugi be mese.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Dule-gakansilimar-e-gaya bogidik be imake.","poem":1},{"text":"Na san-dummarba-imakedba, dule-mesagwar-imakedba, dule-nuedgi ibmar-sabsur-sogdimalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Bab-Jehová, be-sabgued ibiyobi dungue.","poem":1},{"text":"Dule-be-nug-odummodimaladga, be-sabed be oyoged.","poem":2},{"lineBreak":true},{"text":"Dulemar-wagab, dule-begi-bengusurmaladga, be-sabgued be oyoged.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bab-Jehová, dule-nued dule-egi-isdar-binsaedgi, be-walik be odukued.","poem":1},{"text":"Dule-nued dule-urwedginbi-sunmakmaladgi, bese-goled-neg-sunna-selegedgi be odukued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Bab-Jehová-nug an odummosun.","poem":1},{"text":"Ar sordamar neggwebur-ebiris an-oburgwega bukwagusmargu, e-sabgued-dummad anga oyosad.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"An surbinsa-itogedba an sogde gusad: “Be-asabin bar be an-ogwisguosurye.”","poem":1},{"text":"Degi-inigwele, Bab-Jehová, an bese gochagua, bedi an-wilesakwaa-gornaid itosad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Bela-bemar-Bab-Jehováʼba-nanaid, Bab-Jehová-sabgumala.","poem":1},{"text":"Bab-Jehová, dule-ega-galakudisurmalad na edarbed.","poem":2},{"text":"Ar Bab-Jehová dule-na-san-dummarba-imakdimaladdi, sabsur-odurdaked.","poem":1}]},{"type":"verse","number":24,"content":[{"text":"Bela Bab-Jehováʼgi-bensurmalad gangumala, niga-ogannomala.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}