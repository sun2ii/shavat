{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":32,"content":[{"type":"heading","content":["Bab-Dummad isgued elied"]},{"type":"hebrew_subtitle","content":["David namaked narmaksad. We-namaked Masquilʼye nugad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová, dulega e-galagwensuli-gudigusad elisale, e-isgusad ega osulosale,","poem":1},{"text":"Bab-Jehová egi nued binsanonidaed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová, dulega e-isgudigusad bar insasuli gunonikile, egi-isgued-naid ega osulononikile,","poem":1},{"text":"Bab-Jehová egi nued binsanonidaed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Jehováʼga, an-isgued an sogsulidbali, bane-bane an akigindiidbali,","poem":1},{"text":"an-abagan galalemai guded.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mutikidbali, ibginedbali, sabsur be an-imaked.","poem":1},{"text":"Igi yorgi dutu dad-ibeler-abin dinguddae,","poem":2},{"lineBreak":true},{"text":"deyobi, an na itoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Geb degi, an-isgued na bega barsognonikid,","poem":1},{"text":"gwen an begi an-isgued odukussulid.","poem":2},{"text":"Weyob an sogsad: “Emi, Bab-Jehováʼga an-isgued an barsogoye.”","poem":1},{"text":"Agine, an-galagwensuli-gudigusad be elinonikid,","poem":2},{"lineBreak":true},{"text":"an-isgudi-gudigusad be anga osulononikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"A-ulale, dule-be-sogedba-nanadimaladi, suli-suli-itogedgi, bese gormalad.","poem":1},{"text":"Boni-dummagan-ainialile, ese warmakosulid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bee be an-odukuedid,","poem":1},{"text":"nega-bulegangi bee be an-edarbedid,","poem":2},{"lineBreak":true},{"text":"bendakleged-igarmargi-namakega, be an-imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová soged: “Ani an be-odurdakoed,","poem":1},{"text":"ani an bega sogoed, ibu-igarba be nanaoe,","poem":2},{"text":"ani an bega binsaed ukoed,","poem":1},{"text":"ani an begi nakuledii guoed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Igi moli, degi, moli-uayasuid, ibmar-akusunna itodamala, deyob melle be dao.","poem":1},{"text":"Ar wemardi, bese warmakmalaga, e-dukargi, dub-nasiklegergebed,","poem":2},{"text":"e-gayagi, e-gaya-bargaed nasiklegergebed.","poem":1},{"text":"Degisulile, bese warmakosurmalad.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dule-galagwensuli-nanadimaladi, ega gwage-nunmaked-dummad danikid.","poem":1},{"text":"Dule Bab-Jehová-abdakakwaa-gudimaladdi, Bab-Jehová ise-wile dakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bemar, dule-innikidamaladi, be weligwar-itomarsun,","poem":1},{"text":"Bab-Jehováʼgi be wergumarsun.","poem":2},{"lineBreak":true},{"text":"Bemar, dule-gwage-nuegan-gumaladi, bela yeer-itogedgi namakmarsun.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}