{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":33,"content":[{"type":"heading","content":["Bab-Jehová-napneg-nasiksad-nug odummoged"]},{"type":"verse","number":1,"content":[{"text":"Bemar, dule-ibmar-inniki-imakmalad, Bab-Jehováʼgi be wergumar.","poem":1},{"text":"Dule-nuegan, Bab-Jehová-e-nug-odummomalar, yeer itoledaed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová-nug gar-arpa-ogoledba be odummomar,","poem":1},{"text":"Bab-Jehová-nug gar-arpa-dub-giambe-nikadba (10) be odummomar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Namaked-binid Bab-Jehováʼga be namakmar,","poem":1},{"text":"Nue ega weligwaledgi gar be ogormar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ar Bab-Jehová-sunmaked, napiragwadid,","poem":1},{"text":"bela na e-ibmar-imakedi, napiragwadbiid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová, igar-innikigwad, igar-napiragwad nue-sabed.","poem":1},{"text":"Bab-Jehová-sabguedi, bela we-napneg-gasa naid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bab-Jehová na e-sunmakedginbi nibneg nasiksad,","poem":1},{"text":"na e-bunnogedginbi bela niisgwamar nasiksad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Dummadi demar-dummagan danar nasiksad,","poem":1},{"text":"ibmar-sabolegedyobi demar danar urbisad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bela we-napneggi-bukmalad Bab-Jehová-nug ogannomar.","poem":1},{"text":"Bela bemar-we-napneggi-bukmalad Bab-Jehová-nug odummomar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ar Bab-Jehová sunmaksagu, bela ibmar gunonikid.","poem":1},{"text":"Bab-Dummad igar-ukdegu, bela deyob gunonikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bab-Jehová, dule-yar-baid-baidgi-bukmalad-igar-amimalad-ibe ei igar bisged.","poem":1},{"text":"Dule-yar-baid-baidgi-bukmalad-igar-amimalad-ibe ei igar obured.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Jehová-ibmar-imakbieddi, degisadegu mai guoed.","poem":1},{"text":"Bab-Dummad-binsaed, degisadegu mai guoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dule-yar-baid-baidgi-bukmalad Bab-Jehová e-Bab-Dummadga imakmaladi, we-dulemargi nued binsalesad.","poem":1},{"text":"Bab-Jehová we-dulemar-egadga-imakegala na susad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bab-Jehová nibneg-akale atakmaid,","poem":1},{"text":"Bab-Dummad bela dulemar-dakmaid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bab-Jehová na e-maidgi atakmaid,","poem":1},{"text":"Bela we-napneggi-dule-bukmalad dakmaid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bab-Dummad bela dulemarga gwage nasiksad,","poem":1},{"text":"degisoggu, ulubgi-be-binsanaid be-wisid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Rey, na e-sordamar-ichesur-nikadba bendaklegosulid,","poem":1},{"text":"dule-dutusulid, na e-gangued-nikadba wakinnosulid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Moli, dutusur-inigwele,","poem":1},{"text":"bila-onogedgi e-ganguedba geg-dule-bendaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Bab-Jehová dule-e-dobee-nanadimaladgi nue nakuledaed,","poem":1},{"text":"dule-e-sabgued-edarbedimaladgi nue nakuledaed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bab-Jehová melle we-dulemar-burgwega bendakmaid,","poem":1},{"text":"ukud-dummad-nagunonikile, we-dulemar-bendakmaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Bab-Jehová, anmar begi bensulidgi be-edarbebukwad.","poem":1},{"text":"Bedi anmar-bendakedid.","poem":2},{"text":"Bedi sigu-abgaedyob be anmar-irwa gwisgudiid,","poem":1},{"text":"a-ulale, anmar begi bensulid.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Degisoggu, Bab-Dummad, begi anmar wergusunnad,","poem":1},{"text":"ar ade, anmar be-nug-islidikidgi bengussulid.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bab-Jehová, be-wile-anmar-daked,","poem":1},{"text":"anmar begi edarbediid.","poem":2},{"lineBreak":true},{"text":"Ar anmar begi bensulid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}