{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":34,"content":[{"type":"heading","content":["Bab-Dummad emar-bendakmaid"]},{"type":"hebrew_subtitle","content":["David yamo iwileyob na imaksagu, Abimelecʼse ononnolesgusad."]},{"type":"hebrew_subtitle","content":["A-ulale, David we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"An bane-bane Bab-Jehová-e-nug-odummodii an guoed,","poem":1},{"text":"an ega namakdii guoed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehováʼba an nug-dummarba itoged.","poem":1},{"text":"Deyob dule-na-san-dummarba-imakdisurmalad itononimaloed,","poem":2},{"lineBreak":true},{"text":"agi Bab-Jehováʼgi wergudmarmogoed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bemar an-balikwaa Bab-Jehová-e-nug odummomar,","poem":1},{"text":"anmar bela danakwaa e-nug odummomar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"An Bab-Jehová-amidigua, an-abin-imaknonikid.","poem":1},{"text":"An ibmar-dobgudiidgi, an-ollor-imaknonikid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dulemar Bab-Jehováʼse-idaksamaladi, egi gangunonimalad,","poem":1},{"text":"bipisaale bingeguosurmalad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani, an dule-wileged, an Bab-Jehováʼse-gochagu, an-itononikid,","poem":1},{"text":"agine, bela bonigangi an-ollor-imaknonikid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová-e-baliwitur dule-e-nug-odummodiid-bendakegala,","poem":1},{"text":"ese nonidaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bemar-sunnagwad be dakdamala,","poem":1},{"text":"Bab-Jehová-ibidar-nuedid be dakmala.","poem":2},{"text":"Dule, Bab-Jehováʼgi-bensurgudiid,","poem":1},{"text":"egi nued binsalediid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bemar Bab-Jehová-sordamar, Bab-Jehová-dobekwaa nanamar.","poem":1},{"text":"Dule-Bab-Jehová-dobekwaa-nanadimaladi, ibmarsuli-gudii guosurmalad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dule-mani-ibmala, dule-wilegedga nadmaloed, ukud-itodii gudmaloed.","poem":1},{"text":"Dule-Bab-Jehováʼgi-bensur-gudimaladdina, ibmarsuli-gudii guosurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mimmigan, dagmala, an-itodamala:","poem":1},{"text":"Bab-Jehová-dobekwaa-nanaedgi an be-odurdakmaloed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ar dule na wergudii gubiele,","poem":1},{"text":"iba-nuegangi weligwar nanadii gubiele,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ibmar-isganagi-sunmaked na bargaergebed,","poem":1},{"text":"gakansaar-sunmaked iegergebed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ibmar-isgana-imaked iegergebbalid,","poem":1},{"text":"ibmar-nuedbi imakergebed.","poem":2},{"text":"Neg-bogidikidbina gudiguergebed,","poem":1},{"text":"neg-bogidik-imakdii gubalirgebed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Bab-Jehová dule-inniki-gudimalad akwediid,","poem":1},{"text":"wemar-ese-goled nue-itodaed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dule-ibmar-isgana-imakmaladgindina, egi yoleged.","poem":1},{"text":"Bab-Jehová a-dulemargi yoleged,","poem":2},{"lineBreak":true},{"text":"adi, we-napneggi mer bar egi binsalegegar.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dule-inniki-gudimalad Bab-Jehováʼse-gotele, Bab-Jehová abin-imaked.","poem":1},{"text":"Bab-Jehová bonigangi dule-inniki-gudimalad nue-bendaked.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bab-Jehová dule-naibi-itodimaladba gudiid,","poem":1},{"text":"dule-bukib-binsadimalad nue-bendakbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Dule-inniki-gudiid, bonigan-bukidar nikued,","poem":1},{"text":"degi-inigwele, Bab-Jehováʼdina, bela a-bonigangi ollor-imakoed.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"We-dule-e-garmar akarguega imakosulid,","poem":1},{"text":"gwen wargwensaale e-ibe-bibislegega imakosulid.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Dule-isganamar ibmar-isgana-imakdimaladba na dukin wioged.","poem":1},{"text":"Ar dulemar dule-innikidamalad-isdardakdimaladi, odurdaklegedsemalad.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bab-Jehová dule-ega-arbadimalad nue bendaked,","poem":1},{"text":"Bab-Jehováʼgi-bengudisurmalad, sabsur-odurdaklegosurmalad.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}