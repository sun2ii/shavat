{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":35,"content":[{"type":"heading","content":["Bendaklegega, Bab-Dummadse-goled"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼye, angi-gwisgudimaladgi be gwichigue.","poem":1},{"text":"Angi-bila-onodimaladgi be bila-onoge.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová, be-sigu-abgaed-suid be sue,","poem":1},{"text":"an-bendakega be dage.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"An-balegindimalad-abin eswar be gae, akan be gae.","poem":1},{"text":"Ani an be-abonogedye be anga soge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"An-oburgwebimalad, bingegumarsun, neg-aku-ito gumarsun.","poem":1},{"text":"An-oakalobimalad, gannar sorsik namarsun, bingegus namarsun.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Amala, oros-e-uka burwa-abin-mileddaedyob gumarsun,","poem":1},{"text":"Bab-Jehová-e-baliwitur amar-baleginne.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"E-igar-nanaedi, ega negsichidyob gusun,","poem":1},{"text":"e-igar-nanaedi, ega gware-gwareyob gusun.","poem":2},{"lineBreak":true},{"text":"Bab-Jehová-e-baliwitur amar-baleginne.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gwen an ibmar-oakalossuli,","poem":1},{"text":"an-oburgwega, an-idu yaa akwismalad,","poem":2},{"lineBreak":true},{"text":"an-idu saki nasiksamalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Boni egi ukiagwar yolesunna,","poem":1},{"text":"na emar-yardakdiidgi, na dukin yardaklege.","poem":2},{"lineBreak":true},{"text":"Na yaa-akwismaladgi, na dukin argwanmala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Degidbali, Bab-Jehováʼgi an yeer itogoed,","poem":1},{"text":"an e-abonogedgi weligwar itogoed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Weyobi, binnasur an gotoed:","poem":1},{"text":"“Bab-Jehováʼye, ¿doa beyobi, dule-nollogwad dule-dutusulidgi bendake?","poem":2},{"text":"¿Doa beyobi, dule-wileged dule-e-ibe-ibmar-suedgi bendake?","poem":1},{"text":"¿Doa beyobi, dule-ibmar-abediid, dule-e-ibe-ibmar-suedgi bendake? Dule beyobid sated.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dule-barsogmalad-isganamar angi gwisguarmalad,","poem":1},{"text":"an-ibmar-wissulid anse egismalad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Andi wemargi nueddaed,","poem":1},{"text":"emardi, angi ichakwadamalad.","poem":2},{"lineBreak":true},{"text":"Weyob-damalad ulubgi nunmak an-imaked.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ar wemar uellemaigusgu, andi nue-bukib eba itodii gusad,","poem":1},{"text":"andi wile-itoged-mor-yoi gudii gusad.","poem":2},{"text":"Ulubgi-naibi-itogedba an mas guchasulid,","poem":1},{"text":"an ega Babse-goled gwen bogigussulid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"An-ai-burgwisayobi, an-gargwenad-burgwisayobi,","poem":1},{"text":"an bukib-itodii gusad.","poem":2},{"text":"An-nan-burgwisayobi, an bodii gusad.","poem":1},{"text":"An ulubgi-naibi-itogedba, an bukib-binsadii gusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"An sabsur-wilesgu, emardi yeer-itosmalad, na atosmarbalid.","poem":1},{"text":"Dule-isganamar aku-an-dakmaladyobi, angi aibinmalaga na atosmalad,","poem":2},{"lineBreak":true},{"text":"an-san goa-goa imaknaidbi gusmalad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Sabsur-an-imaknanai gusmalad,","poem":1},{"text":"angi dodonanai gusmalad,","poem":2},{"lineBreak":true},{"text":"isdar-an-dakmaladba anse uludmalad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bab-Jehová, ¿sanagwadse be we-dulemar yeerdakoe?","poem":1},{"text":"Dulemar-an-gindakbiedgi be an-bendake,","poem":2},{"lineBreak":true},{"text":"dulemar achumigur-nono-wawaadyob an-obelobiedgi be an-bendake.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Dulemar-bukidarad-abargi, an bega dog-nuedye sogoed.","poem":1},{"text":"Dulemar-bukidarad-abargi, an be-nug odummogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"An-isdarmalad-angi-aibindimaladi, mer angi wergumala.","poem":1},{"text":"Binsa-isdar-an-dakdimaladi, mer angi dodomala.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ar wemar neg-bogidik-nasikedgi sunmaksurmalad,","poem":1},{"text":"unnila dulemar-gwage-eikwaa-damaladgi gakansaar sunmakmalad.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Anga ise-allar allemalad, sogmalad:","poem":1},{"text":"“¡Anmar-sunnad anmar e-isgusad daksamarye!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"¡Bab-Jehová, bela be daksad!","poem":1},{"text":"¡Mer be gayamaklege!","poem":2},{"lineBreak":true},{"text":"¡Mer be angi bangue!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"An-Bab-Dummad-Jehováʼye, anga igar-innikigwad-imakega be dage,","poem":1},{"text":"an-arsogega be dage.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"An-Bab-Dummad-Jehováʼye,","poem":1},{"lineBreak":true},{"text":"be-igar-innikigwadba be anga igar naboge.","poem":1},{"text":"¡We-dulemar mer angi dodomalaga be imake!","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mer weyob binsamalaga be imake:","poem":1},{"text":"“¡Anmar weyopira dakbigusye!”","poem":2},{"text":"Mer weyob sogmalaga be imake:","poem":1},{"text":"“¡Anmar we-dule obelosye!”","poem":2}]},{"type":"verse","number":26,"content":[{"text":"An-sabsur-wilesadgi bela yeer-itodimaladi, bingegumala,","poem":1},{"text":"neg-aku-itodii gumala.","poem":2},{"text":"Dulemar angi bur san-dummarba-itodimaladi, bela-bela bingegumala,","poem":1},{"text":"nug-bipii gumala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Anba-nanaimalad, binnasur namakmar, wergumar.","poem":1},{"text":"Sogdii gumarsun: “Bab-Jehová-e-nug odummolesunye,","poem":2},{"lineBreak":true},{"text":"Bab-Jehová e-mai-gwage-bogidikid yeerdakye.”","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Be-igar-innikigwadgi an sunmakoed,","poem":1},{"text":"bane-bane an be-nug-odummodii gudoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}