{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":36,"content":[{"type":"heading","content":["Bab-Dummad-dule-wiledaked"]},{"type":"hebrew_subtitle","content":["Bab-Dummad-e-mai-David we-namaked narmaksad. Namakmalad-e-iduedga soglenaid."]},{"type":"verse","number":1,"content":[{"text":"Dule-Bab-Dummadgi-isgudiid weyob soged: “Isgudiid an yeer-itoged.”","poem":1},{"text":"Bab-Dummad-dobe-nanaodeeye gwen binsasulid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dule-isgana e-nug-odummolegoye binsaed,","poem":1},{"text":"e-isgued akudaklegoye binsaed.","poem":2},{"lineBreak":true},{"text":"Bab-Dummad ega akar-sogosurye binsaed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"E-sunmaked, galagwensuli sunmaked,","poem":1},{"text":"gakansaale sunmaked.","poem":2},{"text":"Dule-binsaedsulidga naded,","poem":1},{"text":"ibmar-nued-imaked ieded.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Megidele, isgued-imakedginbi binsamegisdaed.","poem":1},{"text":"Igar-nued-imakedgi gwen binsadasulid.","poem":2},{"lineBreak":true},{"text":"Isguedgi bangugwelodeeye gwen binsadasulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová, be-sabguedi bela nibnegse warmaked,","poem":1},{"text":"be-innikidaedi, bela mogir-billise warmaked.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Be-igar-innikimaladi, yala-dummagan-gandik-bukwadyob gued.","poem":1},{"text":"Muu-billi-wilasaila-naibayobi, be-igar-nabomalad mamaid.","poem":2},{"lineBreak":true},{"text":"Bab-Jehová, bela be dulemar-akwemaid,","poem":1},{"text":"bela be ibdurgan-bukwadi, akwemaibalid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Dummad, ibibayobi bedi bela-belad wile dule-dakmai.","poem":1},{"text":"Gannir e-mimmigan e-sakan-urba-odukueyob,","poem":2},{"lineBreak":true},{"text":"dulemar begi bendakleged amied.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Be-neggi ega be mas-obineba-ukmaidgi, nue immelebukwad,","poem":1},{"text":"be-dii-nued-ariomaidgi nue-immelebukwa be imaked.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ar beginbi, san-burba-geg-bergued danikid.","poem":1},{"text":"Anmar unnila beginbi, san-burba-dula-gued amied.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bab-Dummad, dule-beba-ibmar-imakdimaladi be wiledaksun.","poem":1},{"text":"Dule-gwage-nuegan, be-igar-innikigwadba be bendaksun.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dule-san-dummarba-imakdimaladi, melle an-ogalakuega be sao.","poem":1},{"text":"Dule-isgudimaladse, melle galakuega be an-imako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nue be dakmar, dule-isgudimaladi, igarga gudasulid.","poem":1},{"text":"Galakuddamalad, gege bar igarga gudamalad.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}