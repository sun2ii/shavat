{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":37,"content":[{"type":"heading","content":["Dule-isganamar bergumaloed"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Dule-isganamar-nasgumaidba mer be sae itoge,","poem":1},{"text":"Dule-isganamargi mer be nobgue.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ar we-dulemar gaganyobi emiskwaa bergudmaloed,","poem":1},{"text":"gagan-dinguddaedyobi emiskwaa surgudmaloed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Jehováʼgi mer be bengu, ibmar-nuegan be imake.","poem":1},{"text":"We-napneggi galakusuli be gudii guoed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Jehováʼgi be nue-wergudii sae.","poem":1},{"text":"Ar be ibmarbina-sogdiid, Bab-Dummad bega ukoed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Be-ibmar-imakbied, Bab-Jehováʼga be uke.","poem":1},{"text":"Mer be Bab-Jehováʼgi bengue,","poem":2},{"lineBreak":true},{"text":"ar Bab-Jehová bega ibmar imakoed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Igar-maidba be-ibmar-imakedi, Bab-Dummad bega dad-ibeleryob odalogoed.","poem":1},{"text":"Deyobi dule bela magar daknonikoed,","poem":2},{"text":"bede, dule-napiragwadid,","poem":1},{"text":"bede, igar-maidba ibmar-imakedid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bab-Dummad-asabin bogidik-gudii be imake.","poem":1},{"text":"E-bega-ibmar-imakedse edarbedii be sae.","poem":2},{"text":"We-dule-ibmar-isgana-imaked nasgumai be dakele,","poem":1},{"text":"mer be sae-itogo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Be-isdar-itoged na be bargae,","poem":1},{"text":"be-sae-itoged be iege.","poem":2},{"text":"Melle be urwe,","poem":1},{"text":"abakalegi be neg-oichoalile.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ar dule-isganamar burgwemaloed.","poem":1},{"text":"Dule-Bab-Jehováʼgi-ibmar-edarbedimaladdi, neg-nued-bonisulid ega uklegoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dule-isganamar napi-ichee gudidimalad.","poem":1},{"text":"Ar a-dulemardi be-amidigumaloen-inigwele, gwen be-amiosurmalad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar dule-san-dummarba-imaksurmalad neg-nued-bonisulid egadga guoed,","poem":1},{"text":"amala bela nue-nasgumaidbali, weligwar itomaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dule-isgana dule-nuedgi sunnasur binsadaed.","poem":1},{"text":"Dule-isgana dule-nued-dakdele, bela-bela nue-sae dakdaed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Degi-inigwele, Bab-Jehováʼdi dule-isganaga alloed,","poem":1},{"text":"ar wisid, we-dulemar-bergued bato ese warmaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dule-isganamar, dule-wilegana-oburgwega, dule-nued-nanamalad-ogilogega, e-es-suid ononanaid,","poem":1},{"text":"e-sigumar guagwar ebisbukwamalad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Degi-inigwele, e-es-suid e-gwagegi yolegoed,","poem":1},{"text":"e-warsimardi ei bibislegoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dule-nued ibmar-ichee-nikale,","poem":1},{"text":"dule-isgana-ibmar-bukidar-nikadba, bur nuedid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ar Bab-Jehová, we-dule-isganamar-e-gangued ei osulogoed.","poem":1},{"text":"Dule-igar-inniki-imakmaladdi bendakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Bab-Jehová, dule-inniki-nanadimalad-edarbediid.","poem":1},{"text":"A-dulemarga ibmar-uklegoedi, degisadegu egadga guoed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Dule-inniki-nanadimaladga ibagan-bulegan-noni-sogele, akar-guosulid.","poem":1},{"text":"Ukud-dummad nagunonikile, mas-nika guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dule-isganamardi, bergudmaloed.","poem":1},{"text":"Bab-Jehová-isdarmaladdi, gagan-burgweyobi burgwidmarmogoed.","poem":2},{"lineBreak":true},{"text":"Waayob bergudmaloed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Dule-isganamar aimargi mani-gasale, bar bennukdasulid.","poem":1},{"text":"Dule-nueddi dule-wiledakedba aimarga ibmar ukdedaed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Dulemar Bab-Jehováʼse-nabir-binsalesmaladi, neg-nued egadga guoed.","poem":1},{"text":"Dulemar Bab-Jehováʼse-ukabsalesmaladdi, girgumaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Dule-wargwen e-daedgi Bab-Jehová-yeer-ito imakele,","poem":1},{"text":"Bab-Dummad we-dule-nued-nanadii imaked.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Dule-nued gwatirnoni-sogele, deyob degisadegu gudii guosulid,","poem":1},{"text":"ar Bab-Jehová we-dule-bendakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"An sapingwa-danikid-akale, an seredgusadse, an dakdisulid, dule-nuedi nue-dummad-wiledii,","poem":1},{"text":"e-mimmigan mas-egisdii an dakdisulid.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Dule-nuedi aimarga ibmar-ukalile, nuedgi yeer-itogedba ukdedaed.","poem":1},{"text":"E-mimmigan ega ibnuedga gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ibmar-isganagi be bangu,","poem":1},{"text":"ibmar-nueganbi be imakdii gue.","poem":2},{"text":"Ar deyob be imakele,","poem":1},{"text":"Bab-Dummad bega-yar-ukoye-sogsadgi degisadegu be gudii guoed.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ar Bab-Jehová igar-inniki-imakleged yeer dakdaed,","poem":1},{"text":"dule-eba-nue-nanadiidgi, bangusulid,","poem":2},{"text":"Bab-Jehová amar-nue-edarbedidaed.","poem":1},{"text":"Dule-isganamardi, bergumaloed,","poem":2},{"lineBreak":true},{"text":"gwen wagan-nikuosurmalad.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Dule-nuegan-damaladdi, Bab-Dummad ega yar-ukoye-sogsadgi","poem":1},{"text":"degisadegu mai gumaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Dule-nued sunmakdele, nue-binsaed-nikaa sunmakdedaed,","poem":1},{"text":"Dule-nued sunmakdele, igar-inniki-maidba sunmakdedaed.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"E-Bab-Dummad-igar-maid e-gwagegi sedidaed.","poem":1},{"text":"A-ulale, isgusurdaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Dule-isgana dule-nued-oburgwega","poem":1},{"text":"arbakee dule-nued-argadidaed,","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Degi-inigwele, Bab-Jehováʼdi dule-isganaga dule-nued-urmakosulid.","poem":1},{"text":"Dule-nuedga igar-itolear-sogele, egi isgusye-sogega imakosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Bab-Jehová-abdakdii be gue,","poem":1},{"text":"a-sogedba be nanadii gue.","poem":2},{"text":"Bab-Jehová be-nug-odummogoed,","poem":1},{"text":"neg-nued begadga-guegala, bega ukoed.","poem":2},{"lineBreak":true},{"text":"Dule-isgana-bergumaloedi, be-sunnad be dakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"An dule-isgana daksad,","poem":1},{"text":"urwar-sapi-dummad-neg-ganikidyob, na san dummarba imaked.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Degi-inigwele, we-dulemar emiskwaa bergudoed.","poem":1},{"text":"We-dulemar bato sulibinne dakledagoed.","poem":2},{"lineBreak":true},{"text":"Be amialile, be dakosurguoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Dule-nuegan-damalad be dake,","poem":1},{"text":"dulemar igar-maidba-damalad be dake.","poem":2},{"lineBreak":true},{"text":"We-dulemar-nueddamaladga igar-nued ega maid.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Ar dulemar igar-maidgi-yoledimaladdi, bela burgwemaloed,","poem":1},{"text":"Dule-sunnasur-damaladdi, bela bergudmaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Dule-nuegan-damalad-e-bendakleged Bab-Jehováʼgi danikid.","poem":1},{"text":"Ibagan-suli-suli-itogedgi, Bab-Jehová dule-nuegan-bendakedga gued.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Bab-Jehová bonigangi dule-nued-bendakoed,","poem":1},{"text":"ar Bab-Jehováʼgi bensuli-gudii gusad.","poem":2},{"text":"Bab-Jehová dulemar-isganagi we-dule-onogoed,","poem":1},{"text":"dulemar-isganagi bendakoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}