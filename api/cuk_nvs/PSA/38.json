{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":38,"content":[{"type":"heading","content":["Dule-isgusad Bab-Dummadse-gornaid"]},{"type":"hebrew_subtitle","content":["Ibmar-ukleged-ebinsalegega, David we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼye, mer be anse urwe.","poem":1},{"text":"Be sae-itogedgi, mer be sabsur an-imake.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Be sabsur-angi-uludedba an naibigunonikid,","poem":1},{"text":"be angi sabsur-gwisgunonikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"An-isgusad-ular, be anse uludedbali, an-san bar nuedsulid,","poem":1},{"text":"an-garmar bar nuedsulid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"An-isgued bela an-nonogagas naid,","poem":1},{"text":"ibmar-aidikidyob angi signonikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"An binsaedsuli gudigusad-ulale, an-sanse-bakale, nunusar yapangusad,","poem":1},{"text":"bela sibudik-sibudikgusad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nue-ibitos itoleged,","poem":1},{"text":"bela-bela an oitolesad,","poem":2},{"lineBreak":true},{"text":"nue-wiles itoleged.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bela-bela an uedik itoged,","poem":1},{"text":"an-san bela ibitosad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nue geggus itoleged, nunumakesar itolegusad.","poem":1},{"text":"An gwage-nunmaked-dummad nue-itonaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bab-Dummad, an-ibmar-abeged bela be wisid,","poem":1},{"text":"an-ibmarbina-gudiid begi dukunaisulid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"An-gwage sabesur dik-dik-naid,","poem":1},{"text":"an-niga argwated,","poem":2},{"lineBreak":true},{"text":"nue an ataksurgusad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"An bonigan-nikadba, an-aimar, an-sordamar, angi bangudmalad.","poem":1},{"text":"An-gwenadgan angi deyob bangudmarmogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"An-oburgwebi-gudimaladi, an-yardakega angi arbananaid.","poem":1},{"text":"An-oitomaloye-sogdimaladi, an-yardakega arbakee bane-bane igar-aminanaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Degi-inigwele, uayasuliyob an imaksad,","poem":1},{"text":"yamo amar-itonaisuliyob an imaksad.","poem":2},{"text":"Amar-abin an sunmaksasulid,","poem":1},{"text":"wissur-sunmakeyob an imaksad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Degisoggu, dule-uayasulidyob an gued,","poem":1},{"text":"wissur-emar-abinsaedyob an gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Bab-Jehová, unnila an beginbi ibmar-edarbediid.","poem":1},{"text":"An-Bab-Dummad-Jehová, bebi unnila wemar-abin-imakoed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Unnila ibmar-soggwen an egised:","poem":1},{"text":"An ailanonikile, mer anga allemalaga be imako,","poem":2},{"lineBreak":true},{"text":"mer angi burgumalaga be sao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Nue an galakue itoged,","poem":1},{"text":"ibmar-nunmaked gwen-an-indakbisulid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Degisoggu, an-isgusad an na barsogergebed,","poem":1},{"text":"an isgusadba nue-wiles an itoged.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"An-isdarmaladdina nue baligannosmalad,","poem":1},{"text":"yogasaar-isdar-an-dakdimaladi nue mergusmalad.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"An ibmar-nued-imaked-ular, dulemar angi yolenanaid.","poem":1},{"text":"An ibmar-nued-imaked-ular, dulemar angi gwisgunanaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Bab-Jehováʼye, mer be an-barmete,","poem":1},{"text":"an-Bab-Dummadye, mer be angi bangue.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Gwae be an-bendakdage,","poem":1},{"text":"Bab-Dummad, be an-abonogedid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}