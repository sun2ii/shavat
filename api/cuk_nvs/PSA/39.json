{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":39,"content":[{"type":"heading","content":["Unnila-sikwas-gudigued"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad. Namakmalad-e-idued-Jedutúnʼga soglenaid."]},{"type":"verse","number":1,"content":[{"text":"An na dukin sogsad: “An itoakwaa nanadii imakoye,","poem":1},{"text":"adi, an-sunmakedgi mer an isguegar.","poem":2},{"lineBreak":true},{"text":"Ar dule-isgana an-asabin gwichile, andi ibmar-sogosulid.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Degisoggu, an sunmaksasulid, ar ibmar-nuedse-bakale, bar an bissulid.","poem":1},{"text":"Degi-inigwele, nunmakeddi anga ulubgi nasgumai gusad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"An-gwagedi uelleded.","poem":1},{"text":"An we-ibmargi-binsasiidgi an isdar itoded, geb an sogdesunnad:","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Bab-Jehová, an-ibagan-berguoed be anga soge,","poem":1},{"text":"birgabigwa an napi-dulagudiguoed be anga soge,","poem":2},{"lineBreak":true},{"text":"adi, an sikwas-gudiguoed magar itogegar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová, wis-ichee-dulagudigued be anga uksad,","poem":1},{"text":"an-birga-nikaddi be-asabinni birgamar-nassuliyob be daked.","poem":2},{"text":"We gakansulid, bela-dulemar-gudidiid","poem":1},{"text":"sikwas-bunnogedyob gudidimalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"”Ar napiragwad, anmar we-napneggi unnila sikwas gudimalad.","poem":1},{"text":"Dule binsarsunna sulibinsa itodiid.","poem":2},{"text":"Ar binsa na ibmar-nuegan saboged,","poem":1},{"text":"ar wissulid, doa we-ibmar sunonikoe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"”Bab-Jehováʼye, degisoggu, ¿bia an bendakleged amiosunna?","poem":1},{"text":"Unnila an beginbi bendakleged amied.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Jehováʼye, bela an-isguedgi be an-ollorsae,","poem":1},{"text":"mer dule-binsaed-nikasurmalad angi-dodomalaga be imake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"”An bar sunmaksasulid, an bar ibmar-sogsasulid,","poem":1},{"text":"ar bee be deyob ibmar imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Bab-Jehováʼye, mer bar be sabsur-an-odurdake,","poem":1},{"text":"ar be an-oburgwednaga an-imaknaid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Be dule-isgued-sabsur-odurdakedba dule-nudaked,","poem":1},{"text":"na bur e-ibmar-binasoged uduyob be e-ibe obeloged.","poem":2},{"text":"We gakansulid, bela-dulemar-gudidiid,","poem":1},{"text":"sikwas-bunnogedyob gudidimalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"”Bab-Jehováʼye, an bese-goled be itoge,","poem":1},{"text":"an bega-ibmar-soged be itoge,","poem":2},{"lineBreak":true},{"text":"an-boed mer be itosuli gue.","poem":2},{"text":"Andi bega dule-ainebalid gued,","poem":1},{"text":"bela an-dadgan-nanadigusadyobi an yar-obak-obak gudiid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mer isdar be an-dake.","poem":1},{"text":"An we-napneggi-naed-iduar, an gannar weligwar itogoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}