{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"heading","content":["Bab-Dummadse wilesiid"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad. Namakmalad-e-iduedga soglenaid:"]},{"type":"hebrew_subtitle","content":["We-namakleged, Neginotʼba namaklegoye."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummad, igar-bulegan-idu be an-irwa-gwisguedid.","poem":1},{"text":"An bese gotele, bitigi be an-itosana gadin.","poem":2},{"text":"Bab-Dummadye, an suli-suli itoged,","poem":1},{"text":"wis be an-bendake.","poem":2},{"text":"Wile be an-dake.","poem":1},{"text":"An bese-goled be an-itoge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Emide, ¿sanagwadse bemar, an-nug-oichodiidi, iemaloye be soge?","poem":1},{"text":"¿Sana be ibmar-igarga-gwen-guosulidgi-alamakdimaladi, be iemaloye soge?","poem":2},{"lineBreak":true},{"text":"¿Sana be gakan-igarba-nanamalad, be iemaloye soge?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Be itomar, dule-Bab-Jehováʼba nue-nanadiile, Bab-Dummad, a-dulebina itogerba daed.","poem":1},{"text":"A-ular, Bab-Jehováʼse an gotele, an-itodaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Be sae-itoalile, nue salakarmar. Melle Bab-Dummadgi isgumalo.","poem":1},{"text":"Mutik be gabesokalir, bogidik be-ulubgi, be ibmar-imaksadgi nue-binsamai samalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bab-Dummad-bese-ibmar-napiragwad-egismaidba Bab-Dummadga be ukmalo.","poem":1},{"text":"Melle Bab-Jehováʼgi be bengumalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bukidar dulemar sogdidinanaed:","poem":1},{"text":"“¿Wede doa anmarga ibmar-nued wis oyogoe?”","poem":2},{"text":"Bab-Jehováʼye, wis be anmarga ibmar-nued oyoge,","poem":1},{"text":"be-sabgued be anmarse-oyoge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dulemar bukidar-masgunned-nikale, gobed-nikale, na weligwar itodidamalad.","poem":1},{"text":"Bab-Dummad, bedi a-dulemarba bur bule weligwar-itogega be an-imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová, ar bebi unnila an-edarbedisoggu, dobsulidgi an megidoed,","poem":1},{"text":"bogidikidgi an gabidoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}