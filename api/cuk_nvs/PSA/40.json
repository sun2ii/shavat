{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":40,"content":[{"type":"heading","content":["Bab-Dummad isguedgi an-ollor-imakedid"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad. Namakmalad-e-iduedga soglenaid."]},{"type":"verse","number":1,"content":[{"text":"Ulubgi-abitoakwaa, Bab-Jehová-abdakdii an gusad.","poem":1},{"text":"Ansik aibilisad, an ese-goledi, magar an-itosad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"San-burba-bergued-galu-yagi an-onosad,","poem":1},{"text":"nega-matagangi an-onosad.","poem":2},{"text":"Akwasaila-birgi an-ogwisgusad,","poem":1},{"text":"nega-nuedgi an-ogwisgusad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová an-gwabindukugi namaked-gwapid nasiksad,","poem":1},{"text":"e-nug-ogannoedgi-namakega an-imaksad.","poem":2},{"text":"Deyob an-dakarmargua, bukidar dobe itodmalad,","poem":1},{"text":"Bab-Jehováʼgi bensuli gudmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dule, Bab-Jehováʼgi-bensuliguedi, Bab-Jehová egi nued binsadiid.","poem":1},{"text":"Dule, san-dummarba-samalad-barwisodisulidi,","poem":2},{"text":"bab-dummad-baidse-gormalad-barwisodisulidi,","poem":1},{"text":"Bab-Jehová egi nued binsadiid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"An-Bab-Dummad-Jehováʼye, ibibayobi ibmar-dakledisurmaladi be imaksa.","poem":1},{"text":"Ibibayobi be anmargi nued binsasa.","poem":2},{"text":"¡Dule beyobid sulid! Aisaar an bega bela be-ibmar-imaksad sogbienad.","poem":1},{"text":"Igi an bega sogergebele, ar gege bela bega sogleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bega-ibdula-uklemalad gwen be abessulid,","poem":1},{"text":"bega-ibmar-gwag-gullemalad-ukleged gwen be abessurbalid.","poem":2},{"text":"Unnila beba-ibsaega be an-imaksad.","poem":1},{"text":"Bega-ibdula-ogumakar-uklegedi,","poem":2},{"text":"isgued-eliega ibdula-uklegedi,","poem":1},{"text":"gwen be egichissulid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"A-ulale, an sogdesunnad:","poem":1},{"text":"“Bab-Dummad, be-gardagi angi-narmakar-maiyob an danisun.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Dummad, an be-sogedba ibmar-imakedi ibiyobi an yeer-itodae.","poem":1},{"text":"Be-Igar-Mesisadi an-gwage-ulubgi an sediid.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dule-bukidarmalad-abargi an be-igar-napiragwadgi sunmakdiid.","poem":1},{"text":"Bab-Jehová, bedi nue an-wisid","poem":2},{"lineBreak":true},{"text":"be-igarba-sunmakedi an gwen boggudisulid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Be-igar-napiragwadi dulemarga an gwen odukudisulid.","poem":1},{"text":"Be-innikidaedgi, be-abonoleged-igargi, an obinmakdiid.","poem":2},{"text":"Bipisaale, dule-bukidarmalad-abargi be-sabguedi,","poem":1},{"text":"be-igar-napiragwadi, an gwen odukudisulid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Jehováʼye, melle be-sabguedi be angi obano.","poem":1},{"text":"Be nue-an-sabedgi, be-igar-napiragwadba, be an-sedii guo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Isguedi bukidar an-ebiris naid,","poem":1},{"text":"isgued bukidarsoggu, gege na bega bela bied.","poem":2},{"text":"Isgued angi dar nue obined,","poem":1},{"text":"an akusunna-itogusad.","poem":2},{"text":"Isgued an-sailagiaganba bur bule mergued,","poem":1},{"text":"bar-gannarbaa an itosurgusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bab-Jehováʼye, we-isguedgi wis be an-onodage.","poem":1},{"text":"Bab-Dummadye, gwae be an-bendakdage.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dule-an-obelobimaladi be obingegsae,","poem":1},{"text":"akusunna ibmar-itogega be imake.","poem":2},{"text":"Dule-an-oichobigudimaladi, binged-abargi duurmakemai be sae.","poem":1}]},{"type":"verse","number":15,"content":[{"text":"Dule-an-wagar-daksuli an-dikarba-sunmakdimaladi, bingedar-itogwichi be imake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dule-be-amidimaladi, begi wergumarsun,","poem":1},{"text":"begi yeer-itomarsun.","poem":2},{"text":"Dule-abonoleged-igarbina-nue-sogdimaladi, weyob sogdii gumarsun:","poem":1},{"text":"“¡Ibiyobi Bab-Jehováʼdi dule-gandikid guye!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Bab-Jehováʼye, melle be an-iego,","poem":1},{"text":"andi dule-wilesa gudiid,","poem":2},{"lineBreak":true},{"text":"ibmar-abesa garmakdiid.","poem":2},{"lineBreak":true},{"text":"Bab-Dummad, bee be an-bendakedid, igar-bulegangi bee be an-onogedid.","poem":1},{"text":"Bab-Dummadye, melle be undar-yogguo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}