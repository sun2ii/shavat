{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":41,"content":[{"type":"heading","content":["Nailikgued-anga-osuloye Bab-Dummadga soged"]},{"type":"hebrew_subtitle","content":["David, namakmalad-e-iduedga we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Dule, dule-wileged-bendakedgi binsaele, Bab-Jehová, a-dulegi nued-binsaed.","poem":1},{"text":"Ar ade, ibagan-isgana ega nagunonikile, Bab-Jehová we-dule-bendakoed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová we-dule-edarboed,","poem":1},{"text":"we-napneggi dula-gudii imakoed,","poem":2},{"text":"we-napneggi we-dulegi nued-binsalegoed.","poem":1},{"text":"E-isdarmaladga we-dule-urmakosulid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"We-dule nailikgumaile, Bab-Jehová bendakoed.","poem":1},{"text":"Bab-Jehová we-dulega nailikgued osulogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Dummadga, an sogsad:","poem":1},{"text":"Bab-Jehováʼye, wile be an-dake.","poem":2},{"text":"Ar an begi nos-inigwele,","poem":1},{"text":"an-nailikgumaid be anga osuloge.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"An-isdarmalad angi isdar sunmakmalad, sogmalad:","poem":1},{"text":"“¿Wede sana burgoe? ¿Wede sana berguoe?”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Anse atakdanimalale, gakansaar anga sunmakmalad.","poem":1},{"text":"Geb nadmalogua, angi sunmakdedamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dule-isdar-an-dakmalad danar ambikunonimalogu,","poem":1},{"text":"angi urwebukdamalad.","poem":2},{"text":"Angi isdar binsabukdamalad, sogbukdamalad:","poem":1}]},{"type":"verse","number":8,"content":[{"text":"“We-dule-nailikgumaidi gwisguosulid, burgoed. Boni-dummad egi naid.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ar an-ai-nued-anba-masgundiid, an-egi-bensur-gudiid,","poem":1},{"text":"a-bela angi aibitemogad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Jehováʼye, wile be an-dake.","poem":1},{"text":"An-nailikgumaidi, be anga nudake,","poem":2},{"lineBreak":true},{"text":"adi, an-isdarmaladgi an gwisguegar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"An-isdarmalad-angi-nakosulidba an magar dakoed,","poem":1},{"text":"yeer-ito an be-imaksad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bab-Dummad, an isgussulidba, be an-ogannodii guoed,","poem":1},{"text":"be-asabin-gudigu be an-imakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"¡Israel-e-Bab-Dummad-Jehová, be-nug odummolesun!","poem":1},{"text":"Birga-birgaba degisadegu be-nug odummoledii gusun.","poem":2},{"lineBreak":true},{"text":"¡Deyob gusunno!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}