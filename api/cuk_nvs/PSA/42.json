{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":42,"content":[{"type":"heading","content":["Bab-Dummadbina an nue-soged"]},{"type":"hebrew_subtitle","content":["Coré-e-wagan we-namaked narmaksad."]},{"type":"hebrew_subtitle","content":["We-namaked Masquilʼye-nugad. Namakmalad-e-iduedga soglenaid."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummad, igi goe-bebe-nikad diibina ogormakdidae,","poem":1},{"text":"an deyob bebina sogdiid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Dummadbina an nue-soged,","poem":1},{"text":"Bab-Dummad-san-burba-ukmaidbina an nue-soged.","poem":2},{"text":"¿Ar sana Bab-Dummad-asabin an gwisgunonikoe?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bane-bane an bodiid,","poem":1},{"text":"ar an-boed an-masgunnedga anga gunonikid.","poem":2},{"text":"An-isdarmalad bane-bane anga sogdimalad:","poem":1},{"text":"“Emisgindi, ¿bia be-Bab-Dummadde nade?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"An ebinsaddaed, igi an dulemar-abalagi an nadapdae,","poem":1},{"text":"igi an Bab-Dummadse-goled-negse dulemar-semaidae.","poem":2},{"text":"An ebinsaddaed, iba-dummad-onolealile, weligwaledgi an dulemar-semaidae,","poem":1},{"text":"bela-belad namakagwale an nadapdamalad.","poem":2},{"text":"An we-ibmar ebinsadele,","poem":1},{"text":"naibid-dummad angi nonidaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¿Ibiga an suli-suli-itogoe? ¿Ibiga an bukib-itogoe?","poem":1},{"text":"¡Gwen an deyob itogewilubsulinad!","poem":2},{"text":"Bab-Dummad-abitodii an guoed,","poem":1},{"text":"Bab-Dummad-e-nug-odummodii amba an guoed.","poem":2},{"text":"Ar Bab-Dummad, an-abonogedid.","poem":1},{"text":"Bab-Jehová, an-Bab-Dummadid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bab-Dummadye, nue an suli-suli-itoged.","poem":1},{"text":"A-ulale, an begi Jordán-diwar-akale binsadiid,","poem":2},{"text":"Hermón-yar-dummagan-akale, an begi binsadiid,","poem":1},{"text":"Mizar-yalagan-akale, an begi binsadiid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Igi ibe-sailagi diwar-dummad-aryomaidae,","poem":1},{"text":"dii sukamakmaidae,","poem":2},{"text":"sabsur uurmakmaidae,","poem":1},{"text":"deyobi, wile-itolegedi be angi-gwisguega imaksad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Dummad, an bese weyob goled:","poem":1},{"text":"Bitigi be-sabgued be anga ibginedba oyogena gadin,","poem":2},{"lineBreak":true},{"text":"neg-mutikidba an-bega-namakeddi berguosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bab-Dummadga an sogoed:","poem":1},{"text":"“Be an-Bab-Dummadid, be an-bendakdiidid.","poem":2},{"text":"¿Ibiga be an-ies-gudii?","poem":1},{"text":"¿Ibiga wilesakwaa an-isdarmalad-nukad an itodii guoe?”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"An-isdarmalad-angi-allenanaid,","poem":1},{"text":"nue-nunmak an-imaked, bela-bela ulubse an-ebuged.","poem":2},{"text":"An-isdarmalad weyob anga sokardamalad:","poem":1},{"text":"“¿Bia be-Bab-Dummadde nade?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"¿Ibiga an suli-suli-itogoe? ¿Ibiga an bukib-itogoe?","poem":1},{"text":"¡Gwen an deyob itogewilubsulinad!","poem":2},{"text":"Bab-Dummad-abitodii, an guoed,","poem":1},{"text":"Bab-Dummad-e-nug-odummodii amba an guoed.","poem":2},{"text":"Ar Bab-Dummad, an-abonogedid.","poem":1},{"text":"Bab-Jehová, an-Bab-Dummadid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}