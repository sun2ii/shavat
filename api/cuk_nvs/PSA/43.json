{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"heading","content":["Igar-innikigwad-imakega Babse-goled"]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummad, anga be igar-naboge,","poem":1},{"text":"dule-beba-naisurmalad-abin be an-idu gwisgue,","poem":2},{"lineBreak":true},{"text":"dule-isganamargi, dule-gakansilimargi be an-ollorsae.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bedi an-Bab-Dummadid,","poem":1},{"text":"be an-ganguedid.","poem":2},{"text":"¿Ar ibiga be an-obacha?","poem":1},{"text":"¿Ar ibiga an-isdarad an-sabsur-imaked-ular, an wile-itodioe?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Be-magar-ito-ibmar-imakedi, be-igar-napiragwadi, be anga udage.","poem":1},{"text":"Adi, igar-nuedba an-idugega,","poem":2},{"lineBreak":true},{"text":"be-yar-islidikidse an-nidega,","poem":2},{"lineBreak":true},{"text":"be-maidse an-sedegar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Dummad, be-ibmar-ukleged-ailase an warmakoed.","poem":1},{"text":"Agi, an gar-arpaʼba bega namakoed.","poem":2},{"text":"Ar be, an-Bab-Dummadid,","poem":1},{"text":"weligwar be an-imakedid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¿Ibiga an suli-suli-itogoe? ¿Ibiga an bukib-itogoe?","poem":1},{"text":"¡Gwen an deyob itogewilubsulinad!","poem":2},{"text":"Bab-Dummad-abitodii an guoed,","poem":1},{"text":"Bab-Dummad-e-nug-odummodii amba an guoed.","poem":2},{"text":"Ar Bab-Dummad, an-abonogedid.","poem":1},{"text":"Bab-Dummad, an-Bab-Dummadid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}