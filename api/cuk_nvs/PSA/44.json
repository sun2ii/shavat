{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":44,"content":[{"type":"heading","content":["Bab-Dummadse bendakleged egised"]},{"type":"hebrew_subtitle","content":["Coré-wagan namakmalad-e-iduedga we-namaked-Masquilʼye-nugad narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummad, epenne ibmar-dakledisurmalad be imaksadi, anmar-sunnagwad uayagwar itosad.","poem":1},{"text":"Epenne-ibmar-gusadi, anmar-dadgan anmarga sogsad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Be-sunnagwadi, dule-be-wissurmalad be onisad.","poem":1},{"text":"A-muchubbi, anmar-dadgan be urbisad.","poem":2},{"text":"Dule-be-wissurmaladi be sabsur-odurdaksad,","poem":1},{"text":"anmar-dadgandi nasgumai be imaksad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dadgan gwen e-es-suidgine yar sussurmalad,","poem":1},{"text":"gwen e-surgangine dulemargi obichasurmalad.","poem":2},{"text":"Unnila be-ganguedgi, be-surgangi, be anmar-dadgan-bendaksad.","poem":1},{"text":"Eba-be-gudigusadgi be amar-bendaksad.","poem":2},{"lineBreak":true},{"text":"Ar bede, dadgan-nue-sabedbali, deyob imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bebi unnila be an-Bab-Dummadid, bebi be, an-reyd.","poem":1},{"text":"¡Be-igar-ukedba dulemargi-nakwega be anmar-imaksad!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Be-ganguedgi anmar-isdarmaladgi anmar nakwisad.","poem":1},{"text":"Be-nuggi anmargi-gwichigudimaladi anmar obelosad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"An-warsigi bendakleged an amiosulid,","poem":1},{"text":"an-es-suid dulemargi-nakwega gwen an-imakosulid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Be anmar-isdarmaladgi-nakwega be anmar-imaksad.","poem":1},{"text":"Bebi, dule-anmargi-gwisgudimalad-obingegsaega be imaksad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"¡Bab-Dummad, anmar beginbi nug-dummarba-itodii gumaloed!","poem":1},{"text":"¡Anmar be-nug-odummodii gumaloed!","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Emisgindi, be anmar-obachad, be anmar-obinge-imaksad.","poem":1},{"text":"Bar be anmar-sorda-bila-onomaladba nanasurgusad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dule-isdarmalad-abin sikirmakega be anmar-imaksad.","poem":1},{"text":"Dule-sae-anmar-dakdimalad, anmar-ibe ibmar-atur-imaksamalad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sibad-wawaadyob be anmar-oburgwega anmar-urmaksad.","poem":1},{"text":"Dulamar-bamalad-imbagi be anmar-oaisakisad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Be-dulamar mani-bipii be uksad,","poem":1},{"text":"egi be ibmar-nued gwen-amissulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dule-anmar-neg-dikarba-mamaid-abin, dule-gegegwaga be anmar-imaksad.","poem":1},{"text":"Dulemarga anmar dodogedga guded,","poem":2},{"lineBreak":true},{"text":"dulemarga anmar alledga guded.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Neggweburmar-oallega be anmar-imaksad.","poem":1},{"text":"Anmar-dakalir, yamo-yamo anmarga guardamalad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bane-bane bingedar an itodigussunnad.","poem":1},{"text":"An akusunna-itogedba bingeguarsunnad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"An-isdarmalad-buged-an-imakbi-gudimaladse,","poem":1},{"text":"an-isdarmalad-sae-an-dakdimaladse,","poem":2},{"text":"an-isdarmalad-an-dikarba-urwedimaladse,","poem":1},{"text":"an bingedar-itoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Bela we-ibmar anmargi gusad. Degi-inigwele, anmar be-iessulid.","poem":1},{"text":"Dadgan-Ebo-Be-Igar-Mesisadi anmar gwen-bichissulid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Anmar bega uayasuli gussulid,","poem":1},{"text":"be-Igargi anmar gwen bangussurbalid.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ar bedi achusapur-bunnu-wawaad-e-gubya-yaba be an-balimetemalad,","poem":1},{"text":"negasichidbi be anmar-idu nasiksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Bab-Dummad, ar anmar be-iesana,","poem":1},{"text":"be-muchub anmar bab-dummad-baidse gochana,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"¿ar be wisguosulin be insae?","poem":1},{"text":"Ar bede bela ulubgi dulemar-binsaed mag-daked.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Be-ular, anmar bane-bane oburgwilediid.","poem":1},{"text":"Sibad-wawaad-oburgwelegedyob anmar imaklediid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"¡Bab-Dummad, atake! ¡Mer gabe!","poem":1},{"text":"¡Gwisgue! Mer be anmargi bangudii gue.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"¿Ibiga be anmar-idu dukue?","poem":1},{"text":"¿Ibiga be anmar-wilediid be iege?","poem":2},{"lineBreak":true},{"text":"¿Ibiga be anmar-sabsur-imaklediid be iege?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Anmar napa-nukuse yasulemamaigus-naed.","poem":1},{"text":"Napayala baparmakdigusmalad.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bab-Dummadye, be dage.","poem":1},{"text":"Be anmar-bendakdage.","poem":2},{"lineBreak":true},{"text":"Be-sabguedgi be anmar-bendakdasun.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}