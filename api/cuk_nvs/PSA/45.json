{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":45,"content":[{"type":"heading","content":["Rey-ome-nikunaidgi namakleged"]},{"type":"hebrew_subtitle","content":["Namakmalad-e-iduedga sogleged: “Dutu-lirioʼga-namaklegedyob we-namaked namaklegoed.”"]},{"type":"hebrew_subtitle","content":["Coré-wagan we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"An-ulubgi ibmar-nued sogbie an itoged.","poem":1},{"text":"An reyga an-namaked-narmaksad soged.","poem":2},{"lineBreak":true},{"text":"An-gwabin garda-suar-yeer-narmakeyobi gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Rey, be bur dulemar-baiganba yeerdakleged,","poem":1},{"text":"be bur yeer-sunmaked,","poem":2},{"lineBreak":true},{"text":"ar Bab-Dummad degisadegu begi ise-nued binsasad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Rey, be-ganguedgi, be-yeerdaklegedgi, be-es-suid be-saderba be nasike.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"Be-gangued-yeerdaklegedgi nakwemai be imake.","poem":2},{"lineBreak":true},{"text":"Igar-napiragwadbina urwedii be sae.","poem":2},{"text":"Dule-wileganaga ibmar-innikigwad-imakdii be gue.","poem":1},{"text":"¡Rey, be-ganguedgi ibmar-dummagan-imakdii be nanae!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Be-sigu-swiswidikmaladgi, be-isdarmalad-bese-galakudii be imake.","poem":1},{"text":"A-sigumar, rey-e-isdarmalad-gwagegi yoledapoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bab-Dummad, be-negsemaid degisadeguoed.","poem":1},{"text":"Be-negsemaid, igar-maidba be imaked.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Igar-innikigwad-imaked be yeer-itodaed,","poem":1},{"text":"ibmar-isganadi, be isdar-daked.","poem":2},{"text":"A-ulale, Bab-Dummad-be-Bab-Dummadi, be-aimar-baiganba be-susad.","poem":1},{"text":"Be-Bab-Dummad, ina-wawadikidgi be-wawamaksad,","poem":2},{"lineBreak":true},{"text":"weligwar-ito be-imaksad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Be-mola, we-ina-wawadikmaladbi yapanned:","poem":1},{"text":"Mirraʼye-nugadbi, áloeʼye-nugadbi, canelaʼye-nugadbi yapanned.","poem":2},{"text":"Reyneg-marfilʼgi-ise-nudakaled-akale,","poem":1},{"text":"gar-bega-ogorlenaidi weligwar be-imaked.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yagana-be-ebilidmaladi, reymar-sisgan nanaed.","poem":1},{"text":"Be-ologana-argan-nuedsik rey-ome siid.","poem":2},{"lineBreak":true},{"text":"We-rey-omede, Ofir-or-nuedgi ise-nudakar siid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bunagwa, an bega-ibmar-sogoedi, nue be an-itogo.","poem":1},{"text":"Be-dulemar be iege,","poem":2},{"lineBreak":true},{"text":"be-gwenadgangi mer be bar binsae.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Be-yeerdaklegedba rey nue-be-abeged.","poem":1},{"text":"Rey be-dummadid, degisoggu, eba be ibsae.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tiro-dorgan binsa-ibmar-uklemalad bega sedagoed.","poem":1},{"text":"Dule-mani-ibgan ega-ibmar-nued-imakbi be-abemaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Rey-e-sisgwa e-gabedyaba nue-nudakar maid.","poem":1},{"text":"E-mor ber olobi dakleged.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"E-mor-ise-nue-sobaled-yoi reyse seledoed.","poem":1},{"text":"E-aimar-yagana e-sorba-nai nadapmaloed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Weligwar itonadapmaloed,","poem":1},{"text":"Rey-e-negse weligwaledgi dogdapmaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Rey, be-masmala be-dadgan-negsemai-gusad-ganagi sigmaloed.","poem":1},{"text":"Amar bela bemar-yala-semamai gumaloed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"An bega we-namaknaidgi, dulemar-be-iegega an imakosulid.","poem":1},{"text":"Bela neggwebur-baiganginmalad be-ebinsadiguega an imakoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":17}