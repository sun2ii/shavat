{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"heading","content":["Bab-Dummad anmarba gudiguad"]},{"type":"hebrew_subtitle","content":["Coré-wagan we-namaked narmaksad. Namakmalad-e-iduedga soglenaid:"]},{"type":"hebrew_subtitle","content":["“We-namaked-Alamotʼgi-namaklegoye.”"]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummad anmar-niga-ogannogedid.","poem":1},{"text":"Bab-Dummad anmar-irwa-gwisguedid.","poem":2},{"lineBreak":true},{"text":"Bab-Dummad wilubdaklegedgi, anmar-bendaked-sunsogedid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Degisoggu, ar neg giglimakde-sogele, anmar dobguosulid.","poem":1},{"text":"Yala-dummagan demar-wilagangi-dogdedibe, amba anmar dobguosulid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Demar-dummagan-urwedbali, yala-dummagan giglimakdedibe,","poem":1},{"text":"amba anmar dobguosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Diwar-iirmakemaidi, weligwar Bab-Dummad-e-neggwebur imaked.","poem":1},{"text":"Weligwar Bab-Dummad-Bur-Birigined-e-neg-Islidikid imaked.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Dummad e-neggwebur-abargi gudiid, degisoggu, e-neggwebur akar-guosulid.","poem":1},{"text":"Bab-Dummad, neg-oibosale, na e-neggwebur-bendakoed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Dummad-sunmakdele, dulemar-yar-baid-baidgi-bukwamalad dobguddamalad,","poem":1},{"text":"neggweburmar-bubukwad giglimakdedaed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová-Bela-Gangued-Nikad anmarba gudiid,","poem":1},{"text":"Jacob-e-Bab-Dummad an-dukuedga gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"¡Dagmala! Bab-Jehová-e-ibmar-imaksad be dakdamala.","poem":1},{"text":"We-napneggi-ibmar-dakledisulid-imaksad be dakdamala.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Dummad we-napneg-ugakaase bela bila-onoleged obelosad.","poem":1},{"text":"Warsimar bibisgisad, eswarmar bibisgisbalid,","poem":2},{"lineBreak":true},{"text":"moli-urmar soogi ogumaksabalid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Boo be ambikumalo, magar be an-dakmalo, ani an Bab-Dummadid.","poem":1},{"text":"Dulemar-yar-baid-baidgi-bukwamalad-abargi an-nug odummolegoed,","poem":2},{"lineBreak":true},{"text":"we-napneggi an-nug odummolegoed.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Jehová-Bela-Gangued-Nikad anmarba gudiid,","poem":1},{"text":"Jacob-e-Bab-Dummad an-dukuedga gued.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}