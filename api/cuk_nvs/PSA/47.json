"text":"Bab-Dummad dulemar-weligwar-oimakmalad-abargi, gar-trompeta-goled-abargi,","poem":1},{"text":"e-ologanase nakwemai gusad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"¡Namakmala! Bab-Dummadga namakmala.","poem":1},{"text":"¡Namakmala! Anmar-reyga namakmala.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ar Bab-Dummad bela napneg-e-reyd.","poem":1},{"text":"¡Ise-itoagwar namakmala!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bab-Dummad dulemar-yar-baid-baidgi-bukmalad-e-reyga maid,","poem":1},{"text":"Bab-Dummad e-ologan-islidikidgi siid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dule-dummagan-neggwebur-dakmamaidi,","poem":1},{"text":"Abraham-e-Bab-Dummad-e-dulamarbo onmaksamalad.","poem":2},{"text":"Ar dule-dummagan-negdakmamaidi, Bab-Dummadgadid.","poem":1},{"text":"¡Bab-Dummad bela-bela odummoleged!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}