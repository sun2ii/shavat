{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"heading","content":["Sión-yala, Bab-Dummad-neggwebur-gandikidid"]},{"type":"hebrew_subtitle","content":["Coré-wagan we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová, duledar-dummadid.","poem":1},{"text":"E-neggweburgi, e-yala-isligwaledgi, e-nug-birigined innikigwadba odummoleged maid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ibiyob Sión-yala yeerdaklege,","poem":1},{"text":"bela napneg-naid weligwar imaked.","poem":2},{"text":"Sión-yala, dad-nakwed-argan-sapiledsik-siid,","poem":1},{"text":"Bab-Dummad-e-neggweburga gued.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Dummadi, Sión-neg-suid-gandikmaladgi,","poem":1},{"text":"dulemar-edarbedga gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Reymar na atosmalad,","poem":1},{"text":"geb Jerusalénʼgi gwisguargusmalad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Reymar a-neggwebur-dakargu, geger-dakarmalad, abin gwakidmalad,","poem":1},{"text":"itosur-gwae duurmakdemalad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Emargi bela-belad dobed nagusad,","poem":1},{"text":"igi sior ugakgunair, e-boniba galitonaidae,","poem":2},{"lineBreak":true},{"text":"debayobi, a-dulemargi dobed nagusad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dii-burwa-dummadba Tarsis-ulu-dummagan-aibinebayobi,","poem":1},{"text":"dulemargi dobed nagusad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Igi-anmar-sunnagwad uayagwar epenne na ibmar itosmala,","poem":1},{"text":"emide, deyob Bab-Dummad-Bela-Gangued-Nikad-e-neggweburgi, anmar na ibyagwar daksamalad.","poem":2},{"lineBreak":true},{"text":"Anmar-Bab-Dummad, na e-neggwebur, degisadegu-sii imakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bab-Dummad, anmar bese-goled-neggi,","poem":1},{"text":"be-ise-wile-anmar-dakmaidgi binsabukwadamalad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Dummad, bela napneg-ugakaase be-nug odummoleged.","poem":1},{"text":"Be-nuggi nued sunmaklediid.","poem":2},{"lineBreak":true},{"text":"Igar-innikigwadba be negsemaid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Be-igar-innikii-imakedba Sión-yala yeer-itoged,","poem":1},{"text":"Judá-neggwebur-burwigana weligwar itomarmogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Sión-yala be ebirnamalo,","poem":1},{"text":"binnalee be namalo.","poem":2},{"text":"E-neg-suigan-bukwad be ebismalo.","poem":1}]},{"type":"verse","number":13,"content":[{"text":"E-galu-matusurmalad nue be dakmalo,","poem":2},{"text":"e-neg-gandikmalad nue be argamalo.","poem":1},{"text":"Adi, yoo be-wagan-danikoedga be we-ibmar sogmalagar.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"We-Bab-Dummadi, anmar-Bab-Dummad-degisadeguadid.","poem":1},{"text":"Bab-Dummadi, anmar-idudii sadeguoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}