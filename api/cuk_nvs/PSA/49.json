{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":49,"content":[{"type":"hebrew_subtitle","content":["Coré-wagan we-namaked narmaksad. Namakmalad-e-iduedga soglenaid."]},{"type":"verse","number":1,"content":[{"text":"Bela bemar, nue an-itomar.","poem":1},{"text":"Bela bemar, we-napneggi-bukmalad, nue be an-itomar.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dule-dummagan, dule-binsarmalad,","poem":1},{"text":"dule-mani-nikamalad, dule-wilegana, nue be an-itomar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"An sunmakoedi, nue-binsaed-nikaa an sunmakoed.","poem":1},{"text":"An-ulubgi-binsaedi, nue-magar-itole an sogoed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ibmar-binsaed-nikaa-soglemalad nue-itoakwaa an sogoed.","poem":1},{"text":"Gar-arpa-ogorsiidgi we-ibmar-soglegoed-e-obared an bega odulogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ar bonigan dani-sogele, ¿ibiga dobee an itogoe?","poem":1},{"text":"Dule-isganamar an-ebilis ambikunonimalale, ¿ibiga an dobguoe?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dule-mani-nikadba-dobsuli-itodimalad, na e-ibmar-nikadba san-dummarba-imakdimalad,","poem":1},{"text":"¿a-dulemarde an dobguode? Suli, an dobguosuli.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dule wargwensaale na dukin bendakosulid.","poem":1},{"text":"Na dukin burgwedgi san-onogegala,","poem":2},{"lineBreak":true},{"text":"geg Bab-Dummad-bennuked.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"San-onolegedi gargesailad.","poem":1},{"text":"San-onolegegala, mani unniguarsulid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dule degisadegu dula-gudii guosulid.","poem":1},{"text":"Dule burgosurdeeye sogsulid, burgwedsegad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bela dulemar burgwedbiid,","poem":1},{"text":"dule-binsaed-ibedi, dule-binsaedsulidi, bela burgwedsemalad.","poem":2},{"lineBreak":true},{"text":"E-ibmar-nikadi dulemar-baiganga beoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar nainu ichesur-nikus-inigwele,","poem":1},{"text":"neg-uangi degisadegu mai guoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ar dule mani-ibed-inigwele, degisadegu dula-gudiguodeeye sogsulid.","poem":1},{"text":"Ibdurganyobi burgwemarmogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Weyobi, dulemar e-manigi-alakwaa-gudimaladi, berguddamalad.","poem":1},{"text":"Na dukin san-dummarba-imakmaladi, weyobi, berguddamarmogad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Igi sibad-iduged e-sibad-wawaad-semaidae,","poem":1},{"text":"deyobi, burgwed we-dulemar-semai gumogoed.","poem":2},{"text":"E-neg-dummagan-nuegan-daklemaladgi, dikasuli e-mui neg-uangi nungumai guoed.","poem":1},{"text":"Yoedsega dule-nuegan negsemamai gumaloed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ar Bab-Dummaddi burgwedgi an-ollorsaoed,","poem":1},{"text":"Bab-Dummad eba an-sedoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dule-wargwen mani-ibedga-gudele, mer bai be dako,","poem":1},{"text":"e-neg yeerdakle nadele, mer geg be dako.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ar we-dule burgwidele, na e-ibmar sedosulid,","poem":1},{"text":"e-ibmar-yeerdaklemalad eba naosulid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ar we-napneggi dula-gudigua, weligwar itodigus-inigwele,","poem":1},{"text":"dulemar e-nug-odummodigusmar-inigwele,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"we-dule, e-babgan-burgwismogayobi, burgwemogoed,","poem":1},{"text":"we-napneggi bar gudii guosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ar dule mani-ibed-inigwele, na aku itoged,","poem":1},{"text":"ede ibdurgan-burgweyobi, burgwemogoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":20}