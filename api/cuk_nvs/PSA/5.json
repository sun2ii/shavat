{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":5,"content":[{"type":"heading","content":["Bab-Dummadse-goled, an-bendakye"]},{"type":"hebrew_subtitle","content":["Namakmalad-e-iduedga soglenaid: Gar-gammuba namaklegoye."]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼye, an bega ibmar-sogedi, be an-itoge.","poem":1},{"text":"Nunmakedgi an bega ibmar-biedi, nue be an-itoge.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová, be an-Bab-Dummad gued, be an-rey gued.","poem":1},{"text":"Ar an bese gornaisoggu, an bese wilenaidi, nue be itosunna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová, wakudaryalaba an bese-goledi be an-itodaed,","poem":1},{"text":"wakudaryalaba an-wile-naidi, an bega sognonidaed.","poem":2},{"lineBreak":true},{"text":"Be-an-abin-imakedi, an edarbedidaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Dummad, ar bedi ibmar-isgana abesulid,","poem":1},{"text":"Dule-isgana be-walikaa gudii guosulid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dule-san-dummarba-imakmalad, bese gwen dogosulid.","poem":1},{"text":"Dule-ibmar-isgana-imakmalad, nue-sae be dakdaed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dule-gakansamalad be obelogoed.","poem":1},{"text":"Bab-Jehová, bedi dule-gindakmalad, dule-yardakmalad, nue-sae dakdaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bab-Dummad, ar bedi nue-wile-an-daksoggu,","poem":1},{"text":"andi nabir bese-goled-negse dogsunnad.","poem":2},{"text":"Nabir an be-neg-islidikidsik sindigar-ataksii","poem":1},{"text":"an be-nug odummosunnad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bab-Jehováʼye, an-isdarmalad an bukidar-nikadba be-igar-innikigwadba be an-nie.","poem":1},{"text":"Be-Igar-Maid magar-dakega be an-imake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dule-isganamar innikigwadba sunmaksurmalad,","poem":1},{"text":"e-ulubgi ibmar-isgana-imakedginbi binsadimalad.","poem":2},{"text":"Yamo dule-nug-odummogar sunmakmalad,","poem":1},{"text":"yardakar emar-obelogega, guagwar bukwamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"¡Bab-Dummadye, a-dule-isganamar be sabsur-odurdake!","poem":1},{"text":"Dule-isganamar yamo dule-yardaked-igar mesismalad.","poem":2},{"text":"A-igar na dukin egi aibinega be imake.","poem":1},{"text":"We-dulemar gannar-gannar ibmar-isgana-imakdimalad-ular, be obane.","poem":2},{"lineBreak":true},{"text":"Ar ade, begi nue-gwisgusmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dule-begi-bendakleged-amidimaladi, wergumarsun,","poem":1},{"text":"degisadegu weligwar namakmarsun.","poem":2},{"text":"Bab-Dummad, be amar-bendakdaed.","poem":1},{"text":"Dule-be-sabgudimaladi, begi wergumarsun.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bab-Jehová, dule-ibmar-innikii-imakedgi be nued binsaoed.","poem":1},{"text":"Bab-Jehová, be-sabedi dulega sigu-abgaedyob guoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}