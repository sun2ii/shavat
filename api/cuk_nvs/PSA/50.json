{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":50,"content":[{"type":"heading","content":["Bab-Dummad igar-nabononikoed"]},{"type":"hebrew_subtitle","content":["Asaf, we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová, Bab-Dummadbi-maidi, goled:","poem":1},{"text":"Dulemar-dad-nakwedsik-bukmaladse goled,","poem":2},{"lineBreak":true},{"text":"dulemar-dad-argwanedsik-bukmaladse, onmakega goled.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Dummad, Sión-neggwebur-yeerdaklegedba,","poem":1},{"text":"dad-ibeler-gaeyob, e-maid oyomaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Anmar-Bab-Dummad-danikidi boo danisulid,","poem":1},{"text":"e-iduale, soo-dummadi gadanikid,","poem":2},{"text":"bela ibmar-ogumakdanikid.","poem":1},{"text":"Burwa-oored bela Bab-Dummad-ebiris danikid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Dummad nibnegse gochad, napnegse gochabalid,","poem":1},{"text":"e-dulamarga-igar-nabolesokalid dakdamalagar.","poem":2},{"text":"Bab-Dummad weyob soged:","poem":1}]},{"type":"verse","number":5,"content":[{"text":"“Anga dule-islidik-gudimalad onmakmalo,","poem":2},{"lineBreak":true},{"text":"dulemar ibmar-ogumakar-uklegedgi anbo-igar-mesismalad, anga onmakmalo.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nibneg soged:","poem":1},{"text":"Bab-Dummad dulega igar-naboged-innikigwad maiye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Israel-dulemar, an-itomala,","poem":1},{"text":"an-sunmaksokalid nue-itomala.","poem":2},{"lineBreak":true},{"text":"An-dulamar, an begi sunmaksokalid:","poem":2},{"text":"Ani an be-Bab-Dummadid,","poem":1},{"text":"unnila, anbi Bab-Dummad maid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bemar anga ibmar-ogumakar-ukdamaladgi an yolesulid.","poem":1},{"text":"Bemar anga gusgu ibmar-nued-ukdamaladgi an yolesulid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Be-moli-bebe-nikad-sapingana e-galugi-bukwadbina an sogsulid.","poem":1},{"text":"Be-sibad-machergan e-galugi-bukwadbina an sogsulid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ar bela ibmar-durgan-sapurba-bukwad, angadbiid,","poem":1},{"text":"bela molimar-yalaganba-bukwad, angadbiid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bela nuumar-sapurba-bukwad angi yoggusisulid,","poem":1},{"text":"bela ibmar-durgan-yalaganba-gudinanaed, angadbiid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Degisoggu, an mas-gunbiele, an bese gochasuliled.","poem":1},{"text":"Ar bela we-napneg, angadbiid,","poem":2},{"lineBreak":true},{"text":"bela ibmar-we-napneggi-bukwad, angadbiid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"¿Ar moli-bebe-nikad-e-san-gunnedgi an gudisi?","poem":1},{"text":"¿Ar sibad-machered-e-ablis-gobedgi an gudisi?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Anga weligwaledgi dog-nuedye be sogdage.","poem":1},{"text":"Anga, Bab-Dummad-Bur-Biriginedga be ibmar-imakoye-sogsad, be imakdage.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bonigan-abalagi be gunaidgi, anse be gole,","poem":1},{"text":"an be-bendaknonikoed.","poem":2},{"lineBreak":true},{"text":"Bedi be an-nug-odummogoed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bab-Dummad dule-isganagardina, weyob soged:","poem":1},{"text":"“¿Doa bega soge, An-Igar-Maid be absogoye?","poem":2},{"lineBreak":true},{"text":"¿Doa bega soge, An-Igar-Maidgi be sunmakoye?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ar be durdakleged-igar abesulid.","poem":1},{"text":"An-gayaburba be isdarsun-daked.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ar be atursamalad-dakardibe, eba be naddaed,","poem":1},{"text":"dule-gambasamalad nabir be daked.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Be-gayadina ibmar-isganagi sulibinsa sunmaked,","poem":1},{"text":"be-gwabindukudina, unnila, gakansaedginbi sunmaked.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ar be-gwenadgi gusgu be yolegar sunmaked,","poem":1},{"text":"amba be-gargwenadgine be gakansabalid.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bela be we-ibmar-imaksadba, an bese gochasulid.","poem":1},{"text":"Ande beyobye, ¿be binsasunde?","poem":2},{"text":"Emisgindi, an bese urwoed.","poem":1},{"text":"Bega an bakar ibmar sogoed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bemar an-ieddamalad,","poem":1},{"text":"an bega ibmar-sogsad nue egi be binsamalo.","poem":2},{"text":"Degisulile, anse be ibitomaloed,","poem":1},{"text":"dule-wargwensaale be-bendakosurmalad.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Dule anga dog-nuedye-sogega, ibmar-nued-ukedi, an-nug odummoged.","poem":1},{"text":"Dule na e-daed ogwaele, an ega abonoleged-igar oyononikoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}