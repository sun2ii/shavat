{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":51,"content":[{"type":"heading","content":["Bab-Dummadse isgusad-ular wilenaid"]},{"type":"hebrew_subtitle","content":["David Betsabéʼbo galagwensuli-gusad-sorba,"]},{"type":"hebrew_subtitle","content":["Bab-Dummad-gayaburba-barsoged-Natán Davidʼse arbid."]},{"type":"hebrew_subtitle","content":["A-sorbali, David we-namaked narmaksad. Namakmalad-e-iduedga soglenaid."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummadye, be dule-wiledakedba, be wile-an-dake.","poem":1},{"text":"Be bela-bela-dule-sabedba, an-isgued be anga elie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bela an-ibmar-isgana-imaksad be anga obeloge.","poem":1},{"text":"Bela an-isgued be anga osuloge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"An ibmar-noar-imaksadi an magar itoged,","poem":1},{"text":"an-isgusad an nue wisid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová, beginbi, unnila beginbi an isgusad.","poem":1},{"text":"Be-asabin an ibmar-isgana imaksad.","poem":2},{"text":"Agala, be-igar-nabogedgi be-igar-mesedi innikigwadid.","poem":1},{"text":"Be-igar-naboged dule geg egi akarsoged.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"An gwalulesad-akale, an dule-isgana gued,","poem":1},{"text":"an sapibeneggi-maigusad-akale, bato an dule-isguedid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"An nue-wisid, be dule-inniki-gudiid nue-sabed.","poem":1},{"text":"Burbale, nue-binsaed-nikadaed be an-odurdaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"An swilidik-guega, hisopo-gagangi be an-nudake.","poem":1},{"text":"An boo-sibudikidba bur bule sipuu guega, swilidik be an-imake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Weligwar be an-imake, yeer-ito be an-imake,","poem":1},{"text":"be an-san-sabsur-odurdaksad gannar yeer-itoge be imake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"An-isgued mer be bar ebinsae,","poem":1},{"text":"an-ibmar-isgana-imaksad bela be osuloge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bab-Dummadye, gwage-swilidikid be anga nasike.","poem":1},{"text":"Burba-swilidikid be anga uke.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"An be-walik-gudiidgi mer be an-ononnoge.","poem":1},{"text":"Be-Burba-Isligwaled mer be angi obane.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Be-abonolegedgi-weligwar-itolegedi, gannar be anga udage.","poem":1},{"text":"Uaya-nikadae be an-imake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Geb deyobi, be-igar-maidgi-yoledimalad an be-igargi odurdakoed,","poem":1},{"text":"geb dule-isgudimalad gannar bese nonimaloed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"An-Bab-Dummad-an-abonogedye, an dule-ibe-ablis-eosadgi be an-ollorsae,","poem":1},{"text":"adi, an be-igar-innikigwadgi namakdii guegar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Bab-Dummadye, an be-nug odummogega,","poem":1},{"text":"ibmar-biega be an-imake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ibmar-ukleged an bega-ukele, be yeerdakosulid.","poem":1},{"text":"Ibmar-durgan-ogumakar-ukleged an bega-ukele, be abingaosulid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ar begardi, dule-na-e-isguedga-wile-itogedi, ibmar-uklegedba bur-nued gued.","poem":1},{"text":"Bab-Dummad, dule-na-e-isguedga-bukib-itogedi, bedi isdar daksulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Be-nued-binsaedbali, Sión-neggwebur-nasgumai be imake.","poem":1},{"text":"A-Jerusalén-neggwebur-e-galu-dummagan be gannar ogwiche.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Geb be-igar-mesisadba-ibmar-bega-ukleged be abingaoed.","poem":1},{"text":"Ibdurgan-bela-gwagwar-ogumakar-bega-uklegedi be yeer dakoed.","poem":2},{"lineBreak":true},{"text":"Geb moli-bebe-nikad-sapingan bega-ibmar-ogumakar-ukleged-ailagi ukledoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}