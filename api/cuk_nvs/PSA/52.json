{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":52,"content":[{"type":"heading","content":["Dule-isgudiid, binsa san-odummodiid"]},{"type":"hebrew_subtitle","content":["David we-namaked-Masquilʼye nugad."]},{"type":"hebrew_subtitle","content":["Deunni, Edomʼgined-Doeg Saúl-owisonadgu:"]},{"type":"hebrew_subtitle","content":["David Ahimelec-negse nadye. Namakmalad-e-iduedga soglenaid."]},{"type":"verse","number":1,"content":[{"text":"Be, na-san-buled-imaked, ¿ibiga be-isguedgi be san-dummarbaa imake?","poem":1},{"text":"¡Bab-Dummaddi dule-sabgumaiguad!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Be-gwabin-duku, esbipi-nugar-datarmakaledyobid, emar-obelogedginbi binsaed,","poem":1},{"text":"gakanginbi sunmaked.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Igar-nuedba bur bule, igar-isganabina be soged.","poem":1},{"text":"Igar-nabiridba bur bule, gakansaedbina be itoged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gakansaed-gwabin-duku be sediid.","poem":1},{"text":"Be-sunmakedgi emargi-urwed be yeer itodaed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Dummaddi, ilagwen-be-obelogar imakoed.","poem":1},{"text":"Be-negyaurgi be-onogoed, we-napneggi be-obelogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dule-nuegan, we-ibmar dakmaloed,","poem":1},{"text":"nue-dobee itodmaloed.","poem":2},{"text":"Weyob be-annik dodoakwaa sunmakdemaloed:","poem":1}]},{"type":"verse","number":7,"content":[{"text":"“We-dule-isgana, Bab-Dummadgi-bendakleged-amissulid, be dakmala.","poem":2},{"text":"Unnila ibmar-nue-nikadba na yeer itosad,","poem":1},{"text":"e-ibmar-isgana-imakedgi gwen bangussulid.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Andi, Bab-Dummadse-goled-neggi olivo-sapi-durbamakar-daedyob gued.","poem":1},{"text":"Andi, degisadegu, Bab-Dummad-e-sabguedgi bensulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bab-Dummad, andi be-ibmar-imaksadba be-nug-odummodii guoed.","poem":1},{"text":"Bede dar dule-nuedsoggu, begine an bensuli gudioed.","poem":2},{"lineBreak":true},{"text":"Dule-nuegan-abargi an bese gordii guoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}