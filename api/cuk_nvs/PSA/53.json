{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":53,"content":[{"type":"heading","content":["Dule-ibmar-isgana-imakmalad"]},{"type":"hebrew_subtitle","content":["David namakmalad-e-iduedga we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Dule-binsaedsulidaed, e-gwagegi sogdiid:","poem":1},{"text":"“Bab-Dummad maisurye.”","poem":2},{"text":"We-dulemar nue-isgusgudidimalad, unnila ibmar-isganabi imakdidimalad.","poem":1},{"text":"¡Bipisaale dule ibmar-nued-imaked sated!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bab-Dummad, nibneg-akale dulemar-napneggi-bukmalad dakded,","poem":1},{"text":"abakalegi, dule-wargwen binsaed-nikadaed gudiile,","poem":2},{"lineBreak":true},{"text":"abakalegi, wis dule-wargwensaar Bab-Dummad-amibied gudiile.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Dummad dakalid,","poem":1},{"text":"bela dulemar egi bangus gudidimala,","poem":2},{"lineBreak":true},{"text":"bela nue-isgus gudidimala.","poem":2},{"text":"Wargwensaale ibmar-nued-imaked suli,","poem":1},{"text":"bipisaale wargwengiid ibmar-nued-imaked, sate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dule-ibmar-isgana-imakdimalad akusunna itomalad,","poem":1},{"text":"amarde, madu-gunneyob an-dulamar-imakdimalad,","poem":2},{"lineBreak":true},{"text":"Bab-Dummadse gordisurmarbalid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dule-isganamar dobguewilubsurmalanad,","poem":1},{"text":"degite, bela-bela dobedba wawanmakdemaloed.","poem":2},{"text":"Bab-Dummad we-dulemar-obachadbali, be-isdarmalad-e-garmar oaisakioed.","poem":1},{"text":"Bab-Dummad dule-isgana obingesaoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bitigi Israel-neggwebur-bendakleged Sión-yar-akar danikina gadin.","poem":1},{"text":"Bab-Dummad na e-dulamar gannar e-yarse senonikile, Jacob-e-wagan wergudmaloed,","poem":2},{"lineBreak":true},{"text":"Israel-dulemar weligwar itodmaloed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}