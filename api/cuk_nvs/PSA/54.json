{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"heading","content":["Bab-Dummadse bendakleged egisnaid"]},{"type":"hebrew_subtitle","content":["David we-namaked-Masquilʼye-nugad narmaksad."]},{"type":"hebrew_subtitle","content":["Namakmalad-e-iduedga soglesad: Neginotʼba-namakoye."]},{"type":"hebrew_subtitle","content":["Deun Zif-dulemar Saúlʼga sognonimargu:"]},{"type":"hebrew_subtitle","content":["David anmar-abargi dukudiiye."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummadye, be an-bendake,","poem":1},{"text":"be-nug-dummarba-maidba be an-bendakdage.","poem":2},{"lineBreak":true},{"text":"Be-ganguedgi be an-bendakdage.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Dummadye, an-gornaid be an-itoge,","poem":1},{"text":"an bega-ibmar-sognaid wis be an-itoge.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ar dule-galagwensurdamaladi, angi gwisgunanaid.","poem":1},{"text":"Ar dule-sabesulidamaladi, an-oburgwega anbina gudimalad.","poem":2},{"lineBreak":true},{"text":"Ar we-dulemar, bipisaagwar begi binsadisurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Dummadbi unnila an-bendakedid,","poem":1},{"text":"Bab-Dummadbi unnila an-sediid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Dummad an-isdarmaladgi bonigan-yolegega imakoed.","poem":1},{"text":"Bab-Dummadye be inniki-ibmar-imakmaidba, bela be an-isdarmalad oburgwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bab-Dummad, an bebina-sogedba ibmar-nued an bega ukoed.","poem":1},{"text":"Bab-Jehová, an be-nug odummogoed, ar deyob-imaked ibnuedid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Dummad, bela bonigangine be an-ollor-imaksad.","poem":1},{"text":"An-isdarmalad-galakued-dakega be an-imaksabalid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}