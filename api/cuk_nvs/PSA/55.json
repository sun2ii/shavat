{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":55,"content":[{"type":"heading","content":["Balegillediidba-Babse-goled"]},{"type":"hebrew_subtitle","content":["David we-namaked-Masquilʼye-nugad."]},{"type":"hebrew_subtitle","content":["Namakmalad-e-iduedga soglesad: Neginotʼba namakoye."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummadye, an bese-goled be an-itoge,","poem":1},{"text":"an bese-wilenaid mer be an-itosuli gue.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Be an-itoge, be an-abin-imake.","poem":1},{"text":"Ar an-surbinsa-itogedi, anga gwage-bogidikid uksulid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dule-isdarmalad-sabsur-ibmar-soged an dobe itoged,","poem":1},{"text":"dule-isganamar-e-sabsur-dule-imaked wile-ito an-imaked,","poem":2},{"lineBreak":true},{"text":"ar gakansaar angi sunmakmalad, nue-urwedgi an-baleginmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ulubgi gwage nunmak an itoged,","poem":1},{"text":"angi bela-bela dobe-burgwed nagunonikid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dobedbali an wawanmakgwichid,","poem":1},{"text":"bela-bela an dobe itoged.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Geb an-sogsad: “¡Nuuyobi an sakan-nikana gadin!","poem":1},{"text":"Adi, an gukusaled. Obunnoged-neg an aminadeled.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"An wegine dikasur wakiteled,","poem":1},{"text":"nega-dulesulidgangi an megisaled.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”Burwa-dummad-idu-wakinnega,","poem":1},{"text":"dukued-negse an gwae wakiteled.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bab-Dummadye, we-dulemar be obeloge,","poem":1},{"text":"e-sunmakmalad aku-ito be imake.","poem":2},{"text":"Ar unnila neggweburgine sabsur-imakmaladbi,","poem":1},{"text":"abin-abin-imakmaladbi an daked.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mutiki, ibgine, e-galu-matusulid-ebirdii damalad,","poem":1},{"text":"e-galu-matusulid-yabali ibmar-isganabi, yamo-dulemar-yardakedbi neg naid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"E-galu-matusulidgindi dule-obelogedbi neg naid,","poem":1},{"text":"e-igar-imbaganbardi dule-wiogedbi, dule-yardakedbi neg naid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ar an-isdarad an-obinge-imaksana, an na san bargasanad.","poem":1},{"text":"Ar dule-isdar-an-daked mesagwar an-imaksana, an e-idu dukusanad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ar emigindi, bee be weyob an-imaksad.","poem":1},{"text":"Be an-ai-nuedid. Be anyob dule gumogad.","poem":2},{"text":"Be an-sordad, be an-ai-bur-walikagwadid.","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Be nuedgi anbo-walikaa gudidaenad,","poem":2},{"text":"ai-nuedgi be anbo Bab-Dummadse-goled-neggi gudidaenad.","poem":1},{"text":"Emigindi, bee be angi weyob yolesad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Burgwed ukiagwar an-isdarmaladgi yolesunna,","poem":1},{"text":"neg-uangi napa-yaba dula odelesunna,","poem":2},{"lineBreak":true},{"text":"ar e-neg-yaurgi ibmar-isganabi nikad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ar andi Bab-Dummadse goloed,","poem":1},{"text":"Bab-Jehová an-bendakoed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wakdaradba, yorukudba, mutikidba an surbinsa-itogedgi Bab-Dummadse goloed,","poem":1},{"text":"edi an-itogoed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ar dulemar bukidar angi aibinmar-inigwele,","poem":1},{"text":"Bab-Dummaddi bogidikidgi angi-bila-ononanaidgi an-onogoed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bab-Dummad-gusgu-dummadga-maiguad an-itogoed.","poem":1},{"text":"Bab-Dummad an-isdarmalad ibgwensur-imakoed.","poem":2},{"text":"Ar wemar na e-daed ogwasurmalad,","poem":1},{"text":"gwen Bab-Dummad dobsurmarbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dule-isgana dule-ebo-nued-gudiidgi aibined,","poem":1},{"text":"e-igar-mesisadgine annaed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Na e-ibmar-sogedi ochii ibmar-nueganbi soged.","poem":1},{"text":"E-gwagegindi bila-onogedginbi binsanaid.","poem":2},{"text":"Na e-sunmakedi, innikii sunmak itolegenad.","poem":1},{"text":"Degi-inigwele, esyobi dule-naibi-imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Bab-Jehováʼga, be-bukib-binsaed be soge, na e be-bendakoed.","poem":1},{"text":"Ar Bab-Dummad, dule-nued degisadegu-galakudii imakosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Bab-Dummad, bedi dule-isganamar oburgoed,","poem":1},{"text":"napa-gullu-yaa be barmetoed.","poem":2},{"text":"Dule-ablis-eodimaladi, dule-emar-yardakdimaladi, undar-dikasur dula-gudii guosurmalad.","poem":1},{"text":"Ar andi begi bensulid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}