{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":56,"content":[{"type":"heading","content":["Bensulidgi Bab-Dummadse-goled"]},{"type":"hebrew_subtitle","content":["Namakmalad-e-iduedga soglesad:"]},{"type":"hebrew_subtitle","content":["Sapur-nuu surgar-war-birgi namaksidaedba namakoye."]},{"type":"hebrew_subtitle","content":["Deunni, Filistea-dulemar Gat-neggweburgi David-gasgusmalad."]},{"type":"hebrew_subtitle","content":["Agi David Mictam-narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummadye, wile be an-dake,","poem":1},{"text":"dulemar an-balegindii nanaed.","poem":2},{"lineBreak":true},{"text":"Bane-bane sae-an-dakmaladi, an-wiodimalad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bane-bane an-isdarmaladi, an-balegindii nanaed.","poem":1},{"text":"Dule-san-dummarba-imakdimaladi, bukidar angi gwisgudimalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"An dobe-itoalile,","poem":1},{"text":"begi an benguosulid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Dummad, an begi bensulid,","poem":1},{"text":"an be-gayaburba odummoged.","poem":2},{"text":"Bab-Dummad, an begi bensulid,","poem":1},{"text":"an dobe-itosulid.","poem":2},{"text":"Degisoggu, ¿ar igi dule an-imakosunna?","poem":1},{"text":"Dule akar an-imakosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bane-bane an-sunmaked oakaloddamalad,","poem":1},{"text":"gusgu an-oakalogedgi binsadamalad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Danakwaa ambikusdamalad,","poem":1},{"text":"na dukusdamalad.","poem":2},{"text":"An-oburgwed na yeer-itomalad.","poem":1},{"text":"Yamo arbakee an-ibmar-imaked dakdimalad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Dummad, we-dulemar be sabsur-odurdaksun.","poem":1},{"text":"Melle begi wakinnega be imako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"An-bukib-binsadiid be nue-wisid.","poem":1},{"text":"An-ibyanis-aryodiid be daksabalid","poem":2},{"text":"¿Ar we-ibmar be-gardagi narmakar maisursi?","poem":1}]},{"type":"verse","number":9,"content":[{"text":"An-bendakega na bese gotele, an-isdarmalad duurmakdoed.","poem":2},{"text":"Ibmar-soggwen an wisid:","poem":1},{"text":"Bab-Dummad, nue anba naid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Dummad, an begi bensulid,","poem":1},{"text":"be-gayaburba an odummoged.","poem":2},{"text":"Bab-Jehová, an begi bensulid,","poem":1},{"text":"be-gayaburba an odummoged.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Dummad, an begi bensulid,","poem":1},{"text":"an dobe-itosulid.","poem":2},{"text":"Degisoggu, ¿ar igi dule an-imakosunna?","poem":1},{"text":"Dule akar an-imakosuli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bab-Dummad, an be-asabinni ibmar-saoye-an-sogsadi, angi siid.","poem":1},{"text":"Ibmar-uklegedi, an bega ukoed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bab-Dummad, burgwedgi be an-ollorsasad.","poem":1},{"text":"Igar-bulegangi be an ollor-imaksad.","poem":2},{"lineBreak":true},{"text":"Adi, be-asabinni, neg-meegwadgi dula-nanadii guegar.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}