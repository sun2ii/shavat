{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":57,"content":[{"type":"heading","content":["Dule-an-baregindimaladgi be an-ollorsae"]},{"type":"hebrew_subtitle","content":["David, Saúl-idu akwasaila-ollo-yaba dukudigusgu, we-namaked narmaksad. Namakmalad-e-iduedga soglesad:"]},{"type":"hebrew_subtitle","content":["We-namaked, Melle-obelogoye-nugad-namaklegeyobi, namakoye."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummadye, wile be an-dake,","poem":1},{"text":"Bab-Dummadye, wile be an-dake, ar begi an bensulid.","poem":2},{"text":"Igi gannir e-sakan-urba na e-mimmigan odukue,","poem":1},{"text":"deyobi, bonigan-berguedse, be an-odukue.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bab-Dummad-Bur-Biriginedse an binnasuli goled.","poem":1},{"text":"We-Bab-Dummad angi nued binsamaidaed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Dummad, dule-an-isdarad-an-baregindiidgi-an-bendakega, e-gangued, nibneg-akar anse oyogoed.","poem":1},{"text":"Bab-Dummad e-sabgued, e-igar-napiragwad anga oyomaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Achumiguryobi, dulemar an-ebiris bukwamalad,","poem":1},{"text":"dulemar an-obelobimalad.","poem":2},{"text":"E-nugarmar, sigumaryobi, warsimaryobi, nanaed.","poem":1},{"text":"E-gwabin, es-suid-datarmakaleyobi gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Degi-inigwele, Bab-Dummad, bedi nibneggi maid.","poem":1},{"text":"Be-gangued-yeerdakleged bela we-napneg-gani naid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"An-iduar saki nasiksamalad.","poem":1},{"text":"An-iduar yaa gwichamalad.","poem":2},{"text":"Naibid-dummad anga uksamalad.","poem":1},{"text":"Degi-inigwele, emar agi na dukin argwachamalad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Dummad, bega namakmalad-namakega,","poem":1},{"text":"an-gwage guagwar naid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"An wakudaryalaba gwisgudagoed.","poem":1},{"text":"An atakalile, gar-arpa, gar-lira, an ogoloed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Dummad, neggweburmar-baigan-abargi be-nug an odummogoed,","poem":1},{"text":"dulemar-baigan-abargi bega an namakoed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ar be-sabgued dummarbasoggu, nibnegse warmaked.","poem":1},{"text":"Be-ibmar-napira-soged nibnegse warmaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bab-Dummad, bedi nibneggi maid.","poem":1},{"text":"Be-gangued-yeerdakleged bela we-napneg-gani naid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}