{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":58,"content":[{"type":"heading","content":["Dule-isganamar-sabsur-odurdakega Babse goled"]},{"type":"hebrew_subtitle","content":["David we-namaked-Mictam narmaksad. Namakmalad-e-iduedga soglesad:"]},{"type":"hebrew_subtitle","content":["We-namaked, Melle-obelogoye-nugad-namaklegeyobi, namakoye."]},{"type":"verse","number":1,"content":[{"text":"Bemar, dule-bulegan-negsedidimalad, ¿ar innikigwadba be negsemamai?","poem":1},{"text":"¿Ar innikigwadba be dulemarga igar-nabomamai? Suli.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Aka bemar na be-gwagegi, unnila ibmar-isgana-imakedgi binsadidimalad.","poem":1},{"text":"Ar bemar, we-napneggi unnila sabsur-ibmar-isgana-imakdidimalad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dule-isganamar amba sapibeneggi-maid-akale, bato isgus danimalad.","poem":1},{"text":"Dule-gakansilimar amba yoo-gwaluleged-akale, bato gakansaar sunmakmalad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"E-sunmaked boni-dummad sediid","poem":1},{"text":"naibe-boni-nikadyobi gudiid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dule-naibe-gaed, naibega sunmaknaigusale, igi-we-naibe, yamo uayasulidaeyob na imake,","poem":1},{"text":"deyobi, dule-isgana, uayasulidaedba ibmar-isgana imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bab-Dummad, dule-isgana-e-nugarmar be bibisge,","poem":1},{"text":"achumigur-ibe e-nugarmar-ungeyob be imake,","poem":2},{"lineBreak":true},{"text":"dule-isgana-e-gargangued be obeloge.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Igi dii napagi-mileder, yogguddae,","poem":1},{"text":"deyob geg gumargina.","poem":2},{"text":"E-warsi-dopee-imakdemalale,","poem":1},{"text":"bitigi e-sigu geg bisgegina.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Igi gole-masi-masid baisursunna berguddae,","poem":1},{"text":"dule-isgana deyob geg gumargina.","poem":2},{"text":"Igi goe-burgwar-aidenonikid, gwen neg dakdasuli,","poem":1},{"text":"deyob dule-isgana geg gumargina.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Igi gagan-ikobiid-dinnagana sabsur-gummakdedae,","poem":1},{"text":"deyobi, dule-isganamar baisur-binsadiidgi gummakena gadin.","poem":2},{"lineBreak":true},{"text":"Dule-isganamar dula-gudimaladgi, bitigi burwa-dummadba selemalana gadin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dule-inniki-gudiidi, dule-isgana-sabsur-odurdaklenai dakalile, weligwar itodoed.","poem":1},{"text":"Dule-isganamar-e-ablisgi dii-dii annanai guoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Agine, dulemar sogdemaloed: “Napirado. Dule-inniki-gudimaladga ibmar-nued ega ukleged.","poem":1},{"text":"Bab-Dummad nue-mai dakledo, ar we-napneggi bela dulemarga igar innikii nabomaid.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}