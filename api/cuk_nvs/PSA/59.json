{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":59,"content":[{"type":"heading","content":["E-isdarmaladgi e-ollorsaega Babse-goled"]},{"type":"hebrew_subtitle","content":["David we-Mictam-namaked narmaksad. Namakmalad-e-iduedga soglesad:"]},{"type":"hebrew_subtitle","content":["We-namakedi, ar igi namaked “Melle-obeloged” namaklege, deyobi namaklegoye."]},{"type":"hebrew_subtitle","content":["Deunni, Saúl, David-oburgwega e-sordamar David-negse barmisgu."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummadye, an-isdarmaladgi be an-ollorsae,","poem":1},{"text":"angi aibinmaladgi be an-bendake.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dule-ibmar-isgana-imakmaladgi be an-ollorsae,","poem":1},{"text":"dule-gindakmaladgi be an-bendake,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ar an-oburgwebimalad.","poem":2},{"text":"Bab-Jehová, an nossulinad, an isgussurbalinad,","poem":1},{"text":"degite, dule-isganamar angi-aibinmalaga na atosmalad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"An ibmar-isgana imaksasur-inigwele, degite, an-oburgwebimalad.","poem":1},{"text":"Bab-Jehováʼye, be gwae-dage, be an-bendakdage.","poem":2},{"lineBreak":true},{"text":"Be dake, igi an be-asabin gwichi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová, be, Bab-Dummad-Bur-Gangued-Nika-Maid.","poem":1},{"text":"Be, Israel-e-Bab-Dummadid.","poem":2},{"text":"Dule-yar-baid-baidgi-bukwamalad-sabsur-odurdakega gwae be dage,","poem":1},{"text":"dule-isgana-emargi-aibinmalad, mer be wiledake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dule-isganamar, mutikidbali achumar-urwedidaedyobi gannar nonidamalad,","poem":1},{"text":"geb neggweburgi bipirmakdidamalad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yogasaar sunmakmalad, emargi yolegar sunmakmalad.","poem":1},{"text":"An-itogosurmaladdeeye sogdedamalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová, ar bedi we-dulemarga be alled,","poem":1},{"text":"bela dule-yar-baid-baidgi-bukwamaladgi be dodoged.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ar be an-ganguedsoggu, an begi bensulid.","poem":1},{"text":"Ar be an-odukuedid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Be, Bab-Dummad-wile-an-daked an-iduoed.","poem":1},{"text":"Bab-Dummad an-isdarmalad-galakued anga oyogoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"An-dulemar mer a-dule-isganamar-iegega,","poem":1},{"text":"mer ilagwen-obelogar be imako.","poem":2},{"text":"Be, Bab-Jehová, sigu-abgaedyob an-irwa-gwisguedid.","poem":1},{"text":"Be-ganguedgi be oaisakie,","poem":2},{"lineBreak":true},{"text":"be-garganguedgi be irgwensur-imake.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Na e-ibmar-isgana-sogedba, e-sunmakedba, emar-ukabsaedba, e-gakansaedba, san-dummarba-imakdimaladba,","poem":1},{"text":"na dukin yardaklemarsun.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bab-Dummad, urwedgi be amar-obeloge,","poem":1},{"text":"mer bar dulagudigumalaga be obeloge.","poem":2},{"text":"Deyobi, bela Israel-yargine wisgumaloed,","poem":1},{"text":"Bab-Dummad bela we-napneg-ugakaase, negdakmaiye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dule-isganamar, mutikidbali achumar-urwedidaedyobi gannar nonidamalad,","poem":1},{"text":"geb neggweburgi bipirmakdidamalad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Masgunned-amiega gaamakdidamalad,","poem":1},{"text":"immelessurmalale, mutikidba urwedidamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bab-Dummad, ar andi be-ganguedgi an namakoed.","poem":1},{"text":"Wakudaryalaba be-dula-wiledakedgi an namakoed,","poem":2},{"text":"ar bedi an-bendakedid.","poem":1},{"text":"An-surbinsa-itoged-ibagi bedi an-dukuedid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Be, an-ganguedid, an bega namakoed, ar bedi, Bab-Dummad, an-dukuedid.","poem":1},{"text":"Bab-Dummad, be an-sabedid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}