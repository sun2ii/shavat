{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":6,"content":[{"type":"heading","content":["Bonigan-abalagi Bab-Dummadse goled"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad. Namakmalad-e-iduedga soglenaid: Neginotʼba-namakoye."]},{"type":"hebrew_subtitle","content":["We-namaked, Seminitʼye nugad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼye, melle ise-urwaledgi be sabsur-an-odurdake,","poem":1},{"text":"melle sae-itogedgi be sabsur-an-imake.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehováʼye, wis be wile-an-dake,","poem":1},{"text":"ar an boniganba nue negoebied.","poem":2},{"text":"Bab-Dummadye, be an-bendake,","poem":1},{"text":"ar an-abagan nue-bibichis itoleged.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Jehováʼye, ¿sanase be an-bendaknonikoe?","poem":1},{"text":"Emide, an nue-naibid-dummad itonaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Jehováʼye, be sabed-nikarbadbali, wis be an-bendakdage,","poem":1},{"text":"mer baisur be an-dake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ar dule-burgwarmaladdi, bar begi binsamamaisulid.","poem":1},{"text":"Ar neg-urbardi, ¿doa be-nug odummogoe? Gwen dule be-nug odummogosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bela-bela an bodiidbali, gege an sagusad.","poem":1},{"text":"Bane-bane mutikidbali gachiyala, an ise-ogormakar maidaed.","poem":2},{"lineBreak":true},{"text":"An-ibyanisbali, an-gas-megedi dinnasurgus naidaed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"An-isdarmalad-nukad, an-ibya an-ibe mommoleded.","poem":1},{"text":"An-ibya, nunmakedbali, nue bar ataksurgusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"¡Dule-isganamar! Be angi bangumala.","poem":1},{"text":"Ar Bab-Jehová, an-bodiid itononikid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Jehová an ese wilesakwaa-gornaid an-itononikid.","poem":1},{"text":"An-ese-gornaid an-itosad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ar bela an-isdarmaladi, surbinsa-itodmaloed,","poem":1},{"text":"an-isdarmaladi, bingegudmaloed.","poem":2},{"lineBreak":true},{"text":"Bingegudedba wakitemaloed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}