{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":60,"content":[{"type":"heading","content":["Bab-Dummadse bendakleged-egised"]},{"type":"hebrew_subtitle","content":["Namakmalad-e-iduedga soglesad:"]},{"type":"hebrew_subtitle","content":["Bab-Dummad-Dulemarbo-Igar-Mesisad-e-dutu-lirio-nugadba namaklegoye."]},{"type":"hebrew_subtitle","content":["Deunni, Aram-Naharimʼgi, degi, Aram-Sobaʼgi bila-ononaidgi,"]},{"type":"hebrew_subtitle","content":["Joab gannar nonigu, Balu-Nebagi miliambe-gakabo (12,000) Edomʼginmalad ogilosad."]},{"type":"hebrew_subtitle","content":["Agi, David dulemar-odurdakega namaked-Mictam narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummad, bedi anmarse ulusad,","poem":1},{"text":"be anmar-obachad,","poem":2},{"text":"be anmar-wiosad.","poem":1},{"text":"¡Bab-Dummadye, be anmar-bendakdage!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Napneg-naid yeer be ogiglimaksad,","poem":1},{"text":"yeer napamar argas-nanaed.","poem":2},{"text":"E-yaa-argasmaladi be nudake,","poem":1},{"text":"ar binna-binna babatemaigusad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yeer-gangu be-dulamar be wilubdaksad,","poem":1},{"text":"vino-gagbid-gobega be anmar-imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dule-sigu-miemaladgi san-onogega,","poem":1},{"text":"beba-inniki-nanadimaladgala, igar-inniki-maid be oyosad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Be-dulamar-be-nue-sabedi, nabir bendaklegega,","poem":1},{"text":"be-ganguedgi be anmar-bendake,","poem":2},{"lineBreak":true},{"text":"be anmar-abinsae.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bab-Dummad, be-neg-islidikidgi be weyob sogsad: “An Siquem-neggwebur-mimioedgi, weligwale an itoged.","poem":1},{"text":"An Sucot-neba-naid-ilemakoedgi, weligwale an itoged.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Galaad, angadga gued,","poem":1},{"text":"Manasés, angadga gued.","poem":2},{"text":"Efraín, an-bormo-gurginga gued.","poem":1},{"text":"Judá, an-gaapoledga gued.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Moab, an-argan-enukedga gued.","poem":1},{"text":"Edomʼgi, an-sapat bikiin an metoed.","poem":2},{"lineBreak":true},{"text":"Filistea-neggweburgi, gandikidba an gormakoed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"¿Doa, neggwebur-gandikidse an-nidoe?","poem":1},{"text":"¿Doa anga, Edom-yalase-aibillemaid oyogoe?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Dummad, ¿bee be anmar-obachagussursi?","poem":1},{"text":"Bab-Dummad, bar be anmarga sorda-bila-onomalad-bendakdisurgusad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dule-isdarmaladgi-nakwega be anmar-imake.","poem":1},{"text":"Ar dulemar anmar-bendakele, anmar gwen igarga guosulid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bab-Dummad, anmar bebali unnila anmar-isdarmaladgi nakoed.","poem":1},{"text":"Be anmarga, anmar-isdarmalad obelogoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":12}