{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"heading","content":["Bab-Dummad-egi-nakulediidgi bensulid"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad. Namakmalad-e-iduedga soged: We-namaked Neginotʼba namaklegoye."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummadye ise-gollar an bese-goled, wis be an-itoge,","poem":1},{"text":"an bese-ibmar-egised, wis be an-itoge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"An-yargi yeer-bangu an gudiidba, surbinsa-an-itogedba, an bese goled.","poem":1},{"text":"Akwasaila-matusulidse be an-sede.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Dummad, bee be an-odukuedid.","poem":1},{"text":"Bee be, neg-gandikidyob an-isdarmaladgi be an-bendakedid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Dummad, be-dordoneggi degisadegu an gudii gubied,","poem":1},{"text":"be an-edarbedigu an be-abeged.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Dummad, an bega ibmar-imakoye-ise-sogar-sogsad be itosad.","poem":1},{"text":"Be-nug-odummodimaladga-yar-be-uksadi, be anga uksamogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Rey-suiti-gudii-guega be imake.","poem":1},{"text":"We-napneggi degisadegu-gudiguega be imake.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Be-sogedba negsemaigu be imake.","poem":1},{"text":"Be-sabgued-nikadba, be-igar-napiragwadba, egi nakuledii be imake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Weyob be-nuggi namakdii an guoed,","poem":1},{"text":"ibmar-an-bega-imakoye-sogsad bane-bane an bega imakdii guoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}