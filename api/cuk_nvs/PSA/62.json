{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":62,"content":[{"type":"heading","content":["Bab-Dummadginbi unnila obunnoleged"]},{"type":"hebrew_subtitle","content":["David namakmalad-e-iduedga namaked narmaksad. Jedutúnʼye-nugadga narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummadginbi an neg-bogidik amied,","poem":1},{"text":"Bab-Dummadgi an-bendakleged danikid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Dummadbi anga akwasailaga gued,","poem":1},{"text":"Bab-Dummadbi bela-bela-an-bendakedid.","poem":2},{"text":"An egi dukued amied,","poem":1},{"text":"agala, gege an galakued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"¿Ar sanadse bemar dule-gwensakgi yolenanai gumaloe?","poem":1},{"text":"Galu-aimukudani-gwichiyobi, olaegala, egemaknanaiyobi,","poem":2},{"lineBreak":true},{"text":"emide, bemar dule-gwensak imaknanaid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Unnila a-dule-wiogega gunanaid,","poem":1},{"text":"e-nug-dummarba-nikad-oichogega gunanaid.","poem":2},{"text":"Surbinsa gakansaedbina itomalad,","poem":1},{"text":"ar e-sunmakeddi ibmar-nuedbi sogmalad,","poem":2},{"lineBreak":true},{"text":"e-gwagegindina, emar-ukabsaedginbi binsadimalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"An-gwage Bab-Dummadginbi neg-bogidikid amied,","poem":1},{"text":"Bab-Dummadginbi unnila an bensulid nikad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Dummadbi anga akwasailaga gued,","poem":1},{"text":"Bab-Dummadbi bela-bela-an-bendakedid.","poem":2},{"text":"An egi dukued amied,","poem":1},{"text":"agala, gege an galakued.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Dummad bela-bela-an-bendakedid, egi an wergudiid.","poem":1},{"text":"Unnila Bab-Dummadgi an-gangued siid, an-odukuedbalid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"¡Unnila Bab-Dummadginbi be bensuli gumalo!","poem":1},{"text":"¡Bab-Dummad-asabin be nadele, bela be-boni-nikad ega be sogo!","poem":2},{"lineBreak":true},{"text":"¡Ar Bab-Dummad, anmar-akwediidid!","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dule-wilemalad baisursunna bergued,","poem":1},{"text":"dule-mani-nikamalad baisursunna bergumogad.","poem":2},{"lineBreak":true},{"text":"Ebogwad nibirgi oaidiksaele, amba ukugwaled.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ibmar-isganagi-mani-amilegedgi melle be binsaed galemalo,","poem":1},{"text":"ibmar-atursalegedgi mer be binsamala.","poem":2},{"text":"Amba ibmar-nue-bukidar-bega-mergude be dakele,","poem":1},{"text":"mer we-ibmarginbi be binsadii gumalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bab-Dummad weyob-ilagwen-sunmaksagusadi, ilabo an itosgusad:","poem":1},{"text":"Bab-Dummadgi gangued daniye.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bab-Dummad, bede bela-bela emar-wile dakmaiye,","poem":1},{"text":"bede dule-e-ibmar-imakedba, sogedba be naboye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}