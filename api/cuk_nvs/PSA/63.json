{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"heading","content":["Bab-Dummad dule-yeer-ito-imakedid"]},{"type":"hebrew_subtitle","content":["David Judá-nega-dulesulidganba-gudigusgu, we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"¡Bab-Dummad, be an-Bab-Dummadid!","poem":1},{"text":"¡Bolegoedba an be-amioed!","poem":2},{"text":"An uku-uku-itogeyob an bebina soged,","poem":1},{"text":"an-sana bela bebina soged.","poem":2},{"text":"Ar igi dule nega-dulesulidganba dii-satedgi dii-amididae,","poem":1},{"text":"deyobi, an be-amied.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bab-Dummad, an be-gangued-yeerdakleged-dakega,","poem":1},{"text":"bese-goled-neggi an be-dakbied.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dula-gudiguedba be-sabgued bur-nuedid.","poem":1},{"text":"A-ulale, an bega namakoed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dula-gudiidgi an be-nug odummodii guoed.","poem":1},{"text":"An be-nug-odummogega an-argan an onakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mas-nued-immerba-guchayobi an yeer-itogoed.","poem":1},{"text":"An yeer-itogedgi bega namakoed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"An megidele, an begi binsamaidaed,","poem":1},{"text":"bela mutikidbali, an begi binsamaidaed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ar be an-bendaksad,","poem":1},{"text":"deyobi, be-an-bendaksadgi an yeer-itoged.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Andi begi alakwaa naid,","poem":1},{"text":"ar be-gargangued an-bendaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ar dule-an-oburgwebimaladdi bergumaloed,","poem":1},{"text":"nega-urbali argwanmaloed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Es-suidgi oburgwilemaloed,","poem":1},{"text":"achu-sapur-masga gumaloed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar reydi, Bab-Dummadgi weligwar-itogoed.","poem":1},{"text":"Dule Bab-Dummad-nuggi-ibmar-ise-sogar-soged","poem":2},{"text":"weligwaledgi Baba-Dummadga namakmaloed.","poem":1},{"text":"Ar dule-gakansilimardi gaya-maklemaloed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}