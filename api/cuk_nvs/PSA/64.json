{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"heading","content":["Babse-goled, dule-isganamargi an-bendakye"]},{"type":"hebrew_subtitle","content":["David namakmalad-e-iduedga we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummadye, an-ibmar-isdar-itogedi, an bega sognaidi, wis be itoge.","poem":1},{"text":"Bab-Dummadye, be an-bendake,","poem":2},{"lineBreak":true},{"text":"an-isdarmalad dobe an itodiid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dule-isganamar-anbina-itosgudimalad-idu, be an-odukue.","poem":1},{"text":"Dule-ibmar-isgana-imakmaladgi, be an-onoge.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Es-suid-nugar-datarmakle-daebayobi e-gwabin-duku imakmalad.","poem":1},{"text":"Igi sigu-milege, debayobi, e-gwabin-duku gayaburba-isganagan dulegi mied.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dule-gwen-neg-oakalossulidgi, yamo arbakee gwichiguddamalad,","poem":1},{"text":"wile-gwen-daksuli, dulegi aibitedamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dule-isganamar, na muchub-muchub e-igar-isganagi ogannobukwadamalad.","poem":1},{"text":"Idu igar-amibukwadamalad, igi imakmalodibeye.","poem":2},{"text":"Sogdedamarbalid:","poem":1},{"text":"“¿Ar doa anmar-dakosunna?”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dule-isganamar igar-isgana-nue-amibukwadamalad, sogdamalad: “Anmar igar-napiragwad amibukwamalad.”","poem":1},{"text":"Dule-binsaedi ibiyobi, nue-akusunna itolege.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bab-Dummaddi a-dulemargi e-sigu midoed.","poem":1},{"text":"Wissuli-bukwadgi galedamaloed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dukin na e-gwabin-sunmakedgi sabsur-odurdaklemaloed.","poem":1},{"text":"Doa deyob dakdagoe, egi dodoar sunmakdoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bela dulemar-bukwadgi dobed nagunonikoed.","poem":1},{"text":"Degidgine, Bab-Dummad-ibmar-dummagan-imaksadgi sunmakdemaloed.","poem":2},{"lineBreak":true},{"text":"Agine, magar Bab-Dummad-ibmar-imaksadgi binsadmaloed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dule-nuegan, Bab-Jehováʼgi wergudmaloed,","poem":1},{"text":"egi bensuli gudmaloed.","poem":2},{"lineBreak":true},{"text":"Dule-gwage-nuegan yeer itodmaloed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}