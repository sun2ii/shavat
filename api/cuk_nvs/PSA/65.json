{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":65,"content":[{"type":"heading","content":["Bab-Dummad-nug odummolegergebed"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad. Namakmalad-e-iduedga soglenaid."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummad-Sión-yargi-maid, be-nug odummolesun.","poem":1},{"text":"Ibmar-imakmaloye-sogsamalad bega imakmalargebed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Dummad, dule-bese-goled be itodaed,","poem":1},{"text":"degisoggu, bese bela dulemar nonimaloed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Anmar-ibmar-isgana-imaked anmargi obined,","poem":1},{"text":"degi-inigwele, anmar-isgued be anmarga osulodaed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dule-wargwen be susale, we-dulegi nued binsalesad.","poem":1},{"text":"We-dule, be-neggi-gudiguega, bese be senonidaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bab-Dummad, be anmar-Abonogedid.","poem":1},{"text":"Ibmar-innikigwadba be anmar-abin-imakdaed.","poem":2},{"text":"Dulemar we-napneg-naid-ugakaase-bukmaladi bela begi bensurmalad.","poem":1},{"text":"Dule-demar-obakar-dikasur-bukmaladi begi bensurmarmogad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Dummad, bee, be-ganguedgi yalamar be nasiksad,","poem":1},{"text":"agi be-gangued be oyomaid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bee, muu-billi-uurmakmaid obogileged,","poem":1},{"text":"muu-billi-welegan-uurmakmaid bogidik be imaked,","poem":2},{"lineBreak":true},{"text":"dulemar-oimakbukwad be osuloged.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Degisoggu, dulemar dikasuli-bukmalad be-ibmar-dakledisulid-imaked dobdamarsunnad.","poem":1},{"text":"Dulemar-dad-nakwedsik-bukmalad, dad-argwanedsik-bukmalad be weligwar-ito imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bee be, napa nue-akwed.","poem":1},{"text":"Napagi gatik ibmar sanmakega egi be dii owied.","poem":2},{"text":"Dian-dummad-Babagadi gege-dinguedi,","poem":1},{"text":"bela ibmar-sanmakega imaked.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Napa-guremaladgi dii be owied,","poem":1},{"text":"agi dii be osurmaked,","poem":2},{"lineBreak":true},{"text":"diigi napa be odutumaked.","poem":2},{"text":"Napagi ibmar sanmakega be imaked.","poem":1},{"text":"Weyobi, be-dulamarga-be-mas-ukega, napa guakwaa be-dulamarga be nasiked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Be birga-nued nasikmaid,","poem":1},{"text":"be ibmar unniguar-nika imakmaid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nega-dulesulidgangi gaganmar aradikid, yar-mullugan ber weligwaled.","poem":1}]},{"type":"verse","number":13,"content":[{"text":"Nebagangi sibadmar, sibad-wawaadmar, obiryamakded,","poem":2},{"lineBreak":true},{"text":"orosgi-dakleged agi nue naibalid.","poem":2},{"text":"¡Bela agine ibmar-durgan oimakded!","poem":1},{"text":"¡Bela namakedibimalad!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}