{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":66,"content":[{"type":"heading","content":["Be-ibmar-imaksadi, gegerdaklemaladid"]},{"type":"hebrew_subtitle","content":["Namakmalad-e-iduedga namaked narmaklesad."]},{"type":"verse","number":1,"content":[{"text":"Bela-dule-we-napneggi-bukwamalad, weligwaledgi Bab-Dummad-e-nug odummomar.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"E-nug-dummarbaadga namakmar,","poem":2},{"lineBreak":true},{"text":"gandikidgi e-nug odummomar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Dummadga sogmar:","poem":1},{"text":"“¡Be-ibmar-imakedi, geger-dakleged!","poem":2},{"text":"Be gandik-maisoggua,","poem":1},{"text":"be-isdarmalad be-urbaligwa gudimalad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bela-dule-we-napneggi-bukwad be-nug odummomaloed,","poem":1},{"text":"bega namakmaloed, be-nuggi namakmaloed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¡Dagmala! Bab-Dummad-ibmar-imaksad dakdamala.","poem":1},{"text":"Anmarga-ibmar-gegerdaklemalad-imaksad be dakdamala.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Dummad demar dinnaa imaksad,","poem":1},{"text":"diwar dinnaa imaksabalid.","poem":2},{"text":"Degidbali, dulemar neg-dinnagwadgi nabir-obaksamalad.","poem":1},{"text":"Degisoggu, anmar Bab-Dummadgi wergumarsunna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Dummad gargandikidba degisadegu negsemaid,","poem":1},{"text":"bela-dule-gudimaladgi nakulediid.","poem":2},{"lineBreak":true},{"text":"Dulemar-eba-dasurmalad, gwen-abin gwisguosurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bela dulemar, Bab-Dummad-nug odummomarsun.","poem":1},{"text":"Bab-Dummadga-namaklenaid, bela itomalaga imakmarsun.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ar Bab-Dummad anmar-san bendaksad,","poem":1},{"text":"mer-galakuega anmar-imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bab-Dummad, bee be, anmar-wilubdaksad,","poem":1},{"text":"mani-swilidik-imaklegeyob be anmar-imaksad,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"sakigi-galegega be anmar-imaksad,","poem":1},{"text":"nunmaked-dummad be anmargi ogwisnonikid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dulemar anmar-nonogi-annaega be imaksad,","poem":1},{"text":"soo-buleganba-ibitogega be anmar-imaksad,","poem":2},{"text":"dii-buleganba-ibitogega be anmar-imaksad.","poem":1},{"text":"Emisgindi be, neg-nuedse anmar-ogwisgunonikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"An bese-goled-negse ibmar-ogumakar-ukega an nonikoed,","poem":1},{"text":"an bega ise-sogar ibmar-imakoye-sogsad-imakega an nonikoed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"An bonigan-abalagi-gunaidgi,","poem":1},{"text":"an bega ise-sogar ibmar-imakoye sogsa gusad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"An bega ibmar-ogumakegala, we-ibdurgan-waladummagan ukoed:","poem":1},{"text":"Sibad-wawaad-machergan, moli-bebe-nikad-machergan, sibad-machergan, an bega ukoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bab-Dummad-dobekwaa-gudimalad, ¡dagmala! ¡Itodamala!","poem":1},{"text":"Bela Bab-Dummad-anga-ibmar-imaksad, an bemarga sogoed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bela-belad gandikidbali Bab-Dummadse an gocha gusad,","poem":1},{"text":"an e-nug-odummonai gusad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ar an-gwagegi an isdar binsasana,","poem":1},{"text":"Bab-Jehová an-itossulinad.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Emidi, Bab-Dummad an-itononikid,","poem":1},{"text":"an-wilesakwaa-gornaid itosad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"¡Bab-Dummad-e-nug odummolesun!","poem":1},{"text":"An-ese-gornaid nue an-itosad,","poem":2},{"lineBreak":true},{"text":"e-sabgued gwen angi obachasurgusad.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}