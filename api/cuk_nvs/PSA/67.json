:1},{"text":"Napneggi dule-yar-baid-baidgi-bukwamalad-e-iduedga be gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bab-Dummad, dulemar be-nug odummomala,","poem":1},{"text":"bela dulemar be-nug odummomala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Napneggi bela ibmar-durba sanmakoed,","poem":1},{"text":"Bab-Dummad, anmar-Bab-Dummad, anmargi nued-binsaoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Dummad, be anmargi nued-binsaoed,","poem":1},{"text":"bela we-napneggi-yarmar-nanaid-ugakaase Bab-Dummad-dobgumaloed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}