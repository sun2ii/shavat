{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":68,"content":[{"type":"heading","content":["Bab-Dummad, Sinaí-yala-e-ibedid, Neg-Islidikid-e-ibedid"]},{"type":"hebrew_subtitle","content":["David we-namaked namakmalad-e-iduedga narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummad, dakebinne. Be-isdarmalad bela be oaisakisun.","poem":1},{"text":"Dule-be-isdardakdimalad bela be-idu be oduurmaksun.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Igi waa burwaba yogguddae,","poem":1},{"text":"debayobi, Bab-Dummadi dule-isganamar-imakoed.","poem":2},{"text":"Igi baka-gwallu soo-abin daluddae,","poem":1},{"text":"debayobi, dule-isganamar Bab-Dummad-abin bergudoed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dule-innikidamaladdi weligwale itomaloed,","poem":1},{"text":"Bab-Dummad-asabin yeer itomaloed,","poem":2},{"lineBreak":true},{"text":"weligwaledbali oichomakdemaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Dummadga be namakmar,","poem":1},{"text":"E-nuggi-namaklegedgi be namakmar,","poem":2},{"text":"mogir-billigangi-sii-nanaed-e-nug be odummomar,","poem":1},{"text":"¡Bab-Jehováʼgi wergumala!","poem":2},{"lineBreak":true},{"text":"¡E-asabin be namakmala!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Dummad-e-neg-islidikidgi-maidi, dulemar-sergan-sated-e-babad,","poem":1},{"text":"ome-ei-sui-burgwismalad-e-bendakedid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Dummad, dule-wilesakwaa-walagwen-gudimalad, neguya-nikuega imaked,","poem":1},{"text":"dule-galesbukwamalad-onogedid.","poem":2},{"lineBreak":true},{"text":"Dule Bab-Dummadba-ibsadisurmaladdi, napa-isganagi ambikuoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bab-Dummad, be Israel-dulemar-abargi-noargua,","poem":1},{"text":"nega-dulesulidganba be idu-nadapgua,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"napnega giglimakdegusad, mogir dii-owidegusad,","poem":1},{"text":"Sinaí-yala, be-abin giglimakdegusad.","poem":2},{"text":"Deyobi, Sinaí-yala Bab-Dummad-abin gusad,","poem":1},{"text":"deyobi, Sinaí-yala Israel-e-Bab-Dummad-abin giglimaksad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Dummad, bedi bela-belad dii-owisagusad,","poem":1},{"text":"be-dulamar geggus-danimargua, be e-niga-ogannosad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Dummad, a-napagine, be-dulamar ambikusad,","poem":1},{"text":"dule-wilegedgi be nued-binsaedgi ega napa-nued be nasiksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bab-Jehová, e-gayaburba uksad,","poem":1},{"text":"omegana mili-milibali (1,000-1,000), a-gayaburba-nued weyob sogmalad:","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Reymar duurmakdemalad,","poem":1},{"text":"sorda-bila-onomalad duurmakdemalad.","poem":2},{"text":"E-isdarmalad-ibe-ibmar-sulesmaladi, omegan e-neggine mimidmalad:","poem":1}]},{"type":"verse","number":13,"content":[{"text":"Ibmar manigi-sobarmalad, orgi-sobarmalad, mimidmalad.","poem":2},{"lineBreak":true},{"text":"Ar bemardi unnila sibad-wawaad-abargi meremai gusmalad.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bab-Dummad-Bela-Gangued-Nikadi, reymar-oakinnaigua,","poem":1},{"text":"Salmón-yala-birgi dambed-sibudik-sibudik-batemaibayobi reymar-imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Basán-yalagan, yalagan-dummagan nanaed.","poem":1},{"text":"Basán-yalagan-e-billigan matusuli nanaed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yala-dummagan, ¿ibiga be Bab-Dummad-yala-nug-imaksadgi be nobe itomala?","poem":1},{"text":"Ar Bab-Jehová degisadegu agi mai guoed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bab-Dummad-e-moli-ur-bila-onomaladi, mili-miliba mergued (1,000-1,000).","poem":1},{"text":"A-abalagine, Bab-Jehová Sinaí-yalase nonikid,","poem":2},{"lineBreak":true},{"text":"e-neg-islidikid-yaba dogenonikid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bab-Dummad-Jehová, niba be nakwisgua, dule-galesmalad beba be sesa gusad.","poem":1},{"text":"Dulemar-ibmar-bega-binsa-uksad be susad,","poem":2},{"text":"dule-uayasulidamalad-e-ibmar be susad.","poem":1},{"text":"Adi, be be-dulamar-abargi gudii guegar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"¡Bab-Jehová-nug odummolesun!","poem":1},{"text":"Bab-Dummad-anmar-abonogedi, iba-irbali anmar-bendakmaiguad.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Anmar-Bab-Dummadi, dule-bendakmaidid.","poem":1},{"text":"Bab-Jehová-Bur-Dule-Dummad burgwed-igargi anmar-onogedid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Bab-Dummad, dule-e-isdarmalad-nonogi annaoed,","poem":1},{"text":"e-nono-binsaed-isganabi-sediid ei sagamakoed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bab-Jehová anmarga sogsad: “Basán-akale, gannar an be-barmidagoed.","poem":1},{"text":"Demar-mata-wilaganba gannar-naega an be-imakoed.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Be-naga, be-isdarmalad-e-ablisbi-moodo-guega an imakoed.","poem":1},{"text":"Be-achumar we-ablis elomaloed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Bab-Dummad, be-Neg-Islidikidgi dulemar-yaryarmakmamaidi, magar dakleged.","poem":1},{"text":"Dule-duurmakmaidi, an-Bab-Dummadgadid, an-Reygad gued.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Dule-namakmaladi idumamaid,","poem":1},{"text":"a-yalabali, yagana gar-panderetaʼmar ogornadapid,","poem":2},{"lineBreak":true},{"text":"solaba dule-gar-ogormalad nadapmogad.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Danar-bukwadgi Bab-Dummad-nug be odummomalo,","poem":1},{"text":"Israel-wagan, Bab-Jehová-nug be ogannomalo.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Benjamín-wagan we-dulemar-iduedga nadapid,","poem":1},{"text":"amar-yalabali, Judá-dulemar-e-dummagan bukidar nadapmogad,","poem":2},{"text":"solanapi, Zabulón-dulemar-e-dummagan,","poem":1},{"text":"Neftalí-dulemar-e-dummagan nadapmarmogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Bab-Dummad, be-gargangued be oyoge,","poem":1},{"text":"Bab-Dummad, be anmar-bendakegala be-gangued-oyosgusadi, be oyobali.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Bese-goled-neg Jerusalén-neggweburgi-siid-ulale,","poem":1},{"text":"reymar bega ibmar ukmaloed.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Bab-Dummad, we-ibdula-masarganbalidga sabsuli be ibmar-soge.","poem":1},{"text":"Moli-bebe-nikad-machergan-ursilimaladga, ise-sabsuli ega be ibmar soge.","poem":2},{"text":"Yarmar-baiganbali, moli-bebe-nikad-sapinganayob-damaladga, ise-sabsuli ega be ibmar soge.","poem":1},{"text":"Ibmar-bela-bela-nikubiedba dulemar-sabsuli-imakdiidga, sabsuli be ibmar soge.","poem":2},{"lineBreak":true},{"text":"¡Dule-bila-onogedgi-binsadimalad be oaisakisun!","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Egipto-akale, dule-sapin-dummagan danimaloed,","poem":1},{"text":"Etiopía-dorgandi, gwae-gwae Bab-Dummadse wilenonimaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Napneggi-dule-bukmalad, Bab-Jehováʼga be namakmala.","poem":1},{"text":"Namaklegedgi Bab-Dummadga be namakmala.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Mogir-negasailaun-nagusmalad-birgi-sii-nanaedga, be namakmala.","poem":1},{"text":"E-sunmaked-itogega-dule-imakedga, be namakmala.","poem":2},{"lineBreak":true},{"text":"E-sunmaked mala-gollomakeyob-goledga, be namakmala.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Bab-Dummad-e-gargangued magar be dakmala.","poem":1},{"text":"E-ganguedi, Israel-neggweburgi maid.","poem":2},{"lineBreak":true},{"text":"E-garganguedi, nibneg-akale oyonaid.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Bab-Dummad, be-Neg-Islidikidgi, bedi, dule-geger-dakleged maid.","poem":1},{"text":"Israel-e-Bab-Dummad, e-neggweburga, gargangued ukedid, niga-gangued ukedid.","poem":2},{"lineBreak":true},{"text":"¡Bab-Dummad-nug odummolesun!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":35}