{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":69,"content":[{"type":"heading","content":["Nunmak-itogedba Bab-Dummadse-binnasur-goled"]},{"type":"hebrew_subtitle","content":["Namakmalad-e-iduedga soged: Igi dutu-lirioʼga-namaklege, deyob namaklemogoye."]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummad be an-bendake,","poem":1},{"text":"ar dii an-gammu-nagagus-naid,","poem":2},{"lineBreak":true},{"text":"ar an didulenaid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Olli-mata-yaagi an dogmaid,","poem":1},{"text":"gwisguega annaed an sated.","poem":2},{"text":"Dii-wilasailad-abargi an naid,","poem":1},{"text":"e-dukeba an selemaid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dule-baidse-bendakleged an budar egisgusad. An gammu dinnagusad.","poem":1},{"text":"An-Bab-Dummadse an-bendakleged-edarbediidba, ataked an yegusad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dule-isdar-an-dakmalad, an-sailagiaba bur bule mergued.","poem":1},{"text":"Bukidar binsarsunna isdar an-dakmalad.","poem":2},{"text":"Isdar-an-dakmalad nue-gangued-nika gudmalad,","poem":1},{"text":"binsarsunna an-oburgwebimalad.","poem":2},{"text":"Ar an ei ibmar atursassulite,","poem":1},{"text":"¿ibu gannar ega an ukosunna?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bab-Dummad, an binsaedsuligudigusad be wisid,","poem":1},{"text":"an-isgued geg begi an odukued.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Dummad-Jehová-Bela-Gangued-Nikad, dule-begi-bensurmaladi, melle an-nukad bingegued be imako.","poem":1},{"text":"Israel-e-Bab-Dummad, dule-be-amidimaladi melle an-nukad suli-suli-itoged be imako.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ar be-nug-ulale, dulemar sunnasur-angi sunmaksamalad.","poem":1},{"text":"An bingedba an-wagar gisii naded.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"An-gwenadgan dule-baidyobi an-daked,","poem":1},{"text":"an-nan-mimmigana akusunna an-dakmalad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"An bese-goled-negbina-nue-soged-ular, egi nue-nobe an itoged.","poem":1},{"text":"Dulemar-begi-isdar-sunmaknanaid angi yolenonimogad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"An bodele, mas-gunsuli an gudele,","poem":1},{"text":"angi dododedamalad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bukib-itoged-mola an yosale,","poem":1},{"text":"angi dodoardamalad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dulemar neggwebur-doged-yawagakgi-bukudamaladi, angi sunmakedibidamalad.","poem":1},{"text":"Mummugana angi namakedibidamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bab-Jehová, andi an bese goledi, be-itolegedba be an-abin-imakdaed.","poem":1},{"text":"Sabed-dummarba-be-nikadba be an-abinsadaed.","poem":2},{"text":"Be sunna an-abonogedba be an-bendaked.","poem":1},{"text":"Bab-Dummadye, ¡emiskwaa be an-bendake!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Olli-mata-dummadgi be an-onoge.","poem":1},{"text":"Melle olli-matagi-doged be an-imake.","poem":2},{"text":"Dule-isdar-an-dakmaladgi be an-onoge,","poem":1},{"text":"dii-wilasailadgi be an-onoge.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Melle diiba-seleged be an-imake,","poem":1},{"text":"melle biryaba-bipirmakega be an-sae,","poem":2},{"lineBreak":true},{"text":"melle napa angi mured be imake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bab-Jehová, be an-abin-imake,","poem":1},{"text":"ar bedi dule-nuedid, be-sabgued dummarba be nikad.","poem":2},{"lineBreak":true},{"text":"Be bela-bela dule-wiledakmaidba, gannar be anse dage.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bab-Dummad, be-mai-idu melle be dukue,","poem":1},{"text":"be an-abin-imake, ar an boni-abargi naid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bab-Dummadye an-walikaa be dage, be an-bendakdage.","poem":1},{"text":"¡An-isdarmaladgi be an-onoge!","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Bab-Dummad, nue be wisid dulemar angi yoledimalad,","poem":1},{"text":"dulemar an-obingegsadimalad,","poem":2},{"text":"dulemar angi dododimalad.","poem":1},{"text":"Bab-Dummad, bela be wisid, doamar an-isdarmalad gumala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dule-angi-dododimalad nue-nunmak an-imaksamalad.","poem":1},{"text":"Emide geg an barsagusad, an bendakleged sated.","poem":2},{"text":"Dule-wile-an-daked an amidiinad, gwen an amissurgusad.","poem":1},{"text":"Dule-wile-an-dakmalad satemalad.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"An-masgi ina-nusu obatismalad.","poem":1},{"text":"An uku-uku-itonaigua, ina-gagbid anga uksamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"E-iba-onobukwadgi, e-masi egi-aibinega be imake.","poem":1},{"text":"E-nasgumaidi, egi-aibinega be imake.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Melle-atakmalaga, amar-e-ibya mommoo be imake.","poem":1},{"text":"Nolloo namalaga, e-gangued ei be sue.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Be-urwed egi gwichigued be imake.","poem":1},{"text":"Be-urwed amargi yoleged be imake.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"E-negmar ollo-ollo-siged be sae.","poem":1},{"text":"Amargi dulemar megsuli be imake.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ar be dule-naibi-imaksad balegichamalad,","poem":1},{"text":"ar be dule-naibi-imaksad-e-nunmakedgi dododmalad.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Wemar ibmar-isgana-imaksadyob be imakmoga.","poem":1},{"text":"We-dulemar melle be wiledako.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"We-dulemar garda-burba-duladgi-e-nug-narmakar-naid be elie.","poem":1},{"text":"Melle dulemar-nueganba e-nug-narmakar be meso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Bab-Dummad, ar andi an uellediid, an nunmak-itodiid,","poem":1},{"text":"be an-ogwiche, be an-bendake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Bab-Dummad, namakedgi an be-nug ogannogoed,","poem":1},{"text":"dog-nuedye-sogedgi be-nug an odummogoed.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"We-ibmar-uklegedi, Bab-Jehováʼga moli-bebe-nikad-ukedba, moli-sapingwagwad-bebe-nikad-ukedba,","poem":1},{"text":"Bab-Jehová bur-yeer itodaed.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Dule-wilegana weyob-dakdagogua, nue-yeer itodmaloed,","poem":1},{"text":"Bab-Dummad-amidimalad-e-gwage gannaledmaloed.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ar Bab-Jehová dule-wilegana-ese-goledi itodaed.","poem":1},{"text":"E-dulemar-galebukwad mesagwar daksulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Nibnega, napnega, muu-billigan, bela-agi-ibmar-bukmalad,","poem":1},{"text":"Bab-Dummad-nug odummosun.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ar Bab-Dummad Sión-yala bendakoed,","poem":1},{"text":"Judá-neggweburmar gannar soboed.","poem":2},{"lineBreak":true},{"text":"Agine na e-dulemar degisadegu ambikuega imakoed.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Be-dulamar-e-wagan, a-yala degisadegu egadga guoed.","poem":1},{"text":"Dule-be-sabmalad, a-yalagi bukwa gumaloed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}