{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":7,"content":[{"type":"heading","content":["Ega igar-nabogega Bab-Dummadse goled"]},{"type":"hebrew_subtitle","content":["David, Benjamín-wagwa-Cus-ibmar-imaksadgi"]},{"type":"hebrew_subtitle","content":["Bab-Jehováʼga Sigaiónʼgi namaksad."]},{"type":"verse","number":1,"content":[{"text":"An-Bab-Dummad-Jehováʼye, be an-bendake,","poem":1},{"text":"ar an begi bendakleged amied.","poem":2},{"text":"¡Dulemar-an-balegindimaladgi be an-bendake!","poem":1},{"text":"¡Amargi be an-ollor-imake!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ar be an-bendaksulile, ¿doa bar an-bendakosunna?","poem":1},{"text":"Dule-baid an-bendaked sated.","poem":2},{"text":"Ar igi achumigur dule-ichimake,","poem":1},{"text":"deyobi, an-isdarmalad an-imakmaloed.","poem":2},{"text":"Ar igi achumigur dule-gunne,","poem":1},{"text":"deyobi, an-obelomaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"An-Bab-Dummad-Jehováʼye, we-ibmar-soggwengi nosa be an-dakdibe:","poem":1},{"text":"An ibmar-isgana imaksadibe,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"an-aigi an nue-yolesdibe,","poem":1},{"text":"an-isdarad-ibe an yogasaar ibmar-susdibe,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"adi, an-isdarmalad an-baleginner, akarsurdo,","poem":1},{"text":"an-isdarmalad an-bargado,","poem":2},{"text":"dii-dii napagi an-oburgwedse angi annamardo.","poem":1},{"text":"An-nug-dummad-nikad obelomalar, akarsurdo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bab-Jehováʼye, be sae-itogedba an-isdarmalad-anse-urwebukwadgi be gwisgudage.","poem":1},{"text":"Anga be igar nabodage.","poem":2},{"text":"An-Bab-Dummadye, anba be nague,","poem":1},{"text":"igar-innikigwadba be anga igar naboge.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Jehováʼye, dulemar-baid-baid be-asabin-ambikuega be imake.","poem":1},{"text":"Nibnega-akar a-dulemar-e-saila-dummadga be gue.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Jehováʼye, be dulemarga igar itosoggu,","poem":1},{"text":"an-ibmar-inniki-imakdiidba be anga igar itoge,","poem":2},{"lineBreak":true},{"text":"an-nossulidba be anga igar naboge.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Jehová, bedi Bab-Dummad-innikigwadid,","poem":1},{"text":"bedi dule-binsaed bela baramied.","poem":2},{"text":"Degisoggu, dule-isganamar-e-ibmar-isgana-imakdimalad be obeloge.","poem":1},{"text":"Dule-nuegandi, melle be osikirmakega imake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bab-Dummad, sigu-abgaedyob an-irwa-gwisguedid,","poem":1},{"text":"Bab-Dummad, na dule-gwage-ulubgi-inniki-binsadimalad bendakedid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Dummad, dulega igar-itogedgine, innikigwadba ega igar nabiroged,","poem":1},{"text":"bane-bane dule-isganamar sabsur-odurdaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ar dule-isganamar, na e-isguedga bukib-binsasulile, amar-idu, Bab-Dummad es-suid-e-nugar ebinoed,","poem":1},{"text":"amar-idu e-warsi guagwar dakbaloed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ar deyopira, Bab-Dummad ibmar-dule-gindakmalad guagwar urbisbalid,","poem":1},{"text":"sigu-sooba-gamalad sobsabalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dule-isgana, igar-isganaginbi binsadaed,","poem":1},{"text":"ibmar-isgana-imakega igar amidaed,","poem":2},{"lineBreak":true},{"text":"geb igar-isgana imaknonidaed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Dule-isgana, yaa-matusur akwisad.","poem":1},{"text":"A-yaa-matusulidgi na dukin argwanoed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dule-isgana, na e-igar-isgana-imaked egi aibinoed,","poem":1},{"text":"e-sabsur-urwed egi aibinoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Bab-Jehová anga igar-inniki-nabosadba, an e-nug odummogoed.","poem":1},{"text":"Bab-Dummad-Bur-Birigined-Jehováʼga, an namaked.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}