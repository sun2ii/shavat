{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"heading","content":["David bendaklegegala Bab-Dummadse goled"]},{"type":"hebrew_subtitle","content":["David na egi-binsamalaga namaked narmaksad."]},{"type":"hebrew_subtitle","content":["We-namaked namakmalad-e-iduedga narmaklesad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummadye, gwae be an-bendakdage,","poem":1},{"text":"Bab-Jehováʼye, gwae be an-irwa gwisgudage.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dule-an-oburgwebigudimalad bela surbinsa be imake.","poem":1},{"text":"Dule-angi-isdar-binsadimalad bela be obingegsae,","poem":2},{"text":"gannar osikirmakega be imake.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Dule-angi-dododimalad, bingedba gannar osikirmakega be imake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Dummad, dulemar-bebina-gudimalad, begi-wergumala, begi-yeer-itomala.","poem":1},{"text":"Dulemar-be-abonoged-igar-sabgudimalad weyob degisadegu sogdii gumala:","poem":2},{"lineBreak":true},{"text":"“¡Bab-Dummad, nue-Bab-Dummad-Bur-Biriginedid!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"An dule-wilegedid, ibmarbina an sogdiid.","poem":1},{"text":"Degisoggu, Bab-Dummadye, gwae be anse dage,","poem":2},{"text":"ar be an-bendakedga gued,","poem":1},{"text":"ar be an-ollor-imakedid.","poem":2},{"text":"¡Bab-Jehováʼye, mer be edarbe!","poem":1},{"text":"Gwae be dage.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}