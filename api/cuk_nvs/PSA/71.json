{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":71,"content":[{"type":"heading","content":["Dador-Babse-goled"]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová, an begi bensulid,","poem":1},{"text":"mer bipisaar bingeguega be an-imake.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Be-igar-innikigwadba be an-bendake, be an-ollorsae,","poem":1},{"text":"wis be an-itoge, be an-bendake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bee be, an-akwasaila-dukuedga gue,","poem":1},{"text":"adi, an ase bali-bali dukudii guegar.","poem":2},{"text":"Bedi an-bendakega be igar uksad.","poem":1},{"text":"Be an-akwasailaga gued, bedi an-ganguedid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"An-Bab-Dummad, dulemar-isgana-e-ganguedgi be an-ollorsae.","poem":1},{"text":"Dule-isgudimalad-e-ganguedgi, be an-ollor-imake.","poem":2},{"lineBreak":true},{"text":"Emar-sabsur-imakmalad-e-ganguedgi be an-ollorsae.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ar bedi, Bab-Dummad-Jehová, an-bendakedid.","poem":1},{"text":"Sapingwagwad-akale, an begi bengudisulid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"An sapidukugi-mai, be an-akwide gusad.","poem":1},{"text":"Bee be, muu-neggi-mai we-napnegse be an-odesad.","poem":2},{"lineBreak":true},{"text":"A-ulale, degisadegu an be-nug-odummodii guoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dulemarga an ibmar-gegerdaklegedyob gued,","poem":1},{"text":"ar bedi an-odukued-gandikidid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Dummad, bali-bali an be-nug odummoged,","poem":1},{"text":"be-ganguedgi, be-yeerdaklegedgi an sunmakdii osedoddaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bab-Dummadye, an seredgusale, mer be an-obano,","poem":1},{"text":"an-gangued bergudele, mer be an-obano.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ar an-isdarmalad angi sunmakmalad,","poem":1},{"text":"an-oburgwebimalad na muchub-muchub angi sunmakmalad,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"weyob sogmalad: “Bab-Dummad we-dulegi bar binsamaisurye.","poem":1},{"text":"Anmar baleginmala, ganamala, ar dule-e-bendaked sated.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bab-Dummadye, mer be angi bangue,","poem":1},{"text":"an-Bab-Dummad, gwae be an-bendakdage.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"An-isdarmalad bingegumarsun, burgwemarsun.","poem":1},{"text":"An-oakalobimalad, bela-bela bingegumarsun,","poem":2},{"lineBreak":true},{"text":"bela-bela oesgudii gumarsun.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ar andi begi degisadegu benguosulid,","poem":1},{"text":"bur bule an be-nug-odummodii guoed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Be-Igar-innikigwad, be-abonoleged-igar, amba an wissuli-inigwele,","poem":1},{"text":"an egi sunmakdii osedodoed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bab-Dummad-Jehová, be-ganguedba-be-ibmar-imaksad an sogoed,","poem":1},{"text":"be-igar-innikigwad an ebinsaoed,","poem":2},{"lineBreak":true},{"text":"unnila abi an ebinsaoed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bab-Dummad, sapingwagwad-akale, be an-odurdaksad,","poem":1},{"text":"amba emise-bakale, an be-ibmar-gegerdaklemalad-imaksadgi an sunmakdiid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bab-Dummad, an-seredgusale, an nono-dableargusale, mer be angi banguo.","poem":1},{"text":"Amba dulemar-danimaloedga be-ganguedgi an sunmakbied,","poem":2},{"lineBreak":true},{"text":"amba yoo-gwalulemaladga be-garganguedgi an sunmakbied.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Bab-Dummad, be ibmar-dummagan imaksad,","poem":1},{"text":"be-igar-innikigwad nibnegse warmakmaid.","poem":2},{"lineBreak":true},{"text":"Bab-Dummad, dule beyobid sulid.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bedi, surbinsa-itolegedba galitonai an-imaksad,","poem":1},{"text":"wile-itolegedba galitonai an-imaksad.","poem":2},{"text":"Degi-inigwele, gannar be an-ogannogoed,","poem":1},{"text":"napa-urba-mai gannar be an-odurguoed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"An-nug-dummarba be imakoed,","poem":1},{"text":"gannar be baisur-itoge an-imakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Deyobi, an bega gar-salterioʼba doggus-nuedye sogoed,","poem":1},{"text":"An-Bab-Dummad, innikigwadba-be-ibmar-imakedgi gar-arpaʼba an bega namakoed,","poem":2},{"lineBreak":true},{"text":"Israel-Bab-Dummad, an bega gar-liraʼba namakoed.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"An bega namakdele, an weligwaledgi bega namakoed,","poem":1},{"text":"ar ade, be an-abonosad.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Deginbali, be-igar-inniki-imaksadgi an sunmakdii guoed.","poem":1},{"text":"An-oakalobimalad nue-bingegusmalad, nug-bipii gusmalad.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}