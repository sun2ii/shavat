{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":72,"content":[{"type":"heading","content":["Reyga-Bab-Dummadse-golleged"]},{"type":"hebrew_subtitle","content":["Salomón we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummad, be-naboged-igar reyga be uke.","poem":1},{"text":"Be-Igar-innikigwadba-be-ibmar-saedi rey-machiga be uke.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Adi, rey, innikigwadba be-dulamarga igar nabogoed,","poem":1},{"text":"wile-itodimaladga innikigwadba igar nudakoed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yalamar, dulemarga neg-bogidikid nasiknonikoed,","poem":1},{"text":"yala-mullugan, dulemarga igar-innikigwad ukoed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Rey, dule-bukib-binsadimaladga igar nabogoed.","poem":1},{"text":"Rey, dule-ibmar-nue-abedimalad-e-mimmigana abonogoed,","poem":2},{"lineBreak":true},{"text":"mesagwar-dule-imakdimaladdi, obelogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¡Rey-nug odummolesun!","poem":1},{"text":"Birga-birgaba rey yar-semai guoed. Igi-dad-ibeler birgabargus-naiyob, nii-ibeler birgabargus-naiyob guoed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Igi-nainugi ibmar-digar-naidgi dii wiardae, deyob guoed.","poem":1},{"text":"Igi dii-wied napa-dutuu imakdae, deyob guoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Rey-ibagangi igar-innikigwad dutu-achunnedyob guoed,","poem":1},{"text":"rey-ibagangi ibmar nasgumai guoed,","poem":2},{"lineBreak":true},{"text":"nii-naid-berguedse ibmarmar nasgumai guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Rey demar-naid-ugakaase yar-semai guoed,","poem":1},{"text":"Éufrates-diwar-maid-akale, bela napaneg-naid-ugakaase, rey yar-semai guoed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dulemar-nega-dulesulidganba-mamaid yokorgi-sindigale, rey-asabin dulluu imakmaloed,","poem":1},{"text":"e-isdarmalad, rey-asabin napa-nagase dulluu imakmaloed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tarsis-e-reymar, dulemar-demar-gakagi-bukmaladi, neggweburgi-mani-galeged reyga ukmaloed.","poem":1},{"text":"Sabá-e-reymar, Seba-e-reymar, ibmar-nuegan-binsa-ukleged reyga ukmaloed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bela reymar yokorgi-sindigale, e-asabin dulluu imakmaloed.","poem":1},{"text":"Dulemar-yar-baid-baidgi-bukmaladi, bela ega-arbamaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Rey, dule-ibmar-nue-abediidba wilesagwa-gordiidi bendakoed.","poem":1},{"text":"Dule-wile-itodiid, dule-e-bendakoyob-binsadiid, rey bendakbaloed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Rey, dule-wileged nue-wile dakbaloed,","poem":1},{"text":"dule-ibmar-nue-abediid nue-wile dakbaloed,","poem":2},{"lineBreak":true},{"text":"dule-wilegana-abonogoed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mesagwar-imaklediidgi dule-onogoed,","poem":1},{"text":"sabsur-imaklediidgi dule-onogoed,","poem":2},{"lineBreak":true},{"text":"ar dule ega bela-bela ibnuedga gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"¡Rey-nug odummolesun!","poem":1},{"text":"Sabá-ormar ega uklesun.","poem":2},{"text":"Bali-bali ega Babse-gorlesun.","poem":1},{"text":"Bane-bane egi ise-nued-binsalesun.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bela-napamargi, ibmar-gwag-gullemalad bukidar nikusun.","poem":1},{"text":"Bela yalamar-birgi, Líbano-yargi-ibmar-gwag-gullemalad-nikayobi nikusun.","poem":2},{"lineBreak":true},{"text":"Dulemar, gagan-nainugi-ainieyobi, neggweburgi mergusun.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Degisadegu rey-nug biledii gusun,","poem":1},{"text":"dad-ibeler-naiyob e-nug naguoed.","poem":2},{"text":"Bela dule-yar-baid-baidgi-bukmaladi rey-nuggine, dule-baigangi ise-nued-binsadii gumarsun,","poem":1},{"text":"Bab-Dummad-egi-nued-binsasye sogmarsun.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Israel-e-Bab-Dummad-Jehová-nug odummolesun,","poem":1},{"text":"unnila abi ibmar-gegerdaklemalad-imaked maid.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"¡Degisadegu, e-nug-gandikid odummoledii gusun!","poem":1},{"text":"¡Bela napneggi e-yeerdakleged neg-ganai gusun!","poem":2},{"lineBreak":true},"¡Deyob-gusun!"]},{"type":"line_break"},{"type":"verse","number":20,"content":["Isaí-machi-David, Bab-Dummadse-goled-narmaksadi, wese bergunaid."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}