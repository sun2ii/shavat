{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":73,"content":[{"type":"heading","content":["Dule-isganamar igi berguoe"]},{"type":"hebrew_subtitle","content":["Asaf we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Ibibayobi, Bab-Dummad Israel-dulemargi nued-binsae,","poem":1},{"text":"ibibayob dule-gwage-swilidikmaladgi nueddae.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"An iche-napinad isguednaganad,","poem":1},{"text":"an iche-napinad nue-dummad-noenad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dule-san-dummarba-imakmaladgi an nobguded,","poem":1},{"text":"we-dule-isganamar nasgumai an dakargua, an egi nobguded.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"We-dulemar gwen boni nikasurmalad,","poem":1},{"text":"na san-swilidik gudidimalad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dulemar-ibmarbina-sogeyob ibmarbina-sogdisurmalad,","poem":1},{"text":"dule-baigan-wiledimaladyob, wiledisurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"We-dulemar, e-san-dummarba-imaked, wingwa-dukargi-naiyob ise-daklegaled.","poem":1},{"text":"E-sabsur-dule-imaked, mor-yoeyobi ise-oyogar damalad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ibmar-isgana-ulubgi-sediid ise-oyogar damalad,","poem":1},{"text":"ibmar-isgana-imaked bakar-buud oyomalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dulemar-baigangi sunnasur sunmakdamalad.","poem":1},{"text":"Gadi dule-baigangi dododamalad.","poem":2},{"lineBreak":true},{"text":"Na san-dummarba-imakmaladba aimar-ibgwensur imakmalad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"E-sunmakedgi Bab-Dummadgi isdar sunmakdamalad,","poem":1},{"text":"e-sunmakedba bela dulemar eba selediid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"A-ulale, dulemar ese idaknaddamalad,","poem":1},{"text":"ega ibmar-soged bela nabiridbiiye binsadamalad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"We-dule-isganamar sogdedamalad: ¿Ar wede, Bab-Dummad wisguosi?","poem":1},{"text":"¿Ar wede, Bab-Dummad-Bur-Birigined mag-itogosi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"We-dule-isganamar dogdar-alamaknai dasurmalad,","poem":1},{"text":"degite, baisursunna mani-ibedga guddamalad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Binsarsunna, an gwage-swilidik gudiid,","poem":1},{"text":"binsarsunna, an ibmar-nued imakdiid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ar emide, sabsur-an-imakdigumalad,","poem":1},{"text":"wakudaryalaba an-sarsoardamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"An weyob sogsana: “We-dule-isganamaryob an sunmakoye.”","poem":1},{"text":"An be-mimmigangi aibichanad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"An we-ibmarmala magar-itobi gusanad,","poem":1},{"text":"suli-suli-itogega an-imaksad, aku an itogusad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bab-Dummadse-goled-negse an dogsagua,","poem":1},{"text":"geb an magar-itosad, igi-dule-isganamar bergumaloe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bab-Dummad, be we-dulemar bonimar-abargi ogwichisad,","poem":1},{"text":"we-dulemar na san-berguedse nadapmalad.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"¡Wemar ukiagwar bergudmaloed!","poem":1},{"text":"Wemar dobedba bergudmaloed.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bab-Jehová, bedi, igi dule e-gabdaksad napiragwadsulidba baisursunna daknonidae,","poem":1},{"text":"deyobi, be gwisgualile, we-dule-isganamar-baisursunna dakoed,","poem":2},{"lineBreak":true},{"text":"be we-dulemar-obelogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Bab-Dummad, suli-suli an itodigua,","poem":1},{"text":"an-ulubgi nue-sae an itodii gusad.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ar an ibmar-wissulidbali, gannar-gannar an imaksad,","poem":1},{"text":"ibmar-durganyob an gusad.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Degi-inigwele, an begi bangussulid,","poem":1},{"text":"bee be nue-an-nidii gusad.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Be anga binsaed-ukedba an nanadiid.","poem":1},{"text":"We-napneg-bergusale, ise-nuedgi be an-abingaoed.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"¿Ar doa nibneggi an-edarbemaisunna? Unnila bebi an-edarbemaid.","poem":1},{"text":"Ar an beba gudiile, we-napneggi ibmar-baid an abesulid.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"An-gangued bar nika an itosulid,","poem":1},{"text":"degi-inigwele, Bab-Dummad, be an-ganguedid.","poem":2},{"lineBreak":true},{"text":"Beginbi gudigu an sadeguoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Dulemar-begi-banguddamaladdi bese berguoed.","poem":1},{"text":"Dule-be-sogedba-nanadisurmaladdi bese burgwemaloed.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ar andina, Bab-Dummad-walikaa-gudigued bur nued an itoged.","poem":1},{"text":"Be, an-Bab-Jehová gued,","poem":2},{"lineBreak":true},{"text":"be, an-odukuedid.","poem":2},{"text":"Degisoggu, bela be-ibmar-imaksad,","poem":1},{"text":"dulemar-baiganga an sogoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}