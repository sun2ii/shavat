{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":74,"content":[{"type":"heading","content":["E-isdarmaladgi-bendaklegega Bab-Dummadse gornaid"]},{"type":"hebrew_subtitle","content":["Asaf, we-namaked-Masquilʼye-nugad narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummad, ¿ibiga be degisadegu anmar-obacha?","poem":1},{"text":"¿Ibiga be anmarse nue-urwe?","poem":2},{"lineBreak":true},{"text":"Ar be-sibad-wawaadyob-danar-bukwadse, ¿ibiga be nue-urwe?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Be-dulamar negasailaun be susadi, mer be iego.","poem":1},{"text":"Be-dulamar begadga-guega be bendaksagusadi, mer be iego.","poem":2},{"text":"We-Sión-yar-siid be-negga be imaksadi, mer be iebalo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"We-neg bela-bibichis-bukwadse be dage,","poem":1},{"text":"ar dule-be-isdarmalad, bese-goled-neg bela-bibichismalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Dummad, be-isdarmalad be-onmakedneggi oimakbukwad,","poem":1},{"text":"nakwis-itomaladba e-bandermar digsamalad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dule sapurba-sapi-sikmaladyob, ibmar-olananai gusmalad.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Bela ibmar-urgogi-sobarmalad, e-akangi bibichismalad.","poem":2},{"lineBreak":true},{"text":"Mardomargi bela bibichismarbalid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Be-neg-siid soogi ogumaksamalad,","poem":1},{"text":"bela swiri imaksamalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dule-isdarmalad na e-gwagegi sogsamalad:","poem":1},{"text":"“¡Bela anmar we-dulemar-obelogo!”","poem":2},{"lineBreak":true},{"text":"¡Geb we-yargi bese-goled-negmar-bukwad bela ogumaksamalad!","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Anmar, anmar-bander gwen memermaknai bar-daksulid,","poem":1},{"text":"dule-Bab-Dummad-e-gayaburba-barsogedbela bergusbalid.","poem":2},{"lineBreak":true},{"text":"Anmar we-ibmargunaid-e-ibagan-bergudapoed gwen wissurbalid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Dummad, ¿sanadse dule-isdarmalad begi dododii guoe?","poem":1},{"text":"¿Sanadse dule-isdarmalad be-nug oichodii guoe?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"¿Ibiga be sabsur-odurdaksuli?","poem":1},{"text":"¿Ibiga be bai-gwen-daksuli?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bab-Dummad, bedina bato-sailanagi an-reyga be maid.","poem":1},{"text":"We-napneggi bendakleged-igar be oyomaid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Be-garganguedgi be demar egasbalid,","poem":1},{"text":"be ibdulamar-dummagan-diakinmalad-e-nono marisad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Be ibdula-dummad-diakined Leviatánʼye-nugad-e-nono ubigwar be imaksad.","poem":1},{"text":"Ibdurgan-negsulidganba-gudimalad Leviatán-e-san-gunmalaga be imaksad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Dii-sailagan-ariogega be imaksad,","poem":1},{"text":"dianmar-megega be imaksad,","poem":2},{"lineBreak":true},{"text":"diwar-dummagan-mamaid-dinguega be imaksabalid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Be neg-meegwad nasiksad, mutikid be nasiksabalid.","poem":1},{"text":"Be nii nasiksad, dad-ibeler be nasiksabalid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Napneg-naid-e-abingunanaid be mesisad,","poem":1},{"text":"Be dii-wied-iba nasiksad,","poem":2},{"lineBreak":true},{"text":"yolagued-iba be nasiksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Bab-Jehová, nue be ebinsao: Be-isdarad begi ulusad.","poem":1},{"text":"Dule-galagwensurdamalad be-nug isdar-daksamalad.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Be-dula-belagwa-gudimalad mer be ibdurganga urmake.","poem":1},{"text":"¡Be-dula-wiledimalad mer be iego!","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Bab-Dummad, be-dulaga-be-igar-mesisad be ebinsao, mer be iego.","poem":1},{"text":"Ar we-napneggi bela neg isgusnaid, bela neg-urwed naid.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Dule-boniganba-galitodiid, melle be obingegsao.","poem":1},{"text":"Dule-boniganba-galitodiid,","poem":2},{"lineBreak":true},{"text":"dule-ibmar-abediid, be-nug-odummogega be imake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"¡Bab-Dummad, be-gargangued be oyoge!","poem":1},{"text":"Be, dule-binsaedsuligudimalad bane-bane begi-urwedimalad, mer be baisurdake.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Be-isdarmalad-begi-oimaknanaid, mer be baisurdake.","poem":1},{"text":"Ar begi-yoledimalad nue-mergumamaid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":23}