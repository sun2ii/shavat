{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"heading","content":["Bab-Dummadbi igar-naboged-duled"]},{"type":"hebrew_subtitle","content":["Asaf, namakmalad-e-iduedga we-namaked narmaksad."]},{"type":"hebrew_subtitle","content":["We-namakedi, “Mer neg-obergued” namaklegeyobi namaklegergebed."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummad, anmar doggus-nuedye bega soged, anmar bese goled.","poem":1},{"text":"Dulemar be-ibmar-gegerdaklemalad-imaksadgi sunmakmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bab-Dummadye, be soged: “An igar-nabogoye-sokalile,","poem":1},{"text":"innikigwadgi an igar nabogoed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Napaneg-giglimakdele, bela egi-bukwamalad giglimakdele,","poem":1},{"text":"ar ani an napneg-e-sailamar-ganikid ogannoged.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nug-dummarba-imakdimaladga an soged: “¡Mer be na nug-dummarba imakmar!”","poem":1},{"text":"Dule-isganamarga an soged: “¡Mer be na san-dummarba imakmar!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"¡Mer be na gangued-nikadba yamo san-gannarba imakmar!","poem":1},{"text":"¡Mer be na bule-bule sunmakmar!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ar nug-dummarba-guedi, dad-nakwedsik danikosulid, dad-argwanedsik danikosulid,","poem":1},{"text":"nega-dulesulidganba danikosulid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ar unnila Bab-Dummadbi igar-nabogedid.","poem":1},{"text":"Bab-Dummad belallaa dulemar-nug odummosulid.","poem":2},{"text":"Abala e-nug-bipii imaked,","poem":1},{"text":"abala e-nug-dummarba imaked.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová sabsur-dule-isganamar-odurdakega e-argangi nog-enamakar vino-gagbid-ibmar-baiganba-oburaled siid.","poem":1},{"text":"A-vino-gagbid-eodele, bela dule-isganamar-we-napneggi-gudidiid, vino-gagbid-e-asase-bakale, gobmaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ar andi, Jacob-e-Bab-Dummadgi degisadegu sunmakdii guoed,","poem":1},{"text":"Jacob-e-Bab-Dummadga an namakdii guoed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ar Bab-Dummad, dule-isganamar-e-gangued bela obelogoed,","poem":1},{"text":"dule-nued-e-gangueddi, ogannogoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}