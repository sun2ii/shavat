{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":76,"content":[{"type":"heading","content":["Bab-Dummad gege-galakued"]},{"type":"hebrew_subtitle","content":["Asaf, we-namaked narmaksad. Namakmalad-e-iduedga-sogleged:"]},{"type":"hebrew_subtitle","content":["We-namakleged, Neginotʼba namaklegoye."]},{"type":"verse","number":1,"content":[{"text":"Judá-yalagine, bela Bab-Dummad magar-dakmalad,","poem":1},{"text":"Israel-yalagi, e-nuga dummarba gued.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ese-goled-neg Salemʼgi siid,","poem":1},{"text":"e-meged-neg Sión-yalagi siid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"A-yalagine, Bab-Dummad warsi-e-sigumar bibichisad,","poem":1},{"text":"sigu-abgamalad bibichisad,","poem":2},{"text":"es-suidmar bibichisad,","poem":1},{"text":"bila-onolegedgi-ibmar-ebulemalad, bela obelosad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Dummad, bedi dule-gandikidid,","poem":1},{"text":"bedi yalamar-degisadegu-bukwadba bur gandikidid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dule-bulegan omilede gusmalad, burgwismalad.","poem":1},{"text":"We-dule-bulegan gannale bar gwisguosurmalad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Be, Jacob-e-Bab-Dummad, egi be gwichigusgua,","poem":1},{"text":"e-moli-urmar, e-molimar geg bar nanae gusad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"¡Bebi, unnila be-dobmalad!","poem":1},{"text":"Be uludegwale, ¿doa be-asabin gwisguoe? Suli, dule gwen gwisguosuli.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Dummad, be nibneg-akale igar-nabosad.","poem":1},{"text":"Bab-Dummad, napneggi san-bipi-imakdimalad-abonogega,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"be gwichiguargusgu, napnega dobee itosad,","poem":1},{"text":"napnega bogi nagusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dule-begi-urwedimalad aka be-nug-ogannogoed.","poem":1},{"text":"Dule-begi-urwedimalad-besmaladi aka bega iba-dummad onomaloed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Be-Bab-Dummad-Jehováʼba, ise-ibmar-sogar be imakmar,","poem":1},{"text":"ega sogedba be ibmar imakmarbalo.","poem":2},{"lineBreak":true},{"text":"Bela yarmar-anmar-neggwebur-dikarba-bukwadi, Bab-Dummad-gandikidga ibmar-ukleged sedamalo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ar Bab-Dummadi, dule-dummagan-negdakmamaid obelogedid,","poem":1},{"text":"napneggi reymar-mamaid-odobguedid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}