{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":77,"content":[{"type":"heading","content":["Bab-Dummad-ibmar-dummagan-imaksadgi binsaed"]},{"type":"hebrew_subtitle","content":["Asaf, we-namaked narmaksad. Namaked-idued-Jedutúnʼga soglenaid."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummad an-itogega, an ese binnasuli goled.","poem":1},{"text":"Suli-suli an itodiidgine, Bab-Dummadse an goted.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Dummadse mutikidba bogigusuli an argan-onakgwar gormai daed,","poem":1},{"text":"degite, amba an-gwage naibi-itodaed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Dummadgi an binsadele, nue-bukib an itodaed.","poem":1},{"text":"An egi nue-binsadele, an boddaed,","poem":2},{"lineBreak":true},{"text":"an binsaddaed bar an bendaklegosurye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Dummad, gabsuli be an-imaked.","poem":1},{"text":"Suli-suli an-itosoggu, geg sunmak an naddaed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ibagan-epenne-nasmalad an insaddaed,","poem":1},{"text":"birgamar-epenne-nasmalad an insaddaed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"An mutikidba-namakmaidaed an ebinsaddaed,","poem":1},{"text":"ulubgi an binsamaidaed, an egismaidaed:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“¿Ar Bab-Jehová degisadegu anmar-obandiguode?","poem":1},{"text":"¿Ar anmargi nued-binsadii bar guosurde?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"¿Bab-Dummad degisadegu-anmar-sabgudiid bergussi?","poem":1},{"text":"¿Bab-Dummad anmarga-ibmar-imakoye-sogsad degisadegu bergussi?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"¿Bab-Dummad dule-wiledaked iessi?","poem":1},{"text":"¿Bela-bela urwemaidba, bar anmar-sabguosurde?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Geb an sogdesunnad: Bab-Dummad-Bur-Birigined bar epennegii anmarga ibmar imaksulid.","poem":1},{"text":"We, nue-nunmak an-imaked.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Epenne Bab-Jehová-ibmar-dakledisurmalad-imaksad an ebinsaoed.","poem":1},{"text":"Epenne Bab-Jehová ibmar-gegerdakleged-imaksad an ebinsaoed","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bab-Dummad-ibmar-dummagan-imaksad an egi binsaoed,","poem":1},{"text":"be-ibmar-dummagan-imaklesadgi an sunmakoed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bab-Dummad, be-ibmar-imaked islidikidbiid.","poem":1},{"text":"¡Bab-dummagan-baigan anmar-Bab-Dummadyobid sulid!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bab-Dummad, be ibmar-dakledisulid-imakedid.","poem":1},{"text":"Be-gangued dulemar-yar-baid-baidgi-bukmaladse be oyomaid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Be-ganguedgi, be-dulamar be ollor-imaksad,","poem":1},{"text":"Jacob-wagan be ollor-imaksad,","poem":2},{"lineBreak":true},{"text":"José-wagan be ollor-imaksad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bab-Dummad, demar be-daksagua, be-dobguded,","poem":1},{"text":"muu-wilasailad be-daksagua, binnasuli giglimakded.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mogirmar, dii-dummad owialid,","poem":1},{"text":"nibneggi, malamar gollomakded,","poem":2},{"lineBreak":true},{"text":"nibneggi, malamar ibyeded.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Burwa-bipirmakaled-imbaba be-goled malayobi binnasuli gollomakded,","poem":1},{"text":"be-mala-ibyemamaid napaneg ibegwar-imakded,","poem":2},{"lineBreak":true},{"text":"napaneg wawanmakded, bela giglimakded.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Demar-abargi, igar be mesisad,","poem":1},{"text":"Muu-billi be egasad,","poem":2},{"lineBreak":true},{"text":"a-abargi be nasad,","poem":2},{"text":"degite, be-gannar daksasurmalad.","poem":1}]},{"type":"verse","number":20,"content":[{"text":"Sibad-wawaadyobi be-dulamar Moisésʼba, Aarónʼba be semai gusad.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}