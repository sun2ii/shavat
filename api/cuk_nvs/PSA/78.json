{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":78,"content":[{"type":"heading","content":["Bab-Dummad e-dulamarga ibmar-imaked"]},{"type":"hebrew_subtitle","content":["Asaf, we-namaked-Masquilʼye-nugad narmaksad."]},{"type":"verse","number":1,"content":[{"text":"An-dulamar, an-ibmar-odurdaked be nue itomala,","poem":1},{"text":"an-ibmar-soged be nue itomala.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"An ibmar-burbarmaladba sunmakoed,","poem":1},{"text":"dikasurgus negasailaunni ibmar-dukuar-mamaidi, an osanalogoed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Anmar bato we-ibmar itodiid, bato anmar wisid.","poem":1},{"text":"We-ibmar anmar-babgan anmarga sogsadid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Anmar anmar-mimmigangi we-ibmar odukuosulid.","poem":1},{"text":"Anmar anmar-wagan-danimaloedga Bab-Jehová-e-ganguedgi sunmakoed,","poem":2},{"text":"e-ibmar-dummagan-imaksadgi sunmakoed,","poem":1},{"text":"e-ibmar-dakledisurmalad-imaksadgi sunmakoed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Dummad, Jacob-waganga Igar mesisad,","poem":1},{"text":"Israel-dulemarga Igar mesisad.","poem":2},{"text":"Anmar-dadganga-Igar-uksagusad,","poem":1},{"text":"be-wagan be odurdakoye,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"adi, yoedse-be-wagan-danimaloedi, bela we-Igar wisgumalagarye,","poem":1},{"text":"degi, yoedse-mimmigan-gwalulemaloedi, bela we-Igar wisgumarmogagarye,","poem":2},{"lineBreak":true},{"text":"we-mimmiganmoga, we-Igargi na e-mimmigan-odurdakmogoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Deyobi, wemala, Bab-Dummadgi bensuli gumaloed,","poem":1},{"text":"Bab-Dummad-e-ibmar-dummagan-imaksad iegosurmalad.","poem":2},{"lineBreak":true},{"text":"Bab-Dummad-Igar-Maidba ibsamaloed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"E-dadganyobi guosurmalad.","poem":1},{"text":"E-dadgandi, binsaed-sate, uayasuli gusmalad,","poem":2},{"text":"e-gwagegi innikigwadba nanassurmalad,","poem":1},{"text":"e-ulubgi Bab-Dummad-sogedba gudii gussurmalad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Efraín-wagan, sigu-miemalad-buleganad,","poem":1},{"text":"degi-inigwele, bila-onolenaid-ibagi wakite gusmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Israel-dulemar Bab-Dummadbo-Igar-Mesisadba ibmar imaksasurmalad,","poem":1},{"text":"Bab-Dummad-Igar-Maidba ibsassurmalad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Dummad-ibmar-dummagan-imaksadi,","poem":1},{"text":"ega ibmar-gegerdaklemalad-oyosadi, bela iesmalad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bab-Dummad Egipto-yargi, Zoán-nebagi, e-dadganga ibmar-dakledisurmalad-oyosgusadi, bela iesmalad.","poem":1}]},{"type":"verse","number":13,"content":[{"text":"Bab-Dummad, Israel-dulemar nabir-obakmalagala demar-dinnaa imaksad,","poem":2},{"lineBreak":true},{"text":"demar gasdibiryob ganna mesisad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bab-Dummad, ibginedba mogirbali Israel-dulemar-idu-nadapi gusad,","poem":1},{"text":"mutikidba soo-gaedbali idunadapi gusad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bab-Dummad, nega-dulesulidganba akwasaila marisad.","poem":1},{"text":"A-akwagi dii-aryomai imaksad,","poem":2},{"lineBreak":true},{"text":"geb a-dii-gobmalaga imaksad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bab-Dummad, akwagi dii-aryogega imaksad,","poem":1},{"text":"diwaryobi dii-aryomai imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Degi-inigwele, Israel-dulemar gannar Bab-Dummadgi-isgunai gusmalad,","poem":1},{"text":"nega-dulesulidganba Bab-Dummad-Bur-Biriginedgi gwisgunai gusmalad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Israel-dulemar, yamo Bab-Dummad-wilubdakbi gusmalad,","poem":1},{"text":"agala, e-abegedba Bab-Dummadse masgunned-egicha gusmalad.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bab-Dummadgi sunmaksa gusmalad, sogsagusmalad:","poem":1},{"text":"“¿Bab-Dummad, sunna anmarga nega-dulesulidganba mas-ukoe? Suli. Anmarga geg uke.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ar napiragwa, Bab-Dummad akwasaila-sarsosgua, dii binnasuli aryoargusad.","poem":1},{"text":"Ar anmarga-mas-ukegala, ¿deyob imakbalo be ebinsae?","poem":2},{"lineBreak":true},{"text":"E-dulamarga, ¿sunna san ukbalo be ebinsae?”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bab-Jehová, Israel-dulemar weyob-soge-itosgua, bela-belad uluded.","poem":1},{"text":"Jacob-wagangi sae-itoded,","poem":2},{"lineBreak":true},{"text":"Israel-dulemargi sabsur-uluded.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ar Israel-dulemar Bab-Dummadgi bengusmalad,","poem":1},{"text":"Bab-Dummad e-bendakosurye binsasmalad.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bab-Dummad, nibneg-akale, mogirmarga igar-uksad,","poem":1},{"text":"degidba, mogirmar argaded.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bab-Dummad, Israel-dulemar mas-gunmalagala, mas-manáʼye-nugad ega obatisad,","poem":1},{"text":"madu-nibneggined-gunmalaga imaksad.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bela Israel-dulemar baliwitur-e-madu guchamalad.","poem":1},{"text":"Nue-immelegedse-gunmalagala, Bab-Dummad ega mas barmialid.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bab-Dummad, dad-nakwedsikid-burwa barmiar gusad.","poem":1},{"text":"E-gangued-nikadba dad-nakwed-argan-nuedsikid-burwa barmiar gusad.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bab-Dummad, ukub-mileddaedyobi ega san obatisad,","poem":1},{"text":"demar-gakaba ukub-mergunaiyob ega nuumar obatisad.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Bab-Dummad, dulemar-danar-danar-bukwamaladgi, nuumar-babatega imaksad,","poem":1},{"text":"Israel-dulemar-e-neg-gabmalad-dikarba nuumar-obatisad.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Israel-dulemar bela-bela-immelegedse mas-guchamalad.","poem":1},{"text":"Deyobi, Bab-Dummad, ibmar-egichamaladi ega uksad.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ar undar-immerba-gudii gussurmalad,","poem":1},{"text":"ar amba e-gaya-yaba mas-sigua,","poem":2}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Bab-Dummad-e-urwed egi gwisgunonikid.","poem":2},{"text":"Bab-Dummad, e-ibe bur-dule-dutusurmalad oburgwisad,","poem":1},{"text":"Israel-dulemar-bur-nuga-nikamalad ogilosad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Degi-inigwele, Israel-dulemar amba isgudii gusmalad,","poem":1},{"text":"Bab-Dummad-geger-ibmar-daklemalad-imaksadgi bengusmalad.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"A-ulale, Bab-Dummad, Israel-dulemar-e-ibagan sikwas-bunnogedyobi, berguega imaksad,","poem":1},{"text":"e-birgamar dobed-dummad-abalagi, berguega imaksad.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ar Bab-Dummad Israel-dulemar-abar-oburgwisale, geb Israel-dulemar-baigan gannar Bab-Dummad-amiddamalad,","poem":1},{"text":"gwae-gwae gannar Bab-Dummadse nonidamalad.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Geb ebinsaddamalad, Bab-Dummad ega akwasailayob guye,","poem":1},{"text":"Bab-Dummad-Bur-Birigined e-bendaked guye.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ar Israel-dulemar e-gayaginbi, e-gwabin-dukuginbi,","poem":1},{"text":"gakansaar Bab-Dummad-nug-odummodii damalad,","poem":2}]},{"type":"verse","number":37,"content":[{"text":"ar e-ulubgindi ega gakansadii damalad.","poem":1},{"text":"Bab-Dummadbo-Igar-Mesisadba, sogedba imaksasurmalad.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Degi-inigwele, Bab-Dummaddi wemar-wiledaksad,","poem":1},{"text":"e-isgusad ega elisad, wemar-obelossurgusad.","poem":2},{"text":"Bab-Dummad, gannar-gannar na e-urwed-barganai gusad,","poem":1},{"text":"e-urwedba ibmar-imaknai gussulid.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Bab-Dummad ebinsasgusad, wemarde unnila dulemar-guye,","poem":1},{"text":"unnila burwa-goleyob guye, gwen bar daklegosurye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Israel-dulemar, nega-dulesulidgangi, bukidargus Bab-Dummadgi-yoledanigusmalad.","poem":1},{"text":"Nega-dulesulidgangi Bab-Dummad-wile-itogega imaksamalad.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Gannar-gannar Bab-Dummad-wilubdaknai gusmalad,","poem":1},{"text":"Israel-e-Bab-Dummad-Isligwaled-ourwenai gusmalad.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Bab-Dummad-e-gangued bipisaar ebinsassurmalad,","poem":1},{"text":"e-isdarmaladse-wilebukwa-onolesgusadi, ebinsassurmalad.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Egipto-yargi, Bab-Dummad ibmar-dakledisurmalad-oyosad iesmalad,","poem":1},{"text":"neba-Zoánʼye-nugadgi ibmar-dummagan-imaksad iesmarbalid,","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Bab-Dummad, Egipto-yar-e-diwarmar abega obinnisad,","poem":1},{"text":"Egipto-dulemar, a-diwar geg gobe gusmalad.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Bab-Dummad, Egipto-dulemargi, gukurmar-bela-ibmar-biin-imakmalad barmiar gusad.","poem":1},{"text":"Noomar-ibmar-obelomalad barmiar gusbalid.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Bab-Dummad, Egipto-dulemar-e-ibmar-gwag-wesmaladi, sese-burwigana-omaega imaksad,","poem":1},{"text":"e-ibmar-gwag-gullemalad-digarmaladi, sesega urmaksabalid.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Bab-Dummad, Egipto-dulemar-e-uvaʼdub-digarnanaid, dii-gwamakaled-obatisadgi obelosad,","poem":1},{"text":"e-higo-sapimar, boo-gwamakarmaladgi obelosad.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Bab-Dummad, Egipto-dulemar-e-moli-bebe-nikamalad, dii-gwamakaled-obatisadgi oburgwisad.","poem":1},{"text":"E-sibad-wawaadmar mar-egi-odesadgi obelosad.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Bab-Dummad, Egipto-dulemargi bela-bela-e-urwed, e-sae-itoged, e-isdar-itoged, e-sae-daked barmiar gusad.","poem":1},{"text":"Baliwitur-ibmar-obelomalad danagwen barmiar gusad.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Bab-Dummad na e-urwed bar bargassur gusad.","poem":1},{"text":"Burgwedgi, Egipto-dulemar bar ollor-imaksasulid,","poem":2},{"lineBreak":true},{"text":"boni-dummaganga urmaksagusad.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Bab-Dummad, bela Egipto-dulemar-e-machi-sailaginmalad oburgwisad,","poem":1},{"text":"Cam-dulemar-e-machi-sailaginmalad ogilosad.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Bab-Dummad, sibad-wawaad-danar-bukwadyobi, Israel-dulamar-idunadapi gusad,","poem":1},{"text":"nega-dulesulidganba senadapi gusad.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Bab-Dummad, Israel-dulamar-mer-dobee-itomalaga, igar-nueganba semai gusad.","poem":1},{"text":"E-isdarmaladdi demargi-gundilegega imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":54,"content":[{"text":"Bab-Dummad, na e-yar-islidikidse Israel-dulamar-senoni gusad,","poem":1},{"text":"na e-garganguedgi we-yarmar-susadse senonikid.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Bab-Dummad, Israel-dulemar-nadapid-idu dule-baigan-bukwad onosgusad,","poem":1},{"text":"we-dulemar-e-napamar, Israel-dulemargadga-guega ega uksad.","poem":2},{"text":"Deyobi, Bab-Dummad, a-napamargi,","poem":1},{"text":"Israel-dadgan-dummagan-wagan urbisad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":56,"content":[{"text":"Degi-inigwele, Israel-dulemar Bab-Dummad-wilubdaknai gusmalad,","poem":1},{"text":"Bab-Dummad-Bur-Biriginedgi aibitemalad,","poem":2},{"lineBreak":true},{"text":"e-Igar-Maidba ibsassurmalad.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"E-babganyobi Bab-Dummadgi aibatemalad, egi yolenai gusmalad.","poem":1},{"text":"Israel-dulemar, warsi-binsaledyob dopere gusmalad.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"E-bab-dummadse-goled-neg-sobsamaladba, Bab-Dummad-oulusmalad,","poem":1},{"text":"ibmar-e-bab-dummadga-imakdimalad-e-wilub-sobsamaladba, Bab-Dummad-nobguega imaksamalad.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Bab-Dummad, weyob ibmar-daksagua, uluded,","poem":1},{"text":"degidbali, bela Israel-dulemar-obachad.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Silo-neggweburgi e-neg-meged-siidgi aibated.","poem":1},{"text":"Agi, Bab-Dummad dulemar-abargi maidaenad.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"Bab-Dummad, na e-Ulu, e-gangued-yeerdakleged-e-wilubga guedi,","poem":1},{"text":"e-isdarmaladse-galegega imaksad.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"Bab-Dummad bela-bela e-dulamargi urwemaisoggu,","poem":1},{"text":"es-suidgi e-dulamar-oburgwilegega imaksad.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"E-dula-sapingan soogi gummaksamalad,","poem":1},{"text":"e-yaganga sui-nikued-ibagi-namakleged namaklessulid.","poem":2}]},{"type":"verse","number":64,"content":[{"text":"E-dule-irwa-Bab-Dummadse-gormalad es-suidgi oburgwilesmalad,","poem":1},{"text":"E-omegan-e-ibe-sui-burgwismaladi, e-suimarga gwen bonai gussurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":65,"content":[{"text":"Geb Bab-Dummad, igi-dule-gabmair atakardae,","poem":1},{"text":"deyobi atakalid.","poem":2},{"text":"Igi-dule-bila-onoged-buled vino-gobnair binnasuli gormakdedae,","poem":1},{"text":"deyobi Bab-Dummad uludedba binnasuli goted.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Bab-Dummad, e-isdarmalad-sikirmakega imaksad,","poem":1},{"text":"degisadegu bingeguega imaksad.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"Bab-Dummad, José-wagan-obachad,","poem":1},{"text":"Efraín-wagan-sussulid.","poem":2}]},{"type":"verse","number":68,"content":[{"text":"Bab-Dummad, aka bur Judá-wagan-sunonikid,","poem":1},{"text":"na e-yar-bur-sabed-Sión sunonikid.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"Bab-Dummad, ese-goled-nega nibnegyobi matusuli sobsad,","poem":1},{"text":"Bab-Dummad, igi-napneg degisadegu-gangu-nasiksa,","poem":2},{"lineBreak":true},{"text":"deyobi na e-neg gangu sisad.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"Bab-Dummad, e-mai-David-sunonikid,","poem":1},{"text":"sibad-wawaad-edarbedgi-arbadiidgi David-onosad.","poem":2}]},{"type":"verse","number":71,"content":[{"text":"Sibad-wawaad-baregindidaedgi, Davidʼse gochad.","poem":1},{"text":"Bab-Dummad, ega e-dulamar-Jacob-wagan-akwega,","poem":2},{"lineBreak":true},{"text":"Israel-dulemar-egad-gued-akwega, Davidʼse gochad.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"David na e-gwage-innikigwadba Israel-dulemar-akwisad,","poem":1},{"text":"e-binsaed-nue-nikadba dulemar-idudii gusad.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/78.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/79.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/77.json","previousChapterAudioLinks":{},"numberOfVerses":72}