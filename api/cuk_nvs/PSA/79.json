{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":79,"content":[{"type":"heading","content":["Jerusalén-neggwebur-bergusadba nunmak-itoleged"]},{"type":"hebrew_subtitle","content":["Asaf, we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummad, dulemar-aku-be-dakmalad be-yargi ubosmalad.","poem":1},{"text":"Bese-goled-neg-islidikid oichosmalad.","poem":2},{"lineBreak":true},{"text":"Jerusalén-neggwebur akwabi-dunnumakbukwa imaksamalad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"We-dulemar, be-maimar-e-mui, mulamarga masga uksamalad.","poem":1},{"text":"Dule-bega-inniki-nanadiid-e-sanmar, ibdurgan-ursilimarga masga uksamarbalid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Be-maimar-e-ablis, bela Jerusalén-neggweburgi diiyobi eosmalad.","poem":1},{"text":"Burgwismalad-digega dule sate gusad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dulemar-anmar-yar-dikarba-bukmaladi, anmargi dodomalad,","poem":1},{"text":"dulemar-anmar-yar-dikarba-bukmaladga anmar e-dodoedga gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bab-Jehováʼye, ¿sanagwadse be-urwed berguoe?","poem":1},{"text":"¿Sanagwadse degisadegu be urwemai guoe?","poem":2},{"lineBreak":true},{"text":"¿Sanagwadse be-nobgued sooyob gamai guoe?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dulemar-aku-be-dakmaladse be urwe,","poem":1},{"text":"dulemar-bese-gordisurmaladse be urwe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ar we-dulemar, Jacob-wagan obelosmalad.","poem":1},{"text":"Jacob-wagan-e-yar akwabi-dunnumakbukwa imaksamarbalid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Jehováʼye, anmar-epenne-isgusad, mer be bar ebinsae.","poem":1},{"text":"Be-wiledaked gwae be anmarga oyoge,","poem":2},{"lineBreak":true},{"text":"ar anmar bela-bela oitoles bukwad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bab-Dummad-anmar-abonoged, be-nug-dummarba-gued-ular, be anmar-bendake.","poem":1},{"text":"Be-nug-sabed-ular, be anmar-ollorsae, anmar-isgusad be elie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ar ibiga dulemar-yar-baigangi-bukwad sogmaloe: “¿Bia e-Bab-Dummad nade?”","poem":1},{"text":"Be anmarga oyoge, igi-be, be-dulamar-e-ablis-aryosad be buged-mai imake.","poem":2},{"text":"Bela dulemar-yar-baid-baidgi-bukwamaladga oyobali,","poem":1},{"text":"igi-be, be-maimar-e-ablis-aryosad be buged-mai imake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dule-galesbukmalad-e-boed be itoge,","poem":1},{"text":"dule-oburgwilesokarmaladi, be-garganguedba be bendake.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bab-Jehová, dulemar-anmar-yar-dikarba-bukwamalad begi dummad-dododigusmaladi,","poem":1},{"text":"ilagugle (7) deyob-egi-dodomarmogaga be imake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Anmardi, be-dulamar-gumalad,","poem":1},{"text":"be-sibad-wawaadmaryob-gumalad.","poem":2},{"text":"Degisadegu, anmar dog-nuedye bega sogmaloed.","poem":1},{"text":"Degisadegu, anmar bega namakmaloed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}