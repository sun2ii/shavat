{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"heading","content":["Bab-Dummad-e-gangued, degi, dulemar-e-gangued"]},{"type":"hebrew_subtitle","content":["David namaked narmaksad. Namakmalad-e-iduedga soglenaid:"]},{"type":"hebrew_subtitle","content":["Igi uva-nis-egurelealir gar-ogorledae, deyob ogoloye."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová, be anmar-Dummad gued.","poem":1},{"text":"Ibiyobi bela we-napneggine, be-nugdi dummarba gue.","poem":2},{"text":"Bela be-ganguedi nibnegse-bakale,","poem":1},{"text":"magar-yeerdaklege be nasiksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Be-isdarmalad-begi-yolesad-ular, burwigan-namakedgi, mimmigan-namakedgi, be-nug-odummoged-igar be mesisad.","poem":1},{"text":"Adi, be-isdarmalad, dule-begi-gwisgudimalad, be-abin gaya-maklegar sigegar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bab-Dummad, mogir-billigi be-ibmar-nasiksad an nue dakdele,","poem":1},{"text":"nii-naid an nue dakdele,","poem":2},{"lineBreak":true},{"text":"niisgwamar-naid an nue-dakdebalile,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Dummad, an binsaddaed:","poem":1},{"text":"“¿Wede, dule ibusunna, egi be binsanonigu?","poem":2},{"lineBreak":true},{"text":"¿Wede, dule ibusunna, be akwenonigu?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ar dule baliwiturmarba wis yaisaale be imaksad.","poem":1},{"text":"Napneggi, dummadga-guega, gangued-yeerdakleged bela-bela-nikuega be nug-imaksad.","poem":2},{"lineBreak":true},{"text":"Degi, nug-dummarba-nikuega be imaksabalid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bela be ibmar-obinnisadgi gangued-nika-guega be dule-imaksad.","poem":1},{"text":"Bela e-argan-yaurgi we-ibdurgan ega be uksad:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bela sibad-wawaadmar, bela moli-bebe-nikamalad,","poem":1},{"text":"bela ibdurganmar-sapurba-bukwamalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bela nuumar, bela demar-wilaganba uamar-iirmakbukmalad,","poem":1},{"text":"degi, muu-billigi, bela ibdurganmar-bukwamalad.","poem":2},{"lineBreak":true},{"text":"Bela we-ibdurgangi gangued-nika-guega, be dule-imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bab-Jehová, be anmar-Dummad gued.","poem":1},{"text":"Ibiyobi bela we-napneggine, be-nugdi dummarba gue.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}