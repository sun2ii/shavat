{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":80,"content":[{"type":"heading","content":["Bab-Dummadse-goled, Israel-yar gannar nudakye"]},{"type":"hebrew_subtitle","content":["Namakmalad-e-iduedga-sogleged:"]},{"type":"hebrew_subtitle","content":["We-namaked, Dutu-Lirioʼgi-namaklegedyob namaklegoye."]},{"type":"hebrew_subtitle","content":["Asaf e-gudiidba we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummad, Israel-dulemar-edarbed, be anmar-itoge.","poem":1},{"text":"Be, sibad-wawaad-edarbedyobi José-wagan-e-iduedid,","poem":2},{"lineBreak":true},{"text":"be, baliwiturmar-querubinʼye-nugad-abargi negsemaidid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Efraín-waganse, Benjamín-waganse, Manasés-waganse, be magar gue.","poem":1},{"text":"Be-gangued be oyoge, be bela-bela anmar-bendakdage.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bab-Dummad, igi-anmar epenne bukwagusa, deyobi, be gannar anmar-imake.","poem":1},{"text":"Bab-Jehováʼye, be anmargi ise-nued-binsae,","poem":2},{"lineBreak":true},{"text":"be bela-bela anmar-bendake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Dummad-Jehová-Bela-Gangued-Nikad, be-urwe-maid-ulale, ¿sanagwadse be-dulamar-bese-goled be itogosuli?","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Boed-dummad e-masgunnedyob ega be uksad,","poem":2},{"lineBreak":true},{"text":"ibyanis-obinebaka e-gobedyob ega be imaksad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dulemar-anmar-yar-dikarba-bukwamaladi, anmarga allega be imaksad,","poem":1},{"text":"anmar-isdarmalad anmargi dodomalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bab-Dummad-Bela-Gangued-Nikad, igi-anmar epenne bukwagusa, deyobi be gannar anmar-imake.","poem":1},{"text":"Bab-Jehováʼye, be anmargi ise-nued-binsae, be anmar-abonoge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bab-Dummad, Egipto-yalagi be uva-dub seargusad,","poem":1},{"text":"Canaán-yargi dulemar-Bab-Dummad-akudakmalad be ononnosgusad,","poem":2},{"lineBreak":true},{"text":"geb we-uva-dub be digsagusad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ega be neg-emisad,","poem":1},{"text":"uva-dub-e-maligan gatik-diglemai be imaksad,","poem":2},{"lineBreak":true},{"text":"bela-yar-gasa nagusad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bela uva-dub-gagan-urba negsichigwadgi yarmar bukusad,","poem":1},{"text":"e-dubagan, urwar-sapi-matusur-gwigwichidgi bipirmakde gusad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"E-anamar, demar-Mediterráneoʼse warmaksad,","poem":1},{"text":"e-muugan, Éufrates-diwarse nasgumai gusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bab-Dummad, ¿ibiga uva-nainu-e-galu-emakaled be earisa?","poem":1},{"text":"Bela-dulemar-e-dikarba-nasdamaladi, e-ibe san gwandamalad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wedarmala bela-bela wionaid,","poem":1},{"text":"ibdurgan-ursirmar gundamalad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bab-Dummad-Bela-Gangued-Nikad, be anmarse gannar dage,","poem":1},{"text":"nibneg-akale be atake,","poem":2},{"lineBreak":true},{"text":"we-uva-dub be bendakdage.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Be-sunnad we-uva-dub be digsagusad.","poem":1},{"text":"Begadga-guega e-ana be odummosad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Be-uva-dub aimukus maid, soogi ogumaklesad.","poem":1},{"text":"Be-urwedbali be-dulamar burgwemamaid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dule na be susagusadi, be bendake,","poem":1},{"text":"dule-begadga-guega na be odungusgusadi, be bendake.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ar deyob be imakele, anmala begi aibanosurmalad.","poem":1},{"text":"Gannar-dula-gudii be anmar-imake, anmar unnila besebi gordii gumaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Bab-Dummad-Jehová-Bela-Gangued-Nikad, igi-anmar epenne bukwagusa, deyobi be gannar anmar-imake.","poem":1},{"text":"Bab-Jehováʼye, be anmargi ise-nued-binsae,","poem":2},{"lineBreak":true},{"text":"be bela-bela anmar-bendake.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}