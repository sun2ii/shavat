{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":81,"content":[{"type":"heading","content":["Bab-Dummad e-dulamargi nueddaed"]},{"type":"hebrew_subtitle","content":["Namakmalad-e-iduedga sogleged:"]},{"type":"hebrew_subtitle","content":["Igi uva-nis-egurelealir gar-ogorledae, abali, namaklegoye."]},{"type":"hebrew_subtitle","content":["Asaf, we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummadga weligwaledgi namakmala, e anmar-ogannogedid.","poem":1},{"text":"Jacob-e-Bab-Dummadga binnasuli weligwaledgi namakmala.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Namakmala, gar-pandero ogormala,","poem":1},{"text":"gar-lira ogormala, gar-arpa ogormala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nii-binid-gwisgunonikidgi, gar-trompeta ogormala.","poem":1},{"text":"Nii-dalu-naidgi anmar-iba-dummad-guedgi, gar-trompeta ogormala.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ar weyob-imakoye Bab-Jehová Israel-dulemarga igar uksad,","poem":1},{"text":"weyob Jacob-e-Bab-Dummad igar mesisad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"José-wagan Egipto-yargi noargu,","poem":1},{"text":"Bab-Dummad José-waganbo igar mesisad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dule-sunmaked an itosad, an wissulid, doa anga sunmake.","poem":1},{"text":"Anga weyob soged:","poem":2},{"text":"“Be-gukingi be ibmar-ukusulid-semaid an bega osulosad.","poem":1},{"text":"Arbaed-dummad be imakdiidi an bega obelosad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bemar suli-suli-itoarmargua, be anse gochamalad,","poem":1},{"text":"agine, an be-bendaksamalad.","poem":2},{"text":"Mogir-gudureged-imbaba, an be-abin-imaksamalad.","poem":1},{"text":"Mar-gollomakmaid-abargi, an be-abin-imaksamalad.","poem":2},{"lineBreak":true},{"text":"Meriba-dii-naba an bemar-wilubdaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”An-dulamar, an be-owisogega bega ibmar-sogedi, be itomala.","poem":1},{"text":"Israel-dulemar, bitigi be an-itosmalana gadin.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-dummagan-bamalad be-Bab-Dummadga be imakosurmalad,","poem":1},{"text":"bab-dummagan-bamalad-asabin, be yokorgi sindigar sigosurmalad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani, an be-Bab-Dummad-Jehová gued.","poem":1},{"text":"Ani an Egipto-yargi bemar-onosad.","poem":2},{"text":"Guagwar be bukumala,","poem":1},{"text":"an bemarga mas-obinebaka ukoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”Degi-inigwele, an-dulamar an-itossurmalad,","poem":1},{"text":"Israel-dulemar anba ibsabisur gusad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"A-ulale, na e-itolegedba-ibmar-imakega an imaksad.","poem":1},{"text":"Na e-itolegedba-nanadii gusmarsunnad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”Ar an-dulamar an-itosana,","poem":1},{"text":"ar Israel-dulemar an-igar-mamaidba nanasmalana,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"an ega e-isdarmalad irgwensuli osulosanad,","poem":1},{"text":"an e-isdarmalad sabsur-odurdaksanad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Dulemar-Bab-Jehová-isdar-dakmalad, Bab-Jehová-e-nug bela-bela odummodmaloenad.","poem":1},{"text":"Degi-inigwele, an a-dulemar degisadegu sabsur-odurdakoed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"An-dulemardi trigo-gwag-bur-nuedgi an oguchaled,","poem":1},{"text":"akwamargi-achanis-nanaidgi, immerba-itomalaga an imaksaled.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}