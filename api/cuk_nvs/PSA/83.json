{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":83,"content":[{"type":"heading","content":["E-isdarmalad-obelogega Babse-goled"]},{"type":"hebrew_subtitle","content":["Asaf, we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummad, melle be gaya-bogidik mege.","poem":1},{"text":"Bab-Dummad, melle be sunmaksuli gue,","poem":2},{"lineBreak":true},{"text":"melle be ibmar-imaksuli gue.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová, be dake, ibibayobi be-isdarmalad uurmakbukwa,","poem":1},{"text":"ibibayobi isdar-be-dakmalad begi gwisgunanai.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Be-dulamargi-aibinega yardakar igar-amismalad.","poem":1},{"text":"Be-dulamar-na-be-sabgumaidgi-gwisgumalaga, yardakar bular igar-amismalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"We-dulemar sogmalad: “Dagmala, anmar bela e-dulamar obelonae.","poem":1},{"text":"Deyobi, Israel-e-nug bar bipisaar ebinsalegosulid.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dule-wargwennayob na igar-aminanaid,","poem":1},{"text":"begi bila-onomalaga, we-dulemar na atosmalad:","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Edom-dorgan, Ismael-dorgan,","poem":2},{"lineBreak":true},{"text":"Moab-dorgan, Agar-dorgan,","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gebal-dorgan, Amón-dorgan, Amalec-dorgan,","poem":2},{"lineBreak":true},{"text":"Filistea-dorgan, degi, Tiro-dorgan, bela wemar na atosmalad.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asiria-dorganse-bakale, bela wemarba atosad.","poem":2},{"text":"Lot-wagan-bendakega atosmalad.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ar igi be Madián-dulemar-obelosgusa,","poem":1},{"text":"deyobi be we-dulemar obelomoga.","poem":2},{"text":"Ar igi be Sísara, degi, Jabín, Cisón-diangi-obelosgusa,","poem":1},{"text":"deyobi be we-dulemar obelomoga.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"We-dulemar Endorʼgi burgwismalad,","poem":1},{"text":"ibmar-isganayob napagi miled gusmalad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar igi be Oreb, degi, Zeeb, imaksagusa,","poem":1},{"text":"deyobi be e-sordamar-dummagan imakmoga.","poem":2},{"text":"Ar igi be Zeba, degi, Zalmuna, imaksagusa,","poem":1},{"text":"deyobi be bela e-dummagan-nuga-nikamalad be imakmoga.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wemar sogsagusad:","poem":1},{"text":"“Bab-Dummad-e-yar-naidi, anmar e-ibe sumala.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bab-Dummad, we-dulemar burwaba-selegega be imake.","poem":1},{"text":"Gaganmar burwaba-gukuddaeyobi be we-dulemar-imake.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ar igi soo sapur-ogumakdae,","poem":1},{"text":"degi, igi soo-gwabunyemaid yarmar-ogumakdae,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"deyobi be we-dulemar, be-burwa-dummadgi be baleginne,","poem":1},{"text":"be-burwa-ooredgi, be ogwaye.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bab-Jehová, we-dulemar be obingegsae,","poem":1},{"text":"adi, magar-be-dakmalaga, be Bab-Dummad gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"We-dulemar, degisadegu bingegudii gumala,","poem":1},{"text":"na bingegudii burgwemala.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Na wisgumala, bebi Bab-Jehová gued, weyobi be nugad.","poem":1},{"text":"Na wisgumala, napneggine, bebi unnila Bab-Dummad-Bur-Birigined gued.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}