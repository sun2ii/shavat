{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":84,"content":[{"type":"heading","content":["Bab-Dummadse-goled-negbina nue-soged"]},{"type":"hebrew_subtitle","content":["Coré-e-wagan, we-namaked narmaksad."]},{"type":"hebrew_subtitle","content":["Namakmalad-e-iduedga soglesad:"]},{"type":"hebrew_subtitle","content":["We-namakedi igi uva-nis-egurelealir gar-ogorledae, aba namaklegoye."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová-Bela-Gangued-Nikad, ibibayobi be-meged-negmala yeerdaklege.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehováʼse-goled-neg-imbabina, an bela-bela ulubgi itoged,","poem":2},{"text":"agi an gudiguega an surbinsa itoged.","poem":1},{"text":"Bela-belad an-ulubgine, an-gwagegine, Bab-Dummad-Dula-Maidga an weligwaledgi namaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová-Bela-Gangued-Nikad, an-e-rey, an-Bab-Dummad,","poem":1},{"text":"amba gig-sikwibela, bese-goled-neggi neg-amied,","poem":2},{"lineBreak":true},{"text":"amba wirsobbela, na e-mimmigan-urbega, bese-goled-neggi e-uu sobed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Be-itoged-neggi-gudimaladi, egi nued-binsalesmaladid,","poem":1},{"text":"ar degisadegu be-nug-odummodimalad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dule-begi-gangued-amiedi, egi nued-binsalesmaladid,","poem":1},{"text":"unnila bese-goled-negse-dagedginbi binsadiid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ibyanis-aryoged-nebaba-nadapile, dii-sailagan-ariomaid-negga imaked.","poem":1},{"text":"Gebe-dii-argwanedi, neba-naidgi nabir-binsadaed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dulemar, nanadapidbali e-ganguedi gangumai gued,","poem":1},{"text":"Sión-yalagi Bab-Dummad-dakmaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová-Bela-Gangued-Nikad, an bese-goled be itoge,","poem":1},{"text":"Jacob-e-Bab-Dummad, be an-itoge.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Dummad, be anmar-irwa sigu-abgaedyob gued.","poem":1},{"text":"Be-dule-nug-imaksadgi be nued binsae.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Magaba iba-miliba-gudiguedba, bur-nuedid, bese-goled-neg-imbagi ibagwen gudii gued.","poem":1},{"text":"Dule-isganamar-abargi-gudiguedba, bur an an-Bab-Dummadse-goled-neg-yawagak edarbebied.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bab-Jehová, dad-ibeleryob gued,","poem":1},{"text":"sigu-abgaedyob gued.","poem":2},{"text":"Bab-Dummad, anmar-nug dummarba imaked, anmarga gangued uked.","poem":1},{"text":"Bab-Jehová, dule-galagwensuli-gudisurmaladga, e-ibmar-nikadi obinagwar uked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"¡Bab-Jehová-Bela-Gangued-Nikad, dule-begi-bensur-gudiid,","poem":1},{"text":"egi nued-binsalesadid!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}