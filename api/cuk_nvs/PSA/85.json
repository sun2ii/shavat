{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":85,"content":[{"type":"heading","content":["Babse goled, be wile-an-dakye"]},{"type":"hebrew_subtitle","content":["Coré-wagan, we-namaked narmaksad. Namakmalad-e-iduedga narmaklesad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová, be-dulamargi be ise-nued binsasad.","poem":1},{"text":"Jacob-e-wagan-yar-baidgi-galebukmalad, be gannar e-yarse senonikid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Be-dulamar-e-ibmar-isgana-imaksad ega be osulosad,","poem":1},{"text":"bela e-isgusad begi nossuliyob be daksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová, be-sae-itoged bela be osulosad,","poem":1},{"text":"be-urwed na be bargasad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Dummad-anmar-abonoged, gannar be anmar-nudake.","poem":1},{"text":"Be-anmarse-urwemaid be obeloge.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"¿Ar be degisadegu anmarbo sae-itodii guoe?","poem":1},{"text":"¿Be degisadegu urwemai guoe?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ar anmar burgwaleyob-gusoggu, gannar be anmar-odulodage.","poem":1},{"text":"Adi, anmar be-dulamar-guedi, begi weligwar itomaloed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bab-Jehováʼye, be-sabgued be anmarse oyoge,","poem":1},{"text":"be anmar-abonoge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bab-Dummad-Jehová-ibmar-soged an itogoed,","poem":1},{"text":"ar e-dulamarga, ega-inniki-nanadimaladga, bogidikidgi sunmakoed,","poem":2},{"lineBreak":true},{"text":"adi, melle bar gannar Bab-Dummadgi bangumalagar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"E-nug-odummodimalad-bendakega, Bab-Dummad anmar-walikaa gudiid.","poem":1},{"text":"E-gangued-yeerdakleged anmar-napneggi nai guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Sabgued, na napiragwadbo abingunonimaloed.","poem":1},{"text":"Igar-innikigwad-imaked, na bogidikidbo, angaagwar akanonimaloed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Napiragwad napneggi nai guoed,","poem":1},{"text":"Igar-innikigwad-imaked, nibneg-akale aidedani guoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bab-Jehová-sunnad anmargi nued-binsaoed.","poem":1},{"text":"Anmar-napaneg, nue-ibmar-sanmake guoed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Igar-innikigwad-imaked, e-gayaburba-barsogedga guoed,","poem":1},{"text":"Bab-Dummad-idu igar-mayoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}