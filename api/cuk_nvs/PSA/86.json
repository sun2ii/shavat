{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":86,"content":[{"type":"heading","content":["Wile-e-dakega Bab-Dummadse goled"]},{"type":"hebrew_subtitle","content":["David Bab-Dummadse gornaid."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼye, wis be an-itoge,","poem":1},{"text":"be an-abin-imake.","poem":2},{"text":"Ar ande, dule-wilegedid,","poem":1},{"text":"ibmarbina an bela-bela soged.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Dummadye, be an-bendake,","poem":1},{"text":"ar ande begala sogedba nanadiid.","poem":2},{"text":"Be, an-Bab-Dummadid. An begi bensulid.","poem":1},{"text":"Be-mai be bendake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Jehováʼye, wile-be-an-dake,","poem":1},{"text":"ar an bese gordii osedoddaed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Be-nug-odummodiid weligwar be imake,","poem":1},{"text":"adi, Bab-Jehová, an bese golegar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bab-Dummad, be dule-nued gued, isgudsuliyob be emar-dakedid.","poem":1},{"text":"Dulemar-bese-gormalad be bela-bela sabed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Jehováʼye, an bese-gornaid be itoge,","poem":1},{"text":"an-wilesagwar-gornaid be itoge.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"An suli-suli-itogedgi an bese goled,","poem":1},{"text":"ar be an-abin-imakdaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová, bab-dummagan-beyobid sated,","poem":1},{"text":"be-ibmar-imaksadyobi gege ibmar imakmalad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bela be dulemar-obinnisadi, be-asabin sindigar signonimaloed,","poem":1},{"text":"be-nug odummomaloed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Dummad, ar bebi dummarba-maid,","poem":1},{"text":"ar bebi ibmar-gegerdakleged imaked.","poem":2},{"lineBreak":true},{"text":"¡Ar bebi unnila Bab-Dummad gued!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bab-Jehová, an be-igar-innikigwadba nanadii guega, Be-Igar-Maid be anga oyoge.","poem":1},{"text":"Bab-Dummad, an be-nug-odummodii nanaega, be an-gwage ogannoge.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"An-Bab-Dummad-Jehová, bela-bela an napiragwadgi be-nug odummogoed,","poem":1},{"text":"degisadegu, an be-nug odummodii guoed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ar bela-belad be an-sabed,","poem":1},{"text":"degisoggu, burgwega be an-imaksasulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Bab-Dummad, dulemar-na-san-buled-imakmalad angi gwisgunanaid,","poem":1},{"text":"dule-gindakmalad an-oburgwebied.","poem":2},{"lineBreak":true},{"text":"We-dulemar gwen begi binsasurmalad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bab-Jehová, bedi dule-nuedid, emar-wiledakedid.","poem":1},{"text":"Bedi, baisursunna urwesulidid,","poem":2},{"text":"sabgued-dummad-nikadid,","poem":1},{"text":"dule-innikigwadbalidid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bab-Dummad, be an-dake,","poem":1},{"text":"wile-be-an-dake.","poem":2},{"text":"Be-nug-odummodiidga be-gargangued be uke.","poem":1},{"text":"Ome-be-nug-odummodiid-e-machi be bendake.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bab-Dummad, an-isdarmalad dakmalaga,","poem":1},{"text":"an-isdarmalad bingegumalaga, be-sabgued be angi oyoge.","poem":2},{"lineBreak":true},{"text":"Ar be Bab-Jehová, be an-bendakedid, be an-gwage-armakedid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}