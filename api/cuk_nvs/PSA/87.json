{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"heading","content":["Bab-Dummad-e-neggweburga namakleged"]},{"type":"hebrew_subtitle","content":["Coré-wagan, we-namaked narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Dummad-e-neggwebur-e-negsailamar yar-islidikidgi mamaid.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová Jacob-wagan-e-negmarba bur bule Sión-yawagakmar sabed.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bab-Dummad-neggwebur, ibiyobi be-yeerdaklegedginbi sunmakmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová soged:","poem":1},{"text":"“Neggweburmar-magar-an-dakmalad-abargi sunna an we-neggweburmar bie-bie saed:","poem":2},{"lineBreak":true},{"text":"Rahab, Babilonia.","poem":2},{"lineBreak":true},{"text":"Filistea, Tiro, Etiopía.","poem":2},{"text":"We-neggwebur-e-dulemar-annik sogleged: ‘Sión-neggweburgi Bab-Dummad-magar-daksamarye.’ ”","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sión-neggweburnik soglegoed: “We-dule, degi, wemoga, Siónʼgi gwalulesmarye.”","poem":1},{"text":"Bab-Dummad-Bur-Birigined na e-sunnad Sión-neggwebur sisad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Jehová neggweburmar-nug-mamaid-gardagi narmakoed:","poem":1},{"text":"“We, Sión-neggweburgi gwalulesye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Namaknanaidgi, degi, gwirnanaidgi, sognanaid:","poem":1},{"text":"“Anmar begi bela-danikid.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}