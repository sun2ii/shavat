{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":88,"content":[{"type":"heading","content":["Burgwedgi-bendaklegega Babse-goled"]},{"type":"hebrew_subtitle","content":["Ezraí-dule-Hemán Coré-wagwa, we-namaked-Masquilʼye-nugad narmaksad."]},{"type":"hebrew_subtitle","content":["Namakmalad-e-iduedga soglesad: We-namakleged Mahalatʼyob namaklegoye."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová, Bab-Dummad-an-bendaked, an bese ibginedba, mutikidba gordiid.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"An bese-gornaidi be itoge.","poem":2},{"lineBreak":true},{"text":"An bese wilesakwaa-goledi be nue itoge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bela-bela angi bonigan yolenaid,","poem":1},{"text":"an burgwedani maid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dulemar bato burgwisayob angi binsamalad.","poem":1},{"text":"An ganguedsulidyob dakleged.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Burgwarmalad-abargine an-metemalad,","poem":1},{"text":"napa-urba mui-mellemaiyobi an gued.","poem":2},{"text":"We-muimargi-bar-be-binsalesulidyob an gued,","poem":1},{"text":"ar be wemar bar-bendaksasulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yaa-bur-matusulidgi be an-balimeted,","poem":1},{"text":"nega-sichiganba, napa-urba-solanaga be an-balimeted.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Be-sae-itogedi bela angine yolenonikid,","poem":1},{"text":"be-urwed demargi-gundilenaiyobi an-imaksad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"An-aimar angi banguega be imaksad,","poem":1},{"text":"an-aimar ima-an-dakega be imaksad.","poem":2},{"text":"An dule-esgaryagi-mellesiidyob geg wakinned,","poem":1}]},{"type":"verse","number":9,"content":[{"text":"An bela-bela-boedbali an-dalamar momommakded.","poem":2},{"lineBreak":true},{"text":"Bab-Jehová, bane-bane an bese gordiid,","poem":1},{"text":"an bese argan onakdiid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"¿Ar dule-burgwarmalad-abargi ibmar-gegerdaklemalad be imake?","poem":1},{"text":"¿Dule-burgwarmalad be-nug-odummogega sunna durgudagosi?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"¿Dule-burgwarmamaidgi sunna be-sabguedgi sunmaklesi?","poem":1},{"text":"¿Dule-burgwarmalad-neggi sunna be-innikidaedgi sunmaklesi?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"¿Ar nega-sichigangi, be-ibmar-gegerdaklemalad wismarsi?","poem":1},{"text":"¿Ar napneg-ieleged-neggi, be-igar-inniki-imakleged wismarsi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bab-Jehová, an bese goled, be an-bendakye.","poem":1},{"text":"Wakudaryalaba an bese-goledgi, an be-amied.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bab-Jehová, ¿ibiga be an-obane?","poem":1},{"text":"¿Ibiga be angi be-wagar odukue?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"An sapingwagwad-akale ibitodiid,","poem":1},{"text":"an burgwed-naga gudidaed.","poem":2},{"text":"Bab-Jehová, be angine gwage-nunmaked-dummagan barmialid,","poem":1},{"text":"geg an bar gugusad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Be-urwedbali an galitosad,","poem":1},{"text":"be-ise-sabsur-an-imaksadi, an-obelosad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Be-emargi-gwisguedi, demaryobi bane-bane an-ebirnaid,","poem":1},{"text":"bela an-ebilis naid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Be angine an-aimar obachad,","poem":1},{"text":"be an-gwenadgan angi obachabalid.","poem":2},{"lineBreak":true},{"text":"Emigindi, unnila negsichidbi an-aiyob gued.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}