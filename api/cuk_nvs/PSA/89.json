{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":89,"content":[{"type":"heading","content":["Bab-Dummad Davidʼbo-igar-mesisad"]},{"type":"hebrew_subtitle","content":["Ezraí-dule-Etán, we-namaked-Masquilʼye-nugad narmaksad."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼye, an degisadegu be-sabguedgi namakdii guoed.","poem":1},{"text":"An degisadegu bela dulemarga, be-innikidaedgi sunmakdii guoed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"An sogdii guoed: Be-sabguedi degisadegu gege berguye.","poem":1},{"text":"Be-innikidaedi nibneg-naiyob degisadeguye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová, be sogsa gusad: “An-dule-susadbo an igar mesisye.","poem":1},{"text":"An-mai-Davidʼga an ise-sogar sogsagusye:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"‘Be-sorbali, be-wagan degisadegu reyga-megmalaga an imakoye,","poem":1},{"text":"be-wagan degisadegu negsemamai an imakoye.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová, be ibmar-gegerdaklemalad-imaksadba nibnegginmaladi be-nug odummomalad.","poem":1},{"text":"Dule-gwage-swilidikmalad-onmakbukwadgi be-innikidaedgi sunmakmalad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nibneggine, ¿doa Bab-Jehováʼyopira gue? Dule deyobid sate.","poem":1},{"text":"Nibnegginmalad-abargi, ¿doa Bab-Jehováʼyob gue? Dule deyobid sate.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dule-gwage-swilidikmalad onmakbukwale, Bab-Dummad-dobee itodamalad.","poem":1},{"text":"Bab-Dummad na e-ebiris-bukmaladba bur-dummadid, bur-dutusurbalid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Dummad-Bela-Gangued-Nika-Maid, ¿doa beyob gue? Dule beyobid sate.","poem":1},{"text":"Bab-Jehová, bedi gandikidid, bedi innikidaedid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bab-Dummad, demar-dagumakmaid be bargaed.","poem":1},{"text":"Demar-dummagan-arwemaid be obogileged.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Be ibdula-dummad-Rahabʼye-nugad, maataa be oburgwisad.","poem":1},{"text":"Bela-bela be gangued-nikadba be-isdarmaladgi be nakwisad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Jehová, nibneg begadid, napneg begadid.","poem":1},{"text":"Be we-napneg-naidi obinnisad, bela egi-ibmar-bukwadi be urbisad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Be dad-nakwed-argan-sapiledsik-yar-bukwad obinnisad,","poem":1},{"text":"dad-nakwed-argan-nuedsik-yar-bukwad be obinnisbalid.","poem":2},{"text":"Tabor-yar weligwar be-nugga namaked,","poem":1},{"text":"Hermón-yar weligwar be-nugga namaked.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bab-Jehová, bela-bela be gangued-nikadba be ibmar-dummagan imaked.","poem":1},{"text":"Be-argan-nued be onakwed, ar be emargi obichad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Bab-Jehová, igar-maidba, igar-innikigwadba be negsemaid.","poem":1},{"text":"Dule-wiledaked be oyoged,","poem":2},{"lineBreak":true},{"text":"igar-innikigwad be oyobalid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bab-Jehová, dulemar weligwaledgi-be-nug-odummomaladgi, nued binsalesad.","poem":1},{"text":"Wemar be-sogedba nanadimalad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Be-nuggi wergudii osedoddamalad,","poem":1},{"text":"be-igar-innikii-imakedgi wergudimalad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ar be we-dulemar-e-gangued-e-yeerdakleged gued.","poem":1},{"text":"Nued be anmargi-binsaedbali, be anmar-gangued ogannoged.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Be, Bab-Jehová, be anmar-sigu-abgaedga gued.","poem":1},{"text":"Be, Israel-dulemar-e-reyd, Gwage-Isligwaledid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ibagwengine, be-dula-gwage-swilidikmaladga be negburgan oyosad,","poem":1},{"text":"aba ega be sunmaksad.","poem":2},{"text":"Be-dulamar-bega-nued-nanadimaladga be sogsagusad: “An dule-wargwen-buled bendaksad.","poem":1},{"text":"Dulemar-abargi dule-bur-emargi-obindiid-e-nug an odummosad.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"An-mai-David an sunonikid,","poem":1},{"text":"reyga-guega an-gwallu-wawad, an e-nonogi eosad.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"An bendakdii guoed.","poem":1},{"text":"An-ganguedgine ogannodii an imakoed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"E-isdarmalad egi nakosulid,","poem":1},{"text":"dule-isganamar sabsur-imakosulid.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"An e-isdarmalad obelogoed,","poem":1},{"text":"dule-e-isdardakdimaladi an osulogoed.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"An degisadegu David-sabgudii guoed.","poem":1},{"text":"An-nuggine e-gangued dungumai guoed.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"David, demar-Mediterráneoʼye-nugad-naid-akar,","poem":1},{"text":"Éufrates-diwar-maidse neg-gani guoed.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Anga sogoed: ‘Be an-baba,","poem":1},{"text":"be an-Bab-Dummad-an-abonogedid, be an-edarbedid.’","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Machi-sailaginedga an imakoed,","poem":1},{"text":"bela reymar-baiganba bur dummadga-megega an imakoed.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"An degisadegu sabgudii guoed,","poem":1},{"text":"an-ebo-igar-mesisadi degisadegu-mai guoed.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"E-wagan e-sorba negsemamai gumaloed,","poem":1},{"text":"Igi nibneg degisadegu nai,","poem":2},{"lineBreak":true},{"text":"deyobi e-wagan degisadegu negsemamai gumaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"”Ar e-wagan an-igar-maidgi bangudmalale,","poem":1},{"text":"an-igar-maidba nanasurmalale,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"An-igar-maidgi annadmalale,","poem":1},{"text":"an-igar-uksadba ibsasurmalale,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"e-uayasulidaed-ulale, an sabsur-odurdakoed,","poem":1},{"text":"e-isgusad-ulale, an bibyogoed.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Degi-inigwele, an David-sabguosuli bipisaale guosulid,","poem":1},{"text":"an egi innikidaedi oberguosurbalid.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"An Davidʼbo-igar-mesisadi an bisgosulid,","poem":1},{"text":"an-ibmar-sogsadi an osulogosurbalid.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"An-nug-islidikid-ular, an unnila irgwennaa ise-sogar imaksad,","poem":1},{"text":"an Davidʼga gakansaosulid:","poem":2}]},{"type":"verse","number":36,"content":[{"text":"David-sorba, e-wagan degisadegu negsemamai gumaloed.","poem":1},{"text":"An-asabin, igi dad-ibeler degisadegu-nai,","poem":2},{"lineBreak":true},{"text":"deyobi, e-wagan degisadegu negsemai gumaloed.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Igi nii nibneggi degisadegu-nai,","poem":1},{"text":"deyobi, David-e-wagan degisadegu negsemai gumaloed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"Degi-inigwele, Bab-Dummad, be Reyga-guega-dule-susadi, be meted, be obachad,","poem":1},{"text":"a-dulegi bela-bela be uluded.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Be-maibo be igar-mesisadi be bichisad,","poem":1},{"text":"e-wagan-degisadegu-negsemai-guoed e-ibe be obelosad.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Bela e-galu-dikar-matusulid e-ibe be omukusad,","poem":1},{"text":"e-neg-gandikbukmalad e-ibe be obelosad.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Bela dulemar-a-igargi-nasdamaladi, e-ibe ibmar atursadamalad.","poem":1},{"text":"Neggweburmar-e-dikarba-bukmalad egi dodomalad.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"David-e-isdarmalad-e-gangued be ogannosad,","poem":1},{"text":"e-isdarmalad weligwar-itogega be imaksad.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"David-e-es-suid-nugar sate be imaksad,","poem":1},{"text":"bila-onogedgine gwen be bendaksasulid.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"E-gangued-yeerdakleged e-ibe be osulosad,","poem":1},{"text":"e-ologana napase e-ibe be meted.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"E-birga-dulagudigued e-ibe be osikirmaksad,","poem":1},{"text":"binged-dummad ega be uksad.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Bab-Jehová, ¿wede degisadegu be dukumai guoe?","poem":1},{"text":"¿Wede sooyobi be-urwed degisadegu guoe?","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Bab-Jehová, be insao, an-dula-gudiguedi unnila sikwas gued.","poem":1},{"text":"Degisoggu, ¿ibiga be dule-obinnisa?","poem":2}]},{"type":"verse","number":48,"content":[{"text":"¿Ar doa burgosuli degisadegu dula gudiguoe?","poem":1},{"text":"¿Ar doa burgwedgine wakinnoe?","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Bab-Jehová, be sabguedsailagined,","poem":1},{"text":"be Davidʼga be-innikidaedba ise-sogar-sogsa-gusadi, ¿bia nade?","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Bab-Jehová, be-maimargi-dodolediid, be ebinsao,","poem":1},{"text":"dulemar-bukidar-angi-dodogedi an ulubgi sediid.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Bab-Jehová, be-isdarmalad anmargi dodomalad.","poem":1},{"text":"Na be dule-susadgi dodomalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"¡Bab-Jehová-e-nug degisadegu odummolesun!","poem":1},{"text":"¡Degisadegu odummolesun!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":52}