{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":9,"content":[{"type":"heading","content":["Bab-Dummadga dog-nuedye sogsad"]},{"type":"hebrew_subtitle","content":["David we-namaked narmaksad. Namakmalad-e-iduedga-soglenaid:"]},{"type":"hebrew_subtitle","content":["Gar-goledba namakoye."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼye, bela-belad an be-nug odummogoed.","poem":1},{"text":"Bela be-ibmar-gegerdaklemalad-imakdiidgi an sunmakoed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Dummadye, begi an werguoed, begi an yeer itogoed.","poem":1},{"text":"Bab-Dummad-Bur-Biriginedye, be-nuggi an namakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"An-isdarmalad be-abin wakitemalad,","poem":1},{"text":"amar yoledapmalad, amar be-abin bela burgwismalad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Be-ologanagi be sigisad,","poem":1},{"text":"dulemarga innikigwadba be igar naboged.","poem":2},{"text":"A-ulale, innikigwadba be anga igar nabosad,","poem":1},{"text":"be anba nagunonikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bab-Dummad, dule-yar-baid-baidgi-bukwamaladse be sabsur-ulusad,","poem":1},{"text":"dule-isganamar be obelosad.","poem":2},{"lineBreak":true},{"text":"A-dule-isganamargi dulemar bipisaale bar binsaega be imakosulid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"An-isdarmalad bela bergusmalad,","poem":1},{"text":"dule-wargwensaale gwen gudii gussulid.","poem":2},{"text":"E-neggweburmar bela napabi nagusad,","poem":1},{"text":"bipisaale gwen bar egi binsalegosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bab-Jehováʼdi dulemarga igar-itogega e-ologanagi sigisad.","poem":1},{"text":"Bab-Jehováʼdi degisadegu maigu guoed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová dulemarga innikigwadba igar naboged,","poem":1},{"text":"degi, dulemarga igar-innikigwadba negseed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bab-Jehováʼye, be neg-dukuedyob dule-mesagwar-imakledimaladga gued.","poem":1},{"text":"Ibagan-suli-suli-itolegedgi, Bab-Jehováʼye, a-dulemarga be galu-gandikidyob gued.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Jehováʼye, dulemar-be-amimaladi be wargwen bipisaale metedisulid.","poem":1},{"text":"A-ular, dule-magar-be-dakmalad begi bensurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bab-Jehová, Sión-neggweburgi negdakmaid.","poem":1},{"text":"A-Bab-Jehováʼga namakmar.","poem":2},{"lineBreak":true},{"text":"E-ibmar-dummagan-imakedgi, dule-yar-baid-baidgi-bukmaladga be sunmakmar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bab-Dummad, be dule-gindakmalad buged-mai-imakosurdeeye sogsulid,","poem":1},{"text":"Bab-Jehová dule-wiledimalad-ese-gornaid nue itodaed.","poem":2},{"lineBreak":true},{"text":"Amar-iegodeeye sogsulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bab-Jehováʼye, wile be an-dake.","poem":1},{"text":"Nue be dakena,","poem":2},{"text":"isdar-an-dakmalad nue an-wionanaid.","poem":1},{"text":"Melle dulemar an-oburgwega be imake,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"adi, Jerusalén-neggwebur-dogedgi, dulemarga an be-nug-odummogega,","poem":1},{"text":"degine, be an-bendakedgi an weligwar-itogegar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dule-aku-be-dakmalad na dukin yardaklesmalad.","poem":1},{"text":"Emar-gaega, saki-odukuar-nasismaladgi, na dukin e-nag galesmalad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bab-Jehová-igar-innikigwadbi-imaked, bela nue-magar daksamalad.","poem":1},{"text":"Dule-isganamardi, dukin e-ibmar-isgana-imaksadgi yardakledimalad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dule-isganamar, bela burgwed-negse seledmaloed.","poem":1},{"text":"Dule-yar-baid-baidgi-bukmalad Bab-Dummad-ieddamalad,","poem":2},{"lineBreak":true},{"text":"amar neg-urba burgwed-negse seledmaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ar dule-wiledimaladdi, be degisadegu iegosulid,","poem":1},{"text":"dule-baidse-sabsur-wiledimalad be-ibmar-edarbedimalad, berguus be imakosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"¡Bab-Jehováʼye, nue be atake!","poem":1},{"text":"¡Dulemar melle begi-nakwed be imake!","poem":2},{"text":"Dule-yar-baid-baidgi-bukmaladga be igar-itoge.","poem":1},{"text":"A-dulemar be sabsur-odurdake.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bab-Jehováʼye, dulemar-e-niga be egwane.","poem":1},{"text":"Dule-yar-baid-baidgi-bukmalad wisgued be imake,","poem":2},{"lineBreak":true},{"text":"emarde, Bab-Dummadsurmarye, unnila dule-gumarye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}