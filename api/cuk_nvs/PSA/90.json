{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":90,"content":[{"type":"heading","content":["Bab-Dummad degisadegu-maid"]},{"type":"hebrew_subtitle","content":["Bab-Dummad-e-dule-Moisés Babse goled."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová, be anmarga degisadegu, anmar-dukuedga gudiguad.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová, amba yoo yarmar be urbegua,","poem":2},{"lineBreak":true},{"text":"amba yoo napa be obinyegua,","poem":2},{"lineBreak":true},{"text":"amba yoo napneg be obinyegua,","poem":2},{"text":"degisadegu dikasurgus, emi-ibadse,","poem":1},{"text":"bato bedi Bab-Dummad gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová, be sogdele: “¡Dulemar, gannar napaga-binyemarye!”","poem":1},{"text":"Be-sogedbali dulemar gannar napaga binyiddaed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová, birga-miligwenadi (1,000) bega sae-iba-nasadyob gued,","poem":1},{"text":"bega sikwas-neg-mutikid-nasadyob gued.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová, igi diwar-noder ibmar-seddae,","poem":1},{"text":"deyobi, be dulemar-seddaed.","poem":2},{"text":"Dulemar, unnila sikwas-gabdakedyobi dulagudigued.","poem":1},{"text":"Dulemar, wakdaradba gaganmar-ainiar-daedyobi gued.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wakdara e-dutumar achundagoed.","poem":1},{"text":"Sedogusale, bato dingudoed, degi-burgwidoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová, be-urwedi anmar-obeloged,","poem":1},{"text":"be-sae-itoged anmar-dobe imaked.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Anmar-ibmar-isgana-imaked bela be wisid,","poem":1},{"text":"anmar-isgued-ulubgi-naidi begi dukusulid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Jehová, be-urwed-ular, anmar-san bergumaid,","poem":1},{"text":"anmar-ibagan sikwas-bunnolegeyob gued.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Anmar birga-dulapaa-gakambese (70) dulagudigued.","poem":1},{"text":"Anmar-bur-dutusur-gumaladdi, sunna birga-dulabakese (80) warmaked.","poem":2},{"text":"Degi-inigwele, suiti-dulagudiguedi, unnila arbaed-dummad anmarga uked,","poem":1},{"text":"wile-itoged anmarga uked.","poem":2},{"text":"Igi anmar sikwas-dula-gudigue,","poem":1},{"text":"deyobi, birgamar nasmogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bab-Jehová, ¿doa be-urwed-gangued magar-itoge?","poem":1},{"text":"Be-urwed bela-bela-gangusoggu, anmarga dobed-dummad uked.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bab-Jehováʼye, anmar sikwas dula-gudisoggu, be anmarga binsaed-nikagued uke,","poem":1},{"text":"adi, anmar nued nanadii guegar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bab-Jehová, gwae be anmarse dage.","poem":1},{"text":"Ar anmar be-dulamar gued.","poem":2},{"lineBreak":true},{"text":"¡Be-maimar be wile dake!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wakudaradba, be-sabgued be anmarga oyoge,","poem":1},{"text":"anmar bane-bane bega weligwaledgi namakdii guoed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Igi birgabargus suli-suli-itogega, degi, wile-itogega be anmar-imaksa,","poem":1},{"text":"emigindi, ibagan debayobi-mergue be anmar-weligwar imake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Be-maimarga be-ibmar-imaked be oyoge,","poem":1},{"text":"e-waganga be-gangued-dummarbad be oyoge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Bitigi anmar-Bab-Dummad-Jehová-nued-binsaedi, anmargi oyolenonikina gadin.","poem":1},{"text":"Bab-Dummadye, anmar-ibmar-imakedgi be nued-binsae,","poem":2},{"lineBreak":true},{"text":"anmar-ibmar-imaked be onasgumai imake.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}