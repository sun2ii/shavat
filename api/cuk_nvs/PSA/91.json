{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":91,"content":[{"type":"heading","content":["Bab-Jehová anmar-dukuedid"]},{"type":"verse","number":1,"content":[{"text":"Dule, Bab-Dummad-Bur-Biriginedgi-dukued-amiedi, Bab-Dummad-Bela-Gangued-Nika-Maid e-edarbedga guoed.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"An Bab-Jehováʼga soged: “Be an-dukuedid, be an-garganguedid,","poem":1},{"text":"an-Bab-Dummad, an begi bensulidid.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bab-Jehováʼbi bonigan-dukuar-bukwadgi be-ollor-imaked,","poem":1},{"text":"boni-bulegangi be-ollorsaed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Igi gannir e-sakan-urba e-mimmigan-odukue,","poem":1},{"text":"deyobi Bab-Jehová be-edarbedga guoed.","poem":2},{"text":"Bab-Jehováʼgi be dukued amioed.","poem":1},{"text":"E-gayaburba be-sigu-abgaedyob guoed,","poem":2},{"lineBreak":true},{"text":"be-edarbedga guoed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mutikidba boni-noed be dobguosulid,","poem":1},{"text":"ibginedba sigu-mileged be dobguosulid,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"negsichidgi boni-gudiid be dobguosulid,","poem":1},{"text":"yoruku boni-dule-ogiloged be dobguosurbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Be-argan-sapiledsiki, miligwen (1,000) dulemar burgwemai guoed,","poem":1},{"text":"be-argan-nuedsiki, miliambe (10,000) dulemar burgwemai guoed.","poem":2},{"lineBreak":true},{"text":"Bedi akar-guosulid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dule-isganamar sabsur-odurdaklegoed, be-sunnad be dakoed.","poem":1},{"text":"Bedi sabsur-odurdaklegosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ar bedi Bab-Jehová be-odukuedga imaksasoggu,","poem":1},{"text":"Bab-Dummad-Bur-Birigined be-edarbedga imaksasoggu,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ibmar-isgana gwen be-ebugosulid,","poem":1},{"text":"boni-dummagan gwen be-neguyase warmakosulid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar Bab-Jehová, e-baliwiturmarga igar-ukoed,","poem":1},{"text":"bia be nadesogele, adi, be-edarbemalagar.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mer be akwagi-gowarmakega baliwiturmar nakwaa be-semai guoed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Achumigur-nono-wawaadgi be obinoed.","poem":1},{"text":"Naibe-nuedgi be dii-dii annaoed.","poem":2},{"text":"Be achumigur-nono-wawaad-sapingwagwad naibi-imakoed.","poem":1},{"text":"Be naibe-bulegan oburgoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Bab-Dummad soged: “Ar an-sabsoggu, ani an ollor-imakoed,","poem":1},{"text":"ar magar-an-daksoggu, bonigangi an bendakoed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ar anse-gollalile, an abinsaoed,","poem":1},{"text":"na surbinsa-itogedgi an eba gudiguoed,","poem":2},{"text":"an ollor-imakoed,","poem":1},{"text":"an e-nug odummogoed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"An ega birga-ichesur-dula-gudigued ukoed,","poem":1},{"text":"an-abonolegedgi weligwar-itodii an imakoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}