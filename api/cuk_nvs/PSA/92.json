{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":92,"content":[{"type":"heading","content":["Bab-Dummad-nued-daed-ular, ega namakleged"]},{"type":"hebrew_subtitle","content":["We-namaked obunnoged-ibagi namakleged."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová, bega-doggus-nuedye-soglegedi, ibiyobi dog-nuedi.","poem":1},{"text":"Bab-Dummad-Bur-Birigined, be-nuggi-namakedi, ibiyobi dog-nuedi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wakudaryalaba be-sabgued-dummadgi-namakedi, ibiyobi dog-nuedi.","poem":1},{"text":"Mutikidba be-innikidaedgi-namakedi, ibiyobi dog-nuedi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gar-oimakar-goledba-namaked, gar-lira-goledba-namaked, ibiyobi dog-nuedi.","poem":1},{"text":"Gar-arpa-goledba-namaked, gar-salterio-goledba-namaked, ibiyobi dog-nuedi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová, be be-ibmar-gegerdaklemalad-imakedba, weligwar be an-imaked.","poem":1},{"text":"A-ulale, be-ibmar-imaksadba, an weligwar-itoge an bega binnasur namakoed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"¡Bab-Jehová, ibibayobi be-ibmar-imaksad dummarba-gue!","poem":1},{"text":"Bab-Jehová, be-binsaed bela-bela yeer-gangusoggu,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"dule-binsaedsulidaed, magar itosulid,","poem":1},{"text":"dule-ibmar-wissulid, aku itoged.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Amba dule-isganamar gaganyobi ainialile, dule-galagwensulidamalad dutuyob achunnalile,","poem":1},{"text":"unnila degisadegu-berguega gumaloed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová, bebi unnila degisadegu bur-gandikidga maid.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bab-Jehová, napiragwa, be-isdarmalad berguoed,","poem":1},{"text":"bela dule-galagwensulidamaladi oaisakilegoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bedi moli-bebe-nikad-ursilid-gangued-nikadyobi anga gargangued uked,","poem":1},{"text":"gwallu-wawad-bur-nuedgi be an-nono wawamaksad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"An-isdarmalad-galakusad-dakega, be an-imaksad,","poem":1},{"text":"an-isdarmalad-obelolesad-itogega, be an-imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dule-nuegan, ogob-sanmakedyobi gumalad,","poem":1},{"text":"Líbano-yargi urwarmar-dungumaiyobi gumalad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dule-nuegan, Bab-Jehováʼse-goled-neggi sapi-digar-gwichiyobi gumalad,","poem":1},{"text":"anmar-Bab-Dummadse-goled-neg-imbagi dutuyobi achutemalad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dule-nuegan, amba sered-ugakine, sanmakgwichi gumaloed,","poem":1},{"text":"san-nued-gudii, dutusur-gudii gumaloed,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"adi, sogmalaga: “Bab-Jehová dule-innikigwadye.","poem":1},{"text":"Bab-Jehová an-gandikidye,","poem":2},{"lineBreak":true},{"text":"egine igar-isgana-imaked naisurye.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}