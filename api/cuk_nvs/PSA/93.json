{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"heading","content":["Bab-Jehová, Rey-gued"]},{"type":"verse","number":1,"content":[{"text":"¡Bab-Jehová, gangued-yeerdakle-nika negsemaid!","poem":1},{"text":"Bab-Jehová, dummarba-gued oyosad, e-gangued oyosad.","poem":2},{"text":"Innikigwadba napneg nasiksad,","poem":1},{"text":"napneg bar bipisaar onirilegosulid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová, bedi gebe-negasaila-akale, bato negsemaid.","poem":1},{"text":"¡Bedi degisadegu maiguad!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová, diwarmar dutusuli nomamaid,","poem":1},{"text":"diwarmar binnasuli uurmakmaid,","poem":2},{"lineBreak":true},{"text":"diwarmar binnasuli sukamakmaid,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová, ar bedi demar-uurmakedba bur be dutusur gued,","poem":1},{"text":"ar bedi muu-billigan-arwedba bur be dutusur gued,","poem":2},{"lineBreak":true},{"text":"ar bedi nibneggi bur dutusur maid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová, Be-Igar-Mamaidgi dutusuli mamaid, gege bisged.","poem":1},{"text":"Islidik-gued degisadegu bese-goled-neg-yeerdakle imaked.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}