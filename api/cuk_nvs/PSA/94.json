{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":94,"content":[{"type":"heading","content":["Bab-Jehová-igar-naboged innikigwadid"]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehová-dule-buged-mai-imakedye,","poem":1},{"text":"Bab-Dummad-dule-buged-mai-imakedye, be magarodage,","poem":2},{"lineBreak":true},{"text":"dule-sabsur-imaklediid be buged-mai imakdage.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová, be igar-naboged-dulesoggu, be-gangued be oyodage,","poem":1},{"text":"dule-na-san-buled-imakdimalad, be sabsur-odurdakdage.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová, ¿sanagwadse dule-isganamar yeer-itodii gumaloe?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ar bela we-dule-isganamar, dule-ibmar-sabsur-sogmaladid,","poem":2},{"lineBreak":true},{"text":"na san-dummarbaa imakmaladid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová, dule-isganamar be-dulamar-sabsur imakdimalad.","poem":1},{"text":"Be-dulamar-mesagwar imakdimalad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"We-dule-isganamar, omegan-ei-sui-burgwismalad oburgwemalad.","poem":1},{"text":"Wemar, dule-yar-baidsikid ogilomalad.","poem":2},{"lineBreak":true},{"text":"Wemar, dule-babsuli-gudimalad gindakmalad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dule-isganamar sogmalad: “Bab-Jehová we-ibmar daksulid,","poem":1},{"text":"Jacob-e-Bab-Dummad, we-ibmar wissulid.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"¡Dule-ibmar-aku-itomalad, be magar itomala!","poem":1},{"text":"Bemar binsaed-satemaladi, ¿sanagwadse be binsaed-nika gumaloe?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ar dule-anmarga-uaya-nasiksadi, ¿itogosuli?","poem":1},{"text":"Ar dule-anmarga-ibya-sisadi, ¿dakosuli?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ar dulemar-ibmar-noar-imaksad-onudakedi, ¿sabsur-odurdakosur be ebinsae?","poem":1},{"text":"Ar dule-ibmargi-odurdakedi, ¿ibmar-wisguosur be ebinsae?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Jehová dulemar-binsaed bela wisid,","poem":1},{"text":"Bab-Jehová wisid, dulemar unnila yogasaar binsamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bab-Jehová, dule-ibmar-noar-imaksad be nudakedi, we-dulegi be ise-nued binsasad.","poem":1},{"text":"Be, be-igar-maidgi-dule-odurdakedi, we-dulegi be ise-nued binsasad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"We-dule, ibagan-bulegangi gwage-bogidiki gudiguoed.","poem":1},{"text":"Dule-isganagardi, diglegega napa gwislegoed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bab-Jehová e-dulamar obanosulid.","poem":1},{"text":"Bab-Dummad, e-dulamar-egadga-imaksad wargwen metosulid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Igar-nabolegedi igar-innikigwadba imaklegoed,","poem":1},{"text":"bela dule-gwage-inniki-gudimalad, igar-maidba damaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"¿Doa, dule-isganamar-abin an-irwa gwisgusa?","poem":1},{"text":"¿Doa, dule-isganamar-abin anba nagusa?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ar Bab-Jehová an-bendaksasulina,","poem":1},{"text":"bato an napa-uluba bergus mellemainad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bab-Jehová, an sogsagusgu, “an bergudaniye,”","poem":1},{"text":"be-sabgued-nikadba yog be an-bendaknoni gusad.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"An bela-bela suli-suli-itogedgine, baisur-itogega be an-imaksad,","poem":1},{"text":"weligwaled be anga uksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Bab-Jehová, reymar-isganamar-e-aiga geg be gued.","poem":1},{"text":"Ar we-reymar ibmar-isgana-imakega igar-mesmalad,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"dule-nuegangi-aibinega igar-amimalad,","poem":1},{"text":"dule-ibmar-akar-imaksasulid-oburgwega imakmalad.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ar Bab-Jehová an-edarbedid,","poem":1},{"text":"an-Bab-Dummadid, akwasaila-an-odukuedyob gued.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bab-Jehová dule-isganamar-e-isguedi, dule-isganamargi-aibinega imakoed.","poem":1},{"text":"Bab-Jehováʼse e-isgusad-ulale, dule-isgana berguoed.","poem":2},{"lineBreak":true},{"text":"¡Anmar-Bab-Dummad-Jehová we-dulemar-obelogoed!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}