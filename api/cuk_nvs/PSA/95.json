{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"heading","content":["Bab-Jehováʼga weligwaledgi namakmala"]},{"type":"verse","number":1,"content":[{"text":"¡Dagmala, anmar weligwaledgi Bab-Jehováʼga namakmala!","poem":1},{"text":"¡Anmar weligwaledgi Bab-Dummad-anmar-abonogedga namakmala!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Anmar Bab-Jehováʼga doggus-nuedye-sogedgi e-negse doge.","poem":1},{"text":"¡Anmar Bab-Jehováʼga namake!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ar Bab-Jehová, bur Bab-Dummadid,","poem":1},{"text":"bela ibmar-bab-dummadyob-imaklemalad-birgi, bur Rey-dummadid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová, na e-argan-yaurgi napa-billigan ganikid,","poem":1},{"text":"yala-dummagan-matusurmalad na egadid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Muu-billi-maidi, egadid, ar na e obinnisad,","poem":1},{"text":"neg-dinnagwad-naidi na e obinnisbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dagmala, anmar Bab-Jehová-nug-odummogega napase wagar dulluu imakmala.","poem":1},{"text":"Anmar Bab-Jehová-anmar-obinnisad-abin yokorgi sindigar sigmala.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ar e anmar-Bab-Dummadid.","poem":1},{"text":"Anmardi e-dulamar gumalad,","poem":2},{"lineBreak":true},{"text":"e anmar-edarbedid.","poem":2},{"text":"Anmardi e-sibad-wawaadyob gumalad,","poem":1},{"text":"e anmar-akwediid.","poem":2},{"lineBreak":true},{"text":"Ar emi bemar Bab-Jehová-gayaburba itogele,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"melle be Meribaʼgi-gusmalayob, bur bule burgumalo.","poem":1},{"text":"Ar igi deun nega-dulesulidganba Masahʼye-neg-nugadgi bur bule burgusgusmala, melle be deyob burgumalo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Deun agine, be-dadgan amba an-ibmar-imaksad-daksamar-inigwele, an-wilubdaksa gusmalad,","poem":1},{"text":"urwega an-imaksa gusmalad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Birga-dulabo (40) an be-dadgan-ebo sae-itodii gusad.","poem":1},{"text":"An sogsa gusad:","poem":2},{"text":"“We-dulemar noar nanadimalad,","poem":1},{"text":"an-igar-maidba ibsadisurmalad.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Degisoggu, an sae-itogedgine, an weyob ise-sogar sogsa gusad:","poem":1},{"text":"“Ega-yar-ukoye-an-sogsadgine, dogosurmalad,","poem":2},{"lineBreak":true},{"text":"agine, an ega obunnoged ukoenad.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}