{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":96,"content":[{"type":"heading","content":["Bab-Dummad, anmar-Reyd"]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼga, namakleged-binidgine, be namakmala.","poem":1},{"text":"Bela napneggi-dulemar-bukwad, Bab-Jehováʼga namakmala.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehováʼga namakmala, e-nug odummomala,","poem":1},{"text":"e-isdarmaladgi-nakwisad bane-bane obarmala.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dulemar-yar-baid-baidgi-bukmalad-abargi, e-gandikid-yeerdakleged sogmala,","poem":1},{"text":"bela neggweburmar-abargi, e-ibmar-gegerdaklemalad-imaked obarmala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ar Bab-Jehová, dule-dummadid.","poem":1},{"text":"Bela-belad e-nug odummolegergebed.","poem":2},{"lineBreak":true},{"text":"Bab-Jehová ibmar-bab-dummadyob-imaklemaladba bur bule dobguleged.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neggweburmar-baigan-e-bab-dummaganga-imaklemaladi, Bab-Dummadsulid, unnila ibmargi sobarmaladid,","poem":1},{"text":"ar Bab-Jehováʼdi nibneg obinnisad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"¡Bab-Jehová-walikaa neg-ibegwaled naid, dummarba-gued naid!","poem":1},{"text":"E-neggine gangued oyolenaid, yeerdakleged oyolenaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bela-dulemar-napneggi-bukwamalad, Bab-Jehová-nug odummomala,","poem":1},{"text":"Bab-Jehová e-gandikid-yeerdakleged be obarmala.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová-e-nug-gandikid-yeerdaklegedi be ogannomala.","poem":1},{"text":"Ese-goled-neg-imbase be dogdamala,","poem":2},{"lineBreak":true},{"text":"ega ibmar-ukleged be sedamala.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Jehová-e-nug, e-neg-yeerdaklegedgi be odummomala.","poem":1},{"text":"Bab-Jehová-asabin bela-napneggi-dulemar-bukwad bela-belad dobekwaa ambikumarsun.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dulemar-yar-baid-baidgi-bukmaladga weyob be sogmala:","poem":1},{"text":"“¡Bab-Jehová, Rey gued!”","poem":2},{"text":"Innikigwadba napneg nasiksad, napneg bar bipisaale onirilegosulid.","poem":1},{"text":"Bab-Jehová igar-innikigwadba dulemarga igar-naboged.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"¡Nibnegmar weligue, napneg yeer-itoge!","poem":1},{"text":"Muu-billi uurmake, bela egi ibmar-bukwad weligumala.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sapurmar, weligwar namakmala.","poem":1},{"text":"Bela sapurgi ibdurgan-bukwad, weligwar namakmala.","poem":2},{"lineBreak":true},{"text":"Bela sapurgi sapimar-bubukwad, weligwar namakmala.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"¡Bab-Jehová-asabin namakmala, bato danikid!","poem":1},{"text":"Igar-innikigwadba dulemarga-igar-nabogega bato danikid.","poem":2},{"text":"Bab-Jehová igar-innikigwadba dulemarga igar-nabogoed.","poem":1},{"text":"Napiragwadgi dulemarga igar-nudakoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}