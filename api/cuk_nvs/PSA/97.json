{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"heading","content":["Bab-Jehová, Rey gued"]},{"type":"verse","number":1,"content":[{"text":"¡Bab-Jehová, Rey gued!","poem":1},{"text":"¡Napneg, wergumala!","poem":2},{"lineBreak":true},{"text":"¡Dupugan-dikasur-nanaid, wergumala!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mogir-guduremalad Bab-Jehová-ebilis naid.","poem":1},{"text":"Bab-Jehová igar-inniki-imakedba negsemaid,","poem":2},{"lineBreak":true},{"text":"igar-innikigwadba negsemaid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Soo, Bab-Jehová-idu nadapid,","poem":1},{"text":"we-soo, Bab-Jehová-e-isdarmalad Bab-Jehová-ebiris-bukwad obeloged.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"E-mala-ibyedi napneg-mee imaked.","poem":1},{"text":"Napneg mala-ibyed-dakdegu, wawanmakded.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yarmala baka-gwalluyob Bab-Jehová-abin daluded.","poem":1},{"text":"Bab-Jehováʼde bela we-napneg-e-ibedid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mogirmar, Bab-Jehová-e-igar-innikigwad-imaked barsogmalad.","poem":1},{"text":"Bela-dulemar, Bab-Jehová-gangued dakmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dule-bab-dummadyob-ibmar-imakdimalad, bingegumala.","poem":1},{"text":"Dule, bab-dummadyob-ibmar-imakdimaladgi na san-dummarba-imakmalad, bingegumala.","poem":2},{"text":"Bela bab-dummadyob-ibmar-imaklemalad,","poem":1},{"text":"Bab-Dummad-asabin dulluu sigmala.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová, be igar-innikigwad-imaked-ular, Sión-neggwebur, weligwar itoged,","poem":1},{"text":"Judá-neggweburmar, yeer itomalad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"¡Ar be, Bab-Jehová-Bur-Birigined gued!","poem":1},{"text":"¡Be we-napnegba bur dummad gued!","poem":2},{"lineBreak":true},{"text":"¡Be, bab-dummadyob-ibmar-imaklemaladba bur dummad gued!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bab-Jehová, dule-ibmar-isgana-isdar-dakmalad, sabed.","poem":1},{"text":"Bab-Jehová, e-dulamar-inniki-nanadimalad, edarbed.","poem":2},{"lineBreak":true},{"text":"E-isdarmaladgi wakinnega imakbalid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dule-nuegan, nue-binsaed-nikaa imaked,","poem":1},{"text":"Bab-Jehová, dule-inniki-gudidimaladga weligwaled uked.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bemar dule-nuegan, Bab-Jehováʼgi be wergumala,","poem":1},{"text":"Bab-Jehová-nug-isligwaled be odummomala.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}