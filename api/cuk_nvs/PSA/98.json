{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"heading","content":["Bab-Dummad-Igar-inniki-imakedga namakleged"]},{"type":"hebrew_subtitle","content":["Namakleged."]},{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼga namakleged-binidgi be namakmala,","poem":1},{"text":"ar ibmar-dakledisurmalad imaksad.","poem":2},{"text":"E-ganguedgi, e-swida-gandikidgi,","poem":1},{"text":"e-isdarmaladgi nakwisad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová, na e-nakwisad bela magar-dakmalaga imaksad.","poem":1},{"text":"Bela-dulemar-yar-baid-baidgi-bukmaladga e-igar-inniki-imaked oyosad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová Israel-dulemar-sabesaila maid.","poem":1},{"text":"Ega ibmar-imakedseye-sogsa-gusad ebinsanonikid.","poem":2},{"text":"Bela dulemar-napneggi-bukmalad,","poem":1},{"text":"anmar-Bab-Dummad-bela-bela-e-bendaked daksamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bela-dulemar-napneggi-bukmalad, Bab-Jehováʼga weligwaledgi namakmala.","poem":1},{"text":"Binnasuli weligwar-namaklegedgi ega namakmala.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Jehováʼga gar-arpaʼba namakmala,","poem":1},{"text":"gar-liraʼba ega namakmala,","poem":2},{"lineBreak":true},{"text":"yeer-namaklegedgi ega namakmala.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Jehová-Rey-guedga, weligwaledgi namakmala,","poem":1},{"text":"gar-trompetaʼba ega namakmala,","poem":2},{"lineBreak":true},{"text":"garmarba ega namakmala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Demar-naid, bela egi ibmar-bukmalad namakmala,","poem":1},{"text":"Napneg-naid, bela egi dulemar-bukmalad namakmala.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Diwarmar-mamaid, argan ogormala,","poem":1},{"text":"bela yarmar-bubukwad, weligwaledgi namakmala.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Jehová-asabin weligwaledgi namakmala,","poem":1},{"text":"ar Bab-Jehová napneg-seega danikid.","poem":2},{"text":"Dulemar-bukwadga igar-innikigwad-imakedba igar nabogoed,","poem":1},{"text":"dulemar-bukwadga emarbi igar nabogoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}