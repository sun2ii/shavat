{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"PSA","translationId":"cuk_nvs","name":"Salmos","commonName":"Salmos","title":"BAB-DUMMADGA-NAMAKLEGED-GARDA SALMOS","order":19,"numberOfChapters":150,"sha256":"7fc341f6831f633a1dd8532d2d39e40295ece4048c4d4d4e1b36fa3562be0ed6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cuk_nvs/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"heading","content":["Bab-Jehová, Rey-Dummadid"]},{"type":"verse","number":1,"content":[{"text":"¡Bab-Jehová, Reyga maid!","poem":1},{"text":"Bab-Jehová e-ologanagi baliwitur-querubinʼye-nugmalad-abargi siid.","poem":2},{"text":"Neggweburmar wawanmakmala.","poem":1},{"text":"Bela napneg giglimake.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová Sión-neggweburgi bur dule-dummadid,","poem":1},{"text":"bela neggweburmargi bur dule-dummadid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"¡E-nug-dummad, e-nug-buled odummomala!","poem":1},{"text":"¡Bab-Jehová, dule-isligwaledid!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bab-Jehováʼye, be, Rey-gandikidid.","poem":1},{"text":"Igar-innikigwad-imaked be sabed.","poem":2},{"text":"Be, dulemarga yobi-gumalad-igar mesisad.","poem":1},{"text":"Be, Israel-neggweburgi igar-innikigwadba, ibmar-imaksad,","poem":2},{"lineBreak":true},{"text":"inniki-sogedba be ibmar-imaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Anmar-Bab-Dummad-Jehová-nug odummomala,","poem":1},{"text":"Bab-Jehová-asabin, napase-dulluu Bab-Jehová-nug odummomala.","poem":2},{"lineBreak":true},{"text":"¡Bab-Jehová, dule-isligwaledid!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Moisés, Aarónʼbo dule-irwa-Babse-gormaladga gusmarmogad,","poem":1},{"text":"Samuel, Bab-Jehová-nug-odummodii gusmogad.","poem":2},{"text":"Wemala, Bab-Jehováʼse gordii gusmalad,","poem":1},{"text":"geb Bab-Jehová abin-imaksadaed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wemarga mogir-bubawarba sunmaksad.","poem":1},{"text":"Wemala, Bab-Jehová-Igar-Mesisadba nanadii gusmalad,","poem":2},{"lineBreak":true},{"text":"Bab-Jehová-Igar-Uksadba gudii gusmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Anmar-Bab-Dummad-Jehová, wemar-bese-gochagu, be abin-imaksagusad.","poem":1},{"text":"Amba e-ibmar-isgana-imaksamalad-ular, be sabsur-odurdaksa-inigwele, bedi, wemargala,","poem":2},{"lineBreak":true},{"text":"Bab-Dummad-dule-isgussuliyob-dakedga gusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Anmar-Bab-Dummad-Jehová-nug odummomala,","poem":1},{"text":"e-yar-islidikidgi, e-nug odummomala.","poem":2},{"lineBreak":true},{"text":"¡Anmar-Bab-Dummad-Jehová, dule-isligwaledid!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}