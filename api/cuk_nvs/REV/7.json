{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"REV","translationId":"cuk_nvs","name":"Burbar-Oyolesad","commonName":"Burbar-Oyolesad","title":"BURBAR-OYOLESAD-GARDA APOCALIPSIS","order":66,"numberOfChapters":22,"sha256":"7690f18c1db24dee9b9d2972c6426f26386bdf6a9955101c0e36feeb98ae6c36","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/cuk_nvs/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":7,"content":[{"type":"heading","content":["Israel-dulemar mili-dulagugle-gakabake (144,000) wilubgan nasiklesmalad"]},{"type":"verse","number":1,"content":["A-sorbali, baliwiturmar-walabake napneg-naid-sukun-sogabakegi gwichi an daksad.",{"text":"Gwensak, dad-nakwedsik gwichid,","poem":2},{"lineBreak":true},{"text":"baiddi, dad-argwanedsik gwichid,","poem":2},{"lineBreak":true},{"text":"baiddi, dad-nakwed-argan-nuedsik gwichid,","poem":2},{"lineBreak":true},{"text":"baiddi, dad-nakwed-argan-sapiledsik gwichid.","poem":2},{"text":"Deyobi, we-baliwiturmar, burwa-goled-sogabakegwad-bargani gwichimalad.","poem":3},{"lineBreak":true},{"text":"Adi, we-burwamar melle napagi, demargi, degi, sapimargi, gormalagar.","poem":3}]},{"type":"verse","number":2,"content":["Degine, baliwitur-baid dad-ibeler-nakwedsik-daniki an daksabalid, Bab-Dummad-Dula-Maid-e-wilub-nasikleged sedanikid. A-baliwitur, baliwiturmar-walabakegwadse binnasur goted. We-baliwitur-warbakegwadga, napneg-ichogega, demar-ichogega, gangued uklesgusad."]},{"type":"verse","number":3,"content":["We-baliwitur-wargwenad baliwiturmar-walabakegwadga sogded: “Melle be napneg oichomargwer, melle be demar oichomargwer, melle be sapimar oichomargwer. Bina anmar Bab-Dummad-e-maiga-gudimalad-e-bebegi Bab-Dummad-wilub bela nasikgweloed. A-sorbali, geb be napneg oichomalo.”"]},{"type":"verse","number":4,"content":["Agi geb an egi-wilubgan-nasiklesmalad-mergued-bileged an itosad. Bela, mili-dulagugle-gakabake (144,000) gumalad. Wemar, Israel-dorgan sogambe-gakabogwad-bukwadgi (12) sulesmalad."]},{"type":"verse","number":5,"content":[{"text":"Judá-e-wagangi, miliambe-gakabo wilubgan nasiklesad (12,000).","poem":2},{"lineBreak":true},{"text":"Rubén-e-wagangi, miliambe-gakabo wilubgan nasiklesad.","poem":2},{"lineBreak":true},{"text":"Gad-e-wagangi, miliambe-gakabo wilubgan nasiklesad.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aser-e-wagangi, miliambe-gakabo wilubgan nasiklesad.","poem":2},{"lineBreak":true},{"text":"Neftalí-e-wagangi, miliambe-gakabo wilubgan nasiklesad.","poem":2},{"lineBreak":true},{"text":"Manasés-e-wagangi, miliambe-gakabo wilubgan nasiklesad.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Simeón-e-wagangi, miliambe-gakabo wilubgan nasiklesad (12,000).","poem":2},{"lineBreak":true},{"text":"Leví-e-wagangi, miliambe-gakabo wilubgan nasiklesad.","poem":2},{"lineBreak":true},{"text":"Isacar-e-wagangi, miliambe-gakabo wilubgan nasiklesad.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Zabulón-e-wagangi, miliambe-gakabo wilubgan nasiklesad.","poem":2},{"lineBreak":true},{"text":"José-e-wagangi, miliambe-gakabo wilubgan nasiklesad.","poem":2},{"lineBreak":true},{"text":"Degi, Benjamín-e-wagangi, miliambe-gakabo wilubgan nasiklesmogad.","poem":2}]},{"type":"heading","content":["Dulemar-bukidar mola-sibumar yoyoid"]},{"type":"verse","number":9,"content":["A-sorbali, an dulemar-bukidar dakdebalid. Dog-merguedba geg ebisleged:",{"text":"Bela dulemar bukwadi, soga-iliba dulemar-yar-baid-baidginmalad bukwamalad,","poem":2},{"lineBreak":true},{"text":"bela soga-iliba dulemar-ablis-galagwenmalad bukwamalad,","poem":2},{"lineBreak":true},{"text":"bela soga-iliba dulemar-baid-baid-danar-danar-bukwamalad,","poem":2},{"lineBreak":true},{"text":"degi, bela soga-iliba dulemar-gaya-akar-akar-sunmakmalad bukwamalad.","poem":2},"Wemar,",{"text":"ologana-asabin, degine, Sibad-Wawaad-Mimmi-asabin bukwamalad.","poem":2},{"lineBreak":true},{"text":"Bela mola-sibu-yoyoi bukwamalad.","poem":2},{"lineBreak":true},{"text":"E-arganmargine, ogob-gagangiid-gagan gani bukmarbalid.","poem":2}]},{"type":"verse","number":10,"content":["Wemar binnasur gorbukmalad, sogbukmalad:",{"text":"“Anmar-abonolegedi, anmar-Bab-Dummad-ologanagi-siidgi danikid,","poem":1},{"text":"degi, Sibad-Wawaad-Mimmigi danikid.”","poem":2}]},{"type":"verse","number":11,"content":["Baliwiturmar belagwapa ologan-ebilis, girmar-selegan-ebilis, degine, ibdula-walabakegwad-ebilis, gwichimalad. Amar Bab-Dummad-na-e-ologanagi-siid-asabin, dulluu napase imakdemalad, Bab-Dummadse gotemalad, e-nug ogannodmalad,"]},{"type":"verse","number":12,"content":["sogdemalad:",{"text":"“¡Napiragwad!","poem":1},{"text":"Bab-Dummad degisadegu be-nug odummolesun,","poem":2},{"text":"be yeerdakleged degisadegu gusun,","poem":1},{"text":"be binsaed-nue-nikarbad degisadegu gusun,","poem":2},{"text":"bega dog-nuedye sogledii gusun,","poem":1},{"text":"be nug-nued-nikad degisadegu gusun,","poem":2},{"text":"be-gargangued degisadegu gusun,","poem":1},{"text":"be-gandikidid degisadegu gusun.","poem":2},{"text":"Bab-Dummad, bela deyob degisadegu be gusun.","poem":1},{"text":"¡Napira deyob guo!”","poem":2}]},{"type":"verse","number":13,"content":["Geb degi, girmar-selegan-wargwen anse egichialid: “¿Be wisi wemar mola-sibu-yoyoimaladde, doamala? Wemarde, ¿bia danimala?”"]},{"type":"verse","number":14,"content":["An ega sogded: “Dummad, be wisid, wemar, doa gumala.” Geb anga sogdebalid:",{"text":"“Wemala, ise-nue-wilegagwar-gudigusmaladgi nosmalad-dulemalad.","poem":1},{"text":"Wemar, na-e-mor Sibad-Wawaad-Mimmi-e-abegi enuksamaladid,","poem":2},{"lineBreak":true},{"text":"agi sibudik na e-mor imaksamalad-dulemalad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"A-ular, wemar Bab-Dummad-e-ologana-asabin bukmalad.","poem":1},{"text":"Mutikidba, ibginedba Bab-Dummad-maid-neggi ega ibmar-imaknaigu gumalad.","poem":2},{"lineBreak":true},{"text":"Dule-ologanagi-siid, e-sunnad a-dulemar edarboed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"A-dulemar bar ukud itogosurmalad,","poem":1},{"text":"bar uku-ukud itogosurbalid.","poem":2},{"text":"Degine, bar dad-ibelerba gummakosurmalad,","poem":1},{"text":"bar neg-diopisulid itogosurbalid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ar Sibad-Wawaad-Mimmi-ologan-abargi-siid,","poem":1},{"text":"sibad-wawaad-edarbedamaladyob, amar-edarboed.","poem":2},{"text":"Dianmar-burba-dulad-ukedse sedoed.","poem":1},{"text":"Agine, Bab-Dummad bela amarga ibyanis elioed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/REV/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/REV/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/REV/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}