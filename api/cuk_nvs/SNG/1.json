{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"SNG","translationId":"cuk_nvs","name":"Cantares","commonName":"Cantares","title":"NAMAKLEGED-BIRIGINED-GARDA CANTARES","order":22,"numberOfChapters":8,"sha256":"ae5115ab44a49b6e31cbb0886a0ea20032ed7a6bc15da051a0df44f76180b151","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cuk_nvs/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"heading","content":["Ome-abirgin-nikad-e-namaked"]},{"type":"verse","number":1,"content":[{"text":"Salomón we-namakleged-birigined narmaksad.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"¡Bitigi be an-wagar-usana gadina!","poem":1},{"text":"Be-sabgued vino-goblegedbali, bur bule yeer itoleged.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Be-ina-wawadikid-e-yapannedi, nue-yeer yapanned.","poem":1},{"text":"Ar be-sunnadi, ina-wawadikidyob gued.","poem":2},{"lineBreak":true},{"text":"¡Agala, yagana nue-bebina sogmalad!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"¡Be an-nide! ¡Gwae beba be an-nide!","poem":1},{"text":"¡An-rey, be-gabednegse be an-sede!","poem":2},{"text":"Anmar wergumarsun,","poem":1},{"text":"anmar yeer-itomarsun.","poem":2},{"text":"Be-sabguedgi, vino-goblegedbali, bur bule anmar egi wergue.","poem":1},{"text":"¡Agala, bebina nue sogmalad!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¡Jerusalén-neggwebur-bunamala! An uka sichii gued, an yeer dakleged.","poem":1},{"text":"Cedar-dulemar-dordoneg-sichigan-bubukwadyob an-uka sichii dakleged.","poem":2},{"lineBreak":true},{"text":"Salomón-mor-dummaganyob an yeer dakleged.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mer an-uka-sichigwadgi be atakmala,","poem":1},{"text":"ar dad-ibeler-gaedba, deyob an gusad.","poem":2},{"text":"An-susmar anse ulusmalad,","poem":1},{"text":"e-uva-dub-nainu-akwega an-imaksamalad.","poem":2},{"lineBreak":true},{"text":"A-ulale, an-uva-dub-nainu bar an nue akwissurgusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"¡An-sui-nue-sabesailad! Anga be soge, be-sibadmar-gagangi-omanaegala, ¿bia be omanaddae?","poem":1},{"text":"¿Bia yorukudba be obunnogega seddae?","poem":2},{"text":"¿Ar ibiga an dule-negsuligudidaeyobi,","poem":1},{"text":"be-aimar-sibad-bukwad-abargi an be-amidii guoe?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Omegan-yeerdaklemaladba, bur be yeer dakleged.","poem":1},{"text":"Be-sui-nue-sabesailad-amiegala, sibad-gannarba be nae.","poem":2},{"text":"Be-sibad-burwigan masgi-omanae,","poem":1},{"text":"dule-sibad-edarbemalad-e-dordoneg-dikarba be omanae.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Be, an-ome-nue-sabesailadid.","poem":1},{"text":"Bee be Faraón-ur-ebipimalad-moli-omegan-nuegan-yeerdaklegedyob be gued.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ibiyob be-wagar yeerdaklege,","poem":1},{"text":"be-wagar oluamar-abargi yeer dakleged.","poem":2},{"text":"Ibiyob be-dukar yeerdaklege,","poem":1},{"text":"wingwamar-naid-abargi yeer be-dukar dakleged.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Anmar bega oluamar-olobiid soboed,","poem":1},{"text":"oluamargi manimar-nanai bega imakoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Rey e-megedgi yollekwaa megisale,","poem":1},{"text":"an-ina-wawad, wawadik-oburmakdedaed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"An-sui, ina-wawadikid binasgargi-atinnar-sagu-bipigi-seledidaedyob, anba gabdiid.","poem":1}]},{"type":"verse","number":14,"content":[{"text":"An-sui, Engadiʼye-neg-nugadgi dutu-nuegan-nigwichiyob, anga gued.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"An-ome-nue-sabesailad, ¡ibiyob be yeer daklege!","poem":1},{"text":"¡Doggus nued be dakleged!","poem":2},{"lineBreak":true},{"text":"¡Be-ibyamar, nuumaryobi gued!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"¡An-sui-nue-sabesailad! ¡Ar ibiyob be yeer daklege!","poem":1},{"text":"¡Machered-nued be daed!","poem":2},"Sui-nue-sabgulediid namaked",{"text":"Gaganmar-aramakmamaidi anmar-gabedga guoed,","poem":1}]},{"type":"verse","number":17,"content":[{"text":"anmar-neg-nagubirmar urwarmar mamaid,","poem":2},{"lineBreak":true},{"text":"anmar-neg-uas ciprés-e-urgomar mamaid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}