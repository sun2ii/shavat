{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"SNG","translationId":"cuk_nvs","name":"Cantares","commonName":"Cantares","title":"NAMAKLEGED-BIRIGINED-GARDA CANTARES","order":22,"numberOfChapters":8,"sha256":"ae5115ab44a49b6e31cbb0886a0ea20032ed7a6bc15da051a0df44f76180b151","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cuk_nvs/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Sarón-neba-naidgi dutu-gwichidyob an gued.","poem":1},{"text":"Nebagi dutu-lirio-digar-gwichidyob an gued.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"An-ome-nue-sabesailad, ikoganba dutu-lirio-gwichiyobi,","poem":1},{"text":"omegan-abalagi gudiid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"An-sui-nue-sabesailad sapimar-abalagi manzana-sapi-gwichiyobi, sapingan-abalagi gudiid.","poem":1},{"text":"A-sapi-urba-sigedi yeer an itodaed,","poem":2},{"lineBreak":true},{"text":"e-sana, yeer gulledaed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"An-sui, yeer-masgullegedse an-semai gusad,","poem":1},{"text":"agi e-sabed anga nue-oyosad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Uva-odinnolegaledgi an-niga be ogannomala,","poem":1},{"text":"manzanaʼgi an-niga be ogannomala,","poem":2},{"lineBreak":true},{"text":"sui-abegedbina an nue-soged.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bitigi, e-sakwa-sapiled an-nono-urba mesisana gadin.","poem":1},{"text":"Bitigi, e-sakwa-nueddi angaagwar an-imakena gadin.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Omegan-Jerusalénʼginmalad, goe-sapurbarmalad-nukad an bemarga ise-wilegagwar soged,","poem":1},{"text":"melle be an-ome-nue-sabesailad an-ibe odakmalo,","poem":2},{"lineBreak":true},{"text":"melle be ese gormalo, na atakbiedba atakdagoed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"¡An-sui-nue-sabesailad-e-gaya gordani an itoged!","poem":1},{"text":"¡Be dakmala! ¡Wegi danikid be dakmala!","poem":2},{"text":"Yalaganba ichomakdanikid,","poem":1},{"text":"yar-mulluganba icho-icho danikid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"An-sui-nue-sabesailad goe-sapuryob daed.","poem":1},{"text":"An-sui-nue-sabesailad goe-sapur-senigwadyob gued.","poem":2},{"text":"Be dakmalana, anmar-galu-naba gwichid, galu-imbaba atakgwichid,","poem":1},{"text":"arbakee yawagak-senigwad-ollo-ollogwadba an-dakgwichid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"An-sui-nue-sabesailad anga sunmaksad.","poem":1},{"text":"Weyob anga sogded:","poem":2},{"text":"“An-ome-nue-sabesailad, be gwisguye.","poem":1},{"text":"¡Ome-yeerdakleged, be anba dagye!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Be dakena, dii-wied-ibagan bato nasye,","poem":1},{"text":"dii-wied bato bergusye.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dutumar bato sapurba ainiarye.","poem":1},{"text":"Namakleged-ibagan noniye.","poem":2},{"lineBreak":true},{"text":"Suirgwamar-namakmalad, bela anmar-yargi itoleye.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Higuera-sapi bato sanmakdeeye,","poem":1},{"text":"uva-dub durbamakgwisye, e-dutumar bato oyapachaye.","poem":2},{"text":"¡An-ome-nue-sabesailad, be gwisguye.","poem":1},{"text":"Ome-yeerdakleged, be anba dagye!”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Igi nuu akwa-imbaba, degi, yar-imbaba yaa-olloganagi dukue,","poem":1},{"text":"melle be deyob an-idu dukue.","poem":2},{"text":"Be-wagar anga be oyoge,","poem":1},{"text":"be-sunmaked-itogega be an-imake.","poem":2},{"text":"Ar be-gayaburba yeer itoledaed,","poem":1},{"text":"be-wagar yeer daklebalid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Achu-asdubingiidmar anmarga be gamala.","poem":1},{"text":"We-achu-senigana nainu-oichoged gudimalad.","poem":2},{"lineBreak":true},{"text":"Ar anmar-ibe uva-dubmar-durbamakgwismalad wiogedid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"An-sui-nue-sabesailad angadid, an egadmogad.","poem":1},{"text":"Dutumar-imbagi sibadmar-akwedii daed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"An-sui-nue-sabesailad, dad-argwaned-iduale,","poem":1},{"text":"negsichilealile, anse be dage.","poem":2},{"text":"Goe-sapurbalidyobi be abarmakdage,","poem":1},{"text":"yar-Beterʼye-nugad-yalaganba be abarmakdage.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}