{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"SNG","translationId":"cuk_nvs","name":"Cantares","commonName":"Cantares","title":"NAMAKLEGED-BIRIGINED-GARDA CANTARES","order":22,"numberOfChapters":8,"sha256":"ae5115ab44a49b6e31cbb0886a0ea20032ed7a6bc15da051a0df44f76180b151","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cuk_nvs/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"heading","content":["Ome e-sui-aminaded"]},{"type":"verse","number":1,"content":[{"text":"Mutik-gabmaidgine, an-sui an amialid,","poem":1},{"text":"an-sui-na-nue-sabesailad an amialid.","poem":2},{"text":"An-gabmaidgi an aminaigusanad,","poem":1},{"text":"an amissurgusad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Geb an gwisguded, neg-imbaba an aminadgusad.","poem":1},{"text":"Galimbaba an aminaded,","poem":2},{"lineBreak":true},{"text":"ibmar-uklebukwadgi an aminaded.","poem":2},{"text":"An-sui-nue-sabesailad an amidii gualid.","poem":1},{"text":"An amidigusanad, an amissurgusad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dule-nakulemalad galimbaba-bipirmakdimaladgi an-abingunonimalad.","poem":1},{"text":"Geb amarse an egisded: “¿An-sui-nue-sabesailad be daksasurmala?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"An a-dulemargi sikwas-aibategua, an-sui-nue-sabesailad an aminonikid.","poem":1},{"text":"Angaagwar an gasad, bar an indaksasulid.","poem":2},{"text":"Deyobi an-nan-negse an sesad,","poem":1},{"text":"an-gwalulesad-negse an sesad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Omegan-Jerusalénʼginmalad, goe-sapurbarmalad-nukad an bemarga ise-wilegagwar soged,","poem":1},{"text":"melle be an-ome-nue-sabesailad an-ibe odakmalo,","poem":2},{"lineBreak":true},{"text":"melle be ese gormalo, na atakbiedba atakdagoed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"¿We ibu waayobi neg-dulesulidganba ainakdani-daklege?","poem":1},{"text":"Ina-wawadikid-mirra-abargi danikid,","poem":2},{"text":"ina-wawadikid-incienso-abargi danikid,","poem":1},{"text":"dutumar-wawadik-yapanmalad-abargi danikid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"¡Be dakmala!","poem":1},{"text":"Salomón-e-moli-ur danikid.","poem":2},{"text":"E-yalabali sordamar-niga-gandikmalad e-dulapaa (60) danikid.","poem":1},{"text":"Israel-sordamar-niga-gandikmalad-abargi sulesmaladid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wemar bela es-suid-nikamaladbiid,","poem":1},{"text":"bilagi-urwemalagala odurdaklesmaladid.","poem":2},{"text":"Neg-mutikidba e-isdarmalad-ainiardaed-ular,","poem":1},{"text":"e-dikargi es-suid-nika-nika gudimalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Rey-Salomón e-sii-seleged-ulu sobsad,","poem":1},{"text":"Líbano-yargi sapimar-nuegan-gwismalad-e-urgogi sobsad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ulu-e-suarmar, manigi-sobsabalid,","poem":1},{"text":"e-bargamaladdi, orgi sobsabalid,","poem":2},{"text":"e-siged, mor-suir-akwagiidgi oginnar nasiksabalid.","poem":1},{"text":"Ulu-negyabali, ibmar-imaklesadi,","poem":2},{"text":"bunamala-Jerusalénʼginmalad imaksad,","poem":1},{"text":"ise-nudakar imaksamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"¡Omegan-Sión-yarginmalad, nodamala!","poem":1},{"text":"Rey-Salomón be dakdamala.","poem":2},{"text":"E-nan-ega-ologurgin-imaksad-yoi danikid.","poem":1},{"text":"Ome-nikued-ibagi-yosad-yoi danikid.","poem":2},{"lineBreak":true},{"text":"Wergued-dummad-itoged-ibagi-yosad-yoi danikid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}