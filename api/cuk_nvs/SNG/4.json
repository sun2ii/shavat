{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"SNG","translationId":"cuk_nvs","name":"Cantares","commonName":"Cantares","title":"NAMAKLEGED-BIRIGINED-GARDA CANTARES","order":22,"numberOfChapters":8,"sha256":"ae5115ab44a49b6e31cbb0886a0ea20032ed7a6bc15da051a0df44f76180b151","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cuk_nvs/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"heading","content":["Sui omebina-nue-soged"]},{"type":"verse","number":1,"content":[{"text":"Be an-ome-nue-sabesailad, ibiyob be yeer daklege,","poem":1},{"text":"doggus wilub-obicha be dakleged.","poem":2},{"text":"Be-ibyamar, be-muswe-batenaid-imbaba nuumaryobi, yeer dakleged.","poem":1},{"text":"Be-saila-batenaidi, sibadmar-Galaad-yargi danagwen ichomakar-aidedanidamaladyob, be-saila-batenaidi, yeer dakleged.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Be-nugarmar, sibad-wawaadmar, e-absar-siklesad-sorba, oglesadgi dagudik-nakwedanidamaladyob dakleged.","poem":1},{"text":"Degine, be-nugarmar, bela emaladbi daklebalid,","poem":2},{"text":"bela amba sogedba bubukwad.","poem":1},{"text":"Degidbali, yeer dakleged.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Be-gakuli-daklegedi, morgo-gisigwadyobi dakleged.","poem":1},{"text":"Be-sunmakedi, ibiyob yeer-itole an-imake.","poem":2},{"lineBreak":true},{"text":"Be-wagar, be-muswe-batenaid-imbagi mammi-gisigwadyobi yeerdakleged.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Be-dukar-daklegedi, David-e-neg-matusulidyobi yeer dakleged.","poem":1},{"text":"We-neg-matusulidi, akwamar-yamo-sobaledgi sobaled.","poem":2},{"text":"Be-dukargi, neg-matusulidgi miligwen-sigu-abgamalad-nanaiyob naid.","poem":1},{"text":"We-sigu-abgamalad, bila-onomalad-bulegangadid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Be-mam-abinbela-naidi, goe-sapurmar-emarbi-daklegedyob dakleged.","poem":1},{"text":"Goe-sapurmar dutumar-imbagi gagan-mananaidaeyobi, be-mam yeer dakleged.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dad-ibeler-nakwialile, negsichid miledele, ina-wawadikid-mirra-yarse an nakwenaoed,","poem":1},{"text":"ina-wawadikid-incienso-yar-mulluse an nakwenaoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Be an-ome-nue-sabesailad, nue be yeer dakleged.","poem":1},{"text":"Be swilimakar dakleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"An-ome, Líbano-yar-akar anba be dage,","poem":1},{"text":"Líbano-yargi-gudiidgi anba be dage,","poem":2},{"text":"Amana-yar-akar be aidedage,","poem":1},{"text":"Senir-yar-akar be aidedage,","poem":2},{"text":"Hermón-yargi be aidedage.","poem":1},{"text":"Achumigur-e-negmar-akar be aidedage,","poem":2},{"lineBreak":true},{"text":"achu-barbad-e-yarmar-akar be aidedage.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"An-ome-nue-sabesailad, gebe be an-daksagua, bela-belagwad be an-binsaed ganonikid.","poem":1},{"text":"Be-win-dukarba-naidgi an-edichayob be an-imaknonikid.","poem":2},{"lineBreak":true},{"text":"Agi an-gwage begadga gunonikid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"An-ome-nue-sabesailad, be-sabgued ibiyobi itolege.","poem":1},{"text":"Be-sabgued, vino-goblegedba bur bule yeer itoleged.","poem":2},{"text":"Be-ina-wawadikid-yapannedi, bela-ina-wawadikid-bamaladba","poem":1},{"text":"bur bule yeer yapanned.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"An-ome-nue-sabesailad. Be-gakuligi, acha-uugi achanis-aryomaiyob gued.","poem":1},{"text":"Be-gwabin-urba, nunis-aryomaiyobi gued,","poem":2},{"text":"egi achanis-aryomaiyobbalid.","poem":1},{"text":"Be-mormar-yapannedi Líbano-yar-yeer-yapannedyobi yapanned.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"An-ome-nue-sabesailad, be an-bun gued.","poem":1},{"text":"Dutugalu-emakar-naiyob be gued.","poem":2},{"lineBreak":true},{"text":"Dii-nued-aryomaid-emakar-naiyob be gued.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Be-nuu, nainu-nued-naidgi, manzanaʼmar digar-gwisnanaeyobi gued.","poem":1},{"text":"E-san-gullegedi yeer-gulle-nanaed.","poem":2},{"lineBreak":true},{"text":"Be-nuu nainugi, dutu-nardo, degi, dutu-azahar nigwis-nanaedyob gued.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Be-nuu nainugi ibmar-wawagana-nuegan,","poem":1},{"text":"akar-akar egi digar-bukwayob gued:","poem":2},{"lineBreak":true},{"text":"Egi dutu-nardo-digaleyob gued,","poem":2},{"lineBreak":true},{"text":"dutu-azafrán-digaleyob gued,","poem":2},{"lineBreak":true},{"text":"dutu-cálamo-digaleyob gued,","poem":2},{"lineBreak":true},{"text":"ina-canela-digaleyob gued,","poem":2},{"lineBreak":true},{"text":"ina-mirra-digaleyob gued,","poem":2},{"lineBreak":true},{"text":"ina-áloe-digaleyob gued,","poem":2},{"text":"degi, dutumar-baigan-nuegan-digaleyob, be-nuu gued.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Igi diwar nainu-oge, deyob be gued.","poem":1},{"text":"Dii-sukemakmaidi, Líbano-yar-akale aidedanidaeyobi, be gued.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Burwa-dad-nakwed-argan-sapiledsikid, be gordage.","poem":1},{"text":"Burwa-dad-nakwed-argan-nuedsikid, be dage.","poem":2},{"text":"An-dutugalugi be gordage.","poem":1},{"text":"E-wawadikid-oyapandagega be imakdage.","poem":2},{"text":"Be an-sui-nue-sabesailad, be-dutugaluse be dage.","poem":1},{"text":"E-sanmakgwichid-yeer-gulleged be gundage.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}