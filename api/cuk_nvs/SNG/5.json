{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"SNG","translationId":"cuk_nvs","name":"Cantares","commonName":"Cantares","title":"NAMAKLEGED-BIRIGINED-GARDA CANTARES","order":22,"numberOfChapters":8,"sha256":"ae5115ab44a49b6e31cbb0886a0ea20032ed7a6bc15da051a0df44f76180b151","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cuk_nvs/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Be, an-ome-nue-sabesailad, an-bunbalid.","poem":1},{"text":"An-dutugaluse an dogsad,","poem":2},{"text":"agi an-mirra-wawadikid an aminonikid,","poem":1},{"text":"agi an-ina-wawadikid an sunonikid.","poem":2},{"text":"Agi an-achanis an nue-masad,","poem":1},{"text":"agi an-achanis-e-uu an nue-guchabalid.","poem":2},{"text":"Agi vino an nue-gobsad,","poem":1},{"text":"nunis an nue-gobsabalid.","poem":2},"Bular-namakleged",{"text":"An-aimar, mas-nued be gunmala, gatik be gobmarbali,","poem":1},{"text":"immee gudii be imakmala.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"An gabmaidgine itoakwaa an gabmaid.","poem":1},{"text":"Agine, an-sui yawagakba gorgwichi an itoalid:","poem":2},{"text":"“An-ome, an-buna, nuu-yeerdaklegeyob be yeer dakleged.","poem":1},{"text":"¡Anga yawagak be egae!","poem":2},{"text":"Ar boo-batenaidba an-nono waradikgusad,","poem":1},{"text":"ar neg-mutikidba-boo-batenaidba, an-sailagia waradikgusad.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bato an mor esusad.","poem":1},{"text":"¿Gannar an mor yobarsunde?","poem":2},{"text":"Bato nag an enuksabalid.","poem":1},{"text":"¿Gannar an nag ollibi-gubarsunde?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"An-sui yawagakgi-yaa-ollo-siidgi e-argan odosad.","poem":1},{"text":"Deyob an daksagua, bela an-gwagese an-ebusad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"An-suiga an yawagak-egaegala, yog gwisguar an imaksad.","poem":1},{"text":"An-argangi mirra-wawadikid ariomaid,","poem":2},{"text":"an-goomar-imbaba bela ariomaid,","poem":1},{"text":"yawagak-eduedgi deemaknai gusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"An an-sui-nue-sabesailadga yawagak-egasgua, bar gwichisulid, an-idu naded.","poem":1},{"text":"An-idu-nadedbali, an naibi itononikid.","poem":2},{"text":"Aisaar an amisanad,","poem":1},{"text":"an amissurgusad.","poem":2},{"text":"An ese gornaigusbalinad,","poem":1},{"text":"an-abin-imaksasurbalid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Agine geb, dulemar-nakulemalad nakuledimargua, an-aminonimalad.","poem":1},{"text":"A-dulemala an-sarsononimalad, an-naibi-imaksamalad.","poem":2},{"lineBreak":true},{"text":"Dulemar-galugi-nakulebukwad, sabsur-an-ibe mor esusmalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Jerusalén-bunamala, ise-wilegagwar an bega sogmar.","poem":1},{"text":"Bemar an-sui-nue-sabesailad-abingualile, ega be sogmalo, sui-abegedba an uelledye.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Omegan-bamaladba-bur-yeerdakleged, be anmarga soge,","poem":1},{"text":"“¿ibugi be-macheredde, machergan-bamaladgi obinsunna?","poem":2},{"lineBreak":true},{"text":"¿Ibugi obinsunna, emide be weyob anmarse egisnaigu?”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"An-sui-nue-sabesailad, machered-nued dakleged,","poem":1},{"text":"e-uka sichisaar-daklebalid.","poem":2},{"lineBreak":true},{"text":"Dule-miliambegwad-abargi (10,000) magasar dakleged.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"An-sui-e-nono, or-nuedyob yeer dakleged.","poem":1},{"text":"E-sailagia, sinni-sinni nikad, sikwisichidyob sichii gued.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"E-ibyamar-gwabogwad-daklegedi, nuumar diwar-gakanaba-simalayob dakleged,","poem":1},{"text":"nunisgi-obsayob dakleged.","poem":2},{"lineBreak":true},{"text":"E-ibyamar innikimakar bukwad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"E-wagardi, wawadikid,","poem":1},{"text":"ina-wawadikid egi digar-naiyobid.","poem":2},{"text":"E-gakuli dutumar-daklegeyobid,","poem":1},{"text":"agi mirra-nis egi dedemaknaiyobid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"E-swidamardina, or-suarmar-daklegeyobid,","poem":1},{"text":"akwa-nuegan egi nanaiyobid.","poem":2},{"text":"Bela-e-abagan, elefante-nugar-daklegeyob, swilidikid dakleged.","poem":1},{"text":"Akwa-nuegan-zafiroʼye-nugad, bela egi ebiris naiyobid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"E-malimar-warbogwaddina, akwa-nued-mármol or-nued-sobaled-birgi-gwigwichidyob dakleged.","poem":1},{"text":"E-gwisgued, yeerdakle gwisgued,","poem":2},{"lineBreak":true},{"text":"Líbano-yargi-urwar-gwigwichidyob dakleged.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"E-gakulide, bela osidikid,","poem":1},{"text":"bela e-daklegedi, machered-nued itoged.","poem":2},{"lineBreak":true},{"text":"Jerusalén-bunamala, ar deyob an-sui dakleged,","poem":1},{"text":"ar deyob an-ai dakleged.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}