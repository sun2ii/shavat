{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"SNG","translationId":"cuk_nvs","name":"Cantares","commonName":"Cantares","title":"NAMAKLEGED-BIRIGINED-GARDA CANTARES","order":22,"numberOfChapters":8,"sha256":"ae5115ab44a49b6e31cbb0886a0ea20032ed7a6bc15da051a0df44f76180b151","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cuk_nvs/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"heading","content":["Na abebukmalad"]},{"type":"verse","number":1,"content":[{"text":"Omegan-bamaladba-bur-be-yeerdakleged, ¿bia be-sui-nue-sabesailad nade?","poem":1},{"text":"¿Bitisik nade?","poem":2},{"lineBreak":true},{"text":"Anmar beba bulakwaa aminaoe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"An-sui e-dutugaluse aidenaded,","poem":1},{"text":"ina-wawadikid-bukwadse naded,","poem":2},{"text":"dutumar-imbaba-garmakdii imaknaded,","poem":1},{"text":"dutumar-gwanega naded.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ani an, an-sui-nue-sabesailadgadid,","poem":1},{"text":"an-sui-nue-sabesailad, angadmogad.","poem":2},{"lineBreak":true},{"text":"Dutumar-imbaba na e-ibmar-durgan akwediid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Be, an-ome-nue-sabesailad.","poem":1},{"text":"Ar igi Tirsa-neggwebur yeer daklege,","poem":2},{"text":"igi Jerusalén-neggwebur yeer daklege,","poem":1},{"text":"igi niisgwamar-niba-nanaid geger daklege,","poem":2},{"lineBreak":true},{"text":"deyob be yeer dakleged.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mer bar be an-daknai gue,","poem":1},{"text":"ar be an-daksadbali, an bebina-sognonikid.","poem":2},{"text":"Be-saila-batenaidi, sibadmar-Galaad-yargi danagwen ichomakar-aidedanidamaladyob,","poem":1},{"text":"be-saila-batenaidi, yeer dakleged.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Be-nugarmar, sibad-wawaadmar, e-absar-siklesad-sorba, oglesadgi dagudik-nakwedanidamaladyob dakleged.","poem":1},{"text":"Degine, be-nugarmar, bela emaladbi daklebalid,","poem":2},{"text":"bela amba sogedba bubukwad.","poem":1},{"text":"Degidbali, yeer dakleged.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Be-wagar, be-muswe-batenaid-imbagi","poem":1},{"text":"mammi-gisigwadyobi yeerdakleged","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ar rey-omegan e-dulapaa (60) gued,","poem":1},{"text":"rey-omegan-dikarbarmalad e-dulabake (80) gubalid,","poem":2},{"lineBreak":true},{"text":"degi, yagana-bukidar gubalid,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"degi-inigwele, unnila wargwenna nuu-yeerdaklegedyobid angad gudiid.","poem":1},{"text":"E-nan, a-omegwa na nue sabedid, ega wargwenna guedid,","poem":2},{"text":"na we-napnegse odesadid,","poem":1},{"text":"a-bina bur gadi-sogedid.","poem":2},{"text":"Yagana, a-ome-dakarmale, egi ise-nued binsadamalad.","poem":1},{"text":"Rey-omegan, degi, e-omegan-dikarbarmalad, bunagwa-e-nug odummodamalad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"¿Ar we doawa, yeerdakleged?","poem":1},{"text":"Ar bolegoedba neg-ainakwiardaeyobi,","poem":2},{"text":"mutikidba nii-daarmakenaidaeyobi,","poem":1},{"text":"dad-ibeler daarmakenaidaeyobi,","poem":2},{"text":"niba niisgwamar gananaidaeyobi,","poem":1},{"text":"ber yeer dakleged.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sapimar-Nogalʼye-nugad-bukwadse an aidesad,","poem":1},{"text":"yar-imbagi dutumar-binigan-dakega an aidesad,","poem":2},{"text":"abakale, uva-e-muumar ainisale,","poem":1},{"text":"abakale, manzana-e-durbamar ainisale.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Degine, naded an itossulid,","poem":1},{"text":"an yeer-itogedbali, an-dummad-naba urgi-gwichi an itoalid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ome-Sulamʼgined, be dage, be dage.","poem":1},{"text":"Gannar be anmarse dage,","poem":2},{"lineBreak":true},{"text":"anmar nue be-dakbied.","poem":2},"Ome-nue-sabgulediid namaked",{"text":"¿Ar Ibiga be an-dakbimala?","poem":1},{"text":"¿Ibiga bemar emar-abargi-dodonai be an-dakbimala?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}