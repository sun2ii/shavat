{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"SNG","translationId":"cuk_nvs","name":"Cantares","commonName":"Cantares","title":"NAMAKLEGED-BIRIGINED-GARDA CANTARES","order":22,"numberOfChapters":8,"sha256":"ae5115ab44a49b6e31cbb0886a0ea20032ed7a6bc15da051a0df44f76180b151","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cuk_nvs/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"An-yagwa-yeerdakleged, be-nag, nag-uka-yoid yeer dakleged.","poem":1},{"text":"Be-duawar-billikwaa-daklegedi, dule-or-sobed ormar-yeerdakleged-sobsayobi, yeer dakleged.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Be-simu-daklegedi, noga-dirbikwagwadgi, vino enamakarsiiyobi dakleged.","poem":1},{"text":"Be-saban-daklegedi, orosgi-dakleged-trigo-dunnumaksiidgi, dutumar ebiris-nanaiyobi, yeer dakleged.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Be-mam-abinbela-naidi, goe-sapurmar-emarbi-daklegeyobi, yeer dakleged.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"Be-dukar-daklegedi, neg-matusulid-elefante-nugargi-soblegaleyobi, yeer dakleged.","poem":2},{"text":"Be-ibyamar-daklegedi, Hesbón-neg-nugad-e-diamar, Bat-Rabim-e-yawagak-naba dakarmakbukwayobi, yeer dakleged.","poem":1},{"text":"Be-asu-daklegedi, Líbano-yargi neg-matusulid, Damasco-neggwebursik negadakegwichiyobi, yeer dakleged.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Be-nono-daklegedi, Carmelo-yar-magasar-daklesiyobi, yeer dakleged.","poem":1},{"text":"Be-sailagia-ilemakmaid, dub-suir-akwa-daklegeyob dakleged.","poem":2},{"lineBreak":true},{"text":"Be-sailabali, rey binsaed-galenai gusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"An-ome-nue-sabesailad, ibiyobi be yeerdaklege,","poem":1},{"text":"be-sabgued yeer an-imaked.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Be-daklegedi, ogobwar-innikimakar-gwichiyobi yeer dakleged.","poem":1},{"text":"Be-mam, ogobmar-naidyobi yeer dakleged.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Weyob an sogded:","poem":1},{"text":"“Ogobgi an nakwenaoe, e-san an gwannaoe.”","poem":2},{"text":"Be-mam, uva-duk-dukwen-naidyobid.","poem":1},{"text":"Be-gaya-yapannedi, manzana-yeer-yapannedyobid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Be-gaya-itolegedi, vino-nued goblegedyob itoleged.","poem":1},{"text":"Igi vino, binnasdikii gaya-yaba ariomaidae, bela gakuli waradik imake,","poem":2},{"text":"nugarse-bakale waradik naddae,","poem":1},{"text":"deyobi be-gaya itoleged.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani an, an-sui-nue-sabesailadgadid.","poem":1},{"text":"Nue-anbina-sogedbali, angi nue-wergudiid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"An-sui-nue-sabesailad, anba be dage,","poem":1},{"text":"sapurba anmar nae,","poem":2},{"lineBreak":true},{"text":"dutugan-imbaba oibodii anmar imaknae.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Neg-oibosale, anmar uva-nainuse naoed,","poem":1},{"text":"abakale, e-muumar ainisale,","poem":2},{"text":"abakale, e-dutumar-ainisale,","poem":1},{"text":"abakale sapi-granada-e-dutumar ainisale.","poem":2},{"lineBreak":true},{"text":"¡Agi an bega sabgued oyogoed!","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Gagan-mandrágora-e-san-yapanned bato magar itoleged.","poem":1},{"text":"Anmar-yawagak-nagaba bukidar akar-akar sapi-sanmar bubukwad.","poem":2},{"text":"An-ome-nue-sabesailad, sapi-sanmar-binigan an bega sabosad,","poem":1},{"text":"sapi-sanmar-dinnagana, an bega sabosbalid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}