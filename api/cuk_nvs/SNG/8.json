{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"SNG","translationId":"cuk_nvs","name":"Cantares","commonName":"Cantares","title":"NAMAKLEGED-BIRIGINED-GARDA CANTARES","order":22,"numberOfChapters":8,"sha256":"ae5115ab44a49b6e31cbb0886a0ea20032ed7a6bc15da051a0df44f76180b151","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cuk_nvs/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Be, an-sus-gargwenadina yeerbana,","poem":1},{"text":"an-nangi be nuugusmogana yeerbana.","poem":2},{"text":"Degina, igarba an be-abingunonikidgi an be-ibe wagar uoenad,","poem":1},{"text":"dule gwen anga akar sogosulinad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Argangi-gasa an be-imakoenad,","poem":1},{"text":"an-nan-negse an be-sedoenad,","poem":2},{"text":"agine, sabgued-igargi be an-odurdakoenad.","poem":1},{"text":"Vino-wawadikidgi be-ogobega an be-imakoenad,","poem":2},{"lineBreak":true},{"text":"an-nur-granada-nisgi an be-ogobbaloenad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bitigi, e-sakwa-sapiled an-nono-urba mesisana gadin.","poem":1},{"text":"Bitigi, e-sakwa-nueddi angaagwar an-imakena gadin.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Omegan-Jerusalénʼginmalad, an bemarga ise-wilegagwar soged:","poem":1},{"text":"“Melle be an-ome-nue-sabesailad an-ibe odakmalo,","poem":2},{"lineBreak":true},{"text":"Melle be ese gormalo, na atakbiedba atakdagoed.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"¿We doa negsulidganba e-sui-gukingi birikwaa-mai-akas nakwedaniki?","poem":1},"Sui-nue-sabgulediid namaked",{"text":"Manzana-sapi-urba, an be-odaksad.","poem":1},{"text":"A-sapi-urbali, be-nan nunmakedgi be-odenoniki gusad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Be-gwagegine an-sedii be gue.","poem":1},{"text":"Be-swidagine an-wilub narmakar be sedii imake.","poem":2},{"text":"Ar sabgued-e-ganguedi burgwed-igaryobid, gege dule e-igar gaed.","poem":1},{"text":"Suibina-soglegedi, sulibinsa emar-imaked.","poem":2},{"text":"Sabgued-itolegedi, soo-dummad-gwabunyemaiyob itoleged.","poem":1},{"text":"Bab-Dummad deyob imaksad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"We-sabgued-sooyobidi, dii-dummadi gege oginned,","poem":1},{"text":"diwarmarbela gege we-sabgued obelobalid.","poem":2},{"text":"Dule-gwensak sabgued-bakega, bela e-ibmar-nikad ukdele,","poem":1},{"text":"we-dulegi dodoledoed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Anmar-bun senigwad,","poem":1},{"text":"amba yoo e-nuu mullugudaged.","poem":2},{"text":"Dule anmarse nikuega egisdanikile,","poem":1},{"text":"¿igi anmar abin sogosunna?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ar galu-matusulidyob-guena, anmar e-birgi nega-dummad-manibiid soboenad.","poem":1},{"text":"Ar yawagakga-guena anmar urwala-e-urgo egi nasikoenad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"An galu-matusulidyob gued,","poem":1},{"text":"ar an-mam, neg-suigan-warbo-gwichiyob gued.","poem":2},{"lineBreak":true},{"text":"Agala, an-sui-nue-sabesailadga, an gwage-bogidikid uked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Salomón, Baal-Hamón-yargi nainu-gwensak nikanad,","poem":1},{"text":"ega akwemalaga, dulemarga manigi-urmaksagusad.","poem":2},{"lineBreak":true},{"text":"E-nainu-sanmaksale, we-dulemar ega war-wargwen mani-sibu-milibo (2,000) senonidamalad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Salomón, mani-milibogwad be sue,","poem":1},{"text":"bemar-dule-nainu-akwemalad, mani-sibu-dulataled-ilabakegwad (400) be sumarmoga.","poem":2},{"lineBreak":true},{"text":"Ar an-nainudina, unnila angadid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Be, dutugalu-abargi gudiid,","poem":1},{"text":"anmar-aimar be-sunmaked itobigudimalad.","poem":2},{"lineBreak":true},{"text":"Be-gaya-itogega be anmar-imake.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"An-sui-nue-sabesailad, gwae be dage.","poem":1},{"text":"Goe-sapuryob be abarmakdage,","poem":2},{"lineBreak":true},{"text":"yalamar-wawadikid-yapanned-abargi gwae be abarmakdage.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}