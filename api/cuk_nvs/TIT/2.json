{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"TIT","translationId":"cuk_nvs","name":"Tito","commonName":"Tito","title":"TITOʼSE-NARMAKLESAD-GARDA TITO","order":56,"numberOfChapters":3,"sha256":"e91dcd2207281867047daad7f0c64ba02978f9492e0c66116698488fe7bc7e23","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/TIT/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cuk_nvs/TIT/3.json","totalNumberOfVerses":46},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Tito, ar bedi Jesús-Igar-nuegan-mamaidba be innikii sunmako."]},{"type":"verse","number":2,"content":["Dadormarga be sogo:",{"text":"Mer dogdar wilub-obichaa damaloye,","poem":2},{"lineBreak":true},{"text":"mer dodoakwaa damaloye,","poem":2},{"lineBreak":true},{"text":"nue-binsaed-nikaa damaloye,","poem":2},{"lineBreak":true},{"text":"Jesúsʼgi-nue-bensuli gumaloye,","poem":2},{"lineBreak":true},{"text":"nue sabgumaloye,","poem":2},{"lineBreak":true},{"text":"degine, mer ukurmakar ibmar abemaloye.","poem":2}]},{"type":"verse","number":3,"content":["Amba deyob mukwamarga be sogmogoed:",{"text":"E-daedgi Bab-Dummad-dobee nanamaloye,","poem":2},{"lineBreak":true},{"text":"mer dule-baigan-ogakansamaloye,","poem":2},{"lineBreak":true},{"text":"mer mumgudii nanamaloye,","poem":2},{"lineBreak":true},{"text":"ibmar-nueganginbi dulemar-baigan-odurdakdii nanamaloye.","poem":2}]},{"type":"verse","number":4,"content":["Deginbali, mukwamarga be sogbalo, omegan-odurdakbaloye:",{"text":"E-nusgana-sabguedgi,","poem":2},{"lineBreak":true},{"text":"e-suimar-sabguedgi,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"nue-binsaed-nikadaedgi,","poem":2},{"lineBreak":true},{"text":"san-swilidik-nanaedgi,","poem":2},{"lineBreak":true},{"text":"neg-nued-akwedgi,","poem":2},{"lineBreak":true},{"text":"nueddaedgi,","poem":2},{"lineBreak":true},{"text":"e-sui-urbaligwa-nanaedgi,","poem":2},{"text":"adi, dulemar mer Bab-Dummad-Gayaburbagi isdar sunmakmalagarye.","poem":3}]},{"type":"verse","number":6,"content":["Deginbali, sapingana be weyob unabalo:",{"text":"Nue-binsaed-nikaa damaloye.","poem":2}]},{"type":"verse","number":7,"content":["Tito, bedi be bela ibmar-nuegan-saedgi sapinganga be oyogoed, igi nanamalargebe.",{"text":"Ulubgi akar-binsasulidgi,","poem":2},{"lineBreak":true},{"text":"degi, sunmaked-napiragwadgi dodoakwaadasulidgi,","poem":2},{"text":"be sapingan-odurdakoed.","poem":3}]},{"type":"verse","number":8,"content":["Gaya-nuegangi be sunmakoed. We-gayagi dule geg akar soged. Weyob be odurdakele, be-isdarmalad be obingegsaoed. Ar ade, begi ibmar-isdarmalad geg soge-gumaloed."]},{"type":"verse","number":9,"content":["Maigan be weyob ounabalo:",{"text":"Be-dummagan-ibmar-sogedba be damarye,","poem":2},{"lineBreak":true},{"text":"bela yeer-itoged be imakye,","poem":2},{"lineBreak":true},{"text":"melle abin be sunmakmarye.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Degine, mer e-ibe be ibmar atursamaloye.","poem":2},{"lineBreak":true},{"text":"Na be oyoged imakmarye, bemar geg-dulemar-yardakmaladye,","poem":2},{"text":"adi, begi dakmalagar, Bab-Dummad-anmar-Abonoged-e-Igar, igar-nuedi.","poem":3}]},{"type":"verse","number":11,"content":["Bab-Dummad bela nabir dulemargi binsamaid. Ar Bab-Dummad nabir dulemargi binsaewilubsulinad. Emigindi, isguedgi bela dulemar-abonogega, e-nabir-binsaed bela dulemarga oyononikid."]},{"type":"verse","number":12,"content":["Bab-Dummad nabir-anmargi-binsaedba we-igarmargi anmar-odurdaknonikid:",{"text":"Bab-Dummadgi-binsasuli-nanaed-obaned,","poem":2},{"lineBreak":true},{"text":"ibmar-isganagi-binsaed-obaned.","poem":2},"Adi,",{"text":"weyobi anmar we-napneg-naidgi nue-binsaed-nikaa nanaegar,","poem":2},{"lineBreak":true},{"text":"ibmar-innikigwadbi-imakdii guegar,","poem":2},{"lineBreak":true},{"text":"nue-Bab-Dummad-dobee-nanadii guegar.","poem":2}]},{"type":"verse","number":13,"content":["Emide anmar, bensulidgi anmar-Bab-Jesucristo-Abonoged-nuedid e-gangued-yeerdaklegedgi-gannar-danikoed edarbedimarsunnad."]},{"type":"verse","number":14,"content":["We-Jesucristoʼde isguedgi anmar-onogegala, anmar-anar na san-burba uksagusad, anmar-anar burgwisad. Adi, bela anmar-isgudiid eliega, egadga anmar-imakega swilidik anmar-imaksad. Adi, anmar ibmar-nueganbi imakdii guegar."]},{"type":"verse","number":15,"content":["Tito, weyob bega ibmar-soglesadba be sunmako, be dule-unao, gandikidba weyob be ibmar sogo. Mer dulemar ibgwensur-be-daked be imako."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/TIT/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/TIT/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/TIT/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}