{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ZEC","translationId":"cuk_nvs","name":"Zacarías","commonName":"Zacarías","title":"ZACARÍAS-GARDA ZACARÍAS","order":38,"numberOfChapters":14,"sha256":"9033a04fa5c5f44c2711b7c2804d8537068023a5e44b2e22d3be7dba498adde4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cuk_nvs/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Bab-Jehováʼse dad-dummad-ganaidgi dii-wied be egismala.","poem":1},{"text":"Ar Bab-Jehová mar-golega imakedid, na e dii-owimaidid.","poem":2},{"lineBreak":true},{"text":"Bab-Jehová bela dulemargala, ibmar nabir-sanmakega imaked.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ibmar-bab-dummadyob-imaklemalad, dule-yardakmaladid.","poem":1},{"text":"Nergan gabgi-ibmar-gakanad dakmalad.","poem":2},{"text":"Gakansaar-negburgan-dakmaladgi sunmakmalad,","poem":1},{"text":"yamo-nabir-emar-obinsaega sunmakmalad.","poem":2},{"text":"Dulemar na e-idued-satesoggu,","poem":1},{"text":"ibdurgan-igarsuli-gudiidyobi, yogasaar gudimalad.","poem":2}]},{"type":"verse","number":3,"content":["A-ulale, Bab-Jehová sogded:",{"text":"“Dule-emar-idudimaladgi an nue-urwed,","poem":1},{"text":"we-dulemar, sibad-wawaad-macheredyob-gudidimaladi, an sabsur-odurdakoed.”","poem":2},{"text":"Napiragwa, Bab-Jehová-Bela-Gangued-Nikadi, Judá-dulemar-edarbed.","poem":1},{"text":"Ar Judá-dulemar e-sibad-wawaadyob gued.","poem":2},{"text":"Bab-Jehová moli-bulegan-bilagi-ebulemaladyobi,","poem":1},{"text":"Judá-dulemar-imakoed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Judá-dulemar-abargine, negsaila-gaed-akwadummad nodagoed,","poem":1},{"text":"neg-abgaed-suar nodagoed.","poem":2},{"text":"Bila-onogedgi warsib-ebuleged nodagoed,","poem":1},{"text":"bela dummagan-negsemaloed nodagoed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wemala, ollimar-nanaidgi bila-onomalad-bulegan-urwenanaidyob gumaloed,","poem":1},{"text":"moli-birgi-sii-urwemaladbogwa urwenai gumaloed.","poem":2},{"lineBreak":true},{"text":"Ar Bab-Jehová eba gudisoggu, a-dulemargi nakwemaloed.","poem":2}]},{"type":"verse","number":6,"content":["Bab-Jehová sogdebalid:",{"text":"“An Judá-dulemar ogannononikoed,","poem":1},{"text":"an José-e-wagan bendaknonikoed.","poem":2},{"text":"An wemar-wiledaked, degisoggu, gannar dagmalaga an imakoed,","poem":1},{"text":"gwen-mesagwar-anse-gussuliyob gunonimaloed.","poem":2},{"text":"Ar ani an e-Bab-Dummad-Jehová gued,","poem":1},{"text":"e-anse-goled, an itogoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Efraín-dulemar dule-bila-onogedyob gunonimaloed.","poem":1},{"text":"Igi-dule vino-gobsadba yeer-itodae,","poem":2},{"lineBreak":true},{"text":"deyobi, yeer itononimaloed.","poem":2},{"text":"E-mimmigan e-babgan-yeer-ito-dakarmalale, weligwar itodmarmogoed.","poem":1},{"text":"Bab-Jehová-ega-ibmar-imakoedba, yeer itononimaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”Ani an ese goloed,","poem":1},{"text":"ani an gannar danar oambikuoed.","poem":2},{"text":"An wemar-ollor-imaknonikile,","poem":1},{"text":"igi iduale dule-bukidar-gumalana,","poem":2},{"lineBreak":true},{"text":"deyobi, gannar gunonimaloed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"An wemar neggwebur-bamaladse oaisakis-inigwele, amba-dikasuli yar-baidgi mamai-inigwele, angi binsadii gumaloed.","poem":1},{"text":"A-neggweburmargi e-mimmiganmala gudigusmalan-inigwele, gannar e-yarse nonimaloed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Egipto-yargi-bukwa an sedagoed,","poem":1},{"text":"Asiria-yargi-bukwa an ninonikoed.","poem":2},{"text":"Galaad-yar-naidse, Líbano-yar-naidse, an sedoed.","poem":1},{"text":"Bela wemargala, yar unni-guosulid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bukib-itoged-abalagi, demar-obakmaloed,","poem":1},{"text":"degi-inigwele, ani an ega demar-bogidik imakoed,","poem":2},{"lineBreak":true},{"text":"Nilo-diwar-wilasailad an bela odinnogoed.","poem":2},{"text":"Asiria-dulemar na san-dummarba-imakdimalad an osulogoed,","poem":1},{"text":"Egipto-dulemar-negsemaid an obelobaloed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"An-sunnad an-dulamar an ogannogoed,","poem":1},{"text":"dobsuli an-nuggine nanamaloed.","poem":2},{"text":"Ani an Bab-Jehová deyob soged.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ZEC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ZEC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ZEC/9.json","previousChapterAudioLinks":{},"numberOfVerses":12}