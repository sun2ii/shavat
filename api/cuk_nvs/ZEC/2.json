{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ZEC","translationId":"cuk_nvs","name":"Zacarías","commonName":"Zacarías","title":"ZACARÍAS-GARDA ZACARÍAS","order":38,"numberOfChapters":14,"sha256":"9033a04fa5c5f44c2711b7c2804d8537068023a5e44b2e22d3be7dba498adde4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cuk_nvs/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":2,"content":[{"type":"heading","content":["Dule wilubsaed-dub ganikid"]},{"type":"verse","number":1,"content":["An niba atakdegua, dule-gwensak e-argangine wilubsaed-dub-ganiki an dakalid."]},{"type":"verse","number":2,"content":["An a-dulese egisded: “¿Bia be nae?” Geb an-abin-imaksad: “An Jerusalén-neggwebur wilubsasokalid. An wisgubied, bule sugudibe, degi, bule matardungubardibe.”"]},{"type":"verse","number":3,"content":["We-baliwitur-anbogwa-sunmaknaid bato nasokalidgine, baliwitur-baid ese nonikid,"]},{"type":"verse","number":4,"content":["ega sogded: “We-sapingwaga gwae ega be weyob sognae:",{"text":"‘Jerusalén-neggweburgi dule-bukidar ambikunonikoed,","poem":1},{"text":"moli-bukidar ambikunonikoed.","poem":2},{"text":"Jerusalén neggwebur-galu-matusulid-satedga gunonikoed.’","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"”Bab-Jehová soged: ‘Jerusalén-neggweburgala an soo-galu-matusulidyob ebiris gunonikoed.","poem":1},{"text":"An Jerusalén-neggweburga e-gangued-yeerdaklegedga gunonikoed.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"”Bab-Jehová weyob soged: ‘¡Be nomala! ¡Be wakinmala!","poem":1},{"text":"Yar-dad-nakwed-argan-sapiledsik-naidgi be nomala.’","poem":2},{"lineBreak":true},{"text":"”Bab-Jehová weyob soged: ‘Ani an bela-we-napneg-ugakaase,","poem":1},{"text":"bemar-oaisakiega imaksad.’","poem":2}]},{"type":"verse","number":7,"content":["”Bemar Sión-dulemar, Babilonia-yargi-gudimalad, egi be nomala, egi be wakinmala.”"]},{"type":"verse","number":8,"content":["Ar Bab-Jehová-Bela-Gangued-Nikad, dule-yar-baid-baidgi-bukmalad-bemar-ibe-ibmar-susmaladga, weyob gandikidba ibmar-sogega an-barmialid:",{"text":"“Dule-bamalad an-dulamar-naibi-imakele, an-naibi-imaknaimogad.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"A-ulale, an-sunnad, an we-dulemargi gwisgunonikoed,","poem":2},{"lineBreak":true},{"text":"e-maimar bela e-ibe ibmar atursanonimaloed.”","poem":2},"Weyobi wisgunonimaloed, Bab-Jehová-Bela-Gangued-Nikad an-barmiarye."]},{"type":"verse","number":10,"content":["Bab-Jehová weyob soged:",{"text":"“¡Sión-dulemar, weligwaledbali be gormakmala!","poem":1},{"text":"¡An bemar-abargi megnonikoed!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”A-ibagine, bukidar dule-yar-baid-baidgi-bukmalad anba nagumaloed.","poem":1},{"text":"A-dulemar-bukidarad an-dulamarga gunonimaloed,","poem":2},{"lineBreak":true},{"text":"a-dulemar-abargi an megnonikoed.”","poem":2},"Deyobi, wisgunonimaloed, Bab-Jehová-Bela-Gangued-Nikad bemarse an-barmiarye."]},{"type":"verse","number":12,"content":["Bab-Jehová yar-islidikid-naidgi Judá-yar na egadga imaknonikoed. Degine, Jerusalén-neggwebur gannar sunonibaloed."]},{"type":"verse","number":13,"content":["Bela-dulemar Bab-Jehová-asabin bogidik ambikumala, ar Bab-Jehová e-neg-islidikidgi-maid-akar bato danikid."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ZEC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ZEC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ZEC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}