{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ZEC","translationId":"cuk_nvs","name":"Zacarías","commonName":"Zacarías","title":"ZACARÍAS-GARDA ZACARÍAS","order":38,"numberOfChapters":14,"sha256":"9033a04fa5c5f44c2711b7c2804d8537068023a5e44b2e22d3be7dba498adde4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cuk_nvs/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":3,"content":[{"type":"heading","content":["Dule-irwa-Babse-gormalad-e-dummad-e-mor-swilidikid"]},{"type":"verse","number":1,"content":["Geb degine, Bab-Jehová anga negburganbali dule-irwa-Bab-Dummadse-gormalad-e-dummad-Josué oyosad. Josué, Bab-Jehová-e-baliwitur-asabin-gwichi an daksad. Degine, nia-saila Josuéʼgi-yolegega Josué-e-argan-nuedsik-gwichi an daksad."]},{"type":"verse","number":2,"content":["Geb agine, Bab-Jehová-e-baliwitur nia-saila-Satanásʼga sogded:",{"text":"“Satanás, Bab-Jehová bese sabsur-urwesun.","poem":1},{"text":"¡Bab-Jehová-Jerusalén-neggwebur-susad, bese sabsur-urwesun!","poem":2},{"text":"¡Nia-saila, Bab-Jehová bese sabsur-urwesun!","poem":1},{"text":"¡Satanás! Ar we-Josuéʼde, ¿sapan-gummakmai-sulesadyob bendaklessursi?”","poem":2}]},{"type":"verse","number":3,"content":["Josué baliwitur-asabin mor-ollibi-yoi-gwichi an daksad."]},{"type":"verse","number":4,"content":["Degisoggu, baliwitur dulemar-ega-ibmar-samalaga-guakwa-bukmaladga sogded: “Josué-mor-ollibi-yoid ega ungemar.” Geb Josuéʼgardi sogded: “Be dake, be-isgued an bega osulosad. Emigindi, mor-nuedi an bega yooed.”"]},{"type":"verse","number":5,"content":["Agine, baliwitur sogdebalid: “Josué-e-nonogine morgurgin-gutu-sated ega be sibali.” Bab-Jehová-e-baliwitur amba gwisgua, Josué-nonogi morgurgin-gutu-sated sismalad, mor-nued ega yosmarbalid."]},{"type":"verse","number":6,"content":["Geb sorbali, Bab-Jehová-e-baliwitur Josuéʼga weyobi sogded:"]},{"type":"verse","number":7,"content":["“Bab-Jehová-Bela-Gangued-Nikadi weyob sogye:",{"text":"‘Ar an-igar-maidba be nanadidibe, dule-irwa-anse-goled-ibmar-imaked be imakdidibe,","poem":1},{"text":"anse-goled-neg-seega an be-imakoed,","poem":2},{"text":"an-neg-imbamar-nanaid-dakega an be-imakbaloed.","poem":1},{"text":"We-dulemar-anga-ibmarsamalad-abargi, be anga-arbaega an be-imakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"” ’Dule-irwa-Babse-goled-bur-dummad-Josué, nue be itogo.","poem":1},{"text":"Be-sordagan-be-asabin-sigdimaladi, nue itomarmogo.","poem":2},{"text":"Ar bemar yoedse-ibmar-guoed-wilubga gumalad.","poem":1},{"text":"An-mai sapi-siklesad-gannar-ainieyobid an sedasokalid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Josué, an be-asabin akwa-sisad nue be dake.","poem":1},{"text":"We-akwa wagar-gwagugle (7) nikad.","poem":2},{"text":"An-sunnagwad an we-akwagi ibmar-soggwen narmakoed.","poem":1},{"lineBreak":true},{"text":"Ani Bab-Jehová-Bela-Gangued-Nikad soged,","poem":1},{"text":"We-yargi-bukmalad-e-isgued ibagwen-unni an elioed.’","poem":2}]},{"type":"verse","number":10,"content":["”Bab-Jehová-Bela-Gangued-Nikad soged: ‘A-ibagine, uva-dub-urba-ambikumalaga, degi, sapi-higueraʼye-nugad-urba-ambikumalaga, bemar na be muchub-muchub be-neg-dikarba-mamaidse gormaloed.’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ZEC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ZEC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ZEC/2.json","previousChapterAudioLinks":{},"numberOfVerses":10}