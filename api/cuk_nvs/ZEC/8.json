{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ZEC","translationId":"cuk_nvs","name":"Zacarías","commonName":"Zacarías","title":"ZACARÍAS-GARDA ZACARÍAS","order":38,"numberOfChapters":14,"sha256":"9033a04fa5c5f44c2711b7c2804d8537068023a5e44b2e22d3be7dba498adde4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cuk_nvs/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["Bab-Jehová-Bela-Gangued-Nikad-gayaburba anse nonibalid. Weyob anga sognonikid:"]},{"type":"verse","number":2,"content":["“Ani Bab-Jehová-Bela-Gangued-Nikad, weyob soged:",{"text":"Sión-dulemarbina an bela-bela nue soged.","poem":1},{"text":"An bela-bela nue-binasogedbali, an e-isdarmaladse sabsur-ulud gusad.”","poem":2}]},{"type":"verse","number":3,"content":["Bab-Jehová weyob soged:",{"text":"“An Sión-yarse gannar nonikoed,","poem":1},{"text":"an Jerusalén-neggweburgi megnonikoed.","poem":2},{"text":"Jerusalén-neggwebur Napiragwad-Neggweburye nuggunonikoed.","poem":1},{"text":"Bab-Jehová-Bela-Gangued-Nikad-e-yar Islidikid-Yarye nuggunonikoed.”","poem":2}]},{"type":"verse","number":4,"content":["Bab-Jehová-Bela-Gangued-Nikad weyob soged:",{"text":"“Dadgana, muugana, Jerusalén-e-igarbali gannar sigdii gumaloed.","poem":1},{"text":"Na seredgusmaladbali, e-gaapoled-sedii gumaloed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Masmala, bunamala, Jerusalén-igarganbali gannar dododii gumaloed.”","poem":1}]},{"type":"verse","number":6,"content":["Bab-Jehová-Bela-Gangued-Nikad weyob soged:",{"text":"“A-ibagan nonikile, dulemar-dula-napi-besmaladi, binsamaloed,","poem":1},{"text":"gwen deyob ibmar-gued daklesurye.","poem":2},{"text":"Ar angardina, ibmar-geg-gued nikasulid,","poem":1},{"text":"Ani Bab-Jehová-Bela-Gangued-Nikad deyob soged.”","poem":2}]},{"type":"verse","number":7,"content":["Bab-Jehová-Bela-Gangued-Nikad weyob soged:",{"text":"“An-dulamar-dad-nakwedsik-bukwamalad an bendakoed,","poem":1},{"text":"an-dulamar-dad-argwanedsik-bukwamalad an bendakbaloed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Jerusalén-neggweburgi-gudigumalaga, gannar dagmalaga an imakoed.","poem":1},{"text":"Wemar an-dulamarga gunonimaloed.","poem":2},{"text":"Ani an e-Bab-Dummadga gunonikoed,","poem":1},{"lineBreak":true},{"text":"e-Bab-Dummad-innikigwad,","poem":1},{"text":"e-Bab-Dummad-igar-innikigwad-imaked.”","poem":2}]},{"type":"verse","number":9,"content":["Bab-Jehová-Bela-Gangued-Nikad weyob soged:",{"text":"“Bemar, we-ibagangi, Bab-Dummad-gayaburba-barsogmalad e-ibmar-sogsad-itosmalad,","poem":1},{"text":"be niga-gandik imakmala.","poem":2},{"text":"Anse-goled-neg-soblesokargu,","poem":1},{"text":"akwa-gebesaila-silesad-akale, we-gayaburba be itosmalad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ar we-ibagan-iduale, dule-arbamalad gwen bennuklesurmalad,","poem":1},{"text":"ibdurganmala gwen-masgi ogullesurbalid.","poem":2},{"text":"Dule e-isdarmalad-ulale, aineba nadele, dobgunadapdaed.","poem":1},{"text":"Ar an bela dulemar, na dukin-dukin-urwemalaga imaksad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar epenne an igi-dulemar-napibesmalad-imaksagusa, bar an deyobi imakosulid.","poem":1},{"text":"Ani Bab-Dummad-Bela-Gangued-Nikad deyob soged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"”Neg-bogidikidgi be ibmar digmaloed,","poem":1},{"text":"uva-dubmar sanmakega guoed,","poem":2},{"text":"napamar ibmar-sanmaknai guoed,","poem":1},{"text":"nibnega e-boomar obadnai guoed.","poem":2},{"text":"We-neggweburgi-napibesmaladga,","poem":1},{"text":"bela we-ibmar egadga-guega an ukoed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Judá-dulemar, Israel-dulemar, mer dobgumalo,","poem":1},{"text":"gatik niga-ogannomalo.","poem":2},{"text":"Bemar, dule-yar-baid-baidgi-bukmalad-abargi, ibmar-isganayob ukabsales gusmalad.","poem":1},{"text":"Emigindi, an be-bendakmaloed,","poem":2},{"lineBreak":true},{"text":"ibnuedga be gunonimaloed.”","poem":2}]},{"type":"verse","number":14,"content":["Ar Bab-Jehová-Bela-Gangued-Nikad weyob soged:",{"text":"“Ar be-dadgan an-oulus-gusmargua, bar an wiledaksuli obelogedgi an binsasgusad.","poem":1},{"text":"Ani Bab-Jehová-Bela-Gangued-Nikad deyob soged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"”Emigindi, Jerusalén-dulemarga, Judá-dulemarga ibmar-nued-imakedgi an binsaed.","poem":1},{"text":"Degisoggu, ¡mer dobgumalo!","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"”Bemar we-ibmarmar imakergebed:","poem":1},{"text":"Napiragwadgi ibmar sogmalo.","poem":2},{"text":"Igar-nabolemalad-neggi, napiragwadgi, igar-inniki-maidba igar nabomalo.","poem":1},{"text":"Ar deyob imaklegedi, ¡neg-bogidikid nasiked!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Be-gwenadgangine, mer ichakwa be binsao,","poem":1},{"text":"mer gakansaale emargi be gwisguo.","poem":2},{"text":"Ar bela we-ibmarmar an isdardaked.","poem":1},{"text":"Ani Bab-Jehová deyob soged.”","poem":2}]},{"type":"verse","number":18,"content":["Bab-Jehová-Bela-Gangued-Nikad anga sogdebalid:"]},{"type":"verse","number":19,"content":["“Ani Bab-Jehová-Bela-Gangued-Nikad weyob soged:",{"text":"‘Judá-dulemargala nii-walabakedgi, nii-walataledgi, nii-walagugledgi (7), nii-warambedgi (10), mas-gunsuli-gudiguedi, weligwaledga, yeer-itolegedga guoed,","poem":1},{"text":"iba-dummad-weligwaledga guoed.","poem":2},{"text":"Degisoggu, neg-bogidikidbina be sogmar,","poem":1},{"text":"igar-napiragwadbina be sogmar.’ ”","poem":2}]},{"type":"verse","number":20,"content":["Bab-Jehová-Bela-Gangued-Nikad weyob soged:",{"text":"“Amba dulemar-yar-baidginmalad, dulemar-neggwebur-bamaladginmalad danimaloed.","poem":1}]},{"type":"verse","number":21,"content":[{"text":"We-dulemar neggwebur-baid-baid-onodii gumaloed.","poem":2},{"lineBreak":true},{"text":"Dulemar-a-neggweburgi-gudimaladga sogdimaloed:","poem":2},{"text":"‘¡Bab-Jehová anmargi nued-binsaega, anmar ese namarye!","poem":1},{"text":"¡Anmar Bab-Jehová-Bela-Gangued-Nikad amimarye!","poem":2},{"lineBreak":true},{"text":"¡Ar an Bab-Jehová-amimogoeddeeye!’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Bab-Jehová-Bela-Gangued-Nikad-amimalaga,","poem":1},{"text":"Bab-Jehová-egi-nued-binsaed-amimalaga,","poem":2},{"text":"Jerusalén-neggweburse, neggweburmar-bukidar,","poem":1},{"text":"neggweburmar-yar-baid-baidgi-dutusur-bukmaladi, nonimaloed.","poem":2}]},{"type":"verse","number":23,"content":["Bab-Jehová-Bela-Gangued-Nikad weyob soged: “A-ibagangine, dule-bukidara gwabinduku-akar-akar-sunmakmaladi, bela-dulemar-yar-baid-baidgi-bukwamaladi, Judío-dule-wargwen-e-mordukugi akanai gumaloed, ega weyob sogmaloed: ‘¡Anmar beba-naega be anmar-imake! ¡Ar anmar wisgusad, Bab-Dummad bemarba gudiiye!’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ZEC/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ZEC/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ZEC/7.json","previousChapterAudioLinks":{},"numberOfVerses":23}