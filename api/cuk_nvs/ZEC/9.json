{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ZEC","translationId":"cuk_nvs","name":"Zacarías","commonName":"Zacarías","title":"ZACARÍAS-GARDA ZACARÍAS","order":38,"numberOfChapters":14,"sha256":"9033a04fa5c5f44c2711b7c2804d8537068023a5e44b2e22d3be7dba498adde4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cuk_nvs/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":["Bab-Jehová we-gayaburba Hadrac-neggwebur-annik, degi, Damasco-neggweburnik sogsagusad. Bab-Jehová bela-dulemar-bukwadi dakmaid, degi, bela Israel-dulemar-danar-danar-bukwamalad dakmaibalid."]},{"type":"verse","number":2,"content":["Deginbali, Bab-Jehová Israel-dikarba-yar-naid Hamatʼye-nugad dakmaibalid. Bab-Jehová, neggwebur-nasgusbukmalad: Tiro, degi, Sidón, dakmaibalid."]},{"type":"verse","number":3,"content":[{"text":"Tiro-dulemar galu-matusulid-gandikmalad sobsad.","poem":1},{"text":"Ukub-mergueyob mani onmaksad.","poem":2},{"lineBreak":true},{"text":"Igarba olli-nanaiyob ormar onmaksad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Degi-inigwele, Bab-Jehová bela e-ibe ibmar sunonikoed,","poem":1},{"text":"bela e-ibe e-ibmar-nuegan demargi mioed.","poem":2},{"lineBreak":true},{"text":"Soogi bela e-neggwebur ogumakoed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ascalón-dulemar deyob-neg-guoedi dakmaloed, geb dobgudmaloed.","poem":1},{"text":"Gaza-dulemar, naibid-dummad itomaloed.","poem":2},{"text":"Ecrón-dulemar e-bendakleged-edarbediid-sate-dakarmalale, nunmaked-dummad itomarmogoed.","poem":1},{"text":"Gaza-dulemar, rey-sate gumaloed.","poem":2},{"text":"Ascalón-neggwebur dulemar-sate sigoed.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Asdod-neggweburgi dule-isganamar megnonikoed,","poem":2},{"text":"Filistea-dulemar-na-e-nug-dummarba-imakdiid, an obelogoed.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Filistea-dulemar ablisba-mesa-san-gunmaladi, an obelogoed.","poem":2},{"lineBreak":true},{"text":"Mas-ise-gulleged-gunmaladi, an obelogoed.","poem":2},{"text":"Filistea-dulemar-abar-bemaloedi, anmar-Bab-Dummadgadga gunonimarmogoed.","poem":1},{"text":"Amala, Judá-dulemar-e-dummaganga gunonimaloed.","poem":2},{"lineBreak":true},{"text":"Ecrón-dulemar, Jebuseo-dulemaryob gumaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mer dulemar anse-goled-neggi yogasaar dogsa-dogsa-gumalaga, an egi nakuledii guoed.","poem":1},{"text":"An-neggweburgi dule-emar-sabsur-imaked bar dognonikosulid,","poem":2},{"lineBreak":true},{"text":"ar an-sunnagwad an egi nakuledii guoed.","poem":2}]},{"type":"heading","content":["Sión-e-rey"]},{"type":"verse","number":9,"content":[{"text":"Sión-dulemar, ¡be nue-wergumala!","poem":1},{"lineBreak":true},{"text":"Jerusalén-dulemar, ¡weligwaledba be binnasur gormala!","poem":1},{"text":"¡Weligwaledba be gormakmala!","poem":2},{"text":"Be dake, be-rey bese danikid.","poem":1},{"text":"Be-rey, dule-innikigwadid, emar-abonogedid,","poem":2},{"lineBreak":true},{"text":"na san-dummarba imaksulidid.","poem":2},{"text":"Moli-uayasuid-bipigwad-birgi-sii danikid,","poem":1},{"text":"we-moli-bipigwad, moli-uayasuid-ome-e-mimmid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"We-rey, Efraín-e-moli-urmar-bila-onoged obelogoed,","poem":1},{"text":"Jerusalén-e-molimar obelogoed.","poem":2},{"text":"Warsib-bila-onoged bibisgoed,","poem":1},{"text":"bela dulemar-yar-baid-baidgi-bukmaladga, neg-bogidikidgi sunmaknonikoed.","poem":2},{"text":"We-rey, bela demar-nanaid-ugakaase neg-ganonikoed.","poem":1},{"text":"Éufrates-diwar-maid-akar, bela we-napneg-bergunaidse, neg-ganonikoed.","poem":2}]},{"type":"heading","content":["Israel-dulemar gannar bendaklenonikid"]},{"type":"verse","number":11,"content":[{"text":"“An bebo-ablisba-igar-mesisad-ulale, be-dulemar-dia-dummad-dinnagwadgi-galesbukwamaladi, an onogoed.","poem":1}]},{"type":"verse","number":12,"content":[{"text":"Dule-galesbukmalad-bendakleged-edarbebukmalad, gannar e-neg-gandikid-bukwadse dagmala.","poem":2},{"text":"Ar emi an bega soged,","poem":1},{"text":"bemar-wilesadbali, bur bule ilabo-wilub wergued an bemar-imakoed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"An-warsiyob an Judá-dulemar gachii gaoed,","poem":1},{"text":"an-siguyob an Efraín-dulemar imakoed.","poem":2},{"text":"Sión-yar, an be-mimmigan, Grecia-mimmigangi-yolegega an imakoed.","poem":1},{"text":"Bila-onogedgi-es-suid-ebulegeyob an be-imakoed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Bab-Jehová Grecia-dulemargi nonikoed.","poem":1},{"text":"E-sigu, mala-aidegeyobi miledoed.","poem":2},{"text":"Bab-Jehová-Bela-Gangued-Nikad gar-trompeta ogornonikoed,","poem":1},{"text":"dad-nakwed-argan-nuedsik-burwa-dummad-goled-abargi naoed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bab-Jehová-Bela-Gangued-Nikad na e-sordamar-bendaknonikoed.","poem":1},{"text":"E-sordamar, e-isdarmalad-e-gingimar bela obelogoed.","poem":2},{"text":"Vino-gobeyobi ablis gobmaloed","poem":1},{"text":"abali, mummu-gunanaiyobi, allenanaioed.","poem":2},{"text":"Igi ablis ibmar-ogumakar-ukleged-ailagi-eolegega nogmargi enoledae,","poem":1},{"text":"deyobi, ablisbi-moodo gudimaloed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"A-ibagine, e-Bab-Dummad-Jehová,","poem":1},{"text":"na e-sordamar sibad-wawaadyobi bendaknonikoed.","poem":2},{"text":"E-sordamar Bab-Jehová-e-yargine,","poem":1},{"text":"ologurgingi-akwa-nuegan-bukwadyob dakarmakdemaloed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ibiyobi bela we-ibmarmar, doggus-nued daklenonikoe.","poem":1},{"text":"Ibmar-gwag-gulleged sapingan-ogannogoed.","poem":2},{"lineBreak":true},{"text":"Vino-ochigwad, weligwar bunamala-imaknonikoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ZEC/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ZEC/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ZEC/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}