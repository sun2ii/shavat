{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ZEP","translationId":"cuk_nvs","name":"Sofonías","commonName":"Sofonías","title":"SOFONÍAS-GARDA SOFONÍAS","order":36,"numberOfChapters":3,"sha256":"91d1185d00bb5cc5042357b9a723a9ad19bffb80541a43bf32fb1ee4f3e815ef","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cuk_nvs/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["We, Bab-Jehová-e-gayaburbad. Amón-machi-Josías, Judá-yargi-reyga-maiunni, Bab-Jehová we-gayaburba Cusi-machi-Sofoníasʼga sognonigusad. Sofoníasʼde Gedalías-wagwad, Amarías-wagwa-yokorginedid, degi, Ezequías-wagwa-daksikidid."]},{"type":"heading","content":["Neg-bergued-danikoed iduakwaa owisolenaid"]},{"type":"verse","number":2,"content":["Bab-Jehová soged:",{"text":"“We-napneggi bela ibmar-bukwadi, an obelogoed.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Dulemar-bukwadi, ibdurgan-bukwadi, an obelogoed.","poem":2},{"text":"Sikwimar-gukudimaladi, uamar-gudimaladi, an obelogoed.","poem":1},{"text":"Bab-dummadyob-ibmar-imakledimalad, an obelogoed,","poem":2},{"text":"dule-isganamar, an obelogoed.","poem":1},{"text":"Dule-we-napneggi-gudiid, an obelogoed.”","poem":2},"Bab-Jehová deyob soged."]},{"type":"heading","content":["Judá-dulemar sabsur-odurdaklenonikoed"]},{"type":"verse","number":4,"content":["Bab-Jehová sogbalid:",{"text":"“Judá-yarginmalad an sabsur-odurdakoed,","poem":1},{"text":"bela Jerusalénʼgi-gudimalad an sabsur-odurdakoed.","poem":2},{"text":"Jerusalénʼgi ibmar-Baal-bab-dummadyob-imaklediidi, an bela obelogoed.","poem":1},{"text":"Dule-Baalʼga-arbadimalad-e-nug, an obelogoed.","poem":2},{"lineBreak":true},{"text":"Dule-irwa-Baalʼse-gormalad-e-nugse-bakale, an obelogoed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dulemar na e-neg-niba niisgwamar-nug-odummogega,","poem":1},{"text":"niisgwamar-asabin-sindigar-sigmalad, an obelogoed.","poem":2},{"text":"Dulemar, sindigar-sii an-nuggi ise-sogar-ibmar-sognaid,","poem":1},{"text":"degi, bab-Milcom ise-sogar-ibmar-sognaidamarbalid, an obelogoed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dulemar-angi-bangudmalad,","poem":1},{"text":"degi, an amisurmarbalid,","poem":2},{"lineBreak":true},{"text":"degi, anse idaksurmarbalid, an obelogoed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bab-Jehová-Bur-Gandik-Maid-asabin bogidik sigmalo,","poem":1},{"text":"ar Bab-Jehová-e-iba bato mosad.","poem":2},{"text":"Bab-Jehová ibmar-ogumakar-ukleged guakwaa urbisad,","poem":1},{"text":"ese-dagega-gorlesmaladi swilidik imaklesmalad.","poem":2}]},{"type":"verse","number":8,"content":["Bab-Jehová sogbalid:",{"text":"“Anga-ibmar-uklegoed-e-ibagi,","poem":1},{"lineBreak":true},{"text":"dule-dummaganga-mamaid, an sabsur-odurdakoed,","poem":1},{"text":"rey-masmala, an sabsur-odurdakoed.","poem":2},{"text":"Bela dulemar dule-ainebalidyob-mor-yomalad, an sabsur-odurdakoed.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"A-ibagine, anse-goled-neg-yawagak-dogedgi nag-obiar-dogmaladi, an sabsur-odurdakoed.","poem":2},{"text":"Dulemar, emar-sabsur-imakedba e-bab-dummagan-neg ibmar-enasii-imakdimalad, an sabsur-odurdakoed.","poem":1},{"text":"Emar-yardakedba e-bab-dummagan-neg ibmar-enasii-imakdimalad, an sabsur-odurdakoed.”","poem":2}]},{"type":"verse","number":10,"content":["Bab-Jehová weyob sogbalid:",{"text":"“A-ibagine, Yawagak-Uaye-nugad-akale, dule-e-bendakega binnasuli-gornanai-gumaloedi, itolegoed.","poem":1},{"text":"Neggwebur-binid-akale, dule-akiginmalad, itolegoed.","poem":2},{"lineBreak":true},{"text":"Yarmar-mullugan-akale, wile-itogedba-binnasur-oimakmaladi, itolegoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”Mactesʼginmalad, binnasur be gormakmarmoga.","poem":1},{"text":"Ar a-ibagine, dule-manigi-ibmar-ukmalad bergunonikoed.","poem":2},{"lineBreak":true},{"text":"Mani-muchub-ibmar-ogwamalad bela burgwemaloed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"A-ibagine, Jerusalén-neggweburgi gwallu-mee an imaknonikoed.","poem":1},{"text":"Dulemar-vino-sabolebukwadyob dobsuli-bukwamalad, an sabsur-odurdakoed.","poem":2},{"text":"We-dulemar binsamalad:","poem":1},{"lineBreak":true},{"text":"‘Bab-Jehová ibmar-nued imakosulid,","poem":1},{"text":"ibmar-isgana imakosurbalid.’","poem":2}]},{"type":"verse","number":13,"content":[{"text":"A-ulale, ibmar-nuegan bela e-ibe sulegoed,","poem":1},{"text":"e-negmar, bela swana naguoed.","poem":2},{"text":"Neg-sobnanai-gumaloenad,","poem":1},{"text":"degi-inigwele, egi gwen megosurmalad.","poem":2},{"text":"Uva-dub digmaloenad,","poem":1},{"text":"degi-inigwele, e-vinoʼdi gwen gobosurmalad.”","poem":2}]},{"type":"heading","content":["Bab-Jehová-e-urwed-dummad-iba"]},{"type":"verse","number":14,"content":[{"text":"“Bab-Jehová-e-urwed-dummad-iba bato walikgudanikid,","poem":1},{"text":"a-iba gwae-gwae modanikid.","poem":2},{"text":"Bab-Jehová-e-urwed-dummad-ibagine, sabsur-gormaknanai gumaloed.","poem":1},{"text":"Dule-buledse-bakale, binnasuli-gornai guoed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"A-iba, urwed-dummad-iba, naguoed.","poem":1},{"text":"Wile-itoged-iba, surbinsa-itoged-iba, naguoed.","poem":2},{"text":"Bela ibmar-bergued-iba, ibmar-bibisged-iba, naguoed.","poem":1},{"text":"Negsichid-nagued-iba, neg-gudureged-iba, naguoed.","poem":2},{"text":"Boo-bela-bela-babated-iba, mogirmar-sichigan-nagued-iba, naguoed.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Gar-trompeta-goled-iba, bila-onogega oimaknanaigumaloed-iba, naguoed.","poem":2},{"text":"A-ibagi, neggweburmar-sakdigar-bukwadgi-bila-ononaegala, igar uklegoed.","poem":1},{"text":"Negmar-matusur-gwigwichidgi-urwenamalaga, igar uklegoed.”","poem":2}]},{"type":"verse","number":17,"content":["Bab-Jehová soged:",{"text":"“Dulemar angi isgusmalad.","poem":1},{"text":"A-ulale, bela-bela-surbinsa-itogega an imakoed.","poem":2},{"lineBreak":true},{"text":"Ibyasuliyob gudii gumaloed.”","poem":2},{"lineBreak":true},{"text":"E-ablis ukubyob milemai guoed.","poem":1},{"text":"E-sanmar ibmar-isganayob milemamai guoed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bab-Jehová-urwed-ibagi,","poem":1},{"text":"e-mani gwen e-bendakosulid,","poem":2},{"lineBreak":true},{"text":"e-or gwen e-bendakosurbalid.","poem":2},{"text":"Bab-Jehová-e-sae-itogedbali, bela napneg-naid berguoed.","poem":1},{"text":"Bela-dulemar-napneggi-gudidimalad, ilagwen-obelolegar ese imaklemaloed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ZEP/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ZEP/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/HAB/3.json","previousChapterAudioLinks":{},"numberOfVerses":18}