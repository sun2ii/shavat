{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ZEP","translationId":"cuk_nvs","name":"Sofonías","commonName":"Sofonías","title":"SOFONÍAS-GARDA SOFONÍAS","order":36,"numberOfChapters":3,"sha256":"91d1185d00bb5cc5042357b9a723a9ad19bffb80541a43bf32fb1ee4f3e815ef","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cuk_nvs/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Geb ani an Sofonías sogded:",{"text":"“Dulemar-bingedsurmalad,","poem":1},{"text":"be bulakwaa ambikudamala,","poem":2},{"lineBreak":true},{"text":"Bab-Jehová-asabin na be san-bipii imakmala.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová-igi-neg-imakoye-sogsagusad-guoed-idu,","poem":1},{"lineBreak":true},{"text":"be deyob na be san-bipii imakmala.","poem":1},{"text":"A-iba, ar igi-gagan-dinnagana burwaba-seleder berguddae,","poem":2},{"lineBreak":true},{"text":"deyobi bergudoed.","poem":2},{"text":"Bab-Jehová-bela-bela-e-urwed bemargi-yoleged-idu,","poem":1},{"lineBreak":true},{"text":"be bulakwaa ambikudamala.","poem":1},{"text":"Bab-Jehová-e-urwed-iba bemargi-yoleged-idu,","poem":2},{"lineBreak":true},{"text":"Bab-Jehová-asabin na be san-bipii imakmala.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Napneggi bela na san-bipi-imakdimalad,","poem":1},{"lineBreak":true},{"text":"Bab-Jehová amimala.","poem":1},{"text":"Bab-Jehová-Igar-Maidba-gudidimalad,","poem":2},{"lineBreak":true},{"text":"Bab-Jehová amimala.","poem":2},{"text":"Igar-inniki-imaked be amimala, san-bipi-imaked be amimala,","poem":1},{"text":"abakalegi, Bab-Jehová-e-urwed-ibagi,","poem":2},{"lineBreak":true},{"text":"na be dukued amiarmalale.”","poem":2}]},{"type":"heading","content":["Filistea-dulemar sabsur-odurdaklegoed"]},{"type":"verse","number":4,"content":[{"text":"Gaza-neggwebur dule-sate guoed,","poem":1},{"text":"Ascalón-neggwebur napabi-nai guoed.","poem":2},{"text":"Asdod-neggweburgi-dulemar-bukwadi,","poem":1},{"lineBreak":true},{"text":"ibginedbali onilegoed.","poem":1},{"text":"Ecrón-neggwebur bela swiri naguoed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Demar-gakaba-bukwamalad-Cereteo-dorgan,","poem":1},{"text":"¡be duledar-wilesmar!","poem":2},{"text":"Filistea-dulemar-e-yar-Canaán,","poem":1},{"text":"Bab-Jehová weyob be-annik soged:","poem":2},{"lineBreak":true},{"text":"“An be-oberguoed,","poem":1},{"text":"begi dulemar bar gudii an imakosulid.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bela-demar-gakagi-neg-naidi gaganga binyoed.","poem":1},{"text":"Agi dulemar sibad-wawaad-akwedii gumaloed.","poem":2},{"lineBreak":true},{"text":"A-neg-naidi sibad-wawaadmar-bukuega naguoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"A-neg-naidi, Judá-dulemar-napi-besmaladgadga guoed,","poem":1},{"text":"agi e-sibad-wawaadmar gagan-madii guoed.","poem":2},{"text":"Mutikgusale, Ascalón-neggwebur-e-negmargi","poem":1},{"text":"gabnonimaloed.","poem":2},{"text":"E-Bab-Dummad-Jehová","poem":1},{"text":"amar-bendakega ese nonikoed.","poem":2},{"text":"E-dulemar-galesbukwad,","poem":1},{"text":"gannar e-yarse dagega imakoed.","poem":2}]},{"type":"heading","content":["Moab-dulemar, degi, Amón-dulemar sabsur-odurdaklegoed"]},{"type":"verse","number":8,"content":["Bab-Jehová soged:",{"text":"“Moab-dulemar an-dulamargi-isdar-sunmaknanaigusad an itosad.","poem":1},{"text":"Amón-dulemar an-dulamargi-dodonanaigusad an itosbalid.","poem":2},{"text":"We-dulemar, an-dulamar-nug oichosmalad,","poem":1},{"text":"an-dulamar-ibe e-yar-naid susmalad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"A-ulale, ani Israel-e-Bab-Dummad-Jehová-Bela-Gangued-Nikad soged:","poem":1},{"lineBreak":true},{"text":"An na dukin ise-sogar soged, Moab-yar,","poem":1},{"lineBreak":true},{"text":"Sodoma-yaryob gunonikoed,","poem":1},{"text":"Amón-dulemar, Gomorra-dulemaryob gunonimarmogoed.","poem":2},{"text":"E-napaneg ikobiin nagunonikoed, balu-negga gunonikoed,","poem":1},{"text":"degisadegu napabi-nai guoed.","poem":2},{"text":"An-dulamar-napi-besmaladi, a-dulemar-ibe ibmar sumaloed.","poem":1},{"text":"An-dulamar-dula-bemaloedi,","poem":2},{"lineBreak":true},{"text":"a-dulemar-napaneg egadga imaknonimaloed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Moab-dulemar, degi, Amón-dulemar,","poem":1},{"text":"na san-dummarba-imaksad-ulale, deyob gunonimaloed.","poem":2},{"text":"Bab-Jehová-Bela-Gangued-Nikad-e-dulamargi-isdar-sunmaksad-ular, deyob gunonimaloed.","poem":1},{"text":"Bab-Jehová-Bela-Gangued-Nikad-e-dulamar-isdar-daksad-ular, deyob gunonimaloed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Jehová, amar-sabsur-odurdakoed.","poem":1},{"text":"Bela napneggi ibmar-bab-dummadga-imakledimaladi, obelogoed.","poem":2},{"text":"Deyobi, bela dulemar-we-napneg-ugakaase-bukmaladi,","poem":1},{"text":"na e-yar-e-yargi Bab-Jehová-asabin sindigar sigmaloed.","poem":2}]},{"type":"heading","content":["Etiopía-dulemar sabsur-odurdaklegoed"]},{"type":"verse","number":12,"content":[{"text":"Bemar Etiopía-dulemar,","poem":1},{"text":"Bab-Jehová-e-es-suidse be oburgwilemarmogoed.","poem":2}]},{"type":"heading","content":["Asiria-dulemar sabsur-odurdaklegoed"]},{"type":"verse","number":13,"content":[{"text":"Bab-Jehová na e-argan dad-nakwed-argan-sapiledsik oyodoed,","poem":1},{"text":"Asiria-dulemar-obelogoed.","poem":2},{"text":"Napabi-swanga Nínive-neggwebur nasikoed,","poem":1},{"text":"nega-dulesulidgan-dinnagwadyob nasikoed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Agi sibad-wawaadmar obunnomamai guoed,","poem":1},{"text":"bela-ibdurgan-ursirmar egi gudii guoed.","poem":2},{"text":"E-buarmargi, mutikidbali","poem":1},{"text":"gorgimar, dabgalamar, gabdidii gumaloed.","poem":2},{"text":"Irmon yawagak-seniganaba gorsii guoed.","poem":1},{"text":"Sikwisichid yawagak-dogedgi gorsii guoed,","poem":2},{"lineBreak":true},{"text":"urwar nagubirga-mamaid magar-dakle megoed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Weyobi Nínive-neggwebur-na-gannarba-imakdiid,","poem":1},{"text":"na gwen-dulemar e-akar-imakosuli-itodiid, gunonikoed.","poem":2},{"text":"Na e-dulemar sogdimalad:","poem":1},{"text":"“Anmar-neggweburyobid, baid-neggwebur sate.”","poem":2},{"text":"Ibiyobi swanga nagunoniki,","poem":1},{"text":"ibdurgan-ursirmalad-e-galuga gunonikid.","poem":2},{"text":"Bela dulemar e-dikarba-nasmaloed,","poem":1},{"text":"egi dododmaloed, argan-olole egi oyonanai gumaloed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}