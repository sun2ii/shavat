{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ZEP","translationId":"cuk_nvs","name":"Sofonías","commonName":"Sofonías","title":"SOFONÍAS-GARDA SOFONÍAS","order":36,"numberOfChapters":3,"sha256":"91d1185d00bb5cc5042357b9a723a9ad19bffb80541a43bf32fb1ee4f3e815ef","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cuk_nvs/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["Jerusalén-e-isgusad"]},{"type":"verse","number":1,"content":[{"text":"Neggwebur-emar-sabsur-imaksiid,","poem":1},{"text":"uayasuli-siid, nue-isgussiid. ¡Be duledar-wiles!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Dule-ega-binsaed-daked itosulid,","poem":1},{"text":"nabir-gudiguega ega-ibmar-soged, abesulid.","poem":2},{"text":"We-dulemar Bab-Jehová-bened,","poem":1},{"text":"e-Bab-Dummad amisulid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"We-neggweburgi dule-dummagan-negsedimaladi,","poem":1},{"text":"achumigur-nono-wawaad-uurmakdiiyob gudimalad.","poem":2},{"text":"E-negsedimalad, igi achu-sapur-burburud mutikidba mas-gasale,","poem":1},{"text":"gwen banedga mas sabosuli, deyobi damalad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"E-Bab-Dummad-gayaburba-barsogmalad, na san-dummarba-imakmaladid,","poem":1},{"text":"emar-yardakmaladid.","poem":2},{"text":"E-dule-irwa-Bab-Dummadse-gormalad, neg-islidikidi oichodimalad.","poem":1},{"text":"Bab-Jehová-Igar-Mamaidgi annadimalad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dule, Bab-Jehová-e-dulamar-abargi-gudiiddi,","poem":1},{"text":"igar-inniki-imakedid, ibmar-isgana imaksulid.","poem":2},{"text":"Bane-bane wakudaryalaba e-igar-inniki-imaked imakdiid,","poem":1},{"text":"bangi-oibosale, geg imaksuli gued.","poem":2},{"lineBreak":true},{"text":"Dule-isganadina, gwen binged itosulid.","poem":2}]},{"type":"verse","number":6,"content":["Bab-Jehová soged:",{"text":"“Dule-yar-baid-baidgi-bukwamalad an obelosad,","poem":1},{"text":"e-neg-matusurmalad an earisad.","poem":2},{"text":"E-neg-imbamar dule-sate an imaksad,","poem":1},{"text":"gwen bar dulemar egi nanasulid.","poem":2},{"text":"E-neggweburmar napabi nagusad,","poem":1},{"text":"e-dulemar bela girgusad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"An binsanaigualid:","poem":1},{"text":"‘Jerusalén-dulemardi an-dobguoergebye,","poem":2},{"lineBreak":true},{"text":"anba ibsaoergebye.’","poem":2},{"text":"Adi, deyobi, an e-neg-bukwadse ataknadele,","poem":1},{"text":"e-negmar an oberguosurye.","poem":2},{"text":"Degi-inigwele, aka Jerusalén-dulemar bur","poem":1},{"text":"gwae-gwae ibmar-isgana-imakde gusmalad.”","poem":2}]},{"type":"verse","number":8,"content":["Agala, Bab-Jehová soged:",{"text":"“Degisoggu, an-bemargi-yolegega-danikoed-ibagi","poem":1},{"text":"be an-abitomalo.","poem":2},{"text":"Ar dule-yar-baid-baidgi-bukwamalad-onmakega an imaksokalid,","poem":1},{"text":"bela-neg-selemamaid-atoega an imaksokalid,","poem":2},{"text":"adi, an-bela-bela-sae-itogedgi wemar sabsur-odurdakega,","poem":1},{"text":"an-bela-bela-urwedgi wemar sabsur-odurdakegar.","poem":2},{"text":"An uludele, an sooyob gued,","poem":1},{"text":"anse bela napneg ogumaklegoed.","poem":2}]},{"type":"heading","content":["Dule-napi-besmalad"]},{"type":"verse","number":9,"content":[{"text":"”Bela Bab-Jehová-nug-odummomalaga,","poem":1},{"text":"bela bulakwaa Bab-Jehováʼga arbamalaga,","poem":2},{"lineBreak":true},{"text":"an dulemar-e-gwabinduku swilidik imakoed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Etiopía-diwarmargi dikasur-daksik-bukwamaladi,","poem":1},{"text":"an-nug-odummodimaladi, an-dulamar-aisakis-bukwamaladi,","poem":2},{"lineBreak":true},{"text":"anga ibmar-ukleged senonimaloed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"A-ibagine, be angi-yoledigusadgine,","poem":1},{"text":"bar be bingeguosulid.","poem":2},{"text":"Be-abargi dule-na-san-dummarba-imakdiid,","poem":1},{"text":"dule-na-nuga-nikadga-imakdiid, an obelogoed.","poem":2},{"text":"Deyobi, an-yar-islidikidgi,","poem":1},{"text":"bar na san-dummarba-imakdii guosulid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Be-abargi unnila dule-wileganabi,","poem":1},{"text":"dule-na-san-dummarba-imaksurmaladbi, an obegoed.","poem":2},{"text":"Wemar unnila Bab-Jehováʼgi","poem":1},{"text":"bensurgudii gumaloed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Israel-dulemar-napi-bemaloedi,","poem":1},{"lineBreak":true},{"text":"ibmar-isgana imakosurmalad,","poem":1},{"text":"bar gakansaosurmalad,","poem":2},{"lineBreak":true},{"text":"bar emar-yardakosurmarbalid.","poem":2},{"text":"Unnila nuedgi mas-gundii,","poem":1},{"text":"dobsulidgi obunnodii gumaloed.”","poem":2}]},{"type":"verse","number":14,"content":["Ani an Sofonías bega sogmalad:",{"text":"“Sión-dulemar, weligwar-itogedba be iseed gormala,","poem":1},{"text":"Israel-dulemar, nakwisadba be oimakmala.","poem":2},{"lineBreak":true},{"text":"Jerusalén-dulemar, gwage-ulubgi be yeer-itomala, be wergumala.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bab-Jehová bar sabsur be-imakosulid,","poem":1},{"text":"Bab-Jehová be-isdarmalad gannar sorsik-duurmakega imaksad.","poem":2},{"text":"Israel-e-rey-Bab-Jehová, bemar-abargi gudiid.","poem":1},{"text":"Bar be ibmar-isgana dobguosurmalad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"A-ibagine, Jerusalén-dulemarga sogdemaloed:","poem":1},{"text":"‘Sión-dulemar mer be dobgumarye, gandik-imakmarye.’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ar be-Bab-Dummad-Jehová bemar-abargi gudiid.","poem":1},{"text":"Ar Bab-Jehová dule-bila-onoged-nakwisad gued.","poem":2},{"text":"Ibamargineyobi, Bab-Jehová begi weligwar itogoed.","poem":1},{"text":"Gannaryobi e-sabgued bega oyogoed,","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"be-nuggine weligwaledba namakoed.”","poem":2},"Bab-Jehová soged:",{"text":"“Wile-itogedgi an be-ollor-imakoed,","poem":1},{"text":"ar we, bingedar-itoge be imaked.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"A-ibagine, an-sunnagwad","poem":1},{"text":"dule-mesagwar-be-imakdimalad an obelogoed.","poem":2},{"text":"Sibad-wawaad-yaku-yaku-nanaed an bendakoed.","poem":1},{"text":"Sibad-wawaad-yoggus-gudiid gannar an sedagoed.","poem":2},{"text":"Ibi-yarmargi be bingegudii gusmala,","poem":1},{"text":"agi an be-nug-odummomaloed,","poem":2},{"lineBreak":true},{"text":"agi nuga-nikamaladga an be-imakmaloed.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"A-ibagine, an bemar-senonikoed,","poem":1},{"text":"an bemar-onmaknonikoed.","poem":2},{"text":"An bemar-wagab,","poem":1},{"text":"be-dule-galesbukmalad an gannar senonikile,","poem":2},{"text":"bela dulemar-we-napneggi-bukwamalad-abargi,","poem":1},{"lineBreak":true},{"text":"an be-nug-odummomaloed.","poem":1},{"text":"Nuga-nikamaladga an be-imakmaloed.”","poem":2},"Bab-Jehová deyob soged."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}