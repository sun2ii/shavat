{"translation":{"id":"cuk_wb9","name":"Bab dummad Jesucristoba igar mesisad garda","website":"https://ebible.org/Scriptures/details.php?id=cuk09","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk09","licenseNotes":null,"shortName":"WB9","englishName":"San Blas Kuna NT 2009","language":"cuk","textDirection":"ltr","sha256":"fa4ffe175c4b6b4c83f72904dc8f75099bc785d202729871c923b483eb48d1fd","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_wb9/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7958,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"HEB","translationId":"cuk_wb9","name":"Hebreos","commonName":"Hebreos","title":"Hebreomarse Garda Narmaklesad Hebreos","order":58,"numberOfChapters":13,"sha256":"1196741ef99e984b0bb101e5a79de65ead5e8283e0f6531300206ed439a3fdbe","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_wb9/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/cuk_wb9/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Bab Dummad E-Machiba anmarga sunmaksad"]},{"type":"verse","number":1,"content":["Bab Dummad, dikasurgus na E-gaya-burba-berbemaladba anmar-babganga sunmakdanikid, akar-akargus sunmakdanibalid."]},{"type":"verse","number":2,"content":["Emiskwasaardi, na E-Machiba Bab Dummad anmarga sunmaksad. Bab Dummad bela ibmar na E-Machigadga guega imaksad, degine, na E-Machiba bela napneg-naid, degine, nibneg-naid nasiksabalid."]},{"type":"verse","number":3,"content":["Bab-Dummad-yeer-dakleged-gandik-gaedi, E-Machi deyob nikmogad, degine, bela Bab Dummadga guedi, E-Machi deyob gumogad. Degine, Bab-Dummad-Machi na e-gaya-burba-sunmaked gandik-nikadba, bela agi ibmar semaid. Bab-Dummad-Machi anmar-iskued anmarga uruknonigu, nibneggi Bab-Dummad-olo-gana argan-nuedsik sigdapsunnad."]},{"type":"heading","content":["Bab-Dummad-Machi angermarba bur dule-dummadid"]},{"type":"verse","number":4,"content":["Bab-Dummad-Machi angermarba bur dule-dummadga gunonikid, ar ade gusgu angermarba bur nug-dummarba nika danikid."]},{"type":"verse","number":5,"content":["Ar ade bipisaale Bab Dummad anger-wargwenga gwen weyob sogsasulid:",{"text":"Be an-machi,","poem":1},{"lineBreak":true},{"text":"emi-ibagi an be-babga gunonikid.","poem":1},"Sal. 2:7 Deginbali, Bab Dummad anger-wargwenaga gwen sogsasurbalid:",{"text":"Ani an e-babga guoed,","poem":1},{"lineBreak":true},{"text":"e, an-machiga gumogoed.","poem":1},"2 S. 7:14"]},{"type":"verse","number":6,"content":["Bab Dummad na E-Machi-wargwennaa-gued we-napnegse odenonigu, a-nikdi sogsa-gusad:",{"text":"Bela Bab-Dummad-angermar","poem":1},{"lineBreak":true},{"text":"igi Bab Dummadse gormala e-nug-odummogegar,","poem":1},{"lineBreak":true},{"text":"deyob we-dule-nug odummomarmosun.","poem":1},"Dt. 32:43"]},{"type":"verse","number":7,"content":["Angermargindi Bab Dummad sogsa-gusad:",{"text":"Bab Dummad na E-angermar burwayob imaked,","poem":1},{"lineBreak":true},{"text":"degine, e-maigandi","poem":1},{"lineBreak":true},{"text":"soo-gwabunye-gwichiyob imakbalid.","poem":1},"Sal. 104:4"]},{"type":"verse","number":8,"content":["Bab Dummad na E-Machi-nikdi soged:",{"text":"Bedi Baba, be-neg-dakmaid","poem":1},{"lineBreak":true},{"text":"degi-na-sadegu guoed.","poem":1},{"lineBreak":true},{"text":"Igar-napiragwadbarbi be neg-dakmaid.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Igar-inikigwad-bina bur be soged,","poem":1},{"lineBreak":true},{"text":"igar-iskanadi istar be daksad.","poem":1},{"lineBreak":true},{"text":"Degisoggu, Bab Dummad a-ular be-susad,","poem":1},{"lineBreak":true},{"text":"be-Bab-Dummad,","poem":1},{"lineBreak":true},{"text":"be-sordamarba dule-dummadga","poem":1},{"lineBreak":true},{"text":"be-nug-imaksad,","poem":1},{"lineBreak":true},{"text":"degine, weligwar itogega be-imaksabalid.","poem":1},"Sal. 45:6-7"]},{"type":"verse","number":10,"content":["Degine, Bab Dummad E-Machi-nik sogbalid:",{"text":"Be, Dule-Dummadid,","poem":1},{"lineBreak":true},{"text":"we-napneg-naid gebesailaunni be nasiksad.","poem":1},{"lineBreak":true},{"text":"Deginbali, nibneg-naid","poem":1},{"lineBreak":true},{"text":"be-argangi be nasiksabalid.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nibneg, degi, napneg, amardi berguoed,","poem":1},{"lineBreak":true},{"text":"bedi degi-sadeguoed.","poem":1},{"lineBreak":true},{"text":"Bela nibneg, degi, napnegdi sergudmaloed,","poem":1},{"lineBreak":true},{"text":"igi mormar sergud daedyob.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dule mor-nunud midedyob,","poem":1},{"lineBreak":true},{"text":"bedi we-napneg, degi, nibneg metoed.","poem":1},{"lineBreak":true},{"text":"Degine, dule mor-baid yoedyobi,","poem":1},{"lineBreak":true},{"text":"be we-napneg, degi, nibneg be ogwamogoed.","poem":1},{"lineBreak":true},{"text":"Ar bedi gwen gwagmaisulid,","poem":1},{"lineBreak":true},{"text":"Degine, be birgamardi gwen berguosulid.","poem":1},"Sal. 102:25-27"]},{"type":"verse","number":13,"content":["Ar bipisaale Bab Dummad anger-wargwenga gwen weyob sogsasulid:",{"text":"An argan-nuedsik be sige,","poem":1},{"lineBreak":true},{"text":"be-istarmaladgi bela egi be nakwedse an be-imakoed.","poem":1},"Sal. 110:1"]},{"type":"verse","number":14,"content":["Bela angermala Bab-Dummadga-arbamalad burbaled gumalad. Bab Dummad a-angermar-barmialid, adi dulemar-abonolemaloed-bendakega, aga barmilearmalad."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_wb9/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_wb9/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_wb9/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}