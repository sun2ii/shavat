{"translation":{"id":"cuk_wb9","name":"Bab dummad Jesucristoba igar mesisad garda","website":"https://ebible.org/Scriptures/details.php?id=cuk09","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk09","licenseNotes":null,"shortName":"WB9","englishName":"San Blas Kuna NT 2009","language":"cuk","textDirection":"ltr","sha256":"fa4ffe175c4b6b4c83f72904dc8f75099bc785d202729871c923b483eb48d1fd","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_wb9/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7958,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"REV","translationId":"cuk_wb9","name":"Burbar Oyolesad","commonName":"Burbar Oyolesad","title":"Ibmar-Guoed Juanse Burbar Oyolesad Apocalipsis","order":66,"numberOfChapters":22,"sha256":"4e55995a76947f34de7419ab28b7c7265e5bfa315b1ddb97d45e84460ee3dc49","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_wb9/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/cuk_wb9/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":18,"content":[{"type":"heading","content":["Babilonia-neggwebur bergusad"]},{"type":"verse","number":1,"content":["We-degi-gusad-sorbali anger-baid nibneggi aidedani an daksad, bela-gangued nika, degine, anger na e-gaed nikadba, napneg bela mee-gaded."]},{"type":"verse","number":2,"content":["Degine, a-anger binnasur goted, sogded:",{"text":"Babilonia-neggwebur-nue-nug-nikad bergudsunnad,","poem":1},{"lineBreak":true},{"text":"Babilonia bibichissunnad,","poem":1},{"lineBreak":true},{"text":"niamar-e-negga gunonisunnad,","poem":1},{"lineBreak":true},{"text":"degine, bela burba-iskanamar-negga gunonisunnad,","poem":1},{"lineBreak":true},{"text":"degine, sikwimar-iskana, sae-daklemalad-ambikued-negga gunonisunnad.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ar ade bela dulemar-yar-baid-baidgi-bukmalad","poem":1},{"lineBreak":true},{"text":"galagwensuli we-Babilonia-iskuedgi eba iskusmarmogad,","poem":1},{"lineBreak":true},{"text":"inna-gobsadgi mungusmaladyob,","poem":1},{"lineBreak":true},{"text":"degine, reymar-we-napnegginmalad a-omeba neg-sichigi nanadii-gusmalad,","poem":1},{"lineBreak":true},{"text":"degine, dulemar-we-napneggine-ibmar-ukedgine-arbadimaladi","poem":1},{"lineBreak":true},{"text":"mani-ibedga gusmalad","poem":1},{"lineBreak":true},{"text":"we-ome geg na san barga gudigusadgi.","poem":1}]},{"type":"verse","number":4,"content":["Geb degi nibneggi gaya-burba-baid gole an itosbalid, soge:",{"text":"Be an-dulemar,","poem":1},{"lineBreak":true},{"text":"we Babilonia-abargi-gudiid be noe,","poem":1},{"lineBreak":true},{"text":"adi we-iskudiidba mer be galegegar,","poem":1},{"lineBreak":true},{"text":"degine, we-bonimarba mer eba be wilemogagar.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ar Babilonia-dorgan-iskudimaladi","poem":1},{"lineBreak":true},{"text":"ar e-iskued dummarbasoggu,","poem":1},{"lineBreak":true},{"text":"e-iskued nibnegse warmaksad,","poem":1},{"lineBreak":true},{"text":"degine, Bab Dummad we-iskued gwen iessulid, bela ebinsasad.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Igi Babilonia-dorgan dulemar-baigan-imaksa","poem":1},{"lineBreak":true},{"text":"deyob ega be imakmo,","poem":1},{"lineBreak":true},{"text":"degine, na ibmar-imaksad, a-ilabo-wilub be-bennuke.","poem":1},{"lineBreak":true},{"text":"Gobed-noggi aimar-ogobsad,","poem":1},{"lineBreak":true},{"text":"a-ilabo-wilub a-gobed ega be ukmo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Na dukin na e-nug ogannodii-gusad,","poem":1},{"lineBreak":true},{"text":"na yeer itodii-gusad,","poem":1},{"lineBreak":true},{"text":"ayob gangu be odurdakmoga,","poem":1},{"lineBreak":true},{"text":"deyob be-obomosun.","poem":1},{"lineBreak":true},{"text":"Ar ade Babilonia na e-gwagegi soged:","poem":1},{"lineBreak":true},{"text":"“Ani an rey-omeyobi an siid,","poem":1},{"lineBreak":true},{"text":"ani sui-burgwis-sulid,","poem":1},{"lineBreak":true},{"text":"degine, gwen an boosulid.”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Degisoggu, unnila ibagwen-abalakwa","poem":1},{"lineBreak":true},{"text":"e-bonigan egi yolenonikoed:","poem":1},{"lineBreak":true},{"text":"Burgwed, boed, ukumesed,","poem":1},{"lineBreak":true},{"text":"degine, soogi gummakoed,","poem":1},{"lineBreak":true},{"text":"ar ade Bab-Dummad-Igar-Naboged, Dummadid,","poem":1},{"lineBreak":true},{"text":"bela-bela gangued nikad.","poem":1}]},{"type":"verse","number":9,"content":["Degine, we-napneggi-reyga-mamaid we-omeba galagwensuli neg-sichigi nanadigusad, we-omeba yeer-itodigusad, bomaloed, we-omeba wile-itomaloed, Babilonia-neg-gummakmaidba waa bupurmakmai dakarmalar."]},{"type":"verse","number":10,"content":["Reymar Babilonia-e-naibigunaid dobed-ular dikasur gwisgumaloed, sogdamaloed:",{"text":"“Babilonia-neggwebur-nue-nug-nikad,","poem":1},{"lineBreak":true},{"text":"neggwebur-dutusulinad, nue be wiles,","poem":1},{"lineBreak":true},{"text":"unnila wachi-irgwengi bato be-odurdaked nonikid.”","poem":1}]},{"type":"verse","number":11,"content":["Degine, dulemar we-napneggi-ibmar-ukedgi-mani-onomalad nue bomalad, degine, nue bukib binsamalad, ar ade bar ese ibmar bakosurmalad:"]},{"type":"verse","number":12,"content":["Olo, mani, akwa-nuegan, morbeb-akwagiid, mola-nuegan, mola-suir-akwagiid, mola-ceda-nugad, mormar-ginnid, bela suarmar-wawadik-yapanmalad, bela ibmar-marfilgi-sobarmalad, bela suar-walagan-nuegan, esnon, eskoro, degine, akwa-swilidikmalad;"]},{"type":"verse","number":13,"content":["Degine, canela, inamar-wawaad, ibmar-wawaad-incienso, mirra, dii-wawaad, vino, olivo-gwallu, madubur-nued, madubur-gwagwaled, ibdula-unimalad, sibad-wawaad, molimar, degine, moli-urmar, maiga-gudimalad, degine, dulemar e-san-burba-ugakse ukledimalad."]},{"type":"verse","number":14,"content":["Dulemar-ibmar-ukedgi-mani-onomalad we-Babilonia-neggweburga sogdamaloed: “Ibmar-nuegan-na-gi-be-yeer-itodigusad begi bangussun, ibmar nue-nika, degine, yeer-dakleged be nika-gusad bei bergussun, bar be gwen dakosulid.”"]},{"type":"verse","number":15,"content":["We-dulemar-ibmar-ukedgi-mani-onodigusmalad, we-ibmar-ukedgi mani-ibedga gusmalad, we-Babilonia-neggwebur odurdaklenaid dobed-ular, bannabaa gwisgumaloed, bobukwa, degi, bukib-binsabukwa ega gumaloed,"]},{"type":"verse","number":16,"content":["sogbukwa-gumaloed:",{"text":"We-neggwebur nue-nug-nikadgi dulemar-bukwad,","poem":1},{"lineBreak":true},{"text":"bela-bela nue-dummad wilemaloed.","poem":1},{"lineBreak":true},{"text":"We-dulemar mola-nued, mola-suir-akwagiid,","poem":1},{"lineBreak":true},{"text":"mola-ginnid yoi gusmalad.","poem":1},{"lineBreak":true},{"text":"Olo, akwa-nuegan,","poem":1},{"lineBreak":true},{"text":"degi, morbeb-akwagiid e-ogannodii-gusmalad.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ar unnila wachi-irgwengi","poem":1},{"lineBreak":true},{"text":"bela ibmar-gargemalad bato surkus-naded.","poem":1},"Degine, bela sour-onanamalad, urgi-nanamalad, ur-selagan, degine, bela demargi-mani-onomalad, Babiloniagi dikasur ambikusmalad."]},{"type":"verse","number":18,"content":["Degine, neggwebur-gummakmaid-e-waa dakarmargua, binnasur gotemalad, sogdemalad: “¿Ibi neggwebur weyob nue-nug-nika gusbalinsunna? Suli, we neggweburyobid sate.”"]},{"type":"verse","number":19,"content":["Degine, we-dulemar neg-gummakmaid-dakbukmalad na e-nonogi ukub mismalad, oyogegar, emarde nue-bukib-binsamarye. Wemar binnasur gotemalad, ise-boar, ise-bukib-binsaar sogdemalad:",{"text":"We-neggwebur-nue-nug-nikadgi-dulemar-bukwad","poem":1},{"lineBreak":true},{"text":"bela-bela nue-dummad wilemaloed.","poem":1},{"lineBreak":true},{"text":"Babilonia, be mani-nue-nikadba","poem":1},{"lineBreak":true},{"text":"bela dulemar-ur-demargi-nikamalad","poem":1},{"lineBreak":true},{"text":"mani-ibedga be imaksad.","poem":1},{"lineBreak":true},{"text":"¡Emigindi, unnila wachi-irgwengi","poem":1},{"lineBreak":true},{"text":"bela ibmar bato sate be gusmalad!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Emigindi bemar nibneggi-bukmalad,","poem":1},{"lineBreak":true},{"text":"bemar Jesucristogi-akananaimalad,","poem":1},{"lineBreak":true},{"text":"Bab-Jesús-nuggi-barmilearmalad,","poem":1},{"lineBreak":true},{"text":"degine, Bab-Dummad-gaya-burba-berbemalad,","poem":1},{"lineBreak":true},{"text":"bemar wergumarsun,","poem":1},{"lineBreak":true},{"text":"ar we-neggwebur bemar-imaksadyob","poem":1},{"lineBreak":true},{"text":"Bab Dummad we-neggwebur imaksamogad.","poem":1}]},{"type":"verse","number":21,"content":["Degine, anger-wargwen-dutusulid, akwa-dummad susad, aidir-akwa-dummadyobid, demarse meted, sogded:",{"text":"We-akwa binnasur melledeyobi","poem":1},{"lineBreak":true},{"text":"Babilonia-neggwebur-nue-nug-nikad berguoed.","poem":1},{"lineBreak":true},{"text":"We-neggwebur bar daklegosulid.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Gala-arpa-ogormalad,","poem":1},{"lineBreak":true},{"text":"gar-ogormalad, gammu-ogormalad,","poem":1},{"lineBreak":true},{"text":"gala-trompeta-ogormalad","poem":1},{"lineBreak":true},{"text":"Babilonia, begi bar gwen itolegosulid.","poem":1},{"lineBreak":true},{"text":"Degine, galagwensuli ibmargi-arbamalad","poem":1},{"lineBreak":true},{"text":"gwen bar daklegosurbalid,","poem":1},{"lineBreak":true},{"text":"degine aidir-akwa bar gornai gwen itolegosurbalid.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gwallumar bar begi gwen gaosulid,","poem":1},{"lineBreak":true},{"text":"dule-ome-nikunaid-e-sunmaked","poem":1},{"lineBreak":true},{"text":"degine, ome-sui-nikunaid-e-sunmaked","poem":1},{"lineBreak":true},{"text":"bar begi gwen itolegosulid.","poem":1},{"lineBreak":true},{"text":"Ar begi-mani-onomaladi,","poem":1},{"lineBreak":true},{"text":"amar we-napneggi dule-dummagan guenad,","poem":1},{"lineBreak":true},{"text":"ar be binsa dule yardakar-ibmar-saedba,","poem":1},{"lineBreak":true},{"text":"bela dulemar-yar-baid-baidgi-bukmalad bese yardaklesmalad.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Bab-Dummad-gaya-burba-berbemalad,","poem":1},{"lineBreak":true},{"text":"Jesucristogi-akananaimalad,","poem":1},{"lineBreak":true},{"text":"degine, bela dulemar-we-napneggi-oburgwilesmalad,","poem":1},{"lineBreak":true},{"text":"daklealid, be we-dulemar-oburgwemai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_wb9/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_wb9/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_wb9/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}