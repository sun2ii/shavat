{"translation":{"id":"cuk_wb9","name":"Bab dummad Jesucristoba igar mesisad garda","website":"https://ebible.org/Scriptures/details.php?id=cuk09","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk09","licenseNotes":null,"shortName":"WB9","englishName":"San Blas Kuna NT 2009","language":"cuk","textDirection":"ltr","sha256":"fa4ffe175c4b6b4c83f72904dc8f75099bc785d202729871c923b483eb48d1fd","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_wb9/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7958,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"REV","translationId":"cuk_wb9","name":"Burbar Oyolesad","commonName":"Burbar Oyolesad","title":"Ibmar-Guoed Juanse Burbar Oyolesad Apocalipsis","order":66,"numberOfChapters":22,"sha256":"4e55995a76947f34de7419ab28b7c7265e5bfa315b1ddb97d45e84460ee3dc49","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_wb9/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/cuk_wb9/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":7,"content":[{"type":"heading","content":["Israel-dulemar-144,000 wilubgan nasikaled"]},{"type":"verse","number":1,"content":["A-sorbali an daksad, angermar-walabake napneg-naid-sukun-sogabakegi gwichimar, burwa-sogabake gani-gwichimalad, adi melle napneggi, demargi, degi, sapimargi burwamar golegar."]},{"type":"verse","number":2,"content":["Degine, anger-baid an daksabalid, bia dad-ibeler-nakwiar-daedba nakwemai, Bab-Dummad-Dula-Maid-e-wilub-nasikleged sedani. A-anger, angermar-walabakegwadse binnasur goted, ar ade a-angermarga gangued uklesad, napneg ichoged, degi, demar ichoged."]},{"type":"verse","number":3,"content":["A-anger-wargwenad angermar-walabakegwadga sogded: “Melle napneg, demar, degi, sapimar be ichomargwer, bina anmar Bab-Dummadga-mailedimalad-e-bebegi Bab-Dummad-wilub bela nasiksadse.”"]},{"type":"verse","number":4,"content":["An itosad, Israel-dorgan sogambe-gakabogwad-dana-dana-bukwad mili-dulataled-ilagwen-gaka-dulabo-gakabake (144,000) e-wilubgan egi nasiklesad."]},{"type":"verse","number":5,"content":[{"text":"Judá-e-wagangi mili-ambe-gakabo wilubgan nasiklesad.","poem":1},{"lineBreak":true},{"text":"Rubén-e-wagangi mili-ambe-gakabo wilubgan nasiklesad.","poem":1},{"lineBreak":true},{"text":"Gad-e-wagangi mili-ambe-gakabo wilubgan nasiklesad.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aser-e-wagangi mili-ambe-gakabo wilubgan nasiklesad.","poem":1},{"lineBreak":true},{"text":"Neftalí-e-wagangi mili-ambe-gakabo wilubgan nasiklesad.","poem":1},{"lineBreak":true},{"text":"Manasés-e-wagangi mili-ambe-gakabo wilubgan nasiklesad.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Simeón-e-wagangi mili-ambe-gakabo wilubgan nasiklesad.","poem":1},{"lineBreak":true},{"text":"Leví-e-wagangi mili-ambe-gakabo wilubgan nasiklesad.","poem":1},{"lineBreak":true},{"text":"Isacar-e-wagangi mili-ambe-gakabo wilubgan nasiklesad.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Zabulón-e-wagangi mili-ambe-gakabo wilubgan nasiklesad.","poem":1},{"lineBreak":true},{"text":"José-e-wagangi mili-ambe-gakabo wilubgan nasiklesad.","poem":1},{"lineBreak":true},{"text":"Degine, Benjamín-e-wagangi mili-ambe-gakabo wilubgan nasiklesmogad.","poem":1}]},{"type":"heading","content":["Dulemar-bukidar mola-sibumar yoyoid"]},{"type":"verse","number":9,"content":["A-sorbali an dakded, dulemar bukidarsoggu, geg dule ebised, bela soga-ilaba dulemar-yar-baid-baidgi-bukmalad, bela soga-ilaba dulemar-abe-akar-akarmalad, bela soga-ilaba dulemar-baid-baid-danar-danar-bukmalad, degine, bela soga-ilaba dulemar-gaya-akar-akar-sunmakmalad, wemar olo-gana-asabin, degine, Sibad-Wawaad-Mimmi-asabin bukmalad, bela mola-sibu-yoyoi bukmalad, degine, e-argangine ogob-gagangiid-gagan gani bukmarbalid."]},{"type":"verse","number":10,"content":["Wemar binnasur gorbukmalad, sogbukmalad:",{"text":"We anmar-abonolegedi anmar-Bab-Dummad-olo-ganagi siidgi,","poem":1},{"lineBreak":true},{"text":"degine, Sibad-Wawaad-Mimmigi danikid.","poem":1}]},{"type":"verse","number":11,"content":["Angermar-belagwapa olo-gan-ebilis, girmar-selegan-ebilis, degine, ibdula-walabakegwad-ebilis gwichimalad. Amar Bab-Dummad-na-e-olo-ganagi-siid-asabin askun aimukudmalad, Bab Dummadse gotemalad, e-nug ogannodmalad,"]},{"type":"verse","number":12,"content":["sogdemalad:",{"text":"¡Ar deyobdo!","poem":1},{"lineBreak":true},{"text":"Bab Dummad, be gusgu degi-sadegu be-nug ogannolesun,","poem":1},{"lineBreak":true},{"text":"be yeer-dakle gusun,","poem":1},{"lineBreak":true},{"text":"be binsaed-nue-nikad degi-sadegu gusun,","poem":1},{"lineBreak":true},{"text":"begi dog-nuedye sogledii-gusun,","poem":1},{"lineBreak":true},{"text":"be nug-nued-nikad degi-sadegu-gusun,","poem":1},{"lineBreak":true},{"text":"be-gangued, degi be dutusulid degi-sadegu gusun.","poem":1},{"lineBreak":true},{"text":"Bab Dummad bela weyob gusgu degi-sadegu be gusun.","poem":1},{"lineBreak":true},{"text":"¡Ar deyobdo!","poem":1}]},{"type":"verse","number":13,"content":["Geb degi girmar-selegan-wargwen anse egichialid: “¿Wemar mola-sibu-yoyoimaladde, doamala? ¿Wemarde bia danimala?”"]},{"type":"verse","number":14,"content":["An ega sogded: “Dummad, be wisi, wemar doa-gumalad.” Geb degi anga sokar: “Wemar ise-nue-wilegagwar-gudigusmaladgi nosmalad-dulemalad. Wemar na-e-mor Sibad-Wawaad-Mimmi-e-abegi enuksamaladid, agi sibudik na e-mor imaksamalad-dulemalad."]},{"type":"verse","number":15,"content":[{"text":"A-ular wemar Bab-Dummad-olo-gan-asabin bukmalad,","poem":1},{"lineBreak":true},{"text":"mutikidba, degi, ibginedba","poem":1},{"lineBreak":true},{"text":"Bab-Dummad-maid-neggi ega ibmar-imaknaigu-gumalad.","poem":1},{"lineBreak":true},{"text":"Bab-Dummad-na-e-olo-ganagi-siid na e-sunnad a-dulemar edarboed.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A-dulemar bar ukud itogosurmalad,","poem":1},{"lineBreak":true},{"text":"degi, uku-ukud bar itogosurbalid.","poem":1},{"lineBreak":true},{"text":"Degine, dad-ibelergi bar gummakosurmalad,","poem":1},{"lineBreak":true},{"text":"degine, bar neg-diopisulid itogosurbalid.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ar ade Sibad-Wawaad-Mimmi olo-gan-abargi-siid amar-edarboed","poem":1},{"lineBreak":true},{"text":"igi sibad-wawaad-edarbe-damaladyob,","poem":1},{"lineBreak":true},{"text":"na dianmar-burba-dulad-ukedse sedoed.","poem":1},{"lineBreak":true},{"text":"Agine, Bab Dummad bela ibyanis","poem":1},{"lineBreak":true},{"text":"amar-ibyagi-naid ega osulogoed.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_wb9/REV/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_wb9/REV/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_wb9/REV/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}