{"translation":{"id":"cwe_pbt","name":"Biblia Ching'hwele","website":"https://ebible.org/Scriptures/details.php?id=cwe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cwe","licenseNotes":null,"shortName":"PBT","englishName":"Kwere NT","language":"cwe","textDirection":"ltr","sha256":"38df69f2f89790ae7693079265b7c60cee46f159defe65b2e139bf41f7bc9877","availableFormats":["json"],"listOfBooksApiLink":"/api/cwe_pbt/books.json","numberOfBooks":32,"totalNumberOfChapters":447,"totalNumberOfVerses":13806,"languageName":"Kwere","languageEnglishName":"Kwere"},"book":{"id":"DEU","translationId":"cwe_pbt","name":"Kumbukumbu da Malagilizo","commonName":"Kumbukumbu da Malagilizo","title":"Kumbukumbu da Malagilizo","order":5,"numberOfChapters":34,"sha256":"d834e3b18d0d968a4e63ea6f2f6b38758155d5413db2e6bc3fbb5c3fe3c831cc","firstChapterNumber":1,"firstChapterApiLink":"/api/cwe_pbt/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/cwe_pbt/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":["“Hulika weye ulanga, nizalonga,",{"text":"hulika mbuli zonilonga, weye isi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mafundizo yangu yezalaga fana madondo ya mvula","poem":1},{"lineBreak":true},{"text":"mbuli zangu zilagale fana nhungwe,","poem":1},{"lineBreak":true},{"text":"fana nyiminyimi muna ivinhu vihandigwe,","poem":1},{"lineBreak":true},{"text":"fana mawaga muna mayani mabisi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nizadigong'onda zina da Mndewa Mulungu,","poem":1},{"lineBreak":true},{"text":"mweye mwizalonga, ‘Mulungu wetu ni mkulu!’","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":["“Mndewa Mulungu ni luwe, sang'hano zake zigangamala",{"text":"na kohumiza voilondeka,","poem":1},{"lineBreak":true},{"text":"Mulungu mwaminika yelibule ubananzi,","poem":1},{"lineBreak":true},{"text":"kotenda mbuli zinogile na zigoloke.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mbali mweye hamwaminika bule kumwake,","poem":1},{"lineBreak":true},{"text":"mweye siyo wanage kaidi kwa ichimu cha wihi,","poem":1},{"lineBreak":true},{"text":"mweye ni welesi wihile na wagile.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Modahaze kumuliha ivo Mndewa Mulungu,","poem":1},{"lineBreak":true},{"text":"mweye wabozi na mwehuke?","poem":1},{"lineBreak":true},{"text":"Vino siyo Tati yenu yamulumbileni,","poem":1},{"lineBreak":true},{"text":"yoyamtendileni na kumgangamizani?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":["“Kumbukeni siku zifosile,",{"text":"geseni miyaka ya nyelesi nyingi,","poem":1},{"lineBreak":true},{"text":"wauzeni tati zenu, nawo wezamwidikani,","poem":1},{"lineBreak":true},{"text":"wauzeni walala wenu, nawo wezamulongelani.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mulungu yeli uchanyha ng'hani kawagolela wanhu uhazi.","poem":1},{"lineBreak":true},{"text":"Viyawagolele wanhu,","poem":1},{"lineBreak":true},{"text":"chila isi kaweng'ha mhaka zake","poem":1},{"lineBreak":true},{"text":"kwa kusondelela peta ya wana wa Isilaili,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"mana uhazi wa Mndewa Mulungu ni wanhu wake.","poem":1},{"lineBreak":true},{"text":"Kaisagulila wanhu wa Yakobo wawe wake.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kawafika kuna iisi ili kudibwilingu,","poem":1},{"lineBreak":true},{"text":"chuwala muhala chili na beho kulu.","poem":1},{"lineBreak":true},{"text":"Kawakaliza na kuwalola goya,","poem":1},{"lineBreak":true},{"text":"kawatenda fana mwana wa ziso jake.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fana masumula yokaliza chisanja chake,","poem":1},{"lineBreak":true},{"text":"kuzumhazumha uchanyha ya makinda yake,","poem":1},{"lineBreak":true},{"text":"kotandaza mabawa yake muladi kuwamhilila,","poem":1},{"lineBreak":true},{"text":"na kuwapapa uchanyha ya mabawa yake.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mndewa Mulungu muhala kowalongoza wanhu wake","poem":1},{"lineBreak":true},{"text":"bila kutazigwa na mulungu imwenga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":["“Kawaleka watawale isi inuke,",{"text":"na waja vinhu votile muna imigunda.","poem":1},{"lineBreak":true},{"text":"Kaweng'ha uki muna uluwe,","poem":1},{"lineBreak":true},{"text":"na mavuta kulawa muna uluwe ludala.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kaweng'ha samuli na matombo ya wanyama,","poem":1},{"lineBreak":true},{"text":"mafuta ya mwanang'hondolo mulume,","poem":1},{"lineBreak":true},{"text":"mabumbila ya wanyama wa Bashani na luti.","poem":1},{"lineBreak":true},{"text":"Kaweng'ha uhemba unogile kufosa umwenga wose na divai inogile kufosa zose wang'wa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wanhu wa Isilaili","poem":1},{"noteId":3},{"text":"wanona na kutowa mateka,","poem":1},{"lineBreak":true},{"text":"waneneha, wawa na matupe na wanogeza,","poem":1},{"lineBreak":true},{"text":"maabaho wamuleka Mulungu yawaumbile,","poem":1},{"lineBreak":true},{"text":"wamzeha luwe wa ukombola wawo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wamtenda Mndewa Mulungu yawone migongo kwa milungu yawo,","poem":1},{"lineBreak":true},{"text":"wamtenda yawone ludoko kwa sang'hano zawo zihile.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Watambikila maginyi yeli siyo milungu,","poem":1},{"lineBreak":true},{"text":"waihitila milungu hawaimanyile, milungu yoilawilile sambi,","poem":1},{"lineBreak":true},{"text":"ija wasaho zawo hawaidumbile.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hamumgesile Luwe yoyamwing'hileni ugima,","poem":1},{"lineBreak":true},{"text":"mumzimiza Mulungu yoyamwelekeni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":["“Mndewa Mulungu kawona mbuli ino na kawalema,",{"text":"kwaviya kawawonela ludoko wanage wa chilume na wa chike.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kalonga, ‘Sizawataza,’","poem":1},{"lineBreak":true},{"text":"maabaho nizawona chondachiwalawilile,","poem":1},{"lineBreak":true},{"text":"wanhu wawo weli na mizoyo midala na hawaminika.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wanitenda niwone ludoko kwa nyang'hiti zawo,","poem":1},{"lineBreak":true},{"text":"noiwonela migongo milungu yawo,","poem":1},{"lineBreak":true},{"text":"milungu ili siyo milungu ya kweli.","poem":1},{"lineBreak":true},{"text":"Ivo nizawatenda wawawonele migongo waja weli siyo chinhu,","poem":1},{"lineBreak":true},{"text":"nizawatenda wehilwe kwa kusang'hanila zisi za wabozi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ludoko lwangu lwizakwaka fana moto","poem":1},{"lineBreak":true},{"text":"lwizasoma mbaka kuzimu,","poem":1},{"lineBreak":true},{"text":"na kulunguza chila chinhu muna iisi.","poem":1},{"lineBreak":true},{"text":"Iwizabananga isi na vose vili umo,","poem":1},{"lineBreak":true},{"text":"lwizalunguza vandusilo va milima.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":["“Nizawagalila magayo",{"text":"na nizawatowa kwa misale yangu.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Wezadanganika kwa nzala na homa,","poem":1},{"lineBreak":true},{"text":"wezadanganika kwa mitamu,","poem":1},{"lineBreak":true},{"text":"nizagala wanyama weli na meno yasongoke","poem":1},{"lineBreak":true},{"text":"na mazoka weli na sumu wawalume.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ng'hondo izagala zifa nyingi kunze ya zikaye,","poem":1},{"lineBreak":true},{"text":"wezakuwa na ludumbo muna zikaye,","poem":1},{"lineBreak":true},{"text":"wabwanga na wandele wezadanganika,","poem":1},{"lineBreak":true},{"text":"wana ving'hele hebu walala weli na uhenga, hawezakuwa wagima.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nizawananga wawo,","poem":1},{"lineBreak":true},{"text":"ivo habule munhu yondayawakumbuke.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Mbali sizawaleka wehi wawo waigode kuwa wawahuma wanhu wangu,","poem":1},{"lineBreak":true},{"text":"niye Mndewa Mulungu nitenda mbuli zino zose.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":["“Isilaili ni isi ilibule nzewele,",{"text":"wanhu wake wabule ubala muna imizoyo yawo.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"One wawile na ubala wahavimanyile habali wahumigwa,","poem":1},{"lineBreak":true},{"text":"wahadahile kuvimanya uhelelo wawo wizakuwaze.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Munhu imwe kodahaze kuwahuma wanhu 1,000,","poem":1},{"lineBreak":true},{"text":"hebu wanhu waidi wodahaze kuwahuma wanhu 10,000,","poem":1},{"lineBreak":true},{"text":"mbali one Luwe wawo kawasa,","poem":1},{"lineBreak":true},{"text":"Mndewa Mulungu, Mulungu wawo kawaleka?","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Mana luwe wawo halingile na nguvu fana Luwe wetu,","poem":1},{"lineBreak":true},{"text":"hata wehi wetu wavimanya.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Zabibu zawo zizalawa muna zizabibu za Sodoma na kulawa muna imigunda ya Gomola.","poem":1},{"lineBreak":true},{"text":"Zabibu zawo zina sumu na vipambo vawo vina usungu,","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"divai ilinga fana itendigwa na sumu za mazoka.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":["“Mndewa Mulungu kokumbuka chiya chiwatendile wehi",{"text":"wawo,","poem":1},{"lineBreak":true},{"text":"kogozela lusita lufaya kuwatagusa.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Chisasi nizalihiza niye mwenyewo,","poem":1},{"lineBreak":true},{"text":"migulu yawo izateleza,","poem":1},{"lineBreak":true},{"text":"kwaviya siku yawo ya kudanganika yahabehi,","poem":1},{"lineBreak":true},{"text":"uhelelo wawo wa habehi.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Mndewa Mulungu kezawagombela wanhu wake","poem":1},{"lineBreak":true},{"text":"vondayawone kuwa nguvu zawo zimala.","poem":1},{"lineBreak":true},{"text":"Kezawawonela ubazi waja womsang'hanila,","poem":1},{"lineBreak":true},{"text":"vondayawone wabule nhazo.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Maabaho Mndewa Mulungu kezawauza wanhu wake,","poem":1},{"lineBreak":true},{"text":"‘Yakulihi milungu yenu,","poem":1},{"lineBreak":true},{"text":"miluwe yomuikimbilile kwa kukala goya?’","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Yakulihi milungu idile nhambiko yenu","poem":1},{"lineBreak":true},{"text":"na kung'wa divai na zabibu za ving'waji?","poem":1},{"lineBreak":true},{"text":"Lelo inuke imtazeni!","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":["“ ‘Niye niiyo Mulungu,",{"text":"habule imwenga yalingile niye.","poem":1},{"lineBreak":true},{"text":"Nokoma na nolava ugima,","poem":1},{"lineBreak":true},{"text":"nolumiza na kuhonya,","poem":1},{"lineBreak":true},{"text":"na habule munhu yodaha kulema chonitenda.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Nogolosa mkono wangu kuulanga,","poem":1},{"lineBreak":true},{"text":"na kuilaha kwa ugima wangu wa siku zose","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"one nihanola zele jangu dimelemeta","poem":1},{"lineBreak":true},{"text":"na kugolosa mkono kulava nhaguso,","poem":1},{"lineBreak":true},{"text":"nizawalihiliza wehi wangu,","poem":1},{"lineBreak":true},{"text":"nizawatagusa wanhu wonihila.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Misale yangu nizaitenda ikolwe na damu,","poem":1},{"lineBreak":true},{"text":"na zele jangu dizawakoma wose wonilema niye.","poem":1},{"lineBreak":true},{"text":"Wezatapagala damu ya wanhu wakomigwe na watumwa na wehi weli na nyele nhali.’","poem":1}]},{"type":"line_break"},{"type":"verse","number":43,"content":["“Mweye wanhu wa zisi wadeng'heleleni wanhu wa Mndewa Mulungu.",{"text":"Mulungu kowatagusa wose wowakoma wanhu wake.","poem":1},{"lineBreak":true},{"text":"Kowalihilizila wehi wake","poem":1},{"lineBreak":true},{"text":"na kolekelela uhasanyi wa wanhu wake.”","poem":1}]},{"type":"verse","number":44,"content":["Musa na Yoshua mwana wa Nuni weza haulongozi wa wanhu na walonga mbuli zose zili muna uwila uno, muladi wanhu wa Isilaili wauhulike."]},{"type":"heading","content":["Ndagilizi za uhelelo za Musa"]},{"type":"verse","number":45,"content":["Musa viyakomeleze kuwalongela Waisilaili wose mbuli zili muna uwila uno,"]},{"type":"verse","number":46,"content":["kawalongela, “Zikeni muna imizoyo yenu mbuli zose zonimulongeleni diyelo, muladi muwalagilize wanenu wasondelele chigangamavu mbuli zose za lagilizo dino."]},{"type":"verse","number":47,"content":["Kwaviya malagilizo yano siyo mbuli muhala mbali ugima wenu. Zindilileni malagilizo yayo muladi mukale siku nyingi muna iisi ija yomuhita kuisola kuumwambu wa Yoludani.”"]},{"type":"verse","number":48,"content":["Siku iyo iyo Mndewa Mulungu kamulongela Musa,"]},{"type":"verse","number":49,"content":["“Kwela mulima uno wa Abalimu, mulima wa Nebo, uli kuna iisi ya Moabu, voilola na bululu da Yeliko, ukailole isi ya Kanaani yoniweng'ha Waisilaili waisole."]},{"type":"verse","number":50,"content":["Kwizadanganikila kuna umulima uwo fana viyadanganike sekulu wako Haluni kuna umulima wa Holi,"]},{"type":"verse","number":51,"content":["kwaviya mweye wose waidi mukala hamunihuwila haulongozi ha Waisilaili. Vimukalile muna yamazi ya Meliba, habehi na bululu da Kadeshi, kuna ichuwala cha Sini, muleka kulagusa kwela kwangu hagati ya Waisilaili."]},{"type":"verse","number":52,"content":["Kwizaiwona isi ili kuulongozi wako, mbali hwizakwingila muna iisi iyo yoniweng'ha Waisilaili.”"]}],"footnotes":[{"noteId":3,"caller":"+","text":"Chiebulaniya cholonga “Yeshuluni” zina dimwenga da Isilaili fambulo jake “yolonga ukweli.”","reference":{"chapter":32,"verse":15}}]},"thisChapterLink":"/api/cwe_pbt/DEU/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cwe_pbt/DEU/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cwe_pbt/DEU/31.json","previousChapterAudioLinks":{},"numberOfVerses":52}