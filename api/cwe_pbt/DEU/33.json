{"translation":{"id":"cwe_pbt","name":"Biblia Ching'hwele","website":"https://ebible.org/Scriptures/details.php?id=cwe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cwe","licenseNotes":null,"shortName":"PBT","englishName":"Kwere NT","language":"cwe","textDirection":"ltr","sha256":"38df69f2f89790ae7693079265b7c60cee46f159defe65b2e139bf41f7bc9877","availableFormats":["json"],"listOfBooksApiLink":"/api/cwe_pbt/books.json","numberOfBooks":32,"totalNumberOfChapters":447,"totalNumberOfVerses":13806,"languageName":"Kwere","languageEnglishName":"Kwere"},"book":{"id":"DEU","translationId":"cwe_pbt","name":"Kumbukumbu da Malagilizo","commonName":"Kumbukumbu da Malagilizo","title":"Kumbukumbu da Malagilizo","order":5,"numberOfChapters":34,"sha256":"d834e3b18d0d968a4e63ea6f2f6b38758155d5413db2e6bc3fbb5c3fe3c831cc","firstChapterNumber":1,"firstChapterApiLink":"/api/cwe_pbt/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/cwe_pbt/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":33,"content":[{"type":"heading","content":["Musa koyatemela mate makabila ya Isilaili"]},{"type":"verse","number":1,"content":["Uno niuwo utemela mate wa Musa munhu wa Mulungu kwa Waisilaili ing'hali hanadanganika. Kalonga,"]},{"type":"verse","number":2,"content":[{"text":"“Mndewa Mulungu keza kulawa mulima wa Sinai,","poem":1},{"lineBreak":true},{"text":"kachilawilila kulawa mulima wa Seili,","poem":1},{"lineBreak":true},{"text":"kamwemwesa kulawa mulima wa Palani.","poem":1},{"lineBreak":true},{"text":"Kalawa hagati ya wasenga wa kuulanga maelufu longo,","poem":1},{"lineBreak":true},{"text":"na moto woukwaka muna umkono wake wa kulume.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kawalonda wanhu wake","poem":1},{"lineBreak":true},{"text":"na kawakaliza welile wake.","poem":1},{"lineBreak":true},{"text":"Ivo wanhu wake watumbala mavindi hana imigulu yake,","poem":1},{"lineBreak":true},{"text":"na kuhokela malagilizo kulawa kumwake.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Malagilizo yayo yoyaching'hile Musa,","poem":1},{"lineBreak":true},{"text":"ni uhazi wa mting'hano wa Yakobo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kakala mfalume wa Yeshuluni","poem":1},{"noteId":4},{"text":",","poem":1},{"lineBreak":true},{"text":"lusita wakulu wa wanhu viwaiting'hane,","poem":1},{"lineBreak":true},{"text":"viyaiting'hane hamwe makabila ya Isilaili.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":["“Dileke kabila da Lubeni dikale, sekedidanganike,",{"text":"buleivo wanhu wake wezakuwa wadodo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":["“Kusonhela kabila da Yuda kalonga,",{"text":"‘Weye Mndewa Mulungu itegeleze ndilo ya kabila da Yuda,","poem":1},{"lineBreak":true},{"text":"mbweleze kwa wanhu wake.","poem":1},{"lineBreak":true},{"text":"Udigombele kwa ichimu chake,","poem":1},{"lineBreak":true},{"text":"uditaze kuwahuma wehi wake.’","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kusonhela kabila da Lawi kalonga,","poem":1},{"lineBreak":true},{"text":"‘Weye Mndewa Mulungu uweng'he kabila da Lawi mbuli yako ya Ulimu,","poem":1},{"lineBreak":true},{"text":"mbuli yako ya Sumimu kwa wanhu wako wokwaminika,","poem":1},{"lineBreak":true},{"text":"wouwagezile uko Masa.","poem":1},{"lineBreak":true},{"text":"Kuihuma nawo kuna yamazi ya Meliba.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Walawi walamula kuwaleka tati zawo na mami zawo,","poem":1},{"lineBreak":true},{"text":"wawazimiza ndugu zawo,","poem":1},{"lineBreak":true},{"text":"hawawamanyile hata wana wawo,","poem":1},{"lineBreak":true},{"text":"kwaviya wazindilila malagilizo yako","poem":1},{"lineBreak":true},{"text":"na kwamha lagano jako.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wawafunze welesi wa Yakobo malagilizo yako,","poem":1},{"lineBreak":true},{"text":"wawafunze Waisilaili ndagilizi zako.","poem":1},{"lineBreak":true},{"text":"Walawi wafukize ubani haulongozi wako","poem":1},{"lineBreak":true},{"text":"na nhambiko ya kutimbula hana ulupango wako.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mndewa Mulungu utemele mate ludabwa lwawo lose,","poem":1},{"lineBreak":true},{"text":"uzitogole sang'hano zawo zowosang'hana,","poem":1},{"lineBreak":true},{"text":"ubene nguvu za wehi wawo,","poem":1},{"lineBreak":true},{"text":"nguvu za waja wowehila,","poem":1},{"lineBreak":true},{"text":"sekewenuke kaidi.’","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":["“Kusonhela kabila da Benjamini kalonga,",{"text":"‘Dino ijo kabila diyodilonda Mndewa Mulungu,","poem":1},{"lineBreak":true},{"text":"dokala goya haulongozi wake,","poem":1},{"lineBreak":true},{"text":"kodikaliza siku yose,","poem":1},{"lineBreak":true},{"text":"na kokala hagati yawo.’","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":["“Kusonhela kabila da Yosefu kalonga,",{"text":"‘Mndewa Mulungu yaitemele mate isi yake,","poem":1},{"lineBreak":true},{"text":"kwa vitumetume vilawa kuulanga,","poem":1},{"lineBreak":true},{"text":"na kwa mazi yolawa hasi ng'hani muna iisi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Isi yawo itemeligwe mate kwa matunda yanogile yevile na zuwa,","poem":1},{"lineBreak":true},{"text":"kwa matunda ya chila miyezi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kwa mazao yanogile ya milima ya umwaka,","poem":1},{"lineBreak":true},{"text":"na mazao mengi ya milima ya siku zose.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Isi yawo imemezigwe vinhu vose vinogile,","poem":1},{"lineBreak":true},{"text":"itemeligwe mate kwa unovu wa Mndewa Mulungu,","poem":1},{"lineBreak":true},{"text":"yoyalongile kulawa muna chibago chikwaka moto.","poem":1},{"lineBreak":true},{"text":"Kutemeligwa mate kuno kuwahulumukile wanhu wa kabila da Yosefu,","poem":1},{"lineBreak":true},{"text":"yoyakalile mulangulizi wa ndugu zake.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ng'ombe wa mwanduso kalinga fana ukulu wake,","poem":1},{"lineBreak":true},{"text":"mahembe yake ni ya ng'ombe mbago lume.","poem":1},{"lineBreak":true},{"text":"Kezayasang'hanila kuwakenha wanhu wa zisi zose,","poem":1},{"lineBreak":true},{"text":"kezawakenha mbaka uhelelo wa isi.","poem":1},{"lineBreak":true},{"text":"Efulaimu kezakuwa na wanhu wa ng'hondo maelufu mengi","poem":1},{"lineBreak":true},{"text":"na Manase kezakuwa na wanhu wa ng'hondo maelufu.’","poem":1}]},{"type":"verse","number":18,"content":["“Kusonhela makabila ya Zabuloni na Isakali kalonga,",{"text":"‘Mweye wanhu wa kabila da Zabuloni deng'heleleni vimulawa","poem":1},{"lineBreak":true},{"text":"na mweye wanhu wa kabila da Isakali deng'heleleni vimukingila muna yamahema yenu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wezawatanga wanhu kuna imilima yawo,","poem":1},{"lineBreak":true},{"text":"uko wezalava nhambiko zozilondeka.","poem":1},{"lineBreak":true},{"text":"Mana wezapata utajili wawo kulawa muna ibahali","poem":1},{"lineBreak":true},{"text":"na ngama zawo muna umsanga wa mhwani.’","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":["“Kusonhela kabila da Gadi kalonga,",{"text":"‘Yatunhizigwe Mulungu, yoding'ha kabila da Gadi isi ng'hulu","poem":1},{"lineBreak":true},{"text":"kabila da Gadi dosepasepa fana simba","poem":1},{"lineBreak":true},{"text":"yakwahule mkono na dosi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Waisagulila isi inogile kufosa zose,","poem":1},{"lineBreak":true},{"text":"hanhu hohekigwe hakwe kuwa ha mulangulizi,","poem":1},{"lineBreak":true},{"text":"wawalanguliza wanhu na kumtegeleza Mndewa Mulungu,","poem":1},{"lineBreak":true},{"text":"watenda mpango wa Mulungu kwa Isilaili.’","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":["“Kusonhela kabila da Dani kalonga,",{"text":"‘Dani ni mwana wa simba,","poem":1},{"lineBreak":true},{"text":"yozumha kulawa Bashani.’","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":["“Kusonhela kabila da Nafutali kalonga,",{"text":"‘Mweye wanhu wa kabila da Nafutali mumema kutemeligwa mate kwa Mndewa Mulungu,","poem":1},{"lineBreak":true},{"text":"isi yenu ni kusi kuna dilamba.’","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":["“Kusonhela kabila da Asheli kalonga,",{"text":"‘Asheli utemeligwe mate kufosa wana wose wa Yakobo,","poem":1},{"lineBreak":true},{"text":"yalondigwe na ndugu zake wose,","poem":1},{"lineBreak":true},{"text":"yachofe mgulu wake muna yamavuta.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Mabululu yako yana lwivi lukulu lwa zuma na shaba,","poem":1},{"lineBreak":true},{"text":"kwizakalizigwa siku zose.’","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":["“Habule yalingile fana Mulungu wa Isilaili,",{"text":"yokwiza kulawa kuulanga muladi yamtazeni,","poem":1},{"lineBreak":true},{"text":"yofosela uchanyha muna utunhizo wake.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Mulungu iyo mgombelaji wenu siku zose","poem":1},{"lineBreak":true},{"text":"makono yake ya hasi yenu, muladi yamtazeni.","poem":1},{"lineBreak":true},{"text":"Kawawinga wehi kuulongozi wenu,","poem":1},{"lineBreak":true},{"text":"na kowalongelani muwanange wose.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ivo Waisilaili wakala goya,","poem":1},{"lineBreak":true},{"text":"welesi wa Yakobo muhala,","poem":1},{"lineBreak":true},{"text":"muna iisi ili na mhule na divai,","poem":1},{"lineBreak":true},{"text":"isi ija langa jake dolagaza nhungwe.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Mumweda Waisilaili!","poem":1},{"lineBreak":true},{"text":"Habule yalingile fana mweye,","poem":1},{"lineBreak":true},{"text":"wanhu womukomboligwe na Mndewa Mulungu, nili ngawo ya utazi wenu","poem":1},{"lineBreak":true},{"text":"na panga dodimgalilani uhumi!","poem":1},{"lineBreak":true},{"text":"Wehi wenu wezakwiza kuinyendanyenda kumwenu,","poem":1},{"lineBreak":true},{"text":"mweye mwizawabojoga.”","poem":1}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Yeshuluni ni zina dimwenga da Isilaili.","reference":{"chapter":33,"verse":5}}]},"thisChapterLink":"/api/cwe_pbt/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cwe_pbt/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cwe_pbt/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}