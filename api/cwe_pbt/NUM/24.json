{"translation":{"id":"cwe_pbt","name":"Biblia Ching'hwele","website":"https://ebible.org/Scriptures/details.php?id=cwe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cwe","licenseNotes":null,"shortName":"PBT","englishName":"Kwere NT","language":"cwe","textDirection":"ltr","sha256":"38df69f2f89790ae7693079265b7c60cee46f159defe65b2e139bf41f7bc9877","availableFormats":["json"],"listOfBooksApiLink":"/api/cwe_pbt/books.json","numberOfBooks":32,"totalNumberOfChapters":447,"totalNumberOfVerses":13806,"languageName":"Kwere","languageEnglishName":"Kwere"},"book":{"id":"NUM","translationId":"cwe_pbt","name":"Peta","commonName":"Peta","title":"Peta","order":4,"numberOfChapters":36,"sha256":"399fe9f2ff2812c0d8c80fe607fb7eacf92b15f442a80038ae4d6b92c5ef5521","firstChapterNumber":1,"firstChapterApiLink":"/api/cwe_pbt/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/cwe_pbt/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["Basi Balaamu viyawonile kuwa imnogeza Mndewa Mulungu kuwatemela mate Waisilaili, hahitile kulotela kaidi, kalola kuchuwala."]},{"type":"verse","number":2,"content":["Balaamu kenula meso yake kawona Waisilaili weka malago yawo, chila kabila hanhu hake, Muhe wa Mulungu kamwizila,"]},{"type":"verse","number":3,"content":["nayo kagong'onda ulotezi uno,",{"text":"“Balaamu mwana wa Beoli kolotela,","poem":1},{"lineBreak":true},{"text":"ulotezi wa munhu ija yoyagubuligwe yameso,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ulotezi wa munhu yoyahulike mbuli za Mulungu,","poem":1},{"lineBreak":true},{"text":"yoyawonile malaguso ya Mulungu yeli na udahi,","poem":1},{"lineBreak":true},{"text":"yoibwanha chingubingubi, kagubuligwa yameso.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mahema yako yanoga ng'hani weye Yakobo,","poem":1},{"lineBreak":true},{"text":"hanhu hako ha kukala hanoga weye Isilaili!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Vino vilinga fana mabawe yokilima mazi,","poem":1},{"lineBreak":true},{"text":"fana chizi hamgwazo ya lwanda,","poem":1},{"lineBreak":true},{"text":"fana makunzamvili yoyahandile Mndewa Mulungu,","poem":1},{"lineBreak":true},{"text":"fana mielezi hamgwazo ya mazi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wezakuwa na mazi mengi muna zinongo zawo,","poem":1},{"lineBreak":true},{"text":"mbeyu zawo zizahandigwa hanhu heli na mazi ya kufaya.","poem":1},{"lineBreak":true},{"text":"Mfalume wawo kezakuwa mkulu kufosa Agagi,","poem":1},{"lineBreak":true},{"text":"ufalume wawo wizatunhizigwa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mulungu kawalava kulawa Misili,","poem":1},{"lineBreak":true},{"text":"kawagombela na wehi wawo fana ng'ombe mbago.","poem":1},{"lineBreak":true},{"text":"Kezawananga wanhu wa zisi zimwenga weli wehi wawo,","poem":1},{"lineBreak":true},{"text":"kezaibemenda mivuha yawo vihande vihande, kezawahoma kwa misale yawo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kaidulika, kagona fana simba,","poem":1},{"lineBreak":true},{"text":"kalinga fana simba zike, habule munhu yogeza kumulamsa.","poem":1},{"lineBreak":true},{"text":"Munhu yoyose yokutemela mate, kezatemiligwa mate,","poem":1},{"lineBreak":true},{"text":"munhu yoyose yokuduwila, kezaduwiligwa.”","poem":1}]},{"type":"verse","number":10,"content":["Balaki kamuwonela ludoko Balaamu, katowa mang'huwa na kamulongela, “Nikutanga muladi uwaduwile wehi wangu, mbali kuwatemela mate miyanza mitatu."]},{"type":"verse","number":11,"content":["Lelo segela! Nikala nikwikila chilagano kukwing'ha vinhu vingi, mbali Mndewa Mulungu hakudahize kupata vinhu ivo, kakwima.”"]},{"type":"verse","number":12,"content":["Balaamu kamwidika Balaki, “Vino siwalongele wasenga wouwatumile kumwangu"]},{"type":"verse","number":13,"content":["kuwa hata one uhaning'ha kaye yako imemile hela na zahabu, niye sidaha kubena lagilizo da Mndewa Mulungu kwa kutenda mbuli yoyose, inogile hebu ihile, bila kuwangilizigwa. Nilonga kuwa chondayalonge Mndewa Mulungu, niicho chondanilonge."]},{"type":"verse","number":14,"content":["Sambi nobwela kwa wanhu wangu, mbali ning'hali sinasegela, leka nikulongele mbuli ziya wanhu wano zondawawatendela wanhu wako siku zikwiza.”"]},{"type":"heading","content":["Ulotezi wekane wa Balaamu"]},{"type":"verse","number":15,"content":["Kalotela, kalonga,",{"text":"“Balaamu mwana wa Beoli kolonga,","poem":1},{"lineBreak":true},{"text":"Munhu ija yoyagubuligwe yameso,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ulotezi wa munhu yohulika mbuli za Mulungu,","poem":1},{"lineBreak":true},{"text":"na kuumanya umanyi wa yeye yeli uchanyha.","poem":1},{"lineBreak":true},{"text":"Munhu yoyowona malaguso ya Mulungu yeli na udahi,","poem":1},{"lineBreak":true},{"text":"yahaibwanha chingubingubi, kagubuligwa yameso.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nomuwona, mbali siyo sambi,","poem":1},{"lineBreak":true},{"text":"Nomuwona, mbali heli habehi.","poem":1},{"lineBreak":true},{"text":"Nhondo izalawilila kwa welesi wa Yakobo,","poem":1},{"lineBreak":true},{"text":"kezalawilila mfalume mwa Waisilaili.","poem":1},{"lineBreak":true},{"text":"Kezawatowa walangulizi wa Wamoabu kwa fimbo yake,","poem":1},{"lineBreak":true},{"text":"kezawadanganiza welesi wose wa Seti.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Isi ya Edomu izakuwa yake,","poem":1},{"lineBreak":true},{"text":"isi ya Seili izakuwa yake,","poem":1},{"lineBreak":true},{"text":"Isilaili izahuma.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Imwe kulawa muna uwelesi wa Yakobo kezatawala","poem":1},{"lineBreak":true},{"text":"kezawadanganiza wondawasigale muna dibululu.”","poem":1}]},{"type":"verse","number":20,"content":["Maabaho Balaamu kamuwona Amaleki, kalotela na kalonga,",{"text":"“Amaleki ni isi ili na nguvu kufosa zisi zose,","poem":1},{"lineBreak":true},{"text":"mbali kuuhelelo izadanganizigwa ng'hani.”","poem":1}]},{"type":"verse","number":21,"content":["Maabaho kawalola Wakeni, kalotela, kalonga,",{"text":"“Mhongono yenu ina nguvu mweye Wakeni,","poem":1},{"lineBreak":true},{"text":"fana chisanza uchanyha kuuluwe.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mbali mweye Wakeni mwizadanganizigwa,","poem":1},{"lineBreak":true},{"text":"mbaka Ashulu vondayawasole mateka.”","poem":1}]},{"type":"verse","number":23,"content":["Kaidi Balaamu kalonga,",{"text":"“Loo! Yelihi yondayahone, Mulungu vondayatende yano?","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ngalawa ng'hulu zizakwiza kulawa mhwani ya Kitimu,","poem":1},{"lineBreak":true},{"text":"wezaziteka Ashulu na Ebeli,","poem":1},{"lineBreak":true},{"text":"na wawo iviya wezadanganizigwa.”","poem":1}]},{"type":"verse","number":25,"content":["Maabaho Balaamu kenuka na kabwela ukaye, Balaki iviya kasegela."]}],"footnotes":[]},"thisChapterLink":"/api/cwe_pbt/NUM/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cwe_pbt/NUM/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cwe_pbt/NUM/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}