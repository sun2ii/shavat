","number":37,"content":["Immers Efterkommere 1.052,"]},{"type":"verse","number":38,"content":["Pasjhurs Efterkommere 1.247,"]},{"type":"verse","number":39,"content":["Harims Efterkommere 1.017."]},{"type":"verse","number":40,"content":["Levitterne var: Jesuas og Kadmiels Efterkommere af Hodavjas Efterkommere 74,"]},{"type":"verse","number":41,"content":["Tempelsangerne var: Asafs Sønner 128."]},{"type":"verse","number":42,"content":["Dørvogterne var: Sjallums, Aters, Talmons, Akkubs, Hatitas og Sjobajs Efterkommere, i alt 139."]},{"type":"verse","number":43,"content":["Tempeltrællene var: Zihas, Hasufas, Tabbaots,"]},{"type":"verse","number":44,"content":["Keros', Si'as, Padons,"]},{"type":"verse","number":45,"content":["Lebanas, Hagabas, Akkubs,"]},{"type":"verse","number":46,"content":["Hagabs, Salmajs, Hanans,"]},{"type":"verse","number":47,"content":["Giddels, Gahars, Reajas,"]},{"type":"verse","number":48,"content":["Rezins, Nekodas, Gazzams,"]},{"type":"verse","number":49,"content":["Uzzas, Paseas, Besajs,"]},{"type":"verse","number":50,"content":["Asnas, Me'unitternes, Nefusitternes,"]},{"type":"verse","number":51,"content":["Bakbuks, Hakufas, Harhurs,"]},{"type":"verse","number":52,"content":["Bazluts, Mehidas, Harsjas,"]},{"type":"verse","number":53,"content":["Barkos', Siseras, Temas,"]},{"type":"verse","number":54,"content":["Nezias og Hatifas Efterkommere."]},{"type":"verse","number":55,"content":["Efterkommere af Salomos Trælle var: Sotajs, Soferets, Perudas,"]},{"type":"verse","number":56,"content":["Ja'alas, Darkons, Giddels,"]},{"type":"verse","number":57,"content":["Sjefatjas, Hattils, Pokeret-Hazzebajims og Amis Efterkommere."]},{"type":"verse","number":58,"content":["Tempeltrællene og Efterkommerne af Salomos Trælle var i alt 392."]},{"type":"verse","number":59,"content":["Følgende, som drog op fra Tel-Mela, Tel-Harsja, Kerub-Addan og Immer, kunde ikke opgive deres Fædrenehuse og Slægt, hvor vidt de hørte til Israel:"]},{"type":"verse","number":60,"content":["Delajas, Tobijas og Nekodas Efterkommere 652."]},{"type":"verse","number":61,"content":["Og af Præsterne: Habajas, Hakkoz' og Barzillajs Efterkommere; denne sidste havde ægtet en af Gileaditten Barzillajs Døtre og var blevet opkaldt efter dem."]},{"type":"verse","number":62,"content":["De ledte efter deres Slægtebøger, men kunde ikke finde dem, derfor blev de som urene udelukket fra Præstestanden."]},{"type":"verse","number":63,"content":["Statholderen forbød dem at spise af det højhellige, indtil der fremstod en Præst med Urim og Tummim."]},{"type":"verse","number":64,"content":["Hele Menigheden udgjorde 42.360"]},{"type":"verse","number":65,"content":["foruden deres Trælle og Trælkvinder, som udgjorde 7.337, hvortil kom 200 Sangere og Sangerinder."]},{"type":"verse","number":66,"content":["Deres Heste udgjorde 736, deres Muldyr 245,"]},{"type":"verse","number":67,"content":["deres Kameler 435 og deres Æsler 6.720."]},{"type":"verse","number":68,"content":["Af fædrenehusenes Overhoveder gav nogle, da de kom til HERRENS Hus i Jerusalem, frivillige Gaver til Guds Hus, for at det kunde genopbygges på sin Plads;"]},{"type":"verse","number":69,"content":["de gav efter deres Evne til Byggesummen 61.000 Drakmer Guld, 5.000 Miner Sølv og 100 Præstekjortler."]},{"type":"verse","number":70,"content":["Derpå bosatte Præsterne, Levitterne og en Del al Folket sig i Jerusalem og dets Område, men Sangerne, Dørvogterne og Tempeltrællene og hele det øvrige Israel i deres Byer."]}],"footnotes":[]},"thisChapterLink":"/api/dan_det/EZR/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dan_det/EZR/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dan_det/EZR/1.json","previousChapterAudioLinks":{},"numberOfVerses":70}