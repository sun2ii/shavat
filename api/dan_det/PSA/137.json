{"translation":{"id":"dan_det","name":"Hellig Bibel","website":"https://ebible.org/Scriptures/details.php?id=dan1931","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dan1931","licenseNotes":null,"shortName":"DET","englishName":"Danish Bible 1931","language":"dan","textDirection":"ltr","sha256":"c8f35c60bd96adc4de393031a28ecc4e76f4022b54b567f4e51f2d1e6da76b5a","availableFormats":["json"],"listOfBooksApiLink":"/api/dan_det/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"dansk","languageEnglishName":"Danish"},"book":{"id":"PSA","translationId":"dan_det","name":"SALME","commonName":"SALME","title":"SALME","order":19,"numberOfChapters":150,"sha256":"0ef8f6e286952d4a5bc46447d4291c38423992729e92804eed5e7d9bafba66eb","firstChapterNumber":1,"firstChapterApiLink":"/api/dan_det/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dan_det/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":["Ved Babels Floder, der sad vi og græd, når Zion randt os i hu."]},{"type":"verse","number":2,"content":["Vi hængte vore Harper i Landets Pile."]},{"type":"verse","number":3,"content":["Thi de, der havde bortført os, bad os synge, vore Bødler bad os være glade: “Syng os af Zions Sange!”"]},{"type":"verse","number":4,"content":["Hvor kan vi synge HERRENS Sange på fremmed Grund?"]},{"type":"verse","number":5,"content":["Jerusalem, glemmer jeg dig, da visne min højre!"]},{"type":"verse","number":6,"content":["Min Tunge hænge ved Ganen, om ikke jeg ihukommer dig, om ikke jeg sætter Jerusalem over min højeste Glæde!"]},{"type":"verse","number":7,"content":["HERRE, ihukom Edoms Sønner for Jerusalems Dag, at de råbte: “Nedbryd, nedbryd lige til Grunden!”"]},{"type":"verse","number":8,"content":["Du Babels Datter, du Ødelægger! Salig den, der gengælder dig, hvad du gjorde imod os!"]},{"type":"verse","number":9,"content":["Salig den, der griber dine spæde og knuser dem mod Klippen!"]}],"footnotes":[]},"thisChapterLink":"/api/dan_det/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dan_det/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dan_det/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}