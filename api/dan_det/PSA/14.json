{"translation":{"id":"dan_det","name":"Hellig Bibel","website":"https://ebible.org/Scriptures/details.php?id=dan1931","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dan1931","licenseNotes":null,"shortName":"DET","englishName":"Danish Bible 1931","language":"dan","textDirection":"ltr","sha256":"c8f35c60bd96adc4de393031a28ecc4e76f4022b54b567f4e51f2d1e6da76b5a","availableFormats":["json"],"listOfBooksApiLink":"/api/dan_det/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"dansk","languageEnglishName":"Danish"},"book":{"id":"PSA","translationId":"dan_det","name":"SALME","commonName":"SALME","title":"SALME","order":19,"numberOfChapters":150,"sha256":"0ef8f6e286952d4a5bc46447d4291c38423992729e92804eed5e7d9bafba66eb","firstChapterNumber":1,"firstChapterApiLink":"/api/dan_det/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dan_det/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":["Til Sangmesteren. Af David. Dårerne siger i Hjertet: “Der er ingen Gud!” Slet og afskyeligt handler de, ingen gør godt."]},{"type":"verse","number":2,"content":["HERREN skuer ned fra Himlen på Menneskens Børn for at se, om der findes en forstandig, nogen, der søger Gud."]},{"type":"verse","number":3,"content":["Afveget er alle, til Hobe fordærvet, ingen gør godt, end ikke én!"]},{"type":"verse","number":4,"content":["Er alle de Udådsmænd da uden Forstand, der æder mit Folk, som åd de Brød, og ikke påkalder HERREN?"]},{"type":"verse","number":5,"content":["Af Rædsel gribes de da, thi Gud er i de retfærdiges Slægt."]},{"type":"verse","number":6,"content":["Gør kun den armes Råd til Skamme, HERREN er dog hans Tilflugt."]},{"type":"verse","number":7,"content":["Ak, kom dog fra Zion Israels Frelse! Når HERREN vender Folkets Skæbne, skal Jakob juble, Israel glædes!"]}],"footnotes":[]},"thisChapterLink":"/api/dan_det/PSA/14.json","thisChapterAudioLinks":{},"next