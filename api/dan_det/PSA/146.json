{"translation":{"id":"dan_det","name":"Hellig Bibel","website":"https://ebible.org/Scriptures/details.php?id=dan1931","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dan1931","licenseNotes":null,"shortName":"DET","englishName":"Danish Bible 1931","language":"dan","textDirection":"ltr","sha256":"c8f35c60bd96adc4de393031a28ecc4e76f4022b54b567f4e51f2d1e6da76b5a","availableFormats":["json"],"listOfBooksApiLink":"/api/dan_det/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"dansk","languageEnglishName":"Danish"},"book":{"id":"PSA","translationId":"dan_det","name":"SALME","commonName":"SALME","title":"SALME","order":19,"numberOfChapters":150,"sha256":"0ef8f6e286952d4a5bc46447d4291c38423992729e92804eed5e7d9bafba66eb","firstChapterNumber":1,"firstChapterApiLink":"/api/dan_det/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dan_det/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":["Halleluja! Pris HERREN, min Sjæl!"]},{"type":"verse","number":2,"content":["Jeg vil prise HERREN hele mit Liv, lovsynge min Gud, så længe jeg lever."]},{"type":"verse","number":3,"content":["Sæt ikke eders Lid til Fyrster, til et Menneskebarn, der ikke kan hjælpe!"]},{"type":"verse","number":4,"content":["Hans Ånd går bort, han bliver til Jord igen, hans Råd er bristet samme Dag."]},{"type":"verse","number":5,"content":["Salig den, hvis Hjælp er Jakobs Gud, hvis Håb står til HERREN hans Gud,"]},{"type":"verse","number":6,"content":["som skabte Himmel og Jord, Havet og alt, hvad de rummer, som evigt bevarer sin Trofasthed"]},{"type":"verse","number":7,"content":["og skaffer de undertrykte Ret, som giver de sultne Brød! HERREN løser de fangne,"]},{"type":"verse","number":8,"content":["HERREN åbner de blindes Øjne, HERREN rejser de bøjede, HERREN elsker de retfærdige,"]},{"type":"verse","number":9,"content":["HERREN vogter de fremmede, opholder faderløse og Enker, men gudløses Vej gør han kroget."]},{"type":"verse","number":10,"content":["HERREN er Konge for evigt, din Gud, o Zion, fra Slægt til Slægt. Halleluja!"]}],"footnotes":[]},"thisChapterLink":"/api/dan_det/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dan_det/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dan_det/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}