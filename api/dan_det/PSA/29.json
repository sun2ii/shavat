{"translation":{"id":"dan_det","name":"Hellig Bibel","website":"https://ebible.org/Scriptures/details.php?id=dan1931","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dan1931","licenseNotes":null,"shortName":"DET","englishName":"Danish Bible 1931","language":"dan","textDirection":"ltr","sha256":"c8f35c60bd96adc4de393031a28ecc4e76f4022b54b567f4e51f2d1e6da76b5a","availableFormats":["json"],"listOfBooksApiLink":"/api/dan_det/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"dansk","languageEnglishName":"Danish"},"book":{"id":"PSA","translationId":"dan_det","name":"SALME","commonName":"SALME","title":"SALME","order":19,"numberOfChapters":150,"sha256":"0ef8f6e286952d4a5bc46447d4291c38423992729e92804eed5e7d9bafba66eb","firstChapterNumber":1,"firstChapterApiLink":"/api/dan_det/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dan_det/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":["En Salme af David. Giver HERREN, I Guds Sønner, giver Herren Ære og Pris,"]},{"type":"verse","number":2,"content":["giver HERREN hans Navns Ære; tilbed HERREN i helligt Skrud!"]},{"type":"verse","number":3,"content":["HERRENS Røst er over Vandene, Ærens Gud lader Tordenen rulle, HERREN, over de vældige Vande!"]},{"type":"verse","number":4,"content":["HERRENS Røst med Vælde, HERRENS Røst i Højhed,"]},{"type":"verse","number":5,"content":["HERRENS Røst, den splintrer Cedre, HERREN splintrer Libanons Cedre,"]},{"type":"verse","number":6,"content":["får Libanon til at springe som en Kalv og Sirjon som den vilde Okse!"]},{"type":"verse","number":7,"content":["HERRENS Røst udslynger Luer."]},{"type":"verse","number":8,"content":["HERRENS Røst får Ørk til at skælve, HERREN får Kadesj' Ørk til at skælve!"]},{"type":"verse","number":9,"content":["HERRENS Røst får Hind til at føde, og den gør lyst i Skoven. Alt i hans Helligdom råber: “Ære!”"]},{"type":"verse","number":10,"content":["HERREN tog Sæde og sendte Vandfloden, HERREN tog Sæde som Konge for evigt."]},{"type":"verse","number":11,"content":["HERREN give Kraft til sit Folk, HERREN velsigne sit Folk med Fred!"]}],"footnotes":[]},"thisChapterLink":"/api/dan_det/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dan_det/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dan_det/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}