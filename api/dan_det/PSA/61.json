{"translation":{"id":"dan_det","name":"Hellig Bibel","website":"https://ebible.org/Scriptures/details.php?id=dan1931","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dan1931","licenseNotes":null,"shortName":"DET","englishName":"Danish Bible 1931","language":"dan","textDirection":"ltr","sha256":"c8f35c60bd96adc4de393031a28ecc4e76f4022b54b567f4e51f2d1e6da76b5a","availableFormats":["json"],"listOfBooksApiLink":"/api/dan_det/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"dansk","languageEnglishName":"Danish"},"book":{"id":"PSA","translationId":"dan_det","name":"SALME","commonName":"SALME","title":"SALME","order":19,"numberOfChapters":150,"sha256":"0ef8f6e286952d4a5bc46447d4291c38423992729e92804eed5e7d9bafba66eb","firstChapterNumber":1,"firstChapterApiLink":"/api/dan_det/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dan_det/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":61,"content":[{"type":"verse","number":1,"content":["Til Sangmesteren. Til Strengespil. Af David."]},{"type":"verse","number":2,"content":["Hør, o Gud, på mit råb og lyt til min bøn!"]},{"type":"verse","number":3,"content":["Fra Jordens Ende råber jeg til dig. Når mit Hjerte vansmægter, løft mig da op på en Klippe,"]},{"type":"verse","number":4,"content":["led mig, thi du er min Tilflugt, et mægtigt Tårn til Værn imod Fjenden."]},{"type":"verse","number":5,"content":["Lad mig evigt bo som Gæst i dit Telt, finde Tilflugt i dine Vingers Skjul! - Sela."]},{"type":"verse","number":6,"content":["Ja du, o Gud, har hørt mine Løfter, opfyldt deres Ønsker, der frygter dit Navn."]},{"type":"verse","number":7,"content":["Til Kongens Dage lægger du Dage, hans År skal være fra Slægt til Slægt."]},{"type":"verse","number":8,"content":["Han skal trone evigt for Guds Åsyn; send Nåde og Sandhed til at bevare ham!"]},{"type":"verse","number":9,"content":["Da vil jeg evigt love dit Navn og således Dag efter Dag indfri mine Løfter."]}],"footnotes":[]},"thisChapterLink":"/api/dan_det/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dan_det/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dan_det/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":9}