{"translation":{"id":"djr_bib","name":"God-Waŋarrwu Walŋamirr Dhäruk","website":"https://ebible.org/Scriptures/details.php?id=djr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=djr","licenseNotes":null,"shortName":"BIB","englishName":"Djambarrpuyngu NT","language":"djr","textDirection":"ltr","sha256":"90f83407e59ea4236a9601ffe0a9657337a6e9a37c94bcd5d7506a9bb0f48b8f","availableFormats":["json"],"listOfBooksApiLink":"/api/djr_bib/books.json","numberOfBooks":31,"totalNumberOfChapters":276,"totalNumberOfVerses":8032,"languageName":"Djambarrpuyngu","languageEnglishName":"Djambarrpuyngu"},"book":{"id":"MAT","translationId":"djr_bib","name":"MATHUYU (MATTHEW)","commonName":"MATHUYU (MATTHEW)","title":"DJESUWALAŊUWUY DHÄWU MATHUYUWUŊ WUKIRRIWUY","order":40,"numberOfChapters":28,"sha256":"9f2aff10c54e0bbd9166d4db256f4c50ee07f7e7a9d8c3948803287486f5efa0","firstChapterNumber":1,"firstChapterApiLink":"/api/djr_bib/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/djr_bib/MAT/28.json","totalNumberOfVerses":1058},"chapter":{"number":1,"content":[{"type":"heading","content":["Djesuny dhuwal yarraṯaŋur dhiyakuwurruŋgal"]},{"type":"heading","content":["The Ancestors of Jesus"]},{"type":"verse","number":1,"content":["Dhuwandja yarraṯaŋur wäwa'mirriŋuwal, ga yan bili ga gäthu'mirriŋuwal, ga yan bili ga märi'mumirriŋuwal, ga yan bili ga yuṯawalnha bäpa'mirriŋuwal. Dhuwandja Djesuny yarraṯaŋur, ŋunhi ŋayi Maŋutji-dhunupayanhawuy God-Waŋarrwuŋ, ŋunhi ŋayi mala-bunhawuynydja Daybitkuŋ,",{"noteId":0},"ga ŋayiny Daybittja mala-bunhawuy Yipurayimguŋun.",{"noteId":1}]},{"type":"verse","number":2,"content":[{"text":"Ga ŋayiny Yipurayimdja bäpa'mirriŋu Yitjakkun,","poem":1},{"noteId":2},{"text":"ga ŋayiny Yitjaktja bäpa'mirriŋu Djaykupku,","poem":2},{"noteId":3},{"lineBreak":true},{"text":"ga Djaykuptja bäpa'mirriŋu Djudaw,","poem":2},{"noteId":4},{"text":"ga wäwa'mirriŋuw walalaŋ nhanukalaŋaw,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ga Djudany bäpa'mirriŋu Beratjku","poem":1},{"noteId":5},{"text":"ga Djeraw","poem":1},{"noteId":6},{"text":"ŋunhi maṉḏaŋ ŋäṉḏi'mirriŋuny Dayma,","poem":1},{"noteId":7},{"text":"ga Beratjtja","poem":2},{"noteId":8},{"text":"bäpa'mirriŋu Yitjurungu,","poem":2},{"noteId":9},{"lineBreak":true},{"text":"ga Yitjurundja bäpa'mirriŋu Rämgu,","poem":2},{"noteId":10}]},{"type":"verse","number":4,"content":[{"text":"ga Rämdja bäpa'mirriŋu Minadapku,","poem":1},{"noteId":11},{"text":"ga Minadaptja bäpa'mirriŋu Nätjungu,","poem":2},{"noteId":12},{"lineBreak":true},{"text":"ga Nätjundja bäpa'mirriŋu Djalmangun,","poem":2},{"noteId":13}]},{"type":"verse","number":5,"content":[{"text":"ga Djalmandja bäpa'mirriŋu Bawatjku","poem":1},{"noteId":14},{"text":"ga Rayap","poem":1},{"noteId":15},{"text":"nhanŋu Bawatjkuny ŋäṉḏi'mirriŋu,","poem":1},{"text":"ga ŋayiny Bawatjtja bäpa'mirriŋu Wopitku","poem":2},{"noteId":16},{"text":"ga ŋäṉḏi'mirriŋuny nhanŋu Ruth,","poem":2},{"lineBreak":true},{"text":"ga Wopittja bäpa'mirriŋu Djitjiw,","poem":2},{"noteId":17}]},{"type":"verse","number":6,"content":[{"text":"Djitjiny bäpa'mirriŋu Daybitkun,","poem":1},{"noteId":18},{"text":"ŋunhi ŋayi Ŋurruḏawalaŋu buŋgawa.","poem":1},{"lineBreak":true},{"text":"Ga Daybittja ŋunhi bäpa'mirriŋu Djalamangun,","poem":1},{"noteId":19},{"text":"ga ŋäṉḏi'mirriŋuny nhanŋu Djalamangu yäku Bätjiba","poem":1},{"noteId":20},{"text":"ŋunhi ŋäthilnydja ŋayi ŋunhiyiny miyalk ḏirramuw yäkuw Yuriyaw.","poem":1},{"noteId":21}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ga Djalamandja bäpa'mirriŋu Riyapawamgu,","poem":1},{"noteId":22},{"text":"ga ŋayiny Riyapawamdja bäpa'mirriŋu Yabitjaw,","poem":2},{"noteId":23},{"lineBreak":true},{"text":"ga Yabitjany bäpa'mirriŋu Yätjaw,","poem":2},{"noteId":24}]},{"type":"verse","number":8,"content":[{"text":"ga Yätjany bäpa'mirriŋu Djutjapatku,","poem":1},{"noteId":25},{"text":"ga Djutjapattja bäpa'mirriŋu Djoramgu,","poem":2},{"noteId":26},{"lineBreak":true},{"text":"ga Djoramdja bäpa'mirriŋu Yutjayaw,","poem":2},{"noteId":27}]},{"type":"verse","number":9,"content":[{"text":"ga Yutjayany bäpa'mirriŋu Djothamgu,","poem":1},{"noteId":28},{"text":"ga Djothamdja bäpa'mirriŋu Yayatjku,","poem":2},{"noteId":29},{"lineBreak":true},{"text":"ga Yayatjtja bäpa'mirriŋu Yitjakayaw,","poem":2},{"noteId":30}]},{"type":"verse","number":10,"content":[{"text":"ga Yitjakayany bäpa'mirriŋu Manatjaw,","poem":1},{"noteId":31},{"text":"ga Manatjany bäpa'mirriŋu Yämungu,","poem":2},{"noteId":32},{"lineBreak":true},{"text":"ga Yämundja bäpa'mirriŋu Djawtjayaw,","poem":2},{"noteId":33}]},{"type":"verse","number":11,"content":[{"text":"ga Djawtjayany bäpa'mirriŋu Djiyawtjingu","poem":1},{"noteId":34},{"text":"ga wäwa'mirriŋuw mala nhanukalaŋaw, ga balanyamirriyyin ŋunhi Djotjiya ga nhanŋu gäthu'mirriŋu walal gan nhinan ŋunhili Yitjural","poem":1},{"noteId":35},{"text":"bala yan miriŋun walalaŋ bunan, bala bumarnha Yitjuralnhany bäpurruny, yindin dhika mari malŋ'thurr, ga wiripuwurrunhany gan ŋunhi yolŋuny walalany djaw'-djawyurra balan bitjarra wäŋalil yäkulil Babilunlila.","poem":1},{"noteId":36}]},{"type":"verse","number":12,"content":["Ga beŋuryiny dhurrwaraŋur, walalnydja ŋunhi Yitjuralpuynhany yolŋuny walalany gan ŋaŋ'ŋaŋ'thurra balan Babilunlila wäŋalil yäkulil. Dhiyaŋuwurruyiny ga mala-ŋurrkanhayŋuy maŋutji-lakaram ŋanyanhan Djesu-Christnhan dhawal-guyaŋanhawuynha.",{"text":"Yo, manymak ŋayiny Djiyawtjiny","poem":1},{"noteId":37},{"text":"bäpa'mirriŋu Djiyalṯiyalwu,","poem":1},{"noteId":38},{"text":"ga ŋayiny Djiyalṯiyalnydja bäpa'mirriŋu Djirabaybulwu,","poem":2},{"noteId":39}]},{"type":"verse","number":13,"content":[{"text":"ga Djirabaybulnydja bäpa'mirriŋu Yabiyutku,","poem":1},{"noteId":40},{"text":"ga Yabiyuttja bäpa'mirriŋu Yiliyakimgu,","poem":2},{"noteId":41},{"lineBreak":true},{"text":"ga Yiliyakimdja bäpa'mirriŋu Yätjuw,","poem":2},{"noteId":42}]},{"type":"verse","number":14,"content":[{"text":"ga ŋayiny Yätjuny bäpa'mirriŋu Djädukku,","poem":1},{"noteId":43},{"text":"ga Djäduktja bäpa'mirriŋu Yaykimgu,","poem":2},{"noteId":44},{"lineBreak":true},{"text":"ga Yaykimdja bäpa'mirriŋu Yiliwutku,","poem":2},{"noteId":45}]},{"type":"verse","number":15,"content":[{"text":"ga Yiliwuttja bäpa'mirriŋu Yiliyatjaw,","poem":1},{"noteId":46},{"text":"ga ŋayiny Yiliyatjany bäpa'mirriŋu Mathan'ku,","poem":2},{"noteId":47},{"lineBreak":true},{"text":"ga Mathan'tja bäpa'mirriŋu Djaykupkun.","poem":2},{"noteId":48}]},{"type":"verse","number":16,"content":[{"text":"Ga ŋayiny Djaykuptja bäpa'mirriŋu Djawutjipkun,","poem":1},{"noteId":49},{"text":"ŋunhi ŋayi Meriwnha","poem":1},{"noteId":50},{"text":"dhuway'mirriŋu, ga Meriny ŋäṉḏi'mirriŋu nhanŋu Djesuwnha, ŋunhi ŋayi Maŋutji-dhunupayanhawuynha.","poem":1}]},{"type":"verse","number":17,"content":["Ga 14-mirr walal mala-ŋurrkanhamin nhanŋuny Yipurayimguny djamarrkuḻi', ga yan bili-i-i ga Daybitkal wapthurr, ga beŋur Daybitkalnydja walal bulu 14-mirryi yan mala-ŋurrkanhamin, yan bili-i-i ga ŋunhi walu ŋayathaŋal ŋunhi walalany Yitjuralnhan bäpurruny miriŋuynha mala djaw'-djawyurr balan wäŋalil yäkulil Babilunlila. Ga bulu beŋuryiny muka walal dhurrwaraŋur 14-mirryi yan mala-ŋurrkanhamin, ga yan bili ga ŋayin Garraynha dhawal-guyaŋan Djesu-Christnha ŋunhi ŋayi Maŋutji-dhunupayanhawuynha."]},{"type":"heading","content":["Dhiyaŋuny ga dhukarryu lakaram Djesu-Christnhan dhawal-guyaŋanhawuy"]},{"type":"heading","content":["The birth of Jesus"]},{"type":"verse","number":18,"content":["Ga ŋäṉḏi'mirriŋuny nhanŋu ŋunhi Djesuw Meriny,",{"noteId":51},"miyalktja ŋayi ŋunhi dhawu'mirrnydja ḏirramuw yäkuw Djawutjipku,",{"noteId":52},"ga yurrnha maṉḏa ŋunhi märranhaminany, ŋayiny ŋunhi Meriny ŋäthil yan marŋgithinany ŋunhi ŋayi yothumirriyinany Dhuyu-Birrimbirrwuŋ."]},{"type":"verse","number":19,"content":["Ga ŋayiny ŋunhi Djawutjiptja dhuway'mirriŋuny nhanŋu Meriw, dhuwurr-dhunupa balanya yolŋu ga bitjarra ŋayi gan ŋunhi guyaŋanany ŋayi dhu yaka gora gurrupan ŋanya Meriny bukmakkal nhakun yolŋuwal walalaŋgal bala ganarrthaman ŋanya, bala ŋayi balaŋ gayulnha ŋunhi djämany bitjanayiny."]},{"type":"verse","number":20,"content":["Ga ŋunhi ŋayi gan bitjarryiny guyaŋan, God-Waŋarrwuny dhäwu-gänhamirrnydja bunanan nhanŋu Djawutjipkuny mäwa'wurra, ga bitjarr ŋayi ŋunhi nhanukal waŋanany, “Djawutjip mala-bunhawuy Daybitkuŋ, yaka barrari märranharaw Meriwnydja. Märranhamirra maṉḏa, märr nhuŋu ŋayi dhu miyalknha, bili ŋunhiyiny yothu ŋayi ga gäma beŋur Dhuyu-Birrimbirrwuŋ gurrupanawuy."]},{"type":"verse","number":21,"content":["Ga Meriwuŋuny dhu dhawal-guyaŋany yothuny ḏirramun, ga yäku-gurrupananawuynydja dhu ŋayi ŋunhi Djesu. Ga ŋayin dhu ga ŋunhi Djesuynha walŋakumany yolŋunhany walalany nhanŋuwuy ŋayi beŋurnydja ŋunhi walalaŋgiyingal dhuwurr-yätjŋurnydja romŋur,” bitjarra ŋayi gan ŋunhi ŋuriŋiyiny dhäwumirriynydja lakaraŋal Djawutjipkuny."]},{"type":"verse","number":22,"content":["Ga bitjarrnydja dhuwal maḻŋ'thurr, märr walalnydja dhu yolŋuynydja walal dharaŋana dhuwali yuwalkkuman yan, ŋunhi ŋäthil gan God-Waŋarr waŋan ŋuliwitjarr djawarrkmirriwal bitjarr,"]},{"type":"verse","number":23,"content":["“Ga yuṯa dhu ḻuni miyalk yothumirriyirr, ga ḏirramun nhanukuŋ dhu ŋunhi yothuny dhawal-guyaŋi, ga yäku-lakaramany walal ŋanya dhu ga Yimannyuwal,",{"noteId":53},"mayali' God-Waŋarrnydja dhuwanna limurruŋgal.”"]},{"type":"verse","number":24,"content":["Ga ŋunhi ŋayi Djawutjip rur'yurrnydja yakurrŋurnydja, bala ŋayi märraŋal Merinhany wäŋalila nhanukiyingal ŋayi, bitjarr yan bili nhakun ŋunhi God-Waŋarrwal dhäwu-gänhamirriymirriy gan lakaraŋal nhanukal."]},{"type":"verse","number":25,"content":["Yo, ŋunhi maṉḏa märranhaminany, yurr ŋäthilnydja maṉḏa ŋunhi bäyŋu ŋula ŋorranha waŋganyŋurnydja ga ŋula galŋa-ŋayathanhaminya, yan bili ga yothu nhanŋu ḏirramu dhawal-guyaŋan. Bala Djawutjipthuny ŋanya yäku-nhirrparnydja Djesun."]}],"footnotes":[{"noteId":0,"caller":"*","text":"David","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"*","text":"Abraham","reference":{"chapter":1,"verse":1}},{"noteId":2,"caller":"*","text":"Isaac","reference":{"chapter":1,"verse":2}},{"noteId":3,"caller":"*","text":"Jacob","reference":{"chapter":1,"verse":2}},{"noteId":4,"caller":"*","text":"Judah","reference":{"chapter":1,"verse":2}},{"noteId":5,"caller":"*","text":"Perez","reference":{"chapter":1,"verse":3}},{"noteId":6,"caller":"*","text":"Zerah","reference":{"chapter":1,"verse":3}},{"noteId":7,"caller":"*","text":"Tamar","reference":{"chapter":1,"verse":3}},{"noteId":8,"caller":"*","text":"Perez","reference":{"chapter":1,"verse":3}},{"noteId":9,"caller":"*","text":"Hezron","reference":{"chapter":1,"verse":3}},{"noteId":10,"caller":"*","text":"Ram","reference":{"chapter":1,"verse":3}},{"noteId":11,"caller":"*","text":"Amminadab","reference":{"chapter":1,"verse":4}},{"noteId":12,"caller":"*","text":"Nahshon","reference":{"chapter":1,"verse":4}},{"noteId":13,"caller":"*","text":"Salmon","reference":{"chapter":1,"verse":4}},{"noteId":14,"caller":"*","text":"Boaz","reference":{"chapter":1,"verse":5}},{"noteId":15,"caller":"*","text":"Rahab","reference":{"chapter":1,"verse":5}},{"noteId":16,"caller":"*","text":"Obed","reference":{"chapter":1,"verse":5}},{"noteId":17,"caller":"*","text":"Jesse","reference":{"chapter":1,"verse":5}},{"noteId":18,"caller":"*","text":"David","reference":{"chapter":1,"verse":6}},{"noteId":19,"caller":"*","text":"Solomon","reference":{"chapter":1,"verse":6}},{"noteId":20,"caller":"*","text":"Bathsheba","reference":{"chapter":1,"verse":6}},{"noteId":21,"caller":"*","text":"Uriah","reference":{"chapter":1,"verse":6}},{"noteId":22,"caller":"*","text":"Rehoboam","reference":{"chapter":1,"verse":7}},{"noteId":23,"caller":"*","text":"Abijah","reference":{"chapter":1,"verse":7}},{"noteId":24,"caller":"*","text":"Asa","reference":{"chapter":1,"verse":7}},{"noteId":25,"caller":"*","text":"Jehoshaphat","reference":{"chapter":1,"verse":8}},{"noteId":26,"caller":"*","text":"Jehoram","reference":{"chapter":1,"verse":8}},{"noteId":27,"cal