{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"HOS","translationId":"dop_sim","name":"Osee","commonName":"Osee","title":"ƖSƆ KƲYƆƔƆTƲTƲ TƐLƎSƲLƲ OSEE TƆM TAKƎLAƔA","order":28,"numberOfChapters":14,"sha256":"6497605d8db969def55b61e4630c8894bc96751f0cbb6b2eed40a1fad3b66892","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/dop_sim/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"heading","content":["Ɩsɛɣɛlɩ nyǝ́mɑ kɑɑnɩɩtʋ nɑ Ɩsɔ sɔɔlʋɣʋ"]},{"type":"verse","number":1,"content":["Ḿpʋ́ɣʋ́ Tɑcɑɑ tɔmɑ sɩ:",{"text":"Wɑɑtʋ wei Ɩsɛɣɛlɩ n kɑ kɛ́ ɩfepu tɔ,","poem":1},{"lineBreak":true},{"text":"mɑɑ sɔɔlɑ-ŋ kɛ́.","poem":1},{"lineBreak":true},{"text":"Hɑlǝnɑ mɑ́ yɑɑ-ŋ mɑ pǝyɑɣɑ,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ lǝsɩ-ŋ Icipiti tɑɑ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mɑ tɔŋnɑ-ŋ yɑɑʋ,","poem":1},{"lineBreak":true},{"text":"ɩlɛnɑ nyɑɑ seeki-m nɑ ń lɑɑkɩ Pɑɑlɩ nɑ tɩɩŋ lɛlǝŋ.","poem":1},{"lineBreak":true},{"text":"Ɩlɛnɑ n wɔkɩ-ɩ kɔtɑɣɑ tulɑɑlʋ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pǝyele mɑ́ tɔkǝnɑ nyɑ́ niŋ nɑ mɑ́ hɔ-ŋ tɑɑtɑɑ.","poem":1},{"lineBreak":true},{"text":"Amɑ n tɑ nyǝnnɑ tǝnɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mɑ sɔɔlɑ-ŋ kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ pɑɑsǝnɑ-ŋ tǝpɑmm,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ wɑɣɑlǝɣɩ-ŋ,","poem":1},{"lineBreak":true},{"text":"ɩsɩɩ cɛcɛ lɑkʋɣʋ ɩ pǝyɑɣɑ tɔ.","poem":1},{"lineBreak":true},{"text":"Mɑ sopɑ nyɑ́ tɛɛ,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ hɑɑkɩ-ŋ tɔɣɔnɑɣɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Icipiti nyǝ́mɑ kɑɑ tɑsɑ-mɛɣɛ yomle kpɑʋ yɑɑ.","poem":1},{"lineBreak":true},{"text":"Amɑ Asilii nyǝ́mɑ kɑ́ ŋmɑkǝlǝnɑ-mɛɣɛ","poem":1},{"lineBreak":true},{"text":"timpi ɩ́ kisɑ mɑ kiŋ kɛ kɔntɛ tɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pǝ tɔɔ kɛ́ yoou kɑ wɛɛ mǝ ɑcɑlɛɛ tɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ kʋ wɑkǝlɩ ɑ kʋkentim.","poem":1},{"lineBreak":true},{"text":"Ɩsɛɣɛlɩ nyǝ́mɑ kʋmɑɣɑsǝm kɑsǝyɑɣɑ ntɛ́.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mɑ yǝlɑɑ cɑɑkɩ-m kisuɣu","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ yɑɑkɩ-wɛ nɑ Ɩsɔ tɔɔ, pɑɑ nɩɩkɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ɩsǝnɑɣɑ mɑɑ pǝsɩ nɑ mɑ́ lɔ Ɩsɛɣɛlɩ nɑ pǝ sɑɑlɩ?","poem":1},{"lineBreak":true},{"text":"Nɑ mɑ́ wɑkǝlɩ-ŋ ɩsɩɩ mɑ lɑpʋ Atǝmɑ,","poem":1},{"lineBreak":true},{"text":"nɑ Sepoyim pǝ ɑcɑlɛɛ tɔ?","poem":1},{"lineBreak":true},{"text":"Tɔfɔ pɩɩ wɑkǝlɩ mɑ lɑŋlɛ nɑ mɑ́ nyɑsɑ mɑ tǝɣɩ kelɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mɑ kɑɑ tɑsɑ Ɩfǝlɑyim nyǝ́mɑ kɛ wɑkǝlʋɣʋ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, mɑ kɛ́ Ɩsɔ Nɑŋŋ tʋ kɛ́,","poem":1},{"lineBreak":true},{"text":"mɑ tɑ kɛ yʋlʋ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ɩsɔ kɑ́ yɑɑ ɩ yǝlɑɑ mpɑ pɑ kuuwɑ","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ tɛɛnɑ hɑtoo teŋku wɑɑlɩ tɔ nɑ pɑ́ kɔɔ.","poem":1},{"lineBreak":true},{"text":"Teitei ɩsɩɩ tɔɣɔlɑɣɑ wiikuɣu nɑ kɑ́ kotiɣi kɑ piyɑ tɔ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɩ́ kɑ lɩɩ Icipiti nɑ Asilii kɛ lɔŋ,","poem":1},{"lineBreak":true},{"text":"ɩsɩɩ sumpɩʋpɩʋ, yɑɑ ɑlukuku kʋlʋɣʋ tɔ.","poem":1},{"lineBreak":true},{"text":"Ɩlɛnɑ mɑ́ mǝŋnɑ-mɛɣɛ mǝ tɛ.","poem":1},{"lineBreak":true},{"text":"Tɑcɑɑ mɑ́, mɑ yɔɣɔtǝnɑ mpʋ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":11}