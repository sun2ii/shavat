{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"HOS","translationId":"dop_sim","name":"Osee","commonName":"Osee","title":"ƖSƆ KƲYƆƔƆTƲTƲ TƐLƎSƲLƲ OSEE TƆM TAKƎLAƔA","order":28,"numberOfChapters":14,"sha256":"6497605d8db969def55b61e4630c8894bc96751f0cbb6b2eed40a1fad3b66892","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/dop_sim/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":["Wɑɑtʋ ɩnǝɣǝlɛ Ɩsɛɣɛlɩ nyǝ́mɑ kɑ́ tɔ sɩ:",{"text":"Tǝ mǝlǝɣɩ Tɑcɑɑ nyɑ́ nyɑ́ tɔɔ.","poem":1},{"lineBreak":true},{"text":"Nyɑ́ kʋnɑ-tʋ.","poem":1},{"lineBreak":true},{"text":"Ɩlɛ n kɑ́ hɔkɔ tɑ hiŋ nɑ ń wɑɑ-tʋ,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"nɑ ń hɑ-tʋɣʋ weesuɣu.","poem":1},{"lineBreak":true},{"text":"Pǝ kɑɑsɑ kʋyɛɛŋ nɑɑlɛ,","poem":1},{"lineBreak":true},{"text":"ɩlɛnɑ ń kʋsɩ-tʋɣʋ tooso nyǝŋkʋ tɑɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mpʋ tɔ, tǝ sɛɛsɩ ɩsǝlɛ kɛ teu nɑ tǝ́ nyɩ Tɑcɑɑ.","poem":1},{"lineBreak":true},{"text":"Ɩsɩɩ ilim lɩɩkʋɣʋ tɑnɑŋ nɑ tɛʋ nɑ́ɑ́ nɩɩ toomɑɣɑ tɔ.","poem":1},{"lineBreak":true},{"text":"Mpʋ tɔtɔɣɔ Tɑcɑɑ sǝnɑʋ tɔm wɛ nɑɑni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wɑɑtʋ ɩnǝɣɩ Tɑcɑɑ kɑ́ pɔɔsɩ ɩ tɩ sɩ:","poem":1},{"lineBreak":true},{"text":"Ɩsǝnɑɣɑ mɑɑ tɛnɑ Yutɑ nɑ Ɩsɛɣɛlɩ pɑ tɔm?","poem":1},{"lineBreak":true},{"text":"Anɩ pɑ luɣu ɩɩ lɑɑ-m lɩɩʋ kɛ́ ɩsɩɩ tɑnɑŋ ɩhunte,","poem":1},{"lineBreak":true},{"text":"yɑɑ cɔlɔʋ sɑɑlʋɣʋ tɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pǝ tɔɔ kɛ́ mɑ yookinɑ-wɛ nɑ","poem":1},{"lineBreak":true},{"text":"Ɩsɔ kʋyɔɣɔtʋtʋ tɛlǝsǝlɑɑ wɑɑsʋ.","poem":1},{"lineBreak":true},{"text":"Mɑ kpɑɑlǝɣɩ-wɛ sɩ pɑɑ kʋ mǝ tǝnɑ.","poem":1},{"lineBreak":true},{"text":"Mɑ kʋsɔɔlǝm nɑɑ teu kɛ́ tǝcɛɩcɛɩ ɩsɩɩ ilim.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mɑ cɑɑ kɛ́ sɩ yǝlɑɑ ɩ́ nyɩ-m nɑ pɑ́ lɑkɩ kʋpɑntʋ.","poem":1},{"lineBreak":true},{"text":"Pǝlɛ pǝ kǝlɑ kɔtɑsɩ nsi kɔkɔ lusɑ sɩ tǝnɑ tɔ.","poem":1}]},{"type":"heading","content":["Ɩsɛɣɛlɩ tɑɑ ɑcɑɑlǝtʋ"]},{"type":"verse","number":7,"content":[{"text":"Teitei ɩsɩɩ yǝlɑɑ tǝnɑ lɑpʋ tɔ,","poem":1},{"lineBreak":true},{"text":"ḿpʋ́ɣʋ́ mǝ tɑ tɔkɩ ɩsǝnɑ","poem":1},{"lineBreak":true},{"text":"ɩ́ kɑ́ sɩɩ mǝ nɔɔsɩ tɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kɑlɑɑtɩ nɑ́ kɛ́ ɑsɑɣɑɑ ɩcɑtɛ kɛ,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ kʋɣɩ yǝlɑɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kɔtǝlɑɑ kpekǝle nɑ́ pǝsɑ yʋlʋkʋlɑɑ kɛ́.","poem":1},{"lineBreak":true},{"text":"Pɑ cɛŋǝɣɩ yǝlɑɑ kɛ Sikɛm mpɑɑʋ tɑɑ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, pɑ hɑ pɑ tǝɣɩ kɑwɑlɑɣɑ tɑɑ kɛ́.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mɑ nɑwɑ ɑcɑɑlǝtʋ kɛ Ɩsɛɣɛlɩ piitim tɑɑ.","poem":1},{"lineBreak":true},{"text":"Tɩɩŋ kɛ pɑ lɑɑkɩ nɑ pɑ́ pilisiɣi tǝmɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Pǝ kɑɑsɑ Yutɑ nyǝ́mɑ tɔ,","poem":1},{"lineBreak":true},{"text":"mɑ tʋ mǝ hʋʋlɛ pǝlɛ kɛ́.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}