{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"HOS","translationId":"dop_sim","name":"Osee","commonName":"Osee","title":"ƖSƆ KƲYƆƔƆTƲTƲ TƐLƎSƲLƲ OSEE TƆM TAKƎLAƔA","order":28,"numberOfChapters":14,"sha256":"6497605d8db969def55b61e4630c8894bc96751f0cbb6b2eed40a1fad3b66892","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/dop_sim/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["Ye Yʋlʋ tuu heelim, kɑcuculɑɣɑ kɛ ɩ kʋŋ"]},{"type":"verse","number":1,"content":["Ḿpʋ́ɣʋ́ Tɑcɑɑ tɔmɑ sɩ:",{"text":"Ɩ́ hʋlɩ ɑpɑlʋtutuɣu.","poem":1},{"lineBreak":true},{"text":"Kolontu tii mɑ tɛtʋ tɔɔ kɛ́ ɩsɩɩ yepeleku.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, Ɩsɛɣɛlɩ nyǝ́mɑ ɩ́ yɔkɑ mɑ kiiu,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ wɑkǝlɩ mɑ́ nɑ-mɛ tɑ́ nɔɣɔ pɛɛlʋɣʋ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɩlɛnɑ ɩ́ wiinɑ-m sɩ,","poem":1},{"lineBreak":true},{"text":"mɛɣɛ Ɩsɛɣɛlɩ nyǝ́mɑ,","poem":1},{"lineBreak":true},{"text":"ɩ́ nyǝmɑ-m sɩ mɑɣɑ mǝ Ɩsɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɩ́ lɔwɑ tɑmpɑnɑ tɔɣɔ","poem":1},{"lineBreak":true},{"text":"kolontu kɑ tɔɣɔnɩ-mɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɩ́ kpɑɑkɩ ɑwulɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ wɑɑlɩ nyǝ́mɑ,","poem":1},{"lineBreak":true},{"text":"ɩɩ pɔɔsǝɣɩ-m nɑtǝlɩ.","poem":1},{"lineBreak":true},{"text":"Mǝ liɣitee nɑ mǝ wʋlɑnɑɑ kɛ","poem":1},{"lineBreak":true},{"text":"ɩ́ kpɑkǝɣɩ nɑ ɩ́ lɔɔkɩ yem sɩ,","poem":1},{"lineBreak":true},{"text":"ɩ́ luki tɩɩŋ.","poem":1},{"lineBreak":true},{"text":"Pǝ tɔɔ kɛ́ pɑɑ wɑkǝlɩ-mɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sɑmɑlii nyǝ́mɑ mɛ,","poem":1},{"lineBreak":true},{"text":"ɩ lɔ mǝ wʋlɑ nɑʋle.","poem":1},{"lineBreak":true},{"text":"Ɩ́ kpɑɑsǝɣɩ mɑ pɑ́ɑ́nɑ́ kɛ́.","poem":1},{"lineBreak":true},{"text":"Wɑɑtʋ wei kɛ́ ɩ́ kɑ́ yele ɩsɑɣɑtʋ","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ yele-mɛɣɛ kɑlǝnɑʋ?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɩsɛɣɛlɩ koolu lɑpǝnɑ mǝ nɑʋle ńtɛ́.","poem":1},{"lineBreak":true},{"text":"Tǝ fɛɩnɑ Ɩsɔ pʋlʋpʋ.","poem":1},{"lineBreak":true},{"text":"Pǝ tɔɔ kɛ́ tɩɩ yɔkɩ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Timpi ɩ́ tuukuɣu heelim tɔ,","poem":1},{"lineBreak":true},{"text":"ɩsɩɩ ɩ kʋmɑ kɑcuculɑɣɑ.","poem":1},{"lineBreak":true},{"text":"Teitei ɩsɩɩ pɑ tukuɣu ɩtuule tɔ sɩ:","poem":1},{"lineBreak":true},{"text":"Ye tɔɣɔnɑɣɑ tɑ tʋ nyɔɔŋ mʋlʋm fɛɩ.","poem":1},{"lineBreak":true},{"text":"Pɑɑ mʋlʋm tɩɩ wɛɛ, cɑɣɑlɑɑ kɑ́ tɔɣɔnɑ-wɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ɩsɛɣɛlɩ nyǝ́mɑ mɛ,","poem":1},{"lineBreak":true},{"text":"mǝ tɔm tɛmɑ.","poem":1},{"lineBreak":true},{"text":"Ɩ wɛ piitimnɑɑ tɑɑ kɛ́ ɩsɩɩ","poem":1},{"lineBreak":true},{"text":"tiyɑɣɑ ŋkɑ pɑɑ lɑkǝnɑ tɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pepe tɔɔ kɛ́ ɩ́ polɑ Asilii,","poem":1},{"lineBreak":true},{"text":"ɩsɩɩ tɑɑlɛ kpɑŋɑɣɑ ŋkɑ kɑ yɛlǝɣɩ kɑ tɩ tɔɔ tɔ,","poem":1},{"lineBreak":true},{"text":"sɩ pɑ́ wɑɑsɩ-mɛ?","poem":1},{"lineBreak":true},{"text":"Hɑlǝnɑ ɩ́ hɑ kʋhɑɑŋ sɩ ɩ́ hiki cewɑɑ?","poem":1},{"lineBreak":true},{"text":"Ɩ́ tɑ́ kisi ŋmɑkǝlʋɣʋ,","poem":1},{"lineBreak":true},{"text":"ɩsɩɩ tɑɑlɛ kpɑŋɑsɩ suwe?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pɑɑ ɩ hɑɑkɩ lɛlɑɑ kɛ kʋhɑɑŋ tɔ,","poem":1},{"lineBreak":true},{"text":"mǝ kpeɣeluɣu wɑɑtʋ kɔmnɑ ntɔ.","poem":1},{"lineBreak":true},{"text":"Pǝ kɑɑsɑ pǝcɔ, ɩ́ kɑ́ tɔɣɔ wɑhɑlɑ,","poem":1},{"lineBreak":true},{"text":"nɑ sǝɣǝlɑ nnɑ wulɑʋ sɔsɔ kɑ́ sʋkɩ-mɛ tɔ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɩ́ ŋmɑwɑ kɔtɑɣɑ tǝlɑtɛnɑɑ kɛ sɔsɔm sɩ ɩ́ pǝntǝɣɩ.","poem":1},{"lineBreak":true},{"text":"Mǝ kɔtɑsɩ tǝlɑtɛnɑɑ yelinɑ nɑ ɩ́ pǝntǝɣɩ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Pɑɑ mɑɑ ŋmɑɑ-mɛɣɛ lɑɣɑtʋ","poem":1},{"lineBreak":true},{"text":"tɑsʋɣʋnɑɑ kɛ tɔm ɩsǝnɑ,","poem":1},{"lineBreak":true},{"text":"ɩ́ kɑɑ pɑɑsǝnɑ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Luluɣu tɔɔ kɛ́ ɩ́ lɑkɩ mǝ kɔtɑsɩ.","poem":1},{"lineBreak":true},{"text":"Amɑ mɑɑ mʋɣɩ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, mɑɑ sɔɔkɩ mǝ ɩsɑɣɑtʋ tɔɔ.","poem":1},{"lineBreak":true},{"text":"Ɩsɩɩ mɑ ponɑ-mɛɣɛ Icipiti nɑ pǝ́ hɔ mǝ ŋkpɑŋʋɣʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ɩsɛɣɛlɩ nyǝ́mɑ mɛ,","poem":1},{"lineBreak":true},{"text":"ɩ́ sɔɔwɑ mǝ ŋmɑlʋ tɔɔ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ ŋmɑ mǝ tǝɣɩ kutuluŋ kʋpɑŋ.","poem":1},{"lineBreak":true},{"text":"Yutɑ nyǝ́mɑ nɑ́ ŋmɑ koloosi nɑ pɑ́ cɔɔnɑ ɑcɑlɛɛ tuutuumɑ.","poem":1},{"lineBreak":true},{"text":"Amɑ ɩsɩɩ mɑ wɔpɑ mǝ ɑcɑlɛɛ nɑ mǝ kutuluŋ kʋpɑŋ kɛ kɔkɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}