{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"ISA","translationId":"dop_sim","name":"Ɩsɑyii","commonName":"Ɩsɑyii","title":"ƖSƆ KƲYƆƔƆTƲTƲ TƐLƎSƲLƲ ƖSAYII TƆM TAKƎLAƔA","order":23,"numberOfChapters":44,"sha256":"5f5fa4b399ce778364af09443d04dc25c62bdb5d4c94777749123d14d3ef4b77","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/ISA/1.json","lastChapterNumber":44,"lastChapterApiLink":"/api/dop_sim/ISA/44.json","totalNumberOfVerses":891},"chapter":{"number":12,"content":[{"type":"heading","content":["Ɩsɔ sɑmtʋ yontu"]},{"type":"verse","number":1,"content":["Kʋyɑkʋ ŋkʋɣʋ ɩ́ kɑ́ sɑ Tɑcɑɑ nɑ yontu sɩ:",{"text":"Hɑɩ, Tɑcɑɑ tǝ sɑmɑ-ŋ.","poem":1},{"lineBreak":true},{"text":"Nyɑ́ pɑ́ɑ́nɑ́ mʋnɑɑ kɛ́. Amɑ n kʋ-yɛɣɛ tɑ́ tɔɔ.","poem":1},{"lineBreak":true},{"text":"Hɛɛsɩ tɑ́ lɑŋɑ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɩsɔ nyɑɣɑlɛ tɑ́ nyʋɣʋ yɑ́tʋ́.","poem":1},{"lineBreak":true},{"text":"Tɩɩ tʋ-ŋ nɑɑni kɛ́.","poem":1},{"lineBreak":true},{"text":"Sɔɣɔntʋ kɑɑ kpɑ-tʋ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, Tɑcɑɑ nyɑɣɑlɛ tɑ́ toŋ, nɑ tǝ́ sɑŋɩ-ŋ.","poem":1},{"lineBreak":true},{"text":"Nyɑɣɑlɛ tɑ́ wɑɑsʋlʋ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tɩɩ lu lʋm nɑ lɑŋhʋlʋmlɛ kɛ","poem":1},{"lineBreak":true},{"text":"nyʋɣʋ yɑpʋ sɛɛlʋ tɑɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kʋyɑkʋ ŋkʋ kʋ wule ɩ́ kɑ́ yɔɣɔtɩ sɩ:","poem":1},{"lineBreak":true},{"text":"Ɩ́ sɑ Tɑcɑɑ, ɩ yɑɑ ɩ hǝtɛ.","poem":1},{"lineBreak":true},{"text":"Ɩ́ kpɑɑlɩ yǝlɑɑ tɑɑ kɛ́ ɩ tǝmɑ tɔm.","poem":1},{"lineBreak":true},{"text":"Ɩ́ tɔɔsɩ pɑ tǝnɑ sɩ Ɩsɔ hǝtɛ ntɛ́ sɔsɔɔlɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɩ́ sɑ Tɑcɑɑ nɑ mǝ yontu.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, Tɑcɑɑ lɑpɑ tǝmɑ sɔsɔɔnɑ kɛ́.","poem":1},{"lineBreak":true},{"text":"Pǝ wɛɛ sɩ pɑ́ lɑ nɑ ɑntulinyɑ tǝnɑ nyɩ mpʋ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Siyɔŋ nyǝ́mɑ mɛ ɩ́ wilitinɑ lɑŋhʋlʋmlɛ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, Ɩsɛɣɛlɩ Ɩsɔ Nɑŋŋ tʋ wei ɩ́ wɛnɑ tɔ,","poem":1},{"lineBreak":true},{"text":"ɩ kɛ́ sɔsɔ kɛ́.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}