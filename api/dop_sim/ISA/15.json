{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"ISA","translationId":"dop_sim","name":"Ɩsɑyii","commonName":"Ɩsɑyii","title":"ƖSƆ KƲYƆƔƆTƲTƲ TƐLƎSƲLƲ ƖSAYII TƆM TAKƎLAƔA","order":23,"numberOfChapters":44,"sha256":"5f5fa4b399ce778364af09443d04dc25c62bdb5d4c94777749123d14d3ef4b77","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/ISA/1.json","lastChapterNumber":44,"lastChapterApiLink":"/api/dop_sim/ISA/44.json","totalNumberOfVerses":891},"chapter":{"number":15,"content":[{"type":"heading","content":["Mowɑpʋ nyǝ́mɑ tɔɔ wulɑ"]},{"type":"verse","number":1,"content":["Mowɑpʋ nyǝ́mɑ tɔɔ kʋyɔɣɔtʋtʋ ntɔ:",{"text":"Pɑ yɔkɑ Aɑɑ-Mowɑpʋ ɩcɑtɛ","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ kpiisi-tɛɣɛ ɑhoo kʋlʋmɛɛ.","poem":1},{"lineBreak":true},{"text":"Pɑ yɔkɑ Kii-Mowɑpʋ ɩcɑtɛ","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ kpiisi-tɛ tɔtɔɣɔ ɑhoo kʋlʋmɛɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tipɔŋ nyǝ́mɑ kpɑ tǝfɛɛnlɛ sɩ pɑ wiiki.","poem":1},{"lineBreak":true},{"text":"Mowɑpʋ nyǝ́mɑ tʋlɑ nɔɔsɩ kɛ Nepo pʋɣʋ tɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ Mɑtepɑ ɩcɑtɛ tɑɑ. Pɑ loolɑ pɑ nyɔɔŋ nɑ pɑ tɑntǝŋ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yǝlɑɑ suu lǝyɑɣɑ wontu,","poem":1},{"lineBreak":true},{"text":"ɩsɩɩ fɔlǝtɔnɑɑ tɑkɑ kɛ hɑpɛɛ tɔɔ.","poem":1},{"lineBreak":true},{"text":"Pɑ lukiɣi ɩsǝlʋm kɛ kutuluŋ pɑtɑnɑɑ tɔɔ","poem":1},{"lineBreak":true},{"text":"nɑ nɔnɔɔsɩ tɛɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hɛsǝpɔŋ nyǝ́mɑ nɑ Ɩlɑle nyǝ́mɑ pɑ mɑkɩ kɑpusi","poem":1},{"lineBreak":true},{"text":"nɑ Yɑhɑsɩ nyǝ́mɑ nɑ́ɑ́ nɩɩkɩ.","poem":1},{"lineBreak":true},{"text":"Pǝ kpɛnnɑ Mowɑpʋ yoolɑɑ","poem":1},{"lineBreak":true},{"text":"nɑ pɑ ɑpɑlʋtʋ le, nɑ pɑ huɣutiɣi lotu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mɑ yɑɑwɑ sɩ pɑ́ wɑɑsɩ Mowɑpʋ nyǝ́mɑ.","poem":1},{"lineBreak":true},{"text":"Pɑ sewɑ hɑlǝnɑ pɑ́ tɑlɑ Sʋwɑɑ nɑ Ɩkǝlɑ-Selisiyɑ.","poem":1},{"lineBreak":true},{"text":"Pɑ kpɑɑkɩ Luhiti tontoŋle nɑ wulɑ.","poem":1},{"lineBreak":true},{"text":"Pɑ cɑsǝɣɩ lɑŋwɑkǝllɛ kɑpusi kɛ Holonɑyim mpɑɑʋ tɑɑ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nimlim hite lʋm nyɔɔwɑ.","poem":1},{"lineBreak":true},{"text":"Nyɩɩtʋ lʋm nyǝntʋ wʋlɑ tǝ tǝnɑ.","poem":1},{"lineBreak":true},{"text":"Pʋlʋpʋ ɩɩ tɑsǝɣɩ nyɔʋ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pǝ tɔɔ kɛ́ pɑ kuuki pɑ nyǝm mpi pǝ kɑɑsɑ-wɛ tɔ,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ pukinɑ hɑtoo tɩɩŋ kɑcǝkɑ wɑɑlɩ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mowɑpʋ nyǝ́mɑ kɑpusi nɩɩkɩ","poem":1},{"lineBreak":true},{"text":"pɑɑ timpiɣi pɑ tɛtʋ tɑɑ kɛ́.","poem":1},{"lineBreak":true},{"text":"Hɑlǝnɑ pǝ́ tɑlɑ Ɩkǝlɑyim ɩcɑtɛ","poem":1},{"lineBreak":true},{"text":"nɑ Ɩliim tɛtʋ tɑɑ lɔkɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Timɔŋ ɩcɑtɛ pusi lʋm wɛ kɛ́ ɩsɩɩ cɑlǝm.","poem":1},{"lineBreak":true},{"text":"Pǝ́cɔ́ ɩ kɑ́ tɑsɑ-wɛɣɛ wɑhɑlɑ tʋɣʋ tɔtɔ.","poem":1},{"lineBreak":true},{"text":"Ɩ kɑ́ yele nɑ tɔɣɔlɑɣɑ kʋlɩ","poem":1},{"lineBreak":true},{"text":"Mowɑpʋ yǝlɑɑ kɑkɑɑsɑɣɑ tɔɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_