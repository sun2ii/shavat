{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"JOB","translationId":"dop_sim","name":"Soopu","commonName":"Soopu","title":"SOOPU TƆM TAKƎLAƔA","order":18,"numberOfChapters":42,"sha256":"08cf53646b8b739776d1c986c451e32b9a1d12585acb9401ba341c23010b9006","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/dop_sim/JOB/42.json","totalNumberOfVerses":1063},"chapter":{"number":10,"content":[{"type":"heading","content":["Soopu kʋyɔɣɔtʋtʋ tɔtɔ"]},{"type":"verse","number":1,"content":[{"text":"Soopu sɩ: Weesuɣu lɩɩ-m sɔŋ kɛ́.","poem":1},{"lineBreak":true},{"text":"Mɑɑ wii mɑ tɩ tɔm.","poem":1},{"lineBreak":true},{"text":"Mɑ lɑŋlɛ kǝlɑ wɑkǝlʋɣʋ, mɑ kɑɑ tɑsɑ sum.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɩsɔ, mɑɑ heeli-ŋ sɩ, tɑɑ kʋ mɑ tɔm.","poem":1},{"lineBreak":true},{"text":"Amɑ heeli-m mpi pǝ tɔɔ n yookinɑ-m tɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pǝ wɛ-ŋ teu sɩ ń ŋmɑkǝlɩ","poem":1},{"lineBreak":true},{"text":"mɑ́ wei n ŋmɑwɑ tɔ,","poem":1},{"lineBreak":true},{"text":"nɑ ń yele nɑ pǝ́ lɑnɑ ɑsɑɣɑɑ nɑ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Anɩ n nɑɑkɩ nɑ pǝ́ kǝlɩ yǝlɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ń mɑɣɑsǝɣɩ nɑ pǝ́ kǝlǝɣɩ-wɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɩsɔ nyɑ́ weesuɣu topilɑ ɩsɩɩ yʋlʋ nyǝŋkʋ kɛ?","poem":1},{"lineBreak":true},{"text":"Yɑɑ nyɑ́ pɩɩsɩ tɛɛkɩ ɩsɩɩ yʋlʋ pǝyɑɣɑ nyǝnsɩ?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pepe tɔɔ kɛ́ n pɛɛkǝɣɩ mɑ tɑsǝkǝlɛ","poem":1},{"lineBreak":true},{"text":"nɑ ń feŋiɣi sɩ ń kuli mɑ ɩsɑɣɑtʋ tɔɔ?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Anɩ n nyǝmɑ́ sɩ mɑ tɑ wɑkǝlɩ,","poem":1},{"lineBreak":true},{"text":"pǝ́cɔ́ nɔɣɔlʋ kɑɑ yɑ-m nyɑ́ niŋ tɑɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nyɑ́ niŋ ŋmɑnɑ mɑ tǝnɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ń cɑɑ sɩ n wɑkǝlǝɣɩ-m.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ɩsɔ tɔɔsɩ sɩ, nyɑ́ ŋmɑnɑ-m, ɩsɩɩ cʋɣʋ.","poem":1},{"lineBreak":true},{"text":"Ɩlɛ n kɑ́ tɑɣɑnɩ-m yɔkʋɣʋ nɑ mɑ́ pǝsɩ mʋsʋɣʋ nɑ?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nyɑ́ ŋmɑɣɑnɑ-m mɑ too tɑɑ,","poem":1},{"lineBreak":true},{"text":"ɩsɩɩ nɑɑlǝm kiikuɣu fulɑɣɑ tɑɑ tɔ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nyɑ́ lɑpǝnɑ-m mʋwɑ nɑ holɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ń wɑɑsɩ pǝ tɔɔ kɛ́ nɑntʋ, nɑ ń suu-m tɔnʋɣʋ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ɩlɛnɑ ń lɑ-m pɛɛlɛɛ,","poem":1},{"lineBreak":true},{"text":"nɑ ń hɑ-m weesuɣu nɑ ń feŋiɣi kʋ tɔɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Amɑ mɑ nyǝmɑ́ nyɑ́ lǝmɑɣɑsɛɛ wenɑ","poem":1},{"lineBreak":true},{"text":"n kɑ ŋmɛsɑ nyɑ́ lotu tɑɑ tɔ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N feŋiɣi kɛ́ sɩ, ye n nɑwɑ mɑ wɑkǝlɑɑ","poem":1},{"lineBreak":true},{"text":"ɩlɛ n kisi-m suulu hʋ́lʋ́ɣʋ́.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ye mɑ wɑkǝlǝnɑ-ŋ mɑ lepɑɣɑ,","poem":1},{"lineBreak":true},{"text":"pɑɑ mɑ tɔm tewɑ, nyʋɣʋ kɑmɑ ḿpʋ́ɣʋ́.","poem":1},{"lineBreak":true},{"text":"Nɑ wɑhɑlɑ nɩɩ-m nɑ fɛɛlɛ kʋɣʋ-m.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ye mɑ kʋsɑ nyʋɣʋ ɩlɛ n tʋ mɑ wɑɑlɩ,","poem":1},{"lineBreak":true},{"text":"ɩsɩɩ tɔɣɔlɑɣɑ, nɑ ń kʋlǝɣɩ mɑ tɔɔ nɑ piti tǝmɑ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nɑ ń kɔŋnɑ-m ɑseetɑ nyǝ́mɑ","poem":1},{"lineBreak":true},{"text":"mpɑ pɑɑ cɑɑkɩ-m tɔ, nɑ nyɑ́ pɑ́ɑ́nɑ́ sɔɔsǝɣɩ mɑ tɔɔ.","poem":1},{"lineBreak":true},{"text":"Nɑ ń kpɛtǝlǝɣɩ-m nɑ wɑhɑlɑnɑɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Pepe tɔɔ kɛ́ Ɩsɔ lǝsɑ-m mɑ too lotu tɑɑ?","poem":1},{"lineBreak":true},{"text":"Ɩsǝntɔ mɑɑ sǝpɑ nɔɣɔlʋ tɑ nɑ-m.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Pɑɑ tɛɛnɑ pǝlɑɑʋ tɑɑ kɛ́ kpɑkpɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ pǝ́ wɛɛ ɩsɩɩ pɑ tɑ lʋlɩ-m.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mɑ weesuɣu kʋyɛɛŋ kɑɑsɑ-m pǝ́cɔ́ tike ntɔ.","poem":1},{"lineBreak":true},{"text":"Ɩlɛ Ɩsɔ, yele-m mpʋ nɑ mɑ́","poem":1},{"lineBreak":true},{"text":"yɔɔlǝnɑ wɛɛ pǝ́cɔ́ wei ɩ kɑɑsɑ-m tɔ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ɩlɛnɑ pǝ́cɔ́ mɑ́ polo ɑtɛtǝlɛ tɑɑ.","poem":1},{"lineBreak":true},{"text":"Mɑ kɑɑ tɑsɑ mǝlʋɣʋ kɛ cǝnɛ.","poem":1},{"lineBreak":true},{"text":"Tɛtʋ ntɩ tǝ tɑɑ kɛ́ sǝkpɛtʋɣʋ ɑnɑɑm wɛɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Sǝkpɛtʋɣʋ tɛtʋ wɛɛ kɛ́ ɩsɩɩ ɑhoo.","poem":1},{"lineBreak":true},{"text":"Ɩsotom sɔsɔɔm kɛ́, pʋlʋ tɑ tǝŋ.","poem":1},{"lineBreak":true},{"text":"Ɩlɛnɑ nyɑɑlǝm nɑ́ɑ́ wɛɛ ɩsɩɩ pǝ yukuɣu tɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/JOB/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/JOB/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/JOB/9.json","previousChapterAudioLinks":{},"numberOfVerses":22}