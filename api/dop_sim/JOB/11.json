{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"JOB","translationId":"dop_sim","name":"Soopu","commonName":"Soopu","title":"SOOPU TƆM TAKƎLAƔA","order":18,"numberOfChapters":42,"sha256":"08cf53646b8b739776d1c986c451e32b9a1d12585acb9401ba341c23010b9006","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/dop_sim/JOB/42.json","totalNumberOfVerses":1063},"chapter":{"number":11,"content":[{"type":"heading","content":["Sofɑɑ nyǝntʋ"]},{"type":"verse","number":1,"content":["Ḿpʋ́ɣʋ́ Nɑɑmɑ tʋ Sofɑɑ cɔwɑ Soopu sɩ:"]},{"type":"verse","number":2,"content":[{"text":"Nyɑ́ yɔɣɔtɑɣɑ kɛkɛkɛ tɔɔ, pǝ wɛɛ sɩ mɑ́ cɔ.","poem":1},{"lineBreak":true},{"text":"Pǝ tɑɣɑ yɔɣɔtɑɣɑ nyǝm kɛ yʋlʋ tɔm teekinɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nyɑ́ nɔɔleleŋ ɩɩ tǝkǝɣɩ yǝlɑɑ nɔɔsɩ.","poem":1},{"lineBreak":true},{"text":"N kɑɑ pǝsɩ ń woŋ nɔɣɔlʋ nɑ pɑ́ tɑ́ tʋ-ŋ fɛɛlɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hɑlɩ n tɩɩ yɔɣɔtɑɑ sɩ nyɑ́ tɔm tewɑ,","poem":1},{"lineBreak":true},{"text":"sɩ n tɑ wɑkǝlǝnɑ Ɩsɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Hɑɩ, ye ɩsɩɩ Ɩsɔ kɑ kulɑɣɑɑ","poem":1},{"lineBreak":true},{"text":"nɔɣɔ nɑ ɩ́ tɩɩ yɔɣɔtɩ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hɑlɩ ɩ kɑ hʋlɑ-ŋ ɩ nyǝmtʋ tete.","poem":1},{"lineBreak":true},{"text":"Tǝ tɛɛ yʋlʋ lɑɣɑtʋ tɔɔ.","poem":1},{"lineBreak":true},{"text":"Tǝnɑɣɑ n kɑ nɑwɑ sɩ Ɩsɔ ɩɩ","poem":1},{"lineBreak":true},{"text":"pɔɔsǝɣɩ nyɑ́ ɩsɑɣɑtʋ tǝnɑ tɔɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"N pǝsǝɣɩ nɑ ń mɑɣɑsɩ Ɩsɔ lotu tɑɑ tɔm","poem":1},{"lineBreak":true},{"text":"nɑ ń cɛkǝnɑ Tomɑ tǝnɑ tʋ ɩnɩ ɩ sɔsɔɔntʋ nɑ?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tǝ kǝlɑ ɩsɔtɔnʋɣʋ kɛ kʋŋkʋlʋmǝŋ.","poem":1},{"lineBreak":true},{"text":"Yʋlʋ kɑɑ keesi tǝ tǝnɑɣɑ,","poem":1},{"lineBreak":true},{"text":"tǝ tɛɛ ɑtɛtǝlɛ kɛ lumɑŋ.","poem":1},{"lineBreak":true},{"text":"Yʋlʋ kɑɑ cɛkǝnɑ tǝ tɔm kɛ sɔsɔm.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ɩsɔ sɔsɔɔntʋ ntɩ tǝ kǝlɑ tɛtʋ","poem":1},{"lineBreak":true},{"text":"kɛ tɔɔʋ, nɑ tǝ́ kǝlɩ teŋku kɛ́ wɑŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ye Ɩsɔ kpɑ tɑsǝkǝlɛ tʋ","poem":1},{"lineBreak":true},{"text":"yɑɑ ɩ yɑɑ-ɩ nɔnɔɣɔ, ɑwe kpesiɣinɑ?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pǝ tɑɣɑ pʋlʋ, Ɩsɔ nyǝmɑ́ yʋlʋyemnɑɑ kɛ́.","poem":1},{"lineBreak":true},{"text":"Pǝyele pǝ fɛɩ-ɩ kɑtɛ sɩ ɩ́ nɑ́ pɑ kɑwɑlɑɣɑ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mpi lǝmɑɣɑsɛɛ fɛɩ tʋ kɑ́ hiiki lɑɣɑtʋ tɔ,","poem":1},{"lineBreak":true},{"text":"tɑɑlɛ kpɑŋɑɣɑ lʋlɑ tǝyɑɣɑ nyǝŋkɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Amɑ pǝ kɑɑsʋɣʋ Soopu nyɑ́ tɔ,","poem":1},{"lineBreak":true},{"text":"kɛɛsǝnɑ Ɩsɔ tɔɔ, nɑ ń tɛɣɛ-ɩ niŋ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Hɑtǝlǝnɑ mpi pǝ tɑ siɣisi tɔ.","poem":1},{"lineBreak":true},{"text":"Tɑɑ yele nɑ ɩsɑɣɑtʋ wɛɛ nyɑ́ tǝyɑɣɑ tɑɑ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wɑɑtʋ ɩnǝɣɩ n kɑ́ tɔŋ nɑ ń kʋsɑ nyʋɣʋ.","poem":1},{"lineBreak":true},{"text":"Pʋlʋpʋ kɑɑ kɛɛ-ŋ, yɑɑ pǝ́ lɑ-ŋ sɔɣɔntʋ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ɩlɛnɑ ń sɔɔ nyɑ́ wɑhɑlɑ tɔɔ, ɩsɩɩ lʋm kpemnɑ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wɑɑtʋ ɩnǝɣɩ nyɑ́ weesuɣu kʋyɛɛŋ","poem":1},{"lineBreak":true},{"text":"kɑ́ wɛɛ tǝcɛɩcɛɩ, ɩsɩɩ ilim sikuɣu.","poem":1},{"lineBreak":true},{"text":"Nɑ nyɑ́ sǝkpɛtʋɣʋ cɛ́ ɩsɩɩ pǝ nyɑɑlʋɣʋ tɔ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ɩlɛnɑ ń cɑɣɑnɑ nyɑ́ tɩ nɑ ń tɛɛlǝɣɩ tɔtɔ.","poem":1},{"lineBreak":true},{"text":"N kɑɑ wɛɛnɑ fɛɛlɛ nɑtǝlɩ, nɑ ń tooki teu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nɔɣɔlʋ kɑɑ wɑkǝlɩ nyɑ́ tom.","poem":1},{"lineBreak":true},{"text":"Hɑlɩ yǝlɑɑ pɑɣɑlɛ kɑ́ pɛɛkɩ sɩ ń sǝnɑ-wɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Amɑ ɑsɑɣɑɑ ɩsɛ kɑ́ nyǝŋ kɛ́.","poem":1},{"lineBreak":true},{"text":"Pɑ hɛɛsʋɣʋ kɑ́ sɩɩ tǝnɑɣɑ, nɑ pɑ́ tɑŋɑ sǝm tike.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}