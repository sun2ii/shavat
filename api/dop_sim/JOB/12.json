{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"JOB","translationId":"dop_sim","name":"Soopu","commonName":"Soopu","title":"SOOPU TƆM TAKƎLAƔA","order":18,"numberOfChapters":42,"sha256":"08cf53646b8b739776d1c986c451e32b9a1d12585acb9401ba341c23010b9006","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/dop_sim/JOB/42.json","totalNumberOfVerses":1063},"chapter":{"number":12,"content":[{"type":"heading","content":["Soopu nyǝntʋ"]},{"type":"verse","number":1,"content":["Mpʋɣʋlɛ Soopu cɔwɑ sɩ:"]},{"type":"verse","number":2,"content":[{"text":"Pʋwɛ! Amɑ ɩ́ wɛnɑ yʋlʋ lǝmɑɣɑsɛɛ yoo!","poem":1},{"lineBreak":true},{"text":"Mǝ sǝm wɑɑlɩ, ɑ kɑɑ tɑsɑ wɛɛʋ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mɑ́ mɑɣɑmɑɣɑ mɑ wɛnɑ nyǝmtʋ kɛ","poem":1},{"lineBreak":true},{"text":"ḿpʋ́ɣʋ́ ɩsɩɩ mɛ, ɩ́ tɑ́ tɛɛ-m.","poem":1},{"lineBreak":true},{"text":"Pɑɑ ɑwe nɑ́ pǝsǝɣɩ nɑ ɩ́ yɔɣɔtɩ ɩsɩɩ mɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mɑ pǝsɑ yʋlʋ wei ɩ tɑɑpɑlɑɑ pɑɑkǝnɑ tɔɣɔ.","poem":1},{"lineBreak":true},{"text":"Pǝyele mɑ yɑɑkǝnɑ Ɩsɔ sɩ ɩ́ cɔ-m.","poem":1},{"lineBreak":true},{"text":"Mɑ siɣisɑɑ kɛ́ mɑ fɛɩ kɑwɑlɑɣɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mɛ mpɑ pǝ cɑɣɑnɑɑ tɔ, mǝ footiɣi wɑhɑlɑ tʋ kɛ́.","poem":1},{"lineBreak":true},{"text":"Ḿpʋ́ɣʋ́ pɑ́ tusiɣi wei ɩ cɛŋlǝɣɩ tɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nmɩɩlɑɑ nɑ Ɩsɔ pɑ́ɑ́nɑ́ kpɑɑsǝlɑɑ,","poem":1},{"lineBreak":true},{"text":"cɑɣɑnɑ pɑ tǝɣɩ pɑ tɛɛsɩ tɑɑ kɛ́.","poem":1},{"lineBreak":true},{"text":"Mpɛ pɑ toŋ ntɛ́ pɑ Ɩsɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Pɔɔsɩ sumɑsɩ nɑ tɔlɑ nɑ","poem":1},{"lineBreak":true},{"text":"tiinɑ ɑ kɑ́ sɛɣɛsɩ-ŋ,","poem":1},{"lineBreak":true},{"text":"nɑ tɛtʋ hʋlɩ-ŋ tɔtɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kʋŋmɑŋmɑm mpi pǝ tɑ nyǝnɑ sɩ,","poem":1},{"lineBreak":true},{"text":"Tɑcɑɑ niŋ lɑpǝnɑ pǝ tǝnɑ?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ɩnɩ ɩ tɔkǝnɑ ɩ kʋlɑpǝm tǝnɑ weesuɣu,","poem":1},{"lineBreak":true},{"text":"nɑ yǝlɑɑ tǝnɑ feesiŋ kɛ ɩ niŋ tɑɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ɩsɩɩ ŋkpɑŋʋɣʋ nɩɩkʋɣʋ tɔm kʋyɔɣɔtʋtʋ tɔ,","poem":1},{"lineBreak":true},{"text":"ḿpʋ́ɣʋ́ nɔɣɔ nɑ́ nɩɩkɩ tɔɣɔnɑɣɑ leleŋ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Akpɑtǝlɑɑ nɑ mpɑ pɑ pɩɩsɩ tɔɔwɑ tɔ,","poem":1},{"lineBreak":true},{"text":"pɑ wɛnɑ lǝmɑɣɑsɛɛ nɑ nyǝm kɛ́.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Amɑ Tɑcɑɑ kɛlɛ lǝmɑɣɑsɛɛ nɑ nyǝm mɑɣɑmɑɣɑ tʋ,","poem":1},{"lineBreak":true},{"text":"nɑ lɑɣɑtʋ tɑsʋlʋ nɑ toŋ tʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ye ɩ yɔkɑ mpi, nɔɣɔlʋ kɑɑ ŋmɑ́,","poem":1},{"lineBreak":true},{"text":"ye ɩ tǝkɑ wei, nɔɣɔlʋ kɑɑ tʋlɩ-ɩ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ye ɩ kpɑ tɛʋ, ɩlɛ wʋlɑɣɑ wʋlɩ.","poem":1},{"lineBreak":true},{"text":"Ɩ́ tʋlɑ-kʋ, ɩlɛ lʋm wɑkǝlɩ tɛtʋ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ɩ wɛnɑ tomɑ kɛ́ nɑ ɩ́ nyǝmɑ́ ɑ lɑpǝnɑʋ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ tɔkɑ letɑɑ nɑ mpɑ pɑ tolisiɣi lɛlɑɑ tɔ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ɩ yeki nɑ pɑ́ kuuki tɛtʋ nyʋɣʋ nyǝ́mɑ, nɑ pɑ́ tɛɛkǝnɑ.","poem":1},{"lineBreak":true},{"text":"Ɩ wɑkǝlǝɣɩ hʋʋlɑɑ lǝmɑɣɑsɛɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nɑ ɩ́ cɛkɩ kʋhɔkʋm mpi ɑwulɑɑ kɑ","poem":1},{"lineBreak":true},{"text":"hɔkɑ yǝlɑɑ tɔ, nɑ ɩ́ hɔkǝɣɩ pɑ mɑɣɑmɑɣɑ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ɩ yeki nɑ pɑ́ kuuki kɔtǝlɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ pǝsǝɣɩ toŋtʋnɑɑ mpɑ pǝ cɑɣɑnɑ","poem":1},{"lineBreak":true},{"text":"teu tɔɣɔ kpɛntǝlɑsɩ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ɩ tǝkǝɣɩ nɔɔleleŋ nyǝ́mɑ nɔɔsɩ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ kʋɣɩ ɑkpɑtǝlɑɑ lǝmɑɣɑsɛɛ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ɩ yeki nɑ pɑ́ footiɣi sɔsɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ yɔkǝɣɩ ŋmɑkǝllɑɑ toŋ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ɩ cɛkɩ pɑ sǝkpɛtʋɣʋ ɑnɑɑm kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ kɔnɑ nyɑɑlǝm kɛ ɑtɛtǝlɛ sǝkpɛtʋɣʋ tɑɑ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ɩ yeki kɛ́ nɑ piitimnɑɑ huki,","poem":1},{"lineBreak":true},{"text":"ɩlɛnɑ ɩ́ wɑkǝlɩ-wɛ nɑ ɩ́ yɑsɩ-wɛɣɛ pooluŋ,","poem":1},{"lineBreak":true},{"text":"ɩlɛnɑ ɩ́ kpiisi-wɛ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ɩ kʋɣɩ pɑ nyʋɣʋ nyǝ́mɑ lɑɣɑtʋ,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ cɔɔkɩ yem kɛ́ nyɩɩtʋ tɑɑ,","poem":1},{"lineBreak":true},{"text":"pɑ fɛɩnɑ tǝpote.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Pɑ hɑkǝɣɩ yem kɛ́ sǝkpɛtʋɣʋ tɛɛ,","poem":1},{"lineBreak":true},{"text":"nyɑɑlǝm fɛɩ, nɑ pɑ́ cɛŋlǝɣɩ yem ɩsɩɩ","poem":1},{"lineBreak":true},{"text":"mpɑ sʋlʋm kʋwɑ tɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":24}