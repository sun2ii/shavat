{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"JOB","translationId":"dop_sim","name":"Soopu","commonName":"Soopu","title":"SOOPU TƆM TAKƎLAƔA","order":18,"numberOfChapters":42,"sha256":"08cf53646b8b739776d1c986c451e32b9a1d12585acb9401ba341c23010b9006","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/dop_sim/JOB/42.json","totalNumberOfVerses":1063},"chapter":{"number":13,"content":[{"type":"heading","content":["Soopu nyǝntʋ tɔtɔ"]},{"type":"verse","number":1,"content":[{"text":"Mpʋɣʋlɛ Soopu tɑsɑɑ sɩ: Mɑ tɛmɑ nti","poem":1},{"lineBreak":true},{"text":"mɑ yɔɣɔtǝɣɩ tɔɣɔ nɩɩʋ","poem":1},{"lineBreak":true},{"text":"nɑ mɑ ŋkpɑŋʋɣʋ, nɑ mɑ́ nɑ-tɩ nɑ mɑ ɩsǝpǝle,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ cɛkǝnɑ-tɩ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mɑ mɑɣɑmɑɣɑ mɑ nyǝmɑ́ nti","poem":1},{"lineBreak":true},{"text":"mǝ nyǝmɑ́ mpʋ tɔɣɔ, mǝ tɑ́ tɛɛ-m.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Amɑ Tomɑ tǝnɑ tʋ Ɩsɔ kɛ́ mɑ yɔɣɔtǝɣǝnɑ","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ hʋlǝɣɩ-ɩ mɑ kʋnyɔŋ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mǝ kɛ́ ɑcɛsɑɑcɛsɑɑ fɛtɑɑ kɛ́,","poem":1},{"lineBreak":true},{"text":"pɔpɔtʋ tike kɛ ɩ́ mɑɣɑsǝɣɩ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ye ɩ́ kɑ sumɑ, ɩ́ kɑ nǝɣǝsǝnɑ","poem":1},{"lineBreak":true},{"text":"lǝmɑɣɑsɛɛ nyǝ́mɑ ntɛ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ɩ́ ke ŋkpɑŋŋ nɑ ɩ́ nɩɩ","poem":1},{"lineBreak":true},{"text":"mɑ́ kʋnyɔwiinɑ nɑ mɑ kʋyɔɣɔtʋtʋ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kɑloolɑɣɑ nɑ tɔm kʋkɛkɛɛtʋ","poem":1},{"lineBreak":true},{"text":"kɛ ɩ́ kɑ́ sɛɛnɑ Ɩsɔ tɔɔ?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɩsɔ tɔɔ kɛ́ mǝ cɑɑkɩ sɩ ɩ́ sɛɛnɑ?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nɑ ye ɩ feŋɑ-mɛ ɩ kɑ́ sɑ-mɛ?","poem":1},{"lineBreak":true},{"text":"Ɩsɔ tɑ́ kɛ́ yʋlʋ sɩ pɑ puɣusiɣi-ɩ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ye mukɑɣɑ tɛɛ kɛ́ ɩ́","poem":1},{"lineBreak":true},{"text":"sɛɛkǝnɑ ɩ tɔɔ, ɩsɩɩ ɩ kɑlǝnɑ-mɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɩ sɔsɔɔntʋ ɩɩ tilisiɣi mǝ pʋntʋ nɑ","poem":1},{"lineBreak":true},{"text":"ɩ tɔm kpɑ-mɛɣɛ sɔɣɔntʋ sɔsɔɔntʋ?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mǝ kʋyɔɣɔtʋtʋ wɛ kɛ́ ɩsɩɩ tɔlʋmɑ.","poem":1},{"lineBreak":true},{"text":"Nɑ mǝ kʋmɑɣɑsǝtʋ nɑ́ɑ́ wɛɛ ɩsɩɩ cʋɣʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ɩ́ su, ɩ yele nɑ mɑ yɔɣɔtɩ,","poem":1},{"lineBreak":true},{"text":"ye mɑ tɩɩ tɛmnɑ nti ntǝɣǝlɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mɑ sɔɔlʋ pɩɩwɑɣɑ sɩ ye mpi mpi.","poem":1},{"lineBreak":true},{"text":"Pɑɑ mɑ weesuɣu lɩɩwɑ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ɩsɔ ɩ́ nɔkɑɑ ɩ kʋ-m, mɑ tɑ tɑŋ pʋlʋ.","poem":1},{"lineBreak":true},{"text":"Amɑ mɑ tɔntɛ teu nyɩɩlʋɣʋ kɛ mɑɑ lǝsɩ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ye pǝ tɩɩ lɑpɑ mpʋ pǝ wɑɑsɑ-m kɛ́.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, ɩsɑɣɑʋ ɩɩ kpǝtǝɣǝnɑ Ɩsɔ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tɔʋ, ɩ́ ke ŋkpɑŋŋ kɛ teu","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ nɩɩ mɑ kʋyɔɣɔtʋtʋ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mɑ sɔɔlʋ pɩɩwɑ sɩ mɑ lǝsǝɣɩ mɑ tɩ nyɩɩlʋɣʋ.","poem":1},{"lineBreak":true},{"text":"Mɑ nyǝmɑ́ sɩ mɑ tɔm tenɑ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ye nɔɣɔlʋ cɑɑ sɩ ɩ hʋʋnɑ-m,","poem":1},{"lineBreak":true},{"text":"ɩlɛ mɑ su nɑ mɑ́ sɩ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Hɑɩ, mɑ Ɩsɔ,","poem":1},{"lineBreak":true},{"text":"yɑɑsinɑɑ nɑɑlɛ tike kɛ mɑ cɑɑ ń lɑ-m,","poem":1},{"lineBreak":true},{"text":"nɑ nyɑ́ kiŋ sǝŋʋɣʋ ɩ́ tɑɑ lɑ-m kɑtɛ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Kʋsɩ nyɑ́ niŋ kɛ mɑ tɔɔ,","poem":1},{"lineBreak":true},{"text":"nyɑ́ sɔɣɔntʋ ɩ́ tɑɑ lɑ-m kɑtɑtǝlɑɣɑ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ɩlɛnɑ ń pɔɔsɩ-m nɑ mɑ́ cɔ-ŋ,","poem":1},{"lineBreak":true},{"text":"yɑɑ mɑ́ yɔɣɔtɩ nɑ nyɑɑ cɔ-m.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ɩsɑɣɑtʋnɑɑ ɩsǝnɑɣɑ mɑ lɑpɑ?","poem":1},{"lineBreak":true},{"text":"Hʋlɩ-m mɑ tǝpǝntǝlɛ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Pepe tɔɔ kɛ́ nyɑ́ ɩsɛntɑɑ tɑ́ hɛtǝnɑ-m,","poem":1},{"lineBreak":true},{"text":"nɑ ń nyǝnǝɣɩ-m ɩsɩɩ nyɑ́ kolontu?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Anɩ mɑ wɛ kɛ́ ɩsɩɩ kɑɑwʋlɑɣɑ,","poem":1},{"lineBreak":true},{"text":"yɑɑ nyɩɩliyɑ ŋkɑ heelim kpɑkǝɣɩ tɔ,","poem":1},{"lineBreak":true},{"text":"nɑ ń tɔɣɔnǝɣɩ-m?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Pǝ tɑɣɑ pʋlʋ, n ŋmɑɑkɩ mɑ tɔm ɩsɑɣɑtʋ","poem":1},{"lineBreak":true},{"text":"nɑ ń fɛlǝɣɩ-m mɑ pǝcɑɑtʋ kʋpǝntǝŋ suwe?","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"N tʋ-m nkeɣelee suwe,","poem":1},{"lineBreak":true},{"text":"nɑ ń feŋiɣi mɑ kʋlɑpǝlɛ?","poem":1},{"lineBreak":true},{"text":"Nɑ ń ŋmɑɑkɩ mɑ nɔntɑɑlǝŋ wei","poem":1},{"lineBreak":true},{"text":"mɑ fɛlɑ kɑnyǝŋɑ tɑɑ tɔɣɔ tɑkǝlɑɣɑ tɑɑ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Nɑ mɑ tɔnʋɣʋ nɑ́ɑ́ tɑsǝɣɩ ɩsɩɩ tɑɑʋ,","poem":1},{"lineBreak":true},{"text":"yɑɑ ɩsɩɩ ŋkpɑm mʋʋkʋɣʋ wontu kʋsusuutu tɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}