{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"JOB","translationId":"dop_sim","name":"Soopu","commonName":"Soopu","title":"SOOPU TƆM TAKƎLAƔA","order":18,"numberOfChapters":42,"sha256":"08cf53646b8b739776d1c986c451e32b9a1d12585acb9401ba341c23010b9006","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/dop_sim/JOB/42.json","totalNumberOfVerses":1063},"chapter":{"number":16,"content":[{"type":"heading","content":["Soopu nyǝntʋ"]},{"type":"verse","number":1,"content":["Ḿpʋ́ɣʋ́ Soopu cɔwɑ sɩ:"]},{"type":"verse","number":2,"content":[{"text":"Tɑm kɛ́ mɑ nɩɩkɩ tɔmnɑɑ pɑnɛwɛ.","poem":1},{"lineBreak":true},{"text":"Mǝ tǝnɑ ɩ́ kɛ́ lɑŋɑ hɛɛsǝlɑɑ","poem":1},{"lineBreak":true},{"text":"mpɑ pɑ kɔŋnɑ wɑhɑlɑ tɔɣɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pǝlee kɛ́ tɔm kpɛtɛ","poem":1},{"lineBreak":true},{"text":"nyǝntʋ ntɩ tɩɩ sɩɩ tǝnɑɣɑ?","poem":1},{"lineBreak":true},{"text":"Pepe tɔɔ kɛ́ pɑ́ɑ́nɑ́ sitɑ nyɑ́ kʋcɔcɔtʋ tɑɑ?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ye mɑɑ wɛnnɑ ɩsɩɩ mɛ,","poem":1},{"lineBreak":true},{"text":"mɑ pǝsǝɣɩ mɑ́ yɔɣɔtɩ mpʋ tɔtɔɣɔ, hɑlɩ pǝ́ tɛɛ mpʋ.","poem":1},{"lineBreak":true},{"text":"Mǝ tɔm lɑpɑ-m pǝtɔɔtǝlɛ, nɑ mɑ́ kpɛɛtɩ nyʋɣʋ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hɑlɩ mɑɑ kpɑɑsɑ mǝ ɑpɑlʋtʋ,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ kʋyɔɣɔtʋtʋ nɑ pǝ́ hɛɛsɩ mǝ lɑŋɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Pɑɑ mɑɑ yɔɣɔtɩ yɑɑ mɑ sumɑ,","poem":1},{"lineBreak":true},{"text":"mɑ wɑhɑlɑnɑɑ kɑɑ sɩɩ tǝnɑɣɑ, yɑɑ pɑ́ tɩɩ pɑsʋ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hɑɩ Ɩsɔ, tɔʋ,","poem":1},{"lineBreak":true},{"text":"nɔɔnɔɔ n yɔkɑ mɑ tomɑ nɑ ń kpiisi mɑ tǝyɑɣɑ tǝnɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mɑ cɔlɔ nyǝ́mɑ cɑɑlǝɣɩ-m kɛ́.","poem":1},{"lineBreak":true},{"text":"Nɑ wei ɩ yɑsǝɣɩ mɑ ɩsɑɣɑtʋ tɔ,","poem":1},{"lineBreak":true},{"text":"ɩ́ pǝsɩ mɑ ɑseetɑ tʋ nɑ ɩ́ kʋlǝɣɩ mɑ tɔɔ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ kɑlǝɣǝnɑ-m mɑ ɩsɛntɑɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mɑ kolontu cɩɩlǝɣɩ-m ɩsɛ, nɑ ɩ́ kpɑsǝɣɩ mpee,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ tiiki mɑ tɔɔ nɑ pɑ́ɑ́nɑ́, nɑ ɩ́ cǝlǝɣɩ-m.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yǝlɑɑ hɑɑwɑ nɔɔsɩ tǝcɑɑɑ, nɑ mɑ tɔɔ,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ tʋʋkɩ-m nɑ pɑ́ mɑkɩ mɑ lǝkpɑɑsɩ.","poem":1},{"lineBreak":true},{"text":"Pɑ pɛɛlɑ nɔɣɔ kɛ mɑ tɔɔ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɩsɔ tʋ-m kʋtɑkɛɛsǝŋ kɛ́","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ pɛtɩ-m ɑsɑɣɑɑ niŋ tɑɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mɑɑ wɛ hɛɛsʋɣʋ tɑɑ kɛ́ nɑ ń pǝsɩ mɑ lɑŋlɛ.","poem":1},{"lineBreak":true},{"text":"N kpɑ mɑ lumɑɣɑ kɛ́ nɑ ń pɛlɩ-m,","poem":1},{"lineBreak":true},{"text":"nɑ ń kɛɛsǝɣǝnɑ-m nɑ ń tɔɔkɩ nyɑ́ nyǝmɑ́.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nyɑ́ nyǝmɑ́ ɑnɩ ɑ tɑmɑ-m kotɑɣɑ kɛ́","poem":1},{"lineBreak":true},{"text":"nɑ ɑ́ tʋlɩ mɑ lotu nɑ pǝtɔɔtǝlɛ fɛɩ,","poem":1},{"lineBreak":true},{"text":"hɑlɩ mɑ kɑncǝlɑɣɑ kpe ɑtɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A tiiki mɑ tɔɔ kɛ́ ɩsɩɩ","poem":1},{"lineBreak":true},{"text":"yoolu nɑ ɑ́ tʋlǝɣɩ-m pɔɔŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mɑ suu fɔlǝtɔ tɑkɑnɑɑ mpɑ pɑ kɛ́ lǝyɑɣɑ wontu tɔɣɔ,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ pilimiɣi ɑtɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wulɑ sɛɛsɑ mɑ ɩsɛ kɛ́ nɑ ɑ́ mʋlɩ,","poem":1},{"lineBreak":true},{"text":"nɑ ɑtɛtǝlɛ sǝkpɛtʋɣʋ tɑkɩ mɑ ɩsǝhutu tɔɔ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Anɩ mɑ tɑ lɑ mʋsʋŋ,","poem":1},{"lineBreak":true},{"text":"pǝ́cɔ́ mɑ tɑ sǝlǝmǝnɑ mǝnɑɑfikitʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Hɑɩ, tɛtʋ, tɑɑ pi-m.","poem":1},{"lineBreak":true},{"text":"Yele nɑ mɑ kɑkiisɑɣɑ nɩɩkɩ tɑm.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Pǝ kpɑɣɑʋ nɔɔnɔɔ tɔ,","poem":1},{"lineBreak":true},{"text":"ɩsɔtɔnʋɣʋ tɑɑ kɛ́ mɑ ɑseetɑ tʋ wɛɛ.","poem":1},{"lineBreak":true},{"text":"Wei ɩ cɔɔkɩ-m tɔ hɑtoo ɩsɔtɑɑ kɛ́ ɩ wɛɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mɑ tɑɑpɑlɑɑ nɑ́ pɑɑkǝnɑ-m kɛ́.","poem":1},{"lineBreak":true},{"text":"Amɑ Ɩsɔ kɛ́ mɑ tekiɣinɑ ɩsǝlʋm.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mɑ cɑɑ sɩ nɔɣɔlʋ ɩ́ sɛɛnɑ mɑ tɔɔ,","poem":1},{"lineBreak":true},{"text":"nɑ Ɩsɔ nɑɑkɩ ɩsɩɩ yʋlʋ lɑkʋɣʋ ɩ tɑɑpɑlʋ tɔ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mpi pǝ tɔɔ tɔ, pɑ kɑlɑ mɑ weesuɣu pɩɩsɩ.","poem":1},{"lineBreak":true},{"text":"Mɑɑ tǝŋ mpɑɑʋ ŋku nɑ mɑ tɛɛ tɔ, kʋmǝlʋɣʋ fɛɩ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}