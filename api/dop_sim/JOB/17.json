{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"JOB","translationId":"dop_sim","name":"Soopu","commonName":"Soopu","title":"SOOPU TƆM TAKƎLAƔA","order":18,"numberOfChapters":42,"sha256":"08cf53646b8b739776d1c986c451e32b9a1d12585acb9401ba341c23010b9006","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/dop_sim/JOB/42.json","totalNumberOfVerses":1063},"chapter":{"number":17,"content":[{"type":"heading","content":["Soopu kʋcɔcɔtʋ tɔtɔ"]},{"type":"verse","number":1,"content":[{"text":"Ḿpʋ́ɣʋ́ Soopu tɑsɑɑ sɩ:","poem":1},{"lineBreak":true},{"text":"Mɑ feesiŋ liki. Mɑ kʋyɛɛŋ tɛŋ nɑ pǝlɑɑʋ tɑŋɑ-m.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Woŋlɑɑ tɑmɑ-m kɛ́ nɑ pɑ́ tʋʋkɩ-m,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ kpisiɣi tom kɛ ɑhoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hɑɩ, Ɩsɔ sǝŋ nyɑ́ mɑɣɑmɑɣɑ kɛ","poem":1},{"lineBreak":true},{"text":"mɑ nɔɣɔ tɔɔ kɛ́ hʋʋlɛ tɑɑ.","poem":1},{"lineBreak":true},{"text":"Ye pǝ tɑɣɑ nyɑ́, mɑ fɛɩnɑ nɔɣɔlʋ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N kentɑ pɑ lǝmɑɣɑsɛɛ tɔɔ kɛ́,","poem":1},{"lineBreak":true},{"text":"n kɑɑ yele sɩ pɑ́ kǝlɩ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pɑ wɛɛ kɛ́ ɩsɩɩ pɑ tukuɣu ɩtuule sɩ:","poem":1},{"lineBreak":true},{"text":"Yʋlʋ yɑɑ ɩ tɑɑpɑlɑɑ nɑ pɑ́ tɑlɑ ɩ tɔɣɔnɑɣɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ piyɑ nɑ́ɑ́ tɑŋ nɑ sɩ niŋ wʋlɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mɑɣɑ yǝlɑɑ yookinɑ yontu,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ tɔɔkɩ mɑ ɩsɛntɑɑ kɛ́ ntɑɣɑmɑ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wɑhɑlɑ wɑkǝlɑ mɑ ɩsɛntɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ pǝsɩ ɩsɩɩ ɩlɛɛmʋɣʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kʋsiɣisim tǝŋlɑɑ nɑɑkɩ mɑ wʋsɑsɩ,","poem":1},{"lineBreak":true},{"text":"pɑ nɔɣɔ tɑɑ fɛɩ kete.","poem":1},{"lineBreak":true},{"text":"Kʋpɑmɑ kʋlǝɣɩ ɑsɑɣɑɑ tɔɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tɑmpɑnɑ tǝŋlʋ nɑ́ kɑmɑ nyʋɣʋ kɛ ɩ mpɑɑʋ tɑɑ kɛ́.","poem":1},{"lineBreak":true},{"text":"Nɑ wei ɩ fɛɩnɑ kɑwɑlɑɣɑ tɔ, ɩ toŋ sɔɔsǝɣɩ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mɑ tɑɑpɑlɑɑ, ɩ́ kɔɔ mǝ tǝnɑ.","poem":1},{"lineBreak":true},{"text":"Mɑɑ nɑɑkɩ mǝ tɑɑ kɛ́ lǝmɑɣɑsɛɛ tʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mɑ kʋyɛɛŋ tɛɛwɑ, nɑ pǝ́ kpɛŋnɑ","poem":1},{"lineBreak":true},{"text":"tǝmɑ nnɑ ɑ pǝlɛ mɑ tʋwɑ tɔ.","poem":1},{"lineBreak":true},{"text":"Mpi mɑ nyɩɩlǝɣɩ sɔsɔm kɛ hɑtoo mɑ tɑɑ tɔ pǝ wɑkǝlɑɑ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mpɛ pɑ yɑɑkɩ ɑhoo kɛ ilim kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ sǝkpɛtʋɣʋ ɩ nyɑlɑɑ ɩlɛ,","poem":1},{"lineBreak":true},{"text":"pɑ tɔŋ sɩ pǝ cɑɑ nyɑɑlʋɣʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Atɛtǝlɛ kɛ mɑ tɑŋɑɑ sɩ","poem":1},{"lineBreak":true},{"text":"mɑ́ sʋʋ mɑ́ hǝntɩ tǝ sǝkpɛtʋɣʋ tɑɑ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Pǝlɑɑʋ nyɑɣɑlɛ mɑ cɑɑ,","poem":1},{"lineBreak":true},{"text":"sonsompee mɛɣɛlɛ mɑ too nɑ mɑ kɔɣɔ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mɑ fɛɩnɑ tǝtɛɛllɛ tɔtɔ,","poem":1},{"lineBreak":true},{"text":"nɑ pǝ́ tɩɩ nii ɩsǝlɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mɑɑ kpɛŋnɑ-tɛɣɛ nɑ mɑ́ tiinɑ sǝtɑɑ tɛ,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ hǝntǝnɑ mʋsʋɣʋ tɑɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}