{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"JOB","translationId":"dop_sim","name":"Soopu","commonName":"Soopu","title":"SOOPU TƆM TAKƎLAƔA","order":18,"numberOfChapters":42,"sha256":"08cf53646b8b739776d1c986c451e32b9a1d12585acb9401ba341c23010b9006","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/dop_sim/JOB/42.json","totalNumberOfVerses":1063},"chapter":{"number":18,"content":[{"type":"heading","content":["Pilitɑ nyǝntʋ"]},{"type":"verse","number":1,"content":["Ḿpʋ́ɣʋ́ Suhɑ tʋ Pilitɑ tɔmɑ sɩ:"]},{"type":"verse","number":2,"content":[{"text":"Wɑɑtʋ wei kɛ́ ɩ́ kɑ su yɔɣɔtɑɣɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ kpɑɣɑ lǝmɑɣɑsɛɛ.","poem":1},{"lineBreak":true},{"text":"Ɩlɛnɑ tǝ́ yɔɣɔtɩ tɔm kʋpɑntʋ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɩ́ sumɑ sɩ Soopu ɩ́ nyǝnɩ-tʋɣʋ heeŋ suwe?","poem":1},{"lineBreak":true},{"text":"Pepe tɔɔ kɛ́ ɩ nyǝnǝɣɩ-tʋɣʋ kʋmɛlɛmǝŋ?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Soopu ɩsɩɩ n huɣutuɣu lotu kɛ mpʋ nɑ pɑ́ɑ́nɑ́ tɔ,","poem":1},{"lineBreak":true},{"text":"n hʋʋ sɩ nyɑ́ tɔɔ kɛ́ pǝ lɔ tɛtʋ","poem":1},{"lineBreak":true},{"text":"nɑ kʋkpɑmǝŋ kpɛsɩ nɑ ɩ́ lɑɣɑsɩ lonɑ nɑ?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ɩsɑɣɑʋ tǝyɑɣɑ tɑɑ kɔkɔ","poem":1},{"lineBreak":true},{"text":"kɑ te kɛ́ nɑ kɑ nyɑlǝmǝlɛ mʋkɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ɩsǝnɑ ɩ kɑ tɔŋɑɣɑnɑ nɑɑni tɔ pɩɩ pɑsɑ.","poem":1},{"lineBreak":true},{"text":"Ɩlɛnɑ ɩ mɑɣɑmɑɣɑ ɩ tɑɑ lɑɣɑtʋ nɑ́ɑ́ yele nɑ ɩ́ hoti.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mpi tɔ, puluɣu tɑɑ kɛ́ ɩ nɔɔhɛɛ tiiwɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ tɔŋ kʋ kpɑlɑhuuŋ tɔɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kɑtɔkɑ kɑ́ kpɑ ɩ nɔntɑɑlʋɣʋ","poem":1},{"lineBreak":true},{"text":"nɑ kɑ ŋmɩɩsɩ nɑ́ɑ́ hɔkɔ-ɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Puluɣu pimɑ ɑtɛɣɛ,","poem":1},{"lineBreak":true},{"text":"nɑ kʋnyǝpǝm kɛ ɩ mpɑɑʋ tɑɑ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sɔɣɔntʋ sɔsɔɔntʋ kpɑɑ-ɩ nɑ pɑɑ timpiɣi,","poem":1},{"lineBreak":true},{"text":"nɑ tǝ́ tǝŋǝɣɩ-ɩ nɔɔhǝlɛ nɔɔhǝlɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Pɑɑ ɩ kɑ kɛ́ toŋ tʋ,","poem":1},{"lineBreak":true},{"text":"nyɔɣɔsɩ kɑ́ lɩɩ-ɩ kɛ́ nɑ ɩ́ sʋʋ kʋnyɔŋ tɑɑ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kʋtɔŋ ɩsɑɣɑʋ tɔɣɔ ɩ nɑntʋ kɛ","poem":1},{"lineBreak":true},{"text":"pǝ kpɑɣɑʋ ɩ niŋ nɑ ɩ nɔɔhɛɛ tǝnɑ tɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Pɩɩ lǝsɩ-ɩ nɑ toŋ kɛ ɩ tɛ́ timpi","poem":1},{"lineBreak":true},{"text":"ɩ cɑɣɑnɑ nɑɑni tɔ, nɑ pǝ́ ponɑ-ɩ sǝtɑɑ wulɑʋ tɛ́.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ɩ tǝyɑɣɑ tɑ kɛ ɩ nyǝŋkɑ tɔtɔ,","poem":1},{"lineBreak":true},{"text":"yʋlʋ pǝsǝɣɩ nɑ ɩ́ sʋʋ kɑ tɑɑ.","poem":1},{"lineBreak":true},{"text":"Pɑ ŋmɩɩsɑ kɑ tɑɑ kɛ́ kɔkɔ mɑmɑcǝɣǝlɑsɩ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ɩlɛnɑ ɩ́ pǝsɩ ɩsɩɩ tʋɣʋ sǝkʋɣʋ too","poem":1},{"lineBreak":true},{"text":"kʋ lilɑ nɑ pǝ́ yoosinɑ kʋ piliŋɑsɩ tɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ɩ hǝtɛ kɑ́ sɑɑlɩ tɛtʋ tǝnɑ tɑɑ.","poem":1},{"lineBreak":true},{"text":"Nɔɣɔlʋ kɑɑ tɔɔsɩ ɩ tɔɔ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Pɑɑ lǝsɩ-ɩ nyɑɑlǝm tɑɑ nɑ ɩ́ sʋʋ sǝkpɛtʋɣʋ tɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ tɩɩ lǝsɩ-ɩ tɛtʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ɩ kɑɑ yele pǝyɑɣɑ, yɑɑ lʋlʋɣʋ tʋ,","poem":1},{"lineBreak":true},{"text":"yɑɑ pǝ́ kɑɑsɩ nɔɣɔlʋ nɑ ɩ ɩsɛ kɛ ɩ tǝcɑɣɑlɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ilim tǝlɩɩlɛ, nɑ pǝtǝtʋlɛ nyǝ́mɑ kɑ́ nɩɩ","poem":1},{"lineBreak":true},{"text":"ɩ wɑkǝlʋɣʋ tɔm, nɑ pǝ́ sʋsɩ-wɛɣɛ wɑtʋ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ɩsǝnɑ kʋtɑkɛɛsǝŋ tɛɛsɩ kɑ́ tɛɛsǝnɑ tɔɣɔlɛ.","poem":1},{"lineBreak":true},{"text":"Mpɑ pɑ tɑ nyɩ Ɩsɔ tɔ pɑ lonte ntɛ́.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":20}