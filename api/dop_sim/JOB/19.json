{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"JOB","translationId":"dop_sim","name":"Soopu","commonName":"Soopu","title":"SOOPU TƆM TAKƎLAƔA","order":18,"numberOfChapters":42,"sha256":"08cf53646b8b739776d1c986c451e32b9a1d12585acb9401ba341c23010b9006","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/dop_sim/JOB/42.json","totalNumberOfVerses":1063},"chapter":{"number":19,"content":[{"type":"heading","content":["Soopu nyǝntʋ"]},{"type":"verse","number":1,"content":["Ḿpʋ́ɣʋ́ Soopu cɔwɑ sɩ:"]},{"type":"verse","number":2,"content":[{"text":"Pǝlee kɛ́ ɩ́ kɑ́ hɛɛsɩ-m","poem":1},{"lineBreak":true},{"text":"kʋnyɔŋ tʋɣʋ nɑ mǝ́ kʋyɔɣɔtʋtʋ?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tɔm nɑɑnʋwɑ kɛlɛ ɩ́ tɛmɑ-m kʋtʋɣʋ,","poem":1},{"lineBreak":true},{"text":"pǝ fɛɩ-mɛɣɛ fɛɛlɛ sɩ ɩ́ cɔɔsǝɣɩ-m mpʋ?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ye tɑmpɑnɑ mɑ tɩɩ lɑpɑ ɩsɑɣɑtʋ,","poem":1},{"lineBreak":true},{"text":"mɑ nyʋɣʋ tɑɑ kɛ́ pǝ tɛŋ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɩsɩɩ ɩ hɔŋ mǝ tɩ nɑ kɑlɑmpɑɑnɩ nɑ","poem":1},{"lineBreak":true},{"text":"ɩ́ mɑɣɑsǝɣɩ sɩ mɑ kɑwɑlɑɣɑ kʋnyɔŋ kɛ mɑ tɔkɩ tɔ,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ɑmɑ ɩ́ nyɩ sɩ Ɩsɔ kpɑnɑ-m","poem":1},{"lineBreak":true},{"text":"ɩ puluɣu tɑɑ, nɑ ɩ́ tʋɣʋ-m kʋnyɔŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ye mɑ wiiki sɩ pɑ lɑkɩ-m mʋsʋŋ,","poem":1},{"lineBreak":true},{"text":"nɔɣɔlʋ ɩɩ cɔɔkɩ.","poem":1},{"lineBreak":true},{"text":"Nɑ mɑ́ yɑɑkɩ sɩ pɑ́ wɑɑsɩ-m,","poem":1},{"lineBreak":true},{"text":"nɔɣɔlʋ ɩɩ sɛɛkǝnɑ mɑ tɔɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɩsɔ kɑɣɑ mɑ mpɑɑʋ, mɑɑ pǝsǝɣɩ tɛɛʋ.","poem":1},{"lineBreak":true},{"text":"Ɩ yelɑ-m sǝkpɛtʋɣʋ tɑɑ, nɑ mɑ hɑkǝɣɩ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ɩsɔ kʋwɑ mɑ hǝtɛ yɑɑʋ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ kɔɔlɩ mɑ teeli ntenuɣu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ɩsɔ wɑkǝlɑ-m pǝ tǝnɑ pǝ tɑɑ kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ kpɛsɩ mɑ tɛɛlʋɣʋ ɩsɩɩ tʋɣʋ, nɑ mɑ́ sɩ́.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɩsɔ pɑ́ɑ́nɑ́ sɔsɔɔnɑ huunɑ-m","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ nyǝnǝɣɩ-m ɩ kolontunɑɑ tɑɑ lɛlʋ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ɩ yʋlʋkʋlɑɑ kpekɑ kpɛntɑ nɔɣɔ nɑ pɑ́ kɔɔ mɑ tɔɔ,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ siki nɑ pɑ́ cɔɔnɑ-m.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ɩsɔ hɑtǝlǝnɑ-m mɑ tɛɛtʋnɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ ɑsǝmɑɑ nɑ́ɑ́ yɑɑkɩ nɑ pɑ́ yeki-m.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mɑ cɔlɔ nyǝ́mɑ nɑ mɑ lʋlǝtɑnɑɑ","poem":1},{"lineBreak":true},{"text":"nɑ́ sɔɔ mɑ tɔɔ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mɑ tǝyɑɣɑ tɑɑ mʋʋlɑɑ nɑ mɑ tǝmlɛ nyǝ́mɑ","poem":1},{"lineBreak":true},{"text":"nɑ́ yʋɣʋ-m nɑ pɑ́ nyǝnǝɣɩ-m kpɑɩ tʋ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Pɑɑ mɑ yɑɑ mɑ tǝmlɛ tʋ","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ wiinɑ-ɩ, ɩɩ cɔɔkɩ-m.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mɑ lɩɩ sɔŋ kɛ mɑ ɑlʋ mɑɣɑmɑɣɑ kɛ́.","poem":1},{"lineBreak":true},{"text":"Mɑ pǝyɑlɑɑ nɑ́ nyǝɣǝsɑ-m.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Pǝ kpɛŋnɑ piyɑ nɑ ye mɑ kʋlǝɣɩ ɩlɛ sɩ woŋiɣi-m.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mɑ tɑɑpɑlɑɑ kʋpɑmɑ mpɑ mɑɑ sɔɔlɑɑ tɔ,","poem":1},{"lineBreak":true},{"text":"pɑ lɩɩ-m luɣu nɑ pɑ́ kʋlǝɣɩ mɑ tɔɔ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mɑ lɩɩnɑ pǝcɛmtɛɣɛ.","poem":1},{"lineBreak":true},{"text":"Mɑ tɛmɑ tɑɑsɩ tǝkɔŋɔkɔŋɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Mɑ tɑɑpɑlɑɑ mɛ, hɑɩ, ɩ́ nyǝnɩ mɑ pǝtɔɔtǝlɛ.","poem":1},{"lineBreak":true},{"text":"Ɩsɔ tʋnɑ mɑ tɔɔ kɛ́ niŋ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Pepe tɔɔ kɛ́ ɩ́ tʋɣʋ-m kʋnyɔŋ ɩsɩɩ Ɩsɔ?","poem":1},{"lineBreak":true},{"text":"Ɩsǝnɑ ɩ́ tʋ-m wɑhɑlɑ tɔ, pǝ tɑ nɩɩ-mɛɣɛlɛ?","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Hɑɩ, ye ɩsɩɩ pɑɑ ŋmɑɑwɑ","poem":1},{"lineBreak":true},{"text":"mɑ kʋyɔɣɔtʋtʋ tǝnɛɣɛ tɑkǝlɑɣɑ tɑɑ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ɩsɩɩ pɑɑ ŋmɑɑ-tɩ nɑ nyǝmlɛ kɛ kʋkpɑmʋɣʋ tɔɔ,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ piisi, nɑ tǝ́ wɛɛ tɑm tɔɔ, tǝ tɑɑ hɩɩsɩ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Mɑ nyǝmɑ́ teu sɩ mɑ tɔɔ sɛɛnlʋ wɛnɑ","poem":1},{"lineBreak":true},{"text":"ɩ weesuɣu.","poem":1},{"lineBreak":true},{"text":"Ɩnɩ ɩ kɑ́ yɔɣɔtǝnɑ nɑ pǝ́ sɩɩ tǝnɑɣɑ kɛ ɑtɛ cǝnɛ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Pɑɑ pǝ kɔɔlɑ mɑ nɑntʋ nɑ pǝ́ yele mʋwɑ tike,","poem":1},{"lineBreak":true},{"text":"mɑɑ nɑ́ Ɩsɔ nɑ mɑ ɩsǝlɛ kɛ́,","poem":1},{"lineBreak":true},{"text":"ɩ kɑɑ wɛɛ-m mʋʋlʋ.","poem":1},{"lineBreak":true},{"text":"Mpi mɑ sɔɔlɑɑ tɔɣɔlɛ,","poem":1},{"lineBreak":true},{"text":"hɑlɩ pɩɩ lɑkɩ-m lɔŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ɩ́ kɑ́ pɔɔsɩ mǝ tɩ sɩ ɩsǝnɑɣɑ ɩ́ kɑ́ kʋlɩ","poem":1},{"lineBreak":true},{"text":"mɑ tɔɔ, nɑ ɩ́ hiki tǝwɑɑnlɛ nɑ ɩ́ hʋʋnɑ-m?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ɩ́ lɑ lɑɑkɑlɩ, nɑ pǝ tɑɑ kɔɔ nɑ lɑɣɑtɛ tɑlɑ mǝ mɑɣɑmɑɣɑ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, mǝ kɑwɑlɑɣɑ mʋnɑ sǝm kɛ́.","poem":1},{"lineBreak":true},{"text":"Ɩ́ nyɩ sɩ hʋʋlɛ tɑŋɑ-mɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":28}