{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"JOB","translationId":"dop_sim","name":"Soopu","commonName":"Soopu","title":"SOOPU TƆM TAKƎLAƔA","order":18,"numberOfChapters":42,"sha256":"08cf53646b8b739776d1c986c451e32b9a1d12585acb9401ba341c23010b9006","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/dop_sim/JOB/42.json","totalNumberOfVerses":1063},"chapter":{"number":22,"content":[{"type":"heading","content":["Ɩlifɑsɩ nyǝntʋ"]},{"type":"verse","number":1,"content":["Ḿpʋ́ɣʋ́ Temɑŋ tʋ Ɩlifɑsɩ cɔwɑ Soopu sɩ:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ɩsɔ ɩɩ tɛɛlǝɣɩ yʋlʋ sɩ ɩ́ wɑɑsɩ-ɩ.","poem":1},{"lineBreak":true},{"text":"Amɑ ye yʋlʋ wɛnɑ nyʋɣʋ tɑɑ mɑɣɑsǝm, ɩ tǝɣɩ ɩ wɛɛkɩ teu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nɑ yʋlʋ ɩ́ siɣisɑɑ yɑɑ ɩ tewɑ tǝkpɑtɑɑ,","poem":1},{"lineBreak":true},{"text":"weɣe pǝ wɑɑsǝɣɩ Tomɑ tǝnɑ tʋ?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Pǝ tɑɣɑ nyɑ́ ɩsɔsɛɛlɛ teu tɔɔ kɛ́","poem":1},{"lineBreak":true},{"text":"ɩ hɔŋ nyɑ́ ŋkpɑŋʋɣʋ nɑ ɩ́ hʋʋkǝnɑ-ŋ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nyɑ́ kɑwɑlɑɣɑ kɑtɑtǝlɑɣɑ nɑ nyɑ́ ɩsɑɣɑtʋ","poem":1},{"lineBreak":true},{"text":"tɑm nyǝntʋ tɔɔ kɛ́ Ɩsɔ hɔŋ nyɑ́ ŋkpɑŋŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mpi tɔ, n mʋkɑɣɑ nyɑ́ tɛɛtʋnɑɑ wontu","poem":1},{"lineBreak":true},{"text":"kɛ tɔlʋmɑ kɛ mʋsʋŋ, nɑ pǝ́ yeki-wɛɣɛ kpɛtɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N pɛmɑ lʋm nɑ tɔɣɔnɑɣɑ","poem":1},{"lineBreak":true},{"text":"kɛ wei lʋkɔtʋ nɑ nyɔɣɔsɩ kɑ pɩɩwɑ tɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yʋlʋ toŋ tʋ nɑ kɑlɑmpɑɑnɩ tʋ","poem":1},{"lineBreak":true},{"text":"kɑ tǝnnɑ tɛtʋ, nɑ ɩ́ cɑɣɑ tǝ tɑɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N tɔɣɔnɑ leelu kɛ niŋ kɑkpɑsɩ, n pɛlɑ sulɑʋ niŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Pǝ tɔɔ kɛ́ kɑtɔsɩ tɑmɑ-ŋ","poem":1},{"lineBreak":true},{"text":"nɑ sɔɣɔntʋ ɑnɑɑm nɑ́ɑ́ tuti-ŋ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sǝkpɛtʋɣʋ nyɑlɑ nyɑ́ tɔɔ,","poem":1},{"lineBreak":true},{"text":"nn nɑɑnɑ tiili, lʋm sɔsɔɔm lipɑ-ŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ɩsɔ wɛ hɑtoo ɩsɔtɑɑ kɛ́ nɑ ɩ́ tɛɛ","poem":1},{"lineBreak":true},{"text":"ɩsɔtʋlʋŋɑsɩ tɔɔ, nɑ ɩ́ nyǝnǝɣǝnɑ sɩ nyɔɔŋ tɑɑ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ɩlɛnɑ nyɑɑ mɑɣɑsǝɣɩ sɩ Ɩsɔ tɑ́ nyɩ pʋlʋ.","poem":1},{"lineBreak":true},{"text":"Ɩ kɑɑ pǝsɩ nɑ ɩ́ tɛɛ ɩsɔŋmʋntʋ tɔɔ","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ hʋʋnɑ-tʋɣʋ ɑtɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ɩsɔ tɔŋ ɩsɔtɔnʋɣʋ ntompee tɔɔ,","poem":1},{"lineBreak":true},{"text":"nɑ ŋmʋntʋ tɑkɑ ɩ tɔɔ, ɩɩ nɑɑnɑ tiili.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"N cɑɑ sɩ ń tǝŋ","poem":1},{"lineBreak":true},{"text":"ɑsɑɣɑɑ mpɑɑʋ kʋpǝnʋɣʋ kɛ?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Pǝ tɛmɑ-wɛɣɛ kpiisuɣu kɛ́, nɑ pǝ wɑɑtʋ tɑ tɑtɑ,","poem":1},{"lineBreak":true},{"text":"ɩsɩɩ lʋm kuukuɣu koluŋɑ tɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Hɑlǝnɑ yǝlɑɑ mpɛ pɑ́ tɔŋ","poem":1},{"lineBreak":true},{"text":"Ɩsɔ Tomɑ tǝnɑ tʋ sɩ: Yele-tʋ tǝpɑmm.","poem":1},{"lineBreak":true},{"text":"Weɣe n pǝsǝɣɩ nɑ ń lɑ-tʋ?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Pǝyele ɩnɩ ɩ kɑ hɑɣɑsǝnɑ pɑ tɛɛsɩ nyǝ́mɑ kɛ toŋ.","poem":1},{"lineBreak":true},{"text":"Ɩsɔ ɩ́ ponɑ ɑsɑɣɑɑ lǝmɑɣɑsɛɛ ɑnǝɣɩ pooluŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yǝlɑɑ kʋpɑmɑ nɑ mpɑ pɑ fɛɩ tɔm tɔ,","poem":1},{"lineBreak":true},{"text":"pɑɑ nɑ́ pɑ wɑkǝlʋɣʋ nɑ pɑ́ woŋ-wɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Pǝ wɑkǝlɑ pɑ kolontunɑɑ","poem":1},{"lineBreak":true},{"text":"nɑ kɔkɔ nyɑɣɑ pɑ wɛnɑʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tɔʋ, nyɑ́ nɑ Ɩsɔ ɩ́ ciiki nɑ pǝ́ hɛtɩ-ŋ.","poem":1},{"lineBreak":true},{"text":"Wɑɑtʋ ɩnǝɣɩ n kɑ́ nɩɩ leleŋ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mʋ mɑ kʋsɛɣɛsǝtʋ nɑ","poem":1},{"lineBreak":true},{"text":"ń tɔkɩ mɑ tɔm kɛ nyɑ́ lotu tɑɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Lǝsɩ mpi pǝ tɑ siɣisi tɔɣɔ nyɑ́ tɛ,","poem":1},{"lineBreak":true},{"text":"nɑ ń mǝlɩ Tomɑ tǝnɑ tʋ tɛɛ nɑ ɩ́ tɑɣɑnɩ-ŋ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Lɔ nyɑ́ wʋlɑ kʋpɑmpɑŋ kɛ","poem":1},{"lineBreak":true},{"text":"ɑtɛɣɛ lɔɔʋ pɛɛ hɛkʋ tɑɑ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ɩlɛnɑ Tomɑ tǝnɑ tʋ pǝsɩ nyɑ́ wʋlɑ,","poem":1},{"lineBreak":true},{"text":"nɑ nyɑ́ liɣitee hɔwɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Wɑɑtʋ ɩnǝɣɩ ɩ kɑ́ pǝsɩ nyɑ́ leleŋ kʋpɑŋ","poem":1},{"lineBreak":true},{"text":"tǝlɩɩlɛ nɑ ń tɛkǝɣɩ-ɩ niŋ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"N kɑ́ sǝlǝmǝɣɩ-ɩ nɑ ɩ́ nɩɩkɩ,","poem":1},{"lineBreak":true},{"text":"nɑ ń yoosiɣi nti n kɑ yɔɣɔtɑɑ nɑ ń sɩɩ tɔ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Pɑɑ ntiɣi n sɩɩwɑ, n wɑɑkɩ kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ nyɑ́ mpɑɑʋ hʋlʋmɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Mpi tɔ, Ɩsɔ tisiɣi kɑlɑmpɑɑnɩ nyǝ́mɑ kɛ́.","poem":1},{"lineBreak":true},{"text":"Ɩlɛnɑ ɩ́ wɑɑsǝɣɩ wei ɩ pɑsǝɣɩ ɩ tɩ tɔ.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ɩsɔ kɑ́ wɑɑsɩ wei ɩ tɑ kɛ ɩsɑɣɑʋ","poem":1},{"lineBreak":true},{"text":"tɔɣɔ ɩ tǝnɑŋŋ wɛɛtʋ tɔɔ.","poem":1},{"lineBreak":true},{"text":"Pɑɑ tɑsǝkǝlɛ tʋ ɩ wɑɑsǝɣɩ-ɩ kɛ́.","poem":1},{"lineBreak":true},{"text":"Sɩ ɩ́ tɔ tǝnɑŋŋ tɑɑ,","poem":1},{"lineBreak":true},{"text":"ɩlɛnɑ pǝ́ yɑ ɩ nyʋɣʋ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}