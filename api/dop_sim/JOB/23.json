{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"JOB","translationId":"dop_sim","name":"Soopu","commonName":"Soopu","title":"SOOPU TƆM TAKƎLAƔA","order":18,"numberOfChapters":42,"sha256":"08cf53646b8b739776d1c986c451e32b9a1d12585acb9401ba341c23010b9006","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/dop_sim/JOB/42.json","totalNumberOfVerses":1063},"chapter":{"number":23,"content":[{"type":"heading","content":["Soopu nyǝntʋ"]},{"type":"verse","number":1,"content":["Ḿpʋ́ɣʋ́ Soopu cɔwɑ sɩ:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nɔɔnɔɔ tɔ, mɑ wulɑ pǝsɑ pɑ́ɑ́nɑ́ kɛ́.","poem":1},{"lineBreak":true},{"text":"Ɩlɛnɑ mɑ wɑhɑlɑ nɑ́ɑ́ tǝkǝɣɩ mɑ feesiŋ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hɑɩ, ye mɑɑ nyǝmɑ́ Ɩsɔ tɛ,","poem":1},{"lineBreak":true},{"text":"mɑɑ polɑ ɩ tǝcɑɣɑlɛ kɛ́.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mɑɑ hʋlɑ-ɩ mɑ tɑmpɑnɑ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, tɔmnɑɑ su mɑ nɔɣɔ tɑɑ kɛ́.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hɑlɩ mɑɑ nyǝmɑ́ nti ɩ cɔɔkɑɣɑ-m tɔ","poem":1},{"lineBreak":true},{"text":"nɑ mɑ cɛkǝnɑ nti ɩ heelɑɣɑ-m tɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ɩlɛ ɩ kɑ́ kɑɑsɩ ɩ tɑɑ tomɑ sɩ ɩ kʋlǝɣɩ mɑ tɔɔ?","poem":1},{"lineBreak":true},{"text":"Aɑɩ, ɩ kɑ́ ke ŋkpɑŋʋɣʋ kɛ́ nɑ ɩ́ nɩɩ mɑ kʋyɔɣɔtʋtʋ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ɩlɛ ɩ kɑ́ nɑ́ sɩ ɩ kolontu ɩnɩ ɩ","poem":1},{"lineBreak":true},{"text":"tǝŋǝɣɩ tɑmpɑnɑ, ɩlɛnɑ ɩ́ nɑ́ sɩ ɩ tɔm hʋʋlʋ","poem":1},{"lineBreak":true},{"text":"kɑ cɛ-m tɑm tɔɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Pɑɑ mɑ polɑ ilim tǝlɩɩlɛ, ɩ fɛɩ,","poem":1},{"lineBreak":true},{"text":"yɑɑ mɑ mǝŋnɑ pǝ tǝtʋlɛ mɑɑ keesiɣi-ɩ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pɑɑ mɑ pɛɛkǝnɑ ilim ntɔɣɔŋ tɔɔ, mɑɑ nɑɑkɩ-ɩ.","poem":1},{"lineBreak":true},{"text":"Yɑɑ mɑ kɛɛnɑ pǝ mpǝtǝŋ tɔɔ, ɩ fɛɩ loosuɣu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Pǝyele ɩ nyǝmɑ́ mpɑɑʋ ŋku mɑ kpɑɣɑɑ tɔ.","poem":1},{"lineBreak":true},{"text":"Pɑɑ ɩ mɑɣɑsɑ-m mɑ lɩɩ kɛ́ tǝsoolii, ɩsɩɩ wʋlɑ kʋpɑŋ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɩ nɔntɑɑlǝŋ tɑɑ kɛ́ mɑ tʋkɑɣɑ mɑ nyǝŋ.","poem":1},{"lineBreak":true},{"text":"Mɑ tǝŋɑ ɩ mpɑɑʋ kɛ ḿpʋ́ɣʋ́ mɑ tɑ hɛlɩ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mɑ tɑ lɔ ɩ nɔɣɔ tɑɑ kʋsǝsɩɩtʋ.","poem":1},{"lineBreak":true},{"text":"Mɑ pɛtɑ mɑ tǝɣɩ ɩ luɣu nyǝntʋ tɑɑ kɛ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Amɑ ye ɩ tʋ ntiɣi ɩ tɑɑ,","poem":1},{"lineBreak":true},{"text":"ɩɩ yeki-tɩ. Nti ɩ sɔɔlɑɑ tɔ ntǝɣɩ ɩ lɑkɩ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nti ɩ kɑ sɩɩwɑ mɑ tɔɔ tɔɣɔ ɩ lɑkɩ-m,","poem":1},{"lineBreak":true},{"text":"Ɩ kɑ́ sɩɩ lɛntǝnɑɑ kɛ mpʋ tɔtɔ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Pǝ tɔɔ kɛ́ mɑ ɑpɑlʋtʋ leki Ɩsɔ kiŋ.","poem":1},{"lineBreak":true},{"text":"Ye mɑ kpɑɣɑ hʋwɛɛ ɩlɛ sɔɣɔntʋ kpɑɑkɩ-m.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ɩsɔ Tomɑ tǝnɑ tʋ yɔkǝnɑ mɑ ɑpɑlʋtʋ","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ tʋ-m sɔɣɔntʋ sɔsɔɔntʋ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mpi tɔ, pǝ tɑɣɑ sǝkpɛtʋɣʋ ŋku kʋ wɑɑsɑ mɑ tɔɔ tɔ,","poem":1},{"lineBreak":true},{"text":"ŋkʋ kʋ wɑkǝlǝnɑ-m.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}