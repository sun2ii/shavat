{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"JOB","translationId":"dop_sim","name":"Soopu","commonName":"Soopu","title":"SOOPU TƆM TAKƎLAƔA","order":18,"numberOfChapters":42,"sha256":"08cf53646b8b739776d1c986c451e32b9a1d12585acb9401ba341c23010b9006","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/dop_sim/JOB/42.json","totalNumberOfVerses":1063},"chapter":{"number":26,"content":[{"type":"heading","content":["Soopu nyǝntʋ"]},{"type":"verse","number":1,"content":["Mpʋɣʋlɛ Soopu cɔwɑ sɩ:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Pʋwɛ! Amɑ n nyǝmɑ́ ɩcɑm sǝnɑʋ,","poem":1},{"lineBreak":true},{"text":"n nyǝmɑ́ wei ɩ fɛɩnɑ tomɑ tɔ ɩ tem.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Amɑ n nyǝmɑ́ lǝmɑɣɑsɛɛ fɛɩ tʋ kɛ lɑɣɑtʋ","poem":1},{"lineBreak":true},{"text":"tɑsʋɣʋ, nɑ ń hʋlǝɣɩ nyǝm sɔsɔɔm.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aweɣe n yɔɣɔtǝɣɩ tɔmnɑɑ mpɛ?","poem":1},{"lineBreak":true},{"text":"Nɑ ɑwe tɩɩ tʋnɑ-tǝɣɩ nyɑ́ tɑɑ?","poem":1}]},{"type":"heading","content":["Ɩsɔ toŋ kɛ pǝ tǝnɑ pǝ tɔɔ"]},{"type":"verse","number":5,"content":[{"text":"Sǝtɑɑ seliɣi pɑ tǝcɑɣɑlɛ tɑɑ kɛ́ hɑtoo lʋm tɛɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mpi tɔ, Ɩsɔ nɑɑkɩ ɑtɛtǝlɛ tɑɑ kɛ́ tǝcɛɩcɛɩ.","poem":1},{"lineBreak":true},{"text":"Pǝyele pǝ kɛɛlɑ pʋ́ʋ́ɣʋ́ sɔsɔɔʋ ŋkʋ kʋ tɔɔ kɛ́,","poem":1},{"lineBreak":true},{"text":"pʋlʋ tɑ́ kenti-ɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ɩnɩ ɩ pɔnɑ ɩsɔtɔnʋɣʋ kɛ yem tɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ susi ɑntulinyɑ kɛ kpɛtɛ tɑɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɩnɩ ɩ hɑɣɑsǝnɑ tɛʋ lʋm kɛ ɩsɔŋmʋntʋ tɑɑ","poem":1},{"lineBreak":true},{"text":"nɑ tǝ́ lɑ́ yuŋ, pǝ́cɔ́ tǝ kɑɑ yɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ɩnɩ ɩ tɑkǝɣǝnɑ ɩ kumte tɔɔ","poem":1},{"lineBreak":true},{"text":"kɛ́ ɩsɔŋmʋntʋ ɩsɩɩ sɑɑlɑɣɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ɩ pɩɩ ŋmɑɑlɑɣɑ kɛ teŋku tɔɔ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ cɔɔ nɑ ɩ́ tɑ.","poem":1},{"lineBreak":true},{"text":"Hɑlǝnɑ pǝ́ sɩɩnɑ sǝkpɛtʋɣʋ nɑ nyɑɑlǝm pǝ tǝnɑɣɑ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ye Ɩsɔ holɑɑ, sɔɣɔntʋ kpɑɑkɩ","poem":1},{"lineBreak":true},{"text":"ɩsɔtɔnʋɣʋ ɑkelenɑɑ kɛ́ nɑ pɑ́ seliɣi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ɩ toŋ kɛ ɩ selisiɣinɑ teŋku.","poem":1},{"lineBreak":true},{"text":"Ɩlɛnɑ ɩ́ wɑkǝlɩ ɩsǝcɑʋ nɑ ɩ lɑɣɑtʋ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ɩ feesiŋ kɛɛlɑ ɩsɔtɔnʋɣʋ tɔɔ.","poem":1},{"lineBreak":true},{"text":"Ɩlɛnɑ ɩ niŋ nɑ́ɑ́ tʋlɩ tʋm sɔsɔ wei ɩ seekɑɣɑ tɔ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Pǝ tǝnɑɣɑ mpʋ ɩ tǝmɑ nyɑlǝmlɛ ntɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ tǝ́ nɩɩkɩ ɑ tɑŋ kɛ pǝcɔ pǝcɔ.","poem":1},{"lineBreak":true},{"text":"Ɩlɛ ɑwe kɑ́ pǝsɩ ɩ toŋ kɔkɔtɛ sɔsɔɔlɛ kɛ nɩɩʋ?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}