{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"JOB","translationId":"dop_sim","name":"Soopu","commonName":"Soopu","title":"SOOPU TƆM TAKƎLAƔA","order":18,"numberOfChapters":42,"sha256":"08cf53646b8b739776d1c986c451e32b9a1d12585acb9401ba341c23010b9006","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/dop_sim/JOB/42.json","totalNumberOfVerses":1063},"chapter":{"number":27,"content":[{"type":"heading","content":["Soopu nyǝntʋ tɔtɔ"]},{"type":"verse","number":1,"content":["Mpʋɣʋlɛ Soopu kpɑɣɑ ɩ kʋnyɔwiinɑ sɩ:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mɑ tuukinɑ weesuɣu tʋ Ɩsɔ Tomɑ tǝnɑ tʋ.","poem":1},{"lineBreak":true},{"text":"Wei ɩ pɛŋɩ-m tɑmpɑnɑ, nɑ ɩ́ wɑkǝlǝɣɩ mɑ lɑŋlɛ tɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ye mɑ weesuɣu kɑɑsɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ Ɩsɔ feesiŋ wɛ mɑ mɩɩnɑ tɛɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mɑ ntompee kɑɑ yɔɣɔtɩ ɩsɑɣɑtʋ.","poem":1},{"lineBreak":true},{"text":"Pǝyele mɑ nsǝmlɛ kɑɑ lǝsɩ pɔpɔtʋ tɔm nɑtǝlɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mpusi ɩ́ polo pooluŋ, nɑ mpi mɑɑ hɑ-mɛɣɛ tɑmpɑnɑ tɔ.","poem":1},{"lineBreak":true},{"text":"Hɑlǝnɑ mɑ sǝm, mɑ kɑɑ kisi hʋlʋɣʋ sɩ mɑ fɛɩnɑ tɑɑlɩ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mɑ tɔkɑ mɑ tɑmpɑnɑ kɛ́, mɑ kɑɑ yele.","poem":1},{"lineBreak":true},{"text":"Pǝyele mɑ kʋyɛɛŋ tɔm fɛɩ-m fɛɛlɛ kɛ mɑ tɑɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Pǝ́ pǝsɩ mɑ kolontu kɛ ɩsɑɣɑʋ,","poem":1},{"lineBreak":true},{"text":"nɑ pǝ́ pǝsɩ mɑ tɔɔ kʋllʋ kɛ wei ɩ fɛɩnɑ tɑmpɑnɑ tɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ye Ɩsɔ tɑmɑ ɩsɑɣɑʋ tomle","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ lǝsɩ ɩ weesuɣu,","poem":1},{"lineBreak":true},{"text":"pepeɣe ɩ tɑsǝɣɩ tɛɛlʋɣʋ?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ye lɑŋwɑkǝllɛ mɑɣɑnɑ-ɩ Ɩsɔ kɑɑ nɩɩ ɩ wulɑ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pɩɩ wɛɛ sɩ Tomɑ tǝnɑ tʋ kɛ","poem":1},{"lineBreak":true},{"text":"ɩ lɑŋlɛ ɩ́ hɛɛnɑ nɑ ɩ́ sǝlǝmǝɣɩ-ɩ tɑm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mɑɑ sɛɣɛsɩ-mɛɣɛ Ɩsɔ mpɑɑŋ tɔm","poem":1},{"lineBreak":true},{"text":"mɑ kɑɑ ŋmɛsɩ-mɛɣɛ mpi pǝ pǝlɛ Tomɑ tǝnɑ tʋ tʋwɑ tɔ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Amɑ pɑ tǝnɑ pɑ nyǝmɑ́ nti tǝ wɛɛ tɔ.","poem":1},{"lineBreak":true},{"text":"Ɩlɛ pepe tɔɔ kɛ́ pɑ yɔɣɔtǝɣɩ tɔm kpɛtɛ nyǝntʋ?","poem":1}]},{"type":"heading","content":["Kɑwɑɑɣɑ ŋkɑ kɑɑ leeliɣi tɔ"]},{"type":"verse","number":13,"content":[{"text":"Mpi Ɩsɔ Tomɑ tǝnɑ tʋ sɩɩwɑ sɩ yʋlʋ ɩsɑɣɑʋ tete,","poem":1},{"lineBreak":true},{"text":"nɑ mʋsʋntʋ kpɑncoou tɔɣɔlɛ sɩ:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ye ɩ piyɑ hukɑɑ, yoou kɑ́ kʋnɑ-wɛ.","poem":1},{"lineBreak":true},{"text":"Pǝyele tɔɣɔnɑɣɑ kɑɑ tɑlɑ pɑ piyɑ piyɑ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yʋlʋkʋsǝkʋ kɑ́ kʋnɑ mpɑ pɩɩ sɔɔ tɔ,","poem":1},{"lineBreak":true},{"text":"pɑ leelɑɑ kɑɑ wii-wɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ye ɩ kɑɑwɑ liɣitee ɩsɩɩ kɑnyǝŋɑ,","poem":1},{"lineBreak":true},{"text":"nɑ wontu ɩsɩɩ ɑfǝlɑ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Siɣisilu kɑ suunɑ-tɩ,","poem":1},{"lineBreak":true},{"text":"nɑ yʋlʋ kʋpɑŋ nɑ́ɑ́ tɔɣɔ ɩ liɣitee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ɩ tǝyɑɣɑ wɛ kɛ́ ɩsɩɩ huu huukuɣu tɔ,","poem":1},{"lineBreak":true},{"text":"yɑɑ ɩsɩɩ tɑŋlʋ sikuɣu cokǝle tɔ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ɩ hǝntʋɣʋ wɑɑtʋ, ɩ kɛ́ liɣitee tʋ.","poem":1},{"lineBreak":true},{"text":"Amɑ ɩ kɑ́ feŋ tɔ, ɑ́ mʋkɑ yem.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Lɑŋwɑkǝllɛ tutiɣi-ɩ kɛ́ ɩsɩɩ lʋm,","poem":1},{"lineBreak":true},{"text":"nɑ kɑcuculɑɣɑ nɑ́ɑ́ kpɑɣɑ-ɩ ɑhoo tɑɑ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ilim tǝlɩɩlɛ heelim lǝsǝɣǝnɑ-ɩ","poem":1},{"lineBreak":true},{"text":"ɩ tǝcɑɣɑlɛ nɑ toŋ, nɑ pǝ́ kɛlɩ nɑ pǝ́ tɛɛnɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Pɑ tɔɔkɩ-ɩ nyǝmɑ́ kɛ́ nɑ pǝtɔɔtǝlɛ fɛɩ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ kɑɑsǝɣɩ ɩ tɩ sɩ ɩ́ se.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ɩlɛnɑ ɩ nɑlɑɑ kpɑsǝɣɩ ɑmʋkʋŋ kɛ ɩ tɔm,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ hʋlǝɣɩ kɑcʋɣʋlɑsɩ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}