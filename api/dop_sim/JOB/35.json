{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"JOB","translationId":"dop_sim","name":"Soopu","commonName":"Soopu","title":"SOOPU TƆM TAKƎLAƔA","order":18,"numberOfChapters":42,"sha256":"08cf53646b8b739776d1c986c451e32b9a1d12585acb9401ba341c23010b9006","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/dop_sim/JOB/42.json","totalNumberOfVerses":1063},"chapter":{"number":35,"content":[{"type":"heading","content":["Ɩlihu kʋyɔɣɔtʋtʋ tɔtɔ"]},{"type":"verse","number":1,"content":["Ḿpʋ́ɣʋ́ Ɩlihu tɑsɑɑ sɩ:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Soopu, n pǝsǝɣɩ nɑ ń hɑ nyɑ́ tǝɣɩ tɑmpɑnɑ","poem":1},{"lineBreak":true},{"text":"nɑ ń yɔɣɔtɩ nyɑ́ siɣisuɣu tɔm kɛ Ɩsɔ kiŋ nɑ sikɑ fɛɩ?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mpi tɔ, n tɑsɑɑ sɩ:","poem":1},{"lineBreak":true},{"text":"Ye mɑ pǝntɑɑ yɑɑ mɑ tɑ pǝntɩ pepeɣe mɑ wɑɑkɩ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mɑɑ kpɛntɩ nyɑ́ nɑ nyɑ́ tɑɑpɑlɑɑ nɑ mɑ́ cɔ-mɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nyǝnɩ ɩsɔtɔnʋɣʋ, nɑ ń pɑɑsǝnɑ ɩsɔŋmʋntʋ,","poem":1},{"lineBreak":true},{"text":"tǝ kǝlɑ-ŋ kʋŋkʋlʋmǝŋ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ye n lɑpɑ ɩsɑɣɑtʋ, weɣe pǝ wɑkǝlǝɣɩ Ɩsɔ?","poem":1},{"lineBreak":true},{"text":"Yɑɑ n kʋlɑ ɩ tɔɔ kɛ́ tɔm pɑɣɑlɛ,","poem":1},{"lineBreak":true},{"text":"pɩɩ tokiɣinɑ ɩ́lɛ́.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ye n tǝŋǝɣɩ tɑmpɑnɑ,","poem":1},{"lineBreak":true},{"text":"ɩlɛ pepeɣelɛ n hɑwɑ Ɩsɔ?","poem":1},{"lineBreak":true},{"text":"Yɑɑ weɣe Ɩ́sɔ mʋɣɩ nyɑ́ niŋ tɑɑ?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yʋlʋ ɩsɩɩ nyɑɣɑ ɩsɑɣɑtʋ wɑkǝlǝɣɩ,","poem":1},{"lineBreak":true},{"text":"nɑ siɣisuɣu wɑɑsɩ nyɑ́ tɔɣɔntǝlɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ye ɩsɩɩ ŋmɑkǝllɑɑ kǝlɑ tɔɔʋ, yǝlɑɑ mɑkɩ kɑpusi kɛ́.","poem":1},{"lineBreak":true},{"text":"Ye mʋsʋŋtʋnɑɑ kǝlɑ pɑɣɑlɛ,","poem":1},{"lineBreak":true},{"text":"ɩlɛ yǝlɑɑ yɑɑ sɩ pɑ́ wɑɑsɩ-wɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Amɑ pɑ tɑɑ nɔɣɔlʋ ɩɩ pɔɔsǝɣɩ Ɩsɔ wei ɩ lɑpɑ-ɩ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ tʋɣɩ yǝlɑɑ tɑɑ kɛ́ lɑŋhʋlʋmlɛ yontu","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ yooki ɑhoo tɔ sɩ: N wɛ le?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɩnɩ ɩ sɛɣɛsǝɣǝnɑ-tʋ, nɑ pǝ́ kǝlɩ tɑɑlɛ wontu.","poem":1},{"lineBreak":true},{"text":"Pǝyele ɩ tɑsǝɣɩ-tʋɣʋ lǝmɑɣɑsɛɛ nɑ pǝ́ kǝlɩ sumɑsɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Pɑ yɑɑwɑ Ɩsɔ, nɑ ɩ́ kisi cɔʋ","poem":1},{"lineBreak":true},{"text":"kɛ ɑsɑɣɑɑ kɑlɑmpɑɑnɩ tɔɔ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Pɔpɔtʋ fɛɩ leleŋ,","poem":1},{"lineBreak":true},{"text":"pɑ koo yem kɛ́ Ɩsɔ ɩɩ nɩɩkɩ.","poem":1},{"lineBreak":true},{"text":"Tomɑ tǝnɑ tʋ ɩɩ pɑɑsǝɣǝnɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Pɑɑ Soopu n tɔŋ sɩ nn nɩɩkɩ Ɩsɔ tɑŋ tɔ","poem":1},{"lineBreak":true},{"text":"Ɩsɔ nyǝ́mɑ nyɑ́ tɔm tǝnɑɣɑ, nyɑɑ keŋnɑ-ɩ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ɩɩ tʋɣɩ sɑlǝkɑ nɑ pɑ́ɑ́nɑ́.","poem":1},{"lineBreak":true},{"text":"Pǝyele ɩɩ pɑɑsǝɣǝnɑ yǝlɑɑ ɩsɑɣɑtʋ.","poem":1},{"lineBreak":true},{"text":"Ɩlɛ pǝ tɑɣɑ sɩ ɩɩ nɑɑkɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Soopu nyɑ́ nɔɣɔ tɑɑ tɔm wɛ yem kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ ń lʋlǝsǝɣɩ tɔm nti tǝ tɑɑ fɛɩ lɑɣɑtʋ tɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}