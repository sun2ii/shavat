{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"JOB","translationId":"dop_sim","name":"Soopu","commonName":"Soopu","title":"SOOPU TƆM TAKƎLAƔA","order":18,"numberOfChapters":42,"sha256":"08cf53646b8b739776d1c986c451e32b9a1d12585acb9401ba341c23010b9006","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/dop_sim/JOB/42.json","totalNumberOfVerses":1063},"chapter":{"number":4,"content":[{"type":"heading","content":["Ɩlifɑsɩ kʋyɔɣɔtʋtʋ"]},{"type":"verse","number":1,"content":["Ḿpʋ́ɣʋ́ Temɑŋ tʋ Ɩlifɑsɩ tɔmɑ Soopu sɩ:"]},{"type":"verse","number":2,"content":[{"text":"N kɑ́ pǝsɩ nɑ ń kɑntǝlɩ nɑ mɑ́","poem":1},{"lineBreak":true},{"text":"yɔɣɔtǝnɑ-ŋ?","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, tɔm wɛ mɑ tɑɑ kɛ́,","poem":1},{"lineBreak":true},{"text":"mɑɑ pǝsǝɣɩ nɑ mɑ́ su.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nyɑ́ sɛɣɛsǝnɑ yǝlɑɑ pɑɣɑlɛ.","poem":1},{"lineBreak":true},{"text":"Pǝyele n nyǝmɑ́ ɑcɑmɑɑ kɛ ɑpɑlʋtʋ sɔɔsʋɣʋ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nyɑ́ tɑsɑɣɑnɑ lɑɣɑtʋ kɛ mpɑ pɑ cɑɑ hotuɣu tɔ,","poem":1},{"lineBreak":true},{"text":"nɑ ń kʋsǝɣɩ mpɑ sǝɣǝlɑ nyǝkɑɑ tɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pǝ mɑɣɑnɑ nyɑ́, ɩlɛnɑ nyɑ́ ɑpɑlʋtʋ","poem":1},{"lineBreak":true},{"text":"yɔɔlǝɣɩ nɑ ń huɣutiɣi lotu nɑ?","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ɩsɩɩ n nyɑŋɑɣɑnɑ Ɩsɔ kɛ́ nɑ pǝ́ wɑɑsǝɣɩ-ŋ?","poem":1},{"lineBreak":true},{"text":"Nɑ nyɑ́ tɔntɛ kʋpɑntɛ nɑ́ɑ́ tʋɣʋ-ŋ nɑɑni?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hʋʋ nyɑ́ tɑɑ, too tɔ,","poem":1},{"lineBreak":true},{"text":"n nɑwɑ pǝ kpiisɑ kʋpɑmɑ, yɑɑ tɑmpɑnɑ tǝŋlɑɑ nɑ?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N nyǝmɑ́ teu tǝsiɣisiɣi sɩ,","poem":1},{"lineBreak":true},{"text":"ye yʋlʋ hɑlɑ kʋtɑkɛɛsǝm yɑɑ ɩ tuu wɑhɑlɑ,","poem":1},{"lineBreak":true},{"text":"mpʋ ɩnǝɣɩ ɩ kɔŋ kʋm.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ɩsɔ wosɑ pǝ yǝlɑɑ kɛ heelim nɑ pɑ́ɑ́nɑ́,","poem":1},{"lineBreak":true},{"text":"nɑ pǝ́ wɑkǝlɩ-wɛ nɑ pǝ́ kpiisi-wɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pɑ holiɣi kɛ́ ɩsɩɩ tɔɣɔlɑsɩ,","poem":1},{"lineBreak":true},{"text":"nɑ Tɑcɑɑ tǝkǝɣɩ-wɛ nɑ ɩ́ pɛlǝɣɩ pɑ kelɑ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ye tɔɣɔlɑsɩ ɩ́ lɑŋɑ tɔɣɔnɑɣɑ sɩ sǝkɩ kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ sɩ piyɑ nɑ́ɑ́ yɑ́ yem.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Pǝ wɛlǝtɑ mɑ ŋkpɑŋʋɣʋ tɑɑ","poem":1},{"lineBreak":true},{"text":"kɛ́ tɔm kɛ mukɑɣɑ tɛɛ","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"kɛ́ ɑhoo tɑɑ kɛ́ sɑɑ wei toosee ɑsɑɣɛɛ","poem":1},{"lineBreak":true},{"text":"kɔŋ nɑ tom pɩ́ɩ́ yǝlɑɑ tɔ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sɔɣɔntʋ wɑtʋ pǝlɑ-m tǝyʋlʋyʋlʋ,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ tɔnʋɣʋ tǝnɑ seliɣi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Heelim fɛtɑ mɑ ɩsɛntɑɑ nɑ mɑ","poem":1},{"lineBreak":true},{"text":"tɔnʋɣʋ tǝnɑ lʋlɩ kɑcǝncǝmpɔɣɔlɑsɩ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mɑ nɑɑkɑɣɑ nɔɣɔlʋ sǝŋɑɑ, mɑ tɑ nyǝmɩ-ɩ.","poem":1},{"lineBreak":true},{"text":"Ɩlɛnɑ mɑ nɩɩ pʋntʋ miitiɣi sɩ:","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yʋlʋ pǝsǝɣɩ nɑ ɩ́ tǝŋ tɑmpɑnɑ ɩsɩɩ weɣe Ɩsɔ kiŋ?","poem":1},{"lineBreak":true},{"text":"Yɑɑ ɩ pǝsǝɣɩ nɑ ɩ́ wɛɛ tǝnɑŋŋ ɩsɩɩ ɩ ŋmɑlʋ nɑ?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ye Ɩsɔ tɑ́ lɑ́ nɑɑni kɛ́ ɩ tǝmlɛ nyǝ́mɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ nɑɑkɩ ɩsɔtɑɑ tillɑɑ kiŋ kɛ kɑwɑlɑɣɑ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Kɑcɑŋfɑnɑ mpɑ ɩ ŋmɑnɑ cʋɣʋ nɑ pɑ tɔnǝŋ kɛ́ tɛtʋ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ yɔkʋɣʋ fɛɩ kɑtɛ ɩsɩɩ sonsompee tɔ?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ɩsɔ nɑŋǝɣɩ-wɛɣɛ ɩsɩɩ mʋlʋm kɛ kʋyɑkʋ kʋlʋmʋɣʋ.","poem":1},{"lineBreak":true},{"text":"Pɑɑ sɑɑlɩ tɑm, nɔɣɔlʋ ɩɩ tɩɩ pɑɑsǝɣǝnɑ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Pɑ weesuɣu ŋmɩɩsɩ cɛpɑ.","poem":1},{"lineBreak":true},{"text":"Ɩlɛnɑ pɑ́ sɩ́ pɑ fɛɩnɑ lǝmɑɣɑsɛɛ.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}