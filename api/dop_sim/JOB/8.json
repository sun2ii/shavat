":"Ɩsɔ pɑɑsǝɣǝnɑ-ŋ kɛ́ nɑ ɩ́ hɑ-ŋ","poem":1},{"lineBreak":true},{"text":"tǝcɑɣɑlɛ nte tǝ mʋnɑ-ŋ tɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hɑlɩ nyɑ́ wɛnɑʋ nɔɔnɔɔ nyǝm kɑ́","poem":1},{"lineBreak":true},{"text":"kǝlɩ kɑncɑɑlɑɣɑ nyǝm kɛ tɔɔʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Pɔɔsɩ lɔŋ nyǝ́mɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ń tɔkɩ pɛlɛ pɑ cɑɑnɑɑ lɑɣɑtʋ tɑsʋɣʋ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mpi tɔ, tete tete kɛ pǝ lʋlɑ tɑ́,","poem":1},{"lineBreak":true},{"text":"tǝ tɑ nyɩ pʋlʋ.","poem":1},{"lineBreak":true},{"text":"Tɑ weesuɣu ɩɩ lɑɑ tɛɛʋ kɛ cǝnɛɣɛ ɩsɩɩ ɩsotom.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Amɑ pɛlɛ pɑɑ tɑsɑ-ŋ lɑɣɑtʋ","poem":1},{"lineBreak":true},{"text":"kɛ timpi timpi pɑ nyǝmɑ́ tɔ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mʋlʋɣʋ*fɑ* ɩɩ sǝŋǝɣɩ timpi lʋm fɛɩ tɔ.","poem":1},{"lineBreak":true},{"text":"Pǝyele sǝsǝncɑŋɑ ɩɩ hɑtǝlǝɣǝnɑ nikɑɣɑ.","poem":1},{"noteId":3},{"text":"cǝnɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Lʋm ɩ́ nyɔɔwɑ kɑ wʋlǝɣɩ kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ tɑ tɩɩ sɛtǝtɑ-kɛ sɩ, pɑ́ lɑnɑ pʋlʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ḿpʋ́ɣʋ́ Ɩsɔ tɔ́ɔ́ sɔɔlɑɑ tɛɛsǝɣǝnɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ kisilɑɑ tɛɛlʋɣʋ nɑ́ɑ́ sɑɑlǝɣɩ yem.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Pɑ nɑɑni cɛkɩ kɛ́ ɩsɩɩ kponkpontu,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ nyʋɣʋ tǝtʋlɛ nɑ́ɑ́ wɛ ɩsɩɩ ɑcɑɣɑnyɑtʋɣʋ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ye pɑ nyǝkɑ pɑ tɛɛsɩ tɔɔ sɩ leŋliɣi kɛ́.","poem":1},{"lineBreak":true},{"text":"Pɑ nyɔkǝlǝɣǝnɑ-sǝɣɩ teu ɩlɛnɑ sɩ́ yɔkɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Pɑ wɛɛ kɛ́ ɩsɩɩ tʋɣʋ sǝŋʋɣʋ","poem":1},{"lineBreak":true},{"text":"ilim tɑɑ kɛ́ teu,","poem":1},{"lineBreak":true},{"text":"nɑ cǝlǝm tɔɔ kʋ tɑɑ","poem":1},{"lineBreak":true},{"text":"nɑ kʋ tiikɑsɩ kɛ hɑlǝm tǝnɑ tɔ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kʋ kɑŋ kʋ lilɑ kɛ́ nɑ ɑ́ lɛɣɛtǝnɑ pɛɛ huɣule,","poem":1},{"lineBreak":true},{"text":"nɑ ɑ́ hikiɣi nikɑɣɑ kɛ kʋkpɑmǝŋ hɛkʋ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Amɑ ye pɑ kpɛsɑ-kʋɣʋ kʋ lonte tɑɑ,","poem":1},{"lineBreak":true},{"text":"ɩlɛ tǝnɑ nyǝ́mɑ kpɛɛsɩ sɩ mpɛ pɑ tɑɑ nɑɑkɩ-kʋ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yʋlʋ ɩsɩɩ mpʋ tǝnɑɣɑ ntɛ́.","poem":1},{"lineBreak":true},{"text":"Kʋfɑlʋ kɑ́ kʋlǝnɑ ɩ lonte tɑɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ɩsɔ ɩɩ lɔɔkɩ tɑmpɑnɑ tǝŋlʋ,","poem":1},{"lineBreak":true},{"text":"pǝyele ɩ kɑɑ sǝnɑ ɩsɑɣɑlɑtʋ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ɩsɔ tɛŋ ɩ́ yele nɑ ń woŋ,","poem":1},{"lineBreak":true},{"text":"nɑ ń kpɑlǝsǝnɑ lɑŋhʋlʋmlɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Amɑ nyɑ́ kolontunɑɑ kɑ́ tɔɣɔnɑ fɛɛlɛ,","poem":1},{"lineBreak":true},{"text":"nɑ pǝ́ yɔkɩ ɑsɑɣɑɑ tɛɛsɩ.","poem":1}]}],"footnotes":[{"noteId":3,"caller":"ɑ","text":"Mʋlʋɣʋ: Pɛlɛ pɑ tɛ mʋlʋɣʋ yɑɑ pɑ tɛ sǝsǝncɑɑsɩ kɛ pɑ kɛɛsǝɣɩ","reference":{"chapter":8,"verse":11}}]},"thisChapterLink":"/api/dop_sim/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}