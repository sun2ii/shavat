{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"LAM","translationId":"dop_sim","name":"Wulɑ","commonName":"Wulɑ","title":"YOSALƐM TƆƆ WULA TAKƎLAƔA","order":25,"numberOfChapters":5,"sha256":"77763ac8ce078501516481585ff73a892831fbda01469ac2bda6bd7615e6863e","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/dop_sim/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"heading","content":["Tɑcɑɑ mǝŋnɑ-tʋɣʋ nyɑ́ kiŋ"]},{"type":"verse","number":1,"content":[{"text":"Tɑcɑɑ, tɑɑ sɔɔ mpi pǝ mɑɣɑnɑ-tʋ tɔ.","poem":1},{"lineBreak":true},{"text":"Nyǝnɩ, nɑ ń pɑɑsǝnɑ ɩsǝnɑ pɑ tʋʋkɩ-tʋ tɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kpɑɩ nyǝ́mɑ lɛɛkɑ tɑ́ tɛtʋ.","poem":1},{"lineBreak":true},{"text":"Mpɑ tǝ tɑ nyɩ tɔ pɑ cɑɣɑ tɑ́ tɛɛsɩ tɑɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tɑ́ cɑɑnɑɑ fɛɩ, nɑ pǝ́ yele tɑ́ toonɑɑ","poem":1},{"lineBreak":true},{"text":"kɛ leelɑɑ, nɑ tɑɣɑ suluwɑɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tǝ yɑkɩ tɑ́ mɑɣɑmɑɣɑ tɑ́ lʋm.","poem":1},{"lineBreak":true},{"text":"Tǝ fɛlǝɣɩ tɑ́ tɑɑsɩ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tɑ kʋnyɔntʋlɑɑ wɛ tɑ́ wɑɑlǝɣɩ tɑm kɛ́.","poem":1},{"lineBreak":true},{"text":"Tǝ kɑwɑ tǝtɔɣɔtɔɣɔ,","poem":1},{"lineBreak":true},{"text":"pɑɑ yeki-tʋ sɩ tǝ́ hɛɛsɩ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tǝ tiɣisiɣi Icipiti","poem":1},{"lineBreak":true},{"text":"nɑ Asilii pǝ nyǝ́mɑ kɛ niŋ kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ pǝ́cɔ́ tǝ́ tɔɣɔ nɑ tǝ́ hɑɣɑ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tɑ́ cɑɑnɑɑ lɑpǝnɑ ɩsɑɣɑtʋ.","poem":1},{"lineBreak":true},{"text":"Amɑ pɛlɛ pɑ sǝpɑ.","poem":1},{"lineBreak":true},{"text":"Ɩlɛnɑ tɑɑ tɔkɩ tǝ nyɑŋ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yomɑɑ pǝsǝnɑ ntɛɣɛ tɑ́ cɑɑnɑɑ.","poem":1},{"lineBreak":true},{"text":"Pǝ́cɔ́ nɔɣɔlʋ kɑɑ yɑ-tʋɣʋ pɑ niŋ tɑɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tǝ lɑkɩ tɑ́ weesiŋ kɛ ɑwusɑ kɛ","poem":1},{"lineBreak":true},{"text":"wʋlɑɣɑ tɛtʋ tɑɑ ŋmɩɩlɑɑ niŋ tɑɑ kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ pǝ́cɔ́ tǝ́ hiki nɑ tǝ́ tɔɣɔ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nyɔɣɔsɩ hɑŋɑ tɑ́ tɔnǝŋ kɛ́ ɩsɩɩ","poem":1},{"lineBreak":true},{"text":"tǝ wɛ mǝsɑsɩ tɑɑ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pɑ kpipɑ Siyɔŋ nɑ Yutɑ ɑcɑlɛɛ tɑɑ ɑlɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ pɛɛlɑɑ, nɑ pɑ́ wɑkǝlǝɣɩ-wɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Pɑ pusɑ wulɑʋ wɑɑlɩ nyǝ́mɑ nɑ tɩɩŋ.","poem":1},{"lineBreak":true},{"text":"Pɑ tɑ tʋnɑ ɑkpɑtǝlɑɑ kɛ pɑɑ pǝcɔ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nɑmlɛ nɑŋʋɣʋ nɩɩ ɩfepiyɑ.","poem":1},{"lineBreak":true},{"text":"Piyɑ nɑ́ sǝɣǝlɑ tɑɑsɩ nɑ sɩ́ seliɣi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ɩcɑtɛ sɔsɑɑ nɑɑ tɑsǝɣɩ hʋʋlɛ tɑɑ kɛ́ cɑɣɑlɛ.","poem":1},{"lineBreak":true},{"text":"Pǝyele ɩfepiyɑ nɑ́ hɛɛsɑ sɑŋkʋnɑɑ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tɑ́ lɑŋhʋlʋmlɛ yɑwɑ.","poem":1},{"lineBreak":true},{"text":"Lǝyɑɣɑ lɛɛtɑ tɑ́ pɑɑlɛ lonte.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tɑ́ teeli sǝpɑ.","poem":1},{"lineBreak":true},{"text":"Tǝ pǝsɑ mpusi nyǝ́mɑ kɛ́.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, tǝ lɑpɑ ɩsɑɣɑtʋ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tɑ́ lɑŋɑ wɑkǝlɑ sɔsɔm.","poem":1},{"lineBreak":true},{"text":"Ɩsǝlʋm yʋlǝsǝɣɩ tɑ́ ɩsɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mpi tɔ, Siyɔŋ pʋɣʋ pǝsɑ wʋlɑɣɑ tɛtʋ","poem":1},{"lineBreak":true},{"text":"nɑ tɑɑlɛ hɑsɩ cɔɔkɩ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Amɑ Tɑcɑɑ nyɑɣɑlɛ wulɑʋ kɛ tɑm tɔɔ.","poem":1},{"lineBreak":true},{"text":"Nyɑ́ kɑwulɑɣɑ fɛɩ tǝnɑɣɑ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Pepe tɔɔ kɛ́ n lɔ-tʋɣʋ tɑm tɔɔ?","poem":1},{"lineBreak":true},{"text":"Pepe tɔɔ kɛ́ n sɔɔ tɑ́ tɔɔ kɛ́ tɑ́ weesuɣu tǝnɑ?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mǝlǝnɑ-tʋɣʋ nyɑ́ kiŋ nɑ tǝ́ pǝsɩ","poem":1},{"lineBreak":true},{"text":"nyɑ́ nyǝ́mɑ tǝkpɑtɑɑ.","poem":1},{"lineBreak":true},{"text":"Lɑɣɑsɩ tɑ́ weesiŋ ɩsɩɩ hɑtoo ɩlɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Nyɑ́ tɑɑ wɛɛ sɩ n kɑ́ lɔ-tʋ tǝkpɑtɑɑ nɑ?","poem":1},{"lineBreak":true},{"text":"N kɑ́ mʋ-tʋ nɑ pɑ́ɑ́nɑ́ nɑ pǝ́ tɛɛ mpǝle nɑ?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}