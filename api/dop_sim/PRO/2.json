{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PRO","translationId":"dop_sim","name":"Atuwɑ","commonName":"Atuwɑ","title":"ATUWA TAKƎLAƔA","order":20,"numberOfChapters":31,"sha256":"03a24dc89243635ebdf859debb95218920074325c45235f3eb08a3757363d6e2","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/dop_sim/PRO/31.json","totalNumberOfVerses":903},"chapter":{"number":2,"content":[{"type":"heading","content":["Ləmɑɣɑsɛɛ wɑɑsʋɣʋ"]},{"type":"verse","number":1,"content":[{"text":"Mɑ pəyɑlʋ ye n mʋɣɩ mɑ kʋyɔɣɔtʋtʋ,","poem":1},{"lineBreak":true},{"text":"nɑ ń tɔkəɣɩ mɑ kʋsəsɩɩtʋ kɛ nyɑ́ tɑɑ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ye n keŋ ŋkpɑŋʋɣʋ nɑ ləmɑɣɑsɛɛ kʋsɛɣɛsətʋ,","poem":1},{"lineBreak":true},{"text":"nɑ ń pəsənɑ lɑɑkɑlɩ kɛ nyɑ́ tɑɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ye n yɑɑ nyəm sɩ pə́ sənɑ-ŋ.","poem":1},{"lineBreak":true},{"text":"Nɑ ń kʋsɩ nyɑ́ nɔɣɔ nɑ ń yɑɑ nyʋɣʋ tɑɑ mɑɣɑsəm.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ye n pɛɛkəɣɩ-wɩ ɩsɩɩ liɣitee,","poem":1},{"lineBreak":true},{"text":"nɑ ń cɑɑkɩ-wɩ nɑ ɩsəlɛ kʋsɛɛmlɛ ɩsɩɩ wɛnɑʋ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɩlɛ mpʋ pə tɑɑ kɛ́ n kɑ́ cɛkənɑ Tɑcɑɑ nyɑmnɑʋ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩsənɑ n kɑ́ nyəmɩ-ɩ tɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mpi tɔ, Tɑcɑɑ hɑɑkənɑ ləmɑɣɑsɛɛ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ nɔɣɔ tɑɑ lɩɩkɩ nyəm nɑ nyʋɣʋ tɑɑ mɑɣɑsəm tɔm.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ɩ yeki nɑ tɑmpɑnɑ təŋlɑɑ təhikile ɩɩ lɑŋəɣɩ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ kentiɣi mpɑ pɑ lɑkɩ siɣisuɣu tɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɩ wɑɑsəɣɩ mpɑ nɑ lɛlɑɑ pɑ wɛ leleŋ tɔ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ hɑsəɣɩ ɩ yəlɑɑ nɔɔhɛɛ tɛɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wɑɑtʋ ɩnəɣɩ n kɑ́ cɛkənɑ siɣisuɣu nɑ mpi pə təŋɑɑ tɔ,","poem":1},{"lineBreak":true},{"text":"nɑ mpɑɑŋ wei ɩ pukinɑ təpɑntɛ tɑɑ tɔ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mpi tɔ, n kɑ́ wɛɛnɑ ləmɑɣɑsɛɛ kɛ nyɑ́ lotu tɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ nyəm hɛɛsɩ nyɑ́ lɑŋlɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N kɑ́ wɛɛnɑ nyəm nɑ nyʋɣʋ tɑɑ mɑɣɑsəm,","poem":1},{"lineBreak":true},{"text":"nɑ pɩɩ kenti nyɑ́ tɔɔ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nɑ pə́ yɑ-ŋ kɑwɑlɑɣɑ mpɑɑʋ tɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩsɑɣɑtʋ yɔɣɔtəlɑɑ niŋ tɑɑ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nɑ mpɑ pɑ yelɑ mpɑɑʋ kʋsiɣisuɣu","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ kpɑɣɑ səkpɛtʋɣʋ nyəŋkʋ,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"nɑ pɑ lɑŋlɛ hɛɛkənɑ ɩsɑɣɑtʋ lɑpʋ","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ yɔɔləɣənɑ ɩsɑɣɑtʋ tɔ pɑ niŋ tɑɑ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mpɛ ɩnɩ pɑ mpɑɑŋ kɛɛwɑɣɑ","poem":1},{"lineBreak":true},{"text":"nɑ pɑ hɑpɛɛ nɑ́ɑ́ koŋlɑɑ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ɩlɛnɑ pə́ yɑ-ŋ ɑlʋ kpɑɩ tʋ","poem":1},{"lineBreak":true},{"text":"wei ɩ tʋsəɣɩ yəlɑɑ nɑ ɩ nɔɔleleŋ tɔ ɩ niŋ tɑɑ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wei ɩ kisɑ ɩ pɑɑlʋ wei ɩ cɛpɑ ɩ ciɣitɑ","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ sɔɔ Ɩsɔ nɔɣɔ pɛɛlʋɣʋ tɔɔ tɔ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Alʋ ɩnɩ ɩ təyɑɣɑ wɛnnɑ səm hɔɣɔlʋɣʋ kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ mpɑɑʋ sʋʋkɩ ɑtɛtəlɛ tɑɑ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mpɑ pɑ puki ɩ tɛ tɔ pɑ tɑɑ nɔɣɔlʋ ɩɩ tɑsəɣɩ məlʋɣʋ.","poem":1},{"lineBreak":true},{"text":"Pəyele pɑɑ tɑsəɣɩ weesuɣu mpɑɑʋ kɛ nɑʋ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mpʋ tɔ, təŋ yəlɑɑ kʋpɑmɑ ɩkpɑtɛ,","poem":1},{"lineBreak":true},{"text":"nɑ ń tɔkɩ tɑmpɑnɑ təŋlɑɑ mpɑɑʋ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mpi tɔ, mpɛ pɑ cɑkənɑ tɛtʋ tɑɑ.","poem":1},{"lineBreak":true},{"text":"Mpɑ pɑ fɛɩnɑ kɑwɑliyɑ tɔ mpɛ pɑɑ wɛɛnɑ tənɑ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Amɑ pɩɩ kpiisi ɑsɑɣɑɑ kɛ tɛtʋ tɑɑ.","poem":1},{"lineBreak":true},{"text":"Pɩɩ ləsɩ Ɩsɔ lɔlɑɑ kɛ tə tɑɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}