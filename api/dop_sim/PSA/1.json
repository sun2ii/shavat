neBreak":true},{"text":"Pə tɔɔ kɛ́ pɑ kɑɑ tʋlɩ-təɣɩ Ɩsɔ hʋʋlɛ wule. Nɑ wɑkəllɑɑ","poem":1},{"lineBreak":true},{"text":"nɑ́ kɑɑ sʋʋ Ɩsɔ yəlɑɑ kpekəle tɑɑ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mpi tɔ, Tɑcɑɑ pɑɑsəɣənɑ siɣisilɑɑ kɛ́.","poem":1},{"lineBreak":true},{"text":"Ɩlɛnɑ wɑkəllɑɑ mpɑɑʋ nɑ́ɑ́ wɑkələɣɩ-wɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}