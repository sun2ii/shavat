{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":101,"content":[{"type":"heading","content":["Wulɑʋ sɩɩ ɩ nɔɣɔ kɛ Ɩsɔ ɩsɛntɑɑ sɩ ɩ kɑ́ təŋ siɣisuɣu"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu.",{"lineBreak":true},{"text":"Kʋpɑntʋ nɑ tɑmpɑnɑ təŋʋɣʋ pə yontu kɛ mɑ yoo.","poem":1},{"lineBreak":true},{"text":"Tɑcɑɑ nyɑɣɑ mɑ yoo-tɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mɑɑ kɑɑsɩ mɑ tɩ nɑ mpɑɑʋ kʋsiɣisuɣu.","poem":1},{"lineBreak":true},{"text":"Pəlee kɛ́ n kɑ́ kɔɔ mɑ kiŋ?","poem":1},{"lineBreak":true},{"text":"Mɑɑ tɔnɑ lotu kʋlʋmtʋ kɛ mɑ təyɑɣɑ tɑɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mɑ kɑɑ hɑ ɩsɑɣɑm kɛ mpɑɑʋ,","poem":1},{"lineBreak":true},{"text":"mɑ tɑɑ kɑ́ kpɑɑkənɑ mpɑ pɑ kisiɣi pɑ Ɩsɔsɛɛlɛ tɔɣɔ.","poem":1},{"lineBreak":true},{"text":"Pɑ Ɩsɔsɛɛlɛ ńtɛ́ tə kɑɑ mɑtənɑ-m.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nyɑmlɛ ɩsɑɣɑlɛ kɑ́ hɑtələnɑ-m,","poem":1},{"lineBreak":true},{"text":"mɑɑ cɑɑkɩ sɩ mɑ nɑ ɩsɑɣɑʋ tə́ kɑɑ pʋlʋ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mɑɑ wɑkəlɩ wei ɩ cɑkənɑ ɩ tɔɣɔntəlɛ kɛ mukɑɣɑ tɔ.","poem":1},{"lineBreak":true},{"text":"Pəyele mɑɑ cɑɑkɩ kɑlɑmpɑɑnɩ tʋ.","poem":1},{"lineBreak":true},{"text":"Nɑ wei ɩ lotu tɑɑ suwɑ pɔpɔtʋ tɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mɑɑ nyənɩ tɛtʋ tɑɑ kʋpɑmɑ tɔɔ kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ cɑɣɑ mɑ kɔŋkɔŋ tɑɑ.","poem":1},{"lineBreak":true},{"text":"Wei ɩ tɔŋ mpɑɑʋ kʋsiɣisuɣu tɑɑ tɔɣɔlɛ mɑ təmlɛ tʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wei ɩ hɑ ɩ təɣɩ ŋmɩɩləm tɑɑ tɔ ɩɩ cɑkɩ mɑ təyɑɣɑ tɑɑ.","poem":1},{"lineBreak":true},{"text":"Wei ɩ looliɣi tɔ ɩ kɑɑ səŋ mɑ ɩsɛntɑɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pɑɑ tɑnɑŋ ŋku mɑɑ wɑkəlɩ tɛtʋ tɑɑ ɑsɑɣɑɑ tənɑɣɑ.","poem":1},{"lineBreak":true},{"text":"Ḿpʋɣʋ mɑɑ kpiisinɑ Tɑcɑɑ ɩcɑtɛ","poem":1},{"lineBreak":true},{"text":"tɑɑ kɛ́ mpɑ pɑ lɑkɩ ɩsɑɣɑtʋ tɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}