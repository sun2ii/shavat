{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":108,"content":[{"type":"heading","content":["Tɑnɑŋ yontu"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu nti tə wɛ yonyoolɑɑ",{"text":"nyʋɣʋ tʋ yontunɑɑ tɑɑ tɔɣɔlɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hɑɩ, mɑ Ɩsɔ, mɑ tɛmɑ mɑ tɑɑ sɩ","poem":1},{"lineBreak":true},{"text":"mɑ́ yoo-ŋ yontu nɑ mɑ lotu tənɑɣɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mɑ cəməŋ ɩ́ fe, mɑɑ fe nɑ pə́cɔ pə nyɑɑlɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tɑcɑɑ, mɑɑ sɛɛ-ŋ yəlɑɑ tɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ yoo-ŋ yontu kɛ piitimnɑɑ tɑɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nyɑ́ pɛɛlɛɛ kəlɑ ɩsɔtɔnʋɣʋ kɛ kʋlʋɣʋ,","poem":1},{"lineBreak":true},{"text":"nɑ nyɑ́ kʋpɑntʋ nɑ́ɑ́ kɑləsənɑ hɑtoo ɩsɔtɑɑ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hɑɩ, Ɩsɔ, hʋlɩ nyɑ́ tɔɔməŋ kɛ ɩsɔtɑɑ.","poem":1},{"lineBreak":true},{"text":"Nyɑ́ teu ɩ́ nɑ́ tɛtʋ tənɑ tɔɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lɑ mpʋ ɩlɛnɑ pə hɛtɩ nyɑ́ kʋsɔɔllɑɑ.","poem":1},{"lineBreak":true},{"text":"Wɑɑsɩ-m nɑ nyɑ́ niŋ ntɔɣɔŋ.","poem":1},{"lineBreak":true},{"text":"Mʋ tɑ́ sələmʋɣʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ɩsɔ yɔɣɔtɑ ɩ kutuluɣu nɑŋŋ nyəŋkʋ tɑɑ sɩ:","poem":1},{"lineBreak":true},{"text":"Mɑ́ɑ́ tɔɣɔnɑ ɑkɑɩtʋ nɑ mɑ́ tɑlɑ Sikɛm ɩcɑtɛ.","poem":1},{"lineBreak":true},{"text":"Mɑɑ mɑɣɑsɩ Sukɔtɩ tɛtɛkəlɛ nɑ ŋmənɑɣɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mɑ́ tənnɑ Kɑlɑɑtɩ nɑ Mɑnɑsee.","poem":1},{"lineBreak":true},{"text":"Ɩfəlɑyim kɛlɛ mɑ nyəɣəlʋɣʋ kɑhukɑ.","poem":1},{"lineBreak":true},{"text":"Yutɑ kɛlɛ mɑ kɑwulɑɣɑ kpɑ́tʋɣʋ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mowɑpʋ tɛtʋ ntɛ́ mɑ lʋm kʋsɔsɔm tətʋlɛ.","poem":1},{"lineBreak":true},{"text":"Ɩtɔm nyəntʋ kɛ mɑ ntɑŋkpɑlɑ təsɩɩlɛ.","poem":1},{"lineBreak":true},{"text":"Ɩlɛnɑ mɑ́ kiisiɣi yoou kɑkiisɑsɩ kɛ Filiisi nyə́mɑ tɔɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Awe kɑ́ ponɑ-m Ɩtɔm?","poem":1},{"lineBreak":true},{"text":"Awe kɑ́ tʋ-m Ɩtɔm koluŋɑ ɩcɑtɛ tɑɑ?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Pə tɑɣɑ Ɩsɔ nyɑ́?","poem":1},{"lineBreak":true},{"text":"Pəyele nyɑ́ lɔnɑ-tʋ,","poem":1},{"lineBreak":true},{"text":"nn tɑsəɣɩ tɑ́ yoolɑɑ kɛ təŋʋɣʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kɔɔ nɑ ń yɑ-tʋɣʋ kolontu tɔm tɑɑ,","poem":1},{"lineBreak":true},{"text":"yʋlʋ wɑɑsʋɣʋ wɛ kpɛtɛ kɛ́.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ɩsɔ toŋ tɑɑ tɩɩ lɑ kookɑlənɑɑ kɛ́.","poem":1},{"lineBreak":true},{"text":"Ɩnɩ ɩ kɑ́ nɑŋtənɑ tɑ́ kolontunɑɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":14}