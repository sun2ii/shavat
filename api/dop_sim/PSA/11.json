":"nɑ ɩ wɛ ɩ təsɛɛlɛ nɑŋŋ nyəntɛ tɑɑ cənɛ.","poem":1},{"lineBreak":true},{"text":"Ɩ nɑɑkɩ yəlɑɑ kɛ timpi pɑ wɛɛ tɔɣɔ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ nyəmɑ́ pɑ kʋlɑpəlɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ nyəmɑ siɣisilɑɑ kɛ́.","poem":1},{"lineBreak":true},{"text":"Amɑ ɩ tɑɑ kpɑɑnɑ ɑsɑɣɑɑ nɑ mʋsʋntʋnɑɑ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɩ yeki nɑ kɔkɔ pɛɛ nɑ pə heelim tii pɑ tɔɔ.","poem":1},{"lineBreak":true},{"text":"Pɑ pɑɑ tete ntɛ́.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mpi tɔ, Tɑcɑɑ kɛ́ siɣisilu kɛ́","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ sɔɔlɑ kʋsiɣisim.","poem":1},{"lineBreak":true},{"text":"Siɣisuɣu təŋlɑɑ kɑ́ nɑ-ɩ nɑ pɑ ɩsəpee.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}