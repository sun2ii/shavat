ɑ́ pʋɣʋ nɑŋŋ nyəŋkʋ tɔɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tɑcɑɑ tɛmɑ tuuu ɩ kɑɑ tɑsɑ lɑɣɑsʋɣʋ.","poem":1},{"lineBreak":true},{"text":"Ɩ yɔɣɔtɑɑ sɩ:","poem":1},{"lineBreak":true},{"text":"N kɛ́ kɔtʋlʋ sɔsɔ kɛ tɑm tɔɔ kɛ́,","poem":1},{"lineBreak":true},{"text":"ɩsɩɩ Mɛləcisetɛɛkɩ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ wɛ nyɑ́ ntɔɣɔŋ tɔɔ kɛ́.","poem":1},{"lineBreak":true},{"text":"Ɩ kɑ́ wɑkəlɩ ɑwulɑɑ kɛ ɩ pɑ́ɑ́nɑ́ kʋyɑkʋ wule.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɩnɩ ɩ hʋʋkənɑ nɑ piitimnɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ sətɑɑ sɔɣɔtɑ pɑɑ timpi.","poem":1},{"lineBreak":true},{"text":"Ɩ wɑkələɣɩ ɑwulɑɑ kɛ tɛtʋ tənɑ tɑɑ kɛ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ɩ nyɔɔkɩ lʋm kɛ lɔɔʋ tɑɑ kɛ́ tɔntɛ wɑɑtʋ kɛ́.","poem":1},{"lineBreak":true},{"text":"Pə tɔɔ kɛ́ ɩ kʋsəɣɩ nyʋɣʋ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}