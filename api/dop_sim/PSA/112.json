{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":112,"content":[{"type":"heading","content":["Tɑcɑɑ kooliɣi kʋpɑntʋ kɛ ɩ yəlɑɑ kʋpɑmɑ"]},{"type":"verse","number":1,"content":["Ɩ́ sɑ Tɑcɑɑ.",{"lineBreak":true},{"text":"Leleŋ nɩɩlʋ ntɛ́ wei ɩ nyɑŋnɑ Tɑcɑɑ tɔ.","poem":1},{"lineBreak":true},{"text":"Ɩ lɑŋlɛ hɛɛnɑ Ɩsɔ kʋsəsɩɩtʋ lɑpʋ kɛ́.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɩ kʋlʋlɑɑ kɑ́ lɑ sɔsɑɑ kɛ tɛtʋ tɔɔ.","poem":1},{"lineBreak":true},{"text":"Ɩsɔ kooliɣi kʋpɑntʋ kɛ tɑmpɑnɑ təŋlɑɑ piitim.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wɛnɑʋ nɑ təcɑɣɑnɑʋ wɛnnɑ pə tɛ yʋlʋ təyɑɣɑ tɑɑ.","poem":1},{"lineBreak":true},{"text":"Ɩsɔ lɑŋlɛ hɛɛnɑ-ɩ tɑm tɔɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kɔkɔ nɑɑkɩ səkpɛtʋɣʋ tɑɑ kɛ́ tɑmpɑnɑ təŋlʋ.","poem":1},{"lineBreak":true},{"text":"Kɔkɔ nɑɑkɩ wei ɩ wɛnɑ suulu nɑ ɩ́ wɛnɑ lɛlɑɑ pətɔɔtəlɛ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ təŋəɣɩ kʋsiɣisim tɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pə wɛ teu sɩ yʋlʋ ɩ́ hʋləɣɩ suulu nɑ ɩ́ kəntəɣɩ.","poem":1},{"lineBreak":true},{"text":"Pə wɛ teu sɩ yʋlʋ ɩ́ təŋ siɣisuɣu nɑ ɩ́ lɑkənɑ ɩ təmɑ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ye n lɑkɩ mpʋ nn cɛŋləɣɩ.","poem":1},{"lineBreak":true},{"text":"Pɑ tɔɔsəɣɩ siɣisilu tɔɔ kɛ́ tɑm tɔɔ kɛ́.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ɩ lɑŋlɛ ɩɩ tɔɔkənɑ lɑŋwɑkəllɛ lɑɑpɑɑlɩ,","poem":1},{"lineBreak":true},{"text":"ɩ tɔkɑ ɩ təɣɩ, Tɑcɑɑ kɛ ɩ lɑkɩ nɑɑni.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Siɣisilu tɔkɑ ɩ təɣɩ, sɔɣɔntʋ fɛɩ-ɩ.","poem":1},{"lineBreak":true},{"text":"Ɩ kɑ nyənɩ ɩ kolontunɑɑ kpisuɣu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ɩ hɑɑkɩ kʋnyɔntʋnɑɑ kɛ́ nɑ ɩ́ yeki niŋ.","poem":1},{"lineBreak":true},{"text":"Ɩsɔ lɑŋlɛ hɛɛnɑ-ɩ tɑm tɔɔ kɛ́.","poem":1},{"lineBreak":true},{"text":"Siɣisilu toŋ sɔɔsəɣɩ nɑ yəlɑɑ tʋɣʋnɑ-ɩ teu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ɩsɑɣɑʋ nɑ́ nɑɑkɩ-ɩ ɩlɛnɑ pɑ́ɑ́nɑ́ kpɑ-ɩ.","poem":1},{"lineBreak":true},{"text":"Ɩ nyɑsəɣɩ ɩ təɣɩ kelɑ nɑ ɩ́ lɔɔkɩ ɩ ɑpɑlʋtʋ.","poem":1},{"lineBreak":true},{"text":"Asɑɣɑɑ kʋnyɩɩlʋɣʋ sɑɑləɣɩ yem kɛ́.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}