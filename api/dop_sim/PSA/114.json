{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":114,"content":[{"type":"heading","content":["Wɑɑtʋ wei Ɩsɛɣɛlɩ nyə́mɑ lɩɩwɑ Icipiti tɛtʋ tɑɑ tɔ"]},{"type":"verse","number":1,"content":["Wɑɑtʋ wei Ɩsɛɣɛlɩ nyə́mɑ lɩɩwɑ Icipiti tɛtʋ tɑɑ tɔ,",{"text":"wɑɑtʋ wei Yɑkɔpʋ lʋlʋɣʋ nyə́mɑ lɩɩ piitim lɛmpɩ tɔm","poem":1},{"lineBreak":true},{"text":"yɔɣɔtəlɑɑ mpɛ pɑ tɛ tɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ḿpʋɣʋ Yutɑ pəsɑ Tɑcɑɑ kɔtɑɣɑ təlɑtɛ","poem":1},{"lineBreak":true},{"text":"nɑ Ɩsɛɣɛlɩ nɑ́ɑ́ pəsɩ Tɑcɑɑ tɛtʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Teŋku nɑ́-wɛ́ nɑ ɩ́lɛ́ ɩ se.","poem":1},{"lineBreak":true},{"text":"Yɑɑtɑnɩ pɔɣɔ nɑ́ məlɑ wɑɑlɩ wɑɑlɩ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɩlɛnɑ pɔɔŋ ŋmɑɑ ɩsɩɩ ɩwɑɑŋ,","poem":1},{"lineBreak":true},{"text":"nɑ pulɑsɩ nɑ́ɑ́ ŋmɑɑ ɩsɩɩ ɩwɛɛsɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Teŋku, n seeki suwe?","poem":1},{"lineBreak":true},{"text":"Yɑɑtɑnɩ, nɑ́ mələɣɩ wɑɑlɩ wɑɑlɩ suwe?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pɔɔŋ, mə ŋmɑɑkɩ ɩsɩɩ ɩwɑɑŋ suwe?","poem":1},{"lineBreak":true},{"text":"Pulɑsɩ, mə ŋmɑɑkɩ ɩsɩɩ ɩwɛɛsɩ suwe?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tɛtʋ nyɑ́ɑ́ sele Tɑcɑɑ ɩsɛntɑɑ.","poem":1},{"lineBreak":true},{"text":"Sele Yɑkɔpʋ Ɩsɔ ɩsɛntɑɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɩnɩ ɩ pəsəɣənɑ kʋkpɑmʋɣʋ kɛ lɩɩlɛ,","poem":1},{"lineBreak":true},{"text":"nɑ pɩɩʋ kɛ lʋm sɛɛlʋ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}