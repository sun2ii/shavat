{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":115,"content":[{"type":"heading","content":["Ɩsɔ tike ntɛ́ teeli tʋ"]},{"type":"verse","number":1,"content":["Tɑcɑɑ, tɑɑ tʋ-tʋɣʋ teeli.",{"text":"Tɑɑ tʋ-tʋ yoo.","poem":1},{"lineBreak":true},{"text":"Amɑ tʋ teeli kɛ nyɑ́ hətɛ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, n kɛ́ kʋpɑŋ nɑ tɑmpɑnɑ tʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Pepe tɔɔ kɛ́ piitimnɑɑ pɔɔsəɣɩ sɩ:","poem":1},{"lineBreak":true},{"text":"Leɣe mə Ɩsɔ ɩnɩ ɩ wɛɛ?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tɑ Ɩsɔ wɛ ɩsɔtɑɑ kɛ́.","poem":1},{"lineBreak":true},{"text":"Ɩ lɑkɩ mpi ɩ sɔɔlɑɑ tɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amɑ mpɛ pɑ tɩɩŋ kɛ wʋlɑnɑɑ nɑ liɣitee","poem":1},{"lineBreak":true},{"text":"nnɑ yəlɑɑ niŋ lupɑ tɔɣɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pɑ tɩɩŋ ɩnɩ ɩ wɛnɑ nɔɔsɩ, ɩlɛ ɩɩ yɔɣɔtəɣɩ nɑtəlɩ.","poem":1},{"lineBreak":true},{"text":"Pə́cɔ ɩ wɛnɑ ɩsɛ, ɩɩ nɑɑkɩ pʋlʋ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɩ wɛnɑ ŋkpɑŋŋ, ɩɩ nɩɩkɩ nɑtəlɩ.","poem":1},{"lineBreak":true},{"text":"Pə́cɔ ɩ wɛnɑ mɩɩnɑ, ɩɩ nɩɩkɩ sɔŋ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ɩ wɛnɑ niŋ, ɩɩ pəsəɣɩ nɑ ɩ́ tokinɑ pʋlʋ.","poem":1},{"lineBreak":true},{"text":"Pə́cɔ ɩ wɛnɑ nɔɔhɛɛ, ɩɩ tɔŋ.","poem":1},{"lineBreak":true},{"text":"Pəyele ɩɩ tɩɩ mʋtəɣɩ ɩ luɣu tɛɛ kɛ́ mʋtʋɣʋ mɑɣɑmɑɣɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mpɑ pɑ luki tɩɩŋ ɩnɩ nɑ pɑ́ tʋɣʋ-ɩ nɑɑni tɔ,","poem":1},{"lineBreak":true},{"text":"pɑ́ wɛɛ ɩsɩɩ tɩɩŋ ɩnɩ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ɩsɛɣɛlɩ nyə́mɑ, ɩ́ pɛtɩ mə təɣɩ Tɑcɑɑ,","poem":1},{"lineBreak":true},{"text":"ɩnɩ ɩ teŋnɑ-mɛ nɑ ɩ́ kentiɣi mə tɔɔ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Alɔŋ təyɑɣɑ nyə́mɑ mɛ ɩ́ pɛtɩ mə təɣɩ Tɑcɑɑ,","poem":1},{"lineBreak":true},{"text":"ɩnɩ ɩ teŋnɑ-mɛ nɑ ɩ́ kentiɣi mə tɔɔ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mpɑ mɛ ɩ́ nyɑŋnɑ Tɑcɑɑ tɔ, ɩ́ pɛtɩ-ɩ mə tɩ.","poem":1},{"lineBreak":true},{"text":"Ɩnɩ ɩ teŋnɑ-mɛ, nɑ ɩ́ kentiɣi-mɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tɑcɑɑ ɩɩ sɔɔkɩ tɑ́ tɔm kɛ pɑɑ pəcɔ.","poem":1},{"lineBreak":true},{"text":"Ɩ kɑ́ kooli tɑ́ tənɑɣɑ kʋpɑntʋ kɛ́.","poem":1},{"lineBreak":true},{"text":"Ɩ kɑ́ kooli Ɩsɛɣɛlɩ nyə́mɑ kɛ kʋpɑntʋ.","poem":1},{"lineBreak":true},{"text":"Ɩ kɑ́ kooli Alɔŋ nyə́mɑ kɛ pɑ nyəntʋ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ɩ kɑ́ kooli kʋpɑntʋ kɛ mpɑ pɑ nɩɩkənɑ-ɩ tɔ,","poem":1},{"lineBreak":true},{"text":"pɑɑ sɔsɑɑ pɑɑ piyɑ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ ɩ́ yele nɑ mə lʋlʋŋ huki.","poem":1},{"lineBreak":true},{"text":"Ɩ́ lɑ nɑ mə nɑ mə piyɑ ɩ́ wɛɛ pɑɣɑlɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ wei ɩ lɑpɑ ɩsɔtɔnʋɣʋ","poem":1},{"lineBreak":true},{"text":"nɑ ɑtɛ tɔ ɩ́ kooli-mɛɣɛ kʋpɑntʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Tɑcɑɑ tike tənnɑ ɩsɔtɔnʋɣʋ","poem":1},{"lineBreak":true},{"text":"ɩlɛnɑ ɩ hɑ yəlɑɑ kɛ tɛtʋ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sətɑɑ ɩɩ pəsəɣɩ nɑ pɑ́ sɛɛ Tɑcɑɑ.","poem":1},{"lineBreak":true},{"text":"Mpɑ pɑ wɛ ɑtɛtəlɛ tɑɑ timpi sumɑ tiɣitiɣi tɔ","poem":1},{"lineBreak":true},{"text":"Pɑɑ pəsəɣɩ nɑ pɑ́ sɛɛ Ɩsɔ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Amɑ tɑ́ɑ́ sɑ Tɑcɑɑ kɛ pə kpɑɣɑʋ nɔɔnɔɔ tɔ,","poem":1},{"lineBreak":true},{"text":"hɑlənɑ tɑm tɔɔ.","poem":1},{"lineBreak":true},{"text":"Ɩ́ sɑ Tɑcɑɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}