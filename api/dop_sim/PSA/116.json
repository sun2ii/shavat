{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":116,"content":[{"type":"heading","content":["Yʋlʋ wei pə yɑpɑ səm tɑɑ tɔ ɩ sələmʋɣʋ"]},{"type":"verse","number":1,"content":["Mɑ sɔɔlɑ Tɑcɑɑ kɛ́.",{"text":"Mpi tɔ, n nɩɩkɩ mɑ nɔɣɔ nɑ mɑ wiinɑʋ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N kemɑ ŋkpɑŋʋɣʋ nɑ mɑ tɔɔ.","poem":1},{"lineBreak":true},{"text":"Mɑɑ sələmɩ-ŋ kɛ́, hɑlənɑ mɑ səm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Səm kɑ tɑmɑ-m kotɑɣɑ kɛ́.","poem":1},{"lineBreak":true},{"text":"Atɛtəlɛ sɔɣɔntʋ nɑ́ pɩɩ-m.","poem":1},{"lineBreak":true},{"text":"Mɑ wɛ nəɣəsɛɛ nɑ lɑŋwɑkəllɛ tɑɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ḿpʋɣʋ mɑ yɑ́ɑ́ Tɑcɑɑ nyɑ́ hətɛ.","poem":1},{"lineBreak":true},{"text":"Hɑɩ, Ɩsɔ mɑ wiikinɑ-ŋ sɩ, ń wɑɑsɩ-m.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ n wɛnɑ suulu kɛ́ nɑ ń siɣisɑɑ.","poem":1},{"lineBreak":true},{"text":"Tɑ Ɩsɔ n kɛ́ pətɔɔtəlɛ tʋ kɛ́.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ n pɑɑsəɣənɑ ɑcɑmɑɑ kɛ́.","poem":1},{"lineBreak":true},{"text":"Mɑɑ kɛ wɑhɑlɑ tʋ kɛ́, nɑ n wɑɑsɩ-m.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mɑ yɔɣɔtɑ mɑ tɑɑ sɩ, mɑɑ hɛɛsɩ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, Tɑcɑɑ lɑpɑ-m kʋpɑntʋ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nyɑ́ yɑpənɑ-m səm nɔɣɔ tɑɑ, nɑ ń hɩɩsɩ mɑ ɩsəlʋm.","poem":1},{"lineBreak":true},{"text":"N hɑsɑ mɑ nɔɔhɛɛ tɛɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mɑɑ tɔ Tɑcɑɑ nyɑ́ ɩsɛntɑɑ","poem":1},{"lineBreak":true},{"text":"kɛ weesuɣu nyə́mɑ tɛtʋ tɑɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Pɑɑ wɑɑtʋ wei mɑɑ tɔmɑ sɩ mɑ kɛ́ wɑhɑlɑ tʋ tɔ,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ wɛnɑ nɑɑni kɛ́.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mɑ tɑ mɑɣɑsɩ teu ɩlɛnɑ mɑ́ tɔ sɩ","poem":1},{"lineBreak":true},{"text":"pɑɑ pəsəɣɩ nɑ pɑ́ lɑ nɑɑni kɛ nɔɣɔlʋ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ɩsənɑɣɑ mɑɑ lɛɛtɩ Tɑcɑɑ nyɑɣɑ","poem":1},{"lineBreak":true},{"text":"kʋpɑntʋ nti n lɑpɑ-m tɔ?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mɑɑ kpɑɑsɩ wɑɑsʋɣʋ kɔpʋ nɑ ɩsɔ","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ yɑɑ Tɑcɑɑ nyɑ́ hətɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mɑɑ yoosi nɔɣɔ ŋkɑ mɑ sɩɩ Tɑcɑɑ nyɑ́ tɔɣɔ","poem":1},{"lineBreak":true},{"text":"nyɑ́ yəlɑɑ ɩsɛntɑɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Tɑcɑɑ mpɑ pɑ sɔɔlɑ-ŋ tɔ","poem":1},{"lineBreak":true},{"text":"pɑ səm wɩɩkɩ-ŋ sɔsɔm kɛ́.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hɑɩ, Tɑcɑɑ, mɑ kɛ́ nyɑ́ təmlɛ tʋ kɛ́,","poem":1},{"lineBreak":true},{"text":"nyɑ́ pɛɛlɔ pəyɑlʋ kɛlɛ mɑ́,","poem":1},{"lineBreak":true},{"text":"n cɛpɑ mɑ kʋhɔkʋm.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mɑɑ lɑ́-ŋ́ nyɑnɑ təmlɛ kɔtɑɣɑ.","poem":1},{"lineBreak":true},{"text":"Mɑɑ sɑ́-ŋ́ nɑ mɑ́ yɑɑ nyɑ́ hətɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Mɑɑ yoosi nɔɣɔ ŋkɑ mɑ sɩɩ Tɑcɑɑ nyɑ́ tɔɣɔ","poem":1},{"lineBreak":true},{"text":"nyɑ́ yəlɑɑ ɩsɛntɑɑ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mɑɑ lɑ ɩsənɑ mɑɑ sɩɩwɑ tɔɣɔ","poem":1},{"lineBreak":true},{"text":"nyɑ́ təyɑɣɑ tɑɣɑ tɔɔ kɛ́ Yosɑlɛm tɑɑ.","poem":1},{"lineBreak":true},{"text":"Ɩ́ sɑ Tɑcɑɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}