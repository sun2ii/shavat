{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":12,"content":[{"type":"heading","content":["Tɑcɑɑ tɔkʋɣʋ kɛ ɩ nɔɔsɩ sɩɩʋ"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu nti pɑ yookinɑ ŋmɩɩsɩ pəlefɛɩ nɑɑnʋwɑ sɑŋkʋ",{"text":"nɑ tə́ wɛ yonyoolɑɑ nyʋɣʋ tʋ yontunɑɑ tɑɑ tɔɣɔlɔ:","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hɑɩ, Tɑcɑɑ wɑɑsɩ,","poem":1},{"lineBreak":true},{"text":"nyɑ́ yəlɑɑ tɔŋɑ sɑɑlʋɣʋ kɛ́.","poem":1},{"lineBreak":true},{"text":"Mpɑ pɑ mʋnɑ pɑ́ lɑ-wɛɣɛ nɑɑni tɔ pɑ tɔŋnɑ pɑsʋɣʋ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yəlɑɑ cɑɣɑnɑʋ tike kɛ pɑɑ wei ɩ lɑkɩ,","poem":1},{"lineBreak":true},{"text":"pɑ lotu wɛ nɑɑlɛ nɑɑlɛɣɛ nɑ pɑ́ looliɣinɑ pɑ ntompee.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ kpiisi tʋsəlɑɑ","poem":1},{"lineBreak":true},{"text":"nɑ kɑlɑmpɑɑnɩ nyə́mɑ tənɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nɑ mpɑ pɑ tɔŋ sɩ: Tɑ́ nsəmlɛ ntɛ́ tɑ́ toŋ,","poem":1},{"lineBreak":true},{"text":"tɑ́ tənnɑ tɑ́ ntompee.","poem":1},{"lineBreak":true},{"text":"Awe kɑ ŋmɑkəlɩ-tʋ?","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ḿpʋɣʋ Tɑcɑɑ tɔmɑ sɩ:","poem":1},{"lineBreak":true},{"text":"Kʋnyɔntʋ wei pɑ lɛɛkəɣɩ tɔ","poem":1},{"lineBreak":true},{"text":"nɑ wɑhɑlɑ tʋ wei ɩ mɔləɣɩ tɔ","poem":1},{"lineBreak":true},{"text":"pɑ tɔɔ mɑɑ kʋlɩ nɑ mɑ́ yɑ","poem":1},{"lineBreak":true},{"text":"mpɑ pɑ cɑɑ tɔ pɑ nyɔɔŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tɑcɑɑ kʋyɔɣɔtʋtʋ wɛ kɛ́ təcɛɩcɛɩ ɩsɩɩ liɣitee nyəɣəlʋɣʋ","poem":1},{"lineBreak":true},{"text":"ŋku pɑ tʋ kɔkɔ tɑɑ nɑ pɑ́ nyɑɑlɩ tɔm nɑɑtosompɔɣɔlɑɣɑ tɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ, nyɑ́ɑ́ tɔkɩ nɔɔsɩ nsi n sɩɩwɑ sɩ","poem":1},{"lineBreak":true},{"text":"n kɑ́ kenti-tʋɣʋ tɑm kɛ́ yəlɑɑ mpɛ tɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Asɑɣɑɑ mpɛ pɑ cɔɔkɩ pɑɑ timpiɣi,","poem":1},{"lineBreak":true},{"text":"nɑ ɩsɑɣɑtʋ tɔkɑ yəlɑɑ tənɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":9}