 nyə́mɑ tə wɛnnɑ.","poem":1},{"lineBreak":true},{"text":"Ketɑɑ tɛtʋ nyə́mɑ cokɑ tɛɛ kɛ́ mɑ wɛɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hɑtoo lɔŋ kɛ mɑ wɛ mpɑ","poem":1},{"lineBreak":true},{"text":"pɑ tɑɑ kpɑɑkənɑ hɛɛsʋɣʋ tɔ pɑ tɛ́.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hɛɛsʋɣʋ kɛ mɑ sɔɔlɑɑ.","poem":1},{"lineBreak":true},{"text":"Amɑ ye mɑ yɔɣɔtəɣɩ hɛɛsʋɣʋ tɔm,","poem":1},{"lineBreak":true},{"text":"yoou kɛ mpɛ pɑ cɑɑkɩ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}