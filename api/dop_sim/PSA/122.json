e wɛɛ","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ cɑkɩ ɑ tɔɔ nɑ pɑ́ hʋʋkɩ tɔm.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɩ́ sələmɩ Ɩsɔ sɩ:","poem":1},{"lineBreak":true},{"text":"Yosɑlɛm hɛɛsɩ.","poem":1},{"lineBreak":true},{"text":"Mpɑ pɑ sɔɔlɑ-ŋ tɔ,","poem":1},{"lineBreak":true},{"text":"pɑ lɑŋɑ́ ɩ́ hɛɛnɑ hɛɛsʋɣʋ ŋkʋ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hɛɛsʋɣʋ ɩ́ wɛɛ nyɑ́ koloosi tɑɑ","poem":1},{"lineBreak":true},{"text":"nɑ təcɑɣɑnɑʋ kɛ nyɑ́ tɛɛsɩ kʋpɑnsɩ tɑɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mɑ sɔɔlɑɑ sɩ hɛɛsʋɣʋ ɩ́ wɛɛ nyɑ́ tɑɑ kɛ́","poem":1},{"lineBreak":true},{"text":"mɑ tɛɛtʋnɑɑ nɑ mɑ tɑɑpɑlɑɑ pɑ tɔɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tɑ́ Ɩsɔ Tɑcɑɑ təyɑɣɑ tɔɔ kɛ́","poem":1},{"lineBreak":true},{"text":"mɑ kooliɣi sɩ pə́ cɑɣɑnɑ-ŋ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}