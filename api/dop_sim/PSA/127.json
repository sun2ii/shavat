":[{"lineBreak":true},{"text":"Piyɑ mpɑ yʋlʋ hikɑ ɩ ɩfepile wɑɑtʋ tɔ,","poem":1},{"lineBreak":true},{"text":"pɑ wɛɛ kɛ́ ɩsɩɩ yoolu kɔɔkɑ tɑɑ nyəmɑ́.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Leleŋ nɩɩlʋ ntɛ́ yʋlʋ wei ɩ suulɑ","poem":1},{"lineBreak":true},{"text":"pə tɛ́ nyəmɑ́ kɛ ɩ kɔɔkɑ tɔ.","poem":1},{"lineBreak":true},{"text":"Ɩ kɑɑ nyɑnɑ ɩ kolontunɑɑ kɛ wɑɑtʋ","poem":1},{"lineBreak":true},{"text":"wei ɩ yɔɣɔtəɣənɑ-wɛɣɛ ɩcɑtɛ nɔnɔɣɔ tɛɛ tɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}