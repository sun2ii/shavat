{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":130,"content":[{"type":"heading","content":["Tɑcɑɑ wiinɑʋ kɛ lɑŋwɑkəllɛ sɔsɔɔlɛ tɑɑ"]},{"type":"verse","number":1,"content":["Yosɑlɛm kpɑʋ yontu.",{"lineBreak":true},{"text":"Hɑɩ, Tɑcɑɑ, mɑ wɛ pʋʋɣʋ sɔsɔɔŋkʋ tɑɑ kɛ́ nɑ mɑ́ yɑɑkɩ-ŋ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ nɩɩ mɑ nɔɣɔ.","poem":1},{"lineBreak":true},{"text":"Ke ŋkpɑŋŋ nɑ ń nɩɩ mɑ wiinɑʋ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ye n kɑ sɩɩkɑɣɑ ɩsɑɣɑtʋ kɛ nyɑ́ tɑɑ,","poem":1},{"lineBreak":true},{"text":"Tɑcɑɑ, ɑwe kɑ wɛnɑ weesuɣu?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amɑ nyɑ́ tənnɑ ɩsɑɣɑtʋ hɩɩsʋɣʋ","poem":1},{"lineBreak":true},{"text":"sɩ pɑ́ nyɑŋnɑ-ŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tɑcɑɑ nyɑɣɑ mɑ tɛɛləɣɩ nɑ","poem":1},{"lineBreak":true},{"text":"mɑ́ tɑŋɑ nyɑ́ kʋyɔɣɔtʋtʋ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ nyɑɣɑ mɑ tɛɛləɣɩ nɑ pə́ kəlɩ ɩsɩɩ","poem":1},{"lineBreak":true},{"text":"tɑŋlɑɑ tɛɛlʋɣʋ tɑnɑŋ tɔ.","poem":1},{"lineBreak":true},{"text":"Ɛɛ, pə kəlɑ ɩsɩɩ tɑŋlɑɑ tɛɛlʋɣʋ tɑnɑŋ tɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ɩsɛɣɛlɩ nyə́mɑ ɩ́ tɛɛlɩ Tɑcɑɑ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, Tɑcɑɑ kɛnɑ kʋpɑŋ.","poem":1},{"lineBreak":true},{"text":"Pə́cɔ ɩ sɔɔlʋ pɩɩwɑ tɑm sɩ ɩ́ wɑɑsɩ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ kɑ́ hɛtənɑ Ɩsɛɣɛlɩ nyə́mɑ","poem":1},{"lineBreak":true},{"text":"kɛ pɑ ɩsɑɣɑtʋ tənɑ tɑɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}