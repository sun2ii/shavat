{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":131,"content":[{"type":"heading","content":["Mɑ tɑɑ fɛɩ kɑlɑmpɑɑnɩ ləmɑɣɑsəlɛ"]},{"type":"verse","number":1,"content":["Tɑfiiti Yosɑlɛm kpɑʋ yontu nti tə wɛ",{"text":"yonyoolɑɑ nyʋɣʋ tʋ yontunɑɑ tɑɑ tɔɣɔlɔ.","poem":1},{"lineBreak":true},{"text":"Tɑcɑɑ, mɑ tɑɑ fɛɩ kɑlɑmpɑɑnɩ ləmɑɣɑsəlɛ yɑɑ ɩsəcɑʋ hʋwɛɛ.","poem":1},{"lineBreak":true},{"text":"Mɑɑ pɛɛkəɣɩ sɔsɔɔntʋ yɑɑ mpi pə tɛɛ-m tɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɩsɔ ɩ́ ponɑ pooluŋ.","poem":1},{"lineBreak":true},{"text":"Mɑ wɛ təpɑmm kɛ́ ɩsɩɩ pəyɑɣɑ ŋkɑ","poem":1},{"lineBreak":true},{"text":"kɑ cɛpɑ hətɛ tɔɣɔ kɑ too niŋ tɑɑ.","poem":1},{"lineBreak":true},{"text":"Mɑ wɛ təpɑmm kɛ́ ɩsɩɩ pəyɑɣɑ ŋkɑ kɑ cɛpɑ hətɛ tɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ɩsɛɣɛlɩ nyə́mɑ ɩ́ tʋ Tɑcɑɑ kɛ nɑɑni","poem":1},{"lineBreak":true},{"text":"kɛ pə kpɑɣɑʋ nɔɔnɔɔ tɔ, hɑlənɑ tɑm tɔɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA