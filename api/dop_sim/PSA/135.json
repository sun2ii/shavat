{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":135,"content":[{"type":"heading","content":["Tɑcɑɑ kɛlɛ sɔsɔ"]},{"type":"verse","number":1,"content":["Ɩ́ sɑ Tɑcɑɑ.",{"lineBreak":true},{"text":"Ɩ́ sɑ Tɑcɑɑ hətɛ.","poem":1},{"lineBreak":true},{"text":"Tɑcɑɑ təmlɛ nyə́mɑ mɛ ɩ́ sɑmɩ-ɩ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mpɑ mɛ ɩ wɛ Tɑcɑɑ Ɩsɔ təyɑɣɑ tɑɑ","poem":1},{"lineBreak":true},{"text":"nɑ ɩ tɑɣɑ tɔɔ tɔ,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ɩ́ sɑ Tɑcɑɑ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, ɩ kɛ́ kʋpɑŋ.","poem":1},{"lineBreak":true},{"text":"Ɩ́ yoonɑ ɩ hətɛ tɑɑ,","poem":1},{"lineBreak":true},{"text":"pə tɑɣɑ pʋlʋ, ɩ kɛ́ kʋpɑŋ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yɑkɔpʋ kɛ Tɑcɑɑ ləsɑɑ.","poem":1},{"lineBreak":true},{"text":"Ɩsɛɣɛlɩ kɛ ɩ pəsɑ ɩ nyəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mɑ nyəmɑ́ sɩ tɑ́ Ɩsɔ Tɑcɑɑ n kɛ́ sɔsɔ,","poem":1},{"lineBreak":true},{"text":"n kəlɑ tɩɩŋ tənɑ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pɑɑ mpiɣi n cɑɑkɩ, n lɑkɩ-wəɣɩ.","poem":1},{"lineBreak":true},{"text":"Pɑɑ ɩsɔtɑɑ nɑ ɑtɛ.","poem":1},{"lineBreak":true},{"text":"Pɑɑ teŋkunɑɑ tɑɑ, pɑɑ lumɑŋ sɔsɔɔŋ tənɑ tɑɑ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nyɑ́ kpɑɑsəɣənɑ ɩsɔŋmʋntʋ kɛ tɛtʋ tɔɔ,","poem":1},{"lineBreak":true},{"text":"nɑ ń tisiɣi cɑlɑnɑɑ nɑ tɛʋ,","poem":1},{"lineBreak":true},{"text":"nɑ ń ləsəɣɩ heelim kɛ pə təsɩɩlɛ tɑɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nyɑ́ kʋnɑ Icipiti kɑncɑɑlɑɣɑ ɑpɑlʋpiyɑ.","poem":1},{"lineBreak":true},{"text":"Pɑɑ yəlɑɑ nyənsɩ, pɑɑ tɔlɑ nyənsɩ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nɑ ń lɑ́ kɔkɔlɔ nyəmnɑɑ nɑ piti təmɑ kɛ Icipiti tɑɑ,","poem":1},{"lineBreak":true},{"text":"sɩ pə́ sɛɣɛsɩ Icipiti wulɑʋ nɑ ɩ nyə́mɑ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N yoonɑ piitimnɑɑ pɑɣɑlɛ,","poem":1},{"lineBreak":true},{"text":"nɑ ń kʋ ɑwulɑɑ toŋtʋnɑɑ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɩsɩɩ Amolii nyə́mɑ wulɑʋ Sihoŋ,","poem":1},{"lineBreak":true},{"text":"nɑ Pɑsɑŋ nyə́mɑ nyəŋ Hoki,","poem":1},{"lineBreak":true},{"text":"nɑ Kɑnɑɑŋ ɑwulɑɑ tənɑ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ɩlɛnɑ ń hɑ́ pɑ tɛtʋnɑɑ kɛ Ɩsɛɣɛlɩ nyə́mɑ","poem":1},{"lineBreak":true},{"text":"nɑ tə́ pəsɩ pɑ nyəntʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tɑcɑɑ nyɑ́ hətɛ yɑɑkɩ tɑm tɔɔ kɛ́.","poem":1},{"lineBreak":true},{"text":"Lʋlʋŋ lʋlʋŋ kɑ tɔɔsəɣɩ nyɑ́ tɔɔ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mpi tɔ, Tɑcɑɑ n kɑ́ hʋʋnɑ nyɑ́ yəlɑɑ kɛ́.","poem":1},{"lineBreak":true},{"text":"N kɑ wɛɛnɑ nyɑ́ təmlɛ nyə́mɑ pətɔɔtəlɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Piitimnɑɑ tɩɩŋ ntɛ́ liɣitee nɑ wʋlɑ.","poem":1},{"lineBreak":true},{"text":"Yəlɑɑ lupənɑ-ɩ nɑ pɑ niŋ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tɩɩŋ ɩnɩ ɩ wɛnɑ nɔɔsɩ, ɩɩ yɔɣɔtəɣɩ.","poem":1},{"lineBreak":true},{"text":"Ɩ wɛnɑ ɩsɛ ɩɩ nɑɑkɩ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ɩ wɛnɑ ŋkpɑŋŋ, ɩɩ nɩɩkɩ nɑtəlɩ.","poem":1},{"lineBreak":true},{"text":"Ɩ tɩɩ fɛɩnɑ feesiŋ kɛ ɩ nɔɔsɩ tɑɑ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mpɑ pɑ luki tɩɩŋ ɩnɩ nɑ","poem":1},{"lineBreak":true},{"text":"pɑ tənɑ mpɑ pɑ tʋɣɩ-ɩ nɑɑni tɔ,","poem":1},{"lineBreak":true},{"text":"pɑ́ wɛɛ ɩsɩɩ tɩɩŋ ɩnɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ɩsɛɣɛlɩ nyə́mɑ mɛ ɩ́ sɛɛ Tɑcɑɑ.","poem":1},{"lineBreak":true},{"text":"Alɔŋ lʋlʋɣʋ nyə́mɑ mɛ mɩ́ɩ́ sɛɛ-ɩ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Lefii nyə́mɑ mɛ ɩ́ sɛɛ Tɑcɑɑ.","poem":1},{"lineBreak":true},{"text":"Mpɑ mɛ mə nyɑŋnɑ-ɩ tɔ ɩ́ sɛɛ-ɩ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ɩ́ sɑ Tɑcɑɑ kɛ Siyɔŋ tɑɑ.","poem":1},{"lineBreak":true},{"text":"Ɩ́ sɑmɩ-ɩ Yosɑlɛm timpi ɩ wɛɛ tɔ.","poem":1},{"lineBreak":true},{"text":"Ɩ́ sɑ Tɑcɑɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}