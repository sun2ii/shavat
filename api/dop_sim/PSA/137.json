{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":137,"content":[{"type":"heading","content":["Ɩsɛɣɛlɩ nyə́mɑ kɛ Pɑpiloni pɔɣɔ nɔɣɔ"]},{"type":"verse","number":1,"content":["Tɩɩ wɛ Pɑpiloni pusi nɔɣɔ nɑ tə́ cɑɣɑɑ.",{"text":"Sɑɑ wei tə tɔɔsəɣɩ Siyɔŋ tɔɔ, ɩlɛnɑ tə́ wiiki.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nɑ tə́ pusi tɑ́ cəməŋ nɑ tənɑ tɩɩŋ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tənɑɣɑ mpɑ pɑ kuu-tʋ tɔ pɑ tɔŋɑɣɑ-tʋ sɩ:","poem":1},{"lineBreak":true},{"text":"Ɩ́ yoo-tʋɣʋ yontu.","poem":1},{"lineBreak":true},{"text":"Tɑ́ cɑɑllɑɑ cɑɑkɑɣɑ lɑŋhʋlʋmlɛ yontu nɑ pɑ́ tɔŋ-tʋ sɩ:","poem":1},{"lineBreak":true},{"text":"Ɩ́ yoo-tʋɣʋ Siyɔŋ yontu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɩsənɑɣɑ tɩɩ yoo Tɑcɑɑ yontu kɛ","poem":1},{"lineBreak":true},{"text":"tɛtʋ kpɑɩ nyəntʋ tɑɑ?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hɑɩ, Yosɑlɛm, ye mɑ sɔɔ nyɑ́ tɔɔ,","poem":1},{"lineBreak":true},{"text":"mɑ niŋ ntɔɣɔŋ ɩ́ sɔɔ mɑ tɔɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ye mɑ tɑ tɔɔsɩ Yosɑlɛm nyɑ́, nyɑ́ tɔɔ,","poem":1},{"lineBreak":true},{"text":"yɑɑ nyɑ́ tɔm ɩɩ hʋləsəɣɩ mɑ lɑŋlɛ,","poem":1},{"lineBreak":true},{"text":"mɑ nsəmlɛ ɩ́ mɑtənɑ mɑ tɑntɑhɑɑʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tɑcɑɑ, tɑɑ sɔɔ mpi Ɩtɔm nyə́mɑ lɑpɑ tɔ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, kʋyɑŋku kolontunɑɑ tii Yosɑlɛm tɔɔ tɔ.","poem":1},{"lineBreak":true},{"text":"Pɑ tɔŋɑɣɑ kɛ́ sɩ kpiisi, kpiisi nɑ ń kpɛŋnɑ kite.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pɑpiloni nyɑ́, pɩɩ kpiisi-ŋ nɔɔnɔɔ.","poem":1},{"lineBreak":true},{"text":"Leleŋ nɩɩlʋ ntɛ́ wei ɩ kɑ́ lɛɛtɩ-ŋ","poem":1},{"lineBreak":true},{"text":"ɩsɑɣɑtʋ nti n lɑpɑ-tʋ tɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Leleŋ nɩɩlʋ ntɛ́ wei ɩ kɑ́ kpɑ nyɑ́ piyɑ","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ nɑŋtɩ-səɣɩ kʋkpɑmʋɣʋ tɔɔ tɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}