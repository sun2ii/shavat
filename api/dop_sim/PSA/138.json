{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":138,"content":[{"type":"heading","content":["Mɑɑ sɑ-ŋ nɑ mɑ lotu tənɑ"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu.",{"lineBreak":true},{"text":"Tɑcɑɑ, mɑ sɛɛ-ŋ nɑ mɑ lotu tənɑ.","poem":1},{"lineBreak":true},{"text":"Nɩɩ mɑ kʋyɔɣɔtʋtʋ, mɑ yoo-ŋ yontu kɛ","poem":1},{"lineBreak":true},{"text":"ɩsɔtɑɑ toŋtʋnɑɑ ɩsɛntɑɑ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mɑ luŋiɣi nyɑ́ təsɛɛlɛ nɑŋŋ nyəntɛ tɑɑ","poem":1},{"lineBreak":true},{"text":"kɛ́ nyɑ́ kʋpɑntʋ nɑ nyɑ́ tɑmpɑnɑ tɔɔ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, n lɑpɑ nɑ nyɑ́ nɔɔsɩ sɩɩʋ té","poem":1},{"lineBreak":true},{"text":"nɑ pə́ tɛɛ pə tənɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wɑɑtʋ wei mɑ yɑɑ-ŋ tɔ n cɔ-m,","poem":1},{"lineBreak":true},{"text":"nɑ ń tʋ-m ɑpɑlʋtʋ nɑ toŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tɑcɑɑ, ɑtɛ ɑwulɑɑ tənɑ kɑ́ sɛɛ-ŋ.","poem":1},{"lineBreak":true},{"text":"Wɑɑtʋ wei pɑɑ nɩɩ nyɑ́ nɔɣɔ tɑɑ tɔm tɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pɑɑ sɑ nyɑ́ təmɑ nɑ pɑ́ yooki sɩ:","poem":1},{"lineBreak":true},{"text":"Tɑcɑɑ teeli tɔɔwɑ sɔsɔm.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ wɛ ɩsɔtɑɑ kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ nɑɑkɩ mpɑ pɑ pɑsəɣɩ pɑ tɩ tɔ.","poem":1},{"lineBreak":true},{"text":"Nɑ ɩ́ loosiɣi kɑlɑmpɑɑnɩ nyə́mɑ kɛ","poem":1},{"lineBreak":true},{"text":"pooluŋ nɑ ɩ́ nyəmɑ-wɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ye mɑ wɛ lɑŋwɑkəllɛ tɑɑ,","poem":1},{"lineBreak":true},{"text":"nyɑ́ hɑɑkənɑ-m weesuɣu.","poem":1},{"lineBreak":true},{"text":"Pɑɑ mɑ kolontunɑɑ pɑ́ɑ́nɑ́ kɑ́ kpɑ ɩsənɑ,","poem":1},{"lineBreak":true},{"text":"n kɑ wɑɑsɩ-m kɛ́.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ n kɑ́ lɑ-m mpʋ,","poem":1},{"lineBreak":true},{"text":"nyɑ́ kʋpɑntʋ fɛɩ tənɑɣɑ.","poem":1},{"lineBreak":true},{"text":"Tɑɑ lɔ mpi n ŋmɑnɑ nyɑ́ niŋ tɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}