{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":140,"content":[{"type":"heading","content":["Yʋlʋ wei pɑ suuki tɔm tɔ ɩ sələmʋɣʋ"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu nti tə wɛ yonyoolɑɑ",{"text":"nyʋɣʋ tʋ yontunɑɑ tɑɑ tɔɣɔlɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Tɑcɑɑ wɑɑsɩ-m yəlɑɑ ɑsɑɣɑɑ niŋ tɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ń kenti-m mʋsʋŋtʋnɑɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɩsɑɣɑtʋ kɛ pɑ mɑɣɑsəɣɩ pɑ tɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ pɛɛkəɣɩ yoou kɛ pɑɑ kʋyɑkʋ ŋku.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pɑ niisiɣi pɑ nɔɔsɩ ɩsɩɩ tʋmɑɑ.","poem":1},{"lineBreak":true},{"text":"Akɑlɑ sɔtʋ wɛnnɑ pɑ ntompee tɔɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pɑɑsənɑ-m nɑ mɑ́ tɑɑ hoti ɑsɑɣɑɑ niŋ tɑɑ.","poem":1},{"lineBreak":true},{"text":"Tɑcɑɑ kenti mɑ tɔɔ kɛ́ mʋsʋŋtʋnɑɑ mpɑ pɑ","poem":1},{"lineBreak":true},{"text":"cɑɑ-m pɛtʋɣʋ tɔ pɑ tɔɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kɑlɑmpɑɑnɩ nyə́mɑ nyəpɑ-m kɑtɔkɑ.","poem":1},{"lineBreak":true},{"text":"Pɑ nyəpɑ-m ŋmɩɩsɩ nɑ puluŋ kɛ mɑ mpɑɑʋ tɑɑ sɩ pɑ kpɑɑkɩ-m.","poem":1},{"lineBreak":true},{"text":"Ɩlɛnɑ pɑ́ sɩɩ kʋhuhum kɛ mpɑɑʋ nɔɣɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tɑcɑɑ, nyɑɣɑlɛ mɑ Ɩsɔ,","poem":1},{"lineBreak":true},{"text":"ke ŋkpɑŋŋ nɑ ń nɩɩ mɑ wiinɑʋ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ Ɩsɔ, nyɑɣɑlɛ mɑ nyʋɣʋ təyɑtɛ toŋ nyəntɛ.","poem":1},{"lineBreak":true},{"text":"N kentiɣi mɑ nyʋɣʋ tɔɔ kɛ́ yoou wɑɑtʋ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tɑɑ lɑ ɑsɑɣɑɑ luɣu nyəntʋ,","poem":1},{"lineBreak":true},{"text":"pə́cɔ tɑɑ yele nɑ pɑ kʋmɑɣɑsəm lɑ́","poem":1},{"lineBreak":true},{"text":"nɑ pə́ kɔɔ nɑ pɑ́ hɔ pɑ tɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mpɑ pɑ tɑmɑ-m tɔ,","poem":1},{"lineBreak":true},{"text":"pɑ ɩsɑɣɑtʋ ɩ́ hoti pɑ nyɔɔŋ tɑɑ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pə́ pəlɩ-wɛɣɛ kɔkɔ mɑmɑlɑ.","poem":1},{"lineBreak":true},{"text":"Pə́ tusi-wɛɣɛ kɔkɔ tɑɑ.","poem":1},{"lineBreak":true},{"text":"Pə́ pɛtɩ-wɛɣɛ pʋʋɣʋ sɔsɔɔʋ tɑɑ.","poem":1},{"lineBreak":true},{"text":"Pɑ́ tɑɑ tɑsɑ kʋlʋɣʋ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nɔɔleleŋ nyə́mɑ ɩ́ tɑɑ cɑɣɑ tɛtʋ tɑɑ.","poem":1},{"lineBreak":true},{"text":"Pɑɑ tɔɣɔnɩ ɑsɑɣɑɑ nɑ mʋsʋŋtʋnɑɑ kɛ́, hɛɛsʋɣʋ fɛɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mɑ nyəmɑ́ teu sɩ Tɑcɑɑ hʋʋkənɑ wɑhɑlɑ nyə́mɑ tɔm kɛ teu","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ hɑɑkɩ kʋnyɔntʋnɑɑ kɛ siɣisuɣu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ, tɑmpɑnɑ təŋlɑɑ kɑ́ sɑnɑ nyɑ́ hətɛ","poem":1},{"lineBreak":true},{"text":"nɑ siɣisilɑɑ cɑɣɑ nyɑ́ ɩsɛntɑɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":14}