{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":141,"content":[{"type":"heading","content":["Tɑcɑɑ feŋ mɑ kʋyɔɣɔtʋtʋ tɔɔ"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu.",{"lineBreak":true},{"text":"Tɑcɑɑ mɑ yɑɑkɩ-ŋ, kɔɔ lɔŋ kɛ mɑ sənɑʋ.","poem":1},{"lineBreak":true},{"text":"Ke ŋkpɑŋʋɣʋ nɑ ń nɩɩ mɑ nɔɣɔ kɛ wɑɑtʋ wei mɑ yɑɑkɩ-ŋ tɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mɑ sələmʋɣʋ ɩ́ kpɑ nyɑ́ kiŋ ɩsɩɩ tulɑɑlʋ nyɔɔsɩ,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ niŋ kpɑɑsʋɣʋ wɛɛ-ŋ ɩsɩɩ tɑɑnɑɣɑ kʋhɑʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tɑcɑɑ feŋ mɑ nɔɣɔ tɔɔ,","poem":1},{"lineBreak":true},{"text":"tɑŋ mɑ ntompee.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tɑɑ yele nɑ mɑ́ hʋʋkɩ sɩ mɑ́ lɑ ɩsɑɣɑtʋ.","poem":1},{"lineBreak":true},{"text":"Yɑɑ mɑ nɑ ɩsɑɣɑlɑtɑɑ tə́ lɑkɩ tɑsəkəlɛ təmɑ.","poem":1},{"lineBreak":true},{"text":"Pəyele mɑ tɑɑ tʋ niŋ kɛ pɑ ɑcimɑ tɑɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ye siɣisilu mɑpənɑ-m,","poem":1},{"lineBreak":true},{"text":"kʋpɑntʋ kɛ ɩ cɑɑnɑ-m.","poem":1},{"lineBreak":true},{"text":"Pɑɑ ɩ hɔmɑ mɑ ŋkpɑŋʋɣʋ,","poem":1},{"lineBreak":true},{"text":"pə wɛ kɛ́ ɩsɩɩ nim kɛ mɑ nyʋɣʋ tɑɑ,","poem":1},{"lineBreak":true},{"text":"mɑ kɑɑ kisi.","poem":1},{"lineBreak":true},{"text":"Asɑɣɑɑ ɩsɑɣɑtʋ kɑɑ səŋsɩ mɑ sələmʋɣʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Pə́ pɛtɩ pɑ hʋʋlɑɑ kɛ kʋkpɑməŋ tɑɑ.","poem":1},{"lineBreak":true},{"text":"Ɩlɛnɑ pɑ́ nɩɩ mɑ kʋyɔɣɔtʋtʋ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, tə wɛ teu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Teitei ɩsɩɩ pɑ hɑlʋɣʋ nɑ pɑ́ fɑkɩ tɛtʋ tɔ,","poem":1},{"lineBreak":true},{"text":"ḿpʋɣʋ tɑ mʋwɑ kɑ sɔɣɔtɩ ɑtɛtəlɛ nɔnɔɣɔ*fɑ*.","poem":1},{"noteId":9}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tɑcɑɑ Ɩsɔ, nyɑ́ tɔɔ kɛ́ mɑ kɛɛsəɣɩ mɑ ɩsɛ,","poem":1},{"lineBreak":true},{"text":"nyɑɣɑ mɑ tʋɣɩ kpʋlʋɣʋ, tɑɑ yele nɑ mɑ́ sɩ́.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kenti-m kɑtɔsɩ nsi pɑ nyəkɩ-m tɔ,","poem":1},{"lineBreak":true},{"text":"nɑ ɑsɑɣɑɑ mpɛ pɑ kʋcopum.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Asɑɣɑɑ ɩ́ hoti pɑ mɑɣɑmɑɣɑ pɑ puluŋ tɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ɑ́ fiti.","poem":1}]}],"footnotes":[{"noteId":9,"caller":"ɑ","text":"Kʋkɑlətʋ tənɛ tə tɑɑ, tɛləsəlɑɑ fɛɩ nɔɣɔ kʋlʋmɑɣɑ. Pɑɑ wei nɑ ɩ kʋtɛləsʋtʋ kɛ.","reference":{"chapter":141,"verse":7}}]},"thisChapterLink":"/api/dop_sim/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}