{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":142,"content":[{"type":"heading","content":["Tɑcɑɑ kɛlɛ wɑhɑlɑ tʋ kpʋlʋɣʋ tətʋlɛ"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu nti tə wɛ yonyoolɑɑ",{"text":"nyʋɣʋ tʋ tɑkəlɑɣɑ tɑɑ tɔɣɔlɔ.","poem":1},{"lineBreak":true},{"text":"Sələmʋɣʋ ŋku ɩ kɑ sələmɑ kʋkpɑmʋɣʋ pʋʋɣʋ tɑɑ tɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ mɑ wiikinɑ-ŋ nɑ nɔɣɔ sɔsɑɣɑ,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ tɛkəɣɩ-ŋ niŋ nɑ mɑ nɔɣɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nyɑɣɑ mɑ hʋləɣɩ mɑ kʋsələmətʋ,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ hʋləɣɩ-ŋ mɑ lɑŋwɑkəllɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pɑɑ mɑ lɔwɑ ɑpɑlʋtʋ,","poem":1},{"lineBreak":true},{"text":"nyɑ́ nyəmnɑ mɑ təpote.","poem":1},{"lineBreak":true},{"text":"Pɑ nyəpɑ-m kɑtɔkɑ kɛ","poem":1},{"lineBreak":true},{"text":"mpɑɑʋ ŋku mɑɑ təŋ tɔ kʋ tɑɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nyənɩ ntɔɣɔŋ tɔɔ nɑ ń nɑ́ nɔɣɔlʋ tɑ nyə-m.","poem":1},{"lineBreak":true},{"text":"Mɑ kpʋlʋɣʋ tətʋlɛ lepɑ-m.","poem":1},{"lineBreak":true},{"text":"Nɔɣɔlʋ ɩɩ nəɣəsəɣɩ mɑ tɔm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tɑcɑɑ nyɑɣɑ mɑ yɑɑkɩ.","poem":1},{"lineBreak":true},{"text":"Mɑ yɔɣɔtəɣɩ sɩ nyɑɣɑlɛ mɑ kpʋlʋɣʋ tətʋlɛ,","poem":1},{"lineBreak":true},{"text":"nyɑɣɑlɛ mɑ pɑɑ tete kɛ weesiŋ nyə́mɑ tɛtʋ tɑɑ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ke ŋkpɑŋŋ nɑ ń nɩɩ mɑ wulɑ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, mɑ kəlɑ ɩcɑntʋ.","poem":1},{"lineBreak":true},{"text":"Yɑ-m mɑ wɑhɑlɑ tʋlɑɑ niŋ tɑɑ.","poem":1},{"lineBreak":true},{"text":"Pə tɑɣɑ pʋlʋ, pɑ kəlɑ-m toŋ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ləsɩ-m mɑ sɑləkɑ tɑɑ, nɑ mɑ́ sɑ́ nyɑ́ hətɛ.","poem":1},{"lineBreak":true},{"text":"Wɑɑtʋ wei n kɑ́ lɑ-m kʋpɑntʋ tɔ,","poem":1},{"lineBreak":true},{"text":"siɣisilɑɑ kɑ́ tʋ-m hɛkʋ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":8}