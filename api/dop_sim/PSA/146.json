{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":146,"content":[{"type":"heading","content":["Tɑcɑɑ kɛlɛ ɑcɑmɑɑ kentulu"]},{"type":"verse","number":1,"content":["Ɩ́ sɑ Tɑcɑɑ.",{"lineBreak":true},{"text":"Mɑɑ sɑ Tɑcɑɑ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nyɑɣɑ mɑɑ sɑ mɑ weesuɣu tənɑ.","poem":1},{"lineBreak":true},{"text":"Mɑɑ pʋɣʋləɣɩ-ŋ mɑ weesuɣu tənɑɣɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ɩ tɑɑ hɑ mə təɣɩ yəlɑɑ sɔsɑɑ,","poem":1},{"lineBreak":true},{"text":"pɑ kɛ́ yəlɑɑ kɛ́. Pɑɑ pəsəɣɩ yʋlʋ nyʋɣʋ yɑpʋ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pɑ weesiŋ tɛŋ kɛ́ nɑ pɑ́ tɑɣɑnɩ tɛtʋ kɛ pəsʋɣʋ,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ təmɑ wenɑ ɑ pɛɛ pɑɑ tʋwɑ tɔ ɑ́ sɑɑlɩ yem.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Leleŋ nɩɩlʋ ntɛ́ wei ɩ nyənəɣɩ Yɑkɔpʋ Ɩsɔ kɛ́ ɩ wɑɑsʋlʋ","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ tɛɛləɣɩ ɩ Ɩsɔ Tɑcɑɑ tɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ɩsɔ nyɑ́ lɑpənɑ ɩsɔtɑɑ nɑ ɑtɛ,","poem":1},{"lineBreak":true},{"text":"nɑ teŋku nɑ ɩ tɑɑ nyəm tənɑ.","poem":1},{"lineBreak":true},{"text":"Yʋlʋ pəsəɣɩ nɑ ɩ́ tʋ-ŋ nɑɑni kɛ tɑm tɔɔ kɛ́.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N tɑɣɑnəɣɩ mpɑ pɑ muɣuliɣi tɔ pɑ tɔmnɑɑ.","poem":1},{"lineBreak":true},{"text":"N hɑɑkɩ nyɔɣɔtʋnɑɑ kɛ tɔɣɔnɑɣɑ.","poem":1},{"lineBreak":true},{"text":"N hɛtəɣɩ mpɑ pɑ hɔkɑɑ tɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ nyɑ́ kuliɣinɑ yʋlʋmɑɑ ɩsɛ.","poem":1},{"lineBreak":true},{"text":"N siɣisiɣi mpɑ pɑ pɑmɑ tɔ.","poem":1},{"lineBreak":true},{"text":"N sɔɔlɑ siɣisilɑɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ nyɑ́ kentiɣinɑ cɑɣɑlɑɑ tɔɔ,","poem":1},{"lineBreak":true},{"text":"nɑ ń pɑɑsəɣənɑ suluwɑɑ nɑ leelɑɑ.","poem":1},{"lineBreak":true},{"text":"Amɑ n wɑkələɣɩ mpi pə pəlɛ ɑsɑɣɑɑ tʋɣɩ tɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tɑcɑɑ tɔkɩ kɑwulɑɣɑ kɛ tɑm tɔɔ kɛ́.","poem":1},{"lineBreak":true},{"text":"Hɑɩ, Siyɔŋ nyə́mɑ mɛ mə Ɩsɔ wɛ tɑm tɔɔ kɛ́.","poem":1},{"lineBreak":true},{"text":"Ɩ́ sɑ Tɑcɑɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}