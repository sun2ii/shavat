 tɔ, Ɩsɔ yɔɣɔtənɑ nɑ pə́ ŋmɑ-mɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɩnɩ ɩ sɩɩnɑ-mɛɣɛ mə lonɑ kɛ tɑm tɔɔ,","poem":1},{"lineBreak":true},{"text":"ɩ sɩɩ-mɛɣɛ kiiŋ, pə fɛɩ sɩ ɩ́ yɔkɩ-ɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tɛtʋ tɔɔ nyə́mɑ mɛ ɩ́ sɑ Tɑcɑɑ,","poem":1},{"lineBreak":true},{"text":"teŋkunɑɑ nɑ pɑ tɑɑ tʋmɑɑ sɔsɑɑ ɩ́ sɑmɩ-ɩ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nɑ kɔkɔ nɑ tɛʋ tɔmpɛɛ nɑ kʋ kpɑɑkpɑɑcɑʋ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩhunte nɑ tɛʋ heelim sɔsɔɔm mɛ mpɑ","poem":1},{"lineBreak":true},{"text":"ɩ́ lɑkɩ ɩsɩɩ ɩ yɔɣɔtʋɣʋ tɔ.","poem":1},{"lineBreak":true},{"text":"Ɩ́ sɑ Tɑcɑɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pɔɔŋ nɑ pulɑsɩ mɛ mə tənɑ,","poem":1},{"lineBreak":true},{"text":"nɑ tɩɩŋ kʋlʋlʋŋ nɑ sɔsɔɔŋ tənɑ ɩ́ sɑmɩ-ɩ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tɑɑlɛ wontu nɑ təyɑɣɑ nyəntʋ,","poem":1},{"lineBreak":true},{"text":"nɑ ɑtɛ kututuutu nɑ sumɑsɩ.","poem":1},{"lineBreak":true},{"text":"Ɩ́ sɑ Tɑcɑɑ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Atɛ ɑwulɑɑ nɑ yəlɑɑ tənɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ɑwulumpiyɑ nɑ ɑtɛ hʋʋlɑɑ tənɑ.","poem":1},{"lineBreak":true},{"text":"Ɩ́ sɑ Tɑcɑɑ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Akpɑtəlɑɑ nɑ piyɑ","poem":1},{"lineBreak":true},{"text":"ɩfepiyɑ nɑ pɛɛlɑɑ ɩ sɑmɩ-ɩ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ɩ́ sɑ Tɑcɑɑ hətɛ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, tə tike ntɛ́ sɔsɔɔlɛ.","poem":1},{"lineBreak":true},{"text":"Ɩsɔ sɔsɔɔntʋ wɑɑsɑ ɩsɔtɔnʋɣʋ nɑ tɛtʋ kɛ́.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ hɑ ɩ yəlɑɑ kɛ toŋ kɛ́.","poem":1},{"lineBreak":true},{"text":"Pə tɔɔ kɛ́ ɩ yəlɑɑ kʋpɑmɑ sɑŋɩ-ɩ.","poem":1},{"lineBrea