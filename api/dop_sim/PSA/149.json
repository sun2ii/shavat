{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":149,"content":[{"type":"heading","content":["Yəlɑɑ kʋpɑmɑ teeli"]},{"type":"verse","number":1,"content":["Ɩ́ sɑ Tɑcɑɑ.",{"text":"Ɩ́ yoo Tɑcɑɑ kɛ yontu kʋfɑtʋ,","poem":1},{"lineBreak":true},{"text":"ɩ́ yoo ɩ sɑmtʋ kɛ yəlɑɑ kʋpɑmɑ kpekəle tɑɑ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɩsɛɣɛlɩ nyə́mɑ ɩ́ yɔɔlənɑ wei ɩ ŋmɑ-mɛ tɔ.","poem":1},{"lineBreak":true},{"text":"Siyɔŋ nyə́mɑ ɩ́ wɛɛ ɑŋmɑɑlɑ tɑɑ kɛ mə wulɑʋ tɔɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɩ́ sɑ Ɩsɔ hətɛ nɑ pɑɑlɛ,","poem":1},{"lineBreak":true},{"text":"ɩ́ sɑ-tɛ nɑ ɑkilimɑ nɑ cəmʋɣʋ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mpi tɔ, Tɑcɑɑ lɑŋlɛ hɛɛnɑ ɩ yəlɑɑ mɛɣɛ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ yɑkɩ mpɑ pɑ pɑsəɣɩ pɑ tɩ tɔ, nɑ pɑ nyɔɔŋ kʋləɣɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yəlɑɑ kʋpɑmɑ ɩ́ wɛɛ ɑcimɑ tɑɑ nɑ pɑ́ tʋ Ɩsɔ kɛ teeli.","poem":1},{"lineBreak":true},{"text":"Ɩ́ wilitinɑ lɑŋhʋlʋmlɛ kɛ mə kʋhəntəŋ tɔɔ kɛ́ ɑhoo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɩsɔ sɑmtʋ ɩ́ wɛɛ mə nɔɔsɩ tɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ lɑɣɑtɛ nte tə wɛ lɔŋ kɛ tɑɑ nɑ wɑɑlɩ tɔɣɔ mə niŋ tɑɑ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nɑ ɩ́ lɛɛtɩ piitimnɑɑ lɛlɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ tʋ yəlɑɑ lɛlɑɑ kɛ wɑhɑlɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nɑ ɩ́ hɔkɔ mə ɑwulɑɑ kɛ ɑlukpɑlɑ,","poem":1},{"lineBreak":true},{"text":"nɑ pɛlɛ pɑ wɑɑlɩ nyə́mɑ kɛ nyəɣətʋ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nɑ ɩ́ hʋʋnɑ-wɛɣɛ Ɩsɔ hʋʋlɛ ɩsɩɩ pɑ ŋmɑɑʋ tɔ,","poem":1},{"lineBreak":true},{"text":"pə kɛ́ yəlɑɑ kʋpɑmɑ tənɑ teeli kɛ́.","poem":1},{"lineBreak":true},{"text":"Ɩ́ sɑ Tɑcɑɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}