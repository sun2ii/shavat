{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":15,"content":[{"type":"heading","content":["Ɩsɔsɛɛtʋ nti Tɑcɑɑ cɑɑkənɑ ɩ yəlɑɑ tɔ"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu.",{"lineBreak":true},{"text":"Hɑɩ, Tɑcɑɑ ɑwe mʋnnɑ nyɑ́ təsɛɛlɛ tɑɑ sʋʋʋ?","poem":1},{"lineBreak":true},{"text":"Nɑ pʋntʋ cɑɣɑ nyɑ́ Siyɔŋ pulɑɣɑ nɑŋŋ nyəŋkɑ tɔɔ?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yʋlʋ wei ɩ kiŋ pɑ kɑɑ nɑ ɩsɑɣɑtʋ nɑ ɩ́ təŋəɣɩ kʋsiɣisim","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ yɔɣɔtəɣɩ tɑmpɑnɑ wenɑ ɩ nyəmɑ́ ɩ lotu tɑɑ tɔɣɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pə tɛ́ yʋlʋ ɩɩ cɑkənɑ lɛlɑɑ.","poem":1},{"lineBreak":true},{"text":"Pə́cɔ ɩɩ lɑkɩ ɩsɑɣɑtʋ kɛ ɩ tɔɣɔntəlɛ yɑɑ ɩ́ tʋ-ɩ fɛɛlɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yʋlʋ ɩnɩ ɩ tɑɑ kpɑɑkənɑ mpɑ Ɩsɔ ɩɩ cɑɑkɩ tɔɣɔ.","poem":1},{"lineBreak":true},{"text":"Amɑ ɩ tʋɣʋnɑ mpɑ pɑ nyɑŋnɑ Tɑcɑɑ tɔ.","poem":1},{"lineBreak":true},{"text":"Ye yʋlʋ ɩnɩ ɩ sɩɩ nɔɣɔ ɩɩ lɑɣɑsəɣɩ-kɛ, pɑɑ pɩɩ cɑɑlɩ-ɩ ɩsənɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ye nɔɣɔlʋ kəntɑ ɩ kiŋ kɛ liɣitee ɩɩ pɛɛkəɣɩ kɑsəyɑɣɑ.","poem":1},{"lineBreak":true},{"text":"Pə tɛ yʋlʋ kɑɑ mʋ kʋhɑʋ nɑ ɩ́ ləsɩ pɔpɔtʋ ɑseetɑ","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ kʋ tɑmpɑnɑ tʋ tɔm.","poem":1},{"lineBreak":true},{"text":"Pɩɩ cɛŋləɣɩ wei ɩ tɔkɑ yɑɑsinɑɑ mpɛ tɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}