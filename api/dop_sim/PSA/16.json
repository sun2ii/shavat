{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":16,"content":[{"type":"heading","content":["Wei pə yɑpɑ səm nɔɣɔ tɑɑ tɔ ɩ lɑŋhʋlʋmlɛ"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu.",{"text":"Hɑɩ, Ɩsɔ, kenti mɑ tɔɔ,","poem":1},{"lineBreak":true},{"text":"nyɑ́ kiŋ kɛ mɑ cɑɑ mɑ cɔɔsɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mɑ heelɑ Tɑcɑɑ sɩ: Nyɑɣɑlɛ mɑ cɑɑ,","poem":1},{"lineBreak":true},{"text":"nyɑ́ kiŋ tike kɛ mɑ nɩɩkɩ leleŋ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɩsɔ yəlɑɑ mpɑ pɑ wɛ tɛtʋ tɑɑ tɔɣɔ mɑ cɑɑkɩ teu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yəlɑɑ lʋləsəɣɩ tɩɩŋ kɛ́ nɑ pɑ́ təŋəɣɩ kpɑɩ nyəŋ.","poem":1},{"lineBreak":true},{"text":"Mɑ kɑɑ lɑɑ tɩɩŋ yɑɑ mɑ́ tɩɩ yɑɑ ɩ həlɑ nɑ mɑ nɔɣɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tɑcɑɑ, nyɑɣɑlɛ mɑ pɑɑ tete,","poem":1},{"lineBreak":true},{"text":"n hɑɑkɩ-m mpi mɑ nyɩɩləɣɩ tɔ.","poem":1},{"lineBreak":true},{"text":"N tɔkɑ mpi pɩɩ mɑɣɑnɑ-m cele tɔɣɔ nyɑ́ niŋ tɑɑ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mɑ pɑɑ tete kʋpɑmpɑntɛ nte mɑ hikɑɑ tɔɣɔlɛ,","poem":1},{"lineBreak":true},{"text":"mɑ lɑŋlɛ hɛɛnɑ nyɑ́ kʋhɑhɑm mpɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mɑ sɛɛ mɑ lɑɣɑtʋ tɑsʋlʋ Tɑcɑɑ.","poem":1},{"lineBreak":true},{"text":"Pɑɑ ɑhoo tɑɑ pə sɛɣɛsəɣɩ-m mɑ tɑɑ kɛ́.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mɑ nɑɑkɩ Tɑcɑɑ kɛ tɑm kɛ́.","poem":1},{"lineBreak":true},{"text":"Mɑɑ cɛŋləɣɩ, mpi tɔ, n wɛ mɑ kɔŋkɔŋ tɑɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pə tɔɔ kɛ́ mɑ hɛɛsɑɑ mɑɑ nyɑŋnɑ pʋlʋpʋ,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ lɑŋlɛ hʋlʋmɑɑ nɑ mɑ́ yɔɔləɣɩ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mpi tɔ, n kɑɑ pɛtɩ-m ɑtɛtəlɛ tɑɑ.","poem":1},{"lineBreak":true},{"text":"Yɑɑ ń yele sɩ nyɑ́ kʋsɔɔlʋ mɑ́,","poem":1},{"lineBreak":true},{"text":"mɑ́ tɩɩ sɔŋ pəcɔ mɑɣɑmɑɣɑ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nyɑ́ hʋləɣənɑ-m weesuɣu mpɑɑʋ","poem":1},{"lineBreak":true},{"text":"nyɑ́ kiŋ kɛ lɑŋhʋlʋmlɛ sɔsɔɔlɛ wɛɛ.","poem":1},{"lineBreak":true},{"text":"Nɑ ń hɑɑkɩ leleŋ tɑm nyəŋ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}