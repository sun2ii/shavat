{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":17,"content":[{"type":"heading","content":["Wɑhɑlɑ tʋ sələmʋɣʋ kɛ Ɩsɔ"]},{"type":"verse","number":1,"content":["Tɑfiiti sələmʋɣʋ kɛ Ɩsɔ.",{"lineBreak":true},{"text":"Hɑɩ, Tɑcɑɑ, ke ŋkpɑŋŋ nɑ ń nɩɩ mɑ sələmʋɣʋ,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ wiinɑʋ, nɑ ń yele nɑ pɑ́ təŋ tɑmpɑnɑ kɛ mɑ tɔm tɑɑ.","poem":1},{"lineBreak":true},{"text":"Kɑloolɑɣɑ fɛɩ mɑ nɔɣɔ tɑɑ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nyɑɑ teesinɑ mɑ tɔm.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, n təŋəɣɩ tɑmpɑnɑ kɛ pə tɑɑ kɛ́.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ye n kɔmɑ mɑ kiŋ kɛ ɑhoo","poem":1},{"lineBreak":true},{"text":"nɑ ń wiili too mɑ lotu tɑɑ,","poem":1},{"lineBreak":true},{"text":"n kɑɑ nɑ ɩsɑɣɑtʋ.","poem":1},{"lineBreak":true},{"text":"Mɑ tɑɑ tɔm nɑ mɑ kʋyɔɣɔtʋtʋ kɛ́ kʋlʋm kɛ́.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nyɑ́ kʋyɔɣɔtʋtʋ kɛ mɑ tɔkɑ mɑ lɑkɑsɩ tɑɑ,","poem":1},{"lineBreak":true},{"text":"mɑ tɑ təŋ mʋsʋŋtʋnɑɑ mpɑɑʋ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nyɑ́ nyəŋkʋ kɛ mɑ nyɔɔnɑɑ,","poem":1},{"lineBreak":true},{"text":"mɑɑ hɛləɣɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hɑɩ, Ɩsɔ, nyɑɣɑ mɑ yɑɑkɩ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, n nɩɩkɩ.","poem":1},{"lineBreak":true},{"text":"Ke ŋkpɑŋʋɣʋ nɑ mɑ tɔɔ nɑ ń nɩɩ mɑ kʋyɔɣɔtʋtʋ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wɑtɩ-m nyɑ́ kʋpɑntʋ.","poem":1},{"lineBreak":true},{"text":"Nyɑ́ wɑɑsəɣənɑ mpɑ pɑ tʋɣʋ-ŋ kpʋlʋɣʋ","poem":1},{"lineBreak":true},{"text":"tɔɣɔ pɑ kolontunɑɑ niŋ tɑɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kenti mɑ tɔɔ ɩsɩɩ ɩsəlɛ tɑɑ pəyɑɣɑ.","poem":1},{"lineBreak":true},{"text":"Nɑ ń ŋmɛsɩ-m nyɑ́ keŋ tɛɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kɛ mɑ kolontunɑɑ ɑsɑɣɑɑ","poem":1},{"lineBreak":true},{"text":"ŋmɑkəllɑɑ mpɑ pɑ tɑmɑ-m tɔ pɑ tɔɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Pɑ fɛɩnɑ pətɔɔtəlɛ,","poem":1},{"lineBreak":true},{"text":"pɑ yɔɣɔtəɣɩ kɑlɑmpɑɑnɩ tɔm.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pɑ tɑmɑ-m kɛ́ nɑ pɑ́ wɛ mɑ wɑɑlɩ təkpɑm,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ feŋiɣi sɩ pɑ́ pɛtɩ-m ɑtɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ɩsɩɩ tɔɣɔlɑsɩ cɛŋʋɣʋ sɩ","poem":1},{"lineBreak":true},{"text":"sɩ cələɣɩ sɩ tɔɣɔnɑɣɑ tɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tɑcɑɑ kʋlɩ pɑ tɔɔ nɑ ń pəsɩ-wɛɣɛ kpɛntəlɑsɩ.","poem":1},{"lineBreak":true},{"text":"Yɑ-m ɩsɑɣɑtʋ niŋ tɑɑ nɑ nyɑ́ lɑɣɑtɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ kpiisi-wɛ nɑ nyɑ́ niŋ.","poem":1},{"lineBreak":true},{"text":"Nɑ pə ləsɩ mpi pə kɛ́ pɑ tɑɑ nyəm tɔɣɔ weesuɣu nyəm tɑɑ.","poem":1},{"lineBreak":true},{"text":"Nɑ ń nyɔɔsɩ-wɛɣɛ nyɑŋ lʋm mpi n sɩɩ-wɛ tɔ.","poem":1},{"lineBreak":true},{"text":"Pɑ piyɑ ɩ́ nyɔɔ nɑ pə́ kʋ pɛlɛ nɑ pɑ́ kɑɑsɩ pɑ sɑɑlənɑɑ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ye mɑ ɩlɛ, mɑɑ nɑ́ nyɑ́ ɩsɛntɑɑ kɛ́ mɑ tɑmpɑnɑ təŋʋɣʋ tɔɔ.","poem":1},{"lineBreak":true},{"text":"Nɑ mɑ́ femɑ mɑ nyənɩ-ŋ ɩsənɑ mɑ cɑɑ tɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}