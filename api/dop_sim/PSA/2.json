{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":2,"content":[{"type":"heading","content":["Wulɑʋ wei Ɩsɔ ləsɑɑ tɔ"]},{"type":"verse","number":1,"content":["Pepe tɔɔ kɛ́ piitimnɑɑ cʋkɑ pə tɑɑ,",{"text":"nɑ yəlɑɑ nɑ́ɑ́ hʋʋkɩ hʋwɛɛ kpɑɩ nyənɑ kɛ mpʋ?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nɑ ɑwulumpiyɑ nɑ́ɑ́ sɔɔsəɣɩ ɑtɛ ɑwulɑɑ tɔɔ sɩ, pɑ kʋləɣɩ","poem":1},{"lineBreak":true},{"text":"Tɑcɑɑ nɑ ɩ kʋləsʋ pɑ tɔɔ nɑ pɑ́ yoonɑ-wɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nɑ pɑ́ tɔŋ sɩ pɑ́ cɛ pɑ hɔkʋtʋ nɑ pɑ́ lɩɩ ŋmɑkəlʋɣʋ tɑɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Amɑ Tɑcɑɑ nɑ́ wɛ ɩ kumte tɔɔ kɛ́","poem":1},{"lineBreak":true},{"text":"ɩsɔtɑɑ kɛ́ nɑ ɩ́ woŋiɣi-wɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nɑ ɩ́ nyɑɑsəɣɩ-wɛ nɑ ɩ pɑ́ɑ́nɑ́, nɑ ɩ́ kɑləɣɩ sɩ:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mɑ ləsənɑ mɑ wulɑʋ nɑ mɑ́ kpɑ-ɩ Siyɔŋ pʋɣʋ nɑŋŋ nyəŋkʋ","poem":1},{"lineBreak":true},{"text":"tɑɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mɑɑ yɑsɩ nti Tɑcɑɑ sɩɩwɑ tɔ.","poem":1},{"lineBreak":true},{"text":"Ɩ heelɑ-m sɩ: Nyɑɣɑlɛ mɑ pəyɑlʋ,","poem":1},{"lineBreak":true},{"text":"sɑŋɑ kɛ mɑ lʋlɑ-ŋ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sɩ mɑ sələmɩ-ɩ piitimnɑɑ nɑ ɩ hɑ-m, nɑ ɑntulinyɑ tənɑ","poem":1},{"lineBreak":true},{"text":"pəsɩ mɑ nyəm.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mɑɑ ŋmɑkəlɩ-wɛ nɑ nyəɣəlʋɣʋ kpɑ́tʋɣʋ, nɑ mɑ́ fɑɣɑ-wɛɣɛ","poem":1},{"lineBreak":true},{"text":"hɔɣɔlɑsɩ ɩsɩɩ hɛɛʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Awulɑɑ ɩ́ kpɑɣɑ ləmɑɣɑsɛɛ, nɑ ɑtɛ sɔsɑɑ nɑ́ɑ́ nɩɩ","poem":1},{"lineBreak":true},{"text":"kpɑɑlʋɣʋ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sɩ pɑ́ pɛtɩ pɑ təɣɩ Tɑcɑɑ","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ nyɑŋnɑ-ɩ nɑ pɑ́ nyɩ ɩ sɔsɔɔntʋ tɔɔ,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ wiliti nɑ pɑ́ həntɩ-ɩ ɑtɛ.","poem":1},{"lineBreak":true},{"text":"Pə́ tɑɑ kɔɔ nɑ ɩ́ mʋnɑ-wɛ nɑ pɑ́ɑ́nɑ́ nɑ pɑ́ le.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, ɩ pɑ́ɑ́nɑ́ ɩɩ lɑɑ kpɑʋ.","poem":1},{"lineBreak":true},{"text":"Leleŋ nɩɩlɑɑ ntɛ́ pɑ tənɑ mpɑ pɑ cɔɔsəɣɩ ɩ tɛɛ tɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":11}