{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":20,"content":[{"type":"heading","content":["Wulɑʋ tɔɔ sələmʋɣʋ"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu nti tə wɛ yonyoolɑɑ",{"text":"nyʋɣʋ tʋ tɑkəlɑɣɑ tɑɑ tɔɣɔlɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hɑɩ, Tɑcɑɑ ɩ́ mʋ nyɑ́ kʋsələmʋtʋ kɛ nyɑ́ lɑŋwɑkəllɛ wule.","poem":1},{"lineBreak":true},{"text":"Yɑkɔpʋ Ɩsɔ ɩnɩ ɩ kenti nyɑ́ tɔɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nɑ ɩ́ lɩɩ ɩ təyɑɣɑ tɑɑ kɛ́ Yosɑlɛm kɛ","poem":1},{"lineBreak":true},{"text":"Siyɔŋ pʋɣʋ tɑɑ nɑ ɩ́ kɔɔ nyɑ́ wɑɑsʋɣʋ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɩ́ tɔɔsɩ nyɑ́ kɔtɑsɩ tənɑ tɔɔ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ mʋ nsi kɔkɔ lusɑ sɩ tənɑ tɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɩ́ hɑ-ŋ mpi n sɔɔlɑ teu tɔ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ lɑ mpi n cɑɑkɩ tɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɩlɛ tɑ́ lɑŋɑ kɑ́ hɛɛnɑ nyɑ́ nyʋɣʋ yɑpʋ tɔm.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, tɑ́ Ɩsɔ hətɛ tɑɑ kɛ́ tə pəsənɑ ɑkɑnɑɑ.","poem":1},{"lineBreak":true},{"text":"Tɑcɑɑ ɩ́ lɑ pə tənɑ mpi n sələməɣɩ tɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Pənɛntɛ mɑ nyəmɑ sɩ Tɑcɑɑ","poem":1},{"lineBreak":true},{"text":"wɑɑsəɣɩ wulɑʋ wei n ləsɑɑ tɔɣɔ,","poem":1},{"lineBreak":true},{"text":"nɑ ń cɔ-ɩ nyɑ́ təyɑɣɑ tɑɑ kɛ́ hɑtoo ɩsɔtɑɑ.","poem":1},{"lineBreak":true},{"text":"Nyɑ́ toŋ sɔsɔɔŋ wɑɑsəɣənɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pɑɣɑlɛ nɑ́ tɛɛləɣɩ pɑ yoou kpɑɣɑnəŋ kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ lɛlɑɑ kɛ pə kɛɛkɛnɑɑ.","poem":1},{"lineBreak":true},{"text":"Amɑ tɑ́ ɩlɛ, tɑ́ Ɩsɔ Tɑcɑɑ kɛ tɑ́ nyənəɣɩ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mpɛ ɩnɩ pɑ nukiɣi kɛ́ nɑ pɑ́ hotiɣi.","poem":1},{"lineBreak":true},{"text":"Ɩlɛnɑ tɑɑ səŋɑ ɩsɔ təcɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Hɑɩ, Tɑcɑɑ, wɑɑsɩ wulɑʋ.","poem":1},{"lineBreak":true},{"text":"Cɔ-tʋɣʋ wɑɑtʋ wei tə yɑɑkɩ-ŋ tɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":10}