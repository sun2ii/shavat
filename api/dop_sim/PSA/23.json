{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":23,"content":[{"type":"heading","content":["Tɑcɑɑ kɛlɛ mɑ tiikilu"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu.",{"lineBreak":true},{"text":"Ɩsɔ nyɑ́ tiikiɣinɑ-m,","poem":1},{"lineBreak":true},{"text":"mɑɑ lɑŋəɣɩ pʋlʋ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pə tɔɔ kɛ́ n pukinɑ-m nyɩɩtʋ","poem":1},{"lineBreak":true},{"text":"kʋlɛkəlɛkətʋ tɑɑ nɑ mɑ́ hɛɛsəɣɩ.","poem":1},{"lineBreak":true},{"text":"Nɑ ń yeki nɑ mɑ́ hɛɛsəɣɩ lʋm mpi","poem":1},{"lineBreak":true},{"text":"pə wɛ təpɑmm tɔ pə cɔlɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N tɑɣɑnəɣɩ mɑ toŋ kpɑɑsʋɣʋ","poem":1},{"lineBreak":true},{"text":"nɑ ń pukinɑ-m mpɑɑʋ kʋsiɣisuɣu tɑɑ sɩ, nyɑ́ hətɛ ɩ́ yɑɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pɑɑ mɑ tɔŋ səkpɛtʋɣʋ ɑnɑɑm tɑɑ,","poem":1},{"lineBreak":true},{"text":"mɑɑ nyɑŋ sɩ pʋlʋpʋ kɑ́ lɑ-m.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, Tɑcɑɑ n wɛ mɑ wɑɑlɩ tɔ se.","poem":1},{"lineBreak":true},{"text":"N tiikiɣi-m nɑ ń kentiɣi mɑ tɔɔ nɑ pə́ tʋɣʋ-m nɑɑni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tɑcɑɑ, pɑɑ mɑ kolontunɑɑ kiŋ,","poem":1},{"lineBreak":true},{"text":"n mʋɣʋ-m kɛ́ nɑ ń pələɣɩ mɑ nyʋɣʋ tɑɑ kɛ́ sɔɔsʋŋ nim,","poem":1},{"lineBreak":true},{"text":"nɑ ń sɩɩkɩ-m tɔɣɔnɑɣɑ təkpɛtɛkpɛtɛ.","poem":1},{"lineBreak":true},{"text":"Nɑ ń suuliɣi mɑ iyɑɣɑ kʋnyɔnyɔɔɣɑ təpɑm.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tɑmpɑnɑ tɔɔ, n lɑkɩ-m kʋpɑntʋ kɛ́","poem":1},{"lineBreak":true},{"text":"nɑ ń sɔɔləɣɩ-m hɑlənɑ mɑ weesuɣu kʋyɛɛŋ tɛ́.","poem":1},{"lineBreak":true},{"text":"Mɑ nɑ-ŋ tɩɩ kpɛntɩ teu kɛ́, hɑlənɑ mɑ səm.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}