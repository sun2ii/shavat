verse","number":5,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ lɑŋlɛ kɑ hɛɛnɑ-wɛ nɑ ɩ́ wɑɑsɩ-wɛ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ kooli-wɛɣɛ kʋpɑntʋ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yəlɑɑ mpɛ ɩnɩ pɑ tɑkɑnɑɑ sɛɛkənɑ Tɑcɑɑ.","poem":1},{"lineBreak":true},{"text":"Yɑkɔpʋ lʋlʋɣʋ nyə́mɑ siɣisiɣi mpɑ pɑ pəsəɣɩ","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ kɔɔ ɩ ɩsɛntɑɑ tɔɣɔlɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tɑm tɔɔ nɔnɔɔsɩ mɛ ɩ́ tʋlɩ təyelele,","poem":1},{"lineBreak":true},{"text":"nɑ teeli wulɑʋ sʋʋ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aweɣelɛ teeli wulɑʋ ɩnɩ?","poem":1},{"lineBreak":true},{"text":"Tɑcɑɑ toŋ tʋ wei ɩ kɛ́ yooŋ tɑɑ ɑkɑ tɔɣɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tɑm tɔɔ nɔnɔɔsɩ mɛ ɩ́ tʋlɩ təyelele,","poem":1},{"lineBreak":true},{"text":"nɑ teeli wulɑʋ sʋʋ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aweɣelɛ teeli wulɑʋ ɩnɩ ye?","poem":1},{"lineBreak":true},{"text":"Atɛ nɑ ɩsɔtɑɑ Tɑcɑɑ kɛlɛ teeli wulɑʋ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}