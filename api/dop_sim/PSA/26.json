text":"Mɑ tɑɑ kpɑɑkənɑ ɩsɑɣɑlɑtɑɑ kpekəle kɛ́.","poem":1},{"lineBreak":true},{"text":"Pəyele mɑɑ kpətəɣənɑ nyɔɔŋ fɛɩnɑɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tɑcɑɑ, mɑɑ sɑŋ mɑ niŋ nɑ pə́ hʋlɩ sɩ mɑ kɛ́ kʋpɑŋ,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ cɔɔ kɔtɑɣɑ təlɑtɛ,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"nɑ mɑ́ sɛɛkɩ-ŋ nɑ mɑ́ sɑŋ nyɑ́ kookɑlənɑɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ mɑ sɔɔlɑ nyɑ́ təyɑɣɑ kɛ́.","poem":1},{"lineBreak":true},{"text":"Nyɑ́ təcɑɣɑlɛ tənɑɣɑ nyɑ́ teeli nɑɑkɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tɑɑ kpɛntɩ mɑ́ nɑ ɑsɑɣɑɑ kɛ təkʋlɛ,","poem":1},{"lineBreak":true},{"text":"yɑɑ mɑ́ nɑ yʋlʋkʋlɑɑ tɑ́ weesiŋ ləsʋɣʋ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mpɑ pɑ lɑkɩ kɑwɑlɑɣɑ nɑ","poem":1},{"lineBreak":true},{"text":"pɑ́ pɑɑləɣɩ kʋhɑɑŋ ɩsɑɣɑŋ tɔ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mɑ yɑɑsi tewɑɣɑ.","poem":1},{"lineBreak":true},{"text":"Nyənɩ mɑ pətɔɔtəlɛ nɑ ń yɑ-m.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mɑ səŋɑɑ kɛ́ təcɑ,","poem":1},{"lineBreak":true},{"text":"mɑɑ sɛɛ Tɑcɑɑ kɛ sɑmɑɑ tɑɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}