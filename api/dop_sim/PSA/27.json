{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":27,"content":[{"type":"heading","content":["Tɑcɑɑ kiŋ cɔɔsʋɣʋ"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu.",{"lineBreak":true},{"text":"Tɑcɑɑ nyɑɣɑlɛ mɑ fətəlɑ nɑ mɑ nyʋɣʋ yɑ́tʋ.","poem":1},{"lineBreak":true},{"text":"Mɑ kɑɑ nyɑnɑ nɔɣɔlʋ.","poem":1},{"lineBreak":true},{"text":"Nyɑ́ kentiɣinɑ mɑ weesuɣu tɔɔ,","poem":1},{"lineBreak":true},{"text":"pʋlʋpʋ kɑɑ sʋsʋ-m wɑtʋ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ye ɑsɑɣɑɑ kɔŋ mɑ cəlʋɣʋ ɩsɩɩ tɑɑlɛ wontu,","poem":1},{"lineBreak":true},{"text":"mpɛ pɑɑ hotinɑ ɑtɛ nɑ pə wɑkəlɩ-wɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pɑɑ yoolɑɑ tɑmɑ-m kotɑɣɑ sɔɣɔntʋ fɛɩ-m.","poem":1},{"lineBreak":true},{"text":"Pɑɑ pɑ sʋʋ-m yoonɑʋ mɑ wɛnɑ Ɩsɔ kɛ́ nɑɑni.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kʋlʋmtʋ kɛ mɑ sələməɣɩ Tɑcɑɑ nɑ mɑ́ səkɩ tə tɔɔ.","poem":1},{"lineBreak":true},{"text":"Pə wɛɛ sɩ mɑ́ cɑɣɑ nyɑ́ təyɑɣɑ tɑɑ kɛ́ hɑlənɑ mɑ səm,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ sɑ kɑ teu nɑ mɑ́ yɔɔlənɑ Ɩsɔ wɛɛʋ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nɑ ń ŋmɛsɩ-m nyɑ́ təyɑɣɑ tɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ń kenti mɑ tɔɔ kɛ́ wɑhɑlɑ wɑɑtʋ.","poem":1},{"lineBreak":true},{"text":"Nɑ ń sɩɩ-m kʋkpɑmʋɣʋ tɔɔ sɩ pʋlʋ ɩ́ tɑɑ hiki-m.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wɑɑtʋ ɩnəɣɩ mɑɑ kəlɩ mɑ kolontunɑɑ mpɑ pɑ cɔɔnɑ-m tɔ,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ sɑ-ŋ nyɑ́ təyɑɣɑ tɑɑ nɑ mɑ́ lɑ-ŋ kɔtɑsɩ,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ yoo-ŋ yontu nɑ mɑ́ tɑlɑ-ŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tɑcɑɑ nyənɩ mɑ pətɔɔtəlɛ,","poem":1},{"lineBreak":true},{"text":"nɑ ń nɩɩ sɑɑ wei mɑ yɑɑkɩ-ŋ tɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mɑ tɔɔsɑ nti n sɩɩwɑ sɩ mɑ́ kɛɛsənɑ nyɑ́ tɔɔ tɔ.","poem":1},{"lineBreak":true},{"text":"Tɑcɑɑ pə tɔɔ kɛ́ mɑ kɛɛsəɣənɑ nyɑ́ tɔɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ɩsɔ nyɑ́ wɑɑsəɣənɑ-m.","poem":1},{"lineBreak":true},{"text":"Tɑɑ hɑ nyɑ́ sɛɛlʋ mɑɣɑ siɣile yɑɑ ń lɔ-m nɑ pɑ́ɑ́nɑ́.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pɑɑ mɑ too nɑ mɑ cɑɑ pɑ lɔ-m,","poem":1},{"lineBreak":true},{"text":"Tɑcɑɑ, nyɑ́ mʋɣʋnɑ-m.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ, hʋlʋ-m mpɑɑʋ ŋku n cɑɑ mɑ́ təŋ tɔ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, mɑ kolontunɑɑ yookinɑ-m.","poem":1},{"lineBreak":true},{"text":"Tiiki-m kʋsiɣisuɣu tɑɑ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tɑɑ yele nɑ mɑ kolontunɑɑ","poem":1},{"lineBreak":true},{"text":"lɑnɑ-m ɩsənɑ pɑ cɑɑkɩ tɔ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, pɔpɔtʋ ɑseetɑ nyə́mɑ mpɛ,","poem":1},{"lineBreak":true},{"text":"pɑ nyɑɑsəɣɩ-m kɛ́.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ye mɑ tɑɑ wɛɛnɑ nɑɑni kɛ́","poem":1},{"lineBreak":true},{"text":"Tɑcɑɑ kʋpɑntʋ tɔɔ kɛ́ ɑtɛ cənɛ,","poem":1},{"lineBreak":true},{"text":"ɩsənɑɣɑ mɑɑ lɑpɑ?","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tɑŋ Tɑcɑɑ,","poem":1},{"lineBreak":true},{"text":"kɑɑsɩ nyɑ́ tɩ","poem":1},{"lineBreak":true},{"text":"nɑ ń tɔɣɔ ɑpɑlʋtʋ.","poem":1},{"lineBreak":true},{"text":"Tɑŋ Tɑcɑɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}