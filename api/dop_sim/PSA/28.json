{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":28,"content":[{"type":"heading","content":["Səm nɔɣɔ tɑɑ tʋ sələmʋɣʋ"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu.",{"lineBreak":true},{"text":"Tɑcɑɑ nyɑɣɑ mɑ mɑkɩ kɑpusi nɑ mɑ́ yɑɑkɩ,","poem":1},{"lineBreak":true},{"text":"mɑ kentulu, tɑɑ təkɩ nyɑ́ ŋkpɑŋŋ.","poem":1},{"lineBreak":true},{"text":"Ye n tɑ cɔ-m, mɑ wɛ kɛ́ ɩsɩɩ wei pɑ tisiɣi pəlɑɑʋ tɑɑ tɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wɑɑtʋ wei mɑ mɑkɩ kɑpusi nɑ mɑ́ yɑɑkɩ-ŋ","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ hʋləɣɩ niŋ nɑ nyɑ́ təcɑɣɑlɛ","poem":1},{"lineBreak":true},{"text":"nɑŋŋ nyəntɛ tɔɔ tɔ, nɩɩ mɑ wiinɑʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tɑɑ kɑɑ mɑ́ nɑ kɑwɑlɑɣɑ nyə́mɑ","poem":1},{"lineBreak":true},{"text":"nɑ ɩsɑɣɑlɑtɑɑ kɛ kpɑ́tʋɣʋ kʋlʋmʋɣʋ.","poem":1},{"lineBreak":true},{"text":"Pɑ kʋyɔɣɔtʋtʋ wɛ leleŋ kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ tɑɑ nɑ sɛɛsɩ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fɛlɩ-wɛɣɛ pɑ ɩsɑɣɑtʋ fɔɔtɔ","poem":1},{"lineBreak":true},{"text":"nɑ ń kɛɛsənɑ pɑ ɑcilɑɣɑtʋ təmɑ.","poem":1},{"lineBreak":true},{"text":"Lɛɛtɩ-wɛɣɛ pɑ kʋlɑpəlɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pɑɑ lɑkɩ lɑɑkɑlɩ nɑ nyɑ́ kʋlɑpʋtʋ nɑ nyɑ́ təmɑ.","poem":1},{"lineBreak":true},{"text":"Wɑkəlɩ-wɛ tənɑŋnɑŋ, pɑ́ tɑɑ tɑsɑ kʋlʋɣʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tɑcɑɑ, mɑ sɛɛ-ŋ","poem":1},{"lineBreak":true},{"text":"ɩsənɑ n nɩɩ mɑ wulɑ tɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nyɑɣɑlɛ mɑ toŋ nɑ mɑ kʋkentuɣu.","poem":1},{"lineBreak":true},{"text":"Nyɑɣɑ mɑ tʋɣɩ nɑɑni nɑ ń wɑɑsəɣɩ-m,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ wɛ lɑŋhʋlʋmlɛ tɑɑ nɑ mɑ́ sɑŋɩ-ŋ nɑ yontu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nyɑ́ kentiɣinɑ nyɑ́ yəlɑɑ nɑ toŋ,","poem":1},{"lineBreak":true},{"text":"nɑ ń wɑɑsəɣɩ nyɑ́ kʋləsʋ nɑ ɩɩ nyɑŋnɑ pʋlʋ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wɑɑsɩ nyɑ́ yəlɑɑ tɑ́ nɑ ń kooli-tʋɣʋ kʋpɑntʋ.","poem":1},{"lineBreak":true},{"text":"Tiiki-tʋ nɑ ń pɑɑsəɣənɑ-tʋɣʋ tɑm tɔɔ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, nyɑ́ tənnɑ-tʋ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}