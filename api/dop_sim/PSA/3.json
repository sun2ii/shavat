{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":3,"content":[{"type":"heading","content":["Kolontunɑɑ cɔɔnɑ Tɑfiiti kɛ kotɑɣɑ"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu.",{"text":"Pɑ kɛɛsɑ tə tɑɑ kɛ́ ɩsənɑ ɩ seekɑɣɑ ɩ pəyɑlʋ Apəsɑlɔm tɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hɑɩ Tɑcɑɑ, mɑ kolontunɑɑ tɔɔwɑɣɑ.","poem":1},{"lineBreak":true},{"text":"Mpɑ pɑ kʋləɣɩ mɑ tɔɔ tɔ, pɑ hukɑɑ kɛ́.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pɑ yɔɣɔtəɣɩ mɑ tɔm nɑ pɑ́ tɔŋ sɩ:","poem":1},{"lineBreak":true},{"text":"Ɩsɔ kɑɑ sənɑ-ŋ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amɑ Tɑcɑɑ, nyɑɣɑlɛ mɑ kpɑntɛ,","poem":1},{"lineBreak":true},{"text":"nyɑ́ tʋɣʋnɑ-m teeli nɑ ń kʋsəɣɩ mɑ nyʋɣʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ye mɑ yɑɑ-ŋ sɩ ń wɑɑsɩ-m,","poem":1},{"lineBreak":true},{"text":"n cɔɔkɩ nyɑ́ pʋɣʋ nɑŋŋ nyəŋkʋ tɔɔ kɛ́.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mɑ həntəɣɩ nɑ mɑ́ tooki nɑ mɑ́ feŋ tɔ,","poem":1},{"lineBreak":true},{"text":"Tɑcɑɑ pɑɑsəɣənɑnɑ-m.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mɑɑ nyɑŋnɑ kolontunɑɑ iyisi iyisi wei ɩ tɑmɑ-m kotɑɣɑ tɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Hɑɩ Tɑcɑɑ, kɔɔ.","poem":1},{"lineBreak":true},{"text":"Mɑ Ɩsɔ, yɑ-m.","poem":1},{"lineBreak":true},{"text":"N mɑkɩ mɑ kolontunɑɑ nɔɔsɩ kɛ́ nɑ ń holiɣi pɑ kelɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ nyɑ́ tike n wɑɑsəɣənɑ.","poem":1},{"lineBreak":true},{"text":"Kooli nyɑ́ yəlɑɑ kɛ kʋpɑntʋ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":9}