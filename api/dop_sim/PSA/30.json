{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":30,"content":[{"type":"heading","content":["Tɑcɑɑ hɑɑkɩ weesuɣu kʋfɑlʋɣʋ"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu nti pɑ yoo",{"text":"Ɩsɔ təsɛɛlɛ tʋlʋɣʋ wɑɑtʋ tɔɣɔlɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hɑɩ, Tɑcɑɑ, mɑ sɑmɑ-ŋ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, nyɑ́ ləsənɑ-m lumɑŋ tɑɑ.","poem":1},{"lineBreak":true},{"text":"N tɑ sɔɔlɩ sɩ mɑ kolontunɑɑ ɩ́ pɑɑnɑ-m.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mɑ Ɩsɔ Tɑcɑɑ,","poem":1},{"lineBreak":true},{"text":"mɑ wiinɑ-ŋ, ɩlɛnɑ ń wɑɑ-m.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mɑ nɔɔhəlɛ kɑ wɛʋ pəlɑɑʋ tɑɑ tɔ,","poem":1},{"lineBreak":true},{"text":"nyɑ́ ləsənɑ-m sətɑɑ tɛ́ nɑ ń hɑ-m weesuɣu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mpɑ mɛ ɩ́ sɔɔlɑ Tɑcɑɑ tɔ ɩ́ yoo-ɩ yontu.","poem":1},{"lineBreak":true},{"text":"Ɩ́ sɛɛ-ɩ nɑ ɩ́ sɑmɩ-ɩ ɩ tənɑŋŋ wɛɛtʋ tɔɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɩ pɑ́ɑ́nɑ́ wɛ lɑɑsɑɣɑ tɔɔ tike kɛ́.","poem":1},{"lineBreak":true},{"text":"Ɩlɛnɑ ɩ kʋpɑntʋ kɛ yʋlʋ weesuɣu tənɑ.","poem":1},{"lineBreak":true},{"text":"Tɑɑnɑɣɑ kɛ yʋlʋ wiiki nɑ kʋ fe tɑnɑŋ","poem":1},{"lineBreak":true},{"text":"ɩlɛnɑ ɩ́ woŋ nɑ ɩ́ kpɑləsɩ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wɑɑtʋ wei mɑɑ cɑɣɑnɑ mɑ tɩ tɔ,","poem":1},{"lineBreak":true},{"text":"mɑ hʋʋkɑɣɑ kɛ́ sɩ pʋlʋpʋ kɑɑ lɑ-m.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ nyɑ́ kʋpɑntʋ tɔɔ kɛ́ n kɑ yelɑɑ","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ səŋ teu təcɑ ɩsɩɩ pʋɣʋ.","poem":1},{"lineBreak":true},{"text":"N kɔmɑ nɑ ń hɑ-m siɣile ɩlɛnɑ pə liɣiti-m.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ḿpʋɣʋ mɑ mɑpɑ kɑpusi nɑ","poem":1},{"lineBreak":true},{"text":"mɑ́ wiinɑ-ŋ nɑ mɑ́ pɔɔsɩ-ŋ sɩ","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ye mɑ səpɑ nɑ mɑ́ tii pəlɑɑʋ tɑɑ weɣe n wɑɑkɩ?","poem":1},{"lineBreak":true},{"text":"Yʋlʋ ɩ́ pəsɑ tɛtʋ ɩ tɑsəɣɩ-ŋ sɑm yɑɑ ɩ́ kpɑɑlɩ","poem":1},{"lineBreak":true},{"text":"nyɑ́ kʋpɑntʋ tɔtɔɣɔ?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ, ke ŋkpɑŋŋ nɑ ń wɑɑsɩ-m,","poem":1},{"lineBreak":true},{"text":"Tɑcɑɑ kɔɔ nɑ ń yɑ-m.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ḿpʋɣʋ n lɑɣɑsɑ mɑ lɑŋwɑkəllɛ kɛ lɑŋhʋlʋmlɛ,","poem":1},{"lineBreak":true},{"text":"nɑ ń wɔɣɔsɩ mɑ ləyɑɣɑ wontu nɑ ń suu-m ɑcimɑ nyəntʋ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wɑɑtʋ ɩnəɣɩ mɑɑ yoo-ŋ yontu,","poem":1},{"lineBreak":true},{"text":"mɑ kɑɑ su, Tɑcɑɑ, mɑ Ɩsɔ,","poem":1},{"lineBreak":true},{"text":"mɑɑ sɑŋɩ-ŋ tɑm kɛ́.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":13}