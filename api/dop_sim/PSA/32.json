{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":32,"content":[{"type":"heading","content":["Wei Ɩsɔ hɩɩsɑ ɩ ɩsɑɣɑtʋ tɔ ɩ lɑŋhʋlʋmlɛ"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu.",{"lineBreak":true},{"text":"Leleŋ nɩɩlʋ ntɛ́ wei ɩ ɩsɑɣɑtʋ Ɩsɔ hɩɩsɑɑ","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ wii-ɩ ɩ kʋpəntəŋ tɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Leleŋ nɩɩlʋ ntɛ́ wei Tɑcɑɑ ɩɩ yeki sɩ","poem":1},{"lineBreak":true},{"text":"ɩ ɩsɑɣɑtʋ ɩ́ məlɩ ɩ nyʋɣʋ tɑɑ tɔ.","poem":1},{"lineBreak":true},{"text":"Pəyele cɛsʋɣʋ fɛɩ ɩ ləmɑɣɑsɛɛ tɑɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ye mɑ ŋmɛsɑ mɑ ɩsɑɣɑtʋ,","poem":1},{"lineBreak":true},{"text":"mɑɣɑ tə wɑkələɣɩ.","poem":1},{"lineBreak":true},{"text":"Nɑ mɑ́ mɔləɣɩ ilim nɑ pə tɛm.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mpi tɔ, ilim nɑ ɑhoo kɛ","poem":1},{"lineBreak":true},{"text":"n hɔŋɑɣɑ mɑ ŋkpɑŋʋɣʋ nɑ pə́ nɩɩ-m.","poem":1},{"lineBreak":true},{"text":"Mɑ tomɑ tɛmɑ ɩsɩɩ tʋɣʋ kɛ wʋlɑɣɑ tɛtʋ tɑɑ kɛ́ lʋŋlɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mɑ mɑɣɑsɑɑ sɩ mɑɑ hʋlɩ-ŋ mɑ ɩsɑɣɑtʋ,","poem":1},{"lineBreak":true},{"text":"mɑ tɑ ŋmɛsɩ-ŋ mɑ kʋpəntəŋ.","poem":1},{"lineBreak":true},{"text":"Ɩlɛnɑ nyɑɑ hɩɩsɩ-m tə tənɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Pə tɔɔ kɛ́ nyɑ́ yəlɑɑ tənɑ kɑ sələməɣɩ-ŋ","poem":1},{"lineBreak":true},{"text":"nɑ pɑɑ wɑɑtʋ wei wɑhɑlɑnɑɑ","poem":1},{"lineBreak":true},{"text":"wɑtɑ-wɛ ɩsɩɩ lʋm, pɩɩ tɑkɩ-wɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nyɑɣɑ mɑ cɔɔsəɣənɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ń hɑtələɣənɑ-m lɑŋwɑkəllɛ.","poem":1},{"lineBreak":true},{"text":"Nɑ mɑ́ ŋmɑɑləɣənɑ mɑ nyʋɣʋ yɑpʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ḿpʋɣʋ Tɑcɑɑ cɔ-m sɩ: Mɑɑ sɛɣɛsɩ-ŋ","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ hʋlɩ-ŋ mpɑɑʋ ŋku n kɑ́ təŋ tɔ.","poem":1},{"lineBreak":true},{"text":"Nɑ mɑ́ pɑɑsəɣənɑ-ŋ nɑ mɑ́ tɑsəɣɩ-ŋ lɑɣɑtʋ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tɑɑ lɑ kʋmɛlɛntʋ ɩsɩɩ kpɑɣɑnʋ,","poem":1},{"lineBreak":true},{"text":"yɑɑ kpɑŋɑɣɑ ŋkɑ pɑ kɛɛkənɑ kpɑsɩ tɔ.","poem":1},{"lineBreak":true},{"text":"Ɩlɛ nɑtəlɩ tə kɑɑ mɑɣɑnɑ-ŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ɩsɑɣɑʋ wɛ wɑhɑlɑnɑɑ pɑɣɑlɛ tɑɑ kɛ́.","poem":1},{"lineBreak":true},{"text":"Ɩlɛnɑ Tɑcɑɑ nɑ́ɑ́ pələɣɩ kʋpɑntʋ kɛ wei","poem":1},{"lineBreak":true},{"text":"ɩ tʋɣɩ-ɩ nɑɑni tɔ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Siɣisilɑɑ mɛ, ɩ́ yɔɔlənɑ Tɑcɑɑ nɑ ɩ́ ŋmɑɑlɩ.","poem":1},{"lineBreak":true},{"text":"Nɑ tɑmpɑnɑ təŋlɑɑ mɛ mə tənɑ","poem":1},{"lineBreak":true},{"text":"mɩɩ wilitinɑ lɑŋhʋlʋmlɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/33.json