},{"lineBreak":true},{"text":"nɑ ɩ́ təŋəɣɩ mpɑɑʋ ŋku kʋ fɛɩ teu tɔ,","poem":1},{"lineBreak":true},{"text":"ɩɩ lɔɔkɩ ɩsɑɣɑtʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tɑcɑɑ nyɑ́ kʋpɑntʋ wɑlɑɑ kɛ́ ɩsɩɩ ɩsɔtɔnʋɣʋ","poem":1},{"lineBreak":true},{"text":"nɑ nyɑ́ teu nɑ́ɑ́ kɑləsənɑ ɩsɔŋmʋntʋ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nyɑ́ siɣisuɣu kɑɑwɑɣɑ ɩsɩɩ pulɑsɩ.","poem":1},{"lineBreak":true},{"text":"Nɑ nyɑ́ kʋmɑɣɑsʋtʋ nɑ́ɑ́ lumɑɑ ɩsɩɩ teŋku.","poem":1},{"lineBreak":true},{"text":"Nyɑ́ wɑɑsəɣənɑ yəlɑɑ nɑ tɔlɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hɑɩ, Ɩsɔ nyɑ́ kʋpɑntʋ tewɑɣɑ.","poem":1},{"lineBreak":true},{"text":"Nɑ yəlɑɑ ŋmɛləɣɩ nyɑ́ tɛɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nyɑ́ təyɑɣɑ tɑɑ wɛnɑʋ kɛ n hɑɣɑsəɣɩ-wɛ,","poem":1},{"lineBreak":true},{"text":"nɑ ń yeki nɑ pɑ́ nyɔɔkɩ nyɑ́ kʋpɑntʋ ɩsɩɩ lʋm.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nyɑ́ kiŋ kɛ weesuɣu sɛɛlʋ wɛɛ.","poem":1},{"lineBreak":true},{"text":"Nɑ tə nɑɑkənɑ nyɑ́ nyɑɑləm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tɑcɑɑ lɑ kʋpɑntʋ kɛ mpɑ pɑ nyəmɑ-ŋ tɔ","poem":1},{"lineBreak":true},{"text":"nɑ mpɑ pɑ təŋəɣɩ tɑmpɑnɑ tɔ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kɑlɑmpɑɑnɩ tʋ ɩ́ tɑɑ fɛlɩ-m nɔɔhəlɛ.","poem":1},{"lineBreak":true},{"text":"Pəyele ɩsɑɣɑʋ ɩ́ tɑɑ tɔɣɔnɩ-m.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ɩɩ nɑɑkɩ yəlɑɑ ɑsɑɣɑɑ tɛmɑ","poem":1},{"lineBreak":true},{"text":"hotuɣu nɑ pɑ́ pəsɩ kpɛntəlɑsɩ","poem":1},{"lineBreak":true},{"text":"pɑɑ pəsəɣɩ kʋlʋɣʋ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/35.json","previousC