":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mɑ Ɩsɔ Tɑcɑɑ nyɑɣɑ mɑ tekiɣi,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ tɑŋɑɑ sɩ ń cɔnɑ mɑ nɔɣɔ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hɑlɩ mɑ sələmɑ-ŋ sɩ ń tɑɑ yele nɑ pɑ́ pɑɑnɑ-m.","poem":1},{"lineBreak":true},{"text":"Yɑɑ pɑ́ kɛɛsənɑ mɑ cɛŋlʋɣʋ nɑ pɑ́ kʋlɩ mɑ tɔɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Mpi tɔ, mɑ cɛɛ fiɣinuɣu kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ wʋsɑsɩ tɔɔsəɣɩ-m pə tɔm.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mɑ tisɑ mɑ kʋpəntʋɣʋ kɛ́","poem":1},{"lineBreak":true},{"text":"nɑ kʋ tɔm cɑɑləɣɩ-m.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mɑ kolontunɑɑ wɛnɑ ɑlɑɑfəyɑ kɛ́ nɑ tomɑ.","poem":1},{"lineBreak":true},{"text":"Mpɑ pɑ footiɣi-m mʋsʋŋ tɔ,","poem":1},{"lineBreak":true},{"text":"pɑ pɑɣɑlɛ wɛ sɔɣɔntʋ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ɩsɑɣɑtʋ kɛ pɑ lɛɛtəɣɩ-m mɑ kʋpɑntʋ lonte.","poem":1},{"lineBreak":true},{"text":"Mɑ pɛɛkəɣɩ kʋpɑntʋ tɔɣɔ pɑɑ cɑɑkɩ-m.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Mɑ Ɩsɔ Tɑcɑɑ, tɑɑ lɔ-m.","poem":1},{"lineBreak":true},{"text":"Pəyele tɑɑ hɑtələnɑ-m pooluŋ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mɑ cɑɑ, mɑ nyʋɣʋ yɑ́tʋ,","poem":1},{"lineBreak":true},{"text":"kɔɔ lɔŋ kɛ mɑ wɑɑsʋɣʋ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":23}