{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":38,"content":[{"type":"heading","content":["Kʋtɔntʋ wei ɩ nyəmɑ ɩ təwɑkəllɛ tɔ ɩ sələmʋɣʋ"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu nti",{"text":"pɑ tɔɔsəɣənɑ Ɩsɔ tɔɔ tɔɣɔlɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Tɑcɑɑ tɑɑ hɔ mɑ ŋkpɑŋʋɣʋ","poem":1},{"lineBreak":true},{"text":"yɑɑ ń tʋ-m sɑləkɑ nɑ pɑ́ɑ́nɑ́.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mpi tɔ, nyɑ́ nyəmɑ́ yɑɣɑ-m kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ nyɑ́ niŋ yuŋ tii mɑ tɔɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nyɑ́ pɑ́ɑ́nɑ́ tɔɔ,","poem":1},{"lineBreak":true},{"text":"mɑ tɔnʋɣʋ fɛɩ təcʋŋŋ.","poem":1},{"lineBreak":true},{"text":"Mɑ kʋpəntʋɣʋ tɔɔ,","poem":1},{"lineBreak":true},{"text":"ɑlɑɑfəyɑ fɛɩ mɑ mʋwɑ tɑɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mɑ ɩsɑɣɑtʋ kəlɑ-m kʋŋkʋlʋməŋ.","poem":1},{"lineBreak":true},{"text":"Nɑ t