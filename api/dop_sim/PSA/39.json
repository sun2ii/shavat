{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":39,"content":[{"type":"heading","content":["Kʋnyɔntɔɣɔlʋ kʋpəntəŋ tisuɣu"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu nti tə wɛ yonyoolɑɑ nyʋɣʋ tʋ",{"text":"yontunɑɑ nɑ Yetutuŋ nyəntʋ tɑɑ tɔɣɔlɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mɑɑ tʋwɑ mɑ tɑɑ kɛ́ sɩ mɑɑ feŋ mɑ tɔntɛ tɔɔ,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ tɑɑ pəntənɑ mɑ nɔɣɔ.","poem":1},{"lineBreak":true},{"text":"Mɑɑ kpɑ mɑ nɔɣɔ kɛ wɑɑtʋ wei ɩsɑɣɑtʋ kɑ́ wɛɛ mɑ kiŋ tɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pə tɔɔ kɛ́ mɑ sumɑ ɩsɩɩ kɑmumukɑ.","poem":1},{"lineBreak":true},{"text":"Amɑ mɑ lɑŋlɛ wɑkəlɑɑ nɑ mɑ wʋsɑsɩ sɔɔsɩ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nəɣəsɛɛ pɩɩ-m nɑ ɑ́ nyɑɣɑ mɑ tɑɑ","poem":1},{"lineBreak":true},{"text":"ɩsɩɩ kɔkɔ nɑ mɑ́ mɔləɣɩ.","poem":1},{"lineBreak":true},{"text":"Ntɛnɑ pə́ cɑɑlɩ-m sɩ mɑ́ sələmɩ sɩ:","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tɑcɑɑ kɛɛsɩ-m sɑɑ wei mɑ weesuɣu kɑ́ tɛ tɔ.","poem":1},{"lineBreak":true},{"text":"Kʋyɛɛŋ ɩsənɑɣɑ pə kɑɑsɑ-m.","poem":1},{"lineBreak":true},{"text":"Yele nɑ mɑ́ nyɩ ɩsənɑ mɑ wɛ tətɑntɑɑ tɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mɑ weesuɣu tɑɣɑləŋ wɛ kɛ́ ɩsɩɩ ntɑntɑkʋ wɑŋ.","poem":1},{"lineBreak":true},{"text":"Pəyele kʋ tɑ kɛ-ŋ pʋlʋ.","poem":1},{"lineBreak":true},{"text":"Yəlɑɑ tənɑ wɛ kɛ́ ɩsɩɩ heelim.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yʋlʋ cɔɔkɩ kɛ́ ɩsɩɩ ɩsotom,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ tɑŋtəɣɩ ɩsɩɩ heelim,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ kɑɑkɩ wɛnɑʋ huwɑ.","poem":1},{"lineBreak":true},{"text":"Amɑ ɩ tɑ nyɩ kʋ kuulu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tɑcɑɑ, pənɛntɛ pepeɣe mɑ tɑsəɣɩ tɛɛlʋɣʋ?","poem":1},{"lineBreak":true},{"text":"Nyɑɣɑ mɑɑ tɛɛlɩ təkpɑtɑɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wɑɑsɩ-m mɑ kɑwɑlɑɣɑ tənɑ tɑɑ.","poem":1},{"lineBreak":true},{"text":"Tɑɑ yele nɑ kʋmɛlɛməŋ woŋɩ-m.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pənɛntɛ mɑ sumɑɣɑ,","poem":1},{"lineBreak":true},{"text":"mɑɑ kuliɣi nɔɣɔ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, nyɑ́ yelinɑ nɑ mɑ́ wɛɛ yɑɑsi ɩnɛ ɩ tɑɑ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hɑɩ, yele-m mɑpʋ kɛ mpʋ.","poem":1},{"lineBreak":true},{"text":"Mɑ tɔm kɑ́ tɛ nyɑ́ niŋ tɑɑ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yʋlʋ ɩsɑɣɑtʋ kɛ n hɔŋnɑ ɩ ŋkpɑŋʋɣʋ,","poem":1},{"lineBreak":true},{"text":"nɑ ń wɑkələɣɩ ɩ weesuɣu ŋku","poem":1},{"lineBreak":true},{"text":"ɩ sɔɔlɑ teu tɔ ɩsɩɩ sonsompəle","poem":1},{"lineBreak":true},{"text":"wɑkəlʋɣʋ tʋɣʋ pile tɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Hɑɩ, Tɑcɑɑ ke ŋkpɑŋŋ nɑ ń nɩɩ,","poem":1},{"lineBreak":true},{"text":"mɑ kʋsələmʋtʋ nɑ mɑ kɑpusi.","poem":1},{"lineBreak":true},{"text":"Mɑ ɩsəlʋm tɔm ɩ́ tɑɑ kisi-ŋ pətɔɔtəlɛ lɑpʋ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, mɑ kɛ́ mʋʋlʋ kɛ nyɑ́ tɛɣɛ,","poem":1},{"lineBreak":true},{"text":"ɩsɩɩ mɑ cɔsɔnɑɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kʋsɩ nyɑ́ ɩsɛ kɛ mɑ tɔɔ","poem":1},{"lineBreak":true},{"text":"nɑ ń yele nɑ mɑ́ feesi","poem":1},{"lineBreak":true},{"text":"nɑ pə́cɔ mɑ́ tɛɛ nɑ pə́ sɑɑlɩ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":14}