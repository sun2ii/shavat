{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":4,"content":[{"type":"heading","content":["Tɑcɑɑ kisuɣu kɛ tɔm tʋɣʋ"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu nti pɑ yoonɑ sɑŋkʋ nɑ tə́ wɛ Yonyoolɑɑ",{"text":"nyʋɣʋ tʋ yontunɑɑ tɑɑ tɔɣɔlɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hɑɩ, Ɩsɔ cɔ-m wɑɑtʋ wei mɑ wiikinɑ-ŋ tɔ.","poem":1},{"lineBreak":true},{"text":"Nyɑɣɑlɛ mɑ tɑmpɑnɑ hɑlʋ.","poem":1},{"lineBreak":true},{"text":"Nyɑ́ wɑɑsənɑ-m mɑɑ wɛʋ lɑŋwɑkəllɛ tɑɑ tɔ.","poem":1},{"lineBreak":true},{"text":"Nyənɩ mɑ pətɔɔtəlɛ nɑ ń nɩɩ mɑ kʋsələmʋtʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mpɑ mɛ mə pɛɛkəɣɩ sɩ ɩ́ cɑɣɑnɑ-m nɑ ɩ́ tʋʋ-m mʋsʋŋ tɔ,","poem":1},{"lineBreak":true},{"text":"pəlee kɛ́ mɩɩ hɛɛsɩ mɑ nyʋɣʋ kʋɣʋ nɑ kɑloolɑɣɑ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɩ́ nyɩ sɩ Tɑcɑɑ lɑpɑ-m pɛɛlɛɛ sɔsɔɔnɑ kɛ́.","poem":1},{"lineBreak":true},{"text":"Ye mɑ yɑɑ-ɩ sɩ ɩ́ wɑɑsɩ-m ɩ nɩɩkɩ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɩ́ sele, ɩlɛ ɩ tɑɑ pəntɩ.","poem":1},{"lineBreak":true},{"text":"Ɩ́ ponɑ ləmɑɣɑsɛɛ kɛ mə təhəntəlɛnɑɑ kɛ ɑhoo nɑ ɩ́ cɑɣɑ tətiɣitiɣi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ɩ́ pɛtɩ mə təɣɩ Tɑcɑɑ nɑ ɩ́ lɑpɩ-ɩ kɔtɑsɩ nsi sə təŋɑɑ tɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Pɑɣɑlɛ wiikinɑ sɩ:","poem":1},{"lineBreak":true},{"text":"Awe kɑ yele nɑ tə nɩɩ leleŋ?","poem":1},{"lineBreak":true},{"text":"Tɑcɑɑ nyənɩ tɑ́ tɔɔ nɑ ɩsɛ kʋpɑnɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Amɑ n tʋ mɑ tɑɑ kɛ́ lɑŋhʋlʋmlɛ nɑ pə́ kəlɩ","poem":1},{"lineBreak":true},{"text":"mpɛɣɛ wɑɑtʋ wei pɑ wɛnɑ pɑ tɔɣɔnɑɣɑ","poem":1},{"lineBreak":true},{"text":"nɑ pɑ sʋlʋm tuutuumɑ tɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mɑ həntəɣɩ kɛ́ nɑ mɑ́ tooki teu.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, Tɑcɑɑ tike kentiɣinɑ mɑ təcɑɣɑlɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":9}