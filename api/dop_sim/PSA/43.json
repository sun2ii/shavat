{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":["Hɑɩ, Ɩsɔ, sɛɛnɑ mɑ tɔɔ kɛ́",{"text":"mpɑ pɑ tɑ nyɩ-ŋ tɔ pɑ tɔm tɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ń hɑ-m tɑmpɑnɑ.","poem":1},{"lineBreak":true},{"text":"Yɑ-m pɔpɔtʋnɑɑ nɑ ɑsɑɣɑɑ niŋ tɑɑ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nyɑɣɑlɛ mɑ kentulu,","poem":1},{"lineBreak":true},{"text":"n kisiɣi-m suwe?","poem":1},{"lineBreak":true},{"text":"N yelɑɑ nɑ pə́ nɩɩkɩ-m","poem":1},{"lineBreak":true},{"text":"nɑ mɑ kolontunɑɑ ŋmɑkələɣɩ-m suwe?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hʋlɩ-m nyɑ́ nyɑɑləm nɑ nyɑ́ tɑmpɑnɑ","poem":1},{"lineBreak":true},{"text":"nɑ ɑ́ ponɑ-m nyɑ́ təcɑɣɑlɛ","poem":1},{"lineBreak":true},{"text":"kɛ nyɑ́ pʋɣʋ nɑŋŋ nyəŋkʋ tɔɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɩlɛ mɑɑ kpətənɑ nyɑ́ kɔtɑɣɑ təlɑtɛ tənɑ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, nyɑɣɑlɛ mɑ lɑŋhʋlʋmlɛ nɑ mɑ ɑyɔɔlɛɛ.","poem":1},{"lineBreak":true},{"text":"Hɑɩ, mɑ Ɩsɔ mɑɑ sɛɛ-ŋ nɑ mɑ sɑŋkʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Pepe tɔɔ kɛ́ mɑ lɑŋlɛ wɑkələɣɩ mɑ tɩ tɔm tɔtɔ?","poem":1},{"lineBreak":true},{"text":"Pə kəlɑ teu sɩ mɑ́ tɛɛlɩ mɑ Ɩsɔ","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ tɑsɑ-ɩ sɑm tɔtɔ.","poem":1},{"lineBreak":true},{"text":"Ɩnəɣəlɛ mɑ wɑɑsʋlʋ Ɩsɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}