ɑŋɑ hɛɛwɑ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kɑwilitɑsɩ nɑ tutuɣu wulɑ kɛ","poem":1},{"lineBreak":true},{"text":"Ɩsɔ Tɑcɑɑ kpɑnɑ ɩ kumte tɔɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ɩ yoo Tɑcɑɑ kɛ yontu.","poem":1},{"lineBreak":true},{"text":"Ɩnəɣəlɛ tɑ́ wulɑʋ, ɩ́ sɑmɩ-ɩ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɩsɔ kɛlɛ tɛtʋ tənɑ wulɑʋ.","poem":1},{"lineBreak":true},{"text":"Ɩ́ sɑmɩ-ɩ nɑ yontu kʋpɑntʋ tɑɑ kʋpɑntʋ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ɩsɔ cɑɣɑ ɩ kumte nɑŋŋ nyəntɛ tɔɔ kɛ́","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ tɔkɩ piitimnɑɑ tɔɔ kɛ́ kɑwulɑɣɑ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Piitimnɑɑ ɑwulumpiyɑ sɔɔsɑ Apəlɑhɑm Ɩsɔ yəlɑɑ tɔɔ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, ɩnɩ ɩ tənnɑ ɑtɛ ɑwulɑɑ nɑ pəsəlɑɑ tənɑ","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ tɔkɩ pɑ tənɑ pɑ tɔɔ kɛ́ kɑwulɑɣɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":10}