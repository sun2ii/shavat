{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":53,"content":[{"type":"heading","content":["Yəlɑɑ kʋpɑmɑ nɑ pɑ Ɩsɔ kɛ ɑntulinyɑ ɩsɑɣɑʋ tɑɑ"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu nti tə wɛ yonyoolɑɑ nyʋɣʋ tʋ",{"text":"yontunɑɑ tɑɑ tɔɣɔlɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kʋmɛlɛməŋ mɑɣɑsəɣənɑ ɩ tɑɑ sɩ Ɩsɔ fɛɩ.","poem":1},{"lineBreak":true},{"text":"Yəlɑɑ mpɛ ɑcɑɑlətʋ kɛ pɑ lɑkɩ,","poem":1},{"lineBreak":true},{"text":"kʋpɑntʋ lɑtʋ fɛɩ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hɑtoo ɩsɔtɑɑ kɛ́ Tɑcɑɑ nyənəɣənɑ ɑtɛ yəlɑɑ","poem":1},{"lineBreak":true},{"text":"sɩ ɩ nɑɑkɩ sɩ ləmɑɣɑsɛɛ tʋ nɔɣɔlʋ ɩ pɛɛkəɣɩ-ɩ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pɑ tənɑ pɑ yelɑ ɩ mpɑɑʋ kɛ́ nɑ pɑ́ wɑkəlɩ.","poem":1},{"lineBreak":true},{"text":"Kʋpɑntʋ lɑtʋ fɛɩ pɑ tɑɑ pɑɑ kʋlʋm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ɩsɑɣɑlɑtɑɑ mpɛ pɑ kɑɑ nɩɩ.","poem":1},{"lineBreak":true},{"text":"Pɑ pəsɑ mɑ yəlɑɑ ɩsɩɩ tɔɣɔnɑɣɑ nɑ pɑ́ tɔkɩ pɑɑ sɛɛkɩ-m.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tənɑɣɑ pɑɑ selinɑ sɔɣɔntʋ pə́cɔ sɔɣɔntʋ fɛɩ.","poem":1},{"lineBreak":true},{"text":"Ɩsɔ kɑ́ kʋ mpɑ pɑ kʋləɣɩ ɩ tɔɔ tɔ nɑ ɩ́ lɔ.","poem":1},{"lineBreak":true},{"text":"Pɑɑ tɔɣɔ fɛɛlɛ, mpi tɔ, Ɩsɔ lɔ-wɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hɑɩ, mɑ kooliɣi kɛ́ sɩ Ɩsɛɣɛlɩ nyə́mɑ wɑɑsʋɣʋ","poem":1},{"lineBreak":true},{"text":"ɩ́ lɩɩnɑ Ɩsɔ pʋɣʋ tɑɑ kɛ́ wɑɑtʋ wei","poem":1},{"lineBreak":true},{"text":"Tɑcɑɑ kɑ́ məŋnɑ ɩ yəlɑɑ mpɑ pɑɑ kuuwɑ tɔ.","poem":1},{"lineBreak":true},{"text":"Yɑkɔpʋ lʋlʋɣʋ nyə́mɑ Ɩsɛɣɛlɩ nyə́mɑ kɑ́","poem":1},{"lineBreak":true},{"text":"ŋmɑɑlənɑ lɑŋhʋlʋmlɛ sɔsɔɔlɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":7}