{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":54,"content":[{"type":"heading","content":["Kʋnyɔntɔɣɔlʋ yɑɑkɩ sɩ pɑ́ wɑɑsɩ-ɩ"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu nti pɑ yookinɑ sɑŋkʋ",{"text":"nɑ tə wɛ yonyoolɑɑ nyʋɣʋ tʋ tɑkəlɑɣɑ tɑɑ tɔɣɔlɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tə tɑɑ kɛ́ pɑ kɛɛsəɣɩ ɩsənɑ Sifɩ nyə́mɑ polɑ","poem":1},{"lineBreak":true},{"text":"Sɑyuli kiŋ nɑ pɑ́ tɑɣɑsɩ-ɩ sɩ","poem":1},{"lineBreak":true},{"text":"Tɑfiiti ŋmɛlɑ pɑ tɛtʋ tɑɑ tɔ.","poem":1},{"lineBreak":true},{"text":"Yontu ntəɣəlɛ sɩ:","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hɑɩ, Ɩsɔ, yɑ-m nyɑ́ hətɛ tɔɔ,","poem":1},{"lineBreak":true},{"text":"nɑ ń hʋlɩ mɑ tɑmpɑnɑ nɑ nyɑ́ toŋ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hɑɩ, Ɩsɔ nɩɩ mɑ kʋyɔɣɔtʋtʋ.","poem":1},{"lineBreak":true},{"text":"Ke ŋkpɑŋŋ nɑ ń nɩɩ mɑ kʋsələmʋtʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mpi tɔ, kpɑɩ nyə́mɑ kʋlɑ mɑ tɔɔ,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ sɔɔlɩ mɑ weesuɣu ləsʋɣʋ nɑ mʋsʋŋ","poem":1},{"lineBreak":true},{"text":"pɑ pɑɑ fɛɩnɑ-ŋ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Amɑ nyɑɑ wɑɑsənɑ-m,","poem":1},{"lineBreak":true},{"text":"nyɑɣɑlɛ Tɑcɑɑ, nɑ ń pɑɑsəɣənɑ-m.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ɩsɑɣɑtʋ ɩ́ məlɩ mɑ kolontunɑɑ nyɔɔŋ tɑɑ","poem":1},{"lineBreak":true},{"text":"nɑ ń təkɩ pɑ nɔɔsɩ kɛ nyɑ́ tɑmpɑnɑ tɔɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mɑɑ lɑ-ŋ kɔtɑɣɑ nɑ lotu kʋlʋmtʋ","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ sɑ nyɑ́ hətɛ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, Tɑcɑɑ n kɛ́ kʋpɑŋ kɛ́.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N fitɑ-m nəɣəsɛɛ tənɑ tɑɑ kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ nyənəɣɩ mɑ kolontunɑɑ kpisuɣu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":9}