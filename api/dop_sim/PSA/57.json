{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":57,"content":[{"type":"heading","content":["Tɑfiiti sələməɣɩ ɩsɔtɑɑ Ɩsɔ sɔsɔ"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu nti tə wɛ yonyoolɑɑ nyʋɣʋ tʋ",{"text":"yontunɑɑ tɑɑ nɑ pɑ́ yɑɑkɩ-tɩ sɩ:","poem":1},{"lineBreak":true},{"text":"Tɑɑ kʋ tɔɣɔlɔ.","poem":1},{"lineBreak":true},{"text":"Tə tɑɑ kɛ́ Tɑfiiti kɛɛsəɣɩ ɩsənɑ ɩ sewɑ Sɑyuli nɑ ɩ́","poem":1},{"lineBreak":true},{"text":"ŋmɛlɩ kʋkpɑmʋɣʋ pʋʋɣʋ tɑɑ tɔ pə tɔm.","poem":1},{"lineBreak":true},{"text":"Yontu ntəɣəlɛ sɩ:","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hɑɩ, Ɩsɔ nyənɩ mɑ pətɔɔtəlɛ yoo,","poem":1},{"lineBreak":true},{"text":"nyənɩ mɑ pətɔɔtəlɛ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, nyɑ́ kiŋ kɛ mɑ pɛɛkəɣɩ mɑ təcɔɔsəlɛ.","poem":1},{"lineBreak":true},{"text":"Mɑɑ ŋmɛlɩ tənɑ, nɑ n kenti mɑ tɔɔ,","poem":1},{"lineBreak":true},{"text":"hɑlənɑ wɑhɑlɑnɑɑ pɑnɛ pɑ́ tɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɩsɔtɑɑ Ɩsɔ Sɔsɔ kɛ mɑ yɑɑkɩ.","poem":1},{"lineBreak":true},{"text":"Ɩnɩ ɩ lɑpənɑ-m pə tənɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɩ kɑ́ wɑɑsɩ-m nɑ hɑtoo ɩsɔtɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ liɣiti wei ɩ tʋ mɑ wɑɑlɩ tɔ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ lɑ-m ɩ kʋpɑntʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mpɑ pɑ hɛkʋ mɑ wɛɛ tɔ","poem":1},{"lineBreak":true},{"text":"pɑ tɔkɩ yəlɑɑ kɛ́ ɩsɩɩ tɔɣɔlɑsɩ.","poem":1},{"lineBreak":true},{"text":"Pɑ kelɑ sɛŋtɑɑ kɛ́ ɩsɩɩ ŋmɑntɑɑsɩ nɑ nyəmɑ́,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ nsəmlɛ nɑ lɔŋ ɩsɩɩ lɑɣɑtɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hɑɩ Ɩsɔ, nyɑ́ sɔsɔɔntʋ ɩ́ kəlɩ ɩsɔtɔnʋɣʋ kɛ kʋlʋɣʋ,","poem":1},{"lineBreak":true},{"text":"nɑ nyɑ́ teu nɑ tɛtʋ tənɑ tɔɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Pɑɑ hulɑ pʋʋɣʋ kɛ mɑ mpɑɑʋ tɑɑ kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ kʋ lumsu-m.","poem":1},{"lineBreak":true},{"text":"Ɩlɛnɑ pɑ́ nyɩ-m kɑtɔkɑ.","poem":1},{"lineBreak":true},{"text":"Amɑ kʋlʋmɑɑ mpɛ pɑ hotinɑ kɑ tɑɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Hɑɩ Ɩsɔ, mɑ nyɔɔ toŋ,","poem":1},{"lineBreak":true},{"text":"mɑɑ sɑ-ŋ nɑ mɑ́ pʋɣʋlɩ-ŋ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mɑ ləsɑɣɑ, fe,","poem":1},{"lineBreak":true},{"text":"mɑ cəmʋɣʋ nɑ mɑ sɑŋkʋ ɩ́ fe,","poem":1},{"lineBreak":true},{"text":"mɑɑ fe nɑ pə́cɔ pə́ nyɑɑlɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tɑcɑɑ mɑɑ sɑ-ŋ yəlɑɑ tɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ pʋɣʋlɩ-ŋ piitimnɑɑ tɑɑ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mpi tɔ, nyɑ́ kʋpɑntʋ sɔsɔɔntʋ tɑpɑ ɩsɔtɔnʋɣʋ kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ nyɑ́ teu nɑ́ɑ́ tɛɛ ɩsɔŋmʋntʋ tɔɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Hɑɩ Ɩsɔ, kpɑɑsɩ nyɑ́ təɣɩ ɩsɔtɔnʋɣʋ tɔɔ,","poem":1},{"lineBreak":true},{"text":"nɑ nyɑ́ teeli nɑ tɛtʋ tənɑ tɑɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":12}