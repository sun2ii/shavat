{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":58,"content":[{"type":"heading","content":["Ɩsɔ wɛ tɛtʋ tɔɔ nɑ ɩ́ hʋʋkənɑ"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu nti tə wɛ yonyoolɑɑ nyʋɣʋ tʋ",{"text":"yontunɑɑ tɑɑ nɑ pɑ́ yɑɑkɩ-tɩ sɩ:","poem":1},{"lineBreak":true},{"text":"Tɑɑ kʋ tɔɣɔlɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yəlɑɑ mɛ sum tɑɑ kɛ́ ɩ́ kɑ́ hʋlənɑ tɑmpɑnɑ nɑ?","poem":1},{"lineBreak":true},{"text":"Ḿpʋɣʋ ɩ́ təŋəɣɩ siɣisuɣu nɑ ɩ́ hʋʋkənɑ?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Təfɑɑ kɛ ɩ́ lɑkənɑ ɩsɑɣɑtʋ kɛ tɛtʋ tɔɔ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ lɑkɩ mʋsʋŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hɑtoo ɑsɑɣɑɑ hɔɔʋ tɛɛ kɛ́ pɑ wɑkəlɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ pɔpɔtʋnɑɑ nɑ́ɑ́ leki nɑ pə́cɔ","poem":1},{"lineBreak":true},{"text":"pɑ lɩɩkɩ pɑ toonɑɑ lotu tɑɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pɑ wɛ sɔtʋ kɛ́ ɩsɩɩ tʋmɑɑ,","poem":1},{"lineBreak":true},{"text":"yɑɑ ɩsɩɩ pɑɑsəlɛ ntɑm wei ɩ təkəɣɩ ŋkpɑŋŋ tɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɩsɩɩ pɑɑsəlɛ nte tɩɩ nɩɩkɩ tʋʋ yontu tɔ,","poem":1},{"lineBreak":true},{"text":"pɑɑ tʋwɑɑ tɑɑ ɑkɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hɑɩ, Ɩsɔ holi pɑ kelɑ kɛ pɑ nɔɔsɩ tɑɑ,","poem":1},{"lineBreak":true},{"text":"Tɑcɑɑ yɔkɩ tɔɣɔlɑsɩ tɑmɑsɩ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pɑ́ mʋkɩ yem ɩsɩɩ lʋm kpeŋuɣu tɔ.","poem":1},{"lineBreak":true},{"text":"Ye pɑ tɔ nɔɣɔlʋɣʋ nyəmɑ́, ɑ́ pəsɩ kpɛtɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pɑ́ sɩ nɑ pɑ́ yɔɔlɩ yem ɩsɩɩ ɑtɑntɑɑlʋ.","poem":1},{"lineBreak":true},{"text":"Nɑ pɑ́ wɛɛ ɩsɩɩ pə hɔləsʋɣʋ pəyɑɣɑ,","poem":1},{"lineBreak":true},{"text":"nɑ kɑ́ tɑ́ keesi ilim tɔ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pɑ sɔwɑ́ tɩɩŋ kɑɑ lɑ hɔtʋ,","poem":1},{"lineBreak":true},{"text":"nɑ pə́cɔ Ɩsɔ kpɛsɩ-ɩ ɩsɩɩ kɑcuculɑɣɑ,","poem":1},{"lineBreak":true},{"text":"pɑɑ ɑ wʋlɑɑ yɑɑ ɑ́ nɑ ɑ lʋm, pə tɑ kʋ pʋlʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yʋlʋpɑŋ lɑŋlɛ kɑ́ hʋlʋmɩ","poem":1},{"lineBreak":true},{"text":"wɑɑtʋ wei Ɩsɔ kɑ́ lɛɛtɩ ɑsɑɣɑɑ tɔ","poem":1},{"lineBreak":true},{"text":"ɩnɩ ɩ kɑ́ tɔ pɑ cɑləm tɑɑ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wɑɑtʋ ɩnəɣɩ yəlɑɑ tənɑ kɑ́ tɔ sɩ:","poem":1},{"lineBreak":true},{"text":"Yəlɑɑ kʋpɑmɑ wɛnɑ pɑ kɑsəyɑɣɑ,","poem":1},{"lineBreak":true},{"text":"Ɩsɔ wɛ ɑtɛ nɑ ɩ́ hʋʋkənɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":12}