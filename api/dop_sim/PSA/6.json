{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":6,"content":[{"type":"heading","content":["Tɑcɑɑ wɑɑsʋɣʋ kɛ wɑhɑlɑ wɑɑtʋ"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu nti pɑ yoonɑ ŋmɩɩsɩ pəlefɛɩ sɑŋkʋ",{"text":"nɑ tə wɛ yonyoolɑɑ nyʋɣʋ tʋ yontunɑɑ tɑɑ tɔɣɔlɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hɑɩ, Tɑcɑɑ, n mʋ-m nɑ pɑ́ɑ́nɑ́ tɔ","poem":1},{"lineBreak":true},{"text":"tɑɑ hɔ mɑ ŋkpɑŋʋɣʋ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hɑɩ, Tɑcɑɑ, mɑ toŋ tɛmɑ nɑ mɑ kɑ tətɔɣɔtɔɣɔ.","poem":1},{"lineBreak":true},{"text":"Wɑɑ-m, mpi tɔ, mɑ mʋwɑ tɑɑ sɑləɣɩ kɛ́.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pəlee kɛ́ nyɑ́ tɑɑ kɑ́ hɛɛsɩ-m kpɑnɑʋ?","poem":1},{"lineBreak":true},{"text":"Mɑ lɑŋlɛ wɑkəlɑɑ kɛ́ tətɔɣɔtɔɣɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hɑɩ, Tɑcɑɑ məlɩ nɑ ń yɑ-m.","poem":1},{"lineBreak":true},{"text":"Wɑɑsɩ-m nyɑ́ kʋpɑntʋ tɔɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pə tɑɣɑ pʋlʋ, sətʋ ɩɩ tɔɔsəɣɩ nyɑ́ tɔm.","poem":1},{"lineBreak":true},{"text":"Pə́cɔ nɔɣɔlʋ ɩɩ sɑŋɩ-ŋ ɑtɛtəlɛ tɑɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mɔlɑ kʋɣʋnɑ-m nɑ mɑ́ pələɣɩ ɩsəlʋm kɛ","poem":1},{"lineBreak":true},{"text":"mɑ kʋhəntʋɣʋ tɔɔ kɛ́ pɑɑ ɑhoo nnɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wulɑ mʋlʋsɑ mɑ ɩsɛ kɛ́ nɑ ɑɑ tɑsəɣɩ nɑʋ.","poem":1},{"lineBreak":true},{"text":"Mɑ kolontunɑɑ lɑpənɑ-m mpʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ɩsɑɣɑlɑtɑɑ mɛ, ɩ́ tɛɛ ɩ́ wɛsɩ-m.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, Tɑcɑɑ nɩɩ mɑ wulɑ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ɩ́ nɩɩ mɑ wiinɑʋ nɑ ɩ́ mʋ mɑ sələmʋɣʋ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pə́ liɣiti mɑ kolontunɑɑ tənɑ nɑ sɔɣɔntʋ kpɑɑ-wɛ,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ pəsəɣənɑ pɑ wɑɑlɩ kɛ kpɑkpɑɑ nɑ fɛɛlɛ nɑ pɑ́ seeki.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}