{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":61,"content":[{"type":"heading","content":["Mɑ sɔɔlɑ nyɑ́ təyɑɣɑ tɑɑ cɑɣɑlɛ kɛ tɑm tɔɔ"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu nti tə wɛ yonyoolɑɑ nyʋɣʋ tʋ",{"text":"yontunɑɑ tɑɑ nɑ pɑ́ yooki-tɩ nɑ sɑŋkʋ tɔɣɔlɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hɑɩ, Ɩsɔ nɩɩ mɑ wulɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ń ké ŋkpɑŋŋ nɑ mɑ kʋsələmʋtʋ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ye pə kɔmɑ nɑ mɑ́ kpisi,","poem":1},{"lineBreak":true},{"text":"pɑɑ mɑ wɛ tɛtʋ tənɑɣɑ,","poem":1},{"lineBreak":true},{"text":"ɩsɩɩ mɑ yɑɑ-ŋ sɩ ń wɑɑsɩ-m.","poem":1},{"lineBreak":true},{"text":"Ponɑ-m təcɔɔsəlɛ nte mɑ kɑɑ pəsɩ nɑ mɑ́ tɑlɑ tɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mpi tɔ, nyɑɣɑlɛ mɑ kentulu,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ koluŋɑ ɩcɑtɛ kɛ kolontu kiŋ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nyɑ́ tɛɣɛ mɑ cɑɑ cɑɣɑʋ kɛ tɑm tɔɔ,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ cɔɔsɩ nyɑ́ tɛɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mpi tɔ, hɑɩ, Ɩsɔ nyɑ́ nɩɩkənɑ mɑ koolee","poem":1},{"lineBreak":true},{"text":"nɑ ń hɑɑkɩ-m mpɑ pɑ nyɑŋnɑ-ŋ tɔ pɑ kpɑncoou.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kpɑɑsɩ wulɑʋ weesuɣu nɑ ɩsɔ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ pɩɩsɩ tɑɣɑlɩ nɑ pə́ polo lʋlʋŋ loosi loosi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɩ́ wɛɛ kɑwulɑɣɑ kumte tɔɔ kɛ́ tɑm tɔɔ,","poem":1},{"lineBreak":true},{"text":"nɑ nyɑ́ kʋpɑntʋ wɑɑsəɣɩ-ɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ɩlɛ mɑɑ pʋɣʋlɩ nyɑ́ hətɛ kɛ tɑm.","poem":1},{"lineBreak":true},{"text":"Nɑ mɑ́ lɑ́ ɩsɩɩ mɑɑ sɩɩʋ nɔɣɔ tɔɣɔ pɑɑ kʋyɑkʋ ŋku.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":9}