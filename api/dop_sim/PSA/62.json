{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":62,"content":[{"type":"heading","content":["Mɑɑ wɛɛ Ɩsɔ kɔŋkɔŋ tɑɑ təpɑmm"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu nti tə wɛ yonyoolɑɑ nyʋɣʋ tʋ",{"text":"yontunɑɑ tɑɑ ɩsɩɩ Yetutuŋ kɛɛsʋɣʋ tɔɣɔlɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ɩsɔ kɛ́ mɑ pɛtɑ mɑ tɩ.","poem":1},{"lineBreak":true},{"text":"Ɩnɩ ɩ kiŋ kɛ mɑ nyʋɣʋ yɑpʋ lɩɩkənɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɩnəɣəlɛ mɑ kʋkpɑmʋɣʋ nɑ mɑ́ tʋɣʋ-ɩ kpʋlʋɣʋ","poem":1},{"lineBreak":true},{"text":"mɑ nyʋɣʋ yɑpʋ ntɛ́, nɑ mɑ koluŋɑ ɩcɑtɛ.","poem":1},{"lineBreak":true},{"text":"Pʋlʋpʋ ɩɩ cɛŋləɣɩ-m ɩ kiŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Pəlee kɛ́ mə tənɑ ɩ́ kɑ́ yele kpɛntʋɣʋ","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ huliɣi yʋlʋ sɩ ɩ́ kʋɣʋ-ɩ?","poem":1},{"lineBreak":true},{"text":"Ɩsɩɩ koluŋɑ wɛɛlʋɣʋ tɔ,","poem":1},{"lineBreak":true},{"text":"yɑɑ kɑlɑɑ wei ɩ seliɣi tɔ?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɩ́ kpɛntɑ nɔɣɔ sɩ ɩ́ tusɩ-ɩ ɩ təcɑɣɑlɛ sɔsɔɔlɛ tɑɑ.","poem":1},{"lineBreak":true},{"text":"Pɔpɔtʋ wɛ-mɛɣɛ teu kɛ́,","poem":1},{"lineBreak":true},{"text":"mə nɔɔsɩ kɛ ɩ́ kooliɣinɑ kʋpɑntʋ","poem":1},{"lineBreak":true},{"text":"nɑ mə lotu tɑɑ nɑ mpusi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɩsɔ kiŋ tike kɛ mɑɑ pɛɛkɩ hɛɛsʋɣʋ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, ɩnɩ ɩ yekinɑ nɑ mɑ́ tɛɛləɣɩ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ɩnəɣəlɛ mɑ kʋkpɑmʋɣʋ nɑ mɑ́ tʋɣɩ-ɩ kpʋlʋɣʋ.","poem":1},{"lineBreak":true},{"text":"Mɑ nyʋɣʋ yɑpʋ ntɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ koluŋɑ ɩcɑtɛ.","poem":1},{"lineBreak":true},{"text":"Pʋlʋpʋ ɩɩ cɛŋləɣɩ-m ɩ kiŋ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɩsɔ yɑkənɑ mɑ nyʋɣʋ nɑ ɩ́ tʋɣʋ-m teeli.","poem":1},{"lineBreak":true},{"text":"Ɩnɩ ɩ kentiɣinɑ mɑ tɔɔ nɑ toŋ,","poem":1},{"lineBreak":true},{"text":"Ɩsɔ kɛlɛ mɑ kpʋlʋɣʋ tətʋlɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hɑɩ, yəlɑɑ mɛ, ɩ́ pɛtɩ-ɩ mə təɣɩ pɑɑ wɑɑtʋ wei,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ tʋlɩ-ɩ mə lotu,","poem":1},{"lineBreak":true},{"text":"Ɩsɔ kɛlɛ tɑ́ kpʋlʋɣʋ tətʋlɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tɑmpɑnɑ tɔɔ,","poem":1},{"lineBreak":true},{"text":"yəlɑɑ tɔm cɛkənɑʋ wɛ kɑtɛ kɛ́,","poem":1},{"lineBreak":true},{"text":"pɑ wɛ kɛ́ ɩsɩɩ ɩlɛɛməŋ.","poem":1},{"lineBreak":true},{"text":"Pɑ tənɑ pɑ fɛɩ yuŋ kɛ sɑnəyɑ tɔɔ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɩ tɑɑ hɑ mə təɣɩ mʋsʋŋ tɑɑ,","poem":1},{"lineBreak":true},{"text":"ɩ tɑɑ tɛɛlɩ wɛnɑʋ mpi pɑ lɛɛkənɑ tomɑ tɔ.","poem":1},{"lineBreak":true},{"text":"Pɑɑ wɛnɑʋ hukiɣi, ɩ tɑɑ cɛlɑ-wəɣɩ mə tɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ɩsɔ yɔɣɔtɑɑ nɑ ɩ́ lɛlɩ nɑ mɑ́ nɩɩ sɩ,","poem":1},{"lineBreak":true},{"text":"ɩnəɣəlɛ tomɑ tʋ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ nyɑ́ tike ntɛ́ kʋpɑŋ","poem":1},{"lineBreak":true},{"text":"nɑ ń fɛləɣɩ pɑɑ wei ɩsɩɩ ɩ lɑpɑ tɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":13}