{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":63,"content":[{"type":"heading","content":["Ɩsɔ kʋpɑntʋ kəlɑ weesuɣu kɛ teu"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu nti tə wɛ yonyoolɑɑ",{"text":"nyʋɣʋ tʋ yontunɑɑ tɑɑ tɔ.","poem":1},{"lineBreak":true},{"text":"Tə tɑɑ kɛ́ Tɑfiiti kɛɛsɑ ɩ cɑɣɑlɛ tɔm kɛ Yutɑ wulɑʋ tɛtʋ tɑɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hɑɩ, Ɩsɔ, nyɑɣɑlɛ mɑ Ɩsɔ,","poem":1},{"lineBreak":true},{"text":"mɑ pɛɛkəɣɩ-ŋ kɛ́,","poem":1},{"lineBreak":true},{"text":"mɑ ləsɑɣɑ nyɩɩləɣɩ-ŋ kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ tɛŋ tɑɑsɩ kɛ nyɑ́ tɔɔ kɛ́ wʋlɑɣɑ","poem":1},{"lineBreak":true},{"text":"tɛtʋ nti tə tɑɑ lʋm fɛɩ tɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nyɑ́ təyɑɣɑ tɑɑ kɛ́ mɑ nyənɑ-ŋ teu","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ nɑ́ nyɑ́ toŋ nɑ nyɑ́ teeli.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mpi tɔ, nyɑ́ kʋpɑntʋ kəlɑ weesuɣu kɛ teu.","poem":1},{"lineBreak":true},{"text":"Mɑɑ kpɑɑlɩ nyɑ́ sɑmtʋ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nyɑɣɑ mɑɑ sɛɛ mɑ weesuɣu tənɑ,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ sələməɣənɑ nyɑ́ hətɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mɑɑ hɑɣɑ kɛ́ ɩsɩɩ mɑ tɔɣɔ nim tɔɣɔnɑɣɑ kʋpɑŋkɑ.","poem":1},{"lineBreak":true},{"text":"Ɩlɛnɑ mɑ́ yoo-ŋ yontu nɑ lɑŋhʋlʋmlɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ye mɑ həntɑɑ, mɑ tɔɔsəɣɩ nyɑ́ tɔm kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ mɑɣɑsəɣɩ-təɣɩ mɑ tɑɑ kɛ́ ɑhoo tənɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nyɑɣɑlɛ mɑ wɑɑsʋlʋ, mɑ lɑŋlɛ hɛɛnɑ","poem":1},{"lineBreak":true},{"text":"nyɑ́ keŋ ɩsotom tɑɑ cɑɣɑlɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mɑ tɑmsənɑ-ŋ kɛ́ nɑ luɣu kʋlʋmʋɣʋ,","poem":1},{"lineBreak":true},{"text":"nyɑ́ toŋ wɑɑsəɣənɑ-m.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mpɑ pɑ lʋkɩ mɑ weesuɣu ləsʋɣʋ tɔ,","poem":1},{"lineBreak":true},{"text":"pə́ wɑkəlɩ-wɛɣɛ lɔŋ nɑ pə́ sʋsɩ-wɛɣɛ tɛtʋ lumɑŋ tɑɑ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pə́ kʋ-wɛɣɛ ɩsɑɣɑkʋɣʋ nɑ pə́ wɑɑsɩ tɑɑlɛ hɑsɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ɩlɛnɑ wulɑʋ nɑ́ɑ́ yɔɔləɣənɑ Ɩsɔ.","poem":1},{"lineBreak":true},{"text":"Wei ɩ kɑ tuunɑ Ɩsɔ hətɛ tɔ pʋntʋ kɑ́ sɑmɩ-ɩ kɛ́.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, pɩɩ təkɩ pɔpɔtʋnɑɑ nɔɔsɩ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":12}