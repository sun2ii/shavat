heeliɣi-wɛ nɑ pə́cɔ pɑ́ tɔ-wɛ,","poem":1},{"lineBreak":true},{"text":"pə́cɔ sɔɣɔntʋ fɛɩ-wɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pɑ kɑɑsəɣɩ pɑ təɣɩ pɑ ɩsɑɣɑtʋ təmlɛ tɑɑ kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ mɑɣɑsəɣɩ ɩsənɑ pɑɑ nyɩ pɑ kɑtɔsɩ tɔ,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ tɔŋ sɩ nɔɣɔlʋ kɑɑ nɑ-sɩ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ɩsɑɣɑtʋ kɛ pɑ mɑɣɑsəɣɩ.","poem":1},{"lineBreak":true},{"text":"Nɑ pɑ́ tɔŋ sɩ tɑ́ sɔɔlʋ pɩɩwɑ.","poem":1},{"lineBreak":true},{"text":"Tə tʋwɑ mpi tɩɩ lɑ tɔ pə pəlɛ.","poem":1},{"lineBreak":true},{"text":"Yʋlʋ lotu wɛ lumɑŋ kɛ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ɩlɛnɑ Ɩsɔ nɑ́ɑ́ tɔ-wɛɣɛ nyəmɑ́,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ yɑɣɑ-wɛɣɛ kpɑkpɑɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pɑ kʋyɔɣɔtʋtʋ hunɑ-wɛ,","poem":1},{"lineBreak":true},{"text":"pɑ tənɑ mpɑ pɑ nɑɑkɩ-wɛ tɔ","poem":1},{"lineBreak":true},{"text":"pɑ kpɛɛtəɣɩ nyɔɔŋ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sɔɣɔntʋ kpɑ yəlɑɑ tənɑ","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ kpɑɑləɣɩ mpi Ɩsɔ lɑkɩ tɔ,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ cɛkəɣənɑ ɩ kʋlɑpəlɛ hʋwɛɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Siɣisilu ɩ́ yɔɔlənɑ Tɑcɑɑ nɑ ɩ́ tʋɣɩ-ɩ kpʋlʋɣʋ.","poem":1},{"lineBreak":true},{"text":"Pɑ tənɑ mpɑ pɑ təŋəɣɩ tɑmpɑnɑ tɔ pɑ́ sɑ pɑ tɩ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":11}