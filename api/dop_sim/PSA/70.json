{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":70,"content":[{"type":"heading","content":["Tɑcɑɑ kɔɔ lɔŋ"]},{"type":"verse","number":1,"content":["Tɑfiiti yontu nti tə wɛ yonyoolɑɑ",{"text":"nyʋɣʋ tʋ yontunɑɑ tɑɑ nɑ pɑ́ tɔɔsəɣənɑ Ɩsɔ tɔɔ tɔɣɔlɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hɑɩ, Ɩsɔ, kɔɔ nɑ ń hɛtɩ-m.","poem":1},{"lineBreak":true},{"text":"Tɑcɑɑ kɔɔ lɔŋ nɑ ń wɑɑsɩ-m.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mpɑ pɑ cɑɑ mɑ səm tɔ fɛɛlɛ ɩ́ pɩɩ-wɛ nɑ pə́ liɣiti-wɛ.","poem":1},{"lineBreak":true},{"text":"Mpɑ ɩnɩ pɑ lɑŋlɛ hɛɛnɑ mɑ kʋnyɔŋ tɔ","poem":1},{"lineBreak":true},{"text":"pɑ́ kɑ nyɔɔŋ nɑ pɑ́ məŋnɑ wɑɑlɩ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mpɑ pɑ lɑkɑɣɑ-m ɑnyɑŋkɑ tɔ","poem":1},{"lineBreak":true},{"text":"fɛɛlɛ ɩ́ pɩɩ-wɛ nɑ pɑ́ se.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mpɑ pɛlɛ pɑ pɛɛkəɣɩ Ɩsɔ nyɑ́ tɔ,","poem":1},{"lineBreak":true},{"text":"pə́ cɑɣɑnɑ-wɛ nɑ pɑ lɑŋɑ hʋlʋmɩ.","poem":1},{"lineBreak":true},{"text":"Nɑ mpɑ pɛlɛ pɑ sɔɔlɑ nyɑ́ nyʋɣʋ yɑpʋ tɔ,","poem":1},{"lineBreak":true},{"text":"pɑ yɔɣɔtəɣɩ tɑm sɩ Tɑcɑɑ kɛlɛ sɔsɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mɑ kɛ́ kʋnyɔntʋ kɛ́ nɑ mɑ́ wɛ ɑtɛ.","poem":1},{"lineBreak":true},{"text":"Hɑɩ, mɑ Ɩsɔ, kɔɔ mɑ wɑɑsʋɣʋ kɛ lɔŋ.","poem":1},{"lineBreak":true},{"text":"Nyɑɣɑlɛ mɑ wɑɑsʋlʋ nɑ mɑ hɛtʋlʋ.","poem":1},{"lineBreak":true},{"text":"Tɑcɑɑ tɑɑ leeli.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":6}