{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":76,"content":[{"type":"heading","content":["Ɩsɔ wɑkələɣɩ yoou kɛ Siyɔŋ tɑɑ"]},{"type":"verse","number":1,"content":["Asɑfɩ yontu nti pɑ yookinɑ cəmʋɣʋ",{"text":"nɑ tə́ wɛ yonyoolɑɑ nyʋɣʋ tʋ yontunɑɑ tɑɑ tɔɣɔlɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ɩsɔ hʋlɑ ɩ təɣɩ Yutɑ,","poem":1},{"lineBreak":true},{"text":"ɩ hətɛ yɑɑ Ɩsɛɣɛlɩ tɑɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɩ cokəle wɛ Sɑlɛm kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ təcɑɣɑlɛ kɛ Siyɔŋ tɑɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tənɑɣɑ ɩ pɛlɑ yoou wontu:","poem":1},{"lineBreak":true},{"text":"Ɩsɩɩ nyəmɑ́ nɑ kpɑləŋ nɑ lɑɣɑlɛɛ nɑ wontu lɛntɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Hɑɩ, Ɩsɔ, sɔsɔɔntʋ ntɛ́ yɑɑ?","poem":1},{"lineBreak":true},{"text":"N kəlɑ tɑm tɔɔ pɔɔŋ tənɑ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yoolɑɑ tɑɑ yoolɑɑ mpɛ pə cɑɑmɑ-wɛɣɛ,","poem":1},{"lineBreak":true},{"text":"pɑ toowɑ tom kɑntəkɑɣɑ nyəm,","poem":1},{"lineBreak":true},{"text":"pɑ tɑ pəsɩ nɑ pɑ́ yoo nɑ pɑ́ fiti.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yɑkɔpʋ Ɩsɔ, wɑɑtʋ wei n nyɑɑsɑ-wɛ tɔ,","poem":1},{"lineBreak":true},{"text":"pə yeɣetɑ pɑ kpɑɣɑnəŋ nɑ ɩ cɑɣɑlɑɑ kɛ́.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hɑɩ, n kɛ́ sɔsɔ kɛ́,","poem":1},{"lineBreak":true},{"text":"n mʋɣɩ pɑ́ɑ́nɑ́ nɑ ɑwe kpətənɑ-ŋ?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hɑtoo ɩsɔtɑɑ kɛ́ n yɔɣɔtɑ nyɑ́ hʋʋlɛ tɔm,","poem":1},{"lineBreak":true},{"text":"nɑ sɔɣɔntʋ kpɑ tɛtʋ nɑ tə́ cɑɣɑ təpɑmm.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wɑɑtʋ ɩnəɣɩ n kʋlɑɑ sɩ n hʋʋkənɑ","poem":1},{"lineBreak":true},{"text":"nɑ ń wɑɑsɩ ɑtɛ kʋnyɔntɔɣɔlɑɑ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ye nyɑ́ tɑɑ huuwɑ,","poem":1},{"lineBreak":true},{"text":"yʋlʋ tʋɣʋ-ŋ teeli kɛ́,","poem":1},{"lineBreak":true},{"text":"pɑɑ ɩ wɛ pɑ́ɑ́nɑ́ sɔsɔɔnɑ tɑɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ɩ́ sɩɩ mə Ɩsɔ Tɑcɑɑ kɛ nɔɔsɩ nɑ ɩ́ lɑ́-sɩ.","poem":1},{"lineBreak":true},{"text":"Mpɑ pɑ cɔɔnɑ Ɩsɔ Sɔsɔ ɩnɩ tɔ,","poem":1},{"lineBreak":true},{"text":"pɑ́ kɔnɑ-ɩ kʋcɔɔŋ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ɩsɔ ləsəɣɩ ɑwulumpiyɑ kɑlɑmpɑɑnɩ kɛ́","poem":1},{"lineBreak":true},{"text":"ɩlɛnɑ pə́ tisi-wɛ təfɛ.","poem":1},{"lineBreak":true},{"text":"Atɛ ɑwulɑɑ seliɣinɑ-ɩ kɛ́.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":13}