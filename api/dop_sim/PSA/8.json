n sɩɩ sɩ lonɑ tɑɑ tɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɩlɛ mɑ pɔɔsəɣɩ mɑ tɩ sɩ:","poem":1},{"lineBreak":true},{"text":"Yʋlʋ kɛ́ we nɑ ń tɔɔsəɣɩ ɩ tɔm?","poem":1},{"lineBreak":true},{"text":"Yɑɑ yʋlʋ pəyɑɣɑ tɩɩ kɛ́ we nɑ ń pɑɑsəɣənɑ-kɛ?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N lɑpɑ-ɩ kɛ́ nɑ ɩ́ sɛkɩ-ŋ pəcɔ,","poem":1},{"lineBreak":true},{"text":"nɑ ń tʋ-ɩ teeli nɑ ń kʋsɩ ɩ nyʋɣʋ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nyɑ́ tʋnɑ-ɩ sɩ ɩ́ ŋmɑkəlɩ wontu nti n lɑpənɑ nyɑ́ niŋ tɔ","poem":1},{"lineBreak":true},{"text":"nɑ ń tʋ pə tənɑɣɑ ɩ nɔɔhɛɛ tɛɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pə kpɑɣɑʋ nɑɑŋ nɑ heeŋ nɑ pə́ŋ","poem":1},{"lineBreak":true},{"text":"nɑ pə kpɛŋnɑ tɑɑlɛ wontu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nɑ sumɑsɩ nɑ tiinɑ","poem":1},{"lineBreak":true},{"text":"nɑ teŋku tɑɑ nyəm tənɑ tɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Hɑɩ, Ɩsɔ Tɑcɑɑ,","poem":1},{"lineBreak":true},{"text":"nyɑ́ hətɛ yɑɑwɑ tɛtʋ tənɑ tɑɑ kɛ́.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":10}