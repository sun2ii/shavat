"type":"verse","number":5,"content":[{"text":"Amɑ ɩ́ tɑ nyɩ pʋlʋ,","poem":1},{"lineBreak":true},{"text":"pəyele ɩɩ cɛkəɣənɑ pʋlʋ,","poem":1},{"lineBreak":true},{"text":"səkpɛtʋɣʋ tɑɑ kɛ́ ɩ́ tɔŋ.","poem":1},{"lineBreak":true},{"text":"Ɩlɛnɑ tɛtʋ kilɑ tənɑ seliɣi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mɑɑ tɔmɑɣɑ sɩ ɩ́ kɛ́ Ɩsɔ Sɔsɔ lʋlʋɣʋ nyə́mɑ.","poem":1},{"lineBreak":true},{"text":"Hɑlɩ ɩ tɩɩ kɛ́ ɩsɔnɑɑ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pɑɑ nɑ mpʋ tɔ,","poem":1},{"lineBreak":true},{"text":"ɩ́ kɑ́ sɩ kɛ́ ɩsɩɩ yəlɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ hoti ɩsɩɩ pɑɑ ɑwulumpu wei.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Hɑɩ, Ɩsɔ kʋlɩ nɑ ń hʋʋnɑ ɑntulinyɑ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, n kɛ́ piitimnɑɑ tənɑ tʋ kɛ́.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}