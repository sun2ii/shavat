,{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nyɑ́ tɑɑ kɑ́ kpɑnɑ-tʋɣʋ tɑm tɔɔ","poem":1},{"lineBreak":true},{"text":"nɑ ń tɔkɩ-tʋ nɑ nyɑ́ tɑɑ nɑ pə́ polo","poem":1},{"lineBreak":true},{"text":"lʋlʋŋ loosi loosi nɑ?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N kɑɑ hɑ-tʋɣʋ weesuɣu","poem":1},{"lineBreak":true},{"text":"nɑ tə́ yɔɔlənɑ-ŋ?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ yele nɑ tə́ nɑ́ nyɑ́ kʋpɑntʋ","poem":1},{"lineBreak":true},{"text":"nɑ ń yɑ́ tɑ́ nyʋɣʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ɩsɔ Tɑcɑɑ kʋyɔɣɔtʋtʋ kɛ mɑ nɩɩkɩ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, hɛɛsʋɣʋ tɔm kɛ n yɔɣɔtəɣənɑ nyɑ́ yəlɑɑ","poem":1},{"lineBreak":true},{"text":"nɑ mpɑ pɑ nɩɩkənɑ-ŋ tɔ sɩ pɑ tɑɑ məlɩ kʋmɛlɛntʋ tɑɑ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nyɑ́ nyʋɣʋ yɑpʋ kpətənɑ mpɑ pɑ nyɑŋnɑ-ŋ tɔɣɔ","poem":1},{"lineBreak":true},{"text":"ɩlɛnɑ pə kɔnɑ nyɑ́ teeli kɛ tɑ́ tɛtʋ tɑɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kʋpɑntʋ nɑ tɑmpɑnɑ təŋʋɣʋ pə sulɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ hɛɛsʋɣʋ nɑ siɣisuɣu pə́ wɑɣɑlɩ təmɑ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tɑmpɑnɑ təŋʋɣʋ lɩɩkənɑ tɛtʋ tɛɛ kɛ́,","poem":1},{"lineBreak":true},{"text":"ɩlɛnɑ siɣisuɣu nɑ́ɑ́ lɩɩnɑ ɩsɔtɑɑ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ mɑɣɑmɑɣɑ kɑ́ kɔnɑ kʋpɑntʋ","poem":1},{"lineBreak":true},{"text":"nɑ tɑ́ tɛtʋ nɑ́ɑ́ lʋlɩ tə kʋlʋlʋm.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tɑmpɑnɑ təŋʋɣʋ wɛ nyɑ́ nɔɣɔ tɔɔ kɛ́","poem":1},{"lineBreak":true},{"text":"nɑ ɑ́ hɛɛkɩ-ŋ ɩkpɑtɛ kɛ mpɑɑʋ tɑɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/86.json","nextChapterAudioL