","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Amɑ ye Siyɔŋ ɩcɑtɛ ɩlɛ tə tɑɑ kɛ́","poem":1},{"lineBreak":true},{"text":"pə lʋlɑ yəlɑɑ tənɑ.","poem":1},{"lineBreak":true},{"text":"Ɩsɔtɑɑ Ɩsɔ Sɔsɔ yɔɣɔtənɑ-tɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tɑcɑɑ kɑləɣɩ yəlɑɑ nɑ ɩ ŋmɑɑkɩ sɩ:","poem":1},{"lineBreak":true},{"text":"Siyɔŋ kɛlɛ pɑɑ wei ɩ ɩcɑtɛ mɑɣɑmɑɣɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hɑɩ, Ɩsɔ ɩcɑtɛ nyɑ́, yonyoolɑɑ nɑ pɑɑlɑɑ","poem":1},{"lineBreak":true},{"text":"pɑ kpɛntənɑ nɑ pɑ yɔɣɔtəɣɩ nyɑ́ teu tɔm.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}