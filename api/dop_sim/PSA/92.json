{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":92,"content":[{"type":"heading","content":["Tɑcɑɑ, pɑ sɑŋɩ-ŋ tɔ pɑ lɑkɩ teu kɛ́"]},{"type":"verse","number":1,"content":["Kʋyɑkʋ kʋhɛɛsʋɣʋ wule yontu."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Pə wɛ teu kɛ́ sɩ tə́ sɑ Tɑcɑɑ nyɑ́,","poem":1},{"lineBreak":true},{"text":"nɑ tə́ yoo yontu kɛ ɩsɔtɑɑ","poem":1},{"lineBreak":true},{"text":"Ɩsɔ sɔsɔ nyɑ́ nyɑ́ hətɛ tɑɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nɑ tə́ kpɑɑlɩ nyɑ́ kʋpɑntʋ kɛ tɑnɑŋ tɛɛ,","poem":1},{"lineBreak":true},{"text":"nɑ nyɑ́ teu tɔm kɛ ɑhoo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tə́ sɑ-ŋ nɑ ŋmɩɩsɩ","poem":1},{"lineBreak":true},{"text":"nɑɑnʋwɑ cəməŋ nɑ sɑŋkʋnɑɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Hɑɩ, Tɑcɑɑ, nyɑ́ kʋlɑpəm hɛɛsəɣɩ mɑ lɑŋlɛ kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ yooki nyɑ́ niŋ təmɑ tɔm kɛ yontu nɑ lɑŋhʋlʋmlɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hɑɩ, Tɑcɑɑ, nyɑ́ təmɑ kɛ́ sɔsɔɔnɑ kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ nyɑ́ ləmɑɣɑsɛɛ kɛ́ yuŋ nyənɑ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kʋmɛlɛŋ ɩɩ cɛkəɣənɑ təlɛ,","poem":1},{"lineBreak":true},{"text":"pəyele ləmɑɣɑsɛɛ fɛɩ tʋ nɑɑ pɑɑsəɣənɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asɑɣɑɑ hukiɣi kɛ́ ɩsɩɩ nyɩɩtʋ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩsɑɣɑtʋ lɑtɑɑ nɑ́ɑ́ pɩɩkɩ.","poem":1},{"lineBreak":true},{"text":"Amɑ wɑkəlʋɣʋ tɑm tɔɔ nyəŋkʋ tɑŋnɑ-wɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hɑɩ, Tɑcɑɑ, nyɑ́ kɛ́ ɩsɔtɑɑ","poem":1},{"lineBreak":true},{"text":"Ɩsɔ sɔsɔ kɛ tɑm tɔɔ kɛ́.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ye pə kɑɑsɑ nyɑ́ kolontunɑɑ, pɛlɛ pɑɑ le kɛ́.","poem":1},{"lineBreak":true},{"text":"Pɑ tənɑ mpɑ pɑ lɑkɩ ɩsɑɣɑtʋ tɔ pɑɑ yɑ yem.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tɑɑlɛ nɑʋ tomɑ kɛ n hɑ-m,","poem":1},{"lineBreak":true},{"text":"nɑ ń pəlɩ mɑ tɔɔ kɛ́ nikɑɣɑ nim.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mɑ nɑɑkɩ mɑ kolontunɑɑ kpisuɣu,","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ nɩɩkɩ ɑsɑɣɑɑ mpɑ pɑ cɑɑkɩ-m","poem":1},{"lineBreak":true},{"text":"tɔm tɔ pɑ kiisuɣu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tɑmpɑnɑ təŋlɑɑ pɩɩkɩ kɛ́ ɩsɩɩ pɑɑŋ,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ kʋləɣɩ ɩsɩɩ Lipɑŋ tɩɩŋ sɔsɔɔŋ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Pɑ wɛ kɛ́ ɩsɩɩ tʋɣʋ ŋku pɑ tuu","poem":1},{"lineBreak":true},{"text":"Ɩsɔ təsɛɛlɛ kɑtɑɣɑ tɑɑ tɔ,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ pɩɩkɩ teu kɛ tɑ́ Ɩsɔ Tɑcɑɑ tɛ́.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Pɑɑ kpɑtəlɑɣɑ wɑɑtʋ,","poem":1},{"lineBreak":true},{"text":"pɑ tɔŋɑ lʋlʋɣʋ kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ wɛ təlɛkʋlɛkʋ kɛ teu nɑ ɑlɑɑfəyɑ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mpʋ pə hʋlə́ɣə́nɑ́ təkelekele sɩ Tɑcɑɑ siɣisɑɑ.","poem":1},{"lineBreak":true},{"text":"Ɩ tɑ kɛɛ tiili, ɩnəɣəlɛ mɑ kʋkpɑmʋɣʋ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":16}