{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":94,"content":[{"type":"heading","content":["Ɩsɔ kɛ́ kɑwɑlɑɣɑ nyə́mɑ lɛɛtʋlʋ"]},{"type":"verse","number":1,"content":["Hɑɩ, Ɩsɔ nyɑɣɑlɛ lɛɛtʋlʋ.",{"text":"Lɛɛtʋlʋ Ɩsɔ, hʋlɩ nyɑ́ tɩ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Antulinyɑ hʋʋlʋ nyɑ́, kʋlɩ","poem":1},{"lineBreak":true},{"text":"nɑ ń lɛɛtɩ kɑlɑmpɑɑnɩ nyə́mɑ kɛ pɑ kʋlɑpʋtʋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hɑɩ, Tɑcɑɑ, ɑsɑɣɑɑ mpɛ pɑɑ wɛɛ mpʋɣʋlɛ?","poem":1},{"lineBreak":true},{"text":"Mpɛ pɑɑ wɛɛkənɑ ntɛɣɛ ɑkɑnɑɑ kɛ mpʋ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pɑ yɔɣɔtəɣɩ tɔm kɛ́ nɑ kɑlɑmpɑɑnɩ","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ pɛɛkəɣɩ lɛlɑɑ wɑkəlʋɣʋ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ, pɑ ŋmɑkələɣɩ nyɑ́ yəlɑɑ kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ muɣuliɣi mpɑ pɑ kɛ́ nyɑ́ nyə́mɑ tɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pɑ lɛntəɣɩ mʋsʋŋ kɛ leelɑɑ nɑ mʋʋlɑɑ","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ kʋɣɩ suluwɑɑ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nɑ pɑ́ tɔŋ sɩ Tɑcɑɑ ɩɩ nɑɑkɩ,","poem":1},{"lineBreak":true},{"text":"Yɑkɔpʋ Ɩsɔ ɩɩ pɑɑsəɣənɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kʋmɛlɛməŋ mɛ ɩ́ lɑ lɑɑkɑlɩ,","poem":1},{"lineBreak":true},{"text":"ləmɑɣɑsɛɛ fɛɩnɑɑ mɛ,","poem":1},{"lineBreak":true},{"text":"pəlee kɛ́ ɩ́ kɑ́ hii lɑɣɑtʋ?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ wei ɩ tʋ yəlɑɑ kɛ ŋkpɑŋŋ tɔ, ɩ nɩɩkɩ kɛ́.","poem":1},{"lineBreak":true},{"text":"Ɩsənɑɣɑ ɩ kɑ́ tʋ ɩsəlɛ nɑ ɩɩ nɑɑkɩ?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ɩsənɑɣɑ ɩ nɑɑsəɣɩ piitimnɑɑ","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ kɑɑ hɔ ɑsɑɣɑɑ ŋkpɑŋŋ?","poem":1},{"lineBreak":true},{"text":"Ɩnɩ ɩ sɛɣɛsəɣənɑ yəlɑɑ,","poem":1},{"lineBreak":true},{"text":"ɩlɛ ɩsənɑɣɑ ɩ kɑ́ lɑŋ nyəm?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ nyəmɑ́ yʋlʋ hʋwɛɛ kɛ","poem":1},{"lineBreak":true},{"text":"teu sɩ ɑ wɛ kpɛtɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Hɑɩ, Tɑcɑɑ, nyʋleleŋ tʋ ntɛ́ wei n sɛɣɛsəɣɩ","poem":1},{"lineBreak":true},{"text":"nyɑ́ kiiu nɑ ń hɔŋ ɩ ŋkpɑŋʋɣʋ tɔ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ɩ kɑ́ cɑɣɑ təpɑmm kɛ kʋyɛɛŋ ɩsɑɣɑŋ tɑɑ,","poem":1},{"lineBreak":true},{"text":"hɑlənɑ pɑ́ huli ɑsɑɣɑɑ pɔɔŋ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Pə tɑɣɑ pʋlʋ, Tɑcɑɑ ɩɩ lɔɔkɩ ɩ yəlɑɑ.","poem":1},{"lineBreak":true},{"text":"Ɩ kɑɑ yele mpɑ pɑ kɛ́ ɩ nyə́mɑ tɔ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mpi tɔ, pɑɑ hʋʋnɑ kɛ́ nɑ pə́ kɛɛsənɑ tɑmpɑnɑ təŋʋɣʋ.","poem":1},{"lineBreak":true},{"text":"Pɑ tənɑ mpɑ pɑ təŋəɣɩ tɑmpɑnɑ tɔ pɑ lɑŋɑ kɑ hɛɛnɑ-tɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Awe kɑ́ sɛɛnɑ mɑ tɔɔ kɛ́ ɑsɑɣɑɑ mpɛ pɑ tɔm tɑɑ?","poem":1},{"lineBreak":true},{"text":"Awe kɑ́ sənɑ-m mpɑ pɑ lɑkɩ ɩsɑɣɑtʋ tɔ pɑ tɔm tɑɑ?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ye Tɑcɑɑ tɑɑ wɑɑsɩ-m,","poem":1},{"lineBreak":true},{"text":"ɩsəntɔ mɑɑ tɛmɑ wɛɛʋ kɛ","poem":1},{"lineBreak":true},{"text":"timpi pə sumɑ tətiɣitiɣi tɔ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Pɑɑ wɑɑtʋ wei kɛ mɑ tɔmɑ sɩ mɑ cɑɑ hotuɣu,","poem":1},{"lineBreak":true},{"text":"Tɑcɑɑ nyɑ́ kʋpɑntʋ teŋi-m kɛ́.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Sɑɑ wei nəɣəsɛɛ pɩɩ mɑ lotu tɔ,","poem":1},{"lineBreak":true},{"text":"nyɑ́ hɛɛsənɑ mɑ lɑŋlɛ nɑ ń hʋləsɩ-tɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nyɑnɑ hʋʋlɑɑ ɑsɑɣɑɑ mpɑ pɑ wɑkələɣɩ kiiŋ","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ kɔŋnɑ wɑhɑlɑ tɔ ɩ́ kɑɑwɑɣɑ?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Siɣisilɑɑ kɛ pɑ wɑkələɣɩ","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ kʋɣɩ mpɑ pɑ tɑ lɑ pʋlʋ tɔ pɑ tɔm.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Amɑ Tɑcɑɑ kɛlɛ kʋkpɑmʋɣʋ","poem":1},{"lineBreak":true},{"text":"ŋku mɑ cɔɔsəɣənɑ tɔ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Pɑ mɑɣɑmɑɣɑ pɑ ɩsɑɣɑtʋ kɛ ɩ kɑ́ məŋnɑ pɑ nyɔɔŋ tɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ wɑkəlɩ-wɛ nɑ kʋlʋmtʋ ntɩ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}