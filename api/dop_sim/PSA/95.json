{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":95,"content":[{"type":"heading","content":["Ɩsɔ cɔlɔ pote wɑɑtʋ"]},{"type":"verse","number":1,"content":["Ɩ́ kɔɔ nɑ tə́ yoo Tɑcɑɑ kɛ lɑŋhʋlʋmlɛ yontu,",{"text":"tə́ sɑ tɑ́ wɑɑsʋlʋ wei tə tʋɣɩ kpʋlʋɣʋ tɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tə́ polo ɩ ɩsɛntɑɑ nɑ tə́ sɛɛ-ɩ,","poem":1},{"lineBreak":true},{"text":"nɑ tə́ wiliti-ɩ nɑ lɑŋhʋlʋmlɛ yontu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mpi tɔ, Tɑcɑɑ nyɑɣɑlɛ Ɩsɔ sɔsɔ.","poem":1},{"lineBreak":true},{"text":"Nyɑɣɑlɛ wulɑʋ sɔsɔ wei ɩ ŋmɑkələɣɩ tɩɩŋ tənɑ tɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nyɑ́ niŋ tɑɑ kɛ́ ɑtɛ lumɑŋ tənɑ wɛɛ","poem":1},{"lineBreak":true},{"text":"nɑ pɔɔŋ sɔsɔɔŋ tənɑ kɛ nyɑ́ nyəm.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nyɑ́ tənnɑ teŋku,","poem":1},{"lineBreak":true},{"text":"hɑlɩ nyɑ́ tɩɩ lɑpənɑ-ɩ.","poem":1},{"lineBreak":true},{"text":"Kʋlʋm nyɑ́ n lɑpənɑ tɛtʋ nɑ nyɑ́ niŋ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɩ́ kɔɔ nɑ tə́ luŋ tɑ́ ŋmɑlʋ Tɑcɑɑ kɛ ɑkulɑ,","poem":1},{"lineBreak":true},{"text":"nɑ tə́ həntɩ-ɩ ɑtɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pə tɑɣɑ pʋlʋ, nyɑɣɑlɛ tɑ́ Ɩsɔ.","poem":1},{"lineBreak":true},{"text":"Tɑɣɑlɛ nyɑ́ yəlɑɑ, nyɑɣɑlɛ tiikilu.","poem":1},{"lineBreak":true},{"text":"Tə wɛ kɛ́ ɩsɩɩ nyɑ́ niŋ kɑləkʋ.","poem":1},{"lineBreak":true},{"text":"Ye ɩ́ nɩɩ Ɩsɔ mɑ́ mɑ kʋyɔɣɔtʋtʋ kɛ sɑŋɑ,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ɩ́ tɑɑ lɑ lɑŋkpɩɩsəŋ ɩsɩɩ mə cɑɑnɑɑ kɑ lɑpʋ","poem":1},{"lineBreak":true},{"text":"Melipɑ nɑ Mɑsɑ kɛ wʋlɑɣɑ tɛtʋ tɑɑ tɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tənɑɣɑ mə cɑɑnɑɑ mɑɣɑsɑ-m sɩ pɑ nɑɑkɩ mɑ wɑɑlɩ,","poem":1},{"lineBreak":true},{"text":"pɑɑ nɑ pɑ nɑnɑ pɑ ɩsəpəle kɛ mpi mɑ lɑpɑ tɔ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pɩɩsɩ nɩɩlɛ təcu kɛ́ mɑ luɣu lɩɩ piitim pənɛ,","poem":1},{"lineBreak":true},{"text":"hɑlənɑ mɑ tʋ mɑ tɑɑ sɩ yəlɑɑ mpɛ pɑ lepɑɣɑ,","poem":1},{"lineBreak":true},{"text":"pɑɑ nyəŋ mɑ mpɑɑŋ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ḿpʋɣʋ pɑ́ɑ́nɑ́ kpɑ-m nɑ mɑ́ tuu sɩ:","poem":1},{"lineBreak":true},{"text":"Pɑ kɑɑ sʋʋ mɑ hɛɛsʋɣʋ tɑɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}