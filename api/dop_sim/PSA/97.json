{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":97,"content":[{"type":"heading","content":["Tɑcɑɑ kɛlɛ wulɑʋ, lɑŋhʋlʋmlɛ ɩ́ wɛɛ tɛtʋ tənɑ tɑɑ"]},{"type":"verse","number":1,"content":["Tɑcɑɑ tɔkɩ kɑwulɑɣɑ, tɛtʋ tənɑ ɩ́ yɔɔlɩ.",{"text":"Tɛtʋnɑɑ mpɑ lʋm tɑmɑ kotɑɣɑ tɔ pɑ pɑɣɑlɛ ɩ́ yɔɔlɩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ɩsɔŋmʋntʋɣʋ nɑ səkpɛtʋɣʋ tɑmɑ-ɩ kotɑɣɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ kumte nɑ́ɑ́ cɑɣɑ siɣisuɣu nɑ tɑmpɑnɑ təŋʋɣʋ tɔɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kɔkɔ wɛ ɩ nɔɣɔ tɔɔ kɛ́","poem":1},{"lineBreak":true},{"text":"nɑ kɑ́ nyɑkɩ ɩ kolontunɑɑ nɑ kɑ́ cɔɔkənɑ-ɩ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɩ ŋmɛləsəɣɩ nyɑɑləm nɑ pə́ nɑɑkɩ ɑntulinyɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ɑtɛ yəlɑɑ nɑɑkɩ nɑ pɑ́ seliɣi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tɛtʋ tənɑ tʋ ɩ́ kpətənɑ pɔɔŋ,","poem":1},{"lineBreak":true},{"text":"ɩ hooki kɛ́ ɩsɩɩ keetu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɩsɔtɔnʋɣʋ kpɑɑləɣɩ ɩ tɑmpɑnɑ","poem":1},{"lineBreak":true},{"text":"nɑ yəlɑɑ tənɑ nɑɑkɩ ɩ teu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tɩɩŋ luŋlɑɑ nɑ mpɑ pɑ hʋləsəɣɩ tɩɩŋ","poem":1},{"lineBreak":true},{"text":"nɑ lɑŋlɛ tɔ, pɑ tɔkɩ fɛɛlɛ kɛ́.","poem":1},{"lineBreak":true},{"text":"Tɩɩŋ tənɑ həntəɣɩ Ɩsɔ kɛ́ ɑtɛɣɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Siyɔŋ ɩcɑtɛ nyə́mɑ nɩɩ-tɩ nɑ pɑ lɑŋɑ hʋlʋmɩ,","poem":1},{"lineBreak":true},{"text":"nɑ Yutɑ ɑcɑlɛɛ nɑ́ɑ́ wɛ ɑyɔɔlɛɛ tɑɑ","poem":1},{"lineBreak":true},{"text":"kɛ nyɑ́ hʋʋlɛ tɔɔ, hɑɩ, Tɑcɑɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mpi tɔ, Tɑcɑɑ nyɑɣɑlɛ ɩsɔtɑɑ Ɩsɔ sɔsɔ kɛ tɛtʋ tənɑ tɑɑ.","poem":1},{"lineBreak":true},{"text":"N kəlɑ tɩɩŋ tənɑɣɑ sɔsɔɔntʋ kɛ təcɑɣɑcɑɣɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mpɑ mɛ ɩ́ sɔɔlɑ Tɑcɑɑ tɔ,","poem":1},{"lineBreak":true},{"text":"mə tɑɑ ɩ́ kpɑnɑ ɩsɑɣɑtʋ.","poem":1},{"lineBreak":true},{"text":"Ɩsɔ kentiɣi ɩ kʋpɑmɑ tɔɔ kɛ́,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ yɑkɩ-wɛɣɛ ɑsɑɣɑɑ niŋ tɑɑ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tɑmpɑnɑ təŋlɑɑ tənnɑ nyɑɑləm,","poem":1},{"lineBreak":true},{"text":"nɑ mpɑ pɑ lotu tɑɑ tewɑ tɔɣɔ lɑŋhʋlʋmlɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Siɣisilɑɑ, mə lɑŋɑ ɩ́ hʋləmənɑ Tɑcɑɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ sɑ ɩ tənɑŋŋ wɛɛtʋ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}