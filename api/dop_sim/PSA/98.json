 sɑmtʋ","poem":1},{"lineBreak":true},{"text":"ɩ́ yoo-ɩ-tɩ nɑ cəməŋ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɩ́ tʋ Tɑcɑɑ wulɑʋ kɛ yonkpɑɑmɑ nɑ lɑŋhʋlʋmlɛ,","poem":1},{"lineBreak":true},{"text":"nɑ ɑkɑntɛɛ nɑ tutuuŋ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Teŋku nɑ ɩ tɑɑ nyəm tənɑ ɩ́ cɔ,","poem":1},{"lineBreak":true},{"text":"nɑ tɛtʋ nɑ tə tɑɑ nyəm ŋmɑɑlənɑ lɑŋhʋlʋmlɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pusi ɩ́ wiliti","poem":1},{"lineBreak":true},{"text":"nɑ pɔɔŋ tənɑ nɑ́ɑ́ kpɛntɩ nɑ ɩ́ yoo yontu kɛ Tɑcɑɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mpi tɔ, Tɑcɑɑ kɔŋ sɩ ɩ́ hʋʋnɑ tɛtʋ tənɑ.","poem":1},{"lineBreak":true},{"text":"Ɩ kɑ təŋ tɑmpɑnɑ nɑ ɩ́ hʋʋnɑ ɑntulinyɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ hʋʋnɑ yəlɑɑ kɛ teitei.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}