{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"PSA","translationId":"dop_sim","name":"Yontu","commonName":"Yontu","title":"YONTU NTI PA YOONA ƖSƆ HƎTƐ TƆ TƎ TAKƎLAƔA Kʋtʋlʋtʋ","order":19,"numberOfChapters":150,"sha256":"7983a96097f2f90109fbcdcdd4ae17f9c6b732f13740c22aee998edbce1626f4","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dop_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":99,"content":[{"type":"heading","content":["Tɑcɑɑ kɛ wulɑʋ, nɑ ɩ́ wɛ tənɑŋŋ"]},{"type":"verse","number":1,"content":["Tɑcɑɑ n tɔkɩ kɑwulɑɣɑ kɛ́, nɑ yəlɑɑ seliɣi.",{"text":"N cɑɣɑ ɩsɔtɑɑ tɑŋlɑɑ hɛkʋ nɑ tɛtʋ seliɣi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tɑcɑɑ nyɑɣɑlɛ sɔsɔ kɛ Siyɔŋ tɑɑ,","poem":1},{"lineBreak":true},{"text":"Nyɑ́ tɛɛnɑ yəlɑɑ tənɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pɑ sɛɛ nyɑ́ hətɛ sɔsɔɔlɛ kɑtɛ nyəntɛ,","poem":1},{"lineBreak":true},{"text":"tə kɛ́ nɑŋŋ nyəntɛ kɛ́.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pɑ sɛɛ wulɑʋ nyɑ́ wei n sɔɔlɑ siɣisuɣu tɔ nyɑ́ toŋ,","poem":1},{"lineBreak":true},{"text":"nyɑ́ nyɔɔsəɣənɑ tɑmpɑnɑ təŋʋɣʋ.","poem":1},{"lineBreak":true},{"text":"N lɑkɩ kʋsiɣisim nɑ mpi pə","poem":1},{"lineBreak":true},{"text":"wɛ teitei tɔɣɔ Ɩsɛɣɛlɩ tɑɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ɩ́ pʋɣʋlɩ Tɑcɑɑ tɑ Ɩsɔ,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ luŋ ɩ nɔɔhɛɛ təsɩɩlɛ,","poem":1},{"lineBreak":true},{"text":"ɩ kɛ́ nɑŋŋ tʋ kɛ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Moisi nɑ Alɔŋ mpɑ pɑɑ wɛ Ɩsɔ nyɑ́ nyɑ́ kɔtəlɑɑ tɑɑ tɔ","poem":1},{"lineBreak":true},{"text":"nɑ Sɑmiyɛlɩ wei ɩ kɑ wɛ mpɑ","poem":1},{"lineBreak":true},{"text":"pɑ sələmɑɣɑ-ŋ tɔ pɑ hɛkʋ tɔ,","poem":1},{"lineBreak":true},{"text":"pɑ sələmɑ Tɑcɑɑ nyɑ́ nɑ ń mʋ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ɩsɔŋmʋntʋɣʋ tɑɑ kɛ́ n yɔɣɔtɑɣɑnɑ-wɛ","poem":1},{"lineBreak":true},{"text":"nɑ mpɛ pɑ́ tɔkəɣɩ nyɑ́ kʋsəsɩɩtʋ nɑ kiiu ŋku n sɩɩ-wɛ tɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tɑcɑɑ tɑ́ Ɩsɔ, n mʋ pɑ kʋsələmʋtʋ.","poem":1},{"lineBreak":true},{"text":"Nyɑɣɑlɛ pɑ Ɩsɔ, nɑ ń wiiki-wɛ.","poem":1},{"lineBreak":true},{"text":"Amɑ n tʋ-wɛɣɛ sɑləkɑ kɛ pɑ ɩsɑɣɑtʋ tɔɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ɩ sɑ Tɑcɑɑ tɑ Ɩsɔ nɑ ɩ́ luŋ","poem":1},{"lineBreak":true},{"text":"ɩ pulɑɣɑ nɑŋŋ nyəŋkɑ tɔɔ.","poem":1},{"lineBreak":true},{"text":"Mpi tɔ, tɑ́ Ɩsɔ Tɑcɑɑ wɛɛ kɛ́ tənɑŋŋ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}