{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"SNG","translationId":"dop_sim","name":"Yontu Tɑɑ Yontu","commonName":"Yontu Tɑɑ Yontu","title":"YONTU TAA YONTU","order":22,"numberOfChapters":8,"sha256":"54d341da93867afb6dcc27183fbc9fe20433d30eef49b5ebf4608d7ec582cb89","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/dop_sim/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Sɑlʋmɔŋ yontu tɑɑ yontu ntɔ."]},{"type":"heading","content":["Sɔɔlʋɣʋ nyǝ́mɑ fɑɑci"]},{"type":"heading","content":["(Pɛɛlɔ kʋyɔɣɔtʋtʋ)"]},{"type":"verse","number":2,"content":[{"text":"Wɑɣɑlɩ-m wɑɣɑlɩ-m,","poem":1},{"lineBreak":true},{"text":"nyɑ́ sɔɔlʋɣʋ kǝlɑ-m sʋlʋm.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nyɑ́ tulɑɑlʋ sɔɔsʋŋ kɛ́ kʋpɑŋ kɛ́.","poem":1},{"lineBreak":true},{"text":"Nɑ nyɑ́ hǝtɛ nɑ́ɑ́ wɛ ɩsɩɩ nim sɔɔsʋŋ nɩɩkʋɣʋ tɔ.","poem":1},{"lineBreak":true},{"text":"Pǝ tɔɔ kɛ́ pɛɛlɑɑ sɔɔlǝɣɩ-ŋ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tɔkɩ mɑ niŋ tɑɑ, kpɑɣɑnɑ-m ɑsewɑ.","poem":1},{"lineBreak":true},{"text":"Wulɑʋ sʋsɑ-m ɩ kutuluŋ tɑɑ kɛ́.","poem":1},{"lineBreak":true},{"text":"Tɩɩ wɛɛnɑ lɑŋhʋlʋmlɛ nɑ tǝ́ ŋmɑɑlɩ nyɑ́ tɔɔ.","poem":1},{"lineBreak":true},{"text":"Tɩɩ yɔɔlǝnɑ nyɑ́ sɔɔlʋɣʋ nɑ pǝ́ kǝlɩ sʋlʋm.","poem":1},{"lineBreak":true},{"text":"Pɑ sɔɔlǝɣɩ-ŋ tɔ pɑ wɛnɑ tɑmpɑnɑ kɛ́.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yosɑlɛm pɛɛlɑɑ mɛ,","poem":1},{"lineBreak":true},{"text":"pɑɑ mɑ pilɑɑ tɔ,","poem":1},{"lineBreak":true},{"text":"mɑ tewɑɣɑ ɩsɩɩ Ketɑɑ cokɑ,","poem":1},{"lineBreak":true},{"text":"yɑɑ ɩsɩɩ Sɑlʋmɔŋ cokɑ pɔɔŋ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɩ́ tɑɑ nyɑnɑ-m sɩ mɑ kǝlɑ piliŋ.","poem":1},{"lineBreak":true},{"text":"Ilim piisinɑ-m mpʋ.","poem":1},{"lineBreak":true},{"text":"Mɑ tɑɑlʋnɑɑ mʋ-m nɑ pɑ́ɑ́nɑ́ kɛ́,","poem":1},{"lineBreak":true},{"text":"pɑ tʋ-m sɩ mɑ tɑŋ lɛsɛŋ tɩɩŋ tɑwɑ.","poem":1},{"lineBreak":true},{"text":"Ɩlɛ mɑ tɑ tɑŋ mɑ mɑɣɑmɑɣɑ mɑ nyǝntɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nyɑ́ wei mɑ lǝsɑɣɑ sʋʋwɑ tɔ.","poem":1},{"lineBreak":true},{"text":"Heeli-m timpi n tiikiɣi nyɑ́ kɑlǝkʋ tɔ.","poem":1},{"lineBreak":true},{"text":"Kɛɛsɩ-m timpi n kɑ hɛɛsɩ ilim sikuɣu tɔ.","poem":1},{"lineBreak":true},{"text":"Mɑ tɑɑ cɔɔ yem kɛ́ nyɑ́ tɑɑpɑlɑɑ kɑlǝkǝŋ cɔlɔ.","poem":1}]},{"type":"heading","content":["(Tiikilɑɑ kʋyɔɣɔtʋtʋ)"]},{"type":"verse","number":8,"content":[{"text":"Alɑɑ telɑɑ tɑɑ telu nyɑ́.","poem":1},{"lineBreak":true},{"text":"Ye n tɑ nyɩ ɩlɛ n tǝŋ heeŋ kɑlǝkʋ nɔɔhɛɛ.","poem":1},{"lineBreak":true},{"text":"Tiiki nyɑ́ pinɑsɩ kɛ tiikilɑɑ cokɑ kiŋ.","poem":1}]},{"type":"heading","content":["(Ɩfepu nyǝntʋ)"]},{"type":"verse","number":9,"content":[{"text":"Mɑ kʋsɔɔlɑɣɑ nyɑ́, nyɑ́ teu nǝɣǝsǝnɑ kɛ́ ɩsɩɩ","poem":1},{"lineBreak":true},{"text":"pɑ kpɛɛlʋɣʋ Icipiti wulɑʋ kpɑɣɑnʋ ɑlʋnyǝŋ kɛɛkɛ nɑ kɑcɔkɑ tɔ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nyɑ́ lukpuɣutu tewɑ nyɑ́ ŋkpɑŋyɑpǝlɑsɩ hɛkʋ kɛ́.","poem":1},{"lineBreak":true},{"text":"Nɑ nyɑ́ luɣu nɑ́ɑ́ sǝŋɑ teu kɛ lɩɩtʋ hɛkʋ tɑɑ.","poem":1}]},{"type":"heading","content":["(Tiikilɑɑ nyǝntʋ)"]},{"type":"verse","number":11,"content":[{"text":"Tɩɩ lu-ŋ wʋlɑ kɛ kɑcɔkɑ wontu","poem":1},{"lineBreak":true},{"text":"nɑ pɑ́ mɑtɩ tǝ tɔɔ kɛ́ liɣitee nyǝɣǝtʋ.","poem":1}]},{"type":"heading","content":["(Pɛɛlɔ nyǝntʋ)"]},{"type":"verse","number":12,"content":[{"text":"Wulɑʋ nɑ ɩ cɔlɔ nyǝ́mɑ pɑ cɑɣɑɑ tɔ","poem":1},{"lineBreak":true},{"text":"nɑ mɑ tɔɔ tulɑɑlʋ sɔɔsʋŋ nyɑlɑɑ kɛ́.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mɑ kʋsɔɔlʋ nyɑ́, n wɛ-m kɛ́ ɩsɩɩ","poem":1},{"lineBreak":true},{"text":"tulɑɑlʋ miili kɛ pɑ sɩɩ mɑ hǝlɑ hɛkʋ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N wɛ-m kɛ́ ɩsɩɩ lɑɑlinɑɑ kʋpɑmɑ tɩɩŋ kɛ","poem":1},{"lineBreak":true},{"text":"Aŋ-Ketii lɛsɛŋ tɑwɑ tɑɑ.","poem":1}]},{"type":"heading","content":["(Ɩfepu nyǝntʋ)"]},{"type":"verse","number":15,"content":[{"text":"Mɑ kʋsɔɔlɑɣɑ nyɑ́, ɑmɑ n tewɑ yoo!","poem":1},{"lineBreak":true},{"text":"Nyɑ́ ɩsǝpee tewɑ ɩsɩɩ ɑlukukunɑɑ.","poem":1}]},{"type":"heading","content":["(Pɛɛlɔ nyǝntʋ)"]},{"type":"verse","number":16,"content":[{"text":"Mɑ kʋsɔɔlʋ nyɑ́, teu ntɛ́ yɑɑ.","poem":1},{"lineBreak":true},{"text":"Tɑ́ kʋhǝntʋɣʋ ntɛ́ kɑteŋɑ nyɩɩtʋ kʋlɛkǝlɛkǝtʋ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tɩɩŋ kʋpɑŋ piliŋɑsɩ ntɛ́ tɑ kutuluɣu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}