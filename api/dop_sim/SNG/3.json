{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"SNG","translationId":"dop_sim","name":"Yontu Tɑɑ Yontu","commonName":"Yontu Tɑɑ Yontu","title":"YONTU TAA YONTU","order":22,"numberOfChapters":8,"sha256":"54d341da93867afb6dcc27183fbc9fe20433d30eef49b5ebf4608d7ec582cb89","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/dop_sim/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"heading","content":["Pɛɛlɔ toosiɣinɑ ɩfepu"]},{"type":"heading","content":["(Pɛɛlɔ nyǝntʋ)"]},{"type":"verse","number":1,"content":["Ḿpʋ́ɣʋ́ mɑ toosɑ ɑhoo sɩ",{"text":"mɑ kʋsɔɔlʋ ntɛ́ mɑ pɛɛkɑ kɑto tɔɔ.","poem":1},{"lineBreak":true},{"text":"Nɑ mɑ́ pɛɛkɩ, nɑ mɑ́ pɛɛkɩ, mɑ tɑ nɑ-ɩ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɩlɛnɑ mɑ́ kʋlɩ nɑ mɑ́ cɔɔ ɩcɑtɛ.","poem":1},{"lineBreak":true},{"text":"Nɑ mɑ́ pɛɛkɩ-ɩ nɔnɔɔsɩ tɛɛ,","poem":1},{"lineBreak":true},{"text":"nɑ hɑpɛɛ tɔɔ, mɑ tɑ nɑ-ɩ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɩlɛnɑ mɑ́ sulinɑ tɑŋlɑɑ mpɑ pɑ cɔɔkɩ ɩcɑtɛ tɔ","poem":1},{"lineBreak":true},{"text":"nɑ mɑ́ pɔɔsɩ-wɛ sɩ:","poem":1},{"lineBreak":true},{"text":"Ɩ́ nɑwɑ mɑ kʋsɔɔlʋ nɑ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mɑ polɑɑ sɩ mɑ tɛɛkɩ pɑ tɔɔ ɩlɛ,","poem":1},{"lineBreak":true},{"text":"mɑ nɑ́ mɑ kʋsɔɔlʋ ntɛ́.","poem":1},{"lineBreak":true},{"text":"Nɑ mɑ́ kpipi-ɩ nɑ mɑ́ tɔkɩ-ɩ teu nɑ mɑ́ ponɑ-ɩ mɑ too tɛ.","poem":1},{"lineBreak":true},{"text":"Nɑ mɑ́ sʋʋnɑ-ɩ wei ɩ lʋlɑ-m tɔ ɩ nɑŋ tɑɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hɑɩ, Yosɑlɛm pɛɛlɑɑ mɛ,","poem":1},{"lineBreak":true},{"text":"mɑ tuukinɑ nɑmǝŋ nɑ nɑsɛŋ.","poem":1},{"lineBreak":true},{"text":"Ɩ́ tɑɑ pɑɑtɩ tɑ́ sɔɔlʋɣʋ nɑ kʋ wɑɑtʋ tɑ tɑtɑ.","poem":1}]},{"type":"heading","content":["(Pɛɛlɔ nyǝntʋ)"]},{"type":"verse","number":6,"content":[{"text":"Pepe lɩɩnɑ wʋlɑɣɑ tɛtʋ tɑɑ nɑ pǝ́ kɔŋ","poem":1},{"lineBreak":true},{"text":"ɩsɩɩ wontu pee tulɑɑlʋ nyɔɔsɩ?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wulɑʋ Sɑlʋmɔŋ ɑmɑkɑ kɔŋnɑ.","poem":1},{"lineBreak":true},{"text":"Nɑ Ɩsɛɣɛlɩ yoolɑɑ tɑɑ yoolɑɑ nɩɩtoso kɛ ɩ wɑɑlɩ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pɑ tǝnɑ pɑ kpɛlǝmɑ yoou kɛ́.","poem":1},{"lineBreak":true},{"text":"Pɑ pɑɑ lɑɣɑlɛɛ kɛ pɑ kɔŋkɔmǝŋ tɑɑ.","poem":1},{"lineBreak":true},{"text":"Nɑ pɑ́ tɑŋɑ ɑsolɑ nnɑ ɑ kɔŋ ɑhoo tɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lipɑŋ tɑɑsɩ kʋpɑŋsɩ kɛ pɑ sɑɑkɑ","poem":1},{"lineBreak":true},{"text":"wulɑʋ Sɑlʋmɔŋ ɑmɑkɑ ɩnɩ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Liɣitee nyǝɣǝtʋ kɛ pɑ lupɑ ɩ kpɑtǝŋ,","poem":1},{"lineBreak":true},{"text":"nɑ tǝteesile kɛ wʋlɑ.","poem":1},{"lineBreak":true},{"text":"Tǝcɑɣɑlɛ kɛ pʋʋɣʋ kʋsɛɛmʋɣʋ kʋpɑŋkʋ.","poem":1},{"lineBreak":true},{"text":"Ɩlɛnɑ Yosɑlɛm pɛɛlɑɑ nɑ́ɑ́ pɔ pǝ tɑɑ kɛ́","poem":1},{"lineBreak":true},{"text":"pɔɔŋ wei pɑ sɔpǝnɑ sɔɔlʋɣʋ tɔ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Siyɔŋ pɛɛlɑɑ mɛ,","poem":1},{"lineBreak":true},{"text":"ɩ́ lɩɩ nɑ ɩ́ nɑ́ wulɑʋ Sɑlʋmɔŋ ntenuɣu","poem":1},{"lineBreak":true},{"text":"ŋku ɩ too temɑ-ɩ ɩ ɑkpɑɣɑlɛ wule tɔ.","poem":1},{"lineBreak":true},{"text":"Kʋ kɛ́ ɩ lɑŋhʋlʋmlɛ sɔsɔɔlɛ kʋyɑkʋ kɛ́.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}