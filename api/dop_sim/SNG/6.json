{"translation":{"id":"dop_sim","name":"PIIPILI ƖSƆ TƆM TAKƎLAƔA","website":"https://ebible.org/Scriptures/details.php?id=dop","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dop","licenseNotes":null,"shortName":"SIM","englishName":"Lokpa Bible","language":"dop","textDirection":"ltr","sha256":"fafc27de8c624ab960c03e887c1c1cc43600976bc3a1aa0abf0831ee798e59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/dop_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":954,"totalNumberOfVerses":23692,"languageName":"Lukpa","languageEnglishName":"Lukpa"},"book":{"id":"SNG","translationId":"dop_sim","name":"Yontu Tɑɑ Yontu","commonName":"Yontu Tɑɑ Yontu","title":"YONTU TAA YONTU","order":22,"numberOfChapters":8,"sha256":"54d341da93867afb6dcc27183fbc9fe20433d30eef49b5ebf4608d7ec582cb89","firstChapterNumber":1,"firstChapterApiLink":"/api/dop_sim/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/dop_sim/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"heading","content":["(Pɛɛlɑɑ nyǝntʋ)"]},{"type":"verse","number":1,"content":[{"text":"Alɑɑ tɑɑ ɑcɛpɑ nyɑ́,","poem":1},{"lineBreak":true},{"text":"leɣe nyɑ́ kʋsɔɔlʋ polɑɑ?","poem":1},{"lineBreak":true},{"text":"Nkuɣu ɩ tǝŋɑɑ?","poem":1},{"lineBreak":true},{"text":"Tɑ nɑ-ŋ tǝ pɛɛkɩ-ɩ.","poem":1}]},{"type":"heading","content":["(Pɛɛlɔ nyǝntʋ)"]},{"type":"verse","number":2,"content":[{"text":"Mɑ kʋsɔɔlʋ n polɑ nyɑ́ tɑɑlɛ nte tǝ tɑɑ tulɑɑlʋ","poem":1},{"lineBreak":true},{"text":"sɔɔsʋŋ nyɑlɑɑ tɔɣɔ sɩ n cɑɑkɩ yɑɑyenɑɑ","poem":1},{"lineBreak":true},{"text":"nɑ ń tiiki nyɑ́ kɑlǝkʋ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mɑ́ tǝnnɑ mɑ kʋsɔɔlʋ nyɑ́ nɑ nyɑ́ tǝnnɑ mɑ́ tɔtɔ.","poem":1},{"lineBreak":true},{"text":"Yɑɑyenɑɑ tɑɑ kɛ́ n tiikiɣi nyɑ́ kɑlǝkʋ.","poem":1}]},{"type":"heading","content":["Pɛɛlɔ wɛɛtʋ"]},{"type":"heading","content":["(Ɩfepu nyǝntʋ)"]},{"type":"verse","number":4,"content":[{"text":"Mɑ kʋsɔɔlɑɣɑ nyɑ́,","poem":1},{"lineBreak":true},{"text":"n tewɑɣɑ ɩsɩɩ Tiisɑ ɩcɑtɛ.","poem":1},{"lineBreak":true},{"text":"N wɛ leleŋ ɩsɩɩ Yosɑlɛm tɑɑ cɑɣɑlɛ.","poem":1},{"lineBreak":true},{"text":"Amɑ n wɛ sɔɣɔntʋ ɩsɩɩ yoolɑɑ nɑ pɑ tuutɑnɑɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kɛɛsɩ nyɑ́ ɩsɛ ɑnɩ ɑ cɔɔsǝɣɩ-m kɛ́.","poem":1},{"lineBreak":true},{"text":"Nyɑ́ nyɔɔsɩ hǝntɑ ɩsɩɩ pǝ́ŋ kɑlǝkʋ tiiki Kɑlɑɑtɩ pʋɣʋ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nyɑ́ kelɑ hʋlʋmɑɑ kɛ́ ɩsɩɩ heeŋ kʋhʋlʋmǝŋ kɑlǝkʋ,","poem":1},{"lineBreak":true},{"text":"ŋku kʋ lɩɩnɑ lʋm tǝnyɔɔlɛ,","poem":1},{"lineBreak":true},{"text":"nɑ pɑɑ heu wei nɑ ɩ tompiyɑ tɔ.","poem":1},{"lineBreak":true},{"text":"Nɔɣɔlʋ tɑ hɛlǝmɩ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nyɑ́ lukpuɣutu nɑɑkɩ nyɑ́ tɛkɛntɛ tɛɛ","poem":1},{"lineBreak":true},{"text":"kɛ́ ɩsɩɩ pɑ fɑɣɑ tʋɣʋ nɑkʋlɩ kʋ pile.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wulɑʋ pǝsǝɣɩ nɑ ɩ́ wɛɛnɑ tɑɣɑ ɑlɑɑ kɛ nɩɩtoso.","poem":1},{"lineBreak":true},{"text":"Nɑ ɑsɑɑlɑɑ kɛ nɩɩnɑɑsɑ, nɑ sɑɑlɑɑ nɑ́ɑ́ fɛɩ kɑlʋɣʋ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Amɑ nyɑ́ tike kɛ nyɑ́ too lʋlɑ ɑlʋpǝyɑɣɑ nɑ ɩ kǝlɑ-ŋ sɔɔlʋɣʋ.","poem":1},{"lineBreak":true},{"text":"Nyɑɣɑlɛ mɑ kʋpɑŋkɑ, n wɛ-m teu kɛ́ ɩsɩɩ ɑlukuku.","poem":1},{"lineBreak":true},{"text":"Pɛɛlɑɑ nɑɑkɩ-ŋ nɑ pɑ́ yɑɑkɩ-ŋ lɑŋhʋlʋmlɛ tʋ.","poem":1},{"lineBreak":true},{"text":"Nɑ tɑɣɑ ɑlɑɑ nɑ ɑsɑɑlɑɑ tɔtɔ nɑ́ sɑŋɩ-ŋ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Alʋ wei ɩ lɩɩkǝnɑ mpʋ nɑ ɩ́ teeki kɔkɔ ɩsɩɩ ilim,","poem":1},{"lineBreak":true},{"text":"nɑ ɩ́ tewɑ ɩsɩɩ ɩsɔtʋ?","poem":1},{"lineBreak":true},{"text":"Nɑ ɩ́ wɛ sɔɣɔntʋ ɩsɩɩ yoolɑɑ nɑ pɑ tuutɑnɑɑ?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mɑ tiiwɑ tɩɩŋ pee tɑɑlɛ tɑɑ","poem":1},{"lineBreak":true},{"text":"sɩ mɑ nɑɑkɩ tɛtɛkǝlɛ tɑɑ mǝhoo kʋfɑnɑ.","poem":1},{"lineBreak":true},{"text":"Nɑ mɑ́ nɑ́ sɩ tɩɩŋ wei pɑ yɑɑ sɩ lɛsɛŋ tɔ ɩ hɛlǝɣɩ,","poem":1},{"lineBreak":true},{"text":"nɑ tɩɩŋ lɛlǝŋ tʋɣɩ hɛtʋ nɑ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mɑ tɑ cɛkǝnɑ, ɑmɑ mɑ kʋnyɩɩlʋɣʋ pǝsɑ-m kɛ́","poem":1},{"lineBreak":true},{"text":"ɩsɩɩ mɑ yǝlɑɑ kɑsɑɣɑmpiyɑ yoou kɛɛkɛnɑɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dop_sim/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dop_sim/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dop_sim/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":12}