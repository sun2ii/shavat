{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"1CH","translationId":"dwr_ent","name":"1 ኦዱዋ","commonName":"1 ኦዱዋ","title":"ሀኔዳባ ኦድያ ኮይሮ ማጻፋ","order":13,"numberOfChapters":29,"sha256":"9e312754524749ce77c448753fb86d0cb129e4b197c12e7a64e508cd8029aceb","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/dwr_ent/1CH/29.json","totalNumberOfVerses":932},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":["ኡንቱንቱ ጾሳ ታቦታ አሂደ፥ ዳዊተ ታቦታ ዎናዉ ጌዳ ዱንካንያ ግዱዋን ዎድኖ። ጹግያ ያርሹዋነ እትፐተ ያርሹዋ መና ጎዳዉ ያርሼድኖ።"]},{"type":"verse","number":2,"content":["ዳዊተ ጹግያ ያርሹዋነ እትፐተ ያርሹዋ ያርሺደ ፖሌዳዋፐ ጉይያን፥ መና ጎዳ ሱንን አሳ አንጄዳ።"]},{"type":"verse","number":3,"content":["እስራኤልያ አሳዉ ኡባዉ፥ ማጫንዉነ አቱማዎ፥ ሁጲያን ሁጲያን እት እት ኮምፖ ኡክ፥ እት እት ሙጾ አሹዋካ ዎይንያ ቴራ መላፐ እት እት ኡክ ግሼዳ።"]},{"type":"verse","number":4,"content":["መና ጎዳ ታቦታ ስንን ኦናዳንነ መና ጎዳ እስራኤልያ ጾሳ ሳባናዳን፥ ጋላታናዳንነ ቦንቻናዳን፥ አማሬዳ ሌዋቱዋ ዳዊተ ሱንዳ።"]},{"type":"verse","number":5,"content":["ሌዋቱ ካፑ አሳፋ፤ አሳፋ ካሊደ ላኤን ካፑ ዛካራሳ። ዛካራሳ ካሊደ ደእያዋንቱ ይእኤላ፥ ሻምራሞታ፥ ይህኤላ፥ ማቲትያ፥ ኤልኣባ፥ ባናያ፥ ኦቤድ-ኤዶማነ የኤላ። ኡንቱንቱ ማስንቁዋነ ዲ ዲጻናዉ ሱንቴድኖ፤ ሽን አሳፈ ዳላ ቃናዉ ሱንቴዳ።"]},{"type":"verse","number":6,"content":["ቄስያ ባናይነ ያሃእኤል ጾሳ ቃላ ጫቁዋ ታቦታ ስንን ኡባ ዎደ ጹሩምባ ፑናናዉ ሱንቴድኖ።"]},{"type":"verse","number":7,"content":["ሄ ጋላስ ዳዊተ ካሰቲደ፥ አሳፍነ አ ዳቦቱ መና ጎዳ ሳባናዳን ኡንቱንቶ እሜዳ።"]},{"type":"heading","content":["ጋላታ ማዝሙርያ"]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"መና ጎዳ ጋላትተ፤ አ ሱን ጼስተ።","poem":1},{"text":"እ ኦዳዋ ካዉተቱ ግዱዋን ኤርስተ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አ ሳቢተ፤ ጋላታ የ አዉ የጽተ።","poem":1},{"text":"አ ማላልስያ ኪታ ኡባ ኦድተ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አ ጌሻ ሱንን ጬቀትተ፤","poem":1},{"text":"መና ጎዳ ኮይያዋንቱ ዎዛናቱ ናሸትኖ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"መና ጎዳነ አ ዎልቃ ጾሞስተ፤","poem":1},{"text":"ኡባደ አ ስን ኮይተ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ህንተንቶ፥ አ ቆማ አብራሃማ ዘረቶ፥","poem":1},{"text":"ዶረቴዳ ያቆባ ናቶ፥","poem":2},{"text":"እ ኦዳ ማላልስያባ፥","poem":1},{"text":"አ ማላታነ እ ፕርዴዳ ፕርዳ ሀሳይተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"እ መና ጎዳ ኑ ጾሳ፤","poem":1},{"text":"አ ፕርዳይካ ሳኣ ኡባ ቦላና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እ ባረ ቃላ ጫቁዋ መናዉ፥","poem":1},{"text":"ባረ አዛዜዳ ቃላ ሻአ የለታ ጋካናዉ ናጌ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሄዌነ፥ እ አብራሃመና ጫቀቴዳ ጫቁዋ፥","poem":1},{"text":"ይሳቃዉ ጫቄዳ ጫቁዋ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ያቆባዉ ዎጋ፥","poem":1},{"text":"እስራኤልያዉካ መና ጫቁዋ ኦደ ምንዳዋ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እ፥ “ነዉ ካናነ ቢታ እማና፤","poem":1},{"text":"እ ነ ዘረቶ ላታ ግዳናዋ” ያጌዳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ጾሳ አሳቱ ፓይዱዋን ጉነ","poem":1},{"text":"ካናነ ቢታን በተ ግዲደ ደእያ ዎደ፥","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እት አሳፐ ሀራ አሳ፥","poem":1},{"text":"እት ካተተፐ ሀራ ካዉተ ዩዬድኖ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ጾሳይ ኡንቱንታ ኦንነ ናቃናዉ እምቤና፤","poem":1},{"text":"ኡንቱንቱ ድራዉ ካተቱዋ ሴሪደ፥","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“ታን ኦኬዳዋ ቦቾፕተ፤","poem":1},{"text":"ታ ትምቢትያ ኦድያዋንታ ቆሆፕተ” ያጌዳ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ሳኣን ደእያ አሳዉ፥ ኡባይካ መና ጎዳዉ የጽተ፤","poem":1},{"text":"እ አሽያ ምሽራቹዋ ሀቼ ሀቼ ኦድተ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ካዉተቱ ግዱዋን አ ቦንቹዋ፥","poem":1},{"text":"አሳ ኡባ ግዶን አ ማላልስያ ኦሱዋባ አዋይተ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"መና ጎዳይ ዎልቃማ፤ አ ጋላታይ አዉ በሴ።","poem":1},{"text":"ጾሳቱዋ ኡባፐ አደ፥ እ ያየታናዉ በሰ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ሀራ አሳ ጾሳቱ ኡባይ ኤቃቱዋ፤","poem":1},{"text":"ሽን መና ጎዳይ ሳሉዋ መዳ ጾሳ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ቦንቹነ አንጋይ አ ዩሹዋን ደኤ፤","poem":1},{"text":"ምኖተይነ ናሸቻይ እ ደእያ ሳኣን ደኤ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ህንተንቶ፥ አሳ ዛረቶ ኡባዉ፥ መና ጎዳዋ ኦድተ፤","poem":1},{"text":"“ቦንቹነ ዎልቃይ መና ጎዳዋ” ጊደ ኦድተ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"“ቦንቹ አ ሱንሳ” ጊደ መና ጎዳዋ ኦድተ።","poem":1},{"text":"ያርሹዋ አኪደ፥ አ ስን ዪተ።","poem":2},{"text":"አ ጌሻተ ፑላን መና ጎዳዉ ጎይንተ።","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"ጋድያን ደእያ አሳዉ ኡባዉ፥ አ ስንን ኮኮርተ።","poem":1},{"text":"ሳአይ ምን ኤቄዳ፤ ኡባካ ቃጸና።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ሳሎቱ ናሸትኖ፤ ሳአይካ ሀሹ ጎ!","poem":1},{"text":"ካዉተቱ ግዶን ኡንቱንቱ፥ “መና ጎዳይ ካተቴዳ!” ያግኖ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"አባይነ አ ግዶን ኩሜዳባቱ ጉምኖ።","poem":1},{"text":"ሾይቃይነ ሾይቃን ደእያባቱ ኡባቱ ናሸትኖ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ሄዋፐ ጉይያን ዎራን ደእያ ም ኡባይ የጻና፤","poem":1},{"text":"ናሸቻን መና ጎዳ ስንን የጻና።","poem":2},{"text":"አያዉ ጎፐ፥ እ ሳኣ ቦላን ፕርዳናዉ ዬ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"ጾሳይ ሎአ ግድያ ድራዉነ መና ጎዳ ጋላትተ።","poem":1},{"text":"አገና አ ሲቁ መናዋ ግድያ ድራዉ፥ ጋላትተ።","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ሄዋፐ ጉይያን ህንተንቱ፥","poem":1},{"text":"“አቤት ኑና አሽያ ጾሳዉ፥ ኑና አሻ።","poem":2},{"text":"ኑን ነ ጌሻ ሱን ጋላታናዳንነ","poem":1},{"text":"ነ ቦንቹዋን ጬቀታናዳን፥","poem":2},{"lineBreak":true},{"text":"ካዉተቱ ግዶፐ ሺሻደ አሻ” ያግተ።","poem":2}]},{"type":"verse","number":36,"content":[{"text":"መና ጎዳዉ፥ እስራኤልያ ጾሳዉ ጋላታይ ግዶ።","poem":1},{"text":"መናፐ መና ጋካናዉ ጋላተቶ!","poem":2},"ሄዋፐ ጉይያን አሳይ ኡባይ፥ “አመንእ” ጊደ፥ መና ጎዳ ጋላቴዳ።"]},{"type":"heading","content":["የሩሳላመንነ ጋባኦናን ሀኔዳ ጎይኑዋ ማራ"]},{"type":"verse","number":37,"content":["መና ጎዳ ቃላ ጫቁዋ ታቦታ ስንን ሀቼ ሀቼ ጎይናዉ ኮሽያዋ ኡባ ዎደ ኡንቱንቱ ኦናዳን፥ ዳዊተ አሳፋነ አ ዳቦቱዋ ዎዳ።"]},{"type":"verse","number":38,"content":["እ ቃይ ኦቤድ-ኤዶማነ አ ዳቦቱዋ ኡሱፑን ታማነ ሆስፑን ኡንቱንቱና ኦናዳን ዎዳ፤ ይዱቱና ናኣ ኦቤድ-ኤዶማነ ሆሳ ፐንግያ ናጋናዳን ዎዳ።"]},{"type":"verse","number":39,"content":["ቄሲ ጻዶቅነ አናና ኦያ ቄሳቱ ጋባኦናን ደእያ ቃ ሳኣን፥ መና ጎዳ ዱንካንያ ስንን ኦናዳን ያን አቴድኖ።"]},{"type":"verse","number":40,"content":["መና ጎዳይ እስራኤልያዉ እሜዳ ህግያን ጻፈቴዳዋዳን፥ ኡንቱንቱ ዎንታነ ኦማርስ ኡባ ዎደ ጹግያ ያርሹዋ ያርሽያ ሳኣን መና ጎዳዉ ያርሺኖ።"]},{"type":"verse","number":41,"content":["አገና አ ሲቁ መናዋ ግድያ ድራዉ፥ መና ጎዳ የን ጋላታናዳን ሄማና፥ ይዱቱናነ ዶረቴዳ ሀራቱዋ ዳዊተ ኡንቱንቱና እትፐ ዎዳ።"]},{"type":"verse","number":42,"content":["ሄማንነ ይዱቱን ጹሩምባ ፑኒኖ፥ ዳላ ቃኖነ ጋላታ ማዝሙርያ የጺደ ካእያ ሀራ ሚሻቱዋ ካኢኖ። ይዱቱና አቱማ ናናይ ፐንግያ ናጋናዉ ሱንቴድኖ።"]},{"type":"verse","number":43,"content":["ሄዋፐ ጉይያን፥ አሳይ ኡባይ ባረ ሶ ባረ ሶ ቤዳ። ዳዊተካ ባረ ሶይ አሳ አንጃናዉ ስሜዳ።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/1CH/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/1CH/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/1CH/15.json","previousChapterAudioLinks":{},"numberOfVerses":42}