ntent":["ሽን ኑን ጾሳዉ ኑ ናጋራ ፓጾፐ፥ እ ኑ ናጋራ አቶ ጋናዉነ ኑ ባይዞ ኦሱዋ ኡባፐ ኑና ጌሻናዉ፥ አማነትያዋነ ቱሙዋ ኦያዋ።"]},{"type":"verse","number":10,"content":["ኑን ናጋራ ኦበይኮ ጎፐ፥ ጾሳ ዎርዱዋ ጌቶ፤ አ ቃላይካ ኑ ዎዛናን ደኤና።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/1JN/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/1JN/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/2PE/3.json","previousChapterAudioLinks":{},"numberOfVerses":10}