{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"2SA","translationId":"dwr_ent","name":"2 ሳሜላ","commonName":"2 ሳሜላ","title":"ላኤን ሳሜላ ማጻፋ","order":10,"numberOfChapters":24,"sha256":"6010911f382273eb56b11dccd4050b3e85a280361c301e246aaf928c3859be3d","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/dwr_ent/2SA/24.json","totalNumberOfVerses":692},"chapter":{"number":1,"content":[{"type":"heading","content":["ዳዊተ ሳኦል ሀይቄዳዋ ስሴዳ"]},{"type":"verse","number":1,"content":["ሳኦል ሀይቄዳዋፐ ጉይያን፥ ዳዊተ አማሌቃ አሳቱዋ ጾኔዳ ሳፐ ስሜዳ፤ ጽቅላጋ ካታማን ላኡ ጋላሳ ታኬዳ።"]},{"type":"verse","number":2,"content":["ሄዛን ጋላስ እት ብታኒ ካዮ ባረ ማዩዋ ፔደ፥ ባረ ሁጲያን ባና ላሊደ፥ ሳኦላ ሄራፐ ዬዳ። ዳዊተኮ እ ዬዳ ዎደ፥ ሳኣን ግሲደ ጎይኔዳ።"]},{"type":"verse","number":3,"content":["ዳዊተ አ፥ “ኔን ሀቃፐ ያድ?” ያጊደ ኦቼዳ። ሽን እ፥ “ታን እስራኤለቱዋ ሄራፐ ከሳ አካደ ያድ” ያጌዳ።"]},{"type":"verse","number":4,"content":["ዳዊተ አ፥ “አያይ ከሴደንቶ አነ ታዉ ኦዳ” ያጌዳ። እ ዳዊታ፥ “ኑ ኦላንቻቱ ኦላፐ ባቃቴድኖ፤ ኑ አሳፐ ዳራቱ ሀይቄድኖ፤ ቃይ ሳኦልነ አ ናአይ ዮናታን ሀይቄድኖ” ያጌዳ።"]},{"type":"verse","number":5,"content":["ኦዱዋ አሄዳ ዎዳላ ዳዊተ፥ “ሳኦልነ አ ናኣ ዮናታን ሀይቄዳዋ ኔን አያን ኤራይ?” ያጊደ ኦቼዳ።"]},{"type":"verse","number":6,"content":["ዎዳላይ፥ “ካጫዳን ታን ግልቦአ ደርያን ደእሽን፥ ሳኦል ባረ ቶራ ጉፈቲደ ኤቄዳዋ በኣድ፤ ፓራ ጋረቱነ ፓራ አሳቱ ሳኦላኮ ማታቴድኖ።"]},{"type":"verse","number":7,"content":["ሄ ዎደ ሳኦል ዩሽ ጼሊደ ታና በኤዳ፤ ታና ጼስና ታን፥ ‘አቤ!’ ያጋድ።"]},{"type":"verse","number":8,"content":["ሳኦል ታና፥ ‘ኔን ኦኔ?’ ያጊደ ኦቼዳ፤ ታን አዉ፥ ‘አማሌቃ አሳ’ ያጋደ ዛራድ።"]},{"type":"verse","number":9,"content":["ሄዋፐ ጉይያን ሳኦል ታና፥ ‘ታን ሎይ ማዱንጻደ፥ ሀይቆ ማታ ኡታድ፤ ኔን ታ ቦላ ከሳ ኤቃደ ታና ዎ’ ያጌዳ።"]},{"type":"verse","number":10,"content":["እ ኩንዴዳዋፐ ጉይያን፥ ሀይቁዋፐ አተናዋ ኤሬዳ ድራዉ፥ ታን አ ቦላ ከሳ ኤቃደ አ ዎድ፤ አ ሁጲያን ደእያ ካላቻነ አ ቀስያን ደእያ ሳጋይያ አካደ ኔኮ ታ ጎዳኮ አሃድ” ያጌዳ።"]},{"type":"verse","number":11,"content":["ሄዋፐ ጉይያን፥ ዳዊተነ ዳዊታ አሳይ ካዮቲደ፥ ባረንቱ ማዩዋ ዳፊደ ፔድኖ።"]},{"type":"verse","number":12,"content":["ኡንቱንቱ ሳኦል፥ ዮናታን፥ መና ጎዳ ኦላንቻቱነ እስራኤልያ አሳይ ኦላን ዉሬዳ ድራዉ፥ ኦማርስ ጋካናዉ ካዮቴድኖ፥ ዬኬድኖነ ጾሜድኖ።"]},{"type":"verse","number":13,"content":["ኦዱዋ አሄዳ ዎዳላ ዳዊተ፥ “ኔን ሀቃ አሴ?” ያጊደ ኦቼዳ። ሽን እ ዳዊታ፥ “ታን በትያ አማሌቃ ብታንያ ናኣ” ያጌዳ።"]},{"type":"verse","number":14,"content":["ዳዊተ አ፥ “መና ጎዳይ ኦኬዳ ካትያ ዎናዉ ነ ኩሽያ ደንደ፥ አያዉ ያያበይኪ?” ያጌዳ።"]},{"type":"verse","number":15,"content":["ዳዊተ ባረ አሳቱዋፐ እቱዋ ጼሲደ፥ “ባ፤ አ ዎ!” ያጌዳ፤ እ አማሌቅያ ደቺደ ዎዳ።"]},{"type":"verse","number":16,"content":["ዳዊተ አማሌቅያ፥ “መና ጎዳይ ኦኬዳ ካትያ ታን ዎድ ያጋደ ኔን ነ ዶናን ማርካቴዳ ድራዉ፥ ነ ሱ ጎሚ ኔና ኦይቆ” ያጌዳ።"]},{"type":"heading","content":["ዳዊተ ሳኦላዉነ ዮናታናዉ ዝላሌዳ ዝላሳ"]},{"type":"verse","number":17,"content":["ዳዊተ ሳኦላዉነ አ ናኣ ዮናታናዉ ሀዋዳን ያግ ዝላሌዳ።"]},{"type":"verse","number":18,"content":["ይሁዳ አሳይካ “ዎንዳፍያ” ጌተትያ ሀ ዝላሳ ታማራና ማላ ዳዊተ አዛዜዳ፤ ሀ ዝላሳይ ያሻራ ማጻፋን ጻፈቴዳ።"]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“ኔኖ እስራኤለዉ፥","poem":1},{"text":"ነ ካፓቱ ነ ቃ ግሹዋን ሀይቄድኖ።","poem":2},{"text":"ዎልቃማቱ ዋን ኩንዴድኖሻ!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ሀዋ ጋተ ካታማን ኦዶፕተ፤","poem":1},{"text":"አስቃሎና ኦገቱዋንካ አዋዮፕተ።","poem":2},{"text":"ሄዋ ስሶፐ፥ ፕልስጼማቱዋ ማጫ ናናይ ናሸታና፤","poem":1},{"text":"ሻማቱዋ ማጫ ናናይ ‘ሀሹ ጋና!’","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“ህንተንቶ ግልቦአ ደረቶ፥","poem":1},{"text":"ህንተንቱ ቦላን እራይ ቡኮፖ፤","poem":2},{"lineBreak":true},{"text":"ከተርሳይካ ዎፖ።","poem":2},{"lineBreak":true},{"text":"ሄ ቢታ ጎሻይካ ካ ሞኮፖ፤","poem":2},{"lineBreak":true},{"text":"አያዉ ጎፐ፥ ያን ዎልቃማ ጎንዳሊ ቱናባ ከሴዳ፤","poem":2},{"lineBreak":true},{"text":"ሳኦላ ጎንዳሊካ ዛይትያን ቁጨትያዋ አጌዳ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ጎራኤቴዳዋንቱ ሱፐነ፥","poem":1},{"text":"ዎልቃማቱዋ አሹዋፐ፥","poem":2},{"text":"ዮናታና ዎንዳፊ ጉየ ግቤና።","poem":1},{"text":"ቃይ ሳኦላ ማሻይ ካለናን ስምቤና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“ሳኦልነ ዮናታን","poem":1},{"text":"አሳይ ሲቅያዋንታነ ሎእያዋንታ፤","poem":2},{"lineBreak":true},{"text":"ባረንቱ ሀይቁዋንካ ባረንቱ ፓጻንካ ሻከትበይክኖ።","poem":2},{"lineBreak":true},{"text":"ኡንቱንቱ አርጋንፐካ አደ ኤሌልያዋንታ፤","poem":2},{"lineBreak":true},{"text":"ጋሙዋፐካ አደ ምንያዋንታ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“እስራኤልያ ማጫ አሳቶ፥","poem":1},{"text":"ሳኦላዉ፥ ህንተንታ ዞኦነ አሌቆ ማዩዋ ማይዜዳዋዎነ፥","poem":2},{"lineBreak":true},{"text":"ዎርቃን ህንተንቱ ማዩዋ አሌቂሴዳዎነ ዬክተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“ዎልቃማቱ ኦላን ዋን ኩንዴድኖሻ!","poem":1},{"text":"ዮናታን ነ ቃ ግሹዋን ጎራኤት ግሴዳ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ታ እሻ ዮናታና፥","poem":1},{"text":"ታን ነዉ ካዮታይ፤","poem":2},{"lineBreak":true},{"text":"ነ ታዉ ዳሮፐ አልኡዋ።","poem":2},{"lineBreak":true},{"text":"ኔን ታና ሲቅያ ሲቁ ማላልስያዋ፥","poem":2},{"lineBreak":true},{"text":"ማጫ አሳ ሲቁዋፐካ አደ ማላልስያዋ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“ዎልቃማቱ ዋን ኩንዴድኖሻ!","poem":1},{"text":"ኦላ ሚሻይካ ዋን ድፕ ጌደ!”","poem":2},"ያጊደ ዳዊተ ዝላሌዳ።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/2SA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/2SA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/1SA/31.json","previousChapterAudioLinks":{},"numberOfVerses":27}