{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"2SA","translationId":"dwr_ent","name":"2 ሳሜላ","commonName":"2 ሳሜላ","title":"ላኤን ሳሜላ ማጻፋ","order":10,"numberOfChapters":24,"sha256":"6010911f382273eb56b11dccd4050b3e85a280361c301e246aaf928c3859be3d","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/dwr_ent/2SA/24.json","totalNumberOfVerses":692},"chapter":{"number":22,"content":[{"type":"heading","content":["ዳዊተ ጾን ስሚደ የጼዳ የ"]},{"type":"verse","number":1,"content":["መና ጎዳይ አ ሞርከቱዋ ኡባ ኩሽያፐነ ሳኦላ ኩሽያፐ አሼዳ ጋላስ ዳዊተ መና ጎዳዉ ሀ የ የጼዳ።"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“መና ጎዳይ ታዉ ዎጋ ዛላ፤","poem":1},{"text":"ታን ኦላፐ ናገትያ ሚጻ፤","poem":2},{"text":"እ ታና አሽያዋ።","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ታ ጾሳይ ታን አኮ ባቃትያ ታ ዎጋ ዛላ።","poem":1},{"text":"እ ታ ጎንዳልያ፤","poem":2},{"text":"እ ታና አሽያ ዎልቃማ።","poem":1},{"text":"እ ታን ቆሰታ አትያ ሳኣ፤","poem":2},{"text":"እ ታና ማካላንቻ አሳቱዋፐ አሼ።","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ጋላታይ በስያ መና ጎዳ ታን ጼሳይ፤","poem":1},{"text":"እ ታ ሞርከቱዋፐ ታና አሼ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ሀይቁዋ ቤታይ ታ ሄራን ስርመቴ፤","poem":1},{"text":"ባሻይ ድኡዋዳን ታና ሙኬዳ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዱፉዋ ዎዶሩ ታና ቃቻና ሀኔ፤","poem":1},{"text":"ሀይቁ ጲርያዳን ታና ኦይቄዳ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታና መቱ ኢስና መና ጎዳ ጼሳድ፤","poem":1},{"text":"‘ታና ማዳ’ ጋደ ታ ጾሳዉ ዋሳድ።","poem":2},{"text":"እ ባረ ጌሻ ጎልያን ታ ኮሻ ስሴዳ፤","poem":1},{"text":"ታን ዋሴዳ ዋሱ አ ሀይን ዎዳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ጾሳይ ሀንቀቴዳ ድራዉ፥","poem":1},{"text":"ቢታይ ዪቂዪቂደ ቃጼዳ፤","poem":2},{"lineBreak":true},{"text":"ደረቱዋ ጻጱ ጋጅ ጋጅ ኮኮሬዳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አ ሲያፐ ሀንቁዋ ጩዋይ ጩዋቴዳ፤","poem":1},{"text":"አ ዶናፐ ምያ ታማ ላጩነ ጹግያ ቦንቁ ከሴዳ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሳሉዋ እ ጳልቂደ፥ ዱገ ዎዳ።","poem":1},{"text":"ሄ ዎደ አ ገድያፐ ጋርሳና መዳ ሻሪ ደኤ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ቀፍያና ደእያ ኪታንቻቱዋን፥","poem":1},{"text":"ክሩበቱዋን ኡቲደ ፓሌዳ፤","poem":2},{"lineBreak":true},{"text":"ጫርኩዋ ቀፍያ ቦላን ቤቴዳ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ባረና ማን ካሜዳ፤","poem":1},{"text":"አ ዱንካኒ እራና መዳ ሻርያ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አ ስንን ደእያ ዎልቃማ ፖኡዋፐ","poem":1},{"text":"ታማ ላጩ ከሴዳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ቃይ መና ጎዳይ ጉጉንዳን ሳሉዋፐ ጉሜዳ።","poem":1},{"text":"ኡባፐ ቂያ ጾሳይ ባረ ኮሻ ስሴዳ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ባረ ዎንዳፍያ አዳ የዲደ፥","poem":1},{"text":"ባረ ሞርከቱዋ ላሌዳ።","poem":2},{"text":"ዋልቃን ፖኡዋ ኪቲደ፥","poem":1},{"text":"ኡንቱንታ የደርሴዳ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"መና ጎዳይ ሴሬዳ ዎደነ፥","poem":1},{"text":"ሀንቀቲደ ፔኑቄዳ ዎደ፥","poem":2},{"text":"አባ ሃይ ግሴዳ ቢታይ በቴዳ።","poem":1},{"text":"ቃይ ሳኣ ባሱካ ቆንጬዳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“ጾሳይ ቦላፐ ኩሽያ ዱገ የዲደ፥ ታና ኦይቄዳ፤","poem":1},{"text":"ጪማ ሃፐ ታና ከሴዳ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እ ታና ታ ዎልቃማ ሞርክያፐነ","poem":1},{"text":"ታና እጽያዋንቱፐ አሼዳ፤","poem":2},{"lineBreak":true},{"text":"አያዉ ጎፐ፥ ኡንቱንቱ ታዉ ሎይ ዳሮ ዎልቃማ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ታ ዋይያ ጋላስ፥","poem":1},{"text":"ኡንቱንቱ ታ ቦላ ደንዴድኖ፤","poem":2},{"text":"ሽን መና ጎዳይ ታና ዘምፕስያዋ።","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"እ ታና አኮ ሳኣ ከሴዳ፤","poem":1},{"text":"ታናን ናሸቴዳ ድራዉ፥ ታና አሼዳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“ታ ጽሎተዳን መና ጎዳይ ታዉ ጭጌዳ፤","poem":1},{"text":"ታ ኩሽያ ጌሻተዳን እ ታዉ ዛሬዳ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ታን መና ጎዳ ኦግያ ካላድ፤","poem":1},{"text":"ታን ታ ጾሳ አጋደ ዎራ ባበይከ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ታን አ ህግያ ኡባ ናጋድ፤","poem":1},{"text":"አ ዎጋ ፖልያዋ አጋበይከ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ታን አ ስንን ሱረ ደኣድ፤","poem":1},{"text":"ታን ታና ናጋራፐ ናጋድ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ሄዋ ድራዉ፥ መና ጎዳይ ታዉ","poem":1},{"text":"ታ ጽሎተዳንነ ታ ጌሻተዳን ዛሬዳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“አቤት ጾሳዉ፥ አማነትያዋንቶ ኔን አማነትያዋ፤","poem":1},{"text":"ሱረቶ ኔንካ ሱረ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ጌሻቶ ኔንካ ጌሻ፤","poem":1},{"text":"ሽን ጌላቶ ኔን ጭንጫ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ባረንታ ዝቂስያዋንታ አሻሳ፤","poem":1},{"text":"ሽን ባረንታ ቂስያዋንታ ዝቂሳናዉ ኔን ኡንቱንታ ጼላሳ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"አቤት መና ጎዳዉ፥ ታ ጾምፒ ኔና፤","poem":1},{"text":"መና ጎዳይ ፖእስና፥ ታ ማይ ክቼ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ነ ማዱዋን ታን ታ ሞርከ ኦላንቻቱ ቦላ ዎራጃይ፤","poem":1},{"text":"ታ ጾሳን ታን ኡንቱንታ ሚጻ ጼራና ጉፓ አይ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ጾሳ ኦጊ ሱረ።","poem":1},{"text":"መና ጎዳ ቃላይ አማነትያዋ።","poem":2},{"text":"አኮ ባቃትያ ኡባቶ እ ጎንዳለ።","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"መና ጎዳፐ አትና፥ ሀራ ጾስ ባዋ፤","poem":1},{"text":"ኑ ጾሳፐ አትና፥","poem":2},{"lineBreak":true},{"text":"ሀራ ዎጋ ዛል ባዋ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ታዉ ዎልቃ እምያዌነ","poem":1},{"text":"ታ ኦግያ ሳሮ ኦያዌ","poem":2},{"text":"ጾሳቴ።","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"እ ታ ገድያ","poem":1},{"text":"ገንእያ ገድያዳን ምንሴ።","poem":2},{"text":"ታና ቃ ግሹዋን ሳሮተን ዎ።","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"እ ታ ኩሽያ ኦላ ሜዘዬ፤","poem":1},{"text":"ሄዋ ድራዉ፥ ታን ታ ቀስያን፥","poem":2},{"lineBreak":true},{"text":"ናሃስያ ግያ ብራታ ዎንዳፍያን ዳፋደ ዱካይ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"“ታና አሽያ ነ ጎንዳልያ","poem":1},{"text":"ኔን ታዉ እማዳ፤","poem":2},{"text":"ነ ሎኦ ኦካይ ታና ግታዬ።","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"ታን ሀመትያ ሳኣ አሳሳ፤","poem":1},{"text":"ሄዋ ድራዉ፥ ታ ገዲ ሀልጽቤና።","poem":2}]},{"type":"verse","number":38,"content":[{"text":"ታ ሞርከቱዋ ታን የደርሳደ መንሬድ፤","poem":1},{"text":"ታን ኡንቱንታ ይሰናን ደኣደ ጉየ ስማበይከ።","poem":2}]},{"type":"verse","number":39,"content":[{"text":"ታን ኡንቱንታ ላኤን ደንደናዳን ሾጫድ፤","poem":1},{"text":"ኡንቱንቱ ታ ገድያን ኩንዴድኖ።","poem":2}]},{"type":"verse","number":40,"content":[{"text":"ኦላዉ ታና ዎልቃ ዳንጭሳዳ፤","poem":1},{"text":"ታናና ጋዳትያዋንታ ታዉ ጉልባትሳዳ።","poem":2}]},{"type":"verse","number":41,"content":[{"text":"ታ ሞርከቱዋ ታ ስንፐ ጉየ ባቃትሳዳ፤","poem":1},{"text":"ታና እጽያዋንታ ታን ይሳድ።","poem":2}]},{"type":"verse","number":42,"content":[{"text":"ባረንታ ማድያዋ ኮዬድኖ፤","poem":1},{"text":"ሽን ኦንነ ኡንቱንታ አሽቤና።","poem":2},{"text":"መና ጎዳካ ኡንቱንቱ ጼሴድኖ፤","poem":1},{"text":"ሽን እ ኡንቱንቶ ኮይቤና።","poem":2}]},{"type":"verse","number":43,"content":[{"text":"ታን ኡንቱንታ ባናዳን ሊቅሳድ፤","poem":1},{"text":"ኦግያን ደእያ ኡርቃዳንካ ኡንቱንታ ድርጸሬደ የድ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"“ታ አሳ ማካላፐ ታና አሻዳ።","poem":1},{"text":"ካዉተቱዋ ቦላ ሱንደ፥ ታና ናጋዳ፤","poem":2},{"lineBreak":true},{"text":"ታን ኤረና አሳይ ታዉ ሞደቴዳ።","poem":2}]},{"type":"verse","number":45,"content":[{"text":"አላጋ ጋደ አሳይካ ታ ስንን ጉልባቴ።","poem":1},{"text":"ኡንቱንቱ ታ ዋርያ ስሲደ፥","poem":2},{"lineBreak":true},{"text":"ታዉ አዛዘቲኖ።","poem":2}]},{"type":"verse","number":46,"content":[{"text":"ኡንቱንቱ ዎዛና ካሃ ባዪኖ።","poem":1},{"text":"ባረንቱ ናገትያ ሚጻፐ ኮኮሪደ ዪኖ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“መና ጎዳይ ደኤ! ጾሳይ፥","poem":1},{"text":"ታ ዎጋ ዛላይ ጋላተቶ።","poem":2},{"text":"ጾሳይ፥ ታና አሽያ ዛላይ፥","poem":1},{"text":"ቁ ቁ ጎ።","poem":2}]},{"type":"verse","number":48,"content":[{"text":"እ ታ ሀሉዋ ከስያ ጾሳ፤","poem":1},{"text":"ካዉተቱዋ ታፐ ጋርሳና ዎያዋ።","poem":2}]},{"type":"verse","number":49,"content":[{"text":"ታ ሞርከቱዋፐ ታና ከስ አክያዋ።","poem":1},{"text":"አቤት ጾሳዉ፥ ኔን ታናና ጋዳትያዋንቱ ቦላን","poem":2},{"lineBreak":true},{"text":"ታና ቁ ቁ ኦሳ።","poem":2},{"lineBreak":true},{"text":"ማካላንቻ አሳቱዋፐ ኔን ታና አሻሳ።","poem":2}]},{"type":"verse","number":50,"content":[{"text":"ሄዋ ድራዉ፥ ታን","poem":1},{"text":"መና ጎዳ ካዉተቱዋ ግዶን ጋላታና፤","poem":2},{"lineBreak":true},{"text":"ታን ነ ሱንካ ሳባና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"“ጾሳይ ባረ ካትያዉ","poem":1},{"text":"ጾኑዋ ቦላን ጾኑዋ እሜ።","poem":2},{"text":"ባረ ኦኬዳዎ፥ ዳዊተዉነ አ ዘረዉ፥","poem":1},{"text":"አገና ሲቁዋ መናዉ በሰ”","poem":2},"ያጊደ የጼዳ።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}