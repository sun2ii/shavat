{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"EXO","translationId":"dwr_ent","name":"ከሳ","commonName":"ከሳ","title":"ከሳ ማጻፋ","order":2,"numberOfChapters":40,"sha256":"275304d4e6514b122f84a4709d323fa98b4a624d063425794c79771e575298c8","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/dwr_ent/EXO/40.json","totalNumberOfVerses":1208},"chapter":{"number":15,"content":[{"type":"heading","content":["ሙሴ የ"]},{"type":"verse","number":1,"content":["ሄ ዎደ ሙሴነ እስራኤልያ አሳይ ሀ የ መና ጎዳዉ የጼድኖ፤",{"text":"“ቦንቹዋን ሎይ ቁ ቁ ጌዳ ድራዉ፥","poem":1},{"text":"ታን መና ጎዳዉ ማዝሙርያ የጻና።","poem":2},{"lineBreak":true},{"text":"ፓራነ ፓራ ጋርያነ ቶጌዳዋንታ አባን ኦሌዳ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"መና ጎዳይ ታ ዎልቃነ ታ ማዝሙርያ፤","poem":1},{"text":"እ ታና አሽያዋ ግዴዳ።","poem":2},{"lineBreak":true},{"text":"እ ታ ጾሳ፤ ታን አ ሳባና።","poem":2},{"lineBreak":true},{"text":"እ ታ አዉዋ ጾሳ፤","poem":2},{"lineBreak":true},{"text":"ታን አ ቁ ቁ ኦና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"መና ጎዳይ ኤረቴዳ ኦላንቻ፤","poem":1},{"text":"አ ሱንይካ መና ጎዳ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ግብጼ ካትያ ፓራ ጋረቱዋነ","poem":1},{"text":"አ ኦላንቻቱዋ አባን ኦሌዳ።","poem":2},{"lineBreak":true},{"text":"ግብጼ ካትያ ካፓቱ፥","poem":2},{"lineBreak":true},{"text":"ኡባፐ አ ሎእያዋንቱ ዞኦ አባን ሙከቴድኖ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ጪሞ ሃይ ኡንቱንታ ካሜዳ፤","poem":1},{"text":"ኡንቱንቱ ሹቻዳን ጪሙዋን ምተቴድኖ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“አቤት መና ጎዳዉ፥ ነ ኡሸቻ ኩሺ","poem":1},{"text":"ዎልቃን ጎቤዳዋ፤","poem":2},{"lineBreak":true},{"text":"መና ጎዳዉ፥ ነ ኡሸቻ ኩሺ","poem":2},{"lineBreak":true},{"text":"ሞርክያ መንሬዳ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ነ ቦንቹዋ ግታተን","poem":1},{"text":"ኔናና ጋዳቴዳዋንታ ኦላዳ።","poem":2},{"lineBreak":true},{"text":"ነ ኤጽያ ሀንቁዋ ኔን የድና፥","poem":2},{"lineBreak":true},{"text":"እ ኡንቱንታ ዳላዳን ሜዳ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ነ ሲያና ከስያ ሸምፑዋን","poem":1},{"text":"ሃይ ዶረቴዳ።","poem":2},{"lineBreak":true},{"text":"ጎግያ ሃይካ ጎዳዳን ምን ኤቄዳ፤","poem":2},{"lineBreak":true},{"text":"ጪሞ ሃይ አባ ጎምፓን እርኪደ ምኔዳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ሞርኪ፥","poem":1},{"text":"‘ታን ኡንቱንታ የደርሳደ ኦይቃና።","poem":2},{"lineBreak":true},{"text":"ታን ኡንቱንቱ ማጹዋ ሻካደ፥","poem":2},{"lineBreak":true},{"text":"ታ ኮዬዳዋ ኡባ አካና።","poem":2},{"lineBreak":true},{"text":"ታን ታ ማሻ ሾዳደ፥","poem":2},{"lineBreak":true},{"text":"ኡንቱንታ ይሳና’ ያጊደ ጬቀቴዳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ሽን ነ ፔኑዋን ፑንና፥","poem":1},{"text":"አባይ ኡንቱንታ ካሜዳ።","poem":2},{"lineBreak":true},{"text":"ኡንቱንቱ ዎልቃማ ሃን","poem":2},{"lineBreak":true},{"text":"ብራታይ ምተትያዋዳን ምተቴድኖ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አቤት መና ጎዳዉ፥ ጾሳቱዋ ግዶን","poem":1},{"text":"ነ ማላይ ኦኔ?","poem":2},{"lineBreak":true},{"text":"ጌሻተን ቦንቼትያዌ፥","poem":2},{"lineBreak":true},{"text":"ቦንቹዋን ያየትያዌ፥","poem":2},{"lineBreak":true},{"text":"ማላልያባ ኦያዌ ነ ማላይ ኦኔ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኔን ነ ኡሸቻ ኩሽያ ምጭና፥","poem":1},{"text":"ቢታይ ኡንቱንታ ምቴዳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ኔን ዎዜዳ ነ አሳ","poem":1},{"text":"አገና ነ ሲቁዋን ካለዳ።","poem":2},{"lineBreak":true},{"text":"ኔን ነ ዎልቃን","poem":2},{"lineBreak":true},{"text":"ኡንቱንታ ኔን ደእያ ጌሻ ሳኣ ገልሳዳ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ካዉተቱ ሄዋ ስሲደ","poem":1},{"text":"ኮኮሬድኖ።","poem":2},{"lineBreak":true},{"text":"ፕልስጼማ ጋድያ አሳቱካ","poem":2},{"lineBreak":true},{"text":"የሉ ኦይቄዳዋዳን ኡንኤቴድኖ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሄ ዎደ ኤዶማ ጋደ ካፓቱ ዳጋሜድኖ።","poem":1},{"text":"ሞኣበ ጋድያ ሞድያዋንታ","poem":2},{"lineBreak":true},{"text":"ያሻይ ኮኮርሴዳ።","poem":2},{"lineBreak":true},{"text":"ካናነ አሳቱዋ ሸኒ ሀይቄዳ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አቤት መና ጎዳዉ ዳጋማይነ ያሻይ ኡንቱንታ ኦይቂና፥","poem":1},{"text":"ኡንቱንቱ ነ ዎልቃ ግታተ በኢደ፥","poem":2},{"lineBreak":true},{"text":"ነ አሳይ አና ጋካናዉ፥","poem":2},{"lineBreak":true},{"text":"ኔን ዎዜዳ አሳይ አና ጋካናዉ፥","poem":2},{"lineBreak":true},{"text":"ሹቻዳን ሙሚደ ኤቂኖ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አቤት መና ጎዳዉ ኔን ኡንቱንታ አሃደ፥","poem":1},{"text":"ነ ቡዞ ጋደን ደእያ ደርያ ሁጲያን ቶከቴዳ ምዳ ዎ።","poem":2},{"lineBreak":true},{"text":"ሄ ሳአይ","poem":2},{"lineBreak":true},{"text":"ኔን ነዉ ደአናዉ ኦዳ ሳኣ፥","poem":2},{"lineBreak":true},{"text":"ሄ ጌሻ ሳአይ ኔን ነ ኩሽያን ምንሳደ ኤሴዳ ሳኣ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"መና ጎዳይ መናፐ መናዉ ካዉታናዋ።”","poem":1}]},{"type":"verse","number":19,"content":["ግብጼ ካትያ ፓራቱ፥ አ ፓራ ጋረቱነ አ ፓራ አሳቱ አባን ገሌዳ ዎደ፥ መና ጎዳይ ኡንቱንቱ ቦላ አባ ሃ ጉየ ዛሪደ ኡንቱንቱ ቦላ አሄዳ፤ ሽን እስራኤላቱ አባ ግዱዋና መላ ቢታን ሀመቲደ ቤድኖ ያግ የጼድኖ።"]},{"type":"heading","content":["ማይራም የ"]},{"type":"verse","number":20,"content":["አሮና ምቻታ፥ ናባታ ማይራማ ዳርቢያ አካዱ፤ ማጫ አሳይ ኡባይ ዳርቢያ ባቂደነ የጺደ እዞ ካሌድኖ።"]},{"type":"verse","number":21,"content":["ማይራማ ኡንቱንቶ የ የጻደ፥",{"text":"“መና ጎዳይ ሎይ ቁ ቁ ጌዳ ድራዉ፥","poem":1},{"text":"አዉ የጽተ።","poem":2},{"text":"ፓራነ ፓራ ቶጌዳዋ","poem":1},{"text":"እ አባን ኦሌዳ” ያጋደ የጻዱ።","poem":2}]},{"type":"heading","content":["ጫምያ ሃነ ሎኦ ጮራ ፑልቱዋ"]},{"type":"verse","number":22,"content":["ሄዋፐ ጉይያን ሙሴ እስራኤልያ ዞኦ አባፐ ካለና፥ ኡንቱንቱ ሱር ጌተትያ መላ ቢታ ቤድኖ። ሄ መላ ቢታን ኡንቱንቱ ሃ ደመናን ሄዙ ጋላሳ ሀመቴድኖ።"]},{"type":"verse","number":23,"content":["ኡንቱንቱ ማራ ግያ ሳኣ ጋኬዳ ዎደ፥ ማራ ሃይ ጫሞ ግዴዳ ድራዉ፥ ኡሻናዉ ዳንዳይበይክኖ፤ ሄዋ ድራዉ፥ ሄ ሳአይ ማራ",{"noteId":4},"ጌተቴዳ።"]},{"type":"verse","number":24,"content":["ሄዋ ድራዉ፥ አሳይ፥ “ኑን አያ ኡሻኔ?” ያጊደ ሙሴ ቦላ ዙዙሜዳ።"]},{"type":"verse","number":25,"content":["ሙሴ መና ጎዳዉ ዋሴዳ፤ መና ጎዳይ አ እት ም በሴዳ፤ ሙሴ ሄ ም ሃ ግዶ ኦልና፥ ሃይ ማልኤዳ። መና ጎዳይ ኡንቱንቶ ካለሰትያ ዎጋ እሜዳ፤ ያን ጾሳይ ኡንቱንታ ፓጬዳ።"]},{"type":"verse","number":26,"content":["እ ኡንቱንታ ሀዋዳን ያጌዳ፤ “መና ጎዳይ ህንተንቱ ጾሳይ ኦድያዋ ምንሲደ ስሶፐነ አ አይፍያ ስንን ልከባ ኦፐ፥ ህንተንቱ አ አዛዙዋ ሀይዞፐነ አ ዎጋ ኡባ ናጎፐ፥ ታን ግብጼቱዋ ቦላ አሄዳ ሀርግያፐ እቱዋነ ህንተንቱ ቦላ አህከ፤ አያዉ ጎፐ፥ ታን ህንተንታ ፓያ መና ጎዳቴ” ያጌዳ።"]},{"type":"verse","number":27,"content":["ሄዋፐ ኡንቱንቱ ኤላማ ጋድያ ዬድኖ፤ ያን ታማነ ላኡ ሃ ፑልቶቱነ ላፑን ታሙ ዛምባ ምቱ ደኢኖ። ኡንቱንቱ ያን ሃ ዶናን ኡቴድኖ።"]}],"footnotes":[{"noteId":4,"caller":"+","text":"ማራ፦ ሀ ሱን ብለይ እብራዌዋን “ጫሙዋ” ግያዋ።","reference":{"chapter":15,"verse":23}}]},"thisChapterLink":"/api/dwr_ent/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}