{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"EZK","translationId":"dwr_ent","name":"ህዝቄላ","commonName":"ህዝቄላ","title":"ህዝቄላ ትምቢትያ","order":26,"numberOfChapters":48,"sha256":"d2ff826ec44418e558941ce21abef7c9de02ec49e9c1f4050e65f38a45459877","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/dwr_ent/EZK/48.json","totalNumberOfVerses":1268},"chapter":{"number":15,"content":[{"type":"heading","content":["ዎይንያ ቱራ ሌምሱዋ"]},{"type":"verse","number":1,"content":["መና ጎዳ ቃላይ ታኮ ሀዋዳን ያጊደ ዬዳ፤"]},{"type":"verse","number":2,"content":["“ላ አሳ ናአዉ፥ ዎይንያ አኑ ባዙዋን ደእያ ሀራ ምፐ አያን ኬኪ?"]},{"type":"verse","number":3,"content":["ጎአይ ደእያባ ኦናዉ አ አኑዋፐ ቃንጸት ኤሪ? አየንቶ ካቂያ ኮጫ አፐ ከሳ ኤራይ?"]},{"type":"verse","number":4,"content":["አ ኦይሰዋዳን ታማን የግና፥ ያ ባጋይነ ሀ ባጋይ ታማን ሜተትና፥ ግዱዋን አቴዳ ጺጹንይ አይ ማዳኔ?"]},{"type":"verse","number":5,"content":["ጹገተናን ደኢድ፥ ካሰ አየንቶ ማድቤናዌ፥ ታማይ ሚና ኤጽ ክቺደ አየንቶ ማደና።"]},{"type":"verse","number":6,"content":["“ሄዋ ድራዉ፥ ኡባ ሞድያ መና ጎዳይ ሀዋዳን ያጌ፤ ‘ታን ባዞ ም ግዶን ደእያ ዎይንያ አኑዋ ታማዉ ኦይሰ ኦደ እሜዳዋዳን፥ የሩሳላመን ደእያ አሳካ ሄዋዳን ኦና።"]},{"type":"verse","number":7,"content":["ታን ታ ሶምኡዋ ኡንቱንቱ ቦላን ዛራና። ኡንቱንቱ እት ታማፐ ከሶፐካ፥ ሀራ ታማይ ኡንቱንታ ማና። ታን ታ ሶምኡዋ ኡንቱንቱ ቦላ ዛርያ ዎደ፥ ታን መና ጎዳ ግድያዋ ህንተንቱ ኤራና።"]},{"type":"verse","number":8,"content":["ኡንቱንቱ ታናን አማነተናን አጌዳ ድራዉ፥ ታን ኡንቱንቱ ቢታ ኦና ከሳና። ታን ኡባ ሞድያ መና ጎዳይ ሀዋ ኦዳይ’ ያጌ” ያጊደ ዬዳ።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/EZK/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/EZK/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/EZK/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}