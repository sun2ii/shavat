{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"EZK","translationId":"dwr_ent","name":"ህዝቄላ","commonName":"ህዝቄላ","title":"ህዝቄላ ትምቢትያ","order":26,"numberOfChapters":48,"sha256":"d2ff826ec44418e558941ce21abef7c9de02ec49e9c1f4050e65f38a45459877","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/dwr_ent/EZK/48.json","totalNumberOfVerses":1268},"chapter":{"number":19,"content":[{"type":"heading","content":["እስራኤልያ ዳናቱዋ ዝላሳ"]},{"type":"verse","number":1,"content":["ጾሳይ ህዝቄላ፥ “እስራኤልያ ካፓቶ ሀዋዳን ያጋደ ዝላላ፤"]},{"type":"verse","number":2,"content":[{"text":"“ህንተ አታ ጋሞቱዋ ግዶን፥","poem":1},{"text":"እዛ አይባ ጋማቲ!","poem":2},{"text":"ያላጋ ጋሞቱዋ ግዶን ግሳደ፥","poem":1},{"text":"ባረ ማራቱዋ ድቻዱ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እዛ ባረ ማራቱዋፐ እቱዋ ድችና፥","poem":1},{"text":"ዎዳላ ጋሙዋ ከሴዳ።","poem":2},{"text":"እ ሻንካ ታማሪደ፥ አሳ ሜዳ።","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ካዉተቱ ኡባይ አባ ስሲደ፥","poem":1},{"text":"ኦላን ገሊደ ኦይቀቴዳ።","poem":2},{"text":"ኡንቱንቱ አ ማጋን ጎቺደ፥","poem":1},{"text":"ግብጼ ቢታ አፌድኖ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“አ አታ ናጎዌ ፖለተናን እጽና፥","poem":1},{"text":"ህዶታይ ዬዳዋ በኣደ፥","poem":2},{"lineBreak":true},{"text":"ባረ ማራቱዋፐ ላኤንዋ ድቻደ፥","poem":2},{"lineBreak":true},{"text":"ዎዳላ ጋሙዋ ከሳዱ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እ ዎዳላ ጋሙዋ ግዲደ፥","poem":1},{"text":"ሀራ ጋሞቱዋ ግዶን፥","poem":2},{"lineBreak":true},{"text":"ያነ ሃነ ስመረቴዳ።","poem":2},{"text":"እ ሻንካ ታማሪደ፥ አሳ ሜዳ።","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"እ ኡንቱንቱ ዎልቃማ ጌሱዋ መንሬደ፥","poem":1},{"text":"ካታማካ ባይዜዳ።","poem":2},{"text":"ቢታይነ ቢታን ደእያ አሳይ ኡባይ፥","poem":1},{"text":"አ ጉደን ሻቢረቴዳ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዩሹዋን ደእያ ካዉተቱ ኡባይ፥","poem":1},{"text":"አ ኦይቃናዉ ጲርያ የጌድኖ።","poem":2},{"text":"ባረንቱ ግትያካ ምጬድኖ፤","poem":1},{"text":"ባረንቱ ኦላን አ ኦይቄድኖ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኡንቱንቱ ባረንቱ ማጋን አ ጎቺደ፥","poem":1},{"text":"ኮዳን ጊጌዳ ጉ ጎልያን የጊደ፥","poem":2},{"text":"ባብሎነ ካትያኮ አፌድኖ።","poem":1},{"text":"ላኤን አ ጉደይ እስራኤልያ ደረቱዋን ስሰተናዳን፥","poem":2},{"lineBreak":true},{"text":"ኡንቱንቱ አ ቃሾ ጎልያ ገልሴድኖ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘ነ አታ ሃ ዶናን፥","poem":1},{"text":"ቶከቴዳ ዎይንያ ቱራ ማላ።","poem":2},{"text":"ዳሮ ሃይ ደእያ ድራዉ፥","poem":1},{"text":"ሄ ዎይንያ ቱራይ አይፍያ ዳርጻጽ ኡቴዳ፤","poem":2},{"lineBreak":true},{"text":"ቃይ ዳሮ ዳሻና ደኤ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አ ማራቱዋፐ ምንያዌ፥","poem":1},{"text":"ሞድያዋንቱ ጻምኣ ግዴዳ።","poem":2},{"text":"አ ማራይ ዎልቃማ ማራቱዋፐ አዱቂደ፥","poem":1},{"text":"ቦላዉ አዳ።","poem":2},{"text":"ባረ ማራቱዋ ጮራተንነ","poem":1},{"text":"ቃተን ቦላና ቤቴዳ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሽን ሄ ቱራይ ሀንቁዋን ሾደቲደ፥","poem":1},{"text":"ቢታን ኦለቴዳ።","poem":2},{"text":"አዋይ ዶልያ ጫርኩ አ አይፍያ መልስና ቆቆፈቴዳ፤","poem":1},{"text":"አ ምኖ ታሺ መልና፥ ታማይ ሜዳ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሀእ ቃይ እ ሃ ባይና፥","poem":1},{"text":"መላ ቢታን ቶከቴዳ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታማይ አ ማራቱዋፐ እቱዋ ኦይቂደ፥","poem":1},{"text":"አ አይፍያናካ ድፕ ኦደ ሜዳ።","poem":2},{"text":"ያትና፥ ካዉተ ጻምኣ ግድያ፥","poem":1},{"text":"አይ ምኖ ማራይካ አ ቦላን አትቤና።","poem":2},"“ ‘ሀዌ ዬኩዋ ዝላሳ፤ ሀዋ ዝላሳዳን ጎኤታናዉ በሴ’ ያጋ” ያጌዳ።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}