er":26,"content":[{"text":"ነ አዉዋ አንጁ በን ደረቱዋ አንጁዋፐካ","poem":1},{"text":"መናፐ ደእያ አንጁዋፐካ አ።","poem":2},{"lineBreak":true},{"text":"ሀዌ ኡባይ ዮሴፎ ሁጲያን፥","poem":2},{"lineBreak":true},{"text":"ባረ እሻቱዋ ግዱዋን ካፑዋ ግድያዋ ሊጲያን ሸምፖ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ቢንያመ ቦንቂያ ዋልያ።","poem":1},{"text":"ባረ ሻንካቴዳዋ ዎንታ ሜ፤","poem":2},{"lineBreak":true},{"text":"ባረ ኦሞዴዳዋ ኦማርስ ሻኬ” ያጌዳ።","poem":2}]},{"type":"verse","number":28,"content":["ሀዋንቱ ታማነ ላኡ እስራኤልያ ዛራቱዋ፤ ቃይ ኡንቱንቱ አዉ ኡንቱንታ ሁጲያን ሁጲያን ኡንቱንቶ በስያ አንጁዋ አንጂደ ኡንቱንቶ ጌዳዌ ሀዋ።"]},{"type":"heading","content":["ያቆባ ሀይቁዋ"]},{"type":"verse","number":29,"content":["ሄዋፐ ጉየ፥ እ ኡንቱንታ ሀዋዳን ያጊደ አዛዜዳ፤ “ታን ታ ማይዛ አሳቱዋን ጋከታናዉ ሀናይ፤ ታና ሂትያ ኤፍሮና ጋደን ደእያ ጎንጎሉዋን፥ ታ አዎቱዋና ሞግተ።"]},{"type":"verse","number":30,"content":["ሄዌካ ካናነ ቢታን፥ ማምረ ማታን ደእያ፥ ማክጴላ ግያ ጎንጎሉዋ፤ ሄዌ አብራሃመ ሂትያ ኤፍሮናፐ አ ጋድያና ሻሜዳ ጎንጎሉዋ።"]},{"type":"verse","number":31,"content":["አብራሃመነ አ ማቻታ ሳራ ያን ሞገቴድኖ፤ ይሳቅነ አ ማቻታ ርብቃ ያን ሞገቴድኖ፤ ታን ቃይ ልዮ ያን ሞጋድ።"]},{"type":"verse","number":32,"content":["ሄ ጋዲነ አን ደእያ ጎንጎሉ ሂተቱዋፐ ሻመቴዳዋ” ያጌዳ።"]},{"type":"verse","number":33,"content":["ያቆብ ባረ ናናዉ አዛዙዋ ዉርሴዳ ዎደ፥ ባረ ገድያ ፑደ ባረ ሂጻዉ ሺሽ አኪደ፥ ሀይቂ አጌዳ፤ ባረ ማይዛን ጋከቴዳ።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}