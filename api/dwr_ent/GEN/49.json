{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"GEN","translationId":"dwr_ent","name":"ዶመ","commonName":"ዶመ","title":"ዶመ ማጻፋ","order":1,"numberOfChapters":50,"sha256":"bc041dfccee1abef95950a130624ebaceedb60a1b95d13f557ddd816cf317965","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/dwr_ent/GEN/50.json","totalNumberOfVerses":1508},"chapter":{"number":49,"content":[{"type":"heading","content":["ያቆብ ባረ ናና አንጄዳ"]},{"type":"verse","number":1,"content":["ሄዋፐ ጉየ፥ ያቆብ ባረ አቱማ ናና ጼስሲደ ሀዋዳን ያጌዳ፤ “ስንፐ ህንተንቶ ሀናናባ ታን ህንተንቶ ኦዳና ማላ ሺቅተ።”"]},{"type":"verse","number":2,"content":[{"text":"“ህንተንቶ ያቆባ ናናቶ፥","poem":1},{"text":"እትፐ ሺቂደ ስስተ፤","poem":2},{"lineBreak":true},{"text":"ህንተንቱ አዉ እስራኤሊ ህንተንቶ ኦድያዋ ሀይዝተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“ሮቤላ፥ ታ ባይራ ናአዉ፥","poem":1},{"text":"ኔን ታ ዎልቃ፤","poem":2},{"lineBreak":true},{"text":"ታ ምኖተዉ ኮይሩዋ።","poem":2},{"lineBreak":true},{"text":"ኔን ቦንቹዋንካ ዎልቃንካ ኡባፐ አያዋ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኔን ድኡዋ ማላ፤ ኤቆሳአን ደአካ፤","poem":1},{"text":"ኔን ኡባፐ አያዋ ግዳካ።","poem":2},{"lineBreak":true},{"text":"አያዉ ጎፐ፥ ኔን ነ አዉዋ ግሱዋ ከሳዳ፤","poem":2},{"lineBreak":true},{"text":"ነ አዉዋ ግሱዋ ቱንሳዳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ስሞንነ ሌዊ እሻቱዋ፤","poem":1},{"text":"ኡንቱንቱ ማሻይ ማካላተዉ ኦላ ሚሻ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታን ኡንቱንቱ ዞረታን ገልከ፤","poem":1},{"text":"ታን ኡንቱንቱ ሺቁዋንካ ኡትከ፤","poem":2},{"lineBreak":true},{"text":"አያዉ ጎፐ፥ ኡንቱንቱ ባረንቱ ሀንቁዋን","poem":2},{"lineBreak":true},{"text":"አሳ ዎድኖ ባረና አካ አካ ጊና፥","poem":2},{"text":"ቦራቱዋ ቃንጼድኖ።","poem":3}]},{"type":"verse","number":7,"content":[{"text":"ኡንቱንቱ ሱሎ ሀንቁ","poem":1},{"text":"ኡንቱንቱ መቀ ኢታተይነ ሸቀቴዳዋ ግዶ!","poem":2},{"lineBreak":true},{"text":"ታን ኡንቱንታ ያቆባ አሳ ግዱዋን ላላና፤","poem":2},{"lineBreak":true},{"text":"እስራኤልያ ቢታን ትስክ ኦና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ይሁዳዉ፥ ነ እሻቱ ኔና ጋላታና።","poem":1},{"text":"ነ ኩሺ ነ ሞርከቱዋ ፕላንትያ ኦይቃና።","poem":2},{"lineBreak":true},{"text":"ነ አዉዋ ናናይ ነዉ ሆኪደ ጎይናና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ይሁዳዉ፥ ኔን ዎዳላ ጋሞ።","poem":1},{"text":"ታ ናአዉ፥ ኔን ሻንካፐ ዎ ስሚደ፥","poem":2},{"lineBreak":true},{"text":"ጮጎቲደ ግሴዳ ጋሙዋ ማላ።","poem":2},{"lineBreak":true},{"text":"ኔን አሳ ቦሸረናዉ ኮየና ማጫ ጋማት ማላ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አይስያዌ ያና ጋካናዉ፥","poem":1},{"text":"ካዉተ ጻምአይ ይሁዳፐ፥","poem":2},{"lineBreak":true},{"text":"ደርያ አይስያዋንቱ ጋትማይ አ ገድያ ግዶፐ ሻከተና።","poem":2},{"lineBreak":true},{"text":"ቃይ ደርያ አሳይ አዉ አዛዘታና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እ ባረ ሀርያ ዎይንያ አኑዋን፥","poem":1},{"text":"ባረ ሀረ ማራ ሙሩታ ዎይንያ ቱራን ቃቻና።","poem":2},{"lineBreak":true},{"text":"እ ባረ አፍላ ዎይንያ ኤሳን፥","poem":2},{"lineBreak":true},{"text":"ባረ ማዩዋ ሱ ማላትያ ዎይንያ ኤሳን ሜጫና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አ አይፊ ዎይንያ ኤሳፐ አ ዞአና፤","poem":1},{"text":"አ አቻይካ ማፐ አ ቦጻና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ዛብሎነ አባ ዶናን ደአና፤","poem":1},{"text":"እ አባ ዶናን ማርካባቱ ኤቂያ ሳኣ ግዳና፤","poem":2},{"lineBreak":true},{"text":"አ ዛዋይ ሲዶና ጋካናዋ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ይሳኮረ ምኖ ሀርያ፤","poem":1},{"text":"ጫንያ ላኡ ዶንያቱዋ ግዱዋን ግስ ባሼ","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እ ባረ ሸምፕያሳ ሎአ ግድያዋነ","poem":1},{"text":"ባረ ቢታይ ናሸችያ