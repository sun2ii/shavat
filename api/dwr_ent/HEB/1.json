{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"HEB","translationId":"dwr_ent","name":"እብራዌ","commonName":"እብራዌ","title":"እብራዌ አሳዉ ጻፈቴዳ ኪታ","order":58,"numberOfChapters":13,"sha256":"496ea60163063049e1ed0a21ecedfa9a57ec4ff3de448509f301d79b08a1af8e","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/dwr_ent/HEB/13.json","totalNumberOfVerses":298},"chapter":{"number":1,"content":[{"type":"heading","content":["ጾሳይ ባረ ናኣ ባጋና ሃሳዬዳ"]},{"type":"verse","number":1,"content":["ጾሳይ በን ዎደ፥ ኑ አዎቱ ናባቱዋ ባጋና ዱማ ዱማ ኦግያንነ ዳሮ ዎድያን ሃሳዬዳ።"]},{"type":"verse","number":2,"content":["ሽን ሀ ዉርሰ ዎድያን፥ ኡባባ አ ላትሲደ፥ የለታ አ ባጋና መዳ ባረ ናኣ ባጋና ኑዉ ሃሳዬዳ።"]},{"type":"verse","number":3,"content":["ናአይ ጾሳ ቦንቾ ፖኡዋ ጶሌ፤ ቃይ ኩመን ጾሳ ኤሻ አኪደ፥ ባረ ዎልቃማ ቃላን ሀ ሳኣ ናጌ፤ ያቲደ አሳ ናጋራፐ ጌሺደ፥ ኡባፐ ቦላ ጾሳፐ ኡሸቻ ባጋና",{"noteId":0},"ሳሉዋን ኡቴዳ።"]},{"type":"heading","content":["ጾሳ ናአይ ኪታንቻቱዋፐ ቦላ"]},{"type":"verse","number":4,"content":["ጾሳይ አዉ እሜዳ ሱንተይ ኪታንቻቱዋፐ ቃ ግድያዋዳንካ፥ ኡንቱንቱፐ አ ሎይ ቁ ኦዳ።"]},{"type":"verse","number":5,"content":["አያዉ ጎፐ፥ ጾሳይ ባረ ኪታንቻቱዋፐ ኦና፥",{"text":"“ኔን ታ ናኣ፤","poem":1},{"text":"ታን ሀቼ ነዉ አዉዋ ግዳድ”","poem":2},"ጌዴ? ዎይ ቃይ ኦና፥",{"text":"“ታን አዉ አዉዋ ግዳና፤","poem":1},{"text":"እካ ታዉ ናኣ ግዳና”","poem":2},"ጌዴ?"]},{"type":"verse","number":6,"content":["ቃይ ጾሳይ ባረ ባይራ ናኣ ሀ ሳኣ የዳና ሀኒደ፥",{"text":"“ታ ኪታንቻቱዋ ኡባቱካ አዉ ጎይንኖ”","poem":1},"ያጌዳ።"]},{"type":"verse","number":7,"content":["ጸሳይ ኪታንቻቱዋባ ሃሳዪደ፥",{"text":"“ታን ታ ኪታንቻቱዋ ጫርኩዋ ከሳይ፤","poem":1},{"text":"ቃይ ታ ኦሳንቻቱዋካ ታማ ላጩዋ ከሳይ”","poem":2},"ያጌ።"]},{"type":"verse","number":8,"content":["ሽን ባረ ናኣዋ ሃሳዪደ፥",{"text":"“ጾሳዉ፥ ነ ካዉተ ኦይዲ፥","poem":1},{"text":"መ መናዉ ደኤ።","poem":2},{"text":"ነ ካዉተ ጽሎተን አሃሳ።","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ኔን ጽሎተ ሲቃደ፤","poem":1},{"text":"ናቁዋ እጻዳ።","poem":2},{"text":"ጾሳይ፥ ነ ጾሳይ ኔና፥","poem":1},{"text":"ነ ላገቱዋፐ አደ፥","poem":2},{"lineBreak":true},{"text":"ናሸቻን እልልስያ ዛይትያ ኦኬዳዌ ሀዋሳ”","poem":2},"ያጌ።"]},{"type":"verse","number":10,"content":["ጾሳይ ሀዋዳን ያጌ፤",{"text":"“ጎዳዉ፥ ኮይሮ ኔን ሳኣ መዳ፤","poem":1},{"text":"ሳሉዋካ ነ ኩሽያን መዳ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሄዋንቱ ኡባይ ያና፤","poem":1},{"text":"ሽን ኔን ደአና።","poem":2},{"text":"ኡንቱንቱ ኡባይካ አፍላዳን ዉራና።","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ኔን ኡንቱንታ ጋብያዳን ዳኮያና፤","poem":1},{"text":"ቃይ ኡንቱንቱ አፍላዳን ላመታናዋንታ።","poem":2},{"text":"ሽን ኔን ኔናካ፤","poem":1},{"text":"ነ ላይይ ኡባካ ዉረና”","poem":2},"ያጌ።"]},{"type":"verse","number":13,"content":["ሽን ጾሳይ ባረ ኪታንቻቱዋፐ እቱዋነ፥",{"text":"“ታን ነ ሞርከቱዋ ኔን","poem":1},{"text":"ገድያን የያዋ ኦና ጋካናዉ፥","poem":2},{"lineBreak":true},{"text":"ሀዋን ታፐ ኡሸቻ ባጋን ኡታ”","poem":2},"ግቤና።"]},{"type":"verse","number":14,"content":["ኪታንቻቱ ኡባይ ጾሳዉ ኦናዉነ አቶተ ደማና አሳቱዋ ማዳናዉ ጾሳይ ኪቴዳ አያናቱዋ ግድክኖዬ?"]}],"footnotes":[{"noteId":0,"caller":"+","text":"ኡሸቻ ባጋና፦ ቦንቹዋነ ዎልቃሳ ግድያዋ በሴ።","reference":{"chapter":1,"verse":3}}]},"thisChapterLink":"/api/dwr_ent/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}