{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"HEB","translationId":"dwr_ent","name":"እብራዌ","commonName":"እብራዌ","title":"እብራዌ አሳዉ ጻፈቴዳ ኪታ","order":58,"numberOfChapters":13,"sha256":"496ea60163063049e1ed0a21ecedfa9a57ec4ff3de448509f301d79b08a1af8e","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/dwr_ent/HEB/13.json","totalNumberOfVerses":298},"chapter":{"number":3,"content":[{"type":"heading","content":["የሱስ ሙሴፐ ቦላ"]},{"type":"verse","number":1,"content":["ሄዋ ድራዉ፥ ጾሳይ ጼሴዳ ጌሻ እሻቶ፥ ኑ ማርካተ ጾሳይ ኪቴዳዋ ቄሳቱዋ ኡባቱዋ ካፑዋ፥ የሱስ ክርስቶሳ ቆፕተ።"]},{"type":"verse","number":2,"content":["ሙሴ ባረ ኪታን ጾሳ ጎልያ ኡባን አማነቴዳዋ ግዴዳዋዳን፥ የሱስካ ባረና ዶሪደ፥ ሀ ኦሶ የዴዳ ጾሳዉ አማነቴዳዋ።"]},{"type":"verse","number":3,"content":["አያዉ ጎፐ፥ ኬጸትያ ጎልያፐ ኬጽያ ብታኒ ቦንቼትያዋዳን፥ ሙሴዋፐ አያ ቦንቹዋ እ አካናዉ በስያዌ ኤረቴዳዋ።"]},{"type":"verse","number":4,"content":["አያዉ ጎፐ፥ ጎልያ ኡባ ኬጼዳዌ እት አሳ፤ ሽን ኡባባ ኬጼዳዌ ጾሳ።"]},{"type":"verse","number":5,"content":["ሙሴ ጾሳ ጎልያ ኡባን አማነቴዳ ኦሳንቻ ግዲደ፥ ጾሳይ ስንፐ ጋናዋ ማርካቴዳ።"]},{"type":"verse","number":6,"content":["ሽን ክርስቶስ ጾሳ ጎለን ናኣዳን አማነቴዳዋ፤ ኑን አካና ጊደ ናሸቻን ናግያዋ ጻላተንነ አማኑዋን ናጎፐ፥ ጾሳዉ ጎልያ ግዴቶ።"]},{"type":"heading","content":["ጾሳ አሳይ ሸምፑዋ ደማና"]},{"type":"verse","number":7,"content":["ሄዋ ድራዉ፥ ጌሻ አያናይ ሀዋዳን ያጌ፤",{"text":"“ጾሳ ቃላ ህንተንቱ ሀቼ ስስያባ ግዶፐ፥","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ህንተንቱ አዎቱ ታዉ እጽ ማካሊደ፥","poem":1},{"text":"ኦይታሙ ላይ ታ ኦሱዋ በኤዳ ባዙዋ ፓጭያ ጋላሳዳን፥","poem":2},{"lineBreak":true},{"text":"ህንተንቱካ ዞርያ አከናን እጾፕተ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሄዋ ድራዉ፥ ታን፥","poem":1},{"text":"ሄ አሳ ሀንቀታደ፥","poem":2},{"text":"‘ኡንቱንቱ ኡባ ዎደ ባረንቱ ዎዛናን ባሊኖ።","poem":1},{"text":"ታ ኦግያካ ኤርበይክኖ’ ያጋድ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሄዋዳንካ ቃይ፥","poem":1},{"text":"ታን ሀንቀታ ጫቃደ፥","poem":2},{"text":"‘ታን ሸምፕያ ሳ ኡንቱንቱ፥","poem":1},{"text":"ኡባካ ገልክኖ’ ያጋድ”","poem":2},"ያጌ።"]},{"type":"verse","number":12,"content":["ታናዳን አማንያዋንቶ፥ ደኡዋ ጾሳፐ ህንተንታ ሻክያ ኢታ አማነና ዎዛናይ ህንተናን ኦናንነ ደኤና ማላ ናገትተ።"]},{"type":"verse","number":13,"content":["ሽን ጾሳይ ህንተንታ ኡባ ጋላስ ሀቼ ጊደ ጼስሽን፥ ህንተፐ ኦናነ ናጋራይ ባለና፥ ዞርያ አከናን እጸና ማላ፥ እቱ እቱዋ ዞርተ።"]},{"type":"verse","number":14,"content":["አያዉ ጎፐ፥ ኑን ኮይሮ ኑዉ ደእያ አማኑዋ ዉርሰይ ጋካናዉ ሎይ ናጎፐ፥ ክርስቶሳና እትፐ ሻካና።"]},{"type":"verse","number":15,"content":["ጾሳ ማጻፋይ፥",{"text":"“ጾሳ ቃላ ህንተንቱ፥","poem":1},{"text":"ሀቼ ስስያዋ ግዶፐ፥","poem":2},{"lineBreak":true},{"text":"ሄ ዎደ ኡንቱንቱ እጽ ማካሌዳዋዳን፥","poem":2},{"lineBreak":true},{"text":"ዞርያ አከናን እጾፕተ”","poem":2},"ያጌዳ።"]},{"type":"verse","number":16,"content":["ጾሳይ ግያዋ ስሲደ፥ አዉ ማካሌዳ አሳቱ ኦኔ? ሙሴ ግብጼፐ ካለና ከሴዳ ኡባቱዋ ግድክኖዬ?"]},{"type":"verse","number":17,"content":["ጾሳይ ኦይታሙ ላይ ኦናን ሀንቀቴዴ? አሃይ ዎራን አቴዳ አሳቱዋ፥ ናጋራ ኦዳዋንታ ግድክኖዬ?"]},{"type":"verse","number":18,"content":["ቃይ ጾሳይ ባረዉ አዛዘተናን እጼዳዋንቱ እ ሸምፕያ ሳኣ ኡባካ ገለና ማላ፥ ኡንቱንቶ ጫቄዳዋፐ አትን፥ ኦስ ጫቄዴ?"]},{"type":"verse","number":19,"content":["ኡንቱንቱ አማንቤና ድራዉ፥ ሸምፕያ ሳ ገላናዉ ዳንዳይቤናዋ ኑን በኤቶ።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/HEB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/HEB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/HEB/2.json","previousChapterAudioLinks":{},"numberOfVerses":18}