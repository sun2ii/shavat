{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"HEB","translationId":"dwr_ent","name":"እብራዌ","commonName":"እብራዌ","title":"እብራዌ አሳዉ ጻፈቴዳ ኪታ","order":58,"numberOfChapters":13,"sha256":"496ea60163063049e1ed0a21ecedfa9a57ec4ff3de448509f301d79b08a1af8e","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/dwr_ent/HEB/13.json","totalNumberOfVerses":298},"chapter":{"number":8,"content":[{"type":"heading","content":["የሱስ ኦራ ቃላ ጫቁዋ ቄሳቱዋ ኡባቱዋ ካፑዋ"]},{"type":"verse","number":1,"content":["ኑን ሃሳይያ ዎልቃማባይ ሀዋ፤ ሳሉዋን ኡባፐ ቦላ ጾሳይ ኡትያ ካዉተ ኦይድያፐ ኡሸቻ ባጋና ኡቴዳ ቄሳቱዋ ኡባቱዋ ካፑ፥ ሀዋ ማላይ ኑዉ ደኤ።"]},{"type":"verse","number":2,"content":["ጌሻ ሳኣንነ ቱሙ ዱንካንያን እ ኦ፤ ሄ ዱንካኒ አሳይ ኤሴዳዋ ግደናን፥ ጾሳይ ኤሴዳዋ።"]},{"type":"verse","number":3,"content":["ቄሳቱዋ ኡባቱዋ ካፑ ኡባይ እሙዋነ ያርሹዋ ጾሳዉ እማናዉ ሱንቴዳ ድራዉ፥ ሀ ቄሳቱዋ ኡባቱዋ ካፖካ ያርሻናዉ እትባይ ደአናዉ ኮሼ።"]},{"type":"verse","number":4,"content":["ስም ሳኣን እ ደእያዋ ግዶፐ፥ ኡባካ ቄሳ ግደና፤ አያዉ ጎፐ፥ ህጊ አዛዝያዋዳን፥ እሙዋ እምያ ቄሳቱ ደኢኖ።"]},{"type":"verse","number":5,"content":["ኡንቱንቱ ቄሳቱዋዳን ኦያ ኪታይ ሳሉዋን ደእያ ኦሶ ቱሙ ሌምሱዋነ ኤሹዋ፤ አያዉ ጎፐ፥ ሙሴ ዱንካንያ ኤሳና ሀንሽን፥ ጾሳይ አ፥ “አኬካ፤ ኡባባካ ታን ኔና ደርያ ሁጲያን በሴዳ ሌምሱዋ ካላደ ኦ” ያጌዳ።"]},{"type":"verse","number":6,"content":["ሽን የሱስ ጋናትያ ጫቁ ካሰዋፐ አያዋዳንካ፥ አዉ እመቴዳ ኦሱካ ኡንቱንቱዋፐ አ፤ አያዉ ጎፐ፥ ሄ ጫቁ ጾሳይ እማና ጌዳ ኡባፐ አያ ኪታን ኦሰቴዳ።"]},{"type":"verse","number":7,"content":["አያዉ ጎፐ፥ ኮይሮ ጫቁዋን ባላይ ባይናዋ ግድንቶ፥ ላኤን ጫቁዋ ኮሸና።"]},{"type":"verse","number":8,"content":["ሽን ኡንቱንታ ቦሪደ፥ ጎዳይ ሀዋዳን ያጌ፤",{"text":"“ታን እስራኤልያ አሳናነ ይሁዳ አሳና፥","poem":1},{"text":"ኦራ ጫቁዋ ጫቀትያ ጋላሳቱ ያናዋ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሄ ጫቁ ታን ግብጼ ጋድያፐ፥","poem":1},{"text":"ኡንቱንቱ አዎቱዋ ኩሽያ ኦይቃደ፥ ጎቻ ከሴዳ ዎደ፥","poem":2},{"lineBreak":true},{"text":"ኡንቱንቱና ጫቀቴዳ ጫቁዋ ማላ ግደና።","poem":2},{"lineBreak":true},{"text":"ኡንቱንቱ ታ ጫቁዋን አማነትቤና ድራዉ፥","poem":2},{"lineBreak":true},{"text":"ታንካ ኡንቱንታ አጋድ።","poem":2},{"lineBreak":true},{"text":"ታን፥ ጎዳይ፥ ሀዋ ኦዳይ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አያዉ ጎፐ፥ ሄ ጋላሳቱዋፐ ጉይያን፥","poem":1},{"text":"ታን እስራኤልያ አሳና ጫቀታና ጫቁ ሀዋ:","poem":2},{"text":"ታን ታ ህግያ ኡንቱንቱ ቆፋን ዎና፤","poem":1},{"text":"ቃይ ኡንቱንቱ ዎዛናንካ ጻፋና።","poem":2},{"text":"ታን ኡንቱንቱ ጾሳ ግዳና፤ ኡንቱንቱካ ታ አሳ ግዳና።","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ኡንቱንቱፐ ኦንነ ባረ ሾሩዋ፥","poem":1},{"text":"ዎይ ባረ እሻ፥","poem":2},{"text":"‘ጎዳ ኤራ’ ያጊደ ታማርሰና።","poem":1},{"text":"አያዉ ጎፐ፥ ኡንቱንቱ ናኣፐ ጭማ ጋካናዉ ኡባይ ታና ኤሪኖ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታን ኡንቱንቱ ናቁዋ ማራና፤","poem":1},{"text":"ኡንቱንቱ ናጋራካ ላኤን ሀሳይከ”","poem":2},"ያጌ።"]},{"type":"verse","number":13,"content":["ጾሳይ ኦራ ጫቁዋ ጊደ ሃሳይያዋን ኮይሮዋ ኤጭሴዳ፤ ቃይ ኤጭያባይነ ዉርያባይ ኤለካ ያና።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/HEB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/HEB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/HEB/7.json","previousChapterAudioLinks":{},"numberOfVerses":13}