{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"ISA","translationId":"dwr_ent","name":"ኢስያሳ","commonName":"ኢስያሳ","title":"ኢስያሳ ትምቢትያ","order":23,"numberOfChapters":66,"sha256":"4745157233cad82b9b94b6332c06d7ec004e6d9dae863238e1ec8a8adf00b4c6","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/dwr_ent/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":12,"content":[{"type":"heading","content":["ጋላታ የ"]},{"type":"verse","number":1,"content":["ሄ ዎደ ህንተ ሀዋዳን ያጋና፦",{"lineBreak":true},{"text":"“አቤት መና ጎዳዉ፥ ኔን ታና ሀንቀታዳ፤","poem":1},{"text":"ሀንቁዋፐካ ስማዳ፤","poem":2},{"lineBreak":true},{"text":"ያታደ ታና ምንዳ።","poem":2},{"lineBreak":true},{"text":"ሄዋ ድራዉ፥ ታን ኔና ጋላታይ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“በእተ፥ መና ጎዳይ ታ አቶተ፤","poem":1},{"text":"ታን አን አማነታደ፥ ያይከ።","poem":2},{"text":"አያዉ ጎፐ፥ መና ጎዳይ፥","poem":1},{"text":"ታዉ ዎልቃነ የ።","poem":2},{"text":"እ ታ አቶተ ግዴዳ”","poem":1},"ያጋና።"]},{"type":"verse","number":3,"content":["አሽያ ፑልቶቱዋፐ ሃ ህንተ ናሸቻን ዱቃና።"]},{"type":"verse","number":4,"content":["ሄ ጋላስ ቃይ ህንተ ሀዋዳን ያጋና፦",{"lineBreak":true},{"text":"“መና ጎዳ ጋላትተ!","poem":1},{"text":"አ ሱንካ ጼስተ።","poem":2},{"text":"አ ኦሶቱዋ ካዉተቱዋ ኡባ ግዶን ኤርስተ።","poem":1},{"text":"አ ሱንይ ቁ ቁ ጌዳዋ አዋይተ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"መና ጎዳይ ዎልቃማ ኦሱዋ ኦዳ ድራዉ፥","poem":1},{"text":"አዉ የጽተ።","poem":2},{"text":"ሀዌ ሳኣ ኡባን ኤ