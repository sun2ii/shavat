{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"ISA","translationId":"dwr_ent","name":"ኢስያሳ","commonName":"ኢስያሳ","title":"ኢስያሳ ትምቢትያ","order":23,"numberOfChapters":66,"sha256":"4745157233cad82b9b94b6332c06d7ec004e6d9dae863238e1ec8a8adf00b4c6","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/dwr_ent/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":20,"content":[{"type":"heading","content":["ግብጼ ቦላነ ቶጵያ ቦላ ኦደቴዳ ትምቢትያ"]},{"type":"verse","number":1,"content":["አሶረ ጋድያ ካቲ ሳርጎን ኪቴዳ ኦላ ጋዳዋይ ዪደ፥ አሽዶዳ ግያ ፕልስጼማ ካታማ ኦሊደ ኦይቄዳ ላይ፥"]},{"type":"verse","number":2,"content":["ሄ ዎደ መና ጎዳይ አሞጻ ናኣ ኢስያሳ ሀዋዳን ያጌዳ፤ “ባ፤ ነ ቦላፐ ማቃ ቃራ፤ ነ ገድያፐካ ነ ጫማ ከሳ” ያጌዳ፤ እስያስ ጾሳይ ጌዳዋዳን ሀኒደ፥ ካሎ ጺራነ መላ ገድያን ሀመቴዳ።"]},{"type":"verse","number":3,"content":["መና ጎዳይ ሀዋዳን ያጌዳ፤ “ታ ቆማይ እስያስ ግብጼነ ቶጵያ ቦላን ጋክያባዉ ማላታ ግዳና ማላ፥ ሄዙ ላይ ካሎ ጺራነ መላ ገድያን ሀመቴዳ።"]},{"type":"verse","number":4,"content":["ሄዋዳን አሶረ ካቲ፥ ግብጼፐ ኦሞደቴዳዋንታነ ቶጵያፐ በቲደ ከሴዳዋንታ ካሎ ጺራነ መላ ገድያና፥ ዱሊካ ካሎ ደእሽን ላግ፥ ግብጼ ዬላዉ አፋና።"]},{"type":"verse","number":5,"content":["ቶጵያን አማነትያዋንቱነ ግብጼን ጬቀትያዋንቱ ያዪደ ዬላታና።"]},{"type":"verse","number":6,"content":["አባ ማታን ደእያ አሳይ ሄ ጋላስ ሀዋዳን ያጋና፤ ‘በእተ፥ ኑን አሶረ ካትያፐ አታናዉ ማዲኖ ጊደ ኑ ህዶታ ዎዳነ ኡንቱንቱኮ ባቃቴዳ አሳ ቦላ ሀዌ ጋኬዳ፤ ያትና፥ ኑን ዋን አታናዉ ዳንዳዬቶ?’ ያጋና” ያጌዳ።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/ISA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/ISA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/ISA/19.json","previousChapterAudioLinks":{},"numberOfVerses":6}