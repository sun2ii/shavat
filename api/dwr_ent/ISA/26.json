,"number":7,"content":[{"text":"ጽሎቱዋ ኦጊ ሳላላ።","poem":1},{"text":"አቤት ጽሎ፥ ኔን","poem":2},{"lineBreak":true},{"text":"ጽሎቱዋ ኦግያ ሳላልሳሳ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኤ መና ጎዳዉ፥ ነ ህግያ ኦግያን ሀመቲደ፥","poem":1},{"text":"ኑን ኔና ናጌቶ።","poem":2},{"text":"ኑ ዎዛና አሙ፥","poem":1},{"text":"ነ ሱን ቦንቻናዋ ጻላላ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ቃማን ታን ኔና ላሞታይ፤","poem":1},{"text":"ዎንታን ታ ግዶን ደእያ ታ አያናይ፥","poem":2},{"lineBreak":true},{"text":"ቱሙዋፐ ኔና ምንሲደ ኮዬ።","poem":2},{"lineBreak":true},{"text":"አያዉ ጎፐ፥ ነ ፕርዳይ ሳኣን ደእያ ዎደ፥","poem":2},{"lineBreak":true},{"text":"ሳኣን ደእያ አሳይ ጽሎተ ታማሬ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኢታ አሳዉ ኬካተ ኦፐካ፥","poem":1},{"text":"እ ጽሎተ ታማረና።","poem":2},{"text":"ሱረ አሳቱዋ ጋድያን ኢታባ ኦ፤","poem":1},{"text":"መና ጎዳ ግታተካ ኤረና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አቤት መና ጎዳዉ፥ ኔን፥","poem":1},{"text":"ነ ኩሽያ ቁ ኦዳ፤","poem":2},{"text":"ሽን ኡንቱንቱ በእክኖ።","poem":1},{"text":"ነ አሳዉ ኔን ምሸትያ ምሹዋ በኢደ ዬላትኖ።","poem":2},{"text":"ኔን ነ ሞርከቶ ዎዳ ታማይ፥","poem":1},{"text":"ኡንቱንታ ም ይሶ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አቤት ጾሳዉ፥ ኔን፥","poem":1},{"text":"ኑዉ ሳሮተ ምንዳ፤","poem":2},{"text":"ኑ ኦሶ ኡባ ኔን ኑዉ ኦዳ።","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"አቤት መና ጎዳዉ፥ ኑ ጾሳዉ፥","poem":1},{"text":"ኔፐ ሀራቱ ኑና ሞዴድኖ፤","poem":2},{"text":"ሽን ኑን ነ ሱን ጻላላ ቦንቼቶ።","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ኡንቱንቱ ሀይቄድኖ፤","poem":1},{"text":"ስሚደ ፓጻ ደእክኖ።","poem":2},{"text":"ኔን ይሰዳ ድራዉ፥","poem":1},{"text":"ስሚደ ደንድክኖ።","poem":2},{"text":"ኡንቱንቱ ሀሳየትያዋ ኡባ ቁጫ ይሳዳ።","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"አቤት መና ጎዳዉ!","poem":1},{"text":"ኔን አሳ ዳርሳዳ።","poem":2},{"text":"አሳ ዳርሳደ፥ ኔን ቦንቼታዳ፤","poem":1},{"text":"ቢታ ዛዋ ኡባካ አሳዳ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አቤት መና ጎዳዉ!","poem":1},{"text":"መቱዋ ዎደ ኡንቱንቱ ኔና ኮዬድኖ።","poem":2},{"text":"ኔን ኡንቱንታ ሙሬዳ ዎደ፥","poem":1},{"text":"ኡንቱንቱ ኔና ሳሱክ ዎሴድኖ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አቤት መና ጎዳዉ! ሻሃሬዳ ምሽራታ፥","poem":1},{"text":"የልያ ዎዲ ጋክና፥","poem":2},{"text":"የሉዋ ኡንኤታደ ዋስያዋዳን፥","poem":1},{"text":"ኑንካ ነ ስንን ሄዋዳን ሀኔዶ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ኑን ሻሃሬዶ፤ ኦይ ኦይቀቴዶ፤","poem":1},{"text":"ሽን ጫርኩዋ የልያዋ ግዴዶ።","poem":2},{"text":"ኑን ሳአዉ አቶተ አህበይኮ፤","poem":1},{"text":"ሳኣን ደእያ አሳካ የልቦኮ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሀይቄዳ ነ አሳይ ፓጻና፤","poem":1},{"text":"ኡንቱንቱ አሃይ ደንዳና።","poem":2},{"text":"ህንተኖ፥ ቢታ ባና ግዶን ደእያዋንቶ፥","poem":1},{"text":"ህንተ ጻሳይ ዎንታ ከተርሳ ማላ ግድያ ግሻዉነ፥","poem":2},{"lineBreak":true},{"text":"ሳአይካ ሀይቄዳዋንታ ዛረደ እምያ ድራዉ፥","poem":2},{"lineBreak":true},{"text":"ቤጎትተነ ናሸቻዉ የጽተ።","poem":2}]},{"type":"heading","content":["ፕርዳነ ኦሞዱዋፐ ስምያዋ"]},{"type":"verse","number":20,"content":["ታ አሳቶ፥ ሃ ዪተ፤ ህንተ ጎለ ገሊደ፥ ፐንግያ ህንተ ቦላ ጎርድተ። ጾሳ ሀንቁ አና ጋካናዉ፥ ጉ ዎድያ ህንተና ቆስተ።"]},{"type":"verse","number":21,"content":["ቢታ ቦላን ደእያ አሳ፥ ኡንቱንቱ ናጋራ ድራዉ ሙራና፥ መና ጎዳይ ባረ ደኢያሳፐ ከሲደ ዬ። ቢታይካ ባረ ቦላን ጉኬዳ ሱ ቆንጭሳና፤ ዎዳዋንታካ ላኤን ገንና።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}