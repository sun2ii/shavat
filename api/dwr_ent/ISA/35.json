{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"ISA","translationId":"dwr_ent","name":"ኢስያሳ","commonName":"ኢስያሳ","title":"ኢስያሳ ትምቢትያ","order":23,"numberOfChapters":66,"sha256":"4745157233cad82b9b94b6332c06d7ec004e6d9dae863238e1ec8a8adf00b4c6","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/dwr_ent/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":35,"content":[{"type":"heading","content":["ጽሎተ ኦግያ"]},{"type":"verse","number":1,"content":["ቢታ ባዙነ መላ ቢታይ ናሸታና፤ መላ ቢታይ ናሸቻ ፖጩ ጊደ፥ ጪሻ ጪሻና።"]},{"type":"verse","number":2,"content":["እ ዳሮፐ ጪሻና፤ ፖጩ ጊደ ናሸቻን የጻና። ሊባኖሳ ቦንቹነ ቃርመሎሳነ ሳሮና ግታተይ እመታና፤ ኡንቱንቱ መና ጎዳ ቦንቹዋነ ኑ ጾሳ ግታተ በአና።"]},{"type":"verse","number":3,"content":["ዳቡሬዳ ኩሸቱዋነ አርጋጬዳ ጉልባታ ምንተ።"]},{"type":"verse","number":4,"content":["ዎዛናን ያሻይ ደእያዋንታ፥ “ምንተ! ያዮፕተ! ሄኮ፥ ህንተ ጾሳይ ሀሉዋ ከሳናዉነ ባረ ጾሳተን ኡንቱንታ ሙራናዉ ያና፤ እ ህንተና አሻና” ያግተ።"]},{"type":"verse","number":5,"content":["ሄ ዎደ፥ ቆቀቱዋ አይፊ ዶየታና፤ ቱለቱዋ ሀይይካ ስሳና።"]},{"type":"verse","number":6,"content":["ዎባቱዋ ገንእያዳን ጉፓና፤ ዱደቱካ ናሸቻን የጻና፤ ባዙዋን ሃይ መሎሳን ፑልቱ ቃና።"]},{"type":"verse","number":7,"content":["ጹግያ ሻፊ ዳጋቴዳ ሃ ግዳናዋ፤ መላ ቢታይ ሃ ፑልታና፤ ዎራካናቱ አላጽያሳን ማታይ ማቃይነ ጫሪ ዶላና።"]},{"type":"verse","number":8,"content":["ያን አኮ ኦጊ ደአና፤ እካ ጌሻተ ኦግያ ጌተታና። ጌሻ ግደናዋንቱ ሄ ኦግያና አክኖ። ሽን እ ጌሻቱዋሳ ግዳናዋ፤ ኢታ ኤያቱ አን ስመረትክኖ።"]},{"type":"verse","number":9,"content":["ያን ጋሙ ደኤና፤ ያሽያ ዶአቱካ ሄዋና አክኖ፤ ያንካ ቤትክኖ፤ ሽን ዎዘቴዳዋንቱ ጻላላይ ሀመታና።"]},{"type":"verse","number":10,"content":["መና ጎዳይ ዎዜዳዋንቱ ስማና፤ የጺድ፥ ጽዮነ ያና፤ መና ናሸቻይ ኡንቱንቱ ሁጲያን ዎና። ኡንቱንቱ ናሸቻነ ሀሹ ግያዋ ደማና፤ ካዩነ ኦሊ ዎራ ባቃታና።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}