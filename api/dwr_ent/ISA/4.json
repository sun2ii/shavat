{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"ISA","translationId":"dwr_ent","name":"ኢስያሳ","commonName":"ኢስያሳ","title":"ኢስያሳ ትምቢትያ","order":23,"numberOfChapters":66,"sha256":"4745157233cad82b9b94b6332c06d7ec004e6d9dae863238e1ec8a8adf00b4c6","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/dwr_ent/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":["ሄ ጋላስ ላፑን ማጫ አሳቱ እት አቱማዋ ኦይቂደ፥ “ኑን ኑ ቁማ ማና፤ ኑ ማዩዋ ማያና፤ ነ ሱንን ጼሰታና ማላ ኦደ ኑ ካዉሻ ኑፐ ቃራርኪ” ያጊደ ዎሳና።"]},{"type":"heading","content":["መና ጎዳይ የሩሳላመ ጌሻና"]},{"type":"verse","number":2,"content":["ሄ ጋላስ መና ጎዳ ም ታሺ ሎአናነ ቦንቼታና፤ እስራኤልያ አሳፐ አቴዳዋንቶ ሄ ጋድያ ካይ ጬቆነ ቦንቹዋ ግዳናዋ።"]},{"type":"verse","number":3,"content":["ጽዮነን አትያዋንቱ፥ የሩሳላመን ጋምእያዋንቱ፥ የሩሳላመን ፓጻ ደእያዋንቱና ጻፈትያዋንቱ፥ “ኡንቱንቱ ጌሻቱዋ” ጌተታና።"]},{"type":"verse","number":4,"content":["ጎዳይ ጽዮነ ማጫ አሳቱዋ ቅታ ሜጫና፤ ፕርዳ አያናንነ ጹግያ አያናን ሱ ጉስያ ባይዙዋ የሩሳላመፐ እ ጌሻና።"]},{"type":"verse","number":5,"content":["መና ጎዳይ ጽዮነ ደርያ ኡባ ቦላነ ያን ሺቅያዋንቱ ቦላ ጋላስ ሻርያነ ጩዋ፥ ቃማ ኤጽያ ታማ ፖኡዋ መና፤ ቦንቹ ኡባ ቦላ ካምያዋ ግዳናዋ።"]},{"type":"verse","number":6,"content":["እ ጋላሳ አዋ ሱሉዋፐ አሽያ ኩዋነ ጎትያፐነ እራፐ ባቃት አትያሳ ግዳናዋ።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/ISA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/ISA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/ISA/3.json","previousChapterAudioLinks":{},"number