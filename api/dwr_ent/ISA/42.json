{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"ISA","translationId":"dwr_ent","name":"ኢስያሳ","commonName":"ኢስያሳ","title":"ኢስያሳ ትምቢትያ","order":23,"numberOfChapters":66,"sha256":"4745157233cad82b9b94b6332c06d7ec004e6d9dae863238e1ec8a8adf00b4c6","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/dwr_ent/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":42,"content":[{"type":"heading","content":["መና ጎዳ ቆማ"]},{"type":"verse","number":1,"content":["ታን ዘምፕሳደ ኦይኬዳ ታ ቆማይ፥ ታ ሸምፑ አን ናሸትያዌ፥ ታን ዶሬዳዌ ሀዎኮ። ታን ታ አያና አ ቦላ ዎድ፤ እ ካዉተቶ ሱረ ፕርዳ አሀና።"]},{"type":"verse","number":2,"content":["እ ዋሰና፤ ዎይ ባረ ቃላ ቂሰና፤ ዎይ ቃይ ባረ ቃላ ኦግያን ስሰና።"]},{"type":"verse","number":3,"content":["ትንጨቴዳ ሾምቦቁዋ እ መንና፤ ቃይ ሊአካቲደ ኤጽያ ሙቃዳካ እ ቶይሰና። እ አማነቲደ፥ ሱረ ፕርዳ አሀና።"]},{"type":"verse","number":4,"content":["እ ቢታን ሱረ ፕርዳ ኤሰናን ደኢደ አገና፤ ዎይ ጉየ ጌና። አባ ዶና ቢታቱዋን ደእያ አሳይ ኡባይ አ ህግያ ስሳናዉ ናጌ።"]},{"type":"verse","number":5,"content":["ጾሳይ መና ጎዳይ፥ ሳሎቱዋ መደ ምጬዳዌ፥ ሳኣነ ሳኣፐ ከስያዋ ኡባ ኦዳዌ፥ ሳኣን ደእያ አሳዉ ሸምፑዋ እምያዌ፥ አን ሀመትያ ኡባዉ ደኡዋ እምያዌ ሀዋዳን ያጌ፤"]},{"type":"verse","number":6,"content":["“ታን መና ጎዳ፤ ታን ኔና ጽሎተን ጼሳድ፤ ታን ነ ኩሽያ ኦይቃደ፥ ኔና ናጋና። ታን ኔና ካዉተቶ ፖኦ ኦደ፥ ቃይ አሳዉካ ጫቁዋ ኦደ እማና።"]},{"type":"verse","number":7,"content":["ኔን ቆቅያ አይፍያ ዶያና ማላ፥ ኦሞደቴዳዋንታ ኦሞዱዋ ጎልያፐ ከሳና ማላ፥ ማን ደእያዋንታካ ቃሾ ጎልያፐ ከሳና ማላ፥"]},{"type":"verse","number":8,"content":["ታን መና ጎዳ፤ ሄዌ ታ ሱን። ታ ቦንቹዋ ታን ሀራዉ እምከ፤ ታ ጋላታካ ማሰቲደ ጊጌዳ ምስለቶ እምከ።"]},{"type":"verse","number":9,"content":["በእተ፥ ካሰ ታን ኦዴዳዋንቱ ኡባይ ፖለቴድኖ። ሀእ ቃይ ታን ኦራባ አዋያይ፤ ኡንቱንቱ ሀናናፐ ካሰታደ ታን ህንተንቶ ኦዳይ” ያጌ።"]},{"type":"heading","content":["ጋላታ የ"]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"መና ጎዳዉ ኦራ ማዝሙርያ የጽተ፤","poem":1},{"text":"ቢታ ጋጻፐ ዶሚደ፥ አ ጋላታ ኦድተ።","poem":2},{"text":"አባ ቦላን ብያዋንቱነ፥","poem":1},{"text":"አን ኩሜዳ ኡባይካ አነ ዋስኖ።","poem":2},{"text":"አባ ዶና ቢታቱነ ኡንቱንቱን ደእያ ኡባይካ የጽኖ።","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"መላ ቢታይነ ባዙዋን ደእያ ካታማቱ፥","poem":1},{"text":"ቃይ ቄዳረ አሳይ ደእያ ሞቱካ፥","poem":2},{"lineBreak":true},{"text":"ባረንቱ ቃላ ቁ ኦኖ።","poem":2},{"lineBreak":true},{"text":"ሰላአ ግያ ካታማን ደእያዋንቱካ፥","poem":2},{"lineBreak":true},{"text":"ደርያ ሁጲያፐ ባረንቱ እልልሳ ስስኖ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኡንቱንቱ ቦንቹዋ መና ጎዳዉ እምኖ፤","poem":1},{"text":"አ ጋላታካ ጋጻ ቢታቱዋን አዋይኖ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"መና ጎዳይ ምኖ አሳዳን ከሳና፤","poem":1},{"text":"ኦላንቻ አሳዳን፥ እ ባረ ሀንቁዋ ደንና።","poem":2},{"text":"እ ዋሳና፤ ባረ ቃላካ ቁ ኦደ አዋያና።","poem":1},{"text":"እ ምኖ ግድያዋ ባረ ሞርከቱዋ በሳና።","poem":2}]},{"type":"heading","content":["ጾሳይ ባረ አሳ ማዳናዉ ቃላ ገሌዳ"]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ጾሳይ ሀዋዳን ያጌ፤","poem":1},{"text":"“አዱሳ ዎድያፐ ታን ሳሩዋን ታካድ፤","poem":2},{"lineBreak":true},{"text":"ጮኡ ጋደ ዳንዳያድ።","poem":2},{"lineBreak":true},{"text":"ሀእ የሉ ኦይኬዳ ምሽራቲዳን፥","poem":2},{"lineBreak":true},{"text":"ታን ዋሳና፤","poem":2},{"lineBreak":true},{"text":"ቶካ ቶካደ ሸምፓናነ ፔኑቃና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታን ደረቱዋነ ዞዘቱዋ ላላና፤","poem":1},{"text":"ኡንቱንቱን ሞኬዳዋ ኡባ መልሳና።","poem":2},{"text":"ሻፋቱዋ መላ ከሳና፤","poem":1},{"text":"ደልኤቱዋካ መልሳና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“ታን ቆቀቱዋ ኡንቱንቱ ኤረና ኦግያና አሀና፤","poem":1},{"text":"ኡንቱንቱ ኤረና ሎሱዋናካ ካለና።","poem":2},{"text":"ኡንቱንቱ ስንን ደእያ ማ ፖኦ ላማና፤","poem":1},{"text":"ኮርጱኮርጳ ሳኣካ ሳላልሳና።","poem":2},{"text":"ሄዋንታ ታን ኡንቱንቶ ኦና፤","poem":1},{"text":"ታን ጌዳ ሀ የዎቱዋ ኦናን አግከ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሽን ማሲደ ጊግሴዳ ምስለቱዋን አማነትያዋንቱ፥","poem":1},{"text":"ቃይ ሲልሲደ ጊግሴዳ ምስለቱዋ፥","poem":2},{"text":"‘ህንተ ኑ ጾሳቱዋ’ ያግያዋንቱ፥","poem":1},{"text":"ጉየ ስማና።","poem":2},{"text":"ኡንቱንቱ ሙለ ዬላታና”","poem":1},"ያጌ።"]},{"type":"heading","content":["እስራኤልያ አሳይ ታማረናን እጼዳ እጹዋ"]},{"type":"verse","number":18,"content":["ጾሳይ ሀዋዳን ያጌ፤ “ህንተኖ ቱለቶ፥ ስስተ፤ ህንተኖ ቆቀቶ፥ ህንተ በአና ማላ ጼልተ።"]},{"type":"verse","number":19,"content":["ታ ቆማፐ ሀራ ቆቂ ኦኔ? ታን ኪትያ ኡራፐ ሀራ ቱሊ ኦኔ? ጾሳዉ ዱማቴዳ ኡራዳን፥ ዎይ መና ጎዳ ቆማዳን ቆቃይ ኦኔ?"]},{"type":"verse","number":20,"content":["ዳሮባ ጼሊታ፤ ሽን አኬክክታ። ህንተንቱ ሀይቱካ ዶያ፤ ሽን ስስክኖ” ያጌ።"]},{"type":"verse","number":21,"content":["መና ጎዳይ ባረ ጽሎተ ድራዉ፥ ባረ ህግያ ግታያናዉነ ቦንቻናዉ ዶሴዳ።"]},{"type":"verse","number":22,"content":["ሽን ሀዌ አሳይ ቦንቀቴዳነ ዎ አከቴዳ። ኡንቱንቱ ኡባይካ ዲዛን ኦይቀቲደ፥ ቃሾ ጎልያን ቆሰቴድኖ። ኡንቱንቱ ቦንቀቴድኖ፤ ሽን ኡንቱንታ አሽያዌ ባዋ። ቃይ ኦሞደቴድኖ፤ ሽን ኦንነ፥ “ዛርተ” ያግያዌ ባዋ።"]},{"type":"verse","number":23,"content":["ህንተ ግዶፐ ሀዋ ስሳናዌ ኦኔ? ቃይ ስንፐ ያና ዎድያባ ሀይዛናዌ ኦኔ?"]},{"type":"verse","number":24,"content":["ያቆባ ኦሞድያዎ፥ እስራኤልያ ቦንቂያዎ አደ እሜዳዌ ኦኔ? አ ቦላን ኑን ናጋራ ኦዳ፥ አ ኦግያን ኡንቱንቱ ቤናን እጼዳነ አ ህግያዉካ ኡንቱንቱ አዛዘተናን እጼዳ መና ጎዳ ግደኔየ?"]},{"type":"verse","number":25,"content":["ሄዋ ድራዉ፥ እ ኡንቱንቱ ቦላ ባረ ሀንቁዋ ሱሉዋነ ያሽያ ኦላ ጉሴዳ፤ እ ኡንቱንቱ ዩሹዋን ታማ ኤዳ፥ ሽን ኡንቱንታ ኤርበይክኖ፤ እ ኡንቱንቱ ጹጌዳ፤ ሽን ኡንቱንቱ አኬክበይክኖ።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/ISA/41.json","previousChapterAudioLinks":{},"numberOfVerses":25}