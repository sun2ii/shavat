{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"JDG","translationId":"dwr_ent","name":"ዳናቱዋ","commonName":"ዳናቱዋ","title":"ዳናቱዋ ማጻፋ","order":7,"numberOfChapters":21,"sha256":"d04d990a0f7282bb92cea0cec8b373ce29fad0351e19f7965b94b6dd2370362a","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/dwr_ent/JDG/21.json","totalNumberOfVerses":614},"chapter":{"number":5,"content":[{"type":"heading","content":["ድቦራነ ባራቃ የ"]},{"type":"verse","number":1,"content":["ሄ ጋላስ ድቦራነ አብኖኣማ ናአይ ባራቅ ሀ የ የጼድኖ።"]},{"type":"verse","number":2,"content":[{"text":"“እስራኤልያ አሳ","poem":1},{"text":"ካለያዋንቱ ካለዳ ድራዉ፥","poem":2},{"text":"አሳይካ ዶሲደ፥","poem":1},{"text":"ባረ ሁጲያ አደ እሜዳ ድራዉ፥","poem":2},{"lineBreak":true},{"text":"መና ጎዳ ጋላትተ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“ህንተንቶ ካተቶ፥ ሀዋ ስስተ!","poem":1},{"text":"ህንተንቶ ደርያ ሞድያዋንቶ፥ ሀይዝተ!","poem":2},{"text":"ታን መና ጎዳዉ የጻና።","poem":1},{"text":"መና ጎዳዉ እስራኤልያ ጾሳዉ","poem":2},{"lineBreak":true},{"text":"ጋላታ የ የጻና።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አቤት መና ጎዳዉ፥","poem":1},{"text":"ኔን ሰኢራ ደርያፐ ደንዴዳ ዎደ፥","poem":2},{"text":"ኔን ኤዶማ ቢታፐ ከሴዳ ዎደ፥","poem":1},{"text":"ቢታይ ቃጼዳ።","poem":2},{"text":"ሳሉዋፐ እራይ ቡኬዳ፤","poem":1},{"text":"ኤ፥ ሃይ ሻረቱዋፐ ዱገ ሶሶቴዳ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"መና ጎዳ ስንን ደረቱ ቃጼድኖ፤","poem":1},{"text":"ሀራይ አትና፥ ሲና ደሪካ መና ጎዳ","poem":2},{"text":"እስራኤልያ ጾሳ ስንን ኮኮሬዳ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“አናታ ናኣ ሻምጋና ዎደነ፥","poem":1},{"text":"ያኤላ ዎደ ጫና መህያ ላግያ፥","poem":2},{"lineBreak":true},{"text":"ዛልአንቻቱ ሄ ቢታና አበይክኖ።","poem":2},{"lineBreak":true},{"text":"ኦግያና ብያዋንቱካ ኦግያ አጊደ፥","poem":2},{"lineBreak":true},{"text":"ሎሱዋና ቤድኖ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እስራኤልያ ካታማቱ አሳይ ደኤና ሳኣ ግዴድኖ።","poem":1},{"text":"ታን ድቦራ፥ ታን እስራኤልያ አሳዉ፥","poem":2},{"lineBreak":true},{"text":"አቶ ግዳደ ደንዳና ጋካናዉ ኦንነ አትቤና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እስራኤልያ አሳይ አላጋ ጾሳቱዋ ዶሬዳ ዎደ፥","poem":1},{"text":"ጋድያን ኦላይ ደንዴዳ።","poem":2},{"text":"ኦይታሙ ሻአ እስራኤልያ ኦላንቻቱዋ ግዱዋን","poem":1},{"text":"እት ጎንዳሊ ዎይ እት ቶር ቤትቤና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ታ ዎዛናይ እስራኤልያ ኦላ ጋዳዋቱዋና ደኤ።","poem":1},{"text":"አሳ ግዶን ዶሲደ ባረንታ አደ እሜዳዋንቱና ደኤ።","poem":2},{"text":"መና ጎዳ ጋላትተ!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ህንተንቶ፥ ቦ ሀረቱዋ ቶግያዋንቶ፥","poem":1},{"text":"ህንተንቶ፥ ግላስያ ቦላን ኡቴዳዋንቶ፥","poem":2},{"lineBreak":true},{"text":"ኦግያና ሀመትያዋንቶ፥","poem":2},{"lineBreak":true},{"text":"ሀዋ ስስተ!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሃ ኦላቱዋ ማታን ሺቄዳ የንቻቱዋ የ ስስተ።","poem":1},{"lineBreak":true},{"text":"ኡንቱንቱ መና ጎዳይ ጽሎተ ኦሱዋባ የጺኖ፤","poem":1},{"text":"ቃይ እስራኤልያ ኦላንቻቱዋ ጽሎተ ኦሱዋባ የጺኖ።","poem":2},{"lineBreak":true},{"text":"“ሄዋፐ ጉይያን፥ መና ጎዳ አሳይ","poem":1},{"text":"ካታማ ገልያ ፐንገቱዋኮ ዱገ ዎዳ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ድቦሬ! ቤጎታ! ቤጎታ!","poem":1},{"text":"ቤጎታ! ቤጎታደ ማዝሙርያ የጻ።","poem":2},{"text":"ባራቃ፥ ደንዳ!","poem":1},{"text":"ኔኖ፥ አብኖኣማ ናአዉ፥ ነ ኦሞዱዋ አካደ ያ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ሄዋፐ ጉይያን፥ አቴዳ አሳቱ","poem":1},{"text":"ካፓቱዋኮ ዱገ ዎድኖ።","poem":2},{"text":"መና ጎዳ አሳቱ ኦለታናዉ ጊጊደ","poem":1},{"text":"ድቦርኮ ዬድኖ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አማሌቃ ዛራቱ በን ደኤዳ ሳኣን ደእያ፥","poem":1},{"text":"ኤፍሬማ አሳቱ ዬድኖ።","poem":2},{"text":"ቃይ ቢንያማ አሳቱ ኡንቱንታ ካሌድኖ።","poem":1},{"text":"ካፓቱ ማክራ ዛራቱዋፐነ፥","poem":2},{"text":"ኦላ ጋዳዋቱ ዛብሎና ዛራቱዋፐ ዱገ ዎድኖ።","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ይሳኮራ ካፓቱ ድቦርና ዬድኖ፤","poem":1},{"text":"ኤ፥ ይሳኮራ አሳይነ ባራቅካ ዬዳ፤","poem":2},{"lineBreak":true},{"text":"ኡንቱንቱ አ ጌዱዋ ካሊደ፥ ዛንጋራ ገሌድኖ።","poem":2},{"lineBreak":true},{"text":"ሽን ሮቤላ ዛራቱ ቆፋን ሻከቲደ፥","poem":2},{"lineBreak":true},{"text":"ያናዋ አጋናዋ ቃችበይክኖ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኡንቱንቱ አያዉ አቴድኖ?","poem":1},{"text":"ዶርሳቱዋ ሄምያዋንቱ እምቢልታ ስሳናዉ አቴድኖየ?","poem":2},{"lineBreak":true},{"text":"ሮቤላ ዛራቱ ቆፋን ሻከቲደ፥","poem":2},{"lineBreak":true},{"text":"ያናዋ አጋናዋ ቃችበይክኖ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ጋላኣደ አሳቱ ዮርዳኖሳ ሻፋፐ ሄፍንን አቴድኖ።","poem":1},{"text":"ዳና ዛራቱ ማርካባቱ ማታን አቴድኖ።","poem":2},{"text":"አሴራ ዛራቱ ባረንቱ ደእያ ሳኣን፥","poem":1},{"text":"ሜድትራነ አባ ላንቂያን አቴድኖ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዛብሎና ዛራቱ ባረንቱ ሸምፑዋ ሀይቆ አደ እሜዳ አሳቱዋ።","poem":1},{"text":"ንፍታሌማ ዛራቱካ ኡንቱንቱዋዳን ኦላ ደምባን ባረንቱ ሸምፑዋ አደ እሜድኖ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ካተቱ ዪደ፥ ማግዶ ፑልቶቱዋ ማታን ደእያ ታእናካን ኦለቴድኖ።","poem":1},{"text":"ሄ ካናነ ካተቱ ያን ኦለቲደ፥","poem":2},{"lineBreak":true},{"text":"ኦሞዳናዉ አያ ብራነ ደምቤይክኖ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ሳሉዋን ደእያ ጾልንተቱካ ኦለቴድኖ።","poem":1},{"text":"ባረንቱ ዩይያ ዩሻን ኡንቱንቱ ስሳራና ኦለቴድኖ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ቂሾና ሻፋይ፥ በንፐ፥","poem":1},{"text":"ኤረቴዳ ቂሾና ሻፋይ ኩንደ፥","poem":2},{"lineBreak":true},{"text":"ሄ ካተቱዋ ሾኪደ አፌዳ።","poem":2},{"text":"ታ ሸምፓቴ፥ ስም ምና፤","poem":1},{"text":"ስንዉ ጋልፋ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ሄዋፐ ጉይያን፥ ፓራ አሳቱ አንዳራሰቲደ ዬድኖ።","poem":1},{"text":"ፓራቱ ባረንቱ ኮትያን ጋድያ ጊርሴድኖ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"መና ጎዳ ኪታንቻይ፥","poem":1},{"text":"‘መሮዛ ሸቂተ!","poem":2},{"text":"ያን ደእያ አሳ ኢሲደ ሸቂተ!","poem":1},{"text":"አያዉ ጎፐ፥ ኡንቱንቱ መና ጎዳዉ ኤቃናዉ ይበይክኖ።","poem":2},{"text":"አ ዎልቃማ ሞርከቱዋና ኦለታናዉ ከስበይክኖ’ ያጌዳ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“ቄና ሄቤራ ማቻታ","poem":1},{"text":"ያኤላ ማጫ አሳ ኡባፐ አንጀቴዳኖ ግዱ።","poem":2},{"text":"ዱንካነ ግዶን ደእያ ማጫ አሳ ኡባፐ እዛ አንጀቴዳኖ ግዱ።","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"ስሳር እዞ ሃ ኦችና፥","poem":1},{"text":"ማ አዉ እማዱ።","poem":2},{"text":"ሎኦ ቃራባን መኤዳ ማ አሃዱ።","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"እት ኩሽያ የዳደ ዱንካንያ ሽካልያ፥","poem":1},{"text":"ኡሸቻ ኩሽያን ኦሳንቻቱዋ ማርቴሉዋ ኦይቃዱ።","poem":2},{"text":"ስሳራ ሁጲያን ጋዱ፤","poem":1},{"text":"ሀይ ካርያና ካን ከሳዱ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ያትና፥ እ ቦልቁ ጊደ ኩንዴዳ።","poem":1},{"text":"እ ሄ እዝ ገድያ ማታን","poem":2},{"lineBreak":true},{"text":"ቦልቁ ጊደ ኩንዴዳ።","poem":2},{"lineBreak":true},{"text":"ሄ ኩንዴዳ ሳኣን ሀይቄዳ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ስሳራ ዳያ ማስኮትያና ጼላዱ።","poem":1},{"text":"‘ታ ናኣ ፓራ ጋሪ አያዉ ጋምኤዴ?","poem":2},{"text":"ፓራቱ ኤሌሊደ አያዉ ስምበይክኖ?’","poem":1},{"text":"ያጋደ ኦቻዱ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"እዝ አዳ ኤራንቻ ማጫ አሳቱ እዝ ኦሻ ዛሬድኖ።","poem":1},{"text":"ሽን እዛ ባረ ቆፋን ዛራ ዛራደካ ሀዋዳን ያጋዱ፤","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ኡንቱንቱ ኦሞዲደ ሻክያዋ ደመናን አግክኖ።","poem":1},{"text":"እት እት ኦላንቻ እት እት ዎይ ላኡ ላኡ ዎዶራቱ ጋከናን አግክኖ።","poem":2},{"text":"ስሳራዉ ኡንቱንቱ ሎእያ ማዩዋ እማና፤","poem":1},{"text":"ቃይ ታዉካ ቆያን ጻጻናዉ፥","poem":2},{"lineBreak":true},{"text":"ጽልፍያን አሌቀቲደ ሎእያ ማዮቱዋ","poem":2},{"lineBreak":true},{"text":"ኡንቱንቱ አሀና ያጋዱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“አቤት መና ጎዳዉ፥ ነ ሞርከቱ ኡባይ ሄዋዳን ሀይቂኖ!","poem":1},{"text":"ሽን ነ ሲቃቱ ጉራ ዶልያ አዋዳን ጶልኖ፤","poem":2},{"lineBreak":true},{"text":"አዋይ ባረ ዎልቃን ከስያዋዳን” ያጌድኖ።","poem":2},"ሄዋፐ ጉይያን፥ ጋዲ ኦይታሙ ላይ ዎፓ ደሜዳ።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr