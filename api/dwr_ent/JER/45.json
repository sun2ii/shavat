{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"JER","translationId":"dwr_ent","name":"ኤርማሳ","commonName":"ኤርማሳ","title":"ኤርማሳ ትምቢትያ","order":24,"numberOfChapters":52,"sha256":"c39a662572b0522aa4399b902d1153195342de06a24999aad425b32adf765de3","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/dwr_ent/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":45,"content":[{"type":"heading","content":["ባሮካዉ ኦደቴዳ ትምቢትያ"]},{"type":"verse","number":1,"content":["እዮስያሳ ናአይ እዮአቄም ይሁዳን ካተቴዳ ኦይደን ላይን፥ ኔርያ ናአይ ባሩክ ሀ ቃላቱዋ ኤርማስ ኦድና ስሲደ፥ ማጻፋን ጻፌዳ። ሄ ዎደ ኤርማስ አዉ ኦዴዳ ቃላይ ሀዋ።"]},{"type":"verse","number":2,"content":["“ባሮካ፥ ኔና መና ጎዳይ፥ እስራኤልያ ጾሳይ ሀዋዳን ያጌ፤"]},{"type":"verse","number":3,"content":["‘ኔን፥ “መና ጎዳይ ታ ሳኩዋ ቦላን ካዩ ጉጄዳ ድራዉ፥ አየ ታኖ! ኦልያን ዳቡራደ ሸምፑዋካ ያድ” ያጋዳ’ ያጌ።"]},{"type":"verse","number":4,"content":["“ባሮካ፥ ኔና መና ጎዳይ ሀዋዳን ያጌ፤ ‘ታን ኬጼዳዋ ታን ኮላና፤ ታን ቶኬዳዋካ ታን ሾዳና። ሄዋካ ቃይ ታን ቢታን ሳኣን ኡባን ኦና።"]},{"type":"verse","number":5,"content":["ያትና፥ ኔን ነዉ ዎልቃማባ ኮያይየ? ሄዋ ኮዮፓ። አያዉ ጎፐ፥ አሳ ኡባ ቦላን ታን ኢታባ አሀና። ታን ጾሳይ ሀዋ ኦዳይ። ሽን ኔን ቤዳሳን ኡባን ታን ኔና ሀይቁዋፐ አሻና’ ያጌ” ያጌዳ።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/JER/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/JER/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/JER/44.json","previousChapterAudioLinks":{},"numberOfVerses":5}