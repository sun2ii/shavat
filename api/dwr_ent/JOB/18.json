{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"JOB","translationId":"dwr_ent","name":"ኢዮባ","commonName":"ኢዮባ","title":"ኢዮባ ማጻፋ","order":18,"numberOfChapters":42,"sha256":"4c36657e984ee32e454a7742cce8b9e94e6af459f896bb5fd9ee09eb6e965dc2","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/dwr_ent/JOB/42.json","totalNumberOfVerses":1065},"chapter":{"number":18,"content":[{"type":"heading","content":["ብልዳደ ላኤን ሃሳያ"]},{"type":"verse","number":1,"content":["ሄዋፐ ጉይያን፥ ሹሀ ቢታፐ ዬዳ ብልዳደ ሀዋዳን ያጊደ ዛሬዳ፤"]},{"type":"verse","number":2,"content":["“ኢዮባ፥ ኔን ሀ ሃሳያ አዉደ ዉርሳይ? አነ አኬካ። ያቶፐ ኑን ሃሳያና።"]},{"type":"verse","number":3,"content":["ኑና አያዉ ሚዛ ከሳይ? አያዉ ኑና ዶንጭሎዋንታ ከሳይ?"]},{"type":"verse","number":4,"content":["ኔን ነ ሀንቁዋን ኔና ቆሃሳ። ነ ሀንቁዋን ቢታይ መላ ግዳኔ? ዎይ ዛላቱ ባረንቱ ሳኣፐ ቆለታኔ?"]},{"type":"verse","number":5,"content":["“ናጋራንቻቱዋ ደኡ ጾምፒ ቶእያዋዳን ቶአናዌ ጌሻ፤ እ ላኤን ሙለካ ኤጸና።"]},{"type":"verse","number":6,"content":["እ ጾምፒ ባይና ጎልያ ማላ፤ አ ማታን ደእያ ጾምፒካ ቶኤ።"]},{"type":"verse","number":7,"content":["እ ታንግያ ታንጉካ ቃሜ፤ እ ሀራቱዋ ዞርያ ዞሪ አ ኡንጌ።"]},{"type":"verse","number":8,"content":["“አ ሀመታይ አ አፊደ፥ ጲርያን ገልሴ፤ ዲዛ ግዶን እ ሀመቴ።"]},{"type":"verse","number":9,"content":["ጵሪ አ ግንድያ ኦይቄ፤ አ ቃዋ ድጌ።"]},{"type":"verse","number":10,"content":["አዉ ዩርዶ ዎዶሩ ጌማን ሳኣን ሂጸት ኡቴ፤ እ ሀመትያ ኦግያንካ ግቲ ዎ ኡቴ።"]},{"type":"verse","number":11,"content":["“ዳጋማይ አ ዶዴ፤ አ ጉየናካ የደርሴ፤"]},{"type":"verse","number":12,"content":["አ ዎልቃይ ኮሻን ዳቡሬዳ፤ ባሻይ አ ማታን ናጌ።"]},{"type":"verse","number":13,"content":["ዎያ ሀርጊ አ ቦላን ኡባን ዶዴ፤ አ ኩሽያነ አ ገድያ ዱሽሴ።"]},{"type":"verse","number":14,"content":["እ ህርግ ባይናን ደእያ ባረ ጎልያፐ የደርሴቴ፤ ኡንቱንቱ አሳ ኡባ ሞድያ ሀይቁዋ ግያ ካትያኮ፥ አ አፊኖ።"]},{"type":"verse","number":15,"content":["ሀርግያ የደርሳነው ዲንያ ላሎዋፐ ጉይያን፥ ኦንነ አ ጎልያን ደአና።"]},{"type":"verse","number":16,"content":["እ ጻጱ ጋርሳና መልያነ ቃንካቱካ ቦላና ቆቆፈትያ ም ማላ ግዴ።"]},{"type":"verse","number":17,"content":["አ ዎሪ ቢታፐ ዬ፤ አ ሱንይካ ሳኣን ሀሳየተናን አቴ።"]},{"type":"verse","number":18,"content":["እ ፖኡዋፐ ማዉ የደርሰታና፤ አሳይ ደእያ ቢታፐካ እ ያና።"]},{"type":"verse","number":19,"content":["አዉ ናአይ ዎይ ዛሪ ያና፤ እ ደኤዳ ሳኣን እት አሳይነ ፓጻ ደኤና።"]},{"type":"verse","number":20,"content":["አዋይ ዶልያ ባጋ አሳይ አ ጋኬዳዋን ዳጋሜ፤ አዋይ ዉልያ ባጋ አሳይካ ያሻን ኮኮሬ።"]},{"type":"verse","number":21,"content":["አዉደካ ኢታ አሳቱዋ ዉርሰይ ሄዋ ማላ፤ ጾሳ ኤረናዋንቱ ካጫይካ ሄዋ ማላ” ያጌዳ።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}