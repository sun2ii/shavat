{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"JOB","translationId":"dwr_ent","name":"ኢዮባ","commonName":"ኢዮባ","title":"ኢዮባ ማጻፋ","order":18,"numberOfChapters":42,"sha256":"4c36657e984ee32e454a7742cce8b9e94e6af459f896bb5fd9ee09eb6e965dc2","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/dwr_ent/JOB/42.json","totalNumberOfVerses":1065},"chapter":{"number":26,"content":[{"type":"heading","content":["ኢዮብ ዛሪደካ ሃሳዬ"]},{"type":"verse","number":1,"content":["ኢዮብ ሀዋዳን ያጊደ ዛሬዳ፤"]},{"type":"verse","number":2,"content":["“ዎልቃይ ባይና አሳ ኔን አያ ማዱዋ ማዳዲ! ዳቡሬዳ ቀሰቱዋ ኔን አያ አሹዋ አሻዲ!"]},{"type":"verse","number":3,"content":["አዳ ኤራተይ ባይናዋ አያ ዞርያ ዞራዲ! አይ ኬሻ ዎልቃማ ኤራተ ቆንጭሳዲ!"]},{"type":"verse","number":4,"content":["ኔን ሀ ቃላ ሃሳያናዳን ኔና ኦኔ ማዴዳዌ? ቃይ ሀዋዳን ሃሳያናዉ ኔና ደንዳዌ ኦ አያኔ?” ያጌዳ።"]},{"type":"heading","content":["ብልዳደ ባረ ሃሳያ ዉርሴ"]},{"type":"verse","number":5,"content":["ብልዳደ፥ “ሀይቄዳዋንቱ ሞይትለቱ ቢታፐ ጋርሳ ባጋና ሃ ግዶን ኮኮሪኖ።"]},{"type":"verse","number":6,"content":["ጾሳ ስንን ስኦሊካ ቆንጨ፤ አያይነ አ ገንናዉ ዳንዳየና።"]},{"type":"verse","number":7,"content":["ጾሳይ ሁጲሳ ባጋ ሳሎቱዋ ምጬዳ፤ ሳኣካ አየንቶ ባይና ሳን ካቄዳ።"]},{"type":"verse","number":8,"content":["እ ሻረቱዋን ሃ ኩን፤ ሃ ዴጹዋን ሻረቱ ዳከትክኖ።"]},{"type":"verse","number":9,"content":["ዶይሴዳ አግና እ ባረ ሻርያን ካሜ።"]},{"type":"verse","number":10,"content":["ፖኡዋ ማፐ ሻካናዉ፥ ሳሉ ሳኣና ዳንትያ ሳኣን ቃማይነ ጋላሳይ ላመትያ ዛዋ ጾሳይ ኤሴ።"]},{"type":"verse","number":11,"content":["እ ሴርያ ዎደ፥ ሳሎቱዋ ቱቀቱ ዳጋማዉ ኮኮሪኖ።"]},{"type":"verse","number":12,"content":["ባረ ዎልቃን አባ ጮኡ ኦዳ፤ ባረ አኬካን ራኣባ ግያ ዳዊያ ይሴዳ።"]},{"type":"verse","number":13,"content":["እ ሸምፕያ ሸምፑዋን ሳሎቱ ጌዬድኖ፤ አ ኩሺካ ጾንገትያ ሾሻ ዎዳ።"]},{"type":"verse","number":14,"content":["ሀዋንቱ ኡባይ ጾሳይ ኦዳ ኦሶቱዋፐ አማሬዳዋንታ፤ ኑን ስስያዌ ሳሱከ ጻላላ። ያትና፥ አ ዎልቃ ግታተ አኬካናዉ ዳንዳይያዌ ኦኔ?” ያጌዳ።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}