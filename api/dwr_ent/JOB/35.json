{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"JOB","translationId":"dwr_ent","name":"ኢዮባ","commonName":"ኢዮባ","title":"ኢዮባ ማጻፋ","order":18,"numberOfChapters":42,"sha256":"4c36657e984ee32e454a7742cce8b9e94e6af459f896bb5fd9ee09eb6e965dc2","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/dwr_ent/JOB/42.json","totalNumberOfVerses":1065},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":["ኤልሁ ቃይካ ሀዋዳን ያጌዳ፤"]},{"type":"verse","number":2,"content":["“ኢዮባ፥ ኔን፥ ‘ታን ጾሳ ስንን ጽሉዋ’ ግያዌ ልኬ?"]},{"type":"verse","number":3,"content":["ቃይ፥ ‘ታን ናጋራ ኦፐ፥ ኔና አይ ቆሀይታ? ናጋራ ኦናን አጎፐ፥ ታን ጎኤትያዌ አዬ?’ ያጋደ ኔን ጾሳ ኦቻዳ።"]},{"type":"verse","number":4,"content":["ታን ነዉነ ኔናና ነ ላገቶ ዛሩዋ ሃሳያና።"]},{"type":"verse","number":5,"content":["“ቁ ጋደ ሳሎቱዋ ጼላ፤ ኔፐ ቦላና ደእያ ሻረቱዋካ አነ አኬካደ በአ።"]},{"type":"verse","number":6,"content":["ኔን ናጋራ ኦፐ፥ ሄዌ ጾሳ አይነ ቆሄና። ነ ባይዙ ዳሮፐካ፥ ኔን ጾሳ አይነ ኦካ።"]},{"type":"verse","number":7,"content":["ጽሉዋ ግዶፐ፥ አዉ ኔን አያ እማይ? ዎይ ነ ኩሽያፐ እ አያ አካኔ?"]},{"type":"verse","number":8,"content":["ኔን ናጋራ ኦፐ፥ ነ ማላ አሳ ቆሃሳ፤ ቃይ ጽሎፐካ፥ አሳ ጎኣሳ።"]},{"type":"verse","number":9,"content":["“ኡቁናይ ዳሮፐ አሳይ ዋሴ፤ ዎልቃማቱዋ ኩሽያፐ ከስ አካናዉ አሉዋ ጼጌ።"]},{"type":"verse","number":10,"content":["ሽን ኦንነ፥ ‘ጾሳይ፥ ታና መዳዌ፥ ቃማን ማዛሙርያ እሜዳዌ፥ ሳኣ ዶአቱዋፐ አደ፥ ኑና ታማርስያዌነ ሳሉዋ ካፎቱዋፐ አዳ ኤራንቻ ኑና ኦያዌ ሀቃን ደኢ?’ ያገና።"]},{"type":"verse","number":12,"content":["ኢታ አሳቱ ዋሲኖ፤ ሽን ጾሳይ ኡንቱንቱ ኦቶሩዋ ጋሱዋን፥ ኡንቱንቶ አለና።"]},{"type":"verse","number":13,"content":["ሀዳ ዋሱዋ ጾሳይ ቱሙዋፐ ስሰና፤ ኡባ ዳንዳይያ ጾሳይ ሄዋ ሀይዘና።"]},{"type":"verse","number":14,"content":["“ኢዮባ፥ ኔን፥ ‘ታን ጾሳ በአናዉ ዳንዳይከ፤ ታ ሞቱ አ ስንን ደኤ፤ ታን አ ናጋይ’ ያጋሳ። ያትና፥ ነዉ እ ዛሩዋ እማናዉ፥ ነ ጋሱ አይ ኬሻ ጉጻንዴሻ!"]},{"type":"verse","number":15,"content":["ጾሳይ አሳ ሙረናባነ ናጋራካ ሸነኮ ጊደ አግ አግያዋ ጋደ ቆፓይ?"]},{"type":"verse","number":16,"content":["ሄዋ ግዶፐ፥ ኔን ነ ዶና ጮ መላ ዶያሳ፤ ኤራይ ባይና ሃሳያ ዳርሳሳ” ያጌዳ።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":15}