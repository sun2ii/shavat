{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"JON","translationId":"dwr_ent","name":"ዮናሳ","commonName":"ዮናሳ","title":"ዮናሳ ትምቢትያ","order":32,"numberOfChapters":4,"sha256":"5b07eb7704a3a120fcc13bf3691e949f2923dc7fca1078ab6c9c426d7a9f85cf","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/dwr_ent/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["ዮናሳ ዎሳ"]},{"type":"verse","number":1,"content":["ዮናስ ሞልያ ኡሉዋን ደኢደ፥ ሀዋዳን ያጊደ፥ መና ጎዳኮ፥ ባረ ጾሳኮ፥ ዎሴዳ፤"]},{"type":"verse","number":2,"content":["“ታን ታ ቱጋ ግዶን ደኣደ መና ጎዳ ጼሳድ፤ ጼስና እ ታዉ ኮዬዳ። ታን ስኦልያ ኡሎ ግዶን ደኣደ ዋሳድ፤ ኔንካ ታ ዋሱዋ ስሳዳ።"]},{"type":"verse","number":3,"content":["ኔን ታና ጪማ አባ ጋርሳን ዱገ ኦላዳ፤ ሃይ ታ ዩሹዋ ዶዴዳ፤ ነ ኡምቡለትያ ነ ቤታይ ታ ቦላና አድኖ።"]},{"type":"verse","number":4,"content":["ሄዋ ግሻዉ፥ ታን ሀዋዳን ያጋድ፤ ‘ታን ነ ስንፐ ዎራ ኦለታድ፤ ግዶፐነ፥ ታን ነ ጌሻ ጎልያ ዛራደ በአና’ ያጋድ።"]},{"type":"verse","number":5,"content":["“ሃይ ታዉ ቆያ ጋካናዉ ምቴዳ፤ ጪማ አባይ ታና ሙኬዳ፤ አባን ደእያ ማታይካ ታ ሁጲያን ጻጸቴዳ።"]},{"type":"verse","number":6,"content":["ታን ደር ባሰቴዳ ሳኣ ዱገ ዎአድ፤ ቢታንነ አ ኩቡዋን መናዉ ጎርደታድ። ሽን አቤት መና ጎዳዉ፥ ታ ጾሳዉ፥ ኔን ታ ሸምፑዋ ጪማ ኦላፐ ከሳዳ።"]},{"type":"verse","number":7,"content":["“ታን ዎደ፥ ኔና መና ጎዳ ሀሳያድ። ታ ዎሳይካ ኔኮ፥ ነ ጌሻ ጎልያ ማቅዳስያ ጋኬዳ።"]},{"type":"verse","number":8,"content":["ሀዳ ኤቃቶ ጎይንያዋንቱ ግኦድአን አማነትያዋ አጌድኖ።"]},{"type":"verse","number":9,"content":["ሽን ታን ጋላታና ነዉ ያርሻና፤ ታን ሺቄዳዋ ኡባካ ጋና። አያዉ ጎፐ፥ አቶተይ መና ጎዳፐ ዬ” ያጌዳ።"]},{"type":"verse","number":10,"content":["ሄዋፐ ጉየ፥ መና ጎዳይ ሞልያ አዛዝና፥ ሞሊ ዮናሳ ቢታ ቦላን ጮሼዳ።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}