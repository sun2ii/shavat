{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"MAL","translationId":"dwr_ent","name":"ሚልክያሳ","commonName":"ሚልክያሳ","title":"ሚልክያሳ ትምቢትያ","order":39,"numberOfChapters":4,"sha256":"648a1eacd87d28cb8c43ae14a8245e80514680fe64189c7d0b0628252bb29ee8","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/MAL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/dwr_ent/MAL/4.json","totalNumberOfVerses":55},"chapter":{"number":4,"content":[{"type":"heading","content":["መና ጎዳ ጋላሳይ ማታቴዳ"]},{"type":"verse","number":1,"content":["ኡባፐ ዎልቃማ መና ጎዳይ ሀዋዳን ያጌ፤ “በእተ፥ ጮጭያ ታማዳን ኤጽያ ጋላሳይ ማታቴዳ፤ ኦቶረትያዋንቱነ ኢታ ኦያዋንቱ ኡባይ ኡቱላ ማላ ግዳናዋ። ሄ ይያ ጋላሳይ ኡንቱንታ ጹጋና፤ ኡንቱንቶ ጻጱዋ ጼራካ አሸና።"]},{"type":"verse","number":2,"content":["ሽን ህንተንቶ፥ ታ ሱንዉ ያይያዋንቶ አ ቀፍያ ግዶን ፓያባይ ደእያ ጽሎተ አዋይ ሞካና። ህንተካ አቁዋፐ ብለቴዳ ጋሎ ማራዳን ቡራቃና።"]},{"type":"verse","number":3,"content":["ታን ኦያ ጋላስ፥ ናጋራንቻቱ ህንተ ገድያፐ ጋርሳ ባጋና ብድን ማላ ግዳናዋንታ፤ ህንተካ ኡንቱንታ የንታ። ታን ኡባፐ ዎልቃማ መና ጎዳይ ሀዋ ኦዳይ።"]},{"type":"verse","number":4,"content":["“እስራኤልያ አሳ ኡባዉ ሲና ደርያ ቦላን ታን ታ ቆማ ሙሴ ባጋና አዛዜዳ አዛዙዋነ ህግያ ሀሳይተ።"]},{"type":"verse","number":5,"content":["“በእተ፥ ግታነ ቦንቼቴዳ ጾሳ ጋላሳይ ያናፐ ካሰታደ፥ ታን ህንተዉ ትምቢትያ ኦድያ ኤላሳ ኪታና።"]},{"type":"verse","number":6,"content":["እ ዪደ፥ ታን ያደ ቢታ ሸቃን ሾጨናዳን፥ አዎቱዋ ዎዛና ናናቱዋኮ፥ ናናቱዋ ዎዛናካ አዎቱዋኮ ዛራና” ያጌ ኡባፐ ዎልቃማ መና ጎዳይ።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/MAL/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/MAT/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/MAL/3.json","previousChapterAudioLinks":{},"numberOfVerses":6}