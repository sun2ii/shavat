{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"NUM","translationId":"dwr_ent","name":"ፓይዱዋ","commonName":"ፓይዱዋ","title":"ፓይዱዋ ማጻፋ","order":4,"numberOfChapters":36,"sha256":"030aac30e644aa025a8846cbc98be8346bc0a501184ca5dcaedb00043dfc9c08","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/dwr_ent/NUM/36.json","totalNumberOfVerses":1248},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["እስራኤልያ አንጅያዌ መና ጎዳ ናሸቼዳዋ ባላም በኤዳ ዎደ፥ ካሰ እ ኦዳዋዳን ሙሩናናዉ ኮይቤና፤ ሽን ባረ ሶምኡዋ መላ ቢታኮ ዛሬዳ።"]},{"type":"verse","number":2,"content":["ያቲዴ ቁ ጊ ጼሊደ፥ እስራኤልያ አሳይ ባረ ዛርያን ዛርያን ዱንካን ኡቴዳዋ በኤዳ፤ ጾሳ አያናይ አ ቦላ ዎዳ።"]},{"type":"verse","number":3,"content":["እ ባረ ትምቢትያ ሀዋዳን ያጊደ ኦዴዳ፤",{"text":"“ብኦራ ናኣ ባላማ ትምቢቲ፥","poem":1},{"text":"አ አይፊ ትሽ ኦ ጼልያዋ ትምቢቲ፥","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጾሳይ ግያዋ ስስያዋ ትምቢቲ፥","poem":1},{"text":"ልጭ ጊደ ጉፋንና፥","poem":2},{"text":"አ አይፊ ዶየቴዳዋነ","poem":1},{"text":"ኡባ ዳንዳይያ ጾሳ ሳፃ በእያዋ ትምቢቲ ሀዋ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ያቆባ ዛረቶ፥ ህንተ ዱንካነቱ፥","poem":1},{"text":"እስራኤልያ አሳዉ፥ ህንተ ደእያ ሳአቱካ፥","poem":2},{"lineBreak":true},{"text":"ዎት ሎኤ!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኡንቱንቱ ምጨቴዳ ዎምባዳን፥","poem":1},{"text":"ሻፋ ዶናን ደእያ አታክልትያ ሳኣዳን፥","poem":2},{"text":"መና ጎዳይ ቶኬዳ ጎዳረ ኡዳንነ","poem":1},{"text":"ሃ ዶናን ደእያ ዝጋዳን ሀኒኖ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኡንቱንቶ ዳሮ ሃይ ፑልታና፤","poem":1},{"text":"ኡንቱንቱ ዛረቶ ግድያ ሃይ ደአና።","poem":2},{"text":"ኡንቱንቱ ካቲ ካትያ አጋጋፐ ግታታና፤","poem":1},{"text":"ኡንቱንቱ ካዉተይካ ቦንቼታና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጾሳይ ኡንቱንታ ግብጼፐ ከሴዳ፤","poem":1},{"text":"እ ምኖ መንዳን ኡንቱንቶ ደኤ።","poem":2},{"lineBreak":true},{"text":"ኡንቱንቱ ሞርከ ካዉተ ምታና፤","poem":2},{"lineBreak":true},{"text":"ኡንቱንቱ መቀካ ሊቅሳና፤","poem":2},{"lineBreak":true},{"text":"ኡንቱንቱ ባረንቱ ዎንዳፍያ ዙቢያን ኡንቱንታ ጫዳና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እስራኤልያ አሳይ ጋሙዋዳን ግሴ።","poem":1},{"text":"ማጫ ጋማትዳን ኡንቱንታ ደንናዉ ኦን ጻላኔ?","poem":2},{"text":"ህንተና አንጅያ ኡባይ አንጀቴዳዋ ግዳናዋ፤","poem":1},{"text":"ህንተና ሸቂያ ኡባይ ሸቀቴዳዋ ግዳናዋ” ያጌዳ።","poem":2}]},{"type":"verse","number":10,"content":["ሄዋፐ ጉይያን፥ ባላቅ ባላማ ቦላ ሀንቁዋ ኤጽ ከሴዳ። ባላቅ ባረ ኩሽያ ዱኪደ ባላማ፥ “ታ ሞርከቱዋ ቃንጋናዳን ታን ኔና ጼሳድ፤ ሽን ኔን ሀ ሄዙ ገደካ ኡንቱንታ አንጃዳ።"]},{"type":"verse","number":11,"content":["ስም ሀእ ኔን ነ ጎለ ባቃታ፤ ‘ታን ነዉ ዳሮባ ዎይታና’ ጋድ፤ ሽን ኔን ዎይቱዋ አከናዳን መና ጎዳይ ኔና ድጌዳ” ያጌዳ።"]},{"type":"verse","number":12,"content":["ባላም ባላቃ ዛሪደ፥ “ኔን ታኮ ኪቴዳዋንቱነ፥"]},{"type":"verse","number":13,"content":["‘ባላቅ ሀራይ አቶ ባረ ብራይነ ዎርቃይ ኩሜዳ ባረ ካትያ ጎልያ ታዉ እሜዳዋ ግድንቶነ፥ መና ጎዳይ ኦዴዳዋ አደ፥ ሎኡዋ ዎይ ኢታ ታ ሸንያን ኦናዉ ዳንዳይከ። ታን መና ጎዳይ ግያዋ ጻላላ ጋና’ ያጋደ ነዉ ኦዳበይክታየ?” ያጌዳ።"]},{"type":"heading","content":["ባላማ ዉርሰ ትምቢትያ"]},{"type":"verse","number":14,"content":["ያጊደ፥ “ታን ሀእ ታ አሳኮ ባይ፤ ሽን ኔን ሃያ፤ ሀ አሳይ ዉርሰ ዎድያን ነ አሳ ኦናዋ ታን ነዉ ኦዳና” ያጌዳ።"]},{"type":"verse","number":15,"content":["እ ባረ ትምቢትያ ሀዋዳን ያጊደ ኦዴዳ፤",{"text":"“ብኦራ ናኣ ባላማ ትምቢቲ፥","poem":1},{"text":"አ አይፊ ትሽ ኦደ ጼልያዋ ትምቢቲ፥","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ጾሳይ ግያዋ ስስያዋነ፥","poem":1},{"text":"ኡባፐ ቂያ ጾሳፐ","poem":2},{"lineBreak":true},{"text":"ግዴዳ ኤራተይ ደእያዋ ትምቢቲ፥","poem":2},{"lineBreak":true},{"text":"ልጵ ጊደ ጉፋንና፥","poem":2},{"lineBreak":true},{"text":"አ አይፊ ዶየቴዳዋነ","poem":2},{"lineBreak":true},{"text":"ኡባ ዳንዳይያ ጾሳ ሳፃ በእያዋ ትምቢቲ ሀዋ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ታን አ በአይ፤ ሽን ዎዲ ሀአ ግደና፤","poem":1},{"text":"ታን አ ጼላይ፤ ሽን ማታን ግደና።","poem":2},{"text":"ያቆባ ዛርያፐ ጾልንቲ ከሳና።","poem":1},{"text":"እስራኤልያፐ ካተቱዋ ጻምአይ ከሳና።","poem":2},{"text":"ሞኣባ አሳ ሶምኡዋ እ ጋጭ ቆላና።","poem":1},{"text":"ሴተ አሳ ኡባ ሁጲያ እ ክንቻና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ኤዶም ጾነታና፤","poem":1},{"text":"አ ሞርኪ ሰኢርካ ጾነታና፤","poem":2},{"text":"ሽን እስራኤሊ ምን ምኒደ ባና።","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ያቆባፐ ሞድያዌ ከሳና፤","poem":1},{"text":"ኡንቱንቱ ካታማን ፓጻ አቴዳዋንታ ይሳና” ያጌዳ።","poem":2}]},{"type":"verse","number":20,"content":["ሄዋፐ ጉይያን፥ ባላም አማሌቃ አሳቱዋ በኢደ፥ ባረ ትምቢትያ ሀዋዳን ያጊደ ኦዴዳ፤",{"lineBreak":true},{"text":"“ካዉተቱዋ ግዶን አማሌቅ ኮይሮ፤","poem":1},{"text":"ሽን ኡንቱንቱ ዉርሰይ ዮ” ያጌዳ።","poem":2}]},{"type":"verse","number":21,"content":["ቃይ ባላም ቄና አሳቱዋ በኢደ፥ ባረ ትምቢትያ ሀዋዳን ያጊደ ኦዴዳ፤",{"text":"“ህንተ ደእያ ሳአይ ሳሮ ሳ ግዴ፤","poem":1},{"text":"ህንተ ጎሊ ዛላ ቦላን ኬጸቴዳ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ሽን አሶረቱ ህንተና ኦሞድያ ዎደ፥","poem":1},{"text":"ህንተ ቄና አሳቱ ያና” ያጌዳ።","poem":2}]},{"type":"verse","number":23,"content":["ሄዋፐ ጉይያን፥ ባላም ባረ ትምቢትያ ሀዋዳን ያጊደ ኦዴዳ፤",{"text":"“አየ አና!","poem":1},{"text":"ጾሳይ ሀዋ ኦያ ዎደ፥","poem":2},{"lineBreak":true},{"text":"ኦን ደአና ዳንዳዪ?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ማርካባቱ ክቲማ ሀሩሩዋፐ ያና፤","poem":1},{"text":"ኡንቱንቱ አሶረቱዋነ ኤቤራቱዋ ኡቁናና፤","poem":2},{"text":"ሽን ቃይ ኡንቱንቱካ ያና” ያጌዳ።","poem":1}]},{"type":"verse","number":25,"content":["ሄዋፐ ጉይያን፥ ባላም ደንዲደ፥ ባረ ጎለ ስሜዳ፤ ባላቅካ ባረ ኦግያ ቤዳ።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/NUM/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/NUM/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/NUM/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}