{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PRO","translationId":"dwr_ent","name":"ሌምሱዋ","commonName":"ሌምሱዋ","title":"ሌምሱዋ ማጻፋ","order":20,"numberOfChapters":31,"sha256":"5f8942c6d27ec9b4e6d0148c9cfb29de3999dd2ad5f6829aff8cdec668e23ffb","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/dwr_ent/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":2,"content":[{"type":"heading","content":["አዳ ኤራተፐ ቤትያ አንጁዋ"]},{"type":"verse","number":1,"content":["ታ ናአዉ፥ ኔን ታ ግያዋ አኮፐ፥ ታ አዛዙዋካ ነ ግዶን ምንጆፐ፥"]},{"type":"verse","number":2,"content":["አዳ ኤራተ ሀይዞፐ፥ ነ ዎዛናፐ አኬኮፐ፥"]},{"type":"verse","number":3,"content":["ኤራተ ጼሶፐ፥ አኬካካ ቁ ኦደ ጼሳ።"]},{"type":"verse","number":4,"content":["አሳይ ብራ ዎይ ቆሴዳ ሚሻ ኮይያዋዳን፥ ኔን ኤራተ ኮያ።"]},{"type":"verse","number":5,"content":["ሄ ዎደ ኔን መና ጎዳዉ ያዬ ግያዌ አየንቶ አኬካና፤ ጾሳካ ሎይደ ኤራና።"]},{"type":"verse","number":6,"content":["አያዉ ጎፐ፥ መና ጎዳይ አዳ ኤራተ እሜ፤ አፐ ኤራተይነ አኬካይ ቤቴ።"]},{"type":"verse","number":7,"content":["እ ሱረቶ ማድያ ዞርያ ምንጄ፤ ቶሺ ባይናን ሀመትያዋንቶካ እ ጎንዳልያ።"]},{"type":"verse","number":8,"content":["ቱሙዋ ፕርዳ ኦግያ ናጌ፤ ባረዉ አማነትያዋንቱ ኦግያካ ናጌ።"]},{"type":"verse","number":9,"content":["ሄ ዎደ ኔን ጽሎተ፥ ሱረ ፕርዳ፥ ሱረተነ ሎኦ ኦሱዋ ኡባ ኤራና።"]},{"type":"verse","number":10,"content":["አያዉ ጎፐ፥ አዳ ኤራተይ ነ ዎዛና ገላና፤ ኤራተይካ ነ ሸምፖ ናሸቻ ግዳና።"]},{"type":"verse","number":11,"content":["ኔና አዱስ ቆፕያዌ ናጋና፤ አኬካይካ ኔና ናጋና።"]},{"type":"verse","number":12,"content":["አዳ ኤራተይ ኔና ኢታ አሳቱዋ ኦግያፐ ናጋና፤ ጌላባ ሃሳይያዋንቱፐ አሻና።"]},{"type":"verse","number":13,"content":["ኡንቱንቱ ናጋራ ማን ደአናዉ፥ ጽሎተ ኦግያ አጊኖ።"]},{"type":"verse","number":14,"content":["ኢታ ኦያዋን ናሸቲኖ፤ ጌላባን ሀሹ ጊኖ።"]},{"type":"verse","number":15,"content":["ኡንቱንቱ ኦያዌ ምርቀ፤ ኡንቱንቱ ደኡካ ጌላ።"]},{"type":"verse","number":16,"content":["አዳ ኤራተይ ዎሹምያ ምሽራትፐነ ሸሌሽያ ቃላን ሃሳይያ ላገትፐ ኔና አሻና።"]},{"type":"verse","number":17,"content":["እዛ ባረ ናአተ አስና አጋዉ፤ ባረ ጾሳ ስንን ጫቀቴዳ ጫቁዋካ ዶጋዉ።"]},{"type":"verse","number":18,"content":["እዝ ጎለ ብያዌ ሀይቃናዉ ብያዋ፤ እዝ ኦጊ ሀይቆ ካለ።"]},{"type":"verse","number":19,"content":["ኢኮ ብያ ኦንካ ጉየ ስመና፤ ደኡዋ ኦግያካ ደመና።"]},{"type":"verse","number":20,"content":["ሄዋ አጋደ፥ ኔን ሎኦ አሳቱዋ ሌምሱዋ ካላ፤ ጽሎ አሳቱዋ ደኡዋካ ቁላ።"]},{"type":"verse","number":21,"content":["አያዉ ጎፐ፥ ሱረ አሳቱነ ቶሺ ባይና አሳቱ ቢታን ጋምኢደ ደአና።"]},{"type":"verse","number":22,"content":["ሽን ኢታቱ ቢታፐ ቆለታና፤ አማንተናዋንቱካ ሾደቲደ ያና።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}