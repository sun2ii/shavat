{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PRO","translationId":"dwr_ent","name":"ሌምሱዋ","commonName":"ሌምሱዋ","title":"ሌምሱዋ ማጻፋ","order":20,"numberOfChapters":31,"sha256":"5f8942c6d27ec9b4e6d0148c9cfb29de3999dd2ad5f6829aff8cdec668e23ffb","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/dwr_ent/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":9,"content":[{"type":"heading","content":["አዳ ኤራተነ ቦዛተ"]},{"type":"verse","number":1,"content":["አዳ ኤራተታ ባረ ጎልያ ኬጻዱ፤ ሄ ጎልያዉ ላፑን ቱሳቱዋ ኤሳዱ።"]},{"type":"verse","number":2,"content":["እዛ ባረ ጊግስያ ሾብያዉ ሞ መህያ ሹካዱ፤ ዎይንያ ኤሳካ አጋደ ጊግሳዱ። ማዳ ስንዉ አዱ።"]},{"type":"verse","number":3,"content":["ያታደ አሳ ጼሳናዉ ባረ ቆማቱዋ ኪታዱ። ቆማቱ ካታማዉ ቃ ሳኣን ኤቂደ፥"]},{"type":"verse","number":4,"content":["“ህንተኖ፥ ኤራይ ፓጬዳዋንቶ ሀዋ ገልተ!” ያጌድኖ። ቦዛቱዋካ እዛ ሀዋዳን ያጋዱ፤"]},{"type":"verse","number":5,"content":["“ሃ ዪተ፤ ታ ቁማ ሚተ፤ ታን አጌዳ ዎይንያ ኤሳካ ኡሽተ!"]},{"type":"verse","number":6,"content":["ቦዛተ አጊደ፥ ደኡዋን ደእተ፤ አኬካ ኦግያን ሀመትተ” ያጋዉ።"]},{"type":"verse","number":7,"content":["ቅሊጭያ ኡራ ሴርያ አሳይ ባረዉ ቦርያ አኬ፤ ኢታ ኡራ ዞርያዌካ ባረዉ ቆሄቴ።"]},{"type":"verse","number":8,"content":["ቅሊጭያ ኡራ ዞሮፓ፤ እ ኔና እጻና። አዳ ኤራንቻ ኡራ ዞራ፤ እ ኔና ዶሳና።"]},{"type":"verse","number":9,"content":["አዳ ኤራንቻ ኡራ ታማርሳ፤ ያቶፐ፥ እ ካሰዋፐካ አዳ ኤራንቻ ግዳናዋ። ጽሎ ኡራካ ታማርሳ፤ ያቶፐ እ ኤራ ጉጃና።"]},{"type":"verse","number":10,"content":["አዳ ኤራተዉ ዶመይ መና ጎዳዉ ያይያዋ፤ ጌሻ ጾሳ ኤርያዌ አኬክያዋ።"]},{"type":"verse","number":11,"content":["ታናን ነ ላይይ ዳራና፤ ነ ደኡዋ ላይይካ አዱቃና።"]},{"type":"verse","number":12,"content":["ኔን አዳ ኤራንቻ ግዶፐ፥ ነ ሁጲያዉ ጎኤታሳ። ኔን ቅሊጭያዋ ግዶፐካ፥ ነ ሁጲያዉ ቆሄታሳ።"]},{"type":"verse","number":13,"content":["ቦዛ ምሽራታ ዋላሳ ዳራዉ፤ እዛ ባረና ናገናዉኖ። እዛ አይነ ኤሩኩ።"]},{"type":"verse","number":14,"content":["እዛ ባረ ካረን፥ ዎይ ካታማዉ ቃ ሳኣን ኦይድያን ኡታዉ።"]},{"type":"verse","number":15,"content":["ሱረ ባረንቱ ኦግያ ኦይቂደ ብያ አሳ ጼሳደ፥"]},{"type":"verse","number":16,"content":["“ህንተኖ፥ ኤራይ ፓጬዳዋንቶ፥ ታኮ ሃ ዪተ” ያጋዉ። አኬካይ ባይናዋካ፥"]},{"type":"verse","number":17,"content":["“ዉኢደ ኡሽያ ሃይ ማልኤ፤ ጌማን ምያ ቁማይካ ናሸቼ” ያጋዉ።"]},{"type":"verse","number":18,"content":["ሽን እ ሀይቄዳ አሳይ ያን ደእያዋ፥ እዝ እማቱካ ዱፉዋ ጪሞ ግዶን ደእያዋ ኤረና።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}