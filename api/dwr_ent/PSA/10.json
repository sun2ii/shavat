{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":10,"content":[{"type":"heading","content":["ፕርዳ ደማናዉ ሺቄዳ ዎሳ"]},{"type":"verse","number":1,"content":[{"text":"አቤት መና ጎዳዉ፥ አያዉ ሃካደ ኤቃይ?","poem":1},{"text":"መቱዋ ዎድያን አያዉ ኔን ጌማይ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ባረ ኦቶሩዋን ኢታ አሳይ ህዬሳ ሻንካቴ።","poem":1},{"text":"ኡንቱንቱ ባረንቱ ፓላ ማቁዋን ባረንቶ ኦይቀትኖ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ሄ ኢታይ ባረ ዎዛና ኢታ አሙዋን ጬቀቴ፤","poem":1},{"text":"ዮራንቻይ መና ጎዳ ቦላ ኢታ ቃላ ሃሳዬነ ካዴ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኢታይ ባረ ኦቶሩዋን ጾሳ ኮየና፤","poem":1},{"text":"ባረ ቆፋ ኡባንካ ጾሳ አይነ ኮየና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ኡባባይ አዉ ኡባ ዎደካ ኩሜ፤","poem":1},{"text":"እ ኦቶሩዋ ጴጻሌ።","poem":2},{"text":"ነ ህጊ አዉ ገለና፤","poem":1},{"text":"ባረ ሞርከቱዋ ቦላን እ ቅሊጬ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ባረ ዎዛናን እ፥ “ታና አያይነ ቃና።","poem":1},{"text":"ታና ኡባካ መቱ ጋከና” ያጊደ ቆፔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አ ዶናን ሸቃይ፥","poem":1},{"text":"ዎርዱነ ማንደይ ኩሜዳ።","poem":2},{"text":"ባረ እንጻርሳን ገነባነ ኢታባ ሃሳያናዉ ኤሌሌ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ሄራን ቆሰትያሳን እ ዙጊደ ኡቴ።","poem":1},{"text":"ባረ ዎያዋ ዎናዉ ቆሰት ናጊደ፥","poem":2},{"lineBreak":true},{"text":"ዎልቃይ ባይና አሽከቱዋ ጼሌ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ባረ ቆሰትያሳን ጌሚደ፥","poem":1},{"text":"ህዬሳ ኦይቃናዉ ጋሙዋዳን ዙጌ።","poem":2},{"text":"እ ህዬሳ ኦይቂደ፥ ባረ ጲርያን ጎቺደ አፌ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ያትና፥ ዎልቃይ ባይና ህዬሳይ ሾጨቴ፤","poem":1},{"text":"ንፕ ጌነ ሄ ምኑዋን ጾነቴ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እ ባረ ዎዛናን፥ “ጾሳይ ታና ዶግ ክቼዳ።","poem":1},{"text":"ባረ ሶምኡዋ ታፐ ገን ክቼዳ፤","poem":2},{"lineBreak":true},{"text":"ኡባካ እ በኤና” ያጌ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"አቤት መና ጎዳዉ፥ ደንዳ።","poem":1},{"text":"ጾሳዉ፥ ነ ኩሽያ ቁ ኦደ ደን፤","poem":2},{"lineBreak":true},{"text":"ህዬሳ ዶጎፓ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ናጋራንቻ ኡራይ ባረ ዎዛናን፥","poem":1},{"text":"ጾሳ አያዉ ካ?","poem":2},{"text":"ባረ ቆፋንካ፥ “ጾሳይ ታና ሙረና”","poem":1},{"text":"አያዉ ያጊ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ሽን ጾሳዉ፥ ኔን ቱሙካ በኣሳ፤","poem":1},{"text":"መቱዋካ ዋይያካ ጼላሳ።","poem":2},{"text":"ኔን ኡባ ዎደ ኑና ማዳናዉ ጊጋ ኡታዳ።","poem":1},{"text":"ዪአቶ ኔን ማዱዋ።","poem":2},{"text":"ቆሄቴዳዌ ኔን ማዳናዳን ባረና ነዉ ሼ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ገንያዋንቱ ዎልቃ ኔን ዉርሳ፤","poem":1},{"text":"ኢታ አሳቱዋካ ሄዋዳ ኦ።","poem":2},{"text":"ላኤን ኡንቱንቱ ግዶን ኢታተይ ቤተና ማላ ኡንቱንታ ሙራ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"መና ጎዳይ መ መናዉ ካተቲደ ደኤ፤","poem":1},{"text":"ሀራ ካዉተቱ አ ቢታፐ ያና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"አቤት መና ጎዳዉ፥","poem":1},{"text":"ኔን ባረንታ ካዉሽያዋንቱ አሙዋ ስሳሳ።","poem":2},{"text":"ኔን ኡንቱንታ ምንሳ።","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ይአቶነ ኡንኤቴዳዋንቶ ቱሙዋ ፕርዳ፤","poem":1},{"text":"ሳኣን ደእያ አሳይ፥ ኡንቱንታ ያሽሰና ማላ፥","poem":2},{"text":"ኡንቱንቱ ዋሱዋ ስሳሳ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}