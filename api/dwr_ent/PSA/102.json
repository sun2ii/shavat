":"ታን ግስና፥ ገምእሹ ዬና፤","poem":1},{"text":"ታን ጎልያ ሁጲያን ባረካ ኡቴዳ ካፉዋ ማላ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታ ሞርከቱ ጋላሳ ኡባን ታና ጫሺኖ፤","poem":1},{"text":"ታና ቅሊጭያዋንቱ ታ ሱንን ሸቂኖ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ታን ብድን ቁማዳን ማይ፤","poem":1},{"text":"ቃይ ታ አፎ ታ ኡሻና ዋላካይ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኔን ታና ፑደ ደንደ፥","poem":1},{"text":"ነ ሀንቁዋ ድራዉ ዎራ ኦላዳ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ ደኡዋ ላይይ ኦማርሳ ኩዋ ማላ፤","poem":1},{"text":"ታን ማታዳን ሹላይ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ሽን አቤት መና ጎዳዉ፥","poem":1},{"text":"ኔን ካዉተ አራታን መናዉ ኡታዳ፤","poem":2},{"lineBreak":true},{"text":"ነ ሱንይካ የለታፐ የለታ ጋካናዉ ሀሳየታና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኔን ደንዳደ፥ ጽዮነዉ ቃረታ፤","poem":1},{"text":"አያዉ ጎፐ፥ ኔን እዞ ማርያ ዎዲ ጋኬዳ፤","poem":2},{"lineBreak":true},{"text":"ሀዌ ኔን ዶሬዳ ዎድያ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እዛ ኮለቴዳዋ ግዶፐካ፥","poem":1},{"text":"ነ ቆማቱ እዞ ሲቂኖ።","poem":2},{"text":"እዛ ባዬዳዋ ግዶፐካ፥","poem":1},{"text":"ኡንቱንቱ እዝዉ ቃረቲኖ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ካዉተቱ መና ጎዳ ሱንዉ ያያና፤","poem":1},{"text":"ሳኣ ካተቱ ኡባይ አ አንጋዉ ዳጋማና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አያዉ ጎፐ፥ መና ጎዳይ ጽዮነ ዛረ ኬጺደ፥","poem":1},{"text":"እ ባረ ግታተ በሳና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እ ፑቴሳቱዋ ዎሳ ስሳና፤","poem":1},{"text":"ኡንቱንቱ ዋሱዋ ካና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ብሮ የለታና አሳቱ መና ጎዳ ጋላታና ማላ፥","poem":1},{"text":"ሀዌ ይያ የለታዉ ጻፈቶ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"መና ጎዳይ ቃን ደእያ ባረ ጌሻ ሳኣፐ ዱገ ጼሌዳ፤","poem":1},{"text":"እ ሳሉዋፐ ዱገ ሳኣ ጾሞሴዳ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ሄዌነ፥ ቃሸቴዳ አሳቱዋ ኦልያ ስሳናሳነ","poem":1},{"text":"ሀይቆ ፕርደቴዳ አሳቱዋ ብላናሳ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሄዋ ድራዉ፥ መና ጎዳ ሱንይ ጽዮነን ኦደታናነ","poem":1},{"text":"አ ጋላታይ የሩሳላመን አዋየታና።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"አሳይነ ካዉተይ እትፐ ሺቂደ፥","poem":1},{"text":"መና ጎዳዉ ሄ ዎደ ጎይናና።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"እ ታን ያላጋተን ደኢና፥","poem":1},{"text":"ታ ዎልቃ ዉርሴዳ፤","poem":2},{"lineBreak":true},{"text":"ታ ላይ ቃንዬዳ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ያትና፥ ታን፥ “አቤት ታ ጾሳዉ፥","poem":1},{"text":"ታ ላይይ ብሮ ግዶትያ ዎደ፥","poem":2},{"lineBreak":true},{"text":"ታና አፎፓ” ያጋይ።","poem":2},{"lineBreak":true},{"text":"አቤት ጾሳዉ፥ ኔን የለታፐ የለታ ጋካናዉ ደኣሳ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ኔን በን ሳኣ መዳ፤","poem":1},{"text":"ሳሉካ ነ ኩሽያ ኦሱዋ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ሄዋንቱ ኡባይ ያና፤ ሽን ኔን ደአና፤","poem":1},{"text":"ኡንቱንቱ ኡባይካ አፍላዳን ዉራና።","poem":2},{"text":"ኔን ኡንቱንታ ጩርቃ አፍላዳን ላማና፤","poem":1},{"text":"ኡንቱንቱካ አና።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ሽን ኔን ኔናካ፤ ነ ላይይ ኡባ ዉረና።","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"ኑን ነ ቆማቱዋ፤","poem":1},{"text":"ኑ ናናቱ ሳሮተን ደአና።","poem":2},{"text":"ኡንቱንቱ ዘረይካ ነ ስንን ምኒደ ኤቃና።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}