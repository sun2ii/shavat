:"verse","number":22,"content":[{"text":"አዋይ ከስያ ዎደ፥","poem":1},{"text":"ጉየ ስሚደ ባረንቱ ጌሱዋን ግሲኖ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ሄ ዎደ አሳይ ባረ ኦሶ ከሴ፤","poem":1},{"text":"ሳአይ ቃማና ጋካናዉ ኦ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"አቤት መና ጎዳዉ፥ ነ ኦሱ አይ ኬሻ ዳሬ!","poem":1},{"text":"ነ አዳ ኤራተን ኔን ኡንቱንቱ ኡባ መዳ፤","poem":2},{"lineBreak":true},{"text":"ሳአይ ኔን መዳዋን ኩሜዳ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"አባይ ህንን ሄዌሽ፤ እ ዎልቃማነ አኮ፤","poem":1},{"text":"ፓይዱ ባይና ቃጽያ መታቱዋን፥","poem":2},{"lineBreak":true},{"text":"ግታቱዋንነ ጉቱዋን ኩሚደ ደኤ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ሄዋ ቦላን ማርካባቱ ቢኖ፤","poem":1},{"text":"ቃይ ኔን መዳ ሌዋታና ግያ ዳዊ አን ካኤ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ኔን ኡንቱንታ ኮሽያ ዎድያን","poem":1},{"text":"ኡንቱንቶ ቁማ እማና ማላ፥","poem":2},{"lineBreak":true},{"text":"ኡንቱንቱ ኡባይ ኔና ጼሊኖ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ኔን ኡንቱንቶ እምና፥ ኡንቱንቱ ማጺኖ፤","poem":1},{"text":"ኔን ነ ኩሽያፐ የግና፥","poem":2},{"lineBreak":true},{"text":"ኡንቱንቱ ሎኦባ ካሊኖ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ኔን ነ ሶምኡዋ ገንያ ዎደ ዳጋሚኖ።","poem":1},{"text":"ነ ሸምፑዋ ኔን አክያ ዎደ ሀይቂደ፥","poem":2},{"lineBreak":true},{"text":"ባረንቱ ቢታዉ ስሚኖ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ሽን ኔን ነ ሸምፑዋ ኪትያ ዎደ፥","poem":1},{"text":"ሀራቱ መቲኖ፤ ቢታካ ኦራሳ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"መና ጎዳ ቦንቹ መናዉ ደኦ፤","poem":1},{"text":"መና ጎዳይ ባረ ኦሱዋን ናሸቶ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"እ ቢታ ጼልና፥ ቢታይ ቃጼ፤","poem":1},{"text":"ቃይ እ ደረቱዋ ቦንችና፥ ደረቱ ጩዋቲኖ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ታን ታ ደኡዋ ኡባን መና ጎዳዉ የጻና፤","poem":1},{"text":"ታን ደኤዳ ላይ ኡባን ታ ጾሳ ሳባና።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ታን መና ጎዳን ናሸትያ ድራዉ፥","poem":1},{"text":"ታ ቆፋይ አ ናሸቾ።","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ናጋራንቻቱ ቢታፐ ይኖ፤","poem":1},{"text":"ሀዋፐ ስንዉ ኢታቱ ደኦፕኖ።","poem":2},{"lineBreak":true},{"text":"ታ ሸምፓቴ፥ መና ጎዳ ጋላታ! መና ጎዳ ጋላትተ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}