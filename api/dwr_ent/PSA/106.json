verse","number":33,"content":[{"text":"አያዉ ጎፐ፥ ኡንቱንቱ አ ሀንቀድኖ፤","poem":1},{"text":"ሙሴ ዶናፐ በሰና ቃላይ ከሴዳ።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"መና ጎዳይ ይስተ ጊና፥","poem":1},{"text":"ኡንቱንቱ ካናነ አሳቱዋ ይስበይክኖ።","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ሄዋፐካ፥ ኡንቱንቱ ሄ አሳቱዋና","poem":1},{"text":"ገለት አከቲደ፥ ዋላከቴድኖነ፤","poem":2},{"lineBreak":true},{"text":"ኡንቱንቱ ደኡዋ ዎጋ ካሌድኖ።","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ጾሳ አሳቱ ኡንቱንቱ ኤቃዉ ጎይኔድኖ፤","poem":1},{"text":"ሄዌነ፥ ኡንቱንቶ ጲረ ግዴዳ።","poem":2}]},{"type":"verse","number":37,"content":[{"text":"ኡንቱንቱ ባረንቱ አቱማነ ማጫ ናናቱዋ","poem":1},{"text":"ጻላሄቶ ያርሼድኖ።","poem":2}]},{"type":"verse","number":38,"content":[{"text":"ኡንቱንቱ፥ ጽሎ ሱ","poem":1},{"text":"ካናነ ኤቃቶ ያርሸድኖ፥","poem":2},{"lineBreak":true},{"text":"ባረንቱ አቱማነ ማጫ ናናቱዋ ሱ ጉሰድኖ፤","poem":2},{"lineBreak":true},{"text":"ሄ ሱን ቢታይ ቱኔዳ።","poem":2}]},{"type":"verse","number":39,"content":[{"text":"ሄዋዳን ኡንቱንቱ ባረንቱ ኦሱዋን ቱኔድኖነ፥","poem":1},{"text":"ሻርሙጻዳን ኡንቱንቱ ባረንቱ ጾሳዉ አማነተናን እጼድኖ።","poem":2}]},{"type":"verse","number":40,"content":[{"text":"ሄዋ ድራዉ፥ መና ጎዳ ሀንቁ፥","poem":1},{"text":"አ አሳ ቦላ ኤጽ ከሴዳ፤","poem":2},{"text":"እ ባረዋንታ ሸነቴዳ።","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"እ ኡንቱንታ ሀራ ጋድያ አሳቱዋ ኩሽያን አደ እሜዳ፤","poem":1},{"text":"ኡንቱንቱ እጼዳዋንቱ ኡንቱንታ ሞዴድኖ።","poem":2}]},{"type":"verse","number":42,"content":[{"text":"ኡንቱንቱ ሞርከቱ ኡንቱንታ ናቄድኖነ","poem":1},{"text":"ባረንቱ ሸንያዳን አይሴድኖ።","poem":2}]},{"type":"verse","number":43,"content":[{"text":"እ ኡንቱንታ ዳሮ ገደ አሼዳ፤","poem":1},{"text":"ሽን ኡንቱንቱ ማካላዉ ዳንጭ ደንዴድኖ፤","poem":2},{"lineBreak":true},{"text":"ባረንቱ ናጋራ ጋሱዋን ዬድኖ።","poem":2}]},{"type":"verse","number":44,"content":[{"text":"ግዶፐነ፥ እ ኡንቱንቱ ዋሴዳ ዋሱዋ ስሲደ፥","poem":1},{"text":"ኡንቱንቱ ዋይያ ቆፔዳ።","poem":2}]},{"type":"verse","number":45,"content":[{"text":"እ ኡንቱንቱ ድራዉ፥ ባረ ጫቁዋ ሀሳዬዳ፤","poem":1},{"text":"አገና ባረ ሲቁዋ ዳሩዋዳን ኡንቱንታ ማሬዳ።","poem":2}]},{"type":"verse","number":46,"content":[{"text":"ኡንቱንታ ኦሞዴዳ ኡባይ ኡንቱንቶ ቃረታናዳን ኦዳ።","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"አቤት መና ጎዳዉ፥ ኑ ጾሳዉ፥ ኑና አሻ።","poem":1},{"text":"ኑን ነ ጌሻ ሱን ጋላታናዳንነ","poem":2},{"lineBreak":true},{"text":"ነ ቦንቹዋን ጬቀታናዳን፥","poem":2},{"lineBreak":true},{"text":"ካዉተቱዋ ግዶፐ ኑና ሺሻ።","poem":2}]},{"type":"verse","number":48,"content":[{"text":"መና ጎዳይ፥ እስራኤልያ ጾሳይ","poem":1},{"text":"መናፐ መና ጋካናዉ ጋላተቶ!","poem":2},{"text":"አሳይ ኡባይ፥ “አመንእ!” ጎ።","poem":1},{"lineBreak":true},{"text":"መና ጎዳ ጋላትተ!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}