ne_break"},{"type":"verse","number":7,"content":[{"text":"ጾሳይ ባረ ጌሻ ሳኣን ሀዋዳን ያጌዳ፤","poem":1},{"text":"“ታን ጾናደ ሰኬማ ቢታ ሻካና፤","poem":2},{"lineBreak":true},{"text":"ቃይ ሱኮታ ዛንጋራ ግሻና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጋላኣደ ታዋ፤ ምናሰካ ታሳ፤","poem":1},{"text":"ኤፍሬም ታ ሁጲያ አሽያ ቆብያ፤","poem":2},{"text":"ይሁዳይ ታ ካዉተ ጻምኣ።","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ሞኣበ ታን ሜጨትያ ኩይጻሩዋ፤","poem":1},{"text":"ኤዶም ታዋ ግድያዋ ኤርሳናዉ","poem":2},{"lineBreak":true},{"text":"ታ ጫማ አ ቦላ ዎይ።","poem":2},{"lineBreak":true},{"text":"ታን ፕልስጼማ ጾናደ ገሬራይ” ያጌዳ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ግምበቴዳ ካታማኮ፥ ታና ኦኔ አፋናዌ?","poem":1},{"text":"ኤዶማ ጋካናዉ ታና ኦኔ ካለናዌ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አቤት ጾሳዉ፥ ኑና አጌዳዌ ኔና ግድኪ?","poem":1},{"text":"አቤት ጾሳዉ፥ ኔን ኑ ቶራንቻቱዋና ኦላዉ ከሳካ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አሳ ማዱ ፓና ድራዉ፥","poem":1},{"text":"ሞርክያና ኦለታናዉ ኔን ኑና ማዳ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ጾሳ ዎልቃን ኑን ኑ ሞርከቱዋ ጾናና፤","poem":1},{"text":"ኑ ሞርከቱዋ የናዌ አ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}