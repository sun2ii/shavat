7,"content":[{"text":"አ ብድያ ዎደ፥ እ ባይዛንቻ ግዲደ ቤቶ፤","poem":1},{"text":"አ ዎሳይካ አዉ ስሚደ ጎመቶ!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አ ላይይ ቃሞ፤","poem":1},{"text":"አ ሱንተካ ሀራይ አኮ!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አ ናናቱ አዉዋ ዪደ ዪእኖ፤","poem":1},{"text":"አ ማቻታ አምኤ ግዱ!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አ ናናቱ ዩይ ዩዪደ ዎስኖ፤","poem":1},{"text":"ባረንቱ ደእያ ኦናፐካ የደርሰትኖ!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አ ማጹዋ ኡባ አጮ ኦይቆ፤","poem":1},{"text":"እ ዳቡሪደ ከሴዳባ ኡባ አላጋይ ቦንቆ!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኦንነ አዉ ኬካባ ኦፖ፥","poem":1},{"text":"ዎይ አዉዋ ዬዳ አ ናናቶ ቃረቶፖ!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አ ናናቱ ኡባይ ዉር ይኖ፤","poem":1},{"text":"ካልያ የለታን አ ሱንይ ዶገቶ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አ አዎቱዋ ናጋራይ መና ጎዳ ስንን ቆፈቶ፤","poem":1},{"text":"አ አት ናጋራይ ኡባካ ቁጨቶፖ!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሄ ናጋራይ ኡባ ገደ መና ጎዳ ስንን ቤቶ፤","poem":1},{"text":"ኡንቱንታ ሀሳይስያዌ ሳኣፐ ቆለት ክቾ!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አያዉ ጎፐ፥ እ","poem":1},{"text":"ኬካባ ኦናዉ ኡባካ ቆፕቤና፤","poem":2},{"lineBreak":true},{"text":"ህዬሳቱዋ፥ መቶታንቻቱዋነ","poem":2},{"lineBreak":true},{"text":"ዎዛናይ ማዱጼዳዋንታ የደርሲደ ዎዳ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እ ሸቃናዉ ዶሴዳ ድራዉ፥","poem":1},{"text":"እካ ሸቀቴዳዋ ግዶ!","poem":2},{"text":"እ አንጃናዉ ዶሰና ድራዉ፥","poem":1},{"text":"አንጁ አፐ ሃኮ!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እ ሸቂደ ሳለና፤","poem":1},{"text":"አ ሸቃይ ሃዳን አ ቦላ ካ!","poem":2},{"text":"ዛይትያዳን አ መቀን ገሎ!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"አፍላዳን አ ካሞ፤","poem":1},{"text":"ሳቂያዳን ኡባ ገደ አ ጼሳን ደኦ!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ሀዌ ታና ሞትያዋንቶነ","poem":1},{"text":"ታና ኢታን ዝግርያዋንቶ፥","poem":2},{"text":"መና ጎዳይ እምያ ዎይቱዋ ግዶ!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ሽን አቤት ኡባ ሞድያ መና ጎዳ