{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["ጾሳይ ዶሬዳ ካትያ ዳውት ጻፌዳ ማዛሙርያ"]},{"type":"verse","number":1,"content":[{"text":"መና ጎዳይ ታ ጎዳ፥","poem":1},{"text":"“ታን ነ ሞርከቱዋ ኔን ገድያን","poem":2},{"text":"የ ኤቂያዋ ኦና ጋካናዉ፥","poem":3},{"lineBreak":true},{"text":"ሀዋን ታፐ ኡሸቻ ባጋና ኡታ” ያጌዳ።","poem":3}]},{"type":"verse","number":2,"content":[{"text":"መና ጎዳይ ነ ምኖተ ጻምኣ ጽዮነፐ ኪታና፤","poem":1},{"text":"ያትና፥ “ነ ሞርከቱዋ ሞዳ!” ያጋና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኔን ነ ሞርከቱዋና ኦለትያ ጋላስ፥","poem":1},{"text":"ነ አሳይ ኤኖ ጋና።","poem":2},{"text":"ዎንታ ጉራ ከተርሳዳን፥","poem":1},{"text":"ነ ዎዳላ አሳይ ኔኮ ጌሻ ደረቱዋን ሺቃና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"መና ጎዳይ፥ “ማልካ ጸደቅ ቄስያ ግዴዳዋዳን፥","poem":1},{"text":"ኔንካ መናዉ ቄስያ ግዳና” ያጊደ ጫቄዳ፤","poem":2},{"text":"እ ባረ ቆፋ ላመና።","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ጎዳይ ነ ኡሸቻን ደኤ፤","poem":1},{"text":"ባረ ሀንቁዋ ጋላስ እ ካተቱዋ ክንቼሬና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ካዉተ ቦላ እ ፕርዳና፤","poem":1},{"text":"ኦላ ደምባቱዋካ አሃ ጻላላ ኦና፤","poem":2},{"lineBreak":true},{"text":"ሳኣን ኡባን ደእያ ካተቱዋ እ መንሬና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ካቲ ኦግያ ማታን ደእያ ሃ ፑልቱዋፐ ኡሺደ፥","poem":1},{"text":"እ ባረ ሁጲያ ቁ ኦና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}