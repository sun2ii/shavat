{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":111,"content":[{"type":"heading","content":["ጾሳዉ ሺቅያ ጋላታ"]},{"type":"verse","number":1,"content":[{"text":"መና ጎዳ ጋላትተ! ሱረቱ ሺቅያ ሺቁዋን፥","poem":1},{"text":"ታን ታ ፖሎ ዎዛናፐ መና ጎዳ ጋላታና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"መና ጎዳ ኦሶቱ አይ ኬሻ ግቴ!","poem":1},{"text":"ኡንቱንቱን ናሸትያዋንቱ ኡባይ ኡንቱንታ ቆፓናዉ በሴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አ ኦሶቱ ቦንቹዋንነ","poem":1},{"text":"አንጋን ኩሜዳዋንታ።","poem":2},{"text":"አ ጽሎተይካ መናዉ ደኤ።","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"እ ባረ ማላልስያ ኦሶቱ፥","poem":1},{"text":"ሀሳየታናዳን ኦዳ።","poem":2},{"text":"መና ጎዳይ ቃረትያዋነ ማርያዋ።","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ባረዉ ያይያዋንቶ ቁማ እ እሜ፤","poem":1},{"text":"እ ባረ ጫቁዋ መናዉካ ቆፔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አላጋቱዋ ቢታ እምያዋን","poem":1},{"text":"እ ባረ ኦሱዋ ዎልቃ ባረ አሳ በሴዳ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አ ኩሽያ ኦሶቱ ቱማነ ልከ፤","poem":1},{"text":"አ ዎጋቱካ ኡባይ አማነትያዋንታ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኡንቱንቱነ መ መናዉ ኤቂደ ደእያዋንታ፤","poem":1},{"text":"ቱማተንነ ሱረተን እመቴዳዋንታ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እ ባረ አሳ ዎዚደ ከሴዳ፤","poem":1},{"text":"እ ባረ ጫቁዋ ኡንቱንቱና መናዉ ዎዳ።","poem":2},{"text":"አ ሱንይ ጌሻነ፥ “ሆላ!” ጊስያዋ።","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ኤራተዉ ኮይሩ መና ጎዳዉ ያይያዋ፤","poem":1},{"text":"አ ዎጋ ኦያዋንቶ ሎኦ አኬካይ ደኤ።","poem":2},{"text":"ጾሳይ መናዉ ጋላተቶ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}