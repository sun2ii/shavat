{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":113,"content":[{"type":"heading","content":["ጾሳ ኬካተ ቆንጭስያ ጋላታ"]},{"type":"verse","number":1,"content":[{"text":"መና ጎዳ ጋላትተ! ህንተኖ መና ጎዳ ቆማቶ፥","poem":1},{"text":"መና ጎዳ ሱን ጋላትተ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"መና ጎዳ ሱንይ ሀቼፐ መና ጋካናዉ ጋላተቶ!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"አዋይ ዶልያሳፐ ቢደ","poem":1},{"text":"ዉልያሳ ጋካናዉካ መና ጎዳ ሱንይ ጋላተቶ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"መና ጎዳይ ካዉተ ኡባፐ ቦላና ሞድያዋ፤","poem":1},{"text":"አ ቦንቹካ ሳሎቱዋፐ ቂያዋ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"መና ጎዳ ኑ ጾሳ ማል ኦኔ?","poem":1},{"lineBreak":true},{"text":"እ ቦላ ቃን ካዉተ አራታን ኡቴዳ።","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"እ ሳሎቱዋነ ሳኣ ጼላናዉ","poem":1},{"text":"ዱገ ሆኬ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እ ህዬሳ ባናፐ ቁ ኦ፤","poem":1},{"text":"መቶታንቻካ ብድን ፕቱዋፐ ደን።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ባረ አሳ ሞድያዋንቱና ኡትሴ።","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ማይነ ምሽራቶ ናናቱዋ አቶ ኦደ፥","poem":1},{"text":"ናሸቺደ እ ጎልያን እዞ ቦንችሴ።","poem":2},"መና ጎዳ ጋላትተ!"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}