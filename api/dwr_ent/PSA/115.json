{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":115,"content":[{"type":"heading","content":["እት ቱሙ ጾሳ"]},{"type":"verse","number":1,"content":[{"text":"አቤት መና ጎዳዉ፥ ኑ ግሻ ግደና፤","poem":1},{"text":"ኑ ግሻ ግደናን፥ አገና ነ ሲቆዉነ","poem":2},{"text":"ነ ቱማተ ድራዉ፥ ነ ሱን ቦንቻ።","poem":3}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ካዉተቱ አያዉ፥","poem":1},{"text":"“ኡንቱንቱ ጾሳይ ሀቃን ደኢ?” ጊኖ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኑ ጾሳይ ሳሉዋና፤","poem":1},{"text":"እ ባረ ዶሴዳዋ አይ ግዶፐካ ኦ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሽን ኡንቱንቱ ኤቃቱ ብራነ ዎርቃ፤","poem":1},{"text":"ኡንቱንቱ አሳ ኩሽያን መቴዳዋንታ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኡንቱንቶ ዶናይ ደኤ፤ ሽን ሃሳይክኖ፤","poem":1},{"text":"አይፊ ደኤ፤ ሽን ጼልክኖ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኡንቱንቶ ሀይይ ደኤ፤ ሽን ስስክኖ፤","poem":1},{"text":"ሲ ደኤ፤ ሽን ስንግክኖ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኡንቱንቶ ኩሺ ደኤ፤ ሽን ኦይቂ ኤርክኖ፤","poem":1},{"text":"ገዲካ ደኤ፤ ሽን ሀመትክኖ፤","poem":2},{"lineBreak":true},{"text":"ኡንቱንቱ ባረንቱ ፕላንቲያና ኮሻ ስስክኖ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኡንቱንታ መያዋንቱነ፥","poem":1},{"text":"ኡንቱንቱን አማነትያዋንቱ ኡባይ ኡንቱንቱ ማላ ግድኖ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ህንተኖ፥ እስራኤልያ አሳቶ፥","poem":1},{"text":"መና ጎዳን አማነትተ!","poem":2},{"text":"እ ህንተና ማድያዋነ ህንተ ጎንዳልያ።","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ህንተኖ፥ አሮና ጎልያ አሳቶ፥","poem":1},{"text":"መና ጎዳን አማነትተ!","poem":2},{"text":"እ ህንተና ማድያዋነ ህንተ ጎንዳልያ።","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ህንተኖ፥ መና ጎዳዉ ያይያዋንቶ፥","poem":1},{"text":"መና ጎዳን አማነትተ!","poem":2},{"text":"እ ህንተና ማድያዋነ ህንተ ጎንዳልያ።","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"መና ጎዳይ ኑና ቆፔ፤ እ ኑና አንጃና።","poem":1},{"text":"እ እስራኤልያ አሳቱዋ አንጃና።","poem":2},{"text":"እ አሮና ጎልያ አሳቱዋ አንጃና።","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"መና ጎዳዉ ያይያዋንታ፥","poem":1},{"text":"ጉቱዋካ ግታቱዋካ እ ጋ አንጃና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"መና ጎዳይ ህንተናካ ህንተ ናናቱዋካ ዳርሶ!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ሳሉዋነ ሳኣ መዳ መና ጎዳን አንጀትተ!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ቦላ ቃ ሳሉ መና ጎዳዋ፤","poem":1},{"text":"ሽን ሳኣ እ አሳዉ እሜዳ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሀይቄዳዋንቱ፥ ዱፉዋን ጮኡ ጌዳዋንቱ፥","poem":1},{"text":"መና ጎዳ ጋላትክኖ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሽን ኑን፥ ፓጻ ደእያዋንቱ፥","poem":1},{"text":"ሀቼፐ ዶሚደ","poem":2},{"lineBreak":true},{"text":"መና ጋካናዉ መና ጎዳ ጋላቴቶ።","poem":2},{"lineBreak":true},{"text":"መና ጎዳ ጋላትተ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}