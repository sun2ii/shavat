e_break"},{"type":"verse","number":8,"content":[{"text":"መና ጎዳይ ታና ሀይቁዋፐ፥","poem":1},{"text":"ታ አይፍያ አፎፐ፥","poem":2},{"lineBreak":true},{"text":"ታ ገድያካ ብያፐ አሼዳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሄዋ ድራዉ፥ ታን፥","poem":1},{"text":"ፓጻ ደእያዋንቱ ግዶን፥","poem":2},{"lineBreak":true},{"text":"መና ጎዳ ስንን ሀመታይ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታን፥ “ታና ኡንአይ ቶሌዳ” ግያ ዎደካ፥","poem":1},{"text":"ታ አማኑዋ አጋበይከ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታን ዳጋማደ፥ “አሳይ ኡባይ ዎርዱዋ” ያጋድ።","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"እ ታዉ ኬኬዳ ኬካተ ድራዉ፥","poem":1},{"text":"ታን መና ጎዳዉ አይ ጭጋናዉ ዳንዳያይታ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታን ጹኣ ዎይንያ ኤሳ ጋላታዉ ሺሻደ፥","poem":1},{"text":"እ ታና አሾ ድራዉ፥","poem":2},{"text":"መና ጎዳ ሱን ጼሳና።","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"አ አሳ ኡባ ስንን","poem":1},{"text":"ታን ቃንግያ መና ጎዳዉ ጋና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ጌሻቱዋ ሀይቁ መና ጎዳ ስንን፥","poem":1},{"text":"ሎይ ዳሮፐ ቦንቼቴዳዋ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አቤት መና ጎዳዉ፥ ታን ነ ቆማ፤","poem":1},{"text":"ኤ፥ ታን ነ ቆማ፥ ነ ቆማት ናኣ።","poem":2},{"text":"ታና ቃሹዋፐ ኔን ብላዳ።","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"አቤት መና ጎዳዉ፥","poem":1},{"text":"ታን ጋላታ ያርሹዋ ነዉ ያርሻና፤","poem":2},{"lineBreak":true},{"text":"ነ ሱን ጼሳና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"አሳ ኡባ ስንን፥","poem":1},{"text":"ታን ቃንገቴዳ ቃንገ መና ጎዳዉ ጋና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሄዋካ ታን ጋናዌ፥","poem":1},{"text":"የሩሳላመን ደእያ መና ጎዳ ጎልያ ዳባባና።","poem":2},{"lineBreak":true},{"text":"መና ጎዳ ጋላትተ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/115.json","previousChapterAudioLinks":{},"numbe