{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":12,"content":[{"type":"heading","content":["ኢታ አላምያፐ አታናዉ ሺቄዳ ዎሳ"]},{"type":"hebrew_subtitle","content":["ዛማረቱዋ ካፖ ዲን የጸቴዳ፥ ዳዊታ ማዝሙርያ።"]},{"type":"verse","number":1,"content":[{"text":"መና ጎዳዉ፥ ኑና ማዳርኪ?","poem":1},{"text":"አያዉ ጎፐ፥ ጾሳ አሳይ ኡባካ ባዋ፤","poem":2},{"text":"አሳ ግዶን አማነትያዌ ይክቼዳ።","poem":3}]},{"type":"verse","number":2,"content":[{"text":"ኡባ ዎደካ እቱ እቶ ዎርዱዋ ሃሳዪኖ፤","poem":1},{"text":"እቱ እቱዋ ሸሌሽያ እንጻርሳን ባለዋን ሃሳዪኖ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"አቤት መና ጎዳዉ፥ ሀ ሸሌሽያ ዶና ባራ።","poem":1},{"text":"ኦቶሩዋን ጬቀትያ እንጻርሳ ኡባ ኔን ጭጋ ኦላ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኡንቱንቱ፥ “ኑን ኑ እንጻርሳን ጾናና፤","poem":1},{"text":"ኑ መተርሻይ ኑዋ፤ ኑ ጎዳይ ኦኔ?” ያግኖ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"መና ጎዳይ፥ “ህዬሳቱ ኡንኤቴዳ ድራዉነ፥","poem":1},{"text":"መቶታንቻቱዋ ኦልያ ድራዉ፥","poem":2},{"lineBreak":true},{"text":"ሀእ ታን ደንዳና።","poem":2},{"lineBreak":true},{"text":"ታን ኡንቱንቱ አሞትያ ሳሮተን ኡንቱንታ ዎና” ያጌ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ጾሳ ቃላቱ ዋላክ ባይና ጌሻቱዋ፤","poem":1},{"text":"ጮጭያ ታማን ላፑን ገደ ትገቴዳ ብራዳን ጌዬዳዋንታ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"አቤት መና ጎዳዉ፥ ኔን ኡንቱንታ ሳሮተን ናጋነ","poem":1},{"text":"ሀዋ ማላ አሳፐ መናዉ ኡንቱንታ አሻ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አሳ ግዱዋን ኢታይ ቦንቼቴዳ ዎደ፥","poem":1},{"text":"ኢታቱ ኡባ ሳና ስመረቴድኖ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}