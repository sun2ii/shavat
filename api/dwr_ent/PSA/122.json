{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":122,"content":[{"type":"heading","content":["የሩሳላምዉ ሺቄዳ ሳባ"]},{"type":"hebrew_subtitle","content":["ፑደ ከሲደ የጼዳ የ፥ ዳውት ጻፌዳዋ"]},{"type":"verse","number":1,"content":[{"text":"ኡንቱንቱ ታና፥ “አነ መና ጎዳ ጎልያ ቦይተ” ያግና፥","poem":1},{"text":"ታን ናሸታድ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ኔኖ የሩሳላመ ካታማቴ፥","poem":1},{"text":"ኑን ነ ፐንገቱዋና ገሊደ ኤቄዶ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"የሩሳላመ ካታማይ፥","poem":1},{"text":"ዳንቲደ ምን ኬጸቴዳ ካታማ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"መና ጎዳ አዋዩዋዳን፥","poem":1},{"text":"እስራኤልያ ዛራቱ፥","poem":2},{"text":"መና ጎዳ ጋላታናዉ ይያ ካታማይ ሀዋ።","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ዳዊታ ዘረፐ ካተቴዳዋንቱ","poem":1},{"text":"ባረንቱ አሳዉ ፕርዳናዉ ያን ኡቴድኖ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"የሩሳላመ ሳሮተዉ","poem":1},{"text":"ሀዋዳን ያጊደ ዎስተ፤","poem":2},{"text":"“ኔና ሲቅያዋንቶ","poem":1},{"text":"ኡንቱንቱ ኦያዌ ኡባይ ሱሮ!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ነ ግምበቱዋ ግዶን ሳሩ ደኦ!","poem":1},{"text":"ነ ጌሳቱዋካ ቦችያባይ ዮ!” ያጊደ ዎስተ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታ እሻቱዋነ ታ ዳቦቱዋ ድራዉ ጋደ፥","poem":1},{"text":"“ነ ግዶን ሳሩ ደኦ!” ያጋይ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"መና ጎዳ ኑ ጾሳ ጎልያ ድራዉ ጋደ፥","poem":1},{"text":"ታን የሩሳላመ ዱረታናዉ ዎሳና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}