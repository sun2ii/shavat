{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":127,"content":[{"type":"heading","content":["ጾሳን አማነታናዳን እመቴዳ ዞርያ"]},{"type":"hebrew_subtitle","content":["ፑደ ከሲደ የጼዳ የ፥ ሶሎሞን ጻፌዳዋ"]},{"type":"verse","number":1,"content":[{"text":"መና ጎዳይ ጎልያ ኬጻና ዮፐ፥","poem":1},{"text":"ኬጽያዋንቱ ጮ መላ ዳቡሪኖ።","poem":2},{"text":"መና ጎዳይ ካታማ ናጋና ዮፐ፥","poem":1},{"text":"ናግያዋንቱ ጮ መላ ናጊኖ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ኔን ዎንታ ጉራን ደንድያዌ፥","poem":1},{"text":"ኦማርስ ቃምሳደ ግስያዌ፥","poem":2},{"lineBreak":true},{"text":"ቁማዉ ህርጋደ ቱጋትያዌ ጮ መላ፤","poem":2},{"lineBreak":true},{"text":"አያዉ ጎፐ፥ ጾሳይ ባረ ሲቅያዋንቶ ሸምፑዋ እሜ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ናናይ መና ጎዳፐ እመትያ እሞታ፤","poem":1},{"text":"የሎቱ ቱሙዋፐ ዎይቱዋ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እት ኡራይ ባረ ያላጋተን የሌዳ አቱማ ናናቱ፥","poem":1},{"text":"ኦላንቻ ኩሽያን ደእያ ቶራቱዋ ማላ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሄ ቃርጪታን ደእያ ዎንዳፍያ ቶራቱዋዳን፥","poem":1},{"text":"ዳሮ ናናቱ ደእያ አሳይ አንጀቴዳዋ።","poem":2},{"text":"አያዉ ጎፐ፥ እ ባረ ሞርከቱዋና፥","poem":1},{"text":"ካታማ ፐንግያን ሞ