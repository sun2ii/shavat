em":1},{"text":"ኤዶማ አሳቱ ኦዳዋ ሀሳያ፤","poem":2},{"lineBreak":true},{"text":"ኡንቱንቱ፥ “ኮልተ! ኮልተ!","poem":2},{"lineBreak":true},{"text":"ህርክ ጻጱዋ ጋካናዉ ላልተ!” ያጌዳዋ ዶጎፓ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ባብሎነ ቢታዉ፥ ኔንካ ባያና!","poem":1},{"text":"ኔን ኑ ቦላን ኦዳ ኢታ ኦሱዋ፥","poem":2},{"lineBreak":true},{"text":"ነ ቦላ ኦያዌ አንጀቴዳዋ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ነ ጉ ናናቱዋ ኦይቂደ፥","poem":1},{"text":"ዛላ ቦላ ሾጭያዌ አንጀቴዳዋ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}