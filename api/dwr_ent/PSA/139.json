ber":7,"content":[{"text":"ታን ነ አያናፐ ሀቃ ባናዉ ዳንዳያይታ?","poem":1},{"text":"ዎይ ነ ስንፐ ሀቃ ባቃታናዉ ዳንዳያይታ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ፑደ ሳሉዋ ከሶፐ፥","poem":1},{"text":"ኔን ያን ደኣሳ!","poem":2},{"text":"ዱገ ስኦልያ ዎንቶካ፥","poem":1},{"text":"ኔን ያን ደኣሳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አዋይ ሞክያሳ ባጋ ፓላደ ቦፐ፥","poem":1},{"text":"ዎይ አዋይ ዉልያሳ ባጋን ሃካደ ደኦፐ፥","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሄ ሳንካ ነ ኩሺ ታና ካለ፤","poem":1},{"text":"ነ ኡሸቻ ኩሺ ታና ዘምፕሴ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታን፥ “ማዉ፥ ታና ገን፤","poem":1},{"text":"ፖኡዋ፥ ቃማዉ ላመታ” ያግንቶካ፥","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ማ ዳሩ ነዉ መና፤","poem":1},{"text":"ቃማይ ጋላሳዳን ፖኤ፤","poem":2},{"lineBreak":true},{"text":"አያዉ ጎፐ፥ ነዉ ማይ ፖኡዋ ማላ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኔን ታ ግዶ አሳተ ኡባ መዳ፤","poem":1},{"text":"ታ አት ኡሉዋን ታና ኔን ዋጻ መዳ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኔን ታና ማላልስያባነ ኦራባ ኦደ መዳ ድራዉ፥","poem":1},{"text":"ታን ኔና ጋላታይ።","poem":2},{"text":"ነ ኦሶቱ ማላልስያዋንታ!","poem":1},{"text":"ታን ቃይ ሄዋ ዉርሳደ ኤራይ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታን ጌማ ሳኣን መትያ ዎደ፥","poem":1},{"text":"ታ መቀቱ ኔፐ ጌምበይክኖ።","poem":2},{"text":"ታ ቦላይ ታ አት ኡሉዋ ጪማ ግዶን","poem":1},{"text":"ሂላን አሌቀቲደ ኦሰትያ ዎደ፥","poem":2}]},{"type":"verse","number":16,"content":[{"text":"የለትቤና ታ አሳተ ነ አይፊ በኤዳ።","poem":1},{"text":"ብሮ እቱነ ዶመተናን ደእሽን፥","poem":2},{"lineBreak":true},{"text":"ታዉ ኔን ጊግሴዳ ጋላሳቱ ኡባቱ","poem":2},{"lineBreak":true},{"text":"ነ ማዝጎብያን ጻፈቴድኖ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አቤት ጾሳዉ፥","poem":1},{"text":"ነ ቆፋቱ አያ ጮራቴድኖ!","poem":2},{"text":"ኡንቱንታ ኤራናዌ አያ ዋይሲ!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ታን ኡንቱንታ ፓይድንቶ፥","poem":1},{"text":"ኡንቱንቱ ሻፍያፐ ዳራና ሽን።","poem":2},{"text":"ታን ቤጎትያ ዎደ፥","poem":1},{"text":"ሀእካ ኔናና ደአይ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አቤት ጾሳዉ፥ ኔን ኢታቱዋ ዎድንቶ አዬ ደኢ!","poem":1},{"text":"ሱ ጉስያ አሳቱ ታፐ ሃክኖ!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ኡንቱንቱ ነ ቦላ ኢታባ ሃሳዪኖ፤","poem":1},{"text":"ነ ሞርከቱ ነ ሱን ባይዚኖ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አቤት መና ጎዳዉ፥ ኔና እጽያዋንታ","poem":1},{"text":"ታን እጽክታ?","poem":2},{"text":"ነ ቦላ ደንድያዋንታ","poem":1},{"text":"ታን ሸነትክታ?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ታን ኡንቱንታ ኡባ እጻይ፤","poem":1},{"text":"ኡንቱንታ ታን ታ ሞርከቱዋዳን ፓይዳይ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"አቤት ጾሳዉ፥","poem":1},{"text":"ታና ብዳደ፥ ታ ዎዛና ኤራ፤","poem":2},{"lineBreak":true},{"text":"ታና ፓጫደ፥ ታ ኡንኤትያ ቆፋ ኤራ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"አነ ታናን ኢታባይ ደኦፐ ጼላ፤","poem":1},{"text":"መና ኦግያን ታና ካለ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}