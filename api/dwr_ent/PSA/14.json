pe":"verse","number":6,"content":[{"text":"ኡንቱንቱ ህዬሳቱዋ ቆፋ ሀልሲኖ፤","poem":1},{"text":"ሽን መና ጎዳይ ህዬሳቱ ባቃቲደ፥ ቆሰት አትያ ሳኣ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"እስራኤልያዉ አቶተይ ጽዮነፐ ዬረኔ!","poem":1},{"text":"መና ጎዳይ ኡንቱንቱ ደኡዋ ዛርያ ዎደ፥","poem":2},{"text":"ያቆባ ዘረይ ናሸታና፤","poem":1},{"text":"እስራኤልያ አሳይ ናሸቻ ፖጩ ጋና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}