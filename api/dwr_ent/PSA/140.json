ine_break"},{"type":"verse","number":6,"content":[{"text":"ታን መና ጎዳ፥ “ኔን ታ ጾሳ” ያጋይ።","poem":1},{"text":"አቤት መና ጎዳዉ፥ ታን ዋትዋትያ ዋትዋቱዋ ስሳ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አቤት ኡባ ሞድያ መና ጎዳዉ፥","poem":1},{"text":"ታና አሽያ ምኖ፥","poem":2},{"lineBreak":true},{"text":"ኦላ ጋላስ ታዉ ጎንዳለ ግዳዳ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አቤት መና ጎዳዉ፥","poem":1},{"text":"ኢታቶ ኡንቱንቱ አሙዋ እሞፓ፤","poem":2},{"lineBreak":true},{"text":"ኡንቱንቱ ኢታ ማቁዋ ፖልሶፓ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ታ ሞርከቱዋን ታና ጾንሶፓ፤","poem":1},{"text":"ኡንቱንቱ ዶናፐ ከስያ ኢታባይ ኡንቱንቶ ስሞ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኡንቱንቱ ቦላ ጹግያ ቦንቁ ቆለቶ፤","poem":1},{"text":"ኡንቱንቱ ታማን ኦለትኖ፤","poem":2},{"lineBreak":true},{"text":"ሄዋፐ ላኤን ደንደና ኦላን ኦለትኖ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዝግርያዋንታ ቢታይ ቶኮፖ፤","poem":1},{"text":"ማካላንቻ አሳቱዋ ኢታባይ ሻንካቲደ ኦይቆ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"መና ጎዳይ ህዬሳቶ ፕርድያዋነ፥","poem":1},{"text":"መቶታንቻቱዋ ማታ ናግስያዋ ኤራይ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ቱሙፐ ጽሎቱ ነ ሱን ጋላታና፤","poem":1},{"text":"ሱረ አሳቱ ነ ስንን ደአና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}