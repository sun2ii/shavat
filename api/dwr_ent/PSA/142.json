{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":142,"content":[{"type":"heading","content":["ጾሳ ማዱዋ ደማናዉ ሺቄዳ ዎሳ"]},{"type":"hebrew_subtitle","content":["አኬካን ጻፈቴዳ ዳዊታ ግንጹዋ፥ ጎንጎሎ ግዶን ደእያ ዎደ አ ዎሳ"]},{"type":"verse","number":1,"content":[{"text":"ታ ቃላ ቁ ኦደ፥ መና ጎዳዉ ዋሳይ።","poem":1},{"text":"ታ ቃላ ቁ ኦደ፥","poem":2},{"lineBreak":true},{"text":"መና ጎዳዉ ዋትዋታይ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታ ቆሁዋ ኡባ አዉ ማጋናይ፤","poem":1},{"text":"ታ መቱዋ ኡባ አዉ ኦዳይ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታን ህዶታ ቃንጻና ማቲያ ዎደ፥ ኔን ታ ኦግያ ኤራሳ።","poem":1},{"text":"ታን ሀመትያ ኦግያን ታዉ ግትያ ቆስ ዎድኖ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታን ታ ዩሹዋ ጼልያ ዎደ፥","poem":1},{"text":"ታና ማድያዌ እቱነ ባዋ፤","poem":2},{"lineBreak":true},{"text":"ታን ቆሰታ አትያ ሳአይ ባዋ፤","poem":2},{"lineBreak":true},{"text":"ታና ናግያዌካ ባዋ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"አቤት መና ጎዳዉ፥ ታን፥","poem":1},{"text":"ነዉ ሀዋዳን ጋደ ዋሳይ፤","poem":2},{"text":"“ኔን ታን ባቃታደ አትያ ሳኣ፤","poem":1},{"text":"ታን ፓጻ ደእሽን፥ ታና ጋኬዳ ሳማይ ኔና” ያጋይ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታን ሎይ መቶትያ ድራዉ፥","poem":1},{"text":"ታ ዋሱዋ ሀይዛ።","poem":2},{"text":"ታና የደርስያዋንቱ፥","poem":1},{"text":"ታዉ ሎይ ዎልቃሜዳ ድራዉ፥","poem":2},{"lineBreak":true},{"text":"ታና ኡንቱንቱፐ አሻ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታን ነ ሱን ጋላታና ማላ፥","poem":1},{"text":"ታና ቃሹዋፐ ብላ።","poem":2},{"text":"ኔን ታዉ ኬክያ ድራዉ፥","poem":1},{"text":"ጽሎቱ ታ ዩሹዋን ሺቃና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}