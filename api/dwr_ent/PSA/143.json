{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":143,"content":[{"type":"heading","content":["ጾሳ ማዱዋ ደማናዉ ሺቄዳ ዎሳ"]},{"type":"hebrew_subtitle","content":["ዳውት ጻፌዳ ማዛሙርያ"]},{"type":"verse","number":1,"content":[{"text":"አቤት መና ጎዳዉ፥ ታ ዎሳ ስሳ፤ ታ ዋትዋቱዋ ሀይዛ።","poem":1},{"text":"ኔን ጽሉዋነ አማነትያዋ ግድያ ድራዉ፥","poem":2},{"text":"ታዉ ዛሩዋ እማ።","poem":3}]},{"type":"verse","number":2,"content":[{"text":"ነ ስንን ጽሎ ግዳና አሳይ ባዋ፤","poem":1},{"text":"ሄዋ ድራዉ፥ ታና ነ ቆማ ፕርዳዉ ሺሾፓ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ታና ታ ሞርኪ የደርሲደ፥","poem":1},{"text":"ቢታና ጋ ክንቼሬዳ፤","poem":2},{"lineBreak":true},{"text":"በን ሀይቄዳ አሳቱዋዳን ታና ማን ዎዳ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሄዋ ድራዉ፥ ታን ህዶታ ቃንጻድ፤","poem":1},{"text":"ታ ዎዛናይካ ይባቴዳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ታን በን ዎደቱዋ ሀሳያይ፤","poem":1},{"text":"ኔን ኦዳ ኦሱዋ ኡባ ዛራ ዛራደ ቆፓይነ","poem":2},{"lineBreak":true},{"text":"ነ ኩሺ ኦዳዋ አኬካይ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታን ታ ኩሽያ ኔኮ ምጫድ፤","poem":1},{"text":"መላ ቢታይ ሃ ኮይያዋዳን፥","poem":2},{"lineBreak":true},{"text":"ታ ሸምፑ ኔና ሳመቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"አቤት መና ጎዳዉ፥ ታዉ ዛሩዋ እማናዉ ኤሌላ!","poem":1},{"text":"ታን ህዶታ ቃንጻድ።","poem":2},{"text":"ታን ዱገ ዱፉዋን ገልያ አሳቱዋ ማላ ግደናዳን፥","poem":1},{"text":"ነ ሶምኡዋ ታፐ ገንፓ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታን ኔና አማነትያ ድራዉ፥","poem":1},{"text":"ዎንታ ዎንታ አገና ነ ሲቁዋ ታና በሳ።","poem":2},{"text":"ታን ታ ሸምፑዋፐ ኔና ዎስያ ድራዉ፥","poem":1},{"text":"ታን ባናዉ በስያ ኦግያ ታና ታማርሳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"አቤት መና ጎዳዉ፥ ታን ኔኮ ባቃቴዳ ድራዉ፥","poem":1},{"text":"ታና ታ ሞርከቱዋፐ አሻ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኔን ታ ጾሳ ግድያ ድራዉ፥","poem":1},{"text":"ታን ነ ሸንያ ኦና ማላ፥ ታና ታማርሳ፤","poem":2},{"lineBreak":true},{"text":"ሎኦ አያናን ታና ሱረ ኦግያ ካለ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አቤት መና ጎዳዉ፥ ነ ሱን ድራዉ፥ ታና አሻ፤","poem":1},{"text":"ነ ጽሎተን ታና መቱዋፐ ከሳ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አገና ነ ሲቁዋን ታ ሞርከቱዋ ዎ፤","poem":1},{"text":"ታ ባልጋራቱዋ ኡባ ይሳ፤","poem":2},{"lineBreak":true},{"text":"አያዉ ጎፐ፥ ታን ነ ቆማ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}