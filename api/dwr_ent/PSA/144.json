{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":144,"content":[{"type":"heading","content":["ጾኑዋ ማዝሙርያ"]},{"type":"hebrew_subtitle","content":["ዳውት ጻፌዳዋ"]},{"type":"verse","number":1,"content":[{"text":"መና ጎዳይ፥ ታ ዛላይ ጋላተቶ! እ ታ ኩሽያ ኦላዉ፥","poem":1},{"text":"ታ ብራቱዋካ ቶራዉ ሎህሴ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እ ታና ሲቅያ ጾሳነ ታ ጌሱዋ፤","poem":1},{"text":"እ ታ ሚጻነ ታና አሽያዋ።","poem":2},{"text":"እ ታ ጎንዳልያነ ታን ባቃታደ አትያ ሳኣ።","poem":1},{"text":"ካዉተቱዋ እ ታዉ ሞድስያዋ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"አቤት መና ጎዳዉ፥","poem":1},{"text":"ኔን አዉ ቆፕያ አሳይ እ አዬ?","poem":2},{"text":"ኔን ናገትያ አሳ ናአይ አዬ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"አሳይ እት ገደ ጫርክያ ጫርኩዋ ማላ፤","poem":1},{"text":"አ ጋላሳቱካ አያ ኩዋ ማላ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"አቤት መና ጎዳዉ፥ ነ ሳሉዋ ዳካደ ዱገ ዎ!","poem":1},{"text":"ዎጋ ደረቱዋ ቦቻ፤ ኡንቱንቱካ ጩዋትኖ!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዋልቃን የዳደ ነ ሞርከቱዋ ላላ!","poem":1},{"text":"ነ ዎንዳፍያ ፖ የዳደ ኡንቱንታ የደርሳ!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ቦላና ነ ኩሽያ ዱገ የዳደ፥","poem":1},{"text":"ታና ጪሞ ሃቱዋፐ ጎቻደ ከሳ፤","poem":2},{"lineBreak":true},{"text":"አላጋ አሳቱዋ ኩሽያፐ ታና ዎ አካ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኡንቱንቱ ቱሙዋ ሃሳይክኖ፥","poem":1},{"text":"ጫቂደካ ዎርዱዋ ሃሳዪኖ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"አቤት ጾሳዉ፥ ታን","poem":1},{"text":"ነዉ ኦራ የ የጻና፤","poem":2},{"lineBreak":true},{"text":"ታሙ ባቀን ዋጸቴዳ ዲን ነዉ ዲጻና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ካተቶ ጾኑዋ እማሳ፤","poem":1},{"text":"ነ ቆማ ዳዊታ አሻሳ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታና ኢታ ማሻፐ አሻሳ፤","poem":1},{"text":"አላጋ አሳቱዋ ኩሽያፐ ታና ዎ አካ።","poem":2},{"text":"ኡንቱንቱ ቱሙዋ ሃሳያና ጊደ ጫቂደካ፥","poem":1},{"text":"ዎርዱዋ ሃሳዪኖ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኑ አቱማ ናናቱ፥","poem":1},{"text":"ባረንቱ ያላጋተን ዶልቂዶልቂደ፥","poem":2},{"lineBreak":true},{"text":"ድጭያ ም ማላ ግድኖ።","poem":2},{"lineBreak":true},{"text":"ኑ ማጫ ናናቱካ ካትያ ጎልያ ዞዝያን፥","poem":2},{"lineBreak":true},{"text":"አሌቆ ኤሴዳ ቱቅያ ማላ ግድኖ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኑ ድየቱ፥","poem":1},{"text":"ዳሮ ዱማ ዱማ ቆሞ ካን ኩምኖ፤","poem":2},{"lineBreak":true},{"text":"ኑ ደምባቱዋን ደእያ ዶርሳቱ ሻኣ፥","poem":2},{"lineBreak":true},{"text":"ታሙ ሻኣ የልኖ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኑ ሚዛቱ ብራስኖ፤","poem":1},{"text":"ኡንቱንቱ ሳልኤሰናን የለቲደ ጮራትኖ።","poem":2},{"text":"ኑ ኦገቱዋን ዳጋማ ዋሱ ስሰቶፖ።","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ሀ የዉ ቱሙ ሀንያ አሳቱ፥","poem":1},{"text":"አንጀቴዳዋንታ።","poem":2},{"text":"ኡንቱንቱ ጾሳይ መና ጎዳ ግድያ አሳቱ","poem":1},{"text":"አንጀቴዳዋንታ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}