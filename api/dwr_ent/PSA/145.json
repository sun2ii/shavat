verse","number":7,"content":[{"text":"ኡንቱንቱ ነ ኬካተ ዳሩዋ ኦዳና፤","poem":1},{"text":"ነ ጽሎተባካ የጻና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"መና ጎዳይ ቃረትያዋነ ማርያዋ፤","poem":1},{"text":"እ ሀንቀታናዉ ኤሌለናዋነ፤","poem":2},{"lineBreak":true},{"text":"ዳንዳያንቻነ አገና ሲቁ ዳርያዋ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"መና ጎዳይ ኡባዉ ኬካ፤","poem":1},{"text":"እ ባረ መዳ ኡባዉ ቃረትያዋ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አቤት መና ጎዳዉ፥","poem":1},{"text":"ነ መታ ኡባይ ኔና ጋላታና፤","poem":2},{"lineBreak":true},{"text":"ነ አሳቱ ኡባይካ ኔና ሳባና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኡንቱንቱ ነ ካዉተ ቦንቹዋባ ሃሳያና፤","poem":1},{"text":"ነ ዎልቃባ ኦዳና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሄዌነ፥ ነ ዎልቃማ ኦሱዋባነ","poem":1},{"text":"ነ ካዉተ ቦንቹዋ አንጋባ","poem":2},{"lineBreak":true},{"text":"አሳ ኤርሳና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ነ ካዉተይ መና ካዉተ፤","poem":1},{"text":"ነ ማታይ የለታ ኡባ ጋካናሳ።","poem":2},{"lineBreak":true},{"text":"መና ጎዳይ ባረ ጌዳ ቃላዉ ኡባዉ አማነትያዋ፤","poem":1},{"text":"እ ባረ ኦሱዋ ኡባን ቃረትያዋ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"መና ጎዳይ ሆኬዳዋንታ ኡባ ዘምፕሴ፤","poem":1},{"text":"ኩንዴዳዋንታ ኡባ ደን።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኡባ አይፊ ኔኮ ጼሌ፤","poem":1},{"text":"ኡንቱንታ ኮሽያ ዎድያን ኔን ኡንቱንቶ ቁማ እማሳ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኔን ነ ኩሽያፐ እማ፤","poem":1},{"text":"ፓጻ ደእያዋንታ ኡባ አሙዋ አላ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"መና ጎዳይ ባረ ኦግያን ኡባን ጽሉዋ፤","poem":1},{"text":"እ ባረ ኦሱዋ ኡባን ቃረትያዋ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"መና ጎዳይ ባረና ጼስያ ኡባዉ፥","poem":1},{"text":"ቱሙዋን ባረና ጼስያ ኡባዉ ማታን ደኤ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እ ባረዉ ያይያዋንቱ ኡባዉ፥","poem":1},{"text":"አሙዋ ኩን።","poem":2},{"text":"ቃይ እ ኡንቱንቱ ዋሱዋ ስሲደ፥","poem":1},{"text":"ኡንቱንታ አሼ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"መና ጎዳይ ባረና ሲቅያዋንታ ኡባ ናጌ፤","poem":1},{"text":"ሽን ኢታቱዋ ኡባ ይሳና።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ታን ታ ዶናን መና ጎዳ ጋላታና።","poem":1},{"text":"መታ ኡባይ አ ጌሻ ሱን","poem":2},{"lineBreak":true},{"text":"መ መናዉ ጋላቶ!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}