{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":147,"content":[{"type":"heading","content":["ኡባ ዳንዳይያ ጾሳዉ ሺቅያ ጋላታ"]},{"type":"verse","number":1,"content":[{"text":"መና ጎዳ ጋላትተ! ኑ ጾሳ ሳቢያዌ ሎአ፤","poem":1},{"text":"አ ሳቢያዌ ናሸችያባነ በስያዋ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"መና ጎዳይ የሩሳላመ ኦራና፤","poem":1},{"text":"እስራኤልያ አሳቱዋፐ በቴዳዋንታካ ሺሻና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዎዛናይ መኤዳዋንታ እ ፓ፤","poem":1},{"text":"ኡንቱንቱ ማዱካ እ ቃቼ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እ ጾልንተቱዋ","poem":1},{"text":"ኡንቱንቱ ፓይዱዋን ኤሬ፤","poem":2},{"lineBreak":true},{"text":"ኡንቱንታ ኡባካ ኡንቱንቱ ሱንን ሱንን ጼሴ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኑ ጎዳይ ዎልቃማ፤ አ ዎልቃይ ዳራ፤","poem":1},{"text":"አ አኬካይ ልክያፐ አያዋ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"መና ጎዳይ ናቀቴዳዋንታ ዘምፕሴ፤","poem":1},{"text":"ሽን ኢታቱዋ ቢታን ዱገ ኦሌ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"መና ጎዳዉ ጋላታ የ የጽተ፤","poem":1},{"text":"ኑ ጾሳዉ ዲ ዲጽተ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እ ሳሉዋ ሻርያ ካሜ፤","poem":1},{"text":"ሳአዉ እራ ቡክሴ፤","poem":2},{"lineBreak":true},{"text":"ቄሪ ደረቱዋ ቦላ ማታ ሞክሴ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"መሄቶነ ዋስያ ቁሩዋ ማራቶ፥","poem":1},{"text":"ምያዋ እ እሜ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እ ናሸትያዌ ፓራቱዋ ዎልቃንነ፥","poem":1},{"text":"ቶራንቻቱ ምኖተን ግደና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"መና ጎዳይ ባረዉ ያይያዋንቱንነ","poem":1},{"text":"አገና አ ሲቁዋን፥","poem":2},{"lineBreak":true},{"text":"ባረንቱ ህዶታ ዎዳዋንቱን ናሸቴ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"የሩሳላመ ካታማቴ፥ መና ጎዳ ጋላታ!","poem":1},{"text":"ጽዮኔ፥ ነ ጾሳ ጋላታ!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አያዉ ጎፐ፥ እ፥","poem":1},{"text":"ነ ፐንግያ ኩልባቱዋ ምንሴ፤","poem":2},{"lineBreak":true},{"text":"ነ ግዶን ደእያ ነ አሳካ አንጄ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እ ነ ዛዋ ሳሮተን ናጌ፤","poem":1},{"text":"ኔና ሎይ ሎእያ ዛርጋ ካልሴ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እ ባረ ኪታ ሳአዉ ኪቴ፤","poem":1},{"text":"አ ቃላይካ ኤለ ጋኬ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እ ሻቻ ቡሉኩዋዳን ምጬ፤","poem":1},{"text":"ከተርሳ ብድንዳን ላሌ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እ ባረ ዎልቃማ ሻቻ","poem":1},{"text":"ሹቻዳን ዱገ ኦሌ።","poem":2},{"text":"ሄ ሜጉዋን ኤቃናዉ ኦንነ ዳንዳየና።","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"እ ባረ ቃላ ኪቲደ፥","poem":1},{"text":"ሻቻ ሙሽሴ።","poem":2},{"text":"እ ጫርኩዋ ጫርክስና፥ ሃይ ጎጌ።","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"እ ባረ ቃላ ያቆባ ዘረዉ፥","poem":1},{"text":"ባረ አዋዩዋነ ፕርዳ","poem":2},{"text":"እስራኤልያ አሳዉ አዋዬ።","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"እ ሀራ ካዉተ አሳዉ፥","poem":1},{"text":"ሀዋ ኦቤና፤","poem":2},{"lineBreak":true},{"text":"ኡንቱንቱ አ ፕርዳ ኤርክኖ።","poem":2},{"lineBreak":true},{"text":"መና ጎዳ ጋላትተ!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/147.json","thisChapterAudioLinks":{},"next