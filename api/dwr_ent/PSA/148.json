2},{"text":"ኡንቱንቱ ኡባካ እጻናዉ ዳንዳየና አዛዙዋ እ ኡንቱንቶ እሜዳ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ሳኣን ደእያዋንቶ፥ መና ጎዳ ጋላትተ!","poem":1},{"text":"አባን ደእያ መታቶ፥ ዎልቃማ አባ ጪማቶ፥","poem":2},{"lineBreak":true},{"text":"ኡባቱካ አ ጋላትተ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ህንተኖ፥ ዋልቃንዉ፥","poem":1},{"text":"ሻቻዉ፥ ሻርያዉ፥ ጫጋናዉ፥","poem":2},{"text":"አ አዛዙዋ ፖልያ ጎትያዉ፥","poem":1},{"text":"ኡባቱካ አ ጋላትተ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ህንተኖ፥ ደረቶ፥ ዞዘቶ፥","poem":1},{"text":"ምያ አይፍያ አይፍያ ምቶ፥ ዝጋቶ፥","poem":2},{"lineBreak":true},{"text":"ኡባቱካ አ ጋላትተ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"መሄቶ፥ ዶአቶ፥","poem":1},{"text":"ሳኣና ጎሸትያ መታቶ፥","poem":2},{"lineBreak":true},{"text":"ፓልያ ካፎቶ፥","poem":2},{"lineBreak":true},{"text":"ኡባቱካ አ ጋላትተ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሳኣ ካተቶ፥ ካዉተ አሳቶ፥","poem":1},{"text":"ካፓቶ፥ አሳ ሞድያዋንቶ፥","poem":2},{"text":"ኡባቱካ አ ጋላትተ።","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ዎዳላቶ፥ ዎዶራቶ፥","poem":1},{"text":"ጭማቶ፥ ናናቶ፥","poem":2},{"text":"ኡባቱካ አ ጋላትተ!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ኡንቱንቱ ኡባቱ መና ጎዳ ሱን ጋላትኖ፤","poem":1},{"text":"አያዉ ጎፐ፥ አ ሱንይ ኡባፐ ቦላና ደእያዋ፤","poem":2},{"text":"አ ቦንቹ ሳሎቱዋፐካ ሳኣፐካ ቦላና ቃን ደኤ።","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"አ ባጋ ግድያ፥ አዉ ማታትያ እስራኤልያ አሳቱ፥","poem":1},{"text":"አ ጋላታና ማላ፥ እ ኡንቱንታ ምንሴ።","poem":2},{"lineBreak":true},{"text":"መና ጎዳ ጋላትተ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}