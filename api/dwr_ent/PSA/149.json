{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":149,"content":[{"type":"heading","content":["ጾኑዋ ማዝሙርያ"]},{"type":"verse","number":1,"content":[{"text":"መና ጎዳ ጋላትተ! መና ጎዳዉ ኦራ የ የጽተ!","poem":1},{"text":"አማንያዋንቱ ሺቁዋን አ ሳቢተ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"እስራኤልያ አሳቱ","poem":1},{"text":"ባረንታ መዳዋን ናሸትኖ።","poem":2},{"text":"ጽዮነ አሳቱ ባረንቱ ካትያን ሎይ ናሸትኖ።","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ዱሪደ፥ ካራቡዋ ባቂደነ፥","poem":1},{"text":"ዲ ዲጺደ፥ አ ሱን ሳቢኖ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አያዉ ጎፐ፥ ጾሳይ ባረ አሳን ናሸቴ፤","poem":1},{"text":"ናቀቴዳዋንቶ ጾኑዋ እሚደ፥","poem":2},{"text":"እ ኡንቱንታ ቦንቼ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"አሳቱ ባረንቱ ጾኑዋን ናሸትኖ፤","poem":1},{"text":"ቃማን ኡባን ናሸቻዉ የጽኖ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኡንቱንቱ ዶናን ጾሳ ጋላታይ፥","poem":1},{"text":"ኡንቱንቱ ኩሽያንካ ላኡ ባጋ ኩሳ ማሻይ ደኦ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሄዌካ፥ ኡንቱንቱ ካዉተቶ፥","poem":1},{"text":"ሀሉዋ ከሳናሳነ አሳቱዋ ሙራናሳ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኡንቱንቱ ካተቱዋ ሳንሳላታን፥","poem":1},{"text":"ኡንቱንቱ ኦላ ጋዳዋቱዋካ ብራታን ቃቻናሳነ፥","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኡንቱንቱ ቦላ ጻፈቴዳ ፕርዳ ፖላናሳ።","poem":1},{"text":"ሄዌ ጾሳ አሳቱዋ ኡባዉ ጾኑዋ።","poem":2},{"lineBreak":true},{"text":"መና ጎዳ ጋላትተ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}