!","poem":1},{"text":"ኤ ታ ላታይ ቱሙዋፐ ሎአ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ታና ዞርያ መና ጎዳ ጋላታይ፤","poem":1},{"text":"ብላሄካ ታ ዎዛናይ ታና ሴሬ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታን ኡባ ገደ መና ጎዳ ታፐ ስንያይ","poem":1},{"text":"እ ታፐ ኡሸቻ ባጋና ደእያ ድራዉ፥","poem":2},{"lineBreak":true},{"text":"ታን ህርግከ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ሄዋ ድራዉ፥ ታ ዎዛናይ ናሸቴ፤","poem":1},{"text":"ታ ሸምፑካ ሀሹ ጌ።","poem":2},{"text":"ታ ቦላይካ ህርግ ባይናን ደኤ።","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ታና ስኦልያዉ አደ እማካ፤","poem":1},{"text":"ኔን ነ ጌሻ ሙስሳካ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ኔን ታና ደኡዋ ኦግያ በሳሳ።","poem":1},{"text":"ታን ነ ማታን ደእና፥ ታ ናሸቻይ ፖለቴ፤","poem":2},{"lineBreak":true},{"text":"ነ ኡሸቻ ባጋና እንጂ መናዉ ደኤ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}