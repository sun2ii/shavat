"verse","number":7,"content":[{"text":"ሄ ካቲ፥ “ታን መና ጎዳ ህግያ አዋያና፤","poem":1},{"text":"እ ታና፥ ‘ኔን ታ ናኣ፤","poem":2},{"lineBreak":true},{"text":"ታን ሀች ነዉ አዉዋ ግዳድ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኔን ታና ኦቻ፤","poem":1},{"text":"ታን ካዉተ ኡባ ነዉ እማና፤","poem":2},{"lineBreak":true},{"text":"ሳኣ ኡባይ ነባ ግዳናዋ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኔን ብራታ ጻምአን ኡንቱንታ መንሬና፤","poem":1},{"text":"ኡንቱንታ ኔን ኡርቃ ሚሻ መንያዋዳን ሊቅሳና’ ያጌ” ያጌዳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ሄዋ ድራዉ፥ ህንተኖ ካተቶ፥ ኤያቶፕተ፤","poem":1},{"text":"ሀ ሳኣ ሞድያዋንቶ፥ ህንተና ናግተ!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"መና ጎዳዉ ያሻተን ኦተ፤","poem":1},{"text":"ኮኮርሳን አዛዘትተ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ጾሳይ ሀንቀትና፥ ኦግያን ህንተ የናዳን ሱረ ዎዛናን አዉ ጎይንተ፤","poem":1},{"text":"አያዉ ጎፐ፥ አ ሀንቁ ኤለካ ኤጽ ከሳና።","poem":2},{"text":"ባቃት አን ቆሰት አትያ ኡባቱ አንጀቴዳዋንታ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}