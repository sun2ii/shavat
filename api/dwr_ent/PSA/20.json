number":7,"content":[{"text":"እቱ እቱ ባረንቱ ኦላ ፓራይ ጎችያ ጋርያን፥","poem":1},{"text":"ሀራቱ ባረንቱ ፓራን ጬቀቲኖ፤","poem":2},{"lineBreak":true},{"text":"ሽን ኑን መና ጎዳ ኑ ጾሳ ዎልቃን ጬቀቴቶ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኡንቱንቱ በቲደ ኩንዳና፤","poem":1},{"text":"ሽን ኑን ደንዲደ፥ ምን ኤቃና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"አቤት መና ጎዳዉ፥ ካትያዉ ጾኑዋ እማ፤","poem":1},{"text":"ኑን ኔና ጼስያ ዎደ ስሳ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}