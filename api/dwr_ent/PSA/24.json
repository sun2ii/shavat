ber":7,"content":[{"text":"ፐንገቱ ዶየትተ! ቦንቾ ካቲ ገላና ማላ፤","poem":1},{"text":"በን ፐንጋቱ አ ናሸቻን ሞክተ!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሄ ቦንቾ ካቲ ኦኔ?","poem":1},{"text":"ምኑነ ዎልቃማይ መና ጎዳቴ!","poem":2},{"text":"ኦላዉካ እ ዎልቃማ መና ጎዳቴ!","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ፐንገቱ ዶየትተ! ቦንቾ ካቲ ገላና ማላ፤","poem":1},{"text":"በን ፐንጋቱ አ ናሸቻን ሞክተ!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሀ ቦንቾ ካቲ ኦኔ?","poem":1},{"text":"ሀ ቦንቾ ካቲ ሳሉዋ መተቱዋ መና ጎዳቴ!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}