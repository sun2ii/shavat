":true},{"text":"ነ ጋላታ የ የጻይነ","poem":1},{"text":"ኔን ኦዳ ኦራባ ኡባ ኦዳይ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"አቤት መና ጎዳዉ፥ ኔን ደእያ ጎልያ፥","poem":1},{"text":"ነ ቦንቹ አቅያ ሳኣ ታን ዶሳይ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ታና ናጋራንቻቱዋና እትፐ ፕቶፓ፤","poem":1},{"text":"ዎይ አሳ ዎያዋንቱና እትፐ ይሶፓ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኡንቱንቱ ኩሽያን ኢታ ሀልቹ ደኤ፤","poem":1},{"text":"ቃይ ኡንቱንቱ ኡሸቻ ኩሽያን ማታዪ ኩም ኡቴዳ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሽን ታና ግዶፐ፥ ታን ሱረተን ሀመታይ።","poem":1},{"text":"ታና ዎዛ፤ ታዉ ቃረታ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታ ገዲ ደምባ ሳኣን ኤቄዳ፤","poem":1},{"text":"ታን ዎልቃማ ሺቁዋን መና ጎዳ ጋላታና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}