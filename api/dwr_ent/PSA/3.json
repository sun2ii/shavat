ፐ፥ ኔን ታ ሞርከቱዋ ኡባ ጎጎጩዋ ሾጫዳ፤","poem":1},{"text":"ኢታቱዋ አቻካ መንዳ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አሹ ጾሳዋ፤","poem":1},{"text":"ጾሳዉ፥ ነ አሳ ኔን አንጃ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}