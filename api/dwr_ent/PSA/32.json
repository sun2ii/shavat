:6,"content":[{"text":"ሄዋ ድራዉ፥ ጾሳ አሳ ግድያ ኦንነ፥","poem":1},{"text":"ኔን ቤትያ ዎደ፥ ኔና ዎሶ።","poem":2},{"text":"ዎልቃማ ሃይ ኩንያ ዎደ፥","poem":1},{"text":"ቱሙዋፐ ሄ ኡራ ጋከና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኔን ታዉ ቆሰትያ ሳኣ፤","poem":1},{"text":"ኔን ታና መቱዋፐ ናጋሳ።","poem":2},{"text":"አቶተ የ የጽያዋንታ ታ ዩሹዋን ዎዳ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ጾሳይ፥ “ታን ኔና ኤርሳናነ፥","poem":1},{"text":"ኔን ባናዉ በስያ ኦግያ ኔና ታማርሳና፤","poem":2},{"text":"ታን ኔና ዞራናነ ናጋና።","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ብጻላንነ ፑሉዋን ኦይቀተናን አዛዘተና፥","poem":1},{"text":"ዎዛናይ ባይና ባቁሉዋዳን","poem":2},{"lineBreak":true},{"text":"ዎይ ፓራዳን ህንተ ሀኖፕተ” ያጌ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ኢታቶ ቱጋይ ዳራና፤","poem":1},{"text":"ሽን መና ጎዳን አማነትያዋንታ፥","poem":2},{"lineBreak":true},{"text":"አገና ሲቁ ዶዳና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ህንተኖ፥ ጽሎቶ፥","poem":1},{"text":"መና ጎዳን ናሸትተነ “ሀሹ!” ጊተ፤","poem":2},{"lineBreak":true},{"text":"ህንተኖ፥ ዎዛና ሱረቶ፥ ናሸቻዉ የጽተ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}