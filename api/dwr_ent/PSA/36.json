{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":36,"content":[{"type":"heading","content":["ናጋራንቻ ኢታተነ ጾሳ ሎኦተ"]},{"type":"hebrew_subtitle","content":["ዛማረቱዋ ካፖ የጸቴዳ፥ መና ጎዳ ቆማ ዳዊታ ማዝሙርያ"]},{"type":"verse","number":1,"content":[{"text":"ኢታ አሳይ ባረ ዎዛናን ደእያ ኢታተ ኮሻ ሀይዜ።","poem":1},{"text":"ጾሳዉ ያይያዌ አ ቆፋን ባዋ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አያዉ ጎፐ፥ እ ባረና ሎይ ናሼ፤","poem":1},{"text":"ሄዎ እ ባረ ናጋራ ደማናዉነ እጻናዉ ዳንዳየና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አ ዶናፐ ከስያ ሃሳያይ ገንያነ ዎርዱዋ።","poem":1},{"text":"አዳ ኤራባነ ሎኦባ ኦያዋ እ አጌዳ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እ ባረ ሂጻን ደኢደካ ገንያባ ኦናዉ ሀልቼ።","poem":1},{"text":"እ ሎኦ ግደና ኦግያን ኤቄዳ፤","poem":2},{"text":"እ ኢታባ እጸና።","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"አቤት መና ጎዳዉ፥ አገና ነ ሲቁ ሳሎቱዋ ጋኬ፤","poem":1},{"text":"ነ ቱማተይካ ቦላ ሻርያዳን ቄ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ነ ጽሎተይ ኡባፐ ቃ ደረቱዋ ማላ፤","poem":1},{"text":"ነ ፕርዳይካ ኡባፐ ዝቃ ጪማ ማላ።","poem":2},{"text":"አቤት መና ጎዳዉ፥ ኔን አሳካ ዶኣካ ናጋሳ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"አቤት ጾሳዉ፥ አገና ነ ሲቁ አይባ አልኦቤ!","poem":1},{"text":"አሳይ ነ ቀፍያ ግዶ ባቃት አቴ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኡንቱንቱ ነ ሶ ግዶን ፓላሆ ማዳፐ ሚደ ካሊኖ፤","poem":1},{"text":"ነ ኬካተ ሻፋፐ ኔን ኡንቱንታ ኡሻሳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አያዉ ጎፐ፥ ደኡዋ ፑልቱ ነ ማታን ደኤ፤","poem":1},{"text":"ነ ፖኡዋን ኑን ፖኡዋ በኤቶ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኔና ኤርያዋንታ ኔን ሲቅያ ሲቁዋነ","poem":1},{"text":"ሱረቶ ኬክያ ኬካ አጎፓ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኦቶራንቻ ገዲ ታና የፖ፤","poem":1},{"text":"ናጋራንቻቱዋ ኩሺ ታና የደርሶፖ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኢታ አሳቱ ኩንዴዳዋንታ በእተ፤","poem":1},{"text":"ኡንቱንቱ ኩንዴድኖ፤ ደንዳናዉካ ዳንዳይክኖ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}