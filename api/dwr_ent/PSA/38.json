ntent":[{"text":"ታን ዳቡራድነ ንፕ ጋድ፤","poem":1},{"text":"ታ ዎዛናይ ድድቅያ ድራዉ ኦላይ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"አቤት ጾሳዉ፥ ታ አሙ ኡባይ ነዉ ኤረቴ፤","poem":1},{"text":"ታን ኦልያዌ ኔፐ ጌምቤና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ ዎዛና አይፍያን ድድቄ፤","poem":1},{"text":"ታ ዎልቃይ እጽና፤","poem":2},{"text":"ታ አይፊካ ጼላ እጼዳ።","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ታ ማይ ድራዉ፥","poem":1},{"text":"ታ ሾሮቱካ ታ ላገቱካ ሃኩዋን ኤቄድኖ።","poem":2},{"text":"ታ ዳቦቱካ ታፐ ሃኬድኖ።","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ታና ዎናዉ ኮይያዋንቱ፥","poem":1},{"text":"ባረንቱ ጲርያ ታዉ የጊኖ።","poem":2},{"text":"ታና ቆሀናዉ ኮይያዋንቱ፥","poem":1},{"text":"“ኤቃሻ፤ ኑን ኔና ደማና” ያጊደ፥","poem":2},{"lineBreak":true},{"text":"ማንዲኖነ ጋላሳ ኩመን ታ ቦላ ያኢኖ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሄ ዎደ ታን ቱለ አሳ ማላ፥ ስስከ፤","poem":1},{"text":"ታን ዱደ አሳ ማላ፥ ዶናነ ፖክከ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኤ፥ ታን ስሰናነ","poem":1},{"text":"ዶናይ ዛረና አሳ ማላ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሽን አቤት መና ጎዳዉ፥ ታን ኔናን ህዶታ ኦይ።","poem":1},{"text":"አቤት መና ጎዳዉ፥ ታ ጾሳዉ፥ ኔን ታዉ ዛሩዋ እማና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታን ጾሳ፥ “ታ ገዲ በትና፥","poem":1},{"text":"ኡንቱንቱ፥ ‘አዉ ሀሹ’ ጋናዳንነ","poem":2},{"lineBreak":true},{"text":"ታ ቦላ ጬቀታናዳን ኦፓ” ያጋይ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ታን ኩንዳና ሀናይ፤","poem":1},{"text":"ታ ሳኩካ ታና የደናን እጼዳ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ታን ታ ኢታ ኦሱዋ ፓጻይ፤","poem":1},{"text":"ታን ታ ናጋራ ጋሱዋን ካዮታይ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ታ ሞርከቱ ጎባነ ዎልቃማ፤","poem":1},{"text":"ታና ጮ እጽያዋንቱ ጮራ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ታን ሎኦባ ኦና፥","poem":1},{"text":"ታዉ ኢታ ዛርያ አሳቱ፥","poem":2},{"text":"ታን ሎኦባ ካልያ ድራዉ፥ ታና ኤቀቲኖ።","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"አቤት መና ጎዳዉ፥ ታና የጎፓ።","poem":1},{"text":"አቤት ታ ጾ