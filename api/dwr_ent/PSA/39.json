{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":39,"content":[{"type":"heading","content":["መቱ ጋካ አሳ ፓጸ"]},{"type":"hebrew_subtitle","content":["ዳዊተ ዛማረቱዋ ካፑዋ ጁዱቶ የጼዳ አማኑዋ ቃላ (1 ኦዱዋ 25:3)"]},{"type":"verse","number":1,"content":[{"text":"ታን፥ “ታ እንጻርሳን ናጋራ ኦናዳን፥","poem":1},{"text":"ታ ኦግያ ናጋና።","poem":2},{"text":"ኢታ አሳቱ ታ ስንን ደእያ ዎደ፥","poem":3},{"lineBreak":true},{"text":"ታ ዶና ባራና” ያጋድ።","poem":3}]},{"type":"verse","number":2,"content":[{"text":"ሽን ታን ዱድያዳን ጮኡ ጋድ፤","poem":1},{"text":"ታን ሀራይ አቶ ሎኦባ ሃሳይያዋካ አግና፥","poem":2},{"text":"ታ ዋዪ ያ ዳሬዳ።","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ታ ዎዛናይ ታ ጋርሳን ሴሌዳ፤","poem":1},{"text":"ታ ቆፋይ ፖዱ ጊደ፥ ኤጽ ከሴዳ።","poem":2},{"text":"ያትና፥ ታ እንጻርሳን ሀዋዳን ያጋድ፤","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“አቤት መና ጎዳዉ፥ ታ ደኡዋ ዉርሰነ","poem":1},{"text":"ታ ደአናዉ አቴዳ ጋላሳ ታና በሳ።","poem":2},{"text":"ቃይ ታ ደኡ ዉራናዉ አይ ኬሻ ኤሌልንቶ፥ ታና ኤርሳ።","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ኔን ታ ላይ ጺ ታካ ኬሻ ከሳዳ።","poem":1},{"text":"ታ ላይይ ነ ስንን ባይናዋ ማላ፤","poem":2},{"lineBreak":true},{"text":"ቱሙዋፐ አሳይ ኡባይ እት ገደ ሸምፕያ ጫርኩዋ ማላ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ቱሙዋፐ አሳይ ኤሹዋዳን ሀመቴ፤","poem":1},{"text":"ቱሙዋፐ ጮ መላ ስመረቴ።","poem":2},{"text":"እ ማጹዋ ሺሼ፤ ሽን አካና አሳ ኤረና።","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“አቤት ጎዳዉ፥ ሀእ ስም፥","poem":1},{"text":"ታን ናግያዌ አዬ?","poem":2},{"text":"ታን ህዶታ ኦያዌ ኔናና።","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ታ ባይዙዋ ኡባፐ ታና አሻ፤","poem":1},{"text":"ኤያቱዋን ታና ቶሽሶፓ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሀዋ ኡባ ኦዳዌ","poem":1},{"text":"ኔና ግድያ ድራዉ፥ ታን ዱዳድ፤","poem":2},{"text":"ዶናነ ፖጋበይከ።","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ነ ቦሻ ታ ቦላፐ ደን።","poem":1},{"text":"ነ ኩሽያ ምኖተ ጋሱዋን ታን ዳቡራድ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኔን አሳ አ ናጋራ ድራዉ፥ ሴራሳነ ሙራሳ፤","poem":1},{"text":"አ አልኦ ሸምፑዋ ብልኣዳን ዉርሳሳ።","poem":2},{"text":"ቱሙዋፐ አሳይ ኡባይ እት ገደ ጫርክያ ጫርኩዋ ማላ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“አቤት መና ጎዳዉ፥ ታ ዎሳ ስሳ፤","poem":1},{"text":"ታና ማዳናዉ ታ ዋሱዋ ሀይዛ።","poem":2},{"text":"ታ አፎ ጮኡ ጎፓ፤","poem":1},{"text":"አያዉ ጎፐ፥ ታን ታ አዎቱዋ ኡባዳን በተነ እማ ግዳደ፥","poem":2},{"lineBreak":true},{"text":"ኔናና ደአይ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታን ሻከታናፐነ ያናፐ፥","poem":1},{"text":"ካሰታደ ናሸታና ማላ፥","poem":2},{"lineBreak":true},{"text":"ሀእ ታና አጋ” ያጋድ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}