true},{"text":"ኦንነ ፓይዳናዉ ዳንዳየና።","poem":2},{"lineBreak":true},{"text":"ሄዌ ታን ኦድና፥ ዉርያዋ ግደና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ኔን ያርሹዋነ እሙዋ ኮያባካ፤","poem":1},{"text":"ሽን ስሳና ማላ፥ ታዉ ሀይ ዶያዳ።","poem":2},{"text":"ጹግያ ያርሹዋነ ናጋራ ያርሹዋ ኔን ኮያባካ።","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ሄዋፐ ጉይያን ታን፥ “ጻ ማጻፋን","poem":1},{"text":"ታባይ ጻፈቴዳዋዳን፥ ታን ያድ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አቤት ታ ጾሳዉ፥ ታን ኔን ኮይያዋ ኦናዉ ዶሳይ፤","poem":1},{"text":"ነ ህጊ ታ ዎዛና ግዶን ደኤ” ያጋድ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ዎልቃማ ሺቁዋን ታን፥ “ነ ጽሎተ”","poem":1},{"text":"ምሽራቹዋ ኦዳና።","poem":2},{"text":"አቤት መና ጎዳዉ፥ ኔን ኤርያዋዳንካ፥","poem":1},{"text":"ታን ታ ዶናን ኦድያዋ አጋበይከ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታን ነ ጽሎተ ታ ዎዛና ግዶን ቆሳበይከ፤","poem":1},{"text":"ኔን አማነትያዋነ አሽያዋ ኦዳድ።","poem":2},{"text":"ቃይ አገና ነ ሲቁዋነ ነ ቱማተ፥","poem":1},{"text":"ነ ዎልቃማ ሺቁዋፐ ገንበይከ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አቤት መና ጎዳዉ፥ ነ ማሮተ ታፐ ሃሶፓ።","poem":1},{"text":"አገና ነ ሲቁነ ነ ቱማተይ","poem":2},{"lineBreak":true},{"text":"ታና ኡባ ዎደ ናጎ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አያዉ ጎፐ፥ ፓይዱ ባይና ኢታባይ ታና ዶዴዳ።","poem":1},{"text":"ታ ኢታተይ ታና ጋኪደ ጎዜዳ፤","poem":2},{"lineBreak":true},{"text":"ታን ጼላናዉ ዳንዳይከ።","poem":2},{"lineBreak":true},{"text":"ታ ኢታ ኦሱ ታ ሁጲያ ብናናፐ ዳሬዳ፤","poem":2},{"lineBreak":true},{"text":"ታ ዎዛናይ ታ ግዶን ሴሬዳ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አቤት መና ጎዳዉ፥ ታና አሻናዉ ኤኖ ጋ፤","poem":1},{"text":"አቤት መና ጎዳዉ፥ ታና ማዳናዉ ኤሌላ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታና ዎናዉ ኮይያዋንቱ","poem":1},{"text":"ኡባካ ዬላትኖነ ካዉሽኖ።","poem":2},{"text":"ታን ቆሄታናዋ አሞትያዋንቱ","poem":1},{"text":"ካዉሺደ ጉየ ስምኖ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታ ቦላ፥ “አዉ ሀሹ! ሀሹ!”","poem":1},{"text":"ጌዳዋንቱ ጾነቴዳ ድራዉ፥ ዬላትኖ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሽን ኔና ኮይያ ኡባቱ፥","poem":1},{"text":"ኔናን ናሸትኖነ ሀሹ ጊኖ።","poem":2},{"text":"ቃይ ነ አቶተ ዶስያዋንቱ ኡባቱ፥","poem":1},{"text":"“መና ጎዳይ ግታቶ!” ያግኖ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ታን ህዬሳነ መቶታንቻ፤","poem":1},{"text":"ታዋ ጎዳይ ቆፖ።","poem":2},{"text":"ታና ማድያዌነ አሽያዌ ኔና፤","poem":1},{"text":"አቤት ታ ጾሳዉ፥ ጋምኦፓ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}