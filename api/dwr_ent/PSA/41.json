{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":41,"content":[{"type":"heading","content":["ሀርጋንቻ አሳ ዎሳ"]},{"type":"hebrew_subtitle","content":["ዛማረቱዋ ካፖ የጸቴዳ፥ ዳዊታ ማዝሙርያ"]},{"type":"verse","number":1,"content":[{"text":"ህዬሳዉ ቆፕያ አሳይ አንጀቴዳዋ፤","poem":1},{"text":"መቱዋ ጋላስ መና ጎዳይ አ አሼ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"መና ጎዳይ አ ናጊደ፥ ፓጻ ዎ።","poem":1},{"text":"እነ ቢታ ቦላን አንጀቴዳዋ ግዴ፤","poem":2},{"text":"ጾሳይ አ አ ሞርከቱዋ አሞ አደ እመና።","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"መና ጎዳይ አ ሀርግያ ሂን ደእሺናካ ማዴ፤","poem":1},{"text":"እ ሳከትናካ፥ አ ፓ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ታና ግዶፐ፥ ታን፥ “አቤት መና ጎዳዉ፥","poem":1},{"text":"ታን ኔና ናቄዳ ድራዉ፥ ታና ማራ፤","poem":2},{"text":"ሀርግያፐካ ታና ፓ” ያጋድ።","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ታ ሞርከቱ ኢታባን ታና ሃሳዪደ፥","poem":1},{"text":"“እ አዉደ ሀይቃንዴሻ?","poem":2},{"text":"ቃይ አ ሱንይካ አዉደ ያንዴሻ?” ያጊኖ።","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ታና በአናዉ ይያ ኦንነ ታዉ ዎርዶባ ኦዴ፤","poem":1},{"text":"ባረ ዎዛናን ታና ዝግርያዋ ብዴ።","poem":2},{"text":"ሄዋፐ ጉይያን፥ ካረ ከሲደ፥","poem":1},{"text":"ያነ ሃነ ኦዱዋ ላሌ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ታና እጽያ ኡባቱ","poem":1},{"text":"እትፐ ታ ቦላን ሳሱኪኖ፤","poem":2},{"text":"“ኢታባይ አ ቦላ ጋኬ” ጊደ ቆፒኖ።","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ኡንቱንቱ “አ ኢታ ሀርጊ ኦይቄዳ፤","poem":1},{"text":"እ ሄ ግሴዳሳፐ ኡባካ ደንደና” ያጊኖ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሀራይ አትና፥ ታን አማነትያ ታ ሲቆ ላጊ፥","poem":1},{"text":"ታን ባርሴዳዌ ታ ኩሽያ ሳኤዳ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሽን አቤት መና ጎዳዉ፥ ኔን ታና ማራ፤","poem":1},{"text":"ታን ኡንቱንቱ ኩሽያ ከሳናዳን፥","poem":2},{"lineBreak":true},{"text":"ታና ሀርግያ ሂፐ ደን።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኔን ታናን ናሸታናዋ ታን ኤራይ፤","poem":1},{"text":"አያዉ ጎፐ፥ ታ ሞርኪ ታና፥","poem":2},{"lineBreak":true},{"text":"ጾኒደ ጋይረና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኔን ታና ታ ሱረተ ድራዉ ዘምፕሳዳ፤","poem":1},{"text":"ነ ስንን ታና መናዉ ዎዳ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"መና ጎዳይ፥ እስራኤልያ ጾሳይ፥","poem":1},{"text":"መናፐ መና ጋካናዉ ጋላተቶ።","poem":2},{"lineBreak":true},{"text":"አመንእ። አመንእ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}