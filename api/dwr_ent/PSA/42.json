{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":42,"content":[{"type":"heading","content":["የደሳ ዎደ ዎሳ"]},{"type":"hebrew_subtitle","content":["ዛማረቱዋ ካፖ የጸቴዳ፥ ቆረ ናናቱዋ አኬካ ግንጹዋ"]},{"type":"verse","number":1,"content":[{"text":"ጋራይ ጎግያ ሃ ላሞትያዋዳን፥","poem":1},{"text":"አቤት ጾሳዉ፥ ሄዋዳን ታንካ ኔና ላሞታይ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“ታን ባደ፥ ጾሳ ስን","poem":1},{"text":"በአናዌ አዉዴሻ?” ጋደ፥","poem":2},{"text":"ጾሳ፥ ደኡዋ ጾሳ በአናዉ ሳመታይ።","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"አሳቱ ኡባ ገደ፥ “ነ ጾሳይ ሀቃን ደኢ?”","poem":1},{"text":"ያግያ ዎደ፥ ታዉ ጋላስነ ቃማ ታ አፎይ ቁማ ግዴዳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ታን ኡንቱንቱ ባላ ቦንቻናዉ፥","poem":1},{"text":"ሺቄዳ ዳሮ አሳ ግዱዋና","poem":2},{"lineBreak":true},{"text":"ሳልፕያን ሆምቦጭሺናነ","poem":2},{"lineBreak":true},{"text":"ጋላታ የ የጽሽን፥","poem":2},{"text":"ጾሳ ጎለ ካለዳዋ ቆፕያ ዎደ፥","poem":1},{"text":"ታ ዎዛናይ ካዮቲደ፥ ግዶን ሴሬዳ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ታ ሸምፓቴ፥ ታን አያዉ ካዮታይታ?","poem":1},{"text":"ቃይ አያዉ ጃባካታይታ?","poem":2},{"text":"ታን ጾሳን ህዶታ ዎና።","poem":1},{"text":"አያዉ ጎፐ፥ ታን ብሮ","poem":2},{"lineBreak":true},{"text":"ታና አሽያዋነ ታ ጾሳ ጋላታና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ታ ዎዛናይ ካዮቴዳ፤ ሄዋ ድራዉ፥","poem":1},{"text":"ታን ዮርዳኖሳ ቢታን፥ ሄርሞነ ቃን፥","poem":2},{"text":"ሚዛረ ደርያን ኤቃደ ኔና ሀሳያይ።","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ነ ሶሱዋ ጉንን ጪሙ ጪማዉ ጼሴ፤","poem":1},{"text":"ቃይ ነ ቤታይነ ነ ሆቢ ኡባይ","poem":2},{"lineBreak":true},{"text":"ታ ቦላና ጎጌዳ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጋላስ መና ጎዳይ አገና ባረ ሲቁዋ ታዉ ኪቴ።","poem":1},{"text":"ቃማካ አ የይ ታናና ደኤ፤","poem":2},{"lineBreak":true},{"text":"ሄ የይካ ታን ታ ደኡዋ ጾሳ ዎስያ ዎሳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ጾሳ፥ ታ ዎጋ ዛላ ታን፥","poem":1},{"text":"“አያዉ ታና ዶጋዲ?","poem":2},{"text":"ታን አያዉ ታ ሞርክያን ናቀታደ ካዮታደ ሀመቶ?” ያጋይ።","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ታ ሞርከቱ ታና፥","poem":1},{"text":"“ነ ጾሳይ ሀቃን ደኢ?” ያጊደ፥","poem":2},{"lineBreak":true},{"text":"ታ መቀ መንደ ቦሪኖ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ ሸምፓቴ፥ ታን አያዉ ካዮታይታ?","poem":1},{"text":"ቃይ አያዉ ጃባካታይታ?","poem":2},{"text":"ጾሳን ህዶታ ዎና።","poem":1},{"text":"አያዉ ጎፐ፥ ታን ሀእካ","poem":2},{"lineBreak":true},{"text":"ታና አሽያዋነ ታ ጾሳ ጋላታና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}