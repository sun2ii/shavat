"ታና አሽያዋነ ታ ጾሳ ጋላታና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}