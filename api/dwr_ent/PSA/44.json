se","number":5,"content":[{"text":"ኔናን ግዲደ፥ ኑ ሞርከቱዋ ኑን ሱግ ኦላና፤","poem":1},{"text":"ነ ሱንን ኑ ኤቀትያዋንታ ኑን የና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታን ታ ቶራን አማነትከ፤","poem":1},{"text":"ታ ማሻይካ ታና አሸና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሽን ኔን ኑና ኑ ሞርከቱዋፐ አሻዳ፤","poem":1},{"text":"ቃይ ኑና እጽያዋንታ ኔን ካዉሻዳ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኑን ኡባ ዎደ ጾሳን ጬቀቴቶ፤","poem":1},{"text":"ነ ሱንዉ መናዉ ጋላታ እማና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ሽን ሀእ ኔን ኑና አጋዳ፤ ካዉሻዳ፤","poem":1},{"text":"ኑ ቶራ አሳና እትፐ ኦላ ባካ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኑ ሞርከቱዋ ስንፐ ኑና ባቃትሳዳ፤","poem":1},{"text":"ኑ ኤቀትያዋንቱ ኑባ ቦንቄድኖ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኔን ኑና ዶርሳቱዋዳን ሹካዉ አደ እማዳ፤","poem":1},{"text":"ቃይ ካዉተቱዋ ግዶን ኑና ላላዳ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኔን ነ አሳ ህራይሱዋን ዛልኣዳ፤","poem":1},{"text":"አያ ዎያነ ደማበይካ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኔን ኑና ኑ ሾሮቱ ቦርያዋ፥","poem":1},{"text":"ቃይ ኑ ሄራን ደእያዋንቱ ቅሊጭያዋነ ሚጭያዋ ኦዳ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኔን ኑና ካዉተቱዋ ግዶን ቶሳ ከሳዳ፤","poem":1},{"text":"ኑና ኡንቱንቱ ባረንቱ ሁጲያ ቃ ቃ ቅያዋ ኦዳ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታን ጋላሳ ኩመንን ቶሸታድ።","poem":1},{"text":"ታ ሶምእያ ዬላይ ካሜዳ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታና ሸቂያዋንቱነ ቦርያዋንቱ ጋሱዋን፥","poem":1},{"text":"ታና ሞርክያዋንቱነ ማንድያዋንቱ ጋሱዋና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኑን ኔና ዶግቤናዋ ግዶፐካ፥","poem":1},{"text":"ዎይ ነ ጫቁዋ መንቤናዋ ግዶፐካ፥","poem":2},{"text":"ሀዌ ኡባይ ኑ ቦላ ሀኔዳ።","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ኑ ዎዛናይ ኔፐ ጉየ ስምቤና፤","poem":1},{"text":"ኑ ገዲ ነ ኦግያፐ ጋጻ ከስቤና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሽን ኔን ኑና መንሬደ ዶኣ ግዶን የጋዳ፤","poem":1},{"text":"ጵ ጎ ማን ካማዳ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ኑ ጾሳ ሱን ኑን ዶጌደንቶ፥"