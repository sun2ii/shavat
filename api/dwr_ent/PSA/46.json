number":6,"content":[{"lineBreak":true},{"text":"ጋድያ አሳይ ሻባረቴ፤","poem":1},{"text":"ካዉተቱ ቃጺኖ።","poem":2},{"text":"ጾሳይ ባረ ቃላ ስሴዳ ዎደ፥ ሳአይ ሴሬ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"መተ ኡባ ጎዳይ ኑናና ደኤ፤","poem":1},{"text":"ያቆባ ጾሳይ ኑን ቆሰት አትያ ሳኣ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ሃ ዪተ፤ መና ጎዳይ ኦሱዋ ጼልተ፤","poem":1},{"text":"እ ሳኣን አሄዳ ባሻ በእተ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እ ሳኣ ጋጻ ጋካናዉ ደእያ ኦላ ተኤ፤","poem":1},{"text":"ዎንዳፍያ መን፤","poem":2},{"lineBreak":true},{"text":"ቶራ መን፤","poem":2},{"lineBreak":true},{"text":"ጎንዳልያካ ታማን ጹጌ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዎፑ ጊተ፤ ታን ጾሳ ግድያዋ ኤርተ።","poem":1},{"text":"ታን ካዉተቱዋ ግዶን ቃይ።","poem":2},{"text":"ቃይ ቢታ ቦላንካ ቃይ።","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ኡባፐ ዎልቃማ መና ጎዳይ ኑናና ደኤ፤","poem":1},{"text":"ያቆባ ጾሳይ ኑን ቆሰት አትያ ሳኣ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}