:"verse","number":7,"content":[{"text":"ጾሳይ ሳኣ ኡባ ካትያ ግድያ ድራዉ፥","poem":1},{"text":"ጋላታ ሳባ ሳቢተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ጾሳይ ባረ ጌሻ ካዉተ አራታን ኡቴዳ፤","poem":1},{"text":"ጾሳይ ካዉተቱዋ ኡባ ሞዴ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ካዉተቱዋ ካፓቱ፥","poem":1},{"text":"አብራሃማ ጾሳ አሳቱዋና እትፐ ሺቂኖ።","poem":2},{"text":"አያዉ ጎፐ፥ ሳኣን ደእያ ዎልቃማቱ ኡባይ ጾሳሳ፤","poem":1},{"text":"እ ሎይ ቁ ጌዳ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}