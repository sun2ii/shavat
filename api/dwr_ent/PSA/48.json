{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":48,"content":[{"type":"heading","content":["ጾሳ ካታማት ጽዮኖ"]},{"type":"hebrew_subtitle","content":["ቆራሀ ናናቱዋ ማዛሙርያ፤ የ"]},{"type":"verse","number":1,"content":[{"text":"መና ጎዳይ ዎልቃማ።","poem":1},{"text":"ኑ ጾሳ ካታማን አ ጌሻ ደርያን አ ጋላታይ አዉ በሴ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ጾሳ ደርያ ጽዮነ ቃነ ሎአ።","poem":1},{"text":"ፑደሃ ባጋና ደእያ","poem":2},{"text":"ሄ ዎልቃማ ካትያ ካታማይ ሳኣ ኡባዉ ናሸቻ።","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ሄ ካታማ ግምቢያ ግዶን፥","poem":1},{"text":"ባረናን ሳሮ አሳይ ደእያዋ ጾሳይ በሴዳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ካተቱ ባረንቱ ቶራንቻቱዋና እትፐ ሺቄድኖ፤","poem":1},{"text":"ጽዮነ ኦላናዉ ዬድኖ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አ በኢደ፥ ማላለቲድነ ዳጋሚደ፥","poem":1},{"text":"ባቃቴድኖ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኡንቱንቱ ሄዋን ደእሺና፥","poem":1},{"text":"ኡንቱንታ ያሻ ኮኮርሳይ ኦይቄዳ፤","poem":2},{"lineBreak":true},{"text":"ኦይይ ኦይቄዳ ምሽራቲዳን ኡንኤቴድኖ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አዋይ ዶልያ ባጋ ዎልቃማ ጫርኩዋን፥","poem":1},{"text":"መእያ ታርሴሰ ማርካብያዳን ኡንቱንቱ ኮኮሬድኖ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ኑን ስሴዳዋዳንካ፥","poem":1},{"text":"ኡባፐ ዎልቃማ መና ጎዳ ካታማን፥","poem":2},{"lineBreak":true},{"text":"ኑ ጾሳ ካታማን፥ እ ኦዳዋ በኤዶ።","poem":2},{"lineBreak":true},{"text":"ጾሳይ ሄ ካታማ መናዉ ምንስ ኤሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"አቤት ጾሳዉ፥ ነ ጌሻ ጎልያ ግዶን","poem":1},{"text":"አገና ነ ሲቁዋ ቆፔዶ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አቤት ጾሳዉ፥ ነ ሱንዳንካ፥","poem":1},{"text":"ነ ጋላታይ ሳኣ ጋጻ ጋኬዳ።","poem":2},{"text":"ነ ኡሸቻ ኩሺ ጽሎተን ኩሜዳዋ።","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ነ ፕርዳ ድራዉ፥","poem":1},{"text":"ጽዮነ አሳይ ናሸቴ፤","poem":2},{"text":"ይሁዳ ሞቱካ ናሸቲኖ።","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ጽዮነ ዩሹዋን ሀመትተ፤","poem":1},{"text":"እ ዩሹዋን ያነ ሃነ ስመረትተ።","poem":2},{"text":"እ ዎችያ ሳ ፓይድተ።","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ይያ የለታዉ ኦዳናዳን፥","poem":1},{"text":"እዝ ግምቢያ አኬክተነ እዝ አኮ ግምቢያ ጾሞስተ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ህንተ፥ “መ መናዉ","poem":1},{"text":"ሀ ጾሳይ ኑ ጾሳ፤","poem":2},{"text":"እ ኑና ሀይቃና ጋካናዉ ካለና” ያጊደ ኦድተ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}