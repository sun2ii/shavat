t":"ኔን ሀዋ ኡባ ኦያ ዎደ፥","poem":1},{"text":"ታን ጮኡ ጌዳ ድራዉ፥","poem":2},{"text":"ታናካ ነ ማላ ጋደ ቆፓዳ።","poem":1},{"text":"ሽን ሀእ ታን ኔና ሴራይነ","poem":2},{"lineBreak":true},{"text":"ነ ባላ ነ ስንን ፓይዳይ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“ህንተኖ፥ ጾሳ ዶግያዋንቶ፥ ሀዋ አኬክተ።","poem":1},{"text":"ሄዌ ዮፐ፥ ታን ህንተና መንሬና፤","poem":2},{"lineBreak":true},{"text":"ሄ ዎደ ህንተና አሽያዌ ባዋ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ታዉ ጋላታ እምያ አሳይ ታና ቦንቼ።","poem":1},{"text":"ባረ ኦግያ ሱርስያ አሳ","poem":2},{"lineBreak":true},{"text":"ታን ጾሳ አቶተ በሳና” ያጌ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}