6,"content":[{"lineBreak":true},{"text":"ጽሎቱ ሀዋ በኢደ ያያና።","poem":1},{"text":"ኡንቱንቱ ሀዋዳን ያጊደ፥ ነ ቦላ ሚጫና፤","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“ጾሳ ባረዉ ጌሱዋ ኦቤና፥","poem":1},{"text":"ባረ ዱረተ ዳሩዋን አማነቴዳ፥","poem":2},{"text":"ኢታ ኦሱዋን ምኔዳ ብታንያ","poem":1},{"text":"ሀዋ በእተ!” ያጋና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሽን ታን ጾሳ ጎልያን አጭያ ዎጋራ ማላ።","poem":1},{"text":"አገና አ ሲቁዋን ታን መ መናዉ አማነታይ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኔን ኦዳ ድራዉ፥","poem":1},{"text":"ታ ኔና ጋላታና፥","poem":2},{"lineBreak":true},{"text":"ታን ኔን ኬካ ግድያ ድራዉ ነ ሱንን ህዶታ ዎይ።","poem":2},{"lineBreak":true},{"text":"ታን ጾሳ አሳቱዋ ስንን ኔና ሳባና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}