{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":53,"content":[{"type":"heading","content":["አሳ ኢታተ"]},{"type":"hebrew_subtitle","content":["ዛማረቱዋ ካፖ የጸቴዳ፥ ዳዊታ አኬካ ግንጹዋ."]},{"type":"verse","number":1,"content":[{"text":"ቦዛቱ ባረንቱ ዎዛናን፥","poem":1},{"text":"“ጾሳይ ባዋ” ያጊኖ።","poem":2},{"text":"ኡንቱንቱ ደኡ ባዬዳ።","poem":3},{"lineBreak":true},{"text":"ኡንቱንቱ ሸነይያባ ኦኖ፤","poem":3},{"lineBreak":true},{"text":"ሎእያባ ኦያ አሳይ ባዋ።","poem":3}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ጾሳ ኮይያ ኤራንቻቱ ደእንቶነ በአናዉ፥","poem":1},{"text":"ጾሳይ ሳሉዋፐ ዱገ አሳ ጼሌ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኡንቱንቱ ኡባይካ ጾሳፐ ሃኬድኖ፤","poem":1},{"text":"ኡባይካ እትፐ ቱኔድኖ።","poem":2},{"text":"ሎኡዋ ኦያ አሳይ ባዋ፤","poem":1},{"text":"ሀራይ አቶ እቱነ ባዋ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ጾሳይ፥ “ሀዋንቱ ታ አሳ ቦንቂ ምያ ኢታ አሳቱ","poem":1},{"text":"ቱሙ አይነ ኤርክኖ?","poem":2},{"text":"ኡንቱንቱ ታና ዎስክኖ” ያጌ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ኡንቱንቱ ካሰ ዳጋም ኤረናዋ ኬሻ ዳጋማና።","poem":1},{"text":"አያዉ ጎፐ፥ ጾሳይ ባረ አሳ ሞርክያዋንቱ መቀ ላላና።","poem":2},{"text":"ጾሳይ ኡንቱንታ ካዳ ድራዉ፥ ኡንቱንቱ ዬላታና።","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"እስራኤልያዉ አቶተይ ጽዮነፐ ዬረኔ!","poem":1},{"text":"ጾሳይ ባረ አሳ ኦሞዱዋ ዛርያ ዎደ፥","poem":2},{"text":"ያቆባ ዛራቱ ናሸታና፤","poem":1},{"text":"እስራኤልያ አሳይ ናሸቻዉ ፖጩ ጋና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}