:"ኔን ኬካ ግድያ ድራዉ፥","poem":2},{"text":"ታን ነ ሱን ጋላታና።","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"አያዉ ጎፐ፥ ኔን ታና","poem":1},{"text":"ታ መቱዋ ኡባፐ አሻዳ፤","poem":2},{"text":"ታ ሞርከቱ ጾነትያዋ ታ አይፍያን በኣድ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}