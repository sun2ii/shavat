{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":57,"content":[{"type":"heading","content":["ማዱዋ ደማናዉ ሺቄዳ ዎሳ"]},{"type":"hebrew_subtitle","content":["ዛማረቱዋ ካፖ፥ ጎንጎሎ ግዶፐ ሳኦላፐ ባቃቲደ ብ ስምና ዳዊታ ዎሳ። “ይሶፓ” ጌተትያ ዎሳን የጸቴዳ ዎሳ።"]},{"type":"verse","number":1,"content":[{"text":"ታና ማራ፤ አቤት ጾሳዉ፥ ታና ማራ፤","poem":1},{"text":"ታን ኔኮ ባቃታይ።","poem":2},{"text":"ባሻይ አና ጋካናዉ፥","poem":1},{"text":"ነ ቀፍያ ግዶን ባቃታደ አታይ።","poem":3}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ታን ኡባፐ ቂያ ጾሳዉ፥","poem":1},{"text":"ታዉ ኡባባ ኦያ ጾሳዉ ዋሳይ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ጾሳይ ሳሉዋፐ ማዱዋ ኪቲደ፥ ታና አሻና፤","poem":1},{"text":"ታና ናቂያዋንታ ካዉሻና፤","poem":2},{"text":"ጾሳይ አገና ባረ ሲቁዋነ","poem":1},{"text":"ባረ ቱማተ ታዉ ኪታና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ታን ታ ሞርከቱዋ ግዶን፥","poem":1},{"text":"አሳ ቦንቂደ ምያ ጋሙዋ ማላቱዋ ግዶን ደአይ።","poem":2},{"text":"ኡንቱንቱ አቻይ ቶራነ ዎንዳፍያ ማላ፤","poem":1},{"text":"ኡንቱንቱ እንጻርሳይ ኩሳ ማሻ ማላ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"አቤት ጾሳዉ፥ ኔን ሳሎቱዋፐ ቦላና ቁ ቁ ጋ፤","poem":1},{"text":"ነ ቦንቹ ሳኣ ኡባ ቦላ ደኦ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ኡንቱንቱ ታ ገድያዉ ጲርያ ዎድኖ፤","poem":1},{"text":"ታን መቶታደ ሆካድ።","poem":2},{"text":"ኡንቱንቱ ታ ኦግያን ኦላ ቦኬድኖ፤","poem":1},{"text":"ሽን ሄ ኦላን ባረንቶ ኩንዴድኖ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ታ ዎዛናይ ምኒደ ደኤ፤","poem":1},{"text":"አቤት ጾሳዉ፥ ታ ዎዛናይ ምኒደ ደኤ።","poem":2},{"text":"ታን ነዉ የጻናነ ኔና ሳባና።","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ታ ሸምፓቴ፥ ቤጎታ!","poem":1},{"text":"ዲዉነ ማስንቆ፥ ቤጎትተ!","poem":2},{"text":"ታንካ ዎንታ ጉራና ቤጎታና።","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"አቤት ጾሳዉ፥ ታን ኔና አሳ ግዶን ጋላታና፤","poem":1},{"text":"ቃይ ካዉተ ግዶን ኔና ሳባና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አያዉ ጎፐ፥ አገና ነ ሲቁ ዎልቃማ፤","poem":1},{"text":"ሳሎቱዋ ጋኬዳ።","poem":2},{"text":"ነ ቱማተይካ ቦላ ሻርያዳን ቄ።","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"አቤት ጾሳዉ፥","poem":1},{"text":"ሳሎቱዋፐ ቦላና ቁ ቁ ጋ!","poem":2},{"text":"ነ ቦንቹ ሳኣ ኡባ ቦላ ግዶ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}