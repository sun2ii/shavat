{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":58,"content":[{"type":"heading","content":["ጾሳይ ናጋራንቻቱዋ ሙራናዳን ሺቆ ዎሳ"]},{"type":"hebrew_subtitle","content":["ዛማረቱዋ ካፖ የጸቴዳ፥ ዳዊታ ዎሳ። “ይሶፓ” ጌተትያ ማዝሙርያ ዋጹዋን የጸቴዳ ዎሳ።"]},{"type":"verse","number":1,"content":[{"text":"ህንተኖ ደርያ ሞድያዋንቶ፥","poem":1},{"text":"ቱሙዋፐ ልክያ ሃሳዪቴ?","poem":2},{"text":"አሳ ኡባ ግዶን ጽሉዋ ፕርዲቴ?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ግደና፥ ህንተ ዎዛናን ኢታባ ሀልቺታ፤","poem":1},{"text":"ቢታን ህንተ ኩሺ ማካላባ ኦዳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ኢታ አሳይ አት ኡሉዋፐ ዶሚደ ባሌ፤","poem":1},{"text":"የለቶደፐ ዶሚደ፥","poem":2},{"text":"ባይዜነ ዎርዱዋ ሃሳዬ።","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ኡንቱንቱ ሾሻዳን ይሻና ደኢኖ፤","poem":1},{"text":"ቱለ ሀሱዋዳን ሀይ ቱጬድኖ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ብትያዌ አይ ኬሻ ሂላንቻ ግዶፐካ፥","poem":1},{"text":"ሀሱ አ ሳሱከ ስሰና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"አቤት ጾሳዉ፥ ኡንቱንቱ አቻ","poem":1},{"text":"ኡንቱንቱ ጋፓታ ግዶን መን፤","poem":2},{"lineBreak":true},{"text":"አቤት መና ጎዳዉ፥ ጋሞቱዋ ካስልያ ካ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኡንቱንቱ ጎግ ይያ ሃዳን ይኖ።","poem":1},{"text":"ኡንቱንቱ ባረንቱ ዎንዳፍያ ዱክያ ዎደ፥","poem":2},{"lineBreak":true},{"text":"ፖ ጼራን ጫድያ አይፊ ዮ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኡንቱንቱ ሙሺደ ሳሶ ከስያ ያዳን ሀንኖ፤","poem":1},{"text":"አት ኡሉዋፐ ቦሸቲደ የለቴዳ፥","poem":2},{"lineBreak":true},{"text":"ፖኡዋ በኤና ናኣዳን ሀንኖ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኡንቱንቱ አጉን ግዲደ ዳሻናፐ ካሰ፥","poem":1},{"text":"ኡንቱንቱ ብሮ ፑትያን ደእሽን፥","poem":2},{"text":"ጾሳይ ኡንቱንታ ባረ ሀንቁዋን ይሳና።","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ሀሉዋ ከስያዋ በእያ ዎደ፥","poem":1},{"text":"ጽሎቱ ናሸታና።","poem":2},{"text":"ኢታቱዋ ሱን ባረንቱ ገድያ ሜጨታና።","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ሄ ዎደ አሳይ፥","poem":1},{"text":"“ቱሙካ ጽሎቶ ዎይቱ ደኤ፤","poem":2},{"lineBreak":true},{"text":"ቱሙካ ሳኣ ቦላ ፕርድያ ጾሳይ ደኤ” ያጋና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}