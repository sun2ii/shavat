:2},{"lineBreak":true},{"text":"ካዉተቱዋ ኡባ ፕርዳናዉ ቤጎታ፤","poem":2},{"lineBreak":true},{"text":"ማካላ ኦያዋንታ ማሮፓ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ኡንቱንቱ ኦማርሳን ስሚኖ፤","poem":1},{"text":"ካናቱዋዳን ቦጪደ፥ ካታማ ግዶን ዩዪኖ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሄኮ፥ ኡንቱንቱ ባረንቱ ዶናን ሃሳዪደ ሳልክኖ፤","poem":1},{"text":"ኡንቱንቱ እንጻርሳይ ማሻ ማላ።","poem":2},{"text":"ኡንቱንቱ ብሮ፥ “ኦንነ ስሰና” ጊደ ቆፒኖ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ሽን አቤት መና ጎዳዉ፥","poem":1},{"text":"ኔን ኡንቱንቱ ቦላ ሚጫሳ፤","poem":2},{"lineBreak":true},{"text":"ካዉተቱዋ ኡባ ቦላ ቅሊጫሳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ጾሳዉ፥ ኔን ታዉ ቆሰታ አትያ ሳኣ ግድያ ድራዉ፥","poem":1},{"text":"ታን ነ ዎልቃን አማነታይ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ ጾሳይ አገና ባረ ሲቁዋን ታኮ ያና፤","poem":1},{"text":"ታ ጾሳይ ታ ሞርከቱዋ ጾንያዋ እ ታና በሳና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ አሳቱ ዶገና ማላ፥ ኔን ኡንቱንታ ዎፓ።","poem":1},{"text":"አቤት ጾሳዉ፥ ኑ ጎንዳልያዉ፥","poem":2},{"lineBreak":true},{"text":"ነ ዎልቃን ኡንቱንታ ላላደ ጾና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኡንቱንቱ ባረንቱ ዶና ናጋራ ድራዉነ","poem":1},{"text":"ባረንቱ እንጻርሳ ቃላ ድራዉ፥","poem":2},{"lineBreak":true},{"text":"ባረንቱ ኦቶሩዋን ኦይቀትኖ።","poem":2},{"lineBreak":true},{"text":"ኡንቱንቱ ሸቃ ድራዉነ ኡንቱንቱ ሃሳይያ ዎርዱዋ ድራዉ፥","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ነ ሀንቁዋን ኡንቱንታ ይሳ።","poem":1},{"text":"ጾሳይ ያቆባ ዛራቱዋ ሞድያዋነ","poem":2},{"lineBreak":true},{"text":"ሳኣ ጋጻ ጋካናዉ ደእያ ቢታ ሞድያዋ አሳይ ኤራና ማላ፥","poem":2},{"lineBreak":true},{"text":"ኡንቱንታ ሙለ አተናዳን ይሳ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታ ሞርከቱ ኦማርሳን ስሚኖ፤","poem":1},{"text":"ካናቱዋዳን ቦጪደ፥","poem":2},{"lineBreak":true},{"text":"ካታማ ግዶን ዩዪኖ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኡንቱንቱ ምያዋ ደማናዉ ቶይላካቲኖ፤","poem":1},{"text":"ካላና ዮፐ ላዊኖ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሽን ታን ነ ዎልቃ ሳባና፤","poem":1},{"text":"ዎንታ አገና ነ ሲቁዋባ የጻና።","poem":2},{"text":"አያዉ ጎፐ፥ ኔን ታዉ ታ ዋይያ ጋላስ፥","poem":1},{"text":"ታን ባቃታ አትያ ሳነ ቆሰታ አትያሳ ግዳዳ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አቤት ታዉ ዎልቃ ግዴዳ ጾሳዉ፥","poem":1},{"text":"ታን ኔና ሳባና።","poem":2},{"text":"አያዉ ጎፐ፥ ታን ቆሰታ አትያ ሳአይነ","poem":1},{"text":"አገና ሲቁዋ ታና በስያ ጾሳይ ኔና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}