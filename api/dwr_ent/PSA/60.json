:"verse","number":6,"content":[{"text":"ጾሳይ ባረ ጌሻ ሳኣን ሀዋዳን ያጌዳ፤","poem":1},{"text":"“ታን ጾናደ ሰኬማ ቢታ ሻካና፤","poem":2},{"lineBreak":true},{"text":"ቃይ ሱኮታ ዛንጋራ ልካና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ጋላኣደ ታዋ፤ ምናሰካ ታሳ፤","poem":1},{"text":"ኤፍሬም ታ ሁጲያ ናግያ ቆብያ፤","poem":2},{"text":"ይሁዳይ ታ ካዉተ ጻምኣ።","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ሞኣበ ታን ሜጨትያ ኩይጻሩዋ፤","poem":1},{"text":"ኤዶም ታዋ ግድያዋ ኤርሳናዉ ታ ጫማ አ ቦላ ዎይ፤","poem":2},{"text":"ታን ፕልስጼማ ጾናደ ገሬራይ” ያጌዳ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ግምበቴዳ ካታማኮ፥ ታና ኦኔ አፋናዌ?","poem":1},{"text":"ኤዶማ ጋካናዉ ታና ኦኔ ካለናዌ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አቤት ጾሳዉ፥ ኑና አጌዳዌ ኔና ግድኪ?","poem":1},{"text":"አቤት ጾሳዉ፥ ኔን ኑ ቶራንቻቱዋና ኦላዉ ከሳካ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አሳ ማዱ ፓና ድራዉ፥","poem":1},{"text":"ሞርክያና ኦለታናዉ ኔን ኑና ማዳ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ጾሳ ዎልቃን ኑ ሞርከቱዋ ኑን ጾናና፤","poem":1},{"text":"ኑ ሞርከቱዋ የናዌ አ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":12}