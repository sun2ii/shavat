,"number":6,"content":[{"text":"አ ጻላላይ ታ ዛላነ ታ አቶተ፤","poem":1},{"text":"እ ታን ቆሰታ አትያ ሳኣ ግድያ ድራዉ፥","poem":2},{"lineBreak":true},{"text":"አይነ ህርግከ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታ አቶተይነ ታ ቦንቹ ጾሳና፤","poem":1},{"text":"እ ታ ምኖ ዛላነ ታ ጌሱዋ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"አሳዉ፥ ኡባ ዎደ ጾሳን አማነትተ፤","poem":1},{"text":"እ ኑዉ ጌሱዋ ግድያ ድራዉ፥","poem":2},{"lineBreak":true},{"text":"ህንተ ዎዛና ቆፋ አዉ ኦድተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"አሳይ ኡባይ እት ገደ ሸምፕያ ጫርኩዋ ማላ፤","poem":1},{"text":"ቂና ዝቂና፥ አሳይ መላ።","poem":2},{"text":"ሚዛንያን ዎናካ ኡንቱንቱ አይነ ዴጽክኖ፤","poem":1},{"text":"ኡንቱንቱ እት ገደ ሸምፕያ ጫርኩዋፐካ ካዉሺኖ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ማካላን ሺሾዋን አማነቶፕተ፤","poem":1},{"text":"ዉእ ሺሺደ ዱረታናዉ ሀልቾፕተ።","poem":2},{"text":"ህንተ ዱረተይ ዳሮፐካ፥","poem":1},{"text":"ህንተ ዎዛና አ ቦላ ዎፕተ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጾሳይ እት ገደ ኦዴዳ፥ ታን","poem":1},{"text":"ላኡ የዉዋ ስሳድ፤ “ዎልቃይ ጾሳሳ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አገና ሲቁ ጎዳዋ” ያጌዳ።","poem":1},{"text":"አቤት ጾሳዉ፥ ኔን አሳ ኡባዉ","poem":2},{"text":"አ ኦሱዋዳን ኦሱዋዳን ዛራና።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}