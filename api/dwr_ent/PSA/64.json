ኑን ሎኦ ማቁዋ ማቀቴዶ” ያጊኖ።","poem":2},{"text":"ሄዌነ፥ አሳዉ ዎዛናይነ ካሀይ ጪማ ግድያዋ በሴ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ሽን ጾሳይ ኡንቱንታ ባረ ዎንዳፍያን ዱካና፤","poem":1},{"text":"ኡንቱንቱ አኬከናን ማዱጻና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኡንቱንቱ ማቁዋ ድራዉ፥","poem":1},{"text":"እ ኡንቱንታ ይሳና፤","poem":2},{"lineBreak":true},{"text":"ኡንቱንታ በእያ ኡባይ ሁጲያ ቃና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሄ ዎደ አሳይ ኡባይ ጾሳዉ ያያና፤","poem":1},{"text":"አ ኦሱዋባ ኦዳናነ ዛር ዛሪደ ቆፓና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጽሎቱ መና ጎዳን ናሸትኖነ፥","poem":1},{"text":"አኮ ባቃቲደ አቲኖ፤","poem":2},{"lineBreak":true},{"text":"ዎዛና ሱረቱ ኡባይ ጋላትኖ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}