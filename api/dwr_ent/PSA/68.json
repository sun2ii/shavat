":2}]},{"type":"verse","number":6,"content":[{"text":"ጾሳይ ባረካ ደእያዋንቶ ጎለ አሳ እሜ።","poem":1},{"text":"ቃሾ ጎልያን ደእያዋንታ ብሊደ፥","poem":2},{"lineBreak":true},{"text":"ኡንቱንታ እሻሉዋን ዎ።","poem":2},{"lineBreak":true},{"text":"ሽን ማካላንቻቱ መሌዳ ቢታን ደኢኖ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"አቤት ጾሳዉ፥ ኔን ነ አሳ ካለዳ ዎደ፥","poem":1},{"text":"ኔን ኡንቱንቱና መላ ባዙዋ ቤዳ ዎደ፥","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሲና ደርያን ቆንጬዳ ጾሳ ስንን፥","poem":1},{"text":"እስራኤልያ ጾሳ ስንን ቢታይ ቃጼዳ፤","poem":2},{"lineBreak":true},{"text":"ሳሎቱ እራ ዱገ ትጌድኖ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አቤት ጾሳዉ፥ ኔን እራ ዳርሳደ ቡክሳዳ፤","poem":1},{"text":"መላ ቢታ ዛራደ ኦራዳ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ነ አሳይካ ያን ኡቴዳ።","poem":1},{"text":"አቤት ጾሳዉ፥ ነ ኬካተን፥","poem":2},{"lineBreak":true},{"text":"ህዬሳቶ ኮሽያባ ጊግሳደ እማዳ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጎዳይ ኪታ ኪቴዳ፤","poem":1},{"text":"ሄ ኪታ አፌዳ ማጫ አሳቱ ዳራ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኡንቱንቱ፥ “ሞርከ ካተቱነ","poem":1},{"text":"ኡንቱንቱ ቶራንቻቱ ጉየ ባቃቴድኖ፤","poem":2},{"lineBreak":true},{"text":"ሶን አቴዳ ማጫ አሳቱ ኦሞዱዋ ሻከቴድኖ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኡንቱንቱ፥ ጶልያ ዎርቃ ቀፍያና ደእያ፥","poem":1},{"text":"ብራፐ መቴዳ ሀራጵያ ምስልያ፥","poem":2},{"lineBreak":true},{"text":"ኦሞዱዋ ደሞደ፥ ህንተንቱ፥","poem":2},{"lineBreak":true},{"text":"ዶርሳ ስኩዋ ግዶን አያዉ ግሴድቴ?” ያጌድኖ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኡባ ዳንዳይያ ጾሳይ፥","poem":1},{"text":"ካተቱዋ ላሌዳ ዎደ፥","poem":2},{"text":"ጻልሞና አሳ ቦላ ሻቻ ቡክሴዳ።","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ባሳነ ደረቱ ዎጋ ዎልቃማ ደረቱዋ፤","poem":1},{"text":"ባሳነ ደረቱ ዳሮ ጼራቱ ደእያዋንታ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዳሮ ጼራቱ ደእያ ደረቶ፥","poem":1},{"text":"ጾሳይ ባረሳ ኦናዉ ዶሬዳ አሳ፥","poem":2},{"lineBreak":true},{"text":"ህንተ አያዉ ቃናቲደ ጼሊቴ?","poem":2},{"lineBreak":true},{"text":"መና ጎዳይ አን መናዉ ደአናዋ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ጾሳ ኦላ ፓራ ጋረቱ","poem":1},{"text":"ታሙ ሻኣንነ ሻኡ ገደ ሻአን ፓይደትያዋንታ፤","poem":2},{"lineBreak":true},{"text":"ጎዳይ ሲና ደርያፐ ባረ ጌሻ ሳኣ ዬዳ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ኦሞደቴዳ ዳሮቱዋ አኪደ፥","poem":1},{"text":"እ ፑደ ቃ ከሴዳ።","poem":2},{"text":"አሳፐ፥ ሀራይ አቶ ማካላንቻ አሳፐካ እሙዋ አኬዳ።","poem":1},{"text":"መታ ኡባ ጎዳይ ያን ደአና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ጋላሳን ጋላሳን ኑ ቶኩዋ ቶክያ ጎዳይ፥","poem":1},{"text":"ኑና አሽያ ጾሳይ ጋላተቶ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ኤ፥ ኑ ጾሳይ ኑና አሽያ ጾሳቴ!","poem":1},{"text":"ሀይቁዋፐ አትያዌ፥","poem":2},{"text":"ኡባ ሞድያ መና ጎዳይ አሽናዳ።","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ጾሳይ ቱሙዋፐ ባረ ሞርከቱዋ፥","poem":1},{"text":"ጉግያ ክንቻና፤","poem":2},{"lineBreak":true},{"text":"ናጋራ ኦግያን ሀመትያ፥","poem":2},{"lineBreak":true},{"text":"ጎፋራንቻቱዋ ሁጲያ ጳልቃና።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ጎዳይ ያጌዳ፤ “ታን ህንተ ሞርከቱዋ፥","poem":1},{"text":"ባሳነፐ ዛራደ አሀና፤","poem":2},{"lineBreak":true},{"text":"ታን ኡንቱንታ ጪሞ አባ ግዶፐ ከሳደ ጉየ አሀና።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ሄዌነ፥ ኔን ነ ሞርከቱዋ፥","poem":1},{"text":"ሱ ግዱዋና ጮልባያ የደ ሀመታናሳነ፤","poem":2},{"lineBreak":true},{"text":"ነ ካናቱካ ሞርክያ ሱፐ፥","poem":2},{"lineBreak":true},{"text":"ባረንቱ ግሹዋ እንጻርሳን ላጫናሳ” ያጌዳ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"አቤት ጾሳዉ፥ ነ ሳልፒ፥","poem":1},{"text":"ታ ጾሳ ታ ካትያ ሳልፒ፥","poem":2},{"lineBreak":true},{"text":"ጌሻ ጎልያ ገልያ ዎደ ኡባዉ ቤቴ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"የጽያዋንቱ ስንና፤ ዲጽያዋንቱ ጉየና፤","poem":1},{"text":"ቃይ ካራቡዋ ባቂያ ዎዶሮቱ ግዱዋና።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ኡንቱንቱ፥ “ጾሳ ኩንዳ ሺቁዋን ጋላትተ፤","poem":1},{"text":"ህንተኖ፥ እስራኤልያ ዘረቶ፥","poem":2},{"text":"መና ጎዳ ጋላትተ” ያጊኖ።","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ሄ ሳልፕያን ኡባፐ ቴፋትያ፥","poem":1},{"text":"ቢንያማ ዛራቱ ኮይሮ ቤቲኖ።","poem":2},{"text":"ካሊደ ይሁዳ ካፓቱ ባረንቱ ጭታና ደኢኖ፤","poem":1},{"text":"ዉርሰን ዛብሎና ካፓቱነ ንፍታሌማ ካፓቱ ቤቲኖ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"አቤት ጾሳዉ፥ ነ ዎልቃ ቆንጭሳ።","poem":1},{"text":"አቤት ኑዉ ኦዳ ጾሳዉ፥","poem":2},{"lineBreak":true},{"text":"ነ ምኖተ በሳ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ሄዋ ድራዉ፥ የሩሳላመን ደእያ","poem":1},{"text":"ነ ጌሻ ጎልያ ካተቱ ዪደ፥","poem":2},{"lineBreak":true},{"text":"ነዉ እሞታ እማና።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ዶኣዳን ማቃ ግዶን ደእያ ግብጼ አሳቱዋ ኔን ሴራ።","poem":1},{"text":"ቦራቱዋነ ማራቱዋ ዉድያ፥","poem":2},{"lineBreak":true},{"text":"ማላትያ ካዉተቱዋ ኔን የደርሳ።","poem":2},{"lineBreak":true},{"text":"ኡንቱንቱ ጉልባቲደ፥ ባረንቱ ብራ ነዉ እማና ጋካናዉ፥","poem":2},{"lineBreak":true},{"text":"ኔን ኡንቱንታ ሴራ።","poem":2},{"lineBreak":true},{"text":"ኦለታናዉ ዬሞትያ አሳቱዋ ላላ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ኪተቴዳ ካፓቱ ግብጼፐ ያና፤","poem":1},{"text":"ቶጳታ ባረ ኩሽያ ኤለ ጾሳኮ ምጫና።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ህንተኖ፥ ሳኣ ካዉተቶ፥","poem":1},{"text":"ጾሳዉ የጽተ፤","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ሳሎቱዋን፥ በንፐ ደእያ ሳሎቱዋን ብያ ጎዳ ሳቢተ።","poem":1},{"text":"ስስተ! እ ባረ ኮሻ፥","poem":2},{"lineBreak":true},{"text":"ባረ ዎልቃማ ጉን ኪቴ።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ጾሳ ዎልቃባ አዋይተ፤","poem":1},{"text":"አ አንጋይ እስራኤልያ ቦላና፤","poem":2},{"text":"አ ዎልቃይካ ሳሉዋና።","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"ጾሳይ ባረ ጌሻ ጎልያፐ ቆንጮደ፥ ማላልሴ።","poem":1},{"text":"እስራኤልያ ጾሳይ ባረ አሳዉ ምኖተነ ዎልቃ እሜ።","poem":2},{"text":"መና ጎዳይ ጋላተቶ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":35}