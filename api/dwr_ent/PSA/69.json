":"verse","number":18,"content":[{"text":"ኔን ታኮ ሺቃ፤ ታና ዎዛ፤","poem":1},{"text":"ታ ሞርከቱዋፐ ታና ላአ ከሳ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ታን ቦርያ፥ ዬላነ፥","poem":1},{"text":"ካዉሻ አኬዳዋ ኔን ኤራሳ።","poem":2},{"text":"አያዉ ጎፐ፥ ታ ሞርከቱዋ ኡባ ኔን በኣሳ።","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ቦሪ ታ ዎዛና ፓጸናዳን መን ድራዉ፤","poem":1},{"text":"ህዶታ ቃንጻድ።","poem":2},{"text":"ታዉ ቃረትያዋ ኮያድ።","poem":1},{"text":"ሽን እቱነ ባዋ፤","poem":2},{"lineBreak":true},{"text":"ታና ምንያ አሳ ጼላድ፤ ሽን ደማበይከ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ታን ኮሻቴዳ ዎደ፥","poem":1},{"text":"ታዉ ጫምያ ቁማ አድኖ።","poem":2},{"text":"ታን ሳመቴዳ ዎደ፥","poem":1},{"text":"ታዉ ጫላ ዎይንያ ኤሳ እሜድኖ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ኡንቱንቱ ምያ ሳምፓይ ኡንቱንቶ ጲረ ግዶ።","poem":1},{"text":"ኡንቱንቱ ያርሹዋ ያርሺደ፥","poem":2},{"lineBreak":true},{"text":"ምያ ግብራይ ኡንቱንቶ ግትያ ግዶ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ጼለናዳን ኡንቱንቱ አይፊ ጎዘቶ፤","poem":1},{"text":"ኡንቱንቱ ጋዱዋ ኡባ ገደ ኮኮርሳ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ነ ሀንቁዋ ኡንቱንቱ ቦላ ትጋ፤","poem":1},{"text":"ነ ሱሎ ሀንቁ ኡንቱንታ የደርሲደ ኦይቆ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ኡንቱንቱ ካምቡ መላ ደኦ፤","poem":1},{"text":"ኡንቱንቱ ዱንካንያን ኦንነ ደኦፖ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"አያዉ ጎፐ፥ ኡንቱንቱ፥","poem":1},{"text":"ኔን ሙሬዳዋንታ የደርሲኖ፤","poem":2},{"lineBreak":true},{"text":"ቃይ ኔን ደቼዳዋንቱ ቱጋባ","poem":2},{"lineBreak":true},{"text":"ደንደ ሃሳዪኖ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ኔን ኡንቱንቱ ናጋራ ቦላ","poem":1},{"text":"ናጋራ ጉጃናዳን አጋ፤","poem":2},{"lineBreak":true},{"text":"ነ ማሮተፐ ኡንቱንታ አያይነ ጋኮፖ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ኡንቱንቱ ደኡዋ ማጻፋፐ ቁጨትኖ፤","poem":1},{"text":"ጽሎ አሳና ማዝጋበቶፕኖ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ታን ሳከታደነ ቱጋታደ ደአይ።","poem":1},{"text":"አቤት ጾሳዉ፥ ታና አሻደ፥","poem":2},{"lineBreak":true},{"text":"ሳሮ ሳኣን ዎ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ታን