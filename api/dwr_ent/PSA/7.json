{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":7,"content":[{"type":"heading","content":["የደሳ ዎድያን ጽሎ አሳ ዎሳ"]},{"type":"hebrew_subtitle","content":["ቢንያማ ዛርያ ኩዛዋ ዳዊተ፥ ጾሳኮ ዝላሌዳ ዝላሳ።"]},{"type":"verse","number":1,"content":["አቤት መና ጎዳዉ፥ ታ ጾሳዉ፥ ታን ኔኮ ባቃታደ ቆሰታይ።",{"text":"ታና የደርስያ ኡባቱዋፐ ኔን ታና አሻ አካ።","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ኔን ታና አሸናባ ግዶፐ፥","poem":1},{"text":"ኡንቱንቱ ታና ጋሙዋዳን ቦንቂደ፥","poem":2},{"lineBreak":true},{"text":"ኦንነ አሸናን መንሬና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"አቤት መና ጎዳዉ ታ ጾሳዉ፥","poem":1},{"text":"ታን አሳ ናቄዳዋ ግዶፐ፥","poem":2},{"text":"ሄዌነ ታ ላግያዉ ሎኡዋ ድራዉ ኢታ ዛሬዳዋ ግዶፐነ፥","poem":1},{"text":"ዎይ ጋሱ ባይናን ታ ሞርክያ ቦንቄዳዋ ግዶፐ፥","poem":2},{"text":"ሀዋ ማላ የዎቱዋፐ እቱዋነ ታን ኦዳዋ ግዶፐ፥","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ታ ሞርኪ ታና የደርሲደ ኦይቆ።","poem":1},{"text":"ታና ሳኣን የሬ፤","poem":2},{"lineBreak":true},{"text":"ያቲደ፥ ታና ቢታን ኦል ባሾ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"አቤት መና ጎዳዉ፥ ነ ሀንቁዋን ደንዳ ኤቃ፤","poem":1},{"text":"ታ ሞርከቱዋ ኤጽያ ሀንቁዋ ቦላ ደንዳ።","poem":2},{"text":"ታ ጾሳዉ ጎዳዉ፥ ቤጎታ፤ ቱሙዋ ፕርዳ።","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ካዉተቱዋ ሺቁ ነ ዩሹዋን ሺቆ፤","poem":1},{"text":"ኔን ኡንቱንቱፐ ቦላና ግዳደ ሃና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"መና ጎዳይ ካዉተቱዋ ቦላ ፕርዴ።","poem":1},{"text":"አቤት መና ጎዳዉ፥ ታዉ ታ ጽሎተዳን ፕርዳ፤","poem":2},{"text":"አቤት ኡባፐ ቃዉ፥ ታ ሱረተዳን ፕርዳ።","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ቆፋነ ዎዛና ብዳደ ኤርያ ጽሎ ጾሳዉ፥","poem":1},{"text":"ኢታቱዋ ገንያ ኔን ይሳ።","poem":2},{"text":"ሽን ጽሉዋ ሳሮታን ምንሳ ዎ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ዎዛና ጽሉዋ አሽያ ጾሳይ","poem":1},{"text":"ታዉ ጎንዳለ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጾሳይ ጽሉዋ ፕርድያዋ፤","poem":1},{"text":"እ ሀች ሀች ሀንቀትያ ጾሳ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አሳይ ባረ ናጋራ ፓጺደ ስመናን እጾፐ፥","poem":1},{"text":"ጾሳይ ባረ ማሻ ሌፌ፤","poem":2},{"text":"እ ባረ ዎንዳፍያ ጊግሴ።","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"እ ባረ ዎያ ኦላ ሚሻቱዋ ጊግሴ፤","poem":1},{"text":"ታማ ላጩዋዳን ጶልያ ባረ ዎንዳፍያ ቶራ ጊግሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ኢታተ ሻሃሬዳ፥","poem":1},{"text":"ገንያ ሻሃራ ሻሃሬዳዌ፥ ዎርዱዋ የሌ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሀራ አሳቶ ኦላ ቦኬዳ አሳይ","poem":1},{"text":"ባረ ቦኬዳ ኦላን ባረዉ ኩንዴ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እ አህያ ገኒ አ ሁጲያዉ ስሜ።","poem":1},{"text":"አ ማካላይነ አ ሁጲያዉ ስሜ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"መና ጎዳ ጽሎተ ድራዉ፥","poem":1},{"text":"ታን አ ጋላታና፤","poem":2},{"text":"ቃይ ኡባፐ ቂያ መና ጎዳ ሱንዉ፥","poem":1},{"text":"ታን ጋላታ የጻና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}