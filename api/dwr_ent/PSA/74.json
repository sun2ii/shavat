"poem":2},{"text":"መቶታንቻቱዋ መናዉ ዶጎፓ።","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ኑ ቢታን ደእያ ማ ሳአይ ኡባይ፥","poem":1},{"text":"ማካላንቻቱዋን ኩሜዳ ድራዉ፥","poem":2},{"lineBreak":true},{"text":"ኔን ኑዉ ጫቄዳ ጫቁዋ ቆፓ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ናቀቴዳዋንታ ዬላዮፓ፤","poem":1},{"text":"ህዬሳቱነ መቶታንቻቱ ነ ሱን ጋላትኖ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"አቤት ጾሳዉ፥ ደንዳ፤ ነ የዉዋ ሞተታ።","poem":1},{"text":"ገዞ አሳቱ ጋላሳ ኡባን፥","poem":2},{"lineBreak":true},{"text":"ነ ቦላ ቅሊጬዳዋ ሀሳያ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ነ ሞርከቱ ነ ቦላ ዋስያ ዋሱዋነ","poem":1},{"text":"ኔና እጽያዋንቱ፥","poem":2},{"lineBreak":true},{"text":"ፓጭ ባይናን ቅሊጭያ ቅሊጩዋ ዶጎፓ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":23}