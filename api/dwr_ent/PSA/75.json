mber":7,"content":[{"text":"ሽን ፕርድያዌ ጾሳ፤","poem":1},{"text":"እ እቱዋ ቦላ ፕርዴ፤","poem":2},{"lineBreak":true},{"text":"እቱዋ ሻትን።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"መና ጎዳ ኩሽያን እት ዋንጫይ ደኤ፤","poem":1},{"text":"ሄ ዋንጫይ ጾሳ ሀንቁዋ ዎይንያ ኤሳን ኩም ኡቴዳ።","poem":2},{"text":"እ ሄዋፐ ኡሻ ትግና፥","poem":1},{"text":"ሳኣን ደእያ ኢታ አሳቱ ሄዋ ኡሻና፤","poem":2},{"lineBreak":true},{"text":"ኡንቱንቱ ኦርጩዋካ አሸናን ጭንግሲደ ኡሻና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ሽን ታን ያቆባ ጾሳባ ኦዳናነ","poem":1},{"text":"መናዉ አ ሳባና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እ ኢታ አሳቱዋ ካጭያ ኡባ መንና፥","poem":1},{"text":"ሽን ጽሎቱዋ ካጪ ቁ ቁ ጋና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}