{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":76,"content":[{"type":"heading","content":["ጾሳ ጾኑዋ"]},{"type":"hebrew_subtitle","content":["ዛማረቱዋ ካፖ ዲ ዋን የጸቴዳ፥ አሳፋ ማዛሙርያ"]},{"type":"verse","number":1,"content":[{"text":"ጾሳይ ይሁዳን ኤረቴዳዋ፤","poem":1},{"text":"አ ሱንይ እስራኤልያን ዎልቃማ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አ ዱንካኒ ሳሌማና፤","poem":1},{"text":"እ ደኢያሳይ ጽዮነና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እ፥ ሄዋን ጾንገትያ፥","poem":1},{"text":"ሞርከቱዋ ዎንዳፍያ ጩብያ፥ ጎንዳልያ፥ ማሻነ","poem":2},{"lineBreak":true},{"text":"ሀራ ኦላ ሚሻቱዋ መንሬዳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"አቤት ጾሳዉ፥ ነ ቦንቹ አይ ኬሻ ግቴ!","poem":1},{"text":"ኔን ነ ሞርከቱዋ ጾናደ፥","poem":2},{"lineBreak":true},{"text":"ደርያፐ ስምያ ዎደ፥","poem":2},{"lineBreak":true},{"text":"ነ አንጋይ አይባ ያሽያዌ!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ጎባ ቶራንቻቱ፥","poem":1},{"text":"ባረንቶ ደእያዋ ኡባ ቦንቀት ክቼድኖ።","poem":2},{"text":"ሀእ ስም ኡንቱንቱ፥","poem":1},{"text":"ዎልቃማ ገምእሹዋ ገምእሼድኖ፤","poem":2},{"lineBreak":true},{"text":"ኡንቱንቱፐ እቱነ ባረ ኩሽያ ደንቤና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አቤት ያቆባ ጾሳዉ፥ ኔን ሴሬዳ ዎደ፥","poem":1},{"text":"ፓራ አሳቱነ ፓራቱ ኩንዶ ሳን አቴድኖ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ሽን አቤት ጾሳዉ፥ ኔን ያሻሳ!","poem":1},{"text":"ነ ሀንቁ ሱሌዳ ዎደ፥","poem":2},{"lineBreak":true},{"text":"ነ ስንን ኦኔ ኤቃናዌ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኔን ፕርዳ ሳሉዋፐ ስሴዳ ዎደ፥","poem":1},{"text":"ሳኣን ደእያ አሳይ ያዪደ፥ ጮኡ ጌዳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኔን ሳኣን ቆሄቴዳዋንታ አሻናዉ፥","poem":1},{"text":"ፕርዳዉ ደንዴዳ ዎደ፥ ሄዌ ሀኔዳ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አሳ ሀንቁ ዳሬዳ ኬሻ ኔን ጋላተታሳ።","poem":1},{"text":"ኦላፐ አቴዳ አሳቱ ኡባይ፥","poem":2},{"lineBreak":true},{"text":"ነ ባላ ጋላሳቱዋ ቦንቻና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"መና ጎዳዉ፥ ህንተ ጾሳዉ፥","poem":1},{"text":"ሺቀትተ፥ ሄዋካ ጋተ።","poem":2},{"text":"ህንተኖ ሾሮ ካዉተቶ፥","poem":1},{"text":"ያየታናዉ በስያዎ እሞታ አህተ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እ ካፖቱዋ ኦቶሩዋ ካዉሼ፤","poem":1},{"text":"ዎልቃማ ካተቱዋካ እ ያሽሴ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}