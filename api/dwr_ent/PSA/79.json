eak":true},{"text":"ኔና ኤረና አሳቱዋ ቦላነ","poem":1},{"text":"ነ ሱን ጼሰና ካዉተቱዋ ቦላ ነ ሀንቁዋ ጉሳ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አያዉ ጎፐ፥ ኡንቱንቱ ያቆባ ዘረቱዋ ዎድኖነ","poem":1},{"text":"ኡንቱንቱ ደኢያሳ ባይዜድኖ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ካሰ ኑ አዎቱዋ ኢታተ ኑ ቦላ ፓይዶፓ።","poem":1},{"text":"ኤለካ ነ ማሮታ ኑዉ ኪታ፤","poem":2},{"lineBreak":true},{"text":"አያዉ ጎፐ፥ ኑን ሎይ መቶቴዶ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አቤት ኑና አሽያ ጾሳዉ፥","poem":1},{"text":"ነ ሱን ቦንቹዋ ድራዉ፥ ኑና ማዳ።","poem":2},{"text":"ነ ሱን ድራዉ፥ ኑና አሻ፤","poem":1},{"text":"ኑ ናጋራ አቶ ያጋ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አሳቱ አያዉ፥ “ኡንቱንቱ ጾሳይ ሀቃን ደኢ?” ያጋኔ?","poem":1},{"text":"ነ ቆማቱዋ ሱ ኡንቱንቱ ጉሴዳዋ ሀሉዋ፥","poem":2},{"lineBreak":true},{"text":"ኔን ከስያዋ ኑን ጼልሽን፥","poem":2},{"lineBreak":true},{"text":"ኡንቱንቱ ግዱዋን ቆንጭሳ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ቃሸቴዳ አሳቱዋ ኦሊ ነ ስን ጋኮ።","poem":1},{"text":"ሀይቆ ፕርደቴዳዋንታ ነ ዎልቃ ግታተዳን አሻ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አቤት ጾሳዉ፥ ኑ ሾሮ ካዉተቱ ኔና ቦሬዳዋ፥","poem":1},{"text":"ሀሉዋ ላፑን ኩሽያ ኡንቱንቱ ክዉዋን እድን።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሄ ዎደ ኑን ነ አሳቱ፥ ነ ዉድያ ዶርሳቱ፥","poem":1},{"text":"መናዉ ጋላታ ነዉ እማና፤","poem":2},{"lineBreak":true},{"text":"የለታፐ የለታ ጋካናዉ ኔና ዛር ዛሪደ ጋላታና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}