},{"text":"ቦንቹዋነ ግታተ ካላቻ አ ሁጲያን ዎዳ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አ ኔን ነ መዳ መተ ኡባ ቦላን","poem":1},{"text":"ሞድያዋ ኦደ ሱንዳ፤","poem":2},{"lineBreak":true},{"text":"ኡባባ አ ገድያፐ ጋርሳና ዎዳ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዶርሳቱዋነ ቦራቱዋ፥ ሳኣ ዶአቱዋነ፥","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ሳሉዋ ካፎቱዋ፥ አባ ሞለቱዋነ፥","poem":1},{"text":"አባይ ጎግያሳን ዋያዋንታ ኡባካ","poem":2},{"text":"አ ሞድሳዳ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"አቤት ጾሳዉ፥ ኑ ጾሳዉ፥ ነ ሱንይ","poem":1},{"text":"ሳኣ ኡባን አያ ቦንቼቴዴሻ!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}