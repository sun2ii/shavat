},{"text":"ባረንቱ ግዶን ዋላቀታናዳን ኦዳ፤","poem":2},{"lineBreak":true},{"text":"ኑ ሞርከቱ ኑ ቦላ ሚጬድኖ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"አቤት ኡባፐ ዎልቃማ ጾሳዉ፥ ኑና ዛራ፤","poem":1},{"text":"ኑን አታናዳን፥ ነ ሶምኡዋ ኑዉ ፖእሳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ኔን ግብጼፐ ዎይንያ አኑዋ አሃዳ፤","poem":1},{"text":"አይሁዳ ግደና አሳቱዋ የደርሳዳ፥ ኡንቱንቱ ቢታን አ ቶካዳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኔን ዎራ ቡዳ፤","poem":1},{"text":"ያትና፥ ጻጱዋ የድ ዳሺደ፥","poem":2},{"lineBreak":true},{"text":"ቢታ ኡባ ጋኬዳ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ደረቱ አ ኩዋን፥","poem":1},{"text":"ልባኖሳ ዝጋቱ አ ታሸቱዋን ካመቴድኖ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ባረ ታሸቱዋ ሜድተራነ አባ ጋካናዉ፥","poem":1},{"text":"ቃይ ባረ ጼራቱዋ ኤፍራጺሳ ሻፋ ጋካናዉ የዴዳ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ያትና፥ ኦግያና አያ ኡባይ፥","poem":1},{"lineBreak":true},{"text":"አ አይፍያ ዱናዳን፥","poem":1},{"text":"አ ዩሹዋን ደእያ ግምቢያ አያዉ ኮላዲ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ባዙዋ ጉዱንይ አ ቦላ ዱሪደ ባይዜ፤","poem":1},{"text":"ቃይ ጋደን ዎጽ ቃጽያ መታቱ ኡባይ አ ሚኖ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አቤት መታ ኡባ ጾሳዉ፥","poem":1},{"text":"ኔን ኑኮ ስማ።","poem":2},{"text":"ሳሉዋና ዱገ ጼላደ በአ፤","poem":1},{"text":"ሀ ዎይንያ ናጋ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እ ነ ኡሸቻ ኩሺ ቶኬዳ ጻጱዋ፤","poem":1},{"text":"ኔን ነዉ ጋደ ድቼዳ ፑትያ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ነ ሞርከቱ ነ ዎይንያ ቡድኖ፤","poem":1},{"text":"ታማን ጹጌድኖ።","poem":2},{"text":"ሄዋ ድራዉ፥ ኔን ኡንቱንታ ነ ሀንቁዋ ሱሉዋን ይሳ።","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ነ ኩሺ፥ ነ ኡሸቻን ደእያ አሳ፥","poem":1},{"text":"ኔን ነዉ ጋደ ድቼዳ አሳ ናጎ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ያቶፐ፥ ኑን ኔፐ ጉየ ስሞኮ።","poem":1},{"lineBreak":true},{"text":"ኑና ፓጻ ዎ፤ ነ ሱን ኑን ጋላታና።","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"አቤት ኡባፐ ዎልቃማ መና ጎዳ ጾሳዉ፥","poem":1},{"text":"ኑና ዛራ፤ ኑን አታናዳን፥","poem":2},{"lineBreak":true},{"text":"ነ ሶምኡዋ ኑዉ ፖእሳ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}