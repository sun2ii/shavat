{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":81,"content":[{"type":"heading","content":["ባላ ማዝሙርያ"]},{"type":"hebrew_subtitle","content":["ዛማረቱዋ ካፖ ሱሱላቱዋን የጸቴዳ፥ አሳፍ ጻፌዳዋ"]},{"type":"verse","number":1,"content":[{"text":"ኑዉ ዎልቃ ግድያ ጾሳዉ፥","poem":1},{"text":"ህንተ ቃላ ቁ ኦደ የጽተ፤","poem":2},{"text":"ያቆባ ጾሳ ሳቢተ።","poem":3}]},{"type":"verse","number":2,"content":[{"text":"የ ዶምተ፤ ካራቡዋ ባቂተ፤","poem":1},{"text":"ዲንነ ማስንቁዋን ሎአ የ ስስተ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አግናይ ጼርያ ዎደነ፥","poem":1},{"text":"አግናይ ዶይስያ ዎደ","poem":2},{"lineBreak":true},{"text":"ባላ ጋላሳን ማላካታ ፑንተ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሀዌ እስራኤልያዉ ህግያ፤","poem":1},{"text":"ያቆባ ጾሳፐ እመቴዳ ዎጋ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ግብጼ ቢታ እ ሾጬዳ ዎደ፥","poem":1},{"text":"ዮሴፎ አሳዉ ሀ ዎጋ አዋዬዳ።","poem":2},{"text":"ታን ኤረና ኮሻ ሀዋዳን ያግያዋ ስሳድ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“ህንተ ሀሽያፐ ቶኩዋ ዎድ፤","poem":1},{"text":"ህንተ ኩሽያ ጹብያፐ ሸምፕሳድ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ህንተ መቱዋ ዎደ ታና ጼሴድታ፤","poem":1},{"text":"ህንተና አሻድ፤","poem":2},{"lineBreak":true},{"text":"ታን ጉምያ ሻርያ ግዶን ጌሜዳሳፐ ህንተና አላድ።","poem":2},{"lineBreak":true},{"text":"ማሪባ ግያ ፑልቱዋ ማታን ታን ህንተና ፓጫድ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታ አሳዉ፥ ታን ህንተና ሴርያዋ ስስተ፤","poem":1},{"text":"ሀእ እስራኤላቶ፥ ሀይዜርክተ!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ህንተ ግዶን አላጋ ጾስ ደኦፖ፤","poem":1},{"text":"ሀራ ጾሳዉ ጎይኖፕተ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታን፥ መና ጎዳ ህንተ ጾሳ፥","poem":1},{"text":"ህንተና ግብጼ ቢታፐ ከሳደ አሄዳዋ።","poem":2},{"text":"ነ ዶና ሎይ ሀንጋ፤","poem":1},{"text":"ታን ኔና ዳርሳደ ባርሳና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ሽን ታ አሳቱ ታ ቃላ ስስበይክኖ፤","poem":1},{"text":"እስራኤላቱ ታዉ አዛዘትበይክኖ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሄዋ ድራዉ፥ ታን ኡንቱንቱ ባረንቱ ቆፋ ካላና ማላ፥","poem":1},{"text":"ኤኖ ጌና ዎዛናዉ አደ እማድ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታ አሳይ ታና ስሴደንቶ፥","poem":1},{"text":"እስራኤላቱ ታ ኦግያ ካሌደንቶ አዬ ደኢ!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታን ኡንቱንቱ ሞርክያ ኤለ ጾናና ሽን፤","poem":1},{"text":"ኡንቱንቱ ባልጋራቱዋ ቦላ ታ ኩሽያ ዎና ሽን።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"መና ጎዳ እጽያዋንቱ አ ስንን ሆካና፥","poem":1},{"text":"ኡንቱንቱ ሙሩካ መናሳ ግዳናዋ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታን ህንተና ሎኦ ዛርጋ ምዛና፤","poem":1},{"text":"ቃይ ኤሳ፥ ሹቻ ጎንጎሉዋፐ ካልሳና” ያጌ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}