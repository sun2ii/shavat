":1},{"text":"ቃይ ሀራ ካፓቱ ኩንዴዳዋዳን፥","poem":2},{"lineBreak":true},{"text":"ህንተካ ኩንዳና’ ያጋይ” ያጌ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"አቤት ጾሳዉ፥ ደንዳ፤ ሳኣ ፕርዳ፤","poem":1},{"text":"ካዉተይ ኡባይ ነዋ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}