{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":84,"content":[{"type":"heading","content":["ጾሳ ጎልያ ላሞቱሳ"]},{"type":"hebrew_subtitle","content":["ዛማረቱዋ ካፖ ሱሱላቱዋን የጸቴዳ፥ ቆረ ናናቱ ጻፌዳ ማዝሙርያ"]},{"type":"verse","number":1,"content":[{"text":"አቤት ኡባፐ ዎልቃማ መና ጎዳዉ፥","poem":1},{"text":"ኔን ደኢያሳይ አያ ሎኢ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታን መና ጎዳ ጌሻ ጎልያ ዳባባ ላሞታይ፤","poem":1},{"text":"ታ ኩመን አሳተይ ደኡዋ ጾሳዉ ናሸቻን የጼ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አቤት ኡባፐ ዎልቃማ መና ጎዳዉ፥","poem":1},{"text":"ታ ካትያዉ፥ ታ ጾሳዉ፥","poem":2},{"lineBreak":true},{"text":"ነዉ ያርሽያ ሳኣ ማታን፥","poem":2},{"lineBreak":true},{"text":"ሱንያ ካፋታ ባረዉ ደኢያሳ ደማዱ።","poem":2},{"text":"ሀራጳታካ ባረዉ ቁቁልያ ጎልያ ያን ኬጻዱ።","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ነ ጌሻ ጎልያን ደእያዋንቱነ","poem":1},{"text":"መናዉ ኔና ሳቢያዋንቱ አንጀቴዳዋንታ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ዎልቃ ኔፐ ደምያዋንቱ፥","poem":1},{"text":"ባረንቱ ዎዛናን ጽዮነ አፍያ ኦግያ ባናዉ","poem":2},{"lineBreak":true},{"text":"አሞትያዋንቱ አንጀቴዳዋንታ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዬኩዋ ዛንጋራና ኡንቱንቱ አያ ዎደ፥","poem":1},{"text":"ሄ ሳአይ ፑልቱዋ ከሴ።","poem":2},{"text":"ባሳ እራይካ ቡኪደ፥","poem":1},{"text":"ያን ደልእያ ግስሴ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኡንቱንቱ ብያ ዎደ፥ ዎልቃ ጉጅ ጉጂደ ባና።","poem":1},{"text":"ኡንቱንቱ ጾሳ ስንን ጽዮነን ቤታና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"አቤት ኡባፐ ዎልቃማ መና ጎዳዉ ጾሳዉ፥","poem":1},{"text":"ታ ዎሳ ኔን ስሳ።","poem":2},{"text":"አቤት ያቆባ ጾሳዉ፥ ሀይዛ።","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"አቤት ጾሳዉ፥ ኑ ጎንዳልያ በአ፤","poem":1},{"text":"ኔን ዶሬዳ ካትያ ነ ኬካ አይፍያን ጼላ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታን ሀራ ሳኣን ሻኡ ጋላሳ ደአናፐ","poem":1},{"text":"ጾሳ ጎልያን እት ጋላሳ ደእያዌ ሎአ።","poem":2},{"text":"ኢታቱዋ ዱንካንያን ደአናዋፐ","poem":1},{"text":"ታ ጾሳ ጎልያ ፐንግያ ናግያዌ ታዉ ሎአ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"መና ጎዳይ ጾሳይ ኑዉ ጎንዳለነ ፖኡዋ፤","poem":1},{"text":"መና ጎዳይ ኑዉ ቦንቹዋነ ኬካተ እሜ።","poem":2},{"text":"ሱረተን ሀመትያዋንታ እ ሎኦባ ኡባ ድገና።","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"አቤት ኡባፐ ዎልቃማ መና ጎዳዉ፥","poem":1},{"text":"ኔናን አማነትያዋንቱ አንጀቴዳዋንታ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}