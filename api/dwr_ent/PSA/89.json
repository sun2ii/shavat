"poem":2},{"text":"“አሳ ግዶፐ ዶሬዳዎ ካዉተ አራታ እማዳ።","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ታ ቆማ ዳዊታ ካተ ከሳድ፤","poem":1},{"text":"ታ ጌሻ ዛይትያን ኦካደ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ታ ኩሺ አናና ደአና፤","poem":1},{"text":"ታ ቀሲካ አ ምንና።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"አ አይ ሞርኪነ ጾነና፤","poem":1},{"text":"አይ ኢታ አሳይነ አ ቶቼና።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ታን አ ሞርከቱዋ አ ስንን ክንቼሬና፤","poem":1},{"text":"አ እጽያዋንታ ሾጫ የጋና።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ታ ቱማተይነ ታ አገና ሲቁ","poem":1},{"text":"አናና እትፐ ግዳና።","poem":2},{"text":"ታ ሱንን አ ካጪ ቁ ቁ ጋና።","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"ታን አ ካዉተ መደትራንያ አባ ጋካናዉ አሳና፤","poem":1},{"text":"አ ዛዋካ፥","poem":2},{"text":"ኤፍራጼሰነ ጸግሮሰ ሻፋ ጋካናዉ አሳና።","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ዳዊተ ታና፥ ‘ኔን ታ አዉዋ፥","poem":1},{"text":"ታ ጾሳነ ታና አሽያ ዛላ’ ያጊደ ጼሳና።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ታን አ ባይራ ናኣ ኦና፤","poem":1},{"text":"ሳኣን ደእያ ካተቱዋ ኡባፐ አ ዳርሳና።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ታን አገና ታ ሲቁዋ","poem":1},{"text":"አዉ መናዉ ናጋና።","poem":2},{"text":"ታን አናና ቃላ ጫቁዋ ምንና።","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"ታን አ ዘረ መናዉ ምንሳደ ኤሳና፤","poem":1},{"text":"አ ካዉተ አራታካ ሳሉዋዳን ጋምኤና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“ሽን አ ዘረቱ ታ ህግያ አጎፐ፥","poem":1},{"text":"ቃይ ኡንቱንቱ ታ ዎጋዳን ሀመተናን እጾፐ፥","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ኡንቱንቱ ታ አዋዩዋ ሻሮፐ፥","poem":1},{"text":"ታ አዛዙዋ ናጋና ዮፐ፥","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ታን ኡንቱንቱ ናጋራ ድራዉ ጋትማን፥","poem":1},{"text":"ኡንቱንቱ ኢታተ ድራዉ፥ ልሱዋን፥","poem":2},{"lineBreak":true},{"text":"ሾጫደ ሙራና።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ሽን ታን አገና ታ ሲቁዋ አፐ አክከ፤","poem":1},{"text":"ዎይ ታን አዉ አማነትያዋ አግከ።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ታን ኡንቱንቱና ጫቀቴዳ ጫቁዋ ኮልከ፤","poem":1},{"text":"ታ ዶናፐ ከሴዳ ቃላ ላምከ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"“እት ገደካ መናዉ","poem":1},{"text":"ታ ጌሻተን ጫቃ ድጋድ፤","poem":2},{"text":"ዳዊተዉ ዎርዶትከ።","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"ሄዌነ፥ አ ዘረይ መናዉ ደአና፤","poem":1},{"text":"አ ካዉተ አራታይካ ታ ስንን አዋዳን ጋምአና።","poem":2}]},{"type":"verse","number":37,"content":[{"text":"ሳሉዋን አማነትያ ማርካ ግድያ አግናዳን፥","poem":1},{"text":"ሄ ካዉተይ መናዉ ምን ኤቂ ደአና” ያጋዳ።","poem":2}]},{"type":"verse","number":38,"content":[{"text":"ሽን ሀእ ኔን","poem":1},{"text":"ኦካደ ካተዬዳዋ ቦላ ዳሮ ሀንቀታዳ፤","poem":2},{"text":"አ እጻዳነ አጋዳ።","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"ኔን ነ ቆማና ጫቀቴዳ ጫቁዋ ካዳዳ፤","poem":1},{"text":"አ ካላቻ ባናን ኦላደ ቱንሳዳ።","poem":2}]},{"type":"verse","number":40,"content":[{"text":"ኔን አ ካታማ ግምቢያ ኡባ ላላዳ፤","poem":1},{"text":"እ ናገትያ ሚጻ ኡባ ባይዛዳ።","poem":2}]},{"type":"verse","number":41,"content":[{"text":"ኦግያና አያ ኡባቱ አ ቦንቄድኖ፤","poem":1},{"text":"እ ባረ ሾሮቶ ቅሊጮ ግዴዳ።","poem":2}]},{"type":"verse","number":42,"content":[{"text":"ኔን አ ሞርከቶ ጾኑዋ እማዳ፤","poem":1},{"text":"ኡንቱንታ ኡባቱዋ ናሸቻዳ።","poem":2}]},{"type":"verse","number":43,"content":[{"text":"ኔን አ ማሻ ጼራ ቃላምኣዳ፤","poem":1},{"text":"ኔን ኦላን አ ማዳባካ።","poem":2}]},{"type":"verse","number":44,"content":[{"text":"ኔን አ ካዉታ ጻምኣ","poem":1},{"text":"አ ኩሽያፐ ዎ አካዳ፤","poem":2},{"lineBreak":true},{"text":"ቃይ አ ካዉተ አራታ ቢታን ኦላዳ።","poem":2}]},{"type":"verse","number":45,"content":[{"text":"ኔን አ ያላጋተ ዎድያ ቃምሳዳ፤","poem":1},{"text":"ቃይ አ ዬላ ማይዛዳ።","poem":2}]},{"type":"verse","number":46,"content":[{"text":"አቤት መና ጎዳዉ፥ አዉደ ጋካናዉ ቆንጭኪ?","poem":1},{"text":"ኔን መናዉ ጌማይ?","poem":2},{"text":"ነ ሀንቁ ታማዳን አዉደ ጋካናዉ ኤጻኔ?","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"ታ ላይይ አይ ኬሻ ቃንንቶ ቆፓ፤","poem":1},{"text":"አሳ ኡባ ጮ መላ መዲ?","poem":2}]},{"type":"verse","number":48,"content":[{"text":"አሳይ ሀይቀናን ጮ ደአና