{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":9,"content":[{"type":"heading","content":["ኢታ ቦላን ፕርዳ"]},{"type":"hebrew_subtitle","content":["ዛማረቱዋ ካፖ፥ “ናኣ ሀይቁዋን” የጸቴዳ፥ ዳዊታ ማዝሙርያ።"]},{"type":"verse","number":1,"content":["አቤት መና ጎዳዉ፥ ታን ኔና ታ ኩመን ዎዛናፐ ጋላታና፤",{"text":"ኔን ኦዳ ማላልስያ","poem":1},{"text":"ነ ኦሱዋ ኡባካ ኦዳና።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ኔናን ናሸታናነ ሀሹ ጋና።","poem":1},{"lineBreak":true},{"text":"ኡባፐ ቂያ ጾሳዉ፥","poem":1},{"text":"ታን ነ ሱንዉ ጋላታ የጻና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ታ ሞርከቱ ጉየ ስምያ ዎደ፥","poem":1},{"text":"ነ ስንፐ በት ያና።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኔን ታዉ ጽሎ ፕርዳ ፕርዳዳ፤","poem":1},{"lineBreak":true},{"text":"ኔን ጽሎተን ፕርዳደ፥","poem":1},{"text":"ነ ካዉተ አራታን ኡታዳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ኔን ካዉተ ሴራዳ፤","poem":1},{"text":"ኢታቱዋካ ይሳዳ።","poem":2},{"text":"ኔን ኡንቱንቱ ሱን መ መናዉካ ቁጫ ድጋዳ።","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ሞርከቱ መና ዩዋ ዬድኖ፤","poem":1},{"text":"ቃይ ኡንቱንቱ ካታማቱዋ ኡባና ቆላ ድጋዳ።","poem":2},{"text":"ኡንቱንቱ ኡባና ዶገት አቴድኖ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ሽን መና ጎዳይ መናዉ ካተቲደ ደኤ፤","poem":1},{"text":"እ ባረ ካዉተ አራታ ፕርዳዉ ጊግሴዳ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሀ ሳኣ ጽሎተን ፕርዳና፤","poem":1},{"text":"አሳቱዋካ ሱረተን ፕርዳና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"መና ጎዳይ ኡንኤቴዳዋንቶ ባቃት አትያዋ፤","poem":1},{"text":"መቶ ዎድያንካ ገል አትያ ጌሱዋ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ነ ሱን ኤርያዋንቱ ኔናን አማነቲኖ፤","poem":3},{"text":"አያዉ ጎፐ፥ መና ጎዳዉ፥ ኔን ኔና ኮይያዋንታ የጋ አጋ በይካ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ጽዮነ ደርያን ካተት ኡቴዳ መና ጎዳዉ ጋላታ የጽተ።","poem":3},{"text":"እ ኦዳ ኡባባካ አሳ ኡባዉ ኦድተ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አያዉ ጎፐ፥ ሱ ጉስያዋንቶ","poem":3},{"text":"ሀሉዋ ከስያ ጾሳይ","poem":2},{"lineBreak":true},{"text":"ናቀቴዳዋንቱ ዋሱዋ ሸነኮ ጌና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"አቤት መና ጎዳዉ፥ ጽዮነ አሳ ካርያን ታን ኤቃደ፥","poem":1},{"text":"ነ ጋላታ ኦዳና ማላነ","poem":2},{"lineBreak":true},{"text":"ሄዋን ነ አቶተን ሎይ ናሸታና ማላ፥","poem":2},{"lineBreak":true},{"text":"ታ ሞርከቱ ታና የደርስያዋ በአ።","poem":2},{"text":"ኔን ነ ማሮታን፥ ሀይቁዋፐ ታና አሻ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ካዉተቱ ባረንቱ ቦኬዳ ኦላን ባረንቶ ኩንዴድኖ።","poem":1},{"text":"ኡንቱንቱ ቆስ ዎዳ ጲሪ ኡንቱንቱ ገድያ ኦይቄዳ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"መና ጎዳይ ባረ ጽሎ ፕርዳን ባረዉ ኤረቴዳ፤","poem":1},{"text":"ኢታ አሳይ ባረ ኩሽያን ኦዳ ኦሱዋ ጲርያን ኦይቀቴዳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ኢታቱ ዱፉዋ ባና፤","poem":1},{"text":"ጾሳ ዶግያ ካዉተቱ ኡባይካ ኡንቱንቱዳን ሀናና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ህዬሳይ ኡባ ገደ ዶገት አተና፤","poem":1},{"text":"ዎይ መቶታንቻይ ዎዳ ህዶታይ መናዉ የና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"አቤት መና ጎዳዉ፥ አሳይ ነ ቦላ ደንዲደ፥","poem":1},{"text":"ባረ ዎልቃን ጬቀተና ማላ፥ ኔን ደንዳ!","poem":2},{"text":"ነ ስንን ካዉተቱዋ ቦላ ኔን ፕርዳ።","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"አቤት መና ጎዳዉ፥ ኡንቱንታ ኔን ያሽሳ፤","poem":1},{"text":"ኡንቱንቱ አሳ ግድያዋ ኔን ኡንቱንታ ኤርሳ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":19}