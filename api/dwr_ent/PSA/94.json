},{"type":"verse","number":8,"content":[{"text":"ህንተኖ፥ አሳ ግዶፐ አዳ ዳማቶ፥ አኬክተ!","poem":1},{"text":"ህንተኖ ኤያቶ፥ አዉደ ኤራንቻ ግዳንቴ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሀይ መዳ ጾሳይ ስሰኔ?","poem":1},{"text":"አይፍያ መዳዌ በኤኔ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ካዉተ ሴርያዌ ሙረኔ?","poem":1},{"text":"አሳ ኤራ ታማርስያዌ ባረዉ ኤረኔ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"መና ጎዳይ አሳ ቆፋይ መላ ግድያዋ ኤሬ።","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"አቤት መና ጎዳዉ፥ ኔን ሴርያዌነ","poem":1},{"text":"ነ ህግያፐ ታማርስያ አሳይ አንጀቴዳዋ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኢታቱ ኩንድያ ኦላይ ቦከታና ጋካናዉ፥","poem":1},{"text":"መቱ ጋክያ ጋላሳን ኔን አ ሸምፕሳሳ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"መና ጎዳይ ባረ አሳ አገና፤","poem":1},{"text":"እ ባረ ላታ አገና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ፕርዳይ ስሚደ ጽሎ ፕርዳ ግዳናዋ፤","poem":1},{"text":"ዎዛና ሱረቱ ኡባይ ሄ ጽሎ ፕርዳ ማዳና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ማካላንቻቱዋ ቦላ","poem":1},{"text":"ታ ድራዉ ደንድያዌ ኦኔ?","poem":2},{"text":"ኢታ ኦያዋንቱና","poem":1},{"text":"ታ ድራዉ ኤቀቴዳዌ ኦኔ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"መና ጎዳይ ታና ማደነንቶ፥","poem":1},{"text":"ታን ኤለካ ዱፉዋን ገላደ ስርጵ ጋና ሽን።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"አቤት መና ጎዳዉ፥ ታን፥","poem":1},{"text":"“ታ ገዲ ሀልጼ” ያጌዳ ዎደ፥","poem":2},{"lineBreak":true},{"text":"አገና ነ ሲቁ ታዉ ዘምፖ ግዴዳ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ታና ህርጋይ ዎያ ዎደ፥","poem":1},{"text":"ኔን ታና ዎፑ ኦደ ናሸቻሳ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ህግያ ባለያ ጌላ ዳናቱዋና","poem":1},{"text":"ኔን ዙፐታይ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ጽሎቱዋ ዎናዉ ኡንቱንቱ እትፐ ቶበቲኖ፤","poem":1},{"text":"ሱረቱዋ ቦላ ሀይቁዋ ፕርዲኖ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ግዶፐነ፥ መና ጎዳይ ታን ባቃታ አቴዳ ሳኣ፤","poem":1},{"text":"ታ ጾሳይ ታን ቆሰትያ ዛላ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ኡንቱንቱ ኢታተ ድራዉ፥ እ ኡንቱንታ ሙራና፤","poem":1},{"text":"ኡንቱንቱ ናጋራ ድራዉ፥ እ ኡንቱንታ ይሳና፤","poem":2},{"lineBreak":true},{"text":"ኤ፥ መና ጎዳይ ኑ ጾሳይ ኡንቱንታ ይሳና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}