{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":95,"content":[{"type":"heading","content":["ጋላሳ ጋላሳ ማዝሙርያ"]},{"type":"verse","number":1,"content":[{"text":"ሃይተ፤ አነ መና ጎዳ ሳቦይተ።","poem":1},{"text":"ኑና አሽያ ዛላዉ ናሸቻዉ የጾይተ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አ ስን ጋላታና ሺቆይተ።","poem":1},{"text":"ጋላታ የ ናሸቻን የጾይተ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አያዉ ጎፐ፥ መና ጎዳይ ዎልቃማ ጾሳ፥","poem":1},{"text":"ጾሳቱዋ ኡባ ቦላ ዎልቃማ ካትያ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ቢታ ጪማቱ አ ኩሽያን ደኢኖ፤","poem":1},{"text":"ደርያ ሁጰቱካ አዋ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አባ ሃይካ አዋ፤","poem":1},{"text":"ሄዋ እ መዳ፤","poem":2},{"lineBreak":true},{"text":"መላ ቢታካ አ ኩሺ ኦዳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ሃይተ፤ ሆኪደ አነ አዉ ጎይኖይተ፤","poem":1},{"text":"ኑና መዳ መና ጎዳ ስንን ጉልባቶይተ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አያዉ ጎፐ፥ እ ኑ ጾሳ።","poem":1},{"text":"ኑን አ ቆሩዋን ደእያ አሳቱዋ፤","poem":2},{"lineBreak":true},{"text":"ኑን እ ሄምያ አ ዶርሳ ዉደቱዋ።","poem":2},{"lineBreak":true},{"text":"ጾሳይ ህንተና ግያዋ ሀች ስስተ!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“ካሰ ህንተ ማይዛ አዎቱ፥","poem":1},{"text":"ማሪባ ግያ ሳኣን ሀኔዳዋዳን፥","poem":2},{"lineBreak":true},{"text":"ሄ ጋላስ ማሳ ባዙዋን እጼዳዋዳን፥","poem":2},{"lineBreak":true},{"text":"ህንተካ ዞርያ አከናን እጾፕተ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኡንቱንቱ ታ ኦሱዋ በኢደካ፥","poem":1},{"text":"ታና ኤቀቴድኖነ ፓጬድኖ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታን ሄ የለታ ኦይታሙ ላይ ሻተታድ፤","poem":1},{"text":"‘ኡንቱንቱ ኡባ ዎደ ባረንቱ ዎዛናን ባሊኖ፤","poem":2},{"lineBreak":true},{"text":"ኡንቱንቱ ታ ኦግያ ኤርበይክኖ ያጋድ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሄዋዳንካ ቃይ፥ ታን ሀንቀታ ጫቃደ፥","poem":1},{"text":"ኡንቱንቱ ታ ሸምፑዋሳ ኡባካ ገልክኖ’ ያጋድ” ያጌ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}