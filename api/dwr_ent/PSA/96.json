{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":96,"content":[{"type":"heading","content":["ጾሳይ ኡባፐ ቦላ ካትያ"]},{"type":"verse","number":1,"content":[{"text":"መና ጎዳዉ ኦራ የ የጽተ፤","poem":1},{"text":"ሳኣን ደእያ አሳይ፥ ኡባይ መና ጎዳዉ የጽተ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"መና ጎዳዉ የጽተ፤ አ ሱን ሳቢተ፤","poem":1},{"text":"እ አሽያ ምሽራቹዋ ጋላሳን ጋላሳን ኦድተ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ካዉተ ግዶን አ ቦንቹዋ፥","poem":1},{"text":"አሳ ኡባ ግዶን አ ማላልስያ ኦሱዋባ አዋይተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"አያዉ ጎፐ፥ መና ጎዳይ ዎልቃማ፤","poem":1},{"text":"ግታ ጋላታይ አዉ በሴ።","poem":2},{"text":"ጾሳቱዋ ኡባፐ አደ እ ያየታናዉ በሴ።","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ሀራ አሳ ጾሳቱ ኡባይ ኤቃቱዋ፤","poem":1},{"text":"ሽን መና ጎዳይ ሳሎቱዋ መዳ ጾሳ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ቦንቹነ አንጋይ አ ዩሹዋን ደኤ፤","poem":1},{"text":"ምኖተይነ ፑላይ አ ጌሻ ጎልያን ደኤ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ህንተኖ፥ አሳ ዛረቶ ኡባቶ፥","poem":1},{"text":"መና ጎዳባ ኦድተ፤","poem":2},{"text":"“ቦንቹነ ዎልቃይ መና ጎዳሳ” ጊደ ኦድተ።","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"“ቦንቹ አ ሱንሳ”","poem":1},{"text":"ጊደ መና ጎዳባ ኦድተ።","poem":2},{"text":"ያርሹዋ አኪደ፥ አ ዳባባ ገልተ።","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"አ ጌሻተ ፑላን መና ጎዳዉ ጎይንተ፤","poem":1},{"text":"ቢታን ደእያ አሳ ኡባዉ፥ አ ስንን ኮኮርተ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ካዉተቱዋ ግዶን፥ “መና ጎዳይ ካተቴዳ!","poem":1},{"text":"ሳአይ ምን ኤቄዳ፤ ኡባካ ቃጸና።","poem":2},{"text":"እ አሳ ቦላ ሱረተን ፕርዳና” ያግተ።","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ሳሎቱ ናሸትኖ፤ ሳአይካ ሀሹ ጎ፤","poem":1},{"text":"አባይነ አ ግዶን ኩሜዳዌ ጉሞ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሾይቃይነ ሾይቃን ደእያ ኡባይ ናሸቶ!","poem":1},{"text":"ዎራን ደእያ ም ኡባይካ ናሸቻን አ ስንን የጻና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አያዉ ጎፐ፥ መና ጎዳይ ዬ፤","poem":1},{"text":"እ ሳኣ ቦላን ፕርዳናዉ ዬ፤","poem":2},{"text":"እ ሀ ሳኣ ቦላ ጽሎተን፥","poem":1},{"text":"አሳ ቦላካ ቱማተን ፕርዳና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}