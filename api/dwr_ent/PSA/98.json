ናሸቻን መና ጎዳ ኑ ካትያ ስንን ሆምቦጭተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"አባይነ አባ ግዶን ኩሜዳዌ ኡባይ ጉሞ።","poem":1},{"text":"ሳአይነ ሳኣ ቦላን ደእያ ኡባይ የጾ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሻፋቱ እትፐ ባረንቱ ኩሽያ ባቂኖ።","poem":1},{"text":"ቄር ደረቱ መና ጎዳ ስንን እትፐ ናሸቻን የጽኖ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አያዉ ጎፐ፥ እ ሳኣ ቦላን ዳናታናዉ ዬ።","poem":1},{"text":"እ ሀ ሳኣ ቦላ ጽሎተን፥","poem":2},{"lineBreak":true},{"text":"አሳ ቦላካ ሱረተን ዳናታና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}