{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ent","name":"ማዝሙርያ","commonName":"ማዝሙርያ","title":"ማዝሙርያ ማጻፋ","order":19,"numberOfChapters":150,"sha256":"596b9966dc57b74c234ea4ccbc5c878fc4015fdfcf29d175c4daaaaa9ee64b67","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ent/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":99,"content":[{"type":"heading","content":["ጾሳይ ጽሉዋነ ጌሻ"]},{"type":"verse","number":1,"content":[{"text":"መና ጎዳይ ካዉቴዳ! ሄዎ አሳቱ ኮኮርኖ።","poem":1},{"text":"ክሩበቱዋፐ ግዱዋን ካዉተ አራታ ቦላ ኡቴዳ፤","poem":2},{"text":"ሄዎ ቢታይ ቃጾ፤","poem":3}]},{"type":"verse","number":2,"content":[{"text":"መና ጎዳይ ጽዮነን ዎልቃማ፤","poem":1},{"text":"ካዉተ ኡባፐ እ ቁ ቁ ጌዳ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዳሮፐ ያሽያ አ ዎልቃማ ሱን፥","poem":1},{"text":"ኡንቱንቱ ኡባይ ጋላትኖ።","poem":2},{"text":"እ ጌሻ!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ኔን፥ ዎልቃማ ካቲ፥ ልከ ፕርዳ ዶሳሳ።","poem":1},{"text":"ኔን ያቆባ አሳዉ ሱረተ ምንሳዳ።","poem":2},{"text":"ጽሎተነ ልከ ፕርዳ ኤሳዳ።","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"መና ጎዳ ኑ ጾሳ ቁ ቁ ኦተ፤","poem":1},{"text":"አ ገዲ የያሳን ጉፋኒደ አዉ ጎይንተ።","poem":2},{"text":"እ ጌሻ!","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ሙሴነ አሮነ አ ቀሰቱዋ ግዱዋፐ ላአቱዋ፤","poem":1},{"text":"ሳሜልካ አ ሱንን ዎሴዳዋንቱፐ እቱዋ።","poem":2},{"text":"ኡንቱንቱ መና ጎዳዉ ዋሴድኖ፤","poem":1},{"text":"እካ ኡንቱንቶ አሌዳ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እ ሻርያ ቱሳ ግዱዋና ኡንቱንቶ ሃሳዬዳ፤","poem":1},{"text":"ኡንቱንቱ እ እሜዳ ህግያነ ዎጋ ናጌድኖ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"አቤት መና ጎዳዉ፥ ኑ ጾሳዉ፥","poem":1},{"text":"ኔን ኡንቱንቱ ዎሳ ስሳዳ።","poem":2},{"text":"ኔን ኡንቱንቱ ኢታተ ድራዉ ሙሬዳዋ ግዶፐካ፥","poem":1},{"text":"ኡንቱንቶ አቶ ጌዳ ጾሳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"መና ጎዳ ኑ ጾሳ፥ ቁ ቁ ኦተ፤","poem":1},{"text":"አ ጌሻ ደርያ ቦላን አዉ ጎይንተ፤","poem":2},{"lineBreak":true},{"text":"አያዉ ጎፐ፥ መና ጎዳይ ኑ ጾሳይ ጌሻ!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}