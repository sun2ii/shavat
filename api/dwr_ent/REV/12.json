{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"REV","translationId":"dwr_ent","name":"ዮሃንሳ ሳፃ","commonName":"ዮሃንሳ ሳፃ","title":"ዮሃንሳዉ ዬዳ ሳፃ","order":66,"numberOfChapters":22,"sha256":"5a29cc2d2ad5ff818e6f51806351ef2e590c2e0e6a5e28a10538520ae109abf0","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/dwr_ent/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":12,"content":[{"type":"heading","content":["ታን ምሽራቶ፥ ናኣነ ዳዊያ በኣድ"]},{"type":"verse","number":1,"content":["ሄዋፐ ጉይያን፥ ሳሉዋን ዎልቃማ ማላይ ቤቴዳ። አዋ ማዬዳ እት ምሽራታ፥ አገና ቦላ ኤቄዳዉና፥ ታማነ ላኡ ጾልንትያ ካላቻ ባረ ሁጲያን ዎዳዉና ሄዋን ደአዉ።"]},{"type":"verse","number":2,"content":["ሄ ምሽራታ ሻሃራ፤ እዞ የሉዋ ኦይይ፥ ኡንኤና ዋሳዱ።"]},{"type":"verse","number":3,"content":["ሀራ እት ዎልቃማ ማላይ ሳሉዋን ቤቴዳ። ታሙ ካጭያና ደእያ ላፑ ሁጲያን ካላቻ ዎዳ እት ዎልቃማ ዞኦ ዳዊ ደኤ።"]},{"type":"verse","number":4,"content":["ሄ ዳዊ ባረ ዱፍያን ሄዘን ኩሸ ጾልንትያ ሳሉዋፐ ዳፊደ፥ ሳኣን ኦሌዳ። ሄ ዳዊ የለት ዎሳናካ ናኣ ማናዉ የላና ሀንያ ምሽራት ስንን ኤቄዳ።"]},{"type":"verse","number":5,"content":["ምሽራታ አቱማ ናኣ፥ አይሁዳ ግደና አሳ ኡባ ብራታ ጻምኣን ሞዳናዋ የላዱ። ሽን ናአይ ጾሳኮነ አ አራታኮ፥ ፑደ ኤለካ አከቴዳ።"]},{"type":"verse","number":6,"content":["ምሽራታ እት ሻአነ ላኡ ጼታነ ኡሱፑን ታሙ ጋላሳዉ ምዚደነ ኡሺደ ዎናዉ ጾሳይ ጊግስ ዎዳ ሳኣ ባዙዋ ባቃታዱ።"]},{"type":"verse","number":7,"content":["ሄዋፐ ጉይያን፥ ሳሉዋን ኦላይ ደንዴዳ። ምካኤል ባረ ኪታንቻቱዋና እትፐ ዳዊያ ኦለቴዳ፤ ዳዊካ ባረ ኪታንቻቱዋና ግዲደ፥ ዛር ኦለቴዳ።"]},{"type":"verse","number":8,"content":["ሽን ዳዊ ጾነትና ዳዊያስነ አ ኪታንቻቶ ሳሉዋን ሳአይ ዬዳ።"]},{"type":"verse","number":9,"content":["ዎልቃማ ዳዊ፥ ጻላህያ ካፑዋ ዎይ ሴጻና ግያዌ፥ በን ሾሻይ፥ አላምያ ኡባ ባለያዌ ኦለቴዳ፤ እ ባረ ኪታንቻቱዋና እትፐ ዱገ ሳአዉ ኦለቴዳ።"]},{"type":"verse","number":10,"content":["ሄዋፐ ጉይያን፥ ታን ሳሉዋፐ ሀዋዳን ያግያ ኮሻ ስሳድ፤",{"text":"“ጾሳ አቶተይ ሀእ ዬዳ።","poem":1},{"text":"ጾሳይ ባረዉ ካተ ግድያዋዳንካ፥","poem":2},{"lineBreak":true},{"text":"ባረ ዎልቃ በሴዳ፤","poem":2},{"lineBreak":true},{"text":"አ ክርስቶስ ባረ ማታ በሴዳ።","poem":2},{"text":"አያዉ ጎፐ፥","poem":1},{"text":"ቃማነ ጋላስ ጾሳ ስንን ኤቂደ፥","poem":2},{"lineBreak":true},{"text":"ኑ እሻቱዋ ሞትያዌ፥","poem":2},{"lineBreak":true},{"text":"ሳሉዋፐ ዱገ ኦለቴዳ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኑ እሻቱ ዶርሳ ሱንነ፥","poem":1},{"text":"ባረንቱ ቱሙ ማርካተን","poem":2},{"lineBreak":true},{"text":"ዳዊያ ኦለቲደ ጾኔድኖ።","poem":2},{"lineBreak":true},{"text":"ቃይ ኡንቱንቱ ባረንቱ ሸምፑዋ አ እምያዎ፥","poem":2},{"lineBreak":true},{"text":"ቃረትበይክኖ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሄዋ ድራዉ፥","poem":1},{"text":"ሳሉነ ሳሉዋ ግዶን ደእያዋንቱ፥","poem":2},{"lineBreak":true},{"text":"ናሸትተ።","poem":2},{"lineBreak":true},{"text":"ሽን ሳአዉነ አባዉ አዬሮ!","poem":2},{"text":"አያዉ ጎፐ፥","poem":1},{"text":"ጻላህያ ካፑ፥","poem":2},{"lineBreak":true},{"text":"ባረዉ ጉ ዎዲ አቴዳዋ ኤርያ ድራዉ፥","poem":2},{"lineBreak":true},{"text":"ዎልቃማ ሀንቁዋን፥","poem":2},{"lineBreak":true},{"text":"ዱገ ህንተንቱኮ ዎዳ”","poem":2},"ያጌዳ።"]},{"type":"verse","number":13,"content":["ቃይ ዳዊ ባረና ዱገ ሳኣ ኦሌዳዋ በኤዳዋፐ ጉይያን፥ ሄ አቱማ ናኣ የሌዳ ምሽራቶ የደርሱዋ ዶሜዳ።"]},{"type":"verse","number":14,"content":["ምሽራቶ ሾሻይ ቆሄና ማላ፥ ሄዙ ላይነ ባጋ ማደነ ኡሻደ እዛ ናገትያሳ ባዙዋ ፓላደ ባና ማላ፥ ላኡ ዎልቃማ አርጋን ቀፊ እዝዉ እመቴዳ።"]},{"type":"verse","number":15,"content":["ሄዋፐ ጉይያን፥ ምሽራቶ ድኡ ድኢደ አፋና ማላ፥ ሾሻይ ሻፋ ሃ ኬና ሃ ባረ ዶናፐ ምሽራት ጌዱዋን ጉሴዳ።"]},{"type":"verse","number":16,"content":["ሽን ቢታይ ምሽራቶ ማዴዳ፤ ቢታይ ባረ ዶና ዶዪደ፥ ዳዊያ ዶናፐ ከሴዳ ሃ ምት አጌዳ።"]},{"type":"verse","number":17,"content":["ዳዊ ምሽራትዉ ዳርስ ሀንቀቲደ፥ እዝ ዘረ ጾሳ አዛዙዋ ናግያ ኡባቱዋነ የሱስ ቆንጭሴዳ ቱሙ አማነትያዋንታ ኦላናዉ፥"]},{"type":"verse","number":18,"content":["ቢደ አባ ዶናን ደእያ ሻፍያን ኤቄዳ።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/REV/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/REV/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/REV/11.json","previousChapterAudioLinks":{},"numberOfVerses":18}