{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"REV","translationId":"dwr_ent","name":"ዮሃንሳ ሳፃ","commonName":"ዮሃንሳ ሳፃ","title":"ዮሃንሳዉ ዬዳ ሳፃ","order":66,"numberOfChapters":22,"sha256":"5a29cc2d2ad5ff818e6f51806351ef2e590c2e0e6a5e28a10538520ae109abf0","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/dwr_ent/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":15,"content":[{"type":"heading","content":["ታን ቡርጩኩዋ አባ ቤኣድ"]},{"type":"verse","number":1,"content":["ታን ሳሉዋን ሀራ ዎልቃማነ ማላልስያ ማላ በኣድ። ጾሳ ሀንቁ ኡንቱንቱ ቦላን ፖለትያ ድራዉ፥ ዉርሰ ላፑ ቦሻና ደእያ ላፑ ኪታንቻቱ ደኢኖ።"]},{"type":"verse","number":2,"content":["ቃይካ ታን ቡርጩኩዋ አባ ማላትያዋ ታማና ዋላከቴዳዋ በኣድ። ቃይ ዶኣ፥ አ ምስልያነ አ ሱን ፓይዱዋ ጾኔዳዋንታ በኣድ። ጾሳይ ኡንቱንቶ እሜዳ ዲቱዋ ኦይቂደ፥ ቡርጩኩዋ ማላትያ አባ ማታን ኡንቱንቱ ኤቄድኖ።"]},{"type":"verse","number":3,"content":["ኡንቱንቱ፥ ጾሳ ኦሳንቻ ሙሴ ማዝሙርያነ ዶርሳ ማዝሙርያ ሀዋዳን የጼድኖ።",{"text":"“ጎዳዉ፥ ኡባፐ ዎልቃማ ጾሳዉ፥","poem":1},{"text":"ነ ኪታይ ግታነ ማላልስያዋ።","poem":2},{"text":"አሳ ዛርያ ኡባ ካተዉ፥","poem":1},{"text":"ነ ኦጊ ጽሉዋነ ቱሙዋ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጎዳዉ፥ ነዉ ያየናዌነ","poem":1},{"text":"ነ ሱን ቦንቼናዌ ኦኔ?","poem":2},{"text":"አያዉ ጎፐ፥ ጌሻይ ነ ጻላላ።","poem":1},{"text":"አሳ ዛርያ ኡባይ ዪደ፥","poem":2},{"lineBreak":true},{"text":"ነ ስንን ጎይናና፤","poem":2},{"lineBreak":true},{"text":"አያዉ ጎፐ፥ ነ ጽሎ ኪታይ","poem":2},{"lineBreak":true},{"text":"ኡባዉ ቆንጬዳ”","poem":2},"ያጊደ የጺኖ።"]},{"type":"heading","content":["ላፑ ቦሻና ደእያ ላፑ ኪታንቻቱዋ"]},{"type":"verse","number":5,"content":["ሄዋፐ ጉይያን፥ ታን ሳሉዋን ደእያ ጌሻ ጎሊ ዶየቶዋ ሄዌካ ማርካተ ዱንካንያ በኣድ።"]},{"type":"verse","number":6,"content":["ላፑ ቦሻና ደእያ ላፑ ኪታንቻቱ ጌሻ ጎልያፐ ከሴድኖ። ኡንቱንቱ ጶሊደ ቦጽያ ላይኑዋ ማዩዋ ማዬድኖ፤ ባረንቱ ትራ ዎርቃ ዳንጩዋን ዩሽ አደ ቃቼድኖ።"]},{"type":"verse","number":7,"content":["ደኡዋን ደእያ ኦይዱ መታቱዋፐ እቱ፥ መ መናዉ ጋካናዉ ደእያ ጾሳ ሀንቁ ኩሜዳ ላፑ ዎርቃ ከረቱዋ ላፑ ኪታንቻቶ እሜዳ።"]},{"type":"verse","number":8,"content":["ጾሳ ቦንቹዋፐነ አ ዎልቃፐ ዬዳ ጩዋይ ጌሻ ጎልያ ኩሜዳ። ላፑ ኪታንቻቱ አሄዳ ላፑ ቦሻቱ ፖለታና ጋካናዉ፥ ጌሻ ጎልያ ኦንነ ገላናዉ ዳንዳይቤና።"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/REV/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/REV/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/REV/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}