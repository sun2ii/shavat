{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"REV","translationId":"dwr_ent","name":"ዮሃንሳ ሳፃ","commonName":"ዮሃንሳ ሳፃ","title":"ዮሃንሳዉ ዬዳ ሳፃ","order":66,"numberOfChapters":22,"sha256":"5a29cc2d2ad5ff818e6f51806351ef2e590c2e0e6a5e28a10538520ae109abf0","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/dwr_ent/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":5,"content":[{"type":"heading","content":["ማጻፋነ ዶርሳ"]},{"type":"verse","number":1,"content":["እት ጻጸቶ ማጻፋይ",{"noteId":9},"ካዉተ ኦይድያን ኡቴዳዋ ኡሸቻ ኩሽያን ደእያዋ በኣድ፤ ሄ ጻጸቶ ማጻፋይ ላኡ ባጋናካ ጻፈት ኡቴዳ፤ ቃይ ላፑ ማታፋይ አ ቦላ አታመቴዳ።"]},{"type":"verse","number":2,"content":["ታን እት ዎልቃማ ኪታንቻይ ባረ ቃላ ቁ ኦደ፥ “ማታፋ ዶዪደ፥ ጻጸቶ ማጻፋ ብላናዉ በስያ ኡራይ ኦኔ?” ያጊደ፥ አዋይያዋ በኣድ።"]},{"type":"verse","number":3,"content":["ሳሉዋን ግድና ዎይ ሳኣን ግድና፥ ዎይ ሳኣፐ ጋርሳን",{"noteId":10},"ግድና፥ ሄ ጻጸቶ ማጻፋ ብላናዉ ዎይ አ ግዱዋ ጼላናዉ ኦንነ በስያዌ ባዋ።"]},{"type":"verse","number":4,"content":["ጻ ማጻፋ ብላናዉ ዎይ አ ግዱዋ ጼላናዉ በስያ ኡራይ ባይና ድራዉ፥ ታን ዳሮ ዬካድ።"]},{"type":"verse","number":5,"content":["ጭማቱዋፐ እቱ ታና፥ “ዬኮፓ፤ በአ፥ ይሁዳ ዛርያ ግዴዳ ጋሙ፥ ዳዊተ ዛሪ ጾኔዳ። እ ማታፋ ዶያናዉነ ጻጸቶ ማጻፋ ብላናዉ በሴ” ያጌዳ።"]},{"type":"verse","number":6,"content":["ታን ካዉተ ኦይድያፐ፥ ደኡዋን ደእያ ኦይዱ መታቱዋፐነ ቃይ ጭማቱዋፐ ግዱዋን፥ ሹከቴዳ ዶርሳ ማላቲደ ኤቄዳዋ በኣድ፤ አዉ ላፑ ካጨቱነ ላፑ አይፈቱ ደኢኖ። ሄዋንቱ አላምያ ኡባ ኪተቴዳ ጾሳ ላፑ አያናቱዋ።"]},{"type":"verse","number":7,"content":["ሄ ዶርሳይ ቢደ፥ ካዉተ ኦይድያ ቦላ ኡቴዳዋ ኡሸቻ ኩሽያፐ ጻጸቶ ማጻፋ አኬዳ።"]},{"type":"verse","number":8,"content":["እ ሄ ጻጸቶ ማጻፋ አኬዳ ዎደ፥ ደኡዋን ደእያ ኦይዱ መታቱነ ላታማነ ኦይዱ ጭማቱ አ ስንን ኩንዴድኖ። ኡንቱንቱ ሁጲያን ሁጲያን ዲነ እጻናይ ኩሜዳ ዎርቃ ሚሻ ኦይቄድኖ። ሄ እጻናይ ጌሻቱ ጾሳ ዎስያዋ።"]},{"type":"verse","number":9,"content":["ኡንቱንቱ፥",{"text":"“ጻ ማጻፋ አካናዉነ፥","poem":1},{"text":"ማታፋ ዶያደ፥","poem":2},{"lineBreak":true},{"text":"ጼላናዉ ነዉ በሴ።","poem":2},{"lineBreak":true},{"text":"አያዉ ጎፐ፥ ኔን ሹከታዳ።","poem":2},{"text":"ኔን ቆሙዋ ኡባፐ፥","poem":1},{"text":"ዱማ ዱማ ጋድያ ቃላ ኡባፐ፥","poem":2},{"lineBreak":true},{"text":"ያራ ኡባፐነ፥ ዛርያ ኡባፐ፥","poem":2},{"lineBreak":true},{"text":"ነ ሱን፥ ጾሳዉ አሳ ዎዛዳ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኑ ጾሳዉ ኦና ማላ፥","poem":1},{"text":"ኡንቱንታ ኔን፥ ካታቱዋነ፥","poem":2},{"lineBreak":true},{"text":"ቄሳቱዋ ኦዳ።","poem":2},{"lineBreak":true},{"text":"ቃይ ኡንቱንቱ ሳአንካ ሞዳና”","poem":2},{"lineBreak":true},{"text":"ያጊደ ኦራ ማዝሙርያ የጺኖ።","poem":2}]},{"type":"verse","number":11,"content":["ሄዋፐ ጉይያን፥ ታን ጼላደ፥ ካዉተ ኦይድያ፥ ደኡዋን ደእያ ኦይዱ መታቱዋነ ጭማቱዋ ዩይ አደ ኤቄዳ ዳሮ ኪታንቻቱዋ ኮሻ ስሳድ፤ ኡንቱንቱ ሻኣንነ ሚሎንያን ፓይደቴድኖ።"]},{"type":"verse","number":12,"content":["ሄ ኪታንቻቱ ባረንቱ ቃላ ቁ ኦደ፥",{"text":"“ሹከቴዳ ዶርሳይ","poem":1},{"text":"ዎልቃ፥ ዱረተ፥","poem":2},{"lineBreak":true},{"text":"አዳ ኤራ፥","poem":2},{"lineBreak":true},{"text":"ምኖተ፥","poem":2},{"lineBreak":true},{"text":"ቦንቹዋ፥ ሳባ፥","poem":2},{"lineBreak":true},{"text":"ጋላታ አካናዉ በሴ!”","poem":2},"ያጌድኖ።"]},{"type":"verse","number":13,"content":["ሄዋፐ ጉይያን፥ ሳኣን፥ ሳሉዋን፥ ሳኣፐ ጋርሳንነ አባ ግዱዋን ደእያ መታ ኡባይነ ቃይ ሄዋንቱን ደእያ መታ ኡባይ፥",{"text":"“ካዉተ ኦይድያ ቦላ፥","poem":1},{"text":"ኡቴዳዎነ ዶርሳዉ፥","poem":2},{"lineBreak":true},{"text":"ጋላታይ፥ ቦንቹ፥","poem":2},{"lineBreak":true},{"text":"ሳባይነ ዎልቃይ፥","poem":2},{"lineBreak":true},{"text":"መ መናዉ ግዶ!”","poem":2},"ያጊደ የጽሽን ስሳድ።"]},{"type":"verse","number":14,"content":["ደኡዋን ደእያ ኦይዱ መታቱ፥ “አመንእ” ያግና፥ ጭማቱ ጉፋኒደ ጎይኔድኖ።"]}],"footnotes":[{"noteId":9,"caller":"+","text":"ጻጸቶ ማጻፋ፦ ሀዋ ጉሳይ ዋራቃታን ዎይ ጋልባን ጻፈቴዳ ጻጸትያ ማጻፋ ግዲደ፥ ዳሮ ካረ ባጋና እት ዎይ ላኡ ቦላ ባጋ ጋልባን ማታፋይ አታመቴ።","reference":{"chapter":5,"verse":1}},{"noteId":10,"caller":"+","text":"ሳኣፐ ጋርሳን፦ ሀይቄዳዋንታ ጉሳ።","reference":{"chapter":5,"verse":3}}]},"thisChapterLink":"/api/dwr_ent/REV/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/REV/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/REV/4.json","previousChapterAudioLinks":{},"numberOfVerses":14}