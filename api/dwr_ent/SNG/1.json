{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"SNG","translationId":"dwr_ent","name":"ሲቁዋ ሳባ","commonName":"ሲቁዋ ሳባ","title":"ሲቁዋ ሳቢያ ማጻፋ","order":22,"numberOfChapters":8,"sha256":"da2534ceb2a630388d630250d5306f1486fb13eb9c067365c76890c927377d03","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/dwr_ent/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"heading","content":["ሲቁ ዎይንያ ኤሳፐ አ"]},{"type":"verse","number":1,"content":["ማዛሙርያ ኡባፐ አያ ሶሎሞና ማዛሙሪ ሀዋ።"]},{"type":"verse","number":2,"content":[{"text":"“ነ ሲቁ ዎይንያ ኤሳፐ አ ናሸችያ ድራዉ፥","poem":1},{"text":"ነ መተርሻን ዛራ ዛራደካ ታና የራ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ነ ኦከትያ ሽቱ ዎት ሳዊ!","poem":1},{"text":"ነ ሱንይ ጼሰትያ ዎደካ አያ ናሸቺ!","poem":2},{"lineBreak":true},{"text":"ጌላዮቱ ኔና ሲቅያዌ ሄዋሳ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታና ኔናና አካደ ባ። ሃያ፥ አነ ላኡ እትፐ ዎጾይተ!","poem":1},{"text":"ታ ካትያዉ፥ ታና ነ ሲርጻ ገልሳ” ያጋዱ።","poem":2},"የሩሳላመ ማጫ አሳቱ:",{"text":"አባን ኑን አይ ኬሻ ናሸቴዶ!","poem":1},{"text":"ኑን አ ሲቁዋ ዎይንያ ኤሳፐካ አደ ናሸቶ።","poem":2},{"lineBreak":true},{"text":"ቱሙካ ማጫ አሳይ ኡባይ ኔና ሲቃናዉ በሴ ያጌድኖ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ህንተኖ፥ የሩሳላመ ማጫ አሳቶ፥ ስስተ፥","poem":1},{"text":"ታን ካረ፤ ግዶፐነ፥ ማላንቻ።","poem":2},{"lineBreak":true},{"text":"ታ ካረተይ ቄዳረ ዱንካንያ ማላ፤","poem":2},{"lineBreak":true},{"text":"ሽን ታ ማላይ ሶሎሞና ካትያ ጎልያ ጋርዳቱዋ ማላ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታ ማላ ካረጽሴዳዌ ጹግያ አዋ፤","poem":1},{"text":"ታን ካረ ግዴዳ ድራዉ፥ ታና ካፓ።","poem":2},{"lineBreak":true},{"text":"ታ እሻቱ፥ ታ አት ናናቱ ታናና ዋላቀቲደ፥","poem":2},{"lineBreak":true},{"text":"ታና ዎይንያ ቱራ ናጋንቻ ኦድኖ፤","poem":2},{"lineBreak":true},{"text":"ያትና፥ ታን ታና ናጋበይከ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታ ሲቆዉ፥ አነ ታዉ ኦዳ፤","poem":1},{"text":"ነ ዶርሳ ዉድያ ኔን ሄምያዌ ሀቃኔ?","poem":2},{"lineBreak":true},{"text":"ጋላስ አዋፐ ነ ኡንቱንታ ሸምፕስያዌ ሀቃኔ?","poem":2},{"lineBreak":true},{"text":"ኔና ደማናዉ ነ ላገቱዋ ዉድያ ካላደ፥","poem":2},{"lineBreak":true},{"text":"አያዉ ዩሻንቻ ማጫ አሳ ግዶ? ያጋዱ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሀነ፥ ማጫ አሳ ኡባፐ አ ሎእያ ማላንቻቴ!","poem":1},{"text":"ሳኣ ኤራና ዮፐ፥ ዶርሳይ ቤዳ ሳ ካላደ ባ፤","poem":2},{"lineBreak":true},{"text":"ነ ዴሻ ማራቱዋካ ሄንንቻቱዋ ዱንካንያ ማታን ሄማ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ታ ሲቃቴ!","poem":1},{"text":"ግብጼ ካትያ ፓራ ጋርያ ጎችያ ፓራቱዋ ግዶን ደእያ ማጋያቲዳን ሎኣሳ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አቤት፥ ነ ሀይን ጎላካትያ አሌቁዋና ሺቂደ፥","poem":1},{"text":"ነ ጋጩ አያ ሎኢ! ነ ዚዚካ እንቁዋን አሌቀቴዳዋ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኑን ነዉ ብራን አሌቀቴዳ፥","poem":1},{"text":"ዎርቃ አሌቁዋ ኦስሳና ያጌድኖ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ካቲ ማዳን ኡት ደእሽን፥","poem":1},{"text":"ታ ሽቱዋ ሳዉ ጎልያ ግዶ ኡባን ቶሹኩ ጌዳ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታ ሲቁ ታ ንቱዋፐ ግዱዋን ሸምፕያ ዎደ፥","poem":1},{"text":"አ ፔኑ ቃርጪትያና ደእያ ካዋራዳን ሳዌ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታ ሲቁ ኤንጋደ ጌተትያ ዎይንያ ሳኣን ዶሌዳ፥","poem":1},{"text":"ባዙዋ ጪሻ ማላ ያጋዱ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታ ሲቃቴ፥ ኔን ዋታ ሎአይ! ኔን ዋታ ሎአይ!","poem":1},{"text":"ነ አይፈቱ ሀራጵያ አይፍያዳን ሎኢኖ ያጌዳ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታ ሲቆዉ፥ ኔን አያ ሎአይ! አያ ናሸቻይ፤","poem":1},{"text":"ኑ አርሳይካ አጬዳ ማታዳን ናሸችያዋ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኑ ጎልያ ዛሩ ዝጋ፤ ካራይካ ጺዳን ዳደቴዳዋ ያጋዱ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}