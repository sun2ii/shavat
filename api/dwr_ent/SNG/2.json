{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"SNG","translationId":"dwr_ent","name":"ሲቁዋ ሳባ","commonName":"ሲቁዋ ሳባ","title":"ሲቁዋ ሳቢያ ማጻፋ","order":22,"numberOfChapters":8,"sha256":"da2534ceb2a630388d630250d5306f1486fb13eb9c067365c76890c927377d03","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/dwr_ent/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"ታን፥ “ሳሮና ግያ ሳኣን ዶልያ ጪሻነ፥","poem":1},{"text":"ዎምባን ዶልያ ሎኦ ጪሻ ማላ” ያጋዱ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ኤ ታ ሲቃታ ማጫ አሳ ግዶን ጼልያ ዎደ፥","poem":1},{"text":"አጉን ግዶን ቤትያ ሎኦ ጪሻ ማላታዉ ያጌዳ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታ ሲቁ ሀራ ዎዳላቱዋ ግዶን ጼልያ ዎደ፥","poem":1},{"text":"ዎራን ደእያ አፕልያ ግያ ም ማላቴ፤","poem":2},{"lineBreak":true},{"text":"ታና ሎይ ናሸችና፥ አ ኩዋ ግዶን ኡታድ፤","poem":2},{"lineBreak":true},{"text":"አ አይፊ ሚና፥ ታና ሎይ ማልኤ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እ ታና ቁማ ምያ አኮ ዉይግያ ገልሴዳ፤","poem":1},{"text":"ባረ ሲቁዋ ባንድራዳን ታ ቦላ ቁ ቁ ኦዳ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ታን አ ሲቁዋን ኦከታደ ሀርጌዳ ድራዉ፥","poem":1},{"text":"ዛቢብያ አይፍያ ታና ምዚደ ምንስተ፤","poem":2},{"lineBreak":true},{"text":"አፕልያ ታና ምዚደ፥ ታ ዎልቃ ኩንተ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ባረ ሀድርሳ ኩሽያ ታና ቦርኮትሴዳ፤","poem":1},{"text":"ባረ ኡሸቻ ኩሽያን ታና ቆሜዳ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ህንተኖ የሩሳላመ ያላጋ ማጫ አሳዉ፥","poem":1},{"text":"ሲቁ ባረዉ ዶሲደ ደንዳና ጋካናዉ፥","poem":2},{"lineBreak":true},{"text":"አ ህንተ ቤጎና ማላ፥","poem":2},{"lineBreak":true},{"text":"ታን ህንተና ገንኤቱዋንነ ባዙዋ ዶገቱዋን ጫላይ።","poem":2}]},{"type":"heading","content":["ሲቁ ኡባ የዉዋ ሎይ"]},{"type":"verse","number":8,"content":[{"text":"ስስተ፥ ሄዌ ታ ሲቁዋ ኮሻ! በእተ ደርያና ፕሪደ፥","poem":1},{"text":"ዞዘቱዋ ቦላና ጾንገቲደ ጋኬዳ!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ታ ሲቁ ዉሻ ማላ፤ ዎይ ገንእያ ማራ ማላቴ።","poem":1},{"text":"በእተ፥ እ ኑ ጎልያ ድርሳ ማታን ኤቄዳ፤","poem":2},{"lineBreak":true},{"text":"ማስኮትያና ጎለ ጼሌ፤","poem":2},{"lineBreak":true},{"text":"ጋርዱዋ ጋርሳናካ ሉጻይ ጼሌ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ ሲቁ ታና ሀዋዳን ያጌ፤ ታ ሲቃቴ፥ ደንዳ!","poem":1},{"text":"ታ ማላንቻቴ፥ ሃያ! እትፐ አነ ቦይተ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"በአ፥ ባልጉ አዳ፤ እራይካ ኤቄዳ።","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ቢታን ጪሻይ ጪሼዳ፤ የ የጽያ አግናይካ ጋኬዳ፤","poem":1},{"text":"ሀራጵያ የይ ኑ ቢታን ስሰቴ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ባላሲ አይፍያ ዶሜዳ፤ ዎይኒ ጪሼዳ፤","poem":1},{"text":"አ ጪሻ ሳዉ ቢታን ቶሹኩ ጌ።","poem":2},{"lineBreak":true},{"text":"ሄዋ ድራዉ፥ ታ ሲቃቴ፥ ደንዳ፤ ታ ማላንቻቴ፥ ሃያ፤","poem":2},{"lineBreak":true},{"text":"አነ እትፐ ቦይተ ያጌ ያጋዱ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኔን አፉዋ ዶና ዛላ ዛአን ቆሰቴዳ ሀራጳት ማላ፤","poem":1},{"text":"አነ እት ገደ ታና ነ ሶምኡዋ በሳ፤ ነ ኮሻካ ስሳ።","poem":2},{"lineBreak":true},{"text":"አያዉ ጎፐ፥ ነ ኮሻይ ታና ቃረ፤","poem":2},{"lineBreak":true},{"text":"ነ ሶምኡካ ዳሮ ሎኤ ያጌዳ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኑ ዎይኒ ጪሼዳ፤ ሄዋ ድራዉ፥","poem":1},{"text":"ኑ ዎይንያ ግዱዋ ባይዝያ ዎራካናቱዋ፥","poem":2},{"lineBreak":true},{"text":"ሄ ቄር ዎራካናቱዋ ጲርያ ዎደ ኦይቂተ ያጌድኖ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታ ሲቁ ታዋ፤ ታንካ አኖ፤","poem":1},{"text":"ጪሻ ግዶን እ ባረ ዉድያ ሄሜ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ቃማ ማይ ቃረታናዉ፥ ዎንታ ጫርኩ ጫርካናዉ፥","poem":1},{"text":"ታ ሲቆዉ፥ ገንእያዳን ዎይ ያላጋ ዶግያዳን፥","poem":2},{"lineBreak":true},{"text":"አፎትያ ደርያና ዎጻደ ሃ ስማ ያጋዱ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}