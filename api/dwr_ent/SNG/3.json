{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"SNG","translationId":"dwr_ent","name":"ሲቁዋ ሳባ","commonName":"ሲቁዋ ሳባ","title":"ሲቁዋ ሳቢያ ማጻፋ","order":22,"numberOfChapters":8,"sha256":"da2534ceb2a630388d630250d5306f1486fb13eb9c067365c76890c927377d03","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/dwr_ent/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"ቃማ ኩመን ታ ሂጻን ግሳደ፥","poem":1},{"text":"ታ ሲቁዋ ደማናዉ አሞታድ፤ ምንሳደ ኮያድ፤","poem":2},{"lineBreak":true},{"text":"ሽን ደማናዉ ዳንዳያበይከ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ካታማ ግዶን ደእያ አኮነ ጹን ኦገቱዋ ኡባን ዩያድ፤","poem":1},{"text":"ታ ሲቁዋ ደማናዉ ኮያድ፤ ምንሳደ ኮያድ፤","poem":2},{"lineBreak":true},{"text":"ሽን ደማናዉ ዳንዳያበይከ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ካታማ ዩይ ናግያዋንቱ ታና ደሜድኖ፤","poem":1},{"text":"ታንካ፥ ታ ሲቁዋ በኤድቴ? ያጋደ ኡንቱንታ ኦቻድ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኡንቱንቱፐ ያ አነ ታ ሲቁዋ ደማ አጋድ።","poem":1},{"text":"እ ታፐ ከስ አከናዳን፥ ምንሳደ ኦይቃድ፤","poem":2},{"lineBreak":true},{"text":"ታ ዳይ ጎለ አካ አፋድ፤ ታ የለቴዳ ክፍልያ ገልሳድ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ህንተኖ የሩሳላመ ያላጋ ማጫ አሳዉ፥","poem":1},{"text":"ሲቁ ባረዉ ዶሲደ ደንዳና ጋካናዉ፥","poem":2},{"lineBreak":true},{"text":"አ ህንተ ቤጎና ማላ፥","poem":2},{"lineBreak":true},{"text":"ታን ህንተና ገንኤቱዋንነ ባዙዋ ዶገቱዋን ጫላይ ያጋዱ።","poem":2}]},{"type":"heading","content":["ሶይዙዋባ"]},{"type":"verse","number":6,"content":[{"text":"ሀዌ ባዙዋና ይያዌ፥ ጩዋ ቱሳ ማላትያዌ፥","poem":1},{"text":"ፔኑካ ዛልአንቻ እጻናዳንነ ካዋራዳን፥","poem":2},{"lineBreak":true},{"text":"ሳዊያዌ እ ኦኔ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሄዋ በእተ፥ ሶሎሞና ፓራ ጋሪ ዬ፤","poem":1},{"text":"ሄ ፓራ ጋሪ እስራኤልያፐ ዶረቴዳ ዎልቃማቱ፥","poem":2},{"lineBreak":true},{"text":"ኡሱፑን ታሙ ቶራንቻቱ አጃቤድኖ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኡንቱንቱ ኡባይካ ማሻ ኦይቀ ሜዘቴዳዋንታነ፥","poem":1},{"text":"ኦላንካ ፓጨቴዳዋንታ።","poem":2},{"lineBreak":true},{"text":"ቃማን ጋካና መቱዋ ኤቀታናዉ፥","poem":2},{"lineBreak":true},{"text":"ኡንቱንቱ እቱ እቱ ማሻ ግጺደ ጊጌዳዋንታ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ካትያ ሶሎሞን ፓራ ጋርያ ግዶን፥","poem":1},{"text":"ባረዉ ኡትያ ካዉተ አራታ ጊግሴዳ።","poem":2},{"lineBreak":true},{"text":"እ አራታ ሊባኖሳ አሳፐ አሄዳ ምፐ ኦስሴዳ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አራታ ቱሳቱ ብራን ሼሸቴድኖ፤","poem":1},{"text":"ገዲ ዎርቃን አሌቀቴዳ፤","poem":2},{"lineBreak":true},{"text":"ኡትያሳይ የሩሳላመ ዎዶራቱ ኦቻ ቴራ ማላትያ ቃጭናን፥","poem":2},{"lineBreak":true},{"text":"ሲቁዋን ዳዴዳ አፍላን ካመቴዳ ያጌድኖ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ህንተኖ፥ ጽዮነ ዎዶራቶ፥ ካትያ ሶሎሞና በአናዉ ሃይተ!","poem":1},{"text":"እ ሎይ ናሸቴዳ፥ አ ቡላቻ ጋላስ አ አታ አ ሁጲያን፥","poem":2},{"lineBreak":true},{"text":"ዎዳ ካላቻ ዎደ ኡቴዳ ያጋዱ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}