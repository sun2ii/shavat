{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"SNG","translationId":"dwr_ent","name":"ሲቁዋ ሳባ","commonName":"ሲቁዋ ሳባ","title":"ሲቁዋ ሳቢያ ማጻፋ","order":22,"numberOfChapters":8,"sha256":"da2534ceb2a630388d630250d5306f1486fb13eb9c067365c76890c927377d03","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/dwr_ent/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"ታ ሲቃቴ፥ ኔን አያ ማላንቻቲ! ኔን ዎታ ሎአይ!","poem":1},{"text":"ነ አይፈቱ ነ ሶምኡዋ ካምያ ሻርበ ግዱዋና በእያ ዎደ፥","poem":2},{"lineBreak":true},{"text":"ሀራጵያዳን ሎኢኖ።","poem":2},{"lineBreak":true},{"text":"ነ ብናናይ ጋላኣደ ደርያፐ ዎያ ዴሻ ዉድያ ማላ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ነ አቻይ ሜደቲደ፥ ሃን ሜጨቴዳ ኡባይካ ማንትያ የልያ፥","poem":1},{"text":"ኡንቱንቱ ግዶን ማይኒ ባይና ዶርሳ ዉድያ ማላ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ነ መተርሻቱ ዞኦ ቃጭና ማላ፤","poem":1},{"text":"ነ ሃሳይያ ዎደ ዳሮ ናሸቺኖ።","poem":2},{"lineBreak":true},{"text":"ነ ላኡ ጋጮቱዋ ሻርቢያ ግዱዋና ጼልያ ዎደ፥","poem":2},{"lineBreak":true},{"text":"እት ሮማንያ ላኡ ከስ ጳልቄዳዋ ማላቲኖ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ነ ቆ ኦላ ሚሻ ካቃናዉ ግምቤዳ፥","poem":1},{"text":"ዳዊታ አዱሳ ግምቢያ ማላቴ፤","poem":2},{"lineBreak":true},{"text":"ሄ ግምቢ ሻኡ ምኖ ኦላንቻቱዋ ጎንዳሊ ካቀትና፥","poem":2},{"lineBreak":true},{"text":"አሌቀት ኡቴዳ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ነ ንቱ ማንትያ የለቴዳ፥","poem":1},{"text":"ዎራ ጪሻ ግዶን ምያ ገንእያ ማራቱዋ ማላቲኖ።","poem":2}]},{"type":"heading","content":["ሶይዙዋ እትፐተ"]},{"type":"verse","number":6,"content":[{"text":"ቃማይ ዎንታናዉ፥ ኩዋይ ክቻናዉ፥","poem":1},{"text":"ካርቢያ ደርያነ እጻና ዞዝያ ባደ ሸምፓሻና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታ ሲቃቴ፥ ነ አሳተይ ኡባይካ ማላንቻ፤","poem":1},{"text":"ኔናን ዎያዌ አያይነ ባዋ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ታ ሙሹራቴ፥ ሊባኖሳ ደርያፐ ዎ።","poem":1},{"text":"ጋሙነ ማሂ ጌሱ አማና ደርያፐ፥","poem":2},{"lineBreak":true},{"text":"ሳኒራ ደርያፐነ ሄርሞነ ኪክያፐ ዎ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ታ ሲቁዋ ምቻቶ ግድያ ታ ሲቃቴ!","poem":1},{"text":"ነ አይፍያ ጼሉነ ነ ቆያ አሌቁ፥","poem":2},{"lineBreak":true},{"text":"ታ ዎዛና ናሸቻን ጎሼዳ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ ሲቁዋ ምቻቶ ግድያ ታ ሙሹራተ!","poem":1},{"text":"ነ ሲቁ ታና አያ ናሸቺ!","poem":2},{"lineBreak":true},{"text":"ነ ሲቁ ዎይንያ ኤሳፐ አ ናሸቼ፤","poem":2},{"lineBreak":true},{"text":"ነ ሽቱ ኡባባፐካ አደ ሳዌ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ ሙሹራቴ፥ ነ መተርሻና ኤሳ እልሉ ጾኬ።","poem":1},{"text":"ነ ዶናፐ ኤሳይነ ማይ ፑልቴ፤","poem":2},{"lineBreak":true},{"text":"ነ ማዩ ሊባኖሳ ጺዳይ ሳዊያዋዳን ሳዌ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታ ሲቁዋ ምቻቶ ግድያ ታ ሙሹራት ዩሹ፥","poem":1},{"text":"ድረቲደ ናገትያ አታክልትያ ሳኣ ማላ።","poem":2},{"lineBreak":true},{"text":"ዩሹ ግምበቴዳ ፑልቱዋ፥","poem":2},{"lineBreak":true},{"text":"ማታፋይ አታመቴዳ ጎግያ ሃ ማላ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ነ አታክልተቱዋ ግዶን: ሮማኒ፥","poem":1},{"text":"ዶረቴዳ አታክልትያ አይፈቱ፥","poem":2},{"lineBreak":true},{"text":"ሄናይነ ናርዶስያ ግያዋንቱ ደኢኖ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሄዋዳንካ ቃይ ናርዶሲ፥","poem":1},{"text":"ላዲ፥ ሳዉዋ ማታይነ ቃራፋይ፥","poem":2},{"lineBreak":true},{"text":"ሄዋዳንካ እጻናዳን ሳዊያባቱ ደኢኖ፤","poem":2},{"lineBreak":true},{"text":"ሄዋዳንካ ቃይ ካርቢ፥","poem":2},{"lineBreak":true},{"text":"ጎዳረ ኡ ጪሻይነ ዱማ ዱማ ቅማምያ አታክልተቱ ሞኪኖ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኔን አታክልትያ ሳኣ አልያ ፑልቱዋ ማላ፤","poem":1},{"text":"ደኡዋ ሃይ ቤትያ ኦላ ማላ፤","poem":2},{"lineBreak":true},{"text":"ሊባኖሳ ደርያፐ ጎግያ ሻፋ ማላ ያጌዳ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሁጲሳ ባጋ ጫርኮ፥ ደንዳ!","poem":1},{"text":"ገድሳ ባጋ ጫርኮ፥ ሃያ!","poem":2},{"lineBreak":true},{"text":"ታ አታክልትያ ቦላ ጫርካ! አ ሳዉ ሄዋን ቶሹኩ ጎ።","poem":2},{"lineBreak":true},{"text":"ታ ሲቁ ባረ አታክልትያ ግዶ ዮ።","poem":2},{"lineBreak":true},{"text":"ዳሮ ማልእያ ቴራቱዋ ሞ ያጋዱ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}