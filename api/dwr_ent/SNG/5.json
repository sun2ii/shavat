{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"SNG","translationId":"dwr_ent","name":"ሲቁዋ ሳባ","commonName":"ሲቁዋ ሳባ","title":"ሲቁዋ ሳቢያ ማጻፋ","order":22,"numberOfChapters":8,"sha256":"da2534ceb2a630388d630250d5306f1486fb13eb9c067365c76890c927377d03","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/dwr_ent/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"ታ ሲቆ ምቻቶ ግድያ ታ ምሽራተ፥","poem":1},{"text":"በአ፤ ታን ታ አታክልትያ ግዶ ገላድ።","poem":2},{"lineBreak":true},{"text":"ታ ካርቢያነ ታ ሽቱዋ ጪሻ ቆራይ።","poem":2},{"lineBreak":true},{"text":"ኤሳ ኡክ ዮልታያደ ማይ።","poem":2},{"lineBreak":true},{"text":"ታ ዎይንያ ኤሳነ ታ ማ ኡሻይ ያጌዳ።","poem":2},"የሩሳላመ ዎዶራቱ:",{"text":"ህንተኖ፥ አ ላገቶ፥ ሲቁዋ አላና ጋካናዉ ኡሽተ ያጌድኖ።","poem":1}]},{"type":"verse","number":2,"content":[{"text":"ታን ቃማ ገምእሻድ፤ ሽን ታ ዎዛናይ ቤጎት ኡቴዳ።","poem":1},{"text":"ታ አኩሙዋን ታ ሲቁ ሀዋዳን ያጊደ፥","poem":2},{"lineBreak":true},{"text":"ፐንግያ ቆጺና ስሳድ፤ ታ ሙሹራቴ፥ ታ ሲቃቴ፥","poem":2},{"lineBreak":true},{"text":"ኔናን ዎያዌ ባይና ታ ሀራጳተ፥ ታዉ ካርያ ዶያ፤","poem":2},{"lineBreak":true},{"text":"ታ ሁጲ ከተርሳን ካኤዳ።","poem":2},{"lineBreak":true},{"text":"ታ ብናናይካ ቃማ ፑስያን ናርካኬዳ ያጌ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታን፥ ታ ማዩዋ ቃራ ድጋድ፤ ዛራ ማዮየ?","poem":1},{"text":"ታ ገድያ ሜጨታ ክቻድ፤ ዛራደ ኡርቃዮየ? ያጋድ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታ ሲቁ እፍ ጾእያና ባረ ኩሽያ ጎለ የዴዳ፤","poem":1},{"text":"ታ ዎዛናይ አ ድራዉ ፖድ ፖዴ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ያትና፥ ታ ሲቆ ካርያ ዶያናዉ ደንዳድ።","poem":1},{"text":"ካርያ ዶይያ ኩልቡዋ ታን ኦይቂያ ዎደ፥","poem":2},{"lineBreak":true},{"text":"ታ ኩሽያፐ ካርቢ፥ ታ ብራያፐ ሽቱ ጾኬ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታ ሲቆ ካርያ ዶያድ፤ ሽን ዶይያ ዎደ እ ባዋ ብ ክቼዳ።","poem":1},{"text":"አ ኮሻ ስሳናዉ ሎይ አሞታድ።","poem":2},{"lineBreak":true},{"text":"ምንደ አ ኮያድ፤ ሽን ደማናዉ ዳንዳያበይከ።","poem":2},{"lineBreak":true},{"text":"ጼጋድ፤ ሽን ታዉ ኮይቤና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዩዪደ ካታማ ናግያዋንቱ ታና ደሚደ፥","poem":1},{"text":"ዋድኖነ ማዱድኖ፤","poem":2},{"lineBreak":true},{"text":"ካታማ ድርሳ ናግያዋንቱ ታ ቁማዩዋ ቃር አኬድኖ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ህንተኖ የሩሳላመ ጌላዮቶ፥ ታ ሲቁዋ ደሞፐ፥","poem":1},{"text":"ታን አ ሲቁዋፐ ደንዴዳዋን ሀርግያዋ፥","poem":2},{"lineBreak":true},{"text":"ሀዳራ፥ አዉ ኦድተ ያጋዱ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኔኖ፥ ማጫ አሳ ኡባፐ አዳ ማላንቻቴ!","poem":1},{"text":"ነ ሲቁ ቱሙ ሀራቱዋፐ ዋን ዱማቲ?","poem":2},{"lineBreak":true},{"text":"ኔን ሀዋ ኬሻ ኑና ጫልያዌ፥","poem":2},{"lineBreak":true},{"text":"እ ሀራቱዋፐ ዱማትያዌ አያኔ? ያጌድኖ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ ሲቁ ዳሮ ሎእያዋነ ምና፤","poem":1},{"text":"ታሙ ሻኡ አቱማ አሳ ግዶን አ ማል ባዋ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አ ሁጲ ዎርቃ ሉልያ ማላቴ፤","poem":1},{"text":"አ ብናናይካ ሎአነ ቁሩዋ ማላ ካረ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አ አይፊ ሻፋ ላንቂያን ኤቄዳነ፥","poem":1},{"text":"ማን ሜጨቴዳዋ ማላትያ ሀራጰቱዋ ማላቴ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አ ጋጮቱካ ሳዉዋ ማታይነ፥","poem":1},{"text":"ቅማሚ ቶከቴዳ አታክልትያዳን ሎኢኖ፤","poem":2},{"lineBreak":true},{"text":"አ መተርሻቱ ካርቢያ ሽቱ ጾክያ ዎራ ጪሻዳን ሎኢኖ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አ ኩሸቱ እንቁዋን አሌቀቴዳ ዎርቃ ጻምኣዳን ሎኢኖ፤","poem":1},{"text":"አ አሳተይ ሳምፔርያ ግያ እንቁዋን አሌቀቴዳ፥","poem":2},{"lineBreak":true},{"text":"ዳንጋርሳ አቻ ማላ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አ ገደቱ ዎርቃ ባሱዋን ቶከቴዳ፥","poem":1},{"text":"እብናባራድያ ቱሳ ማላቲኖ፤","poem":2},{"lineBreak":true},{"text":"አ ማላይ ዝጋን አሌቀቴዳ ሊባኖሳ አሳ ማላ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አ ዶናይ ኤሳዳን ማልኤ። እ ኡባናካ ሎእያዋ።","poem":1},{"text":"ህንተኖ የሩሳላመ ዎዶራቶ፥","poem":2},{"lineBreak":true},{"text":"ታ ሲቁነ ታ ላጊ ሀዋ ማላቴ ያጋዱ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}