{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"SNG","translationId":"dwr_ent","name":"ሲቁዋ ሳባ","commonName":"ሲቁዋ ሳባ","title":"ሲቁዋ ሳቢያ ማጻፋ","order":22,"numberOfChapters":8,"sha256":"da2534ceb2a630388d630250d5306f1486fb13eb9c067365c76890c927377d03","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/dwr_ent/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"heading","content":["ሲቁ ኡባፐ ዶረቴ"]},{"type":"verse","number":1,"content":[{"text":"ማጫ አሳ ኡባፐ ማላንቻቴ!","poem":1},{"text":"ነ ላጊ ሀቃ ቤዴ? ኑንካ ኔናና እትፐ ኮያናዉ፥","poem":2},{"lineBreak":true},{"text":"እ ቤዳ ሳ ኑዉ ኦዳ ያጌድኖ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታ ሲቁ ዶርሳ ዉድያ ሄማናዉነ፥","poem":1},{"text":"ሎእያ ጪሻ ሺሻናዉ፥","poem":2},{"lineBreak":true},{"text":"ሽቱዋ ሳዉዋ ማታይ ደእያ አታክልትያ ግዶ ዎዳ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታን ታ ሲቁዋኖ፤ ታ ሲቁካ ታዋ።","poem":1},{"text":"እ ጪሻ ግዶን ዉድያ ሄሜ ያጋዱ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታ ሲቃቴ! ኔን ትርጻ ካታማይ ሎእያዋዳን ሎኣሳ፤","poem":1},{"text":"የሩሳላመዳን ዳሮ ሎኣሳ፤ ባንድራ ኦይቂደ፥","poem":2},{"lineBreak":true},{"text":"ሳልፕያን ብያ ኦላንቻይ ያሽያዋዳን ያሻሳ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሀያና ነ አይፍያ ታፐ ዎራ ዛራርኪ፥","poem":1},{"text":"አያዉ ጎፐ፥ ኡንቱንቱ ታና ዋይሲኖ።","poem":2},{"lineBreak":true},{"text":"ነ ብናናይ ጋላኣደ ደርያፐ ዎያ ዴሻ ዉድያ ማላቴ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ነ አቻይ ሜጨቲደ ከስያ፥ ኡባይካ ማንትያ የልያ፥","poem":1},{"text":"ኡንቱንቱ ግዶን ማይኒ ባይና ዶርሳ ዉድያ ማላ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ነ ላኡ ጋጮቱዋ ሻርቢያ ግዱዋና ጼልያ ዎደ፥","poem":1},{"text":"ላኡ ከሴዳ ሮማንያ ቴራ ማላቲኖ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኡሱፑን ታሙ ማጫ ካተቱነ ኡሱፑን ታሙ ባኮቱ፥","poem":1},{"text":"ቃይ ፓይዱ ባይና ዎዶሮቱ ታዉ ደኢኖ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሽን ታ ሀራጳታ፥ ታ ቶሺ ባይናና፥ አ ታዉ ዱማ።","poem":1},{"text":"አ ባረ አትስካ መጽ እትኖ፤","poem":2},{"lineBreak":true},{"text":"እዞ የሌዳ አታካ አያፐነ አደ እዞ ሲቃዉ።","poem":2},{"lineBreak":true},{"text":"ዎዶሮቱካ እዞ ጼሊደ፥ ሀና አንጀቴዳኖ ያጊኖ።","poem":2},{"lineBreak":true},{"text":"ማጫ ካተቱካ ባኮቱካ እዞ ሳቢኖ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሀና ዎንታ ጻልቂያዳን ዶልያና፥ አግናዳን ፖእያና፥","poem":1},{"text":"አዋዳን ጫድያና፥ ባንድራ ኦይቂደ ሳልፕያን ብያ ኦላንቻዳን፥","poem":2},{"lineBreak":true},{"text":"ያሽያና እዛ ኦኔ? ያጊኖ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታን ዎምባን ቶከቴዳ ምቱ ልጩዋ በአናዉ፥","poem":1},{"text":"ዎይንያ ቱራይ አጬደንቶነ ቃይ ሮማኒካ ጪሼደንቶነ ጼላናዉ፥","poem":2},{"lineBreak":true},{"text":"ዱገ አታክልትያ ሳኣ ዎይ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታን አኬከናን ደእሺና፥ ታ አሙ ታና አፊደ፥","poem":1},{"text":"ታ ካትያ ማታን፥ ፓራ ጋርያን ታና ኡትሴዳ ያጌዳ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኔኖ ሹላመ ቢታፐ ዬዳዉነ፥ ሃያ፤","poem":1},{"text":"ሃ ስማ! ኔና ኑ ሎይደ ጼላና፤ ሃ ስማ! ያጌድኖ።","poem":2},"ወዶራታ:",{"text":"ዳሮ አሳ ስንን የጽያ አሳዳን፥ ታኮ አያዉ ጼሊቴ? ያጋዱ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}