{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"SNG","translationId":"dwr_ent","name":"ሲቁዋ ሳባ","commonName":"ሲቁዋ ሳባ","title":"ሲቁዋ ሳቢያ ማጻፋ","order":22,"numberOfChapters":8,"sha256":"da2534ceb2a630388d630250d5306f1486fb13eb9c067365c76890c927377d03","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/dwr_ent/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"ካትያ ናትዳን ሎእያኔ!","poem":1},{"text":"ነ ገደቱ ኔን ናጻላ ጫማ ዎ ደእሽን በእያ ዎደ፥","poem":2},{"lineBreak":true},{"text":"አያ ሎኢኖ! ነ ሼቺ ኤራንቻ ዎጋጪ ቆጺደ፥","poem":2},{"lineBreak":true},{"text":"ሎይ አሌቂሴዳ እንቁዋ ማላቴ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ነ ጉልአይ ዎይንያ ኤሳይ ኩሜዳ ብርልያ ማላቴ፤","poem":1},{"text":"ነ ጼሳ ዩሹ ጪሻን ቃሸቴዳ ዛርጋ ምርቂያ ማላቴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ነ ንቱ ማንትያ የለቴዳ፥ ገንአት ማራቱዋ ማላቲኖ።","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ነ ቆ ዳንጋርሳ ዛልያን አሌቀቴዳ አዱሳ ግምቢያ ማላ።","poem":1},{"text":"ነ አይፊ ዎልቃማ ሀሰቦና ካታማ ፐንግያ ማታን ደእያ፥","poem":2},{"lineBreak":true},{"text":"ዜሩዋ ሃ ማላቴ።","poem":2},{"lineBreak":true},{"text":"ነ ሲ ዳማስቆ ጼልሲደ ግምቤዳ ሊባኖሳ ግምቢያ ማላቴ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ነ ሁጲ ቃርመሎሳ አሳ ማላቴ፤","poem":1},{"text":"ነ ኦላሳ ብናናይ ቃጭና ጻ ማላቴ፤","poem":2},{"lineBreak":true},{"text":"ካትያካ ነ ሁጲያ ዳይ ናሸቼዳ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታ ሲቃቴ፥ ነ አያ ሎአይ! ነ አያ ማላንቻቲ!","poem":1},{"text":"ነ ሲቁ ታና አያ ናሸቺ!","poem":2}]},{"type":"heading","content":["ታንነ ኔንነ ጻላላይ"]},{"type":"verse","number":7,"content":[{"text":"ነ ጌሳይ ዛምባ ጌሳ ማላቴ።","poem":1},{"text":"ነ ንይ ዛምባ አይፍያ ዉርጩዋ ማላቴ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታን፥ ሀ ዛምባ ግአና፤ አ ማራቱዋ ኦይቃና ያጋድ።","poem":1},{"text":"ነ ንይ ዎይንያ ቴራ ዉርጩዋ ማላ፤","poem":2},{"lineBreak":true},{"text":"ቃይ ነ ሲያና ከስያ ፔኑ አፕልያ አይፍያዳን ሳዌ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ነ የሩ መተርሻቱዋፐነ አቻፐ ግዱዋና፥","poem":1},{"text":"ዋላላቲደ ገልያ ዎይንያ ማላ፥","poem":2},"ወዶራታ:",{"text":"ኡባፐ አደ ማልእያ","poem":1},{"text":"ዎይንያ ኤሳ ማላ ያጌዳ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታን ታ አልኦ ሲቁዋኖ፤ እካ ታና አሞቴ።","poem":1}]},{"type":"verse","number":11,"content":[{"text":"ታ ሲቆዉ፥ ሃያ፤ ላኡ ካታማፐ ከሲደ ቢደ፥","poem":2},{"lineBreak":true},{"text":"ጋጻርያን አቆይተ፤ ቃማ ላኡ ሄዋን አና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዎንታ ጉራን አነ ዎይንያ ቱራ ግዶ ቦይተ፤","poem":1},{"text":"ዎይንያ ቱራይ ጪሼደንቶ፥ ጪሺደ አይፍያ ዶርጾጼደንቶነ፥","poem":2},{"lineBreak":true},{"text":"ቃይ ሮማኒካ አይፌደንቶ አነ በኦይተ።","poem":2},{"lineBreak":true},{"text":"ታን ታ ሲቁዋ ኔና ሄዋን በሳና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እንኮይያ አይፍያ ሳዉነ ሀራ ናሸችያ አታክልትያ አይፊ፥","poem":1},{"text":"ኑ ካረን በሴዳ፤ ታ ሲቆ!","poem":2},{"lineBreak":true},{"text":"ሀ አይፈቱዋፐ ቴሬዳዋንታነ ኦራ ማጼዳዋንታ፥","poem":2},{"lineBreak":true},{"text":"ነዉ አሻ ዎድ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}