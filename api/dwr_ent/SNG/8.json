{"translation":{"id":"dwr_ent","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrENT","licenseNotes":null,"shortName":"ENT","englishName":"Dawro Bible (Ethoipic script)","language":"dwr","textDirection":"ltr","sha256":"6129c840c68e57f407224332825021c4420edcffee976508477c04f57aa35874","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ent/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"SNG","translationId":"dwr_ent","name":"ሲቁዋ ሳባ","commonName":"ሲቁዋ ሳባ","title":"ሲቁዋ ሳቢያ ማጻፋ","order":22,"numberOfChapters":8,"sha256":"da2534ceb2a630388d630250d5306f1486fb13eb9c067365c76890c927377d03","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ent/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/dwr_ent/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"ነ ታዉ አላጋ ግደናን ታ ዳይ ን ሜዳ ታ እሻ ግዳርኪሻ!","poem":1},{"text":"ያትንቶ ታን ኔና ኦግያን ደማደ ሺሻ አካ የርና፥","poem":2},{"lineBreak":true},{"text":"ታና ኦንነ ቦረናሽን።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታና ታማርሴዳ ታ ዳይ ጎለ ታን ኔና ካለደ፥","poem":1},{"text":"ታ ዳይ ቆልኦ ገልሳ አግና፥","poem":2},{"lineBreak":true},{"text":"ሄዋን ታና ነ ሲቁዋባ ታማርሴዳዋ ግዳርኪ፤","poem":2},{"lineBreak":true},{"text":"ሮማንያ ጉምኤዳ ማልእያዋ፥","poem":2},{"lineBreak":true},{"text":"ሎእያ ዎይንያ ኤሳ ታን ኔና ሄዋን ኡሻርክታ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታና ሄዋን ነ ሀድርሳ ቄስያ ቦርኮትሳደ፥","poem":1},{"text":"ነ ኡሸቻ ኩሽያን ታና ቆሜዳዋ ግዳርኪ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ህንተኖ የሩሳላመ ዎዶራቶ፥","poem":1},{"text":"ሲቁ ባረ ዎድያን ደንዳናዉ፥ ቃሰ ደንናዳን፥","poem":2},{"lineBreak":true},{"text":"ታ ህንተዉ ሀዳራ ጋይ ያጋዱ።","poem":2}]},{"type":"heading","content":["ሲቁዋ ሳባ"]},{"type":"verse","number":5,"content":[{"text":"ባረ ሲቁዋ ሀሽያን ዘምፓደ፥","poem":1},{"text":"ባዙዋፐ ይያና ሀና ኦኔ? ያጌድኖ።","poem":2},"ወዶራታ:",{"text":"በን ነ አታ ኔና ባንካ የሌዳ፥","poem":1},{"text":"አፕልያ ላንቂያን ነ ግሳ ደእሽን፥","poem":2},{"lineBreak":true},{"text":"ኔና ታ ቃሰረደ ደንድ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"መና ሲቁዋን ታና ነ ዎዛና ቦላ አታማ፤","poem":1},{"text":"ነ ቀስያንካ ማታፋዳን፥ ታ ጻላላ ኦይቃ።","poem":2},{"lineBreak":true},{"text":"አያዉ ጎፐ፥ ሲቁ ሀይቁዋ ማላ ምና፤","poem":2},{"lineBreak":true},{"text":"ምሹካ ዱፉዋ ማላ መቀ ኢታ፤","poem":2},{"lineBreak":true},{"text":"አ ላጩካ ጾሳ ታማ ላጩዋ ማላ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሃ ዳሩ ሲቁዋ ታማ ቶይሳናዉ ዳንዳየና፤","poem":1},{"text":"ድኡካ ሜጪደ አፋናዉ ዳንዳየና።","poem":2},{"lineBreak":true},{"text":"አሳይ ሲቁዋ ሻማናዉ ባረዉ ደእያ አቁዋ ኡባ እሞፐካ፥","poem":2},{"lineBreak":true},{"text":"ሲቁ ሻሉዋን ሻመተና ድራዉ፥","poem":2},{"lineBreak":true},{"text":"አሳይ ሄዋ ካ ያጋዱ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኑዉ ትራን ንይ ኡትቤና ምቻታ ደአዉ፤","poem":1},{"text":"አስናይ እዞ ኦቾፐ፥ ኑን እዉ ኦናዌ አዬ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እዛ ግምቢያ ድርሳ ግድንቶ፥ ኑን እ ቦላ ዎችያ አዱሳ፥","poem":1},{"text":"ብራ ግምቢያ ግምባና፤ አ ድርሳ ፐንገ ግድንቶ፥","poem":2},{"lineBreak":true},{"text":"ዝጋ ሳንቃን እዞ ዶድሳና ያጌድኖ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሄኮ ታን ድርሳ ግምቢያ፤","poem":1},{"text":"ታ ንይካ ግምቢያ ቦላ ግምበቴዳ ዎችያ ሳ፤","poem":2},{"lineBreak":true},{"text":"ሄዋ ድራዉ፥ ታን ታ ሲቁዋና ደእያ ዎደ፥ እ ታናን ናሸቴ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሶሎሞነዉ ባኣል-ሀሞናን ዎይኒ ቶከቴዳ ሾይቃይ ደኤ፤","poem":1},{"text":"ሄ ዎይንያ ግዱዋ ኦያዋንቶ ከራ እሜዳ።","poem":2},{"lineBreak":true},{"text":"ከራ አኬዳዋንቱ ቴራን ጎኤቴዳዋ ድራዉ፥","poem":2},{"lineBreak":true},{"text":"ሁጲያን ሁጲያን ሻኡ ብራ አዉ አሂኖ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሽን ታዉ ታ ቡዞ ዎይኒ ቶከቴዳ ሾይቃይ ደኤ፤","poem":1},{"text":"ሶሎሞና፥ ኔን ሻኡ ብራ አካ፤","poem":2},{"lineBreak":true},{"text":"አታክልትያ ኦያዋንቱ ላኡ ጼቱ ብራ አክኖ ያጋዱ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኔኖ፥ አታክልትያ ግዶን ደእያ ታ ሲቃቴ፥","poem":1},{"text":"ነ ኮሻ ላገቱዋ ስሳናዉ ኮዪኖ፤","poem":2},{"lineBreak":true},{"text":"ነ ኮሻ ታና ስሳ ያጌዳ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታ ሲቆዉ፥ ታኮ ኤለካ ሃያ!","poem":1},{"text":"ሳዊያ ማታይ ሞክያ ደረቱዋ ቦላና፥","poem":2},{"lineBreak":true},{"text":"ጉፕያ ገንእያ ዎይ ዶግያ ማራቱዋ ማላታደ ያጋዱ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ent/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ent/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ent/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}