{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"2SA","translationId":"dwr_ltw","name":"2 Sammeela","commonName":"2 Sammeela","title":"Laa'entso Sammeela Mas'aafaa","order":10,"numberOfChapters":24,"sha256":"9ace245922c8bbd0a2b90ea0ae48674eaa0c74054255c4296fe3e029e9275a88","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/dwr_ltw/2SA/24.json","totalNumberOfVerses":692},"chapter":{"number":22,"content":[{"type":"heading","content":["Daawite S'ooni Simmiide Yes's'eedda Yetsaa"]},{"type":"verse","number":1,"content":["Med'inaa Goday Aa morkkatuwaa ubbaa kushiyaappenne Saa'oola kushiyaappe ashsheeda gallassi Daawite Med'inaa Godaw ha yetsaa yes's'eedda."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«Med'inaa Goday taw wogga zaallaa;","poem":1},{"text":"Taani ollaappe naagettiyaa miis'aa;","poem":2},{"text":"I taana ashshiyaawaa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ta S'oossay taani aakko bak'atiyaa ta wogga zaallaa.","poem":1},{"text":"I ta gonddalliyaa;","poem":2},{"text":"I taana ashshiyaa wolk'k'aama.","poem":1},{"text":"I taani k'osetta attiyaa sa'aa;","poem":2},{"text":"I taana makkalanchcha asatuwaappe ashshee.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Galatay bessiyaa Med'inaa Godaa taani s'eesay;","poem":1},{"text":"I ta morkkatuwaappe taana ashshee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Hayk'k'uwaa beetay ta heeraan sirimettee;","poem":1},{"text":"bashshay di'uwaadan taana muukkeedda.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Duufuwaa wodoruu taana k'achchana hanee;","poem":1},{"text":"hayk'k'uu p'iriyaadan taana oyk'k'eedda.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Taana metuu iissina Med'inaa Godaa s'eesaad;","poem":1},{"text":"‹Taana maadda› gaade ta S'oossaw waassaad.","poem":2},{"text":"I bare Geeshsha Golliyaan ta kooshshaa siseedda;","poem":1},{"text":"taani waasseedda waasuu Aa haytsaan wod'd'eedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«S'oossay hank'k'etteedda diraw,","poem":1},{"text":"Biittay yiik'k'iyiik'k'iide k'aas's'eedda;","poem":2},{"lineBreak":true},{"text":"deretuwaa s'ap'uu gaji gaji kokkoreedda.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Aa siid'iyaappe hank'k'uwaa c'uway c'uwatteedda;","poem":1},{"text":"Aa doonaappe miyaa tamaa lac'uunne s'uuggiyaa bonk'k'uu kesseedda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Saluwaa I p'alk'k'iide, duge wod'd'eedda.","poem":1},{"text":"He wode Aa gediyaappe garssanna med'eedda shaarii de'ee.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"K'efiyaana de'iyaa kiitanchchatuwaan,","poem":1},{"text":"kiruubetuwaan uttiide paalleedda;","poem":2},{"lineBreak":true},{"text":"c'arkkuwaa k'efiyaa bollan beetteedda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Barena d'uman kammeedda;","poem":1},{"text":"Aa dunkkaanii iraanna med'eedda shaariyaa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Aa sintsan de'iyaa wolk'k'aama poo'uwaappe","poem":1},{"text":"tamaa lac'uu kesseedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«K'ay Med'inaa Goday guguntsaadan saluwaappe guummeedda.","poem":1},{"text":"Ubbaappe D'ok'k'iyaa S'oossay bare kooshshaa sisseedda.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bare wonddaafiyaa Adaa yeddiide,","poem":1},{"text":"bare morkkatuwaa laaleedda.","poem":2},{"text":"Walk'k'antsaa poo'uwaa kiittiide,","poem":1},{"text":"unttuntta yedersseedda.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Med'inaa Goday seereedda wodenne,","poem":1},{"text":"hank'k'ettiide peenuuk'eedda wode,","poem":2},{"text":"Abbaa haatsay giseedda biittay betteedda.","poem":1},{"text":"K'ay sa'aa baasuukka k'onc'c'eedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«S'oossay bollappe kushiyaa duge yeddiide, taana oyk'k'eedda;","poem":1},{"text":"c'iimma haatsaappe taana keseedda.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"I taana ta wolk'k'aama morkkiyaappenne","poem":1},{"text":"taana is's'iyaawanttuppe ashsheeda;","poem":2},{"lineBreak":true},{"text":"ayaw gooppe, unttunttu taw loytsi daro wolk'k'aama.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ta waayiyaa gallassi,","poem":1},{"text":"unttunttu ta bolla denddeeddino;","poem":2},{"text":"Shin Med'inaa Goday taana zemppissiyaawaa.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"I taana aako sa'aa keseedda;","poem":1},{"text":"taanan nashetteedda diraw, taana ashsheeda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«Ta s'illotetsaadan Med'inaa Goday taw c'iggeedda;","poem":1},{"text":"Ta kushiyaa geeshshatetsaadan I taw zaareedda.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Taani Med'inaa Godaa ogiyaa kaalaad;","poem":1},{"text":"taani ta S'oossaa aggaade wora babeykke.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Taani Aa higgiyaa ubbaa naagaad;","poem":1},{"text":"Aa wogaa poliyaawaa aggabeykke.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Taani Aa sintsan suure de'aad;","poem":1},{"text":"taani taana nagaraappe naagaad.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Hewaa diraw, Med'inaa Goday taw","poem":1},{"text":"ta s'illotetsaadaaninne ta geeshshatetsaadan zaareedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"«Abeet S'oossaw, ammanettiyaawanttoo neeni ammanettiyaawaa;","poem":1},{"text":"suuretoo neenikka suure.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Geeshshatoo neenikka geeshsha;","poem":1},{"text":"shin geellatoo neeni c'inc'c'a.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Barentta zik'k'issiyaawantta ashshaasa;","poem":1},{"text":"shin barentta d'ok'k'issiyaawantta zik'k'issanaw neeni unttuntta s'eellaasa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Abeet Med'inaa Godaw, ta s'omppii neena;","poem":1},{"text":"Med'inaa Goday poo'issina, ta d'umay kichchee.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ne maaduwaan taani ta morkke olanchchatuu bolla woraajjay;","poem":1},{"text":"ta S'oossan taani unttuntta miis'aa s'eeraana guppa aad'd'ay.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"S'oossaa ogii suure.","poem":1},{"text":"Med'inaa Godaa k'aalay ammanettiyaawaa.","poem":2},{"text":"Aakko bak'atiyaa ubbatoo I gonddalle.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Med'inaa Godaappe attina, hara s'oossi baawa;","poem":1},{"text":"Nu S'oossaappe attina,","poem":2},{"lineBreak":true},{"text":"hara wogga zaalli baawa.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Taw wolk'k'aa immiyaawenne","poem":1},{"text":"ta ogiyaa saro ootsiyaawe","poem":2},{"text":"S'oossaattee.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"I ta gediyaa","poem":1},{"text":"gen\"iyaa gediyaadan minisee.","poem":2},{"text":"Taana d'ok'k'a gishuwaan sarotetsaan wotsee.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"I ta kushiyaa olaa meezeyee;","poem":1},{"text":"Hewaa diraw, taani ta k'esiyaan,","poem":2},{"lineBreak":true},{"text":"nahaasiyaa giyaa birataa wonddaafiyaan dafaade dukkay.","poem":2}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"«Taana ashshiyaa ne gonddalliyaa","poem":1},{"text":"neeni taw immaadda;","poem":2},{"text":"Ne lo\"o okkay taana gitayee.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Taani hamettiyaa sa'aa aassaasa;","poem":1},{"text":"hewaa diraw, ta gedii halis's'ibeena.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Ta morkkatuwaa taani yederssaade mentsereetsaad;","poem":1},{"text":"Taani unttuntta d'ayssennan de'aadde guyye simmabeykke.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Taani unttuntta laa'entso denddennaadan shoc'aad;","poem":1},{"text":"unttunttu ta gediyaan kunddeeddino.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Olaw taana wolk'k'aa danc'c'issaadda;","poem":1},{"text":"taananna gaaddatiyaawantta taw gulbbatissaadda.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Ta morkkatuwaa ta sintsaappe guyye bak'atissaada;","poem":1},{"text":"taana is's'iyaawantta taani d'ayssaad.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Barentta maaddiyaawaa koyeeddino;","poem":1},{"text":"shin ooninne unttuntta ashshibeenna.","poem":2},{"text":"Med'inaa Godaakka unttunttu s'eeseeddino;","poem":1},{"text":"shin I unttunttoo koyyibeenna.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Taani unttuntta baanaadan liik'issaad;","poem":1},{"text":"ogiyaan de'iyaa urk'k'aadankka unttuntta dirs's'ereetsaade yed'd'aad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"«Ta asaa makkalaappe taana ashshaada.","poem":1},{"text":"Kawutetsatuwaa bolla suntsaade, taana naagaadda;","poem":2},{"lineBreak":true},{"text":"taani erenna Asay taw moodetteedda.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Allaga gade asaykka ta sintsan gulbbatee.","poem":1},{"text":"Unttunttu ta waariyaa sisiide,","poem":2},{"lineBreak":true},{"text":"taw azazettiino.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Unttunttu wozanaa kahaa bayiino.","poem":1},{"text":"Barenttu naagettiyaa miis'aappe kokkoriidde yiino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"«Med'inaa Goday de'ee! S'oossay,","poem":1},{"text":"ta wogga zaallay galatetto.","poem":2},{"text":"S'oossay, taana ashshiyaa zaallay,","poem":1},{"text":"d'ok'k'u d'ok'k'u go.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"I ta haluwaa kessiyaa S'oossaa;","poem":1},{"text":"kawutetsatuwaa taappe garssanna wotsiyaawaa.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Ta morkkatuwaappe taana kessi akkiyaawaa.","poem":1},{"text":"Abeet S'oossaw, neeni taananna gaaddatiyaawanttu bollan","poem":2},{"lineBreak":true},{"text":"taana d'ok'k'u d'ok'k'u ootsaasa.","poem":2},{"lineBreak":true},{"text":"Makkalanchcha asatuwaappe neeni taana ashshaasa.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Hewaa diraw, taani","poem":1},{"text":"Med'inaa Godaa kawutetsatuwaa giddon galatana;","poem":2},{"lineBreak":true},{"text":"taani ne suntsaakka sabbana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"«S'oossay bare kaatiyaw","poem":1},{"text":"s'oonuwaa bollan s'oonuwaa immee.","poem":2},{"text":"Bare okkeeddawoo, Daawitewunne Aa zeretsaw,","poem":1},{"text":"aggena siik'uwaa med'inaw besse»","poem":2},"yaagiide yes's'eedda."]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}