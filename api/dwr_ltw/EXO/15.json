{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"EXO","translationId":"dwr_ltw","name":"Kessaa","commonName":"Kessaa","title":"Kessaa Mas'aafaa","order":2,"numberOfChapters":40,"sha256":"5206273033c9cc71b3c8398b0f5e639e1cae7d565498b1146b502d0b403588db","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/dwr_ltw/EXO/40.json","totalNumberOfVerses":1208},"chapter":{"number":15,"content":[{"type":"heading","content":["Muse Yetsaa"]},{"type":"verse","number":1,"content":["He wode Musenne Israa'eeliyaa Asay ha yetsaa Med'inaa Godaw yes's'eeddino;",{"text":"«Bonchchuwaan loytsi d'ok'k'u d'ok'k'u geedda diraw,","poem":1},{"text":"taani Med'inaa Godaw mazimuriyaa yes's'ana.","poem":2},{"lineBreak":true},{"text":"Paranne paraa gaariyaanne toggeeddawantta abbaan oleedda.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Med'inaa Goday ta wolk'k'aanne ta mazimuriyaa;","poem":1},{"text":"I taana ashshiyaawaa gideedda.","poem":2},{"lineBreak":true},{"text":"I ta S'oossaa; taani Aa sabbana.","poem":2},{"lineBreak":true},{"text":"I ta aawuwaa S'oossaa;","poem":2},{"lineBreak":true},{"text":"taani Aa d'ok'k'u d'ok'k'u ootsana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Med'inaa Goday ereteedda olanchchaa;","poem":1},{"text":"Aa suntsaykka Med'inaa Godaa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gibs'e kaatiyaa paraa gaaretuwaanne","poem":1},{"text":"Aa olanchchatuwaa abbaan oleedda.","poem":2},{"lineBreak":true},{"text":"Gibs'e kaatiyaa kaappatuu,","poem":2},{"lineBreak":true},{"text":"ubbaappe aad'd'i lo\"iyaawanttu Zo'o Abbaan muuketteeddino.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"C'iimmo haatsay unttuntta kammeedda;","poem":1},{"text":"unttunttu shuchchaadaan c'iimmuwaan mitetteeddino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Abeet Med'inaa Godaw, ne ushechcha kushii","poem":1},{"text":"wolk'k'an goobeeddawaa;","poem":2},{"lineBreak":true},{"text":"Med'inaa Godaw, ne ushechcha kushii","poem":2},{"lineBreak":true},{"text":"morkkiyaa mentsereetseedda.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne bonchchuwaa gitatetsaan","poem":1},{"text":"neenana gaaddateeddawantta olaadda.","poem":2},{"lineBreak":true},{"text":"Ne ees's'iyaa hank'k'uwaa neeni yeddina,","poem":2},{"lineBreak":true},{"text":"I unttuntta dalaadan meedda.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne siid'iyaanna kesiyaa shemppuwaan","poem":1},{"text":"haatsay dooretteedda.","poem":2},{"lineBreak":true},{"text":"Goggiyaa haatsaykka godaadan min ek'k'eedda;","poem":2},{"lineBreak":true},{"text":"c'iimmo haatsay abbaa gomppan irkkiide minneedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Morkkii,","poem":1},{"text":"‹Taani unttuntta yederssaade oyk'k'ana.","poem":2},{"lineBreak":true},{"text":"Taani unttunttu mas'uwaa shaakkaade,","poem":2},{"lineBreak":true},{"text":"ta koyeeddawaa ubbaa akkana.","poem":2},{"lineBreak":true},{"text":"Taani ta mashshaa shoddaade,","poem":2},{"lineBreak":true},{"text":"unttuntta d'ayissana› yaagiide c'eek'etteedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Shin Ne peenuwaan punnina,","poem":1},{"text":"abbay unttuntta kammeedda.","poem":2},{"lineBreak":true},{"text":"Unttunttu wolk'k'aama haatsaan","poem":2},{"lineBreak":true},{"text":"biratay mitettiyaawaadan mitetteeddino.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abeet Med'inaa Godaw, s'oossatuwaa giddon","poem":1},{"text":"ne malay oonee?","poem":2},{"lineBreak":true},{"text":"Geeshshatetsaan bonchchettiyaawe,","poem":2},{"lineBreak":true},{"text":"bonchchuwaan yayettiyaawe,","poem":2},{"lineBreak":true},{"text":"malaliyaabaa ootsiyaawe ne malay oonee?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Neeni ne ushechcha kushiyaa mic'c'ina,","poem":1},{"text":"biittay unttuntta mitteedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Neeni wozeedda ne asaa","poem":1},{"text":"aggena ne siik'uwaan kaaletsaadda.","poem":2},{"lineBreak":true},{"text":"Neeni ne wolk'k'an","poem":2},{"lineBreak":true},{"text":"unttuntta neeni de'iyaa geeshsha sa'aa gelissaadda.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kawutetsatuu hewaa sisiide","poem":1},{"text":"kokkoreeddino.","poem":2},{"lineBreak":true},{"text":"Piliss's'eema gadiyaa asatuukka","poem":2},{"lineBreak":true},{"text":"yeluu oyk'k'eeddawaadan un\"etteeddino.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"He wode Eedooma gade kaappatuu dagameeddino.","poem":1},{"text":"Moo'aabe gadiyaa mooddiyaawantta","poem":2},{"lineBreak":true},{"text":"yashshay kokkorsseedda.","poem":2},{"lineBreak":true},{"text":"Kanaane asatuwaa shenii hayk'k'eedda.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abeet Med'inaa Godaw dagamaynne yashshay unttuntta oyk'k'ina,","poem":1},{"text":"Unttunttu ne wolk'k'aa gitatetsaa be'iide,","poem":2},{"lineBreak":true},{"text":"ne Asay aad'd'ana gakkanaw,","poem":2},{"lineBreak":true},{"text":"neeni wozeedda Asay aad'd'ana gakkanaw,","poem":2},{"lineBreak":true},{"text":"shuchchaadan muumiide ek'k'ino.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abeet Med'inaa Godaw Neeni unttuntta ahaade,","poem":1},{"text":"ne buzo gaden de'iyaa deriyaa huup'iyaan toketteedda mitsaada wotsa.","poem":2},{"lineBreak":true},{"text":"He sa'ay","poem":2},{"lineBreak":true},{"text":"neeni new de'anaw ootseedda sa'aa,","poem":2},{"lineBreak":true},{"text":"he geeshsha sa'ay neeni ne kushiyaan minisaadde esseedda sa'aa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Med'inaa Goday med'inaappe med'inaw kawutanawaa.»","poem":1}]},{"type":"verse","number":19,"content":["Gibs'e kaatiyaa paratuu, Aa paraa gaaretuunne Aa paraa asatuu abbaan geleedda wode, Med'inaa Goday unttunttu bolla abbaa haatsaa guyye zaariide unttunttu bolla aheedda; shin Israa'eelatuu abbaa gidduwaana mela biittaan hamettiidde beeddino yaagi yes's'eeddino."]},{"type":"heading","content":["Mayraami Yetsaa"]},{"type":"verse","number":20,"content":["Aaroona michchata, nabatta Mayraama darbbiyaa akkaaddu; mac'c'a Asay ubbay darbbiyaa bak'k'iiddenne yes's'iidde izo kaaleeddino."]},{"type":"verse","number":21,"content":["Mayraama unttunttoo yetsaa yes's'aadde,",{"text":"«Med'inaa Goday loytsi d'ok'k'u d'ok'k'u geedda diraw,","poem":1},{"text":"aw yes's'ite.","poem":2},{"text":"Paraanne paraa toggeeddaawaa","poem":1},{"text":"I abbaan oleedda» yaagaadde yes's'aaddu.","poem":2}]},{"type":"heading","content":["C'ammiyaa Haatsaanne Lo\"o C'ora Pulttuwaa"]},{"type":"verse","number":22,"content":["Hewaappe guyyiyaan Muse Israa'eeliyaa Zo'o Abbaappe kaaletsina, unttunttu Suuri geetettiyaa mela biittaa beeddino. He mela biittaan unttunttu haatsaa demmennaan heezzu gallassaa hametteeddino."]},{"type":"verse","number":23,"content":["Unttunttu Maaraa giyaa sa'aa gakkeedda wode, Maaraa haatsay c'amo gideedda diraw, ushanaw danddayibeykkino; hewaa diraw, he sa'ay Maaraa",{"noteId":4},"geetetteedda."]},{"type":"verse","number":24,"content":["Hewaa diraw, asay, «Nuuni ayaa ushanee?» yaagiide Muse bolla zuuzummeedda."]},{"type":"verse","number":25,"content":["Muse Med'inaa Godaw waasseedda; Med'inaa Goday Aa itti mitsaa besseedda; Muse he mitsaa haatsaa giddo olina, haatsay mal\"eedda. Med'inaa Goday unttunttoo kalesetiyaa wogaa immeedda; yaan S'oossay unttuntta paac'c'eedda."]},{"type":"verse","number":26,"content":["I unttuntta hawaadan yaageedda; «Med'inaa Goday hinttenttu S'oossay odiyaawaa minisiide sisooppenne Aa ayfiyaa sintsaan likkebaa ootsooppe, hinttenttu Aa azazuwaa hayzzooppenne Aa wogaa ubbaa naagooppe, taani Gibs'etuwaa bolla aheedda harggiyaappe ittuwaanne hinttenttu bolla ahikke; ayaw gooppe, taani hinttentta patsiyaa Med'inaa Godaattee» yaageedda."]},{"type":"verse","number":27,"content":["Hewaappe unttunttu Eliima giya gadiyaa yeeddino; yaan tammanne laa\"u haatsaa pulttotuunne laappun tammu zambbaa mitsatuu de'iino. Unttunttu yaan haatsaa doonaan utteeddino."]}],"footnotes":[{"noteId":4,"caller":"+","text":"Maaraa: Ha suntsaa biletsay Ibraaweetsuwaan «C'amuwaa» giyaawaa.","reference":{"chapter":15,"verse":23}}]},"thisChapterLink":"/api/dwr_ltw/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}