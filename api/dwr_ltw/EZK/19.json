{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"EZK","translationId":"dwr_ltw","name":"Hizik'k'eela","commonName":"Hizik'k'eela","title":"Hizik'k'eela Timbbitiyaa","order":26,"numberOfChapters":48,"sha256":"32eed42875f214c4582ffddcd0d957f2b94be8c2b3bef0a880c79b14bc7ac87e","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/dwr_ltw/EZK/48.json","totalNumberOfVerses":1268},"chapter":{"number":19,"content":[{"type":"heading","content":["Israa'eeliyaa Daannatuwaa Zilaassaa"]},{"type":"verse","number":1,"content":["S'oossay Hizk'k'eela, «Israa'eeliyaa kaappatoo hawaadan yaagaade zilaala;"]},{"type":"verse","number":2,"content":[{"text":"«Hintte aata gaammotuwaa giddon,","poem":1},{"text":"iza ayiba gaammatii!","poem":2},{"text":"Yalaga gaammotuwaa giddon gisaade,","poem":1},{"text":"bare maratuwaa dichchaaddu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iza bare maratuwaappe ittuwaa dichchina,","poem":1},{"text":"wodalla gaammuwaa keseedda.","poem":2},{"text":"I shankkaa tamaariide, asaa meedda.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kawutetsatuu ubbay aabaa sisiide,","poem":1},{"text":"ollaan geliide oyk'k'eteedda.","poem":2},{"text":"Unttunttu Aa maaggan goochchiide,","poem":1},{"text":"Gibs'e biittaa afeeddino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Aa aata naagowe polettennaan is's'ina,","poem":1},{"text":"hidootay d'ayeeddawaa be'aade,","poem":2},{"lineBreak":true},{"text":"bare maratuwaappe laa\"entsuwaa dichchaade,","poem":2},{"lineBreak":true},{"text":"wodalla gaammuwaa kessaaddu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I wodalla gaammuwaa gidiide,","poem":1},{"text":"hara gaammotuwaa giddon,","poem":2},{"lineBreak":true},{"text":"yaanne haanne simeretteedda.","poem":2},{"text":"I shankkaa tamaariide, asaa meedda.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I unttunttu wolk'k'aama geessuwaa mentsereetsiide,","poem":1},{"text":"katamaakka bayzzeedda.","poem":2},{"text":"Biittaynne biittan de'iyaa Asay ubbay,","poem":1},{"text":"Aa gudetsan shabbiretteedda.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yuushshuwaan de'iyaa kawutetsatuu ubbay,","poem":1},{"text":"Aa oyk'k'anaw p'iriyaa yeggeeddino.","poem":2},{"text":"Barenttu gitiyaakka mic'c'eeddino;","poem":1},{"text":"barenttu ollaan Aa oyk'k'eeddino.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Unttunttu barenttu maaggaan Aa goochchiide,","poem":1},{"text":"kootsaadan giigeedda guutsa golliyaan yeggiide,","poem":2},{"text":"Baabloone kaatiyaakko afeedino.","poem":1},{"text":"Laa\"entso Aa gudetsay Israa'eeliyaa deretuwaan sisettennaadan,","poem":2},{"lineBreak":true},{"text":"unttunttu Aa k'asho golliyaa gelisseeddino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"« ‹Ne aata haatsaa doonaan,","poem":1},{"text":"toketteedda woyniyaa turaa mala.","poem":2},{"text":"Daro haatsay de'iyaa diraw,","poem":1},{"text":"he woyniyaa turay ayifiyaa dars's'as's'i utteedda;","poem":2},{"lineBreak":true},{"text":"k'ay daro daashana de'ee.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Aa maratuwaappe minniyaawe,","poem":1},{"text":"mooddiyaawanttu s'am\"aa gideedda.","poem":2},{"text":"Aa maray wolk'k'aama maratuwaappe aduk'k'iide,","poem":1},{"text":"bollaw aad'd'eeda.","poem":2},{"text":"Bare maratuwaa c'oratetsaaninne","poem":1},{"text":"d'ok'k'atetsan bollaanna beetteedda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Shin he turay hank'k'uwaan shodettiide,","poem":1},{"text":"biittan oletteedda.","poem":2},{"text":"Away doliyaa c'arkkuu Aa ayifiyaa melissina k'ok'ofetteedda;","poem":1},{"text":"Aa mino tashii melina, tamay meedda.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ha\"i k'ay I haatsi bayinna,","poem":1},{"text":"mela biittan toketteedda.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tamay Aa maratuwaappe ittuwaa oyk'k'iide,","poem":1},{"text":"Aa ayifiyaanakka dippi ootsiide meedda.","poem":2},{"text":"Yaatina, kawutetsaa s'am\"aa gidiyaa,","poem":1},{"text":"ay mino maraykka Aa bollan attibeena.","poem":2},"« ‹Hawe yeekuwaa zilaassaa; hawaa zilaassaadan go'ettanaw bessee› yaaga» yaageedda."]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}