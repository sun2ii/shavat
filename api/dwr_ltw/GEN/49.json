{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"GEN","translationId":"dwr_ltw","name":"Doometsaa","commonName":"Doometsaa","title":"Doometsaa Mas'aafaa","order":1,"numberOfChapters":50,"sha256":"716557133d86eeb56ea31a2b2662732788cd59078366c8c8885744e50dac5b0c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/dwr_ltw/GEN/50.json","totalNumberOfVerses":1508},"chapter":{"number":49,"content":[{"type":"heading","content":["Yaak'oobi Bare Naanaa Anjjeedda"]},{"type":"verse","number":1,"content":["Hewaappe guyye, Yaak'oobi bare attuma naanaa s'eesissiide hawaadan yaageedda; «Sintsappe hinttenttoo hananabaa taani hinttenttoo odana mala shiik'ite.»"]},{"type":"verse","number":2,"content":[{"text":"«Hinttenttoo Yaak'ooba naanaatoo,","poem":1},{"text":"ittippe shiik'iide sisite;","poem":2},{"lineBreak":true},{"text":"hinttenttu aawuu Israa'eelii hinttenttoo odiyaawaa hayzitte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«Roobeelaa, ta bayira na'aw,","poem":1},{"text":"neeni ta wolk'k'aa;","poem":2},{"lineBreak":true},{"text":"ta minotetsaw koyruwaa.","poem":2},{"lineBreak":true},{"text":"Neeni bonchchuwaankka wolk'k'ankka ubbaappe aad'd'iyaawaa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Neeni di'uwaa mala; ek'k'osa'an de'akka;","poem":1},{"text":"neeni ubbaappe aad'd'iyaawaa gidakka.","poem":2},{"lineBreak":true},{"text":"Ayaw gooppe, neeni ne aawuwaa gisuwaa kesaadda;","poem":2},{"lineBreak":true},{"text":"ne aawuwaa gisuwaa tunissaadda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Simooninne Leewii ishatuwaa;","poem":1},{"text":"unttunttu mashshay makkalatetsaw olaa miishshaa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani unttunttu zoretan gelikke;","poem":1},{"text":"taani unttunttu shiik'uwaankka uttikke;","poem":2},{"lineBreak":true},{"text":"ayaw gooppe, unttunttu barenttu hank'k'uwaan","poem":2},{"lineBreak":true},{"text":"asaa wod'eeddino barena akka akka giina,booratuwaa k'ans's'eeddino.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Unttunttu suulo hank'k'uu","poem":1},{"text":"unttunttu mek'etsaa iitatetsaynne shek'etteeddawaa gido!","poem":2},{"lineBreak":true},{"text":"Taani unttuntta Yaak'ooba asaa gidduwaan laalana;","poem":2},{"lineBreak":true},{"text":"Israa'eeliyaa biittaan tiskki ootsana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Yihudaw, ne ishatuu neena galatana.","poem":1},{"text":"Ne kushii ne morkkatuwaa pillanttiyaa oyk'k'ana.","poem":2},{"lineBreak":true},{"text":"Ne aawuwaa naanay new hokkiide goynnana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yihudaw, neeni wodalla gaammo.","poem":1},{"text":"Ta na'aw, neeni shankkaappe wod'i simmiide,","poem":2},{"lineBreak":true},{"text":"c'ogottiide giseedda gaammuwaa mala.","poem":2},{"lineBreak":true},{"text":"Neeni asaa bosheretsanaw koyenna mac'c'a gaammatti mala.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ayissiyaawe yaana gakkanaw,","poem":1},{"text":"Kawutetsaa s'am\"ay Yihudaappe,","poem":2},{"lineBreak":true},{"text":"deriyaa ayissiyaawanttu gatimay Aa gediyaa giddoppe shaakettenna.","poem":2},{"lineBreak":true},{"text":"K'ay deriyaa Asay aw azazettana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"I bare hariyaa woyniyaa anuwaan,","poem":1},{"text":"bare hare maraa muruta woyniyaa turaan k'achchana.","poem":2},{"lineBreak":true},{"text":"I bare afilaa woyniyaa eessan,","poem":2},{"lineBreak":true},{"text":"bare mayuwaa suutsaa malatiyaa woyniyaa eessan meec'c'ana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Aa ayfii woyniyaa eessaappe aad'd'i zo\"ana;","poem":1},{"text":"Aa achchaykka maatsaappe aad'd'i boos's'ana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Zaabiloone abbaa doonaan de'ana;","poem":1},{"text":"I abbaa doonaan markkabatuu ek'k'iyaa sa'aa gidana;","poem":2},{"lineBreak":true},{"text":"Aa zaway Sidoona gakkanawaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Yisaakoore mino hariyaa;","poem":1},{"text":"c'aaniyaa laa\"u doonniyatuwaa gidduwaan gis bashee","poem":2}]},{"type":"verse","number":15,"content":[{"text":"I bare shemppiyaasaa lo\"a gidiyaawaanne","poem":1},{"text":"bare biittay nashechiyaawaa gidiyaawaa be'iyaa wode,","poem":2},{"lineBreak":true},{"text":"c'aanaa tookkanaw bare hashiyaa hokisiide,","poem":2},{"lineBreak":true},{"text":"ayiletetsaa oosuwaa ootsana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«Daani israa'eeliyaa zaratuwaappe","poem":1},{"text":"ittuwaa gideedda bare asaa bolla daannatanawaa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Daani ogiyaa doonaan de'iyaa shooshshaa;","poem":1},{"text":"Paraa toggeeddawe guyye kunddana mala","poem":2},{"lineBreak":true},{"text":"paraa ginddiyaa dukkiyaa,","poem":2},{"lineBreak":true},{"text":"ogiyaan de'iyaa hasuwaa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Abeet Med'inaa Godaw, taani neeni ashshanaadan naagay.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Gaadi bonk'k'iyaawanttun deshettanawaa;","poem":1},{"text":"Shin ikka unttunttu k'atamaa kaalliide","poem":2},{"lineBreak":true},{"text":"unttuntta bonk'k'anawaa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Aaseera ukitsay ordduwaa;","poem":1},{"text":"kaatiyaw I lo\"o k'umaa immana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nifttaaleeme k'ashettennan yeda de'iyaa,","poem":1},{"text":"lo\"o maratuwaa yeliyaa gen\"iyaa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yooseefo ayfiyaana yonddodeedda woyniyaa turaa.","poem":1},{"text":"I pulttuwaa matan yonddodda ayfiyaana de'iyaa,","poem":2},{"lineBreak":true},{"text":"daashshaykka godaappe bollaanna zaa'iyaa woyniyaa turaa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Wonddaafiyaa dukkiyaawanttu","poem":1},{"text":"Aa bolla dooddeeddino;","poem":2},{"lineBreak":true},{"text":"barenttu wonddaafiyaankka,","poem":2},{"lineBreak":true},{"text":"dukkeeddinonne mayttiseeddino.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Aa wonddaafii min utteedda;","poem":1},{"text":"Aa wolk'k'aykka minniide gam\"eedda.","poem":2},{"lineBreak":true},{"text":"Hewekka Yaak'ooba S'oossaa Wolk'k'aama kushiyaa gaasuwaana,","poem":2},{"lineBreak":true},{"text":"ne hentsanchchaa, Israa'eeliyaa Zaallaa gaasuwaana,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Neena maaddiyaa ne aawotuwaa S'oossaa gaasuwaaninne,","poem":1},{"text":"neena bolla saluwaa anjjuwaan,","poem":2},{"lineBreak":true},{"text":"garssa c'iimmaa anjjuwaan, d'antsaa anjjuwaaninne","poem":2},{"lineBreak":true},{"text":"yeliyaa uluwaa anjjuwaan anjjiyaa,","poem":2},{"lineBreak":true},{"text":"Ubbaa Danddayiyaa S'oossaa gaasuwaana.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ne aawuwaa anjjuu beni deretuwaa anjjuwaappekka","poem":1},{"text":"med'inaappe de'iyaa anjjuwaappekka aad'd'ee.","poem":2},{"lineBreak":true},{"text":"Hawe ubbay Yooseefo huup'iyaan,","poem":2},{"lineBreak":true},{"text":"bare ishatuwaa gidduwaan kaappuwaa gidiyaawaa liip'iyaan shemppo.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Biiniyaame bonk'k'iyaa walliyaa.","poem":1},{"text":"Bare shankkateeddawaa wontta mee;","poem":2},{"lineBreak":true},{"text":"bare omoodeeddawaa omarssi shaakkee» yaageedda.","poem":2}]},{"type":"verse","number":28,"content":["Hawanttu tammanne laa\"u israa'eeliyaa zaratuwaa; k'ay unttunttu aawuu unttuntta huup'iyaan huup'iyaan unttunttoo bessiyaa anjjuwaa anjjiidde unttunttoo geeddawe hawaa."]},{"type":"heading","content":["Yaak'ooba Hayk'k'uwaa"]},{"type":"verse","number":29,"content":["Hewaappe guyye, I unttuntta hawaadan yaagiide azazeedda; «Taani ta mayza asatuwaan gakettanaw hanay; taana Hiitiyaa Efiroona gaden de'iyaa gonggoluwaan, ta aawotuwaana moogite."]},{"type":"verse","number":30,"content":["Hewekka Kanaane biittaan, Mamire matan de'iyaa, Maakip'eela giyaa gonggoluwaa; hewe Abrahaame Hiitiyaa Efiroonappe Aa gadiyaanna shammeedda gonggoluwaa."]},{"type":"verse","number":31,"content":["Abrahaamenne Aa machata Saara yan moogetteeddino; Yisaak'inne Aa machata Ribik'a yan moogetteeddino; taani k'ay Liyo yan moogaad."]},{"type":"verse","number":32,"content":["He gadiinne an de'iyaa gonggoluu Hiitetuwaappe shametteeddawaa» yaageedda."]},{"type":"verse","number":33,"content":["Yaak'oobi bare naanaw azazuwaa wursseedda wode, bare gediyaa pude bare hiis'aw shiishshi akkiidde, hayk'k'i aggeeda; bare mayzzan gaketeedda."]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}