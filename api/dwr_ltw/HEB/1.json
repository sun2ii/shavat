{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"HEB","translationId":"dwr_ltw","name":"Ibraawe","commonName":"Ibraawe","title":"Ibraawe Asaw S'aafetteedda Kiitaa","order":58,"numberOfChapters":13,"sha256":"91015b5c0dfb0971390a41d870bffa68fd3ce84da5a8557b3d1a87072088c88e","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/dwr_ltw/HEB/13.json","totalNumberOfVerses":298},"chapter":{"number":1,"content":[{"type":"heading","content":["S'oossay Bare Na'aa Baggana Haasayeedda"]},{"type":"verse","number":1,"content":["S'oossay beni wode, nu aawotuu nabatuwaa baggana dumma dumma ogiyaaninne daro wodiyaan haasayeedda."]},{"type":"verse","number":2,"content":["Shin ha wurssetsa wodiyaan, ubbabaa Aa laatissiide, yeletaa Aa baggana med'd'eedda bare Na'aa baggana nuw haasayeedda."]},{"type":"verse","number":3,"content":["Na'ay S'oossaa bonchcho poo'uwaa p'oolee; k'ay kumentsaa S'oossaa eeshshaa akkiide, bare wolk'k'aama k'aalaan ha sa'aa naagee; yaatiide asaa nagaraappe geeshshiide, Ubbaappe Bolla S'oossaappe ushechcha baggana",{"noteId":0},"saluwaan utteedda."]},{"type":"heading","content":["S'oossaa Na'ay Kiitanchchatuwaappe Bolla"]},{"type":"verse","number":4,"content":["S'oossay aw immeedda suntsatetsay kiitanchchatuwaappe d'ok'k'a gidiyaawaadankka, unttunttuppe Aa loytsi d'ok'k'u ootseedda."]},{"type":"verse","number":5,"content":["Ayaw gooppe, S'oossay bare kiitanchchatuwaappe oona,",{"text":"«Neeni ta Na'aa;","poem":1},{"text":"taani hachche new aawuwaa gidaaddi»","poem":2},"geeddee? Woy k'ay oona,",{"text":"«Taani aw aawuwaa gidana;","poem":1},{"text":"ikka taw na'aa gidana»","poem":2},"geeddee?"]},{"type":"verse","number":6,"content":["K'ay S'oossay bare bayira Na'aa ha sa'aa yeddana haniidde,",{"text":"«Ta kiitanchchatuwaa ubbatuukka aw goyinnino»","poem":1},"yaageedda."]},{"type":"verse","number":7,"content":["S'essay kiitanchchatuwaabaa haasayiidde,",{"text":"«Taani ta kiitanchchatuwaa c'arkkuwaa kessay;","poem":1},{"text":"k'ay ta oosanchchatuwaakka tamaa lac'uwaa kessay»","poem":2},"yaagee."]},{"type":"verse","number":8,"content":["Shin bare Na'aawaa haasayiidde,",{"text":"«S'oossaw, ne kawutetsaa oydii,","poem":1},{"text":"med'i med'inaw de'ee.","poem":2},{"text":"Ne kawutetsaa s'illotetsaan ahaassa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Neeni s'illotetsaa siik'aade;","poem":1},{"text":"naak'uwaa is's'aadda.","poem":2},{"text":"S'oossay, ne S'oossay neena,","poem":1},{"text":"ne laggetuwaappe aatsiide,","poem":2},{"lineBreak":true},{"text":"nashechchaan ililissiyaa zayitiyaa okkeeddawe hawaassa»","poem":2},"yaagee."]},{"type":"verse","number":10,"content":["S'oossay hawaadan yaagee;",{"text":"«Godaw, koyro neeni sa'aa med'd'aadda;","poem":1},{"text":"saluwaakka ne kushiyan med'd'aadda.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hewanttu ubbay d'ayana;","poem":1},{"text":"shin neeni de'ana.","poem":2},{"text":"Unttunttu ubbaykka afilaadan wurana.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Neeni unttuntta gaabiyaadan dakkoyana;","poem":1},{"text":"k'ay unttunttu afilaadan laamettanawantta.","poem":2},{"text":"Shin neeni neenakka;","poem":1},{"text":"ne laytsay ubbaakka wurenna»","poem":2},"yaagee."]},{"type":"verse","number":13,"content":["Shin S'oossay bare kiitanchchatuwaappe ittuwaanne,",{"text":"«Taani ne morkkatuwaa neeni","poem":1},{"text":"gediyaan yed'd'iyaawaa ootsana gakkanaw,","poem":2},{"lineBreak":true},{"text":"hawaan taappe ushechcha baggan utta»","poem":2},"gibeenna."]},{"type":"verse","number":14,"content":["Kiitanchchatuu ubbay S'oossaw ootsanawunne atotetsaa demmana asatuwaa maaddanaw S'oossay kiitteedda ayyaanatuwaa gidikkinooyee?"]}],"footnotes":[{"noteId":0,"caller":"+","text":"Ushechcha baggana: Bonchchuwaanne wolk'k'aassa gidiyaawaa bessee.","reference":{"chapter":1,"verse":3}}]},"thisChapterLink":"/api/dwr_ltw/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}