{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"ISA","translationId":"dwr_ltw","name":"Isiyaasa","commonName":"Isiyaasa","title":"Isiyaasa Timbbitiyaa","order":23,"numberOfChapters":66,"sha256":"021505cae0c3cfcb34024558b6eb7880e0d1aa00eaa3bb91bc28b17c1f9cfe28","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/dwr_ltw/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":12,"content":[{"type":"heading","content":["Galataa Yetsaa"]},{"type":"verse","number":1,"content":["He wode hintte hawaadan yaagana:",{"lineBreak":true},{"text":"«Abeet Med'inaa Godaw, neeni taana hank'k'ettaadda;","poem":1},{"text":"hank'k'uwaappekka simmaadda;","poem":2},{"lineBreak":true},{"text":"yaataade taana mintsetsaadda.","poem":2},{"lineBreak":true},{"text":"Hewaa diraw, taani neena galatay.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«Be'ite, Med'inaa Goday ta atotetsaa;","poem":1},{"text":"taani aan ammanettaade, yayyikke.","poem":2},{"text":"Ayaw gooppe, Med'inaa Goday,","poem":1},{"text":"taw wolk'k'anne yetsaa.","poem":2},{"text":"I ta atotetsaa gideedda»","poem":1},"yaagana."]},{"type":"verse","number":3,"content":["Ashshiyaa pulttotuwaappe haatsaa hintte nashshechchan duuk'k'ana."]},{"type":"verse","number":4,"content":["He gallassi k'ay hintte hawaadan yaagana:",{"lineBreak":true},{"text":"«Med'inaa Godaa galatite!","poem":1},{"text":"Aa suntsaakka s'eesite.","poem":2},{"text":"Aa oosotuwaa kawutetsatuwaa ubbaa giddon erissite.","poem":1},{"text":"Aa suntsay d'ok'k'u d'ok'k'u geeddawaa awaayite.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Med'inaa Goday wolk'k'aama oosuwaa ootseedda diraw,","poem":1},{"text":"aw yes's'ite.","poem":2},{"text":"Hawe sa'aa ubbaan eretto.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Israa'eeliyaa Geeshshay hintte giddon","poem":1},{"text":"d'ok'k'u d'ok'k'u geedda diraw,","poem":2},{"lineBreak":true},{"text":"hinttenoo, S'iyoonen de'iyaawanttoo,","poem":2},{"lineBreak":true},{"text":"hombboc'ite! nashshechchaw yes's'ite!»","poem":2},"yaagana."]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}