{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"ISA","translationId":"dwr_ltw","name":"Isiyaasa","commonName":"Isiyaasa","title":"Isiyaasa Timbbitiyaa","order":23,"numberOfChapters":66,"sha256":"021505cae0c3cfcb34024558b6eb7880e0d1aa00eaa3bb91bc28b17c1f9cfe28","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/dwr_ltw/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":26,"content":[{"type":"heading","content":["S'oossay Bare Asaw S'oonuwaa Immana"]},{"type":"verse","number":1,"content":["He gallassi Yihudaa gadiyaan ha yetsay yes'ettana.",{"lineBreak":true},{"text":"Nuw mino katamay de'ee;","poem":1},{"text":"S'oossay atotetsaa Aa yuushshuwaan gimbbiyaadaaninne geessuwaadan essee.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ammanuwaa naagiyaa s'illo kawutetsay gelana mala,","poem":1},{"text":"penggiyaa dooyite.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bare k'ofaa neenan wotseedda asaa","poem":1},{"text":"neeni polo sarotetsaan naagaasa;","poem":2},{"text":"Ayaw gooppe, I neenan ammanettee.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Med'inaa Godaan med'inaw ammanetitte;","poem":1},{"text":"ayaw gooppe, Med'inaa Goday, Med'inaa Goday med'inaa Zaallaa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"D'ok'k'an de'iyaawanttanne,","poem":1},{"text":"unttunttu d'ok'k'a katamaa zik'k'i ootseedda;","poem":2},{"text":"I Aa kawushshee.","poem":1},{"text":"Duge sa'aa gakkanaw zik'k'i ootsee;","poem":2},{"lineBreak":true},{"text":"biittaa baanan olee.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mank'k'uwaa gedii, metootanchchaa gedii, Aa yed'd'ana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"S'illotuwaa ogii salalaa.","poem":1},{"text":"Abeet S'illoo, neeni","poem":2},{"lineBreak":true},{"text":"s'illotuwaa ogiyaa salallissaasa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ee Med'inaa Godaw, ne higgiyaa ogiyaan hamettiidde,","poem":1},{"text":"nuuni neena naageetto.","poem":2},{"text":"Nu wozanaa amuu,","poem":1},{"text":"ne suntsaa bonchchanawaa s'alalaa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"K'amman taani neena laamotay;","poem":1},{"text":"Wonttan ta giddon de'iyaa ta ayyaanay,","poem":2},{"lineBreak":true},{"text":"tumuwaappe neena minisiide koyee.","poem":2},{"lineBreak":true},{"text":"Ayaw gooppe, ne pirdday sa'aan de'iyaa wode,","poem":2},{"lineBreak":true},{"text":"sa'aan de'iyaa Asay s'illotetsaa tamaaree.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iita asaw keekatetsaa ootsooppekka,","poem":1},{"text":"I s'illotetsaa tamaarenna.","poem":2},{"text":"Suure asatuwaa gadiyaan iitabaa ootsee;","poem":1},{"text":"Med'inaa Godaa gitatetsaakka erenna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abeet Med'inaa Godaw, neeni,","poem":1},{"text":"ne kushiyaa d'ok'k'u ootsaadda;","poem":2},{"text":"Shin unttunttu be'ikkino.","poem":1},{"text":"Ne asaw neeni mishettiyaa mishuwaa be'iide yeellatino.","poem":2},{"text":"Neeni ne morkketoo wotseedda tamay,","poem":1},{"text":"unttuntta mi d'ayisso.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abeet S'oossaw, neeni,","poem":1},{"text":"nuw sarotetsaa mintsaadda;","poem":2},{"text":"Nu ooso ubbaa neeni nuw ootsaadda.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Abeet Med'inaa Godaw, nu S'oossaw,","poem":1},{"text":"neeppe haratuu nuuna mooddeeddino;","poem":2},{"text":"Shin nuuni ne suntsaa s'alalaa bonchcheetto.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Unttunttu hayk'k'eeddino;","poem":1},{"text":"simmiide pas'a de'ikkino.","poem":2},{"text":"Neeni d'ayisseedda diraw,","poem":1},{"text":"simmiide denddikkino.","poem":2},{"text":"Unttunttu hassayettiyaawaa ubbaa k'uc'c'a d'ayissaadda.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Abeet Med'inaa Godaw!","poem":1},{"text":"Neeni asaa darissaadda.","poem":2},{"text":"Asaa darissaade, neeni bonchchettaadda;","poem":1},{"text":"biittaa zawaa ubbaakka aassaada.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abeet Med'inaa Godaw!","poem":1},{"text":"Metuwaa wode unttunttu neena koyeeddino.","poem":2},{"text":"Neeni unttuntta mureedda wode,","poem":1},{"text":"unttunttu neena saasukki woosseeddino.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abeet Med'inaa Godaw! Shahaareedda mishiratta,","poem":1},{"text":"yeliyaa wodii gakkina,","poem":2},{"text":"Yeluwaa un\"ettaade waassiyaawaadan,","poem":1},{"text":"Nuunikka ne sintsan hewaadan haneeddo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nuuni shahaareeddo; oytsaa oyk'k'eteeddo;","poem":1},{"text":"Shin c'arkkuwaa yeliyaawaa gideeddo.","poem":2},{"text":"Nuuni sa'aw atotetsaa ahibeykko;","poem":1},{"text":"sa'aan de'iyaa asaakka yelibookko.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hayk'k'eedda ne Asay pas'ana;","poem":1},{"text":"unttunttu anhay denddana.","poem":2},{"text":"Hinttenoo, biittaa baanaa giddon de'iyaawanttoo,","poem":1},{"text":"hintte s'aasay wontta ketterssaa mala gidiyaa gishshawunne,","poem":2},{"lineBreak":true},{"text":"sa'aykka hayk'k'eeddawantta zaaretsiide immiyaa diraw,","poem":2},{"lineBreak":true},{"text":"Beegottitenne nashshechchaw yes's'ite.","poem":2}]},{"type":"heading","content":["Pirddaanne Omooduwaappe Simmiyaawaa"]},{"type":"verse","number":20,"content":["Ta asatoo, haa yiite; hintte golle geliide, penggiyaa hintte bolla gorddite. S'oossaa hank'k'uu aad'd'ana gakkanaw, guutsaa wodiyaa hinttena k'osite."]},{"type":"verse","number":21,"content":["Biittaa bollan de'iyaa asaa, unttunttu nagaraa diraw murana, Med'inaa Goday bare de'iyaasaappe kesiide yee. Biittaykka bare bollan gukkeedda suutsaa k'onc'c'issana; wod'eeddawanttakka laa\"entso gentsenna."]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}