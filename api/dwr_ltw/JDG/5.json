{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"JDG","translationId":"dwr_ltw","name":"Daannatuwaa","commonName":"Daannatuwaa","title":"Daannatuwaa Mas'aafaa","order":7,"numberOfChapters":21,"sha256":"156180d68e839157d82e081524639737279406356a1924f6b1af6660f44c555b","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/dwr_ltw/JDG/21.json","totalNumberOfVerses":614},"chapter":{"number":5,"content":[{"type":"heading","content":["Dibooranne Baaraak'a Yetsaa"]},{"type":"verse","number":1,"content":["He gallassi Dibooranne Abino'aama na'ay Baaraak'i ha yetsaa yes's'eeddino."]},{"type":"verse","number":2,"content":[{"text":"«Israa'eeliyaa asaa","poem":1},{"text":"kaaletsiyaawanttu kaaletseedda diraw,","poem":2},{"text":"Asaykka dosiide,","poem":1},{"text":"bare huup'iyaa aatsiide immeedda diraw,","poem":2},{"lineBreak":true},{"text":"Med'inaa Godaa galatite!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«Hinttenttoo kaatetoo, hawaa sisite!","poem":1},{"text":"Hinttenttoo deriyaa mooddiyaawanttoo, hayzitte!","poem":2},{"text":"Taani Med'inaa Godaw yes's'ana.","poem":1},{"text":"Med'inaa Godaw Israa'eeliyaa S'oossaw","poem":2},{"lineBreak":true},{"text":"galataa yetsaa yes's'ana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Abeet Med'inaa Godaw,","poem":1},{"text":"neeni Se'iira Deriyaappe denddeedda wode,","poem":2},{"text":"Neeni Eedooma biittaappe kesseedda wode,","poem":1},{"text":"biittay k'aas's'eedda.","poem":2},{"text":"Saluwaappe iray bukkeedda;","poem":1},{"text":"ee, haatsay shaaretuwaappe duge soosoteedda.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Med'inaa Godaa sintsan deretuu k'aas's'eeddino;","poem":1},{"text":"Haray attina, Siinaa Deriikka Med'inaa Godaa","poem":2},{"text":"Israa'eeliyaa S'oossaa sintsan kokkoreedda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Anaata na'aa Shamggaana wodenne,","poem":1},{"text":"Yaa'eela wode c'aanaa mehiyaa laaggiyaa,","poem":2},{"lineBreak":true},{"text":"zal\"anchchatuu he biittaana aad'd'ibeykkino.","poem":2},{"lineBreak":true},{"text":"Ogiyaanna biyaawanttukka ogiyaa aggiide,","poem":2},{"lineBreak":true},{"text":"loossuwaana beeddino.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Israa'eeliyaa katamatuu Asay de'enna sa'aa gideeddino.","poem":1},{"text":"Taan Diboora, taan Israa'eeliyaa asaw,","poem":2},{"lineBreak":true},{"text":"aatto gidaade denddana gakkanaw ooninne attibeena.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Israa'eeliyaa Asay allaga s'oossatuwaa dooreedda wode,","poem":1},{"text":"gadiyaan olay denddeedda.","poem":2},{"text":"Oytamu sha\"a Israa'eeliyaa olanchchatuwaa gidduwaan","poem":1},{"text":"itti gonddallii woy itti toori beettibeenna.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ta wozanay Israa'eeliyaa ola gadaawatuwaana de'ee.","poem":1},{"text":"Asaa giddon dosiide barentta aatsiide immeeddawanttuna de'ee.","poem":2},{"text":"Med'inaa Godaa galatite!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hinttenttoo, bootsa haretuwaa toggiyaawantto,","poem":1},{"text":"Hinttenttoo, gilaasiyaa bollan uteeddawanttoo,","poem":2},{"lineBreak":true},{"text":"ogiyaanna hamettiyaawanttoo,","poem":2},{"lineBreak":true},{"text":"hawaa sisite!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Haatsaa ollatuwaa matan shiik'eedda yetsanchchatuwaa yetsaa sisite.","poem":1},{"lineBreak":true},{"text":"Unttunttu Med'inaa Goday s'illotetsaa oosuwaabaa yes's'iino;","poem":1},{"text":"k'ay Israa'eeliyaa olanchchatuwaa s'illotetsaa oosuwaabaa yes's'iino.","poem":2},{"lineBreak":true},{"text":"«Hewaappe guyyiyaan, Med'inaa Godaa asay","poem":1},{"text":"katamaa geliyaa penggetuwaakko duge wod'd'eedda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dibooree! Beegotta! Beegotta!","poem":1},{"text":"Beegotta! Beegottaade mazimuriyaa yes's'a.","poem":2},{"text":"Baaraak'a, dendda!","poem":1},{"text":"Neenoo, Abino'aama na'aw, ne omooduwaa akkaade ya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Hewaappe guyyiyaan, atteeda asatuu","poem":1},{"text":"kaappatuwaakko duge wod'd'eeddino.","poem":2},{"text":"Med'inaa Godaa asatuu olettanaw giigiide","poem":1},{"text":"Diboorikko yeeddino.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Amaaleek'a zaratuu beni de'eedda sa'aan de'iyaa,","poem":1},{"text":"Efireema asatuu yeeddino.","poem":2},{"text":"K'ay Biiniyaama asatuu unttuntta kaalleeddino.","poem":1},{"text":"Kaappatuu Maakira zaratuwaappenne,","poem":2},{"text":"Ola gadaawatuu Zaabiloona zaratuwaappe duge wod'd'eeddino.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yisaakoora kaappatuu Diboorina yeeddino;","poem":1},{"text":"ee, Yisaakoora asaynne Baaraak'ikka yeedda;","poem":2},{"lineBreak":true},{"text":"unttunttu Aa geeduwaa kaalliide, zanggaaraa geleeddino.","poem":2},{"lineBreak":true},{"text":"Shin Roobeela zaratuu k'ofaan shaakettiide,","poem":2},{"lineBreak":true},{"text":"yaanawaa agganawaa k'achchibeykkino.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Unttunttu ayaw atteeddinoo?","poem":1},{"text":"Dorssatuwaa heemmiyaawanttu imbbilittaa sisanaw atteedinooyye?","poem":2},{"lineBreak":true},{"text":"Roobeela zaratuu k'ofaan shaakettiide,","poem":2},{"lineBreak":true},{"text":"yaanawaa agganawaa k'achchibeykkino.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Gala'aade asatuu Yorddaanoosa shaafaappe hefintsan atteeddino.","poem":1},{"text":"Daana zaratuu markkabatuu matan atteeddino.","poem":2},{"text":"Aaseera zaratuu barenttu de'iyaa sa'aan,","poem":1},{"text":"Meeditiraane Abbaa lank'k'iyaan atteeddino.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Zaabiloona zaratuu barenttu shemppuwaa hayk'k'oo aatsiide immeedda asatuwaa.","poem":1},{"text":"Nifttaaleema zaratuukka unttunttuwaadan ola dembban barenttu shemppuwaa aatsiide immeeddino.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kaatetuu yiide, Magido pulttotuwaa matan de'iyaa Taa'inaakan oletteeddino.","poem":1},{"text":"He Kanaane kaatetuu yaan olettiide,","poem":2},{"lineBreak":true},{"text":"omooddanaw ayaa biraanne demmibeeykkino.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Saluwaan de'iyaa s'oolinttetuukka oletteeddino.","poem":1},{"text":"Barenttu yuuyyiyaa yuushshan unttunttu Sisaarana oletteeddino.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"K'iishoona Shaafay, benippe,","poem":1},{"text":"eretteedda K'iishoona Shaafay kuntsiide,","poem":2},{"lineBreak":true},{"text":"he kaatetuwaa shokiide afeedda.","poem":2},{"text":"Ta shemppattee, simmi minna;","poem":1},{"text":"sintsaw gaallifa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hewaappe guyyiyaan, paraa asatuu andaraasetiidde yeeddino.","poem":1},{"text":"Paratuu barenttu kottiyaan gadiyaa giirisseeddino.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Med'inaa Godaa kiitanchchay,","poem":1},{"text":"‹Merooza shek'k'ite!","poem":2},{"text":"Yan de'iyaa asaa iissiide shek'k'ite!","poem":1},{"text":"Ayaw gooppe, unttunttu Med'inaa Godaw ek'k'anaw yibeykkino.","poem":2},{"text":"Aa wolk'k'aama morkkatuwaanna olettanaw kesibeykkino› yaageedda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"«K'eena Hebeera machchata","poem":1},{"text":"Yaa'eela mac'c'a asaa ubbaappe anjjetteedaano gidu.","poem":2},{"text":"Dunkkaane giddon de'iyaa mac'c'a asaa ubbaappe iza anjjetteedano gidu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Sisaari izo haatsaa oochchina,","poem":1},{"text":"maatsaa aw immaaddu.","poem":2},{"text":"Lo\"o k'arabbaan me\"eedda maatsaa ahaadu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Itti kushiyaa yeddaade dunkkaaniyaa shikaaliyaa,","poem":1},{"text":"ushechcha kushiyan oosanchchatuwaa martteeluwaa oyk'k'aaddu.","poem":2},{"text":"Sisaara huup'iyaan d'ogaaddu;","poem":1},{"text":"haytsa kariyaana kantsa kessaaddu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Yaatina, I bolk'k'u giide kunddeedda.","poem":1},{"text":"I he izi gediyaa matan","poem":2},{"lineBreak":true},{"text":"bolk'k'u giide kunddeedda.","poem":2},{"lineBreak":true},{"text":"He kunddeedda sa'aan hayk'k'eedda.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Sisaara daaya maskkootiyaanna s'eellaaddu.","poem":1},{"text":"‹Ta na'aa paraa gaarii ayaw gam\"eedee?","poem":2},{"text":"Paratuu elleelliidde ayaw simmibeykkino?›","poem":1},{"text":"yaagaadde oochchaaddu.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Izi aad'd'eeda eranchcha mac'c'a asatuu Izi ooshaa zaareeddino.","poem":1},{"text":"Shin iza bare k'ofaan zaara zaaraadekka hawaadan yaagaaddu;","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Unttunttu omoodiide shaakkiyaawaa demmennaan aggikkino.","poem":1},{"text":"Itti itti olanchchaa itti itti woy laa\"u laa\"u wodoratuu gakkennan aggikkino.","poem":2},{"text":"Sisaaraw unttunttu lo\"iyaa mayuwaa immana;","poem":1},{"text":"k'ay tawukka k'ood'iyaan s'aas'anaw,","poem":2},{"lineBreak":true},{"text":"s'ilifiyaan alleek'k'ettiide lo\"iyaa mayotuwaa","poem":2},{"lineBreak":true},{"text":"unttunttu ahana yaagaaddu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"«Abeet Med'inaa Godaw, ne morkketuu ubbay hewaadan hayk'k'iino!","poem":1},{"text":"Shin ne siik'atuu guura doliyaa awaadan p'oolino;","poem":2},{"lineBreak":true},{"text":"away bare wolk'k'aan kesiyaawaadan» yaageeddino.","poem":2},"Hewaappe guyyiyaan, gadii oytamu laytsaa woppaa demmeedda."]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}