{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":10,"content":[{"type":"heading","content":["Pirddaa Demanaw Shiik'eedda Woosaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, ayaw haakkaade ek'k'ay?","poem":1},{"text":"Metuwaa wodiyaan ayaw neeni geemmay?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bare otoruwaan iita Asay hiyyeesaa shankkatee.","poem":1},{"text":"Unttunttu barenttu pala mak'k'uwaan barenttoo oyk'k'ettino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"He iitay bare wozanaa iita amuwaan c'eek'ettee;","poem":1},{"text":"yoranchchay Med'inaa Godaa bolla iita k'aalaa haasayeenne kaddee.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iitay bare otoruwaan S'oossaa koyenna;","poem":1},{"text":"bare k'ofa ubbankka S'oossaa ayinne koyenna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ubbabay aw ubbaa wodekka kumee;","poem":1},{"text":"I otoruwaa p'ees's'alee.","poem":2},{"text":"Ne higgii aw gelenna;","poem":1},{"text":"bare morkkatuwaa bollan I k'iliic'ee.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bare wozanaan I, «Taana ayaynne k'aatsenna.","poem":1},{"text":"Taana ubbakka metuu gakkenna» yaagiide k'oppee.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Aa doonaan shek'ay,","poem":1},{"text":"wordduunne manddetsay kumeedda.","poem":2},{"text":"Bare ins's'arssan genebaanne iitabaa haasayanaw elleellee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Heeraan k'osettiyaasan I zuggiide uttee.","poem":1},{"text":"Bare wod'iyaawaa wod'anaw k'osetti naagiidde,","poem":2},{"lineBreak":true},{"text":"wolk'k'ay bayinna ashkketuwaa s'eellee.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bare k'osettiyaasan geemmiide,","poem":1},{"text":"hiyyeesaa oyk'k'anaw gaammuwaadan zuggee.","poem":2},{"text":"I hiyyeesaa oyk'k'iide, bare p'iriyaan goochchiide afee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yaatina, wolk'k'ay bayinna hiyyeesay shoc'etee;","poem":1},{"text":"nippi geenne he minuwaan s'oonettee.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"I bare wozanaan, «S'oossay taana dogi kichcheedda.","poem":1},{"text":"Bare som\"uwaa taappe gentsi kichcheedda;","poem":2},{"lineBreak":true},{"text":"ubbakka I be'enna» yaagee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Abeet Med'inaa Godaw, dendda.","poem":1},{"text":"S'oossaw, ne kushiyaa d'ok'k'u ootsaade dentsa;","poem":2},{"lineBreak":true},{"text":"hiyyeesaa dogoppa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nagaranchcha uray bare wozanaan,","poem":1},{"text":"S'oossaa ayaw kad'ii?","poem":2},{"text":"Bare k'ofankka, «S'oossay taana murena»","poem":1},{"text":"ayaw yaagii?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Shin S'oossaw, neeni tumukka be'aasa;","poem":1},{"text":"metuwaakka waayiyaakka s'eellaasa.","poem":2},{"text":"Neeni ubbaa wode nuuna maaddanaw giiga uttaadda.","poem":1},{"text":"Yii'atoo neeni maaduwaa.","poem":2},{"text":"K'ohetteeddawe neeni maaddanaadan barena new sheed'd'e.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Geniyaawanttu wolk'k'aa neeni wurssa;","poem":1},{"text":"Iita asatuwaakka hewaadda ootsa.","poem":2},{"text":"Laa\"entso unttunttu giddon iitatetsay beettena mala unttuntta mura.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Med'inaa Goday med'i med'inaw kaatetiide de'ee;","poem":1},{"text":"hara kawutetsatuu Aa biittaappe d'ayana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Abeet Med'inaa Godaw,","poem":1},{"text":"neeni barentta kawushshiyaawanttu amuwaa sisaasa.","poem":2},{"text":"Neeni unttuntta mintsetsaasa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yi'atoone un\"etteeddawanttoo tumuwaa pirddaa;","poem":1},{"text":"sa'aan de'iyaa asay, unttuntta yashissenna mala,","poem":2},{"text":"Unttunttu waasuwaa sisaasa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}