oem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ayaw gooppe, Med'inaa Goday keeka.","poem":1},{"text":"Aggena Aa siik'uu med'inaassa;","poem":2},{"text":"I yeletaappe yeletaa gakkanaw ammanettiyaawaa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}