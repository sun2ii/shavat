{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":101,"content":[{"type":"heading","content":["Kaatii S'oossaw Geliyaa K'aalaa C'aak'uwaa"]},{"type":"hebrew_subtitle","content":["Daawita mazamuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Taani aggena siik'uwaabaanne s'illo pirddaabaa yes's'ana;","poem":1},{"text":"abeet Med'inaa Godaw, taani new yes's'ana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taani suure ogiyaabaa k'oppana.","poem":1},{"text":"Neeni taakko awude yaan?","poem":2},{"text":"Taani ta golliyaan suuretetsan hamettana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Taani ta ayifiyaan pokkobaa s'eellikke.","poem":1},{"text":"S'oossaappe wora simmeedda asatuwaa oosuwaa is's'ay;","poem":2},{"lineBreak":true},{"text":"unttunttu mulekka taananna gidikkino.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wozanaa geellatetsay taappe haakko;","poem":1},{"text":"iitatetsaa taani erikke.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Geeman bare shooruwaa zigiriyaawaa,","poem":1},{"text":"taani sirp'p'i ootsana.","poem":2},{"text":"Otorettiyaanne ayyiyaa asaa taani danddaykke.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Unttunttu taananna de'ana mala,","poem":1},{"text":"biittaa bolla de'iyaa ammanettiyaawantta,","poem":2},{"lineBreak":true},{"text":"taani keeka ayifiyaan s'eellay.","poem":2},{"text":"Suuretetsan hamettiyaa Asay taw kiitettana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"C'immiyaawe ta golliyaan de'enna;","poem":1},{"text":"wordduwaa haasayiyaawe ta sintsan gam\"enna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Biittan de'iyaa iita asaa ubbaa,","poem":1},{"text":"taani gallassi gallassi d'ayissana;","poem":2},{"lineBreak":true},{"text":"iitaa ootsiyaawantta ubbaa,","poem":2},{"lineBreak":true},{"text":"taani Med'inaa Godaa katamaappe d'ok'ollana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}