{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":102,"content":[{"type":"heading","content":["Metuwaa bolla De'iyaa Asaa Woosaa"]},{"type":"hebrew_subtitle","content":["Med'inaa Godaa Sintsaan barena Dogiide Bare Kayyuwaa gussiyaa Wode, Tuggateedda Asay woosseedda woosaa."]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, ta woosaa sisa;","poem":1},{"text":"ta waasuu neekko gakko.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta waayiyaa gallassi,","poem":1},{"text":"ne som\"uwaa taappe gentsoppa.","poem":2},{"text":"Ne haytsaa taakko yegga;","poem":1},{"text":"taani new waassiyaa wode, taana ellekka alla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ayaw gooppe, ta laytsay c'uwaadan d'ayee;","poem":1},{"text":"ta mek'etsaykka tamaa bonk'k'uwaadan ees's'ee.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ta wozanay shoc'i yeggeedda mela maataadan hanaad;","poem":1},{"text":"k'umaykka taw meetettenna.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Taani ta k'aalaa d'ok'k'u ootsaade oolay;","poem":1},{"text":"ta galbbay mek'etsaanna oyk'k'etteedda.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani bazzuwaan de'iyaa ankkuwaa mala,","poem":1},{"text":"woy koleteedda golliyaan de'iyaa guttuwaa mala.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Taani gisina, gem\"ishuu yeenna;","poem":1},{"text":"taani golliyaa huup'iyaan barekka utteedda kafuwaa mala.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ta morkketuu gallassaa ubbaan taana c'ashiino;","poem":1},{"text":"taana k'iliic'iyaawanttu ta suntsan shek'iino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Taani bidintsaa k'umaadan may;","poem":1},{"text":"k'ay ta afotsaa ta ushshaanna walakkay.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Neeni taana pude dentsaade,","poem":1},{"text":"ne hank'k'uwaa diraw wora olaadda.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta de'uwaa laytsay omarssa kuwaa mala;","poem":1},{"text":"taani maataadan shulay.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Shin abeet Med'inaa Godaw,","poem":1},{"text":"neeni kawutetsaa araatan med'inaw uttaadda;","poem":2},{"lineBreak":true},{"text":"ne suntsaykka yeletaappe yeletaa gakkanaw hassayettana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Neeni denddaade, S'iyoonew k'aretta;","poem":1},{"text":"ayaw gooppe, neeni izo maariyaa wodii gakkeedda;","poem":2},{"lineBreak":true},{"text":"hawe neeni dooreedda wodiyaa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iza koletteeddawaa gidooppekka,","poem":1},{"text":"ne k'oomatuu izo siik'iino.","poem":2},{"text":"Iza bayeeddawaa gidooppekka,","poem":1},{"text":"unttunttu iziw k'arettiino.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kawutetsatuu Med'inaa Godaa suntsaw yayana;","poem":1},{"text":"sa'aa kaatetuu ubbay Aa anggaw dagamana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ayaw gooppe, Med'inaa Goday S'iyoone zaaretsi kees's'iide,","poem":1},{"text":"I bare gitatetsaa bessana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"I puteesatuwaa woosaa sisana;","poem":1},{"text":"unttunttu waasuwaa kad'enna.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Biro yelettana asatuu Med'inaa Godaa galatana mala,","poem":1},{"text":"hawe yiyaa yeletaw s'aafetto.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Med'inaa Goday d'ok'k'an de'iyaa bare geeshsha sa'aappe duge s'eelleedda;","poem":1},{"text":"I saluwaappe duge sa'aa s'omooseedda.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hewenne, k'ashetteedda asatuwaa ooliyaa sisanaassanne","poem":1},{"text":"hayk'k'oo pirddetteedda asatuwaa billanaassa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hewaa diraw, Med'inaa Godaa suntsay S'iyoonen odettananne","poem":1},{"text":"Aa galatay Yerusaalamen awaayetana.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Asaynne kawutetsay ittippe shiik'iide,","poem":1},{"text":"Med'inaa Godaw he wode goyinnana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"I taani yalagatetsan de'iina,","poem":1},{"text":"ta wolk'k'aa wursseedda;","poem":2},{"lineBreak":true},{"text":"ta laytsaa k'antsayeedda.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yaatina, taani, «Abeet ta S'oossaw,","poem":1},{"text":"ta laytsay biro giddottiyaa wode,","poem":2},{"lineBreak":true},{"text":"taana afoppa» yaagay.","poem":2},{"lineBreak":true},{"text":"Abeet S'oossaw, neeni yeletaappe yeletaa gakkanaw de'aassa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Neeni beni sa'aa med'd'aadda;","poem":1},{"text":"saluukka ne kushiyaa oosuwaa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hewanttu ubbay d'ayana; shin neeni de'ana;","poem":1},{"text":"unttunttu ubbaykka afilaadan wurana.","poem":2},{"text":"Neeni unttuntta c'urk'k'a afilaadan laammana;","poem":1},{"text":"unttunttukka aad'd'ana.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Shin neeni neenakka; ne laytsay ubbaa wurenna.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Nuuni ne k'oomatuwaa;","poem":1},{"text":"nu naanatuu sarotetsaan de'ana.","poem":2},{"text":"Unttunttu zeretsaykka ne sintsan minniide ek'k'ana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}