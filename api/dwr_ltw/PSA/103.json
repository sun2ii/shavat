{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":103,"content":[{"type":"heading","content":["S'oossaa Siik'uwaa"]},{"type":"hebrew_subtitle","content":["Daawite s'aafeeddawaa"]},{"type":"verse","number":1,"content":[{"text":"Ta shemppattee, Med'inaa Godaa galataa!","poem":1},{"text":"Ta kumentsaa asatetsaw, Aa geeshsha suntsaa galataa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta shemppattee, Med'inaa Godaa galataa!","poem":1},{"text":"I new ootseedda keekkatetsaa ubbaa dogoppa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"I ne nagaraa ubbaa atto gee;","poem":1},{"text":"I ne harggiyaa ubbaappe neena patsee.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I neena duufuwaan gelennaadan ashshee;","poem":1},{"text":"aggena siik'uwaaninne maarotaan neena anjjee.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Arggantsaadan neeni yalagana mala,","poem":1},{"text":"I ne de'uwaa ubbaan neena lo\"obaa kalissee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Med'inaa Goday naak'etteeddawanttoo","poem":1},{"text":"s'illobaa ootseenne suuriyaan pirddee.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I bare ogiyaa Musa,","poem":1},{"text":"bare oosuwaa Israa'eeliyaa asaw erisseedda.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Med'inaa Goday k'arettiyaawaanne maariyaawaa;","poem":1},{"text":"I hank'k'ettanaw elleellennawaanne","poem":2},{"lineBreak":true},{"text":"aggena siik'uu daruwaa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I ubbaa gede seerenna; med'inaw hank'k'ettenna.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I nuuna nu nagaraadan ootsibeenna;","poem":1},{"text":"nu iitatetsaadan nuw zaaribeenna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Saluu sa'aappe d'ok'k'iyaawaadan,","poem":1},{"text":"Med'inaa Godaw yayyiyaawanttoo aggena Aa siik'uu dara.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Away doliyaasaappe away wulliyaasay haakkiyaawaadan,","poem":1},{"text":"Med'inaa Goday nu bayzzuwaa nuuppe haassee.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Aawuu bare naanaatoo k'arettiyaawaadan,","poem":1},{"text":"Med'inaa Goday barew yayyiyaawanttoo k'arettee.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ayaw gooppe, nuuni ayaappe med'etteeddentto I eree;","poem":1},{"text":"nuuni biittaa gidiyaawaa I akeekee.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Asaa gidooppe, Aa de'uu maataa mala;","poem":1},{"text":"I bazzuwaa c'iishshaadan c'iishshee;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"c'arkkuu Aa bolla c'arkkina d'ayeedda;","poem":1},{"text":"I doleedda sa'ay erettenna.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Shin Med'inaa Godaw yayyiyaawanttoo,","poem":1},{"text":"aggena Aa siik'uu med'inaappe med'inaa gakkanaassa.","poem":2},{"text":"Aa s'illotetsaykka na'aa na'aw gakkanaassa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Aa c'aak'uwaa naagiyaawanttussanne","poem":1},{"text":"Aa azazuwaa polanaw hassayiyaawanttussa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Med'inaa Goday salotuwaan bare kawutetsaa araataa esseedda;","poem":1},{"text":"Aa kawutetsay ubbaa mooddee.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hinttenoo, Aa kiitanchchatoo,","poem":1},{"text":"Aa azazuwaa poliyaa wolk'k'aamatoo,","poem":2},{"text":"I giyaawaa sisisiyaawantto,","poem":1},{"text":"Med'inaa Godaa galatite!","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hinttenoo saluwaan de'iyaa minotoo,","poem":1},{"text":"Aa sheniyaa ootsiyaa k'oomatoo,","poem":2},{"text":"Med'inaa Godaa galatite!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Hinttenoo,","poem":1},{"text":"I mooddiyaa sa'aa ubbaa med'etatoo,","poem":2},{"lineBreak":true},{"text":"ubbaykka Med'inaa Godaa galatite!","poem":2},{"lineBreak":true},{"text":"Ta shemppattee, Med'inaa Godaa galataa!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}