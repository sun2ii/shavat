{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":104,"content":[{"type":"heading","content":["S'oossaw Shiik'iyaa Galataa"]},{"type":"verse","number":1,"content":[{"text":"Ta shemppattee, Med'inaa Godaa galataa!","poem":1},{"text":"Abeet Med'inaa Godaw ta S'oossaw, neeni ay keeshshaa gitee!","poem":2},{"text":"Neeni bonchchuwaanne anggaa mayyaadda.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Poo'uwaa afilaadan gullotaadda.","poem":1},{"text":"Neeni saluwaa dunkkaaniyaadan tolaadda.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne golliyaa saluwaa guufantsuwaa bollan kees's'aasa.","poem":1},{"text":"Shaariyaa paraa gaariyaa kessaasa;","poem":2},{"lineBreak":true},{"text":"c'arkkuwaa k'efiyaan toggaasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Neeni c'arkkotuwaa ne kiitanchchaa,","poem":1},{"text":"tamaa lac'uwaakka ne k'ooma kessaasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Neeni sa'aa Aa baasuwaa bolla essaadda;","poem":1},{"text":"I med'i med'inawukka k'aas's'enna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wolk'k'aama abbay biittaa bollan afilaadan mic'etteedda;","poem":1},{"text":"haatsay wolk'k'aama deretuwaa kammeedda.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Shin ne godetina haatsatuu bak'ateeddino;","poem":1},{"text":"ne azazuwaa sisiide, elleelleeddino.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Unttunttu wogga deretuwaappe duge zanggaaraa,","poem":1},{"text":"neeni unttunttoo giigiseedda sa'aa goggeeddino.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Haatsatuu simmiide biittaa kammennaadan,","poem":1},{"text":"unttunttu aad'd'anaw danddayenna zawaa essaadda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Neeni pulttotuwaa zanggaaraan pulttissaasa;","poem":1},{"text":"unttunttu haatsay deretuwaa gidduwaana goggee.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Goggiyaawaappe bazzuwaa do'atuu ubbay ushiino;","poem":1},{"text":"denbbaa haretuu barenttu saamuwaa aappe aliino.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Saluwaa kafotuu he haatsaa matan barenttu golliyaa kees's'iide,","poem":1},{"text":"tashiyaa giddon yes's'iino.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Neeni wolk'k'aama deretuwaa bollan","poem":1},{"text":"saluwaappe iraa bukissaasa;","poem":2},{"lineBreak":true},{"text":"biittakka ne kushiyaa oosuwaa ayifiyaan kalissaasa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Neeni mehiyaw maataa,","poem":1},{"text":"asaw katsaa mokissaasa.","poem":2},{"text":"Hewenne, Asay biittaa ootsiide,","poem":1},{"text":"biittaappe katsaa demanaassa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Asaa wozanaa nashechchiyaa woyniyaa,","poem":1},{"text":"som\"uwaa shic'issiyaa zayitiyaanne","poem":2},{"lineBreak":true},{"text":"wolk'k'aa kuntsiyaa k'umaa mokissaassa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Med'inaa Godaa mitsatuu,","poem":1},{"text":"I tokkeedda Liibaanoosa zigatuu,","poem":2},{"lineBreak":true},{"text":"daro iraa ushiino.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Unttunttun kafotuu barenttu golliyaa kees's'iino;","poem":1},{"text":"k'oolletuukka s'iidaa bolla kees's'iide de'iino.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"D'ok'k'a deretuwaa bollan gaaratuu de'iino;","poem":1},{"text":"k'ay guppalletuu Shuchchaa gonggoluwaan k'osettiino.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wodiyaa payduwaa erissana mala,","poem":1},{"text":"neeni aginaa med'd'aadda.","poem":2},{"text":"Away bare wulliyaa wodiyaa eree.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Neeni k'ammaa med'd'aadda;","poem":1},{"text":"d'uman do'ay ubbay kesee.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Wodalla gaammotuu shankkatiidde gudiino;","poem":1},{"text":"unttunttu barenttoo miyaawaa S'oossaappe koyiino.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Away kesiyaa wode,","poem":1},{"text":"guyye simmiide barenttu geessuwaan gisiino.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"He wode Asay bare oosoo kesee;","poem":1},{"text":"sa'ay k'ammana gakkanaw ootsee.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Abeet Med'inaa Godaw, ne oosuu ay keeshshaa daree!","poem":1},{"text":"Ne aad'd'eeda eratetsan neeni unttunttu ubbaa med'd'aadda;","poem":2},{"lineBreak":true},{"text":"sa'ay neeni med'd'eeddawan kumeedda.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Abbay hinin hewesh; I wolk'k'aamanne aakko;","poem":1},{"text":"payduu bayinna k'aas's'iyaa med'etatuwaan,","poem":2},{"lineBreak":true},{"text":"gitatuwaaninne guutsatuwaan kumiide de'ee.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hewaa bollan markkabatuu biino;","poem":1},{"text":"k'ay neeni med'd'eedda Leewaataana giyaa dawii an kaa'ee.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Neeni unttuntta koshshiyaa wodiyaan","poem":1},{"text":"unttunttoo k'umaa immana mala,","poem":2},{"lineBreak":true},{"text":"unttunttu ubbay neena s'eelliino.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Neeni unttunttoo immina, unttunttu mas'iino;","poem":1},{"text":"neeni ne kushiyaappe yeggina,","poem":2},{"lineBreak":true},{"text":"unttunttu lo\"obaa kalliino.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Neeni ne som\"uwaa gentsiyaa wode dagammiino.","poem":1},{"text":"Ne shemppuwaa neeni akkiyaa wode hayk'k'iide,","poem":2},{"lineBreak":true},{"text":"barenttu biittaw simmiino.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Shin neeni ne shemppuwaa kiittiyaa wode,","poem":1},{"text":"haratuu med'ettiino; biittaakka ooratsaasa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Med'inaa Godaa bonchchuu med'inaw de'o;","poem":1},{"text":"Med'inaa Goday bare oosuwaan nashetto.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"I biittaa s'eellina, biittay k'aas's'ee;","poem":1},{"text":"k'ay I deretuwaa bochchina, deretuu c'uwattiino.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Taani ta de'uwaa ubbaan Med'inaa Godaw yes's'ana;","poem":1},{"text":"taani de'eedda laytsaa ubbaan ta S'oossaa sabbana.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Taani Med'inaa Godaan nashettiyaa diraw,","poem":1},{"text":"ta k'ofay Aa nashechcho.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Nagaranchchatuu biittaappe d'ayino;","poem":1},{"text":"hawaappe sintsaw iitatuu de'oppino.","poem":2},{"lineBreak":true},{"text":"Ta shemppattee, Med'inaa Godaa galataa! Med'inaa Godaa galatite!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}