{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":105,"content":[{"type":"heading","content":["Maalalisiyaa Israa'eeliyaa Taarikiyaa"]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Godaa galatite; Aa suntsaa s'eesite.","poem":1},{"text":"I ootseeddawaa kawutetsatuwaa gidduwaan erissite.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Aa sabbite; galataa yetsaa aw yes's'ite.","poem":1},{"text":"Aa malalissiyaa oosuwaa ubbabaa odite.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Aa geeshsha suntsan c'eek'ettite;","poem":1},{"text":"Med'inaa Godaa koyiyaa wozanatuu nashetino.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Med'inaa Godaanne Aa wolk'k'aa s'omoosite;","poem":1},{"text":"ubbaa gede Aa sintsa koyite.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I ootseedda malalissiyaabaa,","poem":1},{"text":"Aa malaataanne I pirddeedda pirddaa hassayite.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hinttenoo,","poem":1},{"text":"Aa k'oomaa Abrahaama zeretsatoo,","poem":2},{"lineBreak":true},{"text":"dooretteedda Yaak'ooba naatoo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"I Med'inaa Godaa nu S'oossaa;","poem":1},{"text":"Aa tumo pirddaykka sa'aa ubbaa bollaanna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"I bare c'aak'uwaa med'inaw,","poem":1},{"text":"bare azazeedda k'aalaa sha\"u yeletaa gakkanaw naagee.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hewenne, I, Abrahaamana c'aak'k'eteedda c'aak'uwaa,","poem":1},{"text":"Yisaak'aw c'aak'k'eedda c'aak'uwaa,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yaak'oobaw woga,","poem":1},{"text":"Israa'eeliyawukka med'inaa c'aak'uwaa","poem":2},{"lineBreak":true},{"text":"ootsiide miniseedda.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hawaadan yaageedda;","poem":1},{"text":"«New Kanaane biittaa immana;","poem":2},{"text":"I ne zeretsatoo laata gidana» yaageedda.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"S'oossaa asatuu payduwaan s'ii guutsanne","poem":1},{"text":"Kanaane biittan bete gidiide de'iyaa wode,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"itti gadiyaappe hara gadiyaa,","poem":1},{"text":"itti kawutetsaappe hara kawutetsaa yuuyyeeddino.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"S'oossay unttuntta ooninne naak'k'anaw immibeenna;","poem":1},{"text":"unttunttu diraw kaatetuwaa seeriidde,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"«Taani okkeeddawantta bochchoppite;","poem":1},{"text":"ta timbbitiyaa odiyaawantta k'ohoppite» yaageedda.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"S'oossay biittan koshaa yeddiide,","poem":1},{"text":"unttunttu katsaa ubbaa d'ayisseedda.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Shin I bare asaa ashshanaw,","poem":1},{"text":"itti bitaniyaa Gibs'e kiitteedda;","poem":2},{"lineBreak":true},{"text":"he bitanii ayille gidiide zal\"eteedda Yooseefa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Aa gedetuu birataan k'ashetteeddino;","poem":1},{"text":"unttunttu Aa sanssalatan k'achcheeddino.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"I kase odeeddawe polettana gakkanaw,","poem":1},{"text":"Med'inaa Godaa k'aalay Aa paac'c'eedda.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Gibs'e kaatii kiittiide k'asho golliyaappe keseedda,","poem":1},{"text":"Gadiyaa mooddiyaawe billeedda.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ikka, Aa bare golliyaw godaa ootseeddanne.","poem":1},{"text":"Barew de'iyaawaa ubbaa bolla suntseedda.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Barew waanna kaappotuwaa azazana malanne","poem":1},{"text":"bare c'imatuwaa zorana mala maatayeedda.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hewaappe guyyiyaan, Israa'eelii Gibs'e geleedda,","poem":1},{"text":"Yayk'k'oobe Kaame biittan bete gidiide de'eedda.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Med'inaa Goday bare asaa daro c'orayeedda;","poem":1},{"text":"unttunttu morkkatuwaappe unttuntta aatsiide mintsetsee.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"I Gibs'e Asay bare asaa is's'anaadaaninne","poem":1},{"text":"bare k'oomatuwaa c'immanaadan ootseedda.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hewaappe guyyiyaan, bare k'oomaa Musanne","poem":1},{"text":"bare dooreedda Aaroona unttunttukko kiitteedda.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Unttunttu Gibs'e asatuwaa sintsan S'oossaa malaataa,","poem":1},{"text":"Kaame biittan ooratsabaa ootseeddino.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"S'oossay d'umaa kiittiide,","poem":1},{"text":"he biittaa d'umisseedda;","poem":2},{"lineBreak":true},{"text":"shin Gibs'e asatuu Aa azazuwaa is's'eeddino.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"I Unttunttu haatsaa suutsaw laammiide,","poem":1},{"text":"moletuwaa wod'eedda.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Unttunttu biittaa ubbaa,","poem":1},{"text":"kaatiyaa golliyaakka shed'd'ii kumeedda.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"I azazina, uduns's'iinne biinnii","poem":1},{"text":"unttunttu biittaa ubbaa bolla sham\"isham\"eedda.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Unttunttu biittaa bollan iraa diraw","poem":1},{"text":"shachchaa walk'k'antsaanna bukisseedda.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"I unttunttu woyniyaa turaanne","poem":1},{"text":"balasiyaa giyaa mitsaa shoc'eedda;","poem":2},{"lineBreak":true},{"text":"unttunttu biittan de'iyaa mitsaakka kinchchereetseedda.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"I azazina, booliinne","poem":1},{"text":"payduu bayinna bumbburetsay keseedda.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Unttunttu biittan doleedda katsaa ubbaa meedda;","poem":1},{"text":"sa'aappe irs's'abaa ubbaakka mi d'ayisseedda.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"S'oossay Gibs'e asatuwaa golle bayira naanatuwaa ubbaa wod'eedda;","poem":1},{"text":"koyiro yeletteedda ubbaa d'ayisseedda.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Hewaappe guyyiyaan, I Israa'eeliyaa asaa","poem":1},{"text":"work'k'aanne biraa alleek'k'uwaana kesseedda;","poem":2},{"lineBreak":true},{"text":"unttunttu giddoppe kunddiide atteedawe ooninne baawa.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Gibs'e asatuu unttunttoo daro yayyeedda diraw,","poem":1},{"text":"unttunttu keseeddawaan nashetteeddino.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"S'oossay unttuntta kammanaw shaariyaa mic'c'eedda;","poem":1},{"text":"k'amma unttunttoo poo'issanaw tamaa giigisseedda.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Unttunttu miyaawaa oochchina,","poem":1},{"text":"akkaa malatiyaa kafotuwaa unttunttoo yeddeedda;","poem":2},{"lineBreak":true},{"text":"unttuntta saluwaa k'umaa kalisseedda.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"I shuchchaa p'alk'k'ina,","poem":1},{"text":"haatsay pultteedda;","poem":2},{"lineBreak":true},{"text":"shaafaadan bazzuwaan goggeedda.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"I bare k'oomaa Abrahaamaw,","poem":1},{"text":"geleedda geeshsha k'aalaa hassayeedda.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"I bare asaa nashshechchan,","poem":1},{"text":"bare dooreeddawantta ililssan kesseedda.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"I unttunttoo hara asatuwaa biittaa immeedda;","poem":1},{"text":"unttunttu haratuu daabureedda goshshaa laatteeddino.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Hewaa I ootseeddawe unttunttu Aa wogaa","poem":1},{"text":"naaganaadaananne Aa higgiyaa ootsanaadaana.","poem":2},{"lineBreak":true},{"text":"Med'inaa Godaa galatite!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":45}