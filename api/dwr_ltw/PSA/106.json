{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":106,"content":[{"type":"heading","content":["S'oossay Bare Asaw Bessiyaa Keekatetsaa"]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Godaa galatite!","poem":1},{"text":"I keeka gidiyaa dirawunne,","poem":2},{"lineBreak":true},{"text":"aggena Aa siik'uu med'inaawaa gidiyaa diraw,","poem":2},{"lineBreak":true},{"text":"Med'inaa Godaa galatite.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Med'inaa Goday ootseedda wolk'k'aama oosuwaa odanaw,","poem":1},{"text":"woy Aa galataa ubbaa k'onc'c'issanaw, danddayiyaawe oonee?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pirddaa naagiyaawanttunne,","poem":1},{"text":"ubbaa gede s'illobaa ootsiyaawanttu anjjetteeddawantta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Abeet Med'inaa Godaw, neeni ne asaw keekkiyaa wode,","poem":1},{"text":"taanakka k'oppa;","poem":2},{"lineBreak":true},{"text":"unttuntta neeni ashshiyaa wode,","poem":2},{"lineBreak":true},{"text":"tawukka alla.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hewenne, ne dooreedda asaw,","poem":1},{"text":"sa'ay lo\"ina, taani be'anaadaana;","poem":2},{"lineBreak":true},{"text":"ne asaa nashshechchaa taanikka nashettanaadaaninne","poem":2},{"lineBreak":true},{"text":"newanttunna ittippe taanikka galatanaadaana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nuuni nu aawotuwaadan nagaraa ootseeddo;","poem":1},{"text":"bayzzobaanne iitabaa ootseeddo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nu aawotuu Gibs'en de'iyaa wode,","poem":1},{"text":"ne malalissiyaa oosuwaa k'oppibeykkino.","poem":2},{"text":"Aggena ne siik'uwaa darotetsaa unttunttu hassayibeykkino;","poem":1},{"text":"Zo'o Abbaa lank'k'iyaan ne bolla makkaleeddino.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gidooppekka I bare suntsaa diraw,","poem":1},{"text":"bare wolk'k'aama wolk'k'aa erissanaw unttuntta ashsheeda.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I Zo'o Abbaa azazina, abbay meleedda;","poem":1},{"text":"bazzuwaan kaaletsiyaawaadan,","poem":2},{"lineBreak":true},{"text":"c'iimmaa gidduwaana unttuntta kaaletsiide pintseedda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"I unttuntta is's'iyaawanttu kushiyaappe ashsheeda;","poem":1},{"text":"morkkatuwaa kushiyaappe unttuntta wozeedda.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Unttunttu morkkatuwaa haatsay mitteedda;","poem":1},{"text":"unttunttuppe ittuunne attibeena.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"He wode Israa'eelatuu Aa k'aalaa ammaneeddino;","poem":1},{"text":"Aa sabbeeddino.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gidooppenne, unttunttu I ootseeddawaa","poem":1},{"text":"ellekka dogeeddino.","poem":2},{"text":"Aa zoriyaa naagennan barenttu koyeeddawaa ootseeddino.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bazzuwaan de'iiddi, unttunttu","poem":1},{"text":"daroppe amotteeddino;","poem":2},{"lineBreak":true},{"text":"k'ay mela biittaan S'oossaa paac'c'eeddino.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hewaadan I unttunttu woosseeddawaa immeedda;","poem":1},{"text":"shin unttunttu shemppoo gilk'k'atetsaa kiitteedda.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Asatuu bazzuwaan barenttu dunkkaaniyaan de'iiddi,","poem":1},{"text":"Musanne Med'inaa Godaw dummateedda,","poem":2},{"lineBreak":true},{"text":"k'oomaa Aaroona k'anaateedda wode,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"biittay dooyettiide Daataana mitteedda;","poem":1},{"text":"Abiiraam Aa golliyaa asatuwaana moogeedda.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"K'ay unttunttu maabaraa giddon tamay ees's'ina,","poem":1},{"text":"lac'uu he iita asatuwaa s'uuggeedda.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Koreeba Deriyan de'iiddi,","poem":1},{"text":"work'k'aa muushisiide maraa misiliyaa med'd'eeddino;","poem":2},{"lineBreak":true},{"text":"he misiliyaw goyinneeddino.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Unttunttu barenttu bonchcho S'oossaa","poem":1},{"text":"maataa miyaa miizzaa misiliyaan laammeeddino.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Unttunttu barena ashsheeda S'oossaa dogeeddino;","poem":1},{"text":"I Gibs'en wolk'k'aama oosuwaa,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kaame biittan malalissiyaabaanne,","poem":1},{"text":"Zo'o Abban, «Hoola!» giissiyaabaa ootseedda.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hewaa diraw, S'oossay unttuntta d'ayissana geedda;","poem":1},{"text":"shin d'ayissenna mala, Aa hank'k'uwaa zaaranaw,","poem":2},{"text":"S'oossay dooreedda Muse gidduwaan ek'k'eedda.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Hewaappe guyyiyaan, unttunttu","poem":1},{"text":"Aa k'aalaa ammanenna diraw,","poem":2},{"lineBreak":true},{"text":"he lo\"o biittaa kad'eeddino.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Unttunttu barenttu dunkkaaniyaa giddon","poem":1},{"text":"zuuzummeeddinonne","poem":2},{"text":"Med'inaa Godaa k'aalaw azazettibeykkino.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Hewaa diraw, I unttuntta bazzuwaan agganawaa,","poem":1},{"text":"Bare kushiyaa dentsiide c'aak'k'eedda.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Unttunttu zeretsaa kawutetsatuwaa giddon agganawunne","poem":1},{"text":"biittan unttuntta laalanaw c'aak'k'eedda.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Hewaappe guyyiyaan, unttunttu Pa'ooran de'iyaa Ba'aala eek'aw,","poem":1},{"text":"goyinniyaawanttunna ittippe gakketeeddino;","poem":2},{"lineBreak":true},{"text":"shemppuu bayinna eek'atoo yarshshetteedda yarshshuwaa meeddino.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Unttunttu barenttu oosuwaan Med'inaa Godaa hank'k'etseeddino;","poem":1},{"text":"unttunttu giddon iita harggii wod'd'eedda.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Shin Piinhaasi denddiide,","poem":1},{"text":"unttunttu bayzzuwaa pirddina,","poem":2},{"lineBreak":true},{"text":"iita harggii unttunttu bollaappe kichcheedda.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Hewenne, yeletaappe yeletaa gakkanaw,","poem":1},{"text":"med'inaw aw s'illotetsaa gidiide paydeteedda.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Mariiba pulttuwaa matan Med'inaa Godaa hank'k'etseeddino;","poem":1},{"text":"unttunttu gaasuwaan Muse bolla metuu gakkeedda.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ayaw gooppe, unttunttu Aa hank'k'etseeddino;","poem":1},{"text":"Muse doonaappe bessena k'aalay keseedda.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Med'inaa Goday d'ayissite giina,","poem":1},{"text":"unttunttu Kanaane asatuwaa d'ayissibeykkino.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Hewaappekka, unttunttu he asatuwaana","poem":1},{"text":"geletti akkettiide, walaketteeddinonne;","poem":2},{"lineBreak":true},{"text":"unttunttu de'uwaa wogaa kaalleeddino.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"S'oossaa asatuu unttunttu eek'aw goyinneeddino;","poem":1},{"text":"hewenne, unttunttoo p'ire gideedda.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Unttunttu barenttu attumanne mac'c'a naanatuwaa","poem":1},{"text":"s'alahetoo yarshsheeddino.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Unttunttu, s'illo suutsaa","poem":1},{"text":"Kanaane eek'atoo yarshsheeddino;","poem":2},{"lineBreak":true},{"text":"barenttu attumanne mac'c'a naanatuwaa suutsaa gusseeddino;","poem":2},{"lineBreak":true},{"text":"he suutsan biittay tuneedda.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Hewaadan unttunttu barenttu oosuwaan tuneeddinonne,","poem":1},{"text":"sharmus'aadan unttunttu barenttu S'oossaw ammanettennan is's'eeddino.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Hewaa diraw, Med'inaa Godaa hank'k'uu,","poem":1},{"text":"Aa asaa bolla ees's'i keseedda;","poem":2},{"text":"I barewantta sheneteedda.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"I unttuntta hara gadiyaa asatuwaa kushiyan aatsiide immeedda;","poem":1},{"text":"unttunttu is's'eeddawanttu unttuntta mooddeeddino.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Unttunttu morkketuu unttuntta naak'k'eeddinonne","poem":1},{"text":"barenttu sheniyaadan ayisseedino.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"I unttuntta daro gede ashsheedda;","poem":1},{"text":"shin unttunttu makkalaw danc'c'i denddeeddino;","poem":2},{"lineBreak":true},{"text":"barenttu nagaraa gaasuwaan d'ayeeddino.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Gidooppenne, I unttunttu waasseedda waasuwaa sisiide,","poem":1},{"text":"unttunttu waayiyaa k'oppeedda.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"I unttunttu diraw, bare c'aak'uwaa hassayeedda;","poem":1},{"text":"aggena bare siik'uwaa daruwaadan unttuntta maareedda.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Unttuntta omoodeedda ubbay unttunttoo k'arettanaadan ootseedda.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Abeet Med'inaa Godaw, nu S'oossaw, nuuna ashsha.","poem":1},{"text":"Nuuni ne geeshsha suntsaa galatanaadaaninne","poem":2},{"lineBreak":true},{"text":"ne bonchchuwaan c'eek'ettanaadan,","poem":2},{"lineBreak":true},{"text":"kawutetsatuwaa giddoppe nuuna shiishsha.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Med'inaa Goday, Israa'eeliyaa S'oossay","poem":1},{"text":"med'inaappe med'inaa gakkanaw galatetto!","poem":2},{"text":"Asay ubbay, «Amen\"i!» go.","poem":1},{"lineBreak":true},{"text":"Med'inaa Godaa galatite!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}