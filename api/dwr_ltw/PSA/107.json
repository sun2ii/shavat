{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":107,"content":[{"type":"heading","content":["Metuwaa Ubbaappe Ashiyaa S'oossaa Galatite"]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Godaa galatite! Ayaw gooppe,","poem":1},{"text":"I keeka; aggena Aa siik'uu med'inaassa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Med'inaa Goday ashsheedawanttunne,","poem":1},{"text":"morkkatuwaa kushiyaappe wozeeddawanttu,","poem":2},{"lineBreak":true},{"text":"hewaadan giide haasayino.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Unttuntta I biittatuwaappe,","poem":1},{"text":"away doliyaasaappenne wulliyaasaappe,","poem":2},{"lineBreak":true},{"text":"huup'issanne gedissa baggappe","poem":2},{"lineBreak":true},{"text":"shiishsheeddawantta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Unttunttuppe ittuu ittuu bazzuwaa biittan yuuyyeeddino.","poem":1},{"text":"Barenttu de'iyaa katamaa biyaa ogiyaa,","poem":2},{"lineBreak":true},{"text":"demmanaw danddayibeykkino.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Unttunttu koshateeddinonne saametteeddino;","poem":1},{"text":"unttunttu yibbaateeddino.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Unttunttu metooteedda wode,","poem":1},{"text":"Med'inaa Godaw waasseeddino;","poem":2},{"text":"I unttuntta unttunttu waayiyaappe ashsheeda.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Unttunttu de'ana katamaa gakkanaw,","poem":1},{"text":"I unttuntta sitta ogiyaanna kaaletseedda.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Aggena Aa siik'oonne,","poem":1},{"text":"I asaw ootseedda malalissiyaabaw,","poem":2},{"lineBreak":true},{"text":"unttunttu Med'inaa Godaa galatino.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ayaw gooppe, I saametteeddawantta alee;","poem":1},{"text":"Koshatteeddawanttakka lo\"obaa kalissee.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Unttunttuppe ittuu ittuu","poem":1},{"text":"d'ip'p'i go d'umaa giddon utteeddino;","poem":2},{"text":"Unttunttu birataa sanssalatan waayetteeddino.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ayaw gooppe, unttunttu S'oossaa k'aalaw makkaleeddinonne,","poem":1},{"text":"Ubbaappe D'ok'k'iyaa S'oossaa zoriyaa kad'eeddino.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"I unttuntta tugga oosuwaan daabursseedda;","poem":1},{"text":"unttunttu kunddeeddino;","poem":2},{"lineBreak":true},{"text":"shin unttuntta maaddiyaawe d'ayeedda.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Unttunttu metooteedda wode, Med'inaa Godaw waasseeddino;","poem":1},{"text":"I unttuntta unttunttu waayiyaappe ashsheedda.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bareto d'umaappekka kesseedda;","poem":1},{"text":"unttunttu k'ashetteedda birataa sanssalataakka duutseedda.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Aggena Aa siik'oonne","poem":1},{"text":"I asaw ootseedda malalissiyaawoo","poem":2},{"lineBreak":true},{"text":"unttunttu Med'inaa Godaa galatino.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ayaw gooppe, I nahaasiyaappe oosetteedda penggiyaa mentseedda;","poem":1},{"text":"Birataa kulbbuwaakka d'ukkeedda.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Unttunttuppe ittuu ittuu booza gideeddino;","poem":1},{"text":"Barenttu ootseedda nagaraa gaasuwaaninne,","poem":2},{"lineBreak":true},{"text":"barenttu iitatetsaa gaasuwaan tuggateeddino.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Unttunttu k'uma ubbaa shenetiide,","poem":1},{"text":"hayk'k'oo mateeddino.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Unttunttu metooteedda wode, Med'inaa Godaw waasseeddino;","poem":1},{"text":"I unttuntta unttunttu waayiyaappe ashsheeda.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"I bare k'aalaa kiittiide, unttuntta patseedda;","poem":1},{"text":"duufuwaan geliyaawaappe ashsheeda.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Aggena Aa siik'oonne","poem":1},{"text":"I asaw ootseedda malalissiyaawoo","poem":2},{"lineBreak":true},{"text":"unttunttu Med'inaa Godaa galatino.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Unttunttu aw galataa yarshshuwaa yarshshino;","poem":1},{"text":"K'ay nashshechchaa yetsan I ootseeddawaa odino.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Unttunttuppe ittuu ittuu,","poem":1},{"text":"markkabiyaan wolk'k'aama abbaa bollan beeddino.","poem":2},{"text":"Unttunttu he wolk'k'aama abbaa bolla barenttu oosuwaa ootsiyaawantta.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Unttunttu Med'inaa Godaa oosuwaa,","poem":1},{"text":"I c'iimmaa garssan ootseedda malalissiyaabaa be'eeddino.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"I azaziide, gotiyaa dentseedda;","poem":1},{"text":"abbaa hobbii k'aas's'eedda.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Unttunttu pude saluwaa c'ugudetteeddino;","poem":1},{"text":"hewaappe duge c'iimmaa wod'd'eeddino.","poem":2},{"text":"He iita metuu gakkina, unttunttu wozanay toyyu geedda.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Unttunttu matsotteedda asaadan","poem":1},{"text":"d'ubettiide ganddigaareeddino;","poem":2},{"lineBreak":true},{"text":"unttunttu eraykka jolleedda.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Unttunttu metooteedda wode, Med'inaa Godaw waasseeddino;","poem":1},{"text":"I unttuntta unttunttu waayiyaappe ashsheeda.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"I gotiyaa c'o\"u ootseedda;","poem":1},{"text":"abbaa beetaakka sirp'p'i ootseedda.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"C'o\"u geedda diraw,","poem":1},{"text":"unttunttu nashetteeddino;","poem":2},{"text":"S'oossay unttuntta unttunttu amotteedda katamaa aheedda.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Aggena Aa siik'oonne","poem":1},{"text":"I asaw ootseedda malalissiyaabaw","poem":2},{"lineBreak":true},{"text":"unttunttu Med'inaa Godaa galatino.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Unttunttu Aa asatuwaa shiik'uwaan d'ok'k'u d'ok'k'u ootsino;","poem":1},{"text":"k'ay c'imatuwaa shiik'uwaan Aa galatino.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"S'oossay shaafatuwaa melisseedda;","poem":1},{"text":"pulttotuukka goggennaadan te\"eedda.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Hewan de'iyaa asatuwaa iitatetsaa diraw,","poem":1},{"lineBreak":true},{"text":"Mokkiyaa aradda biittaakka,","poem":1},{"text":"mokkenna mela biittaw laammeedda.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"I zaariide mela bazzuwaan haatsay eellanaadan,","poem":1},{"text":"k'ay mela biittan pulttuu d'uuk'k'anaadan ootseedda.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Kosheteeddawantta he sa'aan wotseedda;","poem":1},{"text":"unttunttu barenttoo de'iyaa katamaa kees's'eeddino.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Unttunttu barenttu goshshan zeriide,","poem":1},{"text":"woyniyaa tokkiide,","poem":2},{"lineBreak":true},{"text":"daro murutaa shiishsheeddino.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"I unttuntta anjjina, unttunttu loytsi c'oratteeddino;","poem":1},{"text":"unttunttu mehiyaakka guutsibeenna.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Asatuu s'oonettiyaa wodenne unttunttu uk'k'unnaa,","poem":1},{"text":"metuwaanne kayyuwaa gaasuwaan kawushiyaa wode,","poem":2}]},{"type":"verse","number":40,"content":[{"text":"S'oossay kaappotuwaa kad'eeddawaa bessee;","poem":1},{"text":"ogii bayinna bazzuwaan toyilakattanaadan I unttuntta ootsee.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Shin I hiyyeesatuwaa tuggaappe kessiide,","poem":1},{"text":"unttunttu golle asaa dorssaa wudiyaadan c'orayee.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Suure asatuu I ootsiyaawaa be'iide nashettiino;","poem":1},{"text":"shin iita asatuu ubbay c'o\"u giino.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Aad'd'eeda Eranchcha gidiyaawe ha yewuwaa k'oppo;","poem":1},{"text":"Med'inaa Godaa aggena siik'uwaa akeeko.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/107.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/108.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/106.json","previousChapterAudioLinks":{},"numberOfVerses":43}