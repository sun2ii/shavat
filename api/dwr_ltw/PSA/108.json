{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":108,"content":[{"type":"heading","content":["Wontta Sabaanne Galataa"]},{"type":"hebrew_subtitle","content":["Daawita mazamuriyaa, yetsaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet S'oossaw, ta wozanay minniide de'ee.","poem":1},{"text":"Taani new ta kumentsaa wozanaappe yes's'ananne neena sabbana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Diitsawunne maasink'k'oo beegottite!","poem":1},{"text":"Taanikka wontta guuraanna beegottana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abeet Med'inaa Godaw, taani neena asaa giddon galatana;","poem":1},{"text":"k'ay kawutetsaa giddon neena sabbana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ayaw gooppe, aggena ne siik'uu wolk'k'aama;","poem":1},{"text":"saluwaappe bollaw aad'd'ee.","poem":2},{"text":"Ne tumatetsaykka bolla shaariyaadan d'ok'k'ee.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Abeet S'oossaw, salotuwaappe bollaanna","poem":1},{"text":"d'ok'k'u d'ok'k'u ga!","poem":2},{"text":"Ne bonchchuu sa'aa ubbaa bolla gido.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Neeni siik'iyaawanttu attana mala,","poem":1},{"text":"ne ushechcha kushiyan nuuna ashsha;","poem":2},{"lineBreak":true},{"text":"neeni taw alla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"S'oossay bare geeshsha sa'aan hawaadan yaageedda;","poem":1},{"text":"«Taani s'oonaade Sekeema biittaa shaakkana;","poem":2},{"lineBreak":true},{"text":"k'ay Sukkoota zanggaaraa gishana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gala'aade tawaa; Minaasekka taassa;","poem":1},{"text":"Efireemi ta huup'iyaa ashshiyaa k'oobiyaa;","poem":2},{"text":"Yihuday ta kawutetsaa s'am\"aa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Moo'aabe taani meec'ettiyaa kuyis'aaruwaa;","poem":1},{"text":"Eedoomi tawaa gidiyaawaa erissanaw","poem":2},{"lineBreak":true},{"text":"ta c'aammaa Aa bolla wotsay.","poem":2},{"lineBreak":true},{"text":"Taani Piliss's'eema s'oonaade gereeray» yaageedda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gimbbetteedda katamaakko, taana oonee afanawe?","poem":1},{"text":"Eedooma gakkanaw taana oonee kaaletsanawe?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abeet S'oossaw, nuuna aggeedawe neena gidikkii?","poem":1},{"text":"Abeet S'oossaw, neeni nu tooranchchatuwaanna olaw kesakka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Asaa maaduu patsenna diraw,","poem":1},{"text":"morkkiyaanna olettanaw neeni nuuna maadda.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"S'oossaa wolk'k'an nuuni nu morkkatuwaa s'oonana;","poem":1},{"text":"nu morkkatuwaa yed'd'anawe Aa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}