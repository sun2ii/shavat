{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":109,"content":[{"type":"heading","content":["Morkkiyaa Bolla Shiik'o Woosaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, Daawite s'aafeedda mazamuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet taani galatiyaa S'oossaw,","poem":1},{"text":"neeni taw c'o\"u gooppa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ayaw gooppe, iita worddanchcha asatuu,","poem":1},{"text":"barenttu doonaa ta bolla dooyeeddino;","poem":2},{"lineBreak":true},{"text":"unttunttu worddo ins's'arssan ta bolla haasayiino.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Unttunttu is'o k'aalaanna taana dooddiino;","poem":1},{"text":"gaasuu bayinnan taananna oletiino.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taani unttuntta siik'aynne unttunttoo woossay;","poem":1},{"text":"gidooppekka, unttunttu taana mootiino.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Taani lo\"uwaa ootsina,","poem":1},{"text":"unttunttu taw iitaa zaariino;","poem":2},{"lineBreak":true},{"text":"taani unttuntta siik'ina, unttunttu taana is's'iino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ta morkkiyaa bolla iita daannaa suntsaa;","poem":1},{"text":"mootanchchay Aa ushechchan ek'k'o.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Aa biddiyaa wode, I bayzzanchcha gidiide beetto;","poem":1},{"text":"Aa woosaykka aw simmiide gometo!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Aa laytsay k'aammo;","poem":1},{"text":"Aa suntsatetsaakka haray akko!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Aa naanatuu aawuwaa d'ayiide yii\"ino;","poem":1},{"text":"Aa machata am\"e gidu!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Aa naanatuu yuuyyi yuuyyiide woossino;","poem":1},{"text":"barenttu de'iyaa onaappekka yederssettino!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Aa mas'uwaa ubbaa ac'oo oyk'k'o;","poem":1},{"text":"I daaburiide kesseeddabaa ubbaa allagay bonk'k'o!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ooninne aw keekkabaa ootsoppo,","poem":1},{"text":"woy aawuwaa d'ayeedda Aa naanaatoo k'arettoppo!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Aa naanatuu ubbay wuri d'ayino;","poem":1},{"text":"kaalliyaa yeletaan Aa suntsay dogetto.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Aa aawotuwaa nagaray Med'inaa Godaa sintsan k'ofetto;","poem":1},{"text":"Aa aatti nagaray ubbakka k'uc'ettoppo!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"He nagaray ubbaa gede Med'inaa Godaa sintsan beetto;","poem":1},{"text":"unttuntta hassayissiyaawe sa'aappe d'ok'olletti kichcho!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ayaw gooppe, I","poem":1},{"text":"keekkabaa ootsanaw ubbakka k'oppibeenna;","poem":2},{"lineBreak":true},{"text":"hiyyeesatuwaa, metootanchchatuwaanne","poem":2},{"lineBreak":true},{"text":"wozanay madus's'eeddawantta yederssiide wod'eedda.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"I shek'k'anaw doseedda diraw,","poem":1},{"text":"ikka shek'k'etteeddawaa gido!","poem":2},{"text":"I anjjanaw dosenna diraw,","poem":1},{"text":"anjjuu aappe haakko!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"I shek'k'iide salenna;","poem":1},{"text":"Aa shek'ay haatsaadan Aa bollaa katso!","poem":2},{"text":"Zayitiyaadan Aa mek'etsan gelo!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Afilaadan Aa kammo;","poem":1},{"text":"sak'k'iyaadan ubbaa gede Aa s'eessan de'o!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hawe taana mootiyaawanttoonne","poem":1},{"text":"taana iitan zigiriyaawanttoo,","poem":2},{"text":"Med'inaa Goday immiyaa woytuwaa gido!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Shin abeet Ubbaa Mooddiyaa Med'inaa Godaw,","poem":1},{"text":"ne suntsaa diraw, taana maadda.","poem":2},{"text":"Aggena ne siik'uwaanne","poem":1},{"text":"ne keekkatetsaa diraw, taana ashsha.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ayaw gooppe, taani","poem":1},{"text":"hiyyeessanne metootanchchaa asaa;","poem":2},{"lineBreak":true},{"text":"ta wozanaykka maduns's'eedda.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Taani omarssa kuwaadan d'ayana hanay;","poem":1},{"text":"taani booliyaadan k'ok'k'ofettay.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"S'oomishin ta gulbbatay is's'eedda;","poem":1},{"text":"ta bollaykka laafee.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Taana mootiyaawanttoo k'iliic'iyaawaa gidaaddi;","poem":1},{"text":"unttunttu taana be'iide, barenttu huup'iyaa k'aatsiino.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Abeet Med'inaa Godaw ta S'oossaw, taana maadda;","poem":1},{"text":"aggena ne siik'uwaadan taana ashsha.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Abeet Med'inaa Godaw, hewe","poem":1},{"text":"ne kushiyaa gideeddawaanne","poem":2},{"lineBreak":true},{"text":"hewaa neeni ootseeddawaa ta morkketuu erino.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Unttunttu taana shek'k'ooppenne,","poem":1},{"text":"neeni taana anjja!","poem":2},{"text":"Ta bolla denddiyaawanttu yeellatino;","poem":1},{"text":"shin taana ne k'oomaa nashshechchaa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Taana mootiyaawanttu kawushshaa mayno;","poem":1},{"text":"barenttu yeellaakka kutaadan k'umayino.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Taani ta ins's'arssan Med'inaa Godaa daroppe galatana;","poem":1},{"text":"daro Asay shiik'eeddasaan Aa galatana.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ayaw gooppe, I hiyyeesaa diraw mootettee;","poem":1},{"text":"hayk'k'oo pirddiyaa asaappekka Aa ashshee.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}