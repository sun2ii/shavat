{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["S'oossay Dooreedda Kaatiyaa Daawite s'aafeedda mazamuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Goday ta Godaa,","poem":1},{"text":"«Taani ne morkkatuwaa neeni gediyaan","poem":2},{"lineBreak":true},{"text":"yed'd'a ek'k'iyaawaa ootsana gakkanaw,","poem":2},{"lineBreak":true},{"text":"hawaan taappe ushechcha baggana utta» yaageedda.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Med'inaa Goday ne minotetsaa s'am\"aa S'iyooneppe kiittana;","poem":1},{"text":"yaatina, «Ne morkkatuwaa moodda!» yaagana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Neeni ne morkkatuwaanna olettiyaa gallassi,","poem":1},{"text":"ne Asay eeno gaana.","poem":2},{"text":"Wontta guura ketterssaadan,","poem":1},{"text":"ne wodalla Asay neekko geeshsha deretuwaan shiik'ana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Med'inaa Goday, «Malkka S'edek'i k'eesiyaa gideeddawaadan,","poem":1},{"text":"neenikka med'inaw k'eesiyaa gidana» yaagiide c'aak'k'eedda;","poem":2},{"text":"I bare k'ofaa laammenna.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Goday ne ushechchan de'ee;","poem":1},{"text":"bare hank'k'uwaa gallassi I kaatetuwaa kinchchereetsana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kawutetsaa bolla I pirddana;","poem":1},{"text":"olaa dembbatuwaakka anhaa s'alala ootsana;","poem":2},{"lineBreak":true},{"text":"sa'aan ubbaan de'iyaa kaatetuwaa I mentsereetsana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kaatii ogiyaa matan de'iyaa haatsaa pulttuwaappe ushiide,","poem":1},{"text":"I bare huup'iyaa d'ok'k'u ootsana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}