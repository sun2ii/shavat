{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":111,"content":[{"type":"heading","content":["S'oossaw Shiik'iyaa Galataa"]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Godaa galatite! Suuretuu shiik'iyaa shiik'uwaan,","poem":1},{"text":"taani ta polo wozanaappe Med'inaa Godaa galatana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Med'inaa Godaa oosotuu ay keeshshaa gitee!","poem":1},{"text":"Unttunttun nashettiyaawanttu ubbay unttuntta k'oppanaw bessee.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Aa oosotuu bonchchuwaaninne","poem":1},{"text":"anggan kumeeddawantta.","poem":2},{"text":"Aa s'illotetsaykka med'inaw de'ee.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I bare malalissiyaa oosotuu,","poem":1},{"text":"hassayettanaadan ootseedda.","poem":2},{"text":"Med'inaa Goday k'arettiyaawaanne maariyaawaa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Barew yayyiyaawanttoo k'umaa I immee;","poem":1},{"text":"I bare c'aak'uwaa med'inawukka k'oppee.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Allagatuwaa biittaa immiyaawan","poem":1},{"text":"I bare oosuwaa wolk'k'aa bare asaa besseedda.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Aa kushiyaa oosotuu tumanne likke;","poem":1},{"text":"Aa wogatuukka ubbay ammanettiyaawantta.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Unttunttunne med'i med'inaw ek'k'iide de'iyaawantta;","poem":1},{"text":"tumatetsaaninne suuretetsan imetteeddawantta.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I bare asaa woziide kesseedda;","poem":1},{"text":"I bare c'aak'uwaa unttunttunna med'inaw wotseedda.","poem":2},{"text":"Aa suntsay geeshshanne, «Hoola!» giissiyaawaa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Eratetsaw koyiruu Med'inaa Godaw yayyiyaawaa;","poem":1},{"text":"Aa wogaa ootsiyaawanttoo lo\"o akeekay de'ee.","poem":2},{"text":"S'oossay med'inaw galatetto!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}