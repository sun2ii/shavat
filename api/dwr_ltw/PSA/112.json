{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":112,"content":[{"type":"heading","content":["Lo\"o Asaa Nashechchaa"]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Godaa galatite! Med'inaa Godaw yayyiyaanne,","poem":1},{"text":"Aa azazuwaa polanaw daroppe nashetiyaa asay,","poem":2},{"lineBreak":true},{"text":"anjjetteedawaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Aa naanatuu biittan wolk'k'aama gidana;","poem":1},{"text":"suure asatuwaa yeletay anjjettana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Shaluunne duretetsay Aa golliyaan de'ee;","poem":1},{"text":"Aa s'illotetsaykka med'inaw de'ana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Suure asaw,","poem":1},{"text":"keeka, s'illonne k'arettiyaa asatoo,","poem":2},{"lineBreak":true},{"text":"d'umaa giddon poo'uu poo'ee.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Keekatetsan c'oo tal\"iyaa uraw,","poem":1},{"text":"bare oosuwaa suuretetsan ootsiyaa uraw,","poem":2},{"lineBreak":true},{"text":"keekabay yaana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"S'illo Asay awudenne kunddenna;","poem":1},{"text":"med'inaw I hassayettana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iitabaa I sisooppekka dagammenna;","poem":1},{"text":"ayaw gooppe, Aa wozanay k'aas's'ena;","poem":2},{"text":"Med'inaa Godaan I ammanettee.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aa wozanay s'ala gidiyaa diraw,","poem":1},{"text":"ubbakka I yayyena;","poem":2},{"lineBreak":true},{"text":"wurssetsan bare morkketuu s'oonettina be'ana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I hiyyeesaa asaw darissiide immeedda;","poem":1},{"text":"k'ay Aa s'illotetsay med'inaw de'ee;","poem":2},{"text":"Aa kac'ii bonchchuwaan d'ok'k'u gee.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Iita Asay hewaa be'iide yilotee;","poem":1},{"text":"achchaa garc'c'iide, c'oo d'ayee.","poem":2},{"text":"Iita asaa amuu c'oo attanawaa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}