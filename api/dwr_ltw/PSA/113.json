a.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I salotuwaanne sa'aa s'eellanaw","poem":1},{"text":"duge hokkee.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I hiyyeesaa baanaappe d'ok'k'u ootsee;","poem":1},{"text":"metootanchchaakka bidintsaa pituwaappe dentsee.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bare asaa mooddiyaawanttunna utissee.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Maynne mishirato naanatuwaa aato ootsiide,","poem":1},{"text":"nashechchiide I golliyaan izo bonchchissee.","poem":2},"Med'inaa Godaa galatite!"]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}