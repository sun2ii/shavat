{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":114,"content":[{"type":"heading","content":["Paasigaa Mazimuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Israa'eeliyaa Asay Gibs'e biittaappe keseedda wode,","poem":1},{"text":"Yaak'ooba golliyaa asay,","poem":2},{"lineBreak":true},{"text":"allaga k'aalan haasayiyaa asaa yeggiide beedda wode,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yihudaa Asay Godaw geeshsha asaa gideedda;","poem":1},{"text":"Israa'eeliyaa asaykka aw moodeteeddino.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Zo'o Abbay hewaa be'iide bak'ateedda;","poem":1},{"text":"Yorddaanoosa Shaafaykka guyye simmeedda.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Deretuu deeshshatuwaadan buraak'eeddino;","poem":1},{"text":"zoozetuukka dorssaa maraadan guferetteeddino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Abbaw, neena bak'atisseedawe ayee?","poem":1},{"text":"Yorddaanoosa Shaafaw, ayaw guyye simmaaddii?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hinttenoo deretoo, deeshshatuwaadan","poem":1},{"text":"ayaw buraak'eedditee?","poem":2},{"text":"Hinttenoo zoozatoo, dorssaa maraadan,","poem":1},{"text":"ayaw guferetteeditee?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Neenoo biittaw, Godaa sintsan,","poem":1},{"text":"Yaak'ooba S'oossaa sintsan kokkora.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"I Shuchchaa zeereeto haatsaa kesseeddawaa;","poem":1},{"text":"zaallaa, haatsaa pulttuwaa ootseeddawaa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}