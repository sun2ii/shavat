{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":115,"content":[{"type":"heading","content":["Itti Tumu S'oossaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, nu gishsha gidenna;","poem":1},{"text":"nu gishsha gidennaan, aggena ne siik'owunne","poem":2},{"lineBreak":true},{"text":"ne tumatetsaa diraw, ne suntsaa bonchcha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kawutetsatuu ayaw,","poem":1},{"text":"«Unttunttu S'oossay hak'an de'ii?» giinoo?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nu S'oossay saluwaana;","poem":1},{"text":"I bare doseeddawaa ay gidooppekka ootsee.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Shin unttunttu eek'atuu biraanne work'k'aa;","poem":1},{"text":"unttunttu asaa kushiyaan med'etteeddawantta.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Unttunttoo doonay de'ee; shin haasayikkino;","poem":1},{"text":"ayifii de'ee; shin s'eellikkino.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Unttunttoo haytsay de'ee; shin sissikkino;","poem":1},{"text":"siid'ii de'ee; shin singgikkino.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Unttunttoo kushii de'ee; shin oyk'k'i erikkino;","poem":1},{"text":"gediikka de'ee; shin hamettikkino;","poem":2},{"lineBreak":true},{"text":"unttunttu barenttu pillanttiyaanna kooshshaa sissikkino.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Unttuntta med'd'iyaawanttunne,","poem":1},{"text":"unttunttun ammanettiyaawanttu ubbay unttunttu mala gidino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Hinttenoo, Israa'eeliyaa asatoo,","poem":1},{"text":"Med'inaa Godaan ammanettite!","poem":2},{"text":"I hinttena maaddiyaawaanne hintte gonddalliyaa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hinttenoo, Aaroona golliyaa asatoo,","poem":1},{"text":"Med'inaa Godaan ammanettite!","poem":2},{"text":"I hinttena maaddiyaawaanne hintte gonddalliyaa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hinttenoo, Med'inaa Godaw yayyiyaawanttoo,","poem":1},{"text":"Med'inaa Godaan ammanettite!","poem":2},{"text":"I hinttena maaddiyaawaanne hintte gonddalliyaa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Med'inaa Goday nuuna k'oppee; I nuuna anjjana.","poem":1},{"text":"I Israa'eeliyaa asatuwaa anjjana.","poem":2},{"text":"I Aaroona golliyaa asatuwaa anjjana.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Med'inaa Godaw yayyiyaawantta,","poem":1},{"text":"guutsatuwaakka gitatuwaakka I gatso anjjana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Med'inaa Goday hinttenakka hintte naanatuwaakka darisso!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Saluwaanne sa'aa med'd'eedda Med'inaa Godaan anjjettite!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bolla d'ok'k'a saluu Med'inaa Godaawaa;","poem":1},{"text":"shin sa'aa I asaw immeedda.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hayk'k'eeddawanttu, duufuwaan c'o\"u geeddawanttu,","poem":1},{"text":"Med'inaa Godaa galatikkino.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Shin nuuni, pas'a de'iyaawanttu,","poem":1},{"text":"hachcheppe doommiide","poem":2},{"lineBreak":true},{"text":"med'inaa gakkanaw Med'inaa Godaa galateetto.","poem":2},{"lineBreak":true},{"text":"Med'inaa Godaa galatite!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}