{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":116,"content":[{"type":"heading","content":["Hayk'k'uwaappe Atteedda Asaa Galataa"]},{"type":"verse","number":1,"content":[{"text":"I ta kooshshaanne ta watiwatuwaa siseedda diraw,","poem":1},{"text":"taani Med'inaa Godaa siik'ay.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"I bare haytsaa taakko yeggeedda diraw,","poem":1},{"text":"taani pas'a de'eedda keenan ubbaan Aa s'eesana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hayk'k'uu p'iriyaadan taana oyk'k'anaw haneedda;","poem":1},{"text":"moogettana hirggay taana iisseedda.","poem":2},{"text":"Taana un\"ay toleedda.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He wode taani, «Abeet Med'inaa Godaw, hadaraa!","poem":1},{"text":"Taana ashsha» yaagaade Med'inaa Godaa suntsaa s'eesaad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Med'inaa Goday keekkanne s'iluwaa;","poem":1},{"text":"nu S'oossay k'arettiyaawaa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Med'inaa Goday ashikke wozanay de'iyaawantta naagee;","poem":1},{"text":"taani metooteedda wode, I taana ashsheeda.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta shemppattee, simmi woppu ga;","poem":1},{"text":"ayaw gooppe, Med'inaa Goday new keekeedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Med'inaa Goday taana hayk'k'uwaappe,","poem":1},{"text":"ta ayifiyaa afotsaappe,","poem":2},{"lineBreak":true},{"text":"ta gediyaakka d'ubiyaappe ashsheedda.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hewaa diraw, taani,","poem":1},{"text":"pas'a de'iyaawanttu giddon,","poem":2},{"lineBreak":true},{"text":"Med'inaa Godaa sintsan hamettay.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Taani, «Taana un\"ay toleedda» giyaa wodekka,","poem":1},{"text":"ta ammanuwaa aggabeyikke.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Taani dagamaade, «Asay ubbay wordduwaa» yaagaad.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I taw keekkeedda keekkatetsaa diraw,","poem":1},{"text":"taani Med'inaa Godaw ay c'igganaw danddayayitaa?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Taani s'uu'aa woyniyaa eessaa galataw shiishshaade,","poem":1},{"text":"I taana asho diraw,","poem":2},{"text":"Med'inaa Godaa suntsaa s'eesana.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aa asaa ubbaa sintsan","poem":1},{"text":"taani k'anggiyaa Med'inaa Godaw gatsana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Geeshshatuwaa hayk'k'uu Med'inaa Godaa sintsan,","poem":1},{"text":"loytsi daroppe bonchchetteeddawaa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abeet Med'inaa Godaw, taani ne k'oomaa;","poem":1},{"text":"ee, taani ne k'oomaa, ne k'oomati na'aa.","poem":2},{"text":"Taana k'ashuwaappe neeni billaada.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Abeet Med'inaa Godaw,","poem":1},{"text":"taani galataa yarshshuwaa new yarshshana;","poem":2},{"lineBreak":true},{"text":"ne suntsaa s'eesana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Asaa ubbaa sintsan,","poem":1},{"text":"taani k'anggeteedda k'anggetsaa Med'inaa Godaw gatsana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hewaakka taani gatsanawe,","poem":1},{"text":"Yerusaalamen de'iyaa Med'inaa Godaa golliyaa dabaabaanna.","poem":2},{"lineBreak":true},{"text":"Med'inaa Godaa galatite!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}