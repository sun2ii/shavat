{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":118,"content":[{"type":"heading","content":["S'oonoo Shiik'o Galataa"]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Godaa galatite! Ayaw gooppe, I keeka.","poem":1},{"text":"Aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Israa'eeliyaa asay,","poem":1},{"text":"«Aggena Aa siik'uu med'inaawaa» yaago.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Aaroona golliyaa asay,","poem":1},{"text":"«Aggena Aa siik'uu med'inaawaa» yaago.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Med'inaa Godaw yayyiyaawanttu ubbay,","poem":1},{"text":"«Aggena Aa siik'uu med'inaawaa» yaagino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Taani un\"etteedda wode Med'inaa Godaw waassaad;","poem":1},{"text":"I ta waasuwaa alliide, taana la\"a kesseedda.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Med'inaa Goday taananna de'iyaa diraw,","poem":1},{"text":"taani yayyikke.","poem":2},{"text":"Asi taana ay ootsii?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Med'inaa Goday taana maaddanaw taananna de'ee;","poem":1},{"text":"ta morkketuu s'oonetteeddawantta taani be'ana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Asan ammanettiyaawaappe,","poem":1},{"text":"Med'inaa Godaakko bak'atiyaawe lo\"a.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Daannatuwaan ammanettiyaawaappe,","poem":1},{"text":"Med'inaa Godaakko bak'atiyaawe lo\"a.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kawutetsatuu ubbay taana dooddi oyk'k'eeddino;","poem":1},{"text":"shin Med'inaa Godaa suntsan taani unttuntta s'oonaad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Unttunttu taana dooddeeddino;","poem":1},{"text":"ubba saanna dooddi oyk'k'eeddino;","poem":2},{"lineBreak":true},{"text":"shin Med'inaa Godaa suntsan taani unttuntta s'oonaad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Unttunttu matsay doodiyaawaadan,","poem":1},{"text":"ta yuushshuwaan dooddeeddino.","poem":2},{"text":"Shin aguntsay taman ees's'iyaawaadan","poem":1},{"text":"ees's'i d'ayeeddino.","poem":2},{"text":"Med'inaa Godaa suntsan taani unttuntta s'oonaad.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Taana sugi yeggina, kunddana hanay;","poem":1},{"text":"shin Med'inaa Goday taana maaddeedda.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Med'inaa Goday taw wolk'k'anne minotetsaa;","poem":1},{"text":"I taana ashshiyaawaa gideedda.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Olaa s'ooniide simmiyaa asay,","poem":1},{"text":"s'illotuwaa dunkkaaniyaan hombboc'iidde, giyaawaa sisite.","poem":2},{"text":"Unttunttu, «Med'inaa Godaa ushechcha kushii wolk'k'aamabaa ootseedda!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Med'inaa Godaa ushechcha kushii s'oonuwaa immeedda!","poem":1},{"text":"Med'inaa Godaa ushechcha kushii wolk'k'aamabaa ootseedda!» yaagiino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Taani hayk'k'ikke;","poem":1},{"text":"pas'a de'ananne Med'inaa Goday ootseeddawaa awaayana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Med'inaa Goday taana iita muruwaa muree;","poem":1},{"text":"shin hayk'k'oo aatsiide immibeenna.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Taani giddo gelaade Med'inaa Godaa galatana mala,","poem":1},{"text":"Geeshsha Golliyaa penggetuwaa ane taw dooyite.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hawe Med'inaa Godaa penggiyaa;","poem":1},{"text":"ha penggiyaanna s'illotuwaa s'alalay geliino.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Neeni taana siseedda dirawunne","poem":1},{"text":"s'oonuwaa immeedda diraw,","poem":2},{"lineBreak":true},{"text":"taani neena galatay.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Gimbbiyaawanttu kad'iide is's'eedda shuchchay,","poem":1},{"text":"godaa s'ap'uwaa minisiyaa, ubbaappe aad'd'iyaa shuchchaa gideedda.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hawe Med'inaa Goday ootseeddawaa;","poem":1},{"text":"k'ay nu ayifiyawukka malalissiyaawaa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hawe gallassay Med'inaa Goday med'eedda gallassaa.","poem":1},{"text":"Ane nuuni an nashettoyttenne ililoytte.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Abeet Med'inaa Godaw, ha\"i nuuna ashshaarikkii!","poem":1},{"text":"Abeet Med'inaa Godaw, ha\"i nuw injjeyaarikkii!","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Med'inaa Godaa suntsan yiyaa Asay anjjetteedawaa gido!","poem":1},{"text":"Nuuni Med'inaa Godaa Geeshsha Golliyaappe hinttena anjjeetto.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Med'inaa Goday S'oossaa; I nu bollan poo'isseedda.","poem":1},{"text":"Irs's'a tashiyaa oyk'k'iide, ayaana gallassaa bonchchite;","poem":2},{"lineBreak":true},{"text":"yarshshuwaa bollan de'iyaa kac'iyaakko aad'd'ite.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Neeni ta S'oossaa; taani neena galatana.","poem":1},{"text":"Neeni ta S'oossaa; taani neena gitayana.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Med'inaa Godaa galatite! Ayaw gooppe, I keeka;","poem":1},{"text":"aggena Aa siik'uu med'inaawaa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}