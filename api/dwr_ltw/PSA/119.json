{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":119,"content":[{"type":"heading","content":["S'oossaa Higgiyaw Imetteedda Sabaa"]},{"type":"verse","number":1,"content":[{"text":"Barenttu ogiyaan tooshii bayinnawanttunne,","poem":1},{"text":"Med'inaa Godaa higgiyaadan hamettiyaawanttu,","poem":2},{"lineBreak":true},{"text":"anjjetteedawantta.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"I odeeddawaa ootsiyaawanttunne","poem":1},{"text":"barenttu kumentsaa wozanaappe Aa siik'iyaawanttu,","poem":2},{"lineBreak":true},{"text":"anjjetteeddawantta.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Unttunttu balabaa ootsikkino;","poem":1},{"text":"S'oossaa ogiyaan hamettiino.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne wogaw ammanettiide naagana mala,","poem":1},{"text":"neeni nuuna azazaadda.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne awaayoo azazettiyaawan","poem":1},{"text":"ta ogii minnanaadan amottay.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yaatooppe, ne azazuwaa ubbaa hayzzaadde,","poem":1},{"text":"taani ubbakka yeellatikke.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne s'illo pirddaa tamaaraade,","poem":1},{"text":"taani neena suure wozanaappe galatana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Taani ne awaayuwaadan ootsana;","poem":1},{"text":"taana ubbakka yeggoppa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yalagay bare ogiyaa geeshsha ootsiide","poem":1},{"text":"wooti naaganaw danddayii?","poem":2},{"text":"Ne k'aalay giyaawaadan de'ooppe danddayee.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Taani ta polo wozanaappe neena koyay;","poem":1},{"text":"ne azazotuwaappe wora hamettennaadan taana naaga.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Taani neena naak'k'ennaadan","poem":1},{"text":"ne k'aalaa ta wozanaan wotsaad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abeet Med'inaa Godaw, neeni galatetta!","poem":1},{"text":"Ne awaayuwaa taana tamaarissa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ne doonaappe keseedda pirddaa ubbaa,","poem":1},{"text":"taani ta ins's'arssan oday.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Duretetsan nashettiyaawaadan,","poem":1},{"text":"taani neeni odeedda k'aalan nashetay.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ne wogatuwaa zaara zaaraadde k'oppaynne","poem":1},{"text":"ne ogiyaa loytsa akeekay.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Taani ne awaayuwaan nashetay;","poem":1},{"text":"ne k'aalaakka taani dogikke.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Taani pas'a de'ana malanne","poem":1},{"text":"ne k'aalaw azazettana mala,","poem":2},{"lineBreak":true},{"text":"taw ne k'oomaw keekabaa ootsa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ne higgiyaa giddon de'iyaa malalissiyaa tumatetsaa,","poem":1},{"text":"taani be'ana mala, ta ayifiyaa dooyaa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Taani ha sa'aan imatsaa;","poem":1},{"text":"ne azazotuwaa taappe gentsoppa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Taani ubbaa wode,","poem":1},{"text":"ne pirddaa loytsa laamotay.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Otorettiyaawanttu, shek'k'etteeddawantta,","poem":1},{"text":"ne azazuwaappe wora hamettiyaawantta,","poem":2},{"lineBreak":true},{"text":"neeni seeraasa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Taani neeni odeeddawaa ootseedda diraw,","poem":1},{"text":"unttunttu boriyaanne unttunttu kad'iyaa ta bollaappe digga.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Haray atto kaappatuu shiik'iide,","poem":1},{"text":"ta bolla mak'ettooppekka,","poem":2},{"lineBreak":true},{"text":"taani, ne k'oomay, ne awaayuwaa zaara zaaraadde k'oppana.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Neeni odeedda k'aalatuu taana nashechchiino;","poem":1},{"text":"unttunttu taana zoriino.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Taani hayk'k'ana hanay;","poem":1},{"text":"neeni geedda k'aalaadan ta shemppuwaa ashsha.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Taani ta ogiyaawaa new odina,","poem":1},{"text":"neeni taana sisaadda;","poem":2},{"lineBreak":true},{"text":"simmi, ne awaayuwaa taana tamaarissa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ne wogaa ogiyaa taana akeekissa;","poem":1},{"text":"malalissiyaa ne oosuwaa","poem":2},{"lineBreak":true},{"text":"taani zaara zaaraadekka k'oppana.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kayyuu dareeddawaan ta shemppuu daabureedda;","poem":1},{"text":"neeni geedda k'aalaadan taana minisa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Worddo ogiyaa taappe haassa;","poem":1},{"text":"ne aad'd'o keekkatetsan ne higgiyaa taana tamaarissa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Tumuwaa ogiyaa dooraad;","poem":1},{"text":"ne pirddaa hayzzaad.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Abeet Med'inaa Godaw, taani","poem":1},{"text":"neeni odeeddawaa minisa oyk'k'aad;","poem":2},{"lineBreak":true},{"text":"simmi taana yeellayoppa!","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Neeni ta wozanaa la\"a keseedda diraw,","poem":1},{"text":"taani ne azazuwaa ogiyaan wos's'ay.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Abeet Med'inaa Godaw, ne awaayuwaa biletsaa","poem":1},{"text":"taana tamaarissa;","poem":2},{"lineBreak":true},{"text":"taani wurssetsay gakkanaw Aa naagana.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Taani ne higgiyaa naagana malanne","poem":1},{"text":"ta kumentsaa wozanaappe taani aw azazettana mala,","poem":2},{"lineBreak":true},{"text":"neeni taw akeekaa imma.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ne azazuwaa ogiyaan taana kaaletsa;","poem":1},{"text":"ayaw gooppe, taani an nashetay.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ta wozanaa amuwaakko gidennaan,","poem":1},{"text":"neeni odeedda k'aalaakko zaara.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Patsennabaa s'eellenna mala,","poem":1},{"text":"ta ayifetuwaa te\"a;","poem":2},{"lineBreak":true},{"text":"ne ogiyaan ta de'uwaa ooratsa.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Neeni yayetana mala,","poem":1},{"text":"neeni gelo k'aalaa taw,","poem":2},{"lineBreak":true},{"text":"ne k'oomaw pola.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Yashshiyaa boriyaa taappe digga.","poem":1},{"lineBreak":true},{"text":"Ne pirdday ay mala lo\"ee!","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Taani ne wogaa naaganaw amottay;","poem":1},{"text":"neeni s'illuwaa gidiyaa diraw,","poem":2},{"lineBreak":true},{"text":"ta de'uwaa ooratsa.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Abeet Med'inaa Godaw, aggena ne siik'uwaa taana bessa;","poem":1},{"text":"neeni geedda k'aalaadan taana ashsha.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Taani ne k'aalan ammanettiyaa diraw,","poem":1},{"text":"taana boriyaawanttoo zaaranaw danddayay.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Taani ne pirddan nashshechchaa ootsiyaa diraw,","poem":1},{"text":"ta ins's'arssaappe tumatetsaa k'aalaa d'ayissoppa.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Taani ubbaa gede, med'i med'inawukka","poem":1},{"text":"ne higgiyaw azazettana.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Taani ne wogaa poliyaa diraw,","poem":1},{"text":"aakuwaan hamettana.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Taani kaatetuwaa sintsan ek'k'aade,","poem":1},{"text":"neeni odeeddabaa odaadde yeellatikke.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Taani dosiyaa ne azazotuwaan nashettay","poem":1}]},{"type":"verse","number":48,"content":[{"text":"Taani siik'iyaa ne azazotuwaa bonchchay;","poem":2},{"lineBreak":true},{"text":"ne awaayuwaakka zaara zaaraadde k'oppana.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Neeni taw, ne k'oomaw,","poem":1},{"text":"immeedda k'aalaa k'oppa;","poem":2},{"lineBreak":true},{"text":"he k'aalan taani hidootaa ootsay.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Neeni, «Taani neena pas'a wotsana»","poem":1},{"text":"geedda k'aalay ta tuggaa wode taana mintsetseedda.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Otoranchchatuu taana likkiyaappe aatsiide shek'iino;","poem":1},{"text":"shin taani ne higgiyaappe sher\"i giikke.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Abeet Med'inaa Godaw, beniideppe de'iyaa ne pirddaa taani hassayay;","poem":1},{"text":"hewan taani minetay.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Iitatuu ne higgiyaw azazettenawaa be'ina,","poem":1},{"text":"yiluu taana wod'eedda.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Taani de'iyaa allaga biittan,","poem":1},{"text":"ne awaayuu taw yetsaa gideedda.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Abeet Med'inaa Godaw, taani k'amma ne suntsaa k'oppay;","poem":1},{"text":"ne higgiyaakka naagay.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Ne wogaw azazettiyaawe taw anjjo gideedda.","poem":1}]},{"type":"verse","number":57,"content":[{"text":"Abeet Med'inaa Godaw, taana gakkeedda saamay neena;","poem":1},{"text":"taani ne k'aalaw azazettana yaagay.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Taani ta kumentsaa wozanaappe neena woossay.","poem":1},{"lineBreak":true},{"text":"Neeni geedda k'aalaadan taw k'aretta.","poem":1}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"Taani ta ogiyaa akeeka s'eellaade,","poem":1},{"text":"neeni odeeddabaakko simmaad.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Taani ne azazuwaa naaganaw,","poem":1},{"text":"elleellanaappe attina takkikke.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"Iitatuu taana wodoruwaan k'achchooppekka,","poem":1},{"text":"taani ne higgiyaa dogabeykke.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"Ne s'illo pirddaa diraw, neena galatanaw,","poem":1},{"text":"taani k'amma bilahe dendday.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Taani new yayyiyaawanttu ubbawunne","poem":1},{"text":"ne wogaa naagiyaawanttoo dabbo.","poem":2}]},{"type":"verse","number":64,"content":[{"text":"Abeet Med'inaa Godaw, sa'ay","poem":1},{"text":"aggena ne siik'uwaan kumeedda;","poem":2},{"lineBreak":true},{"text":"ne awaayuwaa taana tamaarissa.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Abeet Med'inaa Godaw, ne geedda k'aalaadan,","poem":1},{"text":"taw ne k'oomaw keekkabaa ootsaadda.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Taani ne azazotuwaan ammanettiyaa diraw,","poem":1},{"text":"lo\"o pirddaanne eratetsaa taana tamaarissa.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"Taani murettanaappe kase wora hamettaad;","poem":1},{"text":"shin ha\"i ne k'aalaw azazettay.","poem":2}]},{"type":"verse","number":68,"content":[{"text":"Neeni keeka; neeni keekkabaa ootsaasa;","poem":1},{"text":"ne awaayuwaa taana tamaarissa.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"Otoranchchatuu taana wordduwaa okkiino;","poem":1},{"text":"shin taani ne wogaa ta kumentsaa wozanaappe naagana.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"Unttunttu wozanay ubbakka donc'c'illowantta;","poem":1},{"text":"shin taani ne higgiyan nashetay.","poem":2}]},{"type":"verse","number":71,"content":[{"text":"Taani muretteeddawe taw lo\"eedda;","poem":1},{"text":"ayaw gooppe, ne awaayuwaa tamaaranaw taana maaddeedda.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"Daro sha\"u work'k'aappenne biraappe,","poem":1},{"text":"ne doonaappe keseedda higgii taw aad'd'ee.","poem":2}]},{"type":"verse","number":73,"content":[{"text":"Taana ne kushii med'd'eeddanne giigisseedda.","poem":1},{"text":"Ne azazuwaa taani tamaarana mala,","poem":2},{"lineBreak":true},{"text":"taw akeekaa imma.","poem":2}]},{"type":"verse","number":74,"content":[{"text":"Taani ne k'aalan hidootaa wotsiyaa ootseedda diraw,","poem":1},{"text":"new yayyiyaawanttu taana be'iide nashetino.","poem":2}]},{"type":"verse","number":75,"content":[{"text":"Abeet Med'inaa Godaw, ne pirdday s'illa gidiyaawaanne","poem":1},{"text":"neeni amaneteedawaa gido diraw taana mureeddawaa eray.","poem":2}]},{"type":"verse","number":76,"content":[{"text":"Neeni taw ne k'oomaw geedda k'aalaadan,","poem":1},{"text":"aggena ne siik'uu taana miniso.","poem":2}]},{"type":"verse","number":77,"content":[{"text":"Taani pas'a de'ana mala, taw k'aretta;","poem":1},{"text":"ayaw gooppe, ne higgii taana nashechchee.","poem":2}]},{"type":"verse","number":78,"content":[{"text":"Otoranchchatuu wordduwaan","poem":1},{"text":"taana mootiyaa diraw, yeellatino.","poem":2},{"text":"Taana gidooppe, taani ne wogatuwaa","poem":1},{"text":"zaara zaaraadde k'oppay.","poem":2}]},{"type":"verse","number":79,"content":[{"text":"New yayyiyaawanttunne,","poem":1},{"text":"neeni odeeddabaa eriyaawanttu ubbay,","poem":2},{"lineBreak":true},{"text":"taakko yiino.","poem":2}]},{"type":"verse","number":80,"content":[{"text":"Taani yeellatenna mala,","poem":1},{"text":"ne awaayoo azazettiyaawan","poem":2},{"lineBreak":true},{"text":"tooshii bayinnawaa gidaarikkitaa!","poem":2}]},{"type":"verse","number":81,"content":[{"text":"Neeni taana ashshana mala,","poem":1},{"text":"taani naagaadde daaburay;","poem":2},{"lineBreak":true},{"text":"taani ne k'aalan hidootaa ootsay.","poem":2}]},{"type":"verse","number":82,"content":[{"text":"Neeni geedda k'aalay polettina","poem":1},{"text":"be'anaw s'eelliidde, ta ayifii galjjeedda.","poem":2},{"text":"Taani, «Neeni taana awude mintsetsaniishsha?» yaagay.","poem":1}]},{"type":"verse","number":83,"content":[{"lineBreak":true},{"text":"C'uwaan kak'k'eedda ogoruwaa gidaade gunddaad;","poem":1},{"text":"gidooppenne, ne awaayuwaa balikke.","poem":2}]},{"type":"verse","number":84,"content":[{"text":"Taani ne k'oomay awude gakkanaw naagoo?","poem":1},{"lineBreak":true},{"text":"Taana yederssiyaawantta neeni awude pirddanii?","poem":1}]},{"type":"verse","number":85,"content":[{"lineBreak":true},{"text":"Ne higgiyaa naagenna otoranchchatuu,","poem":1},{"text":"taana kuddissana giide, taw ollaa bookkiino.","poem":2}]},{"type":"verse","number":86,"content":[{"text":"Ne azazotuu ubbay ammantsiyaawantta.","poem":1},{"text":"Taana asatuu wordduwaan yederssiyaa diraw,","poem":2},{"lineBreak":true},{"text":"ha\"i taana maadda!","poem":2}]},{"type":"verse","number":87,"content":[{"text":"Unttunttu taana wod'i diggeeddinoshin;","poem":1},{"text":"taani ne wogaa aggabeyikke.","poem":2}]},{"type":"verse","number":88,"content":[{"text":"Aggena ne siik'uwaan ta de'uwaa naaga;","poem":1},{"text":"hewenne, neeni ne doonaappe odeeddawaa taani naaganaassa.","poem":2}]},{"type":"verse","number":89,"content":[{"text":"Abeet Med'inaa Godaw, ne k'aalay med'inaassa;","poem":1},{"text":"ikka saluwaan minniide de'ee.","poem":2}]},{"type":"verse","number":90,"content":[{"text":"Neeni yeletaappe yeletaa gakkanaw ammanettiyaawaa.","poem":1},{"text":"Neeni ha sa'aa baasaade essaadda;","poem":2},{"lineBreak":true},{"text":"ikka minniide de'ee.","poem":2}]},{"type":"verse","number":91,"content":[{"text":"Neeni geeddawaadan ubbabaykka","poem":1},{"text":"hachchi gakkanaw minniide de'ee;","poem":2},{"lineBreak":true},{"text":"ayaw gooppe, ubbatuukka ne k'oomatuwaa.","poem":2}]},{"type":"verse","number":92,"content":[{"text":"Ne higgii taana nashechchiyaabaa gidenentto,","poem":1},{"text":"ta tuggaa wode taani d'ayana shin.","poem":2}]},{"type":"verse","number":93,"content":[{"text":"Ne wogaa ubbakka dogikke;","poem":1},{"text":"ayaw gooppe, neeni an taana pas'a wotsaadda.","poem":2}]},{"type":"verse","number":94,"content":[{"text":"Taani newaattee; taana ashsha;","poem":1},{"text":"ayaw gooppe, taani ne wogaa naaganaw koyay.","poem":2}]},{"type":"verse","number":95,"content":[{"text":"Iitatuu taana d'ayissanaw kuukuliide naagiino;","poem":1},{"text":"shin taani neeni odeeddawaa k'oppay.","poem":2}]},{"type":"verse","number":96,"content":[{"text":"Polo geetettobaw ubbabaw zaway de'iyaawaa taani be'aad;","poem":1},{"text":"shin ne higgiyaw zaway baawa.","poem":2}]},{"type":"verse","number":97,"content":[{"text":"Taani ne higgiyaa waata dosayttaa!","poem":1},{"lineBreak":true},{"text":"Gallassaa kumentsaa taani k'oppiyaawe Aa.","poem":1}]},{"type":"verse","number":98,"content":[{"lineBreak":true},{"text":"Ne azazotuu ubbaa wodekka taananna de'iyaa diraw,","poem":1},{"text":"unttunttu taana ta morkkatuwaappe aad'd'eeda eranchcha kessiino.","poem":2}]},{"type":"verse","number":99,"content":[{"text":"Taani neeni odeeddawaa k'oppiyaa diraw,","poem":1},{"text":"taana tamaarisseedda ubbaappekka aad'd'eeda akeekay taw de'ee.","poem":2}]},{"type":"verse","number":100,"content":[{"text":"Taani ne wogaw azazettiyaa diraw,","poem":1},{"text":"c'imatuwaappe aatsaade akeekay.","poem":2}]},{"type":"verse","number":101,"content":[{"text":"Taani ne k'aalaw azazettanaw koyiyaa diraw,","poem":1},{"text":"ta gediyaa iita ogiyaa ubbaappe naagaad.","poem":2}]},{"type":"verse","number":102,"content":[{"text":"Neeni taana tamaarisseedda diraw,","poem":1},{"text":"taani ne pirddaappe wora babeykke.","poem":2}]},{"type":"verse","number":103,"content":[{"text":"Ne k'aalay ayaa mal\"ii!","poem":1},{"text":"Eessaa ililuwaappekka aad'd'iide,","poem":2},{"lineBreak":true},{"text":"ta doonaan mal\"ee.","poem":2}]},{"type":"verse","number":104,"content":[{"text":"Ne wogaappe akeekaa demmaad;","poem":1},{"text":"hewaa diraw, taani geella ogiyaa ubbaa is's'ay.","poem":2}]},{"type":"verse","number":105,"content":[{"text":"Ne k'aalay ta gediyaw s'omppiyaa,","poem":1},{"text":"ta ogiyawukka poo'uwaa.","poem":2}]},{"type":"verse","number":106,"content":[{"text":"Ne s'illo pirddaadan de'anaw,","poem":1},{"text":"taani c'aak'k'eedda c'aak'uwaa mintsana.","poem":2}]},{"type":"verse","number":107,"content":[{"text":"Taani daro tuggataad;","poem":1},{"text":"abeet Med'inaa Godaw, neeni geedda k'aalaadan","poem":2},{"lineBreak":true},{"text":"taana pas'a wotsa.","poem":2}]},{"type":"verse","number":108,"content":[{"text":"Abeet Med'inaa Godaw, ta doonaappe kesiyaa galataa, yarshshuwaa akka;","poem":1},{"text":"taana pirddaa tamaarissa.","poem":2}]},{"type":"verse","number":109,"content":[{"text":"Ta shemppu metuwaa bollaa de'inttokka,","poem":1},{"text":"taani ne higgiyaa dogikke.","poem":2}]},{"type":"verse","number":110,"content":[{"text":"Iitatuu taw gitiyaa yeggeeddino;","poem":1},{"text":"shin taani ne wogaappe sher\"i gabeykke.","poem":2}]},{"type":"verse","number":111,"content":[{"text":"Neeni odeeddabay med'inaw tawaa;","poem":1},{"text":"ee, I ta wozanaw nashshechchaa.","poem":2}]},{"type":"verse","number":112,"content":[{"text":"Taani med'inaw, wurssetsaa gakkanaw","poem":1},{"text":"ne awaayuwaadan ootsanaw k'achchaad.","poem":2}]},{"type":"verse","number":113,"content":[{"text":"Taani laa\"u k'ofay de'iyaa asatuwaa is's'ay;","poem":1},{"text":"shin ne higgiyaa siik'ay.","poem":2}]},{"type":"verse","number":114,"content":[{"text":"Neeni taw k'osetta attiyaa saanne","poem":1},{"text":"ta gonddalliyaa;","poem":2},{"lineBreak":true},{"text":"taani ne k'aalan hidootaa ootsay.","poem":2}]},{"type":"verse","number":115,"content":[{"text":"Taani ta S'oossaa azazuwaa naagana mala,","poem":1},{"text":"hinttenoo, iitabaa ootsiyaawanttoo,","poem":2},{"lineBreak":true},{"text":"taappe haakkite!","poem":2}]},{"type":"verse","number":116,"content":[{"text":"Neeni geedda k'aalaadan taana minisa;","poem":1},{"text":"yaatooppe, taani pas'a de'ana.","poem":2},{"text":"Taani hidootan naagiyaaban taana yeellayoppa.","poem":1}]},{"type":"verse","number":117,"content":[{"lineBreak":true},{"text":"Taana zemppissa; yaatooppe,","poem":1},{"text":"taani saro de'ana;","poem":2},{"lineBreak":true},{"text":"taani ubbaa wode ne awaayuwaa hayzzana.","poem":2}]},{"type":"verse","number":118,"content":[{"text":"Ne awaayuwaappe wora biyaawantta ubbaa neeni akkakka;","poem":1},{"text":"unttunttu c'imuu c'oo mela.","poem":2}]},{"type":"verse","number":119,"content":[{"text":"Sa'aan de'iyaa iitatuwaa ubbaa","poem":1},{"text":"neeni pituwaadan paydaasa;","poem":2},{"lineBreak":true},{"text":"hewaa diraw, taani neeni odeeddabaa siik'ay.","poem":2}]},{"type":"verse","number":120,"content":[{"text":"Ta bollay new yayyiide kokkoreedda;","poem":1},{"text":"taani ne pirddaw yayyay.","poem":2}]},{"type":"verse","number":121,"content":[{"text":"Likkebaanne s'illobaa ootsaad;","poem":1},{"text":"Taana uk'k'unniyaawanttoo oloppa.","poem":2}]},{"type":"verse","number":122,"content":[{"text":"Taana ne k'oomaa maaddanaw waase gida;","poem":1},{"text":"Taana otoranchchatuwaan uk'k'unnissoppa.","poem":2}]},{"type":"verse","number":123,"content":[{"text":"Neeni, «neena ashshana»","poem":1},{"text":"geedda s'illo k'aalaa polo gaade naagishin,","poem":2},{"lineBreak":true},{"text":"ta ayifii galjjeedda.","poem":2}]},{"type":"verse","number":124,"content":[{"text":"Taw, ne k'oomaw, neeni","poem":1},{"text":"aggena ne siik'uwaadan ootsa;","poem":2},{"lineBreak":true},{"text":"ne awaayuwaakka taana tamaarissa.","poem":2}]},{"type":"verse","number":125,"content":[{"text":"Taani ne k'oomaa;","poem":1},{"text":"neeni odiyaabaa taani erana mala,","poem":2},{"lineBreak":true},{"text":"akeekaa taw imma.","poem":2}]},{"type":"verse","number":126,"content":[{"text":"Abeet Med'inaa Godaw, asatuu","poem":1},{"text":"ne higgiyaa mentseedda diraw,","poem":2},{"lineBreak":true},{"text":"neeni pirddana wodii ha\"a.","poem":2}]},{"type":"verse","number":127,"content":[{"text":"Taani ne azazuwaa","poem":1},{"text":"work'k'aappe aatsaade siik'ay;","poem":2},{"text":"Ee, geeshsha work'k'aappekka aatsaade siik'ay.","poem":1}]},{"type":"verse","number":128,"content":[{"lineBreak":true},{"text":"Hewaa diraw, taani","poem":1},{"text":"ne wogatuu ubbay giyaawaadan hamettay;","poem":2},{"lineBreak":true},{"text":"geella ogiyaa ubbaa taani is's'ay.","poem":2}]},{"type":"verse","number":129,"content":[{"text":"Neeni odeeddabay malalissiyaabaa;","poem":1},{"text":"hewaa diraw, taani aw azazettay.","poem":2}]},{"type":"verse","number":130,"content":[{"text":"Ne k'aalaa biletsay poo'uwaa immee;","poem":1},{"text":"akeekay pac'c'eeddawanttoo akeekaa immee.","poem":2}]},{"type":"verse","number":131,"content":[{"text":"Taani ne azazoo,","poem":1},{"text":"daro saamettaade ta doonaa dooyay.","poem":2}]},{"type":"verse","number":132,"content":[{"text":"Haa taakko simma;","poem":1},{"text":"ne suntsaa siik'iyaawanttu ubbaw","poem":2},{"lineBreak":true},{"text":"neeni ootsiyaawaadan tawukka k'aretta.","poem":2}]},{"type":"verse","number":133,"content":[{"text":"Neeni geedda k'aalaadan","poem":1},{"text":"ta hemetaa suurissa;","poem":2},{"lineBreak":true},{"text":"ay nagaraynne taana mooddoppo.","poem":2}]},{"type":"verse","number":134,"content":[{"text":"Taani ne wogaw azazettanaw,","poem":1},{"text":"taana uk'k'unneeddawanttu kushiyaappe woza.","poem":2}]},{"type":"verse","number":135,"content":[{"text":"Ta bolla, ne k'oomaa bolla,","poem":1},{"text":"ne som\"uwaa poo'issa;","poem":2},{"lineBreak":true},{"text":"ne awaayuwaakka tamaarissa.","poem":2}]},{"type":"verse","number":136,"content":[{"text":"Ne higgiyaw Asay azazettibeena diraw,","poem":1},{"text":"ta ayifiyaappe afotsay shaafaadan goggee.","poem":2}]},{"type":"verse","number":137,"content":[{"text":"Abeet Med'inaa Godaw, neeni s'illuwaa;","poem":1},{"text":"ne pirddaykka likke.","poem":2}]},{"type":"verse","number":138,"content":[{"text":"Neeni odeeddabay","poem":1},{"text":"s'illuwaanne ubbaa ammanettiyaawaa.","poem":2}]},{"type":"verse","number":139,"content":[{"text":"Ta morkketuu ne k'aalaa toochcheedda diraw,","poem":1},{"text":"ne k'aalaa mishuu ta gomppan ees's'i keseedda.","poem":2}]},{"type":"verse","number":140,"content":[{"text":"Neeni geedda k'aalay daroppe ammanettiyaawaa;","poem":1},{"text":"taani, ne k'oomay Aa siik'ay.","poem":2}]},{"type":"verse","number":141,"content":[{"text":"Taani guutsanne kad'etteedda asaa;","poem":1},{"text":"gidooppenne, taani ne wogaa dogikke.","poem":2}]},{"type":"verse","number":142,"content":[{"text":"Ne s'illotetsay med'inaw de'ee;","poem":1},{"text":"ne higgiikka tuma.","poem":2}]},{"type":"verse","number":143,"content":[{"text":"Metuunne tuggay taana gakkeedda;","poem":1},{"text":"shin ne azazotuu taana nashechchiino.","poem":2}]},{"type":"verse","number":144,"content":[{"text":"Neeni odeeddabay med'inawukka s'illuwaa;","poem":1},{"text":"taani pas'a de'ana mala, akeekaa taw imma.","poem":2}]},{"type":"verse","number":145,"content":[{"text":"Abeet Med'inaa Godaw, kumentsaa wozanaappe,","poem":1},{"text":"new waassaad; taw alla.","poem":2},{"text":"Taanikka ne awaayuwaa azazettana.","poem":1}]},{"type":"verse","number":146,"content":[{"lineBreak":true},{"text":"Taani new waassaad; taana ashsha;","poem":1},{"text":"taanikka neeni odeeddabaa ootsana.","poem":2}]},{"type":"verse","number":147,"content":[{"text":"S'alk'k'ii dolenna guuran denddaade,","poem":1},{"text":"«Taana maadda» gaade new waassay.","poem":2},{"text":"Neeni taw geedda k'aalan hidootaa ootsay.","poem":1}]},{"type":"verse","number":148,"content":[{"lineBreak":true},{"text":"Ne k'aalaabaa zaara zaaraadde k'oppanaw,","poem":1},{"text":"k'amma utta ak'ay.","poem":2}]},{"type":"verse","number":149,"content":[{"text":"Abeet Med'inaa Godaw,","poem":1},{"text":"aggena ne siik'uwaa diraw, tawaa sisa;","poem":2},{"lineBreak":true},{"text":"ne s'illo pirddaadan taana pas'a wotsa.","poem":2}]},{"type":"verse","number":150,"content":[{"text":"Iitabaw taana yederssiyaawanttu,","poem":1},{"text":"taakko mateeddino;","poem":2},{"lineBreak":true},{"text":"unttunttu ne higgiyaappe haakkiino.","poem":2}]},{"type":"verse","number":151,"content":[{"text":"Shin abeet Med'inaa Godaw,","poem":1},{"text":"neeni ta matan de'aassa;","poem":2},{"lineBreak":true},{"text":"ne azazotuu ubbaykka tuma.","poem":2}]},{"type":"verse","number":152,"content":[{"text":"Taani benippe doommaade,","poem":1},{"text":"neeni odeeddabaa tamaaraad;","poem":2},{"text":"Aa neeni med'inaw minisa essaadda.","poem":1}]},{"type":"verse","number":153,"content":[{"text":"Ta tuggaa be'aade, taana ashsha;","poem":1},{"text":"ayaw gooppe, taani ne higgiyaa dogabeykke.","poem":2}]},{"type":"verse","number":154,"content":[{"text":"Ta diraw mootettaade taana woza;","poem":1},{"text":"neeni geedda k'aalaadan taana pas'a wotsa.","poem":2}]},{"type":"verse","number":155,"content":[{"text":"Ne awaayuwaa unttunttu akkena diraw,","poem":1},{"text":"atotetsay iitatuwaappe haakuwaan de'ee.","poem":2}]},{"type":"verse","number":156,"content":[{"text":"Abeet Med'inaa Godaw, ne k'aretay dara;","poem":1},{"text":"ne s'illo pirddaadan taana pas'a wotsa.","poem":2}]},{"type":"verse","number":157,"content":[{"text":"Ta morkketuunne taana yederssiyaawanttu dara;","poem":1},{"text":"shin taani neeni odeeddawaappe sher\"i giikke.","poem":2}]},{"type":"verse","number":158,"content":[{"text":"Unttunttu ne azazotuwaa naagenna diraw,","poem":1},{"text":"taani kaddiyaawantta be'aade shenetaad.","poem":2}]},{"type":"verse","number":159,"content":[{"text":"Abeet Med'inaa Godaw,","poem":1},{"text":"taani ne wogaa siik'iyaa siik'uwaa k'oppa;","poem":2},{"lineBreak":true},{"text":"aggena ne siik'uwaadan taana pas'a wotsa.","poem":2}]},{"type":"verse","number":160,"content":[{"text":"Ne k'aalay koyiroppekka tuma;","poem":1},{"text":"ne s'illo pirdday ubbaykka med'inaw de'ee.","poem":2}]},{"type":"verse","number":161,"content":[{"text":"Kaappatuu taana c'oo yederssiino;","poem":1},{"text":"shin ta wozanay ne k'aalaw yayyee.","poem":2}]},{"type":"verse","number":162,"content":[{"text":"Darobaa omoodeedda Asay nashettiyaawaadan,","poem":1},{"text":"neeni geedda k'aalan taani nashetay.","poem":2}]},{"type":"verse","number":163,"content":[{"text":"Taani wordduwaa is's'aynne shenetay;","poem":1},{"text":"shin ne higgiyaa siik'ay.","poem":2}]},{"type":"verse","number":164,"content":[{"text":"Ne s'illo pirddaa diraw,","poem":1},{"text":"taani neena gallassan laappu gede galatay.","poem":2}]},{"type":"verse","number":165,"content":[{"text":"Ne higgiyaa siik'iyaawanttoo","poem":1},{"text":"kumentsaa sarotetsay de'ee;","poem":2},{"lineBreak":true},{"text":"unttuntta ubbakka ayaynne d'ubbanaw danddayenna.","poem":2}]},{"type":"verse","number":166,"content":[{"text":"Abeet Med'inaa Godaw, taani","poem":1},{"text":"ne atotetsaa hidootaan naagay;","poem":2},{"lineBreak":true},{"text":"ne azazotuwaakka ootsay.","poem":2}]},{"type":"verse","number":167,"content":[{"text":"Taani neeni odeeddabaa naagay;","poem":1},{"text":"taani daroppe Aa siik'ay.","poem":2}]},{"type":"verse","number":168,"content":[{"text":"Taani ne wogawunne","poem":1},{"text":"neeni odeeddawoo azazettana;","poem":2},{"lineBreak":true},{"text":"ayaw gooppe, ta ogiyaa ubbaa neeni be'aasa.","poem":2}]},{"type":"verse","number":169,"content":[{"text":"Abeet Med'inaa Godaw, ta waasuu,","poem":1},{"text":"ne sintsa gakko;","poem":2},{"lineBreak":true},{"text":"neeni geedda k'aalaadan taw akeekaa imma.","poem":2}]},{"type":"verse","number":170,"content":[{"text":"Ta watiwatuu ne sintsa gakko;","poem":1},{"text":"neeni geedda k'aalaadan taana ashsha.","poem":2}]},{"type":"verse","number":171,"content":[{"text":"Neeni ne awaayuwaa","poem":1},{"text":"taana tamaarissiyaa diraw,","poem":2},{"lineBreak":true},{"text":"ta doonaappe galatay pulttana.","poem":2}]},{"type":"verse","number":172,"content":[{"text":"Ne azazotuu ubbay s'illo gidiyaa diraw,","poem":1},{"text":"ta ins's'arssay ne k'aalaabaa yes's'ana.","poem":2}]},{"type":"verse","number":173,"content":[{"text":"Taani ne wogaa dooreedda diraw,","poem":1},{"text":"ne kushii taana maaddanaw giigeeddawaa gido.","poem":2}]},{"type":"verse","number":174,"content":[{"text":"Abeet Med'inaa Godaw, neeni","poem":1},{"text":"taana ashshana mala laamotay;","poem":2},{"lineBreak":true},{"text":"ne higgiikka taana nashechchee.","poem":2}]},{"type":"verse","number":175,"content":[{"text":"Taani neena galatana mala,","poem":1},{"text":"taana pas'a wotsa;","poem":2},{"lineBreak":true},{"text":"ne pirddaykka taana maaddo.","poem":2}]},{"type":"verse","number":176,"content":[{"text":"Taani bayeedda dorssaadan bichchaaray;","poem":1},{"text":"taana ne k'oomaa koya;","poem":2},{"lineBreak":true},{"text":"ayaw gooppe, taani ne azazuwaa dogabeykke.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/120.json","nextChapterAudioLinks":{},"previousChapter