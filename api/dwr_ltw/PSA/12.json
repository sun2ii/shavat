{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":12,"content":[{"type":"heading","content":["Iita Alamiyaappe Attanaw Shiik'eedda Woosaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Diitsaan Yes'etteedda, Daawita Mazimuriyaa."]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Godaw, nuuna maaddaarikkii?","poem":1},{"text":"Ayaw gooppe, S'oossaa Asay ubbakka baawa;","poem":2},{"lineBreak":true},{"text":"asaa giddon ammanettiyaawe d'ayikichcheedda.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ubbaa wodekka ittuu ittoo wordduwaa haasayiino;","poem":1},{"text":"ittuu ittuwaa sheleeshshiyaa ins's'arssan baletsuwaan haasayiino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Abeet Med'inaa Godaw, ha sheleeshshiyaa doonaa bara.","poem":1},{"text":"Otoruwaan c'eek'ettiyaa ins's'arssaa ubbaa neeni c'igga olaa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Unttunttu, «Nuuni nu ins's'arssan s'oonana;","poem":1},{"text":"nu mettershay nuwaa; nu goday oonee?» yaagiino.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Med'inaa Goday, «Hiyyeesatuu un\"etteedda dirawunne,","poem":1},{"text":"Metootanchchatuwaa ooliyaa diraw,","poem":2},{"lineBreak":true},{"text":"ha\"i taani denddana.","poem":2},{"lineBreak":true},{"text":"Taani unttunttu amottiyaa sarotetsaan unttuntta wotsana» yaagee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"S'oossaa k'aalatuu walakki bayinna geeshshatuwaa;","poem":1},{"text":"c'ooc'iyaa taman laappun gede tigetteedda biraadan geeyyeeddawantta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Abeet Med'inaa Godaw, neeni unttuntta sarotetsaan naaganne","poem":1},{"text":"hawaa mala asaappe med'inaw unttuntta ashsha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Asaa gidduwaan iitay bonchchetteedda wode,","poem":1},{"text":"iitatuu ubbaa saanna simeretteeddino.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}