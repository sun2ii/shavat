{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":120,"content":[{"type":"heading","content":["C'imiyaawanttuppenne WorddotuwaappeAttanaw Shiik'o Woosaa"]},{"type":"hebrew_subtitle","content":["Pudetsaa kesiidde yes's'eedda yetsaa"]},{"type":"verse","number":1,"content":[{"text":"Ta waayiyaa wode taani Med'inaa Godaa s'eesaad;","poem":1},{"text":"I taw koyeedda.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abeet Med'inaa Godaw, worddotiyaa doonatuwaappenne,","poem":1},{"text":"c'immiyaa ins's'arssatuwaappe taana ashsha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hinttenoo worddanchchatoo,","poem":1},{"text":"S'oossay hinttena waatanddeeshsha?","poem":2},{"text":"Simmi harabaa ayaa gujjanddeeshsha?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tooranchchatuwaa pootsaa k'aran I hinttena c'addanawaa;","poem":1},{"text":"tamaa bonk'k'uwaan I hinttena s'uuggana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Aayye taanoo! Hinttenana de'iyaawe Mesheka","poem":1},{"text":"woy K'eedaare asaana de'iyaawaa mala iita.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sarotetsaa is's'iyaa asatuwaana","poem":1},{"text":"taani daro wodiyaa de'aaddi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Taani saro asaa;","poem":1},{"text":"shin taani sarotetsaabaa haasayiyaa wode,","poem":2},{"lineBreak":true},{"text":"unttunttu olaawaa haasayiino!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}