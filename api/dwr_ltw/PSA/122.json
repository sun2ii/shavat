{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":122,"content":[{"type":"heading","content":["Yerusaalamiw Shiik'eedda Sabaa"]},{"type":"hebrew_subtitle","content":["Pudetsaa kesiidde yes's'eedda yetsaa, Daawite s'aafeeddawaa"]},{"type":"verse","number":1,"content":[{"text":"Unttunttu taana, «Ane Med'inaa Godaa golliyaa boytte» yaagina,","poem":1},{"text":"taani nashetaad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neenoo Yerusaalame katamatee,","poem":1},{"text":"nuuni ne penggetuwaanna geliide ek'k'eeddo!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yerusaalame katamay,","poem":1},{"text":"dantsetiide minni kees'etteedda katamaa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Med'inaa Godaa awaayuwaadan,","poem":1},{"text":"Israa'eeliyaa zaratuu,","poem":2},{"text":"Med'inaa Godaa galatanaw yiyaa katamay hawaa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Daawita zeretsaappe kaateteeddawanttu","poem":1},{"text":"barenttu asaw pirddanaw yaan utteeddino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yerusaalame sarotetsaw","poem":1},{"text":"hawaadan yaagiide woossite;","poem":2},{"text":"«Neena siik'iyaawanttoo","poem":1},{"text":"unttunttu ootsiyaawe ubbay suuro!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne gimbbetuwaa giddon saruu de'o!","poem":1},{"text":"Ne geesatuwaakka bochchiyaabay d'ayo!» yaagiide woossite.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ta ishatuwaanne ta dabbotuwaa diraw gaade,","poem":1},{"text":"«Ne giddon saruu de'o!» yaagay.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Med'inaa Godaa nu S'oossaa golliyaa diraw gaade,","poem":1},{"text":"taani Yerusaalame durettanaw woosana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}