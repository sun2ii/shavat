e":"verse","number":6,"content":[{"text":"Nuuna nu morkkatuwaa matan,","poem":2},{"lineBreak":true},{"text":"s'oonissibeenna Med'inaa Goday galatetto.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nuuni shankkanchchatuwaa p'iriyaappe,","poem":1},{"text":"kafuu kessi akkiyaawaadan kessi akkeeddo.","poem":2},{"text":"P'irii me\"eedda, nuunikka kessi akki atteedo!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nu maaduu","poem":1},{"text":"saluwaanne sa'aa med'd'eedda Med'inaa Godaa suntsaappe yee.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}