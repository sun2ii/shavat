{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":126,"content":[{"type":"heading","content":["Omooduwaappe Simmeeddawanttu Mazimuriyaa"]},{"type":"hebrew_subtitle","content":["Pudetsaa kesiidde yes's'eedda yetsaa"]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Goday nuuna omoodetteeddawantta zaariide,","poem":1},{"text":"S'iyoone aheedda wode, nuw akumuwaa malateedda.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"He wode nuuni daro nashetti, miic'c'iide,","poem":1},{"text":"nashshechchaa yetsaa yes's'eeddo.","poem":2},{"text":"Yaatina, hara kawutetsatuu barenttu giddon,","poem":1},{"text":"«Hawanttoo Med'inaa Goday wolk'k'aamabaa ootseedda» yaageeddino.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tumukka Med'inaa Goday nuw wolk'k'aamabaa ootseedda;","poem":1},{"text":"nuunikka loytsi nashetteeddo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Abeet Med'inaa Godaw, Neegeeba Bazzuwaan iraa bukissaade,","poem":1},{"text":"shaafaa haatsaa zaara kuntsiyaawaadan,","poem":2},{"lineBreak":true},{"text":"nuwukka nu kaac'aa ooratsa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yeekkiide zereeddawanttu,","poem":1},{"text":"nashshechchan yes's'iidde c'akkana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Zeretsaa tookkiide, yeekkiidde beeddawanttu,","poem":1},{"text":"nashshechchaa yetsaa yes's'iidde,","poem":2},{"lineBreak":true},{"text":"mirk'k'iyaa tookkiide simmana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}