{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":127,"content":[{"type":"heading","content":["S'oossaan Ammanetanaaddan Imetteedda Zoriyaa"]},{"type":"hebrew_subtitle","content":["Pudetsaa kesiidde yes's'eedda yetsaa, Solomon s'aafeeddawaa"]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Goday golliyaa kees's'ana d'ayooppe,","poem":1},{"text":"kees's'iyaawanttu c'oo mela daaburiino.","poem":2},{"text":"Med'inaa Goday katamaa naagana d'ayooppe,","poem":1},{"text":"naagiyaawanttu c'oo mela naagiino.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neeni wontta guuran denddiyaawe,","poem":1},{"text":"omarssi k'amissaade gisiyaawe,","poem":2},{"lineBreak":true},{"text":"k'umaw hirggaade tuggatiyaawe c'oo mela;","poem":2},{"lineBreak":true},{"text":"ayaw gooppe, S'oossay bare siik'iyaawanttoo shemppuwaa immee.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Naanay Med'inaa Godaappe imettiyaa imotaa;","poem":1},{"text":"yelotuu tumuwaappe woytuwaa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Itti uray bare yalagatetsan yeleedda attuma naanatuu,","poem":1},{"text":"olanchchaa kushiyan de'iyaa tooratuwaa mala.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"He k'arc'c'iitan de'iyaa wonddaafiyaa tooratuwaadan,","poem":1},{"text":"daro naanatuu de'iyaa Asay anjjetteeddawaa.","poem":2},{"text":"Ayaw gooppe, I bare morkkatuwaanna,","poem":1},{"text":"katamaa penggiyaan mootettiyaa wode, ubbakka s'oonettenna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}