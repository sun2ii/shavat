m":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"S'iyoone is's'iyaa ubbay,","poem":1},{"text":"yeellatiide guyye simmo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Golliyaa huup'iyaan mokkiide,","poem":1},{"text":"dic'c'anaappe kasetiide meliyaa maataa mala gido.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"He maataa buuc'c'anaw kushiyaan dankkiyaawe,","poem":1},{"text":"woy mirk'k'iyaa k'achchiyaawe ooninne baawa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"He ogiyaanna aad'd'iyaawanttu,","poem":1},{"text":"«Med'inaa Goday wolk'k'aa immo» giina, c'akkiyaawanttu,","poem":2},{"text":"«Med'inaa Goday anjjo» giyaawe de'enna.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}