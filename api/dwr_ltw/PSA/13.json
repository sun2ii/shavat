{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":13,"content":[{"type":"heading","content":["Bare S'oossan Amaneteedda Asaa Woosaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, Daawita Mazimuriyaa."]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, awude gakkanaw neeni taana dogay?","poem":1},{"text":"Med'inaw taana dogay?","poem":2},{"lineBreak":true},{"text":"Awude gakkanaw neeni taappe geemmayi?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taani ta k'ofaanna baas'etiyaawe","poem":1},{"text":"awude gakkanaassee?","poem":2},{"text":"Ubbaa gallassi kayyuu ta wozanaan de'anawe","poem":1},{"text":"awude gakkanaassee?","poem":2},{"text":"Ta morkketuu ta bolla goobanawe","poem":1},{"text":"awude gakkanaassee?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Med'inaa Godaw ta S'oossaw, haa taakko s'eellaade,","poem":1},{"text":"taw zaara.","poem":2},{"text":"Ta ayifiyaa poo'issaade,","poem":1},{"text":"hayk'k'uwaappe taana ashsha.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"«Nuuni Aa s'ooneeddo» yaagiide,","poem":1},{"text":"ta morkketuu c'eek'ettennaadan te\"a.","poem":2},{"text":"Ta kunddetsan unttunttu nashettenaadan digga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Shin aggena ne maarotaan taani ammanettay;","poem":1},{"text":"neeni taana ashshiyaa diraw, taani nashettay.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Med'inaa Godaw, taani new yes's'ana;","poem":1},{"text":"ayaw gooppe, neeni taw keekkaadda.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}