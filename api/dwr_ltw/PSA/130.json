{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":130,"content":[{"type":"heading","content":["Maaduwaa demanaw Shiik'eedda Woosaa"]},{"type":"hebrew_subtitle","content":["Pudetsaa kesiidde yes's'eedda yetsaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, taani metuwaa c'iimman de'aadde,","poem":1},{"text":"neekko waassay.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abeet Godaw, ta kooshshaa sisa;","poem":1},{"text":"taani watiwatiyaa watiwatuwaa ne haytsay hayzzo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abeet Med'inaa Godaw, neeni,","poem":1},{"text":"nu nagaraa mazggobiyaan s'aafeeddentto,","poem":2},{"lineBreak":true},{"text":"abeet Godaw, won ooni pirddaappe attanaw danddayii?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Shin nuuni neena bonchchiidde azazettana mala,","poem":1},{"text":"nuw atto yaagaasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Taani Med'inaa Godaa naagay;","poem":1},{"text":"ee, taani Aa laamotaan naagay;","poem":2},{"text":"Aa k'aalankka hidootaa ootsay.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sa'ay awude wonttanddeeshsha","poem":1},{"text":"giide naagiyaa k'amma zabaynyatuwaappe aad'd'aade,","poem":2},{"lineBreak":true},{"text":"taani unttunttuppekka aatsaade,","poem":2},{"lineBreak":true},{"text":"Godaa laamotaan naagay.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Israa'eeliyaa asaw, Med'inaa Godaan hidootaa ootsite;","poem":1},{"text":"ayaw gooppe, aggena siik'uu Med'inaa Godaana;","poem":2},{"lineBreak":true},{"text":"k'ay I ubbaa gede asaa ashshanaw koyee.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Israa'eeliyaa asaa","poem":1},{"text":"unttunttu nagaraa ubbaappe ashshanawe Aa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}