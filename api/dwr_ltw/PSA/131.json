nk":"/api/dwr_ltw/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}