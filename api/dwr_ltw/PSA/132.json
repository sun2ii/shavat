{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":132,"content":[{"type":"heading","content":["Geeshsha Golliyaa Sabbanaw Shiik'o Mazimuriyaa"]},{"type":"hebrew_subtitle","content":["Pudetsaa kesiidde yes's'eedda yetsaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw,","poem":1},{"text":"Daawitanne I danddayeedda metuwaa k'oppa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Med'inaa Godaw I c'aak'k'eeddawaa,","poem":1},{"text":"Yaak'ooba s'oossaw, Wolk'k'aamaw","poem":2},{"text":"I hawaadan yaagiide geppeeddawaa hassaya;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"«Hawaappe guyiyaan taani ta golle gelikke,","poem":1},{"text":"woy ta hiis'an gisikke.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taani ta ayifiyaa c'iilimmikke,","poem":1},{"text":"woy gem\"ishikke.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hewenne, taani Med'inaa Godaw sa'aa,","poem":1},{"text":"Yaak'ooba S'oossaw, Wolk'k'aamaw","poem":2},{"lineBreak":true},{"text":"de'iyaasaa giigissana gakkanaassa» yaageedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hekko, nuuni Taabootaabaa,","poem":1},{"text":"Efiraatan siseeddo;","poem":2},{"text":"Yi'aariima giyaa biittaan Aa nuuni demmeeddo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nuuni, «Ane I de'iyaasaa boytte;","poem":1},{"text":"Aa gedii yed'd'iyaasaan guufanniide,","poem":2},{"lineBreak":true},{"text":"aw goyinneetto» yaageeddo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Abeet Med'inaa Godaw, dendda!","poem":1},{"text":"Ne minotetsaw mallaa gidiyaa ne Taabootaanna,","poem":2},{"lineBreak":true},{"text":"ne Geeshsha Golliyaa gelaade de'a.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ne k'eesatuu s'illotetsaa mayno;","poem":1},{"text":"ne asatuu nashshechchaw yes's'ino.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne k'oomaa Daawita diraw,","poem":1},{"text":"neeni okkeedda kaatiyaa aggoppa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Med'inaa Goday Daawitaw laamettena c'aak'uwaa","poem":1},{"text":"hawaadan yaagiide c'aak'k'eedda;","poem":2},{"text":"«Ne gulbbataappe yeletteedda ne naanatuwaappe ittuwaa","poem":1},{"text":"taani kawutsana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne naanatuu ta c'aak'uwaanne","poem":1},{"text":"taani tamaarissiyaa timirttiyaa naagooppe,","poem":2},{"lineBreak":true},{"text":"unttunttu naanatuukka ne kawutetsaa araatan med'inaw uttana» yaageedda.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Med'inaa Goday S'iyoone dooreedda;","poem":1},{"text":"barew de'iyaasaa ootsanawukka amottiide,","poem":2},{"lineBreak":true},{"text":"hawaadan yaageedda;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"«Hawe taw med'inaw de'iyaa sa'aa;","poem":1},{"text":"taani amotteedda diraw, hawaan uttana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Taani daro katsaa immaade S'iyoono anjjana;","poem":1},{"text":"izin de'iyaa hiyyeesatuwaakka k'umaa kalissana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Izin de'iyaa k'eesetuwaakka","poem":1},{"text":"taani atotetsaa mayzzana;","poem":2},{"lineBreak":true},{"text":"izin S'oossaa asatuukka nashshechchaw yes's'ana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«Ha sa'aan,","poem":1},{"text":"Daawita zeretsaappe ittuwaa kawutsana;","poem":2},{"lineBreak":true},{"text":"taani okkeedda kaatiyaa kawutetsaa gam\"etsana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Taani Aa morkkatuwaa yeellaa mayzzana;","poem":1},{"text":"shin Aa huup'iyaan de'iyaa kawutetsaa kallachchay p'oolana» yaageedda.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}