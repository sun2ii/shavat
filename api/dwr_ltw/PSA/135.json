{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":135,"content":[{"type":"heading","content":["Galataa Mazimuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Godaa galatite!","poem":1},{"lineBreak":true},{"text":"Hinttenoo Med'inaa Godaa k'oomatoo,","poem":1},{"text":"Med'inaa Godaa suntsaa galatite!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hinttenoo Med'inaa Godaa golliyaa giddon,","poem":1},{"text":"nu S'oossaa golliyaa dabaaban ek'k'eeddawanttoo,","poem":2},{"text":"S'oossaa galatite!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Med'inaa Goday keeka gidiyaa diraw,","poem":1},{"text":"Med'inaa Godaa galatite!","poem":2},{"text":"I lo\"a gidiyaa diraw,","poem":1},{"text":"Aa suntsaa sabbite!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Med'inaa Goday Yaak'ooba bare huup'ew,","poem":1},{"text":"Israa'eeliyaa asaakka barew buzo ootsiide dooreedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Med'inaa Goday wolk'k'aama gidiyaawaanne","poem":1},{"text":"nu Goday s'oossatuwaa ubbaappe d'ok'k'iyaawaa,","poem":2},{"lineBreak":true},{"text":"taani eray.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Saluwankka saankka,","poem":1},{"text":"abbatuwaaninne unttunttu c'iimmotuwaa ubbaa giddonkka,","poem":2},{"text":"Med'inaa Goday bare doseeddawaa ubbaa ootsee.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Iraa tooko shaariyaa sa'aa gas'aappe I dentsee;","poem":1},{"text":"I iraanna walk'k'antsaa kiittee;","poem":2},{"lineBreak":true},{"text":"bare minjjiyaa sa'aappe c'arkkuwaa kessee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gibs'e biittan asaa naanatuwaappenne,","poem":1},{"text":"mehiyaa maraappe,","poem":2},{"lineBreak":true},{"text":"bayira yeletteeddawantta wod'eedda.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neenoo Gibs'ee, Par\"oonanne Aa k'oomatuwaa muranaw,","poem":1},{"text":"hinttenttu gidon ooratsabaanne malalissiyaabaa yeddeedda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"I daro kawutetsatuwaa bayzzeedda;","poem":1},{"text":"wolk'k'aama kaatetuwaakka wod'eedda.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amooretuwaa kaatiyaa Sihoona,","poem":1},{"text":"Baasaane kaatiyaa Ooganne,","poem":2},{"lineBreak":true},{"text":"Kanaane kaatetuwaa ubbaa wod'eedda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Unttunttu biittaa bare asatuwaa,","poem":1},{"text":"Israa'eelatuwaa laatisseedda.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Abeet Med'inaa Godaw, ne suntsay med'inaw de'ana;","poem":1},{"text":"yeletaappe yeletaa gakkanaw Med'inaa Goday hassayettana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Med'inaa Goday bare asaw pirddana;","poem":1},{"text":"I bare k'oomatoo k'arettana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Gadiyaa asatuwaa eek'atuu asaa kushii","poem":1},{"text":"biraappenne work'k'aappe med'd'eeddawantta.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Unttunttoo doonay de'ee, shin haasayikkino;","poem":1},{"text":"ayifii de'ee, shin s'eellikkino.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Haytsay de'ee, shin sissikkino;","poem":1},{"text":"unttunttu doonaan shemppuu baawa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Unttuntta med'd'eeddawanttunne,","poem":1},{"text":"unttunttun ammanettiyaawanttu,","poem":2},{"lineBreak":true},{"text":"ubbay unttunttudan hanino.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Israa'eeliyaa golliyaa asatoo,","poem":1},{"text":"Med'inaa Godaa galatite;","poem":2},{"text":"Aaroona golliyaa asatoo,","poem":1},{"text":"Med'inaa Godaa galatite;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Leewiyaa golliyaa asatoo,","poem":1},{"text":"Med'inaa Godaa galatite;","poem":2},{"text":"Med'inaa Godaw yayyiyaawanttoo,","poem":1},{"text":"ubbay Med'inaa Godaa galatite.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yerusaalamen de'iyaa Med'inaa Goday","poem":1},{"text":"S'iyoonen galatetto!","poem":2},{"lineBreak":true},{"text":"Med'inaa Godaa galatite!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}