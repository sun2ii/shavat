{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":136,"content":[{"type":"heading","content":["Galataa Mazimuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Godaa galatite! Ayaw gooppe, I keeka;","poem":1},{"text":"aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"S'oossatuwaa S'oossaa galatite!","poem":1},{"text":"Aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Godatuwaa Godaa galatite!","poem":1},{"text":"Aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Aa s'alalay wolk'k'aama malalissiyaabaa ootsee;","poem":1},{"text":"aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bare aad'd'eeda eran I salotuwaa med'd'eedda;","poem":1},{"text":"aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Biittaa haatsaa bollan mic'c'eedda;","poem":1},{"text":"aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wolk'k'aama poo'otuwaa med'd'eedda;","poem":1},{"text":"aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Away gallassi mooddanaadan ootseedda;","poem":1},{"text":"aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Aginayinne s'oolinttetuu","poem":1},{"text":"k'amma mooddanaadan ootseedda;","poem":2},{"lineBreak":true},{"text":"aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"I Gibs'e biittan bayiratuwaa wod'eedda;","poem":1},{"text":"aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Israa'eeliyaa asaa,","poem":1},{"text":"Gibs'eppe kaaletsiide kesseedda;","poem":2},{"lineBreak":true},{"text":"aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bare mino kushiyan,","poem":1},{"text":"bare wolk'k'aama k'esiyaan hawaa ootseedda;","poem":2},{"lineBreak":true},{"text":"aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Zo'o Abbaa shaakki yegeedda;","poem":1},{"text":"aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Israa'eeliyaa asaa,","poem":1},{"text":"he abbaa gidduwaana pintseedda;","poem":2},{"lineBreak":true},{"text":"aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Gibs'e kaatiyaanne Aa olanchchatuwaa","poem":1},{"text":"Zo'o Abban muukisseedda;","poem":2},{"lineBreak":true},{"text":"aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"I bare asaa kaaletsiide,","poem":1},{"text":"bazzuwaana aatseedda;","poem":2},{"lineBreak":true},{"text":"aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wolk'k'aama kaatetuwaa shoc'eedda;","poem":1},{"text":"aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Eretteedda kaatetuwaa wod'eedda;","poem":1},{"text":"aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Amooretuwaa kaatiyaa Sihoona wod'eedda;","poem":1},{"text":"aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"K'ay Baasaane kaatiyaa Ooga wod'eedda;","poem":1},{"text":"aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yaatiide unttunttu biittaa bare asaa laatisseedda;","poem":1},{"text":"aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bare k'oomaa Israa'eeliyaa laatisseedda;","poem":1},{"text":"aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"I nuuni kawusheedda wodekka nuuna k'oppeedda;","poem":1},{"text":"aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nuuna nu morkkatuwaappe ashsheeda;","poem":1},{"text":"aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Med'etaa ubbaw k'umaa immee;","poem":1},{"text":"aggena Aa siik'uu med'inaawaa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Saluwaa S'oossaa galatite!","poem":1},{"text":"Aggena Aa siik'uu med'inaawaa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}