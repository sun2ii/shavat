{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":137,"content":[{"type":"heading","content":["Omooduwaan De'iyaa Israa'eeliyaa Yeekuwaa"]},{"type":"verse","number":1,"content":[{"text":"Baabloone shaafatuwaa matan uttiide,","poem":1},{"text":"nuuni S'iyoone k'oppeedda wode yeekkeeddo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"He sa'aan nuuni,","poem":1},{"text":"nu diitsaa haatsaa matan dic'c'iyaa mitsaa bolla kak'k'eeddo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nuuna omoodeedda asatuu,","poem":1},{"text":"nuuni yes's'iide, unttuntta nashshechchana mala,","poem":2},{"text":"«S'iyoone yetsaappe ittuwaa ane nuw yes's'ite» yaageeddino.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Med'inaa Godaa yetsaa, nuuni,","poem":1},{"text":"allaga biittan wooti yes's'anee?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yerusaalame katamatee, taani neena dogooppe,","poem":1},{"text":"ta ushechcha kushii bare oosuwaa dogo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani neena hassayennan aggooppenne","poem":1},{"text":"ta nashshechchaa ubbaappe aatsaade Yerusaalame dosennan aggooppe,","poem":2},{"lineBreak":true},{"text":"ta ins's'arssay kookkiyaana oyk'k'etto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Abeet Med'inaa Godaw, Yerusaalame omoodettiyaa gallassi,","poem":1},{"text":"Eedooma asatuu ootseeddawaa hassaya;","poem":2},{"lineBreak":true},{"text":"unttunttu, «kolite! kolite!","poem":2},{"lineBreak":true},{"text":"Hirkki s'ap'uwaa gakkanaw laalite!» yaageeddawaa dogoppa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Baabloone biittaw, neenikka bayana!","poem":1},{"text":"Neeni nu bollan ootseedda iita oosuwaa,","poem":2},{"lineBreak":true},{"text":"ne bolla ootsiyaawe anjjetteedawaa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ne guutsa naanatuwaa oyk'k'iide,","poem":1},{"text":"zaallaa bolla shoc'iyaawe anjjetteedawaa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}