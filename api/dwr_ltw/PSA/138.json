{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":138,"content":[{"type":"heading","content":["Galataa Woosaa"]},{"type":"hebrew_subtitle","content":["Daawite S'aafeeddawaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, taani ta kumentsaa wozanaappe neena galatana;","poem":1},{"text":"s'oossatuwaa sintsan neena sabbana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne Geeshsha Golliyaakko simmaade,","poem":1},{"text":"new goynaade, aggena ne siik'uwaanne ne tumatetsaa diraw,","poem":2},{"lineBreak":true},{"text":"taani ne suntsaa galatay;","poem":2},{"lineBreak":true},{"text":"ayaw gooppe, neeni ne suntsaanne ne k'aalaa,","poem":2},{"lineBreak":true},{"text":"ubbaappe aatsaade d'ok'k'u ootsaadda.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taani s'eeseedda gallassi taw koyaadda;","poem":1},{"text":"ne minotetsan taana minisaadda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Abeet Med'inaa Godaw, sa'aan de'iyaa kaatetuu ubbay,","poem":1},{"text":"neena galatino;","poem":2},{"lineBreak":true},{"text":"ayaw gooppe, unttunttu ne doonaappe keseedda k'aalaa siseeddino.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Med'inaa Godaa bonchchuu wolk'k'aama gidiyaa diraw,","poem":1},{"text":"unttunttu Med'inaa Godaa ogiyaawaa yes's'ana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Med'inaa Goday bolla d'ok'k'an de'ooppekka,","poem":1},{"text":"hiyyeesatuwaa keeka ayifiyaan s'eellee.","poem":2},{"text":"Shin otoranchchatuwaa I haakuwaan eree.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Taani metuwaa gidduwaana hamettooppekka,","poem":1},{"text":"neeni taana de'uwaan naagaasa.","poem":2},{"text":"Ta morkkatuwaa hank'k'uwaa bolla ne kushiyaa mic'c'aasa;","poem":1},{"text":"ne ushechchan taana ashshaasa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Med'inaa Goday taw giide k'oppeeddawaa polana;","poem":1},{"text":"abeet Med'inaa Godaw, aggena ne siik'uu med'inaawaa.","poem":2},{"text":"Ne kushiyaa oosuwaa agga aggoppa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}