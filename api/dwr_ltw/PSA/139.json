{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":139,"content":[{"type":"heading","content":["Ubbaa Eriyaa S'oossaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, Daawite s'aafeedda mazamuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, neeni taana biddaade eraadda.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Taani awude uttinttonne","poem":1},{"text":"awude ek'k'intto, neeni eraasa;","poem":2},{"lineBreak":true},{"text":"neeni ta k'ofaa ubbaa haakuwaan eraasa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taani biyaasaanne,","poem":1},{"text":"shemppiyaa sa'aa s'omoosaasa;","poem":2},{"lineBreak":true},{"text":"ta ogetuwaa ubbaa neeni eraasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Abeet Med'inaa Godaw, taani ta ins's'arssan","poem":1},{"text":"itti k'aalaa haasayanaappe kasetaade,","poem":2},{"lineBreak":true},{"text":"neeni ta k'ofaa ubbaa eraasa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neeni ta yuushshuwaan de'aassa;","poem":1},{"text":"ne kushiyan taana naagaasa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne eray taana loytsi malalissee;","poem":1},{"text":"taani akeekanaw danddayiyaasaappe d'ok'k'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Taani ne Ayaanappe hak'a baanaw danddayayitaa?","poem":1},{"text":"Woy ne sintsaappe hak'a bak'atanaw danddayayitaa?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Pude saluwaa kesooppe,","poem":1},{"text":"neeni yaan de'aassa!","poem":2},{"text":"Duge Si'ooliyaa wod'd'inttokka,","poem":1},{"text":"neeni yaan de'aassa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Away mokkiyaasaa bagga paallaade booppe,","poem":1},{"text":"woy away wulliyaasaa baggan haakkaade de'ooppe,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"he saankka ne kushii taana kaaletsee;","poem":1},{"text":"ne ushechcha kushii taana zemppissee.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Taani, «D'umaw, taana gentsaa;","poem":1},{"text":"poo'uwaa, k'ammaw laametta» yaaginttokka,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"d'umaa daruu new d'umenna;","poem":1},{"text":"k'ammay gallassaadan poo'ee;","poem":2},{"lineBreak":true},{"text":"ayaw gooppe, new d'umay poo'uwaa mala.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Neeni ta giddo asatetsaa ubbaa med'd'aadda;","poem":1},{"text":"ta aatti uluwaan taana neeni waas'a med'aadda.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Neeni taana malalissiyaabaanne ooratsabaa ootsaade med'd'eedda diraw,","poem":1},{"text":"taani neena galatay.","poem":2},{"text":"Ne oosotuu malalissiyaawantta!","poem":1},{"text":"Taani k'ay hewaa wurssaade eray.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Taani geema sa'aan med'ettiyaa wode,","poem":1},{"text":"ta mek'etsatuu neeppe geemmibeyikkino.","poem":2},{"text":"Ta bollay ta aatti uluwaa c'iimmaa giddon","poem":1},{"text":"hiillan alleek'k'ettiide oosettiyaa wode,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"yelettibeenna ta asatetsaa ne ayifii be'eedda.","poem":1},{"text":"Biro ittuunne doomettennan de'ishshin,","poem":2},{"lineBreak":true},{"text":"taw neeni giigiseedda gallassatuu ubbatuu","poem":2},{"lineBreak":true},{"text":"ne mazggobiyaan s'aafetteeddino.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abeet S'oossaw,","poem":1},{"text":"ne k'ofatuu ayaa c'oratteeddinoo!","poem":2},{"text":"Unttuntta eranawe ayaa waayissii!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Taani unttuntta paydintto,","poem":1},{"text":"unttunttu shafiyaappe darana shin.","poem":2},{"text":"Taani beegottiyaa wode,","poem":1},{"text":"ha\"ikka neenana de'ay.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Abeet S'oossaw, neeni iitatuwaa wod'aaddintto ayee de'ii!","poem":1},{"text":"Suutsaa gussiyaa asatuu taappe haakkino!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Unttunttu ne bolla iitabaa haasayiino;","poem":1},{"text":"ne morkketuu ne suntsaa bayzziino.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Abeet Med'inaa Godaw, neena is's'iyaawantta","poem":1},{"text":"taani is's'ikkitaa?","poem":2},{"text":"Ne bolla denddiyaawantta","poem":1},{"text":"taani shenetikkitaa?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Taani unttuntta ubbaa is's'ay;","poem":1},{"text":"unttuntta taani ta morkkatuwaadan payday.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Abeet S'oossaw,","poem":1},{"text":"taana biddaade, ta wozanaa era;","poem":2},{"lineBreak":true},{"text":"taana paac'c'aade, ta un\"etiyaa k'ofaa era.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ane taanan iitabay de'ooppe s'eella;","poem":1},{"text":"med'inaa ogiyaan taana kaaletsa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}