{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":14,"content":[{"type":"heading","content":["S'oossay Bayna Asatuwaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, Daawita Mazimuriyaa."]},{"type":"verse","number":1,"content":["Eeyyatuu barenttu wozanaan, «S'oossay baawa» yaagiino.",{"text":"Unttunttu de'uu bayeedda.","poem":1},{"text":"Unttunttu sheneyiyaawaa ootsiino;","poem":2},{"lineBreak":true},{"text":"lo\"iyaawaa ootsiyaa Asay baawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"S'oossaa koyiyaa eranchchatuu de'inttonne","poem":1},{"text":"be'anaw, Med'inaa Goday saluwaappe duge asaa s'eellee.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Shin ubbaykka wora simmeeddino;","poem":1},{"text":"ubbaykka ubbaanna go\"ennabaa gideeddino.","poem":2},{"text":"Lo\"iyaawaa ootsiyaa ooninne baawa;","poem":1},{"text":"haray atto ittuunne baawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Med'inaa Goday, «Hawanttu ta asaa,","poem":1},{"text":"asay k'umaa miyaawaadan bonk'k'i miino.","poem":2},{"text":"Iita asatuu tumu ayaanne akeekikkino?","poem":1},{"text":"Unttunttu taana woossikkino» yaageedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Shin S'oossay s'illo asatuwaana de'iyaa diraw,","poem":1},{"text":"iitatuu hewan dagamana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Unttunttu hiyyeesatuwaa k'ofaa halissiino;","poem":1},{"text":"shin Med'inaa Goday hiyyeesatuu bak'atiide, k'osetti attiyaa sa'aa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Israa'eeliyaw atotetsay S'iyooneppe yeerennee!","poem":1},{"text":"Med'inaa Goday unttunttu de'uwaa zaariyaa wode,","poem":2},{"text":"Yaak'ooba zeretsay nashettana;","poem":1},{"text":"Israa'eeliyaa Asay nashshechchaa pooc'u gaana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}