{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":140,"content":[{"type":"heading","content":["Iitatuwaa Bolla Shiik'eedda Woosaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, Daawite s'aafeedda mazamuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, iita asatuwaappe taana ashsha;","poem":1},{"text":"makkalanchcha asatuwaappe taana naaga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Unttunttu ubbaa wode,","poem":1},{"text":"iitabaa ootsanaw mak'ettiino;","poem":2},{"lineBreak":true},{"text":"ubbaa gallassikka,","poem":2},{"lineBreak":true},{"text":"walassaa dentsetsanaw k'oppiino.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Unttunttu barenttu ins's'arssaa shooshshaawaadan k'arayiino;","poem":1},{"text":"unttunttu doonaappe asaa wod'iyaa hasuwaa shooshshaa yishshaa mala haasayay kesee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Abeet Med'inaa Godaw, iita asatuwaa kushiyaappe,","poem":1},{"text":"taana ashsha;","poem":2},{"lineBreak":true},{"text":"ta gediyaa k'as's'anaw k'oppiyaa makkalanchcha asatuwaappe taana naaga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Otoranchcha asatuu taw diizzaa giigisseeddino;","poem":1},{"text":"gitiyaa hiis's'eeddino;","poem":2},{"lineBreak":true},{"text":"taana oyk'k'anaw p'iriyaa ogiyaan wotseeddino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Taani Med'inaa Godaa, «Neeni ta S'oossaa» yaagay.","poem":1},{"text":"Abeet Med'inaa Godaw, taani watiwatiyaa watiwatuwaa sisa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abeet Ubbaa Mooddiyaa Med'inaa Godaw,","poem":1},{"text":"taana ashshiyaa minoo,","poem":2},{"lineBreak":true},{"text":"olaa gallassi taw gonddale gidaadda.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abeet Med'inaa Godaw,","poem":1},{"text":"iitatoo unttunttu amuwaa immoppa;","poem":2},{"lineBreak":true},{"text":"unttunttu iita mak'k'uwaa polissoppa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ta morkkatuwaan taana s'oonissoppa;","poem":1},{"text":"unttunttu doonaappe kesiyaa iitabay unttunttoo simmo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Unttunttu bolla s'uuggiyaa bonk'k'uu k'oletto;","poem":1},{"text":"unttunttu taman olettino;","poem":2},{"lineBreak":true},{"text":"hewaappe laa\"entso denddenna olan oletino.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Zigiriyaawantta biittay tookkoppo;","poem":1},{"text":"makkalanchcha asatuwaa iitabay shankkatiide oyk'k'o.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Med'inaa Goday hiyyeesatoo pirddiyaawaanne,","poem":1},{"text":"metootanchchatuwaa maataa naagisiyaawaa eray.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tumuppe s'illotuu ne suntsaa galatana;","poem":1},{"text":"suure asatuu ne sintsan de'ana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}