{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":141,"content":[{"type":"heading","content":["Omarssa Woosaa"]},{"type":"hebrew_subtitle","content":["Daawite s'aafeedda mazamuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, taani neena s'eesay;","poem":1},{"text":"taana maaddanaw elleella.","poem":2},{"text":"Taani neekko waassiyaa wode, ta kooshshaa sisa!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ta woosay is'aanaa c'uwaadan,","poem":1},{"text":"ne sintsa shiik'o;","poem":2},{"lineBreak":true},{"text":"taani ta kushiyaa mic'c'iyaawe,","poem":2},{"lineBreak":true},{"text":"new omarssa yarshshuwaa mala gido.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Abeet Med'inaa Godaw, ta doonaa naagiyaawaa wotsa;","poem":1},{"text":"ta mettershshatuwaa penggiyaan zabayinyaa essa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bayzzuwaa ootsiyaa asatuwaanna,","poem":1},{"text":"iita oosuwaa ootsenna mala,","poem":2},{"lineBreak":true},{"text":"ta wozanaa iitabaakko zaaroppa.","poem":2},{"lineBreak":true},{"text":"Unttunttu gibiraakka taana muzoppa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"S'illo Asay taana aggena siik'uwaan","poem":1},{"text":"seeranawunne muranaw danddayee;","poem":2},{"lineBreak":true},{"text":"unttunttu taana bak'k'ooppe hewe ta huup'iyaan zayitiyaa okkiyaawaa mala;","poem":2},{"lineBreak":true},{"text":"ayaw gooppe, taani ubbaa gedekka","poem":2},{"lineBreak":true},{"text":"iitatuwaa oosuwaa bolla woossay.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Unttunttu daannatuu zaallaa aafuwaana,","poem":1},{"text":"duge olettiyaa wode,","poem":2},{"lineBreak":true},{"text":"ta k'aalay tuma gidiyaawaa unttunttu Asay erana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Biittay goshetiyaawaadaaninne","poem":1},{"text":"guullu me\"eretiyaawaadan","poem":2},{"lineBreak":true},{"text":"unttunttu mek'etsaykka duufuwaa doonaan laalettana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Abeet Ubbaa Mooddiyaa Med'inaa Godaw,","poem":1},{"text":"ta ayifii neena s'eellee;","poem":2},{"lineBreak":true},{"text":"taani neekko bak'ataade attay;","poem":2},{"lineBreak":true},{"text":"taana hayk'oo aatsaade immoppa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Unttunttu taw wotseedda gitiyaappenne,","poem":1},{"text":"iitaa ootsiyaawanttu p'iriyaappe taana naaga.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Taan saro aad'd'iyaa wode,","poem":1},{"text":"iitatuu barenttu wotseedda gitiyaan oyk'k'ettino.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}