{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":142,"content":[{"type":"heading","content":["S'oossaa Maaduwaa Demanaw Shiik'eedda Woosaa"]},{"type":"hebrew_subtitle","content":["Akeekan S'aafetteedda Daawita Timirttiyaa, Gonggolo giddon de'iyaa wode Aa woosaa"]},{"type":"verse","number":1,"content":[{"text":"Ta k'aalaa d'ok'k'u ootsaade, Med'inaa Godaw waassay.","poem":1},{"text":"Ta k'aalaa d'ok'k'u ootsaade,","poem":2},{"lineBreak":true},{"text":"Med'inaa Godaw watiwatay.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta k'ohuwaa ubbaa aw magannay;","poem":1},{"text":"ta metuwaa ubbaa aw oday.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taani hidoota k'ans's'ana matiyaa wode, neeni ta ogiyaa eraasa.","poem":1},{"text":"Taani hamettiyaa ogiyaan taw gitiyaa k'osi wotseeddino.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taani ta yuushshuwaa s'eelliyaa wode,","poem":1},{"text":"taana maaddiyaawe ittuunne baawa;","poem":2},{"lineBreak":true},{"text":"taani k'osetta attiyaa sa'ay baawa;","poem":2},{"lineBreak":true},{"text":"taana naagiyaawekka baawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Abeet Med'inaa Godaw, taani,","poem":1},{"text":"new hawaadan gaade waassay;","poem":2},{"text":"«Neeni taani bak'ataade attiyaa sa'aa;","poem":1},{"text":"taani pas'a de'ishshin, taana gakkeedda saamay neena» yaagay.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani loytsa metootiyaa diraw,","poem":1},{"text":"ta waasuwaa hayzza.","poem":2},{"text":"Taana yederssiyaawanttu,","poem":1},{"text":"taw loytsi wolk'k'aameedda diraw,","poem":2},{"lineBreak":true},{"text":"taana unttunttuppe ashsha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Taani ne suntsaa galatana mala,","poem":1},{"text":"taana k'ashuwaappe billa.","poem":2},{"text":"Neeni taw keekiyaa diraw,","poem":1},{"text":"s'illotuu ta yuushshuwaan shiik'ana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}