{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":143,"content":[{"type":"heading","content":["S'oossaa Maaduwaa Demanaw Shiik'eedda Woosaa"]},{"type":"hebrew_subtitle","content":["Daawite s'aafeedda mazamuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, ta woosaa sisa; ta watiwatuwaa hayzza.","poem":1},{"text":"Neeni s'illuwaanne ammanettiyaawaa gidiyaa diraw,","poem":2},{"lineBreak":true},{"text":"taw zaaruwaa imma.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne sintsan s'illo gidana Asay baawa;","poem":1},{"text":"hewaa diraw, taana ne k'oomaa pirddaw shiishshoppa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Taana ta morkkii yederssiide,","poem":1},{"text":"biittaana gatsi kinchchereetseedda;","poem":2},{"lineBreak":true},{"text":"beni hayk'k'eedda asatuwaadan taana d'uman wotseedda.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hewaa diraw, taani hidootaa k'ans's'aad;","poem":1},{"text":"ta wozanaykka yibbaateedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Taani beni wodetuwaa hassayay;","poem":1},{"text":"neeni ootseedda oosuwaa ubbaa zaara zaaraadde k'oppaynne","poem":2},{"lineBreak":true},{"text":"ne kushii ootseeddawaa akeekay.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani ta kushiyaa neekko mic'c'aad;","poem":1},{"text":"mela biittay haatsaa koyiyaawaadan,","poem":2},{"lineBreak":true},{"text":"ta shemppuu neena saamettee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Abeet Med'inaa Godaw, taw zaaruwaa immanaw elleella!","poem":1},{"text":"Taani hidootaa k'ans's'aad.","poem":2},{"text":"Taani duge duufuwaan geliyaa asatuwaa mala gidennaadan,","poem":1},{"text":"ne som\"uwaa taappe gentsoppa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Taani neena ammanettiyaa diraw,","poem":1},{"text":"wontta wontta aggena ne siik'uwaa taana bessa.","poem":2},{"text":"Taani ta shemppuwaappe neena woossiyaa diraw,","poem":1},{"text":"taani baanaw bessiyaa ogiyaa taana tamaarissa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Abeet Med'inaa Godaw, taani neekko bak'ateedda diraw,","poem":1},{"text":"taana ta morkkatuwaappe ashsha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Neeni ta S'oossaa gidiyaa diraw,","poem":1},{"text":"taani ne sheniyaa ootsana mala, taana tamaarissa;","poem":2},{"lineBreak":true},{"text":"lo\"o Ayyaanan taana suure ogiyaa kaaletsa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abeet Med'inaa Godaw, ne suntsaa diraw, taana ashsha;","poem":1},{"text":"ne s'illotetsan taana metuwaappe kessa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Aggena ne siik'uwaan ta morkkatuwaa wod'a;","poem":1},{"text":"ta baaligaaratuwaa ubbaa d'ayissa;","poem":2},{"lineBreak":true},{"text":"ayaw gooppe, taani ne k'oomaa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}