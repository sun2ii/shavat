{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":144,"content":[{"type":"heading","content":["S'oonuwaa Mazimuriyaa"]},{"type":"hebrew_subtitle","content":["Daawite s'aafeeddawaa"]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Goday, ta zaallay galatetto! I ta kushiyaa olaw,","poem":1},{"text":"ta birad'd'etuwaakka tooraw loohissee.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"I taana siik'iyaa S'oossaanne ta geessuwaa;","poem":1},{"text":"I ta miis'aanne taana ashshiyaawaa.","poem":2},{"text":"I ta gonddalliyaanne taani bak'ataade attiyaa sa'aa.","poem":1},{"text":"Kawutetsatuwaa I taw moodissiyaawaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Abeet Med'inaa Godaw,","poem":1},{"text":"neeni aw k'oppiyaa Asay I ayee?","poem":2},{"text":"Neeni naagetiyaa asaa na'ay ayee?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Asay itti gede c'arkkiyaa c'arkkuwaa mala;","poem":1},{"text":"Aa gallassatukka aad'd'iyaa kuwaa mala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Abeet Med'inaa Godaw, ne saluwaa daakaade duge wod'd'a!","poem":1},{"text":"Wogga deretuwaa bochcha; unttunttukka c'uwattino!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Walk'k'antsaa yeddaade ne morkkatuwaa laala!","poem":1},{"text":"Ne wonddaafiyaa pootsaa yeddaade unttuntta yederssa!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bollaanna ne kushiyaa duge yeddaade,","poem":1},{"text":"taana c'iimmo haatsatuwaappe goochchaade kessa;","poem":2},{"lineBreak":true},{"text":"allaga asatuwaa kushiyaappe taana wotsa akka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Unttunttu tumuwaa haasayikkino,","poem":1},{"text":"C'aak'k'iiddekka wordduwaa haasayiino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Abeet S'oossaw, taani","poem":1},{"text":"new ooratsa yetsaa yes's'ana;","poem":2},{"lineBreak":true},{"text":"tammu bak'etsaan waas'etteedda diitsaan new diis's'ana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kaatetoo s'oonuwaa immaasa;","poem":1},{"text":"ne k'oomaa Daawita ashshaasa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Taana iitaa mashshaappe ashshaasa;","poem":1},{"text":"allaga asatuwaa kushiyaappe taana wotsa akka.","poem":2},{"text":"Unttunttu tumuwaa haasayana giide c'aak'k'iiddekka,","poem":1},{"text":"wordduwaa haasayiino.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nu attuma naanatuu,","poem":1},{"text":"barenttu yalagatetsan dolk'k'idolk'k'iide,","poem":2},{"lineBreak":true},{"text":"dic'c'iyaa mitsaa mala gidino.","poem":2},{"lineBreak":true},{"text":"Nu mac'c'a naanatuukka kaatiyaa golliyaa zooziyaan,","poem":2},{"lineBreak":true},{"text":"alleek'k'oo esseedda tuuk'iyaa mala gidino.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nu diyyetuu,","poem":1},{"text":"daro dumma dumma k'ommo katsaan kumino;","poem":2},{"lineBreak":true},{"text":"nu dembbatuwaan de'iyaa dorssatuu sha\"aa,","poem":2},{"lineBreak":true},{"text":"tammu sha\"aa yelino.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nu miizzatuu birassino;","poem":1},{"text":"unttunttu sal\"eesenan yelettiide c'orattino.","poem":2},{"text":"Nu ogetuwaan dagama waasuu sisettoppo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ha yewuu tumu haniyaa asatuu,","poem":1},{"text":"anjjetteeddawantta.","poem":2},{"text":"Unttunttu S'oossay Med'inaa Godaa gidiyaa asatuu","poem":1},{"text":"anjjetteeddawantta.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}