{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":145,"content":[{"type":"heading","content":["Galataa S'oossaw"]},{"type":"hebrew_subtitle","content":["Daawite s'aafeedda galataa sabaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet ta S'oossaw, ta kaatiyaw, taani neena gitayananne,","poem":1},{"text":"ne suntsaa med'i med'inaw galatana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taani neena ubbaa gallassi sabbana;","poem":1},{"text":"ne suntsaakka med'i med'inaw galatana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Med'inaa Goday wolk'k'aama; d'ok'k'a galatay aw bessee.","poem":1},{"text":"Aa gitatetsay asaa k'ofaappe aad'd'ee.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Itti yeletay hara yeletaw","poem":1},{"text":"neeni ootseeddawaa odana;","poem":2},{"lineBreak":true},{"text":"ne malalissiyaa oosotuwaakka awaayana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Unttunttu ne bonchchuwaanne","poem":1},{"text":"ne anggaa gitatetsaabaa haasayana;","poem":2},{"lineBreak":true},{"text":"taanikka ne malalissiyaa oosuwaa","poem":2},{"lineBreak":true},{"text":"zaara zaaraadde k'oppana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Asay, «Hoola!» giissiyaa ne oosuwaa wolk'k'aabaa haasayana;","poem":1},{"text":"taanikka ne gitatetsaa awaayana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Unttunttu ne keekkatetsaa daruwaa odana;","poem":1},{"text":"ne s'illotetsaabaakka yes's'ana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Med'inaa Goday k'arettiyaawaanne maariyaawaa;","poem":1},{"text":"I hank'k'ettanaw elleellennawaanne;","poem":2},{"lineBreak":true},{"text":"danddayanchchanne aggena siik'uu dariyaawaa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Med'inaa Goday ubbaw keeka;","poem":1},{"text":"I bare med'd'eedda ubbaw k'arettiyaawaa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abeet Med'inaa Godaw,","poem":1},{"text":"ne med'etaa ubbay neena galatana;","poem":2},{"lineBreak":true},{"text":"ne asatuu ubbaykka neena sabbana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Unttunttu ne kawutetsaa bonchchuwaabaa haasayana;","poem":1},{"text":"ne wolk'k'aabaa odana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hewenne, ne wolk'k'aama oosuwaabaanne","poem":1},{"text":"ne kawutetsaa bonchchuwaa anggaabaa","poem":2},{"lineBreak":true},{"text":"asaa erissana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ne kawutetsay med'inaa kawutetsaa;","poem":1},{"text":"ne maatay yeletaa ubbaa gakkanaassa.","poem":2},{"lineBreak":true},{"text":"Med'inaa Goday bare geedda k'aalaw ubbaw ammanettiyaawaa;","poem":1},{"text":"I bare oosuwaa ubbaan k'arettiyaawaa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Med'inaa Goday hokkeeddawantta ubbaa zemppissee;","poem":1},{"text":"kunddeeddawantta ubbaa dentsee.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ubbaa ayifii neekko s'eellee;","poem":1},{"text":"unttuntta koshshiyaa wodiyaan neeni unttunttoo k'umaa immaasa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Neeni ne kushiyaappe imma;","poem":1},{"text":"pas'a de'iyaawantta ubbaa amuwaa alaa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Med'inaa Goday bare ogiyaan ubbaan s'illuwaa;","poem":1},{"text":"I bare oosuwaa ubbaan k'arettiyaawaa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Med'inaa Goday barena s'eesiyaa ubbaw,","poem":1},{"text":"tumuwaan barena s'eesiyaa ubbaw matan de'ee.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"I barew yayyiyaawanttu ubbaw,","poem":1},{"text":"amuwaa kuntsee.","poem":2},{"text":"K'ay I unttunttu waasuwaa sisiide,","poem":1},{"text":"unttuntta ashshee.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Med'inaa Goday barena siik'iyaawantta ubbaa naagee;","poem":1},{"text":"shin iitatuwaa ubbaa d'ayissana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Taani ta doonaan Med'inaa Godaa galatana.","poem":1},{"text":"Med'etaa ubbay Aa geeshsha suntsaa","poem":2},{"lineBreak":true},{"text":"med'i med'inaw galato!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}