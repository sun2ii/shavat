{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":146,"content":[{"type":"heading","content":["Maadda S'oossaw Galataa"]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Godaa galatite!","poem":1},{"lineBreak":true},{"text":"Ta shemppattee Med'inaa Godaa galataa!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta de'uwaa laytsaa ubbaan,","poem":1},{"text":"taani Med'inaa Godaa galatana;","poem":2},{"lineBreak":true},{"text":"taani de'eedda keenan ubbaan","poem":2},{"lineBreak":true},{"text":"ta S'oossaa sabbana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Asay ashshanaw danddayenna diraw,","poem":1},{"text":"asaa kaappatuwaan ammanettoppite.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Unttunttu shemppuu kesiyaa wode,","poem":1},{"text":"unttunttu biittaw simmiino;","poem":2},{"lineBreak":true},{"text":"unttunttu halchchuu ubbay","poem":2},{"lineBreak":true},{"text":"he gallassikka atti aggee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yaak'ooba S'oossay maaddiyaa uraynne","poem":1},{"text":"Med'inaa Godaa bare S'oossaa barew hidootaa ootsiyaa uray,","poem":2},{"lineBreak":true},{"text":"anjjetteeddawaa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Med'inaa Goday saluwaanne sa'aa,","poem":1},{"text":"wolk'k'aama abbaanne Aa giddon de'iyaawaa ubbaa,","poem":2},{"lineBreak":true},{"text":"med'd'eeddawaa;","poem":2},{"lineBreak":true},{"text":"I med'inawukka ammanettiyaawaa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I naak'etteeddawanttoo pirddiyaawaa;","poem":1},{"text":"koshateeddawanttoo k'umaa immiyaawaa.","poem":2},{"lineBreak":true},{"text":"Med'inaa Goday k'ashetteeddawantta billee;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Med'inaa Goday k'ook'etuwaa s'eelissee.","poem":1},{"text":"Med'inaa Goday kunddeeddawantta dentsee;","poem":2},{"text":"Med'inaa Goday s'illotuwaa siik'ee.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Med'inaa Goday betetuwaa naagee.","poem":1},{"text":"Am\"etuwaanne aawuu bayinna naanatuwaa maaddee;","poem":2},{"lineBreak":true},{"text":"shin iitatuwaa ogiyaa baletsee.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Med'inaa Goday med'inaw kaatetee.","poem":1},{"text":"S'iyoonee, ne S'oossay,","poem":2},{"lineBreak":true},{"text":"yeletaappe yeletaa gakkanaw kaatetana.","poem":2},{"lineBreak":true},{"text":"Med'inaa Godaa galatite!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}