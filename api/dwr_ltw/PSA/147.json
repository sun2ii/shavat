{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":147,"content":[{"type":"heading","content":["Ubbaa Danddayiyaa S'oossaw Shiik'iyaa Galataa"]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Godaa galatite! Nu S'oossaa sabbiyaawe lo\"a;","poem":1},{"text":"Aa sabbiyaawe nashechchiyaabaanne bessiyaawaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Med'inaa Goday Yerusaalame ooratsana;","poem":1},{"text":"Israa'eeliyaa asatuwaappe beteeddawanttakka shiishshana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wozanay me\"eeddawantta I patsee;","poem":1},{"text":"unttunttu madutsaakka I k'achchee.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I s'oolinttetuwaa","poem":1},{"text":"unttunttu payduwaan eree;","poem":2},{"lineBreak":true},{"text":"unttuntta ubbaakka unttunttu suntsan suntsan s'eesee.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nu Goday wolk'k'aama; Aa wolk'k'ay dara;","poem":1},{"text":"Aa akeekay likkiyaappe aad'd'iyaawaa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Med'inaa Goday naak'etteeddawantta zemppissee;","poem":1},{"text":"shin iitatuwaa biittan duge olee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Med'inaa Godaw galataa yetsaa yes's'ite;","poem":1},{"text":"nu S'oossaw diitsaa diis's'ite.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"I saluwaa shaariyaa kamee;","poem":1},{"text":"sa'aw iraa bukissee;","poem":2},{"lineBreak":true},{"text":"k'eeri deretuwaa bolla maataa mokissee.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mehetoonne waassiyaa k'uuruwaa maratoo,","poem":1},{"text":"miyaawaa I immee.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"I nashettiyaawe paratuwaa wolk'k'aaninne,","poem":1},{"text":"tooranchchatu minotetsan gidenna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Med'inaa Goday barew yayyiyaawanttuninne","poem":1},{"text":"aggena Aa siik'uwaan,","poem":2},{"lineBreak":true},{"text":"barenttu hidootaa wotseeddawanttun nashettee.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yerusaalame katamatee, Med'inaa Godaa galataa!","poem":1},{"text":"S'iyoonee, ne S'oossaa galataa!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ayaw gooppe, I,","poem":1},{"text":"ne penggiyaa kulbbatuwaa minisee;","poem":2},{"lineBreak":true},{"text":"ne giddon de'iyaa ne asaakka anjjee.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"I ne zawaa sarotetsaan naagee;","poem":1},{"text":"neena loytsi lo\"iyaa zarggaa kalissee.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"I bare kiitaa sa'aw kiittee;","poem":1},{"text":"Aa k'aalaykka elle gakkee.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"I shachchaa bullukkuwaadan mic'c'ee;","poem":1},{"text":"ketterssaa bidintsaadan laalee.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"I bare wolk'k'aama shachchaa","poem":1},{"text":"shuchchaadan duge olee.","poem":2},{"text":"He meeguwaan ek'k'anaw ooninne danddayenna.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"I bare k'aalaa kiittiide,","poem":1},{"text":"shachchaa muushissee.","poem":2},{"text":"I c'arkkuwaa c'arkkissina, haatsay goggee.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"I bare k'aalaa Yaak'ooba zeretsaw,","poem":1},{"text":"bare awaayuwaanne pirddaa","poem":2},{"text":"Israa'eeliyaa asaw awaayee.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"I hara kawutetsaa asaw,","poem":1},{"text":"hawaa ootsibeenna;","poem":2},{"lineBreak":true},{"text":"unttunttu Aa pirddaa erikkino.","poem":2},{"lineBreak":true},{"text":"Med'inaa Godaa galatite!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}