{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":148,"content":[{"type":"heading","content":["Med'etay Ubbay S'oossaa Galato"]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Godaa galatite!","poem":1},{"lineBreak":true},{"text":"Salotuwaan de'iyaawanttoo, Med'inaa Godaa galatite;","poem":2},{"lineBreak":true},{"text":"bolla d'ok'k'an de'iyaawanttoo, Aa galatite.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hinttenoo, Aa kiitanchchatoo,","poem":1},{"text":"ubbatuu Aa galatite.","poem":2},{"text":"Saluwaan de'iyaa Aa olanchchatoo,","poem":1},{"text":"ubbatuu Aa galatite.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Awaw, aginaw, Aa galatite;","poem":1},{"text":"poo'iyaa s'oolinttetoo, ubbatoo Aa galatite.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hinttenoo, ubbaappe bolla d'ok'k'an de'iyaa salotoo,","poem":1},{"text":"Aa galatite.","poem":2},{"text":"Saluwaappe bollaanna de'iyaa haatsatoo,","poem":1},{"text":"Aa galatite.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Unttunttu ubbatuu Med'inaa Godaa suntsaa galatino;","poem":1},{"text":"ayaw gooppe, I azazina,","poem":2},{"text":"Unttunttu ubbaykka med'etteeddino.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I unttuntta med'i med'inaw","poem":1},{"text":"unttunttu sa'aan sa'aan wotseedda.","poem":2},{"text":"Unttunttu ubbakka is's'anaw danddayenna azazuwaa I unttunttoo immeedda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sa'aan de'iyaawanttoo, Med'inaa Godaa galatite!","poem":1},{"text":"Abban de'iyaa med'etatoo, wolk'k'aama abbaa c'iimmatoo,","poem":2},{"lineBreak":true},{"text":"ubbatuukka Aa galatite.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hinttenoo, walk'k'antsaw,","poem":1},{"text":"shachchaw, shaariyaw, c'aaganaw,","poem":2},{"text":"Aa azazuwaa poliyaa gotiyaw,","poem":1},{"text":"Ubbatuukka Aa galatite.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hinttenoo, deretoo, zoozetoo,","poem":1},{"text":"Miyaa ayifiyaa ayifiyaa mitsatoo, zigatoo,","poem":2},{"lineBreak":true},{"text":"ubbatuukka Aa galatite.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mehetoo, do'atoo,","poem":1},{"text":"sa'aanna gooshettiyaa med'etatoo,","poem":2},{"lineBreak":true},{"text":"paalliyaa kafotoo,","poem":2},{"lineBreak":true},{"text":"Ubbatuukka Aa galatite.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sa'aa kaatetoo, kawutetsaa asatoo,","poem":1},{"text":"kaappatoo, asaa mooddiyaawanttoo,","poem":2},{"text":"Ubbatuukka Aa galatite.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wodallatoo, wodoratoo,","poem":1},{"text":"c'imatoo, naanaatoo,","poem":2},{"text":"Ubbatuukka Aa galatite!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Unttunttu ubbatuu Med'inaa Godaa suntsaa galatino;","poem":1},{"text":"Ayaw gooppe, Aa suntsay ubbaappe bollaanna de'iyaawaa;","poem":2},{"text":"Aa bonchchuu salotuwaappekka sa'aappekka bollaanna d'ok'k'an de'ee.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aa bagga gidiyaa, aw matattiyaa Israa'eeliyaa asatuu,","poem":1},{"text":"Aa galatana mala, I unttuntta minisee.","poem":2},{"lineBreak":true},{"text":"Med'inaa Godaa galatite!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}