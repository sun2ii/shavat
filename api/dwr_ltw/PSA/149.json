{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":149,"content":[{"type":"heading","content":["S'oonuwaa Mazimuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Godaa galatite! Med'inaa Godaw ooratsa yetsaa yes's'ite!","poem":1},{"text":"Ammaniyaawanttu shiik'uwaan Aa sabbite!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Israa'eeliyaa asatuu","poem":1},{"text":"barentta med'd'eeddawaan nashetino.","poem":2},{"text":"S'iyoone asatuu barenttu kaatiyaan loytsi nashetino.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Duriidde, karabuwaa bak'k'iiddenne,","poem":1},{"text":"diitsaa diis's'iidde, Aa suntsaa sabbino.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ayaw gooppe, S'oossay bare asan nashettee;","poem":1},{"text":"Naak'etteeddawanttoo s'oonuwaa immiide,","poem":2},{"text":"I unttuntta bonchchee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Asatuu barenttu s'oonuwaan nashetino;","poem":1},{"text":"k'amman ubbaan nashshechchaw yes's'ino.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Unttunttu doonaan S'oossaa galatay,","poem":1},{"text":"unttunttu kushiyankka laa\"u bagga kuussa mashshay de'o.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hewekka, unttunttu kawutetsatoo,","poem":1},{"text":"haluwaa kessanaassanne asatuwaa muranaassa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Unttunttu kaatetuwaa sanssalatan,","poem":1},{"text":"unttunttu olaa gadaawatuwaakka birataan k'achchanaassanne,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"unttunttu bolla s'aafetteedda pirddaa polanaassa.","poem":1},{"text":"Hewe S'oossaa asatuwaa ubbaw s'oonuwaa.","poem":2},{"lineBreak":true},{"text":"Med'inaa Godaa galatite!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}