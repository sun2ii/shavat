{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":16,"content":[{"type":"heading","content":["S'oossay Ta Laataa"]},{"type":"hebrew_subtitle","content":["Daawita woosaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet S'oossaw,","poem":1},{"text":"taani neekko bak'ateedda diraw, taana naaga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taani Med'inaa Godaw, «Neeni ta Godaa;","poem":1},{"text":"Neeppe attin, hara lo\"uu taw baawa» yaagay.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Sa'aan de'iyaa geeshshatuu","poem":1},{"text":"ay mala galatetteeddino!","poem":2},{"text":"Ta nashechchay ubbay unttunttunna ittippe gidiyaawaa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Worddo s'oossatuwaa kaalliyaawanttu","poem":1},{"text":"barenttu bolla metuwaa darissiino.","poem":2},{"text":"Shin taani unttunttu worddo s'oossatoo yarshshikke;","poem":1},{"text":"taani unttunttu suntsaa s'eesikke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ta Med'inaa Godaw, ta de'uwaa laataynne s'uu'ay neena;","poem":1},{"text":"taana koshshiyaa ubbaa neeni taw immaasa.","poem":2},{"text":"Ta de'uwaa saamay neena.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Neeni taw wad'd'eedda saamay ay keeshshaa lo\"ee!","poem":1},{"text":"Ee ta laatay tumuwaappe lo\"a!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Taana zoriyaa Med'inaa Godaa galatay;","poem":1},{"text":"bilahekka ta wozanay taana seeree.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Taani ubbaa gede Med'inaa Godaa taappe sintsayay","poem":1},{"text":"I taappe ushechcha baggana de'iyaa diraw,","poem":2},{"lineBreak":true},{"text":"taani hirggikke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Hewaa diraw, ta wozanay nashettee;","poem":1},{"text":"ta shemppuukka hashshu gee.","poem":2},{"text":"Ta bollaykka hirggi bayinnan de'ee.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Taana Si'ooliyaw aatsaade immakka;","poem":1},{"text":"neeni ne geeshsha musissakka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Neeni taana de'uwaa ogiyaa bessaasa.","poem":1},{"text":"Taani ne matan de'ina, ta nashechchay polettee;","poem":2},{"lineBreak":true},{"text":"ne ushechcha baggana injjii med'inaw de'ee.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}