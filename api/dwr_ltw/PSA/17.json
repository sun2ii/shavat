{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":17,"content":[{"type":"heading","content":["Geeshsha Asaa Woosaa"]},{"type":"hebrew_subtitle","content":["Daawita woosaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, ta s'illo oochchiyaawaa sisa;","poem":1},{"text":"ta waasuwaa hayzza.","poem":2},{"lineBreak":true},{"text":"Taani c'immenna ins's'arssaappe woossiyaa woosaakko,","poem":2},{"lineBreak":true},{"text":"ne haytsaa zaara.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta shatintsay ne sintsappe yo;","poem":1},{"text":"ne ayifii likke gidiyaawaa s'eello.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Neeni k'amman taana s'omoosaadda;","poem":1},{"text":"ta wozanaa paac'c'aadda.","poem":2},{"text":"Shin ta bollappe ayinekka demmakka.","poem":1},{"text":"Ta ins's'arssaykka balettibeena.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taani hara asatuwaadan iita k'aalaa haasayikke;","poem":1},{"text":"taani ne azazuwaa naagiyaa diraw, gene ogiyaa kaallabeykke.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ta gedii d'ubettenna mala,","poem":1},{"text":"ta tangguu ne ogiyaappe gas'aa kesibeenna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Abeet S'oossaw, neeni sisiyaa diraw,","poem":1},{"text":"taani neena woossay.","poem":2},{"text":"Ne haytsaa taakko zaaraadde,","poem":1},{"text":"taani new odiyaawaa hayzza.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Barenttu morkkatuwaappe bak'atiyaawantta","poem":1},{"text":"ne ushechcha kushiyan k'osaade ashshiyaawoo,","poem":2},{"lineBreak":true},{"text":"ne lo\"otetsaa maalalissiyaa ogiyaan bessa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ne ayifiyaa c'iruwaadan taana naaga;","poem":1},{"text":"ne k'efiyaa giddon taana k'osa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Taana un\"i wotseedda iitatuwaappenne","poem":1},{"text":"dooddi wotseedda s'ala morkkatuwaa kushiyaappe","poem":2},{"lineBreak":true},{"text":"taana k'osa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Unttunttoo k'areti baawa;","poem":1},{"text":"otoruwaan haasayiino.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Taani biyaasa'aa ubbaan unttunttu taana dooddiino.","poem":1},{"text":"Taana biittan aatsi yegganaw s'eelliino.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Unttunttu barenttoo miyaawaa koyiyaa gaammotuwaa mala;","poem":1},{"text":"geeman zuggi naagiyaa wodalla gaammotuwaa mala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Abeet Med'inaa Godaw, dendda.","poem":1},{"text":"Ta morkkatuwaanna ek'ettaade s'oona;","poem":2},{"lineBreak":true},{"text":"ne mashshaan iitatuwaappe taana ashsha akka.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Abeet Med'inaa Godaw, hawaa mala asaappe,","poem":1},{"text":"Unttunttu kaac'ay ha sa'aa de'uwaa s'alala gidiyaa asaappe","poem":2},{"lineBreak":true},{"text":"ne kushiyan taana ashsha.","poem":2},{"lineBreak":true},{"text":"Neeni unttunttoo minjjeedda boshaan unttuntta mura;","poem":2},{"lineBreak":true},{"text":"he boshaynne unttunttu naanaatoo gidiide,","poem":2},{"lineBreak":true},{"text":"unttunttu naanatuwaa naanatookka palaho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Shin taani s'illotetsan ne som\"iyaa be'ana.","poem":1},{"text":"Taani denddiyaa wode, ne mala be'aade nashettana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}