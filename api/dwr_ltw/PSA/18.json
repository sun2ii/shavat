{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":18,"content":[{"type":"heading","content":["S'oonuwaa Mazimuriyaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda Daawita Mazimuriyaa. Med'inaa Goday Aa Morkkiyaappenne Saa'oola Kushiyaappe Ashsheeda Wode Daawite Med'inaa Godaw Ha Yetsaa Yes's'eedda"]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw,","poem":1},{"text":"ta wolk'k'aw, taani neena siik'ay.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Med'inaa Goday taw wogga zaallaa;","poem":1},{"text":"Taani olaappe naagettiyaa miis'aa;","poem":2},{"text":"I taana ashshiyaawaa.","poem":1},{"text":"Ta S'oossay taani aakko bak'atiyaa ta wogga zaallaa.","poem":2},{"text":"I ta gonddalliyaa; I taana ashshiyaa wolk'k'aa;","poem":1},{"text":"I taani k'osetta attiyaa sa'aa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Galatay bessiyaa Med'inaa Godaa taani s'eesay;","poem":1},{"text":"I ta morkkatuwaappe taana ashshee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hayk'uwaa wodoruu taana k'achcheeda;","poem":1},{"text":"bashshay di'uwaadan taana dagantseedda.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Duufuwaa wodoruu taana k'achcheedda;","poem":1},{"text":"hayk'k'uu p'iriyaadan taana oyk'k'eedda.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taana metuu iissina, Med'inaa Godaa s'eesaad;","poem":1},{"text":"«Taana maadda» gaade ta S'oossaw waassaad.","poem":2},{"text":"I bare Geeshsha Sa'aan ta kooshshaa siseedda;","poem":1},{"text":"taani waasseedda waasuu Aa haytsaan wod'd'eedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wod'd'ina S'oossay hank'k'etteedda diraw,","poem":1},{"text":"Biittay yiik'k'iyiik'k'iide k'aas's'eedda;","poem":2},{"lineBreak":true},{"text":"deretuwaa s'ap'uu gaji gajiide kokkoreedda.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Aa siid'iyaappe hank'k'uwaa c'uway c'uwatteedda;","poem":1},{"text":"Aa doonaappe miyaa tamaa lac'uunne s'uuggiyaa bonk'k'uu keseedda.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Saluwaa I p'alk'k'iide, duge wod'd'eedda;","poem":1},{"text":"he wode Aa gediyaappe garssaana sik'imeteedda shaarii de'ee.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"K'efiyaana de'iyaa kiitanchchaa kiruubiyan uttiide paalleedda;","poem":1},{"text":"c'arkkuwaa k'efiyaa akkiide elleelleedda.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Barena d'uman kammeedda;","poem":1},{"text":"Aa dunkkaanii iraanna sik'imeteedda shaariyaa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Aa sintsan de'iyaa wolk'k'aama poo'uwaappe","poem":1},{"text":"shachchaynne tamaa lac'uu keseedda;","poem":2},{"text":"Kesiide sik'imeteedda shaariyaa aad'd'iidde beedda.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"K'ay Med'inaa Goday guuguntsaadan saluwaappe guummeedda;","poem":1},{"text":"Ubbaappe D'ok'k'iyaa S'oossay walk'k'antsaaninne tamaa lac'uwaan k'onc'c'eedda.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bare wonddaafiyaa c'ubiyaa yeddiide,","poem":1},{"text":"Bare morkkatuwaa laaleedda;","poem":2},{"lineBreak":true},{"text":"walk'k'antsaa poo'uwaa kiittiide, unttuntta yedersseedda.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Abeet Med'inaa Godaw, neeni seereedda wodenne,","poem":1},{"text":"Hank'k'ettaade peenuk'eedda wode,","poem":2},{"lineBreak":true},{"text":"abbaa haatsay giseedda biittay beetteedda.","poem":2},{"lineBreak":true},{"text":"K'ay sa'aa baasuukka k'onc'c'eedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"S'oossay bollappe kushiyaa duge yeddiide,","poem":1},{"text":"taana oyk'k'eedda;","poem":2},{"lineBreak":true},{"text":"c'iimmo haatsaappe taana kesseedda.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"I taana ta wolk'k'aama morkkiyaappenne,","poem":1},{"text":"taana is's'iyaawanttuppe ashsheeda.","poem":2},{"text":"Ayaw gooppe, unttunttu taw loytsi daro wolk'k'aama.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ta waayiyaa gallassi unttunttu ta bolla denddeeddino;","poem":1},{"text":"shin Med'inaa Goday taana zemppissiyaawaa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"I taana aakko sa'aa kesseedda;","poem":1},{"text":"taanan nashetteedda diraw, taana ashsheeda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ta s'illotetsaadan Med'inaa Goday taw c'iggeedda;","poem":1},{"text":"ta kushiyaa geeshshatetsaadan I taw zaareedda.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Taani Med'inaa Godaa ogiyaa kaalaad;","poem":1},{"text":"taani ta S'oossaa aggade wora babeykke.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Taani Aa higgiyaa ubbaa naagaad;","poem":1},{"text":"Aa wogaa poliyaawaa aggabeyikke.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Taani Aa sintsan suure de'aaddi;","poem":1},{"text":"taani taana nagaraappe naagaad.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hewaa diraw, Med'inaa Goday taw ta s'illotetsaadaaninne","poem":1},{"text":"ta kushii Aa sintsan geeshsha gidiyaawaadan zaareedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Abeet S'oossaw, ammanettiyaawanttoo neeni ammanettiyaawaa;","poem":1},{"text":"suuretoo neenikka suure.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Geeshshatoo neenikka geeshsha;","poem":1},{"text":"shin geellatoo neeni c'inc'c'a.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Barentta hokisiyaawantta ashshaasa;","poem":1},{"text":"shin barentta d'ok'k'issiyaawantta neeni zik'k'issaasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Abeet Med'inaa Godaw, neeni ta s'omppiyaa poo'issaasa;","poem":1},{"text":"ta S'oossay poo'issina, ta d'umay kichchee.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ne maaduwaan taani ta morkke wotaadaratuwaa olay;","poem":1},{"text":"ta S'oossan taani unttunttu miis'aa s'eeraana guppa aad'd'ay.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"S'oossaa ogii suure.","poem":1},{"text":"Med'inaa Godaa k'aalay geeshsha.","poem":2},{"text":"Aakko bak'atiyaa ubbatoo I gonddalle.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"S'oossaappe attina, hara Med'inaa Goday baawa;","poem":1},{"text":"nu S'oossaappe attina, hara wogga zaalli baawa.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Taw wolk'k'aa immiyaawenne","poem":1},{"text":"ta ogiyaa saro ootsiyaawe S'oossaattennee.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"I ta gediyaa gen\"iyaa gediyaadan minisee;","poem":1},{"text":"taana d'ok'k'a sa'atuwaan sarotetsaan wotsee.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"I ta kushiyaa olaa meezeyee;","poem":1},{"text":"Hewaa diraw, taani ta k'esiyaan","poem":2},{"lineBreak":true},{"text":"naasiyaa giyaa birataa wonddaafiyaa dafaade dukkay.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Taana ashshiyaa ne gonddalliyaa neeni taw immaadda.","poem":1},{"text":"Ne ushechcha kushii taana zemppissee;","poem":2},{"lineBreak":true},{"text":"ne lo\"o oytsay taana d'ok'k'isee.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ta hamettiyaasaa aassaasa;","poem":1},{"text":"hewaa diraw, ta gedii halis's'ibeena.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Ta morkkatuwaa taani yederssa oyk'k'aad;","poem":1},{"text":"taani unttuntta d'ayissennan de'aadde guyye simmabeykke.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Taani unttuntta laa\"entso denddennaadan shoc'aad;","poem":1},{"text":"unttunttu ta gediyaan kunddeeddino.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Olaw taana wolk'k'aa danc'c'isaadda;","poem":1},{"text":"taananna gaaddatiyaawantta taw gulbbatissaadda.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Ta morkkatuwaa ta sintsappe guyye bak'atissaada;","poem":1},{"text":"taana is's'iyaawantta taani d'ayissaad.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Barentta maaddana mala waasseeddino,","poem":1},{"text":"shin ooninne unttuntta ashshibeenna.","poem":2},{"text":"Med'inaa Godaakka unttunttu s'eeseeddino,","poem":1},{"text":"shin I unttunttoo koyibeenna.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"C'arkkuu pittiide afiyaa baanaadan taani unttuntta liik'issaad;","poem":1},{"text":"ogiyaan de'iyaa urk'k'aadankka unttuntta yed'd'aad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Makkala asaappe taana ashshaadda.","poem":1},{"text":"Taana kawutetsatuwaa bollan suntsaadda;","poem":2},{"lineBreak":true},{"text":"taani erenna Asay taw moodeteedda.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Unttunttu ta woriyaa sisiide, taw azazettiino;","poem":1},{"text":"allaga dere asaykka ta sintsan hokkiino.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Unttunttu wozanaa kahaa aggiino.","poem":1},{"text":"Barenttu naagettiyaa miis'aappe kokkoriidde yiino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"Med'inaa Goday de'ee!","poem":1},{"text":"S'oossay, ta wogga zaallay galatetto!","poem":2},{"text":"Taana ashshiyaa S'oossay d'ok'k'u d'ok'k'u go!","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"I ta haluwaa kessiyaa S'oossaa;","poem":1},{"text":"kawutetsatuwaa taappe garssaana moodissiyaawaa;","poem":2}]},{"type":"verse","number":48,"content":[{"text":"ta morkkatuwaappe taana ashshiyaawaa.","poem":1},{"text":"Abeet S'oossaw, neeni taananna gaaddatiyaawanttu bollan","poem":2},{"lineBreak":true},{"text":"taana d'ok'k'u d'ok'k'u ootsaasa;","poem":2},{"lineBreak":true},{"text":"Makkalanchcha asatuwaappe neeni taana ashshaasa.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Hewaa diraw, taani neena kawutetsatuwaa giddon galatana;","poem":1},{"text":"taani Med'inaa Godaa suntsaa sabbana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":50,"content":[{"text":"S'oossay bare kaatiyaw s'oonuwaa bollan s'oonuwaa immee.","poem":1},{"text":"Bare okkeedda, Daawitewunne Aa zeretsaw,","poem":2},{"lineBreak":true},{"text":"lo\"otetsaa med'inaw bessee.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/17.json","previousChapterAudioLinks":{},"numberOfVerses":50}