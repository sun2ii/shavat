{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":19,"content":[{"type":"heading","content":["S'oossay S'illotetsaa Awaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, Daawita Mazimuriyaa."]},{"type":"verse","number":1,"content":[{"text":"Salotuu S'oossaa bonchchuwaa haasayiinonne","poem":1},{"text":"salotuwaa gufantsuu I bare kushiyan ootseeddawaa awaayee.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Itti gallassay yenkko gallassaw hewaa odee;","poem":1},{"text":"itti k'ammaykka yenkko k'ammaw eratetsaa k'onc'c'issee.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Haasayi woy k'aalay baawa;","poem":1},{"text":"unttunttu kooshshaykka sisettenna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gidooppekka, unttunttu haasayaa kooshshay sa'aa ubbaan laaletteedda;","poem":1},{"text":"unttunttu k'aalaykka sa'aa gas'aa gakkeedda.","poem":2},{"lineBreak":true},{"text":"S'oossay away de'iyaa sa'aa saluwaan giigisseedda.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nashettiide kare sooppe kesiyaa mishiraadan,","poem":1},{"text":"Wotsaa naasiyaw giigeedda wotsanchchaadan,","poem":2},{"lineBreak":true},{"text":"away wontta wontta kesee.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Away itti bagga saluwaa gas'aappe mokkiide,","poem":1},{"text":"hara bagga saluwaa gas'aa gakkanaassi bee;","poem":2},{"text":"Aa ho\"uwaappe geemmiyaawe ayaynne baawa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Med'inaa Godaa higgii suure;","poem":1},{"text":"shemppuwaa zaaree.","poem":2},{"text":"Med'inaa Goday odiyaawe ammanettiyaawaa;","poem":1},{"text":"akeekay pac'c'eeddawanttoo eratetsaa immee.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Med'inaa Godaa wogay likke;","poem":1},{"text":"wozanaa nashechchee.","poem":2},{"text":"Med'inaa Godaa azazuu geeshsha;","poem":1},{"text":"wozanaa poo'issee.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Med'inaa Godaw yayyiyaawe geeshshatetsaa;","poem":1},{"text":"hewe med'inawukka ek'k'iid de'iyaawaa.","poem":2},{"text":"Med'inaa Godaa pirdday tumanne s'illuwaa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Work'k'aappenne walakki bayinna work'k'aappe aad'd'iide dosettee;","poem":1},{"text":"eessaappenne eessaa ililuwaappe aad'd'i mal\"ee.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"K'ay taana ne k'oomaa naagettanaadan zoree;","poem":1},{"text":"ne higgiyaa naaguu daro go\"ee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bare huup'iyaa balaa demmiyaawe oonee?","poem":1},{"text":"Abeet S'oossaw, geemmeedda nagaraappe taana geeshsha.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"K'ay taani, ne k'oomay,","poem":1},{"text":"S'alan nagaraa ootsennaadan,","poem":2},{"lineBreak":true},{"text":"neeni taana naaga.","poem":2},{"lineBreak":true},{"text":"Taana nagaraw moodisoppa;","poem":2},{"lineBreak":true},{"text":"he wode taani suure gidaade,","poem":2},{"lineBreak":true},{"text":"wolk'k'aama bayzzuwaappe geeyana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Abeet Med'inaa Godaw, ta wogga zaallaw,","poem":1},{"text":"taana wozeeddawoo,","poem":2},{"text":"Ta doonaappe kesiyaa k'aalaynne","poem":1},{"text":"ta wozanaa k'ofay neena nashechchiyaawaa gido.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}