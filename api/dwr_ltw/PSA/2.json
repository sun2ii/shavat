{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":2,"content":[{"type":"heading","content":["S'oossaan Dooreteedda Kaatiyaa"]},{"type":"verse","number":1,"content":[{"text":"Amanenawanttu ayaw denddiinoo?","poem":1},{"text":"K'ay kawutetsatuu ayaw patsennabaa mak'ettiinoo?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sa'aa kaatetuu denddeeddino;","poem":1},{"text":"asaa mooddiyaawanttu ittippe shiik'eeddino.","poem":2},{"lineBreak":true},{"text":"Unttunttu Med'inaa Godaa bollanne","poem":2},{"lineBreak":true},{"text":"I okkeeddawaa bolla ittippe shiik'eeddino.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Unttunttu, «Nuuni unttunttu sanssalataa duutsoytte;","poem":1},{"text":"unttunttu nuuna k'achchiyaawaakka wora oloytte» yaagiino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Saluwaan bare araatan utteeddawe","poem":1},{"text":"unttunttu bolla miic'c'ee;","poem":2},{"text":"Goday unttunttu bolla k'iliic'ee.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I bare hank'k'uwaan unttuntta seeree;","poem":1},{"text":"bare wolk'k'aama hank'k'uwaan unttuntta yashissee.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Goday, «Taan ta geeshsha deriyaa S'iyoone bolla","poem":1},{"text":"ta kaatiyaa kawutsaad» yaagee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"He kaatii, «Taan Med'inaa Godaa higgiyaa awaayana;","poem":1},{"text":"I taana, ‹Neeni ta na'aa;","poem":2},{"lineBreak":true},{"text":"taani hachchi new aawuwaa gidaaddi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Neeni taana oochcha;","poem":1},{"text":"Taani kawutetsaa ubbaa new immana;","poem":2},{"lineBreak":true},{"text":"sa'aa ubbay nebaa gidanawaa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neeni birataa s'am\"an unttuntta mentsereetsana;","poem":1},{"text":"Unttuntta neeni urk'k'aa miishshaa mentsiyaawaadan liik'issana› yaagee» yaageedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Hewaa diraw, hinttenoo kaatetoo, eeyattoppite;","poem":1},{"text":"ha sa'aa mooddiyaawanttoo, hinttena naagite!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Med'inaa Godaw yashshatetsan ootsite;","poem":1},{"text":"kokkorssaan azazettite.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"S'oossay hank'k'ettina, ogiyaan hintte d'ayennaadan suure wozanaan aw goynnite;","poem":1},{"text":"ayaw gooppe, Aa hank'k'uu ellekka ees's'i kesana.","poem":2},{"text":"Bak'ati an k'osetti attiyaa ubbatuu anjjetteedawantta.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}