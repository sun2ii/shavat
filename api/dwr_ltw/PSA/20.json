{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":20,"content":[{"type":"heading","content":["Kaatiyaw Woosaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, Daawita Mazimuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Neeni metooteedda wode Med'inaa Goday ne woosaa siso;","poem":1},{"text":"Yaak'ooba S'oossaa suntsay neena miniso.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bare Geeshsha Sa'aappe new maaduwaa kiitto;","poem":1},{"text":"S'iyooneppe neena zemppisso.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne yarshshuwaa ubbaa I new hassayo;","poem":1},{"text":"ne s'uuggiyaa yarshshuwaan nashetto.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne wozanaa amuwaa new immo;","poem":1},{"text":"ne halchchuwaa ubbaa polo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne s'oonuwaa diraw, nuuni nashshechchaw hombboc'ana;","poem":1},{"text":"nu S'oossaa suntsan nu banddiraa d'ok'k'u ootsana.","poem":2},{"text":"Neeni woosseeddawaa ubbaa Med'inaa Goday new immo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Med'inaa Goday bare dooreedda kaatiyaw","poem":1},{"text":"s'oonuwaa immiyaawaa taani biro eray.","poem":2},{"text":"I bare geeshsha saluwaan sisana;","poem":1},{"text":"bare ushechcha kushiyan wolk'k'aama s'oonuwaa aw immana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ittuu ittuu barenttu olaa paray goochchiyaa gaariyan,","poem":1},{"text":"Haratuu barenttu paran c'eek'ettiino;","poem":2},{"lineBreak":true},{"text":"shin nuuni Med'inaa Godaa nu S'oossaa wolk'k'an c'eek'etteetto.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Unttunttu d'ubettiide kunddana;","poem":1},{"text":"shin nuuni denddiide, min ek'k'ana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Abeet Med'inaa Godaw, kaatiyaw s'oonuwaa imma;","poem":1},{"text":"nuuni neena s'eesiyaa wode sisa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}