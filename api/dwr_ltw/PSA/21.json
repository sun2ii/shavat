{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":21,"content":[{"type":"heading","content":["S'oonuwaa Diraw Galataa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, Daawita Mazimuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, kaatii ne minotetsan hashshu gee;","poem":1},{"text":"neeni immeedda s'oonuwaan I ayaa nashettii!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neeni Aa wozanaa amuwaa aw immaadda;","poem":1},{"text":"k'ay I neena bare ins's'arssan oochcheeddawaa diggabaakka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Neeni lo\"o anjjuwaan Aa mokkaasa;","poem":1},{"text":"geeshsha work'k'aa kallachchaa Aa huup'iyaan wotsaasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Neeni de'uwaa aw immanaadan neena woosseedda;","poem":1},{"text":"Aw c'ora laytsaanne adussa de'uwaa immaadda.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neeni s'oonuwaa immeedda diraw,","poem":1},{"text":"Aa bonchchuu daree; gitatetsaanne anggaa aw immaadda.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Neeni aw med'inaa anjjuwaa immaasa;","poem":1},{"text":"neeni ittippe de'iyaawaan Aa nashechchaasa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kaatii Med'inaa Godaan ammanettee.","poem":1},{"text":"Ubbaappe D'ok'k'iyaa S'oossaa lo\"otetsaa diraw,","poem":2},{"text":"I k'aas'enna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ne kushii ne morkkatuwaa ubbaa kutuutana;","poem":1},{"text":"ne ushechchay neena is's'iyaawantta demmana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neeni k'onc'c'iyaa wode,","poem":1},{"text":"unttuntta c'ooc'iyaa tamaadan s'uuggana.","poem":2},{"text":"Med'inaa Goday bare hank'k'uwaa suuluwaan unttuntta mittana;","poem":1},{"text":"Aa tamaykka unttuntta mi d'ayissana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Neeni unttunttu naanatuwaa biittaappe,","poem":1},{"text":"unttunttu zeretsaakka asaa giddoppe d'ayissana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne morkketuu ne bolla shiik'inonne","poem":1},{"text":"iitabaa mak'ettiino; shin polikkino.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ayaw gooppe, neeni unttuntta ne wonddaafiyaa pootsan dukkanaw baabisana;","poem":1},{"text":"guyye zaaraadde bak'atissana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Abeet Med'inaa Godaw, ne minotetsan d'ok'k'u d'ok'k'u ga;","poem":1},{"text":"ne wolk'k'aa diraw new galataa mazimuriyaa yes's'eetto.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}