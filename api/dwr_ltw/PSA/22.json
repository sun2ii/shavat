{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":22,"content":[{"type":"heading","content":["S'illo Asaa Metuwaanne Hidootaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, Daawita Mazimuriyaa. Wontta Guuraa «Gen\"iyaa» Yetsaadaan Yes'etteedda Daawita Mazimuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Ta S'oossaw, ta S'oossaw, taana ayaw aggaadii?","poem":1},{"text":"Taana maadda gaade taani new watiwatiyaa wode,","poem":2},{"lineBreak":true},{"text":"ayaw taappe haakkay?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abeet ta S'oossaw, gallassan ubbaan taani new waassay;","poem":1},{"text":"shin neeni taw allakka.","poem":2},{"text":"K'amman ubbankka new waassay,","poem":1},{"text":"shin woppaa demmikke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gidooppenne, neeni geeshsha.","poem":1},{"text":"Israa'eeliyaa galatay ne araataa yuushshuwaan de'ee.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kase nu aawotuu neenan ammanetteedino;","poem":1},{"text":"neenan ammanettina, neeni unttuntta ashshaada.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"New waassiide atteeddino;","poem":1},{"text":"neenan ammanettiide yeellatibeykkino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Shin taani asaa gidikke; taani gus'uniyaa.","poem":1},{"text":"Taani asan kad'etteeddawaanne k'iliic'etteeddawaa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Taana be'iyaa ubbatuu k'id'iino;","poem":1},{"text":"unttunttu taana s'iti s'eelliinonne barenttu huup'iyaa k'aatsiino.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yaatooppe, «I Med'inaa Godaan ammanetteedda;","poem":1},{"text":"ayaw Aa ashshennee?","poem":2},{"text":"Med'inaa Goday Aa dosooppe,","poem":1},{"text":"ane Aa ashsho» yaagiino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Gidooppenne, taana ta aatti uluwaappe suure yeliseeddawe neena;","poem":1},{"text":"ta aatti d'antsaa d'ammiyaa wodekka taani ammanettanaadan ootsaadda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Taani yelettoodeppe doommaade neenan dic'c'aad;","poem":1},{"text":"ta aatti uluwaappe doommaadekka, neeni ta S'oossaa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Metuu taakko matiyaa dirawunne","poem":1},{"text":"taana maaddiyaawe bayinna diraw,","poem":2},{"text":"Ha\"i neeni taappe haakkoppa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Daro morkketuu koruma booratuwaadan taana dooddiino;","poem":1},{"text":"k'ayc'c'iyaa Baasaane biittaa booratuwaadan taana dooddiino.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mentsereetsiyaanne gudiyaa gaammuwaadan","poem":1},{"text":"barenttu doonaa ta bolla hanggiino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Taani haatsaadan goggaad;","poem":1},{"text":"ta mek'etsatuu barenttu kuushshaappe koletteeddino.","poem":2},{"text":"Ta wozanay eessaa muk'aaddaa mala,","poem":1},{"text":"ta giddon seeri wuree.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ta k'ood'ii kon\"aadan melee;","poem":1},{"text":"ta ins's'arssay kookkiyaana oyk'k'ettee.","poem":2},{"text":"Neeni taana hayk'k'eedda asaadan baanan yeggaadda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kanatuu taana te\"eeddino;","poem":1},{"text":"iita asatuu ta yuushshuwaan dooddeeddino.","poem":2},{"text":"Ta kushetuwaanne ta gedetuwaa c'addiino.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ta mek'etsatuwaa ubbaa taan payday.","poem":1},{"text":"Ta morkketuu taana s'eelliinonne derek'k'iino.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ta mayuwaa shaakki akkiino;","poem":1},{"text":"ta adussa mayuwaan saamaa yeggiino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Abeet Med'inaa Godaw, neeni taappe haakkoppa.","poem":1},{"text":"Abeet ta wolk'k'aw, taana maaddanaw ellekka haaya.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Taana mashshaappe ashsha;","poem":1},{"text":"ta uushshuwan de'iyaa kanatuwaa wolk'k'aappe ashsha.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Gaammotuwaa doonaappe taana ashsha;","poem":1},{"text":"k'ayc'c'iyaa bazzuwaa booratuwaa kac'iyaappe taana naaga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Taani ne suntsaa ta ishatoo odana;","poem":1},{"text":"maabaraa shiik'uwaankka neena galatana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hinttenoo, Med'inaa Godaw yayyiyaawanttoo, Aa galatite.","poem":1},{"text":"Hinttenoo, Yaak'ooba zeretsatoo,","poem":2},{"lineBreak":true},{"text":"ubbaykka Aa bonchchite.","poem":2},{"lineBreak":true},{"text":"Hinttenoo, Israa'eeliyaa zeretsatoo,","poem":2},{"lineBreak":true},{"text":"ubbatuukka bonchchuwaan aw yayyite.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"I naak'etteeddawantta kad'enna;","poem":1},{"text":"unttuntta gakkeedda k'ohuwaa taw ay metee geena.","poem":2},{"text":"Bare som\"uwaa unttunttuppe gentsenna;","poem":1},{"text":"shin unttunttu maadoo aakko waassiyaa wodiyaan,","poem":2},{"lineBreak":true},{"text":"unttunttu waasuwaa sisee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Taani neeni ootseedda lo\"o oosuwaa diraw,","poem":1},{"text":"kuntseedda shiik'uwaan galatana.","poem":2},{"text":"Taani shiik'etteeddawaa new yayyiyaa asaa sintsan gatsana.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Hiyyeesatuu miide kallana.","poem":1},{"text":"Med'inaa Godaa koyiyaawanttu Aa galatana.","poem":2},{"text":"Unttunttu med'inaw de'ana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Sa'aa gas'aa gakkanaw Asay ubbay","poem":1},{"text":"hassayiide, Med'inaa Godaakko simmana.","poem":2},{"text":"Asaa zare ubbay aw goyinnana.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ayaw gooppe, kaatetiyaa maatay Med'inaa Godaawaa;","poem":1},{"text":"kawutetsatuwaa I mooddee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Sa'aan de'iyaa dure asatuu ubbay","poem":1},{"text":"aw goyinnana.","poem":2},{"text":"Barentta hayk'k'uwaappe ashshanaw danddayennawanttunne","poem":1},{"text":"baanaw laamettiyaawanttu ubbatuu aw gulbbatana.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Yiyaa zeretsay aw kiitettana;","poem":1},{"text":"asay Godaa oosuwaa yiyaa yeletaw odana.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Biro yelettibeenna asaykka Aa s'illotetsaa odana.","poem":1},{"text":"«S'oossay bare asaa ashsheedda» yaagiyaawe odettana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}