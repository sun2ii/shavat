{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":23,"content":[{"type":"heading","content":["Lo\"o Hentsanchchaa"]},{"type":"hebrew_subtitle","content":["Daawita mazamuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Goday ta hentsanchchaa;","poem":1},{"text":"taw ayaynne pac'c'enna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taana aac'a k'ooruwaan shemppissee;","poem":1},{"text":"woppu geedda haatsaakko laaggee.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ta de'uwaa ooras's'isee.","poem":1},{"text":"Bare suntsaa diraw, taana s'illotetsaa ogiyaan kaaletsee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Neeni ta S'oossay taananna de'iyaa diraw,","poem":1},{"text":"Taani d'ip'p'i go d'umaa zanggaaraa gidduwaanna booppekka,","poem":2},{"lineBreak":true},{"text":"iitabaw yayyikke.","poem":2},{"lineBreak":true},{"text":"Ne gatimaynne ne guufii taana mintsetsiino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ta morkkatuwaa sintsan taw gibiraa makkaadda.","poem":1},{"text":"Taana mokkaad, ta huup'iyaa zayitiyaa okkaadda.","poem":2},{"text":"Ta wanc'c'ay palahiide goggana gakkanaw kuntsaadda.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ne keekkatetsaynne maarotetsay","poem":1},{"text":"ta de'uwaa laytsaa ubbaan tumuwaappe taana kaallana.","poem":2},{"text":"Taani Med'inaa Godaa golliyaan med'inaw de'ana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}