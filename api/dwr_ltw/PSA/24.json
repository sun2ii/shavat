{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":24,"content":[{"type":"heading","content":["Geeshsha Golliyaa Geluwaa Mazimuriyaa"]},{"type":"hebrew_subtitle","content":["Daawita mazamuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Sa'aynne sa'aan kumeeddawe ubbay Med'inaa Godaawaa;","poem":1},{"text":"biittaynne biittan de'iyaabay ubbay aawaa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ayaw gooppe, sa'aa wolk'k'aama abbaa bollan I hiis's'eedda;","poem":1},{"text":"c'iimmo haatsaa bollan minisiide essee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Med'inaa Godaa deriyaa gi\"anawe oonee?","poem":1},{"text":"Aa geeshsha sa'aan ek'k'anawe oonee?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Aa kushii nagaraappe geeyyeeddawaa,","poem":1},{"text":"Aa wozanay geeshsha gideeddawaa,","poem":2},{"lineBreak":true},{"text":"eek'aw goyinnennawaa,","poem":2},{"lineBreak":true},{"text":"wordduwaan c'aak'k'ennawaa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I Med'inaa Godaappe anjjuwaa akkana;","poem":1},{"text":"ashshiyaa S'oossaappe I s'illotetsaa pirdddaa akkana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"S'oossaakko s'eelliyaa asaynne","poem":1},{"text":"Yaak'ooba S'oossaa sintsa koyiyaa Asay hawanttu mala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Penggetuu dooyettite! Bonchcho kaatii gelana mala;","poem":1},{"text":"beni penggatuu Aa nashechchaan mokkite!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"He bonchcho kaatii oonee?","poem":1},{"text":"Minuunne wolk'k'aamay Med'inaa Godaatee!","poem":2},{"text":"Olawukka I wolk'k'aama Med'inaa Godaatee!","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Penggetuu dooyettite! Bonchcho kaatii gelana mala;","poem":1},{"text":"beni penggatuu Aa nashechchaan mokkite!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ha bonchcho kaatii oonee?","poem":1},{"text":"Ha bonchcho kaatii saluwaa med'etetsatuwaa Med'inaa Godaatee!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}