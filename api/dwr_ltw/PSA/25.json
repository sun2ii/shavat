{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":25,"content":[{"type":"hebrew_subtitle","content":["Daawite Mazimuriyaa",{"noteId":0}]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw,","poem":1},{"text":"ta shemppuwaappe neena woossay.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abeet ta S'oossaw, taani neenan ammanettay;","poem":1},{"text":"taana yeellayoppa; ta morkkatuwaa haytsaa kessoppa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Neenan hidootaa ootsiyaawanttu yeellatikkino;","poem":1},{"text":"shin gaasuu bayinnan geniyaawanttu yeellatana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Abeet Med'inaa Godaw, taana ne ogiyaa bessa;","poem":1},{"text":"ne ogiyaa taana tamaarissa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neeni taana ashshiyaa S'oossaa gidiyaa diraw,","poem":1},{"text":"ne tumatetsan taana kaaletsaanne tamaarissa.","poem":2},{"text":"Gallassaa kumentsan taani neenan hidootaa ootsay.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Abeet Med'inaa Godaw, beniideppe de'iyaa ne k'aretaanne","poem":1},{"text":"ne keekatetsaa hassaya.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta yalagatetsaa nagaraanne bayzzuwaa hassayoppa.","poem":1},{"text":"Abeet Med'inaa Godaw,","poem":2},{"lineBreak":true},{"text":"ne keekatetsaanne lo\"otetsaa hassaya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Med'inaa Goday keekkanne suure;","poem":1},{"text":"hewaa diraw, nagaranchchatuwaa bare ogiyaa tamaarissee.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ashkketuwaa suuretetsan kaaletsee;","poem":1},{"text":"ashkketuwaa bare ogiyaa tamaarissee.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Med'inaa Godaa c'aak'uwaanne Aa awaayuwaa naagiyaawanttoo","poem":1},{"text":"Aa ogii ubbay tumatetsaanne keekatetsaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Abeet Med'inaa Godaw, ta nagaray loytsi dara;","poem":1},{"text":"gidooppekka, ne suntsaa diraw, atto yaaga.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Med'inaa Godaw yayyiyaa Asay oonee?","poem":1},{"text":"I dooriide kaalana ogiyaa S'oossay Aa tamaarissana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"I ubbaa gedekka lo\"o de'ussaa de'ana;","poem":1},{"text":"Aa zeretsatuu biittaa laattana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Med'inaa Goday barew yayyiyaawanttoo,","poem":1},{"text":"bare s'uuraa shaakkiyaawaa;","poem":2},{"text":"I unttunttoo bare c'aak'uwaakka k'onc'c'issee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Med'inaa Goday ta gediyaa p'iriyaappe kessiyaa diraw,","poem":1},{"text":"ta ayifii maadoo ubbaa gede aakko s'eellee.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"S'oossaw, taani taarekka de'iyaa k'ohetteedda asaa gidiyaa diraw,","poem":1},{"text":"haa taakko simma; ne maarotetsaa taana bessa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Taw hirggay dareedda;","poem":1},{"text":"ta metuwaappe taana neeni woza.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ta metuwaanne ta tuggaa neeni be'a.","poem":1},{"text":"Ta nagaraa ubbaa atto ga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ta morkketuu ay keeshshaa dareeddenttonne be'a;","poem":1},{"text":"unttunttu taana wod'anaadan is's'iyaawaa s'eella.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Neeni taana naaga; neeni taana ashsha;","poem":1},{"text":"taani neekko bak'ateedda diraw, taana yeellayoppa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Taani neenan hidootaa ootseedda diraw,","poem":1},{"text":"suuretetsaynne tumatetsay taana naago.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Abeet S'oossaw, Israa'eeliyaa asaa","poem":1},{"text":"unttunttu metuwaa ubbaappe neeni ashsha.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"K'oppennabay Gakkiyaa Wode Shiik'iyaa Woosaa.","reference":{"chapter":25,"verse":0}}]},"thisChapterLink":"/api/dwr_ltw/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}