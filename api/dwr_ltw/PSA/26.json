{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":26,"content":[{"type":"heading","content":["Geeshsha Asaa Woosaa"]},{"type":"hebrew_subtitle","content":["Daawita mazamuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, taani suuretetsan hametteedda dirawunne,","poem":1},{"text":"sid'ii bayinnan Med'inaa Godaa ammanetteeda diraw,","poem":2},{"lineBreak":true},{"text":"taw pirddaa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abeet Med'inaa Godaw, taana paac'c'a, taana bidda;","poem":1},{"text":"ta wozanaa s'omoosa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ayaw gooppe, aggena ne siik'uu ta sintsan de'ee;","poem":1},{"text":"taani ne tumatetsaa ogiyaan hamettay.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Taani c'immiyaa asatuwaana ittippe uttikke;","poem":1},{"text":"lo\"a malatiyaa iitatuwaa maabaran gelikke.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iitaa ootsiyaa asatuwaa shiik'uwaa taani is's'ay;","poem":1},{"text":"makkalanchchatuwaanna ittippe uttikke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Abeet Med'inaa Godaw, taani k'ohabeennawaa bessanaw","poem":1},{"text":"ta kushiyaa meec'c'ay.","poem":2},{"text":"New yarshshiyaa sa'aa yuuyyay;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ne galataa yetsaa yes's'aynne","poem":1},{"text":"neeni ootseedda ooratsabaa ubbaa oday.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Abeet Med'inaa Godaw, neeni de'iyaa golliyaa,","poem":1},{"text":"ne bonchchuu ak'iyaa sa'aa taani dosay.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Taana nagaranchchatuwaanna ittippe pittoppa;","poem":1},{"text":"woy asaa wod'iyaawanttunna ittippe d'ayissoppa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Unttunttu kushiyan iita halchchuu de'ee;","poem":1},{"text":"k'ay unttunttu ushechcha kushiyan mattaayii kumi utteedda.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Shin taana gidooppe, taani suuretetsan hamettay.","poem":1},{"text":"Taana woza; taw k'aretta.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ta gedii dembba sa'aan ek'k'eedda;","poem":1},{"text":"taani wolk'k'aama shiik'uwaan Med'inaa Godaa galatana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}