{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":27,"content":[{"type":"heading","content":["S'oossaanna De'iyaa Asaa Ammanuwaa"]},{"type":"hebrew_subtitle","content":["Daawita mazamuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Goday taw poo'onne taana ashshiyaawaa;","poem":1},{"text":"yaatina, taani ow yayyanitaa?","poem":2},{"lineBreak":true},{"text":"Med'inaa Goday ta de'uu naagettiyaa miis'aa;","poem":2},{"lineBreak":true},{"text":"yaatina, taani ow dagammanitaa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Iita asatuu, ta is's'iyaawanttunne ta morkketuu","poem":1},{"text":"taana wod'anaw taakko wos's'iyaa wode,","poem":2},{"text":"Unttunttu barenttoo d'ubettiide kunddana.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Morkkiyaa tooray taana dooddinttokka","poem":1},{"text":"ta wozanay yayyena.","poem":2},{"text":"Olay ta bolla dooddinttokka,","poem":1},{"text":"taani Med'inaa Godan ammanettay.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Taani Med'inaa Godaa ittibaa oochchaad;","poem":1},{"text":"Taani hewaa koyaad;","poem":2},{"lineBreak":true},{"text":"hewenne, taani ta de'uwaa laytsaa ubbaan,","poem":2},{"lineBreak":true},{"text":"Med'inaa Godaa golliyaan de'anawaa;","poem":2},{"lineBreak":true},{"text":"k'aykka taani Med'inaa Godaa lo\"otetsaa be'anawaanne","poem":2},{"lineBreak":true},{"text":"Aa Golliyaan Aa koyanawaa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hewaa diraw, metuwaa gallassan","poem":1},{"text":"I taana bare de'iyaa saan gentsana;","poem":2},{"lineBreak":true},{"text":"bare dunkkaaniyaan I taana k'osi ashshana.","poem":2},{"lineBreak":true},{"text":"I taana d'ok'k'a shuchchaa bollan essana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"He wode taani taana dooddeedda ta morkkatuwaappe,","poem":1},{"text":"gitataade d'ok'k'u d'ok'k'u yaagana.","poem":2},{"text":"Taani Aa dunkkaaniyaan nashetaade yarshshuwaa yarshshana.","poem":1},{"text":"Taani Med'inaa Godaw diis's'ananne yes's'ana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Abeet Med'inaa Godaw, taani neena s'eesiyaa wode,","poem":1},{"text":"Neeni taw koya;","poem":2},{"lineBreak":true},{"text":"taw k'aretta; taana sisa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Neeni, «Ta sintsa koyite» geedda wode,","poem":1},{"text":"Ta wozanay, «Abeet Med'inaa Godaw, eeno;","poem":2},{"lineBreak":true},{"text":"taani ne sintsa koyana» yaageedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ne sintsa taappe gentsoppa.","poem":1},{"text":"Taana maaddeeddawoo, taana ne k'oomaa","poem":2},{"lineBreak":true},{"text":"hank'k'ettaade guyye zaaroppa.","poem":2},{"lineBreak":true},{"text":"Abeet taana ashshiyaa S'oossaw,","poem":2},{"lineBreak":true},{"text":"taana oloppanne aggoppa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta aawuunne ta aata taana agginttonne","poem":1},{"text":"Med'inaa Goday taana shiishshi akkana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Abeet Med'inaa Godaw, ne ogiyaa taana tamaarissa;","poem":1},{"text":"ta morkkatuwaa diraw, taana suure ogiyaa kaaletsa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Taana naassiyaa worddo markkatuu ta bolla iitatetsaan denddeedda diraw,","poem":1},{"text":"taana ta morkkatuwaa amoo aatsaade immoppa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Med'inaa Godaa keekkatetsaa taani pas'a de'aadde be'anawaa ammanay.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Med'inaa Godaan hidootaa wotsa;","poem":1},{"text":"minnaadenne wozanaamaade, Med'inaa Godaan hidootaa wotsa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}