{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":28,"content":[{"type":"heading","content":["Maaduwaa Demanaw Woosaanne Galataa"]},{"type":"hebrew_subtitle","content":["Daawita mazamuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, ta zaallaw, taani neena s'eesay;","poem":1},{"text":"taani neena s'eesina, taw sisa is's'oppa.","poem":2},{"lineBreak":true},{"text":"Ne c'o\"u gooppe,","poem":2},{"lineBreak":true},{"text":"taani duufuwaa beedda asatuwaa mala giday.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"«Maaddo» gaade taani neena s'eesiyaa wodenne","poem":1},{"text":"ne Ubbaappe Geeshsha Dunkkaaniyaakko zaaraadde,","poem":2},{"lineBreak":true},{"text":"ta kushiyaa mic'c'iyaa wode,","poem":2},{"lineBreak":true},{"text":"neeni ta watiwatuwaa sisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Iitaa ootsiyaa iita asatuwaana taana gatsaade oyk'k'oppa;","poem":1},{"text":"Hewanttu barenttu wozanaan kobabaa k'oppi uttiide,","poem":2},{"lineBreak":true},{"text":"barenttu doonaan barenttu shooruwaanna sarobaa haasayiyaawantta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Unttunttu oosuwaadaaninne unttunttu oosuwaa iitatetsaadan,","poem":1},{"text":"unttunttoo c'igga;","poem":2},{"lineBreak":true},{"text":"unttunttu kushii ootseeddabaw unttunttoo zaara.","poem":2},{"lineBreak":true},{"text":"Unttunttoo bessiyaa iitaa unttunttoo zaara.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Unttunttu S'oossaa oosuwaanne Aa kushii med'd'eeddawaa","poem":1},{"text":"dosennan is's'eedda diraw, S'oossay unttuntta kolana;","poem":2},{"lineBreak":true},{"text":"zaariide unttuntta ubbakka kees's'enna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ta watiwatuwaa siseedda diraw, Med'inaa Goday galatetto.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Med'inaa Goday taw wolk'k'anne gonddalle;","poem":1},{"text":"Ta wozanay an ammanettee;","poem":2},{"lineBreak":true},{"text":"hewan taani maadettaad.","poem":2},{"lineBreak":true},{"text":"Hewaa diraw, ta wozanay an nashettee;","poem":2},{"lineBreak":true},{"text":"taani yetsan Aa sabbana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Med'inaa Goday bare asaw wolk'k'aa;","poem":1},{"text":"I bare okkeedda kaatiyaa ashshiyaa miis'aa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"S'oossaw, ne asaa ashsha;","poem":1},{"text":"new gidiyaawantta anjja.","poem":2},{"text":"Unttuntta heemmiyaawe neena gida;","poem":1},{"text":"neeni unttuntta med'inawukka tookka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}