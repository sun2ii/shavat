{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["Bare na'aa Abeseloomappe bak'ateedda wode Daawita mazamuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, ta morkketuu ayaa c'oratteeddinoo!","poem":1},{"text":"Ta bolla aappunatuu denddiinoo!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Darotuu, «S'oossay Aa ashshenna» yaagiide","poem":1},{"text":"tawaa haasayiino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Shin abeet Med'inaa Godaw, Neeni ta yuushshuwaan gonddalle.","poem":1},{"text":"Taana bonchchissiyaawenne ta suntsaa d'ok'k'u ootsiyaawe neenattee.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taani ta k'aalaa d'ok'k'issaade Med'inaa Godaakko waassay.","poem":1},{"text":"Bare geeshsha deriyaappe taw I zaaree.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Med'inaa Goday taana naagiyaa diraw,","poem":1},{"text":"taani gisaade gem\"ishaynne beegottay.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani taana dooddiide denddeedda,","poem":1},{"text":"tammu sha\"aa asatookka yayyikke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Abeet Med'inaa Godaw, dendda!","poem":1},{"text":"Abeet ta S'oossaw, taana ashsha!","poem":2},{"text":"Ayaw gooppe, neeni ta morkkatuwaa ubbaa goggoc'c'uwaa shoc'aadda;","poem":1},{"text":"iitatuwaa achchaakka mentsaadda.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ashshuu S'oossaawaa;","poem":1},{"text":"S'oossaw, ne asaa neeni anjja.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}