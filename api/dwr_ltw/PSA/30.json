{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":30,"content":[{"type":"heading","content":["Galataa Woosaa"]},{"type":"hebrew_subtitle","content":["Daawita mazimuriyaa, Geeshsha Golliyaa anjjissiyaa gallassi yes's'eeddawaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw,","poem":1},{"text":"neeni taana c'iimmuwaappe kesseedda dirawunne","poem":2},{"lineBreak":true},{"text":"ta morkkatuwaan, «Hashshu aw» giissabeenna diraw,","poem":2},{"lineBreak":true},{"text":"Taani neena d'ok'k'u d'ok'k'u ootsana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abeet Med'inaa Godaw ta S'oossaw,","poem":1},{"text":"neeni taana maaddanaadan, taani neena s'eesaad;","poem":2},{"lineBreak":true},{"text":"neeni taana patsaadda.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abeet Med'inaa Godaw, taana duufuwaa beennaadan naagaadda;","poem":1},{"text":"Duge c'iimmo ollaan gelennaadan,","poem":2},{"lineBreak":true},{"text":"neeni taana pas'a ashshaada.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hinttenoo S'oossaa asatoo, Med'inaa Godaw yes's'ite;","poem":1},{"text":"Aa geeshsha suntsaakka galatite.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Aa hank'k'uu guutsa wodiyaassa,","poem":1},{"text":"shin Aa keekkatetsay de'uwaa laytsaa ubbaassa.","poem":2},{"text":"K'amma yeekiidde ak'ooppe,","poem":1},{"text":"wontta zaway baynna nashshechchaa gidee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Taani woppan de'iyaa wode,","poem":1},{"text":"«Simmi taani ubbakka k'aas's'ikke» yaagaad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abeet Med'inaa Godaw, neeni taw keekkeedda wode,","poem":1},{"text":"taana wolk'k'aama deriyaadan minisaade essaadda.","poem":2},{"text":"Shin neeni ne sintsa wora zaareedda wode,","poem":1},{"text":"taani dagamaad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Abeet Med'inaa Godaw, taani neena s'eesaaddi;","poem":1},{"text":"taani Med'inaa Godaakko maarotetsaw hawaadan yaagaade woossaaddi;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"«Taani hayk'k'iyaawaappe woy","poem":1},{"text":"duufuwaan geliyaawaappe ayaa demmanii?","poem":2},{"text":"Baanaw laametteedda Asay neena galatii?","poem":1},{"text":"Neeni ammanettiyaawaa odii?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abeet Med'inaa Godaw, taana neeni sisa;","poem":1},{"text":"taw k'aretta.","poem":2},{"text":"Abeet Med'inaa Godaw, neeni taw maaduwaa gida» yaagaad.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ta yeekuwaa yetsaw laammaadda.","poem":1},{"text":"Kayyuwaa mayuwaa taappe k'aaraade,","poem":2},{"lineBreak":true},{"text":"nashshechchaa taana mayzzaadda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hewaa diraw, taani neena","poem":1},{"text":"sabbanaappe attina, c'o\"u giikke.","poem":2},{"text":"Abeet Med'inaa Godaw ta S'oossaw,","poem":1},{"text":"taani neena med'inawukka galatana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}