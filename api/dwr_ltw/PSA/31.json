{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":31,"content":[{"type":"heading","content":["Metuwaa Wode Woosaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, Daawita Mazimuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, taani neekko bak'atay;","poem":1},{"text":"awudenne taana yeellayoppa.","poem":2},{"lineBreak":true},{"text":"Ne s'illotetsan taana ashsha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne haytsaa taakko yegga;","poem":1},{"text":"ellekka taana ashsha.","poem":2},{"text":"Neeni taani geemmiyaa zaallaanne","poem":1},{"text":"taana ashshiyaa mino geessuwaa taw gida.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ee, neeni taw zaallaanne geessuwaa;","poem":1},{"text":"ne suntsaa diraw, neeni taana kaaletsanne ne ogiyaa bessa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Neeni taw geemmiyaa sa'aa gidiyaa diraw,","poem":1},{"text":"unttunttu taw k'osi wotseedda p'iriyaappe taana neeni naaga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abeet Med'inaa Godaw, tumuwaa S'oossaw,","poem":1},{"text":"Taani ta shemppuwaa ne kushiyan wotsay;","poem":2},{"lineBreak":true},{"text":"neeni taana woza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Patsenna eek'atoo goyinniyaawantta taani is's'ay;","poem":1},{"text":"shin taani Med'inaa Godaan ammanettay.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta metuwaa neeni be'eedda dirawunne","poem":1},{"text":"ta tuggaa neeni ereedda diraw,","poem":2},{"text":"Taani aggena ne siik'uwaan nashettananne","poem":1},{"text":"nashshechchan nooc'u gaana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Neeni taana morkkiyaa kushiyan aatsaade immabaakka;","poem":1},{"text":"ta gedetookka la\"atetsaa immaadda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Abeet Med'inaa Godaw,","poem":1},{"text":"taani metuwaan geleedda diraw, taw k'aretta.","poem":2},{"text":"Taani daro mishetteedda diraw, taani metuwaan,","poem":1},{"text":"ta ashuukka, ta shemppuukka daabureedda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mishuwaa daruwaan ta de'uu c'ireedda;","poem":1},{"text":"ta laytsatuukka oolishin wureeddino.","poem":2},{"text":"Metuwaa daruwaan ta wolk'k'ay is's'ina;","poem":1},{"text":"ta mek'etsatuukka arggaac'eeddino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ta morkkatuwaa ubbaw k'id'd'iyaa gidaaddi","poem":1},{"text":"taani ta shoorotoo yeellaa,","poem":2},{"text":"Taana eriyaawanttookka yashissiyaawaa gidaaddi.","poem":1},{"text":"Ogiyaan taana be'eeddawanttukka taappe bak'atiino.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Taani hayk'k'eeddawaadan dogettaad;","poem":1},{"text":"me\"ina oleedda otuwaa mala gidaaddi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Taani darotuwaa saasuketsaa sisaad;","poem":1},{"text":"dagamay ubbaa saani de'ee.","poem":2},{"text":"Unttunttu ta bolla shiik'inonne taana wod'anaw mak'ettiino.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Shin Med'inaa Godaw, taani neenan ammanettay,","poem":1},{"text":"Neeni ta S'oossaa yaagay.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ta de'uwaa laytsay ne kushiyaanna.","poem":1},{"text":"Taana yederssiyaa ta morkkatuwaa kushiyaappe taana neeni ashsha.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ne k'oomaa bollan ne som\"uwaa poo'issa;","poem":1},{"text":"aggena ne siik'uwaan taana ashsha.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abeet Med'inaa Godaw, taani neena s'eesiyaa diraw","poem":1},{"text":"taana yeellayoppa.","poem":2},{"text":"Shin iitatuu yeellatino;","poem":1},{"text":"unttunttu duufuwaan geliide, sirp'p'i giino.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Otoruwaaninne kad'iyaan s'illotuwaa bolla","poem":1},{"text":"s'aliide haasayiyaa diraw,","poem":2},{"text":"Unttunttu worddotiyaa doonaa c'o\"u ootsa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"New yayyiyaawanttoo neeni minjjeeddanne","poem":1},{"text":"neekko bak'atiyaawanttoo asaa sintsan,","poem":2},{"lineBreak":true},{"text":"neeni ootseedda ne keekkatetsay ayaa daree!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Neeni unttuntta ne sintsan geema sa'aan gentsaade,","poem":1},{"text":"asaa mak'k'uwaappe ashshaasa.","poem":2},{"text":"Neeni unttuntta ne dunkkaaniyaan k'osaade,","poem":1},{"text":"iita ins's'arssaappe ashshaasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Taani morkkii dooddeedda katamaa giddon de'iyaa wode,","poem":1},{"text":"I taana malalissiyaa bare aggena siik'uwaa besseedda diraw,","poem":2},{"text":"Med'inaa Goday galatetto.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Taani dagamaade,","poem":1},{"text":"«Taani ne sintsaappe kichchaad» yaagaad.","poem":2},{"text":"Shin taana maaddana mala, neena s'eeseedda wode,","poem":1},{"text":"ta waasuwaa neeni sisaadda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Hinttenoo, S'oossaa asatoo, Med'inaa Godaa siik'ite.","poem":1},{"text":"Med'inaa Goday ammanettiyaawantta naagee;","poem":2},{"lineBreak":true},{"text":"shin otoranchchatoo unttunttu gatiyaa wurssi c'iggee.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hinttenoo, Med'inaa Godaan hidootaa ootsiyaawanttoo,","poem":1},{"text":"minnitenne wozanaamite.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}