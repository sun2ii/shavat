{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":32,"content":[{"type":"heading","content":["Nagaraa Paas'ussaanne Maarotaa Demussaa"]},{"type":"hebrew_subtitle","content":["Daawite Akeekaan S'aafeedda Timirttiyaa"]},{"type":"verse","number":1,"content":[{"text":"Aa bayzzuu atto geetetteeddanne","poem":1},{"text":"Aa nagaray kameteedda uray anjjetteedawaa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Med'inaa Goday Aa iitatetsaa paydenna asaynne","poem":1},{"text":"Aa k'ofaan baletsu bayinna Asay anjjetteeddawaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ta nagaraa paas'ennan de'aadde,","poem":1},{"text":"Taani gallassaa kumentsaa ooleeddawoo","poem":2},{"lineBreak":true},{"text":"ta asatetsay daabureedda.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gallassinne k'amma ne kushii ta bolla dees'eedda.","poem":1},{"text":"Haatsay boniyaa awaan meliide wuriyaawaadan,","poem":2},{"lineBreak":true},{"text":"ta wolk'k'ay wureedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Taani ta nagaraa new paas'aad;","poem":1},{"text":"Ta iitatetsaakka neeppe gentsabeykke;","poem":2},{"text":"«Ta bayzzuwaa Med'inaa Godaw paas'ana» gaad.","poem":1},{"text":"Yaatina, neeni taana dees'eedda nagaraa atto yaagaadda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hewaa diraw, S'oossaa asaa gidiyaa ooninne,","poem":1},{"text":"neeni beettiyaa wode, neena woosso.","poem":2},{"text":"Wolk'k'aama haatsay kuntsiyaa wode,","poem":1},{"text":"tumuwaappe he uraa gakkenna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Neeni taw k'osettiyaa sa'aa;","poem":1},{"text":"neeni taana metuwaappe naagaasa.","poem":2},{"text":"Atotetsaa yetsaa yes's'iyaawantta ta yuushshuwaan wotsaadda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"S'oossay, «Taani neena erissananne,","poem":1},{"text":"neeni baanaw bessiyaa ogiyaa neena tamaarissana;","poem":2},{"text":"Taani neena zorananne naagana.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bis'aalaaninne puuluwaan oyk'k'ettennan azazettena,","poem":1},{"text":"wozanay bayinna bak'uluwaadan","poem":2},{"lineBreak":true},{"text":"woy paraadan hintte hanoppite» yaagee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Iitatoo tuggay darana;","poem":1},{"text":"shin Med'inaa Godaan ammanettiyaawantta,","poem":2},{"lineBreak":true},{"text":"aggena siik'uu dooddana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hinttenoo, s'illotoo,","poem":1},{"text":"Med'inaa Godaan nashetitenne «Hashshu!» giite;","poem":2},{"lineBreak":true},{"text":"hinttenoo, wozanaa suuretoo, nashshechchaw yes's'ite.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}