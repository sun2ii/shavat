{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":33,"content":[{"type":"heading","content":["Maariyaa S'oossaa Sabussaa"]},{"type":"verse","number":1,"content":[{"text":"Hinttenoo, s'illotoo Med'inaa Godaw nashshechchan yes's'ite;","poem":1},{"text":"suure asatuu Aa galatanaw bessee.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Maasink'k'uwaa diis's'iidde,","poem":1},{"text":"Med'inaa Godaa galatite;","poem":2},{"lineBreak":true},{"text":"tammu bak'etsaan waas'etteedda diitsaakka aw diis's'ite.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ooratsa yetsaa yes's'ite;","poem":1},{"text":"loytsi diis's'iidde, k'aalaa d'ok'k'issiide yes's'ite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Med'inaa Godaa k'aalay suuriyaa;","poem":1},{"text":"I ootsiyaa oosuwaa ubbay ammanettiyaawaa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Med'inaa Goday s'illotetsaanne tumu pirddaa dosee;","poem":1},{"text":"aggena Aa siik'uu sa'aa kumeedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Med'inaa Godaa k'aalan salotuu med'etteeddino.","poem":1},{"text":"Aa doonaappe kesiyaa shemppuwaan","poem":2},{"lineBreak":true},{"text":"unttunttun de'iyaa med'etatuukka oosetteeddino.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wolk'k'aama abbaa haatsaa I ittisaan eelisseedda;","poem":1},{"text":"he c'iimmo haatsaa minjjaa sa'aan zeereedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Sa'aa ubbay Med'inaa Godaa yayyo;","poem":1},{"text":"sa'aan de'iyaa Asay ubbay Aa bonchcho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ayaw gooppe, I haasayina haneedda;","poem":1},{"text":"I azazina, minniide ek'k'eedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Med'inaa Godaa erenna kawutetsatuwaa zoretaa S'oossay laalee;","poem":1},{"text":"unttunttu halchchuwaakka mela kesee.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Med'inaa Godaa halchchuu med'inaw ek'k'iide de'ee;","poem":1},{"text":"Aa wozanaa k'ofaykka yeletaa ubbaa gakkanaw de'ee.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"S'oossay Med'inaa Godaa gideedda kawutetsay,","poem":1},{"text":"I baressa ootsiide dooreedda Asay anjjetteedawaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Med'inaa Goday saluwaana duge s'eelliide,","poem":1},{"text":"asaa ubbaa be'ee.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"S'oossay bare de'iyaasaappe sa'aan de'iyaa ubbaa s'eellee.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"I unttunttu ubbaa wozanaa med'd'eedda;","poem":1},{"text":"unttunttu ootsiyaawaa ubbaa eree.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kaatii bare wotaadaraa c'oratetsan attena;","poem":1},{"text":"olanchchay bare wolk'k'aa minotetsan kessi akkena.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Olaa paray s'oonissana giide naagiyaawe mela;","poem":1},{"text":"I bare wolk'k'aa minotetsan ashshanaw danddayenna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Med'inaa Godaa ayifetuu aw yayyiyaanne","poem":1},{"text":"aggena Aa siik'uwaan hidootaa ootsiyaa asatuwaa bollaanna.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hewenne, unttuntta hayk'k'uwaappe ashshanaassanne","poem":1},{"text":"koshaa wodiyaan pas'a wotsanaassa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Nuuni Med'inaa Godaan hidootaa ootseetto;","poem":1},{"text":"I nuuna maaddiyaawaanne nu gonddalliyaa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nuuni Aa geeshsha suntsan ammanettiyaa diraw,","poem":1},{"text":"nu wozanay an nashettee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Abeet Med'inaa Godaw,","poem":1},{"text":"nuuni neenan hidootaa ootsiyaawaadan,","poem":2},{"lineBreak":true},{"text":"aggena ne siik'uu nuunanna gido.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}