{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":34,"content":[{"type":"heading","content":["S'oossay Pirddiyaawaa Gidowoo Sabussaa"]},{"type":"hebrew_subtitle","content":["Barena yedersseedda Abimeleeka sintsappe gooyiyaawaa malatiide beedda wode, Daawita mazamuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Taani Med'inaa Godaa ubbaa wode galatana;","poem":1},{"text":"Aa galatay ay wodenne ta doonaappe pac'c'enna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taani Med'inaa Godaan c'eek'ettay;","poem":1},{"text":"naak'etteeddawanttu hewaa sisiide nashetino.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taananna gidiide, Med'inaa Godaa gitayite.","poem":1},{"text":"Ane ittippe Aa suntsaa d'ok'k'u d'ok'k'u ootsoytte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Taani Med'inaa Godaa koyaad;","poem":1},{"text":"I taw zaareedda;","poem":2},{"lineBreak":true},{"text":"taani yayyiyaawaa ubbaappe taana I ashsheedda.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neekko s'eelliyaawanttu nashettiino;","poem":1},{"text":"unttunttu som\"ii ubbakka yeellatenna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ha hiyyeesaa bitanii waasseedda;","poem":1},{"text":"Med'inaa Goday Aa waasuwaa siseedda;","poem":2},{"text":"Aa metuwaa ubbaappe Aa ashsheedda.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Med'inaa Godaa kiitanchchay Aa yayyiyaa asatuwaa naagee;","poem":1},{"text":"I unttunttu yuushshuwaan gidiide, unttuntta ashshee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Med'inaa Goday keeka gidiyaawaa s'eelli be'ite.","poem":1},{"text":"Aakko bak'atiyaa Asay anjjetteeddawaa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hinttenoo, Aa geeshsha asatoo, Med'inaa Godaw yayyite;","poem":1},{"text":"ayaw gooppe, aw yayyiyaa ubbatoo ayaynne pac'c'enna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gaammotuukka miyaawe d'ayina koshshatiino;","poem":1},{"text":"shin Med'inaa Godaa koyiyaawanttoo lo\"obay pac'c'enna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ta tamaaretoo, haa yiite; sisite;","poem":1},{"text":"Med'inaa Godaa yashshaa taani hinttena tamaarissana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lo\"o de'uwaa de'anawunne","poem":1},{"text":"keekkabaa be'ana mala,","poem":2},{"lineBreak":true},{"text":"bare laytsay aduk'k'anaw koyiyaa Asay oonee?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ne ins's'arssay iitabaa haasayennaadan,","poem":1},{"text":"ne doonaykka c'immeenaadan te\"a.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iitaappe shaaketta; lo\"obaa ootsa;","poem":1},{"text":"sarotetsaa loytsa koyaadde kaala.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Med'inaa Godaa ayifii s'illotuwaakko s'eellee;","poem":1},{"text":"k'ay Aa haytsaykka unttunttu waasuwaa hayzzee.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Unttuntta hassayissiyaawaa biittaappe d'ayissana mala,","poem":1},{"text":"Med'inaa Goday iitaa ootsiyaawantta,","poem":2},{"lineBreak":true},{"text":"bare hank'k'uwaa som\"uwaan s'eellee.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"S'illotuu waassiino;","poem":1},{"text":"Med'inaa Goday unttunttu waasuwaa sisee.","poem":2},{"text":"I unttunttu metuwaa ubbaappe ashshee.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Med'inaa Goday wozanay me\"eeddawanttoo mataana;","poem":1},{"text":"k'ay barenttu hidootaa k'ans's'eeddawantta ashshee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"S'illo asaa metuu dara;","poem":1},{"text":"shin Med'inaa Goday Aa he ubbaappe ashshee.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"S'oossay Aa mintsi naagiyaa diraw,","poem":1},{"text":"Aa mek'etsaappe ittuunne me\"enna.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Iitatuwaa iitatetsay wod'ana;","poem":1},{"text":"s'illotuwaa is's'iyaawanttu pirddettana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Med'inaa Goday bare k'oomatuwaa ashshee.","poem":1},{"text":"Aakko bak'atiide ooninne pirddettenna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}