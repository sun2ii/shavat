{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":35,"content":[{"type":"heading","content":["Naak'eteedda Asaa Woosaa"]},{"type":"hebrew_subtitle","content":["Daawita Mazimuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, taananna ek'ettiyaawanttuna neeni ek'etta;","poem":1},{"text":"taananna olettiyaawanttuna neeni oletta.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gonddalliyaanne hara olaa miishshaa oyk'k'aade,","poem":1},{"text":"taana maaddanaw dendda.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taana yederssiyaawanttu bollan","poem":1},{"text":"ne tooraanne mashshaa dentsa.","poem":2},{"text":"Taana, «Taani neena ashshiyaawaa» yaaga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ta shemppuwaa wod'anaw koyiyaawanttu,","poem":1},{"text":"yeellatinonne kawushino;","poem":2},{"lineBreak":true},{"text":"ta bolla iitabaa mak'ettiyaawanttu kawushiide guyye simmino.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Med'inaa Godaa kiitanchchay unttuntta yederssiyaa wode,","poem":1},{"text":"unttunttu c'arkkuwaa sintsan de'iyaa suullaadan hanino.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Med'inaa Goda kiitanchchay,","poem":1},{"text":"unttuntta dechchana haniyaa wode,","poem":2},{"lineBreak":true},{"text":"unttunttu ogii d'umaanne halitsaa gido.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"C'oo taana oyk'k'anaw barenttu p'iriyaa wotseeddino;","poem":1},{"text":"k'aykka c'oo taana kunddisanaw ollaa bookkeeddino.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Erennan de'ishiina, unttunttu bollan bashshay puttu go.","poem":1},{"text":"Unttunttu wotseedda p'irii unttuntta oyk'k'o;","poem":2},{"lineBreak":true},{"text":"unttunttu bashshaa ollaan kunddino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"He wode taani Med'inaa Godaan nashettana;","poem":1},{"text":"I ashsheeda diraw, taani nashshechchaa nooc'u gaana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta kumentsaa asatetsay neena,","poem":1},{"text":"«Abeet Med'inaa Godaw, ne mali oonee?","poem":2},{"text":"Hiyyeesaa wolk'k'aama kushiyaappe wotsa akkaasa.","poem":1},{"text":"Hiyyeesaanne metootanchchaa bonk'k'i miyaawanttu kushiyaappe ashshaasa» yaagana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wordduwaa markkattiyaawanttu ta bolla denddiino.","poem":1},{"text":"Taani erennaban taana mootiino.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Taani lo\"uwaa ootseeddawaa kushiyaa iitaa zaariino;","poem":1},{"text":"yaatina, taani taarekka ataad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Shin taani unttunttu harggeedda wode,","poem":1},{"text":"maak'aa mayyaad; ta asatetsaa s'oomaan daaburssaad.","poem":2},{"text":"Ta woossay zaaruwaa demenan atteedda.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ta huup'iyaa zik'k'i ootsaade, ta dabboo,","poem":1},{"text":"woy ta ishaw yeekkiyaawaadan yeekkaad.","poem":2},{"text":"Itti Asay bare aattiw kayyottiyaawaadan ta huup'iyaa oyk'k'aade,","poem":1},{"text":"yeekkaade hamettaad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Shin unttunttu taani d'ubetteeddawaan nashettiide,","poem":1},{"text":"ta bolla shiik'eeddino.","poem":2},{"text":"Taani erenna gaasuwaan taana wad'd'iide,","poem":1},{"text":"aguwaa is's'eeddino.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Iita Asay k'iliic'iyaawaadan unttunttu taana k'iliic'iino;","poem":1},{"text":"unttunttu yilotiide, barenttu achchaa garc'c'eeddino.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abeet S'oossaw, neeni awude gakkanaw","poem":1},{"text":"c'o\"u gaade s'eellay?","poem":2},{"text":"Unttunttu iita oosuwaappe taana ashsha;","poem":1},{"text":"ha gaammotuwaa mala asatuwaappe ta al\"o shemppuwaa ashshaa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"He wode gita shiik'uwaan taani new galataa immana;","poem":1},{"text":"c'ora asaa shiik'uwaan taani neena sabbana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Gaasuu baynnaan taana morkkiyaawanttu nashettoppino;","poem":1},{"text":"taana c'oo is's'iyaawanttu ta bolla sim\"etoppino.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Unttunttu sarobaa haasayiyaawaa aggiide,","poem":1},{"text":"Biittan c'o\"u giide de'iyaa asatuwaa bollan","poem":2},{"lineBreak":true},{"text":"wordduwaa med'd'iide haasayiino.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Unttunttu barenttu ins's'arssaa ta bolla k'arayiide,","poem":1},{"text":"«Ee, ee, neeni ootseeddawaa","poem":2},{"lineBreak":true},{"text":"nuuni nu ayifiyaan be'eeddo» yaagiino.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Abeet Med'inaa Godaw, neeni hawaa be'aade;","poem":1},{"text":"c'o\"u gooppa.","poem":2},{"text":"Abeet S'oossaw, neeni taappe haakkoppa.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Abeet ta Godaw, ta S'oossaw,","poem":1},{"text":"Ta diraw dendda; beegota","poem":2},{"lineBreak":true},{"text":"ta doonaa gidaade mootetta.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Abeet Med'inaa Godaw, ta S'oossaw,","poem":1},{"text":"ne s'illotetsan taana shatintsaa;","poem":2},{"lineBreak":true},{"text":"ta morkkatuwaa nashechchoppa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Unttunttu barenttoo, «Hashshu, hashshu,","poem":1},{"text":"nuuni nu wozanaan amotteeddawaa gatseeddo.","poem":2},{"text":"Nuuni Aa mitteeddo» gaanaadan ootsoppa.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ta waayiyaan nashettiyaawanttu ubbay","poem":1},{"text":"yeellatinonne kawushino.","poem":2},{"text":"Ta bollan otorettiyaawanttu","poem":1},{"text":"yeellaanne kawushshaa mayno.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Taani shatimmiyaawaa dosiyaawanttu","poem":1},{"text":"nashettiide, «Hashshu!» giino.","poem":2},{"text":"Unttunttu ubbaa gede, «Bare k'oomaa sarotetsaan","poem":1},{"text":"nashetiyaa Med'inaa Goday gitato» yaagino.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Gallassaa kumentsan ta ins's'arssay,","poem":1},{"text":"ne s'illotetsaabaanne ne galataabaa odana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}