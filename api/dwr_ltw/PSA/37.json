{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":37,"content":[{"type":"heading","content":["Iitatuwaanne Lo\"atuwaa Wurssetsaa"]},{"type":"hebrew_subtitle","content":["Daawita Mazimuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Iitaa ootsiyaawanttu diraw yilotoppa.","poem":1},{"text":"Nagaraa ootsiyaawantta k'anaattoppa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ayaw gooppe, unttunttu maataadan ellekka melana;","poem":1},{"text":"shulleedda bonc'c'iyaadan unttunttu k'ok'k'ofetana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Neeni Med'inaa Godaan ammanetta; lo\"obaa ootsa.","poem":1},{"text":"Yaataade biittan palahina de'a.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Med'inaa Godaan nashetta;","poem":1},{"text":"I new ne wozanaa amuwaa immana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ne ogiyaa hadaraa Med'inaa Godaw imma.","poem":1},{"text":"An ammanetta; I new ootsana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I ne s'illotetsaa wontta s'alk'k'iyaadan,","poem":1},{"text":"k'ay ne yewuwaa pirddaa gallassaa seeta awaadan poo'issana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Med'inaa Godaa sintsan c'o\"u gaade,","poem":1},{"text":"I ootsanaw, danddayan naaga.","poem":2},{"text":"Unttunttu iita halchchuu polettina,","poem":1},{"text":"duretteedda asatuwaa bolla yilotoppa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Hank'k'uwaa agga; yiluwaappe te'etta.","poem":1},{"text":"Yilotoppa; ayaw gooppe, hewe metuwaan yeggee.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iitaa ootsiyaawanttu d'ok'ollettiide d'ayana;","poem":1},{"text":"shin Med'inaa Godaan hidootaa ootsiyaawanttu biittaa laattana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iitaa ootsiyaawanttu guutsa wodiyaappe guyyiyaan de'ikkino;","poem":1},{"text":"neeni unttuntta koyinttokka unttunttu beettikkino.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Shin ashkketuu biittaa laattana;","poem":1},{"text":"unttunttu gitaa sarotetsaan nashettiide de'ana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iita Asay s'illo asaa bolla mak'etteenne","poem":1},{"text":"bare achchaa garc'c'ee.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Shin Goday iitatuwaa bollan miic'c'ee;","poem":1},{"text":"ayaw gooppe, unttunttu pirddaa gallassay yiyaawaa I eree.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iita asatuu hiyyeesatuwaanne metootanchchatuwaa ungganawunne","poem":1},{"text":"suuretetsan hamettiyaawantta wod'anaw,","poem":2},{"text":"Barenttu mashshaa shoddeeddinonne","poem":1},{"text":"barenttu wonddaafiyaa dafeeddino.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Shin unttunttu mashshay unttunttu wozana ayifiyaan gelana;","poem":1},{"text":"unttunttu wonddaafiikka me\"ana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"S'illoo de'iyaa guutsabay","poem":1},{"text":"c'ora iita asatoo de'iyaa darobaappe lo\"a.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ayaw gooppe, iitatuwaa wolk'k'ay me\"ana;","poem":1},{"text":"shin s'illotuwaa Med'inaa Goday zemppissee.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Suure asatuwaa ogiyaa Med'inaa Goday eree;","poem":1},{"text":"unttunttu laataykka med'inaw unttunttuwaa gidana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Iita wodiyaan suure asatuu yeellatikkino;","poem":1},{"text":"koshaa wodiyaan unttunttu kallana.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Shin iita asatuu hayk'k'ana.","poem":1},{"text":"Med'inaa Godaa morkketuu gam\"enna dembbaa c'iishshaa mala;","poem":2},{"lineBreak":true},{"text":"unttunttu c'uwaadan d'ayana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Iita Asay tal\"i akkiide c'iggena;","poem":1},{"text":"shin s'illo Asay k'arettiide immee.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Med'inaa Godaan anjjetteedawanttu biittaa laattana;","poem":1},{"text":"shin shek'k'etteeddawanttu d'ok'olletti d'ayana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Asaa ogii Med'inaa Godaa nashechchooppe,","poem":1},{"text":"Goday Aa tangguwaa kaaletseenne minisee.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"I d'ubettooppekka kunddenna;","poem":1},{"text":"ayaw gooppe, Med'inaa Goday Aa kushiyaa oyk'k'iide zemppisee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Taani kase yalaga; ha\"i simmi c'imaad;","poem":1},{"text":"shin s'illo Asay c'oo attina,","poem":2},{"lineBreak":true},{"text":"woy Aa naanatuu miyaawaa d'ayi woosishin,","poem":2},{"lineBreak":true},{"text":"taani ubbakka be'a erikke.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"I ubbaa wodekka keeka;","poem":1},{"text":"c'oo tal\"ee.","poem":2},{"text":"Aa naanatuukka haratoo anjjo gidanawantta.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Iitaappe haakka; lo\"obaa ootsa.","poem":1},{"text":"Yaatooppe, neeni adussa laytsaa de'ana.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ayaw gooppe, Med'inaa Goday s'illobaa dosee.","poem":1},{"text":"S'oossaa asatuwaa I aggena;","poem":2},{"lineBreak":true},{"text":"s'illotuu med'inaw naagettiino.","poem":2},{"lineBreak":true},{"text":"Shin iitatuwaa zeretsay d'ok'ollettana.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"S'illotuu biittaa laattananne","poem":1},{"text":"yaan med'inaw de'ana.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"S'illuwaa doonay aad'd'eeda eraa odee;","poem":1},{"text":"Aa ins's'arssaykka s'illobaa haasayee.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Aa S'oossaa higgii Aa wozanaan de'ee;","poem":1},{"text":"Aa gediikka aappe halis's'ena.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Iita Asay s'illo asaa wochcheenne","poem":1},{"text":"wod'anaw koyee.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Shin Med'inaa Goday s'illo asaa Aa kushiyan aggena;","poem":1},{"text":"pirddaw ek'k'iyaa wodekka Aa bolla pirddissenna.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Med'inaa Godaan hidootaa wotsaade, Aa ogiyaa naaga.","poem":1},{"text":"Neeni biittaa laattana mala,","poem":2},{"text":"I neena darssana.","poem":1},{"text":"Iita asatuu d'ok'ollettiide d'ayishina,","poem":2},{"lineBreak":true},{"text":"neeni be'ana.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Taani itti dagantsiyaa iita bitaniyaa,","poem":1},{"text":"wolaadan daasheeddawaa be'aad.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Shin taani he saanna","poem":1},{"text":"simmaade aad'd'iyaa wode I d'ayeedda;","poem":2},{"text":"Koyinakka I beettibeenna.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Ane lo\"o asaa akeeka; suure asaa be'a;","poem":1},{"text":"ayaw gooppe, saro asaw poluu lo\"ana.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Shin bayzzanchchatuu ubbaa d'ayana;","poem":1},{"text":"iitatuwaa poluukka d'ok'olletti d'ayana.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"S'illotuwaa atotetsay Med'inaa Godaappe yee;","poem":1},{"text":"metuwaa wode I unttunttoo naagetti attiyaa sa'aa.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Med'inaa Goday s'illotuwaa maaddeenne ashshee.","poem":1},{"text":"Unttunttu aakko bak'ateedda diraw,","poem":2},{"text":"I unttuntta iitatuwaappe wotsi akkeenne ashshee.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}