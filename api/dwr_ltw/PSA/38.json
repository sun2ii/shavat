{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":38,"content":[{"type":"heading","content":["Un\"eteedda Asaa Woosaa"]},{"type":"hebrew_subtitle","content":["Daawita hassayissiyaawaa mazamuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, ne hank'k'uwaan taana seeroppa;","poem":1},{"text":"ne yiluwaan taana muroppa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne wonddaafiyaa pootsay taana c'addi diggeeddino;","poem":1},{"text":"ne kushiikka taana naak'k'i oyk'k'eedda.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Neeni lanc'c'eedda diraw, ta bollay pas'a gidena;","poem":1},{"text":"ta nagaraa diraw, ta asatetsay sara gidenna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ta iitatetsay di'uwaadan taana muukkeedda;","poem":1},{"text":"denddenna wolk'k'aama tookuwaadan taw dees'eedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Taani nagaraa ootseedda eeyyatetsaa diraw,","poem":1},{"text":"ta madutsay giishshaa oyk'k'iide s'ink'k'eedda.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taan hokkaadinne k'uunnaad.","poem":1},{"text":"Gallassaa kumentsaa yeekkaade peeshaad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta ashuwaa mishuu s'uuggee;","poem":1},{"text":"ta bollay pas'a gidena.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Taani daaburaaddinne nippi gaad;","poem":1},{"text":"ta wozanay diddik'iyaa diraw oolay.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Abeet S'oossaw, ta amuu ubbay new erettee;","poem":1},{"text":"taani ooliyaawe neeppe geemmibeenna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta wozana ayifiyaan diddik'ee;","poem":1},{"text":"ta wolk'k'ay is's'ina;","poem":2},{"text":"Ta ayifiikka s'eelaa is's'eedda.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ta maytsaa diraw,","poem":1},{"text":"ta shoorotuukka ta laggetuukka haakuwaan ek'k'eeddino.","poem":2},{"text":"Ta dabbotuukka taappe haakkeeddino.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Taana wod'anaw koyiyaawanttu,","poem":1},{"text":"barenttu p'iriyaa taw yeggiino.","poem":2},{"text":"Taana k'ohanaw koyiyaawanttu,","poem":1},{"text":"«ek'k'ashsha; nuuni neena demmana» yaagiide,","poem":2},{"lineBreak":true},{"text":"manddiinonne gallassaa kumentsaa ta bolla yaa'iino.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"He wode taani tulle asaa mala, sisikke;","poem":1},{"text":"taani duude asaa mala, doonaanne pokikke.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ee, taani sisennanne","poem":1},{"text":"doonay zaarenna asaa mala.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Shin abeet Med'inaa Godaw, taani neenan hidootaa ootsay.","poem":1},{"text":"Abeet Med'inaa Godaw, ta S'oossaw, neeni taw zaaruwaa immana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Taani S'oossaa, «Ta gedii d'ubettina,","poem":1},{"text":"unttunttu, ‹Aw hashshu› gaanaadaaninne","poem":2},{"lineBreak":true},{"text":"ta bolla c'eek'ettanaadan ootsoppa» yaagay.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Taani kunddana hanay;","poem":1},{"text":"ta sakuukka taana yeddennan is's'eedda.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Taani ta iita oosuwaa paas'ay;","poem":1},{"text":"taani ta nagaraa gaasuwaan kayyotay.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ta morkketuu goobanne wolk'k'aama;","poem":1},{"text":"taana c'oo is's'iyaawanttu c'ora.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Taani lo\"obaa ootsina,","poem":1},{"text":"taw iitaa zaariyaa asatuu,","poem":2},{"text":"Taani lo\"obaa kaalliyaa diraw, taana ek'k'etiino.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Abeet Med'inaa Godaw, taana yeggoppa.","poem":1},{"text":"Abeet ta S'oossaw, taappe neeni haakkoppa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Abeet Med'inaa Godaw, taana ashshiyaawoo,","poem":1},{"text":"taana maaddanaw elleella.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}