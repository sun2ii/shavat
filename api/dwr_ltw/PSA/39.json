{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":39,"content":[{"type":"heading","content":["Metuu Gakka Asaa Paas'etsaa"]},{"type":"hebrew_subtitle","content":["Daawite Zammaaretuwaa Kaappuwaa Juddutoo Yes's'eedda Amanuwaa K'aalaa (1 Od. 25:3)"]},{"type":"verse","number":1,"content":[{"text":"Taani, «Ta ins's'arssan nagaraa ootsennaadan,","poem":1},{"text":"ta ogiyaa naagana.","poem":2},{"lineBreak":true},{"text":"Iita asatuu ta sintsan de'iyaa wode,","poem":2},{"lineBreak":true},{"text":"ta doonaa barana» yaagaad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Shin taani duudiyaadan c'o\"u gaad;","poem":1},{"text":"taani haray atto lo\"obaa haasayiyaawaakka aggina,","poem":2},{"text":"Ta waayii yaa dareedda.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ta wozanay ta garssan seeleedda;","poem":1},{"text":"ta k'ofay poddu giide, ees's'i keseedda.","poem":2},{"lineBreak":true},{"text":"Yaatina, ta ins's'arssan hawaadan yaagaad:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"«Abeet Med'inaa Godaw, ta de'uwaa wurssetsaanne","poem":1},{"text":"ta de'anaw atteedda gallassaa taana bessa.","poem":2},{"text":"K'ay ta de'uu wuranaw ay keeshshaa elleellintto, taana erissa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Neeni ta laytsaa s'ii takkaad'e keeshshaa kessaadda.","poem":1},{"text":"Ta laytsay ne sintsan bayinnawaa mala;","poem":2},{"lineBreak":true},{"text":"tumuwaappe Asay ubbay itti gede shemppiyaa c'arkkuwaa mala.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tumuwaappe Asay eeshuwaadan hamettee;","poem":1},{"text":"tumuwaappe c'oo mela simerettee.","poem":2},{"text":"I mas'uwaa shiishshee; shin akkana asaa erenna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Abeet Godaw, ha\"i simmi,","poem":1},{"text":"taani naagiyaawe ayee?","poem":2},{"text":"Taani hidootaa ootsiyaawe neenana.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ta bayzzuwaa ubbaappe taana ashsha;","poem":1},{"text":"eeyyatuwaan taana tooshissoppa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hawaa ubbaa ootseeddawe","poem":1},{"text":"neena gidiyaa diraw, taani duudaad;","poem":2},{"text":"Doonaanne pogabeykke.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ne boshaa ta bollaappe dentsa.","poem":1},{"text":"Ne kushiyaa minotetsaa gaasuwaan taani daaburaad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Neeni asaa Aa nagaraa diraw, seeraasanne muraasa;","poem":1},{"text":"Aa al\"o shemppuwaa bil\"aadan wurssaasa.","poem":2},{"text":"Tumuwaappe Asay ubbay itti gede c'arkkiyaa c'arkkuwaa mala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Abeet Med'inaa Godaw, ta woosaa sisa;","poem":1},{"text":"taana maaddanaw ta waasuwaa hayzza.","poem":2},{"text":"Ta afotsaa c'o\"u gooppa;","poem":1},{"text":"ayaw gooppe, taani ta aawotuwaa ubbaadan betenne imatsaa gidaade,","poem":2},{"lineBreak":true},{"text":"neenana de'ay.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Taani shaakkettanaappenne d'ayanaappe,","poem":1},{"text":"kasetaade nashettana mala,","poem":2},{"lineBreak":true},{"text":"ha\"i taana agga» yaagaad.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}