{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":4,"content":[{"type":"heading","content":["Maadoo Omarssi Shiik'iyaa Woosaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Diitsatuwaan Yes'etteedda, Daawita Mazimuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet taana s'illissiyaa S'oossaw,","poem":1},{"text":"taani neena s'eesiyaa wode, taw koya.","poem":2},{"lineBreak":true},{"text":"Taani un\"etteedda wode, taana shemppissaadda.","poem":2},{"lineBreak":true},{"text":"Taw neeni k'arettaade ta woosaa sisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hinttenoo asatoo, awude gakkanaw ta bonchchuwaa kawushshiitee?","poem":1},{"text":"Shori bayinnabaakka awude gakkanaw hintte siik'iitee?","poem":2},{"text":"Wordduwaa awude gakkanaw c'addi oyk'k'i kaalliitee?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Shin Med'inaa Goday S'oossaa asatuwaa","poem":1},{"text":"barew dummay wotseeddawaa hintte erite.","poem":2},{"text":"Taani Med'inaa Godaa s'eesiyaa wode,","poem":1},{"text":"I taw sisee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hank'k'ettite, shin hintte hank'k'uwaan nagaraa ootsoppite.","poem":1},{"text":"Hiis'an gisiyaa wode,","poem":2},{"lineBreak":true},{"text":"hintte wozanaa biditenne sirp'p'i giite.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Likke yarshshuwaa yarshshitenne","poem":1},{"text":"Med'inaa Godaan ammanettite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Darotuu, «Nuuna lo\"obaa bessanawe oonee?» yaagiino.","poem":1},{"text":"Abeet Med'inaa Godaw, neeni nuuna keeka ayifiyaan s'eella.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Neeni ta wozanaan wolk'k'aama nashshechchaa kuntsaadda.","poem":1},{"text":"Hewenne, katsaa ayifiinne ooratsa woyniyaa eessay,","poem":2},{"lineBreak":true},{"text":"barenttoo darina nashetiyaa nashechchaappekka dariyaawaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Abeet Med'inaa Godaw,","poem":1},{"text":"ne s'alalay taana saruwaan naaga wotsiyaa diraw,","poem":2},{"lineBreak":true},{"text":"taani gisaade sarotetsaan gem\"ishshay.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}