{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":40,"content":[{"type":"heading","content":["Galataa Mazimuriyaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, Daawita Mazimuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Taani Med'inaa Godaa danddayan naagaad;","poem":1},{"text":"I taakko simmiide, ta waasuwaa siseedda.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bashshaa ollaappe, halitsiyaa urk'k'aappe taana kesseedda.","poem":1},{"text":"Ta gediyaa zaallaa bollan esseedda;","poem":2},{"lineBreak":true},{"text":"k'ay ta hametsaakka saruwaa ootseedda.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"I ta doonaan ooratsa yetsaa wotseedda;","poem":1},{"text":"he yetsaynne, «Nu S'oossay galatetto» yaagiyaawaa.","poem":2},{"text":"Darotuu be'iide, yayananne Med'inaa Godan ammanettana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Med'inaa Godaa barew ammanettiyaawaa ootseedda asay,","poem":1},{"text":"otoranchchatuwaakko s'eelennawenne,","poem":2},{"lineBreak":true},{"text":"worddanchchatuwaakko simmenna Asay anjjetteeddawaa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abeet Med'inaa Godaw, ta S'oossaw,","poem":1},{"text":"neeni daro malalissiyaabaa ootsaadda;","poem":2},{"text":"Neenana likkettiyaawe ooninne baawa!","poem":1},{"text":"Neeni nuw k'oppeedda lo\"o k'ofaa","poem":2},{"lineBreak":true},{"text":"ooninne paydanaw danddayenna.","poem":2},{"lineBreak":true},{"text":"Hewe taani odina, wuriyaawaa gidenna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Neeni yarshshuwaanne imuwaa koyabaakka;","poem":1},{"text":"shin sisana mala, taw haytsaa dooyaadda.","poem":2},{"text":"S'uuggiyaa yarshshuwaanne nagaraa yarshshuwaa neeni koyabaakka.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hewaappe guyyiyaan taani, «S'aatsaa mas'aafan","poem":1},{"text":"tabay s'aafetteeddawaadan, taani yaad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abeet ta S'oossaw, taani neeni koyiyaawaa ootsanaw dosay;","poem":1},{"text":"ne higgii ta wozanaa giddon de'ee» yaagaad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wolk'k'aama shiik'uwaan taani, «Ne s'illotetsaa»","poem":1},{"text":"mishiraachchuwaa odana.","poem":2},{"text":"Abeet Med'inaa Godaw, neeni eriyaawaadankka,","poem":1},{"text":"taani ta doonaan odiyaawaa aggabeyikke.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Taani ne s'illotetsaa ta wozanaa giddon k'osabeykke;","poem":1},{"text":"neeni ammanettiyaawaanne ashshiyaawaa odaad.","poem":2},{"text":"K'ay aggena ne siik'uwaanne ne tumatetsaa,","poem":1},{"text":"ne wolk'k'aama shiik'uwaappe gentsabeykke.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abeet Med'inaa Godaw, ne maarotetsaa taappe haassoppa.","poem":1},{"text":"Aggena ne siik'uunne ne tumatetsay","poem":2},{"lineBreak":true},{"text":"taana ubbaa wode naago.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ayaw gooppe, paydu bayinna iitabay taana dooddeedda.","poem":1},{"text":"Ta iitatetsay taana gakkiide goozeedda;","poem":2},{"lineBreak":true},{"text":"taani s'eellanaw danddaykke.","poem":2},{"lineBreak":true},{"text":"Ta iita oosuu ta huup'iyaa binnaanaappe dareedda;","poem":2},{"lineBreak":true},{"text":"ta wozanay ta giddon seereedda.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Abeet Med'inaa Godaw, taana ashshanaw eeno ga;","poem":1},{"text":"abeet Med'inaa Godaw, taana maaddanaw elleella.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Taana wod'anaw koyiyaawanttu","poem":1},{"text":"ubbakka yeellatinonne kawushino.","poem":2},{"text":"Taani k'ohettannawaa amottiyaawanttu","poem":1},{"text":"kawushiide guyye simmino.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ta bolla, «Aw hashshu! Hashshu!»","poem":1},{"text":"geeddawanttu s'oonetteedda diraw, yeellatino.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Shin neena koyiyaa ubbatuu,","poem":1},{"text":"neenan nashetinonne hashshu giino.","poem":2},{"text":"K'ay ne atotetsaa dosiyaawanttu ubbatuu,","poem":1},{"text":"«Med'inaa Goday gitato!» yaagino.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Taani hiyyeessanne metootanchchaa;","poem":1},{"text":"tawaa Goday k'oppo.","poem":2},{"text":"Taana maaddiyaawenne ashshiyaawe neena;","poem":1},{"text":"abeet ta S'oossaw, gam\"oppa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}