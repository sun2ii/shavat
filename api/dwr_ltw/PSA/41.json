{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":41,"content":[{"type":"heading","content":["Hargganchcha Asaa Woosaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, Daawita Mazimuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Hiyyeesaw k'oppiyaa Asay anjjetteedawaa;","poem":1},{"text":"metuwaa gallassi Med'inaa Goday Aa ashshee.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Med'inaa Goday Aa naagiide, pas'a wotsee.","poem":1},{"text":"Inne biittaa bollan anjjetteedawaa gidee;","poem":2},{"text":"S'oossay Aa Aa morkkatuwaa amoo aatsiide immenna.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Med'inaa Goday Aa harggiyaa hiitsan de'ishiinakka maaddee;","poem":1},{"text":"I sakkettinakka, Aa patsee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Taana gidooppe, taani, «Abeet Med'inaa Godaw,","poem":1},{"text":"taani neena naak'k'eedda diraw, taana maara;","poem":2},{"text":"Harggiyaappekka taana patsa» yaagaad.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ta morkketuu iitaban taana haasayiidde,","poem":1},{"text":"«I awude hayk'k'anddeeshsha?","poem":2},{"text":"K'ay Aa suntsaykka awude d'ayanddeeshsha?» yaagiino.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Taana be'anaw yiyaa ooninne taw worddobaa odee;","poem":1},{"text":"bare wozanaan taana zigiriyaawaa biddee.","poem":2},{"text":"Hewaappe guyyiyaan, kare kesiide,","poem":1},{"text":"yaanne haanne oduwaa laalee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Taana is's'iyaa ubbatuu","poem":1},{"text":"ittippe ta bollan saasukkiino;","poem":2},{"text":"«Iitabay Aa bolla gakkee» giide k'oppiino.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Unttunttu «Aa iita harggii oyk'k'eedda;","poem":1},{"text":"I he giseeddasaappe ubbakka denddenna» yaagiino.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Haray attina, taani ammanettiyaa ta siik'o laggii,","poem":1},{"text":"taani barsseeddawe ta kushiyaa sa\"eedda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Shin abeet Med'inaa Godaw, neeni taana maara;","poem":1},{"text":"taani unttunttu kushiyaa kesanaadan,","poem":2},{"lineBreak":true},{"text":"taana harggiyaa hiitsaappe dentsa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Neeni taanan nashettanawaa taani eray;","poem":1},{"text":"Ayaw gooppe, ta morkkii taana,","poem":2},{"lineBreak":true},{"text":"s'ooniide gayrena.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Neeni taana ta suuretetsaa diraw zemppisaadda;","poem":1},{"text":"ne sintsan taana med'inaw wotsaadda.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Med'inaa Goday, Israa'eeliyaa S'oossay,","poem":1},{"text":"med'inaappe med'inaa gakkanaw galatetto.","poem":2},{"lineBreak":true},{"text":"Amen\"i. Amen\"i.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}