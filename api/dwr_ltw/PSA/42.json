{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":42,"content":[{"type":"heading","content":["Yedesaa Wode Woosaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, K'oore Naanatuwaa Akeekaa Timirttiyaa"]},{"type":"verse","number":1,"content":[{"text":"Gaaray goggiyaa haatsaa laamotiyaawaadan,","poem":1},{"text":"Abeet S'oossaw, hewaadan taanikka neena laamotay.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"«Taani baade, S'oossaa sintsa","poem":1},{"text":"be'anawe awudeeshsha?» gaade,","poem":2},{"text":"S'oossaa, de'uwaa S'oossaa be\"anaw saamettay.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Asatuu ubbaa gede, «Ne S'oossay hak'an de'ii?»","poem":1},{"text":"yaagiyaa wode, taw gallassinne k'amma ta afotsay k'uma gideedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Taani unttunttu baalaa bonchchanaw,","poem":1},{"text":"shiik'eedda daro asaa gidduwaana","poem":2},{"lineBreak":true},{"text":"salppiyaan hombboc'ishiinanne","poem":2},{"lineBreak":true},{"text":"galataa yetsaa yes's'ishin,","poem":2},{"text":"S'oossaa golle kaaletseeddawaa k'oppiyaa wode,","poem":1},{"text":"ta wozanay kayyottiidde, giddon seereedda.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ta shemppattee, taani ayaw kayyottaytaa?","poem":1},{"text":"K'ay ayaw jabbakattayttaa?","poem":2},{"text":"Taani S'oossan hidootaa wotsana.","poem":1},{"text":"Ayaw gooppe, taani biro","poem":2},{"lineBreak":true},{"text":"taana ashshiyaawaanne ta S'oossaa galatana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ta wozanay kayyotteedda; hewaa diraw,","poem":1},{"text":"taani Yorddaanoosa biittan, Hermmoone d'ok'k'an,","poem":2},{"text":"Miizaare Deriyan ek'k'aade neena hassayay.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ne soossuwaa guntsan c'iimmuu c'iimmaw s'eesee;","poem":1},{"text":"K'ay ne beetaynne ne hobbii ubbay","poem":2},{"lineBreak":true},{"text":"ta bollaanna goggeedda.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gallassi Med'inaa Goday aggena bare siik'uwaa taw kiittee.","poem":1},{"text":"K'ammakka Aa yetsay taananna de'ee;","poem":2},{"lineBreak":true},{"text":"he yetsaykka taani ta de'uwaa S'oossaa woossiyaa woosaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"S'oossaa, ta wogga zaallaa taani,","poem":1},{"text":"«Ayaw taana dogaadii?","poem":2},{"text":"Taani ayaw ta morkkiyaan naak'ettaade kayyotaade hamettoo?» yaagay.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ta morkketuu taana,","poem":1},{"text":"«Ne S'oossay hak'an de'ii?» yaagiide,","poem":2},{"lineBreak":true},{"text":"ta mek'etsaa mentsiide boriino.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta shemppattee, taani ayaw kayyottaytaa?","poem":1},{"text":"K'ay ayaw jabbakattayttaa?","poem":2},{"text":"S'oossan hidootaa wotsana.","poem":1},{"text":"Ayaw gooppe, taani ha\"ikka","poem":2},{"lineBreak":true},{"text":"taana ashshiyaawaanne ta S'oossaa galatana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}