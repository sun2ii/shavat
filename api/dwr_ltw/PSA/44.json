{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":44,"content":[{"type":"heading","content":["S'oossay Naaganaadan Woosaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, K'oore Naanatuwaa Akeeka Timirttiyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet S'oossaw, aad'd'eeda wodiyaan,","poem":1},{"text":"neeni ootseeddawaa nuuni nu haytsaan siseeddo,","poem":2},{"lineBreak":true},{"text":"nu aawotuwaa wodiyaankka ne ootseeddawaa nuw odeeddino.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kawutetsatuwaa neeni ne kushiyan laaggaade kessaadda;","poem":1},{"text":"nu aawotuwaa unttunttu biittan tokkanaw;","poem":2},{"lineBreak":true},{"text":"hara kawutetsatuwaa muraadda;","poem":2},{"lineBreak":true},{"text":"shin ne asatuwaa aasaadda.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Unttunttu barenttu mashshaan oliide,","poem":1},{"text":"he biittaa kessibeykkino;","poem":2},{"text":"Unttunttu barenttu kushiyaa minotetsan s'oonibeykkino.","poem":1},{"text":"Shin neeni unttuntta siik'eedda diraw,","poem":2},{"lineBreak":true},{"text":"unttunttu ne ushechcha kushiyaa,","poem":2},{"lineBreak":true},{"text":"ne k'esiyaanne ne sintsa poo'uwaa wolk'k'an s'ooneeddino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yaak'ooba asaw s'oonuwaa azaziyaa,","poem":1},{"text":"ta kaatiinne ta S'oossay neena.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neenan gidiide, nu morkkatuwaa nuuni sugi olana;","poem":1},{"text":"ne suntsan nu ek'etiyaawantta nuuni yed'd'ana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani ta tooraan ammanettikke;","poem":1},{"text":"ta mashshaykka taana ashshenna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Shin neeni nuuna nu morkkatuwaappe ashshaada;","poem":1},{"text":"k'ay nuuna is's'iyaawantta neeni kawushshaadda.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nuuni ubbaa wode S'oossan c'eek'etteetto;","poem":1},{"text":"ne suntsaw med'inaw galataa immana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Shin ha\"i neeni nuuna aggaada; kawushshaadda;","poem":1},{"text":"nu tooraa asaana ittippe olaa baakka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nu morkkatuwaa sintsaappe nuuna bak'k'atissaadda;","poem":1},{"text":"nu ek'k'etiyaawanttu nubaa bonk'k'eeddino.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Neeni nuuna dorssatuwaadan shukaw aatsaade immaadda;","poem":1},{"text":"k'ay kawutetsatuwaa giddon nuuna laalaadda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Neeni ne asaa hirayisuwaan zal\"aadda;","poem":1},{"text":"ayaa wod'iyaanne demmabeykka.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Neeni nuuna nu shoorotuu boriyaawaa,","poem":1},{"text":"k'ay nu heeraan de'iyaawanttu k'iliic'iyaawaanne miic'c'iyaawaa ootsaadda.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Neeni nuuna kawutetsatuwaa giddon tossaa kessaadda;","poem":1},{"text":"nuuna unttunttu barenttu huup'iyaa k'aatsi k'aatsi k'id'iyaawaa ootsaadda.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Taani gallassaa kumentsan tooshettaad.","poem":1},{"text":"Ta som\"iyaa yeellay kammeedda.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Taana shek'k'iyaawanttunne boriyaawanttu gaasuwaan,","poem":1},{"text":"Taanna morkkiyaawanttunne manddiyaawanttu gaasuwaana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nuuni neena dogibeennawaa gidooppekka,","poem":1},{"text":"woy ne c'aak'uwaa mentsibeenawaa gidooppekka,","poem":2},{"text":"Hawe ubbay nu bolla haneedda.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nu wozanay neeppe guyye simmibeenna;","poem":1},{"text":"nu gedii ne ogiyaappe gas'aa kesibeenna.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Shin neeni nuuna mentsereetsaade do'aa giddon yeggaadda;","poem":1},{"text":"d'ip'p'i go d'uman kammaadda.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nu S'oossaa suntsaa nuuni dogeeddentto,","poem":1},{"text":"hara s'oossaa woossanaw nuuni nu kushiyaa mic'c'eeddentto,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Wozanaan geemmeedda s'uuraa S'oossay eriyaa diraw,","poem":1},{"text":"I hawaa biddiide demmennee?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Shin ne diraw, gallassaa ubbaan nuuna wod'iino;","poem":1},{"text":"shukkanaw afiyaa dorssaadan paydeteeddo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Abeet Med'inaa Godaw, dendda! Ayaw gem\"ishay?","poem":1},{"text":"Beegotta! Med'inaw nuuna aggoppa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ne som\"uwaa nuuppe ayaw gentsay?","poem":1},{"text":"Nu k'ohuwaanne nu un\"aa ayaw dogay?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nuuni baanan duge oletteeddo;","poem":1},{"text":"nu asatetsaykka biittaana oyk'k'etteedda.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Abeet S'oossaw, dendda! Nuuna maadda!","poem":1},{"text":"Aggena ne siik'uwaa diraw, nuuna woza.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}