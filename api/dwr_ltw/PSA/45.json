{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":45,"content":[{"type":"heading","content":["Siik'uwaa Timirttiyaa"]},{"type":"hebrew_subtitle","content":["K'oore Naanatuu Zammaaretuwaa Kaappoo C'iishshaa Waatsa Giyaa Waatsan Yes's'eedda Yetsaa. Akeekan S'aafetteedda Siik'uwaa Yetsaa."]},{"type":"verse","number":1,"content":[{"text":"Taani ta yetsaa kaatiyaa sisana,","poem":1},{"text":"ta wozanay lo\"o k'ofaa pulttee;","poem":2},{"lineBreak":true},{"text":"ta ins's'arssay lo\"o s'aafiyaa asaa bi'iriyaa mala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Asaa ubbaappe neeni malanchchanne;","poem":1},{"text":"ne haasayay nashetsiyaawaa gidana mala,","poem":2},{"text":"S'oossay neena med'inaw anjjeedda.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wolk'k'aama kaatiyaw,","poem":1},{"text":"ne mashshaa ne s'eessan danc'c'a;","poem":2},{"lineBreak":true},{"text":"bonchchuunne gitatetsay newaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ne tumatetsaa, ashkketetsaanne s'illotetsaa diraw,","poem":1},{"text":"ne anggaa mayyaade, s'oonanaw piriis'a.","poem":2},{"text":"Ne ushechcha kushii malalissiyaabaa besso.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ne pootsay k'ara;","poem":1},{"text":"unttunttu kaatiyaa morkkatuwaa wozana ayifiyaa c'addino.","poem":2},{"text":"Kawutetsatuu ne gediyaan kunddino.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Abeet S'oossaw,","poem":1},{"text":"ne kawutetsaa araatay med'i med'inaw de'ee;","poem":2},{"lineBreak":true},{"text":"ne kawutetsaa s'am\"aykka suuretetsaa s'am\"aa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Neeni s'illotetsaa siik'aasa;","poem":1},{"text":"geelatetsaa is's'aa.","poem":2},{"text":"S'oossay, ne S'oossay, neena","poem":1},{"text":"ne laggetuwaappe aatsiide,","poem":2},{"lineBreak":true},{"text":"nashshechchaa zayitiyaa okkeeddawe hewaassa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kawaraan, godare uutsaaninne birggudiyaan,","poem":1},{"text":"ne mayuu ubbay pushakketteedda.","poem":2},{"text":"Danggarssaa zaaliyaan alleek'k'etteedda,","poem":1},{"text":"ne kawutetsaa golliyaan diis's'iyaawanttu neena nashechchiino.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kaatiyaa golliyaan de'iyaa mac'c'a asatuwaa giddon,","poem":1},{"text":"kaatetuwaa mac'c'a naanatuu de'iino;","poem":2},{"lineBreak":true},{"text":"kaatata geeshsha work'k'aan alleek'k'ettaade,","poem":2},{"lineBreak":true},{"text":"neeppe ushechcha baggan ek'k'aaddu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta naattee, sisa; hayzza;","poem":1},{"text":"ne haytsaa haa yegga.","poem":2},{"text":"Ne zariyaanne ne aawuwaa golliyaa doga.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ne pulaa kaatii amottee;","poem":1},{"text":"I new goda gidiyaa diraw, aw azazetta.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"S'iroosa Asay iziw imotaa akkiide yaana;","poem":1},{"text":"duretuu neena awuddashana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kaatiyaa naatta kaatiyaa golliyaa giddon waata lo\"ay!","poem":1},{"text":"Izi bullachchaa mayuukka work'k'aa k'ac'inan dadetteedda.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bare alleek'k'o mayuwaa mayyaade, kaatiyaakko moyzzetaw;","poem":1},{"text":"Izi lagge naanatuu wodorotuu,","poem":2},{"lineBreak":true},{"text":"izo kaalliide, Aa sintsa aheeddino.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Unttunttu nashettiiddenne hombboc'iidde yiide,","poem":1},{"text":"kaatiyaa golliyaa geliino.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kaatiyaw, ne aawotuwaa kotaa ne naanatuu akkana.","poem":1},{"text":"Neeni unttuntta biittaa ubbaa bollan suntsana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Taani ne suntsay yeletaa ubbaan hassayettanaadan ootsana.","poem":1},{"text":"Hewaa diraw, Asay med'i med'inaw neena galatana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":17}