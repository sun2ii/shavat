{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":46,"content":[{"type":"heading","content":["S'oossay Nuunana De'ee"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo K'oore Naanatuu Immina Yes'etteedda, Wodoro Naanaa Yetsaa Hiilan S'aafetteedda Yetsaa."]},{"type":"verse","number":1,"content":[{"text":"S'oossay nuuni naagetti attiyaa saanne nuw wolk'k'aa.","poem":1},{"text":"Nuuna metuu gakkiyaa wode,","poem":2},{"lineBreak":true},{"text":"maaddanaw I ubbaa gede matan de'ee.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hewaa diraw, biittay k'aas's'inttokka,","poem":1},{"text":"woy deretuu abban kunddinttokka,","poem":2},{"text":"Nuuni yayyokko.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Abbaa beetay guummiide, hoommuwaa mayninttokka,","poem":1},{"text":"Aa wolk'k'aama hobbiyan deretuu yiik'k'iyiik'k'inttokka,","poem":2},{"lineBreak":true},{"text":"nuuni yayyokko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Itti shaafay de'ee.","poem":1},{"text":"He shaafay goggiide, S'oossaa katamaa,","poem":2},{"text":"Ubbaappe D'ok'k'iyaa S'oossay de'iyaa geeshsha sa'aa nashechchee.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"S'oossay Aa giddon de'iyaa diraw,","poem":1},{"text":"he katamay k'aas's'enna.","poem":2},{"text":"Wontta guuran S'oossay Aa maaddana.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gadiyaa Asay shabbarettee;","poem":1},{"text":"kawutetsatuu k'aas's'iino.","poem":2},{"text":"S'oossay bare k'aalaa sisseedda wode, sa'ay seeree.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Med'etetsaa Ubbaa Goday nuunanna de'ee;","poem":1},{"text":"Yaak'ooba s'oossay nuuni k'osetti attiyaa sa'aa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Haa yiite; Med'inaa Goday oosuwaa s'eellite;","poem":1},{"text":"I sa'aan aheedda bashshaa be'ite.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I sa'aa gas'aa gakkanaw de'iyaa olaa te\"ee;","poem":1},{"text":"wonddaafiyaa mentsee;","poem":2},{"lineBreak":true},{"text":"tooraa mentsee;","poem":2},{"lineBreak":true},{"text":"gonddalliyaakka taman s'uuggee.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Woppu giite; taani S'oossaa gidiyaawaa erite.","poem":1},{"text":"Taani kawutetsatuwaa giddon d'ok'k'ay.","poem":2},{"text":"K'ay biittaa bollankka d'ok'k'ay.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ubbaappe Wolk'k'aama Med'inaa Goday nuunanna de'ee;","poem":1},{"text":"Yaak'ooba S'oossay nuuni k'osetti attiyaa sa'aa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}