{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":47,"content":[{"type":"heading","content":["S'oossay Alamiyaa Ubbaa Kaatiyaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, K'oore Naanatuwaa Mazimuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Kawutetsatuu ubbay hintte kushiyaa bak'k'ite;","poem":1},{"text":"k'aalaa d'ok'k'u ootsiide, S'oossaw galataa yes's'ite.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ubbaappe D'ok'k'iyaa Med'inaa Goday yayettanaw bessee;","poem":1},{"text":"sa'aa ubbaa bollan I wolk'k'aama kaatiyaa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gadiyaa asaa nuuppe garssaana,","poem":1},{"text":"kawutetsatuwaakka nu gediyaappe garssaana wotsiide,","poem":2},{"text":"Nuw moodissee.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I nuw laattiyaa biittaa dooreedda;","poem":1},{"text":"he biittay, I siik'iyaa Yaak'ooba zaratuu c'eek'ettiyaawaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"S'oossay pude kawutetsaa araataa keseedda.","poem":1},{"text":"Med'inaa Goday pude kesiyaa wode,","poem":2},{"lineBreak":true},{"text":"nashshechchaa hombboc'etsaynne malakataa punnay sisetteedda.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"S'oossaa sabbite; ee, Aa sabbite.","poem":1},{"text":"Nu kaatiyaa sabbite; ee, Aa sabbite.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"S'oossay sa'aa ubbaa kaatiyaa gidiyaa diraw,","poem":1},{"text":"galataa sabaa sabbite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"S'oossay bare geeshsha kawutetsaa araatan utteedda;","poem":1},{"text":"S'oossay kawutetsatuwaa ubbaa mooddee.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kawutetsatuwaa kaappatuu,","poem":1},{"text":"Abrahaama S'oossaa asatuwaana ittippe shiik'iino.","poem":2},{"text":"Ayaw gooppe, sa'aan de'iyaa wolk'k'aamatuu ubbay S'oossaassa;","poem":1},{"text":"I loytsi d'ok'k'u geedda.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}