{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":48,"content":[{"type":"heading","content":["S'oossaa Katamati S'iyoono"]},{"type":"hebrew_subtitle","content":["K'oraaha naanatuwaa mazamuriyaa; yetsaa"]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Goday wolk'k'aama.","poem":1},{"text":"Nu S'oossaa kataman Aa geeshsha deriyaan aad'd'o galatay aw bessee.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"S'oossaa deriyaa S'iyoone d'ok'k'anne lo\"a.","poem":1},{"text":"Pudehaa baggana de'iyaa","poem":2},{"text":"He wolk'k'aama kaatiyaa katamay sa'aa ubbaw nashshechchaa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He katamaa gimbbiyaa giddon,","poem":1},{"text":"barenan saro Asay de'iyaawaa S'oossay besseedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kaatetuu barenttu tooranchchatuwaanna ittippe shiik'eeddino;","poem":1},{"text":"S'iyoone olanaw yeeddino.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Aa be'iide, maalalettiidinne dagammiide,","poem":1},{"text":"bak'ateeddino.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Unttunttu hewan de'ishiina,","poem":1},{"text":"unttuntta yashshaa kokkorssay oyk'k'eedda;","poem":2},{"lineBreak":true},{"text":"oytsay oyk'k'eedda mishirattiidan un\"eteeddino.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Away doliyaa bagga wolk'k'aama c'arkkuwaan,","poem":1},{"text":"me\"iyaa Tarsseese markkabiyaadan unttunttu kokkoreeddino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nuuni siseeddawaadankka,","poem":1},{"text":"Ubbaappe Wolk'k'aama Med'inaa Godaa kataman,","poem":2},{"lineBreak":true},{"text":"nu S'oossaa kataman, I ootseeddawaa be'eeddo.","poem":2},{"lineBreak":true},{"text":"S'oossay he katamaa med'inaw minisi essee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Abeet S'oossaw, ne Geeshsha Golliyaa giddon","poem":1},{"text":"aggena ne siik'uwaa k'oppeeddo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abeet S'oossaw, ne suntsaadankka,","poem":1},{"text":"ne galatay sa'aa gas'aa gakkeedda.","poem":2},{"text":"Ne ushechcha kushii s'illotetsaan kumeeddawaa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ne pirddaa diraw,","poem":1},{"text":"S'iyoone Asay nashettee;","poem":2},{"text":"Yihudaa mootsatuukka nashettiino.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"S'iyoone yuushshuwaan hamettite;","poem":1},{"text":"I yuushshuwaan yaanne haanne simerettite.","poem":2},{"text":"I wochchiyaa sa'aa paydite.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yiyaa yeletaw odanaadan,","poem":1},{"text":"izi gimbbiyaa akeekitenne izi aakko gimbbiyaa s'omoosite.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hintte, «Med'i med'inaw","poem":1},{"text":"ha S'oossay nu S'oossaa;","poem":2},{"text":"I nuuna hayk'k'ana gakkanaw kaaletsana» yaagiide odite.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}