{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":49,"content":[{"type":"heading","content":["Duretaan Amanetussay Hada Gidussaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, K'oore Naanatuwaa Mazimuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Hinttenoo, asatoo, ubbatuukka hawaa sisite.","poem":1},{"text":"Hinttenoo, sa'aan de'iyaawanttoo,","poem":2},{"lineBreak":true},{"text":"ubbatuukka hawaa hayzzite.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"D'ok'k'ay zik'k'aykka,","poem":1},{"text":"durii mank'k'uukka sisite.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ta wozanaa k'ofay c'iimma;","poem":1},{"text":"ta doonay aad'd'eeda eratetsaa haasayee.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ta haytsaa leemisuwaakko yeggana;","poem":1},{"text":"diitsaa diis's'aade,","poem":2},{"text":"Taani Aa biletsaa k'onc'c'issana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Meto gallassay yiyaa wodiyaaninne baletsiyaa morkketuu,","poem":1},{"text":"taana dooddiyaa wode,","poem":2},{"text":"Taani ayaw yayyaytaa?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ta morkketoo,","poem":1},{"text":"Barenttu de'iyaawan ammanettiyaawanttoonne","poem":2},{"lineBreak":true},{"text":"barenttu duretetsaa daruwaan c'eek'k'iyaawanttoo","poem":2},{"lineBreak":true},{"text":"ayaw yayyaytaa?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ay asaynne barena wozanaw,","poem":1},{"text":"woy bare shemppuwaa gatiyaa S'oossaw c'igganaw danddayenna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ayaw gooppe, asaa shemppuwaa gatii al\"a.","poem":1},{"text":"Ay gatiyaa c'igginakka gidena.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I med'inaw de'anaadan,","poem":1},{"text":"woy I hayk'k'ennaadan ootsanaw gakkenna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Eeyyatuunne boozatuu hayk'k'iyaawaadan,","poem":1},{"text":"aad'd'eeda eranchchatuukka d'ayiyaawaanne","poem":2},{"lineBreak":true},{"text":"barenttu mas'uwaa haratoo yeggiide biyaawaa","poem":2},{"lineBreak":true},{"text":"asay ubbay be'ee.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Unttunttu barenttu biittaa barenttuwaa giinakka,","poem":1},{"text":"duufuu med'inaw unttunttu gollenne yeletaappe yeletaa gakkanaw","poem":2},{"lineBreak":true},{"text":"unttunttu de'iyaa sa'aa gidanawaa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Asay ay gitatooppekka pas'a attena;","poem":1},{"text":"I do'aadan hayk'k'ana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Barekka barenttu huup'iyaan ammanettiyaawanttu kaac'aynne","poem":1},{"text":"unttunttu k'aalaa tuma giyaawanttu wurssetsay hawaa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Shukaw dooretteedda dorssatuwaadan,","poem":1},{"text":"unttunttu duufoo dooretteeddino;","poem":2},{"text":"Hayk'k'uu unttunttu hentsanchchaa gidanawaa.","poem":1},{"text":"Suuretuu wontta unttunttu duufuwaa bolla hamettana;","poem":2},{"lineBreak":true},{"text":"unttunttu barenttu de'iyaa golliyaappe haakkiide, duufuwaan wook'k'ana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Shin S'oossay taana wozana;","poem":1},{"text":"I ta shemppuwaa hayk'k'uwaa wolk'k'aappe ashshana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Asay durettiyaa wodenne,","poem":1},{"text":"Aa bonchchuu dariyaa wode yayyoppa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ayaw gooppe, I hayk'k'iidde,","poem":1},{"text":"Ayinne akkiide beenna;","poem":2},{"text":"Aa duretay aanana ittippe duufuwaa beenna.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Asay pas'a de'iyaa wodiyaan,","poem":1},{"text":"«Taw kumeedda» gooppenne,","poem":2},{"lineBreak":true},{"text":"ubbabay aw giigeedda diraw galatettooppenne,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Simmiide poo'uwaa be'enna bare mayzza aawotuwaana gakkettee.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Eri bayinnan gitateedda Asay do'aadan hayk'k'ana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":20}