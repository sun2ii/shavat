{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":5,"content":[{"type":"heading","content":["Wontta Woosaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Suusullatuwaan Yes'etteedda, Daawita Mazimuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, taani odiyaawaa hayzza;","poem":1},{"text":"ta ooliyaanne sisa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta kaatiyawunne ta S'oossaw,","poem":1},{"text":"Taana maadda gaade ta neekko waassiyiyaa diraw,","poem":2},{"lineBreak":true},{"text":"ta woosaa sisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Abeet Med'inaa Godaw,","poem":1},{"text":"wontta wontta guuran neeni ta k'aalaa sisaasa.","poem":2},{"text":"Wontta wontta guuran taani ta woosaa ne sintsa shiishshaade,","poem":1},{"text":"neeni taw immiyaa zaaruwaa akkana gaade naagay.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Neeni iitatetsan nashettena S'oossaa;","poem":1},{"text":"iitabay neenana de'enna.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"C'eek'ettiyaawanttu ne sintsan ek'k'ikkino;","poem":1},{"text":"iitabaa ootsiyaa ubbatuwaa neeni is's'aa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wordduwaa haasayiyaawanttakka neeni d'ayissaasa.","poem":1},{"text":"Suutsaa gussiyaawanttanne c'immiyaa asatuwaa,","poem":2},{"text":"S'oossay shenetee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Shin taani ne maarotaa daruwaan","poem":1},{"text":"ne golliyaa gelana.","poem":2},{"text":"Ne Geeshsha Golliyaakko simmaade,","poem":1},{"text":"new yashshatetsan goyinnana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abeet Med'inaa Godaw, Taana ne s'illotetsan kaaletsa;","poem":1},{"text":"ta morkkatuwaa diraw gaade,","poem":2},{"lineBreak":true},{"text":"ne ogiyaa ta sintsan suurisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Unttunttu doonaappe kesiyaawe ammantsenna.","poem":1},{"text":"Unttunttu wozanaankka genii kumeedda;","poem":2},{"lineBreak":true},{"text":"unttunttu doonay dooyetteedda duufuwaa mala;","poem":2},{"lineBreak":true},{"text":"Unttunttu barenttu ins's'arssan c'immiino.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abeet S'oossaw, unttuntta neeni pirdda;","poem":1},{"text":"unttunttu kobay unttuntta akki bo.","poem":2},{"text":"Unttunttu nagaray daro gideedda diraw,","poem":1},{"text":"neeni unttuntta yederssa;","poem":2},{"lineBreak":true},{"text":"ayaw gooppe, unttunttu ne bolla makkaleeddino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Shin neekko bak'ati k'osetti attiyaa ubbay nashetino;","poem":1},{"text":"unttunttu ubbaa gede nashshechchan yes's'ino.","poem":2},{"text":"Neenikka unttuntta naagana;","poem":1},{"text":"ne suntsaa siik'iyaa ubbatuu neenan loytsi nashetino.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ayaw gooppe, abeet Med'inaa Godaw,","poem":1},{"text":"tumukka neeni s'illuwaa anjjaasa.","poem":2},{"text":"Neeni gonddallii kammiyaawaadan ne keekkatetsan Aa kammaasa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}