{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":50,"content":[{"type":"heading","content":["Tumo Goynaa"]},{"type":"hebrew_subtitle","content":["Asaafa mazamuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Wolk'k'aama S'oossay, Med'inaa Goday haasayee.","poem":1},{"text":"Away doliyaasaappe wulliyaasaa gakkanaw","poem":2},{"lineBreak":true},{"text":"sa'aan de'iyaa asaa s'eesee.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Puulay kumentsaa lo\"a gidiyaa S'iyooneppe S'oossay poo'ee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nu S'oossay yaana; c'o\"u geena.","poem":1},{"text":"Ees's'iyaa tamay Aa sintsaana;","poem":2},{"lineBreak":true},{"text":"wolk'k'aama gotii Aa yuushshuwaana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"S'oossay bare asaa pirddiidde,","poem":1},{"text":"salotuwaanne sa'aa s'eesee.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"«Yarshshuwaa yarshshiyaawaan,","poem":1},{"text":"taananna c'aak'k'eteedda S'oossaa asatuwaa,","poem":2},{"lineBreak":true},{"text":"taakko shiishshite» yaageedda.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"S'oossay pirddiyaawaa gidiyaa diraw,","poem":1},{"text":"salotuu Aa s'illotetsaa odiino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Ta asaw, sisa! Taani new oday.","poem":1},{"text":"Israa'eeliyaa asaw, taani ne bolla markkattay.","poem":2},{"text":"Taani S'oossaa, ne S'oossaa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ne yarshshuwaa dirawunne","poem":1},{"text":"neeni ubbaa gede shiishshiyaa s'uuggiyaa yarshshuwaa diraw,","poem":2},{"text":"Taani neena seerikke.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hewaadankka, ne dirssaappe korumatuwaa,","poem":1},{"text":"woy ne sikkuwaappe deeshshatuwaa akkanaw koyikke.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ayaw gooppe, woraan de'iyaa do'atuu ubbatuu tawantta;","poem":1},{"text":"sha\"u deriyaa bollan de'iyaa mehetuukka tawantta.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Taani d'ok'k'a deriyaan de'iyaa kafotuwaa ubbaa eray;","poem":1},{"text":"dembban de'iyaa med'etetsatuu tawantta.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Taana koshinttonne, taani new odikke:","poem":1},{"text":"ayaw gooppe, sa'aynne sa'aan kumeeddawe ubbay tawaa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Taani korumatuwaa ashuwaa mayttaa?","poem":1},{"text":"Woy deeshshatuwaa suutsaa ushaytaa?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hewaa diraw, S'oossaw,","poem":1},{"text":"neeni immiyaa yarshshuu galataa gido;","poem":2},{"text":"Ubbaappe D'ok'k'iyaa S'oossaw ne k'anggetsaa gatsa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yaataade, metuwaa gallassi taana s'eesa.","poem":1},{"text":"Taani neena ashshana; neenikka taana bonchchana» yaagee.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Shin S'oossay iita asaa hawaadan yaagee;","poem":1},{"text":"Ta higgiyaa neeni zaara zaaraadde ayaw oday?","poem":2},{"text":"Woy ta c'aak'uwaa ne doonaan ayaw haasayay?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Neeni ta timirttiyaa is's'aadda;","poem":1},{"text":"ta k'aalaakka haytsaa bollaanna aatsaada.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Neeni kayisuwaa be'eedda wode,","poem":1},{"text":"aanana dabbotaadda;","poem":2},{"text":"Shaarmus'iyaawanttu maabaran gelaadda.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Neeni ne doonaa iitabaa haasayanaw billa yeddaasa.","poem":1},{"text":"Ne ins's'arssaykka wordduwaa haasayaa meezeteedda.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ne utteeddasaan ne ishaa iissaade haasayaadda;","poem":1},{"text":"ne aatti na'aa zigiraasa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Neeni hawaa ubbaa ootsiyaa wode,","poem":1},{"text":"taani c'o\"u geedda diraw,","poem":2},{"text":"Taanakka ne mala gaade k'oppaadda.","poem":1},{"text":"Shin ha\"i taani neena seeraynne","poem":2},{"lineBreak":true},{"text":"ne balaa ne sintsan payday.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Hinttenoo, S'oossaa dogiyaawanttoo, hawaa akeekite.","poem":1},{"text":"Hewe d'ayooppe, taani hinttena mentsereetsana;","poem":2},{"lineBreak":true},{"text":"he wode hinttena ashshiyaawe baawa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Taw galataa immiyaa Asay taana bonchchee.","poem":1},{"text":"Bare ogiyaa suurissiyaa asaa","poem":2},{"lineBreak":true},{"text":"taani S'oossaa atotetsaa bessana» yaagee.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}