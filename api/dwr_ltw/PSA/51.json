{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":51,"content":[{"type":"heading","content":["Maarotetsaa Demanaw Shiik'eedda Woosaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, Berssaabina sharmus'eedda Hanotaa Timbbitiyaa Odiyaa Naataani Aw odiide Simmina, Daawita Mazamuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet S'oossaw, aggena ne siik'uwaadan taana maara;","poem":1},{"text":"ne k'aretaa daruwaadan ta bayzzuwaa k'uc'c'a.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta iitatetsaappe taana mule meec'c'a;","poem":1},{"text":"ta nagaraappe taana geeshsha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ayaw gooppe, ta bayzzuwaa taani eray;","poem":1},{"text":"ta nagaray ubbaa gede ta sintsaana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taani neena, ne s'alala naak'k'aad;","poem":1},{"text":"ne ayifiyaa sintsan iitabaa ootsaad.","poem":2},{"text":"Hewaa diraw, haasayaaddekka neeni likke;","poem":1},{"text":"pirddaaddekka neeni s'illuwaa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Taani yelettoodeppekka tumu nagaranchcha;","poem":1},{"text":"ta aatti uluwaan biro attiyaa wodeppe doommaadekka,","poem":2},{"lineBreak":true},{"text":"taani nagaranchcha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hekko neeni wozana giddo tumatetsaa koyaasa;","poem":1},{"text":"hewaa diraw, ne aad'd'eeda eratetsaa ta garssan tamaarissa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hiisoop'p'iyaa giyaa bonc'c'iyaan neeni taana geeshsha;","poem":1},{"text":"taani geeyana.","poem":2},{"text":"Taana meec'c'a;","poem":1},{"text":"taani shachchaappe aad'd'aade boos's'ana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Neeni taana nashshechchaanne","poem":1},{"text":"hashshu giyaawaa sisa;","poem":2},{"lineBreak":true},{"text":"neeni taana mentsereetseeddabaa gidooppekka,","poem":2},{"lineBreak":true},{"text":"zaaraadde nashshechchaa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ta nagaraappe ne sintsa wora zaara;","poem":1},{"text":"ta iitatetsaa ubbaa k'uc'c'a.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abeet S'oossaw, geeshsha wozanaa ta giddon med'd'a;","poem":1},{"text":"minisiyaa ayaanaa ta giddon ooratsa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Taana ne sintsaappe oloppa;","poem":1},{"text":"ne Geeshsha Ayaanaa taappe akkoppa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne atotetsaa nashshechchaa taw zaaraadde imma;","poem":1},{"text":"taani new eeno gaade azazettanaadan,","poem":2},{"lineBreak":true},{"text":"Taana zemppissa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"He wode taani bayzzanchchatuwaa ne ogiyaa tamaarissana;","poem":1},{"text":"he nagaranchchatuunne neekko simmana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Abeet S'oossaw, taana ashshiyaa S'oossaw,","poem":1},{"text":"suutsaa gusseedda nagaraappe taana ashsha;","poem":2},{"text":"He wode ta ins's'arssay ne s'illotetsaabaa yes's'ana.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Abeet Godaw, ta doonaa dooyaa;","poem":1},{"text":"yaatooppe, ta ins's'arssay ne galataa awaayana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Neeni yarshshuwaan nashetantto ta new shiishshanashin,","poem":1},{"text":"neeni yarshshuwaan nashetakka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"S'oossaw yarshshiyaa yarshshuu","poem":1},{"text":"ashkke ayaanaa; abeet S'oossaw,","poem":2},{"text":"«Nagaraa ootsennan aggaarikkitaashaa» giyaa,","poem":1},{"text":"me\"eedda wozanaa neeni kad'akka.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Abeet S'oossaw, ne dosuwaan S'iyooniw keeka;","poem":1},{"text":"Yerusaalame gimbbetuwaa gimbba.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"He wode s'illo yarshshuwaan,","poem":1},{"text":"S'uuggiyaa yarshshuwaaninne,","poem":2},{"lineBreak":true},{"text":"mehiyaa ashuwaa wurssi s'uuggiyaa yarshshuwaan neeni nashettana.","poem":2},{"lineBreak":true},{"text":"K'ay korumatuu ne yarshshiyaasan yarshshettana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}