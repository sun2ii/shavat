{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":52,"content":[{"type":"heading","content":["Iitatuwaa Wurssetsaa Kaac'aa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, Eedooma biittaa asaa gidiyaa Doyik'i Saa'oolakko biide, «Daawite Abimeleeka golle beedda» yaagiide odiide simmina Daawita Akeeka Timirttiyaa."]},{"type":"verse","number":1,"content":[{"text":"Neenoo, wolk'k'aama bitaniyaw,","poem":1},{"text":"S'oossaa asatuwaa bolla iitabaa ootsiyaawaadan,","poem":2},{"lineBreak":true},{"text":"gallassaa ubbaan ayaw c'eek'ettay?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neenoo, worddobaa haniyaawoo,","poem":1},{"text":"neeni haratuwaa d'ayissanaw mak'ettaasa.","poem":2},{"text":"Ne ins's'arssay kuussa mak'k'iliyaa mala.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Neeni lo\"uwaappe iitaa siik'aasa;","poem":1},{"text":"k'ay tumuwaa haasayiyaawaappe,","poem":2},{"lineBreak":true},{"text":"wordduwaa haasayiyaawaa dosaasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Neenoo, worddanchchaw,","poem":1},{"text":"neeni k'ohiyaa k'aalaa ubbaa siik'aasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Shin S'oossay neena med'inaw d'ayissana.","poem":1},{"text":"I neena dafananne ne golliyaappe bonk'k'iide kessana;","poem":2},{"text":"I neena pas'a de'iyaawanttu giddoppe d'ok'ollana.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"S'illotuu hawaa be'iide yayana.","poem":1},{"text":"Unttunttu hawaadan yaagiide, ne bolla miic'c'ana;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"«S'oossaa barew geessuwaa ootsibeenna,","poem":1},{"text":"bare duretetsaa daruwaan ammanetteeda,","poem":2},{"text":"Iita oosuwaan minneedda bitaniyaa","poem":1},{"text":"hawaa be'ite!» yaagana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Shin taani S'oossaa golliyaan aac'iya wogaraa mala.","poem":1},{"text":"Aggena Aa siik'uwaan taani med'i med'inaw ammanettay.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neeni ootseedda diraw,","poem":1},{"text":"Ta neena galatana,","poem":2},{"lineBreak":true},{"text":"taani neeni keeka gidiyaa diraw ne suntsaan hidootaa wotsay.","poem":2},{"lineBreak":true},{"text":"Taani S'oossaa asatuwaa sintsan neena sabbana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}