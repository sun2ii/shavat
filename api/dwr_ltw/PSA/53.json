{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":53,"content":[{"type":"heading","content":["Asaa Iitatetsaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, Daawita Akeekaa Timirttiyaa."]},{"type":"verse","number":1,"content":[{"text":"Boozatuu barenttu wozanaan,","poem":1},{"text":"«S'oossay baawa» yaagiino.","poem":2},{"lineBreak":true},{"text":"Unttunttu de'uu bayeedda.","poem":2},{"lineBreak":true},{"text":"Unttunttu sheneyiyaabaa ootsiino;","poem":2},{"lineBreak":true},{"text":"lo\"iyaabaa ootsiyaa Asay baawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"S'oossaa koyiyaa eranchchatuu de'inttonne be'anaw,","poem":1},{"text":"S'oossay saluwaappe duge asaa s'eellee.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Unttunttu ubbaykka S'oossaappe haakkeeddino;","poem":1},{"text":"ubbaykka ittippe tuneeddino.","poem":2},{"text":"Lo\"uwaa ootsiyaa Asay baawa;","poem":1},{"text":"haray atto ittuunne baawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"S'oossay, «Hawanttu ta asaa bonk'k'i miyaa iita asatuu","poem":1},{"text":"tumu ayinne erikkinoo?","poem":2},{"text":"Unttunttu taana woossikkino» yaagee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Unttunttu kase dagammi erennawaa keeshshaa dagamana.","poem":1},{"text":"Ayaw gooppe, S'oossay bare asaa morkkiyaawanttu mek'etsaa laalana.","poem":2},{"text":"S'oossay unttuntta kad'eedda diraw, unttunttu yeellatana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Israa'eeliyaw atotetsay S'iyooneppe yeerennee!","poem":1},{"text":"S'oossay bare asaa omooduwaa zaariyaa wode,","poem":2},{"text":"Yaak'ooba zaratuu nashettana;","poem":1},{"text":"Israa'eeliyaa Asay nashshechchaw pooc'u gaana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}