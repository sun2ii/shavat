{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":54,"content":[{"type":"heading","content":["Morkkiyaa Kushiyaappe Attanaw Shiik'eedda Woosaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, Ziifan de'iyaa asatuu Saa'oolakko biide, «Daawite nu biittan k'osetteedda» yaagiide odiide simmina Daawite Akeekan Diis's'eedda Timirttiyaa."]},{"type":"verse","number":1,"content":[{"text":"Abeet S'oossaw, ne suntsan taana ashsha;","poem":1},{"text":"ne wolk'k'an taana shatintsaa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abeet S'oossaw, ta woosaa sisa;","poem":1},{"text":"ta doonaa haasayaa hayzza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Otoranchchatuu ta bolla denddiino;","poem":1},{"text":"dagantsiyaa asatuu taana wod'anaw koyiino.","poem":2},{"text":"Unttunttu S'oossaa alaalle giikkino.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hekko S'oossay taana maaddiyaawaa;","poem":1},{"text":"Goday taana zemppissiyaawaa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abeet S'oossaw, ta morkketoo unttunttu iitatetsaa zaara.","poem":1},{"text":"Neeni ammanettiyaawaa gidiyaawaadan,","poem":2},{"lineBreak":true},{"text":"unttuntta d'ayissa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Abeet Med'inaa Godaw, taani ta sheniyaan new yarshshana;","poem":1},{"text":"neeni keeka gidiyaa diraw,","poem":2},{"text":"Taani ne suntsaa galatana.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ayaw gooppe, neeni taana","poem":1},{"text":"ta metuwaa ubbaappe ashshaadda;","poem":2},{"text":"Ta morkketuu s'oonettiyaawaa ta ayifiyaan be'aad.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}