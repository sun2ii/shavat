{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":55,"content":[{"type":"heading","content":["Laggetsay Kaddeedda Asaa Woosaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, Daawite Akeekan Diis's'eedda Diitsaa."]},{"type":"verse","number":1,"content":[{"text":"Abeet S'oossaw, ta woosaa sisa;","poem":1},{"text":"ta maganaa ay metee gooppa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hayzza; ta woosaa sisa;","poem":1},{"text":"Ta k'ofay taana waayissina,","poem":2},{"lineBreak":true},{"text":"taani shabbarettaad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hewenne, ta morkkatuwaa kooshshaappenne,","poem":1},{"text":"iitatuwaa naak'uwaappe denddeeddawaana.","poem":2},{"text":"Unttunttu ta bolla metuwaa ahiinonne","poem":1},{"text":"barenttu hank'k'uwaan taana morkkiino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ta wozana ayifiyaan diddik'ee;","poem":1},{"text":"hayk'k'uwaa hirggay taana maashiseedda.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Taana yashshaynne kokkorssay oyk'k'eedda;","poem":1},{"text":"dagamay taana wod'i diggeedda.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani, «Taw harap'p'iyaadan k'efii de'eerenneeshsha.","poem":1},{"text":"Yaanintto taani paalla baade shemppana shin;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"taani haakkaade baana shin;","poem":1},{"text":"Bazzuwaan de'ana shin.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Taani gotiyaappenne uushuwaappe,","poem":1},{"text":"attiyaasaa elleellaade gakkana shin» yaagaad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abeet S'oossaw, taani katamaa giddon","poem":1},{"text":"walassaanne wad'etaa be'eedda diraw,","poem":2},{"text":"Iitatuwaa haasayaa bulluuk'k'a.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Iitatuu gallassinne k'amma,","poem":1},{"text":"gimbbiyaa yuuyyiino;","poem":2},{"text":"Iitatetsaynne kobay katamaa giddon de'ee.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bashshay Aa giddon de'ee;","poem":1},{"text":"naak'uukka c'imuukka Aa gutaraappe shaakkettenna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Taana boriyaawe ta morkkiyaa gidenna;","poem":1},{"text":"gidintto taani danddayana.","poem":2},{"text":"Ta bolla c'eek'ettiyaawe taana is's'iyaawaa gidenna;","poem":1},{"text":"gidintto taani aappe k'osettana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Shin hawaa ubbaa ootsiyaawe asaa,","poem":1},{"text":"ta laggiyaa,","poem":2},{"text":"Ta dabbuwaanne ta siik'uwaa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nuuni ittuu ittuwaanna ulobaa haasayeeddo;","poem":1},{"text":"nuuni S'oossaa golliyaan asaana ittippe simeretteeddo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ta morkketuu wodii gakkennan hayk'k'ino;","poem":1},{"text":"unttunttu pas'a moogettino.","poem":2},{"text":"Ayaw gooppe, iitatetsay","poem":1},{"text":"unttunttu giddoninne unttunttu de'iyaa saan de'ee.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Shin taani S'oossaa s'eesay;","poem":1},{"text":"Med'inaa Goday taana ashshee.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wontta, gallassinne omarssi","poem":1},{"text":"taani waassananne ta metuwaa aw odana;","poem":2},{"text":"I taana sisana.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Darotuu taana morkkooppekka,","poem":1},{"text":"I taana olaa tooraappe ashshee.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Benippe kawutetsaa araatan utteedda S'oossay,","poem":1},{"text":"ta woosaa sisiide barenttu ogiyaa laammennawanttanne","poem":2},{"lineBreak":true},{"text":"barew yayyenawantta,","poem":2},{"lineBreak":true},{"text":"I kawushshana.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ta laggii bare dabbotuwaa k'ohanaw,","poem":1},{"text":"bare kushiyaa dentseedda;","poem":2},{"lineBreak":true},{"text":"unttunttunna c'aak'k'eteedda c'aak'uwaa koleedda.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Aa haasayay oyssaappekka aad'd'eeda shuga;","poem":1},{"text":"shin bare wozanaan morkkeedda.","poem":2},{"text":"Aa k'aalatuu zayitiyaappekka aad'd'iide wololatiino;","poem":1},{"text":"shin kuussa mashshaadan k'ans's'eeddino.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ne tookuwaa Med'inaa Godaan wotsa;","poem":1},{"text":"I neena zemppissana.","poem":2},{"text":"S'oossay awudenne s'illotuu","poem":1},{"text":"shabbarettanaadan ootsenna.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Shin Abeet S'oossaw, neeni","poem":1},{"text":"iita asatuwaa c'iimmo ollaan duge olana.","poem":2},{"text":"Suutsaa gussiyaawanttunne c'immiyaawanttu,","poem":1},{"text":"barenttu de'ana laytsaw baggaanne de'ikkino;","poem":2},{"text":"Shin taani neenan ammanettana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}