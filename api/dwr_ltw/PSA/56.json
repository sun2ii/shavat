{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":56,"content":[{"type":"heading","content":["S'oossaan Zemppuwaa Woosaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, Piliss's'eema asatuu Aa Gaate Giyaa Katamaan Omoodeedda Wode, Daawita Mazimuriyaa. Haako Saan Wolaa Bollan Utteedda Dogomattissi Geetettiide Suusulliyaan Yes'etteedda Mazimuriyaa."]},{"type":"verse","number":1,"content":[{"text":"Abeet S'oossaw, asatuu taana yederssiyaa dirawunne","poem":1},{"text":"gallassaa ubbankka ta morkketuu taana un\"etseedda diraw,","poem":2},{"lineBreak":true},{"text":"taw k'aretta.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta morkketuu gallassaa ubbaan","poem":1},{"text":"taana yederssiino;","poem":2},{"text":"C'oratuu otoruwaan taana un\"etsiino.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Taani yayyeedda wode,","poem":1},{"text":"neenan ammanettay.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taani S'oossan ammanettay;","poem":1},{"text":"Taani Aa k'aalaa galatiyaa S'oossan","poem":2},{"lineBreak":true},{"text":"ammanettaynne yayyikke.","poem":2},{"lineBreak":true},{"text":"Asay taana ayaa ootsanee?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gallassaa ubbaan ta morkketuu,","poem":1},{"text":"taw metuwaa med'd'iino;","poem":2},{"text":"Unttunttu ubbaa gede taw iitabaa k'oppiino.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Unttunttu ta bolla mak'ettiino;","poem":1},{"text":"kuukuliide wochchiinonne","poem":2},{"lineBreak":true},{"text":"ta ogiyaa naagiino;","poem":2},{"lineBreak":true},{"text":"taana wod'anaw koyiino.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Unttunttu iitatetsaa diraw, unttuntta yeddoppa;","poem":1},{"text":"ne hank'k'uwaan he asatuwaa zik'k'i ootsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Neeni taani toyilakattowaa paydaadda.","poem":1},{"text":"Taani woyssa afotsaa gussaadditantto, neeni eraasa.","poem":2},{"text":"Unttunttu ne mazggobiyaan de'ikkinoo?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Taani neena s'eesiyaa wode,","poem":1},{"text":"ta morkketuu guyye simmana.","poem":2},{"text":"S'oossay ta bagga gidiyaawaa taani eray.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Taani Aa k'aalaa galatiyaa S'oossay,","poem":1},{"text":"taani Aa k'aalaa galatiyaa Med'inaa Godaa,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"taani he S'oossan ammanettay; yayyikke.","poem":1},{"text":"Asay taana ay ootsanee?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abeet S'oossaw, taani,","poem":1},{"text":"new shiik'etteeddawaa ootsana;","poem":2},{"text":"Hewaa galataa yarshshuwaa taani new immana.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ayaw gooppe, neeni taana hayk'k'uwaappe,","poem":1},{"text":"ta gediyaa kunddetsaappe ashshaada.","poem":2},{"text":"Hewaa diraw, I pas'a de'iyaawanttu bollan poo'issiyaa poo'uwaan","poem":1},{"text":"S'oossaa sintsan taani hamettay.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}