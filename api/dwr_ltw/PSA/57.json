{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":57,"content":[{"type":"heading","content":["Maaduwaa Demanaw Shiik'eedda Woosaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo, Gonggolo giddoppe Saa'oolappe bak'atiide bi simmina Daawita Woosaa. «D'ayssoppa» Geetettiyaa Woosaan Yes'etteedda Woosaa."]},{"type":"verse","number":1,"content":[{"text":"Taana maara; abeet S'oossaw, taana maara;","poem":1},{"text":"taani neekko bak'atay.","poem":2},{"text":"Bashshay aad'd'ana gakkanaw,","poem":1},{"text":"ne k'efiyaa giddon bak'ataade attay.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Taani Ubbaappe D'ok'k'iyaa S'oossaw,","poem":1},{"text":"taw ubbabaa ootsiyaa S'oossaw waassay.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"S'oossay saluwaappe maaduwaa kiittiide, taana ashshana;","poem":1},{"text":"taana naak'k'iyaawantta kawushshana;","poem":2},{"text":"S'oossay aggena bare siik'uwaanne","poem":1},{"text":"bare tumatetsaa taw kiittana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Taani ta morkkatuwaa giddon,","poem":1},{"text":"asaa bonk'k'iide miyaa gaammuwaa malatuwaa giddon de'ay.","poem":2},{"text":"Unttunttu achchay tooraanne wonddaafiyaa mala;","poem":1},{"text":"unttunttu ins's'arssay kuussa mashshaa mala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Abeet S'oossaw, neeni salotuwaappe bollaanna d'ok'k'u d'ok'k'u ga;","poem":1},{"text":"ne bonchchuu sa'aa ubbaa bolla de'o.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Unttunttu ta gediyaw p'iriyaa wotseeddino;","poem":1},{"text":"taani metootaade hokkaad.","poem":2},{"text":"Unttunttu ta ogiyaan ollaa bookkeeddino;","poem":1},{"text":"shin he ollaan barenttoo kunddeeddino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ta wozanay minniide de'ee;","poem":1},{"text":"Abeet S'oossaw, ta wozanay minniide de'ee.","poem":2},{"text":"Taani new yes's'ananne neena sabbana.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ta shemppattee, beegotta!","poem":1},{"text":"Diitsawunne maasink'k'oo, beegottite!","poem":2},{"text":"Taanikka wontta guuraanna beegottana.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Abeet S'oossaw, taani neena asaa giddon galatana;","poem":1},{"text":"k'ay kawutetsaa giddon neena sabbana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ayaw gooppe, aggena ne siik'uu wolk'k'aama;","poem":1},{"text":"salotuwaa gakkeedda.","poem":2},{"text":"Ne tumatetsaykka bolla shaariyaadan d'ok'k'ee.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Abeet S'oossaw,","poem":1},{"text":"salotuwaappe bollaanna d'ok'k'u d'ok'k'u ga!","poem":2},{"text":"Ne bonchchuu sa'aa ubbaa bolla gido.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}