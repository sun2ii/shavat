{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":58,"content":[{"type":"heading","content":["S'oossay Nagaranchchatuwaa MuranaadanShiik'o Woosaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, Daawita Woossa. «D'ayssoppa» Geetettiyaa Mazimuriyaa waas'uwaan Yes'etteedda Woosaa."]},{"type":"verse","number":1,"content":[{"text":"Hinttenoo deriyaa mooddiyaawanttoo,","poem":1},{"text":"tumuwaappe likkiyaa haasayiitee?","poem":2},{"text":"Asaa ubbaa giddon s'illuwaa pirddiitee?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gidena, hintte wozanaan iitabaa halchchiita;","poem":1},{"text":"biittan hintte kushii makkalabaa ootseedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Iita Asay aatti uluwaappe doommiide balee;","poem":1},{"text":"yelettoodeppe doommiide,","poem":2},{"text":"Bayzzeenne wordduwaa haasayee.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Unttunttu shooshshaadan yishshaana de'iino;","poem":1},{"text":"Tulle hassuwaadan haytsaa tuc'c'eeddino.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bitiyaawe ay keeshsha hiilanchcha gidooppekka,","poem":1},{"text":"hasuu Aa saasuketsaa sisenna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Abeet S'oossaw, unttunttu achchaa","poem":1},{"text":"unttunttu gappataa giddon mentsa;","poem":2},{"lineBreak":true},{"text":"abeet Med'inaa Godaw, gaammotuwaa kasiliyaa d'ukka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Unttunttu goggi d'ayiyaa haatsaadan d'ayino.","poem":1},{"text":"Unttunttu barenttu wonddaafiyaa dukkiyaa wode,","poem":2},{"lineBreak":true},{"text":"pootsaa s'eeran c'addiyaa ayifii d'ayo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Unttunttu muushiide saasso kesiyaa d'aad'd'iyaadan hanino;","poem":1},{"text":"aatti uluwaappe boshettiide yeletteedda,","poem":2},{"lineBreak":true},{"text":"poo'uwaa be'enna na'aadan hanino.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Unttunttu aguntsa gidiide daashanaappe kase,","poem":1},{"text":"unttunttu biro puutiyaan de'ishshin,","poem":2},{"text":"S'oossay unttuntta bare hank'k'uwaan d'ayissana.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Haluwaa kessiyaawaa be'iyaa wode,","poem":1},{"text":"s'illotuu nashettana.","poem":2},{"text":"Iitatuwaa suutsan barenttu gediyaa meec'ettana.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"He wode asay,","poem":1},{"text":"«Tumukka s'illotoo woytuu de'ee;","poem":2},{"lineBreak":true},{"text":"tumukka sa'aa bolla pirddiyaa S'oossay de'ee» yaagana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}