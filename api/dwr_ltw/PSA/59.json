{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":59,"content":[{"type":"heading","content":["Iitatuwaa Ek'etiide Shiik'o Woosaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, Daawita wod'anaw Aa golliyaa naagana mala Saa'ooli asatuwaa kiitti simmina Daawita Mazimuriyaa. «D'ayssoppa» Giidde Diitsaa Giigissuwaan Yes'etteedda Woosaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet ta S'oossaw, ta morkkatuwaappe taana ashsha;","poem":1},{"text":"ta bolla denddiyaawanttuppe taana naaga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iita ootsiyaawanttuppe taana ashsha akka;","poem":1},{"text":"suutsaa gussiyaa asatuwaappe taana ashsha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Abeet S'oossaw, unttunttu taana wod'anaw","poem":1},{"text":"kuukuliide naagiyaawaa be'a!","poem":2},{"text":"He wolk'k'aama iita asatuu ta bolla yaa'iino.","poem":1},{"text":"Abeet Med'inaa Godaw, ta bayzzuwaa diraw","poem":2},{"lineBreak":true},{"text":"woy ta nagaraa diraw gidenna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Unttunttu taana olanaw wotsaa jaamiyaawe,","poem":1},{"text":"ta balaa diraassa gidenna.","poem":2},{"text":"Beegotta, taakko haa yaade be'a.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Abeet Ubbaappe Wolk'k'aama Med'etaa Ubbaa Godaa S'oossaw,","poem":1},{"text":"Israa'eeliyaa S'oossaw,","poem":2},{"lineBreak":true},{"text":"kawutetsatuwaa ubbaa pirddanaw beegotta;","poem":2},{"lineBreak":true},{"text":"makkalaa ootsiyaawantta maaroppa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Unttunttu omarssan simmiino;","poem":1},{"text":"kanatuwaadan boc'c'iidde, katamaa giddon yuuyyiino.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hekko, unttunttu barenttu doonaan haasayiide salikkino;","poem":1},{"text":"unttunttu ins's'arssay mashshaa mala.","poem":2},{"text":"Unttunttu biro, «Ooninne sisenna» giide k'oppiino.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Shin abeet Med'inaa Godaw,","poem":1},{"text":"neeni unttunttu bolla miic'c'aasa;","poem":2},{"lineBreak":true},{"text":"kawutetsatuwaa ubbaa bolla k'iliic'aasa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"S'oossaw, neeni taw k'osetta attiyaa sa'aa gidiyaa diraw,","poem":1},{"text":"taani ne wolk'k'an ammanettay.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta S'oossay aggena bare siik'uwaan taakko yaana;","poem":1},{"text":"ta S'oossay ta morkkatuwaa s'ooniyaawaa I taana bessana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta asatuu doggenna mala, neeni unttuntta wod'oppa.","poem":1},{"text":"Abeet S'oossaw, nu gonddalliyaw,","poem":2},{"lineBreak":true},{"text":"ne wolk'k'an unttuntta laalaade s'oona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Unttunttu barenttu doonaa nagaraa dirawunne","poem":1},{"text":"barenttu ins's'arssaa k'aalaa diraw,","poem":2},{"lineBreak":true},{"text":"barenttu otoruwaan oyk'k'ettino.","poem":2},{"lineBreak":true},{"text":"Unttunttu shek'aa dirawunne unttunttu haasayiyaa wordduwaa diraw,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ne hank'k'uwaan unttuntta d'ayissa.","poem":1},{"text":"S'oossay Yaak'ooba zaratuwaa mooddiyaawaanne","poem":2},{"lineBreak":true},{"text":"sa'aa gas'aa gakkanaw de'iyaa biittaa mooddiyaawaa Asay erana mala,","poem":2},{"lineBreak":true},{"text":"unttuntta mule attenaadan d'ayissa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ta morkketuu omarssan simmiino;","poem":1},{"text":"kanatuwaadan boc'c'iidde,","poem":2},{"lineBreak":true},{"text":"katamaa giddon yuuyyiino.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Unttunttu miyaawaa demanaw toyilakattiino;","poem":1},{"text":"kallana d'ayooppe laawiino.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Shin taani ne wolk'k'aa sabbana;","poem":1},{"text":"wontta aggena ne siik'uwaabaa yes's'ana.","poem":2},{"text":"Ayaw gooppe, neeni taw ta waayiyaa gallassi,","poem":1},{"text":"taani bak'ata attiyaa saanne k'osetta attiyaasaa gidaadda.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abeet taw wolk'k'aa gideedda S'oossaw,","poem":1},{"text":"taani neena sabbana.","poem":2},{"text":"Ayaw gooppe, taani k'osetta attiyaa sa'aynne","poem":1},{"text":"aggena siik'uwaa taana bessiyaa S'oossay neena.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}