{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":6,"content":[{"type":"heading","content":["Un\"o Wodiyaan Shiik'eedda Woosaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Diitsatuwaan Yes'etteedda, Daawita Mazimuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, ne hank'k'uwaan taana seeroppaarikkii;","poem":1},{"text":"woy ne yiluwaan taana muroppaarikkii.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abeet Med'inaa Godaw, taani labbanneedda diraw,","poem":1},{"text":"taana maaraarikkii.","poem":2},{"text":"Abeet Med'inaa Godaw, ta wozanay madus's'o diraw, taana patsa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ta shemppatta daroppe un\"ettaaddu;","poem":1},{"text":"shin S'oossaw, taana maaddanaw neeni awude gakkanaw gam\"ay?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Abeet S'oossaw, neeni simmaade, taana ashsha;","poem":1},{"text":"ne maarotaa daruwaan taana kessa akka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hayk'k'eedda uray ooninne neena hassayenna;","poem":1},{"text":"duufuwaan neena galatiyaawe baawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Taani ooliyaan daaburaad;","poem":1},{"text":"K'amma ubbaan taani yeekkaade, ta hiis'aa irs's'issaad;","poem":2},{"lineBreak":true},{"text":"ta borkkotsaakka ta afotsaan muusuud'issaad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta morkkatuwaa ubbaa gaasuwaan taani afos's'eedda diraw,","poem":1},{"text":"ta ayifii galjjeedda;","poem":2},{"lineBreak":true},{"text":"ta ayifii demmennaan is's'eedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Med'inaa Goday taani yeekkiyaa yeekuwaa siseedda diraw,","poem":1},{"text":"Hinttenoo, iitaa ootsiyaa ubbatoo,","poem":2},{"lineBreak":true},{"text":"gede taappe shaakettite.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Med'inaa Goday ta watiwatuwaa siseedda;","poem":1},{"text":"Med'inaa Goday ta woosaanne sisee.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta morkke ubbatuu yeellatinonne tuggatino.","poem":1},{"text":"Unttunttu k'oppennaan yeellatiide, guyye simmino.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}