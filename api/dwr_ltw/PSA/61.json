{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":61,"content":[{"type":"heading","content":["Naaganaadan Shiik'o Woosaa"]},{"type":"hebrew_subtitle","content":["Daawite Zammaaretuwaa Kaappoo Diitsaan Yes's'eedda Mazimuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet S'oossaw, neeni ta waasuwaa sisa;","poem":1},{"text":"ta woosaa hayzza.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta wozanay hidootaa k'ans's'o wode,","poem":1},{"text":"Taani biittaa gas'aappe neena s'eesay.","poem":2},{"text":"Taappe d'ok'k'iyaa zaallaakko, taana kaaletsa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ayaw gooppe, neeni taw geessuwaanne","poem":1},{"text":"taani ta morkkatuwaappe naagettiyaa gimbbiyaa dirssaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Taani ne dunkkaaniyaan med'inaw de'arikkitaa!","poem":1},{"text":"taani ne k'efiyaa hap'aa giddon saro attarikkitaa!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abeet S'oossaw, neeni ta k'anggetsaa sisaadda.","poem":1},{"text":"Ne suntsaa yayyiyaawanttu","poem":2},{"lineBreak":true},{"text":"laattiyaa laataa tawukka immaadda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kaatiyaa laytsaa adussa;","poem":1},{"text":"I yeletaappe yeletaa gakkanaw de'o.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I S'oossaa sintsan med'inaw kaateto;","poem":1},{"text":"aggena ne siik'uwaaninne ne tumatetsan Aa naaga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yaatiyaawaa gidooppe, taani","poem":1},{"text":"ta k'anggetsaa gallassan gallassan gatsaadde,","poem":2},{"lineBreak":true},{"text":"ne suntsaa ubbaa gede sabbana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}