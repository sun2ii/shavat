{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":62,"content":[{"type":"heading","content":["Hidootay S'oossaa Bolla S'alalan"]},{"type":"hebrew_subtitle","content":["Daawite Zammaaretuwaa Kaappuwaa Juddutoo Yes's'eedda Mazimuriyaa."]},{"type":"verse","number":1,"content":[{"text":"S'oossaa s'alalan taani shemppuwaa demmaad;","poem":1},{"text":"ta atotetsay aappe yee.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Aa s'alalay ta zaallaanne ta atotetsaa;","poem":1},{"text":"I taani k'osetta attiyaa sa'aa gidiyaa diraw,","poem":2},{"lineBreak":true},{"text":"ayinne hirggikke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Woddiyaa godaanne k'aas's'iyaa dirssaa malatiyaa asaa wod'anaw,","poem":1},{"text":"hintte awude gakkanaw denddiitee?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Unttunttu Aa bonchcho sa'aappe","poem":1},{"text":"Aa wotsanawaa s'alala koyiino;","poem":2},{"lineBreak":true},{"text":"unttunttu wordduwaan nashettiino.","poem":2},{"lineBreak":true},{"text":"Barenttu doonaan anjjiino;","poem":2},{"lineBreak":true},{"text":"shin barenttu wozanaan shek'iino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ta shemppatta S'oossaa s'alalan shemppuwaa demmaaddu;","poem":1},{"text":"taani hidootan naagiyaawe aappe yee.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Aa s'alalay ta zaallaanne ta atotetsaa;","poem":1},{"text":"I taani k'osetta attiyaa sa'aa gidiyaa diraw,","poem":2},{"lineBreak":true},{"text":"ayinne hirggikke.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta atotetsaynne ta bonchchuu S'oossaanna;","poem":1},{"text":"I ta mino zaallaanne ta geessuwaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Asaw, ubbaa wode S'oossan ammanettite;","poem":1},{"text":"I nuw geessuwaa gidiyaa diraw,","poem":2},{"lineBreak":true},{"text":"hintte wozanaa k'ofaa aw odite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Asay ubbay itti gede shemppiyaa c'arkkuwaa mala;","poem":1},{"text":"d'ok'k'ina zik'k'ina, Asay mela.","poem":2},{"text":"Miizaaniyaan wotsinakka unttunttu ayinne dees'ikkino;","poem":1},{"text":"unttunttu itti gede shemppiyaa c'arkkuwaappekka kawushiino.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Makkalan shiishshowaan ammanettoppite;","poem":1},{"text":"wuu'i shiishshiide durettanaw halchchoppite.","poem":2},{"text":"Hintte duretetsay darooppekka,","poem":1},{"text":"hintte wozanaa Aa bolla wotsoppite.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"S'oossay itti gede odeedda, taani","poem":1},{"text":"laa\"u yewuwaa sisaad; «Wolk'k'ay S'oossaassa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Aggena siik'uu Godaawaa» yaageedda.","poem":1},{"text":"Abeet S'oossaw, neeni asaa ubbaw","poem":2},{"text":"Aa oosuwaadan oosuwaadan zaarana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}