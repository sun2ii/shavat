{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":63,"content":[{"type":"heading","content":["S'oossaa Koyussaa"]},{"type":"hebrew_subtitle","content":["Yihudaa Bazzuwaan de'iyaa wode Daawita mazamuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet S'oossaw, neeni ta S'oossaa;","poem":1},{"text":"ta wozanay neena laamotee;","poem":2},{"lineBreak":true},{"text":"ta ashuukka neena amottee.","poem":2},{"text":"Meli za\"eedda, haatsi bayinna biittaadan","poem":1},{"text":"ta kumentsaa asatetsay neena saamettee.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taani neena geeshsha sa'aan be'aad;","poem":1},{"text":"ne wolk'k'aakka ne bonchchuwaakka taani be\"aad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Aggena ne siik'uu de'uwaappe lo\"iyaa diraw,","poem":1},{"text":"ta ins's'arssay neena bonchchana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ta de'uwaa laytsan taani neena galatana;","poem":1},{"text":"ne suntsan ta kushiyaa pude mic'c'ana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Asay lo\"o k'umaa kalliyaawaadan,","poem":1},{"text":"ta shemppatta neenan kallana.","poem":2},{"text":"Taani ta ins's'arssan nashshechchaa yetsan neena galatana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Taani ta gisuwaan neena hassayay;","poem":1},{"text":"k'ammaa ubbaan nebaa k'oppay;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ayaw gooppe, neeni taana maadeeddawaa.","poem":1},{"text":"Taani ne k'efiyaa kuwaan uttaade, nashshechchaw yes's'ay.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Taani ne mata shiik'a uttay;","poem":1},{"text":"ne ushechcha kushii taana oyk'k'iide naagee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Shin taana wod'ana koyiyaawanttu,","poem":1},{"text":"biittaa garssa c'iimmo sa'aan moogettana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Unttunttu mashshaw aad'd'iide imettana;","poem":1},{"text":"unttunttu babark'k'iyaa kaate gidana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Shin kaatii S'oossan nashettana.","poem":1},{"text":"S'oossaa suntsan c'aak'k'iyaa ubbay Aa galatana;","poem":2},{"lineBreak":true},{"text":"shin wordduwaa haasayiyaawanttu doonay gorddettana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}