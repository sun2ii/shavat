{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":64,"content":[{"type":"heading","content":["Naaganaadan Shiik'o Woosaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, Daawita mazamuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet S'oossaw, taani maganniyaa maganaa neeni sisa.","poem":1},{"text":"Taani ta morkketoo yayaad; taana ashsha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iitatuwaa mak'k'uwaappenne,","poem":1},{"text":"iitaa ootsiyaawanttu shiik'uwaappe taana gentsaa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Unttunttu barenttu ins's'arssaa mashshaadan leefeeddino;","poem":1},{"text":"k'ay marzze k'aalatuwaa,","poem":2},{"lineBreak":true},{"text":"wonddaafiyaa pootsaadan dukkanaw giigisseeddino.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Unttunttu k'osettiide,","poem":1},{"text":"barenttu wonddaafiyaa s'illo asaa bolla dafiino;","poem":2},{"lineBreak":true},{"text":"akeekay bayinnan dukkiino; unttunttu yayyikkino.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Unttunttu barenttu iita mak'k'oo ittuu ittuwaa mintsetsiino;","poem":1},{"text":"barenttu p'iriyaa k'osiyaasaa zorettiino.","poem":2},{"text":"Unttunttu, «nuuna ooni be'anee?» yaagiino.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Unttunttu iitabaa mak'ettiidde,","poem":1},{"text":"«Nuuni lo\"o mak'k'uwaa mak'etteeddo» yaagiino.","poem":2},{"text":"Hewenne, asaw wozanaynne kahay c'iimma gidiyaawaa bessee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Shin S'oossay unttuntta bare wonddaafiyaan dukkana;","poem":1},{"text":"unttunttu akeekenan madus's'ana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Unttunttu mak'k'uwaa diraw,","poem":1},{"text":"I unttuntta d'ayissana;","poem":2},{"lineBreak":true},{"text":"unttuntta be'iyaa ubbay huup'iyaa k'aatsana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"He wode Asay ubbay S'oossaw yayana;","poem":1},{"text":"Aa oosuwaabaa odananne zaari zaariide k'oppana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"S'illotuu Med'inaa Godaan nashetinonne,","poem":1},{"text":"aakko bak'atiide attiino;","poem":2},{"lineBreak":true},{"text":"wozanaa suuretuu ubbay galatino.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}