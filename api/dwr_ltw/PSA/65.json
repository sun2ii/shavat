{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":65,"content":[{"type":"heading","content":["Galataa Mazimuriyaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, Daawita mazamuriyaa, Sabaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet S'oossaw, S'iyoonen new galatay bessee;","poem":1},{"text":"nuuni new shiik'etteeddawaakka gatsana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abeet woosaa sisiyaawoo,","poem":1},{"text":"asay ubbay neekko yaana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nu nagaray nuuna muukkeedda wode,","poem":1},{"text":"ne nuw atotetsaa immaadda.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Neeni dooreeddanne ne chilootan uttanaw","poem":1},{"text":"mataa shiishshiyaa Asay anjjetteeddawaa.","poem":2},{"text":"Nuuni ne son, Geeshsha Dunkkaaniyaan","poem":1},{"text":"de'iyaa lo\"oban kumeeddo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Abeet nuuna ashshiyaa S'oossaw,","poem":1},{"text":"maalalissiyaa ne s'illo oosuwaan neeni nuw allaasa.","poem":2},{"text":"Sa'aa gas'aappe gas'aa gakkanaw,","poem":1},{"text":"haakko abbatuwaappekka hefintsan de'iyaa asaa ubbaw,","poem":2},{"lineBreak":true},{"text":"ammanettiyaawe neena.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Neeni neena wolk'k'aa danc'c'isaade;","poem":1},{"text":"wolk'k'aama deretuwaa ne minotetsan essaadda.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Neeni abbaa kooshshaanne,","poem":1},{"text":"beetaa guntsaa sirp'p'i ootsaasa;","poem":2},{"lineBreak":true},{"text":"k'ay Asay denddiyaa dendduwaa irs's'issaasa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hewaadan neeni ootseedda malaataa diraw,","poem":1},{"text":"sa'aa gas'aa gakkanaw de'iyaa Asay ubbay new, «Hoola!» gee.","poem":2},{"text":"Away mokkiyaasaappe wulliyaasaa gakkanaw de'iyaa asaa ubbaa nashechchaadda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Neeni biittaa naagaade iraa bukissaasa;","poem":1},{"text":"yaataade daro tu'eyaasa.","poem":2},{"text":"Asaw katsay mokkana mala,","poem":1},{"text":"S'oossaa pulttotuu haatsaan kumeeddino;","poem":2},{"lineBreak":true},{"text":"hewaadan ootsaade neeni giigissaadda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kaachaa wod'ana malanne guulluwaa shugissana mala,","poem":1},{"text":"neeni yafaran haatsaa kuntsaassa;","poem":2},{"lineBreak":true},{"text":"katsay mokkana mala anjjaasa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Laytsaa kalo laytsaa ootsaasa;","poem":1},{"text":"neeni aad'd'iyaa sa'ay ubbay kumi palahee.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Neeni hentsaa sa'aa maatan kuntsaassa;","poem":1},{"text":"zoozetuwaakka nashshechchaa danc'c'isaasa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Neeni hentsaa gadiyaa dorssaa wudiyaa mayzzaasa;","poem":1},{"text":"zanggaaraa biittaakka katsaa kuntsaa.","poem":2},{"text":"Unttunttu nashshechchaw hombboc'iinonne yes's'iino.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}