{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":66,"content":[{"type":"heading","content":["Ittipetetsaa Galataa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda Sabaa, mazamuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Sa'aan asaa ubbaw, hintte k'aalaa d'ok'k'issiide,","poem":1},{"text":"nashshechchan S'oossaa galatite.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"«S'oossaa suntsay bonchchetto!» giide yes's'ite;","poem":1},{"text":"bonchcho galataa aw immite.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"S'oossaw hawaadan yaagite;","poem":1},{"text":"«Ne oosotuu waan malalissiyaawanttee!","poem":2},{"text":"Ne wolk'k'ay dareedda diraw,","poem":1},{"text":"ne morkketuu yashshaw ne sintsan kokkoriino.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sa'aan de'iyaa ubbatuu new goyinniino;","poem":1},{"text":"neena sabbiino;","poem":2},{"lineBreak":true},{"text":"ne suntsaw galataa yes's'iino» yaagite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Haayite; S'oossay ootseeddawaa be'ite;","poem":1},{"text":"I asaa giddon maalalissiyaa oosuwaa ootseedda.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I abbaa haatsaa shaakeedda;","poem":1},{"text":"k'ay beni nu aawotuu yorddaanoosa shaafaa,","poem":2},{"lineBreak":true},{"text":"barenttu gediyaan hamettiide, mela biittaan pinneeddino.","poem":2},{"lineBreak":true},{"text":"Hewan I ootseeddabaan nuuni nashetteeddo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I bare wolk'k'an med'inaw mooddee.","poem":1},{"text":"Kawutetsatuwaa bare ayifiyaan s'eellee;","poem":2},{"lineBreak":true},{"text":"hewaa diraw, makkaliyaawanttu Aa bolla denddoppino.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Asatoo, nu S'oossaa galatite;","poem":1},{"text":"hintte Aa galatiyaa galatay sisetto.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I nuuna pas'a wotseedda;","poem":1},{"text":"nuuni kunddennaadan naageedda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abeet S'oossaw, neeni nuuna paac'c'aadda;","poem":1},{"text":"biraa geeshshanaw taman paac'iyaawaadan,","poem":2},{"lineBreak":true},{"text":"nuuna geeshshaadda.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Neeni nuuna p'iriyaan gelissaadda.","poem":1},{"text":"Nu zokkuwaankka dees'obaa toossaadda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Morkketuu nu huup'iyaan togganaadan ootsaadda.","poem":1},{"text":"Nuuni haatsaa gidduwaananne tamaa gidduwaana aad'd'eedo;","poem":2},{"lineBreak":true},{"text":"shin ha\"i nuuna ishaliyaa sa'aa ahaadda.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Taani s'uuggiyaa yarshshuwaanna ne golliyaa gelaade,","poem":1},{"text":"ta k'anggiyaa new gatsana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Taani metooteedda wode,","poem":1},{"text":"ta doonaan shiik'etteedda k'anggiyaa,","poem":2},{"lineBreak":true},{"text":"ta ins's'arssaappe keseeddawaa, taani gatsana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Taani new s'uuggiide yarshshiyaa,","poem":1},{"text":"dorssaa orggetuwaa shiishshana.","poem":2},{"text":"Koruma booratuwaanne deeshsha orggetuwaa new yarshshana;","poem":1},{"text":"he yarshshotuwaa c'uway saluwaa gakkana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hinttenoo, S'oossaw yayyiyaawanttoo,","poem":1},{"text":"ubbatuu haa yiide, sisite.","poem":2},{"text":"S'oossay taw ootseeddawaa taani hinttew odana.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ta k'aalaa d'ok'k'u ootsaade taani S'oossaa woossaad;","poem":1},{"text":"ta ins's'arssan aw galataa shiishshaad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Taani ta wozanaan nagaraa gentseeddentto,","poem":1},{"text":"Goday taana sisenna.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Shin S'oossay tumuwaappe taana siseedda;","poem":1},{"text":"ta woosaakka hayzzeedda.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"S'oossay ta woosaa is's'ibeenna diraw,","poem":1},{"text":"k'ay aggena bare siik'uwaa taw diggibeenna diraw, galateetto.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}