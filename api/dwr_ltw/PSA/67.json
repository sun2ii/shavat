awutetsatuwaa kaaletsaasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Abeet S'oossaw, Asay neena galato;","poem":1},{"text":"asay ubbay neena galato.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Biittay katsaa mokkeedda;","poem":1},{"text":"S'oossay, nu S'oossay nuuna anjjeedda.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"S'oossay nuuna anjjeedda.","poem":1},{"text":"Sa'aa gas'aa gakkanaw de'iyaa Asay ubbay aw yayyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}