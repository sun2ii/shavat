{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":68,"content":[{"type":"heading","content":["S'oonuwaa Mazimuriyaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, Daawite s'aafeedda mazamuriyaa, yetsaa"]},{"type":"verse","number":1,"content":[{"text":"S'oossay denddo; Aa morkketuu laalettino.","poem":1},{"text":"Aa is's'iyaawanttu Aa sintsaappe bak'attino.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"C'uway c'arkkuwaan punettiyaawaadan,","poem":1},{"text":"neeni unttuntta punna d'ayssa.","poem":2},{"text":"Muk'aadday taman muushiyaawaadan,","poem":1},{"text":"iitatuu S'oossaa sintsappe d'ayino.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Shin s'illotuu hashshu giino;","poem":1},{"text":"S'oossaa sintsan nashetino;","poem":2},{"lineBreak":true},{"text":"nashshechchan ililino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"S'oossaw yes's'ite; Aa suntsaa sabbite.","poem":1},{"text":"Shaariyaa bollan gaalifiyaawaa d'ok'k'u d'ok'k'u ootsite kessite;","poem":2},{"text":"Aa suntsay Med'inaa Godaa;","poem":1},{"text":"Aa sintsan nashettite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"S'oossay bare de'iyaa geeshsha sa'aan,","poem":1},{"text":"aawuu bayinna naanaatoo aawuwaa;","poem":2},{"lineBreak":true},{"text":"k'ay asinay hayk'k'eedda mac'c'a asatoo daana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"S'oossay barekka de'iyaawanttoo golle asaa immee.","poem":1},{"text":"K'asho golliyaan de'iyaawantta biliide,","poem":2},{"lineBreak":true},{"text":"unttuntta ishaluwaan wotsee.","poem":2},{"lineBreak":true},{"text":"Shin makkalanchchatuu meleedda biittan de'iino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Abeet S'oossaw, neeni ne asaa kaaletseedda wode,","poem":1},{"text":"neeni unttunttunna mela bazzuwaa beedda wode,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Siina Deriyan k'onc'c'eedda S'oossaa sintsan,","poem":1},{"text":"Israa'eeliyaa S'oossaa sintsan biittay k'aas's'eedda;","poem":2},{"lineBreak":true},{"text":"salotuu iraa duge tigeeddino.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abeet S'oossaw, neeni iraa darissaade bukissaadda;","poem":1},{"text":"mela biittaa zaaraadde ooratsaadda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne asaykka yaan utteedda.","poem":1},{"text":"Abeet S'oossaw, ne keekkatetsan,","poem":2},{"lineBreak":true},{"text":"hiyyeesatoo koshshiyaabaa giigissaade immaadda.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Goday kiitaa kiitteedda;","poem":1},{"text":"he kiitaa afeeda mac'c'a asatuu dara.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Unttunttu, «Morkke kaatetuunne","poem":1},{"text":"unttunttu tooranchchatuu guyye bak'ateeddino;","poem":2},{"lineBreak":true},{"text":"son atteeda mac'c'a asatuu omooduwaa shaakketteeddino.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Unttunttu, P'ooliyaa work'k'aa k'efiyaana de'iyaa,","poem":1},{"text":"biraappe med'etteedda harap'p'iyaa misiliyaa,","poem":2},{"lineBreak":true},{"text":"omooduwaa demmoode, hinttenttu,","poem":2},{"lineBreak":true},{"text":"dorssaa sikuwaa giddon ayaw giseedditee?» yaageeddino.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ubbaa Danddayiyaa S'oossay,","poem":1},{"text":"kaatetuwaa laaleedda wode,","poem":2},{"text":"S'almmoona asaa bolla shachchaa bukisseedda.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Baasaane deretuu wogga wolk'k'aama deretuwaa;","poem":1},{"text":"baasaane deretuu daro s'eeratuu de'iyaawantta.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Daro s'eeratuu de'iyaa deretoo,","poem":1},{"text":"S'oossay baressa ootsanaw dooreedda asaa,","poem":2},{"lineBreak":true},{"text":"hintte ayaw k'anaatiide s'eelliitee?","poem":2},{"lineBreak":true},{"text":"Med'inaa Goday aan med'inaw de'anawaa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"S'oossaa olaa paraa gaaretuu","poem":1},{"text":"tammu sha\"aaninne sha\"u gede sha\"an paydetiyaawantta;","poem":2},{"lineBreak":true},{"text":"Goday Siinaa deriyaappe bare geeshsha sa'aa yeedda.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Omoodetteedda darotuwaa akkiide,","poem":1},{"text":"I pude d'ok'k'aa keseedda.","poem":2},{"text":"Asaappe, haray atto makkalanchcha asaappekka imuwaa akkeedda.","poem":1},{"text":"Med'etaa Ubbaa Goday yaan de'ana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Gallassaan gallassaan nu tookuwaa tookkiyaa Goday,","poem":1},{"text":"nuuna ashiyaa S'oossay galatetto.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ee, nu S'oossay nuuna ashshiyaa S'oossaattee!","poem":1},{"text":"Hayk'k'uwaappe attiyaawe,","poem":2},{"text":"Ubbaa Mooddiyaa Med'inaa Goday ashshinada.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"S'oossay tumuwaappe bare morkkatuwaa,","poem":1},{"text":"guuggiyaa kinchchana;","poem":2},{"lineBreak":true},{"text":"nagaraa ogiyaan hamettiyaa,","poem":2},{"lineBreak":true},{"text":"goofaranchchatuwaa huup'iyaa p'alk'k'ana.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Goday yaageedda; «Taani hintte morkkatuwaa,","poem":1},{"text":"Baasaaneppe zaaraadde ahana;","poem":2},{"lineBreak":true},{"text":"taani unttuntta c'iimmo abbaa giddoppe kessaade guyye ahana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hewenne, neeni ne morkkatuwaa,","poem":1},{"text":"suutsaa gidduwaana c'olbbaya yed'd'aade hamettanaassanne;","poem":2},{"lineBreak":true},{"text":"ne kanatuukka morkkiyaa suutsaappe,","poem":2},{"lineBreak":true},{"text":"barenttu gishuwaa ins's'arssan laac'c'anaassa» yaageedda.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Abeet S'oossaw, ne salppii,","poem":1},{"text":"ta S'oossaa ta kaatiyaa salppii,","poem":2},{"lineBreak":true},{"text":"Geeshsha Golliyaa geliyaa wode ubbaw beettee.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yes's'iyaawanttu sintsaana; diis's'iyaawanttu guyyenna;","poem":1},{"text":"k'ay karabuwaa bak'k'iyaa wodorotuu gidduwaana.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Unttunttu, «S'oossaa kuntseedda shiik'uwaan galatite;","poem":1},{"text":"hinttenoo, Israa'eeliyaa zeretsatoo,","poem":2},{"text":"Med'inaa Godaa galatite» yaagiino.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"He salppiyaan ubbaappe teefatiyaa,","poem":1},{"text":"Biiniyaama zaratuu koyiro beettiino.","poem":2},{"text":"Kaalliide Yihudaa kaappatuu barenttu c'itaana de'iino;","poem":1},{"text":"wurssetsan Zaabiloona Kaappatuunne Nifttaaleema kaappatuu beettiino.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Abeet S'oossaw, ne wolk'k'aa k'onc'c'issa.","poem":1},{"text":"Abeet nuw ootseedda S'oossaw,","poem":2},{"lineBreak":true},{"text":"ne minotetsaa bessa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Hewaa diraw, Yerusaalamen de'iyaa","poem":1},{"text":"ne Geeshsha Golliyaa kaatetuu yiide,","poem":2},{"lineBreak":true},{"text":"new imotaa immana.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Do'aadan mak'k'aa giddon de'iyaa Gibs'e asatuwaa neeni seera.","poem":1},{"text":"Booratuwaanne maratuwaa wudiyaa,","poem":2},{"lineBreak":true},{"text":"malatiyaa kawutetsatuwaa neeni yederssa.","poem":2},{"lineBreak":true},{"text":"Unttunttu gulbbatiide, barenttu biraa new immana gakkanaw,","poem":2},{"lineBreak":true},{"text":"neeni unttuntta seera.","poem":2},{"lineBreak":true},{"text":"Olettanaw yeemottiyaa asatuwaa laala.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kiitetteedda kaappatuu Gibs'eppe yaana;","poem":1},{"text":"Top'p'ata bare kushiyaa elle S'oossaakko mic'c'ana.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Hinttenoo, sa'aa kawutetsatoo,","poem":1},{"text":"S'oossaw yes's'ite;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"salotuwaan, benippe de'iyaa salotuwaan biyaa Godaa sabbite.","poem":1},{"text":"Sisite! I bare kooshshaa,","poem":2},{"lineBreak":true},{"text":"bare wolk'k'aama guntsaa kiittee.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"S'oossaa wolk'k'aabaa awaayite;","poem":1},{"text":"Aa anggay Israa'eeliyaa bollaanna;","poem":2},{"text":"Aa wolk'k'aykka saluwaana.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"S'oossay bare Geeshsha Golliyaappe k'onc'c'oode, Maalalisee.","poem":1},{"text":"Israa'eeliyaa S'oossay bare asaw minotetsaanne wolk'k'aa immee.","poem":2},{"text":"Med'inaa Goday galatetto.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":35}