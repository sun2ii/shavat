{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":69,"content":[{"type":"heading","content":["Maaduwaa Demanaw Shiik'o Woosaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo, C'iishshaa Waatsaa Giyaa Waas's'uwaan Yes'eteedda Daawita Mazimuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet S'oossaw, taana ashsha;","poem":1},{"text":"ayaw gooppe, haatsay taw k'ood'iyaa gakkeedda.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gedii ek'k'iyaa sa'ay bayinna c'ariyaan muukettaad;","poem":1},{"text":"c'iimmo haatsaa giddo gelaad;","poem":2},{"lineBreak":true},{"text":"haatsaa zuluu ta bolla baana hanee.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Maadoo waassaade daaburay;","poem":1},{"text":"ta kottoniikka meleedda.","poem":2},{"text":"Ta S'oossay allee gaade s'eellishin,","poem":1},{"text":"ta ayifii galjjeedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Taana c'oo is's'iyaawanttu,","poem":1},{"text":"ta huup'iyaa binnaanaappe dara.","poem":2},{"text":"Wordduwaan taana morkkiyaawanttunne,","poem":1},{"text":"d'ayissanaw koyiyaawanttu dareeddino.","poem":2},{"text":"Taani wolk'k'antsa akkabeena miishshaa taana c'iggisiino.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Abeet S'oossaw, ta bayzzuwaa eeyyatetsaa neeni eraasa;","poem":1},{"text":"taani ootseedda nagaray neeppe k'osettenna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Abeet Godaw, Ubbaappe Wolk'k'aama Med'inaa Godaw,","poem":1},{"text":"neena hidootan naagiyaawanttu,","poem":2},{"lineBreak":true},{"text":"ta gaasuwaan yeellatoppino.","poem":2},{"lineBreak":true},{"text":"Abeet Israa'eeliyaa S'oossaw, neekko shiik'iyaawanttu","poem":2},{"lineBreak":true},{"text":"ta gaasuwaan kawushoppino.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Taani boriyaa danddayeeddawenne","poem":1},{"text":"ta som\"ii yeellaa mayyeeddawe ne diraassa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Taani ta ishatoo imatsaa,","poem":1},{"text":"k'ay ta aatti naanaatoo allaga gidaaddi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Taani ne golliyaw seelettiyaa seelay,","poem":1},{"text":"taana tamaadan guuddee;","poem":2},{"lineBreak":true},{"text":"neena boriyaawanttu borii ta bolla wod'd'eedda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Taani s'oomaade, ta huup'iyaa kawushsheeddawe,","poem":1},{"text":"taw k'iliic'uwaa gideedda.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Taani kayyuwaa mayuwaa mayyeedda wode,","poem":1},{"text":"unttunttoo tossaw gidaaddi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Katamaa Penggiyaan uttiyaawanttu taana k'iliic'iino;","poem":1},{"text":"matsottiyaawanttu tabaa yetsaa kessiino.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Shin abeet Med'inaa Godaw, taana gidooppe,","poem":1},{"text":"taani neena woossay.","poem":2},{"text":"Abeet S'oossaw, ne dosiyaa wodiyaan,","poem":1},{"text":"aggena ne siik'uwaa daruwaan,","poem":2},{"lineBreak":true},{"text":"neeni ashana geeddawaadan taw zaaruwaa imma.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"C'ariyaan muukettenaadan taana ashsha.","poem":1},{"text":"Taana is's'iyaawanttuppe,","poem":2},{"lineBreak":true},{"text":"c'iimmo haatsatuwaappe neeni kessa akka.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Haatsaa di\"uwaan taana afissoppa;","poem":1},{"text":"woy c'iimmo olaan taana mitissoppa;","poem":2},{"lineBreak":true},{"text":"woy duufuwaa doonaa ta bolla gorddisoppa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abeet Med'inaa Godaw, aggena ne siik'uwaa keekkatetsaadan,","poem":1},{"text":"taw zaaruwaa imma.","poem":2},{"text":"Ne k'aretaa daruwaadan taakko simma.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Taappe ne k'oomaappe ne som\"uwaa gentsoppa;","poem":1},{"text":"taani waayettiyaa diraw, taw elle zaaruwaa imma.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Neeni taakko shiik'a; taana woza;","poem":1},{"text":"ta morkkatuwaappe taana la\"a kesa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Taani boriyaa, yeellaanne,","poem":1},{"text":"kawushshaa akkeeddawaa neeni eraasa.","poem":2},{"text":"Ayaw gooppe, ta morkkatuwaa ubbaa neeni be'aasa.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Borii ta wozanaa pas'ennaadan mentso diraw;","poem":1},{"text":"hidoota k'ans's'aad.","poem":2},{"text":"Taw k'arettiyaawaa koyaad.","poem":1},{"text":"Shin ittuunne baawa;","poem":2},{"lineBreak":true},{"text":"taana mintsetsiyaa asaa s'eellaad; shin demmabeykke.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Taani koshateedda wode,","poem":1},{"text":"taw c'ammiyaa k'umaa aatseeddino.","poem":2},{"text":"Taani saametteedda wode,","poem":1},{"text":"taw c'aala woyniyaa eessaa immeeddino.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Unttunttu miyaa samppay unttunttoo p'ire gido.","poem":1},{"text":"Unttunttu yarshshuwaa yarshshiidde,","poem":2},{"lineBreak":true},{"text":"miyaa gibiray unttunttoo gitiyaa gido.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"S'eellennaadan unttunttu ayifii goozetto;","poem":1},{"text":"unttunttu gaaduwaa ubbaa gede kokkorssa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ne hank'k'uwaa unttunttu bolla tiga;","poem":1},{"text":"ne suulo hank'k'uu unttuntta yederssiide oyk'k'o.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Unttunttu kambbuu mela de'o;","poem":1},{"text":"unttunttu dunkkaaniyaan ooninne de'oppo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ayaw gooppe, unttunttu,","poem":1},{"text":"neeni mureeddawantta yederssiino;","poem":2},{"lineBreak":true},{"text":"k'ay neeni dechcheeddawanttu tuggaabaa","poem":2},{"lineBreak":true},{"text":"dentsiide haasayiino.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Neeni unttunttu nagaraa bolla","poem":1},{"text":"nagaraa gujjanaadan agga;","poem":2},{"lineBreak":true},{"text":"ne maarotetsaappe unttuntta ayaynne gakkoppo.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Unttunttu de'uwaa mas'aafaappe k'uc'ettino;","poem":1},{"text":"s'illo asaana mazggabettoppino.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Taani sakettaadenne tuggataade de'ay.","poem":1},{"text":"Abeet S'oossaw, taana ashshaade,","poem":2},{"lineBreak":true},{"text":"saro sa'aan wotsa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Taani S'oossaa suntsaa yetsan galatana;","poem":1},{"text":"galataa imuwaan Aa darssana.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Hewekka, booraa yarshshiyaawaappe","poem":1},{"text":"woy kac'aama korumaa yarshshiyaawaappe","poem":2},{"lineBreak":true},{"text":"aad'd'iide, Med'inaa Godaa nashshechchana.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Naak'etteeddawanttu taana S'oossay,","poem":1},{"text":"ashsheedawaa be'iide nashetino.","poem":2},{"text":"Hinttenoo S'oossaakko shiik'iyaawanttoo,","poem":1},{"text":"hintte wozanay minetto.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ayaw gooppe, Med'inaa Goday hiyyeesatuwaa sisee;","poem":1},{"text":"k'asho golliyaan de'iyaa bare asaakka kad'enna.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Saluunne sa'ay, k'ay abbayinne","poem":1},{"text":"Aa giddon wos's'i k'aas's'iyaa ubbatuu S'oossaa galatino.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ayaw gooppe, S'oossay S'iyoone ashshana;","poem":1},{"text":"Yihudaa katamatuwaa zaariide kees's'ana.","poem":2},{"text":"Aa Asay yaan de'ananne he biittay unttunttussa gidanawaa.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Aa k'oomatuwaa naanatuu he biittaa laattana;","poem":1},{"text":"Aa suntsaa siik'iyaawanttu yaan de'ana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}