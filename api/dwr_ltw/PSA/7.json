{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":7,"content":[{"type":"heading","content":["Yedesaa Wodiyaan S'illo Asaa Woosaa"]},{"type":"hebrew_subtitle","content":["Biiniyaama Zariyaa Kuuzawaa Daawite, S'oossaakko Zilaaleedda Zilaassaa."]},{"type":"verse","number":1,"content":["Abeet Med'inaa Godaw, ta S'oossaw, taani neekko bak'ataade k'osettay.",{"text":"Taana yederssiyaa ubbatuwaappe neeni taana ashsha akka.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Neeni taana ashshenabaa gidooppe,","poem":1},{"text":"Unttunttu taana gaammuwaadan bonk'k'iide,","poem":2},{"lineBreak":true},{"text":"ooninne ashshenan mentsereetsana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Abeet Med'inaa Godaw ta S'oossaw,","poem":1},{"text":"Taani asaa naak'k'eeddawaa gidooppe,","poem":2},{"text":"Hewenne ta laggiyaw lo\"uwaa diraw iitaa zaareeddawaa gidooppenne,","poem":1},{"text":"Woy gaasuu bayinnan ta morkkiyaa bonk'k'eeddawaa gidooppe,","poem":2},{"text":"Hawaa mala yewotuwaappe ittuwaanne taani ootseeddawaa gidooppe,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ta morkkii taana yederssiide oyk'k'o.","poem":1},{"text":"Taana sa'aan yed'ereetso;","poem":2},{"lineBreak":true},{"text":"yaatiide, taana biittaan oli basho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Abeet Med'inaa Godaw, ne hank'k'uwaan dendda ek'k'a;","poem":1},{"text":"ta morkkatuwaa ees's'iyaa hank'k'uwaa bolla dendda.","poem":2},{"text":"Ta S'oossaw Godaw, beegotta; tumuwaa pirdda.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kawutetsatuwaa shiik'uu ne yuushshuwaan shiik'o;","poem":1},{"text":"neeni unttunttuppe bollaanna gidaade haana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Med'inaa Goday kawutetsatuwaa bolla pirddee.","poem":1},{"text":"Abeet Med'inaa Godaw, taw ta s'illotetsaadan pirdda;","poem":2},{"text":"Abeet Ubbaappe D'ok'k'aw, ta suuretetsaadan pirddaa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"K'ofaanne wozanaa biddaade eriyaa s'illo S'oossaw,","poem":1},{"text":"iitatuwaa geniyaa neeni d'ayissa.","poem":2},{"text":"Shin s'illuwaa sarotan minisa wotsa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Wozanaa s'illuwaa ashshiyaa S'oossay","poem":1},{"text":"taw gonddalle.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"S'oossay s'illuwaa pirddiyaawaa;","poem":1},{"text":"I hachchi hachchi hank'k'ettiyaa S'oossaa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Asay bare nagaraa paas'iide simmennaan is's'ooppe,","poem":1},{"text":"S'oossay bare mashshaa leefee;","poem":2},{"text":"I bare wonddaafiyaa giigissee.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I bare wod'iyaa olaa miishshatuwaa giigissee;","poem":1},{"text":"Tamaa lac'uwaadan p'ooliyaa bare wonddaafiyaa tooraa giigissee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Iitatetsaa shahaareedda,","poem":1},{"text":"geniyaa shahaara shahaareeddawe, wordduwaa yelee.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hara asatoo ollaa bookkeedda asay","poem":1},{"text":"bare bookkeedda ollaan barew kunddee.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"I ahiyaa genii Aa huup'iyaw simmee.","poem":1},{"text":"Aa makkalaynne Aa huup'iyaw simmee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Med'inaa Godaa s'illotetsaa diraw,","poem":1},{"text":"taani Aa galatana;","poem":2},{"text":"K'ay Ubbaappe D'ok'k'iyaa Med'inaa Godaa suntsaw,","poem":1},{"text":"taani galataa yes's'ana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}