{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":70,"content":[{"type":"heading","content":["Un\"aa Waasuwaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Daawita hassayissiyaawaa mazamuriyaa."]},{"type":"verse","number":1,"content":[{"text":"Abeet S'oossaw, taana ashshanaw eeno ga;","poem":1},{"text":"abeet Med'inaa Godaw, taana maaddanaw elleella.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taana wod'anaw koyiyaawanttu","poem":1},{"text":"yeellatinonne kawushino.","poem":2},{"text":"Taani k'ohettannawaa amottiyaawanttu,","poem":1},{"text":"kawushiide guyye simmino.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ta bolla, «Aw hashshu! Hashshu!»","poem":1},{"text":"geeddawanttu s'oonetteedda diraw yeellatino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Shin neena koyiyaa ubbatuu,","poem":1},{"text":"neenan nashetinonne hashshu giino.","poem":2},{"text":"K'ay ne atotetsaa dosiyaawanttu ubbatuu,","poem":1},{"text":"«S'oossay gitato!» yaagino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Taani hiyyeessanne metootanchchaa;","poem":1},{"text":"abeet S'oossaw, elle taakko haaya.","poem":2},{"text":"Taana maaddiyaawenne ashshiyaawe neena;","poem":1},{"text":"abeet Med'inaa Godaw, gam\"oppa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}