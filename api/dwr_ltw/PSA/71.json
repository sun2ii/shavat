{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":71,"content":[{"type":"heading","content":["S'oossaa Maaduwaa Demanaw Shiik'o Woosaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, taani neekko bak'atay;","poem":1},{"text":"awudenne taana yeellayoppa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne s'illotetsaan taana wotsa akka;","poem":1},{"text":"ne haytsaa taakko yeggaade, taana ashsha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Neeni taw ubbaa wode geemmiyaa mino zaallaanne,","poem":1},{"text":"taana ashshiyaa mino geessuwaa gida.","poem":2},{"text":"Ta attana mala ne azaza.","poem":1},{"text":"Ee, neeni ta zaallaanne ta geessuwaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Abeet ta S'oossaw, iitatuwaa kushiyaappe,","poem":1},{"text":"Iitaa ootsiyaawanttuppenne","poem":2},{"lineBreak":true},{"text":"k'areti bayinna asatuwaa wolk'k'aappe taana ashsha.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ayaw gooppe, abeet Ubbaa Mooddiyaa Med'inaa Godaw,","poem":1},{"text":"neeni taani hidootan naagiyaawaanne","poem":2},{"lineBreak":true},{"text":"ta yalagatetsaa wodiyaappe doommaade,","poem":2},{"lineBreak":true},{"text":"taani ammanettiyaawaa gidaadda.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani yelettiyaa wodiyaappe doommaade neenan zemppaad;","poem":1},{"text":"ta aatti uluwaappe wod'd'oodeppe doommaade,","poem":2},{"lineBreak":true},{"text":"neeni taana naagaadda.","poem":2},{"lineBreak":true},{"text":"Ubbaa gedekka ta galatay neessa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Neeni taw bak'ata attiyaa wolk'k'aama sa'aa gideedda diraw,","poem":1},{"text":"ta de'uu daro asaw leemiso gideedda.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gallassaa ubbaan ta doonay,","poem":1},{"text":"ne galataaninne ne bonchchuwaan kumeedda.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Taani c'imeedda wodiyaan taana oloppa;","poem":1},{"text":"ta wolk'k'ay is's'eedda wodiyaan taana aggoppa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ayaw gooppe, ta morkketuu ta bolla haasayiino,","poem":1},{"text":"Taana wod'anaw koyiyaawanttu","poem":2},{"lineBreak":true},{"text":"ittippe shiik'iide mak'ettiino.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Unttunttu, «S'oossay Aa aggeedda;","poem":1},{"text":"yederssiide Aa oyk'k'eetto.","poem":2},{"text":"Ayaw gooppe, Aa ashshanawe ooninne baawa» yaagiino.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Abeet S'oossaw, taappe neeni haakkoppa.","poem":1},{"lineBreak":true},{"text":"Abeet ta S'oossaw, taana maaddanaw elleella.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Taana mootiyaawanttu yeellatiide d'ayino.","poem":1},{"text":"Taana k'ohanaw koyiyaawanttu,","poem":2},{"lineBreak":true},{"text":"yeellaanne kawushshaa mayino.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Shin taana gidooppe,","poem":1},{"text":"ubbaa gede neena hidootan naagana.","poem":2},{"text":"Taani gujja gujjaade neena galatana.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Woyissentto likkiyaa erana d'ayooppekka,","poem":1},{"text":"ta doonay gallassaa ubbaan ne s'illotetsaabaanne","poem":2},{"lineBreak":true},{"text":"ashshiyaa ne oosuwaabaa odana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Taani Ubbaa Mooddiyaa Med'inaa Godaa wolk'k'an yaana;","poem":1},{"text":"ne s'alalay s'illo gidiyaawaa awaayana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abeet S'oossaw, neeni,","poem":1},{"text":"ta yalagatetsaappe doommaade taana tamaarissaadda.","poem":2},{"text":"Ha\"i gakkanaw taani ne malalissiyaa oosuwaabaa oday.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Abeet S'oossaw, ne wolk'k'aanne ne minotetsaa,","poem":1},{"text":"yiyaa yeletaa ubbaw odana gakkanaw,","poem":2},{"lineBreak":true},{"text":"taani c'imaade puulummooppekka taana aggoppa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Abeet S'oossaw, ne s'illotetsay,","poem":1},{"text":"bolla saluwaa gakkeedda.","poem":2},{"text":"Abeet wolk'k'aamabaa ootseedda S'oossaw,","poem":1},{"text":"ne mali ooninne baawa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Neeni ta bolla daro metuwaa ahaada;","poem":1},{"text":"gidooppenne, neeni ta de'uwaa zaaraadde ooras's'isana;","poem":2},{"lineBreak":true},{"text":"neeni taana biittaa gido c'iimmo olaa gelenaadan naagana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Neeni ta bonchchuwaa kasewaappe darissana;","poem":1},{"text":"neeni taana zaaretsaadekka mintsetsana.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Abeet ta S'oossaw, ne tumatetsaa diraw,","poem":1},{"text":"taani neena diitsaan galatana.","poem":2},{"text":"Abeet Israa'eeliyaa geeshshaw,","poem":1},{"text":"taani maasink'k'uwaan neena sabbana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Taani diis's'aade, nashshechchaw ta k'aalaa d'ok'k'u ootsaade yes's'ana;","poem":1},{"text":"neeni taana ashsheeda diraw, taani neena sabbana.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ta ins's'arssay ne s'illo oosuwaabaa ubbaa gallassi odana;","poem":1},{"text":"ayaw gooppe, taana k'ohanaw koyiyaawanttu,","poem":2},{"lineBreak":true},{"text":"yeellateeddinonne kawusheeddino.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}