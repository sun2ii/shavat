{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":72,"content":[{"type":"heading","content":["Kaatiyaw Shiik'o Woosaa"]},{"type":"hebrew_subtitle","content":["Solomona Yetsaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet S'oossaw, kaatii ne suuretetsan pirddanaadan,","poem":1},{"text":"neeni Aa tamaarissa;","poem":2},{"lineBreak":true},{"text":"nu kaatiyaw ne s'illotetsaa imma.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yaatooppe, I ne asaw s'illotetsan pirddo;","poem":1},{"text":"naak'etteeddawanttookka suuretetsaan daannato.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Deretuu sarotetsaa ayifiyaa,","poem":1},{"text":"zoozetuukka s'illotetsaa ayifiyaa ne asaw ayifino.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"He kaatii asaa giddon naak'etteeddawanttu diraw mootetto;","poem":1},{"text":"hiyyeesatuwaa I ashsho;","poem":2},{"lineBreak":true},{"text":"uk'k'unniyaawantta I mentsereetso.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Awaynne aginay de'iyaa wode ubbaan,","poem":1},{"text":"yeletaappe yeletaa gakkanaw, Asay aw yayiino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kaatii shoyk'an bukkiyaa iraanne","poem":1},{"text":"gadiyaa kalissiyaa iraa mala gido.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I de'iyaa laytsaa ubbaan s'illuu daashana;","poem":1},{"text":"aginay d'ayana gakkanaw sarotetsay darana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Abbaappe abbaa gakkanaw,","poem":1},{"text":"k'ay Efiraas'iisa Shaafaappe sa'aa gas'aa gakkanaw I mooddo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bazzuwaa asatuu aw hokkino;","poem":1},{"text":"Aa morkketuu baana laac'c'ino.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tarsseesanne haatsaan dooddetteedda biittaa kaatetuu,","poem":1},{"text":"aw giiraa giirino.","poem":2},{"text":"Sheebanne Saaba kaatetuu,","poem":1},{"text":"aw imotaa ayino.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kaatetu ubbay aw gulbbatino;","poem":1},{"text":"kawutetsatuu ubbay aw kiitettino.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Aa s'eesiyaa hiyyeesatuwaa, naak'etteeddawanttanne","poem":1},{"text":"maaddiyaawe bayinnawantta I ashshee.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hiyyeesatoonne mank'k'otoo I k'arettee;","poem":1},{"text":"hiyyeesatuwaa shemppuwaa ashshee.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Unttuntta naak'uwaappenne makkalaappe I wozee.","poem":1},{"text":"Unttunttu suutsay Aa sintsan al\"a.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kaatii shemppuwaa gam\"o;","poem":1},{"text":"Sheeba biittaa work'k'ay aw imetto.","poem":2},{"text":"Pac'c'ennan aw woosay woosetto;","poem":1},{"text":"gallassaa ubbaan I anjjetto.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Biittan daro katsay mokko;","poem":1},{"text":"deretuu katsaan kamettino.","poem":2},{"text":"Biittay Liibaanoose derii mokkiyaawaadan katsaa mokko;","poem":1},{"text":"maatay dembbaa kumiyaawaadan Asay katamaa kumo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kaatiyaa suntsay med'inaw de'o;","poem":1},{"text":"away de'eedda keeshshaa ubbaan s'eegettiidde, gam\"o.","poem":2},{"text":"Asay ubbay Aa baggana anjjettana;","poem":1},{"text":"kawutetsatuu ubbay Aa, «Anjjetta» yaagiide anjjana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Malalissiyaabaa barekka ootsiyaa Med'inaa Godaa S'oossaw,","poem":1},{"text":"Israa'eeliyaa S'oossaw galatay gido.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Aa bonchcho suntsay med'inaw galatetto;","poem":1},{"text":"Aa bonchchuu sa'aa ubbaa kumo.","poem":2},{"text":"Amen\"i. Amen\"i.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Issey na'aa Daawita woosay hawaan poletteedda.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}