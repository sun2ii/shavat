{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":73,"content":[{"type":"heading","content":["S'illo Pirddaa S'oonuwaa"]},{"type":"hebrew_subtitle","content":["Asaafa Yetsaa"]},{"type":"verse","number":1,"content":[{"text":"S'oossay Israa'eeliyaw tumuwaappe lo\"a;","poem":1},{"text":"wozanaa geeshshatoo I keeka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Shin taana gidooppe, ta gedii,","poem":1},{"text":"d'ubettanaw guutsaa atteedda;","poem":2},{"lineBreak":true},{"text":"ta gedii halis's'anaw mateedda.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ayaw gooppe, iita asatoo sarotetsay de'iyaawaa be'aade,","poem":1},{"text":"he otoranchchatuwaa duretetsaan taani k'anaataad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Unttunttoo tuggi baawa.","poem":1},{"text":"Unttunttu bollay pas's'anne mina.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Unttunttu hara Asay tuggatiyaawaadan tuggatikkino;","poem":1},{"text":"unttunttu hara asaawaadan metuwaan shoc'ettibeykkino.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hewaa diraw, unttunttu otoruwaa,","poem":1},{"text":"alleek'k'uwaadan k'ood'iyaan aatsiino;","poem":2},{"lineBreak":true},{"text":"makkalaa afilaadan mayiino.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Unttunttu wozanay iitabaa pulttee.","poem":1},{"text":"Unttunttu k'ofay iita halchchuwaa kumeedda.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Unttunttu k'iliic'iinonne iitabaa haasayiino;","poem":1},{"text":"unttunttu barenttu otoruwaan,","poem":2},{"lineBreak":true},{"text":"haratuwaa un\"etsanaw naassiino.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Unttunttu saluwaan de'iyaa S'oossaa,","poem":1},{"text":"barenttu doonaan c'ashiino.","poem":2},{"text":"Sa'aan de'iyaa asaa bollakka,","poem":1},{"text":"barenttu ins's'arssan otoruwaa haasayiino.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Haray atto, S'oossaa asaykka unttunttukko simmana;","poem":1},{"text":"unttunttu odiyaawaakka elle ammanana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Unttunttu, «S'oossay nubaa ayinne erenna;","poem":1},{"lineBreak":true},{"text":"Ubbaappe D'ok'k'iyaa S'oossay ayinne be'enna» yaagiino.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Simmi iitatuu hawaa mala;","poem":1},{"text":"Unttunttu ubbaa gedekka injjetina de'iino;","poem":2},{"lineBreak":true},{"text":"unttunttu gujji gujji duretiino.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yaatooppe, taani ta wozanaa geeshsha ootseeddawenne","poem":1},{"text":"taani ta s'illotetsaa bessanaw,","poem":2},{"lineBreak":true},{"text":"ta kushiyaa meec'etteeddawe tumuwaappe mela.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Gallassaa kumentsan taani metuwaan shoc'ettaad;","poem":1},{"text":"wonttan wonttan murettaad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Taani iitatuwaadan, unttunttu giyaawaa geeddentto,","poem":1},{"text":"taani ne asaw ammanettennawaa gidana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Taani ha ubbaa yewuwaa eranaw k'oppiyaa wode,","poem":1},{"text":"taw erettenna dees'obaa gideedda.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Shin taani S'oossaa geeshsha sa'aa geleedda wode,","poem":1},{"text":"iitatuwaa wurssetsa kaac'aa akeekaad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Unttuntta neeni tumuwaappe halis's'iyaa sa'aan utissaasa;","poem":1},{"text":"neeni unttuntta kunddissaasanne bayzzaasa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Unttunttu akeekenan d'ayeeddino;","poem":1},{"text":"dagamaan ittuu attenan mule wureeddino.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Itti Asay beegottiyaa wode,","poem":1},{"text":"I akumuwaan be'eeddabay dogettiyaawaadan,","poem":2},{"lineBreak":true},{"text":"abeet Godaw, neeni denddiyaa wode,","poem":2},{"lineBreak":true},{"text":"unttunttu dogetana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Taani yiloteedda wodenne","poem":1},{"text":"ta wozanaan seeletteedda wode,","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ayinne akeekenan donc'c'illaad;","poem":2},{"lineBreak":true},{"text":"taani ne sintsan miizza mala gidaaddi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Shin taani ubbaa gedekka neenana de'ay;","poem":1},{"text":"ta ushechcha kushiyaa neeni oyk'k'aadda.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ne zoriyaan taana kaaletsaasa;","poem":1},{"text":"hewaappe guyyiyaan neeni taana bonchchoo afana.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Taw saluwaan neeppe attina,","poem":1},{"text":"haray ooni de'ii?","poem":2},{"text":"Taani neeppe attina,","poem":1},{"text":"sa'aan harabaa ayaanne amottikke.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ta wolk'k'aynne ta wozanay daaburanaw danddayee;","poem":1},{"text":"shin S'oossay ta wozanaa minisiyaawaanne,","poem":2},{"lineBreak":true},{"text":"med'inaw taana gakkeedda saamaa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Neeppe haakkiyaawanttu d'ayana;","poem":1},{"text":"neena amanetenawantta ubbaa neeni wurssana.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Shin taana gidooppe,","poem":1},{"text":"taani S'oossaa matan de'iyaawe taw lo\"a.","poem":2},{"text":"Taani Ubbaa Mooddiyaa Med'inaa Godaa,","poem":1},{"text":"taw bak'ata attiyaa sa'aa ootsaad.","poem":2},{"text":"Hewaa diraw, Aa oosuwaa ubbaa taani odana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}