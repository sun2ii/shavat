{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":74,"content":[{"type":"heading","content":["Gadii La\"a Kesanaadan Shiik'o Woosaa"]},{"type":"hebrew_subtitle","content":["Aasaafi Akeekaan S'aafeedda Timirttiyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet S'oossaw, neeni nuuna med'inaw ayaw aggaadii?","poem":1},{"text":"Ne hank'k'uu ne k'ooruwaan de'iyaa dorssatuwaa bolla,","poem":2},{"lineBreak":true},{"text":"ayaw suulleedee?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neeni beni dooreedda asaa, neeni","poem":1},{"text":"new buzo ootsaade wozeedda zaratuwaa hassaya.","poem":2},{"text":"Neeni de'eedda S'iyoone deriyaa k'oppa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ane ne Geeshsha Gollii koleteedda sa'aa yaade s'eella.","poem":1},{"text":"Morkketuu aani de'iyaabaa ubbaa d'aysseeddino.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne morkketuu ne Geeshsha Golliyaa giddon,","poem":1},{"text":"«Nuuni s'ooneeddo» yaagiide gereereeddino.","poem":2},{"text":"S'oonuwaa malaataa yaagiide, barenttu banddiraa esseeddino.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Unttunttu mitsaa k'ans's'anaw barenttu kalttaa,","poem":1},{"text":"d'ok'k'u ootsiide, ek'k'eedda asatuwaadan haneeddino.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Unttunttu masetteedda sank'k'aa ubbaa,","poem":1},{"text":"barenttu kalttaaninne madooshaaninne mentsi yeggeeddino.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Geeshsha Golliyaa taman s'uuggiide d'ayisseeddino;","poem":1},{"text":"new goyinniyaa sa'aa tunisseeddino.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Barenttu wozanaan, «Unttuntta nuuni,","poem":1},{"text":"ubbaanna d'ayssana» yaagiide k'oppeeddino.","poem":2},{"text":"Biittan Asay S'oossaw goyinniyaa sa'aa ubbaa taman s'uuggeeddino.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"He wode mallay nuw imettennan is's'eedda;","poem":1},{"text":"timbbitiyaa odiyaawe ittuunne baawa.","poem":2},{"text":"Hawaadan haniide, woyissa wodiyaa de'anentto,","poem":1},{"text":"eriyaa Asay nu giddon ittuunne baawa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abeet S'oossaw, ne morkketuu,","poem":1},{"text":"woyissa wodiyaa ne bolla k'iliic'anee?","poem":2},{"text":"Unttunttu ne suntsaa med'inaw borannee?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ne kushiyaa shiishsha akkaade ayaw gam\"ay?","poem":1},{"text":"Ne ushechcha kushiyaa ne k'umayuwaappe kessaade unttuntta d'ayssa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Gidooppenne, abeet S'oossaw,","poem":1},{"text":"neeni benippekka ta kaatiyaa;","poem":2},{"lineBreak":true},{"text":"neeni biittaa bolla atotetsaa ahaada.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ne wolk'k'aama wolk'k'aan neeni abbaa shaakkaadda;","poem":1},{"text":"Aa giddon de'iyaa dawiyaa huup'iyaa neeni k'os's'aadda.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Leewaataana giyaa dawiyaa huup'iyaa k'os's'aade,","poem":1},{"text":"Aa ashuwaa bazzuwaan de'iyaa med'etatoo,","poem":2},{"lineBreak":true},{"text":"k'uma ootsaade immeeddawe neena.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Neeni pulttotuwaa dooyaa yeddaadda;","poem":1},{"text":"ubbaa gede goggiyaa shaafatuwaa k'ay melissaadda.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Gallassay newaa; k'ammaykka newaa;","poem":1},{"text":"k'ay awaanne aginaa unttunttu sa'aan wotseeddawe neena.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Biittaw zawaa wotseeddawe,","poem":1},{"text":"balgguwaanne boniyaa med'eeddawe neena.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Shin abeet Med'inaa Godaw, ne morkketuu,","poem":1},{"text":"neena wooti k'iliic'eeddinontto,","poem":2},{"lineBreak":true},{"text":"booza asatuu ne suntsaa wooti boreeddinontto hassaya.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"New moodettiyaawanttu shemppuwaa","poem":1},{"text":"iita morkketoo aatsaade immoppa.","poem":2},{"text":"Metootanchchatuwaa med'inaw dogoppa.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nu biittan de'iyaa d'uma sa'ay ubbay,","poem":1},{"text":"makkalanchchatuwaan kumeedda diraw,","poem":2},{"lineBreak":true},{"text":"neeni nuw c'aak'k'eedda c'aak'uwaa k'oppa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Naak'etteeddawantta yeellayoppa;","poem":1},{"text":"hiyyeesatuunne metootanchchatuu ne suntsaa galatino.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Abeet S'oossaw, dendda; ne yewuwaa mootetta.","poem":1},{"text":"Gezo asatuu gallassaa ubbaan,","poem":2},{"lineBreak":true},{"text":"ne bolla k'iliic'eeddawaa hassaya.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ne morkketuu ne bolla waassiyaa waasuwaanne","poem":1},{"text":"neena is's'iyaawanttu,","poem":2},{"lineBreak":true},{"text":"pac'i bayinnan k'iliic'iyaa k'iliic'uwaa dogoppa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":23}