{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":75,"content":[{"type":"heading","content":["S'oossay Pirddiyaawaa Gidussaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Aasaafi. «D'ayssoppa» Geetettiyaa Diitsaa waatsan Yes's'eedda Yetsaa."]},{"type":"verse","number":1,"content":[{"text":"New galataa immeeto; abeet S'oossaw, neena galateetto;","poem":1},{"text":"«Ne suntsay woggaa» giide awaayeetonne,","poem":2},{"lineBreak":true},{"text":"malalissiyaa ne oosuwaa ubbaa odeetto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"S'oossay, «Dooraade keereedda gallassi,","poem":1},{"text":"suure pirddaa pirddanawe taana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sa'aynne an de'iyaawanttu ubbay k'aas's'inakka,","poem":1},{"text":"Aa tuusaa minisa essiyaawe taana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taani otoranchchatuwaa, Otorettoppite yaagay;","poem":1},{"text":"iitatuwaakka, Hintte kac'iyaa dentsoppite.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hintte kac'iyaa d'ok'k'issi bessoppite;","poem":1},{"text":"zaatturiide haasayoppite yaagay» yaagee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bonchchuu away doliyaasaappe","poem":1},{"text":"woy wulliyaasaappe","poem":2},{"lineBreak":true},{"text":"woy bazzuwaappe yeenna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Shin pirddiyaawe S'oossaa;","poem":1},{"text":"I ittuwaa bolla pirddee;","poem":2},{"lineBreak":true},{"text":"ittuwaa shatintsee.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Med'inaa Godaa kushiyan itti wanc'c'ay de'ee;","poem":1},{"text":"he wanc'c'ay S'oossaa hank'k'uwaa woyniyaa eessan kumi utteedda.","poem":2},{"text":"I hewaappe ushshaa tigina,","poem":1},{"text":"sa'aan de'iyaa iita asatuu hewaa ushana;","poem":2},{"lineBreak":true},{"text":"unttunttu orc'c'uwaakka ashshenan c'inggisiide ushana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Shin taani Yaak'ooba S'oossaabaa odananne","poem":1},{"text":"med'inaw Aa sabbana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"I iita asatuwaa kac'iyaa ubbaa mentsana,","poem":1},{"text":"shin s'illotuwaa kac'ii d'ok'k'u d'ok'k'u gaana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}