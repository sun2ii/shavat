{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":76,"content":[{"type":"heading","content":["S'oossaa S'oonuwaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Diitsaa Waatsan Yes'etteedda, Asaafa mazamuriyaa"]},{"type":"verse","number":1,"content":[{"text":"S'oossay Yihudaan eretteeddawaa;","poem":1},{"text":"Aa suntsay Israa'eeliyaan wolk'k'aama.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Aa dunkkaanii Saleemana;","poem":1},{"text":"I de'iyaasay S'iyoonena.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"I, hewan s'onggettiyaa,","poem":1},{"text":"morkkatuwaa wonddaafiyaa c'ubiyaa, gonddalliyaa, mashshaanne","poem":2},{"lineBreak":true},{"text":"hara olaa miishshatuwaa mentsereetseedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Abeet S'oossaw, ne bonchchuu ay keeshshaa gitee!","poem":1},{"text":"Neeni ne morkkatuwaa s'oonaade,","poem":2},{"lineBreak":true},{"text":"deriyaappe simmiyaa wode,","poem":2},{"lineBreak":true},{"text":"ne anggay ayiba yashshiyaawe!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gooba tooranchchatuu,","poem":1},{"text":"barenttoo de'iyaawaa ubbaa bonk'k'etti kichcheeddino.","poem":2},{"text":"Ha\"i simmi unttunttu,","poem":1},{"text":"wolk'k'aama gem\"ishshuwaa gem\"isheeddino;","poem":2},{"lineBreak":true},{"text":"unttunttuppe ittuunne bare kushiyaa dentsibeenna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Abeet Yaak'ooba S'oossaw, neeni seereedda wode,","poem":1},{"text":"paraa asatuunne paratuu kunddo saan atteeddino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Shin abeet S'oossaw, neeni yashshaasa!","poem":1},{"text":"Ne hank'k'uu suulleedda wode,","poem":2},{"lineBreak":true},{"text":"ne sintsan oonee ek'k'anawe?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Neeni pirddaa saluwaappe sisseedda wode,","poem":1},{"text":"sa'aan de'iyaa Asay yayyiide, c'o\"u geedda.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neeni sa'aan k'ohetteeddawantta ashshanaw,","poem":1},{"text":"pirddaw denddeedda wode, hewe haneedda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Asaa hank'k'uu dareedda keeshshaa neeni galatettaasa.","poem":1},{"text":"Olaappe atteedda asatuu ubbay,","poem":2},{"lineBreak":true},{"text":"ne baalaa gallassatuwaa bonchchana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Med'inaa Godaw, hintte S'oossaw,","poem":1},{"text":"shiik'ettite, hewaakka gatsite.","poem":2},{"text":"Hinttenoo shooro kawutetsatoo,","poem":1},{"text":"yayettanaw bessiyaawoo immotaa ahite.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"I kaappotuwaa otoruwaa kawushshee;","poem":1},{"text":"wolk'k'aama kaatetuwaakka I yashissee.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}