{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":77,"content":[{"type":"heading","content":["Mintsetsuwaa Woosaa"]},{"type":"hebrew_subtitle","content":["Aasaafi Zammaaretuwaa Kaappoo Juddutoo Yes's'eedda, mazamuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Taani S'oossaw magannay;","poem":1},{"text":"taana siso gaade taani S'oossaa woossay.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taani ta metuwaa gallassi Godaa koyay.","poem":1},{"text":"K'amman taani shemppennan ta kushetuwaa aakko mic'c'ay;","poem":2},{"lineBreak":true},{"text":"gidooppenne, taani minettanaw danddaykke.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taani S'oossaabaa k'oppiyaa wode, oolay;","poem":1},{"text":"taani aabaa yuushsha k'oppiyaa wode,","poem":2},{"lineBreak":true},{"text":"ta shemppuu daaburee.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Neeni k'amma ubbaa taana gem\"ishshuwaa diggaade ahissaasa.","poem":1},{"text":"Taani loytsa hirggiyaa diraw,","poem":2},{"lineBreak":true},{"text":"haasayanaw danddaykke.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Taani aad'd'eedda gallassatuwaa k'oppay;","poem":1},{"text":"kase laytsatuwaakka hassayay.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani k'ofaa sheekkaade ak'ay;","poem":1},{"text":"ta wozanay yuushshi k'oppiyaa wode,","poem":2},{"text":"Taani ta huup'iyaa hawaadan yaagaade oochchay;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"«Goday nuuna med'inaw aggi bashanee?","poem":1},{"text":"Zaaretsiide I nuuna keekaa bessennee?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Aa siik'uu atteedee?","poem":1},{"text":"I geeddawe hawaappe sintsanaw sa'aan ootsenee?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"S'oossay maariyaawaa dogeeddee?","poem":1},{"text":"Bare k'aretaakka hank'k'uwaan laammeedee?» yaagaade oochchay.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"K'aykka taani, «Taana k'oheeddawe,","poem":1},{"text":"Ubbaappe D'ok'k'iyaa S'oossaa ushechcha kushii,","poem":2},{"lineBreak":true},{"text":"kaseppe maaddiyaa maaduwaa aggeedawaa» yaagay.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Med'inaa Godaw, ne oosotuwaa taani k'oppana.","poem":1},{"text":"Ee; neeni beni wode,","poem":2},{"lineBreak":true},{"text":"ootseedda malalissiyaabatuwaa ubbaa taani hassayana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne ootseeddawaa ubbaa,","poem":1},{"text":"taani zaara zaaraadde k'oppana;","poem":2},{"lineBreak":true},{"text":"ne wolk'k'aama oosotuwaa ubbaa taani yuushsha k'oppana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Abeet S'oossaw, ne ogii geeshsha;","poem":1},{"text":"ay s'oossinne nu S'oossaa mala wolk'k'aama gidenna.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Neeni malalissiyaabaa ootsiyaa S'oossaa.","poem":1},{"text":"Asaa giddon ne wolk'k'aa k'onc'c'issiyaawaa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ne asaa, Yaak'oobanne Yooseefo zeretsatuwaa,","poem":1},{"text":"ne k'esiyaan wozaadda.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abeet S'oossaw, haatsatuu neena be'eeddino;","poem":1},{"text":"haatsatuu neena be'iide yayyeeddino.","poem":2},{"text":"Abbaa c'iimmatuukka kokkoreeddino.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Shaaretuu iraa duge zaariide tigeeddino;","poem":1},{"text":"guuguntsay saluwaan guummeedda.","poem":2},{"text":"Ne walk'k'antsay yaan haan walk'k'ammeedda.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ne guuguntsay guntsay gotiyaa giddon kooshummeedda;","poem":1},{"text":"ne walk'k'antsaa p'ooletsay sa'aa poo'isseedda.","poem":2},{"text":"Biittaykka gaji gajiide kokkoreedda.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Neeni abbaa gidduwaana hamettaasa;","poem":1},{"text":"c'iimmo abbaa gidduwaana aad'aassa;","poem":2},{"lineBreak":true},{"text":"gidooppenne, ne gedii yed'd'eedda sa'ay beettena.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Musenne Aaroona kushiyan","poem":1},{"text":"neeni ne asaa dorssaa wudiyaadan kaaletsaadda.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}