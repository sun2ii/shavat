{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":78,"content":[{"type":"heading","content":["S'oossaanne Aa Asaa"]},{"type":"hebrew_subtitle","content":["Aasaafi Akeekaan S'aafeedda Timirttiyaa"]},{"type":"verse","number":1,"content":[{"text":"Ta asaw, taani hinttena tamaarissiyaawaa sisite;","poem":1},{"text":"ta doonaappe kesiyaa k'aalaa hayzzite.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taani unttunttoo haasayiyaa wode,","poem":1},{"text":"leemisuwaan haasayay;","poem":2},{"lineBreak":true},{"text":"beniideppe geemmeedda yewotuwaa k'onc'c'issana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nuuni siseeddanne ereedda yewotuwaa,","poem":1},{"text":"k'ay nu aawotuu nuw odeedda yewotuwaa haasayana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"He yewotuwaa nuuni unttunttu naanatuwaappe k'osokko;","poem":1},{"text":"Med'inaa Godaw bessiyaa galataa,","poem":2},{"text":"Aa wolk'k'aanne malalissiyaa Aa oosuwaa,","poem":1},{"text":"yiyaa yeletawukka nuuni odana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"I Yaak'ooba zaretoo azazuwaa,","poem":1},{"text":"Israa'eeliyaa asaw higgiyaa immeedda.","poem":2},{"text":"Kase nu aawotuu barenttu naanatuwaa,","poem":1},{"text":"he higgetuwaa tamaarissana mala azazeedda.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hewenne, kaalliyaa yeletay,","poem":1},{"text":"he biro yelettana naanatuu eranaadaananne","poem":2},{"lineBreak":true},{"text":"unttunttukka barenttu naanaatoo odanaadaana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yaatina, he naanatuu S'oossan amanetanaadan;","poem":1},{"text":"I ootseeddabaakka dogennaaddaaninne","poem":2},{"text":"Aa azazuwaa naaganaadaana.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Unttunttu kase barenttu aawotuwaadan wozana muumenne","poem":1},{"text":"makkalanchcha asaa gidennaaddaaninne","poem":2},{"text":"S'oossan ek'k'ennanne ammanettena yeletaa gidenaaddaana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Efireema asatuu, olaw,","poem":1},{"text":"wonddaafiyaanna pootsaa giigissiide,","poem":2},{"lineBreak":true},{"text":"olaa gallassi guyye simmeeddino.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Unttunttu S'oossaa c'aak'uwaa naagibeykkino;","poem":1},{"text":"Aa higgiyaadan hamettennan is's'eeddino.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Unttunttu I ootseedda wolk'k'aama oosuwaanne","poem":1},{"text":"unttuntta I besseedda malaataa dogeeddino.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"I unttunttu aawotuwaa sintsan Gibs'e biittan,","poem":1},{"text":"S'o'aane Dembban malaataa ootseedda.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Abbaa shaakkiide, gidduwaana unttuntta pintseedda;","poem":1},{"text":"I haatsaa shaakkiide,","poem":2},{"lineBreak":true},{"text":"yaanne haanne shaakkiide godaadan esseedda.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"I unttuntta gallassi shaariyaan,","poem":1},{"text":"k'amma tamaa poo'uwaan kaaletseedda.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"I bazzuwaan zaallaa p'alk'k'iide,","poem":1},{"text":"c'iimmuwaappe daro haatsaa unttuntta ushsheedda.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Zaallaappe haatsaa pulttissiide,","poem":1},{"text":"shaafaadan duge gogisseedda.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Shin unttunttu Aa bolla nagaraa oosuwaa gede gujjeeddino;","poem":1},{"text":"Ubbaappe D'ok'k'iyaa S'oossaa bolla,","poem":2},{"lineBreak":true},{"text":"bazzuwaan makkaleeddino.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Barenttu amotteedda k'umaa oochchiyaawan","poem":1},{"text":"S'oossaa eriidde paac'c'eeddino.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Unttunttu S'oossaa bolla hawaadan yaagiide haasayeeddino;","poem":1},{"text":"«Bazzuwaan S'oossay nuw k'umaa aatsanaw danddayii?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Zaallaa shoc'ina, pulttuu kesiide,","poem":1},{"text":"shaafay goggeedda;","poem":2},{"lineBreak":true},{"text":"shin ukitsaa I nuw immanaw danddayii?","poem":2},{"lineBreak":true},{"text":"Woy bare asaw ashuwaa immanaw danddayii?» yaageeddino.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Med'inaa Goday hewaa siseedda wode,","poem":1},{"text":"unttunttu bolla daro hank'k'etteedda.","poem":2},{"text":"Yaak'ooba zaratuwaa bolla tamay ees's'eedda;","poem":1},{"text":"Israa'eeliyaa bolla Aa hank'k'uu dari dari beedda.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ayaw gooppe, unttunttu S'oossan ammanibeykkino;","poem":1},{"text":"woy I ashshiyaawaan ammanettibeykkino.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Gidooppenne, I bolla saluwaa azaziide,","poem":1},{"text":"saluwaa penggiyaa dooyeedda.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Unttunttu maanaw, unttunttoo mannaa bukisseedda;","poem":1},{"text":"saluwaa k'umaa unttunttoo immeedda.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kiitanchchatuwaa ukitsaa Asay meedda;","poem":1},{"text":"S'oossay unttunttoo k'umaa darissiide immeedda.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Away doliyaa bagga c'arkkuu c'arkkanaadan ootseedda;","poem":1},{"text":"bare wolk'k'an gedissa bagga c'arkkuwaa dentsetseedda.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"I asaw ashuwaa baanaa keeshshaa kiitteedda;","poem":1},{"text":"paalliyaa kafotuwaa abbaa doonaa shafiyaa keeshshaa bukisseedda.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Unttunttu de'iyaa saan,","poem":1},{"text":"dunkkaaniyaa yuushshuwaan wod'd'eeddino.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Unttunttu amotteeddawaa unttunttoo immeedda;","poem":1},{"text":"unttunttu miide, barenttu ganjjiyaa kuntseeddino.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Shin unttunttu barenttu amotteedda ashuwaa kallennan de'ishiin,","poem":1},{"text":"ashuu unttunttoo biro doonaan de'ishiin,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"S'oossaa hank'k'uu unttunttu bolla wod'd'eedda;","poem":1},{"text":"unttunttu giddoppe mino asatuwaanne","poem":2},{"lineBreak":true},{"text":"Israa'eeliyaappe yalaga asatuwaa wod'eedda.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Hawe ubbay haninakka,","poem":1},{"text":"unttunttu nagaraa ootsiyaawaa aggibeykkino.","poem":2},{"text":"Bare malaataa ubbaa ootsinakka, ammanibeykkino.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Hewaa diraw, I unttunttu gallassatuwaa c'arkkuwaadan,","poem":1},{"text":"unttunttu laytsatuwaakka akeekenan d'ayisseedda.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"S'oossay unttunttuppe wod'iyaa wode,","poem":1},{"text":"atteedawanttu nagaraa paas'iide,","poem":2},{"lineBreak":true},{"text":"S'oossaa mintsi koyeeddino.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Unttunttu S'oossay unttunttoo zaallaa gideeddawaanne","poem":1},{"text":"Ubbaappe D'ok'k'iyaa S'oossay,","poem":2},{"lineBreak":true},{"text":"unttuntta woziyaawaa gideeddawaa hassayeeddino.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Shin unttunttu barenttu ins's'arssan aw worddotiide,","poem":1},{"text":"barenttu doonaan c'immeeddino.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Unttunttu wozanay S'oossan ek'k'enna;","poem":1},{"text":"I unttunttunna c'aak'k'eteedda c'aak'uwaa ammanettikkino.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Shin I unttuntta maariyaawe;","poem":1},{"text":"unttunttu iitatetsaa atto geedda.","poem":2},{"text":"Unttuntta d'ayissibeenna; daro gede bare hank'k'uwaa te\"eedda;","poem":1},{"text":"bare hank'k'uwaa uullaa ubbaanna unttunttu bolla yeddibeenna.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Ayaw gooppe, unttunttu ashuwaa s'alala gidiyaawaanne","poem":1},{"text":"yaa c'arkkeeddasaappe haa simmenna,","poem":2},{"lineBreak":true},{"text":"c'arkkuwaa mala gidiyaawaa hassayeedda.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Unttunttu bazzuwaan Aa bolla aappu gede makkaleeddinoo!","poem":1},{"text":"Mela bazzuwaan aappu gede lanc'c'isseeddino!","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Unttunttu zaari zaariide, S'oossaa paac'c'eeddino;","poem":1},{"text":"Israa'eeliyaa Geeshshaa hank'k'etseeddino.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Unttunttu Aa wolk'k'aabaa dogeeddino;","poem":1},{"text":"I unttunttu morkkatuwaappe wozeedda gallassaa,","poem":2}]},{"type":"verse","number":43,"content":[{"text":"I Gibs'e biittan malaataa,","poem":1},{"text":"S'o'aane Dembban malalissiyaabaa,","poem":2},{"lineBreak":true},{"text":"ootseedda wodiyaa hassayibeykkino.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Unttunttu shaafaa haatsatuwaa suutsaw laammeedda;","poem":1},{"text":"hewaa diraw, Gibs'e asatuu,","poem":2},{"lineBreak":true},{"text":"he shaafatuwaappe ushanaw danddayibeykkino.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Unttuntta waayissiyaa uduns's'etuwaanne","poem":1},{"text":"unttunttu biittaa bayzziyaa shed'd'atuwaa kiitteedda.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Unttunttoo doleedda katsaa gonddoo,","poem":1},{"text":"unttunttu ootsiide daabureeddawaa booliyaw immeedda.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Unttunttu woyniyaa turaa shachchan,","poem":1},{"text":"unttunttu balasiyaa giyaa mitsaakka c'arkkuwaan d'ayisseedda.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Unttunttu miizzatuwaa shachchan wod'eedda;","poem":1},{"text":"unttunttu dorssaa wudiyaa,","poem":2},{"lineBreak":true},{"text":"d'uuk'k'iyaa walk'k'antsan mereessi wursseedda.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Unttunttu bolla bare suulliyaa hank'k'uwaa,","poem":1},{"text":"lanc'c'iyaanne is'uwaa,","poem":2},{"lineBreak":true},{"text":"bayzziyaa kiitanchchatuwaa c'uguwan yeddeedda.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Bare hank'k'uwaa aatsi yeddeedda.","poem":1},{"text":"Unttuntta iita harggiyaw aatsiide immeeddappe attina,","poem":2},{"lineBreak":true},{"text":"hayk'k'uwaappe ashshibeenna.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Gibs'en yeletteedda bayira naanatuwaa ubbaa wod'eedda.","poem":1},{"text":"Kaama dunkkaaniyaan de'iyaa koyro naanatuwaa ubbaa wursseedda.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Shin I bare asaa dorssaadan kesseedda;","poem":1},{"text":"wudiyaadan bazzuwaan heemmeedda.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"I unttuntta saruwaan kaaletseedda;","poem":1},{"text":"hewaa diraw, unttunttu yayyibeykkino;","poem":2},{"lineBreak":true},{"text":"shin unttunttu morkkatuwaa abbay muukkeedda.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Yaatiide I unttuntta bare geeshsha biittaa,","poem":1},{"text":"bare ushechcha kushiyan s'ooneedda deriyaa aheedda.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"I unttunttu sintsaappe kawutetsatuwaa laaggiide,","poem":1},{"text":"unttunttu biittaa shaakkiide,","poem":2},{"text":"Israa'eeliyaa zaretoo gisheedda.","poem":1},{"text":"Bare asaa unttunttu golliyaan wotseedda.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Gidooppenne, Ubbaappe D'ok'k'iyaa S'oossaa bolla makkaliide,","poem":1},{"text":"Aa paac'c'eeddino.","poem":2},{"text":"Aa azazuwaakka naagibeykkino.","poem":1}]},{"type":"verse","number":57,"content":[{"lineBreak":true},{"text":"Unttunttu barenttu aawotuwaadan,","poem":1},{"text":"makkalanchchatuwaanne kaddanchchatuwaa gideeddino.","poem":2},{"text":"Geella tooraadan wora wod'd'eeddino.","poem":1}]},{"type":"verse","number":58,"content":[{"lineBreak":true},{"text":"Unttunttu barenttu goyinniyaa d'ok'k'a sa'atuwaan Aa yiloyeeddino;","poem":1},{"text":"barenttu eek'atuwaan Aa k'anaatisseeddino.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Yaatina, S'oossay hawaa sisiide hank'k'etteedda;","poem":1},{"text":"Israa'eeliyaa mulekka kad'eedda.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Seelon I de'eedda sa'aa,","poem":1},{"text":"asaa giddon I de'eedda bare dunkkaaniyaa aggeeda.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"S'oossaa wolk'k'awunne bonchchoo, malaataa gideedda,","poem":1},{"text":"Taabootaa morkkatuwaa kushiyan aatsiide omoodisseedda.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"I bare asaw hank'k'etteedda;","poem":1},{"text":"I unttuntta mashshaw aatsiide immeedda.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Unttunttu wodallatuu ubbay olan hayk'k'eeddino;","poem":1},{"text":"yaatina, unttunttu wodorotuu asinaa gelennaan atteeddino.","poem":2}]},{"type":"verse","number":64,"content":[{"text":"Unttunttu k'eesatuu mashshaan wureeddino.","poem":1},{"text":"Gidooppenne, unttunttu machchetuu,","poem":2},{"lineBreak":true},{"text":"barenttu asinatoo yeekkenaadan digetteeddino.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Hewaappe guyyiyaan, Goday gem\"ishuwaappe","poem":1},{"text":"woy woyniyaa eessaa matsuwaappe beegottiyaa asaadan beegotteedda.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"I bare morkkatuwaa guyye zaariide shoc'eedda;","poem":1},{"text":"unttuntta med'inaw yeellayeedda.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"Yooseefo dunkkaaniyaa kad'eedda;","poem":1},{"text":"Efireema zariyaa dooribeenna.","poem":2}]},{"type":"verse","number":68,"content":[{"text":"Shin I Yihudaa zariyaanne","poem":1},{"text":"siik'iyaa S'iyoone deriyaa dooreedda.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"Hewan I bare Geeshsha Golliyaa saluwaadan d'ok'k'an kees's'eedda;","poem":1},{"text":"sa'aadan med'inaw esseedda.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"Bare k'oomaa Daawita dooriide,","poem":1},{"text":"dorssaa wudiyaa heemmiyaa saappe akkeedda.","poem":2}]},{"type":"verse","number":71,"content":[{"text":"Dorssaa heemmishin, bare asaa Yaak'ooba,","poem":1},{"text":"bare buzuwaa Israa'eeliyaa hentsanaw akkiide aheedda.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"Yaatina, Daawite unttuntta suure wozanaappe heemmeedda;","poem":1},{"text":"k'ay bare hiillaa kushiyan kaaletseedda.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/78.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/79.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/77.json","previousChapterAudioLinks":{},"numberOfVerses":72}