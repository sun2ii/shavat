{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":79,"content":[{"type":"heading","content":["Gadiyaa La\"atetsaw Shiik'eedda Woosaa"]},{"type":"hebrew_subtitle","content":["Asaafa mazamuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet S'oossaw, Ayhuda gidena asatuu ne biittaa bolla laateeddino.","poem":1},{"text":"Ne Geeshsha Golliyaa tunisseeddino;","poem":2},{"lineBreak":true},{"text":"Yerusaalame kolereetseeddino.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Unttunttu ne k'oomatuwaa anhaa,","poem":1},{"text":"saluwaa kafoo k'uma ootsiide, immeeddino.","poem":2},{"text":"K'ay ne geeshshatuwaa ashuwaa sa'aa do'atoo immeeddino.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Unttunttu suutsaa Yerusaalame yuushshuwaan,","poem":1},{"text":"haatsaadan gusseeddino;","poem":2},{"lineBreak":true},{"text":"unttunttu anhaa moogiyaawe d'ayeedda.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nu shoorotoo nuuni shek'k'iyaawaa gideeddo;","poem":1},{"text":"nu heeraan de'iyaawanttu,","poem":2},{"lineBreak":true},{"text":"miic'c'iyaawaanne k'id'iyaawaa gideeddo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abeet Med'inaa Godaw, hawe awude gakkanaw hananee?","poem":1},{"text":"Neeni med'inaw hank'k'ettay?","poem":2},{"text":"Ne k'anaatiyaa hank'k'uu tamaadan ees's'anee?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Neena erenna asatuwaa bollanne","poem":1},{"text":"ne suntsaa s'eesenna kawutetsatuwaa bolla ne hank'k'uwaa gussa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ayaw gooppe, unttunttu Yaak'ooba zeretsatuwaa wod'eeddinonne","poem":1},{"text":"unttunttu de'iyaasaa bayzzeeddino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kase nu aawotuwaa iitatetsaa nu bolla paydoppa.","poem":1},{"text":"Ellekka ne maarotaa nuw kiitta;","poem":2},{"lineBreak":true},{"text":"ayaw gooppe, nuuni loytsi metooteeddo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abeet nuuna ashshiyaa S'oossaw,","poem":1},{"text":"ne suntsaa bonchchuwaa diraw, nuuna maadda.","poem":2},{"text":"Ne suntsaa diraw, nuuna ashsha;","poem":1},{"text":"nu nagaraa atto yaaga.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Asatuu ayaw, «Unttunttu S'oossay hak'an de'ii?» yaaganee?","poem":1},{"text":"Ne k'oomatuwaa suutsaa unttunttu gusseeddawaa haluwaa,","poem":2},{"lineBreak":true},{"text":"neeni kessiyaawaa nuuni s'eellishin,","poem":2},{"lineBreak":true},{"text":"unttunttu gidduwaan k'onc'c'issa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"K'ashetteedda asatuwaa oolii ne sintsa gakko.","poem":1},{"text":"Hayk'oo pirddetteeddawantta ne wolk'k'aa gitatetsaadan ashsha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abeet S'oossaw, nu shooro kawutetsatuu neena boreeddawaa,","poem":1},{"text":"haluwaa laappun kushiyaa unttunttu kiwuwaan idintsa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"He wode nuuni ne asatuu, ne wudiyaa dorssatuu,","poem":1},{"text":"med'inaw galataa new immana;","poem":2},{"lineBreak":true},{"text":"yeletaappe yeletaa gakkanaw neena zaari zaariide galatana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}