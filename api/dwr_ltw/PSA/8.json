{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":8,"content":[{"type":"heading","content":["S'oossaa Anggay Med'etaa Bollan"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Suusullatuwaan Yes'etteedda, Daawita Mazimuriyaa."]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, nu S'oossaw,","poem":1},{"text":"ne suntsay sa'aa ubbaa bollan ayaa bonchchetteeddeeshsha!","poem":2},{"lineBreak":true},{"text":"Neeni ne bonchchuwaa salotuwaappe bollan","poem":1},{"text":"d'ok'k'u d'ok'k'u ootsa wotsaadda.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neeni ne morkkatuwaa diraw,","poem":1},{"text":"Ne baaligaaraanne new manddiyaawaa sirp'p'i ootsanaw,","poem":2},{"lineBreak":true},{"text":"guutsa naanatuwaa doonaan","poem":2},{"lineBreak":true},{"text":"d'ammiyaa naanatuwaa doonaan galataa kuntsaadda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Neeni ne birad'd'etuwaan med'd'eedda ne salotuwaa,","poem":1},{"text":"Sa'aan sa'aan neeni wotseedda aginaanne","poem":2},{"lineBreak":true},{"text":"s'oolinttetuwaa taani be'iyaa wode,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"neeni asaabaa k'oppanaw Asay ayee?","poem":1},{"text":"Woy neeni aw hirgganaw I ayee?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Aa neeni S'oossaappe amareedawaa guutsaadda;","poem":1},{"text":"Bonchchuwaanne gitatetsaa kalachchaa Aa huup'iyaan wotsaadda.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Aa neeni ne med'd'eedda med'etetsaa ubbaa bollan","poem":1},{"text":"mooddiyaawaa ootsaade suntsaadda;","poem":2},{"lineBreak":true},{"text":"ubbabaa Aa gediyaappe garssanna wotsaadda.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dorssatuwaanne booratuwaa, sa'aa do'atuwaanne,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"saluwaa kafotuwaa, abbaa moletuwaanne,","poem":1},{"text":"abbay goggiyaasan wad'd'iyaawantta ubbaakka","poem":2},{"text":"Aa moodissaadda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Abeet S'oossaw, nu S'oossaw, ne suntsay","poem":1},{"text":"sa'aa ubbaan ayaa bonchchetteeddeeshsha!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}