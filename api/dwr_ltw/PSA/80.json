{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":80,"content":[{"type":"heading","content":["Israa'eeliyaa Kawutetsay ZaariEk'k'anaadan Shiik'o Woosaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Aasaafi Yes's'eedda, C'iishshaa Giyaa waatsan Yes'eteedda mazamuriyaa, markkatetsaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Israa'eeliyaa hentsanchchaw,","poem":1},{"text":"Yooseefo asaa wudiyaadan kaaletsiyaawoo,","poem":2},{"lineBreak":true},{"text":"Kiruubetuwaa giyaa kiitanchchatuwaappe,","poem":2},{"lineBreak":true},{"text":"bollaanna de'iyaa araatan utteeddawoo, poo'a, neeni nuuna sisa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Efireema, Biiniyaamanne Minaase sintsan k'onc'c'a.","poem":1},{"text":"Ne wolk'k'aa dentsaade nuuna ashshanaw haaya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Abeet S'oossaw, nuuna zaara;","poem":1},{"text":"nuuni attanaadan, ne som\"uwaa nuw poo'issa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Abeet Ubbaappe Wolk'k'aama Med'etaa Ubbaa Godaw, S'oossaw,","poem":1},{"text":"ne asaa woosaa bolla awude gakkanaw hank'k'ettay?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neeni unttuntta yeekuwaa k'umaadan mizaadda;","poem":1},{"text":"k'ay afotsaa haatsaadan ushshaadda.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nu shoorotuu nu biittaa akkanaw,","poem":1},{"text":"barenttu gidon walak'ettanaadan ootsaadda;","poem":2},{"lineBreak":true},{"text":"nu morkketuu nu bolla miic'c'eeddino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Abeet Ubbaappe Wolk'k'aama S'oossaw, nuuna zaara;","poem":1},{"text":"nuuni attanaadan, ne som\"uwaa nuw poo'issa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Neeni Gibs'eppe woyniyaa anuwaa ahaada;","poem":1},{"text":"ayihuda gidena asatuwaa yederssaadda, unttunttu biittaan Aa tokkaadda.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neeni woraa butsaadda;","poem":1},{"text":"yaatina, s'ap'uwaa yeddi daashiide,","poem":2},{"lineBreak":true},{"text":"biittaa ubbaa gakkeedda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Deretuu Aa kuwan,","poem":1},{"text":"Libaanoosa zigatuu Aa tashetuwaan kameteeddino.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bare tashetuwaa Meediteraane Abbaa gakkanaw,","poem":1},{"text":"k'ay bare s'eeratuwaa Efiraas'iisa Shaafaa gakkanaw yeddeedda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yaatina, ogiyaanna aad'd'iyaa ubbay,","poem":1},{"lineBreak":true},{"text":"Aa ayifiyaa duutsanaadan,","poem":1},{"text":"Aa yuushshuwaan de'iyaa gimbbiyaa ayaw kolaadii?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bazzuwaa guduntsay Aa bolla duriide bayzzee;","poem":1},{"text":"k'ay gaden wos's'i k'aas's'iyaa med'etatuu ubbay Aa miino.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Abeet Med'etaa Ubbaa S'oossaw,","poem":1},{"text":"neeni nuukko simma.","poem":2},{"text":"Saluwaana duge s'eellaade be'a;","poem":1},{"text":"ha woyniyaa naaga.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"I ne ushechcha kushii tokkeedda s'ap'uwaa;","poem":1},{"text":"neeni new gaade dichcheedda puutiyaa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ne morkketuu ne woyniyaa butseeddino;","poem":1},{"text":"taman s'uuggeeddino.","poem":2},{"text":"Hewaa diraw, neeni unttuntta ne hank'k'uwaa suuluwaan d'ayissa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ne kushii, ne ushechchan de'iyaa asaa,","poem":1},{"text":"neeni new gaade dichcheedda asaa naago.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yaatooppe, nuuni neeppe guyye simmokko.","poem":1},{"lineBreak":true},{"text":"Nuuna pas'a wotsa; ne suntsaa nuuni galatana.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Abeet Ubbaappe Wolk'k'aama Med'inaa Godaa S'oossaw,","poem":1},{"text":"nuuna zaara; nuuni attanaadan,","poem":2},{"lineBreak":true},{"text":"ne som\"uwaa nuw poo'issa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}