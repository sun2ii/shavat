{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":81,"content":[{"type":"heading","content":["Baalaa Mazimuriyaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Suusulatuwaan Yes'etteedda, Asaafi s'aafeeddawaa"]},{"type":"verse","number":1,"content":[{"text":"Nuw wolk'k'aa gidiyaa S'oossaw,","poem":1},{"text":"hintte k'aalaa d'ok'k'u ootsiide yes's'ite;","poem":2},{"lineBreak":true},{"text":"Yaak'ooba S'oossaa sabbite.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yetsaa doommite; karabuwaa bak'k'ite;","poem":1},{"text":"diitsaaninne maasink'k'uwaan lo\"a yetsaa sissite.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Aginay s'eeriya wodenne,","poem":1},{"text":"aginay doyssiyaa wode","poem":2},{"lineBreak":true},{"text":"baalaa gallassan malakataa punnite.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hawe Israa'eeliyaw higgiyaa;","poem":1},{"text":"Yaak'ooba S'oossaappe imetteedda woga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gibs'e biittaa I shoc'eedda wode,","poem":1},{"text":"Yooseefo asaw ha wogaa awaayeedda.","poem":2},{"text":"Taani erenna kooshshaa hawaadan yaagiyaawaa sisaad.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Hintte hashiyaappe tookuwaa wotsaad;","poem":1},{"text":"hintte kushiyaa s'uubiyaappe shemppissaad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hintte metuwaa wode taana s'eeseeddita;","poem":1},{"text":"hinttena ashshaad;","poem":2},{"lineBreak":true},{"text":"taani guumiyaa shaariyaa giddon geemmeeddasaappe hinttena allaad.","poem":2},{"lineBreak":true},{"text":"Mariiba giyaa pulttuwaa matan taani hinttena paac'c'aad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ta asaw, taani hinttena seeriyaawaa sisite;","poem":1},{"text":"ha\"i Israa'eelatoo, hayzzeerikkite!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hintte giddon allaga s'oossi de'oppo;","poem":1},{"text":"hara s'oossaw goyinnoppite.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Taani, Med'inaa Godaa hintte S'oossaa,","poem":1},{"text":"hinttena Gibs'e biittaappe kessaade aheeddawaa.","poem":2},{"text":"Ne doonaa loytsa hangga;","poem":1},{"text":"taani neena darssaade barssana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Shin ta asatuu ta k'aalaa sisibeykkino;","poem":1},{"text":"Israa'eelatuu taw azazettibeykkino.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hewaa diraw, taani unttunttu barenttu k'ofaa kaallana mala,","poem":1},{"text":"eeno geena wozanaw aatsaade immaad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ta Asay taana siseedentto,","poem":1},{"text":"Israa'eelatuu ta ogiyaa kaalleedentto ayee de'ii!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Taani unttunttu morkkiyaa elle s'oonana shin;","poem":1},{"text":"unttunttu baaligaaraatuwaa bolla ta kushiyaa wotsana shin.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Med'inaa Godaa is's'iyaawanttu Aa sintsan hokkana,","poem":1},{"text":"unttunttu muruukka med'inaassa gidanawaa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Taani hinttena lo\"o zarggaa mizana;","poem":1},{"text":"k'ay eessaa, shuchchaa gonggoluwaappe kalissana» yaagee.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}