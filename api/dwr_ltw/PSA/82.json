},{"text":"hintte d'uman hamettiita.","poem":2},{"text":"S'illotetsay d'ayina, biittay yiik'k'iyiik'k'ee.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Taani hinttena, ‹Hintte s'oossatuwaa;","poem":1},{"text":"hintte ubbaykka Ubbaappe D'ok'k'iyaa S'oossaa naanatuwaa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gidooppenne, hintte Asay hayk'k'iyaawaadan hayk'k'ana.","poem":1},{"text":"K'ay hara kaappatuu kunddeeddawaadan,","poem":2},{"lineBreak":true},{"text":"hinttekka kunddana› yaagay» yaagee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Abeet S'oossaw, dendda; sa'aa pirddaa;","poem":1},{"text":"kawutetsay ubbay newaa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}