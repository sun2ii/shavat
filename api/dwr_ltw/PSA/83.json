{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":83,"content":[{"type":"heading","content":["Israa'eeliyaa Morkketuwaa Bolla Shiik'eedda Woosaa"]},{"type":"hebrew_subtitle","content":["Asaafa mazamuriyaa, yetsaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet S'oossaw, c'o\"u gooppa;","poem":1},{"text":"sirp'p'i gooppa;","poem":2},{"lineBreak":true},{"text":"abeet S'oossaw, muumoppa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Be'a! Ne morkketuu ne bolla denddiino;","poem":1},{"text":"neena is's'iyaawanttu ne bolla makkaliino.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Unttunttu ne asaa bollan geeman yaa'iino;","poem":1},{"text":"neeni siik'iyaa asatuwaa bolla mak'ettiino.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Unttunttu, «Haayite, unttunttu kawutetsaa d'ayissoytee;","poem":1},{"text":"Israa'eeliyaa giyaa suntsaa,","poem":2},{"lineBreak":true},{"text":"med'inaw hassayettennaadan ootsoytte» yaagiino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Unttunttu itti wozana gidiide,","poem":1},{"text":"ittippe mak'ettiinonne,","poem":2},{"lineBreak":true},{"text":"ne bolla c'aak'uwaa c'aak'k'etiino.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"C'aak'k'etiyaawanttunne","poem":1},{"text":"Eedoomanne Isimaa'eela asatuwaa,","poem":2},{"text":"Moo'aaba zaratuwaanne Aggaari zaratuwaa;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gebaala asatuwaa, Amoona asatuwaa,","poem":1},{"text":"Amaaleek'a asatuwaa,","poem":2},{"text":"Piliss's'eema asatuwaanne S'iiroosa asatuwaa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asoore asatuukka unttunttunna ittippe gakketeeddino;","poem":1},{"text":"Asooratuukka Loos'e zaretoo wolk'k'aama maaduwaa gideeddino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Neeni Midiyaama asatuwaa bollanne","poem":1},{"text":"Sisaaranne Yaabina bolla,","poem":2},{"text":"K'iishoona Shaafaan ootseeddawaadan unttunttu bolla ootsa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Unttunttu Enddooren d'ayeeddino;","poem":1},{"text":"unttunttu anhay moogettennan biittan wook'k'eedda.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Unttunttu kaappotuwaa,","poem":1},{"text":"neeni Oreebanne Za'eeba ootseeddawaadan ootsa;","poem":2},{"lineBreak":true},{"text":"unttuntta mooddiyaawantta","poem":2},{"lineBreak":true},{"text":"neeni Zebaahanne S'almmunaa'a d'ayisseeddawaadan d'ayissa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hewanttunne, «Nuuni S'oossaa asaa biittaa","poem":1},{"text":"nuw buzotana» yaageeddawantta.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Abeet ta S'oossaw, unttuntta baanaadan laala;","poem":1},{"text":"c'arkkuu afiyaa suullaadan ootsa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"S'aragay wora miide wurssiyaawaadan,","poem":1},{"text":"tamaa lac'uu deriyaa mayiyaawaadan,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"hewaadankka ne uushuwaan unttuntta yederssa;","poem":1},{"text":"ne gotiyaan unttuntta dagantsa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abeet Med'inaa Godaw, Asay ne suntsaa koyana mala,","poem":1},{"text":"neeni unttunttu som\"uwaa yeellaa mayzza.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Unttunttu med'inaw yeellatinonne hirggino;","poem":1},{"text":"kawushiide d'ayino.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ne suntsaykka Med'inaa Godaa gidiyaawaa,","poem":1},{"text":"ne s'alalay Ubbaappe D'ok'k'a S'oossaa,","poem":2},{"lineBreak":true},{"text":"sa'aa ubbaa mooddiyaawaa unttunttu erino.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}