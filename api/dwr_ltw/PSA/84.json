{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":84,"content":[{"type":"heading","content":["S'oossaa Golliyaa Laamotussaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Suusulatuwaan Yes'etteedda, K'oore Naanatuu S'aafeedda Mazimuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Ubbaappe Wolk'k'aama Med'inaa Godaw,","poem":1},{"text":"neeni de'iyaasay ayaa lo\"ii!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taani Med'inaa Godaa Geeshsha Golliyaa Dabaabaa laamotay;","poem":1},{"text":"ta kumentsaa asatetsay de'uwaa S'oossaw nashshechchan yes's'ee.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abeet Ubbaappe Wolk'k'aama Med'inaa Godaw,","poem":1},{"text":"ta kaatiyaw, ta S'oossaw,","poem":2},{"lineBreak":true},{"text":"new yarshshiyaa sa'aa matan,","poem":2},{"lineBreak":true},{"text":"suunniyaa kafatta barew de'iyaasaa demmaaddu.","poem":2},{"text":"Harap'p'attakka barew k'uuk'k'ulliyaa golliyaa yaan kees's'aaddu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ne Geeshsha Golliyaan de'iyaawanttunne","poem":1},{"text":"med'inaw neena sabbiyaawanttu anjjetteedawantta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wolk'k'aa neeppe demmiyaawanttu,","poem":1},{"text":"barenttu wozanaan S'iyoone afiyaa ogiyaa baanaw","poem":2},{"lineBreak":true},{"text":"amottiyaawanttu anjjetteedawantta.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yeekuwaa zanggaaraanna unttunttu aad'd'iyaa wode,","poem":1},{"text":"he sa'ay pulttuwaa kesee.","poem":2},{"text":"Bad'd'eesaa iraykka bukkiide,","poem":1},{"text":"yaan del\"iyaa gisissee.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Unttunttu biyaa wode, wolk'k'aa gujji gujjiide baana.","poem":1},{"text":"Unttunttu S'oossaa sintsan S'iyoonen beettana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Abeet Ubbaappe Wolk'k'aama Med'inaa Godaw S'oossaw,","poem":1},{"text":"ta woosaa neeni sisa.","poem":2},{"text":"Abeet Yaak'ooba S'oossaw, hayzza.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Abeet S'oossaw, nu gonddalliyaa be'a;","poem":1},{"text":"neeni dooreedda kaatiyaa ne keeka ayifiyaan s'eella.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Taani hara sa'aan sha\"u gallassaa de'anaappe","poem":1},{"text":"S'oossaa golliyaan itti gallassaa de'iyaawe lo\"a.","poem":2},{"text":"Iitatuwaa dunkkaaniyaan de'anawaappe","poem":1},{"text":"ta S'oossaa golliyaa penggiyaa naagiyaawe taw lo\"a.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Med'inaa Goday S'oossay nuw gonddallenne poo\"uwaa;","poem":1},{"text":"Med'inaa Goday nuw bonchchuwaanne keekkatetsaa immee.","poem":2},{"text":"Suuretetsan hamettiyaawantta I lo\"obaa ubbaa diggenna.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Abeet Ubbaappe Wolk'k'aama Med'inaa Godaw,","poem":1},{"text":"neenan ammanettiyaawanttu anjjetteedawantta.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}