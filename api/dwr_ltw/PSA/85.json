{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":85,"content":[{"type":"heading","content":["Asaa Sarotetsaw Shiik'eedda Woosaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo Yes'etteedda, K'oraaha naanatuwaa mazamuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, neeni ne biittaw keekkaadda;","poem":1},{"text":"Yaak'ooba asaa omooduwaappe zaaraadda.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neeni ne asaa naak'uwaa atto gaadda;","poem":1},{"text":"unttunttu nagaraa ubbaa kamaadda.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Neeni ne hank'k'uwaa ubbaa aggaada;","poem":1},{"text":"ne hank'k'uwaa suuluwaappekka simmaadda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Abeet nuuna ashshiyaa S'oossaw,","poem":1},{"text":"nuuna guyye zaara.","poem":2},{"text":"Neeni nuw hank'k'eteeddawaa agga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Neeni nuuna med'inaw hank'k'ettay?","poem":1},{"text":"Ne hank'k'uwaa yeletaa ubbaa gakkanaw gam\"isay?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne Asay neenan nashettana mala,","poem":1},{"text":"nuuna ooratsa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abeet Med'inaa Godaw, aggena ne siik'uwaa nuuna bessa;","poem":1},{"text":"neeni nuuna ashsha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Taani Med'inaa Goday S'oossay odiyaawaa sisana.","poem":1},{"text":"Nuuni nu booza ogiyaa guyye baana d'ayooppe,","poem":2},{"text":"I nuw, bare asaw, «Sarotetsaa immana» giide odee.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tumukka S'oossaw yayyiyaawantta ashshanaw","poem":1},{"text":"I matan de'ee;","poem":2},{"lineBreak":true},{"text":"hewenne, Aa bonchchuu nu biittan de'anaassa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Aggena siik'uunne tumatetsay","poem":1},{"text":"ittippe gakkettana.","poem":2},{"text":"S'illotetsaynne sarotetsay,","poem":1},{"text":"ittippe yerettana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tumatetsay sa'aappe pude kesana;","poem":1},{"text":"S'oossaa s'illotetsay saluwaappe duge s'eelana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ee, Med'inaa Goday keekkabaa immana;","poem":1},{"text":"nu biittaykka lo\"o katsaa mokkana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"S'illotetsay S'oossaappe sintsanna heemettana;","poem":1},{"text":"aw ogiyaa giigissana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}