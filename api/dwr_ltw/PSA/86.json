{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":86,"content":[{"type":"heading","content":["Metuwaa Wode Woosaa"]},{"type":"hebrew_subtitle","content":["Daawite woosseedda woosaa."]},{"type":"verse","number":1,"content":[{"text":"Abeet Godaw, taani hiyyeessanne,","poem":1},{"text":"metootanchchaa asaa gidiyaa diraw,","poem":2},{"lineBreak":true},{"text":"ta waasuwaa sisaade, taw alla.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taani S'oossaa asaa gidiyaa diraw,","poem":1},{"text":"taana pas'a wotsa.","poem":2},{"text":"Neenan ammanettiyaa taana, ne k'oomaa ashsha.","poem":1},{"text":"Neeni ta S'oossaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Abeet S'oossaw, taani gallassaa ubbaa","poem":1},{"text":"neekko waassiyaa diraw,","poem":2},{"lineBreak":true},{"text":"taw k'aretta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Abeet S'oossaw, taani ta shemppuwaappe","poem":1},{"text":"neena woossiyaa diraw,","poem":2},{"lineBreak":true},{"text":"taana, ne k'oomaa nashshechchaa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abeet S'oossaw, neeni keekkanne atto giyaawaa;","poem":1},{"text":"neena s'eesiyaa ubbaw ne siik'uu dara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Abeet Med'inaa Godaw, ta woosaa sisa;","poem":1},{"text":"taani watiwatiyaa watiwatuwaa hayzza.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Neeni taw alliyaa diraw,","poem":1},{"text":"ta metuwaa gallassan taani neekko waassay.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Abeet Godaw, s'oossatuwaa giddon ne mali baawa;","poem":1},{"text":"ne oosuwaa mala oosuukka baawa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abeet Godaw, neeni med'd'eedda kawutetsaa Asay ubbay yiide,","poem":1},{"text":"ne sintsan gulbbatana; unttunttu ne suntsaa bonchchana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ayaw gooppe, neeni wolk'k'aama;","poem":1},{"text":"neeni malalissiyaabaa ootsaasa.","poem":2},{"text":"Ne s'alalay S'oossaa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Abeet Med'inaa Godaw, taani ne tumuwaan hamettana mala,","poem":1},{"text":"taana ne ogiyaa tamaarissa.","poem":2},{"text":"Taani ne suntsaw yayana mala,","poem":1},{"text":"taw itti wozanaa imma.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abeet Godaw ta S'oossaw, taani neena,","poem":1},{"text":"ta kumentsaa wozanaappe galatana.","poem":2},{"text":"Ne suntsaa med'inaw bonchchana.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ayaw gooppe, ne siik'uu taw dara;","poem":1},{"text":"neeni taana duufuwaan geliyaawaappe ashshaada.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Abeet Godaw, otoranchcha asatuu ta bolla denddeeddino;","poem":1},{"text":"dagantsiyaa asatuwaa c'uguu taana wod'anaw koyee.","poem":2},{"text":"Unttunttu neena alaalle giikkino.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Shin abeet Godaw, neeni","poem":1},{"text":"k'arettiyaanne maariyaa S'oossaa;","poem":2},{"lineBreak":true},{"text":"hank'k'ettanaw gam\"aasa;","poem":2},{"lineBreak":true},{"text":"siik'uunne ammanettussay dariyaawaa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Taakko simmaade taw k'aretta.","poem":1},{"text":"Ne k'oomaw wolk'k'aa imma;","poem":2},{"lineBreak":true},{"text":"ne k'oomati na'aa taana ashsha.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abeet Med'inaa Godaw,","poem":1},{"text":"ne keekkatetsaa malaataa taana bessa.","poem":2},{"text":"Neeni taana maaddeeddawaanne mintsetseeddawaa be'iyaa wode,","poem":1},{"text":"taana is's'iyaawanttu hewan yeellatana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}