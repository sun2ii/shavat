{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":87,"content":[{"type":"heading","content":["Yerusaalame Sabaa"]},{"type":"hebrew_subtitle","content":["K'oraaha naanatuwaa mazamuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Godaa katamay geeshsha deriyaan kees'etteedda.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Med'inaa Goday S'iyoone penggetuwaa,","poem":1},{"text":"Yaak'oobi de'iyaa sa'aa ubbaappe aatsiide dosee.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hanee S'oossaa katamatee,","poem":1},{"text":"ne diraw bonchchetteeddabay,","poem":2},{"lineBreak":true},{"text":"hawaadan yaagi odettee:","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Taana eriyaa kawutetsatuwaa gidoppe,","poem":1},{"text":"Gibs'enne Baabloone gatsa mazggobana;","poem":2},{"text":"Piliss's'eeme, S'iiroosenne Toop'p'iyaa asay,","poem":1},{"text":"yaan yeletteeddino.»","poem":2}]},{"type":"line_break"},{"typ