{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":88,"content":[{"type":"heading","content":["Maaduwaa Demanaw Shiik'o Waasuwaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo, K'oraaha naanatuwaa mazamuriyaa, Maaduwaa Woossa, Ezirahiyaa Hemaane Akeekan S'aafeedda Timirttiyaa."]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, taana ashshiyaa S'oossaw,","poem":1},{"text":"taani gallassi new waassay;","poem":2},{"lineBreak":true},{"text":"k'ammakka ne sintsan yeekkay.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta woosay ne sintsa gakko;","poem":1},{"text":"ne haytsaa ta waasuwaakko zaara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ayaw gooppe, ta de'uu metuwaan kumeedda;","poem":1},{"text":"taani hayk'k'ana mataad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taani duufuwaan geliyaa asatuwaana paydetaad;","poem":1},{"text":"wolk'k'ay bayinna asaa gidaaddi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Taani anhatuwaa giddon aggeeda asaa mala;","poem":1},{"text":"wod'iide duufuwaan yeggeedda asatuwaa mala.","poem":2},{"text":"Taani ne ubbaa dogeedda,","poem":1},{"text":"ne maaduwaappe haakkeedda asatuwaa mala.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Neeni taana c'iimmo ollaan,","poem":1},{"text":"hirkki d'uma sa'aan yeggaadda.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne hank'k'uu taana dees'ee;","poem":1},{"text":"ne hank'k'uwaa beetay taana ubbaanna muukkeedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Neeni ta dabbotuwaa taappe haassaadda;","poem":1},{"text":"unttunttoo taana sheneyiyaawaa ootsaadda.","poem":2},{"text":"Taani dooddettaad;","poem":1},{"text":"kessa akkanawukka danddaykke.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abeet Med'inaa Godaw,","poem":1},{"text":"kayyuwaa gaasuwaan ta ayifetuu galjjeeddino.","poem":2},{"text":"Ubbaa gallassi taani neekko waassay;","poem":1},{"text":"ta kushiyaa neekko mic'c'aad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Neeni hayk'k'eeddawanttoo","poem":1},{"text":"malalissiyaabaa ootsay?","poem":2},{"lineBreak":true},{"text":"unttunttu denddiide neena galatiino?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Aggena ne siik'uu","poem":1},{"text":"duufuwaa giddon haasayettii?","poem":2},{"lineBreak":true},{"text":"neeni ammanettiyaawekka bayetsaa sa'aan odettii?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne malalissiyaa oosuukka d'uman erettii?","poem":1},{"text":"woy ne s'iltotetsay dogetteedda asatuwaa biittan de'ii?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Abeet Med'inaa Godaw, taani neekko waassay;","poem":1},{"text":"wonttaan wonttaan ta woosay ne sintsa gakkee.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Abeet Med'inaa Godaw, taana neeni ayaw aggay?","poem":1},{"lineBreak":true},{"text":"Ne som\"uwaa taappe ayaw gentsay?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yalagatetsaappe doommaade,","poem":1},{"text":"taani tuggataaddinne hayk'k'ana mataad.","poem":2},{"text":"Taani new dagamaade hiidootaa k'ans's'aad.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ne suulliyaa hank'k'uu ta bolla uushoteedda;","poem":1},{"text":"ne dagamay taana bayzzeedda.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Unttunttu gallassaa ubbaa di'uwaadan taana dooddeeddino;","poem":1},{"text":"taana muukkeeddino.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Neeni ta laggetuwaanne ta siik'otuwaa taappe haassaadda;","poem":1},{"text":"d'umaa s'alalay taw dabbo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}