{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":89,"content":[{"type":"heading","content":["Metuwaa Mazimuriyaa"]},{"type":"hebrew_subtitle","content":["Ezirahiyaa Etaana Akeekan S'aafetteedda Timirttiyaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, aggena ne siik'uwaabaa,","poem":1},{"text":"taani med'inaw yes's'ana.","poem":2},{"text":"S'oossay ammanettiyaawaa gaade,","poem":1},{"text":"yeletaa ubbaw ta doonaan awaayana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taani aggena ne siik'uu med'inaw ek'k'eeddawaanne","poem":1},{"text":"neeni ne tumatetsaa saluwaadan minisaade esseeddawaa odana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Neeni, «Taani dooreeddawaana c'aak'uwaa c'aak'k'etaad.","poem":1},{"text":"Ta k'oomaa Daawitaw hawaadan yaagaade c'aak'k'aad;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"‹Taani ne zeretsaa med'inaw kawutsana;","poem":1},{"text":"ne kawutetsaa araataa yeletaa ubbaw minisana› » yaagaadda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Abeet Med'inaa Godaw, salotuu,","poem":1},{"text":"ne malalissiyaa oosuwaa odino;","poem":2},{"lineBreak":true},{"text":"ne ammanettiyaawaa kiitanchchatuwaa shiik'uu odino.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Saluwaan Med'inaa Godaana likkettanaw danddayiyaawe oonee?","poem":1},{"text":"Saluwaa med'etetsatuwaa giddon k'ay Med'inaa Godaa mali oonee?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Geeshshatuwaa shiik'uwaa giddon S'oossay yayetteeddawaa.","poem":1},{"text":"Barena dooddeeddawanttu ubbaappe aad'd'iide, loytsi dagantsiyaawaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Abeet Ubbaappe Wolk'k'aama Med'inaa Godaw, S'oossaw,","poem":1},{"text":"neenaadan wolk'k'aamay oonee?","poem":2},{"text":"Abeet Med'inaa Godaw, neeni ubbabankka ammanettiyaawaa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Neeni bul\"akettiyaa abbaa wolk'k'aa azazaasa.","poem":1},{"text":"Denddiyaa beetaakka c'o\"u ootsaasa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Neeni Ra'aaba giyaa abbaa dawiyaa,","poem":1},{"text":"wod'i yegeeddawaadan mentsereetsaadda;","poem":2},{"lineBreak":true},{"text":"ne morkkatuwaa ne wolk'k'aama k'esiyaan laalaadda.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Salotuu newantta; sa'aykka newaa;","poem":1},{"text":"biittaanne an kumeedda ubbabaa neeni med'aadda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Huup'issaanne gedissaa neeni med'd'aadda;","poem":1},{"text":"Taabooranne Hermmoone giyaa wolk'k'aama deretuu","poem":2},{"lineBreak":true},{"text":"nashshechchan ne suntsaa sabbiino.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"New wolk'k'aama k'eesii de'ee;","poem":1},{"text":"ne kushii mina;","poem":2},{"lineBreak":true},{"text":"ne ushechchay wolk'k'aama.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"S'illotetsaynne suure pirdday","poem":1},{"text":"ne kawutetsaa araataw baaso.","poem":2},{"text":"Aggena siik'uunne tumatetsay ne sintsaan biino.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Abeet Med'inaa Godaw, nashechchaan ililiyaawanttunne","poem":1},{"text":"ne som\"uwaa poo'uwaan hamettiyaawanttu anjjetteedawantta.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ne suntsan gallassaa ubbaa nashettiino;","poem":1},{"text":"ne s'illotetsaa diraw,","poem":2},{"lineBreak":true},{"text":"unttunttu neena d'ok'k'u d'ok'k'u ootsiino.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Unttunttu c'eek'ettiyaa wolk'k'ay neena;","poem":1},{"text":"ne nashshuwaan nu kac'ii d'ok'k'u d'ok'k'u yaageedda.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nu gonddallii, nu Med'inaa Godaassa;","poem":1},{"text":"nu kaatiikka, Israa'eeliyaa geeshsha saa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Beni neeni ne ammanetteeda asatoo,","poem":1},{"text":"itti gede akumuwaan odaadda;","poem":2},{"text":"«Asaa gidoppe dooreeddawoo kawutetsaa araataa immaadda.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ta k'ooma Daawita kaate kesaad;","poem":1},{"text":"ta geeshsha zayitiyaan okaade.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ta kushii aanana de'ana;","poem":1},{"text":"ta k'esiikka Aa mintsana.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Aa ay morkkiinne s'oonenna;","poem":1},{"text":"ay iita asaynne Aa toochchenna.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Taani Aa morkkatuwaa Aa sintsan kinchchereetsana;","poem":1},{"text":"Aa is's'iyaawantta shoc'a yeggana.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ta tumatetsaynne ta aggena siik'uu","poem":1},{"text":"aanana ittippe gidana.","poem":2},{"text":"Ta suntsan Aa kac'ii d'ok'k'u d'ok'k'u gaana.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Taani Aa kawutetsaa Medetiraaniyaa Abbaa gakkanaw aassana;","poem":1},{"text":"Aa zawaakka,","poem":2},{"text":"Efiraas'eesenne S'egiroose Shaafaa gakkanaw aassana.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Daawite taana, ‹Neeni ta aawuwaa,","poem":1},{"text":"ta S'oossaanne taana ashshiyaa zaallaa› yaagiide s'eesana.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Taani Aa bayira na'aa ootsana;","poem":1},{"text":"sa'aan de'iyaa kaatetuwaa ubbaappe Aa darssana.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Taani aggena ta siik'uwaa","poem":1},{"text":"aw med'inaw naagana.","poem":2},{"text":"Taani aanana k'aalaa c'aak'uwaa mintsana.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Taani Aa zeretsaa med'inaw minisaade essana;","poem":1},{"text":"Aa kawutetsaa araataakka saluwaadan gam\"etsana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"«Shin Aa zeretsatuu ta higgiyaa aggooppe,","poem":1},{"text":"k'ay unttunttu ta wogaadan hamettennan is's'ooppe,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"unttunttu ta awaayuwaa shaarooppe,","poem":1},{"text":"ta azazuwaa naagana d'ayooppe,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"taani unttunttu nagaraa diraw gatiman,","poem":1},{"text":"unttunttu iitatetsaa diraw, lissuwaan,","poem":2},{"lineBreak":true},{"text":"shoc'aade murana.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Shin taani aggena ta siik'uwaa aappe akkikke;","poem":1},{"text":"woy taani aw ammanettiyaawaa aggikke.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Taani unttunttunna c'aak'k'eteedda c'aak'uwaa kolikke;","poem":1},{"text":"ta doonaappe keseedda k'aalaa laammikke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"«Itti gedekka med'inaw","poem":1},{"text":"ta geeshshatetsaan c'aak'k'a diggaad;","poem":2},{"text":"Daawitew worddotikke.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Hewenne, Aa zeretsay med'inaw de'ana;","poem":1},{"text":"Aa kawutetsaa araataykka ta sintsan awaadan gam\"ana.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Saluwaan ammanettiyaa markka gidiyaa aginaadan,","poem":1},{"text":"he kawutetsay med'inaw min ek'k'i de'ana» yaagaadda.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Shin ha\"i neeni","poem":1},{"text":"okkaade kaateyeeddawaa bolla daro hank'k'ettaadda;","poem":2},{"text":"Aa is's'aaddanne aggaada.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Neeni ne k'oomaanna c'aak'k'eteedda c'aak'uwaa kaddaadda;","poem":1},{"text":"Aa kallachchaa baanan olaade tunissaadda.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Neeni Aa katamaa gimbbiyaa ubbaa laalaadda;","poem":1},{"text":"I naagettiyaa miis'aa ubbaa bayzzaadda.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Ogiyaanna aad'd'iyaa ubbatuu Aa bonk'k'eeddino;","poem":1},{"text":"I bare shoorotoo k'iliic'oo gideedda.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Neeni Aa morkketoo s'oonuwaa immaadda;","poem":1},{"text":"unttuntta ubbatuwaa nashechchaadda.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Neeni Aa mashshaa s'eeraa k'alam\"aadda;","poem":1},{"text":"neeni olan Aa maaddabaakka.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Neeni Aa kawutaa s'am\"aa","poem":1},{"text":"Aa kushiyaappe wotsa akkaada;","poem":2},{"lineBreak":true},{"text":"k'ay Aa kawutetsaa araataa biittan olaadda.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Neeni Aa yalagatetsaa wodiyaa k'aamisaadda;","poem":1},{"text":"k'ay Aa yeellaa mayzzaadda.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Abeet Med'inaa Godaw, awude gakkanaw k'onc'c'ikkii?","poem":1},{"text":"Neeni med'inaw geemmay?","poem":2},{"text":"Ne hank'k'uu tamaadan awude gakkanaw ees's'anee?","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Ta laytsay ay keeshshaa k'antsentto k'oppa;","poem":1},{"text":"asaa ubbaa c'oo mela med'd'aadii?","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Asay hayk'k'ennan c'oo de'anaw waan danddayii?","poem":1},{"lineBreak":true},{"text":"K'ay duufuwaan gelennaadan,","poem":1},{"text":"barena ashshanaw waan danddayii?","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Abeet Godaw, neeni ne tumatetsan Daawitew c'aak'k'eedda,","poem":1},{"text":"aggena beni ne siik'uu hak'an de'ii?","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Abeet Godaw, ne k'oomay","poem":1},{"text":"woyssa boretteeddentto neeni hassaya.","poem":2},{"text":"Taani asaa ubbaa boriyaa woota danddayaadditantto k'oppa.","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Abeet Med'inaa Godaw, morkketuu k'iliic'eeddino;","poem":1},{"text":"neeni dooraade okkeedda kaatiyaa,","poem":2},{"lineBreak":true},{"text":"tangguwaan tangguwaan k'iliic'eeddawaa k'oppa.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Med'inaa Goday med'i med'inaw galatetto!","poem":1},{"text":"Amen\"i. Amen\"i.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":52}