{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":9,"content":[{"type":"heading","content":["Iitaa Bollan Pirddaa"]},{"type":"hebrew_subtitle","content":["Zammaaretuwaa Kaappoo, «Na'aa Hayk'uwaan» Yes'etteedda, Daawita Mazimuriyaa."]},{"type":"verse","number":1,"content":["Abeet Med'inaa Godaw, taani neena ta kumentsaa wozanaappe galatana;",{"text":"Neeni ootseedda maalalissiyaa","poem":1},{"text":"ne oosuwaa ubbaakka odana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neenan nashettananne hashshu gaana.","poem":1},{"lineBreak":true},{"text":"Ubbaappe D'ok'k'iyaa S'oossaw,","poem":1},{"text":"taani ne suntsaw galataa yes's'ana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ta morkketuu guyye simmiyaa wode,","poem":1},{"text":"ne sintsappe d'ubetti d'ayana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Neeni taw s'illo pirddaa pirddaadda;","poem":1},{"lineBreak":true},{"text":"Neeni s'illotetsan pirddaadde,","poem":1},{"text":"ne kawutetsaa araatan uttaadda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Neeni kawutetsaa seeraadda;","poem":1},{"text":"iitatuwaakka d'ayissaadda.","poem":2},{"text":"Neeni unttunttu suntsaa med'i med'inawukka k'uc'c'a diggaadda.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Morkketuu med'inaa d'ayuwaa d'ayeeddino;","poem":1},{"text":"k'ay unttunttu katamatuwaa ubbaanna d'ok'olla diggaadda.","poem":2},{"text":"Unttunttu ubbaanna dogetti atteeddino.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Shin Med'inaa Goday med'inaw kaatetiide de'ee;","poem":1},{"text":"I bare kawutetsaa araataa pirddaw giigisseedda.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ha sa'aa s'illotetsan pirddana;","poem":1},{"text":"asatuwaakka suuretetsaan pirddana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Med'inaa Goday un\"etteeddawanttoo bak'ati attiyaawaa;","poem":1},{"text":"meto wodiyaankka geli attiyaa geessuwaa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne suntsaa eriyaawanttu neenan ammanettiino;","poem":1},{"text":"ayaw gooppe, Med'inaa Godaw, neeni neena koyiyaawantta yegga agga beykka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"S'iyoone Deriyan kaateti utteedda Med'inaa Godaw galataa yes's'ite.","poem":1},{"text":"I ootseedda ubbabaakka asaa ubbaw odite.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ayaw gooppe, suutsaa gussiyaawanttoo","poem":1},{"text":"haluwaa kessiyaa S'oossay","poem":2},{"lineBreak":true},{"text":"naak'etteeddawanttu waasuwaa sheneko geena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Abeet Med'inaa Godaw, S'iyoone asaa kariyaan taani ek'k'aade,","poem":1},{"text":"Ne galataa odana malanne","poem":2},{"lineBreak":true},{"text":"hewan ne atotetsaan loytsi nashettana mala,","poem":2},{"lineBreak":true},{"text":"ta morkketuu taana yederssiyaawaa be'a.","poem":2},{"text":"Neeni ne maarotaan, hayk'k'uwaappe taana ashsha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kawutetsatuu barenttu bookkeedda ollaan barenttoo kunddeeddino.","poem":1},{"text":"Unttunttu k'osi wotseedda p'irii unttunttu gediyaa oyk'k'eedda.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Med'inaa Goday bare s'illo pirddan barew eretteedda;","poem":1},{"text":"iita Asay bare kushiyan ootseedda oosuwaa p'iriyaan oyk'k'etteedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Iitatuu duufuwaa baana;","poem":1},{"text":"S'oossaa dogiyaa kawutetsatuu ubbaykka unttunttudan hanana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hiyyeesay ubbaa gede dogetti attena;","poem":1},{"text":"woy metootanchchay wotseedda hidootay med'inaw d'ayenna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Abeet Med'inaa Godaw, Asay ne bolla denddiide,","poem":1},{"text":"bare wolk'k'aan c'eek'ettenna mala, neeni dendda!","poem":2},{"text":"Ne sintsan kawutetsatuwaa bolla neeni pirddaa.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Abeet Med'inaa Godaw, unttuntta neeni yashissa;","poem":1},{"text":"unttunttu asaa gidiyaawaa neeni unttuntta erissa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":19}