{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":90,"content":[{"type":"heading","content":["Asaa Na'aa De'uwaa"]},{"type":"hebrew_subtitle","content":["S'oossaa Asay Muse woosseedda woosaa"]},{"type":"verse","number":1,"content":[{"text":"Godaw, neeni yeletaa ubbaan,","poem":1},{"text":"nuuni de'iyaa sa'aa gidaadda.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Deretuu med'ettanaappe kase,","poem":1},{"text":"woy neeni sa'aa ootsanaappe kase,","poem":2},{"lineBreak":true},{"text":"med'inaappe med'inaa gakkanawukka neeni S'oossaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Neeni asaa naanatuwaa, «Asaa naatoo,","poem":1},{"text":"guyye biittaw simmite» yaagaade,","poem":2},{"lineBreak":true},{"text":"unttuntta guyye unttunttu med'etteedda biittaw zaaraasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sha\"u laytsay new zini aad'd'o gallassaa mala;","poem":1},{"text":"woy k'ammaa giddoppe itti saatiyaa mala.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neeni asaa k'oppennaan di'uwaadan afaasa.","poem":1},{"text":"Unttunttu akumuwaa mala;","poem":2},{"lineBreak":true},{"text":"wontta wontta doliyaa maataa mala.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"He maataykka wontta wode dic'c'iide c'iishshee;","poem":1},{"text":"omarssiyaa wode shulli melee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nuuni ne yiluwaan wureeddo;","poem":1},{"text":"ne hank'k'uwaa suuluwaan dagammeeddo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Neeni nu iita oosuwaa","poem":1},{"text":"ne sintsan wotsaadda;","poem":2},{"lineBreak":true},{"text":"k'ay nu geemmeedda nagaraa","poem":2},{"lineBreak":true},{"text":"ne sintsa poo'uwaakko aatsaada.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nu gallassaa ubbay ne hank'k'uwaan aad'd'eeda;","poem":1},{"text":"nu laytsaa itti ooliyaadan wurisseeddo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nu de'uwaa laytsay laappun tamma;","poem":1},{"text":"woy minnooppe, hosppun tamma;","poem":2},{"lineBreak":true},{"text":"hewekka metuwaanne tugga.","poem":2},{"lineBreak":true},{"text":"Nu laytsay ellekka aad'd'ee;","poem":2},{"lineBreak":true},{"text":"nuunikka ellekka kichcheetto.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne hank'k'uwaa wolk'k'aa eriyaawe oonee?","poem":1},{"text":"ne hank'k'uwaa suuluu yashshiyaawaa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hewaa diraw, nu laytsaa bessiyaawaadan,","poem":1},{"text":"go\"etana mala aad'd'eeda eraa nuuna tamaarissa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Abeet Med'inaa Godaw, ne hank'k'uu awude gakkanaassee?","poem":1},{"text":"Hayanaa; ne k'oomatoo k'aretta!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nu laytsaa ubbaan","poem":1},{"text":"nuuni nashettanaadaaninne yes's'anaadan,","poem":2},{"lineBreak":true},{"text":"wontta wontta aggena ne siik'uwaan nuuna kalissa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Neeni nuuna metoyeedda gallassatuwaa keeshshaanne","poem":1},{"text":"nuuni tuggaa be'eedda laytsatuwaa keeshshaa,","poem":2},{"lineBreak":true},{"text":"nuuna nashshechchaa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nuw ne k'oomatoo ne oosuu k'onc'c'o;","poem":1},{"text":"ne bonchcho wolk'k'ay unttunttu naanaatoo beetto.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Godaa nu S'oossaa keekkatetsay nu bollan gido;","poem":1},{"text":"nu kushiyaa oosuwaa nuw suurissa.","poem":2},{"text":"Ee, nu kushiyaa oosuwaa suurissa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}