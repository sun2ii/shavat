k'amma dagantsiyaabaw,","poem":1},{"text":"woy gallassi s'onggettiyaabaw yayakka;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"woy d'uman oyk'k'iyaa harggiyaw,","poem":1},{"text":"woy gallassaa seetan wurssiyaa iita harggiyaa hirggakka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sha\"ay ne miyyiyaan,","poem":1},{"text":"k'ay tammu sha\"ay neeppe ushechcha baggana kunddana;","poem":2},{"lineBreak":true},{"text":"shin neena ayaynne bochchenna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Neeni ne ayifiyaa s'alalaan s'eelana;","poem":1},{"text":"iitatuu murettiyaawaakka be'ana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Med'inaa Godaa neeni new bak'ata attiyaa sa'aa ootseedda dirawunne,","poem":1},{"text":"Ubbaappe D'ok'k'iyaa S'oossaa new,","poem":2},{"lineBreak":true},{"text":"de'iyaa sa'aa ootseedda diraw,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"iitabay neena bochchenna;","poem":1},{"text":"boshaykka ne golliyaa shiik'enna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ayaw gooppe, ne ogiyaan ubbaan","poem":1},{"text":"neena naagana mala,","poem":2},{"text":"S'oossay bare kiitanchchatuwaa azazana.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ne gedii shuchchaan d'ubettenna mala,","poem":1},{"text":"kiitanchchatuu barenttu kushiyan neena dentsana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Neeni gaammuwaanne shooshshaa bollan heemettana;","poem":1},{"text":"k'ay wodalla gaammuwaanne wod'iyaa shooshshaa neeni yed'd'ana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Med'inaa Goday hawaadan yaagee;","poem":1},{"text":"«I taana siik'eedda diraw,","poem":2},{"lineBreak":true},{"text":"taani Aa ashshana.","poem":2},{"lineBreak":true},{"text":"I ta suntsaa ereedda diraw,","poem":2},{"lineBreak":true},{"text":"taani Aa naagana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"I taana s'eegiyaa wode,","poem":1},{"text":"taani aw koyana.","poem":2},{"text":"Metuwaan taani aanana ittippe gidana;","poem":1},{"text":"taani Aa ashshananne bonchchana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Taani Aa laytsaa adussaade kalissana;","poem":1},{"text":"ta atotetsaa Aa bessana» yaagee.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}