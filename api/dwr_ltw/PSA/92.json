{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":92,"content":[{"type":"heading","content":["Galataa Mazimuriyaa"]},{"type":"hebrew_subtitle","content":["Mazimuriyaa, Sambbata Gallassaw yes's'iyaawaa."]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Godaa galatiyaawe lo\"a.","poem":1},{"text":"Abeet Ubbaappe D'ok'k'iyaa S'oossaw,","poem":2},{"lineBreak":true},{"text":"ne suntsaa sabbiyaawe lo\"a.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wonttan aggena ne siik'uwaa,","poem":1},{"text":"k'amman ne ammanettiyaawaa gidiyaawaa awaayiyaawe lo\"a.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tammu bak'etsaan waas'etteedda diitsaanne,","poem":1},{"text":"maasink'k'uwaan diis's'iyaawe lo\"a.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ayaw gooppe, Abeet Med'inaa Godaw,","poem":1},{"text":"ne wolk'k'aama oosuwaan","poem":2},{"lineBreak":true},{"text":"taana nashechcheedda diraw,","poem":2},{"lineBreak":true},{"text":"ne kushiyaa oosuwaa diraw,","poem":2},{"lineBreak":true},{"text":"taani nashshechchaw yes's'ay.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Abeet Med'inaa Godaw, ne oosuu ay keeshshaa gitee!","poem":1},{"text":"Ne k'ofay ay keeshshaa c'iimmee!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eeyya Asay eranaw danddayenna;","poem":1},{"text":"donc'c'illeedda asaykka akeekanaw danddayenna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hewenne, iitatuu maataadan dic'c'ooppekka,","poem":1},{"text":"iitaa ootsiyaa ubbatuu daashooppekka,","poem":2},{"lineBreak":true},{"text":"unttunttu med'inaw d'ayana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Shin abeet Med'inaa Godaw,","poem":1},{"text":"neeni med'inaw ubbaappe d'ok'k'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Abeet Med'inaa Godaw, ne morkketuu d'ayanawaanne","poem":1},{"text":"iitaa ootsiyaa ubbatuu tiskki gaanawaa nuuni eretto.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta kac'iyaa bazzuwaa mentsaa kac'iyaadan d'ok'k'issaadda;","poem":1},{"text":"lo\"o zayitiyaa taana okkaadda.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta morkketuu s'oonetteeddawaa ta ayifiyaan be'aad;","poem":1},{"text":"ta iita morketuwaa waasuwaa ta haytsaan sisaad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"S'illotuu zambbaadan daashana;","poem":1},{"text":"k'ay Liibaanoosa zigaadan dic'c'ana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Unttunttukka Med'inaa Godaa dabaaban toketteedda mitsaa mala;","poem":1},{"text":"unttunttu nu S'oossaa Geeshsha Golliyaan daashana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Unttunttu ec'iidekka ayifana;","poem":1},{"text":"unttunttu med'inaw irs's'anne pas'a.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Unttunttu, «Med'inaa Goday suure;","poem":1},{"text":"I taw wogga zaallaa; iitatetsi aan baawa» yaagana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}