mber":5,"content":[{"text":"Abeet Med'inaa Godaw, neeni odeeddabay ammanettiyaawaa;","poem":1},{"text":"ne gollii med'inaw geeshshatetsaan aleek'k'ana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}