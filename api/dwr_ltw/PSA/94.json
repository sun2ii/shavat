{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":94,"content":[{"type":"heading","content":["S'oossay Ubbaa Bolla Pirddiyaawaa"]},{"type":"verse","number":1,"content":[{"text":"Abeet Med'inaa Godaw, neeni kushiyaa c'igetiyaa S'oossaa.","poem":1},{"text":"Abeet kushiyaa c'igetiyaa S'oossaw, ne bonchchuwaa bessa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abeet sa'aa pirddiyaawoo, dendda;","poem":1},{"text":"otoranchchatoo bessiyaa muruwaa imma.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abeet Med'inaa Godaw, awude gakkanaw gam\"anee?","poem":1},{"text":"Iitatuu awude gakkanaw nashettanee?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iitaa ootsiyaa ubbatuu,","poem":1},{"text":"barenttu otoro k'aalaa haasayiino;","poem":2},{"lineBreak":true},{"text":"unttunttu c'eek'ettiino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Abeet Med'inaa Godaw, unttunttu ne asaa liik'k'issiino;","poem":1},{"text":"ne laattaa naak'k'iino.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Unttunttu am\"etuwaanne betetuwaa wod'iino;","poem":1},{"text":"aawuu bayinnawanttakka wod'iino.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yaatiide unttunttu, «Med'inaa Goday nuuna be'enna;","poem":1},{"text":"Yaak'ooba S'oossay akeekena» yaagiino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Hinttenoo, asaa giddoppe aad'd'eeda dammatoo, akeekite!","poem":1},{"text":"Hinttenoo eeyyatoo, awude eranchcha gidanitee?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Haytsaa med'eedda S'oossay sisennee?","poem":1},{"text":"Ayifiyaa med'd'eeddawe be'ennee?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kawutetsaa seeriyaawe murennee?","poem":1},{"text":"Asaa eraa tamaarissiyaawe barew erennee?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Med'inaa Goday asaa k'ofay mela gidiyaawaa eree.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Abeet Med'inaa Godaw, neeni seeriyaawenne","poem":1},{"text":"ne higgiyaappe tamaarissiyaa Asay anjjetteedawaa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iitatuu kunddiyaa ollay bookettana gakkanaw,","poem":1},{"text":"metuu gakkiyaa gallassan neeni Aa shemppissaasa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Med'inaa Goday bare asaa aggena;","poem":1},{"text":"I bare laattaa aggena.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Pirdday simmiide s'illo pirddaa gidanawaa;","poem":1},{"text":"wozanaa suuretuu ubbay he s'illo pirddaa maaddana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Makkalanchchatuwaa bolla","poem":1},{"text":"ta diraw denddiyaawe oonee?","poem":2},{"text":"Iitaa ootsiyaawanttuna","poem":1},{"text":"ta diraw ek'etteeddawe oonee?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Med'inaa Goday taana maaddennentto,","poem":1},{"text":"taani ellekka duufuwaan gelaade sirp'p'i gaana shin.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Abeet Med'inaa Godaw, taani,","poem":1},{"text":"«Ta gedii halis's'ee» yaageedda wode,","poem":2},{"lineBreak":true},{"text":"aggena ne siik'uu taw zemppo gideedda.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Taana hirggay wod'iyaa wode,","poem":1},{"text":"neeni taana woppu ootsaade nashechchaasa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Higgiyaa baletsiyaa geella daannatuwaana","poem":1},{"text":"neeni zuppetay?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"S'illotuwaa wod'anaw unttunttu ittippe tobbetiino;","poem":1},{"text":"suuretuwaa bolla hayk'k'uwaa pirddiino.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Gidooppenne, Med'inaa Goday taani bak'ata atteeda sa'aa;","poem":1},{"text":"ta S'oossay taani k'osettiyaa zaallaa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Unttunttu iitatetsaa diraw, I unttuntta murana;","poem":1},{"text":"unttunttu nagaraa diraw, I unttuntta d'ayissana;","poem":2},{"lineBreak":true},{"text":"ee, Med'inaa Goday nu S'oossay unttuntta d'ayissana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}