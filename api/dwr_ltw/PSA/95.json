{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":95,"content":[{"type":"heading","content":["Gallassaa Gallassaa Mazimuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Haayite; ane Med'inaa Godaa sabboytte.","poem":1},{"text":"Nuuna ashshiyaa zaallaw nashshechchaw yes's'oytte.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Aa sintsa galataanna shiik'oytte.","poem":1},{"text":"Galataa yetsaa nashshechchan yes's'oytte.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ayaw gooppe, Med'inaa Goday wolk'k'aama S'oossaa,","poem":1},{"text":"s'oossatuwaa ubbaa bolla wolk'k'aama kaatiyaa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Biittaa c'iimmatuu Aa kushiyan de'iino;","poem":1},{"text":"deriyaa huup'etuukka aawaa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abbaa haatsaykka aawaa;","poem":1},{"text":"hewaa I med'd'eedda;","poem":2},{"lineBreak":true},{"text":"mela biittaakka Aa kushii ootseedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Haayite; hokkiide ane aw goyinnoytte;","poem":1},{"text":"nuuna med'd'eedda Med'inaa Godaa sintsan gulbbatoytte.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ayaw gooppe, I nu S'oossaa.","poem":1},{"text":"Nuuni Aa k'ooruwaan de'iyaa asatuwaa;","poem":2},{"lineBreak":true},{"text":"nuuni I heemmiyaa Aa dorssaa wudetuwaa.","poem":2},{"lineBreak":true},{"text":"S'oossay hinttena giyaawaa hachchi sisite!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"«Kase hintte mayzza aawotuu,","poem":1},{"text":"Mariiba giyaa sa'aan haneeddawaadan,","poem":2},{"lineBreak":true},{"text":"he gallassi Maasa Bazzuwaan is's'eeddawaadan,","poem":2},{"lineBreak":true},{"text":"hinttekka zoriyaa akkenan is's'oppite.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Unttunttu ta oosuwaa be'iidekka,","poem":1},{"text":"taana ek'k'eteeddinonne paac'c'eeddino.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Taani he yeletaa oytamu laytsaa shaatettaad;","poem":1},{"text":"‹Unttunttu ubbaa wode barenttu wozanaan baliino;","poem":2},{"lineBreak":true},{"text":"unttunttu ta ogiyaa eribeykkino yaagaad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hewaadankka k'ay, taani hank'k'etta c'aak'k'aade,","poem":1},{"text":"Unttunttu ta shemppuwaasaa ubbakka gelikkino› yaagaad» yaagee.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}