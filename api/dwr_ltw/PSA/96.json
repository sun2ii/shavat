{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":96,"content":[{"type":"heading","content":["S'oossay Ubbaappe Bolla Kaatiyaa"]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Godaw ooratsa yetsaa yes's'ite;","poem":1},{"text":"sa'aan de'iyaa asay, ubbay Med'inaa Godaw yes's'ite.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Med'inaa Godaw yes's'ite; Aa suntsaa sabbite;","poem":1},{"text":"I ashshiyaa mishiraachchuwaa gallassaan gallassaan odite.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kawutetsaa giddon Aa bonchchuwaa,","poem":1},{"text":"asaa ubbaa giddon Aa malalissiyaa oosuwaabaa awaayite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ayaw gooppe, Med'inaa Goday wolk'k'aama;","poem":1},{"text":"gita galatay aw bessee.","poem":2},{"text":"S'oossatuwaa ubbaappe aad'd'iide I yayettanaw bessee.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hara asaa s'oossatuu ubbay eek'atuwaa;","poem":1},{"text":"shin Med'inaa Goday salotuwaa med'd'eedda S'oossaa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bonchchuunne anggay Aa yuushshuwaan de'ee;","poem":1},{"text":"minotetsaynne puulay Aa Geeshsha Golliyaan de'ee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hinttenoo, asaa zaretoo ubbatoo,","poem":1},{"text":"Med'inaa Godaabaa odite;","poem":2},{"text":"«Bonchchuunne wolk'k'ay Med'inaa Godaassa» giide odite.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"«Bonchchuu Aa suntsaassa»","poem":1},{"text":"giide Med'inaa Godaabaa odite.","poem":2},{"text":"Yarshshuwaa akkiide, Aa dabaabaa gelite.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aa geeshshatetsaa puulan Med'inaa Godaw goyinnite;","poem":1},{"text":"biittan de'iyaa asaa ubbaw, Aa sintsan kokkorite.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kawutetsatuwaa giddon, «Med'inaa Goday kaateteedda!","poem":1},{"text":"Sa'ay min ek'k'eedda; ubbakka k'aas's'enna.","poem":2},{"text":"I asaa bolla suuretetsan pirddana» yaagite.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Salotuu nashetino; sa'aykka hashshu go;","poem":1},{"text":"abbayinne Aa giddon kumeeddawe guummo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Shoyk'aynne shoyk'an de'iyaa ubbay nashetto!","poem":1},{"text":"Woran de'iyaa mitsaa ubbaykka nashshechchan Aa sintsan yes's'ana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ayaw gooppe, Med'inaa Goday yee;","poem":1},{"text":"I sa'aa bollan pirddanaw yee;","poem":2},{"text":"I ha sa'aa bolla s'illotetsan,","poem":1},{"text":"asaa bollakka tumatetsan pirddana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}