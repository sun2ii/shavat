{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":97,"content":[{"type":"heading","content":["S'oossay Ubbaappe Bolla"]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Goday kawuteedda.","poem":1},{"text":"Sa'aan de'iyaa Asay nashetto;","poem":2},{"lineBreak":true},{"text":"haakko haatsaan dooddetto saan de'iyaa asatuukka nashetino.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Shaariinne d'ip'p'i go d'umay Aa dooddeedda.","poem":1},{"text":"S'illotetsaynne tumatetsay Aa kawutetsaa araataw baaso.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tamay aappe sintsanna bee;","poem":1},{"text":"Aa dooddeedda morkkatuwaa s'uuggee.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Aa walk'k'antsay sa'aa poo'issee;","poem":1},{"text":"biittay hewaa be'iide kokkoree.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Med'inaa Godaa sintsan, sa'aa ubbaa Godaa sintsan","poem":1},{"text":"wogga deretuu eessaa muk'aaddaadan muushiino.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Salotuu Aa s'illotetsaa awaayiino;","poem":1},{"text":"asay ubbay Aa bonchchuwaa be'ee.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Worddo s'oossatoo goyinniyaawanttunne","poem":1},{"text":"he go\"enna eek'atuwaan c'eek'ettiyaawanttu ubbay yeellatino.","poem":2},{"text":"S'oossatuu ubbay S'oossaw gulbbatino.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Abeet Med'inaa Godaw, S'iyoone asay,","poem":1},{"text":"ne s'illo pirddaa sisiide nashettee;","poem":2},{"text":"Yihudaa katamatuwaa asaykka hashshu gee.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Abeet Med'inaa Godaw, neeni sa'aa ubbaappe d'ok'k'aasa;","poem":1},{"text":"s'oossatuwaa ubbaappe neeni d'ok'k'u gaasa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Med'inaa Godaa siik'iyaawanttu iitaa is's'ite.","poem":1},{"text":"I barew amanetiyaa asatuwaa shemppuwaa naagee;","poem":2},{"lineBreak":true},{"text":"k'ay unttuntta iitatuwaa kushiyaappe ashshee.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"S'illotoo poo'uu poo'ee;","poem":1},{"text":"wozanaa suuretoo nashechchay de'ee.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hinttenoo s'illotoo, Med'inaa Godaan nashettite;","poem":1},{"text":"Aa geeshsha suntsaa galatite.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}