{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":98,"content":[{"type":"heading","content":["S'oossay Alamiyaa Mooddiyaawaa"]},{"type":"hebrew_subtitle","content":["Mazimuriyaa"]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Godaw ooratsa yetsaa yes's'ite;","poem":1},{"text":"ayaw gooppe, I malalissiyaabaa ootseedda.","poem":2},{"text":"Aa ushechcha kushiinne Aa geeshsha k'eesii","poem":1},{"text":"aw s'oonuwaa immeedda.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Med'inaa Goday bare s'oonuwaa erisseedda;","poem":1},{"text":"I ashshiyaawaa kawutetsatoo k'onc'c'isseedda.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"I Israa'eeliyaa soo asaa siik'iyaawaanne","poem":1},{"text":"unttunttoo ammanettiyaawaa hassayeedda.","poem":2},{"text":"Sa'aa gas'aa gakkanaw de'iyaa Asay ubbay","poem":1},{"text":"nu S'oossay ashiyaawaa be'eedda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Sa'aa bollan de'iyaa asaa ubbay,","poem":1},{"lineBreak":true},{"text":"Med'inaa Godaw nashshechchan yes's'ite;","poem":1},{"text":"k'aalaa d'ok'k'u ootsiide, nashshechchaa sabaa sabbite.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Diitsaa Med'inaa Godaw diis's'ite;","poem":1},{"text":"diitsaaninne yetsan S'oossaa sabbite.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"S'urumbbaanne lookkuwaa punniidde,","poem":1},{"text":"nashshechchan Med'inaa Godaa nu kaatiyaa sintsan hombboc'ite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Abbayinne abbaa giddon kumeeddawe ubbay guummo.","poem":1},{"text":"Sa'aynne sa'aa bollan de'iyaa ubbay yes's'o.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Shaafatuu ittippe barenttu kushiyaa bak'k'ino.","poem":1},{"text":"K'eeri deretuu Med'inaa Godaa sintsan ittippe nashshechchan yes's'ino.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ayaw gooppe, I sa'aa bollan daannatanaw yee.","poem":1},{"text":"I ha sa'aa bolla s'illotetsan,","poem":2},{"lineBreak":true},{"text":"asaa bollakka suuretetsan daannatana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}