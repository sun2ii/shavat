{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"PSA","translationId":"dwr_ltw","name":"Mazimuriyaa","commonName":"Mazimuriyaa","title":"Mazimuriyaa Mas'aafaa","order":19,"numberOfChapters":150,"sha256":"67c8597b1d430fd9f8f781ffa0110081ce7636a7da2b64ca3aa39525c139791c","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/dwr_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":99,"content":[{"type":"heading","content":["S'oossay S'illuwaanne Geeshsha"]},{"type":"verse","number":1,"content":[{"text":"Med'inaa Goday kawuteedda! Hewoo asatuu kokkorino.","poem":1},{"text":"Kiruubetuwaappe gidduwaan kawutetsaa araataa bolla utteedda;","poem":2},{"lineBreak":true},{"text":"hewoo biittay k'aas's'o;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Med'inaa Goday S'iyoonen wolk'k'aama;","poem":1},{"text":"kawutetsaa ubbaappe I d'ok'k'u d'ok'k'u geedda.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Daroppe yashshiyaa Aa wolk'k'aama suntsaa,","poem":1},{"text":"unttunttu ubbay galatino.","poem":2},{"text":"I geeshsha!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Neeni, wolk'k'aama kaatii, likke pirddaa dosaasa.","poem":1},{"text":"Neeni Yaak'ooba asaw suuretetsaa minisaadda.","poem":2},{"text":"S'illotetsaanne likke pirddaa essaadda.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Med'inaa Godaa nu S'oossaa d'ok'k'u d'ok'k'u ootsite;","poem":1},{"text":"Aa gedii yed'd'iyaasaan guufanniide aw goyinnite.","poem":2},{"text":"I geeshsha!","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Musenne Aaroone Aa k'esetuwaa gidduwaappe laa\"atuwaa;","poem":1},{"text":"Sameelikka Aa suntsan woosseeddawanttuppe ittuwaa.","poem":2},{"text":"Unttunttu Med'inaa Godaw waasseeddino;","poem":1},{"text":"ikka unttunttoo alleeda.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I shaariyaa tuussaa gidduwaana unttunttoo haasayeedda;","poem":1},{"text":"unttunttu I immeedda higgiyaanne wogaa naageeddino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Abeet Med'inaa Godaw, nu S'oossaw,","poem":1},{"text":"neeni unttunttu woosaa sisaadda.","poem":2},{"text":"Neeni unttunttu iitatetsaa diraw mureeddawaa gidooppekka,","poem":1},{"text":"unttunttoo atto geedda S'oossaa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Med'inaa Godaa nu S'oossaa, d'ok'k'u d'ok'k'u ootsite;","poem":1},{"text":"Aa geeshsha deriyaa bollan aw goyinnite;","poem":2},{"lineBreak":true},{"text":"ayaw gooppe, Med'inaa Goday nu S'oossay geeshsha!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}