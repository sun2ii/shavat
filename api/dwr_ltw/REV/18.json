{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"REV","translationId":"dwr_ltw","name":"Yohaannisa Sas'aa","commonName":"Yohaannisa Sas'aa","title":"Yohaannisaw Yeedda Sas'aa","order":66,"numberOfChapters":22,"sha256":"31d906692a67a386ff08ecd99e999995e61e76940568712e81fa11bb7929ad9d","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/dwr_ltw/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":18,"content":[{"type":"heading","content":["Baablooni Kunddetsaa"]},{"type":"verse","number":1,"content":["Hewaappe guyyiyaan, wolk'k'aama maatay de'iyaa hara kiitanchchay saluwaappe wod'd'ishin, taani be'aaddi. He kiitanchchaa bonchchuu sa'aa poo'isseedda."]},{"type":"verse","number":2,"content":["He kiitanchchay bare kooshshaa d'ok'k'u ootsiide,",{"text":"«Iza kunddaaddu!","poem":1},{"text":"Wolk'k'aama Baabloona kunddaaddu!","poem":2},{"text":"Baabloona s'alahatuu ak'iyaasaa gidaaddu;","poem":1},{"text":"iita ayyaanatuu ubbatuunne,","poem":2},{"lineBreak":true},{"text":"is'ettiyaa iita kafatuu ubbatuu iini de'iino.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ayaw gooppe, asaa zariyaa ubbaa,","poem":1},{"text":"bare matsoyiyaa woyniyaa eessaa ushshina,","poem":2},{"lineBreak":true},{"text":"izinna woshummeeddino.","poem":2},{"lineBreak":true},{"text":"K'aykka sa'aa kaatatuu,","poem":2},{"lineBreak":true},{"text":"izinna woshummeeddino.","poem":2},{"lineBreak":true},{"text":"Izi ishalo wolk'k'aa gaasuwaan,","poem":2},{"lineBreak":true},{"text":"sa'aan de'iyaa zal\"anchchatuu duretteeddino»","poem":2},"yaageedda."]},{"type":"verse","number":4,"content":[{"text":"Hewaappe guyyiyaan,","poem":1},{"text":"taani saluwaappe,","poem":2},{"lineBreak":true},{"text":"hawaadan yaagiyaa hara kooshshaa sisaad;","poem":2},{"lineBreak":true},{"text":"«Ta asaw, iippe kesite!","poem":2},{"text":"Izi nagaraa izinna kos's'oppite!","poem":1},{"text":"Izi muraa gishettoppite.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ayaw gooppe, izi nagaray,","poem":1},{"text":"saluwaa gakkanaw dooretti utteedda.","poem":2},{"text":"S'oossay izi iita bayizzuwaa, hassayeedda.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Iza immeeddawaa keenaa zaariide,","poem":1},{"text":"iziw immite. Iza ootseeddawoo,","poem":2},{"lineBreak":true},{"text":"laa\"u kushiyaa iziw k'ans's'ite.","poem":2},{"lineBreak":true},{"text":"Iza hinttenttoo giigisseedda ushshaappe,","poem":2},{"lineBreak":true},{"text":"laa\"u kushiyaa ushshaa,","poem":2},{"lineBreak":true},{"text":"izi burc'c'ukkuwaa kuntsite.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iza bonchchetteeddawaanne,","poem":1},{"text":"ishaleeddawaa keenaa,","poem":2},{"lineBreak":true},{"text":"izo tuggayitenne kayyoyite.","poem":2},{"lineBreak":true},{"text":"Iza bare wozanaan,","poem":2},{"text":"‹Taani kaatattiidan uttay;","poem":1},{"text":"taani asinay baynna mac'c'awuno gidikke;","poem":2},{"lineBreak":true},{"text":"k'ay ubbaakka kayyottikke› yaagaw.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hewaa diraw, izi boshaa ubbay,","poem":1},{"text":"harggii, kayyuunne koshay,","poem":2},{"lineBreak":true},{"text":"izo itti gallassi oyk'k'ana.","poem":2},{"lineBreak":true},{"text":"K'ay iza taman guudettana;","poem":2},{"lineBreak":true},{"text":"ayaw gooppe,","poem":2},{"lineBreak":true},{"text":"izi bolla pirddiyaa Godaa S'oossay, Wolk'k'aama»","poem":2},"yaageedda."]},{"type":"verse","number":9,"content":["Sa'aa kaatatuu, izina woshummiidde ishaleeddawanttu he katamata guudettina, kesiyaa c'uwaa be'eedda wode, katamatiw unttunttu waassananne yeekkana."]},{"type":"verse","number":10,"content":["Unttunttu he katamati ugaw yayyeedda diraw, haakki ek'k'iide, «Ha wolk'k'aama katamatee! Wolk'k'aama katamatee! Baabloonee, new aayyeero! Neeni ay mala tuggattaniishsha. Neeni itti saatiyaa giddon ne pirddaa akkaada» yaagana."]},{"type":"verse","number":11,"content":["Unttunttu markkabiyaa c'aanaa hawaappe sintsanaw shammiyaabay baynna diraw, sa'aan de'iyaa zal\"anchchatuu he katamatiw waassananne kayyottana."]},{"type":"verse","number":12,"content":["Unttunttu work'k'aa, biraa, bonchcho shuchchaa, ink'k'uwaa geetettiyaa al\"o shuchchaa, teeraa oochcha malatiyaa mayuwaa, suufiyaa mala mayuwaa, hariyaa geetettiyaa mayuwaa, zo'o mayuwaa, ubbaa k'ommo sawiyaa mitsaa, ubbaa k'ommuwaan ootseedda danggarssaa achchaa, al\"o mitsaappe med'etteeddabaa, nahaasiyaa, birataa, Ibineberediyaa geetettiyaa shuchchaa,"]},{"type":"verse","number":13,"content":["k'arafaa, k'imaamiyaa, is'aanaa, shittuwaa, sawiyaa is'aanaa d'iiliyaa, woyniyaa eessaa, wogaraa zayitiyaa, liik'eedda d'iiliyaa, zarggaa, miizzaa, dorssaa, paraanne paray goochchiyaa gaariyaa, unttunttu ayiletuwaanne haray atto asaa shemppuunne shammiyaabaykka baawa."]},{"type":"verse","number":14,"content":[{"text":"Zal\"anchchatuu mishirattiw,","poem":1},{"text":"«Neeni amotteedda,","poem":2},{"lineBreak":true},{"text":"lo\"obay ubbay neeppe hali diggeedda.","poem":2},{"lineBreak":true},{"text":"Ne de'uunne,","poem":2},{"lineBreak":true},{"text":"alleek'k'ettiyaabay ubbay d'ayidiggeedda.","poem":2},{"lineBreak":true},{"text":"Neeni laa'entso unttuntta ubbaakka demmakka»","poem":2},"yaageeddino."]},{"type":"verse","number":15,"content":["He katamatin zal\"iide duretteedda zal\"anchchatuu izi ugaw yayyiide, iippe haakkiide ek'k'ana. Unttunttu yeekkananne kayyottana."]},{"type":"verse","number":16,"content":["K'ay,",{"text":"«Suufiyaa geetettiyaa,","poem":1},{"text":"kiriyaan dadetteedda mayuwaa,","poem":2},{"lineBreak":true},{"text":"teera ochchaa malatiyaa,","poem":2},{"lineBreak":true},{"text":"mayuwaanne zo'o mayuwaa mayyaade,","poem":2},{"lineBreak":true},{"text":"work'k'aa alleek'k'uwaan,","poem":2},{"lineBreak":true},{"text":"bonchcho shuchchaaninne,","poem":2},{"lineBreak":true},{"text":"ink'k'uwaa geetettiyaa al\"o shuchchaan alleek'k'eedda,","poem":2},{"lineBreak":true},{"text":"he wolk'k'aama katamatiw aayyeero!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hawaa keena wolk'k'aama mas'uu ubbay,","poem":1},{"text":"itti saatiyaa giddon, dippi gi d'ayi aggeedda»","poem":2},"yaageeddino. Markkabiyaa laaggiyaa ubbatuu, markkabiyaan biyaa ubbatuu, markkabiyaan ootsiyaa ubbatuunne abbaan ootsi go\"ettiyaa ubbatuu haakki ek'k'eeddino."]},{"type":"verse","number":18,"content":["He katamata guudettina kesiyaa c'uwaa be'eedda wode barenttu kooshshaa d'ok'k'u ootsiide, «Ha wolk'k'aama katamato malatiyaa katamay ubbaakka baawa» yaageeddino."]},{"type":"verse","number":19,"content":["Unttunttu barenttu huup'iyaan baana k'oliide, waasseeddinonne kayyotteeddino;",{"text":"«Abbaan markkabatuu de'iyaa ubbaa,","poem":1},{"text":"bare mak'uwaan dureyeedda,","poem":2},{"lineBreak":true},{"text":"wolk'k'aama katamatiw aayyeero!","poem":2},{"lineBreak":true},{"text":"K'ay iziw de'iyaabay ubbay","poem":2},{"lineBreak":true},{"text":"itti saatiyaa giddon d'ayi aggeeda.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"He katamata d'ayeedda diraw,","poem":1},{"text":"saloo, nashetta!","poem":2},{"text":"Geeshshatoo, Yesuusi kiitteeddawanttoo,","poem":1},{"text":"nabatoo, nashettite!","poem":2},{"lineBreak":true},{"text":"Ayaw gooppe,","poem":2},{"lineBreak":true},{"text":"iza hinttentta ootseeddawaa diraw,","poem":2},{"lineBreak":true},{"text":"S'oossay izo pirddeedda» yaageedda.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hewaappe guyyiyaan,","poem":1},{"text":"wolk'k'aama kiitanchchay,","poem":2},{"lineBreak":true},{"text":"wos'aa malatiyaa wolk'k'aama shuchchaa,","poem":2},{"lineBreak":true},{"text":"dentsi abbaan oliide hawaadan yaageedda;","poem":2},{"text":"«Wolk'k'aama katamata,","poem":1},{"text":"Baabloona, sugina hawaadan kunddana;","poem":2},{"lineBreak":true},{"text":"iza hachcheppe sintsaw, ubbaakka beettukku.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Diitsaa diis's'iyaawanttunne,","poem":1},{"text":"mazimuriyaa yes's'iyaawanttu,","poem":2},{"lineBreak":true},{"text":"suusulliyaanne malakataa punniyaawanttu,","poem":2},{"lineBreak":true},{"text":"kooshshay hawaappe hini baggan,","poem":2},{"lineBreak":true},{"text":"ne giddon ubbakka sisettenna.","poem":2},{"text":"Kushiyaa hiillaa eriyaa ooninne,","poem":1},{"text":"laa'entso ubbakka de'enna.","poem":2},{"text":"Wos'aa kooshshaykka","poem":1},{"text":"hawaappe sintsaw ne giddon sisettenna.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"S'omppiyaa poo'uukka laa'entsuwaa ne giddon poo'enna.","poem":1},{"text":"Akkiyaawaa kooshshaynne gelewunni kooshshay,","poem":2},{"lineBreak":true},{"text":"sintsaw ne giddon sisettenna.","poem":2},{"lineBreak":true},{"text":"Ne zal\"anchchatuu sa'aa ubbaan,","poem":2},{"lineBreak":true},{"text":"eretteedda wolk'k'aamatuwaa.","poem":2},{"lineBreak":true},{"text":"Ne bitiyaawan asaa zariyaa ubbay c'imetteedda.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nabatuwaa suutsay,","poem":1},{"text":"geeshshatuwaa suutsaynne,","poem":2},{"lineBreak":true},{"text":"sa'aan hayk'k'eedda ubbatuwaa suutsay,","poem":2},{"lineBreak":true},{"text":"izin beetteedda diraw,","poem":2},{"text":"Baabloona, murettaaddu»","poem":1},"yaageedda."]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}