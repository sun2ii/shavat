{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"REV","translationId":"dwr_ltw","name":"Yohaannisa Sas'aa","commonName":"Yohaannisa Sas'aa","title":"Yohaannisaw Yeedda Sas'aa","order":66,"numberOfChapters":22,"sha256":"31d906692a67a386ff08ecd99e999995e61e76940568712e81fa11bb7929ad9d","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/dwr_ltw/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":7,"content":[{"type":"heading","content":["Israa'eeliyaa Asaappe 144,000 Asatuwaa Som\"iyaan Maatafay Wod'd'eedda"]},{"type":"verse","number":1,"content":["Hewaappe guyyiyaan, taani oyddu kiitanchchatuu oyddu bagga sa'aa gas'aan ek'k'eeddawantta be'aaddi. He kiitanchchatuu sa'aa bollan, woy abbaa bollan, woy ay mitsaa bollan, c'arkkuu c'arkkennaadan te\"eeddino."]},{"type":"verse","number":2,"content":["K'aykka de'uwaa S'oossaa maatafaa oyk'k'iide hara kiitanchchay away mokkiyaasaappe kesiyaawaa taani be'aaddi. He kiitanchchay bare kooshshaa d'ok'k'u ootsiide, sa'aanne abbaa k'ohanaw wolk'k'ay imetteedda oyddu kiitanchchatuwaa"]},{"type":"verse","number":3,"content":["s'eesiide, «Nu S'oossaa oosanchchatuwaa deemuwaan nuuni maatafaa wotsana gakkanaw, sa'aa gidina woy abbaa gidina, woy mitsaa gidinakka k'ohoppite» yaageedda."]},{"type":"verse","number":4,"content":["Taani S'oossaa maatafaa deemuwaan wotseeddawanttu payduwaa sisaad. Israa'eeliyaa zariyaa ubbaappe itti s'eetanne oytamanne oyddu sha\"a asatuwaa deemuwaan maatafay wod'd'eedda."]},{"type":"verse","number":5,"content":[{"text":"Yihudaa zariyaappe,","poem":1},{"text":"tammanne laa\"u sha\"aa deemuwaan maatafay,","poem":2},"wod'd'eedda.",{"text":"Roobeela zariyaappe,","poem":1},{"text":"tammanne laa\"u sha\"aa.","poem":2},{"text":"Gaade zariyaappe,","poem":1},{"text":"tammanne laa\"u sha\"aa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Aaseera zariyaappe,","poem":1},{"text":"tammanne laa\"u sha\"aa.","poem":2},{"text":"Nifttaaleeme zariyaappe,","poem":1},{"text":"tammanne laa\"u sha\"aa.","poem":2},{"text":"Minaase zariyaappe,","poem":1},{"text":"tammanne laa\"u sha\"aa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Simoona zariyaappe","poem":1},{"text":"tammanne laa\"u sha\"aa.","poem":2},{"text":"Leewiyaa zariyaappe","poem":1},{"text":"tammanne laa\"u sha\"aa.","poem":2},{"text":"Yisaakoora zariyaappe","poem":1},{"text":"tammanne laa\"u sha\"aa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Zaabiloona zariyaappe,","poem":1},{"text":"tammanne laa\"u sha\"aa.","poem":2},{"text":"Yooseefo zariyaappe,","poem":1},{"text":"tammanne laa\"u sha\"aa.","poem":2},{"text":"Biiniyaama zariyaappe,","poem":1},{"text":"tammanne laa\"u sha\"aa","poem":2},{"lineBreak":true},{"text":"deemuwaan maatafay,","poem":2},"wod'd'eedda."]},{"type":"heading","content":["Bootsa Mayuwaa Mayyeedda C'ora Asatuwaa"]},{"type":"verse","number":9,"content":["Hewaappe guyyiyaan, zariyaa ubbaappe, k'ommuwaa ubbaappe, yaraa ubbaappenne dumma dumma gadiyaa k'aalaa ubbaappe ooninne paydanaw danddayenna zaway baynna c'ora asaa taani be'aaddi. He Asay bootsa mayuwaa mayyiide, zambbaa haytsaa barenttu kushiyan oyk'k'iide, kawutetsaa oydiyaa sintsaninne Dorssaa sintsan ek'k'eedda."]},{"type":"verse","number":10,"content":["Unttunttu barenttu k'aalaa d'ok'k'u ootsiide,",{"text":"«Nu atotetsaykka,","poem":1},{"text":"kawutetsaa oydiyaan utteedda,","poem":2},{"lineBreak":true},{"text":"nu S'oossaappenne Dorssaappe yee»","poem":2},"yaageeddino."]},{"type":"verse","number":11,"content":["Kiitanchchatuu ubbay kawutetsaa oydiyaa, c'imatuwaanne de'uwaan de'iyaa oyddu med'etaa yuuyyi aad'd'iide ek'k'eeddino. Unttunttu kawutetsaa oydiyaa sintsan barenttu deemuwaan guufanniide S'oossaw goyinniidde,"]},{"type":"verse","number":12,"content":[{"text":"«Amen\"i!","poem":1},{"text":"Anjjuu, bonchchuu,","poem":2},{"lineBreak":true},{"text":"aad'd'eedda eratetsay,","poem":2},{"lineBreak":true},{"text":"galatay, sabay,","poem":2},{"lineBreak":true},{"text":"wolk'k'ay, minotetsay,","poem":2},{"lineBreak":true},{"text":"med'inaappe med'inaa gakkanaw nu S'oossaw gido.","poem":2},{"text":"Amen\"i!»","poem":1},"yaageeddino."]},{"type":"verse","number":13,"content":["C'imatuwaappe ittuu taana, «Ha bootsa mayuwaa mayyeedda asatuu oonee? Unttunttu hak'appe yeeddinoo?» yaagiide oochcheedda."]},{"type":"verse","number":14,"content":["Taani, «Ta Godaw, neeni eraasa» yaagaad. I taana hawaadan yaageedda:",{"lineBreak":true},{"text":"«Hawanttu daro waayiyaa waayettiide yeeddawantta.","poem":1},{"text":"Unttunttu barenttu mayuwaa Dorssaa suutsan meec'c'iide,","poem":2},{"lineBreak":true},{"text":"boos's'eeddawantta.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hewaa diraw,","poem":1},{"text":"unttunttu S'oossaa kawutetsaa oydiyaa sintsan ek'k'iide,","poem":2},{"lineBreak":true},{"text":"k'ammanne gallassi, Aa Geeshsha Golliyaan,","poem":2},{"lineBreak":true},{"text":"aw ootsiino.","poem":2},{"text":"K'ay I bare kawutetsaa oydiyaan utteeddawe,","poem":1},{"text":"unttunttu gidduwaan de'ana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hawaappe sintsanaw ubbakka,","poem":1},{"text":"unttunttu koshattikkino;","poem":2},{"lineBreak":true},{"text":"woy saamettikkino.","poem":2},{"lineBreak":true},{"text":"Away unttuntta meenna;","poem":2},{"lineBreak":true},{"text":"k'ay ay seelaykka unttuntta guuddenna.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ayaw gooppe, kawutetsaa oydew,","poem":1},{"text":"gidduwaan utteedda Dorssay,","poem":2},{"lineBreak":true},{"text":"unttuntta heemmana.","poem":2},{"lineBreak":true},{"text":"De'uwaa haatsaa pulttuwaakkokka,","poem":2},{"lineBreak":true},{"text":"unttuntta kaaletsana.","poem":2},{"lineBreak":true},{"text":"S'oossaykka unttunttu ayfiyaa afotsaa ubbaa k'uc'c'i diggana»","poem":2},"yaageedda."]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/REV/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/REV/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/REV/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}