{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"SNG","translationId":"dwr_ltw","name":"Siik'uwaa Sabaa","commonName":"Siik'uwaa Sabaa","title":"Siik'uwaa Sabbiyaa Mas'aafaa","order":22,"numberOfChapters":8,"sha256":"1590544b06e5147382a14e3ff76686d8aca72fdfa03c71a4946acad69470ea38","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/dwr_ltw/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"K'amma kumentsaa ta hiis'an gisaade,","poem":1},{"text":"ta siik'uwaa demmanaw amottaad; minisaade koyaad;","poem":2},{"lineBreak":true},{"text":"shin demmanaw danddayabeykke.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Katamaa giddon de'iyaa aakonne s'untsa ogetuwaa ubbaan yuuyyaad;","poem":1},{"text":"ta siik'uwaa demmanaw koyaad; minisaade koyaad;","poem":2},{"lineBreak":true},{"text":"shin demmanaw danddayabeykke.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Katamaa yuuyyi naagiyaawanttu taana demmeeddino;","poem":1},{"text":"taanikka, Ta siik'uwaa be'eeditee? yaagaade unttuntta oochchaad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Unttunttuppe yaa aad'anne ta siik'uwaa demma aggaad.","poem":1},{"text":"I taappe kessi akkenaadan, minisaade oyk'k'aad;","poem":2},{"lineBreak":true},{"text":"ta daayi golle akka afaad; ta yeletteedda kifiliyaa gelissaad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hinttenoo Yerusaalame yalaga mac'c'a asaw,","poem":1},{"text":"siik'uu barew dosiide denddana gakkanaw,","poem":2},{"lineBreak":true},{"text":"Aa hintte beegotsena mala,","poem":2},{"lineBreak":true},{"text":"taani hinttena gen\"etuwaaninne bazzuwaa dogetuwaan c'allay yaagaaddu.","poem":2}]},{"type":"heading","content":["Soyzzuwaabaa"]},{"type":"verse","number":6,"content":[{"text":"Hawe bazzuwaana yiyaawe, c'uwaa tuussaa malatiyaawe,","poem":1},{"text":"peenuukka zal\"anchchaa is'aanaadaaninne kawaraadan,","poem":2},{"lineBreak":true},{"text":"sawiyaawe I oonee?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hewaa be'ite, Solomona paraa gaarii yee;","poem":1},{"text":"he paraa gaarii Israa'eeliyaappe dooretteedda wolk'k'aamatuu,","poem":2},{"lineBreak":true},{"text":"usuppun tammu tooranchchatuu ajabeedino.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Unttunttu ubbaykka mashshaa oyk'k'etsaa meezeteeddawanttanne,","poem":1},{"text":"olankka paac'etteeddawantta.","poem":2},{"lineBreak":true},{"text":"K'amman gakkana metuwaa ek'ettanaw,","poem":2},{"lineBreak":true},{"text":"unttunttu ittuu ittuu mashshaa gis's'iide giigeeddawantta.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kaatiyaa Solomon paraa gaariyaa giddon,","poem":1},{"text":"barew uttiyaa kawutetsaa araataa giigisseedda.","poem":2},{"lineBreak":true},{"text":"I araataa Liibaanoosa asaappe aheedda mitsaappe oosisseedda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Araataa tuussatuu biran sheeshetteeddino;","poem":1},{"text":"gedii work'k'aan alleek'k'etteedda;","poem":2},{"lineBreak":true},{"text":"uttiyaasay Yerusaalame wodoratuu ochchaa teeraa malatiyaa k'ac'inan,","poem":2},{"lineBreak":true},{"text":"siik'uwaan daddeedda afilaan kameteedda yaageeddino.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hinttenoo, S'iyoone wodoratoo, Kaatiyaa Solomona be'anaw haayite!","poem":1},{"text":"I loytsi nashetteedda, Aa bullachchaa gallassi Aa aata Aa huup'iyaan,","poem":2},{"lineBreak":true},{"text":"wotseedda kallachchaa wotsiide utteedda yaagaaddu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}