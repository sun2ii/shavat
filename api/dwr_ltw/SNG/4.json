{"translation":{"id":"dwr_ltw","name":"Geeshsha Mas'aafaa","website":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrl","licenseNotes":null,"shortName":"LTW","englishName":"The Holy Bible in the Dawuro language of Ethiopia, Latin script","language":"dwr","textDirection":"ltr","sha256":"ab055d431ee34bbbdc33ade922e85721fe9eca7417281c876fded21139363ea3","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30815,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"SNG","translationId":"dwr_ltw","name":"Siik'uwaa Sabaa","commonName":"Siik'uwaa Sabaa","title":"Siik'uwaa Sabbiyaa Mas'aafaa","order":22,"numberOfChapters":8,"sha256":"1590544b06e5147382a14e3ff76686d8aca72fdfa03c71a4946acad69470ea38","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_ltw/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/dwr_ltw/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Ta siik'k'atee, neeni ayaa malanchchatii! Neeni woota lo\"ay!","poem":1},{"text":"Ne ayifetuu ne som\"uwaa kammiyaa sharbbe gidduwaana be'iyaa wode,","poem":2},{"lineBreak":true},{"text":"harap'p'iyaadan lo\"iino.","poem":2},{"lineBreak":true},{"text":"Ne binnaanay Gala'aade Deriyaappe wod'd'iyaa deeshshaa wudiyaa mala.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne achchay meedettiide, haatsaan meec'etteedda ubbaykka manttiyaa yeliyaa,","poem":1},{"text":"unttunttu giddon maynii bayinna dorssaa wudiyaa mala.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne mettershshatuu zo'o k'ac'inaa mala;","poem":1},{"text":"ne haasayiyaa wode daro nashechchiino.","poem":2},{"lineBreak":true},{"text":"Ne laa\"u gac'otuwaa sharbbiyaa gidduwaana s'eelliyaa wode,","poem":2},{"lineBreak":true},{"text":"itti roomaaniyaa laa\"u kessi p'alk'k'eeddawaa malatiino.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne k'ood'ii olaa miishshaa kak'k'anaw gimbbeedda,","poem":1},{"text":"Daawita adussa gimbbiyaa malatee;","poem":2},{"lineBreak":true},{"text":"he gimbbii sha\"u mino olanchchatuwaa gonddallii kak'ettina,","poem":2},{"lineBreak":true},{"text":"alleek'k'etti utteedda.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne d'antsatuu manttiyaa yeletteedda,","poem":1},{"text":"wora c'iishshaa giddon miyaa gen\"iyaa maratuwaa malatiino.","poem":2}]},{"type":"heading","content":["Soyzzuwaa Ittipetetsaa"]},{"type":"verse","number":6,"content":[{"text":"K'ammay wonttanaw, kuway kichchanaw,","poem":1},{"text":"karbbiyaa deriyaanne is'aanaa zooziyaa baade shemppashshana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta siik'k'atee, ne asatetsay ubbaykka malanchcha;","poem":1},{"text":"neenan wotsiyaawe ayaynne baawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ta mushurattee, Liibaanoosa Deriyaappe wod'd'a.","poem":1},{"text":"Gaammuunne maahii geessuu Amaana Deriyaappe,","poem":2},{"lineBreak":true},{"text":"Saniira Deriyaappenne Hermmoone kiikiyaappe wod'd'a.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ta siik'uwaa michchato gidiyaa ta siik'attee!","poem":1},{"text":"Ne ayifiyaa s'eeluunne ne k'ood'iyaa alleek'k'uu,","poem":2},{"lineBreak":true},{"text":"ta wozanaa nashshechchan gooshsheedda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta siik'uwaa michchato gidiyaa ta mushurate!","poem":1},{"text":"Ne siik'uu taana ayaa nashechchii!","poem":2},{"lineBreak":true},{"text":"Ne siik'uu woyniyaa eessaappe aad'd'i nashechchee;","poem":2},{"lineBreak":true},{"text":"ne shittuu ubbabaappekka aad'd'iide sawee.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta mushurattee, ne mettershshaanna eessaa ililuu s'okee.","poem":1},{"text":"Ne doonaappe eessaynne maatsay pulttee;","poem":2},{"lineBreak":true},{"text":"ne mayuu Liibaanoosa s'iidday sawiyaawaadan sawee.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ta siik'uwaa michchato gidiyaa ta mushurati yuushshuu,","poem":1},{"text":"direttiide naagettiyaa ataakilttiyaa sa'aa mala.","poem":2},{"lineBreak":true},{"text":"Yuushshuu gimbbetteedda pulttuwaa,","poem":2},{"lineBreak":true},{"text":"maatafay attametteedda goggiyaa haatsaa mala.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ne ataakilttetuwaa giddon: roomaanii,","poem":1},{"text":"dooretteedda ataakilttiyaa ayifetuu,","poem":2},{"lineBreak":true},{"text":"heenayinne narddoosiyaa giyaawanttu de'iino.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hewaadankka k'ay narddoosii,","poem":1},{"text":"laadii, sawuwaa maataynne k'arafay,","poem":2},{"lineBreak":true},{"text":"hewaadankka is'aanaadan sawiyaabatuu de'iino;","poem":2},{"lineBreak":true},{"text":"hewaadankka k'ay karbbii,","poem":2},{"lineBreak":true},{"text":"godare uutsaa c'iishshaynne dumma dumma k'imaamiyaa ataakilttetuu mokkiino.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Neeni ataakilttiyaa sa'aa aliyaa pulttuwaa mala;","poem":1},{"text":"de'uwaa haatsay beettiyaa ollaa mala;","poem":2},{"lineBreak":true},{"text":"Liibaanoosa Deriyaappe goggiyaa shaafaa mala yaageedda.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Huup'issa bagga c'arkkoo, dendda!","poem":1},{"text":"Gedissa bagga c'arkkoo, haaya!","poem":2},{"lineBreak":true},{"text":"Ta ataakilttiyaa bolla c'arkka! Aa sawuu hewan toshukku go.","poem":2},{"lineBreak":true},{"text":"Ta siik'uu bare ataakilttiyaa giddo yo.","poem":2},{"lineBreak":true},{"text":"Daro mal\"iyaa teeratuwaa mo yaagaaddu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/dwr_ltw/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_ltw/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_ltw/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}