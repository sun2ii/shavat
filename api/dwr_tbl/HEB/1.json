{"translation":{"id":"dwr_tbl","name":"Ooratha Caaquwaa","website":"https://ebible.org/Scriptures/details.php?id=dwrNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrNT","licenseNotes":null,"shortName":"TBL","englishName":"Dawro NT (Latin script)","language":"dwr","textDirection":"ltr","sha256":"2aeb131354f8bee8eb5f5f6358660382d5824342b5175ff0e92a55a60ed35162","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_tbl/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7805,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"HEB","translationId":"dwr_tbl","name":"Ibraawe","commonName":"Ibraawe","title":"Ibraawe Asaw Xaafetteedda Kiitaa","order":58,"numberOfChapters":13,"sha256":"5fe1135bbe84b0784c9942c86e61b5ac69a9445c98c15d7aa1f53b11c7a6395b","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_tbl/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/dwr_tbl/HEB/13.json","totalNumberOfVerses":298},"chapter":{"number":1,"content":[{"type":"heading","content":["Xoossay Bare Na7aa Bagganna Haasayeedda"]},{"type":"verse","number":1,"content":["Xoossay beni wode, nu aawotuu nabatuwaa bagganna dumma dumma ogiyaaninne daro wodiyaan haasayeedda."]},{"type":"verse","number":2,"content":["Shin ha wurssetha wodiyaan, ubbabaa A laatissiide, yeletaa A bagganna medhdheedda bare Na7aa bagganna nuussi haasayeedda."]},{"type":"verse","number":3,"content":["Na7ay Xoossaa bonchcho poo7uwaa phoolee; qassi kumentha Xoossaa eeshshaa akkiide, bare wolqqaama qaalaan ha sa7aa naagee; yaatiide asaa nagaraappe geeshshiide, Ubbaappe Bolla Xoossaappe ushechcha bagganna",{"noteId":0},"saluwan utteedda."]},{"type":"heading","content":["Xoossaa Na7ay Kiitanchchatuwaappe Bolla"]},{"type":"verse","number":4,"content":["Xoossay aw immeedda sunthatethay kiitanchchatuwaappe dhoqqa gidiyaawadankka, unttunttuppe A loythi dhoqqu ootheedda."]},{"type":"verse","number":5,"content":["Ayissi gooppe, Xoossay bare kiitanchchatuwappe oona,",{"text":"“Neeni ta Na7aa;","poem":1},{"text":"taani hachche new aawuwaa gidaaddi”","poem":2},"geeddee? Woy qassi oona,",{"text":"“Taani aw aawuwaa gidana;","poem":1},{"text":"ikka taw na7a gidana”","poem":2},"geeddee?"]},{"type":"verse","number":6,"content":["Qassi Xoossay bare bayra Na7aa ha sa7aa yeddana haniidde,",{"text":"“Ta kiitanchchatuwaa ubbatuukka aw goyinnino”","poem":1},"yaageedda."]},{"type":"verse","number":7,"content":["Xoossay kiitanchchatuwaabaa haasayiidde,",{"text":"“Taani ta kiitanchchatuwaa carkkuwaa kessay;","poem":1},{"text":"qassi ta oosanchchatuwaakka tamaa lacuwaa kessay”","poem":2},"yaagee."]},{"type":"verse","number":8,"content":["Shin bare Na7aawaa haasayiidde,",{"text":"“Xoossaw, ne kawutethaa oydii","poem":1},{"text":"medhi medhinaw de7ee.","poem":2},{"lineBreak":true},{"text":"Ne kawutethaa xillotethaan ahasaa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neeni xillotethaa siiqaade;","poem":1},{"lineBreak":true},{"text":"naaquwaa ixxaadda.","poem":1},{"text":"Xoossay, ne Xoossay neena","poem":2},{"lineBreak":true},{"text":"ne laggetuwaappe aathiide,","poem":2},{"lineBreak":true},{"text":"nashechchaan ililissiyaa zaytiyaa okkeeddawe hawaassa”","poem":2},"yaagee."]},{"type":"verse","number":10,"content":["Xoossay hawaadan yaagee;",{"text":"“Godaw, koyro neeni sa7aa medhdhaadda;","poem":1},{"text":"saluwaakka ne kushiyan medhdhaadda.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hewanttu ubbay dhayana;","poem":1},{"lineBreak":true},{"text":"shin neeni de7ana.","poem":1},{"text":"Unttunttu ubbaykka afilaadan wurana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Neeni unttuntta gaabiyaadan dakkoyana;","poem":1},{"lineBreak":true},{"text":"qassi unttunttu afilaadan laamettanawantta.","poem":1},{"text":"Shin neeni neenakka;","poem":2},{"lineBreak":true},{"text":"ne laythay ubbaakka wurenna”","poem":2},"yaagee."]},{"type":"verse","number":13,"content":["Shin Xoossay bare kiitanchchatuwappe ittuwaanne,",{"text":"“Taani ne morkketuwaa neeni","poem":1},{"text":"gediyan yedhdhiyaawaa oothana gakkanaw,","poem":2},{"lineBreak":true},{"text":"hawaan taappe ushechcha baggan utta”","poem":2},"gibeenna."]},{"type":"verse","number":14,"content":["Kiitanchchatuu ubbay Xoossaw oothanawunne atotethaa demmana asatuwaa maaddanaw Xoossay kiitteedda ayyaanatuwa gidikkinooyee?"]}],"footnotes":[{"noteId":0,"caller":"+","text":"ushechcha bagganna: Bonchchuwaanne wolqqaasa gidiyaawaa bessee.","reference":{"chapter":1,"verse":3}}]},"thisChapterLink":"/api/dwr_tbl/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_tbl/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_tbl/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}