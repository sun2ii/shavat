{"translation":{"id":"dwr_tbl","name":"Ooratha Caaquwaa","website":"https://ebible.org/Scriptures/details.php?id=dwrNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrNT","licenseNotes":null,"shortName":"TBL","englishName":"Dawro NT (Latin script)","language":"dwr","textDirection":"ltr","sha256":"2aeb131354f8bee8eb5f5f6358660382d5824342b5175ff0e92a55a60ed35162","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_tbl/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7805,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"REV","translationId":"dwr_tbl","name":"Saxaa","commonName":"Saxaa","title":"Yohaannisaw Yeedda Saxaa","order":66,"numberOfChapters":22,"sha256":"fd1d58263b660146ba78206c0752a5e7f43168ae1b2367c915cbfb6a0fc0d893","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_tbl/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/dwr_tbl/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":18,"content":[{"type":"heading","content":["Baabilooni Kunddethaa"]},{"type":"verse","number":1,"content":["Hewaappe guyyiyan, wolqqaama maatay de7iyaa hara kiitanchchay saluwaappe wodhdhishiina, taani be7aaddi. He kiitanchchaa bonchchuu sa7aa poo7isseedda."]},{"type":"verse","number":2,"content":["He kiitanchchay bare kooshshaa dhoqqu udiide,",{"text":"“Iza kunddaaddu!","poem":1},{"text":"Wolqqaama Baabiloona kunddaaddu!","poem":2},{"text":"Baabiloona xalahatuu aqiyaasaa gidaaddu;","poem":1},{"text":"iita ayyaanatuu ubbatuunne","poem":2},{"text":"ixettiyaa iita kafatuu ubbatuu","poem":1},{"text":"iini de7iino.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ayissi gooppe,","poem":1},{"lineBreak":true},{"text":"asaa zariyaa ubbaa","poem":1},{"text":"bare mathoyiyaa woyiniyaa eessaa","poem":2},{"text":"ushshina","poem":1},{"text":"izinna woshummeeddino.","poem":2},{"text":"Qaykka sa7aa kaatatuu","poem":1},{"text":"izinna woshummeeddino.","poem":2},{"text":"Izi ishalo wolqqaa gaasuwan","poem":1},{"text":"sa7an de7iya","poem":2},{"text":"zali77anchchatuu duretteeddino”","poem":1},"yaageedda."]},{"type":"verse","number":4,"content":[{"text":"Hewaappe guyyiyan,","poem":1},{"lineBreak":true},{"text":"taani saluwaappe","poem":1},{"text":"hawaadan yaagiyaa","poem":2},{"text":"hara kooshshaa sisaaddi;","poem":1},{"text":"“Ta asaw, iippe kesite!","poem":2},{"text":"Izi nagaraa izinna koxxoppite!","poem":1},{"text":"Izi muraa gishettoppite.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ayissi gooppe,","poem":1},{"lineBreak":true},{"text":"izi nagaray","poem":1},{"text":"saluwaa gakkanaw dooretti utteedda.","poem":2},{"text":"Xoossay izi iita bayizzuwa","poem":1},{"text":"hassayeedda.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iza immeeddawaa keenaa zaariide,","poem":1},{"lineBreak":true},{"text":"iziw immite.","poem":1},{"text":"Iza ootheeddawoo","poem":2},{"text":"laa77u kushiyaa","poem":1},{"text":"iziw qanxxite.","poem":2},{"text":"Iza hinttenttussi giigisseedda ushshaappe","poem":1},{"text":"laa77u kushiyaa ushshaa","poem":2},{"text":"izi burccukkuwaa kunthite.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Iza bonchchetteeddawaanne","poem":1},{"lineBreak":true},{"text":"ishaleeddawaa keenaa","poem":1},{"text":"izo tuggayitenne kayyoyite.","poem":2},{"text":"Iza bare wozanaan,","poem":1},{"text":"‘Taani kaatattiidan uttay;","poem":2},{"text":"taani asinay baynna maccawunno gidikke;","poem":1},{"text":"qassi ubbaakka kayyottikke’","poem":2},{"text":"yaagaw.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hewaa diraw,","poem":1},{"lineBreak":true},{"text":"izi boshaa ubbay","poem":1},{"text":"harggii, kayyuunne koshay","poem":2},{"text":"izo itti gallassi oyqqana.","poem":1},{"text":"Qassi iza taman guudettana;","poem":2},{"text":"ayissi gooppe,","poem":1},{"text":"izi bolla pirddiyaa","poem":2},{"text":"Godaa Xoossay Wolqqaama”","poem":1},"yaageedda."]},{"type":"verse","number":9,"content":["Sa7aa kaatatuu, izina woshummiidde ishaleeddawanttu he katamatta guudettina, kesiyaa cuwaa be7eedda wode, katamattiw unttunttu waassananne yeekkana."]},{"type":"verse","number":10,"content":["Unttunttu he katamatti ugaw yayyeedda diraw, haakki eqqiide, “Ha wolqqaama katamattee! Wolqqaama katamattee! Baabiloonee, new aayyeero! Neeni ay mala tuggattaniishsha. Neeni itti saatiyaa giddon ne pirddaa akkaadda” yaagana."]},{"type":"verse","number":11,"content":["Unttunttu markkabiyaa caanaa hawaappe sinthanaw shammiyaabay baynna diraw, sa7an de7iya zali77anchchatuu he katamattiw waassananne kayyottana."]},{"type":"verse","number":12,"content":["Unttunttu worqqaa, biraa, bonchcho shuchchaa, inqquwaa geetettiyaa al77o shuchchaa, teera oochcha malatiyaa mayuwaa, suufiyaa mala mayuwaa, hariya geetettiyaa mayuwaa, zo7o mayuwaa, ubba qommo sawiyaa mithaa, ubba qommuwan ootheedda danggarssaa achchaa, al77o mithaappe medhetteeddabaa, nahaasiyaa, birataa, ibineberediyaa geetettiyaa shuchchaa,"]},{"type":"verse","number":13,"content":["qarafaa, qimaamiyaa, ixaanaa, shittuwaa, sawiyaa ixaanaa dhiilliyaa, woyiniyaa eessaa, wogaraa zaytiyaa, liiqeedda dhiilliyaa, zarggaa, miizzaa, dorssaa, paraanne paray goochchiyaa gaariyaa, unttunttu aylletuwanne haray atto asaa shemppuunne shammiyaabaykka baawa."]},{"type":"verse","number":14,"content":[{"text":"Zali77anchchatuu mishirattiw,","poem":1},{"lineBreak":true},{"text":"“Neeni amotteedda","poem":1},{"text":"lo77obay ubbay neeppe halidiggeedda.","poem":2},{"text":"Ne de7uunne","poem":1},{"text":"alleeqqettiyaabay ubbay dhayidiggeedda.","poem":2},{"text":"Neeni laa7entho","poem":1},{"text":"unttuntta ubbaakka demmakka”","poem":2},"yaageeddino."]},{"type":"verse","number":15,"content":["He katamattin zali77iide duretteedda zali77anchchatuu izi ugaw yayyiide, iippe haakkiide eqqana. Unttunttu yeekkananne kayyottana."]},{"type":"verse","number":16,"content":["Qassi,",{"text":"“Suufiyaa geetettiyaa","poem":1},{"text":"kiriyan dadetteedda mayuwaa,","poem":2},{"text":"teera ochchaa malatiyaa","poem":1},{"text":"mayuwanne zo7o mayuwaa mayyaade,","poem":2},{"text":"worqqaa alleeqquwan,","poem":1},{"text":"bonchcho shuchchaaninne","poem":2},{"text":"inqquwaa geetettiyaa","poem":1},{"text":"al77o shuchchan alleeqqeedda,","poem":2},{"text":"he wolqqaama katamattiw aayyeero!","poem":1}]},{"type":"verse","number":17,"content":[{"text":"Hawaa keena","poem":1},{"lineBreak":true},{"text":"wolqqaama maxuu ubbay","poem":1},{"text":"itti saatiyaa giddon","poem":2},{"text":"dippi gi dhayi aggeedda”","poem":1},"yaageeddino. Markkabiyaa laaggiyaa ubbatuu, markkabiyan biya ubbatuu, markkabiyan oothiyaa ubbatuunne abbaan oothi go77ettiyaa ubbatuu haakki eqqeeddino."]},{"type":"verse","number":18,"content":["He katamatta guudettina kesiyaa cuwaa be7eedda wode barenttu kooshshaa dhoqqu udiide, “Ha wolqqaama katamatto malatiyaa katamay ubbaakka baawa” yaageeddino."]},{"type":"verse","number":19,"content":["Unttunttu barenttu huuphiyaan baana qoliide, waasseeddinonne kayyotteeddino;",{"text":"“Abbaan markkabetuu de7iyaa ubbaa","poem":1},{"text":"bare maxuwan dureyeedda","poem":2},{"text":"wolqqaama katamattiw aayyeero!","poem":1},{"lineBreak":true},{"text":"Qassi iziw de7iyaabay ubbay","poem":1},{"text":"itti saatiyaa giddon","poem":2},{"lineBreak":true},{"text":"dhayi ageedda.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"He katamatta dhayeedda diraw,","poem":1},{"lineBreak":true},{"text":"saloo, nashetta!","poem":1},{"text":"Geeshshatoo, Yesuusi kiitteeddawanttoo,","poem":2},{"text":"nabatoo, nashettite!","poem":1},{"text":"Ayissi gooppe,","poem":2},{"text":"iza hinttentta ootheeddawaa","poem":1},{"text":"diraw Xoossay izo pirddeedda” yaageedda.","poem":2}]},{"type":"verse","number":21,"content":["Hewaappe guyyiyan,",{"text":"wolqqaama kiitanchchay","poem":2},{"text":"woxaa malatiyaa wolqqaama shuchchaa","poem":1},{"text":"denthi abbaan oliide hawaadan yaageedda;","poem":2},{"text":"“Wolqqaama katamatta","poem":1},{"text":"Baabiloona sugina,","poem":2},{"text":"hawaadan kunddana;","poem":1},{"text":"iza hachcheppe sinthaw","poem":2},{"text":"ubbaakka beettukku.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Diithaa diixxiyaawanttunne","poem":1},{"lineBreak":true},{"text":"mazimuriyaa yexxiyaawanttu,","poem":1},{"text":"suusulliyaanne malakataa punniyaawanttu","poem":2},{"text":"kooshshay hawaappe hini baggan","poem":1},{"text":"ne giddon ubbakka siseettenna.","poem":2},{"text":"Kushiyaa hiilla eriyaa ooninne","poem":1},{"text":"laa7etho ubbakka de7enna.","poem":2},{"text":"Woxaa kooshshaykka","poem":1},{"text":"hawaappe sinthaw ne giddon sisettenna.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Xomppiyaa poo7uukka","poem":1},{"lineBreak":true},{"text":"laa7ethuwa ne giddon poo7enna.","poem":1},{"text":"Akkiyawaa kooshshaynne","poem":2},{"text":"gelewunni kooshshay","poem":1},{"text":"sinthaw ne giddon siseettenna.","poem":2},{"text":"Ne zali77anchchatuu sa7aa","poem":1},{"text":"ubbaan eretteedda wolqqaamatuwaa.","poem":2},{"text":"Ne bitiyaawan asaa zariyaa ubbay","poem":1},{"text":"cimetteedda.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nabatuwaa suuthay,","poem":1},{"lineBreak":true},{"text":"geeshshatuwaa suuthaynne","poem":1},{"text":"sa7an hayqqeedda ubbatuwaa suuthay","poem":2},{"text":"izin beetteedda diraw,","poem":1},{"text":"Baabiloona","poem":2},{"text":"murettaaddu”","poem":1},"yaageedda."]}],"footnotes":[]},"thisChapterLink":"/api/dwr_tbl/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_tbl/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_tbl/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}