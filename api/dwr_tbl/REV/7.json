{"translation":{"id":"dwr_tbl","name":"Ooratha Caaquwaa","website":"https://ebible.org/Scriptures/details.php?id=dwrNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=dwrNT","licenseNotes":null,"shortName":"TBL","englishName":"Dawro NT (Latin script)","language":"dwr","textDirection":"ltr","sha256":"2aeb131354f8bee8eb5f5f6358660382d5824342b5175ff0e92a55a60ed35162","availableFormats":["json"],"listOfBooksApiLink":"/api/dwr_tbl/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7805,"languageName":"Dawro","languageEnglishName":"Dawro"},"book":{"id":"REV","translationId":"dwr_tbl","name":"Saxaa","commonName":"Saxaa","title":"Yohaannisaw Yeedda Saxaa","order":66,"numberOfChapters":22,"sha256":"fd1d58263b660146ba78206c0752a5e7f43168ae1b2367c915cbfb6a0fc0d893","firstChapterNumber":1,"firstChapterApiLink":"/api/dwr_tbl/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/dwr_tbl/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":7,"content":[{"type":"heading","content":["Israa7eeliyaa Asaappe 144000 Asatuwa Som77iyaan Maatafay Wodhdheedda"]},{"type":"verse","number":1,"content":["Hewaappe guyyiyan, taani oyddu kiitanchchatuu oyddu bagga sa7aa gaxaan eqqeeddaawantta be7aaddi. He kiitanchchatuu sa7aa bollan, woy abbaa bollan, woy ay mithaa bollan, carkkuu carkkennaadan te77eeddino."]},{"type":"verse","number":2,"content":["Qassikka de7uwa Xoossaa maatafaa oyqqiide hara kiitanchchay away mokkiyaasaappe kesiyaawaa taani be7aaddi. He kiitanchchay bare kooshshaa dhoqqu udiide, sa7aanne abbaa qohanaw wolqqay imetteedda oyddu kiitanchchatuwa"]},{"type":"verse","number":3,"content":["xeesiide, “Nu Xoossaa oosanchchatuwaa deemuwan nuuni maatafaa wothana gakkanaw, sa7aa gidina woy abbaa gidina, woy mithaa gidinakka qohoppite” yaageedda."]},{"type":"verse","number":4,"content":["Taani Xoossaa maatafaa deemuwan wotheeddawanttu payduwaa sisaaddi. Israa7eeliyaa zariyaa ubbaappe itti xeetanne oytamanne oyddu sha77a asatuwaa deemuwan maatafay wodhdheedda."]},{"type":"verse","number":5,"content":[{"text":"Yihudaa zariyaappe","poem":1},{"text":"tammanne laa77u sha77aa","poem":2},{"text":"deemuwan maatafay","poem":1},"wodhdheedda.",{"text":"Roobeela zariyaappe","poem":1},{"text":"tammanne laa77u sha77aa.","poem":2},{"text":"Gaade zariyaappe","poem":1},{"text":"tammanne laa77u sha77aa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Aaseera zariyaappe","poem":1},{"text":"tammanne laa77u sha77aa.","poem":2},{"text":"Niftaaleeme zariyaappe","poem":1},{"text":"tammanne laa77u sha77aa.","poem":2},{"text":"Minaase zariyaappe","poem":1},{"text":"tammanne laa77u sha77aa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Simoona zariyaappe","poem":1},{"text":"tammanne laa77u sha77aa.","poem":2},{"text":"Leewiyaa zariyaappe","poem":1},{"text":"tammanne laa77u sha77aa.","poem":2},{"text":"Yisaakoora zariyaappe","poem":1},{"text":"tammanne laa77u sha77aa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Zaabiloona zariyaappe","poem":1},{"text":"tammanne laa77u sha77aa.","poem":2},{"text":"Yooseefo zariyaappe","poem":1},{"text":"tammanne laa77u sha77aa.","poem":2},{"text":"Biiniyaama zariyaappe","poem":1},{"text":"tammanne laa77u sha77aa","poem":2},{"text":"deemuwan maatafay","poem":1},"wodhdheedda."]},{"type":"heading","content":["Bootha Mayuwaa Mayyeedda Cora Asatuwaa"]},{"type":"verse","number":9,"content":["Hewaappe guyyiyan, zariyaa ubbaappe, qommuwaa ubbaappe, yaraa ubbaappenne dumma dumma gadiyaa qaalaa ubbaappe ooninne paydanaw danddayenna zaway baynna cora asaa taani be7aaddi. He asay bootha mayuwaa mayyiide, zambbaa haythaa barenttu kushiyan oyqqiide, kawutethaa oydiyaa sinthaninne Dorssaa sinthan eqqeedda."]},{"type":"verse","number":10,"content":["Unttunttu barenttu qaalaa dhoqqu udiide,",{"text":"“Nu atotethaykka","poem":1},{"text":"kawutethaa oydiyan","poem":2},{"lineBreak":true},{"text":"utteedda","poem":2},{"text":"nu Xoossaappenne","poem":1},{"lineBreak":true},{"text":"Dorssaappe yee”","poem":1},"yaageeddino."]},{"type":"verse","number":11,"content":["Kiitanchchatuu ubbay kawutethaa oydiyaa, cimatuwanne de7uwan de7iya oyddu medhetaa yuuyyi aadhdhiide eqqeeddino. Unttunttu kawutethaa oydiyaa sinthan barenttu deemuwan guufanniide Xoossaw goyinniidde,"]},{"type":"verse","number":12,"content":[{"text":"“Amen77i!","poem":1},{"lineBreak":true},{"text":"Anjjuu, bonchchuu,","poem":1},{"text":"aadhdheedda eratethay,","poem":2},{"text":"galatay, sabay,","poem":1},{"text":"wolqqay, minotethay","poem":2},{"text":"medhinaappe medhinaa gakkanaw","poem":1},{"text":"nu Xoossaw gido.","poem":2},{"text":"Amen77i!”","poem":1},"yaageeddino."]},{"type":"verse","number":13,"content":["Cimatuwaappe ittu taana, “Ha bootha mayuwaa mayyeedda asatuu oonee? Unttunttu haqappe yeeddinoo?” yaagiide oochcheedda."]},{"type":"verse","number":14,"content":["Taani, “Ta Godaw, neeni eraasa” yaagaaddi. I taana hawaadan yaageedda;",{"lineBreak":true},{"text":"“Hawanttu daro waayyiyaa","poem":1},{"text":"waayyettiide yeeddawantta.","poem":2},{"text":"Unttunttu barenttu mayuwaa","poem":1},{"text":"Dorssaa suuthan meecciide","poem":2},{"text":"booxxeeddawantta.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hewaa diraw,","poem":1},{"lineBreak":true},{"text":"unttunttu Xoossaa kawutethaa oydiyaa","poem":1},{"text":"sinthan eqqiide,","poem":2},{"text":"qammanne gallassi","poem":1},{"text":"A Geeshsha Golliyan","poem":2},{"text":"aw oothiino.","poem":1},{"text":"Qassi I bare kawutethaa oydiyan","poem":2},{"text":"utteeddawe","poem":1},{"text":"unttunttu gidduwan de7ana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hawaappe sinthanaw ubbakka","poem":1},{"lineBreak":true},{"text":"unttunttu koshattikkino","poem":1},{"text":"woy saamettikkino.","poem":2},{"text":"Away unttuntta meenna;","poem":1},{"text":"qassi ay seelaykka unttuntta guuddenna.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ayissi gooppe,","poem":1},{"lineBreak":true},{"text":"kawutethaa oydew","poem":1},{"text":"gidduwan utteedda Dorssay","poem":2},{"text":"unttuntta heemmana.","poem":1},{"text":"De7uwa haathaa pulttuwaakkokka","poem":2},{"text":"unttuntta kaalethana.","poem":1},{"text":"Xoossaykka","poem":2},{"text":"unttunttu ayfiya afothaa ubbaa quccidiggana”","poem":1},"yaageedda."]}],"footnotes":[]},"thisChapterLink":"/api/dwr_tbl/REV/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/dwr_tbl/REV/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/dwr_tbl/REV/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}