{"translation":{"id":"ekk_bib","name":"Biblica® Vaba kasutusega Uus Testament, Pühakiri kaasaegses eesti keeles","website":"https://ebible.org/Scriptures/details.php?id=ekk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ekk","licenseNotes":null,"shortName":"BIB","englishName":"Estonian Contemporary NT","language":"ekk","textDirection":"ltr","sha256":"7396a0126bad63dd36230bc0d86b0cb1215cadfd1258a22fb8aaab660f118e55","availableFormats":["json"],"listOfBooksApiLink":"/api/ekk_bib/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7957,"languageName":"eesti","languageEnglishName":"Estonian"},"book":{"id":"HEB","translationId":"ekk_bib","name":"Kiri heebrealastele","commonName":"Kiri heebrealastele","title":"Kiri heebrealastele","order":58,"numberOfChapters":13,"sha256":"57bcb002ae2b14f30439c76600132e5127aaaffcc2e13d1dd671e31c709e26ff","firstChapterNumber":1,"firstChapterApiLink":"/api/ekk_bib/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/ekk_bib/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Jumala viimane Sõna – tema Poeg"]},{"type":"verse","number":1,"content":["Kui Jumal muiste rääkis esivanematele mitmel korral ja mitmel viisil prohvetite kaudu,"]},{"type":"verse","number":2,"content":["siis on Jumal viimseil päevil meile rääkinud Poja kaudu, kelle ta on seadnud kõigi asjade pärijaks ja kelle läbi ta on ka maailmad loonud."]},{"type":"verse","number":3,"content":["Poeg on Jumala kirkuse kiirgus ja tema olemuse täpne peegeldus ning ta hoiab ülal kõiksust oma võimsa sõnaga. Kes on pärast seda, kui ta oli puhastanud meid pattudest, istunud Ausuuruse paremale käele kõrgustes"]},{"type":"verse","number":4,"content":["ning saanud ülemaks inglitest, kuivõrd ta on pärinud neist ülevama nime."]},{"type":"heading","content":["Poeg seisab kõrgemal inglitest"]},{"type":"verse","number":5,"content":["Millisele inglile on Jumal iganes öelnud",{"text":"„Sina oled minu Poeg,","poem":1},{"text":"täna ma sünnitasin sinu“?","poem":2},"Ja veel:",{"text":"„Mina olen tema Isa","poem":1},{"text":"ja tema on minu Poeg.“","poem":2}]},{"type":"verse","number":6,"content":["Ning kui ta toob oma esmasündinu maailma, ütleb ta:",{"text":"„Teda kummardagu kõik Jumala inglid.“","poem":1}]},{"type":"verse","number":7,"content":["Inglite kohta ta ütleb:",{"text":"„Ta teeb oma inglid vaimudeks,","poem":1},{"text":"ja oma teenijad tuleleegiks.“","poem":2}]},{"type":"verse","number":8,"content":["Aga Poja kohta ta ütleb:",{"text":"„Sinu troon, Jumal, püsib ikka ja igavesti,","poem":1},{"text":"ja õiglus on su Kuningriigi valitsuskepp.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sa armastad õigust ja vihkad ülekohut,","poem":1},{"text":"seepärast on su Jumal võidnud sind","poem":2},{"lineBreak":true},{"text":"rõõmuõliga rohkem kui su kaaslasi.“","poem":2}]},{"type":"verse","number":10,"content":["Ja veel:",{"text":"„Sina, Issand, panid alguses maale aluse","poem":1},{"text":"ja taevad on su kätetöö.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Need hävivad, aga sina jääd;","poem":1},{"text":"nad kõik kuluvad nagu riie.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sa keerad nad kokku otsekui kuue –","poem":1},{"text":"nad vahetatakse välja nagu rõivad.","poem":2},{"text":"Ent sina oled ikka seesama","poem":1},{"text":"ja sinu aastad ei lõpe.“","poem":2}]},{"type":"verse","number":13,"content":["Või millisele inglile on Jumal iganes öelnud:",{"text":"„Istu mu paremale käele,","poem":1},{"text":"kuni ma panen sinu vaenlased su jalajäriks“?","poem":2}]},{"type":"verse","number":14,"content":["Eks kõik inglid ole teenijad vaimud, saadetud teenima neid, kes pärivad pääste?"]}],"footnotes":[]},"thisChapterLink":"/api/ekk_bib/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ekk_bib/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ekk_bib/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}