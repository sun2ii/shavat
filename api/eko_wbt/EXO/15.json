awe apale awaakhupaliyeeyo","poem":1},{"text":"khukhuteliwa ti pahari yookhuttuwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Maati apale awiicha khuwaakhutela","poem":1},{"text":"khwiiya oozama nkhama mawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Oo Nnyizinku, nkhono nlume awo","poem":1},{"text":"onaaye owahi nwulweene;","poem":2},{"text":"Oo Nnyizinku, nkhono nlume awo","poem":1},{"text":"wawaashijela maatuwi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Khwa owula wa ofwalume awo","poem":1},{"text":"wawaakhitiri maatuwi awo,","poem":2},{"text":"katapu yawo khuwaaja nkhama malala.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Khwa ovitelela wa phula yawo","poem":1},{"text":"maati na mawipi ajikusanya","poem":2},{"lineBreak":true},{"text":"khujakhuwa nkhama muuri,","poem":2},{"text":"vathi wa pahari","poem":1},{"text":"khwiiya awuuma nkhama liwe la manlela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Maatuwi khusala alupa yoori:","poem":1},{"lineBreak":true},{"text":"‘Niweekarise niniwaasikana","poem":1},{"lineBreak":true},{"text":"niwaanyakanye maali nafusi zeetthu zinlawa zatoshiwe pi yo,","poem":1},{"lineBreak":true},{"text":"nasarule phanka yeetthu","poem":1},{"text":"na makhono eetthu niniwaatapanya.’","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Khuperekha pheevo yawo,","poem":1},{"text":"na pahari khuwaafinikha.","poem":2},{"text":"Khuzama nkhama chumpwi","poem":1},{"text":"mpahari wawiichamo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Khaziivo miluku zinlikananaaye weeyo","poem":1},{"text":"oo Nnyizinku.","poem":2},{"lineBreak":true},{"text":"Khaavo woottitthimisiwa woottakatthifu,","poem":2},{"lineBreak":true},{"text":"wawoopisa khwa oretta vitthu zootikinisa na oretta minjuza.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wookoliye nkhono nlume awo","poem":1},{"text":"nti khuwaamiza.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Khwa pheta yawo","poem":1},{"text":"wawaalokoza atthu awo apale owoosuruyeeyo;","poem":2},{"text":"na kuvu zawo,","poem":1},{"text":"khuwaattha puuro yawo yoottakatthifu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Khapila khusiila epile onrettaazo,","poem":1},{"text":"khusala zithukumela na woova.","poem":2},{"text":"Afiliishiti khuwaapattha huzuni.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Attunkhulu a Meedomu","poem":1},{"text":"khwiiya ooshanka","poem":2},{"text":"na anamalokozela a amowaabu","poem":1},{"text":"khuwaapattha othukumela;","poem":2},{"text":"akanaani khuwaapattha otteettheya.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Osuthuwa na woova khuwaapattha","poem":1},{"text":"khwa owahi wa nkhono awo,","poem":2},{"text":"khuhisala asakhinyeya nkhama mawe","poem":1},{"text":"mpakha ovira atthu awo,","poem":2},{"text":"Oo Nnyizinku,","poem":1},{"text":"mpakha ovira","poem":2},{"text":"atthu apale owoozanyiyeeyo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Oo Nnyizinku, weeyo oniwalawana na waweekhaze","poem":1},{"text":"vamwaako wa eritho yawo","poem":2},{"text":"puuro ttakatthiifu","poem":1},{"text":"nyuupa yawo","poem":2},{"lineBreak":true},{"text":"ojekiyeeyo na makhono awo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nnyizinku mfwalume wa mileele.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":["Wakathi khavalo za Firawuuna na mikukutta zawe za nvittha na anakhavalo awe eettiyeevo mpahari, Nnyizinku khuwaazamisa a Misuri na maati a pahari etile; ila meezirayiilu aaviriye mwentto aluwatthelaka mishaka zawuuma vakatthi wa pahari."]},{"type":"verse","number":20,"content":["Nhupiri Miiriyamu nlupuwe Arawu khuthuula nttowu na aakha ooshi khusala anlotta eettaka opiya na wiina."]},{"type":"line_break"},{"type":"verse","number":21,"content":["Miiriyamu aari owaajipu eettaka wiipa araka:",{"lineBreak":true},{"text":"“Nimwiipele Nnyizinku,","poem":1},{"text":"mwaasa yoori ashintta wooshapweyavo.","poem":2},{"text":"Khutupweeza mpahari khavalo","poem":1},{"text":"na anakhavalo aya.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":["Aphano Munsa khuwaalokoza meezirayiilu waaza pahari yookhuttuwa mpakha n'yaara ya Shuuri. Siikhu ttatthu eettaka weettetta n'yaara ahipatthaka maati."]},{"type":"verse","number":23,"content":["Aphano khufiya Maara, ila khuhiwahi onywa maati ottuukho mwaasa wa owaawa. Ti maana aya wiittheliweeyo nzina la Maara."]},{"type":"verse","number":24,"content":["Tiito meezirayiilu khusala amwaapa Munsa araka: “Ninttela onywa-ni?”"]},{"type":"verse","number":25,"content":["Munsa khunkhuwela Nnyizinku ye khuthoonyeziwa muutthi khuthuula khweeselela mmaati khwiiya ootuva. Puuro etile ya Maara Nnyizinku khuwenkha kano na oruma na khuweeza,"]},{"type":"verse","number":26,"content":["awoozaka yoori: “Mweeyo amana mwinsiileza Nnyizinku, Nluku enu na osiileza etile enintuvelaaye na khusiileza mirumo zawe na khushututela kano zawe zooshi, khamwiniiyana hatha orati opule kiwaatiseliyeeyo amisuri, maana miiyo ki Nnyizinku anvonisaaye."]},{"type":"verse","number":27,"content":["Aphano khufiya nti wa Elimu, ottuukho zaariiwo milipu khumi na miwiri na mikokonoothi sapiyiini; khumaka ottuukho khwaattamela maati."]}],"footnotes":[]},"thisChapterLink":"/api/eko_wbt/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eko_wbt/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eko_wbt/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}