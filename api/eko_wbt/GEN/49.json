{"translation":{"id":"eko_wbt","name":"Kote New Testament","website":"https://ebible.org/Scriptures/details.php?id=eko","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eko","licenseNotes":null,"shortName":"WBT","englishName":"Kote Bible","language":"eko","textDirection":"ltr","sha256":"4e5b524d9704a01f2faeca1292df2132628b8873ec7302750e47245bf6fe7e68","availableFormats":["json"],"listOfBooksApiLink":"/api/eko_wbt/books.json","numberOfBooks":9,"totalNumberOfChapters":179,"totalNumberOfVerses":6350,"languageName":"Koti","languageEnglishName":"Koti"},"book":{"id":"GEN","translationId":"eko_wbt","name":"Mwanzo","commonName":"Mwanzo","title":"Mwanzo","order":1,"numberOfChapters":50,"sha256":"cbc4a1d19e63d7c03d4d7f108550616045d6d92aee17d86c1bf99c075f62e37b","firstChapterNumber":1,"firstChapterApiLink":"/api/eko_wbt/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/eko_wbt/GEN/50.json","totalNumberOfVerses":1530},"chapter":{"number":49,"content":[{"type":"heading","content":["Yaakhumpa oniwaaparikhiya aanaawe"]},{"type":"verse","number":1,"content":["Yaakhumpa khuwaakhuwela aanaawe khuwooza yoori: “Mwite apha kiwuuzeni vitthu zinttelaaye orettikhana siikhu epo zintaazo."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mwisusele apha mwisiile aana a Yaakhumpa,","poem":1},{"text":"mwinsiileze papeenu Ezirayeele.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Weeyo Ruubeni, mwaana woomwanzo aka,","poem":1},{"text":"kuvu zaka,","poem":2},{"text":"nshumo woomwanzo woojikhitiri wooshapu aka,","poem":1},{"text":"mwanzo wooshitahiwa channu na wookhomaala.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Weeyo o wootumpunyeya nkhama maati a mpahari,","poem":1},{"text":"omwanzo awo wafujeya,","poem":2},{"text":"mwaasa woolalana muukha wa papaawo,","poem":1},{"text":"waphuja voolili wa papaawo","poem":2},{"noteId":50},{"text":".","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Na-ye Simiyooni na Leevi, ntthu na ttwiiye,","poem":1},{"text":"phanka zaya puntukhi zoorettana vitthu zoohusuti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Shawuri zaya miiyo akeepu,","poem":1},{"text":"na rooho yaka khiri vamote na-yo,","poem":2},{"text":"mwaasa wa wiiphiiriwa waya awoola atthu","poem":1},{"text":"khushija ttottopwa za mompe za watthu mwayiini.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Woolaanikha wiiye wiiphiiriwa waya yo, maana pu woowali,","poem":1},{"text":"woolaanikha yiiye katapu yaya yo, maana pi zookhomaala.","poem":2},{"text":"Kinlawa kawaaphakulevo vakatthi wa khapila ya Yaakhumpa,","poem":1},{"text":"kiwaamwazelaka vakatthi wa Ezirayeele.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Weeyo Yuuda, attwiizo anteela wuuttottopela;","poem":1},{"text":"onttela owaashintta maatuwi awo,","poem":2},{"text":"aana a papaawo anlawa","poem":1},{"text":"awiinamele weeyo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yuuda, mwaana wa siipa,","poem":1},{"text":"amana akhola nyama khininsuruwa;","poem":2},{"text":"onlattanana siipa nwulweene arapaleliye,","poem":1},{"text":"paani amminyalaaye khunlansa?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Khweele Yuuda khanteela onyakanyiwa ofwalume awe,","poem":1},{"text":"wala pakhora y'oofwalume eriiye mmwinyoka mwawe,","poem":2},{"text":"mpakha ate mwennyewe ofwalume,","poem":1},{"text":"otu anttelaaye oshututeliwa pi atthu ooshi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ye onteela ofukelela puuru yawe","poem":1},{"text":"vanrayi wa wuuva,","poem":2},{"text":"na mwaanaaya anfukelele","poem":1},{"text":"veerapi yooshapweya ya nrayi otthuupo.","poem":2},{"text":"Kuwo zawe nka afulanaka viinyu","poem":1},{"text":"na ajapi yawe nka afulanaka taamu ya wuuva.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Maasho awe anttela wiiya awaara","poem":1},{"text":"mwaasa woonywa viinyu ya wuuva,","poem":2},{"text":"meeno awe anttela wiiya oolakala","poem":1},{"text":"mwaasa w'oonywa leethi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Zabulooni onttela wiikhala phantte ya phwaani,","poem":1},{"text":"onttela wiiya patari ya makalawa;","poem":2},{"text":"mwiinano awe onlawa mpakha nti wa Sidooni.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ezakaari puuru wookhomaala","poem":1},{"text":"arapaleliye vakatthi wa mapwattha mawiri.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wakathi ooniyeevo yoori tuniya etile yaari ya shirehe","poem":1},{"text":"na yooshapweya ovumula,","poem":2},{"text":"ye khwiinamisa mafuzi awe","poem":1},{"text":"khuvikela mapwattha,","poem":2},{"text":"khusala akhola khaazi","poem":1},{"text":"nkhama mwiitthwaana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Daani, onteela ophuka washariyavo khapila yawe","poem":1},{"text":"nkhama lihimo limote la Ezirayeele.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ye onteela wiiya nkhama nyookha","poem":1},{"text":"eniiyaaye nshini wa tarikhi.","poem":2},{"text":"Nkhama evili yoovithaalela","poem":1},{"text":"enlumaaye ekwakuno ya khavalo,","poem":2},{"text":"namweettettisa khavalo","poem":1},{"text":"khukwana enyokonyoko.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Oo Mbwanaaka! Miiyo kinweja nusura yawo!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Gaadi onteela wuumananiwa pi annya-viittha","poem":1},{"text":"ila ye eettaka owiikarisa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Vitthu-zoojiwa za Azeeri enttela wiiya za nnofu,","poem":1},{"text":"ye nka avahaka etthu-yooja ethiitile ensuhaaye oja afwalume.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nafitaali nazoro woojitaphula","poem":1},{"text":"aniwaapatthaaye aana ooshapweya.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yuusufu muutthi wa wiima channu","poem":1},{"text":"waattameliyeeyo nshini wa maati,","poem":2},{"text":"virapi zaya khurapela vatulu wa muuri.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Maatuwi awe anlawa amuumanane amwiikarisaka","poem":1},{"text":"na mattetthe aya,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ila nttetthe lawe tthi lookhomaala,","poem":1},{"text":"makhono awe pi oozivala","poem":2},{"text":"khwa kuvu za Nwali wa Yaakhumpa,","poem":1},{"text":"khwa kuvu za Nshuki nwulu, Mwaako wa Ezirayeele,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"khwa kuvu za Nluku wa papaawo,","poem":1},{"text":"Nluku Woowahi Wooshi.","poem":2},{"text":"Ye ooparikhiye weeyo Yuusufu na parakha za pinkuuni,","poem":1},{"text":"na parakha za mmaati ariiye vathi w'oolumwenku,","poem":2},{"lineBreak":true},{"text":"na parakha za nyama za waatta na parakha zoovokola.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Parakha za papaawo pi za waatta zayita","poem":1},{"text":"parakha epile za nyaako epi za raku,","poem":2},{"text":"na maali za nyaako mittiitthi za mileele.","poem":1},{"text":"Parakha zooshi epi ziiye veeshwa wa Yuusufu","poem":2},{"text":"mpakha vaajihi va otule athawuliweeyo","poem":1},{"text":"vakatthi wa attwiize.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bejami miiji woosaya,","poem":1},{"text":"supuyeene ontta okhola nyama na orafuna,","poem":2},{"text":"njuwa looveva na waawanya epile zinsalaazo.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":["Pi atthaapa mahimo khumi na mawiri a Ezirayeele, na mattakhuzi aawooziyeeyo papaaya awaaparikhiyaka, na amwinkhaka wakhula ntthu parakha yawe etile yaamweeziyeeyo."]},{"type":"heading","content":["Ofwa wa Yaakhumpa"]},{"type":"verse","number":29,"content":["Elottelanaka Yaakhumpa khuwooza araka: “Kinttela ofwa kilawe kazikhiwe vamote na ajamaazaku apa afwiiyeeyo. Mwakizikhe vamote na apapazaku nlikurakuza liriiye mmashapa wa Eforoni Nhiiti,"]},{"type":"verse","number":30,"content":["nttintthile liriiye Makhipeela kharipu ya Manre tuniya ya Kanaani, nttinttho Eburahiima oozanyeziweeyo ti Eforoni Nhiiti yoori yiiye vilalo yawe."]},{"type":"verse","number":31,"content":["Ottuukho azikhiweewo Eburahiima na muukhaawe Suhura, na-ye Esiyaakha na muukhaawe Rapekha na theenya ottuukho phi kinzikhiyeewo Liiya."]},{"type":"verse","number":32,"content":["Nshapa laya na likurakuza laya nttho oozanyaniye Ahiiti.”"]},{"type":"verse","number":33,"content":["Nawiisha mattakhuzi apale aari owoozaaye aanaawe, Yaakhumpa khurutisela moolu awe voolili khurapalela khwiittha phuumu khufwa."]}],"footnotes":[{"noteId":50,"caller":"+","text":"Moone Mwanzo 35v22.","reference":{"chapter":49,"verse":4}}]},"thisChapterLink":"/api/eko_wbt/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eko_wbt/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eko_wbt/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}