{"translation":{"id":"eko_wbt","name":"Kote New Testament","website":"https://ebible.org/Scriptures/details.php?id=eko","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eko","licenseNotes":null,"shortName":"WBT","englishName":"Kote Bible","language":"eko","textDirection":"ltr","sha256":"4e5b524d9704a01f2faeca1292df2132628b8873ec7302750e47245bf6fe7e68","availableFormats":["json"],"listOfBooksApiLink":"/api/eko_wbt/books.json","numberOfBooks":9,"totalNumberOfChapters":179,"totalNumberOfVerses":6350,"languageName":"Koti","languageEnglishName":"Koti"},"book":{"id":"JON","translationId":"eko_wbt","name":"Yuunusa","commonName":"Yuunusa","title":"Yuunusa","order":32,"numberOfChapters":4,"sha256":"020b35ad6bb38961238c25470f9b31938f50f5056e08940b6ffd0688fc227adb","firstChapterNumber":1,"firstChapterApiLink":"/api/eko_wbt/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/eko_wbt/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Olompa wa Yuunusa"]},{"type":"verse","number":1,"content":["Ari mmatthupo wa swi, ye khwaaza olompa anshukhurwelaka Nnyizinku awe:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Nhuzuni mwaka kankhuweliye Nnyizinku,","poem":1},{"text":"na aakijipwiye.","poem":2},{"text":"Mithili za ahera kaakhuwiye","poem":1},{"text":"na waasiiliye huula yaka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Waakitupweeziye mpahari wa wiichamo,","poem":1},{"text":"nkatthi wa khilintti,","poem":2},{"text":"nziko wa maati khukizukulela,","poem":1},{"text":"na mawipi awo khukikhutela.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Miiyo khulupa yoori keekareliwa peeti-wene","poem":1},{"text":"na omaasho wawo weeyo Nnyizinku.","poem":2},{"text":"Kinta kirutele woona theenya","poem":1},{"text":"nyuupa yawo yoottakatthiifu?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Maati khukifiya vakhulo,","poem":1},{"text":"khilintti khukizukulela","poem":2},{"lineBreak":true},{"text":"na mirawa khukizokonzela eeshwa yaka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Khuzama mpakha vanchina la nyaako,","poem":1},{"text":"tuniya ya vathi, puuro enimfukelaaye ntthu khwa siikhu zooshi.","poem":2},{"text":"Ila weeyo Mbwanaaka Nnyizinku khuusuru nafusi yaka","poem":1},{"text":"nkhapuri mphule.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wakathi kaari osaleelaavo ofwa,","poem":1},{"text":"koofikhiriye weeyo Nnyizinku,","poem":2},{"text":"khuuperekheza lompa yaka,","poem":1},{"text":"yoori efiye nnyupa mwawo woottakatthiifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Apale anaputwaaye sanamu zoohiina fwayita,","poem":1},{"text":"antarawu tthakaraka ya Nnyizinku.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ila miiyo kinteela wuushukhurwela Nnyizinku","poem":1},{"text":"na maliipo a siifwa na owinkha twaha,","poem":2},{"text":"na kinteela oretta eti kaahitiyeeyo,","poem":1},{"text":"maana nusura ti yaawo weeyo Nnyizinku.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":["Aphano, Nnyizinku khuruma swi etile, yoori yanchuwe Yuunusa nshini wa nttima."]}],"footnotes":[]},"thisChapterLink":"/api/eko_wbt/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eko_wbt/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eko_wbt/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}