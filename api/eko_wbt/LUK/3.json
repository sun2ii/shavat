{"translation":{"id":"eko_wbt","name":"Kote New Testament","website":"https://ebible.org/Scriptures/details.php?id=eko","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eko","licenseNotes":null,"shortName":"WBT","englishName":"Kote Bible","language":"eko","textDirection":"ltr","sha256":"4e5b524d9704a01f2faeca1292df2132628b8873ec7302750e47245bf6fe7e68","availableFormats":["json"],"listOfBooksApiLink":"/api/eko_wbt/books.json","numberOfBooks":9,"totalNumberOfChapters":179,"totalNumberOfVerses":6350,"languageName":"Koti","languageEnglishName":"Koti"},"book":{"id":"LUK","translationId":"eko_wbt","name":"Luuka","commonName":"Luuka","title":"Luuka","order":42,"numberOfChapters":24,"sha256":"74b6aa157cd4ce7054fd4fb77b7d7c2ccfa84474d712bec8e4b8676fd8f58b0c","firstChapterNumber":1,"firstChapterApiLink":"/api/eko_wbt/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/eko_wbt/LUK/24.json","totalNumberOfVerses":1150},"chapter":{"number":3,"content":[{"type":"heading","content":["Otafusiri wa Yaahaya Namoosa"]},{"type":"verse","number":1,"content":["Mwaakha wakhuumi na thaanu Seezari Tibeeriyu ari mfwalume nwulu wa Rooma, Pontiyu Pilaatu ari liwaali wa Yudeya. Herooti ari nsatoro wa Kalileya na ttwiiye Filiipe na-ye ari wa Itureeya na Tarakhoniiti, Lusaaniya ari nsatoro wa Abileeni."]},{"type":"verse","number":2,"content":["Anaasi na Khayiifwa aari mahaakhimu awulu a tiini. Mwaakha aya pi otthuupo enkhiweeyo mattakhuzi a Nnyizinku Yaahaya mwaana wa Zakariiya makuluttu."]},{"type":"verse","number":3,"content":["Ye khuzukulela miti zooshi zaattameliyeeyo muuttho Yorotaani, awoozaka atthu yoori athupwiye twampi zaya aswaamihiwe ti Nnyizinku na oosiwe."]},{"type":"verse","number":4,"content":["Nkhama etthiipo zaatikhiweezo nkithaapu ya napiyu Ezayiiya:",{"text":"“Owaapho ntthu ankhuwaaye n'yaara araka:","poem":1},{"text":"‘Mwaattalele tarikhi ya Mbwana,","poem":2},{"text":"na mwishapweyise miphiitelo zaya.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Makunte ooshi asireliwe,","poem":2},{"text":"nyaako na kulu zooshi zipwejiwe,","poem":1},{"text":"tarikhi zoonyokowa zookoleliwe,","poem":2},{"text":"epile zoothipeya zishottheliwe.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Atthu ooshi anteela woona","poem":2},{"text":"nusura ya Nnyizinku.’”","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":["Yaahaya khusala awooza atthu apale aari otaaye woosiwa araka: “Khapila za nyookha! Paani awuuziyeenini otthira hukhumu ya Nnyizinku entaaye?"]},{"type":"verse","number":8,"content":["Mwirette vitthu enthoonyezaaye yoori khweele mwathupwiya, khahiyo ojilupeza yoori ‘Eburahiima ti papeetthu’. Miiyo kiniwuuzani yoori khwa liwe ntthi Nnyizinku onwahi owaattala aana a Eburahiima."]},{"type":"verse","number":9,"content":["Nshokha latthiiwa nshini wa mitathaari za miitthi, wakhula muutthi ohiniimaaye mishumo zooshapweya ontta oshijiwa weeseleliwe vamoottho.”"]},{"type":"verse","number":10,"content":["Atthu khusala amuuzela araka: “Apho nirette niini?”"]},{"type":"verse","number":11,"content":["Ye khuwaajipu yoori: “Otule ariina hempe piiri, moote amwinkhe otule ahina. Otule ariina etthu-yoojiwa awaameele apale ahina.”"]},{"type":"verse","number":12,"content":["Khulankha anamariphisa lumpuru yoori alawe oosiwe khumuuzela Yaahaya yoori: “Mwanliimu, khi fweeyo nirette niini?”"]},{"type":"verse","number":13,"content":["Ye khuwaajipu araka: “Mwihiriphise mwizitisa hisapu mwirumiweeyo.”"]},{"type":"verse","number":14,"content":["Anajanka na-yo khumuuzela yoori: “Khi fweeyo niri toovi?” Khuwaajipu yoori: “Mwihiwaanyakanye atthu mwiroromelaka kuvu zenu, wala mwihiwaalokoveze vitthu zoohiiyi etthiipo, mwishukhurwele ethiito mwimpatthaaye.”"]},{"type":"verse","number":15,"content":["Nroromelo wa atthu khusala ovira weekezeleyaka oonaka yoori Yaahaya ti Al-Masiihu."]},{"type":"verse","number":16,"content":["Ye khuwooza ooshi apale aariivo yoori: “Weekhweele miiyo kiniwoosanani maati, ila onta nkina ariina owahi wookiziti miiyo, wala akinsuhi ofukula mikhoyi za jampala zawe. Ye onteela owoosani na Rooho Ttakatthiifu na moottho."]},{"type":"verse","number":17,"content":["Onaaye fosholo mmakhono mwawe anttelaaye ophakulana tiriku na maveya. Athuule tiriku atthe vantthala vawe, maveya aya eeselele vamoottho ohinzimaaye.”"]},{"type":"verse","number":18,"content":["Khwa mattakhuzi makina a waatta, Yaahaya aari owaahirimiza na owaatafusirela atthu hapari zooshapweya."]},{"type":"verse","number":19,"content":["Na khunshowera nsatoro Herooti mwaasa wonrala Herodiya muukha wa ttwiiye na oretta vitthu zootakhala za waatta."]},{"type":"verse","number":20,"content":["Elottelanaka Herooti khweekezela zooshi epile, khuruma ofukeliwa Yaahaya nkalapooso."]},{"type":"heading","content":["Woosiwa wa Yinsa"]},{"type":"verse","number":21,"content":["Wakathi Yaahaya aari owoosaavo atthu ooshi apale, Yinsa na-ye khuta attaaphale oteela woosiwa. Ye alompaka pinku khufukuwa,"]},{"type":"verse","number":22,"content":["Rooho Ttakatthiifu khumwiishukhela nkhama jiwa. Khusiileya huula yoolankha pinkuuni eraka: “Weeyo o mwanaka kinuuphetachaaye na wookituvela channu.”"]},{"type":"heading","content":["Ntathaari w'oojama wa Yinsa"]},{"type":"line_break"},{"type":"verse","number":23,"content":["Yinsa wakathi aaziyeevo olaleya hapari zooshapweya, aarettiye arina nyaakha talaathiini. Ye aari mwaana wa Yuusufu nkhama etthiipo atthu aari waakanyeraazo,",{"lineBreak":true},{"text":"Yuusufu aari mwaana wa Heeli,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Heeli aari mwaana wa Mataati,","poem":1},{"text":"Mataati aari mwaana wa Leevi,","poem":2},{"lineBreak":true},{"text":"Leevi aari mwaana wa Melikhi,","poem":2},{"lineBreak":true},{"text":"Melikhi aari mwaana wa Yanaayi,","poem":2},{"lineBreak":true},{"text":"Yanaayi aari mwaana wa Yuusufu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yuusufu aari mwaana wa Matathiiya,","poem":1},{"text":"Matathiiya aari mwaana wa Amooshi,","poem":2},{"lineBreak":true},{"text":"Amooshi aari mwaana wa Nahuumu,","poem":2},{"lineBreak":true},{"text":"Nahuumu aari mwaana wa Heshiili,","poem":2},{"lineBreak":true},{"text":"Heshiili aari mwaana wa Nakhaayi,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nakhaayi aari mwaana wa Maathi,","poem":1},{"text":"Maathi aari mwaana wa Matathiiya,","poem":2},{"lineBreak":true},{"text":"Matathiiya aari mwaana wa Shemeeni,","poem":2},{"lineBreak":true},{"text":"Shemeeni aari mwaana wa Yosheekhi,","poem":2},{"lineBreak":true},{"text":"Yosheekhi aari mwaana wa Yuuda,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Yuuda aari mwaana wa Yohanaani,","poem":1},{"text":"Yohanaani aari mwaana wa Reesa,","poem":2},{"lineBreak":true},{"text":"Reesa aari mwaana wa Zorobabeeli,","poem":2},{"lineBreak":true},{"text":"Zorobabeeli aari mwaana wa Sheyalitiyeeli,","poem":2},{"lineBreak":true},{"text":"Sheyalitiyeeli aari mwaana wa Neeri,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Neeri aari mwaana wa Meelikhi,","poem":1},{"text":"Meelikhi aari mwaana wa Aadi,","poem":2},{"lineBreak":true},{"text":"Aadi aari mwaana wa Kosaamu,","poem":2},{"lineBreak":true},{"text":"Kosaamu aari mwaana wa Elimadaamu,","poem":2},{"lineBreak":true},{"text":"Elimadaamu aari mwaana wa Eeri,","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Eeri aari mwaana wa Yoshuwa,","poem":1},{"text":"Yoshuwa aari mwaana wa Eliyezeeri,","poem":2},{"lineBreak":true},{"text":"Eliyezeeri aari mwaana wa Yoriimu,","poem":2},{"lineBreak":true},{"text":"Yoriimu aari mwaana wa Mathaati,","poem":2},{"lineBreak":true},{"text":"Mathaati aari mwaana wa Leevi,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Leevi aari mwaana wa Simiyooni,","poem":1},{"text":"Simiyooni aari mwaana wa Yuuda,","poem":2},{"lineBreak":true},{"text":"Yuuda aari mwaana wa Yuusufu,","poem":2},{"lineBreak":true},{"text":"Yuusufu aari mwaana wa Yonaamu,","poem":2},{"lineBreak":true},{"text":"Yonaamu aari mwaana wa Eliyakhiimu,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Eliyakhiimu aari mwaana wa Meleeya,","poem":1},{"text":"Meleeya aari mwaana wa Meena,","poem":2},{"lineBreak":true},{"text":"Meena aari mwaana wa Matatha,","poem":2},{"lineBreak":true},{"text":"Matatha aari mwaana wa Nathaani,","poem":2},{"lineBreak":true},{"text":"Nathaani aari mwaana wa Daawuuda,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Daawuuda aari mwaana wa Yeese,","poem":1},{"text":"Yeese aari mwaana wa Obeedi,","poem":2},{"lineBreak":true},{"text":"Obeedi aari mwaana wa Bowaazi,","poem":2},{"lineBreak":true},{"text":"Bowaazi aari mwaana wa Salimooni,","poem":2},{"lineBreak":true},{"text":"Salimooni aari mwaana wa Nashooni,","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Nashooni aari mwaana wa Aminadabu,","poem":1},{"text":"Aminadabu aari mwaana wa Adimiini,","poem":2},{"lineBreak":true},{"text":"Adimiini aari mwaana wa Ariini,","poem":2},{"lineBreak":true},{"text":"Ariini aari mwaana wa Hesherooni,","poem":2},{"lineBreak":true},{"text":"Heshorooni aari mwaana wa Pereezi,","poem":2},{"lineBreak":true},{"text":"Pereezi aari mwaana wa Yuuda,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Yuuda aari mwaana wa Yaakhumpa,","poem":1},{"text":"Yaakhumpa aari mwaana wa Esiyaakha,","poem":2},{"lineBreak":true},{"text":"Esiyaakha aari mwaana wa Eburahiima,","poem":2},{"lineBreak":true},{"text":"Eburahiima aari mwaana wa Teera,","poem":2},{"lineBreak":true},{"text":"Teera aari mwaana wa Nahoori.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Nahoori aari mwaana wa Serukhi,","poem":1},{"text":"Serukhi aari mwaana wa Reewu,","poem":2},{"lineBreak":true},{"text":"Reewu aari mwaana wa Peleekhi,","poem":2},{"lineBreak":true},{"text":"Peleekhi aari mwaana wa Ebeeri,","poem":2},{"lineBreak":true},{"text":"Ebeeri aari mwaana wa Saala,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Saala aari mwaana wa Kayinaamu,","poem":1},{"text":"Kayinaamu aari mwaana wa Arifwakisaati,","poem":2},{"lineBreak":true},{"text":"Arifwakisaati aari mwaana wa Sheemu,","poem":2},{"lineBreak":true},{"text":"Sheemu aari mwaana wa Nuuhi,","poem":2},{"lineBreak":true},{"text":"Nuuhi aari mwaana wa Lameekhi,","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Lameekhi aari mwaana wa Methusaleemu,","poem":1},{"text":"Methusaleemu aari mwaana wa Henookhi,","poem":2},{"lineBreak":true},{"text":"Henookhi aari mwaana wa Yareeti,","poem":2},{"lineBreak":true},{"text":"Yareeti aari mwaana wa Mahalaleeli,","poem":2},{"lineBreak":true},{"text":"Mahalaleeli aari mwaana wa Kayinaamu.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Kayinaamu aari mwaana wa Enooshi,","poem":1},{"text":"Enooshi aari mwaana wa Seethi,","poem":2},{"lineBreak":true},{"text":"Seethi aari mwaana wa Adamu,","poem":2},{"lineBreak":true},{"text":"Adamu wa Nnyizinku.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eko_wbt/LUK/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eko_wbt/LUK/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eko_wbt/LUK/2.json","previousChapterAudioLinks":{},"numberOfVerses":38}