poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Salimooni khunvokola Bowaazi,","poem":1},{"lineBreak":true},{"text":"mamaawe aari Rahaape;","poem":1},{"lineBreak":true},{"text":"Bowaazi khunvokola Obeedi,","poem":1},{"lineBreak":true},{"text":"mamaawe aari Ruuti;","poem":1},{"lineBreak":true},{"text":"Obeedi khunvokola Yeese;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"na Yeese khunvokola mfwalume Daawuuda.","poem":1},{"lineBreak":true},{"text":"Daawuuda khunvokola Seleyimaana,","poem":1},{"lineBreak":true},{"text":"mamaawe aari muukha wa Uriiya;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Seleyimaana khunvokola Ropowaawu;","poem":1},{"lineBreak":true},{"text":"Ropowaawu khunvokola Apiiya;","poem":1},{"lineBreak":true},{"text":"Apiiya khunvokola Aasa;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aasa khunvokola Zhuzaafwa;","poem":1},{"lineBreak":true},{"text":"Zhuzaafwa khunvokola Joraawu;","poem":1},{"lineBreak":true},{"text":"Joraawu khunvokola Uziiya;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Uziiya khunvokola Jotaawu;","poem":1},{"lineBreak":true},{"text":"Jotaawu khunvokola Akaaze;","poem":1},{"lineBreak":true},{"text":"Akaaze khunvokola Ezakiiya;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ezakiiya khunvokola Manaase;","poem":1},{"lineBreak":true},{"text":"Manaase khunvokola Amooni;","poem":1},{"lineBreak":true},{"text":"Amooni khunvokola Joziiya;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Joziiya khunvokola Jekoniiya na attwiize,","poem":1},{"lineBreak":true},{"text":"wakathi eekareliweeyo Babilooniya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Paata ya weettaniwa Babilooniya:","poem":1},{"lineBreak":true},{"text":"Jekoniiya khunvokola Sheyalitiyeeli; Sheyalitiyeeli khunvokola Zorobabeeli;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zorobabeeli khunvokola Apiwuute;","poem":1},{"lineBreak":true},{"text":"Apiwuute khunvokola Eliyakhiimu;","poem":1},{"lineBreak":true},{"text":"Eliyakhiimu khunvokola Azoori;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Azoori khunvokola Satookhi;","poem":1},{"lineBreak":true},{"text":"Satookhi khunvokola Akiini; Akiini khunvokola Eliwuuti;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Eliwuuti khunvokola Eliyazaari;","poem":1},{"lineBreak":true},{"text":"Eliyazaari khunvokola Maata;","poem":1},{"lineBreak":true},{"text":"Maata khunvokola Yaakhumpa;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"na Yaakhumpa khunvokola Yuusufu,","poem":1},{"lineBreak":true},{"text":"manna wa Mariyamu,","poem":1},{"lineBreak":true},{"text":"otule anvokoliyeeyo Yinsa,","poem":1},{"lineBreak":true},{"text":"othuuto aniitthiwaaye Al-Masiihu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":["Khwa etthiipo waaviriye ojama khumi na nne waaza va Eburahiima mpakha Daawuuda, na khumi na nne waaza va Daawuuda mpakha va okholiwa olawaniwa Babilooniya, na khumi na nne waaza Babilooniya mpakha va ovokoliwa wa Yinsa."]},{"type":"heading","content":["Ovokoliwa wa Yinsa Al-Masiihu"]},{"type":"verse","number":18,"content":["Ovokoliwa wa Yinsa Al-Masiihu pi toono. Mariyamu ari wooposiwa ti Yuusufu ahinarapalelane, khwiimittha khwa Rooho Ttakatthiifu."]},{"type":"verse","number":19,"content":["Ila Yuusufu, mposi awe, khwiiya ntthu wa shariya na woohitakhi ontwayifusha, ye khulakela sirini okayiri onrala."]},{"type":"verse","number":20,"content":["Ila, paata ya wuupuwela vitthu epile, khumpuwelela nlayikha la Mbwana nkatthi wa olottha, khumuuza yoori: “Yuusufu, mwaana wa Daawuuda, ohoove ompokhera Mariyamu wiiya muukhaawo, maana ye eemittha khwa Rooho Ttakatthiifu."]},{"type":"verse","number":21,"content":["Ye onteela ompattha mwaana, weeyo ontthaje nzina la Yinsa, maana ye onteela owoosuru atthu awe khwa twampi zaya.”"]},{"type":"verse","number":22,"content":["Zooshi epo enteela orettikhana yoori ziretteye zooshi epile Mbwana alupiyeeyo khwa napiyu yoori:"]},{"type":"verse","number":23,"content":["“Mwaari onteela wiimittha ampatthe mwaana, anttelaaye wiitthiwa Emanuweele, enlupaaye yoori ‘Nluku ori vamote na fweeyo’.”"]},{"type":"verse","number":24,"content":["Paata ya olankha, Yuusufu khuretta etile nlayikha la Mbwana laamuziyeeyo khumpokhera Mariyamu muukhaawe."]},{"type":"verse","number":25,"content":["Ye khaarapalelaniye mpakha ompattha mwaana. Khuntthaja nzina la Yinsa."]}],"footnotes":[]},"thisChapterLink":"/api/eko_wbt/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eko_wbt/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eko_wbt/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":25}