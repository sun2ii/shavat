{"translation":{"id":"emi_wbt","name":"Mussau-Emira Bible","website":"https://ebible.org/Scriptures/details.php?id=emi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=emi","licenseNotes":null,"shortName":"WBT","englishName":"Mussau-Emira Bible","language":"emi","textDirection":"ltr","sha256":"7cf6ffe6a91d3f358d1fb254a195fcaf6d8c39d3f6d6ad314b505c6ce9a752a0","availableFormats":["json"],"listOfBooksApiLink":"/api/emi_wbt/books.json","numberOfBooks":29,"totalNumberOfChapters":268,"totalNumberOfVerses":8064,"languageName":"Mussau-Emira","languageEnglishName":"Mussau-Emira"},"book":{"id":"JON","translationId":"emi_wbt","name":"Jona","commonName":"Jona","title":"Vuku eteva ta Jona","order":32,"numberOfChapters":4,"sha256":"78c72c7ca7576d724bf030d30869d6419b52ccc2977d8362ca4b59e90d1ce53b","firstChapterNumber":1,"firstChapterApiLink":"/api/emi_wbt/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/emi_wbt/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Jona ghe looloo sae"]},{"type":"verse","number":1,"content":["Elome tale kova kko ateva me Jona ang ghe looloo sae ta Iaue."]},{"type":"verse","number":2,"content":["Ghe ue va,",{"text":"“Voto sesa eghe lutu teeieghila, liuna avalua o me aghe kolo taula Iaue,","poem":1},{"text":"me eghe liula.","poem":2},{"text":"Aghe tokatoka tale voto ateva sesa ia, llo taumattu matena la tokatoka etana, me aghe kolokolo saela etam,","poem":1},{"text":"me ughe nongoaghila.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ughe sau velueghi sio mae","poem":1},{"text":"arau euueili tale paamanu eteva.","poem":2},{"text":"Manu eteva ghe akoueghila","poem":1},{"text":"me ugheleila kinatama kotoo atoa la ghasuula epona etaghi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Aghe annaa va, angu ghe tiu velueghila tale taataram","poem":1},{"text":"me karika,","poem":2},{"text":"ta aue aghi amene tara alem","poem":1},{"text":"ale manga ateva.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kotoo atoa la ghasuula epona etaghi, me egheleieghila gharighi tau ghele arropieghi","poem":1},{"text":"me malionge ateva ghe akoueghila.","poem":2},{"text":"Me rarrasa ngelamana atoa la ghakou taliaala urughu eteva.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aghe siola arau tale liue motouru etoa tale paamanu eteva.","poem":1},{"text":"Sesa voto ia nongina va atokatoka laalaa liu tale ale mata voovoo.","poem":2},{"text":"Iaue, io kapughu Goto io,","poem":1},{"text":"ughe ghaa oghieghila me aghe kasu vulila sesa voto ateva.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nau maamaulueaghi ange kapakapa,","poem":1},{"text":"aghe annaala Iaue,","poem":2},{"text":"me aghe looloo saela etam","poem":1},{"text":"tale alem ale manga ateva.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Llo taumattu ghe kakkaua kamena atoa kuturu,","poem":1},{"text":"laghe kasu vulila aielousiaam ateva.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Aghanna tani kkaueinio tale nikkinari me tale niaiaavusuvusuena,","poem":1},{"text":"tani tau sae ararim ateae.","poem":2},{"text":"Isaa akapa voto aghe gheleila inangari nialokoi etana, aue aghelei.","poem":1},{"text":"Iaue nonga erooroo tani asaangita.”","poem":2}]},{"type":"verse","number":10,"content":["Me Iaue ghe auliaala ta kko ateva, me kko ateva ghe laa sso lue atoka Jona elae."]}],"footnotes":[]},"thisChapterLink":"/api/emi_wbt/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/emi_wbt/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/emi_wbt/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}