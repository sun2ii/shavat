{"translation":{"id":"eng_abt","name":"American Standard Version Byzantine Text","website":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseNotes":null,"shortName":"ASVBT","englishName":"ASV Byzantine Text","language":"eng","textDirection":"ltr","sha256":"52505ccc9768bd034f1e3da944fcf3382ccae7545f65fc498e31917a77097655","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_abt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":18,"totalNumberOfApocryphalChapters":216,"totalNumberOfApocryphalVerses":6744},"book":{"id":"PS2","translationId":"eng_abt","name":"Psalm 151","commonName":"Psalm 151","title":"PSALM 151","order":84,"numberOfChapters":1,"isApocryphal":true,"sha256":"e311cdaa32f6223dded94203b791af005fc43fd3b4dc3b170edad90fba670498","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_abt/PS2/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/eng_abt/PS2/1.json","totalNumberOfVerses":7},"chapter":{"number":1,"content":[{"type":"hebrew_subtitle","content":["This Psalm is a genuine one of David, though supernumerary, composed when he fought in single combat with Goliath."]},{"type":"verse","number":1,"content":[{"text":"I was small among my brethren,","poem":1},{"lineBreak":true},{"text":"And youngest in my father’s house:","poem":1},{"lineBreak":true},{"text":"I tended my father’s sheep.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"My hands formed a musical instrument,","poem":1},{"lineBreak":true},{"text":"And my fingers tuned a psaltery.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"And who shall tell my Lord?","poem":1},{"lineBreak":true},{"text":"The Lord himself, he himself heareth.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He sent forth his angel,","poem":1},{"lineBreak":true},{"text":"And took me from my father’s sheep,","poem":1},{"lineBreak":true},{"text":"And he anointed me with the oil of his anointing.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"My brethren were handsome and tall;","poem":1},{"lineBreak":true},{"text":"But the Lord did not take pleasure in them.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I went forth to meet the Philistine;","poem":1},{"lineBreak":true},{"text":"And he cursed me by his idols.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"But I drew his own sword, and beheaded him,","poem":1},{"lineBreak":true},{"text":"And removed reproach from the children of Israel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_abt/PS2/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_abt/PSS/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_abt/MAN/1.json","previousChapterAudioLinks":{},"numberOfVerses":7}