{"translation":{"id":"eng_abt","name":"American Standard Version Byzantine Text","website":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseNotes":null,"shortName":"ASVBT","englishName":"ASV Byzantine Text","language":"eng","textDirection":"ltr","sha256":"52505ccc9768bd034f1e3da944fcf3382ccae7545f65fc498e31917a77097655","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_abt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":18,"totalNumberOfApocryphalChapters":216,"totalNumberOfApocryphalVerses":6744},"book":{"id":"PSA","translationId":"eng_abt","name":"Psalms","commonName":"Psalms","title":"THE PSALMS","order":19,"numberOfChapters":150,"sha256":"6f1e14e58a2bd60026d935a29789fc0f57abb70894fb53fa7776d8646c5d2f19","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"By the rivers of Babylon,","poem":1},{"lineBreak":true},{"text":"There we sat down, yea, we wept,","poem":1},{"lineBreak":true},{"text":"When we remembered Zion.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Upon the willows in the midst thereof","poem":1},{"lineBreak":true},{"text":"We hung up our harps.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For there they that led us captive required of us songs,","poem":1},{"lineBreak":true},{"text":"And they that wasted us required of us mirth, saying,","poem":1},{"lineBreak":true},{"text":"Sing us one of the songs of Zion.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"How shall we sing Jehovah’s song","poem":1},{"lineBreak":true},{"text":"In a foreign land?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"If I forget thee, O Jerusalem,","poem":1},{"lineBreak":true},{"text":"Let my right hand forget her skill.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Let my tongue cleave to the roof of my mouth,","poem":1},{"lineBreak":true},{"text":"If I remember thee not;","poem":1},{"lineBreak":true},{"text":"If I prefer not Jerusalem","poem":1},{"lineBreak":true},{"text":"Above my chief joy.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Remember, O Jehovah, against the children of Edom","poem":1},{"lineBreak":true},{"text":"The day of Jerusalem;","poem":1},{"lineBreak":true},{"text":"Who said, Raze it, raze it,","poem":1},{"lineBreak":true},{"text":"Even to the foundation thereof.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O daughter of Babylon, that art to be destroyed,","poem":1},{"lineBreak":true},{"text":"Happy shall he be, that rewardeth thee","poem":1},{"lineBreak":true},{"text":"As thou hast served us.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Happy shall he be, that taketh and dasheth thy little ones","poem":1},{"lineBreak":true},{"text":"Against the rock.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_abt/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_abt/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_abt/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}