{"translation":{"id":"eng_abt","name":"American Standard Version Byzantine Text","website":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseNotes":null,"shortName":"ASVBT","englishName":"ASV Byzantine Text","language":"eng","textDirection":"ltr","sha256":"52505ccc9768bd034f1e3da944fcf3382ccae7545f65fc498e31917a77097655","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_abt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":18,"totalNumberOfApocryphalChapters":216,"totalNumberOfApocryphalVerses":6744},"book":{"id":"PSA","translationId":"eng_abt","name":"Psalms","commonName":"Psalms","title":"THE PSALMS","order":19,"numberOfChapters":150,"sha256":"6f1e14e58a2bd60026d935a29789fc0f57abb70894fb53fa7776d8646c5d2f19","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician. A Psalm of David; to bring to remembrance."]},{"type":"verse","number":1,"content":[{"text":"Make haste, O God, to deliver me;","poem":1},{"lineBreak":true},{"text":"Make haste to help me, O Jehovah.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Let them be put to shame and confounded","poem":1},{"lineBreak":true},{"text":"That seek after my soul:","poem":1},{"lineBreak":true},{"text":"Let them be turned backward and brought to dishonor","poem":1},{"lineBreak":true},{"text":"That delight in my hurt.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let them be turned back by reason of their shame","poem":1},{"lineBreak":true},{"text":"That say, Aha, aha.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Let all those that seek thee rejoice and be glad in thee;","poem":1},{"lineBreak":true},{"text":"And let such as love thy salvation say continually,","poem":1},{"lineBreak":true},{"text":"Let God be magnified.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"But I am poor and needy;","poem":1},{"lineBreak":true},{"text":"Make haste unto me, O God:","poem":1},{"lineBreak":true},{"text":"Thou art my help and my deliverer;","poem":1},{"lineBreak":true},{"text":"O Jehovah, make no tarrying.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_abt/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_abt/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_abt/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}