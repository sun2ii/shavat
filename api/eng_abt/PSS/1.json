{"translation":{"id":"eng_abt","name":"American Standard Version Byzantine Text","website":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseNotes":null,"shortName":"ASVBT","englishName":"ASV Byzantine Text","language":"eng","textDirection":"ltr","sha256":"52505ccc9768bd034f1e3da944fcf3382ccae7545f65fc498e31917a77097655","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_abt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":18,"totalNumberOfApocryphalChapters":216,"totalNumberOfApocryphalVerses":6744},"book":{"id":"PSS","translationId":"eng_abt","name":"Psalms of Solomon","commonName":"Psalms of Solomon","title":"THE PSALMS OF SOLOMON","order":86,"numberOfChapters":18,"isApocryphal":true,"sha256":"3f21e38141eb9e5e03498115331fbbf7c869e1a24f13baee9d064b5d43d910da","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_abt/PSS/1.json","lastChapterNumber":18,"lastChapterApiLink":"/api/eng_abt/PSS/18.json","totalNumberOfVerses":293},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"I cried unto the Lord when I was in distress,","poem":1},{"lineBreak":true},{"text":"Unto God when sinners assailed.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Suddenly the alarm of war was heard before me;","poem":1},{"lineBreak":true},{"text":"I said, He will hearken to me, for I am full of righteousness.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I thought in my heart that I was full of righteousness,","poem":1},{"lineBreak":true},{"text":"Because I was well off and had become rich in children.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Their wealth spread to the whole earth,","poem":1},{"lineBreak":true},{"text":"And their glory unto the end of the earth.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"They were exalted unto the stars;","poem":1},{"lineBreak":true},{"text":"They said they would never fall.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"But they became insolent in their prosperity,","poem":1},{"lineBreak":true},{"text":"And they were without understanding,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Their sins were in secret,","poem":1},{"lineBreak":true},{"text":"And even I had no knowledge of them.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Their transgressions went beyond those of the heathen before them;","poem":1},{"lineBreak":true},{"text":"They utterly polluted the holy things of the Lord.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_abt/PSS/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_abt/PSS/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_abt/PS2/1.json","previousChapterAudioLinks":{},"numberOfVerses":8}