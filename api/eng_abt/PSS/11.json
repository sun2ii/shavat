{"translation":{"id":"eng_abt","name":"American Standard Version Byzantine Text","website":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseNotes":null,"shortName":"ASVBT","englishName":"ASV Byzantine Text","language":"eng","textDirection":"ltr","sha256":"52505ccc9768bd034f1e3da944fcf3382ccae7545f65fc498e31917a77097655","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_abt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":18,"totalNumberOfApocryphalChapters":216,"totalNumberOfApocryphalVerses":6744},"book":{"id":"PSS","translationId":"eng_abt","name":"Psalms of Solomon","commonName":"Psalms of Solomon","title":"THE PSALMS OF SOLOMON","order":86,"numberOfChapters":18,"isApocryphal":true,"sha256":"3f21e38141eb9e5e03498115331fbbf7c869e1a24f13baee9d064b5d43d910da","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_abt/PSS/1.json","lastChapterNumber":18,"lastChapterApiLink":"/api/eng_abt/PSS/18.json","totalNumberOfVerses":293},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["Of Solomon. Unto expectation."]},{"type":"verse","number":1,"content":[{"text":"Blow ye in Zion on the trumpet to summon the saints,","poem":1},{"lineBreak":true},{"text":"Cause ye to be heard in Jerusalem the voice of him that bringeth good tidings;","poem":1},{"lineBreak":true},{"text":"For God hath had pity on Israel in visiting them.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Stand on the height, O Jerusalem, and behold thy children,","poem":1},{"lineBreak":true},{"text":"From the East and the West, gathered together by the Lord;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"From the North they come in the gladness of their God,","poem":1},{"lineBreak":true},{"text":"From the isles afar off God hath gathered them.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"High mountains hath he abased into a plain for them;","poem":1},{"lineBreak":true},{"text":"The hills fled at their entrance.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The woods gave them shelter as they passed by;","poem":1},{"lineBreak":true},{"text":"Every sweet-smelling tree God caused to spring up for them,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"That Israel might pass by in the visitation of the glory of their God.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Put on, O Jerusalem, thy glorious garments;","poem":1},{"lineBreak":true},{"text":"Make ready thy holy robe;","poem":1},{"lineBreak":true},{"text":"For God hath spoken good concerning Israel, forever and ever.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Let the Lord do what he hath spoken concerning Israel and Jerusalem;","poem":1},{"lineBreak":true},{"text":"Let the Lord raise up Israel by his glorious name.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The mercy of the Lord be upon Israel forever and ever.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_abt/PSS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_abt/PSS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_abt/PSS/10.json","previousChapterAudioLinks":{},"numberOfVerses":9}