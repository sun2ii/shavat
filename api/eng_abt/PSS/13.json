{"translation":{"id":"eng_abt","name":"American Standard Version Byzantine Text","website":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseNotes":null,"shortName":"ASVBT","englishName":"ASV Byzantine Text","language":"eng","textDirection":"ltr","sha256":"52505ccc9768bd034f1e3da944fcf3382ccae7545f65fc498e31917a77097655","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_abt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":18,"totalNumberOfApocryphalChapters":216,"totalNumberOfApocryphalVerses":6744},"book":{"id":"PSS","translationId":"eng_abt","name":"Psalms of Solomon","commonName":"Psalms of Solomon","title":"THE PSALMS OF SOLOMON","order":86,"numberOfChapters":18,"isApocryphal":true,"sha256":"3f21e38141eb9e5e03498115331fbbf7c869e1a24f13baee9d064b5d43d910da","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_abt/PSS/1.json","lastChapterNumber":18,"lastChapterApiLink":"/api/eng_abt/PSS/18.json","totalNumberOfVerses":293},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["Of Solomon. A Psalm. Comfort for the righteous."]},{"type":"verse","number":1,"content":[{"text":"The right hand of the Lord hath covered me;","poem":1},{"lineBreak":true},{"text":"The right hand of the Lord hath spared us.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The arm of the Lord hath saved us from the sword that passed through,","poem":1},{"lineBreak":true},{"text":"From famine and the death of sinners.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Noisome beasts ran upon them:","poem":1},{"lineBreak":true},{"text":"With their teeth they tare their flesh,","poem":1},{"lineBreak":true},{"text":"And with their molars crushed their bones;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"But from all these things the Lord delivered us.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The righteous was troubled on account of his errors,","poem":1},{"lineBreak":true},{"text":"Lest he should be taken away along with the sinners;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"For terrible is the overthrow of the sinner;","poem":1},{"lineBreak":true},{"text":"But not one of all these things toucheth the righteous.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For not alike are the chastening of the righteous for sins done in ignorance,","poem":1},{"lineBreak":true},{"text":"And the overthrow of the sinners.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Secretly is the righteous chastened,","poem":1},{"lineBreak":true},{"text":"Lest the sinner rejoice over the righteous.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"For he correcteth the righteous as a beloved son,","poem":1},{"lineBreak":true},{"text":"And his chastisement is as that of a firstborn.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"For the Lord spareth his pious ones,","poem":1},{"lineBreak":true},{"text":"And blotteth out their errors by his chastening.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"For the life of the righteous shall be forever;","poem":1},{"lineBreak":true},{"text":"But sinners shall be taken away into destruction,","poem":1},{"lineBreak":true},{"text":"And their memorial shall be found no more.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"But upon the pious is the mercy of the Lord,","poem":1},{"lineBreak":true},{"text":"And upon them that fear him his mercy.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_abt/PSS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_abt/PSS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_abt/PSS/12.json","previousChapterAudioLinks":{},"numberOfVerses":12}