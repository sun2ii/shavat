{"translation":{"id":"eng_abt","name":"American Standard Version Byzantine Text","website":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseNotes":null,"shortName":"ASVBT","englishName":"ASV Byzantine Text","language":"eng","textDirection":"ltr","sha256":"52505ccc9768bd034f1e3da944fcf3382ccae7545f65fc498e31917a77097655","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_abt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":18,"totalNumberOfApocryphalChapters":216,"totalNumberOfApocryphalVerses":6744},"book":{"id":"PSS","translationId":"eng_abt","name":"Psalms of Solomon","commonName":"Psalms of Solomon","title":"THE PSALMS OF SOLOMON","order":86,"numberOfChapters":18,"isApocryphal":true,"sha256":"3f21e38141eb9e5e03498115331fbbf7c869e1a24f13baee9d064b5d43d910da","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_abt/PSS/1.json","lastChapterNumber":18,"lastChapterApiLink":"/api/eng_abt/PSS/18.json","totalNumberOfVerses":293},"chapter":{"number":14,"content":[{"type":"hebrew_subtitle","content":["A Hymn. Of Solomon."]},{"type":"verse","number":1,"content":[{"text":"Faithful is the Lord to them that love him in truth,","poem":1},{"lineBreak":true},{"text":"To them that endure his chastening,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"To them that walk in the righteousness of his commandments,","poem":1},{"lineBreak":true},{"text":"In the law which he commanded us that we might live.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The pious of the Lord shall live by it forever;","poem":1},{"lineBreak":true},{"text":"The Paradise of the Lord, the trees of life, are his pious ones.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Their planting is rooted forever;","poem":1},{"lineBreak":true},{"text":"They shall not be plucked up all the days of heaven:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For the portion and the inheritance of God is Israel.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"But not so are the sinners and transgressors,","poem":1},{"lineBreak":true},{"text":"Who love the brief day spent in companionship with their sin;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Their delight is in fleeting corruption,","poem":1},{"lineBreak":true},{"text":"And they remember not God.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For the ways of men are known before him at all times,","poem":1},{"lineBreak":true},{"text":"And he knoweth the secrets of the heart before they come to pass.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Therefore their inheritance is Hades and darkness and destruction,","poem":1},{"lineBreak":true},{"text":"And they shall not be found in the day when the righteous obtain mercy;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"But the pious of the Lord shall inherit life in gladness.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_abt/PSS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_abt/PSS/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_abt/PSS/13.json","previousChapterAudioLinks":{},"numberOfVerses":10}