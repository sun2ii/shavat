{"translation":{"id":"eng_abt","name":"American Standard Version Byzantine Text","website":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseNotes":null,"shortName":"ASVBT","englishName":"ASV Byzantine Text","language":"eng","textDirection":"ltr","sha256":"52505ccc9768bd034f1e3da944fcf3382ccae7545f65fc498e31917a77097655","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_abt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":18,"totalNumberOfApocryphalChapters":216,"totalNumberOfApocryphalVerses":6744},"book":{"id":"PSS","translationId":"eng_abt","name":"Psalms of Solomon","commonName":"Psalms of Solomon","title":"THE PSALMS OF SOLOMON","order":86,"numberOfChapters":18,"isApocryphal":true,"sha256":"3f21e38141eb9e5e03498115331fbbf7c869e1a24f13baee9d064b5d43d910da","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_abt/PSS/1.json","lastChapterNumber":18,"lastChapterApiLink":"/api/eng_abt/PSS/18.json","totalNumberOfVerses":293},"chapter":{"number":6,"content":[{"type":"hebrew_subtitle","content":["In Hope. Of Solomon."]},{"type":"verse","number":1,"content":[{"text":"Happy is the man whose heart is fixed to call upon the name of the Lord;","poem":1},{"lineBreak":true},{"text":"When he remembereth the name of the Lord, he will be saved.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"His ways are made even by the Lord,","poem":1},{"lineBreak":true},{"text":"And the works of his hands are preserved by the Lord his God.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"At what he seeth in his bad dreams, his soul shall not be troubled;","poem":1},{"lineBreak":true},{"text":"When he passeth through rivers and the tossing of the seas, he shall not be dismayed.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He ariseth from his sleep, and blesseth the name of the Lord:","poem":1},{"lineBreak":true},{"text":"When his heart is at peace, he singeth to the name of his God,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"And he entreateth the Lord for all his house.","poem":1},{"lineBreak":true},{"text":"And the Lord heareth the prayer of everyone that feareth God,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"And every request of the soul that hopeth for him doth the Lord accomplish.","poem":1},{"lineBreak":true},{"text":"Blessed is the Lord, who showeth mercy to those who love him in sincerity.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_abt/PSS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_abt/PSS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_abt/PSS/5.json","previousChapterAudioLinks":{},"numberOfVerses":6}