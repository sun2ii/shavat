{"translation":{"id":"eng_abt","name":"American Standard Version Byzantine Text","website":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseNotes":null,"shortName":"ASVBT","englishName":"ASV Byzantine Text","language":"eng","textDirection":"ltr","sha256":"52505ccc9768bd034f1e3da944fcf3382ccae7545f65fc498e31917a77097655","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_abt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":18,"totalNumberOfApocryphalChapters":216,"totalNumberOfApocryphalVerses":6744},"book":{"id":"PSS","translationId":"eng_abt","name":"Psalms of Solomon","commonName":"Psalms of Solomon","title":"THE PSALMS OF SOLOMON","order":86,"numberOfChapters":18,"isApocryphal":true,"sha256":"3f21e38141eb9e5e03498115331fbbf7c869e1a24f13baee9d064b5d43d910da","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_abt/PSS/1.json","lastChapterNumber":18,"lastChapterApiLink":"/api/eng_abt/PSS/18.json","totalNumberOfVerses":293},"chapter":{"number":7,"content":[{"type":"hebrew_subtitle","content":["Of Solomon. Of turning."]},{"type":"verse","number":1,"content":[{"text":"Make not thy dwelling afar from us, O God;","poem":1},{"lineBreak":true},{"text":"Lest they assail us that hate us without cause.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For thou hast rejected them, O God;","poem":1},{"lineBreak":true},{"text":"Let not their foot trample upon thy holy inheritance.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Chasten us thyself in thy good pleasure;","poem":1},{"lineBreak":true},{"text":"But give us not up to the nations;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For, if thou sendest pestilence,","poem":1},{"lineBreak":true},{"text":"Thou thyself givest it charge concerning us;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For thou art merciful,","poem":1},{"lineBreak":true},{"text":"And wilt not be angry to the point of consuming us.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"While thy name dwelleth in our midst, we shall find mercy;","poem":1},{"lineBreak":true},{"text":"And the nations shall not prevail against us.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For thou art our shield,","poem":1},{"lineBreak":true},{"text":"And when we call upon thee, thou hearkenest to us;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For thou wilt pity the seed of Israel forever, and thou wilt not reject them:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"But we shall be under thy yoke forever,","poem":1},{"lineBreak":true},{"text":"And under the rod of thy chastening.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Thou wilt establish us in the time that thou helpest us,","poem":1},{"lineBreak":true},{"text":"Showing mercy to the house of Jacob on the day wherein thou didst promise to help them.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_abt/PSS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_abt/PSS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_abt/PSS/6.json","previousChapterAudioLinks":{},"numberOfVerses":10}