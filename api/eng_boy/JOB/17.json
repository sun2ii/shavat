{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"JOB","translationId":"eng_boy","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"c463a08d0413f540055c35a569c2cbf403dc62a4fda664cf1e3585b56ab0b7df","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/eng_boy/JOB/42.json","totalNumberOfVerses":1082},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"I perish, carried away by the wind,","poem":1},{"lineBreak":true},{"text":"And I seek for burial, and obtain it not.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Weary I entreat; and what have I done?","poem":1},{"lineBreak":true},{"text":"And strangers have stolen my goods.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Who is this? let him join hands with me.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For thou hast hidden their heart from wisdom;","poem":1},{"lineBreak":true},{"text":"Therefore thou shalt not exalt them.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"He shall promise mischief to his companions:","poem":1},{"lineBreak":true},{"text":"But their eyes have failed for their children.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"But thou hast made me a byword among the nations,","poem":1},{"lineBreak":true},{"text":"And I am become a scorn to them.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For my eyes are dimmed through pain;","poem":1},{"lineBreak":true},{"text":"I have been grievously beset by all.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wonder has seized true men upon this;","poem":1},{"lineBreak":true},{"text":"And let the just rise up against the transgressor.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"But let the faithful hold on his own way,","poem":1},{"lineBreak":true},{"text":"And let him that is pure of hands take courage.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Howbeit, do ye all strengthen yourselves and come now,","poem":1},{"lineBreak":true},{"text":"For I do not find truth in you.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"My days have passed in groaning,","poem":1},{"lineBreak":true},{"text":"And my heartstrings are broken.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I have turned the night into day:","poem":1},{"lineBreak":true},{"text":"The light is short because of darkness.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"For if I remain, Hades is my habitation:","poem":1},{"lineBreak":true},{"text":"And my bed has been made in darkness.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"I have called upon death to be my father,","poem":1},{"lineBreak":true},{"text":"And corruption to be my mother and sister.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Where then is yet my hope?","poem":1},{"lineBreak":true},{"text":"Or where shall I see my good?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Will they go down with me to Hades,","poem":1},{"lineBreak":true},{"text":"Or shall we go down together to the tomb?","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}