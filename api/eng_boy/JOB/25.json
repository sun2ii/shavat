{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"JOB","translationId":"eng_boy","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"c463a08d0413f540055c35a569c2cbf403dc62a4fda664cf1e3585b56ab0b7df","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/eng_boy/JOB/42.json","totalNumberOfVerses":1082},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":[{"text":"Then Bildad the Shuhite answered and said,","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"What beginning or fear is his—","poem":1},{"lineBreak":true},{"text":"Even he that makes all things in the highest?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For let none think that there is a respite for robbers:","poem":1},{"lineBreak":true},{"text":"And upon whom will there not come a snare from him?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For how shall a mortal be just before the Lord?","poem":1},{"lineBreak":true},{"text":"Or who that is born of a woman shall purify himself?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"If he gives an order to the moon, then it shines not;","poem":1},{"lineBreak":true},{"text":"And the stars are not pure before him.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"But alas! man is corruption,","poem":1},{"lineBreak":true},{"text":"And the son of man a worm.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}