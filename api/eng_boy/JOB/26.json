{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"JOB","translationId":"eng_boy","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"c463a08d0413f540055c35a569c2cbf403dc62a4fda664cf1e3585b56ab0b7df","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/eng_boy/JOB/42.json","totalNumberOfVerses":1082},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"But Job answered and said,","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"To whom dost thou attach thyself, or whom art thou going to assist?","poem":1},{"lineBreak":true},{"text":"Is it not he that has much strength, and he who has a strong arm?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"To whom hast thou given counsel? is it not to him who has all wisdom?","poem":1},{"lineBreak":true},{"text":"Whom wilt thou follow? is it not one who has the greatest power?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"To whom hast thou uttered words?","poem":1},{"lineBreak":true},{"text":"And whose breath is it that has come forth from thee?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Shall giants be born","poem":1},{"lineBreak":true},{"text":"From under the water and the inhabitants thereof?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hell is naked before him,","poem":1},{"lineBreak":true},{"text":"And destruction has no covering.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He stretches out the north wind upon nothing,","poem":1},{"lineBreak":true},{"text":"And he upon nothing hangs the earth;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Binding water in his clouds,","poem":1},{"lineBreak":true},{"text":"And the cloud is not rent under it.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He keeps back the face of his throne,","poem":1},{"lineBreak":true},{"text":"Stretching out his cloud upon it.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"He has encompassed the face of the water by an appointed ordinance,","poem":1},{"lineBreak":true},{"text":"Until the end of light and darkness.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"The pillars of heaven are prostrate","poem":1},{"lineBreak":true},{"text":"And astonished at his rebuke.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"He has calmed the sea with his might,","poem":1},{"lineBreak":true},{"text":"And by his wisdom the whale has been overthrown.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"And the barriers of heaven fear him,","poem":1},{"lineBreak":true},{"text":"And by a command he has slain the apostate dragon.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Behold, these are parts of his way;","poem":1},{"lineBreak":true},{"text":"And we will hearken to him at the least intimation of his word:","poem":1},{"lineBreak":true},{"text":"But the strength of his thunder who knows, when he shall employ it?","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}