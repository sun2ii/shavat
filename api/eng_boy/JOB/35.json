{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"JOB","translationId":"eng_boy","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"c463a08d0413f540055c35a569c2cbf403dc62a4fda664cf1e3585b56ab0b7df","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/eng_boy/JOB/42.json","totalNumberOfVerses":1082},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":[{"text":"And Elihu resumed and said,","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"What is this that thou thinkest to be according to right?","poem":1},{"lineBreak":true},{"text":"Who art thou that thou hast said, I am righteous before the Lord?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I will answer thee,","poem":1},{"lineBreak":true},{"text":"And thy three friends.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Look up to the sky and see;","poem":1},{"lineBreak":true},{"text":"And consider the clouds, how high they are above thee.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"If thou hast sinned, what wilt thou do?","poem":1},{"lineBreak":true},{"text":"And if too thou hast transgressed much, what canst thou perform?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"And suppose thou art righteous, what wilt thou give him?","poem":1},{"lineBreak":true},{"text":"Or what shall he receive of thy hand?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Thy ungodliness may affect a man who is like to thee;","poem":1},{"lineBreak":true},{"text":"Or thy righteousness a son of man.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"They that are oppressed of a multitude will be ready to cry out;","poem":1},{"lineBreak":true},{"text":"They will call for help because of the arm of many.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"But none said, Where is God that made me,","poem":1},{"lineBreak":true},{"text":"Who appoints the night watches;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Who makes me to differ from the four-footed beasts of the earth,","poem":1},{"lineBreak":true},{"text":"And from the birds of the sky?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"There they shall cry, and none shall hearken,","poem":1},{"lineBreak":true},{"text":"Even because of the insolence of wicked men.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"For the Lord desires not to look on error,","poem":1},{"lineBreak":true},{"text":"For he is the Almighty One.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"He beholds them that perform lawless deeds, and he will save me:","poem":1},{"lineBreak":true},{"text":"And do thou plead before him, if thou canst praise him, as it is possible even now.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"For he is not now regarding his wrath,","poem":1},{"lineBreak":true},{"text":"Nor has he noticed severely any trespass.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yet Job vainly opens his mouth,","poem":1},{"lineBreak":true},{"text":"In ignorance he multiplies words.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":15}