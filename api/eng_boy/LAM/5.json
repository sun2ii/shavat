{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"LAM","translationId":"eng_boy","name":"Lamentations","commonName":"Lamentations","title":"Lamentations","order":25,"numberOfChapters":5,"sha256":"2ee938ea3f63bb2576805c71465be2ebbae3a410b216e4e9e262439f50473534","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/eng_boy/LAM/5.json","totalNumberOfVerses":153},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Remember, O Lord, what has happened to us:","poem":1},{"lineBreak":true},{"text":"Behold, and look on our reproach.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Our inheritance has been turned away to aliens,","poem":1},{"lineBreak":true},{"text":"Our houses to strangers:","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"We are become orphans, we have no father,","poem":1},{"lineBreak":true},{"text":"Our mothers are as widows.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"We have drunk our water for money;","poem":1},{"lineBreak":true},{"text":"Our wood is sold to us for a burden on our neck:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"We have been persecuted,","poem":1},{"lineBreak":true},{"text":"We have labored, we have had no rest.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Egypt gave the hand to us,","poem":1},{"lineBreak":true},{"text":"Assyria to their own satisfaction.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Our fathers sinned, and are not:","poem":1},{"lineBreak":true},{"text":"We have borne their iniquities.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Servants have ruled over us:","poem":1},{"lineBreak":true},{"text":"There is none to ransom us out of their hand.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"We shall bring in our bread with danger of our lives,","poem":1},{"lineBreak":true},{"text":"Because of the sword of the wilderness.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Our skin is blackened like an oven;","poem":1},{"lineBreak":true},{"text":"They are convulsed, because of the storms of famine.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"They humbled the women in Zion,","poem":1},{"lineBreak":true},{"text":"The virgins in the cities of Judah.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Princes were hanged up by their hands: the elders were not honored.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"The chosen men lifted up the voice in weeping,","poem":1},{"lineBreak":true},{"text":"And the youths fainted under the wood.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"And the elders ceased from the gate,","poem":1},{"lineBreak":true},{"text":"The chosen men ceased from their music.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"The joy of our heart has ceased;","poem":1},{"lineBreak":true},{"text":"Our dance is turned into mourning.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"The crown has fallen from our head:","poem":1},{"lineBreak":true},{"text":"Yea, woe to us! for we have sinned.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"For this has grief come; our heart is sorrowful:","poem":1},{"lineBreak":true},{"text":"For this our eyes are darkened.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Over the mountain of Zion, because it is made desolate,","poem":1},{"lineBreak":true},{"text":"Foxes have walked therein.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"But thou, O Lord, shalt dwell forever;","poem":1},{"lineBreak":true},{"text":"Thy throne shall endure to generation and generation.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Wherefore wilt thou utterly forget us,","poem":1},{"lineBreak":true},{"text":"And abandon us a long time?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Turn us, O Lord, to thee, and we shall be turned;","poem":1},{"lineBreak":true},{"text":"And renew our days as before.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"For thou hast indeed rejected us;","poem":1},{"lineBreak":true},{"text":"Thou hast been very wroth against us.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}