{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Blessed is the man who has not walked in the counsel of the ungodly,","poem":1},{"lineBreak":true},{"text":"And has not stood in the way of sinners,","poem":1},{"lineBreak":true},{"text":"And has not sat in the seat of evil men.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"But his pleasure is in the law of the Lord;","poem":1},{"lineBreak":true},{"text":"And in his law will he meditate day and night.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"And he shall be as a tree planted by the brooks of waters,","poem":1},{"lineBreak":true},{"text":"Which shall yield its fruit in its season,","poem":1},{"lineBreak":true},{"text":"And its leaf shall not fall off;","poem":1},{"lineBreak":true},{"text":"And whatsoever he shall do shall be prospered.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Not so the ungodly—not so:","poem":1},{"lineBreak":true},{"text":"But rather as the chaff which the wind scatters away from the face of the earth.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Therefore the ungodly shall not rise in judgment,","poem":1},{"lineBreak":true},{"text":"Nor sinners in the counsel of the just.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"For the Lord knows the way of the righteous;","poem":1},{"lineBreak":true},{"text":"But the way of the ungodly shall perish.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}