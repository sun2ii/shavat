{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"For the end, a Psalm of David.","descriptive":true},{"text":"In the Lord I have put my trust: how will ye say to my soul,","poem":1},{"lineBreak":true},{"text":"Flee to the mountains as a sparrow?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For behold the sinners have bent their bow,","poem":1},{"lineBreak":true},{"text":"They have prepared their arrows for the quiver,","poem":1},{"lineBreak":true},{"text":"To shoot privily at the upright in heart.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For they have pulled down what thou didst frame,","poem":1},{"lineBreak":true},{"text":"But what has the righteous done?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"The Lord is in his holy temple,","poem":1},{"lineBreak":true},{"text":"As for the Lord, his throne is in heaven:","poem":1},{"lineBreak":true},{"text":"His eyes look upon the poor,","poem":1},{"lineBreak":true},{"text":"His eyelids try the sons of men.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The Lord tries the righteous and the ungodly:","poem":1},{"lineBreak":true},{"text":"And he that loves unrighteousness hates his own soul.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He shall rain upon sinners snares,","poem":1},{"lineBreak":true},{"text":"Fire, and brimstone, and a stormy blast shall be the portion of their cup.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For the Lord is righteous, and loves righteousness;","poem":1},{"lineBreak":true},{"text":"His face beholds uprightness.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":7}