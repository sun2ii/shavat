{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":100,"content":[{"type":"verse","number":1,"content":[{"text":"A Psalm of David.","descriptive":true},{"text":"I will sing to thee, O Lord, of mercy and judgment;","poem":1},{"lineBreak":true},{"text":"I will sing a psalm,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"and I will be wise in a blameless way. When wilt thou come to me?","poem":1},{"lineBreak":true},{"text":"I walked in the innocence of my heart, in the midst of my house.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I have not set before mine eyes any unlawful thing;","poem":1},{"lineBreak":true},{"text":"I have hated transgressors.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A perverse heart has not cloven to me;","poem":1},{"lineBreak":true},{"text":"I have not known an evil man, forasmuch as he turns away from me.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Him that privily speaks against his neighbor, him have I driven from me:","poem":1},{"lineBreak":true},{"text":"He that is proud in look and insatiable in heart—with him I have not eaten.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mine eyes shall be upon the faithful of the land, that they may dwell with me:","poem":1},{"lineBreak":true},{"text":"He that walked in a perfect way, the same ministered to me.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The proud doer dwelt not in the midst of my house;","poem":1},{"lineBreak":true},{"text":"The unjust speaker prospered not in my sight.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Early did I slay all the sinners of the land,","poem":1},{"lineBreak":true},{"text":"That I might destroy out of the city of the Lord all that work iniquity.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":8}