{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":107,"content":[{"type":"verse","number":1,"content":[{"text":"Song of a Psalm by David.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"O God, my heart is ready, my heart is ready;","poem":1},{"lineBreak":true},{"text":"I will sing and sing psalms with my glory.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Awake, psaltery and harp;","poem":1},{"lineBreak":true},{"text":"I will awake early.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I will give thanks to thee, O Lord, among the people;","poem":1},{"lineBreak":true},{"text":"I will sing praise to thee among the Gentiles.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For thy mercy is great above the heavens,","poem":1},{"lineBreak":true},{"text":"And thy truth reaches to the clouds.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Be thou exalted, O God, above the heavens;","poem":1},{"lineBreak":true},{"text":"And thy glory above all the earth.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"That thy beloved ones may be delivered,","poem":1},{"lineBreak":true},{"text":"Save with thy right hand, and hear me.","poem":1},{"lineBreak":true},{"text":"God has spoken in his sanctuary;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I will be exalted, and will divide Shechem,","poem":1},{"lineBreak":true},{"text":"And will measure out the Valley of Tents.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gilead is mine; and Manasseh is mine;","poem":1},{"lineBreak":true},{"text":"And Ephraim is the help of my head;","poem":1},{"lineBreak":true},{"text":"Judah is my king;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Moab is the caldron of my hope;","poem":1},{"lineBreak":true},{"text":"Over Edom will I cast my sandal;","poem":1},{"lineBreak":true},{"text":"The Philistines are made subject to me.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Who will bring me into the fortified city?","poem":1},{"lineBreak":true},{"text":"Or who will guide me to Edom?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wilt not thou, O God, who hast rejected us?","poem":1},{"lineBreak":true},{"text":"And wilt not thou, O God, go forth with our hosts?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Give us help from tribulation:","poem":1},{"lineBreak":true},{"text":"For vain is the help of man.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Through God we shall do valiantly;","poem":1},{"lineBreak":true},{"text":"And he will bring to nought our enemies.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/107.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/108.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/106.json","previousChapterAudioLinks":{},"numberOfVerses":14}