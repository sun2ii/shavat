{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":109,"content":[{"type":"verse","number":1,"content":[{"text":"A Psalm of David.","descriptive":true},{"text":"The Lord said to my Lord, Sit thou on my right hand,","poem":1},{"lineBreak":true},{"text":"Until I make thine enemies thy footstool.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The Lord shall send out a rod of power for thee out of Zion:","poem":1},{"lineBreak":true},{"text":"Rule thou in the midst of thine enemies.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"With thee is dominion in the day of thy power,","poem":1},{"lineBreak":true},{"text":"In the splendors of thy saints:","poem":1},{"lineBreak":true},{"text":"I have begotten thee from the womb before the morning.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The Lord swore, and will not repent,","poem":1},{"lineBreak":true},{"text":"Thou art a priest forever, after the order of Melchizedek.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The Lord at thy right hand has dashed in pieces kings in the day of his wrath.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He shall judge among the nations, he shall fill up the number of corpses,","poem":1},{"lineBreak":true},{"text":"He shall crush the heads of many on the earth.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He shall drink of the brook in the way;","poem":1},{"lineBreak":true},{"text":"Therefore shall he lift up the head.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":7}