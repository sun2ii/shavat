{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"For the end, a Psalm of David, upon the eighth.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Save me, O Lord; for the godly man has failed;","poem":1},{"lineBreak":true},{"text":"For truth is diminished from among the children of men.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Every one has spoken vanity to his neighbor:","poem":1},{"lineBreak":true},{"text":"Their lips are deceitful, they have spoken with a double heart.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Let the Lord destroy all the deceitful lips,","poem":1},{"lineBreak":true},{"text":"And the tongue that speaks great words:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Who have said, We will magnify our tongue;","poem":1},{"lineBreak":true},{"text":"Our lips are our own: who is Lord of us?","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Because of the misery of the poor,","poem":1},{"lineBreak":true},{"text":"And because of the sighing of the needy,","poem":1},{"lineBreak":true},{"text":"Now will I arise, saith the Lord,","poem":1},{"lineBreak":true},{"text":"I will set them in safety; I will speak to them thereof openly.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The oracles of the Lord are pure oracles;","poem":1},{"lineBreak":true},{"text":"As silver tried in the fire, proved in a furnace of earth,","poem":1},{"lineBreak":true},{"text":"Purified seven times.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Thou, O Lord, shalt keep us,","poem":1},{"lineBreak":true},{"text":"And shalt preserve us, from this generation, and forever.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The ungodly walk around:","poem":1},{"lineBreak":true},{"text":"According to thy greatness thou hast greatly exalted the sons of men.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":9}