{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":110,"content":[{"type":"verse","number":1,"content":[{"text":"Alleluia.","descriptive":true},{"text":"I will give thee thanks, O Lord, with my whole heart,","poem":1},{"lineBreak":true},{"text":"In the council of the upright, and in the congregation.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The works of the Lord are great,","poem":1},{"lineBreak":true},{"text":"Sought out according to all his will.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"His work is worthy of thanksgiving and honor:","poem":1},{"lineBreak":true},{"text":"And his righteousness endures forever and ever.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He has caused his wonderful works to be remembered:","poem":1},{"lineBreak":true},{"text":"The Lord is merciful and compassionate.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"He has given food to them that fear him:","poem":1},{"lineBreak":true},{"text":"He will remember his covenant forever.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He has declared to his people the power of his works,","poem":1},{"lineBreak":true},{"text":"To give them the inheritance of the heathen.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The works of his hands are truth and judgment:","poem":1},{"lineBreak":true},{"text":"All his commandments are sure:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Established forever and ever,","poem":1},{"lineBreak":true},{"text":"Done in truth and uprightness.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He sent redemption to his people:","poem":1},{"lineBreak":true},{"text":"He commanded his covenant forever:","poem":1},{"lineBreak":true},{"text":"Holy and fearful is his name.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"The fear of the Lord is the beginning of wisdom,","poem":1},{"lineBreak":true},{"text":"And all that act accordingly have a good understanding;","poem":1},{"lineBreak":true},{"text":"His praise endures forever and ever.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":10}