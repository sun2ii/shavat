{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"Alleluia.","descriptive":true},{"text":"Blessed is the man that fears the Lord:","poem":1},{"lineBreak":true},{"text":"He will delight greatly in his commandments.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"His seed shall be mighty in the earth:","poem":1},{"lineBreak":true},{"text":"The generation of the upright shall be blessed.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Glory and riches shall be in his house;","poem":1},{"lineBreak":true},{"text":"And his righteousness endures for evermore.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"To the upright light has sprung up in darkness:","poem":1},{"lineBreak":true},{"text":"He is pitiful, and merciful, and righteous.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The good man is he that pities and lends:","poem":1},{"lineBreak":true},{"text":"He will direct his affairs with judgment.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"For he shall not be moved forever;","poem":1},{"lineBreak":true},{"text":"The righteous shall be in everlasting remembrance.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He shall not be afraid of any evil report:","poem":1},{"lineBreak":true},{"text":"His heart is ready to trust in the Lord.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"His heart is established, he shall not fear,","poem":1},{"lineBreak":true},{"text":"Till he shall see his desire upon his enemies.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He has dispersed abroad; he has given to the poor;","poem":1},{"lineBreak":true},{"text":"His righteousness endures for evermore:","poem":1},{"lineBreak":true},{"text":"His horn shall be exalted with honor.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"The sinner shall see and be angry,","poem":1},{"lineBreak":true},{"text":"He shall gnash his teeth, and consume away:","poem":1},{"lineBreak":true},{"text":"The desire of the sinner shall perish.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}