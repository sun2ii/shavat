is as the Lord our God?","poem":1},{"lineBreak":true},{"text":"Who dwells in the high places,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"And yet looks upon the low things in heaven,","poem":1},{"lineBreak":true},{"text":"And on the earth:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Who lifts up the poor from the earth,","poem":1},{"lineBreak":true},{"text":"And raises up the needy from the dunghill;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"To set him with princes,","poem":1},{"lineBreak":true},{"text":"Even with the princes of his people:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Who settles the barren woman in a house,","poem":1},{"lineBreak":true},{"text":"As a mother rejoicing over children.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":9}