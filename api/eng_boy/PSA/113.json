{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Alleluia.","descriptive":true},{"text":"At the going forth of Israel from Egypt,","poem":1},{"lineBreak":true},{"text":"Of the house of Jacob from a barbarous people,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Judea became his sanctuary,","poem":1},{"lineBreak":true},{"text":"And Israel his dominion.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The sea saw and fled:","poem":1},{"lineBreak":true},{"text":"Jordan was turned back.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The mountains skipped like rams,","poem":1},{"lineBreak":true},{"text":"And the hills like lambs.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"What ailed thee, O sea, that thou fleddest?","poem":1},{"lineBreak":true},{"text":"And thou Jordan, that thou wast turned back?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ye mountains, that ye skipped like rams,","poem":1},{"lineBreak":true},{"text":"And ye hills, like lambs?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The earth trembled at the presence of the Lord,","poem":1},{"lineBreak":true},{"text":"At the presence of the God of Jacob;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Who turned the rock into pools of water,","poem":1},{"lineBreak":true},{"text":"And the flint into fountains of water.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Not to us, O Lord, not to us,","poem":1},{"lineBreak":true},{"text":"But to thy name give glory,","poem":1},{"lineBreak":true},{"text":"Because of thy mercy and thy truth;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lest at any time the nations should say,","poem":1},{"lineBreak":true},{"text":"Where is their God?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"But our God has done in heaven and on earth,","poem":1},{"lineBreak":true},{"text":"Whatsoever he has pleased.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"The idols of the nations are silver and gold,","poem":1},{"lineBreak":true},{"text":"The works of men’s hands.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"They have a mouth, but they cannot speak;","poem":1},{"lineBreak":true},{"text":"They have eyes, but they cannot see:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"They have ears, but they cannot hear;","poem":1},{"lineBreak":true},{"text":"They have noses, but they cannot smell;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"They have hands, but they cannot handle;","poem":1},{"lineBreak":true},{"text":"They have feet, but they cannot walk:","poem":1},{"lineBreak":true},{"text":"They cannot speak through their throat.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Let those that make them become like to them,","poem":1},{"lineBreak":true},{"text":"And all who trust in them.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"The house of Israel trusts in the Lord:","poem":1},{"lineBreak":true},{"text":"He is their helper and defender.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"The house of Aaron trusts in the Lord:","poem":1},{"lineBreak":true},{"text":"He is their helper and defender.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"They that fear the Lord trust in the Lord:","poem":1},{"lineBreak":true},{"text":"He is their helper and defender.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"The Lord has remembered us, and blessed us:","poem":1},{"lineBreak":true},{"text":"He has blessed the house of Israel,","poem":1},{"lineBreak":true},{"text":"He has blessed the house of Aaron.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"He has blessed them that fear the Lord,","poem":1},{"lineBreak":true},{"text":"Both small and great.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"The Lord add blessings","poem":1},{"lineBreak":true},{"text":"To you and to your children.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Blessed are ye of the Lord,","poem":1},{"lineBreak":true},{"text":"Who made the heaven and the earth.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"The heaven of heavens belongs to the Lord:","poem":1},{"lineBreak":true},{"text":"But he has given the earth to the sons of men.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"The dead shall not praise thee, O Lord,","poem":1},{"lineBreak":true},{"text":"Nor any that go down to Hades.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"But we, the living, will bless the Lord,","poem":1},{"lineBreak":true},{"text":"From henceforth and forever.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":26}