{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"Alleluia.","descriptive":true},{"text":"I am well pleased, because the Lord will hearken","poem":1},{"lineBreak":true},{"text":"To the voice of my supplication.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Because he has inclined his ear to me,","poem":1},{"lineBreak":true},{"text":"Therefore will I call upon him while I live.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The pangs of death compassed me;","poem":1},{"lineBreak":true},{"text":"The dangers of hell found me:","poem":1},{"lineBreak":true},{"text":"I found affliction and sorrow.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Then I called on the name of the Lord:","poem":1},{"lineBreak":true},{"text":"O Lord, deliver my soul.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"The Lord is merciful and righteous;","poem":1},{"lineBreak":true},{"text":"Yea, our God has pity.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The Lord preserves the simple:","poem":1},{"lineBreak":true},{"text":"I was brought low, and he delivered me.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Return to thy rest, O my soul;","poem":1},{"lineBreak":true},{"text":"For the Lord has dealt bountifully with thee.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For he has delivered my soul from death,","poem":1},{"lineBreak":true},{"text":"Mine eyes from tears,","poem":1},{"lineBreak":true},{"text":"And my feet from falling.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I shall be well-pleasing before the Lord in the land of the living.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":9}