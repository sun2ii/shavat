{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"Alleluia.","descriptive":true},{"text":"I believed, wherefore I have spoken:","poem":1},{"lineBreak":true},{"text":"But I was greatly afflicted.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"And I said in mine amazement,","poem":1},{"lineBreak":true},{"text":"Every man is a liar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"What shall I render to the Lord","poem":1},{"lineBreak":true},{"text":"For all the things wherein he has rewarded me?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I will take the cup of salvation,","poem":1},{"lineBreak":true},{"text":"And call upon the name of the Lord.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I will pay my vows to the Lord,","poem":1},{"lineBreak":true},{"text":"In the presence of all his people.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Precious in the sight of the Lord","poem":1},{"lineBreak":true},{"text":"Is the death of his saints.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"O Lord, I am thy servant;","poem":1},{"lineBreak":true},{"text":"I am thy servant, and the son of thy handmaid:","poem":1},{"lineBreak":true},{"text":"Thou hast burst my bonds asunder.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I will offer to thee the sacrifice of praise,","poem":1},{"lineBreak":true},{"text":"And will call upon the name of the Lord.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I will pay my vows unto the Lord,","poem":1},{"lineBreak":true},{"text":"In the presence of all his people,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"In the courts of the Lord’s house,","poem":1},{"lineBreak":true},{"text":"In the midst of thee, Jerusalem.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":10}