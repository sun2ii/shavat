{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":119,"content":[{"type":"verse","number":1,"content":[{"text":"A Song of Degrees.","descriptive":true},{"text":"In mine affliction I cried to the Lord,","poem":1},{"lineBreak":true},{"text":"And he hearkened to me.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Deliver my soul, O Lord, from unjust lips,","poem":1},{"lineBreak":true},{"text":"And from a deceitful tongue.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"What should be given to thee, and what should be added to thee,","poem":1},{"lineBreak":true},{"text":"For thy crafty tongue?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sharpened weapons of the mighty,","poem":1},{"lineBreak":true},{"text":"With coals of the desert.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Woe is me, that my sojourning is prolonged;","poem":1},{"lineBreak":true},{"text":"I have tabernacled among the tents of Kedar.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"My soul has long been a sojourner;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I was peaceable among them that hated peace;","poem":1},{"lineBreak":true},{"text":"When I spoke to them, they warred against me without a cause.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/120.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":7}