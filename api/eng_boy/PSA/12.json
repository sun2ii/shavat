{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"For the end, a Psalm of David.","descriptive":true},{"text":"How long, O Lord, wilt thou forget me? forever?","poem":1},{"lineBreak":true},{"text":"How long wilt thou turn away thy face from me?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"How long shall I take counsel in my soul,","poem":1},{"lineBreak":true},{"text":"Having sorrows in my heart daily?","poem":1},{"lineBreak":true},{"text":"How long shall my enemy be exalted over me?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Look on me, hearken to me, O Lord my God:","poem":1},{"lineBreak":true},{"text":"Lighten mine eyes, lest I sleep in death;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lest at any time mine enemy say, I have prevailed against him:","poem":1},{"lineBreak":true},{"text":"My persecutors will exult if ever I should be moved.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"But I have hoped in thy mercy;","poem":1},{"lineBreak":true},{"text":"My heart shall exult in thy salvation.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I will sing to the Lord who has dealt bountifully with me,","poem":1},{"lineBreak":true},{"text":"And I will sing psalms to the name of the Lord most high.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}