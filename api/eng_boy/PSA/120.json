{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":120,"content":[{"type":"verse","number":1,"content":[{"text":"A Song of Degrees.","descriptive":true},{"text":"I lifted up mine eyes to the mountains,","poem":1},{"lineBreak":true},{"text":"Whence my help shall come.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"My help shall come from the Lord,","poem":1},{"lineBreak":true},{"text":"Who made the heaven and the earth.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let not thy foot be moved;","poem":1},{"lineBreak":true},{"text":"And let not thy keeper slumber.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Behold, he that keeps Israel","poem":1},{"lineBreak":true},{"text":"Shall not slumber nor sleep.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The Lord shall keep thee:","poem":1},{"lineBreak":true},{"text":"The Lord is thy shelter upon thy right hand.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The sun shall not burn thee by day,","poem":1},{"lineBreak":true},{"text":"Neither the moon by night.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"May the Lord preserve thee from all evil:","poem":1},{"lineBreak":true},{"text":"The Lord shall keep thy soul.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The Lord shall keep thy coming in, and thy going out,","poem":1},{"lineBreak":true},{"text":"From henceforth and even forever.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":8}