{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":121,"content":[{"type":"verse","number":1,"content":[{"text":"A Song of Degrees.","descriptive":true},{"text":"I was glad when they said to me,","poem":1},{"lineBreak":true},{"text":"Let us go into the house of the Lord.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Our feet stood","poem":1},{"lineBreak":true},{"text":"In thy courts, O Jerusalem.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jerusalem is built as a city","poem":1},{"lineBreak":true},{"text":"Whose fellowship is complete.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For thither the tribes went up,","poem":1},{"lineBreak":true},{"text":"The tribes of the Lord, as a testimony for Israel,","poem":1},{"lineBreak":true},{"text":"To give thanks unto the name of the Lord.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For there are set thrones for judgment,","poem":1},{"lineBreak":true},{"text":"Even thrones for the house of David.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Pray now for the peace of Jerusalem:","poem":1},{"lineBreak":true},{"text":"And let there be prosperity to them that love thee.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Let peace, I pray, be within thy host,","poem":1},{"lineBreak":true},{"text":"And prosperity in thy palaces.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For the sake of my brethren and my neighbors,","poem":1},{"lineBreak":true},{"text":"I have indeed spoken peace concerning thee.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Because of the house of the Lord our God,","poem":1},{"lineBreak":true},{"text":"I have diligently sought thy good.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":9}