{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":122,"content":[{"type":"verse","number":1,"content":[{"text":"A Song of Degrees.","descriptive":true},{"text":"Unto thee who dwellest in heaven","poem":1},{"lineBreak":true},{"text":"Have I lifted up mine eyes.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Behold, as the eyes of servants are directed to the hands of their masters,","poem":1},{"lineBreak":true},{"text":"And as the eyes of a maidservant to the hands of her mistress;","poem":1},{"lineBreak":true},{"text":"So our eyes are directed to the Lord our God,","poem":1},{"lineBreak":true},{"text":"Until he have mercy upon us.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Have pity upon us, O Lord, have pity upon us:","poem":1},{"lineBreak":true},{"text":"For we are exceedingly filled with contempt.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yea, our soul has been exceedingly filled with it:","poem":1},{"lineBreak":true},{"text":"Let the reproach be to them that are at ease,","poem":1},{"lineBreak":true},{"text":"And contempt to the proud.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":4}