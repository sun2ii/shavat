{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":123,"content":[{"type":"verse","number":1,"content":[{"text":"A Song of Degrees.","descriptive":true},{"text":"If it had not been that the Lord was among us,","poem":1},{"lineBreak":true},{"text":"Let Israel now say;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"If it had not been that the Lord was among us,","poem":1},{"lineBreak":true},{"text":"When men rose up against us;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Verily they would have swallowed us up alive,","poem":1},{"lineBreak":true},{"text":"When their wrath was kindled against us:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Verily the water would have drowned us,","poem":1},{"lineBreak":true},{"text":"Our soul would have gone under the torrent.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yea, our soul would have gone under","poem":1},{"lineBreak":true},{"text":"The overwhelming water.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Blessed be the Lord, who has not given us","poem":1},{"lineBreak":true},{"text":"For a prey to their teeth.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Our soul has been delivered as a sparrow","poem":1},{"lineBreak":true},{"text":"From the snare of the fowlers:","poem":1},{"lineBreak":true},{"text":"The snare is broken, and we are delivered.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Our help is in the name of the Lord,","poem":1},{"lineBreak":true},{"text":"Who made heaven and earth.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":8}