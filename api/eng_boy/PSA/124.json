{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":124,"content":[{"type":"verse","number":1,"content":[{"text":"A Song of Degrees.","descriptive":true},{"text":"They that trust in the Lord shall be as Mount Zion:","poem":1},{"lineBreak":true},{"text":"He that dwells in Jerusalem shall never be moved.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The mountains are round about her,","poem":1},{"lineBreak":true},{"text":"And so the Lord is round about his people,","poem":1},{"lineBreak":true},{"text":"From henceforth and even forever.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For the Lord will not allow the rod of sinners","poem":1},{"lineBreak":true},{"text":"To be upon the lot of the righteous;","poem":1},{"lineBreak":true},{"text":"Lest the righteous should stretch forth","poem":1},{"lineBreak":true},{"text":"Their hands to iniquity.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Do good, O Lord, to them that are good,","poem":1},{"lineBreak":true},{"text":"And to them that are upright in heart.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"But them that turn aside to crooked ways","poem":1},{"lineBreak":true},{"text":"The Lord will lead away with the workers of iniquity:","poem":1},{"lineBreak":true},{"text":"But peace shall be upon Israel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":5}