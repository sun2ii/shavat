{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":125,"content":[{"type":"verse","number":1,"content":[{"text":"A Song of Degrees.","descriptive":true},{"text":"When the Lord turned the captivity of Zion,","poem":1},{"lineBreak":true},{"text":"We became as comforted ones.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Then was our mouth filled with joy,","poem":1},{"lineBreak":true},{"text":"And our tongue with exultation:","poem":1},{"lineBreak":true},{"text":"Then would they say among the Gentiles,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The Lord has done great things among them.","poem":1},{"lineBreak":true},{"text":"The Lord has done great things for us,","poem":1},{"lineBreak":true},{"text":"We became joyful.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Turn, O Lord, our captivity,","poem":1},{"lineBreak":true},{"text":"As the streams in the south.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"They that sow in tears","poem":1},{"lineBreak":true},{"text":"Shall reap in joy.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"They went on and wept","poem":1},{"lineBreak":true},{"text":"As they cast their seeds;","poem":1},{"lineBreak":true},{"text":"But they shall surely come with exultation,","poem":1},{"lineBreak":true},{"text":"Bringing their sheaves with them.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":6}