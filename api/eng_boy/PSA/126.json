{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":126,"content":[{"type":"verse","number":1,"content":[{"text":"A Song of Degrees.","descriptive":true},{"text":"Except the Lord build the house,","poem":1},{"lineBreak":true},{"text":"They that build labor in vain:","poem":1},{"lineBreak":true},{"text":"Except the Lord keep the city,","poem":1},{"lineBreak":true},{"text":"The watchman watches in vain.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"It is vain for you to rise early:","poem":1},{"lineBreak":true},{"text":"Ye rise up after resting,","poem":1},{"lineBreak":true},{"text":"Ye that eat the bread of grief;","poem":1},{"lineBreak":true},{"text":"While he gives sleep to his beloved.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Behold, the inheritance of the Lord, children,","poem":1},{"lineBreak":true},{"text":"The reward of the fruit of the womb.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"As arrows in the hand of a mighty man;","poem":1},{"lineBreak":true},{"text":"So are the children of those who were outcasts.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Blessed is the man who shall satisfy his desire with them:","poem":1},{"lineBreak":true},{"text":"They shall not be ashamed when they shall speak to their enemies in the gates.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":5}