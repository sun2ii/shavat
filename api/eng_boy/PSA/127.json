{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":127,"content":[{"type":"verse","number":1,"content":[{"text":"A Song of Degrees.","descriptive":true},{"text":"Blessed are all they that fear the Lord;","poem":1},{"lineBreak":true},{"text":"Who walk in his ways.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Thou shalt eat the labors of thy hands:","poem":1},{"lineBreak":true},{"text":"Blessed art thou, and it shall be well with thee.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Thy wife shall be as a fruitful vine","poem":1},{"lineBreak":true},{"text":"On the sides of thy house:","poem":1},{"lineBreak":true},{"text":"Thy children as young olive plants","poem":1},{"lineBreak":true},{"text":"Round about thy table.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Behold, thus shall the man be blessed that fears the Lord.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"May the Lord bless thee out of Zion;","poem":1},{"lineBreak":true},{"text":"And mayest thou see the prosperity of Jerusalem","poem":1},{"lineBreak":true},{"text":"All the days of thy life.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"And mayest thou see thy children’s children.","poem":1},{"lineBreak":true},{"text":"Peace be upon Israel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":6}