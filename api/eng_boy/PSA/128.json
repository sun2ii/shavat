{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":128,"content":[{"type":"verse","number":1,"content":[{"text":"A Song of Degrees.","descriptive":true},{"text":"Many a time have they warred against me from my youth,","poem":1},{"lineBreak":true},{"text":"Let Israel now say:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Many a time have they warred against me from my youth:","poem":1},{"lineBreak":true},{"text":"And yet they prevailed not against me.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The sinners wrought upon my back:","poem":1},{"lineBreak":true},{"text":"They prolonged their iniquity.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The righteous Lord has cut asunder the necks of sinners.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Let all that hate Zion","poem":1},{"lineBreak":true},{"text":"Be put to shame and turned back.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Let them be as the grass of the housetops,","poem":1},{"lineBreak":true},{"text":"Which withers before it is plucked up.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wherewith the reaper fills not his hand,","poem":1},{"lineBreak":true},{"text":"Nor he that makes up the sheaves, his bosom.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Neither do they that go by say, The blessing of the Lord be upon you:","poem":1},{"lineBreak":true},{"text":"We have blessed you in the name of the Lord.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":8}