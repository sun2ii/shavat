{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":129,"content":[{"type":"verse","number":1,"content":[{"text":"A Song of Degrees.","descriptive":true},{"text":"Out of the depths have I cried to thee, O Lord.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O Lord, hearken to my voice;","poem":1},{"lineBreak":true},{"text":"Let thine ears be attentive","poem":1},{"lineBreak":true},{"text":"To the voice of my supplication.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"If thou, O Lord, shouldest mark iniquities,","poem":1},{"lineBreak":true},{"text":"O Lord, who shall stand?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For with thee is forgiveness:","poem":1},{"lineBreak":true},{"text":"For thy name’s sake","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"have I waited for thee, O Lord,","poem":1},{"lineBreak":true},{"text":"My soul has waited for thy word.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"My soul has hoped in the Lord;","poem":1},{"lineBreak":true},{"text":"From the morning watch till night.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Let Israel hope in the Lord:","poem":1},{"lineBreak":true},{"text":"For with the Lord is mercy,","poem":1},{"lineBreak":true},{"text":"And with him is plenteous redemption.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"And he shall redeem Israel","poem":1},{"lineBreak":true},{"text":"From all his iniquities.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}