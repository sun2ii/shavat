{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":131,"content":[{"type":"verse","number":1,"content":[{"text":"A Song of Degrees.","descriptive":true},{"text":"Lord, remember David,","poem":1},{"lineBreak":true},{"text":"And all his meekness:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"How he swore to the Lord,","poem":1},{"lineBreak":true},{"text":"And vowed to the God of Jacob, saying,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I will not go into the tabernacle of my house;","poem":1},{"lineBreak":true},{"text":"I will not go up to the couch of my bed;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I will not give sleep to mine eyes,","poem":1},{"lineBreak":true},{"text":"Nor slumber to mine eyelids,","poem":1},{"lineBreak":true},{"text":"Nor rest to my temples,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Until I find a place for the Lord,","poem":1},{"lineBreak":true},{"text":"A tabernacle for the God of Jacob.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Behold, we heard of it in Ephrathah;","poem":1},{"lineBreak":true},{"text":"We found it in the fields of the wood.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Let us enter into his tabernacles:","poem":1},{"lineBreak":true},{"text":"Let us worship at the place where his feet stood.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Arise, O Lord, into thy rest;","poem":1},{"lineBreak":true},{"text":"Thou, and the ark of thy holiness.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Thy priests shall clothe themselves with righteousness;","poem":1},{"lineBreak":true},{"text":"And thy saints shall exult.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"For the sake of thy servant David","poem":1},{"lineBreak":true},{"text":"Turn not away the face of thine anointed.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"The Lord swore in truth to David, and he will not annul it, saying,","poem":1},{"lineBreak":true},{"text":"Of the fruit of thy body will I set a king upon thy throne.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"If thy children will keep my covenant,","poem":1},{"lineBreak":true},{"text":"And these my testimonies which I shall teach them,","poem":1},{"lineBreak":true},{"text":"Their children also shall sit upon thy throne forever.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"For the Lord has elected Zion,","poem":1},{"lineBreak":true},{"text":"He has chosen her for a habitation for himself, saying,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"This is my rest forever:","poem":1},{"lineBreak":true},{"text":"Here will I dwell; for I have chosen it.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"I will surely bless her provision:","poem":1},{"lineBreak":true},{"text":"I will satisfy her poor with bread.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"I will clothe her priests with salvation;","poem":1},{"lineBreak":true},{"text":"And her saints shall greatly exult.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"There will I cause to spring up a horn to David:","poem":1},{"lineBreak":true},{"text":"I have prepared a lamp for mine anointed.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"His enemies will I clothe with shame;","poem":1},{"lineBreak":true},{"text":"But upon himself shall my holiness flourish.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":18}