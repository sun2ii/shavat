{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":134,"content":[{"type":"verse","number":1,"content":[{"text":"Alleluia.","descriptive":true},{"text":"Praise ye the name of the Lord;","poem":1},{"lineBreak":true},{"text":"Praise the Lord, ye his servants,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Who stand in the house of the Lord,","poem":1},{"lineBreak":true},{"text":"In the courts of the house of our God.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Praise ye the Lord; for the Lord is good:","poem":1},{"lineBreak":true},{"text":"Sing praises to his name; for it is good.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"For the Lord has chosen Jacob for himself,","poem":1},{"lineBreak":true},{"text":"And Israel for his peculiar treasure.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For I know that the Lord is great,","poem":1},{"lineBreak":true},{"text":"And our Lord is above all gods;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"All that the Lord willed,","poem":1},{"lineBreak":true},{"text":"He did in heaven, and on the earth,","poem":1},{"lineBreak":true},{"text":"In the sea, and in all deeps.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Who brings up clouds from the extremity of the earth:","poem":1},{"lineBreak":true},{"text":"He has made lightnings for the rain:","poem":1},{"lineBreak":true},{"text":"He brings winds out of his treasures.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Who smote the firstborn of Egypt,","poem":1},{"lineBreak":true},{"text":"Both of man and beast.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He sent signs and wonders into the midst of thee, O Egypt,","poem":1},{"lineBreak":true},{"text":"On Pharaoh, and on all his servants.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Who smote many nations,","poem":1},{"lineBreak":true},{"text":"And slew mighty kings;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sihon king of the Amorites,","poem":1},{"lineBreak":true},{"text":"And Og king of Bashan,","poem":1},{"lineBreak":true},{"text":"And all the kingdoms of Canaan:","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"And gave their land for an inheritance,","poem":1},{"lineBreak":true},{"text":"An inheritance to Israel his people.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"O Lord, thy name endures forever,","poem":1},{"lineBreak":true},{"text":"And thy memorial to all generations.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"For the Lord shall judge his people,","poem":1},{"lineBreak":true},{"text":"And comfort himself concerning his servants.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"The idols of the heathen are silver and gold,","poem":1},{"lineBreak":true},{"text":"The works of men’s hands.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"They have a mouth, but they cannot speak;","poem":1},{"lineBreak":true},{"text":"They have eyes, but they cannot see;","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"They have ears, but they cannot hear;","poem":1},{"lineBreak":true},{"text":"For there is no breath in their mouth.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Let those who make them be made like to them;","poem":1},{"lineBreak":true},{"text":"And all those who trust in them.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"O house of Israel, bless ye the Lord:","poem":1},{"lineBreak":true},{"text":"O house of Aaron, bless ye the Lord:","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"O house of Levi, bless ye the Lord:","poem":1},{"lineBreak":true},{"text":"Ye that fear the Lord, bless the Lord.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Blessed in Zion be the Lord,","poem":1},{"lineBreak":true},{"text":"Who dwells in Jerusalem.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/134.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/135.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/133.json","previousChapterAudioLinks":{},"numberOfVerses":21}