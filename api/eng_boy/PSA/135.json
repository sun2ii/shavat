{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":135,"content":[{"type":"verse","number":1,"content":[{"text":"Alleluia.","descriptive":true},{"text":"Give thanks to the Lord: for he is good:","poem":1},{"lineBreak":true},{"text":"For his mercy endures forever.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Give thanks to the God of gods: for his mercy endures forever.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Give thanks to the Lord of lords:","poem":1},{"lineBreak":true},{"text":"For his mercy endures forever.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"To him who alone has wrought great wonders:","poem":1},{"lineBreak":true},{"text":"For his mercy endures forever.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"To him who made the heavens by understanding;","poem":1},{"lineBreak":true},{"text":"For his mercy endures forever.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"To him who established the earth on the waters;","poem":1},{"lineBreak":true},{"text":"For his mercy endures forever.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"To him who alone made great lights;","poem":1},{"lineBreak":true},{"text":"For his mercy endures forever.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The sun to rule the day;","poem":1},{"lineBreak":true},{"text":"For his mercy endures forever.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The moon and the stars to rule the night;","poem":1},{"lineBreak":true},{"text":"For his mercy endures forever.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"To him who smote Egypt with their firstborn;","poem":1},{"lineBreak":true},{"text":"For his mercy endures forever.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"And brought Israel out of the midst of them;","poem":1},{"lineBreak":true},{"text":"For his mercy endures forever:","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"With a strong hand, and a high arm:","poem":1},{"lineBreak":true},{"text":"For his mercy endures forever.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"To him who divided the Red Sea into parts:","poem":1},{"lineBreak":true},{"text":"For his mercy endures forever:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"And brought Israel through the midst of it:","poem":1},{"lineBreak":true},{"text":"For his mercy endures forever:","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"And overthrew Pharaoh and his host in the Red Sea:","poem":1},{"lineBreak":true},{"text":"For his mercy endures forever.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"To him who led his people through the wilderness:","poem":1},{"lineBreak":true},{"text":"For his mercy endures forever.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"To him who smote great kings:","poem":1},{"lineBreak":true},{"text":"For his mercy endures forever:","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"And slew mighty kings;","poem":1},{"lineBreak":true},{"text":"For his mercy endures forever:","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Sihon king of the Amorites:","poem":1},{"lineBreak":true},{"text":"For his mercy endures forever:","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"And Og king of Bashan:","poem":1},{"lineBreak":true},{"text":"For his mercy endures forever:","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"And gave their land for an inheritance:","poem":1},{"lineBreak":true},{"text":"For his mercy endures forever:","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Even an inheritance to Israel his servant:","poem":1},{"lineBreak":true},{"text":"For his mercy endures forever.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"For the Lord remembered us in our low estate;","poem":1},{"lineBreak":true},{"text":"For his mercy endures forever:","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"And redeemed us from our enemies;","poem":1},{"lineBreak":true},{"text":"For his mercy endures forever.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Who gives food to all flesh;","poem":1},{"lineBreak":true},{"text":"For his mercy endures forever.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Give thanks to the God of heaven;","poem":1},{"lineBreak":true},{"text":"For his mercy endures forever.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":26}