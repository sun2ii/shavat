{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":136,"content":[{"type":"verse","number":1,"content":[{"text":"For David, a Psalm of Jeremiah.","descriptive":true},{"text":"By the rivers of Babylon, there we sat;","poem":1},{"lineBreak":true},{"text":"And wept when we remembered Zion.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"We hung our harps on the willows in the midst of it.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For there they that had taken us captive asked of us the words of a song;","poem":1},{"lineBreak":true},{"text":"And they that had carried us away asked a hymn, saying,","poem":1},{"lineBreak":true},{"text":"Sing us one of the songs of Zion.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"How should we sing the Lord’s song in a strange land?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"If I forget thee, O Jerusalem, let my right hand forget its skill.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"May my tongue cleave to my throat, if I do not remember thee;","poem":1},{"lineBreak":true},{"text":"If I do not prefer Jerusalem as the chief of my joy.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Remember, O Lord, the children of Edom in the day of Jerusalem;","poem":1},{"lineBreak":true},{"text":"Who said, Raze it, raze it, even to its foundations.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wretched daughter of Babylon!","poem":1},{"lineBreak":true},{"text":"Blessed shall he be who shall reward thee as thou hast rewarded us.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Blessed shall he be who shall seize and dash thine infants against the rock.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":9}