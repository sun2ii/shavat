{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"A Psalm for David, of Haggai and Zechariah.","descriptive":true},{"text":"I will give thee thanks, O Lord, with my whole heart;","poem":1},{"lineBreak":true},{"text":"And I will sing psalms to thee before the angels;","poem":1},{"lineBreak":true},{"text":"For thou hast heard all the words of my mouth.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I will worship toward thy holy temple,","poem":1},{"lineBreak":true},{"text":"And give thanks to thy name,","poem":1},{"lineBreak":true},{"text":"On account of thy mercy and thy truth;","poem":1},{"lineBreak":true},{"text":"For thou hast magnified thy holy name above everything.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"In whatsoever day I shall call upon thee, hear me speedily;","poem":1},{"lineBreak":true},{"text":"Thou shalt abundantly provide me with thy power in my soul.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Let all the kings of the earth, O Lord, give thanks unto thee;","poem":1},{"lineBreak":true},{"text":"For they have heard all the words of thy mouth.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"And let them sing in the ways of the Lord;","poem":1},{"lineBreak":true},{"text":"For great is the glory of the Lord.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"For the Lord is high, and yet regards the lowly;","poem":1},{"lineBreak":true},{"text":"And he knows high things from afar off.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Though I should walk in the midst of affliction, thou wilt quicken me;","poem":1},{"lineBreak":true},{"text":"Thou hast stretched forth thy hands against the wrath of mine enemies,","poem":1},{"lineBreak":true},{"text":"And thy right hand has saved me.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O Lord, thou shalt recompense them on my behalf:","poem":1},{"lineBreak":true},{"text":"Thy mercy, O Lord, endures forever:","poem":1},{"lineBreak":true},{"text":"Overlook not the works of thy hands.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":8}