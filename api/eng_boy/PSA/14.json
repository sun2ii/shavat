{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"A Psalm of David.","descriptive":true},{"text":"O Lord, who shall sojourn in thy tabernacle?","poem":1},{"lineBreak":true},{"text":"And who shall dwell in thy holy mountain?","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"He that walks blameless, and works righteousness,","poem":1},{"lineBreak":true},{"text":"Who speaks truth in his heart.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Who has not spoken craftily with his tongue,","poem":1},{"lineBreak":true},{"text":"Neither has done evil to his neighbor,","poem":1},{"lineBreak":true},{"text":"Nor taken up a reproach against them that dwelt nearest to him.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"In his sight an evil-worker is set at nought,","poem":1},{"lineBreak":true},{"text":"But he honors them that fear the Lord.","poem":1},{"lineBreak":true},{"text":"He swears to his neighbor, and disappoints him not.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"He has not lent his money on usury,","poem":1},{"lineBreak":true},{"text":"And has not received bribes against the innocent.","poem":1},{"lineBreak":true},{"text":"He that does these things shall never be moved.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":5}