{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":140,"content":[{"type":"verse","number":1,"content":[{"text":"A Psalm of David.","descriptive":true},{"text":"O Lord, I have cried to thee; hear me:","poem":1},{"lineBreak":true},{"text":"Attend to the voice of my supplication, when I cry to thee.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Let my prayer be set forth before thee as incense;","poem":1},{"lineBreak":true},{"text":"The lifting up of my hands as an evening sacrifice.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Set a watch, O Lord, on my mouth,","poem":1},{"lineBreak":true},{"text":"And a strong door about my lips.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Incline not my heart to evil things,","poem":1},{"lineBreak":true},{"text":"To employ pretexts for sins,","poem":1},{"lineBreak":true},{"text":"With men who work iniquity:","poem":1},{"lineBreak":true},{"text":"And let me not unite with their choice ones.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The righteous shall chasten me with mercy, and reprove me:","poem":1},{"lineBreak":true},{"text":"But let not the oil of the sinner anoint my head:","poem":1},{"lineBreak":true},{"text":"For yet shall my prayer also be in their pleasures.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Their mighty ones have been swallowed up near the rock:","poem":1},{"lineBreak":true},{"text":"They shall hear my words, for they are sweet.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"As a lump of earth is crushed upon the ground,","poem":1},{"lineBreak":true},{"text":"Our bones have been scattered by the mouth of the grave.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For mine eyes are to thee, O Lord God:","poem":1},{"lineBreak":true},{"text":"I have hoped in thee; take not away my life.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Keep me from the snare which they have set for me,","poem":1},{"lineBreak":true},{"text":"And from the stumbling blocks of them that work iniquity.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sinners shall fall by their own net:","poem":1},{"lineBreak":true},{"text":"I am alone until I shall escape.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":10}