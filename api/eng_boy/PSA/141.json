{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":141,"content":[{"type":"verse","number":1,"content":[{"text":"A Psalm of instruction for David, when he was in the cave—a Prayer.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"I cried to the Lord with my voice;","poem":1},{"lineBreak":true},{"text":"With my voice I made supplication to the Lord.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I will pour out before him my supplication:","poem":1},{"lineBreak":true},{"text":"I will declare before him mine affliction.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"When my spirit was fainting within me,","poem":1},{"lineBreak":true},{"text":"Then thou knewest my paths;","poem":1},{"lineBreak":true},{"text":"In the very way wherein I was walking, they hid a snare for me.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I looked on my right hand, and behold,","poem":1},{"lineBreak":true},{"text":"For there was none that noticed me;","poem":1},{"lineBreak":true},{"text":"Refuge failed me;","poem":1},{"lineBreak":true},{"text":"And there was none that cared for my soul.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I cried unto thee, O Lord,","poem":1},{"lineBreak":true},{"text":"And said, Thou art my hope,","poem":1},{"lineBreak":true},{"text":"My portion in the land of the living.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Attend to my supplication,","poem":1},{"lineBreak":true},{"text":"For I am brought very low;","poem":1},{"lineBreak":true},{"text":"Deliver me from them that persecute me;","poem":1},{"lineBreak":true},{"text":"For they are stronger than I.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bring my soul out of prison,","poem":1},{"lineBreak":true},{"text":"That I may give thanks to thy name, O Lord;","poem":1},{"lineBreak":true},{"text":"The righteous shall wait for me, until thou recompense me.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":8}