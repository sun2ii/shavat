{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":145,"content":[{"type":"verse","number":1,"content":[{"text":"Alleluia, a Psalm of Haggai and Zechariah.","descriptive":true},{"text":"My soul, praise the Lord.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"While I live will I praise the Lord:","poem":1},{"lineBreak":true},{"text":"I will sing praises to my God as long as I exist.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Trust not in princes,","poem":1},{"lineBreak":true},{"text":"Nor in the children of men, in whom there is no safety.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"His breath shall go forth, and he shall return to his earth;","poem":1},{"lineBreak":true},{"text":"In that day all his thoughts shall perish.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Blessed is he whose helper is the God of Jacob,","poem":1},{"lineBreak":true},{"text":"Whose hope is in the Lord his God:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Who made heaven, and earth,","poem":1},{"lineBreak":true},{"text":"The sea, and all things in them:","poem":1},{"lineBreak":true},{"text":"Who keeps truth forever:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Who executes judgment for the wronged:","poem":1},{"lineBreak":true},{"text":"Who gives food to the hungry.","poem":1},{"lineBreak":true},{"text":"The Lord looses the fettered ones:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The Lord gives wisdom to the blind:","poem":1},{"lineBreak":true},{"text":"The Lord sets up the broken down:","poem":1},{"lineBreak":true},{"text":"The Lord loves the righteous:","poem":1},{"lineBreak":true},{"text":"The Lord preserves the strangers;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He will relieve the orphan and widow:","poem":1},{"lineBreak":true},{"text":"But will utterly remove the way of sinners.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"The Lord shall reign forever,","poem":1},{"lineBreak":true},{"text":"Even thy God, O Zion, to all generations.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":10}