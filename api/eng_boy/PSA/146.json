{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"Alleluia, a Psalm of Haggai and Zechariah.","descriptive":true},{"text":"Praise ye the Lord: for psalmody is a good thing;","poem":1},{"lineBreak":true},{"text":"Let praise be sweetly sung to our God.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The Lord builds up Jerusalem;","poem":1},{"lineBreak":true},{"text":"And he will gather together the dispersed of Israel.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He heals the broken in heart,","poem":1},{"lineBreak":true},{"text":"And binds up their wounds.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He numbers the multitudes of stars;","poem":1},{"lineBreak":true},{"text":"And calls them all by names.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Great is our Lord, and great is his strength;","poem":1},{"lineBreak":true},{"text":"And his understanding is infinite.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The Lord lifts up the meek;","poem":1},{"lineBreak":true},{"text":"But brings sinners down to the ground.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Begin the song with thanksgiving to the Lord;","poem":1},{"lineBreak":true},{"text":"Sing praises on the harp to our God:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Who covers the heaven with clouds,","poem":1},{"lineBreak":true},{"text":"Who prepares rain for the earth,","poem":1},{"lineBreak":true},{"text":"Who causes grass to spring up on the mountains,","poem":1},{"lineBreak":true},{"text":"And green herb for the service of men;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"And gives to cattle their food,","poem":1},{"lineBreak":true},{"text":"And to the young ravens that call upon him.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"He will not take pleasure in the strength of a horse;","poem":1},{"lineBreak":true},{"text":"Neither is he well pleased with the legs of a man.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"The Lord takes pleasure in them that fear him,","poem":1},{"lineBreak":true},{"text":"And in all that hope in his mercy.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":11}