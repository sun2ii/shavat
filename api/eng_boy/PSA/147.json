{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":147,"content":[{"type":"verse","number":1,"content":[{"text":"Alleluia, a Psalm of Haggai and Zechariah.","descriptive":true},{"text":"Praise the Lord, O Jerusalem;","poem":1},{"lineBreak":true},{"text":"Praise thy God, O Zion.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For he has strengthened the bars of thy gates;","poem":1},{"lineBreak":true},{"text":"He has blessed thy children within thee.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He makes thy borders peaceful,","poem":1},{"lineBreak":true},{"text":"And fills thee with the flour of wheat.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He sends his oracle to the earth:","poem":1},{"lineBreak":true},{"text":"His word will run swiftly.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"He gives snow like wool:","poem":1},{"lineBreak":true},{"text":"He scatters the mist like ashes.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Casting forth his ice like morsels:","poem":1},{"lineBreak":true},{"text":"Who shall stand before his cold?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He shall send out his word, and melt them:","poem":1},{"lineBreak":true},{"text":"He shall blow with his wind, and the waters shall flow.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"He sends his word to Jacob,","poem":1},{"lineBreak":true},{"text":"His ordinances and judgments to Israel.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He has not done so to any other nation;","poem":1},{"lineBreak":true},{"text":"And he has not shown them his judgments.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":9}