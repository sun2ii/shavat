{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"Alleluia, a Psalm of Haggai and Zechariah.","descriptive":true},{"text":"Praise ye the Lord from the heavens:","poem":1},{"lineBreak":true},{"text":"Praise him in the highest.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Praise ye him, all his angels:","poem":1},{"lineBreak":true},{"text":"Praise ye him, all his hosts.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Praise him, sun and moon:","poem":1},{"lineBreak":true},{"text":"Praise him, all ye stars and light.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Praise him, ye heavens of heavens,","poem":1},{"lineBreak":true},{"text":"And the water that is above the heavens.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Let them praise the name of the Lord:","poem":1},{"lineBreak":true},{"text":"For he spoke, and they were made;","poem":1},{"lineBreak":true},{"text":"He commanded, and they were created.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He has established them forever, even forever and ever:","poem":1},{"lineBreak":true},{"text":"He has made an ordinance, and it shall not pass away.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Praise the Lord from the earth,","poem":1},{"lineBreak":true},{"text":"Ye serpents, and all deeps.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fire, hail, snow, ice, stormy wind;","poem":1},{"lineBreak":true},{"text":"The things that perform his word.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mountains, and all hills;","poem":1},{"lineBreak":true},{"text":"Fruitful trees, and all cedars:","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wild beasts, and all cattle;","poem":1},{"lineBreak":true},{"text":"Reptiles, and winged birds:","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kings of the earth, and all peoples;","poem":1},{"lineBreak":true},{"text":"Princes, and all judges of the earth:","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Young men and virgins,","poem":1},{"lineBreak":true},{"text":"Old men with youths:","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Let them praise the name of the Lord:","poem":1},{"lineBreak":true},{"text":"For his name only is exalted;","poem":1},{"lineBreak":true},{"text":"His praise is above the earth and heaven,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"And he shall exalt the horn of his people,","poem":1},{"lineBreak":true},{"text":"There is a hymn for all his saints,","poem":1},{"lineBreak":true},{"text":"Even of the children of Israel, a people who draw near to him.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}