{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"Alleluia.","descriptive":true},{"text":"Sing to the Lord a new song:","poem":1},{"lineBreak":true},{"text":"His praise is in the assembly of the saints.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Let Israel rejoice in him that made him;","poem":1},{"lineBreak":true},{"text":"And let the children of Zion exult in their king.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let them praise his name in the dance:","poem":1},{"lineBreak":true},{"text":"Let them sing praises to him with timbrel and psaltery.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For the Lord takes pleasure in his people;","poem":1},{"lineBreak":true},{"text":"And will exalt the meek with salvation.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"The saints shall rejoice in glory;","poem":1},{"lineBreak":true},{"text":"And shall exult on their beds.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The high praises of God shall be in their throat,","poem":1},{"lineBreak":true},{"text":"And two-edged swords in their hands;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"To execute vengeance on the nations,","poem":1},{"lineBreak":true},{"text":"And punishments among the peoples;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"To bind their kings with fetters,","poem":1},{"lineBreak":true},{"text":"And their nobles with manacles of iron;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"To execute on them the judgment written:","poem":1},{"lineBreak":true},{"text":"This honor have all his saints.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}