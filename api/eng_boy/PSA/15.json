{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"A writing of David.","descriptive":true},{"text":"Keep me, O Lord;","poem":1},{"lineBreak":true},{"text":"For I have hoped in thee.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I said to the Lord, Thou art my Lord;","poem":1},{"lineBreak":true},{"text":"For thou hast no need of my goodness.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"On behalf of the saints that are in his land,","poem":1},{"lineBreak":true},{"text":"He has magnified all his pleasure in them.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Their weaknesses have been multiplied;","poem":1},{"lineBreak":true},{"text":"Afterward they hastened.","poem":1},{"lineBreak":true},{"text":"I will by no means assemble their bloody meetings,","poem":1},{"lineBreak":true},{"text":"Neither will I make mention of their names with my lips.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The Lord is the portion of mine inheritance and of my cup:","poem":1},{"lineBreak":true},{"text":"Thou art he that restores my inheritance to me.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The lines have fallen to me in the best places,","poem":1},{"lineBreak":true},{"text":"Yea, I have a most excellent heritage.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"I will bless the Lord who has instructed me;","poem":1},{"lineBreak":true},{"text":"My reins too have chastened me even till night.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I foresaw the Lord always before my face;","poem":1},{"lineBreak":true},{"text":"For he is on my right hand, that I should not be moved.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Therefore my heart rejoiced","poem":1},{"lineBreak":true},{"text":"And my tongue exulted;","poem":1},{"lineBreak":true},{"text":"Moreover also my flesh shall rest in hope:","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Because thou wilt not leave my soul in hell,","poem":1},{"lineBreak":true},{"text":"Neither wilt thou suffer thine Holy One to see corruption.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Thou hast made known to me the ways of life;","poem":1},{"lineBreak":true},{"text":"Thou wilt fill me with joy with thy countenance:","poem":1},{"lineBreak":true},{"text":"At thy right hand there are delights forever.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":11}