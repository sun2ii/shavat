{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":151,"content":[{"type":"verse","number":1,"content":[{"text":"This Psalm is a genuine one of David, though supernumerary, composed when he fought in single combat with Goliath.","descriptive":true},{"text":"I was small among my brethren,","poem":1},{"lineBreak":true},{"text":"And youngest in my father’s house:","poem":1},{"lineBreak":true},{"text":"I tended my father’s sheep.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"My hands formed a musical instrument,","poem":1},{"lineBreak":true},{"text":"And my fingers tuned a psaltery.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"And who shall tell my Lord?","poem":1},{"lineBreak":true},{"text":"The Lord himself, he himself hears.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He sent forth his angel,","poem":1},{"lineBreak":true},{"text":"And took me from my father’s sheep,","poem":1},{"lineBreak":true},{"text":"And he anointed me with the oil of his anointing.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"My brothers were handsome and tall;","poem":1},{"lineBreak":true},{"text":"But the Lord did not take pleasure in them.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I went forth to meet the Philistine;","poem":1},{"lineBreak":true},{"text":"And he cursed me by his idols.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"But I drew his own sword, and beheaded him,","poem":1},{"lineBreak":true},{"text":"And removed reproach from the children of Israel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/151.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":7}