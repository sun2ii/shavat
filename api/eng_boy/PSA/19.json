{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"For the end, a Psalm of David.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"The Lord hear thee in the day of trouble;","poem":1},{"lineBreak":true},{"text":"The name of the God of Jacob defend thee.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Send thee help from the sanctuary,","poem":1},{"lineBreak":true},{"text":"And aid thee out of Zion.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Remember all thy sacrifice,","poem":1},{"lineBreak":true},{"text":"And enrich thy whole burnt offering. Pause.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Grant thee according to thy heart,","poem":1},{"lineBreak":true},{"text":"And fulfill all thy desire.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"We will exult in thy salvation,","poem":1},{"lineBreak":true},{"text":"And in the name of our God shall we be magnified:","poem":1},{"lineBreak":true},{"text":"The Lord fulfill all thy petitions.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Now I know that the Lord has saved his Christ:","poem":1},{"lineBreak":true},{"text":"He shall hear him from his holy heaven:","poem":1},{"lineBreak":true},{"text":"The salvation of his right hand is mighty.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Some glory in chariots, and some in horses:","poem":1},{"lineBreak":true},{"text":"But we will glory in the name of the Lord our God.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"They are overthrown and fallen:","poem":1},{"lineBreak":true},{"text":"But we are risen, and have been set upright.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"O Lord, save the king:","poem":1},{"lineBreak":true},{"text":"And hear us in whatever day we call upon thee.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":10}