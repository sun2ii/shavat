{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Wherefore did the heathen rage,","poem":1},{"lineBreak":true},{"text":"And the nations imagine vain things?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The kings of the earth stood up,","poem":1},{"lineBreak":true},{"text":"And the rulers gathered themselves together,","poem":1},{"lineBreak":true},{"text":"Against the Lord, and against his Christ;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Saying, Let us break through their bonds,","poem":1},{"lineBreak":true},{"text":"And cast away their yoke from us.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"He that dwells in the heavens shall laugh them to scorn,","poem":1},{"lineBreak":true},{"text":"And the Lord shall mock them.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Then shall he speak to them in his anger,","poem":1},{"lineBreak":true},{"text":"And trouble them in his fury.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"But I have been made king by him","poem":1},{"lineBreak":true},{"text":"On Zion his holy mountain,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Declaring the ordinance of the Lord:","poem":1},{"lineBreak":true},{"text":"The Lord said to me, Thou art my Son, today have I begotten thee.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ask of me, and I will give thee the heathen for thine inheritance,","poem":1},{"lineBreak":true},{"text":"And the ends of the earth for thy possession.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Thou shalt rule them with a rod of iron;","poem":1},{"lineBreak":true},{"text":"Thou shalt dash them in pieces as a potter’s vessel.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Now therefore understand, ye kings:","poem":1},{"lineBreak":true},{"text":"Be instructed, all ye that judge the earth.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Serve the Lord with fear,","poem":1},{"lineBreak":true},{"text":"And rejoice in him with trembling.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Accept correction, lest at any time the Lord be angry,","poem":1},{"lineBreak":true},{"text":"And ye should perish from the righteous way:","poem":1},{"lineBreak":true},{"text":"Whensoever his wrath shall be suddenly kindled,","poem":1},{"lineBreak":true},{"text":"Blessed are all they that trust in him.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}