{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":[{"text":"A Psalm of David.","descriptive":true},{"text":"The Lord tends me as a shepherd,","poem":1},{"lineBreak":true},{"text":"And I shall want nothing.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"In a place of green grass, there he has made me dwell:","poem":1},{"lineBreak":true},{"text":"He has nourished me by the water of rest.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He has restored my soul:","poem":1},{"lineBreak":true},{"text":"He has guided me into the paths of righteousness,","poem":1},{"lineBreak":true},{"text":"For his name’s sake.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yea, even if I should walk in the midst of the shadow of death,","poem":1},{"lineBreak":true},{"text":"I will not be afraid of evils: for thou art with me;","poem":1},{"lineBreak":true},{"text":"Thy rod and thy staff, these have comforted me.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Thou hast prepared a table before me in presence of them that afflict me:","poem":1},{"lineBreak":true},{"text":"Thou hast thoroughly anointed my head with oil;","poem":1},{"lineBreak":true},{"text":"And thy cup cheers me like the best wine.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Thy mercy also shall follow me all the days of my life:","poem":1},{"lineBreak":true},{"text":"And my dwelling shall be in the house of the Lord for a very long time.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":6}