{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"A Psalm for David on the first day of the week.","descriptive":true},{"text":"The earth is the Lord’s and the fullness thereof;","poem":1},{"lineBreak":true},{"text":"The world, and all that dwell in it.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"He has founded it upon the seas,","poem":1},{"lineBreak":true},{"text":"And prepared it upon the rivers.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Who shall go up to the mountain of the Lord,","poem":1},{"lineBreak":true},{"text":"And who shall stand in his holy place?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He that is innocent in his hands and pure in his heart;","poem":1},{"lineBreak":true},{"text":"Who has not lifted up his soul to vanity,","poem":1},{"lineBreak":true},{"text":"Nor sworn deceitfully to his neighbor.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"He shall receive a blessing from the Lord,","poem":1},{"lineBreak":true},{"text":"And mercy from God his Savior.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"This is the generation of them that seek him,","poem":1},{"lineBreak":true},{"text":"That seek the face of the God of Jacob. Pause.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lift up your gates, ye princes,","poem":1},{"lineBreak":true},{"text":"And be ye lifted up, ye everlasting doors;","poem":1},{"lineBreak":true},{"text":"And the king of glory shall come in.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Who is this king of glory?","poem":1},{"lineBreak":true},{"text":"The Lord strong and mighty,","poem":1},{"lineBreak":true},{"text":"The Lord mighty in battle.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lift up your gates, ye princes;","poem":1},{"lineBreak":true},{"text":"And be ye lift up, ye everlasting doors;","poem":1},{"lineBreak":true},{"text":"And the king of glory shall come in.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Who is this king of glory?","poem":1},{"lineBreak":true},{"text":"The Lord of hosts, he is this king of glory.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":10}