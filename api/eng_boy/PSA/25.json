{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":[{"text":"A Psalm of David.","descriptive":true},{"text":"Judge me, O Lord; for I have walked in my innocence:","poem":1},{"lineBreak":true},{"text":"And hoping in the Lord I shall not be moved.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Prove me, O Lord, and try me;","poem":1},{"lineBreak":true},{"text":"Purify as with fire my reins and my heart.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"For thy mercy is before mine eyes:","poem":1},{"lineBreak":true},{"text":"And I am well pleased with thy truth.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I have not sat with the council of vanity,","poem":1},{"lineBreak":true},{"text":"And will in nowise enter in with transgressors.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I have hated the assembly of wicked doers;","poem":1},{"lineBreak":true},{"text":"And will not sit with ungodly men.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I will wash my hands in innocency,","poem":1},{"lineBreak":true},{"text":"And compass thine altar, O Lord:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"To hear the voice of praise,","poem":1},{"lineBreak":true},{"text":"And to declare all thy wonderful works.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O Lord, I have loved the beauty of thy house,","poem":1},{"lineBreak":true},{"text":"And the place of the tabernacle of thy glory.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Destroy not my soul together with the ungodly,","poem":1},{"lineBreak":true},{"text":"Nor my life with bloody men:","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"In whose hands are iniquities,","poem":1},{"lineBreak":true},{"text":"And their right hand is filled with bribes.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"But I have walked in my innocence:","poem":1},{"lineBreak":true},{"text":"Redeem me, and have mercy upon me.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"My foot stands in an even place:","poem":1},{"lineBreak":true},{"text":"In the congregations will I bless thee, O Lord.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":12}