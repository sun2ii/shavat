{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"A Psalm of David.","descriptive":true},{"text":"To thee, O Lord, have I cried;","poem":1},{"lineBreak":true},{"text":"My God, be not silent toward me:","poem":1},{"lineBreak":true},{"text":"Lest thou be silent toward me,","poem":1},{"lineBreak":true},{"text":"And so I should be likened to them that go down to the pit.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hearken to the voice of my supplication, when I pray to thee,","poem":1},{"lineBreak":true},{"text":"When I lift up my hands toward thy holy temple.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Draw not away my soul with sinners,","poem":1},{"lineBreak":true},{"text":"And destroy me not with the workers of iniquity,","poem":1},{"lineBreak":true},{"text":"Who speak peace with their neighbors,","poem":1},{"lineBreak":true},{"text":"But evils are in their hearts.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Give them according to their works,","poem":1},{"lineBreak":true},{"text":"And according to the wickedness of their devices:","poem":1},{"lineBreak":true},{"text":"Give them according to the works of their hands;","poem":1},{"lineBreak":true},{"text":"Render their recompense unto them.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Because they have not attended to the works of the Lord,","poem":1},{"lineBreak":true},{"text":"Even to the works of his hands,","poem":1},{"lineBreak":true},{"text":"Thou shalt pull them down, and shalt not build them up.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Blessed be the Lord, for he has hearkened to the voice of my petition.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The Lord is my helper and my defender;","poem":1},{"lineBreak":true},{"text":"My heart has hoped in him, and I am helped:","poem":1},{"lineBreak":true},{"text":"My flesh has revived,","poem":1},{"lineBreak":true},{"text":"And willingly will I give praise to him.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The Lord is the strength of his people,","poem":1},{"lineBreak":true},{"text":"And the saving defender of his anointed.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Save thy people, and bless thine inheritance:","poem":1},{"lineBreak":true},{"text":"And take care of them, and lift them up forever.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":9}