{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"A Psalm of David on the occasion of the solemn assembly of the Tabernacle.","descriptive":true},{"text":"Bring to the Lord, ye sons of God,","poem":1},{"lineBreak":true},{"text":"Bring to the Lord young rams;","poem":1},{"lineBreak":true},{"text":"Bring to the Lord glory and honor.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bring to the Lord glory, due to his name;","poem":1},{"lineBreak":true},{"text":"Worship the Lord in his holy court.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"The voice of the Lord is upon the waters:","poem":1},{"lineBreak":true},{"text":"The God of glory has thundered:","poem":1},{"lineBreak":true},{"text":"The Lord is upon many waters.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The voice of the Lord is mighty;","poem":1},{"lineBreak":true},{"text":"The voice of the Lord is full of majesty.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"There is the voice of the Lord who breaks the cedars;","poem":1},{"lineBreak":true},{"text":"The Lord will break the cedars of Lebanon.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"And he will beat them small, even Lebanon itself, like a calf;","poem":1},{"lineBreak":true},{"text":"And the beloved one is as a young unicorn.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"There is a voice of the Lord who divides a flame of fire.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A voice of the Lord who shakes the wilderness;","poem":1},{"lineBreak":true},{"text":"The Lord will shake the wilderness of Kadesh.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The voice of the Lord strengthens the hinds,","poem":1},{"lineBreak":true},{"text":"And will uncover the thickets:","poem":1},{"lineBreak":true},{"text":"And in his temple everyone speaks of his glory.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"The Lord will dwell on the waterflood:","poem":1},{"lineBreak":true},{"text":"And the Lord will sit a king forever.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"The Lord will give strength to his people;","poem":1},{"lineBreak":true},{"text":"The Lord will bless his people with peace.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":11}