{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"text":"For the end, a Psalm and Song at the dedication of the house of David.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"I will exalt thee, O Lord; for thou hast lifted me up,","poem":1},{"lineBreak":true},{"text":"And not caused mine enemies to rejoice over me.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"O Lord my God, I cried to thee, and thou didst heal me.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"O Lord, thou hast brought up my soul from Hades,","poem":1},{"lineBreak":true},{"text":"Thou hast delivered me from among them that go down to the pit.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sing to the Lord, ye his saints,","poem":1},{"lineBreak":true},{"text":"And give thanks for the remembrance of his holiness.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"For anger is in his wrath,","poem":1},{"lineBreak":true},{"text":"But life in his favor:","poem":1},{"lineBreak":true},{"text":"Weeping shall tarry for the evening,","poem":1},{"lineBreak":true},{"text":"But joy shall be in the morning.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"And I said in my prosperity,","poem":1},{"lineBreak":true},{"text":"I shall never be moved.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O Lord, in thy good pleasure thou didst add strength to my beauty:","poem":1},{"lineBreak":true},{"text":"But thou didst turn away thy face, and I was troubled.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"To thee, O Lord, will I cry;","poem":1},{"lineBreak":true},{"text":"And to my God will I make supplication.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"What profit is there in my blood,","poem":1},{"lineBreak":true},{"text":"When I go down to destruction?","poem":1},{"lineBreak":true},{"text":"Shall the dust give praise to thee?","poem":1},{"lineBreak":true},{"text":"Or shall it declare thy truth?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"The Lord heard, and had compassion upon me;","poem":1},{"lineBreak":true},{"text":"The Lord is become my helper.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Thou hast turned my mourning into joy for me:","poem":1},{"lineBreak":true},{"text":"Thou hast rent off my sackcloth, and girded me with gladness;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"That my glory may sing praise to thee, and I may not be pierced with sorrow.","poem":1},{"lineBreak":true},{"text":"O Lord my God, I will give thanks to thee forever.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":13}