{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"A Psalm of David, when he fled from the presence of his son Absalom.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"O Lord, why are they that afflict me multiplied?","poem":1},{"lineBreak":true},{"text":"Many rise up against me.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Many say concerning my soul,","poem":1},{"lineBreak":true},{"text":"There is no deliverance for him in his God. Pause.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"But thou, O Lord, art my helper:","poem":1},{"lineBreak":true},{"text":"My glory, and the one that lifts up my head.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I cried to the Lord with my voice,","poem":1},{"lineBreak":true},{"text":"And he heard me out of his holy mountain. Pause.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I lay down and slept;","poem":1},{"lineBreak":true},{"text":"I awoke; for the Lord will help me.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I will not be afraid of ten thousands of people,","poem":1},{"lineBreak":true},{"text":"Who beset me round about.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Arise, Lord; deliver me, my God:","poem":1},{"lineBreak":true},{"text":"For thou hast smitten all who were without cause mine enemies;","poem":1},{"lineBreak":true},{"text":"Thou hast broken the teeth of sinners.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Deliverance is the Lord’s,","poem":1},{"lineBreak":true},{"text":"And thy blessing is upon thy people.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":9}