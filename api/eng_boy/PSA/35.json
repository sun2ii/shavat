{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":[{"text":"For the end, by David the servant of the Lord.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"The transgressor, that he may sin, says within himself,","poem":1},{"lineBreak":true},{"text":"That there is no fear of God before his eyes.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For he has dealt craftily before him,","poem":1},{"lineBreak":true},{"text":"To discover his iniquity and hate it.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The words of his mouth are transgression and deceit:","poem":1},{"lineBreak":true},{"text":"He is not inclined to understand how to do good.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"He devises iniquity on his bed;","poem":1},{"lineBreak":true},{"text":"He gives himself to every evil way;","poem":1},{"lineBreak":true},{"text":"And does not abhor evil.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"O Lord, thy mercy is in the heaven;","poem":1},{"lineBreak":true},{"text":"And thy truth reaches to the clouds.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Thy righteousness is as the mountains of God,","poem":1},{"lineBreak":true},{"text":"Thy judgments are as a great deep:","poem":1},{"lineBreak":true},{"text":"O Lord, thou wilt preserve men and beasts.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"How hast thou multiplied thy mercy, O God!","poem":1},{"lineBreak":true},{"text":"So the children of men shall trust in the shelter of thy wings.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"They shall be fully satisfied with the fatness of thy house;","poem":1},{"lineBreak":true},{"text":"And thou shalt cause them to drink of the full stream of thy delights.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"For with thee is the fountain of life:","poem":1},{"lineBreak":true},{"text":"In thy light we shall see light.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Extend thy mercy to them that know thee;","poem":1},{"lineBreak":true},{"text":"And thy righteousness to the upright in heart.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Let not the foot of pride come against me,","poem":1},{"lineBreak":true},{"text":"And let not the hand of sinners move me.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"There have all the workers of iniquity fallen:","poem":1},{"lineBreak":true},{"text":"They are cast out, and shall not be able to stand.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":13}