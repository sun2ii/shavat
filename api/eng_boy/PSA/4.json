{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"For the end, a Song of David among the Psalms.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"When I called upon him, the God of my righteousness heard me:","poem":1},{"lineBreak":true},{"text":"Thou hast made room for me in tribulation;","poem":1},{"lineBreak":true},{"text":"Pity me, and hearken to my prayer.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"O ye sons of men, how long will ye be slow of heart?","poem":1},{"lineBreak":true},{"text":"Wherefore do ye love vanity, and seek falsehood? Pause.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"But know ye that the Lord has done wondrous things for his holy one:","poem":1},{"lineBreak":true},{"text":"The Lord will hear me when I cry to him.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Be ye angry, and sin not;","poem":1},{"lineBreak":true},{"text":"Feel compunction upon your beds","poem":1},{"lineBreak":true},{"text":"For what ye say in your hearts. Pause.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Offer the sacrifice of righteousness,","poem":1},{"lineBreak":true},{"text":"And trust in the Lord.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Many say, Who will show us good things?","poem":1},{"lineBreak":true},{"text":"The light of thy countenance, O Lord, has been manifested toward us.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Thou hast put gladness into my heart:","poem":1},{"lineBreak":true},{"text":"They have been satisfied with the fruit of their corn and wine and oil.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I will both lie down in peace and sleep:","poem":1},{"lineBreak":true},{"text":"For thou, Lord, only hast caused me to dwell securely.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":9}