{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":[{"text":"For the end, a Psalm of David.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Blessed is the man who thinks on the poor and needy:","poem":1},{"lineBreak":true},{"text":"The Lord shall deliver him in an evil day.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"May the Lord preserve him and keep him alive, and bless him on the earth,","poem":1},{"lineBreak":true},{"text":"And not deliver him into the hands of his enemy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"May the Lord help him upon the bed of his pain;","poem":1},{"lineBreak":true},{"text":"Thou hast made all his bed in his sickness.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"I said, O Lord, have mercy upon me;","poem":1},{"lineBreak":true},{"text":"Heal my soul; for I have sinned against thee.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mine enemies have spoken evil against me, saying,","poem":1},{"lineBreak":true},{"text":"When shall he die, and his name perish?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"And if he came to see me, his heart spoke vainly;","poem":1},{"lineBreak":true},{"text":"He gathered iniquity to himself;","poem":1},{"lineBreak":true},{"text":"He went forth and spoke in like manner.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"All my enemies whispered against me;","poem":1},{"lineBreak":true},{"text":"Against me they devised my hurt.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"They denounced a wicked word against me, saying,","poem":1},{"lineBreak":true},{"text":"Now that he lies, shall he not rise up again?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"For even the man of my peace, in whom I trusted,","poem":1},{"lineBreak":true},{"text":"Who ate my bread, lifted up his heel against me.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"But thou, O Lord, have compassion upon me, and raise me up, and I shall requite them.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"By this I know that thou hast delighted in me,","poem":1},{"lineBreak":true},{"text":"Because mine enemy shall not rejoice over me.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"But thou didst help me because of mine innocence,","poem":1},{"lineBreak":true},{"text":"And hast established me before thee forever.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Blessed be the Lord God of Israel from everlasting, and to everlasting.","poem":1},{"lineBreak":true},{"text":"So be it, so be it.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":14}