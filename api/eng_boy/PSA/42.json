{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":42,"content":[{"type":"verse","number":1,"content":[{"text":"A Psalm of David.","descriptive":true},{"text":"Judge me, O God, and plead my cause, against an ungodly nation:","poem":1},{"lineBreak":true},{"text":"Deliver me from the unjust and crafty man.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For thou, O God, art my strength: wherefore hast thou cast me off?","poem":1},{"lineBreak":true},{"text":"And why do I go sad of countenance, while the enemy oppresses me?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Send forth thy light and thy truth:","poem":1},{"lineBreak":true},{"text":"They have led me, and brought me to thy holy mountain,","poem":1},{"lineBreak":true},{"text":"And to thy tabernacles.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"And I will go in to the altar of God,","poem":1},{"lineBreak":true},{"text":"To God who gladdens my youth:","poem":1},{"lineBreak":true},{"text":"I will give thanks to thee on the harp, O God, my God.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wherefore art thou very sad, O my soul? and wherefore dost thou trouble me?","poem":1},{"lineBreak":true},{"text":"Hope in God; for I will give thanks to him,","poem":1},{"lineBreak":true},{"text":"Who is the health of my countenance, and my God.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":5}