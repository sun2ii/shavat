{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":45,"content":[{"type":"verse","number":1,"content":[{"text":"For the end, for the sons of Korah; a Psalm concerning secret things.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"God is our refuge and strength,","poem":1},{"lineBreak":true},{"text":"A help in the afflictions that have come heavily upon us.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Therefore will we not fear when the earth is troubled,","poem":1},{"lineBreak":true},{"text":"And the mountains are removed into the depths of the seas.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Their waters have roared and been troubled,","poem":1},{"lineBreak":true},{"text":"The mountains have been troubled by his might. Pause.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The flowings of the river gladden the city of God:","poem":1},{"lineBreak":true},{"text":"The Most High has sanctified his tabernacle.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"God is in the midst of her; she shall not be moved:","poem":1},{"lineBreak":true},{"text":"God shall help her with his countenance.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The nations were troubled, the kingdoms tottered:","poem":1},{"lineBreak":true},{"text":"He uttered his voice, the earth shook.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The Lord of hosts is with us;","poem":1},{"lineBreak":true},{"text":"The God of Jacob is our helper. Pause.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Come, and behold the works of the Lord,","poem":1},{"lineBreak":true},{"text":"What wonders he has achieved on the earth.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Putting an end to wars as for the ends of the earth;","poem":1},{"lineBreak":true},{"text":"He will crush the bow, and break in pieces the weapon,","poem":1},{"lineBreak":true},{"text":"And burn the bucklers with fire.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Be still, and know that I am God:","poem":1},{"lineBreak":true},{"text":"I will be exalted among the nations, I will be exalted in the earth.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"The Lord of hosts is with us;","poem":1},{"lineBreak":true},{"text":"The God of Jacob is our helper.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":12}