{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":46,"content":[{"type":"verse","number":1,"content":[{"text":"For the end, a Psalm for the sons of Korah.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Clap your hands, all ye nations;","poem":1},{"lineBreak":true},{"text":"Shout to God with a voice of exultation.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For the Lord most high is terrible;","poem":1},{"lineBreak":true},{"text":"He is a great king over all the earth.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He has subdued the peoples under us,","poem":1},{"lineBreak":true},{"text":"And the nations under our feet.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"He has chosen out his inheritance for us,","poem":1},{"lineBreak":true},{"text":"The beauty of Jacob which he loved. Pause.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"God is gone up with a shout,","poem":1},{"lineBreak":true},{"text":"The Lord with a sound of a trumpet.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sing praises to our God, sing praises:","poem":1},{"lineBreak":true},{"text":"Sing praises to our King, sing praises.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For God is king of all the earth:","poem":1},{"lineBreak":true},{"text":"Sing praises with understanding.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"God reigns over the nations:","poem":1},{"lineBreak":true},{"text":"God sits upon the throne of his holiness.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"The rulers of the people are assembled with the God of Abraham:","poem":1},{"lineBreak":true},{"text":"For God’s mighty ones of the earth have been greatly exalted.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":10}