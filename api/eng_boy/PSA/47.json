{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":47,"content":[{"type":"verse","number":1,"content":[{"text":"A Psalm of praise for the sons of Korah on the second day of the week.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Great is the Lord, and greatly to be praised","poem":1},{"lineBreak":true},{"text":"In the city of our God, in his holy mountain.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The city of the great King","poem":1},{"lineBreak":true},{"text":"Is well planted on the mountains of Zion,","poem":1},{"lineBreak":true},{"text":"With the joy of the whole earth, on the sides of the north.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"God is known in her palaces,","poem":1},{"lineBreak":true},{"text":"When he undertakes to help her.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"For, behold, the kings of the earth were assembled,","poem":1},{"lineBreak":true},{"text":"They came together.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"They saw, and so they wondered:","poem":1},{"lineBreak":true},{"text":"They were troubled, they were moved.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Trembling took hold on them:","poem":1},{"lineBreak":true},{"text":"There were the pangs as of a woman in travail.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Thou wilt break the ships of Tarshish with a vehement wind.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"As we have heard, so have we also seen,","poem":1},{"lineBreak":true},{"text":"In the city of the Lord of hosts,","poem":1},{"lineBreak":true},{"text":"In the city of our God:","poem":1},{"lineBreak":true},{"text":"God has founded it forever. Pause.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"We have thought of thy mercy, O God,","poem":1},{"lineBreak":true},{"text":"In the midst of thy people.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"According to thy name, O God,","poem":1},{"lineBreak":true},{"text":"So is also thy praise to the ends of the earth:","poem":1},{"lineBreak":true},{"text":"Thy right hand is full of righteousness.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Let Mount Zion rejoice,","poem":1},{"lineBreak":true},{"text":"Let the daughters of Judea exult,","poem":1},{"lineBreak":true},{"text":"Because of thy judgments, O Lord.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Go round about Zion, and encompass her:","poem":1},{"lineBreak":true},{"text":"Tell ye her towers.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mark ye well her strength,","poem":1},{"lineBreak":true},{"text":"And observe her palaces;","poem":1},{"lineBreak":true},{"text":"That ye may tell the next generation.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"For this is our God forever and ever:","poem":1},{"lineBreak":true},{"text":"He will be our guide for evermore.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}