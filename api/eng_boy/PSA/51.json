{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":[{"text":"For the end, a Psalm of instruction by David,","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"when Doeg the Edomite came and told Saul, and said to him, David is gone to the house of Ahimelech.","descriptive":true}]},{"type":"verse","number":3,"content":[{"text":"Why dost thou, O mighty man, boast of iniquity in thy mischief?","poem":1},{"lineBreak":true},{"text":"All the day","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"thy tongue has devised unrighteousness;","poem":1},{"lineBreak":true},{"text":"Like a sharpened razor thou hast wrought deceit.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Thou hast loved wickedness more than goodness;","poem":1},{"lineBreak":true},{"text":"Unrighteousness better than to speak righteousness. Pause.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Thou hast loved all words of destruction,","poem":1},{"lineBreak":true},{"text":"And a deceitful tongue.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Therefore may God destroy thee forever,","poem":1},{"lineBreak":true},{"text":"May he pluck thee up and utterly remove thee from thy dwelling,","poem":1},{"lineBreak":true},{"text":"And thy root from the land of the living. Pause.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"And the righteous shall see, and fear,","poem":1},{"lineBreak":true},{"text":"And shall laugh at him, and say,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Behold the man who made not God his help;","poem":1},{"lineBreak":true},{"text":"But trusted in the abundance of his wealth,","poem":1},{"lineBreak":true},{"text":"And strengthened himself in his vanity.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"But I am as a fruitful olive in the house of God:","poem":1},{"lineBreak":true},{"text":"I have trusted in the mercy of God","poem":1},{"lineBreak":true},{"text":"Forever, even for evermore.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I will give thanks to thee forever, for thou hast done it:","poem":1},{"lineBreak":true},{"text":"And I will wait on thy name;","poem":1},{"lineBreak":true},{"text":"For it is good before thy saints.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":11}