{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":52,"content":[{"type":"verse","number":1,"content":[{"text":"For the end, a Psalm of David upon Mahalath, of instruction.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"The fool has said in his heart, There is no God.","poem":1},{"lineBreak":true},{"text":"They have corrupted themselves, and become abominable in iniquities:","poem":1},{"lineBreak":true},{"text":"There is none that does good.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"God looked down from heaven upon the sons of men,","poem":1},{"lineBreak":true},{"text":"To see if there were any that understood, or sought after God.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"They have all gone out of the way, they are together become unprofitable;","poem":1},{"lineBreak":true},{"text":"There is none that does good, there is not even one.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Will none of the workers of iniquity know,","poem":1},{"lineBreak":true},{"text":"Who devour my people as they would eat bread?","poem":1},{"lineBreak":true},{"text":"They have not called upon God.","poem":1},{"lineBreak":true},{"text":"There were they greatly afraid, where there was no fear:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"For God has scattered the bones of the men pleasers;","poem":1},{"lineBreak":true},{"text":"They were ashamed, for God despised them.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Who will bring the salvation of Israel out of Zion?","poem":1},{"lineBreak":true},{"text":"When the Lord turns the captivity of his people,","poem":1},{"lineBreak":true},{"text":"Jacob shall exult, and Israel shall be glad.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":7}