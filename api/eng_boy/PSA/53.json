{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":[{"text":"For the end, among the Hymns of instruction by David,","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"when the Ziphites came and said to Saul, Lo, is not David hidden with us?","descriptive":true}]},{"type":"verse","number":3,"content":[{"text":"Save me, O God, by thy name,","poem":1},{"lineBreak":true},{"text":"And judge me by thy might.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"O God, hear my prayer;","poem":1},{"lineBreak":true},{"text":"Hearken to the words of my mouth.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For strangers have risen up against me,","poem":1},{"lineBreak":true},{"text":"And mighty men have sought my life:","poem":1},{"lineBreak":true},{"text":"They have not set God before them. Pause.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"For lo! God assists me;","poem":1},{"lineBreak":true},{"text":"And the Lord is the helper of my soul.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He shall return evil to mine enemies;","poem":1},{"lineBreak":true},{"text":"Utterly destroy them in thy truth.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I will willingly sacrifice to thee:","poem":1},{"lineBreak":true},{"text":"I will give thanks to thy name, O Lord; for it is good.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"For thou hast delivered me out of all affliction,","poem":1},{"lineBreak":true},{"text":"And mine eye has seen my desire upon mine enemies.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":9}