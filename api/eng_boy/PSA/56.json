{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":56,"content":[{"type":"verse","number":1,"content":[{"text":"For the end. Destroy not: by David, for a memorial, when he fled from the presence of Saul to the cave.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Have mercy, upon me, O God, have mercy upon me:","poem":1},{"lineBreak":true},{"text":"For my soul has trusted in thee:","poem":1},{"lineBreak":true},{"text":"And in the shadow of thy wings will I hope,","poem":1},{"lineBreak":true},{"text":"Until the iniquity have passed away.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I will cry to God most high;","poem":1},{"lineBreak":true},{"text":"The God who has benefited me. Pause.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He sent from heaven and saved me;","poem":1},{"lineBreak":true},{"text":"He gave to reproach them that trampled on me:","poem":1},{"lineBreak":true},{"text":"God has sent forth his mercy and his truth;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"And he has delivered my soul from the midst of lions’ whelps:","poem":1},{"lineBreak":true},{"text":"I lay down to sleep, though troubled.","poem":1},{"lineBreak":true},{"text":"As for the sons of men, their teeth are arms and missile weapons,","poem":1},{"lineBreak":true},{"text":"And their tongue a sharp sword.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Be thou exalted, O God, above the heavens;","poem":1},{"lineBreak":true},{"text":"And thy glory above all the earth.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"They have prepared snares for my feet,","poem":1},{"lineBreak":true},{"text":"And have bowed down my soul:","poem":1},{"lineBreak":true},{"text":"They have dug a pit before my face,","poem":1},{"lineBreak":true},{"text":"And fallen into it themselves. Pause.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"My heart, O God, is ready,","poem":1},{"lineBreak":true},{"text":"My heart is ready: I will sing, yea will sing psalms.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Awake, my glory;","poem":1},{"lineBreak":true},{"text":"Awake, psaltery and harp:","poem":1},{"lineBreak":true},{"text":"I will awake early.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"O Lord, I will give thanks to thee among the nations:","poem":1},{"lineBreak":true},{"text":"I will sing to thee among the Gentiles.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"For thy mercy has been magnified even to the heavens,","poem":1},{"lineBreak":true},{"text":"And thy truth to the clouds.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Be thou exalted, O God, above the heavens;","poem":1},{"lineBreak":true},{"text":"And thy glory above all the earth.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}