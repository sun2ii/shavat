{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":57,"content":[{"type":"verse","number":1,"content":[{"text":"For the end. Destroy not: by David, for a memorial.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"If ye do indeed speak righteousness,","poem":1},{"lineBreak":true},{"text":"Then do ye judge rightly, ye sons of men.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For ye work iniquities in your hearts in the earth:","poem":1},{"lineBreak":true},{"text":"Your hands plot unrighteousness.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sinners have gone astray from the womb:","poem":1},{"lineBreak":true},{"text":"They go astray from the belly: they speak lies.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Their venom is like that of a serpent;","poem":1},{"lineBreak":true},{"text":"As that of a deaf asp, and that stops her ears;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Which will not hear the voice of charmers,","poem":1},{"lineBreak":true},{"text":"Nor heed the charm prepared skillfully by the wise.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"God has crushed their teeth in their mouth:","poem":1},{"lineBreak":true},{"text":"God has broken the cheek teeth of the lions.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"They shall utterly pass away like water running through:","poem":1},{"lineBreak":true},{"text":"He shall bend his bow till they shall fail.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"They shall be destroyed as melted wax:","poem":1},{"lineBreak":true},{"text":"The fire has fallen and they have not seen the sun.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Before your thorns feel the white thorn,","poem":1},{"lineBreak":true},{"text":"He shall swallow you up as living, as in his wrath.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"The righteous shall rejoice when he sees the vengeance of the ungodly:","poem":1},{"lineBreak":true},{"text":"He shall wash his hands in the blood of the sinner.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"And a man shall say, Verily then there is a reward for the righteous:","poem":1},{"lineBreak":true},{"text":"Verily there is a God that judges them in the earth.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":12}