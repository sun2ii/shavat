{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":59,"content":[{"type":"verse","number":1,"content":[{"text":"For the end, for them that shall yet be changed; for an inscription by David for instruction,","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"when he had burned Mesopotamia of Syria, and Syria Zobah, and Joab had returned and smitten in the Valley of Salt twelve thousand.","descriptive":true}]},{"type":"verse","number":3,"content":[{"text":"O God, thou hast rejected and destroyed us;","poem":1},{"lineBreak":true},{"text":"Thou hast been angry, yet hast pitied us.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Thou hast shaken the earth, and troubled it;","poem":1},{"lineBreak":true},{"text":"Heal its breaches, for it has been shaken.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Thou hast shown thy people hard things:","poem":1},{"lineBreak":true},{"text":"Thou hast made us drink the wine of astonishment.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Thou hast given a token to them that fear thee,","poem":1},{"lineBreak":true},{"text":"That they might flee from the bow. Pause.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"That thy beloved ones may be delivered;","poem":1},{"lineBreak":true},{"text":"Save with thy right hand, and hear me.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"God has spoken in his holiness;","poem":1},{"lineBreak":true},{"text":"I will rejoice, and divide Shechem,","poem":1},{"lineBreak":true},{"text":"And measure out the Valley of Tents.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gilead is mine, and Manasseh is mine;","poem":1},{"lineBreak":true},{"text":"And Ephraim is the strength of my head;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Judah is my king;","poem":1},{"lineBreak":true},{"text":"Moab is the caldron of my hope;","poem":1},{"lineBreak":true},{"text":"Over Edom will I stretch out my shoe;","poem":1},{"lineBreak":true},{"text":"The Philistines have been subjected to me.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Who will lead me into the fortified city?","poem":1},{"lineBreak":true},{"text":"Who will guide me as far as Edom?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wilt not thou, O God, who hast cast us off?","poem":1},{"lineBreak":true},{"text":"And wilt not thou, O God, go forth with our forces?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Give us help from trouble:","poem":1},{"lineBreak":true},{"text":"For vain is the deliverance of man.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"In God will we do valiantly;","poem":1},{"lineBreak":true},{"text":"And he shall bring to nought them that harass us.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":14}