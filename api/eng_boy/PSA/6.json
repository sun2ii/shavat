{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"For the end, a Psalm of David among the Hymns for the eighth.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"O Lord, rebuke me not in thy wrath,","poem":1},{"lineBreak":true},{"text":"Neither chasten me in thine anger.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pity me, O Lord; for I am weak:","poem":1},{"lineBreak":true},{"text":"Heal me, O Lord; for my bones are vexed.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"My soul also is grievously vexed:","poem":1},{"lineBreak":true},{"text":"But thou, O Lord, how long?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Return, O Lord, deliver my soul:","poem":1},{"lineBreak":true},{"text":"Save me for thy mercy’s sake.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"For in death no man remembers thee:","poem":1},{"lineBreak":true},{"text":"And who will give thee thanks in Hades?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I am wearied with my groaning;","poem":1},{"lineBreak":true},{"text":"I shall wash my bed every night;","poem":1},{"lineBreak":true},{"text":"I shall water my couch with my tears.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mine eye is troubled because of my wrath;","poem":1},{"lineBreak":true},{"text":"I am worn out because of all my enemies.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Depart from me, all ye that work iniquity;","poem":1},{"lineBreak":true},{"text":"For the Lord has heard the voice of my weeping.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"The Lord has hearkened to my petition;","poem":1},{"lineBreak":true},{"text":"The Lord has accepted my prayer.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Let all mine enemies be put to shame and sore troubled:","poem":1},{"lineBreak":true},{"text":"Let them be turned back and grievously put to shame speedily.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}