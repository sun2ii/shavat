{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":60,"content":[{"type":"verse","number":1,"content":[{"text":"For the end, among the Hymns of David.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"O God, hearken to my petition;","poem":1},{"lineBreak":true},{"text":"Attend to my prayer.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"From the ends of the earth have I cried to thee,","poem":1},{"lineBreak":true},{"text":"When my heart was in trouble:","poem":1},{"lineBreak":true},{"text":"Thou liftedst me up on a rock,","poem":1},{"lineBreak":true},{"text":"Thou didst guide me:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"because thou wert my hope,","poem":1},{"lineBreak":true},{"text":"A tower of strength from the face of the enemy.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I will dwell in thy tabernacle forever;","poem":1},{"lineBreak":true},{"text":"I will shelter myself under the shadow of thy wings. Pause.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"For thou, O God, hast heard my prayers;","poem":1},{"lineBreak":true},{"text":"Thou hast given an inheritance to them that fear thy name.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Thou shalt add days to the days of the king;","poem":1},{"lineBreak":true},{"text":"Thou shalt lengthen his years to all generations.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"He shall endure forever before God:","poem":1},{"lineBreak":true},{"text":"Which of them will seek out his mercy and truth?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"So will I sing to thy name forever and ever,","poem":1},{"lineBreak":true},{"text":"That I may daily perform my vows.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":9}