{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":61,"content":[{"type":"verse","number":1,"content":[{"text":"For the end, a Psalm of David for Jeduthun.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Shall not my soul be subjected to God?","poem":1},{"lineBreak":true},{"text":"For of him is my salvation.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For he is my God and my Savior;","poem":1},{"lineBreak":true},{"text":"My helper, I shall not be moved very much.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"How long will ye assault a man?","poem":1},{"lineBreak":true},{"text":"Ye are all slaughtering","poem":1},{"lineBreak":true},{"text":"As with a bowed wall and a broken hedge.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"They only took counsel to set at nought mine honor:","poem":1},{"lineBreak":true},{"text":"I ran in thirst:","poem":1},{"lineBreak":true},{"text":"With their mouth they blessed, but with their heart they cursed. Pause.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nevertheless do thou, my soul, be subjected to God;","poem":1},{"lineBreak":true},{"text":"For of him is my patient hope.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For he is my God and my Savior;","poem":1},{"lineBreak":true},{"text":"My helper, I shall not be moved.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"In God is my salvation and my glory:","poem":1},{"lineBreak":true},{"text":"He is the God of my help, and my hope is in God.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hope in him, all ye congregation of the people;","poem":1},{"lineBreak":true},{"text":"Pour out your hearts before him, for God is our helper. Pause.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"But the sons of men are vain;","poem":1},{"lineBreak":true},{"text":"The sons of men are false, so as to be deceitful in the balances;","poem":1},{"lineBreak":true},{"text":"They are all alike formed out of vanity.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Trust not in unrighteousness,","poem":1},{"lineBreak":true},{"text":"And lust not after robberies:","poem":1},{"lineBreak":true},{"text":"If wealth should flow in, set not your heart upon it.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"God has spoken once, and I have heard these two things,","poem":1},{"lineBreak":true},{"text":"That power is of God;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"and mercy is thine, O Lord;","poem":1},{"lineBreak":true},{"text":"For thou wilt recompense every one according to his works.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":13}