{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":62,"content":[{"type":"verse","number":1,"content":[{"text":"A Psalm of David, when he was in the wilderness of Edom.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"O God, my God, I cry to thee early;","poem":1},{"lineBreak":true},{"text":"My soul has thirsted for thee:","poem":1},{"lineBreak":true},{"text":"How often has my flesh longed after thee,","poem":1},{"lineBreak":true},{"text":"In a barren and trackless and dry land!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Thus have I appeared before thee in the sanctuary,","poem":1},{"lineBreak":true},{"text":"That I might see thy power and thy glory.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For thy mercy is better than life:","poem":1},{"lineBreak":true},{"text":"My lips shall praise thee.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Thus will I bless thee during my life:","poem":1},{"lineBreak":true},{"text":"I will lift up my hands in thy name.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Let my soul be filled as with marrow and fatness;","poem":1},{"lineBreak":true},{"text":"And my joyful lips shall praise thy name.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Forasmuch as I have remembered thee on my bed:","poem":1},{"lineBreak":true},{"text":"In the early seasons I have meditated on thee.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For thou hast been my helper,","poem":1},{"lineBreak":true},{"text":"And in the shelter of thy wings will I rejoice.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"My soul has kept very close behind thee:","poem":1},{"lineBreak":true},{"text":"Thy right hand has upheld me.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"But they vainly sought after my soul;","poem":1},{"lineBreak":true},{"text":"They shall go into the lowest parts of the earth.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"They shall be delivered up to the power of the sword;","poem":1},{"lineBreak":true},{"text":"They shall be portions for foxes.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"But the king shall rejoice in God;","poem":1},{"lineBreak":true},{"text":"Everyone that swears by him shall be praised;","poem":1},{"lineBreak":true},{"text":"For the mouth of them that speak unjust things has been stopped.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}