{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":63,"content":[{"type":"verse","number":1,"content":[{"text":"For the end, a Psalm of David.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Hear my prayer, O God, when I make my petition to thee;","poem":1},{"lineBreak":true},{"text":"Deliver my soul from fear of the enemy.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Thou hast sheltered me from the conspiracy of them that do wickedly;","poem":1},{"lineBreak":true},{"text":"From the multitude of them that work iniquity;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Who have sharpened their tongues as a sword;","poem":1},{"lineBreak":true},{"text":"They have bent their bow maliciously;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"To shoot in secret at the blameless;","poem":1},{"lineBreak":true},{"text":"They will shoot him suddenly, and will not fear.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"They have set up for themselves an evil matter,","poem":1},{"lineBreak":true},{"text":"They have given counsel to hide snares;","poem":1},{"lineBreak":true},{"text":"They have said, Who shall see them?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"They have searched out iniquity;","poem":1},{"lineBreak":true},{"text":"They have wearied themselves with searching diligently,","poem":1},{"lineBreak":true},{"text":"A man shall approach and the heart is deep,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"And God shall be exalted,","poem":1},{"lineBreak":true},{"text":"Their wounds were caused by the weapon of the foolish children,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"And their tongues have set him at nought,","poem":1},{"lineBreak":true},{"text":"All that saw them were troubled;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"And every man was alarmed,","poem":1},{"lineBreak":true},{"text":"And they related the works of God,","poem":1},{"lineBreak":true},{"text":"And understood his deeds.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"The righteous shall rejoice in the Lord, and hope on him,","poem":1},{"lineBreak":true},{"text":"And all the upright in heart shall be praised.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}