{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":69,"content":[{"type":"verse","number":1,"content":[{"text":"For the end, by David for a remembrance, that the Lord may save me.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Draw nigh, O God, to my help.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let them be ashamed and confounded that seek my soul:","poem":1},{"lineBreak":true},{"text":"Let them be turned backward and put to shame, that wish me evil.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Let them that say to me, Aha, aha, be turned back and put to shame immediately.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Let all that seek thee exult and be glad in thee:","poem":1},{"lineBreak":true},{"text":"And let those that love thy salvation say continually, Let God be magnified.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"But I am poor and needy; O God, help me:","poem":1},{"lineBreak":true},{"text":"Thou art my helper and deliverer, O Lord, delay not.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":6}