{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":74,"content":[{"type":"verse","number":1,"content":[{"text":"For the end, Destroy not, a Psalm of a Song for Asaph.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"We will give thanks to thee, O God,","poem":1},{"lineBreak":true},{"text":"We will give thanks, and call upon thy name:","poem":1},{"lineBreak":true},{"text":"I will declare all thy wonderful works.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"When I shall take a set time, I will judge righteously.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The earth is dissolved, and all that dwell in it:","poem":1},{"lineBreak":true},{"text":"I have strengthened its pillars. Pause.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"I said unto the transgressors, Do not transgress;","poem":1},{"lineBreak":true},{"text":"And to the sinners, Lift not up the horn.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lift not up your horn on high;","poem":1},{"lineBreak":true},{"text":"Speak not unrighteousness against God.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For good comes neither from the east, nor from the west,","poem":1},{"lineBreak":true},{"text":"Nor from the desert mountains.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For God is the judge;","poem":1},{"lineBreak":true},{"text":"He puts down one, and raises up another.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"For there is a cup in the hand of the Lord,","poem":1},{"lineBreak":true},{"text":"Full of unmingled wine;","poem":1},{"lineBreak":true},{"text":"And he has turned it from side to side,","poem":1},{"lineBreak":true},{"text":"But its dregs have not been wholly poured out;","poem":1},{"lineBreak":true},{"text":"All the sinners of the earth shall drink them.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"But I will exult forever:","poem":1},{"lineBreak":true},{"text":"I will sing praises to the God of Jacob.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"And I will break all the horns of sinners;","poem":1},{"lineBreak":true},{"text":"But the horns of the righteous one shall be exalted.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":11}