{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":75,"content":[{"type":"verse","number":1,"content":[{"text":"For the end, among the Hymns, a Psalm for Asaph; a Song for the Assyrian.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"God is known in Judea;","poem":1},{"lineBreak":true},{"text":"His name is great in Israel.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"And his place has been in peace,","poem":1},{"lineBreak":true},{"text":"And his dwelling place in Zion.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"There he broke the power of the bows,","poem":1},{"lineBreak":true},{"text":"The shield, and the sword, and the battle. Pause.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Thou dost wonderfully shine forth from the everlasting mountains.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"All the simple ones in heart were troubled;","poem":1},{"lineBreak":true},{"text":"All the men of wealth have slept their sleep,","poem":1},{"lineBreak":true},{"text":"And have found nothing in their hands.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"At thy rebuke, O God of Jacob,","poem":1},{"lineBreak":true},{"text":"The riders on horses slumbered.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Thou art terrible; and who shall withstand thee,","poem":1},{"lineBreak":true},{"text":"Because of thine anger?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Thou didst cause judgment to be heard from heaven;","poem":1},{"lineBreak":true},{"text":"The earth feared, and was still,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"When God arose to judgment,","poem":1},{"lineBreak":true},{"text":"To save all the meek in heart. Pause.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"For the inward thought of man shall give thanks to thee:","poem":1},{"lineBreak":true},{"text":"And the memorial of his inward thought shall keep a feast to thee.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Vow, and pay your vows to the Lord our God;","poem":1},{"lineBreak":true},{"text":"All that are round about him shall bring gifts,","poem":1},{"lineBreak":true},{"text":"Even to him that is terrible,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"and that takes away the spirits of princes;","poem":1},{"lineBreak":true},{"text":"To him that is terrible among the kings of the earth.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":13}