{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"For the end, concerning the winepresses, a Psalm of David.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"O Lord, our Lord, how wonderful is thy name in all the earth!","poem":1},{"lineBreak":true},{"text":"For thy magnificence is exalted above the heavens.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Out of the mouth of babes and sucklings hast thou perfected praise,","poem":1},{"lineBreak":true},{"text":"Because of thine enemies;","poem":1},{"lineBreak":true},{"text":"That thou mightest put down the enemy and avenger.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"For I will regard the heavens, the work of thy fingers;","poem":1},{"lineBreak":true},{"text":"The moon and stars, which thou hast established.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"What is man, that thou art mindful of him?","poem":1},{"lineBreak":true},{"text":"Or the son of man, that thou visitest him?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Thou madest him a little less than angels,","poem":1},{"lineBreak":true},{"text":"Thou hast crowned him with glory and honor;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"And thou hast set him over the works of thy hands:","poem":1},{"lineBreak":true},{"text":"Thou hast put all things under his feet:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sheep and all oxen,","poem":1},{"lineBreak":true},{"text":"Yea, and the cattle of the field;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The birds of the sky, and the fish of the sea,","poem":1},{"lineBreak":true},{"text":"The creatures passing through the paths of the sea.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"O Lord our Lord, how wonderful is thy name in all the earth!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":10}