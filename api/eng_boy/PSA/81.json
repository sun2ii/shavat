{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":81,"content":[{"type":"verse","number":1,"content":[{"text":"A Psalm for Asaph.","descriptive":true},{"text":"God stands in the assembly of gods;","poem":1},{"lineBreak":true},{"text":"And in the midst of them will judge gods.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"How long will ye judge unrighteously,","poem":1},{"lineBreak":true},{"text":"And accept the persons of sinners? Pause.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Judge the orphan and poor:","poem":1},{"lineBreak":true},{"text":"Do justice to the low and needy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rescue the needy, and deliver the poor","poem":1},{"lineBreak":true},{"text":"Out of the hand of the sinner.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"They know not, nor understand;","poem":1},{"lineBreak":true},{"text":"They walk on in darkness:","poem":1},{"lineBreak":true},{"text":"All the foundations of the earth shall be shaken.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I have said, Ye are gods;","poem":1},{"lineBreak":true},{"text":"And all of you children of the Most High.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"But ye die as men,","poem":1},{"lineBreak":true},{"text":"And fall as one of the princes.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Arise, O God, judge the earth:","poem":1},{"lineBreak":true},{"text":"For thou shalt inherit all nations.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":8}