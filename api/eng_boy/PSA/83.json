{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":83,"content":[{"type":"verse","number":1,"content":[{"text":"For the end, a Psalm for the sons of Korah, concerning the winepresses.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"How amiable are thy tabernacles, O Lord of hosts!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"My soul longs, and faints for the courts of the Lord:","poem":1},{"lineBreak":true},{"text":"My heart and my flesh have exulted in the living God.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yea, the sparrow has found himself a home,","poem":1},{"lineBreak":true},{"text":"And the turtledove a nest for herself, where she may lay her young,","poem":1},{"lineBreak":true},{"text":"Even thine altars, O Lord of hosts,","poem":1},{"lineBreak":true},{"text":"My King, and my God.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Blessed are they that dwell in thy house:","poem":1},{"lineBreak":true},{"text":"They will praise thee evermore. Pause.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Blessed is the man whose help is of thee, O Lord;","poem":1},{"lineBreak":true},{"text":"In his heart he has purposed to go up","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The Valley of Weeping, to the place which he has appointed,","poem":1},{"lineBreak":true},{"text":"For there the lawgiver will grant blessings.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"They shall go from strength to strength:","poem":1},{"lineBreak":true},{"text":"The God of gods shall be seen in Zion.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"O Lord God of hosts, hear my prayer:","poem":1},{"lineBreak":true},{"text":"Hearken, O God of Jacob. Pause.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Behold, O God our defender,","poem":1},{"lineBreak":true},{"text":"And look upon the face of thine anointed.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"For one day in thy courts is better than thousands.","poem":1},{"lineBreak":true},{"text":"I would rather be an abject in the house of God,","poem":1},{"lineBreak":true},{"text":"Than dwell in the tents of sinners.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"For the Lord loves mercy and truth:","poem":1},{"lineBreak":true},{"text":"God will give grace and glory:","poem":1},{"lineBreak":true},{"text":"The Lord will not withhold good things from them that walk in innocence.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"O Lord of hosts, blessed is the man that trusts in thee.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":13}