{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":84,"content":[{"type":"verse","number":1,"content":[{"text":"For the end, a Psalm for the sons of Korah.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"O Lord, thou hast taken pleasure in thy land:","poem":1},{"lineBreak":true},{"text":"Thou hast turned back the captivity of Jacob.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Thou hast forgiven thy people their transgressions;","poem":1},{"lineBreak":true},{"text":"Thou hast covered all their sins. Pause.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Thou hast caused all thy wrath to cease:","poem":1},{"lineBreak":true},{"text":"Thou hast turned from thy fierce anger.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Turn us, O God of our salvation,","poem":1},{"lineBreak":true},{"text":"And turn thine anger away from us.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wouldest thou be angry with us forever?","poem":1},{"lineBreak":true},{"text":"Or wilt thou continue thy wrath from generation to generation?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"O God, thou wilt turn and quicken us;","poem":1},{"lineBreak":true},{"text":"And thy people shall rejoice in thee.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Show us thy mercy, O Lord,","poem":1},{"lineBreak":true},{"text":"And grant us thy salvation.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"I will hear what the Lord God will say concerning me:","poem":1},{"lineBreak":true},{"text":"For he shall speak peace to his people,","poem":1},{"lineBreak":true},{"text":"And to his saints,","poem":1},{"lineBreak":true},{"text":"And to those that turn their heart toward him.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Moreover his salvation is near them that fear him;","poem":1},{"lineBreak":true},{"text":"That glory may dwell in our land.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mercy and truth are met together:","poem":1},{"lineBreak":true},{"text":"Righteousness and peace have kissed each other.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Truth has sprung out of the earth;","poem":1},{"lineBreak":true},{"text":"And righteousness has looked down from heaven.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"For the Lord will give goodness;","poem":1},{"lineBreak":true},{"text":"And our land shall yield her fruit.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Righteousness shall go before him;","poem":1},{"lineBreak":true},{"text":"And shall set his steps in the way.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":14}