{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":86,"content":[{"type":"verse","number":1,"content":[{"text":"A Psalm of a Song for the sons of Korah.","descriptive":true},{"text":"His foundations are in the holy mountains.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The Lord loves the gates of Zion,","poem":1},{"lineBreak":true},{"text":"More than all the tabernacles of Jacob.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Glorious things have been spoken of thee, O city of God. Pause.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"I will make mention of Rahab and Babylon to them that know me:","poem":1},{"lineBreak":true},{"text":"Behold also the Philistines, and Tyre, and the people of the Ethiopians:","poem":1},{"lineBreak":true},{"text":"These were born there.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A man shall say, Zion is my mother;","poem":1},{"lineBreak":true},{"text":"And such a man was born in her;","poem":1},{"lineBreak":true},{"text":"And the Highest himself has founded her.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The Lord shall recount it in the writing of the people,","poem":1},{"lineBreak":true},{"text":"And of these princes that were born in her. Pause.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The dwelling of all within thee is as the dwelling of those that rejoice.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":7}