{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":91,"content":[{"type":"verse","number":1,"content":[{"text":"A Psalm of a Song for the Sabbath day.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"It is a good thing to give thanks to the Lord,","poem":1},{"lineBreak":true},{"text":"And to sing praises to thy name, O thou Most High;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"To proclaim thy mercy in the morning,","poem":1},{"lineBreak":true},{"text":"And thy truth by night,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"On a psaltery of ten strings, with a song on the harp.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For thou, O Lord, hast made me glad with thy work:","poem":1},{"lineBreak":true},{"text":"And in the operations of thy hands will I exult.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"How have thy works been magnified, O Lord!","poem":1},{"lineBreak":true},{"text":"Thy thoughts are very deep.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A foolish man will not know,","poem":1},{"lineBreak":true},{"text":"And a senseless man will not understand this.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"When the sinners spring up as the grass,","poem":1},{"lineBreak":true},{"text":"And all the workers of iniquity have watched;","poem":1},{"lineBreak":true},{"text":"It is that they may be utterly destroyed forever.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"But thou, O Lord, art most high forever.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"For, behold, thine enemies shall perish;","poem":1},{"lineBreak":true},{"text":"And all the workers of iniquity shall be scattered.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"But my horn shall be exalted as the horn of a unicorn;","poem":1},{"lineBreak":true},{"text":"And mine old age with rich mercy.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"And mine eye has seen mine enemies,","poem":1},{"lineBreak":true},{"text":"And mine ear shall hear the wicked that rise up against me.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"The righteous shall flourish as a palm tree:","poem":1},{"lineBreak":true},{"text":"He shall be increased as the cedar in Lebanon.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"They that are planted in the house of the Lord","poem":1},{"lineBreak":true},{"text":"Shall flourish in the courts of our God.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Then shall they be increased in a fine old age;","poem":1},{"lineBreak":true},{"text":"And they shall be prosperous;","poem":1},{"lineBreak":true},{"text":"That they may declare","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"that the Lord my God is righteous,","poem":1},{"lineBreak":true},{"text":"And there is no iniquity in him.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}