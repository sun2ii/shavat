{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":92,"content":[{"type":"verse","number":1,"content":[{"text":"For the day before the Sabbath, when the land was first inhabited, the praise of a Song by David.","descriptive":true},{"text":"The Lord reigns; he has clothed himself with honor:","poem":1},{"lineBreak":true},{"text":"The Lord has clothed and girded himself with strength;","poem":1},{"lineBreak":true},{"text":"For he has established the world, which shall not be moved.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Thy throne is prepared of old:","poem":1},{"lineBreak":true},{"text":"Thou art from everlasting.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The rivers have lifted up, O Lord,","poem":1},{"lineBreak":true},{"text":"The rivers have lifted up their voices,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"At the voices of many waters:","poem":1},{"lineBreak":true},{"text":"The billows of the sea are wonderful:","poem":1},{"lineBreak":true},{"text":"The Lord is wonderful in high places.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Thy testimonies are made very sure:","poem":1},{"lineBreak":true},{"text":"Holiness becomes thy house, O Lord, forever.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":5}