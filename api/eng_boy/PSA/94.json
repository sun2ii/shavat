{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":94,"content":[{"type":"verse","number":1,"content":[{"text":"The praise of a Song by David.","descriptive":true},{"text":"Come, let us exult in the Lord;","poem":1},{"lineBreak":true},{"text":"Let us make a joyful noise to God our Savior.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Let us come before his presence with thanksgiving,","poem":1},{"lineBreak":true},{"text":"And make a joyful noise to him with psalms.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For the Lord is a great God,","poem":1},{"lineBreak":true},{"text":"And a great king over all gods:","poem":1},{"lineBreak":true},{"text":"For the Lord will not cast off his people.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For the ends of the earth are in his hands;","poem":1},{"lineBreak":true},{"text":"And the heights of the mountains are his.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For the sea is his, and he made it:","poem":1},{"lineBreak":true},{"text":"And his hands formed the dry land.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Come, let us worship and fall down before him;","poem":1},{"lineBreak":true},{"text":"And weep before the Lord that made us.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For he is our God;","poem":1},{"lineBreak":true},{"text":"And we are the people of his pasture,","poem":1},{"lineBreak":true},{"text":"And the sheep of his hand.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Today, if ye will hear his voice,","poem":1},{"lineBreak":true},{"text":"Harden not your hearts, as in the provocation,","poem":1},{"lineBreak":true},{"text":"According to the day of irritation in the wilderness:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Where your fathers tempted me,","poem":1},{"lineBreak":true},{"text":"Proved me, and saw my works.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Forty years was I grieved with this generation,","poem":1},{"lineBreak":true},{"text":"And said, They do always err in their heart,","poem":1},{"lineBreak":true},{"text":"And they have not known my ways.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"So I swore in my wrath,","poem":1},{"lineBreak":true},{"text":"They shall not enter into my rest.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":11}