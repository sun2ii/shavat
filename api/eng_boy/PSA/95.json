{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"When the house was built after the Captivity, a Song by David.","descriptive":true},{"text":"Sing to the Lord a new song;","poem":1},{"lineBreak":true},{"text":"Sing to the Lord, all the earth.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sing to the Lord, bless his name:","poem":1},{"lineBreak":true},{"text":"Proclaim his salvation from day to day.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Publish his glory among the Gentiles,","poem":1},{"lineBreak":true},{"text":"His wonderful works among all people.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"For the Lord is great, and greatly to be praised:","poem":1},{"lineBreak":true},{"text":"He is terrible above all gods.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For all the gods of the heathen are devils:","poem":1},{"lineBreak":true},{"text":"But the Lord made the heavens.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Thanksgiving and beauty are before him:","poem":1},{"lineBreak":true},{"text":"Holiness and majesty are in his sanctuary.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bring to the Lord, ye families of the Gentiles,","poem":1},{"lineBreak":true},{"text":"Bring to the Lord glory and honor.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bring to the Lord the glory becoming his name:","poem":1},{"lineBreak":true},{"text":"Take offerings, and go into his courts.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Worship the Lord in his holy court:","poem":1},{"lineBreak":true},{"text":"Let all the earth tremble before him.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Say among the heathen, The Lord reigns:","poem":1},{"lineBreak":true},{"text":"For he has established the world so that it shall not be moved:","poem":1},{"lineBreak":true},{"text":"He shall judge the people in righteousness.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Let the heavens rejoice, and the earth exult;","poem":1},{"lineBreak":true},{"text":"Let the sea be moved, and the fullness of it.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"The plains shall rejoice, and all things in them:","poem":1},{"lineBreak":true},{"text":"Then shall all the trees of the wood exult","poem":1},{"lineBreak":true},{"text":"Before the presence of the Lord:","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"for he comes,","poem":1},{"lineBreak":true},{"text":"For he comes to judge the earth;","poem":1},{"lineBreak":true},{"text":"He shall judge the world in righteousness,","poem":1},{"lineBreak":true},{"text":"And the people with his truth.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":13}