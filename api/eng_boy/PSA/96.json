{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":96,"content":[{"type":"verse","number":1,"content":[{"text":"For David, when his land is established.","descriptive":true},{"text":"The Lord reigns, let the earth exult,","poem":1},{"lineBreak":true},{"text":"Let many islands rejoice.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Cloud and darkness are round about him;","poem":1},{"lineBreak":true},{"text":"Righteousness and judgment are the establishment of his throne.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fire shall go before him,","poem":1},{"lineBreak":true},{"text":"And burn up his enemies round about.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"His lightnings appeared to the world;","poem":1},{"lineBreak":true},{"text":"The earth saw, and trembled.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The mountains melted like wax at the presence of the Lord,","poem":1},{"lineBreak":true},{"text":"At the presence of the Lord of the whole earth.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The heavens have declared his righteousness,","poem":1},{"lineBreak":true},{"text":"And all the people have seen his glory.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Let all that worship graven images be ashamed,","poem":1},{"lineBreak":true},{"text":"Who boast of their idols;","poem":1},{"lineBreak":true},{"text":"Worship him, all ye his angels.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Zion heard and rejoiced;","poem":1},{"lineBreak":true},{"text":"And the daughters of Judea exulted,","poem":1},{"lineBreak":true},{"text":"Because of thy judgments, O Lord.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"For thou art Lord most high over all the earth;","poem":1},{"lineBreak":true},{"text":"Thou art greatly exalted above all gods.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ye that love the Lord, hate evil;","poem":1},{"lineBreak":true},{"text":"The Lord preserves the souls of his saints;","poem":1},{"lineBreak":true},{"text":"He shall deliver them from the hand of sinners.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Light is sprung up for the righteous,","poem":1},{"lineBreak":true},{"text":"And gladness for the upright in heart.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Rejoice in the Lord, ye righteous;","poem":1},{"lineBreak":true},{"text":"And give thanks for a remembrance of his holiness.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":12}