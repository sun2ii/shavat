{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"A Psalm of David.","descriptive":true},{"text":"Sing to the Lord a new song;","poem":1},{"lineBreak":true},{"text":"For the Lord has wrought wonderful works,","poem":1},{"lineBreak":true},{"text":"His right hand, and his holy arm,","poem":1},{"lineBreak":true},{"text":"Have wrought salvation for him.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"The Lord has made known his salvation,","poem":1},{"lineBreak":true},{"text":"He has revealed his righteousness in the sight of the nations.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He has remembered his mercy to Jacob,","poem":1},{"lineBreak":true},{"text":"And his truth to the house of Israel;","poem":1},{"lineBreak":true},{"text":"All the ends of the earth have seen the salvation of our God.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Shout to God, all the earth;","poem":1},{"lineBreak":true},{"text":"Sing, and exult, and sing psalms.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sing to the Lord with a harp,","poem":1},{"lineBreak":true},{"text":"With a harp, and the voice of a psalm.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"With trumpets of metal, and the sound of a trumpet of horn","poem":1},{"lineBreak":true},{"text":"Make a joyful noise to the Lord before the king.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Let the sea be moved, and the fullness of it;","poem":1},{"lineBreak":true},{"text":"The world, and they that dwell in it.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The rivers shall clap their hands together;","poem":1},{"lineBreak":true},{"text":"The mountains shall exult.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"For he is come to judge the earth;","poem":1},{"lineBreak":true},{"text":"He shall judge the world in righteousness,","poem":1},{"lineBreak":true},{"text":"And the nations in uprightness.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":9}