{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":98,"content":[{"type":"verse","number":1,"content":[{"text":"A Psalm of David.","descriptive":true},{"text":"The Lord reigns—let the people rage;","poem":1},{"lineBreak":true},{"text":"It is he that sits upon the cherubs, let the earth be moved.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The Lord is great in Zion,","poem":1},{"lineBreak":true},{"text":"And is high over all the people.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let them give thanks to thy great name;","poem":1},{"lineBreak":true},{"text":"For it is terrible and holy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"And the king’s honor loves judgment;","poem":1},{"lineBreak":true},{"text":"Thou hast prepared equity,","poem":1},{"lineBreak":true},{"text":"Thou hast wrought judgment and justice in Jacob.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Exalt ye the Lord our God,","poem":1},{"lineBreak":true},{"text":"And worship at his footstool;","poem":1},{"lineBreak":true},{"text":"For he is holy.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Moses and Aaron among his priests,","poem":1},{"lineBreak":true},{"text":"And Samuel among them that call upon his name;","poem":1},{"lineBreak":true},{"text":"They called upon the Lord, and he heard them.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He spoke to them in a pillar of cloud;","poem":1},{"lineBreak":true},{"text":"They kept his testimonies,","poem":1},{"lineBreak":true},{"text":"And the ordinances which he gave them.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O Lord our God, thou heardest them;","poem":1},{"lineBreak":true},{"text":"O God, thou becamest propitious to them,","poem":1},{"lineBreak":true},{"text":"Though thou didst take vengeance on all their devices.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Exalt ye the Lord our God,","poem":1},{"lineBreak":true},{"text":"And worship at his holy mountain;","poem":1},{"lineBreak":true},{"text":"For the Lord our God is holy.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}