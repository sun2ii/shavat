{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_boy","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":151,"sha256":"339379ae7081f8476c42cff0afd7b85153f51a8a34b00562244b6bbd22e8c280","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_boy/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"A Psalm for Thanksgiving.","descriptive":true},{"text":"Make a joyful noise to the Lord, all the earth.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Serve the Lord with gladness;","poem":1},{"lineBreak":true},{"text":"Come before his presence with exultation.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Know that the Lord he is God;","poem":1},{"lineBreak":true},{"text":"He made us, and not we ourselves;","poem":1},{"lineBreak":true},{"text":"We are his people, and the sheep of his pasture.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Enter into his gates with thanksgiving,","poem":1},{"lineBreak":true},{"text":"And his courts with hymns;","poem":1},{"lineBreak":true},{"text":"Give thanks to him, praise his name.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For the Lord is good, his mercy is forever;","poem":1},{"lineBreak":true},{"text":"And his truth endures to generation and generation.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":5}