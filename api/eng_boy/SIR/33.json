{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"SIR","translationId":"eng_boy","name":"Sirach","commonName":"Sirach","title":"Wisdom of the Son of Sirach (Ecclesiasticus)","order":71,"numberOfChapters":51,"isApocryphal":true,"sha256":"9f3e32a13845049a9098a32485de45152ffe057201af4e6e194fa618ea0e1ff5","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/SIR/1.json","lastChapterNumber":51,"lastChapterApiLink":"/api/eng_boy/SIR/51.json","totalNumberOfVerses":1368},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"Have mercy upon us, O Lord God of all, and behold us:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"And send thy fear upon all the nations that seek not after thee.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lift up thy hand against the strange nations,","poem":1},{"lineBreak":true},{"text":"And let them see thy power.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"As thou wast sanctified in us before them:","poem":1},{"lineBreak":true},{"text":"So be thou magnified among them before us.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"And let them know thee, as we have known thee,","poem":1},{"lineBreak":true},{"text":"That there is no God but only thou, O God.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Show new signs, and make other strange wonders:","poem":1},{"lineBreak":true},{"text":"Glorify thy hand and thy right arm,","poem":1},{"lineBreak":true},{"text":"That they may set forth thy wondrous works.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Raise up indignation, and pour out wrath:","poem":1},{"lineBreak":true},{"text":"Take away the adversary, and destroy the enemy.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Make the time short, remember the covenant,","poem":1},{"lineBreak":true},{"text":"And let them declare thy wonderful works.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Let him that escapeth be consumed by the rage of the fire;","poem":1},{"lineBreak":true},{"text":"And let them perish that oppress the people.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Smite in sunder the heads of the rulers of the heathen,","poem":1},{"lineBreak":true},{"text":"That say, There is none other but we.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gather all the tribes of Jacob together.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"A cheerful and good heart will have a care of his meat and diet.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/SIR/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/SIR/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/SIR/32.json","previousChapterAudioLinks":{},"numberOfVerses":12}