{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"SNG","translationId":"eng_boy","name":"Song of Solomon","commonName":"Song of Songs","title":"Song of Solomon","order":22,"numberOfChapters":8,"sha256":"1b765c46f8c2d9d87aa223b30bd6d34269239765e34ed5de496ae44edd861dac","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/eng_boy/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Whither is thy kinsman gone,","poem":1},{"lineBreak":true},{"text":"Thou beautiful among women?","poem":1},{"lineBreak":true},{"text":"Whither has thy kinsman turned aside?","poem":1},{"lineBreak":true},{"text":"Tell us, and we will seek him with thee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"My kinsman is gone down to his garden, to the beds of spice,","poem":1},{"lineBreak":true},{"text":"To feed his flock in the gardens, and to gather lilies.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I am my kinsman’s, and my kinsman is mine,","poem":1},{"lineBreak":true},{"text":"Who feeds among the lilies.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Thou art fair, my companion, as Pleasure,","poem":1},{"lineBreak":true},{"text":"Beautiful as Jerusalem,","poem":1},{"lineBreak":true},{"text":"Terrible as armies set in array.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Turn away thine eyes from before me,","poem":1},{"lineBreak":true},{"text":"For they have ravished me:","poem":1},{"lineBreak":true},{"text":"Thy hair is as flocks of goats","poem":1},{"lineBreak":true},{"text":"Which have appeared from Gilead.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Thy teeth are as flocks of shorn sheep,","poem":1},{"lineBreak":true},{"text":"That have gone up from the washing,","poem":1},{"lineBreak":true},{"text":"All of them bearing twins,","poem":1},{"lineBreak":true},{"text":"And there is none barren among them:","poem":1},{"lineBreak":true},{"text":"Thy lips are as a thread of scarlet,","poem":1},{"lineBreak":true},{"text":"And thy speech is comely.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Thy cheek is like the rind of a pomegranate,","poem":1},{"lineBreak":true},{"text":"Being seen without thy veil.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"There are sixty queens, and eighty concubines,","poem":1},{"lineBreak":true},{"text":"And maidens without number.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"My dove, my perfect one is one;","poem":1},{"lineBreak":true},{"text":"She is the only one of her mother;","poem":1},{"lineBreak":true},{"text":"She is the choice of her that bore her.","poem":1},{"lineBreak":true},{"text":"The daughters saw her, and the queens will pronounce her blessed,","poem":1},{"lineBreak":true},{"text":"Yea, and the concubines, and they will praise her.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Who is this that looks forth as the morning,","poem":1},{"lineBreak":true},{"text":"Fair as the moon, choice as the sun,","poem":1},{"lineBreak":true},{"text":"Terrible as armies set in array?","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"I went down to the garden of nuts,","poem":1},{"lineBreak":true},{"text":"To look at the fruits of the valley,","poem":1},{"lineBreak":true},{"text":"To see if the vine flowered,","poem":1},{"lineBreak":true},{"text":"If the pomegranates blossomed.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"There I will give thee my breasts:","poem":1},{"lineBreak":true},{"text":"My soul knew it not:","poem":1},{"lineBreak":true},{"text":"It made me as the chariots of Amminadab.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":12}