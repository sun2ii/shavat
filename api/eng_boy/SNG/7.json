{"translation":{"id":"eng_boy","name":"Updated Brenton English Septuagint","website":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseUrl":"https://ebible.org/Scriptures/details.php?id=englxxup","licenseNotes":null,"shortName":"UBES","englishName":"Updated Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"90e1ffd456b4337f27adf5683ef8f6ed901401db61f112766e46d25412646aa2","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_boy/books.json","numberOfBooks":36,"totalNumberOfChapters":908,"totalNumberOfVerses":22561,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"SNG","translationId":"eng_boy","name":"Song of Solomon","commonName":"Song of Songs","title":"Song of Solomon","order":22,"numberOfChapters":8,"sha256":"1b765c46f8c2d9d87aa223b30bd6d34269239765e34ed5de496ae44edd861dac","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_boy/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/eng_boy/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Return, return, O Shulammite;","poem":1},{"lineBreak":true},{"text":"Return, return, and we will look at thee.","poem":1},{"lineBreak":true},{"text":"What will ye see in the Shulammite?","poem":1},{"lineBreak":true},{"text":"She comes as bands of armies.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Thy steps are beautiful in shoes,","poem":1},{"lineBreak":true},{"text":"O daughter of the prince:","poem":1},{"lineBreak":true},{"text":"The joints of thy thighs are like chains,","poem":1},{"lineBreak":true},{"text":"The work of the craftsman.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Thy navel is as a turned bowl,","poem":1},{"lineBreak":true},{"text":"Not wanting liquor;","poem":1},{"lineBreak":true},{"text":"Thy belly is as a heap of wheat","poem":1},{"lineBreak":true},{"text":"Set about with lilies.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Thy two breasts are as two twin fawns.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Thy neck is as an ivory tower;","poem":1},{"lineBreak":true},{"text":"Thine eyes are as pools in Heshbon,","poem":1},{"lineBreak":true},{"text":"By the gates of the daughter of many:","poem":1},{"lineBreak":true},{"text":"Thy nose is as the tower of Lebanon,","poem":1},{"lineBreak":true},{"text":"Looking toward Damascus.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Thy head upon thee is as Carmel,","poem":1},{"lineBreak":true},{"text":"And the curls of thy hair like scarlet;","poem":1},{"lineBreak":true},{"text":"The king is bound in the galleries.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"How beautiful art thou,","poem":1},{"lineBreak":true},{"text":"And how sweet art thou, my love!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"This is thy greatness in thy delights:","poem":1},{"lineBreak":true},{"text":"Thou wast made like a palm tree,","poem":1},{"lineBreak":true},{"text":"And thy breasts to clusters.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I said, I will go up to the palm tree,","poem":1},{"lineBreak":true},{"text":"I will take hold of its high boughs:","poem":1},{"lineBreak":true},{"text":"And now shall thy breasts be as clusters of the vine,","poem":1},{"lineBreak":true},{"text":"And the smell of thy nose as apples;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"And thy throat as good wine,","poem":1},{"lineBreak":true},{"text":"Going well with my kinsman,","poem":1},{"lineBreak":true},{"text":"Suiting my lips and teeth.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"I am my kinsman’s,","poem":1},{"lineBreak":true},{"text":"And his desire is toward me.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Come, my kinsman, let us go forth into the field;","poem":1},{"lineBreak":true},{"text":"Let us lodge in the villages.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Let us go early into the vineyards;","poem":1},{"lineBreak":true},{"text":"Let us see if the vine has flowered,","poem":1},{"lineBreak":true},{"text":"If the blossoms have appeared,","poem":1},{"lineBreak":true},{"text":"If the pomegranates have blossomed;","poem":1},{"lineBreak":true},{"text":"There will I give thee my breasts.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"The mandrakes have given a smell,","poem":1},{"lineBreak":true},{"text":"And at our doors are all kinds of choice fruits, new and old.","poem":1},{"lineBreak":true},{"text":"O my kinsman, I have kept them for thee.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/eng_boy/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_boy/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_boy/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":14}