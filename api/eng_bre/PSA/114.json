ully with thee."]},{"type":"verse","number":8,"content":["For he has delivered my soul from death, mine eyes from tears, and my feet from falling."]},{"type":"verse","number":9,"content":["I shall be well-pleasing before the Lord in the land of the living."]}],"footnotes":[{"noteId":215,"caller":"+","text":"Gr. infants.","reference":{"chapter":114,"verse":6}}]},"thisChapterLink":"/api/eng_bre/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_bre/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_bre/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":9}