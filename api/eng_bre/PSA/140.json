{"translation":{"id":"eng_bre","name":"Brenton Septuagint Translation","website":"https://ebible.org/Scriptures/details.php?id=eng-Brenton","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-Brenton","licenseNotes":null,"shortName":"BST","englishName":"Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"05f7b65a30cf50c68aff519723e7a3fcbc811b2a91989518ee63034e9aab95a8","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_bre/books.json","numberOfBooks":37,"totalNumberOfChapters":921,"totalNumberOfVerses":22971,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_bre","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"5a64b8d2190c60fbe8380a76a9a600bb78fc0a6aa8adb5dfa5e4d75c0fd4f1e9","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_bre/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_bre/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":140,"content":[{"type":"verse","number":1,"content":[{"text":"A Psalm of David.","descriptive":true},"O Lord, I have cried to thee; hear me: attend to the voice of my supplication, when I cry to thee."]},{"type":"verse","number":2,"content":["Let my prayer be set forth before thee as incense; the lifting up of my hands as an evening sacrifice."]},{"type":"verse","number":3,"content":["Set a watch, O Lord, on my mouth, and a",{"noteId":249},"strong door about my lips."]},{"type":"verse","number":4,"content":["Incline not my heart to evil things, to",{"noteId":250},"employ pretexts",{"noteId":251},"for sins, with men who work iniquity: and",{"noteId":252},"let me not unite with their choice ones."]},{"type":"verse","number":5,"content":["The righteous shall chasten me with mercy, and reprove me: but let not the oil of the sinner anoint my head: for yet shall my prayer also be in their",{"noteId":253},"pleasures."]},{"type":"verse","number":6,"content":["Their mighty ones have been swallowed up near the rock: they shall hear my words, for they are sweet."]},{"type":"verse","number":7,"content":["As a lump of earth is crushed upon the ground, our bones have been scattered by the mouth of the grave."]},{"type":"verse","number":8,"content":["For mine eyes are to thee, O Lord God: I have hoped in thee; take not away my life."]},{"type":"verse","number":9,"content":["Keep me from the snare which they have set for me, and from the stumbling-blocks of them that work iniquity."]},{"type":"verse","number":10,"content":["Sinners shall fall by their own net: I am alone until I shall escape."]}],"footnotes":[{"noteId":249,"caller":"+","text":"Lit. a door of fortification.","reference":{"chapter":140,"verse":3}},{"noteId":250,"caller":"+","text":"Gr. pretend pretences.","reference":{"chapter":140,"verse":4}},{"noteId":251,"caller":"+","text":"Gr. in.","reference":{"chapter":140,"verse":4}},{"noteId":252,"caller":"+","text":"Gr. I will not.","reference":{"chapter":140,"verse":4}},{"noteId":253,"caller":"+","text":"q. d. lest I be injured by them.","reference":{"chapter":140,"verse":5}}]},"thisChapterLink":"/api/eng_bre/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_bre/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_bre/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":10}