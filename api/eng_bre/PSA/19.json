{"translation":{"id":"eng_bre","name":"Brenton Septuagint Translation","website":"https://ebible.org/Scriptures/details.php?id=eng-Brenton","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-Brenton","licenseNotes":null,"shortName":"BST","englishName":"Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"05f7b65a30cf50c68aff519723e7a3fcbc811b2a91989518ee63034e9aab95a8","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_bre/books.json","numberOfBooks":37,"totalNumberOfChapters":921,"totalNumberOfVerses":22971,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_bre","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"5a64b8d2190c60fbe8380a76a9a600bb78fc0a6aa8adb5dfa5e4d75c0fd4f1e9","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_bre/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_bre/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"For the end, a Psalm of David.","descriptive":true}]},{"type":"verse","number":2,"content":["The Lord hear thee in the day of trouble; the name of the God of Jacob defend thee."]},{"type":"verse","number":3,"content":["Send thee help from the sanctuary, and aid thee out of Sion."]},{"type":"verse","number":4,"content":["Remember all thy",{"noteId":38},"sacrifice, and enrich thy whole-burnt-offering. Pause."]},{"type":"verse","number":5,"content":["Grant thee according to thy heart, and fulfil all thy desire."]},{"type":"verse","number":6,"content":["We will exult in thy salvation, and in the name of our God shall we be magnified: the Lord fulfil all thy petitions."]},{"type":"verse","number":7,"content":["Now I know that the Lord has saved his Christ: he shall hear him from his holy heaven: the salvation of his right hand is mighty."]},{"type":"verse","number":8,"content":["Some glory in chariots, and some in horses: but we will",{"noteId":39},"glory in the name of the Lord our God."]},{"type":"verse","number":9,"content":["They are overthrown and fallen: but we are risen, and have been set upright."]},{"type":"verse","number":10,"content":["O Lord, save the king: and hear us in whatever day we call upon thee."]}],"footnotes":[{"noteId":38,"caller":"+","text":"Or, meat offering.","reference":{"chapter":19,"verse":4}},{"noteId":39,"caller":"+","text":"Gr. be magnified.","reference":{"chapter":19,"verse":8}}]},"thisChapterLink":"/api/eng_bre/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_bre/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_bre/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":10}