{"translation":{"id":"eng_bre","name":"Brenton Septuagint Translation","website":"https://ebible.org/Scriptures/details.php?id=eng-Brenton","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-Brenton","licenseNotes":null,"shortName":"BST","englishName":"Brenton English Septuagint","language":"eng","textDirection":"ltr","sha256":"05f7b65a30cf50c68aff519723e7a3fcbc811b2a91989518ee63034e9aab95a8","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_bre/books.json","numberOfBooks":37,"totalNumberOfChapters":921,"totalNumberOfVerses":22971,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":16,"totalNumberOfApocryphalChapters":196,"totalNumberOfApocryphalVerses":6034},"book":{"id":"PSA","translationId":"eng_bre","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"5a64b8d2190c60fbe8380a76a9a600bb78fc0a6aa8adb5dfa5e4d75c0fd4f1e9","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_bre/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_bre/PSA/151.json","totalNumberOfVerses":2535},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":[{"text":"A Psalm of David.","descriptive":true},"Judge me, O Lord; for I have walked in my innocence: and hoping in the Lord I shall not be moved."]},{"type":"verse","number":2,"content":["Prove me, O Lord, and try me; purify as with fire my reins and my heart."]},{"type":"verse","number":3,"content":["For thy mercy is before mine eyes: and I am well pleased with thy truth."]},{"type":"verse","number":4,"content":["I have not sat with the council of vanity, and will in nowise enter in with transgressors."]},{"type":"verse","number":5,"content":["I have hated the assembly of wicked doers; and will not sit with ungodly men."]},{"type":"verse","number":6,"content":["I will wash my hands in",{"noteId":45},"innocency, and compass thine altar, O Lord:"]},{"type":"verse","number":7,"content":["to hear the voice of praise, and to declare all thy wonderful works."]},{"type":"verse","number":8,"content":["O Lord, I have loved the beauty of thy house, and the place of the tabernacle of thy glory."]},{"type":"verse","number":9,"content":["Destroy not my soul together with the ungodly, nor my life with bloody men:"]},{"type":"verse","number":10,"content":["in whose hands are iniquities, and their right hand is filled with bribes."]},{"type":"verse","number":11,"content":["But I have walked in my innocence: redeem me, and have mercy upon me."]},{"type":"verse","number":12,"content":["My foot stands in",{"noteId":46},"an even place: in the congregations will I bless thee, O Lord."]}],"footnotes":[{"noteId":45,"caller":"+","text":"Gr. innocent things.","reference":{"chapter":25,"verse":6}},{"noteId":46,"caller":"+","text":"Gr. in evenness or uprightness.","reference":{"chapter":25,"verse":12}}]},"thisChapterLink":"/api/eng_bre/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_bre/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_bre/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":12}