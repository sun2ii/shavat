r":8,"content":["I will willingly sacrifice to thee: I will give thanks to thy name, O Lord; for it is good."]},{"type":"verse","number":9,"content":["For thou hast delivered me out of all affliction, and mine eye has seen my desire upon mine enemies."]}],"footnotes":[]},"thisChapterLink":"/api/eng_bre/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_bre/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_bre/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":9}