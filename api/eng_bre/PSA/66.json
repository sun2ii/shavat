r God, bless us."]},{"type":"verse","number":8,"content":["Let God bless us; and let all the ends of the earth fear him."]}],"footnotes":[]},"thisChapterLink":"/api/eng_bre/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_bre/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_bre/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":8}