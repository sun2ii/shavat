inces."]},{"type":"verse","number":8,"content":["Arise, O God, judge the earth: for thou shalt inherit all nations."]}],"footnotes":[{"noteId":154,"caller":"+","text":"Gr. justify.","reference":{"chapter":81,"verse":3}}]},"thisChapterLink":"/api/eng_bre/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_bre/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_bre/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":8}