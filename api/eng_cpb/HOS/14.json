{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"HOS","translationId":"eng_cpb","name":"Hosea","commonName":"Hosea","title":"HOSEA.","order":28,"numberOfChapters":14,"sha256":"74c1b073404b02c9f0afbd7845d7fcef4f0a57e9acebb06a52e8c0a5594e023e","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/eng_cpb/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"O Israel, return unto the Lord thy God;","poem":1},{"lineBreak":true},{"text":"For thou hast fallen by thine iniquity.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Take with you words, and turn to the Lord:","poem":1},{"lineBreak":true},{"text":"Say unto him, Take away all iniquity, and receive us graciously:","poem":1},{"lineBreak":true},{"text":"So will we render the calves of our lips.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Asshur shall not save us: we will not ride upon horses:","poem":1},{"lineBreak":true},{"text":"Neither will we say any more to the work of our hands, Ye are our gods:","poem":1},{"lineBreak":true},{"text":"For in thee the fatherless findeth mercy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I will heal their backsliding, I will love them freely:","poem":1},{"lineBreak":true},{"text":"For mine anger is turned away from him.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I will be as the dew unto Israel:","poem":1},{"lineBreak":true},{"text":"He shall grow as the lily,","poem":1},{"lineBreak":true},{"text":"And cast forth his roots as Lebanon.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"His branches shall spread,","poem":1},{"lineBreak":true},{"text":"And his beauty shall be as the olive tree,","poem":1},{"lineBreak":true},{"text":"And his smell as Lebanon.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"They that dwell under his shadow shall return;","poem":1},{"lineBreak":true},{"text":"They shall revive as the corn, and grow as the vine:","poem":1},{"lineBreak":true},{"text":"The sent thereof shall be as the wine of Lebanon.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ephraim shall say, What have I to do any more with idols?","poem":1},{"lineBreak":true},{"text":"I have heard him, and observed him:","poem":1},{"lineBreak":true},{"text":"I am like a green fir tree.","poem":1},{"lineBreak":true},{"text":"From me is thy fruit found.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Who is wise, and he shall understand these things?","poem":1},{"lineBreak":true},{"text":"Prudent, and he shall know them?","poem":1},{"lineBreak":true},{"text":"For the ways of the Lord are right,","poem":1},{"lineBreak":true},{"text":"And the just shall walk in them:","poem":1},{"lineBreak":true},{"text":"But the transgressors shall fall therein.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}