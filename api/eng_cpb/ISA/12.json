{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"ISA","translationId":"eng_cpb","name":"Isaiah","commonName":"Isaiah","title":"THE BOOK OF THE PROPHET ISAIAH.","order":23,"numberOfChapters":66,"sha256":"d374d20ce90f1c346a311f70be0e44320d42f4c845cd0f911029d816b565d294","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/eng_cpb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"And in that day thou shalt say,","poem":1},{"lineBreak":true},{"text":"O Lord, I will praise thee: though thou wast angry with me,","poem":1},{"lineBreak":true},{"text":"Thine anger is turned away, and thou comfortedst me.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Behold, God is my salvation;","poem":1},{"lineBreak":true},{"text":"I will trust, and not be afraid:","poem":1},{"lineBreak":true},{"text":"For the Lord JEHOVAH is my strength and my song;","poem":1},{"lineBreak":true},{"text":"He also is become my salvation.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Therefore with joy shall ye draw water out of the wells of salvation.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"And in that day shall ye say,","poem":1},{"lineBreak":true},{"text":"Praise the Lord, call upon his name,","poem":1},{"lineBreak":true},{"text":"Declare his doings among the people,","poem":1},{"lineBreak":true},{"text":"Make mention that his name is exalted.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sing unto the Lord; for he hath done excellent things:","poem":1},{"lineBreak":true},{"text":"This is known in all the earth.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Cry out and shout, thou inhabitant of Zion:","poem":1},{"lineBreak":true},{"text":"For great is the Holy One of Israel in the midst of thee.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}