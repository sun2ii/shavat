{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"ISA","translationId":"eng_cpb","name":"Isaiah","commonName":"Isaiah","title":"THE BOOK OF THE PROPHET ISAIAH.","order":23,"numberOfChapters":66,"sha256":"d374d20ce90f1c346a311f70be0e44320d42f4c845cd0f911029d816b565d294","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/eng_cpb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":["In the year that Tartan came unto Ashdod, (when Sargon the king of Assyria sent him,) and fought against Ashdod, and took it;"]},{"type":"verse","number":2,"content":["at the same time spake the Lord by Isaiah the son of Amoz, saying,",{"text":"Go and loose the sackcloth from off thy loins,","poem":1},{"lineBreak":true},{"text":"And put off thy shoe from thy foot.","poem":1},"And he did so, walking naked and barefoot."]},{"type":"verse","number":3,"content":["And the Lord said,",{"text":"Like as my servant Isaiah hath walked naked and barefoot","poem":1},{"lineBreak":true},{"text":"Three years for a sign and wonder","poem":1},{"lineBreak":true},{"text":"Upon Egypt and upon Ethiopia;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"So shall the king of Assyria lead away the Egyptians prisoners, and the Ethiopians captives,","poem":1},{"lineBreak":true},{"text":"Young and old, naked and barefoot,","poem":1},{"lineBreak":true},{"text":"Even with their buttocks uncovered,","poem":1},{"lineBreak":true},{"text":"To the shame of Egypt.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"And they shall be afraid and ashamed of Ethiopia their expectation,","poem":1},{"lineBreak":true},{"text":"And of Egypt their glory.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"And the inhabitant of this isle shall say in that day,","poem":1},{"lineBreak":true},{"text":"Behold, such is our expectation,","poem":1},{"lineBreak":true},{"text":"Whither we flee for help","poem":1},{"lineBreak":true},{"text":"To be delivered from the king of Assyria:","poem":1},{"lineBreak":true},{"text":"And how shall we escape?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/ISA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/ISA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/ISA/19.json","previousChapterAudioLinks":{},"numberOfVerses":6}