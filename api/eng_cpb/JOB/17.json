{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"JOB","translationId":"eng_cpb","name":"Job","commonName":"Job","title":"THE BOOK OF JOB.","order":18,"numberOfChapters":42,"sha256":"aeb57ceaa0cd735e735705abe6800e7698c6d631ed4333b33ce7e58c63820c96","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/eng_cpb/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"My breath is corrupt,","poem":1},{"lineBreak":true},{"text":"My days are extinct,","poem":1},{"lineBreak":true},{"text":"The graves are ready for me.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Are there not mockers with me?","poem":1},{"lineBreak":true},{"text":"And doth not mine eye continue in their provocation?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Lay down now, put me in a surety with thee;","poem":1},{"lineBreak":true},{"text":"Who is he that will strike hands with me?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For thou hast hid their heart from understanding:","poem":1},{"lineBreak":true},{"text":"Therefore shalt thou not exalt them.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"He that speaketh flattery to his friends,","poem":1},{"lineBreak":true},{"text":"Even the eyes of his children shall fail.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"He hath made me also a byword of the people;","poem":1},{"lineBreak":true},{"text":"And aforetime I was as a tabret.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mine eye also is dim by reason of sorrow,","poem":1},{"lineBreak":true},{"text":"And all my members are as a shadow.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Upright men shall be astonied at this,","poem":1},{"lineBreak":true},{"text":"And the innocent shall stir up himself against the hypocrite.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The righteous also shall hold on his way,","poem":1},{"lineBreak":true},{"text":"And he that hath clean hands shall be stronger and stronger.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"But as for you all, do you return, and come now:","poem":1},{"lineBreak":true},{"text":"For I cannot find one wise man among you.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"My days are past,","poem":1},{"lineBreak":true},{"text":"My purposes are broken off,","poem":1},{"lineBreak":true},{"text":"Even the thoughts of my heart.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"They change the night into day:","poem":1},{"lineBreak":true},{"text":"The light is short, because of darkness.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"If I wait, the grave is mine house:","poem":1},{"lineBreak":true},{"text":"I have made my bed in the darkness.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"I have said to corruption, Thou art my father:","poem":1},{"lineBreak":true},{"text":"To the worm, Thou art my mother, and my sister.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"And where is now my hope?","poem":1},{"lineBreak":true},{"text":"As for my hope, who shall see it?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"They shall go down to the bars of the pit,","poem":1},{"lineBreak":true},{"text":"When our rest together is in the dust.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}