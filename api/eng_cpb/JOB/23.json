{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"JOB","translationId":"eng_cpb","name":"Job","commonName":"Job","title":"THE BOOK OF JOB.","order":18,"numberOfChapters":42,"sha256":"aeb57ceaa0cd735e735705abe6800e7698c6d631ed4333b33ce7e58c63820c96","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/eng_cpb/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":["Then Job answered and said,"]},{"type":"verse","number":2,"content":[{"text":"Even to day is my complaint bitter:","poem":1},{"lineBreak":true},{"text":"My stroke is heavier than my groaning.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"O that I knew where I might find him!","poem":1},{"lineBreak":true},{"text":"That I might come even to his seat!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I would order my cause before him,","poem":1},{"lineBreak":true},{"text":"And fill my mouth with arguments.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I would know the words which he would answer me,","poem":1},{"lineBreak":true},{"text":"And understand what he would say unto me.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Will he plead against me with his great power?","poem":1},{"lineBreak":true},{"text":"No; but he would put strength in me.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"There the righteous might dispute with him;","poem":1},{"lineBreak":true},{"text":"So should I be delivered for ever from my judge.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Behold, I go forward, but he is not there;","poem":1},{"lineBreak":true},{"text":"And backward, but I cannot perceive him:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"On the left hand, where he doth work, but I cannot behold him:","poem":1},{"lineBreak":true},{"text":"He hideth himself on the right hand, that I cannot see him:","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"But he knoweth the way that I take:","poem":1},{"lineBreak":true},{"text":"When he hath tried me, I shall come forth as gold.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"My foot hath held his steps,","poem":1},{"lineBreak":true},{"text":"His way have I kept, and not declined.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Neither have I gone back from the commandment of his lips;","poem":1},{"lineBreak":true},{"text":"I have esteemed the words of his mouth more than my necessary food.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"But he is in one mind, and who can turn him?","poem":1},{"lineBreak":true},{"text":"And what his soul desireth, even that he doeth.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"For he performeth the thing that is appointed for me:","poem":1},{"lineBreak":true},{"text":"And many such things are with him.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Therefore am I troubled at his presence:","poem":1},{"lineBreak":true},{"text":"When I consider, I am afraid of him.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"For God maketh my heart soft,","poem":1},{"lineBreak":true},{"text":"And the Almighty troubleth me:","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Because I was not cut off before the darkness,","poem":1},{"lineBreak":true},{"text":"Neither hath he covered the darkness from my face.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}