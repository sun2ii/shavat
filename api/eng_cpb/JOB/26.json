{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"JOB","translationId":"eng_cpb","name":"Job","commonName":"Job","title":"THE BOOK OF JOB.","order":18,"numberOfChapters":42,"sha256":"aeb57ceaa0cd735e735705abe6800e7698c6d631ed4333b33ce7e58c63820c96","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/eng_cpb/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":["But Job answered and said,"]},{"type":"verse","number":2,"content":[{"text":"How hast thou helped him that is without power?","poem":1},{"lineBreak":true},{"text":"How savest thou the arm that hath no strength?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"How hast thou counselled him that hath no wisdom?","poem":1},{"lineBreak":true},{"text":"And how hast thou plentifully declared the thing as it is?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"To whom hast thou uttered words?","poem":1},{"lineBreak":true},{"text":"And whose spirit came from thee?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dead things are formed","poem":1},{"lineBreak":true},{"text":"From under the waters, and the inhabitants thereof.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hell is naked before him,","poem":1},{"lineBreak":true},{"text":"And destruction hath no covering.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He stretcheth out the north over the empty place,","poem":1},{"lineBreak":true},{"text":"And hangeth the earth upon nothing.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"He bindeth up the waters in his thick clouds;","poem":1},{"lineBreak":true},{"text":"And the cloud is not rent under them.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He holdeth back the face of his throne,","poem":1},{"lineBreak":true},{"text":"And spreadeth his cloud upon it.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"He hath compassed the waters with bounds,","poem":1},{"lineBreak":true},{"text":"Until the day and night come to an end.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"The pillars of heaven tremble","poem":1},{"lineBreak":true},{"text":"And are astonished at his reproof.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"He divideth the sea with his power,","poem":1},{"lineBreak":true},{"text":"And by his understanding he smiteth through the proud.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"By his spirit he hath garnished the heavens;","poem":1},{"lineBreak":true},{"text":"His hand hath formed the crooked serpent.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Lo, these are parts of his ways:","poem":1},{"lineBreak":true},{"text":"But how little a portion is heard of him?","poem":1},{"lineBreak":true},{"text":"But the thunder of his power who can understand?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}