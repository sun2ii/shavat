{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"JOB","translationId":"eng_cpb","name":"Job","commonName":"Job","title":"THE BOOK OF JOB.","order":18,"numberOfChapters":42,"sha256":"aeb57ceaa0cd735e735705abe6800e7698c6d631ed4333b33ce7e58c63820c96","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/eng_cpb/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":["Elihu spake moreover, and said,"]},{"type":"verse","number":2,"content":[{"text":"Thinkest thou this to be right,","poem":1},{"lineBreak":true},{"text":"That thou saidst, My righteousness is more than God’s?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For thou saidst, What advantage will it be unto thee?","poem":1},{"lineBreak":true},{"text":"And, What profit shall I have, if I be cleansed from my sin?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I will answer thee,","poem":1},{"lineBreak":true},{"text":"And thy companions with thee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Look unto the heavens, and see;","poem":1},{"lineBreak":true},{"text":"And behold the clouds which are higher than thou.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"If thou sinnest, what doest thou against him?","poem":1},{"lineBreak":true},{"text":"Or if thy transgressions be multiplied, what doest thou unto him?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"If thou be righteous, what givest thou him?","poem":1},{"lineBreak":true},{"text":"Or what receiveth he of thine hand?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Thy wickedness may hurt a man as thou art;","poem":1},{"lineBreak":true},{"text":"And thy righteousness may profit the son of man.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"By reason of the multitude of oppressions they make the oppressed to cry:","poem":1},{"lineBreak":true},{"text":"They cry out by reason of the arm of the mighty.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"But none saith, Where is God my Maker,","poem":1},{"lineBreak":true},{"text":"Who giveth songs in the night;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Who teacheth us more than the beasts of the earth,","poem":1},{"lineBreak":true},{"text":"And maketh us wiser than the fowls of heaven?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"There they cry, but none giveth answer,","poem":1},{"lineBreak":true},{"text":"Because of the pride of evil men.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Surely God will not hear vanity,","poem":1},{"lineBreak":true},{"text":"Neither will the Almighty regard it.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Although thou sayest thou shalt not see him,","poem":1},{"lineBreak":true},{"text":"Yet judgment is before him; therefore trust thou in him.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"But now, because it is not so, he hath visited in his anger;","poem":1},{"lineBreak":true},{"text":"Yet he knoweth it not in great extremity:","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Therefore doth Job open his mouth in vain;","poem":1},{"lineBreak":true},{"text":"He multiplieth words without knowledge.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}