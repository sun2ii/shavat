{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"LAM","translationId":"eng_cpb","name":"Lamentations","commonName":"Lamentations","title":"THE LAMENTATIONS OF JEREMIAH.","order":25,"numberOfChapters":5,"sha256":"fb9c1e438e881b6622dba3d12b45aa37f0aaef90653637f754334b27954a8ab4","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/eng_cpb/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Remember, O Lord, what is come upon us:","poem":1},{"lineBreak":true},{"text":"Consider, and behold our reproach.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Our inheritance is turned to strangers,","poem":1},{"lineBreak":true},{"text":"Our houses to aliens.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"We are orphans and fatherless,","poem":1},{"lineBreak":true},{"text":"Our mothers are as widows.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"We have drunken our water for money;","poem":1},{"lineBreak":true},{"text":"Our wood is sold unto us.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Our necks are under persecution:","poem":1},{"lineBreak":true},{"text":"We labour, and have no rest.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"We have given the hand to the Egyptians,","poem":1},{"lineBreak":true},{"text":"And to the Assyrians, to be satisfied with bread.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Our fathers have sinned, and are not;","poem":1},{"lineBreak":true},{"text":"And we have borne their iniquities.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Servants have ruled over us:","poem":1},{"lineBreak":true},{"text":"There is none that doth deliver us out of their hand.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"We gat our bread with the peril of our lives","poem":1},{"lineBreak":true},{"text":"Because of the sword of the wilderness.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Our skin was black like an oven","poem":1},{"lineBreak":true},{"text":"Because of the terrible famine.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"They ravished the women in Zion,","poem":1},{"lineBreak":true},{"text":"And the maids in the cities of Judah.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Princes are hanged up by their hand:","poem":1},{"lineBreak":true},{"text":"The faces of elders were not honoured.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"They took the young men to grind,","poem":1},{"lineBreak":true},{"text":"And the children fell under the wood.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"The elders have ceased from the gate,","poem":1},{"lineBreak":true},{"text":"The young men from their musick.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"The joy of our heart is ceased;","poem":1},{"lineBreak":true},{"text":"Our dance is turned into mourning.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"The crown is fallen from our head:","poem":1},{"lineBreak":true},{"text":"Woe unto us, that we have sinned!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"For this our heart is faint;","poem":1},{"lineBreak":true},{"text":"For these things our eyes are dim.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Because of the mountain of Zion, which is desolate,","poem":1},{"lineBreak":true},{"text":"The foxes walk upon it.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Thou, O Lord, remainest for ever;","poem":1},{"lineBreak":true},{"text":"Thy throne from generation to generation.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Wherefore dost thou forget us for ever,","poem":1},{"lineBreak":true},{"text":"And forsake us so long time?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Turn thou us unto thee, O Lord, and we shall be turned;","poem":1},{"lineBreak":true},{"text":"Renew our days as of old.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"But thou hast utterly rejected us;","poem":1},{"lineBreak":true},{"text":"Thou art very wroth against us.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}