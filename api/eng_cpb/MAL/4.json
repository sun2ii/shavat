{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"MAL","translationId":"eng_cpb","name":"Malachi","commonName":"Malachi","title":"MALACHI.","order":39,"numberOfChapters":4,"sha256":"1ae810a57310b78f2294f9d07860d899a8a929be9f071f4a21a84421c07078a1","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/MAL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/eng_cpb/MAL/4.json","totalNumberOfVerses":55},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"For behold, the day cometh, that shall burn as an oven;","poem":1},{"lineBreak":true},{"text":"And all the proud, yea, and all that do wickedly, shall be stubble:","poem":1},{"lineBreak":true},{"text":"And the day that cometh shall burn them up, saith the Lord of hosts,","poem":1},{"lineBreak":true},{"text":"That it shall leave them neither root nor branch.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"But unto you that fear my name shall the Sun of righteousness arise","poem":1},{"lineBreak":true},{"text":"With healing in his wings;","poem":1},{"lineBreak":true},{"text":"And ye shall go forth, and grow up as calves of the stall.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"And ye shall tread down the wicked;","poem":1},{"lineBreak":true},{"text":"For they shall be ashes under the soles of your feet","poem":1},{"lineBreak":true},{"text":"In the day that I shall do this, saith the Lord of hosts.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Remember ye the law of Moses my servant,","poem":1},{"lineBreak":true},{"text":"Which I commanded unto him in Horeb for all Israel,","poem":1},{"lineBreak":true},{"text":"With the statutes and judgments.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Behold, I will send you Elijah the prophet","poem":1},{"lineBreak":true},{"text":"Before the coming of the great and dreadful day of the Lord:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"And he shall turn the heart of the fathers to the children,","poem":1},{"lineBreak":true},{"text":"And the heart of the children to their fathers,","poem":1},{"lineBreak":true},{"text":"Lest I come and smite the earth with a curse.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/MAL/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/MAT/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/MAL/3.json","previousChapterAudioLinks":{},"numberOfVerses":6}