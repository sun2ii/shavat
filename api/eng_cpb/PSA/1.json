{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Blessed is the man","poem":1},{"lineBreak":true},{"text":"That walketh not in the counsel of the ungodly,","poem":1},{"lineBreak":true},{"text":"Nor standeth in the way of sinners,","poem":1},{"lineBreak":true},{"text":"Nor sitteth in the seat of the scornful.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"But his delight is in the law of the Lord;","poem":1},{"lineBreak":true},{"text":"And in his law doth he meditate day and night.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"And he shall be like a tree planted by the rivers of water,","poem":1},{"lineBreak":true},{"text":"That bringeth forth his fruit in his season;","poem":1},{"lineBreak":true},{"text":"His leaf also shall not wither;","poem":1},{"lineBreak":true},{"text":"And whatsoever he doeth shall prosper.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The ungodly are not so:","poem":1},{"lineBreak":true},{"text":"But are like the chaff which the wind driveth away.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Therefore the ungodly shall not stand in the judgment,","poem":1},{"lineBreak":true},{"text":"Nor sinners in the congregation of the righteous.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"For the Lord knoweth the way of the righteous:","poem":1},{"lineBreak":true},{"text":"But the way of the ungodly shall perish.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}