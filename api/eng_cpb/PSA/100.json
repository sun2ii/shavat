text":"Be thankful unto him, and bless his name.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For the Lord is good; his mercy is everlasting;","poem":1},{"lineBreak":true},{"text":"And his truth endureth to all generations.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}