{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"I will sing of mercy and judgment: unto thee, O Lord, will I sing.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I will behave myself wisely in a perfect way. O when wilt thou come unto me?","poem":1},{"lineBreak":true},{"text":"I will walk within my house with a perfect heart.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I will set no wicked thing before mine eyes:","poem":1},{"lineBreak":true},{"text":"I hate the work of them that turn aside; it shall not cleave to me.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A froward heart shall depart from me: I will not know a wicked person.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Whoso privily slandereth his neighbour, him will I cut off:","poem":1},{"lineBreak":true},{"text":"Him that hath a high look and a proud heart will not I suffer.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mine eyes shall be upon the faithful of the land, that they may dwell with me:","poem":1},{"lineBreak":true},{"text":"He that walketh in a perfect way, he shall serve me.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He that worketh deceit shall not dwell within my house:","poem":1},{"lineBreak":true},{"text":"He that telleth lies shall not tarry in my sight.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I will early destroy all the wicked of the land;","poem":1},{"lineBreak":true},{"text":"That I may cut off all wicked doers from the city of the Lord.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}