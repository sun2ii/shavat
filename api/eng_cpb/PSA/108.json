{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":108,"content":[{"type":"hebrew_subtitle","content":["A Song or Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"O God, my heart is fixed;","poem":1},{"lineBreak":true},{"text":"I will sing and give praise,","poem":1},{"lineBreak":true},{"text":"Even with my glory.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Awake, psaltery and harp:","poem":1},{"lineBreak":true},{"text":"I myself will awake early.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I will praise thee, O Lord, among the people:","poem":1},{"lineBreak":true},{"text":"And I will sing praises unto thee among the nations.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For thy mercy is great above the heavens:","poem":1},{"lineBreak":true},{"text":"And thy truth reacheth unto the clouds.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Be thou exalted, O God, above the heavens:","poem":1},{"lineBreak":true},{"text":"And thy glory above all the earth.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"That thy beloved may be delivered;","poem":1},{"lineBreak":true},{"text":"Save with thy right hand, and answer me.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"God hath spoken in his holiness;","poem":1},{"lineBreak":true},{"text":"I will rejoice, I will divide Shechem,","poem":1},{"lineBreak":true},{"text":"And mete out the valley of Succoth.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gilead is mine; Manasseh is mine;","poem":1},{"lineBreak":true},{"text":"Ephraim also is the strength of mine head;","poem":1},{"lineBreak":true},{"text":"Judah is my lawgiver;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Moab is my washpot;","poem":1},{"lineBreak":true},{"text":"Over Edom will I cast out my shoe;","poem":1},{"lineBreak":true},{"text":"Over Philistia will I triumph.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Who will bring me into the strong city?","poem":1},{"lineBreak":true},{"text":"Who will lead me into Edom?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wilt not thou, O God, who hast cast us off?","poem":1},{"lineBreak":true},{"text":"And wilt not thou, O God, go forth with our hosts?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Give us help from trouble:","poem":1},{"lineBreak":true},{"text":"For vain is the help of man.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Through God we shall do valiantly:","poem":1},{"lineBreak":true},{"text":"For he it is that shall tread down our enemies.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}