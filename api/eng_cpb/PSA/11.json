{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician, A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"In the Lord put I my trust:","poem":1},{"lineBreak":true},{"text":"How say ye to my soul,","poem":1},{"lineBreak":true},{"text":"Flee as a bird to your mountain?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For lo, the wicked bend their bow,","poem":1},{"lineBreak":true},{"text":"They make ready their arrow upon the string,","poem":1},{"lineBreak":true},{"text":"That they may privily shoot at the upright in heart.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"If the foundations be destroyed,","poem":1},{"lineBreak":true},{"text":"What can the righteous do?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The Lord is in his holy temple,","poem":1},{"lineBreak":true},{"text":"The Lord’s throne is in heaven:","poem":1},{"lineBreak":true},{"text":"His eyes behold,","poem":1},{"lineBreak":true},{"text":"His eyelids try, the children of men.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The Lord trieth the righteous:","poem":1},{"lineBreak":true},{"text":"But the wicked and him that loveth violence his soul hateth.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Upon the wicked he shall rain snares, fire and brimstone,","poem":1},{"lineBreak":true},{"text":"And a horrible tempest: this shall be the portion of their cup.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For the righteous Lord loveth righteousness;","poem":1},{"lineBreak":true},{"text":"His countenance doth behold the upright.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}