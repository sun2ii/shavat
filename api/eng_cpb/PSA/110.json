{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"The Lord said unto my Lord,","poem":1},{"lineBreak":true},{"text":"Sit thou at my right hand,","poem":1},{"lineBreak":true},{"text":"Until I make thine enemies thy footstool.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The Lord shall send the rod of thy strength out of Zion:","poem":1},{"lineBreak":true},{"text":"Rule thou in the midst of thine enemies.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Thy people shall be willing in the day of thy power, in the beauties of holiness","poem":1},{"lineBreak":true},{"text":"From the womb of the morning: thou hast the dew of thy youth.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The Lord hath sworn, and will not repent,","poem":1},{"lineBreak":true},{"text":"Thou art a priest for ever","poem":1},{"lineBreak":true},{"text":"After the order of Melchizedek.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The Lord at thy right hand","poem":1},{"lineBreak":true},{"text":"Shall strike through kings in the day of his wrath.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He shall judge among the heathen, he shall fill the places with the dead bodies;","poem":1},{"lineBreak":true},{"text":"He shall wound the heads over many countries.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He shall drink of the brook in the way:","poem":1},{"lineBreak":true},{"text":"Therefore shall he lift up the head.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}