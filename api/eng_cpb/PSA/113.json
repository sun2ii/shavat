{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Praise ye the Lord.","poem":1},{"lineBreak":true},{"text":"Praise, O ye servants of the Lord,","poem":1},{"lineBreak":true},{"text":"Praise the name of the Lord.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Blessed be the name of the Lord","poem":1},{"lineBreak":true},{"text":"From this time forth and for evermore.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"From the rising of the sun unto the going down of the same","poem":1},{"lineBreak":true},{"text":"The Lord’s name is to be praised.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The Lord is high above all nations,","poem":1},{"lineBreak":true},{"text":"And his glory above the heavens.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Who is like unto the Lord our God,","poem":1},{"lineBreak":true},{"text":"Who dwelleth on high,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Who humbleth himself to behold","poem":1},{"lineBreak":true},{"text":"The things that are in heaven, and in the earth?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He raiseth up the poor out of the dust,","poem":1},{"lineBreak":true},{"text":"And lifteth the needy out of the dunghill;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"That he may set him with princes,","poem":1},{"lineBreak":true},{"text":"Even with the princes of his people.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He maketh the barren woman to keep house,","poem":1},{"lineBreak":true},{"text":"To be a joyful mother of children.","poem":1},{"lineBreak":true},{"text":"Praise ye the Lord.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}