{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"When Israel went out of Egypt,","poem":1},{"lineBreak":true},{"text":"The house of Jacob from a people of strange language;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Judah was his sanctuary,","poem":1},{"lineBreak":true},{"text":"And Israel his dominion.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"The sea saw it, and fled:","poem":1},{"lineBreak":true},{"text":"Jordan was driven back.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The mountains skipped like rams,","poem":1},{"lineBreak":true},{"text":"And the little hills like lambs.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"What ailed thee, O thou sea, that thou fleddest?","poem":1},{"lineBreak":true},{"text":"Thou Jordan, that thou wast driven back?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ye mountains, that ye skipped like rams;","poem":1},{"lineBreak":true},{"text":"And ye little hills, like lambs?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tremble, thou earth, at the presence of the Lord,","poem":1},{"lineBreak":true},{"text":"At the presence of the God of Jacob;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Which turned the rock into a standing water,","poem":1},{"lineBreak":true},{"text":"The flint into a fountain of waters.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}