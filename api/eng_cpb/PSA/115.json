{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"Not unto us, O Lord, not unto us,","poem":1},{"lineBreak":true},{"text":"But unto thy name give glory,","poem":1},{"lineBreak":true},{"text":"For thy mercy, and for thy truth’s sake.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wherefore should the heathen say,","poem":1},{"lineBreak":true},{"text":"Where is now their God?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"But our God is in the heavens:","poem":1},{"lineBreak":true},{"text":"He hath done whatsoever he pleased.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Their idols are silver and gold,","poem":1},{"lineBreak":true},{"text":"The work of men’s hands.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"They have mouths, but they speak not:","poem":1},{"lineBreak":true},{"text":"Eyes have they, but they see not:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"They have ears, but they hear not:","poem":1},{"lineBreak":true},{"text":"Noses have they, but they smell not:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"They have hands, but they handle not:","poem":1},{"lineBreak":true},{"text":"Feet have they, but they walk not:","poem":1},{"lineBreak":true},{"text":"Neither speak they through their throat.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"They that make them are like unto them;","poem":1},{"lineBreak":true},{"text":"So is every one that trusteth in them.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"O Israel, trust thou in the Lord:","poem":1},{"lineBreak":true},{"text":"He is their help and their shield.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"O house of Aaron, trust in the Lord:","poem":1},{"lineBreak":true},{"text":"He is their help and their shield.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ye that fear the Lord, trust in the Lord:","poem":1},{"lineBreak":true},{"text":"He is their help and their shield.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"The Lord hath been mindful of us: he will bless us;","poem":1},{"lineBreak":true},{"text":"He will bless the house of Israel;","poem":1},{"lineBreak":true},{"text":"He will bless the house of Aaron.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"He will bless them that fear the Lord,","poem":1},{"lineBreak":true},{"text":"Both small and great.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"The Lord shall increase you more and more,","poem":1},{"lineBreak":true},{"text":"You and your children.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"You are blessed of the Lord","poem":1},{"lineBreak":true},{"text":"Which made heaven and earth.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"The heaven, even the heavens, are the Lord’s:","poem":1},{"lineBreak":true},{"text":"But the earth hath he given to the children of men.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"The dead praise not the Lord,","poem":1},{"lineBreak":true},{"text":"Neither any that go down into silence.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"But we will bless the Lord","poem":1},{"lineBreak":true},{"text":"From this time forth and for evermore.","poem":1},{"lineBreak":true},{"text":"Praise the Lord.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}