{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"verse","number":1,"content":[{"text":"I love the Lord, because he hath heard","poem":1},{"lineBreak":true},{"text":"My voice and my supplications.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Because he hath inclined his ear unto me,","poem":1},{"lineBreak":true},{"text":"Therefore will I call upon him as long as I live.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The sorrows of death compassed me,","poem":1},{"lineBreak":true},{"text":"And the pains of hell gat hold upon me:","poem":1},{"lineBreak":true},{"text":"I found trouble and sorrow.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Then called I upon the name of the Lord;","poem":1},{"lineBreak":true},{"text":"O Lord, I beseech thee, deliver my soul.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gracious is the Lord, and righteous;","poem":1},{"lineBreak":true},{"text":"Yea, our God is merciful.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The Lord preserveth the simple:","poem":1},{"lineBreak":true},{"text":"I was brought low, and he helped me.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Return unto thy rest, O my soul;","poem":1},{"lineBreak":true},{"text":"For the Lord hath dealt bountifully with thee.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For thou hast delivered my soul from death,","poem":1},{"lineBreak":true},{"text":"Mine eyes from tears,","poem":1},{"lineBreak":true},{"text":"And my feet from falling.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I will walk before the Lord","poem":1},{"lineBreak":true},{"text":"In the land of the living.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I believed, therefore have I spoken:","poem":1},{"lineBreak":true},{"text":"I was greatly afflicted:","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I said in my haste,","poem":1},{"lineBreak":true},{"text":"All men are liars.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"What shall I render unto the Lord","poem":1},{"lineBreak":true},{"text":"For all his benefits towards me?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I will take the cup of salvation,","poem":1},{"lineBreak":true},{"text":"And call upon the name of the Lord.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"I will pay my vows unto the Lord","poem":1},{"lineBreak":true},{"text":"Now in the presence of all his people.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Precious in the sight of the Lord","poem":1},{"lineBreak":true},{"text":"Is the death of his saints.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Oh Lord, truly I am thy servant;","poem":1},{"lineBreak":true},{"text":"I am thy servant, and the son of thy handmaid:","poem":1},{"lineBreak":true},{"text":"Thou hast loosed my bonds.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"I will offer to thee the sacrifice of thanksgiving,","poem":1},{"lineBreak":true},{"text":"And will call upon the name of the Lord.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"I will pay my vows unto the Lord","poem":1},{"lineBreak":true},{"text":"Now in the presence of all his people,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"In the courts of the Lord’s house,","poem":1},{"lineBreak":true},{"text":"In the midst of thee, O Jerusalem.","poem":1},{"lineBreak":true},{"text":"Praise ye the Lord.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}