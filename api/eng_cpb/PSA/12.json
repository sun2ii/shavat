{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician upon Sheminith, A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Help, Lord; for the godly man ceaseth;","poem":1},{"lineBreak":true},{"text":"For the faithful fail from among the children of men.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"They speak vanity every one with his neighbour:","poem":1},{"lineBreak":true},{"text":"With flattering lips and with a double heart do they speak.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The Lord shall cut off all flattering lips,","poem":1},{"lineBreak":true},{"text":"And the tongue that speaketh proud things:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Who have said, With our tongue will we prevail;","poem":1},{"lineBreak":true},{"text":"Our lips are our own: who is lord over us?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For the oppression of the poor, for the sighing of the needy,","poem":1},{"lineBreak":true},{"text":"Now will I arise, saith the Lord;","poem":1},{"lineBreak":true},{"text":"I will set him in safety from him that puffeth at him.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The words of the Lord are pure words:","poem":1},{"lineBreak":true},{"text":"As silver tried in a furnace of earth, purified seven times.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Thou shalt keep them, O Lord,","poem":1},{"lineBreak":true},{"text":"Thou shalt preserve them from this generation for ever.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The wicked walk on every side,","poem":1},{"lineBreak":true},{"text":"When the vilest men are exalted.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}