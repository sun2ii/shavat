{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":124,"content":[{"type":"hebrew_subtitle","content":["A Song of degrees of David."]},{"type":"verse","number":1,"content":[{"text":"If it had not been the Lord who was on our side,","poem":1},{"lineBreak":true},{"text":"Now may Israel say;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"If it had not been the Lord who was on our side,","poem":1},{"lineBreak":true},{"text":"When men rose up against us:","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Then they had swallowed us up quick,","poem":1},{"lineBreak":true},{"text":"When their wrath was kindled against us:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Then the waters had overwhelmed us,","poem":1},{"lineBreak":true},{"text":"The stream had gone over our soul:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Then the proud waters","poem":1},{"lineBreak":true},{"text":"Had gone over our soul.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Blessed be the Lord,","poem":1},{"lineBreak":true},{"text":"Who hath not given us as a prey to their teeth.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Our soul is escaped as a bird out of the snare of the fowlers:","poem":1},{"lineBreak":true},{"text":"The snare is broken, and we are escaped.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Our help is in the name of the Lord,","poem":1},{"lineBreak":true},{"text":"Who made heaven and earth.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}