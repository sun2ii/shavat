{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"hebrew_subtitle","content":["A Song of degrees."]},{"type":"verse","number":1,"content":[{"text":"They that trust in the Lord shall be as mount Zion,","poem":1},{"lineBreak":true},{"text":"Which cannot be removed, but abideth for ever.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"As the mountains are round about Jerusalem,","poem":1},{"lineBreak":true},{"text":"So the Lord is round about his people","poem":1},{"lineBreak":true},{"text":"From henceforth even for ever.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For the rod of the wicked shall not rest upon the lot of the righteous;","poem":1},{"lineBreak":true},{"text":"Lest the righteous put forth their hands unto iniquity.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Do good, O Lord, unto those that be good,","poem":1},{"lineBreak":true},{"text":"And to them that are upright in their hearts.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"As for such as turn aside unto their crooked ways,","poem":1},{"lineBreak":true},{"text":"The Lord shall lead them forth with the workers of iniquity:","poem":1},{"lineBreak":true},{"text":"But peace shall be upon Israel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}