{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"hebrew_subtitle","content":["A Song of degrees."]},{"type":"verse","number":1,"content":[{"text":"When the Lord turned again the captivity of Zion,","poem":1},{"lineBreak":true},{"text":"We were like them that dream.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Then was our mouth filled with laughter,","poem":1},{"lineBreak":true},{"text":"And our tongue with singing:","poem":1},{"lineBreak":true},{"text":"Then said they among the heathen,","poem":1},{"lineBreak":true},{"text":"The Lord hath done great things for them.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The Lord hath done great things for us;","poem":1},{"lineBreak":true},{"text":"Whereof we are glad.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Turn again our captivity, O Lord,","poem":1},{"lineBreak":true},{"text":"As the streams in the south.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"They that sow in tears shall reap in joy.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He that goeth forth and weepeth, bearing precious seed,","poem":1},{"lineBreak":true},{"text":"Shall doubtless come again with rejoicing, bringing his sheaves with him.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}