{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":128,"content":[{"type":"hebrew_subtitle","content":["A Song of degrees."]},{"type":"verse","number":1,"content":[{"text":"Blessed is every one that feareth the Lord;","poem":1},{"lineBreak":true},{"text":"That walketh in his ways.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For thou shalt eat the labour of thine hands:","poem":1},{"lineBreak":true},{"text":"Happy shalt thou be, and it shall be well with thee.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Thy wife shall be as a fruitful vine","poem":1},{"lineBreak":true},{"text":"By the sides of thine house:","poem":1},{"lineBreak":true},{"text":"Thy children like olive plants","poem":1},{"lineBreak":true},{"text":"Round about thy table.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Behold, that thus shall the man be blessed that feareth the Lord.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The Lord shall bless thee out of Zion:","poem":1},{"lineBreak":true},{"text":"And thou shalt see the good of Jerusalem","poem":1},{"lineBreak":true},{"text":"All the days of thy life.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yea, thou shalt see thy children’s children,","poem":1},{"lineBreak":true},{"text":"And peace upon Israel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}