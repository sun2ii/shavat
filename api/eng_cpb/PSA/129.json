{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"hebrew_subtitle","content":["A Song of degrees."]},{"type":"verse","number":1,"content":[{"text":"Many a time have they afflicted me from my youth,","poem":1},{"lineBreak":true},{"text":"May Israel now say:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Many a time have they afflicted me from my youth:","poem":1},{"lineBreak":true},{"text":"Yet they have not prevailed against me.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The plowers plowed upon my back:","poem":1},{"lineBreak":true},{"text":"They made long their furrows.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The Lord is righteous:","poem":1},{"lineBreak":true},{"text":"He hath cut asunder the cords of the wicked.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Let them all be confounded and turned back","poem":1},{"lineBreak":true},{"text":"That hate Zion.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Let them be as the grass upon the housetops,","poem":1},{"lineBreak":true},{"text":"Which withereth afore it groweth up:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wherewith the mower filleth not his hand;","poem":1},{"lineBreak":true},{"text":"Nor he that bindeth sheaves his bosom.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Neither do they which go by say,","poem":1},{"lineBreak":true},{"text":"The blessing of the Lord be upon you:","poem":1},{"lineBreak":true},{"text":"We bless you in the name of the Lord.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}