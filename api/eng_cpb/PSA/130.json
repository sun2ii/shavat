{"lineBreak":true},{"text":"And in his word do I hope.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"My soul waiteth for the Lord","poem":1},{"lineBreak":true},{"text":"More than they that watch for the morning:","poem":1},{"lineBreak":true},{"text":"I say, more than they that watch for the morning.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Let Israel hope in the Lord:","poem":1},{"lineBreak":true},{"text":"For with the Lord there is mercy,","poem":1},{"lineBreak":true},{"text":"And with him is plenteous redemption.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"And he shall redeem Israel","poem":1},{"lineBreak":true},{"text":"From all his iniquities.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}