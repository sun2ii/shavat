{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":132,"content":[{"type":"hebrew_subtitle","content":["A Song of degrees."]},{"type":"verse","number":1,"content":[{"text":"Lord, remember David,","poem":1},{"lineBreak":true},{"text":"And all his afflictions:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"How he sware unto the Lord,","poem":1},{"lineBreak":true},{"text":"And vowed unto the mighty God of Jacob;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Surely I will not come into the tabernacle of my house,","poem":1},{"lineBreak":true},{"text":"Nor go up into my bed;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I will not give sleep to mine eyes,","poem":1},{"lineBreak":true},{"text":"Or slumber to mine eyelids,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Until I find out a place for the Lord,","poem":1},{"lineBreak":true},{"text":"A habitation for the mighty God of Jacob.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lo, we heard of it at Ephratah:","poem":1},{"lineBreak":true},{"text":"We found it in the fields of the wood.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"We will go into his tabernacles:","poem":1},{"lineBreak":true},{"text":"We will worship at his footstool.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Arise, O Lord, into thy rest;","poem":1},{"lineBreak":true},{"text":"Thou, and the ark of thy strength.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Let thy priests be clothed with righteousness;","poem":1},{"lineBreak":true},{"text":"And let thy saints shout for joy.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"For thy servant David’s sake","poem":1},{"lineBreak":true},{"text":"Turn not away the face of thine anointed.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"The Lord hath sworn in truth unto David;","poem":1},{"lineBreak":true},{"text":"He will not turn from it;","poem":1},{"lineBreak":true},{"text":"Of the fruit of thy body will I set upon thy throne.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"If thy children will keep my covenant","poem":1},{"lineBreak":true},{"text":"And my testimony that I shall teach them,","poem":1},{"lineBreak":true},{"text":"Their children also shall sit upon thy throne for evermore.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"For the Lord hath chosen Zion;","poem":1},{"lineBreak":true},{"text":"He hath desired it for his habitation.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"This is my rest for ever:","poem":1},{"lineBreak":true},{"text":"Here will I dwell; for I have desired it.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"I will abundantly bless her provision:","poem":1},{"lineBreak":true},{"text":"I will satisfy her poor with bread.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"I will also clothe her priests with salvation:","poem":1},{"lineBreak":true},{"text":"And her saints shall shout aloud for joy.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"There will I make the horn of David to bud:","poem":1},{"lineBreak":true},{"text":"I have ordained a lamp for mine anointed.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"His enemies will I clothe with shame:","poem":1},{"lineBreak":true},{"text":"But upon himself shall his crown flourish.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}