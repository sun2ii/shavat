{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":136,"content":[{"type":"verse","number":1,"content":[{"text":"O give thanks unto the Lord; for he is good:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O give thanks unto the God of gods:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"O give thanks to the Lord of lords:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"To him who alone doeth great wonders:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"To him that by wisdom made the heavens:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"To him that stretched out the earth above the waters:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"To him that made great lights:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The sun to rule by day:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The moon and stars to rule by night:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"To him that smote Egypt in their firstborn:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever:","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"And brought out Israel from among them:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever:","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"With a strong hand, and with a stretched out arm:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"To him which divided the Red sea into parts:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"And made Israel to pass through the midst of it:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever:","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"But overthrew Pharaoh and his host in the Red sea:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"To him which led his people through the wilderness:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"To him which smote great kings:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever:","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"And slew famous kings:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever:","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Sihon king of the Amorites:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever:","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"And Og the king of Bashan:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever:","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"And gave their land for an heritage:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever:","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Even an heritage unto Israel his servant:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Who remembered us in our low estate:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever:","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"And hath redeemed us from our enemies:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Who giveth food to all flesh:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"O give thanks unto the God of heaven:","poem":1},{"lineBreak":true},{"text":"For his mercy endureth for ever.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}