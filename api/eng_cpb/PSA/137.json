{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"By the rivers of Babylon, there we sat down, yea, we wept,","poem":1},{"lineBreak":true},{"text":"When we remembered Zion.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"We hanged our harps","poem":1},{"lineBreak":true},{"text":"Upon the willows in the midst thereof.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For there they that carried us away captive required of us a song;","poem":1},{"lineBreak":true},{"text":"And they that wasted us required of us mirth,","poem":1},{"lineBreak":true},{"text":"Saying, Sing us one of the songs of Zion.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"How shall we sing the Lord’s song","poem":1},{"lineBreak":true},{"text":"In a strange land?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"If I forget thee, O Jerusalem,","poem":1},{"lineBreak":true},{"text":"Let my right hand forget her cunning.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"If I do not remember thee,","poem":1},{"lineBreak":true},{"text":"Let my tongue cleave to the roof of my mouth;","poem":1},{"lineBreak":true},{"text":"If I prefer not Jerusalem above my chief joy.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Remember, O Lord, the children of Edom in the day of Jerusalem;","poem":1},{"lineBreak":true},{"text":"Who said, Rase it, rase it, even to the foundation thereof.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O daughter of Babylon, who art to be destroyed;","poem":1},{"lineBreak":true},{"text":"Happy shall he be, that rewardeth thee","poem":1},{"lineBreak":true},{"text":"As thou hast served us.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Happy shall he be that taketh","poem":1},{"lineBreak":true},{"text":"And dasheth thy little ones against the stones.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}