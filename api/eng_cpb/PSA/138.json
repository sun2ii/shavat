{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"I will praise thee with my whole heart:","poem":1},{"lineBreak":true},{"text":"Before the gods will I sing praise unto thee.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I will worship towards thy holy temple,","poem":1},{"lineBreak":true},{"text":"And praise thy name for thy lovingkindness and for thy truth:","poem":1},{"lineBreak":true},{"text":"For thou hast magnified thy word above all thy name.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"In the day when I cried thou answeredst me,","poem":1},{"lineBreak":true},{"text":"And strengthenedst me with strength in my soul.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"All the kings of the earth shall praise thee, O Lord,","poem":1},{"lineBreak":true},{"text":"When they hear the words of thy mouth.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yea, they shall sing in the ways of the Lord:","poem":1},{"lineBreak":true},{"text":"For great is the glory of the Lord.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Though the Lord be high, yet hath he respect unto the lowly:","poem":1},{"lineBreak":true},{"text":"But the proud he knoweth afar off.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Though I walk in the midst of trouble, thou wilt revive me:","poem":1},{"lineBreak":true},{"text":"Thou shalt stretch forth thine hand against the wrath of mine enemies,","poem":1},{"lineBreak":true},{"text":"And thy right hand shall save me.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The Lord will perfect that which concerneth me:","poem":1},{"lineBreak":true},{"text":"Thy mercy, O Lord, endureth for ever:","poem":1},{"lineBreak":true},{"text":"Forsake not the works of thine own hands.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}