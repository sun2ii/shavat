{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":141,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Lord, I cry unto thee: make haste unto me;","poem":1},{"lineBreak":true},{"text":"Give ear unto my voice, when I cry unto thee.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Let my prayer be set forth before thee as incense;","poem":1},{"lineBreak":true},{"text":"And the lifting up of my hands as the evening sacrifice.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Set a watch, O Lord, before my mouth;","poem":1},{"lineBreak":true},{"text":"Keep the door of my lips.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Incline not my heart to any evil thing,","poem":1},{"lineBreak":true},{"text":"To practise wicked works with men that work iniquity:","poem":1},{"lineBreak":true},{"text":"And let me not eat of their dainties.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Let the righteous smite me; it shall be a kindness:","poem":1},{"lineBreak":true},{"text":"And let him reprove me; it shall be an excellent oil,","poem":1},{"lineBreak":true},{"text":"Which shall not break my head:","poem":1},{"lineBreak":true},{"text":"For yet my prayer also shall be in their calamities.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"When their judges are overthrown in stony places,","poem":1},{"lineBreak":true},{"text":"They shall hear my words; for they are sweet.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Our bones are scattered at the grave’s mouth,","poem":1},{"lineBreak":true},{"text":"As when one cutteth and cleaveth wood upon the earth.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"But mine eyes are unto thee, O God the Lord:","poem":1},{"lineBreak":true},{"text":"In thee is my trust; leave not my soul destitute.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Keep me from the snare which they have laid for me,","poem":1},{"lineBreak":true},{"text":"And the grins of the workers of iniquity.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Let the wicked fall into their own nets,","poem":1},{"lineBreak":true},{"text":"Whilst that I withal escape.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}