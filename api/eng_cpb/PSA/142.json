{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["Maschil of David; A Prayer when he was in the cave."]},{"type":"verse","number":1,"content":[{"text":"I cried unto the Lord with my voice;","poem":1},{"lineBreak":true},{"text":"With my voice unto the Lord did I make my supplication.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I poured out my complaint before him;","poem":1},{"lineBreak":true},{"text":"I shewed before him my trouble.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"When my spirit was overwhelmed within me,","poem":1},{"lineBreak":true},{"text":"Then thou knewest my path.","poem":1},{"lineBreak":true},{"text":"In the way wherein I walked","poem":1},{"lineBreak":true},{"text":"Have they privily laid a snare for me.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I looked on my right hand, and beheld,","poem":1},{"lineBreak":true},{"text":"But there was no man that would know me:","poem":1},{"lineBreak":true},{"text":"Refuge failed me;","poem":1},{"lineBreak":true},{"text":"No man cared for my soul.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I cried unto thee, O Lord:","poem":1},{"lineBreak":true},{"text":"I said, Thou art my refuge","poem":1},{"lineBreak":true},{"text":"And my portion in the land of the living.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Attend unto my cry;","poem":1},{"lineBreak":true},{"text":"For I am brought very low:","poem":1},{"lineBreak":true},{"text":"Deliver me from my persecutors;","poem":1},{"lineBreak":true},{"text":"For they are stronger than I.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bring my soul out of prison,","poem":1},{"lineBreak":true},{"text":"That I may praise thy name:","poem":1},{"lineBreak":true},{"text":"The righteous shall compass me about;","poem":1},{"lineBreak":true},{"text":"For thou shalt deal bountifully with me.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}