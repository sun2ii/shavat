{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":143,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Hear my prayer, O Lord,","poem":1},{"lineBreak":true},{"text":"Give ear to my supplications:","poem":1},{"lineBreak":true},{"text":"In thy faithfulness answer me, and in thy righteousness.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"And enter not into judgment with thy servant:","poem":1},{"lineBreak":true},{"text":"For in thy sight shall no man living be justified.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For the enemy hath persecuted my soul;","poem":1},{"lineBreak":true},{"text":"He hath smitten my life down to the ground;","poem":1},{"lineBreak":true},{"text":"He hath made me to dwell in darkness, as those that have been long dead.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Therefore is my spirit overwhelmed within me;","poem":1},{"lineBreak":true},{"text":"My heart within me is desolate.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I remember the days of old;","poem":1},{"lineBreak":true},{"text":"I meditate on all thy works;","poem":1},{"lineBreak":true},{"text":"I muse on the work of thy hands.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I stretch forth my hands unto thee:","poem":1},{"lineBreak":true},{"text":"My soul thirsteth after thee, as a thirsty land. Selah.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hear me speedily, O Lord: my spirit faileth:","poem":1},{"lineBreak":true},{"text":"Hide not thy face from me,","poem":1},{"lineBreak":true},{"text":"Lest I be like unto them that go down into the pit.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Cause me to hear thy lovingkindness in the morning;","poem":1},{"lineBreak":true},{"text":"For in thee do I trust:","poem":1},{"lineBreak":true},{"text":"Cause me to know the way wherein I should walk;","poem":1},{"lineBreak":true},{"text":"For I lift up my soul unto thee.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Deliver me, O Lord, from mine enemies:","poem":1},{"lineBreak":true},{"text":"I flee unto thee to hide me.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Teach me to do thy will; for thou art my God:","poem":1},{"lineBreak":true},{"text":"Thy spirit is good; lead me into the land of uprightness.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Quicken me, O Lord, for thy name’s sake:","poem":1},{"lineBreak":true},{"text":"For thy righteousness’ sake bring my soul out of trouble.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"And of thy mercy cut off mine enemies,","poem":1},{"lineBreak":true},{"text":"And destroy all them that afflict my soul:","poem":1},{"lineBreak":true},{"text":"For I am thy servant.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}