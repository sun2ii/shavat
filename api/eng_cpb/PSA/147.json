{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":147,"content":[{"type":"verse","number":1,"content":[{"text":"Praise ye the Lord:","poem":1},{"lineBreak":true},{"text":"For it is good to sing praises unto our God;","poem":1},{"lineBreak":true},{"text":"For it is pleasant; and praise is comely.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The Lord doth build up Jerusalem:","poem":1},{"lineBreak":true},{"text":"He gathereth together the outcasts of Israel.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He healeth the broken in heart,","poem":1},{"lineBreak":true},{"text":"And bindeth up their wounds.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He telleth the number of the stars;","poem":1},{"lineBreak":true},{"text":"He calleth them all by their names.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Great is our Lord, and of great power:","poem":1},{"lineBreak":true},{"text":"His understanding is infinite.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The Lord lifteth up the meek:","poem":1},{"lineBreak":true},{"text":"He casteth the wicked down to the ground.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sing unto the Lord with thanksgiving;","poem":1},{"lineBreak":true},{"text":"Sing praise upon the harp unto our God:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Who covereth the heaven with clouds,","poem":1},{"lineBreak":true},{"text":"Who prepareth rain for the earth,","poem":1},{"lineBreak":true},{"text":"Who maketh grass to grow upon the mountains.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He giveth to the beast his food,","poem":1},{"lineBreak":true},{"text":"And to the young ravens which cry.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"He delighteth not in the strength of the horse:","poem":1},{"lineBreak":true},{"text":"He taketh not pleasure in the legs of a man.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"The Lord taketh pleasure in them that fear him,","poem":1},{"lineBreak":true},{"text":"In those that hope in his mercy.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Praise the Lord, O Jerusalem;","poem":1},{"lineBreak":true},{"text":"Praise thy God, O Zion.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"For he hath strengthened the bars of thy gates;","poem":1},{"lineBreak":true},{"text":"He hath blessed thy children within thee.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"He maketh peace in thy borders,","poem":1},{"lineBreak":true},{"text":"And filleth thee with the finest of the wheat.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"He sendeth forth his commandment upon earth:","poem":1},{"lineBreak":true},{"text":"His word runneth very swiftly.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"He giveth snow like wool:","poem":1},{"lineBreak":true},{"text":"He scattereth the hoarfrost like ashes.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"He casteth forth his ice like morsels:","poem":1},{"lineBreak":true},{"text":"Who can stand before his cold?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"He sendeth out his word, and melteth them:","poem":1},{"lineBreak":true},{"text":"He causeth his wind to blow, and the waters flow.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"He sheweth his word unto Jacob,","poem":1},{"lineBreak":true},{"text":"His statutes and his judgments unto Israel.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"He hath not dealt so with any nation:","poem":1},{"lineBreak":true},{"text":"And as for his judgments, they have not known them.","poem":1},{"lineBreak":true},{"text":"Praise ye the Lord.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}