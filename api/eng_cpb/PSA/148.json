{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"Praise ye the Lord.","poem":1},{"lineBreak":true},{"text":"Praise ye the Lord from the heavens:","poem":1},{"lineBreak":true},{"text":"Praise him in the heights.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Praise ye him, all his angels:","poem":1},{"lineBreak":true},{"text":"Praise ye him, all his hosts.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Praise ye him, sun and moon:","poem":1},{"lineBreak":true},{"text":"Praise him, all ye stars of light.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Praise him, ye heavens of heavens,","poem":1},{"lineBreak":true},{"text":"And ye waters that be above the heavens.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Let them praise the name of the Lord:","poem":1},{"lineBreak":true},{"text":"For he commanded, and they were created.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He hath also stablished them for ever and ever:","poem":1},{"lineBreak":true},{"text":"He hath made a decree which shall not pass.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Praise the Lord from the earth,","poem":1},{"lineBreak":true},{"text":"Ye dragons, and all deeps:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fire, and hail; snow, and vapour;","poem":1},{"lineBreak":true},{"text":"Stormy wind fulfilling his word:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mountains, and all hills;","poem":1},{"lineBreak":true},{"text":"Fruitful trees, and all cedars:","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Beasts, and all cattle;","poem":1},{"lineBreak":true},{"text":"Creeping things, and flying fowl:","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kings of the earth, and all people;","poem":1},{"lineBreak":true},{"text":"Princes, and all judges of the earth:","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Both young men, and maidens;","poem":1},{"lineBreak":true},{"text":"Old men, and children:","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Let them praise the name of the Lord:","poem":1},{"lineBreak":true},{"text":"For his name alone is excellent;","poem":1},{"lineBreak":true},{"text":"His glory is above the earth and heaven.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"He also exalteth the horn of his people,","poem":1},{"lineBreak":true},{"text":"The praise of all his saints;","poem":1},{"lineBreak":true},{"text":"Even of the children of Israel, a people near unto him.","poem":1},{"lineBreak":true},{"text":"Praise ye the Lord.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}