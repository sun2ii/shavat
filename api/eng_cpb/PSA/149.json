m":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Let the saints be joyful in glory:","poem":1},{"lineBreak":true},{"text":"Let them sing aloud upon their beds.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Let the high praises of God be in their mouth,","poem":1},{"lineBreak":true},{"text":"And a twoedged sword in their hand;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"To execute vengeance upon the heathen,","poem":1},{"lineBreak":true},{"text":"And punishments upon the people;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"To bind their kings with chains,","poem":1},{"lineBreak":true},{"text":"And their nobles with fetters of iron;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"To execute upon them the judgment written:","poem":1},{"lineBreak":true},{"text":"This honour have all his saints.","poem":1},{"lineBreak":true},{"text":"Praise ye the Lord.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}