{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":16,"content":[{"type":"hebrew_subtitle","content":["Michtam of David."]},{"type":"verse","number":1,"content":[{"text":"Preserve me, O God: for in thee do I put my trust.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O my soul, thou hast said unto the Lord, Thou art my Lord:","poem":1},{"lineBreak":true},{"text":"My goodness extendeth not to thee;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"But to the saints that are in the earth,","poem":1},{"lineBreak":true},{"text":"And to the excellent, in whom is all my delight.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Their sorrows shall be multiplied that hasten after another god:","poem":1},{"lineBreak":true},{"text":"Their drink offerings of blood will I not offer,","poem":1},{"lineBreak":true},{"text":"Nor take up their names into my lips.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The Lord is the portion of mine inheritance and of my cup:","poem":1},{"lineBreak":true},{"text":"Thou maintainest my lot.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The lines are fallen unto me in pleasant places;","poem":1},{"lineBreak":true},{"text":"Yea, I have a goodly heritage.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I will bless the Lord, who hath given me counsel:","poem":1},{"lineBreak":true},{"text":"My reins also instruct me in the night seasons.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I have set the Lord always before me:","poem":1},{"lineBreak":true},{"text":"Because he is at my right hand, I shall not be moved.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Therefore my heart is glad, and my glory rejoiceth:","poem":1},{"lineBreak":true},{"text":"My flesh also shall rest in hope.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"For thou wilt not leave my soul in hell;","poem":1},{"lineBreak":true},{"text":"Neither wilt thou suffer thine Holy One to see corruption.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Thou wilt shew me the path of life:","poem":1},{"lineBreak":true},{"text":"In thy presence is fulness of joy;","poem":1},{"lineBreak":true},{"text":"At thy right hand there are pleasures for evermore.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}