{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Why do the heathen rage,","poem":1},{"lineBreak":true},{"text":"And the people imagine a vain thing?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The kings of the earth set themselves,","poem":1},{"lineBreak":true},{"text":"And the rulers take counsel together,","poem":1},{"lineBreak":true},{"text":"Against the Lord, and against his anointed, saying,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let us break their bands asunder,","poem":1},{"lineBreak":true},{"text":"And cast away their cords from us.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He that sitteth in the heavens shall laugh:","poem":1},{"lineBreak":true},{"text":"The Lord shall have them in derision.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Then shall he speak unto them in his wrath,","poem":1},{"lineBreak":true},{"text":"And vex them in his sore displeasure.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yet have I set my king","poem":1},{"lineBreak":true},{"text":"Upon my holy hill of Zion.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I will declare the decree:","poem":1},{"lineBreak":true},{"text":"The Lord hath said unto me, Thou art my Son;","poem":1},{"lineBreak":true},{"text":"This day have I begotten thee.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ask of me,","poem":1},{"lineBreak":true},{"text":"And I shall give thee the heathen for thine inheritance,","poem":1},{"lineBreak":true},{"text":"And the uttermost parts of the earth for thy possession.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Thou shalt break them with a rod of iron;","poem":1},{"lineBreak":true},{"text":"Thou shalt dash them in pieces like a potter’s vessel.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Be wise now therefore, O ye kings:","poem":1},{"lineBreak":true},{"text":"Be instructed, ye judges of the earth.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Serve the Lord with fear,","poem":1},{"lineBreak":true},{"text":"And rejoice with trembling.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kiss the Son, lest he be angry,","poem":1},{"lineBreak":true},{"text":"And ye perish from the way,","poem":1},{"lineBreak":true},{"text":"When his wrath is kindled but a little:","poem":1},{"lineBreak":true},{"text":"Blessed are all they that put their trust in him.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}