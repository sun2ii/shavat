{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician, A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"The Lord hear thee in the day of trouble;","poem":1},{"lineBreak":true},{"text":"The name of the God of Jacob defend thee;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Send thee help from the sanctuary,","poem":1},{"lineBreak":true},{"text":"And strengthen thee out of Zion;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Remember all thy offerings,","poem":1},{"lineBreak":true},{"text":"And accept thy burnt sacrifice. Selah.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Grant thee according to thine own heart,","poem":1},{"lineBreak":true},{"text":"And fulfil all thy counsel.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"We will rejoice in thy salvation,","poem":1},{"lineBreak":true},{"text":"And in the name of our God we will set up our banners:","poem":1},{"lineBreak":true},{"text":"The Lord fulfil all thy petitions.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Now know I that the Lord saveth his anointed;","poem":1},{"lineBreak":true},{"text":"He will hear him from his holy heaven","poem":1},{"lineBreak":true},{"text":"With the saving strength of his right hand.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Some trust in chariots, and some in horses:","poem":1},{"lineBreak":true},{"text":"But we will remember the name of the Lord our God.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"They are brought down and fallen:","poem":1},{"lineBreak":true},{"text":"But we are risen, and stand upright.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Save, Lord:","poem":1},{"lineBreak":true},{"text":"Let the king hear us when we call.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}