{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"The Lord is my shepherd; I shall not want.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"He maketh me to lie down in green pastures:","poem":1},{"lineBreak":true},{"text":"He leadeth me beside the still waters.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He restoreth my soul:","poem":1},{"lineBreak":true},{"text":"He leadeth me in the paths of righteousness for his name’s sake.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yea, though I walk through the valley of the shadow of death,","poem":1},{"lineBreak":true},{"text":"I will fear no evil: for thou art with me;","poem":1},{"lineBreak":true},{"text":"Thy rod and thy staff they comfort me.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Thou preparest a table before me in the presence of mine enemies:","poem":1},{"lineBreak":true},{"text":"Thou anointest my head with oil; my cup runneth over.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Surely goodness and mercy shall follow me all the days of my life:","poem":1},{"lineBreak":true},{"text":"And I will dwell in the house of the Lord for ever.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}