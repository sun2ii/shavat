{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":24,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"The earth is the Lord’s, and the fulness thereof;","poem":1},{"lineBreak":true},{"text":"The world, and they that dwell therein.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For he hath founded it upon the seas,","poem":1},{"lineBreak":true},{"text":"And established it upon the floods.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Who shall ascend into the hill of the Lord?","poem":1},{"lineBreak":true},{"text":"And who shall stand in his holy place?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He that hath clean hands, and a pure heart;","poem":1},{"lineBreak":true},{"text":"Who hath not lift up his soul unto vanity,","poem":1},{"lineBreak":true},{"text":"Nor sworn deceitfully.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"He shall receive the blessing from the Lord,","poem":1},{"lineBreak":true},{"text":"And righteousness from the God of his salvation.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"This is the generation of them that seek him,","poem":1},{"lineBreak":true},{"text":"That seek thy face, O Jacob. Selah.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lift up your heads, O ye gates;","poem":1},{"lineBreak":true},{"text":"And be ye lift up, ye everlasting doors;","poem":1},{"lineBreak":true},{"text":"And the King of glory shall come in.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Who is this King of glory?","poem":1},{"lineBreak":true},{"text":"The Lord strong and mighty,","poem":1},{"lineBreak":true},{"text":"The Lord mighty in battle.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lift up your heads, O ye gates;","poem":1},{"lineBreak":true},{"text":"Even lift them up, ye everlasting doors;","poem":1},{"lineBreak":true},{"text":"And the King of glory shall come in.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Who is this King of glory?","poem":1},{"lineBreak":true},{"text":"The Lord of hosts, he is the King of glory. Selah.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}