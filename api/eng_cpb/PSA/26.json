{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Judge me, O Lord; for I have walked in mine integrity:","poem":1},{"lineBreak":true},{"text":"I have trusted also in the Lord; therefore I shall not slide.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Examine me, O Lord, and prove me;","poem":1},{"lineBreak":true},{"text":"Try my reins and my heart.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For thy lovingkindness is before mine eyes:","poem":1},{"lineBreak":true},{"text":"And I have walked in thy truth.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I have not sat with vain persons,","poem":1},{"lineBreak":true},{"text":"Neither will I go in with dissemblers.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I have hated the congregation of evildoers;","poem":1},{"lineBreak":true},{"text":"And will not sit with the wicked.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I will wash mine hands in innocency:","poem":1},{"lineBreak":true},{"text":"So will I compass thine altar, O Lord:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"That I may publish with the voice of thanksgiving,","poem":1},{"lineBreak":true},{"text":"And tell of all thy wondrous works.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lord, I have loved the habitation of thy house,","poem":1},{"lineBreak":true},{"text":"And the place where thine honour dwelleth.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gather not my soul with sinners,","poem":1},{"lineBreak":true},{"text":"Nor my life with bloody men:","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"In whose hands is mischief,","poem":1},{"lineBreak":true},{"text":"And their right hand is full of bribes.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"But as for me, I will walk in mine integrity:","poem":1},{"lineBreak":true},{"text":"Redeem me, and be merciful unto me.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"My foot standeth in an even place:","poem":1},{"lineBreak":true},{"text":"In the congregations will I bless the Lord.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}