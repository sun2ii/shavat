{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":28,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Unto thee will I cry, O Lord my rock; be not silent to me:","poem":1},{"lineBreak":true},{"text":"Lest, if thou be silent to me, I become like them that go down into the pit.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hear the voice of my supplications, when I cry unto thee,","poem":1},{"lineBreak":true},{"text":"When I lift up my hands toward thy holy oracle.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Draw me not away with the wicked, and with the workers of iniquity,","poem":1},{"lineBreak":true},{"text":"Which speak peace to their neighbours, but mischief is in their hearts.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Give them according to their deeds,","poem":1},{"lineBreak":true},{"text":"And according to the wickedness of their endeavours:","poem":1},{"lineBreak":true},{"text":"Give them after the work of their hands;","poem":1},{"lineBreak":true},{"text":"Render to them their desert.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Because they regard not the works of the Lord,","poem":1},{"lineBreak":true},{"text":"Nor the operation of his hands,","poem":1},{"lineBreak":true},{"text":"He shall destroy them, and not build them up.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Blessed be the Lord, because he hath heard the voice of my supplications.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The Lord is my strength and my shield;","poem":1},{"lineBreak":true},{"text":"My heart trusted in him, and I am helped:","poem":1},{"lineBreak":true},{"text":"Therefore my heart greatly rejoiceth;","poem":1},{"lineBreak":true},{"text":"And with my song will I praise him.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The Lord is their strength,","poem":1},{"lineBreak":true},{"text":"And he is the saving strength of his anointed.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Save thy people,","poem":1},{"lineBreak":true},{"text":"And bless thine inheritance:","poem":1},{"lineBreak":true},{"text":"Feed them also, and lift them up for ever.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}