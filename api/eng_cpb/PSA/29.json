{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Give unto the Lord, O ye mighty,","poem":1},{"lineBreak":true},{"text":"Give unto the Lord glory and strength.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Give unto the Lord the glory due unto his name;","poem":1},{"lineBreak":true},{"text":"Worship the Lord in the beauty of holiness.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The voice of the Lord is upon the waters:","poem":1},{"lineBreak":true},{"text":"The God of glory thundereth:","poem":1},{"lineBreak":true},{"text":"The Lord is upon many waters.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The voice of the Lord is powerful;","poem":1},{"lineBreak":true},{"text":"The voice of the Lord is full of majesty.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The voice of the Lord breaketh the cedars;","poem":1},{"lineBreak":true},{"text":"Yea, the Lord breaketh the cedars of Lebanon.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He maketh them also to skip like a calf;","poem":1},{"lineBreak":true},{"text":"Lebanon and Sirion like a young unicorn.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The voice of the Lord divideth the flames of fire.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The voice of the Lord shaketh the wilderness;","poem":1},{"lineBreak":true},{"text":"The Lord shaketh the wilderness of Kadesh.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The voice of the Lord maketh the hinds to calve,","poem":1},{"lineBreak":true},{"text":"And discovereth the forests:","poem":1},{"lineBreak":true},{"text":"And in his temple doth every one speak of his glory.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"The Lord sitteth upon the flood;","poem":1},{"lineBreak":true},{"text":"Yea, the Lord sitteth King for ever.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"The Lord will give strength unto his people;","poem":1},{"lineBreak":true},{"text":"The Lord will bless his people with peace.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}