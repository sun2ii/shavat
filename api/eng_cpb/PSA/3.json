{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David, when he fled from Absalom his son."]},{"type":"verse","number":1,"content":[{"text":"Lord, how are they increased that trouble me!","poem":1},{"lineBreak":true},{"text":"Many are they that rise up against me.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Many there be which say of my soul,","poem":1},{"lineBreak":true},{"text":"There is no help for him in God. Selah.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"But thou, O Lord, art a shield for me;","poem":1},{"lineBreak":true},{"text":"My glory, and the lifter up of mine head.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I cried unto the Lord with my voice,","poem":1},{"lineBreak":true},{"text":"And he heard me out of his holy hill. Selah.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I laid me down and slept;","poem":1},{"lineBreak":true},{"text":"I awaked; for the Lord sustained me.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I will not be afraid of ten thousands of people,","poem":1},{"lineBreak":true},{"text":"That have set themselves against me round about.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Arise, O Lord; save me, O my God:","poem":1},{"lineBreak":true},{"text":"For thou hast smitten all mine enemies upon the cheek bone;","poem":1},{"lineBreak":true},{"text":"Thou hast broken the teeth of the ungodly.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Salvation belongeth unto the Lord:","poem":1},{"lineBreak":true},{"text":"Thy blessing is upon thy people. Selah.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}