{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":39,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician, even to Jeduthun, A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"I said, I will take heed to my ways,","poem":1},{"lineBreak":true},{"text":"That I sin not with my tongue:","poem":1},{"lineBreak":true},{"text":"I will keep my mouth with a bridle,","poem":1},{"lineBreak":true},{"text":"While the wicked is before me.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I was dumb with silence, I held my peace, even from good;","poem":1},{"lineBreak":true},{"text":"And my sorrow was stirred.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"My heart was hot within me,","poem":1},{"lineBreak":true},{"text":"While I was musing the fire burned:","poem":1},{"lineBreak":true},{"text":"Then spake I with my tongue,","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lord, make me to know mine end,","poem":1},{"lineBreak":true},{"text":"And the measure of my days, what it is;","poem":1},{"lineBreak":true},{"text":"That I may know how frail I am.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Behold, thou hast made my days as a handbreadth;","poem":1},{"lineBreak":true},{"text":"And mine age is as nothing before thee:","poem":1},{"lineBreak":true},{"text":"Verily every man at his best state is altogether vanity. Selah.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Surely every man walketh in a vain shew:","poem":1},{"lineBreak":true},{"text":"Surely they are disquieted in vain:","poem":1},{"lineBreak":true},{"text":"He heapeth up riches, and knoweth not who shall gather them.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"And now, Lord, what wait I for?","poem":1},{"lineBreak":true},{"text":"My hope is in thee.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Deliver me from all my transgressions:","poem":1},{"lineBreak":true},{"text":"Make me not the reproach of the foolish.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I was dumb, I opened not my mouth;","poem":1},{"lineBreak":true},{"text":"Because thou didst it.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Remove thy stroke away from me:","poem":1},{"lineBreak":true},{"text":"I am consumed by the blow of thine hand.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"When thou with rebukes dost correct man for iniquity,","poem":1},{"lineBreak":true},{"text":"Thou makest his beauty to consume away like a moth:","poem":1},{"lineBreak":true},{"text":"Surely every man is vanity. Selah.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Hear my prayer, O Lord,","poem":1},{"lineBreak":true},{"text":"And give ear unto my cry;","poem":1},{"lineBreak":true},{"text":"Hold not thy peace at my tears:","poem":1},{"lineBreak":true},{"text":"For I am a stranger with thee,","poem":1},{"lineBreak":true},{"text":"And a sojourner, as all my fathers were.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"O spare me, that I may recover strength,","poem":1},{"lineBreak":true},{"text":"Before I go hence, and be no more.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}