{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician on Neginoth, A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Hear me when I call, O God of my righteousness:","poem":1},{"lineBreak":true},{"text":"Thou hast enlarged me when I was in distress;","poem":1},{"lineBreak":true},{"text":"Have mercy upon me, and hear my prayer.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O ye sons of men, how long will ye turn my glory into shame?","poem":1},{"lineBreak":true},{"text":"How long will ye love vanity, and seek after leasing? Selah.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"But know that the Lord hath set apart him that is godly for himself:","poem":1},{"lineBreak":true},{"text":"The Lord will hear when I call unto him.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Stand in awe, and sin not:","poem":1},{"lineBreak":true},{"text":"Commune with your own heart upon your bed, and be still. Selah.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Offer the sacrifices of righteousness,","poem":1},{"lineBreak":true},{"text":"And put your trust in the Lord.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"There be many that say, Who will shew us any good?","poem":1},{"lineBreak":true},{"text":"Lord, lift thou up the light of thy countenance upon us.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Thou hast put gladness in my heart,","poem":1},{"lineBreak":true},{"text":"More than in the time that their corn and their wine increased.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I will both lay me down in peace, and sleep:","poem":1},{"lineBreak":true},{"text":"For thou, Lord, only makest me dwell in safety.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}