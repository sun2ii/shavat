{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Judge me, O God, and plead my cause against an ungodly nation:","poem":1},{"lineBreak":true},{"text":"O deliver me from the deceitful and unjust man.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For thou art the God of my strength: why dost thou cast me off?","poem":1},{"lineBreak":true},{"text":"Why go I mourning because of the oppression of the enemy?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"O send out thy light and thy truth: let them lead me;","poem":1},{"lineBreak":true},{"text":"Let them bring me unto thy holy hill, and to thy tabernacles.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Then will I go unto the altar of God,","poem":1},{"lineBreak":true},{"text":"Unto God my exceeding joy:","poem":1},{"lineBreak":true},{"text":"Yea, upon the harp will I praise thee, O God my God.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Why art thou cast down, O my soul? and why art thou disquieted within me?","poem":1},{"lineBreak":true},{"text":"Hope in God: for I shall yet praise him,","poem":1},{"lineBreak":true},{"text":"Who is the health of my countenance, and my God.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}