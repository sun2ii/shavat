{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician for the sons of Korah, A Song upon Alamoth."]},{"type":"verse","number":1,"content":[{"text":"God is our refuge and strength,","poem":1},{"lineBreak":true},{"text":"A very present help in trouble.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Therefore will not we fear, though the earth be removed,","poem":1},{"lineBreak":true},{"text":"And though the mountains be carried into the midst of the sea;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Though the waters thereof roar and be troubled,","poem":1},{"lineBreak":true},{"text":"Though the mountains shake with the swelling thereof. Selah.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"There is a river, the streams whereof shall make glad the city of God,","poem":1},{"lineBreak":true},{"text":"The holy place of the tabernacles of the most High.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"God is in the midst of her; she shall not be moved:","poem":1},{"lineBreak":true},{"text":"God shall help her, and that right early.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The heathen raged, the kingdoms were moved:","poem":1},{"lineBreak":true},{"text":"He uttered his voice, the earth melted.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The Lord of hosts is with us;","poem":1},{"lineBreak":true},{"text":"The God of Jacob is our refuge. Selah.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Come, behold the works of the Lord,","poem":1},{"lineBreak":true},{"text":"What desolations he hath made in the earth.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He maketh wars to cease unto the end of the earth;","poem":1},{"lineBreak":true},{"text":"He breaketh the bow, and cutteth the spear in sunder;","poem":1},{"lineBreak":true},{"text":"He burneth the chariot in the fire.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Be still, and know that I am God:","poem":1},{"lineBreak":true},{"text":"I will be exalted among the heathen, I will be exalted in the earth.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"The Lord of hosts is with us;","poem":1},{"lineBreak":true},{"text":"The God of Jacob is our refuge. Selah.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}