{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician, A Psalm for the sons of Korah."]},{"type":"verse","number":1,"content":[{"text":"O clap your hands, all ye people;","poem":1},{"lineBreak":true},{"text":"Shout unto God with the voice of triumph.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For the Lord most High is terrible;","poem":1},{"lineBreak":true},{"text":"He is a great King over all the earth.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He shall subdue the people under us,","poem":1},{"lineBreak":true},{"text":"And the nations under our feet.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He shall choose our inheritance for us,","poem":1},{"lineBreak":true},{"text":"The excellency of Jacob whom he loved. Selah.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"God is gone up with a shout,","poem":1},{"lineBreak":true},{"text":"The Lord with the sound of a trumpet.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sing praises to God, sing praises:","poem":1},{"lineBreak":true},{"text":"Sing praises unto our King, sing praises.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For God is the King of all the earth:","poem":1},{"lineBreak":true},{"text":"Sing ye praises with understanding.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"God reigneth over the heathen:","poem":1},{"lineBreak":true},{"text":"God sitteth upon the throne of his holiness.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The princes of the people are gathered together,","poem":1},{"lineBreak":true},{"text":"Even the people of the God of Abraham:","poem":1},{"lineBreak":true},{"text":"For the shields of the earth belong unto God:","poem":1},{"lineBreak":true},{"text":"He is greatly exalted.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}