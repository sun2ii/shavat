{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"hebrew_subtitle","content":["A Song and Psalm for the sons of Korah."]},{"type":"verse","number":1,"content":[{"text":"Great is the Lord, and greatly to be praised","poem":1},{"lineBreak":true},{"text":"In the city of our God, in the mountain of his holiness.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Beautiful for situation, the joy of the whole earth, is mount Zion,","poem":1},{"lineBreak":true},{"text":"On the sides of the north, the city of the great King.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"God is known in her palaces for a refuge.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For lo, the kings were assembled, they passed by together.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"They saw it, and so they marvelled;","poem":1},{"lineBreak":true},{"text":"They were troubled, and hasted away.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fear took hold upon them there,","poem":1},{"lineBreak":true},{"text":"And pain, as of a woman in travail.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Thou breakest the ships of Tarshish with an east wind.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"As we have heard, so have we seen","poem":1},{"lineBreak":true},{"text":"In the city of the Lord of hosts, in the city of our God:","poem":1},{"lineBreak":true},{"text":"God will establish it for ever. Selah.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"We have thought of thy lovingkindness, O God,","poem":1},{"lineBreak":true},{"text":"In the midst of thy temple.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"According to thy name, O God, so is thy praise unto the ends of the earth:","poem":1},{"lineBreak":true},{"text":"Thy right hand is full of righteousness.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Let mount Zion rejoice,","poem":1},{"lineBreak":true},{"text":"Let the daughters of Judah be glad,","poem":1},{"lineBreak":true},{"text":"Because of thy judgments.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Walk about Zion, and go round about her: tell the towers thereof.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mark ye well her bulwarks, consider her palaces;","poem":1},{"lineBreak":true},{"text":"That ye may tell it to the generation following.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"For this God is our God for ever and ever:","poem":1},{"lineBreak":true},{"text":"He will be our guide even unto death.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}