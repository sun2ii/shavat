{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":52,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician, Maschil, A Psalm of David, when Doeg the Edomite came and told Saul, and said unto him, David is come to the house of Ahimelech."]},{"type":"verse","number":1,"content":[{"text":"Why boastest thou thyself in mischief, O mighty man?","poem":1},{"lineBreak":true},{"text":"The goodness of God endureth continually.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Thy tongue deviseth mischiefs;","poem":1},{"lineBreak":true},{"text":"Like a sharp rasor, working deceitfully.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Thou lovest evil more than good;","poem":1},{"lineBreak":true},{"text":"And lying rather than to speak righteousness. Selah.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Thou lovest all devouring words,","poem":1},{"lineBreak":true},{"text":"O thou deceitful tongue.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"God shall likewise destroy thee for ever,","poem":1},{"lineBreak":true},{"text":"He shall take thee away, and pluck thee out of thy dwelling place,","poem":1},{"lineBreak":true},{"text":"And root thee out of the land of the living. Selah.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The righteous also shall see, and fear,","poem":1},{"lineBreak":true},{"text":"And shall laugh at him:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lo, this is the man that made not God his strength;","poem":1},{"lineBreak":true},{"text":"But trusted in the abundance of his riches,","poem":1},{"lineBreak":true},{"text":"And strengthened himself in his wickedness.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"But I am like a green olive tree in the house of God:","poem":1},{"lineBreak":true},{"text":"I trust in the mercy of God for ever and ever.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I will praise thee for ever, because thou hast done it:","poem":1},{"lineBreak":true},{"text":"And I will wait on thy name; for it is good before thy saints.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}