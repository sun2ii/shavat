{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":53,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician upon Mahalath, Maschil, A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"The fool hath said in his heart, There is no God.","poem":1},{"lineBreak":true},{"text":"Corrupt are they, and have done abominable iniquity:","poem":1},{"lineBreak":true},{"text":"There is none that doeth good.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"God looked down from heaven upon the children of men,","poem":1},{"lineBreak":true},{"text":"To see if there were any that did understand, that did seek God.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Every one of them is gone back, they are altogether become filthy;","poem":1},{"lineBreak":true},{"text":"There is none that doeth good, no, not one.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Have the workers of iniquity no knowledge?","poem":1},{"lineBreak":true},{"text":"Who eat up my people as they eat bread:","poem":1},{"lineBreak":true},{"text":"They have not called upon God.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"There were they in great fear, where no fear was:","poem":1},{"lineBreak":true},{"text":"For God hath scattered the bones of him that encampeth against thee:","poem":1},{"lineBreak":true},{"text":"Thou hast put them to shame, because God hath despised them.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"O that the salvation of Israel were come out of Zion!","poem":1},{"lineBreak":true},{"text":"When God bringeth back the captivity of his people,","poem":1},{"lineBreak":true},{"text":"Jacob shall rejoice, and Israel shall be glad.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}