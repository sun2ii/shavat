{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician on Neginoth, Maschil, A Psalm of David, when the Ziphims came and said to Saul, Doth not David hide himself with us?"]},{"type":"verse","number":1,"content":[{"text":"Save me, O God, by thy name,","poem":1},{"lineBreak":true},{"text":"And judge me by thy strength.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hear my prayer, O God;","poem":1},{"lineBreak":true},{"text":"Give ear to the words of my mouth.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For strangers are risen up against me,","poem":1},{"lineBreak":true},{"text":"And oppressors seek after my soul:","poem":1},{"lineBreak":true},{"text":"They have not set God before them. Selah.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Behold, God is mine helper:","poem":1},{"lineBreak":true},{"text":"The Lord is with them that uphold my soul.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"He shall reward evil unto mine enemies:","poem":1},{"lineBreak":true},{"text":"Cut them off in thy truth.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I will freely sacrifice unto thee:","poem":1},{"lineBreak":true},{"text":"I will praise thy name, O Lord; for it is good.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For he hath delivered me out of all trouble:","poem":1},{"lineBreak":true},{"text":"And mine eye hath seen his desire upon mine enemies.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}