{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":6,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician on Neginoth upon Sheminith, A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"O Lord, rebuke me not in thine anger,","poem":1},{"lineBreak":true},{"text":"Neither chasten me in thy hot displeasure.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Have mercy upon me, O Lord; for I am weak:","poem":1},{"lineBreak":true},{"text":"O Lord, heal me; for my bones are vexed.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"My soul is also sore vexed:","poem":1},{"lineBreak":true},{"text":"But thou, O Lord, how long?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Return, O Lord, deliver my soul:","poem":1},{"lineBreak":true},{"text":"O save me for thy mercy’s sake.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For in death there is no remembrance of thee:","poem":1},{"lineBreak":true},{"text":"In the grave who shall give thee thanks?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I am weary with my groaning;","poem":1},{"lineBreak":true},{"text":"All the night make I my bed to swim;","poem":1},{"lineBreak":true},{"text":"I water my couch with my tears.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mine eye is consumed because of grief;","poem":1},{"lineBreak":true},{"text":"It waxeth old because of all mine enemies.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Depart from me, all ye workers of iniquity;","poem":1},{"lineBreak":true},{"text":"For the Lord hath heard the voice of my weeping.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The Lord hath heard my supplication;","poem":1},{"lineBreak":true},{"text":"The Lord will receive my prayer.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Let all mine enemies be ashamed and sore vexed:","poem":1},{"lineBreak":true},{"text":"Let them return and be ashamed suddenly.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}