{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician upon Neginah, A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Hear my cry, O God;","poem":1},{"lineBreak":true},{"text":"Attend unto my prayer.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"From the end of the earth will I cry unto thee, when my heart is overwhelmed:","poem":1},{"lineBreak":true},{"text":"Lead me to the rock that is higher than I.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For thou hast been a shelter for me,","poem":1},{"lineBreak":true},{"text":"And a strong tower from the enemy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I will abide in thy tabernacle for ever:","poem":1},{"lineBreak":true},{"text":"I will trust in the covert of thy wings. Selah.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For thou, O God, hast heard my vows:","poem":1},{"lineBreak":true},{"text":"Thou hast given me the heritage of those that fear thy name.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Thou wilt prolong the king’s life:","poem":1},{"lineBreak":true},{"text":"And his years as many generations.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He shall abide before God for ever:","poem":1},{"lineBreak":true},{"text":"O prepare mercy and truth, which may preserve him.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"So will I sing praise unto thy name for ever,","poem":1},{"lineBreak":true},{"text":"That I may daily perform my vows.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}