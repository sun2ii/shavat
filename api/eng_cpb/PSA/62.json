{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":62,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician, to Jeduthun, A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Truly my soul waiteth upon God:","poem":1},{"lineBreak":true},{"text":"From him cometh my salvation.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"He only is my rock and my salvation;","poem":1},{"lineBreak":true},{"text":"He is my defence; I shall not be greatly moved.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"How long will ye imagine mischief against a man?","poem":1},{"lineBreak":true},{"text":"Ye shall be slain all of you:","poem":1},{"lineBreak":true},{"text":"As a bowing wall shall ye be, and as a tottering fence.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"They only consult to cast him down from his excellency:","poem":1},{"lineBreak":true},{"text":"They delight in lies:","poem":1},{"lineBreak":true},{"text":"They bless with their mouth, but they curse inwardly. Selah.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"My soul, wait thou only upon God;","poem":1},{"lineBreak":true},{"text":"For my expectation is from him.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He only is my rock and my salvation:","poem":1},{"lineBreak":true},{"text":"He is my defence; I shall not be moved.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"In God is my salvation and my glory:","poem":1},{"lineBreak":true},{"text":"The rock of my strength, and my refuge, is in God.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Trust in him at all times; ye people,","poem":1},{"lineBreak":true},{"text":"Pour out your heart before him:","poem":1},{"lineBreak":true},{"text":"God is a refuge for us. Selah.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Surely men of low degree are vanity, and men of high degree are a lie:","poem":1},{"lineBreak":true},{"text":"To be laid in the balance, they are altogether lighter than vanity.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Trust not in oppression,","poem":1},{"lineBreak":true},{"text":"And become not vain in robbery:","poem":1},{"lineBreak":true},{"text":"If riches increase, set not your heart upon them.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"God hath spoken once;","poem":1},{"lineBreak":true},{"text":"Twice have I heard this;","poem":1},{"lineBreak":true},{"text":"That power belongeth unto God.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Also unto thee, O Lord, belongeth mercy:","poem":1},{"lineBreak":true},{"text":"For thou renderest to every man according to his work.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}