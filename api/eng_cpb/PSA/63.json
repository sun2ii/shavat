{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David, when he was in the wilderness of Judah."]},{"type":"verse","number":1,"content":[{"text":"O God, thou art my God; early will I seek thee:","poem":1},{"lineBreak":true},{"text":"My soul thirsteth for thee,","poem":1},{"lineBreak":true},{"text":"My flesh longeth for thee,","poem":1},{"lineBreak":true},{"text":"In a dry and thirsty land, where no water is;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"To see thy power and thy glory,","poem":1},{"lineBreak":true},{"text":"So as I have seen thee in the sanctuary.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Because thy lovingkindness is better than life,","poem":1},{"lineBreak":true},{"text":"My lips shall praise thee.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Thus will I bless thee while I live:","poem":1},{"lineBreak":true},{"text":"I will lift up my hands in thy name.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"My soul shall be satisfied as with marrow and fatness;","poem":1},{"lineBreak":true},{"text":"And my mouth shall praise thee with joyful lips:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"When I remember thee upon my bed,","poem":1},{"lineBreak":true},{"text":"And meditate on thee in the night watches.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Because thou hast been my help,","poem":1},{"lineBreak":true},{"text":"Therefore in the shadow of thy wings will I rejoice.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"My soul followeth hard after thee:","poem":1},{"lineBreak":true},{"text":"Thy right hand upholdeth me.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"But those that seek my soul, to destroy it,","poem":1},{"lineBreak":true},{"text":"Shall go into the lower parts of the earth.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"They shall fall by the sword:","poem":1},{"lineBreak":true},{"text":"They shall be a portion for foxes.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"But the king shall rejoice in God;","poem":1},{"lineBreak":true},{"text":"Every one that sweareth by him shall glory:","poem":1},{"lineBreak":true},{"text":"But the mouth of them that speak lies shall be stopped.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}