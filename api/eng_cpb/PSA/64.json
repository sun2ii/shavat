{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician, A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Hear my voice, O God, in my prayer:","poem":1},{"lineBreak":true},{"text":"Preserve my life from fear of the enemy.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hide me from the secret counsel of the wicked;","poem":1},{"lineBreak":true},{"text":"From the insurrection of the workers of iniquity:","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Who whet their tongue like a sword,","poem":1},{"lineBreak":true},{"text":"And bend their bows to shoot their arrows, even bitter words:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"That they may shoot in secret at the perfect:","poem":1},{"lineBreak":true},{"text":"Suddenly do they shoot at him, and fear not.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"They encourage themselves in an evil matter:","poem":1},{"lineBreak":true},{"text":"They commune of laying snares privily;","poem":1},{"lineBreak":true},{"text":"They say, Who shall see them?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"They search out iniquities;","poem":1},{"lineBreak":true},{"text":"They accomplish a diligent search:","poem":1},{"lineBreak":true},{"text":"Both the inward thought of every one of them, and the heart, is deep.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"But God shall shoot at them with an arrow;","poem":1},{"lineBreak":true},{"text":"Suddenly shall they be wounded.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"So they shall make their own tongue to fall upon themselves:","poem":1},{"lineBreak":true},{"text":"All that see them shall flee away.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"And all men shall fear,","poem":1},{"lineBreak":true},{"text":"And shall declare the work of God;","poem":1},{"lineBreak":true},{"text":"For they shall wisely consider of his doing.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"The righteous shall be glad in the Lord, and shall trust in him;","poem":1},{"lineBreak":true},{"text":"And all the upright in heart shall glory.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}