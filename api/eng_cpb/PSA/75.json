{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician, Al-taschith, A Psalm or Song of Asaph."]},{"type":"verse","number":1,"content":[{"text":"Unto thee, O God, do we give thanks, unto thee do we give thanks:","poem":1},{"lineBreak":true},{"text":"For that thy name is near thy wondrous works declare.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"When I shall receive the congregation","poem":1},{"lineBreak":true},{"text":"I will judge uprightly.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The earth and all the inhabitants thereof are dissolved:","poem":1},{"lineBreak":true},{"text":"I bear up the pillars of it. Selah.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I said unto the fools, Deal not foolishly:","poem":1},{"lineBreak":true},{"text":"And to the wicked, Lift not up the horn:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lift not up your horn on high:","poem":1},{"lineBreak":true},{"text":"Speak not with a stiff neck.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"For promotion cometh neither from the east,","poem":1},{"lineBreak":true},{"text":"Nor from the west, nor from the south.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"But God is the judge:","poem":1},{"lineBreak":true},{"text":"He putteth down one, and setteth up another.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For in the hand of the Lord there is a cup, and the wine is red;","poem":1},{"lineBreak":true},{"text":"It is full of mixture; and he poureth out of the same:","poem":1},{"lineBreak":true},{"text":"But the dregs thereof, all the wicked of the earth shall wring them out, and drink them.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"But I will declare for ever;","poem":1},{"lineBreak":true},{"text":"I will sing praises to the God of Jacob.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"All the horns of the wicked also will I cut off;","poem":1},{"lineBreak":true},{"text":"But the horns of the righteous shall be exalted.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}