{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":76,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician on Neginoth, A Psalm or Song of Asaph."]},{"type":"verse","number":1,"content":[{"text":"In Judah is God known:","poem":1},{"lineBreak":true},{"text":"His name is great in Israel.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"In Salem also is his tabernacle,","poem":1},{"lineBreak":true},{"text":"And his dwelling place in Zion.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"There brake he the arrows of the bow,","poem":1},{"lineBreak":true},{"text":"The shield, and the sword, and the battle. Selah.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Thou art more glorious and excellent than the mountains of prey.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The stouthearted are spoiled, they have slept their sleep:","poem":1},{"lineBreak":true},{"text":"And none of the men of might have found their hands.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"At thy rebuke, O God of Jacob,","poem":1},{"lineBreak":true},{"text":"Both the chariot and horse are cast into a dead sleep.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Thou, even thou, art to be feared:","poem":1},{"lineBreak":true},{"text":"And who may stand in thy sight when once thou art angry?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Thou didst cause judgment to be heard from heaven;","poem":1},{"lineBreak":true},{"text":"The earth feared, and was still,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"When God arose to judgment,","poem":1},{"lineBreak":true},{"text":"To save all the meek of the earth. Selah.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Surely the wrath of man shall praise thee:","poem":1},{"lineBreak":true},{"text":"The remainder of wrath shalt thou restrain.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Vow, and pay unto the Lord your God:","poem":1},{"lineBreak":true},{"text":"Let all that be round about him bring presents unto him that ought to be feared.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"He shall cut off the spirit of princes: He is terrible to the kings of the earth.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}