{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician upon Gittith, A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"O Lord our Lord,","poem":1},{"lineBreak":true},{"text":"How excellent is thy name in all the earth!","poem":1},{"lineBreak":true},{"text":"Who hast set thy glory above the heavens.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Out of the mouth of babes and sucklings hast thou ordained strength","poem":1},{"lineBreak":true},{"text":"Because of thine enemies,","poem":1},{"lineBreak":true},{"text":"That thou mightest still the enemy and the avenger.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"When I consider thy heavens, the work of thy fingers,","poem":1},{"lineBreak":true},{"text":"The moon and the stars, which thou hast ordained;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"What is man, that thou art mindful of him?","poem":1},{"lineBreak":true},{"text":"And the son of man, that thou visitest him?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For thou hast made him a little lower than the angels,","poem":1},{"lineBreak":true},{"text":"And hast crowned him with glory and honour.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Thou madest him to have dominion over the works of thy hands;","poem":1},{"lineBreak":true},{"text":"Thou hast put all things under his feet:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"All sheep and oxen,","poem":1},{"lineBreak":true},{"text":"Yea, and the beasts of the field;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The fowl of the air, and the fish of the sea,","poem":1},{"lineBreak":true},{"text":"And whatsoever passeth through the paths of the seas.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O Lord our Lord,","poem":1},{"lineBreak":true},{"text":"How excellent is thy name in all the earth!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}