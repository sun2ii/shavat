{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["A Psalm of Asaph."]},{"type":"verse","number":1,"content":[{"text":"God standeth in the congregation of the mighty;","poem":1},{"lineBreak":true},{"text":"He judgeth among the gods.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"How long will ye judge unjustly,","poem":1},{"lineBreak":true},{"text":"And accept the persons of the wicked? Selah.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Defend the poor and fatherless:","poem":1},{"lineBreak":true},{"text":"Do justice to the afflicted and needy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Deliver the poor and needy:","poem":1},{"lineBreak":true},{"text":"Rid them out of the hand of the wicked.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"They know not, neither will they understand;","poem":1},{"lineBreak":true},{"text":"They walk on in darkness:","poem":1},{"lineBreak":true},{"text":"All the foundations of the earth are out of course.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I have said, Ye are gods;","poem":1},{"lineBreak":true},{"text":"And all of you are children of the most High.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"But ye shall die like men,","poem":1},{"lineBreak":true},{"text":"And fall like one of the princes.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Arise, O God, judge the earth:","poem":1},{"lineBreak":true},{"text":"For thou shalt inherit all nations.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}