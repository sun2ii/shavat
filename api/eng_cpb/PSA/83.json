{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":83,"content":[{"type":"hebrew_subtitle","content":["A Song or Psalm of Asaph."]},{"type":"verse","number":1,"content":[{"text":"Keep not thou silence, O God:","poem":1},{"lineBreak":true},{"text":"Hold not thy peace, and be not still, O God.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For lo, thine enemies make a tumult:","poem":1},{"lineBreak":true},{"text":"And they that hate thee have lift up the head.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"They have taken crafty counsel against thy people,","poem":1},{"lineBreak":true},{"text":"And consulted against thy hidden ones.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"They have said, Come, and let us cut them off from being a nation;","poem":1},{"lineBreak":true},{"text":"That the name of Israel may be no more in remembrance.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For they have consulted together with one consent:","poem":1},{"lineBreak":true},{"text":"They are confederate against thee:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The tabernacles of Edom, and the Ishmaelites;","poem":1},{"lineBreak":true},{"text":"Of Moab, and the Hagarenes;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gebal, and Ammon, and Amalek;","poem":1},{"lineBreak":true},{"text":"The Philistines with the inhabitants of Tyre;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Assur also is joined with them:","poem":1},{"lineBreak":true},{"text":"They have holpen the children of Lot. Selah.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Do unto them as unto the Midianites;","poem":1},{"lineBreak":true},{"text":"As to Sisera, as to Jabin, at the brook of Kison:","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Which perished at En-dor:","poem":1},{"lineBreak":true},{"text":"They became as dung for the earth.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Make their nobles like Oreb, and like Zeeb:","poem":1},{"lineBreak":true},{"text":"Yea, all their princes as Zebah, and as Zalmunna:","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Who said, Let us take to ourselves","poem":1},{"lineBreak":true},{"text":"The houses of God in possession.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"O my God, make them like a wheel;","poem":1},{"lineBreak":true},{"text":"As the stubble before the wind.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"As the fire burneth a wood,","poem":1},{"lineBreak":true},{"text":"And as the flame setteth the mountains on fire;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"So persecute them with thy tempest,","poem":1},{"lineBreak":true},{"text":"And make them afraid with thy storm.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Fill their faces with shame;","poem":1},{"lineBreak":true},{"text":"That they may seek thy name, O Lord.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Let them be confounded and troubled for ever;","poem":1},{"lineBreak":true},{"text":"Yea, let them be put to shame, and perish:","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"That men may know that thou, whose name alone is JEHOVAH,","poem":1},{"lineBreak":true},{"text":"Art the most High over all the earth.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}