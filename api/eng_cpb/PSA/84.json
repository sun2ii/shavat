{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":84,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician upon Gittith, A Psalm for the sons of Korah."]},{"type":"verse","number":1,"content":[{"text":"How amiable are thy tabernacles, O Lord of hosts!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"My soul longeth, yea, even fainteth for the courts of the Lord:","poem":1},{"lineBreak":true},{"text":"My heart and my flesh crieth out for the living God.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yea, the sparrow hath found a house,","poem":1},{"lineBreak":true},{"text":"And the swallow a nest for herself, where she may lay her young,","poem":1},{"lineBreak":true},{"text":"Even thine altars, O Lord of hosts, my King, and my God.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Blessed are they that dwell in thy house:","poem":1},{"lineBreak":true},{"text":"They will be still praising thee. Selah.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Blessed is the man whose strength is in thee;","poem":1},{"lineBreak":true},{"text":"In whose heart are the ways of them.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Who passing through the valley of Baca make it a well;","poem":1},{"lineBreak":true},{"text":"The rain also filleth the pools.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"They go from strength to strength,","poem":1},{"lineBreak":true},{"text":"Every one of them in Zion appeareth before God.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"O Lord God of hosts, hear my prayer:","poem":1},{"lineBreak":true},{"text":"Give ear, O God of Jacob. Selah.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Behold, O God our shield,","poem":1},{"lineBreak":true},{"text":"And look upon the face of thine anointed.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"For a day in thy courts is better than a thousand.","poem":1},{"lineBreak":true},{"text":"I had rather be a doorkeeper in the house of my God,","poem":1},{"lineBreak":true},{"text":"Than to dwell in the tents of wickedness.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"For the Lord God is a sun and shield:","poem":1},{"lineBreak":true},{"text":"The Lord will give grace and glory:","poem":1},{"lineBreak":true},{"text":"No good thing will he withhold from them that walk uprightly.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"O Lord of hosts,","poem":1},{"lineBreak":true},{"text":"Blessed is the man that trusteth in thee.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}