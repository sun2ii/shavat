{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":85,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician, A Psalm for the sons of Korah."]},{"type":"verse","number":1,"content":[{"text":"Lord, thou hast been favourable unto thy land:","poem":1},{"lineBreak":true},{"text":"Thou hast brought back the captivity of Jacob.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Thou hast forgiven the iniquity of thy people,","poem":1},{"lineBreak":true},{"text":"Thou hast covered all their sin. Selah.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Thou hast taken away all thy wrath:","poem":1},{"lineBreak":true},{"text":"Thou hast turned thyself from the fierceness of thine anger.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Turn us, O God of our salvation,","poem":1},{"lineBreak":true},{"text":"And cause thine anger towards us to cease.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wilt thou be angry with us for ever?","poem":1},{"lineBreak":true},{"text":"Wilt thou draw out thine anger to all generations?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wilt thou not revive us again:","poem":1},{"lineBreak":true},{"text":"That thy people may rejoice in thee?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Shew us thy mercy, O Lord,","poem":1},{"lineBreak":true},{"text":"And grant us thy salvation.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"I will hear what God the Lord will speak:","poem":1},{"lineBreak":true},{"text":"For he will speak peace unto his people, and to his saints:","poem":1},{"lineBreak":true},{"text":"But let them not turn again to folly.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Surely his salvation is nigh them that fear him;","poem":1},{"lineBreak":true},{"text":"That glory may dwell in our land.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mercy and truth are met together;","poem":1},{"lineBreak":true},{"text":"Righteousness and peace have kissed each other.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Truth shall spring out of the earth;","poem":1},{"lineBreak":true},{"text":"And righteousness shall look down from heaven.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yea, the Lord shall give that which is good;","poem":1},{"lineBreak":true},{"text":"And our land shall yield her increase.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Righteousness shall go before him;","poem":1},{"lineBreak":true},{"text":"And shall set us in the way of his steps.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}