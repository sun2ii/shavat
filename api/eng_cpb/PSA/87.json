{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["A Psalm or Song for the sons of Korah."]},{"type":"verse","number":1,"content":[{"text":"His foundation is in the holy mountains.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The Lord loveth the gates of Zion","poem":1},{"lineBreak":true},{"text":"More than all the dwellings of Jacob.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Glorious things are spoken of thee,","poem":1},{"lineBreak":true},{"text":"O city of God. Selah.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"I will make mention of Rahab and Babylon to them that know me:","poem":1},{"lineBreak":true},{"text":"Behold Philistia, and Tyre, with Ethiopia;","poem":1},{"lineBreak":true},{"text":"This man was born there.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"And of Zion it shall be said, This and that man was born in her:","poem":1},{"lineBreak":true},{"text":"And the Highest himself shall establish her.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The Lord shall count, when he writeth up the people,","poem":1},{"lineBreak":true},{"text":"That this man was born there. Selah.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"As well the singers as the players on instruments shall be there:","poem":1},{"lineBreak":true},{"text":"All my springs are in thee.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}