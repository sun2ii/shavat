{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"O come, let us sing unto the Lord:","poem":1},{"lineBreak":true},{"text":"Let us make a joyful noise to the rock of our salvation.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Let us come before his presence with thanksgiving,","poem":1},{"lineBreak":true},{"text":"And make a joyful noise unto him with psalms.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For the Lord is a great God,","poem":1},{"lineBreak":true},{"text":"And a great King above all gods.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"In his hand are the deep places of the earth:","poem":1},{"lineBreak":true},{"text":"The strength of the hills is his also.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The sea is his, and he made it:","poem":1},{"lineBreak":true},{"text":"And his hands formed the dry land.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"O come, let us worship and bow down:","poem":1},{"lineBreak":true},{"text":"Let us kneel before the Lord our Maker.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For he is our God;","poem":1},{"lineBreak":true},{"text":"And we are the people of his pasture, and the sheep of his hand.","poem":1},{"lineBreak":true},{"text":"To day if ye will hear his voice,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Harden not your heart, as in the provocation,","poem":1},{"lineBreak":true},{"text":"And as in the day of temptation in the wilderness:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"When your fathers tempted me,","poem":1},{"lineBreak":true},{"text":"Proved me, and saw my work.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Forty years long was I grieved with this generation,","poem":1},{"lineBreak":true},{"text":"And said, It is a people that do err in their heart,","poem":1},{"lineBreak":true},{"text":"And they have not known my ways:","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Unto whom I sware in my wrath","poem":1},{"lineBreak":true},{"text":"That they should not enter into my rest.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}