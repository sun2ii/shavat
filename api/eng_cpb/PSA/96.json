{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":96,"content":[{"type":"verse","number":1,"content":[{"text":"O sing unto the Lord a new song:","poem":1},{"lineBreak":true},{"text":"Sing unto the Lord, all the earth.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sing unto the Lord, bless his name;","poem":1},{"lineBreak":true},{"text":"Shew forth his salvation from day to day.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Declare his glory among the heathen,","poem":1},{"lineBreak":true},{"text":"His wonders among all people.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For the Lord is great, and greatly to be praised:","poem":1},{"lineBreak":true},{"text":"He is to be feared above all gods.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For all the gods of the nations are idols:","poem":1},{"lineBreak":true},{"text":"But the Lord made the heavens.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Honour and majesty are before him:","poem":1},{"lineBreak":true},{"text":"Strength and beauty are in his sanctuary.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Give unto the Lord, O ye kindreds of the people,","poem":1},{"lineBreak":true},{"text":"Give unto the Lord glory and strength.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Give unto the Lord the glory due unto his name:","poem":1},{"lineBreak":true},{"text":"Bring an offering, and come into his courts.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O worship the Lord in the beauty of holiness:","poem":1},{"lineBreak":true},{"text":"Fear before him, all the earth.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Say among the heathen that the Lord reigneth:","poem":1},{"lineBreak":true},{"text":"The world also shall be established that it shall not be moved:","poem":1},{"lineBreak":true},{"text":"He shall judge the people righteously.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Let the heavens rejoice, and let the earth be glad;","poem":1},{"lineBreak":true},{"text":"Let the sea roar, and the fulness thereof.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Let the field be joyful, and all that is therein:","poem":1},{"lineBreak":true},{"text":"Then shall all the trees of the wood rejoice","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Before the Lord, for he cometh,","poem":1},{"lineBreak":true},{"text":"For he cometh to judge the earth:","poem":1},{"lineBreak":true},{"text":"He shall judge the world with righteousness,","poem":1},{"lineBreak":true},{"text":"And the people with his truth.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}