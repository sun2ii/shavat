{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"The Lord reigneth; let the earth rejoice;","poem":1},{"lineBreak":true},{"text":"Let the multitude of isles be glad thereof.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Clouds and darkness are round about him:","poem":1},{"lineBreak":true},{"text":"Righteousness and judgment are the habitation of his throne.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A fire goeth before him,","poem":1},{"lineBreak":true},{"text":"And burneth up his enemies round about.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"His lightnings enlightened the world:","poem":1},{"lineBreak":true},{"text":"The earth saw, and trembled.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The hills melted like wax at the presence of the Lord,","poem":1},{"lineBreak":true},{"text":"At the presence of the Lord of the whole earth.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The heavens declare his righteousness,","poem":1},{"lineBreak":true},{"text":"And all the people see his glory.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Confounded be all they that serve graven images,","poem":1},{"lineBreak":true},{"text":"That boast themselves of idols:","poem":1},{"lineBreak":true},{"text":"Worship him, all ye gods.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Zion heard, and was glad,","poem":1},{"lineBreak":true},{"text":"And the daughters of Judah rejoiced,","poem":1},{"lineBreak":true},{"text":"Because of thy judgments, O Lord.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"For thou, Lord, art High above all the earth:","poem":1},{"lineBreak":true},{"text":"Thou art exalted far above all gods.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ye that love the Lord, hate evil:","poem":1},{"lineBreak":true},{"text":"He preserveth the souls of his saints;","poem":1},{"lineBreak":true},{"text":"He delivereth them out of the hand of the wicked.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Light is sown for the righteous,","poem":1},{"lineBreak":true},{"text":"And gladness for the upright in heart.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Rejoice in the Lord, ye righteous;","poem":1},{"lineBreak":true},{"text":"And give thanks at the remembrance of his holiness.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}