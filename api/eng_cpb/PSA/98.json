{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"hebrew_subtitle","content":["A Psalm."]},{"type":"verse","number":1,"content":[{"text":"O sing unto the Lord a new song;","poem":1},{"lineBreak":true},{"text":"For he hath done marvellous things:","poem":1},{"lineBreak":true},{"text":"His right hand, and his holy arm, hath gotten him the victory.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The Lord hath made known his salvation:","poem":1},{"lineBreak":true},{"text":"His righteousness hath he openly shewed in the sight of the heathen.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He hath remembered his mercy and his truth toward the house of Israel:","poem":1},{"lineBreak":true},{"text":"All the ends of the earth have seen the salvation of our God.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Make a joyful noise unto the Lord, all the earth:","poem":1},{"lineBreak":true},{"text":"Make a loud noise, and rejoice, and sing praise.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sing unto the Lord with the harp;","poem":1},{"lineBreak":true},{"text":"With the harp, and the voice of a psalm.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"With trumpets and sound of cornet","poem":1},{"lineBreak":true},{"text":"Make a joyful noise before the Lord, the King.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Let the sea roar, and the fulness thereof;","poem":1},{"lineBreak":true},{"text":"The world, and they that dwell therein.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Let the floods clap their hands:","poem":1},{"lineBreak":true},{"text":"Let the hills be joyful together","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Before the Lord; for he cometh to judge the earth:","poem":1},{"lineBreak":true},{"text":"With righteousness shall he judge the world,","poem":1},{"lineBreak":true},{"text":"And the people with equity.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}