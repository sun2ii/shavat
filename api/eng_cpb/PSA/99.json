{"translation":{"id":"eng_cpb","name":"KJV Cambridge Paragraph Bible","website":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engkjvcpb","licenseNotes":null,"shortName":"KJVCP","englishName":"KJV Cambridge Paragraph","language":"eng","textDirection":"ltr","sha256":"2955d253af1df26c84ad0e0ab5d7d6beee558a8f67d7975b16b047e522baa354","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_cpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":172,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_cpb","name":"Psalms","commonName":"Psalms","title":"THE BOOK OF PSALMS.","order":19,"numberOfChapters":150,"sha256":"0fda0ecfe93bc3f5bf3d9a709d698b7c668c2bf7528f647e008d4ede04622f18","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_cpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_cpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"The Lord reigneth; let the people tremble:","poem":1},{"lineBreak":true},{"text":"He sitteth between the cherubims; let the earth be moved.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The Lord is great in Zion;","poem":1},{"lineBreak":true},{"text":"And he is high above all the people.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let them praise thy great and terrible name;","poem":1},{"lineBreak":true},{"text":"For it is holy.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"The king’s strength also loveth judgment;","poem":1},{"lineBreak":true},{"text":"Thou dost establish equity,","poem":1},{"lineBreak":true},{"text":"Thou executest judgment and righteousness in Jacob.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Exalt ye the Lord our God,","poem":1},{"lineBreak":true},{"text":"And worship at his footstool;","poem":1},{"lineBreak":true},{"text":"For he is holy.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Moses and Aaron among his priests,","poem":1},{"lineBreak":true},{"text":"And Samuel among them that call upon his name;","poem":1},{"lineBreak":true},{"text":"They called upon the Lord, and he answered them.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He spake unto them in the cloudy pillar:","poem":1},{"lineBreak":true},{"text":"They kept his testimonies, and the ordinance that he gave them.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Thou answeredst them, O Lord our God:","poem":1},{"lineBreak":true},{"text":"Thou wast a God that forgavest them,","poem":1},{"lineBreak":true},{"text":"Though thou tookest vengeance of their inventions.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Exalt the Lord our God,","poem":1},{"lineBreak":true},{"text":"And worship at his holy hill;","poem":1},{"lineBreak":true},{"text":"For the Lord our God is holy.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_cpb/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_cpb/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_cpb/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}