{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Blessed is the man who hath not walked in the counsel of the ungodly, nor stood in the way of sinners, nor sat in the chair of pestilence.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"But his will is in the law of the Lord, and on his law he shall meditate day and night.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"And he shall be like a tree which is planted near the running waters, which shall bring forth its fruit, in due season. And his leaf shall not fall off: and all whatsoever he shall do shall prosper.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Not so the wicked, not so: but like the dust, which the wind driveth from the face of the earth.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Therefore the wicked shall not rise again in judgment: nor sinners in the council of the just.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"For the Lord knoweth the way of the just: and the way of the wicked shall perish.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}