{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Unto the end. A psalm for David.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"In the Lord I put my trust: how then do you say to my soul: Get thee away from hence to the mountain like a sparrow?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For, lo, the wicked have bent their bow; they have prepared their arrows in the quiver; to shoot in the dark the upright of heart.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For they have destroyed the things which thou hast made: but what has the just man done?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The Lord is in his holy temple, the Lord’s throne is in heaven. His eyes look on the poor man: his eyelids examine the sons of men.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The Lord trieth the just and the wicked: but he that loveth iniquity hateth his own soul.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He shall rain snares upon sinners: fire and brimstone and storms of winds shall be the portion of their cup.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For the Lord is just, and hath loved justice: his countenance hath beheld righteousness.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":8}