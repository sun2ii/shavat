{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":109,"content":[{"type":"verse","number":1,"content":[{"text":"The Lord said to my Lord: Sit thou at my right hand: Until I make thy enemies thy footstool.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The Lord will send forth the sceptre of thy power out of Sion: rule thou in the midst of thy enemies.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"With thee is the principality in the day of thy strength: in the brightness of the saints: from the womb before the day star I begot thee.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The Lord hath sworn, and he will not repent: Thou art a priest for ever according to the order of Melchisedech.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The Lord at thy right hand hath broken kings in the day of his wrath.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He shall judge among nations, he shall fill ruins: he shall crush the heads in the land of the many.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He shall drink of the torrent in the way: therefore shall he lift up the head.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":7}