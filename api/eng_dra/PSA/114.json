{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"I have loved, because the Lord will hear the voice of my prayer.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Because he hath inclined his ear unto me: and in my days I will call upon him.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The sorrows of death have encompassed me: and the perils of hell have found me. I met with trouble and sorrow:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"And I called upon the name of the Lord. O Lord, deliver my soul.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The Lord is merciful and just, and our God sheweth mercy.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The Lord is the keeper of little ones: I was little and he delivered me.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Turn, O my soul, into thy rest: for the Lord hath been bountiful to thee.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For he hath delivered my soul from death: my eyes from tears, my feet from falling.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I will please the Lord in the land of the living.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":9}