{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"I have believed, therefore have I spoken; but I have been humbled exceedingly.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I said in my excess: Every man is a liar.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"What shall I render to the Lord, for all the things he hath rendered unto me?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I will take the chalice of salvation; and I will call upon the name of the Lord.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I will pay my vows to the Lord before all his people:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Precious in the sight of the Lord is the death of his saints.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"O Lord, for I am thy servant: I am thy servant, and the son of thy handmaid. Thou hast broken my bonds:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I will sacrifice to thee the sacrifice of praise, and I will call upon the name of the Lord.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I will pay my vows to the Lord in the sight of all his people:","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"In the courts of the house of the Lord, in the midst of thee, O Jerusalem.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":10}