{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Unto the end, a psalm for David. How long, O Lord, wilt thou forget me unto the end? how long dost thou turn away thy face from me?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"How long shall I take counsels in my soul, sorrow in my heart all the day?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"How long shall my enemy be exalted over me?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Consider, and hear me, O Lord my God. Enlighten my eyes that I never sleep in death:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lest at any time my enemy say: I have prevailed against him. They that trouble me will rejoice when I am moved:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"But I have trusted in thy mercy. My heart shall rejoice in thy salvation: I will sing to the Lord, who giveth me good things: yea I will sing to the name of the Lord the most high.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}