{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":120,"content":[{"type":"verse","number":1,"content":[{"text":"I have lifted up my eyes to the mountains, from whence help shall come to me.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"My help is from the Lord, who made heaven and earth.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"May he not suffer thy foot to be moved: neither let him slumber that keepeth thee.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Behold he shall neither slumber nor sleep, that keepeth Israel.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The Lord is thy keeper, the Lord is thy protection upon thy right hand.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The sun shall not burn thee by day: nor the moon by night.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The Lord keepeth thee from all evil: may the Lord keep thy soul.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"May the Lord keep thy going in and thy going out; from henceforth now and for ever.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":8}