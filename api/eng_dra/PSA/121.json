{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":121,"content":[{"type":"verse","number":1,"content":[{"text":"I rejoiced at the things that were said to me: We shall go into the house of the Lord.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Our feet were standing in thy courts, O Jerusalem.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jerusalem, which is built as a city, which is compact together.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For thither did the tribes go up, the tribes of the Lord: the testimony of Israel, to praise the name of the Lord.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Because their seats have sat in judgment, seats upon the house of David.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pray ye for the things that are for the peace of Jerusalem: and abundance for them that love thee.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Let peace be in thy strength: and abundance in thy towers.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For the sake of my brethren, and of my neighbours, I spoke peace of thee.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Because of the house of the Lord our God, I have sought good things for thee.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":9}