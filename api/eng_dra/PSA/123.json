{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":123,"content":[{"type":"verse","number":1,"content":[{"text":"If it had not been that the Lord was with us, let Israel now say:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"If it had not been that the Lord was with us, When men rose up against us,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Perhaps they had swallowed us up alive. When their fury was enkindled against us,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Perhaps the waters had swallowed us up.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Our soul hath passed through a torrent: perhaps our soul had passed through a water insupportable.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Blessed be the Lord, who hath not given us to be a prey to their teeth.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Our soul hath been delivered as a sparrow out of the snare of the followers. The snare is broken, and we are delivered.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Our help is in the name of the Lord, who made heaven and earth.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":8}