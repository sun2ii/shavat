{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":126,"content":[{"type":"verse","number":1,"content":[{"text":"Unless the Lord build the house, they labour in vain that build it. Unless the Lord keep the city, he watcheth in vain that keepeth it.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"It is vain for you to rise before light, rise ye after you have sitten, you that eat the bread of sorrow. When he shall give sleep to his beloved,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Behold the inheritance of the Lord are children: the reward, the fruit of the womb.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"As arrows in the hand of the mighty, so the children of them that have been shaken.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Blessed is the man that hath filled the desire with them; he shall not be confounded when he shall speak to his enemies in the gate.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":5}