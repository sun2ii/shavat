l.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":6}