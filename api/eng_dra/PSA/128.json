{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":128,"content":[{"type":"verse","number":1,"content":[{"text":"Often have they fought against me from my youth, let Israel now say.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Often have they fought against me from my youth: but they could not prevail over me.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The wicked have wrought upon my back: they have lengthened their iniquity.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The Lord who is just will cut the necks of sinners:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Let them all be confounded and turned back that hate Sion.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Let them be as grass on the tops of houses: which withered before it be plucked up:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wherewith the mower filleth not his hand: nor he that gathereth sheaves his bosom.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"And they that have passed by have not said: The blessing of the Lord be upon you: we have blessed you in the name of the Lord.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":8}