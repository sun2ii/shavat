{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":129,"content":[{"type":"verse","number":1,"content":[{"text":"Out of the depths I have cried to thee, O Lord:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lord, hear my voice. Let thy ears be attentive to the voice of my supplication.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"If thou, O Lord, wilt mark iniquities: Lord, who shall stand it.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For with thee there is merciful forgiveness: and by reason of thy law, I have waited for thee, O Lord. My soul hath relied on his word:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"My soul hath hoped in the Lord.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"From the morning watch even until night, let Israel hope in the Lord.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Because with the Lord there is mercy: and with him plentiful redemption.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"And he shall redeem Israel from all his iniquities.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}