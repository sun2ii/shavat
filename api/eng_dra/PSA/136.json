{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":136,"content":[{"type":"verse","number":1,"content":[{"text":"Upon the rivers of Babylon, there we sat and wept: when we remembered Sion:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"On the willows in the midst thereof we hung up our instruments.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For there they that led us into captivity required of us the words of songs. And they that carried us away, said: Sing ye to us a hymn of the songs of Sion.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"How shall we sing the song of the Lord in a strange land?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"If I forget thee, O Jerusalem, let my right hand be forgotten.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Let my tongue cleave to my jaws, if I do not remember thee: If I make not Jerusalem the beginning of my joy.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Remember, O Lord, the children of Edom, in the day of Jerusalem: Who say: Rase it, rase it, even to the foundation thereof.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O daughter of Babylon, miserable: blessed shall he be who shall repay thee thy payment which thou hast paid us.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Blessed be he that shall take and dash thy little ones against the rock.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":9}