{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":141,"content":[{"type":"verse","number":1,"content":[{"text":"Of understanding for David. A prayer when he was in the cave. [1 Kings 24]","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I cried to the Lord with my voice: with my voice I made supplication to the Lord.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"In his sight I pour out my prayer, and before him I declare my trouble:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"When my spirit failed me, then thou newest my paths.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I looked on my right hand, and beheld, and there was no one that would know me. Flight hath failed me: and there is no one that hath regard to my soul.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I cried to thee, O Lord: I said: Thou art my hope, my portion in the land of the living.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Attend to my supplication: for I am brought very low. Deliver me from my persecutors; for they are stronger than I.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bring my soul out of prison, that I may praise thy name: the just wait for me, until thou reward me.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":8}