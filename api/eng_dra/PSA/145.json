{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":145,"content":[{"type":"verse","number":1,"content":[{"text":"Alleluia, of Aggeus and Zacharias.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Praise the Lord, O my soul, in my life I will praise the Lord: I will sing to my God as long as I shall be. Put not your trust in princes:","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"In the children of men, in whom there is no salvation.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"His spirit shall go forth, and he shall return into his earth: in that day all their thoughts shall perish.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Blessed is he who hath the God of Jacob for his helper, whose hope is in the Lord his God:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Who made heaven and earth, the sea, and all things that are in them.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Who keepeth truth for ever: who executeth judgment for them that suffer wrong: who giveth food to the hungry. The Lord looseth them that are fettered:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The Lord enlighteneth the blind. The Lord lifteth up them that are cast down: the Lord loveth the just.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The Lord keepeth the strangers, he will support the fatherless and the widow: and the ways of sinners he will destroy.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"The Lord shall reign for ever: thy God, O Sion, unto generation and generation.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":10}