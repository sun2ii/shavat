{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"Praise ye the Lord, because psalm is good: to our God be joyful and comely praise.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The Lord buildeth up Jerusalem: he will gather together the dispersed of Israel.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Who healeth the broken of heart, and bindeth up their bruises.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Who telleth the number of the stars: and calleth them all by their names.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Great is our Lord, and great is his power: and of his wisdom there is no number.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The Lord lifteth up the meek, and bringeth the wicked down even to the ground.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sing ye to the Lord with praise: sing to our God upon the harp.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Who covereth the heaven with clouds, and prepareth rain for the earth. Who maketh grass to grow on the mountains, and herbs for the service of men.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Who giveth to beasts their food: and to the young ravens that call upon him.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"He shall not delight in the strength of the horse: nor take pleasure in the legs of a man.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"The Lord taketh pleasure in them that fear him: and in them that hope in his mercy.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":11}