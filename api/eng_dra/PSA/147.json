{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":147,"content":[{"type":"verse","number":1,"content":[{"text":"Praise the Lord, O Jerusalem: praise thy God, O Sion.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Because he hath strengthened the bolts of thy gates, he hath blessed thy children within thee.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Who hath placed peace in thy borders: and filleth thee with the fat of corn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Who sendeth forth his speech to the earth: his word runneth swiftly.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Who giveth snow like wool: scattereth mists like ashes.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He sendeth his crystal like morsels: who shall stand before the face of his cold?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He shall send out his word, and shall melt them: his wind shall blow, and the waters shall run.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Who declareth his word to Jacob: his justices and his judgments to Israel.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He hath not done in like manner to every nation: and his judgments he hath not made manifest to them. Alleluia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":9}