{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"Sing ye to the Lord a new canticle: let his praise be in the church of the saints.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Let Israel rejoice in him that made him: and let the children of Sion be joyful in their king.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let them praise his name in choir: let them sing to him with the timbrel and the psaltery.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For the Lord is well pleased with his people: and he will exalt the meek unto salvation.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The saints shall rejoice in glory: they shall be joyful in their beds.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The high praise of God shall be in their mouth: and two-edged swords in their hands:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"To execute vengeance upon the nations, chastisements among the people:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"To bind their kings with fetters, and their nobles with manacles of iron.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"To execute upon them the judgment that is written: this glory is to all his saints. Alleluia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}