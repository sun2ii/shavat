{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":[{"text":"A psalm for David. The Lord ruleth me: and I shall want nothing.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"He hath set me in a place of pasture. He hath brought me up, on the water of refreshment:","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He hath converted my soul. He hath led me on the paths of justice, for his own name’s sake.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For though I should walk in the midst of the shadow of death, I will fear no evils, for thou art with me. Thy rod and thy staff, they have comforted me.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Thou hast prepared a table before me against them that afflict me. Thou hast anointed my head with oil; and my chalice which inebriateth me, how goodly is it!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"And thy mercy will follow me all the days of my life. And that I may dwell in the house of the Lord unto length of days.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":6}