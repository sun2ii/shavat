{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"The psalm of David when he fled from the face of his son Absalom.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Why, O Lord, are they multiplied that afflict me? many are they who rise up against me.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Many say to my soul: There is no salvation for him in his God.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"But thou, O Lord art my protector, my glory, and the lifter up of my head.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I have cried to the Lord with my voice: and he hath heard me from his holy hill.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I have slept and taken my rest: and I have risen up, because the Lord hath protected me.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I will not fear thousands of the people, surrounding me: arise, O Lord; save me, O my God.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For thou hast struck all them who are my adversaries without cause: thou hast broken the teeth of sinners.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Salvation is of the Lord: and thy blessing is upon thy people.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":9}