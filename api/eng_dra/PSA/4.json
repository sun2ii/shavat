{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Unto the end, in verses. A psalm for David.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"When I called upon him, the God of my justice heard me: when I was in distress, thou hast enlarged me. Have mercy on me: and hear my prayer.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"O ye sons of men, how long will you be dull of heart? why do you love vanity, and seek after lying?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Know ye also that the Lord hath made his holy one wonderful: the Lord will hear me when I shall cry unto him.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Be angry, and sin not: the things you say in your hearts, be sorry for them upon your beds.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Offer up the sacrifice of justice, and trust in the Lord: many say, Who sheweth us good things?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The light of thy countenance O Lord, is signed upon us: thou hast given gladness in my heart.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"By the fruit of their corn, their wine and oil, they are multiplied.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"In peace in the selfsame I will sleep, and I will rest:","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"For thou, O Lord, singularly hast settled me in hope.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":10}