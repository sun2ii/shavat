{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":42,"content":[{"type":"verse","number":1,"content":[{"text":"A psalm for David. Judge me, O God, and distinguish my cause from the nation that is not holy: deliver me from the unjust and deceitful man.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For thou art God my strength: why hast thou cast me off? and why do I go sorrowful whilst the enemy afflicteth me?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Send forth thy light and thy truth: they have conducted me, and brought me unto thy holy hill, and into thy tabernacles.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"And I will go in to the altar of God: to God who giveth joy to my youth.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"To thee, O God my God, I will give praise upon the harp: why art thou sad, O my soul? and why dost thou disquiet me?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hope in God, for I will still give praise to him: the salvation of my countenance, and my God.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":6}