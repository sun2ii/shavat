{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Unto the end, in verses, a psalm for David, for the octave.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O Lord, rebuke me not in thy indignation, nor chastise me in thy wrath.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Have mercy on me, O Lord, for I am weak: heal me, O Lord, for my bones are troubled.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"And my soul is troubled exceedingly: but thou, O Lord, how long?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Turn to me, O Lord, and deliver my soul: O save me for thy mercy’s sake.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"For there is no one in death, that is mindful of thee: and who shall confess to thee in hell?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I have laboured in my groanings, every night I will wash my bed: I will water my couch with my tears.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"My eye is troubled through indignation: I have grown old amongst all my enemies.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Depart from me, all ye workers of iniquity: for the Lord hath heard the voice of my weeping.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"The Lord hath heard my supplication: the Lord hath received my prayer.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Let all my enemies be ashamed, and be very much troubled: let them be turned back, and be ashamed very speedily.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}