{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":60,"content":[{"type":"verse","number":1,"content":[{"text":"Unto the end, in hymns, for David.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hear, O God, my supplication: be attentive to my prayer,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"To thee have I cried from the ends of the earth: when my heart was in anguish, thou hast exalted me on a rock. Thou hast conducted me;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For thou hast been my hope; a tower of strength against the face of the enemy.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"In thy tabernacle I shall dwell for ever: I shall be protected under the covert of thy wings.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"For thou, my God, hast heard my prayer: thou hast given an inheritance to them that fear thy name.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Thou wilt add days to the days of the king: his years even to generation and generation.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"He abideth for ever in the sight of God: his mercy and truth who shall search?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"So will I sing a psalm to thy name for ever and ever: that I may pay my vows from day to day.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":9}