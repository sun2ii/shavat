people, O God, confess to thee: let all the people give praise to thee:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The earth hath yielded her fruit. May God, our God bless us,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"May God bless us: and all the ends of the earth fear him.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":8}