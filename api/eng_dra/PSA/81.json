{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":81,"content":[{"type":"verse","number":1,"content":[{"text":"A psalm for Asaph. God hath stood in the congregation of gods: and being in the midst of them he judgeth gods.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"How long will you judge unjustly: and accept the persons of the wicked?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Judge for the needy and fatherless: do justice to the humble and the poor.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rescue the poor; and deliver the needy out of the hand of the sinner.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"They have not known nor understood: they walk on in darkness: all the foundations of the earth shall be moved.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I have said: You are gods and all of you the sons of the most High.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"But you like men shall die: and shall fall like one of the princes.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Arise, O God, judge thou the earth: for thou shalt inherit among all the nations.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":8}