{"translation":{"id":"eng_dra","name":"Douay-Rheims 1899","website":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDRA","licenseNotes":null,"shortName":"DRA","englishName":"Douay-Rheims 1899","language":"eng","textDirection":"ltr","sha256":"51fa3487a52c81bbde81e6a1f2fbde210e090f6e57a8535288db3f1d9d417aa0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dra/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31438,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4373},"book":{"id":"PSA","translationId":"eng_dra","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"d325c414a0ed2aee2eaf207b1812c4381e2c274cad0bd3890f9add97637eff27","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dra/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dra/PSA/150.json","totalNumberOfVerses":2530},"chapter":{"number":92,"content":[{"type":"verse","number":1,"content":[{"text":"The Lord hath reigned, he is clothed with beauty: the Lord is clothed with strength, and hath girded himself. For he hath established the world which shall not be moved.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Thy throne is prepared from of old: thou art from everlasting.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The floods have lifted up, O Lord: the floods have lifted up their voice. The floods have lifted up their waves,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"With the noise of many waters. Wonderful are the surges of the sea: wonderful is the Lord on high.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Thy testimonies are become exceedingly credible: holiness becometh thy house, O Lord, unto length of days.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dra/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dra/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dra/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":5}