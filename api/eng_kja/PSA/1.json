{"translation":{"id":"eng_kja","name":"King James Version + Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseNotes":null,"shortName":"KJVA","englishName":"King James Version + Apocrypha","language":"eng","textDirection":"ltr","sha256":"b1ab484e9936613a03c53c677faf47c894eaab558329766076eaadf38af1e736","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kja/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_kja","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"a601ba791422c1329a43069410996ca9a32b1709438a7501a089b1952e066484","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kja/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Blessed is the man that walketh not in the counsel of the ungodly, nor standeth in the way of sinners, nor sitteth in the seat of the scornful.","poem":1},{"noteId":0}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"But his delight is in the law of the LORD; and in his law doth he meditate day and night.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"And he shall be like a tree planted by the rivers of water, that bringeth forth his fruit in his season; his leaf also shall not wither; and whatsoever he doeth shall prosper.","poem":1},{"noteId":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"The ungodly are not so: but are like the chaff which the wind driveth away.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Therefore the ungodly shall not stand in the judgment, nor sinners in the congregation of the righteous.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"For the LORD knoweth the way of the righteous: but the way of the ungodly shall perish.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"1.1 ungodly: or, wicked","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"1.3 wither: Heb. fade","reference":{"chapter":1,"verse":3}}]},"thisChapterLink":"/api/eng_kja/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kja/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kja/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}