{"translation":{"id":"eng_kja","name":"King James Version + Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseNotes":null,"shortName":"KJVA","englishName":"King James Version + Apocrypha","language":"eng","textDirection":"ltr","sha256":"b1ab484e9936613a03c53c677faf47c894eaab558329766076eaadf38af1e736","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kja/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_kja","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"a601ba791422c1329a43069410996ca9a32b1709438a7501a089b1952e066484","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kja/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":100,"content":[{"type":"hebrew_subtitle","content":["A Psalm of praise."]},{"type":"verse","number":1,"content":[{"text":"Make a joyful noise unto the LORD, all ye lands.","poem":1},{"noteId":572},{"noteId":573}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Serve the LORD with gladness: come before his presence with singing.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Know ye that the LORD he is God: it is he that hath made us, and not we ourselves; we are his people, and the sheep of his pasture.","poem":1},{"noteId":574}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Enter into his gates with thanksgiving, and into his courts with praise: be thankful unto him, and bless his name.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For the LORD is good; his mercy is everlasting; and his truth endureth to all generations.","poem":1},{"noteId":575}]}],"footnotes":[{"noteId":572,"caller":"+","text":"100.1 praise: or, thanksgiving","reference":{"chapter":100,"verse":1}},{"noteId":573,"caller":"+","text":"100.1 all…: Heb. all the earth","reference":{"chapter":100,"verse":1}},{"noteId":574,"caller":"+","text":"100.3 and not…: or, and his we are","reference":{"chapter":100,"verse":3}},{"noteId":575,"caller":"+","text":"100.5 to all…: Heb. to generation and generation","reference":{"chapter":100,"verse":5}}]},"thisChapterLink":"/api/eng_kja/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kja/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kja/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}