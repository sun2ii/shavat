{"translation":{"id":"eng_kja","name":"King James Version + Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseNotes":null,"shortName":"KJVA","englishName":"King James Version + Apocrypha","language":"eng","textDirection":"ltr","sha256":"b1ab484e9936613a03c53c677faf47c894eaab558329766076eaadf38af1e736","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kja/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_kja","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"a601ba791422c1329a43069410996ca9a32b1709438a7501a089b1952e066484","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kja/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"I will sing of mercy and judgment: unto thee, O LORD, will I sing.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I will behave myself wisely in a perfect way. O when wilt thou come unto me? I will walk within my house with a perfect heart.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I will set no wicked thing before mine eyes: I hate the work of them that turn aside; it shall not cleave to me.","poem":1},{"noteId":576}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A froward heart shall depart from me: I will not know a wicked person.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Whoso privily slandereth his neighbour, him will I cut off: him that hath an high look and a proud heart will not I suffer.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mine eyes shall be upon the faithful of the land, that they may dwell with me: he that walketh in a perfect way, he shall serve me.","poem":1},{"noteId":577}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He that worketh deceit shall not dwell within my house: he that telleth lies shall not tarry in my sight.","poem":1},{"noteId":578}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I will early destroy all the wicked of the land; that I may cut off all wicked doers from the city of the LORD.","poem":1}]}],"footnotes":[{"noteId":576,"caller":"+","text":"101.3 wicked…: Heb. thing of Belial","reference":{"chapter":101,"verse":3}},{"noteId":577,"caller":"+","text":"101.6 in a…: or, perfect in the way","reference":{"chapter":101,"verse":6}},{"noteId":578,"caller":"+","text":"101.7 shall not tarry: Heb. shall not be established","reference":{"chapter":101,"verse":7}}]},"thisChapterLink":"/api/eng_kja/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kja/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kja/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}