{"translation":{"id":"eng_kja","name":"King James Version + Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseNotes":null,"shortName":"KJVA","englishName":"King James Version + Apocrypha","language":"eng","textDirection":"ltr","sha256":"b1ab484e9936613a03c53c677faf47c894eaab558329766076eaadf38af1e736","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kja/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_kja","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"a601ba791422c1329a43069410996ca9a32b1709438a7501a089b1952e066484","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kja/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"The LORD said unto my Lord, Sit thou at my right hand, until I make thine enemies thy footstool.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The LORD shall send the rod of thy strength out of Zion: rule thou in the midst of thine enemies.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Thy people shall be willing in the day of thy power, in the beauties of holiness from the womb of the morning: thou hast the dew of thy youth.","poem":1},{"noteId":629}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The LORD hath sworn, and will not repent, Thou art a priest for ever after the order of Melchizedek.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"The Lord at thy right hand shall strike through kings in the day of his wrath.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He shall judge among the heathen, he shall fill the places with the dead bodies; he shall wound the heads over many countries.","poem":1},{"noteId":630}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He shall drink of the brook in the way: therefore shall he lift up the head.","poem":1}]}],"footnotes":[{"noteId":629,"caller":"+","text":"110.3 from…: or, more than the womb of the morning: thou shalt have, etc","reference":{"chapter":110,"verse":3}},{"noteId":630,"caller":"+","text":"110.6 many: or, great","reference":{"chapter":110,"verse":6}}]},"thisChapterLink":"/api/eng_kja/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kja/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kja/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}