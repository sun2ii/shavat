{"translation":{"id":"eng_kja","name":"King James Version + Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseNotes":null,"shortName":"KJVA","englishName":"King James Version + Apocrypha","language":"eng","textDirection":"ltr","sha256":"b1ab484e9936613a03c53c677faf47c894eaab558329766076eaadf38af1e736","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kja/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_kja","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"a601ba791422c1329a43069410996ca9a32b1709438a7501a089b1952e066484","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kja/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"Praise ye the LORD. Blessed is the man that feareth the LORD, that delighteth greatly in his commandments.","poem":1},{"noteId":636}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"His seed shall be mighty upon earth: the generation of the upright shall be blessed.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wealth and riches shall be in his house: and his righteousness endureth for ever.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Unto the upright there ariseth light in the darkness: he is gracious, and full of compassion, and righteous.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A good man sheweth favour, and lendeth: he will guide his affairs with discretion.","poem":1},{"noteId":637}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Surely he shall not be moved for ever: the righteous shall be in everlasting remembrance.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He shall not be afraid of evil tidings: his heart is fixed, trusting in the LORD.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"His heart is established, he shall not be afraid, until he see his desire upon his enemies.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He hath dispersed, he hath given to the poor; his righteousness endureth for ever; his horn shall be exalted with honour.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"The wicked shall see it, and be grieved; he shall gnash with his teeth, and melt away: the desire of the wicked shall perish.","poem":1}]}],"footnotes":[{"noteId":636,"caller":"+","text":"112.1 Praise…: Heb. Hallelujah","reference":{"chapter":112,"verse":1}},{"noteId":637,"caller":"+","text":"112.5 discretion: Heb. judgment","reference":{"chapter":112,"verse":5}}]},"thisChapterLink":"/api/eng_kja/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kja/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kja/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}