{"translation":{"id":"eng_kja","name":"King James Version + Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseNotes":null,"shortName":"KJVA","englishName":"King James Version + Apocrypha","language":"eng","textDirection":"ltr","sha256":"b1ab484e9936613a03c53c677faf47c894eaab558329766076eaadf38af1e736","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kja/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_kja","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"a601ba791422c1329a43069410996ca9a32b1709438a7501a089b1952e066484","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kja/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Praise ye the LORD. Praise, O ye servants of the LORD, praise the name of the LORD.","poem":1},{"noteId":638}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Blessed be the name of the LORD from this time forth and for evermore.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"From the rising of the sun unto the going down of the same the LORD’s name is to be praised.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The LORD is high above all nations, and his glory above the heavens.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Who is like unto the LORD our God, who dwelleth on high,","poem":1},{"noteId":639}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Who humbleth himself to behold the things that are in heaven, and in the earth!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He raiseth up the poor out of the dust, and lifteth the needy out of the dunghill;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"That he may set him with princes, even with the princes of his people.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He maketh the barren woman to keep house, and to be a joyful mother of children. Praise ye the LORD.","poem":1},{"noteId":640}]}],"footnotes":[{"noteId":638,"caller":"+","text":"113.1 Praise ye…: Heb. Hallelujah","reference":{"chapter":113,"verse":1}},{"noteId":639,"caller":"+","text":"113.5 dwelleth…: Heb. exalteth himself to dwell","reference":{"chapter":113,"verse":5}},{"noteId":640,"caller":"+","text":"113.9 to keep…: Heb. to dwell in an house","reference":{"chapter":113,"verse":9}}]},"thisChapterLink":"/api/eng_kja/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kja/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kja/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}