{"translation":{"id":"eng_kja","name":"King James Version + Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseNotes":null,"shortName":"KJVA","englishName":"King James Version + Apocrypha","language":"eng","textDirection":"ltr","sha256":"b1ab484e9936613a03c53c677faf47c894eaab558329766076eaadf38af1e736","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kja/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_kja","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"a601ba791422c1329a43069410996ca9a32b1709438a7501a089b1952e066484","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kja/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"When Israel went out of Egypt, the house of Jacob from a people of strange language;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Judah was his sanctuary, and Israel his dominion.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The sea saw it, and fled: Jordan was driven back.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The mountains skipped like rams, and the little hills like lambs.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"What ailed thee, O thou sea, that thou fleddest? thou Jordan, that thou wast driven back?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ye mountains, that ye skipped like rams; and ye little hills, like lambs?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tremble, thou earth, at the presence of the Lord, at the presence of the God of Jacob;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Which turned the rock into a standing water, the flint into a fountain of waters.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_kja/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kja/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kja/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}