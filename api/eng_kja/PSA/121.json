{"translation":{"id":"eng_kja","name":"King James Version + Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseNotes":null,"shortName":"KJVA","englishName":"King James Version + Apocrypha","language":"eng","textDirection":"ltr","sha256":"b1ab484e9936613a03c53c677faf47c894eaab558329766076eaadf38af1e736","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kja/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_kja","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"a601ba791422c1329a43069410996ca9a32b1709438a7501a089b1952e066484","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kja/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":121,"content":[{"type":"hebrew_subtitle","content":["A Song of degrees."]},{"type":"verse","number":1,"content":[{"text":"I will lift up mine eyes unto the hills, from whence cometh my help.","poem":1},{"noteId":683}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"My help cometh from the LORD, which made heaven and earth.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He will not suffer thy foot to be moved: he that keepeth thee will not slumber.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Behold, he that keepeth Israel shall neither slumber nor sleep.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The LORD is thy keeper: the LORD is thy shade upon thy right hand.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The sun shall not smite thee by day, nor the moon by night.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The LORD shall preserve thee from all evil: he shall preserve thy soul.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The LORD shall preserve thy going out and thy coming in from this time forth, and even for evermore.","poem":1}]}],"footnotes":[{"noteId":683,"caller":"+","text":"121.1 I will…: or, Shall I lift up mine eyes to the hills? whence should my help come?","reference":{"chapter":121,"verse":1}}]},"thisChapterLink":"/api/eng_kja/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kja/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kja/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}