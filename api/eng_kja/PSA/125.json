{"translation":{"id":"eng_kja","name":"King James Version + Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseNotes":null,"shortName":"KJVA","englishName":"King James Version + Apocrypha","language":"eng","textDirection":"ltr","sha256":"b1ab484e9936613a03c53c677faf47c894eaab558329766076eaadf38af1e736","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kja/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_kja","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"a601ba791422c1329a43069410996ca9a32b1709438a7501a089b1952e066484","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kja/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"hebrew_subtitle","content":["A Song of degrees."]},{"type":"verse","number":1,"content":[{"text":"They that trust in the LORD shall be as mount Zion, which cannot be removed, but abideth for ever.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"As the mountains are round about Jerusalem, so the LORD is round about his people from henceforth even for ever.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For the rod of the wicked shall not rest upon the lot of the righteous; lest the righteous put forth their hands unto iniquity.","poem":1},{"noteId":685}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Do good, O LORD, unto those that be good, and to them that are upright in their hearts.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"As for such as turn aside unto their crooked ways, the LORD shall lead them forth with the workers of iniquity: but peace shall be upon Israel.","poem":1}]}],"footnotes":[{"noteId":685,"caller":"+","text":"125.3 the wicked: Heb. wickedness","reference":{"chapter":125,"verse":3}}]},"thisChapterLink":"/api/eng_kja/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kja/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kja/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}