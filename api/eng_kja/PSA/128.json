{"translation":{"id":"eng_kja","name":"King James Version + Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseNotes":null,"shortName":"KJVA","englishName":"King James Version + Apocrypha","language":"eng","textDirection":"ltr","sha256":"b1ab484e9936613a03c53c677faf47c894eaab558329766076eaadf38af1e736","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kja/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_kja","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"a601ba791422c1329a43069410996ca9a32b1709438a7501a089b1952e066484","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kja/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":128,"content":[{"type":"hebrew_subtitle","content":["A Song of degrees."]},{"type":"verse","number":1,"content":[{"text":"Blessed is every one that feareth the LORD; that walketh in his ways.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For thou shalt eat the labour of thine hands: happy shalt thou be, and it shall be well with thee.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Thy wife shall be as a fruitful vine by the sides of thine house: thy children like olive plants round about thy table.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Behold, that thus shall the man be blessed that feareth the LORD.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The LORD shall bless thee out of Zion: and thou shalt see the good of Jerusalem all the days of thy life.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yea, thou shalt see thy children’s children, and peace upon Israel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_kja/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kja/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kja/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}