{"translation":{"id":"eng_kja","name":"King James Version + Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseNotes":null,"shortName":"KJVA","englishName":"King James Version + Apocrypha","language":"eng","textDirection":"ltr","sha256":"b1ab484e9936613a03c53c677faf47c894eaab558329766076eaadf38af1e736","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kja/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_kja","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"a601ba791422c1329a43069410996ca9a32b1709438a7501a089b1952e066484","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kja/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"hebrew_subtitle","content":["A Song of degrees."]},{"type":"verse","number":1,"content":[{"text":"Many a time have they afflicted me from my youth, may Israel now say:","poem":1},{"noteId":694}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Many a time have they afflicted me from my youth: yet they have not prevailed against me.","poem":1},{"noteId":695}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The plowers plowed upon my back: they made long their furrows.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The LORD is righteous: he hath cut asunder the cords of the wicked.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Let them all be confounded and turned back that hate Zion.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Let them be as the grass upon the housetops, which withereth afore it groweth up:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wherewith the mower filleth not his hand; nor he that bindeth sheaves his bosom.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Neither do they which go by say, The blessing of the LORD be upon you: we bless you in the name of the LORD.","poem":1}]}],"footnotes":[{"noteId":694,"caller":"+","text":"129.1 Many…: or, Much","reference":{"chapter":129,"verse":1}},{"noteId":695,"caller":"+","text":"129.2 Many…: or, Much","reference":{"chapter":129,"verse":2}}]},"thisChapterLink":"/api/eng_kja/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kja/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kja/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}