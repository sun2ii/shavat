{"translation":{"id":"eng_kja","name":"King James Version + Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseNotes":null,"shortName":"KJVA","englishName":"King James Version + Apocrypha","language":"eng","textDirection":"ltr","sha256":"b1ab484e9936613a03c53c677faf47c894eaab558329766076eaadf38af1e736","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kja/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_kja","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"a601ba791422c1329a43069410996ca9a32b1709438a7501a089b1952e066484","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kja/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["A Song of degrees."]},{"type":"verse","number":1,"content":[{"text":"Out of the depths have I cried unto thee, O LORD.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lord, hear my voice: let thine ears be attentive to the voice of my supplications.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"If thou, LORD, shouldest mark iniquities, O Lord, who shall stand?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"But there is forgiveness with thee, that thou mayest be feared.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"I wait for the LORD, my soul doth wait, and in his word do I hope.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"My soul waiteth for the Lord more than they that watch for the morning: I say, more than they that watch for the morning.","poem":1},{"noteId":696}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Let Israel hope in the LORD: for with the LORD there is mercy, and with him is plenteous redemption.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"And he shall redeem Israel from all his iniquities.","poem":1}]}],"footnotes":[{"noteId":696,"caller":"+","text":"130.6 I say…: or, which watch unto","reference":{"chapter":130,"verse":6}}]},"thisChapterLink":"/api/eng_kja/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kja/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kja/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}