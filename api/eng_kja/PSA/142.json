{"translation":{"id":"eng_kja","name":"King James Version + Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseNotes":null,"shortName":"KJVA","englishName":"King James Version + Apocrypha","language":"eng","textDirection":"ltr","sha256":"b1ab484e9936613a03c53c677faf47c894eaab558329766076eaadf38af1e736","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kja/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_kja","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"a601ba791422c1329a43069410996ca9a32b1709438a7501a089b1952e066484","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kja/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["Maschil of David; A Prayer when he was in the cave."]},{"type":"verse","number":1,"content":[{"text":"I cried unto the LORD with my voice; with my voice unto the LORD did I make my supplication.","poem":1},{"noteId":734}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I poured out my complaint before him; I shewed before him my trouble.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"When my spirit was overwhelmed within me, then thou knewest my path. In the way wherein I walked have they privily laid a snare for me.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"I looked on my right hand, and beheld, but there was no man that would know me: refuge failed me; no man cared for my soul.","poem":1},{"noteId":735},{"noteId":736},{"noteId":737}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I cried unto thee, O LORD: I said, Thou art my refuge and my portion in the land of the living.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Attend unto my cry; for I am brought very low: deliver me from my persecutors; for they are stronger than I.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bring my soul out of prison, that I may praise thy name: the righteous shall compass me about; for thou shalt deal bountifully with me.","poem":1}]}],"footnotes":[{"noteId":734,"caller":"+","text":"142.1 Maschil…: or, A Psalm of David, giving instruction","reference":{"chapter":142,"verse":1}},{"noteId":735,"caller":"+","text":"142.4 I looked…: or, Look on the right hand, and see","reference":{"chapter":142,"verse":4}},{"noteId":736,"caller":"+","text":"142.4 failed…: Heb. perished from me","reference":{"chapter":142,"verse":4}},{"noteId":737,"caller":"+","text":"142.4 cared…: Heb. sought after","reference":{"chapter":142,"verse":4}}]},"thisChapterLink":"/api/eng_kja/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kja/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kja/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}