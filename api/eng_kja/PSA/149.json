{"translation":{"id":"eng_kja","name":"King James Version + Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseNotes":null,"shortName":"KJVA","englishName":"King James Version + Apocrypha","language":"eng","textDirection":"ltr","sha256":"b1ab484e9936613a03c53c677faf47c894eaab558329766076eaadf38af1e736","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kja/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_kja","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"a601ba791422c1329a43069410996ca9a32b1709438a7501a089b1952e066484","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kja/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"Praise ye the LORD. Sing unto the LORD a new song, and his praise in the congregation of saints.","poem":1},{"noteId":765}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Let Israel rejoice in him that made him: let the children of Zion be joyful in their King.","poem":1},{"noteId":766}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let them praise his name in the dance: let them sing praises unto him with the timbrel and harp.","poem":1},{"noteId":767}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For the LORD taketh pleasure in his people: he will beautify the meek with salvation.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Let the saints be joyful in glory: let them sing aloud upon their beds.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Let the high praises of God be in their mouth, and a twoedged sword in their hand;","poem":1},{"noteId":768}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"To execute vengeance upon the heathen, and punishments upon the people;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"To bind their kings with chains, and their nobles with fetters of iron;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"To execute upon them the judgment written: this honour have all his saints. Praise ye the LORD.","poem":1}]}],"footnotes":[{"noteId":765,"caller":"+","text":"149.1 Praise…: Heb. Hallelujah","reference":{"chapter":149,"verse":1}},{"noteId":766,"caller":"+","text":"149.2 in him…: Heb. in his Makers","reference":{"chapter":149,"verse":2}},{"noteId":767,"caller":"+","text":"149.3 in…: or, with the pipe","reference":{"chapter":149,"verse":3}},{"noteId":768,"caller":"+","text":"149.6 mouth: Heb. throat","reference":{"chapter":149,"verse":6}}]},"thisChapterLink":"/api/eng_kja/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kja/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kja/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}