{"translation":{"id":"eng_kja","name":"King James Version + Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseNotes":null,"shortName":"KJVA","englishName":"King James Version + Apocrypha","language":"eng","textDirection":"ltr","sha256":"b1ab484e9936613a03c53c677faf47c894eaab558329766076eaadf38af1e736","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kja/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_kja","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"a601ba791422c1329a43069410996ca9a32b1709438a7501a089b1952e066484","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kja/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":16,"content":[{"type":"hebrew_subtitle","content":["Michtam of David."]},{"type":"verse","number":1,"content":[{"text":"Preserve me, O God: for in thee do I put my trust.","poem":1},{"noteId":69}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O my soul, thou hast said unto the LORD, Thou art my Lord: my goodness extendeth not to thee;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"But to the saints that are in the earth, and to the excellent, in whom is all my delight.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Their sorrows shall be multiplied that hasten after another god: their drink offerings of blood will I not offer, nor take up their names into my lips.","poem":1},{"noteId":70}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The LORD is the portion of mine inheritance and of my cup: thou maintainest my lot.","poem":1},{"noteId":71}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The lines are fallen unto me in pleasant places; yea, I have a goodly heritage.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I will bless the LORD, who hath given me counsel: my reins also instruct me in the night seasons.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"I have set the LORD always before me: because he is at my right hand, I shall not be moved.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Therefore my heart is glad, and my glory rejoiceth: my flesh also shall rest in hope.","poem":1},{"noteId":72}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"For thou wilt not leave my soul in hell; neither wilt thou suffer thine Holy One to see corruption.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Thou wilt shew me the path of life: in thy presence is fulness of joy; at thy right hand there are pleasures for evermore.","poem":1}]}],"footnotes":[{"noteId":69,"caller":"+","text":"16.1 Michtam: or, A golden Psalm","reference":{"chapter":16,"verse":1}},{"noteId":70,"caller":"+","text":"16.4 hasten…: or, give gifts to another","reference":{"chapter":16,"verse":4}},{"noteId":71,"caller":"+","text":"16.5 of mine…: Heb. of my part","reference":{"chapter":16,"verse":5}},{"noteId":72,"caller":"+","text":"16.9 rest…: Heb. dwell confidently","reference":{"chapter":16,"verse":9}}]},"thisChapterLink":"/api/eng_kja/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kja/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kja/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}