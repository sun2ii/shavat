{"translation":{"id":"eng_kja","name":"King James Version + Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseNotes":null,"shortName":"KJVA","englishName":"King James Version + Apocrypha","language":"eng","textDirection":"ltr","sha256":"b1ab484e9936613a03c53c677faf47c894eaab558329766076eaadf38af1e736","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kja/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_kja","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"a601ba791422c1329a43069410996ca9a32b1709438a7501a089b1952e066484","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kja/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician, A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"The LORD hear thee in the day of trouble; the name of the God of Jacob defend thee;","poem":1},{"noteId":115}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Send thee help from the sanctuary, and strengthen thee out of Zion;","poem":1},{"noteId":116},{"noteId":117}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Remember all thy offerings, and accept thy burnt sacrifice; Selah.","poem":1},{"noteId":118}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Grant thee according to thine own heart, and fulfil all thy counsel.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"We will rejoice in thy salvation, and in the name of our God we will set up our banners: the LORD fulfil all thy petitions.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Now know I that the LORD saveth his anointed; he will hear him from his holy heaven with the saving strength of his right hand.","poem":1},{"noteId":119},{"noteId":120}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Some trust in chariots, and some in horses: but we will remember the name of the LORD our God.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"They are brought down and fallen: but we are risen, and stand upright.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Save, LORD: let the king hear us when we call.","poem":1}]}],"footnotes":[{"noteId":115,"caller":"+","text":"20.1 defend…: Heb. set thee on an high place","reference":{"chapter":20,"verse":1}},{"noteId":116,"caller":"+","text":"20.2 thee help: Heb. thy help","reference":{"chapter":20,"verse":2}},{"noteId":117,"caller":"+","text":"20.2 strengthen: Heb. support","reference":{"chapter":20,"verse":2}},{"noteId":118,"caller":"+","text":"20.3 accept: Heb. turn to ashes: or, make fat","reference":{"chapter":20,"verse":3}},{"noteId":119,"caller":"+","text":"20.6 his holy…: Heb. the heaven of his holiness","reference":{"chapter":20,"verse":6}},{"noteId":120,"caller":"+","text":"20.6 with…: Heb. by the strength of the salvation of","reference":{"chapter":20,"verse":6}}]},"thisChapterLink":"/api/eng_kja/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kja/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kja/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}