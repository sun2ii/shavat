{"translation":{"id":"eng_kja","name":"King James Version + Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseNotes":null,"shortName":"KJVA","englishName":"King James Version + Apocrypha","language":"eng","textDirection":"ltr","sha256":"b1ab484e9936613a03c53c677faf47c894eaab558329766076eaadf38af1e736","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kja/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_kja","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"a601ba791422c1329a43069410996ca9a32b1709438a7501a089b1952e066484","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kja/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"The LORD is my shepherd; I shall not want.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"He maketh me to lie down in green pastures: he leadeth me beside the still waters.","poem":1},{"noteId":137},{"noteId":138}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He restoreth my soul: he leadeth me in the paths of righteousness for his name’s sake.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yea, though I walk through the valley of the shadow of death, I will fear no evil: for thou art with me; thy rod and thy staff they comfort me.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Thou preparest a table before me in the presence of mine enemies: thou anointest my head with oil; my cup runneth over.","poem":1},{"noteId":139}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Surely goodness and mercy shall follow me all the days of my life: and I will dwell in the house of the LORD for ever.","poem":1},{"noteId":140}]}],"footnotes":[{"noteId":137,"caller":"+","text":"23.2 green…: Heb. pastures of tender grass","reference":{"chapter":23,"verse":2}},{"noteId":138,"caller":"+","text":"23.2 still…: Heb. waters of quietness","reference":{"chapter":23,"verse":2}},{"noteId":139,"caller":"+","text":"23.5 anointest: Heb. makest fat","reference":{"chapter":23,"verse":5}},{"noteId":140,"caller":"+","text":"23.6 for ever: Heb. to length of days","reference":{"chapter":23,"verse":6}}]},"thisChapterLink":"/api/eng_kja/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kja/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kja/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}