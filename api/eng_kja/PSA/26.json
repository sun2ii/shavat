{"translation":{"id":"eng_kja","name":"King James Version + Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseNotes":null,"shortName":"KJVA","englishName":"King James Version + Apocrypha","language":"eng","textDirection":"ltr","sha256":"b1ab484e9936613a03c53c677faf47c894eaab558329766076eaadf38af1e736","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kja/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_kja","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"a601ba791422c1329a43069410996ca9a32b1709438a7501a089b1952e066484","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kja/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Judge me, O LORD; for I have walked in mine integrity: I have trusted also in the LORD; therefore I shall not slide.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Examine me, O LORD, and prove me; try my reins and my heart.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For thy lovingkindness is before mine eyes: and I have walked in thy truth.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I have not sat with vain persons, neither will I go in with dissemblers.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I have hated the congregation of evil doers; and will not sit with the wicked.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"I will wash mine hands in innocency: so will I compass thine altar, O LORD:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"That I may publish with the voice of thanksgiving, and tell of all thy wondrous works.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"LORD, I have loved the habitation of thy house, and the place where thine honour dwelleth.","poem":1},{"noteId":148}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gather not my soul with sinners, nor my life with bloody men:","poem":1},{"noteId":149},{"noteId":150}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"In whose hands is mischief, and their right hand is full of bribes.","poem":1},{"noteId":151}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"But as for me, I will walk in mine integrity: redeem me, and be merciful unto me.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"My foot standeth in an even place: in the congregations will I bless the LORD.","poem":1}]}],"footnotes":[{"noteId":148,"caller":"+","text":"26.8 where…: Heb. of the tabernacle of thy honour","reference":{"chapter":26,"verse":8}},{"noteId":149,"caller":"+","text":"26.9 Gather…: or, Take not away","reference":{"chapter":26,"verse":9}},{"noteId":150,"caller":"+","text":"26.9 bloody…: Heb. men of blood","reference":{"chapter":26,"verse":9}},{"noteId":151,"caller":"+","text":"26.10 full…: Heb. filled with","reference":{"chapter":26,"verse":10}}]},"thisChapterLink":"/api/eng_kja/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kja/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kja/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}