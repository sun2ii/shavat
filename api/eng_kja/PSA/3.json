{"translation":{"id":"eng_kja","name":"King James Version + Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseNotes":null,"shortName":"KJVA","englishName":"King James Version + Apocrypha","language":"eng","textDirection":"ltr","sha256":"b1ab484e9936613a03c53c677faf47c894eaab558329766076eaadf38af1e736","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kja/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_kja","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"a601ba791422c1329a43069410996ca9a32b1709438a7501a089b1952e066484","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kja/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David, when he fled from Absalom his son."]},{"type":"verse","number":1,"content":[{"text":"LORD, how are they increased that trouble me! many are they that rise up against me.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Many there be which say of my soul, There is no help for him in God. Selah.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"But thou, O LORD, art a shield for me; my glory, and the lifter up of mine head.","poem":1},{"noteId":8}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"I cried unto the LORD with my voice, and he heard me out of his holy hill. Selah.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I laid me down and slept; I awaked; for the LORD sustained me.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I will not be afraid of ten thousands of people, that have set themselves against me round about.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Arise, O LORD; save me, O my God: for thou hast smitten all mine enemies upon the cheek bone; thou hast broken the teeth of the ungodly.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Salvation belongeth unto the LORD: thy blessing is upon thy people. Selah.","poem":1}]}],"footnotes":[{"noteId":8,"caller":"+","text":"3.3 for: or, about","reference":{"chapter":3,"verse":3}}]},"thisChapterLink":"/api/eng_kja/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kja/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kja/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}