{"translation":{"id":"eng_kja","name":"King James Version + Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseNotes":null,"shortName":"KJVA","englishName":"King James Version + Apocrypha","language":"eng","textDirection":"ltr","sha256":"b1ab484e9936613a03c53c677faf47c894eaab558329766076eaadf38af1e736","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kja/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_kja","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"a601ba791422c1329a43069410996ca9a32b1709438a7501a089b1952e066484","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kja/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Judge me, O God, and plead my cause against an ungodly nation: O deliver me from the deceitful and unjust man.","poem":1},{"noteId":264},{"noteId":265}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For thou art the God of my strength: why dost thou cast me off? why go I mourning because of the oppression of the enemy?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"O send out thy light and thy truth: let them lead me; let them bring me unto thy holy hill, and to thy tabernacles.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Then will I go unto the altar of God, unto God my exceeding joy: yea, upon the harp will I praise thee, O God my God.","poem":1},{"noteId":266}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Why art thou cast down, O my soul? and why art thou disquieted within me? hope in God: for I shall yet praise him, who is the health of my countenance, and my God.","poem":1}]}],"footnotes":[{"noteId":264,"caller":"+","text":"43.1 ungodly: or, unmerciful","reference":{"chapter":43,"verse":1}},{"noteId":265,"caller":"+","text":"43.1 the deceitful…: Heb. a man of deceit and iniquity","reference":{"chapter":43,"verse":1}},{"noteId":266,"caller":"+","text":"43.4 my exceeding…: Heb. the gladness of my joy","reference":{"chapter":43,"verse":4}}]},"thisChapterLink":"/api/eng_kja/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kja/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kja/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}