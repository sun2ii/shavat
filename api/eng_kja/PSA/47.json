{"translation":{"id":"eng_kja","name":"King James Version + Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseNotes":null,"shortName":"KJVA","englishName":"King James Version + Apocrypha","language":"eng","textDirection":"ltr","sha256":"b1ab484e9936613a03c53c677faf47c894eaab558329766076eaadf38af1e736","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kja/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_kja","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"a601ba791422c1329a43069410996ca9a32b1709438a7501a089b1952e066484","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kja/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician, A Psalm for the sons of Korah."]},{"type":"verse","number":1,"content":[{"text":"O clap your hands, all ye people; shout unto God with the voice of triumph.","poem":1},{"noteId":280}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For the LORD most high is terrible; he is a great King over all the earth.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He shall subdue the people under us, and the nations under our feet.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He shall choose our inheritance for us, the excellency of Jacob whom he loved. Selah.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"God is gone up with a shout, the LORD with the sound of a trumpet.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sing praises to God, sing praises: sing praises unto our King, sing praises.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For God is the King of all the earth: sing ye praises with understanding.","poem":1},{"noteId":281}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"God reigneth over the heathen: God sitteth upon the throne of his holiness.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The princes of the people are gathered together, even the people of the God of Abraham: for the shields of the earth belong unto God: he is greatly exalted.","poem":1},{"noteId":282}]}],"footnotes":[{"noteId":280,"caller":"+","text":"47.1 for: or, of","reference":{"chapter":47,"verse":1}},{"noteId":281,"caller":"+","text":"47.7 with: or, every one that hath","reference":{"chapter":47,"verse":7}},{"noteId":282,"caller":"+","text":"47.9 princes…: or, voluntary of the people are gathered unto the people of the God of Abraham","reference":{"chapter":47,"verse":9}}]},"thisChapterLink":"/api/eng_kja/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kja/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kja/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}