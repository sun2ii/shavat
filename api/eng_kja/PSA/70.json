{"translation":{"id":"eng_kja","name":"King James Version + Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseNotes":null,"shortName":"KJVA","englishName":"King James Version + Apocrypha","language":"eng","textDirection":"ltr","sha256":"b1ab484e9936613a03c53c677faf47c894eaab558329766076eaadf38af1e736","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kja/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_kja","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"a601ba791422c1329a43069410996ca9a32b1709438a7501a089b1952e066484","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kja/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician, A Psalm of David, to bring to remembrance."]},{"type":"verse","number":1,"content":[{"text":"Make haste, O God, to deliver me; make haste to help me, O LORD.","poem":1},{"noteId":416}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Let them be ashamed and confounded that seek after my soul: let them be turned backward, and put to confusion, that desire my hurt.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let them be turned back for a reward of their shame that say, Aha, aha.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Let all those that seek thee rejoice and be glad in thee: and let such as love thy salvation say continually, Let God be magnified.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"But I am poor and needy: make haste unto me, O God: thou art my help and my deliverer; O LORD, make no tarrying.","poem":1}]}],"footnotes":[{"noteId":416,"caller":"+","text":"70.1 to help…: Heb. to my help","reference":{"chapter":70,"verse":1}}]},"thisChapterLink":"/api/eng_kja/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kja/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kja/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}