{"translation":{"id":"eng_kja","name":"King James Version + Apocrypha","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv","licenseNotes":null,"shortName":"KJVA","englishName":"King James Version + Apocrypha","language":"eng","textDirection":"ltr","sha256":"b1ab484e9936613a03c53c677faf47c894eaab558329766076eaadf38af1e736","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kja/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5720},"book":{"id":"PSA","translationId":"eng_kja","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"a601ba791422c1329a43069410996ca9a32b1709438a7501a089b1952e066484","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kja/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kja/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"The LORD reigneth, he is clothed with majesty; the LORD is clothed with strength, wherewith he hath girded himself: the world also is stablished, that it cannot be moved.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Thy throne is established of old: thou art from everlasting.","poem":1},{"noteId":550}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The floods have lifted up, O LORD, the floods have lifted up their voice; the floods lift up their waves.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The LORD on high is mightier than the noise of many waters, yea, than the mighty waves of the sea.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Thy testimonies are very sure: holiness becometh thine house, O LORD, for ever.","poem":1},{"noteId":551}]}],"footnotes":[{"noteId":550,"caller":"+","text":"93.2 of old: Heb. from then","reference":{"chapter":93,"verse":2}},{"noteId":551,"caller":"+","text":"93.5 for ever: Heb. to length of days","reference":{"chapter":93,"verse":5}}]},"thisChapterLink":"/api/eng_kja/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kja/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kja/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}