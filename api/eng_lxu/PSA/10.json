{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":10,"content":[{"type":"hebrew_subtitle","content":["(11 in KJV) For the end, a Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"In the Lord I have put my trust: how will you⌃ say to my soul,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Flee to the mountains as a sparrow?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For behold the sinners have bent their bow, they have prepared their arrows for the quiver, to shoot","poem":1},{"noteId":21},{"text":"privily at the upright in heart.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For they have pulled down what you did frame, but what has the righteous done?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The Lord is in his holy temple, as for the Lord, his throne is in heaven: his eyes look upon the poor, his eyelids try the sons of men.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The Lord tries the righteous and the ungodly: and he that loves unrighteousness hates his own soul.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He shall rain upon sinners snares, fire, and brimstone, and a stormy blast shall be the portion of their cup.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For the Lord is righteous, and loves","poem":1},{"noteId":22},{"text":"righteousness; his face beholds uprightness.","poem":1}]}],"footnotes":[{"noteId":21,"caller":"+","text":"Gr. in dark moon, or little moonlight, q. d. luce malignâ","reference":{"chapter":10,"verse":3}},{"noteId":22,"caller":"+","text":"Gr. righteousnesses","reference":{"chapter":10,"verse":8}}]},"thisChapterLink":"/api/eng_lxu/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":8}