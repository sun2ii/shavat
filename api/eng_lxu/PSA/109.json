{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":109,"content":[{"type":"hebrew_subtitle","content":["(110) A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"The Lord said to my Lord, Sit you on my right hand, until I make your enemies your footstool.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The Lord shall send out a rod of power for you out of Sion: rule you in the midst of your enemies.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"With you is dominion in the day of your power, in the splendours of","poem":1},{"noteId":208},{"text":"your saints: I have begotten you from the womb before the morning.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The Lord swore, and will not repent, You are a priest for ever, after the order of Melchisedec.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The Lord at your right hand has dashed in pieces kings in the day of his wrath.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He shall judge amongst the nations, he shall fill up the number of corpses, he shall crush the heads of many on the earth.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He shall drink of the brook in the way; therefore shall he lift up the head.","poem":1}]}],"footnotes":[{"noteId":208,"caller":"+","text":"Or, holiness, i.e. holy things.","reference":{"chapter":109,"verse":3}}]},"thisChapterLink":"/api/eng_lxu/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":7}