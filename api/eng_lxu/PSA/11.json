{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["(12) For the end, A Psalm of David, upon the eighth."]},{"type":"verse","number":1,"content":[{"text":"Save me, O Lord; for the godly man has failed; for","poem":1},{"noteId":23},{"text":"truth is diminished from amongst the children of men.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Every one has spoken vanity to his neighbour: their lips are deceitful, they have spoken with a double heart.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let the Lord destroy all the deceitful lips, and the tongue that speaks great words:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"who have said, We will magnify our tongue; our lips are our own: who is Lord of us?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Because of the misery of the poor, and because of the sighing of the needy, now will I arise, says the Lord, I will set them in safety; I will speak to them thereof openly.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The oracles of the Lord are pure oracles; as silver tried in the fire, proved in","poem":1},{"noteId":24},{"text":"a furnace of earth, purified seven times.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"You, O Lord, shall keep us, and shall preserve us, from this generation, and for ever.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The ungodly walk around: according to your greatness you have greatly exalted the sons of men.","poem":1}]}],"footnotes":[{"noteId":23,"caller":"+","text":"Gr. truths are become rare","reference":{"chapter":11,"verse":1}},{"noteId":24,"caller":"+","text":"Gr. the earth.","reference":{"chapter":11,"verse":6}}]},"thisChapterLink":"/api/eng_lxu/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":8}