{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["(111) Alleluia."]},{"type":"verse","number":1,"content":[{"text":"I will give you thanks, O Lord, with my whole heart, in the council of the upright, and in the congregation.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The works of the Lord are great, sought out","poem":1},{"noteId":209},{"text":"according to all his will.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"His work is worthy of thanksgiving and honour: and his righteousness endures for ever and ever.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He has caused his wonderful works to be remembered: the Lord is merciful and compassionate.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"He has given food to them that fear him: he will remember his covenant for ever.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He has declared to his people the power of his works, to give them the inheritance of the heathen.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The works of his hands are truth and judgement: all his commandments are sure:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"established for ever and ever, done in truth and uprightness.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He sent redemption to his people: he commanded his covenant for ever: holy and fearful is his name.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"The fear of the Lord is the","poem":1},{"noteId":210},{"text":"beginning of wisdom, and all that act accordingly have a good understanding; his praise endures for ever and ever.","poem":1}]}],"footnotes":[{"noteId":209,"caller":"+","text":"Comp. Gr. with Heb.","reference":{"chapter":110,"verse":2}},{"noteId":210,"caller":"+","text":"Or, sum.","reference":{"chapter":110,"verse":10}}]},"thisChapterLink":"/api/eng_lxu/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":10}