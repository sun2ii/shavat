{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":111,"content":[{"type":"hebrew_subtitle","content":["(112) Alleluia."]},{"type":"verse","number":1,"content":[{"text":"Blessed is the man that fears the Lord: he will delight greatly in his commandments.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"His seed shall be mighty in the earth: the generation of the upright shall be blessed.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Glory and riches shall be in his house; and his righteousness endures for evermore.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"To the upright light has sprung up in darkness: he is pitiful, and merciful, and righteous.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The good man is he that pities and lends: he will direct his affairs with judgement.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"For he shall not be moved for ever; the righteous shall be in everlasting remembrance.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He shall not be afraid of any evil report: his heart is ready to trust in the Lord.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"His heart is established, he shall not fear, till he shall see his desire upon his enemies.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He has dispersed abroad; he has given to the poor; his righteousness endures for evermore: his horn shall be exalted with honour.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"The sinner shall see and be angry, he shall gnash his teeth, and consume away: the desire of the sinner shall perish.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_lxu/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}