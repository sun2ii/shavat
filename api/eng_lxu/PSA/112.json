{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":112,"content":[{"type":"hebrew_subtitle","content":["(113) Alleluia."]},{"type":"verse","number":1,"content":[{"text":"Praise the Lord, you⌃ servants of his, praise, the name of the Lord.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Let the name of the Lord be blessed, from this present time and for ever.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"From the rising of the sun to his setting, the name of the Lord is to be praised.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The Lord is high above all the nations; his glory is above the heavens.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Who is as the Lord our God? who dwells in the high places,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"and yet looks upon the low things in heaven, and on the earth:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"who lifts up the poor from the earth, and raises up the needy from the dunghill;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"to set him with princes, even with the princes of his people:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"who settles the barren woman in a house, as a mother rejoicing over children.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_lxu/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":9}