{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":113,"content":[{"type":"hebrew_subtitle","content":["(114) Alleluia."]},{"type":"verse","number":1,"content":[{"text":"At the going forth of Israel from Egypt, of the house of Jacob from a barbarous people,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Judea became his","poem":1},{"noteId":211},{"text":"sanctuary, and Israel his dominion.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The sea saw and fled: Jordan was turned back.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The mountains skipped like rams, and the hills like lambs.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"What ailed you, O sea, that you fled? and you Jordan, that you were turned back?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"You⌃ mountains, that you⌃ skipped like rams, and you⌃ hills, like lambs?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The earth trembled at the presence of the Lord, at the presence of the God of Jacob;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"who turned the rock into pools of water, and the","poem":1},{"noteId":212},{"text":"flint into fountains of water.","poem":1}]}],"footnotes":[{"noteId":211,"caller":"+","text":"Or, consecrated thing.","reference":{"chapter":113,"verse":2}},{"noteId":212,"caller":"+","text":"Gr. sharp rock.","reference":{"chapter":113,"verse":8}}]},"thisChapterLink":"/api/eng_lxu/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":8}