,{"text":"The sun shall not burn you by day, neither the moon by night.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"May the Lord preserve you from all evil: the Lord shall keep your soul.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The Lord shall keep your coming in, and your going out, from henceforth and even for ever.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_lxu/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":8}