{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":121,"content":[{"type":"hebrew_subtitle","content":["(122) A Song of Degrees."]},{"type":"verse","number":1,"content":[{"text":"I was glad when they said to me, Let us go into the house of the Lord.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Our feet stood in your courts, O Jerusalem.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jerusalem is built as a city whose fellowship is complete.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For there the tribes went up, the tribes of the Lord, as a testimony for Israel, to give thanks to the name of the Lord.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For there are set thrones for judgement, even thrones for the house of David.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"noteId":229},{"text":"Pray now for the peace of Jerusalem: and let there be prosperity to them that love you.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Let peace, I pray, be within your host, and prosperity in your palaces.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For the sake of my brethren and my neighbours, I have indeed spoken peace concerning you.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Because of the house of the Lord our God, I have diligently sought your good.","poem":1}]}],"footnotes":[{"noteId":229,"caller":"+","text":"Or, ask Jerusalem how it is with her.","reference":{"chapter":121,"verse":6}}]},"thisChapterLink":"/api/eng_lxu/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":9}