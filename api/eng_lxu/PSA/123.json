{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":123,"content":[{"type":"hebrew_subtitle","content":["(124) A Song of Degrees."]},{"type":"verse","number":1,"content":[{"text":"If it had not been that the Lord was amongst us, let Israel now say;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"if it had not been that the Lord was amongst us, when men rose up against us;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"verily they would have swallowed us up alive, when their wrath was kindled against us:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"verily the water would have drowned us, our soul would have gone under the torrent.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yes, our soul would have gone under the overwhelming water.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Blessed be the Lord, who has not given us for a prey to their teeth.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Our soul has been delivered as a sparrow from the snare of the fowlers: the snare is broken, and we are delivered.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Our help is in the name of the Lord, who made heaven and earth.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_lxu/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":8}