ntent":[{"lineBreak":true},{"text":"Blessed is the man who shall satisfy his desire with them: they shall not be ashamed when they shall speak to their enemies in the gates.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_lxu/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":5}