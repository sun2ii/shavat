{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":128,"content":[{"type":"verse","number":1,"content":[{"text":"A Song of Degrees. Many a time have they warred against me from my youth, let Israel now say:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Many a time have they warred against me from my youth: and yet they prevailed not against me.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The sinners wrought upon my back: they prolonged their","poem":1},{"noteId":233},{"text":"iniquity.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The righteous Lord has cut asunder the necks of sinners.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Let all that hate Sion be put to shame and turned back.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Let them be as the grass of the housetops, which withers before it is plucked up.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wherewith the reaper fills not his hand, nor he that makes up the sheaves, his bosom.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Neither do they that go by say, The blessing of the Lord be upon you: we have blessed you in the name of the Lord.","poem":1}]}],"footnotes":[{"noteId":233,"caller":"+","text":"שיך iniquity, easily read for שוכה a furrow.","reference":{"chapter":128,"verse":3}}]},"thisChapterLink":"/api/eng_lxu/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":8}