}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"My soul has hoped in the Lord; from the morning watch till night.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Let Israel hope in the Lord: for with the Lord is mercy, and with him is plenteous redemption.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"And he shall redeem Israel from all his iniquities.","poem":1}]}],"footnotes":[{"noteId":234,"caller":"+","text":"Or, propitiation.","reference":{"chapter":129,"verse":4}},{"noteId":235,"caller":"+","text":"See Gen 31:53.","reference":{"chapter":129,"verse":4}}]},"thisChapterLink":"/api/eng_lxu/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}