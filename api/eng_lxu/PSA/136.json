{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":136,"content":[{"type":"hebrew_subtitle","content":["(137)",{"noteId":241},"For David, a Psalm of Jeremias."]},{"type":"verse","number":1,"content":[{"text":"By the rivers of Babylon, there we sat; and wept when we remembered Sion.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"We hung our","poem":1},{"noteId":242},{"text":"harps on the willows in the midst of it.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For there they that had taken us captive asked of us the words of a song; and they that had carried us away asked a hymn, saying, Sing us one of the songs of Sion.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"How should we sing the Lord's song","poem":1},{"noteId":243},{"text":"in a strange land?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"If I forget you, O Jerusalem, let my right hand forget its skill.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"May my tongue cleave to my throat, if I do not remember you; if I do not prefer Jerusalem as the chief of my joy.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Remember, O Lord, the children of Edom in the day of Jerusalem; who said, Rase it,","poem":1},{"noteId":244},{"text":"rase it, even to its foundations.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wretched daughter of Babylon! blessed shall he be who shall reward you as you have rewarded us.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Blessed shall he be who shall seize and dash your infants against the rock.","poem":1}]}],"footnotes":[{"noteId":241,"caller":"+","text":"Alex. omits.","reference":{"chapter":136,"verse":0}},{"noteId":242,"caller":"+","text":"Gr. organs, or, instruments.","reference":{"chapter":136,"verse":2}},{"noteId":243,"caller":"+","text":"Gr. on","reference":{"chapter":136,"verse":4}},{"noteId":244,"caller":"+","text":"Gr. empty, empty.","reference":{"chapter":136,"verse":7}}]},"thisChapterLink":"/api/eng_lxu/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":9}