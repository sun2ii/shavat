{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":140,"content":[{"type":"hebrew_subtitle","content":["(141) A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"O Lord, I have cried to you; hear me: attend to the voice of my supplication, when I cry to you.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Let my prayer be set forth before you as incense; the lifting up of my hands as an evening sacrifice.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Set a watch, O Lord, on my mouth, and a","poem":1},{"noteId":252},{"text":"strong door about by lips.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Incline not my heart to evil things, to","poem":1},{"noteId":253},{"text":"employ pretexts","poem":1},{"noteId":254},{"text":"for sins, with those who work iniquity. Let me not unite with their choice ones.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The righteous shall chasten me with mercy, and reprove me: but let not the oil of the sinner anoint my head: for yet shall my prayer also be in their","poem":1},{"noteId":255},{"text":"pleasures.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Their mighty ones have been swallowed up near the rock: they shall hear my words, for they are sweet.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"As a lump of earth is crushed upon the ground, our bones have been scattered by the mouth of the grave.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For my eyes are to you, O Lord God: I have hoped in you; take not away my life.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Keep me from the snare which they have set for me, and from the stumbling blocks of them that work iniquity.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sinners shall fall by their own net: I am alone until I shall escape.","poem":1}]}],"footnotes":[{"noteId":252,"caller":"+","text":"Lit. a door of fortification.","reference":{"chapter":140,"verse":3}},{"noteId":253,"caller":"+","text":"Gr. pretend pretences.","reference":{"chapter":140,"verse":4}},{"noteId":254,"caller":"+","text":"Gr. in.","reference":{"chapter":140,"verse":4}},{"noteId":255,"caller":"+","text":"q.d. lest I be injured by them.","reference":{"chapter":140,"verse":5}}]},"thisChapterLink":"/api/eng_lxu/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":10}