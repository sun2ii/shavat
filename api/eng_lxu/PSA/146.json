{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":146,"content":[{"type":"hebrew_subtitle","content":["(147) Alleluia, a Psalm of Aggaeus and Zacharias."]},{"type":"verse","number":1,"content":[{"text":"Praise you⌃ the Lord: for psalmody is a good thing; let praise be sweetly sung to our God.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The Lord builds up Jerusalem; and he will gather together the dispersed of Israel.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He heals the broken in heart, and binds up their wounds.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He numbers the multitudes of stars; and calls them all by names.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Great is our Lord, and great is his strength; and his understanding is infinite.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The Lord lifts up the meek; but brings sinners down to the ground.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Begin the song with thanksgiving to the Lord; sing praises on the harp to our God:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"who covers the heaven with clouds, who prepares rain for the earth, who causes grass to spring up on the mountains, [","poem":1},{"noteId":264},{"text":"and green herb for the service of men;]","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"and gives cattle their food, and to the young ravens that call upon him.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"He will not take pleasure in the strength of a horse; neither is he well-pleased with the legs of a man.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"The Lord takes pleasure in them that fear him, and in all that hope in his mercy.","poem":1}]}],"footnotes":[{"noteId":264,"caller":"+","text":"See Ps 103 (104) 14.","reference":{"chapter":146,"verse":8}}]},"thisChapterLink":"/api/eng_lxu/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":11}