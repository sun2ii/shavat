{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":147,"content":[{"type":"hebrew_subtitle","content":["Alleluia, a Psalm of Aggaeus and Zacharias.",{"noteId":265}]},{"type":"verse","number":1,"content":[{"text":"Praise the Lord, O Jerusalem; praise your God, O Sion.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For he has strengthened the bars of your gates; he has blessed your children within you.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He makes your borders peaceful, and fills you with the","poem":1},{"noteId":266},{"text":"flour of wheat.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He sends his oracle to the earth: his word will run swiftly.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"He gives snow like wool: he scatters the mist like ashes.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Casting forth his ice like morsels: who shall stand before his cold?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He shall send out his word, and melt them: he shall blow with his wind, and the waters shall flow.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"He sends his word to Jacob, his ordinances and judgements to Israel.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He has not done so to","poem":1},{"noteId":267},{"text":"any other nation; and he has not shown them his judgements.","poem":1}]}],"footnotes":[{"noteId":265,"caller":"+","text":"In the original text, the following verses are numbered 12 to 20.","reference":{"chapter":147,"verse":0}},{"noteId":266,"caller":"+","text":"Lit. fat of wheat.","reference":{"chapter":147,"verse":3}},{"noteId":267,"caller":"+","text":"Gr. every.","reference":{"chapter":147,"verse":9}}]},"thisChapterLink":"/api/eng_lxu/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":9}