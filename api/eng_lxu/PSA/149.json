{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":149,"content":[{"type":"hebrew_subtitle","content":["Alleluia."]},{"type":"verse","number":1,"content":[{"text":"Sing to the Lord a new song: his praise is in the assembly of the saints.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Let Israel rejoice in him that made him; and let the children of Sion exult in their king.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let them praise his name in the dance: let them sings praises to him with timbrel and lute.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For the Lord takes pleasure in his people; and will exalt the meek with salvation.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The saints shall rejoice in glory; and shall exult on their beds.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The","poem":1},{"noteId":269},{"text":"high praises of God shall be in their throat, and two-edged swords in their hands;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"to execute vengeance on the nations, and punishments amongst the peoples;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"to bind their kings with fetters, and their nobles with manacles of iron; to execute on them the judgement","poem":1},{"noteId":270},{"text":"written: this honour have all his saints.","poem":1}]}],"footnotes":[{"noteId":269,"caller":"+","text":"Gr. exaltations, q.d. extollings.","reference":{"chapter":149,"verse":6}},{"noteId":270,"caller":"+","text":"Gr. inscribed, sc. in the scripture.","reference":{"chapter":149,"verse":8}}]},"thisChapterLink":"/api/eng_lxu/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":8}