{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":151,"content":[{"type":"hebrew_subtitle","content":["This Psalm is a genuine one of David, though supernumerary, composed when he fought in single combat with",{"noteId":271},"Goliad."]},{"type":"verse","number":1,"content":[{"text":"I was small amongst my brethren, and youngest in my father's house: I tended my father's sheep.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"My hands formed a musical instrument, and my fingers tuned a lute.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"And who shall tell my Lord? the Lord himself, he himself hears.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He sent forth his angel, and took me from my father's sheep, and he anointed me with the oil of his anointing.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"My brothers were handsome and tall; but the Lord did not take pleasure in them.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I went forth to meet the Philistine; and he cursed me by his idols.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"But I drew his own sword, and beheaded him, and removed reproach from the children of Israel.","poem":1}]}],"footnotes":[{"noteId":271,"caller":"+","text":"Alex. Goliath","reference":{"chapter":151,"verse":0}}]},"thisChapterLink":"/api/eng_lxu/PSA/151.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":7}