{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":19,"content":[{"type":"hebrew_subtitle","content":["(20) For the end, a Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"The Lord hear you in the day of trouble; the name of the God of Jacob defend you.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Send you help from the sanctuary, and aid you out of Sion.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Remember all your","poem":1},{"noteId":38},{"text":"sacrifice, and enrich your whole burnt offering. Pause.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Grant you according to your heart, and fulfil all your desire.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"We will exult in your salvation, and in the name of our God shall we be magnified: the Lord fulfil all your petitions.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Now I know that the Lord has saved his Christ: he shall hear him from his holy heaven: the salvation of his right hand is mighty.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Some glory in chariots, and some in horses: but we will","poem":1},{"noteId":39},{"text":"glory in the name of the Lord our God.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"They are overthrown and fallen: but we are risen, and have been set upright.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O Lord, save the king: and hear us in whatever day we call upon you.","poem":1}]}],"footnotes":[{"noteId":38,"caller":"+","text":"Or, meat offering.","reference":{"chapter":19,"verse":3}},{"noteId":39,"caller":"+","text":"Gr. be magnified.","reference":{"chapter":19,"verse":7}}]},"thisChapterLink":"/api/eng_lxu/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":9}