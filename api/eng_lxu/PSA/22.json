{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":22,"content":[{"type":"hebrew_subtitle","content":["(23) A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"The Lord tends me as a shepherd, and I shall lack nothing.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"In a place of green grass, there he has made me dwell: he has nourished me by the water of rest.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He has restored my soul: he has guided me into the paths of righteousness, for his name's sake.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yes, even if I should walk in the midst of the shadow of death, I will not be afraid of evils: for you are with me; your rod and your staff, these have comforted me.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"You have prepared a table before me in presence of them that afflict me: you have thoroughly anointed my head with oil; and your cup cheers me like the best wine.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Your mercy also shall follow me all the days of my life: and my dwelling shall be in the house of the Lord for a very long time.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_lxu/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":6}