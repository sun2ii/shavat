{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":25,"content":[{"type":"hebrew_subtitle","content":["(26) A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Judge me, O Lord; for I have walked in my innocence: and hoping in the Lord I shall not be moved.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Prove me, O Lord, and try me; purify as with fire my reins and my heart.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For your mercy is before my eyes: and I am well pleased with your truth.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I have not sat with the council of vanity, and will in nowise enter in with transgressors.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I have hated the assembly of wicked doers; and will not sit with ungodly men.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I will wash my hands in","poem":1},{"noteId":45},{"text":"innocency, and compass your altar, O Lord:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"to hear the voice of praise, and to declare all your wonderful works.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O Lord, I have loved the beauty of your house, and the place of the tabernacle of your glory.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Destroy not my soul together with the ungodly, nor my life with bloody men:","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"in whose hands are iniquities, and their right hand is filled with bribes.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"But I have walked in my innocence: redeem me, and have mercy upon me.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"My foot stands in","poem":1},{"noteId":46},{"text":"an even place: in the congregations will I bless you, O Lord.","poem":1}]}],"footnotes":[{"noteId":45,"caller":"+","text":"Gr. innocent things.","reference":{"chapter":25,"verse":6}},{"noteId":46,"caller":"+","text":"Gr. in evenness or uprightness.","reference":{"chapter":25,"verse":12}}]},"thisChapterLink":"/api/eng_lxu/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":12}