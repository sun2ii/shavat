{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":42,"content":[{"type":"hebrew_subtitle","content":["(43) A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Judge me, O God, and plead my cause, against an ungodly nation: deliver me from the unjust and crafty man.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For you, O God, are my strength: therefore have you cast me off? and why do I go sad of countenance, while the enemy oppresses me?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Send forth your light and your truth: they have led me, and brought me to your holy mountain, and to your tabernacles.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"And I will go in to the altar of God, to God who gladdens my youth: I will give thanks to you on the harp, O God, my God.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Therefore are you very sad, O my soul? and therefore do you trouble me? Hope in God; for I will give thanks to him, who is the health of my countenance, and my God.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_lxu/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":5}