{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":46,"content":[{"type":"hebrew_subtitle","content":["(47) For the end, a Psalm for the sons of Core."]},{"type":"verse","number":1,"content":[{"text":"Clap your hands, all you⌃ nations; shout to God with a voice of exultation.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For the Lord most high is terrible; he is a great king over all the earth.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He has subdued the peoples under us, and the nations under our feet.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He has chosen out his inheritance for us, the beauty of Jacob which he loved. Pause.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"God is gone up with a shout, the Lord with a sound of a trumpet.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sing praises to our God, sing praises: sing praises to our King, sing praises.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For God is king of all the earth: sing praises with understanding.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"God reigns over the nations: God sits upon the throne of his holiness.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The rulers of the people are assembled with the God of Abraam: for God's mighty ones of the earth have been greatly exalted.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_lxu/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":9}