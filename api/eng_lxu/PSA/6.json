{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":6,"content":[{"type":"hebrew_subtitle","content":["For the End, a Psalm of David amongst the Hymns for the eighth."]},{"type":"verse","number":1,"content":[{"text":"O Lord, rebuke me not in your wrath, neither chasten me in your anger.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pity me, O Lord; for I am weak: heal me, O Lord; for my bones are vexed.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"My soul also is grievously vexed: but you, O Lord, how long?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Return, O Lord, deliver my soul: save me for your mercy's sake.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For in death no man remembers you: and who will give you thanks in Hades?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"noteId":11},{"text":"I am wearied with my groaning; I shall wash my bed every night; I shall water my couch with tears.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"My eye is troubled because of my wrath; I am worn out because of all my enemies.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Depart from me, all you⌃ that work iniquity; for the Lord has heard the voice of my weeping.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The Lord has listened to my petition; the Lord has accepted my prayer.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Let all my enemies be put to shame and sore troubled: let them be turned back and grievously put to shame speedily.","poem":1}]}],"footnotes":[{"noteId":11,"caller":"+","text":"Gr. I have laboured.","reference":{"chapter":6,"verse":6}}]},"thisChapterLink":"/api/eng_lxu/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}