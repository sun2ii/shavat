{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":60,"content":[{"type":"hebrew_subtitle","content":["(61) For the end, amongst the Hymns of David."]},{"type":"verse","number":1,"content":[{"text":"O God, listen to my petition; attend to my prayer.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"From the ends of the earth have I cried to you, when my heart was in trouble: you lifted me up on a rock you did guide me:","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"because you were my hope, a tower of strength from the face of the enemy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I will dwell in your tabernacle for ever; I will shelter myself under the shadow of your wings. Pause.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For you, o God, have heard my prayers; you have given an inheritance to them that fear your name.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"You shall add days to the days of the king; you shall lengthen his years to all generations.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He shall endure for ever before God: which of them will seek out his mercy and truth?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"So will I sing to your name for ever and ever, that I may daily perform my vows.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_lxu/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":8}