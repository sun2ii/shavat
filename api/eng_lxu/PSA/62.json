{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":62,"content":[{"type":"hebrew_subtitle","content":["(63) A Psalm of David, when he was in the wilderness of Idumea."]},{"type":"verse","number":1,"content":[{"text":"O God, my God, I cry to you early; my soul has thirsted for you: how often has my flesh longed after you, in a barren and trackless and dry land!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Thus have I appeared before you in the sanctuary, that I might see your power and your glory.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For your mercy is better than","poem":1},{"noteId":112},{"text":"life: my lips shall praise you.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Thus will I bless you during my life: I will lift up my hands in your name.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Let my soul be filled as with marrow and fatness; and my joyful lips shall praise your name.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"noteId":113},{"text":"Forasmuch as I have remembered you on my bed: in the early seasons I have meditated on you.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For you have been my helper, and in the shelter of your wings will I rejoice.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"My soul has","poem":1},{"noteId":114},{"text":"kept very close behind you: your right hand has upheld me.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"But they vainly sought after my soul; they shall go into the lowest parts o the earth.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"They shall be delivered up to the power of the sword; they shall be portions for foxes.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"But the king shall rejoice in God; every one that swears by him shall be praised; for the mouth of them that speak unjust things has been stopped.","poem":1}]}],"footnotes":[{"noteId":112,"caller":"+","text":"Gr. lives.","reference":{"chapter":62,"verse":3}},{"noteId":113,"caller":"+","text":"Gr. if. See Acts 26:23","reference":{"chapter":62,"verse":6}},{"noteId":114,"caller":"+","text":"Gr. been glued.","reference":{"chapter":62,"verse":8}}]},"thisChapterLink":"/api/eng_lxu/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":11}