{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":8,"content":[{"type":"hebrew_subtitle","content":["For the end, concerning the wine presses, a Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"O Lord, our Lord, how wonderful is your name in all the earth! for your magnificence is exalted above the heavens.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Out of the mouth of babes and sucklings have you perfected praise, because of your enemies; that you might put down the enemy and avenger.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For I will regard the heavens, the work of your fingers; the moon and stars, which you have established.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"What is man, that you are mindful of him? or the son of man, that you visit him?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"You made him a little less than angels, you have crowned him with glory and honour;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"and you have set him over the works of your hands: you have put all things under his feet:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"sheep and all","poem":1},{"noteId":15},{"text":"oxen, yes and the cattle of the field;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"the birds of the sky, and the fish of the sea, the creatures passing through the paths of the sea.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O Lord our Lord, how wonderful is your name in all the earth!","poem":1}]}],"footnotes":[{"noteId":15,"caller":"+","text":"Gr. cows.","reference":{"chapter":8,"verse":7}}]},"thisChapterLink":"/api/eng_lxu/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}