{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":81,"content":[{"type":"hebrew_subtitle","content":["(82) A Psalm for Asaph."]},{"type":"verse","number":1,"content":[{"text":"God stands in the assembly of gods; and in the midst of them will judge gods.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"How long will you⌃ judge unrighteously, and accept the persons of sinners? Pause.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Judge the orphan and poor:","poem":1},{"noteId":154},{"text":"do justice to the low and needy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rescue the needy, and deliver the poor out of the hand of the sinner.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"They know not, nor understand; they walk on in darkness: all the foundations of the earth shall be shaken.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I have said, You⌃ are gods; and all of you children of the Most High.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"But you⌃ die as men, and fall as one of the princes.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Arise, O God, judge the earth: for you shall inherit all nations.","poem":1}]}],"footnotes":[{"noteId":154,"caller":"+","text":"Gr. justify.","reference":{"chapter":81,"verse":3}}]},"thisChapterLink":"/api/eng_lxu/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":8}