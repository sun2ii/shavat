{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":86,"content":[{"type":"hebrew_subtitle","content":["(87) A Psalm of a Song for the sons of Core."]},{"type":"verse","number":1,"content":[{"text":"His foundations are in the holy mountains.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The Lord loves the gates of Sion, more than all the tabernacles of Jacob.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Glorious things have been spoken of you, O city of God. Pause.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I will make mention of Raab and Babylon to them that know me: behold also the Philistines, and Tyre, and the people of the Ethiopians: these were born there.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A man shall say, Sion is my mother; and such a man was born in her; and the Highest himself has founded her.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The Lord shall recount it in the writing of the people, and of these princes that","poem":1},{"noteId":156},{"text":"were born in her.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The dwelling of all within you is as the dwelling of those that rejoice.","poem":1}]}],"footnotes":[{"noteId":156,"caller":"+","text":"Gr. have been in her.","reference":{"chapter":86,"verse":6}}]},"thisChapterLink":"/api/eng_lxu/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":7}