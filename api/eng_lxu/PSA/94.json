{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":94,"content":[{"type":"hebrew_subtitle","content":["(95) The praise of a Song by David."]},{"type":"verse","number":1,"content":[{"text":"Come, let us exult","poem":1},{"noteId":186},{"text":"in the Lord; let us make a joyful noise to God our Saviour.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Let us come before his presence with thanksgiving, and make a joyful noise to him with psalms.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For the Lord is a great God, and a great king over all gods:","poem":1},{"noteId":187},{"text":"for the Lord will not cast off his people.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For the ends of the earth are in his hands; and the heights of the mountains are his.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For the sea is his, and he made it: and his hands formed the dry land.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Come, let us worship and fall down before him; and weep before the Lord that made us.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For he is our God; and we are the people of his pasture, and the sheep of his hand.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"To-day, if you⌃ will hear his voice, harden not your hearts, as in the provocation, according to the day of","poem":1},{"noteId":188},{"text":"irritation in the wilderness:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"where your fathers tempted me, proved me, and saw my works.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Forty years was I grieved with this generation, and said, They do always err in their heart, and they have not known my ways.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"So I swore in my wrath, They shall not enter into my rest.","poem":1}]}],"footnotes":[{"noteId":186,"caller":"+","text":"Gr. to.","reference":{"chapter":94,"verse":1}},{"noteId":187,"caller":"+","text":"Heb. and Alex. omit this clause. See Ps. 93:14.","reference":{"chapter":94,"verse":3}},{"noteId":188,"caller":"+","text":"Note, πειρασμοῦ is the reading of several editions.","reference":{"chapter":94,"verse":8}}]},"thisChapterLink":"/api/eng_lxu/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":11}