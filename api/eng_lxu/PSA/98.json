{"translation":{"id":"eng_lxu","name":"LXX2012: Septuagint in British/International English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-uk-lxx2012","licenseNotes":null,"shortName":"LXXSB","englishName":"British English Septuagint 2012","language":"eng","textDirection":"ltr","sha256":"8d0b62b2526fef76b8909cc7c78f15e9abae8844409431ef62db70d10efad4c7","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxu/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxu","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"ef0cf57df546b3f0b6ff27f5b18ae98403ea792c8e05cf423390aeb481abafc7","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxu/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxu/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":98,"content":[{"type":"hebrew_subtitle","content":["(99) A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"The Lord reigns; —let the people rage; it is he that sits upon the cherubs, let the earth be moved.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The Lord is great in Sion, and is high over all the people.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let them give thanks to your great name; for it is terrible and holy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"And the king's honour loves judgement; you have prepared","poem":1},{"noteId":190},{"text":"equity, you have wrought judgement and justice in Jacob.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Exalt you⌃ the Lord our God, and worship at his footstool; for he is holy.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Moses and Aaron amongst his priests, and Samuel amongst them that call upon his name; they called upon the Lord, and he heard them.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He spoke to them in a pillar of cloud; they kept his testimonies, and the ordinances which he gave them.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O Lord our God, you heard them; O God, you became propitious to them, though you did take vengeance on all their devices.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Exalt you⌃ the Lord our God, and worship at his holy mountain; for the Lord our God is holy.","poem":1}]}],"footnotes":[{"noteId":190,"caller":"+","text":"Gr. equities.","reference":{"chapter":98,"verse":4}}]},"thisChapterLink":"/api/eng_lxu/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}