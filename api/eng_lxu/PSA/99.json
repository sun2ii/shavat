s truth endures to generation and generation.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_lxu/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxu/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxu/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":5}