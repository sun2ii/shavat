{"translation":{"id":"eng_lxx","name":"LXX2012: Septuagint in American English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseNotes":null,"shortName":"LXXSA","englishName":"LXX2012 U. S. English","language":"eng","textDirection":"ltr","sha256":"40ba1b77d2cf7ff98078a33c5ab0df1a5343c20510f684d8e8eedea7e8b1295c","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxx/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxx","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"5e9adc5cfe2892c101ce9d9a385a3e8de601924b116454da7bee1c08f4324cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxx/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxx/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":10,"content":[{"type":"hebrew_subtitle","content":["(11 in KJV) For the end, a Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"In the Lord I have put my trust: how will you⌃ say to my soul,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Flee to the mountains as a sparrow?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For behold the sinners have bent their bow, they have prepared their arrows for the quiver, to shoot","poem":1},{"noteId":21},{"text":"privily at the upright in heart.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For they have pulled down what you did frame, but what has the righteous done?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The Lord is in his holy temple, as for the Lord, his throne is in heaven: his eyes look upon the poor, his eyelids try the sons of men.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The Lord tries the righteous and the ungodly: and he that loves unrighteousness hates his own soul.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He shall rain upon sinners snares, fire, and brimstone, and a stormy blast shall be the portion of their cup.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For the Lord is righteous, and loves","poem":1},{"noteId":22},{"text":"righteousness; his face beholds uprightness.","poem":1}]}],"footnotes":[{"noteId":21,"caller":"+","text":"Gr. in dark moon, or little moonlight, q. d. luce malignâ","reference":{"chapter":10,"verse":3}},{"noteId":22,"caller":"+","text":"Gr. righteousnesses","reference":{"chapter":10,"verse":8}}]},"thisChapterLink":"/api/eng_lxx/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxx/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxx/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":8}