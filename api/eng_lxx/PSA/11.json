{"translation":{"id":"eng_lxx","name":"LXX2012: Septuagint in American English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseNotes":null,"shortName":"LXXSA","englishName":"LXX2012 U. S. English","language":"eng","textDirection":"ltr","sha256":"40ba1b77d2cf7ff98078a33c5ab0df1a5343c20510f684d8e8eedea7e8b1295c","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxx/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxx","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"5e9adc5cfe2892c101ce9d9a385a3e8de601924b116454da7bee1c08f4324cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxx/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxx/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["(12) For the end, A Psalm of David, upon the eighth."]},{"type":"verse","number":1,"content":[{"text":"Save me, O Lord; for the godly man has failed; for","poem":1},{"noteId":23},{"text":"truth is diminished from among the children of men.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Every one has spoken vanity to his neighbor: their lips are deceitful, they have spoken with a double heart.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let the Lord destroy all the deceitful lips, and the tongue that speaks great words:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"who have said, We will magnify our tongue; our lips are our own: who is Lord of us?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Because of the misery of the poor, and because of the sighing of the needy, now will I arise, says the Lord, I will set them in safety; I will speak to them thereof openly.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The oracles of the Lord are pure oracles; as silver tried in the fire, proved in","poem":1},{"noteId":24},{"text":"a furnace of earth, purified seven times.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"You, O Lord, shall keep us, and shall preserve us, from this generation, and for ever.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The ungodly walk around: according to your greatness you have greatly exalted the sons of men.","poem":1}]}],"footnotes":[{"noteId":23,"caller":"+","text":"Gr. truths are become rare","reference":{"chapter":11,"verse":1}},{"noteId":24,"caller":"+","text":"Gr. the earth.","reference":{"chapter":11,"verse":6}}]},"thisChapterLink":"/api/eng_lxx/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxx/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxx/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":8}