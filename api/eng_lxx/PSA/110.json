{"translation":{"id":"eng_lxx","name":"LXX2012: Septuagint in American English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseNotes":null,"shortName":"LXXSA","englishName":"LXX2012 U. S. English","language":"eng","textDirection":"ltr","sha256":"40ba1b77d2cf7ff98078a33c5ab0df1a5343c20510f684d8e8eedea7e8b1295c","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxx/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxx","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"5e9adc5cfe2892c101ce9d9a385a3e8de601924b116454da7bee1c08f4324cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxx/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxx/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["(111) Alleluia."]},{"type":"verse","number":1,"content":[{"text":"I will give you thanks, O Lord, with my whole heart, in the council of the upright, and in the congregation.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The works of the Lord are great, sought out","poem":1},{"noteId":209},{"text":"according to all his will.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"His work is worthy of thanksgiving and honor: and his righteousness endures for ever and ever.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He has caused his wonderful works to be remembered: the Lord is merciful and compassionate.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"He has given food to them that fear him: he will remember his covenant for ever.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He has declared to his people the power of his works, to give them the inheritance of the heathen.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The works of his hands are truth and judgment: all his commandments are sure:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"established for ever and ever, done in truth and uprightness.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He sent redemption to his people: he commanded his covenant for ever: holy and fearful is his name.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"The fear of the Lord is the","poem":1},{"noteId":210},{"text":"beginning of wisdom, and all that act accordingly have a good understanding; his praise endures for ever and ever.","poem":1}]}],"footnotes":[{"noteId":209,"caller":"+","text":"Comp. Gr. with Heb.","reference":{"chapter":110,"verse":2}},{"noteId":210,"caller":"+","text":"Or, sum.","reference":{"chapter":110,"verse":10}}]},"thisChapterLink":"/api/eng_lxx/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxx/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxx/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":10}