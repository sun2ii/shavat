{"translation":{"id":"eng_lxx","name":"LXX2012: Septuagint in American English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseNotes":null,"shortName":"LXXSA","englishName":"LXX2012 U. S. English","language":"eng","textDirection":"ltr","sha256":"40ba1b77d2cf7ff98078a33c5ab0df1a5343c20510f684d8e8eedea7e8b1295c","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxx/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxx","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"5e9adc5cfe2892c101ce9d9a385a3e8de601924b116454da7bee1c08f4324cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxx/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxx/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":111,"content":[{"type":"hebrew_subtitle","content":["(112) Alleluia."]},{"type":"verse","number":1,"content":[{"text":"Blessed is the man that fears the Lord: he will delight greatly in his commandments.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"His seed shall be mighty in the earth: the generation of the upright shall be blessed.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Glory and riches shall be in his house; and his righteousness endures for evermore.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"To the upright light has sprung up in darkness: he is pitiful, and merciful, and righteous.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The good man is he that pities and lends: he will direct his affairs with judgment.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"For he shall not be moved for ever; the righteous shall be in everlasting remembrance.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He shall not be afraid of any evil report: his heart is ready to trust in the Lord.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"His heart is established, he shall not fear, till he shall see his desire upon his enemies.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He has dispersed abroad; he has given to the poor; his righteousness endures for evermore: his horn shall be exalted with honor.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"The sinner shall see and be angry, he shall gnash his teeth, and consume away: the desire of the sinner shall perish.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_lxx/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxx/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxx/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}