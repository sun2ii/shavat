{"translation":{"id":"eng_lxx","name":"LXX2012: Septuagint in American English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseNotes":null,"shortName":"LXXSA","englishName":"LXX2012 U. S. English","language":"eng","textDirection":"ltr","sha256":"40ba1b77d2cf7ff98078a33c5ab0df1a5343c20510f684d8e8eedea7e8b1295c","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxx/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxx","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"5e9adc5cfe2892c101ce9d9a385a3e8de601924b116454da7bee1c08f4324cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxx/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxx/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":119,"content":[{"type":"hebrew_subtitle","content":["(120) A Song of Degrees."]},{"type":"verse","number":1,"content":[{"text":"In my affliction I cried to the Lord, and he listened to me.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Deliver my soul, O Lord, from unjust lips, and from a deceitful tongue.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"What should be given to you, and what should be added to you, for your crafty tongue?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sharpened weapons of the mighty, with coals of the desert.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Woe is me, that my sojourning is","poem":1},{"noteId":228},{"text":"prolonged; I have tabernacled among the tents of Kedar.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"My soul has long been a sojourner;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I was peaceful among them that hated peace; when I spoke to them, they warred against me without a cause.","poem":1}]}],"footnotes":[{"noteId":228,"caller":"+","text":"Heb. משך","reference":{"chapter":119,"verse":5}}]},"thisChapterLink":"/api/eng_lxx/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxx/PSA/120.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxx/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":7}