{"translation":{"id":"eng_lxx","name":"LXX2012: Septuagint in American English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseNotes":null,"shortName":"LXXSA","englishName":"LXX2012 U. S. English","language":"eng","textDirection":"ltr","sha256":"40ba1b77d2cf7ff98078a33c5ab0df1a5343c20510f684d8e8eedea7e8b1295c","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxx/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxx","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"5e9adc5cfe2892c101ce9d9a385a3e8de601924b116454da7bee1c08f4324cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxx/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxx/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":12,"content":[{"type":"hebrew_subtitle","content":["(13) For the end, a Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"How long, O Lord, will you forget me? for ever? how long will you turn away your face from me?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"How long shall I take counsel in my soul, having sorrows in my heart daily? how long shall my enemy be exalted over me?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Look on me, listen to me, O Lord my God: lighten my eyes, lest I sleep in death;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"lest at any time my enemy say, I have prevailed against him: my persecutors will exult if ever I should be moved.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"But I have hoped in your mercy; my heart shall exult in your salvation.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I will sing to the Lord who has dealt bountifully with me, and I will sing psalms to the name of the Lord most high.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_lxx/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxx/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxx/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}