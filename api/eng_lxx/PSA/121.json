{"translation":{"id":"eng_lxx","name":"LXX2012: Septuagint in American English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseNotes":null,"shortName":"LXXSA","englishName":"LXX2012 U. S. English","language":"eng","textDirection":"ltr","sha256":"40ba1b77d2cf7ff98078a33c5ab0df1a5343c20510f684d8e8eedea7e8b1295c","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxx/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxx","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"5e9adc5cfe2892c101ce9d9a385a3e8de601924b116454da7bee1c08f4324cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxx/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxx/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":121,"content":[{"type":"hebrew_subtitle","content":["(122) A Song of Degrees."]},{"type":"verse","number":1,"content":[{"text":"I was glad when they said to me, Let us go into the house of the Lord.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Our feet stood in your courts, O Jerusalem.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jerusalem is built as a city whose fellowship is complete.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For there the tribes went up, the tribes of the Lord, as a testimony for Israel, to give thanks to the name of the Lord.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For there are set thrones for judgment, even thrones for the house of David.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"noteId":229},{"text":"Pray now for the peace of Jerusalem: and let there be prosperity to them that love you.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Let peace, I pray, be within your host, and prosperity in your palaces.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For the sake of my brethren and my neighbors, I have indeed spoken peace concerning you.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Because of the house of the Lord our God, I have diligently sought your good.","poem":1}]}],"footnotes":[{"noteId":229,"caller":"+","text":"Or, ask Jerusalem how it is with her.","reference":{"chapter":121,"verse":6}}]},"thisChapterLink":"/api/eng_lxx/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxx/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxx/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":9}