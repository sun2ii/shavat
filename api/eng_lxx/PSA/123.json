{"translation":{"id":"eng_lxx","name":"LXX2012: Septuagint in American English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseNotes":null,"shortName":"LXXSA","englishName":"LXX2012 U. S. English","language":"eng","textDirection":"ltr","sha256":"40ba1b77d2cf7ff98078a33c5ab0df1a5343c20510f684d8e8eedea7e8b1295c","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxx/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxx","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"5e9adc5cfe2892c101ce9d9a385a3e8de601924b116454da7bee1c08f4324cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxx/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxx/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":123,"content":[{"type":"hebrew_subtitle","content":["(124) A Song of Degrees."]},{"type":"verse","number":1,"content":[{"text":"If it had not been that the Lord was among us, let Israel now say;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"if it had not been that the Lord was among us, when men rose up against us;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"verily they would have swallowed us up alive, when their wrath was kindled against us:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"verily the water would have drowned us, our soul would have gone under the torrent.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yes, our soul would have gone under the overwhelming water.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Blessed be the Lord, who has not given us for a prey to their teeth.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Our soul has been delivered as a sparrow from the snare of the fowlers: the snare is broken, and we are delivered.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Our help is in the name of the Lord, who made heaven and earth.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_lxx/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxx/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxx/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":8}