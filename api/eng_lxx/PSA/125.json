ontent":[{"lineBreak":true},{"text":"They went on and wept as they cast their seeds; but they shall surely come with exultation, bringing their sheaves with them.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_lxx/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxx/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxx/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":6}