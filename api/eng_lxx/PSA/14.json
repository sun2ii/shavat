:[{"lineBreak":true},{"text":"He has not","poem":1},{"noteId":25},{"text":"lent his money on usury, and has not received bribes against the innocent. He that does these things shall never be moved.","poem":1}]}],"footnotes":[{"noteId":25,"caller":"+","text":"Gr. given.","reference":{"chapter":14,"verse":5}}]},"thisChapterLink":"/api/eng_lxx/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxx/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxx/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":5}