{"translation":{"id":"eng_lxx","name":"LXX2012: Septuagint in American English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseNotes":null,"shortName":"LXXSA","englishName":"LXX2012 U. S. English","language":"eng","textDirection":"ltr","sha256":"40ba1b77d2cf7ff98078a33c5ab0df1a5343c20510f684d8e8eedea7e8b1295c","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxx/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxx","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"5e9adc5cfe2892c101ce9d9a385a3e8de601924b116454da7bee1c08f4324cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxx/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxx/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":145,"content":[{"type":"hebrew_subtitle","content":["(146) Alleluia, a Psalm of Aggaeus and Zacharias."]},{"type":"verse","number":1,"content":[{"text":"My soul, praise the Lord.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"While I live will I praise the Lord: I will sing praises to my God as long as I exist.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Trust not in princes, nor in the children of men, in whom there is no safety.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"His breath shall go forth, and he shall return to his earth; in that day all his thoughts shall perish.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Blessed is he whose helper is the God of Jacob, whose hope is in the Lord his God:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"who made heaven, and earth, the sea, and all things in them: who keeps truth for ever:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"who executes judgment for the wronged: who gives food to the hungry. The Lord looses the fettered ones:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"the Lord gives wisdom to the blind: The Lord sets up the broken down: the Lord loves the righteous: the Lord preserves the strangers;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"he will relieve the orphan and widow: but will utterly remove the way of sinners.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"The Lord shall reign for ever, even your God, O Sion, to all generations.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_lxx/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxx/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxx/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":10}