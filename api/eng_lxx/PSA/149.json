{"translation":{"id":"eng_lxx","name":"LXX2012: Septuagint in American English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseNotes":null,"shortName":"LXXSA","englishName":"LXX2012 U. S. English","language":"eng","textDirection":"ltr","sha256":"40ba1b77d2cf7ff98078a33c5ab0df1a5343c20510f684d8e8eedea7e8b1295c","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxx/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxx","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"5e9adc5cfe2892c101ce9d9a385a3e8de601924b116454da7bee1c08f4324cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxx/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxx/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":149,"content":[{"type":"hebrew_subtitle","content":["Alleluia."]},{"type":"verse","number":1,"content":[{"text":"Sing to the Lord a new song: his praise is in the assembly of the saints.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Let Israel rejoice in him that made him; and let the children of Sion exult in their king.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let them praise his name in the dance: let them sings praises to him with timbrel and lute.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For the Lord takes pleasure in his people; and will exalt the meek with salvation.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The saints shall rejoice in glory; and shall exult on their beds.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The","poem":1},{"noteId":269},{"text":"high praises of God shall be in their throat, and two-edged swords in their hands;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"to execute vengeance on the nations, and punishments among the peoples;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"to bind their kings with fetters, and their nobles with manacles of iron; to execute on them the judgment","poem":1},{"noteId":270},{"text":"written: this honor have all his saints.","poem":1}]}],"footnotes":[{"noteId":269,"caller":"+","text":"Gr. exaltations, q.d. extollings.","reference":{"chapter":149,"verse":6}},{"noteId":270,"caller":"+","text":"Gr. inscribed, sc. in the scripture.","reference":{"chapter":149,"verse":8}}]},"thisChapterLink":"/api/eng_lxx/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxx/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxx/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":8}