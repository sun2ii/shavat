{"translation":{"id":"eng_lxx","name":"LXX2012: Septuagint in American English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseNotes":null,"shortName":"LXXSA","englishName":"LXX2012 U. S. English","language":"eng","textDirection":"ltr","sha256":"40ba1b77d2cf7ff98078a33c5ab0df1a5343c20510f684d8e8eedea7e8b1295c","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxx/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxx","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"5e9adc5cfe2892c101ce9d9a385a3e8de601924b116454da7bee1c08f4324cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxx/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxx/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":151,"content":[{"type":"hebrew_subtitle","content":["This Psalm is a genuine one of David, though supernumerary, composed when he fought in single combat with",{"noteId":271},"Goliad."]},{"type":"verse","number":1,"content":[{"text":"I was small among my brethren, and youngest in my father's house: I tended my father's sheep.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"My hands formed a musical instrument, and my fingers tuned a lute.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"And who shall tell my Lord? the Lord himself, he himself hears.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He sent forth his angel, and took me from my father's sheep, and he anointed me with the oil of his anointing.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"My brothers were handsome and tall; but the Lord did not take pleasure in them.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I went forth to meet the Philistine; and he cursed me by his idols.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"But I drew his own sword, and beheaded him, and removed reproach from the children of Israel.","poem":1}]}],"footnotes":[{"noteId":271,"caller":"+","text":"Alex. Goliath","reference":{"chapter":151,"verse":0}}]},"thisChapterLink":"/api/eng_lxx/PSA/151.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxx/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxx/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":7}