{"translation":{"id":"eng_lxx","name":"LXX2012: Septuagint in American English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseNotes":null,"shortName":"LXXSA","englishName":"LXX2012 U. S. English","language":"eng","textDirection":"ltr","sha256":"40ba1b77d2cf7ff98078a33c5ab0df1a5343c20510f684d8e8eedea7e8b1295c","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxx/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxx","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"5e9adc5cfe2892c101ce9d9a385a3e8de601924b116454da7bee1c08f4324cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxx/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxx/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":19,"content":[{"type":"hebrew_subtitle","content":["(20) For the end, a Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"The Lord hear you in the day of trouble; the name of the God of Jacob defend you.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Send you help from the sanctuary, and aid you out of Sion.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Remember all your","poem":1},{"noteId":38},{"text":"sacrifice, and enrich your whole burnt offering. Pause.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Grant you according to your heart, and fulfill all your desire.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"We will exult in your salvation, and in the name of our God shall we be magnified: the Lord fulfil all your petitions.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Now I know that the Lord has saved his Christ: he shall hear him from his holy heaven: the salvation of his right hand is mighty.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Some glory in chariots, and some in horses: but we will","poem":1},{"noteId":39},{"text":"glory in the name of the Lord our God.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"They are overthrown and fallen: but we are risen, and have been set upright.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O Lord, save the king: and hear us in whatever day we call upon you.","poem":1}]}],"footnotes":[{"noteId":38,"caller":"+","text":"Or, meat offering.","reference":{"chapter":19,"verse":3}},{"noteId":39,"caller":"+","text":"Gr. be magnified.","reference":{"chapter":19,"verse":7}}]},"thisChapterLink":"/api/eng_lxx/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxx/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxx/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":9}