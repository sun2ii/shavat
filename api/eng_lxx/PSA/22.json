{"translation":{"id":"eng_lxx","name":"LXX2012: Septuagint in American English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseNotes":null,"shortName":"LXXSA","englishName":"LXX2012 U. S. English","language":"eng","textDirection":"ltr","sha256":"40ba1b77d2cf7ff98078a33c5ab0df1a5343c20510f684d8e8eedea7e8b1295c","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxx/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxx","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"5e9adc5cfe2892c101ce9d9a385a3e8de601924b116454da7bee1c08f4324cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxx/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxx/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":22,"content":[{"type":"hebrew_subtitle","content":["(23) A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"The Lord tends me as a shepherd, and I shall lack nothing.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"In a place of green grass, there he has made me dwell: he has nourished me by the water of rest.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He has restored my soul: he has guided me into the paths of righteousness, for his name's sake.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yes, even if I should walk in the midst of the shadow of death, I will not be afraid of evils: for you are with me; your rod and your staff, these have comforted me.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"You have prepared a table before me in presence of them that afflict me: you have thoroughly anointed my head with oil; and your cup cheers me like the best wine.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Your mercy also shall follow me all the days of my life: and my dwelling shall be in the house of the Lord for a very long time.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_lxx/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxx/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxx/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":6}