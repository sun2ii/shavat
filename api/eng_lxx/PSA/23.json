{"translation":{"id":"eng_lxx","name":"LXX2012: Septuagint in American English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseNotes":null,"shortName":"LXXSA","englishName":"LXX2012 U. S. English","language":"eng","textDirection":"ltr","sha256":"40ba1b77d2cf7ff98078a33c5ab0df1a5343c20510f684d8e8eedea7e8b1295c","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxx/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxx","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"5e9adc5cfe2892c101ce9d9a385a3e8de601924b116454da7bee1c08f4324cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxx/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxx/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["(24) A Psalm for David on the first day of the week."]},{"type":"verse","number":1,"content":[{"text":"The earth is the Lord's and the fullness thereof; the world, and all that dwell in it.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"He has founded it upon the seas, and prepared it upon the rivers.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Who shall go up to the mountain of the Lord, and who shall stand in his holy place?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He that is innocent in his hands and pure in his heart; who has not lifted up his soul to vanity, nor sworn deceitfully","poem":1},{"noteId":42},{"text":"to his neighbor.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"He shall receive a blessing from the Lord, and mercy from God his Saviour.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"This is the generation of them that seek him, that seek the face of the God of Jacob. Pause.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lift up your gates, you⌃ princes, and be you⌃ lifted up, you⌃ everlasting doors; and the king of glory shall come in.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Who is this king of Glory? the Lord strong and mighty, the Lord mighty in battle.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lift up your gates, you⌃ princes; and be you⌃ lift up, you⌃ everlasting doors; and the king of glory shall come in.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Who is this king of glory? The Lord of hosts, he is this king of glory.","poem":1}]}],"footnotes":[{"noteId":42,"caller":"+","text":"Or, against.","reference":{"chapter":23,"verse":4}}]},"thisChapterLink":"/api/eng_lxx/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxx/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxx/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":10}