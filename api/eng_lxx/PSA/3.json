{"translation":{"id":"eng_lxx","name":"LXX2012: Septuagint in American English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseNotes":null,"shortName":"LXXSA","englishName":"LXX2012 U. S. English","language":"eng","textDirection":"ltr","sha256":"40ba1b77d2cf7ff98078a33c5ab0df1a5343c20510f684d8e8eedea7e8b1295c","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxx/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxx","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"5e9adc5cfe2892c101ce9d9a385a3e8de601924b116454da7bee1c08f4324cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxx/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxx/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David, when he fled from the presence of his son Abessalom."]},{"type":"verse","number":1,"content":[{"text":"O Lord, why are they that afflict me multiplied? many rise up against me.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Many say concerning my soul, There is no deliverance for him in his God.","poem":1},{"noteId":5},{"text":"Pause.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"But you, O Lord, are my helper: my glory, and the one that lifts up my head.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I cried to the Lord with my voice, and he heard me out of his holy mountain. Pause.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I lay down and slept; I awaked; for the Lord will help me.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I will not be afraid of ten thousands of people, who beset me round about.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Arise, Lord; deliver me, my God: for you have struck all who were without cause my enemies; you have broken the teeth of sinners.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Deliverance is the Lord's, and your blessing is upon your people.","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"The word Διάψαλμα (Selah) has been rendered Pause, as most intelligible to the English reader.","reference":{"chapter":3,"verse":2}}]},"thisChapterLink":"/api/eng_lxx/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxx/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxx/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}