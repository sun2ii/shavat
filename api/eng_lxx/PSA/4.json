{"translation":{"id":"eng_lxx","name":"LXX2012: Septuagint in American English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseNotes":null,"shortName":"LXXSA","englishName":"LXX2012 U. S. English","language":"eng","textDirection":"ltr","sha256":"40ba1b77d2cf7ff98078a33c5ab0df1a5343c20510f684d8e8eedea7e8b1295c","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxx/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxx","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"5e9adc5cfe2892c101ce9d9a385a3e8de601924b116454da7bee1c08f4324cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxx/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxx/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":4,"content":[{"type":"hebrew_subtitle","content":["For the End, a Song of David among the Psalms."]},{"type":"verse","number":1,"content":[{"text":"When I called upon him, the God of my righteousness heard me: you have made room for me in tribulation; pity me, and listen to my prayer.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O you⌃ sons of men, how long will you⌃ be","poem":1},{"noteId":6},{"text":"slow of heart? therefore do you⌃ love vanity, and seek falsehood? Pause.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"But know you⌃ that the Lord has done wondrous things for his holy one: the Lord will hear me when I cry to him.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Be you⌃ angry, and sin not; feel compunction upon your beds for what you⌃ say in your hearts. Pause.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Offer the sacrifice of righteousness, and trust in the Lord.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Many say, Who will show us good things? the light of your countenance, O Lord, has been manifested towards us.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"You have put gladness into my heart: they have been satisfied with the fruit of their corn and wine and oil.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I will","poem":1},{"noteId":7},{"text":"both lie down in peace and sleep: for you, Lord, only have caused me to dwell securely.","poem":1}]}],"footnotes":[{"noteId":6,"caller":"+","text":"Lit. heavy of heart.","reference":{"chapter":4,"verse":2}},{"noteId":7,"caller":"+","text":"Or. at the same time.","reference":{"chapter":4,"verse":8}}]},"thisChapterLink":"/api/eng_lxx/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxx/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxx/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}