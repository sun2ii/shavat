{"translation":{"id":"eng_lxx","name":"LXX2012: Septuagint in American English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseNotes":null,"shortName":"LXXSA","englishName":"LXX2012 U. S. English","language":"eng","textDirection":"ltr","sha256":"40ba1b77d2cf7ff98078a33c5ab0df1a5343c20510f684d8e8eedea7e8b1295c","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxx/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxx","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"5e9adc5cfe2892c101ce9d9a385a3e8de601924b116454da7bee1c08f4324cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxx/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxx/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":46,"content":[{"type":"hebrew_subtitle","content":["(47) For the end, a Psalm for the sons of Core."]},{"type":"verse","number":1,"content":[{"text":"Clap your hands, all you⌃ nations; shout to God with a voice of exultation.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For the Lord most high is terrible; he is a great king over all the earth.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He has subdued the peoples under us, and the nations under our feet.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He has chosen out his inheritance for us, the beauty of Jacob which he loved. Pause.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"God is gone up with a shout, the Lord with a sound of a trumpet.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sing praises to our God, sing praises: sing praises to our King, sing praises.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For God is king of all the earth: sing praises with understanding.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"God reigns over the nations: God sits upon the throne of his holiness.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The rulers of the people are assembled with the God of Abraam: for God's mighty ones of the earth have been greatly exalted.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_lxx/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxx/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxx/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":9}