{"translation":{"id":"eng_lxx","name":"LXX2012: Septuagint in American English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseNotes":null,"shortName":"LXXSA","englishName":"LXX2012 U. S. English","language":"eng","textDirection":"ltr","sha256":"40ba1b77d2cf7ff98078a33c5ab0df1a5343c20510f684d8e8eedea7e8b1295c","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxx/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxx","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"5e9adc5cfe2892c101ce9d9a385a3e8de601924b116454da7bee1c08f4324cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxx/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxx/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":62,"content":[{"type":"hebrew_subtitle","content":["(63) A Psalm of David, when he was in the wilderness of Idumea."]},{"type":"verse","number":1,"content":[{"text":"O God, my God, I cry to you early; my soul has thirsted for you: how often has my flesh longed after you, in a barren and trackless and dry land!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Thus have I appeared before you in the sanctuary, that I might see your power and your glory.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For your mercy is better than","poem":1},{"noteId":112},{"text":"life: my lips shall praise you.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Thus will I bless you during my life: I will lift up my hands in your name.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Let my soul be filled as with marrow and fatness; and my joyful lips shall praise your name.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"noteId":113},{"text":"Forasmuch as I have remembered you on my bed: in the early seasons I have meditated on you.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For you have been my helper, and in the shelter of your wings will I rejoice.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"My soul has","poem":1},{"noteId":114},{"text":"kept very close behind you: your right hand has upheld me.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"But they vainly sought after my soul; they shall go into the lowest parts o the earth.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"They shall be delivered up to the power of the sword; they shall be portions for foxes.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"But the king shall rejoice in God; every one that swears by him shall be praised; for the mouth of them that speak unjust things has been stopped.","poem":1}]}],"footnotes":[{"noteId":112,"caller":"+","text":"Gr. lives.","reference":{"chapter":62,"verse":3}},{"noteId":113,"caller":"+","text":"Gr. if. See Acts 26:23","reference":{"chapter":62,"verse":6}},{"noteId":114,"caller":"+","text":"Gr. been glued.","reference":{"chapter":62,"verse":8}}]},"thisChapterLink":"/api/eng_lxx/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxx/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxx/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":11}