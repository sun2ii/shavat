dy; O God, help me: you are my helper and deliverer, O Lord, delay not.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_lxx/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxx/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxx/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":5}