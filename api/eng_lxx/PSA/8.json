{"translation":{"id":"eng_lxx","name":"LXX2012: Septuagint in American English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseNotes":null,"shortName":"LXXSA","englishName":"LXX2012 U. S. English","language":"eng","textDirection":"ltr","sha256":"40ba1b77d2cf7ff98078a33c5ab0df1a5343c20510f684d8e8eedea7e8b1295c","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxx/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxx","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"5e9adc5cfe2892c101ce9d9a385a3e8de601924b116454da7bee1c08f4324cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxx/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxx/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":8,"content":[{"type":"hebrew_subtitle","content":["For the end, concerning the wine presses, a Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"O Lord, our Lord, how wonderful is your name in all the earth! for your magnificence is exalted above the heavens.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Out of the mouth of babes and sucklings have you perfected praise, because of your enemies; that you might put down the enemy and avenger.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For I will regard the heavens, the work of your fingers; the moon and stars, which you have established.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"What is man, that you are mindful of him? or the son of man, that you visit him?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"You made him a little less than angels, you have crowned him with glory and honor;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"and you have set him over the works of your hands: you have put all things under his feet:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"sheep and all","poem":1},{"noteId":15},{"text":"oxen, yes and the cattle of the field;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"the birds of the sky, and the fish of the sea, the creatures passing through the paths of the sea.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O Lord our Lord, how wonderful is your name in all the earth!","poem":1}]}],"footnotes":[{"noteId":15,"caller":"+","text":"Gr. cows.","reference":{"chapter":8,"verse":7}}]},"thisChapterLink":"/api/eng_lxx/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxx/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxx/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}