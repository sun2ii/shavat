{"translation":{"id":"eng_lxx","name":"LXX2012: Septuagint in American English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseNotes":null,"shortName":"LXXSA","englishName":"LXX2012 U. S. English","language":"eng","textDirection":"ltr","sha256":"40ba1b77d2cf7ff98078a33c5ab0df1a5343c20510f684d8e8eedea7e8b1295c","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxx/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxx","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"5e9adc5cfe2892c101ce9d9a385a3e8de601924b116454da7bee1c08f4324cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxx/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxx/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":81,"content":[{"type":"hebrew_subtitle","content":["(82) A Psalm for Asaph."]},{"type":"verse","number":1,"content":[{"text":"God stands in the assembly of gods; and in the midst of them will judge gods.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"How long will you⌃ judge unrighteously, and accept the persons of sinners? Pause.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Judge the orphan and poor:","poem":1},{"noteId":154},{"text":"do justice to the low and needy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rescue the needy, and deliver the poor out of the hand of the sinner.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"They know not, nor understand; they walk on in darkness: all the foundations of the earth shall be shaken.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I have said, You⌃ are gods; and all of you children of the Most High.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"But you⌃ die as men, and fall as one of the princes.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Arise, O God, judge the earth: for you shall inherit all nations.","poem":1}]}],"footnotes":[{"noteId":154,"caller":"+","text":"Gr. justify.","reference":{"chapter":81,"verse":3}}]},"thisChapterLink":"/api/eng_lxx/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxx/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxx/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":8}