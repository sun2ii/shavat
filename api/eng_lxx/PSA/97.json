{"translation":{"id":"eng_lxx","name":"LXX2012: Septuagint in American English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseNotes":null,"shortName":"LXXSA","englishName":"LXX2012 U. S. English","language":"eng","textDirection":"ltr","sha256":"40ba1b77d2cf7ff98078a33c5ab0df1a5343c20510f684d8e8eedea7e8b1295c","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxx/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxx","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"5e9adc5cfe2892c101ce9d9a385a3e8de601924b116454da7bee1c08f4324cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxx/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxx/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":97,"content":[{"type":"hebrew_subtitle","content":["(98) A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Sing to the Lord a new song; for the Lord has wrought wonderful works, his right hand, and his holy arm, have wrought salvation for him.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The Lord has made known his salvation, he has revealed his righteousness in the sight of the nations.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He has remembered his mercy to Jacob, and his truth to the house of Israel; all the ends of the earth have seen the salvation of our God.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Shout to God, all the earth; sing, and exult, and sing psalms.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sing to the Lord with a harp, with a harp, and the voice of a psalm.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"With trumpets of metal, and the sound of a trumpet of horn make a joyful noise to the Lord before the king.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Let the sea be moved, and the fullness of it; the world, and they that dwell in it.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The rivers shall clap their hands together; the mountains shall exult.","poem":1},{"noteId":189}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"For he is come to judge the earth; he shall judge the world in righteousness, and the nations in uprightness.","poem":1}]}],"footnotes":[{"noteId":189,"caller":"+","text":"Alex. + before the Lord, for he comes.","reference":{"chapter":97,"verse":8}}]},"thisChapterLink":"/api/eng_lxx/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxx/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxx/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":9}