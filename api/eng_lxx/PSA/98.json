{"translation":{"id":"eng_lxx","name":"LXX2012: Septuagint in American English 2012","website":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-lxx2012","licenseNotes":null,"shortName":"LXXSA","englishName":"LXX2012 U. S. English","language":"eng","textDirection":"ltr","sha256":"40ba1b77d2cf7ff98078a33c5ab0df1a5343c20510f684d8e8eedea7e8b1295c","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_lxx/books.json","numberOfBooks":39,"totalNumberOfChapters":930,"totalNumberOfVerses":22876,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":175,"totalNumberOfApocryphalVerses":5449},"book":{"id":"PSA","translationId":"eng_lxx","name":"Psalms","commonName":"Psalms","title":"PSALMS","order":19,"numberOfChapters":151,"sha256":"5e9adc5cfe2892c101ce9d9a385a3e8de601924b116454da7bee1c08f4324cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_lxx/PSA/1.json","lastChapterNumber":151,"lastChapterApiLink":"/api/eng_lxx/PSA/151.json","totalNumberOfVerses":2467},"chapter":{"number":98,"content":[{"type":"hebrew_subtitle","content":["(99) A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"The Lord reigns; —let the people rage; it is he that sits upon the cherubs, let the earth be moved.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The Lord is great in Sion, and is high over all the people.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let them give thanks to your great name; for it is terrible and holy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"And the king's honor loves judgment; you have prepared","poem":1},{"noteId":190},{"text":"equity, you have wrought judgment and justice in Jacob.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Exalt you⌃ the Lord our God, and worship at his footstool; for he is holy.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Moses and Aaron among his priests, and Samuel among them that call upon his name; they called upon the Lord, and he heard them.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He spoke to them in a pillar of cloud; they kept his testimonies, and the ordinances which he gave them.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O Lord our God, you heard them; O God, you became propitious to them, though you did take vengeance on all their devices.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Exalt you⌃ the Lord our God, and worship at his holy mountain; for the Lord our God is holy.","poem":1}]}],"footnotes":[{"noteId":190,"caller":"+","text":"Gr. equities.","reference":{"chapter":98,"verse":4}}]},"thisChapterLink":"/api/eng_lxx/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_lxx/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_lxx/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}