{"translation":{"id":"eng_nna","name":"Nyangumarta English Bible","website":"https://ebible.org/Scriptures/details.php?id=engnna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnna","licenseNotes":null,"shortName":"NEB","englishName":"Nyangumarta English Bible","language":"eng","textDirection":"ltr","sha256":"403b9b26abb7cc040cd7f74e9db19337dd53943e48b6da5ec4124ad427bb2095","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_nna/books.json","numberOfBooks":26,"totalNumberOfChapters":105,"totalNumberOfVerses":1378,"languageName":"English","languageEnglishName":"English"},"book":{"id":"ISA","translationId":"eng_nna","name":"Isaiah","commonName":"Isaiah","title":"Isaiah","order":23,"numberOfChapters":3,"sha256":"d9cb92bc2ad0368b8dd258b4df48642f594244f6e182613ef0acac8247a8d6e5","firstChapterNumber":5,"firstChapterApiLink":"/api/eng_nna/ISA/5.json","lastChapterNumber":53,"lastChapterApiLink":"/api/eng_nna/ISA/53.json","totalNumberOfVerses":3},"chapter":{"number":53,"content":[{"type":"verse","number":5,"content":[{"text":"We are healed by the punishment he suffered, made whole by the blows he received.","poem":1},{"lineBreak":true},{"text":"All of us were like sheep that were lost, each of us going his own way.","poem":1},{"lineBreak":true},{"text":"But the Lord made the punishment fall on him, the punishment all of us deserved.","poem":1},{"lineBreak":true},{"text":"For our wrongdoing God hit him. God whipped him, as a result of that he healed us. We all self-centredly did whatever we wanted to do. He did not hit us, he hit him for our badness.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_nna/ISA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_nna/JER/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_nna/ISA/38.json","previousChapterAudioLinks":{},"numberOfVerses":1}