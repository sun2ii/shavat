{"translation":{"id":"eng_nna","name":"Nyangumarta English Bible","website":"https://ebible.org/Scriptures/details.php?id=engnna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnna","licenseNotes":null,"shortName":"NEB","englishName":"Nyangumarta English Bible","language":"eng","textDirection":"ltr","sha256":"403b9b26abb7cc040cd7f74e9db19337dd53943e48b6da5ec4124ad427bb2095","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_nna/books.json","numberOfBooks":26,"totalNumberOfChapters":105,"totalNumberOfVerses":1378,"languageName":"English","languageEnglishName":"English"},"book":{"id":"MAT","translationId":"eng_nna","name":"Matthew","commonName":"Matthew","title":"Matthew","order":40,"numberOfChapters":6,"sha256":"fe120aa985aa4f82f3b46b4bedded4a5da92f70686037e5dd6018b854381a3f0","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_nna/MAT/1.json","lastChapterNumber":19,"lastChapterApiLink":"/api/eng_nna/MAT/19.json","totalNumberOfVerses":34},"chapter":{"number":10,"content":[{"type":"verse","number":26,"content":["People might kill your body.",{"text":"Don't be afraid of them. They can't kill your spirit.","poem":1},{"lineBreak":true},{"text":"Fear only God. He can burn your spirit and body to ashes in the big fire.","poem":1},{"lineBreak":true},{"text":"People cannot do that.","poem":1},{"lineBreak":true},{"text":"Because of that do not be afraid of them.","poem":1},{"lineBreak":true},{"text":"Your Father above knows of everything.","poem":1},{"lineBreak":true},{"text":"He knows when a zebra finch falls to the ground.","poem":1},{"lineBreak":true},{"text":"Truly he knows of you also.","poem":1},{"lineBreak":true},{"text":"He knows the hair on your head.","poem":1},{"lineBreak":true},{"text":"One by one, all of it.","poem":1},{"lineBreak":true},{"text":"Because of that, stay without fear.","poem":1},{"lineBreak":true},{"text":"God just thinks a bit about the zebra finch, he really thinks about you always.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_nna/MAT/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_nna/MAT/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_nna/MAT/7.json","previousChapterAudioLinks":{},"numberOfVerses":1}