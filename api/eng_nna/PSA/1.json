{"translation":{"id":"eng_nna","name":"Nyangumarta English Bible","website":"https://ebible.org/Scriptures/details.php?id=engnna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnna","licenseNotes":null,"shortName":"NEB","englishName":"Nyangumarta English Bible","language":"eng","textDirection":"ltr","sha256":"403b9b26abb7cc040cd7f74e9db19337dd53943e48b6da5ec4124ad427bb2095","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_nna/books.json","numberOfBooks":26,"totalNumberOfChapters":105,"totalNumberOfVerses":1378,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_nna","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":4,"sha256":"79b6755133b9c79922373d40e6e77bdb83d41acb8096595b92c60726fe23f8bc","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_nna/PSA/1.json","lastChapterNumber":32,"lastChapterApiLink":"/api/eng_nna/PSA/32.json","totalNumberOfVerses":18},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Happy are those people who won't listen to the words of bad people,","poem":1},{"lineBreak":true},{"text":"they don't want to do like the bad people do and","poem":1},{"lineBreak":true},{"text":"they don't join the ones who are rude to God.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"They are really happy when they think about God's word, and they always pay attention to it.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"You all know about a tree near a pool,","poem":1},{"lineBreak":true},{"text":"it is always good,","poem":1},{"lineBreak":true},{"text":"it has good fruit and","poem":1},{"lineBreak":true},{"text":"its leaves don't dry up.","poem":1},{"lineBreak":true},{"text":"Good people are like that tree.","poem":1},{"lineBreak":true},{"text":"They do things the right way, it comes out well for them.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"The bad people are not at all like this;","poem":1},{"lineBreak":true},{"text":"they are like what's-its-called, like the rubbish after yandying, the wind blows it away.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"God will hit them hard.","poem":1},{"lineBreak":true},{"text":"He will separate them out,","poem":1},{"lineBreak":true},{"text":"they won't stay with his mob.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"God looks after his mob on the right road.","poem":1},{"lineBreak":true},{"text":"It is very different for bad people,","poem":1},{"lineBreak":true},{"text":"they are going to a really bad place.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_nna/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_nna/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_nna/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}