{"translation":{"id":"eng_our","name":"One Unity Resource Bible","website":"https://ebible.org/Scriptures/details.php?id=engourb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engourb","licenseNotes":null,"shortName":"OURB","englishName":"One Unity Resource Bible","language":"eng","textDirection":"ltr","sha256":"6bf2cd2e369522839f22e9d406ca14d86cf48df19d603bd08520d8810a06172d","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_our/books.json","numberOfBooks":12,"totalNumberOfChapters":523,"totalNumberOfVerses":14299,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":2,"totalNumberOfApocryphalChapters":17,"totalNumberOfApocryphalVerses":931},"book":{"id":"PS2","translationId":"eng_our","name":"Psalms 151","commonName":"Psalms 151","title":"Psalms [Praises] 151","order":84,"numberOfChapters":1,"isApocryphal":true,"sha256":"3846f93d8de5055af94ae94841f8d125d497cda5b30eeebd742ce74cdb875ff9","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_our/PS2/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/eng_our/PS2/1.json","totalNumberOfVerses":7},"chapter":{"number":1,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"I was small among my brothers,","poem":1},{"text":"and youngest in my father’s house.","poem":2},{"lineBreak":true},{"text":"I tended my father’s sheep.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"My hands formed a musical instrument,","poem":1},{"text":"and my fingers tuned a lute.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Who shall tell adonai ·my Lord·?","poem":1},{"text":"Adonai himself, he himself hears.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"He sent forth his angel and took me from my father’s sheep,","poem":1},{"text":"and he anointed me with his anointing oil.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"My brothers were handsome and tall;","poem":1},{"text":"but Adonai did not take pleasure in them.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I went out to meet the Philistine [To roll in dust (As an insult)],","poem":1},{"text":"and he cursed me by his idols.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"But I drew his own sword and beheaded him,","poem":1},{"text":"and removed reproach from the children of Israel [God prevails].","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/eng_our/PS2/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":null,"nextChapterAudioLinks":null,"previousChapterApiLink":"/api/eng_our/1MA/16.json","previousChapterAudioLinks":{},"numberOfVerses":7}