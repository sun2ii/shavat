{"translation":{"id":"eng_our","name":"One Unity Resource Bible","website":"https://ebible.org/Scriptures/details.php?id=engourb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engourb","licenseNotes":null,"shortName":"OURB","englishName":"One Unity Resource Bible","language":"eng","textDirection":"ltr","sha256":"6bf2cd2e369522839f22e9d406ca14d86cf48df19d603bd08520d8810a06172d","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_our/books.json","numberOfBooks":12,"totalNumberOfChapters":523,"totalNumberOfVerses":14299,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":2,"totalNumberOfApocryphalChapters":17,"totalNumberOfApocryphalVerses":931},"book":{"id":"PSA","translationId":"eng_our","name":"Psalms","commonName":"Psalms","title":"Psalms [Praises] Tehillim [Praises]","order":19,"numberOfChapters":150,"sha256":"ead923bab097a34c318bcd9ed977092362883005d539d0ed07548b5031b4f65c","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_our/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_our/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Halleluyah ·praise Yah·!","poem":1},{"text":"א Blessed is the man who fears Adonai,","poem":2},{"lineBreak":true},{"text":"בּ who delights greatly in his mitzvot ·instructions·.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"גּ His offspring will be mighty in the land.","poem":1},{"text":"דּ The generation of the upright will be blessed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ה Wealth and riches are in his house.","poem":1},{"text":"ו His righteousness endures forever.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ז Light dawns in the darkness for the upright,","poem":1},{"text":"ח gracious, merciful, and righteous.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ט It is well with the man who is merciful and lends.","poem":1},{"text":"י He will maintain his cause in judgment.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"כּ For he will never be shaken.","poem":1},{"text":"ל The upright will be remembered forever.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"מ He will not be afraid of evil news.","poem":1},{"text":"נ His heart is steadfast, trusting in Adonai.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ס His heart is established.","poem":1},{"text":"ע He will not be afraid in the end when he sees his adversaries.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"פּ He has dispersed, he has given to the poor.","poem":1},{"text":"צ His righteousness endures forever.","poem":2},{"noteId":233},{"lineBreak":true},{"text":"ק His horn will be exalted with kavod ·weighty glory·.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ר The wicked will see it, and be grieved.","poem":1},{"text":"שׁ He shall gnash with his teeth, and melt away.","poem":2},{"lineBreak":true},{"text":"תּ The desire of the wicked will perish.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":233,"caller":"+","text":". Quoted in  2 Cor 9:9","reference":{"chapter":112,"verse":9}}]},"thisChapterLink":"/api/eng_our/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_our/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_our/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}