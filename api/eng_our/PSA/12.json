{"translation":{"id":"eng_our","name":"One Unity Resource Bible","website":"https://ebible.org/Scriptures/details.php?id=engourb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engourb","licenseNotes":null,"shortName":"OURB","englishName":"One Unity Resource Bible","language":"eng","textDirection":"ltr","sha256":"6bf2cd2e369522839f22e9d406ca14d86cf48df19d603bd08520d8810a06172d","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_our/books.json","numberOfBooks":12,"totalNumberOfChapters":523,"totalNumberOfVerses":14299,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":2,"totalNumberOfApocryphalChapters":17,"totalNumberOfApocryphalVerses":931},"book":{"id":"PSA","translationId":"eng_our","name":"Psalms","commonName":"Psalms","title":"Psalms [Praises] Tehillim [Praises]","order":19,"numberOfChapters":150,"sha256":"ead923bab097a34c318bcd9ed977092362883005d539d0ed07548b5031b4f65c","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_our/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_our/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Help, Adonai; for the godly man ceases.","poem":1},{"text":"For the faithful fail from among the children of men.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Everyone lies to his neighbor.","poem":1},{"text":"They speak with flattering lips, and with a double heart.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"May Adonai cut off all flattering lips,","poem":1},{"text":"and the tongue that boasts,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"who have said, “With our tongue we will prevail.","poem":1},{"text":"Our lips are our own.","poem":2},{"lineBreak":true},{"text":"Who is lord over us?”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Because of the oppression of the weak and because of the groaning of the needy,","poem":1},{"text":"I will now arise,” says Adonai;","poem":2},{"text":"“I will set him in yesha' ·salvation· far from those who malign him.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Adonai’s words are flawless words,","poem":1},{"text":"as silver refined in a clay furnace, purified seven times.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"You will keep them, Adonai.","poem":1},{"text":"You will preserve them from this generation forever.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"The wicked walk on every side,","poem":1},{"text":"when what is vile is exalted among the sons of men.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/eng_our/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_our/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_our/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}