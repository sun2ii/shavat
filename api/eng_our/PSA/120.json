:"with him who hates peace.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I am for peace,","poem":1},{"text":"but when I speak, they are for war.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/eng_our/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_our/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_our/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}