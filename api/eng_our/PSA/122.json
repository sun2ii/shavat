oem":2}]},{"type":"verse","number":6,"content":[{"text":"Pray for the peace of Jerusalem [City of peace].","poem":1},{"text":"Those who 'ahav ·affectionately love· you will prosper.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Peace be within your walls,","poem":1},{"text":"and prosperity within your palaces.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"For my brothers’ and companions’ sakes,","poem":1},{"text":"I will now say, “Peace be within you.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"For the sake of the house of Yahweh Eloheikhem [Yahweh our God],","poem":1},{"text":"I will seek your good.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/eng_our/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_our/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_our/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}