{"translation":{"id":"eng_our","name":"One Unity Resource Bible","website":"https://ebible.org/Scriptures/details.php?id=engourb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engourb","licenseNotes":null,"shortName":"OURB","englishName":"One Unity Resource Bible","language":"eng","textDirection":"ltr","sha256":"6bf2cd2e369522839f22e9d406ca14d86cf48df19d603bd08520d8810a06172d","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_our/books.json","numberOfBooks":12,"totalNumberOfChapters":523,"totalNumberOfVerses":14299,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":2,"totalNumberOfApocryphalChapters":17,"totalNumberOfApocryphalVerses":931},"book":{"id":"PSA","translationId":"eng_our","name":"Psalms","commonName":"Psalms","title":"Psalms [Praises] Tehillim [Praises]","order":19,"numberOfChapters":150,"sha256":"ead923bab097a34c318bcd9ed977092362883005d539d0ed07548b5031b4f65c","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_our/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_our/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Unless Adonai builds the house,","poem":1},{"text":"they labor in vain who build it.","poem":2},{"text":"Unless Adonai watches over the city,","poem":1},{"text":"the watchman guards it in vain.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"It is vain for you to rise up early,","poem":1},{"text":"to stay up late,","poem":2},{"lineBreak":true},{"text":"eating the bread of toil;","poem":2},{"lineBreak":true},{"text":"for he gives sleep to his yadid ·beloved· ones.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Behold, children are a heritage of Adonai.","poem":1},{"text":"The fruit of the womb is his reward.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"As arrows in the hand of a mighty man,","poem":1},{"text":"so are the children of youth.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Happy is the man who has his quiver full of them.","poem":1},{"text":"They won’t be disappointed when they speak with their enemies in the gate.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/eng_our/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_our/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_our/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}