{"translation":{"id":"eng_our","name":"One Unity Resource Bible","website":"https://ebible.org/Scriptures/details.php?id=engourb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engourb","licenseNotes":null,"shortName":"OURB","englishName":"One Unity Resource Bible","language":"eng","textDirection":"ltr","sha256":"6bf2cd2e369522839f22e9d406ca14d86cf48df19d603bd08520d8810a06172d","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_our/books.json","numberOfBooks":12,"totalNumberOfChapters":523,"totalNumberOfVerses":14299,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":2,"totalNumberOfApocryphalChapters":17,"totalNumberOfApocryphalVerses":931},"book":{"id":"PSA","translationId":"eng_our","name":"Psalms","commonName":"Psalms","title":"Psalms [Praises] Tehillim [Praises]","order":19,"numberOfChapters":150,"sha256":"ead923bab097a34c318bcd9ed977092362883005d539d0ed07548b5031b4f65c","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_our/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_our/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"By the rivers of Babylon [Confusion], there we sat down.","poem":1},{"text":"Yes, we wept, when we remembered Zion [Mountain ridge, Marking].","poem":2}]},{"type":"verse","number":2,"content":[{"text":"On the willows in that land,","poem":1},{"text":"we hung up our harps.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"For there, those who led us captive asked us for songs.","poem":1},{"text":"Those who tormented us demanded songs of joy:","poem":2},{"lineBreak":true},{"text":"“Sing us one of the songs of Zion [Mountain ridge, Marking]!”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"How can we sing Adonai’s song in a foreign land?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"If I forget you, Jerusalem [City of peace],","poem":1},{"text":"let my right hand forget its skill.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Let my tongue stick to the roof of my mouth if I don’t remember you;","poem":1},{"text":"if I don’t prefer Jerusalem [City of peace] above my chief joy.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Remember, Adonai, against the children of Edom [Red],","poem":1},{"text":"the day of Jerusalem [City of peace];","poem":2},{"lineBreak":true},{"text":"who said, “Raze it!","poem":2},{"lineBreak":true},{"text":"Raze it even to its foundation!”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Daughter of Babylon [Confusion], doomed to destruction,","poem":1},{"text":"he will be happy who rewards you,","poem":2},{"lineBreak":true},{"text":"as you have served us.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Happy shall he be,","poem":1},{"text":"who takes and dashes your little ones against the rock.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/eng_our/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_our/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_our/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}