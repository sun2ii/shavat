{"translation":{"id":"eng_our","name":"One Unity Resource Bible","website":"https://ebible.org/Scriptures/details.php?id=engourb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engourb","licenseNotes":null,"shortName":"OURB","englishName":"One Unity Resource Bible","language":"eng","textDirection":"ltr","sha256":"6bf2cd2e369522839f22e9d406ca14d86cf48df19d603bd08520d8810a06172d","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_our/books.json","numberOfBooks":12,"totalNumberOfChapters":523,"totalNumberOfVerses":14299,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":2,"totalNumberOfApocryphalChapters":17,"totalNumberOfApocryphalVerses":931},"book":{"id":"PSA","translationId":"eng_our","name":"Psalms","commonName":"Psalms","title":"Psalms [Praises] Tehillim [Praises]","order":19,"numberOfChapters":150,"sha256":"ead923bab097a34c318bcd9ed977092362883005d539d0ed07548b5031b4f65c","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_our/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_our/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Ascribe to Adonai, you sons of the mighty,","poem":1},{"text":"ascribe to Adonai kavod ·weighty glory· and strength.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ascribe to Adonai the kavod ·weighty glory· due to his name.","poem":1},{"text":"Hawa ·Bow low, prostrate· to worship Adonai in holy array.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Adonai’s voice is on the waters.","poem":1},{"text":"The God of kavod ·weighty glory· thunders, even Adonai on many waters.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Adonai’s voice is powerful.","poem":1},{"text":"Adonai’s voice is full of majesty.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Adonai’s voice breaks the cedars.","poem":1},{"text":"Yes, Adonai breaks in pieces the cedars of Lebanon.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"He makes them also to skip like a calf;","poem":1},{"text":"Lebanon and Sirion like a young, wild ox.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Adonai’s voice strikes with flashes of lightning.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Adonai’s voice shakes the wilderness.","poem":2},{"lineBreak":true},{"text":"Adonai shakes the wilderness of Kadesh.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Adonai’s voice makes the deer calve,","poem":1},{"text":"and strips the forests bare.","poem":2},{"lineBreak":true},{"text":"In his temple everything says, “Kavod ·Weighty glory·!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Adonai sat enthroned at the Flood.","poem":1},{"noteId":77},{"text":"Yes, Adonai sits as King forever.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Adonai will give strength to his people.","poem":1},{"text":"Adonai will bless his people with peace.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":77,"caller":"+","text":"Note: “Enthroned at the Flood” references back to Genesis 1.","reference":{"chapter":29,"verse":10}}]},"thisChapterLink":"/api/eng_our/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_our/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_our/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}