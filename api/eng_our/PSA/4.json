{"translation":{"id":"eng_our","name":"One Unity Resource Bible","website":"https://ebible.org/Scriptures/details.php?id=engourb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engourb","licenseNotes":null,"shortName":"OURB","englishName":"One Unity Resource Bible","language":"eng","textDirection":"ltr","sha256":"6bf2cd2e369522839f22e9d406ca14d86cf48df19d603bd08520d8810a06172d","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_our/books.json","numberOfBooks":12,"totalNumberOfChapters":523,"totalNumberOfVerses":14299,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":2,"totalNumberOfApocryphalChapters":17,"totalNumberOfApocryphalVerses":931},"book":{"id":"PSA","translationId":"eng_our","name":"Psalms","commonName":"Psalms","title":"Psalms [Praises] Tehillim [Praises]","order":19,"numberOfChapters":150,"sha256":"ead923bab097a34c318bcd9ed977092362883005d539d0ed07548b5031b4f65c","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_our/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_our/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Answer me when I call, God of my righteousness.","poem":1},{"text":"Give me relief from my distress.","poem":2},{"lineBreak":true},{"text":"Have mercy on me, and sh'ma ·hear obey· my prayer.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"You sons of men, how long shall my kavod ·weighty glory· be turned into dishonor?","poem":1},{"text":"Will you 'ahav ·affectionately love· vanity, and seek after falsehood? Selah ·contemplation with musical interlude·","poem":2}]},{"type":"verse","number":3,"content":[{"text":"But know that Adonai has set apart for himself him who is godly:","poem":1},{"text":"Adonai will sh'ma ·hear obey· when I call to him.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"You can be angry, but don’t sin ·err (from the standard goal)·.","poem":1},{"noteId":20},{"text":"Search your own heart on your bed, and be still. Selah ·contemplation with musical interlude·","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Offer the sacrifices of righteousness.","poem":1},{"text":"Put your trust in Adonai.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Many say, “Who will show us any good?”","poem":1},{"text":"Adonai, let the light of your face shine on us.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"You have put gladness in my heart,","poem":1},{"text":"more than when their grain and their new wine are increased.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"In peace I will both lay myself down and sleep,","poem":1},{"text":"for you, Adonai alone, make me live in safety.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":20,"caller":"+","text":". Quoted in  Eph 4:26","reference":{"chapter":4,"verse":4}}]},"thisChapterLink":"/api/eng_our/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_our/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_our/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}