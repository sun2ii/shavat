{"translation":{"id":"eng_our","name":"One Unity Resource Bible","website":"https://ebible.org/Scriptures/details.php?id=engourb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engourb","licenseNotes":null,"shortName":"OURB","englishName":"One Unity Resource Bible","language":"eng","textDirection":"ltr","sha256":"6bf2cd2e369522839f22e9d406ca14d86cf48df19d603bd08520d8810a06172d","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_our/books.json","numberOfBooks":12,"totalNumberOfChapters":523,"totalNumberOfVerses":14299,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":2,"totalNumberOfApocryphalChapters":17,"totalNumberOfApocryphalVerses":931},"book":{"id":"PSA","translationId":"eng_our","name":"Psalms","commonName":"Psalms","title":"Psalms [Praises] Tehillim [Praises]","order":19,"numberOfChapters":150,"sha256":"ead923bab097a34c318bcd9ed977092362883005d539d0ed07548b5031b4f65c","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_our/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_our/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Adonai, our Lord, how majestic is your name in all the earth,","poem":1},{"text":"who has set your glory above the heavens!","poem":2}]},{"type":"verse","number":2,"content":[{"noteId":23},{"text":"From the lips of babes and infants you have","wordsOfJesus":true,"poem":1},{"noteId":24},{"text":"established strength,","wordsOfJesus":true,"poem":1},{"text":"because of your adversaries, that you might silence the enemy and the avenger.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"When I consider your heavens, the work of your fingers,","poem":1},{"text":"the moon and the stars, which you have ordained;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"what is man, that you think of him?","poem":1},{"text":"What is the son of man, that you care for him?","poem":2}]},{"type":"verse","number":5,"content":[{"noteId":25},{"text":"For you have made him a little lower than the angels,","wordsOfJesus":true,"poem":1},{"noteId":26},{"text":"and crowned him with glory and honor.","wordsOfJesus":true,"poem":2}]},{"type":"verse","number":6,"content":[{"text":"You make him ruler over the works of your hands.","wordsOfJesus":true,"poem":1},{"text":"You have put all things under his feet:","wordsOfJesus":true,"poem":2},{"noteId":27},{"noteId":28}]},{"type":"verse","number":7,"content":[{"text":"All sheep and cattle,","poem":1},{"text":"yes, and the animals of the field,","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The birds of the sky, the fish of the sea,","poem":2},{"lineBreak":true},{"text":"and whatever passes through the paths of the seas.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Adonai, our Lord,","poem":1},{"text":"how majestic is your name in all the earth!","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":23,"caller":"+","text":"a MP:  Infants give strength / praise to Messiah. (Matt 21:15-16)","reference":{"chapter":8,"verse":2}},{"noteId":24,"caller":"+","text":". Quoted in  Matt 21:15-16","reference":{"chapter":8,"verse":2}},{"noteId":25,"caller":"+","text":"(5-6) MP:  His humiliation and exaltation is foretold. (Acts 2:23-24, 3:17-18; 1 Cor 15:20-27; Phil 2:7-9)","reference":{"chapter":8,"verse":5}},{"noteId":26,"caller":"+","text":"(5b-6) MP:  Messiah is given authority over all things. (Matt 28:18; 1 Cor 15:27; Heb 2:8-9)","reference":{"chapter":8,"verse":5}},{"noteId":27,"caller":"+","text":". Quoted in  1 Cor 15:27; Eph 1:22","reference":{"chapter":8,"verse":6}},{"noteId":28,"caller":"+","text":". (4-6) Quoted in  Heb 2:6-9","reference":{"chapter":8,"verse":6}}]},"thisChapterLink":"/api/eng_our/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_our/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_our/PSA/7.js