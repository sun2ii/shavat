{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tremble, thou earth, at the presence of the Lord, at the presence of the God of Jacob;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Which turned the rock into a pool of water, the flint into a fountain of waters.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_rv5/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_rv5/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_rv5/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}