ad her dwelling with him that hateth peace.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I am for peace: but when I speak, they are for war.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_rv5/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_rv5/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_rv5/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}