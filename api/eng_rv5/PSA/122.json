{"translation":{"id":"eng_rv5","name":"Revised Version with Apocrypha (1895)","website":"https://ebible.org/Scriptures/details.php?id=eng-rv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-rv","licenseNotes":null,"shortName":"RVA","englishName":"Revised Version","language":"eng","textDirection":"ltr","sha256":"6ce9e41d31d6d7e6e6b875afc9b500cb7d768d458b56dd046bdd10b996777398","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_rv5/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5776},"book":{"id":"PSA","translationId":"eng_rv5","name":"Psalms","commonName":"Psalms","title":"THE PSALMS.","order":19,"numberOfChapters":150,"sha256":"09310f2beb5799d2d93766f76ca6670412489f79b48f952d45bb606e336bd790","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_rv5/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_rv5/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["A Song of Ascents; of David."]},{"type":"verse","number":1,"content":[{"text":"I was glad when they said unto me, Let us go unto the house of the LORD.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Our feet are standing within thy gates, O Jerusalem;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jerusalem, that art builded as a city that is compact together:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Whither the tribes go up, even the tribes of the LORD for a testimony unto Israel, to give thanks into the name of the LORD.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For there are set thrones for judgment, the thrones of the house of David.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pray for the peace of Jerusalem: they shall prosper that love thee.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Peace be within thy walls, and prosperity within thy palaces.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For my brethren and companions’ sakes, I will now say, Peace be within thee.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"For the sake of the house of the LORD our God I will seek thy good.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_rv5/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_rv5/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_rv5/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}