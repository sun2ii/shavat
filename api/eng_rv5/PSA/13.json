{"translation":{"id":"eng_rv5","name":"Revised Version with Apocrypha (1895)","website":"https://ebible.org/Scriptures/details.php?id=eng-rv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-rv","licenseNotes":null,"shortName":"RVA","englishName":"Revised Version","language":"eng","textDirection":"ltr","sha256":"6ce9e41d31d6d7e6e6b875afc9b500cb7d768d458b56dd046bdd10b996777398","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_rv5/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5776},"book":{"id":"PSA","translationId":"eng_rv5","name":"Psalms","commonName":"Psalms","title":"THE PSALMS.","order":19,"numberOfChapters":150,"sha256":"09310f2beb5799d2d93766f76ca6670412489f79b48f952d45bb606e336bd790","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_rv5/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_rv5/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician. A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"How long, O LORD, wilt thou forget me for ever? how long wilt thou hide thy face from me?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"How long shall I take counsel in my soul, having sorrow in my heart all the day? how long shall mine enemy be exalted over me?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Consider and answer me, O LORD my God: lighten mine eyes, lest I sleep the sleep of death;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lest mine enemy say, I have prevailed against him; lest mine adversaries rejoice when I am moved.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"But I have trusted in thy mercy; my heart shall rejoice in thy salvation:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I will sing unto the LORD, because he hath dealt bountifully with me.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_rv5/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_rv5/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_rv5/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}