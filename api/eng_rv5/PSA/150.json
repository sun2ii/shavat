{"translation":{"id":"eng_rv5","name":"Revised Version with Apocrypha (1895)","website":"https://ebible.org/Scriptures/details.php?id=eng-rv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-rv","licenseNotes":null,"shortName":"RVA","englishName":"Revised Version","language":"eng","textDirection":"ltr","sha256":"6ce9e41d31d6d7e6e6b875afc9b500cb7d768d458b56dd046bdd10b996777398","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_rv5/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5776},"book":{"id":"PSA","translationId":"eng_rv5","name":"Psalms","commonName":"Psalms","title":"THE PSALMS.","order":19,"numberOfChapters":150,"sha256":"09310f2beb5799d2d93766f76ca6670412489f79b48f952d45bb606e336bd790","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_rv5/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_rv5/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":150,"content":[{"type":"verse","number":1,"content":[{"text":"Praise ye the LORD. Praise God in his sanctuary: praise him in the firmament of his power.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Praise him for his mighty acts: praise him according to his excellent greatness.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Praise him with the sound of the trumpet: praise him with the psaltery and harp.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Praise him with the timbrel and dance: praise him with stringed instruments and the pipe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Praise him upon the loud cymbals: praise him upon the high sounding cymbals.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Let every thing that hath breath praise the LORD. Praise ye the LORD.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_rv5/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_rv5/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_rv5/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}