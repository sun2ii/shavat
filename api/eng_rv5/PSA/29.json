{"translation":{"id":"eng_rv5","name":"Revised Version with Apocrypha (1895)","website":"https://ebible.org/Scriptures/details.php?id=eng-rv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-rv","licenseNotes":null,"shortName":"RVA","englishName":"Revised Version","language":"eng","textDirection":"ltr","sha256":"6ce9e41d31d6d7e6e6b875afc9b500cb7d768d458b56dd046bdd10b996777398","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_rv5/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5776},"book":{"id":"PSA","translationId":"eng_rv5","name":"Psalms","commonName":"Psalms","title":"THE PSALMS.","order":19,"numberOfChapters":150,"sha256":"09310f2beb5799d2d93766f76ca6670412489f79b48f952d45bb606e336bd790","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_rv5/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_rv5/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Give unto the LORD, O ye sons of the mighty, give unto the LORD glory and strength.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Give unto the LORD the glory due unto his name; worship the LORD in the beauty of holiness.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The voice of the LORD is upon the waters: the God of glory thundereth, even the LORD upon many waters.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The voice of the LORD is powerful; the voice of the LORD is full of majesty.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The voice of the LORD breaketh the cedars; yea, the LORD breaketh in pieces the cedars of Lebanon.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He maketh them also to skip like a calf; Lebanon and Sirion like a young wild-ox.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The voice of the LORD cleaveth the flames of fire.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The voice of the LORD shaketh the wilderness; the LORD shaketh the wilderness of Kadesh.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The voice of the LORD maketh the hinds to calve, and strippeth the forests bare: and in his temple every thing saith, Glory.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"The LORD sat as king at the Flood; yea, the LORD sitteth as king for ever.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"The LORD will give strength unto his people; the LORD will bless his people with peace.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_rv5/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_rv5/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_rv5/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}