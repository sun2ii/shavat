{"translation":{"id":"eng_rv5","name":"Revised Version with Apocrypha (1895)","website":"https://ebible.org/Scriptures/details.php?id=eng-rv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-rv","licenseNotes":null,"shortName":"RVA","englishName":"Revised Version","language":"eng","textDirection":"ltr","sha256":"6ce9e41d31d6d7e6e6b875afc9b500cb7d768d458b56dd046bdd10b996777398","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_rv5/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5776},"book":{"id":"PSA","translationId":"eng_rv5","name":"Psalms","commonName":"Psalms","title":"THE PSALMS.","order":19,"numberOfChapters":150,"sha256":"09310f2beb5799d2d93766f76ca6670412489f79b48f952d45bb606e336bd790","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_rv5/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_rv5/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Judge me, O God, and plead my cause against an ungodly nation: O deliver me from the deceitful and unjust man.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For thou art the God of my strength; why hast thou cast me off? why go I mourning because of the oppression of the enemy?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"O send out thy light and thy truth; let them lead me: let them bring me unto thy holy hill, and to thy tabernacles.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Then will I go unto the altar of God, unto God my exceeding joy: and upon the harp will I praise thee, O God, my God.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Why art thou cast down, O my soul? and why art thou disquieted within me? hope thou in God: for I shall yet praise him, who is the health of my countenance, and my God.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_rv5/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_rv5/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_rv5/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}