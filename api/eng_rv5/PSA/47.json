{"translation":{"id":"eng_rv5","name":"Revised Version with Apocrypha (1895)","website":"https://ebible.org/Scriptures/details.php?id=eng-rv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-rv","licenseNotes":null,"shortName":"RVA","englishName":"Revised Version","language":"eng","textDirection":"ltr","sha256":"6ce9e41d31d6d7e6e6b875afc9b500cb7d768d458b56dd046bdd10b996777398","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_rv5/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5776},"book":{"id":"PSA","translationId":"eng_rv5","name":"Psalms","commonName":"Psalms","title":"THE PSALMS.","order":19,"numberOfChapters":150,"sha256":"09310f2beb5799d2d93766f76ca6670412489f79b48f952d45bb606e336bd790","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_rv5/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_rv5/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician; a Psalm of the sons of Korah."]},{"type":"verse","number":1,"content":[{"text":"O clap your hands, all ye peoples; shout unto God with the voice of triumph.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For the LORD Most High is terrible; he is a great King over all the earth.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He shall subdue the peoples under us, and the nations under our feet.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He shall choose our inheritance for us, the excellency of Jacob whom he loved. Selah","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"God is gone up with a shout, the LORD with the sound of a trumpet.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sing praises to God, sing praises: sing praises unto our King, sing praises.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For God is the King of all the earth: sing ye praises with understanding.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"God reigneth over the nations: God sitteth upon his holy throne.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The princes of the peoples are gathered together to be the people of the God of Abraham: for the shields of the earth belong unto God; he is greatly exalted.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_rv5/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_rv5/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_rv5/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}