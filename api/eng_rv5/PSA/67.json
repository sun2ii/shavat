{"translation":{"id":"eng_rv5","name":"Revised Version with Apocrypha (1895)","website":"https://ebible.org/Scriptures/details.php?id=eng-rv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-rv","licenseNotes":null,"shortName":"RVA","englishName":"Revised Version","language":"eng","textDirection":"ltr","sha256":"6ce9e41d31d6d7e6e6b875afc9b500cb7d768d458b56dd046bdd10b996777398","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_rv5/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5776},"book":{"id":"PSA","translationId":"eng_rv5","name":"Psalms","commonName":"Psalms","title":"THE PSALMS.","order":19,"numberOfChapters":150,"sha256":"09310f2beb5799d2d93766f76ca6670412489f79b48f952d45bb606e336bd790","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_rv5/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_rv5/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician; on stringed instruments. A Psalm, a Song."]},{"type":"verse","number":1,"content":[{"text":"God be merciful unto us, and bless us, and cause his face to shine upon us; Selah","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"That thy way may be known upon earth, thy saving health among all nations.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let the peoples praise thee, O God; let all the peoples praise thee.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"O let the nations be glad and sing for joy: for thou shalt judge the peoples with equity, and govern the nations upon earth. Selah","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Let the peoples praise thee, O God; let all the peoples praise thee.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The earth hath yielded her increase: God, even our own God, shall bless us.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"God shall bless us; and all the ends of the earth shall fear him.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_rv5/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_rv5/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_rv5/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}