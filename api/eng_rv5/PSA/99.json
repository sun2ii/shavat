{"translation":{"id":"eng_rv5","name":"Revised Version with Apocrypha (1895)","website":"https://ebible.org/Scriptures/details.php?id=eng-rv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-rv","licenseNotes":null,"shortName":"RVA","englishName":"Revised Version","language":"eng","textDirection":"ltr","sha256":"6ce9e41d31d6d7e6e6b875afc9b500cb7d768d458b56dd046bdd10b996777398","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_rv5/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":14,"totalNumberOfApocryphalChapters":173,"totalNumberOfApocryphalVerses":5776},"book":{"id":"PSA","translationId":"eng_rv5","name":"Psalms","commonName":"Psalms","title":"THE PSALMS.","order":19,"numberOfChapters":150,"sha256":"09310f2beb5799d2d93766f76ca6670412489f79b48f952d45bb606e336bd790","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_rv5/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_rv5/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"The LORD reigneth; let the peoples tremble: he sitteth upon the cherubim; let the earth be moved.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The LORD is great in Zion; and he is high above all the peoples.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let them praise thy great and terrible name: holy is he.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The king’s strength also loveth judgment; thou dost establish equity, thou executest judgment and righteousness in Jacob.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Exalt ye the LORD our God, and worship at his footstool: holy is he.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Moses and Aaron among his priests, and Samuel among them that call on his name; they called upon the LORD, and he answered them.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He spake unto them in the pillar of cloud: they kept his testimonies, and the statute that he gave them.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Thou answeredst them, O LORD our God: thou wast a God that forgavest them, though thou tookest vengeance of their doings.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Exalt ye the LORD our God, and worship at his holy hill; for the LORD our God is holy.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_rv5/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_rv5/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_rv5/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}