{"translation":{"id":"eng_webc","name":"World English Bible (Catholic)","website":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseNotes":null,"shortName":"WEBC","englishName":"World English Bible (Catholic)","language":"eng","textDirection":"ltr","sha256":"6912ad38e37e6bf796fde6da3c614c5cdc6fa32f74b12d26a326650a335c51b8","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webc/books.json","numberOfBooks":64,"totalNumberOfChapters":1167,"totalNumberOfVerses":30579,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":9,"totalNumberOfApocryphalChapters":161,"totalNumberOfApocryphalVerses":4829},"book":{"id":"PSA","translationId":"eng_webc","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"3a7f0f3767e83cb9a36c8eb9388719d59b24263de9e94bb040c1d80f9960edf3","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician. By David."]},{"type":"verse","number":1,"content":[{"text":"In the LORD, I take refuge.","poem":1},{"text":"How can you say to my soul, “Flee as a bird to your mountain”?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"For, behold, the wicked bend their bows.","poem":1},{"text":"They set their arrows on the strings,","poem":2},{"lineBreak":true},{"text":"that they may shoot in darkness at the upright in heart.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"If the foundations are destroyed,","poem":1},{"text":"what can the righteous do?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"The LORD is in his holy temple.","poem":1},{"text":"The LORD is on his throne in heaven.","poem":2},{"text":"His eyes observe.","poem":1},{"text":"His eyes examine the children of men.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"The LORD examines the righteous,","poem":1},{"text":"but his soul hates the wicked and him who loves violence.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"On the wicked he will rain blazing coals;","poem":1},{"text":"fire, sulfur, and scorching wind shall be the portion of their cup.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"For the LORD is righteous.","poem":1},{"text":"He loves righteousness.","poem":2},{"lineBreak":true},{"text":"The upright shall see his face.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webc/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webc/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webc/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}