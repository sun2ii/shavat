{"translation":{"id":"eng_webc","name":"World English Bible (Catholic)","website":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseNotes":null,"shortName":"WEBC","englishName":"World English Bible (Catholic)","language":"eng","textDirection":"ltr","sha256":"6912ad38e37e6bf796fde6da3c614c5cdc6fa32f74b12d26a326650a335c51b8","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webc/books.json","numberOfBooks":64,"totalNumberOfChapters":1167,"totalNumberOfVerses":30579,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":9,"totalNumberOfApocryphalChapters":161,"totalNumberOfApocryphalVerses":4829},"book":{"id":"PSA","translationId":"eng_webc","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"3a7f0f3767e83cb9a36c8eb9388719d59b24263de9e94bb040c1d80f9960edf3","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["A Psalm by David."]},{"type":"verse","number":1,"content":[{"text":"The LORD says to my Lord, “Sit at my right hand,","poem":1},{"text":"until I make your enemies your footstool for your feet.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"The LORD will send out the rod of your strength out of Zion.","poem":1},{"text":"Rule among your enemies.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Your people offer themselves willingly in the day of your power, in holy array.","poem":1},{"text":"Out of the womb of the morning, you have the dew of your youth.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"The LORD has sworn, and will not change his mind:","poem":1},{"text":"“You are a priest forever in the order of Melchizedek.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"The Lord is at your right hand.","poem":1},{"text":"He will crush kings in the day of his wrath.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"He will judge among the nations.","poem":1},{"text":"He will heap up dead bodies.","poem":2},{"lineBreak":true},{"text":"He will crush the ruler of the whole earth.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"He will drink of the brook on the way;","poem":1},{"text":"therefore he will lift up his head.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webc/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webc/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webc/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}