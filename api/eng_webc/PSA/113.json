{"translation":{"id":"eng_webc","name":"World English Bible (Catholic)","website":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseNotes":null,"shortName":"WEBC","englishName":"World English Bible (Catholic)","language":"eng","textDirection":"ltr","sha256":"6912ad38e37e6bf796fde6da3c614c5cdc6fa32f74b12d26a326650a335c51b8","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webc/books.json","numberOfBooks":64,"totalNumberOfChapters":1167,"totalNumberOfVerses":30579,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":9,"totalNumberOfApocryphalChapters":161,"totalNumberOfApocryphalVerses":4829},"book":{"id":"PSA","translationId":"eng_webc","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"3a7f0f3767e83cb9a36c8eb9388719d59b24263de9e94bb040c1d80f9960edf3","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Praise the LORD!","poem":1},{"noteId":62},{"text":"Praise, you servants of the LORD,","poem":2},{"noteId":63},{"lineBreak":true},{"text":"praise the LORD’s name.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Blessed be the LORD’s name,","poem":1},{"text":"from this time forward and forever more.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"From the rising of the sun to its going down,","poem":1},{"text":"the LORD’s name is to be praised.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"The LORD is high above all nations,","poem":1},{"text":"his glory above the heavens.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Who is like the LORD, our God,","poem":1},{"text":"who has his seat on high,","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"who stoops down to see in heaven and in the earth?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"He raises up the poor out of the dust,","poem":1},{"text":"and lifts up the needy from the ash heap,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"that he may set him with princes,","poem":1},{"text":"even with the princes of his people.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"He settles the barren woman in her home","poem":1},{"text":"as a joyful mother of children.","poem":2},{"text":"Praise the LORD!","poem":1},{"noteId":64}]}],"footnotes":[{"noteId":62,"caller":"+","text":"Hebrew: יה Yah","reference":{"chapter":113,"verse":1}},{"noteId":63,"caller":"+","text":"LORD or GOD in all caps is from the Hebrew יהוה‎ Yahweh except when otherwise noted as being from the short form יה Yah.","reference":{"chapter":113,"verse":1}},{"noteId":64,"caller":"+","text":"Hebrew: יה Yah","reference":{"chapter":113,"verse":9}}]},"thisChapterLink":"/api/eng_webc/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webc/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webc/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}