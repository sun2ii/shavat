{"translation":{"id":"eng_webc","name":"World English Bible (Catholic)","website":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseNotes":null,"shortName":"WEBC","englishName":"World English Bible (Catholic)","language":"eng","textDirection":"ltr","sha256":"6912ad38e37e6bf796fde6da3c614c5cdc6fa32f74b12d26a326650a335c51b8","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webc/books.json","numberOfBooks":64,"totalNumberOfChapters":1167,"totalNumberOfVerses":30579,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":9,"totalNumberOfApocryphalChapters":161,"totalNumberOfApocryphalVerses":4829},"book":{"id":"PSA","translationId":"eng_webc","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"3a7f0f3767e83cb9a36c8eb9388719d59b24263de9e94bb040c1d80f9960edf3","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"When Israel went out of Egypt,","poem":1},{"text":"the house of Jacob from a people of foreign language,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Judah became his sanctuary,","poem":1},{"text":"Israel his dominion.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"The sea saw it, and fled.","poem":1},{"text":"The Jordan was driven back.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"The mountains skipped like rams,","poem":1},{"text":"the little hills like lambs.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"What was it, you sea, that you fled?","poem":1},{"text":"You Jordan, that you turned back?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"You mountains, that you skipped like rams?","poem":1},{"text":"You little hills, like lambs?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tremble, you earth, at the presence of the Lord,","poem":1},{"text":"at the presence of the God of Jacob,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"who turned the rock into a pool of water,","poem":1},{"text":"the flint into a spring of waters.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webc/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webc/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webc/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}