{"translation":{"id":"eng_webc","name":"World English Bible (Catholic)","website":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseNotes":null,"shortName":"WEBC","englishName":"World English Bible (Catholic)","language":"eng","textDirection":"ltr","sha256":"6912ad38e37e6bf796fde6da3c614c5cdc6fa32f74b12d26a326650a335c51b8","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webc/books.json","numberOfBooks":64,"totalNumberOfChapters":1167,"totalNumberOfVerses":30579,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":9,"totalNumberOfApocryphalChapters":161,"totalNumberOfApocryphalVerses":4829},"book":{"id":"PSA","translationId":"eng_webc","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"3a7f0f3767e83cb9a36c8eb9388719d59b24263de9e94bb040c1d80f9960edf3","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"hebrew_subtitle","content":["A Song of Ascents."]},{"type":"verse","number":1,"content":[{"text":"In my distress, I cried to the LORD.","poem":1},{"text":"He answered me.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Deliver my soul, LORD, from lying lips,","poem":1},{"text":"from a deceitful tongue.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"What will be given to you, and what will be done more to you,","poem":1},{"text":"you deceitful tongue?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sharp arrows of the mighty,","poem":1},{"text":"with coals of juniper.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Woe is me, that I live in Meshech,","poem":1},{"text":"that I dwell among the tents of Kedar!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"My soul has had her dwelling too long","poem":1},{"text":"with him who hates peace.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I am for peace,","poem":1},{"text":"but when I speak, they are for war.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webc/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webc/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webc/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}