{"translation":{"id":"eng_webc","name":"World English Bible (Catholic)","website":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseNotes":null,"shortName":"WEBC","englishName":"World English Bible (Catholic)","language":"eng","textDirection":"ltr","sha256":"6912ad38e37e6bf796fde6da3c614c5cdc6fa32f74b12d26a326650a335c51b8","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webc/books.json","numberOfBooks":64,"totalNumberOfChapters":1167,"totalNumberOfVerses":30579,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":9,"totalNumberOfApocryphalChapters":161,"totalNumberOfApocryphalVerses":4829},"book":{"id":"PSA","translationId":"eng_webc","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"3a7f0f3767e83cb9a36c8eb9388719d59b24263de9e94bb040c1d80f9960edf3","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":123,"content":[{"type":"hebrew_subtitle","content":["A Song of Ascents."]},{"type":"verse","number":1,"content":[{"text":"I lift up my eyes to you,","poem":1},{"text":"you who sit in the heavens.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Behold, as the eyes of servants look to the hand of their master,","poem":1},{"text":"as the eyes of a maid to the hand of her mistress,","poem":2},{"lineBreak":true},{"text":"so our eyes look to the LORD, our God,","poem":2},{"lineBreak":true},{"text":"until he has mercy on us.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Have mercy on us, LORD, have mercy on us,","poem":1},{"text":"for we have endured much contempt.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Our soul is exceedingly filled with the scoffing of those who are at ease,","poem":1},{"text":"with the contempt of