{"translation":{"id":"eng_webc","name":"World English Bible (Catholic)","website":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseNotes":null,"shortName":"WEBC","englishName":"World English Bible (Catholic)","language":"eng","textDirection":"ltr","sha256":"6912ad38e37e6bf796fde6da3c614c5cdc6fa32f74b12d26a326650a335c51b8","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webc/books.json","numberOfBooks":64,"totalNumberOfChapters":1167,"totalNumberOfVerses":30579,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":9,"totalNumberOfApocryphalChapters":161,"totalNumberOfApocryphalVerses":4829},"book":{"id":"PSA","translationId":"eng_webc","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"3a7f0f3767e83cb9a36c8eb9388719d59b24263de9e94bb040c1d80f9960edf3","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"hebrew_subtitle","content":["A Song of Ascents. By Solomon."]},{"type":"verse","number":1,"content":[{"text":"Unless the LORD builds the house,","poem":1},{"text":"they who build it labor in vain.","poem":2},{"text":"Unless the LORD watches over the city,","poem":1},{"text":"the watchman guards it in vain.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"It is vain for you to rise up early,","poem":1},{"text":"to stay up late,","poem":2},{"lineBreak":true},{"text":"eating the bread of toil,","poem":2},{"lineBreak":true},{"text":"for he gives sleep to his loved ones.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Behold, children are a heritage of the LORD.","poem":1},{"text":"The fruit of the womb is his reward.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"As arrows in the hand of a mighty man,","poem":1},{"text":"so are the children of youth.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Happy is the man who has his quiver full of them.","poem":1},{"text":"They won’t be disappointed when they speak with their enemies in the gate.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webc/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webc/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webc/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}