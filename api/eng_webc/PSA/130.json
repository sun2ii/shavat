{"translation":{"id":"eng_webc","name":"World English Bible (Catholic)","website":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseNotes":null,"shortName":"WEBC","englishName":"World English Bible (Catholic)","language":"eng","textDirection":"ltr","sha256":"6912ad38e37e6bf796fde6da3c614c5cdc6fa32f74b12d26a326650a335c51b8","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webc/books.json","numberOfBooks":64,"totalNumberOfChapters":1167,"totalNumberOfVerses":30579,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":9,"totalNumberOfApocryphalChapters":161,"totalNumberOfApocryphalVerses":4829},"book":{"id":"PSA","translationId":"eng_webc","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"3a7f0f3767e83cb9a36c8eb9388719d59b24263de9e94bb040c1d80f9960edf3","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["A Song of Ascents."]},{"type":"verse","number":1,"content":[{"text":"Out of the depths I have cried to you, LORD.","poem":1},{"noteId":81}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lord, hear my voice.","poem":1},{"text":"Let your ears be attentive to the voice of my petitions.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"If you, LORD,","poem":1},{"noteId":82},{"text":"kept a record of sins,","poem":1},{"text":"Lord, who could stand?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"But there is forgiveness with you,","poem":1},{"text":"therefore you are feared.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I wait for the LORD.","poem":1},{"text":"My soul waits.","poem":2},{"lineBreak":true},{"text":"I hope in his word.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"My soul longs for the Lord more than watchmen long for the morning,","poem":1},{"text":"more than watchmen for the morning.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Israel, hope in the LORD,","poem":1},{"text":"for there is loving kindness with the LORD.","poem":2},{"lineBreak":true},{"text":"Abundant redemption is with him.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"He will redeem Israel from all their sins.","poem":1}]}],"footnotes":[{"noteId":81,"caller":"+","text":"LORD or GOD in all caps is from the Hebrew יהוה Yahweh except when otherwise noted as being from the short form יה Yah.","reference":{"chapter":130,"verse":1}},{"noteId":82,"caller":"+","text":"Hebrew: יה Yah","reference":{"chapter":130,"verse":3}}]},"thisChapterLink":"/api/eng_webc/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webc/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webc/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}