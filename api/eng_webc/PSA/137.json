{"translation":{"id":"eng_webc","name":"World English Bible (Catholic)","website":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseNotes":null,"shortName":"WEBC","englishName":"World English Bible (Catholic)","language":"eng","textDirection":"ltr","sha256":"6912ad38e37e6bf796fde6da3c614c5cdc6fa32f74b12d26a326650a335c51b8","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webc/books.json","numberOfBooks":64,"totalNumberOfChapters":1167,"totalNumberOfVerses":30579,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":9,"totalNumberOfApocryphalChapters":161,"totalNumberOfApocryphalVerses":4829},"book":{"id":"PSA","translationId":"eng_webc","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"3a7f0f3767e83cb9a36c8eb9388719d59b24263de9e94bb040c1d80f9960edf3","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"By the rivers of Babylon, there we sat down.","poem":1},{"text":"Yes, we wept, when we remembered Zion.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"On the willows in that land,","poem":1},{"text":"we hung up our harps.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"For there, those who led us captive asked us for songs.","poem":1},{"text":"Those who tormented us demanded songs of joy:","poem":2},{"lineBreak":true},{"text":"“Sing us one of the songs of Zion!”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"How can we sing the LORD’s song in a foreign land?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"If I forget you, Jerusalem,","poem":1},{"text":"let my right hand forget its skill.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Let my tongue stick to the roof of my mouth if I don’t remember you,","poem":1},{"text":"if I don’t prefer Jerusalem above my chief joy.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Remember, LORD, against the children of Edom in the day of Jerusalem,","poem":1},{"text":"who said, “Raze it!","poem":2},{"lineBreak":true},{"text":"Raze it even to its foundation!”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Daughter of Babylon, doomed to destruction,","poem":1},{"text":"he will be happy who repays you,","poem":2},{"lineBreak":true},{"text":"as you have done to us.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Happy shall he be,","poem":1},{"text":"who takes and dashes your little ones against the rock.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webc/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webc/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webc/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}