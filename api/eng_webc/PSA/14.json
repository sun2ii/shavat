{"translation":{"id":"eng_webc","name":"World English Bible (Catholic)","website":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseNotes":null,"shortName":"WEBC","englishName":"World English Bible (Catholic)","language":"eng","textDirection":"ltr","sha256":"6912ad38e37e6bf796fde6da3c614c5cdc6fa32f74b12d26a326650a335c51b8","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webc/books.json","numberOfBooks":64,"totalNumberOfChapters":1167,"totalNumberOfVerses":30579,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":9,"totalNumberOfApocryphalChapters":161,"totalNumberOfApocryphalVerses":4829},"book":{"id":"PSA","translationId":"eng_webc","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"3a7f0f3767e83cb9a36c8eb9388719d59b24263de9e94bb040c1d80f9960edf3","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician. By David."]},{"type":"verse","number":1,"content":[{"text":"The fool has said in his heart, “There is no God.”","poem":1},{"text":"They are corrupt.","poem":2},{"lineBreak":true},{"text":"They have done abominable deeds.","poem":2},{"lineBreak":true},{"text":"There is no one who does good.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"The LORD looked down from heaven on the children of men,","poem":1},{"text":"to see if there were any who understood,","poem":2},{"lineBreak":true},{"text":"who sought after God.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"They have all gone aside.","poem":1},{"text":"They have together become corrupt.","poem":2},{"lineBreak":true},{"text":"There is no one who does good, no, not one.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Have all the workers of iniquity no knowledge,","poem":1},{"text":"who eat up my people as they eat bread,","poem":2},{"lineBreak":true},{"text":"and don’t call on the LORD?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"There they were in great fear,","poem":1},{"text":"for God is in the generation of the righteous.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"You frustrate the plan of the poor,","poem":1},{"text":"because the LORD is his refuge.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Oh that the salvation of Israel would come out of Zion!","poem":1},{"text":"When the LORD restores the fortunes of his people,","poem":2},{"lineBreak":true},{"text":"then Jacob shall rejoice, and Israel shall be glad.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webc/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webc/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webc/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}