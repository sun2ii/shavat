{"translation":{"id":"eng_webc","name":"World English Bible (Catholic)","website":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseNotes":null,"shortName":"WEBC","englishName":"World English Bible (Catholic)","language":"eng","textDirection":"ltr","sha256":"6912ad38e37e6bf796fde6da3c614c5cdc6fa32f74b12d26a326650a335c51b8","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webc/books.json","numberOfBooks":64,"totalNumberOfChapters":1167,"totalNumberOfVerses":30579,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":9,"totalNumberOfApocryphalChapters":161,"totalNumberOfApocryphalVerses":4829},"book":{"id":"PSA","translationId":"eng_webc","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"3a7f0f3767e83cb9a36c8eb9388719d59b24263de9e94bb040c1d80f9960edf3","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"Praise the LORD!","poem":1},{"noteId":93},{"text":"Praise the LORD,","poem":2},{"noteId":94},{"text":"my soul.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"While I live, I will praise the LORD.","poem":1},{"text":"I will sing praises to my God as long as I exist.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Don’t put your trust in princes,","poem":1},{"text":"in a son of man in whom there is no help.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"His spirit departs, and he returns to the earth.","poem":1},{"text":"In that very day, his thoughts perish.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Happy is he who has the God of Jacob for his help,","poem":1},{"text":"whose hope is in the LORD, his God,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"who made heaven and earth,","poem":1},{"text":"the sea, and all that is in them;","poem":2},{"lineBreak":true},{"text":"who keeps truth forever;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"who executes justice for the oppressed;","poem":1},{"text":"who gives food to the hungry.","poem":2},{"text":"The LORD frees the prisoners.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"The LORD opens the eyes of the blind.","poem":2},{"lineBreak":true},{"text":"The LORD raises up those who are bowed down.","poem":2},{"lineBreak":true},{"text":"The LORD loves the righteous.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"The LORD preserves the foreigners.","poem":1},{"text":"He upholds the fatherless and widow,","poem":2},{"lineBreak":true},{"text":"but he turns the way of the wicked upside down.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"The LORD will reign forever;","poem":1},{"text":"your God, O Zion, to all generations.","poem":2},{"text":"Praise the LORD!","poem":1},{"noteId":95}]},{"type":"line_break"}],"footnotes":[{"noteId":93,"caller":"+","text":"Hebrew: יה Yah","reference":{"chapter":146,"verse":1}},{"noteId":94,"caller":"+","text":"LORD or GOD in all caps is from the Hebrew יהוה Yahweh except when otherwise noted as being from the short form יה Yah.","reference":{"chapter":146,"verse":1}},{"noteId":95,"caller":"+","text":"Hebrew: יה Yah","reference":{"chapter":146,"verse":10}}]},"thisChapterLink":"/api/eng_webc/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webc/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webc/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}