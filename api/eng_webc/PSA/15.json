:2}]},{"type":"verse","number":5,"content":[{"text":"he who doesn’t lend out his money for usury,","poem":1},{"text":"nor take a bribe against the innocent.","poem":2},{"lineBreak":true},{"text":"He who does these things shall never be shaken.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webc/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webc/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webc/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}