{"translation":{"id":"eng_webc","name":"World English Bible (Catholic)","website":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseNotes":null,"shortName":"WEBC","englishName":"World English Bible (Catholic)","language":"eng","textDirection":"ltr","sha256":"6912ad38e37e6bf796fde6da3c614c5cdc6fa32f74b12d26a326650a335c51b8","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webc/books.json","numberOfBooks":64,"totalNumberOfChapters":1167,"totalNumberOfVerses":30579,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":9,"totalNumberOfApocryphalChapters":161,"totalNumberOfApocryphalVerses":4829},"book":{"id":"PSA","translationId":"eng_webc","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"3a7f0f3767e83cb9a36c8eb9388719d59b24263de9e94bb040c1d80f9960edf3","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician. A Psalm by David."]},{"type":"verse","number":1,"content":[{"text":"May the LORD answer you in the day of trouble.","poem":1},{"text":"May the name of the God of Jacob set you up on high,","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"send you help from the sanctuary,","poem":2},{"lineBreak":true},{"text":"grant you support from Zion,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"remember all your offerings,","poem":2},{"lineBreak":true},{"text":"and accept your burned sacrifice. Selah.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"May he grant you your heart’s desire,","poem":1},{"text":"and fulfill all your counsel.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"We will triumph in your salvation.","poem":1},{"text":"In the name of our God, we will set up our banners.","poem":2},{"lineBreak":true},{"text":"May the LORD grant all your requests.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Now I know that the LORD saves his anointed.","poem":1},{"text":"He will answer him from his holy heaven,","poem":2},{"lineBreak":true},{"text":"with the saving strength of his right hand.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Some trust in chariots, and some in horses,","poem":1},{"text":"but we trust in the name of the LORD our God.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"They are bowed down and fallen,","poem":1},{"text":"but we rise up, and stand upright.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Save, LORD!","poem":1},{"text":"Let the King answer us when we call!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webc/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webc/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webc/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}