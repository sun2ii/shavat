{"translation":{"id":"eng_webc","name":"World English Bible (Catholic)","website":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseNotes":null,"shortName":"WEBC","englishName":"World English Bible (Catholic)","language":"eng","textDirection":"ltr","sha256":"6912ad38e37e6bf796fde6da3c614c5cdc6fa32f74b12d26a326650a335c51b8","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webc/books.json","numberOfBooks":64,"totalNumberOfChapters":1167,"totalNumberOfVerses":30579,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":9,"totalNumberOfApocryphalChapters":161,"totalNumberOfApocryphalVerses":4829},"book":{"id":"PSA","translationId":"eng_webc","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"3a7f0f3767e83cb9a36c8eb9388719d59b24263de9e94bb040c1d80f9960edf3","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["A Psalm by David, when he fled from Absalom his son."]},{"type":"verse","number":1,"content":[{"text":"LORD, how my adversaries have increased!","poem":1},{"text":"Many are those who rise up against me.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Many there are who say of my soul,","poem":1},{"text":"“There is no help for him in God.”","poem":2},{"noteId":4},{"text":"Selah.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"But you, LORD, are a shield around me,","poem":1},{"text":"my glory, and the one who lifts up my head.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I cry to the LORD with my voice,","poem":1},{"text":"and he answers me out of his holy hill. Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I laid myself down and slept.","poem":1},{"text":"I awakened, for the LORD sustains me.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I will not be afraid of tens of thousands of people","poem":1},{"text":"who have set themselves against me on every side.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Arise, LORD!","poem":1},{"text":"Save me, my God!","poem":2},{"text":"For you have struck all of my enemies on the cheek bone.","poem":1},{"text":"You have broken the teeth of the wicked.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Salvation belongs to the LORD.","poem":1},{"text":"May your blessing be on your people. Selah.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"The Hebrew word rendered “God” is “אֱלֹהִ֑ים” (Elohim).","reference":{"chapter":3,"verse":2}}]},"thisChapterLink":"/api/eng_webc/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webc/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webc/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}