{"translation":{"id":"eng_webc","name":"World English Bible (Catholic)","website":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseNotes":null,"shortName":"WEBC","englishName":"World English Bible (Catholic)","language":"eng","textDirection":"ltr","sha256":"6912ad38e37e6bf796fde6da3c614c5cdc6fa32f74b12d26a326650a335c51b8","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webc/books.json","numberOfBooks":64,"totalNumberOfChapters":1167,"totalNumberOfVerses":30579,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":9,"totalNumberOfApocryphalChapters":161,"totalNumberOfApocryphalVerses":4829},"book":{"id":"PSA","translationId":"eng_webc","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"3a7f0f3767e83cb9a36c8eb9388719d59b24263de9e94bb040c1d80f9960edf3","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician. A Psalm by the sons of Korah."]},{"type":"verse","number":1,"content":[{"text":"Oh clap your hands, all you nations.","poem":1},{"text":"Shout to God with the voice of triumph!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"For the LORD Most High is awesome.","poem":1},{"text":"He is a great King over all the earth.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"He subdues nations under us,","poem":1},{"text":"and peoples under our feet.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"He chooses our inheritance for us,","poem":1},{"text":"the glory of Jacob whom he loved. Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"God has gone up with a shout,","poem":1},{"text":"the LORD with the sound of a trumpet.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sing praises to God! Sing praises!","poem":1},{"text":"Sing praises to our King! Sing praises!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"For God is the King of all the earth.","poem":1},{"text":"Sing praises with understanding.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"God reigns over the nations.","poem":1},{"text":"God sits on his holy throne.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"The princes of the peoples are gathered together,","poem":1},{"lineBreak":true},{"text":"the people of the God of Abraham.","poem":1},{"text":"For the shields of the earth belong to God.","poem":2},{"lineBreak":true},{"text":"He is greatly exalted!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webc/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webc/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webc/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}