"type":"verse","number":5,"content":[{"text":"He will repay the evil to my enemies.","poem":1},{"text":"Destroy them in your truth.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"With a free will offering, I will sacrifice to you.","poem":1},{"text":"I will give thanks to your name, LORD, for it is good.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"For he has delivered me out of all trouble.","poem":1},{"text":"My eye has seen triumph over my enemies.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webc/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webc/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webc/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}