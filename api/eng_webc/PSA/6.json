{"translation":{"id":"eng_webc","name":"World English Bible (Catholic)","website":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseNotes":null,"shortName":"WEBC","englishName":"World English Bible (Catholic)","language":"eng","textDirection":"ltr","sha256":"6912ad38e37e6bf796fde6da3c614c5cdc6fa32f74b12d26a326650a335c51b8","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webc/books.json","numberOfBooks":64,"totalNumberOfChapters":1167,"totalNumberOfVerses":30579,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":9,"totalNumberOfApocryphalChapters":161,"totalNumberOfApocryphalVerses":4829},"book":{"id":"PSA","translationId":"eng_webc","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"3a7f0f3767e83cb9a36c8eb9388719d59b24263de9e94bb040c1d80f9960edf3","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":6,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician; on stringed instruments, upon the eight-stringed lyre. A Psalm by David."]},{"type":"verse","number":1,"content":[{"text":"LORD, don’t rebuke me in your anger,","poem":1},{"text":"neither discipline me in your wrath.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Have mercy on me, LORD, for I am faint.","poem":1},{"text":"LORD, heal me, for my bones are troubled.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"My soul is also in great anguish.","poem":1},{"text":"But you, LORD—how long?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Return, LORD. Deliver my soul,","poem":1},{"text":"and save me for your loving kindness’ sake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"For in death there is no memory of you.","poem":1},{"text":"In Sheol,","poem":2},{"noteId":5},{"text":"who shall give you thanks?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I am weary with my groaning.","poem":1},{"text":"Every night I flood my bed.","poem":2},{"lineBreak":true},{"text":"I drench my couch with my tears.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"My eye wastes away because of grief.","poem":1},{"text":"It grows old because of all my adversaries.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Depart from me, all you workers of iniquity,","poem":1},{"text":"for the LORD has heard the voice of my weeping.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"The LORD has heard my supplication.","poem":1},{"text":"The LORD accepts my prayer.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"May all my enemies be ashamed and dismayed.","poem":1},{"text":"They shall turn back, they shall be disgraced suddenly.","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"Sheol is the place of the dead.","reference":{"chapter":6,"verse":5}}]},"thisChapterLink":"/api/eng_webc/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webc/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webc/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}