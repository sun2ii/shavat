{"translation":{"id":"eng_webc","name":"World English Bible (Catholic)","website":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseNotes":null,"shortName":"WEBC","englishName":"World English Bible (Catholic)","language":"eng","textDirection":"ltr","sha256":"6912ad38e37e6bf796fde6da3c614c5cdc6fa32f74b12d26a326650a335c51b8","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webc/books.json","numberOfBooks":64,"totalNumberOfChapters":1167,"totalNumberOfVerses":30579,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":9,"totalNumberOfApocryphalChapters":161,"totalNumberOfApocryphalVerses":4829},"book":{"id":"PSA","translationId":"eng_webc","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"3a7f0f3767e83cb9a36c8eb9388719d59b24263de9e94bb040c1d80f9960edf3","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician. For a stringed instrument. By David."]},{"type":"verse","number":1,"content":[{"text":"Hear my cry, God.","poem":1},{"text":"Listen to my prayer.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"From the end of the earth, I will call to you when my heart is overwhelmed.","poem":1},{"text":"Lead me to the rock that is higher than I.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"For you have been a refuge for me,","poem":1},{"text":"a strong tower from the enemy.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I will dwell in your tent forever.","poem":1},{"text":"I will take refuge in the shelter of your wings. Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"For you, God, have heard my vows.","poem":1},{"text":"You have given me the heritage of those who fear your name.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"You will prolong the king’s life.","poem":1},{"text":"His years will be for generations.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"He shall be enthroned in God’s presence forever.","poem":1},{"text":"Appoint your loving kindness and truth, that they may preserve him.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"So I will sing praise to your name forever,","poem":1},{"text":"that I may fulfill my vows daily.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webc/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webc/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webc/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}