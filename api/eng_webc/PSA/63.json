{"translation":{"id":"eng_webc","name":"World English Bible (Catholic)","website":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseNotes":null,"shortName":"WEBC","englishName":"World English Bible (Catholic)","language":"eng","textDirection":"ltr","sha256":"6912ad38e37e6bf796fde6da3c614c5cdc6fa32f74b12d26a326650a335c51b8","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webc/books.json","numberOfBooks":64,"totalNumberOfChapters":1167,"totalNumberOfVerses":30579,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":9,"totalNumberOfApocryphalChapters":161,"totalNumberOfApocryphalVerses":4829},"book":{"id":"PSA","translationId":"eng_webc","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"3a7f0f3767e83cb9a36c8eb9388719d59b24263de9e94bb040c1d80f9960edf3","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"hebrew_subtitle","content":["A Psalm by David, when he was in the desert of Judah."]},{"type":"verse","number":1,"content":[{"text":"God, you are my God.","poem":1},{"text":"I will earnestly seek you.","poem":2},{"text":"My soul thirsts for you.","poem":1},{"text":"My flesh longs for you,","poem":2},{"lineBreak":true},{"text":"in a dry and weary land, where there is no water.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"So I have seen you in the sanctuary,","poem":1},{"text":"watching your power and your glory.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Because your loving kindness is better than life,","poem":1},{"text":"my lips shall praise you.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"So I will bless you while I live.","poem":1},{"text":"I will lift up my hands in your name.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"My soul shall be satisfied as with the richest food.","poem":1},{"text":"My mouth shall praise you with joyful lips,","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"when I remember you on my bed,","poem":2},{"lineBreak":true},{"text":"and think about you in the night watches.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"For you have been my help.","poem":1},{"text":"I will rejoice in the shadow of your wings.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"My soul stays close to you.","poem":1},{"text":"Your right hand holds me up.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"But those who seek my soul to destroy it","poem":1},{"text":"shall go into the lower parts of the earth.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"They shall be given over to the power of the sword.","poem":1},{"text":"They shall be jackal food.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"But the king shall rejoice in God.","poem":1},{"text":"Everyone who swears by him will praise him,","poem":2},{"lineBreak":true},{"text":"for the mouth of those who speak lies shall be silenced.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webc/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webc/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webc/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}