{"translation":{"id":"eng_webc","name":"World English Bible (Catholic)","website":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web-c","licenseNotes":null,"shortName":"WEBC","englishName":"World English Bible (Catholic)","language":"eng","textDirection":"ltr","sha256":"6912ad38e37e6bf796fde6da3c614c5cdc6fa32f74b12d26a326650a335c51b8","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webc/books.json","numberOfBooks":64,"totalNumberOfChapters":1167,"totalNumberOfVerses":30579,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":9,"totalNumberOfApocryphalChapters":161,"totalNumberOfApocryphalVerses":4829},"book":{"id":"PSA","translationId":"eng_webc","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"3a7f0f3767e83cb9a36c8eb9388719d59b24263de9e94bb040c1d80f9960edf3","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician. To the tune of “Do Not Destroy.” A Psalm by Asaph. A song."]},{"type":"verse","number":1,"content":[{"text":"We give thanks to you, God.","poem":1},{"text":"We give thanks, for your Name is near.","poem":2},{"lineBreak":true},{"text":"Men tell about your wondrous works.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"When I choose the appointed time,","poem":1},{"text":"I will judge blamelessly.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"The earth and all its inhabitants quake.","poem":1},{"text":"I firmly hold its pillars. Selah.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I said to the arrogant, “Don’t boast!”","poem":1},{"text":"I said to the wicked, “Don’t lift up the horn.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Don’t lift up your horn on high.","poem":1},{"text":"Don’t speak with a stiff neck.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"For neither from the east, nor from the west,","poem":1},{"text":"nor yet from the south, comes exaltation.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"But God is the judge.","poem":1},{"text":"He puts down one, and lifts up another.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"For in the LORD’s hand there is a cup,","poem":1},{"text":"full of foaming wine mixed with spices.","poem":2},{"text":"He pours it out.","poem":1},{"text":"Indeed the wicked of the earth drink and drink it to its very dregs.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"But I will declare this forever:","poem":1},{"text":"I will sing praises to the God of Jacob.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"I will cut off all the horns of the wicked,","poem":1},{"text":"but the horns of the righteous shall be lifted up.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/eng_webc/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webc/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webc/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}