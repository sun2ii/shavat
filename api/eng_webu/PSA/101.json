{"translation":{"id":"eng_webu","name":"World English Bible Updated","website":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseNotes":null,"shortName":"WEBU","englishName":"World English Bible Updated","language":"eng","textDirection":"ltr","sha256":"16dfbd077e6fadc53ba621379619a7d15a21c318d6ff2b705a392e6dad66582f","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_webu","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"9f71bd5dc0e5972ca263a0723e8791d728b4396f098756375c52380beb035727","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["A Psalm by David."]},{"type":"verse","number":1,"content":[{"text":"I will sing of loving kindness and justice.","poem":1},{"text":"To you, LORD, I will sing praises.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"I will be careful to live a blameless life.","poem":1},{"text":"When will you come to me?","poem":2},{"lineBreak":true},{"text":"I will walk within my house with a blameless heart.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"I will set no vile thing before my eyes.","poem":1},{"text":"I hate the deeds of faithless men.","poem":2},{"lineBreak":true},{"text":"They will not cling to me.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"A perverse heart will be far from me.","poem":1},{"text":"I will have nothing to do with evil.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I will silence whoever secretly slanders his neighbor.","poem":1},{"text":"I won’t tolerate one who is arrogant and conceited.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"My eyes will be on the faithful of the land,","poem":1},{"text":"that they may dwell with me.","poem":2},{"text":"He who walks in a perfect way,","poem":1},{"text":"he will serve me.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"He who practices deceit won’t dwell within my house.","poem":1},{"text":"He who speaks falsehood won’t be established before my eyes.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Morning by morning, I will destroy all the wicked of the land,","poem":1},{"text":"to cut off all the workers of iniquity from the LORD’s city.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webu/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webu/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webu/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}