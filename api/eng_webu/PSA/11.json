{"translation":{"id":"eng_webu","name":"World English Bible Updated","website":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseNotes":null,"shortName":"WEBU","englishName":"World English Bible Updated","language":"eng","textDirection":"ltr","sha256":"16dfbd077e6fadc53ba621379619a7d15a21c318d6ff2b705a392e6dad66582f","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_webu","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"9f71bd5dc0e5972ca263a0723e8791d728b4396f098756375c52380beb035727","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician. By David."]},{"type":"verse","number":1,"content":[{"text":"In the LORD, I take refuge.","poem":1},{"text":"How can you say to my soul, “Flee as a bird to your mountain”?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"For, behold, the wicked bend their bows.","poem":1},{"text":"They set their arrows on the strings,","poem":2},{"lineBreak":true},{"text":"that they may shoot in darkness at the upright in heart.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"If the foundations are destroyed,","poem":1},{"text":"what can the righteous do?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"The LORD is in his holy temple.","poem":1},{"text":"The LORD is on his throne in heaven.","poem":2},{"text":"His eyes observe.","poem":1},{"text":"His eyes examine the children of men.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"The LORD examines the righteous,","poem":1},{"text":"but his soul hates the wicked and him who loves violence.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"On the wicked he will rain blazing coals;","poem":1},{"text":"fire, sulfur, and scorching wind shall be the portion of their cup.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"For the LORD is righteous.","poem":1},{"text":"He loves righteousness.","poem":2},{"lineBreak":true},{"text":"The upright shall see his face.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webu/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webu/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webu/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}