{"translation":{"id":"eng_webu","name":"World English Bible Updated","website":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseNotes":null,"shortName":"WEBU","englishName":"World English Bible Updated","language":"eng","textDirection":"ltr","sha256":"16dfbd077e6fadc53ba621379619a7d15a21c318d6ff2b705a392e6dad66582f","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_webu","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"9f71bd5dc0e5972ca263a0723e8791d728b4396f098756375c52380beb035727","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Praise the LORD!","poem":1},{"noteId":62},{"text":"Praise, you servants of the LORD,","poem":2},{"noteId":63},{"lineBreak":true},{"text":"praise the LORD’s name.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Blessed be the LORD’s name,","poem":1},{"text":"from this time forward and forever more.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"From the rising of the sun to its going down,","poem":1},{"text":"the LORD’s name is to be praised.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"The LORD is high above all nations,","poem":1},{"text":"his glory above the heavens.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Who is like the LORD, our God,","poem":1},{"text":"who has his seat on high,","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"who stoops down to see in heaven and in the earth?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"He raises up the poor out of the dust,","poem":1},{"text":"and lifts up the needy from the ash heap,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"that he may set him with princes,","poem":1},{"text":"even with the princes of his people.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"He settles the barren woman in her home","poem":1},{"text":"as a joyful mother of children.","poem":2},{"text":"Praise the LORD!","poem":1},{"noteId":64}]}],"footnotes":[{"noteId":62,"caller":"+","text":"Hebrew: יה Yah","reference":{"chapter":113,"verse":1}},{"noteId":63,"caller":"+","text":"LORD or GOD in all caps is from the Hebrew יהוה‎ Yahweh except when otherwise noted as being from the short form יה Yah.","reference":{"chapter":113,"verse":1}},{"noteId":64,"caller":"+","text":"Hebrew: יה Yah","reference":{"chapter":113,"verse":9}}]},"thisChapterLink":"/api/eng_webu/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webu/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webu/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}