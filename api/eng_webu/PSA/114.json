"poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tremble, you earth, at the presence of the Lord,","poem":1},{"text":"at the presence of the God of Jacob,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"who turned the rock into a pool of water,","poem":1},{"text":"the flint into a spring of waters.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webu/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webu/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webu/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}