n will not harm you by day,","poem":1},{"text":"nor the moon by night.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"The LORD will keep you from all evil.","poem":1},{"text":"He will keep your soul.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"The LORD will keep your going out and your coming in,","poem":1},{"text":"from this time forward, and forever more.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webu/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webu/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webu/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}