{"translation":{"id":"eng_webu","name":"World English Bible Updated","website":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseNotes":null,"shortName":"WEBU","englishName":"World English Bible Updated","language":"eng","textDirection":"ltr","sha256":"16dfbd077e6fadc53ba621379619a7d15a21c318d6ff2b705a392e6dad66582f","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_webu","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"9f71bd5dc0e5972ca263a0723e8791d728b4396f098756375c52380beb035727","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"hebrew_subtitle","content":["A Song of Ascents. By Solomon."]},{"type":"verse","number":1,"content":[{"text":"Unless the LORD builds the house,","poem":1},{"text":"they who build it labor in vain.","poem":2},{"text":"Unless the LORD watches over the city,","poem":1},{"text":"the watchman guards it in vain.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"It is vain for you to rise up early,","poem":1},{"text":"to stay up late,","poem":2},{"lineBreak":true},{"text":"eating the bread of toil,","poem":2},{"lineBreak":true},{"text":"for he gives sleep to his loved ones.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Behold, children are a heritage of the LORD.","poem":1},{"text":"The fruit of the womb is his reward.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"As arrows in the hand of a mighty man,","poem":1},{"text":"so are the children of youth.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Happy is the man who has his quiver full of them.","poem":1},{"text":"They won’t be disappointed when they speak with their enemies in the gate.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webu/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webu/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webu/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}