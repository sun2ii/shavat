ext":"Let them be as the grass on the housetops,","poem":1},{"text":"which withers before it grows up,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"with which the reaper doesn’t fill his hand,","poem":1},{"text":"nor he who binds sheaves, his bosom.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Neither do those who go by say,","poem":1},{"text":"“The blessing of the LORD be on you.","poem":2},{"lineBreak":true},{"text":"We bless you in the LORD’s name.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webu/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webu/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webu/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}