{"translation":{"id":"eng_webu","name":"World English Bible Updated","website":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseNotes":null,"shortName":"WEBU","englishName":"World English Bible Updated","language":"eng","textDirection":"ltr","sha256":"16dfbd077e6fadc53ba621379619a7d15a21c318d6ff2b705a392e6dad66582f","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_webu","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"9f71bd5dc0e5972ca263a0723e8791d728b4396f098756375c52380beb035727","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"By the rivers of Babylon, there we sat down.","poem":1},{"text":"Yes, we wept, when we remembered Zion.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"On the willows in that land,","poem":1},{"text":"we hung up our harps.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"For there, those who led us captive asked us for songs.","poem":1},{"text":"Those who tormented us demanded songs of joy:","poem":2},{"lineBreak":true},{"text":"“Sing us one of the songs of Zion!”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"How can we sing the LORD’s song in a foreign land?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"If I forget you, Jerusalem,","poem":1},{"text":"let my right hand forget its skill.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Let my tongue stick to the roof of my mouth if I don’t remember you,","poem":1},{"text":"if I don’t prefer Jerusalem above my chief joy.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Remember, LORD, against the children of Edom in the day of Jerusalem,","poem":1},{"text":"who said, “Raze it!","poem":2},{"lineBreak":true},{"text":"Raze it even to its foundation!”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Daughter of Babylon, doomed to destruction,","poem":1},{"text":"he will be happy who repays you,","poem":2},{"lineBreak":true},{"text":"as you have done to us.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Happy shall he be,","poem":1},{"text":"who takes and dashes your little ones against the rock.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webu/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webu/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webu/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}