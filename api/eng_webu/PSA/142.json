{"translation":{"id":"eng_webu","name":"World English Bible Updated","website":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseNotes":null,"shortName":"WEBU","englishName":"World English Bible Updated","language":"eng","textDirection":"ltr","sha256":"16dfbd077e6fadc53ba621379619a7d15a21c318d6ff2b705a392e6dad66582f","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_webu","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"9f71bd5dc0e5972ca263a0723e8791d728b4396f098756375c52380beb035727","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["A contemplation by David, when he was in the cave. A Prayer."]},{"type":"verse","number":1,"content":[{"text":"I cry with my voice to the LORD.","poem":1},{"text":"With my voice, I ask the LORD for mercy.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"I pour out my complaint before him.","poem":1},{"text":"I tell him my troubles.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"When my spirit was overwhelmed within me,","poem":1},{"text":"you knew my route.","poem":2},{"text":"On the path in which I walk,","poem":1},{"text":"they have hidden a snare for me.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Look on my right, and see;","poem":1},{"text":"for there is no one who is concerned for me.","poem":2},{"lineBreak":true},{"text":"Refuge has fled from me.","poem":2},{"lineBreak":true},{"text":"No one cares for my soul.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I cried to you, LORD.","poem":1},{"text":"I said, “You are my refuge,","poem":2},{"lineBreak":true},{"text":"my portion in the land of the living.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Listen to my cry,","poem":1},{"text":"for I am in desperate need.","poem":2},{"text":"Deliver me from my persecutors,","poem":1},{"text":"for they are too strong for me.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bring my soul out of prison,","poem":1},{"text":"that I may give thanks to your name.","poem":2},{"text":"The righteous will surround me,","poem":1},{"text":"for you will be good to me.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webu/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webu/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webu/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}