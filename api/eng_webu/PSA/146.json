{"translation":{"id":"eng_webu","name":"World English Bible Updated","website":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseNotes":null,"shortName":"WEBU","englishName":"World English Bible Updated","language":"eng","textDirection":"ltr","sha256":"16dfbd077e6fadc53ba621379619a7d15a21c318d6ff2b705a392e6dad66582f","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_webu","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"9f71bd5dc0e5972ca263a0723e8791d728b4396f098756375c52380beb035727","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"Praise the LORD!","poem":1},{"noteId":93},{"text":"Praise the LORD,","poem":2},{"noteId":94},{"text":"my soul.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"While I live, I will praise the LORD.","poem":1},{"text":"I will sing praises to my God as long as I exist.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Don’t put your trust in princes,","poem":1},{"text":"in a son of man in whom there is no help.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"His spirit departs, and he returns to the earth.","poem":1},{"text":"In that very day, his thoughts perish.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Happy is he who has the God of Jacob for his help,","poem":1},{"text":"whose hope is in the LORD, his God,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"who made heaven and earth,","poem":1},{"text":"the sea, and all that is in them;","poem":2},{"lineBreak":true},{"text":"who keeps truth forever;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"who executes justice for the oppressed;","poem":1},{"text":"who gives food to the hungry.","poem":2},{"text":"The LORD frees the prisoners.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"The LORD opens the eyes of the blind.","poem":2},{"lineBreak":true},{"text":"The LORD raises up those who are bowed down.","poem":2},{"lineBreak":true},{"text":"The LORD loves the righteous.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"The LORD preserves the foreigners.","poem":1},{"text":"He upholds the fatherless and widow,","poem":2},{"lineBreak":true},{"text":"but he turns the way of the wicked upside down.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"The LORD will reign forever;","poem":1},{"text":"your God, O Zion, to all generations.","poem":2},{"text":"Praise the LORD!","poem":1},{"noteId":95}]},{"type":"line_break"}],"footnotes":[{"noteId":93,"caller":"+","text":"Hebrew: יה Yah","reference":{"chapter":146,"verse":1}},{"noteId":94,"caller":"+","text":"LORD or GOD in all caps is from the Hebrew יהוה Yahweh except when otherwise noted as being from the short form יה Yah.","reference":{"chapter":146,"verse":1}},{"noteId":95,"caller":"+","text":"Hebrew: יה Yah","reference":{"chapter":146,"verse":10}}]},"thisChapterLink":"/api/eng_webu/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webu/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webu/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}