{"translation":{"id":"eng_webu","name":"World English Bible Updated","website":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseNotes":null,"shortName":"WEBU","englishName":"World English Bible Updated","language":"eng","textDirection":"ltr","sha256":"16dfbd077e6fadc53ba621379619a7d15a21c318d6ff2b705a392e6dad66582f","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_webu","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"9f71bd5dc0e5972ca263a0723e8791d728b4396f098756375c52380beb035727","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Why do the nations rage,","poem":1},{"text":"and the peoples plot a vain thing?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"The kings of the earth take a stand,","poem":1},{"text":"and the rulers take counsel together,","poem":2},{"lineBreak":true},{"text":"against the LORD, and against his Anointed,","poem":2},{"noteId":1},{"text":"saying,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Let’s break their bonds apart,","poem":1},{"text":"and cast their cords from us.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"He who sits in the heavens will laugh.","poem":1},{"text":"The Lord","poem":2},{"noteId":2},{"text":"will have them in derision.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Then he will speak to them in his anger,","poem":1},{"text":"and terrify them in his wrath:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Yet I have set my King on my holy hill of Zion.”","poem":1}]},{"type":"verse","number":7,"content":[{"text":"I will tell of the decree:","poem":2},{"text":"The LORD said to me, “You are my son.","poem":1},{"text":"Today I have become your father.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ask of me, and I will give the nations for your inheritance,","poem":1},{"text":"the uttermost parts of the earth for your possession.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"You shall break them with a rod of iron.","poem":1},{"text":"You shall dash them in pieces like a potter’s vessel.”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Now therefore be wise, you kings.","poem":1},{"text":"Be instructed, you judges of the earth.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Serve the LORD with fear,","poem":1},{"text":"and rejoice with trembling.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Give sincere homage to the Son,","poem":1},{"noteId":3},{"text":"lest he be angry, and you perish on the way,","poem":1},{"text":"for his wrath will soon be kindled.","poem":2},{"lineBreak":true},{"text":"Blessed are all those who take refuge in him.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"The word “Anointed” is the same as the word for “Messiah” or “Christ”","reference":{"chapter":2,"verse":2}},{"noteId":2,"caller":"+","text":"The word translated “Lord” is “Adonai.”","reference":{"chapter":2,"verse":4}},{"noteId":3,"caller":"+","text":"or, Kiss the son","reference":{"chapter":2,"verse":12}}]},"thisChapterLink":"/api/eng_webu/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webu/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webu/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}