{"translation":{"id":"eng_webu","name":"World English Bible Updated","website":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseNotes":null,"shortName":"WEBU","englishName":"World English Bible Updated","language":"eng","textDirection":"ltr","sha256":"16dfbd077e6fadc53ba621379619a7d15a21c318d6ff2b705a392e6dad66582f","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_webu","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"9f71bd5dc0e5972ca263a0723e8791d728b4396f098756375c52380beb035727","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["A Psalm by David, when he fled from Absalom his son."]},{"type":"verse","number":1,"content":[{"text":"LORD, how my adversaries have increased!","poem":1},{"text":"Many are those who rise up against me.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Many there are who say of my soul,","poem":1},{"text":"“There is no help for him in God.”","poem":2},{"noteId":4},{"text":"Selah.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"But you, LORD, are a shield around me,","poem":1},{"text":"my glory, and the one who lifts up my head.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I cry to the LORD with my voice,","poem":1},{"text":"and he answers me out of his holy hill. Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I laid myself down and slept.","poem":1},{"text":"I awakened, for the LORD sustains me.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I will not be afraid of tens of thousands of people","poem":1},{"text":"who have set themselves against me on every side.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Arise, LORD!","poem":1},{"text":"Save me, my God!","poem":2},{"text":"For you have struck all of my enemies on the cheek bone.","poem":1},{"text":"You have broken the teeth of the wicked.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Salvation belongs to the LORD.","poem":1},{"text":"May your blessing be on your people. Selah.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"The Hebrew word rendered “God” is “אֱלֹהִ֑ים” (Elohim).","reference":{"chapter":3,"verse":2}}]},"thisChapterLink":"/api/eng_webu/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webu/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webu/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}