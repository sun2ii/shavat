{"translation":{"id":"eng_webu","name":"World English Bible Updated","website":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseNotes":null,"shortName":"WEBU","englishName":"World English Bible Updated","language":"eng","textDirection":"ltr","sha256":"16dfbd077e6fadc53ba621379619a7d15a21c318d6ff2b705a392e6dad66582f","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_webu","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"9f71bd5dc0e5972ca263a0723e8791d728b4396f098756375c52380beb035727","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Vindicate me, God, and plead my cause against an ungodly nation.","poem":1},{"text":"Oh, deliver me from deceitful and wicked men.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"For you are the God of my strength. Why have you rejected me?","poem":1},{"text":"Why do I go mourning because of the oppression of the enemy?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Oh, send out your light and your truth.","poem":1},{"text":"Let them lead me.","poem":2},{"lineBreak":true},{"text":"Let them bring me to your holy hill,","poem":2},{"lineBreak":true},{"text":"to your tents.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Then I will go to the altar of God,","poem":1},{"text":"to God, my exceeding joy.","poem":2},{"text":"I will praise you on the harp, God, my God.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Why are you in despair, my soul?","poem":1},{"text":"Why are you disturbed within me?","poem":2},{"text":"Hope in God!","poem":1},{"text":"For I shall still praise him:","poem":2},{"lineBreak":true},{"text":"my Savior, my helper, and my God.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webu/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webu/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webu/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}