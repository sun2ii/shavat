{"translation":{"id":"eng_webu","name":"World English Bible Updated","website":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseNotes":null,"shortName":"WEBU","englishName":"World English Bible Updated","language":"eng","textDirection":"ltr","sha256":"16dfbd077e6fadc53ba621379619a7d15a21c318d6ff2b705a392e6dad66582f","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_webu","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"9f71bd5dc0e5972ca263a0723e8791d728b4396f098756375c52380beb035727","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician. By the sons of Korah. According to Alamoth.",{"noteId":19}]},{"type":"verse","number":1,"content":[{"text":"God is our refuge and strength,","poem":1},{"text":"a very present help in trouble.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Therefore we won’t be afraid, though the earth changes,","poem":1},{"text":"though the mountains are shaken into the heart of the seas;","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"though its waters roar and are troubled,","poem":2},{"lineBreak":true},{"text":"though the mountains tremble with their swelling. Selah.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"There is a river, the streams of which make the city of God glad,","poem":1},{"text":"the holy place of the tents of the Most High.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"God is within her. She shall not be moved.","poem":1},{"text":"God will help her at dawn.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"The nations raged. The kingdoms were moved.","poem":1},{"text":"He lifted his voice and the earth melted.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"The LORD of Armies is with us.","poem":1},{"text":"The God of Jacob is our refuge. Selah.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Come, see the LORD’s works,","poem":1},{"text":"what desolations he has made in the earth.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"He makes wars cease to the end of the earth.","poem":1},{"text":"He breaks the bow, and shatters the spear.","poem":2},{"lineBreak":true},{"text":"He burns the chariots in the fire.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Be still, and know that I am God.","poem":1},{"text":"I will be exalted among the nations.","poem":2},{"lineBreak":true},{"text":"I will be exalted in the earth.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"The LORD of Armies is with us.","poem":1},{"text":"The God of Jacob is our refuge. Selah.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":19,"caller":"+","text":"Alamoth is a musical term.","reference":{"chapter":46,"verse":0}}]},"thisChapterLink":"/api/eng_webu/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webu/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webu/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}