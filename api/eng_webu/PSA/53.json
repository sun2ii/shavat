{"translation":{"id":"eng_webu","name":"World English Bible Updated","website":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseNotes":null,"shortName":"WEBU","englishName":"World English Bible Updated","language":"eng","textDirection":"ltr","sha256":"16dfbd077e6fadc53ba621379619a7d15a21c318d6ff2b705a392e6dad66582f","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_webu","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"9f71bd5dc0e5972ca263a0723e8791d728b4396f098756375c52380beb035727","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":53,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician. To the tune of “Mahalath.” A contemplation by David."]},{"type":"verse","number":1,"content":[{"text":"The fool has said in his heart, “There is no God.”","poem":1},{"text":"They are corrupt, and have done abominable iniquity.","poem":2},{"lineBreak":true},{"text":"There is no one who does good.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"God looks down from heaven on the children of men,","poem":1},{"text":"to see if there are any who understood,","poem":2},{"lineBreak":true},{"text":"who seek after God.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Every one of them has gone back.","poem":1},{"text":"They have become filthy together.","poem":2},{"lineBreak":true},{"text":"There is no one who does good, no, not one.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Have the workers of iniquity no knowledge,","poem":1},{"text":"who eat up my people as they eat bread,","poem":2},{"lineBreak":true},{"text":"and don’t call on God?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"There they were in great fear, where no fear was,","poem":1},{"text":"for God has scattered the bones of him who encamps against you.","poem":2},{"text":"You have put them to shame,","poem":1},{"text":"because God has rejected them.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Oh that the salvation of Israel would come out of Zion!","poem":1},{"text":"When God brings back his people from captivity,","poem":2},{"lineBreak":true},{"text":"then Jacob shall rejoice,","poem":2},{"lineBreak":true},{"text":"and Israel shall be glad.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webu/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webu/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webu/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}