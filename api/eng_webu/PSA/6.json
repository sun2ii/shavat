{"translation":{"id":"eng_webu","name":"World English Bible Updated","website":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseNotes":null,"shortName":"WEBU","englishName":"World English Bible Updated","language":"eng","textDirection":"ltr","sha256":"16dfbd077e6fadc53ba621379619a7d15a21c318d6ff2b705a392e6dad66582f","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_webu","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"9f71bd5dc0e5972ca263a0723e8791d728b4396f098756375c52380beb035727","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":6,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician; on stringed instruments, upon the eight-stringed lyre. A Psalm by David."]},{"type":"verse","number":1,"content":[{"text":"LORD, don’t rebuke me in your anger,","poem":1},{"text":"neither discipline me in your wrath.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Have mercy on me, LORD, for I am faint.","poem":1},{"text":"LORD, heal me, for my bones are troubled.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"My soul is also in great anguish.","poem":1},{"text":"But you, LORD—how long?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Return, LORD. Deliver my soul,","poem":1},{"text":"and save me for your loving kindness’ sake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"For in death there is no memory of you.","poem":1},{"text":"In Sheol,","poem":2},{"noteId":5},{"text":"who shall give you thanks?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I am weary with my groaning.","poem":1},{"text":"Every night I flood my bed.","poem":2},{"lineBreak":true},{"text":"I drench my couch with my tears.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"My eye wastes away because of grief.","poem":1},{"text":"It grows old because of all my adversaries.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Depart from me, all you workers of iniquity,","poem":1},{"text":"for the LORD has heard the voice of my weeping.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"The LORD has heard my supplication.","poem":1},{"text":"The LORD accepts my prayer.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"May all my enemies be ashamed and dismayed.","poem":1},{"text":"They shall turn back, they shall be disgraced suddenly.","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"Sheol is the place of the dead.","reference":{"chapter":6,"verse":5}}]},"thisChapterLink":"/api/eng_webu/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webu/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webu/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}