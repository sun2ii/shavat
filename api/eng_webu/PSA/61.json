{"translation":{"id":"eng_webu","name":"World English Bible Updated","website":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseNotes":null,"shortName":"WEBU","englishName":"World English Bible Updated","language":"eng","textDirection":"ltr","sha256":"16dfbd077e6fadc53ba621379619a7d15a21c318d6ff2b705a392e6dad66582f","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_webu","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"9f71bd5dc0e5972ca263a0723e8791d728b4396f098756375c52380beb035727","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician. For a stringed instrument. By David."]},{"type":"verse","number":1,"content":[{"text":"Hear my cry, God.","poem":1},{"text":"Listen to my prayer.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"From the end of the earth, I will call to you when my heart is overwhelmed.","poem":1},{"text":"Lead me to the rock that is higher than I.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"For you have been a refuge for me,","poem":1},{"text":"a strong tower from the enemy.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I will dwell in your tent forever.","poem":1},{"text":"I will take refuge in the shelter of your wings. Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"For you, God, have heard my vows.","poem":1},{"text":"You have given me the heritage of those who fear your name.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"You will prolong the king’s life.","poem":1},{"text":"His years will be for generations.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"He shall be enthroned in God’s presence forever.","poem":1},{"text":"Appoint your loving kindness and truth, that they may preserve him.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"So I will sing praise to your name forever,","poem":1},{"text":"that I may fulfill my vows daily.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webu/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webu/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webu/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}