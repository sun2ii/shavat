{"translation":{"id":"eng_webu","name":"World English Bible Updated","website":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseNotes":null,"shortName":"WEBU","englishName":"World English Bible Updated","language":"eng","textDirection":"ltr","sha256":"16dfbd077e6fadc53ba621379619a7d15a21c318d6ff2b705a392e6dad66582f","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_webu","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"9f71bd5dc0e5972ca263a0723e8791d728b4396f098756375c52380beb035727","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician. A Psalm by David."]},{"type":"verse","number":1,"content":[{"text":"Hear my voice, God, in my complaint.","poem":1},{"text":"Preserve my life from fear of the enemy.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hide me from the conspiracy of the wicked,","poem":1},{"text":"from the noisy crowd of the ones doing evil;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"who sharpen their tongue like a sword,","poem":1},{"text":"and aim their arrows, deadly words,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"to shoot innocent men from ambushes.","poem":2},{"lineBreak":true},{"text":"They shoot at him suddenly and fearlessly.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"They encourage themselves in evil plans.","poem":1},{"text":"They talk about laying snares secretly.","poem":2},{"lineBreak":true},{"text":"They say, “Who will see them?”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"They plot injustice, saying, “We have made a perfect plan!”","poem":1},{"text":"Surely man’s mind and heart are cunning.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"But God will shoot at them.","poem":1},{"text":"They will be suddenly struck down with an arrow.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Their own tongues shall ruin them.","poem":1},{"text":"All who see them will shake their heads.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"All mankind shall be afraid.","poem":1},{"text":"They shall declare the work of God,","poem":2},{"lineBreak":true},{"text":"and shall wisely ponder what he has done.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"The righteous shall be glad in the LORD,","poem":1},{"text":"and shall take refuge in him.","poem":2},{"lineBreak":true},{"text":"All the upright in heart shall praise him!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webu/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webu/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webu/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}