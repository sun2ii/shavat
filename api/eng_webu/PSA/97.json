{"translation":{"id":"eng_webu","name":"World English Bible Updated","website":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebu","licenseNotes":null,"shortName":"WEBU","englishName":"World English Bible Updated","language":"eng","textDirection":"ltr","sha256":"16dfbd077e6fadc53ba621379619a7d15a21c318d6ff2b705a392e6dad66582f","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_webu","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"9f71bd5dc0e5972ca263a0723e8791d728b4396f098756375c52380beb035727","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"The LORD reigns!","poem":1},{"text":"Let the earth rejoice!","poem":2},{"lineBreak":true},{"text":"Let the multitude of islands be glad!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Clouds and darkness are around him.","poem":1},{"text":"Righteousness and justice are the foundation of his throne.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"A fire goes before him,","poem":1},{"text":"and burns up his adversaries on every side.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"His lightning lights up the world.","poem":1},{"text":"The earth sees, and trembles.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"The mountains melt like wax at the presence of the LORD,","poem":1},{"text":"at the presence of the Lord of the whole earth.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"The heavens declare his righteousness.","poem":1},{"text":"All the peoples have seen his glory.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Let all them be shamed who serve engraved images,","poem":1},{"text":"who boast in their idols.","poem":2},{"lineBreak":true},{"text":"Worship him, all you gods!","poem":2},{"noteId":44}]},{"type":"verse","number":8,"content":[{"text":"Zion heard and was glad.","poem":1},{"text":"The daughters of Judah rejoiced","poem":2},{"lineBreak":true},{"text":"because of your judgments, LORD.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"For you, LORD, are most high above all the earth.","poem":1},{"text":"You are exalted far above all gods.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"You who love the LORD, hate evil!","poem":1},{"text":"He preserves the souls of his saints.","poem":2},{"lineBreak":true},{"text":"He delivers them out of the hand of the wicked.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Light is sown for the righteous,","poem":1},{"text":"and gladness for the upright in heart.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Be glad in the LORD, you righteous people!","poem":1},{"text":"Give thanks to his holy Name.","poem":2}]}],"footnotes":[{"noteId":44,"caller":"+","text":"LXX reads “angels” instead of “gods”.","reference":{"chapter":97,"verse":7}}]},"thisChapterLink":"/api/eng_webu/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webu/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webu/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}