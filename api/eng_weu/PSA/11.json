rve.","poem":1},{"text":"His eyes examine the children of men.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"The LORD examines the righteous,","poem":1},{"text":"but his soul hates the wicked and him who loves violence.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"On the wicked he will rain blazing coals;","poem":1},{"text":"fire, sulphur, and scorching wind shall be the portion of their cup.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"For the LORD is righteous.","poem":1},{"text":"He loves righteousness.","poem":2},{"lineBreak":true},{"text":"The upright shall see his face.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_weu/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_weu/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_weu/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}