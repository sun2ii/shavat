]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"who stoops down to see in heaven and in the earth?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"He raises up the poor out of the dust,","poem":1},{"text":"and lifts up the needy from the ash heap,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"that he may set him with princes,","poem":1},{"text":"even with the princes of his people.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"He settles the barren woman in her home","poem":1},{"text":"as a joyful mother of children.","poem":2},{"text":"Praise the LORD!","poem":1},{"noteId":64}]}],"footnotes":[{"noteId":62,"caller":"+","text":"Hebrew: יה Yah","reference":{"chapter":113,"verse":1}},{"noteId":63,"caller":"+","text":"LORD or GOD in all caps is from the Hebrew יהוה‎ Yahweh except when otherwise noted as being from the short form יה Yah.","reference":{"chapter":113,"verse":1}},{"noteId":64,"caller":"+","text":"Hebrew: יה Yah","reference":{"chapter":113,"verse":9}}]},"thisChapterLink":"/api/eng_weu/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_weu/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_weu/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}