e},{"text":"and may you see the good of Jerusalem all the days of your life.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yes, may you see your children’s children.","poem":1},{"text":"Peace be upon Israel.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_weu/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_weu/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_weu/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}