em":2},{"lineBreak":true},{"text":"lest my adversaries rejoice when I fall.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"But I trust in your loving kindness.","poem":1},{"text":"My heart rejoices in your salvation.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I will sing to the LORD,","poem":1},{"text":"because he has been good to me.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_weu/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_weu/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_weu/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}