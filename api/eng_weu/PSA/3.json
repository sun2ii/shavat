{"translation":{"id":"eng_weu","name":"World English Bible British Edition with Deuterocanon","website":"https://ebible.org/Scriptures/details.php?id=eng-webbe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-webbe","licenseNotes":null,"shortName":"WEBBE","englishName":"World English Bible British Edition with Deuterocanon","language":"eng","textDirection":"ltr","sha256":"7d481dc14dfb1d15e35b52ff8258d7d388d8cb008c6ebfe87acba511d92653e9","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_weu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_weu","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"62b91b2bae6ee89d47660a102612539488511d6b25f2e65f0efb7731fef527f3","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_weu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_weu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["A Psalm by David, when he fled from Absalom his son."]},{"type":"verse","number":1,"content":[{"text":"LORD, how my adversaries have increased!","poem":1},{"text":"Many are those who rise up against me.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Many there are who say of my soul,","poem":1},{"text":"“There is no help for him in God.”","poem":2},{"noteId":4},{"text":"Selah.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"But you, LORD, are a shield around me,","poem":1},{"text":"my glory, and the one who lifts up my head.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I cry to the LORD with my voice,","poem":1},{"text":"and he answers me out of his holy hill. Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I laid myself down and slept.","poem":1},{"text":"I awakened, for the LORD sustains me.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I will not be afraid of tens of thousands of people","poem":1},{"text":"who have set themselves against me on every side.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Arise, LORD!","poem":1},{"text":"Save me, my God!","poem":2},{"text":"For you have struck all of my enemies on the cheek bone.","poem":1},{"text":"You have broken the teeth of the wicked.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Salvation belongs to the LORD.","poem":1},{"text":"May your blessing be on your people. Selah.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"The Hebrew word rendered “God” is “אֱלֹהִ֑ים” (Elohim).","reference":{"chapter":3,"verse":2}}]},"thisChapterLink":"/api/eng_weu/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_weu/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_weu/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}