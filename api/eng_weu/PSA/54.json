{"translation":{"id":"eng_weu","name":"World English Bible British Edition with Deuterocanon","website":"https://ebible.org/Scriptures/details.php?id=eng-webbe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-webbe","licenseNotes":null,"shortName":"WEBBE","englishName":"World English Bible British Edition with Deuterocanon","language":"eng","textDirection":"ltr","sha256":"7d481dc14dfb1d15e35b52ff8258d7d388d8cb008c6ebfe87acba511d92653e9","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_weu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_weu","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"62b91b2bae6ee89d47660a102612539488511d6b25f2e65f0efb7731fef527f3","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_weu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_weu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician. On stringed instruments. A contemplation by David, when the Ziphites came and said to Saul, “Isn’t David hiding himself amongst us?”"]},{"type":"verse","number":1,"content":[{"text":"Save me, God, by your name.","poem":1},{"text":"Vindicate me in your might.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hear my prayer, God.","poem":1},{"text":"Listen to the words of my mouth.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"For strangers have risen up against me.","poem":1},{"text":"Violent men have sought after my soul.","poem":2},{"lineBreak":true},{"text":"They haven’t set God before them. Selah.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Behold, God is my helper.","poem":1},{"text":"The Lord is the one who sustains my soul.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"He will repay the evil to my enemies.","poem":1},{"text":"Destroy them in your truth.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"With a free will offering, I will sacrifice to you.","poem":1},{"text":"I will give thanks to your name, LORD, for it is good.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"For he has delivered me out of all trouble.","poem":1},{"text":"My eye has seen triumph over my enemies.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_weu/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_weu/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_weu/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}