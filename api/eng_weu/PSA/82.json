{"translation":{"id":"eng_weu","name":"World English Bible British Edition with Deuterocanon","website":"https://ebible.org/Scriptures/details.php?id=eng-webbe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-webbe","licenseNotes":null,"shortName":"WEBBE","englishName":"World English Bible British Edition with Deuterocanon","language":"eng","textDirection":"ltr","sha256":"7d481dc14dfb1d15e35b52ff8258d7d388d8cb008c6ebfe87acba511d92653e9","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_weu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_weu","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"62b91b2bae6ee89d47660a102612539488511d6b25f2e65f0efb7731fef527f3","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_weu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_weu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["A Psalm by Asaph."]},{"type":"verse","number":1,"content":[{"text":"God presides in the great assembly.","poem":1},{"text":"He judges amongst the gods.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“How long will you judge unjustly,","poem":1},{"text":"and show partiality to the wicked?” Selah.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Defend the weak, the poor, and the fatherless.","poem":1},{"text":"Maintain the rights of the poor and oppressed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Rescue the weak and needy.","poem":1},{"text":"Deliver them out of the hand of the wicked.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"They don’t know, neither do they understand.","poem":1},{"text":"They walk back and forth in darkness.","poem":2},{"lineBreak":true},{"text":"All the foundations of the earth are shaken.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I said, “You are gods,","poem":1},{"text":"all of you are sons of the Most High.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nevertheless you shall die like men,","poem":1},{"text":"and fall like one of the rulers.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Arise, God, judge the earth,","poem":1},{"text":"for you inherit all of the nations.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_weu/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_weu/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_weu/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}