{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"JOB","translationId":"epo_bfb","name":"Ijob","commonName":"Ijob","title":"LIBRO DE IJOB","order":18,"numberOfChapters":42,"sha256":"b5c5636460c4664aac5589695d4e2f0280d05dc5adefe8ab507502dd14eeea64","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/epo_bfb/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"Mia spirito senfortiĝis, miaj tagoj mallongiĝis,","poem":1},{"lineBreak":true},{"text":"Tomboj estas antaŭ mi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mokado min ĉirkaŭas;","poem":1},{"lineBreak":true},{"text":"En aflikto pro tio restas mia okulo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Estu Vi mem mia garantianto antaŭ Vi;","poem":1},{"lineBreak":true},{"text":"Alie kiu donos la manon pro mi?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ĉar ilian koron Vi kovris kontraŭ prudento;","poem":1},{"lineBreak":true},{"text":"Tial Vi ne donos al ili triumfon.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Se iu fanfaronas antaŭ siaj amikoj pri sia parto,","poem":1},{"lineBreak":true},{"text":"La okuloj de liaj infanoj konsumiĝos.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Li faris min proverbo por la popoloj;","poem":1},{"lineBreak":true},{"text":"Kaj mi fariĝis homo, al kiu oni kraĉas en la vizaĝon.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mia okulo mallumiĝis de ĉagreno,","poem":1},{"lineBreak":true},{"text":"Kaj ĉiuj miaj membroj fariĝis kiel ombro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"La justuloj eksentos teruron pro tio,","poem":1},{"lineBreak":true},{"text":"Kaj la senkulpulo ekscitiĝos kontraŭ la hipokritulo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tamen la virtulo forte konservos sian vojon,","poem":1},{"lineBreak":true},{"text":"Kaj la purmanulo pli firmiĝos.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kaj kiom ajn vi ĉiuj revenos,","poem":1},{"lineBreak":true},{"text":"Mi ne trovos inter vi saĝulon.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Miaj tagoj forpasis, pereis miaj intencoj,","poem":1},{"lineBreak":true},{"text":"Kiujn havis mia koro.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"La nokton ili volas fari tago,","poem":1},{"lineBreak":true},{"text":"La lumon alproksimigi al la mallumo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Se mi atendas, tamen Ŝeol estas mia domo,","poem":1},{"lineBreak":true},{"text":"En la mallumo estas pretigita mia lito.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Al la kavo mi diras: Vi estas mia patro;","poem":1},{"lineBreak":true},{"text":"La vermojn mi nomas mia patrino kaj mia fratino.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kion mi devas atendi?","poem":1},{"lineBreak":true},{"text":"Kiu atentos mian esperon?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"En la profundon de Ŝeol ĝi malsupreniros,","poem":1},{"lineBreak":true},{"text":"Ni ambaŭ kune kuŝos en la polvo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}