{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"JOB","translationId":"epo_bfb","name":"Ijob","commonName":"Ijob","title":"LIBRO DE IJOB","order":18,"numberOfChapters":42,"sha256":"b5c5636460c4664aac5589695d4e2f0280d05dc5adefe8ab507502dd14eeea64","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/epo_bfb/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":["Ekparolis Bildad, la Ŝuĥano, kaj diris:"]},{"type":"verse","number":2,"content":[{"text":"Kiam vi ĉesos ĵetadi vortojn?","poem":1},{"lineBreak":true},{"text":"Pripensu, kaj poste ni parolos.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kial ni estu rigardataj kiel brutoj,","poem":1},{"lineBreak":true},{"text":"Kaj ni estu malpuruloj en viaj okuloj?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ho vi, kiu disŝiras sian animon en sia kolero,","poem":1},{"lineBreak":true},{"text":"Ĉu por vi estu forlasata la tero,","poem":1},{"lineBreak":true},{"text":"Kaj roko forŝoviĝu de sia loko?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"La lumo de la malpiulo estingiĝos,","poem":1},{"lineBreak":true},{"text":"Kaj ne brilos la flamo de lia fajro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"La lumo mallumiĝos en lia tendo,","poem":1},{"lineBreak":true},{"text":"Kaj lia lucerno super li estingiĝos.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mallongiĝos liaj fortaj paŝoj,","poem":1},{"lineBreak":true},{"text":"Kaj lia propra intenco lin faligos.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ĉar li trafis per siaj piedoj en reton,","poem":1},{"lineBreak":true},{"text":"Kaj li moviĝas en kaptilo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"La maŝo enkroĉigos lian kalkanon,","poem":1},{"lineBreak":true},{"text":"Kaj pereo lin atakos.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kaŝita en la tero estas lia falilo,","poem":1},{"lineBreak":true},{"text":"Kaj kaptiloj kontraŭ li estas sur la vojo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"De ĉiuj flankoj timigos lin teruroj","poem":1},{"lineBreak":true},{"text":"Kaj atakos liajn piedojn.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Malsato konsumos lian forton,","poem":1},{"lineBreak":true},{"text":"Kaj pereo estas preparita por liaj flankoj.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Konsumiĝos la membroj de lia korpo,","poem":1},{"lineBreak":true},{"text":"Liajn membrojn konsumos la unuenaskito de la morto.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Lia espero estos elŝirita el lia tendo,","poem":1},{"lineBreak":true},{"text":"Kaj ĝi pelos lin al la reĝo de teruroj.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nenio restos en lia tendo;","poem":1},{"lineBreak":true},{"text":"Sur lian loĝejon ŝutiĝos sulfuro.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Malsupre sekiĝos liaj radikoj,","poem":1},{"lineBreak":true},{"text":"Kaj supre detranĉiĝos liaj branĉoj.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"La memoro pri li malaperos de sur la tero,","poem":1},{"lineBreak":true},{"text":"Kaj sur la stratoj li ne havos nomon.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Li estos elpelita el lumo en mallumon,","poem":1},{"lineBreak":true},{"text":"Kaj el la mondo li estos elpuŝita.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nek filon nek nepon li havos en sia popolo,","poem":1},{"lineBreak":true},{"text":"Kaj neniu restos ĉe li en lia loĝloko.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"La posteuloj sentos teruron pri lia tago,","poem":1},{"lineBreak":true},{"text":"Kaj la antaŭulojn kaptos timo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tia estas la loĝejo de maljustulo,","poem":1},{"lineBreak":true},{"text":"Kaj tia estas la loko de tiu, kiu ne konas Dion.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}