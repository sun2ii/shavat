{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"JOB","translationId":"epo_bfb","name":"Ijob","commonName":"Ijob","title":"LIBRO DE IJOB","order":18,"numberOfChapters":42,"sha256":"b5c5636460c4664aac5589695d4e2f0280d05dc5adefe8ab507502dd14eeea64","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/epo_bfb/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":["Ijob respondis kaj diris:"]},{"type":"verse","number":2,"content":[{"text":"Eĉ hodiaŭ mia parolado restas maldolĉa;","poem":1},{"lineBreak":true},{"text":"Mia suferado estas pli peza, ol miaj ĝemoj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ho, se mi scius, kiamaniere mi povas Lin trovi,","poem":1},{"lineBreak":true},{"text":"Veni al Lia trono!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mi prezentus al Li juĝan aferon,","poem":1},{"lineBreak":true},{"text":"Kaj mian buŝon mi plenigus per argumentoj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mi ekscius la vortojn, kiujn Li respondus al mi;","poem":1},{"lineBreak":true},{"text":"Mi komprenus, kion Li dirus al mi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ĉu en la grandeco de Sia forto Li luktus kontraŭ mi?","poem":1},{"lineBreak":true},{"text":"Ne, Li nur atentu min;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tiam pravulo procesus kun Li,","poem":1},{"lineBreak":true},{"text":"Kaj mi liberiĝus por ĉiam de mia Juĝanto.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sed jen mi iras antaŭen, kaj Li tie ne estas;","poem":1},{"lineBreak":true},{"text":"Mi iras malantaŭen, kaj mi Lin ne rimarkas;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Se Li faras ion maldekstre, mi Lin ne trovas;","poem":1},{"lineBreak":true},{"text":"Se Li kaŝas Sin dekstre, mi Lin ne vidas.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sed mian vojon Li konas;","poem":1},{"lineBreak":true},{"text":"Se Li min elprovos, mi eliros kiel oro.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sur Lia irejo forte teniĝas mia piedo;","poem":1},{"lineBreak":true},{"text":"Lian vojon mi konservis, kaj ne forkliniĝis.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mi ne deturnas min de la ordonoj de Liaj lipoj;","poem":1},{"lineBreak":true},{"text":"Pli ol mian propran leĝon mi konservis la dirojn de Lia buŝo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sed Li estas sola: kiu kontraŭstaros al Li?","poem":1},{"lineBreak":true},{"text":"Kion Lia animo deziras, tion Li faras.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kio estas destinita por mi, tion Li plenumos;","poem":1},{"lineBreak":true},{"text":"Kaj Li havas multe da similaj aferoj.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tial mi tremas antaŭ Lia vizaĝo,","poem":1},{"lineBreak":true},{"text":"Mi primeditas, kaj mi timas Lin.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dio senkuraĝigis mian koron,","poem":1},{"lineBreak":true},{"text":"Kaj la Plejpotenculo min konfuzis.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ĉar mi ne estas neniigita antaŭ la mallumo,","poem":1},{"lineBreak":true},{"text":"Kaj antaŭ mia vizaĝo Li ne kovris la mallumon.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}