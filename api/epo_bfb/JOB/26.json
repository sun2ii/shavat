{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"JOB","translationId":"epo_bfb","name":"Ijob","commonName":"Ijob","title":"LIBRO DE IJOB","order":18,"numberOfChapters":42,"sha256":"b5c5636460c4664aac5589695d4e2f0280d05dc5adefe8ab507502dd14eeea64","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/epo_bfb/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":["Ijob respondis kaj diris:"]},{"type":"verse","number":2,"content":[{"text":"Kiel vi helpas al tiu, kiu ne havas forton!","poem":1},{"lineBreak":true},{"text":"Kiel vi subtenas tiun, kies brako estas senforta!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kian konsilon vi donas al tiu, kiu ne havas saĝon,","poem":1},{"lineBreak":true},{"text":"Kaj kiel grandan prudenton vi montras!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Al kiu vi parolas vortojn?","poem":1},{"lineBreak":true},{"text":"Kaj kies spirito eliras el vi?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"La mortintoj tremas sub la akvo,","poem":1},{"lineBreak":true},{"text":"Kaj ankaŭ tiuj, kiuj vivas en ĝi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ŝeol estas malkovrita antaŭ Li,","poem":1},{"lineBreak":true},{"text":"Kaj la abismo ne havas kovron.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Li etendis la nordon super la malpleno,","poem":1},{"lineBreak":true},{"text":"Li pendigis la teron sur nenio.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Li ligas la akvon en Siaj nuboj,","poem":1},{"lineBreak":true},{"text":"Kaj nubo ne krevas sub tio.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Li kovras la tronon","poem":1},{"lineBreak":true},{"text":"Kaj etendas ĉirkaŭ ĝi Sian nubon.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Li faris limon sur la akvo,","poem":1},{"lineBreak":true},{"text":"Ĝis la loko, kie finiĝas la lumo kaj la mallumo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"La kolonoj de la ĉielo ŝanceliĝas","poem":1},{"lineBreak":true},{"text":"Kaj tremas de Lia krio.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Per Sia forto Li kvietigas la maron,","poem":1},{"lineBreak":true},{"text":"Kaj per Sia saĝo Li frakasas Rahabon.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Per Lia spirito belegiĝis la ĉielo;","poem":1},{"lineBreak":true},{"text":"Lia mano trapikas la tordiĝantan serpenton.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Jen tio estas parto de Liaj vojoj;","poem":1},{"lineBreak":true},{"text":"Kaj nur iometon ni aŭdis pri Li.","poem":1},{"lineBreak":true},{"text":"Kiu povas kompreni la tondron de Lia potenco?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}