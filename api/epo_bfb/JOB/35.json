{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"JOB","translationId":"epo_bfb","name":"Ijob","commonName":"Ijob","title":"LIBRO DE IJOB","order":18,"numberOfChapters":42,"sha256":"b5c5636460c4664aac5589695d4e2f0280d05dc5adefe8ab507502dd14eeea64","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/epo_bfb/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":["Elihu parolis plue, kaj diris:"]},{"type":"verse","number":2,"content":[{"text":"Ĉu tion vi opinias justa, ke vi diras:","poem":1},{"lineBreak":true},{"text":"Mi estas pli prava ol Dio?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ĉar vi diras: Kiom tio utilas al vi?","poem":1},{"lineBreak":true},{"text":"Kian profiton mi havas kompare kun tiu okazo, se mi pekus?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mi respondos al vi,","poem":1},{"lineBreak":true},{"text":"Kaj kune ankaŭ al viaj amikoj:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rigardu la ĉielon, kaj vidu;","poem":1},{"lineBreak":true},{"text":"Rigardu la nubojn, kiel tro alte ili estas por vi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Se vi pekas, kiom vi malutilas al Li?","poem":1},{"lineBreak":true},{"text":"Kaj se viaj malbonagoj estas multaj, kion vi faras al Li?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Se vi estas virta, kion vi donas al Li?","poem":1},{"lineBreak":true},{"text":"Aŭ kion Li prenas el via mano?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Al homo, simila al vi, povas ion fari via malbonago,","poem":1},{"lineBreak":true},{"text":"Kaj via virteco havas signifon nur por homido.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pro multe da premado oni krias;","poem":1},{"lineBreak":true},{"text":"Oni ĝemas pro la brako de potenculoj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sed oni ne diras: Kie estas Dio, kiu min kreis,","poem":1},{"lineBreak":true},{"text":"Kiu donas kantojn en la nokto,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kiu instruas nin pli ol la brutojn sur la tero,","poem":1},{"lineBreak":true},{"text":"Prudentigas nin pli ol la birdojn de la ĉielo?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tie ili krias pri la fiereco de la malbonuloj,","poem":1},{"lineBreak":true},{"text":"Sed Li ne respondas.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tamen malvere estas, ke Dio ne aŭdas","poem":1},{"lineBreak":true},{"text":"Kaj ke la Plejpotenculo ne vidas.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kvankam vi diras, ke vi Lin ne vidas,","poem":1},{"lineBreak":true},{"text":"Ekzistas tamen juĝo ĉe Li;","poem":1},{"lineBreak":true},{"text":"Kaj vi atendu Lin.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sed ĉar Li nun ne montras Sian koleron","poem":1},{"lineBreak":true},{"text":"Kaj ne atentas la tro grandan malvirtecon,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tial Ijob vante malfermis sian buŝon","poem":1},{"lineBreak":true},{"text":"Kaj tre multe parolas malprudente.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}