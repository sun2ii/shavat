{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"JOB","translationId":"epo_bfb","name":"Ijob","commonName":"Ijob","title":"LIBRO DE IJOB","order":18,"numberOfChapters":42,"sha256":"b5c5636460c4664aac5589695d4e2f0280d05dc5adefe8ab507502dd14eeea64","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/epo_bfb/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["Kaj ekparolis Bildad, la Ŝuĥano, kaj diris:"]},{"type":"verse","number":2,"content":[{"text":"Kiel longe vi tiel parolos,","poem":1},{"lineBreak":true},{"text":"Kaj la vortoj de via buŝo estos kiel forta vento?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ĉu Dio falsas la juĝon?","poem":1},{"lineBreak":true},{"text":"Ĉu la Plejpotenculo falsas la justecon?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Se viaj filoj pekis kontraŭ Li,","poem":1},{"lineBreak":true},{"text":"Li forpuŝis ilin pro ilia malbonago.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Se vi serĉas Dion","poem":1},{"lineBreak":true},{"text":"Kaj petegas la Plejpotenculon,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Se vi estas pura kaj pia,","poem":1},{"lineBreak":true},{"text":"Li maldormos super vi,","poem":1},{"lineBreak":true},{"text":"Kaj restarigos la bonstaton en via virta loĝejo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kaj se via komenco estis malgranda,","poem":1},{"lineBreak":true},{"text":"Via estonteco forte kreskos.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ĉar demandu la antaŭajn generaciojn,","poem":1},{"lineBreak":true},{"text":"Kaj primeditu tion, kion esploris iliaj patroj;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ĉar ni estas de hieraŭ, kaj ni nenion scias;","poem":1},{"lineBreak":true},{"text":"Nia vivo sur la tero estas nur ombro.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ili instruos vin, diros al vi,","poem":1},{"lineBreak":true},{"text":"Kaj el sia koro elirigos vortojn.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ĉu povas kreski kano sen malsekeco?","poem":1},{"lineBreak":true},{"text":"Ĉu kreskas junko sen akvo?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"En tia okazo ĝi velksekiĝas pli frue ol ĉiu herbo,","poem":1},{"lineBreak":true},{"text":"Kiam ĝi estas ankoraŭ en sia freŝeco,","poem":1},{"lineBreak":true},{"text":"Kiam ĝi ankoraŭ ne estas detranĉita.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tiaj estas la vojoj de ĉiuj, kiuj forgesas Dion;","poem":1},{"lineBreak":true},{"text":"Kaj pereas la espero de hipokritulo,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kies fido dehakiĝas,","poem":1},{"lineBreak":true},{"text":"Kaj kies espero estas araneaĵo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Li apogas sin al sia domo, sed ne restos staranta;","poem":1},{"lineBreak":true},{"text":"Li ekkaptos ĝin, sed ne povos sin teni.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Li estis verda antaŭ la suno,","poem":1},{"lineBreak":true},{"text":"Kaj super lia ĝardeno etendiĝas liaj branĉoj;","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Amase plektiĝas liaj radikoj,","poem":1},{"lineBreak":true},{"text":"Inter ŝtonoj ili tenas sin forte;","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Sed kiam oni elŝiras lin el lia loko,","poem":1},{"lineBreak":true},{"text":"Ĝi malkonfesas lin: Mi vin ne vidis.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tia estas la ĝojo de lia vivo;","poem":1},{"lineBreak":true},{"text":"Kaj el la tero kreskas aliaj.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Vidu, Dio ne forpuŝas virtulon","poem":1},{"lineBreak":true},{"text":"Kaj ne subtenas la manon de malpiuloj.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Li plenigos ankoraŭ vian buŝon per rido","poem":1},{"lineBreak":true},{"text":"Kaj viajn lipojn per ĝojkrioj.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Viaj malamantoj kovriĝos per honto;","poem":1},{"lineBreak":true},{"text":"Sed la tendo de malpiuloj malaperos.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}