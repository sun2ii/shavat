{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"JON","translationId":"epo_bfb","name":"Jona","commonName":"Jona","title":"LIBRO DE JONA","order":32,"numberOfChapters":4,"sha256":"eefe96ead53510a879dd57a7c26f3315fe53e7e6c120fecf9063790e1e22fbd5","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/epo_bfb/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Kaj Jona ekpreĝis al la Eternulo, sia Dio, el la interno de la fiŝo."]},{"type":"verse","number":2,"content":["Kaj li diris:",{"text":"Kiam mi suferis, mi vokis al la Eternulo,","poem":1},{"lineBreak":true},{"text":"Kaj Li respondis al mi;","poem":1},{"lineBreak":true},{"text":"El la ventro de ŝeol mi kriis,","poem":1},{"lineBreak":true},{"text":"Kaj Vi aŭskultis mian voĉon.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Vi ĵetis min en la profundegon, en la internon de la maro,","poem":1},{"lineBreak":true},{"text":"Kaj fluego min ĉirkaŭis;","poem":1},{"lineBreak":true},{"text":"Ĉiuj Viaj ondegoj kaj ondoj iris super min.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kaj mi pensis: Mi estas forpuŝita de antaŭ Viaj okuloj;","poem":1},{"lineBreak":true},{"text":"Tamen mi rigardos ankoraŭ Vian sanktan templon.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ĉirkaŭis min akvo ĝis la animo;","poem":1},{"lineBreak":true},{"text":"Abismo min ĉirkaŭis;","poem":1},{"lineBreak":true},{"text":"Junko kovris mian kapon.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mi falis malsupren ĝis la fundamento de la montoj;","poem":1},{"lineBreak":true},{"text":"La tero baris min por ĉiam per siaj rigliloj;","poem":1},{"lineBreak":true},{"text":"Sed Vi, ho Eternulo, mia Dio, elirigis mian vivon el la pereo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kiam mia animo senfortiĝis en mi, mi rememoris la Eternulon;","poem":1},{"lineBreak":true},{"text":"Kaj mia preĝo alvenis al Vi en Vian sanktan templon.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tiuj, kiuj servas al vantaĵoj,","poem":1},{"lineBreak":true},{"text":"Senigas sin je favorkoreco.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sed mi kun danka voĉo alportos al Vi oferon;","poem":1},{"lineBreak":true},{"text":"Kion mi promesis, tion mi plenumos;","poem":1},{"lineBreak":true},{"text":"Savo estas ĉe la Eternulo.","poem":1}]},{"type":"verse","number":10,"content":["Kaj la Eternulo ordonis al la fiŝo, kaj ĝi elvomis Jonan sur la sekteron."]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}