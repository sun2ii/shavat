{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"LAM","translationId":"epo_bfb","name":"Plorkanto","commonName":"Plorkanto","title":"PLORKANTO DE JEREMIA","order":25,"numberOfChapters":5,"sha256":"772fddc32a54bb954b26b47d1d0ac1e8a5148eae2d222f3320bb27854a4a2586","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/epo_bfb/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Rememoru, ho Eternulo, kio fariĝis al ni;","poem":1},{"lineBreak":true},{"text":"Rigardu kaj vidu nian malhonoron!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nia heredaĵo transiris al fremduloj,","poem":1},{"lineBreak":true},{"text":"Niaj domoj al aligentuloj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ni fariĝis orfoj senpatraj,","poem":1},{"lineBreak":true},{"text":"Niaj patrinoj estas kiel vidvinoj.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nian akvon ni trinkas pro mono;","poem":1},{"lineBreak":true},{"text":"Nian lignon ni ricevas nur pro pago.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Oni pelas nin je nia kolo;","poem":1},{"lineBreak":true},{"text":"Ni laciĝis, sed oni ne permesas al ni ripozi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Al Egiptujo ni etendis la manon,","poem":1},{"lineBreak":true},{"text":"Al Asirio, por satiĝi per pano.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Niaj patroj pekis, sed ili jam ne ekzistas;","poem":1},{"lineBreak":true},{"text":"Kaj ni devas suferi pro iliaj malbonagoj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sklavoj regas super ni;","poem":1},{"lineBreak":true},{"text":"Kaj neniu liberigas nin el iliaj manoj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kun danĝero por nia vivo ni akiras nian panon,","poem":1},{"lineBreak":true},{"text":"Pro la glavo en la dezerto.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nia haŭto varmegiĝis kiel forno,","poem":1},{"lineBreak":true},{"text":"Por la kruela malsato.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"La virinojn en Cion ili senhonorigis,","poem":1},{"lineBreak":true},{"text":"La virgulinojn en la urboj de Judujo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"La princoj estas pendigitaj je siaj manoj;","poem":1},{"lineBreak":true},{"text":"La maljunulojn oni ne respektis.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"La junuloj devas porti muelŝtonojn;","poem":1},{"lineBreak":true},{"text":"La knaboj falas sub la lignoŝarĝoj.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"La maljunuloj jam ne sidas ĉe la pordegoj,","poem":1},{"lineBreak":true},{"text":"La junuloj jam ne kantas.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Malaperis la gajeco de nia koro;","poem":1},{"lineBreak":true},{"text":"Niaj dancrondoj aliformiĝis en funebron.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Defalis la krono de nia kapo;","poem":1},{"lineBreak":true},{"text":"Ho ve al ni, ke ni pekis!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Pro tio senfortiĝis nia koro,","poem":1},{"lineBreak":true},{"text":"Pro tio senlumiĝis niaj okuloj:","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Pro la monto Cion, ke ĝi fariĝis dezerta,","poem":1},{"lineBreak":true},{"text":"Ke vulpoj vagas sur ĝi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Sed Vi, ho Eternulo, kiu restas eterne","poem":1},{"lineBreak":true},{"text":"Kaj kies trono staras de generacio al generacio,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kial Vi forgesis nin kvazaŭ por eterne,","poem":1},{"lineBreak":true},{"text":"Forlasis nin por longa tempo?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Reirigu nin, ho Eternulo, al Vi, ke ni revenu;","poem":1},{"lineBreak":true},{"text":"Renovigu niajn tagojn kiel en la tempo antaŭa.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ĉar ĉu Vi nin tute forpuŝis?","poem":1},{"lineBreak":true},{"text":"Vi tre forte ekkoleris kontraŭ ni.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}