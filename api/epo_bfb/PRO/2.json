{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PRO","translationId":"epo_bfb","name":"Sentencoj","commonName":"Sentencoj","title":"LA SENTENCOJ DE SALOMONO","order":20,"numberOfChapters":31,"sha256":"96fe4665b530bb1eb9c647c9fc9e8264d7f84038ee9d805f78468538d86cf791","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/epo_bfb/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Mia filo! se vi akceptos miajn parolojn","poem":1},{"lineBreak":true},{"text":"Kaj konservos ĉe vi miajn ordonojn,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ke via orelo atente aŭskultos saĝon","poem":1},{"lineBreak":true},{"text":"Kaj vian koron vi inklinigos al komprenado;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Se vi vokos la prudenton","poem":1},{"lineBreak":true},{"text":"Kaj direktos vian voĉon al la saĝo:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Se vi serĉos ĝin kiel arĝenton,","poem":1},{"lineBreak":true},{"text":"Serĉegos kiel trezoron:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tiam vi komprenos la timon antaŭ la Eternulo,","poem":1},{"lineBreak":true},{"text":"Kaj vi akiros konadon pri Dio.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ĉar la Eternulo donas saĝon;","poem":1},{"lineBreak":true},{"text":"El Lia buŝo venas scio kaj kompreno.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Li havas helpon por la virtuloj;","poem":1},{"lineBreak":true},{"text":"Li estas ŝildo por tiuj, kiuj vivas pie.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Li gardas la iradon de la justo,","poem":1},{"lineBreak":true},{"text":"Kaj zorgas pri la vojo de Siaj piuloj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tiam vi komprenos veremon kaj juston","poem":1},{"lineBreak":true},{"text":"Kaj pion kaj ĉiun bonan vojon.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ĉar saĝo venos en vian koron,","poem":1},{"lineBreak":true},{"text":"Kaj scio estos agrabla por via animo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bona konscio vin gvidos,","poem":1},{"lineBreak":true},{"text":"Prudento vin gardos,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Por savi vin de la vojo de malbono,","poem":1},{"lineBreak":true},{"text":"De homo, parolanta kontraŭveraĵon,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"De tiuj, kiuj forlasas la ĝustan vojon,","poem":1},{"lineBreak":true},{"text":"Por iri la vojojn de mallumo,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kiuj ĝojas, kiam ili faras malbonon,","poem":1},{"lineBreak":true},{"text":"Trovas plezuron en la malordo de la malboneco,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kies vojoj estas malrektaj","poem":1},{"lineBreak":true},{"text":"Kaj kies irado deflankiĝis;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Por savi vin de fremda virino,","poem":1},{"lineBreak":true},{"text":"De edzino ne via, kies paroloj estas glataj,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kiu forlasas la amikon de sia juneco,","poem":1},{"lineBreak":true},{"text":"Kaj forgesas la ligon de sia Dio;","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ĉar ŝia domo kondukas al morto,","poem":1},{"lineBreak":true},{"text":"Kaj ŝiaj paŝoj al la inferuloj;","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ĉiuj, kiuj eniras al ŝi, ne revenas,","poem":1},{"lineBreak":true},{"text":"Kaj ne reatingas la vojon de la vivo;","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ke vi iru la vojon de bonuloj,","poem":1},{"lineBreak":true},{"text":"Kaj sekvu la paŝosignojn de piuloj.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ĉar la piuloj loĝos sur la tero,","poem":1},{"lineBreak":true},{"text":"Kaj la senpekuloj restos sur ĝi;","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Sed la malpiuloj estos ekstermitaj de sur la tero,","poem":1},{"lineBreak":true},{"text":"Kaj la maliculoj estos malaperigitaj de tie.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}