{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PRO","translationId":"epo_bfb","name":"Sentencoj","commonName":"Sentencoj","title":"LA SENTENCOJ DE SALOMONO","order":20,"numberOfChapters":31,"sha256":"96fe4665b530bb1eb9c647c9fc9e8264d7f84038ee9d805f78468538d86cf791","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/epo_bfb/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"La saĝo konstruis sian domon,","poem":1},{"lineBreak":true},{"text":"Ĉarpentis ĝiajn sep kolonojn.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ĝi buĉis sian bruton, verŝis sian vinon,","poem":1},{"lineBreak":true},{"text":"Kaj pretigis sian tablon.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ĝi sendis siajn servantinojn,","poem":1},{"lineBreak":true},{"text":"Por anonci sur la pintoj de la altaĵoj de la urbo:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kiu estas naiva, tiu sin turnu ĉi tien!","poem":1},{"lineBreak":true},{"text":"Al la senspritulo ĝi diris:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Venu, manĝu de mia pano,","poem":1},{"lineBreak":true},{"text":"Kaj trinku el la vino, kiun mi enverŝis.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Forlasu la malsaĝaĵon, kaj vivu;","poem":1},{"lineBreak":true},{"text":"Kaj iru laŭ la vojo de la prudento.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kiu instruas blasfemanton, tiu prenas sur sin malhonoron;","poem":1},{"lineBreak":true},{"text":"Kaj kiu penas ĝustigi malpiulon, tiu estas mokata.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ne penu ĝustigi blasfemanton, ke li vin ne malamu:","poem":1},{"lineBreak":true},{"text":"Penu ĝustigi saĝulon, kaj li vin amos.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Donu al saĝulo, kaj li ankoraŭ pli saĝiĝos;","poem":1},{"lineBreak":true},{"text":"Instruu justulon, kaj li lernos pli.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"La komenco de la saĝo estas timo antaŭ la Eternulo;","poem":1},{"lineBreak":true},{"text":"Kaj ekkono pri la Sanktulo estas prudento.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ĉar per mi plimultiĝos viaj tagoj,","poem":1},{"lineBreak":true},{"text":"Kaj aldoniĝos al vi jaroj da vivo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Se vi saĝiĝis, vi saĝiĝis por vi;","poem":1},{"lineBreak":true},{"text":"Kaj se vi blasfemas, vi sola suferos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Virino malsaĝa, bruema,","poem":1},{"lineBreak":true},{"text":"Sensprita, kaj nenion scianta,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sidas ĉe la pordo de sia domo,","poem":1},{"lineBreak":true},{"text":"Sur seĝo sur altaĵo de la urbo,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Por voki la pasantojn,","poem":1},{"lineBreak":true},{"text":"Kiuj iras sian ĝustan vojon:","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kiu estas naiva, tiu sin turnu ĉi tien!","poem":1},{"lineBreak":true},{"text":"Kaj al la senspritulo ŝi diris:","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Akvoj ŝtelitaj estas dolĉaj,","poem":1},{"lineBreak":true},{"text":"Kaj pano kaŝita estas agrabla.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kaj li ne scias, ke tie estas mortintoj","poem":1},{"lineBreak":true},{"text":"Kaj ke ŝiaj invititoj estas en la profundoj de Ŝeol.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}