{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Feliĉa estas la homo, kiu ne iras laŭ konsilo de malpiuloj,","poem":1},{"lineBreak":true},{"text":"Nek staras sur vojo de pekuloj,","poem":1},{"lineBreak":true},{"text":"Nek sidas en kunsido de blasfemantoj;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sed li nur havas deziron por la leĝo de la Eternulo,","poem":1},{"lineBreak":true},{"text":"Kaj pri Lia leĝo li pensas tage kaj nokte.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kaj li estos kiel arbo, plantita apud akvaj torentoj,","poem":1},{"lineBreak":true},{"text":"Donanta sian frukton en sia tempo,","poem":1},{"lineBreak":true},{"text":"Kaj kies folio ne velkas;","poem":1},{"lineBreak":true},{"text":"Kaj en ĉio, kion li faras, li sukcesos.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ne tiel estas la malpiuloj;","poem":1},{"lineBreak":true},{"text":"Sed ili estas kiel grenventumaĵo, kiun disblovas la vento.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tial ne staros fortike la malpiuloj ĉe la juĝo,","poem":1},{"lineBreak":true},{"text":"Nek la pekuloj en societo de piuloj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ĉar la Eternulo konas la vojon de piuloj;","poem":1},{"lineBreak":true},{"text":"Sed la vojo de malpiuloj pereos.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}