{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["Psalmo de David."]},{"type":"verse","number":1,"content":[{"text":"Bonecon kaj justecon mi prikantos;","poem":1},{"lineBreak":true},{"text":"Al Vi, ho Eternulo, mi muzikos.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mi penas iri prudente la vojon de pieco;","poem":1},{"lineBreak":true},{"text":"Kiam Vi venos al mi?","poem":1},{"lineBreak":true},{"text":"Mi iras kun pura koro interne de mia domo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mi ne metas antaŭ miajn okulojn malbonan aferon;","poem":1},{"lineBreak":true},{"text":"Mi malamas farojn de malfideleco,","poem":1},{"lineBreak":true},{"text":"Ili ne aliĝas al mi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Koro perversa foriĝu de mi;","poem":1},{"lineBreak":true},{"text":"Malbonon mi ne volas koni.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kiu sekrete kalumnias sian proksimulon, tiun mi ekstermos;","poem":1},{"lineBreak":true},{"text":"Kiu havas fieran okulon kaj malhumilan koron, tiun mi ne toleros.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Miaj okuloj restas turnataj al la fideluloj de la tero, ke ili sidu kun mi;","poem":1},{"lineBreak":true},{"text":"Kiu iras la vojon de pieco, tiu servu al mi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ne loĝos interne de mia domo iu, kiu agas hipokrite;","poem":1},{"lineBreak":true},{"text":"Kiu diras malveron, tiu ne staros antaŭ miaj okuloj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fervore mi ekstermos ĉiujn malvirtulojn de la lando,","poem":1},{"lineBreak":true},{"text":"Por elradikigi el la urbo de la Eternulo ĉiujn krimulojn.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}