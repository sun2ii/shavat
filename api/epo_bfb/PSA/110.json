{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["Psalmo de David."]},{"type":"verse","number":1,"content":[{"text":"La Eternulo diris al mia sinjoro: Sidu dekstre de Mi,","poem":1},{"lineBreak":true},{"text":"Ĝis Mi faros viajn malamikojn benketo por viaj piedoj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"La sceptron de via potenco la Eternulo sendos el Cion:","poem":1},{"lineBreak":true},{"text":"Regu inter viaj malamikoj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"En la tago de via potenco via popolo volonte sin donas al vi en sankta ornamo.","poem":1},{"lineBreak":true},{"text":"De la komenco de matenruĝo aliĝas al vi la roso de via junularo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"La Eternulo ĵuris, kaj ne pentos;","poem":1},{"lineBreak":true},{"text":"Vi estas pastro por ĉiam,","poem":1},{"lineBreak":true},{"text":"Laŭ la maniero de Melkicedek.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"La Sinjoro ĉe via dekstra flanko","poem":1},{"lineBreak":true},{"text":"Frapas reĝojn en la tago de Sia kolero.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Li juĝos inter la popoloj, inter plene da kadavroj;","poem":1},{"lineBreak":true},{"text":"Li frakasos la ĉefon de granda lando.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Li trinkos el rivero sur la vojo;","poem":1},{"lineBreak":true},{"text":"Tial li levos la kapon.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}