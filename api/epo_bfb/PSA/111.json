{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"Haleluja!","poem":1},{"lineBreak":true},{"text":"Mi gloras la Eternulon per mia tuta koro,","poem":1},{"lineBreak":true},{"text":"En rondo de piuloj kaj en kunveno.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Grandaj estas la faroj de la Eternulo,","poem":1},{"lineBreak":true},{"text":"Serĉataj de ĉiuj, kiuj ilin amas.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bela kaj majesta estas Lia verko,","poem":1},{"lineBreak":true},{"text":"Kaj Lia justeco restas eterne.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Memorindaj Li faris Siajn miraklojn;","poem":1},{"lineBreak":true},{"text":"Kompatema kaj favorkora estas la Eternulo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Li donas manĝon al tiuj, kiuj Lin timas;","poem":1},{"lineBreak":true},{"text":"Li memoras eterne Sian interligon.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"La potencon de Siaj fortoj Li aperigis al Sia popolo,","poem":1},{"lineBreak":true},{"text":"Doninte al ili la heredon de gentoj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"La faroj de Liaj manoj estas vero kaj justeco;","poem":1},{"lineBreak":true},{"text":"Perfektaj estas ĉiuj Liaj ordonoj;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ili estas fortikaj por eterne,","poem":1},{"lineBreak":true},{"text":"Faritaj per vero kaj honesto.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Liberigon Li sendis al Sia popolo;","poem":1},{"lineBreak":true},{"text":"Li aranĝis por ĉiam Sian interligon.","poem":1},{"lineBreak":true},{"text":"Sankta kaj respektinda estas Lia nomo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Komenco de saĝeco estas timo antaŭ la Eternulo;","poem":1},{"lineBreak":true},{"text":"Bonan prudenton havas ĉiuj plenumantoj.","poem":1},{"lineBreak":true},{"text":"Lia gloro restas eterne.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}