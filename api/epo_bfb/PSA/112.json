{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"Haleluja!","poem":1},{"lineBreak":true},{"text":"Bone estas al la homo, kiu timas la Eternulon","poem":1},{"lineBreak":true},{"text":"Kaj tre amas Liajn ordonojn.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Forta sur la tero estos lia semo;","poem":1},{"lineBreak":true},{"text":"La gento de virtuloj estos benita.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bonstato kaj riĉeco estas en lia domo;","poem":1},{"lineBreak":true},{"text":"Kaj lia justeco restas eterne.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"En mallumo leviĝas lumo por la virtulo.","poem":1},{"lineBreak":true},{"text":"Li estas kompatema, favorkora, kaj justa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bone estas al la homo, kiu kompatas kaj pruntedonas,","poem":1},{"lineBreak":true},{"text":"Kiu pesas siajn farojn per justeco.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ĉar neniam li falos;","poem":1},{"lineBreak":true},{"text":"Virtulo estos memorata eterne.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Malbonan famon li ne timos;","poem":1},{"lineBreak":true},{"text":"Fortika estas lia koro, ĝi fidas la Eternulon.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Senŝanceliĝa estas lia koro;","poem":1},{"lineBreak":true},{"text":"Li ne timas, ĝis li vidas la pereon de siaj malamikoj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Li ŝutas kaj donas al la malriĉuloj;","poem":1},{"lineBreak":true},{"text":"Lia justeco restas eterne,","poem":1},{"lineBreak":true},{"text":"Lia korno altiĝos en honoro.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"La malvirtulo vidas kaj ĉagreniĝas,","poem":1},{"lineBreak":true},{"text":"Kunfrapas la dentojn kaj konsumiĝas.","poem":1},{"lineBreak":true},{"text":"La deziro de malvirtuloj pereos.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}