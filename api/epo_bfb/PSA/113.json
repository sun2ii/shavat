{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Haleluja!","poem":1},{"lineBreak":true},{"text":"Gloru, sklavoj de la Eternulo,","poem":1},{"lineBreak":true},{"text":"Gloru la nomon de la Eternulo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"La nomo de la Eternulo estu benata","poem":1},{"lineBreak":true},{"text":"De nun kaj eterne.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"De la leviĝejo de la suno ĝis ĝia malleviĝejo","poem":1},{"lineBreak":true},{"text":"Estas glorata la nomo de la Eternulo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alte super ĉiuj popoloj estas la Eternulo;","poem":1},{"lineBreak":true},{"text":"Super la ĉielo estas Lia gloro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kiu estas kiel la Eternulo, nia Dio,","poem":1},{"lineBreak":true},{"text":"Kiu sidas alte,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kiu kliniĝas por rigardi","poem":1},{"lineBreak":true},{"text":"La ĉielon kaj la teron,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kiu el la polvo restarigas mizerulon,","poem":1},{"lineBreak":true},{"text":"El la koto levas malriĉulon,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Por sidigi lin kun eminentuloj,","poem":1},{"lineBreak":true},{"text":"Kun la eminentuloj de lia popolo?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Li donas familion al senfruktulino,","poem":1},{"lineBreak":true},{"text":"Kaj faras ŝin ĝoja patrino de infanoj.","poem":1},{"lineBreak":true},{"text":"Haleluja!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}