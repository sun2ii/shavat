{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"Ne al ni, ho Eternulo, ne al ni,","poem":1},{"lineBreak":true},{"text":"Sed al Via nomo donu honoron,","poem":1},{"lineBreak":true},{"text":"Pro Via favorkoreco, pro Via vereco.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kial devas diri la popoloj:","poem":1},{"lineBreak":true},{"text":"Kie do estas ilia Dio?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sed nia Dio estas en la ĉielo;","poem":1},{"lineBreak":true},{"text":"Ĉion, kion Li deziras, Li faras.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Iliaj idoloj estas arĝento kaj oro,","poem":1},{"lineBreak":true},{"text":"Faritaĵo de homaj manoj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Buŝon ili havas, sed ne parolas;","poem":1},{"lineBreak":true},{"text":"Okulojn ili havas, sed ne vidas;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Orelojn ili havas, sed ne aŭdas;","poem":1},{"lineBreak":true},{"text":"Nazon ili havas, sed ne flaras;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Manojn ili havas, sed ne palpas;","poem":1},{"lineBreak":true},{"text":"Piedojn ili havas, sed ne iras;","poem":1},{"lineBreak":true},{"text":"Ili ne donas sonon per sia gorĝo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kiel ili, tiel estos iliaj farantoj,","poem":1},{"lineBreak":true},{"text":"Ĉiuj, kiuj ilin fidas.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ho Izrael, fidu la Eternulon;","poem":1},{"lineBreak":true},{"text":"Li estas ilia helpo kaj ŝildo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ho domo de Aaron, fidu la Eternulon;","poem":1},{"lineBreak":true},{"text":"Li estas ilia helpo kaj ŝildo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ho timantoj de la Eternulo, fidu la Eternulon;","poem":1},{"lineBreak":true},{"text":"Li estas ilia helpo kaj ŝildo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"La Eternulo nin memoras, Li benas,","poem":1},{"lineBreak":true},{"text":"Li benas la domon de Izrael,","poem":1},{"lineBreak":true},{"text":"Li benas la domon de Aaron;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Li benas la timantojn de la Eternulo,","poem":1},{"lineBreak":true},{"text":"La malgrandajn kaj la grandajn.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"La Eternulo vin multigu,","poem":1},{"lineBreak":true},{"text":"Vin kaj viajn infanojn.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Vi estas benitaj de la Eternulo,","poem":1},{"lineBreak":true},{"text":"Kiu faris la ĉielon kaj la teron.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"La ĉielo estas ĉielo de la Eternulo,","poem":1},{"lineBreak":true},{"text":"Sed la teron Li donis al la homidoj.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ne la mortintoj gloros la Eternulon,","poem":1},{"lineBreak":true},{"text":"Kaj ne tiuj, kiuj foriris en la silentejon.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Sed ni benos la Eternulon","poem":1},{"lineBreak":true},{"text":"De nun kaj eterne.","poem":1},{"lineBreak":true},{"text":"Haleluja!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}