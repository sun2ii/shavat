{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"verse","number":1,"content":[{"text":"Mi amas, ke la Eternulo aŭdas mian voĉon","poem":1},{"lineBreak":true},{"text":"Kaj mian petegon,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ke Li klinis Sian orelon al mi;","poem":1},{"lineBreak":true},{"text":"Kaj en miaj tagoj mi Lin vokos.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ĉirkaŭis min la ondoj de la morto,","poem":1},{"lineBreak":true},{"text":"Kaj turmentoj de Ŝeol min trafis;","poem":1},{"lineBreak":true},{"text":"Suferon kaj ĉagrenon mi trovis.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sed la nomon de la Eternulo mi vokis:","poem":1},{"lineBreak":true},{"text":"Ho Eternulo, savu mian animon.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Favorkora estas la Eternulo kaj justa,","poem":1},{"lineBreak":true},{"text":"Kaj nia Dio estas kompatema.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"La Eternulo gardas la simplanimulojn;","poem":1},{"lineBreak":true},{"text":"Mi estis en mizero, kaj Li min savis.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Revenu, ho mia animo, al via trankvileco,","poem":1},{"lineBreak":true},{"text":"Ĉar la Eternulo faris al vi bonon.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ĉar Vi savis mian animon de la morto,","poem":1},{"lineBreak":true},{"text":"Miajn okulojn de larmoj,","poem":1},{"lineBreak":true},{"text":"Miajn piedojn de falpuŝiĝo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mi irados antaŭ la Eternulo","poem":1},{"lineBreak":true},{"text":"En la lando de la vivo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kun kredo mi diris:","poem":1},{"lineBreak":true},{"text":"Mi estas tre afliktita.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mi diris en mia konfuziĝo:","poem":1},{"lineBreak":true},{"text":"Ĉu homo mensogas.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kion mi redonu al la Eternulo","poem":1},{"lineBreak":true},{"text":"Por ĉiuj Liaj bonfaroj al mi?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mi levos la pokalon de savo,","poem":1},{"lineBreak":true},{"text":"Kaj mi vokos la nomon de la Eternulo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Miajn promesojn al la Eternulo mi plenumos","poem":1},{"lineBreak":true},{"text":"Antaŭ Lia tuta popolo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Grandvalora en la okuloj de la Eternulo","poem":1},{"lineBreak":true},{"text":"Estas la morto de Liaj fideluloj.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ho Eternulo, mi ja estas Via sklavo,","poem":1},{"lineBreak":true},{"text":"Mi estas Via sklavo, filo de Via sklavino;","poem":1},{"lineBreak":true},{"text":"Vi disigis miajn ligilojn.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Al Vi mi oferdonos dankan oferon,","poem":1},{"lineBreak":true},{"text":"Kaj la nomon de la Eternulo mi vokos.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Miajn promesojn al la Eternulo mi plenumos","poem":1},{"lineBreak":true},{"text":"Antaŭ Lia tuta popolo,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"En la kortoj de la domo de la Eternulo,","poem":1},{"lineBreak":true},{"text":"Interne de vi, ho Jerusalem.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}