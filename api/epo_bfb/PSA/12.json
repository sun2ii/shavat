{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Por basuloj. Psalmo de David."]},{"type":"verse","number":1,"content":[{"text":"Helpu, ho Eternulo, ĉar malaperis piuloj","poem":1},{"lineBreak":true},{"text":"Kaj maloftiĝis fideluloj inter la homidoj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Malveron ili parolas unuj al aliaj,","poem":1},{"lineBreak":true},{"text":"Vortojn flatajn el koro hipokrita.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"La Eternulo ekstermu ĉiun flatan buŝon","poem":1},{"lineBreak":true},{"text":"Kaj langon fanfaronantan,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tiujn, kiuj diras: Per nia lango ni venkos,","poem":1},{"lineBreak":true},{"text":"Nia buŝo estas kun ni; kiu estas sinjoro super ni?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ĉar prematoj estas ruinigataj kaj malfeliĉuloj ĝemas,","poem":1},{"lineBreak":true},{"text":"Tial nun Mi Min levos, diras la Eternulo;","poem":1},{"lineBreak":true},{"text":"Mi donos savon al tiuj, kiuj sopiras pri ĝi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"La paroloj de la Eternulo estas paroloj puraj,","poem":1},{"lineBreak":true},{"text":"Arĝento, purigita en tera fandujo kaj sepfoje refandita.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Vi, ho Eternulo, konservos ilin,","poem":1},{"lineBreak":true},{"text":"Vi gardos nin kontraŭ ĉi tiu generacio por eterne.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ĉirkaŭe aperas multe da malpiuloj,","poem":1},{"lineBreak":true},{"text":"Kiam malnobleco altiĝas inter la homidoj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}