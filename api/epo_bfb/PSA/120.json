e},{"text":"Tro longe loĝis mia animo","poem":1},{"lineBreak":true},{"text":"Inter malamantoj de paco.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mi estas pacema;","poem":1},{"lineBreak":true},{"text":"Sed kiam mi ekparolas, ili komencas militon.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}