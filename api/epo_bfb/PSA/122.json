{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["Kanto de suprenirado. De David."]},{"type":"verse","number":1,"content":[{"text":"Mi ekĝojis, kiam oni diris al mi:","poem":1},{"lineBreak":true},{"text":"Ni iru en la domon de la Eternulo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Niaj piedoj staris en viaj pordegoj,","poem":1},{"lineBreak":true},{"text":"Ho Jerusalem,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Vi Jerusalem, konstruita kiel urbo,","poem":1},{"lineBreak":true},{"text":"En kiu ĉio kuniĝis.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tien supreniris la triboj, la triboj de la Eternulo,","poem":1},{"lineBreak":true},{"text":"Laŭ la moro de Izrael,","poem":1},{"lineBreak":true},{"text":"Por glori la nomon de la Eternulo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ĉar tie staris tronoj de juĝo,","poem":1},{"lineBreak":true},{"text":"Tronoj de la domo de David.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Deziru pacon al Jerusalem;","poem":1},{"lineBreak":true},{"text":"Bonan staton havu viaj amantoj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Paco estu inter viaj muroj,","poem":1},{"lineBreak":true},{"text":"Bonstato en viaj palacoj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pro miaj fratoj kaj amikoj mi do diru:","poem":1},{"lineBreak":true},{"text":"Paco estu al vi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pro la domo de la Eternulo, nia Dio,","poem":1},{"lineBreak":true},{"text":"Mi deziras al vi bonon.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}