:5,"content":[{"lineBreak":true},{"text":"Sed tiujn, kiuj dekliniĝas al siaj malrektaj vojoj,","poem":1},{"lineBreak":true},{"text":"La Eternulo pereigos kune kun la malbonaguloj.","poem":1},{"lineBreak":true},{"text":"Paco al Izrael!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}