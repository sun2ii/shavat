{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"hebrew_subtitle","content":["Kanto de suprenirado. De Salomono."]},{"type":"verse","number":1,"content":[{"text":"Se la Eternulo ne konstruas la domon,","poem":1},{"lineBreak":true},{"text":"Tiam vane laboras super ĝi ĝiaj konstruantoj;","poem":1},{"lineBreak":true},{"text":"Se la Eternulo ne gardas urbon,","poem":1},{"lineBreak":true},{"text":"Tiam vane maldormas la gardanto.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Vane vi frue leviĝas, malfrue sidas,","poem":1},{"lineBreak":true},{"text":"Manĝas panon kun klopodoj:","poem":1},{"lineBreak":true},{"text":"Al Sia amato Li donas en dormo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jen, heredo de la Eternulo estas infanoj;","poem":1},{"lineBreak":true},{"text":"Rekompenco estas la frukto de ventro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kiel sagoj en la mano de fortulo,","poem":1},{"lineBreak":true},{"text":"Tiel estas junaj filoj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bone estas al la homo, kiu plenigis per ili sian sagujon;","poem":1},{"lineBreak":true},{"text":"Ili ne estos hontigitaj,","poem":1},{"lineBreak":true},{"text":"Kiam ili parolos kun la malamikoj ĉe la pordego.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}