{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Psalmo de David."]},{"type":"verse","number":1,"content":[{"text":"Ĝis kiam, ho Eternulo, Vi tute forgesos pri mi?","poem":1},{"lineBreak":true},{"text":"Ĝis kiam Vi kaŝos Vian vizaĝon antaŭ mi?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ĝis kiam mi havos zorgojn en mia animo","poem":1},{"lineBreak":true},{"text":"Kaj sopirojn en mia koro ĉiutage?","poem":1},{"lineBreak":true},{"text":"Ĝis kiam mia malamiko estos supre super mi?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Rigardu kaj aŭdu min, ho Eternulo, mia Dio;","poem":1},{"lineBreak":true},{"text":"Lumigu miajn okulojn, ke mi ne ekdormu per morto;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ke ne diru mia malamiko: Mi lin venkis;","poem":1},{"lineBreak":true},{"text":"Ke ne ĝoju miaj premantoj, se mi falos.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sed mi esperas al Via favorkoreco;","poem":1},{"lineBreak":true},{"text":"Mia koro ĝojas pro Via savo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mi kantos al la Eternulo,","poem":1},{"lineBreak":true},{"text":"Ĉar Li faris al mi bonon.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}