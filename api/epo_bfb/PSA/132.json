{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":132,"content":[{"type":"hebrew_subtitle","content":["Kanto de suprenirado."]},{"type":"verse","number":1,"content":[{"text":"Rememoru, ho Eternulo,","poem":1},{"lineBreak":true},{"text":"Davidon kaj ĉiujn liajn suferojn;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ke li ĵuris al la Eternulo,","poem":1},{"lineBreak":true},{"text":"Kaj donis sanktan promeson al la Potenculo de Jakob:","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mi ne eniros en la ŝirmejon de mia domo,","poem":1},{"lineBreak":true},{"text":"Mi ne supreniros sur la liton, pretigitan por mi;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mi ne donos dormon al miaj okuloj,","poem":1},{"lineBreak":true},{"text":"Nek dormeton al miaj palpebroj,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ĝis mi trovos lokon por la Eternulo,","poem":1},{"lineBreak":true},{"text":"Loĝejon por la Potenculo de Jakob.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Jen ni aŭdis, ke ĝi estas en Efrata;","poem":1},{"lineBreak":true},{"text":"Ni ĝin trovis sur arbara kampo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ni iru en Lian loĝejon,","poem":1},{"lineBreak":true},{"text":"Ni kliniĝu antaŭ la benketo de Liaj piedoj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Leviĝu, ho Eternulo, en Vian ripozejon,","poem":1},{"lineBreak":true},{"text":"Vi kaj la kesto de Via potenco.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Viaj pastroj vestiĝu per justeco,","poem":1},{"lineBreak":true},{"text":"Kaj Viaj fideluloj triumfu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pro David, Via sklavo,","poem":1},{"lineBreak":true},{"text":"Ne forturnu la vizaĝon de Via sanktoleito.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"La Eternulo ĵuris al David veron, kaj Li ne dekliniĝos de ĝi:","poem":1},{"lineBreak":true},{"text":"Frukton de via ventro Mi sidigos sur via trono;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Se viaj filoj observos Mian interligon kaj Mian leĝon, kiun Mi instruos al ili,","poem":1},{"lineBreak":true},{"text":"Tiam ankaŭ iliaj filoj eterne sidos sur via trono.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ĉar la Eternulo elektis Cionon,","poem":1},{"lineBreak":true},{"text":"Kaj deziris, ke ĝi estu loĝejo por Li:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ĉi tio estas Mia ripozejo por eterne;","poem":1},{"lineBreak":true},{"text":"Ĉi tie Mi loĝos, ĉar ĝin Mi ekdeziris.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ĝian nutraĵon Mi abunde benos,","poem":1},{"lineBreak":true},{"text":"Ĝiajn malriĉulojn Mi satigos per pano.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kaj ĝiajn pastrojn Mi vestos per savo;","poem":1},{"lineBreak":true},{"text":"Kaj ĝiaj fideluloj ĝojos kaj triumfos.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tie Mi elkreskigos kornon al David,","poem":1},{"lineBreak":true},{"text":"Tie Mi aranĝos lumilon por Mia sanktoleito.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Liajn malamikojn Mi kovros per honto;","poem":1},{"lineBreak":true},{"text":"Sed sur li brilos lia krono.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}