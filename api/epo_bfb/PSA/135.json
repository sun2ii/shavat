{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":135,"content":[{"type":"verse","number":1,"content":[{"text":"Haleluja!","poem":1},{"lineBreak":true},{"text":"Gloru la nomon de la Eternulo,","poem":1},{"lineBreak":true},{"text":"Gloru, sklavoj de la Eternulo,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kiuj staras en la domo de la Eternulo,","poem":1},{"lineBreak":true},{"text":"En la kortoj de la domo de nia Dio.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gloru la Eternulon, ĉar la Eternulo estas bona;","poem":1},{"lineBreak":true},{"text":"Prikantu Lian nomon, ĉar ĝi estas ĉarma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ĉar Jakobon la Eternulo elektis al Si,","poem":1},{"lineBreak":true},{"text":"Izraelon kiel Sian trezoron.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ĉar mi scias, ke la Eternulo estas granda","poem":1},{"lineBreak":true},{"text":"Kaj ke nia Sinjoro estas super ĉiuj dioj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ĉion, kion la Eternulo deziras, Li faras,","poem":1},{"lineBreak":true},{"text":"En la ĉielo kaj sur la tero, sur la maroj kaj en ĉiuj abismoj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Li levas la nubojn de la randoj de la tero,","poem":1},{"lineBreak":true},{"text":"Li aperigas fulmojn en la pluvo,","poem":1},{"lineBreak":true},{"text":"Li elirigas la venton el Siaj provizejoj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Li batis la unuenaskitojn en Egiptujo,","poem":1},{"lineBreak":true},{"text":"De homo ĝis bruto.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Li aperigis signojn kaj miraklojn interne de vi, ho Egiptujo,","poem":1},{"lineBreak":true},{"text":"Super Faraono kaj ĉiuj liaj sklavoj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Li batis multajn popolojn,","poem":1},{"lineBreak":true},{"text":"Kaj mortigis potencajn reĝojn:","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Siĥonon, reĝon de la Amoridoj,","poem":1},{"lineBreak":true},{"text":"Kaj Ogon, reĝon de Baŝan,","poem":1},{"lineBreak":true},{"text":"Kaj ĉiujn regnojn Kanaanajn.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kaj Li donis ilian landon kiel heredon,","poem":1},{"lineBreak":true},{"text":"Heredon al Lia popolo Izrael.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ho Eternulo, Via nomo estas eterna;","poem":1},{"lineBreak":true},{"text":"Ho Eternulo, la memoro pri Vi restas por ĉiuj generacioj.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ĉar la Eternulo juĝos Sian popolon,","poem":1},{"lineBreak":true},{"text":"Kaj Li korfavoros Siajn sklavojn.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"La idoloj de la popoloj estas arĝento kaj oro,","poem":1},{"lineBreak":true},{"text":"Faritaĵo de homaj manoj.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Buŝon ili havas, sed ne parolas;","poem":1},{"lineBreak":true},{"text":"Okulojn ili havas, sed ne vidas;","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Orelojn ili havas, sed ne aŭdas;","poem":1},{"lineBreak":true},{"text":"Kaj ne ekzistas spiro en ilia buŝo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kiel ili, tiel estos iliaj farantoj,","poem":1},{"lineBreak":true},{"text":"Ĉiuj, kiuj ilin fidas.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ho domo de Izrael, benu la Eternulon;","poem":1},{"lineBreak":true},{"text":"Ho domo de Aaron, benu la Eternulon;","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ho domo de Levi, benu la Eternulon;","poem":1},{"lineBreak":true},{"text":"Ho timantoj de la Eternulo, benu la Eternulon.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"El Cion estu benata la Eternulo,","poem":1},{"lineBreak":true},{"text":"Kiu loĝas en Jerusalem.","poem":1},{"lineBreak":true},{"text":"Haleluja!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}