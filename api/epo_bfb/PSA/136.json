{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":136,"content":[{"type":"verse","number":1,"content":[{"text":"Gloru la Eternulon, ĉar Li estas bona,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gloru la Dion de la dioj,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gloru la Sinjoron de la sinjoroj,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"La sola faranto de grandaj mirakloj,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kiu saĝege kreis la ĉielon,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kiu etendis la teron super la akvo,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kiu kreis grandajn lumojn,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"La sunon, por regi en la tago,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"La lunon kaj la stelojn, por regi en la nokto,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kiu batis Egiptujon en ĝiaj unuenaskitoj,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kaj elkondukis el ĝia mezo Izraelon,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Per forta mano kaj etendita brako,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kiu fendis la Ruĝan Maron en du partojn,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kaj trairigis Izraelon tra ĝi,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kaj enĵetis Faraonon kaj lian militistaron en la Ruĝan Maron,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kiu kondukis Sian popolon tra la dezerto,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco;","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kiu batis grandajn reĝojn,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco;","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kaj mortigis reĝojn potencajn,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco;","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Siĥonon, reĝon de la Amoridoj,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco;","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kaj Ogon, reĝon de Baŝan,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco;","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Kaj donis ilian landon kiel heredon,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco;","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Heredon al Lia sklavo Izrael,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco;","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Kiu rememoris nin, kiam ni estis humiligitaj,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco;","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Kaj liberigis nin de niaj premantoj,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco;","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Kiu donas panon al ĉiu karno,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Gloru la Dion de la ĉielo,","poem":1},{"lineBreak":true},{"text":"Ĉar eterna estas Lia boneco.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}