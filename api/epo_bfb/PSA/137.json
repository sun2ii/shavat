{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"Apud la riveroj de Babel","poem":1},{"lineBreak":true},{"text":"Ni sidis kaj ploris,","poem":1},{"lineBreak":true},{"text":"Rememorante Cionon.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sur la salikoj tie","poem":1},{"lineBreak":true},{"text":"Ni pendigis niajn harpojn.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ĉar tie niaj kaptintoj postulis de ni kantojn,","poem":1},{"lineBreak":true},{"text":"Kaj niaj mokantoj ĝojon, dirante:","poem":1},{"lineBreak":true},{"text":"Kantu al ni el la kantoj de Cion.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kiel ni kantos sur fremda tero","poem":1},{"lineBreak":true},{"text":"La kanton de la Eternulo?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Se mi forgesos vin, ho Jerusalem,","poem":1},{"lineBreak":true},{"text":"Tiam forgesiĝu mia dekstra mano;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Algluiĝu mia lango al mia palato,","poem":1},{"lineBreak":true},{"text":"Se mi vin ne memoros,","poem":1},{"lineBreak":true},{"text":"Se mi ne levos Jerusalemon en la supron de miaj ĝojoj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rememorigu, ho Eternulo, al la filoj de Edom","poem":1},{"lineBreak":true},{"text":"La tagon de Jerusalem, kiam ili diris:","poem":1},{"lineBreak":true},{"text":"Detruu, detruu ĝis ĝia fundamento.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ho ruinigema filino de Babel!","poem":1},{"lineBreak":true},{"text":"Bone estos al tiu,","poem":1},{"lineBreak":true},{"text":"Kiu repagos al vi por la faro, kiun vi faris al ni.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bone estos al tiu,","poem":1},{"lineBreak":true},{"text":"Kiu prenos kaj frakasos viajn infanetojn sur ŝtono.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}