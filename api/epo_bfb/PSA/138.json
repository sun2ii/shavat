{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"hebrew_subtitle","content":["De David."]},{"type":"verse","number":1,"content":[{"text":"Mi gloras Vin el mia tuta koro;","poem":1},{"lineBreak":true},{"text":"Antaŭ la dioj mi Vin prikantas.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mi kliniĝas antaŭ Via sankta templo,","poem":1},{"lineBreak":true},{"text":"Kaj mi gloras Vian nomon por Via boneco kaj vereco;","poem":1},{"lineBreak":true},{"text":"Ĉar Vi grandigis pli ol ĉio Vian nomon per Via vorto.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"En la tago, kiam mi vokis, Vi aŭskultis min,","poem":1},{"lineBreak":true},{"text":"Vi donis forton al mia animo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gloros Vin, ho Eternulo, ĉiuj reĝoj de la tero,","poem":1},{"lineBreak":true},{"text":"Ĉar ili aŭdis la vortojn de Via buŝo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kaj ili prikantos la vojojn de la Eternulo;","poem":1},{"lineBreak":true},{"text":"Ĉar granda estas la gloro de la Eternulo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ĉar kvankam la Eternulo estas alte, tamen Li rigardas humilulon,","poem":1},{"lineBreak":true},{"text":"Kaj fierulon Li rimarkas de malproksime.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kvankam mi iras meze de suferoj, tamen Vi konservas mian vivon;","poem":1},{"lineBreak":true},{"text":"Kontraŭ la kolero de miaj malamikoj Vi etendas Vian brakon,","poem":1},{"lineBreak":true},{"text":"Kaj Via dekstra mano min helpas.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"La Eternulo plenumos por mi.","poem":1},{"lineBreak":true},{"text":"Ho Eternulo, Via boneco estas eterna;","poem":1},{"lineBreak":true},{"text":"La kreitaĵojn de Viaj manoj ne forlasu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}