{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. De David."]},{"type":"verse","number":1,"content":[{"text":"La sensaĝulo diris en sia koro: Dio ne ekzistas.","poem":1},{"lineBreak":true},{"text":"Ili sentaŭgiĝis, ili abomeniĝis pro siaj faroj;","poem":1},{"lineBreak":true},{"text":"Ekzistas neniu, kiu faras bonon.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"La Eternulo el la ĉielo ekrigardis la homidojn,","poem":1},{"lineBreak":true},{"text":"Por vidi, ĉu ekzistas prudentulo, kiu serĉas Dion.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ĉiuj devojiĝis, ĉiuj malvirtiĝis;","poem":1},{"lineBreak":true},{"text":"Ekzistas neniu, faranta bonon, ne ekzistas eĉ unu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ĉu ne prudentiĝos ĉiuj, kiuj faras malbonon,","poem":1},{"lineBreak":true},{"text":"Kiuj manĝas mian popolon, kiel oni manĝas panon,","poem":1},{"lineBreak":true},{"text":"Kaj kiuj ne vokas al la Eternulo?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tie ili forte ektimis,","poem":1},{"lineBreak":true},{"text":"Ĉar Dio estas en la generacio de la justuloj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Vi malhonoris la konsilon de malriĉulo,","poem":1},{"lineBreak":true},{"text":"Sed la Eternulo estas lia rifuĝejo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ho, ke venu el Cion savo al Izrael!","poem":1},{"lineBreak":true},{"text":"Kiam la Eternulo revenigos Sian forkaptitan popolon,","poem":1},{"lineBreak":true},{"text":"Tiam triumfos Jakob kaj ĝojos Izrael.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}