{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":140,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Psalmo de David."]},{"type":"verse","number":1,"content":[{"text":"Liberigu min, ho Eternulo, de malbona homo,","poem":1},{"lineBreak":true},{"text":"Gardu min kontraŭ perfortulo;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kontraŭ tiuj, kiuj elpensas malbonon en la koro,","poem":1},{"lineBreak":true},{"text":"Ĉiutage kaŭzas militojn;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kiuj akrigas sian langon, kiel serpento;","poem":1},{"lineBreak":true},{"text":"Veneno de vipuro estas sub iliaj lipoj. Sela.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gardu min, ho Eternulo, kontraŭ la manoj de malvirtuloj,","poem":1},{"lineBreak":true},{"text":"Gardu min kontraŭ perfortuloj,","poem":1},{"lineBreak":true},{"text":"Kiuj intencas renversi miajn paŝojn.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fieruloj kaŝis kaptilon por mi kaj ŝnurojn,","poem":1},{"lineBreak":true},{"text":"Ili etendis reton ĉe la vojo, implikilon ili metis por mi. Sela.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mi diris al la Eternulo: Vi estas mia Dio;","poem":1},{"lineBreak":true},{"text":"Atentu, ho Eternulo, la voĉon de mia petego.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ho Eternulo, mia Sinjoro, forto de mia savo,","poem":1},{"lineBreak":true},{"text":"Vi ŝirmas mian kapon en la tago de batalo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ne donu, ho Eternulo, al malvirtulo lian dezirataĵon,","poem":1},{"lineBreak":true},{"text":"Lian intencon ne efektivigu, ke ili ne fieriĝu. Sela.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"La veneno de miaj ĉirkaŭantoj,","poem":1},{"lineBreak":true},{"text":"La malicaĵo de iliaj lipoj kovru ilin.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Falu sur ilin brulantaj karboj;","poem":1},{"lineBreak":true},{"text":"Ili ĵetiĝu en fajron,","poem":1},{"lineBreak":true},{"text":"En abismojn, ke ili ne leviĝu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kalumnianto ne staros forte sur la tero;","poem":1},{"lineBreak":true},{"text":"Perfortulon la malbono entiros en pereon.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mi scias, ke la Eternulo defendos la aferon de mizerulo,","poem":1},{"lineBreak":true},{"text":"La rajton de malriĉuloj.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kaj virtuloj ja gloros Vian nomon;","poem":1},{"lineBreak":true},{"text":"Piuloj restos antaŭ Via vizaĝo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}