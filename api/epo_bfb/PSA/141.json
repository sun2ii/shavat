{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":141,"content":[{"type":"hebrew_subtitle","content":["Psalmo de David."]},{"type":"verse","number":1,"content":[{"text":"Ho Eternulo, mi vokas al Vi; rapidu al mi;","poem":1},{"lineBreak":true},{"text":"Atentu mian voĉon, kiam mi vokas al Vi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mia preĝo valoru antaŭ Vi kiel incenso,","poem":1},{"lineBreak":true},{"text":"La levo de miaj manoj kiel vespera oferdono.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Metu, ho Eternulo, gardon al mia buŝo,","poem":1},{"lineBreak":true},{"text":"Gardu la pordon de miaj lipoj.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ne klinu mian koron al io malbona,","poem":1},{"lineBreak":true},{"text":"Al partoprenado en malbonagoj kun malbonaguloj;","poem":1},{"lineBreak":true},{"text":"Mi ne manĝu iliajn bongustaĵojn.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Virtuloj min frapu favorkore kaj punu min:","poem":1},{"lineBreak":true},{"text":"Ĝi estos oleo por la kapo;","poem":1},{"lineBreak":true},{"text":"Mia kapo ne rifuzos, se estos eĉ pli;","poem":1},{"lineBreak":true},{"text":"Kaj mi preĝas ĉe iliaj malfeliĉoj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Disiĝis sur roko iliaj juĝantoj,","poem":1},{"lineBreak":true},{"text":"Kaj ili aŭdis miajn vortojn, kiel amikaj ili estis.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kiel iu plugas kaj dispecigas la teron,","poem":1},{"lineBreak":true},{"text":"Tiel estas disĵetitaj iliaj ostoj ĝis la buŝo de Ŝeol.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ĉar al Vi, ho Eternulo, mia Sinjoro, estas direktitaj miaj okuloj;","poem":1},{"lineBreak":true},{"text":"Al Vi mi esperas: ne forpuŝu mian animon.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gardu min kontraŭ la reto, kiun oni metis al mi,","poem":1},{"lineBreak":true},{"text":"Kontraŭ la implikilo de la malbonaguloj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"La malvirtuloj falu en siajn retojn ĉiuj,","poem":1},{"lineBreak":true},{"text":"Dum mi preteriros.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}