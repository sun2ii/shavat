{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["Instruo de David, kiam li estis en la kaverno. Preĝo."]},{"type":"verse","number":1,"content":[{"text":"Per mia voĉo mi krias al la Eternulo,","poem":1},{"lineBreak":true},{"text":"Per mia voĉo mi preĝas al la Eternulo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mi elverŝas antaŭ Li mian peton,","poem":1},{"lineBreak":true},{"text":"Mian suferon mi al Li rakontas.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kiam senfortiĝis en mi mia spirito, tiam Vi sciis mian vojon:","poem":1},{"lineBreak":true},{"text":"Sur la vojo, kiun mi iras, ili kaŝis reton por mi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rigardu dekstren kaj vidu: neniu volas min koni;","poem":1},{"lineBreak":true},{"text":"Malaperis rifuĝejo por mi, neniu zorgas pri mia animo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mi krias al Vi, ho Eternulo;","poem":1},{"lineBreak":true},{"text":"Mi diras: Vi estas mia rifuĝejo,","poem":1},{"lineBreak":true},{"text":"Mia parto en la lando de la vivantoj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Atentu mian ploron, ĉar mi tre senfortiĝis;","poem":1},{"lineBreak":true},{"text":"Savu min de miaj persekutantoj, ĉar ili estas pli fortaj ol mi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Eligu mian animon el malliberejo, por ke mi gloru Vian nomon.","poem":1},{"lineBreak":true},{"text":"Min ĉirkaŭos la virtuloj, kiam Vi bonfaros al mi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}