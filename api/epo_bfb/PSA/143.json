{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":143,"content":[{"type":"hebrew_subtitle","content":["Psalmo de David."]},{"type":"verse","number":1,"content":[{"text":"Ho Eternulo, aŭskultu mian preĝon,","poem":1},{"lineBreak":true},{"text":"Atentu mian petegon laŭ Via vereco,","poem":1},{"lineBreak":true},{"text":"Respondu al mi laŭ Via justeco.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kaj ne eniru en juĝon kun Via sklavo,","poem":1},{"lineBreak":true},{"text":"Ĉar neniu vivanta povos praviĝi antaŭ Vi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ĉar malamiko persekutis mian animon,","poem":1},{"lineBreak":true},{"text":"Premis al la tero mian vivon;","poem":1},{"lineBreak":true},{"text":"Li metis min en mallumon, kiel delonge mortintojn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Senfortiĝas en mi mia animo,","poem":1},{"lineBreak":true},{"text":"Konsumiĝas en mi mia koro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mi rememoras la tagojn antikvajn,","poem":1},{"lineBreak":true},{"text":"Mi meditas pri ĉiuj Viaj faroj,","poem":1},{"lineBreak":true},{"text":"Mi pensas pri la faritaĵoj de Viaj manoj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mi etendas al Vi miajn manojn;","poem":1},{"lineBreak":true},{"text":"Mia animo soifas Vin kiel seka tero. Sela.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rapidu, aŭskultu min, ho Eternulo, mia spirito konsumiĝas;","poem":1},{"lineBreak":true},{"text":"Ne kaŝu antaŭ mi Vian vizaĝon,","poem":1},{"lineBreak":true},{"text":"Ĉar mi similiĝus al la forirantaj en la tombon.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aŭdigu al mi matene Vian bonecon,","poem":1},{"lineBreak":true},{"text":"Ĉar Vin mi fidas;","poem":1},{"lineBreak":true},{"text":"Montru al mi la vojon, kiun mi devas iri,","poem":1},{"lineBreak":true},{"text":"Ĉar al Vi mi levas mian animon.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Savu min de miaj malamikoj, ho Eternulo;","poem":1},{"lineBreak":true},{"text":"Al Vi mi rifuĝas.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Instruu al mi plenumi Vian volon, ĉar Vi estas mia Dio;","poem":1},{"lineBreak":true},{"text":"Via bona spirito gvidu min sur ebena tero.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pro Via nomo, ho Eternulo, lasu min vivi;","poem":1},{"lineBreak":true},{"text":"Pro Via justeco eligu mian animon el mizero.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kaj pro Via favorkoreco ekstermu miajn malamikojn","poem":1},{"lineBreak":true},{"text":"Kaj pereigu ĉiujn premantojn de mia animo,","poem":1},{"lineBreak":true},{"text":"Ĉar mi estas Via sklavo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}