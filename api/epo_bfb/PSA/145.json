{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":145,"content":[{"type":"hebrew_subtitle","content":["Glorkanto de David."]},{"type":"verse","number":1,"content":[{"text":"Mi altigos Vin, mia Dio, ho Reĝo,","poem":1},{"lineBreak":true},{"text":"Kaj mi benos Vian nomon ĉiam kaj eterne.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ĉiutage mi Vin benos,","poem":1},{"lineBreak":true},{"text":"Kaj mi gloros Vian nomon ĉiam kaj eterne.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Granda estas la Eternulo kaj tre glorinda,","poem":1},{"lineBreak":true},{"text":"Kaj Lia grandeco estas nemezurebla.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Generacio al generacio laŭdos Viajn farojn","poem":1},{"lineBreak":true},{"text":"Kaj rakontos pri Via potenco.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pri la majesto de Via granda gloro","poem":1},{"lineBreak":true},{"text":"Kaj pri Viaj mirindaj faroj mi meditos.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"La forton de Viaj timindaĵoj oni priparolos,","poem":1},{"lineBreak":true},{"text":"Kaj Vian grandecon mi rakontos.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Oni gloros la renomon de Via granda boneco,","poem":1},{"lineBreak":true},{"text":"Kaj oni prikantos Vian justecon.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kompatema kaj favorkora estas la Eternulo,","poem":1},{"lineBreak":true},{"text":"Longetolera kaj kun granda boneco.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"La Eternulo estas bona por ĉiuj;","poem":1},{"lineBreak":true},{"text":"Lia favorkoreco estas super ĉiuj Liaj kreitaĵoj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gloros Vin, ho Eternulo, ĉiuj Viaj kreitaĵoj,","poem":1},{"lineBreak":true},{"text":"Kaj Viaj fideluloj Vin benos.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ili raportos pri la gloro de Via regno","poem":1},{"lineBreak":true},{"text":"Kaj parolos pri Via potenco,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Por sciigi al la homidoj Lian potencon","poem":1},{"lineBreak":true},{"text":"Kaj la majestan gloron de Lia regno.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Via reĝeco estas reĝeco eterna,","poem":1},{"lineBreak":true},{"text":"Kaj Via regado estas por ĉiuj generacioj.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"La Eternulo subtenas ĉiujn falantojn","poem":1},{"lineBreak":true},{"text":"Kaj restarigas ĉiujn kurbigitojn.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ĉies okuloj estas turnitaj al Vi,","poem":1},{"lineBreak":true},{"text":"Kaj Vi donas al ili ilian manĝon en ĝia tempo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Vi malfermas Vian manon","poem":1},{"lineBreak":true},{"text":"Kaj satigas favore ĉion vivantan.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Justa estas la Eternulo en ĉiuj Siaj vojoj","poem":1},{"lineBreak":true},{"text":"Kaj bona en ĉiuj Siaj faroj.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Proksima estas la Eternulo por ĉiuj, kiuj Lin vokas,","poem":1},{"lineBreak":true},{"text":"Por ĉiuj, kiuj vokas Lin sincere.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"La deziron de Siaj respektantoj Li plenumas,","poem":1},{"lineBreak":true},{"text":"Kaj ilian krion Li aŭdas kaj helpas ilin.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"La Eternulo gardas ĉiujn Sian amantojn,","poem":1},{"lineBreak":true},{"text":"Kaj ĉiujn malvirtulojn Li ekstermas.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"La gloron de la Eternulo eldiros mia buŝo,","poem":1},{"lineBreak":true},{"text":"Kaj ĉiu karno benu Lian sanktan nomon ĉiam kaj eterne.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}