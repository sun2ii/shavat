{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"Haleluja!","poem":1},{"lineBreak":true},{"text":"Gloru, ho mia animo, la Eternulon.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mi gloros la Eternulon en la daŭro de mia tuta vivo,","poem":1},{"lineBreak":true},{"text":"Mi kantos al mia Dio tiel longe, kiel mi estos.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ne fidu eminentulojn,","poem":1},{"lineBreak":true},{"text":"Homidon, kiu ne povas helpi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Eliras lia spirito, li reiras en sian teron;","poem":1},{"lineBreak":true},{"text":"Kaj en tiu tago neniiĝas ĉiuj liaj intencoj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bone estas al tiu, kies helpo estas la Dio de Jakob,","poem":1},{"lineBreak":true},{"text":"Kiu esperas al la Eternulo, lia Dio,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kiu kreis la ĉielon kaj la teron,","poem":1},{"lineBreak":true},{"text":"La maron, kaj ĉion, kio estas en ili,","poem":1},{"lineBreak":true},{"text":"Kiu gardas la veron eterne;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kiu faras justecon al la prematoj,","poem":1},{"lineBreak":true},{"text":"Donas panon al la malsataj.","poem":1},{"lineBreak":true},{"text":"La Eternulo liberigas la malliberulojn;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"La Eternulo malfermas la okulojn al la blinduloj;","poem":1},{"lineBreak":true},{"text":"La Eternulo restarigas la kurbigitojn;","poem":1},{"lineBreak":true},{"text":"La Eternulo amas la virtulojn;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"La Eternulo gardas la enmigrintojn,","poem":1},{"lineBreak":true},{"text":"Subtenas orfon kaj vidvinon;","poem":1},{"lineBreak":true},{"text":"Sed la vojon de malvirtuloj Li pereigas.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"La Eternulo reĝas eterne,","poem":1},{"lineBreak":true},{"text":"Via Dio, ho Cion, por ĉiuj generacioj.","poem":1},{"lineBreak":true},{"text":"Haleluja!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}