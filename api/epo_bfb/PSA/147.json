{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":147,"content":[{"type":"verse","number":1,"content":[{"text":"Haleluja!","poem":1},{"lineBreak":true},{"text":"Ĉar estas bone kanti al nia Dio,","poem":1},{"lineBreak":true},{"text":"Ĉar agrabla estas la glorkantado.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"La Eternulo konstruas Jerusalemon,","poem":1},{"lineBreak":true},{"text":"La elpelitojn de Izrael Li kolektas.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Li sanigas la korprematojn","poem":1},{"lineBreak":true},{"text":"Kaj bandaĝas iliajn vundojn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Li kalkulas la stelojn,","poem":1},{"lineBreak":true},{"text":"Kaj al ili ĉiuj Li donas nomojn.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Granda estas nia Sinjoro kaj tre forta;","poem":1},{"lineBreak":true},{"text":"Lia saĝo estas nemezurebla.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"La Eternulo altigas la humilulojn;","poem":1},{"lineBreak":true},{"text":"Sed la malvirtulojn Li malaltigas ĝis la tero.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kantu al la Eternulo gloradon,","poem":1},{"lineBreak":true},{"text":"Muziku al nia Dio per harpo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Li kovras la ĉielon per nuboj,","poem":1},{"lineBreak":true},{"text":"Pretigas por la tero pluvon,","poem":1},{"lineBreak":true},{"text":"Kreskigas sur la montoj herbon.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Li donas al la bruto ĝian nutraĵon,","poem":1},{"lineBreak":true},{"text":"Kaj al la korvidoj, kiuj krias.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ne la forton de ĉevalo Li ŝatas;","poem":1},{"lineBreak":true},{"text":"Ne la femuroj de homo al Li plaĉas:","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Plaĉas al la Eternulo Liaj timantoj,","poem":1},{"lineBreak":true},{"text":"Kiuj fidas Lian bonecon.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Laŭdu, ho Jerusalem, la Eternulon;","poem":1},{"lineBreak":true},{"text":"Gloru vian Dion, ho Cion.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ĉar Li fortikigis la riglilojn en viaj pordegoj,","poem":1},{"lineBreak":true},{"text":"Li benis viajn filojn interne de vi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Li donas pacon al viaj limoj,","poem":1},{"lineBreak":true},{"text":"Li satigas vin per la plej bona el la tritiko.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Li sendas Sian ordonon al la tero;","poem":1},{"lineBreak":true},{"text":"Tre rapide kuras Lia vorto.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Li donas neĝon kiel lanon,","poem":1},{"lineBreak":true},{"text":"Li ŝutas prujnon kiel cindron.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Li ĵetas Sian glacion kiel pecojn;","poem":1},{"lineBreak":true},{"text":"Kiu kontraŭstaros al Lia frosto?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Li sendas Sian vorton, kaj ĉio degelas;","poem":1},{"lineBreak":true},{"text":"Li blovas per Sia vento, kaj ekfluas akvo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Li sciigas al Jakob Sian vorton,","poem":1},{"lineBreak":true},{"text":"Siajn leĝojn kaj decidojn al Izrael.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tiel Li ne faras al iu alia popolo;","poem":1},{"lineBreak":true},{"text":"Kaj Liajn decidojn ili ne scias.","poem":1},{"lineBreak":true},{"text":"Haleluja!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}