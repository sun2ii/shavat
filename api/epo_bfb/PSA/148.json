{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"Haleluja!","poem":1},{"lineBreak":true},{"text":"Gloru la Eternulon el la ĉielo,","poem":1},{"lineBreak":true},{"text":"Gloru Lin en la alto.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gloru Lin, ĉiuj Liaj anĝeloj;","poem":1},{"lineBreak":true},{"text":"Gloru Lin, ĉiuj Liaj militistaroj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gloru Lin, suno kaj luno;","poem":1},{"lineBreak":true},{"text":"Gloru Lin, ĉiuj lumaj steloj.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gloru Lin, plej supraj ĉieloj,","poem":1},{"lineBreak":true},{"text":"Kaj la akvo, kiu estas super la ĉielo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ili gloru la nomon de la Eternulo;","poem":1},{"lineBreak":true},{"text":"Ĉar Li ordonis, kaj ili kreiĝis.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kaj Li starigis ilin por ĉiam, por eterne;","poem":1},{"lineBreak":true},{"text":"Li donis leĝon, kiun ili ne malobeos.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gloru la Eternulon el la tero,","poem":1},{"lineBreak":true},{"text":"Marmonstroj kaj ĉiuj abismoj;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fulmo kaj hajlo, neĝo kaj nebulo,","poem":1},{"lineBreak":true},{"text":"Ventego, kiu plenumas Lian vorton;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Montoj kaj ĉiuj montetoj,","poem":1},{"lineBreak":true},{"text":"Fruktoportaj arboj kaj ĉiuj cedroj;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bestoj kaj ĉiaj brutoj,","poem":1},{"lineBreak":true},{"text":"Rampaĵoj kaj flugilaj birdoj;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Reĝoj de la tero kaj ĉiuj popoloj,","poem":1},{"lineBreak":true},{"text":"Princoj kaj ĉiuj juĝantoj sur la tero;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Junuloj kaj junulinoj,","poem":1},{"lineBreak":true},{"text":"Maljunuloj kaj knaboj.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ili gloru la nomon de la Eternulo,","poem":1},{"lineBreak":true},{"text":"Ĉar sole Lia nomo estas alta,","poem":1},{"lineBreak":true},{"text":"Lia majesto estas sur la tero kaj en la ĉielo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kaj Li altigis la kornon de Sia popolo,","poem":1},{"lineBreak":true},{"text":"La gloron de ĉiuj Liaj fideluloj,","poem":1},{"lineBreak":true},{"text":"De la filoj de Izrael, Lia plej proksima popolo.","poem":1},{"lineBreak":true},{"text":"Haleluja!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}