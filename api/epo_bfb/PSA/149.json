[{"lineBreak":true},{"text":"Glorado al Dio estas en ilia buŝo,","poem":1},{"lineBreak":true},{"text":"Kaj dutranĉa glavo en ilia mano,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Por fari venĝon super la popoloj,","poem":1},{"lineBreak":true},{"text":"Punkorektadon super la gentoj;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Por malliberigi iliajn reĝojn per ĉenoj","poem":1},{"lineBreak":true},{"text":"Kaj iliajn eminentulojn per feraj katenoj;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Por fari super ili antaŭdestinitan juĝon.","poem":1},{"lineBreak":true},{"text":"Tio estas honoro por ĉiuj Liaj fideluloj.","poem":1},{"lineBreak":true},{"text":"Haleluja!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}