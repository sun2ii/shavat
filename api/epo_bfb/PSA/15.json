{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":15,"content":[{"type":"hebrew_subtitle","content":["Psalmo de David."]},{"type":"verse","number":1,"content":[{"text":"Ho Eternulo, kiu povas gasti en Via tendo?","poem":1},{"lineBreak":true},{"text":"Kiu povas loĝi sur Via sankta monto?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tiu, kiu vivas honeste, agas juste,","poem":1},{"lineBreak":true},{"text":"Kaj parolas veron el sia koro;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kiu ne kalumnias per sia lango,","poem":1},{"lineBreak":true},{"text":"Ne faras malbonon al sia kunulo,","poem":1},{"lineBreak":true},{"text":"Kaj ne ĵetas malhonoron sur sian proksimulon;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kiu abomenas malnoblulon","poem":1},{"lineBreak":true},{"text":"Kaj estimas la respektantojn de la Eternulo,","poem":1},{"lineBreak":true},{"text":"Kiu faris ĵuron malprofite por si kaj ĝin ne rompas;","poem":1}]},{"type":"verse","number":5,