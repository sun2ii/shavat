{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":16,"content":[{"type":"hebrew_subtitle","content":["Verko de David."]},{"type":"verse","number":1,"content":[{"text":"Gardu min, ho Dio, ĉar mi rifuĝas ĉe Vi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mi diris al la Eternulo: Vi estas mia Sinjoro;","poem":1},{"lineBreak":true},{"text":"Mi ne havas alian bonon krom Vi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Al la sanktuloj, kiuj estas sur la tero,","poem":1},{"lineBreak":true},{"text":"Kaj al la majestuloj iras mia tuta deziro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Multiĝos la malĝojoj de tiuj, kiuj sekvis alian;","poem":1},{"lineBreak":true},{"text":"Mi ne verŝos iliajn sangajn verŝoferojn","poem":1},{"lineBreak":true},{"text":"Kaj ne metos iliajn nomojn en mian buŝon.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"La Eternulo estas mia sorta parto kaj kaliko;","poem":1},{"lineBreak":true},{"text":"Vi subtenas mian sorton.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Loto agrabla trafis min,","poem":1},{"lineBreak":true},{"text":"Ĉarma estas mia heredo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mi gloras la Eternulon, kiu konsilas min;","poem":1},{"lineBreak":true},{"text":"Eĉ en la nokto instruas min mia internaĵo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ĉiam mi vidas la Eternulon antaŭ mi;","poem":1},{"lineBreak":true},{"text":"Ĉar Li estas ĉe mia dekstra mano, mi ne falos.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tial ĝojas mia koro, raviĝas mia animo;","poem":1},{"lineBreak":true},{"text":"Eĉ mia karno ripozas senzorge.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ĉar Vi ne lasos mian animon al Ŝeol;","poem":1},{"lineBreak":true},{"text":"Vi ne permesos, ke Via sanktulo forputru.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Vi konigos al mi la vojon de la vivo;","poem":1},{"lineBreak":true},{"text":"Multe da ĝojoj estas antaŭ Vi,","poem":1},{"lineBreak":true},{"text":"Ĉarmoj estas en Via dekstra mano eterne.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}