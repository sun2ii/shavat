{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Kial tumultas popoloj,","poem":1},{"lineBreak":true},{"text":"Kaj gentoj pripensas vanaĵon?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Leviĝas reĝoj de la tero,","poem":1},{"lineBreak":true},{"text":"Kaj eminentuloj konsiliĝas kune,","poem":1},{"lineBreak":true},{"text":"Kontraŭ la Eternulo kaj kontraŭ Lia sanktoleito, dirante:","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ni disŝiru iliajn ligilojn,","poem":1},{"lineBreak":true},{"text":"Kaj ni deĵetu de ni iliajn ŝnurojn!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"La loĝanta en la ĉielo ridas,","poem":1},{"lineBreak":true},{"text":"La Sinjoro mokas ilin.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tiam Li parolos al ili en Sia kolero,","poem":1},{"lineBreak":true},{"text":"Kaj per Sia furiozo Li ilin ektimigos, dirante:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mi starigis ja Mian reĝon","poem":1},{"lineBreak":true},{"text":"Super Cion, Mia sankta monto.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mi raportos pri la decido:","poem":1},{"lineBreak":true},{"text":"La Eternulo diris al mi: Vi estas Mia filo,","poem":1},{"lineBreak":true},{"text":"Hodiaŭ Mi vin naskis.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Petu Min, kaj Mi donos al vi popolojn por heredo,","poem":1},{"lineBreak":true},{"text":"Kaj por posedo limojn de tero.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Vi disbatos ilin per fera sceptro,","poem":1},{"lineBreak":true},{"text":"Kiel potan vazon vi ilin dispecigos.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kaj nun, ho reĝoj, prudentiĝu;","poem":1},{"lineBreak":true},{"text":"Instruiĝu, juĝistoj de la tero!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Servu al la Eternulo kun timo,","poem":1},{"lineBreak":true},{"text":"Kaj ĝoju kun tremo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kisu la filon, ke Li ne koleru, kaj vi ne pereu sur la vojo,","poem":1},{"lineBreak":true},{"text":"Ĉar baldaŭ ekbrulos Lia kolero.","poem":1},{"lineBreak":true},{"text":"Feliĉaj estas ĉiuj, kiuj fidas Lin.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}