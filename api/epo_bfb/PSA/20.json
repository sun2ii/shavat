{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Psalmo de David."]},{"type":"verse","number":1,"content":[{"text":"La Eternulo aŭskultu vin en tago de mizero;","poem":1},{"lineBreak":true},{"text":"Defendu vin la nomo de Dio de Jakob.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Li sendu al vi helpon el la sanktejo,","poem":1},{"lineBreak":true},{"text":"Kaj el Cion Li vin fortigu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Li rememoru ĉiujn viajn oferdonojn,","poem":1},{"lineBreak":true},{"text":"Kaj via brulofero aperu grasa antaŭ Li.Sela.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Li donu al vi tion, kion deziras via koro;","poem":1},{"lineBreak":true},{"text":"Kaj ĉiujn viajn intencojn Li plenumu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ni estos gajaj pro Via venko,","poem":1},{"lineBreak":true},{"text":"Kaj pro la nomo de nia Dio ni levos standardon.","poem":1},{"lineBreak":true},{"text":"La Eternulo plenumu ĉiujn viajn petojn.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nun mi ekscias, ke la Eternulo savas Sian sanktoleiton;","poem":1},{"lineBreak":true},{"text":"Li aŭskultas lin el Sia sankta ĉielo,","poem":1},{"lineBreak":true},{"text":"Forte savas lin per Sia dekstra mano.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Unuj fidas veturilojn, aliaj ĉevalojn;","poem":1},{"lineBreak":true},{"text":"Sed ni alvokas la nomon de la Eternulo, nia Dio.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ili ŝanceliĝas kaj falas,","poem":1},{"lineBreak":true},{"text":"Kaj ni staras kaj tenas nin forte.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ho Eternulo, savu;","poem":1},{"lineBreak":true},{"text":"La Reĝo respondu al ni, kiam ni vokas al Li.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}