{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":21,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Psalmo de David."]},{"type":"verse","number":1,"content":[{"text":"Ho Eternulo, pro Via forto ĝojas la reĝo,","poem":1},{"lineBreak":true},{"text":"Kaj pro Via helpo kiel forte li triumfas!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kion lia koro deziris, tion Vi donis al li;","poem":1},{"lineBreak":true},{"text":"Kaj la peton de lia buŝo Vi ne rifuzis.Sela.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Vi antaŭvenas al li kun beno de bono;","poem":1},{"lineBreak":true},{"text":"Vi metis sur lian kapon kronon el pura oro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Vivon li petis de Vi;","poem":1},{"lineBreak":true},{"text":"Kaj Vi donis al li longan vivon por ĉiam kaj eterne.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Granda estas lia honoro pro Via helpo;","poem":1},{"lineBreak":true},{"text":"Gloron kaj majeston Vi metis sur lin.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Vi donas al li eternajn benojn;","poem":1},{"lineBreak":true},{"text":"Vi gajigas lin per ĝojo antaŭ Via vizaĝo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ĉar la reĝo fidas la Eternulon,","poem":1},{"lineBreak":true},{"text":"Kaj pro favoro de la Plejaltulo li ne falos.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Trovos Via mano ĉiujn Viajn malamikojn,","poem":1},{"lineBreak":true},{"text":"Via dekstra trovos Viajn malamantojn.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Vi similigos ilin al brulanta forno, kiam Vi koleros;","poem":1},{"lineBreak":true},{"text":"La Eternulo englutos ilin per Sia kolero,","poem":1},{"lineBreak":true},{"text":"Kaj fajro ilin formanĝos.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ilian naskitaron Vi ekstermos de sur la tero,","poem":1},{"lineBreak":true},{"text":"Kaj ilian semon el inter la homidoj.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ĉar ili preparis malbonon por Vi,","poem":1},{"lineBreak":true},{"text":"Pripensis atencon, sed ne povis ĝin plenumi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Vi devigos ilin turni al Vi la dorson,","poem":1},{"lineBreak":true},{"text":"Viajn tendenojn Vi direktos kontraŭ iliajn vizaĝojn.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Leviĝu, ho Eternulo, en Via forto;","poem":1},{"lineBreak":true},{"text":"Ni kantos kaj gloros Vian potencon.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}