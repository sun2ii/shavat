{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":24,"content":[{"type":"hebrew_subtitle","content":["Psalmo de David."]},{"type":"verse","number":1,"content":[{"text":"Al la Eternulo apartenas la tero, kaj ĉio, kio ĝin plenigas,","poem":1},{"lineBreak":true},{"text":"La mondo kaj ĉiuj ĝiaj loĝantoj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ĉar Li sur la maroj ĝin fondis","poem":1},{"lineBreak":true},{"text":"Kaj sur la akvoj ĝin fortikigis.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kiu supreniros sur la monton de la Eternulo?","poem":1},{"lineBreak":true},{"text":"Kaj kiu staros ĉe Lia sankta loko?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tiu, kiu havas purajn manojn kaj senmakulan koron,","poem":1},{"lineBreak":true},{"text":"Kiu ne fordonis sian animon al malvero","poem":1},{"lineBreak":true},{"text":"Kaj ne ĵuras trompe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Li ricevos benon de la Eternulo,","poem":1},{"lineBreak":true},{"text":"Kaj bonfarojn de Dio, lia savanto.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tio estas la gento de Liaj adorantoj,","poem":1},{"lineBreak":true},{"text":"De la serĉantoj de Via vizaĝo, ho Dio de Jakob. Sela.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Levu, pordegoj, viajn kapojn;","poem":1},{"lineBreak":true},{"text":"Kaj leviĝu, pordoj antikvaj,","poem":1},{"lineBreak":true},{"text":"Por ke eniru la Reĝo de gloro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kiu estas tiu Reĝo de gloro?","poem":1},{"lineBreak":true},{"text":"La Eternulo forta kaj potenca,","poem":1},{"lineBreak":true},{"text":"La Eternulo, la potenculo de milito.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Levu, pordegoj, viajn kapojn;","poem":1},{"lineBreak":true},{"text":"Kaj leviĝu, pordoj antikvaj,","poem":1},{"lineBreak":true},{"text":"Por ke eniru la Reĝo de gloro.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kiu estas tiu Reĝo de gloro?","poem":1},{"lineBreak":true},{"text":"La Eternulo Cebaot,","poem":1},{"lineBreak":true},{"text":"Li estas la Reĝo de gloro. Sela.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}