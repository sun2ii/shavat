{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"hebrew_subtitle","content":["De David."]},{"type":"verse","number":1,"content":[{"text":"Juĝu min, ho Eternulo, ĉar mi iris en sincereco kaj la Eternulon mi fidis;","poem":1},{"lineBreak":true},{"text":"Mi ne ŝanceliĝos.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Esploru min, ho Eternulo, kaj elprovu min;","poem":1},{"lineBreak":true},{"text":"Refandu mian internaĵon kaj mian koron.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ĉar Via favorkoreco estas antaŭ miaj okuloj;","poem":1},{"lineBreak":true},{"text":"Kaj mi marŝas en Via vero.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mi ne sidas kun homoj malveremaj,","poem":1},{"lineBreak":true},{"text":"Kaj kun falsemuloj mi ne iros.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mi malamas societon de malbonfarantoj,","poem":1},{"lineBreak":true},{"text":"Kaj kun malpiuloj mi ne sidos.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mi lavas miajn manojn per senkulpeco;","poem":1},{"lineBreak":true},{"text":"Kaj mi moviĝas ĉirkaŭ Via altaro, ho Eternulo,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Por aŭdigi laŭte gloradon","poem":1},{"lineBreak":true},{"text":"Kaj famigi ĉiujn Viajn miraklojn.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ho Eternulo, mi amas la ejon de Via domo,","poem":1},{"lineBreak":true},{"text":"Kaj la lokon, en kiu loĝas Via gloro.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ne pereigu mian animon kune kun la pekuloj,","poem":1},{"lineBreak":true},{"text":"Nek mian vivon kun la sangaviduloj,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"En kies manoj estas krimo","poem":1},{"lineBreak":true},{"text":"Kaj kies dekstra mano estas plena de subaĉetaj donacoj.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kaj mi iras en senkulpeco;","poem":1},{"lineBreak":true},{"text":"Liberigu min kaj korfavoru min.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mia piedo staras sur ebena loko;","poem":1},{"lineBreak":true},{"text":"En kunvenoj mi benos la Eternulon.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}