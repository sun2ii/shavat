{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":28,"content":[{"type":"hebrew_subtitle","content":["De David."]},{"type":"verse","number":1,"content":[{"text":"Al Vi, ho Eternulo, mi vokas;","poem":1},{"lineBreak":true},{"text":"Mia Roko, ne silentu al mi;","poem":1},{"lineBreak":true},{"text":"Se Vi silentos al mi, mi similiĝos al tiuj,","poem":1},{"lineBreak":true},{"text":"Kiuj iras en la tombon.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aŭskultu la voĉon de mia petego, kiam mi krias al Vi,","poem":1},{"lineBreak":true},{"text":"Kiam mi levas miajn manojn al Via plejsanktejo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ne kunpereigu min kune kun malpiuloj, kaj kun krimfarantoj,","poem":1},{"lineBreak":true},{"text":"Kiuj parolas pace kun siaj proksimuloj,","poem":1},{"lineBreak":true},{"text":"Dum malbono estas en ilia koro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Redonu al ili laŭ iliaj faroj kaj laŭ iliaj malbonaj agoj;","poem":1},{"lineBreak":true},{"text":"Laŭ la faroj de iliaj manoj redonu al ili;","poem":1},{"lineBreak":true},{"text":"Redonu al ili, kion ili meritas.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ĉar ili ne atentas la agojn de la Eternulo","poem":1},{"lineBreak":true},{"text":"Kaj la farojn de Liaj manoj,","poem":1},{"lineBreak":true},{"text":"Li disbatos ilin kaj ne rekonstruos.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Glorata estu la Eternulo,","poem":1},{"lineBreak":true},{"text":"Ĉar Li aŭskultis la voĉon de mia petego.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"La Eternulo estas mia forto kaj mia ŝildo;","poem":1},{"lineBreak":true},{"text":"Lin fidis mia koro, kaj Li helpis min;","poem":1},{"lineBreak":true},{"text":"Tial ekĝojas mia koro,","poem":1},{"lineBreak":true},{"text":"Kaj per mia kanto mi Lin gloros.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"La Eternulo estas ilia forto,","poem":1},{"lineBreak":true},{"text":"Li estas savanta forto por Sia sanktoleito.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Helpu Vian popolon kaj benu Vian heredon,","poem":1},{"lineBreak":true},{"text":"Kaj paŝtu kaj altigu ilin eterne.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}