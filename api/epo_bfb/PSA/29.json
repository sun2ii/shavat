{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"hebrew_subtitle","content":["Psalmo de David."]},{"type":"verse","number":1,"content":[{"text":"Tributu al la Eternulo, vi potenculoj,","poem":1},{"lineBreak":true},{"text":"Tributu al la Eternulo honoron kaj forton.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tributu al la Eternulo la honoron de Lia nomo;","poem":1},{"lineBreak":true},{"text":"Kliniĝu antaŭ la Eternulo en sankta ornamo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"La voĉo de la Eternulo iras super la akvoj;","poem":1},{"lineBreak":true},{"text":"La Dio de gloro tondras,","poem":1},{"lineBreak":true},{"text":"La Eternulo super grandaj akvoj.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"La voĉo de la Eternulo iras kun forto,","poem":1},{"lineBreak":true},{"text":"La voĉo de la Eternulo iras kun majesto.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"La voĉo de la Eternulo rompas cedrojn,","poem":1},{"lineBreak":true},{"text":"La Eternulo rompas la cedrojn de Lebanon.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Li saltigas ilin kiel bovidon,","poem":1},{"lineBreak":true},{"text":"Lebanonon kaj Sirjonon kiel bubalidon.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"La voĉo de la Eternulo elhakas fajran flamon.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"La voĉo de la Eternulo skuas dezerton,","poem":1},{"lineBreak":true},{"text":"La Eternulo skuas la dezerton Kadeŝ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"La voĉo de la Eternulo igas cervinojn naski, kaj nudigas arbarojn;","poem":1},{"lineBreak":true},{"text":"Kaj en Lia templo ĉio parolas pri Lia gloro.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"La Eternulo regis en la tempo de la diluvo,","poem":1},{"lineBreak":true},{"text":"La Eternulo restos Reĝo eterne.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"La Eternulo donos forton al Sia popolo,","poem":1},{"lineBreak":true},{"text":"La Eternulo benos Sian popolon per paco.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}