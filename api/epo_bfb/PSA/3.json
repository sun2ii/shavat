{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["Psalmo de David, kiam li forkuris de sia filo Abŝalom."]},{"type":"verse","number":1,"content":[{"text":"Ho Eternulo, kiel multaj estas miaj premantoj,","poem":1},{"lineBreak":true},{"text":"Multaj leviĝis kontraŭ mi!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Multaj diradas pri mia animo:","poem":1},{"lineBreak":true},{"text":"Ne ekzistas por li savo de Dio.Sela.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sed Vi, ho Eternulo, estas ŝildo por mi,","poem":1},{"lineBreak":true},{"text":"Mia honoro kaj levanto de mia kapo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Per mia voĉo mi vokas al la Eternulo,","poem":1},{"lineBreak":true},{"text":"Kaj Li respondas al mi de Sia sankta monto.Sela.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mi kuŝiĝas kaj endormiĝas,","poem":1},{"lineBreak":true},{"text":"Kaj mi vekiĝas, ĉar la Eternulo min subtenas.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mi ne timas miriadojn da kontraŭuloj,","poem":1},{"lineBreak":true},{"text":"Kiuj estas ĉirkaŭ mi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Leviĝu, ho Eternulo, savu min, mia Dio;","poem":1},{"lineBreak":true},{"text":"Ĉar Vi frapis al ĉiuj miaj malamikoj la vangojn,","poem":1},{"lineBreak":true},{"text":"La dentojn de la malpiuloj Vi frakasis.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ĉe la Eternulo estas la savo;","poem":1},{"lineBreak":true},{"text":"Super Via popolo estu Via beno.Sela.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}