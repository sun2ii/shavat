{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":30,"content":[{"type":"hebrew_subtitle","content":["Psalmo-kanto ĉe inaŭguro de la Domo; de David."]},{"type":"verse","number":1,"content":[{"text":"Mi gloros Vin alte, ho Eternulo,","poem":1},{"lineBreak":true},{"text":"Ĉar Vi levis min kaj Vi ne lasis miajn malamikojn triumfi super mi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ho Eternulo, mia Dio, mi vokis al Vi,","poem":1},{"lineBreak":true},{"text":"Kaj Vi min sanigis.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ho Eternulo, Vi ellevis el Ŝeol mian animon;","poem":1},{"lineBreak":true},{"text":"Vi vivigis min, ke mi ne iru en la tombon.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kantu al la Eternulo, ho Liaj piuloj,","poem":1},{"lineBreak":true},{"text":"Kaj gloru Lian sanktan nomon.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ĉar nur momenton daŭras Lia kolero,","poem":1},{"lineBreak":true},{"text":"Sed tutan vivon daŭras Lia favoro;","poem":1},{"lineBreak":true},{"text":"Vespere povas esti ploro,","poem":1},{"lineBreak":true},{"text":"Sed matene venos ĝojego.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kaj mi diris en la tempo de mia feliĉo:","poem":1},{"lineBreak":true},{"text":"Mi neniam falos.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ho Eternulo, per Via favoro Vi starigis mian monton fortike;","poem":1},{"lineBreak":true},{"text":"Sed kiam Vi kaŝis Vian vizaĝon, mi konfuziĝis.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Al Vi, ho Eternulo, mi vokis,","poem":1},{"lineBreak":true},{"text":"Kaj al la Eternulo mi preĝis:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kion utilos mia sango, se mi iros en la tombon?","poem":1},{"lineBreak":true},{"text":"Ĉu gloros Vin polvo? ĉu ĝi aŭdigos Vian veron?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aŭskultu, ho Eternulo, kaj korfavoru min;","poem":1},{"lineBreak":true},{"text":"Ho Eternulo, estu helpanto al mi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Vi anstataŭigis al mi mian plendon per danco;","poem":1},{"lineBreak":true},{"text":"Vi deprenis de mi mian sakaĵon kaj zonis min per ĝojo,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Por ke mia animo kantu al Vi kaj ne silentiĝu.","poem":1},{"lineBreak":true},{"text":"Ho Eternulo, mia Dio, eterne mi Vin gloros.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}