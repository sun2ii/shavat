{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":32,"content":[{"type":"hebrew_subtitle","content":["Instruo de David."]},{"type":"verse","number":1,"content":[{"text":"Feliĉa estas tiu, kies krimo estas pardonita, kies peko estas kovrita.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Feliĉa estas la homo, al kiu la Eternulo ne kalkulas lian kulpon","poem":1},{"lineBreak":true},{"text":"Kaj en kies spirito estas nenia malvero.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kiam mi silentis, miaj ostoj senfortiĝis","poem":1},{"lineBreak":true},{"text":"De mia ĉiutaga ploregado.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ĉar tage kaj nokte pezis sur mi Via mano;","poem":1},{"lineBreak":true},{"text":"La freŝecon de mia sukoj anstataŭis sekeco de somero. Sela.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mian pekon mi konfesis al Vi, kaj mian kulpon mi ne kaŝis;","poem":1},{"lineBreak":true},{"text":"Mi diris: Mi konfesos miajn krimojn al la Eternulo;","poem":1},{"lineBreak":true},{"text":"Kaj Vi deprenis la kulpon de mia peko. Sela.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pro tio preĝu antaŭ Vi ĉiu piulo en favora tempo,","poem":1},{"lineBreak":true},{"text":"Por ke ĉe la disverŝiĝo de grandaj akvoj ili lin ne atingu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Vi estas mia ŝirmo;","poem":1},{"lineBreak":true},{"text":"Kontraŭ sufero Vi min gardos,","poem":1},{"lineBreak":true},{"text":"Per kantoj de savo Vi min ĉirkaŭos. Sela.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mi prudentigos vin, kaj montros al vi la vojon, kiun vi devas iri;","poem":1},{"lineBreak":true},{"text":"Kun konsiloj Mi direktos sur vin Mian okulon.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ne estu kiel ĉevalo, kiel senprudenta mulo,","poem":1},{"lineBreak":true},{"text":"Al kiuj oni devas kateni la buŝon per brido kaj buŝpeco,","poem":1},{"lineBreak":true},{"text":"Alie ili ne venos al vi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Multajn frapojn havas la malpiulo;","poem":1},{"lineBreak":true},{"text":"Sed kiu fidas la Eternulon, tiun ĉirkaŭas favoro.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ĝoju pro la Eternulo, kaj gaju, ho justuloj;","poem":1},{"lineBreak":true},{"text":"Kaj triumfu ĉiuj, kiuj havas pian koron!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}