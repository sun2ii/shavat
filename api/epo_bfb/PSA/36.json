{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":36,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. De David, sklavo de la Eternulo."]},{"type":"verse","number":1,"content":[{"text":"La pekado de malpiulo parolas al lia koro;","poem":1},{"lineBreak":true},{"text":"Antaŭ liaj okuloj ne ekzistas timo antaŭ Dio.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ĉar ĝi flatas al li en liaj okuloj,","poem":1},{"lineBreak":true},{"text":"Ĝis lia pekado eltroviĝos kaj li malamiĝos.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"La paroloj de lia buŝo estas krimo kaj malvero;","poem":1},{"lineBreak":true},{"text":"Li ne volas kompreni, por fari bonon.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Krimon li pripensas sur sia kuŝejo;","poem":1},{"lineBreak":true},{"text":"Li staras sur vojo ne bona;","poem":1},{"lineBreak":true},{"text":"Malbonon li ne abomenas.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ho Eternulo, ĝis la ĉielo atingas Via boneco,","poem":1},{"lineBreak":true},{"text":"Via vereco ĝis la nuboj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Via justeco estas kiel la montoj de Dio,","poem":1},{"lineBreak":true},{"text":"Viaj juĝoj estas granda abismo;","poem":1},{"lineBreak":true},{"text":"Homon kaj bruton Vi helpas, ho Eternulo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kiel grandvalora estas Via favoro, ho Dio!","poem":1},{"lineBreak":true},{"text":"Kaj la homidoj ricevas rifuĝon en la ombro de Viaj flugiloj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ili satiĝas per la riĉa havo de Via domo,","poem":1},{"lineBreak":true},{"text":"Kaj el la rivero de Viaj bonaĵoj Vi ilin trinkigas.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ĉar ĉe Vi estas la fonto de vivo,","poem":1},{"lineBreak":true},{"text":"Kaj en Via lumo ni vidas lumon.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Venigu Vian favoron sur tiujn, kiuj Vin konas,","poem":1},{"lineBreak":true},{"text":"Kaj Vian bonecon sur la honestulojn.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ne paŝu sur min piedo de fiereco,","poem":1},{"lineBreak":true},{"text":"Kaj mano de malpiuloj ne renversu min.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tie falu la farantoj de malbono;","poem":1},{"lineBreak":true},{"text":"Ili estu renversitaj kaj ne povu sin levi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}