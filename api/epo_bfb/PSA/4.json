{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Por kordaj instrumentoj. Psalmo de David."]},{"type":"verse","number":1,"content":[{"text":"Kiam mi vokas, respondu al mi, justa mia Dio!","poem":1},{"lineBreak":true},{"text":"En premo Vi liberigas min;","poem":1},{"lineBreak":true},{"text":"Korfavoru min, kaj aŭskultu mian preĝon.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Homidoj, ĝis kiam mia honoro estos malhonorata?","poem":1},{"lineBreak":true},{"text":"Ĝis kiam vi amos vantaĵon kaj celos malveron?Sela.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sciu do, ke la Eternulo apartigis la piulon por Si;","poem":1},{"lineBreak":true},{"text":"La Eternulo aŭdas, kiam mi vokas al Li.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tremu, kaj ne peku;","poem":1},{"lineBreak":true},{"text":"Meditu en viaj koroj, sur viaj kuŝejoj, kaj estu fortikanimaj. Sela.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Oferdonu oferojn piajn,","poem":1},{"lineBreak":true},{"text":"Kaj fidu la Eternulon.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Multaj diradas: Kiu montros al ni bonon?","poem":1},{"lineBreak":true},{"text":"Direktu sur nin la lumon de Via vizaĝo, ho Eternulo!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Vi metis ĝojon en mian koron, pli ol dum ilia greno kaj ilia mosto plimultiĝas.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pace mi kuŝiĝas kaj tuj endormiĝas;","poem":1},{"lineBreak":true},{"text":"Ĉar Vi, ho Eternulo, loĝigas min sola en sendanĝereco.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}