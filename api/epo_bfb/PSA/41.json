{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":41,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Psalmo de David."]},{"type":"verse","number":1,"content":[{"text":"Feliĉa estas tiu, kiu atentas senhavulon:","poem":1},{"lineBreak":true},{"text":"En tago de mizero savos lin la Eternulo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"La Eternulo lin gardos kaj vivigos;","poem":1},{"lineBreak":true},{"text":"Li estos feliĉa sur la tero,","poem":1},{"lineBreak":true},{"text":"Kaj Vi ne transdonos lin al la volo de liaj malamikoj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"La Eternulo fortigos lin sur la lito de malsano;","poem":1},{"lineBreak":true},{"text":"Lian tutan kuŝejon Vi aliigas en la tempo de lia malsano.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mi diris: Ho Eternulo, kompatu min;","poem":1},{"lineBreak":true},{"text":"Sanigu mian animon, ĉar mi pekis antaŭ Vi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Miaj malamikoj parolas malbonon pri mi, dirante:","poem":1},{"lineBreak":true},{"text":"Kiam li mortos kaj lia nomo pereos?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kaj se iu venas, por vidi min, li parolas malsincere;","poem":1},{"lineBreak":true},{"text":"Lia koro serĉas malbonon;","poem":1},{"lineBreak":true},{"text":"Kaj, elirinte eksteren, li ĝin disparolas.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mallaŭte parolas inter si pri mi ĉiuj miaj malamikoj;","poem":1},{"lineBreak":true},{"text":"Ili pensas malbonon pri mi, dirante:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Afero pereiga atakis lin;","poem":1},{"lineBreak":true},{"text":"Kaj ĉar li kuŝiĝis, li jam ne plu leviĝos.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Eĉ mia konfidato, kiun mi fidis, kiu manĝis mian panon,","poem":1},{"lineBreak":true},{"text":"Levis kontraŭ min la piedon.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sed Vi, ho Eternulo, korfavoru min kaj restarigu min,","poem":1},{"lineBreak":true},{"text":"Por ke mi povu repagi al ili.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Per tio mi scios, ke Vi favoras min,","poem":1},{"lineBreak":true},{"text":"Se mia malamiko ne triumfos super mi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kaj min Vi subtenos pro mia senkulpeco,","poem":1},{"lineBreak":true},{"text":"Kaj Vi starigos min antaŭ Via vizaĝo por ĉiam.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Glorata estu la Eternulo, Dio de Izrael,","poem":1},{"lineBreak":true},{"text":"De eterne ĝis eterne.","poem":1},{"lineBreak":true},{"text":"Amen, kaj amen!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}