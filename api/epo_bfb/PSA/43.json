{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Juĝu min, ho Dio, kaj defendu mian aferon kontraŭ popolo nepia;","poem":1},{"lineBreak":true},{"text":"De homo malverema kaj maljusta savu min.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ĉar Vi estas la Dio de mia forto; kial Vi forpuŝis min?","poem":1},{"lineBreak":true},{"text":"Kial mi iradas malĝoja pro la premado de la malamiko?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sendu Vian lumon kaj Vian veron, ke ili min gvidu,","poem":1},{"lineBreak":true},{"text":"Ke ili alvenigu min al Via sankta monto kaj al Via loĝejo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kaj mi venos al la altaro de Dio,","poem":1},{"lineBreak":true},{"text":"Al la Dio de mia ĝojo kaj ĝuo;","poem":1},{"lineBreak":true},{"text":"Kaj mi gloros Vin per harpo, ho Dio, mia Dio.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kial vi malĝojas, ho mia animo?","poem":1},{"lineBreak":true},{"text":"Kaj kial vi konsterniĝas en mi?","poem":1},{"lineBreak":true},{"text":"Esperu al Dio;","poem":1},{"lineBreak":true},{"text":"Ĉar ankoraŭ mi dankos Lin,","poem":1},{"lineBreak":true},{"text":"La savanton de mia vizaĝo kaj mian Dion.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}