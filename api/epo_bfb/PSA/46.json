{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. De la Koraĥidoj. Por sopranuloj. Kanto."]},{"type":"verse","number":1,"content":[{"text":"Dio estas por ni rifuĝejo kaj forto,","poem":1},{"lineBreak":true},{"text":"Helpo en mizeroj, rapide trovata.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tial ni ne timas, eĉ se pereus la tero","poem":1},{"lineBreak":true},{"text":"Kaj la montoj falus en la internon de la maroj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bruu, bolu Liaj akvoj,","poem":1},{"lineBreak":true},{"text":"Tremu la montoj de ilia fiera ondado. Sela.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Estas rivero, kies torentoj ĝojigas la urbon de Dio,","poem":1},{"lineBreak":true},{"text":"La sanktan loĝejon de la Plejaltulo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dio estas en ĝia mezo, ĝi ne ŝanceliĝos;","poem":1},{"lineBreak":true},{"text":"Dio ĝin helpas en frua mateno.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ekbruis popoloj, ekŝanceliĝis regnoj;","poem":1},{"lineBreak":true},{"text":"Li sonigis Sian voĉon, kaj la tero fandiĝis.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"La Eternulo Cebaot estas kun ni;","poem":1},{"lineBreak":true},{"text":"Nia defendo estas la Dio de Jakob. Sela.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Iru, rigardu la farojn de la Eternulo,","poem":1},{"lineBreak":true},{"text":"Kiu faris detruojn sur la tero,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kiu ĉesigas militojn ĝis la fino de la tero,","poem":1},{"lineBreak":true},{"text":"Rompas pafarkon, rompas ponardegon,","poem":1},{"lineBreak":true},{"text":"Forbruligas veturilojn per fajro.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Cedu, kaj sciu, ke Mi estas Dio;","poem":1},{"lineBreak":true},{"text":"Mi estas glora inter la popoloj, Mi estas glora sur la tero.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"La Eternulo Cebaot estas kun ni;","poem":1},{"lineBreak":true},{"text":"Nia defendo estas la Dio de Jakob. Sela.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}