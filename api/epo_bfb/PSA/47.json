{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. De la Koraĥidoj. Psalmo."]},{"type":"verse","number":1,"content":[{"text":"Ĉiuj popoloj, plaŭdu per la manoj,","poem":1},{"lineBreak":true},{"text":"Kriu al Dio per voĉo de kanto.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ĉar la Eternulo Plejalta estas timinda;","poem":1},{"lineBreak":true},{"text":"Li estas granda Reĝo super la tuta tero.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Li subigas al ni popolojn","poem":1},{"lineBreak":true},{"text":"Kaj metas gentojn sub niajn piedojn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Li elektas por ni nian heredon,","poem":1},{"lineBreak":true},{"text":"La majeston de Jakob, kiun Li amas. Sela.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dio supreniras ĉe sonoj de ĝojo,","poem":1},{"lineBreak":true},{"text":"La Eternulo ĉe trumpetado.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kantu al Dio, kantu!","poem":1},{"lineBreak":true},{"text":"Kantu al nia Reĝo, kantu!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ĉar Dio estas la Reĝo de la tuta tero:","poem":1},{"lineBreak":true},{"text":"Kantu edifan kanton!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dio reĝas super la popoloj;","poem":1},{"lineBreak":true},{"text":"Dio sidas sur Sia sankta trono.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"La princoj de la popoloj kolektiĝis,","poem":1},{"lineBreak":true},{"text":"La popolo de la Dio de Abraham;","poem":1},{"lineBreak":true},{"text":"Ĉar al Dio apartenas la ŝildoj de la tero;","poem":1},{"lineBreak":true},{"text":"Li estas tre alta.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}