{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"hebrew_subtitle","content":["Kanto-psalmo de la Koraĥidoj."]},{"type":"verse","number":1,"content":[{"text":"Granda estas la Eternulo,","poem":1},{"lineBreak":true},{"text":"Kaj tre glora en la urbo de nia Dio,","poem":1},{"lineBreak":true},{"text":"Sur Lia sankta monto.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bela altaĵo, ĝojiga por la tuta tero","poem":1},{"lineBreak":true},{"text":"Estas la monto Cion, en la norda regiono,","poem":1},{"lineBreak":true},{"text":"La urbo de la granda Reĝo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dio estas konata en ĝiaj palacoj, kiel rifuĝejo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Jen kolektiĝis la reĝoj,","poem":1},{"lineBreak":true},{"text":"Sed ĉiuj kune foriris.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ili vidis kaj ekmiris,","poem":1},{"lineBreak":true},{"text":"Konfuziĝis kaj forkuris.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Teruro ilin atakis,","poem":1},{"lineBreak":true},{"text":"Tremo, kiel ĉe akuŝantino.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Per orienta vento","poem":1},{"lineBreak":true},{"text":"Vi ruinigis la ŝipojn de Tarŝiŝ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kion ni aŭdis, tion ni vidis","poem":1},{"lineBreak":true},{"text":"En la urbo de la Eternulo Cebaot, en la urbo de nia Dio;","poem":1},{"lineBreak":true},{"text":"Dio fortikigu ĝin por ĉiam! Sela.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ni meditis, ho Dio, pri Via boneco,","poem":1},{"lineBreak":true},{"text":"Interne de Via templo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kiel Via nomo, ho Dio,","poem":1},{"lineBreak":true},{"text":"Tiel Via gloro estas en la finoj de la tero;","poem":1},{"lineBreak":true},{"text":"Plena de justeco estas Via dekstra mano.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ĝoju la monto Cion,","poem":1},{"lineBreak":true},{"text":"Ĝoju la filinoj de Jehuda,","poem":1},{"lineBreak":true},{"text":"Pro Via juĝoj.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Iru ĉirkaŭ Cion kaj ĉirkaŭrigardu ĝin,","poem":1},{"lineBreak":true},{"text":"Kalkulu ĝiajn turojn.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Atentu ĝiajn fortikaĵojn,","poem":1},{"lineBreak":true},{"text":"Vizitu ĝiajn palacojn,","poem":1},{"lineBreak":true},{"text":"Por ke vi rakontu al estonta generacio.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ĉar jen estas Dio, nia Dio, por ĉiam kaj eterne;","poem":1},{"lineBreak":true},{"text":"Li estos nia kondukanto ĝis la morto.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}