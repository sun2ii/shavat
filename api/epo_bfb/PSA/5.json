{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":5,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Por blovaj instrumentoj. Psalmo de David."]},{"type":"verse","number":1,"content":[{"text":"Miajn vortojn aŭskultu, ho Eternulo.","poem":1},{"lineBreak":true},{"text":"Trapenetru miajn pensojn.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aŭdu la voĉon de mia krio, mia Reĝo kaj mia Dio;","poem":1},{"lineBreak":true},{"text":"Ĉar al Vi mi preĝas.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ho Eternulo, matene Vi aŭdas mian voĉon;","poem":1},{"lineBreak":true},{"text":"Matene mi eldiras mian preĝon al Vi, kaj mi atendas.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ĉar Vi ne estas tia Dio, kiu amas malpiaĵon;","poem":1},{"lineBreak":true},{"text":"Malbonulo ne povas gasti ĉe Vi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fanfaronuloj ne staros antaŭ Vi;","poem":1},{"lineBreak":true},{"text":"Vi malamas ĉiujn, kiuj faras malbonon.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Vi pereigas tiujn, kiuj parolas malveron;","poem":1},{"lineBreak":true},{"text":"Sangavidan kaj malican la Eternulo abomenas.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kaj mi, pro Via granda favoro, eniros en Vian domon;","poem":1},{"lineBreak":true},{"text":"Mi kliniĝos en Via sankta templo kun respektego al Vi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ho Eternulo, gvidu min laŭ Via justeco;","poem":1},{"lineBreak":true},{"text":"Pro miaj insidantoj ebenigu antaŭ mi Vian vojon.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ĉar ne ekzistas vero en ilia buŝo;","poem":1},{"lineBreak":true},{"text":"En ilia interno estas malvirteco;","poem":1},{"lineBreak":true},{"text":"Malfermita tombo estas ilia gorĝo;","poem":1},{"lineBreak":true},{"text":"Per sia lango ili hipokritas.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Montru ilian kulpon, ho Dio,","poem":1},{"lineBreak":true},{"text":"Ke ili falu per siaj intencoj;","poem":1},{"lineBreak":true},{"text":"Pro iliaj multaj krimoj ĵetu ilin malsupren,","poem":1},{"lineBreak":true},{"text":"Ĉar ili ribelis kontraŭ Vi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kaj ekĝojos ĉiuj, kiuj fidas Vin;","poem":1},{"lineBreak":true},{"text":"Ili eterne estos gajaj, kaj Vi ilin favoros;","poem":1},{"lineBreak":true},{"text":"Kaj triumfos pri Vi tiuj, kiuj amas Vian nomon.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ĉar Vi, ho Eternulo, benas piulon;","poem":1},{"lineBreak":true},{"text":"Kiel per ŝildo Vi ĉirkaŭdefendas lin per favoro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}