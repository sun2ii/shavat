{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":52,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Instruo de David, kiam venis Doeg, la Edomido, kaj raportis al Saul, kaj diris al li: David venis en la domon de Aĥimeleĥ."]},{"type":"verse","number":1,"content":[{"text":"Kial vi fanfaronas pro malbono, ho tirano?","poem":1},{"lineBreak":true},{"text":"La boneco de Dio estas ĉiama.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pereon intencas via lango,","poem":1},{"lineBreak":true},{"text":"Kiel akrigita razilo ĝi tranĉas malicon.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Vi pli amas malbonon, ol bonon;","poem":1},{"lineBreak":true},{"text":"Pli mensogi, ol diri veron. Sela.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Vi amas ĉian parolon pereigan,","poem":1},{"lineBreak":true},{"text":"Parolon malican.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tial Dio pereigos vin por ĉiam,","poem":1},{"lineBreak":true},{"text":"Elŝiros vin el via tendo,","poem":1},{"lineBreak":true},{"text":"Kaj elĵetos vin el la lando de la vivantoj. Sela.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kaj virtuloj vidos kaj ektimos,","poem":1},{"lineBreak":true},{"text":"Kaj pri li ili ridos, dirante:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Jen estas la viro, kiu ne en Dio vidis sian forton,","poem":1},{"lineBreak":true},{"text":"Sed fidis sian grandan riĉecon,","poem":1},{"lineBreak":true},{"text":"Sentis sin forta per sia malbonpovado.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kaj mi, kiel verda olivarbo en la domo de Dio,","poem":1},{"lineBreak":true},{"text":"Fidas la bonecon de Dio ĉiam kaj eterne.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mi dankos Vin eterne por tio, kion Vi faris,","poem":1},{"lineBreak":true},{"text":"Kaj mi esperos al Via nomo, ĉar Vi estas bona por Viaj fideluloj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}