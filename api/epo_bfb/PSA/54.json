{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Por kordaj instrumentoj. Instruo de David, kiam venis la Zifanoj, kaj diris al Saul: Jen David kaŝiĝas ĉe ni."]},{"type":"verse","number":1,"content":[{"text":"Ho Dio, per Via nomo helpu min,","poem":1},{"lineBreak":true},{"text":"Kaj per Via forto donu al mi justecon.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ho Dio, aŭskultu mian preĝon,","poem":1},{"lineBreak":true},{"text":"Atentu la vortojn de mia buŝo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ĉar fremduloj leviĝis kontraŭ mi,","poem":1},{"lineBreak":true},{"text":"Kaj fortuloj serĉas mian animon;","poem":1},{"lineBreak":true},{"text":"Ili ne havas Dion antaŭ si. Sela.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Jen Dio estas mia helpanto,","poem":1},{"lineBreak":true},{"text":"Mia Sinjoro estas subtenanto de mia animo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Li returnos la malbonon al miaj malamikoj:","poem":1},{"lineBreak":true},{"text":"Laŭ Via vereco ekstermu ilin.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kun volonteco mi faros al Vi oferdonon,","poem":1},{"lineBreak":true},{"text":"Mi gloros Vian nomon, ho Eternulo, ĉar ĝi estas bona;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ĉar de ĉiuj suferoj Li savis min,","poem":1},{"lineBreak":true},{"text":"Kaj venĝon sur miaj malamikoj vidas mia okulo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}