{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":56,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Por Jonatelem-reĥokim. Verko de David, kiam kaptis lin la Filiŝtoj en Gat."]},{"type":"verse","number":1,"content":[{"text":"Korfavoru min, ho Dio, ĉar homo volas min engluti,","poem":1},{"lineBreak":true},{"text":"Dum la tuta tago malamiko min premas.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Miaj malamikoj volas min engluti ĉiutage,","poem":1},{"lineBreak":true},{"text":"Ĉar multaj militas kontraŭ mi fiere.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"En la tago, kiam mi timas,","poem":1},{"lineBreak":true},{"text":"Mi fidas Vin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dion, kies vorton mi gloras,","poem":1},{"lineBreak":true},{"text":"Tiun Dion mi fidas; mi ne timas:","poem":1},{"lineBreak":true},{"text":"Kion karno faros al mi?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dum la tuta tago ili atakas miajn vortojn;","poem":1},{"lineBreak":true},{"text":"Ĉiuj iliaj pensoj pri mi estas por malbono.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ili kolektiĝas, embuskas, observas miajn paŝojn,","poem":1},{"lineBreak":true},{"text":"Penante kapti mian animon.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Por ilia malbonago repagu al ili,","poem":1},{"lineBreak":true},{"text":"En kolero faligu la popolojn, ho Dio!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mian vagadon Vi kalkulis;","poem":1},{"lineBreak":true},{"text":"Metu miajn larmojn en Vian felsakon,","poem":1},{"lineBreak":true},{"text":"Ili estas ja en Via libro.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tiam miaj malamikoj returniĝos malantaŭen en la tago, kiam mi vokos;","poem":1},{"lineBreak":true},{"text":"Tion mi scias, ke Dio estas kun mi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mi gloros vorton de Dio;","poem":1},{"lineBreak":true},{"text":"Mi gloros vorton de la Eternulo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dion mi fidas, mi ne timas:","poem":1},{"lineBreak":true},{"text":"Kion faros al mi homo?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mi faris al Vi, ho Dio, promesojn,","poem":1},{"lineBreak":true},{"text":"Mi plenumos al Vi dankoferojn.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ĉar Vi savis mian animon de la morto,","poem":1},{"lineBreak":true},{"text":"Kaj miajn piedojn de falpuŝiĝo,","poem":1},{"lineBreak":true},{"text":"Por ke mi iradu antaŭ Dio","poem":1},{"lineBreak":true},{"text":"En la lumo de la vivo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}