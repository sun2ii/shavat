{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":57,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Por Al-taŝĥet. Verko de David, kiam li forkuris de Saul en la kavernon."]},{"type":"verse","number":1,"content":[{"text":"Korfavoru min, ho Dio, korfavoru min;","poem":1},{"lineBreak":true},{"text":"Ĉar ĉe Vi rifuĝas mia animo,","poem":1},{"lineBreak":true},{"text":"Kaj sub la ombro de Viaj flugiloj mi min kaŝas,","poem":1},{"lineBreak":true},{"text":"Ĝis pasos la mizeroj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mi vokas al Dio Plejalta,","poem":1},{"lineBreak":true},{"text":"Al Dio, kiu decidas pri mi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Li sendu el la ĉielo kaj helpu min,","poem":1},{"lineBreak":true},{"text":"Li, kiu hontigas miajn persekutanton; Sela.","poem":1},{"lineBreak":true},{"text":"Dio sendu Sian favoron kaj Sian veron.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mia animo estas inter leonoj;","poem":1},{"lineBreak":true},{"text":"Mi kuŝas inter homidoj avidaj, kies dentoj estas ponardegoj kaj sagoj,","poem":1},{"lineBreak":true},{"text":"Kaj kies lango estas akra glavo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Altiĝu super la ĉielo, ho Dio;","poem":1},{"lineBreak":true},{"text":"Via gloro estu super la tuta tero.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Reton ili metis antaŭ miaj piedoj;","poem":1},{"lineBreak":true},{"text":"Ili premis mian animon;","poem":1},{"lineBreak":true},{"text":"Ili fosis antaŭ mi foson,","poem":1},{"lineBreak":true},{"text":"Sed ili mem falis en ĝin. Sela.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fortika estas mia koro, ho Dio, fortika estas mia koro;","poem":1},{"lineBreak":true},{"text":"Mi kantos kaj gloros.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Vekiĝu, mia honoro, vekiĝu, psaltero kaj harpo;","poem":1},{"lineBreak":true},{"text":"Mi vekos la matenan ĉielruĝon.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mi gloros Vin, ho mia Sinjoro, inter la popoloj;","poem":1},{"lineBreak":true},{"text":"Mi prikantos Vin inter la gentoj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ĉar granda ĝis la ĉielo estas Via boneco,","poem":1},{"lineBreak":true},{"text":"Kaj ĝis la nuboj estas Via vero.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Altiĝu super la ĉielo, ho Dio;","poem":1},{"lineBreak":true},{"text":"Via gloro estu super la tuta tero.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}