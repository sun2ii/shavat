{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":58,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Por Al-taŝĥet. Verko de David."]},{"type":"verse","number":1,"content":[{"text":"Ĉu efektive vi parolas veron, vi potenculoj?","poem":1},{"lineBreak":true},{"text":"Ĉu vi juste juĝas, homidoj?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kontraŭe, en la koro vi faras krimaĵojn,","poem":1},{"lineBreak":true},{"text":"Sur la tero vi pesas per manoj rabemaj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"De la momento de sia naskiĝo la malvirtuloj devojiĝis;","poem":1},{"lineBreak":true},{"text":"De el la ventro de sia patrino la mensogantoj ekeraris.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ilia veneno estas simila al la veneno de serpento,","poem":1},{"lineBreak":true},{"text":"De surda aspido, kiu ŝtopas sian orelon,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kiu ne aŭskultas la vortojn de sorĉistoj,","poem":1},{"lineBreak":true},{"text":"Kiel ajn lertaj en sia arto.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ho Dio, frakasu iliajn dentojn en ilia buŝo;","poem":1},{"lineBreak":true},{"text":"Frakasu la makzelojn de la junaj leonoj, ho Eternulo!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ili forverŝiĝu kiel akvo, kiu malaperas;","poem":1},{"lineBreak":true},{"text":"Kiam Li ĵetos Siajn sagojn, ili estu kiel buĉitaj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kiel limako konsumiĝanta ili malaperu,","poem":1},{"lineBreak":true},{"text":"Kiel abortaĵo virina, kiu ne vidis la sunon;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Antaŭ ol viaj kaldronoj eksentos la dornojn,","poem":1},{"lineBreak":true},{"text":"Ilin vivajn kaj freŝajn pereigu la ventego.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ĝojos la virtulo, kiam li vidos venĝon;","poem":1},{"lineBreak":true},{"text":"Li lavos siajn piedojn en la sango de la malvirtulo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kaj la homoj diros: Ekzistas rekompenco por la virtulo,","poem":1},{"lineBreak":true},{"text":"Ekzistas Dio, juĝanto sur la tero.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}