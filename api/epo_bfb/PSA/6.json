{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":6,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Por kordaj instrumentoj, por basuloj. Psalmo de David."]},{"type":"verse","number":1,"content":[{"text":"Ho Eternulo, ne en Via kolero min riproĉu,","poem":1},{"lineBreak":true},{"text":"Kaj ne en Via furiozo min punu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Korfavoru min, ho Eternulo, ĉar mi senfortiĝis;","poem":1},{"lineBreak":true},{"text":"Sanigu min, ho Eternulo, ĉar ektremis miaj ostoj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kaj mia animo forte ektremis;","poem":1},{"lineBreak":true},{"text":"Kaj Vi, ho Eternulo, ĝis kiam?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Returnu Vin, ho Eternulo, savu mian animon;","poem":1},{"lineBreak":true},{"text":"Helpu min pro Via favorkoreco.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ĉar en la morto ne ekzistas memoro pri Vi;","poem":1},{"lineBreak":true},{"text":"En Ŝeol, kiu gloros Vin?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mi laciĝis de mia ĝemado;","poem":1},{"lineBreak":true},{"text":"Ĉiun nokton mi priverŝas mian liton;","poem":1},{"lineBreak":true},{"text":"Per miaj larmoj mi malsekigas mian kuŝejon.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sekiĝis de malĝojo mia vizaĝo,","poem":1},{"lineBreak":true},{"text":"Maljuniĝis de ĉiuj miaj premantoj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Foriĝu de mi, ĉiuj, kiuj faras malbonon;","poem":1},{"lineBreak":true},{"text":"Ĉar aŭdis la Eternulo la voĉon de mia ploro.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aŭdis la Eternulo mian peton;","poem":1},{"lineBreak":true},{"text":"La Eternulo akceptos mian preĝon.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hontigitaj kaj tre teruritaj estos ĉiuj miaj malamikoj;","poem":1},{"lineBreak":true},{"text":"Ili forturniĝos kaj tuj estos hontigitaj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}