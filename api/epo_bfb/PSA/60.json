{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":60,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Por ŝuŝan-eduto. Instrua verko de David, kiam li militis kun Sirio Mezopotamia kaj kun Sirio Coba, kaj kiam Joab, revenante, batis dek du mil Edomidojn en la Valo de Salo."]},{"type":"verse","number":1,"content":[{"text":"Ho Dio, Vi forlasis nin, Vi disbatis nin;","poem":1},{"lineBreak":true},{"text":"Vi koleris; rekonsolu nin.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Vi ekskuis la teron kaj fendis ĝin;","poem":1},{"lineBreak":true},{"text":"Resanigu ĝiajn vundojn, ĉar ĝi ŝanceliĝas.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Vi sentigis al Via popolo pezan sorton;","poem":1},{"lineBreak":true},{"text":"Vi trinkigis al ni vinon senkonsciigan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sed Vi donis standardon al tiuj, kiuj Vin timas,","poem":1},{"lineBreak":true},{"text":"Por ke ili ĝin levu pro la vero. Sela.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Por ke liberiĝu Viaj amatoj,","poem":1},{"lineBreak":true},{"text":"Helpu per Via dekstra mano, kaj aŭskultu min.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dio diris en Sia sanktejo: Mi triumfos;","poem":1},{"lineBreak":true},{"text":"Mi dividos Ŝeĥemon, kaj la valon Sukot Mi mezuros.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Al Mi apartenas Gilead, al Mi apartenas Manase;","poem":1},{"lineBreak":true},{"text":"Efraim estas la forto de Mia kapo,","poem":1},{"lineBreak":true},{"text":"Jehuda estas Mia sceptro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Moab estas Mia lavopelvo;","poem":1},{"lineBreak":true},{"text":"Sur Edomon Mi ĵetos Mian ŝuon;","poem":1},{"lineBreak":true},{"text":"Super Filiŝtujo Mi triumfe krios.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kiu enkondukos min en fortikigitan urbon?","poem":1},{"lineBreak":true},{"text":"Kiu alkondukos min ĝis Edom?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ĉu ne Vi, ho Dio, forlasis nin?","poem":1},{"lineBreak":true},{"text":"Vi ne eliras, ho Dio, kun niaj militistaroj.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Donu al ni helpon kontraŭ la malamiko;","poem":1},{"lineBreak":true},{"text":"Vanta estas helpo de homo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kun Dio ni faros heroaĵojn;","poem":1},{"lineBreak":true},{"text":"Kaj Li dispremos niajn malamikojn.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":12}