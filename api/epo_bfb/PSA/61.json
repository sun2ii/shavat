{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Por korda instrumento. De David."]},{"type":"verse","number":1,"content":[{"text":"Aŭskultu, ho Dio, mian krion;","poem":1},{"lineBreak":true},{"text":"Atentu mian preĝon.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"De la fino de la tero mi vokas al Vi en la malĝojo de mia koro:","poem":1},{"lineBreak":true},{"text":"Sur rokon tro altan por mi suprenkonduku min.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ĉar Vi estis mia rifuĝejo,","poem":1},{"lineBreak":true},{"text":"Fortika turo kontraŭ malamiko.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lasu min loĝi eterne en Via tendo,","poem":1},{"lineBreak":true},{"text":"Havi rifuĝon sub la kovro de Viaj flugiloj. Sela.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ĉar Vi, ho Dio, aŭdis miajn promesojn;","poem":1},{"lineBreak":true},{"text":"Vi donis al mi la heredon de tiuj, kiuj timas Vian nomon.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aldonu tagojn al la tagoj de la reĝo,","poem":1},{"lineBreak":true},{"text":"Ke liaj jaroj daŭru multajn generaciojn.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Li restu eterne antaŭ Dio;","poem":1},{"lineBreak":true},{"text":"Boneco kaj vero laŭ Via volo lin gardu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tiel mi prikantos Vian nomon eterne,","poem":1},{"lineBreak":true},{"text":"Plenumante miajn promesojn ĉiutage.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}