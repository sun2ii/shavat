{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":62,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Por Jedutun. Psalmo de David."]},{"type":"verse","number":1,"content":[{"text":"Nur al Dio esperas mia animo;","poem":1},{"lineBreak":true},{"text":"De Li venas mia savo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nur Li estas mia fortikaĵo kaj mia savo, mia rifuĝejo;","poem":1},{"lineBreak":true},{"text":"Mi ne tute renversiĝos.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ĝis kiam vi insidos kontraŭ viro kaj ĉiuj vi penos faligi lin,","poem":1},{"lineBreak":true},{"text":"Kiel kliniĝintan muron, kiel barilon kadukan?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ili meditas nur pri tio, ke ili deĵetu lin de lia altaĵo;","poem":1},{"lineBreak":true},{"text":"Plaĉas al ili malvero;","poem":1},{"lineBreak":true},{"text":"Per la buŝo ili benas, kaj interne ili malbenas. Sela.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nur Dion fidu, mia animo;","poem":1},{"lineBreak":true},{"text":"Ĉar Li estas mia espero.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nur Li estas mia fortikaĵo kaj mia savo, mia rifuĝejo;","poem":1},{"lineBreak":true},{"text":"Mi ne renversiĝos.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"En Dio estas mia savo kaj mia honoro;","poem":1},{"lineBreak":true},{"text":"Mia forta roko, mia ŝirmo estas en Dio.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fidu Lin en ĉiu tempo, ho popolo;","poem":1},{"lineBreak":true},{"text":"Elverŝu antaŭ Li vian koron:","poem":1},{"lineBreak":true},{"text":"Dio estas nia defendo. Sela.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nur vantaĵo estas la malaltranguloj, malveraĵo estas la altranguloj;","poem":1},{"lineBreak":true},{"text":"Metitaj sur pesilon, ili ĉiuj estas malpli ol vantaĵo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ne fidu perfortaĵon, kaj rabitaĵon ne fidu vane;","poem":1},{"lineBreak":true},{"text":"Kiam kreskos riĉeco, ne atentu ĝin per via koro.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Unu vorton diris Dio,","poem":1},{"lineBreak":true},{"text":"Dufoje mi ĝin aŭdis,","poem":1},{"lineBreak":true},{"text":"Ke la forto estas ĉe Dio.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kaj Vi, ho mia Sinjoro, havas favorkorecon;","poem":1},{"lineBreak":true},{"text":"Ĉar Vi redonas al homo laŭ liaj faroj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}