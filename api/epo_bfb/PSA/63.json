{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"hebrew_subtitle","content":["Psalmo de David, kiam li estis en la dezerto de Judujo."]},{"type":"verse","number":1,"content":[{"text":"Ho Dio, mia Dio, Vin mi fervore serĉas;","poem":1},{"lineBreak":true},{"text":"Soifas pri Vi mia animo, sopiras pri Vi mia karno,","poem":1},{"lineBreak":true},{"text":"En lando seka, sensuka, kaj senakva.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mi volus vidi Vin en Via sanktejo,","poem":1},{"lineBreak":true},{"text":"Vidi Vian forton kaj gloron.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ĉar Via favoro estas pli bona ol vivo;","poem":1},{"lineBreak":true},{"text":"Miaj lipoj Vin gloras.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tiel mi Vin gloradus en la daŭro de mia vivo,","poem":1},{"lineBreak":true},{"text":"Levadus miajn manojn pro Via nomo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kvazaŭ de graso kaj oleo satiĝus mia animo,","poem":1},{"lineBreak":true},{"text":"Kaj per vortoj de kanto Vin gloradus mia buŝo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kiam mi rememoras Vin sur mia lito,","poem":1},{"lineBreak":true},{"text":"En ĉiuj partoj de la nokto mi meditas pri Vi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ĉar Vi estis por mi helpo,","poem":1},{"lineBreak":true},{"text":"Kaj en la ombro de Viaj flugiloj mi ĝojas.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mia animo algluiĝis al Vi;","poem":1},{"lineBreak":true},{"text":"Min subtenas Via dekstra mano.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kaj tiuj, kiuj penas pereigi mian animon,","poem":1},{"lineBreak":true},{"text":"Iros en la profundon subteran.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ili estos mortigitaj per glavo,","poem":1},{"lineBreak":true},{"text":"Fariĝos akiro de vulpoj.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kaj la reĝo ĝojos per Dio;","poem":1},{"lineBreak":true},{"text":"Triumfos ĉiu, kiu ĵuras al Li;","poem":1},{"lineBreak":true},{"text":"Ĉar ŝtopiĝos la buŝo de tiuj, kiuj parolas malveron.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}