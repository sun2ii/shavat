{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Psalmo de David."]},{"type":"verse","number":1,"content":[{"text":"Aŭdu, ho Dio, mian krion en mia malĝojo;","poem":1},{"lineBreak":true},{"text":"De la teruro pri malamiko gardu mian vivon.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ŝirmu min kontraŭ la konspiro de maliculoj,","poem":1},{"lineBreak":true},{"text":"Kontraŭ la amaso de krimuloj,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kiuj akrigis sian langon kiel glavon,","poem":1},{"lineBreak":true},{"text":"Direktis vortojn maldolĉajn, kvazaŭ siajn sagojn,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Por pafi kaŝe kontraŭ senkulpulon;","poem":1},{"lineBreak":true},{"text":"Subite ili pafas kontraŭ lin kaj ne timas.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ili fortikigas sin en malbona intenco,","poem":1},{"lineBreak":true},{"text":"Ili konsiliĝas, por meti sekrete retojn;","poem":1},{"lineBreak":true},{"text":"Ili diras: Kiu ilin vidos?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ili elpensas krimojn, kaŝas ilin tre zorge interne en si,","poem":1},{"lineBreak":true},{"text":"En la profundeco de la koro.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sed Dio pafos kontraŭ ilin;","poem":1},{"lineBreak":true},{"text":"Per sago subita ili estos frapitaj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kaj ili falos per sia propra lango;","poem":1},{"lineBreak":true},{"text":"Ĉiuj, kiuj ilin vidos, balancos la kapon.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kaj ektimos ĉiuj homoj,","poem":1},{"lineBreak":true},{"text":"Kaj ili rakontos la agon de Dio","poem":1},{"lineBreak":true},{"text":"Kaj komprenos Liajn farojn.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"La virtulo ĝojos per la Eternulo, kaj fidos Lin;","poem":1},{"lineBreak":true},{"text":"Kaj triumfos ĉiuj, kiuj havas pian koron.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}