{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":65,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Psalmo de David. Kanto."]},{"type":"verse","number":1,"content":[{"text":"Vin oni fidas kaj gloras, ho Dio, en Cion;","poem":1},{"lineBreak":true},{"text":"Kaj al Vi oni plenumas promesojn.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Al Vi, kiu aŭskultas preĝon,","poem":1},{"lineBreak":true},{"text":"Venas ĉiu karno.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Krimaĵoj min premas;","poem":1},{"lineBreak":true},{"text":"Niajn pekojn Vi pardonos.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Feliĉa estas tiu, kiun Vi elektas kaj alproksimigas al Vi,","poem":1},{"lineBreak":true},{"text":"Ke li loĝu en Viaj kortoj.","poem":1},{"lineBreak":true},{"text":"Ni satiĝu per la bonaĵoj de Via domo,","poem":1},{"lineBreak":true},{"text":"De Via sankta templo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Per timindaĵoj Vi respondas al ni en justeco,","poem":1},{"lineBreak":true},{"text":"Ho Dio de nia savo,","poem":1},{"lineBreak":true},{"text":"Espero de ĉiuj finoj de la tero kaj de malproksimaj maroj,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Vi, kiu fortigas montojn per Sia forto,","poem":1},{"lineBreak":true},{"text":"Kiu estas zonita per potenco,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kiu kvietigas la bruadon de maroj, la bruadon de iliaj ondoj,","poem":1},{"lineBreak":true},{"text":"Kaj la tumulton de popoloj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kaj ektimos pro Viaj mirakloj la loĝantoj de la limoj;","poem":1},{"lineBreak":true},{"text":"La lokojn de la sunleviĝo kaj sunsubiro Vi ĝojigas.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Vi memoras pri la tero,","poem":1},{"lineBreak":true},{"text":"Kaj Vi donas al ĝi akvon, kaj Vi forte ĝin riĉigas;","poem":1},{"lineBreak":true},{"text":"La torento de Dio estas plena de akvo;","poem":1},{"lineBreak":true},{"text":"Vi pretigas ĝian panon, ĉar tiel Vi ĝin aranĝis.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Vi donas trinkon al ĝiaj sulkoj,","poem":1},{"lineBreak":true},{"text":"Vi ebenigas ĝiajn bulojn;","poem":1},{"lineBreak":true},{"text":"Per pluvego Vi ĝin moligas,","poem":1},{"lineBreak":true},{"text":"Vi benas ĝiajn kreskaĵojn.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Vi kronas la jaron per Via bono;","poem":1},{"lineBreak":true},{"text":"Kaj la signoj de Viaj piedoj gutas per graso.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"La stepoj de dezerto grasiĝas,","poem":1},{"lineBreak":true},{"text":"Kaj la montetoj zoniĝas per ĝojo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"La herbejoj kovriĝas per brutaroj,","poem":1},{"lineBreak":true},{"text":"Kaj la kampoj vestiĝas per greno;","poem":1},{"lineBreak":true},{"text":"Ili ĝojas kaj kantas.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}