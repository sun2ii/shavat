{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":66,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Kanto-psalmo."]},{"type":"verse","number":1,"content":[{"text":"Ĝoje kriu al Dio tuta la tero.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Muziku la gloron de Lia nomo,","poem":1},{"lineBreak":true},{"text":"Faru honoron al Lia gloro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Diru al Dio: Kiel timindaj estas Viaj faroj!","poem":1},{"lineBreak":true},{"text":"Pro Via granda forto kaŝiĝas antaŭ Vi Viaj malamikoj.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"La tuta tero kliniĝas antaŭ Vi kaj kantas al Vi,","poem":1},{"lineBreak":true},{"text":"Kantas Vian nomon. Sela.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Venu, kaj rigardu la farojn de Dio,","poem":1},{"lineBreak":true},{"text":"Kiu estas timinda pro Siaj faroj inter la homidoj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Li faris el maro sekan teron;","poem":1},{"lineBreak":true},{"text":"Riveron oni transpaŝis piede;","poem":1},{"lineBreak":true},{"text":"Tie ni ĝojis pro Li.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Li regas per Sia potenco eterne;","poem":1},{"lineBreak":true},{"text":"Liaj okuloj rigardas la popolojn;","poem":1},{"lineBreak":true},{"text":"La ribelantoj ne leviĝu. Sela.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Laŭdu, ho popoloj, nian Dion,","poem":1},{"lineBreak":true},{"text":"Kaj laŭte aŭdigu Lian gloron.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Li donis vivon al nia animo,","poem":1},{"lineBreak":true},{"text":"Kaj ne lasis falŝanceliĝi nian piedon.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ĉar Vi esploris nin, ho Dio;","poem":1},{"lineBreak":true},{"text":"Vi refandis nin, kiel oni refandas arĝenton.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Vi enirigis nin en kaptilon,","poem":1},{"lineBreak":true},{"text":"Vi metis ŝarĝon sur niajn lumbojn;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Vi rajdigis homojn sur niaj kapoj;","poem":1},{"lineBreak":true},{"text":"Ni trapasis fajron kaj akvon,","poem":1},{"lineBreak":true},{"text":"Sed Vi elirigis nin en bonstaton.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mi eniros en Vian domon kun bruloferoj;","poem":1},{"lineBreak":true},{"text":"Mi plenumos al Vi miajn promesojn,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kiujn eligis miaj lipoj kaj elparolis mia buŝo,","poem":1},{"lineBreak":true},{"text":"Kiam mi estis en premo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Grasajn bruloferojn mi alportos al Vi kun fumo de virŝafoj;","poem":1},{"lineBreak":true},{"text":"Mi oferos bovidojn kaj kaprojn. Sela.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Venu, aŭskultu, ĉiuj, kiuj timas Dion;","poem":1},{"lineBreak":true},{"text":"Kaj mi rakontos, kion Li faris por mia animo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Al Li mi vokis per mia buŝo,","poem":1},{"lineBreak":true},{"text":"Kaj Lia glorado estis sub mia lango.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Se mi vidus maljustaĵon en mia koro,","poem":1},{"lineBreak":true},{"text":"Mia Sinjoro min ne aŭskultus;","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Sed Dio aŭskultis,","poem":1},{"lineBreak":true},{"text":"Li atentis la voĉon de mia preĝo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Glorata estu Dio,","poem":1},{"lineBreak":true},{"text":"Kiu ne forpuŝis mian preĝon kaj ne rifuzis al mi Sian bonecon.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}