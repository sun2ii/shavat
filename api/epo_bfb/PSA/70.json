":1},{"lineBreak":true},{"text":"Ho Dio, rapidu al mi.","poem":1},{"lineBreak":true},{"text":"Vi estas mia helpo kaj mia savanto;","poem":1},{"lineBreak":true},{"text":"Ho Eternulo, ne malrapidu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}