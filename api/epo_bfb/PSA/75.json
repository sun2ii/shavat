{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Por Al-taŝĥet. Psalmo de Asaf. Kanto."]},{"type":"verse","number":1,"content":[{"text":"Ni gloras Vin, ho Dio, ni gloras Vin;","poem":1},{"lineBreak":true},{"text":"Proksima estas Via nomo;","poem":1},{"lineBreak":true},{"text":"Oni rakontas Viajn miraklojn.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kiam Mi elektos tempon,","poem":1},{"lineBreak":true},{"text":"Mi faros justan juĝon.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tremas la tero kaj ĉiuj ĝiaj loĝantoj;","poem":1},{"lineBreak":true},{"text":"Mi fortikigis ĝiajn kolonojn. Sela.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mi diras al la fanfaronuloj: Ne fanfaronu;","poem":1},{"lineBreak":true},{"text":"Kaj al la malvirtuloj: Ne levu kornon;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ne levu supren vian kornon,","poem":1},{"lineBreak":true},{"text":"Ne parolu kun nefleksebla kolo;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ĉar ne de oriento kaj ne de okcidento","poem":1},{"lineBreak":true},{"text":"Kaj ne de la dezerto venas alteco.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nur Dio estas juĝanto;","poem":1},{"lineBreak":true},{"text":"Unu homon Li malaltigas, kaj alian Li altigas.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ĉar la pokalo estas en la mano de la Eternulo,","poem":1},{"lineBreak":true},{"text":"Kaj la vino ŝaŭmas, plena de aromaĵo, kaj Li verŝas el ĝi;","poem":1},{"lineBreak":true},{"text":"Sed nur ĝian feĉon elsuĉos kaj trinkos ĉiuj malvirtuloj de la tero.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kaj mi eterne predikos,","poem":1},{"lineBreak":true},{"text":"Mi kantos al la Dio de Jakob.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kaj ĉiujn kornojn de la malvirtuloj mi rompos;","poem":1},{"lineBreak":true},{"text":"Altiĝos la kornoj de virtulo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}