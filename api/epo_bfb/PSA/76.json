{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":76,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Por kordaj instrumentoj. Psalmo de Asaf. Kanto."]},{"type":"verse","number":1,"content":[{"text":"Dio estas konata en Judujo;","poem":1},{"lineBreak":true},{"text":"Granda estas Lia nomo en Izrael.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"En Salem estas Lia tendo,","poem":1},{"lineBreak":true},{"text":"Kaj Lia loĝejo sur Cion.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tie Li rompis la sagojn de pafarko,","poem":1},{"lineBreak":true},{"text":"Ŝildon, glavon, kaj militon. Sela.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Vi estas majesta kaj potenca sur la sovaĝbestaj montoj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Senarmiĝis la fortkoruloj, endormiĝis;","poem":1},{"lineBreak":true},{"text":"Kaj ĉiuj militistoj restis kvazaŭ sen manoj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"De Via minaco, ho Dio de Jakob,","poem":1},{"lineBreak":true},{"text":"Paraliziĝis rajdisto kaj ĉevalo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Vi, Vi estas timinda;","poem":1},{"lineBreak":true},{"text":"Kaj kiu restos staranta antaŭ Vi, kiam ekflamas Via kolero?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"El la ĉielo Vi aŭdigis juĝon;","poem":1},{"lineBreak":true},{"text":"La tero ektimis kaj eksilentis,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kiam Dio leviĝis, por juĝi,","poem":1},{"lineBreak":true},{"text":"Por savi ĉiujn humilulojn sur la tero. Sela.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ĉar la kolero de homo fariĝas Via gloro,","poem":1},{"lineBreak":true},{"text":"Kiam Vi zonas Vin per la resto de Via kolero.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Faru kaj plenumu promesojn al la Eternulo, via Dio;","poem":1},{"lineBreak":true},{"text":"Vi ĉiuj, kiuj Lin ĉirkaŭas, alportu donacojn al la Timindulo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Li humiligis la spiriton de potenculoj;","poem":1},{"lineBreak":true},{"text":"Li estas timinda por la reĝoj de la tero.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}