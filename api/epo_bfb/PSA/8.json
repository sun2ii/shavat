{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Por la gitito. Psalmo de David."]},{"type":"verse","number":1,"content":[{"text":"Ho Eternulo, nia Sinjoro,","poem":1},{"lineBreak":true},{"text":"Kiel majesta estas Via nomo sur la tuta tero!","poem":1},{"lineBreak":true},{"text":"Vi levis Vian gloron super la ĉielon.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Per la buŝo de junaj infanoj kaj suĉinfanoj","poem":1},{"lineBreak":true},{"text":"Vi fondis al Vi potencon kontraŭ Viaj malamikoj,","poem":1},{"lineBreak":true},{"text":"Por kvietigi la malamikon kaj la venĝemulon.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kiam mi rigardas Vian ĉielon, la faron de Viaj fingroj,","poem":1},{"lineBreak":true},{"text":"La lunon kaj la stelojn, kiujn Vi estigis:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kio estas homo, ke Vi lin memoras?","poem":1},{"lineBreak":true},{"text":"Kio estas homido, ke Vi pensas pri li?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Vi malaltigis lin malmulte antaŭ Dio;","poem":1},{"lineBreak":true},{"text":"Per honoro kaj beleco Vi lin kronis.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Vi faris lin reganto super la faritaĵoj de Viaj manoj;","poem":1},{"lineBreak":true},{"text":"Ĉion Vi metis sub liajn piedojn:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ŝafojn kaj bovojn ĉiujn","poem":1},{"lineBreak":true},{"text":"Kaj ankaŭ la sovaĝajn bestojn,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"La birdojn de la ĉielo kaj la fiŝojn de la maro,","poem":1},{"lineBreak":true},{"text":"Ĉion, kio iras la vojojn de la maroj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ho Eternulo, nia Sinjoro,","poem":1},{"lineBreak":true},{"text":"Kiel majesta estas Via nomo sur la tuta tero!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}