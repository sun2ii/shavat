{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":81,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Por la gitito. De Asaf."]},{"type":"verse","number":1,"content":[{"text":"Laŭte kantu al Dio, nia forto;","poem":1},{"lineBreak":true},{"text":"Ĝoje kriu al la Dio de Jakob.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sonigu kanton, donu tamburinon,","poem":1},{"lineBreak":true},{"text":"Ĉarman harpon, kaj psalteron.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Muziku per korno en novmonato,","poem":1},{"lineBreak":true},{"text":"Je la plenluno, en la tago de nia festo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ĉar ĝi estas leĝo por Izrael","poem":1},{"lineBreak":true},{"text":"Kaj ordono de la Dio de Jakob.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Li aranĝis ĝin kiel ateston por Jozef,","poem":1},{"lineBreak":true},{"text":"Kiam Li eliris kontraŭ la landon Egiptan.","poem":1},{"lineBreak":true},{"text":"Lingvon, kiun mi ne konas, mi aŭdis:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mi liberigis lian dorson de ŝarĝo,","poem":1},{"lineBreak":true},{"text":"Liaj manoj liberiĝis de korboj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"En la mizero vi vokis, kaj Mi vin helpis;","poem":1},{"lineBreak":true},{"text":"Mi respondis al vi en mistera loko de tondro;","poem":1},{"lineBreak":true},{"text":"Mi esploris vin ĉe la akvo de Malpaco. Sela.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aŭdu, ho Mia popolo, Mi atestos al vi;","poem":1},{"lineBreak":true},{"text":"Ho Izrael, se vi Min aŭskultus!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ne estu ĉe vi alia dio;","poem":1},{"lineBreak":true},{"text":"Kaj ne adoru fremdan dion.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mi estas la Eternulo, via Dio,","poem":1},{"lineBreak":true},{"text":"Kiu elkondukis vin el la lando Egipta;","poem":1},{"lineBreak":true},{"text":"Malfermu larĝe vian buŝon, kaj Mi ĝin plenigos.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sed Mia popolo ne aŭskultis Mian voĉon,","poem":1},{"lineBreak":true},{"text":"Izrael ne obeis Min.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kaj Mi lasis ilin al la kaprico de ilia koro,","poem":1},{"lineBreak":true},{"text":"Ke ili iru laŭ siaj intencoj.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ho, se Mia popolo aŭskultus Min,","poem":1},{"lineBreak":true},{"text":"Se Izrael irus per Miaj vojoj!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Rapide Mi faligus iliajn malamikojn,","poem":1},{"lineBreak":true},{"text":"Kaj kontraŭ iliajn premantojn Mi direktus Mian manon.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"La malamantoj de la Eternulo humiliĝus antaŭ Li,","poem":1},{"lineBreak":true},{"text":"Kaj ilia bonstato estus eterna.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kaj Mi manĝigus al ili grason de tritiko,","poem":1},{"lineBreak":true},{"text":"Kaj Mi satigus vin per mielo el roko.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}