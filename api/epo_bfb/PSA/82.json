{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["Psalmo de Asaf."]},{"type":"verse","number":1,"content":[{"text":"Dio stariĝis en Dia anaro;","poem":1},{"lineBreak":true},{"text":"Inter la dioj Li juĝas.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ĝis kiam vi juĝos maljuste,","poem":1},{"lineBreak":true},{"text":"Kaj privilegios la personojn de malvirtuloj? Sela.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Estu justaj al malriĉulo kaj orfo;","poem":1},{"lineBreak":true},{"text":"Rilate afliktiton kaj senhavulon estu virtaj.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Liberigu malriĉulon kaj mizerulon;","poem":1},{"lineBreak":true},{"text":"El la mano de malvirtulo ilin savu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ili ne scias kaj ne komprenas,","poem":1},{"lineBreak":true},{"text":"En mallumo ili marŝas;","poem":1},{"lineBreak":true},{"text":"Ekŝanceliĝis ĉiuj fundamentoj de la tero.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mi diris: Vi estas dioj,","poem":1},{"lineBreak":true},{"text":"Kaj ĉiuj vi estas filoj de la Plejaltulo;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sed vi mortos, kiel homoj,","poem":1},{"lineBreak":true},{"text":"Kaj vi falos, kiel ĉiu el la potenculoj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Leviĝu, ho Dio, juĝu la teron;","poem":1},{"lineBreak":true},{"text":"Ĉar Vi heredas ĉiujn popolojn.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}