{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":83,"content":[{"type":"hebrew_subtitle","content":["Kanto-psalmo de Asaf."]},{"type":"verse","number":1,"content":[{"text":"Ho Dio, ne silentu;","poem":1},{"lineBreak":true},{"text":"Ne estu senparola kaj ne restu trankvila, ho Dio!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ĉar jen Viaj malamikoj ekbruis,","poem":1},{"lineBreak":true},{"text":"Kaj Viaj malamantoj levis la kapon.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kontraŭ Via popolo ili sekrete konspiras,","poem":1},{"lineBreak":true},{"text":"Kaj ili konsiliĝas kontraŭ Viaj gardatoj.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ili diris: Ni iru, kaj ni ekstermu ilin el inter la popoloj,","poem":1},{"lineBreak":true},{"text":"Ke oni ne plu rememoru la nomon de Izrael.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ĉar ili unuanime interkonsentis,","poem":1},{"lineBreak":true},{"text":"Ili faris interligon kontraŭ Vi:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"La tendoj de Edom kaj la Iŝmaelidoj,","poem":1},{"lineBreak":true},{"text":"Moab kaj la Hagaridoj,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gebal kaj Amon kaj Amalek,","poem":1},{"lineBreak":true},{"text":"La Filiŝtoj kun la loĝantoj de Tiro;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ankaŭ Asirio aliĝis al ili","poem":1},{"lineBreak":true},{"text":"Kaj fariĝis helpo al la idoj de Lot. Sela.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Faru al ili, kiel al Midjan,","poem":1},{"lineBreak":true},{"text":"Kiel al Sisera, kiel al Jabin ĉe la torento Kiŝon,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kiuj estis ekstermitaj en En-Dor","poem":1},{"lineBreak":true},{"text":"Kaj fariĝis sterko por la tero.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Agu kun iliaj princoj kiel kun Oreb kaj Zeeb,","poem":1},{"lineBreak":true},{"text":"Kaj kun ĉiuj iliaj estroj kiel kun Zebaĥ kaj Calmuna,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kiuj diris: Ni ekposedu la loĝejon de Dio!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ho mia Dio, similigu ilin al turniĝanta polvo,","poem":1},{"lineBreak":true},{"text":"Al pajlrestaĵo antaŭ vento.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kiel fajro bruligas arbaron,","poem":1},{"lineBreak":true},{"text":"Kaj kiel flamo bruldezertigas montojn,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tiel pelu ilin per Via ventego,","poem":1},{"lineBreak":true},{"text":"Kaj per Via fulmotondro ilin timigu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Plenigu ilian vizaĝon per malhonoro,","poem":1},{"lineBreak":true},{"text":"Por ke ili turniĝu al Via nomo, ho Eternulo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ili estu hontigitaj kaj timigitaj por ĉiam,","poem":1},{"lineBreak":true},{"text":"Ili malhonoriĝu kaj pereu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kaj ili eksciu, ke Vi, kies nomo estas ETERNULO,","poem":1},{"lineBreak":true},{"text":"Estas sola Plejaltulo super la tuta tero.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}