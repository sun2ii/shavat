{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":84,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Por la gitito. Psalmo de la Koraĥidoj."]},{"type":"verse","number":1,"content":[{"text":"Kiel ĉarmaj estas Viaj loĝejoj, ho Eternulo Cebaot!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mia animo deziras kaj sopiras al la kortoj de la Eternulo;","poem":1},{"lineBreak":true},{"text":"Mia koro kaj mia korpo sentas ravon pri la viva Dio.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Eĉ birdo trovas domon kaj hirundo neston por si,","poem":1},{"lineBreak":true},{"text":"En kiu ĝi tenas siajn idojn:","poem":1},{"lineBreak":true},{"text":"Viajn altarojn, ho Eternulo Cebaot, mia Reĝo kaj mia Dio.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Feliĉaj estas tiuj, kiuj loĝas en Via domo:","poem":1},{"lineBreak":true},{"text":"Ili laŭdas Vin konstante. Sela.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Feliĉaj estas la homoj, kies forto estas en Vi,","poem":1},{"lineBreak":true},{"text":"Kaj en kies koro estas Viaj vojoj;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kiuj pasas tra la Valo de Ploro kaj faras tie fontojn,","poem":1},{"lineBreak":true},{"text":"Kaj la printempa pluvo ĝin kovras per benoj;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ili iras de forto al forto,","poem":1},{"lineBreak":true},{"text":"Aperas antaŭ Dio sur Cion.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ho Eternulo, Dio Cebaot, aŭdu mian preĝon;","poem":1},{"lineBreak":true},{"text":"Aŭskultu, ho Dio de Jakob! Sela.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nia ŝildo, vidu, ho Dio,","poem":1},{"lineBreak":true},{"text":"Kaj rigardu la vizaĝon de Via sanktoleito.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ĉar tago en Viaj kortoj estas pli bona, ol mil aliaj:","poem":1},{"lineBreak":true},{"text":"Mi preferas stari sur la sojlo de la domo de mia Dio,","poem":1},{"lineBreak":true},{"text":"Ol loĝi en tendoj de malvirto.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ĉar Dio, la Eternulo, estas suno kaj ŝildo;","poem":1},{"lineBreak":true},{"text":"Favoron kaj honoron donas la Eternulo;","poem":1},{"lineBreak":true},{"text":"Li ne domaĝas bonon al tiuj, kiuj iras en virto.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ho Eternulo Cebaot, bone estas al la homo, kiu Vin fidas.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}