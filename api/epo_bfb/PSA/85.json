{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":85,"content":[{"type":"hebrew_subtitle","content":["Al la ĥorestro. Psalmo de la Koraĥidoj."]},{"type":"verse","number":1,"content":[{"text":"Vi korfavoris, ho Eternulo, Vian landon,","poem":1},{"lineBreak":true},{"text":"Vi revenigis la forkaptitojn de Jakob;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Vi pardonis la kulpon de Via popolo,","poem":1},{"lineBreak":true},{"text":"Vi kovris ĉiujn ĝiajn pekojn. Sela.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Vi retenis Vian tutan koleron,","poem":1},{"lineBreak":true},{"text":"Forlasis Vian furiozon.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Turnu Vin al ni, ho Dio de nia savo,","poem":1},{"lineBreak":true},{"text":"Kaj ĉesigu Vian koleron kontraŭ ni.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ĉu eterne Vi nin koleros,","poem":1},{"lineBreak":true},{"text":"Daŭrigos Vian koleron de generacio al generacio?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ĉu Vi ne revivigos nin denove,","poem":1},{"lineBreak":true},{"text":"Ke Via popolo ĝoju per Vi?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aperigu al ni, ho Eternulo, Vian favoron,","poem":1},{"lineBreak":true},{"text":"Kaj Vian helpon donu al ni.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mi aŭdu, kion diras Dio, la Eternulo;","poem":1},{"lineBreak":true},{"text":"Ĉar Li deklaros pacon al Sia popolo kaj al Siaj fideluloj,","poem":1},{"lineBreak":true},{"text":"Ke ili ne reiru al malsaĝeco.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Jam proksima estas Lia helpo al tiuj, kiuj Lin timas,","poem":1},{"lineBreak":true},{"text":"Por ke ekregu honoro en nia lando.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bono kaj vero renkontiĝas,","poem":1},{"lineBreak":true},{"text":"Justeco kaj paco sin kisas.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Vero elkreskas el la tero,","poem":1},{"lineBreak":true},{"text":"Kaj justeco rigardas el la ĉielo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kaj la Eternulo donos bonon,","poem":1},{"lineBreak":true},{"text":"Kaj nia tero donos siajn produktojn.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Justeco iros antaŭ Li","poem":1},{"lineBreak":true},{"text":"Kaj faros vojon por Liaj paŝoj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}