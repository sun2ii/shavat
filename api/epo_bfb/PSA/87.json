{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["De la Koraĥidoj. Psalmo-kanto."]},{"type":"verse","number":1,"content":[{"text":"Lia fundamento estas sur la sanktaj montoj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"La Eternulo amas la pordegojn de Cion","poem":1},{"lineBreak":true},{"text":"Pli ol ĉiujn loĝejojn de Jakob.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gloraĵojn Li rakontas pri vi, ho urbo de Dio. Sela.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mi parolas al miaj konatoj pri Egiptujo kaj Babel,","poem":1},{"lineBreak":true},{"text":"Ankaŭ pri Filiŝtujo kaj Tiro kun Etiopujo:","poem":1},{"lineBreak":true},{"text":"Jen tiu tie naskiĝis.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sed pri Cion oni diras: Tiu kaj tiu tie naskiĝis,","poem":1},{"lineBreak":true},{"text":"Kaj Li, la Plejaltulo, ĝin fortikigas.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"La Eternulo notos, enskribante la popolojn:","poem":1},{"lineBreak":true},{"text":"Ĉi tiu tie naskiĝis. Sela.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kaj la kantistoj kaj muzikistoj:","poem":1},{"lineBreak":true},{"text":"Ĉiuj miaj fontoj estas en Vi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}