{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":90,"content":[{"type":"hebrew_subtitle","content":["Preĝo de Moseo, homo de Dio."]},{"type":"verse","number":1,"content":[{"text":"Mia Sinjoro, Vi estis por ni loĝejo","poem":1},{"lineBreak":true},{"text":"De generacio al generacio.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Antaŭ ol la montoj naskiĝis","poem":1},{"lineBreak":true},{"text":"Kaj Vi kreis la teron kaj la mondon,","poem":1},{"lineBreak":true},{"text":"Kaj de eterne ĝis eterne, Vi estas Dio.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Vi venigas homon al polvo;","poem":1},{"lineBreak":true},{"text":"Kaj Vi diras: Revenu, homidoj.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ĉar mil jaroj estas en Viaj okuloj","poem":1},{"lineBreak":true},{"text":"Kiel la hieraŭa tago, kiu pasis,","poem":1},{"lineBreak":true},{"text":"Kaj kiel nokta gardoparto.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Vi forfluigas ilin torente, ili estas kiel sonĝo;","poem":1},{"lineBreak":true},{"text":"Matene ili renoviĝas kiel herbo:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Matene ĝi floras kaj ĝermas,","poem":1},{"lineBreak":true},{"text":"Vespere ĝi dehakiĝas kaj sekiĝas.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Jes, ni pereas de Via kolero,","poem":1},{"lineBreak":true},{"text":"Kaj de Via kolerego ni neniiĝas.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Vi metis niajn malbonagojn antaŭ Vin,","poem":1},{"lineBreak":true},{"text":"Nian kaŝitaĵon antaŭ la lumon de Via vizaĝo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ĉar ĉiuj niaj tagoj pasis sub Via kolero,","poem":1},{"lineBreak":true},{"text":"Malaperis niaj jaroj, kiel sono.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"La daŭro de nia vivo estas sepdek jaroj,","poem":1},{"lineBreak":true},{"text":"Kaj ĉe forteco okdek jaroj;","poem":1},{"lineBreak":true},{"text":"Kaj ilia tuta majesto estas penado kaj suferado,","poem":1},{"lineBreak":true},{"text":"Ĉar ĝi forkuras rapide kaj ni forflugas.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kiu scias la forton de Via kolero,","poem":1},{"lineBreak":true},{"text":"Vian timindecon kaj Vian indignon?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Instruu nin kalkuli niajn tagojn,","poem":1},{"lineBreak":true},{"text":"Por ke ni akiru saĝan koron.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Returnu Vin, ho Eternulo! Kiel longe?","poem":1},{"lineBreak":true},{"text":"Kaj kompatu Viajn sklavojn.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Satigu nin matene per Via boneco;","poem":1},{"lineBreak":true},{"text":"Kaj ni kantos kaj ĝojos en la daŭro de nia tuta vivo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ĝojigu nin tiel longe, kiel Vi nin premis,","poem":1},{"lineBreak":true},{"text":"Tiom da jaroj, kiom ni vidis mizeron.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Al Viaj sklavoj aperu Viaj faroj,","poem":1},{"lineBreak":true},{"text":"Kaj Via beleco al iliaj infanoj.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kaj la favoro de la Eternulo, nia Dio, estu super ni;","poem":1},{"lineBreak":true},{"text":"Kaj la faron de niaj manoj fortikigu al ni,","poem":1},{"lineBreak":true},{"text":"Kaj fortikigu la faron de niaj manoj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}