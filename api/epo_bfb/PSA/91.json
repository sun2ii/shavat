{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":91,"content":[{"type":"verse","number":1,"content":[{"text":"Kiu loĝas sub la ŝirmo de la Plejaltulo,","poem":1},{"lineBreak":true},{"text":"Tiu ripozas en la ombro de la Plejpotenculo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mi diras al la Eternulo: Mia rifuĝejo kaj mia fortikaĵo","poem":1},{"lineBreak":true},{"text":"Estas Dio, kiun mi fidas.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ĉar Li savos vin de la reto de kaptisto,","poem":1},{"lineBreak":true},{"text":"De la pereiga pesto.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Per Siaj plumoj Li ŝirmos vin,","poem":1},{"lineBreak":true},{"text":"Kaj sub Liaj flugiloj vi rifuĝos;","poem":1},{"lineBreak":true},{"text":"Lia fideleco estas ŝildo kaj kiraso.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ne timu la teruron de nokto,","poem":1},{"lineBreak":true},{"text":"Nek sagon, kiu flugas tage,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nek peston, kiu iras en mallumo,","poem":1},{"lineBreak":true},{"text":"Nek epidemion, kiu ekstermas tagmeze.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ĉe via flanko falos milo,","poem":1},{"lineBreak":true},{"text":"Kaj dek miloj ĉe via dekstra flanko;","poem":1},{"lineBreak":true},{"text":"Sed vin ĝi ne tuŝos.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Vi nur rigardos per viaj okuloj,","poem":1},{"lineBreak":true},{"text":"Kaj vi vidos la redonon al la malvirtuloj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ĉar Vi, ho Eternulo, estas mia defendo!","poem":1},{"lineBreak":true},{"text":"La Plejaltulon vi elektis kiel vian rifuĝejon.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ne trafos vin malbono,","poem":1},{"lineBreak":true},{"text":"Kaj frapo ne atingos vian tendon.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ĉar al Siaj anĝeloj Li ordonis pri vi,","poem":1},{"lineBreak":true},{"text":"Ke ili vin gardu sur ĉiuj viaj vojoj.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sur la manoj ili vin portos,","poem":1},{"lineBreak":true},{"text":"Por ke vi ne falpuŝiĝu sur ŝtono per via piedo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sur leonon kaj aspidon vi paŝos,","poem":1},{"lineBreak":true},{"text":"Vi piedpremos leonidon kaj drakon.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ĉar li ekamis Min, tial Mi lin savos;","poem":1},{"lineBreak":true},{"text":"Mi defendos lin, ĉar li konas Mian nomon.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Li vokos Min, kaj Mi lin aŭskultos;","poem":1},{"lineBreak":true},{"text":"Mi estos kun li en mizero;","poem":1},{"lineBreak":true},{"text":"Mi lin liberigos kaj honoratigos.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mi satigos lin per longa vivo,","poem":1},{"lineBreak":true},{"text":"Kaj aperigos al li Mian helpon.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}