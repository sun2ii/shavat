{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":92,"content":[{"type":"hebrew_subtitle","content":["Psalmo-kanto por la tago sabata."]},{"type":"verse","number":1,"content":[{"text":"Bone estas glori la Eternulon","poem":1},{"lineBreak":true},{"text":"Kaj prikanti Vian nomon, ho Plejaltulo;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rakonti matene pri Via boneco","poem":1},{"lineBreak":true},{"text":"Kaj nokte pri Via fideleco,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sur dekkorda instrumento kaj sur psaltero,","poem":1},{"lineBreak":true},{"text":"Per solenaj sonoj de harpo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ĉar Vi ĝojigis min, ho Eternulo, per Viaj agoj;","poem":1},{"lineBreak":true},{"text":"La farojn de Viaj manoj mi prikantos.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kiel grandaj estas Viaj faroj, ho Eternulo!","poem":1},{"lineBreak":true},{"text":"Tre profundaj estas Viaj pensoj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Malklerulo ne scias,","poem":1},{"lineBreak":true},{"text":"Kaj malsaĝulo tion ne komprenas.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kiam malvirtuloj verdestas kiel herbo","poem":1},{"lineBreak":true},{"text":"Kaj ĉiuj malbonaguloj floras,","poem":1},{"lineBreak":true},{"text":"Tio kondukas al ilia ekstermiĝo por eterne.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kaj Vi estas alta eterne, ho Eternulo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ĉar jen Viaj malamikoj, ho Eternulo,","poem":1},{"lineBreak":true},{"text":"Jen Viaj malamikoj pereas,","poem":1},{"lineBreak":true},{"text":"Diskuras ĉiuj malbonaguloj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sed mian kornon Vi altigas kiel la kornon de bubalo;","poem":1},{"lineBreak":true},{"text":"Mi estas oleita per freŝa oleo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kaj mia okulo rigardas miajn malamikojn;","poem":1},{"lineBreak":true},{"text":"Pri la malbonaguloj, miaj kontraŭuloj, aŭdas miaj oreloj.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Virtulo verdestas, kiel palmo,","poem":1},{"lineBreak":true},{"text":"Staras alte, kiel cedro sur Lebanon.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Plantitaj en la domo de la Eternulo,","poem":1},{"lineBreak":true},{"text":"Ili verdestas en la kortoj de nia Dio.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ili floras ankoraŭ en la maljuneco,","poem":1},{"lineBreak":true},{"text":"Estas sukplenaj kaj freŝaj,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Por sciigi, ke la Eternulo estas justa,","poem":1},{"lineBreak":true},{"text":"Mia fortikaĵo, kaj ne ekzistas en Li maljusteco.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}