{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"La Eternulo reĝas; Li estas vestita de majesto;","poem":1},{"lineBreak":true},{"text":"La Eternulo estas vestita kaj zonita de potenco;","poem":1},{"lineBreak":true},{"text":"Kaj fortikigita estas la mondo, ke ĝi ne ŝanceliĝu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"De antikve estas fortika Via trono;","poem":1},{"lineBreak":true},{"text":"Vi estas de eterne.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Levas la riveroj, ho Eternulo, levas la riveroj sian voĉon,","poem":1},{"lineBreak":true},{"text":"Levas la riveroj sian bruon;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pli ol la bruo de multego da akvo,","poem":1},{"lineBreak":true},{"text":"Ol la potencaj ondoj de la maro,","poem":1},{"lineBreak":true},{"text":"Potenca estas la Eternulo en la altaĵo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Viaj leĝoj estas tre fidindaj;","poem":1},{"lineBreak":true},{"text":"Via domo estas ornamita de sankteco,","poem":1},{"lineBreak":true},{"text":"Ho Eternulo, por eterne.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}