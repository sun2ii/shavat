{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"Venu, ni kantu al la Eternulo;","poem":1},{"lineBreak":true},{"text":"Ni ĝoje kriu al la rifuĝejo de nia helpo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ni venu antaŭ Lian vizaĝon kun glorado,","poem":1},{"lineBreak":true},{"text":"Per psalmoj ni ĝoje kriu al Li.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ĉar granda Dio estas la Eternulo","poem":1},{"lineBreak":true},{"text":"Kaj granda Reĝo super ĉiuj dioj,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kiu havas en Sia mano la profundaĵojn de la tero,","poem":1},{"lineBreak":true},{"text":"Kaj al kiu apartenas la altaĵoj de la montoj;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Al kiu apartenas la maro, kaj Li ĝin faris,","poem":1},{"lineBreak":true},{"text":"Kaj la sekteron Liaj manoj kreis.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Venu, ni kliniĝu, ni ĵetu nin teren,","poem":1},{"lineBreak":true},{"text":"Ni genuu antaŭ la Eternulo, nia Kreinto.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ĉar Li estas nia Dio,","poem":1},{"lineBreak":true},{"text":"Kaj ni estas la popolo de Lia paŝtejo kaj la ŝafoj de Lia mano.","poem":1},{"lineBreak":true},{"text":"Hodiaŭ, se vi aŭskultas Lian voĉon,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ne obstinigu vian koron, kiel en Meriba,","poem":1},{"lineBreak":true},{"text":"Kiel en la tago de Masa en la dezerto,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kiam viaj patroj Min incitis,","poem":1},{"lineBreak":true},{"text":"Esploris kaj vidis Mian faron.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kvardek jarojn Mi indignis kontraŭ tiu generacio,","poem":1},{"lineBreak":true},{"text":"Kaj Mi diris: Ili estas popolo kun koro malĝusta,","poem":1},{"lineBreak":true},{"text":"Kaj ili ne volas koni Miajn vojojn;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tial Mi ĵuris en Mia kolero,","poem":1},{"lineBreak":true},{"text":"Ke ili ne venos en Mian ripozejon.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}