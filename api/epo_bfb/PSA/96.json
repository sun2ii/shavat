{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":96,"content":[{"type":"verse","number":1,"content":[{"text":"Kantu al la Eternulo novan kanton;","poem":1},{"lineBreak":true},{"text":"Kantu al la Eternulo la tuta tero.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kantu al la Eternulo, gloru Lian nomon,","poem":1},{"lineBreak":true},{"text":"Proklamu de tago al tago Lian savon.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Rakontu inter la popoloj Lian gloron,","poem":1},{"lineBreak":true},{"text":"Inter ĉiuj gentoj Liajn miraklojn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ĉar la Eternulo estas granda kaj tre glorinda,","poem":1},{"lineBreak":true},{"text":"Li estas timinda pli ol ĉiuj dioj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ĉar ĉiuj dioj de la popoloj estas nur idoloj;","poem":1},{"lineBreak":true},{"text":"Sed la Eternulo kreis la ĉielon.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gloro kaj majesto estas antaŭ Li,","poem":1},{"lineBreak":true},{"text":"Forto kaj beleco estas en Lia sanktejo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tributu al la Eternulo, familioj de la popoloj;","poem":1},{"lineBreak":true},{"text":"Tributu al la Eternulo gloron kaj potencon.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tributu al la Eternulo la honoron de Lia nomo;","poem":1},{"lineBreak":true},{"text":"Alportu donacon kaj venu en Liajn kortojn.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kliniĝu al la Eternulo en sankta ornamo;","poem":1},{"lineBreak":true},{"text":"Tremu antaŭ Li la tuta tero.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Diru inter la popoloj: La Eternulo reĝas,","poem":1},{"lineBreak":true},{"text":"Kaj fortikigita estas la mondo, ke ĝi ne ŝanceliĝu;","poem":1},{"lineBreak":true},{"text":"Li juĝas la popolojn en justeco.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ĝoju la ĉielo, kaj estu gaja la tero,","poem":1},{"lineBreak":true},{"text":"Bruu la maro, kaj ĉio, kio ĝin plenigas.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ĝoju la kampo, kaj ĉio, kio estas sur ĝi;","poem":1},{"lineBreak":true},{"text":"Tiam kantu ĉiuj arboj de la arbaro","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Antaŭ la Eternulo, ĉar Li venas,","poem":1},{"lineBreak":true},{"text":"Ĉar Li venas, por juĝi la teron;","poem":1},{"lineBreak":true},{"text":"Li juĝos la mondon kun justeco","poem":1},{"lineBreak":true},{"text":"Kaj la popolojn kun Sia fideleco.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}