{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"La Eternulo reĝas; ĝoju la tero;","poem":1},{"lineBreak":true},{"text":"Estu gajaj la multaj insuloj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nubo kaj mallumo estas ĉirkaŭ Li;","poem":1},{"lineBreak":true},{"text":"Vero kaj justeco estas la fundamento de Lia trono.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fajro iras antaŭ Li,","poem":1},{"lineBreak":true},{"text":"Kaj bruligas ĉirkaŭe Liajn malamikojn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Liaj fulmoj lumigas la mondon;","poem":1},{"lineBreak":true},{"text":"La tero vidas, kaj tremas.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Montoj fandiĝas kiel vakso antaŭ la vizaĝo de la Eternulo,","poem":1},{"lineBreak":true},{"text":"Antaŭ la vizaĝo de la Sinjoro de la tuta tero.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"La ĉielo rakontas Lian veron,","poem":1},{"lineBreak":true},{"text":"Kaj ĉiuj popoloj vidas Lian gloron.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hontiĝu ĉiuj, kiuj servas al idoloj,","poem":1},{"lineBreak":true},{"text":"Kiuj laŭdas sin pro diaĉoj.","poem":1},{"lineBreak":true},{"text":"Kliniĝu antaŭ Li ĉiuj dioj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aŭdis kaj ekĝojis Cion,","poem":1},{"lineBreak":true},{"text":"Kaj ektriumfis la filinoj de Jehuda","poem":1},{"lineBreak":true},{"text":"Pro Viaj juĝoj, ho Eternulo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ĉar Vi, ho Eternulo, estas Plejalta super la tuta tero,","poem":1},{"lineBreak":true},{"text":"Vi tre alte leviĝis super ĉiuj dioj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Amantoj de la Eternulo, malamu malbonon.","poem":1},{"lineBreak":true},{"text":"Li gardas la animojn de Siaj fideluloj;","poem":1},{"lineBreak":true},{"text":"Li savos ilin de la mano de malvirtuloj.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lumo verŝiĝas sur virtulon,","poem":1},{"lineBreak":true},{"text":"Kaj ĝojo sur purkorulojn.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ĝoju, virtuloj, pro la Eternulo,","poem":1},{"lineBreak":true},{"text":"Kaj gloru Lian sanktan nomon.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}