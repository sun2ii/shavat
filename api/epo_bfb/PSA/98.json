{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"hebrew_subtitle","content":["Psalmo."]},{"type":"verse","number":1,"content":[{"text":"Kantu al la Eternulo novan kanton,","poem":1},{"lineBreak":true},{"text":"Ĉar miraklojn Li faris;","poem":1},{"lineBreak":true},{"text":"Helpis Lin Lia dekstra mano kaj Lia sankta brako.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"La Eternulo aperigis Sian savon;","poem":1},{"lineBreak":true},{"text":"Antaŭ la okuloj de la popoloj Li malkaŝis Sian justecon.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Li memoras Sian bonecon kaj Sian fidelecon al la domo de Izrael.","poem":1},{"lineBreak":true},{"text":"Vidis ĉiuj finoj de la tero la helpon de nia Dio.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ĝoje kriu al la Eternulo la tuta tero;","poem":1},{"lineBreak":true},{"text":"Kantu, gloru, kaj muziku.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Muziku al la Eternulo per harpo,","poem":1},{"lineBreak":true},{"text":"Per harpo kaj per sonoj de psalmo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Per trumpetoj kaj per sono de korno","poem":1},{"lineBreak":true},{"text":"Ĝoje kriu antaŭ la Reĝo, la Eternulo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bruu la maro, kaj ĉio, kio ĝin plenigas,","poem":1},{"lineBreak":true},{"text":"La mondo kaj ĝiaj loĝantoj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"La riveroj plaŭdu per la manoj,","poem":1},{"lineBreak":true},{"text":"La montoj kune kantu ĝoje,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Antaŭ la Eternulo, ĉar Li venas, por juĝi la teron;","poem":1},{"lineBreak":true},{"text":"Li juĝos la mondon kun justeco kaj la popolojn kun vereco.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}