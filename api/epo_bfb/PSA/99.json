{"translation":{"id":"epo_bfb","name":"Londona Biblio","website":"https://ebible.org/Scriptures/details.php?id=epo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=epo","licenseNotes":null,"shortName":"BFB","englishName":"Esperanto Bible","language":"epo","textDirection":"ltr","sha256":"262d4e2d694caf808cacdc87caef050d6d255860212a0b6b31a5f9381554e3ae","availableFormats":["json"],"listOfBooksApiLink":"/api/epo_bfb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Esperanto","languageEnglishName":"Esperanto"},"book":{"id":"PSA","translationId":"epo_bfb","name":"Psalmaro","commonName":"Psalmaro","title":"LA PSALMARO","order":19,"numberOfChapters":150,"sha256":"9d56f8bdeccdced9d09c381f57e2b5923295fbc9249adc19f2be0972986af820","firstChapterNumber":1,"firstChapterApiLink":"/api/epo_bfb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/epo_bfb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"La Eternulo reĝas, tremas la popoloj;","poem":1},{"lineBreak":true},{"text":"Li sidas sur keruboj, ŝanceliĝas la tero.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"La Eternulo estas granda en Cion,","poem":1},{"lineBreak":true},{"text":"Kaj Li estas alte super ĉiuj popoloj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Oni gloru Vian grandan kaj timindan nomon:","poem":1},{"lineBreak":true},{"text":"Li estas sankta.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kaj la forton de la reĝo, kiu amas justecon,","poem":1},{"lineBreak":true},{"text":"Vi fortikigis en praveco;","poem":1},{"lineBreak":true},{"text":"Juĝon kaj justecon en Jakob Vi aranĝis.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Altigu la Eternulon, nian Dion,","poem":1},{"lineBreak":true},{"text":"Kaj kliniĝu antaŭ la benketo de Liaj piedoj:","poem":1},{"lineBreak":true},{"text":"Li estas sankta.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Moseo kaj Aaron estas inter Liaj pastroj,","poem":1},{"lineBreak":true},{"text":"Kaj Samuel estas inter tiuj, kiuj vokas Lian nomon;","poem":1},{"lineBreak":true},{"text":"Ili vokis al la Eternulo, kaj Li ilin aŭskultis.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"El nuba kolono Li parolis al ili;","poem":1},{"lineBreak":true},{"text":"Ili observis Liajn regulojn, kaj la leĝon, kiun Li donis al ili.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ho Eternulo, nia Dio, Vi ilin aŭskultis;","poem":1},{"lineBreak":true},{"text":"Vi estis por ili Dio pardonanta, kvankam venĝanto por iliaj faroj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Altigu la Eternulon, nian Dion,","poem":1},{"lineBreak":true},{"text":"Kaj kliniĝu antaŭ Lia sankta monto;","poem":1},{"lineBreak":true},{"text":"Ĉar sankta estas la Eternulo, nia Dio.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/epo_bfb/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/epo_bfb/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/epo_bfb/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}