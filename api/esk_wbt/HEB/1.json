{"translation":{"id":"esk_wbt","name":"Ipqitchuat Makpiġaat - Agaayyutim Uqałhi Iñupiatun","website":"https://ebible.org/Scriptures/details.php?id=eskNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eskNT","licenseNotes":null,"shortName":"WBT","englishName":"Northwest Alaska Eskimo NT","language":"esk","textDirection":"ltr","sha256":"5ee6ad86412329316c07bd5cfb904388f7699eefc2a3a5af7deb637b3b541a12","availableFormats":["json"],"listOfBooksApiLink":"/api/esk_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7928,"languageName":"Inupiaq","languageEnglishName":"Inupiaq"},"book":{"id":"HEB","translationId":"esk_wbt","name":"Hebrews","commonName":"Hebrews","title":"Tuyuun Hebrew-ŋuruanun","order":58,"numberOfChapters":13,"sha256":"d7680976bc358eeac811dfe3c65cad54626d8799cf62615aca95a6eb952b92f5","firstChapterNumber":1,"firstChapterApiLink":"/api/esk_wbt/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/esk_wbt/HEB/13.json","totalNumberOfVerses":300},"chapter":{"number":1,"content":[{"type":"heading","content":["Agaayyutim Uqałha Uqaqtigiplugu Iġñiñi"]},{"type":"verse","number":1,"content":["Iŋiḷġaanimma Agaayyun uqaqtuq sivulliaptiknun sivuniksriqiritigun akulaiqł̣ugu atlakaaġiikł̣ugich."]},{"type":"verse","number":2,"content":["Aglaanpakma makunani aqulliġñi uvluni Agaayyutim uqautigaatigut Iġñiġmigun, nalunaiqsaġmigun paitchaktaaquplugu supayaanik, aasriiñ ilaagun iñiġnikkani nuna."]},{"type":"verse","number":3,"content":["Agaayyutim kamanautaa qiñiġnaitchuq. Aglaanpakma kamanaun qausaiñaqtuq Iġñiġuruakun Agaayyutillapiatun itluni. Iġñiġuruam tigummiugaġaa supayaaq uqałiġmigun saŋŋiqaqtuatigun. Piiŋanikamigich iñuich killuqsautaat, aquvinniqsuq taliqpianun kamanaġniqsram pakmani."]},{"type":"heading","content":["Iġñiq Kamanatluktuq Isaġuliŋmiñ"]},{"type":"verse","number":4,"content":["Taatnaqhuni kamanatluksipḷuni israġuliŋniñ Agaayyutim atchiġñiġaa kamanatluktuamik atiġmik iliŋisa atiŋitñiñ."]},{"type":"verse","number":5,"content":["Atakkii Agaayyutim nalliatunniiñ israġulgich nipliutisrimaitchaa, itna,",{"text":"“Ilvich Iġñiġigikpiñ.","poem":1},{"text":"Uvlupak nalupqinaiġikpiñ iġñiġiplutin takkuatni iñupayaat.” Psalm 2:7","poem":2},"Naagasuli itnaqsimaitchuq israġuliŋmun,",{"text":"“Aapaugisiruŋa ilaanun aasrii uvaŋa Iġñiġilugu.” 2 Samuel 7:14; 1 Chronicles 17:13","poem":1}]},{"type":"verse","number":6,"content":["Aasriipsuuq, tuyuġiyasripmagu Iġñiġuruaq aŋalatiqatini iñuŋnun marrumani nunami nipliġñiqsuq, itna,",{"text":"“Iluqatiŋ Agaayyutim israġulgiñ purvigilitruŋ.” Deuteronomy 32:43","poem":1}]},{"type":"verse","number":7,"content":["Suli uqautigigai israġulgich, itna,",{"text":"“Israġulgich anuġiġuqtinniġai,","poem":1},{"text":"savaktiniasriiñ ikualaruaġuqtitlugich.” Psalm 104:4","poem":2}]},{"type":"verse","number":8,"content":["Aglaan Iġñiġuruamun uqaqtuq,",{"text":"“Agaayyuun, aŋalatchiraugisirutin taimuŋa.","poem":1},{"text":"Aŋalatkisigiñ aŋaayuqautiiñ nalaunŋałikun.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Quviagigiñ nalaunŋaruałiq aasrii uumigiplugu nalaunŋaitchuałiq.","poem":1},{"text":"Taatnaqhuni Atanġum, Agaayyutvich, piksraqtaaġigaatin qaitchipḷutin pitḷuktuamik kamakkutmiglu quvianamiglu tamatkunakŋapayaaq piqatipniñ.” Psalm 45:6-7","poem":2}]},{"type":"verse","number":10,"content":["Itnasuli uqaqtuq ilaagun,",{"text":"“Ataniiq, aullaġniisaqqaaġatałiġmi iñiġiñ nunalu qiḷaglu argapnik.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tamatkua piunġiġñiaqtut, aglaan ilvich itchaġataqtutin.","poem":1},{"text":"Iluqatiŋ tamatkua utuqqaġuġniaqtut","poem":2},{"lineBreak":true},{"text":"aasriiñ atnuġaaluktun suunġiġutiŋ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Uligaatun imuniaġitin","poem":1},{"text":"aasrii simmiġutiŋ atnuġaaluktun.","poem":2},{"text":"Aglaan ilvich atlaŋŋuġumiñaitchutin","poem":1},{"text":"suli ukiutin isrukłitchumiñaitchut.” Psalm 102:25-27","poem":2}]},{"type":"verse","number":13,"content":["Aasrii nalliatnun israġulgich uqautriḷḷaksimaitchuq itna,",{"text":"“Aquvittin taliqpiŋma tuŋaani aŋalatchiqasiutilutinaasrii uvamnik","poem":1},{"text":"akiiḷiḷḷapiaġniałhatnunaglaan iluqaitñik uumigirivich.” Psalm 110:1","poem":2}]},{"type":"verse","number":14,"content":["Israġulgich savaktaułhiñaqtut irrusriuplutiŋ. Tiliraurut ikayuquplugich tamatkua annautrauniaqtuanik."]}],"footnotes":[]},"thisChapterLink":"/api/esk_wbt/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/esk_wbt/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/esk_wbt/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}