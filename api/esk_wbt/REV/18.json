{"translation":{"id":"esk_wbt","name":"Ipqitchuat Makpiġaat - Agaayyutim Uqałhi Iñupiatun","website":"https://ebible.org/Scriptures/details.php?id=eskNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eskNT","licenseNotes":null,"shortName":"WBT","englishName":"Northwest Alaska Eskimo NT","language":"esk","textDirection":"ltr","sha256":"5ee6ad86412329316c07bd5cfb904388f7699eefc2a3a5af7deb637b3b541a12","availableFormats":["json"],"listOfBooksApiLink":"/api/esk_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7928,"languageName":"Inupiaq","languageEnglishName":"Inupiaq"},"book":{"id":"REV","translationId":"esk_wbt","name":"Revelation","commonName":"Revelation","title":"Sagvikkauruat John-mun","order":66,"numberOfChapters":22,"sha256":"5c3bc3fcaf8ff3d0c71530758176c6015ecc22506bca2b867f259fba4be5506b","firstChapterNumber":1,"firstChapterApiLink":"/api/esk_wbt/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/esk_wbt/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":18,"content":[{"type":"heading","content":["Babylon Suksraunġikkauruq"]},{"type":"verse","number":1,"content":["Tamatkua aquatigun qiñiqtuŋa atlamik israġuliŋmik atqaqtuamik qiḷaŋmiñ aŋalatchił̣iqpauraqaqhuni, aasriiñ iluqaan nuna qaummaġiksipkaġaa qaumaniġmiñik."]},{"type":"verse","number":2,"content":["Tarra nipruaġniqsuq itna,",{"text":"“Babylon kamanaqtuaq suksraunġikkauruq, tarra iḷumutuuruq!","poem":1},{"text":"Inigiliutigaat tuunġaiḷḷu qanusripayaatlu irrusriqł̣uich","poem":2},{"text":"sulipsuuq qaayuġnaqtuapayaatlu","poem":1},{"text":"uumiñaqtuatlu tiŋmiaġruich.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Babylon qaitchigai wine-mik iñuŋich nunaaqqipayaat imiliqtitlugich","poem":1},{"text":"sayuŋałhan saŋŋiruamik wine-naŋanik.","poem":2},{"text":"Umialiŋi nunam sayuŋaqatiginiġaat ilaa,","poem":1},{"text":"suli tauqsiġñiaqtiŋiñ nunam umialguġvigiplugu","poem":2},{"lineBreak":true},{"text":"umialgutitigun akuqtukkaŋich ilaan atugaułhagun.”","poem":2}]},{"type":"verse","number":4,"content":["Tarra tusraapmiuŋa atlamik nipimik qiḷaŋmiñ uqaqtuamik,",{"text":"“Iñuŋmaaŋ, annisitchi taavrumakŋa nunaaqqimiñ.","poem":1},{"text":"Ilipsi iḷauruksraunġitchusri killuqsautaiñi,","poem":2},{"lineBreak":true},{"text":"piqataunġitchumausriḷi iłuiḷḷiuġutiksrautaiñi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Killuqsautai iñugiaktut qutchiksipḷutiŋ qiḷaktun,","poem":1},{"text":"suli Agaayyutim itqaġigai savamaqłuutai.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Utiqtitchivigisriuŋ Babylon qaisaŋatun ilipsitñun,","poem":1},{"text":"akiḷiġḷugu malġuktun ilaan savaaŋigun,","poem":2},{"lineBreak":true},{"text":"immiġḷugu qallugauraŋa malġuktun ilaa imiksriuqmatun ilipsitñun.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Atqunallapiaqługu iŋmiñik kamagiruaq iñuuniugaqmiuq susrunġisaallapiaqhuni.","poem":1},{"text":"Pakma aatchuqsiuŋ nagliksaaġutiksramik alianallapiaqtuamiglu.","poem":2},{"text":"Atakkii uqaqtuq iŋmiñun,","poem":1},{"text":"‘Uvaŋa aquppiuraaġisiruŋa ataniqtun. Uiḷgaanġitmiuŋa.","poem":2},{"lineBreak":true},{"text":"Iḷitchuqsriyumiñaitchuŋa alianamik.’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Taatnaqługu iłuiḷḷiuġutiqpauraksraŋiñ tikitkisigaat atautchimi uvlumi,","poem":1},{"text":"tuqułhum, alianamlu, kakkaaġnamlu.","poem":2},{"text":"Suli ikigisiruq ikniġmik,","poem":1},{"text":"atakkii Atanġuruaq Agaayyun sapiġñaqtuq atanniiruaq ilaanik.”","poem":2}]},{"type":"verse","number":9,"content":["Tarraasriiñ umialiŋisa nunam sayuŋaqatiqaqtuat akiisumik pisuŋnautaigun qiagisigaat alianniuġutigilugu taamna aġnaq qiñiġumitruŋ isia ikualaniŋan."]},{"type":"verse","number":10,"content":["Qichaġisirut uŋasriksiḷutiŋ sivuuġagilugu ilaan nagliksaaqtitaułha uqaġutiŋ,",{"text":"“Nakłiuŋ, nakłiuŋ, ilvich Babylon, kamanaqtuaq nunaaqqiq,","poem":1},{"text":"saŋŋiqaġaluaqtuaq nunaaqqiq.","poem":2},{"text":"Atautchimi sassaġniġmi anasriñŋuqsakkauŋaniktutin.”","poem":1}]},{"type":"verse","number":11,"content":["Uvvaasriiñ tauqsiġñiutilgich nunapayaami qiarut kiñuvġuplugu ilaa, atakkii tarakŋaaglaan kimikunniiñ tauqsiqsiksraiġñiqsuq suuraŋitñik."]},{"type":"verse","number":12,"content":["Suuraqpaurat kaviqsaatlu qatiqtaatlu maniich, akisuruatlu uyaġauraat, qatiqtaatlu suŋauraqpaich, ukił̣haaġiksaatlu suli ukił̣haat tuŋuaqtaatlu, siluiḷḷu kavviġiksaatlu, qanusriḷimaatlu ayuġnaqtuat qiruich, qanusriḷimaat suurat tuugaaniñ, akisuruatlu qiruich, patukpaiḷḷu, savił̣hatlu, uyaġaiḷḷu siqquqtatun,"]},{"type":"verse","number":13,"content":["sinimatlu, avuuġutit, tipraġiksautit ikipkaqługich, myrrh-lu, frankincense-lu, wine-nat, uqsrut, mukkaaġiksaat, mukkaaksratlu, niġrutitlu, ipnaich, tuttuqpaich, tuttuqpagautitlu, suliunniiñ iñuuruat iñuich."]},{"type":"verse","number":14,"content":["“Asriatluunniiñ kipiġniuġutigikkatin piiqsut ilipniñ, suli suurapayaatin akisuruat qiñiyunaqtuatlu taimmaurut ilipniñ, aasrii sumiunniiñ paqitchumiñaiġitin.”"]},{"type":"verse","number":15,"content":["Tauqsiġñiutilgich tamatkuniŋa suuranik umialguqtuat taavrumakŋa aġnamiñ qichaġisirut uŋasriksuami, sivuuġagilugu nagliksaaqtitaułha alianapiaqtuamik qialutiŋ,"]},{"type":"verse","number":16,"content":["uqaġutiŋ,",{"text":"“Nakłiuŋ, nakłiuŋ. Kamanaqtuaq nunaaqqiq","poem":1},{"text":"atnuġaaqaġuuruq ukił̣haaġiksaanik tuŋuaqtaaniglu kavviġiksaaniglu,","poem":2},{"lineBreak":true},{"text":"qiñiyunaqusriqsuqhuni maniŋmik kaviqsaamik,","poem":2},{"lineBreak":true},{"text":"akisuruaniglu uyaġauraanik, qatiqtaatlu suŋauraqpaŋnik.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Atautchimi sassaġniġmi tammaigai iluqaisa umialgutini.”","poem":1},"Suli iluqaġmiŋ umiaqpaich umialiŋich taġiuqsiuqtillu suli iluqaġmiŋlu akiññaŋniaqtaut taġiumi qichaġniqsut uŋasriksuami,"]},{"type":"verse","number":18,"content":["suli nipaalarut qiñiqamitruŋ isia ikualaniŋan uqaqhutiŋ, “Piitchuq atlamik nunaaqqimik taavrumatun kamanaqtuatun nunaaqqisun.”"]},{"type":"verse","number":19,"content":["Iliŋisa nalluqsruġniġaat nunam apyua niaqumiknun, qiallaġmiŋ kiŋuvġullaġmiŋlu nipaalaplutiŋ,",{"text":"“Nakłiuŋ, nakłiuŋ. Taamna kamanaqtuaq nunaaqqiq!","poem":1},{"text":"Iluqaġmiŋ umiaqpaqaqtuat taġiumi umialguġniqsut","poem":2},{"lineBreak":true},{"text":"suuraŋigun akisuruatigun!","poem":2},{"text":"Atautchimi sassaġniġmi suksraunġiqsauruq.”","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"“Qiḷaak, quviasrukpautigiuŋ suksraunġiqsaułha.","poem":1},{"text":"Quviasrukpagitchi Agaayyutim iñuiḷḷu uqqiraqtauruasiiḷu sivuniksriqirauruasiiḷu,","poem":2},{"text":"atakkii Agaayyutim akiisuq anasriñŋuqsaġutigigaa","poem":1},{"text":"pisigiplugu savaaŋagun ilipsitñun.”","poem":2}]},{"type":"verse","number":21,"content":["Tarani sapiġñaqtuaq israġulik tigusriruq uyaġagruamik aŋiruatun mukkaaksriuġutitun aasrii miḷuqsautiplugu taġiumun, itnaqhuni,",{"text":"“Taatnatun kamanaqtuamik nunaaqqiq Babylon iksautikkaugisiruq,","poem":1},{"text":"aasriiñ qiñiġnatqikkumiñaiġisiruq sumiunniiñ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Suli nipiŋich nuqaqtiligaqtit atuqtuuralgich","poem":1},{"text":"suli supluaqtuġnaqtuatlu qalġuqtautitlu tusraġnatqikkumiñaitchut ilipni uvakŋaniñaglaan.","poem":2},{"text":"Suliuqtit qanusripayaanik paqinnatqikkumiñaitchut ilipni,","poem":1},{"text":"suli qatraġniŋa mukkaaksriuġutim tusraġnatqikkumiñaitchuq ilipni.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Suli qaumanġa kialuuram","poem":1},{"text":"qaummaġitqikkumiñaitchuq ilipni uvakŋaniñaglaan.","poem":2},{"text":"Nipaat uiksrautimlu nuliaksrautimlu","poem":1},{"text":"tusraġnatqikkumiñaitchuq uvakŋaniñaglaan ilipni.","poem":2},{"text":"Ilvich tauqsiġñiaqtitin kamanaġniqsrauniqsut nunami.","poem":1},{"text":"Suli aŋatkuułipkun iluqaisa nunam iñui kinnigitin.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Suli Babylon anasriñŋukkauruq","poem":1},{"text":"atakkii auŋat sivuniksriqirit ipqitchuatlu iñuich","poem":2},{"lineBreak":true},{"text":"suli iluqaġmiŋ tuqqutauruat nunami qiñiġnaqtut nunaaqqimi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/esk_wbt/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/esk_wbt/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/esk_wbt/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}