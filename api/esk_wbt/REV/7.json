{"translation":{"id":"esk_wbt","name":"Ipqitchuat Makpiġaat - Agaayyutim Uqałhi Iñupiatun","website":"https://ebible.org/Scriptures/details.php?id=eskNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eskNT","licenseNotes":null,"shortName":"WBT","englishName":"Northwest Alaska Eskimo NT","language":"esk","textDirection":"ltr","sha256":"5ee6ad86412329316c07bd5cfb904388f7699eefc2a3a5af7deb637b3b541a12","availableFormats":["json"],"listOfBooksApiLink":"/api/esk_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7928,"languageName":"Inupiaq","languageEnglishName":"Inupiaq"},"book":{"id":"REV","translationId":"esk_wbt","name":"Revelation","commonName":"Revelation","title":"Sagvikkauruat John-mun","order":66,"numberOfChapters":22,"sha256":"5c3bc3fcaf8ff3d0c71530758176c6015ecc22506bca2b867f259fba4be5506b","firstChapterNumber":1,"firstChapterApiLink":"/api/esk_wbt/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/esk_wbt/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":7,"content":[{"type":"heading","content":["144,000 Israel-aaġmiut"]},{"type":"verse","number":1,"content":["Tamatkua aquatigun qiñiqtuŋa sisamanik israġuliŋnik makitaruanik sisamani iqirġuŋiñi nunam. Tigummiugaġniġaich sisamat anuġiŋi nunam, anuqłiqunġitḷugu sumiunniiñ nunamun naagaunniiñ taġiumun naagaunniiñ napaaqtunun."]},{"type":"verse","number":2,"content":["Qiñiqtuŋa atlamik israġuliŋmik qunmukhuni nuiraġaġvianiñ siqiñġum, saagaqhuni taluġniqusriqsaŋanik iñuuruam Agaayyutim. Ilaa tuqłuġaqtuq nipitusripḷugu sisamanun israġuliŋnun saŋŋiksriñŋaniksimaruanun piyaqqułuktatlasipḷugu nuna taġiuġlu."]},{"type":"verse","number":3,"content":["Nipliqhuni, “Piyaqqułuktaqnagu nuna, taġiuġlu, napaaqtutlu uvagut nalunaitmiutchiigaluaqata qauŋisigun savaktiŋiñik Agaayyutipta.”"]},{"type":"verse","number":4,"content":["Tarra tusraagiga kisirrutaat tamatkua nalunaitmiutchikkauruat. Iñugiaktilaaqaġniqsut 144,000-tun kiñuviapayaaŋitñiñ Israel-aaġmiut."]},{"type":"verse","number":5,"content":[{"text":"12,000 kiñuviaŋi Judah-m nalunaitmiutchikkaurut,","poem":1},{"lineBreak":true},{"text":"kiñuviaŋisuli Reuben-ŋum 12,000,","poem":1},{"lineBreak":true},{"text":"kiñuviaŋisuli Gad-ŋum 12,000,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"kiñuviaŋisuli Asher-ŋum 12,000,","poem":1},{"lineBreak":true},{"text":"kiñuviaŋisuli Naphtali-m 12,000,","poem":1},{"lineBreak":true},{"text":"kiñuviaŋisuli Manasseh-ŋum 12,000,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"kiñuviaŋisuli Simeon-ŋum 12,000,","poem":1},{"lineBreak":true},{"text":"kiñuviaŋisuli Levi-ŋum 12,000,","poem":1},{"lineBreak":true},{"text":"kiñuviaŋisuli Issachar-ŋum 12,000,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"kiñuviaŋisuli Zebulun-ŋum 12,000,","poem":1},{"lineBreak":true},{"text":"kiñuviaŋisuli Joseph-ŋum 12,000,","poem":1},{"lineBreak":true},{"text":"kiñuviaŋisuli Benjamin-ŋum 12,000.","poem":1}]},{"type":"heading","content":["Iñugaaġruich Nunaaqqipayaaniñ"]},{"type":"verse","number":9,"content":["Taavruma aquagun qiñiqtuŋa iñugiallapiaġataqtuanik iñuŋnik kia-unniiñ iñuum kisitchumiñaisaŋiñik nunaaqqipayauraniñ atlakaaġiiñiñḷu iñuŋniñ suli uqausripayaaniñ. Qichaġniqsut sivuġaanun aquppiutaqpaum suli sivuġaanun ipnaiyaam, atnuġaaqaqhutiŋ qatiqtaanik akuqturuanik qisiqsiutiniglu tigummiugaqhutiŋ,"]},{"type":"verse","number":10,"content":["nipliraqhutiŋ nipitusripḷugu itna,",{"text":"“Agaayyutipta aquppiruam aquppiutaqpaŋmi","poem":1},{"lineBreak":true},{"text":"suli ipnaiyaam annautigaatigut.”","poem":1}]},{"type":"verse","number":11,"content":["Iluqatiŋ israġulgich qichaġniqsut avataani aquppiutaqpaum suli umialiŋnat sisamatlu uumaruat, sitquqhutiŋ sivuġaanun aquppiutaqpaum nanġaġaat Agaayyun."]},{"type":"verse","number":12,"content":["Niplianiqsut,",{"text":"“Amen,","poem":1},{"lineBreak":true},{"text":"nanġaun, kamanaunlu,","poem":1},{"lineBreak":true},{"text":"isrumatułiġlu, quyyanlu, kamakkunlu,","poem":1},{"lineBreak":true},{"text":"saŋŋiḷu, sapiġñaunlu","poem":1},{"lineBreak":true},{"text":"illi Agaayyutiptiknun taimuŋa isruitchuamun.","poem":1},{"lineBreak":true},{"text":"Amen.”","poem":1}]},{"type":"verse","number":13,"content":["Aasrii iḷaŋata umialiŋnat apiqsruġaaŋa, “Kisut makua iñuich atnuġaaqaqtuat qatiqtaanik akuqturuanik? Nakikŋalu aggiqsuaŋuvat?”"]},{"type":"verse","number":14,"content":["Nipliutigiga, “Aŋuun, iḷisimaruaŋurutin.” Aasriiñ ilaan uqallautigaaŋa,",{"text":"“Tamatkua iłuiḷḷiułiqpauraq apqusraaġniġaat. Iġġuġniġaich atnuġaatiŋ akuqturuat, aasrii qatiqsipkaqługich auŋanun Ipnaiyaam.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Taatnaqhutiŋ ittut sivuġaani aquppiutaqpaŋan Agaayyutim","poem":1},{"text":"savautiplugu uvlumi unnuamiḷu agaayyuvikpaŋani,","poem":2},{"text":"aasrii taavruma aquppiruam aquppiutaqpaŋmi","poem":1},{"text":"tugluaqsimaaġisigai nayuutiłiġmigun.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Iliŋich niġisuksiutqikkumiñaitchut","poem":1},{"text":"naaga imiġuksiutqikkumiñaitchut.","poem":2},{"text":"Siqiñġumlu atlamlu uunaum uunniuqtitqikkumiñaitchai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Atakkii ipnaiyaam qichaqtuam sivuġaani aquppiutaqpaŋmi niġipkaġisigai munaqsritun","poem":1},{"text":"sivulliġḷugiḷḷu iñuunaqtuanun suvliktuaġuraaqtuanun,","poem":2},{"text":"suli Agaayyutim allaqtiġisigai qulvipayaat iriŋitñiñ.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/esk_wbt/REV/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/esk_wbt/REV/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/esk_wbt/REV/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}