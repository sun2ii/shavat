{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"DEU","translationId":"ewe_bib","name":"Mose 5","commonName":"Mose 5","title":"Mose ƒe agbalẽ atɔ̃lia","order":5,"numberOfChapters":34,"sha256":"2492dc0a299b71a4dd87f445d485edaf02f68b1158e91328254f6c7536ad75b0","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/ewe_bib/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":33,"content":[{"type":"heading","content":["Mose yra Israel ƒe toawo"]},{"type":"verse","number":1,"content":["Esiawoe nye nya siwo Mose, Mawu ƒe ame la tsɔ yra Israelviwo hafi ku:"]},{"type":"verse","number":2,"content":[{"text":"“Yehowa va mía gbɔ","poem":1},{"lineBreak":true},{"text":"le Sinai to la gbɔ;","poem":1},{"text":"eɖiɖi ɖe mía dzi","poem":2},{"text":"tso Seir to la dzi.","poem":1},{"text":"Eklẽ tso Paran to la dzi","poem":2},{"text":"ame kɔkɔe akpe nanewo ƒo xlãe,","poem":1},{"text":"dzo bibi nɔ eƒe nuɖusime.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Elɔ̃ eƒe amewo ŋutɔ","poem":1},{"text":"eƒe ame kɔkɔewo le eƒe asi me","poem":2},{"text":"wole wò afɔtoƒe tom","poem":1},{"text":"woxɔ woƒe ɖoɖowo tso gbɔwò.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wò se siwo mede na wo la,","poem":1},{"text":"esiwo nye Yakob ha la ƒe domenyinu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yehowa zu fia le Yesurun","poem":1},{"text":"esime Israel ƒe towo kpe ta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Ruben anɔ agbe tegbee","poem":1},{"text":"eƒe dzidzimeviwo asɔ gbɔ!”","poem":2}]},{"type":"verse","number":7,"content":["Eye Mose gblɔ tso Yuda ŋu be:",{"text":"“O! Yehowa, se Yuda ƒe kokoƒoƒo,","poem":1},{"text":"na wòawɔ ɖeka kple Israel","poem":2},{"lineBreak":true},{"text":"wɔ aʋa kple eƒe futɔwo nɛ.”","poem":2}]},{"type":"verse","number":8,"content":["Mose gblɔ tso Levi ƒe viwo ŋu be:",{"text":"“Tsɔ wò Urim kple Tumim","poem":1},{"text":"na wò ame kɔkɔe Levi.","poem":2},{"text":"Èdo Levi kpɔ le Masa;","poem":1},{"text":"nèwɔ dzre kplii le Meriba tsia gbɔ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ewɔ wò ɖoɖowo dzi,","poem":1},{"text":"ewu nu vɔ̃ wɔla geɖewo,","poem":2},{"text":"eya ŋutɔ ƒe viwo, nɔviŋutsuwo,","poem":1},{"text":"fofowo kple dadawo gɔ̃ hã.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Levitɔwo afia Mose ƒe seawo Israel","poem":1},{"text":"woasubɔ wò le dzudzɔdovɔsamlekpui","poem":2},{"lineBreak":true},{"text":"kple numevɔsamlekpui la dzi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"O! Yehowa, yra Levitɔwo","poem":1},{"lineBreak":true},{"text":"kpɔ ŋudzedze le woƒe dɔ","poem":1},{"text":"siwo wowɔna na wò la ŋu.","poem":2},{"text":"Fiti woƒe futɔwo gbidigbidi","poem":1},{"text":"na womagafɔ gbeɖe o.”","poem":2}]},{"type":"verse","number":12,"content":["Mose gblɔ tso Benyamin ŋu be,",{"text":"“Yehowa ƒe lɔlɔ̃tɔe wònye","poem":1},{"text":"ele dedie le egbɔ","poem":2},{"text":"Yehowa tsɔ ametakpɔkpɔ ƒo xlãe,","poem":1},{"text":"ɖenɛ tso dzɔgbevɔ̃e ɖe sia ɖe me.”","poem":2}]},{"type":"verse","number":13,"content":["Mose gblɔ tso Yosef ƒe to la ŋu be,",{"text":"“Yehowa nayra eƒe anyigba","poem":1},{"text":"kple nunana nyuitɔwo tso dziƒo","poem":2},{"lineBreak":true},{"text":"kple esiwo tso anyigba ƒe tume.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yehowa nayrae kple nuku nyuitɔwo","poem":1},{"text":"tso esiwo ɣe nana wotsina la dome","poem":2},{"lineBreak":true},{"text":"wòana nuwoe fũu ɣleti sia ɣleti","poem":2}]},{"type":"verse","number":15,"content":[{"text":"nuku siwo wɔna nyuie le towo dzi","poem":1},{"text":"kple esiwo wɔna nyuie le togbɛwo dzi,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yehowa nayrae kple nunana nyuitɔwo","poem":1},{"text":"kple anyigbadzinu geɖewo,","poem":2},{"text":"kpakple Mawu, ame si ɖe eɖokui fia","poem":1},{"text":"le ŋuve ƒe bibi me la ƒe amenuveve.","poem":2},{"text":"Yayra siawo katã nava Yosef dzi.","poem":1},{"text":"Ame si nye fiavi le nɔviawo dome.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ele abe nyitsuvi ene","poem":1},{"text":"Le ŋusẽ kple ɖekadzedze me.","poem":2},{"text":"Eto dzo abe to ƒe dzowo ene;","poem":1},{"text":"Wòawo wòatsɔ tu dukɔwo aƒu anyi le afi sia afi.","poem":2},{"text":"Esiae nye nye yayra na Efraim ƒe ame akpe nanewo","poem":1},{"text":"kple Manase tɔ akpe akpewo.”","poem":2}]},{"type":"verse","number":18,"content":["Mose gblɔ tso Zebulon ŋu be,",{"text":"“O! Zebulon, tso aseye","poem":1},{"text":"le wò gododo ŋuti,","poem":2},{"text":"eye Isaka, kpɔ dzidzɔ","poem":1},{"text":"wò ame si lɔ̃a agbadɔmenɔnɔ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Woawoe akpe amewo","poem":1},{"text":"be woaɖu yewoƒe vɔsanuwo kple yewo.","poem":2},{"text":"Kpɔ ɖa, woaɖu atsiaƒumenu nyuiwo","poem":1},{"text":"kple nu nyuitɔwo tso anyigba me.”","poem":2}]},{"type":"verse","number":20,"content":["Mose gblɔ tso Gad ŋu be,",{"text":"“Woayra Gad ƒe kpeɖeŋutɔwo,","poem":1},{"text":"Gad tsyɔ akɔ anyi abe dzata ene","poem":2},{"lineBreak":true},{"text":"be yeavuvu abɔ kple ta.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Wotsɔ anyigba ƒe nyuiƒewo","poem":1},{"text":"na wo ɖokuiwo;","poem":2},{"text":"wotsɔ kplɔla ƒe ɖuƒewo na wo.","poem":1},{"text":"Wowɔ Yehowa ƒe sewo kple ɖoɖowo dzi.”","poem":2}]},{"type":"verse","number":22,"content":["Mose gblɔ tso Dan ŋu be,",{"text":"“Dan le abe dzatavi","poem":1},{"text":"si le kpo tim tso Basan ene.”","poem":2}]},{"type":"verse","number":23,"content":["Egblɔ tso Naftali ŋu be:",{"text":"“O! Naftali, Yehowa yra wò ŋutɔ.","poem":1},{"text":"Wò anyigba ɖo anyigbeme","poem":2},{"lineBreak":true},{"text":"tso Galilea ƒu la nu.”","poem":2}]},{"type":"verse","number":24,"content":["Mose gblɔ tso Asar ŋu be:",{"text":"“Woayra Aser wu to bubuawo katã;","poem":1},{"text":"wokpɔ ŋudzedze le eŋu wu nɔviawo,","poem":2},{"lineBreak":true},{"text":"amiti geɖewo amie na wò.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Woatsɔ gayibɔ kple akɔbli atu wò du ƒe agbowoe","poem":1},{"text":"àkpɔ ŋusẽ le wò ŋkekewo katã me!","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ame aɖeke mede Yehowa,","poem":1},{"text":"Yesurun ƒe Mawu la nu o.","poem":2},{"text":"Eɖiɖina tso dziƒo","poem":1},{"text":"Le fianyenye kple ŋutikɔkɔe me","poem":2},{"lineBreak":true},{"text":"be yeaxɔ na wò.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mawu mavɔ lae nye wò sitsoƒe,","poem":1},{"text":"eƒe abɔ mavɔ la le anyigba te.","poem":2},{"text":"Enyaa wò futɔwo ɖa le ŋgɔwò","poem":1},{"text":"eyae gblɔ na mi be,","poem":2},{"lineBreak":true},{"text":"‘Mitsrɔ̃ wo!’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ale Israel nɔa anyi dedie;","poem":1},{"text":"le anyigba si dzi bli kple wain bɔ ɖo,","poem":2},{"lineBreak":true},{"text":"eye tsi dzana tso dziƒo ɖo.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Woayra wò, Israel, ŋutɔŋutɔ!","poem":1},{"text":"Ame bubu kae gakpɔ ɖeɖe","poem":2},{"lineBreak":true},{"text":"tso Yehowa gbɔ?","poem":2},{"text":"Wò akpoxɔnu kple kpeɖeŋutɔe!","poem":1},{"text":"Eyae nye wò yi ɖaɖɛ la.","poem":2},{"text":"Wò futɔwo ade ta agu le ŋgɔwò","poem":1},{"text":"eye nànya avuzi le wo dzi!”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}