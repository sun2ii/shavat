{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"HOS","translationId":"ewe_bib","name":"Hosea","commonName":"Hosea","title":"Hosea ƒe agbalẽ","order":28,"numberOfChapters":14,"sha256":"74c37f5e9c6fa44c6ca50c4ec353676e86c849d70cc88df94fcf8da637f1f999","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/ewe_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"heading","content":["Mawu ƒe lɔlɔ̃ na Israel"]},{"type":"verse","number":1,"content":[{"text":"“Esi Israel nye ɖevi la,","poem":1},{"text":"melɔ̃e, eye Egipte meyɔ vinye la tsoe,","poem":2},{"lineBreak":true},{"text":"abe vinye ŋutsu ene.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Zi ale si meyɔe la,","poem":1},{"text":"zi nenema ke wòtrɔ megbe dem,","poem":2},{"text":"hele vɔ sam na Baalwo,","poem":1},{"text":"eye wòle dzudzɔ ʋeʋĩ dom na legbawo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nyee lé Efraim ƒe alɔnu","poem":1},{"text":"hefia azɔlizɔzɔe,","poem":2},{"text":"gake menyae be","poem":1},{"text":"nyee kpɔ ye ta o.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mekplɔ wo kple dɔmenyo ƒe ka,","poem":1},{"text":"eye mebla wo kple lɔlɔ̃.","poem":2},{"text":"Meɖe kɔkuti la le woƒe kɔ,","poem":1},{"text":"eye mebɔbɔ na nuɖuɖu wo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Nye dukɔ agatrɔ ayi Egipte,","poem":1},{"text":"eye Asiria aɖu wo dzi,","poem":2},{"lineBreak":true},{"text":"elabena wogbe dzimetɔtrɔ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Aʋa adzɔ le woƒe duwo me;","poem":1},{"text":"woagbã woƒe agbo sesẽwo,","poem":2},{"lineBreak":true},{"text":"eye woatɔ te woƒe ɖoɖowo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nye dukɔ ɖoe kplikpaa be yeagbem.","poem":1},{"text":"Esia ta ne woyɔ Mawu, Dziƒoʋĩtɔ la gɔ̃ hã la,","poem":2},{"lineBreak":true},{"text":"womakpɔ xɔxɔ o.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“O, nye Efraim,","poem":1},{"text":"aleke mate ŋu atsɔ wò ana?","poem":2},{"text":"Israel, aleke mate ŋu aɖe asi le ŋuwò?","poem":1},{"text":"Aleke mawɔ agbe wò abe Adma kple Zeboyim ene?","poem":2},{"text":"Nye dzi le avi fam le menye,","poem":1},{"text":"eye nye dzi xɔ dzo ɖe mia ŋuti be maɖe mi!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gbeɖe, nyemahe to na mi","poem":1},{"text":"abe ale si nye dziku helĩhelĩ le gbɔgblɔm nam ene o,","poem":2},{"lineBreak":true},{"text":"eye nyemagbã Efraim gudugudu hã o,","poem":2},{"text":"elabena Mawue menye,","poem":1},{"text":"eye menye amegbetɔe menye o.","poem":2},{"text":"Nyee nye Kɔkɔetɔ si le mia dome","poem":1},{"text":"eye nyemava le dziku me be magblẽ nu o.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Azɔ la, dukɔ la adi Yehowa.","poem":1},{"text":"Aɖe gbe abe dzata ene.","poem":2},{"text":"Ne eɖe gbe la,","poem":1},{"text":"viawo atrɔ agbɔ","poem":2},{"text":"kple dzodzo nyanyanya tso ɣetoɖoƒe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Woatrɔ tso Egipte abe xeviwo ƒe ha gã aɖe ene.","poem":1},{"text":"Nenema ke woatrɔ tso Asiria","poem":2},{"lineBreak":true},{"text":"abe ahɔnɛ ƒe ha gã aɖe ene.","poem":2},{"text":"Magakplɔ wo ayi woƒe aƒewo mee.”","poem":1},{"text":"Yehowae gblɔe.","poem":2}]},{"type":"heading","content":["Israel ƒe nu vɔ̃"]},{"type":"verse","number":12,"content":[{"text":"Efraim ƒo xlãm kple alakpa,","poem":1},{"text":"eye Israel ƒe aƒe la ƒo xlãm kple beble.","poem":2},{"text":"Yuda gadze aglã ɖe Mawu ŋuti,","poem":1},{"text":"eye wòtsi tsitre ɖe anukwaretɔ kple Kɔkɔetɔ la gɔ̃ hã ŋu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}