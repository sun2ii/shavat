{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"HOS","translationId":"ewe_bib","name":"Hosea","commonName":"Hosea","title":"Hosea ƒe agbalẽ","order":28,"numberOfChapters":14,"sha256":"74c37f5e9c6fa44c6ca50c4ec353676e86c849d70cc88df94fcf8da637f1f999","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/ewe_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Efraim ƒua du kplɔa ya ɖo,","poem":1},{"text":"etia ɣedzeƒeya yome ŋkekea katã,","poem":2},{"text":"eye wòdzia alakpa","poem":1},{"text":"kple ŋutasesẽ ɖe edzi.","poem":2},{"text":"Ebla nu kple Asiria,","poem":1},{"text":"eye wòɖo ami ɖe Egipte.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yehowa tsɔ nya ɖe Yuda hã ŋuti.","poem":1},{"text":"Woahe to na Yakob hã le eƒe mɔ vɔ̃wo ta,","poem":2},{"lineBreak":true},{"text":"eye woaɖo eƒe nuwɔnawo teƒe nɛ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Le dɔ me la, elé nɔvia ƒe afɔkpodzi,","poem":1},{"text":"eye esi wòtsi zu ŋutsu la,","poem":2},{"lineBreak":true},{"text":"ete kame kple Mawu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ɛ̃, ete kame kple mawudɔla,","poem":1},{"text":"eye wòɖu edzi gɔ̃ hã.","poem":2},{"text":"Efa avi heɖe kuku nɛ be wòayra ye.","poem":1},{"text":"Edo go Mawu le Betel,","poem":2},{"lineBreak":true},{"text":"ƒo nu kplii le afi ma.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yehowa, Mawu Ŋusẽkatãtɔ","poem":1},{"text":"si ŋkɔe nye Yehowa la ƒo nu nɛ,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"eya ta mitrɔ gbɔ va miaƒe Mawu la gbɔ.","poem":1},{"text":"Minɔ agbe le nyateƒetoto kple lɔlɔ̃ me,","poem":2},{"text":"eye miɖo ŋu ɖe miaƒe Mawu la ŋu be","poem":1},{"text":"wòawɔ nu geɖe na mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Alakpanudanu le asitsalawo si,","poem":1},{"text":"wolɔ̃a amebaba.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Efraim dana gblɔna be:","poem":1},{"text":"“Kesinɔtɔ gã aɖee menye!","poem":2},{"text":"Le nye kesinɔnu gbogboawo ta la,","poem":1},{"text":"womakpɔ vodada alo nu vɔ̃ le menye o.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Yehowa ɖeka kple Mawu ɖeka ma,","poem":1},{"text":"si ɖe wò tso kluvinyenye me le Egipte lae menye,","poem":2},{"text":"eye nye kee ana mianɔ agbadɔwo me","poem":1},{"text":"abe ale si miewɔnɛ ƒe sia ƒe","poem":2},{"lineBreak":true},{"text":"le Agbadɔmeŋkekenyuiɖuɖu me ene.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Medɔ nye nyagblɔɖilawo be","poem":1},{"text":"woaxlɔ̃ nu mi to ŋutega,","poem":2},{"lineBreak":true},{"text":"drɔ̃ekuku kple lododowo me.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ɖe vɔ̃ɖivɔ̃ɖi le Gilgal mahã?","poem":1},{"text":"Vavã wonye bometsilawo.","poem":2},{"text":"Wotsɔ nyitsuwo sa vɔe le Gilead.","poem":1},{"text":"Ɛ̃, woagbã woƒe vɔsamlekpuiwo","poem":2},{"lineBreak":true},{"text":"ali kɔe ɖe agble dzi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yakob si yi ɖe Siria,","poem":1},{"text":"eye Israel subɔ be yeaɖe srɔ̃,","poem":2},{"lineBreak":true},{"text":"eye be yeakpɔ ga abia nyɔnu ta la, ekplɔ alẽ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yehowa kplɔ eƒe dukɔ la do goe","poem":1},{"text":"le Egipte to nyagblɔɖila aɖe dzi,","poem":2},{"lineBreak":true},{"text":"eye wòdzɔ wo ŋuti, fia mɔ wo,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"gake Efraim do dɔmedzoe","poem":1},{"text":"na Yehowa vevie.","poem":2},{"text":"Eƒe Aƒetɔ la ana eƒe nu vɔ̃wo ƒe ʋu nava eƒe ta dzi,","poem":1},{"text":"eye wòaɖo eteƒe nɛ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}