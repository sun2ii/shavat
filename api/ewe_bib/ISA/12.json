{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"ISA","translationId":"ewe_bib","name":"Yesaya","commonName":"Yesaya","title":"Yesaya ƒe agbalẽ","order":23,"numberOfChapters":66,"sha256":"484112406306cc83fc94299ed072e0604de15d5b156c11bbcc227c147eb72fc8","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ewe_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["Kafukafuhawo"]},{"type":"verse","number":1,"content":["Le ɣe ma ɣi la, àgblɔ be,",{"text":"“Makafu wò, O! Yehowa,","poem":1},{"text":"togbɔ be èdo dɔmedzoe ɖe ŋunye tsã hã la,","poem":2},{"text":"wò dɔmedzoe nu yi,","poem":1},{"text":"eye nèfa akɔ nam.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nyateƒe, Mawu nye nye xɔname.","poem":1},{"text":"Maɖo dzi ɖe eŋu, eye nyemavɔ̃ o.","poem":2},{"text":"Ɛ̃, Yehowae nye nye ŋusẽ kple nye hadzidzi,","poem":1},{"text":"eye eyae zu nye xɔname","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Miadu tsi le xɔname ƒe vudowo me kple dzidzɔ.”","poem":1}]},{"type":"verse","number":4,"content":["Le ŋkeke ma dzi la, àgblɔ be,",{"text":"“Mida akpe na Yehowa!","poem":1},{"text":"Miyɔ eƒe ŋkɔ,","poem":2},{"lineBreak":true},{"text":"miɖe gbeƒã eƒe ŋkɔ le xexemedukɔwo dome.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Miɖe gbeƒã Yehowa, elabena ewɔ nu dzɔatsuwo,","poem":1},{"text":"miɖe gbeƒã eƒe kafukafu le xexea me katã.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mido ɣli, eye mitso aseye,","poem":1},{"text":"mi ame siwo le Zion,","poem":2},{"lineBreak":true},{"text":"elabena gãe nye Israel ƒe Kɔkɔetɔ si le mia dome.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}