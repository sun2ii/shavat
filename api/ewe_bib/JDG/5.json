{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"JDG","translationId":"ewe_bib","name":"Ʋɔnudrɔ̃lawo","commonName":"Ʋɔnudrɔ̃lawo","title":"Ʋɔnudrɔ̃lawo ƒe agbalẽ","order":7,"numberOfChapters":21,"sha256":"b945f57f367d4c06b4d4cf6306ce679e421d3f1caae1ad41ffbab62425c2cc3b","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/ewe_bib/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":5,"content":[{"type":"heading","content":["Debora ƒe hadzidzi"]},{"type":"verse","number":1,"content":["Debora kple Barak, Abinoam vi la, dzi ha sia tso woƒe dziɖuɖu wɔnuku la ŋuti."]},{"type":"verse","number":2,"content":[{"text":"“Mikafu Yehowa!","poem":1},{"text":"Israel ƒe kplɔlawo dze ŋgɔ dzideƒotɔe.","poem":2},{"lineBreak":true},{"text":"Ameawo kplɔ wo ɖo dzidzɔtɔe!","poem":2},{"lineBreak":true},{"text":"Ɛ̃, mikafu Yehowa!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Miɖo to, mi fiawo kple fiaviwo,","poem":1},{"text":"mele ha dzi ge tso Yehowa ŋu,","poem":2},{"lineBreak":true},{"text":"tso Israel ƒe Mawu la ŋu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Esi nèkplɔ mí do goe tso Seir","poem":1},{"text":"Heto Edom ƒe anyigba dzi la,","poem":2},{"text":"anyigba dzo nyanyanya,","poem":1},{"text":"dziƒo nu ʋu eye tsi dza.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ɛ̃, towo ʋuʋu, Sinai to la gɔ̃ hã ʋuʋu kpekpekpe","poem":1},{"text":"le Yehowa, Israel ƒe Mawu la ŋkume!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Le Samgar, Anat ƒe vi kple Yael ƒe ɣeyiɣiawo me,","poem":1},{"text":"asitsalawo mezɔa mɔ ma dzi o.","poem":2},{"lineBreak":true},{"text":"Mɔzɔlawo wɔa axadzimɔ xaxɛ gɔdɔ̃ewo ŋu dɔ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Israelviwo ƒe duwo zu aƒedo.","poem":1},{"text":"Va se ɖe esime nye Debora mezu Israel dada.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Esime Israel dze mawu bubuwo yome la,","poem":1},{"text":"futɔwo ho aʋa ɖe wo ŋu.","poem":2},{"text":"Míaƒe kplɔlawo mena akpoxɔnu alo akplɔ mí o","poem":1},{"text":"womekpɔ aʋawɔnu aɖeke kura","poem":2},{"lineBreak":true},{"text":"le Israelvi akpe blaene dome o!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Metso aseye ŋutɔ ɖe Israel ƒe kplɔlawo ta,","poem":1},{"text":"ame siwo tsɔ wo ɖokui na faa!","poem":2},{"lineBreak":true},{"text":"Mikafu Yehowa!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Israelviwo katã, hotsuitɔwo kple ahetɔwo siaa,","poem":1},{"text":"hotsuitɔ siwo doa tedzi ɣiwo","poem":2},{"text":"ɖoa afɔ afɔɖodzinu xɔasiwo dzi","poem":1},{"text":"kple ame dahe, afɔzɔlawo siaa,","poem":2},{"lineBreak":true},{"text":"mikpe ta, miakafui.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hadzila siwo le kɔƒewo me,","poem":1},{"text":"ƒoa ƒu ɖe kɔƒea ƒe vudo gbɔ","poem":2},{"text":"dzia ha tso Yehowa ƒe dziɖuɖu ŋuti.","poem":1},{"text":"Wodzia ha enuenu","poem":2},{"text":"tso ale si Yehowa ɖe Israel","poem":1},{"text":"kple aʋawɔla siwo nye agbledelawo ŋu!","poem":2},{"lineBreak":true},{"text":"Yehowa ƒe amewo zɔ to agbo la me!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Oo, Debora, nyɔ eye nàdzi ha!","poem":1},{"text":"Oo, Barak, tsi tsitre!","poem":2},{"text":"Oo, Abinoam ƒe vi, kplɔ wò aʋaléleawo dzoe!","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Tete nuteƒewɔlawo va woƒe kplɔlawo gbɔ;","poem":1},{"text":"Yehowa ƒe amewo va hena aʋawɔwɔ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wotso Efraimnyigba dzi va balimea","poem":1},{"text":"le Benyamin ƒe viwo megbe.","poem":2},{"text":"Aʋakplɔlawo va tso Makir","poem":1},{"text":"aʋalɔgonunɔlawo va tso Zebulon","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Isaka ƒe fiaviwo, Debora kple Barak,","poem":1},{"text":"ɖiɖi ɖe balime la","poem":2},{"text":"le Mawu ƒe ɖoɖo nu.","poem":1},{"text":"Ke Ruben ƒe viwo ya meyi o.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nu ka ta mietsi aƒe le miaƒe alẽkplɔlawo gbɔ","poem":1},{"text":"be miaɖo to alẽkplɔlawo woanɔ woƒe dzewo kum?","poem":2},{"text":"Mama ɖo Ruben ƒe viwo dome:","poem":1},{"text":"ɖe woayia? Ɖe woagbe yiyia?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nu ka ta Gilead ƒe viwo tsi Yɔdan godo","poem":1},{"text":"Dan ƒe viwo tsi woƒe tɔdziʋuwo gbɔ?","poem":2},{"text":"Nu ka ta Aser ƒe viwo drã ɖe ƒuta","poem":1},{"text":"dzidzemetɔe le woƒe ʋudzeƒewo?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ke Zebulon ƒe viwo kple Naftali ƒe viwo","poem":1},{"text":"tsɔ wo ɖokui ke le aʋagbedzi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kanaan fiawo wɔ aʋa","poem":1},{"text":"le Taanak kple Megido vudowo gbɔ,","poem":2},{"lineBreak":true},{"text":"ke womeɖu futɔwo dzi o.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dziƒo ŋutɔ ƒe ɣletiviwo","poem":1},{"text":"wɔ aʋa kple Sisera.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kison tɔsisi la ƒe tsi sisiwo","poem":1},{"text":"kplɔ wo dzoe.","poem":2},{"lineBreak":true},{"text":"Nye luʋɔ, yi ŋgɔ kple ŋusẽ!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Se futɔwo ƒe sɔwo ƒe afɔzi ɖa!","poem":1},{"text":"Kpɔ woƒe sɔwo ƒe duƒuƒu ɖa!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Gblɔ be, ‘Miƒo fi de wo","poem":1},{"text":"elabena womeva kpe ɖe Yehowa ŋu","poem":2},{"lineBreak":true},{"text":"wɔ aʋa kple futɔwo o.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Woayra Yael,","poem":1},{"text":"Heber, Kenitɔ la srɔ̃","poem":2},{"lineBreak":true},{"text":"woyrae wu nyɔnu siwo nɔa agbadɔ te.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Sisera bia tsii","poem":1},{"text":"eye wòna nyinotsii","poem":2},{"text":"eye wòtsɔ nyinotsi babla","poem":1},{"text":"ɖe gagbɛ si dze bubumewo la me vɛ nɛ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Edo eƒe asi ɖa","poem":1},{"text":"tsɔ tsyoti eye wòtsɔ eƒe nuɖusi","poem":2},{"text":"tsɔ dɔwɔlawo ƒe zu,","poem":1},{"text":"edae ɖe Sisera dzi","poem":2},{"text":"hegbã ta nɛ,","poem":1},{"text":"eŋɔ eye wògbã eƒe glãƒu","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Sisera dze anyi","poem":1},{"text":"ɖe Yael ƒe afɔ nu","poem":2},{"text":"etsi afi si wòdze anyi ɖo.","poem":1},{"text":"Emu, dze to ɖe eƒe afɔ nu,","poem":2},{"text":"afi si wòmu ɖo la,","poem":1},{"text":"afi mae wòdze anyi ɖo","poem":2},{"lineBreak":true},{"text":"eye afi mae wòku ɖo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Sisera dada nɔ fesre nu kpɔm","poem":1},{"text":"tso fesrenuvɔ la megbe","poem":2},{"text":"edo ɣli be,","poem":1},{"text":"‘Nu ka ta eƒe tasiaɖam meva ɖo kpɔ o?","poem":2},{"lineBreak":true},{"text":"Nu ka ta míese tasiaɖam la ƒe afɔzi o?’","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Eƒe nyɔnu ɖeka si dze","poem":1},{"text":"nunya wu wo katã la,","poem":2},{"text":"ɖo eŋu nɛ, vavã,","poem":1},{"text":"enɔ gbɔgblɔm na eɖokui","poem":2},{"text":"ɣe sia ɣi be,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"‘Ɖe menye afunyinu","poem":1},{"text":"geɖe lɔm wole hele mamam","poem":2},{"text":"nyɔnuvi ɖeka alo eve","poem":1},{"text":"na ŋutsu ɖe sia ɖe,","poem":2},{"text":"atsyɔ̃ɖowuwo na Sisera","poem":1},{"text":"abe nuhaha ene,","poem":2},{"text":"atsyɔ̃ɖowu siwo to","poem":1},{"text":"wolɔ̃ nu ɖo,","poem":2},{"text":"wolɔ̃ nu ɖe wo to nyuie","poem":1},{"text":"be woadze kɔme nam","poem":2},{"text":"eye esiawo katã nanye","poem":1},{"text":"nuhaha oa?’","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Oo, Yehowa, na wò futɔwo katã natsrɔ̃ nenema","poem":1},{"text":"ke ame siwo lɔ̃a Yehowa ya la,","poem":2},{"text":"na be woanɔ abe ɣe ene","poem":1},{"text":"ne edze le eƒe ŋusẽ me!”","poem":2},"Tete anyigba la kpɔ ŋutifafa ƒe blaene."]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}