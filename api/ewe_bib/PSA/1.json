{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Woayra ame si","poem":1},{"text":"mezɔna ɖe ame vɔ̃ɖiwo ƒe aɖaŋuɖoɖo nu","poem":2},{"text":"alo nɔa tsitre ɖe nu vɔ̃ wɔlawo ƒe mɔ dzi loo","poem":1},{"text":"alo nɔa anyi ɖe fewuɖulawo dome o,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ke boŋ ekpɔa dzidzɔ le Yehowa ƒe se la ŋu,","poem":1},{"text":"eye wòdea ŋugble le eŋu zã kple keli.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Eya amea ɖi ati si wodo ɖe tɔʋuwo to,","poem":1},{"text":"esi tsea ku le etseɣi,","poem":2},{"text":"melũa xe o, eye","poem":1},{"text":"nu sia nu si wòwɔna la, edzea edzi nyuie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mele alea na ame vɔ̃ɖi ya o!","poem":1},{"text":"Wole abe blitsro si ya ƒona dzonae la ene.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Eya ta ame vɔ̃ɖi manɔ te le ʋɔnudrɔ̃gbe,","poem":1},{"text":"alo nu vɔ̃ wɔlawo nanɔ ame dzɔdzɔewo ƒe ha me o.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Elabena Yehowa kpɔa ame dzɔdzɔewo ƒe mɔ ta,","poem":1},{"text":"ke ame vɔ̃ɖiwo ƒe mɔ atsrɔ̃ gbidii.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}