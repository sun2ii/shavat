tso dzidzime yi dzidzime.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}