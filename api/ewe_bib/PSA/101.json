{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["David ƒe ha."]},{"type":"verse","number":1,"content":[{"text":"O! Yehowa, madzi ha le wò lɔlɔ̃","poem":1},{"text":"kple afia nyui tsotso ŋuti,","poem":2},{"lineBreak":true},{"text":"eye madzi kafukafuha na wò.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Makpɔ nyuie be menɔ agbe si ŋu mokaka mele o,","poem":1},{"text":"eya ta gbe ka gbe nàva asrãm kpɔ?","poem":2},{"lineBreak":true},{"text":"Mazɔ le aƒenye me","poem":1},{"text":"kple dzi si ŋuti mokaka mele o.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nyematsɔ nu si me vɔ̃ le la aɖo nye ŋkume o.","poem":1},{"lineBreak":true},{"text":"Metsri xɔsemanɔsitɔwo ƒe nuwɔnawo,","poem":2},{"lineBreak":true},{"text":"womalé ɖe ŋunye o.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ame siwo ƒe dzi to vo la, ate ɖa xaa tso gbɔnye,","poem":1},{"text":"kadodo aɖeke mele nye kple nu vɔ̃ɖi dome o.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Made ga nu na ame si ƒo ɖi ehavi ƒe ŋkɔ le bebeme,","poem":1},{"text":"eye ame si ŋku gã le esi","poem":2},{"text":"eye wòdana le dzi me la,","poem":1},{"text":"eya nyematɔ ɖe egbɔ o.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nye ŋku anɔ nuteƒewɔlawo ŋu","poem":1},{"text":"le anyigba dzi, be woanɔ anyi kplim.","poem":2},{"text":"Ame si fɔɖiɖi mele eƒe zɔzɔme ŋu o la,","poem":1},{"text":"anye nye nunɔla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ame si nye ameblela la, manɔ aƒenye me o,","poem":1},{"text":"eye ame si daa alakpa la matsi tsitre ɖe ŋkunye me o.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ŋdi sia ŋdi la, mana ame vɔ̃ɖi siwo","poem":1},{"text":"le anyigba dzi la nazi ɖoɖoe.","poem":2},{"text":"Maɖe nu tovo wɔla ɖe sia ɖe ɖa","poem":1},{"text":"le Yehowa ƒe du la me.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}