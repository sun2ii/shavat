{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["David ƒe ha na hɛnɔ la."]},{"type":"verse","number":1,"content":[{"text":"Yehowae mesi tso.","poem":1},{"text":"Aleke miele gbɔgblɔm nam be,","poem":2},{"lineBreak":true},{"text":"“Dzo abe xevi ene nàyi ɖe wò to dzi?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Elabena kpɔ ɖa, ame vɔ̃ɖiwo he woƒe da me;","poem":1},{"text":"wotsɔ woƒe aŋutrɔwo ɖo datikawo ŋuti be","poem":2},{"lineBreak":true},{"text":"woada ame siwo dza le woƒe dzi me la le blukɔ me.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Esi wole gɔmeɖokpeawo gbãm la,","poem":1},{"text":"nu ka dzɔdzɔetɔ la awɔ?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yehowa le eƒe gbedoxɔ kɔkɔe la me;","poem":1},{"text":"Yehowa le eƒe fiazikpui dzi le dziƒo.","poem":2},{"text":"Elé ŋku ɖe amegbetɔviwo ŋu,","poem":1},{"text":"eye wòdo wo kpɔ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yehowa doa ame dzɔdzɔe kpɔna,","poem":1},{"text":"ke eƒe luʋɔ tsri ame vɔ̃ɖiwo","poem":2},{"lineBreak":true},{"text":"kple ame siwo lɔ̃a ŋutasesẽ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ana dzoka xɔxɔ kple aŋɔ dzodzoe nadza ɖe","poem":1},{"text":"ame vɔ̃ɖiwo dzi, eye ya xɔdzo anye wo tɔ gome.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Elabena Yehowae nye dzɔdzɔetɔ, elɔ̃a nuteƒewɔwɔ;","poem":1},{"text":"ame siwo dza le woƒe dzi me la akpɔ eƒe ŋkume.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}