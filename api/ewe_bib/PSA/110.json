{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["David ƒe ha."]},{"type":"verse","number":1,"content":[{"text":"Yehowa gblɔ na nye Aƒetɔ la be,","poem":1},{"lineBreak":true},{"text":"“Nɔ anyi ɖe nye nuɖusime,","poem":1},{"text":"va se ɖe esime matsɔ wò futɔwo","poem":2},{"lineBreak":true},{"text":"awɔ wò afɔɖodzinui.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yehowa adidi wò ŋusẽ ƒe fiatikplɔ ɖe edzi tso Zion,","poem":1},{"text":"eye àɖu fia le wò futɔwo dome.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wò aʋakɔwo alɔ̃ faa ade megbe na wò le wò aʋakpegbe.","poem":1},{"text":"Ànɔ atsyɔ̃ɖoɖo kɔkɔe,","poem":2},{"text":"si do go tso fɔŋli ƒe dɔ me ke la me,","poem":1},{"text":"axɔ wò ɖekakpuimezãmu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yehowa ka atam,","poem":1},{"text":"eye matrɔ eƒe susu akpɔ o, be","poem":2},{"text":"“Wòe nye nunɔla tegbee,","poem":1},{"text":"le Melkizedek ƒe ɖoɖo la nu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Aƒetɔ la le wò nuɖusime,","poem":1},{"text":"agbã fiawo nyanyanya le eƒe dɔmedzoeŋkeke la dzi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Adrɔ̃ ʋɔnu dukɔwo, eye wòali kɔ woƒe kukuawo,","poem":1},{"text":"nenema ke wòagbã dziɖulawo le anyigba blibo la dzi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ano tsi le tɔʋu si le mɔto la me,","poem":1},{"text":"eya ta afɔ eƒe ta dzi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}