{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Mikafu Yehowa.","poem":1},{"lineBreak":true},{"text":"O! Mi Yehowa ƒe dɔlawo,","poem":1},{"text":"mikafui, mikafu Yehowa ƒe ŋkɔ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Woakafu Yehowa ƒe ŋkɔ","poem":1},{"text":"tso fifia yi ɖe mavɔ me ke.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Woakafu Yehowa ƒe ŋkɔ","poem":1},{"text":"tso ɣeyiɣi si ɣe adze va se ɖe esi wòaɖo to ɖe afi si wòɖoa to ɖo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yehowa nye gã ɖe dukɔwo katã dzi,","poem":1},{"text":"eye eƒe ŋutikɔkɔe gbɔ dziƒowo ta.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ame kae le abe Yehowa,","poem":1},{"text":"míaƒe Mawu la ene, ame si nɔ anyi ɖe fiazikpui dzi le dziƒo,","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"eye wòbɔbɔ be yeakpɔ dziƒowo kple anyigba ɖa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Efɔ ame dahe ɖe tsitre tso ke me,","poem":1},{"text":"eye wòfɔ hiãtɔ ɖe dzi tso dzowɔ me;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"hetsɔ wo ɖo dumegãwo xa,","poem":1},{"text":"ɛ̃, woƒe dumegãwo xa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ame si na konɔ nɔa eƒe aƒe me,","poem":1},{"text":"hekpɔa dzidzɔ abe viwo dada ene.","poem":2},{"lineBreak":true},{"text":"Mikafu Yehowa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}