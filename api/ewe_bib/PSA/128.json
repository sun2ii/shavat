.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}