{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["David ƒe ha na hɛnɔ la."]},{"type":"verse","number":1,"content":[{"text":"O! Yehowa, va se ɖe ɣe ka ɣi?","poem":1},{"text":"Ɖe nàŋlɔm be ɖikaɖika?","poem":2},{"lineBreak":true},{"text":"Va se ɖe ɣe ka ɣi nàɣla wò ŋkume ɖem?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Va se ɖe ɣe ka ɣi mawɔ avu kple nye tamesusu,","poem":1},{"text":"eye gbe sia gbe nuxaxa nayɔ nye dzi me?","poem":2},{"lineBreak":true},{"text":"Va se ɖe ɣe ka ɣi nye futɔwo aɖu dzinye?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kpɔm ɖa, eye nàɖo nya ŋu nam,","poem":1},{"text":"O! Yehowa, nye Mawu.","poem":2},{"text":"Na kekeli naklẽ ɖe nye ŋkuwo dzi,","poem":1},{"text":"ne menye nenema o la,","poem":2},{"lineBreak":true},{"text":"madɔ alɔ̃ ayi ku me.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ekema nye futɔwo agblɔ be,","poem":1},{"text":"“Meɖu edzi,” eye nye ketɔwo akpɔ dzidzɔ ne medze anyi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ke nye ya meɖo dzi ɖe wò lɔlɔ̃ si meʋãna o la ŋu,","poem":1},{"text":"nye dzi le aseye tsom le wò xɔname ŋuti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Madzi ha na Yehowa,","poem":1},{"text":"elabena ewɔ nyui nam.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}