{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["Mɔzɔha."]},{"type":"verse","number":1,"content":[{"text":"O! Yehowa, mele koko ƒom na wò tso nye dzi me ke.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O! Aƒetɔ, ɖo to nye gbe.","poem":1},{"text":"Wò to nenɔ te nàse nye nublanuiɣli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"O! Yehowa, ne àlé amewo","poem":1},{"text":"ƒe nu vɔ̃wo ɖe agbalẽ me ada ɖi la,","poem":2},{"lineBreak":true},{"text":"O! Aƒetɔ, ame ka ate ŋu anɔ te?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ke wò la, tsɔtsɔke le gbɔwò,","poem":1},{"text":"eya ta wovɔ̃a wò ɖo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mele Yehowa ƒe asinu kpɔm,","poem":1},{"text":"nye luʋɔ le lalam,","poem":2},{"lineBreak":true},{"text":"eye metsɔ nye mɔkpɔkpɔ da ɖe eƒe nya dzi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nye luʋɔ le lalam na Aƒetɔ la wu","poem":1},{"text":"ale si zãɖialawo kpɔa mɔ na ŋu ƒe keke;","poem":2},{"lineBreak":true},{"text":"mebe wu ale si zãɖialawo kpɔa mɔ na ŋu ƒe keke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"O! Israel, tsɔ wò mɔkpɔkpɔ da ɖe Yehowa dzi,","poem":1},{"text":"elabena lɔlɔ̃ matrɔ le Yehowa si,","poem":2},{"lineBreak":true},{"text":"eye ɖeɖe blibo le eya amea gbɔ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Eya ŋutɔ aɖe Israel","poem":1},{"text":"tso eƒe nu vɔ̃wo katã me.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}