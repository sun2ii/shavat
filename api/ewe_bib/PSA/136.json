{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":136,"content":[{"type":"verse","number":1,"content":[{"text":"Mida akpe na Yehowa, elabena enyo.","poem":1},"Eƒe lɔlɔ̃ li ɖaa."]},{"type":"verse","number":2,"content":[{"text":"Mida akpe na mawuwo dzi Mawu la,","poem":1},"Elabena eƒe lɔlɔ̃ li ɖaa."]},{"type":"verse","number":3,"content":[{"text":"Mida akpe na aƒetɔwo dzi Aƒetɔ la,","poem":1},"Elabena eƒe lɔlɔ̃ li ɖaa."]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Eya ɖeka hɔ̃ɔ koe wɔa nukunu dzɔatsuwo,","poem":1},"Elabena eƒe lɔlɔ̃ li ɖaa."]},{"type":"verse","number":5,"content":[{"text":"Eya ame si tsɔ eƒe nugɔmesese wɔ dziƒowoe,","poem":1},"Elabena eƒe lɔlɔ̃ li ɖaa."]},{"type":"verse","number":6,"content":[{"text":"Ame si keke anyigba ɖe tsiwo dzi,","poem":1},"Elabena eƒe lɔlɔ̃ li ɖaa."]},{"type":"verse","number":7,"content":[{"text":"Ame si wɔ nu keklẽ gãwo,","poem":1},"Elabena eƒe lɔlɔ̃ li ɖaa."]},{"type":"verse","number":8,"content":[{"text":"Be ɣe naɖu ŋkeke dzi,","poem":1},"Elabena eƒe lɔlɔ̃ li ɖaa."]},{"type":"verse","number":9,"content":[{"text":"Be ɣleti kple ɣletiviwo naɖu zã dzi,","poem":1},"Elabena eƒe lɔlɔ̃ li ɖaa."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Eya ame si ƒo Egiptetɔwo ƒe ŋgɔgbeviwo ƒu anyi,","poem":1},"Elabena eƒe lɔlɔ̃ li ɖaa."]},{"type":"verse","number":11,"content":[{"text":"Eye wòkplɔ Israel do goe le wo dome,","poem":1},"Elabena eƒe lɔlɔ̃ li ɖaa."]},{"type":"verse","number":12,"content":[{"text":"Kple asi sesẽ kple abɔ si wòdo ɖe dzi,","poem":1},"Elabena eƒe lɔlɔ̃ li ɖaa."]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Eya ame si ma Ƒu Dzĩ la ɖe eve,","poem":1},"Elabena eƒe lɔlɔ̃ li ɖaa."]},{"type":"verse","number":14,"content":[{"text":"Eye wòkplɔ Israel to eƒe titina,","poem":1},"Elabena eƒe lɔlɔ̃ li ɖaa."]},{"type":"verse","number":15,"content":[{"text":"Ke ekplɔ Farao kple eƒe aʋakɔ la de Ƒu Dzĩ la me,","poem":1},"Elabena eƒe lɔlɔ̃ li ɖaa."]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Eya ame si kplɔ eƒe dukɔ la to gbedzi,","poem":1},"Elabena eƒe lɔlɔ̃ li ɖaa."]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ame si ƒo fia gãwo ƒu anyi,","poem":1},"Elabena eƒe lɔlɔ̃ li ɖaa."]},{"type":"verse","number":18,"content":[{"text":"Eye wòwu fia sesẽwo,","poem":1},"Elabena eƒe lɔlɔ̃ li ɖaa."]},{"type":"verse","number":19,"content":[{"text":"Sixɔn, Amoritɔwo ƒe fia,","poem":1},"Elabena eƒe lɔlɔ̃ li ɖaa"]},{"type":"verse","number":20,"content":[{"text":"kple Ɔg, Basantɔwo ƒe fia,","poem":1},"Elabena eƒe lɔlɔ̃ li ɖaa."]},{"type":"verse","number":21,"content":[{"text":"Eye wòtsɔ woƒe anyigba wɔ domenyinu,","poem":1},"Elabena eƒe lɔlɔ̃ li ɖaa."]},{"type":"verse","number":22,"content":[{"text":"Domenyinu na eƒe dɔla, Israel,","poem":1},"Elabena eƒe lɔlɔ̃ li ɖaa."]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Eya ame si ɖo ŋku mía dzi,","poem":1},{"text":"esime wobɔbɔ mí ɖe anyi,","poem":2},"Elabena eƒe lɔlɔ̃ li ɖaa."]},{"type":"verse","number":24,"content":[{"text":"Eye wòɖe mí tso míaƒe futɔwo ƒe asi me,","poem":1},"elabena eƒe lɔlɔ̃ li ɖaa."]},{"type":"verse","number":25,"content":[{"text":"Eya ame si naa nuɖuɖu nu gbagbe ɖe sia ɖe,","poem":1},"Elabena eƒe lɔlɔ̃ li ɖaa."]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Mida akpe na Dziƒo Mawu la,","poem":1},"Elabena eƒe lɔlɔ̃ li ɖaa."]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}