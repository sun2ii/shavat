{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"Babilonia tɔsisiwo toe míenɔ,","poem":1},{"text":"hɛnɔ avi fam,","poem":2},{"lineBreak":true},{"text":"esi míeɖo ŋku Zion dzi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Míetsɔ míaƒe kasaŋkuwo ku","poem":1},{"text":"amuti siwo le afi ma,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"elabena afi mae ame siwo ɖe","poem":1},{"text":"aboyo mí la bia ha tso mía si le;","poem":2},{"text":"ame siwo wɔ fu mí la bia","poem":1},{"text":"dzidzɔhawo tso mía si hegblɔ be,","poem":2},{"lineBreak":true},{"text":"“Midzi Zion hawo dometɔ ɖeka na mí!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Aleke miadzi Yehowa ƒe hawo","poem":1},{"text":"le dzronyigba dzi?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O! Yerusalem, ne meŋlɔ wò be la,","poem":1},{"text":"nye nuɖusibɔ nèŋlɔ eƒe ŋusẽ be,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"eye nye aɖe nelé ɖe nye nu me,","poem":1},{"text":"ne nyemeɖo ŋku dziwò o,","poem":2},{"text":"ne nyemebu Yerusalem,","poem":1},{"text":"nye dzidzɔ kɔkɔtɔ kekeake o.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"O! Yehowa, ɖo ŋku nu si Edomtɔwo wɔ la dzi,","poem":1},{"text":"gbe si gbe wogbã Yerusalem.","poem":2},{"text":"Wodo ɣli be, “Mimui ƒu anyi,","poem":1},{"text":"migbãe, va se ɖe eƒe gɔmeɖokpewo dzi ke!”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"O! Babilonia vinyɔnu,","poem":1},{"text":"woɖo wò ɖi na tsɔtsrɔ̃,","poem":2},{"text":"woayra ame si aɖo nu si nèwɔ","poem":1},{"text":"mí la teƒe na wò,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ame si alé wò vidzĩwo","poem":1},{"text":"axlã ɖe agakpewo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}