{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"hebrew_subtitle","content":["David ƒe ha."]},{"type":"verse","number":1,"content":[{"text":"O! Yehowa, makafu wò kple nye dzi blibo;","poem":1},{"text":"madzi wò kafukafuha le mawuwo ŋkume.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Made ta agu do ɖe wò gbedoxɔ kɔkɔe la gbɔ,","poem":1},{"text":"eye makafu wò ŋkɔ,","poem":2},{"text":"le wò lɔlɔ̃ kple nuteƒewɔwɔ ta,","poem":1},{"text":"elabena èkɔ, wò ŋkɔ kple wò nya","poem":2},{"lineBreak":true},{"text":"gbɔ nu sia nu ta sãsãsã.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ètɔ nam esi meyɔ wò, eye nède dzi ƒo nam,","poem":1},{"text":"hedo ŋusẽ nye dzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"O! Yehowa, anyigbadzifiawo katã akafu wò,","poem":1},{"text":"ne wose wò numenya.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Na woadzi ha le Yehowa ƒe mɔwo ŋu,","poem":1},{"text":"elabena Yehowa ƒe ŋutikɔkɔe lolo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Togbɔ be Yehowa le dzi me ke hã la, ekpɔa ame dahewo gbɔ,","poem":1},{"text":"ke edzea si dadala tso adzɔge.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Togbɔ be mele zɔzɔm le xaxa me hã la,","poem":1},{"text":"èkpɔ nye agbe ta, eye nèkɔ wò asi dzi do ɖe","poem":2},{"text":"nye futɔwo ƒe dɔmedzoe ŋu,","poem":1},{"text":"hetsɔ wò nuɖusi xɔ nam.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yehowa ana eƒe ta me si wòɖo ɖe ŋunye la nava eme.","poem":1},{"text":"O! Yehowa, wò lɔlɔ̃ li ɖaa,","poem":2},{"lineBreak":true},{"text":"mègagblẽ wò asinudɔwɔwɔwo ɖi o.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}