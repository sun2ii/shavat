{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"hebrew_subtitle","content":["David ƒe ha na hɛnɔ la."]},{"type":"verse","number":1,"content":[{"text":"Bometsila gblɔna le eƒe dzi me be,","poem":1},{"text":"“Mawu aɖeke meli o.”","poem":2},{"text":"Wonye ame tovowo, eye woƒe nuwɔnawo nye ŋunyɔnu;","poem":1},{"text":"ame ɖeka hɔ̃ɔ hã mele wo dome si wɔa nu nyui o.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yehowa bi kɔ kpɔ amegbetɔviwo ɖa tso dziƒo,","poem":1},{"text":"be wòakpɔe ɖa be nugɔmesela aɖe le wo dome,","poem":2},{"lineBreak":true},{"text":"eye wòdia Mawu vevie mahã?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wo katã wodze ɖe aga,","poem":1},{"text":"wo katã tim wogblẽ;","poem":2},{"text":"ame aɖeke meli si wɔa nu nyui o,","poem":1},{"text":"ɖeka pɛ gɔ̃ hã meli o.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ɖe nu tovo wɔlawo,","poem":1},{"text":"ame siwo ɖua nye amewo abe abolo ene,","poem":2},{"lineBreak":true},{"text":"eye womeyɔa Yehowa o la manya esia oa?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ŋɔdzi lé wo ale gbegbe,","poem":1},{"text":"elabena Mawu le ame dzɔdzɔewo ƒe hame.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mi nu tovo wɔlawo,","poem":1},{"text":"miegblẽ ame dahewo ƒe ɖoɖowo me,","poem":2},{"lineBreak":true},{"text":"gake Yehowae nye woƒe sitsoƒe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"O! Xɔname ado tso Zion na Israel.","poem":1},{"text":"Ne Yehowa gaɖo eƒe amewo ƒe nunyonamewo te la,","poem":2},{"lineBreak":true},{"text":"na Yakob natso aseye, eye Israel nakpɔ dzidzɔ!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}