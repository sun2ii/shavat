{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["David ƒe nufiameha esi wònɔ agado me. Gbedodoɖa."]},{"type":"verse","number":1,"content":[{"text":"Medo ɣli na Yehowa sesĩe,","poem":1},{"text":"eye mekɔ nye gbe dzi na Yehowa be wòakpɔ nye nublanui.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Metrɔ nye nuxaxawo kɔ ɖe eŋkume,","poem":1},{"text":"eye metrɔ nye vevesesewo kɔ ɖe eya amea gbɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ne nu ti kɔ na nye gbɔgbɔ le menye la,","poem":1},{"text":"wò koe nya nye mɔ.","poem":2},{"text":"Ŋutsuwo tre mɔ","poem":1},{"text":"ɖe mɔ si metona la dzi nam.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Trɔ ɖe nye ɖusime ne nàkpɔ;","poem":1},{"text":"ame aɖeke metsɔ ɖeke le eme nam o.","poem":2},{"text":"Bebeƒe aɖeke meli nam o,","poem":1},{"text":"eye ame aɖeke metsɔ ɖeke le eme nam o.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"O! Yehowa, wòe mele ɣli dom na.","poem":1},{"text":"Megblɔ be, “Wòe nye nye sitsoƒe,","poem":2},{"lineBreak":true},{"text":"kple nye gome le agbagbeawo ƒe anyigba dzi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ɖo to nye ɣlidodo,","poem":1},{"text":"elabena meɖo xaxa me ŋutɔ.","poem":2},{"text":"Ɖem tso ame siwo le yonyeme tim la ƒe asi me,","poem":1},{"text":"elabena wosesẽ nam akpa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ɖem tso nye gaxɔ me,","poem":1},{"text":"be makafu wò ŋkɔ.","poem":2},{"text":"Ekema ame dzɔdzɔewo aɖe to ɖem,","poem":1},{"text":"le wò nyui si nèwɔ nam la ta.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}