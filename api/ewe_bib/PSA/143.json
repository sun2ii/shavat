{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":143,"content":[{"type":"hebrew_subtitle","content":["David ƒe ha."]},{"type":"verse","number":1,"content":[{"text":"O! Yehowa, se nye gbedodoɖa,","poem":1},{"text":"lé to ɖe nye nublanuiɣli ŋu,","poem":2},{"text":"eye nàxɔ nam le wò nuteƒewɔwɔ","poem":1},{"text":"kple dzɔdzɔenyenye ta.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mègabu fɔ wò dɔla o,","poem":1},{"text":"elabena amegbetɔ aɖeke","poem":2},{"lineBreak":true},{"text":"mele dzɔdzɔe le ŋkuwò me o.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Futɔ la ti yonyeme,","poem":1},{"text":"egbãm ɖe anyigba,","poem":2},{"text":"eye wòna menɔ viviti me abe","poem":1},{"text":"ame siwo ku xoxo va yi la ene.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nu te nye gbɔgbɔ ŋu le menye,","poem":1},{"text":"eye nye dzi wɔ yaa le menye.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Meɖo ŋku blemaŋkekeawo dzi,","poem":1},{"text":"hede ŋugble le wò dɔwɔwɔwo katã ŋuti,","poem":2},{"lineBreak":true},{"text":"eye mebu nu siwo wò asiwo wɔ la ŋuti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mekeke nye abɔwo me na wò,","poem":1},{"text":"eye nye luʋɔ ƒe ve me ƒu ɖe ŋuwò","poem":2},{"lineBreak":true},{"text":"abe kuɖiɖinyigba ene. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"O! Yehowa, tɔ nam kaba,","poem":1},{"text":"elabena nu te nye gbɔgbɔ ŋu.","poem":2},{"text":"Mègaɣla wò mo ɖem o,","poem":1},{"text":"ne menye nenema o la,","poem":2},{"lineBreak":true},{"text":"manɔ abe ame siwo yi aʋlime ene.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Na ŋdi natsɔ wò lɔlɔ̃ si meʋãna o","poem":1},{"text":"la ƒe nya vɛ nam,","poem":2},{"lineBreak":true},{"text":"elabena dziwòe meka ɖo.","poem":2},{"text":"Fia mɔ si mato lam,","poem":1},{"text":"elabena wòe medo nye luʋɔ ɖe dzi na.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"O! Yehowa, ɖem tso nye futɔwo ƒe asi me,","poem":1},{"text":"elabena mewòe mebe ɖo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Fiam ale si mawɔ wò lɔlɔ̃nu,","poem":1},{"text":"elabena wòe nye nye Mawu;","poem":2},{"text":"na wò Gbɔgbɔ nyui la nakplɔm","poem":1},{"text":"to anyigba sɔsɔe dzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"O! Yehowa, le wò ŋkɔ la ta,","poem":1},{"text":"kpɔ nye agbe ta,","poem":2},{"text":"le wò dzɔdzɔenyenye ta,","poem":1},{"text":"ɖem le xaxa me.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Le wò lɔlɔ̃ si meʋãna o la ta, mia nu na nye futɔwo;","poem":1},{"text":"tsrɔ̃ nye ketɔwo katã,","poem":2},{"lineBreak":true},{"text":"elabena wò dɔlae menye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}