{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"Mikafu Yehowa.","poem":1},{"lineBreak":true},{"text":"Mikafu Yehowa tso dziƒowo,","poem":1},{"text":"mikafui le kɔkɔƒewo le dzi me.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mi eƒe dɔlawo katã mikafui,","poem":1},{"text":"dziƒoʋakɔwo hã mikafui.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ɣe kple ɣleti nekafui,","poem":1},{"text":"mikafui, mi ɣletivi keklẽwo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mi dziƒo kɔkɔtɔwo, mikafui,","poem":1},{"text":"eye mi tsi siwo le alilĩa tame hã mikafui.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wo katã nekafu Yehowa ƒe ŋkɔ,","poem":1},{"text":"elabena eɖe gbe, eye wova dzɔ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Etsɔ wo ɖo wo nɔƒe tso mavɔ me yi ɖe mavɔ me,","poem":1},{"text":"ede se si nu mayi akpɔ gbeɖe o.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mikafu Yehowa tso anyigba,","poem":1},{"text":"mi nuwɔwɔ gã siwo le atsiaƒu me kple gogloƒewo katã.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dzikedzo kple kpetsi,","poem":1},{"text":"tsikpe kple lilikpowo, ahomya si wɔ eƒe lɔlɔ̃nu,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"mi towo kple togbɛwo katã,","poem":1},{"text":"atikutsetsetiwo kple sedatiwo katã,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"gbemelãwo kple nyiwo katã,","poem":1},{"text":"nuwɔwɔ suewo kple xe dzodzoewo,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"anyigbadzifiawo kple dukɔwo katã,","poem":1},{"text":"mi dumegãwo kple dziɖula siwo katã le anyigba dzi,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ɖekakpuiwo kple ɖetugbiwo,","poem":1},{"text":"ame tsitsiwo kple ɖeviwo siaa nekafui.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mikafu Yehowa ƒe ŋkɔ,","poem":1},{"text":"elabena eƒe ŋkɔ ɖeɖe koe de dzi,","poem":2},{"lineBreak":true},{"text":"eye eƒe atsyɔ̃ le anyigba kple dziƒowo tame.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ena dzo aɖe do na eƒe dukɔ,","poem":1},{"text":"esi nye Israel,","poem":2},{"text":"eƒe ame kɔkɔewo katã ƒe kafukafu,","poem":1},{"text":"ame siwo tsɔ ɖe eƒe dzi gbɔ.","poem":2},{"lineBreak":true},{"text":"Mikafu Yehowa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}