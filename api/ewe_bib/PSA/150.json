afu Yehowa.","poem":1},{"lineBreak":true},{"text":"Mikafu Yehowa!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}