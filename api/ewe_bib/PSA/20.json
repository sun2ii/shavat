menya be Yehowa ɖe eƒe amesiamina,","poem":1},{"text":"etɔ nɛ tso eƒe nɔƒe kɔkɔe la","poem":2},{"lineBreak":true},{"text":"kple eƒe nuɖusi ƒe ŋusẽ, si wòtsɔna ɖea amee.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ame aɖewo ɖoa ŋu ɖe tasiaɖamwo ŋu,","poem":1},{"text":"eye ame aɖewo ɖoa dzi ɖe sɔwo ŋu,","poem":2},{"text":"ke míawo ya míeɖo dzi ɖe Yehowa,","poem":1},{"text":"míaƒe Mawu la ƒe ŋkɔ ŋu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ame mawo la, wodzea klo, eye wodzea anyi,","poem":1},{"text":"ke míawo ya, míenɔa tsitre, eye míedzɔna kã.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"O! Yehowa, xɔ na fia la!","poem":1},{"text":"Tɔ na mí ne míeyɔ wò!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}