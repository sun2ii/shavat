{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["David ƒe ha."]},{"type":"verse","number":1,"content":[{"text":"Yehowae nye kplɔnyela,","poem":1},{"text":"eya ta naneke mahiãm o.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lãnyiƒe damawo dzi wòna metsyɔ akɔ ɖo,","poem":1},{"text":"eye wòkplɔm yi tɔʋu fafɛwo gbɔe,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"hena nye luʋɔ gbɔ agbe.","poem":1},{"text":"Ekplɔm to dzɔdzɔenyenye ƒe","poem":2},{"lineBreak":true},{"text":"mɔwo dzi le eƒe ŋkɔ la ta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne mezɔ to ku ƒe balime si do viviti tsiɖitsiɖi hã la,","poem":1},{"text":"nyemavɔ̃ dzɔgbevɔ̃e aɖeke o,","poem":2},{"text":"elabena wòe le gbɔnye, eye wò lãkplɔti","poem":1},{"text":"kple atikplɔ faa akɔ nam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Èɖo kplɔ̃ ɖe akɔnyeme le nye ketɔwo ƒe ŋkume.","poem":1},{"text":"Èsi ami ɖe ta nam, nye kplu yɔ gbagba.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Vavãe, dzɔgbenyui kple amenuveve adze yonyeme","poem":1},{"text":"le nye agbemeŋkekewo katã me,","poem":2},{"lineBreak":true},{"text":"eye manɔ Yehowa ƒe aƒe me ɖaa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}