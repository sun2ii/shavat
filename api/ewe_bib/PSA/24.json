nt":[{"text":"O! Yakob ƒe Mawu,","poem":1},{"text":"aleae dzidzime si dia wò,","poem":2},{"lineBreak":true},{"text":"eye wòdia ŋkuwòme la le. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"O! Mi agbowo, miʋu;","poem":1},{"text":"mi blemaʋɔtruwo, miʋu,","poem":2},{"lineBreak":true},{"text":"ne Ŋutikɔkɔefia la nage ɖe eme.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ame kae nye Ŋutikɔkɔefia la?","poem":1},{"text":"Yehowa ŋusẽtɔ kple kalẽtɔ lae,","poem":2},{"lineBreak":true},{"text":"Yehowa si wɔa kalẽ le aʋagbedzi lae.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"O! Mi agbowo, miʋu;","poem":1},{"text":"mi blemaʋɔtruwo, miʋu,","poem":2},{"lineBreak":true},{"text":"ne Ŋutikɔkɔefia la nage ɖe eme.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ame kae nye Ŋutikɔkɔefia sia?","poem":1},{"text":"Yehowa Ŋusẽkatãtɔ lae nye Ŋutikɔkɔefia la. Sela.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}