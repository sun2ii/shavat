{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"hebrew_subtitle","content":["David ƒa ha."]},{"type":"verse","number":1,"content":[{"text":"O! Yehowa, tso afia nam,","poem":1},{"text":"elabena menɔ agbe si ŋu fɔɖiɖi mele o.","poem":2},{"text":"Meɖo dzi ɖe Yehowa ŋu,","poem":1},{"text":"nyemeʋã kpɔ gbeɖe o.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"O! Yehowa, lolom, dom kpɔ;","poem":1},{"text":"eye nàdzro nye dzi kple tamesusu hã me,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"elabena wò lɔlɔ̃ le ŋkunye me ɖaa,","poem":1},{"text":"eye mezɔna le wò nyateƒe la me ɣe sia ɣi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nyemanɔ anyi ɖe ameblelawo dome,","poem":1},{"text":"alo ade ha kple alakpanuwɔlawo o.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Metsri ame tovowo ƒe habɔbɔ,","poem":1},{"text":"eye megbe be nyemanɔ ame vɔ̃ɖiwo dome o.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Meklɔ nye asiwo le fɔmaɖimaɖi me,","poem":1},{"text":"eye meƒo xlã wò vɔsamlekpui, O! Yehowa,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"hele wò kafukafuha dzim","poem":1},{"text":"kple ɣli le nukudɔ siwo katã nèwɔ la xlẽm fia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"O! Yehowa, melɔ̃ aƒe si me nèle,","poem":1},{"text":"afi si wò ŋutikɔkɔe le.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mègatsɔ nye luʋɔ kpe ɖe nu vɔ̃ wɔlawo ŋuti","poem":1},{"text":"kple nye agbe kpe ɖe hlɔ̃dolawo ŋuti,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ame siwo ƒe asi me ɖoɖo vɔ̃ɖiwo le,","poem":1},{"text":"eye woƒe nuɖusime yɔ fũu kple zãnuxɔxɔ o.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ke nye la, menɔ agbe si ŋu fɔɖiɖi mele o,","poem":1},{"text":"eya ta ɖem, eye nàkpɔ nublanui nam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nye afɔ le sɔsɔeƒe.","poem":1},{"text":"Makafu Yehowa le takpekpe gã la me.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}