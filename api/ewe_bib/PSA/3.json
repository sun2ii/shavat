{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["David ƒe ha, esi wòsi le via Absalom nu."]},{"type":"verse","number":1,"content":[{"text":"O, Yehowa, aleke nye futɔwo sɔ gbɔ ale!","poem":1},{"text":"Aleke ame geɖewo tso ɖe ŋunye ale!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ame geɖewo le gbɔgblɔm tso ŋutinye be,","poem":1},{"text":"“Mawu maɖee akpɔ o.” Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"O, Yehowa, ke wò la, ènye akpoxɔnu ƒo xlãm;","poem":1},{"text":"ètsɔ ŋutikɔkɔe kɔ ɖe dzinye, eye nèkɔ nye ta dzi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yehowae medo ɣli na sesĩe,","poem":1},{"text":"eye wòtɔ nam tso eƒe to kɔkɔe la dzi. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Memlɔ anyi hedɔ alɔ̃;","poem":1},{"text":"meganyɔ, elabena Yehowae kpɔ tanye.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nyemavɔ̃ na ame akpe nane siwo ho,","poem":1},{"text":"ɖe to ɖem godoo la o.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tso, O, Yehowa! Ɖem, O, nye Mawu!","poem":1},{"text":"Ƒo tome na nye futɔwo katã;","poem":2},{"lineBreak":true},{"text":"eye nàŋe aɖu na ame vɔ̃ɖiwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yehowa gbɔe ɖeɖe tsona.","poem":1},{"text":"Na be wò yayra nanɔ wò amewo dzi. Sela.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}