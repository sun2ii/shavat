{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"hebrew_subtitle","content":["David ƒe ha na hɛnɔ la. Woadzii ɖe kasaŋku ŋu."]},{"type":"verse","number":1,"content":[{"text":"Nye Mawu dzɔdzɔetɔ,","poem":1},{"text":"tɔ nam ne meyɔ wò.","poem":2},{"text":"Na gbɔdzɔem le nye xaxa me;","poem":1},{"text":"kpɔ nye nublanui, eye nàse nye gbedodoɖa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"O! Amegbetɔviwo, va se ɖe ɣe ka ɣie","poem":1},{"text":"miaɖi gbɔ̃ nye ŋutikɔkɔe?","poem":2},{"text":"Va se ɣe ka ɣie mialɔ̃ beble,","poem":1},{"text":"ahadze aʋatsomawuwo yome? Sela","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Minyae be Yehowa tia mawuvɔ̃lawo na eɖokui,","poem":1},{"text":"eya ta Yehowa asee, ne meyɔe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Migawɔ nu vɔ̃ ne dzi ku mi o;","poem":1},{"text":"ne miele miaƒe abawo dzi la,","poem":2},{"lineBreak":true},{"text":"midzro miaƒe dziwo me, eye mizi ɖoɖoe. Sela","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Misa vɔ siwo le dzɔdzɔe,","poem":1},{"text":"eye miɖo dzi ɖe Yehowa ŋu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ame geɖewo le biabiam be, “Ame kae afia nu nyui aɖe mí?”","poem":1},{"text":"Na wò mo ƒe kekeli naklẽ ɖe mía dzi, O! Yehowa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ètsɔ dzidzɔ gã aɖe yɔ nye dzi me wu ame siwo bli","poem":1},{"text":"kple wain yeye do agbogbo na.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mamlɔ anyi, adɔ alɔ̃ le ŋutifafa me,","poem":1},{"text":"elabena wò, Yehowa, koe na mele dedie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}