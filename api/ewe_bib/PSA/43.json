{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"O! Mawu, tso afia nam,","poem":1},{"text":"eye nàʋli tanye le mawumavɔ̃lawo dome,","poem":2},{"lineBreak":true},{"text":"ɖem tso ame vɔ̃ɖiwo kple ameblelawo ƒe asi me.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wòe nye Mawu, nye mɔ sesẽ.","poem":1},{"text":"Nu ka ta nègbem ɖo?","poem":2},{"text":"Nu ka ta manɔ yiyim, anɔ nu xam","poem":1},{"text":"le nye futɔwo ƒe teteɖeanyi ta ɖo?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ɖo wò kekeli kple nyateƒe ɖa, ne woakplɔm;","poem":1},{"text":"na woakplɔm ayi ɖe wò to kɔkɔe la dzi, afi si nènɔna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ekema mayi ɖe Mawu ƒe vɔsamlekpui ŋgɔ,","poem":1},{"text":"Mawu si nye nye aseyetsotso kple nye dzidzɔ.","poem":2},{"lineBreak":true},{"text":"O! Mawu, nye Mawu, makafu wò kple kasaŋku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"O! Nye luʋɔ, nu ka ta nèle nu xam ɖo?","poem":1},{"text":"Nu ka ta nètsi dzodzodzoe le menye ɖo?","poem":2},{"text":"Tsɔ wò mɔkpɔkpɔ da ɖe Mawu dzi,","poem":1},{"text":"elabena magakafui,","poem":2},{"lineBreak":true},{"text":"eya ame si nye nye Ɖela kple nye Mawu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}