{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["Korah ƒe viwo ƒe ha na hɛnɔ la."]},{"type":"verse","number":1,"content":[{"text":"Miƒo asikpe, mi dukɔwo katã.","poem":1},{"text":"Mitso aseye ɖe Mawu ŋu kple ɣli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ŋɔdzi le Yehowa Dziƒoʋĩtɔ la ŋu ale gbegbe,","poem":1},{"text":"eyae nye Fiagã ɖe anyigba la katã dzi!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ebɔbɔ dukɔwo ɖe mía te,","poem":1},{"text":"eye wòtsɔ anyigbadzitɔwo de míaƒe afɔ te.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Etia míaƒe domenyinu na mí si nye dada na Yakob,","poem":1},{"text":"ame si wòlɔ̃. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mawu yi dzi kple aseyetsotso,","poem":1},{"text":"Yehowa yi dzi kple kpẽ ƒe ɖiɖi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Midzi kafukafuhawo na Mawu,","poem":1},{"text":"midzi kafukafuhawo;","poem":2},{"text":"midzi kafukafuhawo na míaƒe Fia la,","poem":1},{"text":"midzi kafukafuhawo,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"elabena Mawue nye Fia ɖe anyigba blibo la dzi,","poem":1},{"text":"midzi kafukafuha nɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mawu ɖu fia ɖe dukɔwo dzi.","poem":1},{"text":"Mawu nɔ anyi ɖe eƒe fiazikpui kɔkɔe la dzi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dukɔwo ƒe bubumewo ɖi anyi","poem":1},{"text":"abe Abraham ƒe Mawu la ƒe amewo ene,","poem":2},{"text":"elabena anyigbadzifiawo nye Mawu tɔ,","poem":1},{"text":"elabena wodo eya amea ɖe dzi bobobo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}