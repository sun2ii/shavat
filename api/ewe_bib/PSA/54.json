{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["David ƒe ha na hɛnɔ la. Woadzii ɖe kasaŋku ŋu. David kpa ha sia esi Zifitɔwo yi Saul gbɔ gblɔ nɛ be, “Ɖe David meva ɣla ɖe mía dome oa?”"]},{"type":"verse","number":1,"content":[{"text":"Ɖem, O! Mawu, ɖem kple wò ŋkɔ,","poem":1},{"text":"tsɔ wò ŋusẽ tso afia nam.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"O! Mawu, se nye gbedodoɖa,","poem":1},{"text":"eye nàƒu to anyi ɖe nye numenyawo ŋu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Amedzrowo tso ɖe ŋunye,","poem":1},{"text":"ŋutasẽlawo ti nye agbe yome,","poem":2},{"lineBreak":true},{"text":"ame siwo mebua Mawu ɖe naneke me o. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mawu nye nye xɔnametɔ vavã,","poem":1},{"text":"Aƒetɔ lae nye ame si lém ɖe asi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Vɔ̃ negbugbɔ va ame siwo le ŋunye gblẽm la dzi,","poem":1},{"text":"tsrɔ̃ wo le wò nuteƒewɔwɔ ta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Masa lɔlɔ̃nuvɔsa na wò,","poem":1},{"text":"O! Yehowa, makafu wò ŋkɔ, elabena enyo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Eɖem tso nye xaxawo katã me,","poem":1},{"text":"eye nye ŋkuwo kpɔ ale si woɖu nye futɔwo dzii.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}