{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["David ƒe ha na hɛnɔ la. Woadzii ɖe kasaŋku ŋu."]},{"type":"verse","number":1,"content":[{"text":"Se nye ɣlidodo, O Mawu,","poem":1},{"text":"eye nàlé to ɖe nye gbedodoɖa ŋu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Meyɔ wò tso anyigba ƒe mlɔenu,","poem":1},{"text":"meyɔ wò, esi nu te nye dzi ŋu belibelibeli;","poem":2},{"lineBreak":true},{"text":"azɔ kplɔm yi ɖe agakpe si kɔ wum la dzi,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"elabena wòe nye nye sitsoƒe","poem":1},{"text":"kple mɔ sesẽ, le futɔ la ta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Medi vevie be manɔ wò agbadɔ me tegbee,","poem":1},{"text":"eye mabe ɖe wò aʋala ƒe fafaƒe. Sela","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O! Mawu, èse nye adzɔgbeɖeɖewo,","poem":1},{"text":"eye nètsɔ ame siwo vɔ̃a wò ŋkɔ la ƒe domenyinu nam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dzi fia la ƒe agbemeŋkekewo ɖe edzi nɛ,","poem":1},{"text":"eƒe ƒewo nasɔ gbɔ be wòakpɔ dzidzime geɖewo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Neɖu fia le Mawu ŋkume tegbee,","poem":1},{"text":"eye na wò lɔlɔ̃ kple nuteƒewɔwɔ nakpɔ eta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ekema madzi kafukafuha na wò ŋkɔ tegbee,","poem":1},{"text":"eye maxe nye adzɔgbeɖefewo gbe sia gbe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}