{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"hebrew_subtitle","content":["Ha na hɛnɔ la. Woadzii ɖe kasaŋku ŋu."]},{"type":"verse","number":1,"content":[{"text":"Mawu, ve mía nu, eye nàyra mí,","poem":1},{"text":"na wò mo naklẽ ɖe mía dzi, Sela","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ale be woanya wò mɔwo le anyigba dzi","poem":1},{"text":"kple wò xɔxɔ le dukɔwo dome.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"O! Mawu, dukɔwo akafu wò,","poem":1},{"text":"anyigbadzidukɔwo katã akafu wò.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dukɔwo akpɔ dzidzɔ, adzi ha, atso aseye,","poem":1},{"text":"elabena èɖu dukɔwo dzi le dzɔdzɔenyenye me,","poem":2},{"lineBreak":true},{"text":"eye nèkplɔ anyigbadzidukɔwo. Sela","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mawu, dukɔwo katã akafu wò;","poem":1},{"text":"wòe dukɔwo katã akafu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ekema anyigba ana woaxa eƒe nukuwo fũu, eye Mawu,","poem":1},{"text":"míaƒe Mawu la ayra mí.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mawu ayra mí, eye anyigba","poem":1},{"text":"ƒe mlɔenutɔwo katã avɔ̃e.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}