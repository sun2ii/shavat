type":"verse","number":5,"content":[{"text":"Èwɔe wòsɔ kple Mawu kloe,","poem":1},{"text":"eye nètsɔ ŋutikɔkɔe kple bubu ɖɔ nɛ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Èwɔe be wòanye agbo ɖe wò asinudɔwɔwɔ dzi;","poem":1},{"text":"eye nètsɔ nu sia nu de eƒe afɔ te.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Alẽhawo, nyihawo,","poem":1},{"text":"gbemelãwo,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"dziƒoxeviwo, ƒumelãwo","poem":1},{"text":"kple nu siwo katã ƒua tsi","poem":2},{"lineBreak":true},{"text":"le atsiaƒu me la le eƒe kpɔkplɔ te.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"O Yehowa, míaƒe Aƒetɔ,","poem":1},{"text":"aleke wò ŋkɔ ƒe gãnyenye yɔ anyigba katã dzi ale!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}