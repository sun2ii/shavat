{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["Asaf ƒe ha."]},{"type":"verse","number":1,"content":[{"text":"Mawu nɔ zi me na takpekpe gã la,","poem":1},{"text":"eye wòdrɔ̃ ʋɔnu le “mawuwo” dome.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Va se ɖe ɣe ka ɣi miaʋli ame baɖa la ta,","poem":1},{"text":"eye miatso afia ade ame vɔ̃ɖi la dzi?” Sela","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Miʋli ame gblɔewo kple tsyɔ̃eviwo ta,","poem":1},{"text":"eye miwɔ dɔmenyo na hiãtɔwo kple ame siwo wote ɖe to.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mixɔ na ame gblɔewo kple hiãtɔwo,","poem":1},{"text":"eye miɖe wo tso ame vɔ̃ɖiwo ƒe asi me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Womenya naneke o, womese naneke gɔme o.","poem":1},{"text":"Wole zɔzɔm le blukɔ me,","poem":2},{"lineBreak":true},{"text":"eye anyigba ƒe agunuwo katã ʋuʋu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Megblɔ be, ‘Mawuwoe mienye;","poem":1},{"text":"mi katã mienye Dziƒoʋĩtɔ la ƒe viŋutsuwo’,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"gake miaku abe amegbetɔwo ko ene","poem":1},{"text":"eye miatsi aʋa abe fia ɖe sia ɖe ko ene.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"O! Mawu, tso, eye nàdrɔ̃ ʋɔnu anyigba la","poem":1},{"text":"elabena dukɔwo katã nye wò domenyinu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}