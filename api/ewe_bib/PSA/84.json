{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":84,"content":[{"type":"hebrew_subtitle","content":["Korah ƒe viwo ƒe ha na hɛnɔ la. Woadzii ɖe gitit ƒe gbeɖiɖi nu."]},{"type":"verse","number":1,"content":[{"text":"O! Yehowa, Dziƒoʋakɔwo ƒe Aƒetɔ,","poem":1},{"text":"wò nɔƒe dzeani loo!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yehowa, wò xɔxɔnuwo","poem":1},{"text":"le nye luʋɔ dzrom kutɔkutɔe.","poem":2},{"text":"Nye dzi kple ŋutilã","poem":1},{"text":"le vivi dom ɖe Mawu gbagbe la ŋu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O! Yehowa, Dziƒoʋakɔwo ƒe Aƒetɔ,","poem":1},{"text":"Fianye kple Mawunye,","poem":2},{"text":"sagbadre gɔ̃ hã kpɔ nɔƒe,","poem":1},{"text":"eye atsutsrɔe wɔ atɔ na eɖokui,","poem":2},{"text":"afi si wòatsɔ viawo ada ɖo,","poem":1},{"text":"be wòate ɖe wò vɔsamlekpui la ŋu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Woayra ame siwo nɔa wò aƒe me la,","poem":1},{"text":"elabena wole kafuwòm ɖaa. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Woayra ame siwo ƒe ŋusẽ le mewò,","poem":1},{"text":"ame siwo ƒe dzi ku ɖe xɔsemɔzɔzɔ ŋuti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne woto Baka Balime la,","poem":1},{"text":"wowɔnɛ wòzua tsidzɔƒewo,","poem":2},{"lineBreak":true},{"text":"eye kelemetsi tsyɔa edzi kple yayra.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wole azɔli dzi tso ŋusẽ me yi ŋusẽ me va se ɖe","poem":1},{"text":"esime wo dometɔ ɖe sia ɖe nado ɖe Mawu ŋkume le Zion.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yehowa, Mawu Ŋusẽkatãtɔ;","poem":1},{"text":"O! Yakob ƒe Mawu,","poem":2},{"lineBreak":true},{"text":"ɖo to nye gbedodoɖa. Sela","poem":2}]},{"type":"verse","number":9,"content":[{"text":"O! Mawu, nye kɔ nàkpɔ míaƒe akpoxɔnu,","poem":1},{"text":"eye nakpɔ wò amesiamina la kple amenuveve.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ŋkeke ɖeka le wò xɔxɔnu nyo wu akpe le afi aɖe;","poem":1},{"text":"enyo be manye agbonudzɔla","poem":2},{"text":"le Mawu ƒe aƒe me wu be manɔ","poem":1},{"text":"ame vɔ̃ɖi ƒe agbadɔ me,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"elabena Yehowa Mawue nye ɣe kple akpoxɔnu.","poem":1},{"text":"Yehowae naa amenuveve kple bubu,","poem":2},{"text":"eye metea nu nyui ame siwo fɔɖiɖi","poem":1},{"text":"mele woƒe zɔzɔme ŋu o.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"O! Yehowa, Dziƒoʋakɔwo ƒe Aƒetɔ,","poem":1},{"text":"woayra ŋutsu si ɖoa dzi ɖe ŋuwò la.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}