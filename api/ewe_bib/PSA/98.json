{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"hebrew_subtitle","content":["Hadzidzi."]},{"type":"verse","number":1,"content":[{"text":"Midzi ha yeye na Yehowa, elabena ewɔ nu dzɔatsuwo;","poem":1},{"text":"eƒe nuɖusi kple eƒe abɔ kɔkɔe la wɔ ɖeɖedɔ nɛ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yehowa na wonya eƒe ɖeɖe, eye wòklo nu","poem":1},{"text":"le eƒe dzɔdzɔenyenye dzi na dukɔwo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Eɖo ŋku eƒe lɔlɔ̃","poem":1},{"text":"kple nuteƒewɔwɔ dzi na Israel ƒe aƒe la,","poem":2},{"text":"eye anyigba ƒe mlɔenu ke hã","poem":1},{"text":"kpɔ míaƒe Mawu la ƒe ɖeɖe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mi anyigbawo katã,","poem":1},{"text":"mido dzidzɔɣli na Yehowa,","poem":2},{"lineBreak":true},{"text":"migli kple hadzidzi kple saŋkuƒoƒo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Midzi ha na Yehowa kple kasaŋku,","poem":1},{"text":"mitsɔ kasaŋku, hadzidzi,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"kpẽkuku kple lãdzokuku","poem":1},{"text":"kpakple dzidzɔɣli do ɖe Yehowa, fia la ŋkume.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mina atsiaƒu kple nu siwo katã le eme la nado ɣli,","poem":1},{"text":"anyigba kple edzinɔlawo katã hã.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mina tɔsisiwo naƒo asikpe,","poem":1},{"text":"eye towo katã nadzi ha ɖekae le dzidzɔkpɔkpɔ ta.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wonedzi ha le Yehowa ŋkume,","poem":1},{"text":"elabena eva ʋɔnu drɔ̃ ge anyigba la.","poem":2},{"text":"Adrɔ̃ ʋɔnu anyigba la le dzɔdzɔenyenye me","poem":1},{"text":"kple dukɔwo ameŋkumemakpɔmakpɔtɔe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}