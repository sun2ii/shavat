{"translation":{"id":"ewe_bib","name":"Biblica® Se aɖeke mebla Biblia zazã o Agbenya La™","website":"https://ebible.org/Scriptures/details.php?id=ewe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ewe","licenseNotes":null,"shortName":"BIB","englishName":"Éwé Bible","language":"ewe","textDirection":"ltr","sha256":"5615fe15ce3ce8f4e874d3bd9d29d11a6467861cef53c9f938acf4a4b3681992","availableFormats":["json"],"listOfBooksApiLink":"/api/ewe_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Eʋegbe","languageEnglishName":"Ewe"},"book":{"id":"PSA","translationId":"ewe_bib","name":"Psalmowo","commonName":"Psalmowo","title":"Psalmowo","order":19,"numberOfChapters":150,"sha256":"0e8b5ec7cc9b4d05d39f16d01a32f202ecc2392e9a05abf43a99b75aa6de0995","firstChapterNumber":1,"firstChapterApiLink":"/api/ewe_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ewe_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"Yehowa le fia ɖum, dukɔwo nedzo nyanyanya,","poem":1},{"text":"enɔ eƒe fiazikpui dzi gli le kerubiwo dome,","poem":2},{"lineBreak":true},{"text":"anyigba neʋuʋu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yehowa nye gã le Zion,","poem":1},{"text":"ekɔ gbɔ dukɔwo katã ta.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wonekafu wò ŋkɔ gã,","poem":1},{"text":"dziŋɔ la, eya amea le kɔkɔe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Fia la nye ŋusẽtɔ,","poem":1},{"text":"elɔ̃a afia nyui tsotso,","poem":2},{"text":"wò la, èɖo dzɔdzɔenyenye anyi,","poem":1},{"text":"eye nèwɔ nu si le dzɔdzɔe le Yakob me.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mido Yehowa, míaƒe Mawu la","poem":1},{"text":"ɖe dzi, eye mide ta agu ɖe eƒe afɔ nu,","poem":2},{"lineBreak":true},{"text":"elabena eya amea le kɔkɔe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mose kple Aron le eƒe nunɔlawo dome;","poem":1},{"text":"Samuel le ame siwo yɔ eƒe ŋkɔ la dome;","poem":2},{"lineBreak":true},{"text":"woyɔ Yehowa ŋkɔ, eye wòtɔ na wo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Eƒo nu na wo tso lilikpo dodo me,","poem":1},{"text":"eye wolé se kple ɖoɖo siwo wòtsɔ na wo la me ɖe asi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"O! Yehowa, míaƒe Mawu, wòe tɔ na wo;","poem":1},{"text":"togbɔ be èhe to na wo","poem":2},{"text":"le woƒe nu tovowo ta hã la,","poem":1},{"text":"ènye tsɔtsɔke ƒe Mawu na Israel.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mido Yehowa, miaƒe Mawu la ɖe dzi,","poem":1},{"text":"eye misubɔe le eƒe to kɔkɔe la dzi,","poem":2},{"lineBreak":true},{"text":"elabena Yehowa, míaƒe Mawu la le kɔkɔe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ewe_bib/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ewe_bib/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ewe_bib/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}