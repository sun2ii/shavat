{"translation":{"id":"ffm_wbt","name":"Aadi keyri: linjiila iisaa almasiihu","website":"https://ebible.org/Scriptures/details.php?id=ffm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ffm","licenseNotes":null,"shortName":"WBT","englishName":"Maasina Fulfulde NT","language":"ffm","textDirection":"ltr","sha256":"c390570ed70d72b9f83f358d08ac12679cab070772134185c1a16ab55917448e","availableFormats":["json"],"listOfBooksApiLink":"/api/ffm_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7937,"languageName":"Maasina Fulfulde","languageEnglishName":"Maasina Fulfulde"},"book":{"id":"HEB","translationId":"ffm_wbt","name":"Ibaraninkooɓe","commonName":"Ibaraninkooɓe","title":"Ɓataaki faade e Ibaraninkooɓe","order":58,"numberOfChapters":13,"sha256":"d42e3ff8dd96c420aa9689eb40dc1da907027b23e60282077bbe5e76c971b2f4","firstChapterNumber":1,"firstChapterApiLink":"/api/ffm_wbt/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/ffm_wbt/HEB/13.json","totalNumberOfVerses":302},"chapter":{"number":1,"content":[{"type":"heading","content":["No Laamɗo haaldiri e men Ɓiyum"]},{"type":"verse","number":1,"content":["Laamɗo haaldiino e njaatiraaɓe men gila ko ɓooyi cili keewɗi e sifaaji keewɗi, o haaldiri e maɓɓe annabaaɓe."]},{"type":"verse","number":2,"content":["Kaa e ley ɗee ɲalaaɗe cakitotooɗe o haaldirii e men Ɓiyiiko mo o tagiri aduna oo fuu, mo o waɗi donoowo huunde fuu oo."]},{"type":"verse","number":3,"content":["Kaɲum woni jalbugol annoora teddeengal Laamɗo, kaɲum nanndi e Laamɗo jaati, omo tammborii huunde fuu konngol makko jogiingol semmbe. Caggal nde o tilii laɓɓinde luutti yimɓe ɗii ndee, o jooɗii ɲaamo Laamɗo Toowɗo oo to dow kammu too."]},{"type":"verse","number":4,"content":["Ɗum ɓurni mo malaa'ika'en teddude fotude e innde nde Laamɗo hokki mo ɓurnde inɗe maɓɓe ɗee."]},{"type":"heading","content":["Haala Ɓiɗɗo ɓurɗo malaa'ika'en"]},{"type":"verse","number":5,"content":["Fay gooto e malaa'ika'en ɓee Laamɗo wiyaali:",{"text":"«Aan a Ɓiyam,","poem":1},{"text":"hannde laatii-mi baam maa.»","poem":2},{"noteId":0},"Naa kasen:",{"text":"«Mi laatoo Baaba mum,","poem":1},{"text":"laatoo Ɓiyam.»","poem":2},{"noteId":1}]},{"type":"verse","number":6,"content":["Kasen duu, nde o nelata hammadiijo makko oo e aduna oo ndee, o wii:",{"text":"«Yo malaa'ika'en Laamɗo fuu cujidana ɗum.»","poem":1},{"noteId":2}]},{"type":"verse","number":7,"content":["Laamɗo wii banngal malaa'ika'en ɓee:",{"text":"«O waɗii malaa'ika'en makko kenuuli,","poem":1},{"lineBreak":true},{"text":"o waɗii kaadime'en makko lewle yiite.»","poem":1},{"noteId":3}]},{"type":"verse","number":8,"content":["Kaa banngal Ɓiɗɗo oo, mo wii:",{"text":"«Laamu maa, aan Laamɗo, woodan faa abada abadin!","poem":1},{"lineBreak":true},{"text":"Fooccitaare yo tuugorde laamu maa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aɗa yiɗi fooccitaare,","poem":1},{"text":"aɗa waɲi ooɲaare,","poem":2},{"text":"saabe ɗum, Laamɗo Joomiraaɗo maa suɓori maa,","poem":1},{"text":"hokku maa seyo ɓurngo ngo wondiiɓe maa ngoo.»","poem":2},{"noteId":4}]},{"type":"verse","number":10,"content":["O wii kasen:",{"text":"«Gila e fuɗɗoode, Joomiraaɗo,","poem":1},{"text":"aan tabintini leydi,","poem":2},{"text":"juuɗe maa tagir-ɗaa kammuuji ɗii,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"kanji ɗi timman, kaa aan, a heddoto,","poem":1},{"text":"ɗi fuu ɗi kiiɗɗiran no kaddule nii,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"a sowiran ɗi no saaya nii,","poem":1},{"text":"ɗi mbattitoroo no neɗɗo wattitortoo e saayaaji mum nii.","poem":2},{"text":"Kaa aan, a wattitataako,","poem":1},{"text":"nguurndam maa duu timmataa.»","poem":2},{"noteId":5}]},{"type":"verse","number":13,"content":["Fay nde wootere, Laamɗo wiyaali gooto e malaa'ika'en:",{"text":"«Jooɗa ɲaamo am,","poem":1},{"text":"faa mi waɗa njaɓɓaa wayɓe maa.»","poem":2},{"noteId":6}]},{"type":"verse","number":14,"content":["Malaa'ika'en ɓee fuu yo ruuhuuji gollanooji Laamɗo, ɗi mo nelata faa ngollana heɓooɓe kisindam ɓee."]}],"footnotes":[{"noteId":0,"caller":"+","text":"Jabuura 2.7","reference":{"chapter":1,"verse":5}},{"noteId":1,"caller":"+","text":"2 Samuyila 7.14","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"Fillitagol Tawreeta 32.43","reference":{"chapter":1,"verse":6}},{"noteId":3,"caller":"+","text":"Jabuura 104.4","reference":{"chapter":1,"verse":7}},{"noteId":4,"caller":"+","text":"Jabuura 45.7-8","reference":{"chapter":1,"verse":9}},{"noteId":5,"caller":"+","text":"Jabuura 102.26-28","reference":{"chapter":1,"verse":12}},{"noteId":6,"caller":"+","text":"Jabuura 110.1","reference":{"chapter":1,"verse":13}}]},"thisChapterLink":"/api/ffm_wbt/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ffm_wbt/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ffm_wbt/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}