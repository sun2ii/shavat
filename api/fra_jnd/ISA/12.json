ulte, habitante de Sion, car grand, au milieu de toi, est le Saint d’Israël."]}],"footnotes":[{"noteId":71,"caller":"a","text":"voir les notes à Exode 15. 2 ; Psaume 68. 5.","reference":{"chapter":12,"verse":2}},{"noteId":72,"caller":"b","text":"ailleurs : l’Éternel.","reference":{"chapter":12,"verse":2}},{"noteId":73,"caller":"c","text":"ou : ma délivrance.","reference":{"chapter":12,"verse":2}},{"noteId":74,"caller":"d","text":"ou : Que cela soit connu dans.","reference":{"chapter":12,"verse":5}}]},"thisChapterLink":"/api/fra_jnd/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_jnd/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_jnd/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}