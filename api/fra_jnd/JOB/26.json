{"translation":{"id":"fra_jnd","name":"Bible J.N. Darby","website":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseNotes":null,"shortName":"JND","englishName":"French: Bible J.N. Darby","language":"fra","textDirection":"ltr","sha256":"121a3f4841e42965f22ebebcf5a8578a12578ec30eaf1ca7ae4e46d5d85ccb80","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_jnd/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"français","languageEnglishName":"French"},"book":{"id":"JOB","translationId":"fra_jnd","name":"Le livre de Job","commonName":"Le livre de Job","title":"Le livre de Job","order":18,"numberOfChapters":42,"sha256":"fa71d4970915dda346d251a8ddc659a2b8e2ca0cda90538f7e737840322cd8dd","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_jnd/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/fra_jnd/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":["*Et Job répondit et dit :"]},{"type":"verse","number":2,"content":[{"text":"Comme tu as aidé celui qui n’avait pas de puissance ! Comme tu as délivré le bras qui était sans force !","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Quel conseil tu as donné à celui qui n’avait pas de sagesse ! et quelle abondance d’intelligence tu as montrée !","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pour qui as-tu prononcé des paroles, et de qui est le souffle qui est sorti de toi ?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Les trépassés tremblent au-dessous des eaux et de ceux qui les habitent.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Le shéol est à nu devant lui, et l’abîme","poem":1},{"noteId":101},{"text":"n’a pas de voile.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Il étend le nord sur le vide, il suspend la terre sur le néant.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Il serre les eaux dans ses nuages, et la nuée ne se fend pas sous elles ;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Il couvre la face de son trône et étend ses nuées par-dessus.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Il a tracé un cercle fixe sur la face des eaux, jusqu’à la limite extrême où la lumière confine aux ténèbres.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Les colonnes des cieux branlent et s’étonnent à sa menace.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Il soulève","poem":1},{"noteId":102},{"text":"la mer par sa puissance, et, par son intelligence, il brise Rahab","poem":1},{"noteId":103},{"text":".","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Par son Esprit le ciel est beau ; sa main a formé","poem":1},{"noteId":104},{"text":"le serpent fuyard.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Voici, ces choses sont les bords de ses voies, et combien faible est le murmure que nous en avons entendu","poem":1},{"noteId":105},{"text":"! Et le tonnerre de sa force, qui peut le comprendre ?","poem":1}]}],"footnotes":[{"noteId":101,"caller":"a","text":"propr. : destruction; héb. : abaddon; comp. 28. 22.","reference":{"chapter":26,"verse":6}},{"noteId":102,"caller":"b","text":"qqs. : apaise.","reference":{"chapter":26,"verse":12}},{"noteId":103,"caller":"c","text":"ici : monstre marin; ou : son insolence.","reference":{"chapter":26,"verse":12}},{"noteId":104,"caller":"d","text":"ou : transpercé.","reference":{"chapter":26,"verse":13}},{"noteId":105,"caller":"e","text":"ou : nous avons entendu de lui.","reference":{"chapter":26,"verse":14}}]},"thisChapterLink":"/api/fra_jnd/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_jnd/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_jnd/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}