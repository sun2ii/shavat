{"translation":{"id":"fra_jnd","name":"Bible J.N. Darby","website":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseNotes":null,"shortName":"JND","englishName":"French: Bible J.N. Darby","language":"fra","textDirection":"ltr","sha256":"121a3f4841e42965f22ebebcf5a8578a12578ec30eaf1ca7ae4e46d5d85ccb80","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_jnd/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"français","languageEnglishName":"French"},"book":{"id":"PSA","translationId":"fra_jnd","name":"Les Psaumes","commonName":"Les Psaumes","title":"Les Psaumes","order":19,"numberOfChapters":150,"sha256":"4c48a766d24644f7ef347ae1395ef8ddb5d363cc30acf1733162d22f071b120e","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_jnd/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_jnd/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":100,"content":[{"type":"verse","number":1,"content":[{"text":"Psaume d’action de grâces. Poussez des cris de joie vers l’Éternel, toute la terre !","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Servez l’Éternel avec joie, venez devant lui avec des chants de triomphe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sachez que l’Éternel est Dieu. C’est lui qui nous a faits, et ce n’est pas nous","poem":1},{"noteId":305},{"text":"; [nous sommes] son peuple, et le troupeau de sa pâture.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Entrez dans ses portes avec des actions de grâces, dans ses parvis avec des louanges. Célébrez-le, bénissez son nom !","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Car l’Éternel est bon ; sa bonté demeure à","poem":1},{"noteId":306},{"text":"toujours, et sa fidélité de génération en génération.","poem":1}]}],"footnotes":[{"noteId":305,"caller":"a","text":"d’autres lisent : et nous sommes à lui.","reference":{"chapter":100,"verse":3}},{"noteId":306,"caller":"b","text":"litt. : [est] à.","reference":{"chapter":100,"verse":5}}]},"thisChapterLink":"/api/fra_jnd/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_jnd/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_jnd/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}