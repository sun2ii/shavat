{"translation":{"id":"fra_jnd","name":"Bible J.N. Darby","website":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseNotes":null,"shortName":"JND","englishName":"French: Bible J.N. Darby","language":"fra","textDirection":"ltr","sha256":"121a3f4841e42965f22ebebcf5a8578a12578ec30eaf1ca7ae4e46d5d85ccb80","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_jnd/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"français","languageEnglishName":"French"},"book":{"id":"PSA","translationId":"fra_jnd","name":"Les Psaumes","commonName":"Les Psaumes","title":"Les Psaumes","order":19,"numberOfChapters":150,"sha256":"4c48a766d24644f7ef347ae1395ef8ddb5d363cc30acf1733162d22f071b120e","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_jnd/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_jnd/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Louez Jah.","poem":1},{"noteId":353},{"text":"Louez, vous serviteurs de l’Éternel, louez le nom de l’Éternel.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Le nom de l’Éternel soit béni, dès maintenant et à toujours !","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Du soleil levant jusqu’au soleil couchant, le nom de l’Éternel soit loué !","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"L’Éternel est haut élevé par-dessus toutes les nations ; sa gloire est au-dessus des cieux.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Qui est comme l’Éternel, notre Dieu ? Il a placé sa demeure en haut ;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Il s’abaisse pour regarder dans les cieux et sur la terre ;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"De la poussière il fait lever le misérable, de dessus le fumier il élève le pauvre,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pour les faire asseoir avec les nobles, avec les nobles de son peuple ;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Il fait habiter la femme stérile dans une maison, joyeuse mère de fils. Louez Jah !","poem":1},{"noteId":354}]}],"footnotes":[{"noteId":353,"caller":"a","text":"Alléluia !","reference":{"chapter":113,"verse":1}},{"noteId":354,"caller":"a","text":"Alléluia !","reference":{"chapter":113,"verse":9}}]},"thisChapterLink":"/api/fra_jnd/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_jnd/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_jnd/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}