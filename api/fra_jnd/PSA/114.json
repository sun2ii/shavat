{"translation":{"id":"fra_jnd","name":"Bible J.N. Darby","website":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseNotes":null,"shortName":"JND","englishName":"French: Bible J.N. Darby","language":"fra","textDirection":"ltr","sha256":"121a3f4841e42965f22ebebcf5a8578a12578ec30eaf1ca7ae4e46d5d85ccb80","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_jnd/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"français","languageEnglishName":"French"},"book":{"id":"PSA","translationId":"fra_jnd","name":"Les Psaumes","commonName":"Les Psaumes","title":"Les Psaumes","order":19,"numberOfChapters":150,"sha256":"4c48a766d24644f7ef347ae1395ef8ddb5d363cc30acf1733162d22f071b120e","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_jnd/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_jnd/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"*Quand Israël sortit d’Égypte, [et] la maison de Jacob d’avec un peuple qui parle une langue étrangère,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Juda fut son sanctuaire, Israël la sphère de sa domination.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"La mer le vit, et s’enfuit ; le Jourdain retourna en arrière ;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Les montagnes sautèrent comme des béliers, les collines comme des agneaux.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Qu’avais-tu, mer, pour t’enfuir ; toi, Jourdain, pour retourner en arrière ?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Vous, montagnes, pour sauter comme des béliers ; vous, collines, comme des agneaux ?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Devant la face du Seigneur, tremble, ô terre ! devant la face du ✝Dieu de Jacob,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Qui a changé le rocher en un étang d’eau, la pierre dure en une source d’eaux.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/fra_jnd/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_jnd/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_jnd/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}