{"translation":{"id":"fra_jnd","name":"Bible J.N. Darby","website":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseNotes":null,"shortName":"JND","englishName":"French: Bible J.N. Darby","language":"fra","textDirection":"ltr","sha256":"121a3f4841e42965f22ebebcf5a8578a12578ec30eaf1ca7ae4e46d5d85ccb80","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_jnd/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"français","languageEnglishName":"French"},"book":{"id":"PSA","translationId":"fra_jnd","name":"Les Psaumes","commonName":"Les Psaumes","title":"Les Psaumes","order":19,"numberOfChapters":150,"sha256":"4c48a766d24644f7ef347ae1395ef8ddb5d363cc30acf1733162d22f071b120e","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_jnd/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_jnd/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":121,"content":[{"type":"verse","number":1,"content":[{"text":"Cantique des degrés. J’élève mes yeux vers les montagnes d’où vient mon secours","poem":1},{"noteId":398},{"text":";","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mon secours [vient] d’auprès de l’Éternel, qui a fait les cieux et la terre.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Il ne permettra point que ton pied soit ébranlé ; celui qui te garde ne sommeillera pas.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Voici, celui qui garde Israël ne sommeillera pas, et ne dormira pas.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"L’Éternel est celui qui te garde ; l’Éternel est ton ombre, à ta main droite.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Le soleil ne te frappera pas de jour, ni la lune de nuit.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"L’Éternel te gardera de tout mal ; il gardera ton âme.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"L’Éternel gardera ta sortie et ton entrée, dès maintenant et à toujours.","poem":1}]}],"footnotes":[{"noteId":398,"caller":"a","text":"ou : montagnes ; d’où vient mon secours ?","reference":{"chapter":121,"verse":1}}]},"thisChapterLink":"/api/fra_jnd/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_jnd/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_jnd/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}