{"translation":{"id":"fra_jnd","name":"Bible J.N. Darby","website":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseNotes":null,"shortName":"JND","englishName":"French: Bible J.N. Darby","language":"fra","textDirection":"ltr","sha256":"121a3f4841e42965f22ebebcf5a8578a12578ec30eaf1ca7ae4e46d5d85ccb80","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_jnd/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"français","languageEnglishName":"French"},"book":{"id":"PSA","translationId":"fra_jnd","name":"Les Psaumes","commonName":"Les Psaumes","title":"Les Psaumes","order":19,"numberOfChapters":150,"sha256":"4c48a766d24644f7ef347ae1395ef8ddb5d363cc30acf1733162d22f071b120e","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_jnd/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_jnd/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":122,"content":[{"type":"verse","number":1,"content":[{"text":"Cantique des degrés. De David. Je me suis réjoui quand ils m’ont dit : Allons à la maison de l’Éternel !","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nos pieds se tiendront dans tes portes, ô Jérusalem !","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jérusalem, qui es bâtie comme une ville bien unie ensemble en elle-même !","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"C’est là que montent les tribus, les tribus de Jah, un témoignage à Israël, pour célébrer le nom de l’Éternel.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Car là sont placés les trônes de jugement, les trônes de la maison de David.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Demandez la paix de Jérusalem ; ceux qui t’aiment prospéreront.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Que la paix soit dans tes murs, la prospérité dans tes palais !","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"À cause de mes frères et de mes compagnons, je dirai : Que la paix soit en toi !","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À cause de la maison de l’Éternel, notre Dieu, je rechercherai ton bien.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/fra_jnd/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_jnd/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_jnd/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}