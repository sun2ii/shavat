{"translation":{"id":"fra_jnd","name":"Bible J.N. Darby","website":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseNotes":null,"shortName":"JND","englishName":"French: Bible J.N. Darby","language":"fra","textDirection":"ltr","sha256":"121a3f4841e42965f22ebebcf5a8578a12578ec30eaf1ca7ae4e46d5d85ccb80","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_jnd/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"français","languageEnglishName":"French"},"book":{"id":"PSA","translationId":"fra_jnd","name":"Les Psaumes","commonName":"Les Psaumes","title":"Les Psaumes","order":19,"numberOfChapters":150,"sha256":"4c48a766d24644f7ef347ae1395ef8ddb5d363cc30acf1733162d22f071b120e","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_jnd/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_jnd/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":124,"content":[{"type":"verse","number":1,"content":[{"text":"Cantique des degrés. De David. N’eût été l’Éternel, qui a été pour nous, – qu’Israël le dise,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N’eût été l’Éternel, qui a été pour nous quand les hommes se sont élevés contre nous, –","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Alors ils nous auraient engloutis vivants, quand leur colère s’enflammait contre nous ;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alors les eaux nous auraient submergés, un torrent aurait passé sur notre âme ;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Alors les eaux orgueilleuses auraient passé sur notre âme.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Béni soit l’Éternel, qui ne nous a pas livrés en proie à leurs dents !","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Notre âme est échappée comme un oiseau du piège des oiseleurs : le piège s’est rompu, et nous sommes échappés.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Notre secours est dans le nom de l’Éternel, qui a fait les cieux et la terre.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/fra_jnd/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_jnd/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_jnd/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}