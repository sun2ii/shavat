{"translation":{"id":"fra_jnd","name":"Bible J.N. Darby","website":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseNotes":null,"shortName":"JND","englishName":"French: Bible J.N. Darby","language":"fra","textDirection":"ltr","sha256":"121a3f4841e42965f22ebebcf5a8578a12578ec30eaf1ca7ae4e46d5d85ccb80","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_jnd/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"français","languageEnglishName":"French"},"book":{"id":"PSA","translationId":"fra_jnd","name":"Les Psaumes","commonName":"Les Psaumes","title":"Les Psaumes","order":19,"numberOfChapters":150,"sha256":"4c48a766d24644f7ef347ae1395ef8ddb5d363cc30acf1733162d22f071b120e","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_jnd/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_jnd/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":126,"content":[{"type":"verse","number":1,"content":[{"text":"Cantique des degrés. Quand l’Éternel rétablit les captifs de Sion, nous étions comme ceux qui songent.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Alors notre bouche fut remplie de rire, et notre langue de chants de joie ; alors on dit parmi les nations : L’Éternel a fait de grandes choses pour ceux-ci !","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"L’Éternel a fait de grandes choses pour nous ; nous en avons été réjouis.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ô Éternel ! rétablis nos captifs, comme les ruisseaux dans le midi !","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ceux qui sèment avec larmes moissonneront avec chant de joie.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Il va en pleurant, portant la semence qu’il répand ; il revient avec chant de joie, portant ses gerbes.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/fra_jnd/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_jnd/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_jnd/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}