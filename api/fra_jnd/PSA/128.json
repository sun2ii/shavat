{"translation":{"id":"fra_jnd","name":"Bible J.N. Darby","website":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseNotes":null,"shortName":"JND","englishName":"French: Bible J.N. Darby","language":"fra","textDirection":"ltr","sha256":"121a3f4841e42965f22ebebcf5a8578a12578ec30eaf1ca7ae4e46d5d85ccb80","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_jnd/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"français","languageEnglishName":"French"},"book":{"id":"PSA","translationId":"fra_jnd","name":"Les Psaumes","commonName":"Les Psaumes","title":"Les Psaumes","order":19,"numberOfChapters":150,"sha256":"4c48a766d24644f7ef347ae1395ef8ddb5d363cc30acf1733162d22f071b120e","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_jnd/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_jnd/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":128,"content":[{"type":"verse","number":1,"content":[{"text":"Cantique des degrés. Bienheureux quiconque craint l’Éternel, [et] marche dans ses voies !","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Car tu mangeras du travail de tes mains ; tu seras bienheureux, et tu seras entouré de biens","poem":1},{"noteId":403},{"text":".","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ta femme sera au-dedans de ta maison comme une vigne féconde","poem":1},{"noteId":404},{"text":"; tes fils seront comme des plants d’oliviers autour de ta table.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Voici, ainsi sera béni l’homme qui craint l’Éternel.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"L’Éternel te bénira de Sion. Et puisses-tu voir le bien de Jérusalem tous les jours de ta vie,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Et voir des fils de tes fils ! La paix soit sur","poem":1},{"noteId":405},{"text":"Israël !","poem":1}]}],"footnotes":[{"noteId":403,"caller":"a","text":"ailleurs : prospéreras.","reference":{"chapter":128,"verse":2}},{"noteId":404,"caller":"b","text":"ou : sera comme une vigne féconde aux côtés de ta maison.","reference":{"chapter":128,"verse":3}},{"noteId":405,"caller":"c","text":"ou : [et] la paix sur.","reference":{"chapter":128,"verse":6}}]},"thisChapterLink":"/api/fra_jnd/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_jnd/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_jnd/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}