{"translation":{"id":"fra_jnd","name":"Bible J.N. Darby","website":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseNotes":null,"shortName":"JND","englishName":"French: Bible J.N. Darby","language":"fra","textDirection":"ltr","sha256":"121a3f4841e42965f22ebebcf5a8578a12578ec30eaf1ca7ae4e46d5d85ccb80","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_jnd/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"français","languageEnglishName":"French"},"book":{"id":"PSA","translationId":"fra_jnd","name":"Les Psaumes","commonName":"Les Psaumes","title":"Les Psaumes","order":19,"numberOfChapters":150,"sha256":"4c48a766d24644f7ef347ae1395ef8ddb5d363cc30acf1733162d22f071b120e","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_jnd/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_jnd/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":129,"content":[{"type":"verse","number":1,"content":[{"text":"Cantique des degrés. Ils m’ont souvent opprimé dès ma jeunesse, – qu’Israël le dise, –","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ils m’ont souvent opprimé dès ma jeunesse ; cependant ils n’ont pas prévalu sur moi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Des laboureurs ont labouré mon dos, ils y ont tracé leurs longs sillons.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"L’Éternel est juste ; il a coupé les cordes des méchants.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Qu’ils soient couverts de honte, et se retirent en arrière, tous ceux qui haïssent Sion.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Qu’ils soient comme l’herbe des toits, qui sèche avant qu’on l’arrache,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dont le moissonneur ne remplit pas sa main, ni le lieur de gerbes son sein ;…","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Et les passants ne disent pas : La bénédiction de l’Éternel soit sur vous ! nous vous bénissons au nom de l’Éternel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/fra_jnd/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_jnd/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_jnd/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}