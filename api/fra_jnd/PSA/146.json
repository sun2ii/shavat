{"translation":{"id":"fra_jnd","name":"Bible J.N. Darby","website":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseNotes":null,"shortName":"JND","englishName":"French: Bible J.N. Darby","language":"fra","textDirection":"ltr","sha256":"121a3f4841e42965f22ebebcf5a8578a12578ec30eaf1ca7ae4e46d5d85ccb80","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_jnd/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"français","languageEnglishName":"French"},"book":{"id":"PSA","translationId":"fra_jnd","name":"Les Psaumes","commonName":"Les Psaumes","title":"Les Psaumes","order":19,"numberOfChapters":150,"sha256":"4c48a766d24644f7ef347ae1395ef8ddb5d363cc30acf1733162d22f071b120e","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_jnd/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_jnd/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"*Louez Jah.","poem":1},{"noteId":444},{"text":"Mon âme, loue l’Éternel !","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Je louerai l’Éternel durant ma vie ; je chanterai des cantiques à mon Dieu tant que j’existerai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ne vous confiez pas dans les principaux, dans un fils d’homme, en qui il n’y a pas de salut.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Son esprit sort, l’homme retourne dans le sol d’où il est tiré","poem":1},{"noteId":445},{"text":"; en ce même jour ses desseins périssent.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bienheureux celui qui a le ✶Dieu de Jacob pour son secours, qui s’attend à l’Éternel, son Dieu,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Qui a fait les cieux et la terre, la mer, et tout ce qui s’y trouve ; qui garde la vérité à toujours ;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Qui exécute le jugement en faveur des opprimés ; qui donne du pain à ceux qui ont faim !","poem":1},{"lineBreak":true},{"text":"L’Éternel met en liberté les prisonniers.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"L’Éternel ouvre les yeux des aveugles ; l’Éternel relève ceux qui sont courbés ; l’Éternel aime les justes ;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"L’Éternel garde les étrangers ; il affermit l’orphelin et la veuve, et confond","poem":1},{"noteId":446},{"text":"la voie des méchants.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"L’Éternel régnera à toujours, – ton Dieu, ô Sion ! de génération en génération. Louez Jah !","poem":1},{"noteId":447}]}],"footnotes":[{"noteId":444,"caller":"a","text":"Alléluia !","reference":{"chapter":146,"verse":1}},{"noteId":445,"caller":"b","text":"litt. : il retourne dans son sol.","reference":{"chapter":146,"verse":4}},{"noteId":446,"caller":"c","text":"propr. : rend tortueuse.","reference":{"chapter":146,"verse":9}},{"noteId":447,"caller":"a","text":"Alléluia !","reference":{"chapter":146,"verse":10}}]},"thisChapterLink":"/api/fra_jnd/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_jnd/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_jnd/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}