{"translation":{"id":"fra_jnd","name":"Bible J.N. Darby","website":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseNotes":null,"shortName":"JND","englishName":"French: Bible J.N. Darby","language":"fra","textDirection":"ltr","sha256":"121a3f4841e42965f22ebebcf5a8578a12578ec30eaf1ca7ae4e46d5d85ccb80","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_jnd/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"français","languageEnglishName":"French"},"book":{"id":"PSA","translationId":"fra_jnd","name":"Les Psaumes","commonName":"Les Psaumes","title":"Les Psaumes","order":19,"numberOfChapters":150,"sha256":"4c48a766d24644f7ef347ae1395ef8ddb5d363cc30acf1733162d22f071b120e","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_jnd/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_jnd/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"Louez Jah.","poem":1},{"noteId":457},{"text":"Chantez à l’Éternel un cantique nouveau ! [Chantez] sa louange dans la congrégation des saints","poem":1},{"noteId":458},{"text":".","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Qu’Israël se réjouisse en celui qui l’a fait ; que les fils de Sion s’égaient en leur roi !","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Qu’ils louent son nom avec des danses, qu’ils chantent ses louanges avec le tambourin et avec la harpe !","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Car l’Éternel prend plaisir en son peuple ; il pare les débonnaires de salut.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Que les saints","poem":1},{"noteId":459},{"text":"se réjouissent de","poem":1},{"noteId":460},{"text":"la gloire, qu’ils exultent avec chant de triomphe sur leurs lits !","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Les louanges de ✶Dieu sont dans leur bouche","poem":1},{"noteId":461},{"text":", et une épée à deux tranchants dans leur main,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pour exécuter la vengeance contre les nations, des châtiments au milieu des peuples","poem":1},{"noteId":462},{"text":";","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pour lier leurs rois de chaînes, et leurs nobles de ceps de fer ;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pour exécuter contre eux le jugement qui est écrit. Cette gloire est pour tous ses saints","poem":1},{"noteId":463},{"text":". Louez Jah !","poem":1},{"noteId":464}]}],"footnotes":[{"noteId":457,"caller":"a","text":"Alléluia !","reference":{"chapter":149,"verse":1}},{"noteId":458,"caller":"b","text":"ailleurs : pieux; voir la note à 2 Chroniques 6. 42.","reference":{"chapter":149,"verse":1}},{"noteId":459,"caller":"b","text":"ailleurs : pieux; voir la note à 2 Chroniques 6. 42.","reference":{"chapter":149,"verse":5}},{"noteId":460,"caller":"c","text":"ou : en.","reference":{"chapter":149,"verse":5}},{"noteId":461,"caller":"d","text":"litt. : gosier.","reference":{"chapter":149,"verse":6}},{"noteId":462,"caller":"e","text":"ailleurs aussi : peuplades.","reference":{"chapter":149,"verse":7}},{"noteId":463,"caller":"b","text":"ailleurs : pieux; voir la note à 2 Chroniques 6. 42.","reference":{"chapter":149,"verse":9}},{"noteId":464,"caller":"a","text":"Alléluia !","reference":{"chapter":149,"verse":9}}]},"thisChapterLink":"/api/fra_jnd/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_jnd/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_jnd/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}