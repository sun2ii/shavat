{"translation":{"id":"fra_jnd","name":"Bible J.N. Darby","website":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseNotes":null,"shortName":"JND","englishName":"French: Bible J.N. Darby","language":"fra","textDirection":"ltr","sha256":"121a3f4841e42965f22ebebcf5a8578a12578ec30eaf1ca7ae4e46d5d85ccb80","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_jnd/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"français","languageEnglishName":"French"},"book":{"id":"PSA","translationId":"fra_jnd","name":"Les Psaumes","commonName":"Les Psaumes","title":"Les Psaumes","order":19,"numberOfChapters":150,"sha256":"4c48a766d24644f7ef347ae1395ef8ddb5d363cc30acf1733162d22f071b120e","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_jnd/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_jnd/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"Psaume de David. Éternel ! qui séjournera dans ta tente ? qui demeurera en ta montagne sainte ?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Celui qui marche dans l’intégrité, et qui fait ce qui est juste, et qui parle la vérité de son cœur ;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Qui ne médit pas de sa langue ; qui ne fait pas de mal à son compagnon, et qui ne fait pas venir l’opprobre sur son prochain ;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aux yeux duquel l’homme vil est méprisable, mais qui honore ceux qui craignent l’Éternel ; qui jure à son détriment, et ne change pas ;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Qui ne donne pas son argent à intérêt","poem":1},{"noteId":35},{"text":", et qui ne prend pas de présent contre l’innocent. Celui qui fait ces choses ne sera jamais ébranlé.","poem":1}]}],"footnotes":[{"noteId":35,"caller":"a","text":"ou : usure.","reference":{"chapter":15,"verse":5}}]},"thisChapterLink":"/api/fra_jnd/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_jnd/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_jnd/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}