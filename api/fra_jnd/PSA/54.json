{"translation":{"id":"fra_jnd","name":"Bible J.N. Darby","website":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseNotes":null,"shortName":"JND","englishName":"French: Bible J.N. Darby","language":"fra","textDirection":"ltr","sha256":"121a3f4841e42965f22ebebcf5a8578a12578ec30eaf1ca7ae4e46d5d85ccb80","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_jnd/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"français","languageEnglishName":"French"},"book":{"id":"PSA","translationId":"fra_jnd","name":"Les Psaumes","commonName":"Les Psaumes","title":"Les Psaumes","order":19,"numberOfChapters":150,"sha256":"4c48a766d24644f7ef347ae1395ef8ddb5d363cc30acf1733162d22f071b120e","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_jnd/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_jnd/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":[{"text":"Au chef de musique. Sur Neguinoth","poem":1},{"noteId":144},{"text":"; pour instruire. De David ;","poem":1}]},{"type":"verse","number":2,"content":[{"text":"lorsque les Ziphiens vinrent, et dirent à Saül : David ne se tient-il pas caché auprès de nous ?","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Ô Dieu ! sauve-moi par ton nom, et fais-moi justice par ta puissance.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ô Dieu ! écoute ma prière, prête l’oreille aux paroles de ma bouche.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Car des étrangers se sont levés contre moi, et des hommes violents cherchent ma vie ; ils n’ont pas mis Dieu devant eux. Sélah.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Voici, Dieu est mon secours ; le Seigneur est entre ceux qui soutiennent mon âme.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Il rendra le mal à ceux qui me pressent : selon ta vérité, détruis-les.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"De franche volonté je t’offrirai des sacrifices ; je célébrerai ton nom, ô Éternel ! car cela est bon","poem":1},{"noteId":145},{"text":".","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Car il m’a délivré de toute détresse, et mon œil a vu [son plaisir] en mes ennemis.","poem":1}]}],"footnotes":[{"noteId":144,"caller":"a","text":"instruments à cordes.","reference":{"chapter":54,"verse":1}},{"noteId":145,"caller":"b","text":"ou : tu es bon.","reference":{"chapter":54,"verse":8}}]},"thisChapterLink":"/api/fra_jnd/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_jnd/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_jnd/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":9}