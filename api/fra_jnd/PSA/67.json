{"translation":{"id":"fra_jnd","name":"Bible J.N. Darby","website":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseNotes":null,"shortName":"JND","englishName":"French: Bible J.N. Darby","language":"fra","textDirection":"ltr","sha256":"121a3f4841e42965f22ebebcf5a8578a12578ec30eaf1ca7ae4e46d5d85ccb80","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_jnd/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"français","languageEnglishName":"French"},"book":{"id":"PSA","translationId":"fra_jnd","name":"Les Psaumes","commonName":"Les Psaumes","title":"Les Psaumes","order":19,"numberOfChapters":150,"sha256":"4c48a766d24644f7ef347ae1395ef8ddb5d363cc30acf1733162d22f071b120e","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_jnd/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_jnd/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":67,"content":[{"type":"verse","number":1,"content":[{"text":"Au chef de musique. Sur Neguinoth","poem":1},{"noteId":183},{"text":". Psaume. Cantique.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Que Dieu use de grâce envers nous et nous bénisse, qu’il fasse lever la lumière de sa face sur","poem":1},{"noteId":184},{"text":"nous, (Sélah)","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pour que ta voie soit connue sur la terre, ton salut parmi toutes les nations.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Que les peuples te célèbrent, ô Dieu ! que tous les peuples te célèbrent !","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Que les peuplades se réjouissent, et chantent de joie ; car tu jugeras les peuples avec droiture, et tu conduiras les peuplades sur","poem":1},{"noteId":185},{"text":"la terre. Sélah.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Que les peuples te célèbrent, ô Dieu ! que tous les peuples te célèbrent !","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"La terre donnera son fruit ; Dieu, notre Dieu, nous bénira.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dieu nous bénira, et tous les bouts de la terre le craindront.","poem":1}]}],"footnotes":[{"noteId":183,"caller":"a","text":"instruments à cordes.","reference":{"chapter":67,"verse":1}},{"noteId":184,"caller":"b","text":"litt. : avec.","reference":{"chapter":67,"verse":2}},{"noteId":185,"caller":"c","text":"ou : qui sont sur.","reference":{"chapter":67,"verse":5}}]},"thisChapterLink":"/api/fra_jnd/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_jnd/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_jnd/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":8}