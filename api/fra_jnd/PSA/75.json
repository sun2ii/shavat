{"translation":{"id":"fra_jnd","name":"Bible J.N. Darby","website":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseNotes":null,"shortName":"JND","englishName":"French: Bible J.N. Darby","language":"fra","textDirection":"ltr","sha256":"121a3f4841e42965f22ebebcf5a8578a12578ec30eaf1ca7ae4e46d5d85ccb80","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_jnd/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"français","languageEnglishName":"French"},"book":{"id":"PSA","translationId":"fra_jnd","name":"Les Psaumes","commonName":"Les Psaumes","title":"Les Psaumes","order":19,"numberOfChapters":150,"sha256":"4c48a766d24644f7ef347ae1395ef8ddb5d363cc30acf1733162d22f071b120e","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_jnd/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_jnd/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":75,"content":[{"type":"verse","number":1,"content":[{"text":"Au chef de musique. Al-Tashkheth","poem":1},{"noteId":222},{"text":". Psaume d’Asaph. Cantique.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Nous te célébrons, ô Dieu ! nous te célébrons, et ton nom est proche : tes merveilles le racontent.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Quand je recevrai l’assemblée, je jugerai avec droiture.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"La terre","poem":1},{"noteId":223},{"text":"et tous ses habitants se sont fondus ; moi, j’affermis ses piliers. Sélah.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"J’ai dit à ceux qui se glorifient : Ne vous glorifiez pas ; et aux méchants : N’élevez pas [votre] corne ;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N’élevez pas en haut votre corne, ne parlez pas avec arrogance, d’un cou [roide].","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Car ce n’est ni du levant, ni du couchant, ni du midi","poem":1},{"noteId":224},{"text":", que vient l’élévation.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Car c’est Dieu qui juge ; il abaisse l’un, et élève l’autre.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Car une coupe est dans la main de l’Éternel, et elle écume de vin","poem":1},{"noteId":225},{"text":"; elle est pleine de mixtion, et il en verse : oui, tous les méchants de la terre en suceront la lie, ils la boiront.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mais moi, je raconterai [ces choses]","poem":1},{"noteId":226},{"text":"à toujours ; je chanterai au Dieu de Jacob.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Et toutes les cornes des méchants, je les abattrai ; [mais] les cornes des justes seront élevées.","poem":1}]}],"footnotes":[{"noteId":222,"caller":"a","text":"ne détruis pas.","reference":{"chapter":75,"verse":1}},{"noteId":223,"caller":"b","text":"ou : Le pays.","reference":{"chapter":75,"verse":4}},{"noteId":224,"caller":"c","text":"ou : du désert; le désert était au midi.","reference":{"chapter":75,"verse":7}},{"noteId":225,"caller":"d","text":"ou : le vin y est rouge.","reference":{"chapter":75,"verse":9}},{"noteId":226,"caller":"e","text":"ou : on raconte [tes merveilles]; voir v. 2.","reference":{"chapter":75,"verse":10}}]},"thisChapterLink":"/api/fra_jnd/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_jnd/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_jnd/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":11}