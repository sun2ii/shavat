{"translation":{"id":"fra_jnd","name":"Bible J.N. Darby","website":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseNotes":null,"shortName":"JND","englishName":"French: Bible J.N. Darby","language":"fra","textDirection":"ltr","sha256":"121a3f4841e42965f22ebebcf5a8578a12578ec30eaf1ca7ae4e46d5d85ccb80","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_jnd/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"français","languageEnglishName":"French"},"book":{"id":"PSA","translationId":"fra_jnd","name":"Les Psaumes","commonName":"Les Psaumes","title":"Les Psaumes","order":19,"numberOfChapters":150,"sha256":"4c48a766d24644f7ef347ae1395ef8ddb5d363cc30acf1733162d22f071b120e","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_jnd/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_jnd/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Au chef de musique. Sur Guitthith","poem":1},{"noteId":17},{"text":". Psaume de David.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Éternel, notre Seigneur ! que ton nom est magnifique par toute la terre ; tu as mis ta majesté au-dessus des cieux !","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Par","poem":1},{"noteId":18},{"text":"la bouche des petits enfants et de ceux qui tètent, tu as fondé [ta] force","poem":1},{"noteId":19},{"text":", à cause de tes adversaires, afin de réduire au silence l’ennemi et le vengeur.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Quand je regarde tes cieux, l’ouvrage de tes doigts, la lune et les étoiles que tu as disposées :","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Qu’est-ce que l’homme","poem":1},{"noteId":20},{"text":", que tu te souviennes de lui, et le fils de l’homme","poem":1},{"noteId":21},{"text":", que tu le visites ?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tu l’as fait de peu inférieur aux anges, et tu l’as couronné de gloire et d’honneur ;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tu l’as fait dominer sur les œuvres de tes mains ; tu as mis toutes choses sous ses pieds :","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Les brebis et les bœufs, tous ensemble, et aussi les bêtes des champs,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"L’oiseau des cieux, et les poissons de la mer, ce qui passe par les sentiers des mers.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Éternel, notre Seigneur ! que ton nom est magnifique par toute la terre !","poem":1}]}],"footnotes":[{"noteId":17,"caller":"a","text":"mot de signification douteuse.","reference":{"chapter":8,"verse":1}},{"noteId":18,"caller":"b","text":"litt. : De.","reference":{"chapter":8,"verse":3}},{"noteId":19,"caller":"c","text":"d’autres : louange.","reference":{"chapter":8,"verse":3}},{"noteId":20,"caller":"d","text":"héb. : énosh ; homme mortel.","reference":{"chapter":8,"verse":5}},{"noteId":21,"caller":"e","text":"héb. : adam.","reference":{"chapter":8,"verse":5}}]},"thisChapterLink":"/api/fra_jnd/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_jnd/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_jnd/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":10}