{"translation":{"id":"fra_jnd","name":"Bible J.N. Darby","website":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseNotes":null,"shortName":"JND","englishName":"French: Bible J.N. Darby","language":"fra","textDirection":"ltr","sha256":"121a3f4841e42965f22ebebcf5a8578a12578ec30eaf1ca7ae4e46d5d85ccb80","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_jnd/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"français","languageEnglishName":"French"},"book":{"id":"PSA","translationId":"fra_jnd","name":"Les Psaumes","commonName":"Les Psaumes","title":"Les Psaumes","order":19,"numberOfChapters":150,"sha256":"4c48a766d24644f7ef347ae1395ef8ddb5d363cc30acf1733162d22f071b120e","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_jnd/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_jnd/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":82,"content":[{"type":"verse","number":1,"content":[{"text":"Psaume d’Asaph. Dieu se tient dans l’assemblée de ✶Dieu ; il juge au milieu des juges","poem":1},{"noteId":252},{"text":".","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Jusques à quand jugerez-vous injustement et ferez-vous acception de la personne des méchants ? Sélah.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Faites droit","poem":1},{"noteId":253},{"text":"au misérable et à l’orphelin, faites justice à l’affligé et au nécessiteux.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Délivrez le misérable et le pauvre, sauvez-le de la main des méchants.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ils ne connaissent ni ne comprennent, ils marchent dans les ténèbres : tous les fondements de la terre chancellent.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Moi j’ai dit : Vous êtes des dieux, et vous êtes tous fils du Très-haut.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mais vous mourrez comme un homme, et vous tomberez comme un des princes.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lève-toi, ô Dieu ! juge la terre ; car tu hériteras toutes les nations.","poem":1}]}],"footnotes":[{"noteId":252,"caller":"a","text":"litt. : dieux.","reference":{"chapter":82,"verse":1}},{"noteId":253,"caller":"b","text":"ailleurs : juger.","reference":{"chapter":82,"verse":3}}]},"thisChapterLink":"/api/fra_jnd/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_jnd/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_jnd/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}