{"translation":{"id":"fra_jnd","name":"Bible J.N. Darby","website":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=frajnd","licenseNotes":null,"shortName":"JND","englishName":"French: Bible J.N. Darby","language":"fra","textDirection":"ltr","sha256":"121a3f4841e42965f22ebebcf5a8578a12578ec30eaf1ca7ae4e46d5d85ccb80","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_jnd/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"français","languageEnglishName":"French"},"book":{"id":"PSA","translationId":"fra_jnd","name":"Les Psaumes","commonName":"Les Psaumes","title":"Les Psaumes","order":19,"numberOfChapters":150,"sha256":"4c48a766d24644f7ef347ae1395ef8ddb5d363cc30acf1733162d22f071b120e","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_jnd/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_jnd/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":87,"content":[{"type":"verse","number":1,"content":[{"text":"Des fils de Coré. Psaume. Cantique. La fondation qu’il a posée","poem":1},{"noteId":265},{"text":"est dans les montagnes de sainteté.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"L’Éternel aime les portes de Sion plus que toutes les demeures de Jacob.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Des choses glorieuses sont dites de toi, cité de Dieu. Sélah.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Je ferai mention de Rahab","poem":1},{"noteId":266},{"text":"et de Babylone à ceux qui me connaissent ; voici la Philistie, et Tyr, avec l’Éthiopie : celui-ci était né là.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Et de Sion il sera dit : Celui-ci et celui-là sont nés en elle ; et le Très-haut, lui, l’établira.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Quand l’Éternel enregistrera les peuples, il comptera : Celui-ci est né là. Sélah.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Et en chantant et en dansant","poem":1},{"noteId":267},{"text":", [ils diront] : Toutes mes sources sont en toi !","poem":1}]}],"footnotes":[{"noteId":265,"caller":"a","text":"litt. : Sa fondation.","reference":{"chapter":87,"verse":1}},{"noteId":266,"caller":"b","text":"c.-à-d. : l’Égypte.","reference":{"chapter":87,"verse":4}},{"noteId":267,"caller":"c","text":"ou : en jouant de la flûte.","reference":{"chapter":87,"verse":7}}]},"thisChapterLink":"/api/fra_jnd/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_jnd/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_jnd/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}