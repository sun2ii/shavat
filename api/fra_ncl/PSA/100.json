{"translation":{"id":"fra_ncl","name":"Sainte Bible néo-Crampon Libre","website":"https://ebible.org/Scriptures/details.php?id=francl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=francl","licenseNotes":null,"shortName":"NCL","englishName":"French néo-Crampon Libre","language":"fra","textDirection":"ltr","sha256":"7b5f459e33bfaffdc725d20cf9c44f806075aa4699ae71fecfe4ad1be221a3de","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_ncl/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31445,"languageName":"français","languageEnglishName":"French","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4106},"book":{"id":"PSA","translationId":"fra_ncl","name":"Psaumes","commonName":"Psaumes","title":"Le livre des Psaumes","order":19,"numberOfChapters":150,"sha256":"9f40c24bd615f767de500e0378f29a9c3f3264f8aa1ead201eece703d03549e7","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_ncl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_ncl/PSA/150.json","totalNumberOfVerses":2528},"chapter":{"number":100,"content":[{"type":"verse","number":1,"content":[{"text":"Psaume de louange.","poem":1},{"lineBreak":true},{"text":"Poussez des cris de joie vers Yahweh, vous, habitants de toute la terre !","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Servez Yahweh avec joie, venez en sa présence avec allégresse !","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Reconnaissez que Yahweh est Dieu. C’est lui qui nous a faits et nous lui appartenons ; nous sommes son peuple et le troupeau de son pâturage.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Venez à ses portiques avec des louanges, à ses parvis avec des cantiques ; célébrez-le, bénissez son nom.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Car Yahweh est bon, sa miséricorde est éternelle, et sa fidélité demeure d’âge en âge.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/fra_ncl/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_ncl/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_ncl/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}