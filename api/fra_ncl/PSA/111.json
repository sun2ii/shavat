{"translation":{"id":"fra_ncl","name":"Sainte Bible néo-Crampon Libre","website":"https://ebible.org/Scriptures/details.php?id=francl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=francl","licenseNotes":null,"shortName":"NCL","englishName":"French néo-Crampon Libre","language":"fra","textDirection":"ltr","sha256":"7b5f459e33bfaffdc725d20cf9c44f806075aa4699ae71fecfe4ad1be221a3de","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_ncl/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31445,"languageName":"français","languageEnglishName":"French","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4106},"book":{"id":"PSA","translationId":"fra_ncl","name":"Psaumes","commonName":"Psaumes","title":"Le livre des Psaumes","order":19,"numberOfChapters":150,"sha256":"9f40c24bd615f767de500e0378f29a9c3f3264f8aa1ead201eece703d03549e7","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_ncl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_ncl/PSA/150.json","totalNumberOfVerses":2528},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"Alleluia !","poem":1},"ALEPH.",{"text":"Je veux louer Yahweh de tout mon cœur,","poem":1},"BETH.",{"text":"dans la réunion des justes et dans l’assemblée.","poem":1},"GHIMEL."]},{"type":"verse","number":2,"content":[{"text":"Grandes sont les œuvres de Yahweh,","poem":1},"DALETH.",{"text":"recherchées pour toutes les délices qu’elles procurent.","poem":1},"HÉ."]},{"type":"verse","number":3,"content":[{"text":"Son œuvre n’est que splendeur et magnificence,","poem":1},"VAV.",{"text":"et sa justice subsiste à jamais.","poem":1},"ZAÏN."]},{"type":"verse","number":4,"content":[{"text":"il a laissé un souvenir de ses merveilles ;","poem":1},"HETH.",{"text":"Yahweh est miséricordieux et compatissant.","poem":1},"TETH."]},{"type":"verse","number":5,"content":[{"text":"Il a donné une nourriture à ceux qui le craignent ;","poem":1},"YOD.",{"text":"il se souvient pour toujours de son alliance.","poem":1},"CAPH."]},{"type":"verse","number":6,"content":[{"text":"Il a manifesté à son peuple la puissance de ses œuvres,","poem":1},"LAMED.",{"text":"en lui livrant l’héritage des nations.","poem":1},"MEM."]},{"type":"verse","number":7,"content":[{"text":"Les œuvres de ses mains sont vérité et justice,","poem":1},"NUN.",{"text":"tous ses commandements sont immuables,","poem":1},"SAMECH."]},{"type":"verse","number":8,"content":[{"text":"affermis pour l’éternité, AÏN. faits selon la vérité et la droiture.","poem":1},"PHÉ."]},{"type":"verse","number":9,"content":[{"text":"Il a envoyé la délivrance à son peuple,","poem":1},"TSADÉ.",{"text":"il a établi pour toujours son alliance ;","poem":1},"QOPH.",{"text":"son nom est saint et redoutable.","poem":1},"RESCH."]},{"type":"verse","number":10,"content":[{"text":"La crainte de Yahweh est le commencement de la sagesse ;","poem":1},"SCHIN.",{"text":"ceux-là sont vraiment intelligents, qui observent sa loi.","poem":1},"THAV.",{"text":"Sa louange demeure à jamais.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/fra_ncl/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_ncl/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_ncl/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}