{"translation":{"id":"fra_ncl","name":"Sainte Bible néo-Crampon Libre","website":"https://ebible.org/Scriptures/details.php?id=francl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=francl","licenseNotes":null,"shortName":"NCL","englishName":"French néo-Crampon Libre","language":"fra","textDirection":"ltr","sha256":"7b5f459e33bfaffdc725d20cf9c44f806075aa4699ae71fecfe4ad1be221a3de","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_ncl/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31445,"languageName":"français","languageEnglishName":"French","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4106},"book":{"id":"PSA","translationId":"fra_ncl","name":"Psaumes","commonName":"Psaumes","title":"Le livre des Psaumes","order":19,"numberOfChapters":150,"sha256":"9f40c24bd615f767de500e0378f29a9c3f3264f8aa1ead201eece703d03549e7","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_ncl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_ncl/PSA/150.json","totalNumberOfVerses":2528},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"Alleluia !","poem":1},"ALEPH.",{"text":"Heureux l’homme qui craint Yahweh,","poem":1},"BETH.",{"text":"qui met toute sa joie à observer ses préceptes !","poem":1},"GHIMEL."]},{"type":"verse","number":2,"content":[{"text":"Sa postérité sera puissante sur la terre,","poem":1},"DALETH.",{"text":"la race des justes sera bénie.","poem":1},"HÉ."]},{"type":"verse","number":3,"content":[{"text":"Il a dans sa maison bien-être et richesse,","poem":1},"VAV.",{"text":"et sa justice subsiste à jamais.","poem":1},"ZAÏN."]},{"type":"verse","number":4,"content":[{"text":"La lumière se lève dans les ténèbres pour les hommes droits,","poem":1},"HETH.",{"text":"pour celui qui est miséricordieux, compatissant et juste.","poem":1},"TETH."]},{"type":"verse","number":5,"content":[{"text":"Heureux l’homme qui exerce la miséricorde et qui prête :","poem":1},"YOD.",{"text":"en justice il fait prévaloir sa cause.","poem":1},"CAPH."]},{"type":"verse","number":6,"content":[{"text":"Car il ne sera jamais ébranlé ;","poem":1},"LAMED.",{"text":"le juste laissera une mémoire éternelle.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Il ne craint pas les funestes nouvelles ;","poem":1},"NUN.",{"text":"son cœur est ferme, confiant en Yahweh.","poem":1},"SAMECH."]},{"type":"verse","number":8,"content":[{"text":"Son cœur est inébranlable, il ne craint pas,","poem":1},"AÏN.",{"text":"jusqu’à ce qu’il voie ses ennemis abattus.","poem":1},"PHÉ."]},{"type":"verse","number":9,"content":[{"text":"Il sème l’aumône, il donne à l’indigent ;","poem":1},"TSADÉ.",{"text":"sa justice subsiste à jamais,","poem":1},"QOPH.",{"text":"sa corne s’élève avec gloire.","poem":1},"RESCH."]},{"type":"verse","number":10,"content":[{"text":"Le méchant le voit et s’irrite,","poem":1},"SCHIN.",{"text":"il grince des dents et l’envie le consume :","poem":1},"THAV.",{"text":"le désir des méchants périra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/fra_ncl/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_ncl/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_ncl/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}