{"translation":{"id":"fra_ncl","name":"Sainte Bible néo-Crampon Libre","website":"https://ebible.org/Scriptures/details.php?id=francl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=francl","licenseNotes":null,"shortName":"NCL","englishName":"French néo-Crampon Libre","language":"fra","textDirection":"ltr","sha256":"7b5f459e33bfaffdc725d20cf9c44f806075aa4699ae71fecfe4ad1be221a3de","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_ncl/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31445,"languageName":"français","languageEnglishName":"French","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4106},"book":{"id":"PSA","translationId":"fra_ncl","name":"Psaumes","commonName":"Psaumes","title":"Le livre des Psaumes","order":19,"numberOfChapters":150,"sha256":"9f40c24bd615f767de500e0378f29a9c3f3264f8aa1ead201eece703d03549e7","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_ncl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_ncl/PSA/150.json","totalNumberOfVerses":2528},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Alleluia !","poem":1},{"lineBreak":true},{"text":"Louez, serviteurs de Yahweh, louez le nom de Yahweh,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Que le nom de Yahweh soit béni, dès maintenant et à jamais !","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Du lever du soleil jusqu’à son couchant, loué soit le nom de Yahweh !","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yahweh est élevé au-dessus de toutes les nations, sa gloire est au-dessus des cieux.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Qui est semblable à Yahweh, notre Dieu ? Il siège dans les hauteurs,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"et il regarde en bas, dans les cieux et sur la terre.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Il relève le malheureux de la poussière, il retire le pauvre du fumier,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"pour les faire asseoir avec les princes, avec les princes de son peuple.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Il donne une demeure à la stérile de la maison, il en fait une mère joyeuse au milieu de ses enfants. Alleluia !","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/fra_ncl/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_ncl/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_ncl/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}