devant la face du Seigneur, devant la face du Dieu de Jacob,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"qui change le rocher en étang, le roc en source d’eaux.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/fra_ncl/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_ncl/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_ncl/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}