{"translation":{"id":"fra_ncl","name":"Sainte Bible néo-Crampon Libre","website":"https://ebible.org/Scriptures/details.php?id=francl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=francl","licenseNotes":null,"shortName":"NCL","englishName":"French néo-Crampon Libre","language":"fra","textDirection":"ltr","sha256":"7b5f459e33bfaffdc725d20cf9c44f806075aa4699ae71fecfe4ad1be221a3de","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_ncl/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31445,"languageName":"français","languageEnglishName":"French","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4106},"book":{"id":"PSA","translationId":"fra_ncl","name":"Psaumes","commonName":"Psaumes","title":"Le livre des Psaumes","order":19,"numberOfChapters":150,"sha256":"9f40c24bd615f767de500e0378f29a9c3f3264f8aa1ead201eece703d03549e7","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_ncl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_ncl/PSA/150.json","totalNumberOfVerses":2528},"chapter":{"number":120,"content":[{"type":"verse","number":1,"content":[{"text":"Cantique des montées.","descriptive":true},{"text":"Vers Yahweh, dans ma détresse, j’ai crié, et il m’a exaucé :","poem":1}]},{"type":"verse","number":2,"content":[{"text":"« Yahweh délivre mon âme de la lèvre de mensonge, de la langue astucieuse ! »","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Que te sera-t-il donné, quel sera ton profit, langue perfide ?","poem":1}]},{"type":"verse","number":4,"content":[{"text":"Les flèches aiguës du Tout-Puissant, avec les charbons ardents du genêt.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Malheureux que je suis de séjourner dans Mések, d’habiter sous les tentes de Cédar !","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Trop longtemps j’ai demeuré avec ceux qui haïssent la paix.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Je suis un homme de paix et, quand je leur parle, ils sont pour la guerre.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/fra_ncl/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_ncl/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_ncl/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}