{"translation":{"id":"fra_ncl","name":"Sainte Bible néo-Crampon Libre","website":"https://ebible.org/Scriptures/details.php?id=francl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=francl","licenseNotes":null,"shortName":"NCL","englishName":"French néo-Crampon Libre","language":"fra","textDirection":"ltr","sha256":"7b5f459e33bfaffdc725d20cf9c44f806075aa4699ae71fecfe4ad1be221a3de","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_ncl/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31445,"languageName":"français","languageEnglishName":"French","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4106},"book":{"id":"PSA","translationId":"fra_ncl","name":"Psaumes","commonName":"Psaumes","title":"Le livre des Psaumes","order":19,"numberOfChapters":150,"sha256":"9f40c24bd615f767de500e0378f29a9c3f3264f8aa1ead201eece703d03549e7","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_ncl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_ncl/PSA/150.json","totalNumberOfVerses":2528},"chapter":{"number":121,"content":[{"type":"verse","number":1,"content":[{"text":"Cantique pour les montées.","descriptive":true},{"text":"Je lève les yeux vers les montagnes : d’où me viendra le secours ?","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Mon secours viendra de Yahweh, qui a fait le ciel et la terre.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Il ne permettra pas que ton pied trébuche ; celui qui te garde ne sommeillera pas.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"Non, il ne sommeille ni ne dort, celui qui garde Israël.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yahweh est ton gardien ; Yahweh est ton abri, toujours à ta droite.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Pendant le jour le soleil ne te frappera point, ni la lune pendant la nuit.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yahweh te gardera de tout mal, il gardera ton âme :","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Yahweh gardera ton départ et ton arrivée maintenant et à jamais.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/fra_ncl/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_ncl/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_ncl/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}