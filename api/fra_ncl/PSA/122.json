{"translation":{"id":"fra_ncl","name":"Sainte Bible néo-Crampon Libre","website":"https://ebible.org/Scriptures/details.php?id=francl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=francl","licenseNotes":null,"shortName":"NCL","englishName":"French néo-Crampon Libre","language":"fra","textDirection":"ltr","sha256":"7b5f459e33bfaffdc725d20cf9c44f806075aa4699ae71fecfe4ad1be221a3de","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_ncl/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31445,"languageName":"français","languageEnglishName":"French","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4106},"book":{"id":"PSA","translationId":"fra_ncl","name":"Psaumes","commonName":"Psaumes","title":"Le livre des Psaumes","order":19,"numberOfChapters":150,"sha256":"9f40c24bd615f767de500e0378f29a9c3f3264f8aa1ead201eece703d03549e7","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_ncl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_ncl/PSA/150.json","totalNumberOfVerses":2528},"chapter":{"number":122,"content":[{"type":"verse","number":1,"content":[{"text":"Cantique des montées. De David.","descriptive":true},{"text":"J’ai été dans la joie quand on m’a dit : « Allons à la maison de Yahweh ! »","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Enfin ! Nos pieds s’arrêtent à tes portes, Jérusalem !","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jérusalem, tu es bâtie comme une ville où tout se tient ensemble.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"Là montent les tribus, les tribus de Yahweh, selon la loi d’Israël, pour louer le nom de Yahweh.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Là sont établis des sièges pour le jugement, les sièges de la maison de David.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Faites des vœux pour Jérusalem : Qu’ils soient heureux ceux qui t’aiment !","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Que la paix règne dans tes murs, la prospérité dans tes palais !","poem":2}]},{"type":"verse","number":8,"content":[{"text":"A cause de mes frères et de mes amis, je demande pour toi la paix ;","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"à cause de la maison de Yahweh, notre Dieu, je désire pour toi le bonheur.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/fra_ncl/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_ncl/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_ncl/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}