{"translation":{"id":"fra_ncl","name":"Sainte Bible néo-Crampon Libre","website":"https://ebible.org/Scriptures/details.php?id=francl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=francl","licenseNotes":null,"shortName":"NCL","englishName":"French néo-Crampon Libre","language":"fra","textDirection":"ltr","sha256":"7b5f459e33bfaffdc725d20cf9c44f806075aa4699ae71fecfe4ad1be221a3de","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_ncl/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31445,"languageName":"français","languageEnglishName":"French","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4106},"book":{"id":"PSA","translationId":"fra_ncl","name":"Psaumes","commonName":"Psaumes","title":"Le livre des Psaumes","order":19,"numberOfChapters":150,"sha256":"9f40c24bd615f767de500e0378f29a9c3f3264f8aa1ead201eece703d03549e7","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_ncl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_ncl/PSA/150.json","totalNumberOfVerses":2528},"chapter":{"number":124,"content":[{"type":"verse","number":1,"content":[{"text":"Cantique des montées. De David.","descriptive":true},{"text":"Si Yahweh n’eût été pour nous, — qu’Israël le proclame, —","poem":1}]},{"type":"verse","number":2,"content":[{"text":"si Yahweh n’eût été pour nous, quand les hommes se sont élevés contre nous !...","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ils nous auraient dévorés tout vivants, quand leur colère s’est allumée contre nous ;","poem":1}]},{"type":"verse","number":4,"content":[{"text":"les eaux nous auraient engloutis, le torrent eût passé sur notre âme ;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"sur notre âme auraient passé les eaux impétueuses.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Béni soit Yahweh, qui ne nous a pas livrés à leurs dents !","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Notre âme, comme le passereau, s’est échappée du filet de l’oiseleur ; le filet s’est rompu, et nous avons été délivrés.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Notre secours est dans le nom de Yahweh, qui a fait les cieux et la terre.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/fra_ncl/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_ncl/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_ncl/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}