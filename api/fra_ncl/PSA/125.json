{"translation":{"id":"fra_ncl","name":"Sainte Bible néo-Crampon Libre","website":"https://ebible.org/Scriptures/details.php?id=francl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=francl","licenseNotes":null,"shortName":"NCL","englishName":"French néo-Crampon Libre","language":"fra","textDirection":"ltr","sha256":"7b5f459e33bfaffdc725d20cf9c44f806075aa4699ae71fecfe4ad1be221a3de","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_ncl/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31445,"languageName":"français","languageEnglishName":"French","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4106},"book":{"id":"PSA","translationId":"fra_ncl","name":"Psaumes","commonName":"Psaumes","title":"Le livre des Psaumes","order":19,"numberOfChapters":150,"sha256":"9f40c24bd615f767de500e0378f29a9c3f3264f8aa1ead201eece703d03549e7","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_ncl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_ncl/PSA/150.json","totalNumberOfVerses":2528},"chapter":{"number":125,"content":[{"type":"verse","number":1,"content":[{"text":"Cantique des montées.","descriptive":true},{"text":"Ceux qui se confient en Yahweh sont comme la montagne de Sion : elle ne chancelle point, elle est établie pour toujours.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Jérusalem a autour d’elle une ceinture de montagnes : ainsi Yahweh entoure son peuple, dès maintenant et à jamais.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Le sceptre des méchants ne restera pas sur l’héritage des justes, afin que les justes ne portent pas aussi leurs mains vers l’iniquité.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yahweh, répands tes bontés sur les bons, et sur ceux qui ont le cœur droit.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Mais sur ceux qui se détournent en des voies tortueuses, que Yahweh les abandonne avec ceux qui font le mal ! Paix sur Israël !","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/fra_ncl/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_ncl/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_ncl/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}