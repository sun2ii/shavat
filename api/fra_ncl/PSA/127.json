{"translation":{"id":"fra_ncl","name":"Sainte Bible néo-Crampon Libre","website":"https://ebible.org/Scriptures/details.php?id=francl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=francl","licenseNotes":null,"shortName":"NCL","englishName":"French néo-Crampon Libre","language":"fra","textDirection":"ltr","sha256":"7b5f459e33bfaffdc725d20cf9c44f806075aa4699ae71fecfe4ad1be221a3de","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_ncl/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31445,"languageName":"français","languageEnglishName":"French","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4106},"book":{"id":"PSA","translationId":"fra_ncl","name":"Psaumes","commonName":"Psaumes","title":"Le livre des Psaumes","order":19,"numberOfChapters":150,"sha256":"9f40c24bd615f767de500e0378f29a9c3f3264f8aa1ead201eece703d03549e7","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_ncl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_ncl/PSA/150.json","totalNumberOfVerses":2528},"chapter":{"number":127,"content":[{"type":"verse","number":1,"content":[{"text":"Cantique des montées. De Salomon.","descriptive":true},{"text":"Si Yahweh ne bâtit pas la maison, en vain travaillent ceux qui la bâtissent ; si Yahweh ne garde pas la cité, en vain la sentinelle veille à ses portes.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"C’est en vain que vous vous levez avant le jour, et que vous retardez votre repos, mangeant le pain de la douleur : il en donne autant à son bien-aimé pendant son sommeil.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Voici, c’est un héritage de Yahweh, que les enfants ; une récompense, que les fruits d’un sein fécond.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"Comme les flèches dans la main d’un guerrier, ainsi sont les fils de la jeunesse.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Heureux l’homme qui en a rempli son carquois ! Ils ne rougiront pas quand ils répondront aux ennemis, à la porte de la ville.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/fra_ncl/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_ncl/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_ncl/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}