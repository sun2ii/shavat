{"translation":{"id":"fra_ncl","name":"Sainte Bible néo-Crampon Libre","website":"https://ebible.org/Scriptures/details.php?id=francl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=francl","licenseNotes":null,"shortName":"NCL","englishName":"French néo-Crampon Libre","language":"fra","textDirection":"ltr","sha256":"7b5f459e33bfaffdc725d20cf9c44f806075aa4699ae71fecfe4ad1be221a3de","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_ncl/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31445,"languageName":"français","languageEnglishName":"French","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4106},"book":{"id":"PSA","translationId":"fra_ncl","name":"Psaumes","commonName":"Psaumes","title":"Le livre des Psaumes","order":19,"numberOfChapters":150,"sha256":"9f40c24bd615f767de500e0378f29a9c3f3264f8aa1ead201eece703d03549e7","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_ncl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_ncl/PSA/150.json","totalNumberOfVerses":2528},"chapter":{"number":128,"content":[{"type":"verse","number":1,"content":[{"text":"Cantique des montées.","descriptive":true},{"text":"Heureux l’homme qui craint Yahweh, qui marche dans ses voies !","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Tu te nourris alors du travail de tes mains ; tu es heureux et comblé de biens.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ton épouse est comme une vigne féconde, dans l’intérieur de ta maison ; tes fils, comme de jeunes plants d’olivier, autour de ta table.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Voilà comment sera béni l’homme qui craint Yahweh.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Que Yahweh te bénisse de Sion !","poem":2},{"text":"Puisse-tu voir Jérusalem florissante tous les jours de ta vie !","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Puisses-tu voir les enfants de tes enfants ! Que la paix soit sur Israël !","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/fra_ncl/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_ncl/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_ncl/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}