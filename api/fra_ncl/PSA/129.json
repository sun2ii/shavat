{"translation":{"id":"fra_ncl","name":"Sainte Bible néo-Crampon Libre","website":"https://ebible.org/Scriptures/details.php?id=francl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=francl","licenseNotes":null,"shortName":"NCL","englishName":"French néo-Crampon Libre","language":"fra","textDirection":"ltr","sha256":"7b5f459e33bfaffdc725d20cf9c44f806075aa4699ae71fecfe4ad1be221a3de","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_ncl/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31445,"languageName":"français","languageEnglishName":"French","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4106},"book":{"id":"PSA","translationId":"fra_ncl","name":"Psaumes","commonName":"Psaumes","title":"Le livre des Psaumes","order":19,"numberOfChapters":150,"sha256":"9f40c24bd615f767de500e0378f29a9c3f3264f8aa1ead201eece703d03549e7","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_ncl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_ncl/PSA/150.json","totalNumberOfVerses":2528},"chapter":{"number":129,"content":[{"type":"verse","number":1,"content":[{"text":"Cantique des montées.","descriptive":true},{"text":"Ils m’ont cruellement opprimé dès ma jeunesse, — qu’Israël le dise ! —","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Ils m’ont cruellement opprimé dès ma jeunesse, mais ils n’ont pas prévalu contre moi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ils ont labouré mon dos, ils y ont tracé de longs sillons.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"Mais Yahweh est juste : il a coupé les liens des méchants.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Qu’ils soient confondus et qu’ils reculent en arrière, tous ceux qui haïssent Sion !","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Qu’ils soient comme l’herbe des toits, qui sèche avant qu’on l’arrache.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Le moissonneur n’en remplit pas sa main, ni celui qui lie les gerbes, son giron ;","poem":1}]},{"type":"verse","number":8,"content":[{"text":"et les passants ne disent pas : « Que la bénédiction de Yahweh soit sur vous ! » — « Nous vous bénissons au nom de Yahweh. »","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/fra_ncl/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_ncl/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_ncl/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}