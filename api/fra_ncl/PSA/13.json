{"translation":{"id":"fra_ncl","name":"Sainte Bible néo-Crampon Libre","website":"https://ebible.org/Scriptures/details.php?id=francl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=francl","licenseNotes":null,"shortName":"NCL","englishName":"French néo-Crampon Libre","language":"fra","textDirection":"ltr","sha256":"7b5f459e33bfaffdc725d20cf9c44f806075aa4699ae71fecfe4ad1be221a3de","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_ncl/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31445,"languageName":"français","languageEnglishName":"French","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4106},"book":{"id":"PSA","translationId":"fra_ncl","name":"Psaumes","commonName":"Psaumes","title":"Le livre des Psaumes","order":19,"numberOfChapters":150,"sha256":"9f40c24bd615f767de500e0378f29a9c3f3264f8aa1ead201eece703d03549e7","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_ncl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_ncl/PSA/150.json","totalNumberOfVerses":2528},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"Au maître de chant. Chant de David.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Jusques à quand, Yahweh, m’oublieras-tu toujours ? Jusques à quand me cacheras-tu ta face ?","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Jusques à quand formerai-je en mon âme des projets, et chaque jour le chagrin remplira-t-il mon cœur ? Jusques à quand mon ennemi s’élèvera-t-il contre moi ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Regarde, réponds-moi, Yahweh, mon Dieu ! Donne la lumière à mes yeux, afin que je ne m’endorme pas dans la mort,","poem":1}]},{"type":"verse","number":5,"content":[{"text":"afin que mon ennemi ne dise pas : « Je l’ai vaincu ! » et que mes adversaires ne se réjouissent pas en me voyant chanceler.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Moi, j’ai confiance en ta bonté ; mon cœur tressaillira à cause de ton salut, je chanterai Yahweh pour le bien qu’il m’a fait.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/fra_ncl/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_ncl/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_ncl/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}