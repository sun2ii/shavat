{"translation":{"id":"fra_ncl","name":"Sainte Bible néo-Crampon Libre","website":"https://ebible.org/Scriptures/details.php?id=francl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=francl","licenseNotes":null,"shortName":"NCL","englishName":"French néo-Crampon Libre","language":"fra","textDirection":"ltr","sha256":"7b5f459e33bfaffdc725d20cf9c44f806075aa4699ae71fecfe4ad1be221a3de","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_ncl/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31445,"languageName":"français","languageEnglishName":"French","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4106},"book":{"id":"PSA","translationId":"fra_ncl","name":"Psaumes","commonName":"Psaumes","title":"Le livre des Psaumes","order":19,"numberOfChapters":150,"sha256":"9f40c24bd615f767de500e0378f29a9c3f3264f8aa1ead201eece703d03549e7","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_ncl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_ncl/PSA/150.json","totalNumberOfVerses":2528},"chapter":{"number":130,"content":[{"type":"verse","number":1,"content":[{"text":"Cantique des montées.","descriptive":true},{"text":"Du fond de l’abîme je crie vers toi, Yahweh.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Seigneur, écoute ma voix ; que tes oreilles soient attentives aux accents de ma prière !","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Si tu gardes le souvenir de l’iniquité, Yahweh, Seigneur, qui pourra subsister ?","poem":1}]},{"type":"verse","number":4,"content":[{"text":"Mais auprès de toi est le pardon, afin qu’on te révère.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"J’espère en Yahweh ; mon âme espère, et j’attends sa parole.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Mon âme aspire après le Seigneur plus que les guetteurs n’aspirent après l’aurore.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Israël, mets ton espoir en Yahweh ! Car avec Yahweh est la miséricorde, avec lui une surabondante délivrance.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"C’est lui qui rachètera Israël de toutes ses iniquités.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/fra_ncl/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_ncl/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_ncl/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}