{"translation":{"id":"fra_ncl","name":"Sainte Bible néo-Crampon Libre","website":"https://ebible.org/Scriptures/details.php?id=francl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=francl","licenseNotes":null,"shortName":"NCL","englishName":"French néo-Crampon Libre","language":"fra","textDirection":"ltr","sha256":"7b5f459e33bfaffdc725d20cf9c44f806075aa4699ae71fecfe4ad1be221a3de","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_ncl/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31445,"languageName":"français","languageEnglishName":"French","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4106},"book":{"id":"PSA","translationId":"fra_ncl","name":"Psaumes","commonName":"Psaumes","title":"Le livre des Psaumes","order":19,"numberOfChapters":150,"sha256":"9f40c24bd615f767de500e0378f29a9c3f3264f8aa1ead201eece703d03549e7","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_ncl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_ncl/PSA/150.json","totalNumberOfVerses":2528},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"Alleluia !","poem":1},{"lineBreak":true},{"text":"Chantez à Yahweh un cantique nouveau ; que sa louange retentisse dans l’assemblée des saints !","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Qu’Israël se réjouisse en son Créateur, que les fils de Sion tressaillent en leur Roi !","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Qu’ils louent son nom dans leurs danses, qu’ils le chantent avec le tambourin et la harpe !","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Car Yahweh se complaît dans son peuple, il glorifie les humbles en les sauvant.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Les fidèles triomphent dans la gloire, ils tressaillent de joie sur leur couche.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Les louanges de Dieu sont dans leur bouche, et ils ont dans leurs mains un glaive à deux tranchants.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Pour exercer la vengeance sur les nations, et porter le châtiment chez les peuples ;","poem":1}]},{"type":"verse","number":8,"content":[{"text":"pour lier leurs rois avec des chaînes, et leurs grands avec des ceps de fer ;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"pour exécuter contre eux l’arrêt écrit : c’est là la gloire réservée à tous ses fidèles. Alleluia !","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/fra_ncl/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_ncl/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_ncl/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}