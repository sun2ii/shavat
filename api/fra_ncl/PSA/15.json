{"translation":{"id":"fra_ncl","name":"Sainte Bible néo-Crampon Libre","website":"https://ebible.org/Scriptures/details.php?id=francl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=francl","licenseNotes":null,"shortName":"NCL","englishName":"French néo-Crampon Libre","language":"fra","textDirection":"ltr","sha256":"7b5f459e33bfaffdc725d20cf9c44f806075aa4699ae71fecfe4ad1be221a3de","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_ncl/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31445,"languageName":"français","languageEnglishName":"French","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4106},"book":{"id":"PSA","translationId":"fra_ncl","name":"Psaumes","commonName":"Psaumes","title":"Le livre des Psaumes","order":19,"numberOfChapters":150,"sha256":"9f40c24bd615f767de500e0378f29a9c3f3264f8aa1ead201eece703d03549e7","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_ncl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_ncl/PSA/150.json","totalNumberOfVerses":2528},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"Psaume de David.","poem":1},{"lineBreak":true},{"text":"Yahweh, qui habitera dans ta tente ? Qui demeurera sur ta montagne sainte ?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Celui qui marche dans l’innocence, qui pratique la justice, et qui dit la vérité dans son cœur.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Il ne calomnie pas avec sa langue, il ne fait pas de mal à son frère, et ne jette pas l’opprobre sur son prochain.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"A ses yeux le réprouvé est digne de honte, mais il honore ceux qui craignent Yahweh. S’il a fait un serment à son préjudice, il n’y change rien,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Il ne prête pas son argent à usure, et il n’accepte pas de présent contre l’innocent :","poem":2},{"text":"Celui qui se conduit ainsi ne chancellera jamais.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/fra_ncl/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_ncl/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_ncl/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}