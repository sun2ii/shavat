{"translation":{"id":"fra_ncl","name":"Sainte Bible néo-Crampon Libre","website":"https://ebible.org/Scriptures/details.php?id=francl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=francl","licenseNotes":null,"shortName":"NCL","englishName":"French néo-Crampon Libre","language":"fra","textDirection":"ltr","sha256":"7b5f459e33bfaffdc725d20cf9c44f806075aa4699ae71fecfe4ad1be221a3de","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_ncl/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31445,"languageName":"français","languageEnglishName":"French","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4106},"book":{"id":"PSA","translationId":"fra_ncl","name":"Psaumes","commonName":"Psaumes","title":"Le livre des Psaumes","order":19,"numberOfChapters":150,"sha256":"9f40c24bd615f767de500e0378f29a9c3f3264f8aa1ead201eece703d03549e7","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_ncl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_ncl/PSA/150.json","totalNumberOfVerses":2528},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"Psaume de David.","poem":1},{"lineBreak":true},{"text":"Yahweh est mon pasteur ; je ne manquerai de rien.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Il me fait reposer dans de verts pâturages, il me mène près des eaux rafraîchissantes ;","poem":1}]},{"type":"verse","number":3,"content":[{"text":"il restaure mon âme.","poem":2},{"text":"Il me conduit dans les droits sentiers, à cause de son nom.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"Même quand je marche dans une vallée d’ombre mortelle, je ne crains aucun mal, car tu es avec moi : ta houlette et ton bâton me rassurent.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tu dresses devant moi une table en face de mes ennemis ; tu répands l’huile sur ma tête ; ma coupe est débordante.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Oui, le bonheur et la grâce m’accompagneront, tous les jours de ma vie, et j’habiterai dans la maison de Yahweh, pour de longs jours.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/fra_ncl/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_ncl/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_ncl/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}