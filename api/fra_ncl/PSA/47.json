{"translation":{"id":"fra_ncl","name":"Sainte Bible néo-Crampon Libre","website":"https://ebible.org/Scriptures/details.php?id=francl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=francl","licenseNotes":null,"shortName":"NCL","englishName":"French néo-Crampon Libre","language":"fra","textDirection":"ltr","sha256":"7b5f459e33bfaffdc725d20cf9c44f806075aa4699ae71fecfe4ad1be221a3de","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_ncl/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31445,"languageName":"français","languageEnglishName":"French","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4106},"book":{"id":"PSA","translationId":"fra_ncl","name":"Psaumes","commonName":"Psaumes","title":"Le livre des Psaumes","order":19,"numberOfChapters":150,"sha256":"9f40c24bd615f767de500e0378f29a9c3f3264f8aa1ead201eece703d03549e7","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_ncl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_ncl/PSA/150.json","totalNumberOfVerses":2528},"chapter":{"number":47,"content":[{"type":"verse","number":1,"content":[{"text":"Au maître de chant. Des fils de Coré. Psaume.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Vous tous, peuples, battez des mains, célébrez Dieu par des cris d’allégresse !","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Car Yahweh est très haut, redoutable, grand roi sur toute la terre.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Il nous assujettit les peuples, il met les nations sous nos pieds.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Il nous choisit notre héritage, la gloire de Jacob, son bien-aimé. — Séla.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dieu monte à son sanctuaire au milieu des acclamations ; Yahweh, au son de la trompette.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Chantez à Dieu, chantez ! chantez à notre Roi, chantez !","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Car Dieu est roi de toute la terre ; chantez un cantique de louange.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Dieu règne sur les nations, il siège sur son trône saint.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Les princes des peuples se réunissent pour former aussi un peuple du Dieu d’Abraham ; car à Dieu sont les boucliers de la terre ; Il est souverainement élevé.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/fra_ncl/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_ncl/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_ncl/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":10}