{"translation":{"id":"fra_ncl","name":"Sainte Bible néo-Crampon Libre","website":"https://ebible.org/Scriptures/details.php?id=francl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=francl","licenseNotes":null,"shortName":"NCL","englishName":"French néo-Crampon Libre","language":"fra","textDirection":"ltr","sha256":"7b5f459e33bfaffdc725d20cf9c44f806075aa4699ae71fecfe4ad1be221a3de","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_ncl/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31445,"languageName":"français","languageEnglishName":"French","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4106},"book":{"id":"PSA","translationId":"fra_ncl","name":"Psaumes","commonName":"Psaumes","title":"Le livre des Psaumes","order":19,"numberOfChapters":150,"sha256":"9f40c24bd615f767de500e0378f29a9c3f3264f8aa1ead201eece703d03549e7","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_ncl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_ncl/PSA/150.json","totalNumberOfVerses":2528},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":[{"text":"Au maître de chant. Avec instruments à cordes. Cantique de David.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Lorsque les Ziphéens vinrent dire à Saül : David est caché parmi nous.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O Dieu, sauve-moi par ton nom, et rends-moi justice par ta puissance.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"O Dieu, écoute ma prière, prête l’oreille aux paroles de ma bouche.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Car des étrangers se sont levés contre moi, des hommes violents en veulent à ma vie ; ils ne mettent pas Dieu devant leurs yeux. — Séla.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Voici que Dieu est mon secours, le Seigneur est le soutien de mon âme.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Il fera retomber le mal sur mes adversaires ; dans ta vérité, anéantis-les !","poem":2}]},{"type":"verse","number":8,"content":[{"text":"De tout cœur je t’offrirai des sacrifices ; je louerai ton nom, Yahweh, car il est bon ;","poem":1}]},{"type":"verse","number":9,"content":[{"text":"il me délivre de toute angoisse, et mes yeux s’arrêtent avec joie sur mes ennemis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/fra_ncl/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_ncl/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_ncl/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":9}