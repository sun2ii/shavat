{"translation":{"id":"fra_ncl","name":"Sainte Bible néo-Crampon Libre","website":"https://ebible.org/Scriptures/details.php?id=francl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=francl","licenseNotes":null,"shortName":"NCL","englishName":"French néo-Crampon Libre","language":"fra","textDirection":"ltr","sha256":"7b5f459e33bfaffdc725d20cf9c44f806075aa4699ae71fecfe4ad1be221a3de","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_ncl/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31445,"languageName":"français","languageEnglishName":"French","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4106},"book":{"id":"PSA","translationId":"fra_ncl","name":"Psaumes","commonName":"Psaumes","title":"Le livre des Psaumes","order":19,"numberOfChapters":150,"sha256":"9f40c24bd615f767de500e0378f29a9c3f3264f8aa1ead201eece703d03549e7","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_ncl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_ncl/PSA/150.json","totalNumberOfVerses":2528},"chapter":{"number":67,"content":[{"type":"verse","number":1,"content":[{"text":"Au maître de chant. Avec instruments à cordes. Psaume. Cantique.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Que Dieu nous soit favorable et qu’il nous bénisse ! qu’il fasse luire sur nous sa face, — Séla.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"afin que l’on connaisse sur la terre ta voie, et parmi toutes les nations ton salut !","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Que les peuples te louent, ô Dieu, que les peuples te louent tous !","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Que les nations se réjouissent, qu’elles soient dans l’allégresse ! car tu juges les peuples avec droiture, et tu conduis les nations sur la terre. — Séla.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Que les peuples te louent, ô Dieu, que les peuples te louent tous !","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"La terre a donné ses produits ; que Dieu, notre Dieu, nous bénisse !","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Que Dieu nous bénisse, et que toutes les extrémités de la terre le révèrent !","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/fra_ncl/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_ncl/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_ncl/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":8}