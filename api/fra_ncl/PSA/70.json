{"translation":{"id":"fra_ncl","name":"Sainte Bible néo-Crampon Libre","website":"https://ebible.org/Scriptures/details.php?id=francl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=francl","licenseNotes":null,"shortName":"NCL","englishName":"French néo-Crampon Libre","language":"fra","textDirection":"ltr","sha256":"7b5f459e33bfaffdc725d20cf9c44f806075aa4699ae71fecfe4ad1be221a3de","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_ncl/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31445,"languageName":"français","languageEnglishName":"French","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4106},"book":{"id":"PSA","translationId":"fra_ncl","name":"Psaumes","commonName":"Psaumes","title":"Le livre des Psaumes","order":19,"numberOfChapters":150,"sha256":"9f40c24bd615f767de500e0378f29a9c3f3264f8aa1ead201eece703d03549e7","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_ncl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_ncl/PSA/150.json","totalNumberOfVerses":2528},"chapter":{"number":70,"content":[{"type":"verse","number":1,"content":[{"text":"Au maître de chant. De David. Pour faire souvenir.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"O Dieu, hâte-toi de me délivrer ! Seigneur, hâte-toi de me secourir !","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Qu’ils soient honteux et confus, ceux qui cherchent mon âme ! Qu’ils reculent et rougissent ceux qui désirent ma perte !","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Qu’ils retournent en arrière à cause de leur honte, ceux qui disent : « Ah ! ah ! »","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Qu’ils soient dans l’allégresse et se réjouissent en toi tous ceux qui te cherchent ! Qu’ils disent sans cesse : « Gloire à Dieu », ceux qui aiment ton salut !","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Moi, je suis pauvre et indigent : ô Dieu, hâte-toi vers moi ! Tu es mon aide et mon libérateur : Yahweh, ne tarde pas !","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/fra_ncl/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_ncl/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_ncl/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":6}