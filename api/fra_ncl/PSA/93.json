{"translation":{"id":"fra_ncl","name":"Sainte Bible néo-Crampon Libre","website":"https://ebible.org/Scriptures/details.php?id=francl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=francl","licenseNotes":null,"shortName":"NCL","englishName":"French néo-Crampon Libre","language":"fra","textDirection":"ltr","sha256":"7b5f459e33bfaffdc725d20cf9c44f806075aa4699ae71fecfe4ad1be221a3de","availableFormats":["json"],"listOfBooksApiLink":"/api/fra_ncl/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31445,"languageName":"français","languageEnglishName":"French","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4106},"book":{"id":"PSA","translationId":"fra_ncl","name":"Psaumes","commonName":"Psaumes","title":"Le livre des Psaumes","order":19,"numberOfChapters":150,"sha256":"9f40c24bd615f767de500e0378f29a9c3f3264f8aa1ead201eece703d03549e7","firstChapterNumber":1,"firstChapterApiLink":"/api/fra_ncl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/fra_ncl/PSA/150.json","totalNumberOfVerses":2528},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"Yahweh est roi, il est revêtu de majesté, Yahweh est revêtu, il est ceint de force : aussi le monde est ferme, il ne chancelle pas.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Ton trône est établi dès l’origine, tu es dès l’éternité.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Les fleuves élèvent, ô Yahweh, les fleuves élèvent leurs voix, les fleuves élèvent leurs flots retentissants.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"Plus que la voix des grandes eaux, des vagues puissantes de la mer, Yahweh est magnifique dans les hauteurs !","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tes témoignages sont immuables ; la sainteté convient à ta maison, Yahweh, pour toute la durée des jours.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/fra_ncl/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/fra_ncl/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/fra_ncl/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}