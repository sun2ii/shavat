{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"2SA","translationId":"gax_twf","name":"2 Saamu'elii","commonName":"2 Saamu'elii","title":"Kitaaba Saamu'elii Ka Lammeesso'oo","order":10,"numberOfChapters":24,"sha256":"0d641deb5c3c68eaaca1611dc92a66c57b3af72c90134c5f927cba5f5ef2cbe8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/gax_twf/2SA/24.json","totalNumberOfVerses":695},"chapter":{"number":22,"content":[{"type":"heading","content":["Faaruu Daawitii Ta Galataa"]},{"type":"verse","number":1,"content":["Mootiin Waan Maraa harka diinota isaa maraa fi harka Saa'olii jalaa yennaa isa baase Daawiti faaruu asii gad jirtu tana Mootii Waan Maraatiif faarse:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Inni, «Mootiin Waan Maraa rassaa kiyya,","poem":1},{"text":"waan itti golladhu;","poem":2},{"lineBreak":true},{"text":"ka na baasulle'e.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Waaqi kiyya rassaa kiyya","poem":1},{"text":"ka ani itti baqadhu;","poem":2},{"lineBreak":true},{"text":"wontee tiyya,","poem":2},{"lineBreak":true},{"text":"ka akka gaafaa woy na irraa dhooggu.","poem":2},{"text":"Inni kushee tiyya jaddu'u;","poem":1},{"text":"ta ani itti baqadhu; fayyisaa kiyyalle'e;","poem":2},{"lineBreak":true},{"text":"namoota hunnaan nama irratti ka'anu jalaa","poem":2},{"lineBreak":true},{"text":"na hin baasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ani Mootii Waan Maraa leellifamaa","poem":1},{"text":"hin waammadha;","poem":2},{"lineBreak":true},{"text":"innille diinota kiyya jalaa na hin baasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Danbaliin du'aa na marsitee,","poem":1},{"text":"lolaan badi'ii na gad liqinse.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wodaroon awwaalaa na xaxxee,","poem":1},{"text":"tiyyoon du'aa na qabatte.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Rakkinna kiyya keessatti","poem":1},{"text":"ani Mootii Waan Maraa kiyya waammadhe;","poem":2},{"lineBreak":true},{"text":"akka na qarqaaruuf,","poem":2},{"lineBreak":true},{"text":"Waaqa kiyyatti iyye.","poem":2},{"text":"Inni Dunkaanii Woyyittii ifii keessaa","poem":1},{"text":"qoonqoo tiyya dhage'e;","poem":2},{"lineBreak":true},{"text":"iyya tiyyalle caqase.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Mootiin Waan Maraa waan aareef,","poem":1},{"text":"latti rommitee tachoote;","poem":2},{"lineBreak":true},{"text":"hundeen ol-gubba'aalle daaxxee hollatte.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Funnaan isaa keessaa aarri baye;","poem":1},{"text":"afaan isaa keessaa ibiddi luxub godhuu fi","poem":2},{"lineBreak":true},{"text":"kashilli ibiddaa baye.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Inni ol-gubbaa dayyaasee gad bu'e;","poem":1},{"text":"duumensi gurraachi miila isaa jala jiraayyu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inni dada ol-gubba'aa","poem":1},{"text":"ta koola qaddu irra tee'ee koolaan ka'e;","poem":2},{"lineBreak":true},{"text":"koola qilleensaa irra tee'ee xinniqe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Inni dukkana gollaa ifii godhatee,","poem":1},{"text":"dunkaaniin isaa adaala isaa jirtiiyyu;","poem":2},{"lineBreak":true},{"text":"duumensi gurraachi, bisaaniin guutame,","poem":2},{"lineBreak":true},{"text":"isa marseera.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Calalaqa addee inni jiruu keessaa,","poem":1},{"text":"balaqqeettiin balaqqitte.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mootiin Waan Maraa ol-gubbaa irraa mandi'e;","poem":1},{"text":"Waaqi Ol Aanaan qoonqoo ifii dhageessise.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Inni daaya ifii darbatee diinota ifii bittinneesse;","poem":1},{"text":"balaqqeessa balaqqeetti'iitiin","poem":2},{"lineBreak":true},{"text":"haxowee isaan balleesse.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Xixicha Mootii Waan Maraatiin,","poem":1},{"text":"dhowicha hafuura funnaan isaatiin,","poem":2},{"lineBreak":true},{"text":"dhooqoti abbaayaa jalaa mudhatane;","poem":2},{"lineBreak":true},{"text":"hundeen lafaa marti qullaa hafane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«Inni gubbaa irraa gad hiixatee, na qabe;","poem":1},{"text":"bisaan qilee keessaa harkisee na baase.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Isaan akka malee hunnaan waan na caalanuuf,","poem":1},{"text":"inni diinota kiyya hunnaameyyii,","poem":2},{"lineBreak":true},{"text":"worra na jibbu jalaa na baase.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yennaa ani rakkadhe,","poem":1},{"text":"isaan na irratti ka'ane;","poem":2},{"text":"Mootiin Waan Maraa","poem":1},{"text":"ammoo na qarqaare.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Inni gara addee badho'oo na geessee,","poem":1},{"text":"waan natti gammadeef, na baase.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«Mootiin Waan Maraa","poem":1},{"text":"akkuma balchummaa tiyyaatitti naaf godhe;","poem":2},{"lineBreak":true},{"text":"inni waan ani yakkaa hin qanneef","poem":2},{"lineBreak":true},{"text":"gatii naa kaffale.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ani karaa Mootii Waan Maraa waan hordofeef,","poem":1},{"text":"Waaqa kiyya irraa deebi'ee","poem":2},{"lineBreak":true},{"text":"waan hantuu hin hunye.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ani seera isaa mara muummesseera;","poem":1},{"text":"seerata isaalle irraa hin gorre.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ani isa duratti komii hin qabuuyyu;","poem":1},{"text":"cubbuu irralle'ee ifi eeggadheera.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"akkuma balchummaa tiyyaatitti,","poem":2},{"lineBreak":true},{"text":"ani waan yakkaa hin qanneef","poem":2},{"lineBreak":true},{"text":"badhaasa naaf kenne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"«Ee, Mootii Waan Maraa,","poem":1},{"text":"ati worra addatama'aaf, ka addatante;","poem":2},{"lineBreak":true},{"text":"worra komii hin qanneef, ka komii hin qanne.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Worra qulqullu'uuf, ati qulqullu'u;","poem":1},{"text":"worra dabaalessaaf,","poem":2},{"lineBreak":true},{"text":"akka daba isaaniititti gatii isaaniif kennita.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ati worra gad ifi qabu hin baatta","poem":1},{"noteId":8},{"text":";","poem":1},{"text":"worra kooru ammoo hin salphitta.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ee, Mootii Waan Maraa,","poem":1},{"text":"ati ifa naaf hin issita;","poem":2},{"lineBreak":true},{"text":"Waaqa kiyya,","poem":2},{"lineBreak":true},{"text":"ati dukkana tiyya hin issita.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Qarqaarsa keetiin ani loltoota hin lola;","poem":1},{"text":"qarqaarsa Waaqaatiin","poem":2},{"lineBreak":true},{"text":"dalleya gubba'aan utaaluu dande'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"«Karaan Waaqaa dhidhinna hin qabu;","poem":1},{"text":"jechi Mootii Waan Maraa dhuga'a;","poem":2},{"lineBreak":true},{"text":"worra isatti baqatuuf, inni wonte'e.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Waaqa malee Mootiin Waan Maraa eennu?","poem":1},{"text":"Waaqa keenna malee rassaan eennu?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Jabeenna ka anaaf kennu,","poem":1},{"text":"ka karaa naaf qajeelchu Waaqa.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Inni miila kiyya","poem":1},{"text":"akka miila gadansaa hin jabeessa;","poem":2},{"lineBreak":true},{"text":"koobota gubbaa","poem":2},{"lineBreak":true},{"text":"sodaa malee na dhaabbachiisa.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Inni harka kiyya lolaaf hin leenjisa;","poem":1},{"text":"guubee sageettu'uu harkisuu akka dande'u,","poem":2},{"lineBreak":true},{"text":"irree tiyya hin jabeessa.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Wontee teeti ta fayyinnaa naa kenniteerta;","poem":1},{"text":"qarqaarsi keeti guddaa na godheera.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Karaa ideemmaa tiyyaa naaf badhittee,","poem":1},{"text":"miilli kiyyalle hin mucucaanne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"«Ani diinota kiyya","poem":1},{"text":"ari'ee isaan balleesse;","poem":2},{"lineBreak":true},{"text":"haga isaan badanutti","poem":2},{"lineBreak":true},{"text":"ani duubatti hin deebine.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Akka isaan dande'anee hin kaane,","poem":1},{"text":"gad isaan dhowe;","poem":2},{"lineBreak":true},{"text":"isaan miila kiyya jalatti jigane.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Ati lolaaf hunna naaf kennite;","poem":1},{"text":"mormitoota tiyya","poem":2},{"lineBreak":true},{"text":"miila kiyya jalatti jilbiiffachiitte.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Ati diinoti kiyya worri na jibbu","poem":1},{"text":"duubatti deebi'anee akka baqatanu goote;","poem":2},{"lineBreak":true},{"text":"anille isaan balleesse.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Isaan qarqaarsa gaafatiisaaf iyyane;","poem":1},{"text":"ammoo nami tokkolle isaan hin qarqaarre.","poem":2},{"text":"Isaan Mootii Waan Maraa waamane;","poem":1},{"text":"inni ammoo deebii hin kennine.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Akka bukuu qilleensi afuufuu,","poem":1},{"text":"ani isaan butuche;","poem":2},{"lineBreak":true},{"text":"akka dhoqqee karaa keessaa,","poem":2},{"lineBreak":true},{"text":"ani isaan irra sirbe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"«Ati kolbaa tiyya","poem":1},{"text":"ta na loltu jalaa na baatte","poem":2},{"noteId":9},{"text":";","poem":2},{"lineBreak":true},{"text":"gosa biyya adda addaa irratti","poem":2},{"lineBreak":true},{"text":"bulchaa na goote;","poem":2},{"lineBreak":true},{"text":"kolbaan ani hin beenne na tajaajilte.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Worri ormaa na sossobatane;","poem":1},{"text":"gurra kiyya akkuma dhage'aneen,","poem":2},{"lineBreak":true},{"text":"naaf ajajamane.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Isaan Sodaatanee addii kutatane;","poem":1},{"text":"raafamanee kushee jadduu ifii","poem":2},{"lineBreak":true},{"text":"lakkisanee bayane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"«Mootiin Waan Maraa jiraata'a!","poem":1},{"text":"Rassaan kiyya leellifamuu ti!","poem":2},{"lineBreak":true},{"text":"Waaqi fayyisaan kiyya jajamuu ti.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Inni Waaqa diinota kiyya haluu naa bayu;","poem":1},{"text":"gosa biyya adda addaa harka kiyya jala galcha.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Inni diinota kiyya jalaa na baasa.","poem":1},{"text":"Diinota kiyya irratti ol ol na qaba;","poem":2},{"lineBreak":true},{"text":"kolbaa hunnaan na irratti kaatu jalalle'ee","poem":2},{"lineBreak":true},{"text":"na baasa.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Tanaaf, Mootii Waan Maraa,","poem":1},{"text":"gosa biyya adda addaa oddu'utti si leellisa;","poem":2},{"lineBreak":true},{"text":"faaruu leellisaatiin maqaa keeti faarfadha.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Mootiin Waan Maraa mooticha mootii godheef,","poem":1},{"text":"injifachaa kenna;","poem":2},{"lineBreak":true},{"text":"ka ifii muude Daawitii fi sanyii isaatiifille,","poem":2},{"lineBreak":true},{"text":"jaalala ifii ka bara baraa itti mudhisa» jedhe.","poem":2}]}],"footnotes":[{"noteId":8,"caller":"+","text":"Hin baatta: Lafa tokko tokkotti hin baacha jedhan.","reference":{"chapter":22,"verse":28}},{"noteId":9,"caller":"+","text":"Baatte: Yookiin Baache","reference":{"chapter":22,"verse":44}}]},"thisChapterLink":"/api/gax_twf/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}