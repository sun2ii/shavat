{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"AMO","translationId":"gax_twf","name":"Amosii Raagichaa","commonName":"Amosii Raagichaa","title":"Kitaaba Amosii Raagichaa","order":30,"numberOfChapters":9,"sha256":"b7c3b8ffb5d313ba6d2de0aaadbff09375a8d5a37f45a24824821c76cb56db6f","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gax_twf/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Bara Uziyaan Yihudaa irratti, ilmi Yeho'aashii Yerobi'aam Israa'el irratti mootii te'ane, tissitoota qachaa Teqo'aa keessaa tokko ka te'e Amos, tacho'iis lafaa adoo hin te'in woggaa lamaan duratti raagi inni marroo Israa'eliitiif raage ka asii gad jiru:"]},{"type":"verse","number":2,"content":["Inni, «Mootiin Waan Maraa gaara Xiyoonii irraa hin harqa;",{"text":"Yerusaalem keessalle'ee hin mandi'a;","poem":2},{"lineBreak":true},{"text":"kaloon tissitootaa hin goddi;","poem":2},{"lineBreak":true},{"text":"marri qaccee gaara Qarmelosii irraa hin qoora» jedhe.","poem":2}]},{"type":"heading","content":["Muraa Waaqaa Ta Worra Ollaa Israa'elii jiru Irratti Dhufu'uu Jirtu"]},{"type":"heading","content":["Sooriya'atti"]},{"type":"verse","number":3,"content":[{"text":"Mootiin Waan Maraa,","poem":1},{"text":"«Worri qachaa Damaasqo'oo korboo ilkaan sibiilaa qaddu","poem":2},{"lineBreak":true},{"text":"worra biyya Giil'aadii irra waan oofaneef,","poem":2},{"lineBreak":true},{"text":"anille marroo cubbuu kolbaan Damaasqo'oo itti deddeebitee hujjeetiif,","poem":2},{"lineBreak":true},{"text":"isaan hin adaba.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Maarre ani ibidda kushee jadduu Ben-Hadaadii mootichaa luxub godhu,","poem":1},{"text":"mana mooticha Hazaa'eliititti hin erga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ani danqaraa karra Damaasqo'oo hin caccassa;","poem":1},{"text":"kolbaa dhooqa Aween keessaatii fi","poem":2},{"lineBreak":true},{"text":"mooticha Bet-Edeenii hin balleessa;","poem":2},{"lineBreak":true},{"text":"worri Sooriya'aalle","poem":2},{"noteId":0},{"text":"booji'amanee","poem":2},{"lineBreak":true},{"text":"gara biyya Qiirii hin dhaqan» jedha.","poem":2}]},{"type":"verse","number":6,"content":["Mootiin Waan Maraa, «Worri qachaa Gaaza'aa",{"text":"kolbaa booji'ane mara","poem":2},{"lineBreak":true},{"text":"worra Edoomiititti dabarsanee kenniisaan","poem":2},{"lineBreak":true},{"text":"itti deddeebi'anee yakkaa waan hujaneef,","poem":2},{"lineBreak":true},{"text":"ani isaan hin adaba.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Maarre ani ibidda kushee isi'ii luxub godhu","poem":1},{"text":"dalleya dhaka'aa ka qachaa Gaaza'aatitti hin erga.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ani worra qachaa Ashidoodii keessa le'uu fi","poem":1},{"text":"mooticha Ashiqalonii hin balleessa.","poem":2},{"text":"Ani worra qachaa Eqroonii keessa le'u hin adaba;","poem":1},{"text":"worri Filiisxiyaa keessatti hafane marti hin badan» jedha.","poem":2}]},{"type":"heading","content":["Xiiroositti"]},{"type":"verse","number":9,"content":["Mootiin Waan Maraa, «Worri qachaa Xiiroosii",{"text":"gondooroo obbolumma'aa diiganee,","poem":2},{"lineBreak":true},{"text":"kolbaa booji'ane mara","poem":2},{"lineBreak":true},{"text":"worra Edoomiititti dabarsanee kenniisaan","poem":2},{"lineBreak":true},{"text":"itti deddeebi'anee yakkaa waan hujaneef,","poem":2},{"lineBreak":true},{"text":"ani isaan hin adaba.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Maarre ani ibidda kushee isi'ii luxub godhu,","poem":1},{"text":"dalleya dhaka'aa ka qachaa Xiiroosiititti hin erga» jedha.","poem":2}]},{"type":"heading","content":["Edoomitti"]},{"type":"verse","number":11,"content":["Mootiin Waan Maraa,",{"text":"«Worri Edoomii obboleeyyan ifii Israa'eloota,","poem":2},{"lineBreak":true},{"text":"marartii malee shallaaga'aan waan ari'aneef,","poem":2},{"lineBreak":true},{"text":"aariin isaanii yennaa mara isaan irratti waan bobeetteef,","poem":2},{"lineBreak":true},{"text":"mufiin isaanii haga bara baraa waan teeteef,","poem":2},{"lineBreak":true},{"text":"ani isaan hin adaba.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Maarre ani ibidda kushee qachaa Bozra'aa luxub godhu,","poem":1},{"text":"qachaa Temaaniititti hin erga» jedha.","poem":2}]},{"type":"heading","content":["Muraa Amoonitti Dhufu'uu Jirtu"]},{"type":"verse","number":13,"content":[{"text":"Mootiin Waan Maraa,","poem":1},{"text":"«Worri Amoonii meessaa biyya ifii badhifatiisaaf,","poem":2},{"lineBreak":true},{"text":"gadhaa dubartii ulfaa ta worra Giil'aadii baqasiisaan,","poem":2},{"lineBreak":true},{"text":"itti deddeebi'anee yakkaa waan hujaneef,","poem":2},{"lineBreak":true},{"text":"ani isaan hin adaba.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Maarre ani ibidda kushee isi'ii, guyyaa lolaa iyya keessa,","poem":1},{"text":"guyyaa bokkeya bubbe'ee, qilleensa jabaa keessa luxub godhu,","poem":2},{"lineBreak":true},{"text":"dalleya dhaka'aa ka qachaa Raaba'aatitti hin erga.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mootiin isi'ii, qondaaltota ifii woliin hin booji'ama» jedha.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Sooriyaa: Bara durii Aaram jedhanti.","reference":{"chapter":1,"verse":5}}]},"thisChapterLink":"/api/gax_twf/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}