{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"AMO","translationId":"gax_twf","name":"Amosii Raagichaa","commonName":"Amosii Raagichaa","title":"Kitaaba Amosii Raagichaa","order":30,"numberOfChapters":9,"sha256":"b7c3b8ffb5d313ba6d2de0aaadbff09375a8d5a37f45a24824821c76cb56db6f","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gax_twf/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":2,"content":[{"type":"heading","content":["Muraa Mo'aabitti Dhufu'uu Jirtu"]},{"type":"verse","number":1,"content":[{"text":"Mootiin Waan Maraa,","poem":1},{"text":"«Worri Mo'aabii lafee mootii Edoomii","poem":2},{"lineBreak":true},{"text":"haga daadhaa teetutti gubiisaan","poem":2},{"lineBreak":true},{"text":"itti deddeebi'anee yakkaa waan hujaneef,","poem":2},{"lineBreak":true},{"text":"ani isaan hin adaba.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Maarre ani ibidda kushee qachaa Keriyotii luxub godhu,","poem":1},{"text":"qachaa Mo'aabiititti hin erga;","poem":2},{"lineBreak":true},{"text":"Worri Mo'aabii hogaa guddaa","poem":2},{"lineBreak":true},{"text":"iyya lolaatii fi","poem":2},{"lineBreak":true},{"text":"qoonqoo tultulla'aa keessa hin dhumatan.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ani bulchaa isi'ii hin balleessa;","poem":1},{"text":"qondaaltota isi'ii mara","poem":2},{"lineBreak":true},{"text":"mootii isi'ii woliin hin ijjeesa» jedha.","poem":2}]},{"type":"heading","content":["Muraa Yihuda'atti Dhufu'uu Jirtu"]},{"type":"verse","number":4,"content":["Mootiin Waan Maraa,",{"text":"«Worri Yihuda'aa seera kiyya didanee,","poem":2},{"lineBreak":true},{"text":"seerata kiyyalle waan hin eegatiniif,","poem":2},{"lineBreak":true},{"text":"waaqota dhara ka abbootiin isaanii ta durii","poem":2},{"lineBreak":true},{"text":"hordofatte hordofiisaan,","poem":2},{"lineBreak":true},{"text":"itti deddeebi'anee yakkaa waan hujaneef,","poem":2},{"lineBreak":true},{"text":"ani isaan hin adaba.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Maarre ani ibidda kushee qachaa Yerusaalemii luxub godhu,","poem":1},{"text":"qachaa Yihuda'aatitti hin erga» jedha.","poem":2}]},{"type":"heading","content":["Muraa Israa'elitti Dhufu'uu Jirtu"]},{"type":"verse","number":6,"content":[{"text":"Mootiin Waan Maraa,","poem":1},{"text":"«Worri Israa'elii worra balchoota meeti'itti,","poem":2},{"lineBreak":true},{"text":"worra hiyyeeyyii kophee miilaatitti gurguratiisaan,","poem":2},{"lineBreak":true},{"text":"itti deddeebi'anee yakkaa waan hujaneef","poem":2},{"lineBreak":true},{"text":"ani isaan hin adaba.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Isaan mataa worra hiyyeeyyi'ii bukuu irratti irra sirban;","poem":1},{"text":"worra cunqurfameef muraa haqaa hin kennanu;","poem":2},{"lineBreak":true},{"text":"abba'aa fi ilmi dubartii takkaa woliin sagaagaliisaan","poem":2},{"lineBreak":true},{"text":"maqaa kiyya woyyicha batteessan.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Isaan addee ciinca'aa mara cinaa,","poem":1},{"text":"woyaa worra hiyyeeyyii liqaa kaffaluu hin dandeenne","poem":2},{"lineBreak":true},{"text":"irraa qabatane irra rafan.","poem":2},{"text":"Daadhii woyni'ii ta worra adabame","poem":1},{"text":"irraa fuudhane","poem":2},{"lineBreak":true},{"text":"mana Waaqa ifii keessatti unan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Ani worra Amoorotaa","poem":1},{"text":"ka akka muka hindheensaa dheeratanu,","poem":2},{"lineBreak":true},{"text":"ka akka muka qilxa'aa jabaatanu san","poem":2},{"lineBreak":true},{"text":"fuula isaanii duraa balleesse.","poem":2},{"text":"Midhaan isaan irraatii fi","poem":1},{"text":"hidda isaanii isaan jalaa balleesse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Ani lafa Amoorotaa isiniif kenniisaaf,","poem":1},{"text":"biyya Gibxi'ii keessaa isin baasee","poem":2},{"lineBreak":true},{"text":"woggaa afurtama lafa goomole'ee keessa isin sooresse.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ani ilmaan teessan keessaa raagota,","poem":1},{"text":"dargaggoota teessan keessaa","poem":2},{"lineBreak":true},{"text":"worra Waaqaaf adda baye isiniif kaaseera.","poem":2},{"text":"Ee kolbaa Israa'elii tun dhugumaa motii ree?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Isin ammoo worra Waaqaaf adda baye","poem":1},{"text":"daadhii woyni'ii akka unanu gootanee,","poem":2},{"lineBreak":true},{"text":"raagotille raaga akka hin dubbanne ajajjane.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Maarre akkuma garreettaan midhaan ba'ateeru","poem":1},{"text":"waan isa jala jiru butuchu,","poem":2},{"lineBreak":true},{"text":"anille isin hin butucha.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nami akka malee rukkisu duraa hin bayu;","poem":1},{"text":"worri jajjabi jabeenna ifii hin dhaban;","poem":2},{"lineBreak":true},{"text":"worri lolulle lubbuu ifii hamburatiisa hin dande'anu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Worri guube'een lolu dura hin dhaabbatu;","poem":1},{"text":"loltooti rukkisuu dande'anulle duraa hin bayanu.","poem":2},{"text":"Abbootiin fardaalle lubbuu ifii hin hamburatanu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Guyyaa san loltooti goototinuu qullaa hin baqatan» jedha.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}