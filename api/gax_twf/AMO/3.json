{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"AMO","translationId":"gax_twf","name":"Amosii Raagichaa","commonName":"Amosii Raagichaa","title":"Kitaaba Amosii Raagichaa","order":30,"numberOfChapters":9,"sha256":"b7c3b8ffb5d313ba6d2de0aaadbff09375a8d5a37f45a24824821c76cb56db6f","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gax_twf/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"heading","content":["Raaga Israa'el Irratti Dubbatame"]},{"type":"verse","number":1,"content":["Ee kolbaa Israa'elii,",{"text":"dubbii Mootiin Waan Maraa","poem":2},{"lineBreak":true},{"text":"isin worra biyya Gibxi'ii keessaa baase maratti","poem":2},{"lineBreak":true},{"text":"dubbatu tana dhage'a'a!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inni, «Ani kolbaa biyya lafaa keessaa isin callaa filadhe;","poem":1},{"text":"tanaaf cubbuu teessan maraaf ani isin hin adaba» jedheera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nami lama woliin deemiisaaf adoo wolii hin galin","poem":1},{"text":"karaa hin deemanii?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Neenqi gongomaa keessatti","poem":1},{"text":"waan adansee nyaatu adoo hin dhaggin","poem":2},{"lineBreak":true},{"text":"dhangaa hin dhowaa?","poem":2},{"text":"Neenqi dardarri waan tokko adoo hin qabatin","poem":1},{"text":"mandhee ifii keessaa hin gurura'aa?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sinbirreen fonxoroo adoo itti hin afamin","poem":1},{"text":"lafa irratti tiyyoo keessa hin seentii?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tultullaan lolaa qachaa keessatti yennaa afuufamu,","poem":1},{"text":"kolbaan hin sodaattuu ree?","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa adoo hin eeyyamin","poem":2},{"lineBreak":true},{"text":"wonni hantuun qacha'atti hin dhuttii ree?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dhugumaan Goottaan, Mootiin Waan Maraa","poem":1},{"text":"dhossaa jirtu tajaajiltoota ifii raagotatti adoo hin mudhisin","poem":2},{"lineBreak":true},{"text":"waan tokkolle hin godhu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Neenqa dhangaa dhowe,","poem":1},{"text":"ka hin sodaanne eennu ree?","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa eega itti dubbatte,","poem":2},{"lineBreak":true},{"text":"ka raaga hin dubbanne eennu ree?","poem":2}]},{"type":"heading","content":["Badii Qachaa Samaariya'aa"]},{"type":"verse","number":9,"content":[{"text":"Kushee jajjadduu Ashidoodiitii fi","poem":1},{"text":"kushee jajjadduu biyya Gibxi'iititti lallaba'aatii,","poem":2},{"lineBreak":true},{"text":"«Gaara Samaariya'aa irratti wolitti qabama'a;","poem":2},{"lineBreak":true},{"text":"hogaa isii keessaatii fi","poem":2},{"lineBreak":true},{"text":"cunqursaa odduu kolbaa isi'ii jiru ilaala'a» jedha'aan.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mootiin Waan Maraa, «Isaan waan sirrii te'e","poem":1},{"text":"attam akka hujanu hin beekanu;","poem":2},{"lineBreak":true},{"text":"waan hunnaan nama irratti ka'anee","poem":2},{"lineBreak":true},{"text":"saamaneen mana ifii guutatan» jedha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tanaaf Goottaan Mootiin Waan Maraa,","poem":1},{"text":"«Diinni lafa hin qabata;","poem":2},{"lineBreak":true},{"text":"kushee jajjadduu teessan diigee","poem":2},{"lineBreak":true},{"text":"mana keessanille hin saama» jedha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mootiin Waan Maraa,","poem":1},{"text":"«Akkuma tisseen afaan neenqaa irraa","poem":2},{"lineBreak":true},{"text":"lafee lukaa lama yookiin gurra ciccitaa callaa buufattu,","poem":2},{"lineBreak":true},{"text":"Israa'elooti Samaariyaa keessatti qaccee taqee ifii irra,","poem":2},{"lineBreak":true},{"text":"Damaasqoo keessattille taqee gaggabaadduu ifii irra tee'anu,","poem":2},{"lineBreak":true},{"text":"akkasuma hin hafan» jedha.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Goottaan Mootiin Waan Maraa Waaqi Waan Mara Dande'u,","poem":1},{"text":"«Tana dhage'a'aatii sanyii Yaaqoobii irratti dhugaa baya'a.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Guyyaa ani marroo cubbuu isaaniitiif Israa'eloota adabu,","poem":1},{"text":"addee ciinca'aa ta Bet'elii hin diiga;","poem":2},{"lineBreak":true},{"text":"gaafoti addee ciinca'aa","poem":2},{"lineBreak":true},{"text":"muramanee lafa harca'an.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ani mana isaan yennaa gannaatii fi","poem":1},{"text":"yennaa bonaa keessa tee'anu mara hin diiga;","poem":2},{"lineBreak":true},{"text":"manni ilka arbaatiin seefamee ijaarame marti hin bada;","poem":2},{"lineBreak":true},{"text":"Galmi gugurdaalle barbadeeffamee bada» jedha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}