{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"AMO","translationId":"gax_twf","name":"Amosii Raagichaa","commonName":"Amosii Raagichaa","title":"Kitaaba Amosii Raagichaa","order":30,"numberOfChapters":9,"sha256":"b7c3b8ffb5d313ba6d2de0aaadbff09375a8d5a37f45a24824821c76cb56db6f","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gax_twf/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Isin dubartooti akka sa'oolee Baashaanii,","poem":1},{"text":"ta gaara Samaariya'aa irratti gabbattanee,","poem":2},{"lineBreak":true},{"text":"worra hiyyeeyyii ka cunqursitanu,","poem":2},{"lineBreak":true},{"text":"worra rakkataalle ka butuchitanu,","poem":2},{"lineBreak":true},{"text":"abbootii worra teessaniin,","poem":2},{"lineBreak":true},{"text":"«Daadhii nu'uuf fida'a!» ka jettanu,","poem":2},{"lineBreak":true},{"text":"jecha kana dhage'a'a!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Goottaan Mootiin Waan Maraa","poem":1},{"text":"woyyummaa ifiitiin kakatee,","poem":2},{"lineBreak":true},{"text":"«Guyyaan isin malxaqqo'oon","poem":2},{"lineBreak":true},{"text":"harkifantanu hin dhufa;","poem":2},{"lineBreak":true},{"text":"worri isin keessaa hafanelle","poem":2},{"lineBreak":true},{"text":"malxaqqoo qurxummi'iitiin hin harkifaman.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tokko tokkoo keessan","poem":1},{"text":"qowa dalleya dhaka'aa ka fuula keessan duraatiin","poem":2},{"lineBreak":true},{"text":"harkisanee gara gaara Hermoonii isin hin baasan» jedha.","poem":2}]},{"type":"heading","content":["Israa'el Baratiisa Didde"]},{"type":"verse","number":4,"content":[{"text":"Goottaan Mootiin Waan Maraa,","poem":1},{"text":"«Ee kolbaa Israa'elii,","poem":2},{"lineBreak":true},{"text":"Bet'el dhaqa'aatii cubbuu huja;","poem":2},{"lineBreak":true},{"text":"Giilgaliille dhaqa'aatii cubbuu baceessa'aa huja'a;","poem":2},{"lineBreak":true},{"text":"guyyuma guyya'aan ciincaa,","poem":2},{"lineBreak":true},{"text":"guyyaa sad saditti","poem":2},{"lineBreak":true},{"text":"kudhan keessaa tokko dhikeessa'a.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ee Israa'eloota,","poem":1},{"text":"wonni isin godhiisaaf jaalattanu tana waan teeteef,","poem":2},{"lineBreak":true},{"text":"daabboo uukoo qaddu irraa ciincaa galataa dhikeessa'a;","poem":2},{"lineBreak":true},{"text":"kennansa fedhii teessaniin kennitanuun","poem":2},{"lineBreak":true},{"text":"ifi jaja'aatii koora'a» jedha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mootiin Waan Maraa,","poem":1},{"text":"«Qachoota gugurdaa keessan mara keessatti","poem":2},{"lineBreak":true},{"text":"wonni afaaniin qaddanu akka hin dhagganne,","poem":2},{"lineBreak":true},{"text":"qachaa mara keessatti","poem":2},{"lineBreak":true},{"text":"sagaleen akka dhabantu ka godhe ana;","poem":2},{"lineBreak":true},{"text":"isin ammoo haga ammaa gara kiyya hin deebine.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Midhaan galfatiisaaf jiin sad adoo jiruu","poem":1},{"text":"bokkeya isin irraa dhoogge;","poem":2},{"lineBreak":true},{"text":"qachaa tokkotti bokkeenni akka roobu,","poem":2},{"lineBreak":true},{"text":"qachaa kaanitti bokkeenni akka roobuu hin dandeenne godhe.","poem":2},{"text":"Fichaan tokko bokkeya qaba;","poem":1},{"text":"fichaan dhibiin bokkeya dhabee goge.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Maarre namooti bisaan barbaadatiisaaf,","poem":1},{"text":"qachaa tokko irraa gara qachaa tokkoo joonjane;","poem":2},{"lineBreak":true},{"text":"te'uu malee unanee dheebuu bawuu hin dandeenne;","poem":2},{"lineBreak":true},{"text":"isin haga ammaa gara kiyya hin deebine» jedha.","poem":2}]},{"type":"verse","number":9,"content":["Mootiin Waan Maraa,",{"text":"«Ani yennaa hedduu gugguufa'aa fi shanto'oon","poem":2},{"lineBreak":true},{"text":"oorru'uu fi muka woyni'ii keessan balleesse.","poem":2},{"text":"Muka harru'uutii fi muka ejersaa keessan","poem":1},{"text":"awwaannisi nyaatee fixe;","poem":2},{"lineBreak":true},{"text":"isin ammoo haga ammaa gara kiyya hin deebine.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani balaa biyya Gibxi'iititti erge","poem":1},{"text":"isin irralle'etti erge.","poem":2},{"lineBreak":true},{"text":"Dargaggoota teessan shallaaga'aan ijjeesisee,","poem":2},{"lineBreak":true},{"text":"fardoota teessan akka booji'amanu godhe;","poem":2},{"lineBreak":true},{"text":"addee qubattanetti reeffi nama du'ee","poem":2},{"lineBreak":true},{"text":"akka isinitti ajowu godhe;","poem":2},{"lineBreak":true},{"text":"isin haga ammaa gara kiyya hin deebine» jedha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mootiin Waan Maraa,","poem":1},{"text":"«Ani Sodoomii fi Gomoraa akkuma balleesse,","poem":2},{"lineBreak":true},{"text":"isin keessalle'ee garii balleesseera.","poem":2},{"text":"Isin keessaa gariin akka muka","poem":1},{"text":"ibidda bobe'u keessaa butamee ti;","poem":2},{"lineBreak":true},{"text":"isin ammoo haga ammaa gara kiyya hin deebine.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tanaaf, ee kolbaa Israa'elii","poem":1},{"text":"ani akkasuma isin irratti hin godha;","poem":2},{"lineBreak":true},{"text":"ani tana isin irratti waan godhuuf,","poem":2},{"lineBreak":true},{"text":"ee kolbaa Israa'elii, Waaqa keessan woliin","poem":2},{"lineBreak":true},{"text":"wol dhaggiisaaf qophowa'a» jedha.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ka gaara huje,","poem":1},{"text":"qilleensalle ka dade,","poem":2},{"lineBreak":true},{"text":"ka yaada ifii namatti mudhisu,","poem":2},{"lineBreak":true},{"text":"ka ganama gara dukkanaatitti jijjiiru","poem":2},{"lineBreak":true},{"text":"ka gooroo lafaa irra ideemu,","poem":2},{"lineBreak":true},{"text":"maqaan isaa Mootii Waan Maraa","poem":2},{"lineBreak":true},{"text":"Waaqa Waan Mara Dande'u.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/AMO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/AMO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/AMO/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}