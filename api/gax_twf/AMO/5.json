{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"AMO","translationId":"gax_twf","name":"Amosii Raagichaa","commonName":"Amosii Raagichaa","title":"Kitaaba Amosii Raagichaa","order":30,"numberOfChapters":9,"sha256":"b7c3b8ffb5d313ba6d2de0aaadbff09375a8d5a37f45a24824821c76cb56db6f","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gax_twf/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["Kolbaan Israa'elii Araara akka Galtuuf Waammante"]},{"type":"verse","number":1,"content":["Ee kolbaa Israa'elii wolaloo gaddaa ta ani marroo teessaniif dubbadhu tana dhage'a'a:"]},{"type":"verse","number":2,"content":[{"text":"Israa'eliin akka durraa jiddeerti;","poem":1},{"text":"deebiteelle hin kaatu;","poem":2},{"lineBreak":true},{"text":"lafuma ifii keessatti gatante;","poem":2},{"lineBreak":true},{"text":"nami isii ol kaasulle hin jiru.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Goottaan Mootiin Waan Maraa,","poem":1},{"text":"«Qachaan guddichi Israa'elii ka loltoota kuma duula baase,","poem":2},{"lineBreak":true},{"text":"isaan keessaa loltoota dhibba qofatti isaaf hafa.","poem":2},{"text":"Qachaan loltoota dhibba duula baase,","poem":1},{"text":"isaan keessaa loltoota kudhan qofatti isaaf hafa» jedha.","poem":2}]},{"type":"verse","number":4,"content":["Mootiin Waan Maraa kolbaa Israa'eliitiin,",{"text":"«Ana barbaadadha'aatii, jiru'uun jiraadha'a!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Giilgal dhugumaan waan booji'antuuf,","poem":1},{"text":"Bet'elille waan woy hin baaneef,","poem":2},{"lineBreak":true},{"text":"Bet'el hin barbaadina'a;","poem":2},{"lineBreak":true},{"text":"Giilgal hin dhaqina'a","poem":2},{"lineBreak":true},{"text":"Bersheebaalle hin dhaqina'a» jedha.","poem":2}]},{"type":"verse","number":6,"content":["Mootii Waan Maraa barbaadadha'aatii jiru'uun jiraadha'a;",{"text":"yoo akkas hin te'in","poem":2},{"lineBreak":true},{"text":"inni kolbaa Israa'elii akka ibiddaa luxub hin godha;","poem":2},{"lineBreak":true},{"text":"worra Bet'eliille ibiddi hin fixa;","poem":2},{"lineBreak":true},{"text":"nami isa irraa dhaanfulle hin jiru.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Worri haqa gara hadha'aatitti jijjiirtanu,","poem":1},{"text":"dhugaalle ka lafatti gattanu isiniif aanne'e!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Urjoota, «Torbii","poem":1},{"noteId":1},{"text":"» jedhamanu ka dade,","poem":1},{"text":"urjoota, «Sadee","poem":2},{"noteId":2},{"text":"» jedhamanulle ka dade,","poem":2},{"lineBreak":true},{"text":"dukkana gara ifa guyya'aa,","poem":2},{"lineBreak":true},{"text":"guyyaalle dukkaneessee gara halkanii ka jijjiiru,","poem":2},{"lineBreak":true},{"text":"bisaan abbaaya'aa waamee,","poem":2},{"lineBreak":true},{"text":"lafa irra akka lola'u ka godhu,","poem":2},{"lineBreak":true},{"text":"maqaan isaa Mootii Waan Maraa ti!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inni kushee jadduu hin bobeessa;","poem":1},{"text":"qachaa guddaa dalleenni dhaka'aa jabaan itti ijaarame","poem":2},{"lineBreak":true},{"text":"irralle'etti badii hin fida.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Isin badhinna mura'aatitti nama dhuga'aaf falmu jibbitan;","poem":1},{"text":"nama dhugaa dubbatu tuffattan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isin worra hiyyeeyyii cunqursitan;","poem":1},{"text":"hunnaan akka isaan midhaan kennanu gootan.","poem":2},{"text":"Tanaaf, isin dhakaa bocameen mana ijaarrattanulle,","poem":1},{"text":"achi keessa hin leetanu.","poem":2},{"text":"Isin muka woyni'ii ka isin gammachiisu dhaabattanulle,","poem":1},{"text":"daadhii woyni'ii irraa hin untanu.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yakkaan teessan attam bacaa akka teetee fi","poem":2},{"lineBreak":true},{"text":"cubbuun teessan attam attam guddoo akka teete","poem":2},{"lineBreak":true},{"text":"ani hin beeka.","poem":2},{"text":"Isin worra balchaa cunqursitanee,","poem":1},{"text":"safuu irraa fudhattanee,","poem":2},{"lineBreak":true},{"text":"worri hiyyeeyyiin badhinna kora mura'aatitti","poem":2},{"lineBreak":true},{"text":"haqa akka hin dhagganne gootan.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tanaaf barri hamaa waan te'eef,","poem":1},{"text":"yennaa akkasiititti nami qalbeeffataan","poem":2},{"lineBreak":true},{"text":"cadhi hin jedha.","poem":2}]},{"type":"verse","number":14,"content":["Isin jiru'uun akka jiraattanuuf,",{"text":"waan dansaa malee waan hantuu hin barbaadina'a.","poem":2},{"lineBreak":true},{"text":"Achiin duuba akkuma isin jettanu","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa","poem":2},{"lineBreak":true},{"text":"Waaqi Waan Mara Dande'u","poem":2},{"lineBreak":true},{"text":"isin woliin hin jiraata.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Waan hantuu jibba'aatii,","poem":1},{"text":"waan dansaa jaaladha'a;","poem":2},{"lineBreak":true},{"text":"badhinna kora mura'aatitti","poem":2},{"lineBreak":true},{"text":"haqi akka jiraatu godha'a.","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa Waaqi Waan Mara Dande'u","poem":2},{"lineBreak":true},{"text":"kolbaa Israa'elii worra hafeef hin marara fa te'a.","poem":2}]},{"type":"verse","number":16,"content":["Tanaaf Mootiin Waan Maraa",{"text":"Waaqi Waan Mara Dande'u,","poem":2},{"lineBreak":true},{"text":"«Karaa mara irratti wiiccifati bowaa,","poem":2},{"lineBreak":true},{"text":"woldeennaa kara'aa mara irratti","poem":2},{"lineBreak":true},{"text":"iyyi farraa hin teeti.","poem":2},{"text":"Qonnaan bultooti bowaaf,","poem":1},{"text":"worri boochisulle wiiccifatiisaaf hin waamaman.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Oorruu woyni'ii mara keessatti wiiccifati bowaa hin te'a;","poem":1},{"text":"ani isin adabiisaaf odduu teessan waan dabaruuf,","poem":2},{"lineBreak":true},{"text":"tun marti isin irratti hin teeti» jedha.","poem":2}]},{"type":"verse","number":18,"content":["Isin worri guyyaa Mootii Waan Maraa halchitanu isiniif aanne'e!",{"text":"Isin maaf guyyaa Mootii Waan Maraa halchitan?","poem":2},{"text":"Guyyaan sun guyyaa dukkanaa ti malee","poem":1},{"text":"ifaa moti.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Guyyaan sun akka nama neenqa duraa adoo dheetuu","poem":1},{"text":"doobba'atti","poem":2},{"noteId":3},{"text":"dhufuu,","poem":2},{"lineBreak":true},{"text":"yookiin isa duralle'ee bayee","poem":2},{"lineBreak":true},{"text":"mana ifiititti galee dhaaba manaa yennaa qabatu","poem":2},{"lineBreak":true},{"text":"dhudhuufaan idduu ti.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Guyyaan Mootii Waan Maraa sun ifa adoo hin te'in, dukkana","poem":1},{"text":"dimma wililleettiin ifaa keessa hin jirree motii ree?","poem":2}]},{"type":"verse","number":21,"content":["Mootiin Waan Maraa, «Ani jila teessan mara jibbee, tuffadhe;",{"text":"yaa'iin teessanille na hin gammachiittu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Isin kennansa gubamuu fi","poem":1},{"text":"kennansa midhaanii naaf dhikeessitanulle,","poem":2},{"lineBreak":true},{"text":"ani hin fudhadhu.","poem":2},{"text":"Horii gagabbaa kennansa tokkumma'aatiif dhikeessitanulle,","poem":1},{"text":"ani hin ilaalu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Iyya faaruu teessanii na irraa fageessa'a;","poem":1},{"text":"ani yoyyoma kiraara guddicha keessanii hin caqasu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ammoo haqi akka bisaan lagaa,","poem":1},{"text":"balchummaalle akka madda hin gonnee lolaatuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"«Ee kolbaa Israa'el,","poem":1},{"text":"woggaa afurtama goomolee keessatti","poem":2},{"lineBreak":true},{"text":"isin ciinca'aa fi kennansa","poem":2},{"lineBreak":true},{"text":"naaf dhikeessitaneertanii ree?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Waan ifumaaf hujjane,","poem":1},{"text":"mootii keessan waaqa dharaa, ka, ‹Saakuut› jedhamuu fi","poem":2},{"lineBreak":true},{"text":"waaqa dharaa ka fakkii urji'ii, ka ‹Kiiyoon› jedhamu ba'attan.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Tanaaf ani qachaa Damaasqo'oo irraa fagaattanee","poem":1},{"text":"akka isin booji'antanu hin godha» jedha;","poem":2},{"lineBreak":true},{"text":"maqaan isaa Mootii Waan Maraa Waaqa Waan Mara Dande'u.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Torbii: Afaan Ibrootaatiin Paaldiyaas jedhaman.","reference":{"chapter":5,"verse":8}},{"noteId":2,"caller":"+","text":"Sadee: Afaan Ibrootaatiin Ooriyoon jedhaman.","reference":{"chapter":5,"verse":8}},{"noteId":3,"caller":"+","text":"Doobbaa: Bineensa hamaa iyyaa fakkaatu.","reference":{"chapter":5,"verse":19}}]},"thisChapterLink":"/api/gax_twf/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}