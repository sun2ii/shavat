{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"AMO","translationId":"gax_twf","name":"Amosii Raagichaa","commonName":"Amosii Raagichaa","title":"Kitaaba Amosii Raagichaa","order":30,"numberOfChapters":9,"sha256":"b7c3b8ffb5d313ba6d2de0aaadbff09375a8d5a37f45a24824821c76cb56db6f","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gax_twf/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":6,"content":[{"type":"heading","content":["Adabamiisa Israa'elii"]},{"type":"verse","number":1,"content":[{"text":"Worri Xiyoon keessa qananumma'aan leetanu,","poem":1},{"text":"ka bidhaa malee gaara Samaariya'aa irra teettanu,","poem":2},{"lineBreak":true},{"text":"worri kolbaan Israa'elii qarqaarsa dhaggatiisaaf","poem":2},{"lineBreak":true},{"text":"gara keessan dhufanu,","poem":2},{"lineBreak":true},{"text":"isin qondaaltoti gosa","poem":2},{"lineBreak":true},{"text":"worra gosa biyya adda addaa taan ka caaltanu","poem":2},{"lineBreak":true},{"text":"worri ifi seetanu","poem":2},{"lineBreak":true},{"text":"isiniif aanne'e!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gara qachaa Kaalnee dabara'aatii ilaala'a;","poem":1},{"text":"achille'ee gara qachaa guddaa, «Haamaat» jedhamuu dhaqa'a;","poem":2},{"lineBreak":true},{"text":"achiin duuba gara qachaa Filisxeemotaa","poem":2},{"lineBreak":true},{"text":"gara qachaa Gaatii gad bu'a'a.","poem":2},{"text":"Isaan mootummoota teessan lamaan hin caalanuu ree?","poem":1},{"text":"Yookiin latti isaanii lafa teessan caalaa hin badhattuu ree?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isin guyyaa hamaa akka fagaatu gootanee,","poem":1},{"text":"bulchiinsa hunnaa akka dhikaatu gootan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isin taqee ilka arbaatiin seefante irra rattan;","poem":1},{"text":"taqee gaggabaadduu irra balxiixxan.","poem":2},{"text":"Hoolee keessaa foon buruusotaa,","poem":1},{"text":"loon keessaa foon jabbi'ii nyaattan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isin kiraara guddicha hin qanya'aminiin sirbitan;","poem":1},{"text":"akka Daawitiille meya faaru'uutiin faarfatiisa barbaaddan.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isin daadhii woyni'ii okkote'een untan;","poem":1},{"text":"fiqiree, fiqiree mara caaltu dibattan malee,","poem":2},{"lineBreak":true},{"text":"badii sanyii Yoseefii irra geettuuf hin gadditanu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tanaaf isin worra booji'amu keessaa ka qaraa hin teetan;","poem":1},{"text":"fexxeessi keessanii fi","poem":2},{"lineBreak":true},{"text":"dalaqiis","poem":2},{"noteId":4},{"text":"keessan hin hafan.","poem":2}]},{"type":"verse","number":8,"content":["Goottaan Mootiin Waan Maraa, Mootiin Waan Maraa Waaqi Waan Mara Dande'u, ifiin kakatee,",{"text":"«Koora kolbaa Israa'elii jibbeera;","poem":2},{"lineBreak":true},{"text":"kushee isi'iille diqadheera;","poem":2},{"lineBreak":true},{"text":"tanaaf qachaa isaaniitii fi","poem":2},{"lineBreak":true},{"text":"waan qachaa keessa jiru mara","poem":2},{"lineBreak":true},{"text":"diinotaaf dabarsee hin kenna» jedheera.","poem":2}]},{"type":"verse","number":9,"content":["Mana tokko keessatti nami kudhan yoo hafe, isaanille hin du'an."]},{"type":"verse","number":10,"content":["Firri aanti'ii ka nama du'ee sun mana keessaa fuudhee reeffa awwaaliisaaf yoo dhufe, nama mana keessatti dhokateeruun, «Nami dhibiin si woliin jiraa?» jedhee gaafata; nami sunille, «Hin jiru» jedhee deebisa; nami fira aanti'ii sunille, «Cadhisi! Maqaa Mootii Waan Maraa dhowuu hin qannu» hin jedha."]},{"type":"verse","number":11,"content":[{"text":"Mootiin Waan Maraa waan ajajeef,","poem":1},{"text":"manni gugurdaan hurbamanee hin diigaman;","poem":2},{"lineBreak":true},{"text":"manni didiqqaalle bubbututee hurraa hin te'an.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Fardooleen rassaa irra hin gulufanii ree?","poem":1},{"text":"Nami tokko qotiyyo'oon achi irra hin qotaa ree?","poem":2},{"text":"Isin ammoo haqa gara waan hadhowuutitti,","poem":1},{"text":"hujii balchumma'aalle gara hammeennaatitti jijjiirtane.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Isin worri qachaa, «Lodbaar","poem":1},{"noteId":5},{"text":"» jedhamu","poem":1},{"text":"qabatanee firinxiixxanu,","poem":2},{"lineBreak":true},{"text":"ka qachaa, «Karnaayim","poem":2},{"noteId":6},{"text":"» jedhamu","poem":2},{"lineBreak":true},{"text":"jabeenna keennaan fudhanne jettanu,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mootiin Waan Maraa Waaqi Waan Mara Dande'u,","poem":1},{"text":"«Ee kolbaa Israa'elii,","poem":2},{"lineBreak":true},{"text":"ani kolbaa takka isin irratti hin kaasa;","poem":2},{"lineBreak":true},{"text":"kolbaan sunille gara Kaabaatiin","poem":2},{"lineBreak":true},{"text":"seensuma qachaa Haamaatii irraa jalqaddee,","poem":2},{"lineBreak":true},{"text":"gara kibbaatiin haga dhooqa Arabaatitti isin hin cunqursiti» jedha.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Dalaqiis: Yookiin bashannaniis yookiin ashalaqiis","reference":{"chapter":6,"verse":7}},{"noteId":5,"caller":"+","text":"Lobdaar: Afaan Ibrootaatiin Waan bu'aa hin qanne jechu'u.","reference":{"chapter":6,"verse":13}},{"noteId":6,"caller":"+","text":"Karnaayim: Afaan Ibrootaatiin Gaafa jechu'u.","reference":{"chapter":6,"verse":13}}]},"thisChapterLink":"/api/gax_twf/AMO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/AMO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/AMO/5.json","previousChapterAudioLinks":{},"numberOfVerses":14}