{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"AMO","translationId":"gax_twf","name":"Amosii Raagichaa","commonName":"Amosii Raagichaa","title":"Kitaaba Amosii Raagichaa","order":30,"numberOfChapters":9,"sha256":"b7c3b8ffb5d313ba6d2de0aaadbff09375a8d5a37f45a24824821c76cb56db6f","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gax_twf/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":7,"content":[{"type":"heading","content":["Awwaannisa, Ibiddaa Fi Tumbii"]},{"type":"verse","number":1,"content":[{"text":"Kun waan Goottaan Mootiin Waan Maraa natti mudhise:","poem":1},{"text":"Midhaan mootichaa haammamee galeen duuba,","poem":2},{"lineBreak":true},{"text":"haaga'een yennaa lattu","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa awwaannisa buuse.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Awwaannisi marra lafa irraa nyaatee yennaa fixe,","poem":1},{"text":"ani, «Ee Gootta'a Mootii Waan Maraa,","poem":2},{"lineBreak":true},{"text":"maganne'e Israa'eliif araaram;","poem":2},{"lineBreak":true},{"text":"Israa'el hunna waan hin qanneef,","poem":2},{"lineBreak":true},{"text":"attam waan kana irraa hafuu dandeetti ree?» jedhee daadimadhe.","poem":2}]},{"type":"verse","number":3,"content":["Maarre Mootii Waan Maraa marroo waan kanaa gaabbee,",{"text":"«Tun hin teetu» jedhe.","poem":2}]},{"type":"heading","content":["Mudhii Ibiddaa"]},{"type":"verse","number":4,"content":["Tun waan Goottaan Mootiin Waan Maraa natti mudhise: Goottaan Mootiin Waan Maraa ibidda mura'aa waame; ibiddi sun abbaayaa qile'ee gossee lafa luxub godhe."]},{"type":"verse","number":5,"content":["Achiin duuba ani, «Ee Gootta'a Mootiin Waan Maraa,",{"text":"ibidda kana akka dhaamu godhi;","poem":2},{"lineBreak":true},{"text":"Israa'el hunna waan hin qanneef,","poem":2},{"lineBreak":true},{"text":"attam ibidda kana irraa hafuu dandeetti ree?» jedhee daadimadhe.","poem":2}]},{"type":"verse","number":6,"content":["Maarre Mootiin Waan Maraa",{"text":"marroo waan kanaa gaabbee, «Tun hin teetu» jedhe.","poem":2}]},{"type":"heading","content":["Mudhii Tumbi'ii"]},{"type":"verse","number":7,"content":[{"text":"Mootiin Waan Maraa mudhii dhibii natti mudhise:","poem":1},{"text":"Kunoo Mootiin Waan Maraa tumbii qabatee,","poem":2},{"lineBreak":true},{"text":"dalleya dhaka'aa ka tumbi'iin qajeelfame","poem":2},{"lineBreak":true},{"text":"ijaarsa bira dhaabbateeraayyu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inni anaan, «Amos!","poem":1},{"text":"Maan dhaggiisatti jirta?» jedhee na gaafate.","poem":2},{"lineBreak":true},{"text":"Anille, «Tumbii dhaggiisatti jira» jedheen.","poem":2},{"text":"Achiin duuba Mootiin Waan Maraa,","poem":1},{"text":"«Kunoo, ani tumbii kolbaa tiyya Israa'el odduu hin keya;","poem":2},{"lineBreak":true},{"text":"haganaa achi ani adoo isaan hin adabin","poem":2},{"lineBreak":true},{"text":"irra hin dabaru.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Addeen waaqonfanna'aa ta Yisihaqii hin baddi;","poem":1},{"text":"addeen woyyittiin Israa'eliille hin diiganti;","poem":2},{"lineBreak":true},{"text":"sanyii Yerobi'aamii mootichaa irratti","poem":2},{"lineBreak":true},{"text":"ani shallaagaa kiyyaan hin ka'a» jedhe.","poem":2}]},{"type":"heading","content":["Amosii fi Amaasiyaas"]},{"type":"verse","number":10,"content":[{"text":"Achiin duuba hayyichi Bet'elii Amaasiyaas,","poem":1},{"text":"gara Yerobi'aamii mootii Israa'elii ergaa ergee,","poem":2},{"lineBreak":true},{"text":"«Kunoo Amos kolbaa Israa'elii oddu'utti","poem":2},{"lineBreak":true},{"text":"mala si'itti dhowiisatti jira;","poem":2},{"lineBreak":true},{"text":"waan inni dubbatiisa jiru","poem":2},{"lineBreak":true},{"text":"latti tun ba'atiisa hin dandeettu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inni, ‹Yerobi'aam shallaaga'aan hin du'a;","poem":1},{"text":"kolbaan Israa'eliille dhugumaan biyya ifiitii","poem":2},{"lineBreak":true},{"text":"booji'antee hin ideenti› jedha» jedheen.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Achiin duuba Amaasiyaas Amosiin,","poem":1},{"text":"«Ee ati nama mudhii dhaggitu,","poem":2},{"lineBreak":true},{"text":"gara biyya Yihuda'aa baqadhuu asii deemi;","poem":2},{"lineBreak":true},{"text":"achitti raaga dubbataa,","poem":2},{"lineBreak":true},{"text":"sagalee ittiin nyaadhu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bet'el addee woyyittii mootichi itti sagadu,","poem":1},{"text":"Galma Waaqaa ka mootumma'aa waan teeteef,","poem":2},{"lineBreak":true},{"text":"addee tanatti deebitee raaga hin dubbatin» jedheen.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Amosille deebisee Amaasiyaasiin,","poem":1},{"text":"«Ani nama horii tissaa,","poem":2},{"lineBreak":true},{"text":"muka harru'uulle kunuunsu malee","poem":2},{"lineBreak":true},{"text":"raagichaa moti","poem":2},{"lineBreak":true},{"text":"yookiin ilma raagichaalle'ee moti.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mootiin Waan Maraa ammoo","poem":1},{"text":"addee ani horii tissuu na fuudhee,","poem":2},{"lineBreak":true},{"text":"‹Dhaqiitii kolbaa tiyya Israa'elitti","poem":2},{"lineBreak":true},{"text":"raaga dubbadhu› naan jedhe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ammalle ati","poem":1},{"text":"jecha Mootii Waan Maraa dhage'i;","poem":2},{"lineBreak":true},{"text":"ati, ‹Israa'el irratti raaga hin dubbatin;","poem":2},{"lineBreak":true},{"text":"kolbaa Israa'elii","poem":2},{"lineBreak":true},{"text":"sanyii Yisihaqiititti hin lallabin!›","poem":2},{"lineBreak":true},{"text":"naan jetteerta.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tanaaf, Mootiin Waan Maraa,","poem":1},{"text":"‹Haati manaa teeti qachaa keessatti","poem":2},{"lineBreak":true},{"text":"sagaagaltittii hin teeti;","poem":2},{"lineBreak":true},{"text":"ilmaan teetii fi durri teeti","poem":2},{"lineBreak":true},{"text":"shallaaga'aan hin du'an.","poem":2},{"text":"Lafa teeti wodaro'oon mikanee hin qoodaman;","poem":1},{"text":"atille lafa worra Yihudoota hin te'inii keessatti hin duuta;","poem":2},{"lineBreak":true},{"text":"kolbaan Israa'eliille dhugumaan biyya ifiitii booji'antee","poem":2},{"lineBreak":true},{"text":"hin ideenti› jedha» jedhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/AMO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/AMO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/AMO/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}