{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"AMO","translationId":"gax_twf","name":"Amosii Raagichaa","commonName":"Amosii Raagichaa","title":"Kitaaba Amosii Raagichaa","order":30,"numberOfChapters":9,"sha256":"b7c3b8ffb5d313ba6d2de0aaadbff09375a8d5a37f45a24824821c76cb56db6f","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gax_twf/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":8,"content":[{"type":"heading","content":["Saaxaraa Midhaan Bilchaate Keessa Jiru"]},{"type":"verse","number":1,"content":[{"text":"Goottaan, Mootiin Waan Maraa,","poem":1},{"text":"mudhii dhibii natti mudhisee","poem":2},{"lineBreak":true},{"text":"kollonjoo midhaan bilchaate keessa jiru takka dhagge.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inni, «Ee Amos maan dhaggiisatti jirta?» naan jedhe;","poem":1},{"text":"anille deebisee, «Kollonjoo midhaan bilchaate keessa jiru takka» jedheen.","poem":2},{"text":"Achiin duuba Mootiin Waan Maraa,","poem":1},{"text":"«Kolbaan tiyya Israa'el dhumatiisa geetteerti;","poem":2},{"lineBreak":true},{"text":"haganaa achi ani adoo isaan hin adabin irra hin dabaru.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Faaruun Galma Waaqaa keessaa","poem":1},{"text":"gara bowaa hin jijjiiranitti;","poem":2},{"lineBreak":true},{"text":"reeffi namaa hin bacata;","poem":2},{"lineBreak":true},{"text":"addee maralle'etti hin gatama.","poem":2},{"lineBreak":true},{"text":"Cadhi hin jedhan» naan jedhe.","poem":2}]},{"type":"heading","content":["Jinnana Israa'elii"]},{"type":"verse","number":4,"content":[{"text":"Isin rakkataa irra worri sirbitanu,","poem":1},{"text":"hiyyeeyyii lafa irraa worri balleessitanu,","poem":2},{"lineBreak":true},{"text":"tana dhage'a'a!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isin, «Midhaan akka gurgurannuuf,","poem":1},{"text":"jilti baatii ji'aa yoom dabarti?","poem":2},{"lineBreak":true},{"text":"Qamadii dikkoo akka geeffannuuf,","poem":2},{"lineBreak":true},{"text":"waan itti safarru diqqeessinee","poem":2},{"lineBreak":true},{"text":"gatii guddo'otti akka gurguranu,","poem":2},{"lineBreak":true},{"text":"madaallii sobaalle'een","poem":2},{"lineBreak":true},{"text":"midhaan akka gurgurannu","poem":2},{"lineBreak":true},{"text":"Sanbati yoom dabara?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Silaa worra hiyyeeyyii meeti'iin,","poem":1},{"text":"worra rakkataa kophee miilaatiin","poem":2},{"lineBreak":true},{"text":"hin bitannaayyu.","poem":2},{"text":"Qamadii huura qaddulle","poem":1},{"text":"hin gurgurannaayyu» jettan.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"ulfinna ifii ka Yaaqoobiin jajatuun kakatee,","poem":2},{"lineBreak":true},{"text":"«Ani hujii isaan hujane mara hin dedhu» jedheera.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Waan kanaan latti tachootee,","poem":1},{"text":"worri isii keessa le'u marti hin bowanuu ree?","poem":2},{"text":"Latti duudiin akka Laga Nayilii ol kaatee,","poem":1},{"text":"akka bisaan laga Gibxi'ii","poem":2},{"lineBreak":true},{"text":"ol faca'ee gad deebi'u hin teetuu ree?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Goottaan Mootiin Waan Maraa,","poem":1},{"text":"«Guyyaa san aduun saatii jaatti","poem":2},{"lineBreak":true},{"text":"akka seentu hin godha;","poem":2},{"lineBreak":true},{"text":"ifa guyya'aa keessa","poem":2},{"lineBreak":true},{"text":"latti akka dukkanoottu hin godha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Jila teessan ta wogga'aa gara gaddaatitti,","poem":1},{"text":"faaruun teessan gara bowaatitti hin jijjiira.","poem":2},{"text":"Ani akka isin woyaa gaddaa uffattanu,","poem":1},{"text":"mataa keessanille akka haadattanu hin godha.","poem":2},{"text":"Akka bowa worra ilmi tokkochi qabanu irraa du'ee,","poem":1},{"text":"dhuma guyyaa sanii ka hadhowe hin godha» jedheera.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Goottaan Mootiin Waan Maraa,","poem":1},{"text":"«Kunoo barri ani lafa tana irratti beela fidu hin dhufa;","poem":2},{"lineBreak":true},{"text":"beelti sun ta namooti jecha Mootii Waan Maraa","poem":2},{"lineBreak":true},{"text":"dhage'iisa dhabanee beelotanu malee,","poem":2},{"lineBreak":true},{"text":"beela sagale'ee yookiin dheebuu bisaaniitii moti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Namooti jecha Mootii Waan Maraa barbaadatiisaaf,","poem":1},{"text":"abbaayaa takka irraa gara abbaayaa taanii,","poem":2},{"lineBreak":true},{"text":"kaaba irraa gara kibbaa hin joonjan;","poem":2},{"lineBreak":true},{"text":"isaan ammoo isa hin dhagganu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Bara san durri shashaggoole'ee fi","poem":1},{"text":"dhiirti dargaggooti jajjab dheebotanee hin gaggaban.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Worri waaqa dharaa ka Samaariyaa keessaatiin kakatu,","poem":1},{"text":"yookiin ka, ‹Ee, Daan","poem":2},{"noteId":7},{"text":", dhugaa waaqa jiraata keetii› jedhu","poem":2},{"lineBreak":true},{"text":"yookiin ka, ‹Dhugaa waaqa Bersheeba'aa› jedhu,","poem":2},{"lineBreak":true},{"text":"isaan hin jigan; deebi'aneelle hin ka'anu» jedha.","poem":2}]}],"footnotes":[{"noteId":7,"caller":"+","text":"Daan: Addee kolbaan Israa'elii waaqa dharaa ka jabbii worqii irraa hujante itti waaqonfattu.","reference":{"chapter":8,"verse":14}}]},"thisChapterLink":"/api/gax_twf/AMO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/AMO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/AMO/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}