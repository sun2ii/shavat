{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"AMO","translationId":"gax_twf","name":"Amosii Raagichaa","commonName":"Amosii Raagichaa","title":"Kitaaba Amosii Raagichaa","order":30,"numberOfChapters":9,"sha256":"b7c3b8ffb5d313ba6d2de0aaadbff09375a8d5a37f45a24824821c76cb56db6f","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gax_twf/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":9,"content":[{"type":"heading","content":["Badii Israa'elii"]},{"type":"verse","number":1,"content":[{"text":"Ani Goottaan addee ciinca'aa bira dhaabbateeruun dhagge;","poem":1},{"text":"innille, «Hundeen akka raafamu","poem":2},{"lineBreak":true},{"text":"guutuu utuboota Galma Waaqaa dhowiitii","poem":2},{"lineBreak":true},{"text":"mataa namootaa irratti caccassi.","poem":2},{"text":"Worra kana irraa hafane ani shallaaga'aan hin ijjeesa;","poem":1},{"text":"isaan keessaa eennulle dande'ee hin dheetu;","poem":2},{"lineBreak":true},{"text":"ka jalaa miliqu hin jiru.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isaan qotatanee gara qilee addee worri du'e jiruulle","poem":1},{"text":"yoo gad bu'ane,","poem":2},{"lineBreak":true},{"text":"harki kiyya achi keessaa isaan hin baasa;","poem":2},{"lineBreak":true},{"text":"gara ol-gubba'aa yoo bayanelle,","poem":2},{"lineBreak":true},{"text":"ani achille'ee gad isaan hin buusa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gaara Qarmelosii gubba'atti yoo dhokatanelle,","poem":1},{"text":"ani achi irra isaan barbaadee","poem":2},{"lineBreak":true},{"text":"qabee gad isaan hin buusa.","poem":2},{"lineBreak":true},{"text":"Abbaayaa jalatti yoo na dhokatanelle,","poem":2},{"lineBreak":true},{"text":"achitti dhudhuufaan akka isaan iddu hin ajaja.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Booji'amanee diinota ifiitiin yoo deemanelle,","poem":1},{"text":"achitti isaan qaliisaaf shallaagaa hin ajaja;","poem":2},{"lineBreak":true},{"text":"dansa'aaf adoo hin te'in,","poem":2},{"lineBreak":true},{"text":"ila hantu'uun isaan hin ilaala» jedha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Goottaan Mootiin Waan Maraa Ka Waan Mara Dande'u,","poem":1},{"text":"lafa hin tuqa;","poem":2},{"lineBreak":true},{"text":"isiin hin baxxi;","poem":2},{"lineBreak":true},{"text":"worri isii irra le'u marti hin bowa;","poem":2},{"lineBreak":true},{"text":"latti marti akka Laga Nayilii ol hin kaati;","poem":2},{"lineBreak":true},{"text":"achiin duuba akka bisaan laga Gibxi'ii gad deebiti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ka mana ifii ol-gubba'atti ijaare,","poem":1},{"text":"hundee mana sanii lafa irratti ka hundeesse,","poem":2},{"lineBreak":true},{"text":"ka bisaan abbaaya'aa waamee,","poem":2},{"lineBreak":true},{"text":"lafatti lolaasu","poem":2},{"lineBreak":true},{"text":"maqaan isaa Mootii Waan Maraa ti.","poem":2}]},{"type":"verse","number":7,"content":["Mootiin Waan Maraa, «Ee kolbaa Israa'elii,",{"text":"isin naaf akkuma kolbaa Itoophiya'aatii","poem":2},{"noteId":8},{"text":"motii ree?","poem":2},{"lineBreak":true},{"text":"Ani akkuma Israa'eloota biyya Gibxi'ii keessaa baase,","poem":2},{"lineBreak":true},{"text":"worra Filisxeemotaa biyya Kaftorii keessaa,","poem":2},{"lineBreak":true},{"text":"worra Sooriya'aalle biyya Qiirii keessaa ka baasee motii ree?.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dhugumaan ani Goottaan Mootiin Waan Maraa","poem":1},{"text":"ilti tiyya gara mootummaa Israa'elii cubbaaletti'ii hin ilaalti;","poem":2},{"lineBreak":true},{"text":"lafa irraa isii hin balleessa;","poem":2},{"lineBreak":true},{"text":"te'uu malee baraaree sanyii Yaaqoobii hin balleessu» jedha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"«Kunoo, ani ajaja hin baasa;","poem":1},{"text":"akka midhaan meemme'een meemmessanuu,","poem":2},{"lineBreak":true},{"text":"kolbaa Israa'elii","poem":2},{"lineBreak":true},{"text":"gosa biyya adda addaa oddu'utti hin meemmessa;","poem":2},{"lineBreak":true},{"text":"te'uu malee midhaan tokkolle","poem":2},{"lineBreak":true},{"text":"meemmee keessa dabaree lafa hin bu'u.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kolbaa tiyya keessaa worri cubbaaleyyiin,","poem":1},{"text":"‹Wonni hantuun nu hin dhaqqaddu yookiin nu hin geettu› jedhu marti shallaaga'aan hin du'an.","poem":2}]},{"type":"heading","content":["Kolbaan Israa'elii Adde'etti Hin Deebiti"]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Mootummaan Daawitii","poem":1},{"text":"akka dunkaanii jiddee ti.","poem":2},{"text":"Ani ammoo bara san deebisee isii ol hin kaasa;","poem":1},{"text":"addee isiin ciccitte hin erba;","poem":2},{"lineBreak":true},{"text":"waan bututtelle adde'etti deebisee ijaaree,","poem":2},{"lineBreak":true},{"text":"akkuma isiin dur jirtu hin godha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Achiin duuba Israa'el","poem":1},{"text":"worra biyya Edoomiititti baraaree hafanee fi","poem":2},{"lineBreak":true},{"text":"gosa biyya adda addaa","poem":2},{"lineBreak":true},{"text":"ka maqaa kiyyaan waamamanu","poem":2},{"lineBreak":true},{"text":"mara hin qabatti» jedha Mootiin Waan Maraa","poem":2},{"lineBreak":true},{"text":"ka waan kana akka isiin teetu godhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mootiin Waan Maraa,","poem":1},{"text":"«Barri ka haamu haamee adoo hin fixin,","poem":2},{"lineBreak":true},{"text":"ka qotu dhufu,","poem":2},{"lineBreak":true},{"text":"nami woynii dhaabu dhaabee adoo hin fixin,","poem":2},{"lineBreak":true},{"text":"ka woynii cunfu dhufu hin dhufa.","poem":2},{"text":"Gaarota irraa daadhiin woyni'ii o'ituun hin coccoxxi;","poem":1},{"text":"koobota mara irralle'ee hin lolaati.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ani kolbaa tiyya ta booji'ante Israa'el","poem":1},{"text":"gara lafa isaaniititti hin deebisa;","poem":2},{"lineBreak":true},{"text":"isaan qachaa ifii ka diigame","poem":2},{"lineBreak":true},{"text":"deebisanee ijaaratanee keessa hin le'an.","poem":2},{"text":"Muka woyni'ii dhaabbatanee,","poem":1},{"text":"daadhii woyni'ii irraa hin unan;","poem":2},{"lineBreak":true},{"text":"oorruu adda addaa dhaabbatanee","poem":2},{"lineBreak":true},{"text":"midhaan irraa hin nyaatan.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ani kolbaa tiyya Israa'el","poem":1},{"text":"lafa isaaniititti deebisee isaan hin dhaaba;","poem":2},{"lineBreak":true},{"text":"lafa ani isaanii kenne irraa","poem":2},{"lineBreak":true},{"text":"deebi'anee ijjumaa hin buqqa'anu» jedha","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa Waaqi keessan.","poem":2}]}],"footnotes":[{"noteId":8,"caller":"+","text":"Itoophiyaa: Yaadannoo Dad. 2:13 irratti kenname ilaali.","reference":{"chapter":9,"verse":7}}]},"thisChapterLink":"/api/gax_twf/AMO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/OBA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/AMO/8.json","previousChapterAudioLinks":{},"numberOfVerses":15}