{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"DEU","translationId":"gax_twf","name":"Kitaaba Seera Keessa Deebii","commonName":"Kitaaba Seera Keessa Deebii","title":"Kitaaba Seera Keessa Deebii","order":5,"numberOfChapters":34,"sha256":"69f28b7df15ad67e4178be36ddc81a6cd9835c3c5b0df8f1de9f4a71d7331029","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/gax_twf/DEU/34.json","totalNumberOfVerses":958},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":[{"text":"Ee ol-gubba'a ani hin dubbadha caqasa'a;","poem":1},{"text":"ee lafa atille jecha afaan kiyyaa dhage'i.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Barsiisi kiyya akka bokkeyaa roobuu ti;","poem":1},{"text":"jechi kiyyalle akka fixeensa coccophuu ti.","poem":2},{"text":"Marra quunxu irratti akka tiifu'uu","poem":1},{"text":"lattuu irratti akka bokkeya jaba'aa roobuu ti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ani maqaa Mootii Waan Maraa hin lallaba;","poem":1},{"text":"isinille guddinna Waaqa keennaa leellisa'a!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Inni rassa'a,","poem":1},{"text":"hujiin isaa dhidhinna hin qaddu;","poem":2},{"lineBreak":true},{"text":"karaan isaa marti qajeela'a.","poem":2},{"text":"Inni Waaqa addatamaa hin dokonkorre;","poem":1},{"text":"Waaqa qajeela'a, balcha'alle'e.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isaan isa irratti hantuu waan hujaneef,","poem":1},{"text":"haganaa achi ijoollee isaatii moti;","poem":2},{"lineBreak":true},{"text":"isaan dhaloota jallaameyyi'ii fi micciirama'a.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ee isin kolbaa gowwoole'ee fi qarummaa hin qanne,","poem":1},{"text":"akki isin Mootii Waan Maraatiif deebittanu akkanaa?","poem":2},{"text":"Abbaan keessan ka isin dade,","poem":1},{"text":"ka isin hujee fi ka isin miidhasse isaa motii ree?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Guyyoota durii qaabadha'a;","poem":1},{"text":"woggoota dhaloota heddu'uu hubadha.","poem":2},{"text":"Abbootii teessan gaafadha'a;","poem":1},{"text":"isaanille isinitti hin himan.","poem":2},{"text":"Maanguddoo teessan gaafadha'a;","poem":1},{"text":"isaanille isiniif hin diidessan.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Waaqi Ol-Aanaan gosa biyya adda addaatiif,","poem":1},{"text":"dhaala isaanii yennaa kenne,","poem":2},{"lineBreak":true},{"text":"sanyii namaa mara yennaa addaan baase,","poem":2},{"lineBreak":true},{"text":"akka laakkossa kolbaa Israa'eliititti","poem":2},{"lineBreak":true},{"text":"meessaa gosa biyya adda addaatiif baase.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sababille qoodi Mootii Waan Maraa kolbaa isaa ti;","poem":1},{"text":"Yaaqoob dhaala isaa ti.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Inni lafa goomolee keessa,","poem":1},{"text":"ona gammoojjii qiillee keessatti isa dhagge.","poem":2},{"text":"Inni wontee isaaf te'ee, isa kunuunsee,","poem":1},{"text":"akka gumaa ila ifii isa eege.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inni akka risaa mandhee ifii diigee,","poem":1},{"text":"ilmee ifii irratti gonboobee,","poem":2},{"lineBreak":true},{"text":"koola ifii isaan irratti badhisee,","poem":2},{"lineBreak":true},{"text":"isaan irratti kabbuutii fi","poem":2},{"lineBreak":true},{"text":"koola ifiitiin isaan ba'atuu ti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mootii Waan Maraa qofattuu isa sooresse;","poem":1},{"text":"waaqi ormaa isa woliin hin jiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Inni lafa koobotaa mara akka bulchu isa godhee,","poem":1},{"text":"midhaan ficha'aa isa nyaachise.","poem":2},{"text":"Rassaa keessaa damma isa nyaachisee,","poem":1},{"text":"dhakaa jabaa keessaa zayitii isaaf kenne.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dhadhaa looniitii fi aanan hoole'eetii fi re'e'ee","poem":1},{"text":"cooma buruusoo hoole'ee,","poem":2},{"lineBreak":true},{"text":"ta korbeeyyii hoolee Baashaaniitii fi re'e'ee","poem":2},{"lineBreak":true},{"text":"xaltaa qamadii dansa'aa woliin kenneef;","poem":2},{"lineBreak":true},{"text":"inni daadhii woynii dansa'aalle une.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Yeshuuruun","poem":1},{"noteId":10},{"text":"gabbatee finqile.","poem":2},{"text":"Quufee, furdatee, cululuqe;","poem":1},{"text":"inni Waaqa isa dade lakkisee,","poem":2},{"lineBreak":true},{"text":"rassaa fayyinna ifii tuffate.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Isaan waaqota ormaatiin","poem":1},{"text":"akka hinaafu isa godhanee,","poem":2},{"lineBreak":true},{"text":"battumma'aan isa aarsane.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Isaan durriisota Waaqa hin te'iniif,","poem":1},{"text":"waaqota hin beenneef,","poem":2},{"lineBreak":true},{"text":"waaqota haareya","poem":2},{"lineBreak":true},{"text":"ka abbootiin isaanii hin sodaatiniif","poem":2},{"lineBreak":true},{"text":"ciincaa dhikeessane.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ati rassaa abbaa sii te'e lakkittee,","poem":1},{"text":"Waaqa jiruu sii kenne deete.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ilmaan isaatii fi ijoolleen durraa ta isaa","poem":1},{"text":"waan isa aarsaneef,","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa","poem":2},{"lineBreak":true},{"text":"tana dhaggee isaan tuffate.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Inni, «Ani fuula kiyya","poem":1},{"text":"isaan hin dhoffadha;","poem":2},{"lineBreak":true},{"text":"muummeen isaanii","poem":2},{"lineBreak":true},{"text":"maan akka teetu hin ilaala;","poem":2},{"lineBreak":true},{"text":"isaan dhaloota micciiramaa,","poem":2},{"lineBreak":true},{"text":"ijoollee hin addatanne.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Isaan waan Waaqa hin te'iniin akka","poem":1},{"text":"ani hinaafu na godhanee,","poem":2},{"lineBreak":true},{"text":"waaqota dharaa ifiitiin na aarsane.","poem":2},{"text":"Anille kolbaa tuffatanteen","poem":1},{"text":"akka isaan hinaafanu isaan hin godha;","poem":2},{"lineBreak":true},{"text":"kolbaa hubantii hin qannelle'een","poem":2},{"lineBreak":true},{"text":"isaan hin aarsa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mufii tiyyaan ibiddi waan bobe'eef,","poem":1},{"text":"haga addee worri du'e jiruutitti hin guba.","poem":2},{"text":"Lafaa fi waan isiin baattu hin fixa;","poem":1},{"text":"hundee gaarotaalle hin guba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"«Ani badii isaan irratti hin tuula;","poem":1},{"text":"daaya kiyya isaan irratti hin fixa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ani beela isaan balleessitu","poem":1},{"text":"dhukkuba hamaa isaan fixuu fi","poem":2},{"lineBreak":true},{"text":"balaa isaanitti hin fida;","poem":2},{"lineBreak":true},{"text":"kalaadaa bineensotaa","poem":2},{"lineBreak":true},{"text":"hadhaa dhudhuufa'aa isaanitti hin erga.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Karaa irratti","poem":1},{"text":"shallaagaan ijoollee isaanii hin fixa;","poem":2},{"lineBreak":true},{"text":"mana isaanii keessa bararaqi hin guuta.","poem":2},{"text":"Dargaggootii fi durri,","poem":1},{"text":"annoole'ee fi jaarsoleen hin dhumatan.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ani: Isaan bittinneessee,","poem":1},{"text":"akka nami isaan hin qaabanne","poem":2},{"lineBreak":true},{"text":"hin godha jedheeraayyu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Garuu nyaaphoti isaanii,","poem":1},{"text":"‹Irree teennaan injifanne malee,","poem":2},{"lineBreak":true},{"text":"tana mara Mootiin Waan Maraa hin goone› jedhanee","poem":2},{"lineBreak":true},{"text":"akka hin koorre diinota isaanii yaade.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"«Isaan qarummaa hin qabanu;","poem":1},{"text":"hubantiin isaan keessa hin jirtu.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Isaan adoo qaroolee te'anee jiraatanee,","poem":1},{"text":"tana hubatanee, muummeen isaanii","poem":2},{"lineBreak":true},{"text":"maan akka teetu hin beekaniiyyu.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Rassaan isaanii yoo isaan gurgure malee,","poem":1},{"text":"Mootiin Waan Maraa yoo isaan lakkise malee,","poem":2},{"lineBreak":true},{"text":"attamiin nami tokko nama kuma ari'uu dande'a ree?","poem":2},{"text":"Yookiin attamiin nami kum kudhan nama lama baqata?","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Rassaan isaanii akka rassaa keennaatii moti;","poem":1},{"text":"diinoti keennaayyuu tana hin mormanu.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Muki woynii isaanii woynii Sodoomii irraa","poem":1},{"text":"fichaa Gomora'aa keessaa waan dhufuuf,","poem":2},{"lineBreak":true},{"text":"midhaan woynii isaanii hadhaa qaba;","poem":2},{"lineBreak":true},{"text":"unkuruurri woynii isaanii hin hadhowa.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Daadhiin woynii isaanii","poem":1},{"text":"akka hadhaa dhudhuufa'aatii fi","poem":2},{"lineBreak":true},{"text":"akka hadhaa buutii hantu'uu ti.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Tun na biratti wolitti qabanteertii motii ree?","poem":1},{"text":"Mana kuusa'aa kiyya itti cufee","poem":2},{"lineBreak":true},{"text":"chaappaa itti dhoweeraa motii ree?","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Haluun tiyya; ka haluu bayu ana;","poem":1},{"text":"yennaa miilli isaanii mucucaatutti jira;","poem":2},{"text":"Guyyaan badii isaanii waan dhikaateef,","poem":1},{"text":"muraan ariifattee isaanitti hin dhutti» jedhe.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Garbooleen yookiin ka garboolee hin te'in","poem":1},{"text":"nami tokkolle adoo hin hafin,","poem":2},{"lineBreak":true},{"text":"hunni isaanii akka dhumatte yennaa dhagge,","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa","poem":2},{"lineBreak":true},{"text":"kolbaa ifiitiif hin mura;","poem":2},{"lineBreak":true},{"text":"tajaajiltoota ifiitiifille hin marara.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Inni, «Waaqoti isaanii,","poem":1},{"text":"rassaan isaan itti baqatanu,","poem":2}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"ka cooma ciincaa isaan dhikeessanu nyaatanu,","poem":2},{"lineBreak":true},{"text":"ka kennansa daadhii woynii isaaniille unanu,","poem":2},{"lineBreak":true},{"text":"ka'anee isaan qarqaaranuu ti me!","poem":2},{"lineBreak":true},{"text":"Gollaa isaaniif te'anuu ti me!","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"«Amma ilaala'a; Waaqi anuma;","poem":1},{"text":"ana malee Waaqi dhibiin hin jiru.","poem":2},{"text":"Ani hin ijjeesa; hin jiraachisalle'e;","poem":1},{"text":"ani hin madeessa; hin fayyisalle'e;","poem":2},{"lineBreak":true},{"text":"harka kiyya keessaa ka baasuu dande'u hin jiru.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Ani harka kiyya gara ol-gubba'aa kaasee,","poem":1},{"text":"‹Ani haga bara baraa jiraata'a› jedhee daadimadhe.","poem":2}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Shallaagaa kiyya balaqqisaa qaradhee,","poem":2},{"lineBreak":true},{"text":"harki kiyya mura'aaf yennaa isa qabatu,","poem":2},{"lineBreak":true},{"text":"ani diinota kiyya haluu hin baya;","poem":2},{"lineBreak":true},{"text":"worra na jibbuufille gatii hin kenna.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Daaya kiyya,","poem":1},{"text":"dhiiga mataa sooressitoota diinotaa worra qalameetii fi","poem":2},{"lineBreak":true},{"text":"worra booji'ameetiin hin macheessa;","poem":2},{"lineBreak":true},{"text":"shallaagaan kiyyalle","poem":2},{"lineBreak":true},{"text":"foon diinotaa hin nyaata» hin jedha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Inni dhiiga tajaajiltoota ifii baasee,","poem":1},{"text":"diinota ifiille haluu bayee,","poem":2},{"lineBreak":true},{"text":"kolbaa ifiitii fi lafa ifiitiif","poem":2},{"lineBreak":true},{"text":"gumaa cubbu'uu waan godheef,","poem":2},{"lineBreak":true},{"text":"ee gosa biyya adda addaa","poem":2},{"lineBreak":true},{"text":"kolbaa isaa woliin gammada'a.","poem":2}]},{"type":"verse","number":44,"content":["Muuseen Iyaasuu ilma Nunii woliin dhufee, jecha faaruu tanaa mara kolba'aaf dubbise."]},{"type":"verse","number":45,"content":["Muuseen jecha kana mara kolbaa Israa'elii maraaf dubbisee fixeen duuba,"]},{"type":"verse","number":46,"content":["isaaniin, «Jecha seera kanaa mara, ijoolleen teessan akka dansaa akka eegattu, akka isaan ajajjanu jecha ani adha isinitti himu kana mara gadhaa keessanitti qabadha'a;"]},{"type":"verse","number":47,"content":["jechi kun ka jiruu isiniif kennu malee, ka bu'aa hin qannee moti; jecha kanaan isin laga Yordaanosii gamatti buutanee lafa qabatu'uuf jirtanu keessa bara dheeraa hin leetan» jedhe."]},{"type":"heading","content":["Duuti Muuse'ee Durfamee Himame"]},{"type":"verse","number":48,"content":["Guyyuma san Mootiin Waan Maraa Muuse'een,"]},{"type":"verse","number":49,"content":["«Gaarota Abaariimii keessaa, gara gaara Neboo, ka lafa Mo'aabii ta fuullee Yeriko'oo jirtu keessa jirutti ol bayiitii, lafa Kana'aanii ta ani Israa'elootaaf kennu san ilaali."]},{"type":"verse","number":50,"content":["Akkuma obboleessi keeti Aaron gaara Hoorii irratti du'ee, abbootii ifii ta durii bira dhaqe, atille gaara itti ol baatu san irratti duutee, abbootii teeti ta durii bira hin dhaxxa."]},{"type":"verse","number":51,"content":["Tun isin lamaanuu Israa'eloota duratti bisaan Mariiba'aa ka qachaa Qaadeshii biratti, goomolee Ziinii keessatti waan na yakkitanee fi Israa'eloota oddu'utti woyyummaa tiyya waan hin ulfeessiniif tun teeti."]},{"type":"verse","number":52,"content":["Tanaaf ati lafa san ifiin duratti hin dhaggita malee, lafa ani kolbaa Israa'eliitiif kennu sanitti hin galtu» jedhe."]}],"footnotes":[{"noteId":10,"caller":"+","text":"Yeshuuruun: Afaan Ibrootaatiin qajeelaa jechu'u. Maqaa kolbaan Israa'elii ittiin waamantu.","reference":{"chapter":32,"verse":15}}]},"thisChapterLink":"/api/gax_twf/DEU/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/DEU/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/DEU/31.json","previousChapterAudioLinks":{},"numberOfVerses":52}