{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"DEU","translationId":"gax_twf","name":"Kitaaba Seera Keessa Deebii","commonName":"Kitaaba Seera Keessa Deebii","title":"Kitaaba Seera Keessa Deebii","order":5,"numberOfChapters":34,"sha256":"69f28b7df15ad67e4178be36ddc81a6cd9835c3c5b0df8f1de9f4a71d7331029","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/gax_twf/DEU/34.json","totalNumberOfVerses":958},"chapter":{"number":33,"content":[{"type":"heading","content":["Muuseen Gosoota Israa'elii Eebbise"]},{"type":"verse","number":1,"content":["Nami Waaqaa Muuseen adoo hin du'iniin dura eebbi inni Israa'eloota eebbise ta asii gad jiru."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mootiin Waan Maraa gaara Siina'aa irraa dhufee,","poem":1},{"text":"akka aduu ganamaa Se'iir irraa isaaniif baye;","poem":2},{"lineBreak":true},{"text":"gaara Phaaraanii irralle'ee isaaniif isse;","poem":2},{"lineBreak":true},{"text":"inni ergantoota ifii kumaatama woliin dhufe;","poem":2},{"lineBreak":true},{"text":"midda isaatitti ibiddi gabbatu jiraayyu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dhuguma inni kolbaa ifii hin jaalata;","poem":1},{"text":"woyyooti marti harka isaa","poem":2},{"lineBreak":true},{"text":"keessa jiran.","poem":2},{"text":"Isaan martinuu miila isaa jalatti hin sagadan;","poem":1},{"text":"isa irralle'ee gorsa hin fudhatan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Seerri Muuseen kenne kun,","poem":1},{"text":"qooda wolde'a Yaaqoobii ti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yennaa sooressitooti kolba'aa","poem":1},{"text":"gosa Israa'elii mara woliin wolitti qabamanu,","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa Yeshuuruun irratti mootii te'e.","poem":2}]},{"type":"verse","number":6,"content":["Muuseen marroo gosa Ruubenii dubbatee,",{"text":"«Gosi Ruubenii le'uu ti malee, hin du'in.","poem":2},{"lineBreak":true},{"text":"Laakkossi gosa isaa hin diqqaatin» jedhe.","poem":2}]},{"type":"verse","number":7,"content":["Marroo Yihuda'aa,",{"text":"«Ee Mootii Waan Maraa,","poem":2},{"lineBreak":true},{"text":"iyya gosa Yihuda'aa dhage'i.","poem":2},{"lineBreak":true},{"text":"Gara kolbaa isaanii isaan fidi!","poem":2},{"text":"Harkuma keetiin isaan irraa dhooggi;","poem":1},{"text":"yennaa isaan diinota ifii woliin wol lolanu","poem":2},{"lineBreak":true},{"text":"ati isaan qarqaar» jedhe.","poem":2}]},{"type":"verse","number":8,"content":["Marroo gosa Lewwi'ii,",{"text":"«Uriimii fi Tumiim ta fedhii teeti ittiin beekanu,","poem":2},{"lineBreak":true},{"text":"woyyoota teeti gosa Lewwi'iitiif kenniteerta.","poem":2},{"text":"Ati Maasa'atti haga isaan ilaaltee,","poem":1},{"text":"bisaan Mariibaa biratti isaan woliin mormite.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isaan si'iif jedhanee","poem":1},{"text":"haajaa abba'aa fi haadha ifii lakkisanee,","poem":2},{"lineBreak":true},{"text":"fira ifiitii fi ijoollee ifii dedhane.","poem":2},{"text":"Isaan jecha keetiif ajajamanee,","poem":1},{"text":"gondooroo teeti eegataneeran.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Isaan sirna keeti Yaaqoob","poem":1},{"text":"seera keetille Israa'el hin barsiisan.","poem":2},{"text":"Isaan hixaana si duratti","poem":1},{"text":"kennansa gubamu duudiille","poem":2},{"lineBreak":true},{"text":"addee ciinca'aa keeti irratti hin dhikeessan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ee Mootii Waan Maraa, hunna isaanii eebbis;","poem":1},{"text":"hujii harka isaaniititti gammad.","poem":2},{"text":"Worra isaan irratti ka'u dhowi;","poem":1},{"text":"diinoti isaanii deebi'anee akka hin kaane","poem":2},{"lineBreak":true},{"text":"hidha isaanii kuti» jedhe.","poem":2}]},{"type":"verse","number":12,"content":["Marroo gosa Beniyaamii,",{"text":"«Ka Mootiin Waan Maraa jaalatu,","poem":2},{"lineBreak":true},{"text":"sodaa malee jiraata.","poem":2},{"text":"Inni guyyaa mara itti waan gombobuuf,","poem":1},{"text":"bobaa isaa jala jiraata» jedhe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Marroo gosa Yoseefii,","poem":1},{"lineBreak":true},{"text":"«Mootiin Waan Maraa","poem":1},{"text":"lafa isaanii fixeensa ol gubba'aatiin","poem":2},{"lineBreak":true},{"text":"bisaan lafa gad fagoo keessa jirulle'een,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"midhaan filatamaa adu'uun geyeen,","poem":2},{"lineBreak":true},{"text":"ka dansaa yennaa yenna'aan galfatanuun,","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"waan hedduu dansaa","poem":2},{"lineBreak":true},{"text":"gaara durii irraa dhaggamanuun,","poem":2},{"lineBreak":true},{"text":"waan hedduu dansaa","poem":2},{"lineBreak":true},{"text":"koobota bara baraa irraa dhaggamanulle'een,","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"waan guddoo dansaa latti baattuun,","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa","poem":2},{"lineBreak":true},{"text":"ka haxanxarii bobeettu keessatti dubbateen","poem":2},{"lineBreak":true},{"text":"eebbifantuu ti.","poem":2},{"text":"Tun marti Yoseefii obboleeyyan ifii keessaa","poem":1},{"text":"bulchaa te'eef teetuu ti.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Arnyi Yoseefii akka korma qara dhalatee ti;","poem":1},{"text":"gaafoti isaa akka gaafota gafarsaa ti;","poem":2},{"lineBreak":true},{"text":"gaafota ifii saniin gosa biyya adda addaa","poem":2},{"lineBreak":true},{"text":"haga qaccee lafaatitti hin woraana.","poem":2},{"text":"Efreem ka akkasii kuma kudhan qaba;","poem":1},{"text":"Minaaseelle kuma hedduu qaba» jedhe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Marroo gosa Zebuloonii,","poem":1},{"text":"«Ee Zebuloon, ati bayiisa teetitti,","poem":2},{"lineBreak":true},{"text":"ee Yisaakor, atille","poem":2},{"lineBreak":true},{"text":"dunkaanii teeti keessatti gammadi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Isaan gosa hedduu gara gaaraa hin waaman;","poem":1},{"text":"achitti kennansa balchumma'aa hin dhikeessan.","poem":2},{"text":"Qabeenna abbaaya'aa hin xuuxan;","poem":1},{"text":"karra maansa keessatti dhokatelle hin baafatan» jedhe.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Marroo gosa Gaadii,","poem":1},{"text":"«Waaqi lafa Gaadii badhise ka eebbifame;","poem":2},{"lineBreak":true},{"text":"Isaan akka neenqaa achi le'anee,","poem":2},{"lineBreak":true},{"text":"harkaa fi mataa hin kukkutan.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Qoodi sooressumma'aa isaaniif waan kennameef,","poem":1},{"text":"lafa laayyoo hin filatan.","poem":2},{"text":"Sooreyyiin kolba'aa yennaa wolitti qabamane,","poem":1},{"text":"isaan fedha Mootii Waan Maraa qajeela'aa fi","poem":2},{"lineBreak":true},{"text":"muraa isaa Israa'eliif muummessane» jedhe.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Marroo gosa Daanii,","poem":1},{"text":"«Daan akka ilmoolee neenqaa,","poem":2},{"lineBreak":true},{"text":"ta Baashaan keessaa utaaltuu ti» jedhe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Marroo gosa Niftaalemii,","poem":1},{"text":"«Ee Niftaalem isin Mootii Waan Maraatiin","poem":2},{"lineBreak":true},{"text":"fudhatama guddaa qaddan;","poem":2},{"lineBreak":true},{"text":"eebba isaatille'een guutantaneertan;","poem":2},{"lineBreak":true},{"text":"isin lafa haga kibba abbaayaa Galiila'aa","poem":2},{"lineBreak":true},{"text":"hin qabatan» jedhe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Marroo gosa Asheerii,","poem":1},{"text":"«Gosi Asheerii gosa dhibii caalaa ta eebbifante.","poem":2},{"text":"Obboleeyyan isaanii isaan jaalatanuu ti;","poem":1},{"text":"latti isaanii muka ejersaatiin ta tolte teetuu ti.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Danqaraan karra isaanii","poem":1},{"text":"sibiilaa fi sageettuu teetuu ti;","poem":2},{"lineBreak":true},{"text":"nageenni isaanii bara isaanii woliin qixxawuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"«Ee Yeshuuruun,","poem":1},{"text":"Waaqi akka Waaqa keessanii","poem":2},{"lineBreak":true},{"text":"ka isin qarqaariisaaf ol-gubbaa irra","poem":2},{"lineBreak":true},{"text":"duumensa irralle","poem":2},{"lineBreak":true},{"text":"arnya ifiitiin deemu tokkolle hin jiru.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Waaqi bara baraa addee isin itti baqattanu;","poem":1},{"text":"irreen isaa ta bara baraalle isin utuddi.","poem":2},{"text":"Inni diinota keessan isin duraa ari'aa,","poem":1},{"text":"‹Isaan balleessa'a› hin jedha.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kolbaan Israa'elii qofii ifii","poem":1},{"text":"bidhaa malee jiraatti;","poem":2},{"lineBreak":true},{"text":"sanyiin Yaaqoobiille,","poem":2},{"lineBreak":true},{"text":"lafa midhaaniitii fi daadhii woyni'ii keessa,","poem":2},{"lineBreak":true},{"text":"addee ol-gubbaan fixeensa gad coccossitu keessa","poem":2},{"lineBreak":true},{"text":"nageyaan jiraatti.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ee kolbaa Israa'elii, isin gammada'a!","poem":1},{"text":"Kolbaan akka keessanii","poem":2},{"lineBreak":true},{"text":"ta Mootiin Waan Maraa baase tam?","poem":2},{"text":"Wonte'ee fi qarqaarsi keessan,","poem":1},{"text":"shallaagaan keessan ka ulfinnaalle isa;","poem":2},{"lineBreak":true},{"text":"diinoti keeti si duratti hin hohollatan,","poem":2},{"lineBreak":true},{"text":"isin isaan irra hin sirbitan» jedhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}