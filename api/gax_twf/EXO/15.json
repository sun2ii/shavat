{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"EXO","translationId":"gax_twf","name":"Kitaaba Seera Bayiisaa","commonName":"Kitaaba Seera Bayiisaa","title":"Kitaaba Seera Bayiisaa","order":2,"numberOfChapters":40,"sha256":"5ae892f471e977e10c5357c6d54f9c80a878fdfa0a497863db3dc951095500bd","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/gax_twf/EXO/40.json","totalNumberOfVerses":1212},"chapter":{"number":15,"content":[{"type":"heading","content":["Faaruu Muuse'eetii fi Miiriyamii"]},{"type":"verse","number":1,"content":["Achiin duuba Muuse'ee fi Israa'elooti faaruu asii gad jirtu tana Mootii Waan Maraatiif faarfatanee,",{"text":"«Mootiin Waan Maraa","poem":1},{"text":"abbootii fardaatii fi fardoo isaanii","poem":2},{"lineBreak":true},{"text":"abbaaya'atti naqee,","poem":2},{"lineBreak":true},{"text":"ulfinna waan dhaggateef,","poem":2},{"lineBreak":true},{"text":"ani isaaf hin faarfadha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mootiin Waan Maraa jabeenna naa te'ee,","poem":1},{"text":"akka faarfadhu na tolcheera;","poem":2},{"lineBreak":true},{"text":"inni fayyinna naa te'eera.","poem":2},{"text":"Inni Waaqa kiyya;","poem":1},{"text":"anille isa hin leellifadha;","poem":2},{"lineBreak":true},{"text":"Waaqa abbaa kiyyaa,","poem":2},{"lineBreak":true},{"text":"ani isa hin saadadha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mootiin Waan Maraa lolticha goota;","poem":1},{"text":"Maqaan isaa Mootii Waan Maraa ti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inni garreettaa mootichaa ka fardaan harkifamuu fi","poem":1},{"text":"loltoota isaa abbaaya'atti naqe;","poem":2},{"lineBreak":true},{"text":"qondaaltoti mootichaa worri filamane","poem":2},{"lineBreak":true},{"text":"abbaayaa diintuu keessatti liqinfamane.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bisaan qileen isaan irra garagale;","poem":1},{"text":"akka dhaka'aa abbaaya'atti gad lixane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Ee Mootii Waan Maraa,","poem":1},{"text":"harki keeti middichi,","poem":2},{"lineBreak":true},{"text":"hunnaan arnya qaba.","poem":2},{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"harki keeti middichi diinota butuche.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Guddinna arnya keetiitiin","poem":1},{"text":"worra si mormu balleessite.","poem":2},{"text":"Mufii teeti ta akka ibiddaa bobeettu itti ergitee,","poem":1},{"text":"akka huuraa isaan muxuqi goote.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hafuura funnaan keetiitiin,","poem":1},{"text":"bisaan tuulame.","poem":2},{"text":"Bisaan yaa'u akka dalleya dhaka'aa dhaabbate;","poem":1},{"text":"bisaan qile'ee abbaayaa wodhakka'atti itite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Diinni kooree, ‹Ani isaan hin ari'a;","poem":1},{"text":"isaan hin qaba;","poem":2},{"lineBreak":true},{"text":"booji'ee karra isaanii hin qoodama;","poem":2},{"lineBreak":true},{"text":"waan fedhe mara irraa hin fudhadha.","poem":2},{"text":"Shallaagaa kiyya hin buqqifadha;","poem":1},{"text":"harki kiyyalle isaan hin balleessa› jedhe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ati ammoo hafuura keeti itti baafannaan,","poem":1},{"text":"abbaayaani isaan irra garagaltee,","poem":2},{"lineBreak":true},{"text":"akkuma sibiilaa","poem":2},{"lineBreak":true},{"text":"bisaan jabaa keessatti liqinfamane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Ee Mootii Waan Maraa,","poem":1},{"text":"waaqota keessaa ka akka keetii eennu?","poem":2},{"lineBreak":true},{"text":"Ka arnya woyyumma'aa qabu,","poem":2},{"lineBreak":true},{"text":"ka ulfinnaan sodaatame,","poem":2},{"lineBreak":true},{"text":"ka bilbaasa huju,","poem":2},{"lineBreak":true},{"text":"ka akka keetii eennu?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ati harka keeti middicha diriirsitee,","poem":1},{"text":"latti isaan liqinsite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Ati jaalala keeti ka bara baraatiin","poem":1},{"text":"kolbaa wodatte hin sooressita;","poem":2},{"lineBreak":true},{"text":"jabeenna keetiin gara addee woyyitti'ii","poem":2},{"lineBreak":true},{"text":"isaan hin geessita.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Gosi biyya adda addaa dhageettee hin hollatti;","poem":1},{"text":"worri biyya Filisxeemotaalle hin muddaman.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bulchitooti Edoomii hin bararaqan;","poem":1},{"text":"Sooressitooti Mo'aabii sodaatanee hin romman;","poem":2},{"lineBreak":true},{"text":"kolbaan Kana'aaniille hin sheephitti.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"kolbaa teetiif haga dabartutti","poem":2},{"lineBreak":true},{"text":"kolbaan ati wodatte haga dabartutti","poem":2},{"lineBreak":true},{"text":"hunna irree teetiitiin","poem":2},{"lineBreak":true},{"text":"isaan akka dhaka'aa hin cadhisan;","poem":2},{"lineBreak":true},{"text":"bararaqii fi naasuun isaanitti hin buuti.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ee Mootii Waan Maraa, addee woyyittii teetitti","poem":1},{"lineBreak":true},{"text":"Ee Gootta'a, addee harki keeti ijaare sanitti","poem":1},{"text":"isaan galchitee,","poem":2},{"lineBreak":true},{"text":"lafa teeti kooba gubbaa irratti","poem":2},{"lineBreak":true},{"text":"isaan hin qubachiitta.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"haga bara baraa hin bulcha» jedhane.","poem":2}]},{"type":"heading","content":["Faaruu Miiriyamii"]},{"type":"verse","number":19,"content":["Fardoon, garreettaan fardaan harkifamuu fi abbootii fardaa ta mootichaa abbaayaa keessa yennaa timane, Mootiin Waan Maraa bisaan abbaaya'aa isaan irra garagalchee, Israa'elooti ammoo abbaayaa keessa lafa godduu irra ideemanee qaxxaamurane."]},{"type":"verse","number":20,"content":["Achiin duuba Miiriyamiin raagittiin, obboleettiin Aaronii, dibbee fudhattee baatee, dubartooti martinuu dibbee dhowaa, sirbaa isii gula yaa'ane."]},{"type":"verse","number":21,"content":["Miiriyamille, faarfattee, isaaniin",{"text":"«Inni akka malee waan saadameef,","poem":1},{"text":"Mootii Waan Maraatiif faarfadha'a.","poem":2},{"text":"Inni fardo'oo fi abbootii fardo'oo","poem":1},{"text":"abbaaya'atti naqeera» jette.","poem":2}]},{"type":"heading","content":["Bisaan Hadhowu"]},{"type":"verse","number":22,"content":["Achiin duuba Muuseen kolbaa Israa'elii abbaayaa diintu'uu kaasee, gara lafa goomole'ee Shuur geesse. Isaan guyyaa sad bisaan adoo hin dhaggatin goomolee keessa deemane."]},{"type":"verse","number":23,"content":["Isaan yennaa gara Maaraa dhufane, bisaan Maaraa sun waan hadhowuuf, uniisa hin dandeenne. Tanaaf maqaan addee sanii, «Maaraa",{"noteId":9},"» jedhame."]},{"type":"verse","number":24,"content":["Maarre kolbaan, «Maan unna?» jettee Muuse'etti gungunte."]},{"type":"verse","number":25,"content":["Achiin duuba Muuseen gara Mootii Waan Maraa iyyee, Mootiin Waan Maraa muka tokko itti mudhise; innille muka san bisaanitti qolaansee, bisaan sun tole. Achitti Mootiin Waan Maraa seerataa fi seera isaaniif kennee, achumatti haga isaan ilaale."]},{"type":"verse","number":26,"content":["Inni, isaaniin, «Isin qoonqoo ana Mootii Waan Maraa ta Waaqa keessanii miidhassitanee yoo caqattane, fuula kiyya duratti waan sirrii te'e yoo tolchitane, ajaja kiyya yoo qalbeeffattane, seerata kiyya maralle yoo eegattane, dhukkuba worra Gibxi'iititti fide mara tokkolle isinitti hin fidu; ani Mootii Waan Maraa ka isin fayyisu» jedhe."]},{"type":"verse","number":27,"content":["Achiin duuba isaan Eliim addee maddi kudhanii lamaa fi muki meexxi'ii torbaatam jiru dhufanee, achi bisaan bira qubatane."]}],"footnotes":[{"noteId":9,"caller":"+","text":"Maaraa: Afaan Ibrootaatiin hadhowaa jechu'u.","reference":{"chapter":15,"verse":23}}]},"thisChapterLink":"/api/gax_twf/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}