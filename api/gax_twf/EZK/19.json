{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"EZK","translationId":"gax_twf","name":"Hizqi'elii Raagichaa","commonName":"Hizqi'elii Raagichaa","title":"Kitaaba Hizqi'elii Raagichaa","order":26,"numberOfChapters":48,"sha256":"80309f2c034f4b0330b7ac25c7b841ed7e42be16496620a4e4944f1e87a048c0","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/gax_twf/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":19,"content":[{"type":"heading","content":["Faaruu Gaddaa"]},{"type":"verse","number":1,"content":["«Faaruu gaddaa qondaaltota Israa'eliitiif faarsa'aatii:"]},{"type":"verse","number":2,"content":[{"text":"«‹Haati teeti neenqota keessaa neenqa dhalaa attamii ti!","poem":1},{"text":"Isiin neenqota dardara odduu ciittee,","poem":2},{"lineBreak":true},{"text":"ilmoolee ifii guddifatte.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isiin ilmoolee ifii keessaa tokkocha guddifatte;","poem":1},{"text":"innille neenqa dardara te'e;","poem":2},{"lineBreak":true},{"text":"adansee qabatiisa baratee, nama nyaate.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gosi biyya adda addaa marroo isaa dhageette;","poem":1},{"text":"inni boolla isaan qotane keessa seenee qabame;","poem":2},{"text":"Isaanille hookkoo itti keyanee","poem":1},{"text":"harkisanee gara biyya Gibxi'ii geessane.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Addiin isi'ii bu'aa akka hin qanne,","poem":1},{"text":"wonni isiin eegatte akka isi'ii hin teene yennaa dhaggite,","poem":2},{"lineBreak":true},{"text":"ilmoolee ifii keessaa ka dhibii fuutee guddittee,","poem":2},{"lineBreak":true},{"text":"neenqa dardara goote.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Innille odduu neenqotaa asii fi achi ideeme;","poem":1},{"text":"neenqa dardara te'ee","poem":2},{"lineBreak":true},{"text":"adansee qabatiisa baratee, nama nyaate.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni kushee isaanii jadduu caccassee","poem":1},{"text":"qachaa isaanii balleesse; lattii fi wonni isii keessaa marti","poem":2},{"lineBreak":true},{"text":"dhangaa inni dhowuun sheephitte.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Achiin duuba gosi biyya adda addaa","poem":1},{"text":"karaa maraan isatti kaate;","poem":2},{"lineBreak":true},{"text":"isaan caccoo ifii isa irratti afanee,","poem":2},{"lineBreak":true},{"text":"inni boolla isaan qotane keessa seenee qabame.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hookko'oon harkisanee gooree sibiilaa keessa keyanee","poem":1},{"text":"gara mootii Baabilonii geessane.","poem":2},{"text":"Dhangaan inni dhowu","poem":1},{"text":"gaarota Israa'elii irratti","poem":2},{"lineBreak":true},{"text":"deebi'ee akka hin dhage'ane","poem":2},{"lineBreak":true},{"text":"addee inni itti hidhamee eegamu keessa buusane.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Haati teeti muka woyni'ii","poem":1},{"text":"ka bisaan qarqaratti dhaabane,","poem":2},{"lineBreak":true},{"text":"ka sababa bisaan guddaa saniitiif","poem":2},{"lineBreak":true},{"text":"midhaan bacaa buusee banqaaqe fakkaatti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dameeleen isaa jajjabaattee,","poem":1},{"text":"ulee bokku'uu ta bulchitootaa teete.","poem":2},{"text":"Hojjaan isaatii fi dameeleen isaa bacaan,","poem":1},{"text":"ciggaa keessaa ol dheeratanee mudhatane.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Te'uu malee aari'iin buqqifamee lafatti gatame;","poem":1},{"text":"qilleensi goomole'ee ka karaa aduun baatuu","poem":2},{"lineBreak":true},{"text":"midhaan isaa qoorsee, irraa lafatti harcaasee goggosse;","poem":2},{"lineBreak":true},{"text":"dameelee isaa jajjadduu sanille ibiddi nyaate.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Amma muki woyni'ii goomolee keessa","poem":1},{"text":"addee bisaan hin jirre lafa goddu'utti dhaabame.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Qaccee damee muka woyni'ii guddittii keessaa","poem":1},{"text":"ibiddi bayee midhaan isaa mara nyaate;","poem":2},{"lineBreak":true},{"text":"dameen jadduun ulee bokku'uu ta bulchitootaa teetu,","poem":2},{"lineBreak":true},{"text":"ijjumaa irratti hin hanne› jedhi.","poem":2},{"text":"Tun faaruu gaddaa,","poem":1},{"text":"ta yennaa gaddaa faarfatanu» jedhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}