{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"GEN","translationId":"gax_twf","name":"Kitaaba Seera Dadaa","commonName":"Kitaaba Seera Dadaa","title":"Kitaaba Seera Dadaa","order":1,"numberOfChapters":50,"sha256":"c3a1f0d6c3563d935755539d5e240860968ad854a98677cc269b8db25d10b253","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/gax_twf/GEN/50.json","totalNumberOfVerses":1533},"chapter":{"number":49,"content":[{"type":"heading","content":["Jecha Yaaqoob Muummee Irratti Ilmaan Ifiititti Dubbate"]},{"type":"verse","number":1,"content":["Achiin duuba Yaaqoob ilmaan ifii waammatee, «Waan gara duraa isinitti dhufu akka isinitti himuuf, wolitti dacha'a'a!"]},{"type":"verse","number":2,"content":[{"text":"«Ilmaan Yaaqoobii, wolitti dacha'a'aa dhage'a'a;","poem":1},{"text":"abbaa keessan Yaaqoob dhage'a'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«Ruuben, ati ilma kiyya angaficha,","poem":1},{"text":"hunna tiyyaa fi jabeenna kiyya ka qaraa ti;","poem":2},{"lineBreak":true},{"text":"ulfinnaa fi hunnaan ilmaan tiyya mara hin caalta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Te'uu malee, ati ka akka bisaanii daaquu waan teeteef,","poem":1},{"text":"obboleeyyan teeti hin sooressitu;","poem":2},{"lineBreak":true},{"text":"rifanoo abbaa keetii irra waan baateef,","poem":2},{"lineBreak":true},{"text":"dubartoota gursumeeyyii abbaa keetii woliin ratteerta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Shimi'oonii fi Lewwiin obboleeyyan;","poem":1},{"text":"shallaagaan isaanii","poem":2},{"lineBreak":true},{"text":"meya isaan hunnaan nama irratti ka'anu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isaan aari'iin namoota waan ijjeesaneef,","poem":1},{"text":"taphaaf jedhanee korommii waan mogolchaneef,","poem":2},{"lineBreak":true},{"text":"ani marii isaaniititti hin galu;","poem":2},{"lineBreak":true},{"text":"yaa'ii isaaniille hin qoodamu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Aariin isaanii jadduu,","poem":1},{"text":"mufiin isaanii gadhi-jabeettii waan teeteef,","poem":2},{"lineBreak":true},{"text":"ta abaarante teetuu ti!","poem":2},{"text":"Ani gosa Yaaqoobii odduu isaan qoqoodee","poem":1},{"text":"Israa'el keessa isaan hin bittinneessa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Yihuda'a, obboleeyyan teeti si hin leellisan;","poem":1},{"text":"ati diina keeti hin injifatta;","poem":2},{"lineBreak":true},{"text":"ilmaan abbaa keetii si duratti gad hin jedhan.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ilmi kiyya Yihudaan akka ilmee neenqaa,","poem":1},{"text":"ta adamo'oo gara mandhee ifii deebituu ti.","poem":2},{"text":"Akka neenqaa diriirfatee irkata;","poem":1},{"text":"eentu isa kaasiisaaf itti guula?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ka kolbaan duudiin ajajantuuf,","poem":1},{"text":"haga bara baraa ka bulchu,","poem":2},{"lineBreak":true},{"text":"ka mootummaan isaaf malte, haga dhufutti,","poem":2},{"lineBreak":true},{"text":"bokkuun harka Yihuda'aatii hin baatu.","poem":2},{"text":"Mootoleen maatii Yihuda'aa irraa hin dhufan;","poem":1},{"text":"nami tokko Yihudaa irraa yennaa mara","poem":2},{"lineBreak":true},{"text":"barcumaa mootumma'aa irra hin tee'a.","poem":2},{"text":"Ka mootummaan isaaf malte haga dhufutti","poem":1},{"text":"Yihudaan hin bulcha;","poem":2},{"lineBreak":true},{"text":"gosi biyya adda addaalle isaaf hin ajajaman.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inni woynii bacaa qaba;","poem":1},{"text":"harree ifii muka woyni'iititti,","poem":2},{"lineBreak":true},{"text":"ilmayyoo harree ifii woynii filatantetti hidhata.","poem":2},{"text":"Inni woyaa ifii daadhii woyni'iitiin,","poem":1},{"text":"bullukkoo ifii dhiiga midhaan woyni'iitiin dhiqata.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ilti isaa daadhii woyni'ii caalaa diimatti;","poem":1},{"text":"ilkaan isaa aanan caalaa addaata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Zebuloon qarqara abbaaya'aa hin le'a;","poem":1},{"text":"qarqarri abbaaya'aa ka isaa sun","poem":2},{"lineBreak":true},{"text":"lafa buufata hoboloota gugurddo'oo hin te'a.","poem":2},{"lineBreak":true},{"text":"Meessaan lafa isaa Sidoon hin te'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Yisaakor akka harree jadduu,","poem":1},{"text":"wodhakkaa fe'iisaa ciittuu ti.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ammoo addeen isaa ta fooraa dansaa,","poem":1},{"text":"latti isaalle","poem":2},{"lineBreak":true},{"text":"attam akka gammachiittu yennaa dhagge,","poem":2},{"lineBreak":true},{"text":"fe'amiisaaf dudda ifii cillaaffatee garba te'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«Daan kolbaa ifii","poem":1},{"text":"gosa Israa'elii keessaa takkattii hin bulcha.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Daan akka dhudhuufaa karaa irgaa,","poem":1},{"text":"akka buutii daandii cina'aa,","poem":2},{"lineBreak":true},{"text":"ta kottee fardaa idditee","poem":2},{"lineBreak":true},{"text":"nama irra tee'eeru irraa buuttuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«Ee Mootii Waan Maraa,","poem":1},{"text":"ani fayyisiisa keeti eegadha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«Saantuun Gaad hin miiti;","poem":1},{"text":"inni ammoo deebisee isaan hin miidha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«Latti Asheerii sagalee dansaa bacaa kenniti.","poem":1},{"text":"Inni sagalee mootichaaf teetu hin kenna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«Naftaalem akka ilmee dansaa gadansaa bilisa;","poem":1},{"text":"inni jechoota dadansaa dubbata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Yoseef akka muka woyni'ii midhaanicha,","poem":1},{"text":"madda bira jiru,","poem":2},{"lineBreak":true},{"text":"ka dameen dalleya irra baatuu ti.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Worri daaya qabatu isa duchiisanee,","poem":1},{"text":"diinumma'aan daaya itti gad lakkisan.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ammoo hunna Waaqa Yaaqoobiitiin,","poem":1},{"text":"maqaa tissee jabaa Israa'eliitiin,","poem":2},{"lineBreak":true},{"text":"guubeen isaatii fi irreen isaa hin jabaatti.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Waaqi abbaa keetii ka si qarqaaru,","poem":1},{"text":"Waaqi waan mara dande'u,","poem":2},{"lineBreak":true},{"text":"rooba gubba'aatiin,","poem":2},{"lineBreak":true},{"text":"madda golbaatiin,","poem":2},{"lineBreak":true},{"text":"horii heddu'uu fi","poem":2},{"lineBreak":true},{"text":"ijoollee hedduu kenniisaan si eebbisu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Eebbi abbaa keetii","poem":1},{"text":"waan eebba gaarota bara duriitii jalqabanee jiranuu fi","poem":2},{"lineBreak":true},{"text":"kooba bara baraa irraa dhagganu caala.","poem":2},{"text":"Eebbi kun marti mataa Yoseefii,","poem":1},{"text":"ka obboleeyyan ifii irraa adda baye","poem":2},{"lineBreak":true},{"text":"surrii isaa irratti bu'uu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"«Beniyaamin akka yayyii beelottee ti;","poem":1},{"text":"ganamaan waan adanse nyaata;","poem":2},{"lineBreak":true},{"text":"galgala waan booji'e qoqooda» jedhe.","poem":2}]},{"type":"verse","number":28,"content":["Gosi Israa'elii kudhanii lama isaan kana. Abbaan isaanii eebba isaaniif te'uun tokko tokkoo isaanii yennaa isaan eebbise, wonni isaaniin jedhe tana."]},{"type":"heading","content":["Du'aa Fi Awwaalama Yaaqoobii"]},{"type":"verse","number":29,"content":["Achiin duuba Yaaqoob, isaan gorsee, «Ani du'uu geyeera; isin abbootii tiyya woliin goda fichaa Efronii namicha biyya Heetii keessatti na awwaala'a."]},{"type":"verse","number":30,"content":["Godi sun lafa Kana'aanii keessa, Mamree irraa gara aduun baatu, fichaa Makfela'aa keessa jirti; Abrahaam fichaa godi awwaalaa tun keessa jirtu, addee awwaalaatiif Efronii heeticha irraa bitate."]},{"type":"verse","number":31,"content":["Abrahaamii fi niitii isaa Saaraa achitti awwaalane; Yisihaqii fi niitii isaa Ribqaa achitti awwaalane; anille Liyaa achitti awwaale."]},{"type":"verse","number":32,"content":["Fichaan sunii fi godi fichaa san keessaa sun namoota biyya Heetii irraa bitamane» isaaniin jedhe."]},{"type":"verse","number":33,"content":["Yaaqoob ilmaan ifiititti gorsee yennaa fixe, miila ifii taqee irratti ol deebifatee, du'ee, gara kolbaa ifii ta addee dhuga'aa jirtuu gale."]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}