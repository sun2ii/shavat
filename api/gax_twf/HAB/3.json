{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"HAB","translationId":"gax_twf","name":"Anbaaqoomii Raagichaa","commonName":"Anbaaqoomii Raagichaa","title":"Kitaaba Anbaaqoomii Raagichaa","order":35,"numberOfChapters":3,"sha256":"0f79475e4559b90463b5ac0f5d5af8b4c7d27f519457b5c039fa6d7ee71c531b","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gax_twf/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["Daadimata Anbaaqoomii"]},{"type":"verse","number":1,"content":["Daadimati Anbaaqoomii raagichaa ka faaru'uun dhikaate asii gad jira."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ee Mootii Waan Maraa kiyya,","poem":1},{"text":"hujii maade'ee ta ati hujje mara dhage'ee guddoo sodaadhe;","poem":2},{"lineBreak":true},{"text":"ammalle bara keennatti hujii teeti ta durii ede'ii huji;","poem":2},{"lineBreak":true},{"text":"bara kennalle'etti akka beekkantu godhi;","poem":2},{"lineBreak":true},{"text":"yennaa aartulle nu mararfadhu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Waaqi woyyichi biyya Temaanii,","poem":1},{"text":"gaara Phaaraan irraa hin dhufa;","poem":2},{"lineBreak":true},{"text":"Ulfinni isaa ol-gubbaa golleera;","poem":2},{"lineBreak":true},{"text":"leellisi isaalle lafa guuteera.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ifi ulfinna isaa akka ifa adu'uu ti;","poem":1},{"text":"harka isaa ka hunni isaa keessa dhokatteertu keessaa","poem":2},{"lineBreak":true},{"text":"balaqqeessi hin baya.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Balaan isa dura deema;","poem":1},{"text":"dhukkubi nama fixu isa duubaan deema.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yennaa inni dhaabbatu latti hin tachooti;","poem":1},{"text":"yennaa inni isaan ilaalu","poem":2},{"lineBreak":true},{"text":"gosi biyya adda addaa hin hollatti.","poem":2},{"text":"Gaaroti durii durii hin sigigan;","poem":1},{"text":"kooboti durii durii ta inni irra deemaa turelle","poem":2},{"lineBreak":true},{"text":"gad hin lixan.","poem":2},{"text":"Karaan inni irra deemu ammoo","poem":1},{"text":"bara baraan jiraata.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Worri Itoophiya'aa","poem":1},{"noteId":1},{"text":"rakkatuun,","poem":1},{"text":"worri Miidiyaaniille hollatuun dhagge.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ee Mootii Waan Maraa, ati lagatti hin aartee?","poem":1},{"text":"Yennaa fardoolee teeti yaabbattee,","poem":2},{"lineBreak":true},{"text":"garreettaa fardaa ka injifachaa keetii irra teette,","poem":2},{"lineBreak":true},{"text":"abbaaya'atti guddoo aarteetii?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ati guubee","poem":1},{"noteId":2},{"text":"teeti qopheeffattee","poem":1},{"text":"daaya keeti buqqifattee,","poem":2},{"lineBreak":true},{"text":"lagaan lafa gargar tarsaatte.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gaaroti si dhagganee hollatane;","poem":1},{"text":"lolaan roobaa lafa haxowaa tare.","poem":2},{"text":"Bisaan abbaaya'aa shookkisee,","poem":1},{"text":"danbaliin isi'iille ol kaate.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yennaa daaya keeti isaanitti calalaqee,","poem":1},{"text":"eboon teeti isaanitti itte","poem":2},{"lineBreak":true},{"text":"adu'uu fi jiin adduma jiranutti dhaabbatane.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ati aari'iin lafa irra ideenta;","poem":1},{"text":"aariille'een gosa biyya adda addaa hin dhidhiitta.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ati kolbaa teeti fayyisiisaaf,","poem":1},{"text":"ka muudame sanille fayyisiisaaf baate.","poem":2},{"text":"Sooressa worra hamoole'ee butuchitee,","poem":1},{"text":"hordofattoota isaalle balleessitee,","poem":2},{"lineBreak":true},{"text":"mata'aa haga miilaatitti qullaa isa hamburte.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Akka hobonbolatti'ii nu bittinneessiisaaf ka dhufe,","poem":1},{"text":"Yennaa loltooti isaa akka hobonbolatti'ii","poem":2},{"lineBreak":true},{"text":"nu bittinneessiisaaf,","poem":2},{"lineBreak":true},{"text":"hiyyeeyyii dhokataneeranu fixanee","poem":2},{"lineBreak":true},{"text":"itti gammadiisaaf dhufane;","poem":2},{"lineBreak":true},{"text":"ati woraanuma isaatiin sooressa isaanii woraante.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yennaa ati fardoo teetiin abbaayaa dhidhiitte,","poem":1},{"text":"abbaayaan raafante.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ani waan kana duudii dhage'ee, roromme;","poem":1},{"text":"qoonqoo tana irraa ta kaate hidhiin tiyya hollatte.","poem":2},{"text":"Lafeen tiyya shante;","poem":1},{"text":"miilli kiyyalle lelleqe.","poem":2},{"lineBreak":true},{"text":"Te'uu malee yennaan worri nu miidhu","poem":1},{"text":"adabamu haga dhuttu ossaan hin eegadha'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Muki harru'uu midhaan buusuu dhabulle,","poem":1},{"text":"muki woyni'ii midhaan buusuu dhabulle,","poem":2},{"lineBreak":true},{"text":"muki ejersaalle midhaan kennuu dhabulle,","poem":2},{"lineBreak":true},{"text":"fichaan midhaan baasuu dhabulle,","poem":2},{"lineBreak":true},{"text":"hooleen gooree keessaa dhabantulle duwwaa hattulle","poem":2},{"lineBreak":true},{"text":"loon moonaa keessaa dhabamanulle,","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"tun marti teetulle","poem":2},{"lineBreak":true},{"text":"ani Mootii Waan Maraatitti hin gammada;","poem":2},{"lineBreak":true},{"text":"Waaqa fayyisaa kiyyatti gammadee firinxiixa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mootiin Waan Maraa Waaqi hunna tiyya.","poem":1},{"text":"Inni miila kiyya akka miila gadansaa hin jabeessa;","poem":2},{"lineBreak":true},{"text":"gaara irralle akka deemu na hin godha.","poem":2},{"lineBreak":true},"Sooressitoota faarsitootaatiif: Meya ribu'uutiin ta faarfatantu."]}],"footnotes":[{"noteId":1,"caller":"+","text":"Worri Itoophiyaa: Afaan Ibrootaatiin Kuushan jedha.","reference":{"chapter":3,"verse":7}},{"noteId":2,"caller":"+","text":"Guubee: Yookiin buube.","reference":{"chapter":3,"verse":9}}]},"thisChapterLink":"/api/gax_twf/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}