{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"HEB","translationId":"gax_twf","name":"Ibroota","commonName":"Ibroota","title":"Ergaa Gara Ibrootaa Ergante","order":58,"numberOfChapters":13,"sha256":"5711faa325d0d4bd77ce63b2e75bcb7c34ff5f18fa10958759ff738a1f04103c","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/gax_twf/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Waaqi Karaa Ilma Ifiitiin Dubbate"]},{"type":"verse","number":1,"content":["Bara durii Waaqi karaa adda addaatiin, yennaa hedduu karaa raagotaatiin abbootii teennatti dubbateera."]},{"type":"verse","number":2,"content":["Ammaa ammoo bara duubaa kanatti karaa Ilma ifii ka waan mara akka dhaalu godheetiin nutti dubbate; biyya lafaa duudiille isumaan dade."]},{"type":"verse","number":3,"content":["Inni calalaqa ulfinna Waaqaa ti; akki",{"noteId":0},"isaa guutumatti Waaqaan wol qixxe'e. Jecha ifii hunna qabeessaan waan dadame duudii utubeera. Kolbaalle cubbuu irraa qulqulleesseen duuba, ol gubba'atti midda Waaqa hunnaamessaa tee'eera."]},{"type":"heading","content":["Ilmi Waaqaa Ergantoota Waaqaa Caala"]},{"type":"verse","number":4,"content":["Maqaan Waaqi isaaf kenne maqaa ergantoota Waaqaa ka caalu akkuma te'e, Ilmi Waaqaa ergantoota Waaqaa caala."]},{"type":"verse","number":5,"content":[{"text":"Waaqi ergantoota ifii keessaa eennuun,","poem":1},{"text":"«Ati Ilma kiyya, ani adha si uumadheera»","poem":2},{"lineBreak":true},{"text":"yookiin eennuun,","poem":2},{"lineBreak":true},{"text":"«Ani isaaf Abbaa hin te'a,","poem":2},{"lineBreak":true},{"text":"innille Ilma naaf hin te'a» jedhee beeka?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Waaqi yennaa Ilma ifii angaficha gara biyya lafaa erge,","poem":1},{"text":"«Ergantooti Waaqaa martinuu isaaf sagadanuu ti» jedhe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ammoo yennaa marroo ergantoota ifii dubbatu,","poem":1},{"text":"«Ergantoota ifii qilleensa","poem":2},{"noteId":1},{"text":",","poem":2},{"lineBreak":true},{"text":"tajaajiltoota ifiille bobe'a ibiddaa hin godha» jedhe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Marroo Ilmaa ammoo,","poem":1},{"text":"«Ee Waaqa, barcumaan mootummaa keetii","poem":2},{"lineBreak":true},{"text":"bara baraa haga bara baraa hin jiraata;","poem":2},{"lineBreak":true},{"text":"mootummaa teetille sirri'itti hin bulchita.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ati balchummaa jaalatee yakkaa jibbite;","poem":1},{"text":"tanaaf Waaqi keeti si filatee,","poem":2},{"lineBreak":true},{"text":"muudaa gammachiisuun hari'oota teeti caalaa si muude» jedhe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Akkasuma,","poem":1},{"text":"«Gootta'a, ati jalqabatti hundee lafaa hundeessite;","poem":2},{"lineBreak":true},{"text":"ol gubbaan marti hujii harka keetii ti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isaan hin badan;","poem":1},{"text":"ati ammoo hin jiraatta;","poem":2},{"lineBreak":true},{"text":"isaan martinuu akka woya'aa hin dullooman.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ati akka bullukko'oo isaan hin marta;","poem":1},{"text":"isaaniille akka woya'aa hin jijjiiraman.","poem":2},{"lineBreak":true},{"text":"Ati ammoo yennaa mara sanuma;","poem":2},{"lineBreak":true},{"text":"woggooti keetille dhuma hin qabanu» jedhe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Waaqi ergantoota ifii keessaa eennuun,","poem":1},{"text":"«Haga ani diinota keeti ejjata miila keetii","poem":2},{"noteId":2},{"text":"jala godhutti","poem":2},{"lineBreak":true},{"text":"midda kiyyatti tee'i!» jedhee beeka?","poem":2}]},{"type":"verse","number":14,"content":["Maarre, ergantooti Waaqaa martinuu ayyaanota worra fayyu tajaajiliisaaf ergamanu, tajaajiltoota Waaqaatii motii ree?"]}],"footnotes":[{"noteId":0,"caller":"+","text":"Akki: Adabi","reference":{"chapter":1,"verse":3}},{"noteId":1,"caller":"+","text":"Qilleensa: Ayyaanota","reference":{"chapter":1,"verse":7}},{"noteId":2,"caller":"+","text":"Miila keeti: Baallii teeti","reference":{"chapter":1,"verse":13}}]},"thisChapterLink":"/api/gax_twf/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}