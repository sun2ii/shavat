{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"HOS","translationId":"gax_twf","name":"Hose'aa Raagichaa","commonName":"Hose'aa Raagichaa","title":"Kitaaba Hose'aa Raagichaa","order":28,"numberOfChapters":14,"sha256":"63c415f9d3540b490cf813308197bd9674ff342a7cd1e6320288492f5704ccb8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gax_twf/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"heading","content":["Jaalala Waaqi Israa'eliif Qabu"]},{"type":"verse","number":1,"content":[{"text":"«Yennaa Israa'el ijoolle'ee,","poem":1},{"text":"ani isa jaaladhe;","poem":2},{"lineBreak":true},{"text":"biyya Gibxi'ii keessalle'ee ilma kiyya waame.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Irra caalaa ammoo ani kolbaa Israa'elii waame;","poem":1},{"text":"irra caalaa isaan na irraa fagaatane.","poem":2},{"text":"Isaan waaqa dharaa Ba'aaliif ciincaa dhikeessanee,","poem":1},{"text":"fakki'iifille hixaana aarsane.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Harka kolbaa Efreemii qabee daaddisee,","poem":1},{"text":"deemiisa ka barsiise ana;","poem":2},{"lineBreak":true},{"text":"isaan ammoo ka isaan fayyise","poem":2},{"lineBreak":true},{"text":"ana akka te'e hin beenne.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ani wodaroo gadhi-laafummaa namaatiin,","poem":1},{"text":"hidhaansa jaalalaatille'een isaan harkise;","poem":2},{"lineBreak":true},{"text":"waanjoo morma isaanii irraa fuudhee","poem":2},{"lineBreak":true},{"text":"gad jedhee isaan areere.","poem":2}]},{"type":"verse","number":5,"content":["«Isaan gara kiyya deebi'uu waan didaneef, gara biyya Gibxi'ii hin deebi'anuu ree? Worri Asoorii isaan hin bulchuu ree?"]},{"type":"verse","number":6,"content":["Shallaagaan qachoota isaanii keessa hin balaqqitti; danqaraa karra dalleya isaanii kukkuttee karoora isaanii hin balleessiti."]},{"type":"verse","number":7,"content":["Kolbaan tiyya na irraa fagaatiisaaf murteeffatte; isaan Waaqa Ol Aanaa yoo waammatanelle, ani karuma te'e maraanuu isaan ol hin qabu."]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Ee Efreem,","poem":1},{"text":"ani attam si lakkisuu dande'a ree?","poem":2},{"lineBreak":true},{"text":"Ee Israa'el,","poem":2},{"lineBreak":true},{"text":"ani attam dabarsee si kennuu dande'a ree?","poem":2},{"text":"Akka qachaa Aadimaa","poem":1},{"text":"ani attam dabarsee si kennuu dande'a ree?","poem":2},{"text":"Yookiin akka qachaa Zebo'iimii","poem":1},{"text":"ani attam si godhuu dande'a ree?","poem":2},{"text":"Gadhaan kiyya raafame;","poem":1},{"text":"Marartiin tiyya marti kakkaateerti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ani aarii tiyya ta bobeettu gad hin lakkisu;","poem":1},{"text":"deebi'ee Efreem hin balleessu;","poem":2},{"lineBreak":true},{"text":"ani Waaqa Woyyicha odduu teessan jiru malee, namaa moti;","poem":2},{"lineBreak":true},{"text":"ani mufi'iin gara keessan hin dhufu.","poem":2}]},{"type":"verse","number":10,"content":["«Isaan ana Mootii Waan Maraa hin hordofan;",{"text":"anille akka neenqaa dhangaa hin dhowa.","poem":2},{"text":"Yennaa ani dhangaa dhowu,","poem":1},{"text":"ijoolleen tiyya hollataa karaa aduun seentu irraa hin dhufan.","poem":2}]},{"type":"verse","number":11,"content":["«Isaan hollataa akka sinbirrootaa biyya Gibxi'ii irraa,",{"text":"akka saphaliisaa biyya Asoorii irraa hin dhufan. Anille mana isaaniititti isaan hin qubachiisa;","poem":2}]},{"type":"verse","number":12,"content":["«Efreem dharaan, kolbaan Israa'elii sobaan na marsite; Yihudaalle ana Waaqa Woyyicha addatamaa irratti ka'e."]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}