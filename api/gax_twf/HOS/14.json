{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"HOS","translationId":"gax_twf","name":"Hose'aa Raagichaa","commonName":"Hose'aa Raagichaa","title":"Kitaaba Hose'aa Raagichaa","order":28,"numberOfChapters":14,"sha256":"63c415f9d3540b490cf813308197bd9674ff342a7cd1e6320288492f5704ccb8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gax_twf/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"heading","content":["Eebba Dhaggatiisaaf Cubbuu Irraa Deebi'iisa"]},{"type":"verse","number":1,"content":["Ee kolbaa Israa'elii, cubbuun teessan waan isin gufachiitteef, gara Mootii Waan Maraa Waaqa keessanii deebi'a'a."]},{"type":"verse","number":2,"content":["Jechoota kana isaan jedhiisaaf, fudhadha'aatii gara Mootii Waan Maraa deebi'a'a'a: «Cubbuu teenna mara nuu araaram! Galata dansaa afaan keennaa akka dhikeessinu, mararti'iin nu fudhadhu."]},{"type":"verse","number":3,"content":["Asoor nu baasuu hin dande'u; fardoo lolaa irra hin teennu; ijoollee haadhaa fi abbaa hin qanne si'iin marartii waan dhaggattuuf, nuuti ijjumaa deebinee waan harki keenna hujeen, ‹Waaqota keenna› hin jennu» jedha'aan."]},{"type":"heading","content":["Mootiin Waan Maraa Jiruu Haareya Israa'eliif Kenniisaaf Waadaa Gale"]},{"type":"verse","number":4,"content":[{"text":"Mootiin Waan Maraa,","poem":1},{"text":"«Ani dhukkuba na irraa isaan fageessu irraa","poem":2},{"lineBreak":true},{"text":"isaan hin fayyisa;","poem":2},{"lineBreak":true},{"text":"aariin tiyya isaan irraa waan deebiteef,","poem":2},{"lineBreak":true},{"text":"ani akkasumaan isaan hin jaaladha.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ani Israa'eliif","poem":1},{"text":"akka tiifu'uu hin te'a.","poem":2},{"text":"Isaan akka daraara'aa hin baqan;","poem":1},{"text":"akka hindheensa Libaanonii hidda gad hin naqatan.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isaan quunxoo haareya hin baasan.","poem":1},{"text":"Akka muka ejersaa hin miidhagan;","poem":2},{"lineBreak":true},{"text":"fooleen isaanii akka hindheensa Libaanonii hin teeti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Isaan deebi'anee gaaddisa kiyya jala hin boqatan.","poem":1},{"lineBreak":true},{"text":"Akka midhaanii hin latan;","poem":1},{"text":"akka muka woyni'ii hin daraaran;","poem":2},{"lineBreak":true},{"text":"akka daadhii woynii biyya Libaanonii gurra hin horatan.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ee kolbaan Efreemii,","poem":1},{"text":"waaqota dharaa biraa","poem":2},{"lineBreak":true},{"text":"ani maan qaba ree?","poem":2},{"text":"Ka deebii isiniif kennu,","poem":1},{"text":"ka isin kunuunsu ana.","poem":2},{"text":"Ani akka muka yennaa mara bisiluu ti;","poem":1},{"text":"eebbifam keessan na biraa dhufa» jedha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nami qaroon waan kana hin hubata;","poem":1},{"text":"nami woy hubatu waan kana hin qalbeeffata;","poem":2},{"lineBreak":true},{"text":"karaan Mootii Waan Maraa qajeela'a;","poem":2},{"lineBreak":true},{"text":"balchooleen irra ideeman;","poem":2},{"lineBreak":true},{"text":"finqiltooti ammoo keessatti gufatan.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}