{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"ISA","translationId":"gax_twf","name":"Isaayaasii Raagichaa","commonName":"Isaayaasii Raagichaa","title":"Kitaaba Isaayaasii Raagichaa","order":23,"numberOfChapters":66,"sha256":"43d1d4dce18c16808d379730f9d084e9e041c6b6e6a9b344a406dd4f58553d07","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gax_twf/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["Faaruu Leellisaa"]},{"type":"verse","number":1,"content":["Guyyaa san ati,",{"text":"«Ee, Mootii Waan Maraa,","poem":1},{"text":"ati natti mufatteertaayyu;","poem":2},{"lineBreak":true},{"text":"amma mufii teeti na irraa deebittee,","poem":2},{"lineBreak":true},{"text":"waan na jajjabeessiteef si leellifadha!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dhuguma Waaqi fayyisaa kiyya;","poem":1},{"text":"ani isatti hin addadha;","poem":2},{"lineBreak":true},{"text":"womaalle hin sodaadhu.","poem":2},{"text":"Mootiin Waan Maraa hunnaa fi jabeenna kiyya;","poem":1},{"text":"inni fayyisaa kiyya naaf te'eera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isin gammadaan madda fayyinnaa keessaa","poem":1},{"text":"bisaan hin woraabbattan» hin jetta.","poem":2}]},{"type":"verse","number":4,"content":["Yennaa san isin,",{"text":"«Mootii Waan Maraa galateeffadha'a;","poem":1},{"text":"maqaa isaalle waammadha'a!","poem":2},{"text":"Gosa biyya adda addaa keessatti","poem":1},{"text":"hujii isaa beessisa'a;","poem":2},{"lineBreak":true},{"text":"guddinna maqaa isaalle lallaba'a.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inni waan guddoo waan godheef","poem":1},{"text":"faaru'uun isa leellisa'a;","poem":2},{"lineBreak":true},{"text":"waan inni godhelle","poem":2},{"lineBreak":true},{"text":"biyya lafaa mara irratti beessisa'a.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ee kolbaa Xiyoonii,","poem":1},{"text":"Waaqi guddaan woyyichi Israa'elii,","poem":2},{"lineBreak":true},{"text":"odduu teessan waan jiruuf,","poem":2},{"lineBreak":true},{"text":"ilillisaa gammadaan faarsa'a» hin jettan.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}