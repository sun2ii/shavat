{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"ISA","translationId":"gax_twf","name":"Isaayaasii Raagichaa","commonName":"Isaayaasii Raagichaa","title":"Kitaaba Isaayaasii Raagichaa","order":23,"numberOfChapters":66,"sha256":"43d1d4dce18c16808d379730f9d084e9e041c6b6e6a9b344a406dd4f58553d07","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gax_twf/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":26,"content":[{"type":"heading","content":["Faaruu Injifacha'aa"]},{"type":"verse","number":1,"content":["Yennaa san faaruun asii gad jirtu lafa Yihuda'aa keessatti hin faarfanti:",{"text":"«Nuuti qachaa jabaa qanna;","poem":1},{"lineBreak":true},{"text":"Waaqi dalleya dhaka'aatii fi","poem":1},{"text":"kushee qacha'aa saniin nu hambure.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kolbaan balchittiin","poem":1},{"text":"ta dhugeeffannaa ifii eegatte akka seentuuf,","poem":2},{"lineBreak":true},{"text":"karra qachaa sanii bana'a.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nama qalbii ifiitiin jabaatee sitti irkatu,","poem":1},{"text":"waan inni sitti addateef,","poem":2},{"lineBreak":true},{"text":"ati nageya guutu'uun isa hin eedda.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inni rassaa bara baraa waan te'eef,","poem":1},{"text":"haga bara baraa","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraatitti addadha'a.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inni qachaa kooru hin salphisa;","poem":1},{"text":"worra achi keessa le'ulle hin adaba.","poem":2},{"text":"Inni qachaa ol ka'e san gara lafaa gad hin qaba;","poem":1},{"text":"bukuu keessalle'etti gad hin gata.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Miilli worra cunqurfamanee","poem":1},{"text":"isa irra hin ideema;","poem":2},{"lineBreak":true},{"text":"faanti worra hiyyeeyyi'ii isa irra sirbiti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Ee Mootii Waan Maraa qajeela'a!","poem":1},{"text":"Ati balchootaaf karaa hin qulqulleessita;","poem":2},{"lineBreak":true},{"text":"daandii isaan irra ideemanulle","poem":2},{"lineBreak":true},{"text":"wol hin qixxeessita.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ee Mootii Waan Maraa!","poem":1},{"text":"Karaa seera keetii irra ideemaa,","poem":2},{"lineBreak":true},{"text":"addi'iin si eeganna;","poem":2},{"lineBreak":true},{"text":"maqaa keetii fi waan ati nuu goote","poem":2},{"lineBreak":true},{"text":"qaabatiisa dharraana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Halkan lubbuun tiyya si dharraati;","poem":1},{"text":"ayyaanni kiyyalle si dharra'a;","poem":2},{"lineBreak":true},{"text":"yennaa ati lafatti murtu,","poem":2},{"lineBreak":true},{"text":"kolbaan biyya lafaa irra leetu","poem":2},{"lineBreak":true},{"text":"balchummaa hin baratti.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Worra hama'aaf gadhaa yoo laafanelle,","poem":1},{"text":"balchummaan maan akka teete hin baratanu.","poem":2},{"text":"Isaan lafa qajeelumma'aa keessalle'etti","poem":1},{"text":"waan hantuu hujan;","poem":2},{"lineBreak":true},{"text":"arnya Mootii Waan Maraalle","poem":2},{"lineBreak":true},{"text":"hin qalbeeffatanu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"harki keeti isaan adabiisaaf ol ka'eera;","poem":2},{"lineBreak":true},{"text":"isaan ammoo hin dhagganu;","poem":2},{"lineBreak":true},{"text":"akka ati kolbaa teetiif hinaattu","poem":2},{"lineBreak":true},{"text":"dhagganee qaanowanuu ti;","poem":2},{"lineBreak":true},{"text":"ibiddi ati diinaaf qopheessite isaan fixuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Ee Mootii Waan Maraa,","poem":1},{"text":"ati nageya nuuf hin kennita;","poem":2},{"lineBreak":true},{"text":"waan nuuti hunye mara nuuf muummessiteerta.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ee Mootii Waan Maraa, Waaqa keenna!","poem":1},{"text":"Goottoleen dhibiin nu bulchaneeran;","poem":2},{"lineBreak":true},{"text":"nuuti ammoo maqaa keeti qofa ulfeessina.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Isaan amma du'aneeran;","poem":1},{"text":"haganaa achi hin jiraatanu;","poem":2},{"lineBreak":true},{"text":"ekeraan isaanii hin kaatu.","poem":2},{"text":"Ati isaan addaddee balleessite;","poem":1},{"text":"dabarsii isaanii mara ijjumaa balleessite.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ee Mootii Waan Maraa, ati kolbaa teeti baceessite;","poem":1},{"text":"ati isaan baceessitee, ulfinna ifiif fudhatte.","poem":2},{"lineBreak":true},{"text":"Meessaa lafaalle karaa maraan badhitte.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"isaan yennaa rakko'oo gara keeti dhufane;","poem":2},{"lineBreak":true},{"text":"yennaa ati isaan adaddu","poem":2},{"lineBreak":true},{"text":"hasaassa'aan si daadimatane.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ee Mootii Waan Maraa, akkuma dubartiin ulfaa,","poem":1},{"text":"yennaa deyiisaaf ciniinsifattu iyyitu,","poem":2},{"lineBreak":true},{"text":"nuutille si duratti akkasuma teene.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Akka dubartii ulfoottee ciniinsifattee teene;","poem":1},{"text":"ammoo womaa hin deenne;","poem":2},{"lineBreak":true},{"text":"waan biyya qarqaaru, waan hunye hin qannu;","poem":2},{"lineBreak":true},{"text":"biyya lafaa irralle'etti nama hin daballe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«Kolbaan teeti ta duute hin kaati;","poem":1},{"text":"reeffi isaanii hin ka'a.","poem":2},{"text":"Isin worri awwaalantaneertanu","poem":1},{"text":"ka'a'aatii, ilillisa'a!","poem":2},{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"Fixeensi ati ergitu fixeensa jiruu kennu waan te'eef,","poem":2},{"lineBreak":true},{"text":"latti ekeraa ol hin baatti.","poem":2}]},{"type":"heading","content":["Mura'aa Fi Boojuu Irraa Deebi'iisa"]},{"type":"verse","number":20,"content":["«Ee kolbaa tiyya, kolloo teessan ol seena'aatii, balbala teessan cufadha'a; haga mufiin isaa dabartutti haga diqqaa dhokadha'a."]},{"type":"verse","number":21,"content":["Kolbaa biyya lafaa cubbuu isaaniitiif adabiisaaf, kunoo, Mootiin Waan Maraa addee bultoo ifiitii dhufiisatti jira. Latti dhiiga isii irratti dhangala'e hin mudhitti; haganaa achi worra ijjeefamane hin dhossitu» ta jettu."]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}