{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"ISA","translationId":"gax_twf","name":"Isaayaasii Raagichaa","commonName":"Isaayaasii Raagichaa","title":"Kitaaba Isaayaasii Raagichaa","order":23,"numberOfChapters":66,"sha256":"43d1d4dce18c16808d379730f9d084e9e041c6b6e6a9b344a406dd4f58553d07","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gax_twf/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":35,"content":[{"type":"heading","content":["Gammada Worra Wodamee"]},{"type":"verse","number":1,"content":["Goomole'ee fi latti godduun hin gammaddi;",{"text":"gammoojjiin firinxiixxee,","poem":2},{"lineBreak":true},{"text":"akka daraara'aa hin daraarti.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Goomoleen daraaraa hedduu daraartee,","poem":1},{"text":"guddoo firinxiixxee, hin ilillitti;","poem":2},{"lineBreak":true},{"text":"ulfinni gaara Libaanonii,","poem":2},{"lineBreak":true},{"text":"arnyi gaara Qarmelosiitii fi","poem":2},{"lineBreak":true},{"text":"dhooqa Shaaronii isi'iif hin kennama.","poem":2},{"text":"Nami marti ulfinna Mootii Waan Maraatii fi","poem":1},{"text":"arnya Waaqa keennaa hin dhagga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Harka dadhabe jabeessa'a;","poem":1},{"text":"jilba lelleqelle jabeessa'a.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Worra gadhaan isaanii soda'aan qabameen,","poem":1},{"text":"«Jabaadha'a; hin sodaatina'a!","poem":2},{"text":"Kunoo, Waaqi keessan diinota keessan haluu bayiisaaf,","poem":1},{"text":"yakkaa isaan isin irratti hujaneef","poem":2},{"lineBreak":true},{"text":"gatii isaan kaffalchiisiisaaf,","poem":2},{"lineBreak":true},{"text":"isin ammoo fayyisiisaaf hin dhufa» jedha'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Achiin duuba ilti worra balla'aa hin bananti;","poem":1},{"text":"gurri worra duuda'aalle hin dhage'a.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Naafi akka gadansaa hin utaala;","poem":1},{"text":"worri afaan duuda'aa, hin ilillisa.","poem":2},{"text":"Gammoojjii keessaa bisaan,","poem":1},{"text":"goomolee keessaa maddi hin burqa;","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"maansi akka ibiddaa gubu baleessa hin te'a;","poem":2},{"lineBreak":true},{"text":"lafa godduu keessaa bisaan hin burqa.","poem":2},{"text":"Addeen jeedalti keessa leetu","poem":1},{"text":"marra, shonbooqqo'oo fi allaaduu hin baatti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Achi keessa karaan guddaan hin baya;","poem":1},{"text":"maqaan isaalle, «Karaa Woyyicha» hin jedhama.","poem":2},{"text":"Karaa san irra kolbaa Waaqaa qofattuu deema malee,","poem":1},{"text":"worri battiin irra hin deemu;","poem":2},{"lineBreak":true},{"text":"worri gowwooleelle irra hin deemu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neenqi achi hin jiraatu;","poem":1},{"text":"bineensi hamaan achi irra hin ideemu.","poem":2},{"text":"Worra wodame qofattuu achi irra ideema.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Worri Mootiin Waan Maraa wode hin deebi'an;","poem":1},{"text":"faarfataa gara Xiyoonii hin galan.","poem":2},{"text":"Kallacha gammada bara baraa mata'atti hin keyatan;","poem":1},{"text":"isaan gammadaa fi qananummaa hin dhaggatan;","poem":2},{"lineBreak":true},{"text":"gaddaa fi aadiis isaan irraa hin fagaata.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}