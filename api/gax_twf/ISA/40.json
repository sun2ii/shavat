{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"ISA","translationId":"gax_twf","name":"Isaayaasii Raagichaa","commonName":"Isaayaasii Raagichaa","title":"Kitaaba Isaayaasii Raagichaa","order":23,"numberOfChapters":66,"sha256":"43d1d4dce18c16808d379730f9d084e9e041c6b6e6a9b344a406dd4f58553d07","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gax_twf/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":40,"content":[{"type":"heading","content":["Jecha Addi'ii"]},{"type":"verse","number":1,"content":[{"text":"Waaqi keessan, «Jajjabeessa'a;","poem":1},{"text":"kolbaa tiyya jajjabeessa'a!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gadhi-laafumma'aan","poem":1},{"text":"Kolbaa Yerusaalemiititti dubbadha'aatii,","poem":2},{"lineBreak":true},{"text":"itti lallaba'a;","poem":2},{"lineBreak":true},{"text":"barri garbummaa isaanii dhumateera;","poem":2},{"lineBreak":true},{"text":"gatii cubbuu ifii maraaf,","poem":2},{"lineBreak":true},{"text":"harka Mootii Waan Maraa irraa","poem":2},{"lineBreak":true},{"text":"adabbii dachaa lama fudhataneeran» jedha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Qoonqoon nama goomolee keessaa lallabu tokkoo,","poem":1},{"lineBreak":true},{"text":"«Goomolee keessatti","poem":1},{"text":"karaa Mootii Waan Maraa qopheessa'a;","poem":2},{"lineBreak":true},{"text":"Gammoojjii keessatti","poem":2},{"lineBreak":true},{"text":"karaa guddaa Waaqa keennaaf qajeelcha.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dhooqi martinuu hin guutti;","poem":1},{"text":"koobii fi gaarri martinuu hin diriiran.","poem":2},{"lineBreak":true},{"text":"Latti bu'aa bayiin hin qajeelti.","poem":2},{"lineBreak":true},{"text":"Latti kattattaan wol hin qixxootti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Achiin duuba ulfinni Mootii Waan Maraa hin mudhata;","poem":1},{"text":"Mootiin Waan Maraa ifumaafuu waan dubbateef,","poem":2},{"lineBreak":true},{"text":"nami marti tana hin dhagga» hin jedha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Qoonqoon takka, «Iyyi» naan jette.","poem":1},{"lineBreak":true},{"text":"Anille, «Maan jedhee iyya?» jedhee gaafadhe.","poem":1},{"lineBreak":true},{"text":"Qoonqoon sun, «Nami marti akka marraa ti;","poem":1},{"text":"ulfinni isaanii marti akka daraaraa diida keessaa ti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yennaa Mootiin Waan Maraa hafuura itti baafatu,","poem":1},{"text":"marri hin qoora;","poem":2},{"lineBreak":true},{"text":"daraaraalle hin harca'a;","poem":2},{"lineBreak":true},{"text":"dhugumaan kolbaan akka marraa ti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Marri hin qoora;","poem":1},{"text":"daraaraalle hin harca'a;","poem":2},{"lineBreak":true},{"text":"jechi Waaqa keennaa ammoo,","poem":2},{"lineBreak":true},{"text":"haga bara baraa jabaatee le'a» jette.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ee isin worri Xiyoonitti oduu gammadaa hintanu,","poem":1},{"text":"gaara dheera'atti ol baya'a.","poem":2},{"text":"Ee isin worri Yerusaalemitti oduu gammadaa hintanu,","poem":1},{"text":"qoonqoo teessan ol-qabadha'aatii iyya'a;","poem":2},{"lineBreak":true},{"text":"qoonqoo teessan ol qabadha'a, hin sodaatina'a!","poem":2},{"text":"Qachoota Yihuda'aatiin,","poem":1},{"text":"«Waaqi keessan kunoo ti!» jedha'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kunoo, Goottaan Mootiin Waan Maraa,","poem":1},{"text":"hunnaan hin dhufa;","poem":2},{"lineBreak":true},{"text":"irree ifiitille'een hin bulcha.","poem":2},{"text":"Kunoo, gatiin inni kennu,","poem":1},{"text":"harka isaa jirti;","poem":2},{"lineBreak":true},{"text":"waan kaffalu ifi duraa qaba.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inni akka tisse'ee, hoolee ifii hin tissa;","poem":1},{"text":"inni akka ilmoolee hoole'ee","poem":2},{"lineBreak":true},{"text":"harka ifiitiin wolitti qabaa, habbaarata;","poem":2},{"lineBreak":true},{"text":"haadhotii ilmoole'ee malaan sooressa.","poem":2}]},{"type":"heading","content":["Ka Waaqaan Wol Qixxowu Eennu"]},{"type":"verse","number":12,"content":[{"text":"Bisaan ooboo harka ifiitiin ka safare,","poem":1},{"text":"yookiin ol-gubbaa taakkuu ifiitiin ka mike","poem":2},{"noteId":28},{"text":"eennu?","poem":2},{"lineBreak":true},{"text":"Yookiin eentu biyyee kollonjo'otti naqee fixuu dande'a?","poem":2},{"text":"Eentu gaarotaa fi koobota madaala irra keyuu dande'a?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Eentu qalbii Mootii Waan Maraa hubatee,","poem":1},{"text":"isatti gorsee isa barsiisuu dande'e?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Beekkumsa dhaggatiisaaf,","poem":1},{"text":"Mootiin Waan Maraa eennu gorsa gaafate?","poem":2},{"lineBreak":true},{"text":"Karaa qajeelaa eentu isa barsiise?","poem":2},{"lineBreak":true},{"text":"Eentu beekkumsa isa barsiise?","poem":2},{"lineBreak":true},{"text":"Yookiin eentu daandii hubatiisaa isatti mudhise?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Gosi biyya adda addaatuu","poem":1},{"text":"akka copha bisaanii ka sakkeelloo keessaa ti;","poem":2},{"lineBreak":true},{"text":"isaan akka bukuu madaala irraa ti;","poem":2},{"lineBreak":true},{"text":"kunoo, inni oddoolota akka bukuun kaatu hin kaasa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Muki Libaanon keessaa","poem":1},{"text":"ibidda addee ciinca'aatiif hin gewu;","poem":2},{"lineBreak":true},{"text":"bineensoti achi keessaalle","poem":2},{"lineBreak":true},{"text":"ciinca'aaf hin geyanu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Gosi biyya adda addaa","poem":1},{"text":"isa duratti womaa moti;","poem":2},{"lineBreak":true},{"text":"isaan isa duratti","poem":2},{"lineBreak":true},{"text":"waan tokkolle'etti hin laakkowamanu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Waaqa eennuun wol fakkeessitan?","poem":1},{"lineBreak":true},{"text":"Yookiin fakkii tamiin wol fakkeessitan?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Waaqa dharaa, nama hujii harkaa beekutti boca;","poem":1},{"text":"nami worqii baqisiisu worqii itti gonfa;","poem":2},{"lineBreak":true},{"text":"haachaba meeti'iille itti seesa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nami deegi kennansa akkasii kenniisaaf hin dandeenne,","poem":1},{"text":"muka dafee hin hurroonne filata.","poem":2},{"text":"Fakkii hin jinne dhaabbatiisaaf,","poem":1},{"text":"ogeessa nama hujii harkaa beeku barbaadata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Isin hin beennee ree?","poem":1},{"text":"Isin hin dhageennee?","poem":2},{"text":"Durii jalqabee","poem":1},{"text":"isinitti hin himannee?","poem":2},{"text":"Biyyi lafaa haga dadantee","poem":1},{"text":"isin hin hubannee ree?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Inni biyya lafaatiin gubbaa","poem":1},{"text":"barcumaa mootummaa ifii irraa tee'a;","poem":2},{"lineBreak":true},{"text":"kolbaan biyya lafaa isa duratti akka korophiisaa ti;","poem":2},{"text":"Inni ol-gubbaa akka golla'aa hin diriirsa;","poem":1},{"text":"akka dunkaanii keessa le'anuulle hin dhaaba.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Inni qondaaltota akka womaa hin te'initti,","poem":1},{"text":"bulchitoota biyya lafaalle akka hin jirree godha.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Isaan akka biqiltuu","poem":1},{"text":"reefuu dhaabanteetii fi akka midhaan reefuu facaafamee,","poem":2},{"lineBreak":true},{"text":"adoo hiddi isaanii hin qabatin,","poem":2},{"lineBreak":true},{"text":"inni hafuura itti baafannaan goddeetii fi","poem":2},{"lineBreak":true},{"text":"akka hicaacee hobonbolattiin haxoottee ti.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Waaqi Woyyichi, «Ana eennuun wol fakkeessitan?","poem":1},{"text":"Ka na woliin wol qixxe'ee eennu?» jedha.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ol jedha'aatii gara ol-gubba'aa ilaala'a;","poem":1},{"text":"urjoota tana mara eentu dade?","poem":2},{"text":"Inni akka loltootaa tokko tokkoon gad baasaa","poem":1},{"text":"isaan laakkowaa,","poem":2},{"lineBreak":true},{"text":"maqaa maqa'aan isaan mara waama;","poem":2},{"lineBreak":true},{"text":"inni hunna guddo'oo fi","poem":2},{"lineBreak":true},{"text":"jabeenna guddaa waan qabuuf","poem":2},{"lineBreak":true},{"text":"isaan keessaa tokkolle hin badu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ee Yaaqoob, ee Israa'el,","poem":1},{"text":"«Karaan kiyya Mootii Waan Maraa duraa dhokateera;","poem":2},{"lineBreak":true},{"text":"Waaqi haajaa kiyya naaf hin ilaalle»","poem":2},{"lineBreak":true},{"text":"jettee maaf gungunta?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ati hin beennee? Ati hin dhageennee?","poem":1},{"text":"Mootiin Waan Maraa Waaqa bara baraa ti;","poem":2},{"lineBreak":true},{"text":"biyya lafaa duudii ka dade isa;","poem":2},{"text":"Inni ijjumaa hin dadhabu yookiin hin laafu;","poem":1},{"text":"eennulle hubantii isaa qorqoree bira gewuu hin dande'u.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Inni worra laafeef","poem":1},{"text":"jabeenna hin kenna;","poem":2},{"lineBreak":true},{"text":"worra dadhabeef hunna hin ede'a.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ijoolleen hin dadhaddi; hin laattille'e;","poem":1},{"text":"dargaggootille gufattee hin jiddi.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Worri Mootii Waan Maraa addatu ammoo,","poem":1},{"text":"hunna ifii hin haareffatan.","poem":2},{"text":"Isaan akka risa'aa koolaan hin ka'an;","poem":1},{"text":"hin rukkisan; hin laafanu; hin ideeman; hin dadhabanu.","poem":2}]}],"footnotes":[{"noteId":28,"caller":"+","text":"Mike: Taakkuu meeqa akka teetu ilaale jechu'u.","reference":{"chapter":40,"verse":12}}]},"thisChapterLink":"/api/gax_twf/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}