{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"ISA","translationId":"gax_twf","name":"Isaayaasii Raagichaa","commonName":"Isaayaasii Raagichaa","title":"Kitaaba Isaayaasii Raagichaa","order":23,"numberOfChapters":66,"sha256":"43d1d4dce18c16808d379730f9d084e9e041c6b6e6a9b344a406dd4f58553d07","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gax_twf/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":41,"content":[{"type":"heading","content":["Waaqi Israa'el Hin Qarqaara"]},{"type":"verse","number":1,"content":["Mootiin Waan Maraa,",{"text":"«Isin worri oddoola keessaa, na duratti cadhisa'a!","poem":1},{"text":"Gosi biyya adda addaa jabeenna ifii haareffattee,","poem":2},{"lineBreak":true},{"text":"gara kiyya dhikaattee dubbattuu ti;","poem":2},{"lineBreak":true},{"text":"addee mura'aatitti wol dhagginuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«Balchumma'aan akka tajaajiluuf,","poem":1},{"text":"karaa aduun baatu irraa","poem":2},{"lineBreak":true},{"text":"kakkaasee ka isa waame eennu?","poem":2},{"lineBreak":true},{"text":"Inni gosa biyya adda addaa dabarsee isatti kenne;","poem":2},{"lineBreak":true},{"text":"moototi akka isaaf bitamanu godhe.","poem":2},{"text":"Innille shallaagaa ifiitiin akka buku'uu isaan godhe;","poem":1},{"text":"guubee ifiitille'een","poem":2},{"lineBreak":true},{"text":"akka qilleensa hicaacee haxowuu","poem":2},{"lineBreak":true},{"text":"isaan bittinneesse.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inni isaan ari'aa, rakkoo malee dabare;","poem":1},{"text":"karaa miilli isaa qara irra ideemee hin beenne deeme.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tun akka teetu ka godhee fi ka muummesse,","poem":1},{"text":"Jalqabumaayyuu dhalooti marti","poem":2},{"lineBreak":true},{"text":"akka jiraatanu ka godhe eennu?","poem":2},{"text":"Ani Mootiin Waan Maraa ka dhaloota duraatii fi","poem":1},{"text":"dhaloota duubaa wolille'een jiru,","poem":2},{"lineBreak":true},{"text":"ani isuma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Kolbaan oddoolota keessa leetu","poem":1},{"text":"waan ani godhe kana dhaggitee sodaatte;","poem":2},{"lineBreak":true},{"text":"worri qaccee biyya lafaa jirulle romme;","poem":2},{"lineBreak":true},{"text":"isaan wolitti qabamanee gara kiyya dhufane.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isaan marti wol hin qarqaaran;","poem":1},{"text":"nami tokko nama kaaniin, ‹Jabaadhu!› hin jedha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nami hujii harkaa beeku","poem":1},{"text":"nama worqii baqisiisu hin jajjabeessa;","poem":2},{"lineBreak":true},{"text":"ka burrisaan wol qixxeessu,","poem":2},{"lineBreak":true},{"text":"ka boraatii irratti sibiila tumu jajjabeessa.","poem":2},{"lineBreak":true},{"text":"Inni hujiin sibiila wolitti qassiisiisaa","poem":2},{"lineBreak":true},{"text":"tun, ‹Dansa'a› jedha;","poem":2},{"lineBreak":true},{"text":"fakkiin sun akka hin jinneef","poem":2},{"lineBreak":true},{"text":"misimaaraan dhowa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Ee Israa'el, tajaajilaa kiyya,","poem":1},{"text":"Yaaqoobii ani filadhe,","poem":2},{"lineBreak":true},{"text":"ati sanyii Abrahaamii jaala kiyyaa ti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ani qaccee biyya lafaatii si fide;","poem":1},{"text":"biyya fago'oo irraa si waame;","poem":2},{"lineBreak":true},{"text":"ani si'iin, ‹Ati tajaajilaa kiyya› jedhee,","poem":2},{"lineBreak":true},{"text":"si filadhe malee, si hin ganne.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani si woliin waan jiruuf hin sodaatin!","poem":1},{"text":"Ani Waaqa keeti waan te'eef hin rifatin!","poem":2},{"text":"Ani si hin jabeessa; si hin qarqaara;","poem":1},{"text":"harka kiyya middicha balchichaan ol si hin qaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Kunoo, worri sitti aare martinuu","poem":1},{"text":"hin fokkifata; hin qaanowalle'e.","poem":2},{"text":"Worri si irratti ka'u","poem":1},{"text":"akka hin jirre te'anee hin badan.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ati diinota keeti yoo barbaaddelle,","poem":1},{"text":"isaan hin dhaggitu;","poem":2},{"lineBreak":true},{"text":"worri si lolu akka waan hin jirree hin te'an.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ani Mootii Waan Maraa Waaqa keeti,","poem":1},{"text":"ka harka keeti middicha qabee,","poem":2},{"lineBreak":true},{"text":"‹Hin sodaatin; ani si qarqaara› jedhu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mootiin Waan Maraa keeti ka si wodu,","poem":1},{"text":"Woyyichi Israa'elii,","poem":2},{"lineBreak":true},{"text":"‹Ani waan si qarqaaruuf,","poem":2},{"lineBreak":true},{"text":"ee Yaaqoobii dadhabaa akka corroqaa,","poem":2},{"lineBreak":true},{"text":"Israa'elii kolbaa diqqoo tana, hin sodaatin› jedheera.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kunoo, ani meya midhaan ittiin dhowanu,","poem":1},{"text":"haareya qara qabuu fi","poem":2},{"lineBreak":true},{"text":"ka ilkaan hedduu qabu si hin godha.","poem":2},{"lineBreak":true},{"text":"Ati gaarota irra sirbitee hin butuchita;","poem":2},{"lineBreak":true},{"text":"koobotalle akka hicaace'ee hin goota.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ati isaan hin hafarsita;","poem":1},{"text":"qilleensi isaan ol fudhata;","poem":2},{"lineBreak":true},{"text":"bubbeelle isaan hin bittinneessiti.","poem":2},{"text":"Ati ammoo Mootii Waan Maraatitti hin gammadda;","poem":1},{"text":"Woyyicha Israa'eliitiin hin koorta.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Worri hiyyeeyyi'ii fi worri rakkataan,","poem":1},{"text":"bisaan hin barbaadatan;","poem":2},{"lineBreak":true},{"text":"ammoo hin dhaggatanu;","poem":2},{"lineBreak":true},{"text":"arrabi isaanii dheebu'uun gogeera.","poem":2},{"text":"Ani Mootiin Waan Maraa ammoo","poem":1},{"text":"daadimata isaaniitiif deebii hin kenna;","poem":2},{"lineBreak":true},{"text":"ani Waaqi Israa'elii isaan hin lakkisu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ani koobota godduu irraa lagi akka yaa'u;","poem":1},{"text":"dhooqa keessaa maddi akka burqu hin godha.","poem":2},{"text":"Goomolee gara baleessaa,","poem":1},{"text":"lafa godduu gara maddaa hin deebisa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ani goomolee keessatti birbirsi,","poem":1},{"text":"muki gololchaa, muki bisile'ee fi ejersi","poem":2},{"lineBreak":true},{"text":"akka latanu hin godha.","poem":2},{"text":"Gammoojjii keessalle'etti","poem":1},{"text":"hindheensii fi muki hindheensa fakkaatu","poem":2},{"lineBreak":true},{"text":"ka adda addaa akka woliin dhaabamanu hin godha.","poem":2}]},{"type":"verse","number":20,"content":["«Maarre kolbaan marti waan kana dhaggitee hin beetti; harki Mootii Waan Maraa tana akka godhee fi Woyyichi Israa'elii tana akka dade nami marti qalbeeffatee hin hubata» jedhe."]},{"type":"heading","content":["Mootiin Waan Maraa waaqota dharaa Hin Morma"]},{"type":"verse","number":21,"content":["Mootiin Waan Maraa, mootichi Israa'elii, «Haajaa keessan dhikeeffadha'a! Falmii teessanille himadha'a!"]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Waan gara duraa te'uuf jiru","poem":1},{"text":"akka nutti himanuuf,","poem":2},{"lineBreak":true},{"text":"waaqota dharaa keessan as fida'a;","poem":2},{"lineBreak":true},{"text":"nuuti akka qalbeeffannuuf,","poem":2},{"lineBreak":true},{"text":"muummee isi'ii akka beennuuf,","poem":2},{"lineBreak":true},{"text":"waan tanaan qara te'eeru","poem":2},{"lineBreak":true},{"text":"yookiin waan gara duraa te'uuf jiru nutti hima'a.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Akka isin waaqota teetane akka beennuuf,","poem":1},{"text":"me waan ammaa achi te'u nutti hima'a.","poem":2},{"text":"Nuuti rifannee akka sodaannuuf,","poem":1},{"text":"waan dansaa yookiin waan hantuu huja'a.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Isin womaayyuu moti;","poem":1},{"text":"hujiin teessanille ijjumaa bu'aa hin qaddu;","poem":2},{"lineBreak":true},{"text":"nami isin waaqonfatulle ka diqatame.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"«Ani kaaba irraa nama tokko kakkaaseera;","poem":1},{"text":"innille hin dhufa;","poem":2},{"lineBreak":true},{"text":"gara aduun baatuun ka dhufu","poem":2},{"lineBreak":true},{"text":"ka maqaa kiyya waammatu,","poem":2},{"text":"Inni akkuma nami faara dhowu","poem":1},{"text":"biyyee faaraa dhidhiitu,","poem":2},{"lineBreak":true},{"text":"bulchitoota akka dhoqqe'ee hin dhidhiita.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nuuti waan kana akka beennuuf,","poem":1},{"text":"ka duraan dursee dubbate eennu?","poem":2},{"text":"Nuuti, ‹Inni dhugaa jedhe› akka jennuufille,","poem":1},{"text":"ka dur dubbateeru eennu?","poem":2},{"lineBreak":true},{"text":"Eennulle hin dubbanne.","poem":2},{"text":"Nami waan kana dubbate tokkolle hin jiru;","poem":1},{"text":"jecha keessan ka dhage'e tokkolle hin jiru.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Duraan dursee Xiyooniin, ‹Ilaa, kunoo,","poem":1},{"text":"isaan dhufiisatti jiran› jedhee ka hime ana;","poem":2},{"lineBreak":true},{"text":"Yerusaalemille'eef ergamaa oduu gammadaa himu","poem":2},{"lineBreak":true},{"text":"ka erge ana.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ani gara waaqota dharaa yennaa ilaalu,","poem":1},{"text":"isaan keessaa gorsa ka kennu hin jiru;","poem":2},{"lineBreak":true},{"text":"yennaa ani isaan gaafadhulle","poem":2},{"lineBreak":true},{"text":"ka deebii naaf kennu hin jiru.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Kunoo, waaqoti dharaa kun marti dhara;","poem":1},{"text":"waan tokkolle godhuu hin dande'anu;","poem":2},{"lineBreak":true},{"text":"fakkiin isaaniille qilleensa duwwa'a» jedha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/ISA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":29}