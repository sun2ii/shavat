{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"ISA","translationId":"gax_twf","name":"Isaayaasii Raagichaa","commonName":"Isaayaasii Raagichaa","title":"Kitaaba Isaayaasii Raagichaa","order":23,"numberOfChapters":66,"sha256":"43d1d4dce18c16808d379730f9d084e9e041c6b6e6a9b344a406dd4f58553d07","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gax_twf/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":42,"content":[{"type":"heading","content":["Tajaajilaa Mootii Waan Maraa"]},{"type":"verse","number":1,"content":[{"text":"Mootiin Waan Maraa, «Tajaajilaan kiyya","poem":1},{"text":"ka ani ol qabee fi ka ani filadhe,","poem":2},{"lineBreak":true},{"text":"ka ani itti gammadu kana.","poem":2},{"text":"Ani ayyaana kiyyaan isa hin guuta;","poem":1},{"text":"inni gosa biyya adda addaatiif haqa hin fida.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inni hin iyyu yookiin qoonqoo ifii ol hin qabatu;","poem":1},{"text":"qoonqoo ifiille karaa irratti hin dhageessisu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inni shonbooqqoo dhodhootelle hin cassu;","poem":1},{"text":"ifa dhaamiisa geyelle hin dhaanfu;","poem":2},{"lineBreak":true},{"text":"inni addatamumma'aan haqa hin fida.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inni haqa biyya lafaa irratti","poem":1},{"text":"haga fidutti,","poem":2},{"lineBreak":true},{"text":"hin dadhabu, addiille hin kutatu.","poem":2},{"text":"Worri oddoola keessa le'u","poem":1},{"text":"seera isaa addii godhatan» jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"Waaqi ol-gubbaa dadee diriirse,","poem":2},{"lineBreak":true},{"text":"biyya lafaatii fi","poem":2},{"lineBreak":true},{"text":"waan isii keessa jiru mara ka dade,","poem":2},{"lineBreak":true},{"text":"lafa tana irratti namootaaf hafuura ka kenne,","poem":2},{"lineBreak":true},{"text":"worra lafa irra le'u maraafille jiruu ka kenne,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"«Ani Mootiin Waan Maraa","poem":1},{"text":"balchumma'aan si waameera;","poem":2},{"lineBreak":true},{"text":"ani harka si qabee, si eega;","poem":2},{"lineBreak":true},{"text":"kolba'aaf gondooroo,","poem":2},{"lineBreak":true},{"text":"gosa biyya adda addaatiif","poem":2},{"lineBreak":true},{"text":"ifa akka teetu si godheera.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ila worra balla'aa akka bantu,","poem":1},{"text":"worra hidhame akka hiittu,","poem":2},{"lineBreak":true},{"text":"worra dukkana mana hidha'aa keessa jirulle","poem":2},{"lineBreak":true},{"text":"akka baattu si godha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Ani Mootii Waan Maraa ti;","poem":1},{"text":"maqaan kiyya isuma kana;","poem":2},{"lineBreak":true},{"text":"ani ulfinna kiyya waaqota dhibi'iif,","poem":2},{"lineBreak":true},{"text":"leellisa kiyyalle waaqota dharaatiif hin kennu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kunoo, wonni dur dubbatante muummotteerti;","poem":1},{"text":"ani waan haareya isinitti dubbadha;","poem":2},{"lineBreak":true},{"text":"adoo isiin hin te'in isinitti beessisa» jedhe.","poem":2}]},{"type":"heading","content":["Faaruu Leellisaa"]},{"type":"verse","number":10,"content":[{"text":"Isin worri abbaayaa irra ideentanu,","poem":1},{"text":"isin dadi achi keessa leetanu marti,","poem":2},{"lineBreak":true},{"text":"isin worri oddoola keessaa","poem":2},{"lineBreak":true},{"text":"ka achi leetanu marti,","poem":2},{"lineBreak":true},{"text":"faaruu haareya Mootii Waan Maraatiif faarsa'a;","poem":2},{"lineBreak":true},{"text":"haga qaccee lafaatille'etti isa leellifadha'a.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Goomole'ee fi qachooti achi keessa jiranu,","poem":1},{"text":"qoonqoo ifii ol qabatanuu ti;","poem":2},{"lineBreak":true},{"text":"worri Qedaar keessa le'u,","poem":2},{"lineBreak":true},{"text":"isa leellisanuu ti;","poem":2},{"text":"Worri qachaa Selaa keessa le'u","poem":1},{"text":"gammadaan faarsuu ti;","poem":2},{"lineBreak":true},{"text":"worri gaara gubba'aalle ilillisuu ti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Isaan Mootii Waan Maraatiif","poem":1},{"text":"ulfinna kennanuu ti;","poem":2},{"lineBreak":true},{"text":"leellisa isaalle","poem":2},{"lineBreak":true},{"text":"worra oddoola keessaatitti lallabanuu ti.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"akka nama hunnaamessaa hin duula;","poem":2},{"lineBreak":true},{"text":"akka nama gootaa hinaaffaan isaa","poem":2},{"lineBreak":true},{"text":"isa keessaa hin kakkaati;","poem":2},{"lineBreak":true},{"text":"inni qoonqoo guddo'oon geerarsa lolaa hin geerara;","poem":2},{"lineBreak":true},{"text":"diinota ifiille hin injifata.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mootiin Waan Maraa,","poem":1},{"lineBreak":true},{"text":"«Ani yennaa hedduu cadhisee,","poem":1},{"text":"sarmee, ifi qabadhe;","poem":2},{"lineBreak":true},{"text":"amma ammoo akka dubartii ciniinsifattuu","poem":2},{"lineBreak":true},{"text":"hin iyya, ittanaa, hin hargana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ani koobotaa fi gaarota hin onsa;","poem":1},{"text":"waan isaan irratti late mara hin gossa.","poem":2},{"text":"Laga oddoola hin godha;","poem":1},{"text":"baleessalle hin gossa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«Worra ballaa karaa isaan hin beenne irra,","poem":1},{"text":"daandii dur isaan deemanee hin beenne irra,","poem":2},{"lineBreak":true},{"text":"ani isaan hin sooressa;","poem":2},{"lineBreak":true},{"text":"ani isaan duratti dukkana ifa hin godha;","poem":2},{"lineBreak":true},{"text":"daandii kattattaalle wol hin qixxeessa.","poem":2},{"text":"Ani tana isaaniif hin godha;","poem":1},{"text":"isaan hin lakkisu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Worri waaqota dharaatitti addattu,","poem":1},{"text":"ka fakki'iin, ‹Isin waaqota keenna› jedhu,","poem":2},{"lineBreak":true},{"text":"deebi'anee hin qaanowan.","poem":2}]},{"type":"heading","content":["Israa'el Mootii Waan Maraa Caqasuu Didde"]},{"type":"verse","number":18,"content":["«Isin worri duudaan dhage'a'a!",{"text":"Isin worri ballaan ilaala'aa, dhagga'a!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tajaajilaa kiyya malee, ballaan eennu?","poem":1},{"lineBreak":true},{"text":"Ergamaa ani erge malee,","poem":1},{"text":"duudaan eennu?","poem":2},{"text":"Ka akka nama ifi naaf kennee,","poem":1},{"text":"yookiin ka akka tajaajilaa kiyyaa ballaan eennu?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ee Israa'el, isin waan hedduu dhaggitaneertan;","poem":1},{"text":"ammoo hin qalbeeffanne;","poem":2},{"lineBreak":true},{"text":"gurri keessan bana'a;","poem":2},{"lineBreak":true},{"text":"ammoo waan tokkolle hin dhageettanu» jedhe.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mootiin Waan Maraa balchummaa ifiitiif jedhee,","poem":1},{"text":"seera ifii gudda'aa fi","poem":2},{"lineBreak":true},{"text":"ka ulfinna qabu godhiisa jaalate.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kolbaan tun ammoo, saamantee booji'anteerti;","poem":1},{"text":"isaan marti boolla keessatti qabamanee,","poem":2},{"lineBreak":true},{"text":"manni hidha'aa isaanitti cufameera;","poem":2},{"lineBreak":true},{"text":"isaan saamamaneeran;","poem":2},{"lineBreak":true},{"text":"nami isaan baasu hin jiru;","poem":2},{"lineBreak":true},{"text":"isaan booji'amaneeran;","poem":2},{"lineBreak":true},{"text":"ka, «Isaan deebisa'a!» jedhu hin jiru.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Isin keessaa tana ka caqasu eennu?","poem":1},{"text":"Waan dhufu'uu jirulle eentu dhage'ee, qalbeeffata?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yaaqoob worra saamutti dabarsee ka kenne eennu?","poem":1},{"text":"Israa'el worra booji'utti dabarsee ka kenne eennu?","poem":2},{"text":"Mootii Waan Maraa ka nuuti fuula isaa duratti","poem":1},{"text":"cubbuu hunye sanii motii ree?","poem":2},{"text":"Nuuti karaa isaa hin hordonne;","poem":1},{"text":"seera isaatiifille hin ajajanne.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Tanaaf inni aarii ifii ta bobeettuu fi","poem":1},{"text":"woraana hamaa nutti fide.","poem":2},{"lineBreak":true},{"text":"Inni bobe'a ibiddaatiin nu marse;","poem":2},{"lineBreak":true},{"text":"nuuti ammoo hin hubanne;","poem":2},{"lineBreak":true},{"text":"bobe'i ibiddaa nu gube;","poem":2},{"lineBreak":true},{"text":"nuuti ammoo hin qalbeeffanne.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/ISA/41.json","previousChapterAudioLinks":{},"numberOfVerses":25}