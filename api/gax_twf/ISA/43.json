{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"ISA","translationId":"gax_twf","name":"Isaayaasii Raagichaa","commonName":"Isaayaasii Raagichaa","title":"Kitaaba Isaayaasii Raagichaa","order":23,"numberOfChapters":66,"sha256":"43d1d4dce18c16808d379730f9d084e9e041c6b6e6a9b344a406dd4f58553d07","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gax_twf/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":43,"content":[{"type":"heading","content":["Waaqi Kolbaa Ifii Hin Woda"]},{"type":"verse","number":1,"content":[{"text":"Amma ammoo, ee Yaaqoob, ka si dade,","poem":1},{"text":"ee Israa'el, ka si huje,","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa,","poem":2},{"lineBreak":true},{"text":"«Ani waan si wodeef hin sodaatin;","poem":2},{"lineBreak":true},{"text":"ani maqa'aan si waameera, ati kiyya.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yennaa ati bisaan keessa dabartu","poem":1},{"text":"ani si woliin hin jiraadha;","poem":2},{"lineBreak":true},{"text":"yennaa ati laga gamatti buutu","poem":2},{"lineBreak":true},{"text":"bisaan si hin fudhatu;","poem":2},{"lineBreak":true},{"text":"ibidda keessa yennaa ideentu hin gubattu;","poem":2},{"lineBreak":true},{"text":"bobeenni ibiddaalle si hin gubu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ani Mootiin Waan Maraa Waaqi keeti,","poem":1},{"text":"Woyyichi Israa'elii","poem":2},{"lineBreak":true},{"text":"fayyisaa keeti.","poem":2},{"text":"Ani Gibxii wodoo teetiif,","poem":1},{"text":"Itoophiya'aa","poem":2},{"noteId":29},{"text":"fi Saabaa addee teeti hin kenna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ati na duratti gatii guddo'oo fi","poem":1},{"text":"ulfinna waan qadduuf,","poem":2},{"lineBreak":true},{"text":"ani waan si jaaladhuufille addee teeti kolbaa,","poem":2},{"lineBreak":true},{"text":"addee lubbuu teetii gosa biyya adda hin kenna.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ani si woliin waan jiruuf hin sodaatin!","poem":1},{"lineBreak":true},{"text":"Ani ijoollee teeti karaa aduun baatu irraa hin fida;","poem":1},{"text":"karaa aduun seentulle'e isin","poem":2},{"lineBreak":true},{"text":"wolitti hin qaba.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani biyya kaabaatiin, ‹Kolbaa tiyya fida'a!›","poem":1},{"text":"Biyya kibbaatille'een,","poem":2},{"lineBreak":true},{"text":"‹Isaan hin dhooggina'a!› hin jedha;","poem":2},{"lineBreak":true},{"text":"ilmaan tiyya biyya fago'oo irraa,","poem":2},{"lineBreak":true},{"text":"ijoollee tiyya ta durraa qaccee biyya lafaatii fida'a.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kolbaa maqaa kiyyaan waamante mara,","poem":1},{"text":"ta ani ulfinna kiyyaaf dadadhe,","poem":2},{"lineBreak":true},{"text":"ta ani bifa itti tolchee huje fida'a!» hin jedha.","poem":2}]},{"type":"heading","content":["Israa'el Dhugaa Baatota Mootii Waan Maraa Ti"]},{"type":"verse","number":8,"content":["Mootiin Waan Maraa, «Kolbaa tiyya ila adoo qadduu ta hin dhaggine,",{"text":"gurra adoo qadduu ta hin dhageenne fida'a.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gosi biyya adda addaa marti wolitti qabantuu ti;","poem":1},{"text":"kolbaan marti wolitti dachaatuu ti.","poem":2},{"text":"Isaan keessaa duraan dursee tana ka nutti hime,","poem":1},{"text":"waan dur te'eeru ka nutti lasse eennu?","poem":2},{"lineBreak":true},{"text":"Worri dhibiin dhage'ee,","poem":2},{"lineBreak":true},{"text":"‹Tun dhuga'a› akka jedhu,","poem":2},{"lineBreak":true},{"text":"sirrii akka te'ane mirkaneessiisaaf,","poem":2},{"lineBreak":true},{"text":"dhugaa baatota dhikeeffatanuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Isin beettanee,","poem":1},{"text":"akka natti dhugeeffattanu,","poem":2},{"lineBreak":true},{"text":"tana ka godhe ana Waaqa dhuga'aa akka te'e","poem":2},{"lineBreak":true},{"text":"akka hubattanu,","poem":2},{"lineBreak":true},{"text":"isin kolbaan Israa'elii,","poem":2},{"lineBreak":true},{"text":"dhugaa baatota tiyya;","poem":2},{"lineBreak":true},{"text":"tajaajilaan ani filadhelle isinuma;","poem":2},{"text":"Anaan qara waaqi dhibiin hin jiru;","poem":1},{"text":"anaan duuballe hin jiraatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Anumattuu Mootii Waan Maraa ti;","poem":1},{"text":"ana malee fayyisaan dhibiin hin jiru.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ani duraan dursee himeera;","poem":1},{"text":"isin fayyiseera;","poem":2},{"lineBreak":true},{"text":"isinitti dubbadheera;","poem":2},{"lineBreak":true},{"text":"waaqoti ormaa odduu teessanitti","poem":2},{"lineBreak":true},{"text":"tana hin goone.","poem":2},{"text":"Ani Waaqa akka te'e","poem":1},{"text":"isin dhugaa baatota tiyya.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ani duruuyyuu Waaqa;","poem":1},{"text":"gara duraalle ka jiraatu anuma.","poem":2},{"text":"Eennulle harka kiyya keessaa bawuu hin dande'u;","poem":1},{"text":"waan ani huju eentu jijjiiruu dande'a?» jedhe.","poem":2}]},{"type":"heading","content":["Israa'el Baabilon Jalaa Baate"]},{"type":"verse","number":14,"content":["Mootiin Waan Maraa ka isin wode, Woyyichi Israa'elii,",{"text":"«Ani marroo teessaniif jedhee","poem":2},{"lineBreak":true},{"text":"loltoota tiyya Baabilonitti hin erga;","poem":2},{"lineBreak":true},{"text":"karra qachaa Baabilonii mara hin caccassa;","poem":2},{"lineBreak":true},{"text":"geerarsa worra Baabiloniille bowatti hin jijjiira.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ani Mootiin Waan Maraa Woyyichi keessan,","poem":1},{"text":"ka Israa'el dade,","poem":2},{"lineBreak":true},{"text":"mootii keessan» jedha.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mootiin Waan Maraa abbaayaa keessatti karaa,","poem":1},{"text":"bisaan jabaa keessatti daandii ka baase,","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"garreettota fardo'oon harkifamuu fi fardoo,","poem":2},{"lineBreak":true},{"text":"loltootaa fi gootota deebi'anee akka hin kaane,","poem":2},{"lineBreak":true},{"text":"achumatti akka hafanu,","poem":2},{"lineBreak":true},{"text":"akka bobe'a dhaamuu ka dhaanfe,","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"«Waan durii dedha'a;","poem":2},{"lineBreak":true},{"text":"waan dabare hin yaadina'a.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kunoo, ani waan haareya hin godha;","poem":1},{"text":"isiin ammuma hin teeti;","poem":2},{"lineBreak":true},{"text":"isin hin hubatanuu?","poem":2},{"text":"Ani goomolee keessatti karaa,","poem":1},{"text":"lafa godduu keessalle'etti bisaan hin baasa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ani kolbaa tiyya ta filadhe obaasiisaaf,","poem":1},{"text":"goomolee keessatti bisaan,","poem":2},{"lineBreak":true},{"text":"lafa godduu keessalle'etti","poem":2},{"lineBreak":true},{"text":"lagi akka yaa'u waan godhuuf,","poem":2},{"lineBreak":true},{"text":"bineensoti, jeedalli fi guchiin","poem":2},{"lineBreak":true},{"text":"ulfinna naaf hin kennan.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kolbaan ani ifiif dadadhelle","poem":1},{"text":"na hin leellifatti» jedha.","poem":2}]},{"type":"heading","content":["Cubbuu Israa'elii"]},{"type":"verse","number":22,"content":["Mootiin Waan Maraa, «Ee Yaaqoob, ati na hin waammanne;",{"text":"ee Israa'el, ati na tajaajiliisa dadhaddeerta.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ciincaa naaf dhikeessiisaaf","poem":1},{"text":"hoolee naaf hin finne;","poem":2},{"lineBreak":true},{"text":"ciincaa teetille'een","poem":2},{"lineBreak":true},{"text":"ulfinna naaf hin kennine.","poem":2},{"text":"Kennansa midhaanii akka naaf dhikeessitu,","poem":1},{"text":"ani ba'aa si'itti hin teene;","poem":2},{"lineBreak":true},{"text":"hixaana akka naaf aarsituufille","poem":2},{"lineBreak":true},{"text":"si hin dadhassiinne.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Beesee teetiin dakkara naaf hin binne;","poem":1},{"text":"yookiin ciincaa coomaa teetille'een","poem":2},{"lineBreak":true},{"text":"dharraa na hin baanne;","poem":2},{"lineBreak":true},{"text":"ammoo cubbuu teetiin ba'aa natti teetee,","poem":2},{"lineBreak":true},{"text":"yakkaa teetiin na dadhassiitte.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ka ifumaaf jedhee,","poem":1},{"text":"yakkaa teeti si irraa balleessu anuma;","poem":2},{"lineBreak":true},{"text":"ani cubbuu teeti","poem":2},{"lineBreak":true},{"text":"deebi'ee si irratti hin laakkowu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"«Waan si godhe himadhu me!","poem":1},{"text":"Waan kana wol falmannuu ti;","poem":2},{"lineBreak":true},{"text":"sirrii akka teete himi.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Abbaan keeti ka qaraa cubbuu hujeera;","poem":1},{"text":"namooti si'iif dubbatanulle","poem":2},{"lineBreak":true},{"text":"na finqilaneeran.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Tanaaf ani qondaaltota","poem":1},{"text":"Galma keessaa hin salphisa;","poem":2},{"lineBreak":true},{"text":"Yaaqoob ijjumaa balleessee,","poem":2},{"lineBreak":true},{"text":"Israa'el hin qaanessa» jedha.","poem":2}]}],"footnotes":[{"noteId":29,"caller":"+","text":"Itoophiyaa: Yaadannoo Dad. 2:13 irratti kenname ilaali.","reference":{"chapter":43,"verse":3}}]},"thisChapterLink":"/api/gax_twf/ISA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/ISA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":28}