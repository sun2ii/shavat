{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"ISA","translationId":"gax_twf","name":"Isaayaasii Raagichaa","commonName":"Isaayaasii Raagichaa","title":"Kitaaba Isaayaasii Raagichaa","order":23,"numberOfChapters":66,"sha256":"43d1d4dce18c16808d379730f9d084e9e041c6b6e6a9b344a406dd4f58553d07","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gax_twf/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":45,"content":[{"type":"heading","content":["Mootiin Waan Maraa Qiiros Mootii Godhe"]},{"type":"verse","number":1,"content":[{"text":"Mootiin Waan Maraa ka harka isaa middicha qabee,","poem":1},{"text":"gosa biyya adda addaa akka inni harka ifii jala galfatuuf,","poem":2},{"lineBreak":true},{"text":"mootota irraa meya woraanaa akka inni hiikuuf,","poem":2},{"lineBreak":true},{"text":"karri qacha'aa akka isatti hin cufanneef,","poem":2},{"lineBreak":true},{"text":"cufanaan isa duraa akka banamuuf,","poem":2},{"lineBreak":true},{"text":"Qiirosii akka mootii te'u muudeen,","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«Ani siin dura hin deema;","poem":2},{"lineBreak":true},{"text":"gaarota dirree hin godha.","poem":2},{"text":"Karra qacha'aa ta sageettuu irraa hujante hin caccassa;","poem":1},{"text":"danqaraa sibiilaalle hin mura.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ka maqaa keetiin si waame,","poem":1},{"text":"ana Mootii Waan Maraa Waaqa Israa'elii","poem":2},{"lineBreak":true},{"text":"akka te'e akka ati beettuuf,","poem":2},{"lineBreak":true},{"text":"ani qabeenna dukkana keessa jiruu fi","poem":2},{"lineBreak":true},{"text":"durummaa addee dhossa'aatitti kuufante si'iif hin kenna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ati na beekuu dhaddulle,","poem":1},{"text":"marroo tajaajilaa kiyyaa Yaaqoobii,","poem":2},{"lineBreak":true},{"text":"Israa'elii filadheef jedhee,","poem":2},{"lineBreak":true},{"text":"maqaa keetiin si waamee","poem":2},{"lineBreak":true},{"text":"maqaa ulfinnaa","poem":2},{"lineBreak":true},{"text":"si'iif kenneera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ani Mootii Waan Maraa ti;","poem":1},{"text":"ana malee ka dhibiin hin jiru.","poem":2},{"text":"Waaqi na qofa;","poem":1},{"text":"ati na beekuu dhaddulle,","poem":2},{"lineBreak":true},{"text":"ani si hin jabeessa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Namooti karaa aduun baatuu","poem":1},{"text":"haga karaa aduun seentuu","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa na qofa akka te'e,","poem":2},{"lineBreak":true},{"text":"ana malee ka dhibiin akka hin jirre","poem":2},{"lineBreak":true},{"text":"akka beekanuuf,","poem":2},{"lineBreak":true},{"text":"ani tana godhe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ani ifaa fi dukkana dade;","poem":1},{"text":"ani nageya hin buusa;","poem":2},{"lineBreak":true},{"text":"balaalle hin buusa;","poem":2},{"lineBreak":true},{"text":"ani Mootiin Waan Maraa tana mara godha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ee ol-gubba'a, gubbaa irraa balchummaa gad roobi;","poem":1},{"text":"duumensille balchummaa gad roobuu ti;","poem":2},{"lineBreak":true},{"text":"latti banantee, fayyinni latuu ti;","poem":2},{"lineBreak":true},{"text":"balchummaalle isa woliin guddattuu ti.","poem":2},{"text":"Ani Mootiin Waan Maraa tana mara dade» jedha.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nama ka isa Dade woliin moromuuf aanne'e!","poem":1},{"text":"Inni akka faaraa","poem":2},{"lineBreak":true},{"text":"harka nama faara dhowu keessa jiruu ti;","poem":2},{"lineBreak":true},{"text":"faarri nama isa dhowuun,","poem":2},{"lineBreak":true},{"text":"«Ati maan hujaarta?» hin jedhaa ree?","poem":2},{"text":"Wonni inni dhowu sunille,","poem":1},{"text":"«Ati harka hin qaddu» hin jedhaa ree?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mucaa abbaa ifiitiin,","poem":1},{"text":"«Ati maaf na uumatte?»,","poem":2},{"text":"Haadha ifiitille'een,","poem":1},{"text":"«Ati maaf na deette?» jedhuuf aanne'e!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mootiin Waan Maraa Woyyichi Israa'elii ka isii dade,","poem":1},{"text":"«Marroo waan te'uu jiruu,","poem":2},{"lineBreak":true},{"text":"marroo ijoollee tiyyaa na gaafattanii ree?","poem":2},{"lineBreak":true},{"text":"Marroo hujii harka kiyyaalle","poem":2},{"lineBreak":true},{"text":"na ajajjanii ree?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lafa dadee, namootalle isii irratti ka dade ana;","poem":1},{"text":"ol-gubbaa harka kiyyaan diriirsee,","poem":2},{"lineBreak":true},{"text":"urjoota ol-gubba'aalle ka ajaje anuma.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ani balchumma'aan Qiiros kaaseera;","poem":1},{"text":"karaa isaa duudiille qajeelcheera.","poem":2},{"text":"Inni qachaa kiyya deebisee hin ijaara;","poem":1},{"text":"worra na duraa booji'ame","poem":2},{"lineBreak":true},{"text":"gatii malee yookiin kaffaltii malee","poem":2},{"lineBreak":true},{"text":"bilisa hin baasa» jedha","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa Ka Waan Mara Dade.","poem":2}]},{"type":"verse","number":14,"content":["Mootiin Waan Maraa,",{"text":"«Karri worra Gibxi'ii,","poem":1},{"text":"bu'aan daldala worra Itoophiya'aalle","poem":2},{"noteId":30},{"text":"si'iif hin te'a;","poem":2},{"lineBreak":true},{"text":"worri Saaba'aa dhedheeraan gara keeti dhufanee,","poem":2},{"lineBreak":true},{"text":"keeti hin te'an;","poem":2},{"lineBreak":true},{"text":"wodaroo sibiilaatiin hidhamanee, si gula hin deeman;","poem":2},{"lineBreak":true},{"text":"si duratti sagadaa, ‹Dhugumaan Waaqi si woliin jira;","poem":2},{"lineBreak":true},{"text":"isa malee Waaqi dhibiin hin jiru› jedhaa","poem":2},{"lineBreak":true},{"text":"si daadimatan» jedhe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ee Waaqa, fayyisaa Israa'elii,","poem":1},{"text":"ati dhugumaan Waaqa ifi dhossitu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Worri waaqota dharaa hujatu marti","poem":1},{"text":"hin qaanowan; hin salphatan;","poem":2},{"lineBreak":true},{"text":"isaan marti wolumatti hin salphatan.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mootiin Waan Maraa ammoo,","poem":1},{"text":"fayyinna bara baraatiin Israa'el hin fayyisa;","poem":2},{"lineBreak":true},{"text":"ee Israa'el, ati haga bara baraa hin qaanottu;","poem":2},{"lineBreak":true},{"text":"hin salphattulle'e.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ka ol-gubbaa dade, inni Mootii Waan Maraa ti;","poem":1},{"text":"Inni lafa bifa itti godhee, jabeessee yennaa dhaabe,","poem":2},{"lineBreak":true},{"text":"akka irra le'anuuf malee, ona akka teetuuf hin danne.","poem":2},{"text":"Inni, «Ani Mootii Waan Maraa ti;","poem":1},{"text":"ana malee Waaqi dhibiin hin jiru.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ani lafa dukkanaa keessaa, dhossa'aan hin dubbanne.","poem":1},{"lineBreak":true},{"text":"Ani sanyii Yaaqoobiitiin,","poem":1},{"text":"‹Akkasumaan na barbaada'a› hin jenne;","poem":2},{"lineBreak":true},{"text":"ani Mootiin Waan Maraa dhugaa dubbadha;","poem":2},{"lineBreak":true},{"text":"waan sirrii te'e lassa.","poem":2}]},{"type":"verse","number":20,"content":["«Isin worri gosa biyya adda addaa keessaa",{"text":"badii irraa ka hattane,","poem":2},{"lineBreak":true},{"text":"wolitti qabama'aatii kowa'a; as dhikaadha'a.","poem":2},{"text":"Worri fakkii waaqota dharaa","poem":1},{"text":"Ka muka irraa hujante, ba'atee ideemuu fi","poem":2},{"lineBreak":true},{"text":"waaqa nama fayyisuu hin dandeenne daadimatu","poem":2},{"lineBreak":true},{"text":"beekkumsa hin qabu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Haajaa keessan dubbadha'aatii dhikeeffadha'a;","poem":1},{"text":"wolitti qabama'aatii mari'adha'a.","poem":2},{"text":"Bara dheera'aan dura eennutti tana hime?","poem":1},{"text":"Duraan dursee eentu raage?","poem":2},{"lineBreak":true},{"text":"Ana Mootii Waan Maraatii motii?","poem":2},{"text":"Ana malee, Waaqi balcha'aa fi fayyisaan","poem":1},{"text":"dhibiin hin jiru.","poem":2},{"lineBreak":true},{"text":"Ana malee ka dhibiin hin jiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Ana malee Waaqi dhibiin waan hin jirreef,","poem":1},{"text":"isin worri qaccee biyya lafaa jirtanu marti,","poem":2},{"lineBreak":true},{"text":"gara kiyya deebi'a'a'aatii fayya'a!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nami marti na duratti hin jilbiiffata;","poem":1},{"text":"arrabi martinuu anaan hin kakata;","poem":2},{"lineBreak":true},{"text":"jechi balchumma'aan afaan kiyya keessaa baye,","poem":2},{"lineBreak":true},{"text":"akka hin jijjiirane,","poem":2},{"lineBreak":true},{"text":"ani maqaa kiyyaan kakadheera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"«Namooti marroo tiyya, ‹Balchumma'aa fi jabeenni","poem":1},{"text":"Mootii Waan Maraa qofa biraa dhaggama› hin jedhan» jedhe.","poem":2},{"text":"Worri na mormu marti gara kiyya dhufanee hin qaanowan.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Sanyiin Israa'elii marti","poem":1},{"text":"ana Mootii Waan Maraatiin","poem":2},{"lineBreak":true},{"text":"balchumma'aa fi ulfinna hin dhaggatan.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":30,"caller":"+","text":"Itoophiyaa: Afaan Ibrootaatiin Kuushi jedha.","reference":{"chapter":45,"verse":14}}]},"thisChapterLink":"/api/gax_twf/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}