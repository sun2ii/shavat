{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"ISA","translationId":"gax_twf","name":"Isaayaasii Raagichaa","commonName":"Isaayaasii Raagichaa","title":"Kitaaba Isaayaasii Raagichaa","order":23,"numberOfChapters":66,"sha256":"43d1d4dce18c16808d379730f9d084e9e041c6b6e6a9b344a406dd4f58553d07","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gax_twf/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":46,"content":[{"type":"heading","content":["Waaqota Worra Baabilonii"]},{"type":"verse","number":1,"content":[{"text":"Waaqoti dharaa ka worra Baabilonii,","poem":1},{"text":"Beelii fi Neboon hin salphatan;","poem":2},{"lineBreak":true},{"text":"waaqoti dharaa ka isaanii sun geejjibatti fe'amaneeran;","poem":2},{"lineBreak":true},{"text":"fakkiin isaan ba'atanee ideemanu sun ba'a'a;","poem":2},{"lineBreak":true},{"text":"geejjiba itti fe'amane sanille hin dadhassiisan.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isaan geejjiba san woliin hin gugguufan;","poem":1},{"text":"ifi fayyisuu hin dande'anu;","poem":2},{"lineBreak":true},{"text":"isaan hin booji'aman.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mootiin Waan Maraa, «Ee sanyii Yaaqoobii,","poem":1},{"text":"isin sanyii Israa'elii keessaa worri hattane na dhage'a'a!","poem":2},{"text":"Gadaamessa haadha teessanii keessatti natti isin eege;","poem":1},{"text":"dhaloota keessaniin jalqabee","poem":2},{"lineBreak":true},{"text":"ka isin ba'ate ana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Haga isin dulloontanee arrii baatanutti","poem":1},{"text":"ka isin ba'atu ana;","poem":2},{"lineBreak":true},{"text":"ani isin dadeera; isin hin ba'adha;","poem":2},{"lineBreak":true},{"text":"isin hin qarqaara; isin hin fayyisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Eennuun na fakkeessitan?","poem":1},{"text":"Eennu woliin na wol qixxeessitan?","poem":2},{"lineBreak":true},{"text":"Yookiin akka wol fakkaannuuf,","poem":2},{"lineBreak":true},{"text":"eennu woliin na wol fakkeessitan?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Worri gariin worqii subba ifii keessaa baafatan;","poem":1},{"text":"meetiille madaala irratti madaalan.","poem":2},{"text":"Isaan nama worqii baqisiisu qaxaratanee,","poem":1},{"text":"inni waaqa isaaniif huja;","poem":2},{"lineBreak":true},{"text":"achiin duuba isaan waaqa san sagadanee waaqonfatan.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Isaan waaqa san ol fuudhanee, gurmuu ifii irratti ba'atanee,","poem":1},{"text":"geessanee addee isaaf qophootte hin keyan.","poem":2},{"text":"Inni achuma dhaabbata malee, addee san irraa hin tacho'u;","poem":1},{"text":"yoo nami isatti iyyate, inni deebii hin kennu;","poem":2},{"lineBreak":true},{"text":"yookiin rakkoo keessaa nama hin baasu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Isin finqiltooti tana qaabadha'a!","poem":1},{"text":"Qalbii teessanille'etti qabadha'a.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Waan dur bara dheera'aan dura te'e qaabadha'a;","poem":1},{"text":"ani Waaqa;","poem":2},{"lineBreak":true},{"text":"ana malee Waaqi dhibiin hin jiru;","poem":2},{"lineBreak":true},{"text":"ka akka kiyyaalle hin jiru.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani waan muummee irratti dhufu'uu jiru","poem":1},{"text":"jalqaba irratti himeera;","poem":2},{"lineBreak":true},{"text":"waan gara duraa te'uu jirulle duruu himeera;","poem":2},{"lineBreak":true},{"text":"karoorri kiyya hin te'a;","poem":2},{"lineBreak":true},{"text":"waan godhiisaaf barbaade hin godha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ani nama karoora kiyya muummessu","poem":1},{"text":"karaa aduun baatuu irraa hin waama;","poem":2},{"lineBreak":true},{"text":"inni akka risa'aa biyya fago'oo irraa hin dhufa.","poem":2},{"text":"Ani waan dubbadhe hin godha;","poem":1},{"text":"karoora kiyyalle hin muummessa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Isin worri gadhaa jabaattane,","poem":1},{"text":"ka balchummaa irraa fagaattane na caqasa'a.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ani balchummaa tiyya fidiisatti jira;","poem":1},{"text":"isiille fagoo hin jirtu;","poem":2},{"lineBreak":true},{"text":"fayyisiis kiyya hin turu;","poem":2},{"lineBreak":true},{"text":"ani Xiyooniif fayyinna,","poem":2},{"lineBreak":true},{"text":"Israa'eliif ulfinna hin kenna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/ISA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/ISA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/ISA/45.json","previousChapterAudioLinks":{},"numberOfVerses":13}