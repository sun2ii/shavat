{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"ISA","translationId":"gax_twf","name":"Isaayaasii Raagichaa","commonName":"Isaayaasii Raagichaa","title":"Kitaaba Isaayaasii Raagichaa","order":23,"numberOfChapters":66,"sha256":"43d1d4dce18c16808d379730f9d084e9e041c6b6e6a9b344a406dd4f58553d07","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gax_twf/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":47,"content":[{"type":"heading","content":["Jinnana Baabilonii"]},{"type":"verse","number":1,"content":[{"text":"«Ee durrittii Baabilonii,","poem":1},{"text":"gad bu'iitii bukuu irra tee'i.","poem":2},{"text":"Ee durrittii Baabilonii,","poem":1},{"text":"barcumaa mootummaa teetii irraa ka'iitii, lafa irra tee'i;","poem":2},{"lineBreak":true},{"text":"ati haganaa achi,","poem":2},{"lineBreak":true},{"text":"‹Bosoqqee yookiin shaggittii› hin jedhantu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Shaashii teeti ta hagooggatte ifi irraa fuudhiitii,","poem":1},{"text":"daakuu fudhadhuutii midhaan daaki;","poem":2},{"lineBreak":true},{"text":"woyaa teeti ifi irraa shooqadhuu","poem":2},{"lineBreak":true},{"text":"sarbaa teeti mudhisaa,","poem":2},{"lineBreak":true},{"text":"laga gamatti bu'i.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Qullaa jirtuun kolbaan si hin dhaggiti;","poem":1},{"text":"nafi hilaa keeti hin mudhata;","poem":2},{"lineBreak":true},{"text":"Ani haluu hin baya; nama tokkolle hin hamburu» jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ka nu wodu Woyyicha Israa'elii,","poem":1},{"text":"maqaan isaa Mootii Waan Maraa Ka Waan Mara Dade.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mootiin Waan Maraa Baabiloniin,","poem":1},{"lineBreak":true},{"text":"«Ee intala Baabilonii,","poem":1},{"text":"dhaqiitii, cadhisii dukkana keessa tee'i.","poem":2},{"lineBreak":true},{"text":"Haganaa achi, ‹Giittii mootummoota› jedhantee hin waammantu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani kolbaa tiyyatti aaree,","poem":1},{"text":"akka batti'iititti isaan laakkowee","poem":2},{"lineBreak":true},{"text":"harka keetitti dabarsee isaan kenne.","poem":2},{"text":"Ati isaaniif hin mararre;","poem":1},{"text":"ati worra dulloomettuu,","poem":2},{"lineBreak":true},{"text":"waanjoo ulfaattuu itti feete.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ati, ‹Ani haga bara baraa giittii hin te'a› jette malee,","poem":1},{"text":"waan tolchite hin qaabanne;","poem":2},{"lineBreak":true},{"text":"muummee waan saniille hin beenne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Ee ati ta qananummaa jaalattu!","poem":1},{"text":"Ta bidhaa malee teettu,","poem":2},{"lineBreak":true},{"text":"gadhaa keeti keessatti,","poem":2},{"lineBreak":true},{"text":"‹Ana malee nami dhibiin hin jiru;","poem":2},{"lineBreak":true},{"text":"ani ijjumaa haadha hiyyeessaa hin te'u;","poem":2},{"lineBreak":true},{"text":"yookiin ijoolleen tiyyalle na duraa hin duutu› ta jettu dhage'i!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ati xano'oo fi falfala hedduu qabaatulle,","poem":1},{"text":"duuti ijoolle'eetii fi haadha hiyyeessaa te'iis,","poem":2},{"lineBreak":true},{"text":"wonni lamaan kun dedhuma guyyaa tokkotti sitti hin dhufan.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ati hammeenna keetitti addattee,","poem":1},{"text":"‹Nami na dhaggu hin jiru› jette;","poem":2},{"text":"Qarumma'aa fi beekkumsi keeti si dokonkorsee,","poem":1},{"text":"gadhaa keeti keessatti,","poem":2},{"lineBreak":true},{"text":"‹Ani anuma; ana malee nami dhibiin hin jiru› jette.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wonni hantuun ati xano'oon ifi irraa fageessiisa hin dandeenne","poem":1},{"text":"sitti hin dhutti;","poem":2},{"lineBreak":true},{"text":"balaan ati ifi irraa dhooggatiisa hin dandeenne","poem":2},{"lineBreak":true},{"text":"sitti hin dhufa;","poem":2},{"lineBreak":true},{"text":"badiin ati hin beennelle dedhuma sitti hin dhutti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Xano'oo fi falfala keeti","poem":1},{"text":"ka ijoollummaa teetiin jalqadde, itti fufi.","poem":2},{"text":"Akka wotoo si'iif hin milkootti","poem":1},{"text":"yookiin diinota keeti sodaachisiisaaf","poem":2},{"lineBreak":true},{"text":"si hin qarqaaran fa'a.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gorsa bacaa dhage'iis si dadhassiiseera;","poem":1},{"text":"worri gubbaa qorqoru,","poem":2},{"lineBreak":true},{"text":"ka ji'uma ji'aan urjii ilaalee","poem":2},{"lineBreak":true},{"text":"waan gara duraa te'u himu,","poem":2},{"lineBreak":true},{"text":"gara duraa dhufee","poem":2},{"lineBreak":true},{"text":"waan sitti dhufu jalaa si baasuu ti.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kunoo, isaan akka huuraa ti;","poem":1},{"text":"ibiddi isaan hin nyaata.","poem":2},{"text":"Isaan hunna bobe'a ibiddaa san jalaa","poem":1},{"text":"ifi baasuu hin dande'anu;","poem":2},{"lineBreak":true},{"text":"kashilli nami o'ifatu hin hafu yookiin","poem":2},{"lineBreak":true},{"text":"ibiddi bira tee'anee o'ifatanulle hin jiraatu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Daldaltooti teeti ta ati ijoollummaa teeti irraa jalqaddee,","poem":1},{"text":"woliin elootte akkasuma.","poem":2},{"text":"Tokko tokkoon isaanii dokonkora ifiitiin deeman;","poem":1},{"text":"nami si baasu tokkolle hin jiru» jedha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}