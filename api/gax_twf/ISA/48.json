{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"ISA","translationId":"gax_twf","name":"Isaayaasii Raagichaa","commonName":"Isaayaasii Raagichaa","title":"Kitaaba Isaayaasii Raagichaa","order":23,"numberOfChapters":66,"sha256":"43d1d4dce18c16808d379730f9d084e9e041c6b6e6a9b344a406dd4f58553d07","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gax_twf/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":48,"content":[{"type":"heading","content":["Israa'elii Mataa Jabaattu"]},{"type":"verse","number":1,"content":["Ee ijoollee Yaaqoobii,",{"text":"ta, «Israa'el» jedhantanu,","poem":2},{"lineBreak":true},{"text":"worri sanyii Yihuda'aa keessaa dhalattane,","poem":2},{"lineBreak":true},{"text":"isin worri maqaa Mootii Waan Maraatiin kakattanu,","poem":2},{"lineBreak":true},{"text":"dhuga'aa fi balchumma'aan adoo hin te'in,","poem":2},{"lineBreak":true},{"text":"Waaqa Israa'elii ka waammattanu, tana dhage'a'a.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isin, «Nuuti worra qachaa woyyicha keessa le'u;","poem":1},{"text":"worra Mootii Waan Maraa Waaqa Israa'elii","poem":2},{"lineBreak":true},{"text":"Ka Waan Mara Dadetti addatu» ifiin jettanu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mootiin Waan Maraa,","poem":1},{"text":"«Waan dur bara dheera'aan dura te'e ani dursee himeera;","poem":2},{"lineBreak":true},{"text":"afaan kiyyalle'een dubbadhee,","poem":2},{"lineBreak":true},{"text":"akka wonni sun beekkantu godheera;","poem":2},{"lineBreak":true},{"text":"ani dedhuma isin irratti hujee, wonni sun muummotte.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isin worra mataa-jabaatu akka teetane ani beekeera;","poem":1},{"text":"morgey morma keessanii akka sibiilaa,","poem":2},{"lineBreak":true},{"text":"addi fuula keessaniille akka sageettu'uu ti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tanaaf, isin, ‹Waaqota dharaa keennatti tana huje;","poem":1},{"text":"fakkii teenna ta muka irraa bocantee fi","poem":2},{"lineBreak":true},{"text":"waaqa keenna ka sibiilaatitti tana ajaje› akka hin jinneef,","poem":2},{"lineBreak":true},{"text":"ani dursee isinitti himeera.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isin tana dhageettaneertan; isaan mara ilaala'a;","poem":1},{"text":"wonni ani jedhe dhugaa akka teete,","poem":2},{"lineBreak":true},{"text":"isin dhugaa hin baatanuu ree?","poem":2},{"text":"Ammaan jalqabee waan haareya,","poem":1},{"text":"waan dhossa'aa ka isin hin beenne ani isinitti hin hima.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wonni kun amma dadamane malee,","poem":1},{"text":"bara dheera'aan duraa moti;","poem":2},{"lineBreak":true},{"text":"tanaan qara marroo waan kanaa dhageettanee hin beettanu.","poem":2},{"text":"Maarre isin, ‹Nuuti marroo waan kanaa","poem":1},{"text":"duruu beenna› jedhuu hin dandeettanu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Isin dur tana hin dhageenne; hin beennelle'e;","poem":1},{"text":"duruuyyuu gurri keessan hin bananne.","poem":2},{"text":"Ani akka isin sobaaleyyii teetane,","poem":1},{"text":"haga dhalataneen jalqaddanee","poem":2},{"lineBreak":true},{"text":"finqiltoota akka teetane beekeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Ani maqaa kiyyaaf jedhee,","poem":1},{"text":"dafee hin aaru;","poem":2},{"lineBreak":true},{"text":"kolbaan akka na leellifattuuf jedhee,","poem":2},{"lineBreak":true},{"text":"isin balleessiisa irraa hin ossadha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kunoo, akka meetii ibiddaan qulqulleessanu adoo hin te'in,","poem":1},{"text":"rakkoo akka ibiddaatiin haga isin ilaaleera.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ani ifumaaf, ifii tiyyaaf jedhee, tana hin godha;","poem":1},{"text":"ani attam salphinnaaf ifi dabarsee kenna ree?","poem":2},{"lineBreak":true},{"text":"Ulfinna kiyya eennulle'eef hin kennu.","poem":2}]},{"type":"heading","content":["Israa'el Bilisa Hin Baati"]},{"type":"verse","number":12,"content":[{"text":"Ee Yaaqoob, Israa'elii ani waammadhe,","poem":1},{"text":"na caqasa'a!","poem":2},{"text":"Ani Waaqa;","poem":1},{"text":"ka duraatii fi ka duubaalle ana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Harka kiyyaan hundee lafaa hundeesse;","poem":1},{"text":"harki kiyya middichi ol-gubbaa diriirse;","poem":2},{"lineBreak":true},{"text":"yennaa ani isaan waamu","poem":2},{"lineBreak":true},{"text":"isaan marti adduma tokko ol ka'an.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Isin marti wolitti qabama'aatii,","poem":1},{"text":"na caqasa'a!","poem":2},{"lineBreak":true},{"text":"Ka ani Mootiin Waan Maraa filadhe,","poem":2},{"lineBreak":true},{"text":"karoora ani Baabilon irratti baase","poem":2},{"lineBreak":true},{"text":"akka muummessu'uuf jiru,","poem":2},{"lineBreak":true},{"text":"akki ani irree tiyya Baabilon irratti","poem":2},{"lineBreak":true},{"text":"akka ani ol fudhatu'uu jiru,","poem":2},{"lineBreak":true},{"text":"waaqota dharaa keessaa","poem":2},{"lineBreak":true},{"text":"dursee ka hime eennu?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Anattuu dubbate; anattuu isa waame;","poem":1},{"text":"ani isa hin fida; hujiin isaalle hin teetiif.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«Gara kiyya kowa'aatii, tana caqasa'a!","poem":1},{"text":"Ani jalqabaanuu jalqabee dhossa'aan hin dubbanne;","poem":2},{"lineBreak":true},{"text":"wonni ani dubbadhe","poem":2},{"lineBreak":true},{"text":"yennaa muummottulle ani achuma jiraayyu» jedha.","poem":2},{"lineBreak":true},{"text":"Ammalle Goottaan Mootiin Waan Maraa","poem":1},{"text":"Ayyaana ifiitiin na ergeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mootiin Waan Maraa ka isin wodu,","poem":1},{"text":"Woyyichi Israa'elii,","poem":2},{"text":"«Ani Mootiin Waan Maraa Waaqa keessan,","poem":1},{"text":"ka waan dansaa akka gootanu isin barsiisu,","poem":2},{"lineBreak":true},{"text":"karaa isin deentanu ka isin sooressu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«Isin ajaja kiyya adoo eegattanee jiraattane,","poem":1},{"text":"silaa nageenni keessan akka laga guutee yaa'uu,","poem":2},{"lineBreak":true},{"text":"balchummaan teessanille","poem":2},{"lineBreak":true},{"text":"akka danbalii abbaaya'aa hin teetiiyyu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sanyiin teessan akka maansaa,","poem":1},{"text":"ijoolleen teessanille akka buku'uu hin bacattiiyyu.","poem":2},{"text":"Maqaan isaanii fuula kiyya duraa ijjumaa hin haxowamu,","poem":1},{"text":"yookiin hin badu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«Biyya Baabilonii keessaa baya'a;","poem":1},{"text":"worra Baabilonii jalaa baqadha'a!","poem":2},{"text":"‹Mootiin Waan Maraa tajaajilaa ifii Yaaqoob wodeera› jedha'aatii hima'a!","poem":1},{"text":"Ilillisaa odeessaa, haga qaccee lafaa lassa'a.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yennaa ani goomolee keessa isaan sooresse,","poem":1},{"text":"isaan hin dheebonne;","poem":2},{"lineBreak":true},{"text":"ani rassaa keessaa bisaan isaaniif baase;","poem":2},{"lineBreak":true},{"text":"rassaa dhoosee bisaan achi keessaa dhuqatee baye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Worra hamaaleyyi'iif nageenni hin jiru» jedha.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/ISA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/ISA/47.json","previousChapterAudioLinks":{},"numberOfVerses":22}