{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"ISA","translationId":"gax_twf","name":"Isaayaasii Raagichaa","commonName":"Isaayaasii Raagichaa","title":"Kitaaba Isaayaasii Raagichaa","order":23,"numberOfChapters":66,"sha256":"43d1d4dce18c16808d379730f9d084e9e041c6b6e6a9b344a406dd4f58553d07","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gax_twf/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":50,"content":[{"type":"verse","number":1,"content":["Mootiin Waan Maraa, «Barreeffam ani ittiin",{"text":"haadha teessan lakkise meet ree?","poem":2},{"lineBreak":true},{"text":"Yookiin nama liqaa na irraa qabu keessaa","poem":2},{"lineBreak":true},{"text":"ani eennutti isin itti gurguradhe?","poem":2},{"text":"Isin cubbuu teessaniif gurgurantane;","poem":1},{"text":"haati teessanille yakkaa teessaniif lakkifante.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ani yennaa dhufe maaf","poem":1},{"text":"nama tokkolle achii dhabe?","poem":2},{"text":"Yennaa waamelle maaf nama owwaatu dhabe?","poem":1},{"lineBreak":true},{"text":"Harki kiyya gabaabbatee isin wodiisa dadhabee?","poem":1},{"lineBreak":true},{"text":"Yookiin hunna ittiin isin fayyisu dhabee?","poem":1},{"text":"Ani xixicha kiyyaan abbaayaa hin gossa;","poem":2},{"lineBreak":true},{"text":"lagoota goomolee hin godha;","poem":2},{"lineBreak":true},{"text":"qurxummiin achi keessaa bisaan dhaddee","poem":2},{"lineBreak":true},{"text":"dhumattee, hin ajootti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ani gubbaa dukkaneessee,","poem":1},{"text":"akka woyaa gaddaa hin gurraachessa» jedhe.","poem":2}]},{"type":"heading","content":["Ajajamiisa Tajaajilaa Mootii Waan Maraa"]},{"type":"verse","number":4,"content":[{"text":"Ani worra dadhaba'atti dubbadhee","poem":1},{"text":"akka isaan jajjabeessuuf,","poem":2},{"lineBreak":true},{"text":"Goottaan Mootiin Waan Maraa","poem":2},{"lineBreak":true},{"text":"dandeettii barsiisiisaa naa kenneera.","poem":2},{"text":"Inni ganama ganama na dammassa,","poem":1},{"text":"akka nama baratiisatti jiruu","poem":2},{"lineBreak":true},{"text":"akka dhage'u gurra kiyya naaf hin bana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Goottaan Mootiin Waan Maraa gurra kiyya baneera;","poem":1},{"text":"ani ajajamuu didadhee,","poem":2},{"lineBreak":true},{"text":"isa irraa gara duubaa hin deebine.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani dudda kiyya worra na dikutti,","poem":1},{"text":"boqoo tiyyalle worra areeda kiyya","poem":2},{"lineBreak":true},{"text":"buqqisu dura qabe;","poem":2},{"lineBreak":true},{"text":"fuula kiyya worra natti murguu fi natti tufu hin dhoffanne.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Goottaan Mootiin Waan Maraa","poem":1},{"text":"waan na qarqaaruuf ani hin qaanowu.","poem":2},{"text":"Tanaaf, ani fuula kiyya akka dhakaa qara qabuu hin godha;","poem":1},{"text":"ani akka hin qaanonnelle hin beeka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Akka ani yakkaa hin qanne ka mudhisu, na bira jira;","poem":1},{"text":"eentu na himatuu dande'a ree?","poem":2},{"text":"Yoo jiraate","poem":1},{"text":"wolitti dhikaannee woli himannuu ti!","poem":2},{"lineBreak":true},{"text":"Ka na himatu dhikaatuu ti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ka na qarqaaru Goottaan Mootii Waan Maraa ti;","poem":1},{"text":"ka natti muru eennu ree?","poem":2},{"text":"Isaan marti akka woya'aa hin dullooman;","poem":1},{"text":"qu'een isaan hin nyaatti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Isin keessaa ka Mootii Waan Maraa sodaatuu fi","poem":1},{"text":"jecha tajaajilaa isaatiif ka ajajamu eennu?","poem":2},{"lineBreak":true},{"text":"Ka ifa hin qanne,","poem":2},{"lineBreak":true},{"text":"ka dukkana keessa deddeebi'u","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraatitti addatuu ti;","poem":2},{"lineBreak":true},{"text":"Waaqa ifiille'etti irkatuu ti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amma ammoo, isin worri ibidda gabbittanuu fi","poem":1},{"text":"worri xassaa qassittanu marti,","poem":2},{"lineBreak":true},{"text":"ifa ibidda gabbittaneetii","poem":2},{"lineBreak":true},{"text":"fi ifa xassaa qassiittane san keessa deema'a.","poem":2},{"text":"Isin farra keessa hin buutan;","poem":1},{"text":"tun ta isin harka kiyya keessaa fudhattanu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/ISA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":11}