{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"ISA","translationId":"gax_twf","name":"Isaayaasii Raagichaa","commonName":"Isaayaasii Raagichaa","title":"Kitaaba Isaayaasii Raagichaa","order":23,"numberOfChapters":66,"sha256":"43d1d4dce18c16808d379730f9d084e9e041c6b6e6a9b344a406dd4f58553d07","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gax_twf/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":51,"content":[{"type":"heading","content":["Fayyinna Yerusaalemii"]},{"type":"verse","number":1,"content":["Mootiin Waan Maraa,",{"text":"«Isin worri balchummaa hordottanu,","poem":2},{"lineBreak":true},{"text":"worri ana Mootii Waan Maraa barbaaddanu na caqasa'a.","poem":2},{"text":"Rassaa irraa dhaggantane,","poem":1},{"text":"boolla bisaanii ta keessaa ol baatanelle ilaala'a.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gara abbaa keessan Abrahaamii,","poem":1},{"text":"gara Saaraa isin deetteelle ilaala'a.","poem":2},{"text":"Ani yennaa isa waame inni uumaa hin qabu;","poem":1},{"text":"ani ammoo isa eebbisee isa baceesse.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ani Mootiin Waan Maraa Xiyoon hin jajjabeessa;","poem":1},{"text":"waan isii duraa diigame maraaf hin marara.","poem":2},{"text":"Goomolee isi'ii akka fichaa Edenii","poem":1},{"text":"lafa isi'ii godduu akka oorruu tiyyaa hin godha.","poem":2},{"lineBreak":true},{"text":"Ililleetti'ii fi gammad isii keessatti hin dhaggama;","poem":2},{"lineBreak":true},{"text":"qoonqoo galataatii fi faaru'uu achi keessatti hin dhage'anti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Ee kolbaa tiyya na caqasa'a;","poem":1},{"text":"waan jedhulle dhage'a'a.","poem":2},{"text":"Seerri na biraa hin baya;","poem":1},{"text":"muraan tiyyalle gosa biyya adda addaatiif ifa hin teeti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Balchummaan tiyya ariiti'iin dhikaatiisatti jirti;","poem":1},{"text":"fayyisiisi kiyyalle dhaqqabiisatti jira;","poem":2},{"lineBreak":true},{"text":"irreen tiyya gosa biyya adda addaatiif haqa hin fiddi.","poem":2},{"text":"Worri oddoola keessaa gara kiyya hin ilaalan;","poem":1},{"text":"irree tiyyalle addi'iin hin eegatan.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ol jedha'aatii gara ol-gubba'aa,","poem":1},{"text":"gad jedha'aatii lafa ilaala'a;","poem":2},{"lineBreak":true},{"text":"ol-gubbbaan akka aaraa hin baddi;","poem":2},{"lineBreak":true},{"text":"lattille akka woya'aa hin dulloonti;","poem":2},{"lineBreak":true},{"text":"worri isii irra le'u akka tiitichaa hin dhumatan.","poem":2},{"text":"Fayyisiisi kiyya ammoo, haga bara baraa ti;","poem":1},{"text":"balchummaan tiyyalle ijjumaa dhuma hin qaddu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Isin worri balchummaa beettanu,","poem":1},{"text":"isin kolbaan seera kiyya","poem":2},{"lineBreak":true},{"text":"gadhaa keessan keessaa qaddanu na dhage'a'a.","poem":2},{"text":"Murgoo namootaa hin sodaatina'a;","poem":1},{"text":"yookiin yennaa isaan isin arrassanu hin rifatina'a.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Qu'een akka woya'aa isaan hin nyaatti;","poem":1},{"text":"corroxxi akka rifeensa hoole'ee isaan hin nyaatti.","poem":2},{"text":"Balchummaan tiyya ammoo haga bara baraa ti;","poem":1},{"text":"fayyisiis kiyyalle","poem":2},{"lineBreak":true},{"text":"dhaloota irraa dhalootatti hin dabara» jedha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ee irree Mootii Waan Maraa, ka'i, ka'i!","poem":1},{"text":"Hunna teeti mudhisi!","poem":2},{"text":"Akka bara durii,","poem":1},{"text":"akkuma dhaloota durii durii keessaa ka'i!","poem":2},{"text":"Jawwee guddittii abbaayaa keessaa,","poem":1},{"text":"ta, «Rahaab» jedhanu san kukkuttee,","poem":2},{"lineBreak":true},{"text":"ka woraante si'ii motii ree?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Worri ati wodatte akka gamatti bu'uuf,","poem":1},{"text":"ka abbaaya'aa fi bisaan qilee guddo'oo gosse,","poem":2},{"lineBreak":true},{"text":"ka qilee abbaaya'aa keessatti karaa baase si'ii motii ree?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Worri Mootiin Waan Maraa wode hin deebi'an;","poem":1},{"text":"isaan faarfataa gara Xiyoonii hin seenan;","poem":2},{"lineBreak":true},{"text":"gammada bara baraa","poem":2},{"lineBreak":true},{"text":"akka kallachaa mataa ifiititti hin keyatan.","poem":2},{"lineBreak":true},{"text":"Gammadaan hin burraaqan;","poem":2},{"lineBreak":true},{"text":"gaddii fi bowiisi isaan irraa hin fagaata.","poem":2}]},{"type":"verse","number":12,"content":["Mootiin Waan Maraa isaaniin,",{"text":"«Ka isin jajjabeessu ana; anuma qofa.","poem":2},{"lineBreak":true},{"text":"Namoota du'anu,","poem":2},{"lineBreak":true},{"text":"ilmaan namootaa ta akka marraa goddu,","poem":2},{"lineBreak":true},{"text":"maaf sodaattan ree?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ana Mootii Waan Maraa ka isin dade,","poem":1},{"text":"ka ol-gubbaa diriirsee","poem":2},{"lineBreak":true},{"text":"hundee lafaa hundeesse deetanee,","poem":2},{"lineBreak":true},{"text":"maaf guyyaa mara aarii worra isin cunqursuu,","poem":2},{"lineBreak":true},{"text":"ka isin balleessiisaaf barbaaduu sodaattan ree?","poem":2},{"text":"Aariin worra isin cunqursuu meet ree?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Worri hidhameeru ariiti'iin hin bayan;","poem":1},{"text":"isaan hin du'anu;","poem":2},{"lineBreak":true},{"text":"gara qile'eelle gad hin bu'anu;","poem":2},{"lineBreak":true},{"text":"sagalee nyaatanulle hin dhabanu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«Danbaliin akkuma bulphittu abbaayaa ka raasu,","poem":1},{"text":"ana Mootii Waan Maraa Waaqa keessan;","poem":2},{"lineBreak":true},{"text":"maqaan kiyya Mootii Waan Maraa Ka Waan Mara Dade.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ani ol-gubbaa diriirsee, hundee lafaalle hundeesse;","poem":1},{"text":"ani Xiyooniin, ‹Ati kolbaa tiyya;","poem":2},{"lineBreak":true},{"text":"jecha kiyya afaan keeti keessa hin keya;","poem":2},{"lineBreak":true},{"text":"gaaddisa harka kiyyaatille'een si hin golla› hin jedha» jedhe.","poem":2}]},{"type":"heading","content":["Muduunuu Mufii Waaqaa"]},{"type":"verse","number":17,"content":[{"text":"Ee Yerusaalem, muduunuu mufii Mootii Waan Maraa","poem":1},{"text":"harka isaa irraa ta unte,","poem":2},{"lineBreak":true},{"text":"muduunuu mufi'ii ta gatantarsitu, cumaan isi'iille adoo hin hafin ta xuuxatte,","poem":2},{"lineBreak":true},{"text":"dammaqi, dammaqi ka'iitii dhaabbadhu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ilmaan ati deette mara keessaa,","poem":1},{"text":"ka si sooressu tokkolle hin jiru;","poem":2},{"lineBreak":true},{"text":"worra ati gudditte mara keessalle'ee","poem":2},{"lineBreak":true},{"text":"ka harka qabee si sooressu hin jiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Badiin badii irratti sitti dhutteerti;","poem":1},{"text":"eentu si jajjabeessa ree?","poem":2},{"text":"Tunille diigamiisa, badiisa,","poem":1},{"text":"beelaa fi woraana.","poem":2},{"lineBreak":true},{"text":"Eentu si woliin gadda ree?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mufi'ii fi xixichi Mootii Waan Maraa Waaqa keessanii","poem":1},{"text":"waan isin dhaqqabeef,","poem":2},{"lineBreak":true},{"text":"ilmaan teessan akka buddannee tiyyo'oon qabantee,","poem":2},{"lineBreak":true},{"text":"woldeennaa kara'aa mara irratti gaggaddee irkatteerti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tanaaf isin daadhii woyni'iitiin adoo hin te'in,","poem":1},{"text":"rakkinnaan ka machoottane tana dhage'a'a.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mootiin Waan Maraa keessan ka Waan Mara Dande'u,","poem":1},{"text":"Waaqi kolbaa ifiitiif falmu isiniin,","poem":2},{"lineBreak":true},{"text":"«Kunoo, muduunuu isin gatantarsitu,","poem":2},{"lineBreak":true},{"text":"harka keessan irraa fuudheera;","poem":2},{"lineBreak":true},{"text":"deebitaneelle muduunuu mufi'ii tiyya irraa,","poem":2},{"lineBreak":true},{"text":"ijjumaa akka isin hin unne hin godha.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Muduunuu rakkinnaa san","poem":1},{"text":"harka worra si farrisiisuu, ka si'iin,","poem":2},{"lineBreak":true},{"text":"‹Gad gombifam, nuuti si irra ideenna› jedhutti hin kenna.","poem":2},{"lineBreak":true},{"text":"Atille akka isaan irra ideemanuuf","poem":2},{"lineBreak":true},{"text":"dudda keeti akka lafaatii fi kara'aa gooteef» jedha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/ISA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":23}