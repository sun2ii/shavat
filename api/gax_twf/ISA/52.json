{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"ISA","translationId":"gax_twf","name":"Isaayaasii Raagichaa","commonName":"Isaayaasii Raagichaa","title":"Kitaaba Isaayaasii Raagichaa","order":23,"numberOfChapters":66,"sha256":"43d1d4dce18c16808d379730f9d084e9e041c6b6e6a9b344a406dd4f58553d07","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gax_twf/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":52,"content":[{"type":"heading","content":["Waaqi Yerusaalem Hin fayyisa"]},{"type":"verse","number":1,"content":[{"text":"Ee Xiyoon, dammaqi! Dammaqi!","poem":1},{"lineBreak":true},{"text":"Hunna uffadhu!","poem":1},{"lineBreak":true},{"text":"Ee Yerusaalem, qachaa woyyicha,","poem":1},{"text":"woyaa teeti ta ulfinnaa uffadhu!","poem":2},{"text":"Haganaa achi worri haqanqabaa hin qabatinii fi","poem":1},{"text":"worri battowe gara keeti hin seenu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ee kolbaa Xiyoonii ta booji'antane,","poem":1},{"text":"wodaroo sibiilaa","poem":2},{"lineBreak":true},{"text":"ta ittiin hidhantane","poem":2},{"lineBreak":true},{"text":"morma keessan irraa hiikadha'a!","poem":2},{"text":"Ee Yerusaalem,","poem":1},{"text":"Bukuu ifi irraa hargufadhuutii,","poem":2},{"lineBreak":true},{"text":"ka'ii, barcumaa mootumma'aa irra tee'i!","poem":2}]},{"type":"verse","number":3,"content":["Mootiin Waan Maraa kolbaa ifiitiin, «Isin gatii malee gurgurantaneertaniiyyu; beesee malee hin wodantan» jedha."]},{"type":"verse","number":4,"content":["Goottaan Mootiin Waan Maraa, «Kolbaan tiyya qara biyya Gibxi'ii keessa le'iisaaf, gad dhaxxe; achiin duuba worri Asoorii, sababa malee isaan cunqurse."]},{"type":"verse","number":5,"content":["Kolbaan tiyya sababa malee waan fudhatanteef, ani asii maan qaba ree? Worri isaan bulchu isaanitti murga; guyyaa mara maqaa kiyya faanshessan."]},{"type":"verse","number":6,"content":["Tanaaf yennaa san kolbaan tiyya maqaa kiyya hin beetti; ‹Kunoo, ani asi jira› jedhee, ka dubbate ana akka te'e hin beetti» jedha."]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Miilli ergamaa gaara irra dhaabbatee","poem":1},{"text":"oduu gammadaa fidu,","poem":2},{"lineBreak":true},{"text":"ka nageya lassuu,","poem":2},{"lineBreak":true},{"text":"ka waan dansaa fidu,","poem":2},{"lineBreak":true},{"text":"ka fayyinna lallabu,","poem":2},{"lineBreak":true},{"text":"ka Xiyooniin, «Waaqi keeti mootii te'a» jedhu,","poem":2},{"lineBreak":true},{"text":"attam attam tola!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Caqasi! Mootiin Waan Maraa gara Xiyoonii yennaa deebi'u,","poem":1},{"text":"eeddoti teeti ila ifiitiin hin dhaggiti;","poem":2},{"lineBreak":true},{"text":"qoonqoo ifii ol qabattee tokkumma'aan hin ilillitti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mootiin Waan Maraa kolbaa ifii jajjabeessee,","poem":1},{"text":"Yerusaalem waan wodeef,","poem":2},{"lineBreak":true},{"text":"ee bututa Yerusaalemii","poem":2},{"lineBreak":true},{"text":"tokkumma'aan ilillisaa faarsa'a.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mootiin Waan Maraa gosa biyya adda addaa mara duratti","poem":1},{"text":"irree ifii woyyittii hin mudhisa.","poem":2},{"text":"Worri qaccee biyya lafaa jiranu duudiin","poem":1},{"text":"fayyisiisa Waaqa keennaa hin dhaggan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isin worri meya Mootii Waan Maraa ba'attanu,","poem":1},{"text":"adda baya'a; adda baya'aa;","poem":2},{"lineBreak":true},{"text":"achi keessaa baya'a;","poem":2},{"lineBreak":true},{"text":"waan battii hin tuqina'a;","poem":2},{"lineBreak":true},{"text":"achi keessaa baya'aatii,","poem":2},{"lineBreak":true},{"text":"ifi qulqulleessa'a.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Te'uu malee, ariiti'iin hin baatanu","poem":1},{"text":"yookiin baqattanee hin deentanu;","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa isiniin dura hin deema;","poem":2},{"lineBreak":true},{"text":"Waaqi Israa'elii duuballe'een isin hin eega.","poem":2}]},{"type":"heading","content":["Tajaajilaa Rakkatu"]},{"type":"verse","number":13,"content":["Mootiin Waan Maraa, «Kunoo, tajaajilaan kiyya qarumma'aan huja;",{"text":"inni hin saadama;","poem":2},{"lineBreak":true},{"text":"ol ol hin qabama;","poem":2},{"lineBreak":true},{"text":"hin jajama.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Te'uu malee akki tajaajilaa kiyyaa","poem":1},{"text":"nama irraa adda te'ee,","poem":2},{"lineBreak":true},{"text":"waan gara dhabeef,","poem":2},{"lineBreak":true},{"text":"namooti hedduun baaseffatane.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Maarre inni gosa biyya adda addaa hedduu hin baaseffachiisa;","poem":1},{"text":"sababa isaatiif moototi afaan hin qabatti;","poem":2},{"lineBreak":true},{"text":"waan dur itti hin himamin hin dhaggiti;","poem":2},{"lineBreak":true},{"text":"waan hin dhage'in hin hubatti» jedhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}