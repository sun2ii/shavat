{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"ISA","translationId":"gax_twf","name":"Isaayaasii Raagichaa","commonName":"Isaayaasii Raagichaa","title":"Kitaaba Isaayaasii Raagichaa","order":23,"numberOfChapters":66,"sha256":"43d1d4dce18c16808d379730f9d084e9e041c6b6e6a9b344a406dd4f58553d07","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gax_twf/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":["Kolbaan deebitee,",{"text":"«Waan nuuti dhageenne eentu dhugeeffate?","poem":1},{"text":"Irreen Mootii Waan Maraa eennnutti mudhatte?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inni Mootii Waan Maraa duratti akka kichuu quunxituu,","poem":1},{"text":"akka hidda lafa godduu keessaa bawuu hin lata;","poem":2},{"lineBreak":true},{"text":"inni dansummaa yookiin arnya nutti tolu hin qabu;","poem":2},{"lineBreak":true},{"text":"akka isa jaalannuufille akka hin qabu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inni nama namooti jibbanee tuffatane;","poem":1},{"text":"inni nama dhibee guddo'oo fi rakkoo guddoo qabu.","poem":2},{"text":"Inni akka nama nami fuula irraa deebifatee ti;","poem":1},{"text":"inni nama tuffatame;","poem":2},{"lineBreak":true},{"text":"nuutille ulfinna isaaf hin kennine.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Inni dhugumaan dhukkuba keenna fudhatee,","poem":1},{"text":"dhibee teennalle ba'ate.","poem":2},{"text":"Te'uu malee, nuuti akka Waaqi isa dhowee,","poem":1},{"text":"akka Waaqi balaa isatti buusee,","poem":2},{"lineBreak":true},{"text":"akka Waaqi isa farrisiisetti laakkonne.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inni ammoo, sababa cubbuu teennaatiif woraaname;","poem":1},{"text":"sababa yakkaa teennaatiifille butute.","poem":2},{"text":"Nuuti adabamiisa isaatiin nageya dhagganne;","poem":1},{"text":"madaa isaatille'een nuuti fayyine.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nuuti marti akka hoole'ee karaa irraa bannee,","poem":1},{"text":"tokko tokkoon keennaayyuu","poem":2},{"lineBreak":true},{"text":"karaa karaa keennatti gorre;","poem":2},{"text":"Mootiin Waan Maraa ammoo,","poem":1},{"text":"yakkaa teenna mara isa irra keye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Inni cunqurfamee, farre;","poem":1},{"text":"te'uu malee, waan tokkolle hin dubbanne;","poem":2},{"lineBreak":true},{"text":"akka ilmayyoo hoole'ee ka qalmaaf oofamuutii fi","poem":2},{"lineBreak":true},{"text":"akkuma hooleen worra rifeensa isi'ii haadu duratti cadhittu,","poem":2},{"lineBreak":true},{"text":"inni cadhise malee, womaa hin dubbanne.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Cunqursiisaan isatti muranee,","poem":1},{"text":"fuudhanee deemane.","poem":2},{"lineBreak":true},{"text":"Inni lafa worra jiraata'aa","poem":2},{"lineBreak":true},{"text":"keessaa balleeffamee,","poem":2},{"lineBreak":true},{"text":"sababa yakkaa kolbaa","poem":2},{"lineBreak":true},{"text":"ifiitiifille akka adabame","poem":2},{"lineBreak":true},{"text":"hidda dhaloota isaa keessaa","poem":2},{"lineBreak":true},{"text":"ka hubate eennu ree?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inni hammeenna tokkolle","poem":1},{"text":"adoo hin hujin,","poem":2},{"lineBreak":true},{"text":"dharalle adoo hin dubbatin,","poem":2},{"lineBreak":true},{"text":"worra hamoolee woliin du'ee,","poem":2},{"lineBreak":true},{"text":"addee dureeyyiin","poem":2},{"lineBreak":true},{"text":"awwaalantutti awwaalame» jette.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mootiin Waan Maraa,","poem":1},{"text":"«Te'uu malee, bututiisii fi","poem":2},{"lineBreak":true},{"text":"farriis isaa fedha kiyya;","poem":2},{"lineBreak":true},{"text":"ani jiruu isaa kennansa","poem":2},{"lineBreak":true},{"text":"sababa yakka'aatiif","poem":2},{"lineBreak":true},{"text":"dhikaatu godhulle,","poem":2},{"lineBreak":true},{"text":"barri isaa dheeratee","poem":2},{"lineBreak":true},{"text":"inni sanyii ifii hin dhagga;","poem":2},{"lineBreak":true},{"text":"fedhiin tiyyalle","poem":2},{"lineBreak":true},{"text":"karaa isaatiin hin muummotti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inni farriisa ifiitiin duuba,","poem":1},{"text":"ifa jiru'uu dhaggee hin gammada.","poem":2},{"text":"Tajaajilaan kiyya balchichi,","poem":1},{"text":"beekkumsa ifiitiin","poem":2},{"lineBreak":true},{"text":"worra bacaa hin balchoonsa;","poem":2},{"lineBreak":true},{"text":"yakkaa isaaniille hin ba'ata.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Inni cubbuu namoota heddu'uu ba'atee,","poem":1},{"text":"marroo yakkaa isaaniitiifille","poem":2},{"lineBreak":true},{"text":"isaaniif kadhate;","poem":2},{"lineBreak":true},{"text":"inni lubbuu ifii du'aaf","poem":2},{"lineBreak":true},{"text":"dabarsee kennee,","poem":2},{"lineBreak":true},{"text":"hamaaleyyii woliin","poem":2},{"lineBreak":true},{"text":"waan laakkowameef,","poem":2},{"lineBreak":true},{"text":"ani qooda isaa worra gugurdaa woliin","poem":2},{"lineBreak":true},{"text":"isaaf hin kenna;","poem":2},{"lineBreak":true},{"text":"inni worra jajjabaa woliin","poem":2},{"lineBreak":true},{"text":"boojuu hin qoodama» jedha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/ISA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/ISA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/ISA/52.json","previousChapterAudioLinks":{},"numberOfVerses":12}