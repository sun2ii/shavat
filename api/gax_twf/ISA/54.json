,"poem":1},{"text":"togaa keeti jabeessi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ati gara middaa fi bita'aa","poem":1},{"text":"waan badhattuuf,","poem":2},{"lineBreak":true},{"text":"sanyiin teeti gosa biyya","poem":2},{"lineBreak":true},{"text":"adda addaa hin qabatti;","poem":2},{"lineBreak":true},{"text":"qachoota isaanii","poem":2},{"lineBreak":true},{"text":"ka one keessalle hin qubatti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Ati waan hin qaanonneef,","poem":1},{"text":"hin sodaatin;","poem":2},{"lineBreak":true},{"text":"waan hin salphanneef,","poem":2},{"lineBreak":true},{"text":"hin rifatin.","poem":2},{"text":"Fokkoo yennaa dargaggummaa","poem":1},{"text":"teetii hin deeta;","poem":2},{"lineBreak":true},{"text":"qaanii yennaa","poem":2},{"lineBreak":true},{"text":"haadha hiyyeessummaa teetiille","poem":2},{"lineBreak":true},{"text":"haganaa achi hin qaabattu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ani ka si dade","poem":1},{"text":"akka dhirsaa si'iif hin te'a;","poem":2},{"lineBreak":true},{"text":"maqaan kiyya Mootii Waan Maraa","poem":2},{"lineBreak":true},{"text":"Ka Waaqa Waan Mara Dade;","poem":2},{"lineBreak":true},{"text":"ka si wode","poem":2},{"lineBreak":true},{"text":"ana Woyyicha Israa'elii ti;","poem":2},{"lineBreak":true},{"text":"ani Waaqa lafa duudi'ii ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Ati akka dubartii","poem":1},{"text":"dargaggumma'aan heerumtee,","poem":2},{"lineBreak":true},{"text":"abbaan manaa isii lakkisee,","poem":2},{"lineBreak":true},{"text":"gadhaa ifii keessatti gadditee ti» jedha.","poem":2},{"text":"Mootiin Waan Maraa keeti ammoo,","poem":1},{"text":"gara ifii si waamee,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"«Ani yennaa diqqo'oof","poem":1},{"text":"si lakkiseeraayyu;","poem":2},{"lineBreak":true},{"text":"amma ammoo,","poem":2},{"lineBreak":true},{"text":"marartii guddo'oon","poem":2},{"lineBreak":true},{"text":"si deebisa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ani guddoo waan sitti aareef,","poem":1},{"text":"yennaa diqqo'oof","poem":2},{"lineBreak":true},{"text":"fuula kiyya","poem":2},{"lineBreak":true},{"text":"si duraa dhoffadheeraayyu;","poem":2},{"lineBreak":true},{"text":"ammoo, jaalala kiyya","poem":2},{"lineBreak":true},{"text":"ka bara baraatiin","poem":2},{"lineBreak":true},{"text":"si hin marara» jedha ka si wodu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ammalle Mootiin Waan Maraa","poem":1},{"text":"ka si mararu si'iin,","poem":2},{"lineBreak":true},{"text":"«Tun naaf akka bara Nohii","poem":2},{"lineBreak":true},{"text":"deebi'ee bisaaniin","poem":2},{"lineBreak":true},{"text":"lafa akka hin balleessine kakadhee ti;","poem":2},{"lineBreak":true},{"text":"maarre ani amma deebi'ee","poem":2},{"lineBreak":true},{"text":"akka sitti hin aarre,","poem":2},{"lineBreak":true},{"text":"deebi'eelle ijjumaa","poem":2},{"lineBreak":true},{"text":"akka si hin xindheef kakadheera.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gaaroti raafamanulle,","poem":1},{"text":"kooboti addee ifii irraa ka'anulle","poem":2},{"lineBreak":true},{"text":"jaalalli bara baraa","poem":2},{"lineBreak":true},{"text":"ka ani si'iif qabu,","poem":2},{"lineBreak":true},{"text":"ijjumaa hin raafantu;","poem":2},{"lineBreak":true},{"text":"gondooroon nageyaa tiyyalle hin diigantu.","poem":2}]},{"type":"verse","number":11,"content":["«Ee, ati qachaa Yerusaalemii,",{"text":"ka rakkatte,","poem":2},{"lineBreak":true},{"text":"ka bubbee bokkeyaatiin raafante;","poem":2},{"lineBreak":true},{"text":"ka hin jajjabaatin.","poem":2},{"text":"Kunoo, ani dhakaa gatii guddo'ootiin","poem":1},{"text":"si hin ijaara;","poem":2},{"lineBreak":true},{"text":"dhakaa ‹Safiiros› jedhamuun","poem":2},{"lineBreak":true},{"text":"hundee teetille hin keya.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ani qaccee xelleephoo teetii","poem":1},{"text":"dooqa diima'aan,","poem":2},{"lineBreak":true},{"text":"karra teetiille dooqa cululuquun,","poem":2},{"lineBreak":true},{"text":"dalleya dhaka'aa keetille","poem":2},{"lineBreak":true},{"text":"dhakaa gatii guddo'ootiin hin ijaara.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ilmaan teeti marti","poem":1},{"text":"ana Mootii Waan Maraa irraa","poem":2},{"lineBreak":true},{"text":"ka baratte hin teeti;","poem":2},{"lineBreak":true},{"text":"ijoolleen teetille","poem":2},{"lineBreak":true},{"text":"nageya guddaa hin dhaggatti.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ati balchumma'aan","poem":1},{"text":"hin ijaaranta;","poem":2},{"lineBreak":true},{"text":"cunqurfamiisi si irraa hin fagaata;","poem":2},{"lineBreak":true},{"text":"wonni si sodaachisu hin jiraatu;","poem":2},{"lineBreak":true},{"text":"bararaqi si irraa hin fagaata;","poem":2},{"lineBreak":true},{"text":"si'ille'etti hin dhikaatu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Eennulle yoo si miidhe,","poem":1},{"text":"inni ka ani ergee moti;","poem":2},{"lineBreak":true},{"text":"nami si miidhu marti","poem":2},{"lineBreak":true},{"text":"harka sitti hin kennata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«Kunoo, nama cile'etti buufee bobeessu,","poem":1},{"text":"sibiila tumee,","poem":2},{"lineBreak":true},{"text":"meya woraanaa ka qopheessu,","poem":2},{"lineBreak":true},{"text":"ka dade ana.","poem":2},{"text":"Ka woy balleessu,","poem":1},{"text":"akka inni woy balleessuuf,","poem":2},{"lineBreak":true},{"text":"ka dade ana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mey woraanaa","poem":1},{"text":"ka si balleessiisaaf qophowe,","poem":2},{"lineBreak":true},{"text":"si miidhuu hin dande'u;","poem":2},{"lineBreak":true},{"text":"worra si himatu mara","poem":2},{"lineBreak":true},{"text":"hin injifatta.","poem":2},{"text":"Kun qooda tajaajiltoota tiyyaa ti;","poem":1},{"text":"injifachaan ani isaaniif kennulle tana» jedha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}