{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"ISA","translationId":"gax_twf","name":"Isaayaasii Raagichaa","commonName":"Isaayaasii Raagichaa","title":"Kitaaba Isaayaasii Raagichaa","order":23,"numberOfChapters":66,"sha256":"43d1d4dce18c16808d379730f9d084e9e041c6b6e6a9b344a406dd4f58553d07","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gax_twf/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":55,"content":[{"type":"heading","content":["Waaqi Worra Dheebote Waame"]},{"type":"verse","number":1,"content":["Mootiin Waan Maraa, «Isin worri dheebottane marti,",{"text":"gara bisaanii kowa'a!","poem":2},{"text":"Isin worri beesee hin qanne,","poem":1},{"text":"kowa'aatii, bitadha'aa nyaadha'a!","poem":2},{"lineBreak":true},{"text":"Kowa'aatii, beesee malee, gatii malee,","poem":2},{"lineBreak":true},{"text":"daadhii woyni'iitii fi aanan bitadha'a!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Waan sagalee hin te'initti","poem":1},{"text":"maaf beesee teessan baattan?","poem":2},{"text":"Waan isin hin quussinetti maaf eloottan?","poem":1},{"text":"Na caqasa'a, waan dansaa nyaadha'a;","poem":2},{"lineBreak":true},{"text":"sagalee dansa'atti gammada'a.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gara kiyya kowa'a!","poem":1},{"text":"Gurra keessan gara kiyya deebifadha'a;","poem":2},{"lineBreak":true},{"text":"akka jiraattanuuf na dhage'a'a!","poem":2},{"text":"Jaalala kiyya ka bara baraa ka Daawitiif waadaa galeen,","poem":1},{"text":"gondooroo bara baraa isin woliin hin godha.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kunoo, ani Daawiti","poem":1},{"text":"kolbaa heddu'uuf dhugaa-bayaa,","poem":2},{"lineBreak":true},{"text":"sooressaa fi ajajaa kolbaa heddu'uu godheera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kunoo, ani Mootiin Maan Maraa","poem":1},{"text":"Waaqi keeti Woyyichi Israa'elii","poem":2},{"lineBreak":true},{"text":"ulfinna waan sii kenneef,","poem":2},{"lineBreak":true},{"text":"ati gosa biyya adda addaa ta hin beenne hin waanta;","poem":2},{"lineBreak":true},{"text":"gosi biyya adda addaa ta si hin beennelle","poem":2},{"lineBreak":true},{"text":"ariiti'iin gara keeti hin dhufan» jedha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yennaa Mootiin Waan Maraa dhaggamu barbaadadha'a;","poem":1},{"text":"adoo dhikoo jiruulle isa waammadha'a.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nami hamaan karaa ifii,","poem":1},{"text":"nami yakkaamessi yaada ifii lakkisee,","poem":2},{"lineBreak":true},{"text":"gara Mootii Waan Maraa Waaqa keennaa deebi'uu ti;","poem":2},{"lineBreak":true},{"text":"inni isaaf hin marara;","poem":2},{"lineBreak":true},{"text":"araarri isaalle baca'a.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mootiin Waan Maraa,","poem":1},{"text":"«Yaadi kiyya akka yaada keessanii,","poem":2},{"lineBreak":true},{"text":"karaan kiyyalle akka karaa keessaniitii moti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akkuma ol-gubbaan lafa irraa ol fagaattu,","poem":1},{"text":"karaan kiyya karaa keessan irraa,","poem":2},{"lineBreak":true},{"text":"yaadi kiyyalle yaada keessan irraa ol hin fagaata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Bokkeennii fi dhakaan bokkeyaa","poem":1},{"text":"ol-gubbaa irraa gad roobee,","poem":2},{"lineBreak":true},{"text":"lafa jiisiisaan,","poem":2},{"lineBreak":true},{"text":"latti quunxitee, midhaan akka baachu","poem":2},{"lineBreak":true},{"text":"ka facaasuuf sanyii,","poem":2},{"lineBreak":true},{"text":"ka nyaatuuf sagalee,","poem":2},{"lineBreak":true},{"text":"akka kennitu godhu malee,","poem":2},{"lineBreak":true},{"text":"gara ol-gubba'aa akkuma hin deebine,","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"jechi afaan kiyya keessaa bawu,","poem":2},{"lineBreak":true},{"text":"waan ani fedhe hujee,","poem":2},{"lineBreak":true},{"text":"waan ani itti ergelle","poem":2},{"lineBreak":true},{"text":"muummessu malee,","poem":2},{"lineBreak":true},{"text":"akkasumaan gara kiyya hin deebi'u.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Isin gammadaan Baabilon keessaa baatanee,","poem":1},{"text":"nageyaan hin geegefantan.","poem":2},{"text":"Gaarotii fi kooboti isin duratti gammadaa hin faarsan;","poem":1},{"text":"muki badda'aa marti harka hin dhowan.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Addee muka qore'ee muki hindheensaa,","poem":1},{"text":"addee qumi'uudu'uu muki dakkaraa hin lata.","poem":2},{"text":"Tunille Mootii Waan Maraatiif qaabbii,","poem":1},{"text":"beessisa haga bara baraa hin banne hin teeti» jedha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}