{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"ISA","translationId":"gax_twf","name":"Isaayaasii Raagichaa","commonName":"Isaayaasii Raagichaa","title":"Kitaaba Isaayaasii Raagichaa","order":23,"numberOfChapters":66,"sha256":"43d1d4dce18c16808d379730f9d084e9e041c6b6e6a9b344a406dd4f58553d07","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gax_twf/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":60,"content":[{"type":"heading","content":["Ulfinna Yerusaalemii Ka Gara Duraa"]},{"type":"verse","number":1,"content":[{"text":"Ee Yerusaalem, ifi keeti waan dhufeef, ka'ii issi!","poem":1},{"text":"Ulfinni Mootii Waan Maraalle si irratti ifeera.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kunoo, dukkanti lafa hin golliti;","poem":1},{"text":"dukkanti dimmille kolbaa hin dhossiti.","poem":2},{"text":"Si'iif ammoo ifi Mootii Waan Maraa hin ifa;","poem":1},{"text":"ulfinni isaalle si irratti hin mudhata.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gosi biyya adda addaa gara ifa keetii,","poem":1},{"text":"moototille gara ifa keeti ka ganamaa hin dhufan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ol jedhiitii adaala keeti ilaal:","poem":1},{"lineBreak":true},{"text":"Isaan marti wolitti qabamanee","poem":1},{"text":"gara keeti hin dhufan.","poem":2},{"text":"Ilmaan teeti fagoo irraa hin dhufan;","poem":1},{"text":"ijoolleen durraa teetille worri isaan guddisu","poem":2},{"lineBreak":true},{"text":"isaan habbaarrateeruun gara keeti dhufan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ati yennaa isaan dhaggite, fuulli keeti hin ifa;","poem":1},{"text":"gadhaan keetille gammadaan hin firinxiixa.","poem":2},{"text":"Qabeenni abbaayaa irra qaxxaamuree dhufu,","poem":1},{"text":"karri gosa biyya adda addaalle teeti hin teeti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Gaaloti bindillaan,","poem":1},{"text":"gaaloti orgeen biyya Miidiyaaniitii fi Eefa'aa irraa dhufanee","poem":2},{"lineBreak":true},{"text":"lafa teeti hin guutan.","poem":2},{"text":"Namooti biyya Sheeba'aatii dhufanu marti","poem":1},{"text":"worqi'ii fi hixaana fidanee hin dhufan;","poem":2},{"text":"Isaan galata Mootii Waan Maraa hin lallaban.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hooleen worra Qedaarii marti","poem":1},{"text":"gara keeti wolitti hin qabaman;","poem":2},{"lineBreak":true},{"text":"korbeeyyii hoole'ee ta worra Nabaayotiille","poem":2},{"lineBreak":true},{"text":"ciinca'aaf itti hin fayyadanta.","poem":2},{"text":"Isaan marti addee ciinca'aa irratti fudhatama hin dhaggatan.","poem":1},{"text":"Mootiin Waan Maraa Galma ifii ka ulfinnaa irra caalaa","poem":2},{"lineBreak":true},{"text":"akka ulfinna dhaggatu hin godha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Worri akka duumensaatii fi","poem":1},{"text":"akka saphaliisa gara mandhee ifii koolaan ka'uu,","poem":2},{"lineBreak":true},{"text":"fiigu kun eennu fa'a?","poem":2}]},{"type":"verse","number":9,"content":["Dhugumaan ilmaan teeti worri oddoola keessaa addi'iin Mootii Waan Maraa hin eegatan; Mootiin Waan Maraa Waaqi keeti Woyyichi Israa'elii ulfinna waan sii kenneef, ulfinna isaatiif jedhanee, ilmaan teeti fagoo irraa, meeti'ii fi worqii isaanii woliin fidiisaaf hobolooti gugurdoon Tarshiishii hin dursiti."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mootiin Waan Maraa Yerusaalemiin,","poem":1},{"text":"«Worri ormaa dalleya keeti ka dhaka'aa deebisanee hin ijaaran;","poem":2},{"lineBreak":true},{"text":"moototi isaaniille si hin tajaajilan;","poem":2},{"lineBreak":true},{"text":"ani aaree si adabeeraayyu;","poem":2},{"lineBreak":true},{"text":"amma ammoo jaala kiyyaan si hin marara.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gosi biyya adda addaa","poem":1},{"text":"karra ifii gara keeti akka fidanuuf,","poem":2},{"lineBreak":true},{"text":"moototi isaaniille tarre'een akka ol seenanu,","poem":2},{"lineBreak":true},{"text":"seensumi karra teetii yennaa mara banamee tee'a;","poem":2},{"lineBreak":true},{"text":"halkanii fi guyyaalle hin cufamu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kolba'aa fi mootummooti si hin tajaajille hin badan;","poem":1},{"text":"isaan ijjumaa hin badan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Addee Galma kiyyaa ittiin seesiisaaf,","poem":1},{"text":"muka gugurdaa Libaanonii hindheensa, muka shuwaashuwwe'eetii fi sookkee gara keeti hin fidan;","poem":2},{"lineBreak":true},{"text":"ani addee miilli kiyya ijjatu tana hin ulfeessa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ilmaan worra si cunqursee,","poem":1},{"text":"sagadaa gara keeti hin dhufan.","poem":2},{"text":"Worri dur si tuffate marti","poem":1},{"text":"miila keetitti hin jigan.","poem":2},{"text":"Isaan, ‹Qachaa Israa'elii woyyicha ka teete,","poem":1},{"text":"qachaa Mootii Waan Maraa Xiyoon› jedhanee si hin waaman.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«Ati ta lakkifante, ta jibbatante,","poem":1},{"text":"ta nami tokkolle si keessa hin dabarre teetulle,","poem":2},{"lineBreak":true},{"text":"ani haga bara baraa ta ittiin kooranu si hin godha;","poem":2},{"lineBreak":true},{"text":"dhaloota maraafille addee gammadaa si hin godha.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Akkuma ijoolleen harma haadha ifii hootu,","poem":1},{"text":"atille qabeenna gosa biyya adda addaatii fi moototaa,","poem":2},{"lineBreak":true},{"text":"hin hoota.","poem":2},{"text":"Achiin duuba ani Mootiin Waan Maraa,","poem":1},{"text":"hunnaamessi Yaaqoobii,","poem":2},{"lineBreak":true},{"text":"ka si fayyisuu fi ka si wodu","poem":2},{"lineBreak":true},{"text":"akka te'e hin beetta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«Ani addee sageettu'uu worqii,","poem":1},{"text":"addee sibiilaa meetii,","poem":2},{"lineBreak":true},{"text":"addee mukaa sageettuu,","poem":2},{"lineBreak":true},{"text":"addee dhaka'aa sibiila si'iif hin fida.","poem":2},{"text":"Ani nageya mootii keeti,","poem":1},{"text":"balchummaalle bulchaa keeti hin godha.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Haganaa achi biyya teeti keessatti,","poem":1},{"text":"hunnaan nama irratti ka'iis,","poem":2},{"lineBreak":true},{"text":"meessaa keetitti diigamiisi yookiin badiisi hin jiraatu.","poem":2},{"text":"Ati ammoo dalleya dhaka'aa ka qachaa keetii, ‹Fayyinna›,","poem":1},{"text":"seensuma karra teetiille, ‹Leellisa› jettee hin waanta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«Ani Mootiin Waan Maraa ifa bara baraa,","poem":1},{"text":"Waaqi keeti ulfinna waan sii te'uuf,","poem":2},{"lineBreak":true},{"text":"haganaa achi guyyaa aduun,","poem":2},{"lineBreak":true},{"text":"halkan jiin","poem":2},{"lineBreak":true},{"text":"ifa si'iif hin te'u.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Aduun teeti deebitee hin seentu;","poem":1},{"text":"jiin keetille ifiisa hin lakkisu.","poem":2},{"text":"Ani Mootiin Waan Maraa ifa bara baraa","poem":1},{"text":"si'iif hin te'a","poem":2},{"lineBreak":true},{"text":"barri gadda keetiille hin dhumata.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Achiin duuba kolbaan teeti marti balchoolee hin te'an;","poem":1},{"text":"isaan lafa san haga bara baraa hin dhaalan.","poem":2},{"text":"Isaan ulfinna kiyya mudhisiisaaf biqiltuu ani harka kiyyaan dhaabe.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Maatiin diqqoon kuma hin teeti;","poem":1},{"text":"ta mara caala diqqo'oo kolbaa jadduu hin teeti.","poem":2},{"text":"Ani Mootii Waan Maraa ti;","poem":1},{"text":"yennaa isi'iititti tana mara","poem":2},{"lineBreak":true},{"text":"ariifadhee hin muummessa» jedha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/ISA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/ISA/59.json","previousChapterAudioLinks":{},"numberOfVerses":22}