{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"ISA","translationId":"gax_twf","name":"Isaayaasii Raagichaa","commonName":"Isaayaasii Raagichaa","title":"Kitaaba Isaayaasii Raagichaa","order":23,"numberOfChapters":66,"sha256":"43d1d4dce18c16808d379730f9d084e9e041c6b6e6a9b344a406dd4f58553d07","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gax_twf/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":61,"content":[{"type":"heading","content":["Oduu Gammadaa Ta Fayyinnaa"]},{"type":"verse","number":1,"content":[{"text":"Ayyaanni Goottaa Mootii Waan Maraa na irra jira;","poem":1},{"text":"akka ani oduu gammadaa","poem":2},{"lineBreak":true},{"text":"worra cunqurfameef lallabu,","poem":2},{"lineBreak":true},{"text":"na muudeera.","poem":2},{"text":"Worra gadhaan isaanii madaye","poem":1},{"text":"akka ani fayyisuuf,","poem":2},{"lineBreak":true},{"text":"worra booji'ame akka ani bilisa baasuuf,","poem":2},{"lineBreak":true},{"text":"worra hidhame akka ani hiikuuf,","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa na ergeera.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Woggaa Mootii Waan Maraa biratti fudhatama qadduu fi","poem":1},{"text":"guyyaa Waaqi keenna haluu bawu,","poem":2},{"lineBreak":true},{"text":"akka ani lassuuf,","poem":2},{"lineBreak":true},{"text":"worra bowu mara","poem":2},{"lineBreak":true},{"text":"akka ani jajjabeessuuf,","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa na ergeera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Worri Xiyoon keessatti gaddiisatti jiru,","poem":1},{"text":"mata'atti addee daadhaa firfirfatanu","poem":2},{"lineBreak":true},{"text":"marata dansaa akka ani itti maru","poem":2},{"lineBreak":true},{"text":"addee bowanu,","poem":2},{"lineBreak":true},{"text":"zayitii gammadaa akka ani itti dhangalaasu,","poem":2},{"lineBreak":true},{"text":"addee ayyaana gaddaa,","poem":2},{"lineBreak":true},{"text":"woyaa leellisaa akka ani itti uffisuuf,","poem":2},{"lineBreak":true},{"text":"na ergeera.","poem":2},{"text":"Isaan, «Qilxaa balchumma'aa,","poem":1},{"text":"ka Mootiin Waan Maraa ulfinna ifii mudhisiisaaf dhaabe» jedhamanee hin waamaman.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isaan diigama durii deebisanee hin ijaaran;","poem":1},{"text":"waan dur baddelle adde'etti hin deebisan.","poem":2},{"text":"Qachoota dhaloota heddu'uun dura diigamee bade","poem":1},{"text":"deebisanee hin haaressan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Alagaan hoolee teessan isiniif hin tissa;","poem":1},{"text":"fichaa keessan isiniif hin qota;","poem":2},{"lineBreak":true},{"text":"oorruu muka woyni'ii teessan keessa isiniif hin huja.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isin ammoo, «Hayyoota Mootii Waan Maraa, tajaajiltoota Waaqa keennaa» jedhantanee hin waammatan.","poem":1},{"lineBreak":true},{"text":"Isin qabeenna gosa biyya adda addaa hin nyaattan;","poem":1},{"text":"durummaa isaaniitiin hin koortan.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kolbaan tiyya addee qaani'ii qooda harka lama hin fudhatti;","poem":1},{"text":"addee salphinnaa dhaala ifiititti hin gammaddi;","poem":2},{"lineBreak":true},{"text":"qooda lafa ifii harka lama hin fudhatti;","poem":2},{"lineBreak":true},{"text":"haga bara baraalle hin gammaddi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ani Mootii Waan Maraa haqa waan jaaladhuuf,","poem":1},{"text":"saamichaa fi yakkaa jibba.","poem":2},{"text":"Ani addatamummaa tiyyaan","poem":1},{"text":"kolbaa tiyyaaf gatii hujii isaanii hin keenna;","poem":2},{"lineBreak":true},{"text":"isaan wolille'een gondooroo bara baraa hin godha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sanyiin isaanii gosa biyya adda addaa keessatti,","poem":1},{"text":"ijoolleen isaaniille kolbaa oddu'utti hin beekkanti;","poem":2},{"lineBreak":true},{"text":"nami isaan dhaggu marti","poem":2},{"lineBreak":true},{"text":"isaan kolbaa Mootiin Waan Maraa eebbise","poem":2},{"lineBreak":true},{"text":"akka te'ane hin beeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ani Mootii Waan Maraatiin guddoo gammada;","poem":1},{"text":"lubbuun tiyyalle Waaqa kiyyaan firinxiixxi.","poem":2},{"text":"Akkuma waajibichi akka hayyu'uu marata mata'atti maratu,","poem":1},{"text":"akkuma waajibittiin dooqaan ifi seefattu,","poem":2},{"lineBreak":true},{"text":"inni woyaa fayyinnaa","poem":2},{"lineBreak":true},{"text":"natti uffiseera;","poem":2},{"lineBreak":true},{"text":"bullukkoo balchumma'aalle itti dabalee natti uffiseera.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Akkuma latti biqiltuu biqilchitu,","poem":1},{"text":"akkuma oorruun sanyii itti facaafante lachisiittu,","poem":2},{"lineBreak":true},{"text":"Goottaan Mootiin Waan Maraa,","poem":2},{"lineBreak":true},{"text":"balchumma'aa fi leellisi","poem":2},{"lineBreak":true},{"text":"gosa biyya adda addaa duratti","poem":2},{"lineBreak":true},{"text":"akka lattu hin godha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/ISA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}