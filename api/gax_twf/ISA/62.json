{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"ISA","translationId":"gax_twf","name":"Isaayaasii Raagichaa","commonName":"Isaayaasii Raagichaa","title":"Kitaaba Isaayaasii Raagichaa","order":23,"numberOfChapters":66,"sha256":"43d1d4dce18c16808d379730f9d084e9e041c6b6e6a9b344a406dd4f58553d07","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gax_twf/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":62,"content":[{"type":"heading","content":["Xiyoon Maqaa Haareya Dhaggatte"]},{"type":"verse","number":1,"content":[{"text":"Balchummaan isi'ii akka aduu ganamaa,","poem":1},{"text":"fayyinni isi'iille akka xassaa bobe'uu haga issutti,","poem":2},{"lineBreak":true},{"text":"ani marroo Xiyoonii hin cadhisu;","poem":2},{"lineBreak":true},{"text":"marroo Yerusaalemii hin sarmu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gosi biyya adda addaa balchummaa teeti,","poem":1},{"text":"moototi marti ulfinna keeti hin dhaggan;","poem":2},{"lineBreak":true},{"text":"maqaa haareya Mootiin Waan Maraa sii kennuun","poem":2},{"lineBreak":true},{"text":"hin waamanta.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ati harka Mootii Waan Maraatitti","poem":1},{"text":"akka kallacha ulfinnaa,","poem":2},{"lineBreak":true},{"text":"harka Waaqa keetiititti","poem":2},{"lineBreak":true},{"text":"akka kallacha mooti'ii hin teeta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ati haganaa achi,","poem":1},{"text":"«Ta lakkifante» hin jedhantu,","poem":2},{"lineBreak":true},{"text":"yookiin «Lafa duwwaa» hin jedhantu;","poem":2},{"text":"Mootiin Waan Maraa waan sitti gammaduuf,","poem":1},{"text":"latti teetille abbaa manaa waan qabaattuuf,","poem":2},{"lineBreak":true},{"text":"ati ammoo, «Gammadi kiyya isi'iin» jedhantee hin waamanta;","poem":2},{"lineBreak":true},{"text":"latti teetille, «Dubartii abbaa manaa qaddu» jedhantee hin waamanti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Akkuma dargaggeessi durra fuudhu,","poem":1},{"text":"ilmaan teeti si hin fuuti.","poem":2},{"text":"Akkuma waajibichi waajibittii ifiititti gammadu,","poem":1},{"text":"Waaqi keetille si'itti hin gammada.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ee Yerusaalem,","poem":1},{"text":"ani dalleya dhaka'aa keetii irra,","poem":2},{"lineBreak":true},{"text":"eeddota keyeera;","poem":2},{"lineBreak":true},{"text":"isaan halkanii fi guyyaa ijjumaa hin cadhisanu.","poem":2},{"text":"Isin worri Mootii Waan Maraa waammatanu hin foorfatina'a.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Haga Mootiin Waan Maraa qachaa Yerusaalemii","poem":1},{"text":"deebisee ijaarutti,","poem":2},{"lineBreak":true},{"text":"kolbaan marti haga isii leellittutti","poem":2},{"lineBreak":true},{"text":"foora isaaf hin kennina'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mootiin Waan Maraa harka ifii middicha,","poem":1},{"text":"irree ifii jaddu'uun kakatee,","poem":2},{"lineBreak":true},{"text":"«Ani deebi'ee diinni keeti midhaan keeti akka nyaatu,","poem":2},{"lineBreak":true},{"text":"daadhii woynii teeti ta ati itti elootte,","poem":2},{"lineBreak":true},{"text":"ormi akka unu hin godhu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isin worri midhaan galfattanu ammoo,","poem":1},{"text":"midhaan san nyaattanee Mootii Waan Maraa hin leellifattan;","poem":2},{"lineBreak":true},{"text":"isin worri midhaan woyni'ii guurattanu,","poem":2},{"lineBreak":true},{"text":"badhinna Galma kiyyaa keessatti","poem":2},{"lineBreak":true},{"text":"daadhii woyni'ii hin untan» jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kolbaa Yerusaalemii, karaa karra qacha'aatiin dabara'a;","poem":1},{"text":"kolba'aafille karaa qopheessa'a!","poem":2},{"text":"Karaa guddaa baasa'a; dhakaa karaa keessaa kaasa'a;","poem":1},{"text":"gosa biyya adda addaatiif baandiraa ol kaasa'a.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mootiin Waan Maraa,","poem":1},{"text":"«Kolbaa Xiyooniitiin, ‹Kunoo, fayyisaan keessan dhufaara;","poem":2},{"lineBreak":true},{"text":"gatiin inni isinii kennu,","poem":2},{"lineBreak":true},{"text":"wonni inni isiniif kaffalu harka isaa jirti› jedha'aan»","poem":2},{"lineBreak":true},{"text":"jedhee, haga qaccee biyya lafaatitti lasseera.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Isaan, «Kolbaa Woyyittii,","poem":1},{"text":"ta Mootiin Waan Maraa wode» jedhamane hin waamaman.","poem":2},{"text":"Yerusaalemille,","poem":1},{"text":"«Qachaa barbaadamu,","poem":2},{"lineBreak":true},{"text":"ka hin lakkifanne»","poem":2},{"lineBreak":true},{"text":"jedhantee hin waamanti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}