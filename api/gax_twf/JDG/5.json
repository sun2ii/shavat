{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JDG","translationId":"gax_twf","name":"Kitaaba Abbootii Mura'aa","commonName":"Kitaaba Abbootii Mura'aa","title":"Kitaaba Abbootii Mura'aa","order":7,"numberOfChapters":21,"sha256":"9b64a7e4cab2229f72ddc69c1b34522cb6a8415328d70c21491789d4fe57eaf7","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/gax_twf/JDG/21.json","totalNumberOfVerses":617},"chapter":{"number":5,"content":[{"type":"heading","content":["Faaruu Debora'aatii Fi Baaraaqii"]},{"type":"verse","number":1,"content":["Guyyaa san Debora'aa fi ilmi Abiino'aamii Baaraaqi faaruu asii gad jirtu faarfatanee,"]},{"type":"verse","number":2,"content":[{"text":"«Sooressitooti Israa'eloota waan sooressaneef,","poem":1},{"text":"kolbaalle fedhii ifiitiin","poem":2},{"lineBreak":true},{"text":"duuliisaaf waan murteeffatteef","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa galateeffadha'a!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«Isin Mootoleen, dhage'a'a!","poem":1},{"text":"Isin sooreyyiin, caqasa'a!","poem":2},{"text":"Ani Mootii Waan Maraatiif hin faarsa!","poem":1},{"text":"Mootii Waan Maraa","poem":2},{"lineBreak":true},{"text":"Waaqa Israa'elii hin leellifadha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Ee Mootii Waan Maraa,","poem":1},{"text":"yennaa ati gaara Se'iirii irraa kaate,","poem":2},{"lineBreak":true},{"text":"yennaa ati biyya Edoomii keessa deente","poem":2},{"lineBreak":true},{"text":"latti tachootee,","poem":2},{"lineBreak":true},{"text":"ol-gubbaan bisaan dhangalaatte;","poem":2},{"lineBreak":true},{"text":"duumensille bokkeya roobisiise.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gaaroti Mootii Waan Maraa","poem":1},{"text":"Waaqa Siina'aa duratti,","poem":2},{"lineBreak":true},{"text":"fuula Mootii Waan Maraa","poem":2},{"lineBreak":true},{"text":"Waaqa Israa'elii duratti tacho'ane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Bara Shamgaarii ilma Anaatii,","poem":1},{"text":"bara Yaa'elii","poem":2},{"lineBreak":true},{"text":"karaan guddaan one;","poem":2},{"lineBreak":true},{"text":"worri karaa deemulle","poem":2},{"lineBreak":true},{"text":"karaa miliffataatiin deemaniiyyu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Haga guyyaa ani Deboraan","poem":1},{"text":"Israa'eliif akka haadhaa te'ee ka'etti,","poem":2},{"lineBreak":true},{"text":"qachaan Israa'elii oneera.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Achiin duuba Israa'elooti","poem":1},{"text":"waaqota dur hin beenne yennaa filatane,","poem":2},{"lineBreak":true},{"text":"lolli gara karra qacha'aa dhufe;","poem":2},{"lineBreak":true},{"text":"Israa'eloota kuma afurtama oddu'utti,","poem":2},{"lineBreak":true},{"text":"wonteen yookiin eboon hin dhagganne.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gadhaan kiyya","poem":1},{"text":"dura aantota worra woraanaa ka Israa'elii,","poem":2},{"lineBreak":true},{"text":"ka fedhii ifiitiin duuliisaaf murteeffate bira jira.","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa leellisa'a!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Isin worri harree adaadii irraa teettanu,","poem":1},{"text":"worri gilaasii seefante irra teettanu,","poem":2},{"lineBreak":true},{"text":"worri karaa irralle deddeentanu,","poem":2},{"lineBreak":true},{"text":"marroo waan kanaa hima'a.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Qeexala worra heddu'uu","poem":1},{"text":"ka adaala boolla bisaaniitii dhage'amu dhage'a'a;","poem":2},{"lineBreak":true},{"text":"qeexalli sun injifachaa Mootii Waan Maraa,","poem":2},{"lineBreak":true},{"text":"injifachaa kolbaa Israa'eliille hima.","poem":2},{"lineBreak":true},{"text":"«Achiin duuba kolbaan Mootii Waan Maraa","poem":1},{"text":"gara karra qacha'aa gad buute.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Debora'a, ka'i, Ka'i!","poem":1},{"text":"Ka'i, ka'iitii faarfadhu!","poem":2},{"text":"Baaraaqii ilma Abiino'aamii,","poem":1},{"text":"atille ka'i!","poem":2},{"lineBreak":true},{"text":"Worra boojite qabadhuu deemi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Achiin duuba worri hafe","poem":1},{"text":"gara qondaaltotaa gad bu'ane.","poem":2},{"lineBreak":true},{"text":"Kolbaan Mootii Waan Maraa marroo tiyyaaf","poem":2},{"lineBreak":true},{"text":"worra hunnaameyyii loliisaaf dhutte.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Worri dhufelle, sanyii Efreemii keessaa gariin","poem":2},{"lineBreak":true},{"text":"addee dur worri Amaaleqootaa le'u irraa dhufane.","poem":2},{"lineBreak":true},{"text":"Worri dhibiille sanyii Beniyaamii keessaa dhufane.","poem":2},{"text":"Sanyii Maakiirii keessaa","poem":1},{"text":"dura aantoti worra woraanaa,","poem":2},{"lineBreak":true},{"text":"sanyii Zebuloon keessaa","poem":2},{"lineBreak":true},{"text":"worri ulee bokku'uu qabatu dhufane.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Sooressitooti sanyii Yisaakorii","poem":1},{"text":"Deboraa woliin dhufane;","poem":2},{"lineBreak":true},{"text":"Baaraaqille sanyii Yisaakorii woliin dhufee,","poem":2},{"lineBreak":true},{"text":"gara dhooqaa isa gula ori'e.","poem":2},{"text":"Sanyiin Ruubenii yennaa dheertuu itti yaadanee","poem":1},{"text":"murteeffatiisa hin dandeenne.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Maaf odduu gooree hoole'ee teettane?","poem":1},{"text":"Madha hoole'ee dhage'iisaafii?","poem":2},{"text":"Eeti'i, sanyiin Ruubenii yennaa dheertuu itti yaadanee","poem":1},{"text":"murteeffatiisa hin dandeenne.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sanyiin Giil'aad laga Yordaanosii irraa","poem":1},{"text":"gara aduun baatutti turte;","poem":2},{"lineBreak":true},{"text":"sanyiin Daanii maaf hoboloo guddittii keessa turte?","poem":2},{"text":"Sanyiin Asheerii qarqara abbaaya'aa,","poem":1},{"text":"addee buufata hobolo'oo turte.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Sanyiin Zebuloonii du'aaf ifi dabarsitee kennite.","poem":1},{"text":"Sanyiin Niftaalemille","poem":2},{"lineBreak":true},{"text":"koobota woraanaa irratti akkasuma goote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«Moototi dhufanee lolane;","poem":1},{"text":"yennaa san mootota Kana'aanii","poem":2},{"lineBreak":true},{"text":"qachaa Ta'ana'aatitti","poem":2},{"lineBreak":true},{"text":"bisaan Megidoo biratti lolane","poem":2},{"lineBreak":true},{"text":"ammoo meetii takkaalle,","poem":2},{"lineBreak":true},{"text":"waan dhibiille hin saanne.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Urjooti ol-gubbaa irra,","poem":1},{"text":"daandii ifii irra deemaa Siiseraa lolte.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Lagi Qiisonii ka durii durii sun,","poem":1},{"text":"isaan haree dabare.","poem":2},{"text":"Lubbuu tiyya,","poem":1},{"text":"jabaadhuu deem!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Fardoon Kotte'een hididditte;","poem":1},{"text":"gulufaa gulufaa","poem":2},{"lineBreak":true},{"text":"gara fardoo jajjaba Siisaara'aa dhaxxe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ergamaan Mootii Waan Maraa,","poem":1},{"text":"‹Qachaa Merozii abaara'a!","poem":2},{"text":"Worri qachaa san keessa le'u,","poem":1},{"text":"Worra hunnaameyyii loliisaan,","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa qarqaariisaaf","poem":2},{"lineBreak":true},{"text":"waan hin dhufiniif, akka malee abaara'a› jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"«Niitiin Heberii Qenichaa Yaa'el,","poem":1},{"text":"dubartoota mara caalaa","poem":2},{"lineBreak":true},{"text":"ta hiree dansaa qaddu teetuu ti;","poem":2},{"lineBreak":true},{"text":"dubartoota dunkaanii keessa leetu caalaa","poem":2},{"lineBreak":true},{"text":"ta hiree dansaa qaddu teetuu ti.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Siiseraan, bisaan kadhate;","poem":1},{"text":"isiin ammoo aanan isaaf kennite;","poem":2},{"lineBreak":true},{"text":"qodaa goottole'eetitti itittuu dhikeessiteef.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Isiin harka tokkoon","poem":1},{"text":"togaa dunkaanaa qabattee,","poem":2},{"lineBreak":true},{"text":"harka middaatiin","poem":2},{"lineBreak":true},{"text":"burrisa hojjattootaa qabattee,","poem":2},{"text":"Siiseraa dhoottee mataa butuchitee,","poem":1},{"text":"shikaala san guunaa gurra isaatitti dhoottee","poem":2},{"lineBreak":true},{"text":"jalaa fullaache.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Inni laafee,","poem":1},{"text":"miila isi'ii jalatti jige;","poem":2},{"lineBreak":true},{"text":"Adduma jige sanitti du'e.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"«Haati Siisera'aa","poem":1},{"text":"karaa foddaa manaatiin gad ilaaltee,","poem":2},{"lineBreak":true},{"text":"iyyitee, ‹Garreettaan fardaan harkifamu","poem":2},{"lineBreak":true},{"text":"ka mucaa kiyyaa maaf ture?","poem":2},{"lineBreak":true},{"text":"hididdeettiin kottee fardaa","poem":2},{"lineBreak":true},{"text":"maaf hin dhage'anne?› jette.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Dubartooti tajaajiltooti isi'ii qarooleen,","poem":1},{"text":"gaaffii isi'iitiif deebii kennane;","poem":2},{"lineBreak":true},{"text":"isiin ifumaan ifiin dubbattee,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"‹Isaan boojuu booji'anee,","poem":1},{"text":"dubartii tokko tokko yookiin lama lama","poem":2},{"lineBreak":true},{"text":"loltoota tokko tokkoofuu,","poem":2},{"lineBreak":true},{"text":"Siisera'aaf woyaa kuula adda addaatiin seefante,","poem":2},{"lineBreak":true},{"text":"morma worra booji'eetiif","poem":2},{"lineBreak":true},{"text":"woyaa kuula adda addaatiin seefante","poem":2},{"lineBreak":true},{"text":"qoodamiisatti jiranii motii?› jette.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"«Ee Mootii Waan Maraa,","poem":1},{"text":"diinoti keeti marti badanuu ti.","poem":2},{"lineBreak":true},{"text":"Worri si jaalatu ammoo,","poem":2},{"lineBreak":true},{"text":"akka aduun ganamaa akka malee issitu,","poem":2},{"lineBreak":true},{"text":"issanuu ti» jette.","poem":2},"Achiin duuba biyya sanitti woggaa afurtama nageenni te'e."]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}