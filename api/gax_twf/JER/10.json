{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JER","translationId":"gax_twf","name":"Kitaaba Ermiyaasii Raagichaa","commonName":"Kitaaba Ermiyaasii Raagichaa","title":"Kitaaba Ermiyaasii Raagichaa","order":24,"numberOfChapters":52,"sha256":"0beb0f61056c8788905272f33c1f534108297f31f6a15b4cbcef5df1c139234d","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gax_twf/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":10,"content":[{"type":"heading","content":["Waaqota Dharaa Waaqonfatiisaa Fi Waaqonfannaa Dhuga'aa"]},{"type":"verse","number":1,"content":["Ee, kolbaa Israa'elii, waan Mootiin Waan Maraa isinitti dubbattu dhage'a'a!"]},{"type":"verse","number":2,"content":["Mootiin Waan Maraa, «Karaa gosa biyya adda addaa hin hordofina'a!",{"text":"Isaan beessisa gubba'aatiin hin bararaqin;","poem":2},{"lineBreak":true},{"text":"isin waan kanaan hin bararaqina'a.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Aadaan kolbaa tanaa waan bu'aa hin qanne;","poem":1},{"text":"isaan muka gongomaa keessaa muran;","poem":2},{"lineBreak":true},{"text":"nami muka bocu uraa ifiitiin bifa itti baasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Meeti'ii fi worqi'iin gonfanee seesan;","poem":1},{"text":"akka hin jinneef","poem":2},{"lineBreak":true},{"text":"burrisaan mismaara itti dhowanee hin jabeessan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Waaqoti isaanii akka waan bineensa sodaachisaaf,","poem":1},{"text":"fichaa baaqula'aa keessa dhaabanee ti;","poem":2},{"lineBreak":true},{"text":"waaqoti isaanii dubbatiisa hin dande'anu;","poem":2},{"lineBreak":true},{"text":"ideemiisalle waan hin dandeenneef,","poem":2},{"lineBreak":true},{"text":"namatti isaan ba'atee ideema.","poem":2},{"text":"Isaan nama miidhiisa","poem":1},{"text":"yookiin waan dansaa godhiisa waan hin dandeenneef,","poem":2},{"lineBreak":true},{"text":"isaan hin sodaatina'a» jedha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ee Mootii Waan Maraa, ka akka keetii hin jiru;","poem":1},{"text":"ati gudda'a;","poem":2},{"lineBreak":true},{"text":"baalliin maqaa keetiille guddo'o.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ee, mootii gosa biyya adda addaa,","poem":1},{"text":"ka si hin sodaanne eennu?","poem":2},{"text":"Qaroolee gosa biyya adda addaatii fi","poem":1},{"text":"mootummoota isaanii mara keessaa,","poem":2},{"lineBreak":true},{"text":"ka akka keetii waan hin jirreef,","poem":2},{"lineBreak":true},{"text":"ulfinni si'iif male.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Isaan marti daallotaa fi gowwoota;","poem":1},{"text":"isaan waaqota dharaa ka muka irraa bocame irraa baratan.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Waaqoti dharaa ka isaanii kun hujii harka namaa ti;","poem":1},{"text":"isaan meetii qulqulluu biyya Tarshiishiitii dhuttuu fi","poem":2},{"lineBreak":true},{"text":"worqii biyya Ufaaziitii dhuttu irraa hujamane;","poem":2},{"lineBreak":true},{"text":"woyaan bifa cuquliisaatii fi dhiilleen isaan uffatanu marti","poem":2},{"lineBreak":true},{"text":"hujii worra ogeeyyi'ii ti.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mootiin Waan Maraa ammoo Waaqa dhuga'aa ti;","poem":1},{"text":"inni Waaqa jiraata'a fi mootii bara baraa ti.","poem":2},{"text":"Yennaa inni aaru latti hin tachooti;","poem":1},{"text":"gosi biyya adda addaalle mufii isaa dura dhaabbatiisa hin dandeettu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isin, «Waaqoti dharaa ka ol-gubba'aa fi lafa hin dadin kun,","poem":1},{"text":"ol-gubba'aan jala irraa, lafa irralle'ee","poem":2},{"lineBreak":true},{"text":"hin badan» jedha'aatii isaanitti hima'a.","poem":2}]},{"type":"heading","content":["Faaruu Waaqa Leellisiisaa"]},{"type":"verse","number":12,"content":[{"text":"Waaqi hunna ifiitiin lafa dade;","poem":1},{"text":"qarummaa ifiitille'een biyya lafaa hundeesse;","poem":2},{"lineBreak":true},{"text":"hubantii ifiitille'een ol-gubbaa diriirse.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yennaa inni qoonqoo ifii ta akka mandiisu'uu dhageessisu,","poem":1},{"text":"bisaan ol-gubba'aa hin shookkisa;","poem":2},{"lineBreak":true},{"text":"inni duumensi qaccee lafaa irraa akka ol ka'u hin godha;","poem":2},{"lineBreak":true},{"text":"bokkeya keessa balaqqeettii hin buusa;","poem":2},{"lineBreak":true},{"text":"qilleensalle mana kuusa'aa ka ifii keessa hin fida.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Isaan martinuu worra daalle'ee fi","poem":1},{"text":"worra beekkumsa hin qanne;","poem":2},{"lineBreak":true},{"text":"worri worqii baqisiisu marti","poem":2},{"lineBreak":true},{"text":"waaqota dharaa ka hujane sanitti fokkifataneeran.","poem":2},{"text":"Fakkiin isaan hujane ta dharaa ti;","poem":1},{"text":"hafuuralle hin qaddu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Isaan worra bu'aa hin qanne, meya murgo'oo ti;","poem":1},{"text":"yennaa muraan isaanitti dhuttu hin badan.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Waaqi Yaaqoobii ammoo akka isaan kanaatii moti;","poem":1},{"text":"waan mara ka dade isa waan te'eef,","poem":2},{"lineBreak":true},{"text":"kolbaa Israa'eliille ka ifii godhatiisaaf filate;","poem":2},{"lineBreak":true},{"text":"maqaan isaa Mootii Waan Maraa Ka Waan Mara Dade.","poem":2}]},{"type":"heading","content":["Badii Dhufu'uu Jirtu"]},{"type":"verse","number":17,"content":["Ee, isin worri marfantaneertanu, meya keessan ka lafa jiru wolitti qabadha'a."]},{"type":"verse","number":18,"content":["Mootiin Waan Maraa, «Ani amma worra lafa tana keessa le'u, fugussee hin baasa; akka isaan booji'amanuuf rakkinna isaanitti hin fida» jedha."]},{"type":"verse","number":19,"content":[{"text":"Ani waan madoweef","poem":1},{"text":"naaf aanne'e!","poem":2},{"text":"Madaan tiyyalle ta hin fayyine.","poem":1},{"text":"Ani ammoo, «Tun dhibee tiyya;","poem":2},{"lineBreak":true},{"text":"anille ossatuu qaba» jedhe.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dunkaaniin tiyya diiganteerti;","poem":1},{"text":"wodaroon isi'ii marti ciccitteerti.","poem":2},{"text":"Ijoolleen tiyya na lakkittee deenteerti;","poem":1},{"text":"deebi'ee isaan hin dhaggu;","poem":2},{"lineBreak":true},{"text":"nami dunkaanii tiyya naaf dhaabu,","poem":2},{"lineBreak":true},{"text":"ka gollaa kiyyalle naaf diriirsu tokkolle hin hanne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tissitooti daallee waan teeteef,","poem":1},{"text":"Mootii Waan Maraa irraa gorsa hin gaafattu;","poem":2},{"lineBreak":true},{"text":"tanaaf isaaniif hin milkoonne;","poem":2},{"lineBreak":true},{"text":"tiki isaanii marti bittinnoweera.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Caqasa'a! Oduun dhufiisatti jirti.","poem":1},{"text":"Kunoo gara lafa kaabaatii hogaan guddaan hin dhufa.","poem":2},{"text":"Hogaan sun qachoota Yihuda'aa onsee,","poem":1},{"text":"addee jeedalti leetu hin godha.","poem":2}]},{"type":"heading","content":["Daadimata Ermiyaasii"]},{"type":"verse","number":23,"content":[{"text":"Ee Mootii Waan Maraa!","poem":1},{"text":"Jiruun namaa tama isaa akka hin te'in ani hin beeka;","poem":2},{"lineBreak":true},{"text":"nami ideensa ifii ifumaan qajeelchuu hin dande'u.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ee Mootii Waan Maraa! Akka ani ijjumaa hin banne","poem":1},{"text":"haqaan na adabi malee,","poem":2},{"lineBreak":true},{"text":"aarii teetiin na hin adabin.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Gosi biyya adda addaa ta si hin beennee fi","poem":1},{"text":"kolbaan maqaa keeti hin waammanne","poem":2},{"lineBreak":true},{"text":"sanyii Yaaqoobii balleessiteerti.","poem":2},{"text":"Isaan sanyii Yaaqoobii ijjumaa fixanee,","poem":1},{"text":"lafa isaanii waan onsaneef,","poem":2},{"lineBreak":true},{"text":"aarii teeti isaan irratti dhangalaasi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JER/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JER/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JER/9.json","previousChapterAudioLinks":{},"numberOfVerses":25}