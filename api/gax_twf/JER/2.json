{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JER","translationId":"gax_twf","name":"Kitaaba Ermiyaasii Raagichaa","commonName":"Kitaaba Ermiyaasii Raagichaa","title":"Kitaaba Ermiyaasii Raagichaa","order":24,"numberOfChapters":52,"sha256":"0beb0f61056c8788905272f33c1f534108297f31f6a15b4cbcef5df1c139234d","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gax_twf/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":2,"content":[{"type":"heading","content":["Kolbaan Israa'elii Waaqa ifii Lakkitte"]},{"type":"verse","number":1,"content":["Jechi Mootii Waan Maraa gara kiyya dhufee,"]},{"type":"verse","number":2,"content":["«Dhaqiitii qoonqoo teeti ol qabadhuu, kolbaa qachaa Yerusaalemiitiin, Mootiin Waan Maraa, ‹Addatamummaa teessan ta yennaa dargaggumma'aa, jaalala keessan ka akka waajibittiin dhirsa ifii jaalattuu, goomolee lafa sanyiin hin facaafanne keessatti attam akka na hordottane hin qaabadha."]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«‹Kolbaan Israa'elii","poem":1},{"text":"ana Mootii Waan Maraatiif woyyoonteerti;","poem":2},{"lineBreak":true},{"text":"akka midhaan mata'aa ti;","poem":2},{"lineBreak":true},{"text":"nama isaan miidhe maratti yakkaan muranteerti;","poem":2},{"lineBreak":true},{"text":"badiille isa dhaqqaddeerti jedheera› jedhii himi» jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ee, isin sanyii Yaaqoobii,","poem":1},{"text":"firri sanyii Israa'elii marti","poem":2},{"lineBreak":true},{"text":"jecha Mootii Waan Maraa dhage'a'a!","poem":2}]},{"type":"verse","number":5,"content":["Mootiin Waan Maraa,",{"text":"«Abbootiin teessan ta durii","poem":1},{"text":"balleessaa maanii na irratti dhagganee,","poem":2},{"lineBreak":true},{"text":"na irraa fagaatanee,","poem":2},{"lineBreak":true},{"text":"waaqota dharaa ka gatii hin qanne waaqonfatanee,","poem":2},{"lineBreak":true},{"text":"ifille'eef worra gatii hin qanne te'ane?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isaan, ‹Waaqi biyya Gibxi'ii keessaa nu baasee,","poem":1},{"text":"lafa goomolee keessa,","poem":2},{"lineBreak":true},{"text":"lafa boboollittii keessaa fi gammoojjii keessa,","poem":2},{"lineBreak":true},{"text":"lafa goddu'uu fi dukkana dimma keessa,","poem":2},{"lineBreak":true},{"text":"lafa nami keessa hin ideennee fi","poem":2},{"lineBreak":true},{"text":"lafa nami keessa hin leene keessa","poem":2},{"lineBreak":true},{"text":"ka nu sooresse eessa jira?› jedhanee hin gaafanne.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ani midhaan isi'iitii fi waan dansaa isiin baattu,","poem":1},{"text":"akka isii irraa nyaattanuuf","poem":2},{"lineBreak":true},{"text":"gara lafa laayyo'oo, isin fide;","poem":2},{"lineBreak":true},{"text":"isin ammoo yennaa achi galtane lafa tiyya batteessitanee,","poem":2},{"lineBreak":true},{"text":"lafa tiyya akka jibbatantu gootane.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hayyooti, ‹Mootiin Waan Maraa eessa jira?› jedhanee hin gaafanne;","poem":1},{"text":"barsiisoti seeraa na hin beenne;","poem":2},{"lineBreak":true},{"text":"sooressitooti na irratti ka'ane;","poem":2},{"lineBreak":true},{"text":"raagoti maqaa ba'aaliitiin raaganee,","poem":2},{"lineBreak":true},{"text":"waaqota dharaa ka gatii hin qanne hordofane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Tanaaf ani Mootiin Waan Maraa isiniin hin morma;","poem":1},{"text":"ijoollee ijoollee teessaniitille'een hin morma.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tanaan qara wonni akkasii yoo teetee jiraatte,","poem":1},{"text":"gara lafa Qophiroosii ta dur,","poem":2},{"lineBreak":true},{"text":"‹Kiitiim› jedhantuu gamatti bu'a'aatii ilaala'a;","poem":2},{"lineBreak":true},{"text":"gara lafa, ‹Qedaar› jedhantuulle nama erga'aatii qorqora'a.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Waaqota dharaa te'anulle,","poem":1},{"text":"kolbaan waaqota ifii jijjiirte hin jirtu;","poem":2},{"lineBreak":true},{"text":"kolbaan tiyya ammoo ana Waaqa ulfinna isaanii te'e","poem":2},{"lineBreak":true},{"text":"waaqota dharaa ka gatii hin qannetti jijjiirte.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ee ol-gubba'a, waan kana baaseffadhu;","poem":1},{"text":"sodaa guddo'oon holladhu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kolbaan tiyya cubbuu lama hujjeerti;","poem":1},{"text":"isaan ana madda bisaan jiru'uu lakkisanee,","poem":2},{"lineBreak":true},{"text":"boolla urata qaddu ta bisaan itti hin eelle qotataneeran.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Israa'el garbichaa? Yookiin garba manatti dhalatee?","poem":1},{"text":"Yoo akkas hin te'in maaf diinni isa saama ree?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Diinoti isa irratti akka neenqaa harqaneeran;","poem":1},{"text":"lafa isaa balleessaneeran;","poem":2},{"lineBreak":true},{"text":"qachooti isaa gubatanee, ona te'aneeran.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Worri qachaa Memfiisiitii fi qachaa Taahafeneesii","poem":1},{"text":"rifeensa mataa keetii haadane.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ee Israa'el, ana Mootii Waan Maraa Waaqa keeti","poem":1},{"text":"ka karaa keeti si sooresse lakkittee,","poem":2},{"lineBreak":true},{"text":"kana mara ifi irratti fiddee motii ree?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bisaan laga Shiihorii uniisaaf gara","poem":1},{"text":"biyya Gibxi'ii maaf dhaxxe?","poem":2},{"text":"Bisaan laga Efraaxiisiille uniisaaf","poem":1},{"text":"gara biyya Asoorii maaf dhaxxe?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hammeenni keeti akka adabantu si hin godha;","poem":1},{"text":"naaf addatamummaa dhabiis keeti","poem":2},{"lineBreak":true},{"text":"akka xixantu si hin godha.","poem":2},{"lineBreak":true},{"text":"Ana Mootii Waan Maraa Waaqa keeti","poem":2},{"lineBreak":true},{"text":"sodaatiisa waan lakkitteef,","poem":2},{"lineBreak":true},{"text":"wonni hantuun hadhoottuun","poem":2},{"lineBreak":true},{"text":"akka sitti dhuttu hubadhuu beeki!","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«Ee Israa'el! Ani bara duriitii jalqabee","poem":1},{"text":"waanjoo teeti si irraa caccassee,","poem":2},{"lineBreak":true},{"text":"hidhaa teeti si irraa kukkuteera;","poem":2},{"lineBreak":true},{"text":"ati ammoo, ‹Ani si hin tajaajilu!› jettee,","poem":2},{"lineBreak":true},{"text":"kooba dheertuu gubba'aa fi muka banqaaqaa jalatti","poem":2},{"lineBreak":true},{"text":"sagaagaliisaaf irkatteerta.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ani akka muka woyni'ii filatamaa","poem":1},{"text":"ka sanyiin isaa dansa'aa si dhaabeeyyu;","poem":2},{"lineBreak":true},{"text":"ati attam akka muka woyni'ii badaa,","poem":2},{"lineBreak":true},{"text":"ka baddaa keessaa teetee,","poem":2},{"lineBreak":true},{"text":"na duraa jijjiirante ree?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Haraanja'aa fi saamunaa baca'aan dhiqattelle","poem":1},{"text":"xuriin yakkaa teetii haga ammaa fuula kiyya dura jirti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"«Ati attam, ‹Ani hin battoonne,","poem":1},{"text":"Ba'aalille hin hordonne› jetta ree?","poem":2},{"text":"Dhooqa keessatti maan akka hujje yaadadhu;","poem":1},{"text":"waan achi keessatti goote hubadhu.","poem":2},{"text":"Ati akka gaala dhala'aa","poem":1},{"text":"ka raragatee asii fi achi fiiguu ti.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ati akka harree diidaa ta goomolee keessa le'iisa baratte,","poem":1},{"text":"ta yennaa rarragatte qilleensa suuttuu ti;","poem":2},{"lineBreak":true},{"text":"rarragata isi'ii eentu qabbaneessuu dande'a?","poem":2},{"lineBreak":true},{"text":"Ji'a isiin rarragatte san korommiin isii barbaadu,","poem":2},{"lineBreak":true},{"text":"rakkinna malee isii laddatan","poem":2},{"noteId":0},{"text":".","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ati haga kopheen miila keeti irraa dhumattutti,","poem":1},{"text":"haga dheebottee laagadaan si gogutti hin rukkisin;","poem":2},{"lineBreak":true},{"text":"ati ammoo, ‹Na dhooggiis keeti gatii hin qabu;","poem":2},{"lineBreak":true},{"text":"ani waaqota ormaa jaaladheera;","poem":2},{"lineBreak":true},{"text":"ani isaan hordofa› jette.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hattuun yennaa qabante akkuma qaanottu,","poem":1},{"text":"kolbaan Israa'elii, moototi isi'ii,","poem":2},{"lineBreak":true},{"text":"qondaaltoti isi'ii,","poem":2},{"lineBreak":true},{"text":"hayyootii isi'iitii fi","poem":2},{"lineBreak":true},{"text":"raagoti isi'ii marti hin qaanowan.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Isaan mukaan, ‹Ati abbaa keenna›,","poem":1},{"text":"dhakaa waaqota dharaatiin, ‹Sittuu nu deye› jedhan.","poem":2},{"text":"Isaan dudda ifii gara kiyya deebisane malee,","poem":1},{"text":"fuula ifii gara kiyya hin deebinne.","poem":2},{"text":"Yennaa rakkinnaa ammoo,","poem":1},{"text":"‹Koyii nu fayyisi› jedhan.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ee worra Yihuda'aa,","poem":1},{"text":"waaqoti dharaa ka isin hujattane meeti ree?","poem":2},{"text":"Isaan yennaa rakkinna keessanii yoo isin fayyisanu teete,","poem":1},{"text":"dhufanee isin fayyisanuu ti.","poem":2},{"text":"Akkuma qachaan keessan baca'aa,","poem":1},{"text":"waaqoti keessanille baca'a.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Isin martinuu, na irratti kaataneertan;","poem":1},{"text":"maaf na komattan ree?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ani akkasumaan kolbaa teessan adabe malee,","poem":1},{"text":"isaan ifi hin sirreessine.","poem":2},{"text":"Akka neenqa beelowee","poem":1},{"text":"shallaagaa keessaniin raagota teessan fixxane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":["«Isin dhalooti bara kanaa,",{"text":"jecha Mootii Waan Maraa hubadha'a!","poem":2},{"lineBreak":true},{"text":"«Ani Israa'eliif goomolee","poem":1},{"text":"yookiin lafa dukkana dimmaa te'ee ree?","poem":2},{"text":"Kolbaan tiyya maaf, ‹Nuuti waan feene goona,","poem":1},{"text":"haganaa achi gara keeti hin deebinu› jetti?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Durri seesa ifii","poem":1},{"text":"yookiin waajibittiin woyaa ifii","poem":2},{"lineBreak":true},{"text":"ta waajibumma'aa hin deetii ree?","poem":2},{"text":"Kolbaan tiyya ammoo","poem":1},{"text":"bara bacaa na deeteerti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"«Ati worra si jaalatu gula deemiisaaf","poem":1},{"text":"attam qaroomatte?","poem":2},{"lineBreak":true},{"text":"Dubartooti akka malee hantu'uutuu","poem":2},{"lineBreak":true},{"text":"waan kana si irraa baratan.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Dhiigi worra hiyyeeyyii yakkaa hin qannee,","poem":1},{"text":"ka hanna irratti hin qabaminii","poem":2},{"lineBreak":true},{"text":"woyaa teetii irratti dhaggama;","poem":2},{"lineBreak":true},{"text":"kana mara gooteelle,","poem":2}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"‹Ani yakkaa hin qabu;","poem":2},{"lineBreak":true},{"text":"dhugumaan Mootiin Waan Maraa natti hin aaru› jetta.","poem":2},{"text":"Sababa ati, ‹Ani cubbuu hujee hin jiru› jetteef,","poem":1},{"text":"ani si'itti hin mura.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ati maaf karaa keeti jijjiiratta?","poem":1},{"text":"Akkuma worri Asoorii si qaanesse,","poem":2},{"lineBreak":true},{"text":"akkasuma worri Gibxi'iille si hin qaanessa.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Worra ati itti addatte Mootiin Waan Maraa waan tuffateef,","poem":1},{"text":"isaanille si qarqaaruu waan hin dandeenneef,","poem":2},{"lineBreak":true},{"text":"ati mataa qabattee, achii keessaa hin baata» jedha.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Laddatan: Lafa tokko tokkotti Doogamanjedhan.","reference":{"chapter":2,"verse":24}}]},"thisChapterLink":"/api/gax_twf/JER/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JER/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JER/1.json","previousChapterAudioLinks":{},"numberOfVerses":37}