{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JER","translationId":"gax_twf","name":"Kitaaba Ermiyaasii Raagichaa","commonName":"Kitaaba Ermiyaasii Raagichaa","title":"Kitaaba Ermiyaasii Raagichaa","order":24,"numberOfChapters":52,"sha256":"0beb0f61056c8788905272f33c1f534108297f31f6a15b4cbcef5df1c139234d","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gax_twf/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":30,"content":[{"type":"heading","content":["Waadaa Waaqi Kolbaa Ifiitiif Gale"]},{"type":"verse","number":1,"content":["Jechi Mootii Waan Maraa ka gara Ermiyaasii dhufe ka asii gad jiru;"]},{"type":"verse","number":2,"content":["Mootiin Waan Maraa Waaqi Israa'elii, «Jecha ani si'itti dubbadhe mara kitaabatti barreessi."]},{"type":"verse","number":3,"content":["Kunoo barri ani kolbaa tiyya Israa'elii fi Yihudaa boojuu keessaa deebisu dhufiisatti jira; ani gara lafa abbootii isaaniitiif kennetti isaan hin deebisa; latti sunille ta isaanii hin teeti» jedhe."]},{"type":"verse","number":4,"content":["Mootiin Waan Maraa marroo Israa'eliitii fi Yihuda'aa dubbatee,"]},{"type":"verse","number":5,"content":[{"text":"«Isin, ‹Nuuti iyya soda'aatii fi","poem":1},{"text":"bararaqiisaa dhageenneerra;","poem":2},{"lineBreak":true},{"text":"nageennille hin jiru› jettaneertan.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Me, gaafadha'aatii ilaala'a!","poem":1},{"text":"Dhiirti deyuu hin dandeettii?","poem":2},{"text":"Maaf dhiirti marti","poem":1},{"text":"akka dubartii ciniinsifattuu","poem":2},{"lineBreak":true},{"text":"harka ifiitiin gadhaa ifii qabattee","poem":2},{"lineBreak":true},{"text":"fuulli nama maraa shankaloweeruun","poem":2},{"lineBreak":true},{"text":"dhagga ree?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Aanne'e! Guyyaan sun","poem":1},{"text":"guyyaa hama'a;","poem":2},{"lineBreak":true},{"text":"guyyaan akka isaa hin jiraatu.","poem":2},{"text":"Sanyii Yaaqoobiitiif guyyaa rakkinnaa ti;","poem":1},{"text":"isaan ammoo kanuma keessaa hin hafan» jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mootiin Waan Maraa Ka Waan Mara Dade, «Ani guyyaa san,","poem":1},{"text":"waanjoo morma isaanii irraa fuudhee hin cassa;","poem":2},{"lineBreak":true},{"text":"hidhaana isaanille hin kuta;","poem":2},{"lineBreak":true},{"text":"haganaa achi ormi garba isaan hin godhatu;","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"isaan ammoo ana Mootii Waan Maraa Waaqaa ifiitii fi","poem":2},{"lineBreak":true},{"text":"sanyii Daawitii keessaa mooticha ani isaanii kaasu","poem":2},{"lineBreak":true},{"text":"hin tajaajilan.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Maarre, ee tajaajilaa kiyya Yaaqoob, hin sodaatin!","poem":1},{"text":"Ee kolbaa Israa'elii hin rifatina'a!","poem":2},{"text":"Ani dhugumaan biyya fago'oo irraa isin hin deebisa;","poem":1},{"text":"sanyii teessanille","poem":2},{"lineBreak":true},{"text":"lafa isaan itti booji'amane keessaa hin deebisa.","poem":2},{"text":"Yaaqoob deebi'ee bidhaa malee nageyaan hin le'a;","poem":1},{"text":"ka isa sodaachisulle hin jiru.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ani isin woliin jira;","poem":1},{"text":"isin hin gargaara;","poem":2},{"lineBreak":true},{"text":"gosa biyya adda addaa","poem":2},{"lineBreak":true},{"text":"ta odduu isaaniititti isin bittinneesse mara","poem":2},{"lineBreak":true},{"text":"ijjumaa hin balleessa;","poem":2},{"lineBreak":true},{"text":"isin ammoo guutumatti hin balleessu;","poem":2},{"lineBreak":true},{"text":"te'uu malee adoo hin adabin isin hin lakkisu» jedhe.","poem":2}]},{"type":"verse","number":12,"content":["Mootiin Waan Maraa,",{"text":"«Madaan teessan ta hin fayyine;","poem":1},{"text":"miidham keessanille ka hin fayyine.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nami isiniif falmatu hin jiru;","poem":1},{"text":"madaa teessaniif qorsi hin jiru;","poem":2},{"lineBreak":true},{"text":"isin hin fayyitanu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jaaloti teessan marti isin dedhaneeran;","poem":1},{"text":"isaan haajaa keessan hin qabanu.","poem":2},{"text":"Yakkaan teessan guddoo","poem":1},{"text":"cubbuun teessanille bacaa waan teeteef,","poem":2},{"lineBreak":true},{"text":"ani akkuma diina dhowanu isin dhowee,","poem":2},{"lineBreak":true},{"text":"marartii maleelle isin adabe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Isin madaa teessan ta hin fayyineef,","poem":1},{"text":"dhukkubbii madaa teessaniitiif maaf boottan?","poem":2},{"text":"Yakkaan teessan guddoo,","poem":1},{"text":"cubbuun teessanille bacaa waan teeteef,","poem":2},{"lineBreak":true},{"text":"ani waan kana mara isin irratti godheera.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Amma ammoo Worri isin balleessu marti hin bada;","poem":1},{"text":"diinoti keessan martinuu hin booji'aman;","poem":2},{"lineBreak":true},{"text":"worri isin saamu hin saamama;","poem":2},{"lineBreak":true},{"text":"worri isin dannabu marti hin dannabama.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Diinoti keessan isiniin, ‹Xiyoon gatanteerti;","poem":1},{"text":"ka haajaa isi'ii qabu hin jiru› jedhanulle","poem":2},{"lineBreak":true},{"text":"ani ammoo fayya'atti isin hin deebisa;","poem":2},{"lineBreak":true},{"text":"madaa teessanille hin fayyisa.","poem":2}]},{"type":"verse","number":18,"content":["«Kunoo, ani kolbaa tiyya",{"text":"worra sanyii Yaaqoobii keessaa booji'ame hin deebisa;","poem":2},{"lineBreak":true},{"text":"addee isaan le'anutti isaaniif hin marara.","poem":2},{"text":"Qachaan Yerusaalemii","poem":1},{"text":"addee duriititti deebi'ee hin ijaarama;","poem":2},{"lineBreak":true},{"text":"manni mootumma'aalle a","poem":2},{"lineBreak":true},{"text":"ddee duriititti deebi'ee hin ijaarama.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Achi keessaa faaruun galataatii fi","poem":1},{"text":"qoonqoo firinxiixaa hin dhage'anti.","poem":2},{"text":"Ani isaan hin baceessa malee,","poem":1},{"text":"laakkossa isaanii hin diqqeessu;","poem":2},{"text":"Ani ulfinna isaaniif hin kenna malee","poem":1},{"text":"isaan hin salphatanu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ijoolleen isaanii akkuma durii hin teeti;","poem":1},{"text":"kolbaan isaanii fuula kiyya duratti","poem":2},{"lineBreak":true},{"text":"jabaattee hin dhaabbatti;","poem":2},{"lineBreak":true},{"text":"ani worra isaan cunqursu mara hin adaba.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Namuma isaaniititti isaan sooressa;","poem":1},{"text":"ka isaan bulchulle odduma isaaniitii hin dhalata.","poem":2},{"text":"Ani gara kiyya isa hin dhikeessa;","poem":1},{"text":"innille natti hin dhikaata;","poem":2},{"lineBreak":true},{"text":"yoo akkas hin te'in eentu gara kiyya dhikaatiisaaf gama?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Maarre isin kolbaa tiyya hin teetan;","poem":1},{"text":"anille Waaqa keessan hin te'a» jedha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kunoo mufiin Mootii Waan Maraa","poem":1},{"text":"ta akka bubbee bokkeyaa hin kaati;","poem":2},{"lineBreak":true},{"text":"hobonbolattiin mataa worra hamoole'ee irratti hin buuti.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mootiin Waan Maraa fedhii ifii adoo hin muummessin","poem":1},{"text":"mufiin isaa duubatti hin deebitu;","poem":2},{"lineBreak":true},{"text":"bara dhufu'uu jiru keessatti akka dansaa hin hubattan.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JER/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JER/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JER/29.json","previousChapterAudioLinks":{},"numberOfVerses":24}