{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JER","translationId":"gax_twf","name":"Kitaaba Ermiyaasii Raagichaa","commonName":"Kitaaba Ermiyaasii Raagichaa","title":"Kitaaba Ermiyaasii Raagichaa","order":24,"numberOfChapters":52,"sha256":"0beb0f61056c8788905272f33c1f534108297f31f6a15b4cbcef5df1c139234d","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gax_twf/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":46,"content":[{"type":"heading","content":["Ergaa Marroo Biyya Gibxi'ii"]},{"type":"verse","number":1,"content":["Ergaan marroo gosa biyya adda addaatiif gara Ermiyaasii dhutte ta asii gad jirtu:"]},{"type":"verse","number":2,"content":["Ilmi Yosiyaasii Yehoyaaqiim mootii Yihuda'aa te'ee woggaa arfeesso'ootitti, qachaa karkemeshii laga Efraaxiisii biratti, loltoota mootii Gibxi'ii Fara'oon Nekoonii, ta mootiin Baabilonii Nebukadnezaar injifate irratti, ergaan marroo Gibxi'iitiif dubbatante ta asii gad jirtu:"]},{"type":"verse","number":3,"content":[{"text":"«Wontee teessan gugurdo'oo fi didiqqoo qopheeffadha'a,","poem":1},{"text":"lolaafille baya'a!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Farda keessan bixaalladha'a!","poem":1},{"lineBreak":true},{"text":"Gullee teessan ta sibiilaa keyadha'aatii addee qabadha'a!","poem":1},{"text":"Eboo keessan qaradha'aatii","poem":2},{"lineBreak":true},{"text":"qomoo teessan ta sibiilaa uffadha'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Mootii Waan Maraa, ‹Wonni ani dhaggu kun maan?","poem":1},{"text":"Isaan bararaqaneeran;","poem":2},{"lineBreak":true},{"text":"gara duubaa deebi'aneeran;","poem":2},{"lineBreak":true},{"text":"loltooti isaanii jajjaboon injifatamaneeran;","poem":2},{"lineBreak":true},{"text":"ifi duuba adoo hin ilaalin","poem":2},{"lineBreak":true},{"text":"ariiti'iin baqataaran;","poem":2},{"lineBreak":true},{"text":"bararaqiisi isaan marseera› jedha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Worri akka malee rukkisu,","poem":1},{"text":"worri jajjabille jalaa bayuu hin dande'u;","poem":2},{"lineBreak":true},{"text":"biyya gara kaabaa laga Efraaxiisii biratti,","poem":2},{"lineBreak":true},{"text":"gufatanee hin jigan.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ka akka laga Nayilii ol ka'u,","poem":1},{"text":"ka akka laga guutee irraan dhangala'uu kun eennu?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gibxi akka laga Nayilii ka ol ka'uu ti;","poem":1},{"text":"akka bisaan laga guutee irraan dhangala'uu ti.","poem":2},{"text":"Isiin, ‹Ani ka'ee lafa hin golla;","poem":1},{"text":"qachootaa fi namoota isa keessa le'anulle hin balleessa› jetti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ee abbootii fardaa, ka'a'a!","poem":1},{"text":"Worri garreettaa fardaan harkifamu oottanulle ariiti'iin oofa'a!","poem":2},{"text":"Worri Itoophiya'aatii","poem":1},{"noteId":17},{"text":"fi Fuxii ka wontee qabattaneertanu,","poem":1},{"text":"goototi Ludii ka guubee qopheeffattaneertanu,","poem":2},{"lineBreak":true},{"text":"ka'a'aatii duula'a.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Guyyaan sun ammoo guyyaa Gootta'aa,","poem":1},{"text":"Mootii Waan Maraa Ka Waan Mara Dande'uu ti;","poem":2},{"lineBreak":true},{"text":"guyyaa inni diinota ifii haluu bayu;","poem":2},{"lineBreak":true},{"text":"shallaagaan isaa haga quufutti isaan hin nyaata;","poem":2},{"lineBreak":true},{"text":"haga dheebuu bawutti dhiiga isaanii hin una.","poem":2},{"text":"Mootii Waan Maraa Ka Waan Mara Dande'uuf,","poem":1},{"text":"biyya gara kaabaa laga Efraaxiisii biratti","poem":2},{"lineBreak":true},{"text":"ciincaan hin dhikaata.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ee kolbaa Gibxi'ii ta akka intala durraa,","poem":1},{"text":"gara Giil'aadii dhaqa'aatii qorsa dibatanu barbaadadha'a;","poem":2},{"lineBreak":true},{"text":"isin akkasumaan qorsa barbaadattan malee,","poem":2},{"lineBreak":true},{"text":"hin fayyitanu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Gosi biyya adda addaa marti salphinna keessan hin dhage'an;","poem":1},{"text":"iyyi teessanille lafa hin guuti;","poem":2},{"lineBreak":true},{"text":"loltooti loltootaan gufatanee","poem":2},{"lineBreak":true},{"text":"lamaanuu woliin hin jigan» jedhe.","poem":2}]},{"type":"heading","content":["Dhufa Nebukadnezaarii"]},{"type":"verse","number":13,"content":["Mootii Baabilonii Nebukadnezaarii dhufee biyya Gibxi'ii akka lolu ergaan Mootiin Waan Maraa Ermiyaasitti dubbatte ta asii gad jirtu:"]},{"type":"verse","number":14,"content":[{"text":"«Shallaagaan worra adaala keessan jiru waan fixxuuf,","poem":1},{"text":"addee teessan qabadha'aatii qophowa'a!» jedhiitii,","poem":2},{"lineBreak":true},{"text":"ergaa tana biyya Gibxi'ii keessatti lassi;","poem":2},{"lineBreak":true},{"text":"worra qachaa Miigdolii, Nofiitii fi Taahafenee keessa jiru maralle'eef lallabi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Loltooti teessan jajjabi maaf jigane?","poem":1},{"text":"Mootiin Waan Maraa waan isaan gad darbuuf","poem":2},{"lineBreak":true},{"text":"dhaabbatuu hin dande'anu;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Isaan waan guggufatanuuf","poem":1},{"text":"wol irratti hin jijjigan;","poem":2},{"lineBreak":true},{"text":"wol woliin, «Kowa'a gara kolbaa teennaatii fi","poem":2},{"lineBreak":true},{"text":"gara lafa teennaa deebina;","poem":2},{"lineBreak":true},{"text":"shallaagaa diina keennaa jalalle'ee baqanna» hin jedhan.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Isaan achitti, «Mootii Gibxi'ii Fara'oon, nama afaan calla'aa,","poem":1},{"text":"ka carraa ifiititti hin fayyadanne» jedhanee maman.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mootiin Waan Maraa Ka Waan Mara Dade,","poem":1},{"text":"mootichi, «Ani jiraata'a; mootichi hunnaamessi","poem":2},{"lineBreak":true},{"text":"ka akka gaara Taaborii ka gaarota oddu'utti mudhatuu,","poem":2},{"lineBreak":true},{"text":"ka akka gaara Qarmelosii","poem":2},{"lineBreak":true},{"text":"ka abbaayaa qarqara jiruu fakkaatu hin dhufa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Isin worri biyya Gibxi'ii keessa leetanu","poem":1},{"text":"booji'amiisaaf meya keessan qopheeffadha'a;","poem":2},{"lineBreak":true},{"text":"qachaan Noofii diigamee, onee","poem":2},{"lineBreak":true},{"text":"ka nami keessa hin jirre hin te'a.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Gibxi akka goronsa miidhaguu ti;","poem":1},{"text":"faachi isii iddu ammoo gara kaabaatii itti hin dhufa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Loltooti biyya Gibxi'ii keessatti bitamanee odduu isaanii jiranu,","poem":1},{"text":"worri akka dardara coome,","poem":2},{"lineBreak":true},{"text":"yennaan isaan adabamanuu fi","poem":2},{"lineBreak":true},{"text":"guyyaan badii isaanii waan dhikaateef,","poem":2},{"lineBreak":true},{"text":"isaan gara duubaa deebi'anee hin baqatan;","poem":2},{"lineBreak":true},{"text":"addee dhaabbatanetti ifi irraa dhooggatiisa hin dande'anu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Diinni isaan loliisaaf akka nama muka muruu,","poem":1},{"text":"agaraa qabatee waan itti dhufuuf,","poem":2},{"lineBreak":true},{"text":"worri Gibxi'ii akka dhudhuufa'aa siissaa,","poem":2},{"lineBreak":true},{"text":"isaan duraa hin baqatan.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Isaan loltoota Gibxi'ii ta akka gongomaa cigga'aa","poem":1},{"text":"ciranee hin fixan;","poem":2},{"lineBreak":true},{"text":"Laakkossi loltoota sanii","poem":2},{"lineBreak":true},{"text":"akka awwaannisaa bacaa waan te'aneef,","poem":2},{"lineBreak":true},{"text":"nami isaan laakkowuu hin dande'u.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kolbaan biyya Gibxi'ii hin salphatti;","poem":1},{"text":"kolbaa gara kaabaatitti dabarfantee hin kennanti» jedha.","poem":2}]},{"type":"verse","number":25,"content":["Mootiin Waan Maraa Ka Waan Mara Dade Waaqi Israa'elii, «Amoonii waaqa qachaa Tebesii, biyya Gibxi'ii, moototaa fi waaqota isi'ii, worra mooticha isi'iititti addatu mara hin adaba;"]},{"type":"verse","number":26,"content":["Nebukadnezaarii mootii Baabiloniitii fi loltoota isaa worra isaan ijjeesiisaaf barbaadanutti dabarsee isaan hin kenna; te'uu malee, gara duraa ammoo biyyi Gibxi'ii akkuma durii ta nami keessa le'u hin teeti."]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"«Ee tajaajiltoota tiyya","poem":1},{"text":"sanyii Yaaqoobii hin sodaatina'a;","poem":2},{"lineBreak":true},{"text":"Ee kolbaa Israa'elii hin rifatina'a!","poem":2},{"text":"Ani biyya fago'ootii isin hin fida;","poem":1},{"text":"sanyii teessanille","poem":2},{"lineBreak":true},{"text":"lafa isaan itti booji'amanee jiranu keessaa hin baasa;","poem":2},{"lineBreak":true},{"text":"sanyiin Yaaqoobii deebitee nageyaan leeti.","poem":2},{"lineBreak":true},{"text":"Nami isaan sodaachisulle hin jiraatu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ee tajaajiltoota tiyya sanyii Yaaqoobii,","poem":1},{"text":"ani isin woliin waan jiruuf hin sodaatina'a!","poem":2},{"text":"Gosa biyya adda addaa","poem":1},{"text":"ta ani odduu isaaniititti isin bittinneesse mara hin balleessa;","poem":2},{"lineBreak":true},{"text":"isin ammoo hin balleessu.","poem":2},{"text":"Ani haqaan isin adaba malee,","poem":1},{"text":"adoo isin hin adabin hin lakkisu» jedha.","poem":2}]}],"footnotes":[{"noteId":17,"caller":"+","text":"Itoophiyaa: Afaan Ibrootaatiin Kuushi jedha","reference":{"chapter":46,"verse":9}}]},"thisChapterLink":"/api/gax_twf/JER/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JER/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JER/45.json","previousChapterAudioLinks":{},"numberOfVerses":28}