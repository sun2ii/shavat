{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JER","translationId":"gax_twf","name":"Kitaaba Ermiyaasii Raagichaa","commonName":"Kitaaba Ermiyaasii Raagichaa","title":"Kitaaba Ermiyaasii Raagichaa","order":24,"numberOfChapters":52,"sha256":"0beb0f61056c8788905272f33c1f534108297f31f6a15b4cbcef5df1c139234d","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gax_twf/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":47,"content":[{"type":"heading","content":["Ergaa Marroo Biyya Filisxeemotaa"]},{"type":"verse","number":1,"content":["Mootiin Gibxi'ii Fara'oon qachaa Gaaza'aa lolee adoo hin injifatiniin dura marroo Filisxeemotaa ergaan Mootii Waan Maraa ta gara Ermiyaasii dhutte ta asii gad jirtu:"]},{"type":"verse","number":2,"content":["Mootiin Waan Maraa, «Kunoo, karaa Kaabaatiin bisaan guutee dhufiisatti jira:",{"text":"«Lolaa jabaa hin te'a;","poem":1},{"text":"lafa sanii fi waan achi keessa jiru mara","poem":2},{"lineBreak":true},{"text":"qacha'aa fi waan qachaa keessa jiru mara hin golla.","poem":2},{"text":"Kolbaan qoonqoo ol qabattee hin iyyiti;","poem":1},{"text":"namooti lafa irra le'anu marti wiiccifatanee hin bowan.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sababa hididdeettii kottee fardo'ootii fi","poem":1},{"text":"garreettaa diinaa,","poem":2},{"lineBreak":true},{"text":"sababa kokokkeessa korbo'ootiif,","poem":2},{"lineBreak":true},{"text":"abbootiin hunna waan dadhadduuf,","poem":2},{"lineBreak":true},{"text":"ijoollee ifii qarqaariisaaf duubatti hin deebitu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Filisxeemota mara balleessiisaaf,","poem":1},{"text":"worra hafee isaan qarqaaru mara,","poem":2},{"lineBreak":true},{"text":"Xiiroosii fi Sidoon keessaa","poem":2},{"lineBreak":true},{"text":"guyyaan ani isaan balleessu dhikaateera;","poem":2},{"lineBreak":true},{"text":"worra Filisxeemotaa ka hafane,","poem":2},{"lineBreak":true},{"text":"ka dur oddoola Kaftoriitii dhufane,","poem":2},{"lineBreak":true},{"text":"ani balleessiisaaf ka'eera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kolbaan qachaa Gaaza'aa gaddanee mataa ifii hin haadatan;","poem":1},{"text":"kolbaan qachaa Ashiqalonii hin dhumatti.","poem":2},{"text":"Isin worri dhooqa keessatti baraaree hattane","poem":1},{"text":"haga yoomii gadditanee nafa ifi mummurtan?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"«Isin, ‹Ee shallaagaa Mootii Waan Maraa!","poem":1},{"text":"Ati yoom foorfatta?","poem":2},{"text":"Gonofaa keetitti deebi'iitii","poem":1},{"text":"cadhi jedhii tee'i› jedhaa hin iyyitan.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ani Mootiin Waan Maraa shallaagaa kiyya","poem":1},{"text":"qachaa Ashiqaloniitii fi","poem":2},{"lineBreak":true},{"text":"worra qarqara abbaaya'aa akka loltuuf eega ajaje,","poem":2},{"lineBreak":true},{"text":"attam foorfata ree?» jedhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}