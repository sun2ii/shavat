{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JER","translationId":"gax_twf","name":"Kitaaba Ermiyaasii Raagichaa","commonName":"Kitaaba Ermiyaasii Raagichaa","title":"Kitaaba Ermiyaasii Raagichaa","order":24,"numberOfChapters":52,"sha256":"0beb0f61056c8788905272f33c1f534108297f31f6a15b4cbcef5df1c139234d","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gax_twf/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":48,"content":[{"type":"heading","content":["Ergaa Marroo Mo'aabii"]},{"type":"verse","number":1,"content":["Mootiin Waan Maraa Ka Waan Mara Dade, Waaqi Israa'elii, Marroo Mo'aabii,",{"text":"«Qachaan Nebo'oo waan diigamuuf,","poem":1},{"text":"isaaf aanne'e!","poem":2},{"text":"Qachaan Kiriiyat-Aayimii hin salphata; hin qabamalle'e","poem":1},{"text":"kusheen jadduun isaalle hin salphatti;","poem":2},{"lineBreak":true},{"text":"hin diigantille'e.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Haganaa achi Mo'aab deebitee hin leellifantu;","poem":1},{"text":"namooti qachaa Heshiboonii keessatti","poem":2},{"lineBreak":true},{"text":"Mo'aab deebitee akka hin beekkanne,","poem":2},{"lineBreak":true},{"text":"‹Kowa'a biyya Mo'aabii balleessina› jedhaa mala itti hin dhowan;","poem":2},{"lineBreak":true},{"text":"worri qachaa Maadmeenii keessaalle hin dhumata;","poem":2},{"lineBreak":true},{"text":"shallaagaan isaan hin ari'a.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iyya Horonaayim keessaa,","poem":1},{"text":"ta diigamiisaatii fi ta badii guddo'oo caqasa'a!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mo'aab hin diiganti;","poem":1},{"text":"ijoolleen isi'iille hin iyyiti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bowaa gara Luhiitii ol hin bayan;","poem":1},{"text":"badiin waan isaan dhaqqaddeef,","poem":2},{"lineBreak":true},{"text":"wiiccifatanee bowaa qachaa Horonaayimii irraa gad hin bu'an.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Baqadha'aatii, lubbuu teessan hamburadha'a!","poem":1},{"text":"Akka kolbaa qachaa Aro'erii ta goomolee keessaa fagaadha'a!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hujii teessanii fi durummaa teessanitti waan addatanuuf,","poem":1},{"text":"isin hin booji'antan;","poem":2},{"lineBreak":true},{"text":"waaqi dharaa kemoshille hayyootaa fi","poem":2},{"lineBreak":true},{"text":"qondaaltota ifii mara woliin hin booji'ama.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mootiin Waan Maraa waan dubbateef,","poem":1},{"text":"ka qachaa balleessu","poem":2},{"lineBreak":true},{"text":"qachaa tokko tokkooyyuu loliisaaf hin dhufa;","poem":2},{"lineBreak":true},{"text":"qachaan tokkolle miliqee jalaa hin bayu;","poem":2},{"lineBreak":true},{"text":"dhooqii fi latti gooroo irraa hin badan.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mo'aab duwwaa waan teetuuf,","poem":1},{"text":"soodda itti facaasa'a;","poem":2},{"lineBreak":true},{"text":"qachaan isi'ii onee ka nami keessa hin jirre hin te'a» jedha.","poem":2}]},{"type":"verse","number":10,"content":["Nami hujii Mootii Waan Maraa hujiisaaf rincicu ka abaarame te'uu ti;",{"text":"Mootiin Waan Maraa ajajeeruun,","poem":1},{"text":"nami shallaagaa ifii","poem":2},{"lineBreak":true},{"text":"akka dhiiga hin dhangalaanne dhooggatu,","poem":2},{"lineBreak":true},{"text":"ka abaarame te'uu ti.","poem":2}]},{"type":"heading","content":["Qachaan Mo'aabii Bade"]},{"type":"verse","number":11,"content":[{"text":"Mootiin Waan Maraa,","poem":1},{"text":"«Mo'aab ijoollumma'aa jalqaddee","poem":2},{"lineBreak":true},{"text":"rakkoo hin beettu;","poem":2},{"lineBreak":true},{"text":"isiin akka daadhii woyni'ii ta qararantee,","poem":2},{"lineBreak":true},{"text":"okkotee taan irraa gara okkotee dhibi'ii","poem":2},{"lineBreak":true},{"text":"adoo hin naqamin turtee,","poem":2},{"lineBreak":true},{"text":"ta mi'aan isi'ii akkuma qaraa jiruutii fi","poem":2},{"lineBreak":true},{"text":"ta uddaan isi'ii hin jijjiiraminii ti;","poem":2},{"lineBreak":true},{"text":"kolbaan isi'ii booji'antee hin beettu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tanaaf guyyaan ani namoota akka okkote'ee","poem":1},{"text":"Mo'aab dhudhulchanu ergu hin dhufa;","poem":2},{"lineBreak":true},{"text":"isaan Mo'aab akka okkote'ee dhuldhuchanee","poem":2},{"lineBreak":true},{"text":"duwwaa hamburanee hin caccassan.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Akkuma Israa'elooti,","poem":1},{"text":"yennaa waaqa dharaa Bet'elitti addatane salphatane,","poem":2},{"lineBreak":true},{"text":"Mo'aabotille waaqa ifii ka dharaa Kemoshiin hin salphatan.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Isin kolbaan Mo'aabii,","poem":1},{"text":"attam, ‹Nuuti loltoota hunnaameyyi'i;","poem":2},{"lineBreak":true},{"text":"nuuti loltoota janna› ifiin jettan?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ani mootichi,","poem":1},{"text":"Mootiin Waan Maraa Ka Waan Mara Dade,","poem":2},{"lineBreak":true},{"text":"‹Mo'aab hin baddi;","poem":2},{"lineBreak":true},{"text":"qachaan isi'iille hin qabatama;","poem":2},{"lineBreak":true},{"text":"dargaggooti isi'ii ta dhiiraa","poem":2},{"lineBreak":true},{"text":"worri mimmidhaagaan hin ijjeefaman› jedhee dubbadheera.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Jinnanni Mo'aabii dhikaateera;","poem":1},{"text":"badiin isi'iille ariiti'iin hin dhutti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«Worri adaala isi'ii jirtanu marti,","poem":1},{"text":"worri gurra isi'ii beettanu marti,","poem":2},{"text":"‹Uleen isi'ii ta bokku'uu hunnaamettiin,","poem":1},{"text":"uleen isi'ii ta ulfinnaa attamiin cadde?› jedha'aatii isi'iif bowa'a.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mo'aab ka balleessu","poem":1},{"text":"isin loliisaaf dhufee,","poem":2},{"lineBreak":true},{"text":"qachoota keessan ka dalleya dhaka'aa qabu waan diiguuf,","poem":2},{"lineBreak":true},{"text":"isin worri qachaa Diibonii keessa leetanu,","poem":2},{"lineBreak":true},{"text":"addee teessan ta ulfinnaa san irraa gad bu'a'aatii","poem":2},{"lineBreak":true},{"text":"lafa godduu irra tee'a'a!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Isin worri qachaa Aro'er keessa leetanu,","poem":1},{"text":"karaa irra dhaabbadha'aatii eega'a;","poem":2},{"lineBreak":true},{"text":"nama baqatuu fi dubartii milixxu,","poem":2},{"lineBreak":true},{"text":"‹Maanti maan te'e?› jedha'aatii gaafadha'a.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Isaanille, ‹Mo'aab waan diiganteef salphatteerti.","poem":1},{"text":"Isi'iif wiiccifadha'aatii bowa'a!","poem":2},{"text":"Akka isiin baddelle laga Aarnonii biratti lallaba'a› hin jedhan.","poem":1}]},{"type":"verse","number":21,"content":["«Qachoota gooroo irraa keessaa Holoon, Yaahaz, Mefaat irratti,"]},{"type":"verse","number":22,"content":["Diibon, Neboonii fi Bet-Diiblaataayim irratti,"]},{"type":"verse","number":23,"content":["Kiriiyat-Aayim, Bet-Gaamul, Bet-Me'on irratti,"]},{"type":"verse","number":24,"content":["Keriyotii fi Bozraa irratti, qachoota Mo'aabii ka dhiko'oo fi fagoo jiranu mara irratti muraan dhutteerti."]},{"type":"verse","number":25,"content":["Gaafi Mo'aabii cabeera; irreen isi'iille caddeerti» jedha."]},{"type":"heading","content":["Salphinna Mo'aabii"]},{"type":"verse","number":26,"content":["Mootiin Waan Maraa, «Mo'aab na caalaa waan ifi gudditteef, akka machoottu, diddiga ifii irralle'etti jiddee akka itti kollanu hin godha."]},{"type":"verse","number":27,"content":["Ee Mo'aab! Kolbaan Israa'elii tun hanna irratti qabanteertii?",{"text":"Ati yennaa waan isaanii dubbattu maaf mataa raasaa itti murgita ree?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ee isin worri Mo'aab keessa leetanu,","poem":1},{"text":"qachoota keessaa baya'aatii rassaa keessa le'a'a;","poem":2},{"lineBreak":true},{"text":"akka saphaliisa goda qarqaratti mana ijaaratuu te'a'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"«Nuuti koora Mo'aabii,","poem":1},{"text":"guddoo bondhooriisa isi'iitii fi ifi saadiisa isi'ii,","poem":2},{"lineBreak":true},{"text":"kooraa fi hunnaan nama irratti ka'iisa isi'ii,","poem":2},{"lineBreak":true},{"text":"tuffii isi'iille dhageenneerra.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ani Mootiin Waan Maraa koorri isi'ii soba akka te'e hin beeka;","poem":1},{"text":"ifi jajiis isi'ii kun womaa hin bayu.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Tanaaf, ani Mo'aabiif hin wiiccifadha;","poem":1},{"text":"nama Mo'aab keessa jiru maraaf hin bowa;","poem":2},{"lineBreak":true},{"text":"worra Qiir-Heresiitiifille hin gadda.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ee muka woynii qachaa Siibmaa,","poem":1},{"text":"qachaa Yaazeriitiif haga bowu caalaa si'iif hin bowa;","poem":2},{"lineBreak":true},{"text":"dameeleen teeti haga qarqara abbaaya'aa,","poem":2},{"lineBreak":true},{"text":"haga abbaayaa Yaazerii banqaaqaneeran.","poem":2},{"lineBreak":true},{"text":"Ka balleessu dhufee,","poem":2},{"lineBreak":true},{"text":"midhaan dura bilchaatee fi","poem":2},{"lineBreak":true},{"text":"unkuruura woyni'ii hin balleessa.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Fichaa Mo'aabii ka midhaan dansaa kennu keessaa,","poem":1},{"text":"gammadaa fi ililleettiin dhabanteerti;","poem":2},{"lineBreak":true},{"text":"ani daadhii woyni'ii addee itti cunfanu keessaa balleesseera;","poem":2},{"lineBreak":true},{"text":"nami gelele'een cunfu hin jiru;","poem":2},{"lineBreak":true},{"text":"hogaan jiraatulle,","poem":2},{"lineBreak":true},{"text":"hogaa gammadaatii moti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"«Qoonqoon iyya isaanii","poem":1},{"text":"Heshiboon keessaa haga El'aaleetii fi","poem":2},{"lineBreak":true},{"text":"haga Yaahaziititti,","poem":2},{"lineBreak":true},{"text":"Zo'aari keessaa haga Horonaayimiitii fi","poem":2},{"lineBreak":true},{"text":"haga Eglaat Shelshiiya'aatitti hin dhage'anti;","poem":2},{"lineBreak":true},{"text":"bisaan Niimriimiituu hin goga.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ani worra addee waaqonfanna'aa irratti,","poem":1},{"text":"kennansa dhikeessu fi","poem":2},{"lineBreak":true},{"text":"worra waaqota dharaa ifiitiif hixaana aarsu,","poem":2},{"lineBreak":true},{"text":"Mo'aab keessaa hin balleessa.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Qabeenni Mo'aabiitii fi","poem":1},{"text":"kolbaa Qir-Heresii waan badeef,","poem":2},{"lineBreak":true},{"text":"akka worra suusullee gaddaa afuufaa gadduu,","poem":2},{"lineBreak":true},{"text":"gadhaan kiyya isaaniif hin gadda.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Marti isaanii mataa haadatanee,","poem":1},{"text":"areeda ifiille quxataneeran;","poem":2},{"lineBreak":true},{"text":"harka ifii mummuratanee,","poem":2},{"lineBreak":true},{"text":"woyaa gaddaa uffataneeran.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Akka okkotee nami hin barbaannee,","poem":1},{"text":"ani Mo'aab waan casseef,","poem":2},{"lineBreak":true},{"text":"heellichoo mana Mo'aabii mara irraa fi","poem":2},{"lineBreak":true},{"text":"woldeennaa kara'aa mara irratti,","poem":2},{"lineBreak":true},{"text":"bowa malee wonni dhage'amu hin jiru.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Mo'aab attam attam bututte!","poem":1},{"text":"Kolbaan isi'ii attam attam wiiccifatte!","poem":2},{"lineBreak":true},{"text":"Isiin attam attam salphattee duubatti deebite!","poem":2},{"text":"Mo'aab ta nami itti kollu,","poem":1},{"text":"worra adaala isi'ii jiru maratti,","poem":2},{"lineBreak":true},{"text":"waan hantuu nami dhaggee bararaqu teeteerti» jedha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Ammalle Mootiin Waan Maraa,","poem":1},{"text":"«Kunoo, akka risaa koola ifii badhisee xinniquu,","poem":2},{"lineBreak":true},{"text":"diinni Mo'aab irratti hin dhufa.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Qachooti isi'ii hin qabaman;","poem":1},{"text":"kusheen isi'ii jadduun hin fudhataman;","poem":2},{"lineBreak":true},{"text":"guyyaa san loltooti Mo'aabii,","poem":2},{"lineBreak":true},{"text":"sodaatanee akka dubartii ciniinsifattuu hin te'an.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Mo'aab ana Mootiin Waan Maraa irratti waan ifi saaddeef,","poem":1},{"text":"mootummaan isi'ii hin baddi.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Ee kolbaa Mo'aabii,","poem":1},{"text":"bararaqi, boollii fi tiyyoon isin dura jirti.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Bara ani isaan adabu worri bararaqee baqatu","poem":1},{"text":"boolla keessa hin bu'a;","poem":2},{"lineBreak":true},{"text":"worri boolla keessaa utaalee bawu,","poem":2},{"lineBreak":true},{"text":"tiyyo'oon hin qabama.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Qachaa Heshiboonii keessaa ibiddi,","poem":1},{"text":"mana Sihoonii mootichaa keessalle'ee bobe'i ibiddaa bayee,","poem":2},{"lineBreak":true},{"text":"adda Mo'aabii,","poem":2},{"lineBreak":true},{"text":"buqqii mataa worra hogisee kooruu,","poem":2},{"lineBreak":true},{"text":"gubee hin balleessa.","poem":2},{"text":"Worri baqatee gara Heshoobii dhufe,","poem":1},{"text":"dadhabee gaaddisa isi'ii jala hin dhaabata.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Ee Mo'aab si'iif aanne'e!","poem":1},{"text":"Kolbaan Kemoshii baddeerti;","poem":2},{"lineBreak":true},{"text":"ilmaan teessan qabamaneeran;","poem":2},{"lineBreak":true},{"text":"ijoolleen duraa teessanille","poem":2},{"lineBreak":true},{"text":"booji'amaneeran.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"«Te'uu malee barri ani worra Mo'aab keessaa booji'ame","poem":1},{"text":"adde'etti deebisu hin dhufa;","poem":2},{"lineBreak":true},{"text":"muraan Mo'aab irratti murante as irratti dhumatti» jedha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}