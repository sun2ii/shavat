{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JER","translationId":"gax_twf","name":"Kitaaba Ermiyaasii Raagichaa","commonName":"Kitaaba Ermiyaasii Raagichaa","title":"Kitaaba Ermiyaasii Raagichaa","order":24,"numberOfChapters":52,"sha256":"0beb0f61056c8788905272f33c1f534108297f31f6a15b4cbcef5df1c139234d","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gax_twf/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":50,"content":[{"type":"heading","content":["Ergaa Marroo Baabilonii"]},{"type":"verse","number":1,"content":["Jechi Mootiin Waan Maraa marroo Baabiloniitii fi marroo kolbaa Baabilonii karaa Ermiyaasii raagichaatiin dubbatte ka asii gad jiru:"]},{"type":"verse","number":2,"content":[{"text":"«Gosa biyya adda addaa oddu'utti lassiitii lallabi!","poem":1},{"text":"Beessisa ol kaasiitii oduu tana lallabi!","poem":2},{"lineBreak":true},{"text":"Waan tokkolle himiisaa adoo hin lakkisin,","poem":2},{"lineBreak":true},{"text":"‹Baabilon hin qabanti;","poem":2},{"lineBreak":true},{"text":"waaqi isi'ii ka dharaa Beel hin qaanowa;","poem":2},{"lineBreak":true},{"text":"waaqi isi'ii ka dharaa Maardukille hin bararaqa;","poem":2},{"lineBreak":true},{"text":"fakkiin waaqota isi'ii ka dharaa hin qaanowan;","poem":2},{"lineBreak":true},{"text":"waaqoti dharaa ka isi'ii hin bararaqan› jedhii himi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«Gosi biyya gara kaabaa takka dhuttee,","poem":1},{"text":"Baabilon loltee lafa isi'ii hin onsiti.","poem":2},{"text":"Nami tokkolle achi keessa hin le'u;","poem":1},{"text":"namii fi horiin achi keessaa hin baqatan.","poem":2}]},{"type":"heading","content":["Deebi'iisa Israa'elii"]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Bara san keessa, yennaa san,","poem":1},{"text":"kolbaan Israa'eliitii fi kolbaan Yihuda'aa","poem":2},{"lineBreak":true},{"text":"wolitti qabamanee bowaa","poem":2},{"lineBreak":true},{"text":"ana Mootii Waan Maraa Waaqa ifii","poem":2},{"lineBreak":true},{"text":"barbaadatiisaaf hin dhufan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isaan fuula ifii gara Xiyoonii deebifatanee","poem":1},{"text":"karaa gara isi'ii geessu gaafataa,","poem":2},{"lineBreak":true},{"text":"dhufanee gondooroo bara baraa ta hin dedhanne","poem":2},{"text":"ana Mootii Waan Maraa woliin hin godhatan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Kolbaan tiyya akka hoolee baddee","poem":1},{"text":"ta tissitooti karaa irraa isaan gorsitee,","poem":2},{"lineBreak":true},{"text":"gaara irra asii fi achi olokamane","poem":2},{"noteId":18},{"text":"te'aneeran.","poem":2},{"text":"Gaaraa fi kooba irra asii fi achi raafamanee","poem":1},{"text":"addee ifii ta itti foorfatanu dedhaneeran.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Worri isaan dhaggu marti isaan laxaphi godhan;","poem":1},{"text":"diinoti isaanii, ‹Nuuti womaa isaan hin yakkine.","poem":2},{"text":"Isaan Mootii Waan Maraa","poem":1},{"text":"ka abbootiin isaanii ta durii addii godhatte duratti","poem":2},{"lineBreak":true},{"text":"cubbuu waan hujaneef,","poem":2},{"lineBreak":true},{"text":"tun marti isaan irratti teete› jedhane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Biyya Baabilonii keessaa baqadha'a!","poem":1},{"text":"Lafa Baabilonii keessalle'ee baya'aatii,","poem":2},{"lineBreak":true},{"text":"akka korbeessa re'e'ee ka re'ee sooressuu te'a'a!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ani kunoo loltoota gosa biyya adda addaa guddoo","poem":1},{"text":"gara kaabaatii Baabilon irratti hin kaasa.","poem":2},{"text":"Isaan isii lolanee hin qabatan;","poem":1},{"text":"daayi isaanii akka daaya worra lolaan beekkamee","poem":2},{"lineBreak":true},{"text":"ka waan itti qabane irraa hin gorsinee ti.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Maarre Baabilon hin saamanti;","poem":1},{"text":"worri isii saamu marti hin durooma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Ee kolbaa Baabilonii! Kolbaa tiyya waan saantaneef,","poem":1},{"text":"gammaddanee ilillittaneertaniiyyu;","poem":2},{"lineBreak":true},{"text":"akka waatolee diida keessa burraaxuu teetanee,","poem":2},{"lineBreak":true},{"text":"akka farda wodalee himimmitaneertaniiyyu;","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"amma ammoo qachaan keessan guddaan hin qaanowa;","poem":2},{"lineBreak":true},{"text":"latti teessan ta akka haadhaa isiniif teete hin salphatti;","poem":2},{"lineBreak":true},{"text":"gammoojjii, lafa godduu, goomolee","poem":2},{"lineBreak":true},{"text":"ta gosa biyya adda addaa keessaa gad aante hin teeti.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sababa aarii Mootii Waan Maraatiif ona teetee hin hatti;","poem":1},{"text":"nami tokkolle isii keessa hin jiraatu.","poem":2},{"text":"Nami karaa Baabilonii dabaru marti hin rifata;","poem":1},{"text":"xixanis waan isii irra dhaqqabeef itti hin kolla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Isin worri guube'een loltanu marti, Baabilon loliisaaf marsa'a;","poem":1},{"text":"isiin Mootii Waan Maraa duratti cubbuu waan hujjeef,","poem":2},{"lineBreak":true},{"text":"daaya keessan adoo hin qusatin isi'itti darbadha'a.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Karaa maraan isii loliisaaf iyya'a;","poem":1},{"text":"isiin harka hin kennatti.","poem":2},{"text":"Xelleephoon isi'ii hin jiddi;","poem":1},{"text":"dalleenni isi'iille diigameera.","poem":2},{"text":"Mootiin Waan Maraa waan haluu isii bayuuf,","poem":1},{"text":"akkuma isiin worra dhibii irratti hujje,","poem":2},{"lineBreak":true},{"text":"akkasuma isii irratti huja'aatii haluu baya'a.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nama sanyii facaasuu fi nama midhaan haamu","poem":1},{"text":"Baabilon keessaa balleessa'a.","poem":2},{"text":"Sababa worra shallaaga'aan nama cunqursuutiif,","poem":1},{"text":"nami marti gara kolbaa ifii deebi'uu ti;","poem":2},{"lineBreak":true},{"text":"gara lafa ifiille baqatuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«Kolbaan Israa'elii","poem":1},{"text":"akka hoolee neenqi ari'ee bittinneessu teeteerti.","poem":2},{"text":"Dursee mootiin Asoorii isaan kukkute;","poem":1},{"text":"achiin duuba mootiin Baabilonii Nebukadnezaar","poem":2},{"lineBreak":true},{"text":"lafee isaanii caccasse.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tanaaf Mootiin Waan Maraa Ka Waan Mara Dade,","poem":1},{"text":"Waaqi Israa'elii, ‹Kunoo ani akkuma mootii Asoorii adabe,","poem":2},{"lineBreak":true},{"text":"mootii Baabiloniitii fi lafa isaalle hin adaba.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Israa'eloota ammoo","poem":1},{"text":"lafa isaanii duriititti hin deebisa;","poem":2},{"lineBreak":true},{"text":"Qarmelosii fi Baashaan irraa midhaan hin nyaatan;","poem":2},{"lineBreak":true},{"text":"kooba Efreemiitii fi Giil'aadii irraa","poem":2},{"lineBreak":true},{"text":"midhaan galfatanee hin quufan› jedha.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bara san guyyaa sanitti,","poem":1},{"text":"worra baraaree akka hafanu godhe saniif","poem":2},{"lineBreak":true},{"text":"ani waan araaramuuf,","poem":2},{"lineBreak":true},{"text":"Israa'el irra yakkaa hin barbaadan;","poem":2},{"lineBreak":true},{"text":"ammoo womaa irratti hin dhagganu;","poem":2},{"text":"Yihudaa irra cubbuu hin barbaadan;","poem":1},{"text":"ammoo womaa irratti hin dhagganu» ka jedhu.","poem":2}]},{"type":"heading","content":["Muraa Waaqaa Ta Baabilon Irratti Murante"]},{"type":"verse","number":21,"content":["Mootiin Waan Maraa, «Lafa worra Meraataayimiitiitii fi",{"text":"worra Pheqod keessa le'u lola'a;","poem":2},{"lineBreak":true},{"text":"isaan ari'a'aatii, ijjeesa'aa, ijjumaa balleessa'a;","poem":2},{"lineBreak":true},{"text":"waan ani isin ajaju maraa godha'a.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Lafa irratti qeexalli lolaa,","poem":1},{"text":"badiin guddoolle dhage'anteerti.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Baabilon ta duri akka burrisaa nama butuchaa turte,","poem":1},{"text":"attam attam caccaddee bututte!","poem":2},{"lineBreak":true},{"text":"Gosa biyya adda addaa oddu'utti attam attam onte!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ee Baabilon,","poem":1},{"text":"ani tiyyoo si dura keyeera.","poem":2},{"lineBreak":true},{"text":"Atille adoo hin beekin qabatanteerta;","poem":2},{"lineBreak":true},{"text":"ati ana Mootii Waan Maraa irratti waan kaateef,","poem":2},{"lineBreak":true},{"text":"dhaggantee qabatanteerta.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ani Goottaan Mootiin Waan Maraa Ka Waan Mara Dande'u,","poem":1},{"text":"worra Baabilonotaa irratti waan huju waan qabuuf,","poem":2},{"lineBreak":true},{"text":"mana meya woraanaa banee,","poem":2},{"lineBreak":true},{"text":"meya woraanaa ta mufii tiyyaa gad baaseera.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Biyya fagoo irraa kowa'aatii isi'itti duula'a.","poem":1},{"text":"Gootaraa isi'ii diiga'a;","poem":2},{"lineBreak":true},{"text":"akka midhaanii isii tuula'a.","poem":2},{"text":"Baraareen adoo hin hafin,","poem":1},{"text":"ijjumaa isii balleessa'a.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Akka dardaroota qalanu,","poem":1},{"text":"loltoota isi'ii mara qala'a.","poem":2},{"text":"Guyyaan isaan adabamanu waan dhikaateef,","poem":1},{"text":"isaaniif aanne'e!» jedha.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Mootii Waan Maraa Waaqi keenna attam attam akka haluu baye,","poem":1},{"text":"marroo Galma ifiitiif attam attam akka haluu inni baye,","poem":2},{"lineBreak":true},{"text":"worri ari'amee lafa Baabilonii keessaa baqatee baye,","poem":2},{"lineBreak":true},{"text":"Xiyoon keessatti waan isinitti himanu dhage'a'a.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Mootiin Waan Maraa, «Worra guube'een lolu mara","poem":1},{"text":"akka Baabilon lolanu waama'a!","poem":2},{"text":"Nami tokkolle miliqee akka hin baane","poem":1},{"text":"adaala isi'ii marsa'a.","poem":2},{"text":"Isiin ana Mootii Waan Maraa,","poem":1},{"text":"Woyyicha Israa'elii irratti waan koorteef,","poem":2},{"lineBreak":true},{"text":"akkuma hujii isi'iititti gatii isi'iif kenna'a;","poem":2},{"lineBreak":true},{"text":"akkuma isiin worra dhibii irratti hujje","poem":2},{"lineBreak":true},{"text":"isii irralle'etti huja'a.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Tanaaf dargaggooti isi'ii karaa irratti hin ijjeefaman;","poem":1},{"text":"guyyaa san loltooti isi'ii marti hin dhumatan» jedha.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Goottaan, Mootiin Waan Maraa","poem":1},{"text":"Ka Waan Mara Dande'u, «Ee Baabilonii koortu,","poem":2},{"lineBreak":true},{"text":"ani si irratti hin ka'a!","poem":2},{"lineBreak":true},{"text":"Guyyaan ati adabantu dhikaateera.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ati koorameettiin gufattee hin jidda;","poem":1},{"text":"nami ol kaasulle hin jiru;","poem":2},{"lineBreak":true},{"text":"ani qachaa keeti keessatti ibidda qassiisee,","poem":2},{"lineBreak":true},{"text":"ibiddi sun waan adaala isaa jiru mara hin guba» jedha.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Mootiin Waan Maraa ka Waan Mara Dade,","poem":1},{"text":"«Kolbaan Israa'eliitii fi kolbaan Yihuda'aa cunqurfanteerti.","poem":2},{"text":"Worri isaan booji'e jabeessee isaan qabee,","poem":1},{"text":"gad isaan lakkisuu dideera.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ka isaan wodu ammoo jaba'a;","poem":1},{"text":"maqaan isaa Mootii Waan Maraa Ka Waan Mara Dande'u.","poem":2},{"text":"Inni lafa isaaniitiif foora kenniisaaf,","poem":1},{"text":"jabeessee isaaniif hin falmata.","poem":2},{"text":"Worri Baabilon keessa le'u ammoo","poem":1},{"text":"foora hin dhaggatu» jedha.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Mootiin Waan Maraa,","poem":1},{"text":"«Worra Baabiloniitii fi worra isii keessa le'u irratti,","poem":2},{"lineBreak":true},{"text":"bulchitootaa fi qaroolee isi'ii mara irratti lolli ka'uu ti.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Raagota isaanii ta dharaa irratti lolli ka'uu ti;","poem":1},{"text":"isaanille gowwoolee hin te'an.","poem":2},{"text":"Loltoota isaanii irratti lolli ka'uu ti;","poem":1},{"text":"isaanille hin bararaqan.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Fardaa fi garreettaa fardaan harkifamu ka isaanii irratti,","poem":1},{"text":"loltoota biyya ormaa","poem":2},{"lineBreak":true},{"text":"ta odduu isaanii jiru mara irratti lolli ka'uu ti;","poem":2},{"lineBreak":true},{"text":"isaanille akka dubarti'ii hin te'an.","poem":2},{"text":"Qabeenna isaanii mara irratti lolli ka'uu ti;","poem":1},{"text":"isaanille hin saamaman.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Latti Baabilonii waaqota dharaatiin waan guutanteef,","poem":1},{"text":"kolbaan waaqota nama bararassu waan leellifattuuf,","poem":2},{"text":"Bisaan isi'ii irratti oolaan hin dhufa;","poem":1},{"text":"bisaan isi'iille hin goga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"«Tanaaf bineensoti goomole'eetii fi","poem":1},{"text":"woraabessi achi hin le'an;","poem":2},{"lineBreak":true},{"text":"guchiille achi keessa hin bulti.","poem":2},{"text":"Haganaa achi nami tokkolle isii keessa hin le'u;","poem":1},{"text":"dhalootaa haga dhalootaatitti","poem":2},{"lineBreak":true},{"text":"nami tokkolle achii keessa hin le'u.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Sodoomii fi Gomoraa","poem":1},{"text":"qachoota adaala isaanii jiranu mara woliin","poem":2},{"lineBreak":true},{"text":"ani Mootiin Waan Maraa akkuma diigee balleesse,","poem":2},{"lineBreak":true},{"text":"isiille diigee hin balleessa.","poem":2},{"text":"Nami tokkolle achi keessa hin le'u;","poem":1},{"text":"nami tokkolle achi keessa hin jiraatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"«Kunoo, loltooti gara kaabaatii dhufiisatti jiran;","poem":1},{"text":"kolbaan biyya takkaa hunnaametti'ii fi moototi hedduun,","poem":2},{"lineBreak":true},{"text":"qaccee lafaa irraa ka'anee dhufiisatti jiran.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Isaan guube'ee fi woraana qabataneeran;","poem":1},{"text":"isaan worra gadhi jabeeyyi'i;","poem":2},{"lineBreak":true},{"text":"marartiille hin qabanu.","poem":2},{"text":"Ee Baabilon, isaan si loliisaaf","poem":1},{"text":"fardo'oon gulufaa yennaa dhufanu,","poem":2},{"lineBreak":true},{"text":"hididdeettiin akka abbaayaa bulphittuu ti.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Mootiin Baabilonii oduu isaanii dhage'ee,","poem":1},{"text":"harki irraa bu'e;","poem":2},{"lineBreak":true},{"text":"naasu'uun qabamee akka dubartii ciniinsifattuu te'e.","poem":2}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"«Akkuma neenqi gongomaa ciggaa Yordaanosii keessaa,","poem":1},{"text":"gara lafa marra bisile'ee dhufu,","poem":2},{"lineBreak":true},{"text":"anille dedhuma gara worra Baabilonii dhufee,","poem":2},{"lineBreak":true},{"text":"lafa isaanii keessaa isaan hin ari'a;","poem":2},{"lineBreak":true},{"text":"nama ifii filadhe isii irratti hin mootonsa.","poem":2},{"text":"Nami akka kiyyaa eennu ree?","poem":1},{"text":"Nami ‹Maaf tana goote?› jedhee","poem":2},{"lineBreak":true},{"text":"na gaafatu eennu ree?","poem":2},{"lineBreak":true},{"text":"Tisseen na dura dhaabbatee na dhooggu eennu ree?","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Tanaaf, waan ani Mootiin Waan Maraa","poem":1},{"text":"Baabilon irratti fidiisaaf yaadeeru,","poem":2},{"lineBreak":true},{"text":"yaada ani lafa worra Baabilonii loliisaaf qopheeffadheeru dhage'a'a!","poem":2},{"text":"Ijoolleen isaanii akka ilmoolee hoole'ee","poem":1},{"text":"harkifamanee hin fudhataman;","poem":2},{"lineBreak":true},{"text":"sababa isaaniitiif kaloon isaanii hin baddi.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Iyya qabamiisa Baabiloniitiin,","poem":1},{"text":"latti hin tachooti;","poem":2},{"lineBreak":true},{"text":"iyyi isi'iille gosa biyya adda addaa oddu'utti","poem":2},{"lineBreak":true},{"text":"hin dhage'ama» jedha.","poem":2}]}],"footnotes":[{"noteId":18,"caller":"+","text":"Olokamane: Yookiin joonjane","reference":{"chapter":50,"verse":6}}]},"thisChapterLink":"/api/gax_twf/JER/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JER/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JER/49.json","previousChapterAudioLinks":{},"numberOfVerses":46}