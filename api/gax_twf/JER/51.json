rue},{"text":"loltoota isi'ii mara fixa'a.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isaan lafa Baabilonii keessatti madowanee","poem":1},{"text":"karaa keessatti hin du'an.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Latti isaanii ana Woyyicha Israa'elii duratti","poem":1},{"text":"yakka'aan ta guutante teetulle,","poem":2},{"lineBreak":true},{"text":"ani Mootiin Waan Maraa Ka Waan Mara Dade Waaqi isaanii,","poem":2},{"lineBreak":true},{"text":"Israa'elii fi Yihudaa hin lakkinne.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Baabilon keessaa baqadha'aatii,","poem":1},{"text":"lubbuu teessan hamburadha'a!","poem":2},{"lineBreak":true},{"text":"Sababa yakkaa isi'iitiif hin badina'a.","poem":2},{"text":"Yennaan ani Mootiin Waan Maraa","poem":1},{"text":"sababa yakkaa isi'iitiif haluu bayu waan geetteef,","poem":2},{"lineBreak":true},{"text":"ani akka hujii isi'iititti gatii isi'iif hin kenna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Baabilon harka Mootii Waan Maraa keessatti","poem":1},{"text":"akka muduunuu worqii irraa hujantee ti;","poem":2},{"lineBreak":true},{"text":"isiin lafa duudii macheessiteerti;","poem":2},{"lineBreak":true},{"text":"gosi biyya adda addaa","poem":2},{"lineBreak":true},{"text":"daadhii isi'ii ta woyni'ii unanee,","poem":2},{"lineBreak":true},{"text":"maraataneeran.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Baabilon dedhuma jiddee hin caccaddi;","poem":2},{"lineBreak":true},{"text":"isi'iif wiiccifadha'aa bowa'a!","poem":2},{"lineBreak":true},{"text":"Dedha hin fayyiti fa'a te'a,","poem":2},{"lineBreak":true},{"text":"madaa isi'iitiif qorsa dibattu barbaada'a!» jedha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Worri ormaa ka achi keessa le'u,","poem":1},{"text":"«Nuuti Baabilon fayyisiisaaf wodhaanneerraayyu;","poem":2},{"lineBreak":true},{"text":"isiin ammoo fayyuu hin dandeenne;","poem":2},{"lineBreak":true},{"text":"muraan isii irratti murante","poem":2},{"lineBreak":true},{"text":"akka duumensaa ol kaatee,","poem":2},{"lineBreak":true},{"text":"gubbaa waan dhaqqaddeef,","poem":2},{"lineBreak":true},{"text":"isii lakkinnee,","poem":2},{"lineBreak":true},{"text":"tokko tokkoon keenna gara biyya teennaa deenna» hin jedhan.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yennaa san kolbaan Israa'eliitii fi kolbaan Yihuda'aa,","poem":1},{"text":"«Mootiin Waan Maraa dhugaa waan nu'uuf baaseef,","poem":2},{"lineBreak":true},{"text":"kowa'a, waan Waaqi keenna Mootiin Waan Maraa huje","poem":2},{"lineBreak":true},{"text":"Xiyoon keessatti lallannaa ti» hin jedhan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Daaya qaradha'aatii,","poem":1},{"text":"Wontee fudhadha'a!","poem":2},{"text":"Yaadi Mootii Waan Maraa","poem":1},{"text":"Baabilon balleessiisa waan te'eef,","poem":2},{"lineBreak":true},{"text":"mootota Medoonii itti kakkaaseera.","poem":2},{"text":"Mootiin Waan Maraa haluu hin baya;","poem":1},{"text":"Galma ifiitiif haluu hin baya.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dalleya Baabilonii diigiisaaf,","poem":1},{"text":"beessisa keessan ol kaasa'a!","poem":2},{"text":"Worra eegu itti jabeessa'a;","poem":1},{"text":"eeddota itti ramada'a!","poem":2},{"text":"Worra gaadu qopheessa'a!","poem":1},{"text":"Mootiin Waan Maraa","poem":2},{"lineBreak":true},{"text":"waan kolbaa Baabilonii irratti karoorfate,","poem":2},{"lineBreak":true},{"text":"hin muummessa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ati ta bisaan hedduu bira leetu,","poem":1},{"text":"ta qabeennaan duroonteertu,","poem":2},{"lineBreak":true},{"text":"muummeen teeti dhikaatteerti,","poem":2},{"lineBreak":true},{"text":"haganaa achi bu'aa haqa hin te'in hin dhaggattu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mootiin Waan Maraa ka Waan Mara Dade,","poem":1},{"text":"ifiin kakatee,","poem":2},{"lineBreak":true},{"text":"«Ani dhugumaan namoota akka tuuta","poem":2},{"noteId":19},{"text":"awwaannisaa","poem":2},{"lineBreak":true},{"text":"si keessatti hin guuta;","poem":2},{"lineBreak":true},{"text":"isaanille si injifatanee hin qeexalan» jedha.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Faaruu Galataa Ta Waaqaaf Dhikaattu"]},{"type":"verse","number":15,"content":[{"text":"Inni hunnaa ifiitiin lafa dade;","poem":1},{"text":"qarummaa ifiitiin biyya lafaa hundeesse;","poem":2},{"lineBreak":true},{"text":"hubantii ifiitiin ol-gubbaa diriirse.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yennaa inni qoonqoo ifii ta akka mandiisu'uu dhageessisu,","poem":1},{"text":"bokkeenni ol-gubbaa keessaa hin shookkisa;","poem":2},{"lineBreak":true},{"text":"inni duumensi qaccee lafaa irraa akka ol ka'u hin godha.","poem":2},{"text":"Bokkeya keessa mandiisuu hin buusa;","poem":1},{"text":"qilleensalle mana kuusa'aa ka ifii keessaa hin baasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Nami martinuu daalle'ee fi worra beekkumsa hin qanne;","poem":1},{"text":"nami worqii baqisiisu marti","poem":2},{"lineBreak":true},{"text":"waaqota dharaa ka ifii huje saniin fokkifateera.","poem":2},{"text":"Fakkiin inni huje ta dharaa ti;","poem":1},{"text":"hafuurri keessa hin jiru.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Isaan waan bu'aa hin qanne,","poem":1},{"text":"meya murgo'oo ti;","poem":2},{"lineBreak":true},{"text":"yennaa muraan itti dhuttu hin badan.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Waaqi Yaaqoobii ammoo akka waaqota dharaa kanaatii moti;","poem":1},{"text":"waan mara ka dade isa;","poem":2},{"lineBreak":true},{"text":"inni kolbaa Israa'elii gosa addaa akka isaaf teetu filate.","poem":2},{"lineBreak":true},{"text":"Maqaan isaa Mootii Waan Maraa Ka Waan Mara Dade.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Burrisa Mootii Waan Maraa"]},{"type":"verse","number":20,"content":[{"text":"Mootiin Waan Maraa «Ee Baabilon,","poem":1},{"text":"ati burrisa kiyyaa fi meya woraanaa kiyya.","poem":2},{"text":"Ani si'iin gosa biyya adda addaa butucha;","poem":1},{"text":"si'iin mootummoota balleessa;","poem":2}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"si'iin fardaa fi abbootii fardaa butucha;","poem":2},{"lineBreak":true},{"text":"si'iin garreettaa fardaan harkifamuu fi worra isa oofu butucha;","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"si'iin dhiiraa fi dubartii butucha;","poem":2},{"lineBreak":true},{"text":"si'iin jaarsaa fi ijoollee butucha;","poem":2},{"lineBreak":true},{"text":"si'iin dargaggeessaa fi dargaggeettii butucha;","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"si'iin tissitootaa fi hoolee butucha;","poem":2},{"lineBreak":true},{"text":"si'iin qonnaan bula'aa fi qotiyyoo butucha;","poem":2},{"lineBreak":true},{"text":"si'iin bulchitootaa fi qondaaltota butucha» jedha.","poem":2}]},{"type":"heading","content":["Adabamiisa Baabilonii"]},{"type":"verse","number":24,"content":["Mootiin Waan Maraa, «Waan hantuu worri Baabiloniitii fi worri isii keessa le'u,",{"text":"Xiyoon irratti hujaneef,","poem":2},{"lineBreak":true},{"text":"ani iluma teessan duratti gatii isaaniif hin kenna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"«Ee Baabilon, ee gaara lafa mara balleessitu,","poem":1},{"text":"kunoo ani si irratti ka'eera;","poem":2},{"lineBreak":true},{"text":"ani si loliisaaf harka kiyya si irratti diriirfadhee,","poem":2},{"lineBreak":true},{"text":"bowwaa rassa'aa irraa gad si hin konkolaachisa;","poem":2},{"lineBreak":true},{"text":"akka gaara gubatee si hin godha.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ati haga bara baraa duwwaa waan teetuuf,","poem":1},{"text":"dhakaan roga ijaarsaa,","poem":2},{"lineBreak":true},{"text":"dhakaan hunde'eelle si keessatti hin dhaggamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"«Beessisa lolaa lafa mara keessatti ol kaasa'a!","poem":1},{"text":"Gosa biyya adda addaa oddu'utti tultullaa afuufa'a!","poem":2},{"lineBreak":true},{"text":"Isii loliisaaf kolbaa qopheessa'a!","poem":2},{"text":"Mootummaa Araaraatii","poem":1},{"text":"mootummaa Miiniitii fi","poem":2},{"lineBreak":true},{"text":"mootummaa Ashkenaasii,","poem":2},{"lineBreak":true},{"text":"Baabilon loliisaaf waama'a.","poem":2},{"text":"Ajajaa loltootaa itti fila'a;","poem":1},{"text":"fardoo akka tuuta awwaannisaa itti erga'a.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Mootota Miidiya'aa,","poem":1},{"text":"bulchitootaa fi qondaaltota isi'ii mara,","poem":2},{"lineBreak":true},{"text":"biyya isaan bulchanu mara","poem":2},{"lineBreak":true},{"text":"gosa biyya adda addaa tana mara","poem":2},{"lineBreak":true},{"text":"isii loliisaaf qopheessa'a.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Akka nami tokkolle achi hin leene,","poem":1},{"text":"lafa Baabilonii duwwaa godhiisaaf,","poem":2},{"lineBreak":true},{"text":"karoorri ani Mootiin Waan Maraa","poem":2},{"lineBreak":true},{"text":"isii loliisaaf qopheesse waan muummowuuf,","poem":2},{"lineBreak":true},{"text":"latti raafantee hin rommiti.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Loltooti Baabilonii loliisa lakkisaneeran;","poem":1},{"text":"Kushee jadduu ifii keessa tee'aneeran.","poem":2},{"text":"Isaan hunna dhabanee,","poem":1},{"text":"akka dubarti'ii te'aneeran;","poem":2},{"lineBreak":true},{"text":"mana isaaniititti ibiddi qassiifameera;","poem":2},{"lineBreak":true},{"text":"danqaraan karra isaaniille caccabeera.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Qachaan karaa maraan akka qabame,","poem":1},{"text":"mootii Baabiloniititti himiisaaf,","poem":2},{"lineBreak":true},{"text":"nama rukkisu gula ka dhibiin,","poem":2},{"lineBreak":true},{"text":"nama ergame gula nami ergame ka dhibiin rukkisaa,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"‹Malkaan marti qabanteerti;","poem":1},{"text":"addeen itti dhokatanu","poem":2},{"lineBreak":true},{"text":"qocceen qarqara bisaanii gubatteerti;","poem":2},{"lineBreak":true},{"text":"loltootille bararaxxeerti› jedhan» jedhe.","poem":2}]},{"type":"verse","number":33,"content":["Mootiin Waan Maraa Ka Waan Mara Dade, Waaqi Israa'elii:",{"text":"«Baabilon akka eeddummee","poem":1},{"text":"midhaan itti dhowatanuu hin teeti;","poem":2},{"lineBreak":true},{"text":"guyyaan Baabilon akka midhaanii dhowantu","poem":2},{"lineBreak":true},{"text":"ariifatee hin dhufa.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Worri Xiyoon keessa le'u,","poem":1},{"text":"‹Mootiin Baabilonii Nebukadnezaar","poem":2},{"lineBreak":true},{"text":"akka jawwe'ee nu liqinsee,","poem":2},{"lineBreak":true},{"text":"caccassee nu nyaatee,","poem":2},{"lineBreak":true},{"text":"akka okkotee duwwaa jirtuu nu godhe.","poem":2},{"lineBreak":true},{"text":"Cooma kennaan gadhaa ifii guutatee","poem":2},{"lineBreak":true},{"text":"deebisee nu tufe.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Kolbaan qachaa Xiyoonii marti: Wonni nu irratti te'e,","poem":1},{"text":"Baabilon irralle'etti te'uu ti› hin jedhan;","poem":2},{"lineBreak":true},{"text":"kolbaan Yerusaalemiille, ‹Dhiigi keenna akka dhangala'e,","poem":2},{"lineBreak":true},{"text":"dhiigi Baabiloniille dhangala'uu ti› hin jedhan.","poem":2}]},{"type":"verse","number":36,"content":["«Tanaaf ani Mootiin Waan Maraa kolbaa Yerusaalemiitiin:",{"text":"«Kunoo ani marroo teessaniif falmadhee","poem":1},{"text":"worra Baabilonii irratti haluu hin baya;","poem":2},{"lineBreak":true},{"text":"ani laga isaaniitii fi bisaan isaanii hin gossa.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Baabilon tuulaa bututaa,","poem":1},{"text":"addee jeedalti itti galtu,","poem":2},{"lineBreak":true},{"text":"waan hantuu nami dhaggee bararaqu,","poem":2},{"lineBreak":true},{"text":"waan nami ittiin murguu,","poem":2},{"lineBreak":true},{"text":"addee nami keessa hin leene hin teeti.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Kolbaan Baabilon marti","poem":1},{"text":"akka neenqaa hin harqan;","poem":2},{"lineBreak":true},{"text":"akka ilmee neenqaalle hin gurura'an.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Yennaa isaan waan nyaatanu dhabanee gubatane,","poem":1},{"text":"akka isaan unanee machowanu","poem":2},{"lineBreak":true},{"text":"areertii isaaniif hin qopheessa;","poem":2},{"lineBreak":true},{"text":"achiin duuba isaan gammadaan hirriiba hamaa","poem":2},{"lineBreak":true},{"text":"ka deebi'anee hin dammandhe hin rafan.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Ani akka buruusota hoole'ee,","poem":1},{"text":"akka korbeeyyii hoole'eetii fi akka korbeeyyii re'e'ee","poem":2},{"lineBreak":true},{"text":"akka isaan qalamanu hin godha.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Qachaan Baabilonii","poem":1},{"noteId":20},{"text":"attam booji'ame!","poem":1},{"lineBreak":true},{"text":"Ka biyyi lafaa ittiin koortu attam qabame!","poem":1},{"text":"Baabilon gosa biyya adda addaa oddu'utti","poem":2},{"lineBreak":true},{"text":"attam waan hantuu nami dhaggee bararaqu teete!","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Abbaayaan Baabilon irra hin yaa'a;","poem":1},{"text":"danbaliin shookittu isii irra hin dhangalaati.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Qachooti Baabilonii","poem":1},{"text":"ka nami keessa hin leenee fi","poem":2},{"lineBreak":true},{"text":"ka nami keessa hin deddeebine","poem":2},{"lineBreak":true},{"text":"lafa godduu goomolee, ona hin te'an.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Baabilon keessatti waaqa dharaa","poem":1},{"text":"ka ‹Beel› jedhamu hin adaba;","poem":2},{"lineBreak":true},{"text":"waan inni liqinselle akka diddigu hin godha.","poem":2},{"text":"Haganaa achi gosi biyya adda addaa","poem":1},{"text":"gara isaa hin yaa'anu;","poem":2},{"lineBreak":true},{"text":"Dalleenni Baabiloniille hin jiga.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Ee kolbaa tiyya isii keessaa baya'a!","poem":1},{"text":"Lubbuu teessan hamburadha'a!","poem":2},{"lineBreak":true},{"text":"Aarii tiyya jadduu jalaa baya'a!","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Oduun lafa irratti yennaa dhage'antuu","poem":1},{"text":"addii hin kutatina'a yookiin hin sodaatina'a!","poem":2},{"text":"Bulchaan bulchaa irratti hin ka'a;","poem":1},{"text":"hammeennille lafa irratti hin te'a;","poem":2},{"lineBreak":true},{"text":"oduun tuun barana","poem":2},{"lineBreak":true},{"text":"ta dhibiille bara dhufu hin dhutti.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Dhugumaan barri ani waaqa dharaa ka Baabilonii adabu hin dhufa;","poem":1},{"text":"latti isi'ii duudiin hin salphatti;","poem":2},{"lineBreak":true},{"text":"worri ijjeefamane marti achi keessatti hin jigan.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Diinoti gara kaabaatii dhufanee","poem":1},{"text":"Baabilon waan lolanuuf,","poem":2},{"lineBreak":true},{"text":"ol-gubba'aa fi latti,","poem":2},{"lineBreak":true},{"text":"wonni isaan keessa jiru martinuu","poem":2},{"lineBreak":true},{"text":"gammadaan Baabilon irratti hin ilillisan.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Baabilon namoota biyya lafaa duudii akkuma fixxe,","poem":1},{"text":"kolbaa Israa'eliille waan fixxeef","poem":2},{"lineBreak":true},{"text":"isiille hin baddi.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Ee isin worri shallaagaa jalaa baatane,","poem":1},{"text":"adoo hin turin achii keessaa baya'a;","poem":2},{"lineBreak":true},{"text":"worri lafa fagoo jirtanu","poem":2},{"lineBreak":true},{"text":"ana Mootii Waan Maraa qaabadha'a;","poem":2},{"lineBreak":true},{"text":"Yerusaalemille yaadadha'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"«Isin ammoo, ‹Worri ormaa addee woyyittii","poem":1},{"text":"mana Mootii Waan Maraa waan seenaneef","poem":2},{"lineBreak":true},{"text":"nuuti waan arraffanneef,","poem":2},{"lineBreak":true},{"text":"fokkifannee, salphanneerra› jettan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"«Ammoo barri ani waaqota dharaa","poem":1},{"text":"ka Baabilonii adabu hin dhufa;","poem":2},{"lineBreak":true},{"text":"lafa isi'ii mara irratti","poem":2},{"lineBreak":true},{"text":"worri madowe hin aada.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Baabilon haga gubba'aa yoo dhaqqadelle,","poem":1},{"text":"kushee ifii jadduu dheeressitee yoo ijaarrattelle,","poem":2},{"lineBreak":true},{"text":"ani worra lolee isii balleessu isi'itti hin erga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":54,"content":[{"text":"«Baabilon keessaa qoonqoon iyyaa,","poem":1},{"text":"lafa Baabilonii keessaa","poem":2},{"lineBreak":true},{"text":"qoonqoon badii guddo'oo hin dhage'anti.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Ani Mootiin Waan Maraa","poem":1},{"text":"Baabilon hin balleessa;","poem":2},{"lineBreak":true},{"text":"qoonqoo guddoo isii keessaa cadhi hin godha;","poem":2},{"lineBreak":true},{"text":"qoonqoon diinota isi'ii","poem":2},{"lineBreak":true},{"text":"ta akka danbalii bisaan guddaa shookkisuu","poem":2},{"lineBreak":true},{"text":"isii keessatti hin dhage'anti.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Ani Mootiin Waan Maraa","poem":1},{"text":"Waaqa haluu bayu waan te'eef","poem":2},{"lineBreak":true},{"text":"Baabiloniif akka hujii isi'iititti isi'iif hin kaffala;","poem":2},{"lineBreak":true},{"text":"worri balleessu isii loliisaaf hin dhufa;","poem":2},{"lineBreak":true},{"text":"loltooti isi'ii hin qabaman;","poem":2},{"lineBreak":true},{"text":"guubeen isi'iille hin caccaba.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Ani Mootichi ka maqaan kiyya,","poem":1},{"text":"‹Mootii Waan Maraa Ka Waan Mara Dade› jedhamu","poem":2},{"lineBreak":true},{"text":"qondaaltota isi'ii, qaroolee isi'ii,","poem":2},{"lineBreak":true},{"text":"sooressitoota isi'ii, ajajjoota loltootaatii fi","poem":2},{"lineBreak":true},{"text":"loltoota isi'ii hin macheessa.","poem":2},{"lineBreak":true},{"text":"Isaan haga bara baraa rafanee hin dammaqanu.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Dalleenni Baabilonii yabbichi hin diigama;","poem":1},{"text":"karri isi'ii dhedheertuun ibiddaan hin gubatti;","poem":2},{"lineBreak":true},{"text":"kolbaan isi'ii toluma elootti","poem":2},{"lineBreak":true},{"text":"eloon kolbaa isi'iille ibiddaan hin gubatti» jedha.","poem":2}]},{"type":"verse","number":59,"content":["Zedeqiiyaan mootii Yihuda'aa te'ee woggaa arfeesso'ootitti, itti gaafatamaan waan mooticha qofaaf barbaachisuu, akaakoon Ma'aseya'aa ilmi Neriiya'aa Seeriyaan isa woliin gara Baabilonii yennaa dhaqe, Ermiyaasiin raagichi erga asii gad jirtu tana isatti hime:"]},{"type":"verse","number":60,"content":["Ermiyaas badii Baabilon irratti dhufiisatti jirtu mara, waan marroo Baabiloniitiif barreeffame mara kitaaba maramaa irratti barreesse."]},{"type":"verse","number":61,"content":["Inni Seraaya'aan, «Yennaa Baabilon geette, waan kitaaba kana irratti barreeffame mara qoonqoo ol qabadhuutii kolba'aaf dubbisi;"]},{"type":"verse","number":62,"content":["yennaa dubbittu, ‹Ee Mootii Waan Maraa! Ati addee tana, nami yookiin horiin haga keessa hin leenetti haga bara baraa ona hin godha jetteerta› jedhi."]},{"type":"verse","number":63,"content":["Yennaa kitaaba maramaa kana dubbittee fixxe, dhakaa itti hidhiitii laga Efraaxiisii keessa buusi!"]},{"type":"verse","number":64,"content":["Achiin duuba, ‹Ani Mootiin Waan Maraa badii isii irratti waan fiduuf, Baabilon deebitee akka hin kaane hin liqinfanti; kolbaan isi'iille hin jiddi› jedhi» jedhe. Dubbiin Ermiyaasii as irratti dhumatte."]}],"footnotes":[{"noteId":19,"caller":"+","text":"Tuuta: Heechaalle hin jedhama.","reference":{"chapter":51,"verse":14}},{"noteId":20,"caller":"+","text":"Sheshaak: Maqaa Baabilonii ka dhibi'i.","reference":{"chapter":51,"verse":41}}]},"thisChapterLink":"/api/gax_twf/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":64}