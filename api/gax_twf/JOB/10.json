{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"«Ani jiruu tiyya jibbeera;","poem":1},{"text":"tanaaf ittuma gungumaa,","poem":2},{"lineBreak":true},{"text":"hadhaa lubbuu tiyyaa hin dubbadha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ani Waaqaan,","poem":1},{"text":"‹Waan na loltuuf natti himi malee,","poem":2},{"lineBreak":true},{"text":"natti hin murin!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mala worra hamoole'ee fudhattee,","poem":1},{"text":"hujii harka keetii tuffattee,","poem":2},{"lineBreak":true},{"text":"na cunqursiisi si hin gammachiisaa?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ati ila nama foonii qaddaa ree?","poem":1},{"text":"Akkuma nami ilaalu ilaaltaa ree?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Guyyooti keeti akka guyyoota namaatii ree?","poem":1},{"text":"Yookiin woggooti keeti akka woggoota namaatii ree?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ati maaf yakkaa tiyya barbaaddee,","poem":1},{"text":"cubbuu tiyya qorqorta?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Akka ani yakkaa hin qannee fi","poem":1},{"text":"harka keeti keessaa nami na baasu","poem":2},{"lineBreak":true},{"text":"akka hin jirre ati hin beetta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«‹Ka miidhassee na dade harka keeti;","poem":1},{"text":"amma deebitee na balleessitaa?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Faara irraa akka na dadde qaabadhu;","poem":1},{"text":"ammalle biyye'etti na deebisu'uufii ree?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ati akka aananii na dhangalaattee,","poem":1},{"text":"akka itittu'uu na hin itichinee ree?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Goga'aa fi foon natti uffittee,","poem":1},{"text":"lafe'ee fi ribu'uun wolitti qassiitte.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ati jiru'uu fi jaalala bara baraa keeti","poem":1},{"text":"naaf kenniteerta;","poem":2},{"lineBreak":true},{"text":"eeddoon teeti","poem":2},{"lineBreak":true},{"text":"na jiraachitteerti.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ati ada waan kana","poem":1},{"text":"gadhaa keeti keessatti dhoffatteerta.","poem":2},{"text":"Kun karoora keeti akka te'e","poem":1},{"text":"ani hin beeka.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ani yoo cubbuu huje","poem":1},{"text":"ati hin dhaggita;","poem":2},{"lineBreak":true},{"text":"yakkaa tiyyalle","poem":2},{"lineBreak":true},{"text":"adaddu malee hin lakkittu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hamaalessa yoo te'e,","poem":1},{"text":"naaf aanne'e!","poem":2},{"text":"Nama balchaa te'ulle","poem":1},{"text":"dande'ee mataa kiyya ol hin qabadhu.","poem":2},{"text":"Ani waan salphadheef","poem":1},{"text":"rakko'oon guutameera.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yoo mataa kiyya ol qabadhe,","poem":1},{"text":"ati akka neenqaa na adansita.","poem":2},{"text":"Na miidhiisaafille","poem":1},{"text":"itti deddeebitee hunna teeti sodaachittuu","poem":2},{"lineBreak":true},{"text":"natti mudhitta.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ati dhugaa baatota haareya na irratti kaatta;","poem":1},{"text":"mufii teeti natti fakkansita;","poem":2},{"lineBreak":true},{"text":"loltoota haareya natti fidda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«‹Waaqa kiyya, maaf akka ani dhaladhu na goote?","poem":1},{"lineBreak":true},{"text":"Ilti nama tokkoolle","poem":1},{"text":"adoo na hin dhaggin","poem":2},{"lineBreak":true},{"text":"adoo du'ee hin jiraadhuu!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Adoo dhalatiisa hin dhabuu!","poem":1},{"text":"Yookiin gadaamessa keessaa","poem":2},{"lineBreak":true},{"text":"gara awwaalaa adoo hin geeffamuu!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Barri jiruu tiyyaa gabaaba'aa motii?","poem":1},{"text":"Bara gabaabaa kana keessatti","poem":2},{"lineBreak":true},{"text":"diqqumalle akka gammadu na lakkis.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ani gara lafa deebi'anee hin gallee,","poem":1},{"text":"lafa dimimmisaatii fi dukkana dimmaa,","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"gara lafa dukkana dimmaa","poem":2},{"lineBreak":true},{"text":"gara lafa gaaddisa du'aa","poem":2},{"lineBreak":true},{"text":"gara lafa nageya hin qannee,","poem":2},{"lineBreak":true},{"text":"addee ifi akka dukkanaa te'e","poem":2},{"lineBreak":true},{"text":"adoo hin dhaqin","poem":2},{"lineBreak":true},{"text":"diqqumalle akka gammadu na lakkis› hin jedha» jedhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JOB/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/9.json","previousChapterAudioLinks":{},"numberOfVerses":22}