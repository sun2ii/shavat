{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":11,"content":[{"type":"heading","content":["Zofaar"]},{"type":"verse","number":1,"content":[{"text":"Achiin duuba Naa'imaatichi Zofaar deebisee,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«Dubbii hedduu tanaaf deebiin hin kennantuu ree?","poem":1},{"text":"Nami dubbatticha te'eef dhugaa dhaggataa ree?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iyoob, dharti teeti nama cadhisiittii ree?","poem":1},{"text":"Yennaa ati murgitulle","poem":2},{"lineBreak":true},{"text":"nami si xixu hin jiru seetaa?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ati Waaqaan, ‹Barsiisi kiyya sirri'i;","poem":1},{"text":"fuula Waaqaa duralle'etti","poem":2},{"lineBreak":true},{"text":"ani qulqullu'u› jetta.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ammoo adoo Waaqi afaan ifii saaqatee,","poem":1},{"text":"sitti dubbate,","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"karaan qarumma'aa hedduu waan te'eef,","poem":2},{"lineBreak":true},{"text":"dhossaa qarumma'aa adoo sitti mudhise,","poem":2},{"lineBreak":true},{"text":"haga si'iif maltee gad","poem":2},{"lineBreak":true},{"text":"akka inni si adabe hin beettaayyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Gad fageenna dhossaa Waaqaa","poem":1},{"text":"qorqortee beekuu dandeettaa?","poem":2},{"text":"Waaqa waan mara dande'u","poem":1},{"text":"qorqortee bira gewuu dandeettaa?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Guddinni isaa ol-gubbaa caalaa ol fagaata.","poem":1},{"text":"Ati maan godhuu dandeetta ree?","poem":2},{"text":"Gad fageenni isaalle qilee caalaa gad fagaata.","poem":1},{"text":"Ati maan beekuu dandeetta ree?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Guddinni Waaqaa lafa caalaa dheerata;","poem":1},{"text":"abbaayaa caalaalle badhata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Waaqi tana duudii irra dabaree dhufee,","poem":1},{"text":"mana hidha'aatitti si galchee","poem":2},{"lineBreak":true},{"text":"kora mura'aa sitti rare","poem":2},{"lineBreak":true},{"text":"eentu isa dhoogguu dande'a?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inni kolbaa woy hin baane hin beeka;","poem":1},{"text":"inni yennaa yakkaa isaanii dhaggu","poem":2},{"lineBreak":true},{"text":"cadhisee hin ilaalaa?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yoo harreen diidaa nama dhalte qofa","poem":1},{"text":"nami gowwaan qaroo te'uu dande'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Ati gadhaa keeti yoo qajeelfatte,","poem":1},{"text":"harka keeti gara Waaqaa yoo badhifatte,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"yakkaa harka keeti keessa jirtu","poem":2},{"lineBreak":true},{"text":"ifi irraa yoo fageessitee,","poem":2},{"lineBreak":true},{"text":"wonni hantuun dunkaana keeti keessaa","poem":2},{"lineBreak":true},{"text":"akka hin jiraanne yoo goote,","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"yennaa san dhugumaan qaanii malee,","poem":2},{"lineBreak":true},{"text":"mataa keeti ol hin qabatta;","poem":2},{"lineBreak":true},{"text":"sodaa maleelle jabaattee hin dhaabbatta.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Achiin duuba rakkoo teeti duudii hin deeta;","poem":1},{"text":"akka lolaa yaa'ee dabaree qofa isii qaabatta.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Jiruun teeti ifa saafowaa caalaa hin itti;","poem":1},{"text":"dukkantille akka ganamaa hin teeti.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Addiin waan jirtuuf atille addattee hin leeta;","poem":1},{"text":"Waaqi waan si eeguuf","poem":2},{"lineBreak":true},{"text":"sodaa malee fooraan hin leeta.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Eennulle adoo hin sodaatin hin ratta;","poem":1},{"text":"worri hedduun si duratti","poem":2},{"lineBreak":true},{"text":"fudhatama dhaggatiisa barbaadan.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ilti worra hama'aa ammoo hin jaamti;","poem":1},{"text":"karaa miliqanu hin dhaggatanu;","poem":2},{"lineBreak":true},{"text":"muummeen isaanii du'a» jedhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}