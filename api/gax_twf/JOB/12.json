{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":12,"content":[{"type":"heading","content":["Iyoob"]},{"type":"verse","number":1,"content":["Iyoob deebisee,"]},{"type":"verse","number":2,"content":[{"text":"«Dhuguma isin qaroole'ee motii ree!","poem":1},{"text":"Yennaa duutanulle","poem":2},{"lineBreak":true},{"text":"qarummaan isin woliin duutii motii ree!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ani ammoo akkuma keessan","poem":1},{"text":"hubantii qaba;","poem":2},{"lineBreak":true},{"text":"ani isinii gadii moti;","poem":2},{"lineBreak":true},{"text":"waan akkasii kana","poem":2},{"lineBreak":true},{"text":"eentu wollaala ree?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Waaqa daadimadhee","poem":1},{"text":"yennaan inni naaf deebise jirtiiyyu;","poem":2},{"lineBreak":true},{"text":"amma ani waan jaaloti tiyya itti kollitu te'eera.","poem":2},{"text":"Ani nami balchaan komii hin qanne","poem":1},{"text":"waan nami duudiin itti kollu te'eera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Worri itti tolte","poem":1},{"text":"rakkinna nama rakkatee tuffatiis kaso'o;","poem":2},{"lineBreak":true},{"text":"nama jigiisaaf tintimu hin darban.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dunkaaniin worra saantotaa nageyaan jirti;","poem":1},{"text":"worri Waaqa tuttuqee aarsu,","poem":2},{"lineBreak":true},{"text":"worri Waaqa waan toowatu ifi seyu","poem":2},{"lineBreak":true},{"text":"nageyaan le'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Me bineensota gaafadhu;","poem":1},{"text":"Isaan si barsiisan.","poem":2},{"text":"Sinbirrootalle gaafadhu","poem":1},{"text":"isaan sitti hin himan.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yookiin lafa gaafadhu;","poem":1},{"text":"isiin si hin barsiitti;","poem":2},{"lineBreak":true},{"text":"yookiin qurxummiin abbaaya'aa","poem":2},{"lineBreak":true},{"text":"sitti hin hinti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Harki Waaqaa akka isaan dade","poem":1},{"text":"isaan kana duudii keessaa","poem":2},{"lineBreak":true},{"text":"ka hin beenne eennu ree?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Jiruun waan duudi'iitii fi","poem":1},{"text":"hafuurri nama duudi'ii harka Waaqaa jiran.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Akkuma arrabi sagalee addaan baasee beeku,","poem":1},{"text":"gurrille dubbii addaan hin baasa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Qarummaa maanguddootatti qabaa motii ree?","poem":1},{"text":"Hubantiille worra woggaa dheertuu","poem":2},{"lineBreak":true},{"text":"le'etti qabaa motii ree?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Qarumma'aa fi hunni ta Waaqaa ti;","poem":1},{"text":"gorsaa fi hubantiille tama isaa ti.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Waan inni diige,","poem":1},{"text":"nami tokkolle deebisee ijaaruu hin dande'u.","poem":2},{"text":"Nama inni balbala itti cufe,","poem":1},{"text":"nami tokkolle banuu hin dande'u.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yoo inni bokkeya dhooggate","poem":1},{"text":"oola'atti te'a;","poem":2},{"lineBreak":true},{"text":"yoo inni bokkeya gad lakkise,","poem":2},{"lineBreak":true},{"text":"lolaan lafa balleessa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Jabeennii fi qarummaan ta isaa ti;","poem":1},{"text":"ka sobuu fi ka sobamulle","poem":2},{"lineBreak":true},{"text":"isaan lamaanuu baallii isaa jala jiran.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Inni gorsitoota mootichaa","poem":1},{"text":"miila duwwaa akka booji'amanu hin godha;","poem":2},{"lineBreak":true},{"text":"abbootii mura'aalle hin gowwoonsa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Inni mootota","poem":1},{"text":"barcumaa mootumma'aa irraa buusee,","poem":2},{"lineBreak":true},{"text":"hidhantoota isaan godha.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Inni hayyoota irraa baallii isaanii mulqee,","poem":1},{"text":"worra hunnaameyyiille hin fonqolcha.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Worra addatame cadhi godha;","poem":1},{"text":"jaarsoleelle qarummaa hin dhoogga.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Inni qondaaltota hin salphisa;","poem":1},{"text":"hidhata worra jajjabaa hin hiika.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Inni dhossaa dukkana keessaa hin mudhisa;","poem":1},{"text":"dukkana dimma gara ifaa hin jijjiira.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Inni gosa biyya adda addaa","poem":1},{"text":"hunnaameyyii hin godha; hin balleessalle'e;","poem":2},{"lineBreak":true},{"text":"inni gosa biyya adda addaa hin baceessa;","poem":2},{"lineBreak":true},{"text":"hin bittinnessalle'e.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Inni sooreyyii irraa hubantii isaanii hin mulqa;","poem":1},{"text":"goomolee daandii hin qanne keessalle","poem":2},{"lineBreak":true},{"text":"hin joonjisiisa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Isaan ifa malee,","poem":1},{"text":"dukkana keessa qaqqabataa akka ideemanu,","poem":2},{"lineBreak":true},{"text":"akka nama machoweelle","poem":2},{"lineBreak":true},{"text":"akka titimisanu hin godha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}