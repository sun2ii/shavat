{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"«Kunoo, tana mara ilti tiyya dhaggiteerti;","poem":1},{"text":"gurri kiyyalle dhage'ee hubateera.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Waan isin beettanu anille hin beeka;","poem":1},{"text":"ani isinii gadii moti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ani ammoo","poem":1},{"text":"Waaqa waan mara dande'u woliin dubbadhee,","poem":2},{"lineBreak":true},{"text":"haajaa kiyya isa woliin falmuu fedha malee,","poem":2},{"lineBreak":true},{"text":"si woliinii moti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isin ammoo dharaan hallitan;","poem":1},{"text":"isin akka ogeeyyii","poem":2},{"lineBreak":true},{"text":"eennulle fayyisuu hin dandeennee ti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ani silaa adoo cadhittane fedha,","poem":1},{"text":"sun isiniif qarummaa hin teetiiyyu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Amma falmata kiyya dhage'a'a;","poem":1},{"text":"iyyata afaan kiyyaalle caqasa'a.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Isin Waaqaaf jettanee dhara dubbattanii?","poem":1},{"text":"Isaaf jettanee soballe dubbattanii?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Isin isaaf rogaartanii ree?","poem":1},{"text":"Kora mura'aa duratti","poem":2},{"lineBreak":true},{"text":"haajaa Waaqaaf falmitanii ree?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Waaqi yoo isin qorqore","poem":1},{"text":"isiniif dansa'aa ree?","poem":2},{"text":"Yookiin akkuma nama soddanu","poem":1},{"text":"Waaqalle sobuu hin dandeettanii ree?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Isin dhossa'aan yoo roddane,","poem":1},{"text":"inni dhugumaan isin hin xixa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Arinyi isaa isin hin bararassuu ree?","poem":1},{"text":"Ulfinni isaa isin hin sodaachisuu ree?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mammaassi keessan","poem":1},{"text":"akka daadha'aa bu'aa hin qabu;","poem":2},{"lineBreak":true},{"text":"falmiin teessan akka faaraa caccaddi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Me na irraa cadhisa'a;","poem":1},{"text":"wonni feete natti dhuttuutii,","poem":2},{"lineBreak":true},{"text":"ani hin dubbadha.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ani maaf ifi rakkisee","poem":1},{"text":"lubbuu tiyyalle harkatti qabadhee le'a?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Waaqi yoo na ijjeeselle,","poem":1},{"text":"ani isuma addadha;","poem":2},{"lineBreak":true},{"text":"dhugaa tiyyalle isuma duratti falmadha.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Worri Waaqa malee le'u","poem":1},{"text":"Waaqa dura dhikaatuu waan hin dandeenneef,","poem":2},{"lineBreak":true},{"text":"kun fayyinna kiyyaaf te'a fa'a.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dubbii tiyya akka dansaa caqasa'aatii,","poem":1},{"text":"waan ani jedhulle","poem":2},{"lineBreak":true},{"text":"gurri keessan dhage'uu ti.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ani dubbii tiyya akka dansaa","poem":1},{"text":"qopheeffadheera;","poem":2},{"lineBreak":true},{"text":"akka dhugaa dhaggadhulle hin beeka.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"«Ka na himatu jiraa ree?","poem":1},{"text":"Yoo jiraate","poem":2},{"lineBreak":true},{"text":"ani adoo hin falmatin cadhisee hin du'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«Ee Waaqa!","poem":1},{"text":"Akka ani fuula keeti duraa hin dhokanneef,","poem":2},{"lineBreak":true},{"text":"waan lamaan kana qofa si gaafadha:","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Na adabiisa lakkisi;","poem":1},{"text":"arnya keetille'een na hin bararassin.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Achiin duuba na waami,","poem":1},{"text":"anille hin owwaadha.","poem":2},{"text":"Yookiin ani hin dubbadha","poem":1},{"text":"ati deebii naaf kenni.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yakkaan tiyyaa fi cubbuun tiyya","poem":1},{"text":"hagam heddatti?","poem":2},{"text":"Balleessaa tiyyaa fi cubbuu tiyya","poem":1},{"text":"natti himi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ati maaf fuula keeti na duraa dhoffattee,","poem":1},{"text":"akka diina keetiititti na laakkotta?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ati akka baala qilleensi fuudhee ideemuu na sodaachisaa,","poem":1},{"text":"akka hicaacee goddu'uu na ariitaa?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ati himannaa hadhoottuu","poem":1},{"text":"na irratti barreessite.","poem":2},{"text":"Gatii yakkaa bara ijoollummaa tiyyaalle,","poem":1},{"text":"akka dhaggadhu goote.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ati miila kiyya jirma oddu'utti hiiteerta;","poem":1},{"text":"tarkaaffii tiyya duudii hin eedda;","poem":2},{"lineBreak":true},{"text":"faana miila kiyyaalle hin qorqorta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"«Tanaaf ani akka waan shamee,","poem":1},{"text":"akka woyaa qu'een","poem":2},{"noteId":9},{"text":"nyaattee hin bada.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":9,"caller":"+","text":"Qu'een: Yookiin barbaaraan yookiin qooqqannaan yookiin biliin jedhamuu hin dande'a.","reference":{"chapter":13,"verse":28}}]},"thisChapterLink":"/api/gax_twf/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}