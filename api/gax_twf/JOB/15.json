{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":15,"content":[{"type":"heading","content":["Eliifaaz"]},{"type":"verse","number":1,"content":["Achiin duuba Eliifaaziin nami qachaa Temaanii deebisee,"]},{"type":"verse","number":2,"content":[{"text":"«Nami qaroon","poem":1},{"text":"dubbii hiikkaa hin qanne hin dubbataa?","poem":2},{"lineBreak":true},{"text":"Gadhaa ifii keessalle'etti","poem":2},{"lineBreak":true},{"text":"yaada miidhaa qabu qabatuu qabaa ree?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inni dubbii bu'aa hin qanneen,","poem":1},{"text":"yookiin haasowa woy hin baaneen","poem":2},{"lineBreak":true},{"text":"hin falmataa ree?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ati ammoo Waaqa sodaatiisa lakkitteerta;","poem":1},{"text":"waaqonfannaa isaaf maltelle hin gufachiitta.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yakkaan teeti dubbii teetiin beekkanti;","poem":1},{"text":"ati ammoo akka worra malte'ee","poem":2},{"lineBreak":true},{"text":"dubbatiisa filatta.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dubbuma teetittuu sitti mura;","poem":1},{"text":"arrabuma keetittuu","poem":2},{"lineBreak":true},{"text":"dhugaa si irratti baya malee,","poem":2},{"lineBreak":true},{"text":"anaa moti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Nama duudi'iin dura ka dhalate si'ii ree?","poem":1},{"text":"Ati gaaroti adoo hin dadaminiin dura dadantee ree?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Marii Waaqaa ta dhossa'aa dhageetteertaa?","poem":1},{"lineBreak":true},{"text":"Qarummaa nama duudi'ii ka beeku","poem":1},{"text":"si qofa seetaa?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Waan nuuti hin beenne,","poem":1},{"text":"maan beetta?","poem":2},{"text":"Waan nu'uuf ifa hin te'in maan hubatte?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Worri mataan isaanii arrii te'e","poem":1},{"text":"ka abbaa keeti caalaa dulloomane","poem":2},{"lineBreak":true},{"text":"nu woliin jiran.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jajjabeessiis Waaqaa","poem":1},{"text":"yookiin jechi inni malaan sitti dubbate","poem":2},{"lineBreak":true},{"text":"si hin gewuu?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Qalbiin teeti maaf si fudhattee ideenti?","poem":1},{"lineBreak":true},{"text":"Aari'iin ila teeti maaf baatta?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Maaf Waaqatti aartee","poem":1},{"text":"dubbiin akkasii afaan keetii baati?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Nami qulqulluu te'uu hin dande'aa ree?","poem":1},{"text":"Nami foon uffate balchaa te'uu dande'a ree?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Waaqi ergantoota ifiitittuu hin addatu;","poem":1},{"text":"ol-gubbaanuu isa duratti qulqullu'uu moti.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nami yakkaa akka bisaanii unu,","poem":1},{"text":"attam attam bada'aa fi battowa'a ree!","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«Ani waan dhagge hin dubbadha;","poem":1},{"text":"sitti hima na caqasi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Sunille waan worri qaroon","poem":1},{"text":"abbootii ifii irraa fuudhee","poem":2},{"lineBreak":true},{"text":"adoo hin dhossin dubbate.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Latti abbootii isaanii qofaaf kennanteertiiyyu;","poem":1},{"text":"ormille odduu isaanii hin leene.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nami hamaan ka nama cunqursaa le'e,","poem":1},{"text":"bara ifii duudii farraa le'a.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Qoonqoon bararassitu gurra isaatitti iyyiti;","poem":1},{"text":"yennaa wonni marti nageya itti fakkaattutti","poem":2},{"lineBreak":true},{"text":"ka balleessu isatti hin dhufa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Shallaagaan isa waan eegatuuf","poem":1},{"text":"inni dukkana keessaa bayiisaaf","poem":2},{"lineBreak":true},{"text":"addii hin qabu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Sagalee allaatti'ii te'iisaaf hin joonja;","poem":1},{"text":"guyyaan dukkanaa akka isatti dhikaatelle hin beeka.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Gaddaa fi laaleffati isa bararassan;","poem":1},{"text":"akka mooticha lolaaf qophowee itti hammaatan.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Inni harka ifii Waaqa irratti waan kaaseef,","poem":1},{"text":"Waaqa waan mara dande'u irratti","poem":2},{"lineBreak":true},{"text":"jabaa waan ifi fakkeesseef,","poem":2}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"mataa jabinnaan wontee ifii","poem":2},{"lineBreak":true},{"text":"furdoo-jadduu fudhatee","poem":2},{"lineBreak":true},{"text":"ifi irraa dhooggatiisaaf itti fiiga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"«Fuulli isaa coomaan gollameera","poem":1},{"noteId":11},{"text":";","poem":1},{"text":"hidhi isaa coomaan furdateera.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Nami kun qachoota diigame,","poem":1},{"text":"mana nami keessa hin leene,","poem":2},{"lineBreak":true},{"text":"ka diigamiisaaf dhikaate keessa le'a.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Inni hin duroomu,","poem":1},{"text":"karri isaalle yennaa heddu'uuf hin turtu;","poem":2},{"lineBreak":true},{"text":"lafa irralle'etti hin babadhattu.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Inni dukkana jalaa hin miliqu;","poem":1},{"text":"akka muka dameelee isaa bobeenni ibiddaa gosseetii fi","poem":2},{"lineBreak":true},{"text":"daraaraan isaalle hafuura aarii Waaqaatiin harca'ee hin te'a.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Inni womaa waan irraa hin dhagganneef,","poem":1},{"text":"waan bu'aa hin qannetti addatiisaan ifi hin sobin.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Akka muka jirmi isaa yennaan adoo hin geyin goguutii fi","poem":1},{"text":"dameeleen isaa hin bisillee hin te'a.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Inni akka muka woyni'ii","poem":1},{"text":"ka unkuruura ifii adoo hin bilchaatin harcaafatuutii fi","poem":2},{"lineBreak":true},{"text":"akka muka ejersaa","poem":2},{"lineBreak":true},{"text":"ka daraaraa ifii harcaafatuu ti.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Worri yaada Waaqa malee le'u","poem":1},{"text":"sanyii hin qabaatu;","poem":2},{"text":"Manni safu'uun","poem":1},{"noteId":12},{"text":"ijaarame","poem":1},{"text":"ibiddaan gubatee bada.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Worri akkas jiru","poem":1},{"text":"hammeenna karoorfataa rakkinna fida;","poem":2},{"lineBreak":true},{"text":"gadhaan isaaniille sobaan guutameera» jedhe.","poem":2}]}],"footnotes":[{"noteId":11,"caller":"+","text":"Gollameera: Yookiin bobbokokeer.","reference":{"chapter":15,"verse":27}},{"noteId":12,"caller":"+","text":"Safu'uun: Yookiin malaamaltumma'aa.","reference":{"chapter":15,"verse":34}}]},"thisChapterLink":"/api/gax_twf/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}