{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":16,"content":[{"type":"heading","content":["Iyoob"]},{"type":"verse","number":1,"content":["Achiin duuba Iyoob deebisee,"]},{"type":"verse","number":2,"content":[{"text":"«Ani dubbii akkasii","poem":1},{"text":"hedduu dhage'eera;","poem":2},{"lineBreak":true},{"text":"isin marti jajjabeessitoota nama hifachiittanu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dubbiin teessan","poem":1},{"text":"ta bu'aa hin qanne tun hin dhumattuu?","poem":2},{"text":"Yookiin akka ati na woliin falmiisa hin lakkinneef","poem":1},{"text":"maanti si kakkaasa?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Adoo isin addee tiyya buutanee,","poem":1},{"text":"ani addee teessan bu'ee jiraadhee","poem":2},{"lineBreak":true},{"text":"murgo'oon mataa isinitti raasaa","poem":2},{"lineBreak":true},{"text":"akkuma isin amma jettanu","poem":2},{"lineBreak":true},{"text":"anille isin irratti miidhassee dubbadhaayyu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dubbii afaan kiyyaatiin","poem":1},{"text":"silaa isin hin jajjabeessaayyu;","poem":2},{"lineBreak":true},{"text":"isin jabeessiisaafille","poem":2},{"lineBreak":true},{"text":"guddoo dubbatuu dande'aayyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Ani yoo guddoo dubbadhelle","poem":1},{"text":"dhibeen tiyya hin goontu;","poem":2},{"lineBreak":true},{"text":"yoo osselle dhibeen tiyya na hin lakkittu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Waaqa kiyya, ati na daddassiitteerta;","poem":1},{"text":"maatii tiyya duudiille balleessiteerta.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ati na shuntuurachiitteerta;","poem":1},{"text":"shuntuuratiis nafa kiyyaa","poem":2},{"lineBreak":true},{"text":"na irratti dhugaa bayaa te'eera;","poem":2},{"lineBreak":true},{"text":"huqqinni kiyya na irratti ka'ee,","poem":2},{"lineBreak":true},{"text":"akka ani cubbuu huje dhugaa hin baya.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Waaqi mufii ifiitiin nafa kiyya kukkute","poem":1},{"text":"inni hidhii natti ciniinnatee,","poem":2},{"lineBreak":true},{"text":"diinni kiyyalle ila natti diimeffate.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Namooti na ceeggatiisaaf afaan ifii natti banane;","poem":1},{"text":"tuffiille'een na dhabanaasanee","poem":2},{"lineBreak":true},{"text":"wolitti qabamanee natti ka'ane.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Waaqi kolbaa hantu'utti dabarsee na kennee,","poem":1},{"text":"harka worra hama'aatitti na gate.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ani nageyaan le'aa tureeyyu;","poem":1},{"text":"Waaqi ammoo mufii ifiitiin na hargufe;","poem":2},{"lineBreak":true},{"text":"inni morma kiyya hudhee na butuchee,","poem":2},{"lineBreak":true},{"text":"waan itti xiyyeeffatu na godhate.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Worri guube'ee ka isaa na marsee,","poem":1},{"text":"marartii malee kalattii tiyya kukkutee","poem":2},{"lineBreak":true},{"text":"hadhoottuu tiyyalle lafatti jisse.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Inni itti deddeebi'ee na madeesse;","poem":1},{"text":"akka loltu'uu gara kiyya ori'e.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«Ani gaddee woyaa gaddaa uffadheera;","poem":1},{"text":"bukuu keessalle'etti jigeera.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Fuulli kiyya bowichaan diimatee,","poem":1},{"text":"ilti tiyya dhagguu dadhaddeerti;","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"tun duudiin teetulle","poem":2},{"lineBreak":true},{"text":"ani hunnaan nama irratti hin kaane;","poem":2},{"lineBreak":true},{"text":"daadimati kiyyalle qulqullu'u.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«Ee lafa, dhiiga kiyya hin dhossin!","poem":1},{"text":"Iyyi tiyya si biratti ukkaamantee hin hafin!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kunoo ka dhugaa naa bayuu fi","poem":1},{"text":"wobiin kiyya ol-gubbaa jira.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Jaaloti tiyya na tuffatti;","poem":1},{"text":"ani ammoo gara Waaqaa bowa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Akkuma nami nama kadhatee wolitti araarsu,","poem":1},{"text":"nami namaa fi Waaqa wolitti araarsu","poem":2},{"lineBreak":true},{"text":"adoo hin jiraatuu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Ani deensa deebi'ee hin deebine deemiisaaf","poem":1},{"text":"woggaa diqqoo qofatti naa hafeera.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}