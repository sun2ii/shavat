{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"Qooqqee qofatti na keessa jira;","poem":1},{"text":"barri jiruu tiyyaa haleelameera;","poem":2},{"lineBreak":true},{"text":"awwaallille na eegata.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dhugumaan worri natti murgu","poem":1},{"text":"na marsaneeran;","poem":2},{"lineBreak":true},{"text":"ilti tiyyalle nunnuussaa isaaniititti xiyyeeffatti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«Waaqa kiyya,","poem":1},{"text":"ka si woliin wobii naaf te'u naa kenni;","poem":2},{"lineBreak":true},{"text":"si'uma malee,","poem":2},{"lineBreak":true},{"text":"ka dhibiin ka wobii naaf te'u eennu ree?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Akka isaan hin hubanneef","poem":1},{"text":"qalbii isaanii cutteerta","poem":2},{"lineBreak":true},{"text":"tanaaf akka isaan injifatanu hin gootu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nama beese'eef jedhee","poem":1},{"text":"jaala ifii dabarsee kennu","poem":2},{"lineBreak":true},{"text":"ijoolleen isaa hin rakkatti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Waaqi nama nami marti fuulatti tufu","poem":1},{"text":"nama duudi'iifille ka mammaassaa na godhe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gadda irraa ta kaate","poem":1},{"text":"ilti tiyya dhagguu dadhaddee","poem":2},{"lineBreak":true},{"text":"nafi kiyya duudiin akka gaaddiddu'uu te'eera.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Worri qajeelaa ifi seyu waan kana maadeffata;","poem":1},{"text":"worri yakkaa hin qanne","poem":2},{"lineBreak":true},{"text":"worra Waaqa malee le'utti ka'a.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Te'uu malee balchooti","poem":1},{"text":"karaa dhuga'aa irraa hin goranu;","poem":2},{"lineBreak":true},{"text":"worri harki isaanii qulqullu'uu ifi seyanu","poem":2},{"lineBreak":true},{"text":"jabeenna irratti jabeenna ede'atan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Isin marti ammoo","poem":1},{"text":"deebi'aatii ammalle wodhaana'a.","poem":2},{"text":"Ani odduu teessanitti","poem":1},{"text":"nama qaroo hin dhaggu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Barri le'ii tiyya hobba'eera;","poem":1},{"text":"karoorrii fi halchaan gadhaa kiyyaa","poem":2},{"lineBreak":true},{"text":"karaa irratti hafane.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Jarri tun halkan guyyaa gooti;","poem":1},{"text":"yennaa dukkanaa, ‹Ifi dhikaateera› jedhan.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Boolla awwaalaa akka mana kiyyaatitti","poem":1},{"text":"yoo ilaale,","poem":2},{"lineBreak":true},{"text":"taqee tiyya dukkana keessatti yoo afadhe,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"boolla awwaalaatiin, ‹Ati abbaa kiyya›","poem":2},{"lineBreak":true},{"text":"corroqa na nyaattulle'een,","poem":2},{"lineBreak":true},{"text":"‹Haadha tiyya yookiin obboleettii tiyya› yoo jedhe,","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"addiin tiyya meet ree?","poem":2},{"lineBreak":true},{"text":"Addii tiyya tana eentu naaf dhagga ree?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yoo ani gara boolla awwaalaa bu'u","poem":1},{"text":"addiin tiyya na woliin gad buutii ree?","poem":2},{"lineBreak":true},{"text":"wolille'een biyyee seennaa ree?» jedhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}