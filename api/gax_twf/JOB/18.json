{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":18,"content":[{"type":"heading","content":["Biildaad"]},{"type":"verse","number":1,"content":["Achiin duuba Biildaad nami biyya Shu'aa deebisee,"]},{"type":"verse","number":2,"content":[{"text":"«Iyoob, ati yoom dubbattee fixxa?","poem":1},{"text":"Caqasi, nuutille hin dubbanna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ati maaf akka hori'ii nu laakkotta?","poem":1},{"lineBreak":true},{"text":"Ila teeti duralle'etti","poem":1},{"text":"maaf akka gowwa'aatitti nu laakkotta?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ati aarii teetiin ifuu miita malee,","poem":1},{"text":"latti sababa keetiif hin ontu;","poem":2},{"lineBreak":true},{"text":"yookiin rassaan addee ifii irraa hin tacho'u.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Issaan worra hamaaleyyi'ii hin dhaama;","poem":1},{"text":"bobeenni ibidda isaaniille ijjumaa hin bobe'u.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Issaan dunkaanii isaanii keessa jiru hin dhaama;","poem":1},{"text":"ifille hin dukkanowa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hunni tarkaaffii isaanii hin laatti","poem":1},{"noteId":13},{"text":";","poem":1},{"text":"malli isaaniituu isaan hin gufachiisa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Miilli isaaniituu tiyyoo keessa isaan hin galcha;","poem":1},{"text":"gara boolla keessa bu'anuulle hin deeman.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tiyyoon komee isaanii hin qaddi;","poem":1},{"text":"fonxoroolle jabeessitee isaan hin qaddi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wodaroon isaan qaddu","poem":1},{"text":"lafa keessatti dhoffanteerti;","poem":2},{"lineBreak":true},{"text":"tiyyoolle karaa isaanii irratti afanteerti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wonni nama bararassu","poem":1},{"text":"isaan marsiteerti;","poem":2},{"lineBreak":true},{"text":"hordotteelle isaan hin ariiti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hunni isaanii beelaan dhumatteerti;","poem":1},{"text":"badiille qophoottee isaan eegatti.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dhukkubi gogaa nafa isaanii hin fixa;","poem":1},{"text":"duuti harkaa fi miila isaaniille hin nyaatti.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dunkaanii addatanee le'anu keessaa hin ari'aman;","poem":1},{"text":"gara mootummaa du'aalle hin geeffaman.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mana isaanii keessatti","poem":1},{"text":"wonni takkaalle hin hattu.","poem":2},{"text":"Qe'ee isaaniititti","poem":1},{"text":"dhakaan bobe'u hin firfirfama.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Isaan akka muka hidda hunde'een goguutii fi","poem":1},{"text":"dameeleen isaa qoortuu hin te'an.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Qaabbiin isaanii lafa irraa hin baddi;","poem":1},{"text":"maqaan isaaniille lafa irraa hin bada.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Isaan ifa irraa gara dukkanaatitti hin ari'aman;","poem":1},{"text":"biyya lafaa irralle'ee hin balleeffaman.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Odduu kolbaa ifiitii","poem":1},{"text":"dhala yookiin sanyii hin qabaatanu.","poem":2},{"text":"Addee isaan le'anulle'etti","poem":1},{"text":"ka jiru'uun hafu hin jiru.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Worri gara aduun baatuutii fi","poem":1},{"text":"gara aduun seentuu","poem":2},{"lineBreak":true},{"text":"waan isaan irra geye dhage'anee","poem":2},{"lineBreak":true},{"text":"sodaa guddo'oon qabamane.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Qe'een worra Waaqa malee le'uu","poem":1},{"text":"addeen nama Waaqa hin beenneelle","poem":2},{"lineBreak":true},{"text":"akkas teeti» jedhe.","poem":2}]}],"footnotes":[{"noteId":13,"caller":"+","text":"Hin laatti: Yookiin dadhaddi.","reference":{"chapter":18,"verse":7}}]},"thisChapterLink":"/api/gax_twf/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}