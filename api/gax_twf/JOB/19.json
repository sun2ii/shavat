{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":19,"content":[{"type":"heading","content":["Iyoob"]},{"type":"verse","number":1,"content":[{"text":"Achiin duuba Iyoob deebisee,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«Isin haga yoomii na farrisiittan?","poem":1},{"text":"Haga yoomii jechaan lafee na cassitan?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isin deddeebitanee na arrassitan;","poem":1},{"text":"daba na irratti hujjanuuf hin fokkifattanuu?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dhuguma yoo dokonkoree jiraadhe,","poem":1},{"text":"dokonkorri sun anuma qofa miidha.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dhuguma isin na irratti ifi ol ol qaddanee,","poem":1},{"text":"qaanii tiyya waan anaan morontanuun","poem":2},{"lineBreak":true},{"text":"yoo godhattane,","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ka na farrisiisee,","poem":2},{"lineBreak":true},{"text":"tiyyoo ifiitiin na marsee xaxe","poem":2},{"lineBreak":true},{"text":"Waaqa akka te'e beeka'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«‹Hunnaan na irratti ka'ane› jedhee iyyadhulle,","poem":1},{"text":"deebii hin dhagganne.","poem":2},{"text":"Qoonqoo tiyya ol qabadhee dhageessifadhulle,","poem":1},{"text":"muraa haqaa hin dhagganne.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Waaqi akka ani hin dabarreef","poem":1},{"text":"karaa natti cufeera;","poem":2},{"lineBreak":true},{"text":"daandii tiyyalle dukkanaan golleera.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inni ulfinna kiyya na irraa fuudhee,","poem":1},{"text":"kallachalle mataa kiyya irraa buuseera.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Inni karaa maraan nafa kiyya caccassee hurbee,","poem":1},{"text":"addii tiyyalle akka mukaa buqqiseera.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inni mufii ifii na irratti bobeessee,","poem":1},{"text":"akka diina ifiititti na laakkowe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Inni na balleessiisaaf loltoota ifii erge;","poem":1},{"text":"isaan adaala dunkaanii tiyyaatitti","poem":2},{"lineBreak":true},{"text":"kushee hujatanee qubatane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Waaqi obboleeyyan tiyya na irraa fageesse;","poem":1},{"text":"worri na beekulle alagaa akka natti te'u godhe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Firri kiyya na irraa fagaate;","poem":1},{"text":"jaaloti tiyyalle na dedhane.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Keessummooti ani mana kiyyatti keessummeesse","poem":1},{"text":"na dedhane.","poem":2},{"text":"Dubartooti tajaajiltooti tiyya","poem":1},{"text":"akka ormaatitti na laakkowane;","poem":2},{"lineBreak":true},{"text":"akka alaga'aalle na ilaalane.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ani tajaajilaa kiyya waame,","poem":1},{"text":"inni ammoo na jalaa dide;","poem":2},{"lineBreak":true},{"text":"akka na qarqaaruuf yennaa kadhadhelle na didate.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Haati manaa tiyya foolee hafuura kiyyaa jibbite;","poem":1},{"text":"obboleeyyan tiyyaayyuu na diqatte.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ijoolleen didiqoonuu na tuffatti;","poem":1},{"text":"yennaa na dhagganu natti murgan.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Jaaloti tiyya ta ani addadhu na diqatte;","poem":1},{"text":"worri ani jaaladhulle na irratti ka'e.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Foon kiyya dhumatee,","poem":1},{"text":"gogaan kiyya lafee tiyyatti maxxanee,","poem":2},{"lineBreak":true},{"text":"irgi","poem":2},{"noteId":14},{"text":"ilkaan kiyyaa callaan jiruun ani hafe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«Ee jaalota tiyya,","poem":1},{"text":"harki Waaqaa waan na dhoweef,","poem":2},{"lineBreak":true},{"text":"naaf marara'a!","poem":2},{"lineBreak":true},{"text":"Naaf marara'a!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Akkuma Waaqi na miidhe","poem":1},{"text":"isinille maaf na miitan?","poem":2},{"text":"Haga ammaa ka na miitane","poem":1},{"text":"isin hin gewuu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"«Maalo'o, dubbiin ani haga ammaa dubbadhe","poem":1},{"text":"barreeffantee, kitaabatti adoo galmeeffantee!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Maalo'o, bara baraan akka yaadatantuuf","poem":1},{"text":"meya sibiilaatii fi irsaasaatiin","poem":2},{"lineBreak":true},{"text":"rassaa irratti qiriixantee adoo hin barreeffantuu!","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ka na wodu jiraataa akka te'e,","poem":1},{"text":"muummee irralle'etti,","poem":2},{"lineBreak":true},{"text":"dhugaa bayiisaaf lafa irra akka dhaabbatu hin beeka.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Gogaan kiyya nyaatamee dhumateen duuba te'ulle","poem":1},{"text":"foon kiyyaan jiraadhee","poem":2},{"lineBreak":true},{"text":"Waaqa akka dhaggu hin addadha.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Anumattuu isa dhagga;","poem":1},{"text":"ani ila tiyyaan isuma dhagga malee,","poem":2},{"lineBreak":true},{"text":"ka dhibi'ii moti.","poem":2},{"lineBreak":true},{"text":"Gadhaan kiyya guyyaa san guddoo dharra'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"«Isin, ‹Sababi rakko'ootuu isuma keessa waan jirtuuf,","poem":1},{"text":"nuuti attam isa miina?› yoo jettane,","poem":2}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"mufiin Waaqaa shallaaga'aan adabamiisa","poem":2},{"lineBreak":true},{"text":"waan fidduuf","poem":2},{"lineBreak":true},{"text":"isin shallaagaa san sodaadha'a;","poem":2},{"lineBreak":true},{"text":"muraalle akka jirtu beeka'a» jedhe.","poem":2}]}],"footnotes":[{"noteId":14,"caller":"+","text":"Irgi: Lafa tokko tokkotti irgagi jedhama.","reference":{"chapter":19,"verse":20}}]},"thisChapterLink":"/api/gax_twf/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}