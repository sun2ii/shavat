{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":20,"content":[{"type":"heading","content":["Zofaarii Naa'imaaticha"]},{"type":"verse","number":1,"content":["Achiin duuba Zofaariin Naa'imaatichi deebisee,"]},{"type":"verse","number":2,"content":[{"text":"«Iyoob, ani deebii akka kennuuf","poem":1},{"text":"yaadi kiyya na dirqansiisa;","poem":2},{"lineBreak":true},{"text":"tanaaf dubbatiisaaf ariifadha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Arraffama ittiin salphadhe dhage'adheera;","poem":1},{"text":"hubatiis kiyya","poem":2},{"lineBreak":true},{"text":"akka ani deebii kennu na godheera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Bara durii durii","poem":1},{"text":"yennaa nami biyya lafaa irratti dadameen jalqabee,","poem":2},{"lineBreak":true},{"text":"dubbii akkasii tana beettaa ree?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Qaca'iis worra hama'aa,","poem":1},{"text":"haguma diqqa'a.","poem":2},{"text":"Gammadi worra Waaqa malee le'uulle","poem":1},{"text":"haga lipheettii ilaa ti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isaan haga ol-gubba'aa ifi ol ol qabanulle,","poem":1},{"text":"mataan isaanii duumensa tuqulle,","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"isaan akkuma faalowa ifii hin badan;","poem":2},{"lineBreak":true},{"text":"worri dur isaan dhaggeeru,","poem":2},{"lineBreak":true},{"text":"‹Isaan meet ree?› hin jedhan.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Isaan akka oojju'uu waan badanuuf","poem":1},{"text":"hin dhaggamanu;","poem":2},{"lineBreak":true},{"text":"akka mudhii halkaniille hin badan.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ilti tanaan dura isaan dhaggite,","poem":1},{"text":"deebitee isaan hin dhaggitu;","poem":2},{"lineBreak":true},{"text":"isaan addee le'anu irralle'ee hin badan.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ijoolleen isaanii","poem":1},{"text":"waan abbootiin isaanii hiyyeeyyii irraa saante","poem":2},{"lineBreak":true},{"text":"sossobataa hin deebitti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nafi isaanii ka hunna dargaggumma'aatiin guutame","poem":1},{"text":"isaan woliin biyyee hin te'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Hammeenni afaan isaanii keessatti mi'owee,","poem":1},{"text":"arraba ifiitiin jalatti dhossanee,","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"afaan ifii keessaa baasuu jibbanee,","poem":2},{"lineBreak":true},{"text":"afaan ifii keessatti qabatanulle,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"sagaleen isaanii gadhaa isaanii keessatti","poem":2},{"lineBreak":true},{"text":"gara hadha'aatitti hin jijjiiranti;","poem":2},{"lineBreak":true},{"text":"akka hadhaa dhudhuufa'aalle hin teeti.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Isaan karra nyaatane hin tufan;","poem":1},{"text":"Waaqi waan isaan nyaatane","poem":2},{"lineBreak":true},{"text":"akka diddiganu hin godha.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wonni isaan nyaatanu","poem":1},{"text":"hadhaa dhudhuufa'aa itti hin teeti;","poem":2},{"lineBreak":true},{"text":"hadhaa buuti'iille itti teetee isaan hin ijjeetti.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Isaan bisaanii fi laga","poem":1},{"text":"ka dammaa fi itittuu woliin yaa'u hin dhagganu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Waan ifii itti elowane","poem":1},{"text":"adoo hin nyaatin deebisanee hin kennan;","poem":2},{"lineBreak":true},{"text":"bu'aa daldalanee dhaggatanelle'etti hin gammadanu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Isaan hiyyeeyyii cunqursanee duwwaa hamburanee,","poem":1},{"text":"mana ifii hin ijaarinille waan fudhataneef tun teete.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«Joljolummaan isaanii foora isaan dhooggiteerti;","poem":1},{"text":"qabeenni isaanii isaan baasuu hin dande'u.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Isaan waan qabanu nyaatanee hin fixan;","poem":1},{"text":"tanaaf qabeenni isaanii dafee hin dhumata.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Qabeenna hedduu qabaatanulle,","poem":1},{"text":"deegi isaanitti hin bu'a;","poem":2},{"lineBreak":true},{"text":"rakkoon jadduulle isaan hin dhaqqaddi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Isaan nyaatanee yennaa quufanu,","poem":1},{"text":"Waaqi aarii ifii isaan irratti bobeessee,","poem":2},{"lineBreak":true},{"text":"balaa ifii akka bokkeyaa","poem":2},{"lineBreak":true},{"text":"isaan irratti hin roobisiisa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Shallaagaa sibiilaa jalaa yoo miliqe","poem":1},{"text":"daaya sageettu'uutiin hin woraanama.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Daayi sun woraanee duddaan isa fulla'a;","poem":1},{"text":"qacceen calalaxxuun arfii sanii","poem":2},{"lineBreak":true},{"text":"tiruu isaanii keessa baati;","poem":2},{"lineBreak":true},{"text":"naasuulle'een hin qabaman.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Qabeenni isaanii duudiin","poem":1},{"text":"dukkana dimmaa keessatti bada;","poem":2},{"lineBreak":true},{"text":"ibiddi hin dhaanne isaan hin guba;","poem":2},{"lineBreak":true},{"text":"waan dunkaana isaanii keessa hafelle","poem":2},{"lineBreak":true},{"text":"muxuq godha.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ol-gubbaan yakkaa isaanii hin mudhitti;","poem":1},{"text":"lattille diinumma'aan isaan irratti hin kaati.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Guyyaa mufii Waaqaa","poem":1},{"text":"qabeenni mana isaanii lola'aan hin fudhatama.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Qoodi Waaqi worra hama'aaf kennu,","poem":1},{"text":"gatiin isaaniille tana» jedhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}