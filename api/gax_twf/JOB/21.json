{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":21,"content":[{"type":"heading","content":["Iyoob"]},{"type":"verse","number":1,"content":["Iyoob deebisee,"]},{"type":"verse","number":2,"content":[{"text":"«Waan ani dubbadhu miidhassa'aa caqasa'a;","poem":1},{"text":"kun akka na jajjabeesitanetti isiniif laakkowamuu ti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ani hin dubbadhaa naaf ossadha'a;","poem":1},{"text":"achiin duuba akka feetane murguu dandeettan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Ani nama komadhaa ree?","poem":1},{"text":"Maaf ossa hin dhanne ree?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ana ilaala'aatii maadeffadha'a;","poem":1},{"text":"afaan keessanille qabadha'a.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani waan kana yennaa yaadadhu hin bararaqa;","poem":1},{"text":"nafi kiyyalle hin hollata.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Worri hamaan maaf le'a?","poem":1},{"text":"Maaf ganna dheeraa le'ee dullooma?","poem":2},{"lineBreak":true},{"text":"maaf hunnaan ittuma jabaataa deema?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ijoolle'ee fi akaakoti isaanii adoo isaan jiraranuu","poem":1},{"text":"fuula isaanii duratti guddatanee itti tolteen dhaggan","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isaan mana ifii keessa sodaa malee nageyaan le'an;","poem":1},{"text":"Waaqi isaan hin adabu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Horiin isaanii rakkoo tokko malee hora;","poem":1},{"text":"loon isaaniille rimeya gadha'aa hin gatanu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ijoollee ifii akka tika hoole'ee bobbaasan;","poem":1},{"text":"daa'immaan isaaniille hin burraaxxi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Isaan dibbe'ee fi maseenqo'oon","poem":1},{"text":"qoonqoo suusulle'eetiin","poem":2},{"lineBreak":true},{"text":"gammadanee hin sirban.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Isaan qananumma'aan bara ifii fixatan;","poem":1},{"text":"farra malee du'an.","poem":2}]},{"type":"verse","number":14,"content":["«Isaan Waaqaan,",{"text":"‹Nuuti karaa keeti beekuu hin feenu;","poem":2},{"lineBreak":true},{"text":"nu irraa fagaadhu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nuuti akka isa waaqonfannuuf","poem":1},{"text":"ka waan mara dande'u eennu inni?","poem":2},{"text":"Isa yoo daadimanne","poem":1},{"text":"bu'aa maan dhagganna?› jedhan.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Qananummaan isaanii","poem":1},{"text":"harkuma isaanii keessa jirtii motii ree?","poem":2},{"lineBreak":true},{"text":"Maarre ani yaada worra hama'aa hin fudhadhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«Issaan worra hama'aa","poem":1},{"text":"yennaa mara attam attam bada?","poem":2},{"lineBreak":true},{"text":"Farri yennaa maraa attam attam isaanitti dhutti?","poem":2},{"text":"Isaan yennaa mara adabbii mufii ifiitiin","poem":1},{"text":"attam attam farrane?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Isaan akka huura qilleensa dura jiruutii motii ree?","poem":1},{"text":"Akka cidii bubbe'een fudhatantuutii motii ree?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Isin ‹Waaqi yakkaa abbooti'iitiif","poem":1},{"text":"ijoollee hin adaba› jettan;","poem":2},{"lineBreak":true},{"text":"te'uu malee yakkaameyyiin","poem":2},{"lineBreak":true},{"text":"yakkaa ifii akka beekanuuf,","poem":2},{"lineBreak":true},{"text":"isaanunti adabamanuu ti.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Cubbaaleyyiin yakkaa ifiitiif adabamanuu ti;","poem":1},{"text":"Waaqi waan mara dande'u","poem":2},{"lineBreak":true},{"text":"mufii ifii isaanitti buusuu ti.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nami du'een duuba","poem":1},{"text":"marroo ijoollee ifiitiif","poem":2},{"lineBreak":true},{"text":"maanti isa dhiba?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Waaqa worra gugurda'attuu muru","poem":1},{"text":"nami beekkumsa isa barsiisuu dande'aa ree?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nami gariin adoo hunna qabuu","poem":1},{"text":"le'iin itti toltee nageyaan adoo jiruu,","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"nafi isaa adoo gabbinna qabuu,","poem":2},{"lineBreak":true},{"text":"lafee isaa keessa dhuki guuttee adoo jirtuu du'a.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nami dhibiin ammoo jiruun itti hadhoottee,","poem":1},{"text":"waan dansaa adoo hin dhaggin du'a.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Isaan lamaanuu du'anee awwaalamanee","poem":1},{"text":"corroxxille itti duuddi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"«Kunoo, ani yaada keessan,","poem":1},{"text":"mala isin na miidhiisaaf maltanelle","poem":2},{"lineBreak":true},{"text":"miidhassee beeka.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Isin, ‹Manni nama guddaa sanii meet ree?","poem":1},{"text":"Dunkaaniin worra hama'aa keessa meet ree?› jettan.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Isin worra karaa yaa'u hin gaafannee ree?","poem":1},{"text":"Waan isaan jedhanelle hin fudhannee ree?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Nama hamaa balaan yennaa dhufu","poem":1},{"text":"miidhaan isa hin dhaqqabu;","poem":2},{"lineBreak":true},{"text":"guyyaa mufii Waaqaalle jalaa hin baya.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Nama hamaa amala isaa ka isa duratti komatu,","poem":1},{"text":"hujii hantuu isaatiifille ka isa adabu eennu ree?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Yennaa inni du'e gara awwaalaa hin geessan.","poem":1},{"text":"Irreensi isaalle hin eegama.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Biyyeen dhooqa keessaa","poem":1},{"text":"isatti hin tolti.","poem":2},{"text":"Namooti bacaan isa duubaan deeman;","poem":1},{"text":"kolbaan bindillaalle isa dura deenti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"«Deebiin isin naaf kennitanu soba;","poem":1},{"text":"attamiin dubbii woy hin baaneen","poem":2},{"lineBreak":true},{"text":"na jajjabeessiisaaf wodhaantan ree?» jedhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JOB/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/20.json","previousChapterAudioLinks":{},"numberOfVerses":34}