{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":22,"content":[{"type":"heading","content":["Eliifaaz"]},{"type":"verse","number":1,"content":["Achiin duuba Eliifaaziin Temaanichi deebisee,"]},{"type":"verse","number":2,"content":[{"text":"«Nami Waaqaaf bu'aa qabaatuu dande'aa ree?","poem":1},{"text":"Nami qaroolle bu'aa ifumaaf buufata.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ati balchaa yoo teete, balchummaan teeti","poem":1},{"text":"Waaqa waan mara dande'u maan gammachiitti?","poem":2},{"text":"Karaan keeti ka komii hin qanne yoo te'e,","poem":1},{"text":"inni woy dhaggataa ree?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Ati Waaqa waan sodaattuuf","poem":1},{"text":"inni si xixee muraa si irratti fidee ree?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tun sababa hammeenni keeti guddatee,","poem":1},{"text":"cubbuun teeti bacatteefii motii ree?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ati sababa malee obboleeyyan teeti irraa","poem":1},{"text":"qaddii fudhatteerta;","poem":2},{"lineBreak":true},{"text":"namoota irraa woyaa mulqitee,","poem":2},{"lineBreak":true},{"text":"qullaa hamburteerta.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ati worra dheebotee dadhabeef","poem":1},{"text":"bisaan hin kennine;","poem":2},{"lineBreak":true},{"text":"worra beelowelle sagalee dhooggatteerta.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Latti ta worra hunnaameyyi'ii ti;","poem":1},{"text":"worra ulfinna qabutti isii irra le'a.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Haadhotii hiyyeessaa","poem":1},{"text":"harka duwwaa gad lakkitteerta;","poem":2},{"lineBreak":true},{"text":"ijoollee haadhaa fi abbaa hin qanneelle cunqursiteerta.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tanaaf tiyyoon si marsitee,","poem":1},{"text":"dedhuma sodaan si bararassite.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Akka ati dhagguu hin dandeenne","poem":1},{"text":"dukkanti si qaddee,","poem":2},{"lineBreak":true},{"text":"lolaan si liqinse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Waaqi ol-gubbaa olii keessa le'aa motii ree?","poem":1},{"text":"Urjoota ol fagoo jiranulle,","poem":2},{"lineBreak":true},{"text":"gad ilaalaa motii ree?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ati ammoo, ‹Waaqi maan beeka?","poem":1},{"text":"Dukkana dimmaatiin gara kaan jiraatee","poem":2},{"lineBreak":true},{"text":"natti muruu dande'aa?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Inni gonbobittii ol-gubba'aa irra yennaa deddeemu","poem":1},{"text":"duumensi hurrantaan waan isa golluuf","poem":2},{"lineBreak":true},{"text":"dhagguu hin dande'u› jetta.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ati karaa durii ka worri hamaan irra deddeeme","poem":1},{"text":"hordofaartaa ree?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Isaan adoo yennaan isaanii hin geyiinuu qoomamaneeran;","poem":1},{"text":"hundeen isaanii lola'aan haxowanteerti.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Isaan Waaqa waan mara dande'uun, ‹Nu irraa fagaadhu;","poem":1},{"text":"maan nuu godhuu dandeetta?› jedhane.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Te'uu malee isumattuu mana isaanii","poem":1},{"text":"waan dansa'aan guute;","poem":2},{"lineBreak":true},{"text":"tanaaf ani yaada worra hama'aa hin fudhadhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«Balchooti badii worra hamootaa dhagganee hin gammadan;","poem":1},{"text":"worri yakkaa hin qanne murgo'oof itti kollaa,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"‹Dhuguma diinni keenna badeera;","poem":1},{"text":"waan isaan irraa hafelle ibiddi fixeera› jedhan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«Iyoob, Waaqaan wolii galiitii","poem":1},{"text":"isa woliin nageya qabaadhu;","poem":2},{"lineBreak":true},{"text":"karaa kanaan waan dansaa hin dhaggatta.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Qajeelcha inni sii kennu fudhadhu;","poem":1},{"text":"jecha isaalle gadhaa keetitti qabadhu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ati gara Waaqa waan mara dande'uu yoo deebite,","poem":1},{"text":"akka duriititti hin deebita;","poem":2},{"lineBreak":true},{"text":"hammeenna dunkaanii teeti keessaa yoo fageessite,","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"worqii akka buku'uutitti,","poem":2},{"lineBreak":true},{"text":"worqii gatii guddo'oolle","poem":2},{"noteId":15},{"lineBreak":true},{"text":"akka rassaa bisaan keessaatitti yoo ilaalte,","poem":2}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Waaqi waan mara dande'u","poem":2},{"lineBreak":true},{"text":"worqi'ii fi meetii gatii guddo'oo siif hin te'a.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Achiin duuba ati","poem":1},{"text":"Waaqa waan mara dande'uun hin gammadda;","poem":2},{"lineBreak":true},{"text":"isalle'etti addattee hin leeta.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ati gara isaa hin daadimatta,","poem":1},{"text":"innille si'iif hin dhage'a;","poem":2},{"lineBreak":true},{"text":"atille waadaa keeti isaaf hin galchita.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Wonni ati murteeffatte siif hin teeti;","poem":1},{"text":"ifille karaa keetitti hin ifa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Waaqi worra kooru gad qaba;","poem":1},{"text":"worra ifi gad qabu ammoo hin fayyisa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Sababa ati yakkaa hin qanneef,","poem":1},{"text":"Waaqi worra yakkaameyyi'iiyyuu","poem":2},{"lineBreak":true},{"text":"adabbii jalaa hin baasa» jedhe.","poem":2}]}],"footnotes":[{"noteId":15,"caller":"+","text":"Worqii gatii guddo'oolle: Afaan Ibrootaatiin worqii Ofiiriille Jedha. Bara san worqii Ofiirii gatii guddo'oon bitatan.","reference":{"chapter":22,"verse":24}}]},"thisChapterLink":"/api/gax_twf/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}