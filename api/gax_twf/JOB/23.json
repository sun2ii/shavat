{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":23,"content":[{"type":"heading","content":["Iyoob"]},{"type":"verse","number":1,"content":["Achiin duuba Iyoob deebisee,"]},{"type":"verse","number":2,"content":[{"text":"«Ani iyyaa aadulle","poem":1},{"text":"dhowichi isaa waan natti jabaateef,","poem":2},{"lineBreak":true},{"text":"haga ammaa gadhaan kiyya","poem":2},{"lineBreak":true},{"text":"gadda hama'aa fi gungussu'uun guutameera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Addee isa itti dhaggu adoo beeke,","poem":1},{"text":"gara addee inni le'uu dhaqee,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"silaa iyyata kiyya isatti dhikeeffadhee,","poem":2},{"lineBreak":true},{"text":"afaan kiyya guutadhee isatti hin dubbadhaayyu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Waan inni naaf deebisu","poem":1},{"text":"sila hin beekaayyu","poem":2},{"lineBreak":true},{"text":"waan inni naan jedhulle","poem":2},{"lineBreak":true},{"text":"sila hin hubadhaayyu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Waaqi hunna ifii guddo'oon","poem":1},{"text":"na morminnaa laati?","poem":2},{"text":"Waawwo'o! Inni naaf hin dhage'a.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Achitti nami qajeelaan haajaa ifii","poem":1},{"text":"Waaqa duratti dhikeeffata;","poem":2},{"lineBreak":true},{"text":"Waaqi abbaan mura'aa kiyyalle","poem":2},{"lineBreak":true},{"text":"haga bara baraa bilisa na hin baasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Ani gara aduun baatu yoo dhaqe","poem":1},{"text":"inni achi hin jiru.","poem":2},{"text":"Gara aduun seentulle yoo deebi'e,","poem":1},{"text":"isa dhagguu hin dandeenne.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yennaa inni gara kaabaatiin huju","poem":1},{"text":"ani isa dhagguu hin dande'u.","poem":2},{"text":"Yennaa inni gara kibbaallee deebi'uu","poem":1},{"text":"ani isa dhagguu hin dande'u.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Inni ammoo karaa ani deemu mara hin beeka;","poem":1},{"text":"yennaa inni haga na ilaalu","poem":2},{"lineBreak":true},{"text":"akka worqi'ii qulqulluu te'eeruun na dhagga.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Miilli kiyya faana isaa gula deema;","poem":1},{"text":"karaa isaa irraa asii fi achi hin goru.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ajaja afaan isaatii bawu irraa,","poem":1},{"text":"ani hin fagaanne;","poem":2},{"lineBreak":true},{"text":"jecha isaalle gadhaa kiyyatti qabadheera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Waaqi hin jijjiiramu;","poem":1},{"text":"eennulle isa mormuu hin dande'u;","poem":2},{"lineBreak":true},{"text":"inni waan fedhe godha.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Inni waan naaf yaade mara hin muummessa;","poem":1},{"text":"wonni hedduun akkasii qalbii isaa keessa jirti.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tanaaf ani isa duratti hin bararaqa;","poem":1},{"text":"yennaa waan kana mara hedu isa sodaadha.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Waaqi na sodaachise;","poem":1},{"text":"ka waan mara dande'u na bararasse.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Te'uu malee ani dukkanaan,","poem":1},{"text":"dukkana dimma fuula kiyya gollite saniin hin cadhinne.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}