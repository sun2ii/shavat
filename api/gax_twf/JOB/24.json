{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"«Waaqi waan mara dande'u","poem":1},{"text":"guyyaa mura'aa maaf hin murteessin?","poem":2},{"text":"Worri isa beekanu","poem":1},{"text":"guyyaa mura'aa san maaf hin dhaggin?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Worri hamaan beessisa meessa'aa balleessa;","poem":1},{"text":"isaan hoolee hatane bobbaafatan.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Harree ijoollee haadhaa fi abbaa hin qannee","poem":1},{"text":"oofatanee deeman;","poem":2},{"lineBreak":true},{"text":"qotiyyoo haadha hiyyeessaa","poem":2},{"lineBreak":true},{"text":"qaddi'iif fudhatan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isaan hiyyeeyyii karaa irraa hin ari'an;","poem":1},{"text":"hiyyeeyyiin lafa irraa marti","poem":2},{"lineBreak":true},{"text":"isaan duraa hin baqatan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hiyyeeyyiin akka harree diidaa goomolee keessa","poem":1},{"text":"ijoollee ifiitiif sagalee barbaassa","poem":2},{"lineBreak":true},{"text":"lafa goomole'ee keessa daddaaqan.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isaan fichaa nama dhibi'ii keessaa","poem":1},{"text":"okeya hin haammatan;","poem":2},{"lineBreak":true},{"text":"oorruu woyni'ii ta worra hama'aa keessalle'ee","poem":2},{"lineBreak":true},{"text":"woxoo qocatan.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Halkan guutuu qullaa bulan;","poem":1},{"text":"boojji'iif'ille waan ifi irra buufatanu hin qabanu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bokkeya gaara irra roobuun hin tortoran;","poem":1},{"text":"waan jalatti qophatanu dhabanee","poem":2},{"lineBreak":true},{"text":"rassa'atti maxxananee bulan.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Worri hamaan daa'ima abbaa hin qanne","poem":1},{"text":"harma irraa butanee garboonfatan;","poem":2},{"lineBreak":true},{"text":"daa'ima hiyyeessaa qaddii godhatan.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hiyyeeyyiin woyaa malee qullaa ifii deeman;","poem":1},{"text":"isaan laddee hin ba'atan ammoo hin beelowan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tarree fichaa worra hamoole'ee oddu'utti","poem":1},{"text":"zayitii ejersaa hin cunfan;","poem":2},{"lineBreak":true},{"text":"unkuruura woyni'ii irralle'ee","poem":2},{"lineBreak":true},{"text":"daadhii woyni'ii hin cunfan;","poem":2},{"lineBreak":true},{"text":"isaan ammoo hin dheebotan.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Qachoota gugurdaa keessaa worri du'u hin aadan;","poem":1},{"text":"worri madowanelle qarqaaramiisaaf hin iyyan;","poem":2},{"lineBreak":true},{"text":"Waaqi ammoo daadimata isaanii hin caqanne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Worri ifa jibbu,","poem":1},{"text":"worri karaa ifaa hin beenne,","poem":2},{"lineBreak":true},{"text":"yookiin daandii ifaa irralle hin turre jiran.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nami nama ijjeesu fuullee bari'iitiin ka'ee,","poem":1},{"text":"hiyyeeyyi'ii fi worra rakkate hin ijjeesa;","poem":2},{"lineBreak":true},{"text":"halkanille akka hattu'uu hata.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nami gaarayyeeffatu lafa dhiitu eegata;","poem":1},{"text":"eennulle akka isa hin dhaggineef","poem":2},{"lineBreak":true},{"text":"fuula ifii hin hagooggata.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hattuun halkan qottee seenti;","poem":1},{"text":"guyyaa ammoo dhokaata oolti;","poem":2},{"lineBreak":true},{"text":"ifaan waan tokkolle godhuu hin barbaaddu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dukkanaan bararassiisi waan isaan gammachiittuuf,","poem":1},{"text":"dukkanti dimmi isaaniif ganama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«Worri hamaan akka hoomacha bisaan irraa,","poem":1},{"text":"yennaa diqqoo qofaaf mudhatan.","poem":2},{"text":"Qoodi lafa isaanii ta abaarante waan teeteef,","poem":1},{"text":"namuu gara fichaa woynii isaanii hin dhaqu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"O'ii fi caami","poem":1},{"text":"dhakaa bokkeyaa ka baqe akkuma balleessu","poem":2},{"lineBreak":true},{"text":"qileen awwaala jalaalle cubbaaleyyii akkasuma gooti.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Haadhotiin isaanii isaan hin deeti;","poem":1},{"text":"corroxxille isaan hin nyaatti;","poem":2},{"lineBreak":true},{"text":"namuu isaan hin qaabatu;","poem":2},{"lineBreak":true},{"text":"worri hamaan akka mukaa hin caccaba.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Isaan dubartii deya hin qanne hin cunqursan;","poem":1},{"text":"haadha hiyyeessaatiifille waan dansaa hin godhanu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Waaqi ammoo hunna ifiitiin","poem":1},{"text":"worra hunnaameyyii hin balleessa.","poem":2},{"text":"Le'iin isaanii ta tolte fakkaatulle,","poem":1},{"text":"jiruu addachiittu hin qabanu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Waaqi akka isaan nageyaan le'anu lakkisulle,","poem":1},{"text":"karaa isaan deemanu hubatee hin ilaala.","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Worri hamaan yennaa diqqo'oof hin jajaman;","poem":2},{"lineBreak":true},{"text":"achiin duuba ammoo","poem":2},{"lineBreak":true},{"text":"akkuma daraara'aa qooranee hin badan;","poem":2},{"lineBreak":true},{"text":"akka midhaaniille hin haamaman.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"«Yoo akkas hin te'in","poem":1},{"text":"ani dharaamessa akka te'ee fi","poem":2},{"lineBreak":true},{"text":"wonni ani dubbadhe sirrii akka hin te'in","poem":2},{"lineBreak":true},{"text":"ka mirkaneessu eennu ree?» jedhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JOB/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}