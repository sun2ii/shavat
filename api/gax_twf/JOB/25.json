'oo fa'a,","poem":1},{"text":"attam attam caalaa diqqaata ree!» jedhe.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}