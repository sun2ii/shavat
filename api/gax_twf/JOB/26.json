{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":26,"content":[{"type":"heading","content":["Iyoob"]},{"type":"verse","number":1,"content":["Achiin duuba Iyoob deebisee,"]},{"type":"verse","number":2,"content":[{"text":"«Ati nama hunna hin qanne","poem":1},{"text":"attam attam qarqaarte!","poem":2},{"text":"Nama dadhabaalle","poem":1},{"text":"attam attam jabeessite!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ati nama qaroo hin te'in","poem":1},{"text":"attam attam gorsite!","poem":2},{"lineBreak":true},{"text":"Beekkumsalle attam attam kenniteef!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tana akka dubbattu ka si qarqaare eennu?","poem":1},{"text":"Ayyaana eennuutitti afaan keeti keessaa dubbate?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Ekeraan abbaaya'aan jalatti","poem":1},{"text":"rorommiisatti jirti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Addeen worri du'e jiru","poem":1},{"text":"Waaqa duratti guutumatti mudhatti;","poem":2},{"lineBreak":true},{"text":"wonni takkaalle isii hin gollitu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Waaqi gubbaa gara kaabaa addee duwwaa irratti diriirse;","poem":1},{"text":"lafaalle womaa adoo jala hin jiraatin rarraase.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Waaqi duumensa keessatti bisaan kipha;","poem":1},{"text":"duumensille ulfaatiisa bisaaniitiin hin tarsa'u.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inni barcumaa mootummaa ifii","poem":1},{"text":"duumensa ifii diriirsee hin golla.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Waaqi ifaa fi dukkana gargar baasiisaaf,","poem":1},{"text":"bisaan irratti naannessee meessaa godheera.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yennaa inni xixu","poem":1},{"text":"utubooti ol-gubba'aa soda'aan hin raafaman.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Inni hunna ifiitiin","poem":1},{"text":"abbaayaa hin sarmisiisa,","poem":2},{"lineBreak":true},{"text":"qarummaa ifiitiin bineensa guddaa abbaayaa keessaa ka, ‹Rahaab› jedhamu hin kukkuta.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Inni hafuura ifiitiin ol-gubbaa qulqulleessee,","poem":1},{"text":"harka ifiitille'een jawwee lowiisatti jirtu woraane.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kun duudiin waan Waaqi huju keessaa diqqo'o;","poem":1},{"text":"nuuti hasaassaa isaa qofa dhageenna;","poem":2},{"lineBreak":true},{"text":"mandiisuu hunna isaa eentu hubatuu dande'a ree?» jedhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}