{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":27,"content":[{"type":"heading","content":["Iyoob"]},{"type":"verse","number":1,"content":["Ammalle Iyoob dabalee,"]},{"type":"verse","number":2,"content":[{"text":"«Dhugaa Waaqa jiraataa waan mara dande'uu","poem":1},{"text":"ka haqa kiyya na dhooggatee,","poem":2},{"lineBreak":true},{"text":"jiruu tiyya natti hadheessee,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"haga lubbu'uun jiru","poem":2},{"lineBreak":true},{"text":"hafuurri Waaqi na keessa keye haga na keessa jiru,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"hantuun afaan kiyya keessaa hin baatu;","poem":2},{"lineBreak":true},{"text":"arrabi kiyyalle soba hin dubbatu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ani ijjumaa isiniin sirri'i hin jedhu;","poem":1},{"text":"haga du'a tiyyaatitti yakkaa malee le'uu irraa hin goru.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Balchummaa tiyyatti hin jabaadha'a;","poem":1},{"text":"gad hin lakkisulle'e;","poem":2},{"lineBreak":true},{"text":"bara le'ii tiyyaa","poem":2},{"lineBreak":true},{"text":"wodanaan kiyya waan kanatti hin gaabbu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Diinni kiyya akka worra hama'aa,","poem":1},{"text":"worri na mormu","poem":2},{"lineBreak":true},{"text":"akka worra balchaa hin te'inii te'uu ti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yennaa Waaqi isaan balleessu","poem":1},{"text":"yennaa inni lubbuu isaan keessaa baasu","poem":2},{"lineBreak":true},{"text":"addiin worra Waaqa malee le'uu","poem":2},{"lineBreak":true},{"text":"maan te'itti laati?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yennaa rakkinni isaanitti dhufu","poem":1},{"text":"Waaqi iyya isaanii hin dhage'aa ree?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Isaan Waaqa waan mara dande'utti","poem":1},{"text":"hin gammadanii ree?","poem":2},{"lineBreak":true},{"text":"Yennaa mara Waaqa hin waammatanii ree?","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Ani marroo hunna Waaqaa isin barsiisa;","poem":1},{"text":"karoora Waaqa waan mara dande'uulle","poem":2},{"lineBreak":true},{"text":"ani isin hin dhossu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Isin martinuu tana dhaggitaneertan;","poem":1},{"text":"eegasuu waan bu'aa hin qanne maaf dubbattan ree?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Qoodi nami hamaan","poem":1},{"text":"Waaqa irraa dhaggatu,","poem":2},{"lineBreak":true},{"text":"dhaalli nami nama cunqursu","poem":2},{"text":"Waaqa waan mara dande'u irraa fudhatu,","poem":1},{"text":"ka asii gad jiru:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ijoolleen isaa yoo heddattelle","poem":1},{"text":"shallaaga'aan dhumatti;","poem":2},{"lineBreak":true},{"text":"sanyiin isaalle sagalee quuttee nyaattu hin qabaattu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Worri baraareen hafe dhukkubaan dhumata;","poem":1},{"text":"haadhotiin hiyyeessaa isaaniille","poem":2},{"lineBreak":true},{"text":"isaaniif hin boottu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Worri hamaan meetii akka biyye'ee tuulee,","poem":1},{"text":"woyaalle akkuma faara biyye'ee","poem":2},{"lineBreak":true},{"text":"wol irra naquu dande'a fa'a.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Waan isaan tuulatane san ammoo,","poem":1},{"text":"worra balcha'attuu uffata;","poem":2},{"lineBreak":true},{"text":"worri yakkaa hin qannelle meetii hin qoqoodaman.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Manni isaan ijaaranu akka mana saaphuphu'uutii fi","poem":1},{"text":"akka gosee nama midhaan eeguu ti.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Worri hamaan dureessa te'ee hin rafa,","poem":1},{"text":"ammoo itti hin deebi'anu;","poem":2},{"lineBreak":true},{"text":"yennaa isaan dammaqanu,","poem":2},{"lineBreak":true},{"text":"karri isaanii marti baddeerti.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bararaqi akka lola'aa isaan irra yaa'a;","poem":1},{"text":"halkan hobonbolattiin isaan fudhattee deenti.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Qilleensi gara aduun baatuu","poem":1},{"text":"isaan fuudhee deema;","poem":2},{"lineBreak":true},{"text":"isaanille hin dhaggamanu;","poem":2},{"lineBreak":true},{"text":"addee isaanii irraa haxowee isaan balleessa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Isaan hunna qilleensa sanii jalaa bayiisaaf wodhaananulle,","poem":1},{"text":"marartii malee bira itti dabara.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Qilleensi isaan irratti harka dhowee","poem":1},{"text":"addee jiru irralle'ee isaanitti siissa","poem":2},{"noteId":16},{"text":".","poem":2}]}],"footnotes":[{"noteId":16,"caller":"+","text":"Siissa: Lafa tokko tokkotti fiissa jedhan.","reference":{"chapter":27,"verse":23}}]},"thisChapterLink":"/api/gax_twf/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}