{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":28,"content":[{"type":"heading","content":["Wolaloo Marroo Qarumma'aa"]},{"type":"verse","number":1,"content":[{"text":"«Dhuguma boolli meetii keessaa qotanee baasanu,","poem":1},{"text":"addeen worqii itti baqsiisanu jirti.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sibiilli lafa keessaa dhaggama;","poem":1},{"text":"sibiilli diimaalle biyyee albuudaa keessaa","poem":2},{"lineBreak":true},{"text":"baqisiifamee dhaggama.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Namooti qilee lafaa keessa seenanee","poem":1},{"text":"dukkana dimmaa keessa lixanee","poem":2},{"lineBreak":true},{"text":"biyyee albuudaa barbaadan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isaan lafa nami le'u irraa fagaatanee,","poem":1},{"text":"addee miilli namaa ijjattee hin beenne geyan.","poem":2},{"text":"Achitti boolla qilee qotanee","poem":1},{"text":"wodaroo irratti rarra'aa","poem":2},{"lineBreak":true},{"text":"nama irraa fagaatanee qofuu ifii hujan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Latti midhaan sagalee te'u baattu,","poem":1},{"text":"keessi isi'ii ammoo ibiddaan baqee garagaggala.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Rassaa isi'ii keessaa","poem":1},{"text":"dhakaan gatii guddo'oo","poem":2},{"lineBreak":true},{"text":"ka ‹Safiiros› jedhamu dhaggama;","poem":2},{"lineBreak":true},{"text":"biyyee isi'ii keessalle'ee worqiin hin dhagganti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Karaa gara albuudaa geessu san risaan hin beeku;","poem":1},{"text":"ilti jajju'uulle hin dhaggine.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bineensi hamaan addee san hin ijjanne;","poem":1},{"text":"neenqille karaa san hin dabarre.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Harki nama albuuda qotuu","poem":1},{"text":"rassaa jabaa hin caccassa;","poem":2},{"lineBreak":true},{"text":"gaarotalle hundee irraa garaggaggalcha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Isaan rassaa dhoosanee karaa hin baasan;","poem":1},{"text":"ilti isaaniille waan gatii guddo'oo hin dhaggiti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Madda lagaa hin kiphan;","poem":1},{"text":"waan lafa keessatti dhokatelle ifatti hin baasan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Ammoo qarummaan eessatti dhagganti?","poem":1},{"lineBreak":true},{"text":"Addeen hubanti'ii eessa jirti?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Qarummaan lafa nami le'u keessatti hin dhaggantu;","poem":1},{"text":"namille gatii isi'ii hin beeku.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Qileen abbaaya'aa,","poem":1},{"text":"‹Qarummaan na keessa hin jirtu› jetti;","poem":2},{"lineBreak":true},{"text":"abbaayaalle, ‹Qarummaan na bira hin jirtu› jetti.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Qarummaan worqii qullu'uun hin bitantu;","poem":1},{"text":"gatiin isi'iille meeti'iin hin madaalantu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Gatiin isi'ii worqii gatii guddo'ootiin,","poem":1},{"text":"dhakaa ‹Sardoniikis","poem":2},{"noteId":17},{"text":"› jedhamuun","poem":2},{"lineBreak":true},{"text":"yookiin dhakaa, ‹Safiiros› jedhamuun wol hin qixxawu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Worqi'ii fi daaw'itiille'een","poem":1},{"noteId":18},{"text":"wol hin qixxoottu.","poem":2},{"text":"Dooqa worqii qullu'uulle'een","poem":1},{"text":"hin jijjiirantu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Gatiin qarumma'aa dooqa gatii guddo'ootii fi","poem":1},{"text":"dhakaa gatii gudda'ootiin wol hin qixxoottu;","poem":2},{"lineBreak":true},{"text":"elellaan diintuulle","poem":2},{"noteId":19},{"text":"caalti.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Qarummaan dhakaa gatii guddo'oo ka Itoophiya'aa","poem":1},{"noteId":20},{"text":",","poem":1},{"text":"ka ‹Xophaaziyon› jedhamuun wol hin qixxoottu;","poem":2},{"lineBreak":true},{"text":"worqii qulluu gatii guddo'oolle'een wol hin qixxoottu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«Eegasuu qarummaan eessaa dhutti ree?","poem":1},{"lineBreak":true},{"text":"Addeen hubantiin jirtu eessa ree?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Isiin ila dada maraa duraa dhokatteerti;","poem":1},{"text":"sinbirrootaayyuu dhokatteerti.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Badi'ii fi duuti,","poem":1},{"text":"‹Nuuti oduu isi'ii qofa","poem":2},{"lineBreak":true},{"text":"gurra keennaan dhageenne› jedhan.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Waaqi karaa gara qarumma'aa geessu hin hubata;","poem":1},{"text":"addee isiin jirtulle isa qofattuu beeka.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Inni qaccee lafaa duudii waan dhagguuf,","poem":1},{"text":"waan ol-gubba'aan jala jiru mara dhagga.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Waaqi yennaa qilleensaaf hunna kenne,","poem":1},{"text":"haga bisaaniille yennaa mike","poem":2},{"noteId":21},{"text":",","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bokkeyaaf seera,","poem":1},{"text":"balaqqeetti'iifille karaa yennaa baase,","poem":2}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"achiin duuba qarummaa ilaalee,","poem":2},{"lineBreak":true},{"text":"gatii isi'ii murteesse;","poem":2},{"lineBreak":true},{"text":"inni isii qorqoree jabeessee isii dhaabe.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Achiin duuba inni namaan,","poem":1},{"text":"‹Kunoo, Mootii Waan Maraa sodaatiis qarumma'a;","poem":2},{"lineBreak":true},{"text":"waan hantuu irraa goriisille hubanti'i› jedhe» jedhe.","poem":2}]}],"footnotes":[{"noteId":17,"caller":"+","text":"Sardoniikis: Dhakaa gatii guddoo qabu.","reference":{"chapter":28,"verse":16}},{"noteId":18,"caller":"+","text":"Daaw'itii: Bara durii gatiin daaw'iti'ii akka malee guddo'o.","reference":{"chapter":28,"verse":17}},{"noteId":19,"caller":"+","text":"Elellaan diintuu: Bara durii elellaan gatii guddoo qaddi","reference":{"chapter":28,"verse":18}},{"noteId":20,"caller":"+","text":"Itoophiyaa: Yaadannoo Dad. 2:13 irratti kenname ilaali.","reference":{"chapter":28,"verse":19}},{"noteId":21,"caller":"+","text":"Mike: Wodaro'oon yookiin ciqile'een haga waan tokkoo beekiisaaf laakkowiisa.","reference":{"chapter":28,"verse":25}}]},"thisChapterLink":"/api/gax_twf/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}