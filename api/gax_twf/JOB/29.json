{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":29,"content":[{"type":"heading","content":["Dubbii Iyoobii Ta Dhumarraa"]},{"type":"verse","number":1,"content":["Iyoob ammalle dubbatee,"]},{"type":"verse","number":2,"content":[{"text":"«Le'iin tiyya ta ammaa","poem":1},{"text":"ta akka yennaa Waaqi dur na eegee","poem":2},{"lineBreak":true},{"text":"adoo teete ani attam fedhaayyu!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yennaa ifi isaa mataa kiyya irratti ife,","poem":1},{"text":"dukkana keessa ani ifa isaatiin ideeme.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yennaa bara qananummaa tiyyaa","poem":1},{"text":"yennaa eeddoon Waaqaa","poem":2},{"lineBreak":true},{"text":"dunkaana tiyya irra jirtu,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"yennaa Waaqi waan mara dande'u na woliin jiru,","poem":2},{"lineBreak":true},{"text":"yennaa ijoolleen tiyya na marsiteertu,","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"yennaa ani aananiin miila kiyya dhiqadhe,","poem":2},{"lineBreak":true},{"text":"yennaa rassaan zayitii ejersaa naaf madde,","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"yennaa ani gara seensuma karra qacha'aa dhaqe,","poem":2},{"lineBreak":true},{"text":"yennaa ani addee wolgeyi'ii san tee'e,","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"dargaggooti na dhagganee karaa irraa gorane;","poem":2},{"lineBreak":true},{"text":"jaarsoleelle kaatee dhaabbatte.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sooreyyiin kolba'aalle dubbatuu lakkittee,","poem":1},{"text":"afaan qabatte.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Qoonqoon qondaaltotaa cadhittee,","poem":1},{"text":"arrabi isaaniille laagadaa isaaniititti maxxane.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ka na dhage'e duudiin na jaje;","poem":1},{"text":"ka na dhaggelle duudiin na galateeffate.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sababille ani worra hiyyeeyyii iyyu,","poem":1},{"text":"rakkoo jalaa baasee,","poem":2},{"lineBreak":true},{"text":"ijoollee abba'aa fi haadha hin qannelle qarqaareera.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Worri du'iisaaf dhikaate na eebbiseera;","poem":1},{"text":"qarqaarsi ani godhe,","poem":2},{"lineBreak":true},{"text":"gadhaa haadhotii hiyyeessaa gammachiiseera.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ani balchummaa akka woya'aa uffadhe;","poem":1},{"text":"muraa dhuga'aalle akka geella'aa uffadhee,","poem":2},{"lineBreak":true},{"text":"akka marata mata'aalle maradhe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ani worra balla'aaf ila,","poem":1},{"text":"worra naafafille miila te'eeraayyu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ani hiyyeeyyi'iif akka abba'aa te'ee,","poem":1},{"text":"alaga'aafille wobii te'eeraayyu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ani a'oo nama hama'aa cassee,","poem":1},{"text":"waan inni butatelle afaan isaa irraa buuseera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«Achiin duuba ani,","poem":1},{"text":"‹Barri kiyya akka maansaa bacatee,","poem":2},{"lineBreak":true},{"text":"manuma kiyya keessatti hin du'a.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ani akka muka hidda gara bisaanii yaafatee,","poem":1},{"text":"halkan guutuulle fixeensi damee isaa irra jiruu ti.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ulfinni kiyya yennaa mara haareya te'ee hin jiraata;","poem":1},{"text":"Hunni tiyyalle yennaa mara guubee haareya› jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«Namooti miidhassanee na caqasane;","poem":1},{"text":"gorsa kiyyalle dhage'iisaaf cadhisane.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ani dubbadheen duuba,","poem":1},{"text":"isaan deebi'anee hin dubbanne;","poem":2},{"lineBreak":true},{"text":"dubbiin tiyya gurra isaaniititti coxxe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Isaan akka nama bokkeya eegatuu na eegatane;","poem":1},{"text":"akka nama bokkeya furmaataa eegatuu","poem":2},{"lineBreak":true},{"text":"afaan ifii bananee dubbii tiyya eegatan.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yennaa isaan ifi addii dhabane","poem":1},{"text":"ani isaanitti seeqadhe;","poem":2},{"lineBreak":true},{"text":"ifi fuula kiyyaalle isaan jajjabeesse.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ani karaa isaaniif filee","poem":1},{"text":"bulchaa isaaniif te'e.","poem":2},{"text":"Akka mooticha loltoota ifii odduu le'uu,","poem":1},{"text":"odduu isaanii le'e.","poem":2},{"text":"Akka nama worra gadde jajjabeessuu,","poem":1},{"text":"isaan jajjabeesse.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JOB/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/28.json","previousChapterAudioLinks":{},"numberOfVerses":25}