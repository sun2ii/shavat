{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":3,"content":[{"type":"heading","content":["Iyoob Guyyaa Itti Dhalate Abaare"]},{"type":"verse","number":1,"content":["Tanaan duuba Iyoob dubbatiisa jalqabe; inni guyyaa itti dhalate abaaree,"]},{"type":"verse","number":2,"content":[{"text":"«Halkan ani itti dadame,","poem":1},{"text":"guyyaan ani itti dhaladhelle","poem":2},{"lineBreak":true},{"text":"ka abaarame te'uu ti!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Guyyaan sun gara dukkanaa jijjiiramuu ti.","poem":1},{"text":"Waaqi ol-gubba'aa isa hin yaadatin;","poem":2},{"lineBreak":true},{"text":"ifille isa irratti hin ifin.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dimimmisaa fi dukkanti dimmi,","poem":1},{"text":"‹Ati keenna› isaan jedhanuu ti.","poem":2},{"text":"Duumensi isa irratti bu'ee,","poem":1},{"text":"dukkanti ifa isaa gollituu ti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Halkan san dukkanti dimmi gollituu ti;","poem":1},{"text":"guyyoota wogga'aa keessatti hin laakkowamin;","poem":2},{"lineBreak":true},{"text":"laakkossa ji'aalle'etti hin galin.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Halkan sun maseena te'uu ti;","poem":1},{"text":"ililleettiille hin dhage'amin.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Worri guyyaa abaaru,","poem":1},{"text":"bineensa naacha fakkaatu","poem":2},{"lineBreak":true},{"text":"ka, ‹Lewaataan› jedhamu kakkaasiisaaf qophowelle","poem":2},{"lineBreak":true},{"text":"halkan san abaaruu ti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bakkalchi bari'ii ka halkan sanii dukkanoottuu ti.","poem":1},{"lineBreak":true},{"text":"Halkan sun addi'iin ifa eegatuu ti,","poem":1},{"text":"ammoo hin dhaggatin;","poem":2},{"lineBreak":true},{"text":"boruulle hin dayya'iniif.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Guyyaan sun rakkinna ila tiyya duraa dhossiisaaf,","poem":1},{"text":"balbala gadaamessa haadha tiyyaa,","poem":2},{"lineBreak":true},{"text":"waan hin cufiniif ka abaarame te'uu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Ani maaf gadaamessa haadha tiyyaa keessatti hin du'in?","poem":1},{"lineBreak":true},{"text":"Gadaamessa keessaa yennaa bayelle","poem":1},{"text":"maaf hin badin?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Haati tiyya maaf gudeeda ifii irra keyatte?","poem":1},{"text":"Harma ifiille maaf na hoositte?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sila amma nageyaan irkadhee,","poem":1},{"text":"rafee hin foorfadhaayyu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Moototaa fi gorsitoota lafaa","poem":1},{"text":"worra addee ifiif ijaarratanee","poem":2},{"lineBreak":true},{"text":"isaan duraa diigante woliin,","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"sooreyyii gugurdoo worra worqi'ii fi meeti'iin","poem":2},{"lineBreak":true},{"text":"mana ifii guutatane woliin sila hin foorfadhaayyu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yookiin ani maaf","poem":1},{"text":"akka finna du'ee dhalatee awwaalamee,","poem":2},{"lineBreak":true},{"text":"ka ijjumaa ifa hin dhagginii hin te'in?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Awwaala keessatti worri hamaan","poem":1},{"text":"hammeenna ifii hin lakkisa;","poem":2},{"lineBreak":true},{"text":"ka dadhabanelle achitti hin foorfatan.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Worri booji'ame","poem":1},{"text":"achitti nageya dhaggatan;","poem":2},{"lineBreak":true},{"text":"qoonqoo worra hunnaan isaan hujisiisuulle hin dhage'anu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«Worri didiqqa'aa fi gugurdaan","poem":1},{"text":"addee takka'atti dhaggaman.","poem":2},{"text":"Garbootille goottota ifii jalaa","poem":1},{"text":"achitti bilisa hin bayan.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Worra rakkoo hantuu keessa jiruuf ifi,","poem":1},{"text":"worra le'iin itti hadhootteef","poem":2},{"lineBreak":true},{"text":"jiruun maaf kennanti?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Worra du'a halchee,","poem":1},{"text":"ka karra dhoffante qotee barbaadu caalaa","poem":2},{"lineBreak":true},{"text":"ka du'a barbaaduuf","poem":2},{"lineBreak":true},{"text":"jiruun maaf kennantii?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Worra awwaala bira yennaa gewu ilillisuuf","poem":1},{"text":"jiruun maaf kennanti?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nama karaan duraa dhoffameef,","poem":1},{"text":"ka Waaqi karaa itti cufeef,","poem":2},{"lineBreak":true},{"text":"ifi maaf kennamaaf?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Gaddi kiyya akkuma sagale'ee naaf dhufa;","poem":1},{"text":"aadiis kiyya akkuma bisaanii dhangala'a.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Wonni ani sodaadhe natti dhutte;","poem":1},{"text":"wonni na naasiselle na irratti te'e.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ani raafama malee","poem":1},{"text":"nageyaa hin qabu, miira hin qabu,","poem":2},{"lineBreak":true},{"text":"fooralle hin qabu» jedhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":25}