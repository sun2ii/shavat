{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":[{"text":"«Amma ammoo worri gannaan anaa gadii natti murga;","poem":1},{"text":"ani abbootii isaanii saree tika hoolee tiyyaa eeddu woliinuu","poem":2},{"lineBreak":true},{"text":"akka hin teenneef ta tuffadheeru.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hunni isaanii waan dhumatteertuuf","poem":1},{"text":"maan naa bayan?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dhabaa fi beela irraa ta kaate","poem":1},{"text":"goomolee nami keessa hin leene","poem":2},{"lineBreak":true},{"text":"lafa godduu keessa halkaniin daaqane.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isaan baala goomole'ee ka kuraawu guuratane;","poem":1},{"text":"hidda muka hadhowuulle nyaatane.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isaan kolbaa keessaa ari'amane;","poem":1},{"text":"akkuma hattu'utti iyyanu namooti isaanitti iyyane.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Goda bowwaa keessaa","poem":1},{"text":"rassaa oddu'uu fi boolla lafa jalaa keessa","poem":2},{"lineBreak":true},{"text":"le'iis dirqama itti teete.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Isaan odduu tuse'eetii akka harre'ee baroodane;","poem":1},{"text":"badda jalalle'etti wolitti qabamane.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Isaan worra bu'aa hin qanne, ka maqaa badee","poem":1},{"text":"lafa irraa ari'ame.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Isaan sirbaan natti murgan;","poem":1},{"text":"odduu isaaniitille'etti ka mammaassaa te'eera.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Isaan na jibbanee na irraa fagaatan;","poem":1},{"text":"itti qaanii malee fuula kiyyatti tufan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Waaqi hunna tiyya laaffisee","poem":1},{"text":"waan gad na qabeef,","poem":2},{"lineBreak":true},{"text":"akka farda bixaalli irraa bu'ee","poem":2},{"lineBreak":true},{"text":"waan fedhane na godhane.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Gara midda kiyyaatiin worri nama jeequ ka'e;","poem":1},{"text":"isaan miila kiyyaaf tiyyoo afanee","poem":2},{"lineBreak":true},{"text":"badii naaf qopheessane.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Isaan karaa natti cufanee","poem":1},{"text":"na balleessiisa barbaadan;","poem":2},{"lineBreak":true},{"text":"nami na qarqaarulle hin jiru.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Isaan akka lola'aa dalleya kiyya uranee seenane;","poem":1},{"text":"waan mara caccassaa natti dhufane.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ani guddoo sodaadheera;","poem":1},{"text":"ulfinni kiyya akka waan qilleensi fudhateetitti","poem":2},{"lineBreak":true},{"text":"na irraa haxowameera;","poem":2},{"lineBreak":true},{"text":"fayyinni kiyya akka duumensaa dabareera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«Amma lubbuun tiyya na keessaa bayaarti;","poem":1},{"text":"guyyooti farraalle na qabataneeran.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Halkan lafeen tiyya na bocci;","poem":1},{"text":"dhukkubiin na boccu foora naa hin kennitu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Waaqi hunna ifii guddo'oon","poem":1},{"text":"woyaa tiyya shuntuurachiiseera;","poem":2},{"lineBreak":true},{"text":"akka woyaa morma dhipho'oo na hudheera.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Waaqi dhoqqee keessatti na gate;","poem":1},{"text":"anille akka buku'uutii fi daadha'a te'e.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«Ee Waaqa, ani si waammadhe,","poem":1},{"text":"ati ammoo naaf hin deebinne.","poem":2},{"text":"Ani dhaabbadhee gara keeti daadimadhe;","poem":1},{"text":"ati ammoo cadhittee na ilaalte.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ati gadhaa natti jabaattee","poem":1},{"text":"hunna teeti guddo'oon na miite.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ati ol na fuutee qilleensa irra teessitte;","poem":1},{"text":"bubbee keessa asii fi achi na hafarsite.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Gara du'aa","poem":1},{"text":"addee worri jiru duudiin du'ee itti galutti","poem":2},{"lineBreak":true},{"text":"akka ati na geessitu ani hin beeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"«Ani akka mana jigee ti;","poem":1},{"text":"eentu deebisee na ijaara ree?","poem":2},{"lineBreak":true},{"text":"Adoo ani ijjumaa jigee hin badin","poem":2},{"lineBreak":true},{"text":"Waaqi deebisee na hin ijaaruu ree?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ani worra rakkateef hin boonnee ree?","poem":1},{"text":"Worra hiyyeeyyi'iifille hin gaddinee ree?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Yennaa ani waan dansaa barbaadu","poem":1},{"text":"wonni hantuun natti dhutte.","poem":2},{"text":"Yennaa ani ifa eegadhulle","poem":1},{"text":"dukkanti natti dhutte.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Keessi kiyya raafamee nageya dhabe;","poem":1},{"text":"guyyuma guyya'aan rakkadhe.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Nafi adu'uun adoo hin te'in","poem":1},{"text":"gaddaan gurraachowee deema;","poem":2},{"lineBreak":true},{"text":"yaa'ii keessatti dhaabbadhee","poem":2},{"lineBreak":true},{"text":"qarqaarsaaf iyya.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ani namaan adda bayee jeedalaaf obboleessa","poem":1},{"text":"guchi'iif jaala te'eera.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Gogaan nafa kiyyaa gurraachowee solloqqoye;","poem":1},{"text":"lafeen tiyyalle o'aan gubatte.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kiraarri kiyya guddichi bowaaf","poem":1},{"text":"suusulleen tiyyalle worwaanataaf teete.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JOB/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/29.json","previousChapterAudioLinks":{},"numberOfVerses":31}