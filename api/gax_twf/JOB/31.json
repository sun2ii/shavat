{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":[{"text":"«Ani ila halcha'aatiin gara durraa akka hin ilaalle","poem":1},{"text":"ila tiyya woliin gondooroo gondooradheera.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gubbaa irraa Waaqa biraa qoodi namaa maan?","poem":1},{"lineBreak":true},{"text":"Ka waan mara dande'u ka addee oli aantuu jiru biraa","poem":1},{"text":"dhaalli namaa maan?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Balaan worra hama'aaf","poem":1},{"text":"badiin worra dokonkora hujuufii motii ree?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Waaqi karaa kiyya hin dhagguu ree?","poem":1},{"text":"Tarkaaffii tiyya duudiille hin laakkowuu ree?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Sobaan yoo deemee jiraadhe","poem":1},{"text":"miilli kiyya sobiisaaf yoo ariifatee jiraate,","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"akka ani komii hin qanne akka beeku","poem":2},{"lineBreak":true},{"text":"Waaqi kiiloo sirri'iitiin na madaaluu ti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Faanti tiyya karaa irraa yoo gortee jiraatte","poem":1},{"text":"gadhaan kiyya waan ilti tiyya dhaggitee","poem":2},{"lineBreak":true},{"text":"yoo hordofee jiraate","poem":2},{"lineBreak":true},{"text":"harki kiyyalle cubbu'uun yoo battowee jiraate,","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"waan ani facaase nami dhibiin nyaatuu ti;","poem":2},{"lineBreak":true},{"text":"midhaan kiyya duudiille buqqa'ee baduu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Gadhaan kiyya dubarti'iin sossobamee,","poem":1},{"text":"balbala ollaa kiyyaa duratti riphee","poem":2},{"lineBreak":true},{"text":"haadha manaa isaa eegadhee yoo jiraadhe,","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"haati manaa tiyya","poem":2},{"lineBreak":true},{"text":"nama dhibi'iif midhaan daattuu ti;","poem":2},{"lineBreak":true},{"text":"nami dhibiille isii woliin rafuu ti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wonni kun yakkaa guddoo","poem":1},{"text":"seera duratti adabbii namatti fiddu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Cubbuun tun akka ibiddaa guddee balleessiti;","poem":1},{"text":"ani adoo tana godhee jiraadhe","poem":2},{"lineBreak":true},{"text":"karra tiyya mara hin balleessitiiyyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Tajaajiltooti tiyya ta dhiiraatii fi ta durraa","poem":1},{"text":"natti iyyatanuun,","poem":2},{"lineBreak":true},{"text":"iyyata isaanii dhage'iisa yoo dhabee jiraadhe,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"yennaa Waaqi mura'aaf ka'u","poem":2},{"lineBreak":true},{"text":"ani maan godhu'uu jira ree?","poem":2},{"text":"Yennaa inni na gaafatu","poem":1},{"text":"ani maan deebisu'uu jira ree?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Gadaamessa haadha tiyyaa keessatti na dadee,","poem":1},{"text":"tajaajiltoota tiyyalle ka dade isaa motii ree?","poem":2},{"lineBreak":true},{"text":"Nu mara gadaamessa keessatti ka dade","poem":2},{"lineBreak":true},{"text":"isumaa motii ree?","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«Waan Hiyyeeyyiin halchite","poem":1},{"text":"ijjumaa dhooggadhee hin beeku;","poem":2},{"lineBreak":true},{"text":"haadhotii hiyyeessaalle jajjabeessiisa hin lakkinne.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ijoollee haadhaa fi abbaa hin qanne beelottuun","poem":1},{"text":"sagalee tiyya qofi hin nyaanne.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ammoo dargaggummaa tiyyaa jalqabee","poem":1},{"text":"akka abba'aa isaaniif te'eera;","poem":2},{"lineBreak":true},{"text":"bara jiruu tiyyaa mara","poem":2},{"lineBreak":true},{"text":"haadhotii hiyyeessaa qarqaareera.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nama daare tokko","poem":1},{"text":"yookiin hiyyeessa qullaa jiru tokko dhaggee,","poem":2}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"woyaa rifeensa hoolee tiyyaa irraa hujante,","poem":2},{"lineBreak":true},{"text":"itti uffiseeruun o'ifatee","poem":2},{"lineBreak":true},{"text":"yennaan inni na hin eebbisin hin jirtu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kora mura'aa duratti","poem":1},{"text":"fudhatama dhaggatiisa kiyya beekee","poem":2},{"lineBreak":true},{"text":"ijoollee hadhaa fi abbaa hin qanne","poem":2},{"lineBreak":true},{"text":"yoo miidhee jiraadhe,","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"harki kiyya gurmuu tiyya irra buqqa'u;","poem":2},{"lineBreak":true},{"text":"mitikaan harka kiyyaalle caccabu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Badii Waaqi na irratti fidu waan sodaadheef,","poem":1},{"text":"sodaachisuu arnya isaa irraa ta kaate","poem":2},{"lineBreak":true},{"text":"waan akkasii godhuu hin dandeenne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"«Ani worqi'itti addii godhadhee hin beeku;","poem":1},{"text":"yookiin worqii qulluulle'etti hin addanne.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Karri tiyya guddoo waan teeteef,","poem":1},{"text":"yookiin durummaan tiyya waan bacatteef","poem":2},{"lineBreak":true},{"text":"gammadee yoo jiraadhe,","poem":2}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ifa adu'uu, yookiin ji'a ulfinnaan deemu","poem":2},{"lineBreak":true},{"text":"ilaalee yoo jiraadhe,","poem":2}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"gadhaan kiyya dhossa'aan sobamee,","poem":2},{"lineBreak":true},{"text":"ifa adu'uutii fi dansummaa ji'aatiif","poem":2},{"lineBreak":true},{"text":"harka kiyya sunqatiisaan","poem":2},{"lineBreak":true},{"text":"isaan waaqonfadhee yoo jiraadhe,","poem":2}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"ani Waaqa ol-aana'aaf addatamuu waan dhabeef,","poem":2},{"lineBreak":true},{"text":"tun cubbuu du'a namatti mursiittu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"«Ani badii worra na jibbuutitti hin ilillinne;","poem":1},{"text":"hantuun yennaa isaan dhaqqaddelle","poem":2},{"lineBreak":true},{"text":"ani hin gammanne.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Jiruun diina kiyyaa akka baddu abaaree,","poem":1},{"text":"afaan kiyya cubbuu akka dubbatu hin goone.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Nami mana kiyyaa","poem":1},{"text":"‹Sagalee isaa nyaatee ka hin quufin eentu jira?›","poem":2},{"lineBreak":true},{"text":"jedhan.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ani worra karaa deemuuf","poem":1},{"text":"balbala tiyya waan baneef","poem":2},{"lineBreak":true},{"text":"keessummaan karaa keessa hin bulle.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ani yakkaa tiyya gadhaa kiyya keessatti dhoffadhee,","poem":1},{"text":"akka worra dhibi'ii cubbuu tiyya hin gollanne.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Kolbaa bindillaa sodaatiisaan","poem":1},{"text":"tuffiin maati'ii na bararassitee","poem":2},{"lineBreak":true},{"text":"mana keessaa adoo hin bayin","poem":2},{"lineBreak":true},{"text":"cadhisee mana keessa hin teenne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"«Maalo'o, nama naa dhage'u adoo qabaadhe!","poem":1},{"text":"Akka dhugaa dubbadhe mudhisiisaaf","poem":2},{"lineBreak":true},{"text":"mallattoon tiyya kunoo ti.","poem":2},{"text":"Waaqi waan mara dande'u naaf deebisuu ti;","poem":1},{"text":"Ka na himatu himata ifii tarre'een barreeffatee","poem":2},{"lineBreak":true},{"text":"adoo hin dhikeeffatuu!","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Silaa ani dhugumaan himata san","poem":1},{"text":"gurmuu tiyya irratti hin kaafadhaayyu;","poem":2},{"lineBreak":true},{"text":"akka kallachaalle mataa kiyya irratti hin keyadhaayyu.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Ani laakkossa tarkaaffii tiyyaa duudii isatti hima;","poem":1},{"text":"akka sooressa guddaa tokkoolle isatti dhikaadha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"«Worra lafa qabu cunqursee","poem":1},{"text":"lafa isaaniille hunnaan fudhadhee qotee yoo jiraadhe,","poem":2}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"midhaan isaanii kaffaltii malee nyaadhee,","poem":2},{"lineBreak":true},{"text":"akka isaan du'anu godhee yoo jiraadhe,","poem":2}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"lafa san irratti addee qamadi'ii qoreen","poem":2},{"lineBreak":true},{"text":"addee garbu'uu jigidaan ajowu latuu ti» jedhe.","poem":2},"Dubbiin Iyoobii as irratti dhumatte."]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JOB/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}