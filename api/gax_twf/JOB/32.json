{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":32,"content":[{"type":"heading","content":["Eliihuun Jaalota Iyoobii Xixe"]},{"type":"verse","number":1,"content":["Iyoob, «Ani nama balcha'a» waan ifiin jedheef, jarri tun sadiin deebii isaaf deebisuu lakkisane."]},{"type":"verse","number":2,"content":["Eliihuun ilmi Baaraakelii Buzichaa ka maatii Raamii te'e, sababa Iyoob Waaqa caalaa ifi balchoonseef guddoo aare."]},{"type":"verse","number":3,"content":["Jaaloti Iyoobii sadiin deebii quussitu Iyoobiif waan hin deebisiiniif, deebiin isaanii tun akka Waaqi dokonkora hujeeru waan gooteef, Eliihuun isaan irralle'etti aare."]},{"type":"verse","number":4,"content":["Isaan duudiin angafoota isaa waan te'aneef, haga isaan dubbatanee fixatanutti, Eliihuun Iyoobitti dubbatiisaaf eegateeyyu."]},{"type":"verse","number":5,"content":["Afaan jara sadiinii tana keessa deebiin akka hin jirre yennaa dhagge, Eliihuun aare."]},{"type":"verse","number":6,"content":["Maarre Eliihuun ilmi Baaraakelii Buzichaa deebisee,",{"text":"«Ani ijoolle'e;","poem":1},{"text":"isin nama gugurda'a;","poem":2},{"lineBreak":true},{"text":"tanaaf sodaadhee waan beeku himiisaaf isinitti hin gamne.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ani, ‹Nami gugurdaan qara dubbatuu ti;","poem":1},{"text":"qarummaa bara heddu'utti dhaggatane barsiisanuu ti› jedhe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ammoo ka nama keessa bulee hubantii namaaf kennu","poem":1},{"text":"ayyaana Waaqa waan mara dande'uu ti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Qarummaan guddatane'eefii moti;","poem":1},{"text":"waan sirrii te'e hubatiisille dulloomane'eefii moti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Tanaaf na caqasa'a;","poem":1},{"text":"anille waan beeku isinitti hima.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kunoo, ani haga isin dubbatanee fixxanu eegadhe;","poem":1},{"text":"jechoota filataa yennaa dubbattanu","poem":2},{"lineBreak":true},{"text":"miidhassee caqase.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ani akka dansaa isin caqase;","poem":1},{"text":"ammoo isin keessaa nami tokkolle","poem":2},{"lineBreak":true},{"text":"balleessaa Iyoobii mirkaneessee","poem":2},{"lineBreak":true},{"text":"dubbii isaatiif deebii ka kenne hin jiru.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Isin, ‹Nuuti qarummaa dhagganneerra;","poem":1},{"text":"ka Iyoobiif deebii kennu","poem":2},{"lineBreak":true},{"text":"Waaqa malee namaa moti› hin jedhina'a.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iyoob isin morme malee na hin mormine;","poem":1},{"text":"anille moromaa akka keessaniitiin isaaf hin deebisu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«Isaan rifatanee waan deebisanu dhabanee","poem":1},{"text":"dubbiin isaan duraa badde.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kunoo, sababa isaan hin dubbanneef,","poem":1},{"text":"waan isaan deebii deebisanu dhabanee dhaabbataneef","poem":2},{"lineBreak":true},{"text":"ani isaan eeguu qabaa ree?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Anille deebii tiyya hin deebisa;","poem":1},{"text":"waan beekulle hin mudhisa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ani waan dubbadhu hedduu waan qabuuf,","poem":1},{"text":"cadhisuu hin dande'u.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Keessi kiyya daadhii woyni'ii ta cuqqaalantee,","poem":1},{"text":"akka qalqalluu daadhii woyni'ii haareyaa","poem":2},{"lineBreak":true},{"text":"ka dho'iisa geyee ti.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Akka furadhuuf dubbatuu qaba;","poem":1},{"text":"afaan kiyya banadhee deebii kennuu qaba.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ani nama tokkoofille hin rogu;","poem":1},{"text":"nama tokkolle hin kukuulu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ani nama kukuuliisa waan hin beenneef,","poem":1},{"text":"silaa ka na dade dafee na balleessaayyu.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JOB/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/31.json","previousChapterAudioLinks":{},"numberOfVerses":22}