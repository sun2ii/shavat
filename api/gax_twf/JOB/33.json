{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"«Iyoob, ammalle waan jedhu dhage'i;","poem":1},{"text":"dubbii tiyya duudiille caqasi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ani afaan kiyya saaqadhee,","poem":1},{"text":"arrabi kiyya dubbatiisaaf qophoweera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dubbiin tiyya","poem":1},{"text":"qajeelummaa gadhaa kiyyaa irraa dhutti;","poem":2},{"lineBreak":true},{"text":"arrabi kiyyalle dhugaa dubbata.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ayyaanni Waaqaa na dade;","poem":1},{"text":"hafuurri Waaqa waan mara dande'uu","poem":2},{"lineBreak":true},{"text":"jiruu naa kenne.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yoo dandeette deebii naa kenni;","poem":1},{"text":"waan dubbattu qopheeffadhuutii","poem":2},{"lineBreak":true},{"text":"na dura dhaabbadhu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kunoo, ani Waaqa duratti akkuma keeti;","poem":1},{"text":"nuuti lamaanuu faara irraa dadanne.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Na sodaatiis si hin bararassin;","poem":1},{"text":"harki kiyyalle si hin cunqursu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Dhuguma ani si dhage'aaruun dubbatteerta;","poem":1},{"text":"jecha afaan keeti keessaa bayelle dhage'eera.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ati yennaa dubbattu, ‹Ani qulqullu'u,","poem":1},{"text":"cubbuulle hin qabu;","poem":2},{"lineBreak":true},{"text":"ani qullu'u,","poem":2},{"lineBreak":true},{"text":"yakkaalle hin qabu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Waaqi na adabiisaaf sababa na irratti barbaada;","poem":1},{"text":"akka diina ifiille na laakkowa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inni miila kiyya jirma odduu galchee,","poem":1},{"text":"tarkaaffii tiyya duudii eega› jetta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Waaqi nama duudii waan caaluuf,","poem":1},{"text":"ani ammoo tana irratti","poem":2},{"lineBreak":true},{"text":"akka ati sirrii hin te'in sitti hima.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ati, ‹Waaqi iyyata namaa hin dhage'u› jettee,","poem":1},{"text":"maaf isa aalatta?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nami hin hubatu malee,","poem":1},{"text":"Waaqi karaa adda addaatiin dubbata.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Namooti taqee ifii irra rafaneeranuun,","poem":1},{"text":"hirriibi hamaan isaan yennaa qabu","poem":2},{"lineBreak":true},{"text":"Waaqi oojju'uun, mudhii halkaniitiin dubbata.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yennaa san inni gurra isaaniititti hin dubbata;","poem":1},{"text":"ifi eeggachiisiisalle'een isaan bararassa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Akka kanaan hujii hantuu irraa isaan deebisa;","poem":1},{"text":"akka hin koorrelle isaan eega.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Lubbuu isaanii boolla irraa,","poem":1},{"text":"jiruu isaaniille badii shallaaga'aa irraa hin hambura.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yookiin akka nami taqee ifii gubba'atti dhukkubaan,","poem":1},{"text":"dhukkuba hamaa ka yennaa mara lafee isaa bocuun","poem":2},{"lineBreak":true},{"text":"akka adabamu hin godha.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Maarre jiruun isaa waan nyaataa,","poem":1},{"text":"gadhaan isaalle sagalee guddoo dansa'aayyuu hin diqata.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Foon isaa dhumatee,","poem":1},{"text":"lafeen isaa ta dur hin mudhanne yaatee mudhatti.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Lubbuun isaa gara boollaatitti","poem":1},{"text":"jiruun isaa gara ergantoota du'aa dhikaatteerti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"«Karaa sirri'ii ka namaaf mudhisanu,","poem":1},{"text":"ergantoota Waaqaa kuma keessaa tokkochi","poem":2},{"lineBreak":true},{"text":"gara isaa dhufee isa hin qarqaara fa'a te'a.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ergamaan Waaqaalle isaaf mararee,","poem":1},{"text":"‹Ani wodoo isaaf dhaggeera;","poem":2},{"lineBreak":true},{"text":"akka inni gara boollaa gad hin buune godhi› jedhee du'a ajaja.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Achiin duuba nafi isaa deebi'ee","poem":1},{"text":"akka nafa ijoolle'ee haareffama;","poem":2},{"lineBreak":true},{"text":"akka yennaa dargaggumma'aalle te'a.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Inni Waaqa daadimata;","poem":1},{"text":"daadimata isaalle Waaqi hin dhage'a.","poem":2},{"text":"Inni fuula Waaqaa dhaggee hin ilillisa;","poem":1},{"text":"Waaqille gara addee balchummaa isaatitti","poem":2},{"lineBreak":true},{"text":"isa hin deebisa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Innille namoota duratti faarfataa,","poem":1},{"text":"‹Ani cubbuu hujeera;","poem":2},{"lineBreak":true},{"text":"waan sirrii te'e daddasseera;","poem":2},{"lineBreak":true},{"text":"Waaqi ammoo yakkaa tiyya natti hin laakkonne.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Inni lubbuun tiyya gara boolla awwaalaa akka hin buune wodeera;","poem":1},{"text":"jiruun tiyyalle ifa hin dhaggiti› jedha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"«Kunoo, Waaqi deddeebisee","poem":1},{"text":"tana mara namaaf hin godha.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Inni ifa jiru'uu akka dhagguuf","poem":1},{"text":"lubbuu namaa deebisee boolla keessaa hin baasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"«Iyoob, waan ani sitti himu akka dansaa caqasi;","poem":1},{"text":"ani hin dubbadha, ati cadhis.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Waan jettu yoo qabaatte naa deebis,","poem":1},{"text":"ani waan bilisa si baasuuf dubbadhu.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Yoo waan jettu hin qabaatin,","poem":1},{"text":"cadhisii na caqasi;","poem":2},{"lineBreak":true},{"text":"anille qarummaa si barsiisa» jedhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JOB/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/32.json","previousChapterAudioLinks":{},"numberOfVerses":33}