{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":34,"content":[{"type":"verse","number":1,"content":["Eliihuun ammalle dubbatee,"]},{"type":"verse","number":2,"content":[{"text":"«Isin namoota qaro'o,","poem":1},{"text":"dubbii tiyya dhage'a'a;","poem":2},{"lineBreak":true},{"text":"isin worri beekkoleen na caqasa'a.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Akkuma arrabi mi'aa sagale'ee beeku","poem":1},{"text":"gurrille mi'aa dubbi'ii beeka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kowa'a waan sirrii te'e filanna;","poem":1},{"text":"waan dansaalle woliin baranna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Iyoob ifiin, ‹Ani yakkaa hin qabu;","poem":1},{"text":"Waaqi ammoo haqa na dhooggate.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani adoo dhugaa irra jiruu","poem":1},{"text":"akka dharaamessaa laakkowame;","poem":2},{"lineBreak":true},{"text":"adoo yakkaa hin qabaatin","poem":2},{"lineBreak":true},{"text":"madaa hin fayyineen farriisatti jira› jedheera.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nama attamiititti akka Iyoobii","poem":1},{"text":"murgoo akka bisaanii una ree?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inni worra hantuu godhu woliin jaaloma;","poem":1},{"text":"worra hamaaleyyii wolille'een oola.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inni, ‹Waaqa gammachiisuun","poem":1},{"text":"womaa namaaf hin baatu› jedha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Tanaaf isin worri hubattanu na caqasa'a!","poem":1},{"text":"Hantuu godhiis Waaqa irraa","poem":2},{"lineBreak":true},{"text":"dokonkora hujiisille","poem":2},{"lineBreak":true},{"text":"Waaqa waan mara dande'u irraa fagaatuu ti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Waaqi akka hujii namaatitti namaaf hin kaffala;","poem":1},{"text":"akkuma ideensa isaatitti","poem":2},{"lineBreak":true},{"text":"akka inni dhaggatu hin godha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Waaqi waan mara dande'u hantuu hin huju;","poem":1},{"text":"inni haqa hin dassu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Lafa irratti eentu ajajaa isa godhe?","poem":1},{"text":"Biyya lafaa duudii irratti","poem":2},{"lineBreak":true},{"text":"eentu itti gaafatamaa isa godhe?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Waaqi ayyaana ifii deebisee yoo fudhate,","poem":1},{"text":"hafuura ifiille gara ifii yoo deebifate,","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"sanyiin namaa duudiin adduma tokko baddee","poem":2},{"lineBreak":true},{"text":"gara biyye'ee deebiti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«Nama hubatu yoo teete tana dhage'i;","poem":1},{"text":"waan ani jedhulle caqasi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nami haqa jibbu bulchuu dande'aa ree?","poem":1},{"text":"Ati Waaqa! Balchichaa fi hunnaamessatti","poem":2},{"lineBreak":true},{"text":"yakkaa itti murtaa ree?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mootichaan, ‹Ati woy hin baatu›,","poem":1},{"text":"qondaaltotaan, ‹Isin worra hamaaleyyi'ii›","poem":2},{"lineBreak":true},{"text":"ka jedhu eennu?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Isaan duudiin hujii harka isaa waan te'aneef,","poem":1},{"text":"inni qondaaltotaaf hin rogu;","poem":2},{"lineBreak":true},{"text":"dureessa hiyyeessa irra caalchisee hin ilaalu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Namooti halkan wodhakkaa dedhuma du'uu dande'an;","poem":1},{"text":"kolbaan raafantee dhumatti;","poem":2},{"lineBreak":true},{"text":"worri hunnaameyyiin","poem":2},{"lineBreak":true},{"text":"harki namaalle adoo isaan hin tuqin hin badan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«Ilti Waaqaa ideensa namaa ilaalti;","poem":1},{"text":"inni tarkaaffii nama tokko tokkoolle hin dhagga.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Dimimmis yookiin dukkanti dimmi","poem":1},{"text":"addeen worri hantuu huju itti dhokatu hin jirtu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Waaqi fuula isaa duratti mura'aaf akka dhikaatanu","poem":1},{"text":"beellama hin qabatu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Inni qorqortii malee hunnaameyyii baallii irraa kaasee,","poem":1},{"text":"worra dhibii addee isaanii buusa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Inni hujii isaanii mara waan beekuuf,","poem":1},{"text":"halkan tokkotti baallii irraa isaan kaasee balleessa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Inni addee nami duudiin dhaggutti","poem":1},{"text":"hammeenna isaaniitiif isaan adaba.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Sababa isaan isa hordofuu lakkisanee,","poem":1},{"text":"isaaf ajajamuu dhabaneef inni tana godhe.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Iyyi worra hiyyeeyyi'ii","poem":1},{"text":"gara Waaqaa akka dhaxxu godhaneeran;","poem":2},{"lineBreak":true},{"text":"Waaqille iyya isaanii dhage'eera.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Yoo inni cadhise ammoo","poem":1},{"text":"eentu isatti mura;","poem":2},{"lineBreak":true},{"text":"yoo inni fuula ifii dhoffate","poem":2},{"lineBreak":true},{"text":"eentu isa dhagguu dande'a ree?","poem":2},{"lineBreak":true},{"text":"Inni nama irratti, gosa biyya adda addaa irralle'etti,","poem":2}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"worra kolbaa gowwisiisanu keessaa","poem":2},{"lineBreak":true},{"text":"nama Waaqa malee jiraatu tokko mootii yoo godhe","poem":2},{"lineBreak":true},{"text":"eentu isa dhoogga ree?.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"«Nami tokko Waaqaan, ‹Ani yakkaamessa;","poem":1},{"text":"ammoo deebi'ee hin yakku.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Waan ani hin dhaggine ati na barsiisi;","poem":1},{"text":"yoo yakkee jiraadhe deebi'ee hin yakku› jedhe jiraa ree?.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ati cubbuu irraa deebi'iisa didataartuun","poem":1},{"text":"Waaqi akka yaada keetii deebisaa ree?","poem":2},{"text":"San sittuu filata malee anaa moti;","poem":1},{"text":"tanaaf waan beettu natti himi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"«Worri hubatuu,","poem":1},{"text":"worri qaroon na dhage'ulle anaan,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"‹Iyoob beekkumsa malee dubbata;","poem":1},{"text":"dubbiin isaalle ta gatii hin qanne› hin jedhan.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Deebiin Iyoobii ta akka worra hamootaa waan teeteef","poem":1},{"text":"Inni haga dhumaatitti","poem":2},{"lineBreak":true},{"text":"qoramee adoo hin ilaallamuu!","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Inni cubbuu ifii irratti finqila ede'a;","poem":1},{"text":"inni odduu teenna tee'ee tuffi'iin harka dhowaa","poem":2},{"lineBreak":true},{"text":"dubbii moromaa ifii Waaqa irratti fakkansa» jedhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JOB/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/33.json","previousChapterAudioLinks":{},"numberOfVerses":37}