{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":36,"content":[{"type":"verse","number":1,"content":["Eliihuun ammalle ede'ee Iyoobiin,"]},{"type":"verse","number":2,"content":[{"text":"«Ani ammalle marroo Waaqaatiif","poem":1},{"text":"waan dubbadhu waan qabuuf,","poem":2},{"lineBreak":true},{"text":"diqqoo naa ossadhu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ani beekkumsa kiyya fagoo irraa hin fida;","poem":1},{"text":"Waaqi na dade balchaa akka te'e","poem":2},{"lineBreak":true},{"text":"ani hin mudhisa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dhugumaan dubbiin tiyya dharaa moti;","poem":1},{"text":"ani nami si woliin jiru","poem":2},{"lineBreak":true},{"text":"beekkumsa dhidhinna hin qanne akka qabu beeki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Dhugumaan Waaqi hunnaamessa;","poem":1},{"text":"Inni eennulle hin tuffatu;","poem":2},{"lineBreak":true},{"text":"hunni hubantii isaa guddoo jaddu'u.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inni worra hamaa jiru'uun hin leesisu;","poem":1},{"text":"worra cunqurfameef ammoo haqa isaanii hin kenna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni ila ifii balchoota irraa hin kaasu;","poem":1},{"text":"mootota woliin","poem":2},{"lineBreak":true},{"text":"barcumaa mootumma'aa irra isaan hin teessisa;","poem":2},{"lineBreak":true},{"text":"haga bara baraalle ol ol isaan hin qaba.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Namooti wodaroo sibiilaatiin yoo hidhamane","poem":1},{"text":"yookiin wodaroo rakkinnaatiin yoo qabamane,","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"balleessaa isaan koora ifiitiin hujane","poem":2},{"lineBreak":true},{"text":"inni isaanitti hima.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Qajeelfama akka dhage'anuuf","poem":1},{"text":"gurra isaanii hin bana;","poem":2},{"lineBreak":true},{"text":"cubbuu ifii irralle'ee akka deebi'anuuf","poem":2},{"lineBreak":true},{"text":"isaan hin ajaja.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isaan Waaqaaf ajajamanee isa yoo tajaajilane","poem":1},{"text":"bara isaanii ka hafe","poem":2},{"lineBreak":true},{"text":"durumma'aa fi gammadaan fixatan.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Isa dhage'uu yoo didane ammoo,","poem":1},{"text":"shallaaga'aan hin badan;","poem":2},{"lineBreak":true},{"text":"Waaqa beekiisa waan didaneef hin du'an.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Worri Waaqa malee le'u","poem":1},{"text":"aarii gadha'atti qabatan;","poem":2},{"lineBreak":true},{"text":"yennaa inni isaan adabulle","poem":2},{"lineBreak":true},{"text":"qarqaarsa dhaggatiisaaf hin daadimatanu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Isaan dhiira Galma Waaqaa keessatti","poem":1},{"text":"wol bukkoonsitu oddu'utti","poem":2},{"lineBreak":true},{"text":"ijoollumma'aanuu du'an.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Waaqi worra rakkatanu rakkoo keessaa hin baasa;","poem":1},{"text":"inni akka isaan rakkatanu godhaa isaan barsiisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«Inni ammalle farra hantuu keessaa,","poem":1},{"text":"gara addee badhoo wol rakkisuun hin jiretti si baasa;","poem":2},{"lineBreak":true},{"text":"qoriin teetille sagalee dansa'aan hin guutanti.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Amma ammoo muraan nama hama'aaf malte","poem":1},{"text":"waan sitti muranteef,","poem":2},{"lineBreak":true},{"text":"adabbii si'iif malte fudhatiisatti jirta.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Eennulle durumma'aan akka si hin sonne,","poem":1},{"text":"Safuu","poem":2},{"noteId":22},{"text":"guddoolle'een akka hin sobanne ifi eegadhu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Karri teeti yookiin jabeenni hunna teetii","poem":1},{"text":"rakkinna hamaa keessaa si baasuu dande'anii ree?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ati halkan kolbaan addee ifii irraa baddu","poem":1},{"text":"akka dhufu hin halchin.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Farriisaan irra hantuu hujiisa waan filatteef,","poem":1},{"text":"gara hammeennaa akka hin deebine ifi eegadhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Kunoo, Waaqi hunna ifiitiin ol ol jedheera;","poem":1},{"text":"barsiisaan akka isaa eennu ree?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Waan Waaqi huju eentu itti himuu dande'a?","poem":1},{"text":"yookiin eentu, ‹Ati dokonkorteerta› isaan jedha ree?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hujii isaa ta nami faaru'uun leellifatu","poem":1},{"text":"atille akka leellifattu yaadadhu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nami duudiin hujii isaa dhaggeera;","poem":1},{"text":"nami martinuu fagoo irraa daaw'ata.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Dhugumaan Waaqi gudda'a;","poem":1},{"text":"inni hubantii teennaan oli;","poem":2},{"lineBreak":true},{"text":"laakkossi bara isaalle qorqoramuu hin dande'u.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"«Bisaan lafa irraa ol fuudhee","poem":1},{"text":"gara copha bokkeyaa ka deebisu Waaqa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Inni bokkeya duumensa keessaa gad hin roobisiisa;","poem":1},{"text":"namoota irralle'etti hin danbalaasa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Inni attam akka duumensa diriirsu","poem":1},{"text":"galma guddaa ifii keessaa attam akka mandi'u","poem":2},{"lineBreak":true},{"text":"eentu hubatuu dande'a ree?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kunoo, Waaqi adaala ifiititti","poem":1},{"text":"balaqqeettii attam akka bittinneessu","poem":2},{"lineBreak":true},{"text":"hundee abbaaya'aalle dukkanaan akka gollu ilaali.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Inni akka kanaan gosa biyya adda addaa bulcha;","poem":1},{"text":"sagalee bacaalle isaaniif kenna.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Inni balaqqeettii harkatti qabatee","poem":1},{"text":"lafa itti murteessetti akka dhoottu hin ajaja.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Mandiisuun bokkeenni bubbe'ee akka dhufaaru beessitti;","poem":1},{"text":"horiille dhufiisa isi'ii hin beekan.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":22,"caller":"+","text":"Safuu: Malaamaltummaa jechu'u.","reference":{"chapter":36,"verse":18}}]},"thisChapterLink":"/api/gax_twf/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}