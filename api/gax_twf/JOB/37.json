{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":37,"content":[{"type":"verse","number":1,"content":[{"text":"«Bokkeenni bubbe'ee sun","poem":1},{"text":"gadhaa kiyya hollachiisee, sheephisiise.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Qoonqoo isaa ta akka mandiisu'uu,","poem":1},{"text":"gungunsuu afaan isaa keessaa baatulle caqasa'a.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inni gubba'aan jala duudi'itti","poem":1},{"text":"balaqqeettii ifii haga qaccee lafaatitti gad lakkisa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Achiin duuba harqiis qoonqoo isaa hin dhage'anti;","poem":1},{"text":"inni qoonqoo ifii ta sodaachittu","poem":2},{"lineBreak":true},{"text":"akka mandiisu'uu hin dhageessisa;","poem":2},{"lineBreak":true},{"text":"yennaa qoonqoo ifii dhageessisu","poem":2},{"lineBreak":true},{"text":"balaqqeettiille duubatti hin hamburu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Waaqi qoonqoo ifii ta bilbaasaatiin hin mandi'a;","poem":1},{"text":"waan gugurdoo hubantii teennaan olii hin huja.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inni dhakaa bokkeyaatiin, ‹Lafa irratti bu'i›,","poem":1},{"text":"tiifuu bokkeyaatille'een, ‹Bokkeya jabaa te'i› hin jedha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nami inni dade duudiin hujii isaa beekuuf,","poem":1},{"text":"nami martinuu hujii ifii akka dhaabu hin godha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yennaa san bineensoti","poem":1},{"text":"gara goda ifii keessatti hin qubatan;","poem":2},{"lineBreak":true},{"text":"mandhee ifii keessalle'etti dhokatan.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hobonbolattiin gara kibbaatii hin dhutti;","poem":1},{"text":"qilleensi boojji'ii gara kaabaatii dhufa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hafuurri Waaqaa dhakaa bokkeyaa fida;","poem":1},{"text":"bisaan badhaalle ititee dhakaa bokkeyaa te'a.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inni duumensi akka bisaan ba'atu hin godha;","poem":1},{"text":"balaqqeettii ifiille duumensa keessaa balaqqisiisa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Duumensi waan inni ajaje muummessiisaaf,","poem":1},{"text":"qajeelcha isaatiin lafa duudii irra","poem":2},{"lineBreak":true},{"text":"asii fi achi mara.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Waaqi namoota adabiisaaf","poem":1},{"text":"lafa ifii jiisiisaaf","poem":2},{"lineBreak":true},{"text":"yookiin jaalala ifii mudhisiisaaf bokkeya fida.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Iyoob, tana dhage'i;","poem":1},{"text":"me lakkisiitii hujii Waaqaa ta maade'ee","poem":2},{"lineBreak":true},{"text":"yaadaan hubadhu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Waaqi duumensa attam akka toowatu","poem":1},{"text":"balaqqeettii duumensa ifiille","poem":2},{"lineBreak":true},{"text":"attam akka balaqqisiisu ati hin beettaa?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Duumensa gubba'atti ka rarraasuu fi","poem":1},{"text":"hujii maade'ee tana","poem":2},{"lineBreak":true},{"text":"ta Waaqa beekkumsa dhidhuu hin qannee hin beettaa?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yennaa latti qilleensa gara kibbaatiin o'itee,","poem":1},{"text":"ati ka woyaan teeti keessatti fuurtu,","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ol-gubbaa akka daaw'itii","poem":2},{"lineBreak":true},{"text":"sageettuu baqisiifante irraa hujantee jabaattu,","poem":2},{"lineBreak":true},{"text":"yennaa Waaqi diriirsu ati isa qarqaaruu dandeettaa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«Waan Waaqaan jennu nutti himi;","poem":1},{"text":"nuuti womaa waan hin beenneef","poem":2},{"lineBreak":true},{"text":"haajaa keenna dhikeeffatiisa hin dandeennu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Akka ani dubbatu'uu jiru","poem":1},{"text":"nami isatti himiisa barbaachisaa ree?","poem":2},{"text":"Nami tana dubbatiisaaf yaadu dhuguma hin bada.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Qilleensi duumensa haxowee","poem":1},{"text":"gubbaa irraa qulqulleesseen duuba,","poem":2},{"lineBreak":true},{"text":"nami tokkolle aduu midhatee ilaaluu hin dande'u.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Inni ulfinna akka worqi'ii calalaquun","poem":1},{"text":"gara kaabaatiin hin dhufa;","poem":2},{"lineBreak":true},{"text":"Waaqi arnya sodaachisa'aan hin dhufa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Waaqi waan mara dande'u hubantii teennaan ol;","poem":1},{"text":"hunnaan gudda'a;","poem":2},{"lineBreak":true},{"text":"inni abbaa muraa dhuga'aatille'e.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Tanaaf nami marti isa sodaata;","poem":1},{"text":"inni worra ifiin qaroo jedhu hin tuffata» jedhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JOB/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/36.json","previousChapterAudioLinks":{},"numberOfVerses":24}