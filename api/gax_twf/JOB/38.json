{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":38,"content":[{"type":"heading","content":["Deebii Mootiin Waan Maraa Iyoobiif Deebise"]},{"type":"verse","number":1,"content":["Achiin duuba Mootiin Waan Maraa hobonbolattii keessaa Iyoobitti dubbatee,"]},{"type":"verse","number":2,"content":[{"text":"«Dubbii beekkumsa malee dubbatantuun,","poem":1},{"text":"gorsa kiyya ka diqqeessu kun eennu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Akka dhiiraa hidha keeti hidhadhu;","poem":1},{"text":"ani si gaafadha; atille naaf deebis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Yennaa ani hundee lafaa dhaabe","poem":1},{"text":"ati eessa jirtaayyu?","poem":2},{"lineBreak":true},{"text":"Hubantii yoo qabaatte natti himi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Haga lafaa ka murteesse eennu?","poem":1},{"text":"Isii irralle'etti sarara miki'ii","poem":2},{"noteId":23},{"text":"ka diriirse","poem":2},{"lineBreak":true},{"text":"eennu akka te'e hin beettaa?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hundeen lafaa maan irratti dhaabatte?","poem":1},{"text":"Dhakaa roga isi'iille ka dhaabe eennu?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yennaa urjooti ganamaa wolitti qabantee faarsitu,","poem":1},{"text":"ergantooti Waaqaalle yennaa ilillittu","poem":2},{"lineBreak":true},{"text":"ati eessa jirtaayyu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Yennaa abbaayaan lafa keessaa dhoote,","poem":1},{"text":"balbala madda isi'ii ka cufe eennu ree?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abbaayaa duumensaan uffisee,","poem":1},{"text":"dukkana dimmalle'een ka isii golle ana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Meessaalle itti godhee,","poem":1},{"text":"balbalaa fi danqaraa ka itti keye ana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"‹Ati haga asii hin dhutta; asi irra hin dabartu!","poem":1},{"text":"Danbaliin teeti jadduun","poem":2},{"lineBreak":true},{"text":"asitti dhaabbatuu ti!› ka jedhe ana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Iyoob, bara jiruu teetii","poem":1},{"text":"latti akka bariitu ajajjee beettaa?","poem":2},{"lineBreak":true},{"text":"Bariin lafaalle addee akka qabattu gooteertaa?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bari'iisi lafaa haga qaccee lafaa dhaqqabee,","poem":1},{"text":"worri hamaan akka isii irraa hargufamanu gooteertaa?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ifi bari'ii koobotii fi dhooqoti","poem":1},{"text":"akka woyaa dachaafantee","poem":2},{"lineBreak":true},{"text":"dhaabbatanee akka mudhatanu godha;","poem":2},{"lineBreak":true},{"text":"akka chaappaa faara jiidhaa irratti dhowamee","poem":2},{"lineBreak":true},{"text":"guddisee mudhisa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Worra hamaa ifi isaan duraa fudhatameera;","poem":1},{"text":"harki isaan hantuu hujiisaaf ol fudhatanelle cabeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«Ati gara madda abbaaya'aa gad buuteertaa?","poem":1},{"text":"Yookiin hundee qilee abbaaya'aa keessa ideenteertaa?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Balbalti du'aa sitti mudhifanteerti?","poem":1},{"text":"Yookiin balbala dukkana dimmaa dhaggiteerta?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Badhinna biyya lafaa hubatteertaa?","poem":1},{"text":"Tana mara yoo beettu teete me natti himi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«Karaan gara ifaa geessu meet?","poem":1},{"text":"Addeen dukkanti jirtulle eessa?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ifaa fi dukkana","poem":1},{"text":"addee isaaniititti geessuu hin dandeettaa?","poem":2},{"lineBreak":true},{"text":"Karaa gara addee isaanii geessu hin beettaa ree?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Biyyi lafaa yennaa dadante","poem":1},{"text":"ati waan dhalatteertuuf dhuguma hin beetta;","poem":2},{"lineBreak":true},{"text":"bara hedduulle leeteerta.","poem":2},{"noteId":24}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Ati gara mana dhakaan bokkeyaa itti kuufamu seenteertaa?","poem":1},{"text":"Yookiin mana dhakaan bokkeyaa itti kuufamu dhaggiteertaa?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Dhakaan bokkeyaa kun,","poem":1},{"text":"ka ani yennaa rakko'ootiif,","poem":2},{"lineBreak":true},{"text":"guyyaa woraanaatii fi guyyaa lolaatiifiille maffadhe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Karaan gara addee ifi irraa balaqqisu geessu kam?","poem":1},{"text":"Yookiin qilleensi gara aduun baatuu","poem":2},{"lineBreak":true},{"text":"eessa irraa lafatti bittinnowa?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bokkeya gad lola'uu fi","poem":1},{"text":"bokkeya bubbe'ee ka mandiisu'uutiif","poem":2},{"lineBreak":true},{"text":"karaa ka baase eennu?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Lafa nami tokkolle hin leenetti","poem":1},{"text":"goomolee nami tokkolle hin jirre keessa,","poem":2},{"lineBreak":true},{"text":"bokkeya roobisiisee,","poem":2}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"lafa goomolee duwwaa jiisee,","poem":2},{"lineBreak":true},{"text":"marra akka baattu ka godhe eennu?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Abbaan bokkeyaatii fi copha fixeensaa eennu ree?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Dhakaan bokkeyaa gadaamessa eennuu keessaa baye?","poem":1},{"text":"Qorra","poem":2},{"noteId":25},{"text":"ol-gubbaa irraa bu'u eentu dhale?","poem":2}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Qorri sun bisaan akka dhaka'aa jabeessee,","poem":2},{"lineBreak":true},{"text":"dirri abbaaya'aa akka dhakaa bokkeyaa ite'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"«Tuuta urjootaa ka, ‹Torbii","poem":1},{"noteId":26},{"text":"› jedhamanu, wolitti hidhuu,","poem":1},{"text":"yookiin wodaroo tuuta urjoota, ‹Sadee","poem":2},{"noteId":27},{"text":"› jedhamanuu hiikuu hin dandeettaa?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Tuuta urjoota gara kibbaa yennaa isaaniititti bobbaasuu dandeettaa?","poem":1},{"text":"Tuuta urjootaa ‹Ka bineensa Doobbaa","poem":2},{"noteId":28},{"text":"› jedhamu fakkaatu, ilmaan ijoollee isaanii woliin sooressuu dandeettaa?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ati sirna","poem":1},{"noteId":29},{"text":"ol-gubba'aa beettaa?","poem":1},{"text":"Sirni kun lafa irratti akka huju godhuu dandeettaa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"«Lolaan bisaanii akka si liqinsuuf,","poem":1},{"text":"qoonqoo ol-qabattee duumensatti dubbatuu dandeettaa?","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ati balaqqeettiin akka buutu erguu dandeettaa?","poem":1},{"text":"Isiille si'iin, ‹Kunoo, ani as jira› hin jettii?","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Kormi lukku'uu bari'iisa lafaa beekee akka iyyu,","poem":1},{"text":"yookiin sinbirreen akka mana ijaarrattu","poem":2},{"lineBreak":true},{"text":"ka qarummaa kenneef eennu?","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Yennaa bukuun lafaa jabaattee wolitti tuulantuu fi","poem":1},{"text":"quqquuqaan lafaa wolitti qabatu,","poem":2},{"lineBreak":true},{"text":"duumensa laakkowiisaaf ka qarummaa qabu eennu?","poem":2},{"lineBreak":true},{"text":"Waabaa","poem":2},{"noteId":30},{"text":"bisaanii ta ol-gubba'aa jissee,","poem":2},{"lineBreak":true},{"text":"ka bisaan gad naquu dande'u eennu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"«Ati neenqa dhala'aaf","poem":1},{"text":"waan nyaatu hin adansitaa ree?","poem":2},{"lineBreak":true},{"text":"Yookiin dardaroota neenqaa hin quussitaa ree?","poem":2}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Yennaa isaan mandhee ifii keessatti riphanu,","poem":2},{"lineBreak":true},{"text":"yookiin daggala keessatti","poem":2},{"lineBreak":true},{"text":"dhokatanee yennaa gaadatanu,","poem":2},{"lineBreak":true},{"text":"isaan hin quussitaa?","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Yennaa ilmeen harraaqessaa","poem":1},{"text":"waan nyaattu dhaddee daaxxu,","poem":2},{"lineBreak":true},{"text":"gara Waaqaalle yennaa boottu","poem":2},{"lineBreak":true},{"text":"ka sagalee isi'iif kennu eennu?","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":23,"caller":"+","text":"Mikii: Meeshaa miki'iititti fayyadamiisaan haga wonni tokko dheerattu yookiin badhattu beekiis.","reference":{"chapter":38,"verse":5}},{"noteId":24,"caller":"+","text":"Yaada laakkossa kanaa: Wonni as irratti jedhamuu barbaadame, biyyi lafaa yennaa dadantu ati womaa hin beettuu; bara dheeraalle leetee hin jirtu yaada jedhu.","reference":{"chapter":38,"verse":21}},{"noteId":25,"caller":"+","text":"Qorra: Yookiin boojjii jedhama.","reference":{"chapter":38,"verse":29}},{"noteId":26,"caller":"+","text":"Torbii: Hiikkaan gariin Piliyaadis jedhan.","reference":{"chapter":38,"verse":31}},{"noteId":27,"caller":"+","text":"Sadee: Hiikkaan gariin Ooriyoon jedhan.","reference":{"chapter":38,"verse":31}},{"noteId":28,"caller":"+","text":"Doobbaa: Bineensa Iyyaa fakkaatu.","reference":{"chapter":38,"verse":32}},{"noteId":29,"caller":"+","text":"Sirna: Yookiin sirinya jedhama.","reference":{"chapter":38,"verse":33}},{"noteId":30,"caller":"+","text":"-38 Waabaa bisaanii: Yookiin okkotee bisaanii guddittii jedhamuu dande'a.","reference":{"chapter":38,"verse":37}}]},"thisChapterLink":"/api/gax_twf/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/37.json","previousChapterAudioLinks":{},"numberOfVerses":40}