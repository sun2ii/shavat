{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":39,"content":[{"type":"verse","number":1,"content":[{"text":"«Yennaa godaan","poem":1},{"noteId":31},{"text":"gaaraa dhalu beettaa?","poem":1},{"text":"Gadansi dhaluun dhaggitee beettaa?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ji'a meeqa rimeyaan turanee,","poem":1},{"text":"yoom akka dhalanu hin beettaa?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isaan quphananee dhalan;","poem":1},{"text":"foolata ifii irralle'ee hin furatan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ilmeen isaanii baddaa keessatti guddattee jabaatti;","poem":1},{"text":"bayanee deemaneen duuba,","poem":2},{"lineBreak":true},{"text":"gara haadha ifii hin deebi'anu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Harreen diidaa gara feete akka deentu","poem":1},{"text":"ka lakkise eennu?","poem":2},{"lineBreak":true},{"text":"Hidhaana irraa ka isii hiike eennu?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani lafa goomole'ee mana isaanii,","poem":1},{"text":"dirree sooddaalle","poem":2},{"lineBreak":true},{"text":"addee isaan le'anu godhee kenneef.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Isaan qachaa hoga'aa irraa fagaatanee le'an;","poem":1},{"text":"nami isaan leenjisee hujisiisulle hin jiru.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Isaan dheedaaf gaarotatti bobba'an;","poem":1},{"text":"waan magariisa","poem":2},{"noteId":32},{"text":"mara barbaadatan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Gafarsi si tajaajiliisaaf fedhii hin qabaataa?","poem":1},{"text":"Moonaa teeti keessalle hin bulaa?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gafarsa waanjoo itti hiitee","poem":1},{"text":"moofara harkisaa akka qotu godhuu dandeettaa?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jabeenni isaa guddaa waan te'eef","poem":1},{"text":"isatti hin addattaa?","poem":2},{"lineBreak":true},{"text":"Hujii teeti ulfaattuu isatti hin lakkittaa?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Inni midhaan keeti wolitti qabee","poem":1},{"text":"gara eeddummee teetii akka si'iif fidu hin addattaa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Guchiin gammadaan koola ifii hargufatti;","poem":1},{"text":"koollii isi'ii ammoo akka koola qonga'aatii moti.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Guchiin quuphaa ifii lafatti buutti;","poem":1},{"text":"biyyeen akka itti o'ituufille achumatti lakkitti.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Isiin miilli akka caccassu,","poem":1},{"text":"bineensotille akka irra ijjatanu hin yaadattu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Akka waan ta isi'ii hin te'inii,","poem":1},{"text":"cuucuu ifiititti gadhaa jabaatti;","poem":2},{"lineBreak":true},{"text":"eloon isi'ii baddulle hin qortu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ka qarummaa isii dhoogge,","poem":1},{"text":"ka hubantiille isi'iif hin kennin ana Waaqa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yennaa rukkisiisa jalqaddu","poem":1},{"text":"fardaa fi abbaa fardaatitti hin kolliti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«Iyoob, fardaaf jabeenna ka kenne si'ii?","poem":1},{"text":"Yookiin morma isaatitti","poem":2},{"lineBreak":true},{"text":"gama","poem":2},{"noteId":33},{"text":"dhedheeraa ka uffise si'ii?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Akka korophiisaa kuruphisaa fooqqisaa","poem":1},{"text":"akka inni nama bararassu ka godhu si'ii?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Fardi jabeenna ifiititti addatiisaan","poem":1},{"text":"kotte'een lafa qotaa himimmisee,","poem":2},{"lineBreak":true},{"text":"loliisaaf hin baya.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Inni soda'atti kolla; womaa hin sodaatu;","poem":1},{"text":"shallaagaa irralle'ee duubatti hin deebi'u.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Eboon balaqqittuu fi marcaan","poem":1},{"text":"subba daayaa woliin","poem":2},{"lineBreak":true},{"text":"cinaacha isaatitti bubbu'ee qilillisa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Fardi hollatee worraaqatee xinniqa;","poem":1},{"text":"yennaa tultullaan afuufamu hin sawwaanata.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Inni yennaa tultullaan afuufamu hin fooqqisa;","poem":1},{"text":"dhaadata abbootii duulaa,","poem":2},{"lineBreak":true},{"text":"hoga'aa fi lola fago'ottuu foolee fuudha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"«Cululleen qarummaa teetiin koolaan kaatee","poem":1},{"text":"gara kibbaatitti koola ifii badhifattii?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Risaan ajaja keetiin gubbaa irra ka'aa?","poem":1},{"text":"Allaattiin ajaja keetiin","poem":2},{"lineBreak":true},{"text":"mana ifii gaara irratti ijaarrattii?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Isiin rassaa ol ka'e irra le'aa","poem":1},{"text":"achitti mana ijaarratti;","poem":2},{"lineBreak":true},{"text":"rassaan sun kushee isi'ii ti.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Isiin achi jiraattee waan nyaattu dooyatti;","poem":1},{"text":"ilti isi'iille fago'otti waan gaadattu dhaggiti.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ilmeen isi'ii dhiiga xuuxatti;","poem":1},{"text":"isiille addee raqi jirutti dhagganti» jedhe.","poem":2}]}],"footnotes":[{"noteId":31,"caller":"+","text":"Godaan gaaraa: Bineensa re'ee fakkaatu ka gaara irra le'u.","reference":{"chapter":39,"verse":1}},{"noteId":32,"caller":"+","text":"Magariisa: Yookiin kushaankusha.","reference":{"chapter":39,"verse":8}},{"noteId":33,"caller":"+","text":"Gama: Gami rifeensa dheeraa lumma fardaa irratti latu.","reference":{"chapter":39,"verse":19}}]},"thisChapterLink":"/api/gax_twf/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}