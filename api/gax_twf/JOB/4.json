{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":4,"content":[{"type":"heading","content":["Eliifaaz Iyoobitti Dubbate"]},{"type":"verse","number":1,"content":["Achiin duuba Eliifaaziin nami qachaa Temaanii deebisee,"]},{"type":"verse","number":2,"content":[{"text":"«Iyoob, yoo nami si woliin dubbatiisaaf sitti game","poem":1},{"text":"hin ossattuu ree?","poem":2},{"lineBreak":true},{"text":"Ammoo eentu dubbatuu lakkisaa ree?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ati namoota hedduu barsiitteerta;","poem":1},{"text":"worra dadhabaa harka qaddee jajjabeessiteerta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dubbiin teeti worra jigu utuddeerti;","poem":1},{"text":"worra jilbi isaanii laafelle jabeessiteerta.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Amma ammoo rakkoon sitti dhuttee,","poem":1},{"text":"addii kutatteerta;","poem":2},{"lineBreak":true},{"text":"waan sitti jabaattelle'eef,","poem":2},{"lineBreak":true},{"text":"jajjabeenna dhaddeerta.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Waaqa sodaatiis keeti,","poem":1},{"text":"isatti addatiisa keeti","poem":2},{"lineBreak":true},{"text":"qajeelummaan teetille","poem":2},{"lineBreak":true},{"text":"addii teetii motiiyyuu ree?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"«Me yaadadhu:","poem":1},{"text":"nami balleessaa hin qanne,","poem":2},{"lineBreak":true},{"text":"yookiin nami balchaan badee beekaa ree?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Akka ani dhaggetti","poem":1},{"text":"worri waan hantuu qotuu fi","poem":2},{"lineBreak":true},{"text":"rakkinna facaasu","poem":2},{"lineBreak":true},{"text":"waanuma san haammata.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isaan hafuura Waaqi isaanitti baafatuun","poem":1},{"text":"hin badan;","poem":2},{"lineBreak":true},{"text":"qilleensa aarii isaatille'een hin dhumatan.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Worri hamaan akka neenqaa dhangaa dhowa;","poem":1},{"text":"qoonqoolle ol qabatee iyya;","poem":2},{"text":"Waaqi ammoo","poem":1},{"text":"ilkaan isaanii hin caccassa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Akkuma neenqa waan adansee nyaatu dhabee du'uu","poem":1},{"text":"isaanille hin du'an.","poem":2},{"text":"Akkuma ilmeen neenqa dhala'aa bittinnoottu,","poem":1},{"text":"ijoolleen isaaniille hin bittinnootti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Gaafa tokko ergaan takka gara kiyya dhuttee,","poem":1},{"text":"gurri kiyyalle hasaassaa san dhage'e.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Halkan yennaa kolbaan hirriiba hamaa keessa jirtu,","poem":1},{"text":"ani mudhii na sodaachittu dhaggee,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"sodaadhee bararaqee,","poem":2},{"lineBreak":true},{"text":"lafeen tiyya duudiin hollatte.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Qilleensi fuula na dhowee,","poem":1},{"text":"nafi kiyya suugajjaye.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Achitti wonni takka dhaabbattuun dhagge;","poem":1},{"text":"ammoo maan akka teete beekuu hin dandeenne.","poem":2},{"text":"Achiin duuba cadheessa keessa,","poem":1},{"text":"qoonqoo takka:","poem":2}]},{"type":"verse","number":17,"content":[{"text":"‹Waaqa caalaa nami balchaa te'uu dande'aa?","poem":1},{"text":"Yookiin ka isa dade duratti","poem":2},{"lineBreak":true},{"text":"qulqulluu te'uu dande'aa?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Waaqi tajaajiltoota ifiituu","poem":1},{"text":"ka hin addanne eega teete,","poem":2},{"lineBreak":true},{"text":"ergantoota ifii ta ol-gubba'aa irralle'etti dokonkora ka dhaggu eega teete,","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"worra mana biyyee faaraa irraa hujamee,","poem":2},{"lineBreak":true},{"text":"ta hundeen isaa biyyee keessa jirtu","poem":2},{"lineBreak":true},{"text":"ka adoo qu'een hin nyaatin caccabu keessa le'anutti","poem":2},{"lineBreak":true},{"text":"attam addata ree?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Isaan ganamaa haga galgalaatitti hin badan;","poem":1},{"text":"adoo nami itti hin yaadatin","poem":2},{"lineBreak":true},{"text":"haga bara baraa hin badan.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Isaan akka dongoraa dunkaani'ii ka buqa'uu,","poem":1},{"text":"qarooma malee hin du'an› jettu dhage'e.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}