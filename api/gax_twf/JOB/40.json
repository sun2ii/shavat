{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":[{"text":"Ammalle Mootiin Waan Maraa Iyoobiin,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«Nami ana Waaqa waan mara dande'u morkee","poem":1},{"text":"hin sirreessaa ree?","poem":2},{"lineBreak":true},{"text":"Ka Waaqa moromu deebii kennuu ti» jedhe.","poem":2}]},{"type":"heading","content":["Iyoob"]},{"type":"verse","number":3,"content":["Achiin duuba Iyoob deebisee Mootii Waan Maraatiin,"]},{"type":"verse","number":4,"content":[{"text":"«Kunoo ani nami woy hin baane;","poem":1},{"text":"afaan kiyya qabatiisa malee,","poem":2},{"lineBreak":true},{"text":"maan si'iif deebisa ree?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ani takkaa dubbadheera,","poem":1},{"text":"waan deebisu hin qabu;","poem":2},{"lineBreak":true},{"text":"lammeessoolle dubbadheera,","poem":2},{"lineBreak":true},{"text":"haganaa achi itti hin dabalu» jedhe.","poem":2}]},{"type":"verse","number":6,"content":["Achiin duuba Mootiin Waan Maraa hobonbolattii keessaa Iyoobitti dubbatee,"]},{"type":"verse","number":7,"content":[{"text":"«Akka dhiiraa hidha keeti hidhadhu;","poem":1},{"text":"ani si gaafadha;","poem":2},{"lineBreak":true},{"text":"atille naaf deebis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Ati anaayyuu dokonkora keessa galchitaa?","poem":1},{"text":"Ati balchaa ifi godhiisaaf yakkaa natti murtaa?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ati hunna akka hunna tiyyaa qaddaa?","poem":1},{"text":"Qoonqoon teetille akka qoonqoo tiyyaa hin mandiitii?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Arnyaa fi guddinnaan ifi kuuladhu;","poem":1},{"text":"ulfinnaa fi fudhatama dhaggatiisa uffadhu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Worra kooru ilaaliitii qaanessi;","poem":1},{"text":"aarii teetille isaan irratti dhangalaas.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Worra kooru duudii gad qabi;","poem":1},{"text":"worra hamoota lafa isaan dhaabbatanetti butuchi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Fuula isaan mariitii","poem":1},{"text":"biyya lafaa ta jalaatitti","poem":2},{"lineBreak":true},{"text":"mara isaaniituu wolumatti awwaali.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Achiin duuba akka ati hunnuma teetiin injifattu,","poem":1},{"text":"anille dhugaa si'iif hin baya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«Roophii ta ani akkuma si dade, isiille dade ilaali;","poem":1},{"text":"isiin akkuma qotiyyo'oo marra dheeddi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Jabeenni isi'ii hidha isi'ii keessa,","poem":1},{"text":"hunni isi'ii morgeya gadhaa isi'ii keessa jirti.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Eegeen isi'ii akka hindheensaa sooti'i;","poem":1},{"text":"morgey miila isi'iille jaba'a.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Lafeen isi'ii akka uujjummee sageettu'uu ti;","poem":1},{"text":"harkii fi miilli isi'ii akka ulee sibiilaa ti.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Isiin dada ani dade duudii keessaa ta qaraa","poem":1},{"noteId":34},{"text":"ti;","poem":1},{"text":"ana malee ka isii injifatu hin jiru.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Gaaroti bineensoti duudiin irra burraaqanu,","poem":1},{"text":"marra isiin dheeddu baasaniif.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Isiin haxanxarii qore'ee","poem":1},{"noteId":35},{"text":"jala ciittee,","poem":1},{"text":"caffaa","poem":2},{"noteId":36},{"text":"keessa","poem":2},{"lineBreak":true},{"text":"odduu alladdu'uutitti dhokatti.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Haxanxariin qore'ee gaaddisa ifiitiin isii golliti;","poem":1},{"text":"muki olaati'iille isii hin marsa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yennaa lagi guutee danbala'u hin sodaattu;","poem":1},{"text":"lagi Yordaanosii guutulle hin rifattu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Eennulle adoo ilti roophi'ii dhaggituu isii qabuu,","poem":1},{"text":"yookiin malxaqqo'oon funnaan isi'ii uruu dande'a ree?","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":34,"caller":"+","text":"Ta qaraa: jechuun kun yennaa yookiin barbaachisummaa yookiin guddinna isi'ii ilaaluu dande'a.","reference":{"chapter":40,"verse":19}},{"noteId":35,"caller":"+","text":"Haxanxarii qore'ee: Yookiin hammarroo jedhamuu dande'a.","reference":{"chapter":40,"verse":21}},{"noteId":36,"caller":"+","text":"Caffaa: Yookiin raaroo dhoqqe'ee.","reference":{"chapter":40,"verse":21}}]},"thisChapterLink":"/api/gax_twf/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":24}