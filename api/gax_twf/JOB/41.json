{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"«Ati bineensa naacha fakkaatu,","poem":1},{"text":"ka ‹Lewaataan› jedhamu malxaqqo'oon qabuu,","poem":2},{"lineBreak":true},{"text":"yookiin arraba isaa","poem":2},{"lineBreak":true},{"text":"wodaro'oon hidhuu hin dandeettaa ree?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wodaroo funnaan isaa keessa baasuu,","poem":1},{"text":"yookiin a'oo isaa malxaqqo'oon woraanuu","poem":2},{"lineBreak":true},{"text":"hin dandeettaa ree?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inni akka ati isaaf marartu si hin kadhatta ree?","poem":1},{"text":"Dubbii laattuulle'een sitti hin dubbataa ree?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Haga bara baraa akka ati garba isa godhattuuf,","poem":1},{"text":"wolii galtee si woliin hin godhataa ree?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Akka sinbirree mana barattee","poem":1},{"text":"isa woliin taphatuu hin dandeettaa ree?","poem":2},{"lineBreak":true},{"text":"Yookiin tapha ijoollee durraa teetiitiif","poem":2},{"lineBreak":true},{"text":"isa hin hiitaa ree?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Daldaltooti qurxummi'ii gatii isaa irratti","poem":1},{"text":"wol hin falmanii ree?","poem":2},{"lineBreak":true},{"text":"Kukkutaneelle hin qoodatanii ree?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gogaa isaa ebo'oon,","poem":1},{"text":"mataa isaalle marcaa qurxummi'iitiin","poem":2},{"lineBreak":true},{"text":"uriisa hin dandeettaa ree?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Harka keetiin yoo isa tuxxe,","poem":1},{"text":"lola san hin qaabatta;","poem":2},{"lineBreak":true},{"text":"ijjumaalle itti hin deebitu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bineensa san lolanee injifatiisaaf wodhaaniis","poem":1},{"text":"toluma elowiisa;","poem":2},{"lineBreak":true},{"text":"nami isa dhaggu sheephisee jiga.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Isa kakkaasiisaaf ka itti guulu eega hin jirre teete,","poem":1},{"text":"eentu na dura dhaabbatiisa dande'a ree?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wonni ol-gubba'aan jala jirtu marti tiyya;","poem":1},{"text":"akka ani isaaf deebisee kaffalu","poem":2},{"lineBreak":true},{"text":"waan tokkolle ka anaa kenneeru hin jiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Ani marroo harkaa fi miila,","poem":1},{"text":"yookiin jabeenna,","poem":2},{"lineBreak":true},{"text":"yookiin miidhaginna","poem":2},{"lineBreak":true},{"text":"dhaaba nafa bineensa naacha fakkaatu,","poem":2},{"lineBreak":true},{"text":"ka ‹Lewaataan› jedhamuu","poem":2},{"lineBreak":true},{"text":"dubbadhu malee hin cadhisu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gogaa nafa isaa ka dachaa te'e,","poem":1},{"text":"eentu isa irraa quncisuu dande'a?","poem":2},{"lineBreak":true},{"text":"Eentu bixaalaan isatti dhikaatuu dande'a?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Balbala afaan isaa ka ilkaan sodaachisu itti naannowe,","poem":1},{"text":"eentu banuu dande'a?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Inni dudda jabaa","poem":1},{"text":"akka wontee tarree galtee wolitti maxxanfantee qaba.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tokko tokkoon wontee sanii","poem":1},{"text":"wol wolitti guddoo waan dhikaataneeranuuf","poem":2},{"lineBreak":true},{"text":"qilleensi wodhakkaa isaanii dabaruu hin dande'u.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Isaan wol wolitti waan maxxananeeranuuf,","poem":1},{"text":"wol irraa gargar bayuu hin dande'anu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yennaa inni haxxifatu ifi hin balaqqisa;","poem":1},{"text":"ilti isaa akka boruu dayya'uu ti.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Afaan isaa keessaa bobe'a ibiddaatitti baya;","poem":1},{"text":"qaanqeen ibiddaalle afaan isaa keessaa xoxxi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Akkuma aarri okkotee ibidda o'aa irra jirtu keessaa aaru,","poem":1},{"text":"aarri funnaan isaa keessaa baya.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hafuurri isaa cilee qassiisa;","poem":1},{"text":"bobeenni ibiddaalle afaan isaa keessaa baya.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Jabeenni lumma isaa keessa jira;","poem":1},{"text":"ka isaan wolde'u marti hin bararaqa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Dachaan foon isaa wolitti maxxaneera;","poem":1},{"text":"dachaan foon isaa jaba'a; hin tacho'ulle'e.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Gadhaan isaa akka dhaka'aa jaba'a;","poem":1},{"text":"akka daaku'uulle jaba'a.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yennaa inni ka'u","poem":1},{"text":"worri hunnaameyyiin hin bararaqa;","poem":2},{"lineBreak":true},{"text":"yennaa inni tacho'ulle gara duubaa deebi'an.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Shallaagaan, eboon, guube'ee fi","poem":1},{"text":"mey woraanaa dhibiille","poem":2},{"lineBreak":true},{"text":"isa hin miidhanu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Inni sibiila akka huuraa,","poem":1},{"text":"sageettuu akka muka hurroyee bulleessa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Daayi isa hin ari'u;","poem":1},{"text":"dhakaan looyya'aa","poem":2},{"noteId":37},{"text":"isaaf akka hicaace'ee ti.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ciiraan isaaf akka hicaace'ee ti;","poem":1},{"text":"yennaa nami marcaa isatti darbatu hin kolla.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Gogaan gadhaa isaa jalaa","poem":1},{"text":"akka bassoo qara qadduu,","poem":2},{"lineBreak":true},{"text":"yennaa inni mirmiqu","poem":2},{"lineBreak":true},{"text":"dhoqqee irratti beessisa godha.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Inni qilee abbaaya'aa, akka keloo danfituu,","poem":1},{"text":"abbaayaalle akka keloo zayiti'ii hin burqisiisa.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Inni karaa irra dabare akka ifu hin godha;","poem":1},{"text":"abbaayaalle hin hoomachessa.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Biyya lafaa irra","poem":1},{"text":"dadi woy hin sodaanne","poem":2},{"lineBreak":true},{"text":"ta akka isaa hin jirtu.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Inni bineensota gugurdaa maraayyuu hin tuffata;","poem":1},{"text":"inni bineensota gugurdaa mara irratti mooti'i» jedhe.","poem":2}]}],"footnotes":[{"noteId":37,"caller":"+","text":"Looyyaa: Yaadannoo 1 Sam. 17:40 irratti kenname ilaali.","reference":{"chapter":41,"verse":28}}]},"thisChapterLink":"/api/gax_twf/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":34}