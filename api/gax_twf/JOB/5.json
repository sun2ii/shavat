{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"«Iyoob! Nama deebii siif kennu","poem":1},{"text":"yoo dhaggatte waami;","poem":2},{"lineBreak":true},{"text":"woyyoota","poem":2},{"noteId":0},{"text":"keessaa","poem":2},{"lineBreak":true},{"text":"gara kamii ilaalta?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nama gowwaa aari'iittuu ijjeesa;","poem":1},{"text":"wollaalaalle gaabbi'ittuu ijjeesa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gowwaan hidda naqatuun dhaggeera;","poem":1},{"text":"ammoo dedhuma manni isaa abaarame","poem":2},{"noteId":1},{"text":".","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ijoolleen isaa ijjumaa nageya hin dhaggattu;","poem":1},{"text":"badhinna dalleya keessaa keessatti","poem":2},{"lineBreak":true},{"text":"miidhaan isaan irra hin geetti,","poem":2},{"lineBreak":true},{"text":"nami isaan baasulle hin jiraatu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Worri beelowe","poem":1},{"text":"midhaan isaa hin nyaata;","poem":2},{"lineBreak":true},{"text":"ka qoree keessatti latelle hin lakkisanuuf.","poem":2},{"text":"Worri dheebote","poem":1},{"text":"qabeenna isaa hin saama.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Rakkoon biyyee keessaa ol hin baatu;","poem":1},{"text":"gaargalli lafa irraa hin latu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Akkuma qaanqeen ibiddaa ol facaatu,","poem":1},{"text":"nami rakkinnaaf dhalata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Adoo na te'e","poem":1},{"text":"Waaqa hin barbaadadha,","poem":2},{"lineBreak":true},{"text":"rakkoo tiyyalle isatti hin himadha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inni waan gugurda'aa hin qorqoranne","poem":1},{"text":"bilbaasa laakkowanee hin dandeennelle hin godha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Inni lafa irratti bokkeya hin roobisiisa;","poem":1},{"text":"fichaalle bisaan hin obaasa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Worra gad qabame","poem":1},{"text":"addee ulfinnaa hin keya;","poem":2},{"lineBreak":true},{"text":"worra gadde addee nageyaatitti ol hin fuudha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Worri maltooleen waan hujanu","poem":1},{"text":"akka hin muummessineef,","poem":2},{"lineBreak":true},{"text":"inni karoora isaanii hin gufachiisa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Inni qaroolee maltummaa isaaniitiinuu qaba;","poem":1},{"text":"mala maltoole'eelle hin balleessa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Guyyaan isaanitti dukkanowee,","poem":1},{"text":"akka halkaniititti","poem":2},{"lineBreak":true},{"text":"saafowaan qaqqabataa deemanuu ti.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Worra hiyyeeyyii","poem":1},{"text":"afaan shallaagaa diina isaanii jalaa,","poem":2},{"lineBreak":true},{"text":"harka worra isaan cunqursuu jalalle'ee hin baasa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Inni hiyyeeyyi'iif addii hin kenna,","poem":1},{"text":"afaan worra hama'aa hin cufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«Nami Waaqi xixu ka gammade!","poem":1},{"text":"Tanaaf xixicha Waaqa","poem":2},{"lineBreak":true},{"text":"waan mara dande'uu hin tuffatin.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Waaqi hin madeessa","poem":1},{"text":"ammoo deebisee hin hodha;","poem":2},{"lineBreak":true},{"text":"inni si hin miidha","poem":2},{"lineBreak":true},{"text":"harka ifiitiin ammoo si hin fayyisa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Inni balaa jaa jalaa si hin baasa;","poem":1},{"text":"torbeessoo irralle'etti miidham si hin tuqu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bara beelaa du'a irraa,","poem":1},{"text":"lola keessatti shallaagaa irraa si hin woda.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Waaqi arraba hamaa irraa si hin eega;","poem":1},{"text":"yoo badiin sitti dhuttelle hin sodaattu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Badi'ii fi beelatti hin kollita;","poem":1},{"text":"bineensalle hin sodaattu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Fichaa qotattutti dhakaan si hin rakkisu;","poem":1},{"text":"bineensotille si woliin nageya hin qabaatan.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Dunkaaniin teeti nageyaan akka jirtu hin beetta;","poem":1},{"text":"yennaa hoolee teeti toowattu","poem":2},{"lineBreak":true},{"text":"nageyaan isaan hin dhaggita.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Sanyiin teeti hedduu,","poem":1},{"text":"ijoolleen teetille","poem":2},{"lineBreak":true},{"text":"akka marra lafaa akka teetu hin beetta.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Akkuma qamadiin yennaa ifiititti","poem":1},{"text":"wolitti qabantu","poem":2},{"lineBreak":true},{"text":"atille dulloontee, geettee hin duuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"«Kunoo, nuuti tana duudii qorqorreerra;","poem":1},{"text":"tun dhuga'a;","poem":2},{"lineBreak":true},{"text":"atille dhage'iitii beeki» jedhe.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Woyyoota: Isaan kun ergantoota Waaqaa ti.","reference":{"chapter":5,"verse":1}},{"noteId":1,"caller":"+","text":"Abaarame: Yookiin diigame.","reference":{"chapter":5,"verse":3}}]},"thisChapterLink":"/api/gax_twf/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}