{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":6,"content":[{"type":"heading","content":["Iyoob Deebii Kenne"]},{"type":"verse","number":1,"content":["Achiin duuba Iyoob deebisee,"]},{"type":"verse","number":2,"content":[{"text":"«Farri tiyya adoo madaalantee,","poem":1},{"text":"gaargalli kiyya duudiin","poem":2},{"lineBreak":true},{"text":"madaallii irra adoo keyamee jiraatee,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"maansa irga abbaaya'aa caalaa ulfaataayyu;","poem":2},{"lineBreak":true},{"text":"tanaaf jarjariisaan dubbatiis kiyya","poem":2},{"lineBreak":true},{"text":"si hin baaseffachiittu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Waaqi waan mara dande'u","poem":1},{"text":"daaya ifiitiin na woraanee,","poem":2},{"lineBreak":true},{"text":"hadhaan isaalle","poem":2},{"lineBreak":true},{"text":"nafa keessa na faca'eera.","poem":2},{"text":"Bararaqiisi Waaqaa na marseera.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Harreen diidaa yennaa marra dheeddu,","poem":1},{"text":"Yookiin qotiyyoon yennaa okeya nyaattu","poem":2},{"lineBreak":true},{"text":"hin baroodii ree?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sagalee hin mi'oonne","poem":1},{"text":"soodda malee nyaatanii ree?","poem":2},{"text":"Yookiin bisaan quupha'aa","poem":1},{"text":"hin mi'owaa ree?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ani sagalee akkasii tuqiisalle hin jibba;","poem":1},{"text":"yoo nyaadhelle akka dhibamu na gooti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Maaloo waan gaafadhe","poem":1},{"text":"adoo dhaggadhee,","poem":2},{"lineBreak":true},{"text":"Waaqi halchaa tiyya","poem":2},{"lineBreak":true},{"text":"adoo naaf guutee!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Fedha isaa teetee adoo na caccassee,","poem":1},{"text":"harka ifii diriirsee adoo na balleessee,","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"tun silaa naaf jajjabeenna.","poem":2},{"text":"Ani jecha Waaqa woyyichaa","poem":1},{"text":"waan hin mormatiniif,","poem":2},{"lineBreak":true},{"text":"dhibeen natti fakkantulle","poem":2},{"lineBreak":true},{"text":"ani silaa gammadaan hin utaalaayyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Jiru'uun le'iisaaf","poem":1},{"text":"jabeenna maan qaba ree?","poem":2},{"text":"Eega addii hin qabaatinii","poem":1},{"text":"maaf le'a ree?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Jabeenni kiyya jabeenna dhaka'aatii ree?","poem":1},{"lineBreak":true},{"text":"Foon kiyya sageettu'uu ree?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Dhugumaan ifi qarqaariisaaf hunna hin qabu;","poem":1},{"text":"hunni tiyya duudiin na irraa fudhatanteerti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Nami jaala ifii ka rakkatteef marartii dhabu,","poem":1},{"text":"Waaqa waan mara dande'u sodaatiisa lakkiseera.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Isin obboleeyyan tiyya ammoo,","poem":1},{"text":"akka laga yennaa roobi hin jirree goguu","poem":2},{"lineBreak":true},{"text":"na soddane.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Lagi sun ji'a gannaa","poem":1},{"text":"dhakaa roobaatiin guutama.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yennaa o'aa ammoo lagi sun hin dhabama;","poem":1},{"text":"yennaa bonaa hin goga.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Daldaltooti bisaan barbaadata karaa irraa miliqanee,","poem":1},{"text":"goomolee keessa daaqaa badan.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Daldaltooti Teema'aa","poem":1},{"text":"bisaan hin barbaadatan;","poem":2},{"lineBreak":true},{"text":"daldaltooti Sheebaalle bisaan","poem":2},{"lineBreak":true},{"text":"dhaggatiisaaf addii godhatan.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Lagi isaan addatanu waan gogeef","poem":1},{"text":"addii hin kutatan;","poem":2},{"lineBreak":true},{"text":"addee san yennaa geyanu","poem":2},{"lineBreak":true},{"text":"hin bilinjoyan.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Isinille akkuma laga goge sanii","poem":1},{"text":"natti teetane;","poem":2},{"lineBreak":true},{"text":"farra tiyya dhaggitanee sodaattane.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ani ‹Woy naaf kenna'a!","poem":1},{"text":"Karra teessaniin na woda'a!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yookiin harka diinaa jalaa na baasa'a;","poem":1},{"text":"yookiin harka worra na cunqursuu jalaa","poem":2},{"lineBreak":true},{"text":"na woda'a!› jedheeraa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"«Ani hin cadhisa,","poem":1},{"text":"isin na barsiisa'a;","poem":2},{"lineBreak":true},{"text":"dokonkora kiyyalle natti hima'a.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Dubbiin dhuga'aa","poem":1},{"text":"attam attam hunnaametti'i!","poem":2},{"text":"Komiin teessan ammoo bu'aa hin qaddu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Isin dubbii tiyya","poem":1},{"text":"sirreessuu barbaaddanii?","poem":2},{"text":"Dubbii ana nama addii kutateelle","poem":1},{"text":"akka qilleensaatitti laakkottanii ree?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ijoollee haadhaa fi abbaa hin qanne irratti,","poem":1},{"text":"hixaa buufattan;","poem":2},{"lineBreak":true},{"text":"jaalota teessanille gurguriisaaf gadhassiittan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"«Amma ammoo, maganne'ee gara kiyya ilaala'a!","poem":1},{"lineBreak":true},{"text":"Ani fuula keessan duratti dhara hin dubbadhaa?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Deebi'a'a; worra muraa dharaa muru hin te'ina'a;","poem":1},{"text":"ammalle deebi'a'a;","poem":2},{"lineBreak":true},{"text":"ani dhugaa irra jira.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Arraba kiyya irra dokonkorri hin jiraa?","poem":1},{"text":"afaan kiyya waan hantuu","poem":2},{"lineBreak":true},{"text":"addaan baasuu hin dande'uu ree?","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JOB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}