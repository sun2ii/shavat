{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"«Nami elo'oon lafa irra jiraataa motii?","poem":1},{"lineBreak":true},{"text":"Barri isaalle akka bara","poem":1},{"text":"nama qaxaramee hujuutii motii ree?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Akka garboolee gaaddisa jala foorfatiisa barbaadanuutii fi","poem":1},{"text":"akka hojjatoota mindaa ifii eegatanuutii mootii?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ji'ooti elo'oo naaf ka bu'aa hin qanne te'ane;","poem":1},{"text":"halkan farraalle","poem":2},{"lineBreak":true},{"text":"naaf kennamane.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yennaa rafu ‹Yoom dammaqa?› jedhaa,","poem":1},{"text":"halkan natti dheeratee,","poem":2},{"lineBreak":true},{"text":"haga bariitutti asii fi achi","poem":2},{"lineBreak":true},{"text":"gara gaggala.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nafi kiyya duudiin","poem":1},{"text":"corroqoyee qonyonyaayeera;","poem":2},{"lineBreak":true},{"text":"babbaqaqeelle maloweera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Barri kiyya mooqaa harfa'aa","poem":1},{"noteId":2},{"text":"caalaa ariifata;","poem":2},{"lineBreak":true},{"text":"addii maleelle dhumata.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ee Waaqa, jiruun tiyya akka hafuura baafatiisaa fi fudhatiisaa ti;","poem":1},{"text":"ilti tiyya deebitee waan dansaa hin dhaggitu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ilti amma na dhaggitu,","poem":1},{"text":"deebitee na hin dhaggitu;","poem":2},{"lineBreak":true},{"text":"ati na hin barbaadda ani ammoo hin jiru.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akkuma duumensi bittinnowee badu,","poem":1},{"text":"nami du'ee awwaalamu deebi'ee hin ka'u.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lammoo gara mana ifii hin deebi'u;","poem":1},{"text":"worri isa beeku duudiin isa hin dedha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Tanaaf ani hin cadhisu;","poem":1},{"text":"laalaa ayyaana kiyyaa hin dubbadha;","poem":2},{"lineBreak":true},{"text":"hadhaa lubbuu tiyyaa irraa ta kaate hin gunguma.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ati akka na eeganuuf ka goote,","poem":1},{"text":"ani abbaaya'a moo bineensa guddaa abbaaya'aa ti?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Taqeen tiyya na jajjabeessiti;","poem":1},{"text":"addeen ani rafu dhibee tiyya irraa goonsiti","poem":2},{"lineBreak":true},{"text":"yennaa jedhu,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ati ammoo oojju'uun na sodaachitta;","poem":2},{"lineBreak":true},{"text":"mudhille'een na bararassita.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Jiruu farraa tanaa mannaa","poem":1},{"text":"suruurraa ifitti dhowee","poem":2},{"lineBreak":true},{"text":"du'u naaf woyya.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ani jiruu tiyya jibbeera;","poem":1},{"text":"haga bara baraa le'iisa hin barbaadu;","poem":2},{"lineBreak":true},{"text":"barri jiruu tiyyaa gabaabaa","poem":2},{"noteId":3},{"text":"waan te'eef","poem":2},{"lineBreak":true},{"text":"na lakkis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«Akka nama barbaachisaa te'e tokkootitti akka isa ilaaltuuf,","poem":1},{"text":"akka guddoo isa yaadattuufille nami maan inni?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ati ganama ganama isa hin ilaalta;","poem":1},{"text":"yennaa mara isa hin qorqorta.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Haguma hancufa liqinsu","poem":1},{"text":"ila ana irra hin deebifattuu?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Waaqa namoota eeddu,","poem":1},{"text":"ani yoo cubbuu huje maan si godhe?","poem":2},{"text":"Maaf waan itti xiyyeeffattu na godhatte?","poem":1},{"text":"Ani hagana mara ba'aa sitti te'ee?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ati maaf balleessaa tiyya naaf hin araaramin?","poem":1},{"text":"Maaf yakkaa tiyya ana irraa hin balleessin?","poem":2},{"text":"Ani amma waan awwaalamuuf,","poem":1},{"text":"ati na hin barbaadda,","poem":2},{"lineBreak":true},{"text":"ani ammoo hin jiru» jedhe.","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Mooqaa harfa'aa: Mooqaan harfa'aa kun ka worri woyaa dhowu suqaa keessa keyee gamaa fi gamanatti qolaanfatu.","reference":{"chapter":7,"verse":6}},{"noteId":3,"caller":"+","text":"Gabaabaa: Afaan Ibrootaatiin baafata hafuuraa tokko jedha.","reference":{"chapter":7,"verse":16}}]},"thisChapterLink":"/api/gax_twf/JOB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/6.json","previousChapterAudioLinks":{},"numberOfVerses":21}