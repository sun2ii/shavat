{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":8,"content":[{"type":"heading","content":["Biildaad"]},{"type":"verse","number":1,"content":[{"text":"Achiin duuba Biildaad nami biyya Shu'aa deebisee,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«Haga yoomii dubbii akkasii dubbatta?","poem":1},{"text":"Dubbiin afaan keetii baatu","poem":2},{"lineBreak":true},{"text":"akka qilleensaa ti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Waaqi muraa hin dassaa?","poem":1},{"text":"Yookiin Waaqi waan mara dande'u","poem":2},{"lineBreak":true},{"text":"dhugaa hin dassaa?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ijoolleen teeti yoo Waaqa yakkitee jiraattee,","poem":1},{"text":"inni adabbii cubbuu isaaniitiif","poem":2},{"lineBreak":true},{"text":"dabarsee isaan kenne.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ati ammoo yoo Waaqa barbaaddee,","poem":1},{"text":"Waaqa waan mara dande'ulle yoo gaafatte,","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ati qullu'uu fi qajeelaa yoo teete,","poem":2},{"lineBreak":true},{"text":"inni dhugumaan si qarqaariisaaf hin ka'a;","poem":2},{"lineBreak":true},{"text":"gara addee teetii","poem":2},{"lineBreak":true},{"text":"ta si'iif maltetti si hin deebisa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Jalqabi keeti diqqaa te'ulle,","poem":1},{"text":"muummee irratti hin banqaaxxa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Me dhaloota durii gaafadhu","poem":1},{"text":"waan abbootiin isaanii qorqoranee dhagganelle qalbeeffadhu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nuuti kalee waan dhalanneef,","poem":1},{"text":"womaalle hin beennu.","poem":2},{"text":"Barri keenna ka biyya lafaa irraalle","poem":1},{"text":"akka gaaddisaa dabara.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wonni isaan si barsiisanuu fi sitti himanu","poem":1},{"text":"waan hubataneeranuu motii ree?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Allaaduun addee caffaan hin jirretti","poem":1},{"text":"latuu dandeettii ree?","poem":2},{"text":"Addee bisaan hin jirretti","poem":1},{"text":"shonbooqqoon hin banqaaxxii ree?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Adoo kichu'uutuu","poem":1},{"text":"adoo hin muramin","poem":2},{"lineBreak":true},{"text":"biqiltoota dhibi'iin dura hin qooran.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Worri Waaqa dedhu duudiin","poem":1},{"text":"akkasuma;","poem":2},{"lineBreak":true},{"text":"addiin nama Waaqa malee le'uu hin baddi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Inni waan akka kaso'otti citutti addata;","poem":1},{"text":"addiin isaalle mana saaphuphu'uu","poem":2},{"noteId":4},{"text":"ti.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nami tokko mana saaphuphu'uutitti","poem":1},{"text":"yoo irkate, manni sun hin dhaabbatu.","poem":2},{"text":"Inni mana san yoo qabate,","poem":1},{"text":"isa duraa hin cita.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nami hamaan akka biqiltuu aduu keessatti dagaaguu ti;","poem":1},{"text":"dameen isaa oorruu gubbaa babadhata.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hiddi isaa tuulaa dhaka'aatitti marata;","poem":1},{"text":"odduu rassa'aa keessalle karaa barbaadata.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nami tokko addee isaa irraa yoo isa buqqise,","poem":1},{"text":"addeen sun,","poem":2},{"lineBreak":true},{"text":"‹Ani si dhaggee hin beeku›","poem":2},{"lineBreak":true},{"text":"jettee isa hin mormatti.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kunoo, gammadi jiruu hidda sanii kanuma;","poem":1},{"text":"biqiltuun dhibiin lafa san keessaa hin latan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«Waaqi worra komii hin qanne hin gatu;","poem":1},{"text":"yookiin worra hantuu huju hin qarqaaru.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Inni akka ati kollituu fi","poem":1},{"text":"ilillittu si hin godha.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Worri si jibbu qaanii uffata;","poem":1},{"text":"dunkaaniin worra hama'aa hin baddi» jedhe.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Saaphuphuu: Worri tokko tokko baatti-baarree jedhan.","reference":{"chapter":8,"verse":14}}]},"thisChapterLink":"/api/gax_twf/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}