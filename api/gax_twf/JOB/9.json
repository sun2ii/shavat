{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOB","translationId":"gax_twf","name":"Kitaaba Iyoobii","commonName":"Kitaaba Iyoobii","title":"Kitaaba Iyoobii","order":18,"numberOfChapters":42,"sha256":"d95bc7ab7a8b2a2fc1f4fbd267bef79fa391351586917e027960fb4381cb1aa9","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gax_twf/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":9,"content":[{"type":"heading","content":["Iyoob"]},{"type":"verse","number":1,"content":["Achiin duuba Iyoob deebisee,"]},{"type":"verse","number":2,"content":[{"text":"«Dhuguma tun dhugaa","poem":1},{"text":"akka teete hin beeka.","poem":2},{"text":"Ammoo nami attam Waaqa duratti","poem":1},{"text":"balchaa te'uu dande'a ree?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nami tokko Waaqaan falmuu","poem":1},{"text":"yoo barbaade,","poem":2},{"lineBreak":true},{"text":"gaaffii kuma keessaa takkattiille","poem":2},{"lineBreak":true},{"text":"deebisee hin dande'u.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Waaqi qaro'o; hunnaamessalle'e;","poem":1},{"text":"ka isa moromee,","poem":2},{"lineBreak":true},{"text":"hin injifatamin eennuu?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inni dedhuma gaara tatachoosee,","poem":1},{"text":"aarii ifiitiin isaan hin balleessa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Waaqi lafa addee isi'ii irraa hin tachoosa;","poem":1},{"text":"utuboota lafaalle hin raasa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni aduun akka hin baane hin ajaja;","poem":1},{"text":"urjootille ifa akka hin kennine hin dhoogga.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inni qofuu ol-gubbaa diriirse;","poem":1},{"text":"danbalii bisaanii irralle hin ideema.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tuuta urjootaa ka bineensa, ‹Doobbaa","poem":1},{"noteId":5},{"text":"› jedhamu fakkaatu,","poem":1},{"text":"tuuta urjootaa ka, ‹Sadee","poem":2},{"noteId":6},{"text":"› jedhamu,","poem":2},{"lineBreak":true},{"text":"tuuta urjootaa ka, ‹Torbii","poem":2},{"noteId":7},{"text":"› jedhamuu fi","poem":2},{"lineBreak":true},{"text":"tuuta urjoota gara kibbaalle isatti dade.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Waan maade'ee ta qorqoranee bira hin geenne,","poem":1},{"text":"bilbaasota laakkonnee hin dhaqqanne hin godha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yennaa inni na biraan dabaru,","poem":1},{"text":"ani isa hin dhaggu;","poem":2},{"lineBreak":true},{"text":"yennaa inni cinaa tiyya ideemu,","poem":2},{"lineBreak":true},{"text":"ani isa hin hubadhu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yoo inni butee ideeme,","poem":1},{"text":"eentu isa dhoogga?","poem":2},{"text":"Eentu isaan, ‹Ati maan godhiisatti jirta?› jedha.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Waaqi mufii ifii duubatti hin deebisu;","poem":1},{"text":"worri bineensa guddaa abbaayaa keessaa","poem":2},{"lineBreak":true},{"text":"ka, ‹Rahaab› jedhamu qarqaaruuyyuu isaaf hin sagadan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Ani attam","poem":1},{"text":"deebii isaaf kennuu dande'a ree?","poem":2},{"text":"Ani isa woliin falmiisaaf,","poem":1},{"text":"attamiin jechoota filatuu dande'a ree?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ani yakkaa qabaatuu yoo dhabelle,","poem":1},{"text":"abbaa mura'aa kiyya","poem":2},{"lineBreak":true},{"text":"akka naaf mararu gaafadha malee,","poem":2},{"lineBreak":true},{"text":"deebii isaaf kennuu hin dande'u.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ani maqaa isaa waammadhee","poem":1},{"text":"inni naaf yoo deebiselle,","poem":2},{"lineBreak":true},{"text":"akka inni qoonqoo tiyya dhage'u hin dhugeeffadhu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Inni bubbe'een na butucha;","poem":1},{"text":"sababa malee madaa natti baceessa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Inni hadha'aan na guuta malee,","poem":1},{"text":"hafuura na hin fudhachiisu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Marroo jabeennaa yoo teete,","poem":1},{"text":"inni jaba'a.","poem":2},{"text":"Marroo mura'aa yoo teete,","poem":1},{"text":"gara addee mura'aa san","poem":2},{"lineBreak":true},{"text":"ka isa waamuu dande'u eennu?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ani yakkaa qabaatuu dhabulle","poem":1},{"text":"afaan kiyyaayyuu natti mura;","poem":2},{"lineBreak":true},{"text":"ani ka komii hin qanne te'ulle,","poem":2},{"lineBreak":true},{"text":"‹Daba'a› anaan jedha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«Ani ka komii hin qanne te'ulle","poem":1},{"text":"marroo mataa kiyyaa hin beeku;","poem":2},{"lineBreak":true},{"text":"jiruu tiyyalle hin jibba.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Martinuu tokkuma;","poem":1},{"text":"tanaaf ani, ‹Waaqi worra komii hin qannee fi","poem":2},{"lineBreak":true},{"text":"worra hamaaleyyii hin balleessa› jedhe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yennaa balaan nama yakkaa hin qanne","poem":1},{"text":"dedhuma ijjeesu","poem":2},{"lineBreak":true},{"text":"Waaqi isatti hin qacifata.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yennaa latti harka","poem":1},{"text":"worra hamaaleyyi'iititti kennantu,","poem":2},{"lineBreak":true},{"text":"Waaqi ila abbootii mura'aa","poem":2},{"lineBreak":true},{"text":"ta lafa sanii hin golla.","poem":2},{"text":"Isa yoo hin te'in,","poem":1},{"text":"tana ka godhe eennu ree?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"«Barri kiyya nama rukkisu caalaa ariifata;","poem":1},{"text":"adoo waan dansaa hin dhagginuu dabara.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Akka hoboloo ariifattu'uu","poem":1},{"noteId":8},{"text":",","poem":1},{"text":"akka risaa waan nyaatu butatiisaaf irii gad xinniquu dabara.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ani, ‹Gungunsuu tiyya hin dedha;","poem":1},{"text":"nyaara guuruu lakkisee,","poem":2},{"lineBreak":true},{"text":"hin seeqadha› yoo jedhe,","poem":2}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"akka nama yakkaa hin qanneetitti","poem":2},{"lineBreak":true},{"text":"akka ati na hin ilaalle","poem":2},{"lineBreak":true},{"text":"waan beekuuf","poem":2},{"lineBreak":true},{"text":"farra tiyya duudii hin sodaadha.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Yakkaan eega natti murantu teete,","poem":1},{"text":"maaf toluma dadhaba ree?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Nafa kiyya saamunaan,","poem":1},{"text":"harka kiyya haraanja'aan","poem":2},{"lineBreak":true},{"text":"yoo dhiqadhelle,","poem":2}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"ati boolla haraa itti gatanu keessatti","poem":2},{"lineBreak":true},{"text":"na gatta;","poem":2},{"lineBreak":true},{"text":"woyaan tiyyaayyuu na jibbiti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"«Ani isa woliin","poem":1},{"text":"gara kora mura'aa dhaqee","poem":2},{"lineBreak":true},{"text":"deebii isaaf kenniisaaf,","poem":2},{"lineBreak":true},{"text":"inni akka kiyya nama foon uffatee moti.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Nami anaa fi Waaqa wolitti araarsiisaaf","poem":1},{"text":"wodhakkaa teennatti murtee kennu","poem":2},{"lineBreak":true},{"text":"adoo hin jiraatuu!","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Akka ani hin bararandheef,","poem":1},{"text":"adoo Waaqi na adabuu dhabe,","poem":2}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"ani sodaa malee,","poem":2},{"lineBreak":true},{"text":"silaa isa woliin hin dubbadhaayyu;","poem":2},{"lineBreak":true},{"text":"amma ammoo dubbatuu hin dandeenne.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":5,"caller":"+","text":"Doobbaa: Bineensa Iyyaa fakkaatu.","reference":{"chapter":9,"verse":9}},{"noteId":6,"caller":"+","text":"Sadee: Hiikkaan gariin Ooriyoon jedhan.","reference":{"chapter":9,"verse":9}},{"noteId":7,"caller":"+","text":"Torbii: Hiikkaan gariin Piliyaadis jedhan.","reference":{"chapter":9,"verse":9}},{"noteId":8,"caller":"+","text":"Akka hoboloo ariifattu'uu: Hoboloon allaaduu irraa hujante waan ariifattuuf, hiikkaan gariin akka hoboloo allaadu'uu jedhan.","reference":{"chapter":9,"verse":26}}]},"thisChapterLink":"/api/gax_twf/JOB/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOB/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/8.json","previousChapterAudioLinks":{},"numberOfVerses":35}