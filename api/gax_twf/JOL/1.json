{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOL","translationId":"gax_twf","name":"Yo'elii Raagichaa","commonName":"Yo'elii Raagichaa","title":"Kitaaba Yo'elii Raagichaa","order":29,"numberOfChapters":3,"sha256":"07cd7323e047cc017e2507ca5036b948f09325073dbe101d70ac6f374e1f0e13","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gax_twf/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"heading","content":["Hubiisa Awwaannisaa"]},{"type":"verse","number":1,"content":["Jechi Mootii Waan Maraa ka gara Yo'elii ilma Phetu'elii dhufe kana:"]},{"type":"verse","number":2,"content":[{"text":"Isin jaarsoleen dhage'a'a!","poem":1},{"text":"Worri Yihudaa keessa jirtanu dhage'a'a!","poem":2},{"text":"Wonni akkasii kun bara keessan keessatti,","poem":1},{"text":"yookiin bara abbootii teessanii keessatti teetee beettii?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Waan kana ijoollee teessanitti hima'a;","poem":1},{"text":"ijoolleen teessanille ijoollee ifiititti,","poem":2},{"lineBreak":true},{"text":"ijoolleen isaaniille dhaloota dhufutti himanuu ti!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ka ilmoolee awwaannisa irraa hafe,","poem":1},{"text":"awwaannisi dargageessi nyaate;","poem":2},{"lineBreak":true},{"text":"ka awwaannisa dargageessa irraa hafe,","poem":2},{"lineBreak":true},{"text":"awwaannisi gugurdaan nyaate;","poem":2},{"lineBreak":true},{"text":"ka awwaannisa gugurdaa irraa hafe,","poem":2},{"lineBreak":true},{"text":"korophiis nyaate.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Daadhiin woyni'ii waan isin irraa citteef,","poem":1},{"text":"isin worri machoottanu, dammaqa'aatii bowa'a!","poem":2},{"text":"Isinille worri daadhii woyni'ii untanu,","poem":1},{"text":"wiiccifadha'aa bowa'a!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kolbaan hunnaameyyiin bandallaan biyya tiyya tinteerti;","poem":1},{"text":"ilkaan isaanii akka ilkaan neenqaa,","poem":2},{"lineBreak":true},{"text":"a'oon isi'ii akka a'oo neenqa dhala'aa ti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Isaan woynii tiyya balleessane;","poem":1},{"text":"muka harru'uu kiyyalle mummurane;","poem":2},{"lineBreak":true},{"text":"quncee irraa quncisanee gatanee,","poem":2},{"lineBreak":true},{"text":"dameeleen addaattee hatte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Akka intala durraa woyaa gaddaa uffattee,","poem":1},{"text":"nami isii kadhatu waan du'eef boottuu,","poem":2},{"lineBreak":true},{"text":"isinille bowa'a!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kennaan midhaaniitii fi daadhii woyni'ii","poem":1},{"text":"Galma Mootii Waan Maraa irraa citte;","poem":2},{"lineBreak":true},{"text":"tanaaf hayyooti Mootii Waan Maraa tajaajilanu","poem":2},{"lineBreak":true},{"text":"wiiccifatanee bowan.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Fichaan duwwaa hafeera;","poem":1},{"text":"midhaan badeera;","poem":2},{"lineBreak":true},{"text":"muki woyni'ii gogeera;","poem":2},{"lineBreak":true},{"text":"muki ejersaalle qooreera;","poem":2},{"lineBreak":true},{"text":"tanaaf latti hin bootti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Qamadi'ii fi garbuun,","poem":1},{"text":"midhaan galfamu martinuu waan badeef,","poem":2},{"lineBreak":true},{"text":"isin qonnaan bultooti gadda'a!","poem":2},{"lineBreak":true},{"text":"Isin worri woynii dhaabulle bowa'a!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Muki woyni'iitii fi harru'uu qooreera;","poem":1},{"text":"muki rumaani'ii, muki meexxi'iitii fi appilii,","poem":2},{"lineBreak":true},{"text":"muki ficha'aa duudiin gogeera;","poem":2},{"lineBreak":true},{"text":"gammadi ilmaan namaa badeera.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kennaan midhaaniitii fi daadhii woyni'ii","poem":1},{"text":"ta Galma Waaqa keessaniitiif dhikeessitanu waan hin jirreef,","poem":2},{"lineBreak":true},{"text":"isin hayyooti woyaa gaddaa uffadha'aatii bowa'a!","poem":2},{"lineBreak":true},{"text":"Isin worri addee ciinca'aatitti tajaajiltanu, wiiccifadha'a!","poem":2},{"lineBreak":true},{"text":"Isin hayyooti Waaqa kiyya tajaajiltanu","poem":2},{"lineBreak":true},{"text":"woyaa gaddaa uffadha'aatii halkan duudii bowa'a!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Laamaa woyyicha lassa'a!","poem":1},{"text":"Yaa'ii woyyittii waama'a!","poem":2},{"lineBreak":true},{"text":"Jaarsole'ee fi worra biyya san le'anu mara,","poem":2},{"lineBreak":true},{"text":"Galma Mootii Waan Maraa Waaqaa keessaniititti wolitti qaba'a!","poem":2},{"lineBreak":true},{"text":"Gara Mootii Waan Maraalle iyya'a!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Aanne'e! Guyyaan Mootii Waan Maraa dhikaateera!","poem":1},{"text":"Waaqi waan mara dande'u guyyaan inni badii fidu dhikaateera.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Sagaleen ila teenna duraa,","poem":1},{"text":"gammadii fi ililleessi Galma Waaqa keennaa keessaa,","poem":2},{"lineBreak":true},{"text":"ijjumaa badeera.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sanyiin facaafante biyyee jalatti korondhatteerti.","poem":1},{"text":"Midhaan waan badeef, manni kuusaa duwweera;","poem":2},{"lineBreak":true},{"text":"gootaraalle diigameera.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Loon marra waan dhabaneef, madhataa asii achi yaa'an;","poem":1},{"text":"hoolotille rakkatiissatti jiran.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ee Mootii Waan Maraa! Marra diidaa ibiddi waan fixeef,","poem":1},{"text":"muka badda'aalle ibiddi waan gubeef,","poem":2},{"lineBreak":true},{"text":"ani gara keeti iyya.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Maddi bisaanii isaan irraa waan gogeef,","poem":1},{"text":"marri diidaa isaan irraa waan gubateef,","poem":2},{"lineBreak":true},{"text":"bineensinuu gara keeti iyya.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}