{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JOL","translationId":"gax_twf","name":"Yo'elii Raagichaa","commonName":"Yo'elii Raagichaa","title":"Kitaaba Yo'elii Raagichaa","order":29,"numberOfChapters":3,"sha256":"07cd7323e047cc017e2507ca5036b948f09325073dbe101d70ac6f374e1f0e13","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gax_twf/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["Guyyaa Mootii Waan Maraa"]},{"type":"verse","number":1,"content":["Xiyoonitti tultullaa afuufa'a!",{"text":"Gaara Xiyoonii woyyicha irratti","poem":2},{"lineBreak":true},{"text":"qoonqoo dammassitu dhageessisa'a!","poem":2},{"text":"Guyyaan Mootii Waan Maraa ariifatee waan dhufaaruuf,","poem":1},{"text":"worri lafa san le'u marti hollatuu ti!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Guyyaan sun guyyaa dukkanaatii fi dimimmisaa,","poem":1},{"text":"guyyaa duumensaatii fi dukkana duuddu'uu ti;","poem":2},{"lineBreak":true},{"text":"akka boruun dayya'ee gaara irra babadhatu,","poem":2},{"lineBreak":true},{"text":"awwaannisi baca'aa fi hunnaamessi lafa guuta.","poem":2},{"text":"Wonni waan kana fakkaatu tanaan dura hin teene,","poem":1},{"text":"haganaa achille ijjumaa hin teetu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dura isaaniitiin ibiddi gubaa deema;","poem":1},{"text":"duuba isaaniille'een bobe'i gubaa deema;","poem":2},{"lineBreak":true},{"text":"latti isaan bira hin geyin,","poem":2},{"lineBreak":true},{"text":"oorruu Edenii fakkaatti;","poem":2},{"lineBreak":true},{"text":"latti isaan bira dabarane ammoo,","poem":2},{"lineBreak":true},{"text":"goomolee duwwaa fakkaatti;","poem":2},{"lineBreak":true},{"text":"wonni isaan jalaa miliqu tokkolle hin jiru.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isaan farda fakkaatan;","poem":1},{"text":"akka farda lolaa gulufan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Akka garreettaa fardaa hididdisaa,","poem":1},{"text":"gaarota gubbaa utaalan;","poem":2},{"lineBreak":true},{"text":"akka ibidda huura gubuu,","poem":2},{"lineBreak":true},{"text":"waan mara guban;","poem":2},{"lineBreak":true},{"text":"akka loltoota jajjaboo lolaaf qophowanee,","poem":2},{"lineBreak":true},{"text":"gogeessaan yaa'an.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yennaa isaan dhaggite, kolbaan hin bararaxxi;","poem":1},{"text":"fuulli namaa soda'aan shankallowa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Akka duultotaa lolan;","poem":1},{"text":"akka loltootaa dalleya yaabanee dabaran;","poem":2},{"lineBreak":true},{"text":"tarre'een gara duraa yaa'an;","poem":2},{"lineBreak":true},{"text":"gara ifii yaa'anu irraa hin goranu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tokko tokkoon isaanii,","poem":1},{"text":"tarre'een gara duraa yaa'an;","poem":2},{"lineBreak":true},{"text":"woraanaa fi guubee diinaa caccassanee dabaran;","poem":2},{"lineBreak":true},{"text":"wonni isaan dhooggu hin jiru.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gara qacha'aa timan;","poem":1},{"text":"dalleya qacha'aa irra fiigan;","poem":2},{"lineBreak":true},{"text":"utaalaa mana yaaban;","poem":2},{"lineBreak":true},{"text":"akka hattu'uu fodda'aan seenan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Latti isaan duratti hin tachooti;","poem":1},{"text":"gubbaalle hin raafanti.","poem":2},{"text":"Adu'uu fi jiin dukkanowan;","poem":1},{"text":"urjootille ifiisa hin lakkisan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mootiin Waan Maraa qoonqoo ifii ta akka mandiisu'uu","poem":1},{"text":"loltoota ifii irratti dhageessisa;","poem":2},{"lineBreak":true},{"text":"loltooti isaa attam attam heddu'u!","poem":2},{"text":"Worri isaaf ajajamu bandalla'a;","poem":1},{"text":"dhugumaan guyyaan Mootii Waan Maraa gudda'a;","poem":2},{"lineBreak":true},{"text":"guddoo sodaachisaa waan te'eef,","poem":2},{"lineBreak":true},{"text":"guyyaa san eentu dande'ee dhaabbata?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mootiin Waan Maraa, «Ammumaayyuu, gadhaa keessan tokkochaan,","poem":1},{"text":"laamaan, bowaa fi gaddaan gara kiyya deebi'a'a!» jedha.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gadda keessan mudhisiisaaf,","poem":1},{"text":"woyaa teessan tarsaasiis hin gewu;","poem":2},{"text":"Mootiin Waan Maraa Waaqi keessan arjaa, mararaa,","poem":1},{"text":"mufi'iif ka hin ariifanne, ka jaalala bara baraa guddaa qabu,","poem":2},{"lineBreak":true},{"text":"adabiisaafille ka hin ariifanne, waan te'eef,","poem":2},{"lineBreak":true},{"text":"gara isaa deebi'a'a!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Akka wotoo, Mootiin Waan Maraa Waaqi keessan","poem":1},{"text":"mufii irraa deebi'ee,","poem":2},{"lineBreak":true},{"text":"eebba ifii isiniif hin kenna fa'a.","poem":2},{"text":"Isinille Mootii Waan Maraa Waaqa keessaniif,","poem":1},{"text":"kennaa midhaaniitii fi daadhii woyni'ii hin dhikeessitan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Xiyoon keessatti tultullaa afuufa'a!","poem":1},{"text":"Laama woyyicha lassa'a!","poem":2},{"lineBreak":true},{"text":"Yaa'ii woyyittii waama'a!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kolbaa wolitti qaba'aatii,","poem":1},{"text":"yaa'ii woyyitti'iif qopheessa'a;","poem":2},{"lineBreak":true},{"text":"jaarsolee waama'a;","poem":2},{"lineBreak":true},{"text":"ijoolle'ee fi daa'immaan harmaalle wolitti qaba'a;","poem":2},{"lineBreak":true},{"text":"waajibootinuu kolloo ifii lakkisanuu ti.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hayyooti Mootii Waan Maraa tajaajilanu,","poem":1},{"text":"seensuma Galma Waaqaatii fi addee ciinca'aa wodhakka'atti bowanuu ti.","poem":2},{"text":"Isaan, «Mootii Waan Maraa, kolbaa teeti marari;","poem":1},{"text":"gosi dhibiin, ‹Waaqi keessan meet?› jedhiisaan,","poem":2},{"lineBreak":true},{"text":"akka nu tuffatanuu fi qaanessanu hin godhin» jedhanuu ti.","poem":2}]},{"type":"heading","content":["Deebii Waaqi Kolbaa Ifiitiif Kenne"]},{"type":"verse","number":18,"content":[{"text":"Mootiin Waan Maraa lafa ifiitiif hinaafee,","poem":1},{"text":"kolbaa ifiille marare.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mootiin Waan Maraa kolbaa ifiitiif deebisee,","poem":1},{"text":"«Kunoo, ani midhaan, daadhii woyni'iitii fi zayitii ejersaa,","poem":2},{"lineBreak":true},{"text":"haga quuttanutti isiniif hin kenna;","poem":2},{"lineBreak":true},{"text":"ani haganaa achi,","poem":2},{"lineBreak":true},{"text":"gosa biyya adda addaa oddu'utti","poem":2},{"lineBreak":true},{"text":"akka qaanottanu hin godhu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Awwaannisa gara kaabaatii isinitti dhufe","poem":1},{"text":"isin irraa fageessa;","poem":2},{"lineBreak":true},{"text":"gara goomole'eetii fi gara lafa urmaa isin irraa hin oofa;","poem":2},{"lineBreak":true},{"text":"ka dura yaa'u gara abbaayaa baya adu'uu,","poem":2},{"lineBreak":true},{"text":"ka duuba yaa'u gara abbaayaa seensa adu'uu hin oofa.","poem":2},{"lineBreak":true},{"text":"Achitti reeffi isaanii shamee hin ajowa.","poem":2},{"text":"Dhugumaan ani Mootiin Waan Maraa","poem":1},{"text":"waan guddoo isiniif godheera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«Ee lafa, hin sodaatin.","poem":1},{"text":"ani Waaqi waan guddoo waan sii godheef,","poem":2},{"lineBreak":true},{"text":"gammadii firinxiix!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Isinille bineensota hin sodaatina'a;","poem":1},{"text":"marri itti bobbaatanu bisilee te'eera.","poem":2},{"lineBreak":true},{"text":"Mukille midhaan buuseera;","poem":2},{"lineBreak":true},{"text":"muki Harru'uutii fi muki woyni'ii midhaan bacaa buuseera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"«Isin kolbaa Xiyoonii!","poem":1},{"text":"Mootii Waan Maraa Waaqa keessaniin","poem":2},{"lineBreak":true},{"text":"gammada'aatii firinxiixa'a;","poem":2},{"lineBreak":true},{"text":"inni yenna'aan,","poem":2},{"lineBreak":true},{"text":"akkuma durii bokkeya dansaa","poem":2},{"lineBreak":true},{"text":"ka duraatii fi duubaa isiniif kenneera.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Eeddummeen midhaaniin ta guutante hin teeti;","poem":1},{"text":"daadhiin woyni'iitii fi zayitiin ejersaa","poem":2},{"lineBreak":true},{"text":"addee itti cunfantu guuttee irraan dhangalaati.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bara heddu'uuf akka loltoota guddo'oo ka ani isinitti ergee,","poem":1},{"text":"midhaan awwaannisi gugurdaan,","poem":2},{"lineBreak":true},{"text":"korophiis, ilmooleen awwaannisaatii fi","poem":2},{"lineBreak":true},{"text":"awwaannisi dargaggeeyyiin isin irraa fixane","poem":2},{"lineBreak":true},{"text":"ani isiniif hin deebisa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nyaattanee hin quuttan;","poem":1},{"text":"ka waan baasaa hedduu isinii godhe","poem":2},{"lineBreak":true},{"text":"ana Mootii Waan Maraa Waaqa keessan hin leellifattan;","poem":2},{"lineBreak":true},{"text":"isin kolbaan tiyya haganaa achi hin qaanottanu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kolbaa tiyya! Ani akka odduu teessan jiru,","poem":1},{"text":"Mootii Waan Maraa Waaqa keessan akka te'ee fi","poem":2},{"lineBreak":true},{"text":"ana malee Mootiin Waan Maraa dhibiin akka hin jirre hin beettan.","poem":2},{"lineBreak":true},{"text":"Haganaa achi kolbaan tiyya deebitee hin qaanottu» jedhe.","poem":2}]},{"type":"heading","content":["Guyyaa Mootii Waan Maraa"]},{"type":"verse","number":28,"content":["Ani Mootiin Waan Maraa, «Kanaan duuba, Ayyaana kiyya",{"text":"nama mara irratti hin dhangalaasa;","poem":2},{"lineBreak":true},{"text":"ilmaanii fi ijoolleen durraa teessan raaga hin dubbatan;","poem":2},{"lineBreak":true},{"text":"jaarsoleelle oojjuu hin oojjatan;","poem":2},{"lineBreak":true},{"text":"dargaggootille mudhii hin dhaggan.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Yennaa san,","poem":1},{"text":"ani tajaajiltoota tiyya dhiiraa fi dubartii irratti","poem":2},{"lineBreak":true},{"text":"Ayyaana kiyya hin dhangalaasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"«Gubba'aa fi lafa irratti, waan baasaa,","poem":1},{"text":"dhiigaa fi ibidda, duumensa aaraalle hin mudhisa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Guyyaan Mootii Waan Maraa gudda'aa fi sodaachisaan","poem":1},{"text":"adoo hin dhufiniin dura,","poem":2},{"lineBreak":true},{"text":"aduun hin dukkanootti; jiin dhiiga hin uffata.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Worri maqaa Mootii Waan Maraa waamu marti hin fayya;","poem":1},{"text":"akkuma ani Mootiin Waan Maraa jedhe,","poem":2},{"lineBreak":true},{"text":"worri ani waame gaara Xiyoonii irratti,","poem":2},{"lineBreak":true},{"text":"Yerusaalem keessalle'etti hafee hin fayya» jedhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}