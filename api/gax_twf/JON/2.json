{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"JON","translationId":"gax_twf","name":"Yoonaasii Raagichaa","commonName":"Yoonaasii Raagichaa","title":"Kitaaba Yoonaasii Raagichaa","order":32,"numberOfChapters":4,"sha256":"522b818cde817467a5ee09d601e651384a8a103df4fd53877496319db455e2bf","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/gax_twf/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Daadimata Yoonaasii"]},{"type":"verse","number":1,"content":["Yoonaas gadhaa qurxummi'ii keessaa Goottaa Waaqa ifii daadimatee,"]},{"type":"verse","number":2,"content":["«Rakkoo tiyya hantuu keessatti Mootii Waan Maraa kiyya ani si waammadhe,",{"text":"atille naa deebitte.","poem":2},{"text":"Qilee awwaalaa jalaa ani sitti iyyadhe,","poem":1},{"text":"atille naa dhageette.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ati gara gadhaa abbaaya'aa,","poem":1},{"text":"qilee keessatti,","poem":2},{"lineBreak":true},{"text":"addee bisaan na marsetti na gatte;","poem":2},{"lineBreak":true},{"text":"hunni guddoon danbalii teetiille na gubbaa yaate.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yoos, ‹Ani fuula keeti duraa gatameera;","poem":1},{"text":"deebi'ee Galma woyyicha keetii","poem":2},{"lineBreak":true},{"text":"hin dhaggaa laati?› jedhee yaadadhe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bisaan na irra yaa'ee na lixxisiiseera;","poem":1},{"text":"Abbaayaan ijjuma na buxxeerti;","poem":2},{"lineBreak":true},{"text":"marri bisaan keessaalle mataa kiyyatti marame.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani gaarota jalatti,","poem":1},{"text":"lafa balbalti haga bara baraa","poem":2},{"lineBreak":true},{"text":"natti cufantetti gad bu'e.","poem":2},{"text":"Mootii Waan Maraa Waaqa kiyya ati ammoo,","poem":1},{"text":"jiru'uun qilee keessaa na baatte.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yennaa jiruun tiyya na dadhaddetti,","poem":1},{"text":"Mootii Waan Maraa kiyya,","poem":2},{"lineBreak":true},{"text":"ani gara keeti daadimadhe;","poem":2},{"lineBreak":true},{"text":"Galma woyyicha keeti keessalle'ee","poem":2},{"lineBreak":true},{"text":"daadimata kiyya naa dhageette.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Worri waaqota dharaa waaqonsu","poem":1},{"text":"badhaadha dhaggatiisaaf malane hin dhaban.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ani ammoo faaruu leellisaatiin;","poem":1},{"text":"ciincaa si'iif hin dhikeessa.","poem":2},{"lineBreak":true},{"text":"Waan waadaa si'iif galelle hin godha.","poem":2},{"text":"Fayyinni Mootii Waan Maraa irraa dhufa» jedhe.","poem":1}]},{"type":"verse","number":10,"content":["Achiin duuba Mootiin Waan Maraa akka qurxummiin Yoonaas tuttuuf ajaje; qurxummiille lafa bisaan hin jirre irratti isa tutte."]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}