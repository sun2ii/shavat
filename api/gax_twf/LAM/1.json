{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"LAM","translationId":"gax_twf","name":"Gadda Ermiyaasii","commonName":"Gadda Ermiyaasii","title":"Kitaaba Gadda Ermiyaasii","order":25,"numberOfChapters":5,"sha256":"39e2e4dfc84f243ea6662f8b7aab0554ec1c1120162644fdc452e7a2c5d12af2","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/gax_twf/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"heading","content":["Gadda Yerusaalemii"]},{"type":"verse","number":1,"content":[{"text":"Yerusaalemiin dur kolbaan keessa guutte attam qofi hatte!","poem":1},{"text":"Ka gosa biyya adda addaa oddu'utti guddoo teete,","poem":2},{"lineBreak":true},{"text":"attam akka haadha hiyyeessaa teete.","poem":2},{"lineBreak":true},{"text":"Qachoota oddu'utti giittii ta teete,","poem":2},{"lineBreak":true},{"text":"attam akka garbaa teete.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Halkan guutuu hin bootti,","poem":1},{"text":"imimmaan boqoo isi'ii irra yaati.","poem":2},{"lineBreak":true},{"text":"Jaalota isi'ii keessaa","poem":2},{"lineBreak":true},{"text":"ka isii jajjabeessu tokkolle hin jiru.","poem":2},{"lineBreak":true},{"text":"Jaaloti isi'ii marti isii mormataneeran;","poem":2},{"lineBreak":true},{"text":"diinalle itti te'aneeran.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kolbaan Yihuda'aa","poem":1},{"text":"garbumma'aa fi eloo jaddu'uun rakkattee,","poem":2},{"lineBreak":true},{"text":"biyya ifii irraa ari'antee,","poem":2},{"lineBreak":true},{"text":"addee «Teenna» hin jenne,","poem":2},{"lineBreak":true},{"text":"lafa dhibii keessa leete.","poem":2},{"text":"Karaan milixxu ka hin jirre,","poem":1},{"text":"diinaan marfante.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nami jilaaf gara Xiyoonii dhufu,","poem":1},{"text":"waan hin jirreef,","poem":2},{"lineBreak":true},{"text":"karaan karra isi'ii martinuu duwwaa te'e;","poem":2},{"lineBreak":true},{"text":"Hayyootille gaddaan aadan.","poem":2},{"lineBreak":true},{"text":"Durrooti isi'ii hin gadditi.","poem":2},{"lineBreak":true},{"text":"Xiyoon gadda keessa jirti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Diinoti isi'ii isii irratti goottomanee,","poem":1},{"text":"badhaadhaneeran.","poem":2},{"text":"Bacinna cubbuu isi'iitiif,","poem":1},{"text":"Waaqi isii rakkise;","poem":2},{"text":"Ijoolleen isi'ii diinaan booji'antee,","poem":1},{"text":"fudhatanteerti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ulfinni Yerusaalemii marti","poem":1},{"text":"irraa deemeera.","poem":2},{"text":"Sooreyyiin isi'iille","poem":1},{"text":"akka gadansa beelowee dadhabee,","poem":2},{"lineBreak":true},{"text":"worra isa ari'u duraa hin baqannee te'aneeran.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yerusaalem rakkatee mana dhaddee","poem":1},{"text":"waan dansaa ifii durii qaabatte.","poem":2},{"text":"Kolbaan isi'ii ammoo diinaan waan injifatanteef,","poem":1},{"text":"nami isii qarqaarulle hin jiru.","poem":2},{"lineBreak":true},{"text":"Diinoti isi'iille diigama isi'iititti kollane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yerusaalem cubbuu guddoo hujjee","poem":1},{"text":"xomorootteerti;","poem":2},{"lineBreak":true},{"text":"isaan waan duwwaa isii dhagganeef,","poem":2},{"lineBreak":true},{"text":"worri isii ulfeessanu marti tuffataneeran;","poem":2},{"lineBreak":true},{"text":"isiinuu aadiisaan,","poem":2},{"lineBreak":true},{"text":"fokko'oon fuula ifii achi garagalti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Xomorummaan isi'ii woyaa isi'ii irratti mudhatti;","poem":1},{"text":"isiin waan hegeri teetu hin beenne;","poem":2},{"lineBreak":true},{"text":"jinnanni isi'ii sodaachisa'a;","poem":2},{"lineBreak":true},{"text":"ka isii jajjabeessu tokkolle hin jiru.","poem":2},{"lineBreak":true},{"text":"Diinoti isi'ii waan isii injifataneef,","poem":2},{"lineBreak":true},{"text":"rakkoo isi'ii akka ilaaluuf gara Waaqaa iyyite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Diinoti Yerusaalemii","poem":1},{"text":"qabeenna isi'ii dadansaa saamane.","poem":2},{"text":"Isiin Galma Waaqaa ka ifii,","poem":1},{"text":"ka Waaqi worri Yihudoota hin te'in","poem":2},{"lineBreak":true},{"text":"akka hin seenne dhoogge seenanuun dhaggite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kolbaan isi'ii marti sagale'eef aaddi;","poem":1},{"text":"lubbu'uun jiraatiisaaf","poem":2},{"lineBreak":true},{"text":"qabeenna dadansaa ifii sagale'een jijjiiratti.","poem":2},{"text":"Yerusaalem «Waaqa! Na ilaali;","poem":1},{"text":"salphinna kiyya duudiille dhaggi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Isin worri karaa tartanu,","poem":1},{"text":"isiniif womaayyuu te'uu dhaddulle,","poem":2},{"lineBreak":true},{"text":"ka Waaqi guyyaa mufii jaddu'uu natti fide,","poem":2},{"lineBreak":true},{"text":"rakkinna kiyya kana ka fakkaatu jiraa ree?","poem":2},{"lineBreak":true},{"text":"Me ilaala'aatii, dhagga'a!","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Waaqi ol-gubbaa irraa ibidda erge;","poem":1},{"text":"ibiddille lafee tiyya keessa gube.","poem":2},{"lineBreak":true},{"text":"Inni tiyyoo miila kiyyatti afee,","poem":2},{"lineBreak":true},{"text":"duubatti na deebise.","poem":2},{"lineBreak":true},{"text":"Inni qofi na lakkisee,","poem":2},{"lineBreak":true},{"text":"guyyaa guutuu na gaggasse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Inni waanjoo cubbuu tiyyaa wolitti hidhee,","poem":1},{"text":"morma kiyya irra keyeera.","poem":2},{"text":"Isiin guddoo waan ulfaattuuf","poem":1},{"text":"hunna na dhooggite.","poem":2},{"text":"Waaqi diinota ani dande'ee ifi irraa hin dhooggannetti","poem":1},{"text":"dabarsee na kenne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«Waaqi loltoota jajjaboo ani qabu dhidhiiteera;","poem":1},{"text":"inni dargaggoota tiyya balleessiisaaf loltoota erge;","poem":2},{"lineBreak":true},{"text":"kolbaa tiyya akka midhaan woyni'ii cunfe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«Wonni ani imimmaan tiyya","poem":1},{"text":"dhangalaasee bowuuf tana:","poem":2},{"lineBreak":true},{"text":"ka na jajjabeessu waan na irraa fagaateef,","poem":2},{"lineBreak":true},{"text":"ka na jabeessu hin jiru;","poem":2},{"lineBreak":true},{"text":"Diinni waan injifateef,","poem":2},{"lineBreak":true},{"text":"ijoolleen tiyya qofi hatteerti» jetti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Xiyoon harka ifii badhitteerti;","poem":1},{"text":"ka isii jajjabeessu ammoo hin jiru.","poem":2},{"lineBreak":true},{"text":"Ollooti isi'ii duudiin sanyii Yaaqoobiititti","poem":2},{"lineBreak":true},{"text":"diinota akka itti te'anu Waaqi ajajeera.","poem":2},{"lineBreak":true},{"text":"Yerusaalem odduu isaaniititti xomorootteerti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Yerusaalem, «Anattuu ajaja isaa dide malee,","poem":1},{"text":"Waaqi sirrii godhe.","poem":2},{"lineBreak":true},{"text":"Isin kolbaan marti dhage'a'a; rakkoo tiyyaalle ilaala'a;","poem":2},{"lineBreak":true},{"text":"dargaggooti tiyya dhiiraa fi dubartiin marti booji'amaneeran.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«Ani jaalota tiyya mara waammadhe;","poem":1},{"text":"isaan ammoo na qarqaaruu didatane.","poem":2},{"lineBreak":true},{"text":"Hayyootaa fi sooreyyiin tiyya","poem":2},{"lineBreak":true},{"text":"lubbuu ifii jiraachisiisaaf, sagalee adoo barbaadatanuu","poem":2},{"lineBreak":true},{"text":"karaa qacha'aa keessatti du'ane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«Waaqa kiyya, attam akka rakkadhee,","poem":1},{"text":"keessi kiyya laalatee,","poem":2},{"lineBreak":true},{"text":"gadhaan kiyya raafame ilaali;","poem":2},{"lineBreak":true},{"text":"kolbaa tiyya alatti shallaagaan,","poem":2},{"lineBreak":true},{"text":"mana keessatti duuti fixiisatti jirti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«Kolbaan aadiisa kiyya dhageetteerti;","poem":1},{"text":"ammoo eennulle na hin jajjabeessine.","poem":2},{"lineBreak":true},{"text":"Diinoti kiyya marti rakkoo tiyya dhage'anee,","poem":2},{"lineBreak":true},{"text":"waan ati na irratti gootetti gammadaneeran.","poem":2},{"lineBreak":true},{"text":"Guyyaa jette san fidiitii,","poem":2},{"lineBreak":true},{"text":"isaanille akka kiyya te'anuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Hammeenni isaanii marti si duratti mudhatuu ti;","poem":1},{"text":"akkuma cubbuu tiyyaaf na adadde isaanille adabi.","poem":2},{"lineBreak":true},{"text":"Ani guddoo waan aadeef,","poem":2},{"lineBreak":true},{"text":"gaggabeera» jetti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}