{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"LAM","translationId":"gax_twf","name":"Gadda Ermiyaasii","commonName":"Gadda Ermiyaasii","title":"Kitaaba Gadda Ermiyaasii","order":25,"numberOfChapters":5,"sha256":"39e2e4dfc84f243ea6662f8b7aab0554ec1c1120162644fdc452e7a2c5d12af2","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/gax_twf/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"heading","content":["Adabamiisa Yerusaalemii"]},{"type":"verse","number":1,"content":[{"text":"Attam attam Waaqi mufii ifiitiin","poem":1},{"text":"Xiyoonitti duumensa uffise!","poem":2},{"text":"Guddinna isi'iille ol-gubbaa irraa","poem":1},{"text":"gad lafatti darbe.","poem":2},{"text":"Xiyoon ijjata miila isaa akka teete,","poem":1},{"text":"guyyaa mufii ifii isii hin qaabanne.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Waaqi bultoo Israa'elii mara","poem":1},{"text":"marartii malee balleesse.","poem":2},{"text":"Kushee Yihuda'aa mufii ifiitiin diigee balleessee,","poem":1},{"text":"Mootumma'aa fi bulchitoota isi'ii","poem":2},{"lineBreak":true},{"text":"gad lafatti gatee salphise.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mufii ifii jaddu'uun,","poem":1},{"text":"hunna Israa'elii mara dhoogge.","poem":2},{"text":"Diinni yennaa isaanitti dhufelle,","poem":1},{"text":"gargaaruu didate.","poem":2},{"text":"Akkuma bobeenni ibiddaa,","poem":1},{"text":"waan adaala isaa jiru mara gubu,","poem":2},{"lineBreak":true},{"text":"Waaqi Israa'el gube.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Inni akka diinaa daaya ifii itti qajeelfate;","poem":1},{"text":"harka middicha ifiille qopheeffate.","poem":2},{"text":"Worra ila namaatitti tolu duudii,","poem":1},{"text":"akka diinaa ijjeese.","poem":2},{"text":"Dunkaanii kolbaa Xiyoonii irratti mufii ifii,","poem":1},{"text":"akka ibiddaa isaan irratti gabbise.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Waaqi akka diinaatitti,","poem":1},{"text":"Israa'el balleesse;","poem":2},{"lineBreak":true},{"text":"inni kushee isi'ii maraa fi","poem":2},{"lineBreak":true},{"text":"mana mootummaa isi'ii mara balleesse.","poem":2},{"text":"Kolbaa Yihuda'aa irratti","poem":1},{"text":"bowichaa fi gadda bira dabarse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Galma ifii akka gosee fichaa keessaa","poem":1},{"text":"diigee balleesse;","poem":2},{"text":"Waaqi jilaa fi Sanbati Xiyoon keessatti","poem":1},{"text":"akka dedhamanu godhe.","poem":2},{"text":"Inni mufii ifii jaddu'uun","poem":1},{"text":"mootichaa fi hayyicha salphise.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Waaqi addee ciincaa ifii didee,","poem":1},{"text":"Galma ifiille lakkise.","poem":2},{"text":"Dalleya mana mootummaa isi'ii","poem":1},{"text":"harka diinaatitti dabarsee kenne;","poem":2},{"lineBreak":true},{"text":"akkuma guyyaa jilaatitti godhamu,","poem":2},{"lineBreak":true},{"text":"Galma Waaqa keessatti diinni qeexale.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Waaqi dalleya qachaa Xiyoonii diigiisaaf murteessee","poem":1},{"text":"wodaroo miki'ii","poem":2},{"noteId":0},{"text":"buuseera.","poem":2},{"text":"Inni balleessiisaaf","poem":1},{"text":"harka ifii irraa hin deebifanne.","poem":2},{"text":"Xelleepho'oo fi dalleya isi'ii","poem":1},{"text":"wolumatti diigeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Balbalti karra isi'ii marti awwaalante,","poem":1},{"text":"danqaraan isi'iille caccabee bade.","poem":2},{"text":"Mootichii fi qondaaltoti isi'ii ari'amanee","poem":1},{"text":"gosa biyya dhibi'ii odduu jiran;","poem":2},{"text":"Haganaa achi seerri hin jiraatu;","poem":1},{"text":"raagoti isi'iille Waaqa irraa","poem":2},{"lineBreak":true},{"text":"mudhii hin dhagganu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Jaarsoleen qachaa Xiyoonii","poem":1},{"text":"mataa ifiititti bukuu","poem":2},{"noteId":1},{"text":"firfirfatanee,","poem":2},{"lineBreak":true},{"text":"woyaa gaddaa uffatanee,","poem":2},{"lineBreak":true},{"text":"cadhi jedhanee lafa tee'ane.","poem":2},{"text":"Durri qachaa Xiyoonii","poem":1},{"text":"gaddaan lafa ilaalti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kolbaan tiyya waan fixanteef,","poem":1},{"text":"ijoolle'ee fi annoolleen","poem":2},{"lineBreak":true},{"text":"karaa qacha'aa irratti waan gaggabaneef","poem":2},{"lineBreak":true},{"text":"bowiisaan ilti na jaamaarti.","poem":2},{"text":"Keessi kiyya na laalatee,","poem":1},{"text":"addii kutadhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ijoolleen akka loltoota madoottee,","poem":1},{"text":"karaa qacha'aa irratti gaggabanee,","poem":2},{"lineBreak":true},{"text":"«Sagale'ee fi bisaan» meet jedhaa,","poem":2},{"lineBreak":true},{"text":"harka haadha isaanii irratti du'an.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ee Yerusaalem, maan siin jedha?","poem":1},{"text":"Maani'iin wol si qixxeessa?","poem":2},{"text":"Xiyoonii tiyya, akka si jajjabeessuuf,","poem":1},{"text":"maaniin wol si fakkeessa?","poem":2},{"text":"Badiin si irra dhaqqadde akka abbaaya'aa badho'o;","poem":1},{"text":"eentu si fayyisuu dande'a?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Raagoleen teeti","poem":1},{"text":"mudhii dharaa ta bu'aa hin qanne si'iif dhaggite.","poem":2},{"text":"Mudhii dharaatii fi dokonkora si'iif dhaggite malee,","poem":1},{"text":"yakkaa teeti si'itti ifa baasanee","poem":2},{"lineBreak":true},{"text":"badii si'itti dhufaartu si'i irraa hin oolchine.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Worri karaa dabaru marti","poem":1},{"text":"cooraa harka sitti dhowaa, mataa ifii raasaa,","poem":2},{"lineBreak":true},{"text":"«Yerusaalemiin tun ta shaggummaa guutuu qadduu fi","poem":2},{"lineBreak":true},{"text":"qachaa biyyi lafaa duudiin itti gammaddee motii?» jedhan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Diinoti keeti marti afaan bananee si'itti cooran.","poem":1},{"text":"Ilkaan ciniinnatanee, «Yerusaalem balleessine.","poem":2},{"text":"Guyyaan nuuti eeggataa turre kana;","poem":1},{"text":"amma bira geennee dhaggine» jedhan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Waaqi waan yaade muummesse;","poem":1},{"text":"jecha ifiille guute.","poem":2},{"text":"Akkuma dur murteesse marartii malee si balleessee,","poem":1},{"text":"hunna diinota keetii jabeessee,","poem":2},{"lineBreak":true},{"text":"jinnana keetitti akka gammadanu godhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kolbaa qachaa Xiyoonii,","poem":1},{"text":"gara Waaqaa iyya'a!","poem":2},{"text":"Dalleya qachaa Xiyoonii,","poem":1},{"text":"imimmaan teeti halkanii fi guyyaa","poem":2},{"lineBreak":true},{"text":"akka lagaa yaatuu ti;","poem":2},{"lineBreak":true},{"text":"hin cadhisin;","poem":2},{"lineBreak":true},{"text":"boyiisalle hin lakkisin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Halkan guutuu yennaa yenna'atti ka'ii iyyi!","poem":1},{"text":"Waan gadhaa keeti keessa jiru,","poem":2},{"lineBreak":true},{"text":"Waaqa duratti dhikeessi.","poem":2},{"text":"Lubbuu ijoollee teetii,","poem":1},{"text":"ta qaxxaamura karaa irratti","poem":2},{"lineBreak":true},{"text":"beelaan gaggabaneef,","poem":2},{"lineBreak":true},{"text":"daadimanna'aan harka keeti gara Waaqaa ol kaasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yerusaalem, «Ee, Waaqa, kunoo ilaali!","poem":1},{"text":"Kolbaan ati akkana gooteertu jirtii?","poem":2},{"lineBreak":true},{"text":"Dubartooti annoolee ifii deyane nyaatanuu tii?","poem":2},{"text":"Hayyootii fi raagoti","poem":1},{"text":"Galma Waaqaa keessatti ijjeefamanuu tii?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«Dargaggootii fi maanguddooti,","poem":1},{"text":"karaa irratti jiganee du'aneeran.","poem":2},{"text":"Dargaggooti dhiiraatii fi dubarti'ii","poem":1},{"text":"shallaaga'aan ijjeefamaneeran.","poem":2},{"text":"Guyyaa mufii teetii","poem":1},{"text":"marartii malee isaan qalte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Akka guyyaa jilaa,","poem":1},{"text":"diinota kiyya adaala mara irraa waanteerta.","poem":2},{"text":"Guyyaa mufii Waaqaa,","poem":1},{"text":"ka miliqe yookiin jiru'uun ka hafe hin jiru.","poem":2},{"text":"Ijoollee ani uumadhee guddifadhe","poem":1},{"text":"diinni kiyya na jalaa fixe» jedhi.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Wodaroo miki'ii: Ta dheerinnaa fi badhinna woyii haga ittiin ilaalanu.","reference":{"chapter":2,"verse":8}},{"noteId":1,"caller":"+","text":"Bukuu: Yookiin awwaar.","reference":{"chapter":2,"verse":10}}]},"thisChapterLink":"/api/gax_twf/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}