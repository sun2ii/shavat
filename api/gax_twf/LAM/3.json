{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"LAM","translationId":"gax_twf","name":"Gadda Ermiyaasii","commonName":"Gadda Ermiyaasii","title":"Kitaaba Gadda Ermiyaasii","order":25,"numberOfChapters":5,"sha256":"39e2e4dfc84f243ea6662f8b7aab0554ec1c1120162644fdc452e7a2c5d12af2","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/gax_twf/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"heading","content":["Adabama, Cubbuu Irraa Deebi'iisaa Fi Addii"]},{"type":"verse","number":1,"content":[{"text":"Ani nama ulee mufii Waaqaatiin,","poem":1},{"text":"adabamee rakkinna dhagge.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inni addee ifi hin jirre,","poem":1},{"text":"dukkanatti na ari'e.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inni dhugumaan guyyaa mara deddeebi'ee,","poem":1},{"text":"harka ifiitiin na adabe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Inni foonii fi gogaa kiyya dulloonsee,","poem":1},{"text":"lafee tiyyalle caccasse.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inni na marsee,","poem":1},{"text":"rakkinna hadhowa'aa fi laaleffata keessa na galche.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inni akka worra dur du'ee awwaalamee,","poem":1},{"text":"dukkana keessa akka le'u na tolche.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Akka ani hin baaneef,","poem":1},{"text":"dalleya marsee natti ijaaree,","poem":2},{"lineBreak":true},{"text":"wodaroo sibiilaa ulfaattu'uun na hidhe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Qarqaarsaaf itti iyyadhulle,","poem":1},{"text":"na caqasuu dide.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Karaa kiyya dhaka'aan duuchee,","poem":1},{"text":"daandii tiyyalle daddasse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Inni akka doobbaa","poem":1},{"noteId":2},{"text":"ciisee na gaaduutii fi","poem":1},{"text":"akka neenqa dhokaata jiruu ti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inni karaa irraa na harkisee, kukkutee,","poem":1},{"text":"qarqaarsa malee na lakkise.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Guubee ifii dhisee,","poem":1},{"text":"itti qajeelfata daaya ifii na godhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Inni daaya subba ifii keessaa luqqisee,","poem":1},{"text":"kalattii tiyya woraane.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kolbaan tiyya marti natti kollitee,","poem":1},{"text":"guyyaa guutuu weeddu'uun natti murgite.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Inni rakkinnaan jiruu tiyya hadheessee,","poem":1},{"text":"waan akka hargiisaa na quusse.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Inni cabbi'iin ilkaan kiyya caccassee,","poem":1},{"text":"bukuu keessatti na gangalche.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ani nageya dhabee,","poem":1},{"text":"gammadi maan akka te'e dedhe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tanaaf ani «Jabeenni kiyya,","poem":1},{"text":"addiin ani Waaqa irraa eegadhu marti baddeerti» jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Rakko'oo fi daaqa kiyya qaabatiis,","poem":1},{"text":"akka qararu'uutii fi hadhoottu'uu natti teeteerti.","poem":2}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ani yennaa tana qaabadhu mara,","poem":2},{"lineBreak":true},{"text":"mataa buusa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Teetulle yennaa waan tokko qaabadhu,","poem":1},{"text":"addii qaba:","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Jaalalli Waaqaa ka bara baraa waan te'eef,","poem":1},{"text":"marartii isaa ta dhuma hin qanne irraa ta kaate","poem":2},{"lineBreak":true},{"text":"nuuti badiisa dhanne.","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Jaalallii fi marartiin isaa barii mara haareya;","poem":2},{"lineBreak":true},{"text":"addatamummaan isaa guddo'o.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ani ifiin, «Waaqi qooda kiyya;","poem":1},{"text":"tanaaf isatti addadha» jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Waaqi worra addi'iin isa eegatuuf,","poem":1},{"text":"worra isa barbaaduuf dansa'a.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Tanaaf nami cadhisee","poem":1},{"text":"fayyisiisa Waaqaa eegatiis dansa'a.","poem":2}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Nami bara dargaggumma'aatitti","poem":2},{"lineBreak":true},{"text":"waanjoo ba'atiisa barachuun dansa'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Yennaa Waaqi waanjoo isa ba'achiise,","poem":1},{"text":"qofii ifii cadhisee tee'uu ti.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ammalle addiin jiraatuu waan dandeettuuf,","poem":1},{"text":"ifi gad qabuu ti.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Nama isa kabaluuf boqoo ifii kennuu ti;","poem":1},{"text":"arraballe fudhatuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Waaqi haga bara baraa isa hin gatu.","poem":1}]},{"type":"verse","number":32,"content":[{"text":"Inni nama gaddisiisulle,","poem":2},{"lineBreak":true},{"text":"akka jaalala ifii ka bara baraa gudda'aatitti marartii qaba.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Inni nama rakkisu'uu fi gaddisiisu'utti hin gammadu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Hidhantooti biyya tokkoo","poem":1},{"text":"yennaa dhiitamanu,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Waaqa Ol-Aanaa duratti","poem":1},{"text":"mirgi ilmaan namaa yennaa dhooggamu,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Haajaan nama tokkoo haqa yennaa dhabu,","poem":1},{"text":"Waaqi kana hin dhagguu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Waaqi adoo hin ajajin,","poem":1},{"text":"ka dubbatee woy godhuu dande'u eennu?","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Wonni dansa'aa fi hantuulle","poem":1},{"text":"ajaja Waaqa Ol-Aana'aatiin teetii motii ree?","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Nami adoo hin du'in","poem":1},{"text":"sababa cubbuu ifiitiin","poem":2},{"lineBreak":true},{"text":"yoo adabame maaf gunguma ree?","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Karaa keenna qorqorree ilaallee,","poem":1},{"text":"gara Waaqaa deebinuu ti.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Kowa'a gadha'aa fi harka keenna","poem":1},{"text":"gara Waaqa ol-gubbaa jiruu ol kaannee,","poem":2}]},{"type":"verse","number":42,"content":[{"text":"«Nuuti ajaja keeti didannee, jallannee","poem":1},{"text":"atille nu'uuf hin araaranne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"«Ati aari'iin guutantee, nu ariitee,","poem":1},{"text":"marartii malee nu ijjeette.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Daadimannaan teenna si bira akka hin geenne,","poem":1},{"text":"duumensaan ifi gollatte.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Gosa biyya adda addaa oddu'utti","poem":1},{"text":"xuri'ii fi huuraa nu goote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"«Diinoti keenna marti","poem":1},{"text":"afaan bananee nutti murgane.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Soda'aa fi boolla bu'iis,","poem":1},{"text":"diigamaa fi badiin nu dhaqqaddeerti» hin jenna.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Kolbaan tiyya waan badeef","poem":1},{"text":"imimmaan ila tiyyaa akka lagaa lolaati.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"Imimmaan tiyya yennaa mara lolaati,","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Tun haga Waaqi ol-gubbaa irraa gad","poem":1},{"text":"ilaalee na dhaggutti teeti.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Waan diinni kolbaa qachaa Yerusaalemii irratti godhe","poem":1},{"text":"yennaa dhaggitu gadhaan kiyya hin gadda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Diinoti kiyya ka sababa malee na jibbanu","poem":1},{"text":"akka gororri'ii na adansane.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Jiru'uunuu boollatti na gatanee","poem":1},{"text":"afaan boollaa dhaka'aan cufane.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Bisaan mataa kiyya irra dacha'ee,","poem":1},{"text":"ani «Du'aara» jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":55,"content":[{"text":"Qilee boollaa keessaa,","poem":1},{"text":"maqaa keeti waammadhe.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Ati gaaffii tiyya dhageetteertaa,","poem":1},{"text":"yennaa ani qarqaarsaaf sitti iyyadhu,","poem":2},{"lineBreak":true},{"text":"gurra keeti hin qabatin; ammoo furii naa kenni!","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Yennaa ani si waammadhe,","poem":1},{"text":"ati na bira dhuttee, «Hin sodaatin!» naan jette.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Goottaa kiyya! Haajaa kiyya fudhattee,","poem":1},{"text":"lubbuu tiyya wodatte.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Goottaa kiyya!","poem":1},{"text":"Daba na irratti hujame dhaggiteerta,","poem":2},{"lineBreak":true},{"text":"ati naaf muri!","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Haluu diinoti na irratti qabanuu fi","poem":1},{"text":"mala isaan na irratti dhowane","poem":2},{"lineBreak":true},{"text":"mara dhaggiteerta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":61,"content":[{"text":"Ee waaqa! Murgoo isaan natti murgane,","poem":1},{"text":"mala isaan natti dhowane dhageetteerta.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"Guyyaa guutuu diinoti kiyya,","poem":1},{"text":"na irratti hasaasaa, gunguman.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Kunoo isaan yennaa tee'anu fi ka'anu mara,","poem":1},{"text":"weeddu'uun natti murgan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":64,"content":[{"text":"Ee Waaqa!","poem":1},{"text":"Akka hujii isaaniititti isaaniif kenni!","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Abaarsi keeti akka isaanitti dhufu,","poem":1},{"text":"mataa isaanii jabeessi!","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Waaqa kiyya! Aari'iin isaan ari'iitii,","poem":1},{"text":"Biyya lafaa irraa isaan balleessi.","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Doobbaa: Bineensa hamaa iyyaa fakkaatu tokko.","reference":{"chapter":3,"verse":10}}]},"thisChapterLink":"/api/gax_twf/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}