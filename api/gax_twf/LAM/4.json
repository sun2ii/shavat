{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"LAM","translationId":"gax_twf","name":"Gadda Ermiyaasii","commonName":"Gadda Ermiyaasii","title":"Kitaaba Gadda Ermiyaasii","order":25,"numberOfChapters":5,"sha256":"39e2e4dfc84f243ea6662f8b7aab0554ec1c1120162644fdc452e7a2c5d12af2","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/gax_twf/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"heading","content":["Diigama Yerusaalemii"]},{"type":"verse","number":1,"content":[{"text":"Worqiin attam calalaqa ifii dhaddee,","poem":1},{"text":"worqiin qulqulluun attam jijjiirante!","poem":2},{"text":"Dhakaan Galmi Waaqaa ittiin ijaarame","poem":1},{"text":"attam karaa irratti bittinnowe!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ilmaan Xiyoonii worri dur","poem":1},{"text":"akka worqii gatii guddo'ootitti ilaallamanu","poem":2},{"lineBreak":true},{"text":"amma attam akka faara","poem":2},{"lineBreak":true},{"text":"harka namaatiin hujamee te'ane!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Jeedaltinuu","poem":1},{"noteId":3},{"text":"ilmee ifii","poem":1},{"text":"harma hoosifatti,","poem":2},{"lineBreak":true},{"text":"kolbaa tiyya ammoo akka guchiin gammoojji'ii","poem":2},{"lineBreak":true},{"text":"ilme'etti gadhaa jabaatu teeteerti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dheebuu bisaaniitiin","poem":1},{"text":"arrabi ijoolle'ee laagada'atti goge.","poem":2},{"text":"Jjoolleen sagalee kadhatti;","poem":1},{"text":"ammoo ka itti kennu hin jiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kolbaan dur waan dansaa nyaataa turte","poem":1},{"text":"karaa irratti beelaan dhumatte;","poem":2},{"lineBreak":true},{"text":"worri dur woyaa dhiillee uffatee guddate","poem":2},{"lineBreak":true},{"text":"amma tuulaa daadha'aa irra irkate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Adabamiis kolbaa tiyyaa","poem":1},{"text":"adabamiisa Sodoom,","poem":2},{"lineBreak":true},{"text":"harki nama tokkoolle adoo hin tuqin","poem":2},{"lineBreak":true},{"text":"dedhuma badde san caala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sooreyyiin isaanii cabbii caalaa calalaqanee,","poem":1},{"text":"aanan caalaa addaatan;","poem":2},{"lineBreak":true},{"text":"nafi isaaniille dooqa caalaa dhiille'e;","poem":2},{"lineBreak":true},{"text":"akki dansummaa isaaniille akka dhakaa Safiirosii tola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Amma fuulli isaanii cilee caalaa gurraachoweera;","poem":1},{"text":"nami karaa irratti isaan beekuuyyuu hin jiru.","poem":2},{"text":"Gogaan isaanii shuntuuratee lafe'etti maxxanee,","poem":1},{"text":"akka muka gogee te'eera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Worra midhaan ficha'aa dhabee","poem":1},{"text":"suutuma suutaan","poem":2},{"lineBreak":true},{"text":"beelaan du'ee mannaa,","poem":2},{"lineBreak":true},{"text":"worra shallaaga'aan du'e woyya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Badiin kolbaa tiyyatti yennaa dhutte","poem":1},{"text":"dubartooti gadhi-laafeyyiin","poem":2},{"lineBreak":true},{"text":"ijoollee ifii harka ifiitiin","poem":2},{"lineBreak":true},{"text":"nyaatiisaaf iffeelane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Waaqi aarii hantuu ifii buusee","poem":1},{"text":"hundee isi'ii balleessiisaaf,","poem":2},{"lineBreak":true},{"text":"Xiyoonitti ibidda gabbise.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Moototi lafaalle te'ee kolbaan biyya lafaa,","poem":1},{"text":"diinoti yookiin nyaaphi karra dalleya Yerusaalemii","poem":2},{"lineBreak":true},{"text":"seenuu akka dande'anu hin dhugeeffanne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Te'uu malee,","poem":1},{"text":"sababa cubbuu raagota isi'iitii fi","poem":2},{"lineBreak":true},{"text":"yakkaa hayyoota isi'ii","poem":2},{"lineBreak":true},{"text":"dhiiga worra yakkaa hin qannee","poem":2},{"lineBreak":true},{"text":"dhangalaasaneef tun teete.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Isaan dhiigaan waan battowaneef","poem":1},{"text":"nami woyaa isaaniituu tuqu hin jiru.","poem":2},{"text":"Isaan akka balla'aa","poem":1},{"text":"karaa irra titimisane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Namooti «Isin worri battoottane, achi deema'a!","poem":1},{"text":"Nu hin tuqina'a» jedhanee isaanitti iyyane.","poem":2},{"text":"Yennaa isaan baqatanee joonjane,","poem":1},{"text":"kolbaan gosa biyya adda addaa,","poem":2},{"lineBreak":true},{"text":"«Haganaa achi isaan as turuu hin dande'anu!» jedhane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Waaqi ifumaafuu isaan bittinneesse;","poem":1},{"text":"inni deebi'ee isaan hin ilaalu.","poem":2},{"lineBreak":true},{"text":"Hayyooti hin kabajantu,","poem":2},{"lineBreak":true},{"text":"jaarsoleelle fudhatama hin qabaattu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Akkasuma qarqaarsa adoo eegannuu","poem":1},{"text":"ilti nu dadhadde;","poem":2},{"lineBreak":true},{"text":"gosa biyya nu qarqaaruu hin dandeenne irraa","poem":2},{"lineBreak":true},{"text":"qarqaarsa eegane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Diinoti keenna waan nu gaadanuuf","poem":1},{"text":"kara'aayyuu deemiisa hin dandeenne.","poem":2},{"text":"Muummeen teenna dhikaattee,","poem":1},{"text":"barri keenna waan hobba'eef,","poem":2},{"lineBreak":true},{"text":"guyyooti keenna laakkossatti galeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Diinoti keenna","poem":1},{"text":"risaa caalaa ariifatan;","poem":2},{"lineBreak":true},{"text":"gaara irra nu ari'anee,","poem":2},{"lineBreak":true},{"text":"goomolee keessalle'etti nu gaadane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ka Waaqi nu'uuf muude,","poem":1},{"text":"ka nuuti, «Hafuura jiruu teennaa ti;","poem":2},{"lineBreak":true},{"text":"gaaddisa isaa jalatti","poem":2},{"lineBreak":true},{"text":"gosa biyya adda addaa odduu hin leena» jenne,","poem":2},{"lineBreak":true},{"text":"boolla isaan nu'uuf qotane keessatti qabame.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Isin kolbaa qachaa Edoomii,","poem":1},{"text":"worra biyya Uzii keessa leetanu,","poem":2},{"lineBreak":true},{"text":"gammada'aa ilillisa'a;","poem":2},{"lineBreak":true},{"text":"ammoo muduunuun mufii Waaqaa","poem":2},{"lineBreak":true},{"text":"isinitti dhufaarti;","poem":2},{"lineBreak":true},{"text":"isin machoottanee qullaa deentan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Kolbaa Xiyoonii!","poem":1},{"text":"Adabbiin teessan hobbaateerti;","poem":2},{"text":"Waaqi haganaa achi","poem":1},{"text":"boojuu keessa akka leetanu isin hin godhu.","poem":2},{"text":"Ee kolbaa Edoomii,","poem":1},{"text":"inni yakkaa teessan hin adaba","poem":2},{"lineBreak":true},{"text":"cubbuu teessanille qaaleyatti baasa.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":3,"caller":"+","text":"Jeedalti: Ukkullolle hin jedhanti.","reference":{"chapter":4,"verse":3}}]},"thisChapterLink":"/api/gax_twf/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}