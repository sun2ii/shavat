{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"LAM","translationId":"gax_twf","name":"Gadda Ermiyaasii","commonName":"Gadda Ermiyaasii","title":"Kitaaba Gadda Ermiyaasii","order":25,"numberOfChapters":5,"sha256":"39e2e4dfc84f243ea6662f8b7aab0554ec1c1120162644fdc452e7a2c5d12af2","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/gax_twf/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"heading","content":["Daadimata Marartii Dhaggatiisaaf Dhikaate"]},{"type":"verse","number":1,"content":[{"text":"Ee Waaqa, waan nu irratti te'e qaabadhu;","poem":1},{"text":"kunoo, salphinna keennalle dhaggi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Qabeenna keenna ormi,","poem":1},{"text":"mana keenna alagaan fudhate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nuuti ijoollee worri irraa du'e,","poem":1},{"text":"ta abbaa hin qannee teeneerra;","poem":2},{"lineBreak":true},{"text":"haadhotiin teennalle","poem":2},{"lineBreak":true},{"text":"haadha hiyyeessaa te'aneeran.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bisaan unnuuf hin kaffalla;","poem":1},{"text":"qoraanille hin bitanna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Akka horii waanjoo itti hidhanee","poem":1},{"text":"oofamiisaan guddoo dadhanneerra;","poem":2},{"lineBreak":true},{"text":"fooralle nu dhoogganeeran.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sagalee quufiisaaf,","poem":1},{"text":"worra Gibxi'iitii fi Asooriititti harka kennanne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Abbootiin teenna ta durii","poem":1},{"text":"cubbuu hujjee dabarte;","poem":2},{"lineBreak":true},{"text":"nuuti ammoo sababa cubbuu isaaniitiif","poem":2},{"lineBreak":true},{"text":"rakkatiisatti jirra.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Garbooleen nu bulchan;","poem":1},{"text":"nami harka isaaniitii nu baasu hin jiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Goomolee keessa","poem":1},{"text":"ijjeechaan waan jirtuuf,","poem":2},{"lineBreak":true},{"text":"lubbuu teenna gurgurannee,","poem":2},{"lineBreak":true},{"text":"sagalee dhagganna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Beela irraa ka ka'e","poem":1},{"text":"gogaan keenna","poem":2},{"lineBreak":true},{"text":"akka suunsumaa gurraachoweera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dubartoota Xiyoon keessatti,","poem":1},{"text":"durralle qachoota Yihuda'aa keessatti","poem":2},{"lineBreak":true},{"text":"hunnaan woliin rafane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Sooreyyiin harka isaaniitiin fannifante;","poem":1},{"text":"jaarsoleen ulfinna dhadde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dargaggoota dhiiraa","poem":1},{"text":"hunnaan daakuu daassifatane;","poem":2},{"lineBreak":true},{"text":"ijoolleen dhiiraa","poem":2},{"lineBreak":true},{"text":"qoraan guddaa ba'atanee tintimane","poem":2},{"noteId":4},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Jaarsoleen","poem":1},{"text":"yaa'ii karra qacha'aa,","poem":2},{"lineBreak":true},{"text":"dargaggootille sirba lakkitteerti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Gammadi gadhaa keenna keessaa badeera,","poem":1},{"text":"sirbi keenna gara bowaa deebi'eera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nuuti cubbuu waan hunyeef,","poem":1},{"text":"ulfinni nu irraa ka'eera;","poem":2},{"lineBreak":true},{"text":"nu'uuf aanne'e!","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Waan kanaaf gadhaan nu dhibameera;","poem":1},{"text":"iltille nu cuurrotteerti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Sababa kanaaf gaarri Xiyoonii onee,","poem":1},{"text":"jeedalti irra burraaxxi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ee Waaqa, ati ammoo,","poem":1},{"text":"haga bara baraa mooti'i;","poem":2},{"lineBreak":true},{"text":"barcumaan mootummaa teetiille","poem":2},{"lineBreak":true},{"text":"dhalootaa haga dhalootaatitti jiraata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ati maaf ijjumaa nu deete?","poem":1},{"text":"Maaf haga kana mara nu lakkitte?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ee Waaqa, akka duriititti nu deebifadhu,","poem":1},{"text":"nuutille hin deebina;","poem":2},{"lineBreak":true},{"text":"bara keenna haaressii akka durii nuu tolchi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yoo kana hin tolchin ati nu gatteerta;","poem":1},{"text":"akka maleelle nutti aarteerta.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Tintimane: Yookiin gatantarane.","reference":{"chapter":5,"verse":13}}]},"thisChapterLink":"/api/gax_twf/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}