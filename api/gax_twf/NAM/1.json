{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"NAM","translationId":"gax_twf","name":"Naahomii Raagichaa","commonName":"Naahomii Raagichaa","title":"Kitaaba Naahomii Raagichaa","order":34,"numberOfChapters":3,"sha256":"e9777da6bdf1a24bfc252817a2bf99deed77c3c1a73b077165f7c5a3d6ab5c70","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gax_twf/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Mudhiin marroo Nanawwe'ee, kitaab mudhi'ii ka Naahomii nama biyya Elqoshii kana."]},{"type":"heading","content":["Waaqi Nanawwe'etti Mufate"]},{"type":"verse","number":2,"content":[{"text":"Waaqi hinaatticha;","poem":1},{"text":"Mootii Waan Maraa ka haluulle bawu;","poem":2},{"lineBreak":true},{"text":"inni mufii jadduu ifiitiin","poem":2},{"lineBreak":true},{"text":"diinota ifii irratti balaa buusa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Waaqi hunnaa guddoo qaba,","poem":1},{"text":"ammoo ariifatee hin aaru;","poem":2},{"lineBreak":true},{"text":"Yakkaamessa adabu male hin lakkisu.","poem":2},{"lineBreak":true},{"text":"Karaan isaa bubbe'ee fi danbalii keessa;","poem":2},{"lineBreak":true},{"text":"duumensi bukuu","poem":2},{"noteId":0},{"text":"miila isaa ti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inni abbaayaa xixee hin gossa;","poem":1},{"text":"laga maralle hin gossa;","poem":2},{"lineBreak":true},{"text":"Baashaan latti marraan beekkantee fi","poem":2},{"lineBreak":true},{"text":"Qarmelos latti qonnaan beekkante qooraneeran;","poem":2},{"lineBreak":true},{"text":"daraaraan Libaanosii harca'aneeran.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gaaroti isa duratti hin tacho'an;","poem":1},{"text":"koobotille hin baqan.","poem":2},{"lineBreak":true},{"text":"Latti isa duratti,","poem":2},{"lineBreak":true},{"text":"biyyi lafaatii fi","poem":2},{"lineBreak":true},{"text":"ka isii keessa le'anu marti hin raafaman.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mufii isaa jadduu dura eentu dhaabbatuu dande'a?","poem":1},{"text":"O'a aarii isaa eentu dande'ee ossa?","poem":2},{"lineBreak":true},{"text":"Mufiin isaa akka ibiddaa bobeetti;","poem":2},{"lineBreak":true},{"text":"rassaalle isa duratti hin bututa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Waaqi dansa'a;","poem":1},{"text":"yennaa rakkinnaa addee itti baqatanu.","poem":2},{"lineBreak":true},{"text":"Inni worra itti baqatu rakkinna irraa hin dhoogga;","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"diinota ifii ammoo akka lolaa haxowuu","poem":2},{"lineBreak":true},{"text":"ijjumaa balleessee, dukkanatti hin ari'a.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isin maaf Waaqa irratti mala dhoottan?","poem":1},{"text":"Inni ijjumaa isin hin balleessa;","poem":2},{"lineBreak":true},{"text":"lammeessoo nami isa irratti ka'u hin jiru.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Isin worri machoottanu,","poem":1},{"text":"akka qoree wol xaxxeetii fi","poem":2},{"lineBreak":true},{"text":"akka hicaacee goddee hin gubattan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ee Nanawwe'e, nami Waaqa irratti mala dhowu,","poem":1},{"text":"ka waan hantuu gorsulle,","poem":2},{"lineBreak":true},{"text":"si keessaa ka'e.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mootiin Waan Maraa,","poem":1},{"text":"kolbaa ifii Israa'eliin, «Worri Asoorii hunnaameyyi'ii fi","poem":2},{"lineBreak":true},{"text":"hedduu te'anulle,","poem":2},{"lineBreak":true},{"text":"ijjeefamanee, hin badan.","poem":2},{"lineBreak":true},{"text":"Kolbaa tiyya, tanaan dura ani isin rakkisulle,","poem":2},{"lineBreak":true},{"text":"yoona deebi'ee isin hin rakkisu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Amma ani waanjoo worra Asoorii isin irraa cassee,","poem":1},{"text":"wodaroo sibiilaa ta ittiin hidhantane","poem":2},{"lineBreak":true},{"text":"isin irraa hin ciccira» jedhe.","poem":2}]},{"type":"verse","number":14,"content":["Mootiin Waan Maraa marroo worra Asoorii,",{"text":"«Haganaa achi","poem":2},{"lineBreak":true},{"text":"sanyiin maqaa keessan waansittu hin jiraattu;","poem":2},{"lineBreak":true},{"text":"galma waaqota keessanii keessaa","poem":2},{"lineBreak":true},{"text":"waaqota dharaa fakkii bocantee fi","poem":2},{"lineBreak":true},{"text":"fakkii baqisiifantee hujantee hin balleessa.","poem":2},{"lineBreak":true},{"text":"Isin worra bu'aa hin qanne waan teeteef,","poem":2},{"lineBreak":true},{"text":"boolla awwaalaa isiniif hin qota» jedhee ajaja baaseera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kunoo, ergamaan oduu gammadaa odeessu,","poem":1},{"text":"ka nageya lallabu gaara gubba'aa dhufaara.","poem":2},{"text":"Kolbaa Yihuda'aa! Diinni keessan ijjumaa waan badeef,","poem":1},{"text":"haganaa achi biyya teessan hin qabatanu.","poem":2},{"text":"Tanaaf, gammadaan jilifadha'a.","poem":1},{"text":"Waan Waaqaaf kenniisaaf waadaa galtane Waaqaaf kenna'a.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Bukuu: Yookiin awwaara.","reference":{"chapter":1,"verse":3}}]},"thisChapterLink":"/api/gax_twf/NAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/NAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/MIC/7.json","previousChapterAudioLinks":{},"numberOfVerses":15}