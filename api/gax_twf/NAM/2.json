{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"NAM","translationId":"gax_twf","name":"Naahomii Raagichaa","commonName":"Naahomii Raagichaa","title":"Kitaaba Naahomii Raagichaa","order":34,"numberOfChapters":3,"sha256":"e9777da6bdf1a24bfc252817a2bf99deed77c3c1a73b077165f7c5a3d6ab5c70","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gax_twf/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["Badii Nanawwe'ee"]},{"type":"verse","number":1,"content":[{"text":"Nanawwe'e, ka balaa sitti buusu dhufeera.","poem":1},{"text":"Kushee teeti jabeeffadhu;","poem":2},{"lineBreak":true},{"text":"karaa eegi;","poem":2},{"lineBreak":true},{"text":"hidha keeti hidhadhu;","poem":2},{"lineBreak":true},{"text":"lolaaf qopheeffadhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Saantuun sanyii Yaaqoobii saantulle,","poem":1},{"text":"woynii isaaniille balleessitulle,","poem":2},{"text":"Waaqi ilmaan Yaaqoobii ka te'ane,","poem":1},{"text":"ulfinna Israa'elii hin deebisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Loltooti diinaa wontee diintuu qabataneeran;","poem":1},{"text":"isaan woyaa dhiillee uffataneeran;","poem":2},{"lineBreak":true},{"text":"yennaa isaan lolaaf qophowanu,","poem":2},{"lineBreak":true},{"text":"sibiilli garreettaa farda isaanii hin billiccisa;","poem":2},{"lineBreak":true},{"text":"woraanni isaanille hin mirmiffama.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Garreettoti fardaa karaa irra ariiti'iin gulufan;","poem":1},{"text":"woldeennaa kara'aa keessa asii fi achi gulufan.","poem":2},{"text":"Isaan umeessaa","poem":1},{"noteId":1},{"text":"bobe'u fakkaatan;","poem":1},{"text":"akka balaqqeetti'ii gugatan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mootiin Asoorii loltoota ifii beekkantuu hin waama;","poem":1},{"text":"isaan dhufaaranuun karaa irratti hin gufatan;","poem":2},{"lineBreak":true},{"text":"gara dalleya qacha'aa hin gulufan;","poem":2},{"lineBreak":true},{"text":"wonteelle qophootteerti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Karri karaa lagaa ba'a jettee banante;","poem":1},{"text":"manni mootumma'aa jige.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nanawween salphatte;","poem":1},{"text":"mootittiin isi'ii booji'antee fudhatante;","poem":2},{"lineBreak":true},{"text":"tajaajiltooti isi'ii ta dubarti'ii,","poem":2},{"lineBreak":true},{"text":"qoonqoo gaddaa","poem":2},{"lineBreak":true},{"text":"ta akka qoonqoo saphaliisaa dhageessisan.","poem":2},{"lineBreak":true},{"text":"Gaddaan qoma ifii dhodhowatan.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Akka bisaan naanniga cassee,","poem":1},{"text":"kolbaan Nanawwee keessaa hin baqatti!","poem":2},{"text":"«Dhaabbadhu! Dhaabbadhu!» jedhanee iyyan,","poem":1},{"text":"ammoo nami tokkolle hin deebi'u.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Karri qachaa sanii baca'a,","poem":1},{"text":"qabeenni adda addaalle tuula'a;","poem":2},{"lineBreak":true},{"text":"Dhaqa'aatii meeti'ii fi worqii saama'a!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nanawween baddee, ontee, duwwiteerti!","poem":1},{"text":"soda'aan baqanee, jilbille sheephiseera.","poem":2},{"text":"Neenqoleen marti hin hollatti;","poem":1},{"text":"fuulli nama maraatuu shankallowe!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mandheen neenqaa,","poem":1},{"text":"godi isaan dardaroota neenqaa itti nyaachisanu,","poem":2},{"lineBreak":true},{"text":"latti neenqi kormii fi dhalaan","poem":2},{"lineBreak":true},{"text":"sodaa malee keessa deddeemanu fakkaattu","poem":2},{"lineBreak":true},{"text":"qachaa sun amma meet ree?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Neenqi ilmoolee ifiitiif foon kukkuta;","poem":1},{"text":"neenqa dhala'aafille ka gewu adansa.","poem":2},{"text":"Inni goda ifii waan adanseen,","poem":1},{"text":"boolla ifiille foon kukkutameen guuta.","poem":2}]},{"type":"verse","number":13,"content":["Nanawwe'e! Mootiin Waan Maraa Ka Waan Mara dade, «Kunoo, ani si morma! Garreettaa fardaa keeti ibiddaan guba. Loltoota teeti shallaaga'aan fixa; waan ati adanfattu mara ani lafa irraa balleessa; qoonqoon ergantoota teetiille haganaa achi hin dhage'antu» jedha."]}],"footnotes":[{"noteId":1,"caller":"+","text":"Umeessaa: Yookiin Xassaa","reference":{"chapter":2,"verse":4}}]},"thisChapterLink":"/api/gax_twf/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}