{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"NAM","translationId":"gax_twf","name":"Naahomii Raagichaa","commonName":"Naahomii Raagichaa","title":"Kitaaba Naahomii Raagichaa","order":34,"numberOfChapters":3,"sha256":"e9777da6bdf1a24bfc252817a2bf99deed77c3c1a73b077165f7c5a3d6ab5c70","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gax_twf/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"heading","content":["Nanawwe'eef Aanne'e"]},{"type":"verse","number":1,"content":[{"text":"Qachaa dhiiga namaa dhangalaasu,","poem":1},{"text":"ka sobaan guutame, ka saantu'uun guutame,","poem":2},{"lineBreak":true},{"text":"ka booju'uun guutame, Nanawwe'eef aanne'e!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Worcaqqeessi","poem":1},{"noteId":2},{"text":"liche'eetii fi kokokkeessi korbo'oo,","poem":1},{"text":"hididdeessi fardaatii fi gugukkeessi garreettaa fardaa,","poem":2},{"lineBreak":true},{"text":"hin dhage'ama!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abbootiin fardaa hin gulufan,","poem":1},{"text":"shallaagaan isaanii hin billiccisa,","poem":2},{"lineBreak":true},{"text":"woraanni isaanii hin calaqqisa;","poem":2},{"lineBreak":true},{"text":"nami hedduun waan ijjeefameef,","poem":2},{"lineBreak":true},{"text":"reeffi tuulameera;","poem":2},{"lineBreak":true},{"text":"reeffi hedduu waan te'eef,","poem":2},{"lineBreak":true},{"text":"gufuu isaanitti te'eera!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ati ta xanoo xantu,","poem":1},{"text":"ta ilatti toltu sababa sagaagala keetii tun teete;","poem":2},{"lineBreak":true},{"text":"ati sagaagalummaa teetiin kolbaa garboonsitee,","poem":2},{"lineBreak":true},{"text":"xanoo teetiin gosa biyya adda addaalle gurgurte.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mootiin Waan Maraa Ka Waan Mara dade,","poem":1},{"text":"«Nanawwe'e, ani si morma;","poem":2},{"lineBreak":true},{"text":"uffana keeti si irraa shooqee","poem":2},{"noteId":3},{"text":"fuula keetitti buqa","poem":2},{"noteId":4},{"text":";","poem":2},{"lineBreak":true},{"text":"gosi marti qullaa keeti,","poem":2},{"lineBreak":true},{"text":"mootummaalle salphinna keeti akka dhaggitu godha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Ani huura","poem":1},{"noteId":5},{"text":"sitti gata,","poem":1},{"text":"si tuffadha","poem":2},{"noteId":6},{"text":",","poem":2},{"lineBreak":true},{"text":"akka si daaw'atanulle godha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Achiin duuba worri si daaw'ate marti si irraa baqataa,","poem":1},{"text":"‹Nanawween baddeerti; eentu bowaaf?› jedhan;","poem":2},{"lineBreak":true},{"text":"ka si jajjabeessu ani eessaa siif dhagga ree?» jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nanawwe'e, ati qachaa Tebesii","poem":1},{"noteId":7},{"text":",","poem":1},{"text":"ka laga Nayilii","poem":2},{"noteId":8},{"text":"biraa,","poem":2},{"lineBreak":true},{"text":"ka bisaan marseeru,","poem":2},{"lineBreak":true},{"text":"ka kaabiin isaa abbaaya'aa,","poem":2},{"lineBreak":true},{"text":"ka bisaan akka dalleyaa marseeru hin caaltaa?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Qachaan Tebesii loltoota Itoophiya'aatii","poem":1},{"noteId":9},{"text":"fi Gibxi'ii","poem":1},{"text":"ta haga hin qanneen eegameera;","poem":2},{"lineBreak":true},{"text":"Worri Fuxiitii fi Liibiya'aalle qarqaartota Tebesii ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Te'uu malee worri Tebesii qabamanee,","poem":1},{"text":"booji'amaneeran;","poem":2},{"lineBreak":true},{"text":"daa'immaan isaaniille","poem":2},{"lineBreak":true},{"text":"woldeennaa kara'aa mara irratti,","poem":2},{"lineBreak":true},{"text":"dhaka'aan tumamanee jijjiganeeran;","poem":2},{"lineBreak":true},{"text":"qondaaltota Tebesii irratti hixaa buufataneeran;","poem":2},{"lineBreak":true},{"text":"worri gugurdaan Tebesii marti","poem":2},{"lineBreak":true},{"text":"wodaroo sibiilaatiin hidhaman.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nanawwe'e, atille hin machootta,","poem":1},{"text":"gara dhokaataa hin ideenta;","poem":2},{"lineBreak":true},{"text":"diina duraa addee itti baqattu","poem":2},{"lineBreak":true},{"text":"hin barbaaddatta.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kusheen teeti mara akka muka harru'uu","poem":1},{"text":"ka midhaan qara bilchaatee ti.","poem":2},{"text":"Yoo hargufame,","poem":1},{"text":"afaan worra nyaatuu keessa harca'a.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Loltoota teeti ilaali;","poem":1},{"text":"isaan akka dubarti'ii ti.","poem":2},{"text":"Balbalti biyya teetii","poem":1},{"text":"diinota keetiif badhattee bananteerti;","poem":2},{"lineBreak":true},{"text":"danqaraa balbalootaalle ibiddi fixeera.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Diinaan waan marfantuuf,","poem":1},{"text":"bisaan woraabbadhu,","poem":2},{"lineBreak":true},{"text":"kushee teeti jabeeffadhu;","poem":2},{"lineBreak":true},{"text":"biyyee faaraa sukkuumii,","poem":2},{"lineBreak":true},{"text":"dhiitii qopheessii,","poem":2},{"lineBreak":true},{"text":"faara loobame huji!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Achitti ibiddaan gubata;","poem":1},{"text":"shallaagaalle'een kukkutanta.","poem":2},{"lineBreak":true},{"text":"Ibiddi akka awwaannisaa si fixa.","poem":2},{"lineBreak":true},{"text":"Akka awwaannisaatii fi","poem":1},{"text":"akka korophiisaa horuma hori!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ati urjoota gubba'aa caalaa,","poem":1},{"text":"daldaltoota teeti fakkanfatteerta.","poem":2},{"lineBreak":true},{"text":"Isaan akka awwaannisaa","poem":2},{"lineBreak":true},{"text":"biyya qorranee ka'anee badan.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Eeddoti teeti akka korophiisaa ti;","poem":1},{"text":"qondaaltoti teeti akka korophiisa","poem":2},{"lineBreak":true},{"text":"Guyyaa qabbanaa","poem":2},{"lineBreak":true},{"text":"dalleya irratti heechatee ti.","poem":2},{"text":"Yennaa aduun baatu, koolaan ka'ee deema;","poem":1},{"text":"gara inni dhaqe eennuulle hin beeku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ee mootii Asoorii,","poem":1},{"text":"eeddoti teeti muganeeran;","poem":2},{"lineBreak":true},{"text":"qondaaltoti teeti dunquuqqowaneeran.","poem":2},{"text":"Kolbaan teeti gaara irratti bittinnootteerti;","poem":1},{"text":"nami isaan wolitti qabulle hin jiru.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Miidhama keeti nami goomsu hin jiru;","poem":1},{"text":"madaan teeti hin fayyitu.","poem":2},{"text":"Nami oduu jinnana keeti dhage'e marti","poem":1},{"text":"gammadaan harka dhowa.","poem":2},{"text":"Nami gadhi-jabinna keeti ka muummee hin qanne","poem":1},{"text":"jalaa bayeeru jiraa ree?","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Worcaqqeessi: Yookiin dhuqaasi","reference":{"chapter":3,"verse":2}},{"noteId":3,"caller":"+","text":"Shooqee: Saaqe.","reference":{"chapter":3,"verse":5}},{"noteId":4,"caller":"+","text":"Buqa: Yookiin uffis.","reference":{"chapter":3,"verse":5}},{"noteId":5,"caller":"+","text":"Huura: Xuri.","reference":{"chapter":3,"verse":6}},{"noteId":6,"caller":"+","text":"Tuffadha: Malch.","reference":{"chapter":3,"verse":6}},{"noteId":7,"caller":"+","text":"Tebes: Amma Amoonijedhama; qachaa guddaa kaaba biyya Gibxi'ii jiru.","reference":{"chapter":3,"verse":8}},{"noteId":8,"caller":"+","text":"Nayili: Itoophiyaa keessatti Abbayijedhama.","reference":{"chapter":3,"verse":8}},{"noteId":9,"caller":"+","text":"Itoophiyaa: Yaadannoo Dad. 2:13 irratti kenname ilaali.","reference":{"chapter":3,"verse":9}}]},"thisChapterLink":"/api/gax_twf/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}