{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"NEH","translationId":"gax_twf","name":"Kitaaba Nahimiya'aa","commonName":"Kitaaba Nahimiya'aa","title":"Kitaaba Nahimiya'aa","order":16,"numberOfChapters":13,"sha256":"156722acddf7fafea72e4392330d66d7ecb7f1450d2af58f3d5dab4b3bda7915","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/NEH/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/gax_twf/NEH/13.json","totalNumberOfVerses":406},"chapter":{"number":9,"content":[{"type":"heading","content":["Israa'elooti Cubbuu Ifii Faaci'atane"]},{"type":"verse","number":1,"content":["Ji'uma san gaafa guyyaa diddamii arfeesso'oo Israa'elooti marroo cubbu'uutiif akka gaddane mudhisiisaaf woyaa gaddaa uffatanee, bukuu mataa ifii irratti firfifatanee, laamiisaaf wolitti qabamane."]},{"type":"verse","number":2,"content":["Worri sanyii Israa'elii te'ane martinuu worra ormaa irraa gargar bayanee dhaabbatanee, cubbuu ifii hujanee fi abbootiin isaanii hujje duudii dhugaa-baasane."]},{"type":"verse","number":3,"content":["Adduma dhaabbatanetti saatii sadiif kitaaba Seera Mootii Waan Maraa ka Waaqa isaanii, isaaniif dubbifame; akkasuma saatii sadiif cubbuu ifii dhugaa-baasaa Mootii Waan Maraa Waaqa ifiitiif sagadane."]},{"type":"verse","number":4,"content":["Iyaasuun, Baani, Qadmii'el, Shebaniyaan, Buni, Sherebiiyaan, Baanii fi Kenaan fa'a, yaabbannoo worri Lewwootaa irra bayanu irra dhaabbatanee, qoonqoo guddo'oon gara Mootii Waan Maraa Waaqa ifii daadimatane."]},{"type":"verse","number":5,"content":["Lewwooti worri Iyaasuu, Qadmii'el, Baani, Hashabniiyaa, Sherebiiyaa, Hodiiyaa, Shebaniyaa fi Fitaahiyaa jedhamanu,",{"text":"«Ka'a'aatii Mootii Waan Maraa","poem":1},{"text":"Waaqa keessan ka bara baraa","poem":2},{"lineBreak":true},{"text":"leellifadha'a!","poem":2},{"text":"‹Maqaan keeti ulfaataan,","poem":1},{"text":"ka galataa fi eebba duudii irra ol aanu","poem":2},{"lineBreak":true},{"text":"leellifamuu ti!› jedha'a!» jedhane.","poem":2}]},{"type":"heading","content":["Daadimata Faaci'atiisaa"]},{"type":"verse","number":6,"content":["Achiin duuba kolbaan Israa'elii,",{"text":"«Ee Mootii Waan Maraa!","poem":1},{"text":"Mootiin Waan Maraa si qofa.","poem":2},{"text":"Ol-gubbaa,","poem":1},{"text":"ol-gubbaa ol-gubbootaalle","poem":2},{"lineBreak":true},{"text":"dada isaan keessaa","poem":2},{"noteId":7},{"text":"woliin,","poem":2},{"lineBreak":true},{"text":"lafaa fi waan isii irra jiru duudii,","poem":2},{"lineBreak":true},{"text":"abbaaya'aa fi","poem":2},{"lineBreak":true},{"text":"waan isii keessa jiru duudii sittuu dade.","poem":2},{"text":"Ati isaan duudi'iifuu jiruu kennite;","poem":1},{"text":"dadi ol-gubba'aa","poem":2},{"noteId":8},{"text":"si'iif sagaddi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Ati Mootii Waan Maraa Waaqa Abraam filattee,","poem":1},{"text":"biyya Kaldootaa Ur keessaa baattee,","poem":2},{"lineBreak":true},{"text":"maqaa isaa ‹Abrahaam› jettee moggaatte.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Akkasuma inni si'iif addatamaa akka te'e dhaggitee,","poem":1},{"text":"biyya kana'aanotaa,","poem":2},{"lineBreak":true},{"text":"biyya Heetotaa,","poem":2},{"lineBreak":true},{"text":"biyya Amoorotaa,","poem":2},{"lineBreak":true},{"text":"biyya Pheriizotaa,","poem":2},{"lineBreak":true},{"text":"biyya Yibusootaatii fi Girgaashotaa","poem":2},{"lineBreak":true},{"text":"isaa fi sanyii isaatiif kenniisaaf waadaa galte.","poem":2},{"text":"Ati qajeelaa waan teeteef,","poem":1},{"text":"waadaa galte isaaf muummessite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Biyya Gibxi'iititti","poem":1},{"text":"rakkinna abbootii teenna dhaqqabe dhaggitee,","poem":2},{"lineBreak":true},{"text":"abbaayaa diintuu birattille iyya isaanii dhageettee,","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"mootiin Gibxi'ii,","poem":2},{"lineBreak":true},{"text":"qondaaltoti isaatii fi kolbaan lafa isaa irra leetu","poem":2},{"lineBreak":true},{"text":"attam akka kolbaa teeti hucuucane waan beetteef,","poem":2},{"lineBreak":true},{"text":"baasaa fi bilbaasa hujjee itti mudhitte.","poem":2},{"text":"Tana waan gooteef,","poem":1},{"text":"gurri keeti haga adhaa ol ka'eera.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abbaayaa fuula isaanii duratti gargar qooddee,","poem":1},{"text":"lafa godduu irra akka dabaranu goote.","poem":2},{"text":"Akka dhakaa abbaayaa qile'etti qolaanfamuu,","poem":1},{"text":"worra isaan ari'aa turelle qile'etti qolaansite.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kolbaa teeti ammoo,","poem":1},{"text":"guyyaa utubaa duumensaatiin,","poem":2},{"lineBreak":true},{"text":"halkanille karaa isaan irra deemanu akka isaaniif issuuf,","poem":2},{"lineBreak":true},{"text":"utubaa ibiddaatiin sooressite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Ati ol-gubbaa irraa gara gaara Siina'aa gad buutee,","poem":1},{"text":"isaanitti dubbattee,","poem":2},{"lineBreak":true},{"text":"seera qajeela'aa fi muraa dhuga'aa,","poem":2},{"lineBreak":true},{"text":"sirnaa fi ajaja dansaa isaaniif kennite.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sanbata keeti woyyichalle akka beekanu gootee,","poem":1},{"text":"karaa garbicha keeti Muuse'eetiin,","poem":2},{"lineBreak":true},{"text":"ajaja, sirnaa fi seera keeti isaaniif kennite.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yennaa beelayanelle ol-gubbaa irraa sagalee isaaniif kennitee,","poem":1},{"text":"yennaa dheebotanelle rassaa keessaa bisaan isaaniif burqisiitte.","poem":2},{"text":"Biyya isaanii kenniisaaf waadaa galtetti","poem":1},{"text":"akka galanuuf isaan ajajje.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«Abbootiin teenna ammoo koortee, mataa jabaattee,","poem":1},{"text":"ajaja keetiif ajajamuu didde.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Isaan ammoo ajajamuu didanee,","poem":1},{"text":"bilbaasa ati isaan oddu'utti hujjelle dedhane.","poem":2},{"text":"Mataa jabaatanee gara garbummaa ifii","poem":1},{"text":"Gibxi'iititti deebi'iisaaf nama isaan sooressu filatane.","poem":2},{"text":"Ati ammoo Waaqa jaalala bara baraatiin guutanteertu,","poem":1},{"text":"ka mufi'iif hin ariifanne,","poem":2},{"lineBreak":true},{"text":"ka araarantu, arja'aa fi mararaa waan teeteef","poem":2},{"lineBreak":true},{"text":"isaan hin lakkinne.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Isaan fakkii jabbi'ii ifiif hujanee,","poem":1},{"text":"‹Mootiin Waan Maraa","poem":2},{"lineBreak":true},{"text":"ka biyya Gibxi'ii keessaa nu baase kana› jedhanee,","poem":2},{"lineBreak":true},{"text":"isaan guddoo si faanshessane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«Marartiin teeti guddoo waan teeteef,","poem":1},{"text":"ati ammoo goomolee keessatti","poem":2},{"lineBreak":true},{"text":"isaan hin lakkinne.","poem":2},{"text":"Utubaan duumensaa guyyaa,","poem":1},{"text":"utubaan ibiddaa ammoo","poem":2},{"lineBreak":true},{"text":"halkan isaan sooresse.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Akka isaan barsiisuuf,","poem":1},{"text":"Ayyaana keeti isaanii kennite.","poem":2},{"text":"Mannaa isaan nyaatanuu fi","poem":1},{"text":"bisaan unanu isaanii kennite.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ati lafa goomole'ee keessatti","poem":1},{"text":"woggaa afurtama isaan qarqaarte.","poem":2},{"text":"Isaan womaa hin dhanne,","poem":1},{"text":"woyaan isaanii hin dulloonne,","poem":2},{"lineBreak":true},{"text":"miilli isaaniille hin iitonne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Ati mootummootaa fi","poem":1},{"text":"gosa biyya adda addaa Israa'eliif kennitee,","poem":2},{"lineBreak":true},{"text":"isaanille biyya sihoonii mootii Heshibooniitii fi","poem":2},{"lineBreak":true},{"text":"Oogii mootii Baashaanii qabatane.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ati ijoollee isaanii","poem":1},{"text":"akka urjoota ol-gubba'aa baceessitee,","poem":2},{"lineBreak":true},{"text":"gara biyyaa abbootiin isaanii itti galanee","poem":2},{"lineBreak":true},{"text":"akka qubatanu waadaa galteetitti isaan galchite.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ijoolleen isaaniille lafa Kana'aanii injifatanee qabatane;","poem":1},{"text":"ati kolbaa achi keessa leetu","poem":2},{"lineBreak":true},{"text":"mootota isaaniitii fi worra biyya sanii woliin","poem":2},{"lineBreak":true},{"text":"akka fedhane akka isaan godhanuuf,","poem":2},{"lineBreak":true},{"text":"harka isaanii keessa galchite.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Isaan qachoota gugurdaa","poem":1},{"text":"ka dalleya dhaka'aa qabuu fi lafa laattuu,","poem":2},{"lineBreak":true},{"text":"mana meya dadansa'aan guutamane,","poem":2},{"lineBreak":true},{"text":"boolla bisaanii ta qotanteertu,","poem":2},{"lineBreak":true},{"text":"addee woyni'iitii fi muka ejersaa,","poem":2},{"lineBreak":true},{"text":"akkasuma mukoota midhaanii hedduu qabatane.","poem":2},{"text":"Maarre isaan nyaatanee quufanee gabbatanee,","poem":1},{"text":"waan dadansaa guddoo ati isaanii kennitetti gammadane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"«Duubarra ammoo ajajama didanee,","poem":1},{"text":"si finqilanee, Seera keeti irra duubatti deebi'ane.","poem":2},{"text":"Raagota teeti worra akka isaan gara keeti deebi'anu isaan xixe ijjeesanee,","poem":1},{"text":"kana godhiisaan guddoo si faanshessane.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Tanaaf harka diinota isaanii,","poem":1},{"text":"worra isaan rakkisetti dabarsitee isaan kennitee,","poem":2},{"lineBreak":true},{"text":"isaan yennaa rakkatane sitti iyyane;","poem":2},{"lineBreak":true},{"text":"ati ol-gubbaa irraa isaaniif dhageettee,","poem":2},{"lineBreak":true},{"text":"marartii teeti guddo'oon,","poem":2},{"lineBreak":true},{"text":"harka diinota isaanii keessaa worra isaan baasu","poem":2},{"lineBreak":true},{"text":"sooreyyii isaaniif kennite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"«Isaan foora dhaggataneen duuba ammoo,","poem":1},{"text":"deebi'anee si duratti hantuu hujanee,","poem":2},{"lineBreak":true},{"text":"atille harka diinota ol aantumma'aan bulchutti","poem":2},{"lineBreak":true},{"text":"isaan lakkitte.","poem":2},{"text":"Te'uu malee yennaa isaan deebi'anee sitti iyyane,","poem":1},{"text":"ati ol-gubbaa irraa isaaniif dhageettee,","poem":2},{"lineBreak":true},{"text":"marartii teeti guddo'oon,","poem":2},{"lineBreak":true},{"text":"yennaa hedduu isaan baache.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"«Gara Seera keetii akka deebi'anuuf,","poem":1},{"text":"ati isaan gorsiteerta.","poem":2},{"text":"Isaan kooranee seera keeti didane;","poem":1},{"text":"waan si duratti sirrii te'e","poem":2},{"lineBreak":true},{"text":"ka nami eegatee ittiin le'u irratti ka'anee","poem":2},{"lineBreak":true},{"text":"cubbuu hujane.","poem":2},{"text":"Mataa jabaatanee dudda sitti galanee","poem":1},{"text":"morma jabeeffatanee,","poem":2},{"lineBreak":true},{"text":"dhage'iisa didane.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ati bara hedduu isaaniif ossattee,","poem":1},{"text":"karaa raagota teetiitiin","poem":2},{"lineBreak":true},{"text":"Ayyaana keetiitiin isaan gorsite;","poem":2},{"lineBreak":true},{"text":"te'uu malee isaan si hin dhageenne.","poem":2},{"text":"Tanaaf ati kolbaa ollaa isaaniititti","poem":1},{"text":"dabarsitee isaan kennite.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ammalle ati","poem":1},{"text":"Waaqa marartii guddoo qabu waan teeteef,","poem":2},{"lineBreak":true},{"text":"isaan hin ganne yookiin","poem":2},{"lineBreak":true},{"text":"hin balleessine.","poem":2},{"text":"Ati Waaqa marara'a;","poem":1},{"text":"arjaalle'e.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"«Tanaaf amma, Waaqa keenna,","poem":1},{"text":"ati gudda'a!","poem":2},{"lineBreak":true},{"text":"Ati attam hunnaamessaa fi sodaatama'a!","poem":2},{"text":"Ati Gondooro'oo fi jaalala keeti","poem":1},{"text":"ka bara baraa ka eeddu!","poem":2},{"lineBreak":true},{"text":"Rakkinna bara mootota Asooriitii jalqabee","poem":2},{"lineBreak":true},{"text":"haga adhaalle nu irra, mootota teenna irra,","poem":2},{"lineBreak":true},{"text":"qondaaltota teenna irra,","poem":2},{"lineBreak":true},{"text":"hayyoota teenna irra,","poem":2},{"lineBreak":true},{"text":"raagota teenna irra,","poem":2},{"lineBreak":true},{"text":"abbootii teennaa fi","poem":2},{"lineBreak":true},{"text":"kolbaa teeti mara irra geye qaabadhu!","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Waan nu irra geye maraaf","poem":1},{"text":"ati dhugaa qadda;","poem":2},{"lineBreak":true},{"text":"nuuti yakkaameyyii teenulle,","poem":2},{"lineBreak":true},{"text":"ati addatama'a.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Moototi teenna,","poem":1},{"text":"qondaaltoti teenna,","poem":2},{"lineBreak":true},{"text":"hayyooti teennaa fi","poem":2},{"lineBreak":true},{"text":"abbootiin teenna","poem":2},{"lineBreak":true},{"text":"Seera keeti hin eeganne.","poem":2},{"text":"Yookiin ajaja keetii fi","poem":1},{"text":"gorsa keeti hin qalbeeffanne.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Isaan mootummaa ifii keessatti,","poem":1},{"text":"lafa badho'oo fi laattuu","poem":2},{"lineBreak":true},{"text":"ati isaaniif kennite keessa,","poem":2},{"lineBreak":true},{"text":"yennaa turaneeyyuu siif hin tajaajille;","poem":2},{"lineBreak":true},{"text":"cubbuu ifii irraa hin deebine.","poem":2}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"«Kunoo, nuuti adha","poem":1},{"text":"lafa abbootiin teenna midhaan isi'iitii fi","poem":2},{"lineBreak":true},{"text":"waan dansaa isiin baachu akka nyaatanuuf,","poem":2},{"lineBreak":true},{"text":"ati isaaniif kennite keessatti garboota teene.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Sababa cubbuu teennaatiif,","poem":1},{"text":"wonni hedduun latti kennitu,","poem":2},{"lineBreak":true},{"text":"mootota worra ati nu irratti mootonsiteef galti;","poem":2},{"text":"Isaan nu'uu fi horii keenna irratti","poem":1},{"text":"akka jaalatane godhan.","poem":2},{"lineBreak":true},{"text":"Nuuti rakkinna guddaa keessa jirra.","poem":2}]},{"type":"heading","content":["Kolbaan Wolii Galtee Mallatteessite"]},{"type":"verse","number":38,"content":["«Sababa waan te'e san maraa, nuuti barreeffamaan wolii galtee tokko goona; qondaaltoti teenna, Lewwooti teennaa fi hayyooti teenna chaappaa itti godhan» jedhane."]}],"footnotes":[{"noteId":7,"caller":"+","text":"Dada isaan keessaa: Urjoota bannacha isaan keessaa ti.","reference":{"chapter":9,"verse":6}},{"noteId":8,"caller":"+","text":"Dadi ol-gubba'aa: Urjooti bannachi ol-gubba'aa jechuu isaanii ti.","reference":{"chapter":9,"verse":6}}]},"thisChapterLink":"/api/gax_twf/NEH/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/NEH/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/NEH/8.json","previousChapterAudioLinks":{},"numberOfVerses":38}