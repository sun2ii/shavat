{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"NUM","translationId":"gax_twf","name":"Kitaaba Seera Laakkossaa","commonName":"Kitaaba Seera Laakkossaa","title":"Kitaaba Seera Laakkossaa","order":4,"numberOfChapters":36,"sha256":"a12267beb89341c96a98e69d4751dcd8eb687fb83c996c64588ab7d161be9633","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/gax_twf/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["Bala'aam Israa'eloota eebbisuun Mootii Waan Maraa akka gammachiitte yennaa dhagge, inni fuula ifii gara goomole'ee deebifate malee, akka yennaa dhibi'ii waan ittiin moru barbaadatiisa hin dhandhe."]},{"type":"verse","number":2,"content":["Bala'aam ol ilaalee, worri Israa'elii gosa gosaan qubataneeranuun yennaa dhagge, Ayyaanni Waaqaa isa irratti bu'ee,"]},{"type":"verse","number":3,"content":["ergaa dubbattee, «Ergaan Bala'aamii ilma Be'orii,",{"text":"ergaan nama ilti isaa banantee,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ergaan nama jecha Waaqaa dhage'uu,","poem":2},{"lineBreak":true},{"text":"ka mudhii ka waan mara dande'uu dhagguu,","poem":2},{"lineBreak":true},{"text":"ka isa duratti gad jigeeruun,","poem":2},{"lineBreak":true},{"text":"ilti isaa banantee kana:","poem":2}]},{"type":"verse","number":5,"content":["«Ee Yaaqoob, dunkaanoti teeti,",{"text":"ee Israa'el quttumi keeti,","poem":2},{"lineBreak":true},{"text":"attam attam dansa'a!","poem":2}]},{"type":"verse","number":6,"content":["«Isaan akka meexxii banqaaxxuu,",{"text":"akka oorruu bisaan biraa ti;","poem":2},{"lineBreak":true},{"text":"isaan akka hargiisa","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa dhaabee ti;","poem":2},{"lineBreak":true},{"text":"isaan akka hindheensa bisaan biraa ti.","poem":2}]},{"type":"verse","number":7,"content":["«Sakkeelloo isaanii keessaa",{"text":"bisaan hin yaa'a;","poem":2},{"lineBreak":true},{"text":"sanyiin midhaan isaanii","poem":2},{"lineBreak":true},{"text":"bisaan guddaa hin dhaggatti.","poem":2},"«Mootiin isaanii mootii Agaagii hin caala;",{"text":"mootummaan isaaniille hin leellifanti.","poem":2}]},{"type":"verse","number":8,"content":["«Waaqi biyya Gibxi'iitii isaan baase,",{"text":"inni isaaniif akka gaafa gafarsaa ti.","poem":2},{"text":"Inni gosa biyya adda addaa","poem":1},{"text":"diinota isaanii hin kukkuta;","poem":2},{"lineBreak":true},{"text":"lafee isaaniille hin butucha;","poem":2},{"lineBreak":true},{"text":"daaya ifiitiin woraanee isaan fullaasa.","poem":2}]},{"type":"verse","number":9,"content":["«Isaan irkatanee,",{"text":"akka neenqa dhala'aatii","poem":2},{"lineBreak":true},{"text":"fi neenqa kormaa gad ciisane;","poem":2},{"lineBreak":true},{"text":"isaan kaasiisaaf ka itti guulu eennu?","poem":2},{"lineBreak":true},{"text":"«Worri si eebbisu eebbifamuu ti!","poem":1},{"text":"Worri si abaaru abaaramuu ti!» jedhe.","poem":2}]},{"type":"verse","number":10,"content":["Achiin duuba Balaaqi, Bala'aamitti aaree bobe'ee, harka dhowee, «Ani akka ati diinota kiyya abaartuuf si waame; ati ammoo kunoo yennaa sad isaan eebbitte."]},{"type":"verse","number":11,"content":["Amma ariifadhuu gara mana keetii deemi! Ani silaa, ‹Gatii dansaa si'iif hin kaffala› jedheeraayyu. Mootiin Waan Maraa ammoo gatii dhaggatiisa si dhoogge» jedhe."]},{"type":"verse","number":12,"content":["Bala'aamille deebisee, Balaaqiin, «Ani ergantoota teeti ta ati natti ergitetti himee,"]},{"type":"verse","number":13,"content":["‹Balaaqi mana ifii ka mootumma'aa ka meeti'ii fi worqi'iin guutame san yoo naaf kennelle, waan Mootiin Waan Maraa natti dubbate qofa dubbadha male, jecha isaa irra dabaree, fedha kiyyaan waan dansaa yookiin waan badduu godhiisaaf hin dande'u› hin jenneeyyuu?"]},{"type":"verse","number":14,"content":["Maarre amma ani gara kolbaa tiyyaa deebi'ee deemaara; gara duraa ammoo waan kolbaan Israa'elii tun kolbaa teeti irratti godhu'uuf jirtu koy sitti hima» jedhe."]},{"type":"heading","content":["Ergaa Bala'aamii Ta arfeesso'oo"]},{"type":"verse","number":15,"content":["Achiin duuba ergaa dubbatee,",{"text":"«Ergaan Bala'aamii ilma Be'orii,","poem":1},{"text":"ergaan nama ilti isaa banantee,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ergaan nama jecha Waaqaa dhage'uu,","poem":1},{"text":"ka beekkumsa Ol Aana'aa qabuu,","poem":2},{"lineBreak":true},{"text":"ka mudhii ka waan mara dande'uu dhagguu,","poem":2},{"lineBreak":true},{"text":"ka isa duratti gad jigeeruun,","poem":2},{"lineBreak":true},{"text":"ilti isaa banantee kana:","poem":2}]},{"type":"verse","number":17,"content":["«Ani isa dhagga, ammoo ammaa moti;",{"text":"ani isa ilaala, ammoo dhiko'ottii moti.","poem":2},{"text":"Bakalchi Yaaqoob keessaa hin baya;","poem":1},{"text":"Israa'el keessaa","poem":2},{"lineBreak":true},{"text":"uleen bokkuu mootumma'aa hin ka'a.","poem":2},{"text":"Sooreyyii worra Mo'aabii hin butucha;","poem":1},{"text":"buqqii mataa ilmaan Sheetii mara hin caccassa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Edoom hin qabatanti;","poem":1},{"text":"Se'iir ta diina isaa teetelle ta isaa hin teeti;","poem":2},{"lineBreak":true},{"text":"Israa'el ammoo jabaataatuma hin ideenti.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sanyii Yaaqoobii keessaa","poem":1},{"text":"bulchaan tokko hin dhufa;","poem":2},{"lineBreak":true},{"text":"worra qachaa guddicha keessatti hafelle","poem":2},{"lineBreak":true},{"text":"hin balleessa» jedhe.","poem":2}]},{"type":"verse","number":20,"content":["Achiin duuba Bala'aam",{"text":"gara worra Amaaleqii ilaalee,","poem":2},{"lineBreak":true},{"text":"ergaa ifii dubbatee,","poem":2},{"text":"«Gosa biyya adda addaa oddu'utti","poem":1},{"text":"worri Amaaleqii ka qaraa te'ee ture,","poem":2},{"lineBreak":true},{"text":"muummeen isaanii ammoo","poem":2},{"lineBreak":true},{"text":"badii bara baraa ti» jedhe.","poem":2}]},{"type":"verse","number":21,"content":["Achiin duuba inni gara worra Qenootaa ilaalee,",{"text":"ergaa ifii dubbatee,","poem":2},{"text":"«Addeen quttuma teessanii addachiittu'u;","poem":1},{"text":"mandheen teessan","poem":2},{"lineBreak":true},{"text":"rassaa keessatti ijaaranteerti.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ammoo yennaa worri Asoorii isin booji'e,","poem":1},{"text":"isin worri Qenootaa hin baddan» jedhe.","poem":2}]},{"type":"verse","number":23,"content":["Ammalle inni ergaa ifii dubbatee,",{"text":"«Aanne'e, yennaa Waaqi tana godhu","poem":1},{"text":"eentu jiraata ree?","poem":2},{"noteId":20}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Qarqara Kitiimiitii ammoo","poem":2},{"lineBreak":true},{"text":"hobolooti gugurdoon hin dhufan;","poem":2},{"lineBreak":true},{"text":"isaan Asoorii fi Ebeer hin qabatan;","poem":2},{"lineBreak":true},{"text":"isaanille ifiifuu","poem":2},{"lineBreak":true},{"text":"haga bara baraa hin badan» jedhe.","poem":2}]},{"type":"verse","number":25,"content":["Achiin duuba Bala'aam ka'ee gara mana ifii deebi'e; Balaaqille karaa ifii deeme."]}],"footnotes":[{"noteId":20,"caller":"+","text":"Yennaa Waaqi tana godhu eentu jiraata ree: Afaan Ibrootaatiin, «Kolbaan gara kaabaatitti wolitti qabante tun tam?» hiikkaa jettulle hin qaba.","reference":{"chapter":24,"verse":23}}]},"thisChapterLink":"/api/gax_twf/NUM/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/NUM/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/NUM/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}