,"poem":2},{"text":"‹Eentu lafatti gad na buusa?› ka jettu,","poem":1},{"text":"koora keetittuu si sobe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ati akka risa'aa gubbaa irra yoo kaatelle,","poem":1},{"text":"mandhee teeti urjoota oddu'utti,","poem":2},{"lineBreak":true},{"text":"yoo ijaarrattelle,","poem":2},{"lineBreak":true},{"text":"ani achii gad si buusa","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hattuun Yookiin saantuun","poem":1},{"text":"halkaniin mana keeti yoo dhufane,","poem":2},{"lineBreak":true},{"text":"haguma barbaadane qofa fudhatan.","poem":2},{"text":"Worri midhaan woyni'ii guuratulle,","poem":1},{"text":"woxoo hin lakkisa.","poem":2},{"text":"Diinni keeti ammoo","poem":1},{"text":"ijjuma si hin balleessa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isin sanyiin Esaawuu","poem":1},{"noteId":0},{"text":"manni keessan soffameera.","poem":2},{"lineBreak":true},{"text":"Karri teessan duudiille saamanteerti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Goliin teeti si sobanee,","poem":1},{"text":"biyya teeti keessa si ari'ane.","poem":2},{"text":"Jaaloti teeti worri addatamane","poem":1},{"text":"dhossa'aan tiyyoo si duratti afanee,","poem":2},{"lineBreak":true},{"text":"‹Qarummaan isaa meet› jedhane.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Guyyaa sanitti Mootiin Waan Maraa:","poem":1},{"text":"Ani qaroolle Edoom keessaa,","poem":2},{"lineBreak":true},{"text":"worra hubantii qabu","poem":2},{"lineBreak":true},{"text":"gaara Esaawuu irraa hin balleessu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ee qachaa Temaanii!","poem":1},{"text":"Loltooti teeti hin bararaqan;","poem":2},{"lineBreak":true},{"text":"worri gaara Esaawuu irra","poem":2},{"lineBreak":true},{"text":"jiranu martinuu hin ijjeefaman.","poem":2}]},{"type":"heading","content":["Adabamiisa Edoomii"]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Sanyii Obboleessa keeti Yaaqoobii","poem":1},{"text":"hunnaan waan ijjeetteef,","poem":2},{"lineBreak":true},{"text":"hin qaanotta;","poem":2},{"lineBreak":true},{"text":"haga bara baraalle hin badda.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Guyyaa alagaan karra saame,","poem":1},{"text":"worri ormaa dalleya cassee seenee","poem":2},{"lineBreak":true},{"text":"Yerusaalem irratti hixaa buufate,","poem":2},{"lineBreak":true},{"text":"atille akkuma worra sanii itti teetee,","poem":2},{"lineBreak":true},{"text":"irraa fagaattee dhaabbatte.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Guyyaa obboleessi keeti rakkatu","poem":1},{"text":"isatti qacifatuun,","poem":2},{"lineBreak":true},{"text":"guyyaa badii kolbaa Yihuda'aa, gammaduun,","poem":2},{"lineBreak":true},{"text":"guyyaa gadda isaanii geeraruun","poem":2},{"lineBreak":true},{"text":"si'iif hin malle.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Guyyaa badii kolbaa tiyyaa","poem":1},{"text":"qachaa isaanii seenuun,","poem":2},{"lineBreak":true},{"text":"guyyaa badii isaanii itti qacifatuun,","poem":2},{"lineBreak":true},{"text":"karra isaaniille saamuun","poem":2},{"lineBreak":true},{"text":"si'iif hin malle.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Guyyaa gadda isaanii","poem":1},{"text":"qaxxaamura kara'aa irra dhaabbattee","poem":2},{"lineBreak":true},{"text":"worra baqatanee bayanu qaddee","poem":2},{"lineBreak":true},{"text":"dabarsitee diinotatti kennuun,","poem":2},{"lineBreak":true},{"text":"si'iif hin malle.","poem":2}]},{"type":"heading","content":["Mootiin Waan Maraa Gosa Biyya Adda Addaatitti Hin Mura"]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«Guyyaan ani Mootiin Waan Maraa","poem":1},{"text":"gosa biyya adda addaa maratti muru dhikaateera;","poem":2},{"text":"Edoom, akkuma ati nama irratti goote","poem":1},{"text":"si'i irralle'etti hin godhama;","poem":2},{"lineBreak":true},{"text":"hujiin teeti hantuun mataa keetitti hin deebiti.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Akkuma kolbaan tiyya","poem":1},{"text":"gaara kiyya woyyicha irratti","poem":2},{"lineBreak":true},{"text":"muduunuu rakko'oo unte,","poem":2},{"lineBreak":true},{"text":"gosi biyya adda addaa marti","poem":2},{"lineBreak":true},{"text":"adoo wol irraa hin kutin hin unti;","poem":2},{"lineBreak":true},{"text":"irra caalaalle hin unti;","poem":2},{"lineBreak":true},{"text":"akka hin jirrelle hin teeti.","poem":2}]},{"type":"heading","content":["Injifachaa Israa'elii"]},{"type":"verse","number":17,"content":[{"text":"Worri gariin ammoo","poem":1},{"text":"gaara Xiyoonii irratti hin hafan,","poem":2},{"lineBreak":true},{"text":"gaarri Xiyooniille woyyicha hin te'a;","poem":2},{"lineBreak":true},{"text":"sanyiin Yaaqoobii ammoo","poem":2},{"lineBreak":true},{"text":"worra lafa isaanii","poem":2},{"lineBreak":true},{"text":"isaan irraa fudhate irraa","poem":2},{"lineBreak":true},{"text":"deebifatanee hin fudhatan.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Sanyiin Yaaqoobii akka ibiddaa,","poem":1},{"text":"sanyiin Yoseefiille","poem":2},{"lineBreak":true},{"text":"akka bobe'aa te'anee,","poem":2},{"lineBreak":true},{"text":"sanyii Esaawuu ta akka huuraa","poem":2},{"lineBreak":true},{"text":"gubanee hin fixan;","poem":2},{"lineBreak":true},{"text":"sanyii Esaawuu keessaa ka hafu","poem":2},{"lineBreak":true},{"text":"tokkolle hin jiru.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Worri biyya Yihuda'aatiin gara kibbaa jiranu","poem":1},{"text":"gaara Esaawuu,","poem":2},{"lineBreak":true},{"text":"worri gaara jala jiranu ammoo","poem":2},{"lineBreak":true},{"text":"biyya Filisxeemotaa hin qabatan;","poem":2},{"lineBreak":true},{"text":"isaan Samaariya'aa fi","poem":2},{"lineBreak":true},{"text":"lafa sanyii Efreemii hin qabatan;","poem":2},{"lineBreak":true},{"text":"sanyiin Beniyaaminii ammoo","poem":2},{"lineBreak":true},{"text":"Giil'aad hin qabatan.","poem":2}]}