{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":1,"content":[{"type":"heading","content":["Bu'aa Fakkeennaa"]},{"type":"verse","number":1,"content":["Fakkeenni Solomoonii ilma Daawitii, ka mootii Israa'elii ka asii gad jiranu:"]},{"type":"verse","number":2,"content":[{"text":"Isaan kun namooti qarumma'aa fi","poem":1},{"text":"qajeelfama dansaa akka fudhatanu,","poem":2},{"lineBreak":true},{"text":"jechoota beekkumsa ifi keessaa qabanu,","poem":2},{"lineBreak":true},{"text":"akka hubatanu,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"balchumma'aa fi haqaan,","poem":2},{"lineBreak":true},{"text":"waan dhugaa te'e godhiisaan,","poem":2},{"lineBreak":true},{"text":"amala qarumma'aatiin","poem":2},{"lineBreak":true},{"text":"qajeelfama akka fudhatanu,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"worri beekkumsaan hin bilchaatin,","poem":2},{"lineBreak":true},{"text":"hubantii akka qabaatanu,","poem":2},{"lineBreak":true},{"text":"dargaggooti beekkumsaa fi,","poem":2},{"lineBreak":true},{"text":"qalbii akka qabaatanu qarqaaran.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Worri qarooleen fakkeenna kana caqasanee,","poem":1},{"text":"barumsa ifii itti ede'atanuu ti;","poem":2},{"lineBreak":true},{"text":"worri hubantii qabanulle","poem":2},{"lineBreak":true},{"text":"qajeelfama irraa fudhatanuu ti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Akka kanaan isaan fakkeennaa fi mammaassa,","poem":1},{"text":"hiikkaa jedhi'iitii fi","poem":2},{"lineBreak":true},{"text":"hiibboo worra qaroole'eelle hin hubatan.","poem":2}]},{"type":"heading","content":["Gorsa Dargaggeeyyi'iif Kenname"]},{"type":"verse","number":7,"content":[{"text":"Qarummaan jalqabaa,","poem":1},{"text":"Mootii Waan Maraa sodaatiisa;","poem":2},{"lineBreak":true},{"text":"gowwooleen ammoo,","poem":2},{"lineBreak":true},{"text":"qarumma'aa fi gorsa tuffatti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ilma kiyya, gorsa abbaa keetii dhage'i;","poem":1},{"text":"barsiisa haadha teetiille hin lakkisin","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Barsiisi isaanii,","poem":1},{"text":"mataa keetiif akka kallacha ulfinnaa ti;","poem":2},{"lineBreak":true},{"text":"morma keetiifille,","poem":2},{"lineBreak":true},{"text":"akka meya seesaaf diramee ti.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ilma kiyya,","poem":1},{"text":"cubbaaleyyiin yoo si hawadatte,","poem":2},{"lineBreak":true},{"text":"tole hin jedhiniif.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isaan yoo, «Nu woliin koy;","poem":1},{"text":"dhiiga namaa dhangalaasiisaaf","poem":2},{"lineBreak":true},{"text":"dhokannee gaadanna;","poem":2},{"lineBreak":true},{"text":"nama yakkaa hin qanne,","poem":2},{"lineBreak":true},{"text":"sababa malee miidhiisaaf kara'atti eeganna!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Akka addee worri du'e jiru,","poem":1},{"text":"akka worra gara boolla awwaalaa gad bu'uu,","poem":2},{"lineBreak":true},{"text":"adoo isaan jiru'uu fi fayya'aan jiranuu,","poem":2},{"lineBreak":true},{"text":"kowaa isaan liqinsinaa ti!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nuuti meya gatii guddo'oo","poem":1},{"text":"ka gosa adda addaa hin dhagganna;","poem":2},{"lineBreak":true},{"text":"mana keennalle","poem":2},{"lineBreak":true},{"text":"waan saamanneen","poem":2},{"lineBreak":true},{"text":"hin guutanna!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Koy nu woliin hirmaadhu;","poem":1},{"text":"waan hannaan fudhanne","poem":2},{"lineBreak":true},{"text":"woliin qoodanna»","poem":2},{"lineBreak":true},{"text":"yoo si'iin jedhane,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ilma kiyya, isaan woliin hin deemin;","poem":1},{"text":"daandii isaanii irraa miila keeti eeggadhu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Miilli isaanii gara cubbu'uu rukkisa;","poem":1},{"text":"isaan dhiiga dhangalaasiisaaf ariifatan.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Adoo sinbirree dhaggituu","poem":1},{"text":"fonxoroo itti afuun,","poem":2},{"lineBreak":true},{"text":"bu'aa hin qaddu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Namooti kun dhiiguma ifii","poem":1},{"text":"dhangalaasiisaaf dhokatanee gaadan;","poem":2},{"lineBreak":true},{"text":"isaan ifuma dhokatanee gaadan.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Muummeen worra joljoluu akkas jirti;","poem":1},{"text":"joljolummaan isaan ijjeetti.","poem":2}]},{"type":"heading","content":["Waamicha Qarumma'aa"]},{"type":"verse","number":20,"content":[{"text":"Qarummaan woldeennaa","poem":1},{"text":"kara'aa keessaa iyyitee waammatti;","poem":2},{"lineBreak":true},{"text":"badhinna keessaa qoonqoo ol qabattee iyyiti.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Karaa namooti hogisanu keessaa iyyiti;","poem":1},{"text":"seensuma qacha'aa keessaa dubbatti:","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Isiin, «Isin worri gowwooleen,","poem":1},{"text":"haga yoomii,","poem":2},{"lineBreak":true},{"text":"gowwummaa teessan jaalattan?","poem":2},{"text":"Isin worri murgaameyyiin,","poem":1},{"text":"haga yoomii,","poem":2},{"lineBreak":true},{"text":"murgoo teessanitti gammaddan?","poem":2},{"text":"Isin worri gowwooleen,","poem":1},{"text":"haga yoomii beekkumsa jibbitan?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Isin xixicha kiyya yoo dhageettane,","poem":1},{"text":"ani silaa waan gadhaa kiyya keessa jiru,","poem":2},{"lineBreak":true},{"text":"yaada kiyya akka beettanu hin godhaayyu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Isin ammoo,","poem":1},{"text":"yennaa ani waamu eega diddanee,","poem":2},{"lineBreak":true},{"text":"yennaa ani harka kiyya diriirsu,","poem":2},{"lineBreak":true},{"text":"eega itti hin xiyyeeffatinii,","poem":2}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"isin gorsa kiyya mara tuffatanee,","poem":2},{"lineBreak":true},{"text":"xixicha kiyyalle eega hin fudhatinii,","poem":2}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"yennaa isin farra keessa jirtanu,","poem":2},{"lineBreak":true},{"text":"anille isinitti hin kolla.","poem":2},{"text":"Yennaa balaan isinitti bu'u","poem":1},{"text":"ani isinitti hin murga.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Yennaa wonni hantuun,","poem":1},{"text":"akka bubbee bokkeyaa isinitti dhuttu,","poem":2},{"lineBreak":true},{"text":"yennaa balaan akka hobonbolatti'ii isin haxowu,","poem":2},{"lineBreak":true},{"text":"yennaa dhippinnii fi rakkinni isin irra garagalu,","poem":2},{"lineBreak":true},{"text":"ani isinitti murga.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Yennaa san isin na hin waantan;","poem":1},{"text":"ani ammoo deebii isiniif hin kennu;","poem":2},{"text":"Isin akka malee na barbaaddan,","poem":1},{"text":"ammoo na hin dhaggitanu.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Isin beekkumsa Waan jibbitaneef,","poem":1},{"text":"Mootii Waan Maraa sodaatiisa,","poem":2},{"lineBreak":true},{"text":"waan hin filanneef,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Isin gorsa kiyya waan hin fudhatiniif,","poem":1},{"text":"xixicha kiyya mara waan tuffataneef,","poem":2}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"isin midhaanuma hujattane hin nyaattan;","poem":2},{"lineBreak":true},{"text":"bu'aa mala nama irratti","poem":2},{"lineBreak":true},{"text":"dhoottanee hin dhaggatan.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Worra beekkumsaan hin bilchaatin","poem":1},{"text":"qarummaa irra fagaatiisatti ijjeesa;","poem":2},{"lineBreak":true},{"text":"gowwooleelle rincica isaaniititti,","poem":2},{"lineBreak":true},{"text":"isaan balleessa.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Worri na dhage'u ammoo,","poem":1},{"text":"nageyaan le'a;","poem":2},{"lineBreak":true},{"text":"waan hantuu adoo hin sodaatin,","poem":2},{"lineBreak":true},{"text":"bidhaa malee jiraata» jetti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}