 jabaatee huju ammoo nama duroonsa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Worri yenna'aan midhaan galfatu qaro'o;","poem":1},{"text":"worri yennaa midhaan galfatiisaa rafu ammoo","poem":2},{"lineBreak":true},{"text":"hin salphata.","poem":2}]},{"type":"verse","number":6,"content":["Eebbi mataa balchootaa irra jira;",{"text":"worri hunnaan nama irratti ka'u dubbii dansa'aan","poem":2},{"lineBreak":true},{"text":"hunnaan nama irratti ka'iisa ifii gollatan.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yaadannoon nama balcha'aa eebbaaf hin teeti;","poem":1},{"text":"maqaan nama hama'aa ammoo hin dedhama.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nami gadhaa ifii keessatti qaro'oo seera fudhata;","poem":1},{"text":"nami gowwaan dubbattichi ammoo","poem":2},{"lineBreak":true},{"text":"gara badi'ii deema.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nami haqaan ideemu nageyaan le'a;","poem":1},{"text":"nami karaa micciiramaa gula deemu ammoo","poem":2},{"lineBreak":true},{"text":"hin saaxilama.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nami ilaan qiphifatu rakkinna fida;","poem":1},{"text":"nami gowwaan dubbattichi ammoo","poem":2},{"lineBreak":true},{"text":"gara badi'ii deema.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Afaan nama balcha'aa madda jiru'uu ti;","poem":1},{"text":"worri hunnaan nama irratti ka'u ammoo","poem":2},{"lineBreak":true},{"text":"dubbii dansa'aan","poem":2},{"lineBreak":true},{"text":"hunnaan nama irratti ka'iisa ifii gollatan.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Jibbi lola kaasa;","poem":1},{"text":"jaalalli ammoo yakkaa mara golla.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Qarummaan afaan qaroole'ee irra jirti;","poem":1},{"text":"adabbiin ammoo dudda","poem":2},{"lineBreak":true},{"text":"gowwoole'ee irra jirti.","poem":2}]},{"type":"verse","number":14,"content":["Qarooleen beekkumsa tuulatti;",{"text":"dubbiin gowwa'aa ammoo badii fiddi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Qabeenni dureeyyi'iif qachaa dalleya dhaka'aa qabu;","poem":1},{"text":"hiyyummaan ammoo badii hiyyeeyyi'ii ti.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Gatiin eloo balcha'aa jiru'u;","poem":1},{"text":"bu'aan nama hama'aa adabbi'i.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nami gorsa fudhatu karaa jiru'uu namatti mudhisa;","poem":1},{"text":"nami xixicha tuffatu ammoo","poem":2},{"lineBreak":true},{"text":"karaa irraa nama milissa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nami jibba ifii dhoffatu dharaamessa;","poem":1},{"text":"nami hamii odeessu gowwa'a.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Jechoota bacaa keessaa,","poem":1},{"text":"cubbuun hin dhabantu;","poem":2},{"lineBreak":true},{"text":"nami arraba ifii eegatu ammoo qaro'o.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dubbiin nama balcha'aa akka meetii qullu'uu ti;","poem":1},{"text":"yaadi nama hama'aa ammoo gatii hin qabu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Afaan nama balcha'aa nama hedduu areera;","poem":1},{"text":"worri gowwaan ammoo","poem":2},{"lineBreak":true},{"text":"qalbii dhabiisaan du'a.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Eebbi Mootii Waan Maraa durummaa kenna;","poem":1},{"text":"inni rakkinna isi'itti hin dabalu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nami gowwaan waan hantuu hujiisatti gammada;","poem":1},{"text":"nami hubantii qabu ammoo","poem":2},{"lineBreak":true},{"text":"qarumma'atti gammada.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nama hamaa waan inni guddoo sodaatutti itti dhufa;","poem":1},{"text":"nama balchaa ammoo","poem":2},{"lineBreak":true},{"text":"waan inni guddoo halchutti isaaf kennama.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Hobonbolattiin yennaa kaatu,","poem":1},{"text":"worra hamaa haxoottee dabarti;","poem":2},{"lineBreak":true},{"text":"worri balchaan ammoo","poem":2},{"lineBreak":true},{"text":"haga bara baraa","poem":2},{"lineBreak":true},{"text":"jabaatee dhaabbata.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Wonni dhangaggowu ilkaan,","poem":1},{"text":"aarrille ila akkuma rakkisu,","poem":2},{"lineBreak":true},{"text":"nami booseyille","poem":2},{"lineBreak":true},{"text":"nama isa ergatu rakkisa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mootii Waan Maraa sodaatiis jiruu dheeressa;","poem":1},{"text":"woggaan nama hama'aa ammoo gabaaddu'u.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Addiin worra balcha'aa gammada;","poem":1},{"text":"addiin worra hama'aa bu'aa hin qaddu.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Karaan Mootii Waan Maraa","poem":1},{"text":"worra balcha'aaf gollaa jaddu'u;","poem":2},{"lineBreak":true},{"text":"worra hantuu hujuuf ammoo badi'i.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Worri balchaan ijjumaa hin munyuuqu;","poem":1},{"text":"worri hamaan ammoo lafa irratti hin hafu.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Afaan worra balcha'aa qarummaa dubbata;","poem":1},{"text":"arrabi dubbii micciiru ammoo hin murama.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Afaan worra balcha'aa dubbii toltu beeka;","poem":1},{"text":"afaan worra hama'aa ammoo micciiriisa qofa beeka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/9.json","previousChapterAudioLinks":{},"numberOfVerses":32}