er":24,"content":[{"text":"Nami gariin toluma karra ifii namaaf kenna;","poem":1},{"text":"ammoo irra caalaa duroomaa deema;","poem":2},{"lineBreak":true},{"text":"nami gariin akka malee donnooma;","poem":2},{"lineBreak":true},{"text":"ammoo hiyyoommataatuma deema.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nami arjaan hin durooma;","poem":1},{"text":"nami dheebuu nama baasulle","poem":2},{"lineBreak":true},{"text":"ifille'eef dheebuu hin baya.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nama midhaan kuufatee tursu","poem":1},{"text":"kolbaan hin abaarti;","poem":2},{"lineBreak":true},{"text":"nami midhaan baasee","poem":2},{"lineBreak":true},{"text":"gurguratu ammoo","poem":2},{"lineBreak":true},{"text":"eebba dhaggata.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nami waan dansaa jabaatee barbaadu,","poem":1},{"text":"waan dansaa dhaggata;","poem":2},{"lineBreak":true},{"text":"nami waan hantuu barbaadu ammoo","poem":2},{"lineBreak":true},{"text":"waan hantuu dhaggatta.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Nami durummaa ifiititti addatu hin jiga;","poem":1},{"text":"nami balchaan ammoo","poem":2},{"lineBreak":true},{"text":"akka baala jiidha'aa hin bisila.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Nami maatii ifii rakkisu,","poem":1},{"text":"harka duwwaa hin hafa;","poem":2},{"lineBreak":true},{"text":"gowwaan tajaajilaa qaro'oo hin te'a.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Hujiin nama balcha'aa","poem":1},{"text":"muka jiru'uu ti;","poem":2},{"lineBreak":true},{"text":"nami barsiisee lubbuu namaa deebisu qaro'o.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Worri balchaan lafa irratti","poem":1},{"text":"gatii hujii ifii akkuma dhaggatanu,","poem":2},{"lineBreak":true},{"text":"worri Waaqa malee le'uu fi","poem":2},{"lineBreak":true},{"text":"worri cubbaaleyyiille lafa irratti akkasuma","poem":2},{"lineBreak":true},{"text":"gatii 