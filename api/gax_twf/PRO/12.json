{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Nami qajeelfama jaalatu,","poem":1},{"text":"beekkumsa jaalatta;","poem":2},{"lineBreak":true},{"text":"nami xixicha jibbu ammoo gowwa'a.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nami dansaan Mootii Waan Maraa biratti","poem":1},{"text":"fudhatama hin dhaggata;","poem":2},{"lineBreak":true},{"text":"worra yaada hama'aa ammoo","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa itti hin mura.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nami karaa hama'aan jabaatee dhaabbatuu hin dande'u;","poem":1},{"text":"balchaan ammoo adde'ee hin tacho'u.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Niitiin qalbeeffattuun dhirsa ifiitiif akka kallachaa ti;","poem":1},{"text":"ta isa qaanessitu ammoo","poem":2},{"lineBreak":true},{"text":"akka dhukkuba lafee nyaatuu ti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yaadi worra balcha'aa yaada haqaa ti;","poem":1},{"text":"gorsi worra hama'aa ammoo nama soba.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Jechi nama hama'aa dhiiga dhangalaasiisa;","poem":1},{"text":"jechi nama balcha'aa ammoo","poem":2},{"lineBreak":true},{"text":"dhiiga dhangalaasiisa jalaa baasa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Namooti hamaaleyyiin hin badan;","poem":1},{"text":"deebi'aneelle hin dhaggamanu.","poem":2},{"lineBreak":true},{"text":"Maatiin worra balcha'aa ammoo","poem":2},{"lineBreak":true},{"text":"jabaattee dhaabbatti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nami akkuma qarummaa ifiititti leellifama;","poem":1},{"text":"nami qalbii micciirama'aa ammoo","poem":2},{"lineBreak":true},{"text":"hin tuffatama.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nama sagalee nyaatu adoo hin qabaatin,","poem":1},{"text":"nama guddaa ifi fakkeessuu mannaa,","poem":2},{"lineBreak":true},{"text":"nama ifi gad qabee","poem":2},{"lineBreak":true},{"text":"hojjataa te'ee le'u woyya.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nami balchaan horii ifiitiif hin marara;","poem":1},{"text":"nami hamaan","poem":2},{"lineBreak":true},{"text":"ammoo yennaa mara gadhaa jabaata.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nami jabaatee lafa qotu sagalee bacaa hin qabaata;","poem":1},{"text":"ka waan bu'aa hin qanne ari'u ammoo gowwa'a.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nami hamaan waan worri hamaan saame kajeela;","poem":1},{"text":"nami balchaan ammoo horee bacata.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nami hamaan jechuma hamaa ifiitiin qabama;","poem":1},{"text":"nami balchaan ammoo rakkinna jalaa hin baya.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nami waan afaan isaa keessaa bayuun","poem":1},{"text":"waan dansaa quufa;","poem":2},{"lineBreak":true},{"text":"akkuma hujii harka ifiititti gatii isaaf malte fudhata.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nama gowwaa karaan isaa qajeelaa itti fakkaata;","poem":1},{"text":"nami qaroon ammoo gorsa caqasa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Aariin nama gowwa'aa yoosuma beekkanti;","poem":1},{"text":"nami qalbeeffataan ammoo","poem":2},{"lineBreak":true},{"text":"arraba tuffatee lakkisa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dhugaa bayaan dhugaamessi,","poem":1},{"text":"dubbii dhuga'aa dhugaa baya;","poem":2},{"lineBreak":true},{"text":"dhugaa bayaan dharaamessi ammoo soba dubbata.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Dubbiin gar-maleen","poem":1},{"text":"akka shallaaga'aa nama woraanti;","poem":2},{"lineBreak":true},{"text":"arrabi nama qaro'oo ammoo nama fayyisa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Afaan dhuga'aa haga bara baraa jiraata;","poem":1},{"text":"arrabi sobaa ammoo yennaa diqqoo qofa jiraata.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Gadhaa worra waan hantuu maluu keessa","poem":1},{"text":"sobatti jira;","poem":2},{"lineBreak":true},{"text":"worri waan nageyaa namatti gorsu ammoo","poem":2},{"lineBreak":true},{"text":"hin gammada.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nama balchaa rakkinni itti hin dhufu;","poem":1},{"text":"nama hamaa ammoo rakkinni itti bacata.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mootiin Waan Maraa afaan dhara dubbatu jibba;","poem":1},{"text":"namoota dhugaammeyyi'itti ammoo hin gammada.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nami qalbeeffataan beekkumsa ifii dhoffata;","poem":1},{"text":"namooti gowwaan ammoo","poem":2},{"lineBreak":true},{"text":"gowwummaa ifii mudhifatan.","poem":2}]},{"type":"verse","number":24,"content":["Nami jabaatee hujatu bulchaa hin te'a;",{"text":"nami boosenni ammoo","poem":2},{"lineBreak":true},{"text":"garbicha namaa hin te'a.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mami gadhaa namaa keessa yoo jiraate","poem":1},{"text":"gad nama qaba;","poem":2},{"lineBreak":true},{"text":"jechi dansaan ammoo nama gammachiisa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nami balchaan karaa namaaf akeeka;","poem":1},{"text":"nami hamaan ammoo karaa irraa nama qaba.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nami boosenni foon adamo'oon fideeyyuu","poem":1},{"text":"hin bilcheeffatu;","poem":2},{"lineBreak":true},{"text":"nami jabaatee huju ammoo","poem":2},{"lineBreak":true},{"text":"waan gatii qabu hin dhaggata.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Karaa balchumma'aa irra jiru'utti jira;","poem":1},{"text":"daandii san irra duuti hin jirtu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/11.json","previousChapterAudioLinks":{},"numberOfVerses":28}