{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"Ilmi qaroon gorsa abbaa ifii hin fudhata;","poem":1},{"text":"ilmi murgaamessi ammoo xixicha hin dhage'u.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nami waan dansaa afaan isaa keessaa bayu irraa,","poem":1},{"text":"waan dansaa dhaggata;","poem":2},{"lineBreak":true},{"text":"worri hin addatanne ammoo","poem":2},{"lineBreak":true},{"text":"hunnaan nama irratti ka'iisaaf halchan.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nami afaan ifii eegatu,","poem":1},{"text":"jiruu ifii eegata;","poem":2},{"lineBreak":true},{"text":"ka ifi eegataa hin dubbanne ammoo hin bada.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nami boosenni hin halcha malee","poem":1},{"text":"womaa hin dhaggatu;","poem":2},{"lineBreak":true},{"text":"nami jabaatee huju ammoo waan halche hin dhaggata.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nami balchaan dhara jibba;","poem":1},{"text":"nami hamaan ammoo qaani'ii fi salphinna fida.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Balchummaan nama yakkaa hin qanne eeddi;","poem":1},{"text":"hammeenni ammoo cubbaalessa balleessa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nami womaa adoo hin qabaatin","poem":1},{"text":"dureessa ifi fakkeessu tokko jira;","poem":2},{"lineBreak":true},{"text":"ka dhibiin ammoo qabeenna guddaa adoo qabuu","poem":2},{"lineBreak":true},{"text":"hiyyeessa ifi fakkeessu tokko jirra.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nami dureessi karra ifiitiin","poem":1},{"text":"jiruu ifii wodatiisa dande'a fa'a te'a;","poem":2},{"lineBreak":true},{"text":"nami hiyyeessi ammoo","poem":2},{"lineBreak":true},{"text":"karra waan hin qanneef,","poem":2},{"lineBreak":true},{"text":"jiruu ifii wodatiisaaf itti hin rakkatu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ifi worra balcha'aa yennaa mara ifa;","poem":1},{"text":"issaan nama hama'aa ammoo hin dhaama.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ifi jajiis lola qofa kaasa;","poem":1},{"text":"qarummaan ammoo worra gorsa fudhatu bira jirti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Karri ariiti'iin dhaggatane ariifattee baddi;","poem":1},{"text":"ka diqqeessee diqqeessee","poem":2},{"lineBreak":true},{"text":"kuufate ammoo itti ede'ata.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Addiin yennaa turte gadhaa nama gaddisiitti;","poem":1},{"text":"halchaan muummotte ammoo","poem":2},{"lineBreak":true},{"text":"midhaan muka jiru'uu ti.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nami gorsa tuffatu badii ifi irratti fida;","poem":1},{"text":"nami ajaja ulfeessu","poem":2},{"lineBreak":true},{"text":"ammoo gatii irraa dhaggata.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Barsiisi nama qaro'oo madda jiru'uu ti;","poem":1},{"text":"tiyyoo du'aa irraa nama deebisa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Qalbeeffati dansaan ulfinna namaaf kenniti;","poem":1},{"text":"karaan worra hin addatannee ammoo bu'aa-bayi'i.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nami qalbeeffataan beekkumsaan hujata;","poem":1},{"text":"gowwaan ammoo gowwummaa ifii","poem":2},{"lineBreak":true},{"text":"badhinnatti mudhisa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ergamaan hamaan rakkoo keessa gala;","poem":1},{"text":"ergamaan addatamaan ammoo nageya buusa.","poem":2}]},{"type":"verse","number":18,"content":["Nama qajeelfama tuffatu",{"text":"hiyyumma'aa fi salphinnatti itti dhufa;","poem":2},{"lineBreak":true},{"text":"nami xixicha dhage'ee deebi'uu ammoo hin ulfaata.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Halchaan muummottu namatti mi'ootti;","poem":1},{"text":"gowwooleen ammoo","poem":2},{"lineBreak":true},{"text":"waan hantuu irraa deebi'iisa jibban.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nami qaroo woliin ideemu qaroo hin te'a;","poem":1},{"text":"waa'elli gowwa'aa ammoo hin farra.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Wonni hantuun cubbaaleyyii ariiti;","poem":1},{"text":"qananummaan ammoo gatii balcha'aa ti.","poem":2}]},{"type":"verse","number":22,"content":["Nami dansaan ijoollee ijoollee ifiitiif",{"text":"dhaala lakkisee dabara;","poem":2},{"lineBreak":true},{"text":"qabeenni cubbaalessaa ammoo","poem":2},{"lineBreak":true},{"text":"balcha'aaf kuufama.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Fichaan nama hiyyeessaa","poem":1},{"text":"midhaan bacaa kennuu dande'a;","poem":2},{"lineBreak":true},{"text":"haqa dhabiisi ammoo haxowee duraa balleessa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nami ilma ifii adabiisa mararfatu ilma ifii jibba;","poem":1},{"text":"ka jaalatu ammoo malaan adabee isa guddisa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nami balchaan haga quufutti nyaata;","poem":1},{"text":"nami hamaan yennaa mara beelota.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/12.json","previousChapterAudioLinks":{},"numberOfVerses":25}