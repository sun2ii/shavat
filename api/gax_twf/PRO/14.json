{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Dubartiin qaroon mana ifii ijaarratti;","poem":1},{"text":"dubartiin gowwaan ammoo","poem":2},{"lineBreak":true},{"text":"harkuma ifiitiin mana ifii diiddi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nami karaa qajeelaa ideemu","poem":1},{"text":"Mootii Waan Maraa sodaata;","poem":2},{"lineBreak":true},{"text":"ka karaan isaa micciirama'aa ammoo isa tuffata.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nama gowwaa dubbuma isaatitti adabbii isatti fida;","poem":1},{"text":"nama qaroo ammoo afaan isaatitti isa eega.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lafa qotiyyoon hin jirre gootaraan duwwaa hin te'a;","poem":1},{"text":"hunna qotiyyo'ootiin ammoo","poem":2},{"lineBreak":true},{"text":"midhaan hin bacata.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dhugaa bayaan dhugaammessi hin sobu;","poem":1},{"text":"dhugaa bayaan dharaamessi ammoo dhara dubbata.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nami murgaamessi qarummaa hin barbaada;","poem":1},{"text":"garuu hin dhaggatu;","poem":2},{"lineBreak":true},{"text":"worra qalbeeffataa ammoo","poem":2},{"lineBreak":true},{"text":"beekkumsa dhaggatiisi hin dhibu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Afaan isaa irraa","poem":1},{"text":"beekkumsa waan hin dhagganneef,","poem":2},{"lineBreak":true},{"text":"nama gowwaa irraa fagaadhu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Qarummaan nama qalbeeffata'aa","poem":1},{"text":"karaa irraa akka hin gorre tolchiti;","poem":2},{"lineBreak":true},{"text":"gowwummaan nama gowwa'aa","poem":2},{"lineBreak":true},{"text":"ammoo karaa irraa gorsiti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gowwooleen ciincaa sababa cubbu'uutiif dhikaatutti murgan;","poem":1},{"text":"odduu worra qajeela'aa ammoo","poem":2},{"lineBreak":true},{"text":"fedhii dansa'atti jira.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nami martinuu","poem":1},{"text":"gammadaa fi gadda hadhowaa ifii hin beeka;","poem":2},{"lineBreak":true},{"text":"ka isa woliin qoodamu hin jiru.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Manni worra hama'aa hin jiga;","poem":1},{"text":"qe'een worra qajeela'aa ammoo hin badhatti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Karaan sirrii namatti fakkaatu jira;","poem":1},{"text":"muummeen isaa ammoo gara du'aa geessa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kolla keessaayyuu gaddi jiraachuu dande'a;","poem":1},{"text":"gammadi gaddaan muummowuu dande'a.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nami hamaan gatii hammeenna ifii hin fudhata;","poem":1},{"text":"nami dansaalle gatii hujii dansaa ifii hin fudhata.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Gowwaan waan mara dhugeeffata;","poem":1},{"text":"qalbeeffataan ammoo ijjata ifii hin ilaallata.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nami qaroon waan hantuu sodaatee irraa hin deebi'a;","poem":1},{"text":"nami gowwaan ammoo ifi hin eegatu;","poem":2},{"lineBreak":true},{"text":"hin ariifatalle'e.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nami dafee aaru waan gadhee huja;","poem":1},{"text":"nami mala namatti dhowu hin jibbatama.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nami hin bilchaatin gowwummaa dhaala;","poem":1},{"text":"nami qalbeeffataan beekkumsa","poem":2},{"lineBreak":true},{"text":"akka kallachaa keyata.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Worri hamaan worra dansaa duratti,","poem":1},{"text":"worri cubbaaleyyiin","poem":2},{"lineBreak":true},{"text":"karra worra balcha'aa duratti gad hin jedhan.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hiyyeessi ollaa ifiitiinuu hin jibbatama;","poem":1},{"text":"dureessi ammoo jaalota hedduu qaba.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nami nama tuffatu cubbaalessa;","poem":1},{"text":"nami hiyyeessaaf nayu ka gammade.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Worri mala hamaa dhowu","poem":1},{"text":"karaa irraa goranii motii ree?","poem":2},{"lineBreak":true},{"text":"Worri mala dansaa dhowu ammoo hin jaalataman;","poem":2},{"lineBreak":true},{"text":"hin addatamanille'e.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Jabaatanee hujiis bu'aa qaba;","poem":1},{"text":"oduu callaa odeessiis ammoo","poem":2},{"lineBreak":true},{"text":"gara hiyyumma'aa qofa nama geessiti.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Qananummaan kallacha qaroole'ee ti;","poem":1},{"text":"gowwummaan ammoo seesa gowwoole'ee ti.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Dhugaa bayaan dhugaammessi jiruu fayyisa;","poem":1},{"text":"dhugaa bayaan dharaamessi ammoo hin soba.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nami Mootii Waan Maraa sodaatu","poem":1},{"text":"kushee jadduu qaba;","poem":2},{"lineBreak":true},{"text":"ijoollee isaatiifille addee itti baqattu hin teeti.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mootii Waan Maraa sodaatiis madda jiru'uu ti;","poem":1},{"text":"tiyyoo du'aa irraa nama deebisa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ulfinni mooti'ii bacinna kolba'aa ti;","poem":1},{"text":"kolbaan yoo hin jiraatin ammoo inni hin bada.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Nami ossatu hubantii guddoo qaba;","poem":1},{"text":"nami dafee aaru ammoo gowwummaa mudhisa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Yaadi nageyaa jiruu nafaaf kenna;","poem":1},{"text":"hinaaffaan ammoo lafee tortorsa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Nami hiyyeessa cunqursu","poem":1},{"text":"ka isa dade tuffata;","poem":2},{"lineBreak":true},{"text":"ka hiyyeeyyi'iif nayu ammoo","poem":2},{"lineBreak":true},{"text":"Waaqaaf ulfinna kenna.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Nami hamaan hammeenna ifiitiin bada;","poem":1},{"text":"nami balchaan du'a keessalle'etti","poem":2},{"lineBreak":true},{"text":"addee itti baqatu qaba.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Qarummaan gadhaa worra woy hubatuu keessa leeti;","poem":1},{"text":"isiin gadhaa gowwootaa keessatti ammoo hin beekkantu.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Balchummaan kolbaa ol qaddi;","poem":1},{"text":"cubbuun ammoo kolbuma mara salphitti.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Mootiin tajaajilaa qaro'otti hin gammada;","poem":1},{"text":"ka isa fokkisiisutti ammoo hin mufata.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/13.json","previousChapterAudioLinks":{},"numberOfVerses":35}