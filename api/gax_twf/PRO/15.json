{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"Deebiin dansaan aarii qabbaneessiti;","poem":1},{"text":"jechi jabaan aarii kakkaasa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Arrabi qaro'oo beekkumsa saada;","poem":1},{"text":"afaan gowwa'aa ammoo gowwummaa dubbata.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ilti Mootii Waan Maraa addee mara jirti;","poem":1},{"text":"waan hantu'uu fi dansaalle hin dhaggiti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Arrabi dansaan muka jiru'uu ti;","poem":1},{"text":"arrabi dabaan ammoo yaada namaa cassa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gowwaan gorsa abbaa ifii tuffata;","poem":1},{"text":"nami xixicha dhage'u ammoo qarummaa mudhisa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mana nama balcha'aa keessa qabeenna gudda'atti jira;","poem":1},{"text":"bu'aan nami hamaan dhaggatu ammoo","poem":2},{"lineBreak":true},{"text":"rakkoo itti fiddi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Afaan qaro'oo beekkumsa facaasa;","poem":1},{"text":"qalbiin gowwa'aa ammoo akkasii moti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mootiin Waan Maraa ciincaa worra hama'aa hin jibba;","poem":1},{"text":"daadimati worra qajeela'aa ammoo","poem":2},{"lineBreak":true},{"text":"isa gammachiisa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mootiin Waan Maraa karaa worra hama'aa hin jibba;","poem":1},{"text":"worra balchummaa gula deemu ammoo hin jaalata.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nama daandii irraa goru adabbii jaddu'utti eegata;","poem":1},{"text":"ka xixicha jibbulle hin du'a.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Addeen worri du'e jiruu fi addeen badi'ii","poem":1},{"text":"Mootii Waan Maraa duratti eega beekkantee,","poem":2},{"lineBreak":true},{"text":"gadhaan namaa attam attam","poem":2},{"lineBreak":true},{"text":"irra caalaa hin beekkanne ree?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nami murgaamessi xixamuu hin jaalatu;","poem":1},{"text":"inni nama qaroolle gorsa hin gaafatu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nami gadhaan isaa gammade fuula ifa;","poem":1},{"text":"nami gadhaan isaa gadde ammoo yaada caba.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Qalbiin nama hubantii qabuu beekkumsa barbaaddi;","poem":1},{"text":"afaan nama gowwa'aa ammoo","poem":2},{"lineBreak":true},{"text":"gowwummaa raama.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hiyyeessaaf guyyaan marti hama'a;","poem":1},{"text":"gadhaa gammada qabuuf ammoo","poem":2},{"lineBreak":true},{"text":"guyyaan marti jila.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Qabeenna guddaa hogaa qabuu mannaa,","poem":1},{"text":"qabeenna diqqaa qabaatanee","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa sodaataa le'iisa woyya.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Addee jibbi jirutti cooma sanga'aa nyaatiisaa mannaa,","poem":1},{"text":"addee jaalalli jirutti","poem":2},{"lineBreak":true},{"text":"shaanaa nyaatiisa woyya.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nami dafee aaru lola kaasa;","poem":1},{"text":"nami ossatu ammoo","poem":2},{"lineBreak":true},{"text":"lola qabbaneessa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Karaan nama booseyaa qore'een cufameera;","poem":1},{"text":"karaan nama qajeela'aa ammoo","poem":2},{"lineBreak":true},{"text":"gufuu hin qabu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ilmi qaroon abbaa ifii gammachiisa;","poem":1},{"text":"nami gowwaan ammoo haadha ifii tuffata.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nama gowwaa gowwumma'atti gammachiisa;","poem":1},{"text":"nami qaroon ammoo karaa qajeelaa deema.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Gorsi yoo hin jiraatin karoorri hin milkowu;","poem":1},{"text":"gorsitooti yoo heddatte ammoo","poem":2},{"lineBreak":true},{"text":"karoorri hin milkowa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nami deebii malte namaaf deebisiisaan gammada;","poem":1},{"text":"dubbiin yennaa isi'ii maltetti","poem":2},{"lineBreak":true},{"text":"dubbatantu attam attam dansa'a!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Karaan nama qaro'oo addee","poem":1},{"text":"worri du'e jirutti akka inni gad hin buuneef,","poem":2},{"lineBreak":true},{"text":"gara jiru'uutitti ol isa geessa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mootiin Waan Maraa mana worra kooruu hin diiga;","poem":1},{"text":"meessaa haadha hiyyeessaa ammoo hin eega.","poem":2}]},{"type":"verse","number":26,"content":["Mootiin Waan Maraa yaada worra hama'aa hin jibba;",{"text":"yaadi worra qulqullu'uu ammoo","poem":2},{"lineBreak":true},{"text":"isa gammachiisan.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nami joljolaan maatii ifii irratti rakkoo fida;","poem":1},{"text":"nami safuu jibbu ammoo hin le'a.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Gadhaan nama balcha'aa","poem":1},{"text":"deebii kenniisaan dura itti yaada;","poem":2},{"lineBreak":true},{"text":"afaan nama hama'aa ammoo dubbii hantuu dubbata.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Mootiin Waan Maraa nama hamaa irraa fagoo jira;","poem":1},{"text":"daadimata balcha'aa ammoo hin dhage'a.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Fuulli ifaan gadhaa namaa gammachiisa;","poem":1},{"text":"oduun gammadaa lafee jabeessiti.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Nami xixicha jiruu kennu caqasu,","poem":1},{"text":"qaroolee odduu hin le'a.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Nami gorsa tuffatu,","poem":1},{"text":"ifi tuffata;","poem":2},{"lineBreak":true},{"text":"nami xixicha dhage'u ammoo","poem":2},{"lineBreak":true},{"text":"hubantii dhaggata.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Mootii Waan Maraa sodaatiis qarummaa nama barsiisa;","poem":1},{"text":"ulfinna dhaggatiisaan dura gad ifi qabiisatti jira.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/14.json","previousChapterAudioLinks":{},"numberOfVerses":33}