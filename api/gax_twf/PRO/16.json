{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"Nami gadhaa ifiititti hin yaadata;","poem":1},{"text":"yaada san guutuu ka dande'u ammoo","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa qofa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nami akka ifiif ilaalutti","poem":1},{"text":"karaan isaa marti qulqulluu isatti fakkaata;","poem":2},{"lineBreak":true},{"text":"yaada gadhaa isaa ammoo","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa hin madaala.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Waan gootu mara","poem":1},{"text":"Mootii Waan Maraatitti magannee kennadhu;","poem":2},{"lineBreak":true},{"text":"wonni ati yaaddu marti si'iif hin milkootti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mootiin Waan Maraa waan mara sababa dadeef qaba;","poem":1},{"text":"worra hamaaleyyi'iifille inni guyyaa badi'ii qopheesseera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mootiin Waan Maraa worra kooru hin jibba;","poem":1},{"text":"isaan ijjumaa adabbii jalaa hin bayanu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Jaalalaa fi addatamumma'aan","poem":1},{"text":"nama yakkeef araarri godhama;","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa sodaatiisaan","poem":2},{"lineBreak":true},{"text":"nami waan hantuu irraa fagaata.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Karaan namaa Mootii Waan Maraa yennaa gammachiise,","poem":1},{"text":"diinoti isaatuu isa woliin nageyaan le'an.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Qabeenna bacaa","poem":1},{"text":"karaa haqa hin te'iniin dhaggatanuu mannaa,","poem":2},{"lineBreak":true},{"text":"qabeenna diqqaa karaa balchumma'aatiin dhaggatanu woyya.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nami gadhaa ifii keessatti karoora hin baafata;","poem":1},{"text":"Mootiin Waan Maraa ammoo karoora isaa san hin murteessa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mootiin akka Mootii Waan Maraa dubbata;","poem":1},{"text":"afaan isaa haqa hin dassu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Madaallii fi safarri sirrii te'e ka Mootii Waan Maraa ti;","poem":1},{"text":"dhakaan madaalli'ii martinuu hujuma isaa ti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Barcumaan mootumma'aa","poem":1},{"text":"balchumma'aan waan jabaatuuf,","poem":2},{"lineBreak":true},{"text":"moototi hujii hantuu jibbuu qaban.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Moototi dubbii dhuga'aatitti gammadan;","poem":1},{"text":"nama dhugaa dubbatu jaalatan.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mufiin mooti'ii akka ergamaa du'aa ti;","poem":1},{"text":"nami qaroon ammoo mufii hin qabbaneessa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Fuulli mooti'ii yennaa ifu jiruun jirti;","poem":1},{"text":"isa biratti fudhatama dhaggatiis","poem":2},{"lineBreak":true},{"text":"akka rooba furmaataa ti.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Worqii dhaggatiisa irra qarummaa dhaggatiis,","poem":1},{"text":"meetii caalaa hubantii filatiis","poem":2},{"lineBreak":true},{"text":"attam attam caalti!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kolbaan dansaan waan hantuu irraa fagaatti;","poem":1},{"text":"nami karaa ifii eeggatu jiruu ifii eeggata.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ifi jajuun badiisatti,","poem":1},{"text":"koorri jigiisatti nama geessa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Worra kooru woliin boojuu qoodamiisaa mannaa,","poem":1},{"text":"worra hiyyeeyyii woliin gad ifi qabiisa woyya.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nami gorsa dhage'u,","poem":1},{"text":"qananummaa dhaggata;","poem":2},{"lineBreak":true},{"text":"nami Mootii Waan Maraa","poem":2},{"lineBreak":true},{"text":"addatulle hin gammada.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Worri qaroon «Qalbeeffattoota» jedhaman;","poem":1},{"text":"dubbiin mi'oottuun beekkumsa namaaf dabalti.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Qarummaan worra isii qabuuf madda jiru'uu ti;","poem":1},{"text":"gowwummaan ammoo worra gowwa'atti adabbii fiddi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nami qaroon itti yaadatee dubbata;","poem":1},{"text":"dubbiin afaan isaa nama barsiitti.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Dubbiin dansaan akka nadhii dammaa ti;","poem":1},{"text":"namatti mi'ootti;","poem":2},{"lineBreak":true},{"text":"lafee namaatiifille fayyinna kenniti.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Karaan namatti qajeelaa fakkaatu jira;","poem":1},{"text":"dhuma irratti ammoo gara du'aa geessa.","poem":2}]},{"type":"verse","number":26,"content":["Fedhiin sagale'ee akka nami jabaatee huju gooti;",{"text":"beeltille huji'itti isa kakkaachi.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nami badaan waan hantuu mala dhowa;","poem":1},{"text":"dubbiin isaalle akka ibiddaa nama guddi.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Nami micciiramaan lola kaasa;","poem":1},{"text":"nami nama hamatu jaalota gargar baasa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Nami hunnaan nama irratti ka'u","poem":1},{"text":"ollaa ifii karaa irraa milissa;","poem":2},{"lineBreak":true},{"text":"daandii dansaa hin teennelle'etti geessa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Nami ilaan qiphifatu hammeenna mala dhowa;","poem":1},{"text":"ka hidhii ciniinnatulle hammeenna yaadata.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Arriin kallacha ulfinnaa ti;","poem":1},{"text":"isiin jiruu balchumma'aatiin dhagganti.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Nama hunnaamessaa mannaa,","poem":1},{"text":"nama ossataa woyya;","poem":2},{"lineBreak":true},{"text":"nama hunnaan qachaa tokko qabatuu mannaa,","poem":2},{"lineBreak":true},{"text":"nama ifi qabatu woyya.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Murtee godhatiisaaf kolbaan hixaa buufatti;","poem":1},{"text":"waan mara ka murteessu ammoo Mootii Waan Maraa ti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/15.json","previousChapterAudioLinks":{},"numberOfVerses":33}