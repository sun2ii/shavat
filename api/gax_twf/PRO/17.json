{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"Mana waan nyaatanuun guutamee,","poem":1},{"text":"wol dhaba qabuu mannaa,","poem":2},{"lineBreak":true},{"text":"daabboo godduu nageyaa woyya.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tajaajilaan qaroon ilma salphicha irratti bulchaa hin te'a;","poem":1},{"text":"inni obboleeyyan dhaala qoodantu woliin","poem":2},{"lineBreak":true},{"text":"akka obboleessaa dhaala hin qoodama.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ibiddi worqi'ii fi meetii haga ilaala;","poem":1},{"text":"Mootiin Waan Maraa ammoo","poem":2},{"lineBreak":true},{"text":"gadhaa namaa haga ilaala.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nami hamaan waan hantuu caqasa;","poem":1},{"text":"nami dharaamessi dubbii dharaamessaa","poem":2},{"lineBreak":true},{"text":"miidhassee caqasa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nami worra hiyyeeyyi'itti murgu,","poem":1},{"text":"ka isaan dade arrassa;","poem":2},{"lineBreak":true},{"text":"nami badii namaatitti gammadu,","poem":2},{"lineBreak":true},{"text":"adoo hin adabamin hin hafu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ilmaan ilmaan isaanii","poem":1},{"text":"maanguddootaaf kallacha isaanii ti;","poem":2},{"lineBreak":true},{"text":"worri ijoollee ifiitiif ulfinna isaanii ti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dubbiin dansaan nama gowwa'aaf hin teetu;","poem":1},{"text":"dubbiin dharaa irra caala'aayyuu","poem":2},{"lineBreak":true},{"text":"bulcha'aaf hin teetu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Safuun nama isii kennuuf akka xano'oo ti;","poem":1},{"text":"addee dhaqanu maratti waan isaaf milkoottu itti fakkaatti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nami yakkaa namaaf araaramu,","poem":1},{"text":"jaala qabaata.","poem":2},{"text":"Nami dubbii dabartetti deddeebi'u ammoo","poem":1},{"text":"jaalota gargar baasa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gowwaan yennaa dhibba dhaanamee","poem":1},{"text":"ka itti dhage'amu caalaa,","poem":2},{"lineBreak":true},{"text":"xixichi tokko nama qaroo itti dhage'ama.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nami hamaan nama irratti ka'iisa qofa barbaada;","poem":1},{"text":"isa loliisaaf","poem":2},{"lineBreak":true},{"text":"ergamaan marartii hin qanne tokko hin ergama.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nama gowwaa gowwummaa ifii keessa jirutti","poem":1},{"text":"dhaqiisa mannaa,","poem":2},{"lineBreak":true},{"text":"doobbaa","poem":2},{"noteId":0},{"text":"dhalaa","poem":2},{"lineBreak":true},{"text":"ilmeen jalaa fudhatantetti dhaquu woyya.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nami waan dansaa isaaf godhaneef,","poem":1},{"text":"waan hantuu yoo deebise,","poem":2},{"lineBreak":true},{"text":"wonni hantuun mana isaa irraa hin fagaattu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Lola jalqabiis akka bisaan hidha qabame cassee yaa'uu ti;","poem":1},{"text":"tanaaf ati adoo dubbiin hin jalqabin qabbaneessi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nama yakkaamessa bilisa baasiisaa fi","poem":1},{"text":"nama balcha'atti muriisa,","poem":2},{"lineBreak":true},{"text":"lamaanuu Mootiin Waan Maraa hin jibba.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Gowwaan qarummaa","poem":1},{"text":"dhaggatiisaaf eega hin halchinee,","poem":2},{"lineBreak":true},{"text":"beeseen inni harka ifiitii qabu","poem":2},{"lineBreak":true},{"text":"maan isaaf gooti ree?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Jaalli yennaa mara si jaalata;","poem":1},{"text":"obboleessille yennaa rakko'ootiif dhalata.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nami qalbii hin qanne tokko wolii galtee jabeessiisaaf,","poem":1},{"text":"namaan harka wol dhowata;","poem":2},{"lineBreak":true},{"text":"ollaa ifiitiifille wobii dabara.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nami lola jaalatu cubbuu jaalata;","poem":1},{"text":"nami ifi jaju badii ifitti waama.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nama yaada micciiramaa qabuuf hin milkoottu;","poem":1},{"text":"nami nama sobulle rakkoo keessa seena.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ilma gowwaa uumatuun gadda namatti fida;","poem":1},{"text":"abbaan ilma gowwa'aa gammada hin qabu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Gadhaan gammadu akka qorsa dansa'aa ti;","poem":1},{"text":"yaadi cabaan ammoo lafee goggossa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nami hamaan haqa dassiisaaf,","poem":1},{"text":"dhossa'aan safuu fudhata.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ilti nama qaro'oo gara qarumma'aa ilaalti;","poem":1},{"text":"ilti nama gowwa'aa ammoo gara mara joonjiti.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ilmi gowwaan gadda abbaa ifiititti fida;","poem":1},{"text":"haadha isa deettelle jiruu itti hadheessa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nama yakkaa hin qanne adabuun,","poem":1},{"text":"yookiin qondaaltota qajeelummaa isaaniitiif dhaanuun","poem":2},{"lineBreak":true},{"text":"dansa'aa moti.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nami beekaan dubbii qusata;","poem":1},{"text":"nami hubataalle hin sarma.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Gowwaanuu yoo cadhise qaroo fakkaata;","poem":1},{"text":"afaan ifiille yoo qabate","poem":2},{"lineBreak":true},{"text":"akka hubata'aatitti ilaallama.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Doobbaa: Bineensa iyyaa fakkaatu.","reference":{"chapter":17,"verse":12}}]},"thisChapterLink":"/api/gax_twf/PRO/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/16.json","previousChapterAudioLinks":{},"numberOfVerses":28}