{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":[{"text":"Nami nama woliin wolii hin galle,","poem":1},{"text":"fedhii ifii qofa gula deemuu barbaada;","poem":2},{"lineBreak":true},{"text":"muraa haqaa maraayyuu hin morma.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nami gowwaan yaada ifii qofaa","poem":1},{"text":"namatti mudhisuu barbaada malee,","poem":2},{"lineBreak":true},{"text":"hubanti'itti hin gammadu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hammeenni yennaa dhufu,","poem":1},{"text":"tuffatamiisille hin dhufa;","poem":2},{"lineBreak":true},{"text":"salphinnalle woliin qaani'itti dhufa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dubbiin afaan namaa akka bisaan qile'ee ti;","poem":1},{"text":"maddi qarumma'aa ammoo akka bisaan yaa'uu ti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nama hama'aaf goluun,","poem":1},{"text":"yookiin nama yakkaa hin qanne","poem":2},{"lineBreak":true},{"text":"haqa dhoogguun dansa'aa moti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Haasonni nama gowwa'aa lola isatti kaasa;","poem":1},{"text":"afaan isaalle dhaanamiisa isatti fida.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gowwaa dubbii isaatittuu isa balleessa;","poem":1},{"text":"afaanuma isaatittuu akka tiyyo'oo isa qaba.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dubbiin nama nama hamatuu","poem":1},{"text":"akka sagalee mi'oottu'uu ti;","poem":2},{"lineBreak":true},{"text":"isiin gara qochumaanii gad hin buuti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nami huji'itti booseyu","poem":1},{"text":"obboleessa nama wo balleessuu ti.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"akka xelleephoo jaddu'uu ti;","poem":2},{"lineBreak":true},{"text":"worri balchooleen","poem":2},{"lineBreak":true},{"text":"itti baqatanee bayan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Qabeenni dureeyyi'ii isaaniif","poem":1},{"text":"akka qachaa dalleya dhaka'aa jabaa qabuu ti;","poem":2},{"lineBreak":true},{"text":"isaan akka dalleya dheera'aatitti","poem":2},{"lineBreak":true},{"text":"isa hedatan.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Badiisa ifiitiin dura nami hin koora;","poem":1},{"text":"ulfinnaan dura ammoo","poem":2},{"lineBreak":true},{"text":"gad ifi qabiisatti dhufa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dubbii adoo hin caqasin deebii kennuun,","poem":1},{"text":"gowwumma'a;","poem":2},{"lineBreak":true},{"text":"fokko'olle'e.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yaadi namaa dhibee hin ossata;","poem":1},{"text":"yaadi yoo cabe ammoo","poem":2},{"lineBreak":true},{"text":"eentu isa fayyisuu dande'a ree?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Qalbiin nama hubata'aa beekkumsa dhaggatti;","poem":1},{"text":"gurri nama qaro'oolle beekkumsa barbaada.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kennansi nama isa kennuuf karaa bana;","poem":1},{"text":"fuula worra gugurda'aa dura isa dhikeessa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nami isa mormu dhufee haga isa mormutti,","poem":1},{"text":"nami dura dhufee dubbii ifii yaa'i'itti dhikeeffatu,","poem":2},{"lineBreak":true},{"text":"waan sirrii te'e fakkaata.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hixaa buufatiis moromaa qabbaneessa;","poem":1},{"text":"wol mormitoota jajjadduu lamaan gargar baasa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Obboleessi yakkaan irratti hujame","poem":1},{"text":"qachaa dalleya dhaka'aa qabu caalaa jabaata.","poem":2},{"lineBreak":true},{"text":"Moromaan akka danqaraa sibiilaa","poem":2},{"lineBreak":true},{"text":"ka karra dalleya dhaka'aa ittiin cufanuu ti.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nami bu'aa waan afaan isaa keessaa bayuun quufa;","poem":1},{"text":"dubbii arrabi isaa dubbattelle'een dharraa baya.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Arrabi hunna du'aa fi jiru'uu qaba;","poem":1},{"text":"worri isa jaalatu bu'aa isaa hin nyaata.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nami haadha manaa dhaggatu waan dansaa dhaggata;","poem":1},{"text":"Mootii Waan Maraa biralle'ee fudhatama dhaggata.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hiyyeessi marartii dhaggatiisaaf gaafata;","poem":1},{"text":"dureessi ammoo jabeennaan deebii kenna.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Jaaloti gariin nama balleessiti;","poem":1},{"text":"jaaloti obboleessa caalaa","poem":2},{"lineBreak":true},{"text":"namatti dhikaatanulle ammoo hin jiran.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}