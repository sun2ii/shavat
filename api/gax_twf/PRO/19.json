{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"Gowwaa dubbii micciiruu mannaa,","poem":1},{"text":"hiyyeessa komii male le'u woyya.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Beekkumsa adoo hin qabaatin,","poem":1},{"text":"halchaan callaan dansa'aa moti;","poem":2},{"lineBreak":true},{"text":"nami akka malee ariifatu karaa irraa gora.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nami gowwummaa ifiitiin jiruu ifii balleessa;","poem":1},{"text":"gadhaa ifii keessatti ammoo","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa komata.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Durummaan jaala hedduu namaa fiddi;","poem":1},{"text":"hiyyeessi ammoo jaala ifiituu dhaba.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nami dharaan dhugaa bayu,","poem":1},{"text":"adoo hin adabamin hin hafu;","poem":2},{"lineBreak":true},{"text":"ka dhara dubbatulle adabbii jalaa hin bayu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Namooti hedduun qondaaltota duratti","poem":1},{"text":"fudhatama dhaggatiisa barbaadan;","poem":2},{"lineBreak":true},{"text":"nama wo namaa kennuufille martinuu jaala.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nama hiyyeessa firri isaatuu eega jibbee,","poem":1},{"text":"jaaloti isaa ammoo attam attam","poem":2},{"lineBreak":true},{"text":"caalchisanee isa irraa fagaatanu ree!","poem":2},{"lineBreak":true},{"text":"Inni kadhataa isaan gula deema,","poem":2},{"lineBreak":true},{"text":"isaan ammoo irraa fagaatan.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nami qarummaa qabu lubbuu ifii jaalata;","poem":1},{"text":"nami hubantii jaalatu hin qananooma.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nami dharaan dhugaa bayu,","poem":1},{"text":"adoo hin adabamin hin hafu;","poem":2},{"lineBreak":true},{"text":"ka dhara dubbatulle hin bada.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Qananummaan gowwa'aaf hin teetu;","poem":1},{"text":"qondaaltota bulchiisi garbichaaf","poem":2},{"lineBreak":true},{"text":"caala'aayyuu attam attam baddu'u!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Qarummaan ossata namaaf kenniti;","poem":1},{"text":"arraba tuffatanee irra dabariis ulfinna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Aariin mooti'ii akka dhangaa dhowiisa neenqaa ti;","poem":1},{"text":"fudhatama isa irraa dhaggatiis ammoo","poem":2},{"lineBreak":true},{"text":"akka fixeensa marra irraa ti.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ilmi gowwaan abbaa ifiititti badii fida;","poem":1},{"text":"haati manaa dubbattittiin akka bokkeya qacacuu ti.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Manaa fi durummaa worra irraa dhaalan;","poem":1},{"text":"haati manaa qalbittiin ammoo","poem":2},{"lineBreak":true},{"text":"kennansa Mootii Waan Maraa ti.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Booseyummaan hirriiba hamaa namatti fida;","poem":1},{"text":"nami hujii malee tee'u beelaan rakkata.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nami ajaja eegatu jiruu ifii eegata;","poem":1},{"text":"nami karaa Waaqaa tuffatu ammoo hin du'a.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nami hiyyeessaaf gadhaa laafu","poem":1},{"text":"akka waan Mootii Waan Maraatiif liqeessee ti;","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa gatii isaaf hin kaffala.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Deebisiisaaf adoo addiin jirtuu,","poem":1},{"text":"ijoollee teeti adabi;","poem":2},{"lineBreak":true},{"text":"gad lakkittee akka isaan du'anu hin godhin.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nami akka malee aaru tokko","poem":1},{"text":"gatii aarii sanii fudhatuu qaba;","poem":2},{"lineBreak":true},{"text":"ati yennaa tokko rakkoo keessaa yoo isa baatte,","poem":2},{"lineBreak":true},{"text":"itti deebi'iis keeti ammalle hin hafu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Gara duraa qaroo akka teetuuf,","poem":1},{"text":"gorsa caqasi;","poem":2},{"lineBreak":true},{"text":"qajeelfama fudhadhu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Gadhaa namaa keessa Yaada heddu'utti jira;","poem":1},{"text":"ka te'u ammoo yaada Mootii Waan Maraa qofa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Wonni nami barbaadu jaalala bara baraa ti;","poem":1},{"text":"dharaamessa te'iisaa mannaa,","poem":2},{"lineBreak":true},{"text":"hiyyeessa te'uu woyya.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mootii Waan Maraa sodaatiis","poem":1},{"text":"gara jiru'uu nama geessa;","poem":2},{"lineBreak":true},{"text":"nami Mootii Waan Maraa sodaatu gabbi jedhee le'a;","poem":2},{"lineBreak":true},{"text":"wonni hantuulle isa hin tuxxu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nami booseyi harka ifii qorii keessa hin keya;","poem":1},{"text":"gara afaan ifiituu hin deebifatu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nama murgu dhaani;","poem":1},{"text":"nami gowwaalle qarummaa hin barata;","poem":2},{"lineBreak":true},{"text":"nama hubataa xixi innille beekkumsa hin dhaggata.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ka abbaa ifii saamu,","poem":1},{"text":"haadha ifiille ka manaa ari'u,","poem":2},{"lineBreak":true},{"text":"ilma fokko'oo fi salphinna fidu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ilma kiyya,","poem":1},{"text":"ati yoo gorsa kiyya dhage'iisa lakkitte,","poem":2},{"lineBreak":true},{"text":"waan beettuuyyuu irraa badda.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Dhugaa bayaan dharaa haqa irratti murga;","poem":1},{"text":"afaan nama hama'aa waan hantuu gad liqinsa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Worra murguuf muraan,","poem":1},{"text":"worra gowwa'aaf dhaanichi qophoweera.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}