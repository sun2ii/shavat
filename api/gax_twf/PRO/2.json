{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":2,"content":[{"type":"heading","content":["Eebba Qarummaa Irraa Dhaggamu"]},{"type":"verse","number":1,"content":[{"text":"Ilma kiyya, jecha kiyya yoo fudhatte,","poem":1},{"text":"ajaja kiyyalle qalbii teeti keessatti yoo bulfatte,","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"gurra keeti gara qarumma'aa yoo qabatte,","poem":2},{"lineBreak":true},{"text":"gadhaa keetille gara hubanti'ii yoo deebifatte,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"beekkumsa guddaa yoo waammatte,","poem":2},{"lineBreak":true},{"text":"hubanti'iif qoonqoo ol qabattee yoo iyyite,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"akka meeti'ii yookiin akka qabeenna dhoffameeruu,","poem":2},{"lineBreak":true},{"text":"qarummaa yoo barbaadde,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ati Mootii Waan Maraa sodaatiisa hin hubatta;","poem":2},{"lineBreak":true},{"text":"beekkumsa Waaqa beekiisalle hin dhaggatta.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mootiin Waan Maraa, qarummaa waan namaa kennuuf,","poem":1},{"text":"beekkumsii fi hubantiin isa biraa dhufan.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni worra qajeela'aaf, qarummaa kenna;","poem":1},{"text":"worra komii hin qanneefille, wontee isaaniif te'a.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inni daandii haqaa hin toowata;","poem":1},{"text":"karaa worra isaaf addatamuulle hin eega.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Achiin duuba ati balchumma'aa fi haqa,","poem":1},{"text":"waan dhugaa te'ee fi daandii dansaa mara hin hubatta.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Qarummaan gara qalbii teetii waan dhuttuuf,","poem":1},{"text":"beekkumsi si gammachiisa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Qalbeeffatiis si hin eeddi; hubatiisille si hin toowatti.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Qarummaan karaa worra hama'aa irraa,","poem":1},{"text":"worra dubbii micciiru irraa si hin dhooggiti;","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"worri akkasii kun karaa dukkanaa ideemiisaaf,","poem":2},{"lineBreak":true},{"text":"daandii qajeelaa worra lakkisu;","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"waan hantuu godhiisatti worra gammadu;","poem":2},{"lineBreak":true},{"text":"micciiramummaa hamaaleyyi'iititti","poem":2},{"lineBreak":true},{"text":"worra firinxiixu;","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"karaan isaanii micciirama'a;","poem":2},{"lineBreak":true},{"text":"ideensi isaaniille daddaba'a.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Qarummaan dubartii gaarayyeeffattuu,","poem":1},{"text":"ta jechoota gammachiisuun nama qaxafattu","poem":2},{"lineBreak":true},{"text":"jalaa si baachi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dubartiin tun dhirsa dargagumma'aan","poem":1},{"text":"heerumte lakkittee,","poem":2},{"lineBreak":true},{"text":"waadaa Waaqa duratti galte deeteerti.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Manni isi'ii gara du'aa,","poem":1},{"text":"daandiin isi'ii gara ekera'aa geessa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Worri gara isi'ii dhaqu hin deebi'u","poem":1},{"text":"yookiin daandii jiru'uu hin dhaggatu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Maarre ati karaa namoota dansa'aa","poem":1},{"text":"hin ideenta; daandii balchootaa irraa","poem":2},{"lineBreak":true},{"text":"akka hin gorre hin eegatta.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Worri qajeelaan lafa irra hin le'an;","poem":1},{"text":"worri yakkaa hin qannelle","poem":2},{"lineBreak":true},{"text":"isii keessatti hin hafan.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Worri hamaan ammoo lafa irraa hin bada;","poem":1},{"text":"worri hin addatanne isii irraa hin buqqa'a.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}