{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"Daadhiin woyni'ii murgaamessa,","poem":1},{"text":"untoon jadduun xeenxiraa nama gooti;","poem":2},{"lineBreak":true},{"text":"nami isaan kanaan dokonkore qaro'oo moti.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Aariin mooti'ii akka neenqa dhangaa dhowuu ti;","poem":1},{"text":"nami isa aarsulle jiruu ifii dhaba.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wol dhaba irraa fagaatiis ulfinna namaaf kenna;","poem":1},{"text":"gowwaan yennaa mara lola kaasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nami booseyi yenna'aan hin qotatu;","poem":1},{"text":"yennaa midhaan galfatanu inni midhaan barbaada,","poem":2},{"lineBreak":true},{"text":"ammoo womaa hin dhaggatu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yaadi gadhaa namaa akka bisaan qilee keessaa ti;","poem":1},{"text":"nami qalbii qabu ammoo","poem":2},{"lineBreak":true},{"text":"achi keessaa hin woraabbata.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nami hedduun, «Nuuti worra addatama'a» ifiin jedhan;","poem":1},{"text":"nama addatamaa ammoo eentu dhaggatuu dande'a?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nami balchaan komii malee le'a;","poem":1},{"text":"ijoolleen isa gula ideentulle ta hiree dansaa qaddu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mootiin barcumaa mura'aa irra tee'eeru,","poem":1},{"text":"iluma ifiitiin waan hantuu ilaalee beeka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Eennutti, «Ani gadhaa kiyya qulqulleeffadheera;","poem":1},{"text":"ani cubbuu hin qabu» jedhuu dande'a ree?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mootiin Waan Maraa madaala sirrii hin te'inii fi","poem":1},{"text":"safara sirrii hin te'in jibba.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ijoolleenuu qulqulloota akka te'ane,","poem":1},{"text":"sirrii te'uu isaaniille,","poem":2},{"lineBreak":true},{"text":"hujii ifiitiin hin beekkaman.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Gurra dhage'uu fi ila dhaggitu,","poem":1},{"text":"lachuu ka dade Mootii Waan Maraa ti.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Akka hin hiyyoommane,","poem":1},{"text":"hirriiba hin jaalatin.","poem":2},{"lineBreak":true},{"text":"Midhaan akka quuttu,","poem":2},{"lineBreak":true},{"text":"dammaqii hujadhu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nami woy bitatu,","poem":1},{"text":"«Wonni kun baddu'u, wonni kun baddu'u» jedha;","poem":2},{"lineBreak":true},{"text":"bitateen duuba, «Dansaa bitadhe» jedhee ifi jaja.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Worqi'ii fi dooqi baca'atti jira;","poem":1},{"text":"afaan dubbii beekkumsaa dubbatu ammoo,","poem":2},{"lineBreak":true},{"text":"akka dhakaa gatii guddo'oo ti.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nama alaga'aaf wobii te'e woyaa irraa mulqadhu;","poem":1},{"text":"marroo nama alagaa sanii woyaa isaa qabadhu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sagaleen hannaan dhaggante namatti hin mi'ootti;","poem":1},{"text":"duubarra ammoo akka maansa afaan nama guutee teeti.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Gorsa fudhadhuu karoora baafadhu;","poem":1},{"text":"qajeelfama fudhadhuu duuli.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nami hamatu dhossaa mudhisa;","poem":1},{"text":"tanaaf nama dubbii baceessu irraa fagaadhu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nami abba'aa fi haadha ifii abaaru,","poem":1},{"text":"akka issaa dukkana duudduu keessatti dhaamee hin te'a.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Qabeenni jalqaba irratti","poem":1},{"text":"dafee dhaalaan dhufu,","poem":2},{"lineBreak":true},{"text":"dhuma irratti eebba hin qabu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nami si irratti waan hantuu yoo huje,","poem":1},{"text":"«Anille deebisee waan hantuu irratti huja» hin jedhin;","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa si baasaa,","poem":2},{"lineBreak":true},{"text":"isa eegadhu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mootiin Waan Maraa madaala sirrii hin te'in hin jibba;","poem":1},{"text":"safari sirrii hin te'inille isa hin gammachiisu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ijjata namaa ka qajeelchu","poem":1},{"text":"Mootii Waan Maraa ti;","poem":2},{"lineBreak":true},{"text":"nami karaa ifii attam beekuu dande'a ree?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nami tokko adoo itti hin yaadin,","poem":1},{"text":"Waaqaaf waadaa galee,","poem":2},{"lineBreak":true},{"text":"duuba irra yoo gaabbe,","poem":2},{"lineBreak":true},{"text":"tiyyoo seeniisa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mootiin qaroon worra hamaa miidhassee beeka;","poem":1},{"text":"inni marartii malee isaan hin adaba.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mootiin Waan Maraa qalbii namaa hin ilaala;","poem":1},{"text":"keessa namaalle hin qorqora.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Mararti'ii fi addatamummaan nageyaan mootii eegan;","poem":1},{"text":"barcumaan mootummaa isaa","poem":2},{"lineBreak":true},{"text":"addatamumma'aan jabaatee dhaabbata.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ulfinni dargaggootaa jabeenna isaanii ti;","poem":1},{"text":"ulfinni maanguddootaalle arrii isaanii ti.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Adabbiin madeessitu waan hantuu qulqulleessiti;","poem":1},{"text":"dhaaniisille keessa namaa qulqulleessa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/19.json","previousChapterAudioLinks":{},"numberOfVerses":30}