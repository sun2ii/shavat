{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"Yaadi mooti'ii harka Mootii Waan Maraa keessa jira;","poem":1},{"text":"inni akka bisaan yaa'uu gara fedhe isa deebisa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Namatti hujiin inni huju martinuu","poem":1},{"text":"sirrii isatti fakkaatti;","poem":2},{"text":"Mootiin Waan Maraa ammoo","poem":1},{"text":"yaada isaa hin madaala.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Balchumma'aa fi haqa hujuun,","poem":1},{"text":"ciincaa caalaa Mootii Waan Maraa biratti","poem":2},{"lineBreak":true},{"text":"fudhatama qaba.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ifi jajiis, bondhooriisii fi","poem":1},{"text":"hujiin worra hamaaleyyi'ii cubbu'u.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Karoorri worra jabaatee hujuu bu'aa buusa;","poem":1},{"text":"jarjarri ammoo gara hiyyu'uu nama geessa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Karri arraba sobaatiin horatane,","poem":1},{"text":"akkuma hurrii takkumaan gara gorte dhabanuu tii fi","poem":2},{"lineBreak":true},{"text":"akkuma tiyyoo nama ijjeettuu ti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Namooti hamaaleyyiin","poem":1},{"text":"waan sirrii te'e hujuu waan jibbanuuf,","poem":2},{"lineBreak":true},{"text":"hunnaan nama irratti ka'iis isaanii","poem":2},{"lineBreak":true},{"text":"haxowee isaan hin baleessa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Karaan worra yakkaa hujuu micciirama'a;","poem":1},{"text":"karaan worra yakkaa hin qannee ammoo qajeela'a.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Niitii dubbatittii woliin le'iisaa mannaa,","poem":1},{"text":"roga heellichoo manaa irra le'uu woyya.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nami hamaan waan hantuu halcha;","poem":1},{"text":"eennulle'eef marartii hin qabu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nami murgu yennaa adabamu,","poem":1},{"text":"nami gowwaan qarummaa dhaggata;","poem":2},{"lineBreak":true},{"text":"nama qaroo yennaa barsiisane,","poem":2},{"lineBreak":true},{"text":"beekkumsa dhaggata.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Waaqi balchaan,","poem":1},{"text":"waan mana worra hama'aa keessatti","poem":2},{"lineBreak":true},{"text":"hujamiisatti jiru hin beeka;","poem":2},{"lineBreak":true},{"text":"worra hamaa san badii itti hin fida.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hiyyeessa rakkatee iyyuuf nami hin dhageenne,","poem":1},{"text":"innille rakkattee yennaa iyyu,","poem":2},{"lineBreak":true},{"text":"nama isa qarqaaru hin dhaggatu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kennansi dhossa'aan kenname aarii caffachiisa;","poem":1},{"text":"safuun dhossa'aan harka keessa keyanulle,","poem":2},{"lineBreak":true},{"text":"aarii guddoo hin qabbaneessa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Haqi yennaa hujamu,","poem":1},{"text":"worra balchoota hin gammachiisa;","poem":2},{"lineBreak":true},{"text":"worra waan hantuu huju ammoo hin bararassa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nami karaa hubanti'ii irraa goru,","poem":1},{"text":"yaa'ii worra du'ee keessa bu'a.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nami qananummaa jaalatu hin hiyyoommata;","poem":1},{"text":"nami daadhii woyni'iitii fi carree jaalatu ijjumaa hin duroommatu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nami hamaan farra nama balcha'aaf qopheessetti,","poem":1},{"text":"nami hin addatannelle","poem":2},{"lineBreak":true},{"text":"farra nama qajeela'aaf qopheessetti hin gala.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Niitii dubbatittii aartu woliin le'iisa mannaa,","poem":1},{"text":"goomolee keessa le'iisa woyya.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nami qaroon qabeenna gatii guddo'ootii fi zayitii ejersaa mana ifii keessatti kuufata;","poem":1},{"text":"nami gowwaan waan qabu mara balleessa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nami balchumma'aa fi jaalala hordofu,","poem":1},{"text":"jiruu, balchumma'aa fi ulfinna hin dhaggata.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nami qaroon qachaa worra jajjaba'aa hin qabata;","poem":1},{"text":"kushee isaan itti addatanulle hin diiga.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nami afaan ifiitii fi arraba ifii eegatu,","poem":1},{"text":"rakkinna irraa ifi eegata.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nami kooruu fi hunnaan nama irratti ka'u,","poem":1},{"text":"«Ka namatti murgu» jedhama;","poem":2},{"lineBreak":true},{"text":"inni kooraan guutameera.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Harki isaa hujii waan jibbuuf,","poem":1},{"text":"nami booseyi kajeella'aan du'a.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Inni guyyaa guutuu kajeela;","poem":1},{"text":"nami balchaan ammoo","poem":2},{"lineBreak":true},{"text":"harka keessa adoo hin qabatin kenna.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mootiin Waan Maraa ciincaa nama hama'aa jibba;","poem":1},{"text":"yennaa nami yaada hama'aan kennu fa'a irraa caalaa jibba.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Dhugaa bayi dharaamessaa hin baddi;","poem":1},{"text":"dhugaa bayi dhugaamessaa ammoo","poem":2},{"lineBreak":true},{"text":"haga bara baraa hin jiraatti.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Nami hamaan mataa jabaata;","poem":1},{"text":"nami qajeelaan ammoo marroo","poem":2},{"lineBreak":true},{"text":"hujii ifii itti yaadata.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Qarummaan, hubanti'ii fi","poem":1},{"text":"karoorri Mootii Waan Maraa","poem":2},{"lineBreak":true},{"text":"ifi irraa dhooggatiisa dandeessittu hin jirtu.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Guyyaa lolaatiif farda hin qopheeffatan;","poem":1},{"text":"ka nama injifachiisu ammoo Mootii Waan Maraa ti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":31}