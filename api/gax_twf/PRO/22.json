{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":[{"text":"Durummaa guddo'oo mannaa, maqaa dansaa woyya;","poem":1},{"text":"meeti'ii fi worqii caalaa","poem":2},{"lineBreak":true},{"text":"fudhatama qabaachuu woyya.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isaan lamaanuu ka dade,","poem":1},{"text":"Mootii Waan Maraa waan te'eef,","poem":2},{"lineBreak":true},{"text":"dureessii fi hiyyeessi wol qixxe'e.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nami qalbeeffataan balaa dhaggee dhokata;","poem":1},{"text":"nami gowwaan ammoo ittuma ideemee rakkata.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gad ifi qabiisii fi Mootii Waan Maraa sodaatiis","poem":1},{"text":"karra, ulfinnaa fi jiruu namaaf kennan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Karaa namoota hama'aa keessa qore'ee fi tiyyo'otti jira;","poem":1},{"text":"nami ifi eegatu ammoo irraa fagaata.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ijoollee karaa sirri'ii barsiisi;","poem":1},{"text":"yennaa dulloomanelle isaan","poem":2},{"lineBreak":true},{"text":"karaa san irraa hin goranu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dureessi hiyyeessa bulcha;","poem":1},{"text":"ka liqeeffatulle ka liqeessuuf tajaajila'a.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nami hammeenna facaasu rakkoo haammata;","poem":1},{"text":"uleen aarii isaalle hin baddi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sagalee ifii hiyyeeyyii woliin waan qoodamuuf,","poem":1},{"text":"nami arjaan hin eebbifama.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nama murgu gad baasi;","poem":1},{"text":"wol dhabille hin baya;","poem":2},{"lineBreak":true},{"text":"lolli, arrabille hin jiraatu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nami yaada qullu'uu fi dubbii qulluu jaalatu,","poem":1},{"text":"jaala mooti'ii hin te'a.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ilti Mootii Waan Maraa beekkumsa eeddi;","poem":1},{"text":"dubbii worra hin addatannee ammoo inni hin balleessa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nami booseyi, «Neenqi ala jira!","poem":1},{"text":"Yookiin ani karaa irratti hin du'a» jedha.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Afaan dubartii gaarayyeeffattu'uu akka boolla qile'ee ti;","poem":1},{"text":"nami Mootii Waan Maraa abaare isii keessa bu'a.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Gowwummaan yaada ijoolle'ee qabatteerti;","poem":1},{"text":"uleen xixxa'aa ammoo gowwummaa isaan irraa hin fageessiti.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nami durummaa ede'atiisaaf hiyyeessa cunqursu,","poem":1},{"text":"ka dureessaaf kennansa kennulle lamaanuu hin hiyyoommatan.","poem":2}]},{"type":"heading","content":["Jecha Qaro'oo"]},{"type":"verse","number":17,"content":[{"text":"Gurra keeti itti qabadhuutii,","poem":1},{"text":"Waan qaroon jedhu caqasi!","poem":2},{"lineBreak":true},{"text":"Gadhaa keeti gara barsiisa kiyyaa deebifadhu!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Isiin dansaa waan teeteef, gadhaa keetitti qabadhuutii,","poem":1},{"text":"yennaa mara marroo isi'ii dubbadhu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Akka ati Mootii Waan Maraatitti addattuuf,","poem":1},{"text":"ani adha si barsiisa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Jechoota gorsaatii fi beekkumsaa","poem":1},{"text":"soddoma ani si'iif hin barreessinee ree?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Worra si erguuf deebii dhuga'aa akka deebittuuf,","poem":1},{"text":"dhuga'aa fi jecha dhuga'aa ani si hin barsiinnee ree?","poem":2}]},{"type":"heading","content":["Tokkeessoo"]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Worra hiyyeeyyii waan hiyyeeyyii te'aneef hin saamin;","poem":1},{"text":"worra rakkataa addee mura'aatitti hin farrisiisin.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mootiin Waan Maraa isaaniif waan falmatuuf,","poem":1},{"text":"nama isaan saamu hin saama.","poem":2}]},{"type":"heading","content":["Lammeessoo"]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Nama aarammeessa jaala hin godhatin;","poem":1},{"text":"nama dafee aarutti hin maxxanin.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ati isa irraa barattee,","poem":1},{"text":"tiyyoo isaa keessa seenta fa'a.","poem":2}]},{"type":"heading","content":["Sadeessoo"]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Nama waada'aaf harka namaa dhowu,","poem":1},{"text":"yookiin liqa'aaf wobii dabaru hin te'in.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ati waan kaffaltuu yoo dhadde,","poem":1},{"text":"itilleen teeti si jalaa hin fuudhatanti.","poem":2}]},{"type":"heading","content":["Arfeessoo"]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Dhakaa meessa'aa ka durii ka abbootiin durii dhaabane adde'ee hin munyuussin.","poem":1}]},{"type":"heading","content":["Shaneessoo"]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Ati nama hujii ifiitiin leenji'eeru dhaggiteertaa?","poem":1},{"text":"Inni mootota dura tajaajila malee,","poem":2},{"lineBreak":true},{"text":"nama mara dura hin tajaajilu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/21.json","previousChapterAudioLinks":{},"numberOfVerses":29}