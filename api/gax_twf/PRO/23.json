{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":23,"content":[{"type":"heading","content":["Jayeessoo"]},{"type":"verse","number":1,"content":[{"text":"Sagalee nyaatiisaaf bulchaa woliin yennaa teettu,","poem":1},{"text":"waan si dura jirtu san hubadhuu ilaali.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nyaatiisaaf dharraa guddoo yoo qabaattelle,","poem":1},{"text":"ifi qabadhu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sagaleen sun waan si sodduuf,","poem":1},{"text":"mi'aan isi'ii si hin joljolsin.","poem":2}]},{"type":"heading","content":["Torbeessoo"]},{"type":"verse","number":4,"content":[{"text":"Duroomiisaaf jettee akka malee hin elowin;","poem":1},{"text":"ifi qabatiisaaf qarummaa qabaadhu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Durummaan akka risaa koolaan ka'uu,","poem":1},{"text":"haga lipheettii ilaatitti,","poem":2},{"lineBreak":true},{"text":"nama duraa baduu hin dandeetti.","poem":2}]},{"type":"heading","content":["Saddeetessoo"]},{"type":"verse","number":6,"content":[{"text":"Sagalee nama donnaa hin nyaatin;","poem":1},{"text":"mi'aan isi'ii si hin joljolsin.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni akka nama yennaa mara marroo gatii sagaleen sun baachu yaaduu ti;","poem":1},{"text":"inni afaaniin, «Nyaadhu; uni» siin jedha;","poem":2},{"lineBreak":true},{"text":"gadhaan isaa ammoo si woliin hin jiru.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Diqqoo nyaatteeyyuu hin diddidda;","poem":1},{"text":"dubbii galataa teetille hin balleessita.","poem":2}]},{"type":"heading","content":["Sagaleessoo"]},{"type":"verse","number":9,"content":[{"text":"Inni dubbii qarumma'aa teetitti waan murguuf,","poem":1},{"text":"gowwa'atti hin dubbatin.","poem":2}]},{"type":"heading","content":["Kudhaneessoo"]},{"type":"verse","number":10,"content":[{"text":"Dhakaa meessa'aa ka durii adde'ee hin munyuussin","poem":1},{"text":"yookiin fichaa ijoollee abbaa hin qannee","poem":2},{"lineBreak":true},{"text":"meessaa hin dabarin.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Waaqi isaan wodu jabaa waan te'eef,","poem":1},{"text":"inni isaaniif hin falmata.","poem":2}]},{"type":"heading","content":["Kudhanii Tokkeessoo"]},{"type":"verse","number":12,"content":[{"text":"Qalbii teeti gara gorsaa,","poem":1},{"text":"gurra keetille gara beekkumsaa deebifadhu.","poem":2}]},{"type":"heading","content":["Kudhanii Lammeessoo"]},{"type":"verse","number":13,"content":[{"text":"Ijoollee teeti adabiisa hin lakkisin;","poem":1},{"text":"kuta'aan yoo dhaante isaan hin du'anu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ati yoo kuta'aan isaan dhaante,","poem":1},{"text":"lubbuu isaanii du'a irraa hin hamburta.","poem":2}]},{"type":"heading","content":["Kudhanii Sadeessoo"]},{"type":"verse","number":15,"content":[{"text":"Ilma kiyya, ati qaroo yoo teete,","poem":1},{"text":"gadhaan kiyya hin gammada.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yennaa afaan keeti waan sirrii te'e dubbatu,","poem":1},{"text":"keessi kiyya guddoo gammada.","poem":2}]},{"type":"heading","content":["Kudhanii Arfeessoo"]},{"type":"verse","number":17,"content":[{"text":"Yennaa mara Mootii Waan Maraa","poem":1},{"text":"sodaatiisaaf hinaaf malee,","poem":2},{"lineBreak":true},{"text":"cubbaaleyyi'itti hin hinaafin.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Dhugumaan ati gara fuula duraa addii qadda;","poem":1},{"text":"addiin teetille hin baddu.","poem":2}]},{"type":"heading","content":["Kudhanii Shaneessoo"]},{"type":"verse","number":19,"content":[{"text":"Ilma kiyya, caqasi;","poem":1},{"text":"qaroolle te'i;","poem":2},{"lineBreak":true},{"text":"qalbii teetille daandii qajeelaa irratti eegadhu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Worra daadhii woyni'ii akka malee unuu fi","poem":1},{"text":"worra foon akka malee nyaatu woliin hin jaalomin.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Worri machowuu fi worri gadhitoon hin hiyyoommatan;","poem":1},{"text":"hirriibi hamaan isaaniille woyaa ciccittuu isaanitti hin uffisa.","poem":2}]},{"type":"heading","content":["Kudhanii Jayeessoo"]},{"type":"verse","number":22,"content":[{"text":"Abbaa keeti ka si uume dhage'i;","poem":1},{"text":"haadha teetille yennaa isiin dulloonte hin tuffatin.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Dhuga'aa fi qarummaa,","poem":1},{"text":"gorsaa fi hubantii bitadhu malee hin gurgurin.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Abbaan nama balcha'aa gammada guddaa qaba;","poem":1},{"text":"ka ilma qaroo qabulle isatti hin gammada.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Abbaan keetii fi haati teeti gammadanuu ti;","poem":1},{"text":"haati si deette akka malee gammadduu ti.","poem":2}]},{"type":"heading","content":["Kudhanii Torbeessoo"]},{"type":"verse","number":26,"content":[{"text":"Ilma kiyya, qalbii teeti naa kenni;","poem":1},{"text":"ilti teetille karaa kiyya ilaaltuu ti.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Dubartiin sagaagaltittiin akka boolla qile'ee ti;","poem":1},{"text":"niitiin gaarayyeeffattuun akka balleessa dhipha'aa ti.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Isaan akka worra nama saamuu riphanee si eegan;","poem":1},{"text":"dhiira hedduu niitii ifiitiif akka hin addatanne godhan.","poem":2}]},{"type":"heading","content":["Kudhanii Saddeetessoo"]},{"type":"verse","number":29,"content":[{"text":"Ka waacifu eennu?","poem":1},{"text":"Ka gaddu eennu?","poem":2},{"lineBreak":true},{"text":"Ka wol dhabu eennu?","poem":2},{"lineBreak":true},{"text":"Ka nama komatu eennu?","poem":2},{"lineBreak":true},{"text":"Ka sababa malee madowu eennu?","poem":2},{"lineBreak":true},{"text":"Ka ila diimatu eennu?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Worra daadhii woyni'ii irra turu,","poem":1},{"text":"ka yennaa mara daadhii woyni'ii","poem":2},{"lineBreak":true},{"text":"ta makaa qaddu barbaaduu motii ree?","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Daadhiin woyni'ii yennaa diimattu,","poem":1},{"text":"shurrubbee keessaa yennaa calalaxxu,","poem":2},{"lineBreak":true},{"text":"akka kasoo yennaa isii unanu","poem":2},{"lineBreak":true},{"text":"si hin halchisiisin.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Muummee irratti akka dhudhuufa'aa si idditi;","poem":1},{"text":"akka buuti'iille hadhaa sitti naxxi.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ilti teeti waan haareya dhaggiti;","poem":1},{"text":"qalbiin teetille hin cucurruuxxi.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Akka nama abbaayaa irra rafuu,","poem":1},{"text":"akka nama qaccee utubaa hobolo'oo irra irkatuu hin teeta.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ati, «Na dhowane;","poem":1},{"text":"ani ammoo hin miidhanne;","poem":2},{"lineBreak":true},{"text":"na dhaanane;","poem":2},{"lineBreak":true},{"text":"ani ammoo hin dhukkuffanne;","poem":2},{"lineBreak":true},{"text":"untoo dhibii barbaadatiisaaf, yoom dammaqa?» jetta.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}