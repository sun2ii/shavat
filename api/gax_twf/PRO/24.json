{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":24,"content":[{"type":"heading","content":["Kudhanii Sagaleessoo"]},{"type":"verse","number":1,"content":[{"text":"Namoota hamoolee hin hinaafin;","poem":1},{"text":"jaalummaa isaanii hin halchin.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gadhaan isaanii hunnaan nama irratti ka'iisa yaada;","poem":1},{"text":"afaan isaaniille marroo maltumma'aa dubbata.","poem":2}]},{"type":"heading","content":["Diddameessoo"]},{"type":"verse","number":3,"content":[{"text":"Manni qarumma'aan ijaarama;","poem":1},{"text":"hubantiille'een jabeeffama.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Beekkumsaan kollooti mana sanii","poem":1},{"text":"meya gatii guddo'ootii fi","poem":2},{"lineBreak":true},{"text":"meya dadansa'aan guutaman.","poem":2}]},{"type":"heading","content":["Diddamii Tokkeessoo"]},{"type":"verse","number":5,"content":[{"text":"Nami qaroon hunna jadduu qaba;","poem":1},{"text":"nami beekkumsa qabulle jabeenna dabalata.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lolaaf bayiisaaf qajeelcha,","poem":1},{"text":"injifatiisaafille gorsitoota hedduu barbaachisa.","poem":2}]},{"type":"heading","content":["Diddamii Lammeessoo"]},{"type":"verse","number":7,"content":[{"text":"Nama gowwa'aaf qarummaan akka malee ol fagaatti;","poem":1},{"text":"inni addee mari'ii keessatti","poem":2},{"lineBreak":true},{"text":"afaan ifii hin saaqatu.","poem":2}]},{"type":"heading","content":["Diddamii Sadeessoo"]},{"type":"verse","number":8,"content":[{"text":"Nami waan hantuu godhiisaaf mala dhowu,","poem":1},{"text":"inni, «Malticha» jedhamee beekkama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Malli gowwa'aa cubbu'u;","poem":1},{"text":"namooti nama murgu hin jibban.","poem":2}]},{"type":"heading","content":["Diddamii Arfeessoo"]},{"type":"verse","number":10,"content":[{"text":"Ati bara rakko'oo keessa yoo raafante,","poem":1},{"text":"jabeenni keeti attam attam diqqa'a!","poem":2}]},{"type":"heading","content":["Diddamii Shaneessoo"]},{"type":"verse","number":11,"content":[{"text":"Worra gara du'aa geeffamanu baasi;","poem":1},{"text":"worra gara qalamiisaa tintimanu deebisi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ati, «Nuuti marroo waan kanaa hin beenne» yoo jette,","poem":1},{"text":"ka gadhaa namaa qorqoru kana hin hubatuu ree?","poem":2},{"lineBreak":true},{"text":"Ka jiruu teeti eegu hin beekuu ree?","poem":2},{"text":"Inni nama tokko tokkoofuu","poem":1},{"text":"akka hujii isaatitti gatii isaaf hin kaffaluu ree?","poem":2}]},{"type":"heading","content":["Diddamii Jayeessoo"]},{"type":"verse","number":13,"content":[{"text":"Ilma kiyya, dammi dansaa waan te'eef,","poem":1},{"text":"damma nyaadhu;","poem":2},{"lineBreak":true},{"text":"nadhiin dhaaba dammaa keessaa sitti hin mi'ootti.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Qarummaalle lubbuu teetiif","poem":1},{"text":"akkuma san akka mi'oottu beeki;","poem":2},{"lineBreak":true},{"text":"ati yoo isii dhaggatte,","poem":2},{"lineBreak":true},{"text":"gara fuula duraa addii qadda;","poem":2},{"lineBreak":true},{"text":"addiin teetille hin baddu.","poem":2}]},{"type":"heading","content":["Diddamii Torbeessoo"]},{"type":"verse","number":15,"content":[{"text":"Akka nama hama'aa","poem":1},{"text":"mana nama balcha'aa dhokattee hin gaadin.","poem":2},{"lineBreak":true},{"text":"Mana isaa irralle'etti hunnaan hin ka'in.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nami balchaan yennaa torba jigulle deebi'ee hin ka'a;","poem":1},{"text":"nami hamaan ammoo badii keessa bu'a.","poem":2}]},{"type":"heading","content":["Diddamii Saddeetessoo"]},{"type":"verse","number":17,"content":[{"text":"Yennaa diinni keeti jigu hin gammadin;","poem":1},{"text":"yennaa inni gufatulle gadhaan keeti hin firinxiixin.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Itti gammadiisa keeti yoo dhagge,","poem":1},{"text":"Mootiin Waan Maraa hin jaalatu;","poem":2},{"lineBreak":true},{"text":"aarii ifii isa irraa hin deebisa.","poem":2}]},{"type":"heading","content":["Diddamii Sagaleessoo"]},{"type":"verse","number":19,"content":[{"text":"Waan namooti hamaan hujanu hin qoxxisin;","poem":1},{"text":"yookiin hamoolee hin hinaafin.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nami hamaan addii gara fuula duraa hin qabu;","poem":1},{"text":"issaan nama hama'aalle hin dhaama.","poem":2}]},{"type":"heading","content":["Soddomeessoo"]},{"type":"verse","number":21,"content":[{"text":"Ilma kiyya, Mootii Waan Maraatii fi mooticha sodaadhu;","poem":1},{"text":"worra finqilaa woliin jaala hin te'in.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mootiin Waan Maraatii fi mootichi","poem":1},{"text":"dedhuma badii worra finqilaa irratti hin fidan;","poem":2},{"lineBreak":true},{"text":"badii isaan fidanu eentu beeka ree?","poem":2}]},{"type":"heading","content":["Jecha Qaro'oo Ka Dhibii"]},{"type":"verse","number":23,"content":[{"text":"Isaan kunille jecha qaro'oo ti:","poem":1},{"text":"Muraa keessatti nama wol caalchisuun dansa'aa moti.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nama hama'aan, «Ati yakkaa hin qaddu» nama jedhu,","poem":1},{"text":"kolbaan hin abaarti;","poem":2},{"lineBreak":true},{"text":"gosi biyya adda addaalle hin jibbiti.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Worra nama hamaa xixuuf ammoo","poem":1},{"text":"wonni dansaan hin teeti;","poem":2},{"lineBreak":true},{"text":"eebbi dansaalle isaan irratti hin bu'a.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Deebii dhuga'aa deebisuun,","poem":1},{"text":"akka sunqaa hidhi'ii ti.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Hujii alaa fixadhuu,","poem":1},{"text":"fichaa keeti qopheeffadhu;","poem":2},{"lineBreak":true},{"text":"achiin duuba mana keeti ijaaradhu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Sababa malee nama irratti dhugaa hin bayin","poem":1},{"text":"yookiin hidhii teetiin nama hin sobin.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ati, «Waanuma nami na godhe, anille isa hin godha;","poem":1},{"text":"gatuma hujii isaa isaaf hin deebisa» hin jedhin.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ani fichaa nama booseyaa keessa,","poem":1},{"text":"oorruu woyni'ii ta nama qalbii hin qannee","poem":2},{"lineBreak":true},{"text":"keessa dabaree deeme.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Addee mara qoreen itti latteerti;","poem":1},{"text":"shuqunaan lafa golliteerti;","poem":2},{"lineBreak":true},{"text":"dalleenni dhaka'aalle irraa jigeera.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ani waan kana ilaalee itti yaadee,","poem":1},{"text":"waan dhagge kana irraa barumsa dhaggadhe:","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ati yennaa diqqoo isi'ii rafii,","poem":1},{"text":"yennaa diqqoo isi'ii mugii,","poem":2},{"lineBreak":true},{"text":"foorfatiisaaf yennaa diqqoo isi'ii","poem":2},{"lineBreak":true},{"text":"harka wol irra naqadhu.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Garuu hiyyuun akka saantu'uu,","poem":1},{"text":"beelti akka nama meya lolaa hidhatee","poem":2},{"lineBreak":true},{"text":"sitti hin dhufan.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}