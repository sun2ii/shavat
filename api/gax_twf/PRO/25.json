{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":25,"content":[{"type":"heading","content":["Jecha Qarummaa Solomoonii Ka Dhibii"]},{"type":"verse","number":1,"content":[{"text":"Isaan kunille fakkeenna Solomoonii ka dhibii,","poem":1},{"text":"ka qondaaltoti Hisqiyaasii mootii","poem":2},{"lineBreak":true},{"text":"Yihuda'aa barreeffama irraa garagalchane.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gofa woyii dhossuun ulfinna Waaqaa ti;","poem":1},{"text":"gofa woyii qoratanee baasuun","poem":2},{"lineBreak":true},{"text":"ulfinna moototaa ti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Akkuma ol-gubbaan ol fagaattu","poem":1},{"text":"akkuma lattille gaddi fagaattu,","poem":2},{"lineBreak":true},{"text":"yaadi moototaalle qorqoramuu hin dande'u.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ka meetii irraa meya huju meetii qulluu akka qabaatu,","poem":1},{"text":"ati meetii san irraa xurii kaasi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Barcumaan mootumma'aa","poem":1},{"text":"balchumma'aan akka dhaabbatu,","poem":2},{"lineBreak":true},{"text":"nama hamaa addee mootiin jiruu kaasi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mootii duratti ol ifi hin qabin;","poem":1},{"text":"nama guddaa ifi hin fakkeessin.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mootichi nama guddaa duratti","poem":1},{"text":"addee gad aantuu sii kenniisaa mannaa,","poem":2},{"lineBreak":true},{"text":"addee ol aantuu sii kennu woyya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Waan tokko ilumaan dhaggite'eef","poem":1},{"text":"ariifattee gara mura'aa hin dhikeessin;","poem":2},{"lineBreak":true},{"text":"nami dhibiin dokonkora keeti yoo mirkaneesse,","poem":2},{"lineBreak":true},{"text":"ati dhuma irratti maan teeta ree?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Haajaa keetiif nama woliin yennaa falmattu,","poem":1},{"text":"gofa nama dhibi'ii hin mudhisin.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yoo akkas hin te'in nami waan kana dhage'u si qaanessa;","poem":1},{"text":"maqaan keeti ka bade sun ijjumaa si'iif hin deebi'u.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dubbiin yennaa isi'iititti dubbatantu,","poem":1},{"text":"akka quumhaa worqi'ii ka qorii meeti'ii keessaa ti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xixxaan nama qaro'oo nama isa dhage'uuf,","poem":1},{"text":"akka worqii gurraa yookiin meya seesaa","poem":2},{"lineBreak":true},{"text":"ka worqii qulluu irraa hujamee ti.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bisaan dhakaa roobaatiin qabbanowe,","poem":1},{"text":"yennaa midhaan galcha'aa","poem":2},{"lineBreak":true},{"text":"akkuma gadhaa namaa qabbaneessu,","poem":2},{"lineBreak":true},{"text":"ergantooti addatamootille","poem":2},{"lineBreak":true},{"text":"nama isaan ergatuuf akkasuma;","poem":2},{"lineBreak":true},{"text":"isaan yaada goottolee ifii hin foorfachiisan.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nami kennansa namaaf hin kennineen ifi jaju,","poem":1},{"text":"akka duumensaa fi qilleensa bokkeya hin qannee ti.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nami ossa qabu","poem":1},{"text":"bulchaa biyyaa tokko gadhaa hin laaffifata;","poem":2},{"lineBreak":true},{"text":"arrabi dansaan nama mataa jabaatu laaffisa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Damma yoo dhaggatte,","poem":1},{"text":"haga si'iif barbaachisu qofa nyaadhu;","poem":2},{"lineBreak":true},{"text":"akka malee nyaattu si diddissa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Si bagee waan si jibbuuf,","poem":1},{"text":"miilli keeti mana ollaa keetiititti hin daandin.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nami dharaan dhugaa nama irratti bayu,","poem":1},{"text":"akka ulee jirmaa yookiin","poem":2},{"lineBreak":true},{"text":"akka shallaaga'aa yookiin","poem":2},{"lineBreak":true},{"text":"akka daaya qara qabuu ti.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Rakkinna keessa nama hin addatannetti addatiis,","poem":1},{"text":"akka nama ilkaan tacho'etti","poem":2},{"lineBreak":true},{"text":"yookiin miila laashowetti addatuu ti.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nama gaddeef faaruu faarsuun,","poem":1},{"text":"akka nama guyyaa boojji'ii","poem":2},{"lineBreak":true},{"text":"woyaa isaa isa irraa fuudhanee ti","poem":2},{"lineBreak":true},{"text":"yookiin akka soodda mada'atti naqanee ti.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Diinni keeti yoo beelote sagalee nyaatu kenniif;","poem":1},{"text":"yoo dheebotelle bisaan unu kenniif.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Tana godhiisaan gaabbee akka inni qaanowu hin goota;","poem":1},{"text":"Mootiin Waan Maraalle gatii si'iif hin kaffala.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Akkuma qilleensi kaabaa bokkeya fidu,","poem":1},{"text":"arrabi hamatu ila aari'iin nama ilaaltu hin fida.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Niitii dubbatittii woliin le'iisaa mannaa,","poem":1},{"text":"roga heellichoo manaa irra le'uu woyya.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Oduun dansaan biyya fago'oo,","poem":1},{"text":"akkuma bisaan qabbanowaa","poem":2},{"lineBreak":true},{"text":"lubbuu dheebotte dheebuu baasuu ti.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nami balchaan nama hama'aaf karaa kennu,","poem":1},{"text":"akka madda boorayee,","poem":2},{"lineBreak":true},{"text":"yookiin akka bisaan boollaa","poem":2},{"lineBreak":true},{"text":"ka xurayee ti.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Damma akka malee nyaatiis dansa'aa moti","poem":1},{"text":"yookiin ulfinna mataa ifii barbaadatiisi ulfinnaa moti.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Nami ifi qabatiisa hin dandeenne,","poem":1},{"text":"akka qachaa guddicha dalleenni dhaka'aa irraa jigee ti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/24.json","previousChapterAudioLinks":{},"numberOfVerses":28}