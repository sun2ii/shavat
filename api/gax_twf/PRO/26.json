{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"Dhakaan roobaa bona keessa,","poem":1},{"text":"bokkeenni yennaa midhaan galfatanuuf akkuma hin teene,","poem":2},{"lineBreak":true},{"text":"ulfinnille gowwa'aaf hin te'u.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abaarsi akkasumaan nama abaaranu,","poem":1},{"text":"akkuma sinbirroota koolaan asii fi achi kaatuu ti malee,","poem":2},{"lineBreak":true},{"text":"nama tokkolle hin miidhu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Licheen fardaaf,","poem":1},{"text":"bixaalli gaange'eef akkuma barbaachisu,","poem":2},{"lineBreak":true},{"text":"uleen dudda gowwa'aatiif hin barbaachitti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Atinuu akka isaa akka hin teene,","poem":1},{"text":"gowwa'aaf akka gowwummaa isaatitti","poem":2},{"lineBreak":true},{"text":"deebii gowwittii hin deebisin.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nami gowwaan qaroo akka ifi hin seene,","poem":1},{"text":"akkuma gowwummaa isaatitti deebii isaaf kenni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nami nama gowwaa ergatu,","poem":1},{"text":"akka nama miila ifi irraa muree rakkinna ifitti fiduu ti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Fakkeenni afaan gowwa'aa keessaa bawu,","poem":1},{"text":"akka miila naafatee rarra'uu ti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nama gowwa'aaf ulfinna kenniis,","poem":1},{"text":"akka nama looyya'atti dhakaa hidhuu ti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Fakkeenni afaan gowwa'aa keessaa bawu,","poem":1},{"text":"akka qoree harka nama machowa'aa keessa jirtuu ti.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nami nama gowwaa yookiin nama karaa deemu qaxaru,","poem":1},{"text":"akka nama daaya akkuma dhagge","poem":2},{"lineBreak":true},{"text":"darbatee nama dhagge madeessuu ti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sareen diddiga ifiititti akkuma deebitu,","poem":1},{"text":"gowwaalle gowwummaa ifiititti hin deddeebi'a.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nama qaroo ifi sewu dhaggiteertaa?","poem":1},{"text":"Isa caalaa gowwa'atti addii qaba.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nami booseyi, «Neenqi karaa keessa jira!","poem":1},{"lineBreak":true},{"text":"Neenqi karaa guddaa keessa jira» jedha.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Miilli saanqa'aa iloo keessa akkuma garagaggalu,","poem":1},{"text":"nami booseyille taqee ifii irra garagaggala.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nami booseyi harka ifii qorii keessa hin keya;","poem":1},{"text":"garuu gara afaan ifii deebifatiisa guddoo dadhaba.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nami booseyi,","poem":1},{"text":"namoota torba ka hubanti'iin deebii deebisanu caalaa","poem":2},{"lineBreak":true},{"text":"qaroo ifi seya.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nami akkasumaan dubbii namaa keessa galu,","poem":1},{"text":"akka nama saree karaa ideentu gurra qabuu ti.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Akkuma maraataan umeessaa ibiddaatii fi","poem":1},{"text":"daaya nama ijjeesu namatti gad lakkisu,","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"nami nama gowwoonsee,","poem":2},{"lineBreak":true},{"text":"«Ani hin taphadhe» jedhulle akkasuma.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Qoraan yoo hin jiraatin ibiddi hin dhaama;","poem":1},{"text":"hamiin yoo hin jiraatin lolli hin hafa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Cileen kashila,","poem":1},{"text":"muki ibidda akkuma gabbisu,","poem":2},{"lineBreak":true},{"text":"nami dubbii tuttuqu lola kaasa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Jechi hami'ii akka tuuqata mi'owuu ti;","poem":1},{"text":"gara keessa namaa gad seena.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nami afaan ifiitiin dansaa fakkaatee,","poem":1},{"text":"gadhaa ifii keessaa yaada hamaa qabu,","poem":2},{"lineBreak":true},{"text":"akka meya faaraa ka meetii itti gonfanee ti.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nami kijibu afaaniin nama sossoba;","poem":1},{"text":"gadhaa ifiitiin hantuu yaadata.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yaadi hamaan torba","poem":1},{"text":"waan gadhaa isaa keessa guuteeruuf,","poem":2},{"lineBreak":true},{"text":"yennaa inni afaan laafee dubbatu,","poem":2},{"lineBreak":true},{"text":"isa hin dhugeeffatin.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kijibummaa ifii maltumma'aan dhoffatulle,","poem":1},{"text":"hammeenni isaa ammoo gumii","poem":2},{"lineBreak":true},{"text":"keessatti diidatti hin baya.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nami boolla namaaf qotu,","poem":1},{"text":"ifumaafuu keessa hin bu'a.","poem":2},{"text":"Nami dhakaa namatti konkolaachisulle,","poem":1},{"text":"dhakaan sun deebi'ee isuma irra hin konkolaata.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Arrabi dharaamessi worruma ifiifuu miidhe jibba;","poem":1},{"text":"afaan sobaan kookkisulle badii namatti fida.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/25.json","previousChapterAudioLinks":{},"numberOfVerses":28}