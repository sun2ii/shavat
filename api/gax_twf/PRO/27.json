{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"Waan Guyyaan fidu waan hin beenneef,","poem":1},{"text":"waan boru te'uun ifi hin jajin.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nami si jajuu ti malee, ati ifi hin jajin;","poem":1},{"text":"nami dhibiin si jajuu ti malee, afaan keetiin ifi hin jajin.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dhakaan hin ulfaata;","poem":1},{"text":"maansille ba'a'a.","poem":2},{"text":"Nunnussaan gowwaan tuttuqee nama aarsu ammoo,","poem":1},{"text":"isaan lachuu caalaa hin ulfaatti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mufiin gadhi-jabeenna;","poem":1},{"text":"aariin lola'a;","poem":2},{"lineBreak":true},{"text":"hinaaffaa dura ammoo","poem":2},{"lineBreak":true},{"text":"eentu dhaabbatuu dande'a?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Jaalala dhokate caalaa,","poem":1},{"text":"xixicha mudhatu woyya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sunqaa diinaatii mannaa,","poem":1},{"text":"jaalli si madeessu woyya.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nama quufe,","poem":1},{"text":"dammi itti bushowa;","poem":2},{"lineBreak":true},{"text":"nama beelote ammoo","poem":2},{"lineBreak":true},{"text":"wonni hadhowuuyyuu itti mi'owa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nami qe'ee ifii keessaa baye,","poem":1},{"text":"akka sinbirree mana ifii keessaa baatee ti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Fiqire'ee fi qayyi nama gammachiisan;","poem":1},{"text":"gammachiisiis jaalaalle","poem":2},{"lineBreak":true},{"text":"gorsa dansaa isaa irraa madda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Jaalota teetii fi jaalota abbaa keetii hin lakkisin;","poem":1},{"text":"yennaa rakkinnaa mana obboleessa keetii hin dhaqin;","poem":2},{"lineBreak":true},{"text":"obboleessa fagoo jiruu mannaa,","poem":2},{"lineBreak":true},{"text":"ollaa dhikoo jiru woyya.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ilma kiyya,","poem":1},{"text":"nama na arrassuuf deebii kennuu akka ani dande'u,","poem":2},{"lineBreak":true},{"text":"ati qaroo te'i;","poem":2},{"lineBreak":true},{"text":"gadhaa kiyyalle gammachiisi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nami qalbeeffataan waan hantuu dhaggee duraa baqata;","poem":1},{"text":"nami hubantii hin qanne ammoo ittuma ideemee,","poem":2},{"lineBreak":true},{"text":"rakkoo keessa seena.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nama alaga'aaf wobii te'e woyaa irraa mulqadhu;","poem":1},{"text":"haga inni waan alagaan fudhate san deebisutti","poem":2},{"lineBreak":true},{"text":"woyaa san qabadhu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nami barii ganamaan ka'ee,","poem":1},{"text":"qoonqoo ol qabatee nama yoo eebbise,","poem":2},{"lineBreak":true},{"text":"eebbi sun abaarsa nama sanitti fakkaata.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Niitiin dubbattittiin akka mana","poem":1},{"text":"guyyaa roobaa dhim'isaa ooluu ti.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Isii ittisiis qilleensa ittisiisa,","poem":1},{"text":"yookiin zayitii harkaan qabiisa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Akkuma sibiilli sibiila cabbu,","poem":1},{"text":"namille nama cabba.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nami muka harru'uu kunuunsu","poem":1},{"text":"midhaan isi'ii hin nyaata;","poem":2},{"lineBreak":true},{"text":"nami goottaa ifii eegulle","poem":2},{"lineBreak":true},{"text":"ulfinna hin dhaggata.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Akkuma bisaan fuula namaa mudhisu,","poem":1},{"text":"yaadi namaalle eennummaa namaa mudhisa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Addeen worri du'e jiruu fi","poem":1},{"text":"addeen badi'ii ijjumaa hin quuttu;","poem":2},{"lineBreak":true},{"text":"ilti namaalle ijjumaa hin quuttu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Meeti'ii fi worqiin addee itti baqisiisanu keessatti","poem":1},{"text":"akkuma haga ilaallatamanu,","poem":2},{"lineBreak":true},{"text":"namille leellifamiisaan haga ilaalama.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Gowwaa akka midhaanii","poem":1},{"text":"mooyye'etti tuma'aan yoo tuntelle,","poem":2},{"lineBreak":true},{"text":"gowwummaa isa keessaa baasuu hin dandeettu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hoolee teeti haala attamii keessaa akka jirtu","poem":1},{"text":"midhassii beeki;","poem":2},{"lineBreak":true},{"text":"loon keetille midhassii tiffadhu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Sababille durummaan haga bara baraa hin jiraatu;","poem":1},{"text":"kallachille dhalootaa dhalootatti hin dabaru.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Marri gogaan haamamee,","poem":1},{"text":"marri haarenni yennaa latu,","poem":2},{"lineBreak":true},{"text":"marri koobota irraa yennaa wolitti qabamu,","poem":2}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"buruusoo hoolota teetiitiin daara hin baata;","poem":2},{"lineBreak":true},{"text":"re'oota teetille'een fichaa hin bitatta.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Soorata keetiif, soorata maatii teetiitiif,","poem":1},{"text":"soorata tajaajiltoota teetiifille ka gewu,","poem":2},{"lineBreak":true},{"text":"aanan re'e'ee hin qabaatta.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":27}