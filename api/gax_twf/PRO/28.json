{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"Nami hamaan adoo nami hin ari'in baqata;","poem":1},{"text":"nami balchaan ammoo akka neenqaa ifi addata.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kolbaan yennaa finqila kaatu,","poem":1},{"text":"bulchitooti isi'ii hin heddatti;","poem":2},{"lineBreak":true},{"text":"nama hubata'aa fi beekaa yoo qabaatte ammoo","poem":2},{"lineBreak":true},{"text":"mootummaan isi'ii jabaattee hin dhaabbatti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bulchaan hiyyeessa cunqursu","poem":1},{"text":"akka bokkeya midhaan balleessuu ti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Worri seera lakkisu nama hamaa leellisa;","poem":1},{"text":"worri seera eegatanu ammoo isaaniin morma.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nami hamaan haqa hin beeku;","poem":1},{"text":"worri Mootii Waan Maraa barbaadatu ammoo","poem":2},{"lineBreak":true},{"text":"guutumaa guutu'utti haqa beekan.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dureessa ideensi isaa micciirama'aatii mannaa,","poem":1},{"text":"hiyyeessa komii hin qanne woyya.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ka seera eegu ilma qalbeeffata'a;","poem":1},{"text":"ka gadhitoo woliin jaalomu ammoo","poem":2},{"lineBreak":true},{"text":"abbaa ifii salphisa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nami liqaa dhala gudda'aatiin qabeenna ede'atu,","poem":1},{"text":"nama hiyyeessaa nawuuf hin kuusa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nama seeraaf hin ajajanne,","poem":1},{"text":"daadimati isaatuu akka malee hin jibbisiisa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nami nama qajeelaa karaa hama'atti geessu,","poem":1},{"text":"boolla ifumaa qote keessa hin bu'a;","poem":2},{"lineBreak":true},{"text":"nami komii hin qanne ammoo","poem":2},{"lineBreak":true},{"text":"waan dansaa hin dhaala.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nami dureessi qaroo ifi seya;","poem":1},{"text":"hiyyeessi hubantii qabu ammoo","poem":2},{"lineBreak":true},{"text":"qorqoree keessa isaa hin beeka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nami balchaan yennaa injifatu,","poem":1},{"text":"martinuu hin gammadan;","poem":2},{"lineBreak":true},{"text":"nami hamaan yennaa baallii qabatu ammoo","poem":2},{"lineBreak":true},{"text":"namooti hin dhokatan.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nami cubbuu ifii dhoffatu,","poem":1},{"text":"hin milkowu;","poem":2},{"lineBreak":true},{"text":"nami cubbuu ifii faaci'atuu fi ka isii lakkisu ammoo","poem":2},{"lineBreak":true},{"text":"marartii hin dhaggata.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nami yennaa mara Mootii Waan Maraa sodaatu","poem":1},{"text":"ka gammade;","poem":2},{"lineBreak":true},{"text":"nami mataa jabaatu ammoo rakkinna keessa gala.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bulchaan hamaan worra qarqaarsa hin qanne irratti","poem":1},{"text":"akka neenqa dhangaa dhowuu","poem":2},{"lineBreak":true},{"text":"yookiin akka doobbaa hiixatee woy qabuu ti.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bulchaan hubantii hin qanne","poem":1},{"text":"akka malee nama cunqursa.","poem":2},{"text":"Ka bu'aa haqa hin te'in jibbu ammoo","poem":1},{"text":"bara dheeraa hin le'a.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nami nama ijjeese,","poem":1},{"text":"haga du'utti baqataa hin le'a;","poem":2},{"lineBreak":true},{"text":"nami tokkolle isa hin qarqaarin.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nami komii hin qanne waan hantuu irra hin bu'u;","poem":1},{"text":"nami micciiramaan ammoo dedhuma jiga.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nami lafa qotatu sagalee bacaa hin qabaata;","poem":1},{"text":"nami waan bu'aa hin qanne hordofu ammoo hin deega.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nami addatamaan guddoo hin eebbifama;","poem":1},{"text":"nami durumma'aaf ariifatu ammoo","poem":2},{"lineBreak":true},{"text":"adoo hin adabamin hin hafu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nama wol caalchisuun dansa'aa moti;","poem":1},{"text":"garuu nami bixee daabbo'oo takkatti'iif jedhee","poem":2},{"lineBreak":true},{"text":"dokonkora huja.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nami donni duroomiisaaf ariifata;","poem":1},{"text":"hiyyuun akka isa eegattu hin beeku.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nama afaaniin nama kookkisu caalaa,","poem":1},{"text":"ka balleessaa namatti himee nama xixutti","poem":2},{"lineBreak":true},{"text":"dhuma irratti saadama.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nami abbaa ifii yookiin haadha ifii saamee,","poem":1},{"text":"«Kun dokonkoraa moti» jedhu,","poem":2},{"lineBreak":true},{"text":"inni jaala nama woy balleessuu ti.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nami joljolaan lola kakkaasa;","poem":1},{"text":"nami Mootii Waan Maraatitti addatu ammoo","poem":2},{"lineBreak":true},{"text":"hin milkowa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nami ifitti addatu gowwa'a;","poem":1},{"text":"nami qarumma'aan deddeebi'u","poem":2},{"lineBreak":true},{"text":"ammoo waan hantuu irra hin bu'u.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nami hiyyeessaaf kennu womaa hin dhabu;","poem":1},{"text":"nami hiyyeessa ilaalee lakkisu ammoo","poem":2},{"lineBreak":true},{"text":"abaarsa hedduu fudhata.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Yennaa namooti hamooleen baallii fudhatanu,","poem":1},{"text":"kolbaan hin dhokatti;","poem":2},{"lineBreak":true},{"text":"yennaa isaan badanu ammoo","poem":2},{"lineBreak":true},{"text":"balchooti hin bacatti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}