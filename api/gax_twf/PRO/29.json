{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"text":"Nami yennaa hedduu xixameen duuba didee mataa jabaatu,","poem":1},{"text":"cannana fayyuu hin dandeenne dedhuma caba.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Balchooti yennaa baallii fudhatanu,","poem":1},{"text":"kolbaan guddoo gammadi;","poem":2},{"lineBreak":true},{"text":"yennaa nami hamaan bulchu","poem":2},{"lineBreak":true},{"text":"ammoo kolbaan hin aaddi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nami qarummaa jaalatu,","poem":1},{"text":"abbaa ifii gammachiisa;","poem":2},{"lineBreak":true},{"text":"nami jaala sagaagaltu'uu te'u ammoo","poem":2},{"lineBreak":true},{"text":"qabeenna ifii bittinneessa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mootiin haqa muriisaan biyya ifii hin jabeessa;","poem":1},{"text":"ka safuu fudhatiisaaf joljolu ammoo","poem":2},{"lineBreak":true},{"text":"biyya ifii hin balleessa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nami afaan calla'aan nama kookkisu,","poem":1},{"text":"fonxoroo miila ifiititti afa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nami hamaan cubbuu ifiitiin qabama;","poem":1},{"text":"nami balchaan ammoo hin faarfata;","poem":2},{"lineBreak":true},{"text":"hin gammadalle'e.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nami balchaan marroo haqa hiyyeessaatiif hin haajama;","poem":1},{"text":"Nami hamaan ammoo haajaa hin qabu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Namooti namatti murganu qachaa jeeqan;","poem":1},{"text":"namooti qaroon ammoo aarii qabbaneessan.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nami qaroon nama gowwaa woliin gara seeraa yoo dhaqe,","poem":1},{"text":"gowwaan sun hin mufata","poem":2},{"lineBreak":true},{"text":"yookiin hin murga;","poem":2},{"lineBreak":true},{"text":"nageennille hin jiraatu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Namooti dhiiga namaa dhangalaasanu,","poem":1},{"text":"nama dhugaammessa jibban;","poem":2},{"lineBreak":true},{"text":"nama qajeelaa ijjeesuu barbaadan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nami gowwaan yaada aarii ifii mara dubbata;","poem":1},{"text":"nami qaroon ammoo ossaan ifi qabataa dubbata.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bulchaan tokko oduu dharaa yoo caqase,","poem":1},{"text":"qondaaltoti isaa martinuu hamoolee hin te'an.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mootiin Waan Maraa isaan lamaaniifuu ila waan kenneef,","poem":1},{"text":"hiyyeessii fi ka hiyyeessa cunqursulle tanaan woluma qixxe'e.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mootiin hiyyeessaaf haqaan yoo mure,","poem":1},{"text":"barcumaan mootummaa isaa","poem":2},{"lineBreak":true},{"text":"bara dheeraa jabaatee hin dhaabbata.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ijoollee xixanee adabuun qarummaa kennitiif;","poem":1},{"text":"ijoolleen gad lakkifante ammoo haadha ifii qaanessiti.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yennaa worri hamooleen baallii fudhatanu","poem":1},{"text":"cubbuun hin bacatti;","poem":2},{"lineBreak":true},{"text":"balchooti ammoo jinnana isaanii hin dhaggan.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ijoollee teeti adabi;","poem":1},{"text":"isaan foora si'iif hin kennan;","poem":2},{"lineBreak":true},{"text":"gadhaa keetille hin gammachiisan.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Addee mudhiin hin jirre,","poem":1},{"text":"kolbaan seera malee teeti;","poem":2},{"lineBreak":true},{"text":"nami seera eegatu ammoo ka gammade.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tajaajilaan afaan calla'aan hin adabatu;","poem":1},{"text":"inni yoo hubateeyyuu deebii hin kennu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nama dubbii ariifatu dhaggitaa?","poem":1},{"text":"Isa caalaa nama gowwa'atti addii qaba.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nami tajaajilaa ifii ijoollummaa isaatii jalqabee qananiisu,","poem":1},{"text":"dhuma irratti gadda ifitti fida.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nami aarameessi lola kaasa;","poem":1},{"text":"nami dafee mufatu cubbuu hedduu huja.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nami ol ifi qabu salphinna ifitti fida;","poem":1},{"text":"nami gad ifi qabu ammoo ulfinna dhaggata.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nami jaala hattu'uu te'u ifi jibba;","poem":1},{"text":"kakatee dhugaa akka bayuuf hin gaafatama;","poem":2},{"lineBreak":true},{"text":"dhugaa bayiisaaf ammoo inni itti hin gamu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nama sodaatiis tiyyoo keessa nama seensisa;","poem":1},{"text":"nami Mootii Waan Maraatitti addatu ammoo nageyaan le'a.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Namooti hedduun bulchaa duratti","poem":1},{"text":"fudhatama dhaggatiisa barbaadan.","poem":2},{"text":"Nami ammoo muraa haqaa","poem":1},{"text":"Mootii Waan Maraa biraa dhaggata.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nami balchaan nama hamaa jibba;","poem":1},{"text":"nami hamaalle nama qajeelaa jibba.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/28.json","previousChapterAudioLinks":{},"numberOfVerses":27}