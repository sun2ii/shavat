{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":3,"content":[{"type":"heading","content":["Gorsa Dargaggootaaf Kenname"]},{"type":"verse","number":1,"content":[{"text":"Ilma kiyya, waan ani si barsiisu hin dedhin;","poem":1},{"text":"ajajoota kiyya gadha'atti qabadhu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isaan guyyoota sii ede'anee,","poem":1},{"text":"woggoota hedduu si leesisan;","poem":2},{"lineBreak":true},{"text":"qananumma'aa fi nageya sii kennan.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mararti'ii fi addatamummaa ijjumaa hin lakkisin;","poem":1},{"text":"morma keetitti hidhadhu;","poem":2},{"lineBreak":true},{"text":"gadhaa keeti keessatti qabadhu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Achiin duuba ati Waaqaa fi nama duratti","poem":1},{"text":"fudhatamaa fi maqaa dansaa hin dhaggatta.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gadhaa tokkochaan Mootii Waan Maraatitti addadhu;","poem":1},{"text":"hubantii teetitti hin irkatin.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Karaa keeti maraan isa beeki;","poem":1},{"text":"inni daandii teeti si'iif hin qajeelcha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"«Ani qaro'o!» ifiin hin jedhin;","poem":1},{"text":"Mootii Waan Maraa sodaadhu;","poem":2},{"lineBreak":true},{"text":"waan hantuu irraa fagaadhu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kun nafa keetiif fayyaa,","poem":1},{"text":"lafee teetiifille jabeenna hin te'a.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Qabeenna keetiin,","poem":1},{"text":"midhaan keeti mara keessaa mataa kenniisaan,","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraatiif ulfinna kenni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Achiin duuba gootaraan keeti","poem":1},{"text":"midhaaniin hin guutama;","poem":2},{"lineBreak":true},{"text":"daadhiin teeti waabaa guutantee irra hin danbalaati.","poem":2}]},{"type":"verse","number":11,"content":["Ilma kiyya, qajeelcha Mootii Waan Maraa hin tuffatin;",{"text":"xixicha isaalle hin jibbin.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abbaan ilma itti gammadu akkuma qajeelchu,","poem":1},{"text":"Mootiin Waan Maraalle nama jaalatu qajeelcha.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nami qarummaa dhaggatu,","poem":1},{"text":"ka hubantii qabu ka gammade.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Qarummaan meetii caalaa bu'aa qaddi;","poem":1},{"text":"worqii caalaalle fayyaddi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Qarummaan dooqa gatii guddo'oo caalaa gatii qaddi;","poem":1},{"text":"waan ati halchitu keessaa ka isi'iin qixxawu hin jiru.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Harka isi'ii middicha keessa","poem":1},{"text":"jiruu dheertu'utti jira;","poem":2},{"lineBreak":true},{"text":"harka isi'ii bitaacha keessa","poem":2},{"lineBreak":true},{"text":"durumma'aa fi ulfinnatti jira.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Karaan isi'ii karaa gammadaa ti;","poem":1},{"text":"daandiin isi'ii daandii nageyaa ti.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Isiin worra jabeessee isii qabateef,","poem":1},{"text":"muka jiru'uu ti;","poem":2},{"lineBreak":true},{"text":"worri jabeessee isii qabate hin gammada.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mootiin Waan Maraa qarummaa ifiitiin lafa dade;","poem":1},{"text":"hubantii ifiitiin ol-gubbaa jabeessee dhaabe.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Beekkumsa isaatiin","poem":1},{"text":"qileen abbaayotaa gargar dayyaate,","poem":2},{"lineBreak":true},{"text":"duumensille tiifuu tiife.","poem":2}]},{"type":"verse","number":21,"content":["Ilma kiyya, qarumma'aa fi qalbeeffata jabeessii qabadhu;",{"text":"isaan ila teeti duraa hin gorin.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Isaan si'iif jiruu,","poem":1},{"text":"morma keetiifille seesa hin te'an.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Achiin duuba ati nageyaan","poem":1},{"text":"karaa keeti hin deenta;","poem":2},{"lineBreak":true},{"text":"miilli keetille hin gufatu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yennaa irkattu hin sodaattu;","poem":1},{"text":"yennaa rattulle","poem":2},{"lineBreak":true},{"text":"hirriibi keeti mi'owaa hin te'a.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yennaa balaan","poem":1},{"text":"dedhuma worra hamaa irra dhaqqabu,","poem":2},{"lineBreak":true},{"text":"ati hin sodaattu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mootiin Waan Maraa addii waan sii te'uuf,","poem":1},{"text":"miila keeti tiyyoo irraa hin eega.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Worra wonni dansaan malteef,","poem":1},{"text":"waan dansaa godhiisaaf adoo dandeettuu,","poem":2},{"lineBreak":true},{"text":"waan dansaan godhiisa hin lakkisin.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Adoo harkaa qadduu, «Boru sii kennaatii,","poem":1},{"text":"deebi'ii koy!» namaan hin jedhin.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Nama si addatee si bira tee'u irratti","poem":1},{"text":"waan hantuu hin yaadin.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Adoo nami si hin miidhin,","poem":1},{"text":"akkasumaan nama hin himatin.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Nama hunnaan nama irratti ka'u hin halchin;","poem":1},{"text":"karaa isaa tokkolle hin filatin.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Sababille Mootiin Waan Maraa","poem":1},{"text":"nama micciiramaa jibba;","poem":2},{"lineBreak":true},{"text":"nama qajeelaa ammoo guddoo jaalata.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"mana worra hama'aa hin abaara;","poem":2},{"lineBreak":true},{"text":"mana worra balcha'aa ammoo hin eebbisa.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Mootiin Waan Maraa worra murgutti hin murga;","poem":1},{"text":"worra gad ifi qabuuf badhaadha hin kenna.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Worri qarooleen ulfinna hin dhaggatan;","poem":1},{"text":"worri gowwooleen ammoo hin salphatan.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}