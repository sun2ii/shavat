{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":30,"content":[{"type":"heading","content":["Jecha Aguurii Ilma Yaaqee"]},{"type":"verse","number":1,"content":[{"text":"Jechi kun jecha Aguurii ilma Yaaqee ti;","poem":1},{"text":"nami kun Itii'elitti,","poem":2},{"lineBreak":true},{"text":"Itii'elii fi Ukaalitti dubbate,","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«Ani nama mara caalaa daafana'a;","poem":2},{"lineBreak":true},{"text":"hubantii nami qabu ani hin qabu;","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ani qarummaa tokkolle hin baranne;","poem":2},{"lineBreak":true},{"text":"ani marroo Waaqa Woyyichaalle womaa hin beeku.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ka gara ol-gubba'aa ol dhaqee gad deebi'ee dhufe eennu?","poem":1},{"text":"Ka qilleensa harka ifiitiin wolitti qabe eennu?","poem":2},{"text":"Ka bisaan woyaa ifiitiin mare eennu?","poem":1},{"text":"Ka qaccee lafaa mara jabeessee dhaabe eennu?","poem":2},{"text":"Maqaan isaa eennu? Maqaan ilma isaa eennu?","poem":1},{"text":"Ati yoo beettu teete,","poem":2},{"lineBreak":true},{"text":"natti himi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Jechi Waaqaa marti dhuga'a;","poem":1},{"text":"inni worra gara isaa baqate maraaf wonte'e.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Jecha isaa irratti hin ede'in;","poem":1},{"text":"yoo akkas hin te'in inni si xixa;","poem":2},{"lineBreak":true},{"text":"dharaamessalle teetee hin dhagganta» jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Ee Mootii Waan Maraa,","poem":1},{"text":"ani waan lama si kadhadha;","poem":2},{"lineBreak":true},{"text":"adoo ani hin du'in","poem":2},{"lineBreak":true},{"text":"waan kana lamaan na hin dhooggatin.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sobaa fi dhara dubbatiisa na irraa fageessi;","poem":1},{"text":"sagalee guyyuma guyya'aan naa barbaachittu naaf kenni malee,","poem":2},{"lineBreak":true},{"text":"durumma'aa fi hiyyummaalle naa hin kennin.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yoo akkas hin te'in,","poem":1},{"text":"ani quufee si hin mormadha;","poem":2},{"text":"‹Mootiin Waan Maraa eennu inni?› si'iin hin jedha;","poem":1},{"text":"yookiin hiyyoommadhee,","poem":2},{"lineBreak":true},{"text":"hatee maqaa Waaqa kiyyaa, maqaa keeti hin salphisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Tajaajilaan akka si hin abaarre,","poem":1},{"text":"atille akka hin rakkanne,","poem":2},{"lineBreak":true},{"text":"marroo tajaajilaa tokkoo","poem":2},{"lineBreak":true},{"text":"goottaa isaatitti isa hin hamatin.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Namooti abbaa ifii abaaranu,","poem":1},{"text":"haadha ifiille ka hin saadanne jiran.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Worri qulluu ifi seyanee,","poem":1},{"text":"ka battummaa ifii","poem":2},{"lineBreak":true},{"text":"irraa hin qulqulloomin hin jiran.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Worri ilaalcha kooraa qabanu,","poem":1},{"text":"ka ila tuffi'iitiin nama ilaalanu,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"hiyyeessa lafa irraa,","poem":2},{"lineBreak":true},{"text":"rakkataa odduu ilmaan namaatii","poem":2},{"lineBreak":true},{"text":"nyaatanee balleessiisaaf,","poem":2},{"lineBreak":true},{"text":"worri ilkaan isaanii shallaagaa,","poem":2},{"lineBreak":true},{"text":"a'oon isaaniille billowa te'e jiran.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«Ulaa'ulti ijoollee durraa","poem":1},{"text":"ta, ‹Kenni! Kenni!›","poem":2},{"lineBreak":true},{"text":"jedhaa iyyitu lama qaddi;","poem":2},{"text":"‹Ijjumaa quufe› ka hin jenne","poem":1},{"text":"waan saditti jira;","poem":2},{"lineBreak":true},{"text":"ta arfeesso'oolle ijjumaa ‹Na geye›","poem":2},{"lineBreak":true},{"text":"hin jettu:","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"isaanille, addee worri du'e jiru,","poem":2},{"lineBreak":true},{"text":"gadaamessa maseena,","poem":2},{"lineBreak":true},{"text":"lafa bisaan hin quunnee fi","poem":2},{"lineBreak":true},{"text":"ibidda ijjumaa, ‹Na geye› hin jenne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«Nama abbaa ifiititti murguu fi","poem":1},{"text":"ajaja haadha ifiille tuffatu,","poem":2},{"lineBreak":true},{"text":"harraaqessi gammoojji'ii ila isaa","poem":2},{"lineBreak":true},{"text":"isa keessaa hin fuudha;","poem":2},{"lineBreak":true},{"text":"rumichille isa hin nyaata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«Wonni na baaseffachiisu sad yookiin","poem":1},{"text":"afur ta hubatiisa hin dandeennetti jiraayyu;","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"isaanille, karaa risa'aa ka gubbaa irraa,","poem":2},{"lineBreak":true},{"text":"karaa bofaa ka rassaa irraa,","poem":2},{"lineBreak":true},{"text":"karaa hobolo'oo ka abbaayaa irraatii fi","poem":2},{"lineBreak":true},{"text":"karaa dhiirtii fi dubartiin wol jaalatanu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«Karaan dubartii gaarayyeeffattu'uu kana:","poem":1},{"text":"Isiin nyaattee afaan ifii haxowattee,","poem":2},{"lineBreak":true},{"text":"‹Ani womaa dokonkora hin hunye› jetti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«Latti waan sadiiniin yookiin afuriin tachooti;","poem":1},{"text":"dandeetteelle hin ba'attu;","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"isaanille, garbichi yennaa mootii te'e,","poem":2},{"lineBreak":true},{"text":"gowwaan yennaa quufe,","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"dubartiin jibbatante yennaa dhirsa dhaggattee fi","poem":2},{"lineBreak":true},{"text":"garbittiin yennaa addee giittii ifii fudhate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"«Wonni didiqqoon afur,","poem":1},{"text":"ka guddoo qaroo te'an biyya lafaa irra jiran:","poem":2}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"mixaan hunna hin qabu,","poem":2},{"lineBreak":true},{"text":"te'uu malee sagalee ifii bona wolitti qabata;","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Osoleen hunnaa hin qaddu,","poem":1},{"text":"te'uu malee odduu rassa'aatitti galti;","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Awwaannisi mootii hin qabu,","poem":1},{"text":"te'uu malee akka loltootaa seeraan ideema.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Qarcoon","poem":1},{"noteId":1},{"text":"harkaan qabamuu dandeetti;","poem":1},{"text":"te'uu malee mana mootumma'aa keessatti dhagganti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"«Wonni ideensa tolanu sad yookiin afur","poem":1},{"text":"ka arnya ulfinnaa qabanu jiran:","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Neenqa bineensota mara keessaa jaba'aa,","poem":1},{"text":"ka waan mara irraa duubatti hin deebine;","poem":2}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"kormi lukku'uutii fi","poem":2},{"lineBreak":true},{"text":"korbeessi re'e'ee ka bondhooranu,","poem":2},{"lineBreak":true},{"text":"mootii loltoota ifiitiin marfamee ideemu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"«Gowwaa teetee, yoo ol ol ifi qadde,","poem":1},{"text":"yookiin hantuu yoo yaadatte,","poem":2},{"lineBreak":true},{"text":"afaan keeti qabadhu.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Akkuma aanan raasiis dhadhaa baasu,","poem":1},{"text":"akkuma funnaan micciiriis dhiiga baasu,","poem":2},{"lineBreak":true},{"text":"tuttuqanee nama aarsuun lola kaasa» jedhe.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Qarcoon: Lafa tokko tokkotti lootuu jedhanti.","reference":{"chapter":30,"verse":28}}]},"thisChapterLink":"/api/gax_twf/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}