{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":31,"content":[{"type":"heading","content":["Gorsa Mootichaaf Kenname"]},{"type":"verse","number":1,"content":["Jechi asii gadii kun ka haati Lemu'elii mootichaa isa barsiitte:"]},{"type":"verse","number":2,"content":[{"text":"«Ee ilma kiyya,","poem":1},{"text":"ilma gadaamessa kiyyaa,","poem":2},{"lineBreak":true},{"text":"ilma Waadaa kiyyaa,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"hunna teeti dubartoota irratti hin fixin;","poem":2},{"lineBreak":true},{"text":"yennaa teetille dubartoota mootota balleessitu irratti hin fixin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Ee Lemu'el, moototi daadhii woyni'ii unuu hin qabanu;","poem":1},{"text":"bulchitootille untoo nama macheessitu unuu hin qabanu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isaan yoo unane,","poem":1},{"text":"seera hin dedhan;","poem":2},{"lineBreak":true},{"text":"worra cunqurfame mara haqa hin dhooggan.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Untoo nama macheessitu,","poem":1},{"text":"nama badiisatti jiruuf,","poem":2},{"lineBreak":true},{"text":"daadhii woyni'iille nama farra hantuu keessa jiruuf kenni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Isaan unanee hiyyummaa ifii dedhanuu ti;","poem":1},{"text":"farra ifiille deebi'anee hin qaabatin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Ati worra ifiif dubbatuu hin dandeenneef dubbadhu;","poem":1},{"text":"worra qarqaarsa hin qanne maraaf falmadhu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dubbadhu;","poem":1},{"text":"dhugaa muri.","poem":2},{"text":"Haqa hiyyeessaatii fi","poem":1},{"text":"rakkata'aatiif falmadhu» jette.","poem":2}]},{"type":"heading","content":["Niitii Amala Dansaa qaddu"]},{"type":"verse","number":10,"content":[{"text":"Niitii qalbii qaddu eentu dhaggatuu dande'a?","poem":1},{"text":"Isiin dooqa diimaa caalti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dhirsi isi'ii gadhaa tokkochaan isii addata;","poem":1},{"text":"Inni waan tokkolle hin dhabu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bara jiruu isi'ii mara waan dansaa isaaf gooti malee,","poem":1},{"text":"waan hantuu isa irratti hin hujju.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Isiin rifeensa hoole'eetii fi quncee talba'aa barbaaddee,","poem":1},{"text":"harka ifiitiin woyaa dhootti.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Isiin akkuma hoboloota gugurdoo daldaltootaa,","poem":1},{"text":"biyya fago'oo irraa sagalee fiddi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Isiin ganama adoo latti hin bari'in kaatee,","poem":1},{"text":"maatii ifiitiif sagalee kenniti;","poem":2},{"lineBreak":true},{"text":"durra tajaajiltoota ifiitiifille","poem":2},{"lineBreak":true},{"text":"hujii isaanii itti qooddi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Isiin fichaa qorqortee bitatti;","poem":1},{"text":"bu'aa hujii harka ifiitiin","poem":2},{"lineBreak":true},{"text":"muka woyni'ii dhaabbatti.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Isiin hunnaan hujii ifii hujatti;","poem":1},{"text":"irreen isi'iille huji'iif jaddu'u.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hujiin isi'ii bu'aa akka qaddu hin beetti;","poem":1},{"text":"issaan isi'iille halkan hin dhaamu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Harka ifiitiin fuuttaa qabatti.","poem":1},{"text":"Quba ifiitiin liqaaqaa irbiti.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Isiin hiyyeessaaf hin kenniti;","poem":1},{"text":"rakkataalle hin qarqaarti.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Maatiin isi'ii martinuu","poem":1},{"text":"woyaa qorra nama irraa dhooggitu waan qabanuuf,","poem":2},{"lineBreak":true},{"text":"yennaa rooba dhaka'aa isaaniif hin yaaddottu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Isiin woyaa taqee ifii irra afattu dhowatti;","poem":1},{"text":"isiin woyaa dansaa quncee talba'aa irraa hujantee fi","poem":2},{"lineBreak":true},{"text":"woyaa dhiillee uffatti.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Dhirsi isi'ii jaarsolee biyyaa odduu,","poem":1},{"text":"badhinna karra qacha'aa yennaa tee'u ulfinna qaba.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Isiin quncee talba'aa irraa woyaa dhoottee gurgurti;","poem":1},{"text":"daldaltootaafille hiituu gurgurti.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Isiin hunnaa fi ulfinna akka woya'aa uffatti;","poem":1},{"text":"bara dhufaaru itti gammaddi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Isiin qarumma'aan dubbatti;","poem":1},{"text":"afaan isi'ii keessa barsiisa dansa'atti jira.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Isiin jireenna maatii ifii akka dansaa eeddi;","poem":1},{"text":"isiin booseyaa moti.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ijoolleen isi'ii lafaa kaatee,","poem":1},{"text":"«Gammadee» jettee isii waanti;","poem":2},{"lineBreak":true},{"text":"abbaan manaa isi'iille akkasuma jedhaa, isii leellisaa,","poem":2}]},{"type":"verse","number":29,"content":[{"text":"«Dubartooti hedduun waan dansaa hujaneeran;","poem":1},{"text":"ati ammoo isaan mara hin caalta» jedhaan.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Miidhagiis nama soba;","poem":1},{"text":"dansummaan hin baddi;","poem":2},{"lineBreak":true},{"text":"dubartiin Mootii Waan Maraa sodaattu ammoo hin leellifanti.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Bu'aa hujii isi'iitiif badhaasa kenna'aaf!","poem":1},{"text":"Hujiin isi'ii badhinna karra","poem":2},{"lineBreak":true},{"text":"qacha'aatitti isii leellittuu ti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}