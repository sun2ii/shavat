{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":4,"content":[{"type":"heading","content":["Bu'aa Qarummaa Irraa Dhaggamu"]},{"type":"verse","number":1,"content":[{"text":"Ilmaan tiyya, gorsa abbaa keessanii caqasa'a;","poem":1},{"text":"itti xiyyeeffadha'aatii,","poem":2},{"lineBreak":true},{"text":"hubantii dhaggadha'a.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ani barsiisa kiyya dansaa isiniif kenna;","poem":1},{"text":"maarre isin barsiisa kiyya hin lakkisina'a.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yennaa ani mana abbaa kiyyaatitti mucaa diqqa'aa,","poem":1},{"text":"haadha tiyyaaf ilma tokkochaa san,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"abbaan kiyya na barsiisee,","poem":2},{"lineBreak":true},{"text":"«Jecha kiyya mara","poem":2},{"lineBreak":true},{"text":"gadhaa tokkochaan qabadhu;","poem":2},{"lineBreak":true},{"text":"hin leetaa,","poem":2},{"lineBreak":true},{"text":"ajaja kiyya eegadhu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Qarummaa dhaggadhu;","poem":1},{"text":"hubantii qabaadhu;","poem":2},{"lineBreak":true},{"text":"jecha kiyya hin dedhin","poem":2},{"lineBreak":true},{"text":"yookiin irraa hin deebi'in.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Qarummaan gollaa sii teetii,","poem":1},{"text":"isii hin dedhin;","poem":2},{"lineBreak":true},{"text":"si eeddiitii,","poem":2},{"lineBreak":true},{"text":"isii jaaladhu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Qarummaan waan mara caalti;","poem":1},{"text":"tanaaf isii dhaggadhu.","poem":2},{"text":"Waan ati qaddu mara si kaffalchiittulle,","poem":1},{"text":"hubantii bitadhu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ulfinna isi'iif kenni;","poem":1},{"text":"isiille ol si qaddi;","poem":2},{"lineBreak":true},{"text":"isii hanqafadhu;","poem":2},{"lineBreak":true},{"text":"isiille ulfinna si'iif hin kenniti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isiin daraaraa seesaaf wolitti hidhame,","poem":1},{"text":"mataa keeti irra hin keetti;","poem":2},{"lineBreak":true},{"text":"kallacha dansaa si'iif hin kenniti» jedhe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ilma kiyya caqasi;","poem":1},{"text":"barri le'ii teetii akka heddatu,","poem":2},{"lineBreak":true},{"text":"jecha kiyya fudhadhu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ani karaa qarumma'aa si barsiiseera;","poem":1},{"text":"daandii qajeelaa irra","poem":2},{"lineBreak":true},{"text":"si sooresseera.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yennaa ideentu karaan sitti hin dhiphatu;","poem":1},{"text":"yennaa rukkittulle hin gufattu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gorsa sii kenname jabeessii qabadhu;","poem":1},{"text":"gad hin lakkisin;","poem":2},{"lineBreak":true},{"text":"jiruu teeti waan te'eef,","poem":2},{"lineBreak":true},{"text":"midhassii eegadhu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Daandii worra hama'aa hin hordofin","poem":1},{"text":"yookiin karaa worra hantuu hujuu irra hin deemin.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Karaa san irraa fagaadhu;","poem":1},{"text":"irraa deebi'iitii,","poem":2},{"lineBreak":true},{"text":"karaa keeti deemi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Isaan haga waan hantuu godhanutti","poem":1},{"text":"dande'anee hin rafanu;","poem":2},{"lineBreak":true},{"text":"haga nama dokonkorsanutti","poem":2},{"lineBreak":true},{"text":"foora hin qabanu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Isaan sagalee hammeennaa nyaatan;","poem":1},{"text":"daadhii woyni'ii","poem":2},{"lineBreak":true},{"text":"ta hunnaan nama irratti ka'iisaa unan.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Daandiin balchoole'ee akka ifa barii ganamaa,","poem":1},{"text":"ka haga orra'aatitti","poem":2},{"lineBreak":true},{"text":"ifaatuma ideemuu ti.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Daandiin worra hama'aa ammoo","poem":1},{"text":"akka dukkana dimmaa ti;","poem":2},{"lineBreak":true},{"text":"isaan waan isaan gufachiisu hin beekanu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ilma kiyya waan ani jedhutti xiyyeeffadhu;","poem":1},{"text":"jecha kiyya midhassii caqasi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Isaan ila teeti duraa hin gorin;","poem":1},{"text":"gadhaa keeti keessatti qabadhu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Isaan worra isaan dhaggatuuf jiru'u;","poem":1},{"text":"nafa isaanii maraaf fayyinna.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Maddi jiruu teetii qalbii waan teeteef,","poem":1},{"text":"waan mara caalaa","poem":2},{"lineBreak":true},{"text":"qalbii teeti eegadhu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Dubbii micciiriisa afaan keeti irraa fageessi;","poem":1},{"text":"dubbii malaamaltumma'aa irraa","poem":2},{"lineBreak":true},{"text":"hidhii teeti eegadhu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ilti teeti gara fuula duraa","poem":1},{"text":"qajeelaa ilaaltuu ti;","poem":2},{"lineBreak":true},{"text":"ifiin dura qofa ilaali.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Daandii miilli keeti irra deemu,","poem":1},{"text":"wol qixxeeffadhu.","poem":2},{"lineBreak":true},{"text":"Karaan keeti dansaa te'uu ti.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Gara middaa yookiin gara bita'aa hin gorin;","poem":1},{"text":"miila keeti waan hantuu irraa eegadhu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}