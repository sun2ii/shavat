{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":5,"content":[{"type":"heading","content":["Gaarayyeeffatiisa Irraa Fagaatiisa"]},{"type":"verse","number":1,"content":[{"text":"Ilma kiyya, qarummaa tiyyatti xiyyeeffadhu;","poem":1},{"text":"gara hubantii tiyyaa gurra keeti deebifadhu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yoo tana goote waan hantu'uu fi","poem":1},{"text":"dansaa gargar hin baafatta;","poem":2},{"lineBreak":true},{"text":"dubbiin teetille beekkumsa hin mudhitti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hidhiin dubartii gaarayyeeffattuu nadhii coccossiti;","poem":1},{"text":"dubbiin isi'ii zayitii caalaa lallaatti;","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"dhuma irratti ammoo akka hargiisaa hadhootti;","poem":2},{"lineBreak":true},{"text":"akka shallaagaa qara lamaa","poem":2},{"lineBreak":true},{"text":"qara qaddi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Miilli isi'ii gara du'aa deema;","poem":1},{"text":"ijjati isi'ii daandii","poem":2},{"lineBreak":true},{"text":"gara addee worri du'e jiru geessa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isiin karaa jiru'uu hin yaadattu;","poem":1},{"text":"karaan isi'ii daddaba'a;","poem":2},{"lineBreak":true},{"text":"ammoo isi'itti hin beekkamu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Amma ilmaan tiyya,","poem":1},{"text":"na caqasa'a;","poem":2},{"lineBreak":true},{"text":"jecha afaan kiyyaa irraa hin gorina'a.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Karaa keeti isii irraa fageessi;","poem":1},{"text":"qarqara balbala mana isi'iititti hin dhikaatin.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yoo tana godhuu dhabaatte,","poem":1},{"text":"ulfinna keeti namoota dhibi'iif,","poem":2},{"lineBreak":true},{"text":"jiruu teetiille","poem":2},{"lineBreak":true},{"text":"nama marartii hin qannetti hin kennita.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Karra teetille alagaan hin fudhata;","poem":1},{"text":"eloon teetille mana ormaa hin duroonsiti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Foon keetii fi nafi keeti yennaa dhumate,","poem":1},{"text":"muummee jiruu teetiititti hin aadda;","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ati, «Hayii, ani maaf gorsa jibbe?","poem":2},{"lineBreak":true},{"text":"Gadhaan kiyya maaf qajeelfama tuffate?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ani barsiisota tiyya hin caqanne;","poem":1},{"text":"gurra kiyya gara worra na gorsuu hin deebifanne.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wolde'a kolba'aa duudii keessatti,","poem":1},{"text":"badii guddoo biraan baye» hin jetta.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Niitii teeti akkuma boolluma bisaanii keetii fi","poem":1},{"text":"baleessuma keetii, achuma keessaa uni.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Maddi keeti diidatti,","poem":1},{"text":"bisaan lagaa keeti","poem":2},{"lineBreak":true},{"text":"karaa keessatti dhangala'uu qabaa ree?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Isaan si qofaaf te'anuu ti;","poem":1},{"text":"alagaa woliin hin qoodamin.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Maddi keeti ka eebbifame te'uu ti;","poem":1},{"text":"niitii teeti ta qeedhumma'aan fuute woliin firinxiixi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Isiin jaalatantuu akka gadansaa,","poem":1},{"text":"biifa qabeettii","poem":2},{"lineBreak":true},{"text":"akka jiliba'aa","poem":2},{"lineBreak":true},{"text":"sii teetuu ti.","poem":2},{"text":"Harmi isi'ii yennaa mara","poem":1},{"text":"dheebuu si baasuu ti;","poem":2},{"lineBreak":true},{"text":"jaalala isi'iitiin","poem":2},{"lineBreak":true},{"text":"yennaa mara machowi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ilma kiyya,","poem":1},{"text":"maaf dubartii gaarayyeeffattu'uun machootta?","poem":2},{"lineBreak":true},{"text":"Maaniif qoma dubartii nama dhibi'ii hanqafatta?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hujiin namaa Mootiin Waan Maraa duratti ifa;","poem":1},{"text":"inni daandii namaa mara dhagga.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nami hamaan hujuma ifiitiin tiyyoo seena;","poem":1},{"text":"cubbuma ifiitiin qabama.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Inni qajeelfama waan dhabeef du'a;","poem":1},{"text":"gowwummaa guddoo ifiitiin","poem":2},{"lineBreak":true},{"text":"karaa irraa miliqa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}