{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":6,"content":[{"type":"heading","content":["Gowwummaa Irraa Ifi Eeggatiisa"]},{"type":"verse","number":1,"content":[{"text":"Ilma kiyya, namaaf wobii yoo teete,","poem":1},{"text":"marroo nama dhibi'iitiif","poem":2},{"lineBreak":true},{"text":"harka wol dhowatiisaan","poem":2},{"lineBreak":true},{"text":"waadaa yoo galte,","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"woma dubbatteen tiyyoo yoo seente,","poem":2},{"lineBreak":true},{"text":"jechuma afaan keetii bayeen yoo qabante,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ilma kiyya, harka nama sanii waan seenteef,","poem":2},{"lineBreak":true},{"text":"ifi baasiisaaf,","poem":2},{"lineBreak":true},{"text":"gara nama sanii dhaqiitii,","poem":2},{"lineBreak":true},{"text":"gad ifi qabi;","poem":2},{"lineBreak":true},{"text":"akka inni wobummaa san si irraa buusuuf","poem":2},{"lineBreak":true},{"text":"isa gaafadhu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Adoo tana hin godhin hin rafin;","poem":1},{"text":"hirriibi ila teeti irra hin marin.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Akka gadansi worra adansu jalaa,","poem":1},{"text":"sinbirreen tiyyoo jalaa miliqanu,","poem":2},{"lineBreak":true},{"text":"atille ifi baasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ati namicha booseya,","poem":1},{"text":"me dhaqiitii mixaa dhukkulle ilaali;","poem":2},{"lineBreak":true},{"text":"mala isaa ilaaliitii qaroo te'i.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Isaan sooressa,","poem":1},{"text":"toowataa yookiin bulchaa hin qabanu;","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"te'uu malee sagalee ifii ta bonaa,","poem":2},{"lineBreak":true},{"text":"waan isaaniif barbaachisu","poem":2},{"lineBreak":true},{"text":"yennaa midhaan galu keessa wolitti qabatan.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ati namichi boosenni","poem":1},{"text":"haga yoomii achi ratta?","poem":2},{"lineBreak":true},{"text":"Ati yoom hirriibaa kaata?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ati diqqoo adoo rattuu,","poem":1},{"text":"diqqoo adoo mudduu,","poem":2},{"lineBreak":true},{"text":"foorfatiisaafille","poem":2},{"lineBreak":true},{"text":"diqqoo adoo harka wol irra naqattuu,","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"hiyyummaan akka saantu'uu,","poem":2},{"lineBreak":true},{"text":"akka nama meya woraanaa hidhatee,","poem":2},{"lineBreak":true},{"text":"sitti hin dhufa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nami gadhe'ee fi nami hamaan,","poem":1},{"text":"ka dubbii micciiraa asii fi achi deemu,","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ka ilaan qiphifatu,","poem":2},{"lineBreak":true},{"text":"ka miilaan beessisa kennu,","poem":2},{"lineBreak":true},{"text":"ka qubaan akeeku,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ka gadhaa ifii keessatti","poem":2},{"lineBreak":true},{"text":"mala hamaa dhowu,","poem":2},{"lineBreak":true},{"text":"yennaa mara lola kaasa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tanaaf balaan dedhuma isatti hin bu'a;","poem":1},{"text":"yoosuma cabiisa hin fayyine caba.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wonni jaa ta Mootiin Waan Maraa jibbu,","poem":1},{"text":"torbeessoon ta inni dhiqatu jiran;","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"isaan kun ila tuffi'ii,","poem":2},{"lineBreak":true},{"text":"arraba dharaa,","poem":2},{"lineBreak":true},{"text":"harka dhiiga worra yakkaa hin qannee dhangalaasu,","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"gadhaa waan hantuu yaadu,","poem":2},{"lineBreak":true},{"text":"miila gara waan hantu'uu fiigu,","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"nama dharaan nama irratti dhugaa bayu,","poem":2},{"lineBreak":true},{"text":"ka obboleeyyan oddu'utti lola kakkaasu.","poem":2}]},{"type":"heading","content":["Gaarayyeeffatiisa Irraa Ifi Eeggatiisa"]},{"type":"verse","number":20,"content":[{"text":"Ilma kiyya, ajaja abbaa keetii eegadhu;","poem":1},{"text":"barsiisa haadha teetiille hin lakkisin.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yennaa mara gadhaa keeti keessa keyadhu;","poem":1},{"text":"morma keetille'etti hidhadhu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Isaan yennaa ati ideentu","poem":1},{"text":"si sooressan;","poem":2},{"lineBreak":true},{"text":"yennaa rattu si eegan;","poem":2},{"lineBreak":true},{"text":"yennaa ati dammaxxu","poem":2},{"lineBreak":true},{"text":"si'itti dubbatan.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ajaji kun issa'a;","poem":1},{"text":"barsiisi kunille ifa;","poem":2},{"lineBreak":true},{"text":"qajeelfamaan sirreeffamiis","poem":2},{"lineBreak":true},{"text":"karaa jiru'uu ti.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Dubartii hantuu irraa,","poem":1},{"text":"arraba lallaafaa dubartii","poem":2},{"lineBreak":true},{"text":"gaarayyeeffatitti'ii irraa si eega.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Gadhaa keeti keessatti","poem":1},{"text":"dansummaa isi'ii hin halchin;","poem":2},{"lineBreak":true},{"text":"ilti isi'ii si hin booji'in.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Gatiin dubartii sagaagaltitti'ii","poem":1},{"text":"haga xaltaa daabbo'oo ti;","poem":2},{"lineBreak":true},{"text":"dubartiin gaarayyeeffattuun ammoo","poem":2},{"lineBreak":true},{"text":"gatii jiruu teetii si kaffalchiitti.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nami ibidda boba'atti qabatee,","poem":1},{"text":"woyaan isaa adoo hin gubatin","poem":2},{"lineBreak":true},{"text":"hafuu dandeettu hin jiraa?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Yookiin nami kashila irra ijjatee,","poem":1},{"text":"miilli isaa adoo hin gubatin","poem":2},{"lineBreak":true},{"text":"hafuu dande'u hin jiraa?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Nami niitii namaa woliin rafulle akkasuma te'a;","poem":1},{"text":"nami niitii namaa tuqee","poem":2},{"lineBreak":true},{"text":"adoo hin adabamin hafu hin jiru.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Hattichi yennaa beelote,","poem":1},{"text":"beela ifii bayiisa qofaaf yoo hate,","poem":2},{"lineBreak":true},{"text":"nami isa hin tuffatu.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Yoo qabame ammoo,","poem":1},{"text":"qabeenna inni qabu mara gaafattulle,","poem":2},{"lineBreak":true},{"text":"dachaa torba godhee kaffalaa motii ree?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Nami gaarayyeeffatu ammoo qalbii hin qabu;","poem":1},{"text":"nami gaarayyeeffatu marti ifi balleessa.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Inni mada'aa fi salphinna hin dhaggata;","poem":1},{"text":"qaaniin ijjumaa isa irraa hin baddu.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Hinaaffaan abbaa manaa waan aarsituuf,","poem":1},{"text":"inni yennaa haluu bayu","poem":2},{"lineBreak":true},{"text":"marartii hin qabu.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Inni kaffaltii tokkolle hin fudhatu;","poem":1},{"text":"haga fedhe bacatulle,","poem":2},{"lineBreak":true},{"text":"kennansi aarii isaa hin qabbaneessu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}