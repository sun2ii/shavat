{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Ilma kiyya, jecha kiyya eegadhu;","poem":1},{"text":"ajaja kiyya gadhaa keeti keessatti qabadhu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Akka leetuuf,","poem":1},{"text":"ajaja kiyya eeggadhu;","poem":2},{"lineBreak":true},{"text":"barsiisa kiyyalle","poem":2},{"lineBreak":true},{"text":"akka gumaa ila teetii eeggadhu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Akka qube'ee quba keetitti keyadhu;","poem":1},{"text":"gadhaa keeti keessatti barreeffadhu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Qarumma'aan, «Ati obboleettii tiyya» jedhi;","poem":1},{"text":"hubantiille'een, «Ati fira kiyya» jedhii waami.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isaan dubartii gaarayyeeffattuu,","poem":1},{"text":"ta jechoota gammachiisuun","poem":2},{"lineBreak":true},{"text":"nama qaxafattu irraa si eegan.","poem":2}]},{"type":"heading","content":["Soba Dubartii Gaarayyeeffattu'uu"]},{"type":"verse","number":6,"content":[{"text":"Gaafa tokko ani karaa foddaa","poem":1},{"text":"mana kiyyaatiin ala ilaalee,","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"worra yaadaan hin bilchaatin keessaa,","poem":2},{"lineBreak":true},{"text":"dargaggoota oddu'uu,","poem":2},{"lineBreak":true},{"text":"dargaggeessa qalbii hin qanne tokko dhagge.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inni karaa cinaa mana dubartii takkaa geessu gula,","poem":1},{"text":"gara mana isi'ii ideemiisatti jiraayyu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yennaan sun aduun seentee,","poem":1},{"text":"galgala dimimmisa","poem":2},{"lineBreak":true},{"text":"halkan dukkana keessa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Achiin duuba dubartittiin gad isatti baate;","poem":1},{"text":"isiin akka sagaagaltu'uu uffattee","poem":2},{"lineBreak":true},{"text":"nama dokonkorsiisaaf mala qaddiiyyu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isiin ta ila gad hin qabanne,","poem":1},{"text":"mati-jabeetti'i;","poem":2},{"lineBreak":true},{"text":"isiin ijjumaa mana hin teettu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Takka karaa irra,","poem":1},{"text":"takka woldeennaa kara'aa irra","poem":2},{"lineBreak":true},{"text":"cinaa karaa maraa irra","poem":2},{"lineBreak":true},{"text":"dhaabbattee eeggatti.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Isiin isa qaddee,","poem":1},{"text":"sunqattee, fokkoo malee, isaan,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"«Ani kennansa tokkumma'aa qaba;","poem":1},{"text":"adha waan waadaa gale muummesseera.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Maarre ani si fudhatiisaaf gad baye;","poem":1},{"text":"ani si dhaggiisaaf dharra'eeruun,","poem":2},{"lineBreak":true},{"text":"kunoo si dhagge.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ani woyaa quncee talba'aa","poem":1},{"text":"ta biyya Gibxi'iititti seefantee hujante,","poem":2},{"lineBreak":true},{"text":"taqee tiyya irra afeera.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Taqee tiyyatti fiqiree, qumbii,","poem":1},{"text":"dakkaraa fi qurunfudii irraa hujante itti biifeera.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Koy, haga latti bariitutti","poem":1},{"text":"jaalala keenna dheebuu baanaa ti;","poem":2},{"lineBreak":true},{"text":"jaalalaan ifii gammachiinnaa ti.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Dhirsi kiyya mana hin jiru;","poem":1},{"text":"inni fagoo deemeera.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Inni beesee guddoo","poem":1},{"text":"fudhatee deemeera;","poem":2},{"lineBreak":true},{"text":"haga ji'i goobanutti","poem":2},{"lineBreak":true},{"text":"deebi'ee hin galu» jette.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Isiin jechoota gammachiisuun","poem":1},{"text":"karaa irraa isa gorsite;","poem":2},{"lineBreak":true},{"text":"dubbii damma dibiisaan","poem":2},{"lineBreak":true},{"text":"isa dokonkorsite.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yoosuma inni akka sangaa gara qalamu deemuu,","poem":1},{"text":"akka gadansa","poem":2},{"lineBreak":true},{"text":"gara fonxoro'oo deemuu,","poem":2},{"lineBreak":true},{"text":"isii gula deeme.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Haga daayi tiruu isaa woraanutti,","poem":1},{"text":"akka sinbirreen kaatee tiyyoo seentu,","poem":2},{"lineBreak":true},{"text":"innille wonni kun","poem":2},{"lineBreak":true},{"text":"lubbuu isaatitti akka dhuttu hin beenne.","poem":2}]},{"type":"verse","number":24,"content":["Ammalle ilmaan tiyya,",{"text":"na caqasa'a;","poem":2},{"lineBreak":true},{"text":"waan ani jedhulle","poem":2},{"lineBreak":true},{"text":"itti xiyyeeffadha'a.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Gadhaan keessan gara karaa isi'ii hin deebi'in;","poem":1},{"text":"daandii isi'ii gula ideentanee","poem":2},{"lineBreak":true},{"text":"karaa irraa hin gorina'a.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Isiin namoota hedduu madeessitee jissiteerti;","poem":1},{"text":"namoota bindillaalle ijjeetteerti;","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Manni isi'ii karaa addee worri du'e jiru,","poem":1},{"text":"ka gara awwaalaa gad geessu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}