{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":8,"content":[{"type":"heading","content":["Waamicha Qarumma'aa"]},{"type":"verse","number":1,"content":[{"text":"Qarummaan hin waantuu ree?","poem":1},{"text":"Hubantiin qoonqoo ol hin qabattuu ree?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isiin kooba karaa biraa gubbaa,","poem":1},{"text":"addee qaxxaamura kara'aa dhaabbatti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Karra gara qacha'aa seenanu biraa,","poem":1},{"text":"addee seensuma qacha'aatii,","poem":2},{"lineBreak":true},{"text":"qoonqoo ifii ol qabattee iyyaa,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"«Ee namoota, ani isin waama;","poem":1},{"text":"qoonqoo tiyya ol qabadhee","poem":2},{"lineBreak":true},{"text":"ilmaan namaa mara waama.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isin worri hin bilchaatin qarummaa qabaadha'a;","poem":1},{"text":"isin worri gowwaan hubantii qabaadha'a.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani waan bu'aa qabu dubbataaraa caqasa'a;","poem":1},{"text":"waan sirrii te'e dubbatiisaaf","poem":2},{"lineBreak":true},{"text":"afaan kiyya saaqadha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Afaan kiyya dhugaa dubbata;","poem":1},{"text":"arrabi kiyya waan hantuu jibba.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Jechooti afaan kiyyaa marti haqa;","poem":1},{"text":"isaan keessaa daddabaan","poem":2},{"lineBreak":true},{"text":"yookiin micciiramaan hin jiru.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Worra hubantii qabuuf,","poem":1},{"text":"marti isaaniituu ifa;","poem":2},{"lineBreak":true},{"text":"worra beekkumsa qabuuf dokonkora hin qabu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Meetii caalaa gorsa kiyya,","poem":1},{"text":"worqii qulqulluu caalaalle beekkumsa filadha'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Qarummaan dooqa diimaa waan caaltuuf,","poem":1},{"text":"wonni ati halchitu marti isii woliin","poem":2},{"lineBreak":true},{"text":"wol hin qixxoottu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Ani qarummaan,","poem":1},{"text":"malaammessummaa woliin jiraadha;","poem":2},{"lineBreak":true},{"text":"beekkumsii fi qalbeeffatiis kiyya.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mootii Waan Maraa sodaatiis","poem":1},{"text":"waan hantuu jibbiisa;","poem":2},{"lineBreak":true},{"text":"ani kooraa fi bondhooriisa,","poem":2},{"lineBreak":true},{"text":"karaa hama'aa fi dubbii micciirantuu jibba.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Gorsii fi muraan haqaa tiyya;","poem":1},{"text":"ani hubanti'ii fi hunnalle hin qaba.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Moototi anaan mootii te'an;","poem":1},{"text":"bulchitootille anaan seera haqaa baasan.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bulchitooti,","poem":1},{"text":"qondaaltoti biyya bulchanu martinuu","poem":2},{"lineBreak":true},{"text":"anaan biyya bulchan.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ani worra na jaalatu hin jaaladha;","poem":1},{"text":"worri na barbaadatu na hin dhagga.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Durumma'aa fi ulfinni,","poem":1},{"text":"qabeenni hin dabarree fi milkiin na bira jiran.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Midhaan kiyya","poem":1},{"text":"worqii qulqulluu caala;","poem":2},{"lineBreak":true},{"text":"kennansi kiyya meetii qullittii caala.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ani karaa balchumma'aa irra,","poem":1},{"text":"daandii haqaa irra ideema.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Worra na jaalatuuf","poem":1},{"text":"qabeenna hin kenna;","poem":2},{"lineBreak":true},{"text":"gootaraa isaaniille hin guuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Mootiin Waan Maraa,","poem":1},{"text":"hujii ifii ta durii durii san maraan dura,","poem":2},{"lineBreak":true},{"text":"ana qarummaa dade.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Jalqaba bara durii durii,","poem":1},{"text":"biyyi lafaa adoo hin dadamin ani muudame.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yennaa abbaayaan gugurdoon hin jirre,","poem":1},{"text":"yennaa maddi bisaaniituu hin jirre ani dhaladhe.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Gaarotaa fi kooboti adoo hin dadamin dura","poem":1},{"text":"ani dhaladhe.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Waaqi lafa yookiin diida adoo hin dadin dura,","poem":1},{"text":"yookiin biyyee biyya lafaa takkaalle adoo hin dadin","poem":2},{"lineBreak":true},{"text":"ani dhaladhe.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Yennaa inni abbaaya'aan gubbaa ol-gubbaa diriirse,","poem":1},{"text":"ani achi jiraayyu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Yennaa inni gubbaa irratti duumensa dade,","poem":1},{"text":"yennaa inni madda abbaaya'aa dade,","poem":2}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"bisaan ajaja isaa irra akka hin dabarre,","poem":2},{"lineBreak":true},{"text":"yennaa inni meessaa abbaayota gugurdo'oo tolche,","poem":2},{"lineBreak":true},{"text":"yennaa inni meessaa hundee lafaa tolche,","poem":2},{"lineBreak":true},{"text":"ani achi jiraayyu.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ani yennaa san akka ogeessa guddichaa te'ee,","poem":1},{"text":"isa woliin achi jiraayyu.","poem":2},{"lineBreak":true},{"text":"Ani yennaa mara isa duratti gammadaa,","poem":2},{"lineBreak":true},{"text":"guyyuma guyya'aan","poem":2},{"lineBreak":true},{"text":"isa gammachiisaa tureeyyu.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ani biyya lafaa ta isaa duudi'iin firinxiixaa,","poem":1},{"text":"nama maraan gammadaa tureeyyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"«Ammalle ilmaan tiyya, na caqasa'a;","poem":1},{"text":"worri karaa kiyya eegatu ka gammade.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Gorsa kiyya caqasa'aatii,","poem":1},{"text":"qaroo te'a'a;","poem":2},{"lineBreak":true},{"text":"gorsa kiyya cadhittanee hin ilaalina'a.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Nami na caqasu,","poem":1},{"text":"ka guyyuma guyya'aan","poem":2},{"lineBreak":true},{"text":"balbala tiyya duratti dammaqee,","poem":2},{"lineBreak":true},{"text":"karaa balbala tiyyaa duratti na eegatu","poem":2},{"lineBreak":true},{"text":"ka gammade.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Nami na dhaggatu jiruu dhaggata;","poem":1},{"text":"Mootii Waan Maraa biralle'etti","poem":2},{"lineBreak":true},{"text":"fudhatama qabaata.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Nami na dhabu ifi miidha;","poem":1},{"text":"nami na jibbu marti du'a jaalata» jetti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}