{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PRO","translationId":"gax_twf","name":"Kitaaba Fakkeennaa","commonName":"Kitaaba Fakkeennaa","title":"Kitaaba Fakkeennaa","order":20,"numberOfChapters":31,"sha256":"4e0b3bb66421f96c562360f5d0f876b0a1c37ce8d4608e3ed6afbdb4655e71b6","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gax_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":9,"content":[{"type":"heading","content":["Qarumma'aa Fi Gowwummaa"]},{"type":"verse","number":1,"content":["Qarummaan mana ifii ijaarratteerti;",{"text":"isiin utuboota mana ifii torba","poem":2},{"lineBreak":true},{"text":"boccee dhaabbatteerti.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isiin horii qaltee,","poem":1},{"text":"daadhii woyni'ii naxxee,","poem":2},{"lineBreak":true},{"text":"sagaleelle qopheessiteerti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Qachaa keessa kooba irra dhaabbatanee,","poem":1},{"text":"akka waamanuuf,","poem":2},{"lineBreak":true},{"text":"isiin dubartoota tajaajiltoota ifii ergitee,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"«Nami yaadaan hin bilchaatin marti","poem":1},{"text":"as kowa'aa seena'a!» jetti;","poem":2},{"lineBreak":true},{"text":"worra qalbii hin qannelle'een,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"«Kowa'a, sagalee tiyya nyaadha'a;","poem":1},{"text":"daadhii ani naqelle una'a.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isin jiru'uun hin jiraattaniitii,","poem":1},{"text":"karaa gowwumma'aa lakkisa'a;","poem":2},{"lineBreak":true},{"text":"karaa hubanti'ii irra ideema'a» jetti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nami murgaamessa gorsu,","poem":1},{"text":"arraba fudhata;","poem":2},{"lineBreak":true},{"text":"nami nama hamaa xixu qaanii ifitti fida.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nama murgaamessa yoo gorsite si hin jibba;","poem":1},{"text":"nama qaroo yoo xixxe si hin jaalata.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nama qaroo gorsi","poem":1},{"text":"inni irra caalaa qaroo hin te'a;","poem":2},{"lineBreak":true},{"text":"nama balchaa barsiisi,","poem":2},{"lineBreak":true},{"text":"inni beekkumsa itti hin ede'ata.","poem":2}]},{"type":"verse","number":10,"content":["Qarummaan jalqabaa Mootii Waan Maraa sodaatiisa;",{"text":"Woyyicha san beekiisi hubantii dhaggatiisa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Qarummaan bara jiruu teetii hin baceessiti;","poem":1},{"text":"woggoota jiruu teetii itti sii edeeti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Qaroo yoo teete,","poem":1},{"text":"bu'aan isi'ii teetuma;","poem":2},{"lineBreak":true},{"text":"ati yoo murgaamessa teete ifuma miita.","poem":2}]},{"type":"verse","number":13,"content":["Dubartiin gowwittiin dubbattitti'i;",{"text":"isiin daalle'e;","poem":2},{"lineBreak":true},{"text":"beekkumsa hin qaddu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Isiin qachaa keessa kooba irra,","poem":1},{"text":"balbala mana ifii dura barcumaa irra teetti.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Worra karaa san dabaru,","poem":1},{"text":"ka qajeelee karaa ifii deemu waantee,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"«Isin worri yaadaan hin bilchaatin,","poem":1},{"text":"as gora'a» jetti;","poem":2},{"lineBreak":true},{"text":"worra qalbii hin qannelle'een,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"«Bisaan hannaa hin mi'owa;","poem":1},{"text":"sagaleen dhokaataan nyaatanu,","poem":2},{"lineBreak":true},{"text":"hin kurootti» jetti.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Isaan ammoo worri du'e akka achi jiru,","poem":1},{"text":"worri isiin waantelle,","poem":2},{"lineBreak":true},{"text":"qilee addee worri du'e jiruu keessa","poem":2},{"lineBreak":true},{"text":"akka jiranu hin beekanu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}