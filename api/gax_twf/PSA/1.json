{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":1,"content":[{"type":"heading","content":["Karaa Lama"]},{"type":"verse","number":1,"content":[{"text":"Nami gorsa hamaaleyyi'iitiin hin ideenne,","poem":1},{"text":"ka karaa cubbaaleyyi'ii hin hordonne,","poem":2},{"lineBreak":true},{"text":"ka worra busheeshu woliin tokkummaa hin qanne,","poem":2},{"lineBreak":true},{"text":"ka gammade.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nami akkasii ammoo","poem":1},{"text":"seera Mootii Waan Maraatiin gammada;","poem":2},{"lineBreak":true},{"text":"halkanii fi guyyaa seeruma isaa yaadata.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inni akka muka laga qarqaratti dhaabamee,","poem":1},{"text":"yennaa yenna'aan midhaan buusuu,","poem":2},{"lineBreak":true},{"text":"ka baalli isaa hin qoorree ti.","poem":2},{"lineBreak":true},{"text":"Wonni inni huju marti isaaf hin teeti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hamaaleyyiin ammoo akkasii moti;","poem":1},{"text":"isaan akka hicaacee qilleensi haxowee deemuu ti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tanaaf, hamaaleyyiin muraa jalaa hin bayanu;","poem":1},{"text":"cubbaalleyyiille yaa'ii balchootaa keessatti","poem":2},{"lineBreak":true},{"text":"hin dhaggamanu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tanaaf, Mootiin Waan Maraa","poem":1},{"text":"karaa balchootaa hin beeka;","poem":2},{"lineBreak":true},{"text":"karaan hamaaleyyi'ii ammoo hin bada.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}