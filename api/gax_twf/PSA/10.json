{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":10,"content":[{"type":"heading","content":["Muraa Haqaa dhaggatiisaaf Daadimata Dhikaate"]},{"type":"verse","number":1,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ati maaf fagaattee dhaabbatta?","poem":2},{"lineBreak":true},{"text":"Yennaa nuuti rakkannu maaf ifi dhoffatta?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hamaaleyyiin kooraan worra hiyyeeyyii ari'an;","poem":1},{"text":"maluma namatti dhowane saniin","poem":2},{"lineBreak":true},{"text":"ifumaaf qabaman.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nami hamaan halchaa gadhaa ifiitiin koora;","poem":1},{"text":"inni worra joljolu eebbisee,","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa abaara.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nami hamaan waan kooruuf","poem":1},{"text":"Waaqa hin barbaadu;","poem":2},{"lineBreak":true},{"text":"yaada isaa keessa Waaqi hin jiru.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wonni marti isaaf hin teeti.","poem":1},{"text":"Inni muraa Waaqaa hubatuu hin dande'u;","poem":2},{"lineBreak":true},{"text":"diinota ifii mara irratti hin murga.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inni gadhaa ifii keessatti,","poem":1},{"text":"«Wonni na tachoosu hin jiru;","poem":2},{"lineBreak":true},{"text":"dhaloota mara keessatti","poem":2},{"lineBreak":true},{"text":"rakkinni na hin dhaqqabu» jedhee yaadata.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Afaan isaa abaarsaan,","poem":1},{"text":"dharaa fi sodaachisiisaan guutameera;","poem":2},{"lineBreak":true},{"text":"inni arraba ifiitiin","poem":2},{"lineBreak":true},{"text":"maltumma'aa fi waan hantuu dubbata.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inni ollaa cina'atti riphee,","poem":1},{"text":"worra qarqaarsa hin qanne gaada;","poem":2},{"lineBreak":true},{"text":"worra yakkaa hin qanne hin ijjeesa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inni akka neenqaa dhokatee gaada;","poem":1},{"text":"worra hiyyeeyyii qabiisaaf gaada;","poem":2},{"lineBreak":true},{"text":"inni tiyyoo ifiitiin","poem":2},{"lineBreak":true},{"text":"worra qarqaarsa hin qanne qabee harkisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Worri hiyyeeyyiin jiganee bututan;","poem":1},{"text":"hunna isaa jalatti hin jigan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nami hamaan gadhaa ifii keessatti,","poem":1},{"text":"«Waaqi dedheera;","poem":2},{"lineBreak":true},{"text":"fuula ifii gollateera;","poem":2},{"lineBreak":true},{"text":"inni ijjumaa hin dhaggu» jedha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ee Mootii Waan Maraa, ka'i!","poem":1},{"text":"Ee Waaqa hunna teeti mudhisi!","poem":2},{"lineBreak":true},{"text":"Worra qarqaarsa hin qanne hin dedhin.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nami hamaan maaf Waaqa tuffata?","poem":1},{"text":"Maaf gadhaa ifii keessatti,","poem":2},{"lineBreak":true},{"text":"«Inni na hin adabu» jedha ree?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ati ammoo hin dhaggitta;","poem":2},{"lineBreak":true},{"text":"rakkinnaa fi gadda dhaggitee","poem":2},{"lineBreak":true},{"text":"yennaa mara qarqaarsaaf hin qophootta.","poem":2},{"text":"Worri rakkataan harka keetitti ifi kennata;","poem":1},{"text":"atille ijoollee haadhaa fi abbaa hin qanne","poem":2},{"lineBreak":true},{"text":"hin qarqaarta.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hunna nama hama'aa cassi;","poem":1},{"text":"nami waan hantuu huju","poem":2},{"lineBreak":true},{"text":"haganaa achi deebi'ee","poem":2},{"lineBreak":true},{"text":"waan hantuu akka hin hunye, isa adabi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"bara baraa haga bara baraa mooti'i;","poem":2},{"lineBreak":true},{"text":"gosi biyya adda addaa","poem":2},{"lineBreak":true},{"text":"worri waaqota dhibii waaqonsu","poem":2},{"lineBreak":true},{"text":"lafa isaa irraa hin badan.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ati daadimata worra gad aana'aa hin dhageetta;","poem":2},{"lineBreak":true},{"text":"ati iyya isaanii caqattee,","poem":2},{"lineBreak":true},{"text":"isaan hin jajjabeessita.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nami lafaa ka foon uffate","poem":1},{"text":"worra dhibii akka hin bararassine,","poem":2},{"lineBreak":true},{"text":"worra cunqurfameef,","poem":2},{"lineBreak":true},{"text":"ijoollee haadhaa fi abbaa hin qanneef haqa hin murta.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}