banu","poem":1},{"text":"na irraa fagaatanuu ti;","poem":2},{"lineBreak":true},{"text":"ani waan hantuu woliin tokkummaa hin qabu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nama ollaa ifii dhossa'aan hamatu,","poem":1},{"text":"hin balleessa;","poem":2},{"lineBreak":true},{"text":"nama nama tuffatuu fi","poem":2},{"lineBreak":true},{"text":"nama kooruuf ani hin ossadhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Akka isaan na woliin le'anuuf,","poem":1},{"text":"ilti tiyya gara worra addatamaa","poem":2},{"lineBreak":true},{"text":"lafa tana keessa jiranuu hin ilaalti.","poem":2},{"text":"Nami karaa komii hin qanne ideemu","poem":1},{"text":"inni na hin tajaajila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nami nama sobu mana kiyya keessa hin le'u;","poem":1},{"text":"nami dhara dubbatu na dura hin dhaabbatu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ani guyyuma guyya'aan","poem":1},{"text":"worra hamaa lafa tana keessa jiranu hin balleessa;","poem":2},{"lineBreak":true},{"text":"worra hantuu huju mara","poem":2},{"lineBreak":true},{"text":"qachaa Mootii Waan Maraa keessaa hin balleessa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}