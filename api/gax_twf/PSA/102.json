{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":102,"content":[{"type":"heading","content":["Daadimata Nama Rakkoo Irra Jiruu"]},{"type":"heading","content":["Daadimata nama rakkate tokkoo, ka yennaa inni gaggabee iyyata ifii Mootii Waan Maraa dura Dhikeeffatu."]},{"type":"verse","number":1,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"daadimata kiyya naaf dhage'i;","poem":2},{"lineBreak":true},{"text":"iyyi tiyyalle gara keeti dhuttuu ti.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Guyyaa rakkinna kiyyaa,","poem":1},{"text":"fuula keeti na hin dhoffatin;","poem":2},{"lineBreak":true},{"text":"gurra keeti gara kiyya deebifadhu;","poem":2},{"lineBreak":true},{"text":"yennaa ani si waamu,","poem":2},{"lineBreak":true},{"text":"ariifadhuu deebii naaf kenni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Barri jiruu tiyyaa akka aaraa dabariisatti jira;","poem":1},{"text":"lafeen tiyya akka barbada ibiddaa gubatiisatti jirti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gadhaan kiyya madowee akka marraa waan qooreef,","poem":1},{"text":"sagalee nyaatiisa dadhabe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Qoonqoo ol qabadhee waan aaduuf,","poem":1},{"text":"lafeen tiyya gogaa kiyyatti maxxante.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani akka huummoo goomolee keessaa,","poem":1},{"text":"akka urunguu waan diigame oddu'uu te'e.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hirriiba malee irkadhee bula;","poem":1},{"text":"ani akka sinbirree qofi-galeettii","poem":2},{"lineBreak":true},{"text":"guutuu manaa irra jirtuu ti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Guyyaa mara diinoti kiyya natti murgan;","poem":1},{"text":"worri natti cooru","poem":2},{"lineBreak":true},{"text":"maqaa kiyya maqaa abaarsaa godhatan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ani daadhaa akka sagale'ee nyaadhe;","poem":1},{"text":"imimmaan waan unu woliin wolitti makadhe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mufii teeti guddoo irraa ta kaate,","poem":1},{"text":"ati ol na fuutee gad na gatte.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Barri jiruu tiyyaa akka gaaddisa galgalaa dabara;","poem":1},{"text":"ani akka marraa qoora.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ati haga bara baraa","poem":2},{"lineBreak":true},{"text":"barcumaa mootumma'aa keeti irra teetta;","poem":2},{"lineBreak":true},{"text":"maqaan keeti dhalootaa haga dhalootaatitti hin jiraata.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yennaan ati isi'iif gadhaa laattu amma waan dhutteef,","poem":1},{"text":"ati hin kaata;","poem":2},{"lineBreak":true},{"text":"Xiyoon hin mararta;","poem":2},{"lineBreak":true},{"text":"yennaan murtootte dhutteerti.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tajaajiltooti teeti dhakoota isi'iituu hin jaalatan;","poem":1},{"text":"bututaa isi'ii ka diigameefuu gadhaa laafan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Gosi biyya adda addaa maqaa Mootii Waan Maraa,","poem":1},{"text":"moototi lafaa marti ulfinna isaa hin sodaatan.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mootiin Waan Maraa Xiyoon deebisee hin ijaara;","poem":1},{"text":"inni ulfinna ifiitiin hin mudhata.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Inni daadimata worra deegaa hin dhage'a;","poem":1},{"text":"gaaffii isaaniille hin tuffatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kolbaan amma hin dhalatin","poem":1},{"text":"akka Mootii Waan Maraa leellittu,","poem":2},{"lineBreak":true},{"text":"wonni kun dhaloota dhufuuf barreeffantuu ti.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"addee woyyittii gubba'aa irraa gad ilaale;","poem":2},{"lineBreak":true},{"text":"ol-gubbaa tee'ee lafa ilaale.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Inni aadiisa worra hidhameeruu dhage'e;","poem":1},{"text":"worra duuti itti murante bilisa baase.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Tanaaf maqaan Mootii Waan Maraa Xiyoon keessatti,","poem":1},{"text":"leellifamiisi isaa Yerusaalem keessatti laffama.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Tunille yennaa gosi biyya adda addaatii fi","poem":1},{"text":"mootummooti","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa waaqonfatiisaaf wolitti qabamanu teeti.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Adoo ani dargaggeessaatuu","poem":1},{"text":"inni jabeenna kiyya casseera;","poem":2},{"lineBreak":true},{"text":"bara jiruu tiyyalle gabaasseera.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Maarre ani, «Ee Waaqa,","poem":1},{"text":"ka barri keeti dhalootaa gara dhalootaatitti dabaru,","poem":2},{"lineBreak":true},{"text":"wodhakkaa bara jiruu tiyyaatitti","poem":2},{"lineBreak":true},{"text":"na hin fudhatin» jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Dur ati lafa dadde;","poem":1},{"text":"ol-gubbaalle hujii harka keetii ti.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Isaan hin badan; ati ammoo hin leeta;","poem":1},{"text":"isaan akka woya'aa hin dullooman;","poem":2},{"lineBreak":true},{"text":"ati akka uffanaa isaan hin jijjiirta;","poem":2},{"lineBreak":true},{"text":"isaanille hin gataman.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ati ammoo yennaa mara sanuma;","poem":1},{"text":"barri keetiille dhuma hin qabu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ijoolleen tajaajiltoota teetii nageyaan hin le'an;","poem":1},{"text":"sanyiin isaaniille fuula keeti dura jabaatanee hin le'an.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}