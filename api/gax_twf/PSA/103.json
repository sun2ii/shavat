"poem":2},{"lineBreak":true},{"text":"ka jiruu teeti waan dansa'aan quussu isa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mootiin Waan Maraa worra cunqurfame maraaf,","poem":1},{"text":"balchumma'aa fi haqaan huja.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni karaa ifii Muuse'etti,","poem":1},{"text":"hujii ifii kolbaa Israa'eliititti beessise.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"mararti'ii fi araaraan ka guutame,","poem":2},{"lineBreak":true},{"text":"ka aari'iif hin ariifannee fi ka jaalala guddaa qabu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inni yennaa mara yakkaa teenna hin laakkowu;","poem":1},{"text":"haga bara baraa aari'iin hin turu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Inni akka cubbuu teennaatitti nu irratti hin huju;","poem":1},{"text":"akka yakkaa teennaatitti gatii nu'uuf hin kaffalle.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Akkuma ol-gubbaan lafa irraa ol fagaattu,","poem":1},{"text":"worra isa sodaatuuf jaalalli isaa ka bara baraa","poem":2},{"lineBreak":true},{"text":"akka malee gudda'a.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Akkuma garri aduun baatu","poem":1},{"text":"gara aduun seentu irraa fagaatu,","poem":2},{"lineBreak":true},{"text":"inni cubbuu teenna nu irraa fageessa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Akkuma abbaan ijoollee ifiitiif gadhaa laafu,","poem":1},{"text":"maarre Mootiin Waan Maraalle","poem":2},{"lineBreak":true},{"text":"worra isa sodaatuuf gadhaa laafa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Inni attam akka nuuti dadanne waan beekuuf,","poem":1},{"text":"biyyee akka teene hin qaabata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Barri jiruu namaa akkuma marraa ti;","poem":1},{"text":"akkuma daraaraa badda'aa hin daraara.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yennaa qilleensi dhowu daraaraan hin bada;","poem":1},{"text":"addeen isaalle deebi'ee hin beekkamu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Jaalalli bara baraa","poem":1},{"text":"ka Mootii Waan Maraa ammoo","poem":2},{"lineBreak":true},{"text":"bara baraa haga bara baraatitti,","poem":2},{"lineBreak":true},{"text":"worra isa sodaatu woliin hin jiraata;","poem":2},{"lineBreak":true},{"text":"balchummaan isaalle","poem":2},{"lineBreak":true},{"text":"ijoollee ijoollee isaa woliin hin jiraatti.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kunille worra gondooroo isaa eegatanuu fi","poem":1},{"text":"worra ajaja isaa muummessiisaaf qaabatanuuf te'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"barcumaa mootummaa ifii","poem":2},{"lineBreak":true},{"text":"ol-gubbaa keessatti jabeessee dhaabbateera;","poem":2},{"lineBreak":true},{"text":"mootummaan isaa waan mara bulchiti.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Isin ergantooti Waaqaa,","poem":1},{"text":"worri jajannooti jajjabooti","poem":2},{"lineBreak":true},{"text":"ka jecha isaatiif ajajantanee","poem":2},{"lineBreak":true},{"text":"waan inni jedhu gootanu","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa leellisa'a.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Isin loltooti ol-gubba'aa marti,","poem":1},{"text":"tajaajiltooti isaa","poem":2},{"lineBreak":true},{"text":"worri fedhii isaa muummessitanu","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa leellisa'a.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Wonni inni dade marti,","poem":1},{"text":"mootummaa isaa keessa","poem":2},{"lineBreak":true},{"text":"addee jirtanu maratti","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa leellisa'a.","poem":2},{"lineBreak":true},{"text":"Ee lubbuu tiyya Mootii Waan Maraa leellisi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}