{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":104,"content":[{"type":"heading","content":["Leellisa Abbaa Dadaatiif Dhikaate"]},{"type":"verse","number":1,"content":[{"text":"Ee lubbuu tiyya, Mootii Waan Maraa leellisi.","poem":1},{"text":"Ee Mootii Waan Maraa Waaqa kiyya,","poem":2},{"lineBreak":true},{"text":"ati attam attam gudda'a!","poem":2},{"lineBreak":true},{"text":"Ulfinnaa fi arnya uffatteerta.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ati ifa akka woya'aa ifitti maratte;","poem":1},{"text":"ol-gubbaa akka dunkaani'ii diriirsite.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ati utubaa mana keetii","poem":1},{"text":"bisaan ol-gubba'aa irra dhaabbachiitte;","poem":2},{"lineBreak":true},{"text":"duumensa garreettaa fardaan harkifamu godhatte;","poem":2},{"lineBreak":true},{"text":"koola qilleensaa irra teettee gulutte.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ati qilleensa ergamaa keeti,","poem":1},{"text":"bobe'a ibiddaa tajaajilaa keeti godhatte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Akka isiin ijjumaa hin raafanne,","poem":1},{"text":"ati lafa hundee isi'ii irratti dhaabbachiitte.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Abbaayaa akka woya'aa lafatti uffitte;","poem":1},{"text":"bisaan gaarota golle.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yennaa ati xixxe, bisaan baqate;","poem":1},{"text":"qoonqoo mandiisu'uu teeti yennaa dhage'e dheete.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gaarota gubbaa dhangala'ee,","poem":1},{"text":"gad dhooqa keessa,","poem":2},{"lineBreak":true},{"text":"gara addee ati isaaf qopheessitee dhaqe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akka deebi'ee lafa hin golline,","poem":1},{"text":"meessaa inni dande'ee hin dabarre,","poem":2},{"lineBreak":true},{"text":"ati isaaf goote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ati maddi dhooqa keessa akka yaa'u goote;","poem":1},{"text":"isaan koobota wodhakkaa yaa'an.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bineensoti isaan unan;","poem":1},{"text":"harreen diidaalle untee dheebuu baati.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sinbirrooti bisaan san biratti mana ijaarratan;","poem":1},{"text":"isaan dameelee oddu'uu wocan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Gubbaa irraa bokkeyaan gaarota bisaan obaatta;","poem":1},{"text":"lattille waan ati hujjeen guutanti.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Marri hori'iif akka latu,","poem":1},{"text":"namaafille sagalee waan te'uuf,","poem":2},{"lineBreak":true},{"text":"lafa irraa midhaan akka latu goota.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Woyniin gadhaa namaa akka gammachiittu,","poem":1},{"text":"zayitiin fuula namaa akka cululussitu,","poem":2},{"lineBreak":true},{"text":"sagaleen akka nama jabeessitu goota.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mukooti Mootii Waan Maraa birbirsooti Libaanonii,","poem":1},{"text":"ka inni dhaabe bisaan guddaa dhaggatan.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sinbirrooti isaan keessatti mana ijaarratan;","poem":1},{"text":"qongaan birbirsa irratti hin gala.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Gaaroti dhedheeraan ka goda'aa","poem":1},{"noteId":20},{"text":"ti;","poem":1},{"text":"holli rassa'aa lafa osoleen itti baqattu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ji'a yennaa akka gargar baasuuf dadde;","poem":1},{"text":"aduulle yennaa seensuma ifii hin beetti.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ati dukkana dadde; isiin halkan teeti;","poem":1},{"text":"yennaa san bineensoti badda'aa luuxanee bayan.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Neenqoti dardarooti adamo'oof dhangaa dhowan;","poem":1},{"text":"sagalee ifii Waaqa irraa barbaadatan.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yennaa aduun baatu,","poem":1},{"text":"deebi'anee mandhee ifii keessa ciisan.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Achiin duuba nami gara hujii ifii bayee,","poem":1},{"text":"haga galgalaatitti hujii ifii huja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"hujiin teeti attam attam baca'a!","poem":2},{"lineBreak":true},{"text":"Ati isaan mara qarumma'aan daddeerta;","poem":2},{"lineBreak":true},{"text":"latti waan ati daddeen guutanteerti.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kunoo, abbaayaan guddittiin guddo'oo fi badhoon achi jirti;","poem":1},{"text":"bineensi didiqqa'aa fi gugurdaan,","poem":2},{"lineBreak":true},{"text":"wonni lubbuu qabu bindillaan achi keessa jiran.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Abbaayaa san irra hobolooti gugurdoon hin ideeman;","poem":1},{"text":"bineensi naacha fakkaatu,","poem":2},{"lineBreak":true},{"text":"ka «Lewaataan» jedhamu achi keessa taphata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Sagalee yenna'aan akka isaaniif kennitu,","poem":1},{"text":"isaan kun marti si eeggatan.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Yennaa ati isaaniif kennitu,","poem":1},{"text":"isaan wolitti qabatan;","poem":2},{"lineBreak":true},{"text":"yennaa ati harka keeti isaaniif diriirsitu,","poem":2},{"lineBreak":true},{"text":"isaan waan dansaa hin quufan.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Yennaa ati isaan irraa garagaltu,","poem":1},{"text":"isaan guddoo sodaatan;","poem":2},{"lineBreak":true},{"text":"yennaa ati hafuura isaanii isaan keessaa fudhatu,","poem":2},{"lineBreak":true},{"text":"isaan hin du'an;","poem":2},{"lineBreak":true},{"text":"gara biyye'ee hin deebi'an.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Yennaa ati hafuura keeti itti baafatu,","poem":1},{"text":"isaan hin dadaman;","poem":2},{"lineBreak":true},{"text":"ati lafa deebittee haareya goota.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Ulfinni Mootii Waan Maraa","poem":1},{"text":"haga bara baraa jiraatuu ti;","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa hujii ifiitiin gammaduu ti.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Inni ilaalchaan ka lafa rommisiisu;","poem":1},{"text":"tuqiisaan gaara keessaa ka aara baasu.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ani bara jiruu tiyyaa mara","poem":1},{"text":"Mootii Waan Maraatiif hin faarsa;","poem":2},{"lineBreak":true},{"text":"ani haga jiru mara","poem":2},{"lineBreak":true},{"text":"Waaqa kiyya faaru'uun hin leellisa.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Yaadi gadhaa kiyyaa isa gammachiisuu ti;","poem":1},{"text":"ani Mootii Waan Maraatiin hin gammada.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Cubbaaleyiin lafa irraa badanuu ti;","poem":1},{"text":"hamaaleyyiin haganaa achi hin jiraatin.","poem":2},{"lineBreak":true},{"text":"Ee lubbuu tiyya Mootii Waan Maraa leellisi;","poem":1},{"text":"Mootii Waan Maraa leellisa'a.","poem":2}]}],"footnotes":[{"noteId":20,"caller":"+","text":"Godaa: Bineensa re'ee fakkaatu ka gaara irra le'u.","reference":{"chapter":104,"verse":18}}]},"thisChapterLink":"/api/gax_twf/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}