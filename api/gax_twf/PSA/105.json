{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":105,"content":[{"type":"heading","content":["Baasa Waaqi Kolbaa Israa'eliitiif Godhe"]},{"type":"verse","number":1,"content":[{"text":"Mootii Waan Maraa galateeffadha'a;","poem":1},{"text":"maqaa isaa waammadha'a;","poem":2},{"lineBreak":true},{"text":"waan inni huje","poem":2},{"lineBreak":true},{"text":"gosa biyya adda addaa oddu'utti beessisa'a.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isa faarfadha'a; faaru'uun isa leellisa'a.","poem":1},{"text":"Waan bilbaasa inni huje mara odeessa'a.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Maqaa isaa woyyichaan ifi jaja'a;","poem":1},{"text":"gadhaan worra Mootii Waan Maraa barbaaduu","poem":2},{"lineBreak":true},{"text":"gammadee firinxiixuu ti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mootii Waan Maraatii fi jabeenna isaa barbaada'a;","poem":1},{"text":"yennaa mara fuula isaa barbaada'a.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hujii baasaa ta inni huje,","poem":1},{"text":"bilbaasota, muraa inni kennelle qaabadha'a;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isin ijoolleen Abrahaamii tajaajilaa isaa,","poem":1},{"text":"isin ilmaan Yaaqoobii worri isaaf filatantane","poem":2},{"lineBreak":true},{"text":"tana qaabadha'a.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni Mootii Waan Maraa Waaqa keenna;","poem":1},{"text":"inni biyya lafaa duudi'itti mura.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inni gondooroo ifii haga bara baraa,","poem":1},{"text":"jecha ifii ka ajaje","poem":2},{"lineBreak":true},{"text":"haga dhaloota kumaatitti hin dedhu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inni gondooroo Abrahaam woliin gondoore,","poem":1},{"text":"kakuu Yisihaqiif kakate hin dedhu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tun Yaaqoobiif Seerata,","poem":1},{"text":"Israa'eliif gondooroo bara baraa akka teetuuf jabeessee,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mootiin Waan Maraa, «Qooda ati dhaaltu akka teetu,","poem":1},{"text":"ani lafa Kana'aanii si'iif hin kenna» jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yennaa san laakkossi kolbaa Waaqaa hin bacanne;","poem":1},{"text":"isaan laakkossaan worra diqqaa, biyya ormaatitti galee,","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"gosa biyya tokkoo irraa gara gosa biyya tokkoo,","poem":2},{"lineBreak":true},{"text":"mootummaa tokko irraa","poem":2},{"lineBreak":true},{"text":"gara kolbaa dhibi'ii asii fi achi worra daaqaa ture.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mootiin Waan Maraa ammoo","poem":1},{"text":"nami tokkolle akka isaan cunqursu hin goone;","poem":2},{"lineBreak":true},{"text":"inni isaaniif jedhee mootota xixee,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"«Worra ani muudadhe hin tuqina'a;","poem":1},{"text":"raagota tiyya hin miidhina'a» jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mootiin Waan Maraa lafa irratti beela buuse;","poem":1},{"text":"sagalee isaanii mara balleesse.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ammoo inni namicha tokko","poem":1},{"text":"ka garbicha te'ee gurgurame,","poem":2},{"lineBreak":true},{"text":"Yoseef isaaniin dura erge.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Isaan wodaroo sibiilaa miila isaatitti keyanee,","poem":1},{"text":"wodaroo sibiilaatiin hidhane.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wonni Yoseef dursee dubbate haga muummottutti,","poem":1},{"text":"jechi Mootii Waan Maraa haga isa ilaale.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mootichi biyya Gibxi'ii","poem":1},{"text":"ka gosa biyya adda addaa bulchu,","poem":2},{"lineBreak":true},{"text":"nama ergee isa hiikisiisee, bilisa isa baase.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Inni mana ifii irratti goottaa,","poem":1},{"text":"qabeenna ifii mara irratti bulchaa isa godhate.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Qondaaltota mootichaa akka fedhe akka gorsu,","poem":1},{"text":"gorsitoota mootichaalle","poem":2},{"lineBreak":true},{"text":"qarummaa akka barsiisu godhe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Achiin duuba Israa'el gara biyya Gibxi'ii dhaqee,","poem":1},{"text":"maatiin Yaaqoobii biyya Kaamiititti alagaa teete.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mootiin Waan Maraa kolbaa ifii baceessee,","poem":1},{"text":"diinota isaanii caalaa isaan jabeesse.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Worri Gibxi'ii akka kolbaa isaa jibbitu,","poem":1},{"text":"tajaajiltoota isaatitti mala akka dhoottu godhe.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Achiin duuba inni tajaajilaa ifii Muuse'ee fi","poem":1},{"text":"Aaronii ifii filate erge.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Isaan beessisa bilbaasa isaa worra Gibxi'ii oddu'utti,","poem":1},{"text":"waan maade'ee lafa kaamii keessatti hujane.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"dukkana ergee lafa dukkaneesse;","poem":2},{"lineBreak":true},{"text":"worri Gibxi'ii ammoo waan inni jedhe mormane.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Inni bisaan isaanii gara dhiigaa jijjiiree,","poem":1},{"text":"qurxummii isaaniille akka du'anu godhe.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Biyya isaanii,","poem":1},{"text":"kolloon moototaalle adoo hin hafin","poem":2},{"lineBreak":true},{"text":"raachi keessa guute.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Mootiin Waan Maraa dubbannaan","poem":1},{"text":"faachii fi bookeen","poem":2},{"lineBreak":true},{"text":"biyya isaanii duudii keessa dhufane.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Bokkeya isaanii bokkeya dhaka'aa godhee,","poem":1},{"text":"lafa isaanii maratti mandiisuu buuse.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Woynii isaaniitii fi harruu isaanii balleessee,","poem":1},{"text":"muka lafa isaanii butuche.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Inni dubbannaan awwaannisi,","poem":1},{"text":"korophiis laakkowanee hin dandeenne dhufane.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Isaan waan bisilee lafa isaanii keessaa mara,","poem":1},{"text":"midhaan lafa isaaniille nyaatane.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"biyya Gibxi'ii keessaa","poem":2},{"lineBreak":true},{"text":"angafa te'ee ka dhalate mara,","poem":2},{"lineBreak":true},{"text":"ilma isaanii angaficha mara ijjeese.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Achiin duuba inni","poem":1},{"text":"Israa'elooti meeti'ii fi worqii","poem":2},{"lineBreak":true},{"text":"fudhatanee akka bayanu godhe;","poem":2},{"lineBreak":true},{"text":"gosa isaanii keessaa","poem":2},{"lineBreak":true},{"text":"tokkolle nami duubatti hafe hin jiru.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Worri Gibxi'ii guddoo waan isaan sodaataneef,","poem":1},{"text":"yennaa Israa'elooti bayanu gammadane.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"akka golla'aa duumensa diriirsee,","poem":2},{"lineBreak":true},{"text":"halkan ifa akka isaanii kennu","poem":2},{"lineBreak":true},{"text":"ibidda isaaniif qopheesse.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Isaan gaafannaan inni barbadi-kille isaaniif fide;","poem":1},{"text":"ol-gubbaa irraa sagalee isaanii kennee isaan quusse.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Inni rassaa dhoosee, bisaan keessaa lola'ee,","poem":1},{"text":"akka lagaa goomolee keessa yaa'e.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Inni addii ifii woyyittii,","poem":1},{"text":"tajaajilaa ifii Abrahaamiif kenne qaabate.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Inni kolbaa ifii gammadaan,","poem":1},{"text":"worra isaaf filame ililleetti'iin akka bayanu godhe.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Inni lafa gosa biyya adda addaa isaaniif kenne;","poem":1},{"text":"maarre isaan lafa worri dhibiin itti elowe fudhatane.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Tunille akka isaan seerata isaatii fi","poem":1},{"text":"seera isaa eegatanuuf teete.","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa leellisa'a.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":45}