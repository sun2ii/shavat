{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":106,"content":[{"type":"heading","content":["Arjummaa Mootiin Waan Maraa Kolbaa Ifiititti Mudhise"]},{"type":"verse","number":1,"content":[{"text":"Mootii Waan Maraa leellisa'a!","poem":1},{"text":"Inni dansaa waan te'eef,","poem":2},{"lineBreak":true},{"text":"haga bara baraa kolbaa waan jaalatuuf,","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa galateessa'a!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hujii gugurdoo Mootii Waan Maraa","poem":1},{"text":"eentu lallabee dande'a?","poem":2},{"lineBreak":true},{"text":"Yookiin leellisa isaa mara","poem":2},{"lineBreak":true},{"text":"eentu lassee dande'a?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Worri haqa eegu,","poem":1},{"text":"worri yennaa mara balchumma'aan huju","poem":2},{"lineBreak":true},{"text":"ka gammade.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"yennaa kolbaa teetiif waan dansaa gootu","poem":2},{"lineBreak":true},{"text":"na qaabadhu;","poem":2},{"lineBreak":true},{"text":"yennaa isaan baachu analle qarqaar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Duroomiisa worra si'iif filamee akka dhaggu,","poem":1},{"text":"gammadiisa kolbaa teetiitiin akka gammadu,","poem":2},{"lineBreak":true},{"text":"kolbaa teeti woliin akka si leellisu na godhi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Akkuma abbootii teennaa","poem":1},{"text":"nuutille cubbuu hunyeerra;","poem":2},{"lineBreak":true},{"text":"balleessineerra; waan hantuulle gooneerra.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abbootiin teenna yennaa biyya Gibxi'ii jirtu,","poem":1},{"text":"hujii teeti ta baasaa hin hubanne;","poem":2},{"lineBreak":true},{"text":"gadhi-laafummaa teeti hin qaabanne;","poem":2},{"lineBreak":true},{"text":"isaan abbaayaa diintuu biratti","poem":2},{"lineBreak":true},{"text":"si irratti ka'ane.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Te'uu malee, Mootiin Waan Maraa","poem":1},{"text":"hunna ifii jadduu mudhisiisaaf,","poem":2},{"lineBreak":true},{"text":"maqaa ifiitiif jedhee isaan baase.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inni abbaayaa diintuu xixee,","poem":1},{"text":"isiille godde;","poem":2},{"lineBreak":true},{"text":"inni qilee keessa","poem":2},{"lineBreak":true},{"text":"akka goomolee keessaa isaan sooresse.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Inni harka nyaapha isaanii keessaa isaan baasee,","poem":1},{"text":"harka diinota isaanii keessaa isaan wode.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bisaan diinota isaanii irra garagale;","poem":1},{"text":"isaan keessaa tokkolle hin hanne.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Achiin duuba kolbaan jecha isaa dhugeeffatte;","poem":1},{"text":"faaruu leellisaa isaaf faarsane.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Te'uu malee, isaan yoosuma waan inni huje dedhane;","poem":1},{"text":"gorsa isaalle hin eeganne.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Isaan gammoojjii keessatti sagalee dharra'ane;","poem":1},{"text":"goomolee keessatti Waaqa haga ilaalane.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Inni waan isaan gaafatane isaaniif kenne;","poem":1},{"text":"ammoo dhukkuba isaan golgoleessu itti fide.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Isaan addee quttumaa san keessatti Muuse'ee fi","poem":1},{"text":"woyyicha Mootii Waan Maraa Aaron hinaafane.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Latti gargar baqaxxee Daataan liqinsitee,","poem":1},{"text":"waa'eloota Abiiraamiille'etti cufante.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Worra isaan hordofu oddu'utti ibiddi gabbate;","poem":1},{"text":"bobe'i ibidda sanii worra hamaaleyyii muxuqi godhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Isaan gaara Horeebiititti jabbii hujanee,","poem":1},{"text":"waaqa dharaa san waaqonfatane.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Isaan Waaqa ulfaataa ifii,","poem":1},{"text":"fakkii horii marra dheeduutiin jijjiirane.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Isaan Waaqaa isaan baase,","poem":1},{"text":"ka biyya Gibxi'ii keessatti waan gugurdoo huje,","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"hujii bilbaasaa ta inni biyya Kaamii keessatti huje,","poem":2},{"lineBreak":true},{"text":"waan maade'ee","poem":2},{"lineBreak":true},{"text":"ta inni abbaayaa diintuu biratti huje dedhane.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Maarre Waaqi silaa isaan hin balleessa jedheeraayyu;","poem":1},{"text":"Muuseen inni filate sun ammoo,","poem":2},{"lineBreak":true},{"text":"mufii isaa ta isaan balleessitu isaan irraa deebisiisaaf,","poem":2},{"lineBreak":true},{"text":"odduu seenee fuula isaa dura dhaabbate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Achiin duuba isaan lafa dansaa Kana'aanii san tuffatanee,","poem":1},{"text":"addii Waaqi isaaniif kenne hin dhugeeffanne.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Isaan dunkaanii ifii keessatti gungumane;","poem":1},{"text":"Mootii Waan Maraatiifille hin ajajanne.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Tanaaf inni harka ol fudhatee,","poem":1},{"text":"goomolee keessatti akka isaan du'anu kakatee,","poem":2}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"sanyiin isaanii","poem":2},{"lineBreak":true},{"text":"gosa biyya adda addaa oddu'utti akka duutu,","poem":2},{"lineBreak":true},{"text":"lafa mara keessa isaan bittinneesse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Isaan waaqa, «Ba'aal Phe'or» jedhamu","poem":1},{"text":"waaqonfatiisaan qabamanee,","poem":2},{"lineBreak":true},{"text":"ciincaa waaqota lubbuu hin qanneef dhikaatelle nyaatane.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Isaan hujii ifiitiin","poem":1},{"text":"Mootii Waan Maraa tuttuqanee aarsanee,","poem":2},{"lineBreak":true},{"text":"odduu ifiititti balaa buusane.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Fiinehaas ammoo ka'ee worra yakkaa huje adabee,","poem":1},{"text":"balaan sun dhaabbate.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Wonni inni tolche sun dhalootaa haga dhalootaatitti,","poem":1},{"text":"yennaa mara akka balchumma'aatitti isaaf laakkowatante.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Bisaan Mariiba'aa biratti","poem":1},{"text":"isaan Mootii Waan Maraa aarsane;","poem":2},{"lineBreak":true},{"text":"sababa waan isaan hujaneetiif","poem":2},{"lineBreak":true},{"text":"Muuseen rakkate.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Isaan akka malee waan Muusee aarsaneeranuuf,","poem":1},{"text":"inni dubbii dubbii hin teene dubbate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Akka Mootiin Waan Maraa isaan ajajetti,","poem":1},{"text":"isaan gosa biyya adda addaa hin balleessine.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ammoo gosa biyya adda addaa woliin makamanee,","poem":1},{"text":"aadaa isaanii baratane.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Isaan waaqota dharaa,","poem":1},{"text":"ka tiyyoo isaanitti te'e waaqonfatane.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Isaan ilmaan ifiitii fi ijoollee durraa ta ifii","poem":1},{"text":"durriisotaaf ciincessane.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Isaan waaqota dharaa ka worra Kana'aaniitiif,","poem":1},{"text":"dhiiga ilmaan ifiitii fi ijoollee durraa ta ifii,","poem":2},{"lineBreak":true},{"text":"ta yakkaa hin qanne dhangalaasane;","poem":2},{"lineBreak":true},{"text":"lattille dhiigaan battootte.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Akkasiin isaan hujii ifiitiin battowanee,","poem":1},{"text":"akka gaarayyeeffattootaa","poem":2},{"lineBreak":true},{"text":"Waaqaaf addatamummaa dhabane.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Tanaaf Mootiin Waan Maraa","poem":1},{"text":"kolbaa ifiititti aaree bobe'ee,","poem":2},{"lineBreak":true},{"text":"isaan diqate.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Inni harka gosa biyya adda addaatitti","poem":1},{"text":"dabarsee isaan kennee,","poem":2},{"lineBreak":true},{"text":"diinoti isaanii bulchitoota isaanii te'ane.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Diinoti isaanii isaan cunqursanee,","poem":1},{"text":"isaan baallii isaanii jala galane.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Inni yennaa hedduu isaan baase;","poem":1},{"text":"isaan ammoo finqiliisatti jabaatanee,","poem":2},{"lineBreak":true},{"text":"yakkaa ifiitiin salphatane.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Te'uu malee, yennaa iyya isaanii dhage'e,","poem":1},{"text":"inni rakkinna isaanii ilaale.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Isaaniif jedhee inni gondooroo ifii qaabate;","poem":1},{"text":"sababa jaalala guddaa ifiitiif","poem":2},{"lineBreak":true},{"text":"isaaniif naye.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Worri isaan booji'e marti,","poem":1},{"text":"akka isaaniif nayanu godhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Nuuti maqaa keeti woyyicha akka galateeffannuuf,","poem":1},{"text":"si leellisiisaan akka ulfinna sii kenninuuf,","poem":2},{"lineBreak":true},{"text":"ee Mootii Waan Maraa Waaqa keenna,","poem":2},{"lineBreak":true},{"text":"ati nu baasi;","poem":2},{"lineBreak":true},{"text":"gosa biyya adda addaa keessaa wolitti nu qabi.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Mootiin Waan Maraa Waaqi Israa'elii","poem":1},{"text":"bara baraa haga bara baraa leellifamuu ti;","poem":2},{"lineBreak":true},{"text":"kolbaan marti «Ameen» jettuu ti.","poem":2},{"text":"Mootii Waan Maraa leellisa'a.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}