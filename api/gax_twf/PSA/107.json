{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":107,"content":[{"type":"heading","content":["Rakkoo Hedduu Keessaa Waan Baaseef Galata Waaqaaf Dhikaatu"]},{"type":"verse","number":1,"content":[{"text":"Mootiin Waan Maraa dansaa waan te'eef,","poem":1},{"text":"inni haga bara baraa kolbaa waan jaalatuuf,","poem":2},{"lineBreak":true},{"text":"isa galateeffadha'a.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Worri Mootiin Waan Maraa wode,","poem":1},{"text":"ka inni harka diinaa jalaa wode,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ka inni lafa","poem":2},{"lineBreak":true},{"text":"karaa aduun baatuu fi seentu irraa,","poem":2},{"lineBreak":true},{"text":"kaabaa fi kibba irraa wolitti qabe,","poem":2},{"lineBreak":true},{"text":"isa galateeffadha'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Worri gariin goomolee duwwaa","poem":1},{"text":"lafa womaa keessa hin jirre keessa daaqane;","poem":2},{"lineBreak":true},{"text":"karaa gara qachaa keessa qubatanu","poem":2},{"lineBreak":true},{"text":"isaan geessu irraa miliqane.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isaan beelotaanee dheebotane;","poem":1},{"text":"addiille kutatane.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Achiin duuba isaan rakkinna ifii keessatti","poem":1},{"text":"gara Mootii Waan Maraa iyyane;","poem":2},{"lineBreak":true},{"text":"innille rakkinna guddaa isaanii jalaa isaan baase.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni gara qachaa isaan keessa qubatanuu,","poem":1},{"text":"karaa qajeelaa irra isaan sooresse.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Jaalala isaa ka bara baraatiif,","poem":1},{"text":"waan bilbaasaa ka inni ilmaan namaatiif godheef,","poem":2},{"lineBreak":true},{"text":"isaan Mootii Waan Maraa galateeffatanuu ti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inni worra dheebote dheebuu baasa;","poem":1},{"text":"worra beelotelle waan dansa'aan quussa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Worri gariin dukkanaa fi dimma keessa,","poem":1},{"text":"wodaroo sibiilaatiin hidhamanee le'ane.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sababille isaan jecha Waaqaa mormanee,","poem":1},{"text":"gorsa Waaqa Ol Aana'aa tuffatane.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Maarre inni hujii dadhassiittu'uun gad isaan qabe;","poem":1},{"text":"isaan gad jigane; ka isaan qarqaarulle hin jiru.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Achiin duuba isaan rakkinna ifii keessatti","poem":1},{"text":"gara Mootii Waan Maraa iyyane;","poem":2},{"lineBreak":true},{"text":"innille rakkinna guddaa isaanii jalaa isaan baase.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Inni dukkanaa fi dimma keessaa isaan baasee,","poem":1},{"text":"wodaroo sibiilaa ta ittiin hidhamane kukkute.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Jaalala isaa ka bara baraatiif,","poem":1},{"text":"waan bilbaasaa ka inni ilmaan namaatii godheef,","poem":2},{"lineBreak":true},{"text":"isaan Mootii Waan Maraa galateeffatanuu ti.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Inni balbala sageettu'uu caccasse;","poem":1},{"text":"danqaraa sibiilaa adda lamatti qurxe.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Worri gariin karaa cubbu'uu waan deemaneef","poem":1},{"text":"gowwoomanee, sababa yakkaa ifiitiifille farrane.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Isaan sagalee mara diqatanee,","poem":1},{"text":"du'iisa geyane.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Achiin duuba isaan rakkinna ifii keessatti","poem":1},{"text":"gara Mootii Waan Maraa iyyane;","poem":2},{"lineBreak":true},{"text":"innille rakkinna guddaa isaanii jalaa isaan baase.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Inni jecha ifii ergee isaan fayyise;","poem":1},{"text":"du'iisa irraa isaan hambure.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Jaalala isaa ka bara baraatiif,","poem":1},{"text":"waan bilbaasaa ka inni ilmaan namaatii godheef,","poem":2},{"lineBreak":true},{"text":"isaan Mootii Waan Maraa galateeffatanuu ti.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ciincaa galataa dhikeessanuu ti;","poem":1},{"text":"faaruu gammadaatiin hujii isaa odeessanuu ti.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Worri gariin hobolootaan","poem":1},{"text":"abbaayaa irra deemaa,","poem":2},{"lineBreak":true},{"text":"bisaan guddaa irra daldalatan.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Isaan waan Mootiin Waan Maraa godhu,","poem":1},{"text":"bilbaasa inni qilee abbaayaa gudditti'ii","poem":2},{"lineBreak":true},{"text":"keessatti huju dhaggane.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Inni ajajee,","poem":1},{"text":"hobonbolattii","poem":2},{"lineBreak":true},{"text":"danbalii abbaaya'aa ol fuutu kaase.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Isaan gara ol-gubba'aa ol ka'anee","poem":1},{"text":"gara qile'ee gad bu'ane;","poem":2},{"lineBreak":true},{"text":"rakkinna keessalle'etti addii kutatane.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Isaan akka nama machowee loollowanee tintimane;","poem":1},{"text":"waan godhanulle wollaalane.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Achiin duuba isaan rakkinna ifii keessatti","poem":1},{"text":"gara Mootii Waan Maraa iyyane;","poem":2},{"lineBreak":true},{"text":"innille rakkinna isaanii keessaa isaan baase.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Inni hobonbolattii sarmisiisee,","poem":1},{"text":"danbaliille cadhi godhe.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Isaan danbaliin waan cadhitteef gammadanee,","poem":1},{"text":"innille gara buufata hoboloo gudditti'ii","poem":2},{"lineBreak":true},{"text":"ta isaan bira geyiisaaf fedhanee isaan geesse.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Jaalala isaa ka bara baraatiif,","poem":1},{"text":"waan bilbaasaa ka inni ilmaan namaatii godheef,","poem":2},{"lineBreak":true},{"text":"isaan Mootii Waan Maraa galateeffatanuu ti.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Isaan wolde'a kolba'aa keessatti isa saadanuu ti;","poem":1},{"text":"yaa'ii maanguddo'oo keessalle'etti isa leellisanuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Inni laga gara goomole'ee,","poem":1},{"text":"madda bisaanii gara lafa godddu'uu jijjiire.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Sababa worra hamoolee isii irra le'uutiif,","poem":1},{"text":"lafa midhaan baachu,","poem":2},{"lineBreak":true},{"text":"akka lafa booqee sooddaa ta midhaan hin baanyee godhe.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Inni goomolee gara baleessa bisaanii,","poem":1},{"text":"lafa godduulle gara madda bisaanii jijjiire.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Inni worri beelowaan akka achi qubatanu godhe;","poem":1},{"text":"isaanille qachaa keessa le'anu ijaarratane.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Isaan ficha'atti midhaan facaafatanee,","poem":1},{"text":"muka woyni'ii dhaabbatane;","poem":2},{"lineBreak":true},{"text":"midhaan bacaalle galfatane.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Waaqi isaan eebbisee,","poem":1},{"text":"isaan ijoollee bacaa horane;","poem":2},{"lineBreak":true},{"text":"horiin isaaniille akka diqqaatu hin goone.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Yennaa isaan cunqurfamiisaan,","poem":1},{"text":"rakkatiisaa fi gaddiisaan gad qabamane,","poem":2},{"lineBreak":true},{"text":"laakkossi isaanii diqqaate.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Inni qondaaltotatti salphinna fidee,","poem":1},{"text":"goomolee daandii hin qanne keessa akka daaqanu godhe.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Inni ammoo worra hiyyeeyyii farra keessaa baasee,","poem":1},{"text":"maatii isaanii akka hoole'ee akka horanu godhe.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Worri qajeelaan waan kana dhagganee gammadan;","poem":1},{"text":"worri hamaan ammoo afaan ifii qabatan.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Worri qarooleen waan kana hubatanuu ti;","poem":1},{"text":"jaalala bara baraa ka Mootii Waan Maraa qalbeeffatanuu ti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/107.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/108.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/106.json","previousChapterAudioLinks":{},"numberOfVerses":43}