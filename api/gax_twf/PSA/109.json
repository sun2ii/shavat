{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":109,"content":[{"type":"heading","content":["Iyyata Nama Rakkoo Irra Jiruu"]},{"type":"heading","content":["Faaruu Daawitii, sooressa faarfattootaatiif."]},{"type":"verse","number":1,"content":[{"text":"Ee Waaqa, ka ani leellifadhu,","poem":1},{"text":"hin cadhisin.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Worri hamaaleyyi'ii fi dharaameyyiin","poem":1},{"text":"dharaan afaan natti banatan;","poem":2},{"lineBreak":true},{"text":"arraba dharaatiin natti dubbatan.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isaan na marsanee jecha jibbaa dubbatan;","poem":1},{"text":"sababa malee na lolan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ani isaan jaaladhulle, isaan na lolan;","poem":1},{"text":"ani ammoo isaaniif hin daadimadha.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Waan dansaa ani godheef,","poem":1},{"text":"isaan waan hantuu naaf deebisan;","poem":2},{"lineBreak":true},{"text":"ani isaan jaaladha;","poem":2},{"lineBreak":true},{"text":"isaan ammoo na jibban.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Abbaa mura'aa hamaa diina kiyya irratti kaasi;","poem":1},{"text":"nami isa himatu midda isaa dhaabbatuu ti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kora mura'aa duratti yakkaamessa te'ee dhaggamuu ti;","poem":1},{"text":"daadimati isaalle akka cubbu'uu isatti laakkowantuu ti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Barri jiruu isaa gabaabbatuu ti;","poem":1},{"text":"nami dhibiin sooressummaa isaa fudhatuu ti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ijoolleen isaa ka abbaa hin qanne teetuu ti;","poem":1},{"text":"niitiin isaalle haadha hiyyeessaa teetuu ti.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ijoolleen isaa daaqaa kadhattuu ti;","poem":1},{"text":"mana diigamaa amma keessa le'anu","poem":2},{"lineBreak":true},{"text":"keessaalle'ee ari'amanuu ti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Qabeenna isaa mara","poem":1},{"text":"abbaan beenya'aa qabatuu ti;","poem":2},{"lineBreak":true},{"text":"waan inni itti elowee dhaggate","poem":2},{"lineBreak":true},{"text":"alagaan saamuu ti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nami isaaf nawu,","poem":1},{"text":"yookiin ijoollee isaa","poem":2},{"lineBreak":true},{"text":"ta abbaa hin qanne ka kunuunsu,","poem":2},{"lineBreak":true},{"text":"tokkolle hin jiraatin.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sanyiin isaa dhumattuu ti;","poem":1},{"text":"maqaan isaanii dhaloota itti aanu keessaa","poem":2},{"lineBreak":true},{"text":"haxowamee baduu ti.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"yakkaa abbootii isaa ta durii qaabatuu ti;","poem":2},{"lineBreak":true},{"text":"cubbuun haadha isaalle","poem":2},{"lineBreak":true},{"text":"haxowantee hin balleeffanti.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"yennaa mara cubbuu isaanii qaabatuu ti;","poem":2},{"lineBreak":true},{"text":"isaan ijjumaa lafa irraa dedhamanuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Namichi hamaan worra hiyyeeyyii,","poem":1},{"text":"worra rakkata'aa fi","poem":2},{"lineBreak":true},{"text":"worra akka malee gaddeeru ari'ee ijjeese malee,","poem":2},{"lineBreak":true},{"text":"isaaniif hin mararre.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Inni abaaruu jaalate; abaarsi isatti dhufuu ti;","poem":1},{"text":"inni eebba hin jaalatu; eebbi isa irraa fagaatuu ti.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Inni abaarsa akka woya'aa uffate;","poem":1},{"text":"abaarsi akka bisaanii gara nafa isaa,","poem":2},{"lineBreak":true},{"text":"akka zayiti'ii gara lafee isaa seenuu ti.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Abaarsi akka woyaa inni facaafatuu","poem":1},{"noteId":21},{"text":",","poem":1},{"text":"akka hiituu inni guyyaa mara hidhatuu isatti te'uu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kun martinuu gatii Mootii Waan Maraa biraa","poem":1},{"text":"worri na himatu,","poem":2},{"lineBreak":true},{"text":"ka hantuu tiyya dubbatu","poem":2},{"lineBreak":true},{"text":"dhaggatu teetuu ti.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ee Goottaa Mootii Waan Maraa, ati ammoo","poem":1},{"text":"maqaa keetiif jedhii waan dansaa naa godhi;","poem":2},{"lineBreak":true},{"text":"jaalala keeti ka bara baraatiin, na baasi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ani hiyyeessa, rakkataalle waan te'eef,","poem":1},{"text":"gadhaan kiyya na madowe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ani akka gaaddisa galgalaa dabaraara;","poem":1},{"text":"akka awwaannisa muka irraa hargufanuu","poem":2},{"lineBreak":true},{"text":"hargufamiisatti jira.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Laamiisa irraa ka ka'e jilbi kiyya lelleqe;","poem":1},{"text":"nafi kiyya huqqatee googiraa te'e.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Diinota kiyyaaf murgoo te'e;","poem":1},{"text":"isaan yennaa na dhagganu mataa natti raasan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ee Mootii Waan Maraa Waaqa kiyya, na qarqaar;","poem":1},{"text":"jaalala keeti ka bara baraatiif jedhii na baasi.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"wonni kun hujii harka keetii akka teete,","poem":2},{"lineBreak":true},{"text":"akka ati waan kana hujje","poem":2},{"lineBreak":true},{"text":"diinoti kiyya beekanuu ti.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Isaan na abaaran; ati ammoo na hin eebbitta;","poem":1},{"text":"isaan natti ka'an; ammoo hin salphatan;","poem":2},{"lineBreak":true},{"text":"ani tajaajilaan keeti ammoo hin gammada.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Diinoti kiyya salphinna akka woya'aa uffatanuu ti;","poem":1},{"text":"qaanii akka bullukko'oo facaafatanuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Afaan kiyyaan guddisee","poem":1},{"text":"Mootii Waan Maraa galateeffadha;","poem":2},{"lineBreak":true},{"text":"kolbaa hedduu duratti isa leellisa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Sababille harka worra du'a isaanitti mure jalaa baasiisaaf,","poem":1},{"text":"inni midda worra rakkata'aa dhaabbatta.","poem":2}]}],"footnotes":[{"noteId":21,"caller":"+","text":"Woyaa inni facaafatu: Lafa tokko tokkotti woyaa inni darbatu jedhan.","reference":{"chapter":109,"verse":19}}]},"thisChapterLink":"/api/gax_twf/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}