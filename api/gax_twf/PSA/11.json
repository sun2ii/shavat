text":"ol-gubba'atti barcumaa mootumma'aa ka ifii qaba.","poem":2},{"text":"Inni ilmaan namaa ilaala;","poem":1},{"text":"ilti isaalle isaan qorqorti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mootiin Waan Maraa balchoota haga hin ilaala;","poem":1},{"text":"hamaaleyyi'ii fi","poem":2},{"lineBreak":true},{"text":"worra hunnaan nama irratti ka'u ammoo hin jibba.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mootiin Waan Maraa hamaaleyyii irratti","poem":1},{"text":"kashila ibiddaatii fi dhakaa bobe'u hin roobisiisa;","poem":2},{"lineBreak":true},{"text":"qilleensi gubu hiree isaanii hin te'a.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mootiin Waan Maraa balchaa waan te'eef,","poem":1},{"text":"inni hujii balchootaa hin jaalata;","poem":2},{"lineBreak":true},{"text":"worri hujii balchaa huju fuula isaa hin dhagga.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}