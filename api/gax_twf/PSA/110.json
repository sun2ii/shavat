ak":true},{"text":"kooba woyyittii irratti gara keeti hin dhufan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mootiin Waan Maraa,","poem":1},{"text":"«Akkuma hayyummaa Malkiisedeqii,","poem":2},{"lineBreak":true},{"text":"ati hayyuu bara baraa ti» jedhee kakateera;","poem":2},{"lineBreak":true},{"text":"inni yaada ifii hin jijjiiratu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mootiin Waan Maraa midda keeti jira;","poem":1},{"text":"guyyaa mufii ifii mootota hin butucha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inni gosa biyya adda addaatitti hin mura;","poem":1},{"text":"reeffa isaan keessa hin guuta;","poem":2},{"lineBreak":true},{"text":"bulchitoota lafaa duudiille hin butucha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mootichi madda karaa cina'aa keessaa","poem":1},{"text":"bisaan hin una;","poem":2},{"lineBreak":true},{"text":"tanaaf inni mataa ifii ol hin qabata.","poem":2}]}],"footnotes":[{"noteId":22,"caller":"+","text":"Goottaa: Goottaan kun Masiihii.","reference":{"chapter":110,"verse":1}}]},"thisChapterLink":"/api/gax_twf/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}