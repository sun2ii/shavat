{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":111,"content":[{"type":"heading","content":["Leellisa Hujii Maade'ee Mootii Waan Maraatiif Dhikaate"]},{"type":"verse","number":1,"content":[{"text":"Mootii Waan Maraa Leellisa'a!","poem":1},{"lineBreak":true},{"text":"Kora worra qajeela'aatii fi wolde'a keessatti,","poem":1},{"text":"gadhaa tokkochaan","poem":2},{"lineBreak":true},{"text":"ani Mootii Waan Maraa hin saadadha!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wonni Mootiin Waan Maraa huje guddo'o;","poem":1},{"text":"worri hujii guddoo saniin gammadu marti","poem":2},{"lineBreak":true},{"text":"isii hubatiisa barbaada.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wonni inni huje marti","poem":1},{"text":"ulfinnaa fi arnyaan guutanteerti;","poem":2},{"lineBreak":true},{"text":"balchummaan isaalle","poem":2},{"lineBreak":true},{"text":"haga bara baraa jabaattee dhaabbatti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"hujii ifii akka qaabatantu godhe;","poem":2},{"lineBreak":true},{"text":"inni arja'a; mararaalle'e.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inni worra isa sodaatuuf sagalee hin kenna;","poem":1},{"text":"haga bara baraa gondooroo ifii hin qaabata.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inni lafa gosa adda addaa isaanii kenniisaan,","poem":1},{"text":"hunna ifii kolbaa ifiititti mudhiseera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hujiin harka isaa marti dhuga'aa fi haqa;","poem":1},{"text":"seerri isaa marti addatama'a.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Seerri isaa haga bara baraa jabaatee dhaabbatee,","poem":1},{"text":"addatamumma'aa fi balchumma'aan hujameera.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inni kolbaa ifiitiif wodoo erge;","poem":1},{"text":"gondooroo ifiille haga bara baraa ajaje;","poem":2},{"lineBreak":true},{"text":"maqaan isaa woyyicha; ka sodaatamelle'e.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Qarummaan jalqabaa","poem":1},{"text":"Mootii Waan Maraa sodaatiisa;","poem":2},{"lineBreak":true},{"text":"worri ajaja isaa hordofu hubantii dansaa qaban;","poem":2},{"lineBreak":true},{"text":"kolbaan haga bara baraa","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa saadatu'uu malte.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}