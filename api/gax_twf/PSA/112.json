{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":112,"content":[{"type":"heading","content":["Gammada Nama Balcha'aa"]},{"type":"verse","number":1,"content":[{"text":"Mootiin Waan Maraa leellifamuu ti;","poem":1},{"text":"nami Mootii Waan Maraa sodaatu,","poem":2},{"lineBreak":true},{"text":"ka ajaja isaatiin guddoo gammadu","poem":2},{"lineBreak":true},{"text":"ka gammade.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sanyiin isaa lafa san keessatti","poem":1},{"text":"worra jabaa hin te'an;","poem":2},{"lineBreak":true},{"text":"dhalooti worra qajeela'aa hin eebbifanti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Manni isaa taajurumma'aa fi","poem":1},{"text":"durumma'aan hin guutama;","poem":2},{"lineBreak":true},{"text":"balchummaan isaaniille","poem":2},{"lineBreak":true},{"text":"haga bara baraa hin jiraatti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nama arja'aa, nama marara'aa fi,","poem":1},{"text":"nama balcha'aafille,","poem":2},{"lineBreak":true},{"text":"dukkana keessalle'etti ifi isaaf hin baya.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nama arjaa, liqaa namaaf kennu","poem":1},{"text":"wonni dansaan isaaf hin teeti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dhugumaan inni ijjumaa hin raafamu;","poem":1},{"text":"nami balchaan haga bara baraa hin qaabatama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Inni oduu hantuu hin sodaatu;","poem":1},{"text":"Mootii Waan Maraatitti waan addatuuf,","poem":2},{"lineBreak":true},{"text":"gadhaan isaa hin mamu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gadhaan isaa ijjumaa hin raafamu; hin sodaatu;","poem":1},{"text":"dhuma irratti jinnana diinota ifii hin dhagga.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inni arjumma'aan worra hiyyeeyyi'iif kenna;","poem":1},{"text":"balchummaan isaa haga bara baraa jiraatti.","poem":2},{"lineBreak":true},{"text":"Hunnaa fi ulfinnaan hin saadama.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nami hamaan tana dhaggee hin aara;","poem":1},{"text":"inni ilkaan ifii qaree, hin bada;","poem":2},{"lineBreak":true},{"text":"halchaan isaalle ta bu'aa hin qanne teeti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}