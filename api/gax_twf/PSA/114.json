{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":114,"content":[{"type":"heading","content":["Faaruu Yaadannoo Irra Dabaramaa"]},{"type":"verse","number":1,"content":[{"text":"Yennaa Israa'el, sanyiin Yaaqoobii,","poem":1},{"text":"gosa afaan ormaa dubbattu,","poem":2},{"lineBreak":true},{"text":"biyya Gibxi'ii keessaa baate,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yihudaan addee woyyittii Waaqaa,","poem":1},{"text":"Israa'elille bulchiisa isaa jala teete.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Abbaayaan dhaggitee baqatte;","poem":1},{"text":"lagi Yordaanosiille gara duubaa deebi'e.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gaaroti akka korbeeyyii hoole'ee,","poem":1},{"text":"koobotille akka ilmoolee hoole'ee burraaqane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee abbaaya'a, ati maaf baqatte?","poem":1},{"text":"Ee laga Yordaanosii, gara duubaa maaf deebite?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ee gaarota, isin maaf akka korbeeyyii hoole'ee,","poem":1},{"text":"ee koobota,","poem":2},{"lineBreak":true},{"text":"isin maaf akka ilmoolee hoole'ee burraaxxane?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ee lafa, Goottaa duratti,","poem":1},{"text":"fuula Waaqa Yaaqoobii duratti holladhu!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inni rassaa gara baleessaatitti,","poem":1},{"text":"rassaa jabaa gara madda bisaaniititti hin deebisa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}