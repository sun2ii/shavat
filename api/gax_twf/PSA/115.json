malee, hin dhagganu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isaan gurra qaban malee, hin dhage'anu;","poem":1},{"text":"funnaan qaban malee, foolee hin fuudhanu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Isaan harka qaban malee,","poem":1},{"text":"qaqqabuu hin dande'anu.","poem":2},{"lineBreak":true},{"text":"Miila qaban malee, hin ideemanu;","poem":2},{"lineBreak":true},{"text":"laagadaan isaaniille","poem":2},{"lineBreak":true},{"text":"qoonqoo hin dhageessisu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Worri isaan hujee fi","poem":1},{"text":"isaanitti dhugeeffatu martinuu,","poem":2},{"lineBreak":true},{"text":"akkuma isaanii hin te'an.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ee kolbaa Israa'elii,","poem":1},{"text":"ka isin qarqaaruu fi isin eegu isa waan te'eef,","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraatitti addadha'a!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ee hayyoota, sanyii Aaronii,","poem":1},{"text":"inni qarqaaraa keessan;","poem":2},{"lineBreak":true},{"text":"wontee teessanille'e.","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraatitti addadha'a!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isin worri Mootii Waan Maraa sodaattanu,","poem":1},{"text":"Mootii Waan Maraatitti addadha'a!","poem":2},{"lineBreak":true},{"text":"Inni qarqaaraa keessan;","poem":2},{"lineBreak":true},{"text":"wontee teessanille'e.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mootiin Waan Maraa nu qaabata;","poem":1},{"text":"nu hin eebbisalle'e;","poem":2},{"lineBreak":true},{"text":"inni kolbaa Israa'elii hin eebbisa;","poem":2},{"lineBreak":true},{"text":"inni hayyoota sanyii Aaronii hin eebbisa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Inni worra isa sodaatu,","poem":1},{"text":"diqqa'aa fi guddaa hin eebbisa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"isinii fi ijoollee teessan","poem":2},{"lineBreak":true},{"text":"akka hortanu godhuu ti.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"ol-gubba'aa fi lafa ka dade","poem":2},{"lineBreak":true},{"text":"isin eebbisuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ol-gubbaan ol-gubbootaa","poem":1},{"text":"ta Mootii Waan Maraa ti;","poem":2},{"lineBreak":true},{"text":"latti ammoo ilmaan namaatiif kennanteerti.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Worri du'eeru,","poem":1},{"text":"ka gara cadheessaa gad bu'eeru,","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa leellisuu hin dande'u.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nuuti worri jirru ammoo,","poem":1},{"text":"ammaa jalqannee haga bara baraa,","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa hin leellifanna;","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa leellisa'a.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}