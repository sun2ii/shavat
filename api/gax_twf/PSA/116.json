Waan Maraa arja'a; balchaalle'e;","poem":1},{"text":"Waaqi keenna marara'a.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"worra gad ifi qabu hin eega;","poem":2},{"lineBreak":true},{"text":"yennaa ani gad qabame, inni na qarqaare.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"waan dansaa waan si'iif godheef,","poem":2},{"lineBreak":true},{"text":"ee lubbuu tiyya, gara foora keetii deebi'i.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"lubbuu tiyya du'a irraa,","poem":2},{"lineBreak":true},{"text":"ila tiyya imimmaan irraa,","poem":2},{"lineBreak":true},{"text":"miila kiyya gufatiisa irraa hamburte.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Maarre ani Mootii Waan Maraa dura,","poem":1},{"text":"lafa worra jiraata'aa keessa ideema.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani yennaa,","poem":1},{"text":"«Ani guddoo rakkadheera» jedheeyyuu,","poem":2},{"lineBreak":true},{"text":"dhugeeffannaa tiyya hin lakkinne.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ani yennaa sodaadhe,","poem":1},{"text":"«Nami addatamu tokkoolle hin jiru» jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Waan dansaa inni naaf kenne maraaf,","poem":1},{"text":"ani Mootii Waan Maraatiif","poem":2},{"lineBreak":true},{"text":"maan deebisee dande'a?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mootiin Waan Maraa waan na fayyiseef,","poem":1},{"text":"ani isa hin galateeffadha;","poem":2},{"lineBreak":true},{"text":"kennansa daadhii woyni'ii isaaf hin dhikeessa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Fuula kolbaa isaa mara duratti,","poem":1},{"text":"ani waan waadaa gale","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraatiif hin muummessa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Duuti worra woyyootaa,","poem":1},{"text":"Mootii Waan Maraa duratti ulfinna qaddi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ee Mootii Waan Maraa, ani tajaajilaa keeti;","poem":1},{"text":"ani tajaajilaa keeti, ilma garbittii teetii ti;","poem":2},{"lineBreak":true},{"text":"ati hidhaa tiyya keessaa na hiitteerta.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ani ciincaa galataa si'iif hin dhikeessa;","poem":1},{"text":"gara keetille hin daadimadha.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ani fuula kolbaa isaa mara duratti,","poem":1},{"text":"waan Mootii Waan Maraatiif waadaa gale","poem":2},{"lineBreak":true},{"text":"hin muummessa;","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tanalle badhinna Galma Mootii Waan Maraa duraa keessatti,","poem":1},{"text":"Yerusaalem wodhakka'atti hin godha.","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa leellisa'a.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}