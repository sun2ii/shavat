ext":"bilisa na baase.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"na woliin jira; ani hin sodaadhu;","poem":2},{"lineBreak":true},{"text":"nami maan na godhuu dande'a?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"na qarqaariisaaf na woliin jira;","poem":2},{"lineBreak":true},{"text":"ani jinnana diinota kiyyaa hin dhagga.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Namatti addatiisaa mannaa,","poem":1},{"text":"gara Mootii Waan Maraa baqatiisa woyya.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Qondaaltotatti addatiisaa mannaa,","poem":1},{"text":"gara Mootii Waan Maraa baqatiisa woyya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Gosi biyya adda addaa marti na marsane;","poem":1},{"text":"ani ammoo maqaa Mootii Waan Maraatiin","poem":2},{"lineBreak":true},{"text":"isaan balleesse.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isaan gara maraan na marsane;","poem":1},{"text":"ani ammoo maqaa Mootii Waan Maraatiin","poem":2},{"lineBreak":true},{"text":"isaan balleesse.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Isaan akka kinniisaa na marsane;","poem":1},{"text":"ammoo akka ibidda qore'ee dhaamane;","poem":2},{"lineBreak":true},{"text":"ani maqaa Mootii Waan Maraatiin","poem":2},{"lineBreak":true},{"text":"isaan balleesse.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ani gara duubaa dhiibamee, jigiisa geye;","poem":1},{"text":"Mootiin Waan Maraa ammoo na qarqaare.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"jabeenna kiyyaa fi faaruu tiyya;","poem":2},{"lineBreak":true},{"text":"inni fayyinna kiyya te'eera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Qoonqoon gammadaatii fi injifanno'oo,","poem":1},{"text":"dunkaanii worra balchootaa keessaa,","poem":2},{"lineBreak":true},{"text":"«Harki Mootii Waan Maraa middichi","poem":2},{"lineBreak":true},{"text":"hujii jadduu huje;","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"harki Mootii Waan Maraa middichi ol ka'e;","poem":2},{"lineBreak":true},{"text":"harki Mootii Waan Maraa middichi","poem":2},{"lineBreak":true},{"text":"hujii jadduu huje» jettu dhage'ante.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ani hin le'a malee, hin du'u;","poem":1},{"text":"waan Mootiin Waan Maraa hujelle","poem":2},{"lineBreak":true},{"text":"hin odeessa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"jabeessee na adabeera;","poem":2},{"lineBreak":true},{"text":"ammoo du'aaf dabarsee na hin kennine.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Akka ani ol seenee","poem":1},{"text":"Mootii Waan Maraa galateeffadhuuf,","poem":2},{"lineBreak":true},{"text":"balbala balchumma'aa naaf bana'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Tun balbala Mootii Waan Maraa ti;","poem":1},{"text":"karaa balchooleen seenanu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ati waan naa dhageetteef,","poem":1},{"text":"fayyinna kiyyalle waan naaf teeteef","poem":2},{"lineBreak":true},{"text":"si galatteeffadha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Dhakaan worri mana ijaaru tuffate,","poem":1},{"text":"dhakaa dhakaa mara caalaa barbaadamu te'e;","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Tun hujii Mootii Waan Maraa ti;","poem":1},{"text":"isiin ila teennalle'etti waan baasaa ti.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Guyyaan Mootiin Waan Maraa tolche kana;","poem":1},{"text":"itti gammannee firinxiindhuu ti.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ee Mootii Waan Maraa nu baasi;","poem":1},{"text":"ee Mootii Waan Maraa nu milkeessi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Maqaa Mootii Waan Maraatiin","poem":1},{"text":"ka dhufu ka eebbifame;","poem":2},{"lineBreak":true},{"text":"nuuti Galma Waaqaa keessaa isin eebbinna.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mootiin Waan Maraa Waaqa;","poem":1},{"text":"inni ifa nu'uuf isseera.","poem":2},{"text":"Dameelee bisilee qabannee, jila bobbaanee,","poem":1},{"text":"haga gaafota addee ciinca'aa dhandhuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ati Waaqa kiyya; ani si galateeffadha;","poem":1},{"text":"ati Waaqa kiyya; ani si saadadha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Inni dansaa waan te'eef,","poem":1},{"text":"jaalala isaa ka bara baraatiif","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa galateessa'a.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}