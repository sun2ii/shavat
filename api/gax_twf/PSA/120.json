,"poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ana ka lafa worra Mesheekiititti galee,","poem":1},{"text":"dunkaanii worra Qedaarii keessa le'uuf aanne'e!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Worra nageya jibbu san odduu,","poem":1},{"text":"ani yennaa hedduu le'e.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ani nama nageyaa ti;","poem":1},{"text":"yennaa ani marroo nageyaa dubbadhu ammoo,","poem":2},{"lineBreak":true},{"text":"isaan lolaaf ka'an.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}