aa aduun,","poem":1},{"text":"halkan jiin si hin miidhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"Waan hantuu mara irraa si eega;","poem":2},{"lineBreak":true},{"text":"inni jiruu teeti hin eega.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mootiin Waan Maraa bayaa fi gala keeti","poem":1},{"text":"ammaa jalqabee haga bara baraatitti hin eega.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}