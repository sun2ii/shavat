:1},{"text":"barcumaa mootumma'aa dhaabbatane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nageya Yerusaalemiitiif daadimadha'a:","poem":1},{"text":"«Worri isii jaalatu milkowuu ti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dalleya isi'ii keessa nageenni,","poem":1},{"text":"mana mootumma'aa","poem":2},{"lineBreak":true},{"text":"ta isi'ii keessa sarmiis jiraatuu ti» jedha'a.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ani sababa firootaa fi jaalota kiyyaatiif,","poem":1},{"text":"«Nageenni si keessa jiraatuu ti» hin jedha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sababa mana Mootii Waan Maraa","poem":1},{"text":"Waaqa keennaatiif,","poem":2},{"lineBreak":true},{"text":"ani waan dansaa si'iif hin halcha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}