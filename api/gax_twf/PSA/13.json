lineBreak":true},{"text":"akka du'u na hin godhin.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Diinoti kiyya,","poem":1},{"text":"«Isa injifanne» jedhanee akka kooranu,","poem":2},{"lineBreak":true},{"text":"nyaapholeen kiyyalle","poem":2},{"lineBreak":true},{"text":"jinnana kiyyatti akka gammadanu hin godhin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ani ammoo marartii guddoo sanitti addadheera;","poem":1},{"text":"gadhaan kiyyalle fayyisiisa keetitti hin gammada.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"waan dansaa waan naa godheef,","poem":2},{"lineBreak":true},{"text":"ani isaaf hin faarfadha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}