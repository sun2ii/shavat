1},{"text":"Lubbuun tiyyalle hin eegatti;","poem":2},{"lineBreak":true},{"text":"addi'iin jecha isaa eegadha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eeddota bari'iisa eegatanu caalaa,","poem":1},{"text":"ee, eeddota bari'iisa eegatanu caalaa,","poem":2},{"lineBreak":true},{"text":"lubbuun tiyya Goottaa eegatti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Jaalalli bara baraa","poem":1},{"text":"Mootii Waan Maraa bira waan jiruuf,","poem":2},{"lineBreak":true},{"text":"wodiisaaf hunni guddoolle","poem":2},{"lineBreak":true},{"text":"isa bira waan jirtuuf,","poem":2},{"lineBreak":true},{"text":"ee Israa'el, Mootii Waan Maraatitti","poem":2},{"lineBreak":true},{"text":"addii godhadhu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inni yakkaa isi'ii mara irraa","poem":1},{"text":"Israa'el hin woda.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}