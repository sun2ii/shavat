_break"},{"type":"verse","number":6,"content":[{"text":"Nuuti Efraata'atti","poem":1},{"text":"marroo Saanduqa Gondooro'oo dhageenne;","poem":2},{"lineBreak":true},{"text":"diida Yaa'ariititti isii dhaggine.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kowa'a, gara addee Mootiin Waan Maraa le'uu","poem":1},{"text":"dhandhaa!","poem":2},{"lineBreak":true},{"text":"Ejjeta miila isaa jalatti isaaf sagannaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ee Mootii Waan Maraa, ka'i!","poem":1},{"text":"Saanduqa Gondooro'oo","poem":2},{"lineBreak":true},{"text":"ka hunna teeti mudhisu woliin,","poem":2},{"lineBreak":true},{"text":"gara addee foora keetii dhaqi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hayyooti teeti balchummaa uffatanuu ti;","poem":1},{"text":"Addatantooti teetille ilillisaa faarsanuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tajaajilaa keeti Daawitiif jedhiitii,","poem":1},{"text":"nama muudde hin lakkisin.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"kakuu dhuga'aa ta hin jijjiirane,","poem":2},{"lineBreak":true},{"text":"Daawitiif kakatee,","poem":2},{"text":"«Ilmaanuma sanyii teetii keessaa tokkocha,","poem":1},{"text":"ani barcumaa mootumma'aa keeti irra","poem":2},{"lineBreak":true},{"text":"hin teessisa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ilmaan teeti Gondooroo tiyya yoo eegatane,","poem":1},{"text":"ajaja ani isaan barassiisu yoo eegatane,","poem":2},{"lineBreak":true},{"text":"ilmaan isaaniille haga bara baraa","poem":2},{"lineBreak":true},{"text":"barcumaa mootumma'aa keeti irra","poem":2},{"lineBreak":true},{"text":"hin tee'an» jedheera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"Xiyoon waan filateef,","poem":2},{"lineBreak":true},{"text":"qe'ee ifii godhatiisaaf fedheera:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Inni, «Tun haga bara baraa","poem":1},{"text":"addee foora kiyyaa ti;","poem":2},{"lineBreak":true},{"text":"ani waan isii jaaladheef,","poem":2},{"lineBreak":true},{"text":"addee le'u isii hin godhadha.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Waan nyaataatiin","poem":1},{"text":"baceessee isii hin eebbisa;","poem":2},{"lineBreak":true},{"text":"hiyyeeyyii isi'ii","poem":2},{"lineBreak":true},{"text":"sagalee hin quussa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hayyoota isi'ii","poem":1},{"text":"fayyinna itti hin uffisa;","poem":2},{"lineBreak":true},{"text":"addatantooti isi'iille","poem":2},{"lineBreak":true},{"text":"ilillisaa hin faarsan.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Maatii Daawitii keessaa","poem":1},{"text":"mootii hin muuda;","poem":2},{"lineBreak":true},{"text":"ka muude saniif akka inni bulchu","poem":2},{"lineBreak":true},{"text":"karaa hin qopheessa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Diinota isaa qaanii itti hin uffisa;","poem":1},{"text":"kallachi isa irraa ammoo","poem":2},{"lineBreak":true},{"text":"hin balaqqisa» jedheera.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":16}