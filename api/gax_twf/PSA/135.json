t":"Mootiin Waan Maraa Yaaqoob ifiif,","poem":1},{"text":"Israa'el qabeenna ifii","poem":2},{"lineBreak":true},{"text":"ka addaa godhee filateera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mootiin Waan Maraa guddaa akka te'e,","poem":1},{"text":"Goottaan keenna","poem":2},{"lineBreak":true},{"text":"waaqota mara akka caalu ani hin beeka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ol-gubbaa keessaa fi lafa irratti,","poem":1},{"text":"abbaaya'aa fi qilee isi'ii mara keessatti,","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa","poem":2},{"lineBreak":true},{"text":"waan fedhe mara godha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni duumensa qaccee lafaatii kaasee fida;","poem":1},{"text":"bokkeya woliin balaqqeettii,","poem":2},{"lineBreak":true},{"text":"mana kuusaa ifii keessaa qilleensa fida.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inni angafa ilmaan namaatii fi hori'ii","poem":1},{"text":"ka biyya Gibxi'ii fixe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ee biyya Gibxi'ii, inni si keessatti","poem":1},{"text":"Fara'oonii fi tajaajiltoota isaa mara irratti,","poem":2},{"lineBreak":true},{"text":"bilbaasaa fi waan maade'ee huje.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Inni gosa biyya adda addaa","poem":1},{"text":"hedduu gad dhowee,","poem":2},{"lineBreak":true},{"text":"mootota hunnaameyyii,","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"mootii Amoorotaa Sihoon,","poem":2},{"lineBreak":true},{"text":"mootii biyya Baashaanii Oog,","poem":2},{"lineBreak":true},{"text":"mootummoota Kana'aanii mara ijjeese.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lafa isaaniille akka dhaalaatitti,","poem":1},{"text":"kolbaa ifii Israa'eliif dhaala kenne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"maqaan keeti haga bara baraa jiraata;","poem":2},{"lineBreak":true},{"text":"Ee Mootii Waan Maraa,","poem":2},{"lineBreak":true},{"text":"dhaloota mara keessatti hin qaabatanta.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"kolbaa ifiitiif muraa hin kenna;","poem":2},{"lineBreak":true},{"text":"tajaajiltoota ifiitiifille marartii hin qaba.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Waaqoti dharaa","poem":1},{"text":"ka gosa biyya adda addaa worqi'ii fi meetii,","poem":2},{"lineBreak":true},{"text":"harka namaatiin hujamane.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Isaan afaan qaban malee, hin dubbatanu;","poem":1},{"text":"ila qaban malee, hin dhagganu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Isaan gurra qaban malee, hin dhage'anu;","poem":1},{"text":"afaan isaanii keessalle hafuurri hin jiru.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Worri isaan hujuu fi","poem":1},{"text":"isaanitti dhugeeffatu martinuu,","poem":2},{"lineBreak":true},{"text":"akkuma isaanii jiran.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ee kolbaa Israa'elii,","poem":1},{"text":"Mootii Waan Maraa leellisa'a!","poem":2},{"text":"Ee hayyoota sanyii Aaronii,","poem":1},{"text":"Mootii Waan Maraa leellisa'a!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Sanyii Lewwootaa,","poem":1},{"text":"Mootii Waan Maraa leellisa'a!","poem":2},{"text":"Isin worri Mootii Waan Maraa sodaattanu,","poem":1},{"text":"Mootii Waan Maraa leellisa'a!","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"ka Yerusaalem keessa le'u,","poem":2},{"lineBreak":true},{"text":"Xiyoon keessatti leellifamuu ti!","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa leellisa'a.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA