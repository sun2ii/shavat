{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":137,"content":[{"type":"heading","content":["Gadda Israa'elootaa Ka Boojuu Keessaa"]},{"type":"verse","number":1,"content":[{"text":"Nuuti laga Baabilonii bira teennee,","poem":1},{"text":"yennaa Xiyoon qaabanne boonne.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Muka olaati'ii irratti","poem":1},{"text":"kiraarota keenna gugurdaa san fafanninne.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Worri booji'ee nu farrisiisu,","poem":1},{"text":"achitti faaruu isaan gammachiittu","poem":2},{"lineBreak":true},{"text":"akka faarsinu nu gaafatanee,","poem":2},{"lineBreak":true},{"text":"«Faaruu marroo Xiyoonii keessaa","poem":2},{"lineBreak":true},{"text":"takkattii faarsa'a» jedhane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lafa ormaa keessatti,","poem":1},{"text":"nuuti attam faaruu Mootii Waan Maraa","poem":2},{"lineBreak":true},{"text":"faarsuu dandeenna ree?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ee Yerusaalem, yoo ani si dedhe,","poem":1},{"text":"harki kiyya middichi","poem":2},{"lineBreak":true},{"text":"ogummaa ifii dedhuu ti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yerusaalem, ani yoo si hin qaabatin,","poem":1},{"text":"waan itti gammadu mara","poem":2},{"lineBreak":true},{"text":"yoo si hin caalchisin,","poem":2},{"lineBreak":true},{"text":"arrabi kiyya laagadaa kiyyatti goguu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"guyyaa Yerusaalem diigante,","poem":2},{"lineBreak":true},{"text":"worri Edoomii, «Diiga'a! Diiga'a!","poem":2},{"lineBreak":true},{"text":"Haga hundee isi'iititti gad jissa'a!»","poem":2},{"lineBreak":true},{"text":"attam akka isaan jedhane qaabadhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ee Baabilonii diigantu!","poem":1},{"text":"Waan ati nu irratti goote,","poem":2},{"lineBreak":true},{"text":"ka deebisee si irratti godhu ka gammade.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ka daa'immaan teeti qabee,","poem":1},{"text":"rassaa irratti macalaasu ka gammade.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}