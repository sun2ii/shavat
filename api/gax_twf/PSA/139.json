{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":139,"content":[{"type":"heading","content":["Waaqa Waan Mara Beeku"]},{"type":"heading","content":["Faaruu Daawitii, sooressa faarfattootaatiif."]},{"type":"verse","number":1,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ati qorqortee na beetteerta.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ati teessoo tiyyaa fi ka'a tiyya hin beetta;","poem":1},{"text":"yaada kiyya fago'ottuu hubatta.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Addee ani deemu fi itti foorfadhu","poem":1},{"text":"hubattee beetta;","poem":2},{"lineBreak":true},{"text":"ati hujii tiyya mara hin beetta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Adoo dubbiin afaan kiyyaa hin bayin,","poem":1},{"text":"ee Mootii Waan Maraa,","poem":2},{"lineBreak":true},{"text":"ati dubbii san maraayyuu hin beetta.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ati duraa fi duuba kiyya","poem":1},{"text":"harka keeti ana irra qaddeerta.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Beekkumsi akkasii akka malee naaf baasa;","poem":1},{"text":"akka malee hubantii tiyyaan ol.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ayyaana keeti duraa eessa deemuu dande'a?","poem":1},{"text":"Fuula keeti duraa eessa baqatuu dande'a?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gara ol-gubba'aa yoo ol baye, ati achi jiraata;","poem":1},{"text":"addee worri du'e jiru keessa yoo irkadhelle,","poem":2},{"lineBreak":true},{"text":"ati achi jirta.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ani koola baasee akka dayya'a boru'uu ka'ee,","poem":1},{"text":"gara seensuma adu'uutitti yoo qubadhe,","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"silaa achille'etti harki keeti na hin sooressa;","poem":2},{"lineBreak":true},{"text":"harki keeti middichi jabeessee na qabaayyu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ani, «Dukkanti dhugumaan na hin golliti;","poem":1},{"text":"ifi adaala kiyyaalle","poem":2},{"lineBreak":true},{"text":"halkan hin te'a!» yoo jedhe,","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"dukkantinuu sitti hin dukkanoottu;","poem":2},{"lineBreak":true},{"text":"si'iif dukkanti akka ifaa waan teeteef,","poem":2},{"lineBreak":true},{"text":"halkan akka guyya'aa ifa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Keessa namummaa tiyyaa ka dade si'i;","poem":1},{"text":"gadaamessa haadha tiyyaa keessatti","poem":2},{"lineBreak":true},{"text":"sittuu na dade.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ani baasa maso'oo te'ee waan dadameef,","poem":1},{"text":"ani si leellisa;","poem":2},{"lineBreak":true},{"text":"hujiin teeti waan maade'ee ti;","poem":2},{"lineBreak":true},{"text":"anille tana miidhassee beeka.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ani yennaa addee dhossa'aatitti dadame,","poem":1},{"text":"qilee gadaamessaa keessatti dadame;","poem":2},{"lineBreak":true},{"text":"lafeen tiyyaayyuu si duraa hin dhokanne.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Gadhaa haadha tiyyaa keessatti,","poem":1},{"text":"adoo ani dhiigaatuu,","poem":2},{"lineBreak":true},{"text":"ilti teeti na dhaggite;","poem":2},{"lineBreak":true},{"text":"dhaladhee barri jiruu tiyyaa","poem":2},{"lineBreak":true},{"text":"laakkowamiisa adoo hin jalqabin,","poem":2},{"lineBreak":true},{"text":"guyyooti naaf yaadamane marti","poem":2},{"lineBreak":true},{"text":"kitaaba keeti keessatti barreeffamane.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ee Waaqa, yaadi keeti hubatiisaaf","poem":1},{"text":"attam attam natti ulfaata!","poem":2},{"lineBreak":true},{"text":"Guutumatti attam attam bacata!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ani laakkowiisaaf yoo wodhaane,","poem":1},{"text":"maansa caala hin bacata;","poem":2},{"lineBreak":true},{"text":"ani yennaa dammaqu,","poem":2},{"lineBreak":true},{"text":"ammalle sima woliin jira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ee Waaqa, nama hamaa adoo ijjeettee!","poem":1},{"text":"Isin worri dhiiga namaa dhangalaasu","poem":2},{"lineBreak":true},{"text":"na irraa fagaadha'a!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Isaan hammeennaan","poem":1},{"text":"marroo teeti dubbatan;","poem":2},{"lineBreak":true},{"text":"diinoti keeti akkasumaan","poem":2},{"lineBreak":true},{"text":"maqaa keeti kaasan.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ani worra si jibbu hin jibba;","poem":2},{"lineBreak":true},{"text":"worra si irratti ka'ulle ani hin diqadha.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ani ijjumaa isaan jibba;","poem":1},{"text":"isaan diinota natti te'aneeran.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ee Waaqa, qorqoriitii gadhaa kiyya beeki;","poem":1},{"text":"haga na ilaaliitii yaaddoo tiyya beeki.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hammeenni yoo na keessa jiraate ilaali!","poem":1},{"text":"Karaa bara baraa irra na sooressi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}