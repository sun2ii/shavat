,","poem":1},{"text":"harka worra hama'aa irraa na eegi;","poem":2},{"lineBreak":true},{"text":"worra hunnaan nama irratti ka'u,","poem":2},{"lineBreak":true},{"text":"ka miila kiyya qaxafiisaaf","poem":2},{"lineBreak":true},{"text":"mala dhowanu irraa na eegi.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Worri kooru fonxoroo naaf afe;","poem":2},{"lineBreak":true},{"text":"isaan wodaroo caccoo ifii diriirsane;","poem":2},{"lineBreak":true},{"text":"tiyyoo karaa irratti naaf keyane.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ani si'iin, «Ati Waaqa kiyya» jedha;","poem":2},{"lineBreak":true},{"text":"ee Mootii Waan Maraa,","poem":2},{"lineBreak":true},{"text":"iyya tiyya dhage'i.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"Goottaa kiyya, jabaa na baachu;","poem":2},{"lineBreak":true},{"text":"ati guyyaa lolaa mataa kiyya golliteerta.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"fedhii nama hama'aa hin muummessiniif;","poem":2},{"lineBreak":true},{"text":"mala dhowelle hin milkeessiniif.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Worra na marsee mataa togu,","poem":1},{"text":"sababi afaan isaanii","poem":2},{"lineBreak":true},{"text":"isaanuma irratti garagaluu ti.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kashilli ibiddaa isaan irra bu'uu ti;","poem":1},{"text":"ibiddatti yookiin,","poem":2},{"lineBreak":true},{"text":"boolla deebi'anee keessaa hin baane,","poem":2},{"lineBreak":true},{"text":"keessatti gatamanuu ti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nami maqaa namaa balleessu","poem":1},{"text":"biyya keessatti hin qubatin!","poem":2},{"text":"Ka hunnaan nama irratti ka'ulle","poem":1},{"text":"wonni hantuun isa adansituu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"haajaa worra hiyyeeyyi'ii akka fixu,","poem":2},{"lineBreak":true},{"text":"worra rakkata'aaf","poem":2},{"lineBreak":true},{"text":"haqa akka muru ani hin beeka.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dhugumaan worri balchooleen","poem":1},{"text":"maqaa isaa hin leellisan;","poem":2},{"lineBreak":true},{"text":"worri qajeelaan fuula isaa dura hin le'an.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}