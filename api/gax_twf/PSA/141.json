in halchine,","poem":1},{"text":"worra hantuu huju woliin","poem":2},{"lineBreak":true},{"text":"qooda akka hin fudhanne na eegi;","poem":2},{"lineBreak":true},{"text":"worra hantuu huju woliin","poem":2},{"lineBreak":true},{"text":"sagalee isaanii dansaa","poem":2},{"lineBreak":true},{"text":"akka nyaadhu na hin lakkisin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nami balchaan na dhaaniis naaf dansa'a;","poem":1},{"text":"na xixiis isaalle akka dhadhaa mata'aa ti;","poem":2},{"lineBreak":true},{"text":"mataan kiyya dhadhaa hin jibbu.","poem":2},{"text":"Hujii worra hama'aa didiisaaf ammoo,","poem":1},{"text":"ani yennaa mara daadimadha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bulchitooti isaanii","poem":1},{"text":"yennaa bowwaa rassa'aatitti","poem":2},{"lineBreak":true},{"text":"gad qolaanfamane,","poem":2},{"lineBreak":true},{"text":"wonni ani dubbadhe","poem":2},{"lineBreak":true},{"text":"dhugaa akka teete hin beekan.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Isaan, «Akkuma nami lafa qotee butuchu,","poem":1},{"text":"lafeen teennalle","poem":2},{"lineBreak":true},{"text":"addee worri du'e jirutti bittinnootte»","poem":2},{"lineBreak":true},{"text":"hin jedhan.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"Goottaa kiyya,","poem":2},{"lineBreak":true},{"text":"ilti tiyya gara keeti ilaalti;","poem":2},{"lineBreak":true},{"text":"ani gara keeti baqadha;","poem":2},{"lineBreak":true},{"text":"akka ani du'u na hin lakkisin.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Fonxoroo isaan naaf afane irraa,","poem":1},{"text":"tiyyoo worra hantuu hujuu irraa na eegi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani nageyaan dabaree,","poem":1},{"text":"worri hamaan","poem":2},{"lineBreak":true},{"text":"tiyyoo ifumaaf afeen qabamuu ti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}