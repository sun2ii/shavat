{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":142,"content":[{"type":"heading","content":["Miidhaa Jalaa Bayiisaaf Daadimata Dhikaate"]},{"type":"heading","content":["Wolaloo Daawitii, ta yennaa inni gadda keessa jiruu; Daadimata."]},{"type":"verse","number":1,"content":[{"text":"Ani qoonqoo ol qabadhee,","poem":1},{"text":"gara Mootii Waan Maraa iyya;","poem":2},{"lineBreak":true},{"text":"marartii dhaggatiisaaf","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa gaafadha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Komii tiyya mara","poem":1},{"text":"isa duratti dhangalaasa;","poem":2},{"lineBreak":true},{"text":"rakkinna kiyyalle","poem":2},{"lineBreak":true},{"text":"isa duratti himadha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yennaa ani addii kutatiisa geyeeru,","poem":1},{"text":"gara ani ideemaaru ati hin beetta.","poem":2},{"text":"Daandii ani irra ideemu keessa,","poem":1},{"text":"isaan fonxoroo naaf dhossaneeran.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Adaala kiyya ilaalii dhaggi;","poem":1},{"text":"nami naaf yaadatu hin jiru;","poem":2},{"lineBreak":true},{"text":"addeen ani itti baqadhu hin jirtu;","poem":2},{"lineBreak":true},{"text":"nami tokkolle haajaa kiyya hin qabu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ani gara keeti iyya;","poem":2},{"lineBreak":true},{"text":"ani, «Ati ka ani itti baqadhu;","poem":2},{"lineBreak":true},{"text":"lafa worra jiraata'aa tana keessatti","poem":2},{"lineBreak":true},{"text":"ati qooda kiyya» jedha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani waan qarqaarsa hin qanneef,","poem":1},{"text":"iyya tiyya naaf caqasi;","poem":2},{"lineBreak":true},{"text":"worri na miidhu","poem":2},{"lineBreak":true},{"text":"guddoo waan natti jabaataneef,","poem":2},{"lineBreak":true},{"text":"ati isaan jalaa na baasi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Maqaa keeti akka leellifadhu,","poem":1},{"text":"hidhaa keessaa na baasi.","poem":2},{"text":"Ati waan dansaa waan naa gooteef,","poem":1},{"text":"worri balchaan na hin marsan.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}