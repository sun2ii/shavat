"verse","number":4,"content":[{"text":"Maarre ani addii kutatiisa geyeera;","poem":1},{"text":"gadhaa kiyya keessatti sodaadheera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Waan bara durii te'e hin qaabadha;","poem":1},{"text":"waan ati goote mara","poem":2},{"lineBreak":true},{"text":"itti deddeebi'ee hin yaada;","poem":2},{"lineBreak":true},{"text":"waan harki keeti huje hin herrega.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani harka kiyya gara keeti badhisa;","poem":1},{"text":"akka lafa goddee,","poem":2},{"lineBreak":true},{"text":"lubbuun tiyya si dheebotti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ani addii kutatiisa geyeera;","poem":2},{"lineBreak":true},{"text":"ariifadhuu deebii naa kenni;","poem":2},{"lineBreak":true},{"text":"yookiin ani akka worra","poem":2},{"lineBreak":true},{"text":"gara boollaa gad bu'uu hin te'a;","poem":2},{"lineBreak":true},{"text":"fuula keeti na duraa hin dhoffatin.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ani waan si addadhuuf,","poem":1},{"text":"ganama ganama bari'iin","poem":2},{"lineBreak":true},{"text":"jaalala keeti ka bara baraa natti lallabi.","poem":2},{"text":"Lubbuun tiyya gara keeti waan yaadduuf,","poem":1},{"text":"karaa ani irra deemu'uu male na barsiisi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ani gara keeti waan baqadheef,","poem":1},{"text":"Ee Mootii Waan Maraa,","poem":2},{"lineBreak":true},{"text":"diinota kiyya jalaa na baasi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ati Waaqa kiyya waan teeteef,","poem":1},{"text":"fedhii teeti akka muummessu na barsiisi.","poem":2},{"text":"Ayyaanni keeti dansaan","poem":1},{"text":"daandii qajeelaa irra na sooressuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"maqaa keetiif jedhiitii,","poem":2},{"lineBreak":true},{"text":"lubbuu tiyya jiraachisi;","poem":2},{"lineBreak":true},{"text":"balchummaa teetiin","poem":2},{"lineBreak":true},{"text":"rakkinna keessaa na baasi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Jaalala keeti ka bara baraatiin,","poem":1},{"text":"diinota kiyya fixi;","poem":2},{"lineBreak":true},{"text":"ani tajaajilaa keeti waan te'eef,","poem":2},{"lineBreak":true},{"text":"nyaaphota na rakkisu mara balleessi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}