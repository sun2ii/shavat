"text":"nami maan inni?","poem":2},{"lineBreak":true},{"text":"Yookiin akka ati isaaf yaadattuuf,","poem":2},{"lineBreak":true},{"text":"ilmi namaa maan inni?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nami akka baafata hafuuraa tokkochaa ti;","poem":1},{"text":"barri jiruu isaaniille","poem":2},{"lineBreak":true},{"text":"akka gaaddisa dabaruu ti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ol-gubbaa dayyaasii gad bu'i;","poem":2},{"lineBreak":true},{"text":"akka aarri keessaa bayu,","poem":2},{"lineBreak":true},{"text":"gaarota tuqi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Balaqqeettii balaqqisiitii","poem":1},{"text":"diinota bittinneessi;","poem":2},{"lineBreak":true},{"text":"daaya keeti darbadhuutii isaan ari'i.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gubbaa irraa harka keeti gad diriirsi;","poem":1},{"text":"bisaan guddaa keessaa,","poem":2},{"lineBreak":true},{"text":"harka ormaatii na baasiitii na hamburi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Afaan isaanii soba dubbata;","poem":1},{"text":"harka middicha ol kaasanee","poem":2},{"lineBreak":true},{"text":"dharaan kakatan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ee Waaqa,","poem":1},{"text":"ani faaruu haareya si'iif hin faarsa;","poem":2},{"lineBreak":true},{"text":"kiraara guddicha ribuu kudhan qabu","poem":2},{"lineBreak":true},{"text":"dhowataa si faarfadha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ati moototaaf injifachaa kennita;","poem":1},{"text":"tajaajilaa keeti Daawitille","poem":2},{"lineBreak":true},{"text":"shallaagaa ijjeesu jalaa hin hamburta.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Na hamburi;","poem":1},{"text":"harka worra ormaa keessaa na baasi;","poem":2},{"lineBreak":true},{"text":"afaan isaanii soba dubbata;","poem":2},{"lineBreak":true},{"text":"harka middicha ol kaasanee dharaan kakatan.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ilmaan teenna dargaggummaa ifiitiin","poem":1},{"text":"akka biqiltuu guddinna toltee,","poem":2},{"lineBreak":true},{"text":"ijoolleen durraa teenna","poem":2},{"lineBreak":true},{"text":"akka utubaa mana mootumma'aa seesiisaaf","poem":2},{"lineBreak":true},{"text":"bocamee te'anuu ti.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gootaraan keenna","poem":1},{"text":"midhaan adda addaatiin guutamuu ti;","poem":2},{"lineBreak":true},{"text":"hooloti teenna kumootaan,","poem":2},{"lineBreak":true},{"text":"kumoota kudhaniin","poem":2},{"lineBreak":true},{"text":"diida keenna keessatti hortuu ti.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Horiin keenna dodorrobuu ti;","poem":1},{"text":"gadha'aa gatiisi, sadheessiisi hin jiraatin.","poem":2},{"text":"Booji'amiis hin jiraatin;","poem":1},{"text":"karaa keenna irratti","poem":2},{"lineBreak":true},{"text":"iyyi gaddaa hin jiraatin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kolbaan eebbi akkasii te'eef gammadduu ti;","poem":1},{"text":"kolbaan Mootiin Waan Maraa","poem":2},{"lineBreak":true},{"text":"Waaqa isi'ii te'eef gammadduu ti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}