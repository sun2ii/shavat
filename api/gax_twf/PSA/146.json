{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nami Waaqi Yaaqoobii qarqaarsa isaa te'e,","poem":1},{"text":"ka Mootii Waan Maraa","poem":2},{"lineBreak":true},{"text":"Waaqa ifii addii godhatu gammaduu ti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mootiin Waan Maraa ol-gubba'aa fi lafa,","poem":1},{"text":"abbaaya'aa fi","poem":2},{"lineBreak":true},{"text":"waan isaan keessa jiru mara dade;","poem":2},{"lineBreak":true},{"text":"inni haga bara baraa","poem":2},{"lineBreak":true},{"text":"addatamummaa ifii hin eegata.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni worra cunqurfameef","poem":1},{"text":"haqaan mura;","poem":2},{"lineBreak":true},{"text":"worra beeloteef sagalee kenna.","poem":2},{"text":"Mootiin Waan Maraa","poem":1},{"text":"worra hidhame bilisa baasee,","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"worra ballaa ila bana.","poem":2},{"text":"Worra gad jedhe ol qaba;","poem":1},{"text":"worra balchaa jaalata.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mootiin Waan Maraa alagaa hin eega;","poem":1},{"text":"inni ijoollee abba'aa fi haadha hin qannee fi","poem":2},{"lineBreak":true},{"text":"haadhotii hiyyeessaa hin qarqaara;","poem":2},{"lineBreak":true},{"text":"karaa worra hama'aa ammoo hin balleessa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ee Xiyoon,","poem":1},{"text":"Waaqi keeti Mootiin Waan Maraa,","poem":2},{"lineBreak":true},{"text":"dhalootaa haga dhalootaatitti,","poem":2},{"lineBreak":true},{"text":"haga bara baraa hin bulcha.","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa leellisa'a.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}