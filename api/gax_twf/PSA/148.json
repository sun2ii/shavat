{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":148,"content":[{"type":"heading","content":["Dadi Marti Waaqa Leellisanuu Ti"]},{"type":"verse","number":1,"content":[{"text":"Mootii Waan Maraa leellisa'a!","poem":1},{"text":"Ol-gubbaa keessaa","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa leellisa'a;","poem":2},{"lineBreak":true},{"text":"gubbaa olii keessatti isa leellisa'a.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ergantooti isaa marti,","poem":1},{"text":"loltooti isaa ta ol-gubba'aa marti isa leellisa'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ji'aa fi aduun isa leellisa'a;","poem":1},{"text":"isin urjooti ifa kennitanu marti isa leellisa'a.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isin ol-gubbaan ol gubbootaa,","poem":1},{"text":"isin bisaan ol-gubba'aalle isa leellisa'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Isaan ajaja isaatiin waan dadamaneef,","poem":1},{"text":"maqaa Mootii Waan Maraa leellisanuu ti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inni haga bara baraa","poem":1},{"text":"addee isaaniititti jabeessee isaan dhaabe;","poem":2},{"lineBreak":true},{"text":"seera hin jijjiiranne isaanii kenne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bineensoti gugurdaan abbaayaa guddittii keessaa,","poem":1},{"text":"qileen abbaayaa gudditti'ii martinuu,","poem":2},{"lineBreak":true},{"text":"lafa irraa Mootii Waan Maraa leellisa'a!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Isin balaqqeetti'ii fi dhakaan roobaa,","poem":1},{"text":"qorrii fi hurriin,","poem":2},{"lineBreak":true},{"text":"hobonbolattiin ajaja isaa muummessitanu,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gaarotii fi kooboti martinuu,","poem":1},{"text":"mukooti midhaan buusuu fi","poem":2},{"lineBreak":true},{"text":"birbirsooti martinuu,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"bineensaa fi horiin martinuu,","poem":1},{"text":"bineensoti lafa irra lootanuu fi","poem":2},{"lineBreak":true},{"text":"koolaan kaatanu martinuu,","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa leellisa'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Moototi lafaatii fi","poem":1},{"text":"gosi biyya adda addaa martinuu,","poem":2},{"lineBreak":true},{"text":"qondaaltotii fi bulchitooti lafaa martinuu,","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"dargaggeeyyiin dhiiraatii fi durraa,","poem":2},{"lineBreak":true},{"text":"jaarsole'ee fi ijoolleen,","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa leellisa'a!","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Maqaan isaa callaan","poem":1},{"text":"ka saadame waan te'eef,","poem":2},{"lineBreak":true},{"text":"ulfinni isaa lafaa fi","poem":2},{"lineBreak":true},{"text":"ol-gubbaa irra waan jiruuf,","poem":2},{"lineBreak":true},{"text":"isaan maqaa Mootii Waan Maraa","poem":2},{"lineBreak":true},{"text":"leellisanuu ti.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kolbaan isaa Israa'elooti,","poem":1},{"text":"worri isatti dhikaatanu,","poem":2},{"lineBreak":true},{"text":"addatantooti isaa akka isa leellisanu,","poem":2},{"lineBreak":true},{"text":"jabeenna isaaniif kenne.","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa leellisa'a.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}