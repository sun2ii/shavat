{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":16,"content":[{"type":"heading","content":["Waaqatti Addii Godhatiisaaf Daadimata Dhikaate"]},{"type":"heading","content":["Faaruu Daawitii."]},{"type":"verse","number":1,"content":[{"text":"Ee Waaqa, ani sitti waan baqadhuuf,","poem":1},{"text":"ati na eegi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ani Mootii Waan Maraatiin,","poem":1},{"text":"«Ati Goottaa kiyya;","poem":2},{"lineBreak":true},{"text":"si'iin malee ani waan dansaa hin qabu» jedhe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Worri isaaf woyyoomee lafa irra le'u, ka ulfaate;","poem":1},{"text":"ani isaanitti gammada.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Worra waaqota dhibii waaqonfatu","poem":1},{"text":"gadda gudda'atti isaan dhaqqaba.","poem":2},{"text":"Ani waaqota dharaatiif","poem":1},{"text":"ciincaa dhiigaa hin dhikeessu;","poem":2},{"lineBreak":true},{"text":"afaan kiyyalle'een maqaa isaanii hin dhowu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"qoodi lafa tiyyaatii fi hireen tiyya si'i.","poem":2},{"lineBreak":true},{"text":"Qoodi lafa tiyyaa harka keeti keessa jira.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wodaroon tiyya ta meessaa ittiin mikanu","poem":1},{"noteId":3},{"text":"addee dansaa irra naaf buute;","poem":2},{"lineBreak":true},{"text":"dhugumaan ani lafa dansaa qaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ani Mootii Waan Maraa","poem":1},{"text":"ka gorsa naaf kennu hin leellifadha.","poem":2},{"lineBreak":true},{"text":"Halkan keessalle","poem":2},{"lineBreak":true},{"text":"wodanaan kiyya ifi na eeggachiisa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"fuula kiyya dura akka naaf jiru,","poem":2},{"lineBreak":true},{"text":"ani yennaa mara hin beeka.","poem":2},{"text":"Inni midda kiyya waan jiruuf,","poem":1},{"text":"ani hin raafamu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tanaaf, gadhaan kiyya hin gammada;","poem":1},{"text":"arrabi kiyya hin ilillisa;","poem":2},{"lineBreak":true},{"text":"nafi kiyyalle sodaa malee hin foorfata.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ati addee worri du'e jirutti","poem":1},{"text":"waan na hin lakkinneef,","poem":2},{"lineBreak":true},{"text":"ati woyyicha keeti akka shamu hin gootu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ati daandii jiru'uu natti hin mudhitta;","poem":1},{"text":"gammadi guutuun fuula keeti dura,","poem":2},{"lineBreak":true},{"text":"wonni haga bara baraa nama gammachiisu","poem":2},{"lineBreak":true},{"text":"harka keeti middicha keessa jira.","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Ittiin mikanu: Hagam akka dheeratu yookiin badhatu ittiin beekanu","reference":{"chapter":16,"verse":6}}]},"thisChapterLink":"/api/gax_twf/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}