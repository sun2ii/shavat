{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":17,"content":[{"type":"heading","content":["Daadimata Nama Yakkaa Malee Ari'amee"]},{"type":"heading","content":["Daadimata Daawitii."]},{"type":"verse","number":1,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"gaaffii tiyya ta haqaa dhage'i;","poem":2},{"lineBreak":true},{"text":"iyya tiyya caqasi.","poem":2},{"text":"Gurra keeti gara daadimata kiyya","poem":1},{"text":"ka soba hin te'inii deebifadhu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ilti teeti waan sirrii te'e waan dhaggituuf,","poem":1},{"text":"muraan tiyya si biraa naa dhuttuu ti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gadhaa kiyya yoo qorqorte,","poem":1},{"text":"halkaniin gara kiyya dhuttee,","poem":2},{"lineBreak":true},{"text":"yoo haga na ilaalte,","poem":2},{"lineBreak":true},{"text":"hammeenna na keessatti hin dhaggitu;","poem":2},{"lineBreak":true},{"text":"afaan kiyyalle cubbuu hin dubbatu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Jecha afaan keeti keessaa bayuuf ajajamee,","poem":1},{"text":"waan namooti hujanu irraa,","poem":2},{"lineBreak":true},{"text":"karaa isaan hunnaan nama irratti ka'anu irralle'ee,","poem":2},{"lineBreak":true},{"text":"ifi eeggadheera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ideensi kiyya daandii teeti eegateera;","poem":1},{"text":"miilli kiyyalle hin fallaanne.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ee Waaqa, ati waan naa dhageettuuf,","poem":1},{"text":"ani si waammadha;","poem":2},{"lineBreak":true},{"text":"gurra keeti gara kiyya deebifadhuutii,","poem":2},{"lineBreak":true},{"text":"jecha kiyya dhage'i.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Worra sitti baqatu,","poem":1},{"text":"harka keeti middichaan","poem":2},{"lineBreak":true},{"text":"diinota isaanii jalaa isaan ka baachu,","poem":2},{"lineBreak":true},{"text":"jaalala keeti ka bara baraa san","poem":2},{"lineBreak":true},{"text":"baasa godhii isaanitti mudhisi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Akka ila teetii na eegi;","poem":1},{"text":"bobaa teetii jalatti na dhossi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hamaaleyyii hunnaan na irratti ka'ane,","poem":1},{"text":"diinota kiyya worra hamaa na marsane irraa na eegi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Isaan gadhaa jabaataneeran;","poem":1},{"text":"afaan ifiitiin koora dubbatan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isaan ari'anee na marsaneeran;","poem":1},{"text":"lafatti gad na dhowiisaaf, ilaan na qabataneeran.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Isaan akka neenqa waan adanse kukkutatiisa fedhee,","poem":1},{"text":"akka neenqa dardaraa ka riphee wo gaaduu ti.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ee Mootii Waan Maraa","poem":1},{"text":"ka'iitii, lolii isaan gad dhowi!","poem":2},{"lineBreak":true},{"text":"Shallaagaa keetiin hamaaleyyii jalaa na baasi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mootii Waan Maraa, harka keetiin","poem":1},{"text":"worra jiruu biyya lafaa tana keessatti","poem":2},{"lineBreak":true},{"text":"waan barbaadanu mara qabanu","poem":2},{"lineBreak":true},{"text":"jalaa na baasi.","poem":2},{"lineBreak":true},{"text":"Ati rakkinna isaaniif kuucheen isaan adabi;","poem":1},{"text":"rakkinni kun ijoollee isaaniitii fi","poem":2},{"lineBreak":true},{"text":"ijoollee ijoollee isaaniitiifille akka te'u godhi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ani balchumma'aan fuula keeti hin ilaala;","poem":1},{"text":"ani yennaa dammaqu,","poem":2},{"lineBreak":true},{"text":"bifa keeti dhaggee hin quufa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}