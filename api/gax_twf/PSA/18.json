{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":18,"content":[{"type":"heading","content":["Faaruu Injifanno'oo"]},{"type":"heading","content":["Sooressa faarfattootaatiif, faaruu garbichi Mootii Waan Maraa Daawiti yennaa Mootiin Waan Maraa harka Saa'oliitii fi diinota isaa mara jalaa isa baase Mootii Waan Maraatiif faarfate."]},{"type":"verse","number":1,"content":[{"text":"Ee Mootii Waan Maraa, ati jabeenna kiyya;","poem":1},{"text":"ani si jaaladha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mootiin Waan Maraa rassaa kiyya,","poem":1},{"text":"waan itti golladhu;","poem":2},{"lineBreak":true},{"text":"ka na baasulle'e.","poem":2},{"text":"Waaqi kiyya rassaa kiyya ka ani itti baqadhu;","poem":1},{"text":"inni wontee tiyya;","poem":2},{"lineBreak":true},{"text":"ka akka gaafaa woy na irraa dhooggu;","poem":2},{"lineBreak":true},{"text":"inni waan ani itti golladhu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ani Mootii Waan Maraa leellifamaa","poem":1},{"text":"hin waammadha;","poem":2},{"lineBreak":true},{"text":"innille diinota kiyya jalaa na hin baasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wodaroon du'aa natti maratte;","poem":1},{"text":"danbaliin badi'ii na bararassite.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wodaroon qilee du'aa na xaxxee,","poem":1},{"text":"tiyyoon du'aa na qabatte.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Rakkinna kiyya keessatti","poem":1},{"text":"ani Mootii Waan Maraa kiyya waammadhe;","poem":2},{"lineBreak":true},{"text":"akka na qarqaaruuf,","poem":2},{"lineBreak":true},{"text":"Waaqa kiyyatti iyye.","poem":2},{"text":"Inni Dunkaanii Woyyittii ifii keessaa","poem":1},{"text":"qoonqoo tiyya dhage'e;","poem":2},{"lineBreak":true},{"text":"iyya tiyyalle caqase.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mootiin Waan Maraa waan aareef,","poem":1},{"text":"latti rommitee tachoote;","poem":2},{"lineBreak":true},{"text":"hundeen gaarotaalle hargufamanee raafamane.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Funnaan isaa keessaa aarri baye;","poem":1},{"text":"afaan isaa keessaa ibiddi luxub godhuu fi","poem":2},{"lineBreak":true},{"text":"kashilli ibiddaa baye.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inni ol-gubbaa dayyaasee gad bu'e;","poem":1},{"text":"duumensi gurraachi miila isaa jala jiraayyu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Inni dada ol-gubba'aa ta koola qaddu irra tee'ee,","poem":1},{"text":"koolaan ka'aa,","poem":2},{"lineBreak":true},{"text":"koola qilleensaa irra tee'ee ariifatee dhufiisatti jira.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inni dukkana gollaa ifii godhatee,","poem":1},{"text":"dunkaaniin isaa adaala isaa jirtiiyyu;","poem":2},{"lineBreak":true},{"text":"duumensi gurraachi bisaaniin guutame,","poem":2},{"lineBreak":true},{"text":"isa marseera.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Calalaqa fuula isaa dura jiru keessaa,","poem":1},{"text":"dhakaan bokkeyaatii fi kashilli ibiddaa","poem":2},{"lineBreak":true},{"text":"duumensa dayyaasanee bayane.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mootiin Waan Maraa ol-gubbaa irraa mandi'e;","poem":1},{"text":"Waaqi Ol Aanaan qoonqoo ifii dhageessise.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Inni daaya ifii darbatee diinota ifii bittinneesse;","poem":1},{"text":"balaqqeessa balaqqeetti'iitiin","poem":2},{"lineBreak":true},{"text":"gara itti goranu isaan wollaalchise.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ee Mootii Waan Maraa, xixicha keetiin,","poem":1},{"text":"dhowicha hafuura funnaan keetiitiin,","poem":2},{"lineBreak":true},{"text":"dhooqoti abbaayaa jalaa mudhatane;","poem":2},{"lineBreak":true},{"text":"hundeen lafaa marti qullaa hafane.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Inni gubbaa irraa gad hiixatee, na qabe;","poem":1},{"text":"bisaan gugurdaa keessaa harkisee na baase.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Isaan akka malee hunnaan waan na caalanuuf,","poem":1},{"text":"inni diinota kiyya hunnaameyyii,","poem":2},{"lineBreak":true},{"text":"worra na jibbu jalaa na baase.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yennaa ani rakkadhe, isaan na irratti ka'ane;","poem":1},{"text":"Mootiin Waan Maraa ammoo na qarqaare.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Inni gara addee badho'oo na geessee,","poem":1},{"text":"waan natti gammadeef, na baase.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"akkuma balchummaa tiyyaatitti naaf godhe;","poem":2},{"lineBreak":true},{"text":"inni waan ani yakkaa hin qanneef gatii naa kaffale.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ani karaa Mootii Waan Maraa waan hordofeef,","poem":1},{"text":"Waaqa kiyya irraa deebi'ee","poem":2},{"lineBreak":true},{"text":"waan hantuu hin hunye.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ani seera isaa mara muummesseera;","poem":1},{"text":"seerata isaalle hin didane.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ani isa duratti komii hin qabuuyyu;","poem":1},{"text":"cubbuu irraalle ifi eeggadheera.","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Mootiin Waan Maraa akkuma balchummaa tiyyaatitti,","poem":2},{"lineBreak":true},{"text":"ani waan yakkaa hin qanneef gatii naa kaffale.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ee, Mootii Waan Maraa,","poem":1},{"text":"ati worra addatama'aaf, ka addatante;","poem":2},{"lineBreak":true},{"text":"worra komii hin qanneef, ka komii hin qanne.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Worra qulqullu'uuf, ati qulqullu'u;","poem":1},{"text":"worra dabaalessaaf,","poem":2},{"lineBreak":true},{"text":"akka daba isaaniititti gatii isaaniif kennita.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ati worra gad ifi qabu hin baacha;","poem":1},{"text":"worra kooru ammoo hin salphitta.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ee Mootii Waan Maraa, ati ifa naaf hin issita;","poem":1},{"text":"Waaqa kiyya, ati dukkana tiyya hin issita.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Qarqaarsa keetiin ani loltoota hin lola;","poem":1},{"text":"qarqaarsa Waaqaatiin","poem":2},{"lineBreak":true},{"text":"dalleya gubba'aan utaaluu dande'a.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Karaan Waaqaa dhidhinna hin qabu;","poem":1},{"text":"jechi Mootii Waan Maraa dhuga'a;","poem":2},{"lineBreak":true},{"text":"worra isatti baqatuuf, inni wonte'e.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Waaqa malee Mootiin Waan Maraa eennu?","poem":1},{"text":"Waaqa keenna malee rassaan eennu?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Jabeenna ka anaaf kennu,","poem":1},{"text":"ka karaa naaf qajeelchu Waaqa.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Inni miila kiyya akka miila gadansaa hin jabeessa;","poem":1},{"text":"gaarota gubbaa sodaa malee na dhaabbachiisa.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Guubee sageettu'uu hujuu akka dande'u,","poem":1},{"text":"harka kiyyalle lolaaf hin leenjisa.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Wontee teeti ta fayyinnaa naa kennitee,","poem":1},{"text":"harki keeti middichi na qarqaare;","poem":2},{"lineBreak":true},{"text":"qarqaarsi keeti guddaa na godhe.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Karaa ideemmaa tiyyaa naaf badhitte;","poem":1},{"text":"miilli kiyya hin mucucaanne.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Ani diinota kiyya ari'ee hin dhaqqaba;","poem":1},{"text":"ani haga isaan balleessutti","poem":2},{"lineBreak":true},{"text":"gara duubaa hin deebi'u.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Akka isaan dande'anee hin kaane,","poem":1},{"text":"gad isaan hin dhowa;","poem":2},{"lineBreak":true},{"text":"isaan miila kiyya jalatti hin jigan.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Ati lolaaf hunna naaf kennite;","poem":1},{"text":"diinota kiyya irratti injifannoo naaf kennite.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Ati diinoti kiyya akka duubatti deebi'anu goote;","poem":1},{"text":"ani worra na jibbu balleesse.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Isaan qarqaarsa gaafatiisaaf iyyane;","poem":1},{"text":"ammoo nami tokkolle isaan hin qarqaarre.","poem":2},{"text":"Isaan Mootii Waan Maraa waamane;","poem":1},{"text":"inni ammoo deebii hin kennine.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Akka bukuu qilleensi afuufuu, ani isaan butuche;","poem":1},{"text":"akka dhoqqee karaa keessaa, ani isaan irra sirbe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Ati kolbaa na loltu jalaa na baattee","poem":1},{"noteId":4},{"text":",","poem":1},{"text":"gosa biyya adda addaa irratti bulchaa na goote;","poem":2},{"lineBreak":true},{"text":"kolbaan ani hin beenne na tajaajilti.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Isaan akkuma marroo tiyya dhage'aneen,","poem":1},{"text":"naaf ajajaman;","poem":2},{"lineBreak":true},{"text":"ormi gad naaf jedhan.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Isaan Sodaatanee addii kutatan;","poem":1},{"text":"rommanee kushee jadduu ifii lakkisanee bayan.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Mootiin Waan Maraa jiraata'a!","poem":1},{"text":"Rassaan kiyya leellifamuu ti!","poem":2},{"lineBreak":true},{"text":"Waaqi fayyisaan kiyya jajamuu ti.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Inni Waaqa diinota kiyya haluu naa bayu;","poem":1},{"text":"gosa biyya adda addaa harka kiyya jala galcha.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Inni diinota kiyya jalaa na baasa.","poem":1},{"text":"Diinota kiyya irratti ol ol na qaba;","poem":2},{"lineBreak":true},{"text":"kolbaa hunnaan na irratti kaatu jalalle'ee na baasa.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Tanaaf, Mootii Waan Maraa,","poem":1},{"text":"gosa biyya adda addaa oddu'utti, ani si leellisa;","poem":2},{"lineBreak":true},{"text":"Faaruu leellisaatiin maqaa keeti faarfadha.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Mootiin Waan Maraa mooticha mootii godheef,","poem":1},{"text":"injifachaa kenna;","poem":2},{"lineBreak":true},{"text":"ka ifii muude Daawitii fi sanyii isaatiif,","poem":2},{"lineBreak":true},{"text":"jaalala ifii ka bara baraa","poem":2},{"lineBreak":true},{"text":"itti mudhisa.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Baattee: Yookiin baache.","reference":{"chapter":18,"verse":43}}]},"thisChapterLink":"/api/gax_twf/PSA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/17.json","previousChapterAudioLinks":{},"numberOfVerses":50}