{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":19,"content":[{"type":"heading","content":["Dadi Ulfinna Waaqaa Mudhitti"]},{"type":"heading","content":["Faaruu Daawitii, sooressa faarfattootaatiif."]},{"type":"verse","number":1,"content":[{"text":"Ol-gubbaan ulfinnaa Waaqaa hinti;","poem":1},{"text":"gubbaan hujii harka isaa lalladdi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Guyyaan guyyaa itti aanutti kanuma dabarsa;","poem":1},{"text":"halkanille halkan itti aanutti woma kana hima.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dubbiin yookiin jechi hin jiru;","poem":1},{"text":"qoonqoon isaanii hin dhage'antu;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Te'uu malee ergaan isaanii","poem":1},{"text":"biyya lafaa duudi'itti baatee,","poem":2},{"lineBreak":true},{"text":"haga qaccee biyya lafaa geetti.","poem":2},{"text":"Inni adu'uuf gubbaa irratti dunkaanii dhaabe.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Aduun akka waajiba diinqa ifiitii gad bayuu baati;","poem":2},{"lineBreak":true},{"text":"akkuma nami rukkee wol doggommi'ii rukkisu","poem":2},{"lineBreak":true},{"text":"gammadaan rukkisu,","poem":2},{"lineBreak":true},{"text":"aduun rukkee wol doggommi'ii rukkisiisaaf gammaddi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Aduun dhuma qaccee gubba'aa taan irraa ol baatee,","poem":1},{"text":"gara qaccee taanii qaxxaamurti;","poem":2},{"lineBreak":true},{"text":"wonni o'a isi'ii duraa dhokatu hin jiru.","poem":2}]},{"type":"heading","content":["Seera Mootii Waan Maraa"]},{"type":"verse","number":7,"content":[{"text":"Seerri Mootii Waan Maraa dhidhuu hin qabu;","poem":1},{"text":"lubbuu haaressa.","poem":2},{"lineBreak":true},{"text":"Ajaji Mootii Waan Maraa addatama'a;","poem":2},{"lineBreak":true},{"text":"nama gowwaa qaroo godha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Seerri Mootii Waan Maraa sirri'i;","poem":1},{"text":"gadhaa nama gammachiisa.","poem":2},{"text":"Ajaji isaa ifa;","poem":1},{"text":"Ila namaa bana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mootii Waan Maraa sodaatiis yaada qullicha;","poem":1},{"text":"yaadi kun haga bara baraa jiraata.","poem":2},{"text":"Muraan Mootii Waan Maraa marti dhuga'a;","poem":1},{"text":"isiin yennaa mara haqa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Worqii gatii guddo'oo caalaa,","poem":1},{"text":"worqii baqisiisanee qulleessane caala'aayyuu gatii qaddi.","poem":2},{"text":"Damma caalaa,","poem":1},{"text":"nadhii dammaa caalaa mi'ootti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ani tajaajilaan keeti isi'iin gorfama;","poem":1},{"text":"isii eegatiisaan gatii guddoo dhaggadha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ka dokonkora ifii dhaggu eennu?","poem":1},{"text":"Cubbuu tiyya ta dhokatte irraa","poem":2},{"lineBreak":true},{"text":"na qulqulleessi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Cubbuu beekaa hujanu irraa","poem":1},{"text":"na garbicha keeti eegi;","poem":2},{"lineBreak":true},{"text":"akka isiin na mootu hin eeyyamin.","poem":2},{"text":"Yoos ani ka komii hin qannee fi","poem":1},{"text":"ka yakkaa guddoo hin qanne hin te'a.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"rassaa kiyyaa fi wodoo kiyya!","poem":2},{"lineBreak":true},{"text":"Jechi afaan kiyyaatii fi","poem":2},{"lineBreak":true},{"text":"yaadi gadhaa kiyyaa","poem":2},{"lineBreak":true},{"text":"si duratti fudhatama qabaatanuu ti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}