{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":20,"content":[{"type":"heading","content":["Daadimata Injifannoo Dhaggatiisaaf Dhikaate"]},{"type":"heading","content":["Faaruu Daawitii, sooressa faarfattootaatiif."]},{"type":"verse","number":1,"content":[{"text":"Guyyaa rakkinna keetii","poem":1},{"text":"Mootiin Waan Maraa si'iif dhage'u!","poem":2},{"lineBreak":true},{"text":"Maqaan Waaqa Yaaqoobii si eegu!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inni Dunkaanii Woyyittii ifi keessaa","poem":1},{"text":"qarqaarsa si'iif ergu;","poem":2},{"lineBreak":true},{"text":"gaara Xiyoonii irraa qarqaarsa siif ergu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inni kennansa keeti mara fudhatee","poem":1},{"text":"ciincaa keeti maratti gammaduu ti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inni halchaa gadhaa keetii sii kennu;","poem":1},{"text":"yaada keeti mara sii guutu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yennaa ati injifatte","poem":1},{"text":"nuuti gammadaan hin ilillinna;","poem":2},{"lineBreak":true},{"text":"Waaqa keenna leellisiisaan","poem":2},{"lineBreak":true},{"text":"baandiraa keenna ol kaafanna;","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa","poem":2},{"lineBreak":true},{"text":"waan ati gaafate mara si'iif guutu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"ka ifii muude akka qarqaaru ani hin beeka;","poem":2},{"lineBreak":true},{"text":"inni ol-gubbaa woyyittii ifii keessaa","poem":2},{"lineBreak":true},{"text":"deebii isaaf hin kenna;","poem":2},{"lineBreak":true},{"text":"harka ifii middichaan","poem":2},{"lineBreak":true},{"text":"injifachaa guddoo isaaf hin kenna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Worri gariin","poem":1},{"text":"garreettaa lolaa ka fardaan harkifamu ifiititti,","poem":2},{"lineBreak":true},{"text":"worri gariin fardoo ifiititti addata;","poem":2},{"lineBreak":true},{"text":"nuuti ammoo","poem":2},{"lineBreak":true},{"text":"maqaa Mootii Waan Maraa Waaqa keennaatitti addanna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Isaan gufatanee hin jigan;","poem":1},{"text":"nuuti ammoo kaanee jabaannee hin dhaabbanna.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ee Mootii Waan Maraa! Mooticha injifachiisi!","poem":1},{"text":"Yennaa nuuti si waammannu nuuf dhage'i!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}