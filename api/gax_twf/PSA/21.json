{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":21,"content":[{"type":"heading","content":["Galata Injifachaa Dhagganteef Dhikaate"]},{"type":"heading","content":["Faaruu Daawitii, sooressa faarfattootaatiif."]},{"type":"verse","number":1,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"mootichi jabeenna keetiin gammada;","poem":2},{"lineBreak":true},{"text":"injifachaa ati isaa kenniteen,","poem":2},{"lineBreak":true},{"text":"gammadi isaa attam attam gudda'a!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ati halchaa gadhaa isaa isaaf kenniteerta;","poem":1},{"text":"waan inni si gaafate ati isa hin dhoogganne.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Eebba gudda'aan gara isaa waan dhutteef,","poem":1},{"text":"mataa isaa irra kallacha worqii qullu'uu keetteerta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inni jiruu si gaafate;","poem":1},{"text":"atille bara dheeraa haga bara baraa isaaf kennite.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ati injifachaa waan isaaf kenniteef,","poem":1},{"text":"ulfinni isaa guddaa te'e;","poem":2},{"lineBreak":true},{"text":"ati ulfinnaa fi guddinna isaaf kennite.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eebba bara baraa isaaf kennite;","poem":1},{"text":"ati isa woliin waan jirtuuf, isa gammachiitta.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mootichi Mootii Waan Maraatitti addata;","poem":1},{"text":"sababa jaalala bara baraa ka Waaqa Ol Aana'aatiif,","poem":2},{"lineBreak":true},{"text":"inni hin raafamu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Harki keeti diinota keeti mara hin dhowa;","poem":1},{"text":"harki keeti middichi worra si jibbu hin qaba.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ati yennaa mudhattu,","poem":1},{"text":"akka barbada ibiddaa isaan gudda.","poem":2},{"text":"Mufii teetiin isaan hin fixa;","poem":1},{"text":"ibiddi isaan luxub godha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ati sanyii isaanii lafa irraa,","poem":1},{"text":"hiddaa fi hidaada isaanii","poem":2},{"lineBreak":true},{"text":"ilmaan namootaa oddu'uu hin balleessita.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isaan yoo hantuu si irratti yaadane,","poem":1},{"text":"mala yoo sitti dhowane, isaaniif hin teetu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ati guubee teeti gara isaanii hin qadda,","poem":1},{"text":"gara duubaa deebi'anee akka baqatanu hin goota.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ee Mootii Waan Maraa, jabeenna keetiin ka'i!","poem":1},{"text":"Nuuti faarfannee hunna teeti hin leellinna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}