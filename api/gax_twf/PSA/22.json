{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":22,"content":[{"type":"heading","content":["Iyya Gaddaatii Fi Faaruu Leellisaa"]},{"type":"heading","content":["Sooressa faarfattootaatiif, faaruu Daawitii ta yoyyoma, «Gadansa dayya'a boru'uu» jedhantuun faarfatante."]},{"type":"verse","number":1,"content":[{"text":"Waaqa kiyya, Waaqa kiyya, maaf na lakkitte?","poem":1},{"text":"Ati maaf na qarqaariisa irraa,","poem":2},{"lineBreak":true},{"text":"jecha aadiisa kiyyaa irraa fagaatte?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Waaqa kiyya, ani guyyaa gara keeti iyya,","poem":1},{"text":"ati ammoo naaf hin deebittu;","poem":2},{"lineBreak":true},{"text":"halkanille hin iyya,","poem":2},{"lineBreak":true},{"text":"ammoo foora hin dhaggadhu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Te'uu malee ati Waaqa woyyicha.","poem":1},{"text":"Leellisi worra Israa'elii","poem":2},{"lineBreak":true},{"text":"barcumaa mootumma'aa keeti marsa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Abbootiin teenna ta durii sitti addatte;","poem":1},{"text":"isaan si addatanee,","poem":2},{"lineBreak":true},{"text":"atille isaan baache.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isaan gara keeti iyyanee bayane;","poem":1},{"text":"sitti addataneelle hin fokkifanne.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani ammoo corroqa malee namaa moti;","poem":1},{"text":"namooti natti murgan; kolbaalle na tuffatti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ka na dhaggu marti natti murga;","poem":1},{"text":"isaan arraba baasanee mataa natti raasaa,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"«Inni Mootii Waan Maraatitti addateeraa,","poem":1},{"text":"inni isa hamburuu ti me!","poem":2},{"lineBreak":true},{"text":"Inni waan isa jaalatuuf,","poem":2},{"lineBreak":true},{"text":"isa baasuu ti me!» naan jedhan.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ati nageyaan akka dhaladhu na gootee,","poem":1},{"text":"harma haadha tiyyaa irralle'etti na eedde.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gadaamessa haadha tiyyaatii jalqabee","poem":1},{"text":"ka na eege si'i;","poem":2},{"lineBreak":true},{"text":"gadhaa haadha tiyyaatii jalqaddee","poem":2},{"lineBreak":true},{"text":"ati Waaqa kiyya teeteerta.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Rakkinni na dhaqqabiisaaf waan dhikaateef,","poem":1},{"text":"ka na qarqaarulle waan hin jirreef,","poem":2},{"lineBreak":true},{"text":"na irraa hin fagaatin.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Diinoti hedduun akka korommi'ii na marsaneeran;","poem":1},{"text":"worri jajjaboon akka korommii Baashaanii","poem":2},{"lineBreak":true},{"text":"na naannessaneeran.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Akka neenqa waan adanse kukkutataa dhangaa dhowuu,","poem":1},{"text":"isaan afaan ifii natti banan.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hunni tiyya akka bisaanii jiddeerti;","poem":1},{"text":"mitikaan lafee tiyyaa marti gargar bayeera.","poem":2},{"text":"Gadhaan kiyya akka gaga'aa","poem":1},{"text":"na baqeera.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Afaan kiyya akka basso'oo gogee,","poem":1},{"text":"arrabi kiyyalle laagada'atti na qabate;","poem":2},{"lineBreak":true},{"text":"ati akka nama du'ee bukuu keessa na irkitte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Worri akka sare'ee na marse;","poem":1},{"text":"goliin worra hantuu hujuu na naannessanee,","poem":2},{"lineBreak":true},{"text":"harka kiyyaa fi miila kiyya woraananee fullaasane.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ani huqqadhee lafeen tiyya mudhatte;","poem":1},{"text":"diinoti kiyya ila natti qabanee na ilaalane.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Woyaa tiyya qoqoodamanee,","poem":1},{"text":"ruufa kiyyatti hixaa buufatane.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ee Mootii Waan Maraa kiyya,","poem":1},{"text":"ati ammoo na irraa hin fagaatin!","poem":2},{"lineBreak":true},{"text":"Ee qarqaaraa kiyya,","poem":2},{"lineBreak":true},{"text":"na qarqaariisaaf ariifadhuu koy!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Lubbuu tiyya shallaagaa jalaa,","poem":1},{"text":"jiruu tiyya hunna saroolee tanaa jalaa baasi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Afaan neenqaa jalaa na hamburi;","poem":1},{"text":"gaafa gafarsaa jalaa na baasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ani guddinna maqaa keetii kolbaa tiyyatti hin hima;","poem":1},{"text":"wolde'a gumii isaanii keessatti ani si hin leellisa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Isin worri Mootii Waan Maraa sodaattanu,","poem":1},{"text":"isa leellisa'a!","poem":2},{"text":"Isin sanyiin Yaaqoobii marti,","poem":1},{"text":"isa ulfeessa'a!","poem":2},{"text":"Isin kolbaan Israa'elii marti,","poem":1},{"text":"isa saadadha'a!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Inni nama rakkate hin tuffanne;","poem":1},{"text":"inni fuula ifiille isa irraa hin deebifanne;","poem":2},{"lineBreak":true},{"text":"ammoo yennaa inni gara isaa iyye isaaf dhage'e.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Waan ati hujjeef,","poem":1},{"text":"gumii guddoo keessatti ani si leellisa;","poem":2},{"lineBreak":true},{"text":"worra si sodaatu duratti waan waadaa gale","poem":2},{"lineBreak":true},{"text":"ani si'iif hin kenna.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Worri hiyyeeyyiin nyaatanee hin quufan;","poem":1},{"text":"worri Mootii Waan Maraa barbaadu,","poem":2},{"lineBreak":true},{"text":"isa hin leellisan.","poem":2},{"text":"Baruma baraan gadhaan keessan gammadaan le'uu ti!","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Kolbaan lafa irraa marti qaabattee","poem":1},{"text":"gara Mootii Waan Maraa hin deebiti;","poem":2},{"lineBreak":true},{"text":"maatiin gosa biyya adda addaa marti","poem":2},{"lineBreak":true},{"text":"isaaf hin sagaddi.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Baalliin ta Mootii Waan Maraa waan te'eef,","poem":1},{"text":"inni gosa biyya adda addaa hin bulcha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Worri dureeyyiin marti isaaf hin sagadan;","poem":1},{"text":"nami foon uffate marti isa duratti hin jilbiiffatan.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Dhalooti hegerii isa hin tajaajilan;","poem":1},{"text":"dhaloota dhufutti","poem":2},{"lineBreak":true},{"text":"marroon waan Mootii Waan Maraa","poem":2},{"lineBreak":true},{"text":"itti hin himama.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Isaan dhufanee hujii balchummaa isaa lassaa,","poem":1},{"text":"balchummaa inni huje","poem":2},{"lineBreak":true},{"text":"worra amma hin dhalatiniif hin himan.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}