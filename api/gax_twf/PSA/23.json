oon teeti na jajjabeessan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Adoo diinoti kiyya dhagganuu,","poem":1},{"text":"ati nyaata naaf qopheessita.","poem":2},{"text":"Mataa kiyya zayitii ejersaa","poem":1},{"noteId":5},{"text":"muudda;","poem":1},{"text":"muduunuun tiyyalle guuttee irraa dhangalaati.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dhugumaan, bara jiruu tiyyaa mara,","poem":1},{"text":"dansummaan teetii fi","poem":2},{"lineBreak":true},{"text":"marartiin teeti na gula deeman;","poem":2},{"lineBreak":true},{"text":"bara le'ii tiyyaa mara","poem":2},{"lineBreak":true},{"text":"mana Mootii Waan Maraa keessa hin le'a.","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"Zayitii ejersaa: Akkuma Gujiin dhadhaa iffatu, Israa'elooti zayitii ejersaa iffatan.","reference":{"chapter":23,"verse":5}}]},"thisChapterLink":"/api/gax_twf/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}