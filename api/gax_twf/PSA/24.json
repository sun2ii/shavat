{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":24,"content":[{"type":"heading","content":["Mooticha Guddaa"]},{"type":"heading","content":["Faaruu Daawitii."]},{"type":"verse","number":1,"content":[{"text":"Lafaa fi wonni lafa irra jiru marti","poem":1},{"text":"ka Mootii Waan Maraa ti;","poem":2},{"lineBreak":true},{"text":"biyyi lafaatii fi worri isii keessa le'u marti ka isaa ti.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inni lafa hundee abbaaya'aa irra keye,","poem":1},{"text":"bisaan irra isii jabeessee dhaabe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gara kooba Mootii Waan Maraa ka ol bayu eennu?","poem":1},{"text":"Dunkaanii isaa woyyittii keessa ka dhaabbatu eennu?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nama harka qulqullu'uutii fi gadhaa qullu'uu,","poem":1},{"text":"ka waaqota dharaa hin waaqonfanne,","poem":2},{"lineBreak":true},{"text":"ka sobaan hin kakanne qofa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inni Mootii Waan Maraa biraa eebba,","poem":1},{"text":"Waaqa fayyisaa biraa balchummaa hin dhaggata.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dhalooti isa barbaadu isaan kana;","poem":1},{"text":"ee Waaqa Yaaqoobii,","poem":2},{"lineBreak":true},{"text":"worri fuula keeti barbaadu isaanuma kana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mootiin ulfinnaa akka seenu,","poem":1},{"text":"Ee Karra, gara maraan banama'a!","poem":2},{"lineBreak":true},{"text":"Isin balbala durii durii, badhadha'aa banama'a!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mootiin ulfinnaa kun eennu inni?","poem":1},{"text":"Inni Mootii Waan Maraa jaba'aa fi janna;","poem":2},{"lineBreak":true},{"text":"inni Mootii Waan Maraa ka lolaan jaba'aa ti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mootiin ulfinnaa akka seenu,","poem":1},{"text":"Ee karra, gara maraan banama'a!","poem":2},{"lineBreak":true},{"text":"Isin balbala durii durii, badhadha'aa banama'a!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mootiin ulfinnaa kun eennu inni?","poem":1},{"text":"Inni Mootii Waan Maraa Ka Waan Mara Dade,","poem":2},{"lineBreak":true},{"text":"mootii ulfinnaa ti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}