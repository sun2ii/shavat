{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":25,"content":[{"type":"heading","content":["Waaqaan sooreffamiisaa Fi Eegamiisaafiille Daadimata Dhikaate"]},{"type":"heading","content":["Faaruu Daawitii."]},{"type":"verse","number":1,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"lubbuun tiyya ol gara keeti yaaddi;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ee Waaqa kiyya, ani sitti addadha.","poem":1},{"lineBreak":true},{"text":"Akka fokkifadhu na hin godhin;","poem":1},{"text":"diinoti kiyya natti hin gammadin.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Worri addii sitti godhatu hin fokkifatu;","poem":1},{"text":"worri si'iif hin addatanne ammoo hin fokkifatan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"karaa keeti akka beeku na godhi;","poem":2},{"lineBreak":true},{"text":"daandii teeti na barsiisi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ati Waaqa fayyisaa kiyya waan teeteef,","poem":1},{"text":"dhugaa teetiin na sooressii, na barsiisi;","poem":2},{"lineBreak":true},{"text":"ani yennaa mara addii si godhadha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"marartii teetii guddo'oo fi","poem":2},{"lineBreak":true},{"text":"jaalala keeti ka bara baraa,","poem":2},{"lineBreak":true},{"text":"ka durii jalqaddee mudhitte yaadadhu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ee Mootii Waan Maraa, ati dansaa waan teeteef,","poem":1},{"text":"akka jaalala keeti ka bara baraatitti","poem":2},{"lineBreak":true},{"text":"naa yaadadhu malee,","poem":2},{"lineBreak":true},{"text":"cubbuu dargaggummaa tiyyaa","poem":2},{"lineBreak":true},{"text":"yookiin yakkaa tiyya hin yaadatin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mootiin Waan Maraa dansa'aa fi","poem":1},{"text":"balchaa waan te'eef,","poem":2},{"lineBreak":true},{"text":"inni cubbaaleyyii daandii ifii barsiisa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inni worra gad ifi qabu haqaan sooressaa,","poem":1},{"text":"karaa ifiille isaan hin barsiisa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Worra gondooroo isaatii fi ajaja isaa eegatanuuf,","poem":1},{"text":"Mootiin Waan Maraa","poem":2},{"lineBreak":true},{"text":"jaalala ifii ka bara baraatii fi","poem":2},{"lineBreak":true},{"text":"addatamummaa hin mudhisa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yakkaan tiyya bacaa waan teeteef,","poem":1},{"text":"ee Mootii Waan Maraa,","poem":2},{"lineBreak":true},{"text":"maqaa keetiif jedhii naaf araarami.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nami Mootii Waan Maraa sodaatu eennu?","poem":1},{"text":"Mootiin Waan Maraa","poem":2},{"lineBreak":true},{"text":"karaa inni filatu'uu male isa hin barsiisa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Inni jiruu dansaa hin jiraata;","poem":1},{"text":"sanyiin isaalle lafa hin dhaalti.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"worra isa sodaatu dhossaa ifii itti hima;","poem":2},{"lineBreak":true},{"text":"inni gondooroo ifii","poem":2},{"lineBreak":true},{"text":"akka isaanitti beekkantu hin godha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"miila kiyya tiyyoo keessaa waan baasuuf,","poem":2},{"lineBreak":true},{"text":"ilti tiyya yennaa mara gara isaa ilaalti.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ani qofuu waan jiruuf,","poem":1},{"text":"cunqurfamaalle waan te'eef,","poem":2},{"lineBreak":true},{"text":"fuula keeti gara kiyya deebifadhuu,","poem":2},{"lineBreak":true},{"text":"naaf mararfadhu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Rakkinni kiyya bindilla'a;","poem":1},{"text":"farra tiyya jalaa na baasi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Rakkinnaa fi farra tiyya ilaali;","poem":1},{"text":"cubbuu tiyya mara naa araarami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Diinoti kiyya attam attam akka bacatanu ilaali;","poem":1},{"text":"attam akka isaan na jibbanulle ilaali.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Na eegi; na baasi;","poem":1},{"text":"Ani waan sitti baqadheef,","poem":2},{"lineBreak":true},{"text":"akka ani fokkifadhu na hin godhin.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ani addi'iin waan si eegadhuuf,","poem":1},{"text":"addatamumma'aa fi qajeelummaan na eeganuu ti;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ee Waaqa, rakkinna isi'ii mara keessaa","poem":1},{"text":"kolbaa Israa'elii wodi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}