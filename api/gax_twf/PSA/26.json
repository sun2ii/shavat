{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":26,"content":[{"type":"heading","content":["Daadimata Nama Komii hin qannee"]},{"type":"heading","content":["Faaruu Daawitii."]},{"type":"verse","number":1,"content":[{"text":"Ani komii tokko malee,","poem":1},{"text":"sitti addadhee raafama malee waan le'eef,","poem":2},{"lineBreak":true},{"text":"Ee Mootii Waan Maraa, naaf muri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"na qorqori, hagalle na ilaali;","poem":2},{"lineBreak":true},{"text":"gadhaa kiyyaa fi qalbii tiyya qorqori.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jaalalli keeti ka bara baraa","poem":1},{"text":"ila tiyya dura jira;","poem":2},{"lineBreak":true},{"text":"anille dhugaa teetiin hin ideema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ani sobaaleyyii woliin hin tee'u;","poem":1},{"text":"worra kijiboolee jaala hin godhadhu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ani yaa'ii worra hantuu hujuu hin jibba;","poem":1},{"text":"hamaaleyyii wolille'een hin tee'u.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yakkaa akka hin qanne mudhisiisaaf,","poem":1},{"text":"harka dhiqadha;","poem":2},{"lineBreak":true},{"text":"Ee Mootii Waan Maraa,","poem":2},{"lineBreak":true},{"text":"addee ciinca'aa teeti cinaa mara.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Faaruu galataa guddisee faarfataa,","poem":1},{"text":"hujii maade'ee teeti hin odeessa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ee Mootii Waan Maraa, mana keeti addee ati leetu,","poem":1},{"text":"addee ulfinni keeti jiru, ani hin jaaladha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Lubbuu tiyya cubbaaleyyii woliin,","poem":1},{"text":"jiruu tiyya worra dhiiga namaa dhangalaasu woliin","poem":2},{"lineBreak":true},{"text":"hin balleessin.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Harka worra akkasii keessa karoora hama'atti jira;","poem":1},{"text":"harka isaanii middicha keessa safu'utti","poem":2},{"noteId":6},{"text":"guuteera.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ani ammoo komii malee le'a;","poem":1},{"text":"na wodi; na mararfadhu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Miilli kiyya lafa wol qixxee irra dhaabbateera;","poem":1},{"text":"gumii guddoo keessatti","poem":2},{"lineBreak":true},{"text":"ani Mootii Waan Maraa leellisa.","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"Safuu: Yookiin malaamaltumma.","reference":{"chapter":26,"verse":10}}]},"thisChapterLink":"/api/gax_twf/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}