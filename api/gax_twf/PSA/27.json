{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":27,"content":[{"type":"heading","content":["Daadimata Waaqatti Addatiisaa"]},{"type":"heading","content":["Faaruu Daawitii."]},{"type":"verse","number":1,"content":[{"text":"Mootiin Waan Maraa ifa kiyyaa fi fayyinna kiyya;","poem":1},{"text":"ani eennu sodaadha ree?","poem":2},{"text":"Mootiin Waan Maraa kushee jiruu tiyyaa ti;","poem":1},{"text":"eentu na sodaachisa ree?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Worri hamaaleyyiin foon kiyya nyaatiisaaf","poem":1},{"text":"yennaa natti dhufanu,","poem":2},{"lineBreak":true},{"text":"diinoti kiyyaa fi nyaapholeen tiyya","poem":2},{"lineBreak":true},{"text":"yennaa na lolanu,","poem":2},{"lineBreak":true},{"text":"isaanuu gufatanee hin jigan.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Loltooti duudiin na marsanulle,","poem":1},{"text":"ani hin sodaadhu;","poem":2},{"lineBreak":true},{"text":"lolli yoo natti ka'elle,","poem":2},{"lineBreak":true},{"text":"ani Mootuma Waan Maraa addadha.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ani waan tokko Mootii Waan Maraa gaafadha;","poem":1},{"text":"isiille dhaggatuu barbaada:","poem":2},{"lineBreak":true},{"text":"bara jiruu tiyyaa mara","poem":2},{"lineBreak":true},{"text":"mana Mootii Waan Maraa keessa akka le'u,","poem":2},{"lineBreak":true},{"text":"dansummaa isaa akka dhaggu,","poem":2},{"lineBreak":true},{"text":"Dunkaanii Woyyittii isaa keessatti","poem":2},{"lineBreak":true},{"text":"akka isa barbaadadhu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inni guyyaa rakkinnaa","poem":1},{"text":"mana ifii keessatti na hin eega;","poem":2},{"text":"Dunkaanii Woyyittii ifii keessatti na hin dhossa;","poem":1},{"text":"rassaa irratti ol na hin baasa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Achiin duuba diinota na marsaneeranu irratti","poem":1},{"text":"mataan kiyya ol hin jedha;","poem":2},{"lineBreak":true},{"text":"gammadaa ilillisaa addee dunkaanii isaatitti,","poem":2},{"lineBreak":true},{"text":"ciincaa isaaf hin dhikeessa;","poem":2},{"lineBreak":true},{"text":"faarfataa, Mootii Waan Maraa hin leellisa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ani yennaa si waamu,","poem":2},{"lineBreak":true},{"text":"naa dhage'i;","poem":2},{"lineBreak":true},{"text":"naa marariitii,","poem":2},{"lineBreak":true},{"text":"daadimata kiyya naa dhage'i.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gadhaan kiyya,","poem":1},{"text":"«Fuula isaa barbaadi» naan jedhe;","poem":2},{"lineBreak":true},{"text":"ee Mootii Waan Maraa,","poem":2},{"lineBreak":true},{"text":"ani fuula keeti barbaada.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fuula keeti na hin dhossin.","poem":2},{"lineBreak":true},{"text":"Ati aari'iin ana tajaajilaa keeti","poem":1},{"text":"ifi irraa hin fageessin;","poem":2},{"lineBreak":true},{"text":"ati qarqaarsa naaf teeteerta.","poem":2},{"text":"Ee Waaqa fayyisaa kiyya,","poem":1},{"text":"na hin gatin; na hin lakkisin!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abbaan kiyyaa fi haati tiyya","poem":1},{"text":"yoo na lakkisanelle","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa kiyya na hin fudhata.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"karaa keeti na barsiisi;","poem":2},{"lineBreak":true},{"text":"ani diinota hedduu waan qabuuf,","poem":2},{"lineBreak":true},{"text":"daandii qajeelaa irra na sooressi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dhugaa baatoti dharaa","poem":1},{"text":"hunnaan waan na irratti ka'aneef,","poem":2},{"lineBreak":true},{"text":"fedhii diinota kiyyaatiif","poem":2},{"lineBreak":true},{"text":"dabarsitee na hin kennin.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Lafa worra jiraata'aa keessatti","poem":1},{"text":"dansummaa Mootii Waan Maraa","poem":2},{"lineBreak":true},{"text":"akka dhaggu hin addadha.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mootii Waan Maraa eegadhu;","poem":1},{"text":"jabaadhu; addii hin kutatin;","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa eegadhu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}