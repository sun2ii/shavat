{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":28,"content":[{"type":"heading","content":["Daadimata Qarqaarsa Dhaggatiisaaf Dhikaate"]},{"type":"heading","content":["Faaruu Daawitii."]},{"type":"verse","number":1,"content":[{"text":"Ee Mootii Waan Maraa, ani si waammadha;","poem":1},{"text":"rassaa kiyya, ati na jalaa hin cadhisin!","poem":2},{"text":"Ati yoo na jalaa cadhitte,","poem":1},{"text":"ani akka worra boolla awwaalaatitti gad bu'ee hin te'a.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Qarqaarsa dhaggatiisaaf,","poem":1},{"text":"harka kiyya gara addee woyyittii woyyootaa teetii ol kaasee,","poem":2},{"lineBreak":true},{"text":"yennaa ani gara keeti iyyu,","poem":2},{"lineBreak":true},{"text":"daadimata kiyya naaf dhage'i.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Worra hamaaleyyii,","poem":1},{"text":"ka waan hantuu huju woliin na hin harkisin!","poem":2},{"text":"Isaan ollaa ifii woliin","poem":1},{"text":"afaaniin dubbii nageyaa dubbatan;","poem":2},{"lineBreak":true},{"text":"gadhaa ifii keessatti ammoo waan hantuu yaadan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ati akka hujii isaaniititti,","poem":1},{"text":"akka hujii hantuu isaaniititti gatii isaaniif kenni;","poem":2},{"text":"Akka hujii harka isaaniititti isaaniif kenni;","poem":1},{"text":"adabbii isaaniif malte isaaniif kenni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isaan hujii Mootii Waan Maraa","poem":1},{"text":"yookiin hujii harka isaa waan hin ilaalleef,","poem":2},{"lineBreak":true},{"text":"inni isaan hin diiga malee,","poem":2},{"lineBreak":true},{"text":"deebi'ee isaan hin ijaaru.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iyya tiyya waan dhage'eef,","poem":1},{"text":"Mootiin Waan Maraa leellifamu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mootiin Waan Maraa jabeenna kiyya;","poem":1},{"text":"wontee tiyyalle'e;","poem":2},{"lineBreak":true},{"text":"ani isatti addadha.","poem":2},{"text":"Inni waan na qarqaaree na gammachiiseef,","poem":1},{"text":"ani faaru'uun isa hin galateessa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"kolbaa ifiitiif jabeenna isaanii ti;","poem":2},{"lineBreak":true},{"text":"ka ifii muudeef kushee fayyinnaa ti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"kolbaa teeti baasi;","poem":2},{"lineBreak":true},{"text":"worra keeti te'ane eebbisi;","poem":2},{"lineBreak":true},{"text":"tissee isaanii te'iitii,","poem":2},{"lineBreak":true},{"text":"haga bara baraa isaan ba'adhu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}