:2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ani irkadhee hin rafa; Mootiin Waan Maraa","poem":1},{"text":"waan na eeguuf,","poem":2},{"lineBreak":true},{"text":"deebi'ee hin dammaqa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani loltoota kuma hedduu","poem":1},{"text":"ka na marsaneeranu","poem":2},{"lineBreak":true},{"text":"hin sodaadhu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ee Mootii Waan Maraa, ka'i!","poem":1},{"text":"Waaqa kiyya, koyii na baasi!","poem":2},{"text":"Boqoo diinota kiyyaa dhowi;","poem":1},{"text":"ilkaan isaaniille caccassi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Qarqaarsi Mootii Waan Maraa biraa dhufa.","poem":1},{"text":"Ee Mootii Waan Maraa, eebbi keeti","poem":2},{"lineBreak":true},{"text":"kolbaa teeti irra jiraatuu ti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}