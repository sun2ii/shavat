tii Waan Maraa faaru'uun leellisa'a;","poem":2},{"lineBreak":true},{"text":"maqaa isaa woyyichalle,","poem":2},{"lineBreak":true},{"text":"galateessa'a.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Aariin isaa yennaa diqqoo qofa;","poem":1},{"text":"tolli isaa ammoo bara jiru'uu mara.","poem":2},{"text":"Halkan bowaa yoo bulane,","poem":1},{"text":"ganama ammoo ililleessi hin te'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yennaa natti tole, ani ifiin,","poem":1},{"text":"«Ani ijjumaa hin raafamu» jedhe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"arnya keetiin,","poem":2},{"lineBreak":true},{"text":"akka gaara jabaa tokkoo na goote;","poem":2},{"lineBreak":true},{"text":"yennaa fuula keeti na duraa dhossite ammoo","poem":2},{"lineBreak":true},{"text":"guddoo sodaadhe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ani si waammadhee,","poem":2},{"lineBreak":true},{"text":"akka na marartuuf si gaafadhee,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"«Du'a tiyya irraa maan dhaggatta?","poem":1},{"text":"Ani yoo boollatti gad bu'e bu'aan maan?","poem":2},{"text":"Worri du'eeru si hin leellisaa?","poem":1},{"text":"Isaan addatamummaa teeti hin himanii?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mootii Waan Maraa,","poem":1},{"text":"naa dhage'i; naa marari;","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa,","poem":2},{"lineBreak":true},{"text":"na qarqaar» jedhe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ati gadda kiyya gara sirbaatitti jijjiirte;","poem":1},{"text":"woyaa gaddaa na irraa fuutee,","poem":2},{"lineBreak":true},{"text":"gammada natti uffitte.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yoona, ani hin cadhisu;","poem":1},{"text":"faaru'uun si leellisa.","poem":2},{"text":"Ee Mootii Waan Maraa Waaqa kiyya,","poem":1},{"text":"ani haga bara baraa si galateessa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}