{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":31,"content":[{"type":"heading","content":["Daadimata Waaqatti Adddatiisaa"]},{"type":"heading","content":["Faaruu Daawitii, sooressa faarfattootaatiif."]},{"type":"verse","number":1,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ani sitti baqadheera;","poem":2},{"lineBreak":true},{"text":"ani ijjumaa hin fokkifatin;","poem":2},{"lineBreak":true},{"text":"balchummaa teetiin na baasi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gurra keeti gara kiyya deebifadhu;","poem":1},{"text":"ariifadhuu na baasi.","poem":2},{"text":"Rassaa ani itti baqadhu,","poem":1},{"text":"na baasiisaaf, kushee jadduu naaf te'i.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ati rassaa kiyyaa fi kushee tiyya;","poem":1},{"text":"maqaa keetiif jedhii na sooressi;","poem":2},{"lineBreak":true},{"text":"naan duralle deemi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ati addee ani itti baqadhu waan teeteef,","poem":1},{"text":"tiyyoo diinoti naaf afane jalaa na baasi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ee Mootii Waan Maraa, Waaqa addatama'a,","poem":1},{"text":"ati na wodatteerta;","poem":2},{"lineBreak":true},{"text":"anille lubbuu tiyya harka keetitti kennadha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani worra waaqota dharaa waaqonfatu hin jibba;","poem":1},{"text":"ammoo Mootii Waan Maraatitti hin addadha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sababa jaalala keeti ka bara baraatiif,","poem":1},{"text":"ani gammadee hin ilillisa.","poem":2},{"text":"Ati farra tiyya dhaggiteerta;","poem":1},{"text":"rakkoo tiyyalle beetteerta.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ati harka diinotaatitti dabarsitee na hin kennine;","poem":1},{"text":"miila kiyya ammoo addee badhoo dhaabbachiitte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ani rakkatiisatti waan jiruuf,","poem":2},{"lineBreak":true},{"text":"naa marari;","poem":2},{"lineBreak":true},{"text":"bowa guddo'oon ilti tiyya dadhaddeerti;","poem":2},{"lineBreak":true},{"text":"lubbuun tiyyaa fi nafi kiyyalle gaddaan dadhabeera.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Barri jiruu tiyyaa gaddaan,","poem":1},{"text":"woggaan tiyya aadiisaan dabaraneeran;","poem":2},{"lineBreak":true},{"text":"sababa rakkoo tiyyaatiif hunna dhabe;","poem":2},{"lineBreak":true},{"text":"lafeen tiyyalle dadhadde.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Diinoti kiyya marti natti murgane;","poem":1},{"text":"ollaan kiyyalle irra caalaa natti murge;","poem":2},{"lineBreak":true},{"text":"worri na beeku natti fokkifata;","poem":2},{"lineBreak":true},{"text":"worri karaa irratti na dhaggu na irraa baqata.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Akka nama du'ee dedhame;","poem":1},{"text":"akka okkotee caddee te'e.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ani hasaassaa nama heddu'uu waan dhage'uuf,","poem":1},{"text":"adaala kiyya mara soda'atti jira.","poem":2},{"text":"Isaan wolitti qabamanee na irratti mari'atan;","poem":1},{"text":"na ijjeesiisaafille mala dhowan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ani ammoo si'itti addadha;","poem":2},{"lineBreak":true},{"text":"«Ati Waaqa kiyya» jedha.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ani yennaa mara harka keeti keessa jira;","poem":1},{"text":"harka diinota kiyyaatii fi","poem":2},{"lineBreak":true},{"text":"worra na ari'u jalaa na baasi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Fuulli keeti ana tajaajilaa keetitti ifuu ti;","poem":1},{"text":"jaalala keeti ka bara baraatiin na baasi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ani waan si waammadheef,","poem":2},{"lineBreak":true},{"text":"akka fokkifadhu na hin godhin.","poem":2},{"text":"Worri hamaaleyyiin fokkifatuu ti;","poem":1},{"text":"gara addee worri du'e jirutti gad bu'anee","poem":2},{"lineBreak":true},{"text":"cadhisanuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Afaan dharaamessi kooraa fi tuffi'iin","poem":1},{"text":"nama balchaa irratti dubbatu cadhisuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Wonni dansaan ta ati worra si sodaatuuf massite,","poem":1},{"text":"dansummaan ta ati ilmaan namootaa duratti,","poem":2},{"lineBreak":true},{"text":"worra sitti baqatuuf mudhitte,","poem":2},{"lineBreak":true},{"text":"attam attam guddo'o!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ati mala nami dhowu duraa","poem":1},{"text":"bobaa teeti jalatti,","poem":2},{"lineBreak":true},{"text":"jechoota hamaa duraa","poem":2},{"lineBreak":true},{"text":"dunkaanii teeti keessatti isaan dhossita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Yennaa ani qachaa marfame keessa jiru","poem":1},{"text":"Mootiin Waan Maraa","poem":2},{"lineBreak":true},{"text":"jaalala ifii ka bara baraatiin waan na jaalateef,","poem":2},{"lineBreak":true},{"text":"inni leellifamu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ani yennaa rifadhe,","poem":1},{"text":"«Fuula keeti duraa gatameera» jedheeraayyu.","poem":2},{"text":"Ati ammoo yennaa ani gara keeti iyye,","poem":1},{"text":"iyya tiyya naa dhageette.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Isin worri isaaf woyyoontane marti,","poem":1},{"text":"Mootii Waan Maraa jaaladha'a.","poem":2},{"text":"Mootiin Waan Maraa worra addatamaa hin eega;","poem":1},{"text":"worra kooru ammoo ijjumaa hin adaba.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Isin worri Mootii Waan Maraatitti addii godhattanu marti,","poem":1},{"text":"jabaadha'a; jajjabaadha'a.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}