{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":32,"content":[{"type":"heading","content":["Cubbuu faaci'atiisaa Fi Araara"]},{"type":"heading","content":["Wolaloo Daawitii."]},{"type":"verse","number":1,"content":[{"text":"Nami cubbuu isaatiif araarri kennameef,","poem":1},{"text":"ka yakkaan isaa lakkifanteef ka gammade.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nami Mootiin Waan Maraa cubbuu itti hin laakkonne,","poem":1},{"text":"ka soba ifi keessaa hin qanne ka gammade.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ani yennaa cubbuu tiyya faaci'atuu dhabe,","poem":1},{"text":"guyyaa guutuu aada.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ati halkanii fi guyyaa na adadde;","poem":1},{"text":"akka waan o'i bonaa gossee,","poem":2},{"lineBreak":true},{"text":"hunni tiyya na keessaa godde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Achiin duuba ani cubbuu tiyya sitti dhugaa baase;","poem":1},{"text":"yakkaa tiyyalle hin dhoffanne.","poem":2},{"text":"Ani «Cubbuu tiyya Mootii Waan Maraatitti dhugaa baasa» jedhe;","poem":1},{"text":"atille cubbuu tiyya naaf araarante.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tanaaf, nami addatamaan marti","poem":1},{"text":"gara keeti daadimatuu ti.","poem":2},{"text":"Rakkinni akka lolaa jaba'aa yennaa dhufe,","poem":1},{"text":"isa hin dhaqqabu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ati addee ani itti dhokadhu;","poem":1},{"text":"ati rakkinna irraa na eedda.","poem":2},{"text":"Ati ililleettii worra bayiisa kiyyatti firinxiixuun na marsite.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mootiin Waan Maraa,","poem":1},{"text":"«Ani karaa ati deemu'uu malte","poem":2},{"lineBreak":true},{"text":"si hubachiisee si barsiisa;","poem":2},{"lineBreak":true},{"text":"si gorsa; si toowadha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ati akka fardaa fi gaange'ee,","poem":1},{"text":"ka wo hin beennee hin te'in!","poem":2},{"text":"Bixaalaa fi lugaamaan ifitti yoo harkitte malee,","poem":1},{"text":"isaan sitti hin dhikaatanu» jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Farri worra cubbaaleyyi'ii heddu'u;","poem":1},{"text":"nama Mootii Waan Maraatitti addatu ammoo","poem":2},{"lineBreak":true},{"text":"jaalalli isaa ka bara baraa isa hin marsa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isin balchooleen","poem":1},{"text":"Mootii Waan Maraatiin gammada'aa ilillisa'a!","poem":2},{"lineBreak":true},{"text":"Isin worri gadhaa qajeela'aa ilillisa'a.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}