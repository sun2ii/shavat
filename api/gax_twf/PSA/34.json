{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":34,"content":[{"type":"heading","content":["Leellisa Mootii Waan Maraatiif Dhikaatu"]},{"type":"heading","content":["Daawiti akka maraata'aa te'ee, Abiimelek dura waan dhikaateef, Abiimelek isa ariinaan, yennaa achii deeme faaruu Daawiti faarfate."]},{"type":"verse","number":1,"content":[{"text":"Ani yennaa mara Mootii Waan Maraa hin leellisa;","poem":1},{"text":"isa saadiisille yennaa mara afaan kiyyaa hin bu'u.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ani Mootii Waan Maraatiin ifi jaja;","poem":1},{"text":"worri cunqurfame dhage'ee gammaduu ti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Na woliin guddinna Mootii Waan Maraa odeessa'a;","poem":1},{"text":"maqaa isaa tokkumma'aan leellinnuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ani gara Mootii Waan Maraa daadimadhee,","poem":1},{"text":"innille deebii naa kenne;","poem":2},{"lineBreak":true},{"text":"waan sodaadhu mara jalaa na baase.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Worri gara isaa ilaalu,","poem":1},{"text":"fuulli isaanii hin ifa;","poem":2},{"lineBreak":true},{"text":"isaan hin salphatanu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Namichi rakkataan kun isa waame,","poem":1},{"text":"Mootiin Waan Maraalle isaaf dhage'e;","poem":2},{"lineBreak":true},{"text":"rakkinna isaa mara keessaa isa baase.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ergamaan Mootii Waan Maraa","poem":1},{"text":"adaala worra isa sodaatuu hin qubata;","poem":2},{"lineBreak":true},{"text":"inni balaa jalaa isaan hin baasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mootiin Waan Maraa attam attam dansaa akka te'e","poem":1},{"text":"qorqora'aatii ilaala'a;","poem":2},{"lineBreak":true},{"text":"nami isatti baqatu ka gammade.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Worri Mootii Waan Maraa sodaatu","poem":1},{"text":"womaa waan hin dhanneef,","poem":2},{"lineBreak":true},{"text":"isin worri isaaf woyyoontane,","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa sodaadha'a.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dardarooti neenqaatuu dhabanee hin beelotan;","poem":1},{"text":"worri Mootii Waan Maraa barbaadu ammoo","poem":2},{"lineBreak":true},{"text":"waan dansaa hin dhabu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ee ijoolle! Gara kiyya kowa'aatii, na caqasa'a;","poem":1},{"text":"ani Mootii Waan Maraa sodaatiisa isin hin barsiisa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ka jiruu jaalatu,","poem":1},{"text":"waan dansaa dhaggiisaafille","poem":2},{"lineBreak":true},{"text":"bara hedduu ka halchu eennu?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Arraba keeti waan hantuu irraa,","poem":1},{"text":"hidhii teeti soba dubbatiisa irraa eegadhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Waan hantuu irraa fagaadhuutii,","poem":1},{"text":"waan dansaa godhi;","poem":2},{"lineBreak":true},{"text":"nageya barbaadiitii,","poem":2},{"lineBreak":true},{"text":"gula deemi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ilti Mootii Waan Maraa","poem":1},{"text":"gara balchoole'ee ilaalti;","poem":2},{"lineBreak":true},{"text":"gurri isaalle iyya isaanii caqasa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"worra waan hantuu huju hin morma;","poem":2},{"lineBreak":true},{"text":"lafa irratti akka isaan hin qaabatanne godha.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yennaa balchooleen gara isaa iyyitu,","poem":1},{"text":"Mootiin Waan Maraa isaaniif hin dhage'a;","poem":2},{"lineBreak":true},{"text":"inni rakkinna isaanii mara keessaa","poem":2},{"lineBreak":true},{"text":"isaan hin baasa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"worra guddoo gaddeeruuf dhikoo jira;","poem":2},{"lineBreak":true},{"text":"inni worra addii kutateeru hin baasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Rakkoon balcha'aa baca'a;","poem":1},{"text":"Mootiin Waan Maraa ammoo","poem":2},{"lineBreak":true},{"text":"waan mara keessaa isa hin baasa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Inni lafee isaa mara hin eega;","poem":1},{"text":"lafee isaa keessaa takkaalle hin caddu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hammeenni nama hamaa hin ijjeesa;","poem":1},{"text":"worra nama balchaa jibbu","poem":2},{"lineBreak":true},{"text":"yakkaan itti hin muranti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"jiruu tajaajiltoota ifii hin woda;","poem":2},{"lineBreak":true},{"text":"worra gara isaa baqatu keessaa","poem":2},{"lineBreak":true},{"text":"tokkolle'etti yakkaan itti hin murantu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}