{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":35,"content":[{"type":"heading","content":["Diinota Jalaa Bayiisaaf Daadimata Dhikaate"]},{"type":"heading","content":["Faaruu Daawitii."]},{"type":"verse","number":1,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"worra natti ka'u irratti ka'i;","poem":2},{"lineBreak":true},{"text":"worra na lolu loli.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wontee teetii fi meya lolaa keeti fudhadhuu","poem":1},{"text":"na qarqaariisaaf koy.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Worra na ari'utti ebo'oo fi urdee teeti fudhadhuutii,","poem":1},{"text":"lubbuu tiyyaan, «Ani fayyisaa keeti» jedhi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Worri na ijjeesiisaaf barbaadu","poem":1},{"text":"fokkifatee qaanowuu ti.","poem":2},{"text":"Worri mala natti dhowu","poem":1},{"text":"gara duubaa deebi'ee salphatuu ti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ergamaan Waaqaa isaan ari'uun,","poem":1},{"text":"akka huura qilleensi afuufuu te'anuu ti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ergamaan Mootii Waan Maraa isaan ari'uun","poem":1},{"text":"karaan isaanii dukkanaa fi mucucoo te'uu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Isaan sababa tokko malee","poem":1},{"text":"tiyyoo dhossa'aan naaf afanee,","poem":2},{"lineBreak":true},{"text":"na qabiisaaf boolla qotaneeran.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Adoo hin beekin","poem":2},{"lineBreak":true},{"text":"badiin isaan irratti dhuttuu ti.","poem":2},{"lineBreak":true},{"text":"Tiyyoon isaan dhossane","poem":2},{"lineBreak":true},{"text":"isaanuma qadduu ti;","poem":2},{"lineBreak":true},{"text":"Boolla qotane keessa bu'anee badanuu ti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Lubbuun tiyya","poem":1},{"text":"Mootii Waan Maraatiin hin gammaddi;","poem":2},{"lineBreak":true},{"text":"fayyisiisa isaatiin gammaddee firinxiixxi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gadhaa kiyya tokkochaan,","poem":1},{"text":"«Ee Mootii Waan Maraa,","poem":2},{"lineBreak":true},{"text":"dadhaboolee","poem":2},{"lineBreak":true},{"text":"worra guddoo jajjabaa harkaa,","poem":2},{"lineBreak":true},{"text":"dadhaboole'ee fi hiyyeeyyiille","poem":2},{"lineBreak":true},{"text":"saantota harkaa ka baasu","poem":2},{"lineBreak":true},{"text":"ka akka keetii eennu?» jedha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dhugaa baatoti dharaa natti ka'ane;","poem":1},{"text":"marroo waan ani hin beennee na gaafatane.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Qofi-galeessa na godhanee","poem":1},{"text":"waan dansaa ani godheef,","poem":2},{"lineBreak":true},{"text":"hantuu naaf deebisane.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ani ammoo yennaa isaan dhibamane,","poem":1},{"text":"woyaa gaddaa uffadhe;","poem":2},{"lineBreak":true},{"text":"laamiisaan ifi rakkise;","poem":2},{"lineBreak":true},{"text":"daadimati kiyyalle deebii dhabee,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"akka waan jaalaaf","poem":2},{"lineBreak":true},{"text":"yookiin obboleessaaf gadduutitti gadde;","poem":2},{"lineBreak":true},{"text":"akka nama haadha ifiitiif bowuu,","poem":2},{"lineBreak":true},{"text":"mataa gad qabadhee bowe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Yennaa ani gufadhe ammoo,","poem":1},{"text":"isaan gammadane;","poem":2},{"lineBreak":true},{"text":"dedhuma dhufanee","poem":2},{"lineBreak":true},{"text":"sababa malee arrabaan na kukkutane.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Akkuma worri Waaqa malee le'u godhu,","poem":1},{"text":"natti murgane;","poem":2},{"lineBreak":true},{"text":"ilkaan natti ciniinnatane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ee Gootta'a,","poem":1},{"text":"haga yoomii cadhittee na ilaalta?","poem":2},{"lineBreak":true},{"text":"Worra na miidhu,","poem":2},{"lineBreak":true},{"text":"ka akka neenqaa kana jalaa na baasi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Achiin duuba ani kolbaa teeti keessatti","poem":1},{"text":"si hin galateeffadha;","poem":2},{"lineBreak":true},{"text":"kolbaa bacaa keessatti si hin leellifadha.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Worri akkasumaan diina natti te'u,","poem":1},{"text":"natti hin gammadin;","poem":2},{"lineBreak":true},{"text":"worri akkasumaan na jibbu","poem":2},{"lineBreak":true},{"text":"na irratti ilaan wolitti hin qiphifatin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Isaan dubbii nageyaa hin dubbatanu;","poem":1},{"text":"worra biyya keessa nageyaan le'u irratti","poem":2},{"lineBreak":true},{"text":"dubbii dharaa yaadanee qopheessan.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Isaan, «Baga waan ati hujje dhaggine!» jedhaa,","poem":1},{"text":"afaan natti banan.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ee Mootii Waan Maraa, ati tana dhaggiteerta,","poem":1},{"text":"hin cadhisin!","poem":2},{"lineBreak":true},{"text":"Ee Gootta'a, na irraa hin fagaatin!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ee Gootta'a, Waaqa kiyya dammaqi!","poem":1},{"text":"Na irraa dhooggiisaaf ka'i!","poem":2},{"lineBreak":true},{"text":"Haajaa kiyyaaf loli.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ee Mootii Waan Maraa, Waaqa kiyya,","poem":1},{"text":"balchummaa teetiin naaf muri;","poem":2},{"lineBreak":true},{"text":"diinoti kiyya natti hin gammadin.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Isaan, «Halchaa gadhaa keennaa","poem":1},{"text":"baga dhagganne!","poem":2},{"lineBreak":true},{"text":"Nuuti ijjumaa isa balleessineerra» hin jedhin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Worri rakkinna kiyyatti gammadu marti","poem":1},{"text":"fokkifatanee qaanowanuu ti;","poem":2},{"lineBreak":true},{"text":"worri na irratti ifi saadu marti","poem":2},{"lineBreak":true},{"text":"fokko'oo fi salphinna uffatuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Worri muraa haqaa","poem":1},{"text":"dhaggatiisa kiyyatti gammadu marti","poem":2},{"lineBreak":true},{"text":"gammadaan ilillisanuu ti;","poem":2},{"lineBreak":true},{"text":"isaan «Mootiin Waan Maraa gudda'a!","poem":2},{"lineBreak":true},{"text":"Inni yennaa tajaajilaan nageya dhaggatu","poem":2},{"lineBreak":true},{"text":"hin gammada!» jedhanuu ti.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Arrabi kiyya balchummaa teetii dubbataa,","poem":1},{"text":"guyyaa guutuu si hin leellisa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}