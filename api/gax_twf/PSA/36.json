{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":36,"content":[{"type":"heading","content":["Hammeenna Namaatii Fi Arjummaa Waaqaa"]},{"type":"heading","content":["Faaruu Daawitii tajaajilaa Mootii Waan Maraa, sooressa faarfattootaatiif."]},{"type":"verse","number":1,"content":[{"text":"Cubbuun nama hamaa gadhaa ifii keessatti","poem":1},{"text":"hammeenna akka yaadatu gooti;","poem":2},{"lineBreak":true},{"text":"Inni ijjumaa Waaqa hin sodaatu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inni yakkaa ifii dhaggee akka hin jibbine,","poem":1},{"text":"ifumaan ifi sossoba.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dubbiin afaan isaa hammeennaa fi","poem":1},{"text":"dharaan guutanteerti;","poem":2},{"lineBreak":true},{"text":"inni qarumma'aan hujiisaa fi","poem":2},{"lineBreak":true},{"text":"waan dansaa godhiisa lakkiseera.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inni rifanoo irra adoo jiruu hantuu yaadata;","poem":1},{"text":"karaa hamaa ideema;","poem":2},{"lineBreak":true},{"text":"waan hantuu hin didatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"jaalalli keeti ka bara baraa haga ol-gubba'aa,","poem":2},{"lineBreak":true},{"text":"addatamummaan teetille","poem":2},{"lineBreak":true},{"text":"haga duumensaa hin dhaqqaddi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"balchummaan teeti akka gaarota gugurda'aa ti;","poem":2},{"lineBreak":true},{"text":"muraan teeti akka gad fageenna abbaaya'aa ti;","poem":2},{"lineBreak":true},{"text":"ati namaa fi horii,","poem":2},{"lineBreak":true},{"text":"bineensalle hin eedda.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ee Waaqa, jaalalli keeti ka bara baraa","poem":1},{"text":"attam attam ka gatii guddoo qabu!","poem":2},{"lineBreak":true},{"text":"Kolbaan marti gaaddisa koola keetii jalatti baqatti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Isaan sagalee bacaa mana keetii nyaatan;","poem":1},{"text":"ati laga keeti gammachiisaa irraa","poem":2},{"lineBreak":true},{"text":"bisaan isaaniif kennita.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ati madda jiru'uu ti;","poem":1},{"text":"nuuti ifa keetiin ifa dhaggina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Worra si beekuuf, jaalalli keeti ka bara baraa,","poem":1},{"text":"worra gadhaa-qajeela'aatiif","poem":2},{"lineBreak":true},{"text":"balchummaan keeti irraa hin citin.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Miilli worra kooruu na hin dhiitin,","poem":1},{"text":"harki worra hamaaleyyi'ii na hin ari'in.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Worri hamaaleyyiin attam akka jigane ilaali;","poem":1},{"text":"isaan jiganeeran, ka'uu hin dande'anu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}