{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":37,"content":[{"type":"heading","content":["Hiree worra Balcha'aatii Fi worra hama'aa"]},{"type":"heading","content":["Faaruu Daawitii."]},{"type":"verse","number":1,"content":[{"text":"Sababa worra hama'aatiif hin aarin;","poem":1},{"text":"worra cubbuu huju hin hinaafin.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isaan akka marraa ariifatanee hin gogan;","poem":1},{"text":"akka baala bisile'ee hin qooran.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mootii Waan Maraatitti addadhuu waan dansaa godhi;","poem":1},{"text":"biyya keessa nageyaan le'i.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mootii Waan Maraatitti gammadi;","poem":1},{"text":"inni halchaa gadhaa keetii si'iif hin kenna.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Karaa keeti Mootii Waan Maraatitti kennadhu;","poem":1},{"text":"isa addadhu; innille si'iif hin milkeessa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inni balchummaa teeti akka ifaa,","poem":1},{"text":"haqa haajaa keetii akka aduu saafowaa hin godha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mootii Waan Maraa duratti cadhisiitii,","poem":1},{"text":"ossaan isa eeggadhu;","poem":2},{"lineBreak":true},{"text":"worra hamaaleyyii","poem":2},{"lineBreak":true},{"text":"yaad hamaan isaanii toleef itti hin aarin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Aarii irraa ifi dhooggi; mufii irraa deebi'i.","poem":1},{"text":"Aariin gara hammeennaa qofa si geessitii, hin aarin.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Worri hamaaleyyiin hin badan;","poem":1},{"text":"Worri Mootii Waan Maraa eegatu ammoo","poem":2},{"lineBreak":true},{"text":"lafa hin dhaalan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nami hamaan yennaa diqqo'oon duuba,","poem":1},{"text":"achitti hin dhaggamu.","poem":2},{"lineBreak":true},{"text":"Ati isa hin barbaadda, ammoo hin dhaggitu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Worri gad ifi qabu lafa hin dhaalan;","poem":1},{"text":"nageya gudda'aan hin gammadan.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nami hamaan nama balchaa irratti mala dhowa;","poem":1},{"text":"ilkaan itti ciniinnatta.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Guyyaan nami hamaan sun badu","poem":1},{"text":"akka dhufaaru waan beekuuf,","poem":2},{"lineBreak":true},{"text":"Goottaan ammoo itti kolla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Worri hamaaleyyiin,","poem":1},{"text":"worra hiyyeeyyi'ii fi worra deega ijjeesiisaaf,","poem":2},{"lineBreak":true},{"text":"worra qajeelaa qaliisaaf,","poem":2},{"lineBreak":true},{"text":"shallaagaa ifii buqqifatan;","poem":2},{"lineBreak":true},{"text":"guubeelle qopheeffatan.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Shallaagaan isaanii ammoo","poem":1},{"text":"gadhuma isaanii hin woraana;","poem":2},{"lineBreak":true},{"text":"guubeen isaaniille hin caccaddi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Karra nama hama'aa hedduu caalaa,","poem":1},{"text":"karra nama balcha'aa diqqoo woyya.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hunni worra hamaaleyyi'ii hin caddi;","poem":1},{"text":"worra balchoolee ammoo","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa hin utuba.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"worra komii hin qanne guyyuma guyya'aan eega;","poem":2},{"lineBreak":true},{"text":"kennansi inni isaanii kenne","poem":2},{"lineBreak":true},{"text":"haga bara baraa hin badu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Isaan yennaa hantuu keessalle hin salphatanu;","poem":1},{"text":"bara beelaalle hin quufan.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Worri hamaaleyyiin ammoo hin badan;","poem":1},{"text":"diinoti Mootii Waan Maraalle","poem":2},{"lineBreak":true},{"text":"akka marra diidaa hin dhumatan;","poem":2},{"lineBreak":true},{"text":"isaan akka aaraa hin badan.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nami hamaan liqaa hin deebisu;","poem":1},{"text":"nami balchaan ammoo arjumma'aan kenna.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Worri Mootiin Waan Maraa eebbise lafa dhaalan;","poem":1},{"text":"Worri Mootiin Waan Maraa abaare ammoo hin badan.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"karaa namaatitti yennaa gammade,","poem":2},{"lineBreak":true},{"text":"karaa isaaf akeekee, ijjata isaa jabeessa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mootiin Waan Maraa harka ifiitiin isa waan qabuuf,","poem":1},{"text":"yoo gufatelle hin jigu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ani dur dargageessa; amma dulloomeera;","poem":1},{"text":"ani Mootiin Waan Maraa nama balchaa gateeruun,","poem":2},{"lineBreak":true},{"text":"yookiin ijoolleen isaa sagalee kadhattuun","poem":2},{"lineBreak":true},{"text":"ijjumaa dhaggee hin beeku.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nami balchaan yennaa mara arjumma'aan kenna;","poem":1},{"text":"hin liqeessalle'e;","poem":2},{"lineBreak":true},{"text":"sanyiin isaalle worra dhibi'iif eebba hin teeti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Waan hantuu irraa deebi'ii, waan dansaa godhi;","poem":1},{"text":"bara dheeraa hin leeta.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"muraa dhuga'aa waan jaalatuuf,","poem":2},{"lineBreak":true},{"text":"inni worra isaaf addatamu hin lakkisu.","poem":2},{"text":"Inni haga bara baraa nageyaan isaan eega;","poem":1},{"text":"sanyiin worra hamaaleyyi'ii ammoo hin baddi.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Worri balchooleen lafa hin dhaalan;","poem":1},{"text":"lafa san keessalle bara dheeraa hin le'an.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Afaan nama balcha'aa qarummaa odeessa;","poem":1},{"text":"arrabi isaa haqa dubbata.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Seerri Waaqaa qalbii isaa keessa jira;","poem":1},{"text":"miilli isaalle hin fallaadu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Nami hamaan nama balchaa riphee gaada;","poem":1},{"text":"ijjeesiisaaf isa barbaada.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Mootiin Waan Maraa ammoo","poem":1},{"text":"harka diinaatitti isa hin kennu;","poem":2},{"lineBreak":true},{"text":"muraa dura yennaa dhikaate,","poem":2},{"lineBreak":true},{"text":"yakkaan akka itti murantu hin godhu.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Mootii Waan Maraa addi'iin eegadhu;","poem":1},{"text":"karaa isaalle eegadhu;","poem":2},{"lineBreak":true},{"text":"inni lafa si dhaalchisiisaaf ulfinna si'iif hin kenna;","poem":2},{"lineBreak":true},{"text":"badii worra hamaaleyyi'iille hin dhaggita.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ani nama hamaa hunnaan nama irratti ka'u","poem":1},{"text":"ka akka muka lafa itti toltu irra jiruu tokko","poem":2},{"lineBreak":true},{"text":"dagaageeruun dhagge.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Eega san yennaa achiin dabaru, adde'ee dhabe;","poem":1},{"text":"ani isa barbaade,","poem":2},{"lineBreak":true},{"text":"ammoo isa dhagguu hin dandeenne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Nama komii hin qanne ilaali;","poem":1},{"text":"nama balchichaa hubadhu;","poem":2},{"lineBreak":true},{"text":"nama nageellicha muummeen isaa hin baddu.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Cubbaaleyyiin ammoo ijjumaa hin badan;","poem":1},{"text":"muummeen isaaniille hin baddi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Mootiin Waan Maraa balchoolee hin baasa;","poem":1},{"text":"yennaa rakkinnaa addeen isaan itti baqatanu isa.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Isaan Mootii Waan Maraatitti waan baqatanuuf,","poem":1},{"text":"inni isaan qarqaaree, isaan baasa;","poem":2},{"lineBreak":true},{"text":"inni harka worra hamaaleyyi'ii irraa","poem":2},{"lineBreak":true},{"text":"isaan baasee, isaan hambura.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}