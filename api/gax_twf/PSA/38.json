{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":38,"content":[{"type":"heading","content":["Daadimata Yennaa Rakkinnaa"]},{"type":"heading","content":["Faaruu Daawitii ta akka Waaqi isa qaabatuuf faarfatante."]},{"type":"verse","number":1,"content":[{"text":"Ee Mootii Waan Maraa, aari'iin na hin xixin;","poem":1},{"text":"mufi'iin na hin adabin.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Daayi keeti na woraaneera;","poem":1},{"text":"harki keeti gad na qabe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sababa mufii teetiitiif, nafi kiyya dhibameera;","poem":1},{"text":"sababa cubbu'uutiif, lafeen tiyya fayyaa hin qaddu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yakkaan tiyya mataa kiyya irra dabarteerti;","poem":1},{"text":"isiin akka ba'a'aa guddoo natti ulfaatteerti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sababa gowwummaa tiyyaatiif,","poem":1},{"text":"madaan tiyya shantee ajootti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani gad jedhee, guddoo gugguufe;","poem":1},{"text":"guyyaa guutuu bowaa daaqe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hidhi kiyya waan na o'eef,","poem":1},{"text":"nafi kiyya fayyaa hin qabu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ani dadhabee, ijjumaa bututeera;","poem":1},{"text":"gadhaan waan na raafameef aada.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ee Goottaa kiyya, ati halchaa tiyya mara beetta;","poem":1},{"text":"aadiisi kiyya si duraa dhokatee hin jiru.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Onneen tiyya na dhowatti; hunni tiyya na laatteerti;","poem":1},{"text":"ilti tiyyalle dhagguu dhaddeerti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jaaloti tiyyaa fi lansooti kiyya","poem":1},{"text":"sababa madaa tiyyaatiif na irraa baqatane;","poem":2},{"lineBreak":true},{"text":"firri kiyyaayyuu na irraa fagaatane.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Worri na ijjeesiisaaf barbaadu tiyyoo natti afan;","poem":1},{"text":"worri na miidhiisaaf barbaadu","poem":2},{"lineBreak":true},{"text":"na balleessiisaaf mari'atan;","poem":2},{"lineBreak":true},{"text":"isaan guyyaa guutuu mala natti dhowan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ani ammoo akka nama gurra duudee, hin dhage'u;","poem":1},{"text":"akka nama afaan duudee, hin dubbadhu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dhugumaan, ani akka nama hin dhageennee,","poem":1},{"text":"akka nama deebii deebisuu hin dandeennee ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ani ammoo addi'iin si eegadha;","poem":2},{"lineBreak":true},{"text":"Ee Goottaa Waaqa kiyya,","poem":2},{"lineBreak":true},{"text":"atille deebii naaf hin kennita.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ani, «Worri yennaa miilli kiyya mucucaatu na irratti kooru,","poem":1},{"text":"akka isaan natti gammadanu hin godhin!» jedhe.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ani jiguu geyeera;","poem":1},{"text":"yennaa mara ani dhibee woliin jira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Yakkaa tiyya hin faaci'adha;","poem":1},{"text":"cubbuu tiyyaaf gadda.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Diinoti kiyya hunnaameyyiin baca'a;","poem":1},{"text":"worri sababa malee na jibbu heddu'u.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yennaa ani waan dansaa huju","poem":1},{"text":"waan hantuu naaf deebisan;","poem":2},{"lineBreak":true},{"text":"yennaa ani waan dansaa hordofu","poem":2},{"lineBreak":true},{"text":"isaan na morman.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ee Mootii Waan Maraa, na hin lakkisin;","poem":1},{"text":"Waaqa kiyya, na irraa hin fagaatin.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ee Goottaa fayyisaa kiyya,","poem":1},{"text":"na qarqaariisaaf ariifadhuu koy.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}