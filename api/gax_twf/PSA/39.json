{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":39,"content":[{"type":"heading","content":["Jiruu Namaa Gabaadduu"]},{"type":"heading","content":["Faaruu Daawitii, Sooressa faarfattootaa Yedutu'uuf."]},{"type":"verse","number":1,"content":[{"text":"Ani, «Arraba kiyyaan cubbuu akka hin dubbanne","poem":1},{"text":"lafa dhaqu maratti ifi hin eegadha;","poem":2},{"lineBreak":true},{"text":"haga nami hamaan na bira jiru,","poem":2},{"lineBreak":true},{"text":"ani womaa hin dubbadhu» jedheera.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jecha tokkolle hin dubbatinuu cadhise;","poem":1},{"text":"marroo waan dansa'aalle hin dubbanne;","poem":2},{"lineBreak":true},{"text":"rakkinni kiyya ammoo guddataatuma ideeme.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gadhaan kiyya na gubatee,","poem":1},{"text":"yaada kiyya keessatti ibiddi gabbate;","poem":2},{"lineBreak":true},{"text":"achiin duuba ani arraba kiyyaan dubbadhee,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"«Mootii Waan Maraa kiyya, dhuma jiruu tiyyaa,","poem":1},{"text":"barri jiruu tiyyaa hagam akka te'e natti himi;","poem":2},{"lineBreak":true},{"text":"ani jiruun tiyya","poem":2},{"lineBreak":true},{"text":"attam ariifattee dabariisatti akka jirtu beekuu ti!» jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ati bara jiruu tiyyaa taakkuu takkaa goote;","poem":1},{"text":"barri jiruu tiyyaa","poem":2},{"lineBreak":true},{"text":"si duratti woyitti hin laakkowamu.","poem":2},{"text":"Dhugumaan jiruu nama maraatuu","poem":1},{"text":"akka baafata hafuuraa tokkochaa ti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dhugumaan nami akka gaaddisaa ti.","poem":1},{"lineBreak":true},{"text":"Inni akkanumaan elowa;","poem":1},{"text":"karra tuulata; ammoo ka isii fudhatu hin beeku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Goottaa kiyya, amma ani maan eegadha ree?","poem":1},{"text":"Addiin tiyya si'i.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Cubbuu tiyya mara jalaa na baasi;","poem":1},{"text":"worri gowwooleen akka natti murganu hin godhin.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akka akkana rakkadhu ka godhe si waan teeteef,","poem":1},{"text":"ani hin cadhisa; afaan kiyya hin saaqadhu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dhowicha harka keetiitiin dadhabeera;","poem":1},{"text":"dhowicha keeti na irraa kaasi.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ati sababa yakkaa isaatiif,","poem":2},{"lineBreak":true},{"text":"nama xixxee hin adadda;","poem":2},{"lineBreak":true},{"text":"akka waan qu'een nyaattee","poem":2},{"lineBreak":true},{"text":"karra isaa hin balleessita.","poem":2},{"lineBreak":true},{"text":"Dhugumaan nami akka baafata hafuura tokkochaa ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ee Mootiin Waan Maraa,","poem":1},{"text":"daadimata kiyya naa dhage'i;","poem":2},{"lineBreak":true},{"text":"iyya tiyyalle caqasi;","poem":2},{"lineBreak":true},{"text":"imimmaan tiyyatti hin cadhisin.","poem":2},{"text":"Ani si duratti alaga'a;","poem":1},{"text":"akkuma abbootii tiyya ta durii keessumma'a.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gara hin deebinetti, gara du'aa adoo hin deemin,","poem":1},{"text":"gammada diqqaa akka dhaggadhu,","poem":2},{"lineBreak":true},{"text":"nyaara guurtee na hin ilaalin.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}