{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":40,"content":[{"type":"heading","content":["Faaruu Leellisaa"]},{"type":"heading","content":["Faaruu Daawitii, sooressa faarfattootaatiif."]},{"type":"verse","number":1,"content":[{"text":"Ani ossaan Mootii Waan Maraa eegadhe;","poem":1},{"text":"innille gara kiyya deebi'ee iyya tiyya dhage'e.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inni boolla caffa'aa,","poem":1},{"text":"linxixxoo dhoqqe'ee keessaa na baase.","poem":2},{"text":"Inni miila kiyya rassaa irra dhaabbachiisee,","poem":1},{"text":"addee jadduu ani ideemu naa kenne.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inni faaruu haareya","poem":1},{"text":"leellisa Waaqa keennaa afaan kiyya keessa keye.","poem":2},{"text":"Worri hedduun tana dhagganee isa sodaatanee,","poem":1},{"text":"Mootii Waan Maraatitti addatan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nami Mootii Waan Maraatitti addatu,","poem":1},{"text":"gara worra koorameeyyi'iitii fi,","poem":2},{"lineBreak":true},{"text":"dharaameyyi'ii deebi'iisaan ka itti hin addanne,","poem":2},{"lineBreak":true},{"text":"ka gammade.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ee Mootii Waan Maraa Waaqa kiyya,","poem":1},{"text":"baasa hedduu nuu gooteerta;","poem":2},{"lineBreak":true},{"text":"ka akka keetii hin jiru!","poem":2},{"lineBreak":true},{"text":"Ati waan baasaa nuu yaadatteerta.","poem":2},{"text":"Laakkossi waan kanaa guddoo baca'a;","poem":1},{"text":"ani ijjumaa odeessee fixee hin dande'u.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ati ciinca'aa fi kennansa hin barbaaddu;","poem":1},{"text":"horiin addee ciinca'aa irratti akka ciinceffamu,","poem":2},{"lineBreak":true},{"text":"yookiin ciincaa araara cubbu'uu hin barbaaddu.","poem":2},{"text":"Tanaa manna, gurra sii dhage'u naaf kenniteerta.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Tanaaf anille, «Marroo tiyyaaf","poem":2},{"lineBreak":true},{"text":"kitaaba maramaa keessatti akkuma barreeffante,","poem":2},{"lineBreak":true},{"text":"kunoo, ani dhufeera;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Waaqa kiyya,","poem":1},{"text":"ani fedhii teeti muummessuu halcha;","poem":2},{"lineBreak":true},{"text":"seerri keeti gadhaa kiyya keessa jira» jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ani wolde'a guddicha keessatti,","poem":1},{"text":"balchummaa teeti odeessa.","poem":2},{"lineBreak":true},{"text":"Ee Mootii Waan Maraa,","poem":2},{"lineBreak":true},{"text":"akkuma ati beettu ani odeessuu ijjumaa hin lakkisu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani balchummaa teeti gadhaa kiyya keessatti","poem":1},{"text":"hin dhossine;","poem":2},{"lineBreak":true},{"text":"ani addatamummaa teetii fi","poem":2},{"lineBreak":true},{"text":"fayyisiisa keeti odeesseera.","poem":2},{"text":"Wolde'a keeti guddicha duraa","poem":1},{"text":"jaala keeti ka bara baraatii fi","poem":2},{"lineBreak":true},{"text":"addatamummaa teeti hin dhossine.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ati marartii teeti na hin dhooggatin;","poem":2},{"lineBreak":true},{"text":"jaalalli keeti ka bara baraatii fi addatamummaan teeti","poem":2},{"lineBreak":true},{"text":"yennaa mara na eeganuu ti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Rakkoon hedduun haga hin qanne na marsiteerti;","poem":1},{"text":"haga ani woy dhagguu dadhabutti,","poem":2},{"lineBreak":true},{"text":"cubbuun tiyya na liqinsiteerti;","poem":2},{"lineBreak":true},{"text":"cubbuun tun rifeensa mataa kiyyaa caalti;","poem":2},{"lineBreak":true},{"text":"anille jajjabaatiisa dadhabeera.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ee Mootii Waan Maraa, maganne'ee na baasi;","poem":1},{"text":"na qarqaariisaaf ariifadhuu koy.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Worri na ijjeesiisa barbaadu marti","poem":1},{"text":"fokkifatanee qaanowanuu ti.","poem":2},{"text":"Worri miidhama kiyya halchu marti","poem":1},{"text":"salphinnaan gara duuba deebi'anuu ti.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Worri, «Baga, baga» naan jedhu,","poem":1},{"text":"fokkoo ifiitiin nayanee goganuu ti.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Worri si barbaadu marti ammoo","poem":1},{"text":"si'itti gammadanee ilillisanuu ti;","poem":2},{"text":"Worri fayyisiisa keeti jaalatanu marti","poem":1},{"text":"yennaa mara,","poem":2},{"lineBreak":true},{"text":"«Mootiin Waan Maraa gudda'a!» jedhanuu ti.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Akka kiyyatti, ani rakkata'a; dadhabaalle'e;","poem":1},{"text":"Gootta'a na hin dedhin.","poem":2},{"text":"Ka na qarqaaruu fi ka na baasu si'i;","poem":1},{"text":"Ee Waaqa kiyya, hin turin.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}