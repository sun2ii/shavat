{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":42,"content":[{"type":"heading","content":["Daadimata Nama Booji'amee"]},{"type":"heading","content":["Wolaloo ilmaan Qoraahii, sooressa faarfattootaatiif."]},{"type":"verse","number":1,"content":[{"text":"Akkuma gadansi bisaan yaa'u dharra'u,","poem":1},{"text":"Ee Waaqa, anille si dharra'a.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lubbuun tiyya Waaqa,","poem":1},{"text":"Waaqa jiraataa dheebotti;","poem":2},{"lineBreak":true},{"text":"ani yoom dhaqee fuula isaa","poem":2},{"lineBreak":true},{"text":"dhagguu dande'a ree?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kolbaan yennaa mara,","poem":1},{"text":"«Waaqi keeti meet?» waan naan jettuuf,","poem":2},{"lineBreak":true},{"text":"halkanii fi guyyaa imimmaan sagalee tiyya teeteerti;","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ani gumii san woliin,","poem":1},{"text":"gumii jila jilifattu woliin,","poem":2},{"lineBreak":true},{"text":"ililleetti'ii fi faaruu galataatiin,","poem":2},{"lineBreak":true},{"text":"gogeessaan sooressaa","poem":2},{"lineBreak":true},{"text":"gara Galma Waaqaa attam akka deeme yennaa qaabadhu,","poem":2},{"lineBreak":true},{"text":"gadhaan kiyya gaddaan na bada.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ee lubbuu tiyya maaf gaddita?","poem":1},{"text":"Na keessatti maaf jeeqanta?","poem":2},{"text":"Ani deebi'ee Waaqa fayyisaa kiyya waan leellifadhuuf,","poem":1},{"text":"Waaqa keetitti addii godhadhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lubbuun tiyya na keessatti gadditeerti;","poem":1},{"text":"tanaaf ani lafa Yordaanosiitii fi","poem":2},{"lineBreak":true},{"text":"kooba Hermoonii irraa,","poem":2},{"lineBreak":true},{"text":"gaara Mizaarii irralle'ee si qaabadha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Shookkessa gootuu teetiitiin","poem":1},{"text":"qileen qilee waanti;","poem":2},{"lineBreak":true},{"text":"hunni guddoon danbalii teetii na gubbaa yaate.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mootiin Waan Maraa guyyaa mara","poem":1},{"text":"jaalala ifii ka bara baraa mudhisa;","poem":2},{"lineBreak":true},{"text":"anille halkan faaruu isaaf dhikeessa;","poem":2},{"lineBreak":true},{"text":"gara Waaqa jiruu tiyyaa daadimadha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ani Waaqa rassaa kiyyaan, «Ati maaf na deete?","poem":1},{"text":"Diinoti kiyya waan na cunqursaneef,","poem":2},{"lineBreak":true},{"text":"ani maaf bowaa ideema?» jedha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Diinoti kiyya yennaa mara, «Waaqi keeti meet?» jedhiisaan na arrassaa lafee na cassan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ee lubbuu tiyya maaf gaddita?","poem":1},{"text":"Na keessatti maaf jeeqanta?","poem":2},{"text":"Ani deebi'ee Waaqa fayyisaa kiyya waan leellifadhuuf,","poem":1},{"text":"Waaqa keetitti addii godhadhu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}