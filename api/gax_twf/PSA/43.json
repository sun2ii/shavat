,{"text":"gara Waaqa itti gammaduu hin dhaqa;","poem":2},{"lineBreak":true},{"text":"ee Waaqa, Waaqa kiyya,","poem":2},{"lineBreak":true},{"text":"ani kiraara kiyya guddichaan si leellisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee lubbuu tiyya maaf gaddita?","poem":1},{"text":"Na keessatti maaf jeeqanta?","poem":2},{"text":"Ani deebi'ee Waaqa fayyisaa kiyya waan leellifadhuuf,","poem":1},{"text":"Waaqa keetitti addii godhadhu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}