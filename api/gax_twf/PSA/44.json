{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":44,"content":[{"type":"heading","content":["Daadimata Diinota Jalaa Bayiisaaf Dhikaate"]},{"type":"heading","content":["Wolaloo Ilmaan Qoraahii, sooressa faarfattootaatiif."]},{"type":"verse","number":1,"content":[{"text":"Ee Waaqa,","poem":1},{"text":"nuuti gurra keennaan dhageenneerra;","poem":2},{"lineBreak":true},{"text":"abbootiin teenna ta durii bara ifii keessatti","poem":2},{"lineBreak":true},{"text":"waan ati hujje nutti himaneeran.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ati harka keetiin gosa biyya adda addaa","poem":1},{"text":"lafa keessaa ariitee baattee,","poem":2},{"lineBreak":true},{"text":"abbootii teenna ta durii","poem":2},{"lineBreak":true},{"text":"lafa isaanii keessatti qubachiitte.","poem":2},{"text":"Gosa biyya adda addaa dhibii balleessitee,","poem":1},{"text":"abbootii teenna ta durii horsiitte.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isaan shallaagaa ifiitiin lafa san hin qabanne;","poem":1},{"text":"isaan hunna ifiitiin hin injifanne;","poem":2},{"lineBreak":true},{"text":"ati waan isaan jaalatteef,","poem":2},{"lineBreak":true},{"text":"harki keeti middichi, irreen teetii fi","poem":2},{"lineBreak":true},{"text":"ifi fuula keetii tana isaaniif kenne.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ee Waaqa, ati mooticha kiyya;","poem":1},{"text":"kolbaa sanyii Yaaqoobiitiif injifachaa ka kennitu si'i.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hunna teetiin diinota keenna hin injifanna;","poem":1},{"text":"maqaa keetiin worra nu irratti ka'u irra sirbina.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani guubee tiyyatti hin addadhu;","poem":1},{"text":"shallaagaan kiyyalle injifachaa naaf hin kennu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ati ammoo diinota keenna irratti","poem":1},{"text":"injifachaa nuuf kennitee,","poem":2},{"lineBreak":true},{"text":"worra nu jibbu qaanessite.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nuuti guyyaa mara si Waaqaan ifi jajanna;","poem":1},{"text":"maqaa keetille haga bara baraa hin leellifanna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Amma ammoo ati nu gattee nu salphitteerta;","poem":1},{"text":"loltoota teenna woliin duulaaf hin baatu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Diinota keenna duraa","poem":1},{"text":"akka baqannu nu gooteerta;","poem":2},{"lineBreak":true},{"text":"nyaaphoti keenna nu saamaneeran.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ati akka hoolota qalantuu","poem":1},{"text":"dabarsitee nu kennitee,","poem":2},{"lineBreak":true},{"text":"gosa biyya adda addaa oddu'utti","poem":2},{"lineBreak":true},{"text":"nu bittinneessiteerta.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ati kolbaa teeti gatii diqqo'otti gurgurte;","poem":1},{"text":"gurgurama isaanii irraa","poem":2},{"lineBreak":true},{"text":"bu'aa womaa hin dhagganne.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ati cooraa gosa ollaa keennaa,","poem":1},{"text":"murgo'oo fi kolla worra adaala keenna jiruu nu goote.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ati gosa biyya adda addaa oddu'utti","poem":1},{"text":"mammaassa nu goote;","poem":2},{"lineBreak":true},{"text":"isaan tuffi'iin mataa nutti raasan.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Guyyaa mara salphinni kiyya naan dura jira;","poem":1},{"text":"fuulli kiyya qaanii uffateera.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dubbii worra natti murguutii fi cooruutiif,","poem":1},{"text":"sababa diinota worra haluu na bayuu tun teete.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Nuuti adoo si hin dedhin,","poem":1},{"text":"gondooroo teetille adoo hin diigin,","poem":2},{"lineBreak":true},{"text":"wonni kun marti nu dhaqqadde.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Gadhaan keenna gara duubaa hin deebine;","poem":1},{"text":"miilli keenna daandii teeti irraa hin fallaanne.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ati ammoo addee jeedalti leetutti nu caccassiteerta;","poem":1},{"text":"dukkana dimmalle nutti uffitteerta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Nuuti maqaa Waaqa keennaa adoo deenee jiraannee,","poem":1},{"text":"harka keenna gara Waaqa ormaa","poem":2},{"lineBreak":true},{"text":"adoo badhifannee jiraannee,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Waaqi dhossaa waan maraa beeku,","poem":1},{"text":"silaa tana qorqoree bira hin gewuu ree?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Teetuu malee, nuuti guyyaa mara","poem":1},{"text":"si'iif jennee ijjeefanna;","poem":2},{"lineBreak":true},{"text":"akka hoolee qalantuu laakkowanneerra.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Goottaa kiyya, dammaqi! Maaf ratta?","poem":1},{"text":"Ka'i! Haga bara baraa nu hin gatin.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ati maaf fuula keeti dhoffatta?","poem":1},{"text":"Rakkoo teennaa fi cunqurfama keenna maaf deeta?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Lubbuun teenna bukuu keessa gad lixxeerti;","poem":1},{"text":"nafi keennalle lafatti maxxaneera.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ka'i! Nu qarqaar.","poem":1},{"text":"Jaalala keeti ka bara baraatiif jedhii nu wodi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}