{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":45,"content":[{"type":"heading","content":["Faaruu Fuudha Mootichaa"]},{"type":"heading","content":["Wolaloo ilmaan Qoraahii, sooressa faarfattootaatiif, faaruu ta akka yoyyoma faaruu, «Daraaraa» jedhantee beekkantutti faarfatante."]},{"type":"verse","number":1,"content":[{"text":"Dubbiin dansaan gadhaa kiyya guuttee dhangalaati;","poem":1},{"text":"wolaloo tiyya mootichaaf hin dhageessisa;","poem":2},{"lineBreak":true},{"text":"arrabi kiyya akka feenii nama woy barreessiisaan beekkamee ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ati ilmaan namaa mara caalaa miidhaga'a;","poem":1},{"text":"dubbiin teeti arnya qaddi;","poem":2},{"lineBreak":true},{"text":"tanaaf Waaqi haga bara baraa si eebbiseera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ee mooticha janna,","poem":1},{"text":"ka ulfinnaa fi arnya qaddu,","poem":2},{"lineBreak":true},{"text":"shallaagaa keeti hidhadhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Marroo dhuga'aa, marroo gadhi-laafumma'aa fi","poem":1},{"text":"balchumma'aatiif,","poem":2},{"lineBreak":true},{"text":"arnya keetiin injifatiisaaf ka'i;","poem":2},{"lineBreak":true},{"text":"harki keeti middichi","poem":2},{"lineBreak":true},{"text":"injifachaa gugurdoo dhaggisiisuu ti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Daayi keetii ka qarame,","poem":1},{"text":"gadhaa diina keetii hin woraana;","poem":2},{"lineBreak":true},{"text":"gosi biyya adda addaa miila keeti jalatti hin jigan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ee Waaqa barcumaan mootumma'aa keeti,","poem":1},{"text":"ka bara baraa ti;","poem":2},{"lineBreak":true},{"text":"uleen bokku'uu teetille ulee bokku'uu ta haqaa ti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ati balchummaa jaalattee,","poem":1},{"text":"hammeenna jibbite;","poem":2},{"lineBreak":true},{"text":"tanaaf Waaqi, Waaqi keeti zayitii gammadaa si muudee,","poem":2},{"lineBreak":true},{"text":"hari'aa teeti akka caaltu si godhe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Woyaan fiqiree qumbii, hargiisaa fi","poem":1},{"text":"dakkara irraa hujanteen fiqqitti.","poem":2},{"lineBreak":true},{"text":"Mana mootumma'aa ka ilka arbaatiin seefame keessaa","poem":2},{"lineBreak":true},{"text":"qoonqoon kiraara guddichaatii fi","poem":2},{"lineBreak":true},{"text":"maseenqo'oo si gammachiitti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dubartoota mana mootumma'aa keessa jiranu odduu,","poem":1},{"text":"ijoolleen durraa ta moototaa jiran;","poem":2},{"lineBreak":true},{"text":"giittittiin worqii biyya Ofiirii naqattelle","poem":2},{"lineBreak":true},{"text":"gara harka keeti middaatiin dhaabbatti.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ee intala dhage'i!","poem":1},{"text":"Waan ani jedhu caqasi;","poem":2},{"lineBreak":true},{"text":"kolbaa teetii fi mana abbaa keetii dedhi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mootichi miidhaginna keetiif si halcha;","poem":1},{"text":"inni goottaa keeti waan te'eef, isa ulfeessi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kolbaan Xiiroosii kennansa sii fidan;","poem":1},{"text":"worri dureeyyiin si'itti dhikaatiisaaf barbaadan.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Intalti mootichi fuudhaaru","poem":1},{"text":"woyaa worqi'iin kuulante uffattee,","poem":2},{"lineBreak":true},{"text":"kolloo ifii keessa jirti.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Woyaa kuula hedduu qaddu san uffattee,","poem":1},{"text":"gara mootichaa geeffanti;","poem":2},{"lineBreak":true},{"text":"durri bookarsitooti isi'ii","poem":2},{"lineBreak":true},{"text":"isii gula gara mootichaa hin dhaqan.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Isaan ililleetti'ii fi gammadaan","poem":1},{"text":"isii gula mana mootichaa hin seenan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ilmaan teeti addee abbootii teetii hin bu'an;","poem":1},{"text":"ati lafa duudii akka bulchanu hin goota.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ani dhaloota mara keessatti","poem":1},{"text":"gurra keeti hin mudhisa;","poem":2},{"lineBreak":true},{"text":"tanaaf gosi biyya adda addaa","poem":2},{"lineBreak":true},{"text":"bara baraa haga bara baraa si leellitti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":17}