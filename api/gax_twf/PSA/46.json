{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":46,"content":[{"type":"heading","content":["Waaqi Nu Woliin Jira"]},{"type":"heading","content":["Faaruu ilmaan Qoraahii, sooressa faarfattootaatiif, ta qoonqoo durraatiin faarfatane."]},{"type":"verse","number":1,"content":[{"text":"Waaqi addee itti baqannu;","poem":1},{"text":"inni hunna teenna;","poem":2},{"lineBreak":true},{"text":"yennaa rakko'oo inni guddoo nu qarqaara.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tanaaf latti yoo tachoote,","poem":1},{"text":"gaarri gara qilee abbaaya'aa yoo bu'e,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"bisaan yoo shookkisee hoomachowe,","poem":2},{"lineBreak":true},{"text":"raafamiisa isaatiin","poem":2},{"lineBreak":true},{"text":"gaaroti yoo hollatanelle nuuti hin sodaannu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lagi maddi isaa qachaa Waaqaa,","poem":1},{"text":"addee woyyittii Waaqi Ol Aanaan le'u","poem":2},{"lineBreak":true},{"text":"gammachiisu tokko jira.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Waaqi qachaa san keessa waan jiruuf,","poem":1},{"text":"qachaan sun hin tacho'u;","poem":2},{"lineBreak":true},{"text":"Waaqi barii ganama qachaa san hin qarqaara.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gosi biyya adda addaa hogitte,","poem":1},{"text":"mootummootille jidde;","poem":2},{"lineBreak":true},{"text":"Waaqi qoonqoo ifii dhageessise,","poem":2},{"lineBreak":true},{"text":"lattille baxxe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"Waaqi Waan Mara Dade nu woliin jira;","poem":2},{"lineBreak":true},{"text":"Waaqi Yaaqoobii addee nuuti itti baqannu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kowa'aatii, hujii Mootii Waan Maraa,","poem":1},{"text":"badii inni lafa irratti fide ilaala'a.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inni lola biyya lafaa irraa hin dhaabbachiisa;","poem":1},{"text":"guube'ee fi eboo hin caccassa;","poem":2},{"lineBreak":true},{"text":"wonteelle ibiddaan hin guba.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Inni, «Cadhisa'aa, ani Waaqa akka te'e beeka'a;","poem":1},{"text":"ani gosa biyya adda addaa oddu'utti,","poem":2},{"lineBreak":true},{"text":"biyya lafaa irralle'etti hin saadama» jedha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"Waaqi Waan Mara Dade nu woliin jira;","poem":2},{"lineBreak":true},{"text":"Waaqi Yaaqoobii addee nuuti itti baqannu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}