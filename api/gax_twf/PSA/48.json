{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":48,"content":[{"type":"heading","content":["Qachaa Guddicha Waaqaa, Xiyoon"]},{"type":"heading","content":["Faaruu. Faaruu ilmaan Qoraahii."]},{"type":"verse","number":1,"content":[{"text":"Mootiin Waan Maraa gudda'a;","poem":1},{"text":"qachaa Waaqa keennaa keessatti","poem":2},{"lineBreak":true},{"text":"gaara woyyicha irratti","poem":2},{"lineBreak":true},{"text":"guddoo leellifamuu qaba.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gaarri Xiyoonii ka gara kaabaatitti dhaggamu,","poem":1},{"text":"ka dheerinnaan miidhagu,","poem":2},{"lineBreak":true},{"text":"qachaa mooticha gudda'aa,","poem":2},{"lineBreak":true},{"text":"ka lafa duudii gammachiisu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Waaqi mana mootumma'aa jabaa","poem":1},{"text":"qachaa sanii keessa jira;","poem":2},{"lineBreak":true},{"text":"inni kushee qachaa sanii akka te'e ifi mudhiseera.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Qachaa san loliisaaf,","poem":1},{"text":"moototi wolitti qabamane.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isaan akkuma dhagganeen maadeffatane;","poem":1},{"text":"sodaatanee baqa kottee addeessane.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Achitti rommiis isaanitti dhufee,","poem":1},{"text":"akka dubartii ciniinsifattuu muddamane.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Akka hoboloota gugurdoo Tarshiishii","poem":1},{"text":"ta qilleensa gara aduun baatuutiin bututanuu te'ane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Waaqi qachaa ifii","poem":1},{"text":"haga bara baraa jabeessee akka dhaabu,","poem":2},{"lineBreak":true},{"text":"akkuma dhageenne,","poem":2},{"lineBreak":true},{"text":"akkasuma qachaa Mootii Waan Maraa","poem":2},{"lineBreak":true},{"text":"Waaqa Waan Mara Dadee,","poem":2},{"lineBreak":true},{"text":"ka Waaqa keennaa irratti dhaggineerra.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ee Waaqa, Galma keeti keessatti,","poem":1},{"text":"jaalala keeti ka bara baraa yaadanna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ee Waaqa, akkuma maqaan keeti lafa duudii geye,","poem":1},{"text":"leellisi keetille lafa duudii geyee,","poem":2},{"lineBreak":true},{"text":"harki keeti middichi balchumma'aan guutameera.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Muraan teeti dhugaa waan teeteef,","poem":1},{"text":"worri gaara Xiyoonii irra le'u gammaduu ti;","poem":2},{"lineBreak":true},{"text":"worri qachoota Yihuda'aa keessa le'u firinxiixuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Qachaa Xiyoonii naannowaa ideemaa,","poem":1},{"text":"adaala isaa mara'a.","poem":2},{"lineBreak":true},{"text":"Xelleephoo isaa laakkowa'a.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dalleya dhaka'aa ka isaa hubadha'a;","poem":1},{"text":"kushee isaalle ilaala'a.","poem":2},{"text":"Akka dhaloota dhufuun,","poem":1}]},{"type":"verse","number":14,"content":[{"text":"«Waaqi kun, haga bara baraa Waaqa keenna;","poem":2},{"lineBreak":true},{"text":"inni haga du'aatitti nu sooressa» jettanu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}