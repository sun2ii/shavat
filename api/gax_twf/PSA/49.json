{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":49,"content":[{"type":"heading","content":["Gowwummaa Durumma'atti Addatiisaa"]},{"type":"heading","content":["Faaruu ilmaan Qoraahii, sooressa faarfattootaatiif."]},{"type":"verse","number":1,"content":[{"text":"Kolbaan marti tana dhage'a'a!","poem":1},{"text":"Worri biyya lafaa tana keessa leetanu marti caqasa'a!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gudda'aa fi diqqa'aan,","poem":1},{"text":"dureessaa fi hiyyeessi caqasa'a.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Afaan kiyya jechoota qarumma'aa dubbata;","poem":1},{"text":"yaad gadhaa kiyyaa hubantii kenna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ani gurra kiyya gara fakkeennaa deebifadha;","poem":1},{"text":"hiibboo tiyya","poem":2},{"lineBreak":true},{"text":"kiraaraan hiika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Guyyaa wonni hantuun natti dhuttuu fi","poem":1},{"text":"hamaaleyyiin sobaaleyyiin na marsanu","poem":2},{"lineBreak":true},{"text":"ani maaf sodaadha?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Worra qabeenna ifiititti addatuu fi","poem":1},{"text":"durummaa ifii guddo'oon kooru,","poem":2},{"lineBreak":true},{"text":"ani maaf sodaadha?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dhugumaan, nami nama wodu,","poem":1},{"text":"yookiin gatii wodo'oo san","poem":2},{"lineBreak":true},{"text":"Waaqaaf kennuu dande'u hin jiru.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gatiin lubbuu namaa akka malee guddo'o;","poem":1},{"text":"wonni silaa kaffaluu dande'anuuyyuu","poem":2},{"lineBreak":true},{"text":"ijjumaa hin geettu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akka du'ee hin shanne,","poem":1},{"text":"haga bara baraa akka le'u godhiisaaf","poem":2},{"lineBreak":true},{"text":"ijjumaa hin geettu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Qarooleen akka du'anu nami marti hin dhagga;","poem":1},{"text":"gowwoole'ee fi daalleelle hin badan;","poem":2},{"lineBreak":true},{"text":"qabeenna ifiille worra dhibi'iif lakkisan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Lafa maqaa isaaniitiin waammantu yoo qabaatanelle,","poem":1},{"text":"irreensi isaanii haga bara baraa mana isaanii hin te'a;","poem":2},{"lineBreak":true},{"text":"dhalootaa haga dhalootaatitti addee leetoo isaanii hin te'a.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Durummaan du'a irraa nama hin hamburtu;","poem":1},{"text":"nami akkuma hori'ii hin du'a.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hireen worra gowwumma'aan ifitti addatuutii fi","poem":1},{"text":"hordofattoota isaanii,","poem":2},{"lineBreak":true},{"text":"ka waan isaan jedhanu fudhatuu tana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Isaan kun akkuma hoole'ee hin du'an;","poem":1},{"text":"duuti isaan hin tissiti.","poem":2},{"lineBreak":true},{"text":"Worri qajeelaan ganamaan","poem":2},{"lineBreak":true},{"text":"irreensa isaanii irra hin ideema;","poem":2},{"lineBreak":true},{"text":"isaan mana ifii dansaa irraa fagaatanee,","poem":2},{"lineBreak":true},{"text":"addee worri du'e jiru keessatti hin shaman.","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Waaqi gara ifii waan na fudhatuuf,","poem":2},{"lineBreak":true},{"text":"dhugumaan inni lubbuu tiyya","poem":2},{"lineBreak":true},{"text":"hunna addee worri du'e jiruu jalaa hin woda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nami yennaa dureessa te'e,","poem":1},{"text":"qabeenni mana isaa yennaa dabalame,","poem":2},{"lineBreak":true},{"text":"hin sodaatin.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Inni yennaa du'u womaa hin fudhatu;","poem":1},{"text":"karri isaa isa woliin hin awwaalamu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nami bara jiruu ifii mara gammadee,","poem":1},{"text":"wonni marti isaaf teetee leellifamulle,","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"du'ee gara abbootii ifii ta durii,","poem":2},{"lineBreak":true},{"text":"ta deebitee ifa hin dhagginee hin deema.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nami karra qabaatee hubantii dhabe,","poem":1},{"text":"akkuma hori'ii hin du'a.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":20}