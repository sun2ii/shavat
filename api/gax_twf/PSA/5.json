{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":5,"content":[{"type":"heading","content":["Daadimata Diina Jalaa Bayiisaaf dhikaate"]},{"type":"heading","content":["Sooressa faarfattootaatiif, faaruu Daawitii ta suusulle'een faarfatante."]},{"type":"verse","number":1,"content":[{"text":"Ee Mootii Waan Maraa, dubbii tiyya caqasi;","poem":1},{"text":"aadiisa kiyyalle dhage'i.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mootii kiyya, Waaqa kiyya,","poem":1},{"text":"ani waan si daadimadhuuf,","poem":2},{"lineBreak":true},{"text":"iyya tiyya naa dhage'i.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ganama qoonqoo tiyya hin dhageetta;","poem":2},{"lineBreak":true},{"text":"ganama mara si daadimadhee","poem":2},{"lineBreak":true},{"text":"deebii si irraa eegadha.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ati Waaqa hammeennatti gammaduu moti;","poem":1},{"text":"hammeennille si woliin hin le'u.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Koorameeyyiin si dura hin dhaabbattu;","poem":1},{"text":"worra hantuu huju mara hin jibbita.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ati dharaameyyii mara hin balleessita;","poem":1},{"text":"worra nama ijjeesuu fi nama sobu hin jibbita.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ani ammoo jaalala keeti ka bara baraatiin","poem":1},{"text":"gara mana keetii seena;","poem":2},{"lineBreak":true},{"text":"si sodaatiisalle'een","poem":2},{"lineBreak":true},{"text":"gara Dunkaanii Woyyittii teetii garagalee","poem":2},{"lineBreak":true},{"text":"hin sagada.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"diinota bacaa waan qabuuf,","poem":2},{"lineBreak":true},{"text":"balchummaa teetiin na sooressi;","poem":2},{"lineBreak":true},{"text":"karaa keeti naaf qajeelchi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Diinoti kiyya dhugaa hin dubbatanu;","poem":1},{"text":"gadhaan isaanii badi'iin guutameera.","poem":2},{"text":"Afaan isaanii akka boolla awwaalaa ta banantee ti;","poem":1},{"text":"arraba ifiitiin maltee dubbatan.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ee Waaqa, yakkaa isaanii isaanitti muri;","poem":1},{"text":"malli isaaniituu badii isaanitti fiduu ti.","poem":2},{"text":"Isaan si irratti waan ka'aneef,","poem":1},{"text":"sababa cubbuu isaanii heddu'uutiif,","poem":2},{"lineBreak":true},{"text":"alatti isaan gati.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Worri gara keeti baqatu marti ammoo","poem":1},{"text":"gammaduu ti;","poem":2},{"lineBreak":true},{"text":"isaan haga bara baraa ilillisanuu ti.","poem":2},{"text":"Worri maqaa keeti jaalatu marti si'itti","poem":1},{"text":"gammadee akka firinxiixu isaan eegi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ati balchoota hin eebbitta;","poem":2},{"lineBreak":true},{"text":"fedhii teeti dansa'aan","poem":2},{"lineBreak":true},{"text":"akka wonte'ee isaan marsi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}