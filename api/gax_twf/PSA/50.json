{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":50,"content":[{"type":"heading","content":["Waaqonfannaa Dhuga'aa"]},{"type":"heading","content":["Faaruu Asaafii."]},{"type":"verse","number":1,"content":[{"text":"Mootiin Waan Maraa,","poem":1},{"text":"Waaqi waaqotaa hin dubbata;","poem":2},{"lineBreak":true},{"text":"baya adu'uu irraa haga seensa adu'uutitti,","poem":2},{"lineBreak":true},{"text":"nama lafa irraa mara hin waama.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gaara Xiyoonii,","poem":1},{"text":"ka miidhaginna guutuu qabu irraa,","poem":2},{"lineBreak":true},{"text":"Waaqi hin ifa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Waaqi keenna hin dhufa; inni hin cadhisu;","poem":1},{"text":"ibiddi gubu isa dura jira;","poem":2},{"lineBreak":true},{"text":"hobonbolattiin jadduun cinaa isaa marsiteerti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inni kolbaa ifiititti muriisaaf,","poem":1},{"text":"ol-gubbaa gubbaa jirtuu fi lafa waamee,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"«Worra ciinca'aan na woliin gondoorate,","poem":1},{"text":"ka naaf addatamane wolitti naaf qaba'a» hin jedha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Waaqi abbaa mura'aa waan te'eef,","poem":1},{"text":"ol-gubbaan balchummaa isaa lalladdi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ammalle Waaqi, «Kolbaa tiyya, dhage'a'a;","poem":1},{"text":"Israa'el, ani si'i irratti dhugaa hin baya;","poem":2},{"lineBreak":true},{"text":"ani Waaqi keeti, Waaqa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ani, ‹Ciincaa naa dhikeessitu dhabe› jedhee si hin komadhu;","poem":1},{"text":"kennansi keeti ka gubamu yennaa mara fuula kiyya dura jira.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ani moonaa teeti keessaa korommii,","poem":1},{"text":"gooree teeti keessaa korbeeyyii re'e'ee","poem":2},{"lineBreak":true},{"text":"fudhatiisaaf hin barbaadu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bineensoti baddaa keessaa marti,","poem":1},{"text":"horiin kooba kuma hedduu irraa marti kiyya.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ani sinbirroota gaara irraa mara beeka;","poem":1},{"text":"wonni diida keessa munyuuqu marti tiyya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Biyyi lafaatii fi wonni isii keessaa marti","poem":1},{"text":"tiyya waan teeteef,","poem":2},{"lineBreak":true},{"text":"adoo beelowelle'ee ani sitti hin himu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ani foon korommi'ii nyaadhaa?","poem":1},{"text":"Yookiin dhiiga re'e'ee unaa?» jedha.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ciincaa galataa Waaqaaf dhikeessi;","poem":1},{"text":"waadaa keeti Ol Aana'aaf muummessi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Waaqi, «Guyyaa rakkinnaa na waami;","poem":1},{"text":"ani si baasa;","poem":2},{"lineBreak":true},{"text":"atille na hin ulfeessita» jedha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Waaqi ammoo nama hama'aan,","poem":1},{"text":"«Waan ajaja kiyyaatuu maaf dubbatta?","poem":2},{"lineBreak":true},{"text":"Gondooroo tiyya maaf maqaa dhootta?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ati adabamiisa jibbita;","poem":1},{"text":"jechoota kiyya ifiin duubatti gatta.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hattuu yennaa dhaggitu, jaala teetaaf;","poem":1},{"text":"gaarayyeeffattoota wolille'een qooda qadda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«Afaan keeti waan hantuu dubbata;","poem":1},{"text":"arrabi keetille soba odeessa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Teettee obboleessa keeti hamatta;","poem":1},{"text":"ilma haadha teetii maqaa balleessita.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ati waan kana goote; ani hin cadhisaa?","poem":1},{"text":"Ani akkuma keeti te'e na seetaa?","poem":2},{"text":"Amma ammoo waan ati goote sitti mudhisee,","poem":1},{"text":"si xixa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Isin worri ana Waaqa deetanu,","poem":1},{"text":"tana hubadha'a;","poem":2},{"lineBreak":true},{"text":"tun te'uu dhabaannaan ani isin kukkuta;","poem":2},{"lineBreak":true},{"text":"ka isin baasu hin jiru.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nami ciincaa galataa naaf dhikeessu na ulfeessa;","poem":1},{"text":"nama karaa qajeelaa deemuuf,","poem":2},{"lineBreak":true},{"text":"fayyisiisa kiyya itti mudhisa» jedha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}