{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":51,"content":[{"type":"heading","content":["Daadimata Araara Dhaggatiisaaf Dhikaate"]},{"type":"heading","content":["Faaruu Daawiti sooressa faarfattootaatiif. Daawiti Baat-Sheebaa gaarayyeeffateen duuba yennaa raagichi Naataan gara isaa dhufe ta inni faarfate."]},{"type":"verse","number":1,"content":[{"text":"Ee Waaqa,","poem":1},{"text":"sababa jaalala keeti ka bara baraatiif,","poem":2},{"lineBreak":true},{"text":"na marari.","poem":2},{"text":"Sababa gadhi-laafummaa teeti guddo'ootiif,","poem":1},{"text":"yakkaa tiyya haxowii balleessi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yakkaa tiyya mara dhiqii balleessi;","poem":1},{"text":"cubbuu tiyya irraa na qulqulleessi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ani yakkaa tiyya waan beekuuf,","poem":1},{"text":"yennaa mara cubbuun tiyya","poem":2},{"lineBreak":true},{"text":"fuula kiyya dura jirti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ani si irratti ka'ee, si qofa yakkee,","poem":1},{"text":"waan hantuu si duratti godhe.","poem":2},{"text":"Tanaaf dubbiin ati na irratti dubbatte dhuga'a;","poem":1},{"text":"muraan ati natti murtelle haqa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dhugumaan ani cubbu'uun dhaladhe;","poem":1},{"text":"yennaa haati tiyya na ulfoottuu ani cubbicha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ati keessa namaatitti dhugaa hin halchita;","poem":1},{"text":"tanaaf, gadhaa kiyya ka dhossa'aa keessatti","poem":2},{"lineBreak":true},{"text":"qarummaa na barsiisi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Baala hisoophiitiin fiffixiitii,","poem":1},{"text":"cubbuu irraa na qulqulleessi;","poem":2},{"lineBreak":true},{"text":"anille hin qulqullowa;","poem":2},{"lineBreak":true},{"text":"na dhiqi; anille dhakaa roobaa caalaa hin addaadha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ililleetti'ii fi gammada na dhageessisi;","poem":1},{"text":"ati na caccassitee butuchitulle","poem":2},{"lineBreak":true},{"text":"ani deebi'ee hin gammada.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Fuula keeti cubbuu tiyya irraa deebifadhu;","poem":1},{"text":"yakkaa tiyya mara haxowii balleessi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ee Waaqa, gadhaa qulluu naa dadi;","poem":1},{"text":"ayyaana haareya hin jijjiiranne naa kenni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Fuula keeti duraa na hin fageessin;","poem":1},{"text":"Ayyaana keeti Woyyichalle na irraa hin fudhatin.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Gammada fayyisiisa keeti irraa dhufu san,","poem":1},{"text":"adde'etti naaf deebisi;","poem":2},{"lineBreak":true},{"text":"akka si'iif ajajamu na qarqaar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Achiin duuba ani","poem":1},{"text":"worra seera keeti yakku hin barsiisa;","poem":2},{"lineBreak":true},{"text":"cubbaaleyyiille gara keeti hin deebi'an.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ee Waaqa, Waaqa fayyinna kiyyaa,","poem":1},{"text":"yakkaa dhiiga dhangalaasee jalaa na baasi","poem":2},{"noteId":8},{"text":";","poem":2},{"lineBreak":true},{"text":"arrabi kiyya marroo balchummaa teetii","poem":2},{"lineBreak":true},{"text":"gammadaan ilillisa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ee Gootta'a, afaan kiyya bani;","poem":1},{"text":"anille arraba kiyyaan si hin leellifadha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ati adoo ciincaa jaalattu teetee,","poem":1},{"text":"ani silaa si'iif hin dhikeessaayyu.","poem":2},{"lineBreak":true},{"text":"Ati kennansa gubamutti hin gammaddu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ciincaan Waaqaaf dhikaattu yaada gad jedhe;","poem":1},{"text":"ee Waaqa, ati yaada gad jedhee,","poem":2},{"lineBreak":true},{"text":"cubbuu irraa deebi'u hin tuffattu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Fedhii teetiin Xiyooniif waan dansaa godhi;","poem":1},{"text":"dalleya dhaka'aa ka Yerusaalemii deebisii ijaari.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Achiin duuba ati ciincaa sirrii te'ee fi","poem":1},{"text":"kennansa gubamutti hin gammadda;","poem":2},{"lineBreak":true},{"text":"addee ciincaan itti ciinceffamu teeti irratti","poem":2},{"lineBreak":true},{"text":"dardarooti hin dhikeeffaman.","poem":2}]}],"footnotes":[{"noteId":8,"caller":"+","text":"Yakkaa dhiiga dhangalaasee jalaa na baasi: Afaan Ibrootaatiin dhiigi kiyya akka hin dhangalaane na baasi jedhamuu hin dande'ama.","reference":{"chapter":51,"verse":14}}]},"thisChapterLink":"/api/gax_twf/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}