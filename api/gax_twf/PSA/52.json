{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":52,"content":[{"type":"heading","content":["Muraa Waaqaatii Fi Badhaadha Waaqaa"]},{"type":"heading","content":["Sooressa faarfattootaatiif, wolaloo Daawitii ta yennaa nami biyya Edoomii Do'eeg gara Saa'olii dhufee, «Daawiti gara mana Ahiimelekii dhufeera» jedhee isatti hime faarfate."]},{"type":"verse","number":1,"content":[{"text":"Nama hunnaamessa!","poem":1},{"text":"Hantuu hujiisa keetiin maaf koorta?","poem":2},{"lineBreak":true},{"text":"Jaalalli bara baraa ka Waaqaa","poem":2},{"lineBreak":true},{"text":"haga bara baraa ti.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ati ka soba baratte,","poem":1},{"text":"mala badi'ii dhootta;","poem":2},{"lineBreak":true},{"text":"arrabi keeti akka shiggire'ee ti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ati waan dansaa caalaa waan hantuu,","poem":1},{"text":"dhugaa dubbii caalaa dhara jaalatta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ati nama sobaalessa!","poem":1},{"text":"Dubbii nama miitu jaalatta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Waaqi ammoo badii bara baraa sitti fidee,","poem":1},{"text":"mana keeti keessaa butee si baasee,","poem":2},{"lineBreak":true},{"text":"lafa worra jiraata'aa keessalle'ee si hin buqqisa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Worri balchooleen","poem":1},{"text":"waan kana dhagganee, hin sodaatan;","poem":2},{"lineBreak":true},{"text":"achiin duuba sitti kollaa,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"«Nama Waaqatti hin irkanne,","poem":1},{"text":"ammoo bacinna karra ifiititti ka addatu,","poem":2},{"lineBreak":true},{"text":"ka worra dhibii balleessiisatti jabaatu,","poem":2},{"lineBreak":true},{"text":"kunoo ilaala'a!» hin jedhan.","poem":2}]},{"type":"verse","number":8,"content":["Ani ammoo mana Waaqaa keessatti,",{"text":"akka muka ejersaa oshoba;","poem":2},{"text":"Jaalala Waaqaa ka bara baraatitti","poem":1},{"text":"bara baraan itti addadha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Waaqa, marroo waan ati hujjeetiif,","poem":1},{"text":"ani bara baraan si leellifadha.","poem":2},{"text":"Worra si dhugeeffatu duratti,","poem":1},{"text":"maqaa keeti dansaa san addi'iin eegadha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}