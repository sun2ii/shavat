{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":53,"content":[{"type":"heading","content":["Hammeenna Namaa"]},{"type":"heading","content":["Sooressa faarfattootaatiif, wolaloo Daawitii, ta akka yoyyoma, «Mahalaat» jedhamee beekkamutti faarfatante."]},{"type":"verse","number":1,"content":[{"text":"Gowwooleen gadhaa ifii keessatti,","poem":1},{"text":"«Waaqi hin jiru» jedhan;","poem":2},{"lineBreak":true},{"text":"isaan worra bada'a;","poem":2},{"lineBreak":true},{"text":"waan gadhee hujan;","poem":2},{"lineBreak":true},{"text":"isaan keessaa","poem":2},{"lineBreak":true},{"text":"ka waan dansaa huju tokkolle hin jiru.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Worra qaroolee Waaqa barbaadu,","poem":1},{"text":"yoo jiraatane dhaggiisaaf,","poem":2},{"lineBreak":true},{"text":"Waaqi ol-gubbaa irraa,","poem":2},{"lineBreak":true},{"text":"gara ilmaan namaa gad ilaala.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isaan ammoo martinuu dudda itti galaneeran;","poem":1},{"text":"martinuu wolumatti worra badaa te'aneeran;","poem":2},{"lineBreak":true},{"text":"isaan keessaa ka waan dansaa huju hin jiru;","poem":2},{"lineBreak":true},{"text":"tokkolle hin jiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Worri hamaaleyyiin womaa hin hubatuu?","poem":1},{"text":"Akkuma nami sagalee nyaatu","poem":2},{"lineBreak":true},{"text":"worri kolbaa tiyya nyaatu,","poem":2},{"lineBreak":true},{"text":"gara Waaqaa hin daadimatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Isaan addee wonni sodaatanu hin jirretti,","poem":1},{"text":"sodaatanee bararaqan.","poem":2},{"text":"Waaqi lafee diina kolbaa ifii hin bittinneessa;","poem":1},{"text":"Waaqi waan isaan jibbeef,","poem":2},{"lineBreak":true},{"text":"isin kolbaan Waaqaa isaan hin qaanessitan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Xiyoon keessaa","poem":1},{"text":"Israa'eliif fayyinni adoo dhufee jiraatee!","poem":2},{"lineBreak":true},{"text":"Yennaa Waaqi boojuu kolbaa ifii deebisu,","poem":2},{"lineBreak":true},{"text":"sanyiin Yaaqoobii burraaxxuu ti;","poem":2},{"lineBreak":true},{"text":"kolbaan Israa'elii gammadduu ti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}