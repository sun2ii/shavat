{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":54,"content":[{"type":"heading","content":["Harka Diinaa Jalaa Bayiisaaf Daadimata Dhikaate"]},{"type":"heading","content":["Wolaloo Daawitii, sooressa faarfattootaatiif, ta yennaa worri Ziifii gara Saa'olii dhaqee, «Daawiti nu biratti dhokateera» jedhee isatti hime ta meya ribu'uutiin faarfatante."]},{"type":"verse","number":1,"content":[{"text":"Ee Waaqa, maqaa keetiin na baasi;","poem":1},{"text":"hunna teetiin dhugaa naaf muri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ee Waaqa, daadimata kiyya dhage'i;","poem":1},{"text":"dubbii afaan kiyyaa caqasi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Namooti alagaan natti ka'an;","poem":1},{"text":"worri nama sodaachisu,","poem":2},{"lineBreak":true},{"text":"na ijjeesiisaaf barbaadan;","poem":2},{"lineBreak":true},{"text":"isaan marroo Waaqaa hin yaadanu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dhugumaan Waaqi qarqaarsa kiyya;","poem":1},{"text":"Goottaan irkuu jiruu tiyyaa ti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wonni hantuun","poem":1},{"text":"worra ila diinumma'aatiin na ilaalutti deebituu ti;","poem":2},{"lineBreak":true},{"text":"ati addatamummaa teetiin isaan fixi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani fedhuma tiyyaan ciincaa sii dhikeessa;","poem":1},{"text":"Ee Mootii Waan Maraa,","poem":2},{"lineBreak":true},{"text":"maqaan keeti dansaa waan te'eef,","poem":2},{"lineBreak":true},{"text":"ani isa hin leellisa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ati rakkinna mara keessaa waan na baatteef,","poem":1},{"text":"injifatamiisa diinota kiyyaa dhaggeera.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}