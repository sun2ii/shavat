{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":55,"content":[{"type":"heading","content":["Jaalaan Diinatti Dabarfamanee Kennamuu"]},{"type":"heading","content":["Sooressa faarfattootaatiif, wolaloo Daawitii, ta meya ribu'uutiin faarfatante."]},{"type":"verse","number":1,"content":[{"text":"Ee Waaqa, daadimata kiyya dhage'i;","poem":1},{"text":"gaaffii tiyya cadhittee hin ilaalin.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ati na caqasii deebii naa kenni;","poem":1},{"text":"ani rakkinna kiyyaan nageya dhabeera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Diinoti kiyya natti iyyan;","poem":1},{"text":"worri hamaaleyyiin na cunqursan.","poem":2},{"text":"Isaan farra natti fidan;","poem":1},{"text":"aari'iin na lolan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gadhaan kiyya na sodaateera;","poem":1},{"text":"bararaqi du'aa natti bu'eera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Soda'aa fi hollatiisi na qabataneeran;","poem":1},{"text":"guddoo sheephiseera.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani adoo akka saphaliisaa koola qabaadhe,","poem":1},{"text":"silaa koolaan ka'ee","poem":2},{"lineBreak":true},{"text":"addee takkatti foorfadhaayyu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ani silaa fagoo ideemee,","poem":1},{"text":"goomolee keessa turaayyu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hobonbolatti'ii fi bubbee bokkeyaa jalaa,","poem":1},{"text":"silaa ariifadhee","poem":2},{"lineBreak":true},{"text":"gara addee itti baqadhuu hin deemaayyu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ee Gootta'a, ani qachaa keessatti","poem":1},{"text":"hunnaan wolitti ka'iisaa fi","poem":2},{"lineBreak":true},{"text":"wol loliisa waan dhaggeef,","poem":2},{"lineBreak":true},{"text":"arrabi isaanii akka wol irraa miliqu godhi;","poem":2},{"lineBreak":true},{"text":"mala isaaniille balleessi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Halkanii fi guyyaa,","poem":1},{"text":"isaan dalleya qachaa sanii gubbaa maran;","poem":2},{"lineBreak":true},{"text":"yakka'aa fi rakkinni qachaa san keessa jiran.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Qachaa san keessa addee mara badi'itti jira;","poem":1},{"text":"dikkoo qachaa sanii keessaa","poem":2},{"lineBreak":true},{"text":"cunqursa'aa fi sobatti guuteera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ka na arrassu diina kiyyaa moti;","poem":1},{"text":"adoo diina kiyya te'ee, silaa hin ossadhaayyu.","poem":2},{"text":"Ka natti kooru, nyaapha kiyyaa moti;","poem":1},{"text":"adoo nyaapha kiyya te'ee,","poem":2},{"lineBreak":true},{"text":"silaa duraa dhokadhaayyu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ka tana na godhe ammoo,","poem":1},{"text":"nama hari'aa tiyyaa,","poem":2},{"lineBreak":true},{"text":"si lansa kiyya, jaala kiyya ka wolitti dhikaannu,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ka haasowa mi'aawaa woliin haasowaa,","poem":2},{"lineBreak":true},{"text":"kolbaa woliin,","poem":2},{"lineBreak":true},{"text":"gara mana Waaqaa ideenne.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wonni hantuun mana isaaniitii fi","poem":1},{"text":"gadhaa isaanii keessa waan jirtuuf,","poem":2},{"lineBreak":true},{"text":"diinota kiyyatti dedhuma duuti itti dhuttuu ti;","poem":2},{"lineBreak":true},{"text":"adoo jiranuu","poem":2},{"lineBreak":true},{"text":"gara addee worri du'e jiruu gad bu'anuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ani ammoo Waaqa waammadha;","poem":1},{"text":"Mootiin Waan Maraalle na baasa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Galgalaa fi ganama, guyyaa wodhakka'attille,","poem":1},{"text":"rakko'oo fi gadda kiyya itti himadha;","poem":2},{"lineBreak":true},{"text":"innille qoonqoo tiyya hin dhage'a.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Worri na irratti ka'u bacaa waan te'eef,","poem":1},{"text":"inni worra na lolu jalaa,","poem":2},{"lineBreak":true},{"text":"nageyaan na galcha.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Isaan waan hin jijjiiranneef,","poem":1},{"text":"Waaqalle waan hin sodaanneef,","poem":2},{"lineBreak":true},{"text":"Waaqi, ka durii jalqabee","poem":2},{"lineBreak":true},{"text":"barcumaa mootummaa ifii irra jiru,","poem":2},{"lineBreak":true},{"text":"daadimata kiyya dhage'ee,","poem":2},{"lineBreak":true},{"text":"isaan hin salphisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Lansi kiyya sun jaalota ifii lole;","poem":1},{"text":"waadaa galelle diige.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Haasonni isaa dhadha'a;","poem":1},{"text":"gadhaa ifiititti ammoo lola yaada.","poem":2},{"text":"Jechooti isaa zayitii caalaa lallaafa;","poem":1},{"text":"ammoo akka shallaagaa buqqifamee ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ba'aa teeti Mootii Waan Maraa irratti buufadhu;","poem":1},{"text":"inni si utuba;","poem":2},{"lineBreak":true},{"text":"inni worra balchoolee","poem":2},{"lineBreak":true},{"text":"ijjumaa akka raafamanu hin godhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ee Waaqa, ati ammoo","poem":1},{"text":"worra hamaa boolla qile'etti gad gatta;","poem":2},{"lineBreak":true},{"text":"worri dhiiga namaa dhangalaasuu fi nama sobu,","poem":2},{"lineBreak":true},{"text":"bara le'ii ifii hin wodhakkeeffatanu.","poem":2},{"text":"Ani ammoo sitti addadha.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}