{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":57,"content":[{"type":"heading","content":["Daadimata Qarqaarsa Waaqaa Dhaggatiisaaf Dhikaate"]},{"type":"heading","content":["Sooressa faarfattootaatiif, faaruu Daawitii, ta akka yoyyoma faaruu, «Hin balleessin» jedhantee beekkantutti, yennaa inni Saa'ol duraa baqatee goda keessa jiru faarfatante."]},{"type":"verse","number":1,"content":[{"text":"Lubbuun tiyya waan sitti baqattuuf,","poem":1},{"text":"na marari, ee Waaqa, na marari.","poem":2},{"text":"Haga rakkoon dabartutti","poem":1},{"text":"ani koola keeti jalatti baqadha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ani gara Waaqa Ol-Aana'aa,","poem":1},{"text":"gara Waaqa waan naaf barbaachisu","poem":2},{"lineBreak":true},{"text":"mara naa muummessuu hin iyya.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inni ol-gubbaa irraa ergee na baasa;","poem":1},{"text":"inni worra na irra sirbu hin salphisa.","poem":2},{"text":"Waaqi jaalala ifii ka bara baraatii fi","poem":1},{"text":"addatamummaa ifii hin erga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ani worra akka neenqa nama nyaatiisaaf","poem":1},{"text":"ila babaasuu odduu irkadhe.","poem":2},{"text":"Ilkaan isaanii akka ebo'ootii fi daayaa ti;","poem":1},{"text":"arrabi isaanii akka shallaagaa qaramee ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee Waaqa, ol-gubba'aan gubba'atti saadami;","poem":1},{"text":"ulfinni keeti lafa duudii irratti te'uu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Diinoti kiyya miila kiyyaaf fonxoroo afane;","poem":1},{"text":"lubbuun tiyya gaddaan gad jette.","poem":2},{"text":"Isaan karaa kiyya keessatti boolla qotane;","poem":1},{"text":"ammoo ifumaaf keessa bu'ane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ee Waaqa, gadhaan kiyya hin mamu!","poem":1},{"text":"Gadhaan kiyya hin mamu.","poem":2},{"text":"Ani hin faarfadha;","poem":1},{"text":"meya faaru'uu ka adda addaatiin hin faarfadha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lubbuu tiyya dammaqi;","poem":1},{"text":"ee kiraaraa guddicha,","poem":2},{"lineBreak":true},{"text":"ee maseenqo'o dammaqa'a;","poem":2},{"lineBreak":true},{"text":"anille boruu hin dayyaasa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ee Gootta'a,","poem":1},{"text":"ani gosa biyya adda addaa oddu'utti","poem":2},{"lineBreak":true},{"text":"si galateeffadha.","poem":2},{"lineBreak":true},{"text":"Ani gosa biyya adda addaa oddu'utti","poem":2},{"lineBreak":true},{"text":"faaru'uun si leellisa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Jaalalli keeti ka bara baraa guddaa waan te'eef,","poem":1},{"text":"akka ol-gubba'aa ol fagaata;","poem":2},{"lineBreak":true},{"text":"addatamummaan teeti duumensa dhaqqaddi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ee Waaqa, ol-gubba'aan gubba'atti saadami;","poem":1},{"text":"ulfinni keeti lafa duudii irratti te'uu ti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}