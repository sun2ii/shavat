{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":58,"content":[{"type":"heading","content":["Waaqi Akka Nama Hamaa Adabuuf Daadimata Dhikaate"]},{"type":"heading","content":["Sooressa faarfattootaatiif, faaruu Daawitii, ta akka yoyyoma faaruu, «Hin balleessin» jedhantee beekkantutti faarfatante."]},{"type":"verse","number":1,"content":[{"text":"Isin bulchitoota,","poem":1},{"text":"isin dhugumaan","poem":2},{"lineBreak":true},{"text":"waan sirrii te'e hin dubbattanii ree?","poem":2},{"lineBreak":true},{"text":"Isin kolba'atti haqa hin murtanii ree?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Waawwo'o! Isin gadhaa keessan keessatti","poem":1},{"text":"waan haqa hin te'in mala dhoottan;","poem":2},{"lineBreak":true},{"text":"lafa irratti hunnaan namatti kaatan.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Worri hamaaleyyiin","poem":1},{"text":"gadaamessa haadha ifiitii jalqabanee,","poem":2},{"lineBreak":true},{"text":"karaa irraa goraneeran;","poem":2},{"lineBreak":true},{"text":"haga dhalatanee jalqabanee,","poem":2},{"lineBreak":true},{"text":"karaa fedha ifii deemaa dhara dubbatan.","poem":2}]},{"type":"verse","number":4,"content":["Isaan akka dhudhuufa'aa hadhaa qaban;",{"text":"isaan akka buutii gurra duuddu'uu,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ta qoonqoo worra qorsaan muusessuu,","poem":2},{"lineBreak":true},{"text":"yookiin dubbii worra qaroolee xanoo hujuulle hin dhageennee ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ee Waaqa,","poem":1},{"text":"ilkaan isaanii afaan isaanii keessatti caccassi;","poem":2},{"lineBreak":true},{"text":"Ee Mootii Waan Maraa,","poem":2},{"lineBreak":true},{"text":"worra akka dardaroota neenqaa qadhiffaa qabu,","poem":2},{"lineBreak":true},{"text":"qadhiffaa isaanii butuchii keessaa harcaasi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Akka bisaan lola'ee dabaruu badanuu ti;","poem":1},{"text":"yennaa isaan guubee qopheeffatanu,","poem":2},{"lineBreak":true},{"text":"daayi isaanii tutuma te'uu ti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Isaan akka calanqaa adoo ideemuu baquu te'anuu ti;","poem":1},{"text":"isaan akka finna du'ee dhalatee,","poem":2},{"lineBreak":true},{"text":"ka ijjumaa ifa hin dhagginii te'anuu ti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isaan akka haasumee jiituu","poem":1},{"text":"yookiin godduu adoo hin bobe'in,","poem":2},{"lineBreak":true},{"text":"adoo okkotee hin o'isiniin dura","poem":2},{"lineBreak":true},{"text":"qilleensaan haxowantuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Worri balchaan","poem":1},{"text":"Waaqi haluu isaaniif bayuun yennaa dhagganu,","poem":2},{"lineBreak":true},{"text":"gammadaan firinxiixan;","poem":2},{"lineBreak":true},{"text":"miila ifii dhiiga worra hamaaleyyi'iitiin dhiqatan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yennaa san namooti,","poem":1},{"text":"«Dhugumaan worri balchaan","poem":2},{"lineBreak":true},{"text":"gatii hin dhaggatan;","poem":2},{"lineBreak":true},{"text":"dhugumaan Waaqi biyya lafaatitti muru","poem":2},{"lineBreak":true},{"text":"hin jira» hin jedhan.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}