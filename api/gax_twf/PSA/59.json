{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":59,"content":[{"type":"heading","content":["Diinota Jalaa Bayiisaaf Daadimata Dhikaate"]},{"type":"heading","content":["Sooressa faarfattootaatiif, faaruu Daawitii, ta akka yoyyoma faaruu, «Hin balleessin» jedhantee beekkantutti, yennaa Saa'ol Daawitii ijjeesiisaaf namoota ergee mana isaa eegisiise faarfatante."]},{"type":"verse","number":1,"content":[{"text":"Ee Waaqa kiyya, diinota jalaa na baasi;","poem":1},{"text":"worra na irratti ka'u irraa na eegi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Worra hamaaleyyii jalaa na baasi;","poem":1},{"text":"worra dhiiga namaa dhangalaasu jalaa","poem":2},{"lineBreak":true},{"text":"na hamburi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Isaan ammaayyuu riphanee na gaadan;","poem":1},{"text":"Ee Mootii Waan Maraa,","poem":2},{"lineBreak":true},{"text":"ani cubbuu yookiin dokonkora adoo hin hujin,","poem":2},{"lineBreak":true},{"text":"worri hunnaameyyiin na irratti ka'an.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ani dokonkora womaa adoo hin hujin,","poem":1},{"text":"isaan na loliisaaf qophowaneeran.","poem":2},{"lineBreak":true},{"text":"Na qarqaariisaaf ka'i;","poem":2},{"lineBreak":true},{"text":"gara kiyya koyii na ilaali!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee Mootiin Waan Maraa","poem":1},{"text":"Waaqa Waan Mara Dande'u,","poem":2},{"lineBreak":true},{"text":"Waaqa Israa'elii,","poem":2},{"lineBreak":true},{"text":"gosa biyya adda addaa adabiisaaf ka'i;","poem":2},{"lineBreak":true},{"text":"worra hamaaleyyii,","poem":2},{"lineBreak":true},{"text":"diinaaf dabarsee nama kennu hin mararin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Isaan akka sare'ee gurura'aa,","poem":1},{"text":"galgala galgala qachaa keessa loxxisan.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Waan afaan isaanii keessaa bayu ilaali;","poem":1},{"text":"arrabi isaanii akka shallaaga'aa ti;","poem":2},{"lineBreak":true},{"text":"isaan, «Nami nu dhage'u hin jiru» jedhaa yaadan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ati ammoo isaanitti hin kollita;","poem":2},{"lineBreak":true},{"text":"gosa biyya adda addaa maratti hin murgita.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ee Waaqa, ati jabeenna kiyya,","poem":1},{"text":"gollaa kiyyalle waan teeteef,","poem":2},{"lineBreak":true},{"text":"ani si eegadha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Waaqi jaalala ifii ka bara baraatiin","poem":1},{"text":"naan dura ideema;","poem":2},{"lineBreak":true},{"text":"inni akka ani injifatamiisa diinota kiyyaa dhaggu","poem":2},{"lineBreak":true},{"text":"hin godha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ee Gootta'a, wontee teenna,","poem":1},{"text":"kolbaan injifachaa keeti akka hin deene,","poem":2},{"lineBreak":true},{"text":"isaan hin ijjeesin;","poem":2},{"lineBreak":true},{"text":"hunna teetiin isaan bittinneessii,","poem":2},{"lineBreak":true},{"text":"isaan salphisi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sababa cubbuu afaan isaaniitiif,","poem":1},{"text":"sababa dubbii arraba isaaniitiif,","poem":2},{"lineBreak":true},{"text":"koora isaaniitiin qabamanuu ti.","poem":2},{"text":"Abaarsaa fi dhara waan dubbatanuuf,","poem":1}]},{"type":"verse","number":13,"content":[{"text":"aarii teetiin isaan balleessi;","poem":2},{"lineBreak":true},{"text":"ijjumaa isaan balleessi.","poem":2},{"text":"Achiin duuba haga qaccee lafaatitti","poem":1},{"text":"akka Waaqi kolbaa Yaaqoobii bulchu hin beekkanti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Isaan akka sare'ee gurura'aa,","poem":1},{"text":"galgala galgala qachaa keessa loxxisan.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Isaan akka saree sagale'eef loxxittuu,","poem":1},{"text":"ta yoo quufuu dhadde gururaatuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ati guyyaa rakkinnaa gollaa kiyya,","poem":1},{"text":"addee ani itti baqadhulle waan teeteef,","poem":2},{"lineBreak":true},{"text":"marroo jabeenna keetiitii fi","poem":2},{"lineBreak":true},{"text":"marroo jaalala keeti ka bara baraa","poem":2},{"lineBreak":true},{"text":"ganama mara hin faarfadha.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ee Waaqa, ati gollaa kiyya,","poem":1},{"text":"Waaqa na jaalatu,","poem":2},{"lineBreak":true},{"text":"ee jabeenna kiyya,","poem":2},{"lineBreak":true},{"text":"faaruu leellisaa sii dhikeessa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}