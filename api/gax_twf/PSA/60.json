{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":60,"content":[{"type":"heading","content":["Daadimata Qarqaarsa Waaqaa Dhaggatiisaaf Dhikaate"]},{"type":"heading","content":["Faaruu Daawitii, sooressa faarfattootaatiif, ta akka yoyyoma faaruu, «Daraaraa» jedhantee beekkantutti faarfatante. Dhugaa bayiisa. Faaruu barsiisiisaa, ta inni yennaa worra Aaramii ka biyya bisaan lama oddu'uutii fi worra Aaram Xoba'aa woliin wol lole, yennaa Yo'aab deebi'ee dhooqa sooddaa keessatti namoota Edoomii kuma kudha lama injifate faarfate."]},{"type":"verse","number":1,"content":[{"text":"Ee Waaqa, ati nu gatteerta;","poem":1},{"text":"nu caccassiteerta;","poem":2},{"lineBreak":true},{"text":"nutti aarteerta; amma adde'etti nu deebisi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ati lafa tachoottee, dhodhoocheerta;","poem":1},{"text":"isiin waan raafamiisatti jirtuuf,","poem":2},{"lineBreak":true},{"text":"dho'a isi'ii san fayyisi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ati kolbaan teeti","poem":1},{"text":"akka guddoo rakkattu gooteerta;","poem":2},{"lineBreak":true},{"text":"daadhii woyni'ii","poem":2},{"lineBreak":true},{"text":"ta akka nuuti tintimaa ideennu nu gootu","poem":2},{"lineBreak":true},{"text":"nuu kenniteerta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isaan akka daaya jalaa miliqanuuf,","poem":1},{"text":"ati worra si sodaatuuf,","poem":2},{"lineBreak":true},{"text":"baandiraa akka ol kaafatanu","poem":2},{"lineBreak":true},{"text":"isaaniif kenniteerta.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kolbaan ati jaalattu akka baatu,","poem":1},{"text":"hunna teetiin nu baasi;","poem":2},{"lineBreak":true},{"text":"daadimata keennaafille deebii kenni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Waaqi addee woyyittii ifii keessaa,","poem":1},{"text":"«Ani injifadhee,","poem":2},{"lineBreak":true},{"text":"lafa ‹Sheekem› jedhantu hin hira;","poem":2},{"lineBreak":true},{"text":"dhooqa Suukootii kolbaa tiyyaaf qooda.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Latti Giil'aadii tiyya;","poem":1},{"text":"latti Minaase'eelle tiyya;","poem":2},{"lineBreak":true},{"text":"Efreem gullee tiyya ta sibiilaa ti;","poem":2},{"lineBreak":true},{"text":"Yihudaan ulee tiyya ta bokku'uu ti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mo'aab gabataa kiyya ka itti dhiqataa ti;","poem":1},{"text":"Edoom kiyya akka te'e mirkaneessiisaaf,","poem":2},{"lineBreak":true},{"text":"kophee tiyya irratti hin qolaansa;","poem":2},{"lineBreak":true},{"text":"Filisxeemota irratti injifanno'oon ilillisa» jedheera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Gara qachaa guddicha dalleya","poem":1},{"text":"dhaka'aatiin marfamee eentu na fida ree?","poem":2},{"lineBreak":true},{"text":"Akka loluuf gara Edoomii eentu na geessa ree?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ee Waaqa, ati nu gatteerta;","poem":1},{"text":"loltoota teenna woliin bayiisa lakkitteerta.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Qarqaarsi namaa womaa waan nu'uuf hin baaneef,","poem":1},{"text":"diinota keenna akka lolluuf,","poem":2},{"lineBreak":true},{"text":"ati nu qarqaar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Qarqaarsa Waaqaatiin hin injifanna;","poem":1},{"text":"inni diinota keenna hin salphisa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":12}