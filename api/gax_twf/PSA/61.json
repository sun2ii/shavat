{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":61,"content":[{"type":"heading","content":["Daadimata Diinota Jalaa Bayiisaaf Dhikaate"]},{"type":"heading","content":["Sooressa faarfattootaatiif, faaruu Daawitii ta meya ribu'uutiin faarfatante."]},{"type":"verse","number":1,"content":[{"text":"Ee Waaqa, iyya tiyya dhage'i;","poem":1},{"text":"daadimata kiyya caqasi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Addii kutadhee,","poem":1},{"text":"qaccee lafaa irraa si waammadha;","poem":2},{"lineBreak":true},{"text":"Gara rassaa na caalaa","poem":1},{"text":"ol ka'eeruu san na geessi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ati addee ani itti baqadhu waan teeteef,","poem":1},{"text":"diinota kiyya loliisaaf,","poem":2},{"lineBreak":true},{"text":"ati xelleephoo tiyya jaddu'u.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ani bara jiruu tiyyaa mara","poem":1},{"text":"mana keeti keessa le'uu fedha.","poem":2},{"lineBreak":true},{"text":"Gaaddisa bobaa teetii jalatti baqatuu fedha.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ee Waaqa, waadaa kiyya dhageetteerta;","poem":1},{"text":"qooda worra maqaa keeti sodaatuuf kennite","poem":2},{"lineBreak":true},{"text":"naafille kenniteerta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bara jiruu mootichaa irratti","poem":1},{"text":"woggaa hedduu ede'i;","poem":2},{"lineBreak":true},{"text":"inni dhalootaa haga dhaloota heddu'uu le'uu ti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Fuula keeti duratti","poem":1},{"text":"haga bara baraa isa mootonsi;","poem":2},{"lineBreak":true},{"text":"jaalala keeti ka bara baraatii fi","poem":2},{"lineBreak":true},{"text":"addatamummaa teetiin isa eegi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Guyyuma guyya'aan waadaa kiyya eegatiisaan,","poem":1},{"text":"yennaa mara faaru'uun maqaa keeti leellisa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}