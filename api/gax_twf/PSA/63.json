{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":63,"content":[{"type":"heading","content":["Waaqa Barbaadiisa"]},{"type":"heading","content":["Faaruu Daawitii ta inni yennaa goomolee Yihuda'aa keessa jiru Faarfate."]},{"type":"verse","number":1,"content":[{"text":"Ee Waaqa, ati Waaqa kiyya;","poem":1},{"text":"ani si barbaada.","poem":2},{"text":"Akka lafa bisaan dhaddee goggoddee,","poem":1},{"text":"lubbuun tiyya si dheebotti;","poem":2},{"lineBreak":true},{"text":"nafi kiyyalle si dharra'a.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tanaaf, ani Dunkaanii Woyyittii teeti keessatti","poem":1},{"text":"si ilaalee,","poem":2},{"lineBreak":true},{"text":"hunnaa fi ulfinna keeti dhagge.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jaalalli keeti ka bara baraa","poem":1},{"text":"jiruu waan caaluuf,","poem":2},{"lineBreak":true},{"text":"arrabi kiyya si leellisa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ani haga jiru si leellifadha;","poem":1},{"text":"harka kiyya ol qabadhee,","poem":2},{"lineBreak":true},{"text":"maqaa keeti waammadha.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Akka sagalee dansaa nyaatteetitti,","poem":1},{"text":"lubbuun tiyya quutte;","poem":2},{"lineBreak":true},{"text":"afaan kiyya arraba ililleetti'iitiin si leellisa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taqee tiyya irratti si qaabadha;","poem":1},{"text":"halkan duudii marroo teeti yaada.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ati qarqaarsa kiyya waan teeteef,","poem":1},{"text":"gaaddisa bobaa teetii jalatti,","poem":2},{"lineBreak":true},{"text":"gammadaan faarfadha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lubbuun tiyya sitti maxxanti;","poem":1},{"text":"harki keeti middichi ol na qaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Worri jiruu tiyya balleessiisaaf barbaadu,","poem":1},{"text":"qilee lafa jalaatitti gad bu'a.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Isaan shallaagaa afaan bu'an;","poem":1},{"text":"jeedalaaf sagalee te'an.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mootichi ammoo","poem":1},{"text":"Waaqaan hin gammada;","poem":2},{"lineBreak":true},{"text":"worri maqaa Waaqaatiin kakatu marti","poem":2},{"lineBreak":true},{"text":"Waaqa hin leellisa;","poem":2},{"lineBreak":true},{"text":"afaan worra dharaameyyi'ii hin cufama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}