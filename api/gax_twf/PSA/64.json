{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":64,"content":[{"type":"heading","content":["Daadimata Diinota Jalaa Bayiisaaf Dhikaate"]},{"type":"heading","content":["Faaruu Daawitii, sooressa faarfattootaatiif."]},{"type":"verse","number":1,"content":[{"text":"Ee Waaqa, rakkinna keessatti","poem":1},{"text":"qoonqoo tiyya naaf dhage'i;","poem":2},{"lineBreak":true},{"text":"sodaachisaa diinaa irraa na eegi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mala worra hama'aa duraa,","poem":1},{"text":"waan hantuu hujiisaa","poem":2},{"lineBreak":true},{"text":"worra wolitti qabamu duraa na dhossi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isaan arraba ifii akka shallaaga'aa qaratan;","poem":1},{"text":"dubbii hadhoottuu akka daayaa darbatan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isaan dhokatanee nama yakkaa hin qannetti,","poem":1},{"text":"sodaa malee dedhuma darbatan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isaan waan hantuu hujiisaaf woliin mari'atan;","poem":1},{"text":"tiyyoo afiisaaf dhossa'aan mala dhowaa,","poem":2},{"lineBreak":true},{"text":"«Eentu nu dhagga?» jedhaa yaadan.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yaadi gadhaa namaatii fi qalbiin namaa","poem":1},{"text":"gad fagoo waan teeteef,","poem":2},{"lineBreak":true},{"text":"isaan waan hantuu mala dhowanee,","poem":2},{"lineBreak":true},{"text":"«Nuuti mala dansaa dhoonneera» jedhan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Waaqi ammoo daaya ifii gara isaanii hin darbata;","poem":1},{"text":"isaan dedhuma hin madowan.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Waaqi dubbuma arraba isaaniitiin","poem":1},{"text":"gara badi'ii isaan fida;","poem":2},{"lineBreak":true},{"text":"worri isaan dhaggu marti","poem":2},{"lineBreak":true},{"text":"murgo'oon mataa ifii itti hin raasan.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nami marti hin sodaata;","poem":1},{"text":"isaan hujii Waaqaa lallabaa,","poem":2},{"lineBreak":true},{"text":"waan inni godhelle yaadanee hin hubatan.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Worri balchaan","poem":1},{"text":"Mootii Waan Maraatiin gammaduu ti;","poem":2},{"lineBreak":true},{"text":"isatti baqatuu ti;","poem":2},{"lineBreak":true},{"text":"worri qajeelaan marti","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa leellisuu ti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}