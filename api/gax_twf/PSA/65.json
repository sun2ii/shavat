{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":65,"content":[{"type":"heading","content":["Leellisaa Fi Galata"]},{"type":"heading","content":["Faaruu Daawitii, sooressa faarfattootaatiif."]},{"type":"verse","number":1,"content":[{"text":"Ee Waaqa, Xiyoon keessatti","poem":1},{"text":"si leellisuu,","poem":2},{"lineBreak":true},{"text":"waadaa si'iif gallelle muummessuu qanna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ee ka daadimata namaa dhageettu,","poem":1},{"text":"nami marti gara keeti hin dhufa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Cubbuun nu moote;","poem":1},{"text":"ati ammoo yakkaa teenna nuu araarante.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Worri ati filattee","poem":1},{"text":"badhinna mana keetii keessa akka le'anu","poem":2},{"lineBreak":true},{"text":"ka ifitti dhikeeffatte ka eebbifame.","poem":2},{"text":"Nuuti waan dansaa mana keetii,","poem":1},{"text":"ta Dunkaanii Woyyittii teetiitiin hin quunna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee Waaqa fayyisaa keenna,","poem":1},{"text":"hujii maade'ee","poem":2},{"lineBreak":true},{"text":"ta balchumma'aatiin deebii nuuf kennita.","poem":2},{"text":"Worri qaccee lafaa","poem":1},{"text":"abbaaya'aan gama fagoo jiru martille","poem":2},{"lineBreak":true},{"text":"addii sitti godhata.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ati hunna teeti uffattee,","poem":1},{"text":"jabeenna keetiin gaarota dadde.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ati Shookkessa abbaaya'aatii fi danbalii isi'ii,","poem":1},{"text":"caanca gosa biyya adda addaalle cadhi goota.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bilbaasa ati gooteen,","poem":1},{"text":"worri biyya lafaa irra le'u duudiin,","poem":2},{"lineBreak":true},{"text":"hin sodaata;","poem":2},{"lineBreak":true},{"text":"addee aduun baatu irraa","poem":2},{"lineBreak":true},{"text":"haga addee aduun seentuutitti,","poem":2},{"lineBreak":true},{"text":"ililleettiin akka dhage'antu hin goota.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ati lafa ilaaltee, rooba kennitaaf;","poem":1},{"text":"guddoo laattuu isii goota.","poem":2},{"text":"Lagi Waaqaa, bisaaniin guuteera;","poem":1},{"text":"akkas gootee waan qopheessiteef,","poem":2},{"lineBreak":true},{"text":"kolbaan midhaan dhaggatti.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Fichaa qotame irratti","poem":1},{"text":"bokkeya bacaa roobisiitta;","poem":2},{"lineBreak":true},{"text":"quqquuqaa isaalle hin bulleessita;","poem":2},{"lineBreak":true},{"text":"biyyee tiifu'uun laafficha;","poem":2},{"lineBreak":true},{"text":"mudheen","poem":2},{"noteId":9},{"text":"lattee akka guddattu goota.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Arjummaa teetiin bara eebbitta!","poem":1},{"text":"Gara ati dhaxxe mara","poem":2},{"lineBreak":true},{"text":"midhaan baca'atti jiraata.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Goomoleen marti bisiltee,","poem":1},{"text":"koobotille gammada akka woya'aa uffatan.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Diidi tika hoolotaatiin,","poem":1},{"text":"dhooqille midhaaniin guutaman;","poem":2},{"lineBreak":true},{"text":"isaan ilillisaa faaruu faarfatan.","poem":2}]}],"footnotes":[{"noteId":9,"caller":"+","text":"Mudheen: Lafa tokko tokkotti mudhoon","reference":{"chapter":65,"verse":10}}]},"thisChapterLink":"/api/gax_twf/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}