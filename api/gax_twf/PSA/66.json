{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":66,"content":[{"type":"heading","content":["Faaruu Leellisaatii Fi Galataa"]},{"type":"heading","content":["Faaruu, sooressa faarfattootaatiif."]},{"type":"verse","number":1,"content":[{"text":"Biyyi lafaa duudiin,","poem":1},{"text":"Waaqaaf gammadaa ilillisa'a.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ulfinna maqaa isaatiif faarfadha'a;","poem":1},{"text":"leellisa ulfinnaa isaaf kenna'a.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Waaqaan, «Hujiin teeti attam attam bilbaasa!","poem":1},{"text":"Hunni teeti guddoo waan teeteef,","poem":2},{"lineBreak":true},{"text":"diinoti keeti soda'aan si duratti hollatan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Worri lafa irra jiru marti sii sagadan;","poem":1},{"text":"isaan faaru'uun si leellisan;","poem":2},{"lineBreak":true},{"text":"maqaa keeti leellisaa faarfatan» jedha'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Waan Waaqi godhe kowa'aa ilaala'a;","poem":1},{"text":"inni hujii baasaa odduu kolba'aatitti hujeera.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inni abbaayaa gargar kutee,","poem":1},{"text":"kolbaan isaa miila ifiitiin lafa godduu irra","poem":2},{"lineBreak":true},{"text":"laga Yordaanosii gamatti buute;","poem":2},{"lineBreak":true},{"text":"nuutille waan inni godheen gammanne.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni hunna ifiitiin haga bara baraa hin bulcha;","poem":1},{"text":"ilti isaa gosa biyya adda addaa hin eeddi.","poem":2},{"lineBreak":true},{"text":"Worri isa finqilu isa irratti hin ka'in.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ee, gosi biyya adda addaa","poem":1},{"text":"Waaqa keenna leellisa'a;","poem":2},{"lineBreak":true},{"text":"qoonqoo ol qabadha'aatii isa leellisa'a.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inni jiru'uun nu eegee,","poem":1},{"text":"miila keennalle akka hin mucucaanne godheera.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ee Waaqa, ati haga nu ilaalteerta;","poem":1},{"text":"akkuma meetiin ibiddaan dhimbiibantu,","poem":2},{"lineBreak":true},{"text":"ati nu dhimbiidde.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ati tiyyoo keessa nu galchite;","poem":1},{"text":"ba'aa ulfaattuu dudda keenna irra keette.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ati akka namooti mataa keenna irratti bayanu goote;","poem":1},{"text":"ibiddaa fi bisaan keessa dabarre;","poem":2},{"lineBreak":true},{"text":"amma ammoo addee wonni dansaan jirtutti nu baache.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ani ciincaa qabadhee gara mana keetii hin seena;","poem":1},{"text":"waan waadaa gale si'iif hin muummessa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Waadaan sun ka ani yennaa rakkoo keessa jiru","poem":1},{"text":"arrabi kiyya tuqee, afaan kiyya dubbate.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ciincaa horii cocoomaatii fi","poem":1},{"text":"ciincaa korbeeyyii hoole'ee si'iif hin dhikeessa;","poem":2},{"lineBreak":true},{"text":"korommi'ii fi korbeeyyii re'e'ee hin kenna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Isin worri Waaqa sodaattanu marti,","poem":1},{"text":"kowa'aa dhage'a'a;","poem":2},{"lineBreak":true},{"text":"ani waan Waaqi naaf godhe hin hima.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ani guddisee gara isaa iyye;","poem":1},{"text":"arraba kiyyaan isa saade.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ani cubbuu gadhaa kiyya keessatti","poem":1},{"text":"adoo dhoffadhee jiraadhee,","poem":2},{"lineBreak":true},{"text":"Goottaan silaa na hin caqasuuyyu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Waaqi ammoo dhugumaan naaf caqaseera;","poem":1},{"text":"qoonqoo daadimata kiyyaalle dhage'eera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Daadimata kiyya waan hin tuffatiniif,","poem":1},{"text":"yookiin jaalala ifii ka bara baraa","poem":2},{"lineBreak":true},{"text":"waan na irraa hin fudhatiniif,","poem":2},{"lineBreak":true},{"text":"Waaqi leellifamuu ti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}