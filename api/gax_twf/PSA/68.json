{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":68,"content":[{"type":"heading","content":["Leellisaa Fi Galateeffatiisa"]},{"type":"heading","content":["Faaruu Daawitii, sooressa faarfattootaatiif."]},{"type":"verse","number":1,"content":[{"text":"Waaqi ol ka'uu ti;","poem":1},{"text":"diinoti isaa bittinnowanuu ti.","poem":2},{"lineBreak":true},{"text":"Worri isa jibbulle isa duraa baqatuu ti.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Akkuma qilleensi aara oofu,","poem":1},{"text":"atille isaan oofi;","poem":2},{"lineBreak":true},{"text":"akkuma gagaan ibidda duratti baqu,","poem":2},{"lineBreak":true},{"text":"worri hamaalle Waaqa duraa baduu ti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Worri balchooleen gammadanuu ti;","poem":1},{"text":"isaan Waaqa duratti ilillisanuu ti;","poem":2},{"lineBreak":true},{"text":"gammadaan firinxiixanuu ti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Waaqaaf faarfadha'a;","poem":1},{"text":"faaruu leellisaatiin maqaa isaa faarfadha'a;","poem":2},{"lineBreak":true},{"text":"ka duumensa irra deemu saada'a;","poem":2},{"lineBreak":true},{"text":"maqaan isaa Mootii Waan Maraa ti;","poem":2},{"lineBreak":true},{"text":"isa duratti ilillisa'a!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Waaqi addee woyyittii ifii keessa jira;","poem":1},{"text":"ijoollee abbaa hin qanneef abba'a;","poem":2},{"lineBreak":true},{"text":"haadhotii hiyyeessaatiifille abbaa mura'aa ti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Waaqi worra qofi le'uuf maatii hin kenna;","poem":1},{"text":"worra hidhamelle qananumma'atti hin baasa;","poem":2},{"lineBreak":true},{"text":"finqiltooti ammoo goomolee godduu keessa le'an.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ee Waaqa, yennaa ati kolbaa teeti sooressite,","poem":1},{"text":"goomolee keessa yennaa ideente,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Waaqa gaara Siina'aa duratti,","poem":1},{"text":"Waaqa Israa'elii duratti,","poem":2},{"lineBreak":true},{"text":"latti tachootee","poem":2},{"lineBreak":true},{"text":"ol-gubbaan bokkeya kennite.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ee Waaqa, ati bokkeya bacaa roobisiitte;","poem":1},{"text":"lafa teeti ta godde haaressite.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kolbaan teeti achitti qubatte.","poem":1},{"text":"Eebba keetiin worra hiyyeeyyi'iif","poem":2},{"lineBreak":true},{"text":"waan isaaniif barbaachisu kennite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Goottaan ajaja baase;","poem":1},{"text":"dubartooti hedduun oduu san dabarsane:","poem":2}]},{"type":"verse","number":12,"content":[{"text":"«Moototii fi loltooti isaanii ariiti'iin baqatane;","poem":1},{"text":"dubartooti mana jiranu boojuu qoodamane;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Worri hoolee tissiisaaf duubatti hafe","poem":1},{"text":"fakkii saphaliisaa ta koolli isi'ii meetii,","poem":2},{"lineBreak":true},{"text":"ta baalli isi'ii worqii bifa magariisaa","poem":2},{"lineBreak":true},{"text":"itti gonfame yennaa qoodamanu","poem":2},{"lineBreak":true},{"text":"isin maaf gooree hoole'ee keessa rattane?» jedhane.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ka waan mara dande'u","poem":1},{"text":"yennaa mootota lafa sanii bittinneesse,","poem":2},{"lineBreak":true},{"text":"dhakaan bokkeyaa gaara Zaalmon irratti bu'e.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Gaarri Baashaanii gaara ol aana'a;","poem":1},{"text":"gaarri Baashaanii qaccee hedduu qaba.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ee isin gaaroti qaccee hedduu qaddanu,","poem":1},{"text":"gaara Waaqi irra le'iisaaf filate,","poem":2},{"lineBreak":true},{"text":"ka Mootiin Waan Maraa haga bara baraa irra le'u,","poem":2},{"lineBreak":true},{"text":"maaf ila hinaaffa'aatiin ilaaltan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Garreettaa fardo'oon harkifamu","poem":1},{"text":"ka Waaqaa kuma hedduu woliin,","poem":2},{"lineBreak":true},{"text":"Goottaan gaara Siina'aa irraa","poem":2},{"lineBreak":true},{"text":"gara addee woyyittii ifii dhufa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mootii Waan Maraa Waaqa,","poem":1},{"text":"ati yennaa ol baate,","poem":2},{"lineBreak":true},{"text":"boojuu fudhattee gara addee leetuu dhaxxe;","poem":2},{"lineBreak":true},{"text":"kolbaa mara irraa,","poem":2},{"lineBreak":true},{"text":"worra si mormu irralle'ee kennansa fudhatte.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Goottaan, Waaqi fayyisaan keenna,","poem":1},{"text":"ka guyyaa mara ba'aa teenna ba'atu,","poem":2},{"lineBreak":true},{"text":"leellifamuu ti.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Waaqi keenna, Waaqa nu fayyisu;","poem":1},{"text":"Mootiin Waan Maraa Waaqi ka du'a jalaa nu baasu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Waaqi ammoo mataa diinota ifii,","poem":1},{"text":"buqqii mataa worra karaa cubbuu ifiititti jabaatuu hin butucha.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Goottaan, «Ani diinota keeti biyya Baashaaniitii fi","poem":1},{"text":"qilee abbaaya'aa keessaa deebisee hin fida;","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Achiin duuba ati dhiiga isaanii keessa ijjatta;","poem":1},{"text":"sareeleen teetille qooda ifii hin arraabbatan» jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ee Waaqa, gogeessi worra si woliin jiruu,","poem":1},{"text":"ka ati Waaqi mootiin kiyya","poem":2},{"lineBreak":true},{"text":"gara addee woyyittii teetii seentu mudhate.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Worri faarfatu fuula duraan,","poem":1},{"text":"worri meya faarfanna'aa dhowanu duubaan,","poem":2},{"lineBreak":true},{"text":"ijoolleen durra ta dibbee dhoottu,","poem":2},{"lineBreak":true},{"text":"wodhakkaa isaaniitiin jiraniiyyu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Isaan, «Gumii guddoo keessatti Waaqa leellisa'a;","poem":1},{"text":"gumii kolbaa Israa'elii keessatti","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa leellisa'a» jedhan.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Gosi Beniyaaminii diqqoon isaan sooressiti;","poem":1},{"text":"qondaaltoti Yihuda'aa golii ifii woliin,","poem":2},{"lineBreak":true},{"text":"qondaaltoti Zebulooniitii fi","poem":2},{"lineBreak":true},{"text":"qondaaltoti Naftaalemii achi jiraniiyyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ee Waaqa, hunna teeti ajaji;","poem":1},{"text":"akkuma dur nuuf goote,","poem":2},{"lineBreak":true},{"text":"ee Waaqa jabeenna keeti mudhisi.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Sababa Dunkaanii Woyyittii teeti","poem":1},{"text":"ta Yerusaalem keessaatiif,","poem":2},{"lineBreak":true},{"text":"moototi kennansa si'iif fidan.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Biyya Gibxi'ii,","poem":1},{"text":"ta akka bineensa shonbooqqoo keessaa xixi;","poem":2},{"lineBreak":true},{"text":"mootota biyya adda addaa,","poem":2},{"lineBreak":true},{"text":"ta akka korommi'iitii fi jabbi'ii xixi.","poem":2},{"text":"Akka meeti'iin gabbaranu jilbiiffatanuu ti;","poem":1},{"text":"gosa biyya adda addaa ta lola jaalattu bittinneessi.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ergantooti biyya Gibxi'ii irraa hin dhufan;","poem":1},{"text":"kolbaan Itoophiya'aa","poem":2},{"noteId":10},{"lineBreak":true},{"text":"harka ifii gara Waaqaa hin diriirsiti.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ee isin mootummooti biyya lafaa","poem":1},{"text":"Waaqaaf faarfadha'a;","poem":2},{"lineBreak":true},{"text":"faaruu leellisaa Gootta'aaf faarsa'a.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ka ol-gubbaa durii duriitii jalqaddee jirtu,","poem":1},{"text":"gubbaa ideemuuf faarfadha'a;","poem":2},{"lineBreak":true},{"text":"inni qoonqoo ifii jaddu'uun","poem":2},{"lineBreak":true},{"text":"mandi'uun caqasa'a.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Waaqa arnyi isaa Israa'el irra jiru,","poem":1},{"text":"ka hunni isaa gubbaa keessa jirtu,","poem":2},{"lineBreak":true},{"text":"hunna isaa lallaba'a.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Waaqi, addee woyyittii ifii keessaa,","poem":1},{"text":"attam attam sodaachisa;","poem":2},{"lineBreak":true},{"text":"inni kolbaa ifii Israa'eliif","poem":2},{"lineBreak":true},{"text":"hunnaa fi jabeenna kenna;","poem":2},{"lineBreak":true},{"text":"Waaqi leellifamuu ti.","poem":1}]}],"footnotes":[{"noteId":10,"caller":"+","text":"Itoophiyaa: Afaan Ibrootaatiin Kuushi jedha.","reference":{"chapter":68,"verse":31}}]},"thisChapterLink":"/api/gax_twf/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":35}