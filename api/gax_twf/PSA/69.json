{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":69,"content":[{"type":"heading","content":["Daadimata Qarqaarsa Dhaggatiisaa Dhikaate"]},{"type":"heading","content":["Sooressa faarfattootaatiif, faaruu Daawitii ta akka yoyyoma faaruu, «Daraaraa» jedhantee beekkantutti faarfatante."]},{"type":"verse","number":1,"content":[{"text":"Bisaan waan morma na geyeef,","poem":1},{"text":"Ee Waaqa na baasi!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ani qilee caffa'aa keessa lixe;","poem":1},{"text":"miilli kiyya waan irra dhaabbatu dhabe;","poem":2},{"lineBreak":true},{"text":"ani qilee bisaanii keessa lixe;","poem":2},{"lineBreak":true},{"text":"lolaan na liqinse.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ani iyyiisaan dadhabe;","poem":1},{"text":"laagadaan na babbaqaqe;","poem":2},{"lineBreak":true},{"text":"qarqaarsa Waaqaa eeggatiisaan","poem":2},{"lineBreak":true},{"text":"ilti tiyya dadhadde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Worri sababa malee na jibbu,","poem":1},{"text":"rifeensa mataa kiyyaa caalaa bacata;","poem":2},{"lineBreak":true},{"text":"diinoti kiyya worri dharaan na himatu,","poem":2},{"lineBreak":true},{"text":"ka na balleessiisaaf barbaadu heddu'u.","poem":2},{"text":"Ani waan hin hatin","poem":1},{"text":"ade'etti deebisuu qabaa ree?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ee Waaqa, ati gowwummaa tiyya hin beetta;","poem":1},{"text":"yakkaan tiyya si duraa dhokattee hin jirtu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ee Waaqa waan mara dande'u,","poem":1},{"text":"worri si addatu,","poem":2},{"lineBreak":true},{"text":"sababa kiyyaaf hin fokkifatin.","poem":2},{"text":"Ee Waaqa Israa'elii,","poem":1},{"text":"worri si barbaadu","poem":2},{"lineBreak":true},{"text":"sababa kiyyaaf hin qaanowin.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ani si'iif jedhee arraba ossadhe;","poem":1},{"text":"ani si'iif jedhee fokkoo uffadhe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ani obboleeyyan tiyyatti orma,","poem":1},{"text":"ilmaan haadha tiyyaatitti alagaa te'e.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Hinaaffaan mana keetiif qabu na gudde;","poem":1},{"text":"arrabi si arrassanu na irra bu'e.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yennaa ani laamee bowe,","poem":1},{"text":"isaan na arrassane.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Woyaa gaddaa yennaa uffadhe,","poem":1},{"text":"nama ittiin mammaakanu isaaniif te'e.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ani waan worri addee yaa'ii tee'u ittiin mammaaku te'e;","poem":1},{"text":"worri machowulle marroo tiyya sirba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"yennaa si biratti fudhatama qaddutti","poem":2},{"lineBreak":true},{"text":"ani gara keeti daadimadha;","poem":2},{"lineBreak":true},{"text":"ee Waaqa jaalala keeti ka bara baraatiin,","poem":2},{"lineBreak":true},{"text":"fayyisiisa keeti ka dhuga'aatiin,","poem":2},{"lineBreak":true},{"text":"deebii naaf kenni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dhoqqee keessa lixiisa irraa na hamburi;","poem":1},{"text":"diinota kiyya jalaa,","poem":2},{"lineBreak":true},{"text":"qilee bisaanii keessaa na baasi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Lolaan na fudhatee hin deemin;","poem":1},{"text":"yookiin qileen na hin liqinsin;","poem":2},{"lineBreak":true},{"text":"yookiin boolli na irratti hin cufamin.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"jaalalli keeti ka bara baraa dansaa waan te'eef,","poem":2},{"lineBreak":true},{"text":"deebii naaf kenni;","poem":2},{"lineBreak":true},{"text":"marartii teeti guddo'oon gara kiyya deebi'i.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Fuula keeti ana tajaajilaa keeti duraa hin dhoffatin;","poem":1},{"text":"ani rakkoo guddoo keessa waan jiruuf,","poem":2},{"lineBreak":true},{"text":"ariifadhuu deebii naaf kenni.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Natti dhikaadhuu na wodi;","poem":1},{"text":"dhiibbii","poem":2},{"noteId":11},{"text":"diinota kiyyaatiif jedhii na baasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Arraffamiisa kiyya, qaanowiisa kiyya,","poem":1},{"text":"salphatiisa kiyyalle hin beetta;","poem":2},{"lineBreak":true},{"text":"ati diinota kiyya mara dhaggita.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Arrabi na miidhee,","poem":1},{"text":"anille addii kutadhe;","poem":2},{"lineBreak":true},{"text":"nama naaf nayu barbaadee,","poem":2},{"lineBreak":true},{"text":"ammoo dhabe.","poem":2},{"text":"Nama na jajjabeessulle barbaadee,","poem":1},{"text":"ammoo tokkolle hin dhagganne.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Akka nyaadhuuf hadhaa naaf kennane;","poem":1},{"text":"dheebuu tiyyaaf","poem":2},{"lineBreak":true},{"text":"daadhii woyni'ii dhangaggoottuu naaf kennane.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Qoriin isaanii fonxoroo isaanii teetuu ti;","poem":1},{"text":"worra isaan woliin nyaatuufille tiyyoo teetuu ti.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Akka hin dhaggine,","poem":1},{"text":"ilti isaanii dukkanoottuu ti;","poem":2},{"lineBreak":true},{"text":"hidhi isaanii yennaa mara lellequu ti.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mufii teeti isaan irratti dhangalaasi;","poem":1},{"text":"aariin teeti ta bobeettu isaan dhaqqadduu ti.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Quttumi isaanii onuu ti;","poem":1},{"text":"dunkaanii isaanii keessa nami hin le'in.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Isaan worra ati dhaante ari'an;","poem":1},{"text":"marroo farra worra ati madeessitee haasowan.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Yakkaa ifii irratti","poem":1},{"text":"yakkaa akka dabalatanuuf isaan lakkisi;","poem":2},{"lineBreak":true},{"text":"gara balchummaa teetii isaan hin fidin.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Maqaan isaanii","poem":1},{"text":"galmee worra jiraata'aa keessaa haqamuu ti;","poem":2},{"lineBreak":true},{"text":"isaan worra balchoolee woliin hin galmeeffamin.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ani ammoo farraa fi rakkinna guddaa keessa jira;","poem":1},{"text":"ee Waaqa, fayyisiisi keeti ol na qabuu ti.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ani faaru'uun maqaa Waaqaa hin leellisa;","poem":1},{"text":"galatalle'een isa ulfeessa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kun korma yookiin dardara","poem":1},{"text":"gaafaa fi qeenca qabu caalaa,","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa hin gammachiisa.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Worri cunqurfame tana dhaggee hin gammada;","poem":1},{"text":"isin worri Waaqa barbaaddanu","poem":2},{"lineBreak":true},{"text":"gadhaan keessan jajjabaatuu ti;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Mootiin Waan Maraa worra rakkata'aaf hin dhage'a;","poem":1},{"text":"kolbaa ifii worra hidhameerulle hin tuffatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Ol-gubba'aa fi latti,","poem":1},{"text":"abbaaya'aa fi wonni isii keessa munyuuqu marti","poem":2},{"lineBreak":true},{"text":"isa leellisanuu ti.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Waaqi qachaa Xiyoonii hin baasa;","poem":1},{"text":"qachoota Yihuda'aalle deebisee hin ijaara.","poem":2},{"text":"Kolbaan isaalle achitti qubattee,","poem":1},{"text":"lafa san hin qabatti.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ijoolleen tajaajiltoota isaa lafa san hin dhaalti;","poem":1},{"text":"worri maqaa isaa jaalatulle lafa san keessa hin le'a.","poem":2}]}],"footnotes":[{"noteId":11,"caller":"+","text":"Dhiibbii: Yookiin dhiibii","reference":{"chapter":69,"verse":18}}]},"thisChapterLink":"/api/gax_twf/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}