{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":7,"content":[{"type":"heading","content":["Daadimata Marroo Muraa Haqaa"]},{"type":"heading","content":["Faaruu Daawitii ta gaddaa, ta inni marroo Kuushii gosa Beniyaaminiitiif, gara Mootii Waan Maraa faarse."]},{"type":"verse","number":1,"content":["Ee Mootii Waan Maraa Waaqa kiyya, ani gara keeti baqadha;",{"text":"worra na ari'u jalaa na hamburii, na baasi!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yoo akkas hin te'in, addee nami na irraa buusu","poem":1},{"text":"hin jirretti na geessanee","poem":2},{"lineBreak":true},{"text":"akka neenqaa gargar na kukkutan.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ee Mootii Waan Maraa Waaqa kiyya,","poem":1},{"text":"ani nama tokko yoo yakkee jiraadhe,","poem":2},{"lineBreak":true},{"text":"harka kiyyaan dokonkora yoo hujee jiraadhe,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"nama nageyaan na woliin le'u hantuu godhee,","poem":2},{"lineBreak":true},{"text":"yookiin diina kiyya sababa malee yoo saamee jiraadhe,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"diinni kiyya ari'ee na qabuu ti;","poem":2},{"lineBreak":true},{"text":"lafa irratti na irra sirbee,","poem":2},{"lineBreak":true},{"text":"ulfinna kiyya bukuu keessatti lakkisuu ti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ee Mootii Waan Maraa, aarii teetiin ka'i;","poem":1},{"text":"worra mufi'iin na irratti ka'e irratti ka'i;","poem":2},{"lineBreak":true},{"text":"naa dammaqii, muraa haqaa ajaji.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kolbaan biyya adda addaa","poem":1},{"text":"adaala keetitti wolitti qabamanuu ti.","poem":2},{"lineBreak":true},{"text":"Atille ol-gubbaa irraa isaan bulchi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mootii Waan Maraa,","poem":1},{"text":"kolbaa biyya adda addaa irratti muraa kenni;","poem":2},{"lineBreak":true},{"text":"akka balchumma'aa fi dhugaammessummaa tiyyaatitti","poem":2},{"lineBreak":true},{"text":"muraa naaf kenni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ee Waaqa balcha'a,","poem":1},{"text":"ka qalbi'ii fi gadhaa nama qorqortu,","poem":2},{"lineBreak":true},{"text":"hammeenna worra hamaaleyyi'ii balleessi;","poem":2},{"lineBreak":true},{"text":"worra balchoolee jabeessii dhaabi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Waaqi wontee tiyya;","poem":1},{"text":"inni worra gadhaa qajeela'aa hin fayyisa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Waaqi abbaa mura'aa balcha'a;","poem":1},{"text":"Waaqi yennaa mara nama hama'atti hin aara.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nami hamaan hammeenna ifii irraa yoo hin deebi'in,","poem":1},{"text":"Waaqi shallaagaa ifii hin qarata;","poem":2},{"lineBreak":true},{"text":"guubee ifii hujee, qopheeffata.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Inni meya woraanaa ka ijjeesuu fi","poem":1},{"text":"daaya ifii ka akka ibiddaa bobe'u hin qopheeffata.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kolbaan hantuun hammeenna yaaddi;","poem":1},{"text":"daba karoorfattee,","poem":2},{"lineBreak":true},{"text":"dhara dubbatti.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nami boolla namaaf qotu,","poem":1},{"text":"ifumaafuu keessa bu'a.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hammeenni inni yaadate mataa isaatitti garagala;","poem":1},{"text":"wonni inni hunnaan nama irratti huje","poem":2},{"lineBreak":true},{"text":"matuma isaatitti deebiti.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sababa balchummaa isaatiif,","poem":1},{"text":"ani Mootii Waan Maraa hin galateessa;","poem":2},{"lineBreak":true},{"text":"maqaa Mootii Waan Maraa Ol Aana'aatiif","poem":2},{"lineBreak":true},{"text":"faaruu leellisaa hin faarsa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}