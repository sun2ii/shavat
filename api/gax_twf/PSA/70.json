{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":70,"content":[{"type":"heading","content":["Diinota jalaa Bayiisaaf Daadimata Dhikaate"]},{"type":"heading","content":["Sooressa faarfattootaatiif, faaruu Daawitii ta akka Waaqi isa qaabatuuf faarfatante."]},{"type":"verse","number":1,"content":[{"text":"Ee Waaqa na baasi;","poem":1},{"text":"Mootii Waan Maraa kiyya na qarqaariisaaf ariifadhu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Worri na ijjeesiisaaf barbaadu,","poem":1},{"text":"fokkifatee jaanjuruu ti;","poem":2},{"lineBreak":true},{"text":"worri na miidhiisaaf halchu,","poem":2},{"lineBreak":true},{"text":"salphatee gara duubaa deebi'uu ti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Worri, «Baga, baga!» naan jedhu,","poem":1},{"text":"fokkifatee gara duubaa deebi'uu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Worri si barbaadu marti ammoo,","poem":1},{"text":"si'iin gammadee firinxiixuu ti.","poem":2},{"text":"Worri fayyisiisa keeti jaalatu marti,","poem":1},{"text":"yennaa mara, «Waaqi gudda'a» jedhuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ani rakkataa hiyyeessa;","poem":1},{"text":"Ee Waaqa, ariifadhuu gara kiyya koy;","poem":2},{"text":"Ee Mootii Waan Maraa kiyya","poem":1},{"text":"ati qarqaara'aa fi fayyisaa kiyya","poem":2},{"lineBreak":true},{"text":"na irraa hin turin.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}