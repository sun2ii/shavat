{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":71,"content":[{"type":"heading","content":["Daadimata Jaarsaa"]},{"type":"verse","number":1,"content":[{"text":"Ee Mootii Waan Maraa, ani sitti baqadheera;","poem":1},{"text":"ani ijjumaa hin fokkifatin.","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ati balchummaa teetiin","poem":2},{"lineBreak":true},{"text":"na baasiitii, na hamburi;","poem":2},{"lineBreak":true},{"text":"gurra keeti gara kiyya deebifadhuutii, na baasi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ati rassaa kiyya ka ani itti baqadhu,","poem":1},{"text":"ka ani yennaa mara itti dhokadhu naa te'i;","poem":2},{"lineBreak":true},{"text":"ati rassaa kiyyaa fi","poem":2},{"lineBreak":true},{"text":"kushee jadduu tiyya waan teeteef,","poem":2},{"lineBreak":true},{"text":"na hamburiisaaf, ajaja baatteerta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ee Waaqa, harka worra hamaaleyyi'ii,","poem":1},{"text":"harka worra hantuu hujuutii fi","poem":2},{"lineBreak":true},{"text":"harka worra gadhi-jabeeyyi'ii keessaa na baasi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ee Gootta'a, Mootii Waan Maraa,","poem":1},{"text":"ati addii tiyya waan teeteef,","poem":2},{"lineBreak":true},{"text":"dargaggummaa tiyyaa jalqaddee","poem":2},{"lineBreak":true},{"text":"ka ani itti addadhu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gadhaa haadha tiyyaa keessaa","poem":1},{"text":"akka dhaladhu sittuu godhe;","poem":2},{"lineBreak":true},{"text":"dhaloota kiyyaa jalqabee sitti irkadheera;","poem":2},{"lineBreak":true},{"text":"ani yennaa mara si leellisa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ani nama heddu'uuf fakkeenna te'eera;","poem":1},{"text":"ati ammoo addee jadduu ani itti baqadhu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Guyyaa guutuu leellisii fi ulfinni keeti","poem":1},{"text":"afaan kiyya guuteera.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yennaa ani dulloometti na hin gatin;","poem":1},{"text":"yennaa ani jabeenna kiyya dhabetti na hin lakkisin.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Diinoti kiyya waan hantuu na irratti dubbatan;","poem":1},{"text":"worri na ijjeesiisaaf barbaadu,","poem":2},{"lineBreak":true},{"text":"woli woliin mari'atan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isaan, «Waaqi isa lakkiseera;","poem":1},{"text":"ka isa baasu hin jiru;","poem":2},{"lineBreak":true},{"text":"ari'a'aatii qaba'a» jedhan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ee Waaqa, na irraa hin fagaatin;","poem":1},{"text":"Ee Waaqa kiyya, na qarqaariisaaf ariifadhu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Worri diina natti te'u fokko'oon baduu ti;","poem":1},{"text":"worri na miidhiisaaf barbaadu,","poem":2},{"lineBreak":true},{"text":"tuffatamaa fi salphinna uffatuu ti.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ani yennaa mara addii si godhadha;","poem":1},{"text":"ittuma ede'ee, ede'ee si leellisa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Laakkossa hujii balchummaa teetiitii fi","poem":1},{"text":"fayyisiisa keetii haga wollaalulle,","poem":2},{"lineBreak":true},{"text":"afaan kiyya guyyaa guutuu hin dubbata.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ee Gootta'a, Mootii Waan Maraa,","poem":1},{"text":"ani dhufee hujii teeti jadduu san,","poem":2},{"lineBreak":true},{"text":"balchummaa teeti qofa lallaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ee Waaqa, dargaggummaa tiyyaa jalqaddee,","poem":1},{"text":"ati na barsiitteerta;","poem":2},{"lineBreak":true},{"text":"ani haga ammaa hujii teeti ta maade'ee odeessa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hunna teeti dhaloota dhufuuf,","poem":1},{"text":"hujii teeti ta maade'ee worra dhufu'uu jiru maraaf,","poem":2},{"lineBreak":true},{"text":"haga odeessutti","poem":2},{"lineBreak":true},{"text":"ani dulloomee arrii baasulle,","poem":2},{"lineBreak":true},{"text":"Ee Waaqa, na hin lakkisin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ee Waaqa, balchummaan teeti guddattee","poem":1},{"text":"ol-gubbaa geetteerti;","poem":2},{"lineBreak":true},{"text":"ati waan guddoo hujjeerta;","poem":2},{"lineBreak":true},{"text":"ee Waaqa, ka akka keetii eennu?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ati rakkoo heddu'uu fi","poem":1},{"text":"farra akka dhaggu na gootulle,","poem":2},{"lineBreak":true},{"text":"ati ammalle jiruu tiyya adde'etti deebittee,","poem":2},{"lineBreak":true},{"text":"qilee lafa jalaa keessaa ol na hin baatta.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ati ulfinna kiyya itti edeeta;","poem":1},{"text":"ammalle deebittee na hin jajjabeessita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ee Waaqa kiyya,","poem":1},{"text":"marroo addatamummaa teetiitiif,","poem":2},{"lineBreak":true},{"text":"ani kiraara guddichaan si leellisa;","poem":2},{"text":"Ee Woyyicha Israa'elii,","poem":1},{"text":"ani maseenqo'oon faaruu leellisaa sii faarsa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yennaa ani faaruu leellisaa si'iif faarsu,","poem":1},{"text":"afaan kiyya, lubbuun tiyya ta ati wodattelle","poem":2},{"lineBreak":true},{"text":"si'iif hin ilillisan.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Worri na miidhiisaaf barbaadu,","poem":1},{"text":"fokkifatee waan salphateef,","poem":2},{"lineBreak":true},{"text":"arrabi kiyya guyyaa guutuu","poem":2},{"lineBreak":true},{"text":"balchummaa teeti dubbata.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}