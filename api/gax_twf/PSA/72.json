{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":72,"content":[{"type":"heading","content":["Daadimata Marroo Mootichaa"]},{"type":"heading","content":["Faaruu Solomoonii."]},{"type":"verse","number":1,"content":[{"text":"Ee Waaqa, haqa muriisa keeti mootichaaf,","poem":1},{"text":"balchummaa teetille isaaf kenni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Innille kolbaa teeti balchumma'aan,","poem":1},{"text":"hiyyeeyyiille haqaan hin bulcha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gaaroti nageya,","poem":1},{"text":"koobotille balchummaa hin kennan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mootichi odduu kolba'aatitti","poem":1},{"text":"worra cunqurfameef hin falmata;","poem":2},{"lineBreak":true},{"text":"inni ijoollee worra hiyyeeyyi'ii hin baasa;","poem":2},{"lineBreak":true},{"text":"cunqursitoota hin butucha.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Haga adu'uu fi ji'i le'anu,","poem":1},{"text":"mootichi dhalootaa haga dhalootaatitti bulchuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Inni akka bokkeya","poem":1},{"text":"fichaa marri irraa haamame irratti roobuu,","poem":2},{"lineBreak":true},{"text":"akka tiifuu lafa jiittuu te'uu ti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bara isaatitti balchaan hin daraara;","poem":1},{"text":"haga ji'i ifa kennu mara, nageenni hin bacata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Inni abbaayaa irraa haga abbaaya'aatitti,","poem":1},{"text":"laga Efraaxiisii irraa haga qaccee lafaatitti bulchuu ti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Worri goomolee keessa le'u isa duratti sagaduu ti;","poem":1},{"text":"diinoti isaa biyyee arraabanuu ti.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Moototi Tarshiishii, ta oddoola keessaa,","poem":1},{"text":"gibira isaaf fidanuu ti;","poem":2},{"lineBreak":true},{"text":"moototi Sheeba'aatii fi Saaba'aalle","poem":2},{"lineBreak":true},{"text":"kennansa isaaf dhikeessanuu ti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Moototi marti isaaf sagadanuu ti;","poem":1},{"text":"gosi biyya adda addaa marti isa tajaajilanuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Inni worra hiyyeeyyii gara isaa iyyu,","poem":1},{"text":"worra rakkataa nama qarqaaru hin qanne hin baasa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Inni worra dadhaba'aa fi hiyyeeyyi'iif gadhaa laafa;","poem":1},{"text":"jiruu worra rakkata'aalle hin hambura.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dhiigi isaanii isa duratti gatii-qabeessa waan te'eef,","poem":1},{"text":"inni cunqurfamiisaa fi hunnaan irratti ka'iisa irraa,","poem":2},{"lineBreak":true},{"text":"lubbuu isaanii hin woda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mootichi bara dheeraa le'uu ti;","poem":1},{"text":"worqiin biyya Sheeba'aa isaaf kennantuu ti;","poem":2},{"lineBreak":true},{"text":"kolbaan yennaa mara isaaf daadimattuu ti;","poem":2},{"lineBreak":true},{"text":"guyyaa guutuu isa eebbittuu ti.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Lafa san keessa midhaan bacatuu ti;","poem":1},{"text":"koobota gubba'atti latuu ti;","poem":2},{"lineBreak":true},{"text":"midhaan inni buusulle","poem":2},{"lineBreak":true},{"text":"akka midhaan Libaanonii misuu ti;","poem":2},{"text":"Kolbaan qachaa keessaa,","poem":1},{"text":"akka marra diida keessaa bacattuu ti.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Maqaan isaa haga bara baraa jabaatee le'uu ti;","poem":1},{"text":"gurri isaa haga bara aduun jirtu mara jiraatuu ti.","poem":2},{"text":"Gosi biyya adda addaa marti isaan eebbifantuu ti;","poem":1},{"text":"Isaan, «Inni eebbifama'a» jedhanee","poem":2},{"lineBreak":true},{"text":"isa waamanuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Mootiin Waan Maraa,","poem":1},{"text":"Waaqi Israa'elii,","poem":2},{"lineBreak":true},{"text":"ka qofuu waan maade'ee huju,","poem":2},{"lineBreak":true},{"text":"leellifamuu ti.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Maqaan isaa ulfaataan","poem":1},{"text":"haga bara baraa leellifamuu ti;","poem":2},{"lineBreak":true},{"text":"biyyi lafaa duudiin ulfinna isaatiin guutantuu ti.","poem":2},{"lineBreak":true},{"text":"Ameen! Ameen!","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Daadimati Daawitii ilma Iseyii","poem":1},{"text":"as irratti muummowe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}