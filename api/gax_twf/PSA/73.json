{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":73,"content":[{"type":"heading","content":["Haqa Waaqaa"]},{"type":"heading","content":["Faaruu Asaafii."]},{"type":"verse","number":1,"content":[{"text":"Worra Israa'elootaa ka gadhaa qulqullu'uutiif,","poem":1},{"text":"Waaqi dhugumaan dansa'a.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ani akka kiyyatti ammoo, miilli kiyya fallaadee,","poem":1},{"text":"mucucaadhee jigiisaaf diqqoo hafe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ani worri hamaan qananoomuun dhaggee,","poem":1},{"text":"worra ifi jaju hinaafe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isaan dhiboo waan hin qanneef,","poem":1},{"text":"nafi isaanii fayya'a; gabbaalle'e.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isaan akka worra dhibi'ii rakkinna hin qabanu;","poem":1},{"text":"akka kolbaa dhibi'ii balaan isaan hin dhaqqabu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tanaaf, isaan koora akka seesa mormaa","poem":1},{"text":"mormatti naqataneeran;","poem":2},{"lineBreak":true},{"text":"hunnaan nama irratti ka'iisa","poem":2},{"lineBreak":true},{"text":"akka woya'aa uffataneeran.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ila isaanii coomatti iitessee gad baase;","poem":1},{"text":"gadhaa isaanii hammeennatti guutee irraa dhangala'e.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Isaan namatti murgaa waan hantuu dubbatan;","poem":1},{"text":"kooraan nama cunqursan.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Afaaniin Waaqa ol-gubba'aa arrassan;","poem":1},{"text":"arrabaan lafa duudii dhaqqaban.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tanaaf, kolbaan Waaqaa gara isaanii deebitee,","poem":1},{"text":"waan isaan jedhanu mara fudhatti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isaan, «Waaqi attam beekuu dande'a?","poem":1},{"text":"Waaqi Ol-Aanaan beekkumsa qabaa?» jedhan.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Worri hamaan akkas jiran;","poem":1},{"text":"yennaa mara qanannumma'aan le'aa,","poem":2},{"lineBreak":true},{"text":"durummaa ede'atan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Gadhaa kiyya qulqulleeffachuun,","poem":1},{"text":"yakkaa hujiisa irraa","poem":2},{"lineBreak":true},{"text":"ifi eeggachuun kiyya tolumaa ree?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Guyyaa guutuu balaan na dhaqqabe;","poem":1},{"text":"ganama mara adabame.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ani adoo, «Akkuma isaanii hin dubbadha» jedhee jiraadhee,","poem":1},{"text":"kolbaa teeti dabarsee kenneeraayyu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ani yennaa waan kana hubatiisaaf itti yaade ammoo,","poem":1},{"text":"akka malee rakkisaa natti teete.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ani haga Dunkaanii Woyyittii seenee,","poem":1},{"text":"waan worri hamaan te'u hubadhutti,","poem":2},{"lineBreak":true},{"text":"akka malee na rakkitte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ati dhugumaan lafa mucucaattu irra","poem":1},{"text":"isaan dhaabbachiitta;","poem":2},{"lineBreak":true},{"text":"jiganee akka badanu isaan goota.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Isaan attam attam dedhuma badane!","poem":1},{"text":"Isaan attam attam bararaqiisaan muxuqi jedhane!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Akkuma wonni oojju'uun dhaggane,","poem":1},{"text":"yennaa dammaqane dhabantu,","poem":2},{"lineBreak":true},{"text":"Ee Gootta'a, yennaa ati kaatu,","poem":2},{"lineBreak":true},{"text":"isaan ila teeti duraa hin dhabaman.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Yennaa lubbuun natti hadhootte,","poem":1},{"text":"yennaa gadhaan na cite,","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ani nama gowwaa,","poem":2},{"lineBreak":true},{"text":"woy hubatuu hin dandeenne te'ee,","poem":2},{"lineBreak":true},{"text":"si duratti akka hori'ii te'e.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Te'uu malee,","poem":1},{"text":"ani yennaa mara si'uma woliin jira;","poem":2},{"lineBreak":true},{"text":"atille harka kiyya middicha na qadda.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ati gorsa keetiin na sooressita;","poem":1},{"text":"muummee irratti gara ulfinnaa na hin fudhatta.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ol-gubba'atti si malee eennu qaba ree?","poem":1},{"text":"Lafa irralle'etti si malee ka ani barbaadu,","poem":2},{"lineBreak":true},{"text":"ka dhibiin hin jiru.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Foon kiyyaa fi keessi kiyya dadhabuu dande'an;","poem":1},{"text":"Waaqi ammoo jabeenna kiyyaa fi","poem":2},{"lineBreak":true},{"text":"qooda kiyya ka bara baraa ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Kunoo, worri si irraa fagaatu hin bada;","poem":1},{"text":"worra si'iif hin addatanne ati hin balleessita.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Anaaf ammoo gara Waaqa dhikaatiisi dansa'a;","poem":1},{"text":"hujii teeti mara odeessiisaaf,","poem":2},{"lineBreak":true},{"text":"ani si Goottaa Mootii Waan Maraa","poem":2},{"lineBreak":true},{"text":"addee itti baqadhu godhadheera.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}