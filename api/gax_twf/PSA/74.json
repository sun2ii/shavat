{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":74,"content":[{"type":"heading","content":["Kolbaan Akka Baatuuf Daadimata Dhikaate"]},{"type":"heading","content":["Wolaloo Asaafii."]},{"type":"verse","number":1,"content":[{"text":"Ee Waaqa, ati maaf ijjumaa nu lakkitte?","poem":1},{"text":"Hoolota tika keeti jala jiranu irratti,","poem":2},{"lineBreak":true},{"text":"aariin teeti maaf bobeette?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kolbaa teeti ta durii jalqaddee ifiif filatte,","poem":1},{"text":"ta gosa teeti akka te'anuuf","poem":2},{"lineBreak":true},{"text":"garbummaa keessaa wodatte,","poem":2},{"lineBreak":true},{"text":"gaara Xiyoonii,","poem":2},{"lineBreak":true},{"text":"ka dhuttee irra qubatte qaabadhu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Diinoti waan mana keeti keessaa","poem":1},{"text":"mara balleessaneeran;","poem":2},{"lineBreak":true},{"text":"koyiitii waan diigamee hafe kana ilaali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Diinoti keeti mana keeti keessaa bookkisane;","poem":1},{"text":"beessisa ifii ittiin beekkamanulle","poem":2},{"lineBreak":true},{"text":"achi dhaabbataneeran.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isaan namoota gongomaa keessaa muka muriisaaf,","poem":1},{"text":"agaraa fudhatanu fakkaatan.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Seesa muka irraa qiriixamee hujame mara,","poem":1},{"text":"agara'aa fi burrisaan butuchane.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Isaan mana keeti ibiddaan gubane;","poem":1},{"text":"addee maqaan keeti itti waamamu batteessane.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Isaan gadhaa ifii keessatti,","poem":1},{"text":"«Ijjumaa isaan hin balleessina» jedhane;","poem":2},{"lineBreak":true},{"text":"isaan lafa san keessatti","poem":2},{"lineBreak":true},{"text":"addee Waaqi itti waaqonfamu mara gubane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Haganaa achi beessisi hin jiraatu;","poem":1},{"text":"raagille hin jiraatu;","poem":2},{"text":"Kun haga yoomii akka te'u,","poem":1},{"text":"nu keessaa nami beeku hin jiru.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ee Waaqa haga yoomii diinoti sitti murgan?","poem":1},{"text":"Haga yoomii nyaaphoti maqaa keeti tuffatan ree?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ati maaf isaan hin adabin?","poem":1},{"text":"Maaf isaan hin balleessin?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ee Waaqa, durii duriitii jalqaddee,","poem":1},{"text":"ati mootii kiyya;","poem":2},{"lineBreak":true},{"text":"ati fayyisiisa keeti","poem":2},{"lineBreak":true},{"text":"lafa irratti fidde.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ati hunna teetiin abbaayaa gargar kutte;","poem":1},{"text":"mataa bineensota jawwee fakkaatuu","poem":2},{"lineBreak":true},{"text":"ka abbaayaa keessaa butuchite.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ati mataa hedduu bineensa naacha fakkaatu","poem":1},{"text":"ka abbaayaa keessaa","poem":2},{"lineBreak":true},{"text":"ka, «Lewaataan» jedhamu butuchite;","poem":2},{"lineBreak":true},{"text":"foon isaa bineensota goomole'eetiif,","poem":2},{"lineBreak":true},{"text":"sagalee gootee kennite.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ati maddaa fi caancoo akka maddu goote;","poem":1},{"text":"laga yennaa mara yaa'u gossite.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Guyyaan keeti; halkanille keeti;","poem":1},{"text":"adu'uu fi ji'alle addee isaaniititti sittuu keye.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ka meessaa lafaa tolche si'i;","poem":1},{"text":"bonaa fi gannalle sittuu dade.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"diinoti keeti attam akka si irratti murgane,","poem":2},{"lineBreak":true},{"text":"kolbaan gowwaan","poem":2},{"lineBreak":true},{"text":"maqaa keeti attam akka tuffatte qaabadhu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Lubbuu kolbaa teetii worra akka saphaliisaa,","poem":1},{"text":"bineensatti dabarsitee hin kennin.","poem":2},{"lineBreak":true},{"text":"Jiruu kolbaa rakkattuu teetii","poem":2},{"lineBreak":true},{"text":"haga bara baraa hin dedhin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Lafa addee dukkanaa keessatti,","poem":1},{"text":"hunnaan nama irratti ka'iis waan guuteeruuf,","poem":2},{"lineBreak":true},{"text":"ati gondooroo teeti qaabadhu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Worri cunqurfame fokkifatee","poem":1},{"text":"akka deebi'u hin godhin;","poem":2},{"lineBreak":true},{"text":"worri hiyyeeyyi'ii fi deegi","poem":2},{"lineBreak":true},{"text":"maqaa keeti leellisanuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ee Waaqa ka'i! Waan keeti falmadhu;","poem":1},{"text":"worri gowwaan","poem":2},{"lineBreak":true},{"text":"guyyaa guutuu akka sitti murgu qaabadhu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hogaa nyaapha keetiitii fi","poem":1},{"text":"harqiisa diina keetii hin dedhin.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":23}