{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":75,"content":[{"type":"heading","content":["Waaqi Abbaa Mura'aa Ti"]},{"type":"heading","content":["Sooressa faarfattootaatiif, faaruu Asaafii ta akka yoyyoma faaruu, «Hin balleessin» jedhantee beekkantutti faarfatante."]},{"type":"verse","number":1,"content":[{"text":"Ee Waaqa, nuuti si galateeffanna;","poem":1},{"text":"maqaan keeti dhikoo waan jiruuf,","poem":2},{"lineBreak":true},{"text":"nuuti si galateeffanna;","poem":2},{"lineBreak":true},{"text":"kolbaan hujii teeti ta maade'ee hin odeessiti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Waaqa ati, «Ani yennaa muraa kennu murteesseera;","poem":1},{"text":"ani yennaa sanitti muraa sirri'ii hin kenna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yennaa lafaa fi wonni isii irraa marti tachootu,","poem":1},{"text":"utubaa isi'ii ka jabeessu ana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ani worra kooruun, ‹Haganaa achi hin koorina'a!›","poem":1},{"text":"Worra hamoole'een, ‹Gaafa hin baasina'a!","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gaafa keessan gara ol-gubba'aa","poem":2},{"lineBreak":true},{"text":"ol hin togina'a!","poem":2},{"lineBreak":true},{"text":"Morma yaafattanee","poem":2},{"lineBreak":true},{"text":"hin dubbatina'a!› jedhaan» jetta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ulfinni baya adu'uu irraa,","poem":1},{"text":"yookiin seensa adu'uu irraa,","poem":2},{"lineBreak":true},{"text":"yookiin goomolee keessaa hin dhufu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Muraa ka kennu ammoo Waaqa;","poem":1},{"text":"inni tokko gadi qabee,","poem":2},{"lineBreak":true},{"text":"kaan ol hin qaba.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"muduunuu daadhii woyni'ii ta mufi'ii","poem":2},{"lineBreak":true},{"text":"hoomachoottuu harkaa qaba;","poem":2},{"lineBreak":true},{"text":"inni gad isii cossa;","poem":2},{"lineBreak":true},{"text":"worri hamaaleyyiin lafaa marti,","poem":2},{"lineBreak":true},{"text":"cingifatanee unan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ani ammoo haga bara baraa tana hin lallaba;","poem":1},{"text":"Waaqa Yaaqoobii faaru'uun hin leellisa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Inni hunna worra hamoole'ee hin cassa;","poem":1},{"text":"hunni worra balchoole'ee ammoo hin ede'anti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}