{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":76,"content":[{"type":"heading","content":["Injifatiisa Waaqaa"]},{"type":"heading","content":["Sooressa faarfattootaatiif, faaruu Asaafii ta meya ribu'uutiin faarfatante."]},{"type":"verse","number":1,"content":[{"text":"Waaqi biyya Yihuda'aatitti beekkama'a;","poem":1},{"text":"Israa'el keessatti maqaan isaa gudda'a.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dunkaaniin isaa Yerusaalem keessa;","poem":1},{"text":"addeen woyyittiin isaa gaara Xiyoonii irra.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inni achitti daaya balaqqisaa deentu,","poem":1},{"text":"wontee, shallaaga'aa fi","poem":2},{"lineBreak":true},{"text":"meya woraanaa mara caccasse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ee Waaqa ati attam attam ulfaata'a!","poem":1},{"text":"Arnyi keeti gaarota gugurdaa caala.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Worri jannooti saamamanee,","poem":1},{"text":"akka malee rafaneeran;","poem":2},{"lineBreak":true},{"text":"isaan keessaa tokkolle,","poem":2},{"lineBreak":true},{"text":"harka ifiitiin womaa hujuu hin dandeenne.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ee Waaqa Yaaqoobii,","poem":1},{"text":"xixicha keetiin","poem":2},{"lineBreak":true},{"text":"abbaan fardaatii fi fardi isaalle jigane.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ati ammoo sodaatama'a;","poem":1},{"text":"yennaa aariin teeti kaate,","poem":2},{"lineBreak":true},{"text":"eentu si dura dhaabbatuu dande'a?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ati ol-gubbaa irraa muraa teeti lassite;","poem":1},{"text":"biyyi lafaalle sodaattee cadhitte.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ee Waaqa,","poem":1},{"text":"worra biyya lafaa irratti cunqurfame wodiisaaf,","poem":2},{"lineBreak":true},{"text":"yennaa ati muraa kenniisaaf kaate,","poem":2},{"lineBreak":true},{"text":"biyyi lafaa cadhitte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mufiin teeti waan hantuu waan mormituuf,","poem":1},{"text":"kolbaan si leellifatti;","poem":2},{"lineBreak":true},{"text":"worri mufii teeti irraa hafe","poem":2},{"lineBreak":true},{"text":"waan hantuu hujiisa hin lakkisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Waaqa Mootii Waan Maraa keessaniif","poem":1},{"text":"waadaa gala'a;","poem":2},{"lineBreak":true},{"text":"waan waadaa galtane san muummessa'a.","poem":2},{"text":"Worri lafa adaala isaa jiru marti","poem":1},{"text":"ka sodaatamu'uu maleef kennansa fidanuu ti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Inni qondaaltota kooranu gad qaba;","poem":1},{"text":"mootota lafa irraalle akka malee sodaachisa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}