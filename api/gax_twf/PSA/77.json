{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":77,"content":[{"type":"heading","content":["Daadimata Jajjabeessiisaa"]},{"type":"heading","content":["Faaruu Asaafii sooressa faarfattootaa Yedutu'uuf."]},{"type":"verse","number":1,"content":[{"text":"Ani qoonqoo ol qabadhee gara Waaqaa iyya;","poem":1},{"text":"akka inni naaf dhage'u,","poem":2},{"lineBreak":true},{"text":"qoonqoo ol qabadhee gara Waaqaa iyya.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yennaa rakkinnaa keessa Goottaa barbaadadhe;","poem":1},{"text":"halkan guutuu harka kiyya diriirse;","poem":2},{"lineBreak":true},{"text":"te'uu malee ani hin jajjabaanne.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ee Waaqa, ani yennaa si qaabadhu hin aada;","poem":1},{"text":"yennaa guddisee itti yaadu hin gaggaba.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ati ila wolitti qabatiisa na dhooggite;","poem":1},{"text":"haga dubbatiisa dadhabutti rakkadhe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ani marroo bara durii yaade;","poem":1},{"text":"woggoota durii durii qaabadhe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Halkan keessa faaruu tiyya ta durii qaabadhe;","poem":1},{"text":"ani guddisee itti yaadee, yaada kiyya qorqoree,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"«Goottaan haga bara baraa nu hin gataa?","poem":1},{"text":"Inni ijjumaa deebi'ee nu'uuf hin nayuu?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Jaalalli isaa ka bara baraa,","poem":1},{"text":"haga bara baraa dhumatee?","poem":2},{"lineBreak":true},{"text":"Waadaan inni gale yoona hin muummowuu ree?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Waaqi marartii dedhee?","poem":1},{"text":"Aariin gadhi-laafummaa isaa dhooggitee ree?» jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Achiin duuba ani, «Hunni Waaqa Ol Aana'aa","poem":1},{"text":"waan jijjiiranteef, gaddee laaleffadhe» jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ani hujii teeti gugurdoo hin yaadadha;","poem":2},{"lineBreak":true},{"text":"bilbaasota ati dur goote hin qaabadha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ani marroo hujii teetii mara hin heda;","poem":1},{"text":"hujii teeti gugurdoo mara itti hin yaadadha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ee Waaqa, karaan keeti woyyicha;","poem":1},{"text":"waaqota keessaa","poem":2},{"lineBreak":true},{"text":"guddaan akka Waaqa keennaa eennu?","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ati Waaqa bilbaasa huju;","poem":2},{"lineBreak":true},{"text":"ati gosa biyya adda addaa oddu'utti","poem":2},{"lineBreak":true},{"text":"hunna teeti mudhitteerta.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ati kolbaa teeti sanyii Yaaqoobiitii fi Yoseefii,","poem":1},{"text":"hunna teeti jaddu'uun wodatteerta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ee Waaqa bisaan hedduun","poem":1},{"text":"si dhagganee sodaatane;","poem":2},{"lineBreak":true},{"text":"qileen abbaaya'aalle raafante.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Duumensi bisaan gad coccosse;","poem":1},{"text":"gubbaa irraa mandiisuun mandiite.","poem":2},{"lineBreak":true},{"text":"Balaqqeettiin akka daayaa gara mara balaqqitte.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hobonbolattii keessa mandiisuun dhage'ante;","poem":1},{"text":"balaqqeettiin biyya lafaa issite;","poem":2},{"lineBreak":true},{"text":"latti rommitee tachoote.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Abbaayaa keessa karaa,","poem":1},{"text":"bisaan gugurdaa keessa daandii godhatte;","poem":2},{"lineBreak":true},{"text":"faanti miila keetii ammoo hin mudhanne.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Harka Muuse'eetii fi Aaroniitiin","poem":1},{"text":"akka nama hoolee tissuu","poem":2},{"lineBreak":true},{"text":"ati kolbaa teeti sooressite.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}