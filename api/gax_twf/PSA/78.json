{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":78,"content":[{"type":"heading","content":["Waaqaa Fi Kolbaa Waaqaa"]},{"type":"heading","content":["Wolaloo Asaafii."]},{"type":"verse","number":1,"content":[{"text":"Ee kolbaa tiyya, barsiisa kiyya caqasa'a;","poem":1},{"text":"gurra keessan","poem":2},{"lineBreak":true},{"text":"gara dubbii afaan kiyyaa deebifadha'a.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ani fakkeennaan afaan kiyya hin saaqadha;","poem":1},{"text":"dubbii dhossa'aa","poem":2},{"lineBreak":true},{"text":"ta durii jalqaddee dhoffante hin mudhisa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dubbiin tun ta dhageennee hin beenne,","poem":1},{"text":"ta abbootiin teenna ta durii nutti hinte,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"nuuti ijoollee isaanii hin dhossinu;","poem":2},{"lineBreak":true},{"text":"marroo leellisa Mootii Waan Maraatii fi hunna isaa,","poem":2},{"lineBreak":true},{"text":"marroo bilbaasa inni hujee,","poem":2},{"lineBreak":true},{"text":"dhaloota dhufutti hin hinna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Inni ajaja sanyii Yaaqoobiitiif kennee,","poem":1},{"text":"seera Israa'el keessatti baasee,","poem":2},{"lineBreak":true},{"text":"ijoollee ifiille akka barsiisanu","poem":2},{"lineBreak":true},{"text":"abbootii teenna ta durii ajaje.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wonni inni tana godheef,","poem":1},{"text":"dhalooti itti aanu tana akka beeku,","poem":2},{"lineBreak":true},{"text":"worri amma hin dhalatinille","poem":2},{"lineBreak":true},{"text":"ijoollee ifii akka barsiisu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Achiin duuba ijoolleen sun Waaqatti addatti;","poem":1},{"text":"hujii Waaqaalle hin deetu;","poem":2},{"lineBreak":true},{"text":"ajaja isaalle yennaa mara eeggatti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Isaan akka abbootii ifii ta durii,","poem":1},{"text":"mati-jabeeyyi'ii fi worra Waaqa irratti ka'u,","poem":2},{"lineBreak":true},{"text":"worra gadhaan isaanii","poem":2},{"lineBreak":true},{"text":"Waaqaaf addatamumma'aan hin jabaanne,","poem":2},{"lineBreak":true},{"text":"worra qalbiin isaanii","poem":2},{"lineBreak":true},{"text":"Waaqaaf hin addatanne hin te'anu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Loltooti worri Efreemii","poem":1},{"text":"worri guube'ee fi daaya qabataneeranu,","poem":2},{"lineBreak":true},{"text":"guyyaa lolaa baqatane.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Isaan gondooroo Waaqaa hin eeganne;","poem":1},{"text":"akka seera isaatitti deemuu didane.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isaan waan inni hujee fi","poem":1},{"text":"bilbaasota inni itti mudhise dedhane.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Biyya Gibxi'iititti, diida Zo'aaniititti,","poem":1},{"text":"fuula abbootii isaanii duratti","poem":2},{"lineBreak":true},{"text":"Waaqi bilbaasota huje.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Inni abbaayaa gargar kutee,","poem":1},{"text":"keessa isaan dabarse;","poem":2},{"lineBreak":true},{"text":"bisaanille akka tuula'aa dhaabbachiise.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Guyyaa duumensaan,","poem":1},{"text":"halkan guutuu ifa ibiddaatiin isaan sooresse.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Inni lafa goomole'ee keessatti rassaa dhoosee,","poem":1},{"text":"bisaan akka bisaan abbaaya'aa,","poem":2},{"lineBreak":true},{"text":"kenneefii isaan obaase.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Inni rassaa keessaa bisaan baasee,","poem":1},{"text":"akka lagaa lolaase.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Isaan ammoo ittuma ede'anee","poem":1},{"text":"isa irratti cubbuu hujanee,","poem":2},{"lineBreak":true},{"text":"goomolee keessatti","poem":2},{"lineBreak":true},{"text":"Waaqa Ol Aanaa irratti ka'ane.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Isaan sagalee halchane gaafatiisaan,","poem":1},{"text":"Waaqa haga ilaalane.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Isaan Waaqa irratti ka'anee,","poem":1},{"text":"«Waaqi goomolee keessatti","poem":2},{"lineBreak":true},{"text":"sagalee qopheessee hin dande'aa?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yennaa inni rassaa dhowe,","poem":1},{"text":"bisaan akka lagaa keessaa lola'e.","poem":2},{"text":"Inni ammoo sagaleelle nuu kennuu hin dande'aa ree?","poem":1},{"text":"Yookiin kolbaa ifiitiif","poem":2},{"lineBreak":true},{"text":"foon kennuu hin dande'aa ree?» jedhane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Mootiin Waan Maraa yennaa tana dhage'e,","poem":1},{"text":"aaree bobe'e;","poem":2},{"lineBreak":true},{"text":"sanyii Yaaqoobii irratti ibiddi gabbate;","poem":2},{"lineBreak":true},{"text":"aariin isaa Israa'el irratti bobeette.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Wonni tun teeteef,","poem":1},{"text":"isaan Waaqatti hin dhugeeffanne;","poem":2},{"lineBreak":true},{"text":"akka inni isaan fayyisulle isatti hin addanne.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Te'uu malee, inni duumensa gubba'aa ajajee,","poem":1},{"text":"balbala ol-gubba'aa bane;","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"akka isaan nyaatanuuf","poem":2},{"lineBreak":true},{"text":"mannaa gad isaaniif roobisiisee,","poem":2},{"lineBreak":true},{"text":"midhaan ol-gubba'aa isaaniif kenne.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Maarre isaan","poem":1},{"text":"sagalee ergantoota Waaqaa nyaatane;","poem":2},{"lineBreak":true},{"text":"Waaqi sagalee isaan quussitu isaaniif erge.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Inni qilleensi baya adu'uu akka ka'u godhe;","poem":1},{"text":"hunna ifiitiin qilleensa kibbaalle kaase.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Inni foon akka biyye'ee bacatu,","poem":1},{"text":"barbadi-kille akka maansa abbaaya'aa","poem":2},{"lineBreak":true},{"text":"isaaniif roobisiise.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Gororrii san quttuma isaanii keessa,","poem":1},{"text":"adaala dunkaanii isaanii maratti gad harcaase.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Inni waan isaan dharra'ane waan isaanii kenneef,","poem":1},{"text":"isaan nyaatanee akka malee quufane.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ammoo adoo isaan dharraa hin bayinuu,","poem":1},{"text":"adoo nyaatiisatti jiranuu,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Waaqi isaanitti aaree,","poem":1},{"text":"isaan keessaa worra jajjabaa ijjeese;","poem":2},{"lineBreak":true},{"text":"dargaggeeyyii Israa'eliille qoome.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Tana mara keessatti","poem":1},{"text":"isaan cubbuu hujiisa hin lakkinne;","poem":2},{"lineBreak":true},{"text":"bilbaasa inni godhelle hin dhugeeffanne.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Tanaaf, inni ganna isaanii","poem":1},{"text":"akka hafuura baafata tokkochaa godhee,","poem":2},{"lineBreak":true},{"text":"jiruu isaanii bararaqaan fixachiise.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Yennaa inni isaan keessaa ijjeese,","poem":1},{"text":"isaan isa barbaadane;","poem":2},{"lineBreak":true},{"text":"cubbuu irraa deebi'anee,","poem":2},{"lineBreak":true},{"text":"gadhaa tokkochaan gara isaa deebi'ane.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Isaan Waaqi rassaa isaanii,","poem":1},{"text":"Waaqi Ol Aanaan","poem":2},{"lineBreak":true},{"text":"wodoo isaanii akka te'e qaabatane.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Isaan ammoo afaaniin isa kookkisane;","poem":1},{"text":"arraba ifiitiin soba isatti dubbatane.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Gadhaan isaanii isaaf hin addatanne;","poem":1},{"text":"gondooroo isaalle hin eeganne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"Waaqi ammoo kolbaa ifiitiif mararee,","poem":1},{"text":"yakkaa isaaniif araarame malee,","poem":2},{"lineBreak":true},{"text":"isaan hin balleessine;","poem":2},{"lineBreak":true},{"text":"inni yennaa hedduu aarii ifii caffate;","poem":2},{"lineBreak":true},{"text":"mufii ifii mara ol hin kaanne.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Inni nama foonii qofa te'iisa isaanii,","poem":1},{"text":"qilleensa dabaru,","poem":2},{"lineBreak":true},{"text":"ka deebi'ee hin dhunne akka te'ane qaabate.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Isaan goomolee keessatti","poem":1},{"text":"yennaa hedduu isa irratti ka'anee,","poem":2},{"lineBreak":true},{"text":"gammoojjii keessatti","poem":2},{"lineBreak":true},{"text":"yennaa hedduu isa gaddisiisane.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Isaan itti deddeebi'anee","poem":1},{"text":"Waaqa haga ilaalane;","poem":2},{"lineBreak":true},{"text":"Woyyicha Israa'elii gaddisiisane.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Isaan hunna isaa,","poem":1},{"text":"ta guyyaa inni diinota jalaa isaan wodee,","poem":2}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"biyya Gibxi'ii keessatti hujii baasaatii fi","poem":2},{"lineBreak":true},{"text":"bilbaasota inni diida Zo'aaniititti huje hin qaabanne.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Inni bisaan laga isaanii mara","poem":1},{"text":"gara dhiigaa jijjiire;","poem":2},{"lineBreak":true},{"text":"tanaaf worri Gibxi'ii bisaan yaa'u keessaa","poem":2},{"lineBreak":true},{"text":"unuu hin dandeenne.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Inni tiiticha isaan iddu,","poem":1},{"text":"raacha isaan balleessu itti erge.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Midhaan isaanii korophiisaaf,","poem":1},{"text":"eloo isaanii awwaannisaaf kenne.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Muka woynii isaanii dhakaa roobaatiin,","poem":1},{"text":"muka harru'uu ka isaanii qorraan balleesse.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Loon isaanii dhakaa roobaatiin,","poem":1},{"text":"karra horii isaanii banqo'oon fixe.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Inni aarii ifii ta bobeettu,","poem":1},{"text":"mufii ifii, aarii jaddu'uu fi","poem":2},{"lineBreak":true},{"text":"golii ergantoota Waaqaa","poem":2},{"lineBreak":true},{"text":"ta balaa badi'ii hiikee isaanitti gad lakkise.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Inni aarii ifiitiif daandii qopheesse;","poem":1},{"text":"lubbuu isaanii bala'aaf dabarsee kenne malee,","poem":2},{"lineBreak":true},{"text":"du'a irraa isaan hin hamburre.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Inni biyya Gibxi'ii keessatti,","poem":1},{"text":"angafa te'ee ka dhalate,","poem":2},{"lineBreak":true},{"text":"ilma angaficha mara","poem":2},{"lineBreak":true},{"text":"dunkaanii sanyii Kaamii keessatti ijjeese.","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Achiin duuba inni kolbaa ifii","poem":1},{"text":"akka hoole'ee achii baasee,","poem":2},{"lineBreak":true},{"text":"akka tika hoole'eelle","poem":2},{"lineBreak":true},{"text":"goomolee keessa isaan sooresse.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Inni nageyaan waan isaan sooresseef,","poem":1},{"text":"isaan hin sodaanne;","poem":2},{"lineBreak":true},{"text":"diinota isaanii ammoo abbaayaan liqinsite.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Inni gara lafa woyyittii ifii,","poem":1},{"text":"gara gaara harka ifii middichaan injifatee qabateeruu isaan fide.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Inni gosa biyya adda addaa isaan duraa ari'ee baase;","poem":1},{"text":"lafa isaanii isaan dhaalchisee,","poem":2},{"lineBreak":true},{"text":"mana isaaniille gosa Israa'eliitiif qoode.","poem":2}]},{"type":"line_break"},{"type":"verse","number":56,"content":[{"text":"Isaan ammoo Waaqa Ol Aanaa haga ilaalanee,","poem":1},{"text":"isa irratti ka'ane;","poem":2},{"lineBreak":true},{"text":"seerata isaalle hin eeganne.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Isaan akkuma abbootii ifii ta durii irraa garagalanee,","poem":1},{"text":"addatamuu dhabanee","poem":2},{"lineBreak":true},{"text":"akka guubee qajeelatti daaya hin darbannee micciiramane.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Addee waaqonfannaa ifiitiin isa aarsane;","poem":1},{"text":"waaqota dharaa ifiitiin hinaaffa'atti isa kaasane.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Waaqi tana yennaa dhage'e, aaree bobe'e;","poem":1},{"text":"inni ijjumaa Israa'el gate.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Inni addee bultoo ifii, ka Shiilo'oo,","poem":1},{"text":"dunkaanii odduu namaatitti keessa bulu lakkise.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"Inni Saanduqa Gondooro'oo,","poem":1},{"text":"ka beessisa hunnaa isaatii fi ulfinna isaa te'e,","poem":2},{"lineBreak":true},{"text":"harka diinaatitti booju'uuf","poem":2},{"lineBreak":true},{"text":"dabarsee kenne.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"Inni kolbaa ifiititti guddoo aaree,","poem":1},{"text":"shallaaga'aaf dabarsee kenne.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Dargaggeeyyii isaanii ibiddi fixe;","poem":1},{"text":"durri isaanii nama heerumtu dhadde.","poem":2}]},{"type":"verse","number":64,"content":[{"text":"Hayyooti isaanii shallaaga'aan dhumatane;","poem":1},{"text":"niitoti isaanii","poem":2},{"lineBreak":true},{"text":"isaaniif bowiisa hin dandeenne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":65,"content":[{"text":"Achiin duuba Goottaan","poem":1},{"text":"akka waan hirriibaa dammaqee,","poem":2},{"lineBreak":true},{"text":"akka nama janna","poem":2},{"lineBreak":true},{"text":"daadhii woyni'ii quufee dhaadatuu ka'e.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Inni diinota ifii dhowee","poem":1},{"text":"gara duubaa deebisee,","poem":2},{"lineBreak":true},{"text":"haga bara baraa isaan fokkisiise.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"Inni dunkaanii Yoseefii tuffatte;","poem":1},{"text":"sanyii Efreemiille hin filanne;","poem":2}]},{"type":"verse","number":68,"content":[{"lineBreak":true},{"text":"ammoo gosa Yihuda'aatii fi","poem":2},{"lineBreak":true},{"text":"gaara Xiyoonii ka jaalatu filate.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"Inni mana Woyyicha ifii","poem":1},{"text":"akka kooba dheera'aa ijaaree,","poem":2},{"lineBreak":true},{"text":"akka lafaa haga bara baraa jabeessee dhaabe.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"Inni tajaajilaa ifii Daawiti filate;","poem":1},{"text":"tika hoole'ee keessaa isa fudhate.","poem":2}]},{"type":"verse","number":71,"content":[{"text":"Hoolee haadhotii ilmoole'ee tissiisa lakkisee,","poem":1},{"text":"kolbaa ifii Yaaqoob,","poem":2},{"lineBreak":true},{"text":"Israa'elii ifiitiif tissee akka te'u isa fide.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"Inni gadhaa qajeela'aan isaan tisse;","poem":1},{"text":"qarumma'aan guutamee isaan sooresse.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/78.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/79.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/77.json","previousChapterAudioLinks":{},"numberOfVerses":72}