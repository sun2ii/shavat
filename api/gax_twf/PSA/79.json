{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":79,"content":[{"type":"heading","content":["Daadimata Nageya Biyyaatiif Dhikaate"]},{"type":"heading","content":["Faaruu Asaafii."]},{"type":"verse","number":1,"content":[{"text":"Ee Waaqa, gosi biyya adda addaa","poem":1},{"text":"lafa teeti fudhatiisaaf nu lolaneeran;","poem":2},{"lineBreak":true},{"text":"Galma Woyyicha keeti batteessaneeran;","poem":2},{"lineBreak":true},{"text":"Yerusaalemille diiganeeran.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Reeffa tajaajiltoota teetii allaatti'iif,","poem":1},{"text":"foon addatantoota teetii bineensaaf","poem":2},{"lineBreak":true},{"text":"sagalee godhaneeran.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isaan adaala Yerusaalemiititti,","poem":1},{"text":"dhiiga isaanii akka bisaanii dhangalaasaneeran;","poem":2},{"lineBreak":true},{"text":"nami isaan awwaalulle hin jiru.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nuuti gosa biyya addaa","poem":1},{"text":"ta ollaa keennaatiif shasha,","poem":2},{"lineBreak":true},{"text":"gosa biyya adda addaa ta adaala keennaatiif,","poem":2},{"lineBreak":true},{"text":"waan murgo'ootii fi waan coora'aa teeneerra.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"kun haga yoomii akkas te'a?","poem":2},{"lineBreak":true},{"text":"Ati haga bara baraa aartaa?","poem":2},{"lineBreak":true},{"text":"Hinaaffaan teeti","poem":2},{"lineBreak":true},{"text":"haga yoomii akka ibiddaa bobeetti ree?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mufii teeti gosa biyya adda addaa","poem":1},{"text":"ta si hin beenne irratti,","poem":2},{"lineBreak":true},{"text":"mootummoota maqaa keeti hin waammanne","poem":2},{"lineBreak":true},{"text":"irralle'etti dhangalaasi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wonni tana gootuuf,","poem":1},{"text":"isaan kolbaa Yaaqoobii fixaneeran;","poem":2},{"lineBreak":true},{"text":"qe'ee isaanii onsaneeran.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yakkaa abbootii teenna ta durii,","poem":1},{"text":"nutti hin laakkowin;","poem":2},{"lineBreak":true},{"text":"mataa keenna guddoo waan gad qabanneef,","poem":2},{"lineBreak":true},{"text":"marartiin teeti ariiti'iin gara keenna dhuttuu ti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ee Waaqa fayyisaa keenna,","poem":1},{"text":"ulfinna maqaa keetiitiif jedhii nu qarqaar;","poem":2},{"lineBreak":true},{"text":"maqaa keetiif jedhii nu baasi;","poem":2},{"lineBreak":true},{"text":"cubbuu teennalle nuu araarami.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gosi biyya adda addaa maaf,","poem":1},{"text":"«Waaqi isaanii meet?» jedhanee gaafatan ree?","poem":2},{"text":"Dhiiga tajaajiltoota teetii ka dhangalaafameef,","poem":1},{"text":"ila teenna duratti haluu bayiisi keeti,","poem":2},{"lineBreak":true},{"text":"gosa biyya adda addaa oddu'utti beekkamuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Aadiis worra hidhamee si bira gewuu ti;","poem":1},{"text":"hunna teeti guddo'oon","poem":2},{"lineBreak":true},{"text":"worra duuti itti murante hamburi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ee Gootta'a,","poem":1},{"text":"arraba worri ollaa keennaa si arrassane,","poem":2},{"lineBreak":true},{"text":"dachaa torba godhiitii itti deebisi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Achii duuba nuuti kolbaan teeti,","poem":1},{"text":"worri tika keeti jala jirru,","poem":2},{"lineBreak":true},{"text":"haga bara baraa si galateeffanna;","poem":2},{"lineBreak":true},{"text":"dhalootaa haga dhalootaatitti si leellifanna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}