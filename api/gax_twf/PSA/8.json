naa ilaalu,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"akka ati isaaf yaadattuuf,","poem":2},{"lineBreak":true},{"text":"nami maan inni?","poem":2},{"lineBreak":true},{"text":"Akka ati isa kunuunsituuf,","poem":2},{"lineBreak":true},{"text":"ilmi namaa maan inni?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ati diqquma Waaqa","poem":1},{"noteId":0},{"text":"isa hanqittee,","poem":1},{"text":"kallacha guddinnaa fi ulfinnaa itti keette.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hujii harka keetii mara irratti bulchaa isa gootee,","poem":1},{"text":"waan mara baallii ilma namaatiin jala goote.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hoole'ee fi loon mara,","poem":1},{"text":"bineensota,","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"sinbirrootaa fi qurxummii mara,","poem":2},{"lineBreak":true},{"text":"dada abbaayaa keessaa mara","poem":2},{"lineBreak":true},{"text":"baallii ilma namaatiin jala goote.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ee Mootii Waan Maraa, Goottaa keenna!","poem":1},{"text":"Maqaan keeti lafa maratti attam attam gudda'a!","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Diqquma Waaqa isa hanqitte: Hiikkaan afaan Giriikii Ergantoota Waaqaa isa hanqitte jedha.","reference":{"chapter":8,"verse":5}}]},"thisChapterLink":"/api/gax_twf/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}