{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":80,"content":[{"type":"heading","content":["Adde'etti Deebi'iisa Israa'eliitiif Daadimata Dhikaate"]},{"type":"heading","content":["Sooressa faarfattootaatiif, faaruu Asaafii ta akka yoyyoma faaruu, «Daraaraa» jedhantee beekkantutti faarfatante, ta dhugaa bayiisaa."]},{"type":"verse","number":1,"content":[{"text":"Ee tissee Israa'elii,","poem":1},{"text":"ka sanyii Yoseefii akka hoole'ee sooressitu,","poem":2},{"lineBreak":true},{"text":"ka barcumaa mootumma'aa keeti","poem":2},{"lineBreak":true},{"text":"ka wodhakkaa dada ol-gubba'aa","poem":2},{"lineBreak":true},{"text":"ta koola qadduu irra teetteertu,","poem":2},{"lineBreak":true},{"text":"nuu dhage'i;","poem":2},{"lineBreak":true},{"text":"ifa keeti issiitii,","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"sanyii Efreemii, sanyii Beniyaaminiitii fi","poem":2},{"lineBreak":true},{"text":"sanyii Minaasee duratti mudhisi.","poem":2},{"text":"Hunna teetiin ka'iitii,","poem":1},{"text":"koyii nu baasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ee Waaqa adde'etti nu deebisi;","poem":1},{"text":"nuu marariitii nu baasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ee Mootii Waan Maraa","poem":1},{"text":"Waaqa waan mara dande'u,","poem":2},{"lineBreak":true},{"text":"haga yoomii daadimata kolbaa teetiititti aarta?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ati imimmaan akka sagale'ee isaan areerte;","poem":1},{"text":"akka bisaanii imimmaan isaan obaatte","poem":2},{"noteId":12},{"text":".","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gosi biyya adda addaa ta ollaa keennaa,","poem":1},{"text":"lafa teenna fudhatiisaaf","poem":2},{"lineBreak":true},{"text":"akka wol lolanu goote;","poem":2},{"lineBreak":true},{"text":"diinoti keennalle nutti murgane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ee Waaqa waan mara dande'u,","poem":1},{"text":"adde'etti nu deebisi;","poem":2},{"lineBreak":true},{"text":"nuu marariitii nu baasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ati muka woyni'ii","poem":1},{"noteId":13},{"text":"biyya Gibxi'iitii fiddee,","poem":1},{"text":"gosa biyya adda addaa ariitee baattee,","poem":2},{"lineBreak":true},{"text":"lafa san keessatti dhaadde.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ati lafa san cirteefii,","poem":1},{"text":"muki woyni'ii sunille hidda gad fageeffatee,","poem":2},{"lineBreak":true},{"text":"lafa san guute.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gaaroti gaaddisa isaatiin gollamane;","poem":1},{"text":"dameeleen isaalle hindheensa gugurdaa gollite.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dameelee ifii haga abbaayaa Mediteraaniya'aa,","poem":1},{"text":"kichuu ifiille haga laga Efraaxiisii diriirfate.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ati maaf dalleya isatti marfameeru irraa diiddee,","poem":1},{"text":"nami karaa san dabaru marti","poem":2},{"lineBreak":true},{"text":"midhaan isaa irraa guurata ree?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gurreen gongoma'aa irra sirban;","poem":1},{"text":"bineensi marti irraa nyaatan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ee Waaqa waan mara dande'u,","poem":1},{"text":"gara keenna deebi'i;","poem":2},{"lineBreak":true},{"text":"ol-gubbaa irraa gad nu ilaalii, nuu dhaggi;","poem":2},{"lineBreak":true},{"text":"muka woyni'ii kana kunuunsi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Muka harki keeti middichi dhaabe kana,","poem":1},{"text":"biqiltuu ifiif guddifate tana eegi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Diinoti muranee, ibiddaan gubaneeran;","poem":1},{"text":"xixxaa teetiin isaan ilaalii, isaan balleessi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nama harka keeti middicha keessa jiru,","poem":1},{"text":"ka ifiif jabeeffatte,","poem":2},{"lineBreak":true},{"text":"harki keeti isa irra jiraatuu ti.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Achiin duuba nuuti","poem":1},{"text":"ijjumaa si irraa duubatti hin deebinu;","poem":2},{"lineBreak":true},{"text":"jiruu nuu kenni;","poem":2},{"lineBreak":true},{"text":"nuutille maqaa keeti waammanna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ee Mootii Waan Maraa","poem":1},{"text":"Waaqa waan mara dande'u,","poem":2},{"lineBreak":true},{"text":"adde'etti nu deebisi;","poem":2},{"lineBreak":true},{"text":"nuu marariitii nu baasi.","poem":2}]}],"footnotes":[{"noteId":12,"caller":"+","text":"Obaatte: Yookiin obaache","reference":{"chapter":80,"verse":5}},{"noteId":13,"caller":"+","text":"Muka woyni'ii: Muki woyni'ii kun Israa'eloota ilaala.","reference":{"chapter":80,"verse":8}}]},"thisChapterLink":"/api/gax_twf/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}