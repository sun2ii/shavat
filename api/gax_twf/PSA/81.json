{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":81,"content":[{"type":"heading","content":["Faaruu Guyyaa Jilaa"]},{"type":"heading","content":["Sooressa faarfattootaatiif, faaruu Asaafii ta suusulle'een faarfatante"]},{"type":"verse","number":1,"content":[{"text":"Waaqa jabeenna keenna te'eef,","poem":1},{"text":"qoonqoo guddo'oon faarsa'a;","poem":2},{"lineBreak":true},{"text":"Waaqa Yaaqoobiitiif ilillisa'a.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Faaruu jalqaba'a; dibbeelle dhowa'a;","poem":1},{"text":"maseenqoo namatti toltuu fi","poem":2},{"lineBreak":true},{"text":"kiraara guddicha dhowa'a.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Baatii ji'aatitti, goobana ji'aatitti,","poem":1},{"text":"guyyaa jila teennaatitti tultullaa afuufa'a.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kun Israa'eliif seerata;","poem":1},{"text":"ajaja Waaqa Yaaqoobii ti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inni yennaa biyya Gibxi'ii dhowiisaaf baye,","poem":1},{"text":"ajaja kana ijoollee Yoseefiitiif kenne.","poem":2},{"text":"Qoonqoon ani dur hin beenne takka,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"«Ani gurmuu teessan irraa ba'aa buuse;","poem":1},{"text":"harka keessan kollonjoo qabatiisa irraa bilisa baase.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Isin rakkinna keessa na waammattane;","poem":1},{"text":"anille isin baase;","poem":2},{"lineBreak":true},{"text":"addee gollaa jirtu,","poem":2},{"lineBreak":true},{"text":"duumensa mandi'u keessaa deebii isinii kenne;","poem":2},{"lineBreak":true},{"text":"ani bisaan Mariiba'aa","poem":2},{"noteId":14},{"text":"biratti haga isin ilaale.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ee kolbaa tiyya,","poem":1},{"text":"yennaa ani ifi isin eeggachiisu dhage'a'a;","poem":2},{"lineBreak":true},{"text":"ee Israa'el, adoo naaf dhageettanee jiraattanee,","poem":2},{"lineBreak":true},{"text":"attam attam dansa'a!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Waaqoti alagaan odduu teessan hin jiraatin;","poem":1},{"text":"waaqota ormaaf hin sagadina'a.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani Mootii Waan Maraa Waaqa keessan,","poem":1},{"text":"ka lafa Gibxi'ii keessaa isin baase;","poem":2},{"lineBreak":true},{"text":"afaan keessan badhisa'aatii banadha'a;","poem":2},{"lineBreak":true},{"text":"anille hin guuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Kolbaan tiyya ammoo na hin dhageenne;","poem":1},{"text":"Israa'el naaf hin ajajanne.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Maarre ani mataa jabeeyyii akka te'anuuf,","poem":1},{"text":"yaada ifiille akka hordofanuuf isaan lakkise.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kolbaan tiyya adoo naaf dhageettee jiraattee,","poem":1},{"text":"Israa'el adoo karaa kiyya ideentee jiraattee,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ani silaa ariiti'iin","poem":2},{"lineBreak":true},{"text":"diinota isaanii hin jilbiissisaayyu;","poem":2},{"lineBreak":true},{"text":"harka kiyyalle","poem":2},{"lineBreak":true},{"text":"gara nyaapha isaanii hin deebifadhaayyu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Worri ana Mootii Waan Maraa jibbu","poem":1},{"text":"na duratti hin jiganiiyyu;","poem":2},{"lineBreak":true},{"text":"adabbiin isaaniille","poem":2},{"lineBreak":true},{"text":"haga bara baraa hin teetiiyyu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ani ammoo silaa","poem":1},{"text":"qamadii dansaa isin Israa'el areeraayyu;","poem":2},{"lineBreak":true},{"text":"damma hollaalle isin quussaayyu» jette.","poem":2}]}],"footnotes":[{"noteId":14,"caller":"+","text":"Mariibaa: Yaadannoo Bay. 17:7 irratti kenname ilaali.","reference":{"chapter":81,"verse":7}}]},"thisChapterLink":"/api/gax_twf/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}