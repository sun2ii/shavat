keessaa isaan baasa'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Worri hamaaleyyiin hin beekanu","poem":1},{"text":"yookiin womaa hin hubatanu;","poem":2},{"lineBreak":true},{"text":"dukkana keessa deddeebi'an;","poem":2},{"lineBreak":true},{"text":"hundeen lafaa duudiin raafante.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Anille, ‹Isin waaqota;","poem":1},{"text":"marti keessanuu","poem":2},{"lineBreak":true},{"text":"ilmaan Waaqa Ol Aana'aa ti› jedhe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Te'uu malee, isin akkuma namaa hin duutan;","poem":1},{"text":"akkuma bulchaa tokkoo hin jiddan» jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gosi biyya adda addaa teeti waan teeteef,","poem":1},{"text":"ee Waaqa ka'ii, biyya lafaa irratti muraa kenni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}