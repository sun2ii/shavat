{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":83,"content":[{"type":"heading","content":["Diinoti Israa'elii Akka Injifatamanuuf Daadimata Dhikaate"]},{"type":"heading","content":["Faaruu Asaafii."]},{"type":"verse","number":1,"content":[{"text":"Ee Waaqa, hin cadhisin;","poem":1},{"text":"hin sarmin yookiin cadhittee hin ilaalin.","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Amumaayyuu diinoti keeti","poem":2},{"lineBreak":true},{"text":"finqila kaasaneeran;","poem":2},{"lineBreak":true},{"text":"worri si jibbu mataa ifii togeera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isaan kolbaa teeti irratti mala dhowani;","poem":1},{"text":"worra ati jaalattu irratti mari'atan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isaan, «Maqaan gosa biyya Israa'elii,","poem":1},{"text":"deebi'ee akka hin qaabatanne,","poem":2},{"lineBreak":true},{"text":"akka isaan kolbaa hin teene,","poem":2},{"lineBreak":true},{"text":"kowaa, isaan balleessinaa» jedhan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yaada tokkoon wolii galanee","poem":1},{"text":"si irratti mala dhowane;","poem":2},{"lineBreak":true},{"text":"si irratti ka'iisaaf wol gondooratane;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isaan kun kolbaa Edoomii, kolbaa Ishimaa'elii,","poem":1},{"text":"kolbaa Mo'aabiitii fi Aggaarii,","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"kolbaa Gebaaliitii fi Amoonii, Amaaleqoota,","poem":2},{"lineBreak":true},{"text":"worra Filisxeemotaatii fi Xiiroosii ti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Worri Asooriille isaanitti ede'amanee","poem":1},{"text":"sanyii Looxii gargaarane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Worra Miidiyaanii akkuma goote,","poem":1},{"text":"laga Qiisoniititti","poem":2},{"lineBreak":true},{"text":"Siisaara'aa fi Yaabiin akkuma goote,","poem":2},{"lineBreak":true},{"text":"isaan kanalle akkasuma godhi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Worri sun Endooritti ijjeefamanee,","poem":1},{"text":"shamanee lafaaf kosii te'ane.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Qondaaltota isaanii","poem":1},{"text":"akkuma Oreebiitii fi Ze'eebii,","poem":2},{"lineBreak":true},{"text":"sooressitoota isaaniille","poem":2},{"lineBreak":true},{"text":"akkuma Zeeba'aa fi Xaalmuna'aa godhi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Isaan, «Lafa kaloo kolbaa Waaqaa","poem":1},{"text":"fudhannee teenna godhanna» worra jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ee Waaqa kiyya","poem":1},{"text":"akka bukuu hobonbolattiin garagaggalchituu,","poem":2},{"lineBreak":true},{"text":"akka huura qilleensi fuudhee deemuu isaan godhi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Akkuma ibiddi gongomaa muxuqi godhu,","poem":1},{"text":"akkuma bobeenni gaara gubu,","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ati bubbee teetiin isaan ari'i;","poem":2},{"lineBreak":true},{"text":"hobonbolattii teetiin isaan bararassi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"akka isaan maqaa keeti barbaadanu,","poem":2},{"lineBreak":true},{"text":"isaan fokkisiisi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Haga bara baraa isaan qaanessiitii naasisi;","poem":1},{"text":"isaan salphinnaan badanuu ti.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Isaan maqaan keeti Mootii Waan Maraa akka te'e,","poem":1},{"text":"ati callaan lafa duudii irratti","poem":2},{"lineBreak":true},{"text":"Waaqa Ol Aanaa akka teete beekanuu ti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}