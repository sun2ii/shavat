{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":84,"content":[{"type":"heading","content":["Mana Waaqaa Dharra'uu"]},{"type":"heading","content":["Sooressa faarfattootaatiif, faaruu ilmaan Qoraahii ta suusulle'een faarfatante."]},{"type":"verse","number":1,"content":[{"text":"Ee Mootii Waan Maraa","poem":1},{"text":"ka Waan Mara Dadde,","poem":2},{"lineBreak":true},{"text":"Galmi ati keessa leetu","poem":2},{"lineBreak":true},{"text":"attam attam natti tola!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lubbuun tiyya","poem":1},{"text":"badhinna Dunkaanii Woyyittii","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraa keessa","poem":2},{"lineBreak":true},{"text":"jiraatiisaaf dharraatee gaggaddi.","poem":2},{"text":"Gadhaan kiyyaa fi foon kiyya,","poem":1},{"text":"Waaqa jiraata'aaf ilillisan.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ee Mootii Waan Maraa","poem":1},{"text":"Ka Waan Mara Dadde,","poem":2},{"lineBreak":true},{"text":"mootii kiyya, Waaqa kiyya;","poem":2},{"lineBreak":true},{"text":"addee ciinca'aa teetitti,","poem":2},{"lineBreak":true},{"text":"sinbirrooti didiqqoon mana ifii,","poem":2},{"lineBreak":true},{"text":"maddoolle mandhee ilmoolee ifii keyattu","poem":2},{"lineBreak":true},{"text":"ijaarrataneeran.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Worri mana keeti keessa le'u ka gammade;","poem":1},{"text":"isaan yennaa mara si leellisan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Worri gara gaara Xiyoonii deemiisaaf,","poem":1},{"text":"gadhaa ifii keessatti dharra'ee,","poem":2},{"lineBreak":true},{"text":"hunna si biraa dhaggatu ka gammade.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isaan yennaa dhooqa godde,","poem":1},{"text":"ta, «Baka» jedhantu keessa dabaranu,","poem":2},{"lineBreak":true},{"text":"addee maddaa isaaniif teeti;","poem":2},{"lineBreak":true},{"text":"bokkeenni furmaataalle","poem":2},{"lineBreak":true},{"text":"dhooqa san keessa haroo eelcha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Isaan akkuma deemanuun jabeenna ede'atan;","poem":1},{"text":"Waaqa Xiyoon keessaa dura hin dhikaatan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ee Mootii Waan Maraa","poem":1},{"text":"Waaqa waan mara dande'u,","poem":2},{"lineBreak":true},{"text":"daadimata kiyya dhage'i;","poem":2},{"lineBreak":true},{"text":"Waaqa Yaaqoobii na caqasi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ee Waaqa, wontee teenna ilaali;","poem":1},{"text":"mooticha muuddeertuuf gadhaa laafi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Addee dhibii","poem":1},{"text":"guyyaa kuma tokko ooliisaa mannaa,","poem":2},{"lineBreak":true},{"text":"badhinna Galma woyyicha keetii keessa","poem":2},{"lineBreak":true},{"text":"guyyaa tokko ooluu woyya;","poem":2},{"text":"Dunkaanii worra hamaaleyyi'ii","poem":1},{"text":"keessa tee'iisaa mannaa,","poem":2},{"lineBreak":true},{"text":"eedduu balbala mana Waaqa kiyyaa","poem":2},{"lineBreak":true},{"text":"te'u naa woyya.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"Waaqi akka adu'uu tii fi akka wonte'ee ti;","poem":2},{"lineBreak":true},{"text":"inni fudhatamaa fi","poem":2},{"lineBreak":true},{"text":"ulfinna akka dhaggatanu hin godha.","poem":2},{"text":"Mootiin Waan Maraa worra komii hin qanne,","poem":1},{"text":"waan dansaa hin dhooggatu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ee Mootii Waan Maraa","poem":1},{"text":"Ka Waan Mara Dadde,","poem":2},{"lineBreak":true},{"text":"nami si'itti addatu ka gammade.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}