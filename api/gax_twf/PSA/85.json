{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":85,"content":[{"type":"heading","content":["Daadimata Nageya Biyyaatiif Dhikaate"]},{"type":"heading","content":["Faaruu ilmaan Qoraahii, Sooressa faarfattootaatiif."]},{"type":"verse","number":1,"content":[{"text":"Ee Mootii Waan Maraa","poem":1},{"text":"ati lafa teeti mararteerta;","poem":2},{"lineBreak":true},{"text":"sanyii Yaaqoobiitiif","poem":2},{"lineBreak":true},{"text":"milkii adde'etti deebitteerta.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ati yakkaa kolbaa teetii araaranteerta;","poem":1},{"text":"cubbuu isaaniille mara golliteerta.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mufii teeti lakkitteerta;","poem":1},{"text":"aarii teeti ta bobeettu irraa deebiteerta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ee Waaqa fayyisaa keenna,","poem":1},{"text":"adde'etti nu deebisi;","poem":2},{"lineBreak":true},{"text":"nutti mufatiisa lakkisi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ati haga bara baraa nutti aartaa ree?","poem":1},{"text":"Aarii teeti dhaloota irraa","poem":2},{"lineBreak":true},{"text":"gara dhalootaatitti dabarsitaa ree?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kolbaan teeti akka sitti guddoo gammadu,","poem":1},{"text":"deebittee nu hin jiraachittuu ree?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ee Mootii Waan Maraa","poem":1},{"text":"jaalala keeti ka bara baraa nutti mudhisi;","poem":2},{"lineBreak":true},{"text":"fayyisiisa keeti nuu kenni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ani waan Waaqi Mootiin Waan Maraa dubbatu","poem":1},{"text":"hin caqasa;","poem":2},{"lineBreak":true},{"text":"kolbaan isaa, worri isaaf addatame,","poem":2},{"lineBreak":true},{"text":"gara gowwumma'aatitti hin deebi'in malee,","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa","poem":2},{"lineBreak":true},{"text":"nageya isaaniif waadaa gala.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ulfinni isaa","poem":1},{"text":"lafa teenna keessa akka jiraatu,","poem":2},{"lineBreak":true},{"text":"dhugumaan fayyisiisi isaa","poem":2},{"lineBreak":true},{"text":"worra isa sodaatuuf dhikoo jira.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Jaalalli fi addatamummaan wol dhaggan;","poem":1},{"text":"balchumma'aa fi nageenni wol sunqatan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Addatamummaan lafa keessaa latti;","poem":1},{"text":"balchummaan ol-gubbaa irraa gad ilaalti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"waan dansaa hin kenna;","poem":2},{"lineBreak":true},{"text":"latti teennalle midhaan hin baatti.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Balchummaan dura isaa deenti;","poem":1},{"text":"tarkaaffii isaatiif daandii qopheessiti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}