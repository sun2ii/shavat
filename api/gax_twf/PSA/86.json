{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":86,"content":[{"type":"heading","content":["Daadimata Qarqaarsa Waaqaa Dhaggatiisaaf Dhikaate"]},{"type":"heading","content":["Daadimata Daawitii."]},{"type":"verse","number":1,"content":[{"text":"Ee Mootii Waan Maraa, ani hiyyeessa rakkataa waan te'eef,","poem":1},{"text":"gurra keeti gara kiyya deebifadhuutii,","poem":2},{"lineBreak":true},{"text":"naa dhage'i.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ani waan si'iif ifi kenneeruuf,","poem":1},{"text":"jiruu tiyya eegi;","poem":2},{"lineBreak":true},{"text":"tajaajilaa keeti ka sitti addatu baasi;","poem":2},{"lineBreak":true},{"text":"ati Waaqa kiyya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ani guyyaa guutuu gara keeti waan iyyuuf,","poem":1},{"text":"ee Mootii Waan Maraa, na marari.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ani lubbuu tiyya sitti waan kennadheeruuf","poem":2},{"lineBreak":true},{"text":"ana tajaajilaa keeti gammachiisi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ee Mootii Waan Maraa, ati dansa'a;","poem":1},{"text":"namaafille hin araaranta;","poem":2},{"lineBreak":true},{"text":"worra si waammatuuf,","poem":2},{"lineBreak":true},{"text":"jaalala keeti ka bara baraa hin baceessita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ee Mootii Waan Maraa, daadimata kiyya dhage'i;","poem":1},{"text":"iyya gaaffii tiyyaa caqasi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ati waan deebii naa kennituuf,","poem":1},{"text":"ani guyyaa rakkinna kiyyaa","poem":2},{"lineBreak":true},{"text":"si waammadha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"waaqota keessaa ka akka keetii hin jiru;","poem":2},{"lineBreak":true},{"text":"hujiin akka hujii teetiille hin jirtu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gootta'a, kolbaan biyya adda addaa","poem":1},{"text":"ta ati dadde marti gara keeti dhuttee,","poem":2},{"lineBreak":true},{"text":"si'iif hin sagaddi;","poem":2},{"lineBreak":true},{"text":"maqaa keetiifille ulfinna hin kenniti.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ati guddaa waan teeteef,","poem":1},{"text":"hujii baasaa hin hujja;","poem":2},{"lineBreak":true},{"text":"ati callaan Waaqa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ani dhugaa teetiin akka deemuuf,","poem":2},{"lineBreak":true},{"text":"karaa keeti na barsiisi;","poem":2},{"text":"Akka ani maqaa keeti sodaadhuuf,","poem":1},{"text":"nama gadhaa tokkochaa na godhi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ee Mootii Waan Maraa Waaqa kiyya,","poem":1},{"text":"ani gadhaa tokkochaan si galateeffadha;","poem":2},{"lineBreak":true},{"text":"maqaa keetiifille","poem":2},{"lineBreak":true},{"text":"haga bara baraa ulfinna hin keenna.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Jaalalli keeti ka bara baraa","poem":1},{"text":"ka ati naaf qaddu gudda'a;","poem":2},{"lineBreak":true},{"text":"ati lubbuu tiyya","poem":2},{"lineBreak":true},{"text":"qilee addee worri du'e jiru irraa hamburteerta.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ee Waaqa,","poem":1},{"text":"worri bondhooru na irratti ka'eera;","poem":2},{"lineBreak":true},{"text":"goliin worra gadhaa jabaatuu,","poem":2},{"lineBreak":true},{"text":"lubbuu tiyya balleessiisaaf barbaadan;","poem":2},{"lineBreak":true},{"text":"isaan woyittuu si hin laakkowanu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ee Gootta'a, ati ammoo,","poem":1},{"text":"Waaqa mararaa arja'a;","poem":2},{"lineBreak":true},{"text":"aari'iif hin ariifattu;","poem":2},{"lineBreak":true},{"text":"jaalalli keeti ka bara baraatii fi","poem":2},{"lineBreak":true},{"text":"addatamummaan teetille baca'a.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Gara kiyya deebi'ii, na marari;","poem":1},{"text":"hunna teeti ana tajaajilaa keetiif kenni;","poem":2},{"lineBreak":true},{"text":"ana ilma garbittii teetii baasi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ati waan na qarqaartee","poem":2},{"lineBreak":true},{"text":"na jajjabeessiteef,","poem":2},{"lineBreak":true},{"text":"diinoti kiyya dhagganee akka fokkifatanu,","poem":2},{"lineBreak":true},{"text":"beessisa fudhatama keeti dhaggatiisaa","poem":2},{"lineBreak":true},{"text":"na irratti mudhisi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}