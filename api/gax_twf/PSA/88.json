{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":88,"content":[{"type":"heading","content":["Daadimata Qarqaarsa Waaqaa Dhaggatiisaaf Dhikaate"]},{"type":"heading","content":["Sooressa faarfattootaatiif, faaruu ilmaan Qoraahii, ta akka yoyyoma faaruu, «Mahalaat» jedhantuun faarfante; barsiisa Hemaanii Ezraahichaa."]},{"type":"verse","number":1,"content":[{"text":"Ee Mootii Waan Maraa","poem":1},{"text":"Waaqa fayyinna kiyyaa,","poem":2},{"lineBreak":true},{"text":"ani fuula keeti duratti","poem":2},{"lineBreak":true},{"text":"halkanii fi guyyaa gara keeti iyya.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Daadimati kiyya si bira gewuu ti;","poem":1},{"text":"gurra keeti gara iyya tiyya deebifadhu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lubbuun tiyya","poem":1},{"text":"rakkinnaan waan guutanteef,","poem":2},{"lineBreak":true},{"text":"jiruun tiyya","poem":2},{"lineBreak":true},{"text":"gara addee worri du'e jiruu dhikaatteerti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ani worra gad gara boollaa dhaqu oddu'utti","poem":1},{"text":"laakkowame;","poem":2},{"lineBreak":true},{"text":"ani akka nama hunna hin qannee te'e.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ani akka nama worra du'e keessatti gatamee,","poem":1},{"text":"akka worra ijjeefamee awwaala keessa ciisuu,","poem":2},{"lineBreak":true},{"text":"akka worra ati deebitee hin qaabannee,","poem":2},{"lineBreak":true},{"text":"ka ati ijjumaa hin qarqaarree te'e.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ati boolla qilee,","poem":1},{"text":"qilee dukkanaa keessa na buutte.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mufiin teeti ulfaattee na irra ciitteerti;","poem":1},{"text":"ati danbalii mufii teetii mara","poem":2},{"lineBreak":true},{"text":"na irra danbalaatteerta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Firooti kiyya","poem":1},{"text":"akka na irraa fagaatanu gooteerta;","poem":2},{"lineBreak":true},{"text":"akka isaan na diqatanu gooteerta;","poem":2},{"lineBreak":true},{"text":"akka ani miliquu hin dandeenne,","poem":2},{"lineBreak":true},{"text":"balbalti natti cufanteerti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ilti tiyya gaddaan caararrootteerti;","poem":1},{"text":"ee Mootii Waan Maraa,","poem":2},{"lineBreak":true},{"text":"guyyuma guyya'aan ani si waammadha;","poem":2},{"lineBreak":true},{"text":"harka kiyyalle gara keeti diriirsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ati worra du'eeruuf","poem":1},{"text":"waan maade'ee hin hujjaa ree?","poem":2},{"lineBreak":true},{"text":"Ekeraan kaatee si leellifattii ree?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jaalalli keeti ka bara baraa","poem":1},{"text":"boolla awwaalaa keessatti,","poem":2},{"lineBreak":true},{"text":"addatamummaan teeti","poem":2},{"lineBreak":true},{"text":"addee badi'ii keessatti","poem":2},{"lineBreak":true},{"text":"hin lallabantii ree?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hujii teeti ta bilbaasaa dukkana keessatti,","poem":1},{"text":"yookiin balchummaan teeti","poem":2},{"lineBreak":true},{"text":"lafa dedhante keessatti hin beekkantii ree?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ee Mootii Waan Maraa, ani ammoo,","poem":1},{"text":"qarqaarsa dhaggatiisaaf gara keeti iyya;","poem":2},{"lineBreak":true},{"text":"ganama ganamaan","poem":2},{"lineBreak":true},{"text":"daadimati kiyya si dura dhikaata.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ee Mootii Waan Maraa,","poem":2},{"lineBreak":true},{"text":"ati maaf ifi irraa na fageessita?","poem":2},{"lineBreak":true},{"text":"Ati maaf fuula keeti na dhoffatta?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ani dargaggummaa tiyya irraa jalqabee,","poem":1},{"text":"farree du'a geyeera;","poem":2},{"lineBreak":true},{"text":"bararassiisa keeti irraa ka ka'e","poem":2},{"lineBreak":true},{"text":"waan godhu wollaaleera.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mufiin teeti na irra buuteerti;","poem":1},{"text":"bararassiisi keetille na balleesseera.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mufiin teetii fi bararassiisi keeti","poem":1},{"text":"guyyaa guutuu akka lola'aa na marsane;","poem":2},{"lineBreak":true},{"text":"gara maraan karaa natti cufane.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ati lansootaa fi jaalota kiyya na irraa fageessite;","poem":1},{"text":"dukkanti callaan jaala kiyya naaf teete.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}