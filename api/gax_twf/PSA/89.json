{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":89,"content":[{"type":"heading","content":["Addatamummaa Waaqaa"]},{"type":"heading","content":["Wolaloo Etaanii Ezraahichaa"]},{"type":"verse","number":1,"content":[{"text":"Ee Mootii Waan Maraa, ani marroo jaalala keeti ka bara baraa,","poem":1},{"text":"yennaa mara hin faarfadha;","poem":2},{"lineBreak":true},{"text":"addatamummaa teeti dhaloota maraaf,","poem":2},{"lineBreak":true},{"text":"afaan kiyyaan hin lallaba.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jaalalli keeti ka bara baraa","poem":1},{"text":"jabaatee akka dhaabbate,","poem":2},{"lineBreak":true},{"text":"addatamummaa teetille","poem":2},{"lineBreak":true},{"text":"akka ol-gubba'aa akka ati dhaadde,","poem":2},{"lineBreak":true},{"text":"ani hin lallaba.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ati, «Ka filadhe woliin gondooroo godheera;","poem":1},{"text":"tajaajilaa kiyya Daawitiif,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"‹Sanyii teeti haga bara baraa hin jabeessa;","poem":1},{"text":"barcumaa mootummaa teetii","poem":2},{"lineBreak":true},{"text":"dhalootaa haga dhalootaatitti hin dhaaba›","poem":2},{"lineBreak":true},{"text":"jedhee kakadheera» jetteerta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ol-gubbaan bilbaasa keeti,","poem":2},{"lineBreak":true},{"text":"yaa'iin woyyootaa","poem":2},{"lineBreak":true},{"text":"addatamummaa teeti leellifatanuu ti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ol-gubbaa keessatti","poem":1},{"text":"ka Mootii Waan Maraatiin wol qixxawu eennu?","poem":2},{"lineBreak":true},{"text":"Ergantoota Waaqaa ta ol-gubba'aa keessaa","poem":2},{"lineBreak":true},{"text":"ka akka Mootii Waan Maraa jiru eennu?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yaa'ii woyyittii keessatti","poem":1},{"text":"Mootiin Waan Maraa guddoo ka sodaatame;","poem":2},{"lineBreak":true},{"text":"worra adaala isaa jiru mara caalaa sodaachisa'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ee Mootii Waan Maraa","poem":1},{"text":"Waaqa Waan Mara Dande'u,","poem":2},{"lineBreak":true},{"text":"ka akka keetii eennu?","poem":2},{"text":"Ati jaba'a;","poem":1},{"text":"Ati waan maraan addatama'a.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ati bulpheessa abbaaya'aa irratti baallii qadda;","poem":1},{"text":"danbaliin isi'ii yennaa kaatulle, hin sarmisiitta.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bineensa akka jawwe'ee ka, «Rahaab» jedhamu,","poem":1},{"text":"akka waan qalameetitti butuchite;","poem":2},{"lineBreak":true},{"text":"irree teeti jaddu'uun diinota keeti bittinneessite.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ol-gubbaan teeti; lattille teeti;","poem":1},{"text":"biyya lafaatii fi waan isii keessaa mara ka dade si'i.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kaabaa fi kibballe sittuu dade;","poem":1},{"text":"gaarri Taaboriitii fi gaarri Hermoonii","poem":2},{"lineBreak":true},{"text":"maqaa keetiif ilillisan.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ati irree hunnaamettii qadda;","poem":1},{"text":"harki keeti jaba'a;","poem":2},{"lineBreak":true},{"text":"hunna teeti mudhisiisaaf","poem":2},{"lineBreak":true},{"text":"harki keeti middichi ol ka'eera.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Barcumaan mootumma'aa keeti","poem":1},{"text":"balchumma'aa fi haqa irra dhaabbateera;","poem":2},{"lineBreak":true},{"text":"jaalalaa fi addatamummaan siin dura deeman.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"Kolbaan ilillisaa si leellittu,","poem":2},{"lineBreak":true},{"text":"ta ifa fuula keeti duraa keessa ideentu gammadduu ti.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Isaan guyyaa guutuu maqaa keetitti gammadan;","poem":1},{"text":"balchummaa teetille'een si leellisan.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ati ulfinnaa fi jabeenna isaanii waan teeteef,","poem":1},{"text":"fudhatama si biraa dhagganneen injifanna.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wonteen teenna ta Mootii Waan Maraa ti;","poem":1},{"text":"mootiin keennalle ka Woyyicha Israa'elii ti.","poem":2}]},{"type":"heading","content":["Addii Waaqi Daawitiif Kenne"]},{"type":"verse","number":19,"content":[{"text":"Ati yennaa takka tajaajiltoota addatantoota teetitti,","poem":1},{"text":"mudhi'iin dubbattee,","poem":2},{"text":"«Janna tokkoof qarqaarsa kenneera;","poem":1},{"text":"dargaggeessa tokko","poem":2},{"lineBreak":true},{"text":"odduu kolba'aatii filee ol kaaseera.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Tajaajilaa kiyya Daawiti dhaggadheera;","poem":1},{"text":"zayitii tiyya woyyitti'iin isa muudeera.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Harki kiyya isa woliin hin jiraata;","poem":1},{"text":"irreen tiyyalle isa hin jabeessiti.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Diinni isa hin injifatu;","poem":1},{"text":"nami hamaalle gad isa hin qabu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ani nyaaphota isaa","poem":1},{"text":"fuula isaa duratti hin butucha;","poem":2},{"lineBreak":true},{"text":"worra isa jibbulle gad dhowa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Addatamummaan tiyyaa fi","poem":1},{"text":"marartiin tiyya isa woliin hin jiraatan;","poem":2},{"lineBreak":true},{"text":"maqaa kiyyaan hin injifata.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ani harka isaa abbaayaa","poem":1},{"noteId":16},{"text":"irra,","poem":1},{"text":"harka isaa middichalle","poem":2},{"lineBreak":true},{"text":"lagoota","poem":2},{"noteId":17},{"text":"irra hin keya.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Inni, ‹Ati abbaa kiyya, Waaqa kiyya,","poem":1},{"text":"rassaa fayyinna kiyyaa ti› naan hin jedha.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Anille ilma kiyya angafa,","poem":1},{"text":"ka mootota biyya lafa mara caalu isa hin godha.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ani haga bara baraa isa jaaladha;","poem":1},{"text":"gondooroon ani isa woliin godhelle","poem":2},{"lineBreak":true},{"text":"ijjumaa hin diigantu.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Sanyiin isaa haga bara baraa,","poem":1},{"text":"barcumaan mootummaa isaalle","poem":2},{"lineBreak":true},{"text":"akka ol-gubba'aa jabaatee akka dhaabbatu hin godha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"«Ijoolleen isaa ammoo","poem":1},{"text":"seera kiyya yoo diidde,","poem":2},{"lineBreak":true},{"text":"akka ajaja kiyyaatitti yoo deemuu dhadde,","poem":2}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"seerata kiyya yoo diigane,","poem":2},{"lineBreak":true},{"text":"ajaja kiyya yoo eegatuu dhabane,","poem":2}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"ani cubbuu isaaniitiif ule'een isaan adaba;","poem":2},{"lineBreak":true},{"text":"yakkaa isaaniitiif isaan hin dhaana.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ammoo ani Daawiti jaalatiisa hin lakkisu,","poem":1},{"text":"yookiin addatamummaan ani isaaf qabu","poem":2},{"lineBreak":true},{"text":"soba hin teetu.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ani gondooroo tiyya hin diigu,","poem":1},{"text":"yookiin dubbii afaan kiyyaa baatelle hin jijjiiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"«Ani takkaa woyyummaa tiyyaan kakadheera;","poem":1},{"text":"ani Daawiti hin sobu.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Sanyiin isaa haga bara baraa,","poem":1},{"text":"barcumaan mootummaa isaalle","poem":2},{"lineBreak":true},{"text":"akka adu'uu fuula kiyya dura hin jiraata.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Mootummaan Daawitii,","poem":1},{"text":"akka ji'a dhugaa bayaa addatamaa gubba'aa,","poem":2},{"lineBreak":true},{"text":"haga bara baraa jabaattee hin dhaabbatti» jette.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Amma ammoo","poem":1},{"text":"ati ka muuddee mootii gooteetitti mufattee,","poem":2},{"lineBreak":true},{"text":"isa tuffattee gatteerta.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Ati gondooroo tajaajilaa keeti woliin goote diiddee,","poem":1},{"text":"kallacha isaa bukuu keessatti gattee batteessite.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Ati dalleya isaa mara jissitee,","poem":1},{"text":"kushee isaalle diidde.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Worri achiin dabaru marti isa saamane;","poem":1},{"text":"inni murgoo olloota ifii te'e.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Nyaaphota isaatiif jabeenna kennitee,","poem":1},{"text":"diinota isaa mara gammachiitte.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Qara shallaagaa isaa","poem":1},{"text":"gara duubaa garagalchite;","poem":2},{"lineBreak":true},{"text":"lola keessalle'etti isa hin qarqaarre.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Ulee bokku'uu ta isaa harkaa fuutee,","poem":1},{"text":"barcumaa mootummaa isaalle lafatti jissite.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Bara dargaggummaa isaa itti gabaassitee,","poem":1},{"text":"qaanii itti uffitte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"tun haga yoomii teeti?","poem":2},{"lineBreak":true},{"text":"Ati haga bara baraa","poem":2},{"lineBreak":true},{"text":"ifi dhoffattaa ree?","poem":2},{"lineBreak":true},{"text":"Haga yoomii mufiin teeti","poem":2},{"lineBreak":true},{"text":"akka ibiddaa bobeetti ree?","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Barri jiruu tiyyaa","poem":1},{"text":"attam attam gabaabaa akka te'e yaadadhu;","poem":2},{"lineBreak":true},{"text":"ati ilmaan namaa waan bu'aa hin qanneef daddee ree?","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Nami ijjumaa hin du'in le'uu dande'u eennu?","poem":1},{"text":"Awwaala jalaa ka miliquu dande'u eennu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"Ee Gootta'a,","poem":1},{"text":"jaalalli keeti ka bara baraa guddaan durii,","poem":2},{"lineBreak":true},{"text":"ka ati addatamummaa teetiin","poem":2},{"lineBreak":true},{"text":"Daawitiif kakatte meet ree?","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Ee Gootta'a,","poem":1},{"text":"ana tajaajilaa keetitti attam attam","poem":2},{"lineBreak":true},{"text":"akka isaan murgane,","poem":2},{"lineBreak":true},{"text":"ani arraba gosa biyya adda addaa mara","poem":2},{"lineBreak":true},{"text":"attam attam akka ossadhe qaabadhu.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"diinoti keeti ka ati muuddee mootii goote salphisan;","poem":2},{"lineBreak":true},{"text":"lafa inni dhaqu maratti itti murgan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Mootiin Waan Maraa haga bara baraa leellifamu!","poem":1},{"text":"Ameen! Ameen!","poem":2}]}],"footnotes":[{"noteId":16,"caller":"+","text":"Abbaayaa: Abbaayaan tun abbaayaa Mediteraaniya'aa ti.","reference":{"chapter":89,"verse":25}},{"noteId":17,"caller":"+","text":"Lagoota: Lagooti kun laga Xeegrosiitii fi Efraaxiisii ti.","reference":{"chapter":89,"verse":25}}]},"thisChapterLink":"/api/gax_twf/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":52}