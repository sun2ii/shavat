{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":9,"content":[{"type":"heading","content":["Waaqa Muraa Haqaa Muruuf Galata Dhikaate"]},{"type":"heading","content":["Sooressa faarfattootaatiif, faaruu Daawitii ta akka yoyyoma faaruu, «Du'a ilmaa» jedhantee beekkantutti faarfatante."]},{"type":"verse","number":1,"content":[{"text":"Ee Mootii Waan Maraa, ani gadhaa tokkochaan si leellisa;","poem":1},{"text":"baasa ati goote mara hin odeessa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ani sitti gammadee hin burraaqa;","poem":1},{"text":"Waaqa Ol Aana'a,","poem":2},{"lineBreak":true},{"text":"ani faaruu leellisaa maqaa keetiif hin faarsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Diinoti kiyya gara duubaa yennaa deebi'anu,","poem":1},{"text":"isaan gufatanee fuula keeti duraa badan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ati haqa kiyyaa fi haajaa kiyya waan ilaalteef,","poem":1},{"text":"barcumaa mootumma'aa keeti irra teettee,","poem":2},{"lineBreak":true},{"text":"muraa haqaa murteerta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ati gosa biyya adda addaa xixxee,","poem":1},{"text":"hamaaleyyii balleessite;","poem":2},{"lineBreak":true},{"text":"maqaa isaaniille bara baraa haga bara baraa","poem":2},{"lineBreak":true},{"text":"haxoottee balleessite.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Diinoti keenna haga bara baraa dhumataneeran.","poem":1},{"text":"Qachooti gugurdaan isaanii badaneeran;","poem":2},{"lineBreak":true},{"text":"Duufeyi","poem":2},{"noteId":1},{"text":"isaaniille ijjumaa badeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mootiin Waan Maraa ammoo","poem":1},{"text":"haga bara baraa bulcha;","poem":2},{"lineBreak":true},{"text":"inni mura'aaf,","poem":2},{"lineBreak":true},{"text":"barcumaa mootumma'aa ka ifii","poem":2},{"lineBreak":true},{"text":"jabeessee dhaabbateera.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inni balchumma'aan biyya lafaa hin bulcha;","poem":1},{"text":"gosa biyya adda addaa haqaan bulcha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mootiin Waan Maraa worra cunqurfameef,","poem":1},{"text":"addee itti baqatanu;","poem":2},{"lineBreak":true},{"text":"yennaa rakko'oo dalleya jaba'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ati worra si barbaadu waan hin lakkinneef,","poem":2},{"lineBreak":true},{"text":"worri maqaa keeti beeku sitti addata.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mootii Waan Maraa ka Xiyoon keessa te'ee bulchuuf,","poem":1},{"text":"faaruu leellisaa faarsa'a.","poem":2},{"text":"Waan inni godhe mara","poem":1},{"text":"gosa biyya adda addaa oddu'utti odeessa'a.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Inni dhiiga dhangala'eef haluu hin baya;","poem":1},{"text":"iyya worra cunqurfameelle hin dedhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ee Mootii Waan Maraa, naaf marari.","poem":1},{"text":"Rakkoo diinoti kiyya natti fidanu ilaali;","poem":2},{"lineBreak":true},{"text":"du'a irraa na hamburi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Achiin duuba ani karra qachaa Xiyoonii","poem":1},{"noteId":2},{"text":"keessatti","poem":1},{"text":"waan ittiin si leellisu mara isaanitti hin hima.","poem":2},{"text":"Ati waan na fayyitteef,","poem":1},{"text":"gammadaan firinxiixa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Gosi biyya adda addaa","poem":1},{"text":"boolluma ifii qotane bu'ane;","poem":2},{"lineBreak":true},{"text":"miilli isaanii tiyyuma isaan afaneen qabame.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mootiin Waan Maraa,","poem":1},{"text":"muraa ifii balchitti'iin ifi beessise;","poem":2},{"lineBreak":true},{"text":"hamaaleyyiin hujuma harka ifiitiin qabamane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Worri hamaaleyyi'ii fi","poem":1},{"text":"gosi biyya adda addaa ka Waaqa dedhu marti,","poem":2},{"lineBreak":true},{"text":"gara addee worri du'e jiruu gad hin bu'an.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Worri rakkataan ammoo","poem":1},{"text":"yoomille hin dedhamanu;","poem":2},{"lineBreak":true},{"text":"addiin worra hiyyeeyyi'iille","poem":2},{"lineBreak":true},{"text":"haga bara baraa baddee hin hattu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ee Mootii Waan Maraa, ka'i!","poem":1},{"text":"Nami hin mootomin;","poem":2},{"lineBreak":true},{"text":"gosi biyya adda addaa","poem":2},{"lineBreak":true},{"text":"si duratti muraa dhaggattuu ti.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"akka isaan si sodaatanu godhi;","poem":2},{"lineBreak":true},{"text":"nama foon uffate te'uu isaanii akka beekanu godhi.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Duufeyi: Maqaa addee yaadannoo hujii jannummaa nama tokkoo mudhisiisaaf, meya waan inni tolche san mudhisu itti fannifamee ti.","reference":{"chapter":9,"verse":6}},{"noteId":2,"caller":"+","text":"Karra qachaa Xiyoonii: Afaan Ibrootaatiin karra intala Xiyoonii jedha.","reference":{"chapter":9,"verse":14}}]},"thisChapterLink":"/api/gax_twf/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}