{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":90,"content":[{"type":"heading","content":["Waaqi Dande'aa Bara Baraa Akka Te'e"]},{"type":"heading","content":["Daadimata Muusee Nama Waaqaa"]},{"type":"verse","number":1,"content":[{"text":"Ee Gootta'a, ati dhalootaa haga dhalootaatitti,","poem":1},{"text":"addee itti baqannu nuuf teeteerta.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gaarri adoo hin dadamin dura,","poem":1},{"text":"yookiin ati lafaa fi biyya lafaa adoo hin dadin dura,","poem":2},{"lineBreak":true},{"text":"baraa haga bara baraatitti ati Waaqa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ilmaan namaa gara biyye'ee deebitta;","poem":1},{"text":"ati, «Ee ilmaan namaa,","poem":2},{"lineBreak":true},{"text":"gara biyye'ee deebi'a'a» jetta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Woggaan kum tokko,","poem":1},{"text":"si'iif akkuma guyyaa kalee dabaree ti;","poem":2},{"lineBreak":true},{"text":"yookiin akkuma yennaa diqqoo halkan keessaa ti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ati namoota haxoottee dabarsita;","poem":1},{"text":"isaan akka oojju'uu ti;","poem":2},{"lineBreak":true},{"text":"isaan akka marra ganama quunxuu ti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Marri ganama quunxee bisila;","poem":1},{"text":"galgala qooree goga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nuuti aarii teetiin banneerra;","poem":1},{"text":"mufii teetiin bararandheerra.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ati yakkaa teenna ifi dura,","poem":1},{"text":"cubbuu teenna ta dhossa'aa","poem":2},{"lineBreak":true},{"text":"ifa fuula keetii dura keetteerta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Barri keenna marti","poem":1},{"text":"adoo nuuti mufii teeti jala jirruu dabaran;","poem":2},{"lineBreak":true},{"text":"bara jiruu teennaa aadaatuma fixanna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Barri jiruu teennaa woggaa torbaatama,","poem":1},{"text":"yoo bacatelle woggaa saddeettama;","poem":2},{"lineBreak":true},{"text":"woggooti sunuu","poem":2},{"lineBreak":true},{"text":"dadhabbi'ii fi rakkinna nutti fidan;","poem":2},{"text":"Isaan dafanee waan dabaranuuf,","poem":1},{"text":"nuuti koolaan kaanee dabarra.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Hunna aarii teetii eentu beeka?","poem":1},{"text":"Mufii teeti guddoo san eentu hubatuu dande'a?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Qaroolee akka teenu,","poem":1},{"text":"barri jiruu teennaa","poem":2},{"lineBreak":true},{"text":"gabaabaa akka te'e akka beennu nu barsiisi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ee Mootii Waan Maraa, deebi'i!","poem":1},{"text":"Haga yoomii mufatta?","poem":2},{"lineBreak":true},{"text":"Tajaajiltoota teetiif gadhaa laafi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bara jiruu teennaa mara","poem":1},{"text":"akka gammannee ilillinnu,","poem":2},{"lineBreak":true},{"text":"ganama ganama jaalala keeti","poem":2},{"lineBreak":true},{"text":"ka bara baraatiin nu quussi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Akkuma bara bacaa nu rakkitte,","poem":1},{"text":"akkuma woggaa bacaa waan hantuu dhaggine,","poem":2},{"lineBreak":true},{"text":"amma nu gammachiisi!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hujii teeti tajaajiltoota teetitti,","poem":1},{"text":"ulfinna keeti ijoollee isaaniititti mudhisi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Goottaa Waaqa keenna,","poem":1},{"text":"ila dansa'aan nu ilaali;","poem":2},{"lineBreak":true},{"text":"hujii harka keennaalle nuu milkeessi;","poem":2},{"lineBreak":true},{"text":"ee, nuu milkeessi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}