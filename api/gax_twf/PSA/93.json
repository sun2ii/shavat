{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":93,"content":[{"type":"heading","content":["Arnya Mootii Waan Maraa"]},{"type":"verse","number":1,"content":[{"text":"Mootiin Waan Maraa mooti'i; inni arnya uffate;","poem":1},{"text":"arnya uffatee jabeennaan hidhate.","poem":2},{"text":"Biyyi lafaa jabaattee dhaabbatte;","poem":1},{"text":"isiin ijjumaa hin tachootu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Barcumaan mootumma'aa keeti","poem":1},{"text":"durii duriitii jalqabee dhaabbate;","poem":2},{"lineBreak":true},{"text":"ati bara durii duriitii jalqaddee jirta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ee Mootii Waan Maraa, lagi hedduun ol kakka'e;","poem":1},{"text":"shookkisiisa ifii ol qabate;","poem":2},{"lineBreak":true},{"text":"danbalii shookkisiisa ifiille ol kaafate.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Shookkisiisa bisaan jabaa heddu'uu caalaa,","poem":1},{"text":"danbalii abbaaya'aa hunnaamettii caalaa,","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa ka ol-gubbaa jiru hunnaamessa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ee Mootii Waan Maraa, seerri keeti ka addatame;","poem":1},{"text":"manni keetille haga bara baraa woyyumma'aan ka miidhage.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}