{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":95,"content":[{"type":"heading","content":["Faaruu Leellisaa"]},{"type":"verse","number":1,"content":[{"text":"Kowa'a, Mootii Waan Maraatiif,","poem":1},{"text":"ilillisaa faarfannaa!","poem":2},{"lineBreak":true},{"text":"Rassaa nu baasu iyyinee leellifannaa!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Galataan fuula isaa dura dhikaannuu ti;","poem":1},{"text":"faaruu leellisaatiin ilillinnuu ti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mootiin Waan Maraa Waaqa gudda'a;","poem":1},{"text":"waaqota mara irratti mooti'i.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Qileen lafa jalaa harka isaa keessa jirti;","poem":1},{"text":"qacceen gaaraalle tama isaa ti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inni waan isii dadeef,","poem":1},{"text":"abbaayaan ta isaa ti;","poem":2},{"lineBreak":true},{"text":"lafa godduulle harkuma isaatitti dade.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kowa'a, gad jennee isa waaqonfannaa!","poem":1},{"text":"Mootii Waan Maraa","poem":2},{"lineBreak":true},{"text":"ka nu dade duratti jilbiiffannaa!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni Waaqa keenna waan te'eef,","poem":1},{"text":"nuuti kolbaa inni bobbaasu,","poem":2},{"lineBreak":true},{"text":"hoolota inni tissu.","poem":2},{"lineBreak":true},{"text":"Adha qoonqoo isaa yoo dhageettane,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"«Akkuma abbootiin teessan ta durii goomolee","poem":2},{"lineBreak":true},{"text":"Mariiba'aatii fi Maasa'aa keessatti goote,","poem":2},{"lineBreak":true},{"text":"isin mataa jabeeyyii hin te'ina'a.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abbootiin teessan ta durii achitti,","poem":1},{"text":"waan ani isaanii godhe adoo dhagganeeranu","poem":2},{"lineBreak":true},{"text":"haga na ilaalanee, na aarsane.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani dhaloota san woggaa afurtama diqadhee,","poem":1},{"text":"‹Isaan worra karaa irraa goreeru;","poem":2},{"lineBreak":true},{"text":"karaa kiyyalle hin beenne› jedhe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ani tanaaf aaree,","poem":1},{"text":"‹Isaan ijjumaa biyya fooraa tiyyatti hin galanu› jedhee kakadhe» jedhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}