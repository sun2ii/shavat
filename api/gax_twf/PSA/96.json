{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":96,"content":[{"type":"heading","content":["Waaqa Mooticha Ol Aanaa"]},{"type":"verse","number":1,"content":[{"text":"Faaruu haareya Mootii Waan Maraatiif faarsa'a;","poem":1},{"text":"Kolbaan lafa irraa marti","poem":2},{"lineBreak":true},{"text":"Mootii Waan Maraatiif faaruu faarsa'a.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mootii Waan Maraatiif faaruu faarsa'a;","poem":1},{"text":"maqaa isaa leellisa'a.","poem":2},{"lineBreak":true},{"text":"Guyyuma guyya'aan fayyisiisa isaa lassa'a.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gosa biyya adda addaatiif ulfinna isaa,","poem":1},{"text":"kolbaa maratti hujii isaa ta maade'ee lassa'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mootiin Waan Maraa guddaa waan te'eef,","poem":1},{"text":"guddifamee leellifamuu male;","poem":2},{"lineBreak":true},{"text":"waaqota mara caalaa sodaatamuu male;","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"waaqoti gosa biyya adda addaa marti","poem":2},{"lineBreak":true},{"text":"waaqota dharaa ti;","poem":2},{"lineBreak":true},{"text":"Mootiin Waan Maraa ammoo ka ol-gubbaa dade.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ulfinnii fi arnyi fuula isaa dura,","poem":1},{"text":"jabeennii fi dansummaan","poem":2},{"lineBreak":true},{"text":"addee woyyittii isaa keessa jiran.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Maatiin gosa biyya adda addaa","poem":1},{"text":"Mootii Waan Maraa leellisa'a;","poem":2},{"lineBreak":true},{"text":"ulfinnaa fi jabeenna Mootii Waan Maraa leellisa'a.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ulfinna maqaa isaatiif te'u","poem":1},{"text":"Mootii Waan Maraatiif dhikeessa'a;","poem":2},{"lineBreak":true},{"text":"kennansa fida'aatii gara badhinna mana isaa kowa'a.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dansummaa woyyummaa isaatiif","poem":1},{"text":"Mootii Waan Maraa waaqonfadha'a;","poem":2},{"lineBreak":true},{"text":"nami lafa irraa marti fuula isaa duratti holladha'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Gosa biyya adda addaa maraan,","poem":1},{"text":"«Mootiin Waan Maraa mooti'i!","poem":2},{"lineBreak":true},{"text":"Biyyi lafaa jabaattee dhaabanteerti;","poem":2},{"lineBreak":true},{"text":"isiin ijjumaa hin tachootu;","poem":2},{"lineBreak":true},{"text":"inni kolbaa maraaf wol qixxee mura» jedha'a.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ol-gubbaan gammadduu ti;","poem":1},{"text":"lattille firinxiixxuu ti;","poem":2},{"lineBreak":true},{"text":"abbaaya'aa fi wonni isii keessalle shookkittuu ti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ficha'aa fi wonni isa keessaa marti gammadduu ti;","poem":1},{"text":"achiin duuba muki badda'aa marti ilillisaa hin faarsan.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mootiin Waan Maraa waan dhufuuf,","poem":1},{"text":"fuula isaa duratti ilillisaa faarsan;","poem":2},{"lineBreak":true},{"text":"inni lafatti muriisaaf hin dhufa.","poem":2},{"text":"Biyya lafaatitti balchumma'aan,","poem":1},{"text":"kolbaa maratti dhuga'aan hin mura.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}