{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":97,"content":[{"type":"heading","content":["Waaqa Bulchaa Ol Aanaa"]},{"type":"verse","number":1,"content":[{"text":"Mootiin Waan Maraa mooti'i!","poem":1},{"text":"Latti gammadduu ti;","poem":2},{"lineBreak":true},{"text":"isin worri oddoola abbaaya'aa","poem":2},{"lineBreak":true},{"text":"keessa jirtanulle gammada'a.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Duumensii fi dukkanti dimmi","poem":1},{"text":"isa marsaneeran;","poem":2},{"lineBreak":true},{"text":"balchumma'aa fi haqi","poem":2},{"lineBreak":true},{"text":"hundee mootummaa isaa ti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ibiddi dura isaa ideemaa,","poem":1},{"text":"diinota isa marsaneeranu mara guba.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Balaqqeettiin isaa biyya lafaa issiti;","poem":1},{"text":"lattille dhaggitee rommiti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mootii Waan Maraa ka lafa duudi'ii duratti,","poem":1},{"text":"gaarri akka gaga'aa hin baqa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ol-gubbaan balchummaa isaa lassiti;","poem":1},{"text":"kolbaan martille ulfinna isaa dhaggiti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Worri fakkii waaqonfatu,","poem":1},{"text":"ka waaqota dharaa gatii hin qanneen kooru marti","poem":2},{"lineBreak":true},{"text":"hin fokkifatan;","poem":2},{"lineBreak":true},{"text":"waaqoti marti isaaf jilbiiffatan.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ee Mootii Waan Maraa, marroo muraa teetii","poem":1},{"text":"worri Xiyoonii dhage'anee hin gammadan;","poem":2},{"lineBreak":true},{"text":"kolbaan Yihuda'aalle hin ilillitti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ee Mootii Waan Maraa,","poem":1},{"text":"ati lafa mara irratti Ol Aana'a;","poem":2},{"lineBreak":true},{"text":"ati waaqota mara caalta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Worri Mootii Waan Maraa jaalatu,","poem":1},{"text":"waan hantuu jibbuu ti;","poem":2},{"lineBreak":true},{"text":"inni lubbuu worra addatama'aa waan eeguuf,","poem":2},{"lineBreak":true},{"text":"harka worra hamaaleyyi'ii jalaa isaan hin baasa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ifi worra balcha'aaf,","poem":1},{"text":"gammaddi worra qajeela'aaf baya.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Isin balchooti Mootii Waan Maraatiin gammada'a;","poem":1},{"text":"maqaa isaa woyyicha leellisa'a.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}