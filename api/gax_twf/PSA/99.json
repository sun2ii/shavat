{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"PSA","translationId":"gax_twf","name":"Kitaaba Faaru'uu","commonName":"Kitaaba Faaru'uu","title":"Kitaaba Faaru'uu","order":19,"numberOfChapters":150,"sha256":"cc1345654e6f78d1854819e02bd9185ae577eb4ae1fef49d4bf17fea904d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gax_twf/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":99,"content":[{"type":"heading","content":["Waaqi Mootii Ol Aana'a"]},{"type":"verse","number":1,"content":[{"text":"Mootiin Waan Maraa mooti'i;","poem":1},{"text":"gosi biyya adda addaa hollattuu ti!","poem":2},{"text":"Inni barcumaa mootumma'aa irra","poem":1},{"text":"odduu dada ol-gubba'aa ta koola qaddu te'eera;","poem":2},{"lineBreak":true},{"text":"lattille tachootuu ti.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mootiin Waan Maraa Xiyoon keessatti gudda'a;","poem":1},{"text":"inni gosa biyya adda addaa irratti ol aana'a.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Maqaa keeti gudda'aa fi sodaatamaa leellisanuu ti.","poem":1},{"text":"Inni woyyu'u!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ati mootichi hunnaamessa;","poem":1},{"text":"ati haqa jaalata;","poem":2},{"lineBreak":true},{"text":"waan sirrii te'e hundeessiteerta;","poem":2},{"lineBreak":true},{"text":"Israa'el keessatti haqaa fi balchummaa hujjeerta.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mootii Waan Maraa Waaqa keenna saada'a;","poem":1},{"text":"miila isaa jalatti sagada'a!","poem":2},{"lineBreak":true},{"text":"Inni woyyu'u!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hayyoota isaa keessaa gariin Muuse'ee fi Aaron;","poem":1},{"text":"worra maqaa isaa waame keessaa tokkochi Saamu'el;","poem":2},{"lineBreak":true},{"text":"isaan maqaa Mootii Waan Maraa waammatane;","poem":2},{"lineBreak":true},{"text":"innille isaaniif deebii kenne.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni utubaa duumensaa keessaa isaanitti dubbate;","poem":1},{"text":"isaanille qajeelfamaa fi","poem":2},{"lineBreak":true},{"text":"seerata inni isaaniif kenne eegatane.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ee Mootii Waan Maraa Waaqa keenna,","poem":1},{"text":"ati deebii isaaniif kennite;","poem":2},{"lineBreak":true},{"text":"cubbuu isaaniitiif haluu isaan baatulle,","poem":2},{"lineBreak":true},{"text":"ati Waaqa araaraa isaaniif teeteerta.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"Waaqi keenna woyyuu waan te'eef,","poem":2},{"lineBreak":true},{"text":"isa saada'a;","poem":2},{"lineBreak":true},{"text":"gaara isaa woyyicha irratti isa waaqonfadha'a.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}