{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"SNG","translationId":"gax_twf","name":"Kitaaba Faaruu Solomoonii","commonName":"Kitaaba Faaruu Solomoonii","title":"Kitaaba Faaruu Solomoonii","order":22,"numberOfChapters":8,"sha256":"6348619c0fa7cc396259b070524b61b871004dbc455c80b85ea3ce801f50556a","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gax_twf/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Faaruu Solomoonii ta faaruu mara caaltu."]},{"type":"heading","content":["Faaruu Qaraa"]},{"type":"verse","number":2,"content":[{"text":"«Jaalalli keeti daadhii woyni'ii waan caaluuf,","poem":1},{"text":"afaan kiyya keessa na sunqadhu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Fooleen fiqiree teetii hin uddootti;","poem":1},{"text":"maqaan keeti akka fiqiree dhangalaatuu ti;","poem":2},{"lineBreak":true},{"text":"tanaaf durri marti si jaalatti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Na fudhadhuu deemi! Ariifannuu ti;","poem":1},{"text":"ee, mooticha gara kolloo teetii na geessi.","poem":2},"Jaaloti",{"text":"Nuuti si'iin firinxiindhee hin gammanna;","poem":1},{"text":"daadhii woyni'ii caalaa jaalala keeti leellinna;","poem":2},{"lineBreak":true},{"text":"dubartooti marti dhuguma si jaalatan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ee, durra Yerusaalemii!","poem":1},{"text":"Ani gurraattii te'ulle,","poem":2},{"lineBreak":true},{"text":"akka dunkaanii Qedaarii,","poem":2},{"lineBreak":true},{"text":"akka gollaa mana mootummaa Solomoonii miidhaga.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani gurraattii waan te'eef,","poem":1},{"text":"aduun waan na gurraachessiteef,","poem":2},{"lineBreak":true},{"text":"na hin daaw'atina'a!","poem":2},{"text":"Obboleeyyan tiyya natti aaranee,","poem":1},{"text":"oorruu muka woyni'ii akka eegu na godhane;","poem":2},{"lineBreak":true},{"text":"muka woyni'ii kiyya ani hin eeganne.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Jaala kiyya ka lubbu'uu!","poem":1},{"text":"Hoolee teeti eessa akka tiffattu,","poem":2},{"lineBreak":true},{"text":"Waareelle eessatti akka boqachiifattu natti himi.","poem":2},{"text":"Ani maaniif hoolee jaalota teetii bira","poem":1},{"text":"akka dubartii fuula hagooggattee joonja?» jette.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ati ta dubartii mara caalaa miidhaddu!","poem":1},{"text":"Yoo hin beenne teete,","poem":2},{"lineBreak":true},{"text":"hoolee gula ideemi!","poem":2},{"lineBreak":true},{"text":"Ilmoolee re'e'ee teeti","poem":2},{"lineBreak":true},{"text":"dunkaanii tissitootaa bira dheechifadhu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Obboleettii tiyya!","poem":1},{"text":"Ati fardoo garreettaa fardaan harkifamu harkisanu","poem":2},{"lineBreak":true},{"text":"ka Fara'oonii keessaa","poem":2},{"lineBreak":true},{"text":"akka farda tokkoo ti.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mallaan teeti seesaan,","poem":1},{"text":"mormi keetille dooqaan miidhageera.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ani","poem":1},{"noteId":0},{"text":"worqii gurraa,","poem":1},{"text":"ta meeti'iin seefante hujisiisa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mootiin areerratiisatti jiruun,","poem":1},{"text":"fiqireen tiyya uddaa ifii fiqqitte.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Jaalalleen kiyya akka subba qumbi'ii ti;","poem":1},{"text":"inni odduu harma kiyyaa boqata.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jaalalleen kiyya naaf akka daraaraa uddowu,","poem":1},{"text":"ka addee muka woyni'ii","poem":2},{"lineBreak":true},{"text":"ka madda En-Gedii keessaa ti.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ee, jaalallee tiyya, ati attam attam miidhadda!","poem":1},{"text":"Ee, attam attam miidhadda!","poem":2},{"lineBreak":true},{"text":"Ilti teeti akka ila saphaliisaa ti.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Jaalallee kiyya, ati attam attam miidhadda!","poem":1},{"text":"Ati attam attam nama gammachiitta!","poem":2},{"lineBreak":true},{"text":"Taqeen teenna akka marra bisile'ee ti.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Utubaan mana keennaa muka hindheensaa ti;","poem":1},{"text":"dagaleen isaalle muka birbirsaa ti.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Ani: Afaan Ibrootaatiin «Nuuti» Jedha. Nuuti jechuun isaa akka mootichi ifi himu.","reference":{"chapter":1,"verse":11}}]},"thisChapterLink":"/api/gax_twf/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}