{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"SNG","translationId":"gax_twf","name":"Kitaaba Faaruu Solomoonii","commonName":"Kitaaba Faaruu Solomoonii","title":"Kitaaba Faaruu Solomoonii","order":22,"numberOfChapters":8,"sha256":"6348619c0fa7cc396259b070524b61b871004dbc455c80b85ea3ce801f50556a","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gax_twf/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Ani akka daraaraa lafa Sharoniitii fi","poem":1},{"text":"akka daraaraa dhooqa keessaa ti.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jaalalleen tiyya dubartoota oddu'utti","poem":1},{"text":"akka daraaraa qoree odduu jiruu ti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jaalalleen kiyya dargaggoota oddu'utti,","poem":1},{"text":"akka muka appili'ii ka baddaa keessa jiruu ti.","poem":2},{"text":"Ani gaaddisa isaa jala tee'iisatti hin gammada;","poem":1},{"text":"midhaan isaalle afaan kiyyatti hin mi'owa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inni gara mana gammadaa na geesse;","poem":1},{"text":"beessisi jaalala isaa na irra jira.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ani jaalala isaatiin qabame waan gaggabeef,","poem":1},{"text":"midhaan woyni'ii nyaachisa'aatii na jabeessa'a;","poem":2},{"lineBreak":true},{"text":"midhaan muka appili'iitiin na gammachiisa'a.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Harki isaa bitaachi mataa kiyya jala adoo jiraataa;","poem":1},{"text":"harki isaa middichi adoo na hanqafataa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ee dubartoota Yerusaalemii,","poem":1},{"text":"haga inni fedhuma ifiitiin ka'utti,","poem":2},{"lineBreak":true},{"text":"jaalallee kiyya tirtirsitanee akka hin dammassine,","poem":2},{"lineBreak":true},{"text":"ani maqaa jilibaa yookiin gadansa badda'aatiin,","poem":2},{"lineBreak":true},{"text":"isin magannifadha.","poem":2}]},{"type":"heading","content":["Faaruu Lammeesso'oo"]},{"type":"verse","number":8,"content":[{"text":"Kunoo, jaalalleen kiyya,","poem":1},{"text":"gaarota irra u'utaalaa,","poem":2},{"lineBreak":true},{"text":"koobota irra burraaqaa dhufuun qoonqoo dhage'a.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jaalalleen kiyya jilibaa yookiin","poem":1},{"text":"ilmoolee gadansaa fakkaata.","poem":2},{"text":"Kunoo inni dalleya mana keennaa duuba dhaabbata;","poem":1},{"text":"qowa dalleyaatiin,","poem":2},{"lineBreak":true},{"text":"fodda'aan gara keessaa ilaaliisatti jira.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Jaalalleen kiyya natti dubbatee,","poem":1},{"text":"«Jaalallee tiyya, dansittii tiyya!","poem":2},{"lineBreak":true},{"text":"Koy, woliin ideenna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kunoo, ganni dabareera;","poem":1},{"text":"bokkeenni roobuu lakkisee caameera.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Daraaraan baquu jalqabeera;","poem":1},{"text":"yennaan faaruu faarfatanu geetteerti;","poem":2},{"lineBreak":true},{"text":"qoonqoon saphaliisaa lafa teenna keessatti","poem":2},{"lineBreak":true},{"text":"dhage'anteerti.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Harruun midhaanotteerti;","poem":1},{"text":"woyniille daraartee uddootteerti.","poem":2},{"text":"Jaalallee tiyya, dansittii tiyya!","poem":1},{"text":"Ka'i, woliin ideenna» naan jedhe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ee, saphaliisa tiyya,","poem":1},{"text":"ta holla dhakaa keessaa,","poem":2},{"lineBreak":true},{"text":"ta addee dhokata gaara keessaa,","poem":2},{"lineBreak":true},{"text":"fuula keeti natti mudhisi;","poem":2},{"lineBreak":true},{"text":"qoonqoo teeti na dhageessis;","poem":2},{"lineBreak":true},{"text":"qoonqoon teeti natti tolti;","poem":2},{"lineBreak":true},{"text":"fuulli keeti natti miidhaga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Jeedalootaa fi ilmoolee jeedalootaa","poem":1},{"text":"worra woynii teenna ta daraariisatti jirtu","poem":2},{"lineBreak":true},{"text":"nu duraa balleessu, nuu qaba'a.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Jaalalleen kiyya, kiyyuma;","poem":1},{"text":"anille ta isaa ti;","poem":2},{"lineBreak":true},{"text":"inni daraaraa dansaa keessa horii tissa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ee jaalallee kiyya! Adoo boruun hin dayya'in,","poem":1},{"text":"aduun adoo hin bayin,","poem":2},{"lineBreak":true},{"text":"akka jiliba'aa yookiin","poem":2},{"lineBreak":true},{"text":"akka ilmoolee gadansaa,","poem":2},{"lineBreak":true},{"text":"gaara bu'aa bayii qabu irra","poem":2},{"lineBreak":true},{"text":"utaalaa gara kiyya koy.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}