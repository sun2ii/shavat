{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"SNG","translationId":"gax_twf","name":"Kitaaba Faaruu Solomoonii","commonName":"Kitaaba Faaruu Solomoonii","title":"Kitaaba Faaruu Solomoonii","order":22,"numberOfChapters":8,"sha256":"6348619c0fa7cc396259b070524b61b871004dbc455c80b85ea3ce801f50556a","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gax_twf/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Ani halkan guutuu taqee tiyya irratti","poem":1},{"text":"jaala kiyya ka lubbu'uu barbaade;","poem":2},{"lineBreak":true},{"text":"ani isa barbaade ammoo hin dhaggine.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ani amma ka'ee qachaa keessa,","poem":1},{"text":"karaa irra, woldeennaa kara'aa irra deddeemee,","poem":2},{"lineBreak":true},{"text":"jaala kiyya ka lubbu'uu hin barbaada;","poem":2},{"lineBreak":true},{"text":"ani barbaade ammoo isa hin dhaggine.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Worri qachaa eegu adoo asii fi achi deemanuu,","poem":1},{"text":"na dhaggane;","poem":2},{"lineBreak":true},{"text":"anille, «Jaala kiyya ka lubbu'uu","poem":2},{"lineBreak":true},{"text":"dhaggitaneertanii?» jedhee gaafadhe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isaan irra akkuma dabareen,","poem":1},{"text":"jaala kiyya ka lubbu'uu san dhaggee,","poem":2},{"lineBreak":true},{"text":"isa qabadhe;","poem":2},{"lineBreak":true},{"text":"gara mana haadha tiyyaa,","poem":2},{"lineBreak":true},{"text":"gara kolloo haadha na deetteetitti","poem":2},{"lineBreak":true},{"text":"haga isa geeffadhutti gad isa hin lakkinne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee dubartoota Yerusaalemii,","poem":1},{"text":"haga inni fedhuma ifiitiin ka'utti,","poem":2},{"lineBreak":true},{"text":"jaalallee kiyya tirtirsitanee akka hin dammassine,","poem":2},{"lineBreak":true},{"text":"ani maqaa jilibaa yookiin gadansa badda'aatiin,","poem":2},{"lineBreak":true},{"text":"isin magannifadha.","poem":2}]},{"type":"heading","content":["Faaruu Sadeesso'oo"]},{"type":"verse","number":6,"content":[{"text":"Ka lafa goomole'ee keessaa","poem":1},{"text":"akka duumensa aaraa","poem":2},{"lineBreak":true},{"text":"ol bayiisatti jiru,","poem":2},{"lineBreak":true},{"text":"ka akka fiqiree qumbi'ii fi hixaanaan","poem":2},{"lineBreak":true},{"text":"daldaltooti uddowaa mara irraa hujattee kun eennu?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kunoo, barcumaan mootumma'aa","poem":1},{"noteId":1},{"text":"ka Solomoonii,","poem":1},{"text":"loltoota hunnaameyyii Israa'elii","poem":2},{"lineBreak":true},{"text":"keessaa ta filatante jaatamaan marfameera.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Marti isaaniituu shallaagaa hidhatan;","poem":1},{"text":"martinuu muuxannoo lolaa qaban;","poem":2},{"lineBreak":true},{"text":"bidhaa halkaniitiif","poem":2},{"lineBreak":true},{"text":"tokko tokkoon isaanii shallaagaa hidhataneeran.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mootichi Solomoon muka Libaanonii irraa,","poem":1},{"text":"barcumaa mootumma'aa ka ifii hujisiifate.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Miilli barcumaa mootumma'aa sanii meetii irraa,","poem":1},{"text":"irkoon isaa worqii irraa,","poem":2},{"lineBreak":true},{"text":"addeen tee'iisaa woyaa dhiille'een gonfameera;","poem":2},{"lineBreak":true},{"text":"keessa isaa dubartoota Yerusaalemiititti seesee huje.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ee Dubartoota Yerusaalemii,","poem":1},{"text":"dhaqa'aatii kallacha Solomoonii mootichaa,","poem":2},{"lineBreak":true},{"text":"ka haati isaa guyyaa fuudha isaa,","poem":2},{"lineBreak":true},{"text":"guyyaa gadhaan isaa gammadetti","poem":2},{"lineBreak":true},{"text":"itti keette ilaala'a.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Barcumaa mootumma'aa: Barcumaan mootumma'aa kun ka kolbaan Solomoon ittiin ba'attee asii fi achi ideentu.","reference":{"chapter":3,"verse":7}}]},"thisChapterLink":"/api/gax_twf/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}