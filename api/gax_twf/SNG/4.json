{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"SNG","translationId":"gax_twf","name":"Kitaaba Faaruu Solomoonii","commonName":"Kitaaba Faaruu Solomoonii","title":"Kitaaba Faaruu Solomoonii","order":22,"numberOfChapters":8,"sha256":"6348619c0fa7cc396259b070524b61b871004dbc455c80b85ea3ce801f50556a","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gax_twf/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Jaalallee tiyya, ati attam attam dansitti'i!","poem":1},{"text":"Ee, ati attam attam dansitti'i!","poem":2},{"text":"Ilti teeti shaashii ati hagooggattu keessaa,","poem":1},{"text":"akka ila saphaliisaa kuulle'e;","poem":2},{"lineBreak":true},{"text":"rifeensi mataa keetii","poem":2},{"lineBreak":true},{"text":"re'oota gaara Giil'aadii irraa","poem":2},{"lineBreak":true},{"text":"gad yaa'anu fakkaata.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ilkaan keeti akka hoolota adii","poem":1},{"text":"yennaa rifeensi isaanii muramu","poem":2},{"lineBreak":true},{"text":"nafi isaanii dhiqamee bisaan keessaa bayanuu ti;","poem":2},{"lineBreak":true},{"text":"hooloti tun martinuu lakkuu dhalti;","poem":2},{"lineBreak":true},{"text":"maseenti takkaalle isaan keessa hin jirtu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hidhiin teeti haarrii diintuu fakkaatti;","poem":1},{"text":"haasonni keeti namatti tola.","poem":2},{"text":"Mallaan teeti shaashii ati hagooggattu keessaa,","poem":1},{"text":"midhaan rumaanii ka gargar baqaqe fakkaata.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mormi keeti xelleephoo Daawitii,","poem":1},{"text":"ta wonteen gugurdoon kum tokko,","poem":2},{"lineBreak":true},{"text":"wonteen goototaa martinuu","poem":2},{"lineBreak":true},{"text":"itti fannifamanu fakkaata.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Harmi keeti lamaanuu jilibaa ilmoolee,","poem":1},{"text":"lakkuu jilibaa ilmoole'ee,","poem":2},{"lineBreak":true},{"text":"ta daraaraa keessa dheeddu fakkaata.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Adoo boruun hin dayya'in,","poem":1},{"text":"aduun adoo hin bayin,","poem":2},{"lineBreak":true},{"text":"ani gara gaara qumbi'iitii fi","poem":2},{"lineBreak":true},{"text":"gara kooba hixaanaa hin dhaqa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Jaalallee tiyya, ati attam attam dansitti'i!","poem":1},{"text":"Womaa dhidhinna hin qaddu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Waajibittii tiyya, Libaanon irraa gara kiyya koy!","poem":1},{"text":"Libaanon irraa gara kiyya koy!","poem":2},{"text":"Qaccee gaara Amaanaa irraa,","poem":1},{"text":"qaccee gaara Siinaariitii fi Hermoonii,","poem":2},{"lineBreak":true},{"text":"goda neenqaa,","poem":2},{"lineBreak":true},{"text":"koobota qeeransaa irralle gad bu'i.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Obboleettii tiyya, waajibittii tiyya!","poem":1},{"text":"Ati midhuu teeti takkatti'iin,","poem":2},{"lineBreak":true},{"text":"dirata morma keetiitiin","poem":2},{"lineBreak":true},{"text":"qalbii tiyya boojite.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Obboleettii tiyya, waajibittii tiyya!","poem":1},{"text":"Jaalalli keeti attam attam nama gammachiisa!","poem":2},{"lineBreak":true},{"text":"daadhii woyni'ii caalaa","poem":2},{"lineBreak":true},{"text":"attam attam gabbi nama godha!","poem":2},{"text":"Fooleen fiqiree teetii uddowaa mara caalti.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Waajibittii tiyya!","poem":1},{"text":"Hidhiin teeti akka dhaaba dammaa","poem":2},{"lineBreak":true},{"text":"nadhii coccossiti;","poem":2},{"lineBreak":true},{"text":"aananii fi dammi arraba keeti jala jiran;","poem":2},{"lineBreak":true},{"text":"fooleen woyaa teetii akka foolee","poem":2},{"lineBreak":true},{"text":"hindheensa Libaanonii ti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Obboleettii tiyya, waajibittii tiyya!","poem":1},{"text":"Ati akka oorruu itti ijaaramee ti;","poem":2},{"lineBreak":true},{"text":"akka madda dalleyaan marfameetii fi","poem":2},{"lineBreak":true},{"text":"akka burqaa cuqqaalamee ti.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ati akka oorruu muka rumaanii,","poem":1},{"text":"ka midhaan dansaa buusu,","poem":2},{"lineBreak":true},{"text":"ka daraaraan uddowuu fi","poem":2},{"lineBreak":true},{"text":"biqiltuun naardoosii achi keessa jiranuu ti.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Muki Naardoosii, biqiltuun uddoottu,","poem":1},{"text":"marri uddowu, qarafaan,","poem":2},{"lineBreak":true},{"text":"muki hixaanaa, muki qumbi'ii,","poem":2},{"lineBreak":true},{"text":"daraaraan hargiisaatii fi","poem":2},{"lineBreak":true},{"text":"uddowaan dansaan adda addaa marti","poem":2},{"lineBreak":true},{"text":"achi keessa jiran.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ati akka burqaa bisaan addee oorru'uu,","poem":1},{"text":"ka boolla keessaa yaa'u,","poem":2},{"lineBreak":true},{"text":"bisaan gaara Libaanoniitii gad yaa'uu ti.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ee, qilleensa kaabaa dammaqi!","poem":1},{"lineBreak":true},{"text":"Ee, qilleensa kibbaa koy!","poem":1},{"lineBreak":true},{"text":"Oorruu tiyyatti qilleensi;","poem":1},{"text":"fooleen isi'ii uddoottuun fiqittuu ti.","poem":2},{"text":"Jaalalleen kiyya gara oorruu ifii dhufee","poem":1},{"text":"midhaan oorruu ifii dansaa nyaatuu ti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}