{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"SNG","translationId":"gax_twf","name":"Kitaaba Faaruu Solomoonii","commonName":"Kitaaba Faaruu Solomoonii","title":"Kitaaba Faaruu Solomoonii","order":22,"numberOfChapters":8,"sha256":"6348619c0fa7cc396259b070524b61b871004dbc455c80b85ea3ce801f50556a","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gax_twf/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Obboleettii tiyya, waajibittii tiyya!","poem":1},{"text":"Ani gara oorruu tiyyaa dhufeera;","poem":2},{"lineBreak":true},{"text":"qumbii tiyyaa fi uddowaa kiyya wolitti qabadheera;","poem":2},{"lineBreak":true},{"text":"nadhii dhaaba damma kiyyaa nyaadheera;","poem":2},{"lineBreak":true},{"text":"daadhii woyni'ii tiyyaa fi aanan kiyya uneera.","poem":2},"Jaaloti",{"text":"Nyaadha'a, jaalota, una'a, jaalalaan machowa'a!","poem":1}]},{"type":"heading","content":["Faaruu Arfeesso'oo"]},{"type":"verse","number":2,"content":[{"text":"Ani rafeera; yaadi kiyya ammoo rafee hin jiru;","poem":1},{"text":"jaalalleen kiyya balbala dhodhowaa,","poem":2},{"lineBreak":true},{"text":"«Obboleettii tiyya, jaalallee tiyya!","poem":2},{"lineBreak":true},{"text":"Saphaliisa tiyya, ta dhidhinna hin qanne, naa bani!","poem":2},{"text":"Mataan kiyya fixeensaan,","poem":1},{"text":"rifeensi mataa kiyyaalle","poem":2},{"lineBreak":true},{"text":"dabana halkaniitiin jiidheera» jedhuun dhage'e.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ani ammoo, «Woyaa tiyya baafadheeraa,","poem":1},{"text":"attam deebisee uffadha ree?","poem":2},{"text":"Ani miila kiyya dhiqadheera,","poem":1},{"text":"attam deebisee xureessa ree?» jedheen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Jaalalleen kiyya karaa qowaatiin","poem":1},{"text":"harka ifii gara keessaa keye;","poem":2},{"lineBreak":true},{"text":"gadhaan kiyya isaaf na raafame.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ani jaalallee kiyyaaf balbala baniisaaf ka'ee,","poem":1},{"text":"harka kiyyaan qabannoo cufana'aa yennaa qabadhe,","poem":2},{"lineBreak":true},{"text":"fiqireen qumbi'ii harka kiyya irraa coccoxxee,","poem":2},{"lineBreak":true},{"text":"qabannoo san irratti dhangalaate.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani jaalallee kiyyaaf balbala bane;","poem":1},{"text":"inni ammoo deebi'ee deemeera.","poem":2},{"text":"Yennaa inni dubbate san,","poem":1},{"text":"gadhaan na rifate.","poem":2},{"text":"Ani isa barbaade;","poem":1},{"text":"ammoo hin dhaggine.","poem":2},{"text":"Ani isa waame;","poem":1},{"text":"inni na jalaa hin owwaanne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Namooti asii fi achi deemaa qachaa eeganu","poem":1},{"text":"na dhaggane;","poem":2},{"lineBreak":true},{"text":"isaan dikanee na madeessane;","poem":2},{"lineBreak":true},{"text":"eeddoti dalleya qacha'aa","poem":2},{"lineBreak":true},{"text":"woyaa tiyya na irraa mulqane.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ee, dubartoota Yerusaalemii,","poem":1},{"text":"jaalallee kiyya yennaa dhaggitane,","poem":2},{"lineBreak":true},{"text":"maan isatti hintan seetan?","poem":2},{"text":"Ani jaalala isaatiin akka dhibameeru,","poem":1},{"text":"itti naa hima'a.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ati ta dubartoota mara caalaa dansittii teete!","poem":1},"Jaalalleen keeti worra kaan ka attam caalu inni?",{"text":"Ati akkas ka nu magannifattu,","poem":2},{"lineBreak":true},{"text":"jaalalleen keeti worra kaan ka attam caalu inni?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Jaalalleen kiyya diimaa hargiisa;","poem":1},{"text":"inni nama kuma kudhan keessalle'etti hin mudhata.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Buqqiin mataa isaa worqii qulluu fakkaatti;","poem":1},{"text":"rifeensi mataa isaa luuccaa,","poem":2},{"lineBreak":true},{"text":"gurraacha akka harraaqessaa ti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ilti isaa akka saphaliisa adii","poem":1},{"text":"madda bisaanii bira tee'uu,","poem":2},{"lineBreak":true},{"text":"ka akka waan aananiin dhiqatee","poem":2},{"lineBreak":true},{"text":"addaatuu,","poem":2},{"lineBreak":true},{"text":"akka dooqaa jirti.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mallaan isaa akka oorruu uddowa'aa ti;","poem":1},{"text":"hidhiin isaa akka daraaraa","poem":2},{"lineBreak":true},{"text":"fiqiree qumbi'ii dhangalaasuu ti.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Harki isaa ulee worqi'ii","poem":1},{"text":"ta dooqaan seefante fakkaata;","poem":2},{"lineBreak":true},{"text":"nafi isaa ilka arbaa","poem":2},{"lineBreak":true},{"text":"ka dhakaa, «Safiiros» jedhamuun","poem":2},{"lineBreak":true},{"text":"seefame fakkaata.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Miilli isaa utubaa cabbii cululuxxu'uu,","poem":1},{"text":"ka worqii qulluu irra dhaabbatu fakkaata.","poem":2},{"text":"Inni gaara Libaanonii fakkaata;","poem":1},{"text":"akka hindheensa Libaanonii","poem":2},{"lineBreak":true},{"text":"ka mara caalaa filatame.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Haasonni isaa guddoo mi'owa;","poem":1},{"text":"inni guddoo jaalatama'a.","poem":2},{"text":"Ee, dubartoota Yerusaalemii,","poem":1},{"text":"jaalalleen kiyya, jaalli kiyya isa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}