{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"SNG","translationId":"gax_twf","name":"Kitaaba Faaruu Solomoonii","commonName":"Kitaaba Faaruu Solomoonii","title":"Kitaaba Faaruu Solomoonii","order":22,"numberOfChapters":8,"sha256":"6348619c0fa7cc396259b070524b61b871004dbc455c80b85ea3ce801f50556a","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gax_twf/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"heading","content":["Dubartooti Jaaloti Waajibitti'ii"]},{"type":"verse","number":1,"content":[{"text":"Ati ta dubartoota caalaa dansittii teete!","poem":1},{"text":"Jaalalleen keeti eessa dhaqe?","poem":2},{"text":"Akka si woliin barbaannu,","poem":1},{"text":"karaa kam gore?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jaalalleen kiyya horii tiffatiisaaf,","poem":1},{"text":"daraaraalle guuratiisaaf,","poem":2},{"lineBreak":true},{"text":"gara oorruu uddowaa ifii gad dhaqeera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ani ta jaalallee kiyyaa ti; innille kiyya;","poem":1},{"text":"inni odduu daraara'aa horii tissa.","poem":2}]},{"type":"heading","content":["Faaruu Shaneesso'oo"]},{"type":"verse","number":4,"content":[{"text":"Ee, jaalallee tiyya,","poem":1},{"text":"ati akka qachaa Tiiza'aa miidhadda;","poem":2},{"lineBreak":true},{"text":"akka qachaa Yerusaalemii tolta;","poem":2},{"lineBreak":true},{"text":"akka loltoota baandiraa qabatanee deemanuu","poem":2},{"lineBreak":true},{"text":"arnya qadda.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ilti teeti waan na boojiteef,","poem":1},{"text":"na irraa deebifadhu!","poem":2},{"text":"Rifeensi mataa keetii re'oota","poem":1},{"text":"gaara Giil'aadii irraa gad yaatu fakkaata.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ilkaan keeti akka hoolota adii","poem":1},{"text":"dhiqamanee bisaan keessaa bayanuu addaata;","poem":2},{"lineBreak":true},{"text":"hooloti tun martinuu lakkuu dhalti malee","poem":2},{"lineBreak":true},{"text":"isaan keessa maseenti hin jirtu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mallaan teeti lamaan","poem":1},{"text":"shaashii ati hagooggattu keessaa,","poem":2},{"lineBreak":true},{"text":"midhaan rumaanii ka gargar baqaqe fakkaatti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Giittoti jaatamaa fi gursumeeyyiin saddeettami,","poem":1},{"text":"durri laakkossi isaanii haga hin qanne,","poem":2},{"lineBreak":true},{"text":"jiraachuu dande'an.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Saphaliisi tiyya","poem":1},{"text":"ta anaaf dhidhinna hin qanne isii qofa;","poem":2},{"lineBreak":true},{"text":"isiin haadha ifiitiif takkatti'i;","poem":2},{"lineBreak":true},{"text":"ta isii deette isii jaalatti.","poem":2},{"text":"Ijoolleen durraa isii dhagganee","poem":1},{"text":"«Ati ta leellifante» jedhaneen;","poem":2},{"lineBreak":true},{"text":"giittotii fi gursumeeyyiille isii leellisane.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta akka boruu dayya'uu mudhattu,","poem":1},{"text":"ta akka ji'aa miidhaddu,","poem":2},{"lineBreak":true},{"text":"ta akka adu'uu issitu,","poem":2},{"lineBreak":true},{"text":"ta akka loltoota baandiraa qabatanuu","poem":2},{"lineBreak":true},{"text":"arnya qaddu tun eennu?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ani muki woyni'ii akka quunxe,","poem":1},{"text":"muki rumaaniille akka guntute ilaaliisaaf,","poem":2},{"lineBreak":true},{"text":"gara dhooqa oorruu muka, «Almond» jedhamuu","poem":2},{"lineBreak":true},{"text":"gad dhaqe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Adoo ani hin beekin halchaan tiyya na buttee,","poem":1},{"text":"garreettaa fardaan harkifamu","poem":2},{"lineBreak":true},{"text":"ka qondaaltota kolbaa tiyyaa keessa na keette.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ee, Shulaamitti'i! Deebi'i, deebi'i!","poem":1},{"text":"Akka nuuti si ilaalluuf, deebi'i, deebi'i!","poem":2},"Waajibichi",{"text":"Akka nama sirba darabaa lamaa ilaaluu,","poem":1},{"text":"Shulaamittii tana isin maaf ilaaltan?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}