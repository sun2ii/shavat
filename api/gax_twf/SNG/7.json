{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"SNG","translationId":"gax_twf","name":"Kitaaba Faaruu Solomoonii","commonName":"Kitaaba Faaruu Solomoonii","title":"Kitaaba Faaruu Solomoonii","order":22,"numberOfChapters":8,"sha256":"6348619c0fa7cc396259b070524b61b871004dbc455c80b85ea3ce801f50556a","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gax_twf/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Ee, intala qondaalaa!","poem":1},{"text":"Miilli keeti kophee bexxellicha keessaa,","poem":2},{"lineBreak":true},{"text":"attam attam dansa'a!","poem":2},{"text":"Baarreen tafa keetii dooqa","poem":1},{"text":"harki nama hujii harkaa beeku huje fakkaata.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Handhurti teeti kuruurruu","poem":1},{"text":"akka qorii daadhiin woyni'ii keessaa hin dhabannee fakkaatti.","poem":2},{"text":"Uffaan keeti tuulaa qamadi'ii","poem":1},{"text":"ta daraaraan itti naanneffame fakkaata.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Harmi keeti lamaanuu","poem":1},{"text":"lakkuu ilmoolee jiliba'aa fakkaata.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mormi keeti xelleephoo","poem":1},{"text":"ilka arbaa irraa hujante fakkaata.","poem":2},{"text":"Ilti teeti lamaanuu baleessa Heshiboonii","poem":1},{"text":"ka karra Batraabiimii biraa fakkaatan.","poem":2},{"text":"Funnaan keeti xelleephoo Libaanonii","poem":1},{"text":"ta gara Damaasqo'oo fuula galteertu fakkaata.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mataan keeti gaara Qarmelosii fakkaata;","poem":1},{"text":"rifeensi mataa keetiille","poem":2},{"lineBreak":true},{"text":"maraa haarrii dhiille'ee fakkaata;","poem":2},{"lineBreak":true},{"text":"mootichille shurrubbaa kanaan booji'ameera.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ee, jaalallee tiyya!","poem":1},{"text":"Ati attam attam miidhadda!","poem":2},{"lineBreak":true},{"text":"Ati attam attam tolta!","poem":2},{"lineBreak":true},{"text":"Attam attam nama gammachiitta!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hojjaan teeti muka meexxi'ii,","poem":1},{"text":"harmi keeti unkuruura isi'ii fakkaata.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ani, «Muka meexxi'ii san hin yaaba;","poem":1},{"text":"damee isaa hin qabadha» jedhe.","poem":2},{"text":"Harmi keeti akka unkuruura woyni'ii,","poem":1},{"text":"fooleen hafuura keetii","poem":2},{"lineBreak":true},{"text":"akka foolee muka appili'ii teetuu ti.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fooleen afaan keetiille","poem":2},{"lineBreak":true},{"text":"akka foolee daadhii woyni'ii dansa'aa teetuu ti.","poem":2},"Waajibittii",{"text":"Daadhiin woyni'ii sun","poem":1},{"text":"hidhi'ii fi ilkaan jaalallee kiyyaa keessa dabartee,","poem":2},{"lineBreak":true},{"text":"laana gad buutuu ti.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani ta jaalallee kiyyaa ti;","poem":1},{"text":"inni na halcha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jaalallee kiyya, koy!","poem":1},{"text":"Baadiyyaa dhandhee,","poem":2},{"lineBreak":true},{"text":"ollaa keessa bullaa ti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Barii ganamaan kaanee,","poem":1},{"text":"gara addee muka woyni'ii dhandhee,","poem":2},{"lineBreak":true},{"text":"muki woyni'ii guntutee akka baqe,","poem":2},{"lineBreak":true},{"text":"muki rumaaniille akka daraare ilaalla!","poem":2},{"text":"Ani achitti jaalala kiyya si'iif hin kenna.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Midhaan muka fedhii jaalalaa kakkaasu","poem":1},{"text":"hin uddowa;","poem":2},{"lineBreak":true},{"text":"ee, jaalallee kiyya,","poem":2},{"lineBreak":true},{"text":"midhaan dadansaan marti,","poem":2},{"lineBreak":true},{"text":"ka amma guuramee fi ka bilchaate,","poem":2},{"lineBreak":true},{"text":"ka ani si'iif lafa keyeeru","poem":2},{"lineBreak":true},{"text":"balbala teenna dura jiran.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}