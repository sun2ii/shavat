{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"SNG","translationId":"gax_twf","name":"Kitaaba Faaruu Solomoonii","commonName":"Kitaaba Faaruu Solomoonii","title":"Kitaaba Faaruu Solomoonii","order":22,"numberOfChapters":8,"sha256":"6348619c0fa7cc396259b070524b61b871004dbc455c80b85ea3ce801f50556a","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gax_twf/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Ati adoo obboleessa kiyya","poem":1},{"text":"ka harma haadha tiyyaa hodhe, naaf teetee,","poem":2},{"lineBreak":true},{"text":"ani karaa irratti si dhaggee,","poem":2},{"lineBreak":true},{"text":"adoo si sunqadhee jiraadhe,","poem":2},{"lineBreak":true},{"text":"silaa eennulle na hin tuffatuuyyu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ani silaa gara mana haadha tiyyaa,","poem":1},{"text":"ta na barsiittee si geessee,","poem":2},{"lineBreak":true},{"text":"daadhii woyni'ii dansaa sii kennee,","poem":2},{"lineBreak":true},{"text":"cunfaa midhaan muka rumaaniille","poem":2},{"lineBreak":true},{"text":"si obaasaayyu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Harki isaa bitaachi","poem":1},{"text":"mataa kiyya jala adoo jiraataa;","poem":2},{"lineBreak":true},{"text":"harki isaa middichi adoo na hanqafata.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ee, dubartoota Yerusaalemii,","poem":1},{"text":"jaalalleen kiyya haga inni fedhuma ifiitiin ka'utti,","poem":2},{"lineBreak":true},{"text":"akka isa hin dammassine,","poem":2},{"lineBreak":true},{"text":"ani isin kadhadha.","poem":2}]},{"type":"heading","content":["Faaruu Jayeesso'oo"]},{"type":"verse","number":5,"content":[{"text":"Ta jaalallee ifii qabattee,","poem":1},{"text":"goomolee keessaa ol bayiisatti jirtu tun eennu?","poem":2},"Waajibittii",{"text":"Ani muka appili'ii jalaa si kaase;","poem":1},{"text":"haati teeti achitti ulfoottee,","poem":2},{"lineBreak":true},{"text":"isiin achitti ciniinsifattee si deette.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Akka chaappa'aatitti gadhaa keeti keessatti,","poem":1},{"text":"irree teeti irralle'etti na mallatteeffadhu.","poem":2},{"text":"Jaalalli akka du'aa jabaata;","poem":1},{"text":"hinaaffaalle akka boolla awwaalaa jabaatti.","poem":2},{"text":"Bobeenni isi'ii akka bobe'a ibiddaa,","poem":1},{"text":"ka tallisuu ti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bisaan guddaan","poem":1},{"text":"ibidda jaalalaa dhaanfuu hin dande'u;","poem":2},{"lineBreak":true},{"text":"lolaan haree hin dande'u.","poem":2},{"text":"Nami tokko qabeenna mana ifii mara","poem":1},{"text":"jaalalaaf yoo kenne,","poem":2},{"lineBreak":true},{"text":"ijjumaa hin tuffatama.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nuuti obboleettii diqqittii,","poem":1},{"text":"guntuta hin baasin takka qanna.","poem":2},{"text":"Guyyaa isii kadhatane,","poem":1},{"text":"nuuti maan goona laati?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Adoo isiin dalleyaa dhaka'aa teetee,","poem":1},{"text":"xelleephoo meeti'ii isii irratti hin ijaarra;","poem":2},{"lineBreak":true},{"text":"adoo isiin balbala teetee,","poem":2},{"lineBreak":true},{"text":"saanqaa hindheensaatiin hin cunna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani dalleya dhaka'aa ti;","poem":1},{"text":"harmi kiyya xelleephoo fakkaata;","poem":2},{"lineBreak":true},{"text":"ani ila isaa duratti nama nageya isaaf fidu te'e.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Solomoon Ba'aal-Hamoon keessaa","poem":1},{"text":"oorruu muka woyni'ii qabaayyu.","poem":2},{"text":"Oorruu muka woyni'ii san worra eegutti kireesse;","poem":1},{"text":"tokko tokkoon isaanii","poem":2},{"lineBreak":true},{"text":"gatii midhaan woyni'iitiif,","poem":2},{"lineBreak":true},{"text":"meetii kuma tokko tokko fidaniiyyu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Oorruun muka woyni'ii tiyya, tiyyuma;","poem":1},{"text":"ee Solomoon, ati kuma fudhadhu;","poem":2},{"lineBreak":true},{"text":"worri oorruu muka woyni'ii eegulle","poem":2},{"lineBreak":true},{"text":"dhibba lama fudhatuu ti.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ee, ati ta oorruu keessa leetu,","poem":1},{"text":"jaaloti tiyya qoonqoo teeti caqasiisatti jiran;","poem":2},{"lineBreak":true},{"text":"anille qoonqoo teeti dhage'uu ti.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jaalallee kiyya, dafii koy!","poem":1},{"text":"Akka jiliba'aa yookiin akka ilmoolee gadansaa","poem":2},{"lineBreak":true},{"text":"gaara uddowaan itti latu irraa utaalii koy!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}