{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"ZEC","translationId":"gax_twf","name":"Zakaariyaasii Raagichaa","commonName":"Zakaariyaasii Raagichaa","title":"Kitaaba Zakaariyaasii Raagichaa","order":38,"numberOfChapters":14,"sha256":"34926887887664200c957f795a0f0a735115b981810dd69a4cfade36d926ffa5","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gax_twf/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":10,"content":[{"type":"heading","content":["Adde'etti Deebi'iisa Kolbaa Yihuda'aatii fi Israa'elii"]},{"type":"verse","number":1,"content":[{"text":"Rooba furmaataa akka isinii kennuuf,","poem":1},{"text":"Mootii Waan Maraa gaafadha'a;","poem":2},{"lineBreak":true},{"text":"ka duumensa roobaa ergee,","poem":2},{"lineBreak":true},{"text":"tiifuu roobaa isinii kennee,","poem":2},{"lineBreak":true},{"text":"fichaa magariisa godhu Mootii Waan Maraa ti.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Waaqoti dharaa","poem":1},{"text":"waan gatii hin qanne dubbatan;","poem":2},{"lineBreak":true},{"text":"worri moru mudhii dharaa dhaggan;","poem":2},{"lineBreak":true},{"text":"oojjuu sobaalle himan.","poem":2},{"text":"Isaan akkasumaan","poem":1},{"text":"nama jajjabeessan;","poem":2},{"lineBreak":true},{"text":"tanaaf kolbaan tissee dhaddee rakkattee,","poem":2},{"lineBreak":true},{"text":"akka hoole'ee joonjiti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mootiin Waan Maraa, «Ani tissitootatti guddoo aareera;","poem":1},{"text":"sooressitootalle hin adaba.","poem":2},{"text":"Ani Mootiin Waan Maraa Ka Waan Mara Dade","poem":1},{"text":"hoolota tiyya kolbaa Yihuda'aa hin kunuunsa.","poem":2},{"text":"Akka farda kiyya ka lolaa ka ittiin kooruu","poem":1},{"text":"isaan hin godha.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kolbaa Yihuda'aa keessaa","poem":1},{"text":"bulchitooti","poem":2},{"lineBreak":true},{"text":"ta akka dhakaa roga ijaarsaa","poem":2},{"lineBreak":true},{"text":"ta akka togaa dunkaanaatii fi","poem":2},{"lineBreak":true},{"text":"guubee lolaa jiranu hin ka'an.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isaan wolumatti te'anee","poem":1},{"text":"akka loltoota jajjabaa","poem":2},{"lineBreak":true},{"text":"diinota ifii dhoqqee karaa keessaa irratti","poem":2},{"lineBreak":true},{"text":"dhidhiitanee injifatanuu hin te'an.","poem":2},{"text":"Mootiin Waan Maraa isaan woliin waan jiruuf","poem":1},{"text":"isaan lola keessatti","poem":2},{"lineBreak":true},{"text":"abbootii fardaa diinota hin qaanessan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Ani kolbaa Yihuda'aa hin jabeessa;","poem":1},{"text":"kolbaa Israa'eliille hin fayyisa.","poem":2},{"lineBreak":true},{"text":"Ani isaaniif waan nawuuf,","poem":2},{"lineBreak":true},{"text":"akka duriititti isaan hin deebisa.","poem":2},{"text":"Isaan akka ani tanaan qara","poem":1},{"text":"ijjumaa isaan lakkisee hin beennee hin te'an.","poem":2},{"lineBreak":true},{"text":"Ani Mootii Waan Maraa Waaqa isaanii waan te'eef,","poem":2},{"lineBreak":true},{"text":"daadimata isaanii hin dhage'a.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kolbaan Efreemii akka worra jajjabaa hin te'an.","poem":1},{"text":"Isaan akka nama daadhii woyni'ii unee hin gammadan.","poem":2},{"text":"Ijoolleen isaanii tana dhaggitee hin gammaddi;","poem":1},{"text":"gadhaan isaaniille Mootii Waan Maraatitti hin gammada.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ani kolbaa tiyya beessisaan waamee","poem":1},{"text":"wolitti isaan hin qaba.","poem":2},{"lineBreak":true},{"text":"Ani isaan waan woduuf","poem":2},{"lineBreak":true},{"text":"akkuma durii laakkossa isaanii hin fakkansa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ani gosa biyya adda addaa oddu'utti","poem":1},{"text":"isaan bittinneessulle","poem":2},{"lineBreak":true},{"text":"biyya fagoo san jiraatanee na hin qaabatan.","poem":2},{"text":"Isaanii fi ijoolleen isaanii jiraatanee,","poem":1},{"text":"gara biyya ifii hin deebi'an.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani biyya Gibxi'iitii","poem":1},{"text":"deebisee isaan hin fida.","poem":2},{"text":"Biyya Asoorii keessaalle'ee","poem":1},{"text":"haga latti isaan dhiphattutti","poem":2},{"lineBreak":true},{"text":"wolitti isaan qabadha.","poem":2},{"text":"Gara biyya Giil'aadiitii fi Libaanonii","poem":1},{"text":"deenisee isaan hin galcha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yennaa isaan abbaayaa rakko'oo keessa dabaranu,","poem":1},{"text":"ani danbalii hin dhowa.","poem":2},{"text":"Qilee ka te'e lagi Nayilii hin goga.","poem":1},{"text":"Asoor hin salphatti;","poem":2},{"lineBreak":true},{"text":"Gibxille ulee bokku'uu","poem":2},{"lineBreak":true},{"text":"ta mootumma'aa hin dhaddi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ani kolbaa tiyya hin jajjabeessa.","poem":1},{"text":"Isaanille jecha kiyyaaf hin ajajaman» jedha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gax_twf/ZEC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/ZEC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/ZEC/9.json","previousChapterAudioLinks":{},"numberOfVerses":12}