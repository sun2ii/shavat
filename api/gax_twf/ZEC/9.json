{"translation":{"id":"gax_twf","name":"Kitaaba Woyyuu","website":"https://ebible.org/Scriptures/details.php?id=gax","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gax","licenseNotes":null,"shortName":"TWF","englishName":"Guji Oromo Bible","language":"gax","textDirection":"ltr","sha256":"4e125fd1eb929b8de014533d650c7b8d593131d4fa84dcabafa0769a411edad5","availableFormats":["json"],"listOfBooksApiLink":"/api/gax_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31068,"languageName":"Borana-Arsi-Guji Oromo","languageEnglishName":"Borana-Arsi-Guji Oromo"},"book":{"id":"ZEC","translationId":"gax_twf","name":"Zakaariyaasii Raagichaa","commonName":"Zakaariyaasii Raagichaa","title":"Kitaaba Zakaariyaasii Raagichaa","order":38,"numberOfChapters":14,"sha256":"34926887887664200c957f795a0f0a735115b981810dd69a4cfade36d926ffa5","firstChapterNumber":1,"firstChapterApiLink":"/api/gax_twf/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gax_twf/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":9,"content":[{"type":"heading","content":["Muraa Diinota Israa'elii Irratti Dhuttu"]},{"type":"verse","number":1,"content":[{"text":"Dubbiin mura'aa ta Mootii Waan Maraa","poem":1},{"text":"marroo biyya Hadraakiitiif dubbate","poem":2},{"lineBreak":true},{"text":"qachaa Damaasqo'oolle geette.","poem":2},{"text":"Ilti namootaatii fi gosa Israa'elii duudiin","poem":1},{"text":"gara Mootii Waan Maraa hin ilaalti.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Haamaati ta meessaa isaanii jirtu,","poem":1},{"text":"Xiiroosii fi Sidoon guddoo qaroolee te'anulle","poem":2},{"lineBreak":true},{"text":"gara isaa hin ilaalan.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Xiiroos kushee ijaarratteerti;","poem":1},{"text":"meetii akka biyye'ee,","poem":2},{"lineBreak":true},{"text":"worqii akka dhoqqee karaa keessaa tuulatteerti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mootiin Waan Maraa ammoo","poem":1},{"text":"waan isiin qaddu mara irraa hin mulqa;","poem":2},{"lineBreak":true},{"text":"karra isi'ii mara","poem":2},{"lineBreak":true},{"text":"gara abbaaya'aa hin gata;","poem":2},{"lineBreak":true},{"text":"isiille ibiddaan gubattee hin baddi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Worri Ashiqalonii","poem":1},{"text":"tana dhaggee hin sodaata;","poem":2},{"lineBreak":true},{"text":"worri Gaaza'aalle hin hollata.","poem":2},{"text":"Worri Eqroonille addii hin kutata;","poem":1},{"text":"worra Gaaza'aa keessaa mootiin hin dhabama;","poem":2},{"lineBreak":true},{"text":"Qachaan Ashiqalonii hin ona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kolbaan makante qachaa Ashidoodii keessa hin leeti.","poem":1},{"text":"Mootiin Waan Maraa Ka Waan Mara dande'u,","poem":2},{"lineBreak":true},{"text":"«Ani koora Filisxeemotaa hin balleessa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Isaan haganaa achi foon dhiiga qabu","poem":1},{"text":"yookiin sagalee dhooggante hin nyaatanu.","poem":2},{"lineBreak":true},{"text":"Worri hafe Waaqa keennaaf hin te'a,","poem":2},{"lineBreak":true},{"text":"biyya Yihuda'aa keessatti sooreyyii hin te'an.","poem":2},{"lineBreak":true},{"text":"Worri Eqroonille akkuma worra Yibusootaa hin te'a.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ani mana kiyya,","poem":1},{"text":"saantota irraa hin eegadha.","poem":2},{"text":"Ani ila tiyyaan isaan waan eeguuf,","poem":1},{"text":"nami isaan miicu,","poem":2},{"lineBreak":true},{"text":"haganaa achi deebi'ee isaan keessa hin bayu» jedha.","poem":2}]},{"type":"heading","content":["Mootii Xiyoonii Ka Dhufu"]},{"type":"verse","number":9,"content":[{"text":"Kolbaa Xiyoonii, guddoo gammada'a!","poem":1},{"text":"Kolbaa Yerusaalemii, ilillisa'a!","poem":2},{"text":"Kunoo, mootichi keessan balchaan,","poem":1},{"text":"injifataan, gad ifi qabee,","poem":2},{"lineBreak":true},{"text":"ilmayyoo harre'ee irraa tee'ee,","poem":2},{"lineBreak":true},{"text":"gara keessan hin dhufa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mootiin Waan Maraa,","poem":1},{"text":"«Ani Garreettaa fardaa Efreem keessaa,","poem":2},{"lineBreak":true},{"text":"fardoo lolaa Yerusaalem keessaa hin balleessa.","poem":2},{"text":"Guubeen lolaalle hin baddi;","poem":1},{"text":"Mootichi keeti gosa biyya adda addaatiif,","poem":2},{"lineBreak":true},{"text":"nageya hin lassa.","poem":2},{"lineBreak":true},{"text":"Bulchiisi isaa abbaayaa irraa,","poem":2},{"lineBreak":true},{"text":"haga abbaaya'aa,","poem":2},{"lineBreak":true},{"text":"laga Efraaxiisii irraa","poem":2},{"lineBreak":true},{"text":"haga dhuma lafaa ti.","poem":2}]},{"type":"heading","content":["Adde'etti Deebi'iisa Kolbaa Waaqaa"]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Isiniif sababa gondooroo tiyya,","poem":1},{"text":"ta dhiigaan isin woliin gondooreetiif jedhee,","poem":2},{"lineBreak":true},{"text":"worra hidhamane keeti,","poem":2},{"lineBreak":true},{"text":"boolla bisaan hin qanne keessaa,","poem":2},{"lineBreak":true},{"text":"bilisa hin baasa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Isin worri hidhantanee, addi'iin jirtanu,","poem":1},{"text":"gara addee nageyaa teessanitti deebi'a'a;","poem":2},{"lineBreak":true},{"text":"ani adha addee duriititti","poem":2},{"lineBreak":true},{"text":"dachaa lama isiniif hin deebisa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ani Yihudaa akka guube'eetitti,","poem":1},{"text":"Efreem akka daayaatitti,","poem":2},{"lineBreak":true},{"text":"namoota Giriiki'ii loliisaaf,","poem":2},{"lineBreak":true},{"text":"ilmaan Xiyoonii","poem":2},{"lineBreak":true},{"text":"akka shallaaga'aatitti hin fayyadama» jedha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mootiin Waan Maraa","poem":1},{"text":"kolbaa ifiitiin gubba'atti hin mudhata;","poem":2},{"lineBreak":true},{"text":"daayi isaa akka balaqqeetti'ii hin utaala.","poem":2},{"text":"Mootiin Waan Maraa Waaqi","poem":1},{"text":"qoonqoo tultulla'aa hin dhageessisa;","poem":2},{"lineBreak":true},{"text":"bubbee gara kibbaa keessa,","poem":2},{"lineBreak":true},{"text":"itti hin ideema.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mootiin Waan Maraa Ka Waan Mara Dade,","poem":1},{"text":"kolbaa ifii irraa hin dhoogga;","poem":2},{"lineBreak":true},{"text":"isaanille dhakaa looyya'aatiin","poem":2},{"noteId":9},{"text":"diina ifii hin balleessan;","poem":2},{"lineBreak":true},{"text":"akka nama daadhii woyni'ii unee machowee hin iyyan;","poem":2},{"lineBreak":true},{"text":"akka qorii dhiiga ittiin fiffixanu ta roga addee ciinca'aa","poem":2},{"lineBreak":true},{"text":"hin guutaman.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Gaafas Mootiin Waan Maraa Waaqi isaanii","poem":1},{"text":"akka tisseen horii ifii waan hantuu irraa fayyisu","poem":2},{"lineBreak":true},{"text":"kolbaa ifii hin fayyisa.","poem":2},{"text":"Isaan akka dhakaa gatii guddo'oo","poem":1},{"text":"ka kallacha irraa","poem":2},{"lineBreak":true},{"text":"lafa isaa keessatti hin calalaqan.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Latti attam attam Shagga'aa fi dansa'a!","poem":1},{"text":"Midhaanii fi daadhiin woyni'ii ta isii irraa dhaggantu,","poem":2},{"lineBreak":true},{"text":"Dargaggeeyyii dhiiraatii fi durraa","poem":2},{"lineBreak":true},{"text":"hin bisileessiti.","poem":2}]}],"footnotes":[{"noteId":9,"caller":"+","text":"Looyya'aatiin: Lafa tokko tokkotti yanbarsaatiin jedhama.","reference":{"chapter":9,"verse":15}}]},"thisChapterLink":"/api/gax_twf/ZEC/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gax_twf/ZEC/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gax_twf/ZEC/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}