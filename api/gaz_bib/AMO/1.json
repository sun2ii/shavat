{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"AMO","translationId":"gaz_bib","name":"Amoos","commonName":"Amoos","title":"Raajii Amoos","order":30,"numberOfChapters":9,"sha256":"8c032098a1fa08f617d11dd6d8f68fe96e33b8c920071e891dd7439359d06604","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gaz_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Kun mulʼata Amoos inni tikseewwan Teqooʼaa keessaa tokko ture sun bara Uziyaan mootii Yihuudaa, Yerobiʼaam ilmi Yooʼaash immoo mootii Israaʼel turetti, utuu sochiin lafaa hin taʼin waggaa lama dura waaʼee Israaʼel argee dha."]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":["Innis akkana jedhe:",{"text":"“Waaqayyo Xiyoon keessaa iyya;","poem":1},{"text":"Yerusaalem keessaa sagalee dhageessisa;","poem":2},{"text":"dirreen tiksoonni itti bobbaasan ni goga;","poem":1},{"text":"fiixeen gaara Qarmeloosis ni coollaga.”","poem":2}]},{"type":"heading","content":["Murtii Olloota Israaʼelitti Murame"]},{"type":"verse","number":3,"content":["Waaqayyo akkana jedha:",{"text":"“Ani cubbuu Damaasqoo sadiif,","poem":1},{"text":"afuriifis dheekkamsa koo duubatti hin deebisu.","poem":2},{"text":"Sababii isaan meeshaa ittiin midhaan dhaʼan","poem":1},{"text":"kan ilkaan sibiilaa qabuun Giliʼaadin tumaniif,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ani ibidda daʼannoo Ben-Hadaad","poem":1},{"text":"barbadeessu tokko, mana Hazaaʼeelitti nan erga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ani karra Damaasqoo nan cabsa;","poem":1},{"text":"mootii Sulula Aawwen keessa jiruu fi","poem":2},{"text":"isa Beet Eden keessatti bokkuu qabatu nan balleessa.","poem":1},{"text":"Uummanni Sooriyaa boojiʼamee Qiiritti ni geeffama”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"verse","number":6,"content":["Waaqayyo akkana jedha:",{"text":"“Ani cubbuu Gaazaa sadiif,","poem":1},{"text":"afuriifis dheekkamsa koo duubatti hin deebisu.","poem":2},{"text":"Sababii isheen hawaasa hunda boojitee","poem":1},{"text":"Edoomitti gurguratteef,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ani ibidda daʼannoo ishee barbadeessu tokko","poem":1},{"text":"dallaa Gaazaatti nan erga.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ani mootii Ashdoodii fi isa Ashqaloon keessatti","poem":1},{"text":"bokkuu qabatu sana nan balleessa.","poem":2},{"text":"Ani hamma hambaan Filisxeemotaa duʼuutti","poem":1},{"text":"harka koo Eqroonitti nan deebifadha”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo Gooftaan.","poem":2}]},{"type":"verse","number":9,"content":["Waaqayyo akkana jedha:",{"text":"“Ani cubbuu Xiiroos sadiif,","poem":1},{"text":"afuriifis dheekkamsa koo duubatti hin deebisu.","poem":2},{"text":"Sababii isheen walii galtee obbolummaa cabsitee","poem":1},{"text":"hawaasa boojiʼame guutuu Edoomitti gurguratteef","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ani ibidda daʼannoo ishee barbadeessu tokko","poem":1},{"text":"dallaa Xiiroositti nan erga.”","poem":2}]},{"type":"verse","number":11,"content":["Waaqayyo akkana jedha:",{"text":"“Ani cubbuu Edoom sadiif,","poem":1},{"text":"afuriifis dheekkamsa koo duubatti hin deebisu.","poem":2},{"text":"Sababii inni gara laafina hunda gatee","poem":1},{"text":"obboleessa isaa goraadeedhaan ariʼeef,","poem":2},{"text":"sababii aariin isaa ittuma fufee hoʼee","poem":1},{"text":"dheekkamsi isaas utuu hin dhowwamin bobaʼeef,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ani ibidda daʼannoo Bozraa barbadeessu tokko","poem":1},{"text":"Teemaanitti nan erga.”","poem":2}]},{"type":"verse","number":13,"content":["Waaqayyo akkana jedha:",{"text":"“Ani cubbuu Amoon sadiif,","poem":1},{"text":"afuriifis dheekkamsa koo duubatti hin deebisu.","poem":2},{"text":"Sababii inni daangaa isaa babalʼifachuuf jedhee","poem":1},{"text":"dubartoota Giliʼaad kanneen ulfa qaban baqaqseef","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ani guyyaa lolaatti wacaan,","poem":1},{"text":"guyyaa qilleensa hamaatti immoo bubbee jabaadhaan","poem":2},{"text":"ibidda daʼannoo ishee barbadeessu tokko","poem":1},{"text":"dallaa Rabbaatti nan erga.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mootiin ishee boojiʼamee innii fi","poem":1},{"text":"qondaaltonni isaa wajjin ni boojiʼamu”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}