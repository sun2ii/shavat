didanii","poem":1},{"text":"ajaja isaas hin eeginiif,","poem":2},{"text":"sababii isaan waaqota sobaa,","poem":1},{"text":"waaqota abbootiin isaanii duukaa buʼan sanaankaraa irraa jalʼataniif,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ani ibidda daʼannoo Yerusaalem barbadeessu tokko","poem":1},{"text":"Yihuudaatti nan erga.”","poem":2}]},{"type":"heading","content":["Murtii Israaʼelitti Murame"]},{"type":"verse","number":6,"content":["Waaqayyo akkana jedha:",{"text":"“Ani cubbuu Israaʼel sadiif,","poem":1},{"text":"afuriifis dheekkamsa koo duubatti hin deebisu.","poem":2},{"text":"Isaan qajeeltota meetiitti,","poem":1},{"text":"rakkattoota immoo kophee cimdii tokkotti gurguratan.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Isaan akkuma biyyoo lafaatti","poem":1},{"text":"mataa hiyyeeyyii irra ijaajjanii","poem":2},{"lineBreak":true},{"text":"cunqurfamaas murtii qajeelaa dhowwatan.","poem":2},{"text":"Abbaa fi ilmi durba tokkotti galanii","poem":1},{"text":"akkasiin maqaa koo qulqulluu xureessan.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Isaan uffata qabdiidhaan nama irraa","poem":1},{"text":"fudhatan irra iddoo aarsaa hunda bira ciciisan.","poem":2},{"text":"Isaan daadhii wayinii kan warra adabaman biraa dhufe,","poem":1},{"text":"mana waaqa isaanii keessatti dhugu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Inni akkuma birbirsaa dheeratee","poem":1},{"text":"akka qilxuu jabaatu iyyuu,","poem":2},{"lineBreak":true},{"text":"ani namicha Amoor sana fuula isaanii duratti galaafadheera.","poem":2},{"text":"Ani gubbaadhaa ija isaa,","poem":1},{"text":"jalaan immoo hidda isaa balleesseera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Ani biyya Amoorotaa isiniif kennuuf jedhee,","poem":1},{"text":"biyya Gibxiitii isin baasee","poem":2},{"lineBreak":true},{"text":"waggaa afurtama gammoojjii keessa isinan geggeesse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Akkasumas ani ilmaan keessan gidduudhaa raajota,","poem":1},{"text":"dargaggoota keessan gidduudhaa immoo Naaziroota kaaseera.","poem":2},{"text":"Yaa saba Israaʼel, wanni kun dhuguma mitii?”","poem":1},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Isin garuu Naaziroota daadhii wayinii obaaftanii","poem":1},{"text":"akka raajonnis raajii hin dubbanne ajajjan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Ani akkuma gaariin yommuu midhaaniin guutamu caccabu sana,","poem":1},{"text":"amma isinan caccabsa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Saffisaan hin miliqu;","poem":1},{"text":"namoonni jajjaboon humna isaanii hin jabeeffatan;","poem":2},{"lineBreak":true},{"text":"loltuunis lubbuu isaa hin oolfatu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Abbaan xiyyaa jabaatee dhaabachuu hin dandaʼu;","poem":1},{"text":"loltuun saffisaan fiigee jalaa hin baʼu;","poem":2},{"lineBreak":true},{"text":"abbaan fardaas lubbuu isaa oolfachuu hin dandaʼu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Loltoonni akka malee jajjaboon iyyuu","poem":1},{"text":"gaafas qullaa isaanii baqatu”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}