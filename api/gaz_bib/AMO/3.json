{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"AMO","translationId":"gaz_bib","name":"Amoos","commonName":"Amoos","title":"Raajii Amoos","order":30,"numberOfChapters":9,"sha256":"8c032098a1fa08f617d11dd6d8f68fe96e33b8c920071e891dd7439359d06604","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gaz_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"heading","content":["Dhuga baatota Israaʼelitti Dhugaa Baʼan"]},{"type":"verse","number":1,"content":["Yaa saba Israaʼel, dubbii Waaqayyo isiniin mormuudhaan, maatii ani biyya Gibxii baasee fide hundaan mormuudhaan dubbate kana dhagaʼaa:"]},{"type":"verse","number":2,"content":[{"text":"“Ani maatiiwwan lafa irra jiraatan","poem":1},{"text":"hunda keessaa isin qofa filadheera;","poem":2},{"text":"kanaafuu ani cubbuu keessan","poem":1},{"text":"hundaaf isinan adaba.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yoo walii galan malee","poem":1},{"text":"namoonni lama wajjin ni deemuu?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Leenci tokko yoo waan adamsu hin argatin","poem":1},{"text":"bosona keessaa ni aadaa?","poem":2},{"text":"Inni yoo waa qabate malee","poem":1},{"text":"holqa isaa keessaa ni aadaa?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Simbirri tokko lafa kiyyoon hin kaaʼaminitti","poem":1},{"text":"kiyyoo keessa ni seentii?","poem":2},{"text":"Kiyyoon tokko yoo wanni qabamu hin jirre","poem":1},{"text":"akkasumatti lafaa ni utaalaa?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yoo magaalaa keessatti malakanni afuufame,","poem":1},{"text":"namoonni hin raafamanii?","poem":2},{"text":"Balaan magaalaa tokkotti yoo dhufe,","poem":1},{"text":"Waaqayyotu waan sana fide mitii?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dhugumaan Waaqayyo Gooftaan","poem":1},{"text":"utuu tajaajiltoota isaa raajotatti hin mulʼisin","poem":2},{"lineBreak":true},{"text":"waan tokko illee hin hojjetu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Leenci aadeera;","poem":1},{"text":"eenyutu hin sodaanne ree?","poem":2},{"text":"Waaqayyo Gooftaan dubbateera;","poem":1},{"text":"yoos eenyutu raajii hin dubbanne ree?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Daʼannoo Ashdoodiitii fi","poem":1},{"text":"daʼannoo Gibxitti akkana jedhaa labsaa:","poem":2},{"text":"“Tulluuwwan Samaariyaa irratti walitti qabamaa;","poem":1},{"text":"jeequmsa guddaa ishee keessa jiruu fi","poem":2},{"lineBreak":true},{"text":"cunqursaa uummata ishee keessa jiru ilaalaa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Warri daʼannoo isaanii keessatti waan boojiʼamee fiwaan saamame kuufatan","poem":1},{"text":"akka itti waan qajeelaa hojjetan hin beekan”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"verse","number":11,"content":["Kanaafuu Waaqayyo Gooftaan akkana jedha:",{"text":"“Diinni biyya keessan marsa;","poem":1},{"text":"jabina keessan gad buusa;","poem":2},{"lineBreak":true},{"text":"daʼannoowwan keessanis ni saama.”","poem":2}]},{"type":"verse","number":12,"content":["Waaqayyo akkana jedha:",{"text":"“Akkuma tikseen tokko lafee miilla lamaanii","poem":1},{"text":"yookaan fiixee gurraa qofa afaan leencaatii buusu sana,","poem":2},{"text":"Israaʼeloonni Samaariyaa keessa, qarqara siree isaanii irra,","poem":1},{"text":"Damaasqoo keessas siree isaanii dinkii irra taaʼan","poem":2},{"lineBreak":true},{"text":"akkasuma ni baraaramu.”","poem":2}]},{"type":"verse","number":13,"content":["“Waan kana dhagaʼaatii mana Yaaqoobitti dhugaa baʼaa” jedha Gooftaan, Waaqayyo Waaqni Waan Hunda Dandaʼu."]},{"type":"verse","number":14,"content":[{"text":"“Guyyaa ani cubbuu isheetiif jedhee Israaʼelin adabutti,","poem":1},{"text":"iddoowwan aarsaa Beetʼeel nan barbadeessa;","poem":2},{"text":"gaanfawwan iddoo aarsaas caccabanii","poem":1},{"text":"lafatti ni harcaʼu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ani mana gannaatii fi","poem":1},{"text":"mana bonaa nan diiga;","poem":2},{"text":"manneen ilka arbaatiin miidhagfaman ni diigamu;","poem":1},{"text":"manneen gurguddaanis ni balleeffamu”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}