{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"AMO","translationId":"gaz_bib","name":"Amoos","commonName":"Amoos","title":"Raajii Amoos","order":30,"numberOfChapters":9,"sha256":"8c032098a1fa08f617d11dd6d8f68fe96e33b8c920071e891dd7439359d06604","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gaz_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":4,"content":[{"type":"heading","content":["Israaʼel Gara Waaqaatti Hin deebine"]},{"type":"verse","number":1,"content":[{"text":"Isin yaa saawwan Baashaan kanneen Tulluu Samaariyaa irra jirtan,","poem":1},{"text":"yaa dubartoota, isin warri hiyyeeyyii fi rakkattoota cunqursitanii","poem":2},{"lineBreak":true},{"text":"dhirsoota keessaniin, “Dhugaatii nuuf fidaa!” jettandubbii kana dhagaʼaa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Waaqayyo Gooftaan akkana jedheequlqullummaa isaatiin kakateera:","poem":1},{"text":"“Yeroon isin itti hokkoodhaan,","poem":2},{"text":"isin keessaa namni dhumaa immoo qabduu qurxummiitiin","poem":1},{"text":"qabamu tokko dhugumaan ni dhufa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isin tokko tokkoon qajeeltanii","poem":1},{"text":"qaawwa dallaatiin ni baatu;","poem":2},{"text":"gara Harmoonittis ni darbatamtu”","poem":1},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Beetʼeel dhaqaatii cubbuu hojjedhaa;","poem":1},{"text":"Gilgaal dhaqaatii cubbuu baayʼee hojjedhaa.","poem":2},{"text":"Ganama ganama aarsaa keessan dhiʼeessaa;","poem":1},{"text":"waggaa sadii sadiitti immoo kennaa keessan harka kudhan keessaaharka tokko fidaa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Buddeena raacitii qabu aarsaa galataa godhaatii gubaa;","poem":1},{"text":"aarsaa fedhiidhaan kennitan labsaa; beeksisaas;","poem":2},{"text":"yaa Israaʼeloota, wanni isin hojjechuu jaallattan kanaatii,","poem":1},{"text":"ittiin boonaa”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo Gooftaan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Ani magaalaa hunda keessatti garaa duwwaa isiniif kenneera;","poem":1},{"text":"magaalaa hunda keessattis buddeena isin dhabsiiseera;","poem":2},{"text":"isin garuu gara kootti hin deebine”","poem":1},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ani yeroo midhaan haamamuuf jiʼi sadii hafutti","poem":1},{"text":"bokkaa isin irraa nan kute.","poem":2},{"text":"Ani magaalaa tokkotti bokkaa ergee","poem":1},{"text":"kaan irraa immoo nan dhaabe.","poem":2},{"text":"Lafti qonnaa tokko bokkaa argatee","poem":1},{"text":"kaan garuu homaa dhabee goge.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Uummanni bishaan barbaacha magaalaadhaa gara magaalaatti joore;","poem":1},{"text":"garuu waan dhugaatiif isa gaʼu hin arganne;","poem":2},{"text":"taʼus isin gara kootti hin deebine”","poem":1},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ani yeroo hedduu iddoo biqiltuutii fi","poem":1},{"text":"wayinii keessan waagii fi awwaaroodhaan dhaʼeen balleesse.","poem":2},{"text":"Hawwaannisni harbuu fi ejersa keessan barbadeesse;","poem":1},{"text":"taʼus isin gara kootti hin deebine”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Ani akkuman biyya Gibxi godhe sana","poem":1},{"text":"dhaʼicha isinitti nan erge.","poem":2},{"text":"Ani fardeen isin boojitan wajjin","poem":1},{"text":"dargaggoota keessan goraadeedhaan nan fixe.","poem":2},{"text":"Ajaa qubata keessaniitiin funyaan keessan nan guute;","poem":1},{"text":"isin garuu gara kootti hin deebine”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Ani akkuman Sodoomii fi Gomoraa garagalche sana","poem":1},{"text":"isin keessaa nama tokko tokko garagalcheera.","poem":2},{"text":"Isin akkuma muka bobaʼu kan ibidda keessaa butamee ti;","poem":1},{"text":"taʼus isin gara kootti hin deebine”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Kanaafuu yaa Israaʼel, ani akkanan isin godha;","poem":1},{"text":"sababii ani akkana isin godhuuf","poem":2},{"lineBreak":true},{"text":"yaa Israaʼel Waaqa kee arguuf qophaaʼi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Inni tulluuwwan tolchee","poem":1},{"text":"bubbee uumee yaada isaa namatti mulʼisu sun,","poem":2},{"text":"inni barii dukkaneessee","poem":1},{"text":"iddoowwan lafa ol kaʼoo irra ejjetu sun,","poem":2},{"lineBreak":true},{"text":"maqaan isaa Waaqayyo,Waaqa Waan Hunda Dandaʼuu dha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/AMO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/AMO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/AMO/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}