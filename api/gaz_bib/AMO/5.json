{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"AMO","translationId":"gaz_bib","name":"Amoos","commonName":"Amoos","title":"Raajii Amoos","order":30,"numberOfChapters":9,"sha256":"8c032098a1fa08f617d11dd6d8f68fe96e33b8c920071e891dd7439359d06604","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gaz_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["Faaruu Booʼichaatii fi Waamicha Qalbii Jijjiirrachuu"]},{"type":"verse","number":1,"content":["Yaa mana Israaʼel dubbii kana, faaruu booʼichaa kan ani waaʼee keessaniif booʼu kana dhagaʼaa:"]},{"type":"verse","number":2,"content":[{"text":"“Durbi qulqullittiin Israaʼel kufteerti;","poem":1},{"text":"isheen lammata hin kaatu;","poem":2},{"text":"biyyuma ishee keessatti gatamtee","poem":1},{"text":"nama ol ishee qabu tokko illee dhabde.”","poem":2}]},{"type":"verse","number":3,"content":["Waaqayyo Gooftaan akkana jedha:",{"text":"“Magaalaa loltoota kuma tokko Israaʼeliif bobbaafteef","poem":1},{"text":"dhibba tokko qofatu hafa;","poem":2},{"text":"magaalaa loltoota dhibba tokko bobbaafteef","poem":1},{"text":"kudhan qofatu hafa.”","poem":2}]},{"type":"verse","number":4,"content":["Waaqayyo mana Israaʼeliin akkana jedha:",{"text":"“Na barbaaddadhaatii jiraadhaa;","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Beetʼeelin hin barbaaddatinaa;","poem":2},{"text":"Gilgaal hin dhaqinaa;","poem":1},{"text":"Bersheebaattis hin ceʼinaa.","poem":2},{"text":"Gilgaal dhugumaan ni boojiʼamti;","poem":1},{"text":"Beetʼeelis ni dhabamti.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Waaqayyoon barbaaddadhaatii jiraadhaa;","poem":1},{"text":"yoo kanaa achii inni akkuma ibiddaamana Yoosef keessa baʼee haxaaʼaa;","poem":2},{"text":"ibiddi sun ishee guba;","poem":1},{"text":"Beetʼeelis nama irraa dhaamsu tokko iyyuuhin qabaattu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Isin warra murtii qajeelaa hadhaatti geeddartanii","poem":1},{"text":"qajeelummaas lafatti harcaaftanii dha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Inni urjiiwwan Torbii fi urjiiwwan Sadee uume,","poem":1},{"text":"kan dukkana bariitti geeddaru,","poem":2},{"lineBreak":true},{"text":"inni guyyaa dukkaneessee halkan godhu,","poem":2},{"text":"kan galaana keessaa bishaan ol waamee","poem":1},{"text":"fuula lafa gogaa irratti dhangalaasu","poem":2},{"lineBreak":true},{"text":"maqaan isaa Waaqayyoo dha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inni daʼoo jabaatti badiisa tasaa fida;","poem":1},{"text":"magaalaa dallaa jabaa qabdus ni barbadeessa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Isaan nama karra irratti nama ifatu ni jibbu;","poem":1},{"text":"kan dhugaa dubbatus ni balfu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Isin hiyyeeyyii dhidhiittanii","poem":1},{"text":"akka isaan midhaan isinii kennan dirqisiiftu.","poem":2},{"text":"Kanaafuu isin manneen dhagaa yoo ijaarrattan iyyuu","poem":1},{"text":"manneen sana keessa hin jiraattan;","poem":2},{"text":"isin iddoowwan qotiisaa gaarii keessa wayinii yoo dhaabbattan iyyuu","poem":1},{"text":"daadhii wayinii isaanii hin dhugdan.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Balleessaan keessan hammam akka baayʼatuu fi","poem":1},{"text":"cubbuun keessanis hammam guddaa akka taʼe nan beekaatii.","poem":2},{"lineBreak":true},{"text":"Isaan qajeeltota hacuucanii mattaʼaa irraa fudhatu;","poem":1},{"text":"hiyyeeyyiis mana murtii keessatti murtii qajeelaa dhowwatu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kanaafuu namni qalbeeffataan yeroo akkasiitti afaan qabata;","poem":1},{"text":"barri kun bara hamaadhaatii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Akka lubbuudhaan jiraattaniif","poem":1},{"text":"waan hamaa dhiisaatii waan gaarii barbaadaa.","poem":2},{"text":"Yoos akkuma isin jettan sana","poem":1},{"text":"Waaqayyo Waaqni Waan Hunda Dandaʼu isin wajjin taʼa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Waan hamaa jibbaa; waan gaarii jaalladhaa;","poem":1},{"text":"mana murtii keessatti murtii qajeelaa jabeessaa;","poem":2},{"text":"Waaqayyo Waaqni Waan Hunda Dandaʼu","poem":1},{"text":"tarii hambaa Yoosefiif garaa laafa taʼaatii.","poem":2}]},{"type":"verse","number":16,"content":["Kanaafuu Gooftaan, Waaqayyo Waaqni Waan Hunda Dandaʼu akkana jedha:",{"text":"“Daandii hunda irra booʼicha,","poem":1},{"text":"oobdii uummataa hunda irra immoo iyya dhiphinaatu jira.","poem":2},{"text":"Qonnaan bultoonni akka booʼaniif,","poem":1},{"text":"warri booʼan immoo akka wawwaataniif ni waamamu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ani gidduu keessan waanan darbuuf","poem":1},{"text":"iddoo dhaabaa wayinii hunda keessaa booʼichatu taʼa”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"heading","content":["Guyyaa Waaqayyoo"]},{"type":"verse","number":18,"content":[{"text":"Isin warra guyyaa Waaqayyoo","poem":1},{"text":"arguu hawwitaniif wayyoo!","poem":2},{"text":"Isin maaliif guyyaa Waaqayyoo arguu hawwitu!","poem":1},{"text":"Guyyaan sun dukkana malee ifa hin taʼuutii.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wanni kun akkuma nama leenca jalaa baʼee","poem":1},{"text":"afaan amaaketaa buʼu tokkoo ti;","poem":2},{"text":"yookaan akka nama mana isaa seenee","poem":1},{"text":"harka isaa keenyan manaa irra kaaʼatee","poem":2},{"lineBreak":true},{"text":"bofti isa idde tokkoo ti.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Guyyaan Waaqayyoo ifa utuu hin taʼin dukkana mitii?","poem":1},{"text":"Dukkana hamaa ifa tokko illee of keessaa hin qabne mitii?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Ani ayyaana amantaa keessanii nan jibba; nan tuffadhas;","poem":1},{"text":"waldaa keessanittis hin gammadu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Utuu isin aarsaa gubamuu fi kennaa midhaanii naaf fiddanii iyyuu","poem":1},{"text":"ani jaalladhee isin irraa hin fudhadhu.","poem":2},{"text":"Utuu isin aarsaa nagaa filatamaa naaf fiddanii iyyuu","poem":1},{"text":"ani homaattuu isa hin lakkaaʼu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Waca faarfannaa keessanii asii balleessaa!","poem":1},{"text":"Ani muuziiqaa baganaa keessanii hin dhaggeeffadhu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Garuu murtiin qajeelaan akkuma lagaa,","poem":1},{"text":"qajeelummaanis akkuma burqaa hin gognee haa yaaʼu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Yaa mana Israaʼel isin waggaa afurtama","poem":1},{"text":"gammoojjii keessatti takkumaa aarsaa fi kennaa naaf fiddaniirtuu?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Isin waan harkuma keessaniin tolfattan","poem":1},{"text":"jechuunis galma waaqeffannaa mootii keessanii,","poem":2},{"lineBreak":true},{"text":"utubaa waaqa keessan tolfamaatii fi","poem":2},{"lineBreak":true},{"text":"fakkii urjii waaqa keessanii ol fuutaniirtu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kanaafuu ani akka isin boojiʼamtaniif,","poem":1},{"text":"Damaasqoodhaan gamatti isinan erga”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo inni maqaan isaaWaaqa Waan Hunda Dandaʼu taʼe sun.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}