{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"AMO","translationId":"gaz_bib","name":"Amoos","commonName":"Amoos","title":"Raajii Amoos","order":30,"numberOfChapters":9,"sha256":"8c032098a1fa08f617d11dd6d8f68fe96e33b8c920071e891dd7439359d06604","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gaz_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":8,"content":[{"type":"heading","content":["Guuboo Ija Bilchaateen Guutame"]},{"type":"verse","number":1,"content":["Waaqayyo Gooftaan waan kana natti argisiise: kun guuboo ija bilchaateen guutamee dha."]},{"type":"verse","number":2,"content":["Innis, “Amoos, ati maal arguutti jirta?” jedhee na gaafate. Ani immoo, “Guuboo ija bilchaateen guutame tokko” jedheen deebiseef. Ergasii Waaqayyo akkana naan jedhe; “Saba koo Israaʼelitti yeroon dhufeera; ani siʼachi isaan hin baraaru.”"]},{"type":"verse","number":3,"content":["Waaqayyo Gooftaan akkana jedha; “Gaafas faarfannaan mana qulqullummaa keessaa booʼichatti geeddarama. Reeffi akka malee hedduun lafa hundatti gatama! Calʼisuunis ni taʼa!”"]},{"type":"verse","number":4,"content":[{"text":"Isin warri rakkattoota dhidhiittanii","poem":1},{"text":"hiyyeeyyii biyyattii balleessitan waan kana dhagaʼaa;","poem":2}]},{"type":"verse","number":5,"content":["isin akkana jettu;",{"text":"“Akka nu midhaan gurgurannuuf","poem":1},{"text":"Baatiin Haaraan yoom goobana?","poem":2},{"text":"Akka nu qamadii gabaa baafannuuf","poem":1},{"text":"Sanbanni yoom darba?”","poem":2},{"text":"Isin warri safartuu xinnootti fayyadamtanii","poem":1},{"text":"gatii immoo ol kaaftan, madaalii sobaatiin","poem":2},{"lineBreak":true},{"text":"nama gowwoomsitanii saamtu;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"hiyyeeyyii meetiidhaan,","poem":1},{"text":"rakkataa immoo kophee miilla lamaaniitiin bitattanii","poem":2},{"lineBreak":true},{"text":"girdiis qamadii wajjin gurgurattu.","poem":2}]},{"type":"verse","number":7,"content":["Waaqayyo akkana jedhee ulfina Yaaqoobiin kakateera; “Ani gonkumaa waan isaan hojjetan tokko illee hin irraanfadhu."]},{"type":"verse","number":8,"content":[{"text":"“Sababii kanaaf lafti kirkirtee","poem":1},{"text":"namoonni ishee keessa jiraatan hundi hin booʼanii?","poem":2},{"text":"Guutummaan biyya sanaa akkuma laga Abbayyaa ol kaʼa;","poem":1},{"text":"isheen akkuma laga Gibxi","poem":2},{"lineBreak":true},{"text":"ol dadarbatamtee liqimfamti.”","poem":2}]},{"type":"verse","number":9,"content":["Waaqayyo Gooftaan akkana jedha; “Bara sana,",{"text":"“Ani akka aduun saafaadhaan dhiitee","poem":1},{"text":"laftis guyyuma adiidhaan dukkanooftu nan godha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani ayyaana amantii keessanii gaddatti,","poem":1},{"text":"sirba keessan hundas booʼichatti nan geeddara.","poem":2},{"text":"Ani akka isin hundi wayyaa gaddaa uffattanii","poem":1},{"text":"mataa keessan haaddattan nan godha.","poem":2},{"text":"Ani yeroo sana akkuma booʼicha ilma tokkichaa,","poem":1},{"text":"dhuma isaas akka guyyaa hadhaaʼaa nan godha.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Waaqayyo Gooftaan akkana jedha;","poem":1},{"text":"“Yeroon ani biyyattiitti beela fidu tokko ni dhufa;","poem":2},{"text":"innis beela dubbii Waaqayyoo dhagaʼuu ti malee","poem":1},{"text":"beela nyaataa yookaan dheebuu bishaanii miti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Namoonni dubbii Waaqayyoo barbaacha","poem":1},{"text":"galaanaa gara galaanaatti,","poem":2},{"text":"kaabaa gara baʼa biiftuutti ni jooru;","poem":1},{"text":"garuu hin argatan.","poem":2}]},{"type":"verse","number":13,"content":["“Bara sana",{"text":"“Shamarran babbareedoo fi","poem":1},{"text":"dargaggoonni dhiiraa jajjaboon dheebotanii gaggabu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Warri cubbuu Samaariyaatiin kakatan","poem":1},{"text":"yookaan ‘Yaa Daan dhugaa waaqa kee jiraataa’ jedhan,","poem":2},{"lineBreak":true},{"text":"yookaan warri ‘Dhugaa waaqa Bersheebaa’ jedhanii","poem":2},{"lineBreak":true},{"text":"kakatan akka lammata hin kaaneef ni kufu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/AMO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/AMO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/AMO/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}