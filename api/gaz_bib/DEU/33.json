{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"DEU","translationId":"gaz_bib","name":"Keessa Deebii","commonName":"Keessa Deebii","title":"Seera Keessa Deebii","order":5,"numberOfChapters":34,"sha256":"9071978b8d0144eed3eb1c644e930f6f5d6eba66f519a17e2daf6918390e3fc2","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/gaz_bib/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":33,"content":[{"type":"heading","content":["Museen Gosoota Israaʼel Eebbisuu Isaa"]},{"type":"verse","number":1,"content":["Eebbi Museen namni Waaqaa sun utuu hin duʼin dura ittiin Israaʼeloota eebbise kana;"]},{"type":"verse","number":2,"content":["innis akkana jedhe:",{"text":"“Waaqayyo tulluu Siinaa irraa dhufe;","poem":1},{"text":"isaan irrattis Seeʼiir irraa akka aduu ganamaatti baʼe;","poem":2},{"lineBreak":true},{"text":"Tulluu Phaaraan irraa isaan eebbise.","poem":2},{"text":"Inni qulqulloota isaa kumaatama wajjin dhufe;","poem":1},{"text":"karaa harka isaa mirgaatiin ibidda bobaʼutu baʼe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dhugumaan situ saba jaallata;","poem":1},{"text":"qulqulloonni hundinuu harka kee keessa jiru.","poem":2},{"text":"Hundi isaanii miilla kee jalatti kufu;","poem":1},{"text":"qajeelfamas sirraa argatu;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Museen seera nuu kenneera;","poem":1},{"text":"kunis dhaala waldaa Yaaqoob.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yeroo hooggantoonni sabaa","poem":1},{"text":"gosoota Israaʼel wajjin walitti qabamanitti","poem":2},{"lineBreak":true},{"text":"inni Yishuruun irratti mootii ture.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Ruubeen haa jiraatu malee hin duʼin;","poem":1},{"text":"yookaan baayʼinni namoota isaa hin xinnaatin.”","poem":2}]},{"type":"verse","number":7,"content":["Waaʼee Yihuudaas akkana jedhe:",{"text":"“Yaa Waaqayyo, iyya Yihuudaa dhagaʼi;","poem":1},{"text":"gara saba isaattis isa fidi.","poem":2},{"text":"Inni harka ofii isaatiin of haa eegu.","poem":1},{"text":"Yommuu inni diinota isaatiin wal lolutti gargaaraa isaa taʼi!”","poem":2}]},{"type":"verse","number":8,"content":["Inni waaʼee Lewwiis akkana jedhe:",{"text":"“Tumiimii fi Uriimiin kee","poem":1},{"text":"tajaajilaa kee amanamaadhaaf haa taʼu.","poem":2},{"text":"Ati lafa Maasaah jedhamutti isa qorte;","poem":1},{"text":"bishaan Mariibaa irratti isa lolte.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Waaʼee abbaa fi haadha isaas,","poem":1},{"text":"‘Ani isa hin argine’ jedhe.","poem":2},{"text":"Inni obboloota isaa addaan hin baafanne;","poem":1},{"text":"ijoollee isaas hin beekne;","poem":2},{"text":"isaan dubbii keetiif ajajamanii","poem":1},{"text":"kakuu kee eeganiiruutii.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Inni ajaja kee Yaaqoobin,","poem":1},{"text":"seera kee immoo Israaʼelin ni barsiisa.","poem":2},{"text":"Fuula kee duratti ixaana,","poem":1},{"text":"iddoo aarsaa keetii irratti illee aarsaa gubamu guutuu ni dhiʼeessa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yaa Waaqayyo, ogummaa isaa hunda eebbisiif;","poem":1},{"text":"waan harki isaa hojjetuttis gammadi.","poem":2},{"text":"Moʼoo warra isatti kaʼanii cabsi;","poem":1},{"text":"akka isaan lammata hin kaane godhiitii diinota isaa dhaʼi.”","poem":2}]},{"type":"verse","number":12,"content":["Waaʼee Beniyaam akkana jedhe:",{"text":"“Namni Waaqayyo isa jaallatu eegumsa isaatiin nagaan haa jiraatu;","poem":1},{"text":"inni guyyaa guutuu isa eegaatii;","poem":2},{"lineBreak":true},{"text":"namni Waaqayyo isa jaallatu gatiittii isaa gidduu boqota.”","poem":2}]},{"type":"verse","number":13,"content":["Waaʼee Yoosef akkana jedhe:",{"text":"“Waaqayyo biyya isaa haa eebbisu;","poem":1},{"text":"fixeensa filatamaa samiidhaa buusuudhaan","poem":2},{"lineBreak":true},{"text":"bishaan boolla gad fagoo keessaatiin,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"midhaan filatamaa aduun biqilchituun,","poem":1},{"text":"waan akka malee gaarii kan jiʼi kennuun,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"kennaawwan filatamoo tulluuwwan duriitiin,","poem":1},{"text":"badhaadhummaa gaarran bara baraatiin,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"kennaa filatamaa lafaatii fi guutummaa isaatiin,","poem":1},{"text":"surraa isa daggala bobaʼu keessa ture sanaatiin haa eebbisu.","poem":2},{"text":"Isaan kunneen hundi mataa Yoosef","poem":1},{"text":"kan obboloota isaa gidduutti bulchaa taʼe sanaa irra haa buʼan.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Inni ulfinaan korma hangafa fakkaata;","poem":1},{"text":"gaanfawwan isaa akka gaanfawwan gafarsaa ti.","poem":2},{"text":"Isaaniinis hamma daarii lafaatti","poem":1},{"text":"saboota ni waraana.","poem":2},{"text":"Isaanis kuma kurnan Efreem,","poem":1},{"text":"akkasumas kumaatama Minaasee ti.”","poem":2}]},{"type":"verse","number":18,"content":["Waaʼee Zebuuloonis akkana jedhe:",{"text":"“Zebuuloon ati gad baʼuu keetiin,","poem":1},{"text":"Yisaakor atis dunkaanota kee keessatti gammadi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Isaan saboota gara tulluutti ni waamu;","poem":1},{"text":"achittis aarsaa qajeelummaa ni dhiʼeessu;","poem":2},{"text":"isaan sooroma irra dhangalaʼaa galaana keessaatiin,","poem":1},{"text":"qabeenya cirracha keessa dhokfameenis ni gammadu.”","poem":2}]},{"type":"verse","number":20,"content":["Waaʼee Gaad immoo akkana jedhe:",{"text":"“Namni bulchiinsa Gaad balʼisu eebbifamaa dha!","poem":1},{"text":"Gaad irree fi mataa caccabsaa","poem":2},{"lineBreak":true},{"text":"akka leencaatti achi jiraata.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Inni ofii isaatiif lafa gabbataa filate;","poem":1},{"text":"qoodni hooggantootaa isaaf turfame.","poem":2},{"text":"Yommuu hooggantoonni sabaa walitti qabamanitti,","poem":1},{"text":"inni fedhii qajeelumma Waaqayyootii fi","poem":2},{"lineBreak":true},{"text":"murtii Israaʼelitti mure sana fiixaan baase.”","poem":2}]},{"type":"verse","number":22,"content":["Waaʼee Daanis inni akkana jedhe:",{"text":"“Daan akka ilmoolee leencaa","poem":1},{"text":"kan Baashaan keessaa utaalee baʼuu ti.”","poem":2}]},{"type":"verse","number":23,"content":["Waaʼee Niftaalemis akkana jedhe:",{"text":"“Niftaalem surraa gonfateera;","poem":1},{"text":"eebba Waaqayyootiinis guutameera;","poem":2},{"lineBreak":true},{"text":"inni biyya karaa lixaatii fi kibbaatiin jiru ni dhaala.”","poem":2}]},{"type":"verse","number":24,"content":["Waaʼee Aasheer immoo akkana jedhe:",{"text":"“Aasheer ilmaan hunda caalaa eebbifamaa dha;","poem":1},{"text":"inni obboloota isaa duratti fudhatama haa argatu;","poem":2},{"lineBreak":true},{"text":"miilla isaas zayitii keessa haa cuuphatu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Danqaraan balbala keetii sibiilaa fi naasii taʼa;","poem":1},{"text":"jabinni kees akkuma baroota jireenya keetii ni taʼa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Waaqni akka Waaqa Yishuruun,","poem":1},{"text":"kan si gargaaruuf jedhee samiiwwan irra,","poem":2},{"lineBreak":true},{"text":"surraa isaatiinis duumessoota irra gulufu tokko illee hin jiru.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Waaqni bara baraa iddoo jireenyaa keetii ti;","poem":1},{"text":"irreen bara baraas si jalaan jira.","poem":2},{"text":"Inni, ‘Isaan balleessi!’ jedhee","poem":1},{"text":"diinota kee fuula kee duraa ni ariʼa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kanaafuu Israaʼel kophaa isaa nagaadhaan jiraata;","poem":1},{"text":"lafa fixeensi samii itti coccophutti,","poem":2},{"text":"biyya midhaanii fi wayinii haaraatti","poem":1},{"text":"namni burqaa Yaaqoob tuqu hin jiru.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Yaa Israaʼel, ati eebbifamaa dha!","poem":1},{"text":"Sabni Waaqayyo isa fayyise,","poem":2},{"lineBreak":true},{"text":"kan akka keetii eenyu?","poem":2},{"text":"Inni gaachana keetii fi gargaaraa kee ti;","poem":1},{"text":"goraadee ulfina keetiitis.","poem":2},{"text":"Diinonni kee sodaadhaan fuula kee duraa duubatti deebiʼu;","poem":1},{"text":"ati immoo iddoowwan waaqeffannaa isaanii irra ejjetta.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}