{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"EZK","translationId":"gaz_bib","name":"Hisqiʼeel","commonName":"Hisqiʼeel","title":"Raajii Hisqiʼeel","order":26,"numberOfChapters":48,"sha256":"7a3b01cd28393c71fb31d4f75d1a99e1d7f6409c99e153f3f05bfc5424e183e3","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/gaz_bib/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":19,"content":[{"type":"heading","content":["Faaruu Booʼichaa"]},{"type":"verse","number":1,"content":["“Waaʼee ilmaan mootota Israaʼeliif faarsii booʼi;"]},{"type":"verse","number":2,"content":["akkanas jedhi:",{"text":"“ ‘Haati kee leencota gidduutti,","poem":1},{"text":"leenca akkamii turte!","poem":2},{"text":"Isheen leencota gidduu ciiftee","poem":1},{"text":"ilmoolee ishee guddifatte.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ilmoolee ishee keessaas tokko guddifatte;","poem":1},{"text":"innis leenca jabaa taʼe.","poem":2},{"text":"Inni waa adamsee ciccirachuu barate;","poem":1},{"text":"namootas nyaate.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Saboonni waaʼee isaa dhagaʼan;","poem":1},{"text":"inni boolla isaanii keessatti qabame.","poem":2},{"text":"Isaan hokkoodhaan harkisanii","poem":1},{"text":"gara biyya Gibxitti isa geessan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ ‘Isheen yommuu akka abdiin ishee hin guutamin,","poem":1},{"text":"akka wanni isheen yaaddes hin milkaaʼin argitetti,","poem":2},{"text":"ilmoolee ishee keessaa kan biraa fudhattee","poem":1},{"text":"leenca jabaa gootee guddifte.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inni leencota gidduu biddiiqe;","poem":1},{"text":"leenca jabaa taʼeeraatii.","poem":2},{"text":"Inni waa adamsee ciccirachuu barate;","poem":1},{"text":"namootas nyaate.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni daʼannoo isaanii diige;","poem":1},{"text":"magaalaawwan isaaniis onse.","poem":2},{"text":"Biyyattii fi kanneen ishee keessa jiraatan hundi","poem":1},{"text":"aaduu isaatiin raafaman.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ergasii saboonni warri kutaalee biyya naannoo","poem":1},{"text":"sanaa jiran isatti kaʼan.","poem":2},{"text":"Isaanis kiyyoo isaanii isa duratti diriirsan;","poem":1},{"text":"innis boolla isaanii keessatti qabame.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isaan hokkoodhaan qabanii mana shiboo keessa isa kaaʼan;","poem":1},{"text":"gara mootii Baabilonitti isa fidan.","poem":2},{"text":"Mana hidhaatti isa galchan;","poem":1},{"text":"kanaafuu aaduun isaa","poem":2},{"lineBreak":true},{"text":"tulluuwwan Israaʼel irratti ergasii hin dhagaʼamne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Haati kee akkuma wayinii","poem":1},{"text":"lafa qotiisaa kee keessa bishaan bira dhaabatee ti;","poem":2},{"text":"biqiltuun sunis sababii bishaan baayʼee argatteef","poem":1},{"text":"mistee damee hedduu baaffatte.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dameewwan isaas jajjaboo","poem":1},{"text":"bokkuu bulchaatiif taʼan turan.","poem":2},{"text":"Isheen baalawwan gobbatan gidduutti","poem":1},{"text":"ol dheerina isheetii fi","poem":2},{"text":"baayʼina dameewwan isheetiin","poem":1},{"text":"ol dheerattee mulʼatti turte.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Isheen garuu aariidhaan buqqifamtee","poem":1},{"text":"lafatti gatamte.","poem":2},{"text":"Bubbeen baʼa biiftuu ishee gogsee","poem":1},{"text":"ija ishee irraa harcaase;","poem":2},{"text":"dameewwan ishee ciccimoonis ni coollagan;","poem":1},{"text":"ibiddis isaan fixe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Amma isheen gammoojjii keessa,","poem":1},{"text":"lafa gogaa dheebote irra dhaabamte.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Damee ishee tokko keessaa ibiddi baʼee","poem":1},{"text":"ija ishee fixe.","poem":2},{"text":"Dameen jabaan bokkuu bulchaatiif taʼu","poem":1},{"text":"tokko iyyuu ishee irratti hin hafne.’","poem":2},"Kun faaruu booʼichaa kan booʼichaaf itti fayyadamanii dha.”"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}