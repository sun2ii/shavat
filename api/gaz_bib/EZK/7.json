{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"EZK","translationId":"gaz_bib","name":"Hisqiʼeel","commonName":"Hisqiʼeel","title":"Raajii Hisqiʼeel","order":26,"numberOfChapters":48,"sha256":"7a3b01cd28393c71fb31d4f75d1a99e1d7f6409c99e153f3f05bfc5424e183e3","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/gaz_bib/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":7,"content":[{"type":"heading","content":["Dhumni Dhufeera"]},{"type":"verse","number":1,"content":["Ergasii dubbiin Waaqayyoo akkana jedhee gara koo dhufe:"]},{"type":"verse","number":2,"content":["“Yaa ilma namaa, Waaqayyo Gooftaan biyya Israaʼeliin akkana jedha:",{"text":"“ ‘Dhuma! Golee biyyattii afranitti","poem":1},{"text":"dhumni dhufeera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ammas dhumni kee gaʼeera;","poem":1},{"text":"dheekkamsa koo sirratti nan dhangalaasa;","poem":2},{"text":"ani akkuma amala keetiitti sitti nan mura;","poem":1},{"text":"gochawwan kee jibbisiisoo hundaafis ani sin adaba.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ani gara laafinaan si hin ilaalu","poem":1},{"text":"yookaan si hin baasu;","poem":2},{"text":"ani hamma gochawwan kee jibbisiisoon sun si gidduu jiranitti,","poem":1},{"text":"amala keetiif sin adaba.","poem":2},"“ ‘Ergasiis isin akka ani Waaqayyo taʼe ni beektu.’"]},{"type":"line_break"},{"type":"verse","number":5,"content":["“Waaqayyo Gooftaan akkana jedha:",{"text":"“ ‘Badii! Badiin takkaa hin dhagaʼamin","poem":1},{"text":"tokko dhufaa jira.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dhumni dhufeera!","poem":1},{"text":"Dhumni dhufeera!","poem":2},{"text":"Inni mataan isaa isinitti kaʼeera.","poem":1},{"text":"Inni dhufeera!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yaa warra biyyattii keessa jiraattan,","poem":1},{"text":"badiin isinitti dhufeera.","poem":2},{"text":"Yeroon gaʼeera; guyyaan dhiʼaateera;","poem":1},{"text":"tulluuwwan irratti gammachuu utuu hin taʼin jeequmsatu taʼa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ani dheekkamsa koo sitti dhangalaasuudhaafan jira;","poem":1},{"text":"aarii koo illee sitti nan baʼa;","poem":2},{"text":"akkuma amala keetiittis sitti nan mura;","poem":1},{"text":"gochaawwan kee jibbisiisoo sana hundaafis sin adaba.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ani gara laafinaan si hin ilaalu","poem":1},{"text":"yookaan si hin baraaru.","poem":2},{"text":"Hamma gochawwan kee jibbisiisoon sun si gidduu jiranitti","poem":1},{"text":"ani akkuma amala keetiitti sin adaba.","poem":2},{"lineBreak":true},"“ ‘Ergasiis akka kan rukutu sun ana Waaqayyo taʼe isin ni beektu."]},{"type":"verse","number":10,"content":[{"text":"“ ‘Guyyaan sun kunoo ti!","poem":1},{"text":"Inni dhufeera!","poem":2},{"text":"Badiin cabsee dhufeera;","poem":1},{"text":"uleen lateera;","poem":2},{"lineBreak":true},{"text":"of tuulummaan daraareera!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gooliin guddatee ulee hammina adabu taʼeera;","poem":1},{"text":"isaan keessaa namni tokko iyyuu hin hafu;","poem":2},{"text":"waldaa isaanii keessaa,","poem":1},{"text":"qabeenya isaaniitii fi","poem":2},{"text":"waan faayidaa qabu keessaa","poem":1},{"text":"tokko iyyuu hin hafu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yeroon sun dhufeera;","poem":1},{"text":"guyyaan sun gaʼeera.","poem":2},{"text":"Inni bitu hin gammadin;","poem":1},{"text":"kan gurgurus hin gaddin;","poem":2},{"lineBreak":true},{"text":"dheekkamsi guutummaa isaaniitti dhufaatii.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hamma lamaan isaanii iyyuu lubbuun jiranitti","poem":1},{"text":"inni lafa gurgure hin deebifatu;","poem":2},{"text":"mulʼanni waaʼee sabaatiif mulʼate","poem":1},{"text":"duubatti hin deebiʼuutii.","poem":2},{"text":"Sababii cubbuu isaaniitiif isaan keessaa namni tokko iyyuu","poem":1},{"text":"lubbuu ofii isaa hin oolfatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ ‘Sababii dheekkamsi koo waldaa hunda irra jiruuf","poem":1},{"text":"isaan malakata afuufanii","poem":2},{"text":"waan hunda qopheeffatan iyyuu,","poem":1},{"text":"namni tokko iyyuu gara adda waraanaa hin dhaqu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Alaan goraadeetu jira;","poem":1},{"text":"keessaan immoo dhaʼichaa fi beelatu jira;","poem":2},{"text":"warri baadiyyaa goraadeedhaan duʼu;","poem":1},{"text":"warri magaalaa keessaa immoo beelaa fi dhaʼichaan dhumu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Baqattoonni warri miliqan","poem":1},{"text":"tulluuwwanitti baqatu.","poem":2},{"text":"Tokkoon tokkoon isaanii","poem":1},{"text":"akkuma gugeewwan sululaa","poem":2},{"lineBreak":true},{"text":"sababii cubbuu isaaniitiif ni aadu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Harki hundi ni naafata;","poem":1},{"text":"jilbi hundinuus bishaan taʼa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Isaan wayyaa gaddaa uffatanii","poem":1},{"text":"sodaadhaan haguugamu.","poem":2},{"text":"Fuulli isaanii qaanii uffata;","poem":1},{"text":"mataan isaaniis ni haadama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“ ‘Isaan meetii isaanii daandiiwwan irratti gatu;","poem":1},{"text":"warqeen isaanii akka waan xuraaʼaa taʼa.","poem":2},{"text":"Guyyaa dheekkamsa Waaqayyootti meetii fi","poem":1},{"text":"warqeen isaanii isaan oolchuu hin dandaʼu.","poem":2},{"text":"Isaan nyaatanii beela hin baʼan","poem":1},{"text":"yookaan garaa isaanii hin guuttatan;","poem":2},{"text":"meetii fi warqeen isaanii isaan gufachiisee","poem":1},{"text":"cubbuutti isaan galcheeraatii.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Isaan faaya bareedaa isaaniitiin of tuulanii","poem":1},{"text":"waaqota isaanii jibbisiisoo fi fakkiiwwan faayidaa hin qabne sana","poem":2},{"lineBreak":true},{"text":"tolchuuf itti fayyadaman.","poem":2},{"text":"Kanaafuu ani wantoota kanneen","poem":1},{"text":"gara waan xuraaʼaatti isaan duraa nan geeddara.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ani harka namoota biyya ormaatti boojuudhaaf,","poem":1},{"text":"hamoota lafaattis saamichaaf dabarsee ishee nan kenna;","poem":2},{"lineBreak":true},{"text":"isaanis isa ni xureessu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ani fuula koo isaan irraa nan deebifadha;","poem":1},{"text":"isaanis iddoo koo jaallatamaa sana ni xureessu;","poem":2},{"lineBreak":true},{"text":"saamtonnis itti seenanii ni xureessu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“ ‘Sababii biyyattiin dhiiga dhangalaasuudhaan,","poem":1},{"text":"magaalattiin immoo gooliidhaan guutamteef","poem":2},{"lineBreak":true},{"text":"foncaa qopheessi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ani akka isaan manneen isaanii dhaalaniif","poem":1},{"text":"warra saboota keessaa akka malee hamoo taʼan nan fida;","poem":2},{"text":"of tuulummaa namoota jajjaboo nan cabsa;","poem":1},{"text":"manneen qulqullummaa isaaniis nan xureessa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yeroo raafamni dhufutti isaan nagaa barbaadu;","poem":1},{"text":"garuu tokko illee hin argatan.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Badiin badii irratti,","poem":1},{"text":"oduunis, oduu irratti ni dhufa.","poem":2},{"text":"Isaan raajii irraa mulʼata argachuu ni yaalu;","poem":1},{"text":"seerri luboota biraa,","poem":2},{"lineBreak":true},{"text":"gorsi immoo maanguddoota biraa ni dhabama.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mootiin ni booʼa;","poem":1},{"text":"ilmi mootii abdii kutata;","poem":2},{"lineBreak":true},{"text":"harki uummata biyyattii ni hollata.","poem":2},{"text":"Ani akkuma hojii isaaniitti gatii isaanii nan kennaaf;","poem":1},{"text":"akkuma seera ofii isaaniittis murtii nan kennaaf.","poem":2},{"lineBreak":true},"“ ‘Ergasiis isaan akka ani Waaqayyo taʼe ni beeku.’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/EZK/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/EZK/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/EZK/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}