{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HAB","translationId":"gaz_bib","name":"Anbaaqoom","commonName":"Anbaaqoom","title":"Raajii Anbaaqoom","order":35,"numberOfChapters":3,"sha256":"2b39a73e95a0b81c1922c9c1adaedbec09f344591025837d26727aa18a1ea5dd","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gaz_bib/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Raajii Anbaaqoom raajichi arge."]},{"type":"line_break"},{"type":"heading","content":["Guungummii Anbaaqoom"]},{"type":"verse","number":2,"content":[{"text":"Yaa Waaqayyo, ani hamma yoomiittin gargaarsaafsitti iyyadha?","poem":1},{"text":"Ati garuu na hin dhaggeeffattu;","poem":2},{"text":"yookaan ani hamma yoomiitti, “Goolii!”","poem":1},{"text":"jedhee sitti booʼee ati garuu na hin oolchitu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ati maaliif akka ani murtii dabe argu na goota?","poem":1},{"text":"Ati maaliif balleessaa namaa obsita?","poem":2},{"text":"Badiisnii fi gooliin fuula koo dura jiru;","poem":1},{"text":"lollii fi waldhabiinsi baayʼateera.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kanaafuu seerri laamshaʼeera;","poem":1},{"text":"murtiin qajeelaan dabsameera.","poem":2},{"text":"Akka murtiin qajeelaan jalʼifamuuf;","poem":1},{"text":"namoonni hamoon qajeelota marsu.","poem":2}]},{"type":"heading","content":["Deebii Waaqayyoo"]},{"type":"verse","number":5,"content":[{"text":"“Saboota hubadhaa ilaalaa;","poem":1},{"text":"akka malees dinqisiifadhaa.","poem":2},{"text":"Ani bara keessan keessa","poem":1},{"text":"waan isin yoo isinitti himame illee","poem":2},{"lineBreak":true},{"text":"hin amanne tokko nan hojjedha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani warra Baabilon,","poem":1},{"text":"uummata gara jabeessaa fi ariifataa,","poem":2},{"text":"kan iddoo jireenya isaa hin taʼin qabachuuf","poem":1},{"text":"guutummaa lafaa keessa yaaʼu sana nan kaasa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Isaan saba sodaatamuu fi naasisuu dha;","poem":1},{"text":"isaan ofii isaaniitiifuu seera;","poem":2},{"lineBreak":true},{"text":"ulfina isaaniis ni guddifatu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Fardeen isaanii qeerransa caalaa saffisu;","poem":1},{"text":"yeeyyii galgalaa caalaa sodaachisu.","poem":2},{"text":"Namoonni isaanii kanneen farda yaabbatanariitiidhaan gulufu;","poem":1},{"text":"abbootiin farda isaaniis fagoodhaa dhufu.","poem":2},{"text":"Isaan akkuma risaa waa nyaachuuf ariifatuu barrisu;","poem":1}]},{"type":"verse","number":9,"content":[{"text":"isaan hundinuu jeequmsaaf dhufu.","poem":2},{"text":"Tuunni isaanii akkuma bubbee gammoojjii gara fuula duraatti qajeela;","poem":1},{"text":"namoota hidhamanis akkuma cirrachaa walitti qaba.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Isaan mootota tuffatanii","poem":1},{"text":"bulchitootatti qoosu.","poem":2},{"text":"Daʼannoo hundatti ni kolfu;","poem":1},{"text":"biyyoos tuulanii isa qabatu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ergasii namoonni yakka hojjetan kanneen humna isaaniiwaaqa isaanii godhatan,","poem":1},{"text":"akka bubbee lafa haxaaʼanii karaa isaanii itti fufu.”","poem":2}]},{"type":"heading","content":["Gungummii Anbaaqoom isa Lammaffaa"]},{"type":"verse","number":12,"content":[{"text":"Yaa Waaqayyo, ati bara baraa jalqabdee jirta mitii?","poem":1},{"text":"Yaa Waaqa ko, yaa Qulqullicha ko, ati gonkumaa hin duutu.","poem":2},{"text":"Yaa Waaqayyo, ati akka isaan murtii kennaniifisaan muuddeerta;","poem":1},{"text":"yaa Kattaa ko, ati akka isaan nama adabaniif isaan ramaddeerta.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iji kee akka waan hamaa hin ilaalleef akka malee qulqulluu dha;","poem":1},{"text":"ati daba argitee obsaan dhiisuu hin dandeessu.","poem":2},{"text":"Yoos ati maaliif obsaan namoota hamoo ilaalta?","poem":1},{"text":"Ati maaliif yeroo namoonni hamoon","poem":2},{"lineBreak":true},{"text":"warra isaan caalaa qajeeloo taʼan liqimsanitti calʼistaa?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ati namoota akka qurxummii galaana keessaa,","poem":1},{"text":"akka uumamawwan galaanaa kanneen bulchaahin qabnee gooteerta.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Diinni hokkoodhaan isaan hunda ol baasa;","poem":1},{"text":"kiyyoo isaatiinis isaan harkisa;","poem":2},{"text":"kiyyoo isaa keessatti walitti isaan qabata;","poem":1},{"text":"kanaafuu inni ni gammada; ni ililchas.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Inni sababii kiyyoo isaatiin bashannanee","poem":1},{"text":"nyaata isaa filatamaatti gammaduuf","poem":2},{"text":"kiyyoo isaatiif aarsaa dhiʼeessa;","poem":1},{"text":"kiyyoo isaatiif illee ixaana aarsa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Inni kiyyoo isaa keessaa garagalchuudhaan,","poem":1},{"text":"gara laafina malee ittuma fufee saboota balleessuu qabaa?","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/HAB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/HAB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/NAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}