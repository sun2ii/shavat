{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HAB","translationId":"gaz_bib","name":"Anbaaqoom","commonName":"Anbaaqoom","title":"Raajii Anbaaqoom","order":35,"numberOfChapters":3,"sha256":"2b39a73e95a0b81c1922c9c1adaedbec09f344591025837d26727aa18a1ea5dd","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gaz_bib/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Ani iddoo koo dhaabadhee","poem":1},{"text":"dallaa eegumsaa irra nan tura;","poem":2},{"text":"mee waan inni naan jedhu arguuf","poem":1},{"text":"deebii ani guungummii kanaaf kennuu malu beekuuf nan ilaala.","poem":2}]},{"type":"heading","content":["Deebii Waaqayyoo"]},{"type":"verse","number":2,"content":["Ergasii Waaqayyo akkana jedhee deebii kenne:",{"text":"“Akka namni dubbisu tokko qabatee fiiguuf,","poem":1},{"text":"mulʼata sana ifa godhii","poem":2},{"lineBreak":true},{"text":"gabatee irratti barreessi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mulʼanni kun yeroo murtaaʼe tokko eeggataatii;","poem":1},{"text":"inni waaʼee dhuma isaa dubbata malee hin sobu.","poem":2},{"text":"Yoo tures isa eegi;","poem":1},{"text":"inni dhugumaan ni dhufa; hin turus.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Kunoo inni of bokokseera;","poem":1},{"text":"hawwiin isaas sirrii miti;","poem":2},{"lineBreak":true},{"text":"namni qajeelaan garuu amantii isaatiin jiraata;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"dhugumaan inni daadhii wayiniitiin ni gowwoomfama;","poem":1},{"text":"of tuula; boqonnaas hin qabu.","poem":2},{"text":"Inni akkuma siiʼool sassata;","poem":1},{"text":"akka duʼaas kan hin quufnee dha.","poem":2},{"text":"Inni saboota hunda walitti qabata;","poem":1},{"text":"uummata hundas boojiʼee fudhata.","poem":2}]},{"type":"verse","number":6,"content":["“Isaan hundi isa tuffatanii itti kolfaa,",{"text":"“ ‘Nama miʼa hatame tuullatee","poem":1},{"text":"saamichaan of sooromsuuf wayyoo!","poem":2},{"lineBreak":true},{"text":"Wanni kun hamma yoomiitti itti fufa’jedhanii itti hin qoosanii?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Warri liqii sirraa qaban akkuma tasaa sitti hin kaʼanii?","poem":1},{"text":"Isaan kaʼanii si hin hollachiisanii?","poem":2},{"lineBreak":true},{"text":"Ergasii ati harka isaanii jala galta.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sababii ati saba hedduu saamteef","poem":1},{"text":"namoonni hafan si saamu.","poem":2},{"text":"Ati dhiiga namaa dhangalaafteertaatii;","poem":1},{"text":"ati biyyoota, magaalaawwanii finamoota isaan keessa jiraatan hunda balleessiteerta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Nama buʼaa hin malleen mana ijaarratu","poem":1},{"text":"kan badiisa jalaa baʼuuf jedhee","poem":2},{"lineBreak":true},{"text":"lafa ol kaʼaa irratti iddoo jireenyaa tolfatuuf wayyoo!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ati lubbuu nama baayʼee galaafachuudhaaf,","poem":1},{"text":"waan nama qaanessu mana keetti malatteelubbuu keetti badiisa fidde.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dhagaawwan keenyan keessaa iyyu;","poem":1},{"text":"demdemoon mukaas jalaa qaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Nama dhiiga dhangalaasuudhaan magaalaa ijaaruuf,","poem":1},{"text":"kan yakkaan magaalaa hundeessuuf wayyoo!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Akka dadhabbiin namaa akkuma qoraan ibiddaa taʼe,","poem":1},{"text":"akka saboonnis akkasumaan of dadhabsiisan","poem":2},{"lineBreak":true},{"text":"Waaqayyoon Waan Hunda Dandaʼu murteesseera mitii?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Akkuma bishaan galaana guutu sana","poem":1},{"text":"lafti ulfina Waaqayyoon beekuutiin guutamtiitii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Nama qullaa dhagna ollaa isaa ilaaluuf jedhee","poem":1},{"text":"hamma inni machaaʼutti","poem":2},{"lineBreak":true},{"text":"qalqalloo keessaa daadhii wayinii isaaf buusuuf wayyoo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ati qooda ulfinaa qaaniidhaan guutamta.","poem":1},{"text":"Amma dabareen kan kee ti! Akka qullaan kee mulʼatuuf dhugi.","poem":2},{"text":"Xoofoon mirga Waaqayyoo sitti garagala;","poem":1},{"text":"salphinnis ulfina kee haguuga.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Fincilli ati Libaanoonitti hojjete si liqimsa;","poem":1},{"text":"horii fixuun kee si rifachiisa.","poem":2},{"text":"Ati dhiiga namaa dhangalaafteertaatii;","poem":1},{"text":"ati biyyoota, magaalaawwanii fi namoota isaan keessa jiraatanhunda balleessiteerta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Waaqni tolfamaan ogeessa harkaatiin soofamu","poem":1},{"text":"yookaan fakkiin soba barsiisu faayidaa maalii qaba?","poem":2},{"text":"Namni isa tolchu tokko hojiidhuma harka isaa amanataatii;","poem":1},{"text":"inni waaqota tolfamoo dubbachuu hin dandeenye tolcha.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nama mukaan, ‘Dammaqi!’","poem":1},{"text":"yookaan dhagaa lubbuu hin qabneen, ‘Kaʼi!’ jedhuuf wayyoo.","poem":2},{"text":"Inni barsiisuu ni dandaʼaa?","poem":1},{"text":"Kunoo inni warqee fi meetii dibameera;","poem":2},{"lineBreak":true},{"text":"hafuurri tokko iyyuu isa keessa hin jiru.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Waaqayyo garuu mana qulqullummaa isaaqulqulluu sana keessa jira;","poem":1},{"text":"lafti hundi fuula isaa duratti haa calʼistu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/HAB/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/HAB/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/HAB/1.json","previousChapterAudioLinks":{},"numberOfVerses":20}