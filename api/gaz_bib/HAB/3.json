{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HAB","translationId":"gaz_bib","name":"Anbaaqoom","commonName":"Anbaaqoom","title":"Raajii Anbaaqoom","order":35,"numberOfChapters":3,"sha256":"2b39a73e95a0b81c1922c9c1adaedbec09f344591025837d26727aa18a1ea5dd","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gaz_bib/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["Kadhannaa Anbaaqoom"]},{"type":"verse","number":1,"content":[{"text":"Kadhannaa Anbaaqoom raajichaa shigiyonootiidhaan.","descriptive":true},{"noteId":0}]},{"type":"verse","number":2,"content":[{"text":"Yaa Waaqayyo, ani oduu kee dhagaʼeera;","poem":1},{"text":"yaa Waaqayyo, ani gochawwan kee nan sodaadha.","poem":2},{"text":"Bara keenya keessa isaan haaromsi;","poem":1},{"text":"jabana keenya keessa isaan beekkamsiisi;","poem":2},{"lineBreak":true},{"text":"yeroo dheekamtutti araara yaadadhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Waaqni Teemaan irraa,","poem":1},{"text":"Inni Qulqullichi Tulluu Phaaraaniitii dhufe.","poem":2},{"text":"Ulfinni isaa samiiwwan haguuge;","poem":1},{"text":"galanni isaas lafa guute.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Miidhaginni isaa akkuma baʼiisa aduu ti;","poem":1},{"text":"gaanfawwan lama harka isaatii baʼu;","poem":2},{"lineBreak":true},{"text":"humni isaas achi dhokateera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Fuula isaa dura dhaʼichatu deeme;","poem":1},{"text":"golfaanis isa duukaa buʼe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inni dhaabatee lafa raase;","poem":1},{"text":"ilaalee akka saboonni hollatan godhe.","poem":2},{"text":"Tulluuwwan durii ni burkutaaʼan;","poem":1},{"text":"gaarran bara hedduu jiraatanis ni diigaman.","poem":2},{"lineBreak":true},{"text":"Karaan isaa kan bara baraa ti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ani utuu dunkaanonni Itoophiyaa dhiphatanuu nan arge;","poem":1},{"text":"golgaawwan Midiyaaniis ni hollatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yaa Waaqayyo, ati lageenitti aartee turtee?","poem":1},{"text":"Burqaawwanittis dheekkamtee?","poem":2},{"text":"Ati yeroo fardeen keetiin guluftetti,","poem":1},{"text":"yeroo gaariiwwan moʼannaa kee yaabbatetti","poem":2},{"lineBreak":true},{"text":"galaanatti dheekkamtee turtee?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ati iddaa kee luqqifattee","poem":1},{"text":"xiyya itti dhaabbatte.","poem":2},{"text":"Lafas lageeniin gargar baqaqsite;","poem":1}]},{"type":"verse","number":10,"content":[{"text":"tulluuwwan si arganii hollattan.","poem":2},{"text":"Dhaʼaawwan bishaanii achiin darban;","poem":1},{"text":"tuujubni ni huurse;","poem":2},{"lineBreak":true},{"text":"dambalii isaas ol kaase.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Sababii xiyya kee calaqqisaa fiigu sanaatii fi","poem":1},{"text":"sababii ifa eeboo keetii sanaatiif aduu fi","poem":2},{"lineBreak":true},{"text":"jiʼi samii keessa dhaabatanii hafan.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ati dheekkamsaan lafa irra marmaarte;","poem":1},{"text":"aariidhaanis saboota lafatti dhidhiitte.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ati saba kee furuuf,","poem":1},{"text":"dibamaa kee oolchuuf dhufte.","poem":2},{"text":"Hoogganaa biyya hamootaa ni daakte;","poem":1},{"text":"mataadhaa hamma miillaatti qullaa isa hambifte.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yeroo loltoonni isaa nu bittinneessuuf kaʼanii,","poem":1},{"text":"akkuma waan rakkattoota dhokatanii jiran","poem":2},{"text":"fixuu gaʼaniitti gammadanitti,","poem":1},{"text":"ati eeboo ofii isaatiin mataa isaa waraante.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ati fardeen keetiin bishaanota gurguddaa","poem":1},{"text":"hoomacheessaa galaana irra deemte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ani dhagaʼeen garaan koo raafame;","poem":1},{"text":"hidhiin koo sagalee sanaan hollate;","poem":2},{"text":"tortorri lafee koo seene;","poem":1},{"text":"miilli koos ni hollate.","poem":2},{"text":"Taʼus ani hamma guyyaan badiisaa","poem":1},{"text":"saboota nu weeraranitti dhufutti obsaan nan eeggadha.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yoo mukni harbuu daraaruu baatee","poem":1},{"text":"iji wayinii muka wayinii irra jiraachuu baate iyyuu,","poem":2},{"text":"yoo mukni ejersaa ija naqachuu didee","poem":1},{"text":"lafti qotiisaa midhaan dhowwate iyyuu,","poem":2},{"text":"yoo hoolonni gola keessaa,","poem":1},{"text":"loonis dallaa keessaa dhabaman iyyuu,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ani garuu Waaqayyotti nan gammada;","poem":1},{"text":"Waaqa isa na fayyisutti nan gammada.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Waaqayyo Gooftaan jabina koo ti;","poem":1},{"text":"inni miilla koo akka miilla borofaa godha;","poem":2},{"lineBreak":true},{"text":"lafa ol kaʼaa irras na deemsisa.","poem":2},{"text":"Dura buʼaa faarfannaatiif. Meeshaa koo kan ribuutiin kan faarfatame.","descriptive":true}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Shigiyootiin gosa muuziiqaa ti.","reference":{"chapter":3,"verse":1}}]},"thisChapterLink":"/api/gaz_bib/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}