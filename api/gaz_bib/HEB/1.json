{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HEB","translationId":"gaz_bib","name":"Ibroota","commonName":"Ibroota","title":"Ibroota","order":58,"numberOfChapters":13,"sha256":"f20ebaefc59711748a84fbcec49b4a7ef7939fe325cf9bf3ceb4748d6fd84372","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/gaz_bib/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Dubbii Waaqayyoo Kan Xumuraa: Ilma Isaa"]},{"type":"verse","number":1,"content":["Bara durii Waaqni yeroo baayʼee fi karaa adda addaatiin raajotaan abbootii keenyatti dubbatee ture;"]},{"type":"verse","number":2,"content":["bara dhumaa kana keessa garuu Ilma isaa kan inni dhaaltuu waan hundumaa godhee muudeen nutti dubbate; isumaanis addunyaawwan uume."]},{"type":"verse","number":3,"content":["Ilmi calaqqisa ulfina Waaqaa ti; eenyummaa Waaqaas akkuma jirutti mulʼisa; dubbii isaa humna qabeessa sanaanis waan hunda hirkisee baata. Innis erga cubbuu keenya nurraa qulqulleessee booddee samii irra mirga Waaqa ulfina qabeessa sanaa taaʼe."]},{"type":"verse","number":4,"content":["Akkuma maqaan inni dhaale sun kan ergamootaa caalaa guddaa taʼe sana innis ergamoota caalaa guddaa dha."]},{"type":"heading","content":["Ilmi Ergamoota Caaluu Isaa"]},{"type":"verse","number":5,"content":["Waaqni ergamoota keessaa isa kamiin,",{"text":"“Ati Ilma koo ti;","poem":1},{"text":"ani harʼa si dhalcheera”","poem":2},{"noteId":0},"Yookaan isa kamiin,",{"text":"“Ani isaaf Abbaa nan taʼa;","poem":1},{"text":"innis Ilma naa taʼa”","poem":2},{"noteId":1},"jedhee beeka?"]},{"type":"verse","number":6,"content":["Akkasumas Waaqni yommuu Ilma isaa hangafa gara addunyaa kanaatti ergutti,",{"text":"“Ergamoonni Waaqaa hundi isa haa waaqeffatan”","poem":1},{"noteId":2},"jedha."]},{"type":"verse","number":7,"content":["Yommuu waaʼee ergamootaa dubbatus,",{"text":"“Inni ergamoota isaa hafuurota,","poem":1},{"text":"tajaajiltoota isaa immoo arraba ibiddaa godha”","poem":2},{"noteId":3},"jedha."]},{"type":"verse","number":8,"content":["Waaʼee Ilmaa garuu akkana jedha;",{"text":"“Yaa Waaqayyo, teessoon kee bara baraa hamma bara baraatti ni jiraata;","poem":1},{"text":"bokkuun qajeelummaas bokkuu mootummaa keetii ni taʼa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ati qajeelummaa jaallatte; jalʼina immoo ni jibbite;","poem":1},{"text":"kanaafuu Waaqayyo Waaqni kee zayitii gammachuutiin si dibee,","poem":2},{"lineBreak":true},{"text":"hiriyoota kee si caalchise.”","poem":2},{"noteId":4}]},{"type":"verse","number":10,"content":["Akkasumas inni akkana jedha;",{"text":"“Yaa Gooftaa, ati jalqabatti lafa hundeessite;","poem":1},{"text":"samiiwwanis hojii harka keetii ti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isaan ni badu; ati garuu ni jiraatta;","poem":1},{"text":"hundumti isaanii akkuma uffataa ni moofaʼu;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ati akkuma wayyaatti isaan marta;","poem":1},{"text":"isaan akkuma uffataatti geeddaramu;","poem":2},{"text":"ati garuu sanuma;","poem":1},{"text":"umuriin kees gonkumaa dhuma hin qabu.”","poem":2},{"noteId":5}]},{"type":"verse","number":13,"content":["Waaqni ergamoota keessaa isa kamiin,",{"text":"“Hamma ani diinota kee ejjeta miilla keetii godhutti,","poem":1},{"text":"gara mirga koo taaʼi”","poem":2},{"noteId":6},"jedhe?"]},{"type":"verse","number":14,"content":["Ergamoonni hundinuu hafuurota tajaajilan kanneen warra fayyina dhaalan tajaajiluuf ergaman mitii?"]}],"footnotes":[{"noteId":0,"caller":"+","text":"Far 2:7","reference":{"chapter":1,"verse":5}},{"noteId":1,"caller":"+","text":"2Sm 7:14; 1Sn 17:13","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"Far 104:4","reference":{"chapter":1,"verse":6}},{"noteId":3,"caller":"+","text":"Far 104:4","reference":{"chapter":1,"verse":7}},{"noteId":4,"caller":"+","text":"Far 45:6,7","reference":{"chapter":1,"verse":9}},{"noteId":5,"caller":"+","text":"Far 102:25‑27","reference":{"chapter":1,"verse":12}},{"noteId":6,"caller":"+","text":"Far 110:1","reference":{"chapter":1,"verse":13}}]},"thisChapterLink":"/api/gaz_bib/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}