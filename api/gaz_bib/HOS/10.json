{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HOS","translationId":"gaz_bib","name":"Hooseʼaa","commonName":"Hooseʼaa","title":"Raajii Hooseʼaa","order":28,"numberOfChapters":14,"sha256":"52ac54c61d16e6f1d07988124c4b6ac96c3714a87c6a33a4b40db5b4f23d4e54","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gaz_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Israaʼel muka wayinii dagaage ture;","poem":1},{"text":"inni matuma isaatiif ija naqata.","poem":2},{"text":"Akkuma iji isaa baayʼateen","poem":1},{"text":"inni iddoo aarsaa hedduu ijaarrate;","poem":2},{"text":"akkuma lafti isaa gabbatteen","poem":1},{"text":"utubaawwan waaqeffannaa isaa miidhagfate.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Garaan isaanii gowwoomsaadhaan guutameera;","poem":1},{"text":"isaan amma yakka isaanii baadhachuu qabu.","poem":2},{"text":"Waaqayyo iddoo aarsaa isaanii ni diiga;","poem":1},{"text":"utubaawwan waaqeffannaa isaaniis ni barbadeessa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ergasii isaan akkana jedhu;","poem":1},{"text":"“Nu sababii Waaqayyoon sodaachuu didneef mootii hin qabnu.","poem":2},{"text":"Garuu utuu mootii qabaanne iyyuu","poem":1},{"text":"inni silaa maal nuuf godha?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isaan waan hedduu waadaa galu;","poem":1},{"text":"kakuu sobaas seenanii","poem":2},{"lineBreak":true},{"text":"walii galtee uummatu;","poem":2},{"text":"kanaafuu seera dhabeeyyiin","poem":1},{"text":"akkuma aramaa summii qabu kan lafa qotiisaa keessaatti latu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Namoonni Samaariyaa keessa jiraatan","poem":1},{"text":"sababii waaqa tolfamaa fakkii jabbiikan Beet Aawwen keessaa sanaatiif sodaatu.","poem":2},{"text":"Sabni ishee isheedhaaf booʼa.","poem":1},{"text":"Luboonni ishee ejjitoonni","poem":2},{"text":"warri ulfina isheetiin gammadan sunis","poem":1},{"text":"sababii isheen isaan irraa boojiʼamteef ni booʼu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Jabbichis akka harka fuudhaatti","poem":1},{"text":"Yaariim mootichaaf Asooritti geeffama.","poem":2},{"text":"Efreem ni salphifama;","poem":1},{"text":"Israaʼel waaqota ishee kanneen muka irraa tolfamaniif ni qaanofti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Samaariyaa fi mootiin ishee","poem":1},{"text":"akkuma hoomacha bishaan irraatti fudhatamanii badu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iddoowwan sagadaa kanneen Awween ni barbadeeffamu;","poem":1},{"text":"kunis cubbuu Israaʼel.","poem":2},{"text":"Qoraattii fi sokorruun irratti biqilee","poem":1},{"text":"iddoo aarsaa isaanii haguuga.","poem":2},{"text":"Yeroo sana namoonni tulluuwwaniin, “Nurratti jigaa!”","poem":1},{"text":"gaarraniin immoo, “Nu dhoksaa!” jedhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Yaa Israaʼel isin bara Gibeʼaatii jalqabdaniicubbuu hojjettaniirtu;","poem":1},{"text":"ammas achumatti haftaniirtu.","poem":2},{"text":"Gibeʼaa keessatti waraanni kaʼee","poem":1},{"text":"jalʼoota hin fixuu?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani yoon fedhe isaan nan adaba;","poem":1},{"text":"sababii cubbuu isaanii dachaa sanaatiif","poem":2},{"lineBreak":true},{"text":"hidhaa keessa isaan buusuufsaboonni naannoo isaaniitti walitti qabamu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efreem goromsa leenjifame","poem":1},{"text":"kan midhaan siribsiisuu jaallatuu dha;","poem":2},{"text":"kanaafuu ani morma ishee irra","poem":1},{"text":"waanjoo nan kaaʼa.","poem":2},{"text":"Ani Efreemin nan oofa;","poem":1},{"text":"Yihuudaan lafa qotiisaa qotuu qaba;","poem":2},{"lineBreak":true},{"text":"Yaaqoobis biyyoo bulleessuu qaba.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ofii keessaniif qajeelummaa facaafadhaatii","poem":1},{"text":"ija jaalalaa kan hin dhumne haammadhaa;","poem":2},{"text":"lafa keessan kan hin qotamin illee baqaqsaa;","poem":1},{"text":"yeroon kun yeroo hamma inni dhufee","poem":2},{"text":"qajeelummaa isinitti roobsutti","poem":1},{"text":"Waaqayyoon barbaaddataniitii.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Isin garuu hammina facaafattanii","poem":1},{"text":"jalʼina haammattan;","poem":2},{"lineBreak":true},{"text":"isin ija sobaa nyaattaniirtu.","poem":2},{"text":"Sababii ati jabina keetii fi","poem":1},{"text":"loltoota kee baayʼee sana abdatteef,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"akkuma Shalmaan gaafa lolaatti Beet Arbeelin balleessee","poem":1},{"text":"haadhota ijoollee isaanii wajjin biyyootti makaman sana,","poem":2},{"text":"daʼannoowwan kee hundi ni barbadaaʼu;","poem":1},{"text":"huursaan waraanaas saba keetti ni kaʼa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yaa Beetʼeel, sababii hamminni kee akka malee guddaa taʼeef,","poem":1},{"text":"wanni akkasii sittis ni dhufti.","poem":2},{"text":"Gaafa guyyaan sun bariʼutti","poem":1},{"text":"mootiin Israaʼel guutumaan guutuutti ni barbadeeffama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}