{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HOS","translationId":"gaz_bib","name":"Hooseʼaa","commonName":"Hooseʼaa","title":"Raajii Hooseʼaa","order":28,"numberOfChapters":14,"sha256":"52ac54c61d16e6f1d07988124c4b6ac96c3714a87c6a33a4b40db5b4f23d4e54","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gaz_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"heading","content":["Jaalala Waaqni Israaʼeliif Qabu"]},{"type":"verse","number":1,"content":[{"text":"“Israaʼel yeroo daaʼima turetti, ani isa nan jaalladhe;","poem":1},{"text":"ani Gibxii ilma koo waameera.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Garuu hammuma ani itti deddeebiʼee isaan waamu,","poem":1},{"text":"isaan narraa fagaachaa deeman.","poem":2},{"text":"Isaan Baʼaaliif aarsaa dhiʼeessanii","poem":1},{"text":"fakkiiwwaniif ixaana aarsan.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kan irree isaanii qabee Efreemin","poem":1},{"text":"miillaan deemuu barsiise anuma;","poem":2},{"text":"isaan garuu akka ani","poem":1},{"text":"isaan fayyise hin hubanne.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ani funyoo gara laafina namaatiin,","poem":1},{"text":"hidhaa jaalalaatiinis isaan nan harkise;","poem":2},{"text":"ani morma isaanii irraa waanjoo fuudhee","poem":1},{"text":"isaan sooruuf gadan jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Isaan qalbii jijjiirrachuu waan didaniif","poem":1},{"text":"Gibxitti hin deebiʼan;","poem":2},{"lineBreak":true},{"text":"Asoor garuu isaan bulcha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Goraadeen magaalaawwan isaanii keessatti balaqqisa;","poem":1},{"text":"raajota sobduu isaanii ni barbadeessa;","poem":2},{"lineBreak":true},{"text":"karoora isaaniis ni fashaleessa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sabni koo narraa deebiʼuuf kutateera.","poem":1},{"text":"Yoo isaan Waaqa Waan Hundaa Olii waammatan iyyuu","poem":2},{"lineBreak":true},{"text":"inni gonkumaa ol isaan hin qabu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Yaa Efreem ani akkamiinan dandaʼee si dhiisa?","poem":1},{"text":"Yaa Israaʼel ani akkamiinan dabarsee si kenna?","poem":2},{"text":"Ani akkamiinan dandaʼee akka Adimaa si godha?","poem":1},{"text":"Akkamiinan akka Zebooʼiim si godha?","poem":2},{"text":"Garaan koo na keessatti geeddarameera;","poem":1},{"text":"gara laafinni ani siif qabu guddateera.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ani dheekkamsa koo sodaachisaa sana gad hin dhiisu;","poem":1},{"text":"yookaan ani deebiʼee Efreemin hin balleessu.","poem":2},{"text":"Ani Waaqa malee nama miti;","poem":1},{"text":"ani Isa Qulqulluu gidduu kee jiruu dha.","poem":2},{"lineBreak":true},{"text":"Ani dheekkamsaan hin dhufu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Isaan Waaqayyoon duukaa buʼu;","poem":1},{"text":"inni akkuma leencaa aada;","poem":2},{"text":"yommuu inni aadutti","poem":1},{"text":"ilmaan isaa hollachaa lixa biiftuutii dhufu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isaan akkuma simbirroo Gibxi irraa,","poem":1},{"text":"akkuma gugee ollachaa","poem":2},{"lineBreak":true},{"text":"Asoor irraa dhufu.","poem":2},{"text":"Ani mana isaanii keessa isaan nan jiraachisa”","poem":1},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"heading","content":["Cubbuu Israaʼel"]},{"type":"verse","number":12,"content":[{"text":"Efreem sobaan, manni Israaʼel immoo","poem":1},{"text":"gowwoomsaadhaan na marse.","poem":2},{"text":"Yihuudaanis Waaqatti,","poem":1},{"text":"amanamaa Qulqullicha Sanatti iyyuu fincile.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}