{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HOS","translationId":"gaz_bib","name":"Hooseʼaa","commonName":"Hooseʼaa","title":"Raajii Hooseʼaa","order":28,"numberOfChapters":14,"sha256":"52ac54c61d16e6f1d07988124c4b6ac96c3714a87c6a33a4b40db5b4f23d4e54","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gaz_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Efreem bubbee nyaata;","poem":1},{"text":"inni guyyaa guutuu bubbee baʼa biiftuu duukaa fiiga;","poem":2},{"lineBreak":true},{"text":"sobaa fi gooliis ni baayʼisa.","poem":2},{"text":"Inni Asoor wajjin walii galtee godhatee","poem":1},{"text":"biyya Gibxiitti zayitii ejersaa erga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Waaqayyo waan Yihuudaa himatu qaba;","poem":1},{"text":"inni akkuma amala isaatti Yaaqoobin adaba;","poem":2},{"lineBreak":true},{"text":"akkuma hojii isaattis gatii isaa kennaaf.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inni gadameessa keessatti koomee obboleessa isaa qabe;","poem":1},{"text":"erga guddatee immoo Waaqa wajjin walʼaansoo qabe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inni ergamaa Waaqaa wajjin walʼaansoo qabee moʼate;","poem":1},{"text":"booʼees surraa kadhate.","poem":2},{"text":"Inni Beetʼeelitti isa argatee","poem":1},{"text":"achitti isa wajjin haasaʼe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Waaqayyo Waaqa Waan Hunda Dandaʼu,","poem":1},{"text":"maqaan isaa Waaqayyo!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ati garuu Waaqa keetti deebiʼi;","poem":1},{"text":"jaalalaa fi murtii qajeelaa jabeessii","poem":2},{"lineBreak":true},{"text":"yeroo hunda Waaqa kee eeggadhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Daldalaan madaalii sobaa ofi harkaa qabu","poem":1},{"text":"nama gowwoomsuu jaallata.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Efreem akkana jedhee boona;","poem":1},{"text":"“Ani akka malee sooressa; qabeenya guddaa argadheera.","poem":2},{"text":"Isaan qabeenya koo kana hunda keessatti iyyuu","poem":1},{"text":"balleessaa yookaan cubbuu tokko illeenarratti argachuu hin dandaʼan.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ani Waaqayyo Waaqa kee","poem":1},{"text":"kan biyya Gibxii si baasee dha;","poem":2},{"text":"ani akka ati akkuma guyyaa ayyaanota keekanneen murteeffaman sanaatti","poem":1},{"text":"deebitee dunkaana keessa jiraattu sin godha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani raajotatti dubbadhee","poem":1},{"text":"mulʼata hedduu kenneefii","poem":2},{"lineBreak":true},{"text":"karaa isaaniitiin fakkeenyaan nan dubbadhe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Giliʼaad hamaadhaa?","poem":1},{"text":"Sabni ishee faayidaa hin qabu!","poem":2},{"text":"Isaan Gilgaal keessatti korma qaluu?","poem":1},{"text":"Iddoon aarsaa isaanii akkuma tuullaa dhagaa isa lafa qotiisaa","poem":2},{"lineBreak":true},{"text":"kan qotame irra jiruu ni taʼa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yaaqoob gara Sooriyaatti baqate;","poem":1},{"text":"Israaʼel niitii argachuuf nama tajaajile;","poem":2},{"lineBreak":true},{"text":"gabbara ishee baasuufis hoolota tikse.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Waaqayyo biyya Gibxiitii Israaʼelin baasuufraajiitti fayyadame;","poem":1},{"text":"inni karuma raajii sanaatiin isa kunuunse.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Efreem garuu aarii isaa guddicha kakaase;","poem":1},{"text":"Gooftaan isaa yakka dhiiga namaa dhangalaasuu sanaisumatti deebisa;","poem":2},{"lineBreak":true},{"text":"arrabsoo isaas matuma isaatti deebisa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}