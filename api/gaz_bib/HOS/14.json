{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HOS","translationId":"gaz_bib","name":"Hooseʼaa","commonName":"Hooseʼaa","title":"Raajii Hooseʼaa","order":28,"numberOfChapters":14,"sha256":"52ac54c61d16e6f1d07988124c4b6ac96c3714a87c6a33a4b40db5b4f23d4e54","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gaz_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"heading","content":["Eebba Argachuudhaaf Qalbii Jijjiirrachuu"]},{"type":"verse","number":1,"content":[{"text":"Yaa Israaʼel, gara Waaqayyo Waaqa keetiitti deebiʼi.","poem":1},{"text":"Ati sababii cubbuu keetiitiif gufatteetii!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dubbicha fudhadhuutii","poem":1},{"text":"gara Waaqayyoo deebiʼi.","poem":2},{"text":"Akkanas jedhiin:","poem":1},{"text":"“Cubbuu keenya hunda nuuf dhiisi;","poem":2},{"text":"akka nu ija arraba keenyaa siif dhiʼeessinuuf,","poem":1},{"text":"arjummaadhaan nu simadhu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asoor nu oolchuu hin dandaʼu;","poem":1},{"text":"nu fardeen lolaa hin yaabbannu.","poem":2},{"text":"Nu siʼachi deebinee, waan harki keenya hojjeteen,","poem":1},{"text":"‘Waaqota keenya’ hin jennu;","poem":2},{"lineBreak":true},{"text":"daaʼimman abbaa hin qabne gara laafina sirraa argatuutii.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ani gantummaa isaanii nan fayyisa,","poem":1},{"text":"toluman isaan jaalladha;","poem":2},{"lineBreak":true},{"text":"aariin koo isaan irraa deebiʼeeraatii.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ani Israaʼelitti akkuma fixeensaa nan taʼa;","poem":1},{"text":"inni akkuma daraaraa ni daraara.","poem":2},{"text":"Inni akkuma gaattiraa Libaanoon","poem":1},{"text":"hidda isaa gad fageeffata;","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"dameen isaa ni guddata.","poem":2},{"text":"Miidhaginni isaa akkuma muka ejersaa taʼa;","poem":1},{"text":"urgaan isaa akkuma gaattiraa Libaanoon.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Namoonni ammas deebiʼanii gaaddisa isaa jala jiraatu.","poem":1},{"text":"Inni akkuma midhaanii lalisa.","poem":2},{"text":"Akkuma muka wayinii dagaaga;","poem":1},{"text":"maqaan isaas akkuma daadhii wayinii Libaanoon beekama.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yaa Efreem, ani kana caalaawaaqota tolfamoo wajjin dhimma maaliin qaba?","poem":1},{"text":"Kan deebii siif kennee si eegu anuma.","poem":2},{"text":"Ani akkuma muka birbirsa lalisaa ti;","poem":1},{"text":"amanamummaan kee ana irraa dhufa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Namni ogeessi eenyu? Inni waan kana ni beeka.","poem":1},{"text":"Qalbii qabeessi eenyu? Inni waan kana ni hubata.","poem":2},{"text":"Karaan Waaqayyoo qajeelaa dha;","poem":1},{"text":"namni qajeelaan isa irra deema;","poem":2},{"lineBreak":true},{"text":"finciltoonni garuu isa irratti gufatu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}