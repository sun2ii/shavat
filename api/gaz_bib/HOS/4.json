{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HOS","translationId":"gaz_bib","name":"Hooseʼaa","commonName":"Hooseʼaa","title":"Raajii Hooseʼaa","order":28,"numberOfChapters":14,"sha256":"52ac54c61d16e6f1d07988124c4b6ac96c3714a87c6a33a4b40db5b4f23d4e54","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gaz_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"heading","content":["Himatamuu Israaʼel"]},{"type":"verse","number":1,"content":[{"text":"Yaa Israaʼeloota, Waaqayyo isin warra biyyattii keessa jiraattan irratti","poem":1},{"text":"himata dhiʼeeffatu waan qabuuf","poem":2},{"lineBreak":true},{"text":"dubbii Waaqayyoo dhagaʼaa:","poem":2},{"text":"“Biyyattii keessa amanamummaan,","poem":1},{"text":"jaalallii fi Waaqa beekuun hin jiru.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abaaruu, sobuu fi ajjeesuu,","poem":1},{"text":"hannaa fi ejja qofatu jira;","poem":2},{"text":"isaan kakuu hunda ni cabsu;","poem":1},{"text":"dhiiga dhangalaasuutu baayʼata.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sababii kanaaf biyyattiin ni gadditi;","poem":1},{"text":"warri ishee keessa jiraatan hundis ni badu;","poem":2},{"text":"bineensonni bosonaa, simbirroonni samiitii fi","poem":1},{"text":"qurxummiin galaanaa dhumaa jiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Garuu namni tokko iyyuu dubbii hin kaasin;","poem":1},{"text":"namni tokko iyyuu nama kaan hin himatin;","poem":2},{"text":"sabni keessan","poem":1},{"text":"akkuma nama luba himatu tokkoo ti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ati halkanii fi guyyaa gufatta;","poem":1},{"text":"raajonnis isin wajjin gufatu.","poem":2},{"text":"Kanaafuu ani haadha kee nan balleessa;","poem":1}]},{"type":"verse","number":6,"content":[{"text":"sabni koo beekumsa dhabuudhaan badeera.","poem":2},{"lineBreak":true},{"text":"“Waan ati beekumsa tuffatteef","poem":1},{"text":"anis akka ati luba naaf hin taaneef si tuffadheera;","poem":2},{"text":"sababii ati seera Waaqa keetii gatteef","poem":1},{"text":"anis ilmaan kee nan gata.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Luboonni akkuma baayʼachaa deemaniin,","poem":1},{"text":"akkasuma cubbuu natti hojjechuu baayʼisan;","poem":2},{"lineBreak":true},{"text":"isaan ulfina isaanii salphinatti geeddaraniiru.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Isaan cubbuu saba kootii nyaatu;","poem":1},{"text":"hammina isaaniis ni hawwu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wanni kunis akkuma sabaa, akkuma lubootaa taʼa.","poem":1},{"text":"Anis sababii karaa isaaniitiiflachan isaanii iyyuu nan adaba;","poem":2},{"lineBreak":true},{"text":"hojii isaaniis isaanumatti nan deebisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Isaan ni nyaatu; garuu hin quufan;","poem":1},{"text":"ni sagaagalu; garuu hin baayʼatan;","poem":2},{"text":"kunis sababii isaan Waaqayyoon dhiisanii","poem":1},{"text":"dabarsanii","poem":2}]},{"type":"verse","number":11,"content":[{"text":"sagaagaltummaatti,","poem":2},{"text":"daadhii wayinii moofaa fi","poem":1},{"text":"haaraa hubannaa isaanii fudhatetti of kennaniif.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sabni koo waaqa muka irraa tolfame gorsa gaafata;","poem":1},{"text":"uleen falfaltuus isaanitti dubbata.","poem":2},{"text":"Hafuurri sagaagaltummaa karaa irraa isaan jalʼisa;","poem":1},{"text":"isaan Waaqa isaaniitiif hin amanaman.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Isaan fiixeewwan tulluu irratti qalma,","poem":1},{"text":"aarsaa gubamu immoo gaarran irratti,","poem":2},{"text":"qilxuu jalatti, alaltuu fi hoomii","poem":1},{"text":"gaaddisni isaanii namatti tolu jalatti dhiʼeessu.","poem":2},{"text":"Kanaafuu intallan keessan sagaagaltummaatti deebiʼu;","poem":1},{"text":"niitonni ilmaan keessaniis ejjatti deebiʼu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Sababii warri dhiiraa iyyuu sagaagaltummaatti deebiʼanii","poem":1},{"text":"galma waaqeffannaa ejjaatti qalma dhiʼeessaniif,","poem":2},{"text":"yommuu intallan keessan","poem":1},{"text":"sagaagaltummaatti deebiʼanitti","poem":2},{"text":"yookaan yommuu niitonni ilmaan keessanii","poem":1},{"text":"ejjatti deebiʼanitti ani isaan hin adabu;","poem":2},{"lineBreak":true},{"text":"sabni hubannaa hin qabne ni badaatii!","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Yaa Israaʼel, ati yoo ejja hojjette illee","poem":1},{"text":"akka Yihuudaan yakka qabaatu hin godhin.","poem":2},{"lineBreak":true},{"text":"“Isin Gilgaal hin dhaqinaa;","poem":1},{"text":"Beet Aawwenittis ol hin baʼinaa.","poem":2},{"lineBreak":true},{"text":"‘Dhugaa Waaqayyo jiraataa!’ jettaniis hin kakatinaa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Israaʼeloonni akkuma goromsa","poem":1},{"text":"mataa jabaate tokkoo mataa jabeeyyii taʼaniiru.","poem":2},{"text":"Yoos Waaqayyo akkamiin akka xobbaallaawwan hoolaatti","poem":1},{"text":"kaloo balʼaatti isaan bobbaasuu dandaʼa ree?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Efreem waaqota tolfamootti galeera;","poem":1},{"text":"isa ittuma dhiisaa!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Dhugaatiin isaanii yoo dhume iyyuu","poem":1},{"text":"isaan sagaagaltummaa isaanii ittuma fufu;","poem":2},{"lineBreak":true},{"text":"bulchitoonni isaanii ulfina irra qaanii jaallatu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bubbeen hamaan haxaaʼee isaan balleessa;","poem":1},{"text":"aarsaan isaaniis qaanii isaanitti fida.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}