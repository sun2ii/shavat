{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HOS","translationId":"gaz_bib","name":"Hooseʼaa","commonName":"Hooseʼaa","title":"Raajii Hooseʼaa","order":28,"numberOfChapters":14,"sha256":"52ac54c61d16e6f1d07988124c4b6ac96c3714a87c6a33a4b40db5b4f23d4e54","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gaz_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"heading","content":["Murtii Israaʼelitti Murteeffame"]},{"type":"verse","number":1,"content":[{"text":"“Isin luboonni waan kana dhagaʼaa!","poem":1},{"text":"Israaʼeloonnis qalbeeffadhaa!","poem":2},{"text":"Yaa mana mootii dhaggeeffadhu!","poem":1},{"text":"Murtiin kun isinitti murama:","poem":2},{"text":"Isin Miisphaatti kiyyoo,","poem":1},{"text":"Taaboor irratti immoo xaxoo diriirsaa turtan.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Finciltoonni ajjeechaatti jabaataniiru.","poem":1},{"text":"Ani isaan hunda nan adaba.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ani waaʼee Efreem hunda beeka;","poem":1},{"text":"Israaʼelis na duraa hin dhokattu.","poem":2},{"text":"Yaa Efreem, ati amma sagaagaltummaatti deebiteerta;","poem":1},{"text":"Israaʼelis xuraaʼeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Hojiin isaanii akka isaan gara Waaqa isaaniitti","poem":1},{"text":"deebiʼan hin eeyyamuuf.","poem":2},{"text":"Hafuurri sagaagaltummaa garaa isaanii keessa jira;","poem":1},{"text":"isaan Waaqayyoon hin beekan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Of tuulummaan Israaʼel dhugaa isaanitti baʼa;","poem":1},{"text":"Israaʼeloonni, Efreem mataan isaa iyyuucubbuu isaanii keessatti gufatu;","poem":2},{"lineBreak":true},{"text":"Yihuudaanis isaan wajjin gufata.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isaan yommuu Waaqayyoon barbaaduudhaaf","poem":1},{"text":"bushaayee fi loon isaanii fudhatanii deemanitti,","poem":2},{"text":"isa hin argatan;","poem":1},{"text":"inni isaan dhiisee deemeeraatii.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Isaan Waaqayyoof amanamoo miti;","poem":1},{"text":"seeraan ala ijoollee godhatu.","poem":2},{"text":"Yeroo isaan Ayyaana Baatii Haaraa ayyaaneffatanitti","poem":1},{"text":"inni lafa qotiisaa isaanii ni balleessa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Gibeʼaa keessatti malakata,","poem":1},{"text":"Raamaa keessatti immoo gaanfa afuufaa.","poem":2},{"text":"Beet Aawwen keessatti iyya lolaa dhageessisaa;","poem":1},{"text":"yaa Beniyaam, ati dura qajeeli.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Guyyaa ifannaatti","poem":1},{"text":"Efreem ni ona.","poem":2},{"text":"Ani gosoota Israaʼel gidduutti","poem":1},{"text":"waan mirkanaaʼe nan labsa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bulchitoonni Yihuudaa","poem":1},{"text":"akkuma nama dhagaa daarii dhiibu tokkoo ti.","poem":2},{"text":"Ani akkuma lolaa bishaanii","poem":1},{"text":"dheekkamsa koo isaanitti gad nan lolaasa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efreem sababii waaqota tolfamoo","poem":1},{"text":"duukaa buʼuu jaallateef akka malee hacuucamee","poem":2},{"lineBreak":true},{"text":"murtiidhaan lafatti dhidhiitame.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ani Efreemitti akka bilii,","poem":1},{"text":"Yihuudaatti immoo akka daanaʼoo ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Yommuu Efreem dhukkuba isaa,","poem":1},{"text":"Yihuudaanis madaa isaa argetti,","poem":2},{"text":"Efreem gara Asooritti garagalee","poem":1},{"text":"mooticha guddaa gargaarsa kadhachuudhaafnama itti erge.","poem":2},{"text":"Inni garuu isin fayyisuu,","poem":1},{"text":"madaa keessanis wayyeessuu hin dandaʼu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ani Efreemitti akkuma leencaa,","poem":1},{"text":"Yihuudaattis akkuma saafela leencaa nan taʼa.","poem":2},{"text":"Ani gargar isaan ciccireen biraa deema;","poem":1},{"text":"ani isaan guureen deema; namni isaan oolchus hin jiru.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ergasii ani hamma isaan","poem":1},{"text":"balleessaa isaanii fudhatanitti","poem":2},{"lineBreak":true},{"text":"iddoo kootti nan deebiʼa.","poem":2},{"text":"Isaan fuula koo barbaaddatu;","poem":1},{"text":"rakkoo isaanii keessatti jabaatanii na barbaaddatu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}