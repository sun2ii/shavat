{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HOS","translationId":"gaz_bib","name":"Hooseʼaa","commonName":"Hooseʼaa","title":"Raajii Hooseʼaa","order":28,"numberOfChapters":14,"sha256":"52ac54c61d16e6f1d07988124c4b6ac96c3714a87c6a33a4b40db5b4f23d4e54","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gaz_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"heading","content":["Israaʼel Qalbii Jijjiirrachuu Didde"]},{"type":"verse","number":1,"content":[{"text":"“Kottaa gara Waaqayyootti deebinaa.","poem":1},{"lineBreak":true},{"text":"Inni nu ciccireera;","poem":1},{"text":"garuu nu fayyisa;","poem":2},{"text":"inni nu madeesseera;","poem":1},{"text":"garuu madaa keenya ni waldhaana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Akka nu fuula isaa dura jiraannuuf,","poem":1},{"text":"guyyaa lama booddee nu bayyanachiisa;","poem":2},{"lineBreak":true},{"text":"guyyaa sadaffaatti immoo deebisee nu dhaaba.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kottaa Waaqayyoon haa beeknu;","poem":1},{"text":"isa beekuufis haa tattaaffannu.","poem":2},{"text":"Akkuma aduun dhugumaan baatu sana","poem":1},{"text":"inni dhugumaan ni dhufa;","poem":2},{"text":"inni akkuma bokkaa gannaa,","poem":1},{"text":"akkuma bokkaa birraa kan lafa quubsu sanaattigara keenya ni dhufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Yaa Efreem, ani maalan si godha?","poem":1},{"text":"Yaa Yihuudaa, ani maalan si godha?","poem":2},{"text":"Jaalalli keessan akkuma hurrii ganamaa,","poem":1},{"text":"akkuma fixeensa barii baduu ti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kanaafuu ani raajota kootiin isin cicciree","poem":1},{"text":"dubbii afaan kootiin isin fixe;","poem":2},{"lineBreak":true},{"text":"murtiin koos akkuma aduu ni baʼa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani araaran fedha malee aarsaa hin fedhuutii;","poem":1},{"text":"aarsaa gubamu caalaa Waaqa beekuu nan fedha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Isaan akkuma Addaam kakuu cabsaniiru;","poem":1},{"text":"achittis anaaf hin amanamne.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Giliʼaad magaalaa hamootaa","poem":1},{"text":"kan dhiigaan faalamtee dha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akkuma saamtuun riphxee nama eeggattu sana,","poem":1},{"text":"gareen lubootaas akkasuma godhu;","poem":2},{"text":"isaan yakka qaanessaa hojjechuudhaan","poem":1},{"text":"karaa Sheekem irratti nama ajjeesu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani mana Israaʼel keessatti","poem":1},{"text":"waan suukaneessaa tokko argeera.","poem":2},{"text":"Achitti Efreem ni sagaagale;","poem":1},{"text":"Israaʼelis ni xuraaʼe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Yaa Yihuudaa sittis","poem":1},{"text":"haamamuun murteeffameera.","poem":2},{"lineBreak":true},{"text":"“Yeroo ani boojuu saba koo deebisutti,","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}