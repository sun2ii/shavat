{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HOS","translationId":"gaz_bib","name":"Hooseʼaa","commonName":"Hooseʼaa","title":"Raajii Hooseʼaa","order":28,"numberOfChapters":14,"sha256":"52ac54c61d16e6f1d07988124c4b6ac96c3714a87c6a33a4b40db5b4f23d4e54","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gaz_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"yeroo ani Israaʼelin fayyisutti","poem":2},{"text":"cubbuun Efreem saaxilamee","poem":1},{"text":"yakki Samaariyaas ifatti baafama.","poem":2},{"text":"Isaan nama gowwoomsu;","poem":1},{"text":"hattuun cabsitee mana seenti;","poem":2},{"lineBreak":true},{"text":"saamtonni daandii irratti nama saamu;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"isaan garuu akka ani jalʼina isaanii hunda","poem":1},{"text":"yaadadhu hin hubatan.","poem":2},{"text":"Cubbuun isaanii isaan marseera;","poem":1},{"text":"yeroo hundas fuula koo dura jira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Isaan hammina isaaniitiin mootii,","poem":1},{"text":"soba isaaniitiin immoo ilmaan mootii gammachiisu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isaan hundinuu ejjitoota,","poem":1},{"text":"akkuma badaa ibiddaa","poem":2},{"text":"kan tolchituun tokko yeroo bukoo sukkuumanii jalqabee","poem":1},{"text":"hamma inni bukaaʼutti itti tuttuquu hin barbaannee ti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Guyyaa ayyaana mootii keenyaatti","poem":1},{"text":"ilmaan moototaa daadhii wayiniitiin finiinan;","poem":2},{"lineBreak":true},{"text":"innis qoostota wajjin harka isaa diriirsa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Akkuma badaa ibiddaatti garaa isaanii qopheessaniiru;","poem":1},{"text":"isaan dabaan gara isaatti dhiʼaatu.","poem":2},{"text":"Aariin isaanii halkan guutuu irraa hin galu;","poem":1},{"text":"ganama immoo akkuma arraba ibiddaa balaliʼa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hundi isaanii akkuma badaa ibiddaa hoʼu;","poem":1},{"text":"bulchitoota isaaniis ni fixu.","poem":2},{"text":"Mootonni isaanii hundinuu ni dhumu;","poem":1},{"text":"tokkoon isaanii iyyuu na hin waammatan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Efreem sabootaan walitti makama;","poem":1},{"text":"Efreem maxinoo gara hin galfaminii dha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Namoonni ormaa humna isaa nyaatan;","poem":1},{"text":"inni garuu hin hubatu.","poem":2},{"text":"Arriin isatti baʼe;","poem":1},{"text":"inni garuu hin beeku.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Of tuulummaan Israaʼel dhugaa isatti baʼa;","poem":1},{"text":"inni garuu utuu wanni kun hundi akkana taʼee jiruu,","poem":2},{"text":"gara Waaqayyo Waaqa isaatti hin deebiʼu","poem":1},{"text":"yookaan isa hin barbaaddatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Efreem akkuma gugee","poem":1},{"text":"gowwaa sammuu hin qabnee ti;","poem":2},{"text":"isaan Gibxin waammatu;","poem":1},{"text":"isaan gara Asooritti deebiʼu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yommuu isaan deeman ani kiyyoo koo isaan irra nan buusa;","poem":1},{"text":"ani akkuma simbirroo samii gad isaan nan harkisa.","poem":2},{"text":"Ani yommuun akka isaan walii wajjin yaaʼan dhagaʼutti,","poem":1},{"text":"isaan nan qaba.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Waan narraa goraniif","poem":1},{"text":"isaaniif wayyoo!","poem":2},{"text":"Waan natti fincilaniif","poem":1},{"text":"badiisni isaaniif mala!","poem":2},{"text":"Ani isaan furuu nan barbaada;","poem":1},{"text":"isaan garuu waaʼee koo soba dubbatu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Isaan garaa isaanii guutuudhaan gara kootti hin iyyatan;","poem":1},{"text":"garuu siree isaanii irra tataaʼanii booʼu.","poem":2},{"text":"Isaan midhaanii fi daadhii wayiniitiif walitti qabamu;","poem":1},{"text":"garuu natti fincilu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ani leenjiseen irree isaanii jajjabeesse;","poem":1},{"text":"isaan garuu waan hamaa natti yaadu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Isaan gara Waaqa Waan Hundaa Oliitti hin deebiʼan;","poem":1},{"text":"isaan akkuma xiyya jalʼatee ti.","poem":2},{"text":"Hooggantoonni isaanii sababii soba dubbataniif","poem":1},{"text":"goraadeedhaan dhumu.","poem":2},{"text":"Sababii kanaaf isaan biyya Gibxitti","poem":1},{"text":"ni tuffatamu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}