{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HOS","translationId":"gaz_bib","name":"Hooseʼaa","commonName":"Hooseʼaa","title":"Raajii Hooseʼaa","order":28,"numberOfChapters":14,"sha256":"52ac54c61d16e6f1d07988124c4b6ac96c3714a87c6a33a4b40db5b4f23d4e54","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gaz_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["Israaʼel Bubbee Hamaa Haammata"]},{"type":"verse","number":1,"content":[{"text":"“Malakata afaan keetti kaaʼadhu!","poem":1},{"text":"Sababii namoonni kakuu koo cabsanii","poem":2},{"text":"seera kootti fincilaniif","poem":1},{"text":"risaan tokko mana Waaqayyootiin ol jira.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Israaʼel, ‘Yaa Waaqa keenya nu si beekna!’ jedhee","poem":1},{"text":"gara kootti iyyate.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taʼu iyyuu Israaʼel waan gaarii dideera;","poem":1},{"text":"kanaafuu diinni isa ariʼa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isaan walii galtee koo malee mootota moosifatan;","poem":1},{"text":"utuu ani hin fudhatiniif ilmaan moototaa filatan.","poem":2},{"text":"Isaan meetii fi warqee isaaniitiin","poem":1},{"text":"badiisa isaaniitiif","poem":2},{"lineBreak":true},{"text":"waaqota tolfamoo ofii isaaniitiif tolfatan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yaa Samaariyaa, waaqa kee tolfamaa bifa jabbii sana baasii gati!","poem":1},{"text":"Dheekkamsi koo isaanitti bobaʼa.","poem":2},{"text":"Isaan hamma yoomiitti qulqullaaʼuu dadhabu?","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Isaan warra Israaʼel!","poem":2},{"text":"Jabbii kana ogeessa hojii harkaatu tolche;","poem":1},{"text":"inni Waaqa miti.","poem":2},{"lineBreak":true},{"text":"Jabbiin Samaariyaa ni hurraaʼa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Isaan bubbee facaafatanii","poem":1},{"text":"bubbee hamaa haammatu.","poem":2},{"text":"Mukni isaa mataa hin qabu;","poem":1},{"text":"daraaraas hin baasu.","poem":2},{"text":"Utuu inni midhaan naqatee","poem":1},{"text":"silaa namoonni ormaa ni nyaatu ture.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Israaʼel liqimfameera;","poem":1},{"text":"isaan amma saboota gidduutti","poem":2},{"lineBreak":true},{"text":"akka waan faayidaa hin qabne tokkoo ti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isaan akkuma harree diidaa kan asii fi","poem":1},{"text":"achi kophaa jooruu gara Asooriitti ol baʼaniiruutii;","poem":2},{"lineBreak":true},{"text":"Efreemis michootatti of gurgureera.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Isaan saboota gidduutti yoo of gurguran iyyuu","poem":1},{"text":"ani amma walitti isaan nan qaba.","poem":2},{"text":"Isaan hacuuccaa mooticha jabaa jalatti","poem":1},{"text":"ni sukkuumamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Efreem aarsaa cubbuutiifiddoo aarsaa hedduu yoo hojjete iyyuu,","poem":1},{"text":"lafti sun iddoo aarsaa itti cubbuu hojjechuufqopheessan taʼeera.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ani waaʼee seera koo waan baayʼee isaaniif barreesseera;","poem":1},{"text":"isaan garuu akkuma waan alaa dhufe tokkootti ilaalu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Isaan aarsaa naaf kenname dhiʼeessu;","poem":1},{"text":"foon sanas ni nyaatu;","poem":2},{"lineBreak":true},{"text":"Waaqayyo garuu isaanitti hin gammanne.","poem":2},{"text":"Inni amma hammina isaanii yaadatee","poem":1},{"text":"cubbuu isaanii adaba:","poem":2},{"lineBreak":true},{"text":"Isaan gara Gibxitti deebiʼu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Israaʼel Uumaa isaa irraanfatee","poem":1},{"text":"masaraawwan mootummaa ijaare;","poem":2},{"lineBreak":true},{"text":"Yihuudaan magaalaawwan hedduutti dallaa ijaare.","poem":2},{"text":"Ani garuu ibidda daʼannoowwan isaanii","poem":1},{"text":"barbadeessu magaalaawwan isaaniitti nan erga.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}