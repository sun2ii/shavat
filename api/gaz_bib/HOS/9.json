{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HOS","translationId":"gaz_bib","name":"Hooseʼaa","commonName":"Hooseʼaa","title":"Raajii Hooseʼaa","order":28,"numberOfChapters":14,"sha256":"52ac54c61d16e6f1d07988124c4b6ac96c3714a87c6a33a4b40db5b4f23d4e54","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gaz_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["Adabbii Israaʼelitti Dhufu"]},{"type":"verse","number":1,"content":[{"text":"Yaa Israaʼel hin ililchin;","poem":1},{"text":"akka saboota kaanii hin gammadin.","poem":2},{"text":"Ati Waaqa keetiif amanamaa hin turreetii;","poem":1},{"text":"ati oobdii hunda irratti gatii","poem":2},{"lineBreak":true},{"text":"sagaagaltummaadhaaf baafamu jaallatteerta.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Oobdiiwwanii fi iddoon cuunfaa wayinii saba hin sooran;","poem":1},{"text":"daadhiin wayinii haaraan isaaniif hin tolu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isaan biyya Waaqayyoo keessatti hin hafan;","poem":1},{"text":"Efreem gara Gibxitti deebiʼee","poem":2},{"lineBreak":true},{"text":"Asoor keessatti nyaata xuraaʼe nyaata.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isaan dhibaayyuu daadhii wayinii Waaqayyoof hin dhibaafatan;","poem":1},{"text":"yookaan aarsaan isaanii isa hin gammachiisu.","poem":2},{"text":"Aarsaan akkasii akkuma buddeena warra gaddaa isaanitti taʼa;","poem":1},{"text":"namni buddeena kana nyaatu hundinuu ni xuraaʼa.","poem":2},{"text":"Nyaanni kun kanuma mataa isaanii taʼa;","poem":1},{"text":"mana qulqullummaa Waaqayyoos ol hin seenu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Isin guyyaa ayyaana keessan murteeffameetti,","poem":1},{"text":"guyyoota ayyaana Waaqayyoo sanatti maal hojjetu?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yoo isaan badiisa jalaa baʼan iyyuu","poem":1},{"text":"Gibxi walitti isaan qabdi;","poem":2},{"lineBreak":true},{"text":"Memfiis immoo isaan awwaala.","poem":2},{"text":"Qabeenyi meetii isaanii sokorruudhaan liqimfama;","poem":1},{"text":"dunkaana isaanii immoo qoraattiitu haguuga.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Guyyoonni adabbii dhufaa jiru;","poem":1},{"text":"guyyoonni itti gatii baasan dhiʼaataniiru.","poem":2},{"lineBreak":true},{"text":"Israaʼel waan kana haa beeku.","poem":2},{"text":"Sababii cubbuun kee akka malee baayʼatee","poem":1},{"text":"hamminni kees akka malee guddaa taʼeef,","poem":2},{"text":"raajiin akka raatuutti ilaalame;","poem":1},{"text":"namni Hafuura Waaqaatiin qajeelfamu immooakka maraatuutti hedame.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Raajichi Waaqa koo wajjin","poem":1},{"text":"eegduu Efreem taʼe;","poem":2},{"text":"taʼus daandii isaa hunda irratti kiyyoon isa eeggata;","poem":1},{"text":"mana Waaqa isaa keessattis jibbi isa eeggata.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isaan akkuma bara Gibeʼaa keessatti taʼe sana","poem":1},{"text":"xuraaʼummaa keessa dhidhiman.","poem":2},{"text":"Waaqni hammina isaanii yaadatee","poem":1},{"text":"sababii cubbuu isaaniitiif isaan adaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Yeroo ani Israaʼelin argetti,","poem":1},{"text":"inni akkuma ija wayinii gammoojjii keessatti argamee ture;","poem":2},{"text":"yeroo ani abbootii keessan argetti,","poem":1},{"text":"isaan akkuma waan ija jalqabaa harbuu irratti argamee turan.","poem":2},{"text":"Isaan garuu yommuu gara Baʼaal Pheʼoor dhufanitti,","poem":1},{"text":"waaqa tolfamaa qaanessaa sanaaf of qulqulleessanii","poem":2},{"lineBreak":true},{"text":"akkuma waan jaallatan sanaa jibbisiisoo taʼan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ulfinni Efreem akkuma simbirroo barrisee bada;","poem":1},{"text":"dhalchuun, garaatti baachuun, ulfaaʼuun hin jiru.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yoo isaan ijoollee guddifatan iyyuu","poem":1},{"text":"ani jalaa fixee ilmaan malee isaan nan hambisa.","poem":2},{"text":"Gaafa ani isaan irraa garagalu","poem":1},{"text":"isaaniif wayyoo!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ani Efreemin isaa akkuma Xiiroos","poem":1},{"text":"lafa namatti tolu irra dhaabatee jiru nan arge.","poem":2},{"text":"Sabni Efreem garuu ijoollee isaa gad baasee","poem":1},{"text":"warra gogorraʼutti kenna.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yaa Waaqayyo isaaniif kenni;","poem":1},{"text":"ati maal isaaniif kennita?","poem":2},{"text":"Gadameessa ulfa hin baannee fi","poem":1},{"text":"harma goggogaa kenniif.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Sababii hammina isaanii kan Gilgaal keessatti hojjetame sana hundaatiif,","poem":1},{"text":"ani achitti isaan nan jibbe.","poem":2},{"text":"Sababii hojii isaanii kan cubbuudhaan guutamee sanaatiif","poem":1},{"text":"ani mana koo keessaa isaan ariʼa.","poem":2},{"text":"Ani siʼachi isaan hin jaalladhu;","poem":1},{"text":"bulchitoonni isaanii hundinuu finciltoota.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Efreem rukutameera;","poem":1},{"text":"hiddi isaanii goggogeera;","poem":2},{"lineBreak":true},{"text":"isaan ija tokko illee hin godhatan.","poem":2},{"text":"Yoo isaan ijoollee godhatan iyyuu","poem":1},{"text":"ani sanyii isaanii jaallatamoo isaan jalaa nan qala.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Sababii isaan isaaf hin ajajaminiif,","poem":1},{"text":"Waaqni koo isaan dida;","poem":2},{"lineBreak":true},{"text":"isaan warra asii fi achi saboota gidduu jooru taʼu.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}