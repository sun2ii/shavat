{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Mulʼata Isaayyaas ilmi Amoos bara bulchiinsa Uziyaan, bara Yootaam, bara Aahaazii fi bara Hisqiyaas keessa waaʼee Yihuudaatii fi Yerusaalem arge."]},{"type":"line_break"},{"type":"heading","content":["Saba Fincilaa Tokko"]},{"type":"verse","number":2,"content":[{"text":"Yaa Samiiwwan dhagaʼaa! Yaa lafa dhaggeeffadhu!","poem":1},{"text":"Waaqayyo akkana jedhee dubbateeraatii:","poem":2},{"text":"“Ani ijoollee horadheen guddifadhe;","poem":1},{"text":"isaan garuu natti fincilaniiru.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Qotiyyoon gooftaa isaa,","poem":1},{"text":"harreenis gola gooftaa isaa ni beeka;","poem":2},{"text":"Israaʼel garuu hin beeku;","poem":1},{"text":"sabni koo hin hubatu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yaa saba cubbamaa,","poem":1},{"text":"uummata balleessaan itti baayʼate,","poem":2},{"text":"ilmaan warra waan hamaa hojjetuu,","poem":1},{"text":"ijoollee xuraaʼummaadhaan guutamte isiniif wayyoo!","poem":2},{"text":"Isaan Waaqayyoon dhiisaniiru;","poem":1},{"text":"Qulqullicha Israaʼel sana tuffatanii","poem":2},{"lineBreak":true},{"text":"dugda isaanii itti garagalfataniiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Isin siʼachi maaliif rukutamtu?","poem":1},{"text":"Maaliif fincila keessa jiraatu?","poem":2},{"text":"Mataan keessan guutuun miidhameera;","poem":1},{"text":"garaan keessan guutuunis dadhabeera.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Faana miilla keessaniitii hamma gubbee mataa keessaniitti,","poem":1},{"text":"fayyaa hin qabdan;","poem":2},{"text":"madaa fi dirmammuun, madaan dhiigu,","poem":1},{"text":"kan hin qulqulloofne yookaan hin maramne","poem":2},{"lineBreak":true},{"text":"yookaan zayitiidhaan hin laafne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Biyyi keessan duwwaa hafteerti;","poem":1},{"text":"magaalaawwan keessan ibiddaan gubamaniiru;","poem":2},{"text":"alagoonni fuuluma keessan duratti","poem":1},{"text":"lafa qotiisaa keessan saamu;","poem":2},{"lineBreak":true},{"text":"akkuma waan ormi ishee saameettis onti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Intalli Xiyoon akkuma daʼannoo iddoo","poem":1},{"text":"dhaabaa wayinii keessaatti,","poem":2},{"text":"akkuma daasii lafa qotiisa buqqee keessaatti,","poem":1},{"text":"akkuma magaalaa marfame tokkootti dhiifamti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Utuu Waaqayyoon Waan Hunda Dandaʼu","poem":1},{"text":"hambaa muraasa nuuf hambisuu baatee,","poem":2},{"text":"nu silaa akkuma Sodoom taanee,","poem":1},{"text":"Gomoraas fakkaanna turre.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yaa bulchitoota Sodoom","poem":1},{"text":"dubbii Waaqayyoo dhagaʼaa;","poem":2},{"text":"yaa saba Gomoraa,","poem":1},{"text":"Seera Waaqa keenyaa dhaggeeffadhaa!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Waaqayyo akkana jedha;","poem":1},{"text":"“Baayʼinni aarsaa keessanii anaaf maali?”","poem":2},{"lineBreak":true},{"text":"Ani aarsaa gubamu kan korbeeyyii hoolaatii fihorii gabbifamanii baayʼeen qaba;","poem":2},{"text":"ani dhiiga korommii looniitti,","poem":1},{"text":"kan xobbaallaawwan hoolaattii fi reʼeetti hin gammadu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Isin yommuu fuula koo duratti mulʼachuuf dhuftan,","poem":1},{"text":"akka oobdii koo dhidhiittan","poem":2},{"lineBreak":true},{"text":"eenyutu isin irraa barbaade?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kennaa faayidaa hin qabne fiduu dhiisaa!","poem":1},{"text":"Ixaanni keessan na jibbisiisa.","poem":2},{"text":"Ayyaana Baatii, Sanbataa fi yaaʼii keessan","poem":1},{"text":"jechuunis wal gaʼii keessan hamaa sana ani hin fedhu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ayyaana Baatii keessanii fi","poem":1},{"text":"ayyaanota keessan bebbeekamoo lubbuun koo ni jibbiti.","poem":2},{"text":"Isaan baʼaa natti taʼaniiru;","poem":1},{"text":"anis obsuu dadhabeera.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yeroo isin kadhannaaf harka keessan balʼifattan,","poem":1},{"text":"ani ija koo isinan dhokfadha;","poem":2},{"lineBreak":true},{"text":"yoo isin kadhaa baayʼee kadhattan illee ani hin dhaggeeffadhu.","poem":2},{"lineBreak":true},{"text":"Harki keessan dhiigaan guutameera!","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dhiqadhaatii of qulqulleessaa.","poem":1},{"text":"Hojii keessan hamaa sana fuula koo duraa balleessaa!","poem":2},{"lineBreak":true},{"text":"Yakka hojjechuus dhiisaa;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"waan qajeelaa hojjechuu baradhaa!","poem":1},{"text":"Murtii qajeelaa barbaadaa;","poem":2},{"text":"warra hacuucame jajjabeessaa.","poem":1},{"text":"Ijoollee abbaa hin qabneef falmaa;","poem":2},{"lineBreak":true},{"text":"haadha hiyyeessaatiif dhaabadhaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Waaqayyo akkana jedha;","poem":1},{"text":"“Kottaa wal qorraa;","poem":2},{"text":"cubbuun keessan yoo akka bildiimaa taʼe iyyuu,","poem":1},{"text":"inni addaatee akka cabbii ni taʼa;","poem":2},{"text":"yoo akka alalaa diimate iyyuu,","poem":1},{"text":"akka suufii ni addaata.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Isin yoo fedhii qabaattanii ajajamtan,","poem":1},{"text":"waan lafti baaftu filatamaa ni nyaattu;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"garuu yoo diddanii finciltan goraadeetu isin nyaata.”","poem":1},{"text":"Afaan Waaqayyoo waan kana dubbateeraatii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Akka magaalaan amanamtuun sun","poem":1},{"text":"sagaagaltuu taate ilaalaa!","poem":2},{"text":"Isheen dur murtii qajeelaadhaan guutamtee","poem":1},{"text":"qajeelummaan ishee keessa jiraata ture;","poem":2},{"lineBreak":true},{"text":"amma immoo namoota nama ajjeesantu ishee keessa jiraata!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Meetiin kee ligidaaʼeera;","poem":1},{"text":"daadhiin wayinii kee filatamaan bishaaniin makameera.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bulchitoonni kee finciltoota;","poem":1},{"text":"michuu hattuuwwanii ti;","poem":2},{"text":"isaan hundinuu mattaʼaa jaallatu;","poem":1},{"text":"kennaas akka malee barbaadu.","poem":2},{"text":"Isaan ijoollee abbaa hin qabneef hin falman;","poem":1},{"text":"himata haadha hiyyeessaa hin dhaggeeffatan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Kanaafuu Gooftaan, Waaqayyoon Waan Hunda Dandaʼu,","poem":1},{"text":"Jabaan Israaʼel sun akkana jedha:","poem":2},{"text":"“Ani amajaajota koo irraa boqonnaa nan argadha;","poem":1},{"text":"diinota koos haaloo nan baafadha.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ani harka koo sitti nan deebisa;","poem":1},{"text":"ligidaaʼummaa kees akka malutti sirraa nan haqa;","poem":2},{"lineBreak":true},{"text":"xurii kee hundas sirraa nan balleessa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ani akkuma bara durii abbootii murtii iddootti,","poem":1},{"text":"akkuma jalqabaatti gorsitoota kee illee siifin deebisa.","poem":2},{"text":"Ergasii ati magaalaa qajeelummaa,","poem":1},{"text":"magaalaa amanamtuu jedhamtee ni waamamta.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Xiyoon murtii qajeelaadhaan,","poem":1},{"text":"qalbii jijjiirrattoonni ishee immoo qajeelummaadhaan furamu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Finciltoonnii fi cubbamoonni garuu ni caccabu;","poem":1},{"text":"warri Waaqayyoon dhiisanis ni badu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Isin sababii muka qilxuu itti gammaddan sanaatiif ni qaanoftu;","poem":1},{"text":"sababii iddoo biqiltuu filattan sanaatiif immoo ni salphattu.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Isin akka qilxuu baalli irraa harcaʼee,","poem":1},{"text":"akka iddoo biqiltuu bishaan hin qabnee ni taatu.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Namni jabaan akkuma huubaa,","poem":1},{"text":"hojiin isaas akkuma qaanqee taʼa;","poem":2},{"text":"isaan lachuu walumaan gubatu;","poem":1},{"text":"namni ibidda sana dhaamsus hin jiru.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}