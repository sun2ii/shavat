{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":11,"content":[{"type":"heading","content":["Damee Isseey"]},{"type":"verse","number":1,"content":[{"text":"Lataan tokko jirma Isseey irraa ni lata;","poem":1},{"text":"hidda isaa irraas dameen tokko ija naqata.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hafuurri Waaqayyoo,","poem":1},{"text":"Hafuurri ogummaatii fi hubannaa,","poem":2},{"lineBreak":true},{"text":"Hafuurri gorsaatii fi humnaa,","poem":2},{"lineBreak":true},{"text":"Hafuurri beekumsaatii fi kan Waaqayyoon sodaachuu isa irra qubata;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"inni Waaqayyoon sodaachuutti ni gammada.","poem":1},{"lineBreak":true},{"text":"Inni waanuma iji isaa arguun murtii hin kennu;","poem":1},{"text":"yookaan waanuma gurra isaatiin dhagaʼuun hin murteessu;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"garuu nama rakkataaf qajeelummaadhaan murteessa;","poem":1},{"text":"hiyyeeyyii lafa irraatiifis murtii qajeelaadhaan murtii kenna.","poem":2},{"text":"Inni ulee afaan isaatiin lafa rukuta;","poem":1},{"text":"hafuura afaan isaatii baʼuun hamoota ni fixa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Qajeelummaan teepha mudhii isaa ti;","poem":1},{"text":"amanamummaan immoo sabbata mudhii isaa ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yeeyyiin xobbaallaa hoolaa wajjin jiraata;","poem":1},{"text":"qeerransi ilmoo reʼee bira ciisa;","poem":2},{"text":"jabbiin, leencii fi horiin gabbataan walii wajjin bobbaʼu;","poem":1},{"text":"mucaan xinnaan isaan bobbaasa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Saan amaaketa wajjin soorata;","poem":1},{"text":"ilmaan isaanii wal cina ciciisu;","poem":2},{"lineBreak":true},{"text":"leencis akka sangaa cidii nyaata.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Daaʼimni boolla bofaa irra taphata;","poem":1},{"text":"mucaan xinnaan boolla buutii keessa harka kaaʼa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isaan tulluuwwan koo qulqulloota hunda irratti","poem":1},{"text":"waa hin miidhan yookaan waa hin balleessan;","poem":2},{"text":"akkuma bishaan galaana guutu sana","poem":1},{"text":"lafti Waaqayyoon beekuudhaan guutamtiitii.","poem":2}]},{"type":"verse","number":10,"content":["Bara sana keessa hiddi Isseey akkuma faajjiitti uummataaf dhaabata; saboonni gara isaatti walitti qabamu; lafti inni boqotus ulfina qabeessa taʼa."]},{"type":"verse","number":11,"content":["Gaafas Gooftaan yeroo lammaffaaf harka isaa diriirsee Asoor irraa, Gibxi Gadii irraa, Gibxi Olii irraa, Itoophiyaa irraa, Eelaam irraa, Baabilon irraa, Hamaatii fi biyyoota bishaan gidduu galaanaa irraa hambaawwan saba isaa walitti qabata."]},{"type":"verse","number":12,"content":[{"text":"Inni sabootaaf faajjii ol kaasee","poem":1},{"text":"boojiʼamtoota Israaʼel walitti qaba;","poem":2},{"text":"inni roga laafaa afran irraa","poem":1},{"text":"saba Yihuudaa kan bittinnaaʼee ture walitti qaba.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hinaaffaan Efreem ni bada;","poem":1},{"text":"diinonni Yihuudaas ni barbadeeffamu;","poem":2},{"text":"Efreem gaafas Yihuudaatti hin hinaafu;","poem":1},{"text":"yookaan Yihuudaan Efreemitti hin hammaatu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Isaan karaa lixa biiftuutiin gatiittii Filisxeemitti gad buʼu;","poem":1},{"text":"tokko taʼaniis uummata baʼa biiftuu saamu.","poem":2},{"text":"Isaan Edoomii fi Moʼaabin qabatu;","poem":1},{"text":"warri Amoonis isaan jalatti bulu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Waaqayyo guutumaan guutuutti,","poem":1},{"text":"galoo galaana Gibxi ni gogsa;","poem":2},{"text":"inni bubbee isaa kan nama waxaluun","poem":1},{"text":"harka isaa laga Efraaxiis irra sochoosa.","poem":2},{"text":"Akka namoonni kopheen ceʼaniifis","poem":1},{"text":"inni laga torbatti gargar isa qooda.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Akkuma gaafa isaan Gibxii baʼanIsraaʼeliif taʼe sana,","poem":1},{"text":"hambaa saba isaa kan Asoor irraa hafeef","poem":2},{"lineBreak":true},{"text":"karaan guddaan ni argama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/10.json","previousChapterAudioLinks":{},"numberOfVerses":16}