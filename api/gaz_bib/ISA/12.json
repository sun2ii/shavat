{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["Faarfannaa Galataa"]},{"type":"verse","number":1,"content":["Ati gaafas akkana jetta:",{"text":"“Yaa Waaqayyo, ati natti aartee turte;","poem":1},{"text":"aariin kees narraa deebiʼeera;","poem":2},{"lineBreak":true},{"text":"na jajjabeessiteertaatii sin galateeffadha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dhugumaan Waaqni fayyina koo ti;","poem":1},{"text":"ani isa nan abdadha; hin sodaadhus.","poem":2},{"text":"Waaqayyo, Waaqayyo mataan isaa,","poem":1},{"text":"jabinaa fi faarfannaa koo ti;inni fayyina koo taʼeera.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isin burqaa fayyinaa keessaa","poem":1},{"text":"gammachuudhaan bishaan waraabbattu.","poem":2}]},{"type":"verse","number":4,"content":["Isin bara sana keessa akkana jettu:",{"text":"“Waaqayyoof galata galchaa; maqaa isaa waammadhaa;","poem":1},{"text":"waan inni hojjete sabootatti beeksisaa;","poem":2},{"lineBreak":true},{"text":"akka maqaan isaa ol ol jedhe lallabaa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inni waan ulfina qabu hojjeteeraatii Waaqayyoon faarfadhaa;","poem":1},{"text":"wanni kun addunyaa hunda keessatti haa beekamu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yaa saba Xiyoon, Qulqullichi Israaʼelisin gidduutti guddaadhaatii","poem":1},{"text":"sagalee ol fudhadhaatii gammachuudhaan faarfadhaa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}