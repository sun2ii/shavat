{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":13,"content":[{"type":"heading","content":["Raajii Baabiloniin Mormu"]},{"type":"verse","number":1,"content":["Raajii waaʼee Baabilon kan Isaayyaas ilmi Amoos arge:"]},{"type":"verse","number":2,"content":[{"text":"Tulluu homaa itti hin biqilin irratti","poem":1},{"text":"faajjii ol kaasaatii isaanitti iyyaa;","poem":2},{"text":"akka isaan karra namoota","poem":1},{"text":"bebeekamootiin ol galaniif harkaan itti himaa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ani qulqulloota koo ajajeera;","poem":1},{"text":"akka isaan dheekkamsa koo hojii irra naa oolchaniif","poem":2},{"lineBreak":true},{"text":"ani loltoota koo kanneen moʼannoo kootti gammadanwaammadheera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Waca tulluuwwan irraa,","poem":1},{"text":"kan akka tuuta guddaa tokkoo dhaggeeffadhaa!","poem":2},{"text":"Guungummii mootummootaa","poem":1},{"text":"kan saboota walitti qabamanii dhaggeeffadhaa!","poem":2},{"text":"Waaqayyoon Waan Hunda Dandaʼu","poem":1},{"text":"lolaaf jedhee loltoota qopheeffachaa jira!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isaan biyya fagoodhaa","poem":1},{"text":"daarii samiiwwaniitii dhufan;","poem":2},{"text":"Waaqayyoo fi miʼa lolaa kan dheekkamsa isaatiin","poem":1},{"text":"guutummaa biyyattii balleessuuf dhufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Waan guyyaan Waaqayyoo dhiʼaateef booʼaa;","poem":1},{"text":"guyyaan sun akkuma badiisa","poem":2},{"lineBreak":true},{"text":"Waaqa Waan Hunda Dandaʼu biraa ergameetti ni dhufa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kanaafuu harki hundinuu ni laamshaʼa;","poem":1},{"text":"onneen nama hundaas ni baqa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sodaan isaan qabata;","poem":1},{"text":"dhukkubbii fi gaddi isaan qabata;","poem":2},{"lineBreak":true},{"text":"akkuma dubartii ciniinsuun qabeetti wixxirfatu.","poem":2},{"text":"Isaan rifatanii wal ilaalu;","poem":1},{"text":"fuulli isaanii akka ibiddaa diimata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kunoo guyyaan Waaqayyoo,","poem":1},{"text":"guyyaan hamaan, dheekkamsaa fi aarii sodaachisaadhaan,","poem":2},{"text":"lafa onsuu fi cubbamoota ishee keessa jiraatan","poem":1},{"text":"barbadeessuuf ni dhufa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Urjiiwwan samiitii fi tuunni isaanii","poem":1},{"text":"ifa isaanii hin kennan.","poem":2},{"text":"Aduun baatu ni dukkanoofti;","poem":1},{"text":"jiʼis ifa ishee hin kennitu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ani addunyaa kana sababii jalʼina isaatiif,","poem":1},{"text":"hamoota sababii cubbuu isaaniitiif nan adaba.","poem":2},{"text":"Ani of tuulummaa of jajjootaa nan balleessa;","poem":1},{"text":"of guddisuu gara jabeeyyii illee gadin deebisa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ani akka namni warqee qulqulluu caalaa gati qabeessa,","poem":1},{"text":"warqee Oofiir caalaas muraasa taʼu nan godha.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kanaafuu ani akka samiiwwan hollatan nan godha;","poem":1},{"text":"gaafa aariin isaa bobaʼutti","poem":2},{"text":"dheekkamsa Waaqayyoo Waan Hunda Dandaʼuutiin","poem":1},{"text":"lafti iddoo isheetii ni raafamti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Namni hundinuu akkuma kuruphee adamsamtuu,","poem":1},{"text":"akkuma hoolota tiksee hin qabnee","poem":2},{"text":"gara saba isaatti deebiʼa;","poem":1},{"text":"namni kam iyyuu biyya isaatti baqata.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Namni boojiʼame hundinuu ni waraanama;","poem":1},{"text":"kan qabame kam iyyuu goraadeedhaan duʼa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Daaʼimman isaanii fuuluma isaanii duratti ni cicciramu;","poem":1},{"text":"manneen isaanii ni saamamu;niitonni isaaniis humnaan gudeedamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kunoo ani warra Meedee","poem":1},{"text":"kanneen meetii irraa dhimma hin qabne","poem":2},{"lineBreak":true},{"text":"warra warqeen hin gammachiifne jarattin kakaasa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Iddaan isaanii dargaggoota fixxi;","poem":1},{"text":"isaan daaʼimmaniif hin naʼan;","poem":2},{"lineBreak":true},{"text":"ijoolleefis garaa hin laafan.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Baabilon ulfinni moototaa,","poem":1},{"text":"miidhaginni of jaja warra Baabilon","poem":2},{"text":"akkuma Sodoomii fi Gomoraa","poem":1},{"text":"irree Waaqaatiin garagalfamti.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Namni ishee keessa hin qubatu;","poem":1},{"text":"yookaan dhaloota hunda keessattinamni ishee keessa hin jiraatu;","poem":2},{"text":"namni Arabaa tokko iyyuu dunkaana isaa achi hin dhaabbatu;","poem":1},{"text":"tikseen tokko iyyuu bushaayee isaa achi hin boqochiifattu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Garuu bineensonni bosonaa achi ciciisu;","poem":1},{"text":"waangoowwan mana ishee ni guutu;","poem":2},{"text":"urunguun achi jiraatti;","poem":1},{"text":"reʼeen diidaa achi keessa buburraaqxi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Waraabessi daʼannoowwan ishee keessaa yuusa;","poem":1},{"text":"waangoonis manneen ishee mimmiidhagoo kan mootummaakeessaa iyyiti.","poem":2},{"text":"Yeroon ishee gaʼeera;","poem":1},{"text":"barri ishees hin dheeratu.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}