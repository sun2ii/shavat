{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Waaqayyo Yaaqoobiif garaa ni laafa;","poem":1},{"text":"inni amma illee Israaʼelin filatee","poem":2},{"lineBreak":true},{"text":"biyya isaanii keessa isaan qubachiisa.","poem":2},{"text":"Ormoonni isaanitti dabalamu;","poem":1},{"text":"mana Yaaqoob wajjinis tokko taʼu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Saboonni isaan fudhatu;","poem":1},{"text":"iddoo ofii isaaniitti isaan deebisu.","poem":2},{"text":"Manni Israaʼel immoo akkuma hojjettoota dhiiraa fi dubartiitti","poem":1},{"text":"lafa Waaqayyoo keessatti dhaala godhanii isaan fudhatu.","poem":2},{"text":"Isaan boojitoota isaanii boojiʼanii","poem":1},{"text":"warra isaan hacuucanis bulchu.","poem":2}]},{"type":"verse","number":3,"content":["Guyyaa Waaqayyo itti dhiphina, rakkinaa fi hojii hamaa isin itti garboomfamtanii turtan sana jalaa isin boqochiisutti,"]},{"type":"verse","number":4,"content":["akkana jettee mootii Baabilonitti ni qoosta:",{"text":"Cunqursichi akkamitti bade!","poem":1},{"text":"Aariin isaas akkamitti isa irraa gale!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Waaqayyo ulee hamootaatii fi","poem":1},{"text":"bokkuu bulchitootaa,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"kan dheekkamsa wal irraa hin cinneetiin","poem":1},{"text":"uummata rukute;","poem":2},{"text":"kan gara laafina tokko malee ariʼee","poem":1},{"text":"saboota dhaʼe sana caccabseera.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lafti hundi boqonnaa fi nagaa argatti;","poem":1},{"text":"faarfachuuttis kaati.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gaattiraawwanii fi birbirsawwan","poem":1},{"text":"Libaanoon iyyuu isinitti burraaqanii,","poem":2},{"text":"“Amma ati kufteerta;","poem":1},{"text":"namni tokko iyyuu nu muruuf hin dhufu” jedhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Siiʼool isheen gadii yeroo ati dhuftutti si simachuuf kaati;","poem":1},{"text":"isheen akka isaan si dubbisaniif hafuurota warra duʼanii,","poem":2},{"text":"warra addunyaa irratti hooggantoota","poem":1},{"text":"turanii hunda dammaqsiteerti;","poem":2},{"text":"isheen warra mootota sabootaa turan hunda","poem":1},{"text":"teessoo isaanii irraa kaafti.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Isaan hundinuu deebisanii akkana jedhu;","poem":1},{"text":"“Atis akkuma keenya dadhabdeerta;","poem":2},{"lineBreak":true},{"text":"akkuma keenya taateerta.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ulfinni kee hundinuu, sagalee baganaa keetii wajjin","poem":1},{"text":"awwaala keessa buufameera;","poem":2},{"text":"ilmaan raammoo si jala afamanii","poem":1},{"text":"raammoon si haguugdi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yaa bakkalcha barii, ilma barii barraaqaa,","poem":1},{"text":"ati akkamitti samii irraa lafa dhoofte!","poem":2},{"text":"Ati kan duraan saboota gad qabde,","poem":1},{"text":"lafatti gad darbatamteerta!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ati garaa keetti akkana jette;","poem":1},{"text":"“Ani samiitti olin baʼa;","poem":2},{"text":"ani urjiiwwan Waaqaatii olitti","poem":1},{"text":"teessoo koo olin baafadha;","poem":2},{"text":"ani tulluu wal gaʼii irra,","poem":1},{"text":"fiixee tulluu qulqullichaa irra teessoo irra nan taaʼa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ani fiixee duumessootaa gara irraatti ol nan baʼa;","poem":1},{"text":"ani akka Waaqa Waan Hundaa Olii ofin taasisa.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Garuu ati siiʼool keessa,","poem":1},{"text":"boolla qilee keessa buufamteerta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Warri si argan ija babaasanii si ilaalu;","poem":1},{"text":"akkana jedhaniis dinqisiifatu:","poem":2},{"text":"“Kun namichuma lafa sochoosee","poem":1},{"text":"akka mootummoonni raafaman godhe,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"namicha addunyaa kana gammoojjii godhe,","poem":1},{"text":"kan magaalaawwan ishee gaggaragalchee","poem":2},{"lineBreak":true},{"text":"akka warri boojiʼaman mana isaaniitti hin deebine godhe sanaa?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Mootonni sabootaa hundi,","poem":1},{"text":"ulfinaan awwaala isaanii keessa ciciisaniiru.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ati garuu akkuma damee jibbame tokkootti,","poem":1},{"text":"awwaala kee keessaa baafamtee gatamteerta;","poem":2},{"text":"ati warra ajjeefamaniin,","poem":1},{"text":"warra goraadeen waraanamaniin,","poem":2},{"lineBreak":true},{"text":"warra gara dhagaa boollaatti gad buʼaniin haguugamteerta.","poem":2},{"text":"Akkuma reeffaa miillaan dhidhiitamteerta;","poem":1}]},{"type":"verse","number":20,"content":[{"text":"ati sababii biyya kee balleessitee","poem":2},{"text":"namoota kee fixxeef,","poem":1},{"text":"isaan gidduutti hin awwaalamtu.","poem":2},{"lineBreak":true},{"lineBreak":true},{"text":"Maqaan sanyii hamootaa","poem":1},{"text":"lammata hin dhaʼamu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Sababii cubbuu abbootii isaaniitiif","poem":1},{"text":"iddoo ilmaan isaa itti qalaman qopheessaa;","poem":2},{"text":"isaan biyya dhaaluudhaaf,","poem":1},{"text":"magaalaawwan isaaniitiinis lafa guutuuf hin kaʼan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Ani isaanitti nan kaʼa,”","poem":1},{"text":"jedha Waaqayyoon Waan Hunda Dandaʼu.","poem":2},{"text":"“Ani Baabilon keessaa maqaa isheetii fi hambaa ishee,","poem":1},{"text":"ilmaan isheetii fi sanyii ishee nan balleessa”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"“Ani iddoo urunguun keessa jiraattuu fi","poem":1},{"text":"lafa caffee ishee nan godha;","poem":2},{"text":"ani hartuu badiisaatiin ishee nan haxaaʼa”","poem":1},{"text":"jedha Waaqayyoon Waan Hunda Dandaʼu.","poem":2}]},{"type":"heading","content":["Raajii Asooriin Mormu"]},{"type":"verse","number":24,"content":["Waaqayyoon Waan Hunda Dandaʼu akkana jedhee kakateera;",{"text":"“Dhugumaan akkuma ani duraan karoorfadhe sanawanni kun ni taʼa;","poem":1},{"text":"akkuma ani yaade sanas ni dhaabata.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ani biyya koo keessatti Asoorota nan barbadeessa;","poem":1},{"text":"tulluuwwan koo irratti ani isa gad dhidhiita.","poem":2},{"text":"Waanjoon isaa saba koo irraa ni fuudhama;","poem":1},{"text":"baʼaan isaas gatiittii isaanii irraa ni buʼa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Karoorri guutummaa addunyaatiif murtaaʼe kanaa dha;","poem":1},{"text":"kun harka saboota hunda irratti diriirfamee dha.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Waaqayyoon Waan Hunda Dandaʼu","poem":1},{"text":"waan kana yaadeeraatii, eenyutu isa garagalcha?","poem":2},{"text":"Harki isaa diriirfameeraa;","poem":1},{"text":"eenyutu duubatti isa deebisuu dandaʼa?","poem":2}]},{"type":"heading","content":["Raajii Filisxeemotaan Mormu"]},{"type":"verse","number":28,"content":["Raajiin kun bara Aahaaz mootichi duʼe keessa dhufe:"]},{"type":"verse","number":29,"content":[{"text":"Yaa Filisxeemota, uleen isin dhaʼe waan cabeef,","poem":1},{"text":"isin hundinuu hin gammadinaa;","poem":2},{"text":"hidda bofa sanaa keessaa buutiitu baʼa;","poem":1},{"text":"iji isaa bofa darbatamaa summii qabu ni taʼa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Hiyyeessi gadadamaan iddoo itti bobbaʼu argata;","poem":1},{"text":"rakkataanis nagaadhaan ciisa.","poem":2},{"text":"Hidda kee garuu ani beelaan nan barbadeessa;","poem":1},{"text":"beellis hambaa kee ni fixa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Yaa karra, ati booʼi! Yaa magaalaa, iyyi!","poem":1},{"text":"Filisxeemonni hundi baqaatii badaa!","poem":2},{"text":"Duumessi aaraa tokko karaa kaabaatiin ni dhufa;","poem":1},{"text":"raayyaa waraana isaa keessas kan citee hafu tokko iyyuu hin jiru.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ergamoota saba sanaatiif","poem":1},{"text":"deebii akkamiitu kennamuu mala?","poem":2},{"text":"“Waaqayyo jabeessee Xiyoonin dhaabeera;","poem":1},{"text":"ishee keessattis namoonni isaa kanneen miidhamandaʼannoo ni argatu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/13.json","previousChapterAudioLinks":{},"numberOfVerses":32}