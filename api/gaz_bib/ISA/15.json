{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":15,"content":[{"type":"heading","content":["Raajii Moʼaabiin Mormu"]},{"type":"verse","number":1,"content":["Raajii waaʼee Moʼaab:",{"text":"Aari isheen Moʼaab keessaa diigamteerti;","poem":1},{"text":"halkanuma tokkottis baddeerti!","poem":2},{"text":"Qiir isheen Moʼaab keessaa diigamteerti;","poem":1},{"text":"halkanuma tokkottis baddeerti!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Diiboon gara mana qulqullummaatti,","poem":1},{"text":"iddoowwan ol kaʼaatti booʼuuf ol baʼa;","poem":2},{"lineBreak":true},{"text":"Moʼaabis Neboo fi Meedebaaf ni booʼa.","poem":2},{"text":"Mataan hundinuu haadamaa dha;","poem":1},{"text":"areedni hundinuus cicciramaa dha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isaan daandii irratti wayyaa gaddaa uffatu;","poem":1},{"text":"bantii manaatii fi waltajjii sabaa irratti","poem":2},{"text":"hundi isaanii ni booʼu;","poem":1},{"text":"imimmaan isaaniis ni dhangalaasu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Heshboonii fi Eleʼaaleen ni iyyu;","poem":1},{"text":"sagaleen isaaniis hamma Yaahaziitti fagaatee dhagaʼame.","poem":2},{"text":"Kanaafuu loltoonni Moʼaab ni iyyu;","poem":1},{"text":"lubbuun isaaniis ni romʼite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Garaan koo Moʼaabiif iyya;","poem":1},{"text":"kooluu galtoonni ishee hamma Zoʼaariitti,","poem":2},{"lineBreak":true},{"text":"hamma Eglaati Sheelishiyaatti baqatu.","poem":2},{"text":"Isaan booʼaa, gara Luuhiititti ol baʼu;","poem":1},{"text":"karaa Hooronaayim irrattis,","poem":2},{"lineBreak":true},{"text":"waaʼee badii isaanii faarsanii booʼu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bishaanonni Niimriim goganiiru;","poem":1},{"text":"margis coollageera;","poem":2},{"text":"biqiltuuwwan lafaa badaniiru;","poem":1},{"text":"wanni magariisni tokko iyyuu hin hafne.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kanaafuu isaan qabeenya argatanii kuufatan sana","poem":1},{"text":"Laga Alaltuu irraan baatanii dabarfatu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iyyi isaanii hamma daarii Moʼaabitti dhagaʼame;","poem":1},{"text":"wawwaachuun isaanii hamma Eglayiimitti","poem":2},{"lineBreak":true},{"text":"faaruun booʼicha isaaniis hamma Beʼeer Eeliimiinitti dhagaʼame.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bishaanonni Diimon dhiigaan guutamaniiru;","poem":1},{"text":"ani immoo waan kana caalu iyyuu Diimonitti nan fida;","poem":2},{"text":"warra Moʼaab keessaa baqatan","poem":1},{"text":"kanneen biyya sanatti hafanitti leenca nan erga.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}