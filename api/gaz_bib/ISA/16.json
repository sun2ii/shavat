{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"Seelaa, gammoojjii gama jirtu sana irraa","poem":1},{"text":"bulchaa biyyattiitiif,","poem":2},{"text":"gara tulluu Intala Xiyoonitti","poem":1},{"text":"xobbaallaawwan hoolaa gibira ergaa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Akkuma simbira manʼee ishee keessaa ariʼamtee","poem":1},{"text":"asii fi achi fiigduu dubartoonni Moʼaabis","poem":2},{"lineBreak":true},{"text":"malkaa laga Arnoonitti akkasuma taʼu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Gorsa nuuf kennaa; murtii murteessaa.","poem":1},{"text":"Guyyaa saafaadhaan gaaddidduu keessan","poem":2},{"lineBreak":true},{"text":"akkuma halkanii dukkaneessaa.","poem":2},{"text":"Baqattootas dhoksaa;","poem":1},{"text":"kooluu galtoota hin ganinaa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Baqattoonni Moʼaab isin wajjin haa jiraatan;","poem":1},{"text":"balleessituu irraa daʼoo isaaniif taʼaa.”","poem":2},{"lineBreak":true},{"text":"Cunqursaan ni bada;","poem":1},{"text":"badiisnis ni hafa;","poem":2},{"lineBreak":true},{"text":"warri nama miidhan lafa irraa badu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Teessoon jaalalaan hundeeffama;","poem":1},{"text":"mana Daawit keessaa namni murtii kennuu irratti","poem":2},{"lineBreak":true},{"text":"murtii qajeelaa barbaadu,","poem":2},{"text":"kan waan qajeelaa hojjechuuf ariifatu tokko","poem":1},{"text":"amanamummaadhaan teessoo sana irra ni taaʼa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nu of tuulummaa Moʼaab,","poem":1},{"text":"of guddisuu fi kooruu ishee,","poem":2},{"text":"of tuuluu fi addaggee taʼuu ishee dhageenyeerra;","poem":1},{"text":"of jajuun ishee garuu faayidaa hin qabu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kanaafuu Moʼaabonni ni booʼu;","poem":1},{"text":"isaan tokkummaadhaan Moʼaabiif booʼu.","poem":2},{"text":"Namoota Qiir Hareeshetiif","poem":1},{"text":"faarsanii booʼuudhaan gaddu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lafti qotiisaa Heshboon,","poem":1},{"text":"mukni wayinii Sibimaas coollageera.","poem":2},{"text":"Bulchitoonni sabootaa","poem":1},{"text":"mukkeen wayinii filatamoo","poem":2},{"text":"kanneen duraan Yaʼizeerin gaʼanii","poem":1},{"text":"gara gammoojjiitti babalʼatan dhidhiitaniiru.","poem":2},{"lineBreak":true},{"text":"Lataan isaanii dheeratee hamma galaanaatti diriire.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kanaafuu ani akkuma Yaʼizeer boosse sana,","poem":1},{"text":"mukkeen wayinii Sibimaatiif nan booʼa.","poem":2},{"text":"Yaa Heshboon, yaa Eleʼaalee,","poem":1},{"text":"ani imimmaan kootiin sin jiisa!","poem":2},{"text":"Ililleen yeroo midhaan siif gaʼeetii fi","poem":1},{"text":"gammachuun yeroo midhaan siifhaamamu ture sun hafeera.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ililchuu fi gammaduun iddoo biqiltuu keessaa badaniiru;","poem":1},{"text":"namni tokko iyyuu iddoo dhaabaa wayinii keessattihin faarfatu yookaan hin ililchu:","poem":2},{"text":"sababii ani ilillee balleesseef","poem":1},{"text":"namni iddoo wayinii itti cuunfanitti wayinii dhidhiitu tokko hin jiru.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Garaan koo akkuma baganaa faarsee Moʼaabiif booʼa;","poem":1},{"text":"keessi koos Qiir Hareeshetiif booʼa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Moʼaab yoo iddoo ol kaʼaatti mulʼatte,","poem":1},{"text":"isheen ofuma dadhabsiifti;","poem":2},{"text":"yoo kadhannaaf gara iddoo qulqulluu ishee dhaqxe","poem":1},{"text":"kunis faayidaa tokko illee hin qabu.","poem":2}]},{"type":"verse","number":13,"content":["Kun dubbii Waaqayyo duraanuu waaʼee Moʼaab dubbatee dha."]},{"type":"verse","number":14,"content":["Waaqayyo garuu amma akkana jedha: “Waggaa sadii keessatti, ulfinni Moʼaabii fi namoonni ishee hedduun hundi akkuma hojjetaan tokko guyyaa isaa lakkaaʼatu sana ni tuffatamu; kanneen hafanis akka malee muraasaa fi dadhaboo taʼu.”"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/15.json","previousChapterAudioLinks":{},"numberOfVerses":14}