{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":2,"content":[{"type":"heading","content":["Tulluu Waaqayyoo"]},{"type":"verse","number":1,"content":["Wanni Isaayyaas ilmi Amoos waaʼee Yihuudaatii fi Yerusaalem arge kanaa dha:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["Bara dhumaa keessa,",{"text":"tulluun mana qulqullummaa Waaqayyoo","poem":1},{"text":"tulluuwwan hunda keessaa ol dheeratee dhaabata;","poem":2},{"text":"inni tulluuwwan caalaa ol ol jedha;","poem":1},{"text":"saboonni hundinuu gara isaatti yaaʼu.","poem":2}]},{"type":"verse","number":3,"content":["Namoonni baayʼeen dhufanii akkana jedhu;",{"text":"“Kottaa gara tulluu Waaqayyoo,","poem":1},{"text":"gara mana Waaqa Yaaqoob ol baanaa.","poem":2},{"text":"Inni akka nu daandii isaa irra deemnuuf","poem":1},{"text":"karaa isaa nu barsiisa.”","poem":2},{"text":"Seerri Xiyoon keessaa,","poem":1},{"text":"dubbiin Waaqayyoo immooYerusaalem keessaa ni baʼa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inni saboota gidduutti murtii kenna;","poem":1},{"text":"namoota hedduudhaafis ni murteessa.","poem":2},{"text":"Isaan goraadee isaanii tumanii maarashaa tolfatu;","poem":1},{"text":"eeboo isaaniis tumanii haamtuu tolfatu.","poem":2},{"text":"Sabni tokko saba biraatti goraadee hin luqqifatu;","poem":1},{"text":"yookaan lolaaf nama hin leenjifatan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yaa mana Yaaqoob,","poem":1},{"text":"kottaa ifa Waaqayyoo keessa deddeebinaa.","poem":2}]},{"type":"heading","content":["Guyyaa Waaqayyoo"]},{"type":"verse","number":6,"content":[{"text":"Kanaafuu saba kee,","poem":1},{"text":"mana Yaaqoob dhiifteerta.","poem":2},{"text":"Isaan bartee Baʼa Biiftuutiin guutamaniiru;","poem":1},{"text":"akkuma Filisxeemotaa falfala hojjetu;","poem":2},{"lineBreak":true},{"text":"duudhaa namoota ormaattis ni cichu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Biyyi isaanii meetii fi warqeen guutamteerti;","poem":1},{"text":"qabeenyi isaanii dhuma hin qabu.","poem":2},{"text":"Biyyi isaanii fardeeniin guutamteerti;","poem":1},{"text":"gaariiwwan isaaniis dhuma hin qaban.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Biyyi isaanii waaqota tolfamoodhaan guutamteerti;","poem":1},{"text":"isaan hojiidhuma harka isaanii,","poem":2},{"lineBreak":true},{"text":"waanuma qubni isaanii tolcheef sagadu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kanaafuu namni gad qabama;","poem":1},{"text":"ilmaan namaa gad deebifamu;","poem":2},{"lineBreak":true},{"text":"ati isaaniif hin dhiisin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Argamuu Waaqayyoo isa sodaachisaa fi","poem":1},{"text":"surraa ulfina isaa duraa, kattaa keessa lixu;","poem":2},{"lineBreak":true},{"text":"lafa keessas dhokadhu!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iji nama of tuuluu gad qabama;","poem":1},{"text":"of jajuun namootaas gad deebifama;","poem":2},{"text":"gaafas Waaqayyo qofatu ol ol jedha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Waaqayyoon Waan Hunda Dandaʼu","poem":1},{"text":"warra of jajuu fi warra of tuulu hundaaf,","poem":2},{"text":"warra ol ol jedhan hundaaf guyyaa tokko qaba;","poem":1},{"text":"isaanis gad deebifamu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Inni birbirsa Libaanoon dheeraa fi","poem":1},{"text":"guddaa hundaaf, qilxuu Baashaan hundaaf,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"tulluuwwan ol dhedheeroo hundaaf,","poem":1},{"text":"gaarran ol dhedheeroo hundaaf,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"gamoo gurguddaa hundaaf,","poem":1},{"text":"dallaa dhagaadhaan jabeeffamee ijaarame hundaaf,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"doonii daldalaa hundaa fi waan gatii guddaa qabu hundaaf","poem":1},{"text":"guyyaa murteeffate tokko qaba.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Of tuulummaan namaa gad qabama;","poem":1},{"text":"of jajuun namootaas gad deebifama;","poem":2},{"text":"gaafas Waaqayyo qofatu ol ol jedha;","poem":1}]},{"type":"verse","number":18,"content":[{"text":"waaqonni tolfamoon guutumaan guutuutti ni barbadeeffamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Namoonni yommuu inni lafa raasuuf kaʼutti,","poem":1},{"text":"sodaachisa Waaqayyootii fi","poem":2},{"text":"surraa isaa ulfina qabeessa sana duraa","poem":1},{"text":"gara holqa kattaa keessaattii fi","poem":2},{"lineBreak":true},{"text":"boolla lafa keessaatti ni baqatu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Gaafas namoonni waaqota isaanii tolfamoo","poem":1},{"text":"kanneen waaqeffachuuf jedhanii","poem":2},{"text":"meetii fi warqee irraa tolfatan sana","poem":1},{"text":"tuqaa fi simbira halkaniitiif darbatu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Isaan yommuu inni lafa raasuuf kaʼutti","poem":1},{"text":"sodaachisa Waaqayyootii fi","poem":2},{"text":"surraa ulfina isaa duraa gara holqa guddaa","poem":1},{"text":"kattaawwan keessaatii fi baqaqaa kattaatti ni baqatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Nama duʼa hin oolle,","poem":1},{"text":"kan hafuurri isaa funyaan irra jiru abdachuu dhiisaa.","poem":2},{"lineBreak":true},{"text":"Inni maalitti lakkaaʼama?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}