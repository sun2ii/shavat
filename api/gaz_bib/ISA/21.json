{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":21,"content":[{"type":"heading","content":["Raajii Baabiloniin Mormu"]},{"type":"verse","number":1,"content":["Raajii Gammoojjii Galaana bira jirtuun mormu:",{"text":"Akkuma bubbeen hamaan biyya kibbaa haxaaʼu sana,","poem":1},{"text":"weeraraan tokko gammoojjiidhaa,","poem":2},{"lineBreak":true},{"text":"biyya sodaachisaa keessaa ni dhufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mulʼanni hamaan tokko natti mulʼateera:","poem":1},{"text":"gantuun ni ganti; saamtuunis ni saamti.","poem":2},{"text":"Yaa Eelaam, ol baʼi! Yaa Meedee marsii qabi!","poem":1},{"text":"Ani aaduu isheen fidde hunda nan xumura.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kana irratti dugdi na cite;","poem":1},{"text":"akkuma dubartii ciniinsifattuu muddamni na qabe;","poem":2},{"text":"ani waanan dhagaʼeen nan holladhe;","poem":1},{"text":"waanan argeenis nan raafame.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Qalbiin koo ni raafame;","poem":1},{"text":"sodaan na hollachiise;","poem":2},{"text":"dimimmisni ani hawwe sun","poem":1},{"text":"sodaatti na jalaa geeddarame.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Isaan maaddii qopheessu;","poem":1},{"text":"afaa diriirsu;","poem":2},{"lineBreak":true},{"text":"ni nyaatu, ni dhugu!","poem":2},{"text":"Isin qondaaltonni kaʼaa;","poem":1},{"text":"gaachanas zayitii dibaa.","poem":2}]},{"type":"verse","number":6,"content":["Gooftaan akkana naan jedha:",{"text":"“Dhaqiitii eegduu tokko ramadi;","poem":1},{"text":"innis waan argu haa himu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni yommuu warra farda yaabbatan","poem":1},{"text":"kanneen lama lamaan yaaʼan,","poem":2},{"text":"warra harree yaabbatan","poem":1},{"text":"yookaan warra gaala yaabbatan argutti,","poem":2},{"text":"haa dammaqu;","poem":1},{"text":"guutumaan guutuutti haa dammaqu.”","poem":2}]},{"type":"verse","number":8,"content":["Eegduun sunis akkana jedhee iyye;",{"text":"“Yaa gooftaa ko, ani guyyuma guyyaan","poem":1},{"text":"qooxii eegumsaa irra nan dhaabadha;","poem":2},{"lineBreak":true},{"text":"halkan hundas ani hojii koo irra nan tura.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kunoo, warri farda yaabbatan,","poem":1},{"text":"lama lamaan dhufaa jiru;","poem":2},{"text":"inni akkana jedhee deebise:","poem":1},{"text":"‘Baabilon jigdeerti; jigdeerti!","poem":2},{"text":"Fakkiiwwan waaqota ishee hundinuu","poem":1},{"text":"burkutaaʼanii lafa dhaʼaniiru!’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yaa saba koo warra oobdii midhaanii irratti dhaʼamtan,","poem":1},{"text":"ani waan Waaqayyoon Waan Hunda Dandaʼu,","poem":2},{"lineBreak":true},{"text":"Waaqa Israaʼel irraa dhagaʼe isinittin hima.","poem":2}]},{"type":"heading","content":["Raajii Edoomiin mormu"]},{"type":"verse","number":11,"content":["Raajii Duumaan mormu:",{"text":"Namni tokko Seeʼiirii na waamee,","poem":1},{"text":"“Yaa eegduu, halkan kun bariʼuuf hammamtu hafe?","poem":2},{"lineBreak":true},{"text":"Yaa eegduu, halkan kun bariʼuuf hammamtu hafe?” jedhe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Eegduun sunis,","poem":1},{"text":"“Bariʼuu gaʼeera; garuu deebiʼee dhiʼa.","poem":2},{"text":"Yoo gaafachuu barbaaddan gaafadhaa;","poem":1},{"text":"garuu deebiʼaa kottaa” jedhee deebisa.","poem":2}]},{"type":"heading","content":["Raajii Biyya Arabaatiin Mormu"]},{"type":"verse","number":13,"content":["Raajii biyya Arabaatiin mormu:",{"text":"Isin imaltoonni Dedaan","poem":1},{"text":"kanneen bosona Arabaa keessa qubattan,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"warra dheeboteef bishaan fidaa;","poem":2},{"text":"isin warri Teemaa keessa jiraattan,","poem":1},{"text":"baqattootaaf waan nyaatan fidaa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Isaan goraadee jalaa,","poem":1},{"text":"goraadee luqqifame jalaa,","poem":2},{"text":"xiyya aggaamame jalaa,","poem":1},{"text":"hoʼa waraanaa jalaa baqataniiruutii.","poem":2}]},{"type":"verse","number":16,"content":["Gooftaan akkana naan jedhe: “Akkuma waggoota hojjetaa qaxaramaa tokkootti ulfinni Qeedaar hundinuu waggaa tokko keessatti ni dhuma."]},{"type":"verse","number":17,"content":["Warra xiyya darbatan keessaa kanneen hafan, gootonni Qeedaar muraasa taʼu.” Waaqayyo Waaqni Israaʼel dubbateeraatii."]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}