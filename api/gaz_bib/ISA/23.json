{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":23,"content":[{"type":"heading","content":["Raajii Waaʼee Xiiroos"]},{"type":"verse","number":1,"content":["Raajii waaʼee Xiiroos:",{"text":"Yaa dooniiwwan Tarshiishi wawwaadhaa!","poem":1},{"text":"Xiiroos barbadooftee","poem":2},{"lineBreak":true},{"text":"mana yookaan buufata doonii malee hafteertii.","poem":2},{"text":"Biyya Qophroos","poem":1},{"text":"oduun isaan qaqqabeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Isin jiraattoonni qarqara galaanaatii fi","poem":1},{"text":"daldaltoonni Siidoonaa, warri galaana irra marmaaran","poem":2},{"lineBreak":true},{"text":"isin sooromsan calʼisaa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Midhaan Shihoor","poem":1},{"text":"bishaanota gurguddaa irraan dhufe;","poem":2},{"text":"oomishni Abbayyaa Xiiroosiif galii ture;","poem":1},{"text":"isheenis lafa gabaa kan sabootaa taate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yaa Siidoonaa, yaa daʼannoo galaanaa qaanaʼi;","poem":1},{"text":"galaanni akkana jedhee dubbateeraatii:","poem":2},{"text":"“Ani hin ciniinsifanne yookaan hin deenye;","poem":1},{"text":"ilmaan hin horanne yookaan intallan hin guddifanne.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yeroo oduun gara Gibxi dhufutti","poem":1},{"text":"isaan gabaasa Xiiroos irraa dhufuun ni dhiphatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Isin gara Tarshiishitti ceʼaa;","poem":1},{"text":"yaa warra qarqara galaanaa jiraattan wawwaadhaa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Magaalaa dulloomtuun durii,","poem":1},{"text":"kan miilli ishee ishee fuudhee,","poem":2},{"text":"akka isheen biyya fagoo keessa qubattuuf ishee geesse kun,","poem":1},{"text":"magaalaa kee ishee fandalaltuudhaa?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xiiroos ishee gonfoo nama gonfachiiftu","poem":1},{"text":"kan daldaltoonni ishee ilmaan moototaa taʼan","poem":2},{"text":"kan daldaltoonni ishee lafa irratti kabajamoo taʼanitti","poem":1},{"text":"eenyutu waan kana karoorfate?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Waaqayyoon Waan Hunda Dandaʼu","poem":1},{"text":"of jaja ishee kan ulfina ishee hunda keessa jiru gad deebisuu fi","poem":2},{"lineBreak":true},{"text":"warra lafa irratti kabajaman hunda salphisuufwaan kana karoorfateera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yaa Intala Tarshiish,","poem":1},{"text":"ati siʼachi buufata doonii hin qabaattuutii,","poem":2},{"lineBreak":true},{"text":"lafa kee hamma Abbayyaa bira gaʼutti qotadhu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Waaqayyo harka isaa galaana irra qabee","poem":1},{"text":"mootummoota hollachiiseera.","poem":2},{"text":"Inni akka daʼannoowwan ishee diigamaniif","poem":1},{"text":"waaʼee Kanaʼaan ajaja kenneera.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Innis akkana jedha; “Yaa Durba Siidoonaa,","poem":1},{"text":"ati kana caalaa hin fandalaltu!","poem":2},{"lineBreak":true},{"text":"“Kaʼiitii gara Qophiroositti ceʼi;","poem":1},{"text":"ati achitti iyyuu boqonnaa hin argattu.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mee biyya Baabilonotaa ilaali;","poem":1},{"text":"uummanni kun amma seenaa hin qabu!","poem":2},{"text":"Warri Asoor akka isheen","poem":1},{"text":"iddoo jireenya uumamawwan gammoojjii taatu godhan;","poem":2},{"text":"isaan siree eegumsaa ijaarratan;","poem":1},{"text":"daʼannoowwan ishee qullaa hambisan;","poem":2},{"lineBreak":true},{"text":"ishees ni barbadeessan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yaa dooniiwwan Tarshiish wawwaadhaa;","poem":1},{"text":"daʼannoon keessan barbadeeffameeraatii!","poem":2}]},{"type":"verse","number":15,"content":["Yeroo sanaa jalqabee Xiiroos hamma waggaa torbaatamaatti ni dagatamti; kunis bara jireenya mootii tokkoo ti. Dhuma waggaa torbaatamman sanaatti garuu akkuma sirba sagaagaltuu tokkoof sirbame sanaatti Xiiroos irra gaʼa:"]},{"type":"verse","number":16,"content":[{"text":"“Yaa sagaagaltuu irraanfatamtuu,","poem":1},{"text":"baganaa qabadhuutii magaalaa keessa naannaʼi;","poem":2},{"text":"ati akka yaadatamtuuf baganaa sirriitti rukuti;","poem":1},{"text":"sirba baayʼee sirbi.”","poem":2}]},{"type":"verse","number":17,"content":["Dhuma waggaa torbaatamaatti Waaqayyo Xiiroosin ni yaadata; isheenis gara daldala isheetti deebitee mootummoota fuula lafaa irra jiran hunda wajjin sagaagalti."]},{"type":"verse","number":18,"content":["Taʼus buʼaan isheetii fi wanni isheen argattu Waaqayyoof addaan baafama; hin kuufamu; walittis hin qabamu. Buʼaan ishees warra fuula Waaqaa dura jiraataniif nyaata gaʼaa fi uffata babbareedaa taʼa."]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}