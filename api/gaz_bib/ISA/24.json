{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":24,"content":[{"type":"heading","content":["Waaqayyo Lafa Ni barbadeessa"]},{"type":"verse","number":1,"content":[{"text":"Kunoo, Waaqayyo lafa ni onsa;","poem":1},{"text":"ishees ni barbadeessa;","poem":2},{"text":"inni ishee gaggaragalchee","poem":1},{"text":"warra ishee irra jiraatan bittinneessa;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kan saba irra gaʼu luba irra,","poem":1},{"text":"kan garbicha irra gaʼu gooftaa irra,","poem":2},{"lineBreak":true},{"text":"kan garbittii irra gaʼu giiftii irra,","poem":2},{"lineBreak":true},{"text":"kan bitataa irra gaʼu gurgurataa irra,","poem":2},{"lineBreak":true},{"text":"kan isa ergifatu irra gaʼu, isa ergisu irra,","poem":2},{"lineBreak":true},{"text":"kan liqeeffataa irra gaʼu, isa liqeessu ni gaʼaatii.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lafti guutumaan guutuutti ni onti;","poem":1},{"text":"guutumaan guutuuttis ni saamamti.","poem":2},{"text":"Waaqayyo waan kana dubbateeraatii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lafti ni gogdi; bifti ishees ni geeddarama;","poem":1},{"text":"addunyaan ni bututti; bifti ishees ni geeddarama;","poem":2},{"lineBreak":true},{"text":"gurguddoonni saba lafaas ni bututu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lafti saba isheetiin xuroofteerti;","poem":1},{"text":"isaan seeraaf ajajamuu didan;","poem":2},{"text":"sirnaan buluu didanii","poem":1},{"text":"kakuu bara baraa sana cabsaniiru.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kanaafuu abaarsi lafa balleessa;","poem":1},{"text":"sabni ishees balleessaa isaatiif adabama.","poem":2},{"text":"Kanaafuu jiraattonni lafaa ni gubatu;","poem":1},{"text":"nama muraasatu hafa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Daadhiin wayinii haaraan ni goga;","poem":1},{"text":"mukni wayiniis ni coollaga;","poem":2},{"lineBreak":true},{"text":"warri gammadan hundinuu ni aadu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dibbeen sagaleen isaa namatti tolu ni calʼisa;","poem":1},{"text":"wacni fandalaltootaa qabbanaaʼeera;","poem":2},{"lineBreak":true},{"text":"baganaan nama gammachiisus calʼiseera.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isaan siʼachi sirbaa daadhii wayinii hin dhugan;","poem":1},{"text":"dhugaatiin jabaan warra isa dhuganitti ni hadhaaʼa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Magaalaan diigamte sun ontee hafti;","poem":1},{"text":"akka namni tokko iyyuu ol hin seenneef manni hundi ni cufama.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isaan daadhii wayinii dhabanii daandii irratti booʼu;","poem":1},{"text":"gammachuun hundi gaddatti geeddarama;","poem":2},{"lineBreak":true},{"text":"ililchuun hundis lafa irraa dhabama.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Magaalaan sun diigamtee hafti;","poem":1},{"text":"karri ishees ni caccaba.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Akkuma yeroo mukni ejersaa dhaʼamuu fi","poem":1},{"text":"akkuma yeroo wayiniin galfamutti qarmiin hafu taʼu sana,","poem":2},{"text":"lafa irratti saboota gidduuttis","poem":1},{"text":"akkasuma ni taʼa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Isaan sagalee ol fudhatanii gammachuun iyyu;","poem":1},{"text":"gama lixa biiftuutti ulfina Waaqayyoo labsu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kanaafuu isin baʼa biiftuu irraa Waaqayyoof ulfina kennaa;","poem":1},{"text":"qarqara galaanaattis maqaa Waaqayyo","poem":2},{"lineBreak":true},{"text":"Waaqa Israaʼel leellisaa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nu moggaa lafaa irraa faarfannaa,","poem":1},{"text":"“Isa qajeelaa sanaaf ulfinni haa taʼu” jedhu dhageenya.","poem":2},{"lineBreak":true},{"text":"Ani garuu akkanan jedhe;","poem":1},{"text":"“Ani bade, ani bade! Anaaf wayyoo!","poem":2},{"text":"Gantoonni ni ganu!","poem":1},{"text":"Gantoonni gantummaa isaaniitiin ganu!”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yaa uummata lafa irraa,","poem":1},{"text":"sodaan, qilee fi kiyyoon si eeggatu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Namni sagalee goolii baqatu kam iyyuu","poem":1},{"text":"qilee keessa buʼa;","poem":2},{"text":"namni qilee keessaa ol baʼu kam iyyuu","poem":1},{"text":"kiyyoodhaan qabama.","poem":2},{"lineBreak":true},{"text":"Foddaan samiiwwanii banameeraatii","poem":1},{"text":"hundeewwan lafaa ni raafamu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Lafti baqaqxeerti;","poem":1},{"text":"lafti gargar baateerti;","poem":2},{"lineBreak":true},{"text":"lafti akka malee raafamteerti;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Lafti akkuma nama machaaʼee gatantarti;","poem":1},{"text":"isheen akkuma daasii bubbeedhaan raafamti;","poem":2},{"text":"yakki fincila ishee akka malee itti ulfaateera;","poem":1},{"text":"isheen ni jigdi; deebitees hin kaatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Waaqayyo gaafas","poem":1},{"text":"humnoota samii, samii irratti,","poem":2},{"lineBreak":true},{"text":"mootota lafaa immoo lafa irratti ni adaba.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Isaan akkuma hidhamtootaa","poem":1},{"text":"boolla keessaatti walitti qabamu;","poem":2},{"text":"manni hidhaa itti cufamee","poem":1},{"text":"guyyaa hedduu booddee adabamu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Jiʼi ni burjaajofti; aduunis ni qaanofti;","poem":1},{"text":"Waaqayyoon Waan Hunda Dandaʼu,","poem":2},{"text":"Tulluun Xiyoon irrattii fi Yerusaalem keessatti","poem":1},{"text":"fuula maanguddootaa duratti ulfinaan ni moʼaatii.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}