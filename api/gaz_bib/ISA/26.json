{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":26,"content":[{"type":"heading","content":["Faarfannaa Galataa"]},{"type":"verse","number":1,"content":["Bara sana faarfannaan kun biyya Yihuudaa keessatti faarfatama:",{"text":"Nu magaalaa jabaa qabna;","poem":1},{"text":"Waaqnis fayyina,","poem":2},{"lineBreak":true},{"text":"dallaa eegumsa isheetii fi daʼannoo ishee taasisa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Akka sabni qajeelaan,","poem":1},{"text":"sabni amanamummaadhaan jiraatu ol seenuuf,","poem":2},{"lineBreak":true},{"text":"karrawwan banaa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inni sitti irkateeraatii,","poem":1},{"text":"nama yaadni garaa isaa si wajjin jiru,","poem":2},{"lineBreak":true},{"text":"ati nagaa hirʼina hin qabneen isa eegda.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sababii Waaqayyo, Waaqayyo mataan isaa,","poem":1},{"text":"Kattaa bara baraa taʼeef, bara baraan Waaqayyoon amanadhaa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inni warra iddoo ol kaʼaa irra jiraatan gad qaba;","poem":1},{"text":"magaalaa tabba irra jirtu gad buusa;","poem":2},{"lineBreak":true},{"text":"lafatti gatees awwaaratti ishee maka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Miilli, miilli warra hacuucamee,","poem":1},{"text":"faanni hiyyeeyyii ishee dhidhiita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Daandiin nama qajeelaa wal qixxaataa dha;","poem":1},{"text":"yaa Isa Tolaa, ati qajeeltotaaf karaa baafta.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yaa Waaqayyo,","poem":1},{"text":"nu karaa seera keetii irra deemaa si eegganna,","poem":2},{"text":"maqaan keetii fi beekamuun kee","poem":1},{"text":"hawwii garaa keenyaa ti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Halkan lubbuun koo si yaaddi;","poem":1},{"text":"ganamas hafuurri koo baayʼisee si barbaada.","poem":2},{"text":"Yeroo murtiin kee gara lafaa dhufutti,","poem":1},{"text":"uummanni addunyaa qajeelummaa barata.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Namni hamaan gara laafinni godhamuuf iyyuu,","poem":1},{"text":"qajeelummaa hin baratu;","poem":2},{"text":"biyya qajeelummaan jirutti iyyuu inni ittuma fufee jalʼina hojjeta;","poem":1},{"text":"surraa Waaqayyoos hin hubatu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yaa Waaqayyo, harki kee ol kaafameera;","poem":1},{"text":"isaan garuu isa hin argan.","poem":2},{"text":"Isaan hinaaffaa ati saba keetiif qabdu arganii haa qaanaʼan;","poem":1},{"text":"ibiddi diinota keetiif kuufame sun isaan haa balleessu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yaa Waaqayyo, ati nagaa nuuf kenniteerta;","poem":1},{"text":"ati hojii keenya hunda nuuf hojjetteertaatii.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yaa Waaqayyo Waaqa keenya,","poem":1},{"text":"si malee gooftonni biraa nu bulchaniiru;","poem":2},{"lineBreak":true},{"text":"nu garuu maqaa kee qofa ulfeessina.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Isaan amma duʼaniiru; siʼachi hin jiraatan;","poem":1},{"text":"isaan gaaddidduu dha; deebiʼaniis hin kaʼan.","poem":2},{"text":"Ati isaan adabde; isaan balleessites;","poem":1},{"text":"yaadannoo isaanii hundas ni barbadeessite.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yaa Waaqayyo, ati saba baayʼisteerta;","poem":1},{"text":"ati saba baayʼisteerta;","poem":2},{"text":"ati ofii keetiif ulfina argatteerta;","poem":1},{"text":"daarii biyyaa hunda balʼifteerta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Yaa Waaqayyo, isaan yeroo dhiphinaatti si barbaaddatan;","poem":1},{"text":"yeroo ati isaan adabdetti","poem":2},{"lineBreak":true},{"text":"isaan kadhannaa gad roobsan.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Akkuma dubartiin ulfaa yeroo daʼuu geessutti,","poem":1},{"text":"ciniinsuudhaan wixxirfattee iyyitu sana,","poem":2},{"lineBreak":true},{"text":"yaa Waaqayyo, nus fuula kee duratti akkasuma taaneerra.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nu ulfoofnee, ciniinsuudhaan wixxirfanne;","poem":1},{"text":"nu garuu bubbee deenye.","poem":2},{"text":"Nu lafaaf fayyina hin fidne;","poem":1},{"text":"nu uummata addunyaa hin deenye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Garuu namoonni kee kanneen duʼan ni jiraatu;","poem":1},{"text":"dhagni isaaniis duʼaa ni kaʼa.","poem":2},{"text":"Isin warri biyyoo keessa jiraattan,","poem":1},{"text":"dammaqaatii gammachuudhaan ililchaa.","poem":2},{"text":"Fixeensi kee akkuma fixeensa ganamaa ti;","poem":1},{"text":"laftis warra duʼan of keessaa baafti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yaa saba ko, kutaa mana keetti ol galiitii","poem":1},{"text":"duubaan balbala ofitti cufi;","poem":2},{"text":"hamma dheekkamsi isaa darbutti,","poem":1},{"text":"yeroo muraasaaf of dhoksi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kunoo, Waaqayyo sababii cubbuu isaaniitiif","poem":1},{"text":"uummata lafa irraa adabuufiddoo jireenya isaatii baʼee dhufaa jira.","poem":2},{"text":"Lafti dhiiga ishee irratti dhangalaafame sana ifa baafti;","poem":1},{"text":"siʼachi warra ishee irratti qalaman hin dhoksitu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}