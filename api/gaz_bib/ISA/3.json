{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":3,"content":[{"type":"heading","content":["Murtii Yerusaalemii fi Yihuudaa Eeggatu"]},{"type":"verse","number":1,"content":[{"text":"Kunoo Gooftaan,","poem":1},{"text":"Waaqayyoon Waan Hunda Dandaʼu","poem":2},{"text":"Yerusaalemii fi Yihuudaa irraa","poem":1},{"text":"kennaa fi gargaarsa isaa","poem":2},{"text":"kan midhaaniitii fi kan bishaanii hunda irraa fudhata;","poem":1}]},{"type":"verse","number":2,"content":[{"text":"gootaa fi loltuu,","poem":2},{"text":"abbaa murtiitii fi raajii,","poem":1},{"text":"hooda himaa fi maanguddoo,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ajajaa shantamaatii fi nama ulfina qabu,","poem":1},{"text":"gorsituu, ogeessa hojii harkaatii fiogeessa waa dawweessuu beeku irraa fudhata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ani dargaggoota qondaaltota isaanii nan godha;","poem":1},{"text":"ijoolleen isaan bulchu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Namoonni wal hacuucu;","poem":1},{"text":"namni tokko nama kaanitti, ollaanis, ollaa isaatti kaʼa.","poem":2},{"text":"Dargaggeessi jaarsatti,","poem":1},{"text":"tuffatamaanis kabajamaatti kaʼa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Namni tokko mana abbaa isaatti,","poem":1},{"text":"obboloota isaa keessaa tokko qabee,","poem":2},{"text":"“Ati qoloo qabda; kanaafuu bulchaa nuuf taʼi;","poem":1},{"text":"tuullaa waan diigamee kanattis itti gaafatama fudhu!” jedha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni garuu gaafas,","poem":1},{"text":"“Ani furmaata taʼuu hin dandaʼu.","poem":2},{"text":"Ani nyaata yookaan uffata tokko illee mana kootii hin qabu;","poem":1},{"text":"bulchaa sabaa na hin taasisinaa” jedhee iyya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yerusaalem gatantaraa jirti;","poem":1},{"text":"Yihuudaan immoo kufteerti;","poem":2},{"text":"dubbii isaaniitii fi gochi isaanii Waaqayyoon mormuudhaan","poem":1},{"text":"ulfina argamuu isaa xureessa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Haalli fuula isaanii dhugaa isaanitti baʼa;","poem":1},{"text":"isaan akkuma Sodoom cubbuu isaanii ifa baasu;","poem":2},{"lineBreak":true},{"text":"isaan cubbuu isaanii hin dhokfatan.","poem":2},{"text":"Isaaniif wayyoo!","poem":1},{"text":"Isaan balaa guddaa ofitti fidaniiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Akka wanni kun isaaniif tolu qajeeltotatti himaa;","poem":1},{"text":"isaan buʼaa hojii isaanii nyaatu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hamaadhaaf wayyoo!","poem":1},{"text":"Badiisni isatti ni dhufa!","poem":2},{"text":"Inni gatii harka isaa ni argata.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dargaggoonni saba koo cunqursu;","poem":1},{"text":"dubartoonni isaan bulchu.","poem":2},{"text":"Yaa saba ko, qajeelchitoonni keessan karaa irraa isin jalʼisaniiru;","poem":1},{"text":"isaan irraa isin gorsaniiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Waaqayyo murtii kennuuf taaʼeera;","poem":1},{"text":"saba isaattis muruuf kaʼeera.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Waaqayyo akkana jedhee","poem":1},{"text":"maanguddootaa fi hooggantoota saba isaatti mura:","poem":2},{"text":"“Kan iddoo dhaabaa wayinii kootii balleesse isin;","poem":1},{"text":"wanni hiyyeeyyii irraa saamame mana keessan jira.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Isin saba koo caccabsuun keessan,","poem":1},{"text":"fuula hiyyeeyyiis butuchuun keessan maal gochuu keessan?” jedha Gooftaan,","poem":2},{"lineBreak":true},{"text":"Waaqayyoon Waan Hunda Dandaʼu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Waaqayyo akkana jedha;","poem":1},{"text":"“Dubartoonni Xiyoon of tuulu;","poem":2},{"text":"isaan morma dheereffatanii yaaʼu;","poem":1},{"text":"ijaanis ni waammatu;","poem":2},{"lineBreak":true},{"text":"faaya miilla isaanii kilillisaa cillaanfachaa deemu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kanaafuu Gooftaan mataa intallan Xiyoonitti qaaqee ni fida;","poem":1},{"text":"Waaqayyo gubbee mataa isaanii moleessa.”","poem":2}]},{"type":"verse","number":18,"content":["Gaafas Gooftaan faaya miidhagina isaanii: albuu, marata mataa, faaya mormaa kan baatii fakkaatu,"]},{"type":"verse","number":19,"content":["amartii gurraa, bitawoo, haguuggii fuulaa,"]},{"type":"verse","number":20,"content":["Marata mataa, faaya miillaa, sabbata, bilqaaxxii shittoo, kudhaama,"]},{"type":"verse","number":21,"content":["qubeelaa chaappaa, amartii funyaanii"]},{"type":"verse","number":22,"content":["wandaboo filatamaa, koofiyyaa, qoloo, korojoo harkaa,"]},{"type":"verse","number":23,"content":["of ilaaleewwan, wayyaa quncee talbaa irraa hojjetame, gonfoo dubartootaatii fi uffata mormaa isaan irraa mulqa."]},{"type":"verse","number":24,"content":[{"text":"Qooda urgaa, ajaa;","poem":1},{"text":"qooda sabbataa, funyoo;","poem":2},{"text":"qooda mataa sirriitti dhaʼamee, moluu;","poem":1},{"text":"qooda uffata miidhagaa, wayyaa gaddaa;","poem":2},{"lineBreak":true},{"text":"qooda miidhaginaa fokkisuutu dhufa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Namoonni keessan goraadeedhaan,","poem":1},{"text":"loltoonni keessanis lola keessatti dhumu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Karri Xiyoon faarsitee boossi;","poem":1},{"text":"isheen ontee lafa teessi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}