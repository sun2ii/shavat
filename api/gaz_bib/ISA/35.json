{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":35,"content":[{"type":"heading","content":["Gammachuu Warra Furamanii"]},{"type":"verse","number":1,"content":[{"text":"Gammoojjii fi lafti gogaan ni gammadu;","poem":1},{"text":"lafti onaan ni ililcha; ni daraaras.","poem":2},{"text":"Akka arfaasee,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"baayʼinaan daraara;","poem":1},{"text":"akka malee gammadees ililcha.","poem":2},{"text":"Ulfinni Libaanoon, surraan Qarmeloosii fi","poem":1},{"text":"Shaaroon ni kennamaaf;","poem":2},{"text":"isaan ulfina Waaqayyoo,","poem":1},{"text":"surraa Waaqa keenyaas ni argu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Harka dadhabe jajjabeessaa;","poem":1},{"text":"jilba laafes cimsaa;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"warra garaan isaanii sodaatuun akkana jedhaa:","poem":1},{"text":"“Jabaadhaa; hin sodaatinaa;","poem":2},{"text":"Waaqni keessan ni dhufa;","poem":1},{"text":"inni haaloo baasuuf dhufa;","poem":2},{"text":"gatii malu qabatee","poem":1},{"text":"isin oolchuuf ni dhufa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ergasii iji nama jaamaa ni banama;","poem":1},{"text":"gurri nama duudaas ni dhagaʼa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gaafas namni naafti akkuma gadamsaa utaala;","poem":1},{"text":"arrabni hidhamaanis gammachuudhaan faarfata.","poem":2},{"text":"Bishaan gammoojjii keessaa,","poem":1},{"text":"burqaanis gammoojjii keessaa cabsee baʼa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lafti nama gubu haroo,","poem":1},{"text":"lafti gogaan immoo burqaa bishaanii taʼa.","poem":2},{"text":"Boolla duraan waangoonni keessa ciisan irratti marga,","poem":1},{"text":"shambaqqoo fi dhallaadduutu biqila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Karaan guddaan tokko achi ni jiraata;","poem":1},{"text":"innis, Karaa Qulqullinaa jedhamee waamama;","poem":2},{"text":"inni warra Karaa sana irra deemaniif taʼa.","poem":1},{"text":"“Xuraaʼonni” isa irra hin deeman;","poem":2},{"lineBreak":true},{"text":"gowwoonni achiinuu hin baʼan.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Leenci achitti hin argamu;","poem":1},{"text":"yookaan bineensi hamaan achi irra hin baʼu;","poem":2},{"lineBreak":true},{"text":"isaan achitti hin argaman.","poem":2},{"text":"Garuu warra furaman qofatu achi irra deema;","poem":1}]},{"type":"verse","number":10,"content":[{"text":"warri Waaqayyo isaan fure ni deebiʼu.","poem":2},{"text":"Isaan faarfannaadhaan Xiyoon seenu;","poem":1},{"text":"gammachuun bara baraa mataa isaanii irra jiraata.","poem":2},{"text":"Isaan gammachuu fi ililleedhaan guutamu;","poem":1},{"text":"gaddii fi booʼichi isaan irraa fagaatu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}