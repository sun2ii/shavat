{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":40,"content":[{"type":"heading","content":["Sabni Waaqaa Jajjabeeffame"]},{"type":"verse","number":1,"content":[{"text":"Jajjabeessaa; saba koo jajjabeessaa;","poem":1},{"text":"jedha Waaqni keessan.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Garaa Yerusaalemitti dubbadhaa;","poem":1},{"text":"hojiin garbummaa ishee akka dhume,","poem":2},{"text":"gatiin cubbuu ishee akka baafameef,","poem":1},{"text":"isheen cubbuu ishee hundaaf","poem":2},{"text":"harka Waaqayyootii adabbii dachaa","poem":1},{"text":"akka fudhatte isheetti labsaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Sagalee akkana jedhee iyyu tokko:","poem":1},{"lineBreak":true},{"text":"“Gammoojjii keessatti","poem":1},{"text":"Waaqayyoof karaa qopheessaa;","poem":2},{"text":"gammoojjii keessatti Waaqa keenyaaf","poem":1},{"text":"karaa guddicha qajeelchaa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sululli hundi ni guutama;","poem":1},{"text":"tulluu fi gaarri hundinuus gad deebifama;","poem":2},{"text":"lafti wal caalu, wal qixxeeffama;","poem":1},{"text":"lafti buʼaa baʼiinis dirree taʼa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ulfinni Waaqayyoo ni mulʼata;","poem":1},{"text":"sanyiin namaa hundinuus tokkummaadhaan ni arga.","poem":2},{"text":"Afaan Waaqayyoo dubbateeraatii.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sagaleen tokko “Iyyi” jedha.","poem":1},{"text":"Anis, “Maal jedheen iyya?” nan jedhe.","poem":2},{"lineBreak":true},{"text":"“Namni hundi akkuma margaa ti;","poem":1},{"text":"ulfinni isaa hundis akkuma daraaraa dirree ti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sababii hafuurri Waaqayyo baafatu isaanitti bubbisuuf margi","poem":1},{"text":"ni coollaga; daraaraanis ni harcaʼa.","poem":2},{"lineBreak":true},{"text":"Dhugumaan namni marguma.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Margi ni coollaga; daraaraanis ni harcaʼa;","poem":1},{"text":"dubbiin Waaqa keenyaa garuu bara baraan ni jiraata.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ati kan Xiyooniif oduu gaarii fiddu,","poem":1},{"text":"tulluu dheeraatti ol baʼi.","poem":2},{"text":"Ati kan Yerusaalemiif oduu gaarii fiddu,","poem":1},{"text":"sagalee kee ol fudhuutii iyyi;","poem":2},{"text":"ol fudhadhuu iyyi; hin sodaatin;","poem":1},{"text":"magaalaawwan Yihuudaatiinis,","poem":2},{"lineBreak":true},{"text":"“Waaqni keessan kunoo ti!” jedhi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kunoo, Waaqayyo Gooftaan humnaan ni dhufa;","poem":1},{"text":"irreen isaa jabaadhaanis ni bulcha.","poem":2},{"text":"Kunoo, gatiin isaa isa wajjin jira;","poem":1},{"text":"gatiin inni namaaf kennu isuma harka jira.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inni akkuma tiksee tokkootti bushaayee isaa tikfata;","poem":1},{"text":"xobbaallaawwan hoolaas irree isaatiin walitti qaba;","poem":2},{"text":"ofitti qabees qoma isaatti hammata;","poem":1},{"text":"haadhota hoolotaa warra hoosisanis suutuma oofa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bishaanota konyee isaatiin kan safare","poem":1},{"text":"yookaan samiiwwan taakkuu isaatiin kan safare eenyu?","poem":2},{"text":"Biyyoo lafaa safartuudhaan walitti kan qabe","poem":1},{"text":"yookaan tulluuwwan madaaliidhaan","poem":2},{"lineBreak":true},{"text":"gaarran immoo madaaliidhaan kan madaale eenyu?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Eenyutu Hafuura Waaqayyoo qajeelchuu dandaʼe?","poem":1},{"text":"Yookaan namni gorsaa isaa taʼee isa barsiise eenyu?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Waaqayyo hubannaa argachuuf eenyun gorsa gaafate?","poem":1},{"text":"Daandii qajeelaas eenyutu isa barsiise?","poem":2},{"text":"Eenyutu beekumsa isaaf kennee","poem":1},{"text":"yookaan daandii hubannaa isa argisiise?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dhugumaan saboonni akkuma copha baaldii keessaa ti;","poem":1},{"text":"isaan akkuma awwaara madaalii irra jiruutti ilaalamu;","poem":2},{"lineBreak":true},{"text":"inni biyyoota bishaan gidduu illee akkuma biyyoo bullaaʼaatti madaala.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Libaanoon qoraan iddoo aarsaatiif gaʼu hin qabdu,","poem":1},{"text":"yookaan horiin ishee aarsaa gubamuuf hin gaʼan.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Fuula isaa duratti saboonni hundinuu wayittuu hin lakkaaʼaman;","poem":1},{"text":"isaan akka ilaalcha isaatti homaattuu hin hedaman;","poem":2},{"lineBreak":true},{"text":"gatiis hin qaban.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Yoos Waaqa eenyutti fakkeessitu?","poem":1},{"text":"Fakkii kam wajjin isa wal bira qabdu?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Waaqa tolfamaa tumtuu sibiilaatu baqsee tolcha;","poem":1},{"text":"tumtuun warqees warqee itti uffisa;","poem":2},{"lineBreak":true},{"text":"foncaa meetiitiinis ni miidhagsa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hiyyeessi aarsaa akkasii dhiʼeessuu","poem":1},{"text":"hin dandeenye tokko muka hin tortorre filata.","poem":2},{"text":"Waaqa tolfamaa hin jigne dhaabuufis","poem":1},{"text":"nama ogummaa hojii harkaa qabu barbaaddata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Isin hin beektanii?","poem":1},{"text":"Isin hin dhageenyee?","poem":2},{"text":"Wanni kun jalqabumaa kaasee isinitti hin himamnee?","poem":1},{"text":"Isin erga lafti hundeeffamtee jalqabee hin hubannee?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Inni geengoo lafaatii ol taaʼa;","poem":1},{"text":"uummanni lafaas akkuma korophisaa ti.","poem":2},{"text":"Inni samiiwwan akkuma golgaatti diriirsa;","poem":1},{"text":"akka dunkaana keessa jiraataniittis isaan diriirsa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Inni ilmaan moototaa faayidaa dhabsiisa;","poem":1},{"text":"bulchitoota addunyaas harka duwwaa hambisa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Akkuma isaan dhaabamaniin,","poem":1},{"text":"akkuma isaan facaafamaniin,","poem":2},{"lineBreak":true},{"text":"akkuma isaan lafa keessatti hidda yaafataniin,inni isaanitti bubbise;","poem":2},{"text":"isaanis ni coollagan;","poem":1},{"text":"obombolettiinis akkuma habaqiitti isaan haxaaʼe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Isin eenyutti na fakkeessitu?","poem":1},{"text":"Yookaan eenyutu anaan qixxaata?” jedha Qulqullichi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ija keessan ol fudhadhaatii samiiwwan ilaalaa:","poem":1},{"text":"Eenyutu kanneen hunda uume?","poem":2},{"text":"Isa tuuta urjiiwwanii tokko tokkoon fidee","poem":1},{"text":"tokkoo tokkoo isaanii maqaa maqaadhaan waamu sanaa dha.","poem":2},{"text":"Sababii humna isaa cimaa sanaatii fi jabina isaa guddaa sanaatiif","poem":1},{"text":"isaan keessaa tokko iyyuu hin dhabamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Yaa Yaaqoob, yaa Israaʼel, ati maaliif,","poem":1},{"text":"“Karaan koo Waaqayyo duraa dhokateera;","poem":2},{"text":"haajaan koos fuula Waaqa koo duratti","poem":1},{"text":"tuffatameera” jettee guungumta?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ati hin beektuu?","poem":1},{"text":"Ati hin dhageenyee?","poem":2},{"text":"Waaqayyo Waaqa bara baraa ti;","poem":1},{"text":"inni Uumaa handaara lafaa ti.","poem":2},{"text":"Inni hin dadhabu yookaan haara hin galfatu;","poem":1},{"text":"hubannaa isaas kan qoree bira gaʼu hin jiru.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Inni dadhabdootaaf jabina kenna;","poem":1},{"text":"nama laafaaf immoo humna dabala.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ijoolleen iyyuu ni dadhabu; ni bututus;","poem":1},{"text":"dargaggoonnis gufatanii kufu;","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Warri Waaqayyoon abdatan garuu","poem":1},{"text":"humna isaanii ni haaromfatu.","poem":2},{"text":"Isaan akkuma risaa qoochoodhaan barrisu;","poem":1},{"text":"ni fiigu; hin dadhaban;","poem":2},{"lineBreak":true},{"text":"ni deemu; hin bututan.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}