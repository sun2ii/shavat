{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":45,"content":[{"type":"verse","number":1,"content":[{"text":"“Waaqayyo dibamaa isaa Qiiros,","poem":1},{"text":"kan ani saboota isa jalatti bulchuu fi","poem":2},{"text":"hidhannaa moototaa hiiksisuuf jedhee","poem":1},{"text":"harka isaa mirgaa qabee","poem":2},{"text":"akka karrawwan hin cufamneef,","poem":1},{"text":"balbalawwan banuuf sanaan akkana jedha:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ani fuula kee dura deemee","poem":1},{"text":"tulluuwwan wal nan qixxeessa;","poem":2},{"text":"karrawwan naasii nan caccabsa;","poem":1},{"text":"danqaraawwan sibiilaas nan kukkuta.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ati akka ani Waaqayyo","poem":1},{"text":"Waaqa Israaʼel isa maqaa keetiin si waamu taʼe akka beektuuf,","poem":2},{"text":"ani badhaadhummaa dukkana keessaa,","poem":1},{"text":"qabeenya lafa dhoksaatti kuufames siif nan kenna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ati na beekuu baattu iyyuu,","poem":1},{"text":"ani garbicha koo Yaaqoobiif,","poem":2},{"text":"Israaʼel filatamaa kootiif jedhee","poem":1},{"text":"maqaa keetiin si waameera;","poem":2},{"lineBreak":true},{"text":"maqaa ulfinaas siif kenneera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ani Waaqayyo; ana malee kan biraa hin jiru;","poem":1},{"text":"ana malee Waaqni tokko iyyuu hin jiru.","poem":2},{"lineBreak":true},{"text":"Ati na beekuu baattu iyyuu, ani sin jabeessa;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kunis akka namoonni baʼa biiftuutii hamma lixa biiftuutti,","poem":1},{"text":"ana malee kan biraa akka hin jirre beekaniif.","poem":2},{"text":"Ani Waaqayyo; ana malee","poem":1},{"text":"tokko iyyuu hin jiru.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ani ifa nan tolcha; dukkanas nan uuma;","poem":1},{"text":"badhaadhummaa nan fida; balaas nan uuma;","poem":2},{"lineBreak":true},{"text":"ani Waaqayyo wantoota kanneen hunda nan godha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Yaa samiiwwan, isin ol gubbaadhaa qajeelummaa roobsaa;","poem":1},{"text":"duumessoonnis gad coccobsaa.","poem":2},{"text":"Lafti haa banamtu;","poem":1},{"text":"fayyinni haa biqilu;","poem":2},{"text":"qajeelummaanis isa wajjin haa guddatu;","poem":1},{"text":"ani Waaqayyo waan kana uumeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Qiraacii qiraaciidhuma lafaa taʼee","poem":1},{"text":"Uumaa isaatiin wal loluuf wayyoo.","poem":2},{"text":"Supheen, suphee dhooftuudhaan,","poem":1},{"text":"‘Ati maal hojjechaa jirta?’ jedhaa?","poem":2},{"text":"Hojiin ati hojjettus,","poem":1},{"text":"‘Inni harka hin qabu’ siin jedhaa?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nama Abbaadhaan, ‘Ati maal dhalchite?’","poem":1},{"text":"yookaan haadhaan, ‘Ati maal deesse?’ jedhuuf wayyoo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Waaqayyo, Qulqullichi Israaʼel","poem":1},{"text":"Uumaan ishee sun akkana jedha:","poem":2},{"text":"Isin waaʼee wantoota dhufuuf jiranii jechuunis,","poem":1},{"text":"‘Waaʼee ijoollee koo na gaafadhaa;","poem":2},{"lineBreak":true},{"text":"yookaan waaʼee hojii harka koo na ajajaa.’","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kan lafa tolchee namas ishee irratti uume ana.","poem":1},{"text":"Harki koo samiiwwan diriirseera;","poem":2},{"lineBreak":true},{"text":"raayyaa isaanii hundas ajajeera.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ani qajeelummaa kootiin Qiirosin ol nan kaasa:","poem":1},{"text":"Karaa isaa hundas wal nan qixxeessa.","poem":2},{"text":"Inni magaalaa koo deebisee ijaara;","poem":1},{"text":"boojiʼamtoota koos bilisa baasa;","poem":2},{"text":"garuu gatiidhaan yookaan badhaasaan miti,","poem":1},{"text":"jedha Waaqayyoon Waan Hunda Dandaʼu.”","poem":2}]},{"type":"verse","number":14,"content":["Waaqayyo akkana jedha:",{"text":"“Qabeenyi Gibxii fi daldalli Itoophiyaa,","poem":1},{"text":"namoonni dhedheeroon Saabaa,","poem":2},{"text":"gara kee ni dhufu;","poem":1},{"text":"kan kees ni taʼu;","poem":2},{"text":"isaan foncaadhaan hidhamanii","poem":1},{"text":"dugda duubaan si duukaa buʼu.","poem":2},{"text":"Fuula kee durattis gad jedhanii","poem":1},{"text":"‘Dhugumaan Waaqni si wajjin jira;isa malees tokko iyyuu hin jiru;","poem":2},{"text":"isa malees Waaqni biraa hin jiru’","poem":1},{"text":"jedhanii si kadhatu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Yaa Waaqi, Fayyisaa Israaʼel,","poem":1},{"text":"ati dhugumaan Waaqa of dhoksituu dha.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Warri waaqota tolfamoo tolchan hundinuu ni qaanaʼu; ni salphatu;","poem":1},{"text":"walii wajjinis salphina keessa buʼu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Israaʼel garuu fayyina bara baraatiin","poem":1},{"text":"Waaqayyo ni fayyifama;","poem":2},{"text":"isin bara baraan hin qaanoftan;","poem":1},{"text":"yookaan hin salphattan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Waaqayyo akkana jedha;","poem":1},{"lineBreak":true},{"text":"kan samiiwwan uume, inni Waaqa;","poem":1},{"text":"inni lafa miidhagsee tolchee ishee hundeesse;","poem":2},{"text":"inni akka isheen iddoo jireenyaa taatuuf ishee uume malee","poem":1},{"text":"akka isheen ona taatuuf ishee hin uumne;","poem":2},{"text":"inni akkana jedha;","poem":1},{"text":"“Ani Waaqayyo; ana malee kan biraa hin jiru.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ani biyya dukkanaa keessaa","poem":1},{"text":"dhoksaadhaan hin dubbanne;","poem":2},{"text":"ani sanyiiwwan Yaaqoobiin,","poem":1},{"text":"‘Akkasumaan na barbaadaa’ hin jenne.","poem":2},{"text":"Ani Waaqayyo dhugaa nan dubbadha;","poem":1},{"text":"waan qajeelaas nan labsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Walitti qabamaa kottaa;","poem":1},{"text":"isin baqattoonni sabootaa wal gaʼaa.","poem":2},{"text":"Warri waaqa tolfamaa muka irraa hojjetame baatan,","poem":1},{"text":"kanneen waaqota fayyisuu hin dandeenye kadhatanhomaa beekumsa hin qaban.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Waanan taʼuu qabu dubbadhaa; dhiʼeeffadhaas;","poem":1},{"text":"isaanis walii wajjin haa mariʼatan.","poem":2},{"text":"Eenyutu waan kana duraan dursee bara dheeraan dura hime?","poem":1},{"text":"Duruma iyyuu eenyutu labse?","poem":2},{"text":"Anuma Waaqayyo mitii?","poem":1},{"text":"Ana malee Waaqni qajeelaa fi","poem":2},{"text":"Fayyisaan tokko iyyuu hin jiru;","poem":1},{"text":"ana malee tokko illee hin jiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Isin warri handaara lafaa hundi,","poem":1},{"text":"gara kootti deebiʼaatii fayyaa;","poem":2},{"lineBreak":true},{"text":"ani Waaqa; ana malee kan biraa hin jiruutii.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ani mataa kootiin kakadheera;","poem":1},{"text":"afaan koos akkana jedhee qajeelummaadhaan","poem":2},{"lineBreak":true},{"text":"dubbii hin geeddaramne dubbateera;","poem":2},{"text":"‘Jilbi hundi fuula koo duratti ni jilbeenfata;","poem":1},{"text":"arrabni hundis anaan kakata.’","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Isaanis, ‘Qajeelummaa fi jabinni Waaqayyo qofaan argama’","poem":1},{"text":"jedhanii waaʼee koo ni dubbatu.”","poem":2},{"text":"Warri aariidhaan isatti kaʼan hundi,","poem":1},{"text":"gara isaa dhufanii ni qaanaʼu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Sanyiin Israaʼel hundi garuu,","poem":1},{"text":"Waaqayyoon qajeeltota taasifamu;","poem":2},{"lineBreak":true},{"text":"ni kabajamus.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}