{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":47,"content":[{"type":"heading","content":["Kufaatii Baabilon"]},{"type":"verse","number":1,"content":[{"text":"“Yaa intala Baabilon Durba Qulqullittii,","poem":1},{"text":"gad buʼi; awwaara irra taaʼi;","poem":2},{"text":"yaa Intala Baabilonotaa,","poem":1},{"text":"teessoo malee lafa taaʼi!","poem":2},{"text":"Ati siʼachi bareedduu","poem":1},{"text":"yookaan kichuu jedhamtee hin waamamtu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dhagaa daakuu fudhadhuutii midhaan daaki;","poem":1},{"text":"haguuggii kee of irraa fuudhi.","poem":2},{"text":"Wandaboo kee soqoladhu;","poem":1},{"text":"gudeeda kee mulʼisi; laga ceʼi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Qullaan kee ifatti ni baʼa;","poem":1},{"text":"qaaniin kees hin dhokatu.","poem":2},{"text":"Ani haaloo nan baʼa;","poem":1},{"text":"ani nama tokko iyyuu hin dhiisu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Furiin keenya maqaan isaa Waaqayyoo Waan Hunda Dandaʼuu dha;","poem":1},{"text":"inni Qulqullicha Israaʼel.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Yaa Intala Baabilonotaa,","poem":1},{"text":"calʼisii taaʼiitii dukkana seeni;","poem":2},{"text":"ati siʼachi","poem":1},{"text":"mootittii mootummootaa jedhamtee hin waamamtu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani saba kootti dheekkameera;","poem":1},{"text":"handhuuraa koos xureesseera;","poem":2},{"text":"ani dabarsee harka keetti isaan kenneera;","poem":1},{"text":"atis garaa hin laafneef.","poem":2},{"text":"Warra dullooman irra iyyuu","poem":1},{"text":"waanjoo ulfaataa keesse.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ati, ‘Ani bara baraan itti fufee","poem":1},{"text":"mootittii bara baraa nan taʼa!’ jette.","poem":2},{"text":"Ati garuu wantoota kana hin hubanne","poem":1},{"text":"yookaan dhumni isaanii maal akka taʼu hin yaadanne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Ammas yaa ishee qananiituu,","poem":1},{"text":"kan nagaan jiraattee","poem":2},{"text":"garaa kee keessattis,","poem":1},{"text":"‘Anuma; ana malee tokko iyyuu hin jiru;","poem":2},{"text":"ani siʼachi haadha hiyyeessaa","poem":1},{"text":"yookaan nama dhalee dhabe hin taʼu’ ofiin jettu dhagaʼi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wantoonni kunneen lamaan,","poem":1},{"text":"dhalanii dhabuu fi haadha hiyyeessaa taʼuun","poem":2},{"lineBreak":true},{"text":"akkuma tasaa guyyuma tokkotti sitti dhufu.","poem":2},{"text":"Isaan baayʼina falfala keetiitii fi","poem":1},{"text":"tolcha kee cimaa sanaa hunda irraan iyyuu","poem":2},{"lineBreak":true},{"text":"humna isaanii guutuudhaan sitti dhufu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ati hammina kee amanattee,","poem":1},{"text":"‘Namni tokko iyyuu na hin argu’ jette.","poem":2},{"text":"Yeroo ati garaa kee keessatti, ‘Ana;","poem":1},{"text":"ana malee namni biraa hin jiru’ jettutti,","poem":2},{"lineBreak":true},{"text":"ogummaa fi beekumsi kee si dogoggorsu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wanni hamaan sitti dhufa;","poem":1},{"text":"ati immoo eessaa akka inni dhufu hin beektu.","poem":2},{"text":"Balaan ati of irraa ittisuu hin dandeenye tokko sitti dhufa;","poem":1},{"text":"badiisni ati duraan dursitee hin beekin akkuma tasaa sitti dhufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Yoos ati tolcha keetii fi","poem":1},{"text":"falfala kee baayʼee ijoollummaa keetii jalqabdee","poem":2},{"lineBreak":true},{"text":"itti dadhabde sana jabeessii eegi.","poem":2},{"text":"Yoo akkas taʼe ati ni milkoofta;","poem":1},{"text":"yoo akkas taʼe nama ni sodaachifta taʼa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gorsi ati argatte hundi dadhabbii qofa sitti fide!","poem":1},{"text":"Urjii lakkooftonni kee","poem":2},{"text":"warri jiʼa jiʼaan urjii ilaalanii raajan sun,","poem":1},{"text":"mee waan sitti dhufu duraa si haa baasan kaa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dhugumaan isaan akkuma cidii ti;","poem":1},{"text":"ibiddi isaan guba.","poem":2},{"text":"Isaan mataa isaanii iyyuu,","poem":1},{"text":"humna arraba ibiddaa jalaa baasuu hin dandaʼan.","poem":2},{"text":"Barbadaan ibiddaa kan namni hoʼifatutokko iyyuu hin jiru;","poem":1},{"text":"ibiddi bira taaʼanis hin argamu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wanni warri ati wajjin dadhabdee","poem":1},{"text":"ijoollummaa keetii jalqabdee wajjin daldalte sun","poem":2},{"lineBreak":true},{"text":"siif gochuu dandaʼan kanuma.","poem":2},{"text":"Tokkoon tokkoon isaanii dogoggora isaanii itti fufan;","poem":1},{"text":"kan si baasuu dandaʼu tokko iyyuu hin jiru.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}