{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":49,"content":[{"type":"heading","content":["Tajaajilaa Waaqayyoo"]},{"type":"verse","number":1,"content":[{"text":"Yaa biyyoota bishaan gidduu na dhaggeeffadhaa;","poem":1},{"text":"yaa saboota fagoo jiraattan waan kana dhagaʼaa:","poem":2},{"text":"Utuu ani hin dhalatin dura Waaqayyo na waame;","poem":1},{"text":"utuu ani gadameessa haadha koo keessa jiruu maqaa naa baase.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inni afaan koo akka goraadee qaramee godhe;","poem":1},{"text":"gaaddidduu harka isaatiin na dhokse;","poem":2},{"text":"xiyya cululuqfame na godhee,","poem":1},{"text":"manʼee xiyya isaa keessa na kaaʼate.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Innis, “Yaa Israaʼel, ati garbicha koo","poem":1},{"text":"kan ani ulfina koo isa irratti mulʼisuu dha” anaan jedhe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ani garuu, “Akkasumaanan itti dadhabe;","poem":1},{"text":"humna koos waanuma faayidaa hin qabnettan fixe.","poem":2},{"text":"Taʼus dhugaan koo harka Waaqayyoo,","poem":1},{"text":"gatiin koos Waaqa bira jira” nan jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Waan ani fuula Waaqayyoo duratti ulfina argadhee","poem":1},{"text":"Waaqni koo jabina naa taʼeef,","poem":2},{"text":"Waaqayyo inni akka ani Yaaqoobin deebisee gara isaatti fiduuf,","poem":1},{"text":"Israaʼelin isa biratti walitti qabuuf,","poem":2},{"text":"akka ani garbicha isaa taʼuuf","poem":1},{"text":"gadameessa keessatti na tolche sun akkana jedha;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Innis, “Ati gosoota Yaaqoob deebiftee dhaabuuf,","poem":1},{"text":"Israaʼeloota ani eege sanas deebiftee fiduuf","poem":2},{"lineBreak":true},{"text":"garbicha koo taʼuun kee siif baayʼee salphaa dha.","poem":2},{"text":"Akka fayyinni koo qarqara lafaa gaʼuuf","poem":1},{"text":"ani Namoota Ormaatiif ibsaa sin taasisa” jedha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Waaqayyo Furii fi Qulqullichi Israaʼel,","poem":1},{"text":"isa namaan tuffatamee sabnis jibbe,","poem":2},{"lineBreak":true},{"text":"tajaajilaa bulchitootaa sanaan akkana jedha:","poem":2},{"text":"“Sababii Waaqayyo amanamaa","poem":1},{"text":"Qulqullicha Israaʼel isa si filate sanaatiif","poem":2},{"text":"jedhanii mootonni si arganii ol kaʼu;","poem":1},{"text":"ilmaan moototaas arganii sagadu.”","poem":2}]},{"type":"heading","content":["Deebifamtee Ijaaramuu Israaʼel"]},{"type":"verse","number":8,"content":["Waaqayyo akkana jedha:",{"text":"“Ani yeroo fudhatama qabutti siifin deebisa;","poem":1},{"text":"gaafa fayyinaattis sin gargaara;","poem":2},{"text":"akka ati dhaala abbaa hin qabne","poem":1},{"text":"deebiftee dhaalchiftuuf,","poem":2},{"text":"ani sin eega;","poem":1},{"text":"akka ati sabaaf kakuu taatus sin godha;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"akka ati warra boojiʼamaniin, ‘Kottaa baʼaa’","poem":1},{"text":"warra dukkana keessa jiraataniin immoo, ‘Bilisa baʼaa’ jettu sin godha.","poem":2},{"lineBreak":true},{"text":"“Isaan karaa irratti waa nyaatu;","poem":1},{"text":"gaara qulqullaaʼaa irrattis iddoo qubataa argatu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Isaan hin beelaʼan; hin dheebotanis;","poem":1},{"text":"hoʼi gammoojjii yookaan aduun isaan hin gubu.","poem":2},{"text":"Inni isaaniif garaa laafu isaan geggeessa;","poem":1},{"text":"qarqara burqaa bishaanii irra isaan qajeelcha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tulluuwwan koo hunda karaatti nan geeddara;","poem":1},{"text":"daandiiwwan koo gurguddaanis wal qixxeeffamu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kunoo, isaan biyya fagoodhaa ni dhufu;","poem":1},{"text":"gariin kaabaa, gariin dhiʼaa,","poem":2},{"lineBreak":true},{"text":"kaan immoo biyya Aswaaniitii ni dhufu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yaa samiiwwan, ililchaa;","poem":1},{"text":"yaa lafa gammadi;","poem":2},{"lineBreak":true},{"text":"yaa tulluuwwan, guddisaa faarfadhaa!","poem":2},{"text":"Waaqayyo saba isaa ni jajjabeessa;","poem":1},{"text":"warra rakkataniifis garaa ni laafaatii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Xiyoon garuu, “Waaqayyo na gateera;","poem":1},{"text":"Gooftaanis na irraanfateera” jette.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Haati daaʼima ishee kan hoosiftu","poem":1},{"text":"irraanfachuu ni dandeessii?","poem":2},{"text":"Mucaa deesseefis garaa hin laaftuu?","poem":1},{"text":"Yoo isheen irraanfatte iyyuu ani si hin irraanfadhu!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kunoo, ani barruu harka koo irratti si qirixeera;","poem":1},{"text":"dallaawwan kee yeroo hunda fuula koo dura jiru.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ilmaan kee ariitiidhaan ni dachaʼu;","poem":1},{"text":"warri si diiganis sirraa baqatu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ija kee ol fudhadhuutii naannoo kee ilaali;","poem":1},{"text":"ilmaan kee hundi walitti qabamanii gara kee ni dhufu.","poem":2},{"text":"Ani jiraataadhaatii” jedha Waaqayyo.","poem":1},{"text":"“Ati isaan kanneen hunda akka faayaatti ni uffatta;","poem":2},{"lineBreak":true},{"text":"akka misirroottis ittiin miidhagfamta.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Ati diigamtee ontee","poem":1},{"text":"biyyi kee barbadaaʼu iyyuu","poem":2},{"text":"amma saba keetti lafti ni dhiphata;","poem":1},{"text":"warri si liqimsan sirraa ni fagaatu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ijoolleen ati yeroo gadda keetiitti deesse,","poem":1},{"text":"utuma gurri kee dhagaʼuu,","poem":2},{"text":"‘Lafti kun nutti dhiphateera;","poem":1},{"text":"lafa irra jiraannu nuuf kenni’ siin jedhu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ergasii ati garaa keetti akkana jetta;","poem":1},{"text":"‘Eenyutu jara kanneen naa daʼe?","poem":2},{"text":"Ani gaddituu fi maseentuun ture;","poem":1},{"text":"ani baqattuu fi jibbamtuun ture.","poem":2},{"lineBreak":true},{"text":"Isaan kanneen eenyutu guddise?","poem":2},{"text":"Ani kophaatti hafeen ture;","poem":1},{"text":"yoos, isaan kunneen eessaa dhufan ree?’ ”","poem":2}]},{"type":"verse","number":22,"content":["Waaqayyo Gooftaan akkana jedha:",{"text":"“Kunoo ani namoota ormaa harkaan nan waama;","poem":1},{"text":"faajjii koos uummataaf ol nan qaba;","poem":2},{"text":"isaan ilmaan kee hammatanii fidu;","poem":1},{"text":"intallan kee immoo gatiittii isaaniitti baatu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mootonni abbootii kee kanneen si guddisan,","poem":1},{"text":"niitonni isaanii immoo haadhota kee kanneen harma si hoosisan ni taʼu.","poem":2},{"text":"Isaan adda isaaniitiin lafatti gombifamanii siif sagadu;","poem":1},{"text":"awwaara miilla keetii illee ni arraabu.","poem":2},{"text":"Ergasii ati akka ani Waaqayyo taʼe ni beekta;","poem":1},{"text":"warri na abdatan hin salphatan.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Gootota harkaa boojuu fudhachuun,","poem":1},{"text":"gara jabeeyyii harkaas boojuu baasuun ni dandaʼamaa?","poem":2}]},{"type":"verse","number":25,"content":["Waaqayyo garuu akkana jedha:",{"text":"“Eeyyee, gootota harkaa boojiʼamtoonni ni baafamu;","poem":1},{"text":"gara jabeeyyii harkaas boojuun ni fudhatama;","poem":2},{"text":"warra siin falmaniin nan falma;","poem":1},{"text":"ijoollee kees nan baraara.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ani akka warri si hacuucan foon ofii isaanii nyaatan nan godha;","poem":1},{"text":"isaan akkuma nama daadhii wayiniitiin machaaʼuudhiiga ofii isaaniitiin ni machaaʼu.","poem":2},{"text":"Ergasii sanyiin namaa hundi,","poem":1},{"text":"akka ani Waaqayyo, Fayyisaan kee,","poem":2},{"lineBreak":true},{"text":"Furiin kee, Jabaa Yaaqoob taʼe ni beeka.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/48.json","previousChapterAudioLinks":{},"numberOfVerses":26}