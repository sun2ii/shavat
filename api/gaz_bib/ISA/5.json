{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":5,"content":[{"type":"heading","content":["Faarfannaa Iddoo Dhaaba Wayinii"]},{"type":"verse","number":1,"content":[{"text":"Ani naman jaalladhu sanaaf,","poem":1},{"text":"faarfannaa waaʼee iddoo dhaabaa wayinii isaa nan faarfadha:","poem":2},{"text":"Michuun koo gaara gabbataa irraa","poem":1},{"text":"iddoo dhaabaa wayinii qaba.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Innis lafa sana qotee isa irraa dhagaa balleessee","poem":1},{"text":"wayinii filatamaa isa irra dhaabe.","poem":2},{"text":"Qooxii eegumsaa isa keessatti ijaaree","poem":1},{"text":"boolla wayinii itti cuunfan illee qote.","poem":2},{"text":"Ergasii akka lafti qotiisaa sun ija gaarii kennu eeggate;","poem":1},{"text":"inni garuu ija hamaa qofa kenne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Yaa jiraattota Yerusaalemii fi saba Yihuudaa,","poem":1},{"text":"mee dubbii anaa fi iddoo dhaabaa wayinii koogidduu jiruuf murtii kennaa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Waan ani godheef kana caalaa","poem":1},{"text":"wanni iddoo dhaabaa wayinii kootiif godhamuu malu maali?","poem":2},{"text":"Yeroo ani ija wayinii gaarii barbaadetti","poem":1},{"text":"inni maaliif ija hadhaaʼaa qofa naqate?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ani amma waanan iddoo dhaabaa wayinii koo gochuuf jiru","poem":1},{"text":"isinitti nan hima;","poem":2},{"text":"ani dallaa isaa nan diiga;","poem":1},{"text":"innis ni bada;","poem":2},{"text":"dallaa isaa dhagaa nan jigsa;","poem":1},{"text":"innis gad dhidhiitama.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani isa nan onsa;","poem":1},{"text":"mukni wayinii isaas hin qoramu yookaan lafti isaa hin qotamu.","poem":2},{"text":"Sokorruu fi qoraattiin achi keessatti guddata.","poem":1},{"text":"Ani akka bokkaan itti hin roobneef duumessa nan ajaja.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Iddoon dhaabaa wayinii","poem":1},{"text":"Waaqayyoo Waan Hunda Dandaʼuu mana Israaʼel;","poem":2},{"text":"namoonni Yihuudaa immoo","poem":1},{"text":"iddoo biqiltuu inni itti gammaduu dha.","poem":2},{"text":"Inni murtii qajeelaa barbaade;","poem":1},{"text":"garuu dhiiga dhangalaafamu arge;","poem":2},{"text":"qajeelummaa barbaade;","poem":1},{"text":"garuu iyya warra miidhamee dhagaʼe.","poem":2}]},{"type":"heading","content":["Wayyoo fi Murtii"]},{"type":"verse","number":8,"content":[{"text":"Isin warra hamma iddoon","poem":1},{"text":"tokko iyyuu hin hafnetti mana irratti mana,","poem":2},{"text":"lafa qotiisaa irratti lafa qotiisaa dabalattanii","poem":1},{"text":"kophuma keessan biyya keessa jiraattaniif wayyoo!","poem":2}]},{"type":"verse","number":9,"content":["Waaqayyoon Waan Hunda Dandaʼu utumaa ani dhagaʼuu akkana jedhee dubbate:",{"text":"“Dhugumaan manneen hedduun ni onu;","poem":1},{"text":"manneen gurguddaanii fi babbareedoon nama keessa jiraatu dhabu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iddoo dhaabaa wayinii cimdii kudhan irraa daadhii wayiniibaadoosii tokko qofatu galfama;","poem":1},{"text":"sanyii qoroosii tokkoo irraa midhaan iifii tokkoo qofatu galfama.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Warra dhugaatii barbaachaaf ganamaan kaʼan,","poem":1},{"text":"kanneen hamma daadhii wayiniitiin machaaʼanitti","poem":2},{"lineBreak":true},{"text":"halkan dheereffataniif wayyoo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Isaan cidha isaanii irratti baganaa, kiraaraa fi dibbee,","poem":1},{"text":"ulullee fi daadhii wayinii qabu;","poem":2},{"text":"garuu hojii Waaqayyootiif dhimma hin qaban;","poem":1},{"text":"hojii harka isaatiifis ulfina hin kennan.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kanaafuu sabni koo","poem":1},{"text":"sababii hubannaa dhabeef boojiʼama;","poem":2},{"text":"namoonni isaanii bebbeekamoon beelaan,","poem":1},{"text":"uummanni isaaniis dheebuudhaan dhumu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kanaafuu Siiʼool garaa isaa balʼifatee","poem":1},{"text":"afaan ofii isaa illee hamma malee banata;","poem":2},{"text":"namoonni isaanii bebbeekamoonii fi uummanni isaanii","poem":1},{"text":"warri wacanii fi warri gammadan hundis achi keessa buʼu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kanaafuu namni gad qabama;","poem":1},{"text":"ilmaan namaa gad deebifamu;","poem":2},{"lineBreak":true},{"text":"iji of tuultotaas lafa ilaala.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Waaqayyoon Waan Hunda Dandaʼu garuu","poem":1},{"text":"murtii qajeelaa ofii isaatiin ol ol jedha;","poem":2},{"text":"Waaqni qulqulluun qajeelummaa ofii isaatiin","poem":1},{"text":"akka qulqulluu taʼe of argisiisa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yeroo sanatti hoolonni akkuma waanlafa dheeda isaanii keessa jiraniitti ni dheedu;","poem":1},{"text":"xobbaallaawwan hoolaas iddoo sooreyyiin itti barbadaaʼan keessa dheedu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Warra funyoo gowwoomsaatiin cubbuu,","poem":1},{"text":"funyoo gaariitiinis hammina harkisan,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"kanneen, “Waaqni haa ariifatu;","poem":1},{"text":"akka nu arginuuf inni hojii ofii isaa haa saffisiisu,","poem":2},{"text":"wanni kun haa dhiʼaatu;","poem":1},{"text":"akka nu beeknuufis","poem":2},{"lineBreak":true},{"text":"karoorri Qulqullicha Israaʼel haa dhufu”jedhaniif wayyoo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Warra hamaadhaan gaarii,","poem":1},{"text":"gaariidhaan immoo hamaa jedhaniif,","poem":2},{"text":"kanneen ifaan dukkana,","poem":1},{"text":"dukkanaan immoo ifa jedhaniif,","poem":2},{"text":"warra miʼaawaadhaan hadhaaʼaa,","poem":1},{"text":"hadhaaʼaadhaan immoo miʼaawaa jedhaniif wayyoo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Warra akka yaada isaaniitti ogeeyyii,","poem":1},{"text":"akka ilaalcha isaaniitti immoo abshaala of seʼaniif wayyoo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Warra daadhii wayinii dhuguutti jabaa,","poem":1},{"text":"dhugaatii walitti makuuttis goota taʼaniif,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"warra mattaʼaa fudhatanii yakkamaa gad lakkisaniif,","poem":1},{"text":"murtii nama balleessaa hin qabnee immoo jalʼisaniif wayyoo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kanaafuu akkuma arrabni ibiddaa cidii lafa irraa arraabu,","poem":1},{"text":"akkuma okaan ibiddaan gubatee badu sana hiddi isaanii ni tortora;","poem":2},{"lineBreak":true},{"text":"daraaraan isaaniis akkuma awwaaraa bittinnaaʼee bada;","poem":2},{"text":"isaan seera Waaqayyoo Waan Hunda Dandaʼuu didanii","poem":1},{"text":"dubbii Qulqullicha Israaʼel tuffataniiruutii.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kanaafuu dheekkamsi Waaqayyoo saba isaatti ni bobaʼa;","poem":1},{"text":"harki isaa ol kaʼee isaan rukuta.","poem":2},{"text":"Tulluuwwan ni raafamu;","poem":1},{"text":"reeffi isaaniis akkuma kosii daandii irratti gatamee taʼa.","poem":2},{"lineBreak":true},{"text":"Kana hundaan illee dheekkamsi isaa hin qabbanoofne;","poem":1},{"text":"harki isaas akkuma ol kaafametti jira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Inni saboota fagoo jiraniif faajjii ol qaba;","poem":1},{"text":"warra moggaa lafaa jiranitti ni siiqsa.","poem":2},{"lineBreak":true},{"text":"Isaanis kunoo ariifatanii dafanii dhufu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Isaan keessaa namni tokko iyyuu hin dadhabu yookaan hin gufatu;","poem":1},{"text":"namni tokko iyyuu hin mugu yookaan hin rafu;","poem":2},{"text":"sabbanni mudhii isaanii hin laafu;","poem":1},{"text":"hidhaan kophee isaaniis hin citu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Xiyyi isaanii qaramaa dha;","poem":1},{"text":"iddaan isaanii hundi qopheeffameera;","poem":2},{"text":"kotteen fardeen isaanii akkuma dhagaa qara qabuu ti;","poem":1},{"text":"gommaan gaarii isaaniis akkuma bubbee hamaa ti.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Aaduun isaanii akkuma aaduu leencaa ti;","poem":1},{"text":"isaan akkuma saafela leencaa aadu;","poem":2},{"text":"yeroo waan adamsatan qabatanitti ni gururiʼu;","poem":1},{"text":"isaan waan qabatan fudhatanii deemu;","poem":2},{"lineBreak":true},{"text":"namni isaan harkaa buusuu dandaʼus hin jiru.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Gaafas isaan akkuma huursaa galaanaa","poem":1},{"text":"waan sana irraa huursu.","poem":2},{"text":"Namni tokko yoo biyya sana ilaale,","poem":1},{"text":"inni dukkanaa fi rakkina arga;","poem":2},{"lineBreak":true},{"text":"aduunis duumessaan dukkaneeffama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/4.json","previousChapterAudioLinks":{},"numberOfVerses":30}