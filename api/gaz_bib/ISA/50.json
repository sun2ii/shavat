{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":50,"content":[{"type":"heading","content":["Cubbuu Israaʼelii fi Ajajamuu Tajaajiltichaa"]},{"type":"verse","number":1,"content":["Waaqayyo akkana jedha:",{"text":"“Waraqaan ragaa, kan ani ittiin haadha keessan hiikee","poem":1},{"text":"of irraa ittiin ishee geggeesse meerre?","poem":2},{"text":"Yookaan namni liqii narraa qabu","poem":1},{"text":"kan ani itti isin gurgure eenyu?","poem":2},{"text":"Isin sababii cubbuu keessaniif gurguramtaniirtu;","poem":1},{"text":"sababii yakka keessaniitiifis haati keessan ariʼamteerti.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yeroo ani dhufetti namni maaliif achi hin jiraatin?","poem":1},{"text":"Yeroo ani waametti namni owwaatu maaliif achii dhabame?","poem":2},{"text":"Harki koo akka furuu hin dandeenyeef gabaabateeraa?","poem":1},{"text":"Ani isin baraaruuf humna dhabeeraa?","poem":2},{"text":"Ani dheekkamsa qofaan galaana nan gogsa;","poem":1},{"text":"lageenis gammoojjiitti nan geeddara;","poem":2},{"text":"qurxummiiwwan isaanii bishaan dhabanii ajaaʼu;","poem":1},{"text":"dheebuudhaanis ni dhumu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ani samiitti dukkana nan uffisa;","poem":1},{"text":"wayyaa gaddaas itti nan haguuga.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Akka ani warra dadhaban jajjabeessuuf,","poem":1},{"text":"Waaqayyo Gooftaan arraba barate naa kenneera.","poem":2},{"text":"Inni ganama ganama na dammaqsa;","poem":1},{"text":"akka inni akkuma barataa tokkootti dhaggeeffatuufisgurra koo dammaqsa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Waaqayyo Gooftaan gurra koo naa baneera;","poem":1},{"text":"anis fincilaa hin turre;","poem":2},{"lineBreak":true},{"text":"ani dugda duubatti hin deebine.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani warra na rukutanitti dugda koo,","poem":1},{"text":"warra areeda narraa buqqisanitti immoo maddii koo nan kenne;","poem":2},{"text":"yeroo isaan natti qoosanii hancufa natti tufanitti,","poem":1},{"text":"ani fuula koo isaan hin dhokfanne.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sababii Waaqayyo Gooftaan na gargaaruuf,","poem":1},{"text":"ani hin salphifamu.","poem":2},{"text":"Kanaafuu ani fuula koo akkuma dhagaa gurraachaa godhadheera;","poem":1},{"text":"ani akka hin qaaneffamne illee nan beeka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inni dhugaa naaf baasu dhiʼoo jira.","poem":1},{"text":"Yoos eenyutu na himata ree?","poem":2},{"lineBreak":true},{"text":"Mee walitti gad haa baanu!","poem":2},{"text":"Himataan koo eenyu?","poem":1},{"text":"Inni mee natti gad haa baʼu!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Waaqayyo Gooftaatu na gargaara.","poem":1},{"text":"Eenyutu natti mura?","poem":2},{"text":"Isaan hundi akkuma wayyaa moofaʼu;","poem":1},{"text":"dholdholeenis isaan nyaatti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Isin keessaa kan Waaqayyoon sodaatee","poem":1},{"text":"dubbii garbicha isaatiif ajajamu eenyu?","poem":2},{"text":"Namni dukkana keessa deddeebiʼu,","poem":1},{"text":"kan ifa hin qabne,","poem":2},{"text":"maqaa Waaqayyoo amanatee","poem":1},{"text":"Waaqa isaatti haa irkatu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amma garuu isin warri ibidda bobeessitanii","poem":1},{"text":"guca bobaʼaa deemu qabattan hundinuu","poem":2},{"text":"ifa ibiddaa keessaniitii fi ifa guca","poem":1},{"text":"bobeessitanii keessa deemaa.","poem":2},{"text":"Wanni isin harka koo irraa argattan kanaa dha;","poem":1},{"text":"isin dhiphinaan ni ciciiftu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":11}