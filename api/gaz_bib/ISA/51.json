{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":51,"content":[{"type":"heading","content":["Fayyina Bara baraa Xiyooniif"]},{"type":"verse","number":1,"content":[{"text":"“Isin warri qajeelummaa duukaa buutan,","poem":1},{"text":"warri Waaqayyoon barbaaddan na dhaggeeffadhaa:","poem":2},{"text":"Isin kattaa irraa argamtan,","poem":1},{"text":"boolla keessaa baafamtan sana ilaalaa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abbaa keessan Abrahaamii fi","poem":1},{"text":"Saaraa ishee isin deesse sana ilaalaa.","poem":2},{"text":"Yeroo ani isa waametti, inni tokkicha ture;","poem":1},{"text":"ani isa nan eebbise; nan baayʼises.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Waaqayyo dhugumaan Xiyoonin ni jajjabeessa;","poem":1},{"text":"diigama ishee hundas gara laafinaan ni ilaala;","poem":2},{"text":"inni gammoojjii ishee goggogaa akka Eeden,","poem":1},{"text":"lafa onaa ishees akka iddoo biqiltuu Waaqayyoo ni godha.","poem":2},{"text":"Ililchuu fi gammaduun,","poem":1},{"text":"galannii fi sagaleen faarfannaa ishee keessatti argama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Yaa uummata koo na dhaggeeffadhaa;","poem":1},{"text":"yaa saba koo na dhagaʼaa;","poem":2},{"text":"seerri na biraa baʼa;","poem":1},{"text":"murtiin koos sabootaaf ifa taʼa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Qajeelummaan koo dafee dhiʼaata;","poem":1},{"text":"fayyisuun koos dhufaa jira;","poem":2},{"lineBreak":true},{"text":"irreen koo moototaaf murtii qajeelaa fida;","poem":2},{"text":"biyyoonni bishaan gidduu na eeggatu;","poem":1},{"text":"irree koos ni abdatu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ija keessan gara samiiwwaniitti ol qabadhaa;","poem":1},{"text":"lafas gad ilaalaa;","poem":2},{"text":"samiiwwan akkuma aaraa ni badu;","poem":1},{"text":"lafti akkuma wayyaa moofofti.","poem":2},{"lineBreak":true},{"text":"Jiraattonni ishees akkuma tisiisaa ni duʼan.","poem":2},{"text":"Fayyisuun koo garuu bara baraan jiraata;","poem":1},{"text":"qajeelummaan koos hin badu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Isin warri waan qajeelaa beektan","poem":1},{"text":"namoonni seera koo garaa keessaa qabdan na dhagaʼaa;","poem":2},{"text":"tuffii namootaa hin sodaatinaa;","poem":1},{"text":"yookaan arrabsoo isaaniitiin hin raafaminaa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Biliin akka wayyaatti isaan nyaatti;","poem":1},{"text":"raammoonis akkuma rifeensa hoolaatti isaan fixxi.","poem":2},{"text":"Garuu qajeelummaan koo bara baraan,","poem":1},{"text":"fayyisuun koos dhalootaa gara dhalootaatti itti fufa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yaa irree Waaqayyoo, kaʼi; kaʼi! Jabina uffadhu;","poem":1},{"text":"akkuma baroota darbanii,","poem":2},{"lineBreak":true},{"text":"akkuma dhaloota durii keessatti taʼe sana kaʼi.","poem":2},{"text":"Kan Raʼaabin kukkute,","poem":1},{"text":"kan jawwee galaanaa waraane sun suma mitii?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Inni akka warri furaman ceʼaniif, galaanicha,","poem":1},{"text":"bishaan tuujuba guddichaa gogse,","poem":2},{"lineBreak":true},{"text":"kan dhidhima galaanaa keessaan karaa baase suma mitii?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Warri Waaqayyo isaan fure ni deebiʼu.","poem":1},{"text":"Isaan faarfannaadhaan Xiyoon seenu;","poem":2},{"lineBreak":true},{"text":"gammachuun bara baraa mataa isaanii irra jiraata.","poem":2},{"text":"Isaan gammachuu fi ililleedhaan guutamu;","poem":1},{"text":"gaddii fi booʼichi isaan irraa fagaatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Kan isin jajjabeessu ana; anuma.","poem":1},{"text":"Yoos maaliif namoota duʼa hin oolle,","poem":2},{"lineBreak":true},{"text":"ilmaan namaa kanneen akkuma margaa taʼan sodaattu ree?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ati kan Waaqayyo Tolchaa kee,","poem":1},{"text":"isa samiiwwan diriirsee","poem":2},{"lineBreak":true},{"text":"hundee lafaa buuse sana dagattu eenyu?","poem":2},{"text":"Ati kan sababii dheekkamsa cunqursaa","poem":1},{"text":"waa balleessuuf qophaaʼe sanaatiif","poem":2},{"lineBreak":true},{"text":"utuu gargar hin kutin guyyaa guyyaan sodaattu eenyu?","poem":2},{"text":"Yoos dheekkamsi cunqursaa sanaa meerree?","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Boojiʼamtoonni hidhaman ariitiidhaan gad dhiifamu;","poem":2},{"text":"isaan boolla itti hidhaman keessatti hin duʼan","poem":1},{"text":"yookaan buddeena hin dhaban.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ani Waaqayyo Waaqa kee,","poem":1},{"text":"kan akka dhaʼaan bishaanii huursuuf galaana raasuu dha;","poem":2},{"lineBreak":true},{"text":"maqaan isaas Waaqayyoo Waan Hunda Dandaʼuu dha.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ani kan samiiwwan iddoo isaanii kaaʼe,","poem":1},{"text":"kan hundee lafaa hundeessee","poem":2},{"text":"Xiyooniin, ‘Ati saba koo ti’ jedhe sun,","poem":1},{"text":"dubbii koo afaan kee keessa kaaʼeera;","poem":2},{"lineBreak":true},{"text":"gaaddidduu harka kootiinis si haguugeera.”","poem":2}]},{"type":"heading","content":["Xoofoo Dheekkamsa Waaqayyoo"]},{"type":"verse","number":17,"content":[{"text":"Yaa Yerusaalem, ati kan harka Waaqayyoo irraa,","poem":1},{"text":"xoofoo dheekkamsa isaa keessaa dhugde,","poem":2},{"lineBreak":true},{"text":"ati kan xoofoo dhugaatii nama gatantarsuu keessaa","poem":2},{"text":"siicoo isaa xuruurfattee dhugde,","poem":1},{"text":"dammaqi, dammaqi! Ol kaʼi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ilmaan isheen deesse hunda keessaa,","poem":1},{"text":"kan ishee qajeelchu tokko iyyuu hin turre;","poem":2},{"text":"ilmaan isheen guddifte hunda keessaas,","poem":1},{"text":"kan harka ishee qabu tokko iyyuu hin turre.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Balaawwan kunneen dachaadhaan sitti dhufaniiru;","poem":1},{"text":"egaa eenyutu si jajjabeessuu dandaʼa?","poem":2},{"text":"Diigamnii fi badiisni, beellii fi goraadeen sitti dhufaniiru;","poem":1},{"text":"eegaa eenyutu si jajjabeessuu dandaʼa?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ijoolleen kee gaggabaniiru;","poem":1},{"text":"akkuma borofa kiyyoon qabame tokkoo,","poem":2},{"lineBreak":true},{"text":"roga karaa irra ciciisu.","poem":2},{"text":"Isaan dheekkamsa Waaqayyootiin,","poem":1},{"text":"ifata Waaqa keetiinis guutamaniiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kanaafuu yaa ishee miidhamte,","poem":1},{"text":"kan utuu daadhii wayinii hin dhugin machoofte,waan kana dhagaʼi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Waaqayyo Gooftaan kee,","poem":1},{"text":"Waaqni kee inni saba isaa eegu akkana jedha:","poem":2},{"text":"“Kunoo ani xoofoo dhugaatii nama gatantarsu","poem":1},{"text":"harka keetii fuudheera;","poem":2},{"text":"ati siʼachi xoofoo dheekkamsa koo","poem":1},{"text":"keessaa deebitee hin dhugdu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Anis xoofoo sana harka warra si dhiphisan","poem":1},{"text":"kanneen, ‘Akka nu sirra yaanuuf, lafa irra diriirfami’","poem":2},{"lineBreak":true},{"text":"siin jedhan sanaa keessa nan kaaʼa.","poem":2},{"text":"Ati immoo dugda kee akkuma lafaa,","poem":1},{"text":"akkuma daandii namni irra deemuu goote.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":23}