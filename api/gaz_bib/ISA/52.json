{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":52,"content":[{"type":"verse","number":1,"content":[{"text":"Yaa Xiyoon, dammaqi, dammaqi;","poem":1},{"text":"jabina kee uffadhu!","poem":2},{"text":"Yaa Yerusaalem, yaa magaalaa qulqullittii,","poem":1},{"text":"wayyaa kee miidhagaa sana uffadhu.","poem":2},{"text":"Namoonni dhagna hin qabaminii fi","poem":1},{"text":"xuraaʼonni lammaffaa sitti hin seenan.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yaa Yerusaalem, awwaara of irraa dhadhaʼadhu;","poem":1},{"text":"kaʼiitii teessoo irra taaʼi.","poem":2},{"text":"Yaa intala Xiyoon boojiʼamtittii,","poem":1},{"text":"foncaa morma keetii of irraa hiiki.","poem":2}]},{"type":"verse","number":3,"content":["Waaqayyo akkana jedhaatii:",{"text":"“Isin gatii malee gurguramtanii turtan;","poem":1},{"text":"amma immoo maallaqa malee furamtan.”","poem":2}]},{"type":"verse","number":4,"content":["Waaqayyo Gooftaan akkana jedhaatii:",{"text":"“Jalqabatti sabni koo jiraachuuf jedhee Gibxitti gad buʼe;","poem":1},{"text":"ergasii Asoor sababii malee isaan cunqurse.","poem":2}]},{"type":"verse","number":5,"content":["“Yoos ani amma maalan asii qaba?” jedha Waaqayyo.",{"text":"“Sabni koo sababii malee fudhatameera;","poem":1},{"text":"warri isaan bulchanis ni qoosu” jedha Waaqayyo.","poem":2},{"text":"“Guyyaa guutuus,","poem":1},{"text":"maqaan koo ittuma fufee arrabsama.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kanaafuu sabni koo maqaa koo ni beeka;","poem":1},{"text":"kanaafuu isaan gaafas kan duraan dursee waan sana dubbate","poem":2},{"text":"akka ana taʼe ni beeku.","poem":1},{"text":"Eeyyee, inni anuma.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Miilli warra wangeela fidanii,","poem":1},{"text":"kan nagaa labsanii,","poem":2},{"text":"kan oduu gammachiisaa fidanii,","poem":1},{"text":"kan fayyina labsanii, kan Xiyooniin,","poem":2},{"text":"“Waaqni kee moʼeera!” jedhanii","poem":1},{"text":"tulluuwwan irratti akkam miidhagaa dha!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dhaggeeffadhu! Eegdonni kee sagalee isaanii ol fudhataniiru;","poem":1},{"text":"isaan tokkummaadhaan gammachuudhaan iyyu.","poem":2},{"text":"Yeroo Waaqayyo Xiyoonitti deebiʼutti,","poem":1},{"text":"isaan ijuma isaaniitiin ni argu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yaa diigamtoota Yerusaalem","poem":1},{"text":"tokkummaadhaan faarfannaa gammachuu faarfadhaa;","poem":2},{"text":"Waaqayyo uummata isaa jajjabeessee","poem":1},{"text":"Yerusaaleminis fureeraa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Waaqayyo fuula saboota hundaa duratti,","poem":1},{"text":"irree isaa qulqulluu sana ni mulʼisa;","poem":2},{"text":"handaarri lafaa hundis","poem":1},{"text":"fayyisuu Waaqa keenyaa ni argu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Isin warri miʼa Waaqayyoo baattan, addaan baʼaa;","poem":1},{"text":"addaan baʼaa; achii fagaadhaa!","poem":2},{"text":"Waan xuraaʼaa tokko illee hin tuqinaa!","poem":1},{"text":"Ishee keessaa baʼaatii qulqulloota taʼa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Isin garuu ariitiidhaan achii hin baatan;","poem":1},{"text":"yookaan baqattanii hin deemtan;","poem":2},{"text":"Waaqayyo fuula keessan dura deemaatii;","poem":1},{"text":"Waaqni Israaʼel dugda duubaan isin eega.","poem":2}]},{"type":"heading","content":["Dhiphinaa fi Ulfina Garbicha Sanaa"]},{"type":"verse","number":13,"content":[{"text":"Kunoo, garbichi koo ogummaadhaan hojjeta;","poem":1},{"text":"inni ni kabajama; ol kaafama; ulfina guddaas ni argata.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Namoonni baayʼeen waaʼee isaa hamma naʼanitti,","poem":1},{"text":"fuulli isaa nama hundumaa caalaa golgolaaʼeera;","poem":2},{"lineBreak":true},{"text":"bifti isaas nama hundumaa caalaa badeera;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"akkasiinis inni saboota hedduu dinqisiifachiisa;","poem":1},{"text":"mootonni sababii isaatiif afaan isaanii qabatu.","poem":2},{"text":"Isaan waan isaanitti hin himamin arguutii;","poem":1},{"text":"waan hin dhagaʼinis ni hubatu.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}