{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":54,"content":[{"type":"heading","content":["Ulfina Egeree Xiyoon"]},{"type":"verse","number":1,"content":[{"text":"“Yaa dubartii dhabduu,","poem":1},{"text":"kan takkumaa hin daʼin, amma faarfadhu;","poem":2},{"text":"ati kan takkumaa ciniinsifattee hin beekin iyyii faarfadhu;","poem":1},{"text":"guddisiitii ililchi.","poem":2},{"text":"Ijoollee dubartii dhirsa qabduu caalaa","poem":1},{"text":"ijoolleen dubartii gatamtee ni baayʼatu”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Iddoo dunkaana keetii balʼifadhu;","poem":1},{"text":"golgaa dunkaana keetii balʼisii diriirsi;","poem":2},{"lineBreak":true},{"text":"walitti hin dachaasin;","poem":2},{"text":"funyoo kee dheereffadhu;","poem":1},{"text":"qofoo kees jabeeffadhu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ati gara mirgaattii fi gara bitaatti ni babalʼattaatii;","poem":1},{"text":"sanyiiwwan kee saboota ni dhaalu;","poem":2},{"lineBreak":true},{"text":"magaalaawwan isaanii kanneen duwwaa hafan keessas ni qubatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Hin sodaatin; ati hin qaanoftuutii.","poem":1},{"text":"Hin yaaddaʼin; ati hin salphattuutii;","poem":2},{"text":"Qaanii ijoollummaa keetii ni dagatta;","poem":1},{"text":"tuffii dhirsi kee sirraa duunaan sirra gaʼes siʼachi hin yaadattu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Uumaan kee dhirsa keeti;","poem":1},{"text":"maqaan isaas Waaqayyoo Waan Hunda Dandaʼuu dha;","poem":2},{"text":"Qulqullichi Israaʼel Furii kee ti;","poem":1},{"text":"innis Waaqa guutummaa lafaa jedhama.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Waaqayyo akka waan ati","poem":1},{"text":"akkuma niitii gatamtee garaan ishee gaddee,","poem":2},{"text":"akka niitii dargaggeessaa kan jibbamteetti","poem":1},{"text":"deebisee ofitti si waama” jedha Waaqni kee.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Ani yeroo muraasaafan si dhiise;","poem":1},{"text":"garuu gara laafina guddaadhaan deebisee sin fida.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ani dheekkamsa guddaadhaan","poem":1},{"text":"yeroo muraasaaf fuula koo si dhokfadheen ture;","poem":2},{"text":"garuu jaalala bara baraatiin,","poem":1},{"text":"garaa siifin laafa”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo Furiin kee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Wanni kun anaaf akkuma bara Nohi,","poem":1},{"text":"yeroo ani itti bishaan Nohi deebiʼee lafa irra hin garagalu jedheekakadhe sanaa ti.","poem":2},{"text":"Kanaafuu ani akkan sitti hin aarre,","poem":1},{"text":"gonkumaas lammata akkan si hin ifanne kakadheera.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tulluuwwan raafamanii,","poem":1},{"text":"gaarran buqqifaman iyyuu,","poem":2},{"text":"jaalalli hin geeddaramne kan ani siif qabu garuu hin raafamu;","poem":1},{"text":"yookaan kakuun koo kan nagaa hin diigamu”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo inni garaa siif laafu sun.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Yaa magaalaa miidhamte kan dambaliidhaan garagalfamteenama si jajjabeessu dhabde,","poem":1},{"text":"ani dhagaa gatii guddaatiin si ijaaree","poem":2},{"lineBreak":true},{"text":"sanpeeriidhaanis si hundeessa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ani fiixee kee lula diimaadhaan,","poem":1},{"text":"karrawwan kee dooqa calaqqisuun,","poem":2},{"lineBreak":true},{"text":"dallaa kee hunda immoo dhagaawwan gati jabeeyyiidhaan nan ijaara.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Waaqayyo ilmaan kee hunda ni barsiisa;","poem":1},{"text":"nagaan ijoollee keetiis guddaa taʼa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ati qajeelummaadhaan hundeeffamta;","poem":1},{"lineBreak":true},{"text":"cunqurfamuun sirraa fagaata;","poem":1},{"text":"wanni si sodaachisu tokko iyyuu hin jiru.","poem":2},{"text":"Gooliin sirraa fageeffama;","poem":1},{"text":"sitti iyyuu hin dhiʼaatu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yoo namni tokko iyyuu lola sitti kaase ani keessaa hin qabu;","poem":1},{"text":"namni lola sitti kaasu kam iyyuu harka sitti kennata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Kunoo, kan tumtuu sibiilaa kan cilee buufee","poem":1},{"text":"ibidda bobeessee miʼa waraanaa tumee","poem":2},{"lineBreak":true},{"text":"hojii isaatiif mijeessu sana uume anuma.","poem":2},{"text":"Kan nama waa balleessu tokko akka inni balaa buusuuf uumes anuma;","poem":1}]},{"type":"verse","number":17,"content":[{"text":"meeshaan si miidhuuf tolfame kam iyyuu hin milkaaʼu;","poem":2},{"lineBreak":true},{"text":"atis arraba si himatu hunda of irraa deebifta.","poem":2},{"text":"Kun dhaala tajaajiltoota Waaqayyoo ti;","poem":1},{"text":"innis qajeelummaa isaan narraa argatanii dha”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}