{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":56,"content":[{"type":"heading","content":["Fayyina Warra Kaaniif Kenname"]},{"type":"verse","number":1,"content":["Waaqayyo akkana jedha:",{"text":"Sababii fayyisuun koo dhiʼaatee fi","poem":1},{"text":"qajeelummaan koo dafee mulʼatuuf,","poem":2},{"text":"“Murtii qajeelaa eegaa;","poem":1},{"text":"waan qajeelaas hojjedhaa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Namni waan kana hojjetu,","poem":1},{"text":"kan waan kanattis cimu,","poem":2},{"text":"kan Sanbata utuu hin xureessineeguu fi waan hamaa kam iyyuu","poem":1},{"text":"hojjechuu irraa harka isaa eeggatu eebbifamaa dha.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Alagaan Waaqayyotti cichee tokko,","poem":1},{"text":"“Waaqayyo dhugumaansaba isaa irraa addaan na baasa” hin jedhin.","poem":2},{"text":"Xuʼaashiin kam iyyuus,","poem":1},{"text":"“Ani mukuma gogaadha” ofiin hin jedhin.","poem":2}]},{"type":"verse","number":4,"content":["Waaqayyo akkana jedhaatii:",{"text":"“Xuʼaashiiwwan Sanbatoota koo eegan,","poem":1},{"text":"kanneen waan na gammachiisu","poem":2},{"lineBreak":true},{"text":"filatanii fi kakuu koo jabeessanii eeganiif,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ani mana qulqullummaa kootii fi","poem":1},{"text":"dallaa isaa keessatti yaadannoo fi maqaa","poem":2},{"lineBreak":true},{"text":"ilmaanii fi intallan caalu tokko nan kennaaf;","poem":2},{"text":"ani maqaa bara baraa","poem":1},{"text":"kan hin haqamne isaaniif nan kenna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Alagoota isa tajaajiluuf,","poem":1},{"text":"maqaa Waaqayyoo jaallachuuf,","poem":2},{"text":"isa waaqeffachuuf","poem":1},{"text":"Waaqayyotti cichan","poem":2},{"text":"kanneen Sanbata utuu hin xureessin eeganii fi","poem":1},{"text":"kakuu koos cimsanii eegan hunda,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ani gara tulluu koo qulqulluutti isaan nan fida;","poem":1},{"text":"mana kadhannaa koo keessattis gammachuu isaaniif nan kenna.","poem":2},{"text":"Aarsaan isaanii kan gubamuu fi qalmi,","poem":1},{"text":"iddoo aarsaa koo irratti fudhatama ni argata;","poem":2},{"text":"manni koo saboota hundaaf,","poem":1},{"text":"mana sagadaa jedhamee waamamaatii.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Waaqayyo Gooftaan,","poem":1},{"text":"inni Israaʼeloota bittinnaaʼan walitti qabu sun akkana jedha:","poem":2},{"text":"“Ani warra duraan walitti qabaman biratti,","poem":1},{"text":"warra kaanis gara isaaniitti walitti nan qaba.”","poem":2}]},{"type":"heading","content":["Waaqni Dura Buʼoota Israaʼel himate"]},{"type":"verse","number":9,"content":[{"text":"Bineensonni dirree hundi,","poem":1},{"text":"bineensonni bosonaa hundis kottaatii itti gaggabaa nyaadhaa!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Eegdonni Israaʼel jaamota,","poem":1},{"text":"isaan hundi beekumsa hin qaban;","poem":2},{"text":"hundi isaanii saroota duudaa dha;","poem":1},{"text":"dutuus hin dandaʼan;","poem":2},{"text":"isaan ciisanii abjootu;","poem":1},{"text":"rafuus ni jaallatu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isaan saroota albaadheyyii dha;","poem":1},{"text":"nyaataniis hin quufan.","poem":2},{"text":"Isaan tiksoota hubannaa hin qabnee dha;","poem":1},{"text":"hundi isaanii daandii ofii isaanii irra deemu;","poem":2},{"lineBreak":true},{"text":"tokkoon tokkoon isaanii faayidaa ofii isaanii barbaadu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tokkoon tokkoon isaanii akkana jedhu;“Kottaa daadhii wayinii dhugnaa!","poem":1},{"text":"Kottaa dhugaatii cimaa dhugnee quufnaa!","poem":2},{"text":"Guyyaan borii akkuma harʼaa taʼa;","poem":1},{"text":"yookaan caaluu iyyuu ni dandaʼa.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}