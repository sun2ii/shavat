{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":57,"content":[{"type":"verse","number":1,"content":[{"text":"Namni qajeelaan ni duʼa;","poem":1},{"text":"kan waan kana yaadatti qabatu tokko iyyuu hin jiru;","poem":2},{"text":"warri Waaqaaf of kennan ni fudhatamu;","poem":1},{"text":"akka qajeeltonni","poem":2},{"text":"waan hamaa jalaa baraaramuuf fudhataman","poem":1},{"text":"namni tokko iyyuu hin hubatu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Namni qajeelummaadhaan jiraatu,","poem":1},{"text":"gara nagaa seena;","poem":2},{"lineBreak":true},{"text":"isaan siree isaanii irra boqotu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Isin garuu yaa ilmaan falfaltittii,","poem":1},{"text":"isin sanyiin ejjituutii fi sagaagaltuu as kottaa!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isin eenyutti qoostu?","poem":1},{"text":"Eenyutti afaan banattu?","poem":2},{"lineBreak":true},{"text":"Eenyuttis arraba baaftu?","poem":2},{"text":"Isin ilmaan finciltootaa,","poem":1},{"text":"sanyii sobdootaa mitii?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isin mukkeen qilxuu gidduutti,","poem":1},{"text":"mukkeen dagaagan hunda jalatti hawwii hamaadhaan gubattan;","poem":2},{"text":"sululoota keessatti,","poem":1},{"text":"holqa kattaa keessattis ijoollee keessan qaltan.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dhagaawwan cululuqoon sulula keessaa qooda kee ti;","poem":1},{"text":"dhugumaan carraan kee isaanuma.","poem":2},{"text":"Ati dhibaayyuu isaaniif dhangalaafte;","poem":1},{"text":"aarsaa midhaanii isaaniif dhiʼeessiteerta.","poem":2},{"lineBreak":true},{"text":"Ani wantoota kanneen calʼisee nan ilaalaa?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ati siree kee tulluu guddaa fi ol dheeraa irra dhaabbatteerta;","poem":1},{"text":"aarsaa kee dhiʼeeffachuufis achi ol baate.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ati cufaa keetii fi michichila cufaa keetii duubaan,","poem":1},{"text":"yaadannoo kee fannifatteerta.","poem":2},{"text":"Ana dhiiftee siree kee saaqqatte;","poem":1},{"text":"yaabdees balʼiftee banattee keessa seente;","poem":2},{"text":"ati warra siree isaanii jaallatte","poem":1},{"text":"wajjin walii galte sana qullaa isaanii ilaalte.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ati zayitii ejersaa fudhattee gara Moolek dhaqxe;","poem":1},{"text":"shittoo kee illee ni baayʼifatte.","poem":2},{"text":"Ergamoota kee biyya fagootti ergite;","poem":1},{"text":"siiʼoolittis gad ergite!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dheerina karaa keetiitiin dadhabdee turte;","poem":1},{"text":"ati garuu, ‘Wanni kun faayidaa hin qabu’ hin jenne.","poem":2},{"text":"Jabina haaromfame argatte;","poem":1},{"text":"kanaafuu ati hin dadhabne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Ati akka na sobduuf","poem":1},{"text":"akka na hin yaadanneef,","poem":2},{"text":"yookaan akka waan kana garaatti hin qabanneef,","poem":1},{"text":"eenyuun sodaattee akkas naate?","poem":2},{"text":"Ati sababii ani yeroo dheeraa calʼiseef,","poem":1},{"text":"na sodaachuu dhiifte mitii?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ani qajeelummaa keetii fi hojii kee ifatti nan baasa;","poem":1},{"text":"isaan garuu si hin fayyadan.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yeroo ati gargaarsaaf iyyitutti,","poem":1},{"text":"mee waaqonni tolfamoon ati walitti qabatte sun si haa baasan!","poem":2},{"text":"Bubbeen hunda isaanii fudhatee bada;","poem":1},{"text":"hafuurri baafatan iyyuu afuufee isaan balleessa.","poem":2},{"text":"Namni daʼannoo isaa ana godhatu garuubiyyattii ni dhaala;","poem":1},{"text":"tulluu koo qulqulluu sana illee ni dhuunfata.”","poem":2}]},{"type":"heading","content":["Abdii Warra Gad Qabamaniif Kenname"]},{"type":"verse","number":14,"content":["Akkanas ni jedhama:",{"text":"“Tolchaa; tolchaa; daandii qopheessaa!","poem":1},{"text":"Karaa saba kootii irraa gufuuwwan bubuqqisaa.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Inni guddaanii fi ol ol jedhe,","poem":1},{"text":"kan bara baraan jiraatuu fikan maqaan isaa qulqulluu jedhamu sun akkana jedha:","poem":2},{"text":"“Ani iddoo ol kaʼaa fi iddoo qulqulluu irra nan jiraadha;","poem":1},{"text":"hafuura warra gad qabamanii bayyanachiisuuf,","poem":2},{"text":"garaa warra gad of qabanii jajjabeessuuf garraamii fi","poem":1},{"text":"kan hafuuraan gad qabame wajjinis nan jiraadha.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ani bara baraan namatti hin falmu;","poem":1},{"text":"yookaan yeroo hunda hin dheekkamu;","poem":2},{"text":"yoo akkas taʼe hafuurri namaa,","poem":1},{"text":"hafuurri namni ani uume baafatu ni citaatii.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ani dharraa isaa kan cubbuun guutame sanattan dheekkame;","poem":1},{"text":"isa adabees aariidhaan fuula koo isa duraa nan dhokfadhe;","poem":2},{"lineBreak":true},{"text":"inni garuu karuma fedhii isaatiin itti fufe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ani karaa isaa argeera; garuu isa nan fayyisa;","poem":1},{"text":"ani isa nan qajeelcha; deebisees nan jajjabeessa;","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"arraba boossuuwwan Israaʼel keessa jiraatanii irrattisgalata nan uuma.","poem":2},{"text":"Warra fagoo jiraataniif nagaan, warra dhiʼoo jiraataniifis nagaan haa taʼu.","poem":1},{"text":"Anis isaan nan fayyisa” jedha Waaqayyo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Namoonni hamoon garuu akkuma galaana olii gadi daddarbatamu,","poem":1},{"text":"kan boqochuu hin dandeenye,","poem":2},{"lineBreak":true},{"text":"kan dambaliin isaa laaqii fi dhoqqee tufuu ti.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“Namoota hamoof nagaan hin jiru” jedha Waaqni koo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":21}