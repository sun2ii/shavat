{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":60,"content":[{"type":"heading","content":["Ulfina Xiyoon"]},{"type":"verse","number":1,"content":[{"text":"“Ifni kee dhufeeraatii kaʼii ibsi;","poem":1},{"text":"ulfinni Waaqayyoo siif baʼeera.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kunoo, dukkanni lafa,","poem":1},{"text":"dukkanni hamaan immoo uummattoota haguuga;","poem":2},{"text":"Waaqayyo garuu siif kaʼeera;","poem":1},{"text":"ulfinni isaas sirraa mulʼata.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Saboonni gara ifa keetii,","poem":1},{"text":"mootonni immoo gara ifa kee 2 isa bariitti ni dhufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ija kee ol fudhadhuutii naannoo kee ilaali;","poem":1},{"text":"hundinuu wal gaʼanii gara kee ni dhufu;","poem":2},{"text":"ilmaan kee fagoodhaa,","poem":1},{"text":"intallan kees qomatti baatamanii gara kee ni dhufu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ergasii ni ilaalta; ni calaqqiftas;","poem":1},{"text":"lapheen kee ni dhaʼata; gammachuudhaanis ni guutama;","poem":2},{"text":"qabeenyi galaanotaa hundinuu gara kee dhufu;","poem":1},{"text":"badhaadhummaan sabootaas kan kee taʼa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gaalli baayʼeen, ilmaan gaalaa kan Midiyaanii fi","poem":1},{"text":"kan Eefaa biyya kee ni guutu.","poem":2},{"text":"Namoonni hundi warqee fi ixaana fidanii,","poem":1},{"text":"galata Waaqayyoo labsaa","poem":2},{"lineBreak":true},{"text":"biyya Shebaatii ni dhufu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bushaayeen Qeedaar hundinuu gara keetti walitti qabamu;","poem":1},{"text":"korbeeyyiin hoolaa Nabaayot si tajaajilu;","poem":2},{"text":"isaan iddoo aarsaa koo irratti aarsaawwan fudhatama qaban ni taʼu;","poem":1},{"text":"anis mana ulfina kootii nan kabaja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Warri akkuma gugeewwanii manneen isaaniitti barrisan,","poem":1},{"text":"kanneen akka duumessaa gugatan kunneen eenyu faʼi?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dhugumaan biyyoonni bishaan gidduu na abdatu;","poem":1},{"text":"sababii inni ulfina sitti uffiseef,","poem":2},{"text":"maqaa Waaqayyo Waaqa keetii,","poem":1},{"text":"Qulqullicha Israaʼeliitiif jedhanii","poem":2},{"text":"dooniiwwan Tarshiish dursanii,","poem":1},{"text":"meetii fi warqee isaanii wajjin","poem":2},{"lineBreak":true},{"text":"ilmaan kee fagoodhaa ni fidu.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Namoonni ormaa dallaa kee ni ijaaru;","poem":1},{"text":"mootonni isaaniis si tajaajilu;","poem":2},{"text":"Ani aariidhaan si dhaʼu illee,","poem":1},{"text":"gara laafina koo jaalalaan sitti nan argisiisa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Akka namoonni badhaadhina sabootaa gara keetti fidaniif,","poem":1},{"text":"akka mootonni isaaniis hiriiraan gara keetti seenaniif,","poem":2},{"text":"karrawwan kee yeroo hunda banamaa taʼu;","poem":1},{"text":"isaan halkanii guyyaa gonkumaa hin cufaman;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sabni yookaan mootummaan si hin tajaajilleni barbadaaʼuutii;","poem":1},{"text":"guutummaan guutuuttis ni balleeffamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Ulfinni Libaanoon,","poem":1},{"text":"gaattiraan, qararoo fi hadheessi,","poem":2},{"text":"lafa iddoo qulqulluu koo miidhagsuuf gara kee ni dhufu;","poem":1},{"text":"anis iddoo miilli koo dhaabatu nan kabaja.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ilmaan warra si cunqursanii siif sagadaa gara kee dhufu;","poem":1},{"text":"warri si tuffatan hundinuus miilla keetti kufu;","poem":2},{"text":"isaanis Magaalaa Waaqayyoo","poem":1},{"text":"Xiyoon kan Qulqullicha Israaʼel jedhanii si waamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Yoo ati jibbamtee gatamtee namni tokko iyyuu","poem":1},{"text":"si keessaan darbuu lagate iyyuu,","poem":2},{"text":"ani boontuu bara baraatii fi","poem":1},{"text":"gammachuu dhaloota hundaa sin taasisa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ati aannan sabootaa ni dhugda;","poem":1},{"text":"harma moototaas ni hoota.","poem":2},{"text":"Yommus ani Waaqayyo Jabaan Yaaqoob,","poem":1},{"text":"Fayyisaa kee fi Furaa kee akkan taʼe ni beekta.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ani qooda naasii warqee,","poem":1},{"text":"qooda sibiilaa immoo, meetii siif nan fida.","poem":2},{"text":"Qooda mukaa naasii,","poem":1},{"text":"qooda dhagaa immoo, sibiila siif nan fida.","poem":2},{"text":"Nagaa mootii kee,","poem":1},{"text":"qajeelummaa immoo, bulchaa kee nan godha.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Siʼachi biyya kee keessatti gooliin,","poem":1},{"text":"daarii kee keessatti immoo diigamni yookaan badiisnihin dhagaʼamu;","poem":2},{"text":"ati garuu dallaa kee Fayyina,","poem":1},{"text":"karrawwan kee immoo Galata jettee waamta.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Siʼachi aduun guyyaadhaan,","poem":1},{"text":"ifni jiʼaas halkaniin ifa kee hin taʼu;","poem":2},{"text":"Waaqayyo ifa kee bara baraa taʼaatii;","poem":1},{"text":"Waaqni kee ulfina kee ni taʼa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Aduun kee deebitee hin dhiitu;","poem":1},{"text":"jiʼi kee hin badu;","poem":2},{"text":"Waaqayyo ifa kee bara baraa ni taʼa;","poem":1},{"text":"barri gadda kees ni raawwatama.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yoos uummanni kee hundi qajeelaa ni taʼa;","poem":1},{"text":"bara baraanis lafa ni dhaala.","poem":2},{"text":"Isaan biqiltuu ani dhaabbadhee dha;","poem":1},{"text":"hojii harka koo, kan ani ittiin ulfina koo mulʼisuufjedhee hojjedhee dha.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Maatiin muraasni kuma,","poem":1},{"text":"gareen xinnaan immoo saba guddaa taʼa.","poem":2},{"text":"Ani Waaqayyoo dha;","poem":1},{"text":"waan kana yeroo isaatti dafee nan hojjedha.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/59.json","previousChapterAudioLinks":{},"numberOfVerses":22}