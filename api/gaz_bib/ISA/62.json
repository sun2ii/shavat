garuu, “Ani isheetti nan gammada” jedhamta;","poem":1},{"text":"biyyi kees “kan heerumte” jedhamti;","poem":2},{"text":"Waaqayyo sitti gammadaatii,","poem":1},{"text":"biyyi kee ni heerumti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Akkuma dargaggeessi durba fuudhu,","poem":1},{"text":"ilmaan kee si fuudhu;","poem":2},{"text":"akkuma misirrichi misirrittiitti gammadu,","poem":1},{"text":"Waaqni kees sitti gammada.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yaa Yerusaalem, ani dallaawwan kee irrattieegdota ramadeera;","poem":1},{"text":"isaan gonkumaa halkanii fi guyyaa hin calʼisan.","poem":2},{"text":"Isin warri Waaqayyoon waammattan,","poem":1},{"text":"ofii keessaniif boqonnaa hin kenninaa;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"hamma inni Yerusaalemin cimsee ijaaree","poem":1},{"text":"akka isheen lafa irratti leellifamtuu taatu godhuttiboqonnaa isaaf hin kenninaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Waaqayyo akkana jedhee","poem":1},{"text":"harka isaa mirgaatii fi irree isaa jabaa sanaan kakateera;","poem":2},{"text":"“Ani lammata midhaan kee","poem":1},{"text":"nyaata godhee diinota keetiif hin kennu;","poem":2},{"text":"namoonni ormaas lammata daadhii wayinii haaraa","poem":1},{"text":"kan ati itti dadhabde hin dhugan;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"garuu warri galfatan midhaan sana ni nyaatu;","poem":1},{"text":"Waaqayyoonis ni galateeffatu;","poem":2},{"text":"warri ija wayinii guurratanis","poem":1},{"text":"oobdii iddoo qulqulluu koo keessatti ni dhugu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Keessa darbaa; karrawwan keessaan darbaa!","poem":1},{"text":"Uummataaf karaa qopheessaa.","poem":2},{"text":"Tolchaa; karaa guddaa tolchaa!","poem":1},{"text":"Dhagaawwan bubuqqisaa.","poem":2},{"text":"Sabootaafis faajjii ol qabaa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Waaqayyo akkana jedhee","poem":1},{"text":"hamma moggaa lafaatti labseera;","poem":2},{"text":"“Intala Xiyooniin akkana jedhaa:","poem":1},{"text":"‘Kunoo Fayyisaan kee ni dhufa!","poem":2},{"text":"Badhaasni isaa kunoo isa harka jira;","poem":1},{"text":"beenyaan inni namaaf baasus isuma wajjin jira.’ ”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Isaanis Saba Qulqulluu,","poem":1},{"text":"Furamtoota Waaqayyoo jedhamanii ni waamamu;","poem":2},{"text":"atis barbaadamtuu,","poem":1},{"text":"Magaalaa Siʼachi Hin Onne ni jedhamta.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}