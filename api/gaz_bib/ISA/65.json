{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":65,"content":[{"type":"heading","content":["Murtii fi Fayyina"]},{"type":"verse","number":1,"content":[{"text":"“Ani warra na hin iyyaafatinitti nan mulʼadhe;","poem":1},{"text":"warri na hin barbaadinis na argatan.","poem":2},{"text":"Ani saba maqaa koo hin waammatiniin,","poem":1},{"text":"‘Ani asan jira; ani asan jira’ nan jedhe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ani guyyaa guutuu gara uummata didaa taʼeetti,","poem":1},{"text":"kan karaa gaarii hin taʼin irra deemu,","poem":2},{"text":"kan yaada ofii isaa duukaa buʼuuf","poem":1},{"text":"harka koo nan diriirfadhe;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isaan saba iddoo biqiltuu keessatti aarsaa dhiʼeessuudhaan,","poem":1},{"text":"iddoo aarsaa kan xuubii irrattis ixaana aarsuudhaan,","poem":2},{"text":"utuu gargar hin kutin, utuma ani arguu","poem":1},{"text":"dheekkamsaaf na kakaasanii dha;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"isaan warra awwaala gidduu tataaʼanii","poem":1},{"text":"lafa dhoksaa bulanii dha;","poem":2},{"text":"warra foon booyyee nyaatanii","poem":1},{"text":"okkoteen isaanii bishaan foon xuraaʼaa baatuu dha;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"isaan warra, ‘Achi fagaadhu; natti hin dhiʼaatin;","poem":1},{"text":"ani si caalaa qulqulluudhaatii!’ jedhanii dha.","poem":2},{"text":"Sabni akkasii funyaan koo keessatti akkuma aaraa,","poem":1},{"text":"akkuma ibidda guyyaa guutuu bobaʼuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Kunoo, wanni kun akkana jedhamee fuula koo duratti barreeffameera:","poem":1},{"text":"ani hin calʼisu; garuu gatii hojii isaanii guutuu nan kennaaf;","poem":2},{"lineBreak":true},{"text":"dhugumaanis qomatti isaan nan baachisa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kunis cubbuu keessanii fi cubbuu abbootii keessanii ti”","poem":1},{"text":"jedha Waaqayyo.","poem":2},{"text":"“Isaan tulluuwwan irratti aarsaa dhiʼeessanii,","poem":1},{"text":"gaarran irratti waan na arrabsaniif,","poem":2},{"text":"ani hojii isaanii kan duriitiif,","poem":1},{"text":"kaffaltii guutuu isaaniifin kenna.”","poem":2}]},{"type":"verse","number":8,"content":["Waaqayyo akkana jedha:",{"text":"“Akkuma yeroo hurbuu wayinii keessa cuunfaan jirutti,","poem":1},{"text":"namoonni, ‘Amma iyyuu eebbatu keessa jiraatii,","poem":2},{"lineBreak":true},{"text":"hin balleessinaa’ jedhan sana,","poem":2},{"text":"anis tajaajiltoota kootiif akkasuma nan godha;","poem":1},{"text":"isaan hundas hin balleessu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anis Yaaqoob keessaa sanyii tokko,","poem":1},{"text":"Yihuudaa keessaa immoo warra tulluuwwan koo dhaalan nan biqilcha;","poem":2},{"text":"sabni koo filatamaan tulluuwwan sana dhaala;","poem":1},{"text":"tajaajiltoonni koos achi ni jiraatu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Saba koo kan na barbaaduuf","poem":1},{"text":"Shaaroon lafa bushaayeen itti bobbaʼan,","poem":2},{"lineBreak":true},{"text":"Sululli Aakoor immoo lafa loon boqotan ni taʼan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Garuu isin warra Waaqayyoon dhiiftanii","poem":1},{"text":"tulluu koo qulqulluu dagattan,","poem":2},{"text":"kanneen waaqa ‘Milkii’ jedhamuufmaaddii qopheessitanii,","poem":1},{"text":"waaqa, ‘Hiree’ jedhamuuf immoo dhibaayyuu kubbaayyaatti guuttan,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ani irbaata goraadee isinan godha;","poem":1},{"text":"isin hundis qalamuuf gad jettu; ani isin waameen ture;","poem":2},{"text":"isin garuu na jalaa hin owwaanne;","poem":1},{"text":"ani dubbadheen ture; isin garuu na hin dhaggeeffanne.","poem":2},{"text":"Isin fuuluma koo duratti waan hamaa hojjettanii","poem":1},{"text":"waan na hin gammachiifne filattan.”","poem":2}]},{"type":"verse","number":13,"content":["Kanaafuu Waaqayyo Gooftaan akkana jedha:",{"text":"“Garboonni koo ni nyaatu;","poem":1},{"text":"isin garuu ni beeloftu;","poem":2},{"text":"garboonni koo ni dhugu;","poem":1},{"text":"isin garuu ni dheebottu;","poem":2},{"text":"garboonni koo ni gammadu;","poem":1},{"text":"isin garuu ni qaanoftu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Garboonni koo","poem":1},{"text":"gammachuu garaa irraa maddeen ni faarfatu;","poem":2},{"text":"isin garuu,","poem":1},{"text":"waan garaan keessan miidhameef ni boossu;","poem":2},{"lineBreak":true},{"text":"waan hafuurri keessan gaddeef ni wawwaattu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Filatamtoonni koo maqaa isin dabarfattan sana","poem":1},{"text":"abaarsaaf itti fayyadamu;","poem":2},{"text":"Waaqayyo Gooftaan isin fixa;","poem":1},{"text":"garboota isaatiif garuu maqaa biraa ni kenna.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Namni lafa irratti eebbifamu kam iyyuu,","poem":1},{"text":"Waaqa dhugaatiin eebbifama;","poem":2},{"text":"namni lafa irratti kakatus,","poem":1},{"text":"Waaqa dhugaatiin kakata.","poem":2},{"text":"Rakkinni durii ni irraanfatama;","poem":1},{"text":"ija koo duraas ni dhokataatii.","poem":2}]},{"type":"heading","content":["Samiiwwan Haaraa fi Lafa Haaraa"]},{"type":"verse","number":17,"content":[{"text":"“Kunoo ani, samiiwwan haaraa fi","poem":1},{"text":"lafa haaraa nan uuma.","poem":2},{"text":"Wanni durii hin yaadatamu;","poem":1},{"text":"yookaan qalbii namaatti hin dhufu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Isin garuu waan ani uumutti,","poem":1},{"text":"bara baraan gammadaa ililchaa;","poem":2},{"text":"ani Yerusaalemin gammachuuf,","poem":1},{"text":"saba ishee immoo ililleef nan uumaatii.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ani Yerusaalemitti nan gammada;","poem":1},{"text":"saba koottis nan gammada;","poem":2},{"text":"siʼachi sagaleen booʼichaatii fi","poem":1},{"text":"iyyaa ishee keessatti hin dhagaʼamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Siʼachi, daaʼimni guyyaa muraasa qofa jiraatu,","poem":1},{"text":"yookaan jaarsi umuriin isaa hanqatu tokko iyyuu","poem":2},{"lineBreak":true},{"text":"ishee keessatti hin argamu;","poem":2},{"text":"namni waggaa dhibbatti duʼu,","poem":1},{"text":"akka waan dargaggummaan duʼeetti yaadama;","poem":2},{"text":"namni waggaa dhibba hanqate tokko,","poem":1},{"text":"akka waan abaarameetti hedama.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Namoonni mana ni ijaarratu; achi keessas ni jiraatu;","poem":1},{"text":"wayinii dhaabbatu; ija isaas ni nyaatu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Siʼachi isaan mana ijaaranii namoonni biraa keessa hin jiraatan;","poem":1},{"text":"yookaan isaan biqiltuu dhaabanii namoonni biraa hin nyaatan.","poem":2},{"text":"Umuriin saba koo,","poem":1},{"text":"akkuma umurii mukaa ni taʼa;","poem":2},{"text":"warri ani filadhe,","poem":1},{"text":"hojii harka isaaniitiin bara dheeraa ni gammadu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Isaan akkasumaan hin dadhaban","poem":1},{"text":"yookaan ijoollee balaan eeggattu hin dhalchan;","poem":2},{"text":"isaan sanyii isaanii wajjin","poem":1},{"text":"saba Waaqayyo eebbisu ni taʼu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ani utuu isaan na hin waammatin nan deebisaaf;","poem":1},{"text":"utuu isaan dubbatanii hin fixinis nan dhagaʼa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yeeyyii fi xobbaallaan hoolaa walii wajjin nyaatu;","poem":1},{"text":"leenci akka sangaa okaa nyaata;","poem":2},{"lineBreak":true},{"text":"biyyoon garuu soora bofaa taʼa.","poem":2},{"text":"Isaan tulluu koo qulqulluu hunda irratti homaa hin miidhan","poem":1},{"text":"yookaan homaa hin balleessan”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/64.json","previousChapterAudioLinks":{},"numberOfVerses":25}