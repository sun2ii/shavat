{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_bib","name":"Isaayyaas","commonName":"Isaayyaas","title":"Raajii Isaayyaas","order":23,"numberOfChapters":66,"sha256":"a6f035efa5cece862138929a1298e53cdcc4ebbdf048a68b62f8a81b1c9ba298","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":9,"content":[{"type":"heading","content":["Mucaan Nuuf Dhalateera"]},{"type":"verse","number":1,"content":["Warri rakkina guddaa keessa turan garuu siʼachi gadda keessa hin jiraatan. Inni duraan biyya Zebuuloonii fi biyya Niftaalem gad deebise; gara fuulduraatti garuu Galiilaa Namoota Ormaa kan Yordaanosiin gama, qarqara Daandii Galaanaa irra jiran sana ni kabaja."]},{"type":"verse","number":2,"content":[{"text":"Sabni dukkana keessa jiraatu ifa guddaa argeera;","poem":1},{"text":"warra biyya dukkana limixii keessa jiraataniifis ifni baʼeera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ati saba baayʼiftee","poem":1},{"text":"gammachuu isaanii illee guddifteerta;","poem":2},{"text":"isaan akkuma uummanni yeroo","poem":1},{"text":"midhaan haamamutti gammadu sana,","poem":2},{"text":"akkuma namoonni yeroo boojuu qooddatanitti","poem":1},{"text":"gammadan sana fuula kee duratti ni ililchu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ati akkuma bara Midiyaanin moʼatame sanaa,","poem":1},{"text":"waanjoo isaanitti ulfaate","poem":2},{"text":"somaa gatiittii isaanii irraa","poem":1},{"text":"ulee cunqursaa isaanii illee caccabsiteerta.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kopheen loltuun ittiin duulte hundi,","poem":1},{"text":"uffanni dhiiga keessa cuuphame hundi","poem":2},{"text":"ibiddaan gubama;","poem":1},{"text":"qoraan ibiddaas taʼa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mucaan nuuf dhalateera;","poem":1},{"text":"ilmi nuuf kennameera;","poem":2},{"lineBreak":true},{"text":"mootummaan gatiittii isaa irra jiraata.","poem":2},{"text":"Innis Gorsaa Dinqisiisaa, Waaqa Jabaa,","poem":1},{"text":"Abbaa Bara baraa, Mootii Nagaa","poem":2},{"lineBreak":true},{"text":"jedhamee ni waamama.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Babalʼinni mootummaa isaatii fi","poem":1},{"text":"nagaan isaa dhuma hin qabu.","poem":2},{"text":"Innis murtii qajeelaa fi qajeelummaadhaan","poem":1},{"text":"hundeessee jabeessee dhaabuudhaan","poem":2},{"text":"yeroo sanaa jalqabee bara baraan","poem":1},{"text":"teessoo Daawit irra taaʼee mootummaa isaa bulcha.","poem":2},{"text":"Hinaaffaan Waaqayyoo Waan Hunda Dandaʼuus","poem":1},{"text":"waan kana ni raawwata.","poem":2}]},{"type":"heading","content":["Waaqayyo Israaʼelitti Dheekkame"]},{"type":"verse","number":8,"content":[{"text":"Gooftaan dhaamsa tokko Yaaqoobitti ergeera;","poem":1},{"text":"kunis Israaʼel irra buʼa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Uummanni hundi,","poem":1},{"text":"Efreemii fi jiraattonni Samaariyaa waan kana ni beeku;","poem":2},{"lineBreak":true},{"text":"isaanis of tuuluu fi garaa of jajuun akkana jedhu;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Xuubiiwwan diigamaniiru;","poem":1},{"text":"nu garuu dhagaa soofameen deebisnee ijaarra;","poem":2},{"text":"mukkeen harbuu murmuramaniiru;","poem":1},{"text":"nu garuu birbirsa iddoo buusna.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kanaafuu Waaqayyo amajaajota Reziin isaanitti jabeesse;","poem":1},{"text":"diinota isaanii illee isaanitti kakaase.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Warri Sooriyaa gama baʼaatiin,Filisxeemonni immoo gama lixaatiin","poem":1},{"text":"afaan banatanii Israaʼelin liqimsan.","poem":2},{"lineBreak":true},{"text":"Kana hundaan illee dheekkamsi isaa hin qabbanoofne;","poem":1},{"text":"harki isaas amma iyyuu akkuma ol kaafametti jira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Sabni sun garuu gara isa isaan dhaʼe sanaatti hin deebine","poem":1},{"text":"yookaan Waaqayyoo Waan Hunda Dandaʼu hin barbaaddanne.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kanaafuu Waaqayyo Israaʼel irraa mataa fi eegee kuta;","poem":1},{"text":"damee meexxiitii fi shambaqqoo guyyuma tokkoon balleessa;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"maanguddoonnii fi kabajamoonni mataa dha;","poem":1},{"text":"raajonni soba barsiisan immoo eegee dha.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Namoonni saba kana qajeelchan isaan dogoggorsu;","poem":1},{"text":"warri isaaniin qajeelfamanis karaa irraa badu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kanaafuu Gooftaan dargaggootatti hin gammadu","poem":1},{"text":"yookaan ijoollee abbaa hin qabnee fihaadhota hiyyeessaatiif hin naʼu;","poem":2},{"text":"namni hundinuu kan Waaqa hin sodaannee fi hamaadhaatii;","poem":1},{"text":"afaan hundinuus hamaa dubbata.","poem":2},{"lineBreak":true},{"text":"Kana hundaan illee dheekkamsi isaa hin qabbanoofne;","poem":1},{"text":"harki isaas amma iyyuu akkuma ol kaafametti jira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Hamminni dhugumaan akka ibiddaa bobaʼa;","poem":1},{"text":"inni sokorruu fi qoraattii illee gubee balleessa,","poem":2},{"text":"bosona gobbuus ni qabata;","poem":1},{"text":"akkuma aara ol baʼuuttis ol baʼa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Dheekkamsa Waaqayyoo Waan Hunda Dandaʼuutiinlafti ni gubatti;","poem":1},{"text":"namoonnis qoraan ibiddaa taʼu;","poem":2},{"lineBreak":true},{"text":"namni kam iyyuu obboleessa isaa oolchuu hin dandaʼu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Karaa mirgaatiin ni butatu;","poem":1},{"text":"garuu beela hin baʼan;","poem":2},{"text":"karaa bitaatiin ni nyaatu;","poem":1},{"text":"garuu hin quufan.","poem":2},{"text":"Tokkoon tokkoon isaanii foon aantee isaa nyaata;","poem":1}]},{"type":"verse","number":21,"content":[{"text":"Minaaseen Efreemin nyaata; Efreemis Minaasee nyaata;","poem":2},{"lineBreak":true},{"text":"isaan tokkummaadhaan Yihuudaatti garagalu.","poem":2},{"lineBreak":true},{"text":"Kana hundaan illee dheekkamsi isaa hin qabbanoofne;","poem":1},{"text":"harki isaas amma iyyuu akkuma ol kaafametti jira.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ISA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}