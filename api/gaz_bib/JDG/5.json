{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JDG","translationId":"gaz_bib","name":"Abbootii Murtii","commonName":"Abbootii Murtii","title":"Kitaaba Abbootii Murtii","order":7,"numberOfChapters":21,"sha256":"a00680bfedba5beed78533729cd2a634cdf0da5f2b69d29b3dd2f6bf50796cdc","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/gaz_bib/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":5,"content":[{"type":"heading","content":["Faarfannaa Debooraa"]},{"type":"verse","number":1,"content":["Gaafas Debooraa fi Baaraaqi ilmi Abiinooʼam akkana jedhanii faarfatan:"]},{"type":"verse","number":2,"content":[{"text":"“Yommuu ilmaan moototaa Israaʼelin hoogganan,","poem":1},{"text":"yommuu sabni Israaʼelis jaallatee of kennutti","poem":2},{"lineBreak":true},{"text":"Waaqayyoon galateeffadhaa!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Yaa mootota, waan kana dhagaʼaa! Bulchitoonnis dhaggeeffadhaa!","poem":1},{"text":"Waaqayyoon nan faarfadha; amma illee nan faarfadha;","poem":2},{"lineBreak":true},{"text":"Waaqayyo Waaqa Israaʼeliif nan weeddisa.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Yaa Waaqayyo, yeroo ati biyya Seeʼiirii baate,","poem":1},{"text":"yeroo ati biyya Edoomii kaate,","poem":2},{"text":"lafti ni sochoote; samiiwwanis bokkaa,","poem":1},{"text":"duumessoonnis bishaan gad roobsan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tulluuwwan fuula Waaqayyo Waaqa Siinaa duratti,","poem":1},{"text":"fuula Waaqayyo Waaqa Israaʼel duratti ni raafaman.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Bara Ilma Anaat, jabana Shamgaar,","poem":1},{"text":"bara Yaaʼeel keessa daandiiwwan ni onan;","poem":2},{"lineBreak":true},{"text":"karaa deemtonnis daandii jajalʼaa irra deeman.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hamma ani Debooraan,","poem":1},{"text":"haadha taʼee Israaʼeliif kaʼutti,","poem":2},{"lineBreak":true},{"text":"gandoonni Israaʼel duwwaa hafu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yommuu isaan waaqota haaraa filatanitti,","poem":1},{"text":"waraanni hamma karra magaalaatti dhufe;","poem":2},{"text":"gaachanni yookaan eeboon tokko,","poem":1},{"text":"Israaʼeloota kuma afurtama gidduutti hin argamne.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Garaan koo bulchitoota Israaʼel kanneen fedhiidhaan","poem":1},{"text":"saba gidduutti argaman wajjin jira.","poem":2},{"lineBreak":true},{"text":"Waaqayyoon leellisaa!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Isin warri harroota adaadii yaabbatan,","poem":1},{"text":"warri kooraa baladii qabu irra teessan,","poem":2},{"lineBreak":true},{"text":"warri karaa irra deemtan hubadhaa;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"sagalee faarfattootaa dhagaʼaa.","poem":1},{"text":"Isaan hojii qajeelummaa Waaqayyoo,","poem":2},{"lineBreak":true},{"text":"hojii qajeelummaa loltoonni isaa Israaʼel keessatti godhan odeessu.","poem":2},{"lineBreak":true},{"text":"“Ergasii saboonni Waaqayyoo,","poem":1},{"text":"gara karra magaalattiitti gad buʼan.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"‘Yaa Debooraa! Dammaqi; dammaqi;","poem":1},{"text":"dammaqi; dammaqi; faarfannaas faarfadhu!","poem":2},{"text":"Yaa Baaraaqi! Dammaqi;","poem":1},{"text":"yaa ilma Abiinooʼam boojiʼamtoota kee boojiʼii fudhadhu.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Namoonni hafanis, gara warra gurguddaatti gad buʼan;","poem":1},{"text":"sabni Waaqayyoos, akka loltuu jabaatti gara koo dhufe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Warri hiddi isaanii Amaaleq keessa jiru tokko tokkos Efreem dhufan;","poem":1},{"text":"Beniyaamis namoota si duukaa buʼan wajjin ture.","poem":2},{"text":"Ajajjoonni loltoota Maakiir,","poem":1},{"text":"warri bokkuu ajajjuu qabatanis Zebuuloonii gad buʼan.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hangafoonni Yisaakor Debooraa wajjin turan;","poem":1},{"text":"Yisaakoris Baaraaqi wajjin ture;","poem":2},{"lineBreak":true},{"text":"innis Baaraaqi wajjin gara sululaatti gad buʼe.","poem":2},{"text":"Gosa Ruubeen gidduu,","poem":1},{"text":"qorannoo yaadaa guddaatu ture.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ati maaliif marʼachuu isaanii dhagaʼuuf jettee","poem":1},{"text":"gola bushaayee keessa turte?","poem":2},{"text":"Gosa Ruubeen gidduu,","poem":1},{"text":"qorannoo yaadaa guddaa isaatu ture.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Giliʼaad Yordaanos gama taaʼe;","poem":1},{"text":"Daan maaliif dooniiwwan keessatti hafe?","poem":2},{"text":"Aasheer qarqara galaanaatti hafe;","poem":1},{"text":"buufata isaa keessas ture.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Sabni Zebuuloon duʼaaf of saaxile;","poem":1},{"text":"Niftaalemis gaarran biyya isaa irratti akkasuma godhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Mootonni dhufanii lolan;","poem":1},{"text":"mootonni Kanaʼaanis Taʼanaakitti","poem":2},{"text":"bishaanota Megidoo biratti lolan;","poem":1},{"text":"boojuu meetii tokko illee hin fudhanne.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Samii keessaa urjiiwwan ni lolan;","poem":1},{"text":"adeemsa isaanii irrattis Siisaaraadhaan lolan.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Lagni durii, lagni Qiishoon,","poem":1},{"text":"lagni Qiishoon sun haxaaʼee isaan fudhate.","poem":2},{"lineBreak":true},{"text":"Yaa lubbuu ko, jabaadhuu fuul duratti deemi!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kotteen fardeenii guddisee didiche;","poem":1},{"text":"ni gulufan; jabeessaniis gulufan.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ergamaan Waaqayyoos, ‘Meerozin abaaraa.","poem":1},{"text":"Saba ishees jabeessaatii abaaraa;","poem":2},{"text":"akka Waaqayyo warra jajjabootti kaʼu gargaaruudhaaf,","poem":1},{"text":"isaan Waaqayyoon gargaaruudhaaf hin dhufneetii’ jedhe.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Yaaʼeel niitiin Hebeer Qeenichaa sun","poem":1},{"text":"dubartoota hunda keessaa haa eebbifamtu;","poem":2},{"lineBreak":true},{"text":"isheen dubartoota dunkaana keessa jiraatan hunda keessaa haa eebbifamtu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Inni bishaan kadhate; isheen immoo aannan kenniteef;","poem":1},{"text":"qabee ulfinaatti itittuu dhiʼeessiteef.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Harka ishee gara qofoo dunkaanaatti hiixatte;","poem":1},{"text":"harka ishee mirgaatiin burruusa fudhatte;","poem":2},{"text":"isheenis Siisaaraa dhooftee mataa isaa buruqsite;","poem":1},{"text":"waraantees illee isaa keessa fullaafte.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Innis miilla ishee jalatti gombifame;","poem":1},{"text":"kufee diriires.","poem":2},{"text":"Miilla ishee jalatti gombifame; ni kufe;","poem":1},{"text":"iddoo gombifamettis kufee duʼe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Haati Siisaaraa foddaa keessaan gad ilaalte;","poem":1},{"text":"qaawwa keessaanis iyyitee,","poem":2},{"text":"‘Gaariin isaa maaliif dhufuuf lafa irra harkifate?","poem":1},{"text":"Didichuun gaariiwwan isaa maaliif ture?’ jette.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Dubartoota ishee keessaa isheen ogeettiin deebii kenniteef;","poem":1},{"text":"taʼus isheen ofuma isheetiin deebiftee,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"‘Isaan boojuu argatanii addaan qoodachuutti jiru mitii?","poem":1},{"text":"Tokkoon tokkoon namaa dubartii tokko tokko","poem":2},{"lineBreak":true},{"text":"yookaan lama lama argata mitii?","poem":2},{"text":"Siisaaraadhaaf uffanni boojuu kan halluudhaan faayeffame,","poem":1},{"text":"uffanni halluudhaan miidhagfamee hodhame,","poem":2},{"lineBreak":true},{"text":"morma kootiif immoo uffata akka malee","poem":2},{"text":"miidhagfamee hodhame qoodu mitii?","poem":1},{"text":"Kun hundi boojuu dha.’","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Kanaafuu yaa Waaqayyo, diinonni kee hundi haa barbadaaʼani!","poem":1},{"text":"Warri si jaallatan garuu akka biiftuu,","poem":2},{"lineBreak":true},{"text":"ishee humna guutuun baatu sanaa haa taʼan.”","poem":2},"Ergasii biyyattiin waggaa afurtama nagaa argatte."]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}