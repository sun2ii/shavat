{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_bib","name":"Ermiyaas","commonName":"Ermiyaas","title":"Raajii Ermiyaas","order":24,"numberOfChapters":52,"sha256":"c0724fd0dceb470d1f8ccad4fd77ed6e806f779318036d4e9816804b25353f68","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":10,"content":[{"type":"heading","content":["Waaqayyoo fi Waaqota Tolfamoo"]},{"type":"verse","number":1,"content":["Yaa mana Israaʼel, waan Waaqayyo isiniin jedhu dhagaʼaa."]},{"type":"verse","number":2,"content":["Waaqayyo akkana jedha:",{"text":"“Isin karaa saboota ormaa hin baratinaa;","poem":1},{"text":"saboonni ormaa isaan sodaatan iyyuu","poem":2},{"lineBreak":true},{"text":"isin mallattoowwan samii hin sodaatinaa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Barteen uummattootaa faayidaa hin qabu;","poem":1},{"text":"isaan bosona keessaa muka muru;","poem":2},{"lineBreak":true},{"text":"ogeessi hojii harkaa immoo qottoodhaan bifa itti baasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isaanis meetii fi warqeedhaan miidhagsu;","poem":1},{"text":"akka inni hin sochooneef","poem":2},{"lineBreak":true},{"text":"burruusaa fi mismaaraan walitti qabsiisu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Waaqonni isaanii tolfamoon","poem":1},{"text":"akkuma fakkeettii ittiin waa sodaachisan","poem":2},{"text":"kan lafa qotiisaa buqqee keessaa sana dubbachuu hin dandaʼan;","poem":1},{"text":"isaan waan deemuu hin dandeenyeef baatamuu qabu.","poem":2},{"text":"Sababii isaan nama miidhuu","poem":1},{"text":"yookaan waan gaarii tokko iyyuu hojjechuu hin dandeenyeef","poem":2},{"lineBreak":true},{"text":"isaan hin sodaatinaa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yaa Waaqayyo kan akka keetii tokko iyyuu hin jiru;","poem":1},{"text":"ati guddaa dha;","poem":2},{"lineBreak":true},{"text":"maqaan kees humna guddaa qaba.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yaa mootii sabootaa eenyutu si hin sodaanne?","poem":1},{"text":"Kun siif ni malaatii.","poem":2},{"text":"Ogeeyyii sabootaa hunda keessaa,","poem":1},{"text":"mootummoota isaanii hunda keessaas","poem":2},{"lineBreak":true},{"text":"kan akka keetii tokko iyyuu hin jiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Isaan hundinuu qalbii hin qaban; gowwootas;","poem":1},{"text":"isaan waaqota tolfamoo mukkeenii kanneen faayidaa hin qabneen qajeelfamu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Meetiin tumame Tarshiishii,","poem":1},{"text":"warqeen immoo Uufaazii fidama.","poem":2},{"text":"Wanni ogeessi hojii mukaatii fi tumtuun warqee hojjetan,","poem":1},{"text":"wanni hojjettoota ogummaa qabaniin hojjetaman hundi","poem":2},{"lineBreak":true},{"text":"halluu cuquliisaa fi diimaa dhiilgee uffifamaniiru.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Waaqayyo garuu Waaqa dhugaa ti;","poem":1},{"text":"inni Waaqa jiraataa, Mootii bara baraa ti.","poem":2},{"text":"Yeroo inni dheekkamutti lafti ni hollatti;","poem":1},{"text":"saboonnis dheekkamsa isaa dura dhaabachuu hin dandaʼan.","poem":2}]},{"type":"verse","number":11,"content":["“Isin waan kana isaanitti himaa; ‘Waaqonni samii fi lafa hin uumin kunneen lafa irraa fi samii jalaa ni barbadaaʼu.’ ”"]},{"type":"verse","number":12,"content":[{"text":"Waaqni garuu humna isaatiin lafa uume;","poem":1},{"text":"ogummaa isaatiin addunyaa hundeesse;","poem":2},{"lineBreak":true},{"text":"hubannaa isaatiinis samiiwwan diriirse.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yommuu inni qaqawweessaʼutti bishaanonni samii ni huursu;","poem":1},{"text":"inni akka duumessoonni daarii lafaatii ol kaʼan ni godha.","poem":2},{"text":"Inni bokkaa wajjin balaqqee ni erga;","poem":1},{"text":"mankuusaalee isaa keessaa immoo bubbee ni fida.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tokkoon tokkoon namaa gowwaa fi kan beekumsa hin qabnee dha;","poem":1},{"text":"tokkoon tokkoon tumtuu warqee waaqota tolfamoo isaatiin qaaneffama.","poem":2},{"text":"Fakkiiwwan inni tolchu kan sobaa ti;","poem":1},{"text":"isaan hafuura baafatan of keessaa hin qaban.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Isaan faayidaa hin qaban; meeshaa qoosaa ti.","poem":1},{"text":"Yeroo adabbiin isaanii gaʼutti ni badu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Inni Qooda Yaaqoob taʼe sun garuu akka warra kanaa miti;","poem":1},{"text":"inni Uumaa waan hundumaa ti,","poem":2},{"text":"Israaʼel immoo gosa dhaala isaa ti;","poem":1},{"text":"maqaan isaas Waaqayyoo Waan Hunda Dandaʼuu dha.","poem":2}]},{"type":"heading","content":["Badiisa Dhufaa Jiru"]},{"type":"verse","number":17,"content":[{"text":"Ati kan marfamtee jirtu,","poem":1},{"text":"biyyattii keessaa baʼuuf qabeenya keewalitti qabadhu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Waaqayyo akkana jedhaatii;","poem":1},{"text":"“Kunoo, ani amma warra biyyattii keessa jiraatan","poem":2},{"lineBreak":true},{"text":"furguggisee nan baasa;","poem":2},{"text":"akka isaan dhiphataniifis","poem":1},{"text":"rakkina isaanitti nan fida.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Waan ani miidhameef anaaf wayyoo!","poem":1},{"text":"Madaan koo kan hin fayyinee dha!","poem":2},{"text":"Taʼus ani ofii kootiin,","poem":1},{"text":"“Kun dhukkuba koo ti; anis isa obsuun qaba” nan jedhe.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dunkaanni koo diigameera;","poem":1},{"text":"funyoon isaa hundis cicciteera.","poem":2},{"text":"Ilmaan koo na dhiisanii sokkaniiru;","poem":1},{"text":"isaan hin jiran; namni dunkaana naa dhaabu,","poem":2},{"lineBreak":true},{"text":"yookaan golgaa naa hidhu tokko iyyuu hin jiru.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Tiksoonni qalbii hin qaban;","poem":1},{"text":"Waaqayyonis hin barbaaddatan;","poem":2},{"text":"kanaafuu isaan hin milkaaʼan;","poem":1},{"text":"bushaayeen isaanii hundinuus bittinnaaʼaniiru.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kunoo, oduun, raafamni guddaan tokko","poem":1},{"text":"biyya kaabaatii dhufaa jira!","poem":2},{"text":"Innis magaalaawwan Yihuudaa onsee","poem":1},{"text":"iddoo waangoonni jiraatan godha.","poem":2}]},{"type":"heading","content":["Kadhannaa Ermiyaas"]},{"type":"verse","number":23,"content":[{"text":"Yaa Waaqayyo, ani akka jireenyi namaakan mataa isaa hin taʼin nan beeka;","poem":1},{"text":"namni adeemsa isaa ofumaan qajeelfachuu dandaʼu hin jiru.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yaa Waaqayyo dheekkamsa keetiin utuu hin taʼin,","poem":1},{"text":"murtii qajeelaadhaan na sirreessi;","poem":2},{"lineBreak":true},{"text":"yoo kanaa achii ati na balleessitaatii.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Saboota si hin beeknetti","poem":1},{"text":"uummata maqaa kee hin waammannetti","poem":2},{"lineBreak":true},{"text":"dheekkamsa kee dhangalaasi.","poem":2},{"text":"Isaan Yaaqoobin nyaataniiruutii;","poem":1},{"text":"guutumaan guutuuttis isa nyaatanii;","poem":2},{"lineBreak":true},{"text":"iddoo jireenya isaa illee barbadeessaniiru.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/JER/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JER/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JER/9.json","previousChapterAudioLinks":{},"numberOfVerses":25}