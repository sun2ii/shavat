{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_bib","name":"Ermiyaas","commonName":"Ermiyaas","title":"Raajii Ermiyaas","order":24,"numberOfChapters":52,"sha256":"c0724fd0dceb470d1f8ccad4fd77ed6e806f779318036d4e9816804b25353f68","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":12,"content":[{"type":"heading","content":["Gungummii Ermiyaas"]},{"type":"verse","number":1,"content":[{"text":"Yaa Waaqayyo yommuu ani iyyata koo fuula kee duratti dhiʼeeffadhutti","poem":1},{"text":"ati yeroo hunda qajeelaa dha.","poem":2},{"text":"Taʼu iyyuu ani waaʼee qajeelummaa keetii nan dubbadha;","poem":1},{"text":"karaan jalʼootaa maaliif milkaaʼa?","poem":2},{"lineBreak":true},{"text":"Warri hin amanamne hundi maaliif nagaan jiraatu?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ati isaan dhaabde; isaanis hidda gad fageeffataniiru;","poem":1},{"text":"ni guddatu; ijas ni naqatu.","poem":2},{"text":"Ati yeroo hunda afaan isaaniitii hin buutu;","poem":1},{"text":"garaa isaanii irraa garuu fagoo jirta.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taʼus yaa Waaqayyo ati na beekta;","poem":1},{"text":"na ilaaltees yaada ani siif qabu ni qorta.","poem":2},{"text":"Akka hoolaa qalamuuf deemuuttiharkisii isaan geessi!","poem":1},{"text":"Guyyaa qalmaatiifis kophaatti isaan baasi!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Biyyattiin hamma yoomiitti boossee","poem":1},{"text":"margi dirree hundis goga?","poem":2},{"text":"Sababii hammina warra biyyattii","poem":1},{"text":"keessa jiraataniitii fi sababii namoonni,","poem":2},{"text":"“Inni waan nurra gaʼaa jiru hin argu” jedhaniif","poem":1},{"text":"horii fi simbirroonni dhumaniiru.","poem":2}]},{"type":"heading","content":["Deebii Waaqayyoo"]},{"type":"verse","number":5,"content":[{"text":"“Ati namoota lafoo wajjin fiigdee erga","poem":1},{"text":"isaan si dadhabsiisanii,","poem":2},{"lineBreak":true},{"text":"fardeen wajjin akkamitti dorgomuu dandeessa ree?","poem":2},{"text":"Ati biyya nagaa keessatti erga gufatte,","poem":1},{"text":"bosona Yordaanos keessatti akkam taata ree?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Obboloonni kee, maatiin abbaa keetii,","poem":1},{"text":"isaan iyyuu si gananiiru;","poem":2},{"lineBreak":true},{"text":"isaan sagalee ol fudhatanii sitti iyyu.","poem":2},{"text":"Yoo isaan afaan nagaa sitti dubbatan iyyuu,","poem":1},{"text":"ati isaan hin amanin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ani mana koo dhiiseera;","poem":1},{"text":"handhuuraa koos gateera;","poem":2},{"text":"ani ishee garaan koo jaallatu sana","poem":1},{"text":"harka diinota isheetti dabarsee kenneera.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Handhuuraan koo","poem":1},{"text":"akkuma leenca bosonaa natti taateerti.","poem":2},{"text":"Isheen natti aadde;","poem":1},{"text":"kanaafuu ani ishee jibbeera.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Handhuuraan koo akka allaattii burree","poem":1},{"text":"kan allaattiiwwan biraa marsanii miidhan","poem":2},{"lineBreak":true},{"text":"tokkoo natti hin taanee?","poem":2},{"text":"Dhaqaatii bineensota bosonaa hunda walitti qabaa;","poem":1},{"text":"akka ishee nyaataniifis isaan fidaa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tiksoonni hedduun","poem":1},{"text":"iddoo dhaabaa wayinii kootii ni balleessu;","poem":2},{"text":"qooda koos ni dhidhiitu;","poem":1},{"text":"qooda natti tolus ni onsu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isaan isa onsu;","poem":1},{"text":"inni onee gara kootti iyya;","poem":2},{"text":"namni dhimma isaa qabus","poem":1},{"text":"waan hin jirreef lafti guutuun onee hafa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lafa ol kaʼaa qullaa gammoojjii","poem":1},{"text":"keessaa hunda irra balleessitoonni ni raamʼisu;","poem":2},{"text":"goraadeen Waaqayyoomoggaa biyyattii tokko irraa","poem":1},{"text":"hamma moggaa kaaniitti ni fixaatii;","poem":2},{"lineBreak":true},{"text":"namni tokko iyyuu hin hafu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Isaan qamadii facaasu garuu qoraatii haammatu;","poem":1},{"text":"ni dhamaʼu garuu homaa hin argatan.","poem":2},{"text":"Sababii dheekkamsa Waaqayyoo isa cimaa sanaatiif","poem":1},{"text":"midhaan galfatanitti ni qaanaʼu.”","poem":2}]},{"type":"verse","number":14,"content":["Waaqayyo akkana jedha; “Ani olloota koo hamoo kanneen handhuuraa ani saba koo Israaʼeliif kenne qabatan hunda biyya isaanii keessaa nan buqqisa; mana Yihuudaas isaan gidduudhaa nan buqqisa."]},{"type":"verse","number":15,"content":["Ani ergan isaan buqqisee booddee deebiʼee naʼeefii tokkoo tokkoo isaanii gara handhuuraa isaaniitii fi gara biyya ofii isaaniitti nan deebisa."]},{"type":"verse","number":16,"content":["Yoo isaan haala jireenya saba koo akka gaarii baratanii akkuma duraan saba koo Baʼaaliin kakachuu barsiisan sana, ‘Dhugaa Waaqayyo jiraataa’ jechuudhaan maqaa kootiin kakatan, isaan saba koo gidduutti ni hundeeffamu."]},{"type":"verse","number":17,"content":["Garuu yoo sabni kam iyyuu naa ajajamuu dide, ani guutumaan guutuutti isa nan buqqisa; nan balleessas” jedha Waaqayyo."]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/JER/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JER/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JER/11.json","previousChapterAudioLinks":{},"numberOfVerses":17}