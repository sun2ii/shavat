{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_bib","name":"Ermiyaas","commonName":"Ermiyaas","title":"Raajii Ermiyaas","order":24,"numberOfChapters":52,"sha256":"c0724fd0dceb470d1f8ccad4fd77ed6e806f779318036d4e9816804b25353f68","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":2,"content":[{"type":"heading","content":["Israaʼel Waaqa Gante"]},{"type":"verse","number":1,"content":["Dubbiin Waaqayyoo akkana jedhee gara koo dhufe;"]},{"type":"verse","number":2,"content":["“Dhaqiitii gurra Yerusaalemiitti akkana jedhii labsi:",{"lineBreak":true},"“Waaqayyo akkana jedha:",{"text":"“ ‘Ani amanamummaa kee kan yeroo dargaggummaa,","poem":1},{"text":"akka ati akkuma misirrittiitti na jaallattee","poem":2},{"text":"lafa gammoojjii keessa,","poem":1},{"text":"lafa midhaan itti hin facaafamin keessa na duukaa buutenan yaadadha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Israaʼel kan Waaqayyoof qulqulloofte sun,","poem":1},{"text":"mataa midhaan isaa turte;","poem":2},{"text":"warri ishee nyaatan hundis","poem":1},{"text":"akka nama yakka hojjeteetti ilaalamu ture;","poem":2},{"lineBreak":true},{"text":"badiisnis isaanitti dhufe’ ” jedha Waaqayyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yaa mana Yaaqoob,","poem":1},{"text":"isin maatiiwwan mana Israaʼel hundinuusdubbii Waaqayyoo dhagaʼaa.","poem":2}]},{"type":"verse","number":5,"content":["Waaqayyo akkana jedha:",{"text":"“Abbootiin keessan kan akkas narraa fagaatan","poem":1},{"text":"balleessaa maalii narratti arganiitii?","poem":2},{"text":"Isaan waaqota tolfamoo faayidaa hin qabne faana buʼanii","poem":1},{"text":"isaanumtuu warra faayidaa hin qabne taʼan.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isaanis, ‘Waaqayyo inni Gibxii nu baasee,","poem":1},{"text":"gammoojjii homtuu keessa hin jirre keessaan,","poem":2},{"text":"lafa gammoojjii fi dhooqaa keessaan","poem":1},{"text":"lafa hongee fi dukkanaa,","poem":2},{"text":"biyya namni tokko iyyuu keessa hin dabarree fi","poem":1},{"text":"keessa hin jiraanne keessaan dabarsee","poem":2},{"lineBreak":true},{"text":"nu fide sun eessa jira?’ jedhanii hin gaafanne.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ani akka isin ija ishee nyaattanii midhaan isheetti gammaddaniif","poem":1},{"text":"gara lafa gabbataatti isin fideera.","poem":2},{"text":"Isin garuu dhuftanii biyya koo xureessitan;","poem":1},{"text":"handhuuraa koos akka jibbamu gootan.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Luboonnis, ‘Waaqayyo eessa jira?’","poem":1},{"text":"jedhanii hin gaafanne.","poem":2},{"text":"Warri seera wajjin oolanis na hin beekne;","poem":1},{"text":"bulchitoonni natti fincilan;","poem":2},{"text":"raajonnis waaqota faayidaa hin qabne duukaa buʼanii","poem":1},{"text":"maqaa Baʼaaliin raajii dubbatan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Kanaafuu ani amma iyyuu isin wajjin falmii qaba”","poem":1},{"text":"jedha Waaqayyo.","poem":2},{"lineBreak":true},{"text":"“Ijoollee ijoollee keessanii wajjinis falmii nan qabaadha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mee gara qarqara Kitiimitti ceʼaatii ilaalaa;","poem":1},{"text":"gara Qeedaarittis nama ergaatii qalbiidhaan qoradhaa;","poem":2},{"lineBreak":true},{"text":"yoo duraan wanni akkasii taʼee jiraates ilaalaa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yoo isaan waaqota taʼuu baatan iyyuu","poem":1},{"text":"sabni tokko takkumaa waaqota isaa geeddaree beekaa?","poem":2},{"text":"Uummanni koo garuu","poem":1},{"text":"ulfina isaa waaqota tolfamoofaayidaa hin qabneen geeddareera.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yaa samiiwwan, waan kana dinqifadhaa;","poem":1},{"text":"naasuu guddaadhaanis holladhaa”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Uummanni koo cubbuu lama hojjete:","poem":1},{"lineBreak":true},{"text":"Isaan ana burqaa bishaan jireenyaa dhiisanii","poem":1},{"text":"boolla bishaanii ofii isaanii,","poem":2},{"text":"boolla bishaanii baqaqaa","poem":1},{"text":"bishaan qabachuu hin dandeenye qotataniiru.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Israaʼel garbaa? Inni garbicha manatti dhalatee?","poem":1},{"text":"Yoos inni maaliif boojiʼame ree?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Leenconni aadaniiru;","poem":1},{"text":"isattis gururiʼaniiru.","poem":2},{"text":"Isaan biyya isaa onsaniiru;","poem":1},{"text":"magaalaawwan isaas gubamanii duwwaa hafaniiru.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Akkasumas namoonni Memfiisii fi","poem":1},{"text":"Tahiphaanhees mataa kee buruqsaniiru.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ati yeroo inni karaa irra si qajeelchetti,","poem":1},{"text":"Waaqayyoon Waaqa kee dhiisuudhaan","poem":2},{"lineBreak":true},{"text":"waan kana ofitti fiddeerta mitii?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Egaa ati maaliif Shihoorii bishaan dhuguuf jettee","poem":1},{"text":"biyya Gibxi dhaqxa?","poem":2},{"text":"Maaliifis bishaan laga Efraaxiis","poem":1},{"text":"dhuguuf jettee Asoor dhaqxa?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hamminni kee si adaba;","poem":1},{"text":"duubatti deebiʼuun kees si ifata.","poem":2},{"text":"Ati Waaqayyoon Waaqa kee dhiiftee","poem":1},{"text":"na sodaachuu diduun kee","poem":2},{"text":"hammam hamaa fi hadhaaʼaa akka sitti taʼe ilaalii hubadhu”","poem":1},{"text":"jedha Gooftaan, Waaqayyoon Waan Hunda Dandaʼu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Ani bara dheeraan dura waanjoo kee sirraa cabseera;","poem":1},{"text":"hidhaa kees sirraa kukkuteera.","poem":2},{"lineBreak":true},{"text":"Ati garuu, ‘Ani si hin tajaajilu’ jette!","poem":2},{"text":"Ati garuu akkuma sagaagaltuu tokkootti","poem":1},{"text":"tulluuwwan dhedheeroo hunda irraa fi","poem":2},{"lineBreak":true},{"text":"mukkeen lalisoo hunda jala ciifte.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ani garuu muka wayinii filatamaa,","poem":1},{"text":"kan sanyiin isaa guutumaan guutuutti qulqulluu taʼe godheesi dhaabbadheen ture.","poem":2},{"text":"Yoos ati akkamitti wayinii diidaa","poem":1},{"text":"taatee natti geeddaramte ree?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ati yoo daaraadhaan dhiqattee","poem":1},{"text":"saamunaa hedduutti fayyadamte iyyuu,","poem":2},{"lineBreak":true},{"text":"xuriin yakka keetii amma illee fuula koo dura jira”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo Gooftaan.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"“Ati akkamitti, ‘Ani hin xuroofne;","poem":1},{"text":"Baʼaal duukaas hin buune’ jechuu dandeessa?","poem":2},{"text":"Waan sulula keessatti taʼaa turte yaadadhu;","poem":1},{"text":"waan hojjechaa turtes qalbeeffadhu.","poem":2},{"text":"Ati gaala dhalaa asii fi","poem":1},{"text":"achi fiigduu dha;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"harree diidaa kan gammoojjii barattee","poem":1},{"text":"fedhii kormaatiin qilleensa suufattu tokko,","poem":2},{"lineBreak":true},{"text":"maaltu fedhii ishee irraa ishee deebisuu dandaʼa?","poem":2},{"text":"Kormi ishee barbaadu kam iyyuu ishee argachuuf hin rakkatu;","poem":1},{"text":"inni yeroo gaanaatti ishee argata.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Miilla kee kophee malee deemuu irraa,","poem":1},{"text":"laagaa kee immoo dheebuu irraa eeggadhu.","poem":2},{"text":"Ati garuu, ‘Kun waan abdii hin qabnee dha!","poem":1},{"text":"Ani waaqota ormaa nan jaalladha;","poem":2},{"lineBreak":true},{"text":"isaan faanas nan buʼa’ jette.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Akkuma hattuun yeroo qabamtu salphifamtu sana","poem":1},{"text":"manni Israaʼel ni salphifama;","poem":2},{"text":"isaan, mootonni isaaniitii fi qondaaltonni isaanii,","poem":1},{"text":"luboonni isaaniitii fi raajonni isaanii ni salphifamu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Isaan mukaan, ‘Ati abbaa koo ti,’","poem":1},{"text":"dhagaadhaan immoo, ‘Situ na dhale’ jedhu.","poem":2},{"text":"Isaan dugda isaanii malee","poem":1},{"text":"fuula isaanii natti hin deebifanneetii;","poem":2},{"text":"taʼus isaan yeroo rakkatanitti,","poem":1},{"text":"‘Kottuu nu baasi!’ jedhu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Waaqonni ati ofiif tolfatte sun eessa jiru?","poem":1},{"text":"Isaan yoo si baasuu dandaʼan","poem":2},{"lineBreak":true},{"text":"mee yeroo ati rakkina keessa jirtutti haa dhufan!","poem":2},{"text":"Yaa Yihuudaa, ati akkuma magaalaa hedduu qabdu sana","poem":1},{"text":"waaqota hedduu qabdaatii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Isin maaliif na himattu?","poem":1},{"text":"Isin hundinuu natti finciltaniirtu”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"“Ani akkasumaanan ijoollee keessan adabe;","poem":1},{"text":"isaan sirreeffama fudhachuu didan.","poem":2},{"text":"Goraadeen keessan akkuma","poem":1},{"text":"leenca beelaʼe tokkootti raajota keessan fixxe.","poem":2}]},{"type":"verse","number":31,"content":["“Isin dhaloonni ammaa dubbii Waaqayyoo qalbeeffadhaa:",{"text":"“Ani Israaʼeliif gammoojjii","poem":1},{"text":"yookaan biyya dukkana hamaan turee?","poem":2},{"text":"Sabni koo maaliif, ‘Nu asii fi achi jooruu ni dandeenya;","poem":1},{"text":"siʼachi gara kee hin dhufnu’ jedha?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Durbi tokko faaya ishee,","poem":1},{"text":"misirrittiin tokko immoo miʼa ittiin heerumtu ni irraanfattii?","poem":2},{"text":"Sabni koo garuu,","poem":1},{"text":"guyyaa hamma hin qabne na irraanfateera.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ati jaalala adamsuutti akkam ogeettii dha!","poem":1},{"text":"Dubartoota akka malee hamoo taʼan iyyuu amala kee barsiifteerta.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ati utuu isaan cabsanii seenanuu isaan qabuu baattu iyyuu,","poem":1},{"text":"dhiigni hiyyeeyyii balleessaa hin qabnee","poem":2},{"lineBreak":true},{"text":"wayyaa kee irratti ni argama.","poem":2},{"text":"Utuma wanni kun hundi taʼee jiruu","poem":1}]},{"type":"verse","number":35,"content":[{"text":"ati, ‘Ani balleessaa hin qabu;","poem":2},{"lineBreak":true},{"text":"inni natti hin dheekkamu’ jetta.","poem":2},{"text":"Ani garuu sababii ati, ‘Ani cubbuu","poem":1},{"text":"hin hojjenne’ jettuuf, sitti nan mura.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ati maaliif karaa kee geeddaruudhaan,","poem":1},{"text":"asii fi achi deemuu baayʼifta?","poem":2},{"text":"Akkuma Asoor si qaanessite sana","poem":1},{"text":"Gibxis si qaanessiti.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Ati mataa kee qabattee,","poem":1},{"text":"iddoo sanaa baata;","poem":2},{"text":"Waaqayyo warra ati itti irkatte tuffateeraatii;","poem":1},{"text":"ati isaaniin hin milkooftu.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/JER/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JER/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JER/1.json","previousChapterAudioLinks":{},"numberOfVerses":37}