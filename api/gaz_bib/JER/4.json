{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_bib","name":"Ermiyaas","commonName":"Ermiyaas","title":"Raajii Ermiyaas","order":24,"numberOfChapters":52,"sha256":"c0724fd0dceb470d1f8ccad4fd77ed6e806f779318036d4e9816804b25353f68","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"“Yaa Israaʼel, ati yoo deebite,","poem":1},{"text":"gara kootti deebiʼi” jedha Waaqayyo.","poem":2},{"text":"“Yoo ati waaqota kee jibbisiisoo sanafuula koo duraa balleessitee","poem":1},{"text":"siʼachi karaa irraa jalʼachuu baatte,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"yoo ati, ‘Dhugaa Waaqayyo jiraataa’ jettee","poem":1},{"text":"dhugaadhaan, murtii qajeelaa fi qajeelummaadhaan kakatte,","poem":2},{"text":"saboonni isaan ni eebbifamu;","poem":1},{"text":"isumaanis ni kabajamu.”","poem":2}]},{"type":"verse","number":3,"content":["Waaqayyo namoota Yihuudaatii fi namoota Yerusaalemiin akkana jedha:",{"text":"“Bajjii keessan qotadhaa;","poem":1},{"text":"qoraattii keessas hin facaasinaa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yaa namoota Yihuudaatii fi uummata Yerusaalem","poem":1},{"text":"Waaqayyoof dhagna of qabaa;","poem":2},{"lineBreak":true},{"text":"qola qalbii keessaniis dhagna qabadhaa;","poem":2},{"text":"yoo kanaa achii sababii hammina isin hojjetaniitiif","poem":1},{"text":"dheekkamsi koo kaʼee akka ibiddaa ni bobaʼa;","poem":2},{"lineBreak":true},{"text":"namni isa dhaamsus hin jiru.","poem":2}]},{"type":"heading","content":["Balaa Kaaba irraa Dhufu"]},{"type":"verse","number":5,"content":[{"text":"“Yihuudaa keessatti beeksisaa;Yerusaalem keessattis akkana jedhaa labsaa:","poem":1},{"text":"‘Biyyattii guutuu keessatti malakata afuufaa!","poem":2},{"text":"Sagalee ol fudhadhaatii akkana jedhaa:","poem":1},{"text":"walitti qabamaa!","poem":2},{"lineBreak":true},{"text":"Kottaa gara magaalaawwan dallaa jabaa qabaniitti baqannaa!’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xiyoon dhaquuf faajjii ol qabaa?","poem":1},{"text":"Dafaa baqadhaa malee duubatti hin harkifatinaa!","poem":2},{"text":"Ani karaa kaabaatiin balaa,","poem":1},{"text":"badiisa suukaneessaas nan fidaatii.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Leenci bosona isaatii baʼeera;","poem":1},{"text":"barbadeessaan sabootaa karaa qabateera.","poem":2},{"text":"Inni biyya kee onsuuf jedhee","poem":1},{"text":"iddoo isaatii kaʼeera.","poem":2},{"text":"Magaalaawwan kee onanii","poem":1},{"text":"jiraattota malee ni hafu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kanaafuu isin uffata gaddaa uffadhaatii","poem":1},{"text":"booʼaa wawwaadhaa;","poem":2},{"text":"dheekkamsi Waaqayyoo sodaachisaan sun","poem":1},{"text":"nurraa hin deebineetii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Waaqayyo akkana jedha:","poem":1},{"text":"“Guyyaa sana mootiinii fi qondaaltonni onnee dhabu;","poem":2},{"text":"luboonni akka malee naʼu;","poem":1},{"text":"raajonnis ni raafamu.”","poem":2}]},{"type":"verse","number":10,"content":["Anis akkana nan jedhe; “Yaa Waaqayyo Gooftaa, ati utuu goraadeen kokkee keenya irra jiruu, ‘Isin nagaa qabaattu’ jechuudhaan saba kanaa fi Yerusaalemin guutumaan guutuutti gowwoomsiteerta?”"]},{"type":"verse","number":11,"content":["Yeroo sanatti saba kanaa fi Yerusaalemitti akkana jedhamee ni himama; “Bubbeen waa gubu tokko iddoowwan ol kaʼoo qullaa kanneen gammoojjii keessaa irraa gara saba kootiitti ni bubbisa; garuu afarsuuf yookaan qulqulleessuuf miti;"]},{"type":"verse","number":12,"content":["bubbeen waan sanaaf akka malee cimaa taʼe tokko na biraa ni dhufa. Anis murtii koo isaanitti nan labsa.”"]},{"type":"verse","number":13,"content":[{"text":"Kunoo, inni akka duumessaatti,","poem":1},{"text":"gaariin isaas akka bubbeetti ni dhufa;","poem":2},{"text":"fardeen isaa risaa caalaa saffisu.","poem":1},{"text":"Wayyoo nu baduu keenya!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yaa Yerusaalem, ati akka fayyituufqalbii kee keessaa hammina dhiqadhu.","poem":1},{"text":"Hamma yoomiitti yaadni hamaan si keessa jiraata?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Sagaleen tokko Daan irraa lallaba;","poem":1},{"text":"tulluuwwan Efreem irraas badiisa labsa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Waan kana sabootatti himaa;","poem":1},{"text":"Yerusaalemittis akkana jedhaa lallabaa:","poem":2},{"text":"‘Loltoonni marsanii biyya qabatan tokkolafa fagoodhaa ni dhufu;","poem":1},{"text":"isaanis magaalaawwan Yihuudaatti ni iyyu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sababii isheen natti fincilteef,","poem":1},{"text":"isaan akkuma nama lafa qotiisaa eegu tokkoottiishee ni marsu,’ ”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Amalli keetii fi hojiin kee","poem":1},{"text":"waan kana sitti fidaniiru.","poem":2},{"text":"Adabbiin kee kanaa dha.","poem":1},{"text":"Innis hammam hadhaaʼa!","poem":2},{"lineBreak":true},{"text":"Onnees hammam waraana!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Marʼumaan ko, marʼumaan ko!","poem":1},{"text":"Ani dhukkubbiidhaan nan wixxirfadha.","poem":2},{"text":"Onneen koo na keessaa waca;","poem":1},{"text":"onneen koo na keessatti dhaʼata;","poem":2},{"lineBreak":true},{"text":"ani calʼisuu hin dandaʼu.","poem":2},{"text":"Ani sagalee malakataa dhagaʼeeraatii;","poem":1},{"text":"waca waraanaas dhagaʼeera.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Badiisni badiisa irraan dhufa;","poem":1},{"text":"biyyattiin guutumaan guutuutti ni onti.","poem":2},{"text":"Dunkaanni koo akkuma tasaa,","poem":1},{"text":"golgaan koos yeroo gabaabaa keessatti bade.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ani hamma yoomiittin mallattoo waraanaa ilaala?","poem":1},{"text":"Hamma yoomiittis sagalee malakataa dhagaʼa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Uummanni koo gowwaa dha;","poem":1},{"text":"anas hin beekan.","poem":2},{"text":"Isaan ijoollee qalbii hin qabnee dha;","poem":1},{"text":"hubannaas hin qaban.","poem":2},{"text":"Isaan waan hamaa hojjechuutti ogeeyyii dha;","poem":1},{"text":"waan gaarii hojjechuu garuu hin beekan.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ani lafa nan ilaale;","poem":1},{"text":"isheenis bifa hin qabdu; duwwaas turte;","poem":2},{"text":"samiiwwanis nan ilaale;","poem":1},{"text":"ifni isaanii dhaamee ture.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ani tulluuwwan nan ilaale;","poem":1},{"text":"isaan sochoʼaa turan;","poem":2},{"lineBreak":true},{"text":"gaarran hundinuus raafamaa turan.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ani nan ilaale; namni tokko iyyuu hin turre;","poem":1},{"text":"simbirroonni samii hundis barrisanii badanii turan.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ani nan ilaale; kunoo biyyi midhaan baaftu ontee turte;","poem":1},{"text":"magaalaawwan ishee hundis,fuula Waaqayyoo duratti","poem":2},{"lineBreak":true},{"text":"dheekkamsa isaa sodaachisaa sanaan diigaman.","poem":2}]},{"type":"verse","number":27,"content":["Waaqayyo akkana jedha:",{"text":"“Yoo ani guutumaan guutuutti ishee balleessuu baadhe iyyuu","poem":1},{"text":"biyyattiin guutumaan guutuutti ni barbadoofti.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kanaafuu lafti ni boossi;","poem":1},{"text":"samiiwwan oliis ni dukkanaaʼu;","poem":2},{"text":"ani dubbadheeraatii hin gaabbu;","poem":1},{"text":"murteesseera; dugda duubas hin deebiʼu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Sababii iyya abbootii fardeeniitii fi futtaaftota xiyyaatiin,","poem":1},{"text":"tokkoon tokkoon magaalaa ni baqata.","poem":2},{"text":"Garri tokko bosona gobbuu seena;","poem":1},{"text":"kaan immoo kattaatti ol baʼa;","poem":2},{"text":"magaalaawwan hundi duwwaa hafaniiru;","poem":1},{"text":"namni tokko iyyuu isaan keessa hin jiraatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Yaa ontuu nana, ati maal gochaa jirta?","poem":1},{"text":"Ati maaliif wayyaa bildiimaa uffattee","poem":2},{"lineBreak":true},{"text":"faaya warqee kaaʼatte?","poem":2},{"text":"Maaliif ija kee kuulatte?","poem":1},{"text":"Ati akkasumaan of miidhagsita.","poem":2},{"text":"Warri jaallatan si tuffatu;","poem":1},{"text":"lubbuu kees balleessuu barbaadu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Ani iyya akka iyya dubartii ciniinsifattu tokkoo,","poem":1},{"text":"miixuu akka miixuu dubartii mucaa","poem":2},{"lineBreak":true},{"text":"hangafa deessuu tokko nan dhagaʼe;","poem":2},{"text":"ani iyya Intala Xiyoon kan yeroo hafuurri ishee citutti argantee","poem":1},{"text":"harka ishee facaasuudhaan,","poem":2},{"text":"“Wayyoo! Ani bade;","poem":1},{"text":"lubbuun koo harka warra nama ajjeesuutti","poem":2},{"lineBreak":true},{"text":"dabarfamtee kennamteerti” jettuu nan dhagaʼe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/JER/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JER/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JER/3.json","previousChapterAudioLinks":{},"numberOfVerses":31}