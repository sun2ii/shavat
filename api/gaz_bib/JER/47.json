{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_bib","name":"Ermiyaas","commonName":"Ermiyaas","title":"Raajii Ermiyaas","order":24,"numberOfChapters":52,"sha256":"c0724fd0dceb470d1f8ccad4fd77ed6e806f779318036d4e9816804b25353f68","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":47,"content":[{"type":"heading","content":["Ergaa Waaʼee Filisxeemotaa"]},{"type":"verse","number":1,"content":["Dubbiin Waaqayyoo kan waaʼee Filisxeemotaa kan utuu Faraʼoon Gaazaa hin dhaʼin dura gara Ermiyaas raajichaa dhufe kanaa dha:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["Waaqayyo akkana jedha:",{"text":"“Kunoo, karaa kaabaatiin bishaan ol kaʼaa jira;","poem":1},{"text":"bishaan kunis lolaa guutee irra dhangalaʼu taʼa.","poem":2},{"text":"Innis biyyattii fi waan ishee keessa jiru,","poem":1},{"text":"magaalaawwanii fi warra isaan keessa jiraatan hunda irra garagala.","poem":2},{"text":"Uummanni ni booʼa;","poem":1},{"text":"warri ishee keessa jiraatan hundis ni wawwaatu;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"kunis sababii didicha kottee fardeen gulufanii,","poem":1},{"text":"girrisa gaariiwwan diinaatii fi","poem":2},{"lineBreak":true},{"text":"qaqawweessa goommaa isaaniitiif.","poem":2},{"text":"Abbootiin ijoollee isaanii gargaaruuf duubatti gara hin galan;","poem":1},{"text":"harki isaaniis isaan irratti laamshaʼa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Filisxeemota hunda balleessuuf","poem":1},{"text":"hambaa Xiiroosii fi Siidoonaa","poem":2},{"text":"gargaaruuf hafan hundas balleessuuf","poem":1},{"text":"guyyaan sun dhufeeraatii.","poem":2},{"text":"Waaqayyo Filisxeemota,","poem":1},{"text":"hambaa qarqara Kaftoor balleessuu gaʼeera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gaazaan gaddaan mataa ishee haaddatti;","poem":1},{"text":"Ashqaloon ni calʼisti.","poem":2},{"text":"Yaa hambaa dirree irraa","poem":1},{"text":"isin hamma yoomiitti of ciccirtu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Isin, ‘Yaa goraadee Waaqayyoo","poem":1},{"text":"ati hamma yoomiitti hin boqonne?","poem":2},{"text":"Manʼee keetti deebiʼi;","poem":1},{"text":"calʼisii taaʼi’ jettanii iyyitu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Garuu utuu Waaqayyo isa ajajuu,","poem":1},{"text":"yeroo Waaqni akka inni Ashqaloonii fi","poem":2},{"text":"qarqara galaanaa dhaʼuuf qajeelfama isaa kennutti","poem":1},{"text":"inni akkamitti boqochuu dandaʼa?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}