{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_bib","name":"Ermiyaas","commonName":"Ermiyaas","title":"Raajii Ermiyaas","order":24,"numberOfChapters":52,"sha256":"c0724fd0dceb470d1f8ccad4fd77ed6e806f779318036d4e9816804b25353f68","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":48,"content":[{"type":"heading","content":["Ergaa Waaʼee Moʼaab"]},{"type":"verse","number":1,"content":["Waaʼee Moʼaab:",{"lineBreak":true},"Waaqayyo Waan Hunda Dandaʼu, Waaqni Israaʼel akkana jedha:",{"text":"“Neboof wayyoo; isheen ni diigamtiitii.","poem":1},{"text":"Kiriyaataayimis ni salphatti; ni qabamti;","poem":2},{"lineBreak":true},{"text":"daʼoowwan ishees ni qaaneffamu; ni diigamus.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Moʼaab siʼachi hin jajamtu;","poem":1},{"text":"namoonni Heshboon keessatti,","poem":2},{"lineBreak":true},{"text":"‘Kottaa saba sana ni balleessinaa’jedhanii waaʼee kufaatii ishee mariʼatu.","poem":2},{"text":"Yaa magaalaa Maadmeen jedhamtu atis ni calʼista;","poem":1},{"text":"goraadeen si ariʼaatii.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iyya Hooronaayimii dhufu,","poem":1},{"text":"iyya barbadaaʼuu fi badiisaa guddaa dhagaʼaa!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Moʼaab ni cabdi;","poem":1},{"text":"ijoolleen ishees ni booʼu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isaan akka malee booʼaa,","poem":1},{"text":"Luuhiitiitti ol baʼu;","poem":2},{"text":"karaa gara Hooronaayimitti gad buusu irratti","poem":1},{"text":"iyya badiisaa dhagaʼu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Baqadhaa! Lubbuu keessan baafadhaa;","poem":1},{"text":"akka daggala gammoojjii keessaa taʼaa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Isin waan hojii keessanii fi qabeenya keessan amanattaniif,","poem":1},{"text":"boojuudhaan fudhatamtanii ni deemtu;","poem":2},{"text":"Kemooshis luboota isaatii fi","poem":1},{"text":"qondaaltota isaa wajjin boojiʼamee ni fudhatama.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Balleessituun sun magaalaa hundatti ni dhufa;","poem":1},{"text":"magaalaan tokko iyyuu isa jalaa hin baʼu.","poem":2},{"text":"Sababii Waaqayyo dubbateef sululli ni bada;","poem":1},{"text":"dirreenis ni barbadeeffama.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Moʼaabitti soogidda firfirsi;","poem":1},{"text":"isheen ni baddiitii;","poem":2},{"text":"magaalaawwan ishees","poem":1},{"text":"nama isaan keessa jiraatu dhabanii onu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Namni garaa hirʼuudhaan hojii Waaqayyoo hojjetu abaaramaa haa taʼu!","poem":1},{"text":"Namni goraadee isaatiin dhiiga dhangalaasuu didus abaaramaa haa taʼu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Moʼaab akkuma daadhii wayinii kan siicoo isaa irratti hafe","poem":1},{"text":"kan okkotee tokko keessaa gara okkotee kaaniitti gara hin galfaminii","poem":2},{"text":"ijoollummaa isheetii jalqabdee boqochaa turte;","poem":1},{"text":"boojiʼamtees hin fudhatamne.","poem":2},{"text":"Kanaafuu isheen akkuma durii miʼoofti;","poem":1},{"text":"urgaan ishees hin geeddaramne.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Garuu barri ani itti namoota okkotee keessaa dhangalaasanergu tokko ni dhufa.","poem":1},{"lineBreak":true},{"text":"Isaanis gad ishee naqu;","poem":1},{"text":"okkotee ishee duwwaa hambisanii","poem":2},{"lineBreak":true},{"text":"gaanii ishee cabsu” jedha Waaqayyo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Yoos akkuma manni Israaʼel","poem":1},{"text":"yeroo Beetʼeelin amanatetti qaanaʼe sana","poem":2},{"lineBreak":true},{"text":"Moʼaabis Kemooshitti ni qaanaʼa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Isin akkamiin ‘Nu gootota;","poem":1},{"text":"nu waraana keessatti jajjaboo dha’ jechuu dandeessu?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Moʼaab ni barbadoofti; magaalaawwan ishees ni qabatamu;","poem":1},{"text":"dargaggoonni ishee filatamoon gara qalmaatti geeffamu”","poem":2},{"lineBreak":true},{"text":"jedha Mootichi maqaan isaa Waaqayyoo Waan Hunda Dandaʼu jedhamu sun.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Kufaatiin Moʼaab gaʼeera;","poem":1},{"text":"badiisni ishees dafee ni dhufa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Warri naannoo ishee jiraatan hundi,","poem":1},{"text":"warri maqaa ishee beektan hundi","poem":2},{"text":"‘Bokkuun jabaan sun akkamitti cabe!","poem":1},{"text":"Uleen ulfina qabeessi sun akkamitti cabe!’ jedhaa booʼaafii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Yaa jiraattuu Diiboon,","poem":1},{"text":"ulfina kee irraa gad buʼiitii","poem":2},{"lineBreak":true},{"text":"lafa goggogaa irra taaʼi!","poem":2},{"text":"Barbadeessaan Moʼaab sun sitti dhufee","poem":1},{"text":"magaalaawwan kee kanneen","poem":2},{"lineBreak":true},{"text":"dallaa jabaan marfaman ni diigaatii.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ati kan Aroʼeer keessa jiraattu,","poem":1},{"text":"karaa cina dhaabadhuutii ilaali.","poem":2},{"text":"Dhiira baqatuu fi dubartii miliqxu gaafadhu;","poem":1},{"text":"‘Maaltu dhalate?’ jedhii isaan gaafadhu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Moʼaab waan diigamteef qaanofteerti.","poem":1},{"text":"Wawwaadhuu booʼi!","poem":2},{"text":"Arnoon biratti","poem":1},{"text":"akka Moʼaab barbadooftee jirtu labsi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Murtiin dirree ol kaʼaatti:","poem":1},{"text":"Hooloonitti, Yaahizaa fi Meefiʼaatti,","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Diiboonitti, Neboo fi Beet Diblaataayimitti,","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Kiriyaataayimitti, Beet Gaamulii fi Beet Meʼoonitti,","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Keriiyoottii fi Bozraatti,","poem":2},{"lineBreak":true},{"text":"magaalaawwan Moʼaab kanneen fagoo fidhiʼoo jiran hundatti dhufeera.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Gaanfi Moʼaab irraa murameera;","poem":1},{"text":"irreen ishees caccabeera”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Waan isheen Waaqayyotti koorteef","poem":1},{"text":"dhugaatiidhaan ishee macheessaa.","poem":2},{"text":"Moʼaab diddiga ofii ishee irra haa gangalattu;","poem":1},{"text":"waan qoosaas haa taatu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Israaʼel si duratti waan qoosaa hin turree?","poem":1},{"text":"Akka ati yeroo waaʼee ishee dubbattu hunda","poem":2},{"text":"tuffiidhaan mataa kee isheetti raaftuuf","poem":1},{"text":"isheen hattoota gidduutti qabamtee?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Isin warri Moʼaab keessa jiraattan,","poem":1},{"text":"magaalaawwan keessan keessaa baʼaatii kattaawwan keessa jiraadhaa.","poem":2},{"text":"Akkuma gugee mana ishee","poem":1},{"text":"afaan holqaatti ijaarrattuu taʼa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Nu waaʼee of tuulummaa Moʼaab","poem":1},{"text":"jechuunis akka malee of guddisuu fi ofiin boonuu ishee,","poem":2},{"text":"of tuuluu fi of jajuu ishee,","poem":1},{"text":"of bokoksuu ishee dhageenyeerra.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ani addaggummaa Moʼaab beeka;garuu faayidaa hin qabaatu” jedha Waaqayyo;","poem":1},{"text":"“Of tuuluun ishees homaa hin fayyaduuf”","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kanaafuu ani Moʼaabiif nan wawwaadha;","poem":1},{"text":"Moʼaab hundaaf hiqqifadhee booʼa;","poem":2},{"lineBreak":true},{"text":"ani namoota Qiir Hareeshetiif nan gadda.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Yaa muka wayinii Sibimaa,","poem":1},{"text":"ani akkuma Yaʼizeeriif booʼu sana siifin booʼa.","poem":2},{"text":"Dameen kee hamma galaanaatti diriirtee fagaatte;","poem":1},{"text":"isheen hamma galaana Yaʼizeeritti diriirtee deemti.","poem":2},{"text":"Balleessituun sun ija kee bilchaataa fi","poem":1},{"text":"hurbuu wayinii keetii irra buʼeera.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Lafa biqiltuutii fi lafa qotiisaa","poem":1},{"text":"midhaan Moʼaab keessaa ilillee fi gammachuun badeera.","poem":2},{"text":"Ani iddoo itti wayinii cuunfan irraa wayinii kuteera;","poem":1},{"text":"namni tokko iyyuu gammadaa sirbee isaan hin cuunfu.","poem":2},{"text":"Wacni yoo jiraatee illee","poem":1},{"text":"inni waca gammachuu miti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Sababii bishaan Niimriim gogeef,","poem":1},{"text":"sagaleen iyya isaanii ol kaʼee,","poem":2},{"text":"Heshboonii hamma Eleʼaaleettii fi Yaahaziitti,","poem":1},{"text":"Zoʼaarii hamma Hooronaayimittii fi hamma Eglaati Sheelishiyaattini dhagaʼama ture.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ani warra iddoowwan sagadaa kanneen gaarran irraatti","poem":1},{"text":"aarsaa dhiʼeessanii waaqota isaaniif ixaana aarsan","poem":2},{"lineBreak":true},{"text":"Moʼaab keessaa nan balleessa” jedha Waaqayyo.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"“Kanaafuu garaan koo akkuma ulullee faarsee Moʼaabiif booʼa;","poem":1},{"text":"akkuma ulullee faarsee namoota Qiir Hareeshetiif booʼa.","poem":2},{"lineBreak":true},{"text":"Qabeenyi isaan horatan duraa badeera.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Mataan hundinuu haadamee","poem":1},{"text":"hareedni hundinuu cirameera;","poem":2},{"text":"harki hundinuu muramee mudhiin hundis","poem":1},{"text":"wayyaa gaddaatiin hidhameera.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Waan ani akkuma okkotee namni tokko iyyuu hin feeneetti","poem":1},{"text":"Moʼaabin caccabseef","poem":2},{"text":"bantii mana Moʼaab hunda irraa fi oobdii sabaa keessa","poem":1},{"text":"booʼicha malee wanni tokko iyyuu hin jiru”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"“Isheen akkam akkas caccabde! Isaan akkam akkas wawwaatu!","poem":1},{"text":"Moʼaab akkam akkas dugda ishee qaaniidhaan garagalfatte!","poem":2},{"text":"Moʼaab waan kolfaa taatee,","poem":1},{"text":"warra naannoo ishee jiraatan hundaaf waan sodaa taateerti.”","poem":2}]},{"type":"verse","number":40,"content":["Waaqayyo akkana jedha:",{"text":"“Ilaa! Risaan tokko Moʼaab irratti","poem":1},{"text":"qoochoo balʼisee furguggifamaa gad buʼaa jira.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Keriiyooti ni qabamti;","poem":1},{"text":"daʼannoon ishee jajjaboonis ni fudhatamu.","poem":2},{"text":"Bara sana keessa garaan loltoota Moʼaab","poem":1},{"text":"akkuma garaa dubartii ciniinsifachuutti jirtu tokkoo taʼa.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Moʼaab sababii Waaqayyoon tuffatteef","poem":1},{"text":"barbadooftee saba taʼuun ishee ni hafa.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Yaa saba Moʼaab sodaan,","poem":1},{"text":"boollii fi kiyyoon si eeggata”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"“Namni sodaa sana duraa baqatu","poem":1},{"text":"kam iyyuu boolla keessa buʼa;","poem":2},{"text":"namni boolla sana keessaa ol baʼu","poem":1},{"text":"kam iyyuu kiyyoodhaan qabama;","poem":2},{"text":"ani Moʼaabitti","poem":1},{"text":"waggaa adabamuu ishee nan fidaatii”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“Baqattoonni waan taʼan dhabanii","poem":1},{"text":"gaaddisa Heshboon jala dhadhaabatu;","poem":2},{"text":"Heshboon keessaa ibiddi tokko,","poem":1},{"text":"Sihoon gidduudhaas arrabni ibiddaa ni kaʼaatii;","poem":2},{"text":"inni adda Moʼaab guba,","poem":1},{"text":"buqqee mataa of tuultotaas ni guba.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Yaa Moʼaab siif wayyoo!","poem":1},{"text":"Uummanni Kemoosh barbadaaʼeera;","poem":2},{"text":"Ilmaan kee boojiʼamanii fudhatamaniiru;","poem":1},{"text":"intallan kees boojiʼamaniiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“Taʼu illee ani bara dhufuuf jiru keessa","poem":1},{"text":"hambaa Moʼaab deebisee nan dhaaba”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2},"Murtiin Moʼaabitti murame sun asitti dhuma."]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}