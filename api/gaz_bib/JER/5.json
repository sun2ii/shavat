{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_bib","name":"Ermiyaas","commonName":"Ermiyaas","title":"Raajii Ermiyaas","order":24,"numberOfChapters":52,"sha256":"c0724fd0dceb470d1f8ccad4fd77ed6e806f779318036d4e9816804b25353f68","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":5,"content":[{"type":"heading","content":["Namni Tolaan Tokko Iyyuu Hin jiru"]},{"type":"verse","number":1,"content":[{"text":"“Daandiiwwan Yerusaalem irra olii gadi deddeebiʼaa;","poem":1},{"text":"asii fi achi ilaalaatii qalbeeffadhaa;","poem":2},{"lineBreak":true},{"text":"oobdiiwwan ishee sakattaʼaa.","poem":2},{"text":"Isin yoo nama waan qajeelaa hojjetu,","poem":1},{"text":"kan dhugaa barbaadu tokko illee argattan","poem":2},{"lineBreak":true},{"text":"ani magaalaa kanaaf dhiifama nan godha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isaan utuma ‘Dhugaa Waaqayyo jiraataa’ jedhanuu","poem":1},{"text":"amma iyyuu sobaan kakatu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yaa Waaqayyo, iji kee dhugaa hin barbaaduu?","poem":1},{"text":"Ati isaan dhoofte; garuu isaan hin dhukkubne;","poem":2},{"lineBreak":true},{"text":"ati isaan caccabsite; isaan garuu sirreeffamuu didan.","poem":2},{"text":"Isaan dhagaa caalaa mataa jabaatanii","poem":1},{"text":"qalbii jijjiirrachuu didan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Anis akkana jedheen yaade;","poem":1},{"text":"“Jarri kunneen hiyyeeyyii dha; isaan gowwoota;","poem":2},{"text":"isaan karaa Waaqayyoo,","poem":1},{"text":"seera Waaqa isaanii hin beekaniitii.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kanaafuu ani hangafoota bira dhaqee isaanitti nan dubbadha;","poem":1},{"text":"dhugumaan isaan karaa Waaqayyoo,","poem":2},{"lineBreak":true},{"text":"seera Waaqa isaanis ni beeku.”","poem":2},{"text":"Isaanis akkasuma waanjoo of irraa caccabsanii","poem":1},{"text":"hidhaas of irraa kukkutaniiru.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kanaafuu leenci bosonaa baʼee isaan nyaata;","poem":1},{"text":"yeeyyiin gammoojjiis dhufee isaan balleessa;","poem":2},{"text":"qeerransi warra gad baʼan ciccirachuuf","poem":1},{"text":"magaalaawwan isaanii biratti riphee eeggata;","poem":2},{"text":"fincilli isaanii akka malee guddate;","poem":1},{"text":"duubatti deebiʼuun isaaniis baayʼateeraatii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ani akkamiinan dhiifama isiniif gochuu dandaʼa?","poem":1},{"text":"Ijoolleen kee na dhiisanii","poem":2},{"lineBreak":true},{"text":"waaqota waaqota hin taʼiniin kakataniiru.","poem":2},{"text":"Ani waan isaaniif barbaachisu hunda kenneefiin ture;","poem":1},{"text":"isaan garuu ni ejjan;","poem":2},{"lineBreak":true},{"text":"gara manneen sagaagaltuuwwaniitis gugatan.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Isaan korommii fardeenii kanneen akka gaariitti sooramanii dha;","poem":1},{"text":"tokkoon tokkoon isaanii niitii namaatti himimsu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ani waan kanaaf isaan hin adabuu ree?”","poem":1},{"text":"jedha Waaqayyo.","poem":2},{"text":"“Ani mataan koo saba akka saba kanaa","poem":1},{"text":"haaloo hin baʼuu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Dallaa dhagaa isheetti ol baʼaatii balleessaa;","poem":1},{"text":"garuu guutumaan guutuutti miti.","poem":2},{"text":"Dameewwan ishee irraa ciraa;","poem":1},{"text":"sabni kun saba Waaqayyoo miti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Manni Israaʼelii fi manni Yihuudaa,","poem":1},{"text":"guutumaan guutuutti anaaf hin amanamne”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Isaan waaʼee Waaqayyoo soba dubbatan;","poem":1},{"text":"akkanas jedhan; “Inni homaa hin godhu!","poem":2},{"text":"Miidhaan tokko iyyuu nutti hin dhufu;","poem":1},{"text":"goraadee yookaan beela hin arginu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Raajonni bubbee malee homaa miti;","poem":1},{"text":"dubbiin isaan keessa hin jiru;","poem":2},{"lineBreak":true},{"text":"wanni isaan dubbatan isaanumatti haa deebiʼu.”","poem":2}]},{"type":"verse","number":14,"content":["Kanaafuu Waaqayyo Waan Hunda Dandaʼu akkana jedha:",{"text":"“Sabni kun waan dubbii kana dubbateef,","poem":1},{"text":"ani dubbii koo afaan kee keessatti ibidda,","poem":2},{"lineBreak":true},{"text":"saba kana immoo qoraan ibiddi gubu nan godha.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yaa mana Israaʼel,” jedha Waaqayyo;","poem":1},{"text":"“Ani saba duriitii fi jabaa,","poem":2},{"text":"saba ati afaan isaa hin beekne,","poem":1},{"text":"kan ati dubbii isaa illee hin hubanne tokko","poem":2},{"lineBreak":true},{"text":"biyya fagoodhaa sitti nan fida.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Manʼeen xiyya isaanii akkuma awwaala banamaa ti;","poem":1},{"text":"hundi isaaniis loltoota jajjaboo dha.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Isaan midhaan keetii fi buddeena kee ni nyaatu;","poem":1},{"text":"ilmaan keetii fi intallan kee ni ajjeesu;","poem":2},{"text":"bushaayee fi loon kee ni nyaatu;","poem":1},{"text":"wayinii keetii fi mukkeen harbuu keetii ni nyaatu.","poem":2},{"text":"Magaalaawwan dallaa jabaa qaban","poem":1},{"text":"kanneen ati amanatte sana goraadeedhaan barbadeessu.","poem":2}]},{"type":"verse","number":18,"content":["“Taʼus ani bara sana keessa iyyuu guutumaan guutuutti isin hin balleessu” jedha Waaqayyo."]},{"type":"verse","number":19,"content":["“Yommuu namoonni, ‘Waaqayyo Waaqni keenya maaliif waan kana hunda nutti fide?’ jedhanii gaafatanitti, ati, ‘Isin akkuma na dhiiftanii biyya keessan keessatti waaqota ormaa tajaajiltan sana, ammas biyya kan mataa keessanii hin taʼin keessatti ormoota ni tajaajiltu’ jettee isaanitti himta."]},{"type":"verse","number":20,"content":[{"text":"“Waan kana mana Yaaqoobitti himaa;","poem":1},{"text":"Yihuudaa keessattis labsaa:","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Isin uummanni gowwaan hubannaa hin qabne,","poem":1},{"text":"warri utuu ija qabdanuu hin argine","poem":2},{"lineBreak":true},{"text":"kanneen utuu gurra qabdanuuhin dhageenye waan kana dhagaʼa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Isin na hin sodaattanii?”","poem":1},{"text":"jedha Waaqayyo.","poem":2},{"lineBreak":true},{"text":"“Fuula koo duratti hin hollattanii?","poem":2},{"text":"Ani galaanaaf cirracha daarii dallaa bara baraa kan inni","poem":1},{"text":"qaxxaamuruu hin dandeenye godhee tolcheera.","poem":2},{"text":"Dhaʼaan galaanaa yoo itti buʼe iyyuu isa diiguu hin dandaʼu;","poem":1},{"text":"galaanichi yoo huurse iyyuu, isa cabsee darbuu hin dandaʼu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Sabni kun garuu mata jabeessaa fi fincilaa dha;","poem":1},{"text":"innis karaa irraa jalʼatee badeera.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Isaan garaa isaaniitti akkana hin jedhan;","poem":1},{"text":"‘Kottaa Waaqayyo Waaqa keenya isa bokkaa arfaasaatii fibokkaa birraa waqtiidhaan kennu,","poem":2},{"text":"isa torbanoota itti midhaan walitti qabannu","poem":1},{"text":"yeroo isaaniitti nuu kennu sana haa sodaannu.’","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Balleessaan keessan waan kana isin irraa deebiseera;","poem":1},{"text":"cubbuun keessan waan gaarii isin dhabsiiseera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Saba koo gidduu namoota hamoo","poem":1},{"text":"akka warra nama qabuuf kiyyoo kaaʼaniitti,","poem":2},{"lineBreak":true},{"text":"akkuma nama kiyyoon simbirroo qabuuttiriphanii eeggatantu jira.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Akkuma manʼeen simbiraan guutamu,","poem":1},{"text":"manneen isaanii sobaan guutamu;","poem":2},{"text":"isaanis sooreyyii fi jajjaboo taʼanii,","poem":1}]},{"type":"verse","number":28,"content":[{"text":"gabbatanii bareedaniiru;","poem":2},{"text":"hamminni isaanii dhuma hin qabu;","poem":1},{"text":"isaan murtii qajeelaa hin barbaadan.","poem":2},{"text":"Isaan dhimma ijoollee abbaa hin qabneetiif hin falman;","poem":1},{"text":"mirga hiyyeeyyiitiifis hin dhaabatan.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ani waan kanaaf isaan hin adabuu?”","poem":1},{"text":"jedha Waaqayyo.","poem":2},{"text":"“Ani saba akkasii","poem":1},{"text":"haaloo hin baafadhuu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“Wanni suukaneessaan nama rifachiisu tokko","poem":1},{"text":"biyyattii keessatti taʼeera:","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Raajonni raajii sobaa dubbatu;","poem":1},{"text":"luboonni humnuma isaaniitiin biyya bulchu;","poem":2},{"text":"sabni koos waan akkasii jaallata;","poem":1},{"text":"isin garuu dhuma irratti maal gochuuf jirtu?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/JER/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JER/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JER/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}