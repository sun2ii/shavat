{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_bib","name":"Ermiyaas","commonName":"Ermiyaas","title":"Raajii Ermiyaas","order":24,"numberOfChapters":52,"sha256":"c0724fd0dceb470d1f8ccad4fd77ed6e806f779318036d4e9816804b25353f68","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":50,"content":[{"type":"heading","content":["Ergaa Waaʼee Baabilon"]},{"type":"verse","number":1,"content":["Dubbiin Waaqayyo karaa Ermiyaas raajichaatiin waaʼee Baabilonii fi waaʼee biyya Baabilonotaa dubbate kanaa dha:"]},{"type":"verse","number":2,"content":[{"text":"“Saboota gidduutti lallabaatii labsaa;","poem":1},{"text":"faajjii ol qabaatii labsaa;","poem":2},{"lineBreak":true},{"text":"utuu homaa hin hambisin akkana jedhaa;","poem":2},{"text":"‘Baabilon ni qabamti;","poem":1},{"text":"Beel ni salphifama;","poem":2},{"lineBreak":true},{"text":"Meroodak gooliidhaan guutama.","poem":2},{"text":"Fakkiiwwan Baabilon ni salphifamu;","poem":1},{"text":"waaqonni ishee tolfamoonis sodaan guutamu.’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sabni Kaabaa dhufu tokko ishee lolee","poem":1},{"text":"lafa ishee duwwaa hambisa.","poem":2},{"text":"Namni tokko iyyuu ishee keessa hin jiraatu;","poem":1},{"text":"namaa fi horiin baqatee keessaa baʼa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Bara sana keessa, yeroo sanatti,","poem":1},{"lineBreak":true},{"text":"sabni Israaʼelii fi sabni Yihuudaa","poem":1},{"text":"imimmaaniin Waaqayyo Waaqa isaanii barbaacha","poem":2},{"lineBreak":true},{"text":"tokkummaadhaan ni dhufu” jedha Waaqayyo;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Isaan karaa gara Xiyoon geessu ni gaafatu;","poem":1},{"text":"fuula isaaniis garasitti garagalfatu.","poem":2},{"text":"Isaan dhufanii kakuu bara baraa","poem":1},{"text":"kan gonkumaa hin irraanfatamneen","poem":2},{"lineBreak":true},{"text":"Waaqayyotti of maxxansu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Sabni koo hoolota badan taʼaniiru;","poem":1},{"text":"tikseen isaanii isaan dogoggorsee","poem":2},{"lineBreak":true},{"text":"akka isaan tulluuwwan irra jooran godhe.","poem":2},{"text":"Isaan tulluu fi gaara irra jooranii","poem":1},{"text":"lafa boqonnaa isaanii illee wallaalan.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kan isaan argu hundi isaan liqimse;","poem":1},{"text":"diinonni isaaniis, ‘Nu balleessaa hin qabnu;","poem":2},{"text":"isaan Waaqayyo iddoo jireenya isaanii kan dhugaa taʼe,","poem":1},{"text":"Waaqayyo abdii abbootii isaaniitti cubbuu hojjetaniiruutii’ jedhan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Baabilonii baqadhaa baʼaa;","poem":1},{"text":"biyya Baabilonotaa keessaa baʼaa;","poem":2},{"lineBreak":true},{"text":"akkuma korbeessa reʼee kan bushaayee qajeelchuu taʼaa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ani biyya kaabaatii garee saboota gurguddaa kaasee","poem":1},{"text":"Baabilonitti nan ergaatii.","poem":2},{"text":"Isaanis hiriiranii isheetti dhufu;","poem":1},{"text":"isheenis karaa kaabaatiin ni qabamti.","poem":2},{"text":"Xiyyi isaanii akkuma loltoota ogeeyyii","poem":1},{"text":"harka duwwaa hin deebinee ti.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Baabilonis ni saamamti;","poem":1},{"text":"warri ishee saaman hundis ni quufu”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Isin warri handhuuraa koo saamtan","poem":1},{"text":"waan gammaddanii fi ililchitaniif,","poem":2},{"text":"akkuma raadaa marga keessaa burraaqxanii","poem":1},{"text":"akka korma fardaa imimsitan illee,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"haati keessan akka malee qaanofti;","poem":1},{"text":"kan isin deesses ni salphatti.","poem":2},{"text":"Isheen saboota hunda keessaa gad aantuu,","poem":1},{"text":"lafa onaa, lafa gogaa fi gammoojjii taati.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Isheen sababii dheekkamsa Waaqayyootiif guutumaan guutuutti","poem":1},{"text":"ni onti malee namni ishee keessa hin jiraatu.","poem":2},{"text":"Sababii madaa ishee hundaatiif","poem":1},{"text":"namni Baabilon keessa darbu hundi ni dinqisiifata; itti qoosas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Isin warri iddaa luqqifattan hundinuu,","poem":1},{"text":"naannoo Baabilonitti hiriiraa.","poem":2},{"text":"Sababii isheen Waaqayyotti cubbuu hojjetteef,","poem":1},{"text":"xiyyawwan itti darbadhaa! Homaa hin hambisinaa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Karaa hundaan isheetti iyyaa!","poem":1},{"text":"Isheen harka kennatti; gamoon ishee ni jiga;","poem":2},{"lineBreak":true},{"text":"dallaan ishee diigameera.","poem":2},{"text":"Kun haaloo Waaqayyoo waan taʼeef","poem":1},{"text":"isheetti haaloo baʼaa;","poem":2},{"lineBreak":true},{"text":"waanuma isheen warra kaanitti hojjette isheetti hojjedhaa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nama sanyii facaasuu fi kan yeroo midhaan haamamutti","poem":1},{"text":"haamtuu qabatus Baabilon keessaa balleessaa.","poem":2},{"text":"Sababii goraadee cunqursaatiin","poem":1},{"text":"tokkoon tokkoon namaa gara saba ofii isaatti haa deebiʼu;","poem":2},{"lineBreak":true},{"text":"tokkoon tokkoon namaa gara biyya ofii isaattis haa baqatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Israaʼel hoolaa bittinnaaʼee dha;","poem":1},{"text":"leenconni isa ariʼan.","poem":2},{"text":"Kan jalqabatti isa nyaate mootii Asoor;","poem":1},{"text":"kan dhuma irratti lafee isaa caccabse immoo","poem":2},{"lineBreak":true},{"text":"Nebukadnezar mooticha Baabilon ture.”","poem":2}]},{"type":"verse","number":18,"content":["Kanaafuu Waaqayyo Waan Hunda Dandaʼu, Waaqni Israaʼel akkana jedha:",{"text":"“Ani akkuma mootii Asoor adabe sana","poem":1},{"text":"mootii Baabilonii fi biyya isaa nan adaba.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Israaʼelin garuu lafa tika isaatti nan deebisa;","poem":1},{"text":"innis Qarmeloosii fi Baashaan irra ni dheeda;","poem":2},{"lineBreak":true},{"text":"tulluu Efreemii fi Giliʼaad irra dheedee ni quufa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bara sana keessa, yeroo sanatti,","poem":1},{"text":"yakki Israaʼel ni barbaadama” jedha Waaqayyo;","poem":2},{"text":"“garuu tokko iyyuu hin jiru;","poem":1},{"text":"cubbuun Yihuudaas ni barbaadama;","poem":2},{"text":"garuu tokko iyyuu hin argamu;","poem":1},{"text":"ani hambaan baraare sanaaf","poem":2},{"lineBreak":true},{"text":"dhiifama nan godhaatii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Biyya Meraataayimii fi","poem":1},{"text":"jiraattota Pheqood lolaa.","poem":2},{"text":"Ariʼaa, ajjeesaa, guutumaan guutuutti isaan balleessaa,”","poem":1},{"text":"jedha Waaqayyo.","poem":2},{"lineBreak":true},{"text":"“Waan ani isin ajaje hunda godhaa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Sagaleen waraanaa,","poem":1},{"text":"sagaleen badiisa guddaas biyya sana keessa jira!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Burruusni guutummaa lafaa akkamitti cabe!","poem":1},{"text":"Akkamittis bullaaʼe!","poem":2},{"text":"Baabilon saboota gidduutti,","poem":1},{"text":"akkam onte!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yaa Baabilon, ani kiyyoo siif diriirseera;","poem":1},{"text":"atis utuu hin beekin qabamte;","poem":2},{"text":"ati sababii Waaqayyoon mormiteef,","poem":1},{"text":"argamtee qabamte.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Waaqayyo mankuusaa miʼa lolaa isaa banee","poem":1},{"text":"miʼa lola dheekkamsa isaa gad baafateera;","poem":2},{"text":"Gooftaan, Waaqayyoon Waan Hunda Dandaʼu","poem":1},{"text":"waan biyya Baabilonotaatti hojjetu qabaatii.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Biyya fagootii isheetti kottaa.","poem":1},{"text":"Gombisaawwan ishee diigaa;","poem":2},{"lineBreak":true},{"text":"akkuma tuullaa midhaaniitti ishee tuulaa.","poem":2},{"text":"Guutumaan guutuutti ishee balleessaa;","poem":1},{"text":"waan tokko illee isheef hin hambisinaa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Korommii ishee hunda qalaa;","poem":1},{"text":"isaan gara qalmaatti haa geeffaman!","poem":2},{"text":"Isaaniif wayyoo! Yeroon isaan itti adabaman,","poem":1},{"text":"guyyaan isaanii dhufeeraatii.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Akka Waaqayyo Waaqni keenya haaloo baʼe,","poem":1},{"text":"akka inni mana qulqullummaa isaatiif haaloo baʼe,","poem":2},{"text":"kooluu galtootaa fi baqattoota Baabilonii dhufanii","poem":1},{"text":"Xiyoon keessatti lallaban irraa dhagaʼaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Namoota Xiyyaan lolan","poem":1},{"text":"kanneen iddaa luqqifatan hunda Baabilonitti waamaa.","poem":2},{"text":"Naannoo ishee hunda marsaa;","poem":1},{"text":"namni tokko iyyuu hin miliqin.","poem":2},{"text":"Gatii hojii ishee kennaafii;","poem":1},{"text":"waanuma isheen warra kaanitti hojjette isheettis hojjedhaa.","poem":2},{"text":"Isheen Qulqullicha Israaʼel,","poem":1},{"text":"Waaqayyotti koorteertii.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kanaafuu dargaggoonni ishee karaa irratti dhumu;","poem":1},{"text":"gaafas loltoonni ishee hundi ni barbadaaʼu”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"“Yaa koortuu nana, kunoo ani sitti kaʼeera”","poem":1},{"text":"jedha Gooftaan, Waaqayyoon Waan Hunda dandaʼu;","poem":2},{"text":"“yeroon ati itti adabamtu,","poem":1},{"text":"guyyaan kee dhufeeraatii.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Koortuun sun gufattee lafa dhoofti;","poem":1},{"text":"namni gargaaree ol ishee qabu tokko iyyuu hin jiru;","poem":2},{"text":"ani magaalaawwan ishee keessatti","poem":1},{"text":"ibidda warra naannoo ishee jiru hundagubee fixu nan qabsiisa.”","poem":2}]},{"type":"verse","number":33,"content":["Waaqayyo Waan Hunda Dandaʼu akkana jedha:",{"text":"“Sabni Israaʼel cunqurfameera;","poem":1},{"text":"sabni Yihuudaas akkasuma cunqurfameera.","poem":2},{"text":"Warri isaan boojiʼan hundi jabeessanii isaan qabataniiru;","poem":1},{"text":"isaan gad dhiisuus didaniiru.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Taʼu illee Furaan isaanii jabaa dha;","poem":1},{"text":"maqaan isaas Waaqayyo Waan Hunda Dandaʼuu dha.","poem":2},{"text":"Inni biyya isaaniitiif boqonnaa kenne;","poem":1},{"text":"warra Baabilon keessa jiraatan garuu boqonnaa dhowwuuf","poem":2},{"lineBreak":true},{"text":"dhimma isaaniitiif jabeessee ni falma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"“Goraadeen tokko Baabilonotatti dhufe!”","poem":1},{"text":"jedha Waaqayyo;","poem":2},{"text":"“warra Baabilon keessa jiraatanitti,","poem":1},{"text":"qondaaltotaa fi namoota ishee ogeeyyiitti dhufeera!","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Goraadeen raajota ishee sobdootatti, dhufeera!","poem":1},{"text":"Isaan gowwoota taʼu.","poem":2},{"text":"Goraadeen gootota isheetti dhufeera!","poem":1},{"text":"Isaanis sodaadhaan guutamu.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Goraadeen fardeenii fi gaariiwwan isheetti,","poem":1},{"text":"Namoota Ormaa kanneen gidduu ishee jiraatan hundatti dhufe!","poem":2},{"lineBreak":true},{"text":"Isaan dadhaboo taʼu.","poem":2},{"text":"Goraadeen qabeenya isheetti dhufe!","poem":1},{"text":"Isaan ni saamamu.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Caamsaan bishaan isheetti ni dhufa!","poem":1},{"text":"Isaanis ni gogu.","poem":2},{"text":"Isheen biyya waaqota tolfamoo,","poem":1},{"text":"kan waaqota tolfamoo sodaadhaan maraataniitii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“Kanaafuu uumamawwan gammoojjiitii fiwaraabeyyiin achi jiraatu;","poem":1},{"text":"urunguunis achi jiraatti.","poem":2},{"text":"Lammata namni ishee keessa hin jiraatu;","poem":1},{"text":"yookaan dhalootaa hamma dhalootaattinamni keessa jiraatu hin jiru.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Akkuma Waaqni Sodoomii fi Gomoraa,","poem":1},{"text":"magaalaawwan naannoo isaanii jiran wajjin balleesse sana”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo;","poem":2},{"text":"“namni tokko iyyuu achi hin jiraatu;","poem":1},{"text":"sanyiin namaa tokkos ishee keessa hin qubatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"“Kunoo! Gareen loltootaa tokko kaaba irraa dhufaa jira;","poem":1},{"text":"sabni guddaan tokkoo fi mootonni baayʼeen","poem":2},{"lineBreak":true},{"text":"moggaa lafaatii sosochoʼaa jiru.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Isaan xiyyaa fi eeboo qabataniiru;","poem":1},{"text":"isaan gara jabeeyyii namaafis naasuu hin qabnee dha.","poem":2},{"text":"Yommuu isaan fardeen isaanii gulufanitti","poem":1},{"text":"gigigsuun isaanii akkuma huursaa galaanaa ti;","poem":2},{"text":"yaa intala Baabilon,","poem":1},{"text":"isaan akkuma namoota duulaaf hiriiraniitti si loluuf dhufu.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Mootiin Baabilon oduu waaʼee isaanii dhagaʼe;","poem":1},{"text":"harki isaas irratti duʼe.","poem":2},{"text":"Dhiphinni isa qabateera;","poem":1},{"text":"miixuunis akkuma dubartii ciniinsifattuu isa qabeera.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Ani akkuma leenca bosona Yordaanosii baʼee","poem":1},{"text":"gara lafa dheedaa gabbataa dhufu tokkoo","poem":2},{"lineBreak":true},{"text":"dafee Baabilonin biyya isheetii nan ariʼa.","poem":2},{"text":"Filatamaan ani waan kanaaf muudu eenyu?","poem":1},{"text":"Kan akka koo eenyu?","poem":2},{"text":"Eenyutus naan morkuu dandaʼa?","poem":1},{"text":"Tiksee akkamiitu fuula koo dura dhaabachuu dandaʼa?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"Kanaafuu waan Waaqayyo Baabilonitti karoorfate,","poem":1},{"text":"waan inni biyya Baabilonotaatti yaades dhagaʼaa;","poem":2},{"text":"Ilmaan bushaayee harkifamanii ni fudhatamu;","poem":1},{"text":"innis sababii isaaniitiif lafa dheeda isaaniiguutumaan guutuutti ni barbadeessa.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Waca qabamuu Baabiloniitiin lafti ni raafamti;","poem":1},{"text":"iyyi ishees saboota gidduutti ni dhagaʼama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/JER/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JER/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JER/49.json","previousChapterAudioLinks":{},"numberOfVerses":46}