{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_bib","name":"Ermiyaas","commonName":"Ermiyaas","title":"Raajii Ermiyaas","order":24,"numberOfChapters":52,"sha256":"c0724fd0dceb470d1f8ccad4fd77ed6e806f779318036d4e9816804b25353f68","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":["Waaqayyo akkana jedha:",{"text":"“Kunoo ani Baabilonii fi saba ishee keessa jiraatutti","poem":1},{"text":"bubbee waa balleessu nan kaasa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ani akka isaan gingilchanii ishee balleessaniif","poem":1},{"text":"ormoota Baabilonitti nan erga;","poem":2},{"text":"isaan gaafa badiisa ishee,","poem":1},{"text":"karaa hundaanuu isheen mormu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abbaan xiyyaa iddaa isaa hin aggaamin,","poem":1},{"text":"yookaan miʼa lolaa hin hidhatin.","poem":2},{"text":"Dargaggoota ishee hin baasinaa;","poem":1},{"text":"loltoota ishee illee guutumaan guutuutti barbadeessaa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isaan qalamanii Baabilon keessa ni harcaafamu;","poem":1},{"text":"daandiiwwan ishee irrattis ni madaaʼu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yoo biyyi isaanii fuula Qulqullicha Israaʼel duratti","poem":1},{"text":"yakkaan guutamtee jiraatte iyyuu","poem":2},{"text":"Waaqni isaanii, Waaqayyoon Waan Hunda Dandaʼu","poem":1},{"text":"Israaʼelii fi Yihuudaa hin ganne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Baabilon keessaa baqadhaa!","poem":1},{"text":"Lubbuu keessan oolfadhaa!","poem":2},{"lineBreak":true},{"text":"Isin sababii cubbuu isheetiif hin dhuminaa.","poem":2},{"text":"Yeroon kun yeroo haaloo baʼuu Waaqayyoo ti;","poem":1},{"text":"innis gatii isheef malu ni kennaaf.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Baabilon harka Waaqayyoo keessatti xoofoo warqee turte;","poem":1},{"text":"isheen guutummaa lafaa ni macheessite.","poem":2},{"text":"Saboonni daadhii wayinii ishee dhugan;","poem":1},{"text":"kanaafuu amma maraataniiru.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Baabilon akkuma tasaa","poem":1},{"text":"kuftee caccabdi; isheef booʼaa!","poem":2},{"text":"Qoricha isheen madaa dibattu fidaafii;","poem":1},{"text":"tarii isheen ni fayyiti taʼaatii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ ‘Nu Baabilonin fayyisu yaalleerra;","poem":1},{"text":"isheen garuu fayyuu hin dandeessu;","poem":2},{"text":"kottaa tokkoon tokkoon keenya ishee dhiifnee","poem":1},{"text":"gara biyya ofii keenyaatti haa qajeellu;","poem":2},{"text":"murtiin ishee hamma samiitti ol baʼee,","poem":1},{"text":"hamma duumessaatti ol fagaateeraatii.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Waaqayyo qajeelummaa keenya dhugaa nuu baʼeera;","poem":1},{"text":"kottaa, waan Waaqayyo Waaqni keenya hojjete","poem":2},{"lineBreak":true},{"text":"Xiyoon keessatti haa odeessinu.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Xiyya qaradhaa;","poem":1},{"text":"gaachana illee fudhadhaa!","poem":2},{"text":"Sababii kaayyoon isaa Baabilonin balleessuu taʼeef","poem":1},{"text":"Waaqayyo mootota Meedee kakaaseera.","poem":2},{"text":"Waaqayyo haaloo ni baʼa;","poem":1},{"text":"mana qulqullummaa isaatii haaloo ni baʼa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dallaa Baabilonitti faajjii kaasaa!","poem":1},{"text":"Eegumsa jajjabeessaa;","poem":2},{"text":"eegduu dhaabaa;","poem":1},{"text":"warra riphee eeggatu qopheessaa!","poem":2},{"text":"Waaqayyo kaayyoo isaa","poem":1},{"text":"waan saba Baabilonitti mure sana fiixaan baafata.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ati kan bishaan baayʼee qabdu,","poem":1},{"text":"kan qabeenyaanis badhaate,","poem":2},{"text":"dhumni kee dhufeera;","poem":1},{"text":"yeroon ati itti baddu gaʼeera.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Waaqayyo Waan Hunda Dandaʼu ofiin kakateera:","poem":1},{"text":"Ani dhugumaan namoota akkuma hoomaa hawwaannisaasitti gad dhiisa;","poem":2},{"lineBreak":true},{"text":"isaanis moʼannaadhaan sitti dhaadatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Inni humna isaatiin lafa uume;","poem":1},{"text":"ogummaa isaatiin addunyaa hundeesse;","poem":2},{"lineBreak":true},{"text":"hubannaa isaatiinis samiiwwan diriirse.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yommuu inni qaqawweessaʼutti bishaanonni samii ni huursu;","poem":1},{"text":"inni akka duumessoonni daarii lafaatii ol kaʼan ni godha.","poem":2},{"text":"Bokkaa wajjin balaqqee ni erga;","poem":1},{"text":"mankuusaalee isaa keessaa immoo bubbee ni fida.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Tokkoon tokkoon namaa gowwaa fi kan beekumsa hin qabnee dha;","poem":1},{"text":"tokkoon tokkoon tumtuu warqee waaqota tolfamoo isaatiin qaaneffama.","poem":2},{"text":"Fakkiiwwan inni tolchu kan sobaa ti;","poem":1},{"text":"isaan hafuura baafatan of keessaa hin qaban.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Isaan faayidaa hin qaban; meeshaa qoosaa ti;","poem":1},{"text":"yeroo adabbiin isaanii gaʼutti ni badu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Inni qooda Yaaqoob taʼe sun garuu akka warra kanaa miti;","poem":1},{"text":"inni uumaa waan hundumaa ti;","poem":2},{"text":"Israaʼel immoo gosa dhaala isaa ti;","poem":1},{"text":"maqaan isaas Waaqayyoo Waan Hunda Dandaʼuu dha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Ati bokkuu koo kan duulaa","poem":1},{"text":"miʼa lolaa kootii ti;","poem":2},{"text":"ani siin saboota nan caccabsa;","poem":1},{"text":"siin mootummoota nan barbadeessa;","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ani siin fardaa fi yaabbataa fardaa nan caccabsa;","poem":1},{"text":"siin gaarii fi ooftuu isaa nan caccabsa;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ani siin dhiiraa dubartoota nan caccabsa;","poem":1},{"text":"siin jaarsaa dargaggeessa nan caccabsa;","poem":2},{"lineBreak":true},{"text":"siin gaʼeessaa fi shamarree nan caccabsa;","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ani siin tiksee fi bushaayee nan caccabsa;","poem":1},{"text":"siin qottuu fi qotiyyoo nan caccabsa;","poem":2},{"lineBreak":true},{"text":"siin bulchitootaa fi qondaaltota nan caccabsa.","poem":2}]},{"type":"verse","number":24,"content":["“Ani utuma iji keessan arguu waan isaan Xiyoon godhan hundaaf Baabilonii fi warra Baabilon keessa jiraatan hundaaf gatii isaanii nan kenna” jedha Waaqayyo."]},{"type":"verse","number":25,"content":[{"text":"“Yaa tulluu barbadeessaa,","poem":1},{"text":"ati kan lafa hunda balleessitu ani sitti kaʼeera;","poem":2},{"lineBreak":true},{"text":"ani harka koo sitti nan kaafadha;","poem":2},{"text":"ededa irraa gad gangalchee","poem":1},{"text":"tulluu gubamaa sin godha”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"“Waan ati bara baraan ontuuf,","poem":1},{"text":"kattaan dhagaa golee taʼu,","poem":2},{"text":"yookaan dhagaan hundeef taʼu tokko iyyuu si keessaa hin fudhatamu”","poem":1},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Biyyattii keessatti faajjii ol qabaa!","poem":1},{"text":"Saboota gidduuttis malakata afuufaa!","poem":2},{"text":"Saboota waraanaaf isheetti qopheessaa;","poem":1},{"text":"mootummoota Araaraat,","poem":2},{"lineBreak":true},{"text":"kan Miiniitii fi Ashkenas isheetti waamaa.","poem":2},{"text":"Ajajaa waraanaa isheetti shuumaa;","poem":1},{"text":"fardeen akka hoomaa hawwaannisaa itti ergaa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ishee waraanuudhaaf saboota jechuunis,","poem":1},{"text":"mootota Meedee","poem":2},{"text":"bulchitoota isaaniitii fi qondaaltota isaanii hunda,","poem":1},{"text":"biyyoota isaan bulchan hundas qopheessaa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Sababii wanni Waaqayyo","poem":1},{"text":"akka namni tokko iyyuu achi hin jiraanneef","poem":2},{"text":"biyya Baabilon onsuuf Baabilonitti karoorfate sun","poem":1},{"text":"jabaatee dhaabatuuf biyyattiin ni raafamti; ni dhidhiitattis.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Gootonni Baabilon lola dhiisaniiru;","poem":1},{"text":"isaan daʼannoo isaanii keessatti hafaniiru.","poem":2},{"text":"Jabinni isaanii dhumeera;","poem":1},{"text":"isaan akkuma dubartootaa taʼaniiru.","poem":2},{"text":"Iddoo jireenya isheetti ibiddi qabsiifameera;","poem":1},{"text":"danqaraawwan balbala ishees caccabaniiru.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Akka magaalaan isaa moggaa hamma moggaatti qabamte","poem":1},{"text":"mootii Baabilonitti himuuf,","poem":2},{"text":"fiigduun tokko isa kaan qaqqabuuf,","poem":1},{"text":"ergamaan tokkos ergamaa kaan qaqqabuuf fiiga;","poem":2}]},{"type":"verse","number":32,"content":[{"text":"kunis akka malkaan qabame,","poem":1},{"text":"akka daʼannoowwan ishee gubamanii fi","poem":2},{"lineBreak":true},{"text":"akka loltoonni ishee naʼan himuudhaaf.”","poem":2}]},{"type":"verse","number":33,"content":["Waaqayyo Waan Hunda Dandaʼu, Waaqni Israaʼel akkana jedha:",{"text":"“Intalli Baabilon akkuma oobdii ti;","poem":1},{"text":"yeroo sanatti isheen ni dhidhiitamti;","poem":2},{"lineBreak":true},{"text":"yeroon isheen itti haamamtus dafee ni dhufa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Nebukadnezar mootiin Baabilon na nyaateera;","poem":1},{"text":"inni barbadeesseera;","poem":2},{"lineBreak":true},{"text":"akkuma okkotee duwwaa na godhe.","poem":2},{"text":"Inni akkuma jawwee na liqimse;","poem":1},{"text":"qabeenya koo filatamaadhaanis garaa guuttate;","poem":2},{"lineBreak":true},{"text":"ergasii immoo na tufe.”","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Jiraattonni Xiyoon,","poem":1},{"text":"“Dabni foon keenyatti hojjetame Baabilonitti illee haa dhufu” jedhan.","poem":2},{"text":"Yerusaalemis, “Dhiigni keenya","poem":1},{"text":"warra Baabilon keessa jiraatan haaloo haa baʼu” jetti.","poem":2}]},{"type":"verse","number":36,"content":["Kanaafuu Waaqayyo akkana jedha:",{"text":"“Kunoo, ani dubbii kee siif falmee","poem":1},{"text":"haaloo siifin baʼa;","poem":2},{"text":"ani galaana ishee nan gogsa;","poem":1},{"text":"burqaa ishee illee nan kuta.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Baabilon tuullaa diigame,","poem":1},{"text":"iddoo waangoonni keessa burraaqan,","poem":2},{"text":"waan naasuutii fi qoosaa,","poem":1},{"text":"lafa namni tokko iyyuu irra hin jiraanne ni taati.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Sabni ishee hundi akka saafela leencaa ni aada;","poem":1},{"text":"isaanis akka ilmaan leencaa gururiʼu.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Yommuu dhagni isaanii hoʼutti,","poem":1},{"text":"ani akka isaan kolfaa gammadanii","poem":2},{"lineBreak":true},{"text":"bara baraan rafanii hin dammaqneef","poem":2},{"text":"cidha isaaniif qopheessee","poem":1},{"text":"akka isaan machaaʼan nan godha”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"“Ani akka ilmoolee hoolaa,","poem":1},{"text":"akkuma korbeeyyii hoolaatii fi","poem":2},{"lineBreak":true},{"text":"reʼee gara qalmaatti gad isaan buusa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"“Sheeshaak akkamitti boojiʼamti!","poem":1},{"text":"Boonuun lafa hundaas akkamitti qabame!","poem":2},{"text":"Baabilon saba gidduutti","poem":1},{"text":"akkam waan sodaa taati!","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Baabilon irra galaanni garagala;","poem":1},{"text":"dambaliin galaanaas ishee haguuga.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Magaalaawwan ishee onanii","poem":1},{"text":"biyya gogaa fi gammoojjii,","poem":2},{"text":"biyya namni tokko iyyuu keessa hin jiraanne,","poem":1},{"text":"kan namni keessa hin dabarre ni taʼu.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Ani Baabilon keessatti Beelin nan adaba;","poem":1},{"text":"waan inni liqimse illee nan tufsiisa.","poem":2},{"text":"Saboonni lammata gara isaatti hin yaaʼan;","poem":1},{"text":"dallaan Baabilonis ni jiga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“Yaa saba ko, ishee keessaa baʼaa!","poem":1},{"text":"Lubbuu keessan oolfachuuf fiigaa!","poem":2},{"lineBreak":true},{"text":"Dheekkamsa Waaqayyoo sodaachisaa sana jalaa baqadhaa.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Yeroo oduun biyya keessatti dhagaʼamutti","poem":1},{"text":"garaan keessan hin raafamin yookaan hin sodaatin;","poem":2},{"text":"akka gooliin biyya keessa jiru,","poem":1},{"text":"akka bulchaan tokko bulchaa kaanitti kaʼu,","poem":2},{"lineBreak":true},{"text":"oduun tokko barana, kaan immoo bara dhufu dhagaʼama.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Yeroon ani itti waaqota Baabilon tolfamoo adabu","poem":1},{"text":"dhugumaan ni dhufaatii;","poem":2},{"text":"biyyi ishee guutumaan guutuutti ni salphatti;","poem":1},{"text":"qalamtoonni ishee hundis ishee keessatti kukkufu.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Ergasii samii fi lafti, wanni isaan keessa jiru hundis,","poem":1},{"text":"gammadanii Baabilonitti ililchu;","poem":2},{"text":"barbadeessitoonni kaabaa baʼanii","poem":1},{"text":"ishee waraanuutii”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"“Akkuma qalamtoonni lafa irraa hundi","poem":1},{"text":"sababii Baabiloniif harcaʼan sana","poem":2},{"lineBreak":true},{"text":"Baabilonis sababii qalamtoota Israaʼeliif harcaʼuu qabdi.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Isin warri goraadee jalaa miliqxan,","poem":1},{"text":"deemaa; lafa irra hin harkifatinaa!","poem":2},{"text":"Biyya fagootti illee Waaqayyoon yaadadhaa;","poem":1},{"text":"waaʼee Yerusaalemis yaadaa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"“Sababii ormoonni iddoo qulqullaaʼaa","poem":1},{"text":"mana Waaqayyootti qalaniif,","poem":2},{"lineBreak":true},{"text":"nu salphifamneerra;","poem":2},{"text":"waan arrabsamneefis","poem":1},{"text":"qaaniidhaan fuula keenya haguugganne.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"“Garuu barri ani itti,","poem":1},{"text":"waaqota ishee tolfamoo adabuu fi","poem":2},{"text":"yeroon guutummaa lafa ishee irratti","poem":1},{"text":"warri madaaʼan aadan dhufaa jira” jedha Waaqayyo.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"“Yoo Baabilon samiitti ol baatee","poem":1},{"text":"daʼannoo ishee ol dheeraa jabeeffatte iyyuu,","poem":2},{"lineBreak":true},{"text":"ani warra ishee barbadeessan itti nan erga”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":54,"content":[{"text":"“Baabilonii iyyi,","poem":1},{"text":"lafa Baabilonotaatii immoo","poem":2},{"lineBreak":true},{"text":"sagaleen badiisa guddaa ni dhagaʼama.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Waaqayyos Baabilonin ni barbadeessa;","poem":1},{"text":"inni waca ishee ni calʼisiisa,","poem":2},{"text":"dambaliin isaaniis akkuma bishaan guddaa ni huursa;","poem":1},{"text":"sagaleen huursaa isaaniis ni dhagaʼama.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Barbadeessaan tokko Baabilonitti ni dhufa;","poem":1},{"text":"gootonni ishee ni qabamu;","poem":2},{"lineBreak":true},{"text":"futtaaftuun isaaniis ni caccaba;","poem":2},{"text":"Waaqayyo, Waaqa haaloo baʼuudhaatii;","poem":1},{"text":"inni guutumaan guutuutti gatii ishee ni deebisaaf.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Ani qondaaltotaa fi ogeeyyii ishee,","poem":1},{"text":"akkasumas bulchitoota, ajajjoota waraanaatii figootota ishee nan macheessa;","poem":2},{"text":"isaanis bara baraan ni rafu; hin dammaqanis,”","poem":1},{"text":"jedha mootichi maqaan isaa Waaqayyo Waan Hunda Dandaʼu,jedhamu sun.","poem":2}]},{"type":"verse","number":58,"content":["Waaqayyo Waan Hunda Dandaʼu akkana jedha;",{"text":"“Dallaan Baabilon yabbuun sun ni jiga;","poem":1},{"text":"karrawwan ishee dhedheeroon ibiddaan gubamu;","poem":2},{"text":"namoonni akkasumaan of dadhabsiisu;","poem":1},{"text":"dadhabbiin sabootaa qoraan ibiddaa qofa taʼa.”","poem":2}]},{"type":"verse","number":59,"content":["Yeroo Seraayaan ilmi Neeriyaa, ilmi Mahiseyaa bara Zedeqiyaa mooticha Yihuudaa keessa waggaa afuraffaatti mooticha wajjin gara Baabilon deemetti ajajni Ermiyaas Raajichi isaaf kenne kanaa dha."]},{"type":"verse","number":60,"content":["Ermiyaas badiisa Baabilonitti dhufu hunda, jechuunis waaʼee Baabilon kan barreeffame hunda kitaaba maramaa irratti barreessee ture."]},{"type":"verse","number":61,"content":["Innis Seraayaadhaan akkana jedhe; “Yommuu Baabilon geessutti dubbii kana hunda sagalee ol fudhattee dubbisuu hin dagatin."]},{"type":"verse","number":62,"content":["Akkanas jedhi: ‘Yaa Waaqayyo, akka namni yookaan horiin ishee keessa hin jiraanneef ati akka iddoo kana barbadeessitu dubbatteerta; isheenis bara baraan ni onti.’"]},{"type":"verse","number":63,"content":["Yeroo kitaaba maramaa kana dubbiftee fixxutti dhagaa itti hidhiitii Laga Efraaxiisitti darbadhu."]},{"type":"verse","number":64,"content":["Akkanas jedhi; ‘Sababii badiisa ani isheetti fiduutiin akka lammata hin kaaneef Baabilon akkasitti ni liqimfamti. Uummanni ishees ni harcaʼa.’ ”",{"lineBreak":true},{"lineBreak":true},"Dubbiin Ermiyaas as irratti raawwatama."]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":64}