{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_bib","name":"Ermiyaas","commonName":"Ermiyaas","title":"Raajii Ermiyaas","order":24,"numberOfChapters":52,"sha256":"c0724fd0dceb470d1f8ccad4fd77ed6e806f779318036d4e9816804b25353f68","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":6,"content":[{"type":"heading","content":["Yerusaalem Marfamte"]},{"type":"verse","number":1,"content":[{"text":"“Yaa saba Beniyaam baqadhaa baʼaa!","poem":1},{"text":"Yerusaalem keessaa baqadhaa!","poem":2},{"text":"Teqooʼaa keessatti malakata afuufaa!","poem":1},{"text":"Beet Hakerem irratti mallattoo ol qabaa!","poem":2},{"text":"Karaa kaabaatiin balaan,","poem":1},{"text":"badiisni suukaneessaan ni dhufaatii.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ani Intala Xiyoon ishee bareedduu fi","poem":1},{"text":"qananiituu sana nan galaafadha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tiksoonni bushaayee isaanii fudhatanii isheetti dhufu;","poem":1},{"text":"dunkaana isaaniis isheetti naannessanii dhaabatu.","poem":2},{"lineBreak":true},{"text":"Tokkoon tokkoon isaaniis iddoo isaaniitti bobbaafatu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Isheetti waraana kaasuuf qophaaʼaa!","poem":1},{"text":"Kaʼaa, guyyaa saafaadhaan ishee waraanaa!","poem":2},{"text":"Wayyoo, aduun dhiʼaa jirti;","poem":1},{"text":"gaaddisni galgalaas dheerateera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kanaafuu kaʼaa, halkaniin ishee dhoofnee","poem":1},{"text":"daʼannoowwan ishee barbadeessinaa!”","poem":2}]},{"type":"verse","number":6,"content":["Waaqayyo Waan Hunda Dandaʼu akkana jedha;",{"text":"“Mukkeen ishee ciraa;","poem":1},{"text":"naannoo Yerusaalemitti tuulaa biyyoo tolchaa;","poem":2},{"text":"magaalaan kun adabamuu qabdi;","poem":1},{"text":"isheen cunqursaadhaan guutamteertii.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Akkuma boolli bishaanii bishaan yaasu sana,","poem":1},{"text":"isheenis hammina ishee gad yaafti;","poem":2},{"text":"jeequmsii fi badiisni ishee keessatti ni dhagaʼama.","poem":1},{"text":"Dhukkubnii fi madaan ishee yeroo hunda fuula koo dura jiran.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yaa Yerusaalem gorsa koo dhagaʼi;","poem":1},{"text":"yoo kanaa achii ani sirraa garagalee,","poem":2},{"text":"akka namni tokko iyyuu keessa jiraachuu","poem":1},{"text":"hin dandeenyeef, biyya kee nan onsa.”","poem":2}]},{"type":"verse","number":9,"content":["Waaqayyo Waan Hunda Dandaʼu akkana jedha:",{"text":"“Akkuma wayiniin sirriitti funaanamu sana,","poem":1},{"text":"isaanis hambaa Israaʼel haa funaanan;","poem":2},{"text":"akkuma nama ija wayinii ciru tokkootti;","poem":1},{"text":"ammas harka kee gara dameewwaniitti hiixadhu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ani eenyuttin dubbadhee akeekkachiisuu dandaʼa?","poem":1},{"text":"Eenyutu na dhaggeeffata?","poem":2},{"text":"Kunoo, gurri isaanii dhagna hin qabanne;","poem":1},{"text":"dhagaʼuus hin dandaʼan.","poem":2},{"text":"Dubbiin Waaqayyoo isaanitti hin tolu;","poem":1},{"text":"ittis hin gammadan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ani garuu dheekkamsa Waaqayyootiin guutameera;","poem":1},{"text":"obsuus hin dandaʼu.","poem":2},{"lineBreak":true},{"text":"“Ijoollee daandii irra jiran irratti,","poem":1},{"text":"dargaggoota walitti qabaman irratti,","poem":2},{"text":"dhirsaa fi niitii irratti,","poem":1},{"text":"warra dulloomanittis dheekkamsa nan dhangalaasa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yeroo ani harka koo","poem":1},{"text":"warra biyyattii keessa jiraatanitti ol fudhadhutti","poem":2},{"text":"manneen isaanii, lafa qotiisaa isaaniitii fi","poem":1},{"text":"niitota isaanii wajjin namoota kaaniif kennamu”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Xinnaadhaa hamma guddaatti","poem":1},{"text":"hundi isaanii iyyuu buʼaa argachuuf gaggabu;","poem":2},{"text":"raajonnii fi luboonnis akkasuma","poem":1},{"text":"hundi isaanii nama gowwoomsu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Isaan madaa saba kootii","poem":1},{"text":"akkuma waan xinnaa tokkootti ilaalanii walʼaanu.","poem":2},{"text":"Utuu nagaan hin jiraatinis","poem":1},{"text":"‘Nagaa, nagaa’ jedhu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Isaan amala isaanii jibbisiisaa sanatti ni qaanaʼuu?","poem":1},{"text":"Lakkii, isaan qaanii tokko iyyuu hin qaban;","poem":2},{"lineBreak":true},{"text":"qaanaʼuun maal akka taʼe iyyuu hin beekan.","poem":2},{"text":"Kanaafuu isaan warra kufan wajjin ni kufu;","poem":1},{"text":"yeroo ani isaan adabutti gad gatamu”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"verse","number":16,"content":["Waaqayyo akkana jedha:",{"text":"“Karaa qaxxaamuraa irra dhaabadhaatii ilaalaa;","poem":1},{"text":"daandii durii iyyaafadhaa;","poem":2},{"text":"karaan gaariin garam akka jiru gaafadhaatii irra deemaa;","poem":1},{"text":"lubbuu keessaniif boqonnaa ni argattuutii.","poem":2},{"lineBreak":true},{"text":"Isin garuu, ‘Nu isa irra hin deemnu’ jettan.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ani eegdota isinitti ramadeen","poem":1},{"text":"‘Sagalee malakataa dhaggeeffadhaa!’ jedhe,","poem":2},{"lineBreak":true},{"text":"isin garuu, ‘Hin dhaggeeffannu’ jettan.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kanaafuu yaa saboota dhagaʼaa;","poem":1},{"text":"yaa waldaa,","poem":2},{"lineBreak":true},{"text":"waan isaanitti dhufuuf jiru hubadhaa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yaa lafaa dhagaʼi:","poem":1},{"text":"Ani waan isaan dubbii koo dhagaʼuu didanii","poem":2},{"lineBreak":true},{"text":"seera koos tuffataniif,","poem":2},{"text":"saba kanatti badiisa nan fida;","poem":1},{"text":"kunis ija daba isaanii ti.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ixaanni biyya Shebaatii dhufu,","poem":1},{"text":"yookaan qayyii biyya fagootii dhufu maal na fayyada?","poem":2},{"text":"Aarsaan keessan kan gubamu fudhatama hin qabu;","poem":1},{"text":"qalmi keessanis hin tolu.”","poem":2}]},{"type":"verse","number":21,"content":["Kanaafuu Waaqayyo akkana jedha:",{"text":"“Ani fuula saba kanaa dura gufuu nan kaaʼa.","poem":1},{"text":"Abbootiinii fi ijoolleen walii wajjin itti gufatu;","poem":2},{"lineBreak":true},{"text":"olloonnii fi michoonni ni barbadaaʼu.”","poem":2}]},{"type":"verse","number":22,"content":["Waaqayyo akkana jedha;",{"text":"“Kunoo, gareen loltootaa tokko","poem":1},{"text":"biyya kaabaatii dhufaa jira;","poem":2},{"text":"sabni guddaan tokkos","poem":1},{"text":"andaara lafaatii sosochoʼaa jira.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Isaan xiyyaa fi eeboo qabataniiru;","poem":1},{"text":"isaan gara jabeeyyii, namaafis naasuu hin qabnee dha.","poem":2},{"text":"Yommuu isaan fardeen isaanii gulufanitti","poem":1},{"text":"gigigsuun isaanii akkuma huursaa galaanaa ti;","poem":2},{"text":"yaa Intala Xiyoon, isaan akkuma namoota","poem":1},{"text":"duulaaf hiriiraniitti si loluuf dhufu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Nu oduu waaʼee isaanii dhageenyeerra;","poem":1},{"text":"harki keenyas ni laafe.","poem":2},{"text":"Dhiphinni nu qabateera;","poem":1},{"text":"miixuunis akkuma dubartii ciniinsifattuu nu qabe.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Sababii diinni goraadee qabatee fi","poem":1},{"text":"sababii iddoo hunda gooliin jiruuf","poem":2},{"text":"isin diidatti gad hin baʼinaa;","poem":1},{"text":"yookaan karaa irra hin deemnaa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Yaa saba ko, uffata gaddaa uffadhaatii","poem":1},{"text":"daaraa keessa gangaladhaa;","poem":2},{"text":"akka nama ilma isaa tokkicha dhabeetti","poem":1},{"text":"hiqqifadhaa booʼaa;","poem":2},{"text":"inni nama balleessu sun","poem":1},{"text":"akkuma tasaa nutti dhufaatii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Akka ati karaa isaanii qortee beektuuf","poem":1},{"text":"ani saba koo gidduutti qorataa si godheera.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Hundi isaanii finciltoota mata jabeeyyii","poem":1},{"text":"maqaa namaa balleessuuf asii fi achi jooranii dha.","poem":2},{"text":"Isaan naasii fi sibiila;","poem":1},{"text":"isaan hundinuu malaa maltummaa hojjetu.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Buufaan dilaalii ibiddaan gubee balleessuuf","poem":1},{"text":"humna guddaan buufa;","poem":2},{"text":"hojiin ibiddaan qulqulleessuu kun faayidaa malee hojjetama;","poem":1},{"text":"namoonni hamoon hin balleeffamneetii.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Sababii Waaqayyo isaan gateef","poem":1},{"text":"isaan meetii gatamaa jedhamu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}