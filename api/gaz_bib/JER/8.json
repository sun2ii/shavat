{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_bib","name":"Ermiyaas","commonName":"Ermiyaas","title":"Raajii Ermiyaas","order":24,"numberOfChapters":52,"sha256":"c0724fd0dceb470d1f8ccad4fd77ed6e806f779318036d4e9816804b25353f68","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["“ ‘Bara sana lafeen moototaatii fi qondaaltota Yihuudaa, lafeen lubootaatii fi raajotaa, lafeen namoota Yerusaalem awwaala isaanii keessaa ni baafama’ jedha Waaqayyo."]},{"type":"verse","number":2,"content":["‘Isaan fuula aduu fi jiʼaa duratti, fuula guutummaa urjiiwwan samii hundaa, kanneen jaallatanii fi tajaajilanii, kanneen faana buʼanii gorsa gaafatanii fi waaqeffatan sanaa duratti ni saaxilamu. Isaan akkuma kosii lafatti gatamee taʼan malee walitti hin qabaman yookaan hin awwaalaman."]},{"type":"verse","number":3,"content":["Hambaan saba hamaa kanaa hundi lafa ani itti isaan ariʼu hundatti jireenya irra duʼa filata’ jedha Waaqayyo Waan Hunda Dandaʼu."]},{"type":"heading","content":["Cubbuu fi Adabbii"]},{"type":"verse","number":4,"content":["“Ati akkana isaaniin jedhi; ‘Waaqayyo akkana jedha:",{"text":"“ ‘Namoonni yoo kufan hin kaʼanii?","poem":1},{"text":"Namni tokko yoo karaa irraa bade hin deebiʼuu?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yoos sabni kun maaliif karaa irraa jalʼata?","poem":1},{"text":"Yerusaalem maaliif yeroo hunda karaa irraa jalʼatti?","poem":2},{"text":"Isaan gowwoomsaatti cichu;","poem":1},{"text":"deebiʼuus ni didu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani qalbeeffadhee dhaggeeffadheera;","poem":1},{"text":"isaan garuu waan qajeelaa hin dubbatan.","poem":2},{"text":"Namni tokko iyyuu, “Ani maalan balleesse?” jedhee","poem":1},{"text":"hammina isaa irraa hin deebiʼu.","poem":2},{"text":"Tokkoon tokkoon isaanii akkuma farda lolatti gulufuu","poem":1},{"text":"karaa ofii isaanii irra qajeelu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Huummoon samii keessaa iyyuu","poem":1},{"text":"waqtii isheef murtaaʼe ni beekti;","poem":2},{"text":"gugeen, daalotee fi cuquliisnis","poem":1},{"text":"yeroo godaansa isaanii ni eegu.","poem":2},{"text":"Sabni koo garuu","poem":1},{"text":"seera Waaqayyoo hin beeku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ ‘Isin akkamitti, “Nu seera Waaqayyoo","poem":1},{"text":"waan qabnuuf ogeeyyii dha” jechuu dandeessu?","poem":2},{"text":"Garuu kunoo, qalamni sobaa","poem":1},{"text":"kan barreessitootaa sobee barreesseera.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Namoonni ogeeyyiin ni qaaneffamu;","poem":1},{"text":"isaan naʼanii kiyyoodhaan ni qabamu;","poem":2},{"text":"isaan erga dubbii Waaqayyoo tuffatanii,","poem":1},{"text":"ogummaa akkamii qabu ree?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kanaafuu ani niitota isaanii namoota biraatiif,","poem":1},{"text":"lafa qotiisaa isaanii immoo moʼattootaaf nan kenna.","poem":2},{"text":"Xinnaadhaa hamma guddaatti","poem":1},{"text":"hundi isaanii iyyuu buʼaa argachuuf gaggabu;","poem":2},{"text":"raajonnii fi luboonnis akkasuma","poem":1},{"text":"hundi isaanii nama gowwoomsu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isaan madaa saba kootii,","poem":1},{"text":"akkuma waan xinnaa tokkootti ilaalanii walʼaanu.","poem":2},{"text":"Utuu nagaan hin jiraatinis","poem":1},{"text":"“Nagaa, nagaa” jedhu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Isaan amala isaanii jibbisiisaa sanatti ni qaanaʼuu?","poem":1},{"text":"Lakkii, isaan qaanii tokko iyyuu hin qaban;","poem":2},{"lineBreak":true},{"text":"qaanaʼuun maal akka taʼe iyyuu hin beekan.","poem":2},{"text":"Kanaafuu isaan warra kufan wajjin ni kufu;","poem":1},{"text":"yeroo adabamanitti gad gatamu","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ ‘Ani guutumaan guutuutti isaan nan balleessa;","poem":1},{"text":"jedha Waaqayyo.","poem":2},{"lineBreak":true},{"text":"Wayinii irratti iji hin argamu.","poem":2},{"text":"Iji harbuu muka harbuu irratti hin argamu.","poem":1},{"text":"Baalli isaaniis ni coollaga.","poem":2},{"text":"Wanni ani isaaniif kenne","poem":1},{"text":"isaan irraa ni fudhatama.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Nu maaliif as teenya?","poem":1},{"text":"Walitti qabamaa!","poem":2},{"text":"Kottaa gara magaalaawwan","poem":1},{"text":"dallaa jabaa qabaniitti baqannee achitti haa dhumnu!","poem":2},{"text":"Waan nu cubbuu isatti hojjenneef","poem":1},{"text":"Waaqayyo Waaqni keenya badiisattidabarsee nu kenneeraatii;","poem":2},{"lineBreak":true},{"text":"akka dhugnuufis bishaan summaaʼaa nuu kenneera.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nu nagaa abdanne;","poem":1},{"text":"garuu wanni gaariin tokko iyyuu hin dhufne;","poem":2},{"text":"nu yeroo fayyinaa abdanne;","poem":1},{"text":"garuu goolii qofatu ture.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Daan keessaa korrisuu fardeen diinaatu dhagaʼama;","poem":1},{"text":"guutuun biyyattii himimsuu korommii fardeen isaaniitiin hollatti.","poem":2},{"text":"Isaan biyyattii fi waan ishee keessa jiru hunda,","poem":1},{"text":"magaalaa fi warra ishee keessa jiraatan hunda,","poem":2},{"lineBreak":true},{"text":"balleessuuf dhufaniiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Ani kunoo bofa hadhaa qabu,","poem":1},{"text":"buutii falfalli dawweessuu hin dandeenye isinitti nan erga;","poem":2},{"lineBreak":true},{"text":"isaanis isin iddu”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Yaa isa gadda keessatti na Jajjabeessitu,","poem":1},{"text":"onneen koo na keessatti gaggabdeerti.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kunoo, iyyi saba kootii","poem":1},{"text":"biyya fagoodhaa ni dhagaʼama:","poem":2},{"text":"“Waaqayyo Xiyoon keessa hin jiruu?","poem":1},{"text":"Mootiin ishee achi hin jiruu?”","poem":2},{"lineBreak":true},{"text":"“Isaan maaliif fakkiiwwan isaaniitiin,","poem":1},{"text":"waaqota isaanii tolfamoo biyya ormaatiindheekkamsaaf na kakaasu?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Yeroon itti midhaan galfamu darbeera;","poem":1},{"text":"bonnis hobbaʼeera;","poem":2},{"lineBreak":true},{"text":"nu garuu hin fayyine.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Sabni koo waan miidhameef anis miidhameera;","poem":1},{"text":"Ani nan booʼe; sodaan guddaanis na qabate.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Qorichi dibatan Giliʼaad keessa hin jiruu?","poem":1},{"text":"Abbaan qorichaa tokko iyyuu achi hin jiruu?","poem":2},{"text":"Yoos madaan intala saba kootii","poem":1},{"text":"maaliif hin fayyu ree?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/JER/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JER/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JER/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}