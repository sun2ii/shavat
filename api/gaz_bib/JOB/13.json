{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_bib","name":"Iyyoob","commonName":"Iyyoob","title":"Kitaaba Iyyoob","order":18,"numberOfChapters":42,"sha256":"80fa6ab826a476ea21d26038ed348be18761b21678a32ebf28e5047e79675a1b","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"“Waan kana hunda iji koo argeera;","poem":1},{"text":"gurri koos dhagaʼee hubateera.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Waan isin beektan anis beeka;","poem":1},{"text":"ani isinii gad miti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ani garuu Waaqa Waan Hunda Dandaʼutti nan dubbadha;","poem":1},{"text":"waaʼee dhimma koos Waaqatti falmuu nan barbaada.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isin garuu sobaan nama faaltu;","poem":1},{"text":"hundi keessan abbootii qorichaa","poem":2},{"lineBreak":true},{"text":"kanneen faayidaa hin qabnee dha!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isin yoo cal jettan maal qaba!","poem":1},{"text":"Wanni sun ogummaa isiniif taʼa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Amma falmii koo dhagaʼaa;","poem":1},{"text":"kadhannaa afaan kootiis dhaggeeffadhaa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Isin jalʼinaan Waaqaaf dubbattuu?","poem":1},{"text":"Gowwoomsaadhaanis isaaf odeessituu?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Isaaf ni loogduu?","poem":1},{"text":"Waaqaafis ni falmituu?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yoo inni isin qore wanni gaariin isin irraa argamaa?","poem":1},{"text":"Isin akka nama gowwoomsitan, isa gowwoomsuu dandeessuu?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yoo isin dhoksaadhaan loogii hojjettan,","poem":1},{"text":"inni dhugumaan isinitti dheekkama.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Surraan isaa isin hin sodaachisuu?","poem":1},{"text":"Sodaachisuun isaa isinitti hin dhagaʼamuu?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Fakkeenyi keessan fakkeenya daaraa ti;","poem":1},{"text":"daʼoon keessanis daʼoo suphee ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Akka ani dubbadhuuf isin cal jedhaa;","poem":1},{"text":"ergasii wanni barbaade natti haa dhufu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ani maaliifin foon koo ilkaan kootiin,","poem":1},{"text":"lubbuu koos harka kootiin qabadha?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yoo inni na ajjeese iyyuu ani isa nan abdadha;","poem":1},{"text":"waaʼee dhimma kootii illee fuula isaa duratti nan falmadha.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kun fayyina koo ni taʼa; warri Waaqatti hin bulle","poem":1},{"text":"fuula isaa duratti dhiʼaachuu hin dandaʼaniitii!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dubbii koo qalbeeffadhaa dhaggeeffadhaa;","poem":1},{"text":"waan ani jedhus gurri keessan haa dhagaʼu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kunoo ani himata koo qopheeffadheera;","poem":1},{"text":"akka inni murtii qajeelaa naa kennus nan beeka.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Namni na himatu jiraa?","poem":1},{"text":"Yoo jiraate, ani nan calʼisa; nan duʼas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Yaa Waaqayyo, ati wantoota kanneen lamaan naa kenni malee","poem":1},{"text":"ani fuula kee duraa hin dhokadhu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Harka kee narraa fageessi;","poem":1},{"text":"sodaachisni kees na hin rifachiisin.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ergasii na waami; anis nan owwaadha;","poem":1},{"text":"yookaan nan dubbadha; ati immoo deebii naa kennita.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ani balleessaa fi cubbuu hammamin hojjedhe?","poem":1},{"text":"Yakka kootii fi cubbuu koo na beeksisi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ati maaliif fuula kee dhokfattee","poem":1},{"text":"akka diinaatti na ilaalta?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Baala qilleensi harcaase ni ciccirtaa?","poem":1},{"text":"Habaqii gogaa ni ariitaa?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ati waan ittiin na hadheessitu natti barreessitaatii;","poem":1},{"text":"cubbuu dargaggummaa kootiis na dhaalchifta.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Miilla koo jirma gidduu galchita;","poem":1},{"text":"faana miilla kootiitti mallattoo gootee","poem":2},{"lineBreak":true},{"text":"karaa koo hunda xiyyeeffattee duukaa buuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Namnis akkuma waan bososeetti,","poem":1},{"text":"akkuma wayyaa biliin nyaateetti ni dhuma.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}