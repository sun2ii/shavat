{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_bib","name":"Iyyoob","commonName":"Iyyoob","title":"Kitaaba Iyyoob","order":18,"numberOfChapters":42,"sha256":"80fa6ab826a476ea21d26038ed348be18761b21678a32ebf28e5047e79675a1b","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"“Nama dubartoota irraa dhalate,","poem":1},{"text":"barri isaa gabaabaa fi kan rakkinaan guutamee dha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inni akkuma daraaraa ni biqila; ni coollagas;","poem":1},{"text":"akkuma gaaddidduu ariifatee darba malee hin turu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iji kee nama akkasii xiyyeeffatee ilaalaa?","poem":1},{"text":"Ati murtiif fuula kee duratti isa fiddaa?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Eenyutu waan xuraaʼaa keessaa waan qulqullaaʼaa baasuu dandaʼa?","poem":1},{"text":"Namni tokko iyyuu hin dandaʼu!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Barri jireenya namaa murtaaʼaa dha;","poem":1},{"text":"baayʼinni jiʼoota isaas si bira jira;","poem":2},{"lineBreak":true},{"text":"daangaa inni darbuu hin dandeenye daangessiteefii jirta.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hamma inni akka hojjetaa tokkootti bara isaa raawwatutti,","poem":1},{"text":"fuula kee isa irraa deebifadhu; isas dhiisi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Mukni illee abdii qaba:","poem":1},{"text":"Yoo murame deebiʼee ni lata;","poem":2},{"lineBreak":true},{"text":"dameen isaa haaraanis hin gogu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yoo gufuun isaa lafa keessatti dulloomee","poem":1},{"text":"gufuun isaa biyyoo keessatti tortore iyyuu,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"foolii bishaaniitiin lata;","poem":1},{"text":"akka biqiltuuttis damee ni baafata.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Namni garuu duʼee awwaalama;","poem":1},{"text":"lubbuun isaa keessaa baati; innis hin jiraatu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Akkuma bishaan galaanaa gogu","poem":1},{"text":"yookaan lagnis dhumee gogu sana,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"namnis akkasuma ni ciisa; hin kaʼus;","poem":1},{"text":"hamma samiiwwan darbanittis hin dammaqu","poem":2},{"lineBreak":true},{"text":"yookaan hirribaa hin kaʼu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Maaloo utuu awwaala keessa na dhoksitee","poem":1},{"text":"hamma dheekkamsi kee darbutti na haguugdee!","poem":2},{"text":"Maaloo utuu beellama naa kennitee","poem":1},{"text":"ergasii immoo na yaadattee!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Namni tokko yoo duʼe deebiʼee ni jiraataa?","poem":1},{"text":"Ani hamma haaromfamni koo dhufutti,","poem":2},{"lineBreak":true},{"text":"bara rakkoo koo hunda obsaan nan eeggadha.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ati na waamta; anis si jalaa nan owwaadha;","poem":1},{"text":"hojii harka keetiis ni hawwita.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yeroo sana ati tarkaanfii koo ni lakkoofta;","poem":1},{"text":"cubbuu koo garuu hin toʼattu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yakki koo korojootti naqamee chaappeffama;","poem":1},{"text":"ati cubbuu koo ni haguugda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Garuu akkuma tulluun lolaadhaan dhiqamee jigu,","poem":1},{"text":"kattaanis iddoo isaatii buqqaʼu sana,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"akkuma bishaan dhagaa nyaatee haphisu,","poem":1},{"text":"akkuma lolaan biyyoo dhiqu sana,","poem":2},{"lineBreak":true},{"text":"atis akkasuma abdii namaa ni balleessita.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ati bara baraan isa ni moota; innis ni bada;","poem":1},{"text":"bifa isaa ni geeddarta; of irraas isa fageessita.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yoo ilmaan isaa ulfina argatan inni hin beeku;","poem":1},{"text":"yoo isaan salphatanis hin argu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Dhukkuba dhagna isaa qofatu isatti dhagaʼama;","poem":1},{"text":"inni mataa isaa qofaaf booʼa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}