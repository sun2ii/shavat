{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_bib","name":"Iyyoob","commonName":"Iyyoob","title":"Kitaaba Iyyoob","order":18,"numberOfChapters":42,"sha256":"80fa6ab826a476ea21d26038ed348be18761b21678a32ebf28e5047e79675a1b","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"Hafuurri koo dadhabeera;","poem":1},{"text":"barri koo gabaabbateera;","poem":2},{"lineBreak":true},{"text":"awwaallis naa qopheeffameera.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dhugumaan qoostonni na marsaniiru;","poem":1},{"text":"iji koos hojii isaanii isa hamaa sana hubatee ilaala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Yaa Waaqi, qabsiisa naa taʼi;","poem":1},{"text":"si malee eenyutu wabii naa taʼa?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Akka isaan waa hin hubanneef ati sammuu isaanii cufteerta;","poem":1},{"text":"kanaafuu ati akka isaan moʼatan hin gootu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yoo namni tokko faayidaa argachuuf","poem":1},{"text":"michuu isaa maqaa balleesse, iji ijoollee isaa ni jaama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Waaqni nama hunda biratti nama kolfaa,","poem":1},{"text":"nama namni fuula isaatti tufu na godheera.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iji koo sababii gaddaatiif arguu dhabe;","poem":1},{"text":"dhagni koo guutuunis akkuma gaaddidduu ti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Qajeeltonni waan kanaan ni rifatu;","poem":1},{"text":"namni balleessaa hin qabnes warra Waaqatti hin bulle irratti kaʼa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Qajeelaan garuu karaa isaatti cima;","poem":1},{"text":"warri harki isaanii qulqulluu taʼes jabaachaa deemu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Hundi keessan garuu mee deebiʼaa yaalaa!","poem":1},{"text":"Ani isin keessaa nama ogeessa tokko illee hin argadhu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Barri koo darbeera; karoorri koo fashalaaʼeera;","poem":1},{"text":"hawwiin garaa koos akkasuma taʼeera.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Namoonni kunneen halkan guyyaatti geeddaraniiru;","poem":1},{"text":"utuma dukkana arganuus, ‘Ifni dhiʼaateera’ jedhu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yoo manni ani abdadhu awwaala qofa taʼe,","poem":1},{"text":"yoo ani dukkana keessatti siree koo afadhe,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"yoo ani boolla qileetiin, ‘Ati abbaa koo ti;’","poem":1},{"text":"raammoodhaan immoo, ‘Ati haadha koo ti;’","poem":2},{"lineBreak":true},{"text":"yookaan ‘Obboleettii koo ti’ jedhe,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"egaa abdiin koo eessa jira?","poem":1},{"text":"Eenyutus abdii tokko illee naa arga?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Inni na wajjin awwaala buʼaa?","poem":1},{"text":"Nus walumaan biyyoo seennaa?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}