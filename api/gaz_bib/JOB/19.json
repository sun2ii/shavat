{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_bib","name":"Iyyoob","commonName":"Iyyoob","title":"Kitaaba Iyyoob","order":18,"numberOfChapters":42,"sha256":"80fa6ab826a476ea21d26038ed348be18761b21678a32ebf28e5047e79675a1b","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":19,"content":[{"type":"heading","content":["Iyyoob"]},{"type":"verse","number":1,"content":["Iyyoobis akkana jedhee deebise:"]},{"type":"verse","number":2,"content":[{"text":"“Isin hamma yoomiitti na dhiphistanii","poem":1},{"text":"dubbiin na cabsitu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Amma siʼa kudhan na arrabsitaniirtu;","poem":1},{"text":"qaanii malees na miitaniirtu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yoo ani dhugumaan karaa irraa goree jiraadhe,","poem":1},{"text":"dogoggorri koo anuma wajjin jiraata.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yoo isin dhugumaan anaa olitti of guddiftanii","poem":1},{"text":"na miidhuuf salphina kootti fayyadamtan,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"akka Waaqni na miidhee","poem":1},{"text":"kiyyoo isaa illee natti xaxe beekaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ ‘Ani miidhameera!’ jedhee iyyadhu illee deebii hin argadhu;","poem":1},{"text":"sagalee ol fudhadhee gargaarsaaf iyyusmurtiin qajeelaan hin jiru.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Akka ani hin dabarreef inni karaa koo cufeera;","poem":1},{"text":"daandii koottis dukkana haguugeera.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ulfina koo narraa mulqeera;","poem":1},{"text":"mataa koo irraas gonfoo fuudheera.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Inni hamma ani badutti gama hundaan na diiga;","poem":1},{"text":"abdii koo illee akkuma mukaa buqqisa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dheekkamsi isaa natti bobaʼa;","poem":1},{"text":"akkuma diina isaattis na heda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Loltoonni isaa humnaan dhufanii","poem":1},{"text":"naannoo kootti daʼannaa ijaarratan;","poem":2},{"lineBreak":true},{"text":"dunkaana koos ni marsan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Inni obboloota koo narraa fageesseera;","poem":1},{"text":"michoonni koos keessummaa natti taʼan.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Firoonni koo na dhiisaniiru;","poem":1},{"text":"michuuwwan koos na dagataniiru.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Keessumoonni mana koo jiranii fi","poem":1},{"text":"xomboreewwan koo akka alagaatti na ilaalan;","poem":2},{"lineBreak":true},{"text":"akka nama ormaattis na hedan.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hojjetaa koo nan waama;","poem":1},{"text":"afaan kootiinis isa nan kadhadha;","poem":2},{"lineBreak":true},{"text":"inni garuu na jalaa hin owwaatu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hafuurri koo niitii kootti illee jibbisiisaa dha;","poem":1},{"text":"ani obboloota koottis xiraaʼaa dha.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ijoolleen xixinnoon iyyuu na tuffatu;","poem":1},{"text":"yommuu ani kaʼus natti qoosu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Michoonni koo kanneen walitti dhiʼaannu hundi na balfan;","poem":1},{"text":"warri ani jaalladhus natti garagalan.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ani gogaa fi lafeedha malee homaa miti;","poem":1},{"text":"gogaan ilkaanii qofti naaf hafeen jalaa baʼe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Garaa naa laafaa, yaa michoota koo garaa naa laafaa;","poem":1},{"text":"harki Waaqaa na dhaʼeeraatii.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Isin maaliif akkuma Waaqni na ariʼu sana na ariitu?","poem":1},{"text":"Amma illee foon koo isin hin geenyee?","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“Maaloo utuu dubbiin koo barreeffamee jiraatee!","poem":1},{"text":"Utuu kitaaba keessatti barreeffamee!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Utuu sibiilaan kattaa irratti barreeffamee","poem":1},{"text":"yookaan bara baraan dhagaa irratti qirixamee jiraatee!","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ani akka furiin koo jiraataa taʼe,","poem":1},{"text":"akka inni dhuma irratti lafa irra dhaabatus nan beeka.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Erga gogaan koo badee booddee,","poem":1},{"text":"ani amma iyyuu foon kootiin Waaqa nan arga;","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ani mataan koo isa nan arga;","poem":1},{"text":"utuu nama biraa hin taʼin anuu ija kootiin isa nan arga.","poem":2},{"lineBreak":true},{"text":"Onneen koo akkam na keessatti gaggabdi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Yoo isin, ‘Sababii hiddi rakkina sanaa isa keessa jiruuf","poem":1},{"text":"nu akkamitti isa ariina?’ jettan,","poem":2}]},{"type":"verse","number":29,"content":[{"text":"sababii dheekkamsi goraadeedhaan adabamuu fiduuf","poem":1},{"text":"isin mataan keessan goraadee sodaachuu qabdu;","poem":2},{"lineBreak":true},{"text":"kunis akka isin akka murtiin jiru beektaniif.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}