{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_bib","name":"Iyyoob","commonName":"Iyyoob","title":"Kitaaba Iyyoob","order":18,"numberOfChapters":42,"sha256":"80fa6ab826a476ea21d26038ed348be18761b21678a32ebf28e5047e79675a1b","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"Dhugumaan iddoon meetiin keessaa qotamu,","poem":1},{"text":"lafti warqeen itti baafamee qulqulleeffamu jira.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sibiilli lafa keessaa baafama;","poem":1},{"text":"sibiilli diimaan immoo dhagaa albuudaa irraa baqfama.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Namni hamma dhuma dukkanaatti deema;","poem":1},{"text":"moggaa akka malee fagoo dhaqees,","poem":2},{"lineBreak":true},{"text":"dukkana hamaa keessa dhagaa albuudaa barbaada.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inni lafa namoonni jiraatan irraa fagaatee","poem":1},{"text":"iddoo miilli namaa ejjetee hin beeknetti boolla qota;","poem":2},{"lineBreak":true},{"text":"namoota irraa fagaatee ni rarraʼa; asii fi achis ni raafama.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lafa irraa garuu nyaatatu argama;","poem":1},{"text":"jala isheetiin immoo akka waan ibidda taateetti geeddaramti;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"dhagaan isaa burqaa sanpeerii ti;","poem":1},{"text":"biyyoon isaas warqee qaba.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Allaattiin tokko iyyuu karaa dhokfame sana hin beeku;","poem":1},{"text":"iji culullees karaa sana hin argine.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bineensonni sodaachisoon irra hin ejjenne;","poem":1},{"text":"leencis karaa sana hin darbine.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Harki namaa dhagaa jabaa cabsa;","poem":1},{"text":"hundee tulluuwwanii immoo ni gaggaragalcha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Inni kattaa keessaan karaa baasa;","poem":1},{"text":"iji isaas waan gatii guddaa hunda arga.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Madda lageenii ni sakattaʼa;","poem":1},{"text":"waan dhokfames ifatti ni baasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ogummaan garuu eessaa argamti?","poem":1},{"text":"Hubannaanis eessa jiraata?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Namni gatii isaa hin beeku;","poem":1},{"text":"inni biyya jiraattotaa keessatti hin argamu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tujubni, “Inni na keessa hin jiru” jedha;","poem":1},{"text":"galaannis, “Inni na bira hin jiru” jedha.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Warqeen qulqulluun isa bituu hin dandaʼu;","poem":1},{"text":"gatiin isaas meetiidhaan hin madaalamu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Warqee Oofiiriitti, dhagaa gatii guddaa sardooniksiitti","poem":1},{"text":"yookaan sanpeeriitti hin tilmaamamu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Warqee fi dhagaan akka bilillee calaqqisu ittiin hin qixxaatu;","poem":1},{"text":"inni faaya warqee qulqulluutiin hin geeddaramu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Elellaanii fi dooqni akka waan gatii qabaniitti hin hedaman;","poem":1},{"text":"gatiin ogummaa lula diimaa caala.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tophaaziyooniin Itoophiyaa itti qixxaatu;","poem":1},{"text":"warqee qulqulluudhaanis bitamuu hin dandaʼu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yoos ogummaan eessaa dhufti ree?","poem":1},{"text":"Hubannaanis eessa jiraatti?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Isheen ija uumama hundaa jalaa dhokatteerti;","poem":1},{"text":"simbirroota samii jalaas baddeerti.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Badiisnii fi Duuti, “Nu oduu ishee qofa","poem":1},{"text":"gurra keenyaan dhageenye” jedhu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Waaqa qofatu daandii gara ishee geessu hubatee,","poem":1},{"text":"lafa inni jiraatus beeka;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"inni handaara lafaa ni ilaala;","poem":1},{"text":"waan samii jala jiru hunda ni argaatii.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Inni yommuu bubbeedhaaf humna kennee","poem":1},{"text":"bishaanota safaretti,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"yommuu bokkaadhaaf seera dhaabee","poem":1},{"text":"bakakkaaf immoo daandii baasetti,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"inni ogummaa ilaalee madaale;","poem":1},{"text":"jabeessee dhaabee ishee qorate.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ergasii ilmaan namaatiin,","poem":1},{"text":"“Gooftaa sodaachuun ogummaa;","poem":2},{"lineBreak":true},{"text":"waan hamaa irraa fagaachuunis hubannaa dha” jedhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}