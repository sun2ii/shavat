{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_bib","name":"Iyyoob","commonName":"Iyyoob","title":"Kitaaba Iyyoob","order":18,"numberOfChapters":42,"sha256":"80fa6ab826a476ea21d26038ed348be18761b21678a32ebf28e5047e79675a1b","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":3,"content":[{"type":"heading","content":["Dubbii Iyyoob"]},{"type":"verse","number":1,"content":["Kana irratti Iyyoob afaan isaa banatee guyyaa itti dhalate abaare."]},{"type":"verse","number":2,"content":["Innis akkana jedhe:"]},{"type":"heading","content":["Iyyoob"]},{"type":"verse","number":3,"content":[{"text":"“Guyyaan ani itti dhaladhe haa badu;","poem":1},{"text":"halkan, ‘Ilmi dhalate!’ jedhame sunis haa badu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Guyyaan sun haa dukkanaaʼu;","poem":1},{"text":"Waaqni ol gubbaadhaa isa hin ilaalin;","poem":2},{"lineBreak":true},{"text":"ifnis itti hin ifin.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dukkannii fi gaaddidduun guddaan isa haa dhaalan;","poem":1},{"text":"duumessi isa irra haa buʼu;","poem":2},{"lineBreak":true},{"text":"ifa isaa dukkanni haa liqimsu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Halkan sana dukkanni limixiin haa qabatu;","poem":1},{"text":"guyyoota waggaa keessa jiranittis hin dabalamin","poem":2},{"lineBreak":true},{"text":"yookaan jiʼoota kam iyyuu keessatti hin lakkaaʼamin.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Halkan sun haa maseenu;","poem":1},{"text":"ililleenis keessatti hin dhagaʼamin.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Warri Lewaataanin kakaasuuf qophaaʼan,","poem":1},{"text":"kanneen guyyoota abaaran guyyaa sana haa abaaran.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bakkalchi barii kan guyyaa sanaa haa dukkanaaʼu;","poem":1},{"text":"ifa eeggatee haa dhabu;","poem":2},{"lineBreak":true},{"text":"boruu baqaqus hin argin.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Inni ija koo duraa rakkina dhoksuuf,","poem":1},{"text":"balbala gadameessa haadha kootii natti hin cufneetii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Ani maaliif gadameessa haadha kootii keessatti hin badin?","poem":1},{"text":"Maaliifis yeruman garaa keessaa baʼetti hin duʼin?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Jilbawwan na simatan,","poem":1},{"text":"harmawwan ani hodhus maaliif achitti argaman?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ani silaa yoona nagaan nan ciisa;","poem":1},{"text":"rafees nan boqodhan tureetii;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"moototaa fi gorsitoota addunyaa","poem":1},{"text":"warra iddoowwan amma diigamanii jiran ofii isaaniitiif qopheeffatan wajjin,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"bulchitoota warqee qaban, kanneen manneen isaanii","poem":1},{"text":"meetiidhaan guutatan wajjin nan boqodhan ture.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yookaan ani maaliifin akkuma mucaa duʼee garaa baʼee,","poem":1},{"text":"akkuma daaʼima ifa guyyaa hin arginiitti hin awwaalamin?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Achittis namoonni hamoonni jeequu ni dhiisu;","poem":1},{"text":"dadhaboonnis achitti ni boqotu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Boojiʼamtoonni nagaadhaan walii wajjin jiraatu;","poem":1},{"text":"waca cunqursitoota isaaniis hin dhagaʼan.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Xinnaa fi guddaan achi jira;","poem":1},{"text":"garbichis gooftaa isaa jalaa bilisoomeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Maaliif warra gadadoo keessa jiraniif ifni","poem":1},{"text":"warra lubbuun isaanii gadditeef immoo jireenyi kennama?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Warra duʼa hawwanii dhabaniif","poem":1},{"text":"warra qabeenya dhokfame caalaa duʼa barbaadaniif","poem":2}]},{"type":"verse","number":22,"content":[{"text":"warra yommuu awwaalamuu gaʼanitti","poem":1},{"text":"gammachuun guutamanii ililchaniif jireenyi maaliif kennama?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nama karaan isaa duraa dhokateef","poem":1},{"text":"nama Waaqni dallaa itti marse","poem":2},{"lineBreak":true},{"text":"jireenyi maaliif kennama?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Gaddi buddeena naa taʼeera;","poem":1},{"text":"aaduun koos akka bishaanii dhangalaʼa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Wanni ani sodaadhe natti dhufeera;","poem":1},{"text":"wanni na naasisus narra gaʼeera.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ani nagaa hin qabu; tasgabbiis hin qabu;","poem":1},{"text":"jeequmsa malee boqonnaa hin qabu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}