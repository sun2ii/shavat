{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_bib","name":"Iyyoob","commonName":"Iyyoob","title":"Kitaaba Iyyoob","order":18,"numberOfChapters":42,"sha256":"80fa6ab826a476ea21d26038ed348be18761b21678a32ebf28e5047e79675a1b","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":38,"content":[{"type":"heading","content":["Waaqayyo Ni dubbata"]},{"type":"verse","number":1,"content":["Kana irratti Waaqayyo bubbee jabaa keessaa Iyyoobitti dubbate. Akkana jedhes:"]},{"type":"verse","number":2,"content":[{"text":"“Namni dubbii beekumsa malee","poem":1},{"text":"dubbatamuun karoora koo dukkanneessu kun eenyu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mee akka gootaa mudhii kee hidhadhu;","poem":1},{"text":"ani sin gaafadha;","poem":2},{"lineBreak":true},{"text":"ati immoo deebii naa kenni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Yeroo ani hundee lafaa kaaʼetti ati eessa turte?","poem":1},{"text":"Yoo hubatte mee natti himi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Eenyutu balʼina ishee murteesse? Dhugumaan ni beektaa?","poem":1},{"text":"Eenyutu ulee safaraa ishee irra harkise?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hundeen ishee maal irra dhaabame?","poem":1},{"text":"Yookaan eenyutu dhagaa golee ishee dhaabe?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kunis yeroo bakkalchoonni barii walii wajjin faarfatanitti,","poem":1},{"text":"yeroo ilmaan Waaqayyoos ililchanitti ture.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Yeroo galaanni cabsee garaa lafaa keessaa baʼetti","poem":1},{"text":"eenyutu balbala itti cufee ittise?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yeroo ani duumessoota uffata isaa godhee","poem":1},{"text":"dukkana guddaan maretti,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"yeroo ani daangaa isaa dhaabee","poem":1},{"text":"balbalaa fi danqaraa hojjedheefitti,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"anis, ‘Ati hamma asiitti dhufta; garuu darbuu hin dandeessu;","poem":1},{"text":"dambaliin of jajuu keetii illee asumatti dhaabata!’ jedheen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Ati bara jireenya keetii barraaqa ajajjee","poem":1},{"text":"yookaan barii obborootti iddoo isaa argisiiftee beektaa?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Akka inni handaara lafaa qabatee","poem":1},{"text":"namoota hamoo achi keessaa hurgufu gooteertaa?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Lafti akka suphee chaappaa jala jiruutti bifa geeddaratti;","poem":1},{"text":"bifti ishees akka bifa uffataatti mulʼata.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hamoonni ifa isaanii dhowwatamaniiru;","poem":1},{"text":"irreen isaanii inni ol kaʼes cabeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Ati gara burqaa galaanaa gad buutee","poem":1},{"text":"yookaan tuujuba bishaanii seentee hundee isaa irra deemtee beektaa?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Karri duʼaa sitti mulʼifameeraa?","poem":1},{"text":"Karra gaaddidduu duʼaas argiteertaa?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Balʼina lafaa guddaa sana hubatteertaa?","poem":1},{"text":"Yoo kana hunda beekte dubbadhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Karaan iddoo ifni jirutti nama geessu kami?","poem":1},{"text":"Dukkannis eessa jiraata?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Iddoo isaaniitti isaan geessuu dandeessaa?","poem":1},{"text":"Daandii lafa jireenya isaaniitti geessu beektaa?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ati dhugumaan ni beekta; yeroo sana dhalatteertaatii!","poem":1},{"text":"Ati bara hedduu jiraatteerta!","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Mankuusa cabbii seentee yookaan mankuusa","poem":1},{"text":"dhagaa cabbii argiteertaa?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kan ani yeroo rakkinaatiif,","poem":1},{"text":"guyyaa waraanaa fi lolaatiif ol kaaʼadhe argiteertaa?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Karaan iddoo ifni itti bittinnaaʼutti","poem":1},{"text":"yookaan gara iddoo bubbeen baʼaa itti lafa irra faffacaʼuutti nama geessu kami?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Eenyutu lolaadhaaf boʼoo,","poem":1},{"text":"bakakkaadhaaf immoo daandii baasee,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"lafa namni tokko iyyuu keessa hin jiraanne,","poem":1},{"text":"gammoojjii namni tokko iyyuu keessa hin jirre bishaan obaasuuf,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"lafa namni keessa hin jiraannee fi lafa onaa quubsee","poem":1},{"text":"margas itti biqilchu eenyu?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Roobni abbaa qabaa?","poem":1},{"text":"Copha fixeensaa eenyutu dhalche?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Cabbiin garaa eenyuutii baʼa?","poem":1},{"text":"Qorra samii eenyutu dhala?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Bishaanonni akka dhagaa jabaatu,","poem":1},{"text":"fuulli tuujubaas akka cabbii taʼa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Urjiiwwan babbareedoo Torbii jedhaman hidhuu ni dandeessaa?","poem":1},{"text":"Yookaan hidhaa Urjii Sadee jedhamuu hiikuu ni dandeessaa?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Tuuta urjiiwwanii waqtiilee isaaniitti fiduu","poem":1},{"text":"yookaan urjii Amaaketa jedhamu ilmaan isaa wajjin bobbaasuu ni dandeessaa?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Seera samiiwwanii beektaa?","poem":1},{"text":"Bulchiinsa isaanii lafa irratti hundeessuu ni dandeessaa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Ati sagalee kee gara duumessaatti ol fudhattee,","poem":1},{"text":"lolaa bishaaniitiin of haguuguu ni dandeessaa?","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ati bakakkaa daandii isaa irra erguu ni dandeessaa?","poem":1},{"text":"Innis, ‘Kunoo ani asan jira’ siin jedhaa?","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Eenyutu yaada garaatiif ogummaa","poem":1},{"text":"yookaan sammuudhaaf hubannaa kenne?","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Eenyutu duumessoota lakkaaʼuuf ogummaa qaba?","poem":1},{"text":"Eenyutu okkotee bishaan samii","poem":2}]},{"type":"verse","number":38,"content":[{"text":"yeroo biyyoon jabaattutti,","poem":1},{"text":"yeroo supheen wal qabattutti jalʼisuu dandaʼa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“Ati leenca dhalaadhaaf nyaata adamsitee","poem":1},{"text":"saafela leencaas beela baaftee","poem":2}]},{"type":"verse","number":40,"content":[{"text":"yeroo isaan manʼee isaanii keessatti riphanitti","poem":1},{"text":"yookaan yeroo isaan daggala keessatti riphaniiwaa eeggatanitti beela ni baaftaa?","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Eenyutu yeroo ilmaan ishee gara Waaqaatti iyyan,","poem":1},{"text":"yeroo isaan nyaata dhabanii jooranitti,","poem":2},{"lineBreak":true},{"text":"arraagessaaf nyaata kenna?","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JOB/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JOB/37.json","previousChapterAudioLinks":{},"numberOfVerses":41}