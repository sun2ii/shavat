{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_bib","name":"Iyyoob","commonName":"Iyyoob","title":"Kitaaba Iyyoob","order":18,"numberOfChapters":42,"sha256":"80fa6ab826a476ea21d26038ed348be18761b21678a32ebf28e5047e79675a1b","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":39,"content":[{"type":"heading","content":["Iyyoob"]},{"type":"verse","number":1,"content":[{"text":"“Yeroo itti qellejjeen dhaltu beektaa?","poem":1},{"text":"Yeroo itti borofni ilmoo ishee dhaltu argiteertaa?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jiʼa isaan garaatti ilmaan baatan ni lakkooftaa?","poem":1},{"text":"Yeroo isaan itti dhalan ni beektaa?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isaan jilbeenfatanii ilmaan isaanii dhalu;","poem":1},{"text":"foolachuu isaaniis ni hobbaafatu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ilmaan isaanii ni jabaatu; alattis ni guddatu;","poem":1},{"text":"baʼanii ni deemu; hin deebiʼanis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Eenyutu harree diidaa gad dhiise?","poem":1},{"text":"Funyoo isaas eenyutu hiike?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani gammoojjii mana isaa,","poem":1},{"text":"lafa soogiddaas iddoo jireenya isaa godheen kenneef.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni waca magaalaa keessaatti ni kolfa;","poem":1},{"text":"iyya konkolaachisaas hin dhagaʼu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Waan dheedu argachuuf tulluuwwan irra laba;","poem":1},{"text":"waan lalisaa hundas ni barbaada.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Gafarsi si tajaajiluuf siif ajajamaa?","poem":1},{"text":"Dallaa kee keessas ni bulaa?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Akka inni lafa siif qotuuf funyoodhaan isa hidhuu ni dandeessaa?","poem":1},{"text":"Yookaan inni si duubaan boʼoo ni baasaa?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ati waan inni humna guddaa qabuuf isa ni amanattaa?","poem":1},{"text":"Hojii kee jabaa illee isatti ni dhiiftaa?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Akka inni midhaan kee walitti qabee","poem":1},{"text":"oobdii kee irratti siif tuuluuf isa ni abdattaa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Guchiin gammachuudhaan qoochoo ishee afarsiti;","poem":1},{"text":"garuu qoochoo fi baallee huummootiin wal bira hin qabamu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hanqaaquu ishee lafa irratti buufti;","poem":1},{"text":"akka itti hoʼuufis cirracha keessatti dhiifti;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"garuu akka miilli wayii caccabsu,","poem":1},{"text":"akka bineensi irra ejjetu hin yaadattu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Cuucii isheettis akka waan isaan kan ishee hin taʼiniitti garaa jabaatti;","poem":1},{"text":"yoo dadhabbiin ishee akkasumaan bade illee isheef homaa miti;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Waaqni ogummaadhaan ishee hin badhaafneetii;","poem":1},{"text":"yookaan hubannaa isheef hin qoodne.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yeroo fiiguuf qoochoo ishee balʼifattutti,","poem":1},{"text":"isheen fardaa fi namicha gulufutti kofalti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Ati fardaaf jabina ni kennitaa?","poem":1},{"text":"Yookaan morma isaatti gama uffisuu dandeessaa?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Akka inni akkuma hawwaannisaatti utaalu ni gootaa?","poem":1},{"text":"Ulfinni korrisa isaas sodaachisaa dha.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Inni humna isaatti gammadee akka malee guulee lafa dhidhiita;","poem":1},{"text":"baʼees miʼa lolaatti qajeela.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Inni sodaatti ni kolfa; waan tokko illee hin sodaatu;","poem":1},{"text":"goraadee irraas duubatti hin deebiʼu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Manʼeen xiyyaa, eeboo fi ankaaseen calaqqisus","poem":1},{"text":"cinaacha isaatti bubbuʼee kililcha.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Siʼaaʼee rommuudhaan lafa haadha;","poem":1},{"text":"yeroo malakanni afuufamutti illee obsee dhaabachuu hin dandaʼu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Inni yommuu malakanni afuufamutti","poem":1},{"text":"‘Uffee’ jedhee imimsa; waca ajajjootaatii fi iyya waraanaa,","poem":2},{"lineBreak":true},{"text":"foolii waraanaa illee fagoottu suufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Cululleen ogummaa keetiin barriftee","poem":1},{"text":"qoochoo ishees gara kibbaatti balʼiftii?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Risaan ajaja keetiin ol baʼee","poem":1},{"text":"ol fagootti mana isaa ijaarrataa?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Inni qarqara hallayyaa irra jiraata; halkanis achuma bula;","poem":1},{"text":"kattaan fofottoqaanis daʼoo isaa ti.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Achi taaʼees waan nyaatu adamsa;","poem":1},{"text":"iji isaas fagootti waan sana arga.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Cuucoliin isaa dhiiga dhugu;","poem":1},{"text":"innis lafa raqni jiruu hin dhabamu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}