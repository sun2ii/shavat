{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_bib","name":"Iyyoob","commonName":"Iyyoob","title":"Kitaaba Iyyoob","order":18,"numberOfChapters":42,"sha256":"80fa6ab826a476ea21d26038ed348be18761b21678a32ebf28e5047e79675a1b","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":4,"content":[{"type":"heading","content":["Eliifaaz"]},{"type":"verse","number":1,"content":["Eliifaaz namichi Teemaan sun akkana jedhee deebise:"]},{"type":"verse","number":2,"content":[{"text":"“Yoo namni tokko sitti dubbachuu yaale, ati ni komattaa?","poem":1},{"text":"Garuu eenyutu dubbachuu dhiisa?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ati akka nama baayʼee barsiifte,","poem":1},{"text":"akka harka dadhabaa illee jajjabeessite yaadadhu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dubbiin kee warra gatantaran gargaaree dhaabeera;","poem":1},{"text":"atis jilba laafe jabeessiteerta.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Amma garuu rakkinni sirra gaʼe; atis abdii kutatteerta;","poem":1},{"text":"rakkinni si miidheera; atis rifatteerta;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Waaqa sodaachuun kee irkoo kee,","poem":1},{"text":"qajeelinni karaa keetiis abdii kee mitii?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ammas yaadadhu; namni qulqulluun takkumaa badee beekaa?","poem":1},{"text":"Qajeelonni eessatti badanii beeku?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Akka ani hubadhetti warri waan hamaa qotatan,","poem":1},{"text":"kanneen waan hamaa facaasanis isuma haammatu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isaanis hafuura Waaqni isaanitti baafatuun badu;","poem":1},{"text":"hafuuraa dheekkamsa isaaniitiinis ni barbadeeffamu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Leenci ni aada; ni gururiʼas;","poem":1},{"text":"ilkaan leenca saafelaa garuu ni caccaba.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Leenci jabaan waan adamsu dhabee ni duʼa;","poem":1},{"text":"ilmaan leenca dhaltuus ni bittinnaaʼu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Dubbiin tokko icciitiidhaan naa fidame;","poem":1},{"text":"gurri koos asaasa isaa dhagaʼe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Abjuu halkanii sodaachisaa keessa,","poem":1},{"text":"yommuu hirribni cimaan nama qabatutti,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"sodaa fi hollachuun na qabatee","poem":1},{"text":"lafee koo hunda raase.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hafuurri luffi jedhee fuula koo dura darbe;","poem":1},{"text":"rifeensi dhagna koos kaʼee dhaabate.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Innis ni dhaabate;","poem":1},{"text":"ani garuu inni maal akka taʼe hubachuu hin dandeenye.","poem":2},{"text":"Fakkiin tokko ija koo dura dhaabate;","poem":1},{"text":"anis sagalee tasgabbii kan akkana jedhu tokkon dhagaʼe:","poem":2}]},{"type":"verse","number":17,"content":[{"text":"‘Namni duʼa hin oolle, Waaqa caalaa qajeelaa taʼuu dandaʼaa?","poem":1},{"text":"Namni Uumaa isaa caalaa qulqulluu taʼuu dandaʼaa?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Waaqni tajaajiltoota isaa hin amanatu;","poem":1},{"text":"ergamoota isaas balleessaa isaaniitiin ni gaafata;","poem":2}]},{"type":"verse","number":19,"content":[{"text":"yoos warri manneen suphee keessa jiraatan,","poem":1},{"text":"warri hundeen isaanii biyyoo taʼe,","poem":2},{"lineBreak":true},{"text":"warri bilii caalaa burkutaaʼan immoo akkam haa taʼan ree?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Isaan ganamaa fi galgala gidduutti burkutaaʼu;","poem":1},{"text":"tasumas bara baraan ni badu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Akka isaan ogummaa malee duʼaniif","poem":1},{"text":"funyoon dunkaana isaanii hin luqqifamnee?’","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}