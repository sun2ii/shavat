{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOL","translationId":"gaz_bib","name":"Yooʼeel","commonName":"Yooʼeel","title":"Raajii Yooʼeel","order":29,"numberOfChapters":3,"sha256":"a9ff6b25bf3a0d56fdd1144c4cb8df2e7d5a72730f199d8aab4e0b4348dc9a40","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gaz_bib/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Dubbii Waaqayyoo kan gara Yooʼeel ilma Phetuuʼeel dhufe."]},{"type":"line_break"},{"type":"heading","content":["Weerara Hawwaannisaa"]},{"type":"verse","number":2,"content":[{"text":"Yaa maanguddoota, waan kana dhagaʼaa;","poem":1},{"text":"warri biyyattii keessa jiraattan hundinuu dhaggeeffadhaa.","poem":2},{"text":"Wanni akkanaa takkumaa bara keessan keessa","poem":1},{"text":"yookaan bara abbootii keessanii keessa taʼee beekaa?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isin waan kana ijoollee keessanitti himaa;","poem":1},{"text":"ijoolleen keessanis ijoollee ofii isaaniitti haa himan;","poem":2},{"lineBreak":true},{"text":"ijoolleen isaanii immoo dhaloota itti aanutti haa dabarsan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Waan tuunni hawwaannisaa dhiise,","poem":1},{"text":"hawwaannisni guddaan fixe;","poem":2},{"text":"waan hawwaannisni guddaan dhiise,","poem":1},{"text":"hawwaannisni xixinnaan nyaatee fixe;","poem":2},{"text":"waan hawwaannisni xixinnaan dhiise immoo","poem":1},{"text":"hawwaannisni biraa dhufee nyaate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yaa machooftota, kaʼaatii booʼaa!","poem":1},{"text":"Isin warri daadhii wayinii dhugdanhundinuu wawwaadhaa;","poem":2},{"text":"sababii daadhii wayinii haaraatiifwawwaadhaa;","poem":1},{"text":"inni afaan keessan irraa butameeraatii.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sabni jabaan akka malee baayʼeen tokko","poem":1},{"text":"biyya koo weerareera;","poem":2},{"text":"inni ilkaan leencaa,","poem":1},{"text":"qarriffaa leenca dhalaa qaba.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni muka wayinii koo onsee","poem":1},{"text":"harbuu koos barbadeesseera.","poem":2},{"text":"Inni qola isaanii irraa quncisee lafatti gatee","poem":1},{"text":"dameelee isaanii duwwaa hambise.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Isin akkuma durba wayyaa gaddaa uffattee","poem":1},{"text":"dhirsa ijoollummaa isheetiif gaddituutti booʼaa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kennaan midhaaniitii fi dhibaayyuun","poem":1},{"text":"mana Waaqayyoo irraa citaniiru.","poem":2},{"text":"Luboonni fuula Waaqayyoo dura tajaajilan","poem":1},{"text":"booʼaa jiru.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lafti qotiisaa oneera;","poem":1},{"text":"laftis gogeera;","poem":2},{"text":"midhaan barbadaaʼeera;","poem":1},{"text":"daadhiin wayinii haaraan dhumeera;","poem":2},{"lineBreak":true},{"text":"zayitiinis dhabameera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yaa qonnaan bultoota, isin raafamaa;","poem":1},{"text":"warri wayinii dhaabbattan booʼaa;","poem":2},{"text":"sababii midhaan lafa qotiisaa keessanii","poem":1},{"text":"barbadaaʼeef qamadii fi garbuudhaaf booʼaa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wayiniin gogeera;","poem":1},{"text":"harbuunis coollageera;","poem":2},{"text":"roomaaniin, meexxii fi hudhaan,","poem":1},{"text":"mukkeen lafa qotiisaa hundinuu goganiiru.","poem":2},{"text":"Dhugumaan gammachuun ilmaan namaa","poem":1},{"text":"irraa badeera.","poem":2}]},{"type":"heading","content":["Waamicha Qalbii Jijjiirrachuu"]},{"type":"verse","number":13,"content":[{"text":"Yaa luboota, wayyaa gaddaa uffadhaatii booʼaa;","poem":1},{"text":"isin warri iddoo aarsaa dura tajaajiltan wawwaadhaa.","poem":2},{"text":"Isin warri fuula Waaqa koo dura tajaajiltan","poem":1},{"text":"kottaatii wayyaa gaddaa uffadhaa bulaa;","poem":2},{"text":"kennaan midhaaniitii fi dhibaayyuun","poem":1},{"text":"mana Waaqaa irraa hambifamaniiruutii.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sooma qulqulluu labsaa;","poem":1},{"text":"waldaa qulqulluu waamaa.","poem":2},{"text":"Maanguddootaa fi","poem":1},{"text":"warra biyyattii keessa jiraatan hunda","poem":2},{"text":"gara mana Waaqayyoo Waaqa keessaniitti waamaatii","poem":1},{"text":"Waaqayyootti booʼaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Badne kaa! Guyyaan sun dhiʼaateera.","poem":1},{"text":"Guyyaan Waaqayyoo gaʼeeraatii;","poem":2},{"lineBreak":true},{"text":"inni akkuma badiisaattiWaaqa Waan Hunda Dandaʼu biraa dhufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ijuma keenya duratti","poem":1},{"text":"nyaanni cite;","poem":2},{"text":"ilillee fi gammachuunis","poem":1},{"text":"mana Waaqa keenyaa irraa hin cinnee?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sanyiin lafa keessatti","poem":1},{"text":"tortoree hafe.","poem":2},{"text":"Mankuusni diigameera;","poem":1},{"text":"gombisaan caccabeera;","poem":2},{"lineBreak":true},{"text":"midhaan gogee hafeeraatii.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Loon akkam marʼatu!","poem":1},{"text":"Karri loonii sababii waan dheedu dhabeef","poem":2},{"text":"asii fi achi joora;","poem":1},{"text":"bushaayeenis dhiphataniiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yaa Waaqayyo ani sin waammadha;","poem":1},{"text":"ibiddi lafa dheedaa barbadeessee","poem":2},{"lineBreak":true},{"text":"arrabni ibiddaa immoo mukkeen diidaa hunda gubee fixeeraatii.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bineensonni bosonaa sitti gaggabu;","poem":1},{"text":"lagni bishaanii gogeera;","poem":2},{"lineBreak":true},{"text":"ibiddis dirree dheedaa gubee balleesseera.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}