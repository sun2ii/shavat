{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOL","translationId":"gaz_bib","name":"Yooʼeel","commonName":"Yooʼeel","title":"Raajii Yooʼeel","order":29,"numberOfChapters":3,"sha256":"a9ff6b25bf3a0d56fdd1144c4cb8df2e7d5a72730f199d8aab4e0b4348dc9a40","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gaz_bib/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["Raayyaa Hawwaanisaa"]},{"type":"verse","number":1,"content":[{"text":"Xiyoon keessatti malakata afuufaa;","poem":1},{"text":"gaara koo qulqulluu irratti sagaleeakeekkachiisaa dhageessisaa.","poem":2},{"lineBreak":true},{"text":"Guyyaan Waaqayyoo dhufaa jiraatii;","poem":1},{"text":"warri lafa irra jiraatan hundi haa hollatan.","poem":2},{"text":"Guyyaan sun dhiʼaateera;","poem":1}]},{"type":"verse","number":2,"content":[{"text":"guyyaan dukkanaatii fi dimimmisaa,","poem":2},{"lineBreak":true},{"text":"guyyaan duumessaatii fi dukkana hamaa ni dhufa.","poem":2},{"text":"Sabni guddaa fi jabaan tokko","poem":1},{"text":"akkuma ifa ganama tulluuwwan irratti baʼuutti ni dhufa;","poem":2},{"text":"wanni akkasii takkumaa bara durii keessa taʼee hin beeku","poem":1},{"text":"yookaan dhaloota dhufuuf jiru keessatti illee hin taʼu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Fuula isaanii duraa ibiddi ni barbadeessa;","poem":1},{"text":"dugda isaanii duubaan immoo arraba ibiddaatu bobaʼa.","poem":2},{"text":"Fuula isaanii duraan lafti iddoo biqiltuu Eeden fakkaata;","poem":1},{"text":"dugda isaanii duubaan immoo lafti akkuma gammoojjii onee ti;","poem":2},{"lineBreak":true},{"text":"wanni tokko iyyuu isaan duraa hin miliqu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isaan bifa fardeenii qabu;","poem":1},{"text":"akkuma fardeen lolaas ni gulufu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isaan sagalee akka gaarii waraanaatiin","poem":1},{"text":"fiixee tulluu irra utaalu;","poem":2},{"text":"akkuma ibidda yeroo qarmii gubutti xaaxaʼuu,","poem":1},{"text":"akkuma waraana jabaa lolaaf baʼe tokkoo ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Saboonni jara arginii dhiphatu;","poem":1},{"text":"fuulli nama hundaas ni gurraachaʼa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Isaan akkuma namoota jajjaboo fiigu;","poem":1},{"text":"akkuma loltootaa dallaa yaabbatanii seenu.","poem":2},{"text":"Hundi isaanii tarree galanii deemu;","poem":1},{"text":"isaan keessaa tokko iyyuu daandii isaa irraa hin jalʼatu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Isaan wal hin dhiiban;","poem":1},{"text":"hundi isaanii qajeelanii fuula duratti deemu.","poem":2},{"text":"Utuu toora isaanii hin dhiisin","poem":1},{"text":"ittisa cabsanii seenu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isaan magaalaa keessa asii fi achi fiigu;","poem":1},{"text":"dallaa irra fiigu.","poem":2},{"text":"Isaan mana yaabbatu;","poem":1},{"text":"akkuma hattuus foddaadhaan ol seenu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Fuula isaanii duratti lafti ni sochooti;","poem":1},{"text":"samiin ni raafama;","poem":2},{"text":"aduu fi jiʼi ni dukkanaaʼu;","poem":1},{"text":"urjiiwwan deebiʼanii hin ibsan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Waaqayyo fuula loltoota isaa duratti","poem":1},{"text":"sagalee dhageessisa;","poem":2},{"text":"loltoonni isaa akka malee baayʼee dha;","poem":1},{"text":"warri ajaja isaa eegan jajjaboo dha.","poem":2},{"text":"Guyyaan Waaqayyoo guddaa dha;","poem":1},{"text":"guyyaan sun akka malee nama sodaachisa.","poem":2},{"lineBreak":true},{"text":"Eenyutu dura dhaabachuu dandaʼa?","poem":2}]},{"type":"heading","content":["Cubbuu Irraa Deebiʼaa"]},{"type":"verse","number":12,"content":[{"text":"“Amma iyyuu garaa guutuudhaan,","poem":1},{"text":"soomaan, booʼichaa fi gaddaan","poem":2},{"lineBreak":true},{"text":"gara kootti deebiʼaa” jedha Waaqayyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Isin utuu wayyaa keessan hin taʼin","poem":1},{"text":"garaa keessan tarsaasaa.","poem":2},{"text":"Gara Waaqayyo Waaqa keessaniitti deebiʼaa;","poem":1},{"text":"inni arjaa fi gara laafessaatii;","poem":2},{"text":"inni dafee hin aaru; jaalalli isaa baayʼee dha;","poem":1},{"text":"inni badiisa erguu irraa of qusata.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Maaltu beeka? Tarii inni deebiʼee gaabbee","poem":1},{"text":"eebba, kennaa midhaaniitii fi kennaa dhugaatii","poem":2},{"text":"kan Waaqayyo Waaqa keessaniif taʼu","poem":1},{"text":"isiniif hambisa taʼa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Xiyoon keessatti malakata afuufaa;","poem":1},{"text":"sooma qulqulluu labsaa;","poem":2},{"lineBreak":true},{"text":"waldaa qulqulluu waamaa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Saba walitti qabaa;","poem":1},{"text":"waldaa sana qulqulleessaa;","poem":2},{"text":"maanguddoota walitti fidaa;","poem":1},{"text":"ijoollee walitti qabaa;","poem":2},{"lineBreak":true},{"text":"daaʼimman harma hodhan illee hin hambisinaa.","poem":2},{"text":"Misirrichi kutaa isaa keessaa haa baʼu;","poem":1},{"text":"misirrittiinis diinqa isheetii haa baatu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Luboonni fuula Waaqayyoo dura tajaajilan","poem":1},{"text":"gardaafoo fi iddoo aarsaa gidduutti haa booʼan.","poem":2},{"text":"Isaan akkana haa jedhan; “Yaa Waaqayyo saba kee baraari.","poem":1},{"text":"Handhuuraa kee waan qoosaa,","poem":2},{"lineBreak":true},{"text":"saboota gidduuttis waan kolfaa hin godhin.","poem":2},{"text":"Isaan maaliif namoota gidduutti,","poem":1},{"text":"‘Waaqni isaanii eessa jira?’ jedhu?”","poem":2}]},{"type":"heading","content":["Deebii Waaqayyo Kenne"]},{"type":"verse","number":18,"content":[{"text":"Waaqayyo biyya isaatiif ni hinaafa;","poem":1},{"text":"saba isaatiifis garaa laafa.","poem":2}]},{"type":"verse","number":19,"content":["Waaqayyo akkana jedhee deebii kennaaf:",{"text":"“Ani midhaan, daadhii wayinii haaraa fi zayitii ejersaa","poem":1},{"text":"kan isin quubsu isiniif nan erga;","poem":2},{"text":"ani lammata saboota gidduutti","poem":1},{"text":"waan qoosaa isin hin godhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Ani loltoota kaabaa isin duraa balleessee","poem":1},{"text":"gara lafa gogaa fi duwwaatti isaan ariʼa;","poem":2},{"text":"loltoonni fuula duraan yaaʼan galaana baʼa biiftuu,","poem":1},{"text":"kanneen dugda duubaan yaaʼan immoogalaana gama lixa biiftuu seenu.","poem":2},{"text":"Reeffi isaanii ni xiraaʼa;","poem":1},{"text":"xiraan isaaniis ol baʼa.”","poem":2},{"lineBreak":true},{"text":"Dhugumaan inni waan guddaa hojjeteera!","poem":1}]},{"type":"verse","number":21,"content":[{"text":"Yaa biyya Yihuudaa, hin sodaatin;","poem":2},{"lineBreak":true},{"text":"gammadiitii ililchi.","poem":2},{"text":"Waaqayyo dhugumaan waan guddaa hojjeteera!","poem":1}]},{"type":"verse","number":22,"content":[{"text":"Yaa bineensota bosonaa, isinis hin sodaatinaa;","poem":2},{"lineBreak":true},{"text":"dirreen dheedaa gabbachaa jiraatii.","poem":2},{"text":"Mukkeen ija naqachaa,","poem":1},{"text":"harbuu fi wayiniinis ija kennaa jiru.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yaa uummata Xiyoon gammadi;","poem":1},{"text":"Waaqayyo Waaqa keetti gammadi;","poem":2},{"text":"inni qajeelummaadhaan","poem":1},{"text":"rooba arfaasaa siif kenneeraatii.","poem":2},{"text":"Inni akkuma durii bokkaa baayʼee,","poem":1},{"text":"rooba arfaasaa fi kan birraa siif erga.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Oobdiin midhaaniin guutama;","poem":1},{"text":"boolli itti wayinii cuunfanis daadhii wayinii haaraa fizayitiidhaan guutamanii dhangalaasu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Ani waan bara hawwaannisni nyaate,","poem":1},{"text":"waan hawwaannisni gurguddaa fi xixinnaan nyaate,","poem":2},{"lineBreak":true},{"text":"waan hawwaannisni kaanii fi tuunni hawwaannisaa","poem":2},{"text":"jechuunis loltoonni koo jajjaboon ani gidduu keessanitti erge sun nyaataniddoo isiniif nan buusa.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Isin waan hamma quuftanitti nyaattan baayʼee ni qabaattu;","poem":1},{"text":"maqaa Waaqayyo Waaqa keessanii","poem":2},{"lineBreak":true},{"text":"kan waan dinqii isiniif hojjete sanaa ni galateeffattu;","poem":2},{"text":"uummanni koo lammata hin qaaneffamu.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ergasii isin akka ani Israaʼel keessa jiru","poem":1},{"text":"akka ani Waaqayyo Waaqa keessan taʼe,","poem":2},{"lineBreak":true},{"text":"akka ana malee Waaqni biraa hin jirre ni beektu;","poem":2},{"text":"uummanni koo lammata hin qaaneffamu.","poem":1}]},{"type":"heading","content":["Guyyaa Waaqayyoo"]},{"type":"verse","number":28,"content":[{"text":"“Anis kana booddee,","poem":1},{"text":"Hafuura koo nama hunda irratti nan dhangalaasa.","poem":2},{"text":"Ilmaanii fi intallan keessan raajii dubbatu;","poem":1},{"text":"jaarsoliin keessan abjuu abjootu;","poem":2},{"lineBreak":true},{"text":"dargaggoonni keessan mulʼata argu.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Bara sana keessa, garboota koo","poem":1},{"text":"warra dhiiraa fi dubartii irratti illee","poem":2},{"lineBreak":true},{"text":"Hafuura koo nan dhangalaasa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ani ol samii irratti dinqii,","poem":1},{"text":"gad lafa irrattis dhiiga,","poem":2},{"lineBreak":true},{"text":"ibiddaa fi hurrii aaraa nan argisiisa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Utuu guyyaan Waaqayyoo inni guddichii fi","poem":1},{"text":"sodaachisaan sun hin dhufin dura,","poem":2},{"lineBreak":true},{"text":"aduun dukkanatti geeddaramti;","poem":2},{"lineBreak":true},{"text":"jiʼi immoo dhiigatti geeddarama.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Namni maqaa Waaqayyoo waammatu","poem":1},{"text":"hundinuu ni fayya;","poem":2},{"text":"akkuma Waaqayyo dubbatettis","poem":1},{"text":"Tulluu Xiyoon irraa fi","poem":2},{"lineBreak":true},{"text":"Yerusaalem keessa, furamatu jiraata;","poem":2},{"text":"hambaa gidduuttis warri Waaqayyo","poem":1},{"text":"isaan waame ni argamu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}