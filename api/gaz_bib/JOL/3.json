{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOL","translationId":"gaz_bib","name":"Yooʼeel","commonName":"Yooʼeel","title":"Raajii Yooʼeel","order":29,"numberOfChapters":3,"sha256":"a9ff6b25bf3a0d56fdd1144c4cb8df2e7d5a72730f199d8aab4e0b4348dc9a40","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gaz_bib/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["Sabootatti Murame"]},{"type":"verse","number":1,"content":[{"text":"“Bara sana keessa, yeroo sanatti,","poem":1},{"text":"ani yommuun boojuu Yihuudaatii fiYerusaalem deebisutti,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"saboota hunda walitti qabeen","poem":1},{"text":"gara Sulula Yehooshaafaaxittigad isaan nan buusa.","poem":2},{"text":"Anis achitti sababii dhaala koo,","poem":1},{"text":"sababii Israaʼeliif isaanitti nan mura;","poem":2},{"text":"isaan saboota gidduutti saba koo","poem":1},{"text":"bittinneessanii biyya koos gargar qooddataniiruutii.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isaan uummata kootti ixaa buufatanii","poem":1},{"text":"ijoollee dhiiraas sagaagalummaatti geeddarataniiru;","poem":2},{"lineBreak":true},{"text":"akka dhuganiif dubara illee daadhii wayiniitti gurguratan.","poem":2}]},{"type":"verse","number":4,"content":["“Yaa Xiiroosii fi Siidoonaa, isin kutaaleen Filisxeem hundinuu, amma maal narraa qabdu? Isin waan ani godheef haaloo na baafachaa jirtuu? Yoo isin haaloo na baafachaa jirtu taʼe ani dafee ariitiidhaan waan isin hojjettan sana matuma keessanittin deebisa."]},{"type":"verse","number":5,"content":["Isin meetii fi warqee koo guurrattanii qabeenya koo filatamaas mana waaqeffannaa keessanitti geeffattaniirtuutii."]},{"type":"verse","number":6,"content":["Isin biyya isaanii irraa isaan fageessitanii uummata Yihuudaatii fi Yerusaalem Giriikotatti gurgurattan."]},{"type":"verse","number":7,"content":["“Kunoo, ani biyya isin itti isaan gurgurattan keessaa isaan baasee waan isin hojjettan sana matuma keessanitti nan deebisa."]},{"type":"verse","number":8,"content":["Ani ilmaanii fi intallan keessan saba Yihuudaatti nan gurgura; isaan immoo saba fagoo jiru kan Saabaa jedhamutti dabarsanii isaan gurguratu.” Waaqayyo dubbateeraatii."]},{"type":"verse","number":9,"content":[{"text":"Waan kana saboota gidduutti labsaa:","poem":1},{"text":"Waraanaaf qophaaʼaa!","poem":2},{"text":"Gootota kakaasaa!","poem":1},{"text":"Loltoonni hundi dhiʼaatanii haa lolan.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Maarashaa keessan tumaatii goraadee godhadhaa;","poem":1},{"text":"haamtuu keessanis tumaatii eeboo godhadhaa.","poem":2},{"text":"Namni laafaan,","poem":1},{"text":"“Ani jabaa dha!” haa jedhu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isin saboonni qixa hundaan dafaa kottaattii","poem":1},{"text":"achitti walitti qabamaa.","poem":2},{"lineBreak":true},{"text":"Yaa Waaqayyo, loltoota kee gad ergi!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Saboonni haa kaʼan;","poem":1},{"text":"isaan dafanii gara Sulula Yehooshaafaax haa dhufan;","poem":2},{"text":"ani saboota gama hundaan jiranitti muruuf","poem":1},{"text":"achi nan taaʼaatii.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Midhaan gaʼeeraatii","poem":1},{"text":"haamtuu itti kaaʼaa.","poem":2},{"text":"Kottaatii ija wayinii dhidhiitaa;","poem":1},{"text":"boolli itti wayinii cuunfan guuteeraatii;","poem":2},{"lineBreak":true},{"text":"sababii hamminni isaanii guddaa taʼeef","poem":2},{"text":"boolli itti wayinii cuunfan guutee irra dhangalaʼeera!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Waldaan guddaan, waldaan nama baayʼee","poem":1},{"text":"sulula murtii keessatti wal gaʼeera!","poem":2},{"text":"Guyyaan Waaqayyoo","poem":1},{"text":"sulula murtii keessatti dhufuu gaʼeeraatii.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Biiftuu fi addeessi ni dukkanaaʼu;","poem":1},{"text":"urjiiwwanis siʼachi ifa hin kennan.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Waaqayyo Xiyoon irraa ni iyya;","poem":1},{"text":"Yerusaalem keessaas sagalee dhageessisa;","poem":2},{"lineBreak":true},{"text":"lafaa fi samiin ni raafamu.","poem":2},{"text":"Waaqayyo garuu saba isaatiif iddoo itti baqatan,","poem":1},{"text":"saba Israaʼeliif immoo daʼoo ni taʼa.","poem":2}]},{"type":"heading","content":["Eebba Saba Waaqaatiif kenname"]},{"type":"verse","number":17,"content":[{"text":"“Ergasii isin akka ani Waaqayyo Waaqni keessan Xiyoon keessa,","poem":1},{"text":"gaara koo qulqulluu sana irra jiraadhu ni beektu.","poem":2},{"text":"Yerusaalem qulqulluu taati;","poem":1},{"text":"namoonni biyya alaa gonkumaa lammata ishee hin weeraran.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Gaafas tulluuwwan daadhii wayinii haaraa ni coccobsu;","poem":1},{"text":"gaarranis aannan yaasu;","poem":2},{"lineBreak":true},{"text":"lageen Yihuudaa hundinuu bishaaniin guutamu.","poem":2},{"text":"Burqaan tokko mana Waaqayyoo keessaa","poem":1},{"text":"burqee sulula Shixiim ni obaasa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Gibxi garuu ni onti;","poem":1},{"text":"Edoomis duwwaa hafti;","poem":2},{"text":"isaan dhiiga nama yakka hin qabneebiyyattii keessatti dhangalaasuudhaan","poem":1},{"text":"saba Yihuudaatti daba hojjetaniiruutii.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yihuudaan bara baraan,","poem":1},{"text":"Yerusaalemis dhaloota hundaaf iddoo jireenyaa ni taati.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ani dhiiga isaanii kan yakka hin qabne sana","poem":1},{"text":"utuun haaloo hin baʼin nan dhiisaa?","poem":2},{"lineBreak":true},{"text":"Lakkii, hin dhiisu.”","poem":2},{"lineBreak":true},"Waaqayyo Xiyoon keessa jiraata!"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}