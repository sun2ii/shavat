{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JON","translationId":"gaz_bib","name":"Yoonaas","commonName":"Yoonaas","title":"Raajii Yoonaas","order":32,"numberOfChapters":4,"sha256":"956a10b5e66ebc152df82a9b306510e48744f4e7e3768554b749c4dc01ec88ab","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/gaz_bib/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Kadhannaa Yoonaas"]},{"type":"verse","number":1,"content":["Yoonaas garaa qurxummii keessaa Waaqayyoon Waaqa isaa kadhate."]},{"type":"verse","number":2,"content":["Innis akkana jedhe:",{"text":"“Ani rakkina koo keessatti Waaqayyoon waammadhe;","poem":1},{"text":"innis deebii naaf kenne.","poem":2},{"text":"Ani gargaarsa barbaacha garaa siiʼool keessaa nan iyye;","poem":1},{"text":"atis iyya koo naaf dhageesse.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ati tuujubatti,","poem":1},{"text":"garaa galaanaatti gad na darbatte;","poem":2},{"lineBreak":true},{"text":"lolaanis na marse;","poem":2},{"text":"dambalii fi dhaʼaan kee","poem":1},{"text":"hundinuu narra garagalan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Anis, ‘Kunoo ani fuula kee duraa balleeffameera;","poem":1},{"text":"taʼus ani deebiʼee gara mana qulqullummaa keetii","poem":2},{"lineBreak":true},{"text":"qulqulluu sanaan ilaala’ nan jedhe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bishaanonni na haguugan;","poem":1},{"text":"tuujubni immoo na marse;","poem":2},{"lineBreak":true},{"text":"aramaan galaanaas mataatti na marame.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani gara hundee tulluuwwaniittin gad liqimfame;","poem":1},{"text":"balballi lafa jalaas bara baraan natti cufame.","poem":2},{"text":"Yaa Waaqayyo Waaqa ko,","poem":1},{"text":"ati garuu lubbuu koo boolla keessaa ol baafte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Yaa Waaqayyo, yeroo lubbuun koo dadhabdetti","poem":1},{"text":"ani sin yaadadhe;","poem":2},{"text":"kadhannaan koos gara kee","poem":1},{"text":"gara mana qulqullummaa kee qulqullichaatti ol baʼe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Warri waaqota tolfamoo faayidaa hin qabnetti cichan","poem":1},{"text":"araara Waaqaa irraa garagalu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ani garuu faarfannaa galataatiin","poem":1},{"text":"aarsaa siif nan dhiʼeessa.","poem":2},{"text":"Ani wareegan wareege sanas nan baasa.","poem":1},{"text":"Anis, ‘Fayyinni Waaqayyo biraa dhufa’ ” nan jedha.","poem":2}]},{"type":"verse","number":10,"content":["Waaqayyos qurxummii sana ajaje; qurxummiin sunis lafa gogaa irratti Yoonaasin tufe."]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}