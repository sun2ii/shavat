{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"LAM","translationId":"gaz_bib","name":"Faaruu","commonName":"Faaruu","title":"Faaruu Ermiyaas","order":25,"numberOfChapters":5,"sha256":"d61189a1664cf67ecff573b43d020ccffe4f792ec841b1218c4399a15645db77","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/gaz_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Magaalaan dur namaan guutamtee turte sun","poem":1},{"text":"akkamitti ontee hafte!","poem":2},{"text":"Isheen yeroo tokko saboota gidduutti guddoo turte","poem":1},{"text":"akkamitti akka haadha hiyyeessaa taate!","poem":2},{"text":"Isheen kutaalee biyyaa gidduutti mootii turte sun","poem":1},{"text":"amma garbittii taateerti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Isheen halkan halkan hiqqifattee boossi;","poem":1},{"text":"maddii ishee irra imimmaantu yaaʼa.","poem":2},{"text":"Michoota ishee hunda keessaa","poem":1},{"text":"kan ishee jajjabeessu tokko iyyuu hin jiru.","poem":2},{"text":"Michoonni ishee hundinuu ishee gananiiru;","poem":1},{"text":"isaan diinota ishee taʼaniiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Rakkinaa fi cunqurfama guddaa booddee","poem":1},{"text":"Yihuudaan boojiʼamtee fudhatamteerti.","poem":2},{"text":"Isheen saboota gidduu jiraatti,","poem":1},{"text":"lafa itti boqottu illee hin arganne.","poem":2},{"text":"Warri ishee ariʼan hundi","poem":1},{"text":"rakkina ishee keessatti ishee qabatan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Daandiiwwan Xiyoon ni booʼu;","poem":1},{"text":"namni ayyaana ishee kan murteeffame kabajuuf dhufutokko iyyuu hin jiruutii.","poem":2},{"text":"Karrawwan ishee hundi onanii jiru;","poem":1},{"text":"luboonni ishee ni aadu;","poem":2},{"text":"shamarran ishee ni gaddu,","poem":1},{"text":"isheenis dhiphina guddaa keessa jirti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Amajaajonni ishee gooftota ishee taʼaniiru;","poem":1},{"text":"diinota isheetti toleera.","poem":2},{"text":"Sababii cubbuu ishee baayʼee sanaatiif","poem":1},{"text":"Waaqayyo gadda itti fideera.","poem":2},{"text":"Ijoolleen ishee fudhatamanii deemaniiru;","poem":1},{"text":"fuula amajaajota ishee duratti boojiʼamaniiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Intala Xiyoon irraa","poem":1},{"text":"miidhaginni hundi fudhatameera.","poem":2},{"text":"Ilmaan mootota ishee","poem":1},{"text":"akkuma gadamsa lafa dheedaa dhabee taʼaniiru;","poem":2},{"text":"isaan dadhabbiidhaan","poem":1},{"text":"fuula warra isaan ariʼanii dura baqatan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Baroota rakkinaa fi asii achi jooruu ishee keessa","poem":1},{"text":"Yerusaalem qabeenya","poem":2},{"lineBreak":true},{"text":"bara durii kan ishee ture hunda ni yaadatti.","poem":2},{"text":"Yeroo namoonni ishee harka diinaa seenanitti","poem":1},{"text":"namni ishee gargaaru tokko iyyuu hin turre.","poem":2},{"text":"Diinonni ishee ishee ilaalanii","poem":1},{"text":"badiisa isheetti kolfan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yerusaalem akka malee cubbuu hojjette;","poem":1},{"text":"akkasiinis xuroofte.","poem":2},{"text":"Warri ulfina kennaniifii turan hundi ishee tuffatan;","poem":1},{"text":"isaan qullaatti hafuu ishee arganiiruutii;","poem":2},{"text":"isheen mataan ishee guungumtee","poem":1},{"text":"of irra garagalti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Xuraaʼummaan ishee wandaboo isheetti maxxane;","poem":1},{"text":"isheen waan gara duraatti itti dhufu hin yaadne;","poem":2},{"text":"kufaatiin ishee nama rifachiisa;","poem":1},{"text":"kan ishee jajjabeessu tokko iyyuu hin jiru ture.","poem":2},{"text":"“Yaa Waaqayyo rakkina koo ilaali;","poem":1},{"text":"diinni moʼateeraatii!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Qabeenya ishee hundatti","poem":1},{"text":"diinni harka isaa diriirseera;","poem":2},{"text":"isheen Namoota Ormaa","poem":1},{"text":"warra ati akka isaan","poem":2},{"text":"waldaa kee hin seenne dhowwite sana","poem":1},{"text":"utuu isaan iddoo ishee qulqulluu seenanuu argite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Namoonni ishee hundinuu utuma","poem":1},{"text":"aadanuu buddeena barbaaddatu;","poem":2},{"text":"isaan lubbuu ofii isaanii turfachuuf jecha","poem":1},{"text":"qabeenya isaanii nyaataan geeddarratu.","poem":2},{"text":"“Yaa Waaqayyo na ilaali, na yaadadhus;","poem":1},{"text":"ani tuffatameeraatii.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Warra karaa irra dabartan hundi, kun isiniif homaa mitii?","poem":1},{"text":"Naannoo keessan ilaalaatii argaa.","poem":2},{"text":"Rakkinni akka rakkina koo","poem":1},{"text":"kan ani ittiin rakkadhe,","poem":2},{"text":"kan Waaqayyo guyyaa dheekkamsa isaatti","poem":1},{"text":"natti fide sanaa jiru tokko iyyuu jiraa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Inni ol gubbaadhaa ibidda erge;","poem":1},{"text":"ibidda sana lafee koo keessa seensisa.","poem":2},{"text":"Inni miilla kootiif kiyyoo diriirsee","poem":1},{"text":"dugda duubatti na deebise;","poem":2},{"text":"inni kophaatti na hambisee","poem":1},{"text":"guyyaa guutuu na dadhabsiise.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Cubbuun koo waanjootti hidhameera;","poem":1},{"text":"isaan harka isaatiin walitti foʼaman.","poem":2},{"text":"Isaan morma kootti rarraafaman;","poem":1},{"text":"gooftaan humna koo dadhabsiise.","poem":2},{"text":"Inni warra ani of irraa deebisuu","poem":1},{"text":"hin dandeenyetti dabarsee na kenneera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Gooftaan gootota na keessatti argaman","poem":1},{"text":"hunda gateera;","poem":2},{"text":"inni dargaggoota koo caccabsuuf","poem":1},{"text":"yaaʼii waammate.","poem":2},{"text":"Gooftaan iddoo cuunfaa wayinii isaatti","poem":1},{"text":"Durba Qulqullittii Intala Yihuudaa dhidhiiteera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Wanni ani booʼee","poem":1},{"text":"iji koo imimmaaniin guutameef kanaa dha.","poem":2},{"text":"Namni na jajjabeessuuf dhiʼoo jiru tokko iyyuu hin jiru;","poem":1},{"text":"kan hafuura koo bayyanachiisus hin jiru.","poem":2},{"text":"Sababii diinni humna argateef","poem":1},{"text":"ijoolleen koo harka duwwaa hafan.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Xiyoon harka ishee balʼifatteerti;","poem":1},{"text":"garuu namni ishee jajjabeessu tokko iyyuu hin jiru.","poem":2},{"text":"Akka olloonni isaa amajaajota isaa taʼaniif","poem":1},{"text":"Waaqayyo Yaaqoobitti ajajeera;","poem":2},{"text":"Yerusaalemis gidduu isaaniitti","poem":1},{"text":"waan xuraaʼaa taateerti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Waaqayyo qajeelaa dha;","poem":1},{"text":"taʼus ani ajajawwan isaatti fincileen ture.","poem":2},{"text":"Yaa saboota, hundi keessan dhagaʼaa;","poem":1},{"text":"rakkina koos ilaalaa.","poem":2},{"text":"Dargaggoonnii fi shamarran koo","poem":1},{"text":"boojiʼamanii fudhatamaniiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Ani tumsitoota koo nan waammadhe;","poem":1},{"text":"isaan garuu na ganan.","poem":2},{"text":"Luboonni koo fi maanguddoonni koo","poem":1},{"text":"utuu lubbuu isaanii oolfachuuf","poem":2},{"text":"nyaata barbaadatanuu","poem":1},{"text":"magaalaa keessatti dhuman.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Yaa Waaqayyo akka ani dhiphadhe ilaali!","poem":1},{"text":"Ani keessa kootti dhiphadheera;","poem":2},{"text":"garaa koo keessatti raafameera;","poem":1},{"text":"ani nama akka malee fincilun tureetii.","poem":2},{"text":"Alaa goraadeen nama qala;","poem":1},{"text":"mana keessa immoo duʼa qofatu jira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Namoonni akka ani aadaa jiru dhagaʼaniiru;","poem":1},{"text":"kan na jajjabeessu garuu hin jiru.","poem":2},{"text":"Diinonni koo hundinuu rakkina koo dhagaʼaniiru;","poem":1},{"text":"isaan waan ati gootetti gammadaniiru.","poem":2},{"text":"Akka isaan akkuma koo taʼaniif","poem":1},{"text":"maaloo ati guyyaa jette sana fidi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Hamminni isaanii hundinuu","poem":1},{"text":"fuula kee duratti haa dhiʼaatu;","poem":2},{"text":"waanuma sababii cubbuu koo hundaatiif","poem":1},{"text":"natti fidde sana isaanitti illee fidi!","poem":2},{"text":"Aaduun koo baayʼateeraatii;","poem":1},{"text":"onneen koos dadhabdeerti.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}