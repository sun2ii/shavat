{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"LAM","translationId":"gaz_bib","name":"Faaruu","commonName":"Faaruu","title":"Faaruu Ermiyaas","order":25,"numberOfChapters":5,"sha256":"d61189a1664cf67ecff573b43d020ccffe4f792ec841b1218c4399a15645db77","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/gaz_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Gooftaan akkamitti duumessa dheekkamsa isaatiin","poem":1},{"text":"intala Xiyoon haguuge!","poem":2},{"text":"Inni ulfina Israaʼel","poem":1},{"text":"samiidhaa lafatti gad daddarbateera;","poem":2},{"text":"inni guyyaa dheekkamsa isaatti","poem":1},{"text":"ejjeta miilla isaa hin yaadanne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Gooftaan gara laafina tokko malee","poem":1},{"text":"iddoo jireenya Yaaqoob hunda liqimseera;","poem":2},{"text":"daʼannoo intala Yihuudaas","poem":1},{"text":"dheekkamsa isaatiin diige.","poem":2},{"text":"Inni mootummaa isheetii fi","poem":1},{"text":"bulchitoota ishee salphisee lafatti gad deebise.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Inni dheekkamsa sodaachisaadhaan","poem":1},{"text":"gaanfa Israaʼel hunda caccabse.","poem":2},{"text":"Yommuu diinni dhiʼaatettis","poem":1},{"text":"harka isaa mirgaa duubatti deebifate.","poem":2},{"text":"Inni akkuma arraba ibiddaa kan waan naannoo isaa jiru gubu sanaa","poem":1},{"text":"Yaaqoob keessatti bobaʼe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Inni akkuma diinaatti iddaa isaa dabsate;","poem":1},{"text":"harki isaa mirgaa qophaaʼeera.","poem":2},{"text":"Warra ijatti bareedan hunda","poem":1},{"text":"akkuma amajaajiitti qale;","poem":2},{"text":"dunkaana intala Xiyoonitti","poem":1},{"text":"dheekkamsa isaa akkuma ibiddaa roobse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Gooftaan akkuma diinaa taʼe;","poem":1},{"text":"inni Israaʼelin liqimseera.","poem":2},{"text":"Inni masaraawwan ishee hunda liqimsee","poem":1},{"text":"daʼannoo ishee jabaa illee diigeera.","poem":2},{"text":"Inni Intala Yihuudaatti","poem":1},{"text":"booʼichaa fi faaruu booʼichaa baayʼiseera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Inni lafa jireenya isaa akkuma iddoo biqiltuu onseera;","poem":1},{"text":"iddoo wal gaʼii isaas balleesseera.","poem":2},{"text":"Waaqayyo akka Xiyoon ayyaana ishee kan murtaaʼee fi","poem":1},{"text":"Sanbatoota ishee irraanfattu godheera;","poem":2},{"text":"inni dheekkamsa isaa sodaachisaa sanaan","poem":1},{"text":"moototaa fi luboota akka malee tuffate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gooftaan iddoo aarsaa isaa tuffateera;","poem":1},{"text":"iddoo qulqulluu isaa illee dhiiseera.","poem":2},{"text":"Dallaawwan masaraawwan ishee","poem":1},{"text":"dabarsee harka diinotaatti kenneera;","poem":2},{"text":"isaan akkuma guyyaa ayyaana murteeffameetti","poem":1},{"text":"mana Waaqayyoo keessatti sagalee ol fudhatanii iyyan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Waaqayyo dallaa naannoo","poem":1},{"text":"Intala Xiyoon jiru diiguuf murteesseera.","poem":2},{"text":"Inni safartuu diriirseera;","poem":1},{"text":"barbadeessuu irraas harka isaa hin deebifanne.","poem":2},{"text":"Akka dallaan eegumsaatii fi keenyan faarsanii booʼan godhe;","poem":1},{"text":"isaanis tokkummaadhaan badan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Karrawwan ishee lafa keessa dhidhimaniiru;","poem":1},{"text":"inni danqaraawwan sibiila ishee caccabsee balleesseera.","poem":2},{"text":"Mootiin isheetii fi ilmaan mootota ishee boojiʼamaniisaboota gidduu bibittinnaaʼaniiru;","poem":1},{"text":"seerri siʼachi hin jiraatu;","poem":2},{"text":"raajonni ishees siʼachi","poem":1},{"text":"Waaqayyo biraa mulʼata hin argan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Maanguddoonni Intala Xiyoon","poem":1},{"text":"calʼisanii lafa tataaʼan;","poem":2},{"text":"isaan daaraa mataatti firfirfatanii","poem":1},{"text":"uffata gaddaas uffatan.","poem":2},{"text":"Shamarran Yerusaalem","poem":1},{"text":"mataa isaanii gad qabatan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Iji koo booʼichaan dadhabeera;","poem":1},{"text":"keessa kootti dhiphadheera;","poem":2},{"text":"sababii sabni koo dhumeef","poem":1},{"text":"sababii ijoollee fi daaʼimman","poem":2},{"text":"daandiiwwan magaalaa irratti gaggabaniif","poem":1},{"text":"garaan koo gaddaan laafeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Isaan yommuu daandiiwwan magaalaa irratti","poem":1},{"text":"akkuma namoota madaaʼaniitti gaggabanitti,","poem":2},{"text":"yommuu lubbuun isaanii","poem":1},{"text":"hammuu haadha isaanii irratti baʼuuf jirtutti","poem":2},{"text":"“Buddeennii fi daadhiin wayinii eessaa jiru?”","poem":1},{"text":"jedhanii haadhota isaanii gaafatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yaa intala Yerusaalem,","poem":1},{"text":"ani maal siif jechuun dandaʼa?","poem":2},{"lineBreak":true},{"text":"Maaliinan wal si qixxeessa?","poem":2},{"text":"Yaa Intala Xiyoon durba qulqullittii","poem":1},{"text":"ani akkan si jajjabeessuuf","poem":2},{"lineBreak":true},{"text":"maalittin si fakkeessuu dandaʼa?","poem":2},{"text":"Madaan kee akkuma galaanaa gad fagoo dha.","poem":1},{"text":"Eenyutu si fayyisuu dandaʼa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mulʼanni raajota keetii","poem":1},{"text":"sobaa fi kan faayidaa hin qabnee dha;","poem":2},{"text":"isaan boojiʼamuu kee hambisuuf","poem":1},{"text":"cubbuu kee ifa hin baafne.","poem":2},{"text":"Raajiin isaan siif kennanis","poem":1},{"text":"sobaa fi kan karaa irraa nama balleessuu dha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Warri karaa keetiin darban hundinuu","poem":1},{"text":"harka isaanii sitti rurrukutu;","poem":2},{"text":"isaanis intala Yerusaalemitti","poem":1},{"text":"qoosuu fi mataa raasuudhaan,","poem":2},{"text":"“Magaalaan muummee miidhaginaa","poem":1},{"text":"gammachuu guutuu lafaa","poem":2},{"lineBreak":true},{"text":"jedhamtee waamamte sun kanaa?” jedhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Diinonni kee hundinuu","poem":1},{"text":"afaan isaanii sitti banatu;","poem":2},{"text":"isaan qoosuu fi ilkaan isaanii qaruudhaan","poem":1},{"text":"“Nu ishee liqimsineerra.","poem":2},{"text":"Guyyaan nu eeggachaa turre sun kanaa dha;","poem":1},{"text":"nu waan kana arguuf jiraanneerra” jedhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Waaqayyo waan karoorfate hojjeteera;","poem":1},{"text":"dubbii isaa kan bara dheeraan dura","poem":2},{"lineBreak":true},{"text":"dubbate sana guuttateera.","poem":2},{"text":"Inni gara laafina tokko malee si garagalcheera;","poem":1},{"text":"akka diinni kee sitti gammadu godheera;","poem":2},{"lineBreak":true},{"text":"gaanfa amajaajii keetii ol ol qabeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Onneen namootaa","poem":1},{"text":"gara Gooftaatti iyya.","poem":2},{"text":"Yaa dallaa Intala Xiyoon","poem":1},{"text":"halkanii guyyaa","poem":2},{"lineBreak":true},{"text":"imimmaan kee akka lagaa haa yaaʼu;","poem":2},{"text":"boqonnaa tokko illee ofii keetiif hin kennin;","poem":1},{"text":"iji kees hin boqotin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yommuu eegumsi halkanii jalqabutti","poem":1},{"text":"kaʼiitii halkaniin iyyi;","poem":2},{"text":"fuula Gooftaa duratti","poem":1},{"text":"onnee kee akka bishaanii dhangalaasi.","poem":2},{"text":"Lubbuu ijoollee keetii","poem":1},{"text":"kanneen fiixee daandii hundaatti","poem":2},{"text":"beelaan gaggabaniitiif jedhiitii","poem":1},{"text":"harka kee gara isaatti ol qabadhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Yaa Waaqayyo, ati ilaali; argis:","poem":1},{"text":"Ati takkumaa eenyu irratti waan akkasii gootee beekta?","poem":2},{"text":"Haadhonni daaʼimman isaanii,","poem":1},{"text":"ijoollee kunuunsanii guddisan nyaachuu qabuu?","poem":2},{"text":"Lubnii fi raajiin,","poem":1},{"text":"iddoo qulqulluu kan Gooftaa keessatti ajjeefamuu qabuu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Dargaggoonnii fi maanguddoonni,","poem":1},{"text":"walii wajjin awwaara karaa irra ciisu;","poem":2},{"text":"dargaggoonnii fi shamarran koo","poem":1},{"text":"goraadeedhaan ajjeefamaniiru.","poem":2},{"text":"Ati gaafa dheekkamsa keetiitti isaan fixxe;","poem":1},{"text":"gara laafina tokko malee isaan qalte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Ati akkuma guyyaa ayyaana murteeffameetti","poem":1},{"text":"nama waamtutti qixa hundaanuu sodaa natti waamte.","poem":2},{"text":"Guyyaa dheekkamsa Waaqayyootti,","poem":1},{"text":"homaa hin miliqne yookaan hin hafne;","poem":2},{"text":"warra ani daʼee guddise","poem":1},{"text":"diinni koo na jalaa balleesseera.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}