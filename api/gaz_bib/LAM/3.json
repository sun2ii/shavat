{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"LAM","translationId":"gaz_bib","name":"Faaruu","commonName":"Faaruu","title":"Faaruu Ermiyaas","order":25,"numberOfChapters":5,"sha256":"d61189a1664cf67ecff573b43d020ccffe4f792ec841b1218c4399a15645db77","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/gaz_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Namni ulee dheekkamsa isaatiin","poem":1},{"text":"rakkina arge anaa dha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inni fuula isaa duraa na ariʼee","poem":1},{"text":"akka ani qooda ifaa dukkana keessa deemu na godhe;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"dhugumaan inni guyyaa guutuu,","poem":1},{"text":"ammumaa amma harka isaa natti deebise.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Inni foon kootii fi gogaa koo dulloomseera;","poem":1},{"text":"lafee koo illee caccabseera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inni na marsee hadhaaʼummaa fi","poem":1},{"text":"gidiraa natti naannesseera.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Akkuma warra dur dhumanii","poem":1},{"text":"akka ani dukkana keessa jiraadhu na godhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Inni akka ani hin miliqneef dallaa natti ijaare;","poem":1},{"text":"foncaa ulfaatus natti feʼe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yommuu ani waammadhu yookaan gargaarsaaf iyyadhutti illee","poem":1},{"text":"inni kadhannaa koo dhagaʼuu dida.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Karaa koo dhagaa soofameen cufe;","poem":1},{"text":"daandii koo illee ni jalʼisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Inni akkuma amaaketa riphee waa eeggatuu,","poem":1},{"text":"akkuma leenca dhokatee jiruu","poem":2}]},{"type":"verse","number":11,"content":[{"text":"daandii irraa na harkisee na ciccire;","poem":1},{"text":"kophaatti na gate.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Inni iddaa isaa luqqifatee","poem":1},{"text":"xiyya isaa natti qabe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Korojoo isaa keessaa xiyya baasee","poem":1},{"text":"onnee koo waraane.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ani saba koo hundaaf waan kolfaa nan taʼe;","poem":1},{"text":"isaan guyyaa guutuu faaruudhaan natti qoosu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Inni waan hadhaaʼaa na nyaachise;","poem":1},{"text":"hadhooftuu illee na quubse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Inni dhagaadhaan ilkaan koo cabse;","poem":1},{"text":"awwaara keessattis na dhidhiite.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ani nagaa nan dhabe;","poem":1},{"text":"gammachuun maal akka taʼes nan irraanfadhe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kanaafuu ani “Ulfinni koo,","poem":1},{"text":"abdiin ani Waaqayyo irraa qabu hundinuu badeera” nan jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ani rakkinaa fi asii achi jooruu koo,","poem":1},{"text":"hadhaaʼummaa fi hadhooftuus nan yaadadha.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Lubbuun koo yeroo hunda waan kana yaaddi;","poem":1},{"text":"na keessattis gad of qabdi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Taʼus ani waan kana nan qalbeeffadha;","poem":1},{"text":"kanaafuu ani abdii qaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Nu sababii jaalala Waaqayyoo guddaa sanaatiif hin badnu;","poem":1},{"text":"gara laafinni isaa hin dhumuutii.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Isaan ganama hunda haaraa dha;","poem":1},{"text":"amanamummaan kees guddaa dha.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Anis, “Waaqayyo qooda koo ti;","poem":1},{"text":"kanaafuu ani isa nan eeggadha” ofiin nan jedha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Waaqayyo warra isa abdataniif,","poem":1},{"text":"kanneen isa barbaadaniif gaarii dha;","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Fayyisuu Waaqayyoo","poem":1},{"text":"calʼisanii eeggachuun gaarii dha.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Yeroo dargaggummaa isaatti","poem":1},{"text":"waanjoo baachuun namaaf gaarii dha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Inni kophaa isaa calʼisee haa taaʼu;","poem":1},{"text":"Waaqayyo isa baachiseeraatii.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Amma illee abdiin ni jira taʼaatii,","poem":1},{"text":"inni fuula isaa awwaara keessa haa suuqqatu.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Inni nama isa dhaʼutti maddii isaa haa qabu;","poem":1},{"text":"salphinaanis haa guutamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Gooftaan bara baraan","poem":1},{"text":"nama hin gatuutii.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Inni gadda fidu illee garaa ni laafa;","poem":1},{"text":"jaalalli isaa kan hin geeddaramne sun guddaadhaatii.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Inni itti yaadee rakkina","poem":1},{"text":"yookaan dhiphina sanyii namaatti hin fiduutii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Yommuu hidhamtoonni biyyattii keessa jiran hundi","poem":1},{"text":"miilla jalatti dhidhiitaman,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"yommuu fuula Waaqa Waan Hundaa Olii duratti","poem":1},{"text":"mirgi nama tokkoo dhiibamu,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"yommuu murtiin qajeelaan dhabamu,","poem":1},{"text":"Gooftaan waan akkasii hin arguu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Yoo Gooftaan ajajuu baate","poem":1},{"text":"eenyutu dubbatee waan sana fiixaan baasuu dandaʼa?","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Wanni hamaanii fi wanni gaariin","poem":1},{"text":"afaanuma Waaqa Waan Hundaa Oliitii baʼa mitii?","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Yoos namni lubbuun jiraatu kam iyyuu","poem":1},{"text":"maaliif yommuu cubbuu isaatiifadabamutti guunguma ree?","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Kottaa nu daandii keenya qorree haa ilaallu;","poem":1},{"text":"gara Waaqayyoottis haa deebinu.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Nu onnee keenyaa fi harka keenya","poem":1},{"text":"gara Waaqa samii keessa jiruutti ol qabnee akkana haa jennu:","poem":2}]},{"type":"verse","number":42,"content":[{"text":"“Nu cubbuu hojjenneerra; fincilleerras;","poem":1},{"text":"atis nuuf hin dhiifne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"“Ati dheekkamsaan of haguugdee nu ariite;","poem":1},{"text":"gara laafina malees nu fixxe.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Akka kadhannaan tokko iyyuu gara kee hin dhufneef","poem":1},{"text":"ati duumessaan of haguugde.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Ati saboota gidduutti","poem":1},{"text":"xurii fi kosii nu goote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"“Diinonni keenya hundinuu,","poem":1},{"text":"afaan nutti banataniiru.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Sodaa fi kiyyoon,","poem":1},{"text":"diigamuu fi badiisni nutti dhufeera.”","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Sababii uummanni koo barbadaaʼeef","poem":1},{"text":"lolaan imimmaanii ija koo keessaa yaaʼa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"Iji koo boqonnaa malee","poem":1},{"text":"utuu gargar hin kutin imimmaan lolaasa;","poem":2}]},{"type":"verse","number":50,"content":[{"text":"kunis hamma Waaqayyo","poem":1},{"text":"ol samiidhaa gad ilaalee argutti.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Sababii dubartoota magaalaa koo hundaatiif","poem":1},{"text":"wanni ani argu lubbuu koo gaddisiisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Warri sababii malee diina natti taʼan","poem":1},{"text":"akkuma simbiraa na adamsan.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Isaan lubbuu koo boolla keessatti galaafatanii","poem":1},{"text":"dhagaa natti garagalchuu yaalan;","poem":2}]},{"type":"verse","number":54,"content":[{"text":"bishaan mataa koo irra gara gale;","poem":1},{"text":"anis, “Baduu koo ti” nan jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":55,"content":[{"text":"Yaa Waaqayyo, ani boolla qilee keessaa","poem":1},{"text":"maqaa kee nan waammadha.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Ati kadhannaa koo kan,“Iyya ani gargaarsa barbaachaaf iyyu","poem":1},{"text":"dhagaʼuu hin didin” jedhu dhageesseerta.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Yeroo ani si waammadhetti ati natti dhiʼaattee","poem":1},{"text":"“Hin sodaatin” naan jette.","poem":2}]},{"type":"line_break"},{"type":"verse","number":58,"content":[{"text":"Yaa gooftaa ati dubbii koo naa falmite;","poem":1},{"text":"lubbuu koos ni baraarte.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Yaa Waaqayyo, ati daba natti hojjetame argiteerta;","poem":1},{"text":"dubbii koo naa ilaali!","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Ati haaloo baʼuu isaaniitii fi","poem":1},{"text":"natti malachuu isaanii hundas argiteerta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":61,"content":[{"text":"Yaa Waaqayyo, ati arraba isaaniitii fi","poem":1},{"text":"natti malachuu isaanii hunda dhageesseerta;","poem":2}]},{"type":"verse","number":62,"content":[{"text":"kunis arraba warra natti kaʼaniitii fi","poem":1},{"text":"waan isaan guyyaa guutuu waaʼee koo hasaasanii dha.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Ati isaan ilaali! Isaan taaʼanii yookaan dhadhaabatanii","poem":1},{"text":"weedduu isaaniitiin natti qoosu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":64,"content":[{"text":"Yaa Waaqayyo, waan isaaniif malu","poem":1},{"text":"akkuma hojii harka isaaniitti deebisii kenniif.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Onnee isaanii haguugi;","poem":1},{"text":"abaarsi kees isaan irra haa buʼu!","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Samiiwwan Waaqayyoo jalaa","poem":1},{"text":"dheekkamsaan isaan ariʼii isaan balleessis.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}