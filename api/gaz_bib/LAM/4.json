{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"LAM","translationId":"gaz_bib","name":"Faaruu","commonName":"Faaruu","title":"Faaruu Ermiyaas","order":25,"numberOfChapters":5,"sha256":"d61189a1664cf67ecff573b43d020ccffe4f792ec841b1218c4399a15645db77","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/gaz_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Warqeen akkamitti boorrajjaaʼe?","poem":1},{"text":"Warqeen qulqulluunis akkamitti geeddarame!","poem":2},{"text":"Dhagaawwan iddoo qulqulluu","poem":1},{"text":"fiixee daandiiwwan hundaa irratti bibittinnaaʼaniiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ilmaan Xiyoon kanneen akka","poem":1},{"text":"warqee qulqulluutti ilaalamaa turan sun","poem":2},{"text":"amma akkamitti akka okkotee supheetti,","poem":1},{"text":"akka hojii suphee dhooftuutti ilaalamu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Waangoonni iyyuu ilmaan isaanii hoosisuuf","poem":1},{"text":"harma isaanii ni kennu;","poem":2},{"text":"sabni koo garuu akkuma guchii gammoojjii","poem":1},{"text":"gara jabeessa taʼeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Sababii dheebuutiif arrabni daaʼimmanii","poem":1},{"text":"laagaatti maxxana;","poem":2},{"text":"ijoolleen buddeena kadhatti:","poem":1},{"text":"garuu namni isaaniif kennu tokko iyyuu hin jiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Warri dur cidha nyaachaa turan,","poem":1},{"text":"rakkatanii daandii irra jiru.","poem":2},{"text":"Warri dur uffata diimaa dhiilgee uffachaa turan","poem":1},{"text":"harʼa tuullaa dikee hammatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Adabbiin yakka saba koo","poem":1},{"text":"adabbii yakka Sodoom","poem":2},{"text":"kan utuu harki nama ishee gargaaruuf hin tuqin","poem":1},{"text":"tasa badde sanaa caalaa guddaa ture.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ilmaan mootota isaanii cabbii caalaa qulqulluu,","poem":1},{"text":"aannan caalaa adaadii turan;","poem":2},{"text":"dhagni isaanii lula diimaa caalaa diimaa,","poem":1},{"text":"bifti isaanii immoo sanpeer fakkaata ture.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Amma garuu qaqaa caalaa gurraachaʼaniiru;","poem":1},{"text":"daandii irrattis namni isaan hubatu hin jiru.","poem":2},{"text":"Gogaan isaanii lafee isaaniitti maxxaneera;","poem":1},{"text":"akka mukaas gogeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Warra beelaan dhumanii mannaa,","poem":1},{"text":"warra goraadeedhaan ajjeefaman wayya;","poem":2},{"text":"Isaan waan nyaatamu lafa qotiisaa irraa dhabanii","poem":1},{"text":"beelaan alatti goggoganii dhumu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yeroo sabni koo dhumetti","poem":1},{"text":"dubartoonni gara laafoon harkuma isaaniitiin","poem":2},{"text":"akka nyaata isaanii taʼaniif","poem":1},{"text":"ijoollee ofii affeelan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Waaqayyo dheekkamsa isaa guutuu gad dhiise;","poem":1},{"text":"aarii isaa sodaachisaa sanas ni dhangalaase.","poem":2},{"text":"Xiyoon keessattis","poem":1},{"text":"ibidda hundeewwan ishee barbadeessu qabsiise.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Akka diinonni yookaan amajaajonni","poem":1},{"text":"karrawwan Yerusaalem seenuu dandaʼan,","poem":2},{"text":"mootonni biyya lafaa","poem":1},{"text":"yookaan sabni addunyaa tokko iyyuu hin amanne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Garuu wanni kun sababii cubbuu","poem":1},{"text":"raajota isheetii fi balleessaa luboota ishee","poem":2},{"text":"kanneen ishee keessatti dhiiga qajeelotaa","poem":1},{"text":"dhangalaasan sanaatiif taʼe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Isaan akkuma jaamotaa","poem":1},{"text":"daandii irra gatantaru.","poem":2},{"text":"Hamma namni tokko iyyuu wayyaa isaanii tuquu hin dandeenyetti","poem":1},{"text":"akka malee dhiigaan xuraaʼaniiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Namoonnis, “Isin xuraaʼoo dha! Asii badaa!","poem":1},{"text":"Badaa! Badaa! Nu hin tuqinaa!” jedhanii isaanitti iyyu.","poem":2},{"text":"Yommuu baqatanii asii fi achi jooranittis","poem":1},{"text":"saboonni Namoota Ormaa gidduu jiran,","poem":2},{"lineBreak":true},{"text":"“Isaan siʼachi as jiraachuu hin dandaʼan” jedhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Waaqayyo mataa isaatu isaan bittinneesse;","poem":1},{"text":"inni siʼachi isaan hin eegu.","poem":2},{"text":"Luboonni hin kabajamne;","poem":1},{"text":"maanguddoonni surraa hin arganne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Akkasumaan gargaarsa eeggachuudhaan","poem":1},{"text":"iji keenya dadhabe;","poem":2},{"text":"gamoo keenya irra teenyee","poem":1},{"text":"saba nu baasuu hin dandeenye irraa gargaarsa eegganne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Akka nu daandii keenya irra deemuu hin dandeenyeef","poem":1},{"text":"namoonni tarkaanfii keenya eegu.","poem":2},{"text":"Dhumni keenya dhiʼaateera;guyyoonni keenyas gabaabataniiru;","poem":1},{"text":"badiisni keenya dhufeeraatii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Warri nu ariʼan","poem":1},{"text":"risaa samii caalaa saffisu;","poem":2},{"text":"isaan tulluuwwan irraa nu ariʼanii","poem":1},{"text":"gammoojjii keessatti riphanii nu eeggatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Hafuurri lubbuu keenyaa kan Waaqayyo dibe,","poem":1},{"text":"kiyyoo isaaniitiin qabame.","poem":2},{"text":"Nu waan gaaddidduu isaa jala,","poem":1},{"text":"Namoota Ormaa gidduu jiraannu seenee turre.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Yaa Intala Edoom kan biyya Uuzi keessa jiraattu","poem":1},{"text":"ati ililchi, gammadis.","poem":2},{"text":"Garuu xoofoon sun siifis ni kennama;","poem":1},{"text":"atis machooftee qullaa kee hafta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Intala Xiyoon adabamuun kee ni dhuma;","poem":1},{"text":"inni bara boojiʼamuu keetii hin dheeressu.","poem":2},{"text":"Garuu yaa Intala Edoom, inni cubbuu kee ni adabe;","poem":1},{"text":"hammina kees ifatti baasa.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}