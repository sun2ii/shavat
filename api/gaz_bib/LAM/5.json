{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"LAM","translationId":"gaz_bib","name":"Faaruu","commonName":"Faaruu","title":"Faaruu Ermiyaas","order":25,"numberOfChapters":5,"sha256":"d61189a1664cf67ecff573b43d020ccffe4f792ec841b1218c4399a15645db77","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/gaz_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Yaa Waaqayyo, waan nurra gaʼe yaadadhu;","poem":1},{"text":"ilaali; salphina keenyas argi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Handhuuraan keenya alagootaaf,","poem":1},{"text":"manneen keenyas Namoota Ormaatiifdabarfamanii kennamaniiru.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nu ijoollee abbaa hin qabne taane;","poem":1},{"text":"haadhonni keenya immoohaadhota hiyyeessaa taʼaniiru.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nu bishaan dhugnuuf kaffaluu qabna turre;","poem":1},{"text":"qoraan illee bittaa qofaan arganna.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Warri nu ariʼan koomee keenya bira jiru;","poem":1},{"text":"nu dadhabneerra; boqonnaas hin qabnu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nu buddeena gaʼaa argachuuf jennee","poem":1},{"text":"warra Gibxittii fi warra Asooritti harka kennine;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abbootiin keenya cubbuu hojjetanii darban;","poem":1},{"text":"nu immoo adabbii isaanii baanne.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Garbootatu nu bulcha;","poem":1},{"text":"namni harka isaaniitii bilisa nu baasu tokko iyyuu hin jiru.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sababii goraadee gammoojjii jiruutiin","poem":1},{"text":"lubbuu keenya balaaf saaxillee buddeena arganna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gogaan keenya sababii beelaatiin","poem":1},{"text":"akkuma badaa ibiddaa hoʼa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Xiyoon keessatti dubartoonni,","poem":1},{"text":"magaalaawwan Yihuudaa keessattis dubarran qulqulluunhumnaan gudeedaman.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ilmaan moototaa harka isaaniitiin fannifamaniiru;","poem":1},{"text":"maanguddoonni ulfina hin arganne.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gaʼeessonni akka midhaan daakan dirqisiifaman;","poem":1},{"text":"ijoolleen dhiiraa muka baachuun gatantaran.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Maanguddoonni karra magaalaa duraa deemaniiru;","poem":1},{"text":"dargaggoonnis weedduu isaanii dhiisaniiru.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Gammachuun garaa keenya keessaa badeera;","poem":1},{"text":"shuubbisuun keenyas booʼichatti geeddarameera.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Gonfoon mataa keenya irraa buʼeera.","poem":1},{"text":"Nuuf wayyoo; nu cubbuu hojjenneerraatii!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sababii waan kanaatiif onneen keenya ni gaggabe;","poem":1},{"text":"sababii waan kanaatiif immoo iji keenya dadhabe;","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tulluun Xiyoon kan onee hafe sun","poem":1},{"text":"lafa waangoonni irra burraaqan taʼeeraatii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yaa Waaqayyo, ati bara baraan bulchi;","poem":1},{"text":"teessoon kees dhalootaa gara dhalootaatti itti fufa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ati maaliif guutumaan guutuutti nu irraanfatta?","poem":1},{"text":"Maaliif bara dheeraas nu dhiifta?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yaa Waaqayyo, akka nu deebinuuf ofitti nu deebisi;","poem":1},{"text":"bara keenya illee akkuma duriitti haaromsi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ati yoo guutumaan guutuutti nu gatuu baatte,","poem":1},{"text":"yoo akka malees nutti dheekkamuu baatte waan kana godhi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}