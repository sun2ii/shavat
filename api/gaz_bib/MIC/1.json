{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"MIC","translationId":"gaz_bib","name":"Miikiyaas","commonName":"Miikiyaas","title":"Raajii Miikiyaas","order":33,"numberOfChapters":7,"sha256":"b81c8b4e23958700833f10de7a2f6b4f00f4e6626c2fc4363e5eacc3ad5e05b9","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/gaz_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Bara Yootaam, Aahaazii fi Hisqiyaas mootota Yihuudaa turan keessa dubbiin Waaqayyoo gara Miikiyaas namicha Mooresheet dhufe; kunis mulʼata inni waaʼee Samaariyaatii fi waaʼee Yerusaalem argee dha."]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yaa namoota, isin hundinuu dhagaʼaa;","poem":1},{"text":"lafaa fi wantoonni ishee irra jiraattan hundinuu dhaggeeffadhaa;","poem":2},{"text":"Waaqayyo Gooftichi,","poem":1},{"text":"Gooftaan mana qulqullummaa isaa qulqulluu sana keessaadhugaa isinitti baʼa.","poem":2}]},{"type":"heading","content":["Murtii Samaariyaa fi Yerusaalemin Eeggatu"]},{"type":"verse","number":3,"content":[{"text":"Kunoo! Waaqayyo iddoo jireenya isaatii dhufaa jira;","poem":1},{"text":"inni gad dhufee iddoo ol kaʼaa lafaa irra ni ejjeta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Akkuma gagaa fuula ibiddaa dura jiruu,","poem":1},{"text":"akkuma bishaan tabba irraa gad yaaʼuu","poem":2},{"text":"tulluuwwan isa jalatti ni baqu;","poem":1},{"text":"sululawwanis gargar baqaqu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wanni kun hundi sababii dogoggora Yaaqoobiif,","poem":1},{"text":"sababii cubbuu mana Israaʼeliif taʼe.","poem":2},{"text":"Dogoggorri Yaaqoob maali?","poem":1},{"text":"Samaariyaa mitii?","poem":2},{"text":"Iddoon sagadaa Yihuudaa maali?","poem":1},{"text":"Yerusaalem mitii?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Kanaafuu ani Samaariyaa tuullaa diigamaa,","poem":1},{"text":"lafa wayinii itti dhaabbatan nan godha.","poem":2},{"text":"Ani dhagaawwan ishee sululatti naqee,","poem":1},{"text":"hundee ishee qullaa nan hambisa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Waaqonni ishee tolfamoon hundinuu ni hurreeffamu;","poem":1},{"text":"kennaawwan mana qulqullummaa ishee hundinuu ibiddaan gubamu;","poem":2},{"lineBreak":true},{"text":"ani fakkii ishee hunda nan barbadeessa.","poem":2},{"text":"Isheen gatii sagaagaltootaa irraa kennaa ishee walitti waan qabatteef,","poem":1},{"text":"kennaan sun ammas gatii sagaagaltootaa taʼee ni deebiʼa.”","poem":2}]},{"type":"heading","content":["Booʼuu fi Gadduu"]},{"type":"verse","number":8,"content":[{"text":"Sababii waan kanaatiif ani booʼee nan wawwaadha;","poem":1},{"text":"ani miilla duwwaa fi qullaa nan deema.","poem":2},{"text":"Ani akkuma waangoo iyyee,","poem":1},{"text":"akkuma urunguu nan aada.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Madaan ishee waan hin fayyineef,","poem":1},{"text":"Yihuudaattis darbeera.","poem":2},{"text":"Karra saba koo dura gaʼeera;","poem":1},{"text":"Yerusaalemittis dhufeera.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Isin waan kana Gaati keessatti hin dubbatinaa;","poem":1},{"text":"gonkumaa hin booʼinaa.","poem":2},{"text":"Beet Leʼafraatti,","poem":1},{"text":"awwaara keessa gangaladhaa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isin warri Shaafiir keessa jiraattan,","poem":1},{"text":"qullaa fi qaaniidhaan darbaa.","poem":2},{"text":"Warri Zanaan keessa jiraatan,","poem":1},{"text":"gad hin baʼan.","poem":2},{"text":"Beet Eezel booʼicha irra jirti;","poem":1},{"text":"eegumsi ishee isin irraa fuudhameera.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sababii balaan Waaqayyo biraa dhufee","poem":1},{"text":"karra Yerusaalem iyyuu gaʼeef,","poem":2},{"text":"warri Maaroot keessa jiraatan","poem":1},{"text":"gargaarsa argachuuf wixxirfatu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ati Laakkiish keessa kan jiraattu,","poem":1},{"text":"fardeen gaariitti hidhadhu.","poem":2},{"text":"Ati Intala Xiyooniif","poem":1},{"text":"jalqaba cubbuu ti;","poem":2},{"text":"dogoggorri Israaʼel","poem":1},{"text":"siʼi keessatti argamaatii.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kanaafuu ati Mooresheet Gaatiif","poem":1},{"text":"kennaa kennita.","poem":2},{"text":"Manneen Akziib mootota Israaʼeliif","poem":1},{"text":"gowwoomsitoota taʼu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ani warra Maareeshaa keessa jiraattanitti","poem":1},{"text":"moʼataa tokko nan fida.","poem":2},{"text":"Inni ulfina Israaʼel taʼe","poem":1},{"text":"gara Adulaam ni dhufa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Sababii gadda ijoollee itti gammadduutiif jedhii","poem":1},{"text":"mataa kee haaddadhu;","poem":2},{"text":"akkuma goggocoroo mataa kee moleeffadhu;","poem":1},{"text":"isaan boojuudhaan sirraa fudhatamuutii.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}