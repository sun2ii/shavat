{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"MIC","translationId":"gaz_bib","name":"Miikiyaas","commonName":"Miikiyaas","title":"Raajii Miikiyaas","order":33,"numberOfChapters":7,"sha256":"b81c8b4e23958700833f10de7a2f6b4f00f4e6626c2fc4363e5eacc3ad5e05b9","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/gaz_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":2,"content":[{"type":"heading","content":["Karoora Namaatii fi Karoora Waaqaa"]},{"type":"verse","number":1,"content":[{"text":"Warra daba karoorfatan","poem":1},{"text":"kanneen siree isaanii irraciisanii hammina yaadaniif wayyoo!","poem":2},{"text":"Sababii waan kana hojjechuun humna isaanii jala jiruuf","poem":1},{"text":"isaan ifa bariitiin kaʼanii waan sana hojjetu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isaan lafa qotiisaa kajeelanii qabatu;","poem":1},{"text":"manneenis akkasuma kajeelanii fudhatu.","poem":2},{"text":"Isaan gowwoomsaadhaan mana namaa,","poem":1},{"text":"dhaala isaas ni fudhatu.","poem":2}]},{"type":"verse","number":3,"content":["Kanaafuu Waaqayyo akkana jedha;",{"text":"“Kunoo ani balaa isin jalaa baʼuu hin dandeenye tokko","poem":1},{"text":"saba kanatti fiduuf karoorfadheen jira.","poem":2},{"text":"Isin siʼachi of tuulummaadhaan jiraachuu hin dandeessan;","poem":1},{"text":"yeroon kun yeroo rakkinaa taʼaatii.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bara sana keessa namoonni isinitti gaʼisu;","poem":1},{"text":"akkana jedhaniis faaruu booʼichaa kanaan isinitti qoosu;","poem":2},{"text":"‘Nu guutumaan guutuutti barbadoofneerra;","poem":1},{"text":"qabeenyi saba kootiis gargar qooddatameera.","poem":2},{"text":"Inni narraa fudhata!","poem":1},{"text":"Lafa qotiisaa keenya warra nu moʼataniif kenna.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kanaafuu ati nama ixaadhaan lafa qoodu tokko illee","poem":1},{"text":"waldaa Waaqayyoo keessaa hin qabaattu.","poem":2}]},{"type":"heading","content":["Raajota Sobaa"]},{"type":"verse","number":6,"content":[{"text":"Raajonni isaanii, “Isin raajii hin dubbatinaa;","poem":1},{"text":"waaʼee waan kanaa raajii hin dubbatinaa;","poem":2},{"lineBreak":true},{"text":"salphinni nutti hin dhufu” jedhu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yaa mana Yaaqoob, “Wanni kun akkana jedhamuu qabaa?","poem":1},{"text":"Hafuurri Waaqayyoo obsa hin qabuu?","poem":2},{"lineBreak":true},{"text":"Inni waan akkasii ni hojjetaa?”","poem":2},{"lineBreak":true},{"text":"“Nama karaan isaa qajeelaa taʼeef","poem":1},{"text":"dubbiin koo waan gaarii hin hojjetuu?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sabni koo akka diinaatti kaʼeera.","poem":1},{"text":"Isin namoota yaaddoo malee achiin darban","poem":2},{"lineBreak":true},{"text":"kanneen duulaa galaa jiran irraa uffata baafattu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isin dubartoota saba kootii","poem":1},{"text":"manneen isaanii babbareedoo keessaa ariitu.","poem":2},{"text":"Eebba koos bara baraan","poem":1},{"text":"ijoollee isaanii irraa fudhattu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kaʼaatii asii deemaa!","poem":1},{"text":"Iddoon kun lafa boqonnaa keessanii miti;","poem":2},{"lineBreak":true},{"text":"isheen xurooftee diigamtee baddeerti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Namni sobaa fi gowwoomsaan tokko yoo dhufee,","poem":1},{"text":"‘Ani waaʼee daadhii wayiniitii fi","poem":2},{"lineBreak":true},{"text":"dhugaatii cimaa raajii siif nan dubbadha’ jedhe;","poem":2},{"lineBreak":true},{"text":"inni raajii saba kanaa taʼa!","poem":2}]},{"type":"heading","content":["Furamni Waadaa Galame"]},{"type":"verse","number":12,"content":[{"text":"“Yaa Yaaqoob, ani dhugumaan","poem":1},{"text":"isin hunda walitti nan qaba;","poem":2},{"lineBreak":true},{"text":"ani hambaa Israaʼel walitti nan fida.","poem":2},{"text":"Ani akkuma hoolota gola keessaatti,","poem":1},{"text":"akkuma bushaayee lafa dheedaa jiraniitti walitti isaan nan fida;","poem":2},{"lineBreak":true},{"text":"lafti sunis tuuta namaatiin guutamti.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Inni cabsee karaa baasu fuula isaanii dura deema;","poem":1},{"text":"isaan cabsanii karraan baʼu.","poem":2},{"text":"Mootiin isaanii isaan dura baʼa;","poem":1},{"text":"Waaqayyo fuula isaanii dura deema.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/MIC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/MIC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/MIC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}