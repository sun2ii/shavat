{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"MIC","translationId":"gaz_bib","name":"Miikiyaas","commonName":"Miikiyaas","title":"Raajii Miikiyaas","order":33,"numberOfChapters":7,"sha256":"b81c8b4e23958700833f10de7a2f6b4f00f4e6626c2fc4363e5eacc3ad5e05b9","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/gaz_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"heading","content":["Hooggantoonnii fi Raajonni Balaaleffataman"]},{"type":"verse","number":1,"content":["Ergasii ani akkanan jedhe;",{"text":"“Isin hooggantoonni Yaaqoob,","poem":1},{"text":"bulchitoonni mana Israaʼel mee dhaggeeffadhaa.","poem":2},{"text":"Isin murtii qajeelaa beekuu hin qabdanii?","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Isin warri waan gaarii jibbitanii waan hamaa jaallattan,","poem":2},{"text":"warri saba koo irraa gogaa,","poem":1},{"text":"lafee isaanii irraa immoo foon baaftan,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"warri foon saba koo nyaattan,","poem":1},{"text":"kanneen gogaa isaanii irraa qunciftaniilafee isaanii caccabsitan,","poem":2},{"text":"isin warri akka foon eeleetti waadamuutii fi","poem":1},{"text":"okkoteetti affeelamuu isaan ciccirtan","poem":2},{"lineBreak":true},{"text":"murtii qajeelaa beekuu hin qabdanii?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ergasii isaan Waaqayyotti iyyatu;","poem":1},{"text":"inni garuu deebii hin kennuuf.","poem":2},{"text":"Yeroo sanatti inni sababii cubbuu","poem":1},{"text":"isaan hojjetaniitiif fuula isaa isaan duraa ni dhokfata.","poem":2}]},{"type":"verse","number":5,"content":["Waaqayyo akkana jedha:",{"text":"“Waaʼee raajota","poem":1},{"text":"saba koo karaa irraa jalʼisanii,","poem":2},{"text":"yoo namni tokko nyaata kenneef","poem":1},{"text":"isaan ‘Nagaa’ labsu;","poem":2},{"text":"yoo inni akkas gochuu baate immoo","poem":1},{"text":"lola isatti kaasuuf qophaaʼu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kanaafuu utuu isin mulʼata hin argin halkan,","poem":1},{"text":"utuu isin hooda hin dubbatin immoo dukkanni isinitti dhufa.","poem":2},{"text":"Aduun raajotatti dhiiti;","poem":1},{"text":"guyyaanis isaanitti dukkanaaʼa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ilaaltonni ni qaanaʼu;","poem":1},{"text":"warri hooda dubbatanis ni salphifamu.","poem":2},{"text":"Sababii deebiin tokko iyyuu Waaqa biraa hin dhufneef","poem":1},{"text":"isaan hundi fuula haguuggatu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ani garuu Yaaqoobitti balleessaa isaa,","poem":1},{"text":"Israaʼelittis cubbuu isaa himuuf","poem":2},{"lineBreak":true},{"text":"humnaan guutameera;","poem":2},{"text":"Hafuura Waaqayyootiin","poem":1},{"text":"murtii qajeelaa fi jabinaan guutameera.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isin hooggantoonni mana Yaaqoob","poem":1},{"text":"bulchitoonni mana Israaʼel","poem":2},{"text":"warri murtii qajeelaa tuffattanii","poem":1},{"text":"waan sirrii taʼe hunda jalʼiftan waan kana dhagaʼaa;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"warri dhiiga dhangalaasuudhaan Xiyoonin,","poem":1},{"text":"hamminaan immoo Yerusaalemin ijaartan waan kana dhagaʼaa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hooggantoonni ishee mattaʼaa fudhatanii murtii kennu;","poem":1},{"text":"luboonni ishee gatiidhaan barsiisu;","poem":2},{"lineBreak":true},{"text":"raajonni ishees maallaqa fudhatanii hooda dubbatu.","poem":2},{"text":"Taʼus isaan Waaqayyotti irkatanii,","poem":1},{"text":"“Waaqayyo gidduu keenya jira mitii?","poem":2},{"lineBreak":true},{"text":"Balaan tokko iyyuu nutti hin dhufu” jedhu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kanaafuu sababii keessaniif,","poem":1},{"text":"Xiyoon akkuma lafa qotiisaatti qotamti;","poem":2},{"text":"Yerusaalemis tuullaa waan diigamee taati;","poem":1},{"text":"gaarri mana qulqullummaas tabba daggalaan liqimfame taʼa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}