{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"MIC","translationId":"gaz_bib","name":"Miikiyaas","commonName":"Miikiyaas","title":"Raajii Miikiyaas","order":33,"numberOfChapters":7,"sha256":"b81c8b4e23958700833f10de7a2f6b4f00f4e6626c2fc4363e5eacc3ad5e05b9","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/gaz_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["Tulluu Waaqayyoo"]},{"type":"verse","number":1,"content":["Bara dhumaa keessa",{"text":"tulluun mana qulqullummaa Waaqayyoo","poem":1},{"text":"tulluuwwan hunda keessaa ol dheeratee dhaabata;","poem":2},{"text":"inni gaarran caalaa ol ol jedha;","poem":1},{"text":"namoonnis itti yaaʼu.","poem":2}]},{"type":"verse","number":2,"content":["Saboonni baayʼeen dhufanii akkana jedhu;",{"text":"“Kottaa gara tulluu Waaqayyoo,","poem":1},{"text":"gara mana Waaqa Yaaqoob ol baanaa.","poem":2},{"text":"Inni akka nu daandii isaa irra deemnuuf","poem":1},{"text":"karaa isaa nu barsiisa.”","poem":2},{"text":"Seerri Xiyoon keessaa,","poem":1},{"text":"dubbiin Waaqayyoo immoo Yerusaalem keessaa dhufa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inni namoota hedduu gidduutti murtii kennee","poem":1},{"text":"saboota jajjaboo gargar fagoo jiranis walitti araarsa.","poem":2},{"text":"Isaan goraadee isaanii tumanii maarashaa,","poem":1},{"text":"eeboo isaanii illee haamtuu tolfatu.","poem":2},{"text":"Sabni tokko saba biraatti goraadee hin luqqifatu","poem":1},{"text":"yookaan waraanaaf jedhanii siʼachi nama hin leenjisan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Namni hundi muka wayinii isaatii fi","poem":1},{"text":"muka harbuu isaa jala taaʼa;","poem":2},{"text":"Waaqayyoon Waan Hunda Dandaʼu dubbateeraatii","poem":1},{"text":"namni isaan sodaachisu tokko iyyuu hin jiru.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Saboonni hundinuu","poem":1},{"text":"maqaa waaqota isaaniitiin deddeebiʼu;","poem":2},{"text":"nu immoo bara baraa hamma bara baraatti","poem":1},{"text":"maqaa Waaqayyo Waaqa keenyaatiin deddeebina.","poem":2}]},{"type":"heading","content":["Karoora Waaqayyoo"]},{"type":"verse","number":6,"content":[{"text":"Waaqayyo akkana jedha;","poem":1},{"text":"“Ani bara sana naafa walittin qaba;","poem":2},{"text":"warra boojiʼamanii fi","poem":1},{"text":"warra ani gaddisiises walittin qaba.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ani warra naafa hambaa,","poem":1},{"text":"warra ariʼame immoo saba jabaa nan godha.","poem":2},{"text":"Waaqayyo guyyaa sanaa jalqabee","poem":1},{"text":"hamma bara baraatti Tulluu Xiyoon irratti bulchaa isaanii taʼa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yaa gamoo eegumsa bushaayee,","poem":1},{"text":"yaa daʼoo Intala Xiyoon,","poem":2},{"text":"ol aantummaan durii siif ni deebifama;","poem":1},{"text":"mootummaan Intala Yerusaalem ni dhufa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ati amma maaliif akkana iyyitee boossa?","poem":1},{"text":"Ati mootii hin qabduu?","poem":2},{"text":"Wanni ati akka dubartii ciniinsuun qabee miixattuuf","poem":1},{"text":"gorsaan kee badeetii?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yaa Intala Xiyoon,","poem":1},{"text":"akkuma dubartii ciniinsuun qabeetti aadi;","poem":2},{"text":"ati amma bakkee keessa qubachuuf","poem":1},{"text":"magaalaa keessaa baʼuu qabdaatii.","poem":2},{"text":"Ati Baabilon dhaqxa;","poem":1},{"text":"achitti ni baraaramta.","poem":2},{"text":"Waaqayyo achitti","poem":1},{"text":"harka diina keetii keessaa si fura.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Amma garuu saboonni hedduun si marsaniiru.","poem":1},{"text":"Isaanis, “Isheen haa xurooftu;","poem":2},{"text":"iji keenya xiyyeeffatee","poem":1},{"text":"Xiyoonin haa ilaalu!” jedhu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Isaan garuu yaada Waaqayyoo hin beekan;","poem":1},{"text":"isaan karoora isaa kan inni akkuma bissii","poem":2},{"lineBreak":true},{"text":"oobdiitti walitti qabe sana hin hubatan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Yaa Intala Xiyoon kaʼiitii midhaan dhaʼi;","poem":1},{"text":"ani gaanfa sibiilaa siif nan kennaatii;","poem":2},{"text":"ani kottee naasii siif nan kenna;","poem":1},{"text":"atis saboota baayʼee caccabsita.”","poem":2},{"text":"Ati horii isaan karaa hamaadhaan argatan Waaqayyoof kennita;","poem":1},{"text":"qabeenya isaaniis Gooftaa lafa hundaatiif kennita.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}