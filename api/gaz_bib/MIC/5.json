{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"MIC","translationId":"gaz_bib","name":"Miikiyaas","commonName":"Miikiyaas","title":"Raajii Miikiyaas","order":33,"numberOfChapters":7,"sha256":"b81c8b4e23958700833f10de7a2f6b4f00f4e6626c2fc4363e5eacc3ad5e05b9","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/gaz_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"heading","content":["Bulchaa Beetlihemii Dhufu"]},{"type":"verse","number":1,"content":[{"text":"Yaa magaalaa raayyaa waraanaa, raayyaa kee hiriirsi;","poem":1},{"text":"nu marfamneerraatii.","poem":2},{"text":"Isaan uleedhaan","poem":1},{"text":"maddii bulchaa Israaʼel dhaʼu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Garuu yaa Beetlihem Efraataa,","poem":1},{"text":"ati yoo balbala Yihuudaa keessaa xinnoo taate iyyuu,","poem":2},{"text":"kan bulchaa Israaʼel taʼu,","poem":1},{"text":"kan jiraachuun isaa durumaa,","poem":2},{"text":"kan bara duriitii jalqabee ture tokko","poem":1},{"text":"si keessaa baʼee naaf dhufa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kanaafuu Israaʼel","poem":1},{"text":"hamma isheen ciniinsifachaa jirtu deessee","poem":2},{"text":"obboloonni isaa warri hafan","poem":1},{"text":"Israaʼelootatti makamuuf deebiʼanitti kophaa hafti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Inni jabina Waaqayyootiin","poem":1},{"text":"surraa maqaa Waaqayyo, Waaqa isaatiin","poem":2},{"lineBreak":true},{"text":"dhaabatee bushaayee isaa tikfata.","poem":2},{"text":"Yeroo sanatti surraan isaa","poem":1},{"text":"waan daarii lafaa gaʼuuf isaan nagaadhaan jiraatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Inni nagaa keenya taʼa;","poem":1},{"text":"yeroo warri Asoor biyya keenya weeraranii","poem":2},{"lineBreak":true},{"text":"daʼannoo keenya keessa baʼanitti","poem":2},{"text":"nu tiksoota torbaa fi","poem":1},{"text":"ajajjuuwwan saddeet itti kakaasna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isaan biyya Asoor goraadeedhaan","poem":1},{"text":"biyya Naamruudis goraadee luqqifameen bulchu.","poem":2},{"text":"Yeroo warri Asoor biyya keenya weeraranii","poem":1},{"text":"daarii keenya keessa baʼanitti,","poem":2},{"lineBreak":true},{"text":"inni warra Asoor sana jalaa nu baasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hambaan Yaaqoob","poem":1},{"text":"namoota hedduu gidduutti","poem":2},{"text":"akkuma fixeensa Waaqayyo biraa dhufuu,","poem":1},{"text":"akkuma tiifuu marga irraa","poem":2},{"text":"kan nama hin eegnee","poem":1},{"text":"yookaan ilmaan namaa hin eeggannee taʼa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hambaan Yaaqoob saboota gidduutti,","poem":1},{"text":"uummata hedduu gidduuttis,","poem":2},{"text":"akkuma leenca bineensota bosonaa gidduu jiruu,","poem":1},{"text":"akkuma leenca saafela bushaayee gidduu jiru","poem":2},{"text":"kan irra ejjetee isaan cicciruutii fi","poem":1},{"text":"kan namni tokko iyyuu harkaa buusuu hin dandeenyee taʼa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Harki kee moʼannaadhaan diinota keetti kaʼa;","poem":1},{"text":"amajaajonni kee hundinuu ni barbadeeffamu.","poem":2}]},{"type":"verse","number":10,"content":["Waaqayyo akkana jedha;",{"text":"“Gaafas ani fardeen keessan gidduu keessanii nan balleessa;","poem":1},{"text":"gaariiwwan keessan kan waraanaas nan barbadeessa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ani magaalaawwan biyya keessanii nan barbadeessa;","poem":1},{"text":"daʼannoowwan keessan hundas nan diiga.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ani falfaltoota keessan nan balleessa;","poem":1},{"text":"isinis deebitanii hin mortan.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ani fakkiiwwan kee soofamoo fi utubaawwan waaqeffannaa keetii","poem":1},{"text":"gidduu keetii nan balleessa;","poem":2},{"text":"ati siʼachi gad jettee","poem":1},{"text":"hojii harka keetiitiif hin sagaddu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ani siidaa Aasheeraa gidduu keetii buqqisee","poem":1},{"text":"magaalaawwan kees nan barbadeessa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ani saboota naaf hin ajajamin irratti","poem":1},{"text":"aarii fi dheekkamsaan haaloo nan baʼa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}