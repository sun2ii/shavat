{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"MIC","translationId":"gaz_bib","name":"Miikiyaas","commonName":"Miikiyaas","title":"Raajii Miikiyaas","order":33,"numberOfChapters":7,"sha256":"b81c8b4e23958700833f10de7a2f6b4f00f4e6626c2fc4363e5eacc3ad5e05b9","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/gaz_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["Dhiphachuu Israaʼel"]},{"type":"verse","number":1,"content":[{"text":"Anaaf wayyoo!","poem":1},{"lineBreak":true},{"text":"Ani akkuma nama yeroo qarmii bonaa funaananitti","poem":1},{"text":"wayinii walitti qabu tokkoo taʼeera;","poem":2},{"text":"hurbuun wayinii kan nyaatamu tokko iyyuu hin jiru;","poem":1},{"text":"iji harbuu jalqabaa kan ani dharraʼu tokko iyyuu hin jiru.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Namni gaariin lafa irraa badeera;","poem":1},{"text":"namni qajeelaan tokko iyyuu hin hafne.","poem":2},{"text":"Namoonni hundinuu dhiigadhangalaasuuf riphanii eeggatu;","poem":1},{"text":"tokkoon tokkoon namaakiyyoodhaan obboleessa isaa eeggata.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Harki lachuu waan hamaa hojjechuu barateera;","poem":1},{"text":"bulchaan kennaa barbaada;","poem":2},{"text":"abbaan murtiis mattaʼaa fudhata;","poem":1},{"text":"namni humna qabu waanuma fedhe dubbata;","poem":2},{"lineBreak":true},{"text":"hundi isaanii walii wajjin malatu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kan isaan hunda caalaa gaarii taʼe akka sokorruu ti;","poem":1},{"text":"inni akka malee qajeelaan immoo dallaa qoraattii caala.","poem":2},{"text":"Guyyaan eegdota keetii,","poem":1},{"text":"guyyaan itti Waaqni si ilaalu dhufeera.","poem":2},{"lineBreak":true},{"text":"Amma yeroo itti isaan joonjaʼanii dha.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ollaa hin amanatin;","poem":1},{"text":"michuus hin abdatin.","poem":2},{"text":"Ishee hammattee ciiftu biratti iyyuu","poem":1},{"text":"arraba kee eeggadhu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ilmi abbaa isaa tuffata;","poem":1},{"text":"intalli haadha isheetti,","poem":2},{"text":"niitiin ilmaas amaatii isheetti kaati;","poem":1},{"text":"diinonni namaa miseensotuma mana isaa taʼuutii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ani garuu abdiidhaan Waaqayyoon nan eeggadha;","poem":1},{"text":"fayyisaa koo Waaqa nan eeggadha;","poem":2},{"lineBreak":true},{"text":"Waaqni koo na dhagaʼa.","poem":2}]},{"type":"heading","content":["Israaʼel ni Kaati"]},{"type":"verse","number":8,"content":[{"text":"Yaa diina koo natti hin gammadin!","poem":1},{"text":"Ani yoon kufe iyyuu nan kaʼa.","poem":2},{"text":"Ani dukkana keessa taaʼu iyyuu","poem":1},{"text":"Waaqayyo ifa naaf taʼa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ani sababiin cubbuu isatti hojjedheef,","poem":1},{"text":"hamma inni dubbii koo ilaalee naaf murteessutti","poem":2},{"lineBreak":true},{"text":"dheekkamsa Waaqayyoo nan baadha.","poem":2},{"text":"Inni ifatti na baasa;","poem":1},{"text":"anis qajeelummaa isaa nan arga.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ergasii diinni koo isheen,","poem":1},{"text":"“Waaqayyo Waaqni kee eessa jira?” naan jette sun","poem":2},{"lineBreak":true},{"text":"waan kana argitee qaaniin haguugamti.","poem":2},{"text":"Iji koo kufaatii ishee ni arga;","poem":1},{"text":"Isheen amma iyyuu miilla jalatti","poem":2},{"lineBreak":true},{"text":"akkuma dhoqqee daandii irraatti dhidhiitamti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Guyyaan itti dallaan kee ijaaramu,","poem":1},{"text":"guyyaan itti daangaan kee balʼifamu tokko ni dhufa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Gaafas namoonni","poem":1},{"text":"Asoorii fi magaalaawwan Gibxi,","poem":2},{"text":"Gibxii hamma Efraaxiisitti iyyuu,","poem":1},{"text":"galaanaa hamma galaanaatti,","poem":2},{"lineBreak":true},{"text":"tulluudhaa hamma tulluutti jiraatan gara kee ni dhufu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sababii jiraattota isheetii fi","poem":1},{"text":"sababii waan isaan hojjetaniitiif lafti ni onti.","poem":2}]},{"type":"heading","content":["Kadhannaa fi Galata"]},{"type":"verse","number":14,"content":[{"text":"Uummata kee, bushaayee dhaala keetii","poem":1},{"text":"kanneen ofumaan bosona keessa,","poem":2},{"text":"lafa dheedaa gabbataa irra jiraatan","poem":1},{"text":"ulee keetiin tikfadhu.","poem":2},{"text":"Isaan akkuma bara duriitti","poem":1},{"text":"Baashaanii fi Giliʼaad keessa haa bobbaʼan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Ani akkuma yeroo ati Gibxii baatee dhufte sanaa","poem":1},{"text":"dinqii koo isaan nan argisiisa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Saboonni arganii ni qaanaʼu;","poem":1},{"text":"humna ofii hunda iyyuu ni dhabu.","poem":2},{"text":"Isaan afaan isaanii qabatu;","poem":1},{"text":"gurri isaaniis ni duuda.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Isaan akkuma bofaa,","poem":1},{"text":"akkuma uumamawwan lafa irra looʼanii biyyoo arraabu.","poem":2},{"text":"Isaan hollachaa holqa keessaa baʼanii dhufu;","poem":1},{"text":"Isaan Waaqayyo Waaqa keenya sodaachuudhaan","poem":2},{"lineBreak":true},{"text":"deebiʼanii fuula kee dura sodaadhaan dhaabatu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Waaqni akka keetii kan cubbuu namaa bira darbee","poem":1},{"text":"balleessaa hambaa dhaala isaa dhiisuuf eenyu?","poem":2},{"text":"Ati araara gochuutti gammadda malee","poem":1},{"text":"bara baraan hin dheekkamtu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ati deebitee garaa nuu laafta;","poem":1},{"text":"cubbuu keenya miilla kee jalatti dhidhiittee","poem":2},{"lineBreak":true},{"text":"balleessaa keenya hundas tuujuba galaanaattigad darbatta.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ati akkuma bara durii","poem":1},{"text":"abbootii keenyaaf kakatte sana","poem":2},{"text":"Yaaqoobiif amanamaa taata;","poem":1},{"text":"Abrahaamittis jaalala ni argisiifta.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}