{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"NAM","translationId":"gaz_bib","name":"Naahoom","commonName":"Naahoom","title":"Raajii Naahoom","order":34,"numberOfChapters":3,"sha256":"c7a630505ed8057aee980a9be567e297ecc0dbf405a96537e7bd0f089302d499","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gaz_bib/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["Kufaatii Nanawwee"]},{"type":"verse","number":1,"content":[{"text":"Yaa Nanawwee, namni si lolu sitti dhufeera.","poem":1},{"text":"Daʼoo eeggadhu;","poem":2},{"lineBreak":true},{"text":"karaa ilaalladhu.","poem":2},{"lineBreak":true},{"text":"Mudhii kee hidhadhu;","poem":2},{"lineBreak":true},{"text":"humna kee hunda walitti qabadhu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yoo balleessitoonni isaan onsanii","poem":1},{"text":"mukkeen wayinii isaanii barbadeessan iyyuu,","poem":2},{"text":"Waaqayyo akkuma ulfina Israaʼel deebise sana","poem":1},{"text":"ulfina Yaaqoobis iddootti ni deebisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gaachanawwan loltoota isaa diddiimoo dha;","poem":1},{"text":"gootonnis uffata bildiimaa uffataniiru.","poem":2},{"text":"Guyyaa isaan itti qopheeffaman sana,","poem":1},{"text":"sibiilli gaarii lolaa irra jiru ni calaqqisa;","poem":2},{"lineBreak":true},{"text":"eeboon gaattiraa isaaniis ni mirmirfama.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gaariiwwan lolaa karaa irra dadarbatamu;","poem":1},{"text":"oobdiiwwan keessas asii fi achi gulufu.","poem":2},{"text":"Isaan guca bobaʼu fakkaatu;","poem":1},{"text":"akkuma bakakkaas ni darbatamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Inni gootota isaa ni yaadata;","poem":1},{"text":"isaan garuu karaatti gufatu.","poem":2},{"text":"Isaan gara dallaa magaalattiitti ariifatu;","poem":1},{"text":"daʼoonis qopheeffameefii jira.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Balballi lageenii banamaa dha;","poem":1},{"text":"masaraan mootummaas ni jiga.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Magaalattiin qullaatti hambaa","poem":1},{"text":"akka boojiʼamtu murteeffameera.","poem":2},{"text":"Xomboreewwan ishee","poem":1},{"text":"qoma isaanii rurrukutanii akka gugee booʼu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nanawween akkuma haroo ti;","poem":1},{"text":"bishaan ishees keessaa yaaʼee dhuma.","poem":2},{"text":"Isaanis, “Dhaabadhaa! Dhaabadhaa!” jedhanii iyyu;","poem":1},{"text":"garuu namni tokko iyyuu dugda duubatti hin deebiʼu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Meetii saamaa!","poem":1},{"text":"Warqee saamaa!","poem":2},{"text":"Maddi ishee, badhaadhummaan","poem":1},{"text":"kuusaa qabeenya ishee hundaas dhuma hin qabu!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Isheen duwwaa, qullaa fi ona taateerti!","poem":1},{"text":"Lapheen baqeera; jilbi laafeera;","poem":2},{"lineBreak":true},{"text":"dhagni hollateera; fuulli hundis gurraachaʼeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Holqi leencotaa,","poem":1},{"text":"iddoon isaan itti ilmaan isaanii sooran,","poem":2},{"text":"iddoon leenci kormaa fi dhalaan keessa yaaʼan,","poem":1},{"text":"saafelli isaanis sodaa malee nagaadhaan jiraatan eessa?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Leenci waan ilmaan isaatiif gaʼu ajjeefate;","poem":1},{"text":"leenca dhalaa isaatiifis waa hudhee ajjeese;","poem":2},{"text":"boolla isaa waan adamseen,","poem":1},{"text":"holqa isaa immoo gumaa fooniitiin guuttate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Waaqayyo Waan Hunda Dandaʼu akkana jedha;","poem":1},{"text":"“Ani sitti kaʼeera;","poem":2},{"text":"ani gaariiwwan kee kanneen waraanaa gubee daaraa nan godha;","poem":1},{"text":"goraadeen leenca kee saafela ni fixa.","poem":2},{"text":"Ani waan ati adamsattu tokko illee","poem":1},{"text":"lafa irratti siif hin hambisu.","poem":2},{"text":"Sagaleen ergamoota keetii","poem":1},{"text":"lammata hin dhagaʼamu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}