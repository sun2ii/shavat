{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"NAM","translationId":"gaz_bib","name":"Naahoom","commonName":"Naahoom","title":"Raajii Naahoom","order":34,"numberOfChapters":3,"sha256":"c7a630505ed8057aee980a9be567e297ecc0dbf405a96537e7bd0f089302d499","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gaz_bib/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"heading","content":["Nanawweef Wayyoo"]},{"type":"verse","number":1,"content":[{"text":"Magaalattii dhiigaatiif,","poem":1},{"text":"kan sobaan guutamteef,","poem":2},{"text":"kan saamichaan guutamteef,","poem":1},{"text":"kan warri hammina hojjetan keessaahin dhabamne sanaaf wayyoo!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iyyi qaccee,","poem":1},{"text":"kakaksuun gommaa,","poem":2},{"text":"gulufuun fardaa,","poem":1},{"text":"didichuun gaarii lolaa ni dhagaʼama!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abbaan fardaa ni gulufa;","poem":1},{"text":"goraadeen ni balaqqisa;","poem":2},{"lineBreak":true},{"text":"eeboon ni calaqqisa!","poem":2},{"text":"Balaan hedduun nama irra gaʼeera;","poem":1},{"text":"namni baayʼeen duʼeera;","poem":2},{"text":"reeffi lakkoobsa hin qabu;","poem":1},{"text":"namoonnis reeffa isaaniitti gufatu;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"kun hundi sababii baayʼina sagaagalummaa sagaagaltuu,","poem":1},{"text":"giiftii falfaltootaa,","poem":2},{"text":"kan sagaagaltummaa isheetiin saboota,","poem":1},{"text":"tolcha isheetiin immoo uummata garboomsite sanaatiin taʼe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Waaqayyo Waan Hunda Dandaʼu akkana jedha:","poem":1},{"text":"“Ani sitti kaʼeen jira.","poem":2},{"lineBreak":true},{"text":"Ani uffata kee fuula keetti ol soqola.","poem":2},{"text":"Ani sabootatti qullaa kee,","poem":1},{"text":"mootummootatti immoo qaanii kee nan mulʼisa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani xuriidhaan sin faala;","poem":1},{"text":"akka malee sin tuffadha;","poem":2},{"lineBreak":true},{"text":"waan kolfaa illee sin godha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Namni si argu hundi sirraa baqatee,","poem":1},{"text":"‘Nanawween baduutti jirti; eenyutu booʼaaf?’ siin jedha.","poem":2},{"lineBreak":true},{"text":"Ani nama si jajjabeessu tokko illee eessaa argadha?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ati, Nooʼi Amoon","poem":1},{"text":"biyya laga Abbayyaa irraa","poem":2},{"lineBreak":true},{"text":"kan bishaaniin marfamte sana caaltaa?","poem":2},{"text":"Lagni daʼoo ishee ti;","poem":1},{"text":"bishaanis dallaa ishee ti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Itoophiyaa fi Gibxi jabina ishee kan dhuma hin qabnee dha;","poem":1},{"text":"Fuuxii fi Liibiyaan tumsitoota ishee ti.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Taʼus isheen boojiʼamtee","poem":1},{"text":"biyya ormaatti geeffamte.","poem":2},{"text":"Daaʼimman ishee mataa daandii hundaa irratti","poem":1},{"text":"miciriqfamanii dhuman.","poem":2},{"text":"Namoota ishee ulfaatootti ixaa buufatanii","poem":1},{"text":"namoonni ishee gurguddoonni hundinuufoncaadhaan hidhaman.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Atis ni machoofta; ni dhokattas;","poem":1},{"text":"diina jalaa baʼuufis daʼoo barbaaddatta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Daʼoon kee hundi mukkeen harbuu","poem":1},{"text":"kanneen ija jalqabatti bilchaate qaban fakkaata;","poem":2},{"text":"yeroo mukkeen sun hurgufamanitti","poem":1},{"text":"iji isaanii afaan nama waa nyaatuu keessa buʼa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mee raayyaawwan kee ilaali;","poem":1},{"text":"isaan hundinuu dubartoota!","poem":2},{"text":"Karrawwan biyya keetii diinota keetiif","poem":1},{"text":"balʼatanii banamanii jiru;","poem":2},{"lineBreak":true},{"text":"ibiddis danqaraa isaanii gubee fixeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Utuu hin marfamin bishaan waraabbadhu;","poem":1},{"text":"humna hittisaa kee jajjabeeffadhu!","poem":2},{"text":"Suphee tolfadhu;","poem":1},{"text":"dhoqqee suphee dhiittadhu;","poem":2},{"lineBreak":true},{"text":"xuubii tolfadhu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Achitti ibiddi si fixa;","poem":1},{"text":"goraadeenis si cicciree","poem":2},{"lineBreak":true},{"text":"akkuma korophisaas si barbadeessa.","poem":2},{"text":"Akka korophisaa hori;","poem":1},{"text":"akkuma hawwaannisaa baayʼadhu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ati hamma isaan urjii samii caalaa","poem":1},{"text":"baayʼatanitti daldaltoota kee baayʼifatteerta;","poem":2},{"text":"isaan garuu akkuma hawwaannisaa biyyatii qullaa hambisanii","poem":1},{"text":"ergasii barrisanii deemu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Eegdonni kee akkuma hawwaannisaa ti;","poem":1},{"text":"qondaaltonni kees akkuma tuuta hawwaannisaa","poem":2},{"lineBreak":true},{"text":"kan guyyaa qabbanaa dallaa irra qubatuu ti;","poem":2},{"text":"yeroo aduun baatu garuu barrisanii badu;","poem":1},{"text":"namni tokko iyyuu gara isaan dhaqan hin beeku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Yaa mootii Asoor tiksoonni kee ni mugu;","poem":1},{"text":"namoonni kee ulfaatoon boqochuuf gad ciciisaniiru.","poem":2},{"text":"Namoonni kee nama walitti isaan qabu dhabanii","poem":1},{"text":"tulluuwwan irratti bibittinnaaʼaniiru.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wanni tokko iyyuu madaa kee fayyisuu hin dandaʼu;","poem":1},{"text":"miidhamni kees kan duʼaan si gaʼuu dha.","poem":2},{"text":"Namni oduu waaʼee keetii dhagaʼu hundinuu","poem":1},{"text":"kufaatii keetti harka walitti rurrukuta;","poem":2},{"text":"gara jabina kee kan dhuma hin qabne sanaan","poem":1},{"text":"eenyutu hin miidhamin?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}