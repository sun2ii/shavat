{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"OBA","translationId":"gaz_bib","name":"Obaadiyaa","commonName":"Obaadiyaa","title":"Raajii Obaadiyaa","order":31,"numberOfChapters":1,"sha256":"12a68cd1e3819a2afd316353a82a17395d5552ee09a2315f16932b0ac01b7860","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/OBA/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/gaz_bib/OBA/1.json","totalNumberOfVerses":21},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Mulʼata Obaadiyaa. 1‑4 kwf – Erm 49:14‑16 5‑6 kwf – Erm 49:9‑10 Waaqayyo Gooftaan waaʼee Edoom akkana jedha.",{"lineBreak":true},{"lineBreak":true},{"text":"Nu ergaa tokko Waaqayyo irraa dhageenyeerra:","poem":1},{"text":"Ergamaan tokko, “Kaʼaa dhaqnee ishee lollaa;","poem":2},{"text":"waraanaafis baʼaa” jechuuf gara sabootaatti ergame.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Kunoo, ani saboota gidduutti sin xinneessa;","poem":1},{"text":"atis akka malee tuffatamta.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ati kan baqaqaa kattaa keessa jiraattee","poem":1},{"text":"mana kee lafa ol kaʼaa irratti ijaarrattu,","poem":2},{"text":"kan, ‘Eenyutu lafatti gad na buusa?’ ofiin jettu,","poem":1},{"text":"of tuulummaan garaa keetii si gowwoomseera.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yoo ati akkuma risaa ol fagaattee","poem":1},{"text":"urjiiwwan gidduutti manʼee kee ijaarratte iyyuu,","poem":2},{"lineBreak":true},{"text":"ani achii gad sin buusa”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Hattuun yoo sitti dhuftee","poem":1},{"text":"saamtuun halkaniin sitti seente,","poem":2},{"text":"balaa akkamiitu si eeggata!","poem":1},{"text":"Isaan hammuma barbaadan qofa fudhatanii hin deemanii?","poem":2},{"text":"Warri ija wayinii guuran utuu gara kee dhufanii,","poem":1},{"text":"silaa qarmii wayii hin dhiisanii?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Esaawu garuu akkam saamamee","poem":1},{"text":"qabeenyi isaa dhokfamaanis jalaa guurame!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gareen kee hundinuu gara moggaatti si dhiiba;","poem":1},{"text":"michoonni kee si gowwoomsanii si moʼatu;","poem":2},{"text":"warri buddeena kee nyaatan kiyyoo si dura kaaʼu;","poem":1},{"text":"ati garuu waan kana hin hubattu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Ani bara sana ogeeyyii Edoom,","poem":1},{"text":"namoota hubannaa qaban tulluuwwan Esaaw irraa","poem":2},{"lineBreak":true},{"text":"hin balleessuu?” jedha Waaqayyo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Yaa Teemaan qabsaaʼonni kee ni rifatu;","poem":1},{"text":"namni tulluuwwan Esaawuu irra","poem":2},{"lineBreak":true},{"text":"jiraatu hundinuus gorraʼamee dhuma.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sababii daba obboleessa kee Yaaqoobitti hojjetameetiif","poem":1},{"text":"ati qaaniidhaan haguugamta;","poem":2},{"lineBreak":true},{"text":"bara baraanis ni balleeffamta.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gaafa alagoonni qabeenya isaa","poem":1},{"text":"guurratanii namoonni ormaa immoo karra isaa seenanii","poem":2},{"text":"Yerusaalemitti ixaa buufatanitti,","poem":1},{"text":"atis kophaa dhaabattee","poem":2},{"lineBreak":true},{"text":"isaan keessaa akka isa tokkoo taate.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Gaafa inni milkii dhabetti","poem":1},{"text":"ati obboleessa kee tuffachuu hin qabdu turte;","poem":2},{"text":"yookaan guyyaa badii isaaniitti","poem":1},{"text":"saba Yihuudaatti gammaduu hin qabdu turte;","poem":2},{"text":"yookaan bara rakkina isaanii keessa","poem":1},{"text":"akka malee of tuuluu hin qabdu turte.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bara balaan isaanitti dhufe keessa","poem":1},{"text":"karra saba kootiin ol seenuu hin qabdu turte;","poem":2},{"text":"yookaan bara dhaʼichi isaanitti dhufe keessa","poem":1},{"text":"rakkina isaanii keessatti isaan tuffachuu hin qabdu turte;","poem":2},{"text":"yookaan bara balaan isaanitti dhufe keessa","poem":1},{"text":"qabeenya isaanii saamuu hin qabdu turte.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Baqattoota isaa fixuuf jettee qaxxaamura karaatti","poem":1},{"text":"isaan eeggachuu hin qabdu turte;","poem":2},{"text":"yookaan bara rakkina isaa keessa","poem":1},{"text":"hambaa isaa dabarsitee kennuu hin qabdu turte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Guyyaan Waaqayyoo","poem":1},{"text":"saboota hundaaf dhiʼaateera.","poem":2},{"text":"Akkuma ati hojjette sittis ni hojjetama;","poem":1},{"text":"hojiin kees matuma keetti deebiʼa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Akkuma isin gaara koo qulqulluu irratti dhugdan sana,","poem":1},{"text":"saboonni hundinuu ittuma fufanii ni dhugu;","poem":2},{"text":"isaan itti deddeebiʼanii dhugu;","poem":1},{"text":"akka waan gonkumaa hin dhuginii taʼu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tulluu Xiyoon irra garuu furamuun ni jiraata;","poem":1},{"text":"inni ni qulqullaaʼa;","poem":2},{"lineBreak":true},{"text":"manni Yaaqoobis dhaala isaanii ni dhuunfatu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Manni Yaaqoob ibidda,","poem":1},{"text":"manni Yoosef immoo arraba ibiddaa taʼa;","poem":2},{"text":"manni Esaaw huura taʼa;","poem":1},{"text":"isaanis ibidda itti qabsiisanii gubanii barbadeessu.","poem":2},{"text":"Mana Esaaw keessaa","poem":1},{"text":"namni tokko iyyuu hin hafu”","poem":2},{"text":"jedhee dubbateera Waaqayyo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Namoonni Negeeb","poem":1},{"text":"tulluuwwan Esaaw ni qabatu;","poem":2},{"text":"namoonni gaarran jala jiraatan immoo","poem":1},{"text":"biyya Filisxeemotaa qabatu.","poem":2},{"text":"Isaan dirree Efreemii fi Samaariyaa ni qabatu;","poem":1},{"text":"Beniyaam immoo biyya Giliʼaad qabata.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Gareen boojiʼamtoota Israaʼel kan Kanaʼaan jiraatu kun","poem":1},{"text":"biyya hamma Saaraptaatti jiru dhaala;","poem":2},{"text":"boojiʼamtoonni Yerusaalem kanneen","poem":1},{"text":"Sefaaraad jiraatan magaalaawwan Negeeb dhaalu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bilisa baastonni tulluuwwan Esaaw bulchuudhaaf","poem":1},{"text":"Tulluu Xiyoonitti ol baʼu.","poem":2},{"lineBreak":true},{"text":"Mootummaanis kan Waaqayyoo taʼa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/OBA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/JON/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/AMO/9.json","previousChapterAudioLinks":{},"numberOfVerses":21}