{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_bib","name":"Fakkeenya","commonName":"Fakkeenya","title":"Kitaaba Fakkeenyaa","order":20,"numberOfChapters":31,"sha256":"6a14377732a652e517d36204bb73165c2fad3eb07c1f6079e5a808e3790538f1","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":2,"content":[{"type":"heading","content":["Badhaasa Ogummaa"]},{"type":"verse","number":1,"content":[{"text":"Yaa ilma ko, yoo ati dubbii koo fudhattee","poem":1},{"text":"ajaja koos of keessatti kuufatte,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"yoo ati gurra kee ogummaatti garagalfattee","poem":1},{"text":"yaada kee hubannaatti deebifatte,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"yoo ati jabaattee qalbeeffannaa barbaaddee","poem":1},{"text":"hubannaa argachuuf jettee iyyitee kadhatte,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"yoo ati akkuma meetiitti isa barbaaddattee","poem":1},{"text":"akkuma qabeenya dhokfameetti isa barbaadde,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ati Waaqayyoon sodaachuu ni hubatta;","poem":1},{"text":"Waaqa beekuus ni argatta.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Waaqayyo ogummaa namaa kennaatii;","poem":1},{"text":"afaan isaa keessaa illee beekumsaa fi hubannaatu baʼa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni qajeeltotaaf ogummaa dhugaa kuusa;","poem":1},{"text":"warra adeemsi isaanii mudaa hin qabneef gaachana;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"inni daandii tolootaa ni eega;","poem":1},{"text":"karaa qulqulloota isaa illee ni tiksa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ergasii ati qajeelummaa fi murtii qajeelaa,","poem":1},{"text":"nama wal qixxeessuu, karaa qajeelaa hundas ni hubatta.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ogummaan garaa kee seena;","poem":1},{"text":"beekumsis lubbuu kee gammachiisa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Qalbeeffannaan si eega;","poem":1},{"text":"hubannaanis si tiksa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ogummaan karaa hamootaa irraa,","poem":1},{"text":"namoota daba dubbatan jalaas si baraara;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"warra karaa dukkanaa irra deemuudhaaf jedhanii","poem":1},{"text":"daandii qajeelaa dhiisan,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"warra waan hamaa hojjechuutti gammadan,","poem":1},{"text":"warra jalʼina hojjechuun itti tolu,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"warra daandiin isaanii jalʼate,","poem":1},{"text":"warra karaan isaanii dabe jalaa si baraara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ogummaatu dubartii ganda labee,","poem":1},{"text":"niitii dubbiidhaan sossobdee ofitti nama harkiftu jalaa si baraara;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"niitii dhirsa ishee kan jalqabaa dhiiftee","poem":1},{"text":"kakuu fuula Waaqaa duratti galte sana dagatte jalaa si baraara.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Manni ishee gara duʼaatti, karaan ishee immoo","poem":1},{"text":"gara hafuurota warra duʼaniitti nama geessaatii.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Namni gara ishee dhaqu tokko iyyuu hin deebiʼu","poem":1},{"text":"yookaan karaa jireenyaa hin argatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kanaafuu ati karaa namoota gaggaarii irra ni deemta;","poem":1},{"text":"daandii qajeeltotaa irraas hin jalʼattu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Toloonni biyyattii keessa ni jiraatuutii;","poem":1},{"text":"warri mudaa hin qabnes achi keessa jiraatu;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"hamoonni garuu biyyattii keessaa ni balleeffamu;","poem":1},{"text":"warri hin amanamnes ishee keessaa buqqifamu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}