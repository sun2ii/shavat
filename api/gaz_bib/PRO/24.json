{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_bib","name":"Fakkeenya","commonName":"Fakkeenya","title":"Kitaaba Fakkeenyaa","order":20,"numberOfChapters":31,"sha256":"6a14377732a652e517d36204bb73165c2fad3eb07c1f6079e5a808e3790538f1","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":24,"content":[{"type":"heading","content":["Jecha digdammaffaa"]},{"type":"verse","number":1,"content":[{"text":"Hamootatti hin hinaafin;","poem":1},{"text":"garee isaanii taʼuus hin hawwin;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"garaan isaanii hammina malataatii;","poem":1},{"text":"hidhiin isaaniis rakkina odeessa.","poem":2}]},{"type":"heading","content":["Jecha digdamii tokkoffaa"]},{"type":"verse","number":3,"content":[{"text":"Manni ogummaadhaan ijaarama;","poem":1},{"text":"hubannaadhaanis jabeeffamee dhaabama;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"kutaawwan isaas, beekumsaan, qabeenya gatii guddaatii fi","poem":1},{"text":"miidhagaadhaan guutamu.","poem":2}]},{"type":"heading","content":["Jecha digdamii lammaffaa"]},{"type":"verse","number":5,"content":[{"text":"Ogeessi humna guddaa qaba;","poem":1},{"text":"beekaan namaa immoo jabina itti dabalata;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"waraana banuuf qajeelfama,","poem":1},{"text":"moʼannaa argachuudhaaf immoo gorsitoota hedduu si barbaachisa.","poem":2}]},{"type":"heading","content":["Jecha digdamii sadaffaa"]},{"type":"verse","number":7,"content":[{"text":"Gowwaa irraa ogummaan akka malee ol fagoo dha;","poem":1},{"text":"inni karra duratti afaan isaa hin saaqqatu.","poem":2}]},{"type":"heading","content":["Jecha digdamii afraffaa"]},{"type":"verse","number":8,"content":[{"text":"Namni hammina malu,","poem":1},{"text":"“Maltee” jedhama.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Malli gowwummaa cubbuu dha;","poem":1},{"text":"namoonnis qoostuu ni balfu.","poem":2}]},{"type":"heading","content":["Jecha digdamii shanaffaa"]},{"type":"verse","number":10,"content":[{"text":"Ati yoo gaafa rakkinaa laafte,","poem":1},{"text":"jabinni kee dhugumaanuu xinnaa dha!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Warra gara duʼaatti geeffamaa jiran duʼa jalaa baasi;","poem":1},{"text":"warra ajjeefamuuf qopheeffamanis oolchi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yoo ati, “Nu waan kana homaa hin beekne” jette,","poem":1},{"text":"inni yaada namaa madaalu sun hin hubatuu?","poem":2},{"text":"Kan lubbuu kee eegu sun waan kana hin beekuu?","poem":1},{"text":"Inni nama hundaaf akkuma hojii isaatti gatii hin kennuu?","poem":2}]},{"type":"heading","content":["Jecha digdamii jaʼaffaa"]},{"type":"verse","number":13,"content":[{"text":"Yaa ilma ko, dammi waan gaarii taʼeef nyaadhu;","poem":1},{"text":"nadhiin dammaa sitti ni miʼaawa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Akka ogummaan lubbuu keetti miʼaawu illee beeki;","poem":1},{"text":"ati yoo isa argatte fuul duratti abdii qabda;","poem":2},{"lineBreak":true},{"text":"abdiin kees hin citu.","poem":2}]},{"type":"heading","content":["Jecha digdamii torbaffaa"]},{"type":"verse","number":15,"content":[{"text":"Akka nama seeraan hin bulleetti mana nama qajeelaariphxee hin eeggatin;","poem":1},{"text":"mana jireenya isaas hin saamin.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Namni qajeelaan yeroo torba kufu iyyuu, deebiʼee ni kaʼaatii;","poem":1},{"text":"namni hamaan garuu yeroo balaan itti dhufutti ni gufata.","poem":2}]},{"type":"heading","content":["Jecha digdamii saddeettaffaa"]},{"type":"verse","number":17,"content":[{"text":"Yeroo diinni kee kufutti hin ililchin;","poem":1},{"text":"yeroo inni gufatuttis garaan kee hin gammadin;","poem":2}]},{"type":"verse","number":18,"content":[{"text":"yoo kanaa achii Waaqayyo waan kanatti ni gaddaatii;","poem":1},{"text":"dheekkamsa isaas isa irraa deebisa.","poem":2}]},{"type":"heading","content":["Jecha digdamii saglaffaa"]},{"type":"verse","number":19,"content":[{"text":"Ati sababii jalʼootaatiif aariidhaan hin gubatin;","poem":1},{"text":"hamootattis hin hinaafin.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Namni jalʼaan fuul duratti abdii hin qabuutii;","poem":1},{"text":"ibsaan hamootaas ni dhaama.","poem":2}]},{"type":"heading","content":["Jecha soddommaffaa"]},{"type":"verse","number":21,"content":[{"text":"Yaa ilma ko, Waaqayyoo fi mootii sodaadhu;","poem":1},{"text":"finciltootattis hin makamin;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"badiisni akkuma tasaa isaanitti dhufaatii;","poem":1},{"text":"balaa isaan lachuu fidan eenyutu beeka?","poem":2}]},{"type":"verse","number":23,"content":["Kunneenis jechoota ogeessaa ti:",{"text":"Murtii kennuu irratti nama wal caalchisuun gaarii miti:","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Kan nama yakka qabuun, “Ati balleessaa hin qabdu”","poem":1},{"text":"jedhu kam iyyuu namni isa abaara; sabnis isa balaaleffata.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Warri nama yakka hojjetu ifatan garuu ni gammadu;","poem":1},{"text":"eebbi guddaanis ni dhufaaf.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Deebiin qajeelaan,","poem":1},{"text":"akkuma hidhii dhungachuu ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Hojii kee kan diidaa raawwadhuutii","poem":1},{"text":"lafa qotiisaa kees qopheeffadhu;","poem":2},{"lineBreak":true},{"text":"ergasii mana kee ijaarradhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Sababii tokko malee ollaa keetti dhugaa hin baʼin","poem":1},{"text":"yookaan hidhii keetiin hin gowwoomsin.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ati, “Waanuma inni na godhe anis isa nan godha;","poem":1},{"text":"waan inni hojjeteefis gatii isaa nan deebisa” hin jedhin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Ani lafa qotiisaa nama dhibaaʼaa keessa baʼee,","poem":1},{"text":"iddoo dhaabaa wayinii nama qalbii hin qabnee keessas darbe;","poem":2}]},{"type":"verse","number":31,"content":[{"text":"qoraattiin lafa hunda guuteera;","poem":1},{"text":"laftis aramaadhaan fudhatameera;","poem":2},{"lineBreak":true},{"text":"dallaan dhagaas diigameera.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ani argeen waan sana qalbeeffadhe;","poem":1},{"text":"waanan arge sana irraas barumsa nan argadhe:","poem":2}]},{"type":"verse","number":33,"content":[{"text":"hirriba xinnaa; mugaatii xinnaa;","poem":1},{"text":"xinnoo harka walitti marachuu;","poem":2}]},{"type":"verse","number":34,"content":[{"text":"hiyyummaanis akkuma hattuutti,","poem":1},{"text":"deegummaanis akkuma loltuu hidhateetti sitti dhufa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}