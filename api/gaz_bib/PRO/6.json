{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_bib","name":"Fakkeenya","commonName":"Fakkeenya","title":"Kitaaba Fakkeenyaa","order":20,"numberOfChapters":31,"sha256":"6a14377732a652e517d36204bb73165c2fad3eb07c1f6079e5a808e3790538f1","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":6,"content":[{"type":"heading","content":["Akeekkachiisa Waaʼee Gowwummaa Irratti Kenname"]},{"type":"verse","number":1,"content":[{"text":"Yaa ilma ko, ati yoo ollaa keetiif wabii taatee","poem":1},{"text":"harka dhooftee nama ormaatiif kakatte,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"yoo waanuma dubbatteen qabamtee","poem":1},{"text":"dubbuma afaan keetiitiin kiyyoo seente,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"yoos yaa ilma ko,ati sababii harka ollaa keetii seentee jirtuuf","poem":1},{"text":"ati of baasuudhaaf","poem":2},{"text":"dafii dhaqiitii gad of qabii","poem":1},{"text":"jabeessiitii ollaa kee kadhadhu!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ija keetiif hirriba,","poem":1},{"text":"baallee ija keetiitiif immoo mugaatii hin eeyyamin.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ati akkuma kuruphee harka adamsituutii baatuutti,","poem":1},{"text":"akkuma simbirroo kiyyoo nama ishee qabuu jalaa baatuutti of oolchi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yaa dhibaaʼaa nana mee gara goondaa dhaqi;","poem":1},{"text":"karaa ishee qalbeeffadhuutii ogeessa taʼi!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni ajajaa hin qabu;","poem":1},{"text":"toʼataa yookaan bulchaa hin qabu;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"taʼu illee inni bona keessa nyaata isaa kuufata;","poem":1},{"text":"yeroo midhaan galfamutti immoo nyaata isaa walitti qabata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yaa dhibaaʼaa nana, ati hamma yoomiitti ciifta?","poem":1},{"text":"Ati yoomi hirriba keetii kaata?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hirriba xinnaa, mugaatii xinnaa,","poem":1},{"text":"xinnoo harka walitti marachuu,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"hiyyummaanis akkuma hattuutti sitti dhufa;","poem":1},{"text":"deegummaanis akkuma loltuu hidhateetti sitti dhufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Namni rakkisaan, namni hamaan,","poem":1},{"text":"dubbii sobaatiin asii fi achi naannaʼa;","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"inni ijaan dhaʼa;","poem":2},{"lineBreak":true},{"text":"miilla isaatiinis mallattoo kenna;","poem":2},{"lineBreak":true},{"text":"quba isaatiin argisiisa;","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"inni garaa isaa isa sobaadhaan hammina yaada;","poem":2},{"lineBreak":true},{"text":"yeroo hundas lola kakaasa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kanaafuu badiisni yommusuma isatti dhufa;","poem":1},{"text":"inni akkuma tasaa caba; deebiʼees hin fayyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":["Waaqayyo waan jaʼa jibba; waan torba immoo ni xireeffata; isaanis:"]},{"type":"verse","number":17,"content":["Ija of tuulu, arraba sobu, harka dhiiga nama balleessaa hin qabnee dhangalaasu,"]},{"type":"verse","number":18,"content":["garaa mala hamaa malu, miilla gara jalʼinaatti ariifatu,"]},{"type":"verse","number":19,"content":["dhuga baatuu sobaa kan soba dhangalaasu, nama obboloota gidduutti lola kakaasuu dha."]},{"type":"heading","content":["Akeekkachiisa Waaʼee Ejjaa Irratti Kenname"]},{"type":"verse","number":20,"content":[{"text":"Yaa ilma ko, ajaja abbaa keetii eegi;","poem":1},{"text":"barsiisa haadha keetii illee hin gatin.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bara baraan garaa keetti qabadhu;","poem":1},{"text":"morma keettis hidhadhu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yeroo ati deemtu isaan si qajeelchu;","poem":1},{"text":"yeroo ati raftu si eegu;","poem":2},{"lineBreak":true},{"text":"yeroo ati hirribaa kaatu illee si haasofsiisu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ajajni kun ibsaadhaatii;","poem":1},{"text":"barsiisni kunis ifa;","poem":2},{"lineBreak":true},{"text":"sirreeffamni amalaa immoo karaa jireenyaa ti;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"isaan dubartii hamtuu irraa,","poem":1},{"text":"niitii kashlabbee afaan dammaa irraa si eegu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Garaa kee keessatti bareedina ishee hin dharraʼin;","poem":1},{"text":"yookaan akka isheen ija isheetiin si boojitu hin godhin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Sagaagaltuun buddeena tokkoon bitamtiitii;","poem":1},{"text":"ejjituunis jireenyuma kee adamsiti.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Namni bobaa jalatti ibidda baadhatee","poem":1},{"text":"wayyaan isaa hin gubanne jiraa?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Namni ibidda cilee irra ejjetee","poem":1},{"text":"miilli isaa hin gubanne jiraa?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Namni niitii nama biraa wajjin ciisus akkasuma taʼa;","poem":1},{"text":"namni ishee tuqu kam iyyuu utuu hin adabamin hin hafu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Yoo hattuun tokko beela baʼuuf jedhee hate,","poem":1},{"text":"namoonni hin tuffatan.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Garuu inni yoo qabame dachaa torba baasa;","poem":1},{"text":"miʼa mana isaa hundas ni kenna.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Namni sagaagalu qalbii hin qabu;","poem":1},{"text":"namni waan akkasii hojjetu ofuma galaafata.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Qoodni isaa dhaanamuu fi salphachuu dha;","poem":1},{"text":"qaaniin isaa yoom iyyuu isa irraa hin haqamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Hinaaffaan aarii dhirsaa kakaasaatii;","poem":1},{"text":"inni yeroo haaloo baʼutti dhiifama tokko iyyuu hin godhu.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Inni beenyaa tokko illee hin fudhatu;","poem":1},{"text":"hammam baayʼatu iyyuu inni mattaʼaa ni dida.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}