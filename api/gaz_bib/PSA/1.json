{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Namni gorsa hamootaatiin hin deddeebine,","poem":1},{"text":"yookaan karaa cubbamootaa irra hin dhaabanne,","poem":2},{"lineBreak":true},{"text":"yookaan barcuma qoostotaa irra hin teenye, eebbifamaa dha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Garuu inni seera Waaqayyootti gammada;","poem":1},{"text":"seera isaas halkanii guyyaa irra deddeebiʼee itti yaada.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inni akkuma muka qarqara bishaan yaaʼuu dhaabamee","poem":1},{"text":"yeroo isaatti ija isaa kennu,","poem":2},{"text":"kan baalli isaas hin coollagnee ti;","poem":1},{"text":"wanni inni hojjetu hundinuus ni tolaaf.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hamoonni garuu akkana miti;","poem":1},{"text":"isaan akka habaqii qilleensi fudhatee balleessuu ti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kanaafuu hamoonni murtii dura,","poem":1},{"text":"yookaan cubbamoonni waldaa qajeeltotaa keessa hin dhaabatan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Waaqayyo karaa qajeeltotaa ni beekaatii;","poem":1},{"text":"karaan hamootaa garuu gara badiitti geessa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}