,{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nama dhoksaan ollaa isaa hamatu kam iyyuu,","poem":1},{"text":"ani afaan nan qabachiisa;","poem":2},{"text":"nama tuffiin nama ilaaluu fi kan garaa of tuulu qabuuf,","poem":1},{"text":"ani obsa hin qabaadhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Akka isaan na wajjin jiraataniif,","poem":1},{"text":"iji koo amanamoota biyyattii irra jiraatti;","poem":2},{"lineBreak":true},{"text":"namni karaa qajeelaa irra deemu, inni na tajaajila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Namni nama gowwoomsu tokko iyyuu","poem":1},{"text":"mana koo keessa hin jiraatu;","poem":2},{"text":"namni soba dubbatu tokko iyyuu","poem":1},{"text":"fuula koo dura hin dhaabatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ani jalʼoota biyyattii hunda,","poem":1},{"text":"ganama ganama nan barbadeessa;","poem":2},{"text":"warra waan hamaa hojjetan","poem":1},{"text":"magaalaa Waaqayyoo keessaa nan balleessa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}