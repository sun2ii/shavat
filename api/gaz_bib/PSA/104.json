{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":104,"content":[{"type":"verse","number":1,"content":[{"text":"Yaa lubbuu ko, Waaqayyoon eebbisi.","poem":1},{"lineBreak":true},{"text":"Yaa Waaqayyo, Waaqa ko, ati akka malee guddaa dha;","poem":1},{"text":"miidhaginaa fi surraa uffatteerta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ati akkuma wayyaa ifa uffatta;","poem":1},{"text":"samiiwwanis akkuma dunkaanaa diriirsita.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dareeraa diinqa isaa bishaanota irra buufta.","poem":2},{"text":"Duumessoota gaarii isaa godhata;","poem":1},{"text":"qoochoo bubbee yaabbattee deema.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inni ergamoota isaa hafuurota,","poem":1},{"text":"tajaajiltoota isaa immoo arraba ibiddaa godha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Inni lafa hundee ishee irra dhaabeera;","poem":1},{"text":"isheenis gonkumaa hin sochootu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ati akkuma wayyaatti tuujubaan ishee haguugde;","poem":1},{"text":"bishaanonnis tulluuwwanii ol dhaabatan.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ati ifannaan bishaanonni baqatan;","poem":1},{"text":"sagalee qaqawwee keetii dhageenyaan gugatan.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Isaan tulluuwwan irraan dhangalaʼan;","poem":1},{"text":"gara iddoo ati isaanii qopheessitee,","poem":2},{"lineBreak":true},{"text":"gara sululootaatti gad yaaʼan.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akka isaan deebiʼanii lafa hin haguugneef","poem":1},{"text":"ati daarii isaan darbuu hin dandeenye isaan dura dhaabde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Akka burqaawwan sululoota keessa yaaʼan goota;","poem":1},{"text":"isaanis tulluuwwan gidduu yaaʼu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isaan bineensota bakkee hundaaf bishaan kennu;","poem":1},{"text":"harroonni diidaas dheebuu baʼu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Simbirroonni samii bishaanota biratti mandhee ijaarratan;","poem":1},{"text":"dameewwan gidduutti ni faarfatan.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Inni mana isaa kan olii irraa tulluuwwan bishaan obaafta;","poem":1},{"text":"laftis ija hojii keetiitiin quufti.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Inni lafa irraa nyaata kennuuf jedhee looniif marga,","poem":1},{"text":"faayidaa namaatiif immoo biqiltuuwwan biqilcha;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"akka daadhiin wayinii garaa nama gammachiisu,","poem":1},{"text":"akka zayitiin fuula nama cululuqsuu fi","poem":2},{"lineBreak":true},{"text":"akka midhaan nama jajjabeessu ni goota.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mukkeen Waaqayyoo,","poem":1},{"text":"birbirsi Libaanoon kan inni dhaabe sun bishaan quufaniiru.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Simbirroonni achitti mandhee isaanii ijaarratu;","poem":1},{"text":"huummoonis birbirsa irraa mana qabdi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tulluuwwan dhedheeroon daʼoo reʼee diidaa ti;","poem":1},{"text":"holqi kattaawwanii immoo daʼoo osolee ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Inni akka jiʼi waqtiilee gargar qoodu godha;","poem":1},{"text":"biiftuunis yeroo itti lixxu ni beekti.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ati dukkana uumta; halkanis ni taʼa;","poem":1},{"text":"bineensonni bosonaa hundis gad yaaʼu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Leenci saafelli waan nyaatu barbaadee aada;","poem":1},{"text":"nyaata isaas Waaqa bira barbaada.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Isaan yommuu biiftuun baatutti walitti qabamu;","poem":1},{"text":"dachaʼaniis goda isaanii keessa ciciisu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Namni gara hojii isaatti,","poem":1},{"text":"hamma galgalaattis gara jiruu isaatti ni baʼa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Yaa Waaqayyo, hojiin kee akkam baayʼee dha!","poem":1},{"text":"Ati hunda isaanii ogummaadhaan hojjette;","poem":2},{"lineBreak":true},{"text":"laftis uumamawwan keetiin guutamte.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Galaanni guddaa fi balʼaan kun,","poem":1},{"text":"uumamawwan hamma hin qabneen guutame;","poem":2},{"lineBreak":true},{"text":"kan lubbuu qabeeyyiin gurguddaa fixixinnoon keessa jiraatan kuunnoo jira.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Dooniiwwan as irra deddeebiʼu;","poem":1},{"text":"lewaataan kan akka inni achi keessataphatuuf ati uumtes achi jira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Akka ati nyaata isaanii yeroo barbaachisuutti isaaniif kennituuf,","poem":1},{"text":"isaan hundi si eeggatu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Yeroo ati isaaniif kennitutti,","poem":1},{"text":"isaan walitti qabatu;","poem":2},{"text":"yeroo ati harka kee balʼiftutti,","poem":1},{"text":"isaan waan gaarii quufu.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Yeroo ati fuula kee dhokfattutti,","poem":1},{"text":"isaan ni naʼu;","poem":2},{"text":"yeroo ati hafuura isaanii fudhattutti,","poem":1},{"text":"isaan duʼanii biyyootti deebiʼu.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Yeroo ati Hafuura kee ergitutti isaan ni uumamu;","poem":1},{"text":"atis fuula lafaa ni haaromsita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Ulfinni Waaqayyoo bara baraan haa jiraatu;","poem":1},{"text":"Waaqayyo hojii isaatti haa gammadu;","poem":2}]},{"type":"verse","number":32,"content":[{"text":"inni ilaallaan lafti hollatte;","poem":1},{"text":"inni tuqnaan tulluuwwan keessaa aarrii baʼe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Bara jireenya koo guutuu ani Waaqayyoof nan faarfadha;","poem":1},{"text":"hamma lubbuun koo jirtuttis faarfannaadhaanWaaqa koo nan galateeffadha.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Irra deddeebiʼee yaaduun koo isa haa gammachiisu;","poem":1},{"text":"ani Waaqayyotti nan gammadaatii.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Cubbamoonni lafa irraa haa badan;","poem":1},{"text":"hamoonnis siʼachi hin jiraatin.","poem":2},{"lineBreak":true},{"text":"Yaa lubbuu koo Waaqayyoon eebbisi.","poem":1},{"lineBreak":true},{"text":"Haalleluuyaa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}