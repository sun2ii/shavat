{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":105,"content":[{"type":"verse","number":1,"content":[{"text":"Waaqayyoof galata galchaa; maqaa isaas waammadhaa;","poem":1},{"text":"waan inni hojjetes saboota gidduutti beeksisaa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isaaf faarfadhaa; faarfannaadhaan isa galateeffadhaa;","poem":1},{"text":"waaʼee hojii isaa isa dinqisiisaa hundaas odeessaa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Maqaa isaa qulqulluu sanaan boonaa;","poem":1},{"text":"garaan warra Waaqayyoon barbaadanii haa gammadu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Waaqayyoo fi humna isaa barbaaddadhaa;","poem":1},{"text":"yeroo hunda fuula isaa barbaadaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dinqii inni hojjete,","poem":1},{"text":"hojii isaa dinqii sanaa fi murtii inni labse yaadadhaa;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"isin tajaajiltoonni isaa, warri sanyii Abrahaam taatan,","poem":1},{"text":"isin filatamtoonni isaa, ilmaan Yaaqoobis kana yaadadhaa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni Waaqayyo Waaqa keenya;","poem":1},{"text":"murtiin isaas lafa hunda irra jira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Inni kakuu isaa bara baraan,","poem":1},{"text":"waadaa gale sanas dhaloota kumaaf ni yaadata;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"inni kakuu Abrahaam wajjin gale,","poem":1},{"text":"kakuu Yisihaaqiif kakates ni yaadata.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kanas Yaaqoobiif seera,","poem":1},{"text":"Israaʼeliif immoo kakuu bara baraa godheeakkana jedhee mirkaneesseera:","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Ani biyya Kanaʼaan","poem":1},{"text":"qooda ati dhaaltu godhee siif nan kenna.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Isaan yeroo lakkoobsaan xinnoo turanitti,","poem":1},{"text":"dhugumaanuu xinnoo fi biyyattii keessattiskeessummoota turanitti,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"sabaa gara sabaatti, mootummaa tokkoo gara","poem":1},{"text":"mootummaa biraatti jooran.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Inni akka namni tokko iyyuu isaan cunqursu hin eeyyamne;","poem":1},{"text":"sababii isaaniitiifis akkana jedhee mootota ifate:","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Dibamtoota koo hin tuqinaa;","poem":1},{"text":"raajota koos hin miidhinaa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Inni beela biyyattiitti waame;","poem":1},{"text":"midhaan nyaataa hundas ni balleesse;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"innis Yoosef namicha akka garbaatti","poem":1},{"text":"gurgurame tokko isaan dura erge.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Isaan foncaadhaan miilla isaa luqqisan;","poem":1},{"text":"mormi isaas sibiila keessa galfame;","poem":2}]},{"type":"verse","number":19,"content":[{"text":"hamma wanni inni duraan dursee dubbate guutamutti","poem":1},{"text":"dubbiin Waaqayyoo isa qore.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mootiin nama ergee gad isa dhiisise;","poem":1},{"text":"bulchaan sabaa isa hiiksise.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mootichis mana isaa irratti ajajaa,","poem":1},{"text":"qabeenya isaa hunda irratti immoo bulchaa isa godhate;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"kanas akka inni akkuma fedhetti qondaaltota isaa gorsuuf,","poem":1},{"text":"akka inni maanguddoota isaa ogummaa barsiisuuf godhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Israaʼel biyya Gibxi dhaqe;","poem":1},{"text":"Yaaqoobis akka alagaatti biyya Haam keessa jiraate.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Waaqayyo saba isaa akka malee baayʼise;","poem":1},{"text":"akka isaan amajaajota isaanii caalaa jabaatanis godhe;","poem":2}]},{"type":"verse","number":25,"content":[{"text":"innis akka isaan saba isaa jibbanii fi","poem":1},{"text":"akka isaan tajaajiltoota isaatti mariʼataniif yaada isaanii geeddare.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Waaqnis Musee tajaajilaa isaatii fi","poem":1},{"text":"Aroon filatamaa isaa erge.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Isaanis jara gidduutti mallattoo isaa,","poem":1},{"text":"biyya Haam keessatti immoo dinqii isaa argisiisan.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Inni dukkana ergee biyyattii dukkaneesse;","poem":1},{"text":"isaan dubbii isaatti fincilaniiruutii.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Inni bishaanota isaanii dhiigatti geeddaree","poem":1},{"text":"akka qurxummiiwwan isaanii dhuman godhe.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Fatteen biyya isaanii guutee","poem":1},{"text":"diinqa mootota isaanii keessa yaaʼe.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Inni dubbannaan tuunni tisiisaatii fi","poem":1},{"text":"bookeen biyya isaanii hunda keessa guutte.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Inni qooda bokkaa cabbii isaaniif roobse;","poem":1},{"text":"bakakkaas biyya isaaniitti erge;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"wayinii isaaniitii fi muka harbuu isaanii balleesse;","poem":1},{"text":"mukkeen biyya isaaniis ni caccabse.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Inni dubbannaan hawwaannisnii fi","poem":1},{"text":"korophisni hedduun dhufan;","poem":2}]},{"type":"verse","number":35,"content":[{"text":"isaanis biqiltuu biyya jaraa hunda nyaatan;","poem":1},{"text":"waan lafti isaanii baases ni fixan.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ergasii inni hangafa biyya isaanii hunda,","poem":1},{"text":"jabina isaanii jalqabaas ni dhaʼe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Akka sabni Israaʼel meetii fi warqee baadhatee baʼu godhe;","poem":1},{"text":"gosa isaanii keessaa namni tokko iyyuu hin gufanne.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Israaʼeloonni baanaan warri Gibxi gammadan;","poem":1},{"text":"isaan Israaʼelin sodaatanii turaniitii.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Inni akka gaaddisaatti duumessa isaan irra qabe;","poem":1},{"text":"akka halkaniin isaaniif ibsuuf immoo ibidda qabsiiseef.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Isaan kadhannaan inni dimbiriqqee kenneef;","poem":1},{"text":"buddeena samiitiinis isaan quufse.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Innis kattaa bane; bishaanis keessaa gad dhangalaʼe;","poem":1},{"text":"akkuma bishaan lagaattis gammoojjii keessaa yaaʼe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":42,"content":[{"text":"Inni waadaa isaa qulqulluu,","poem":1},{"text":"kan garbicha isaa Abrahaamiif gale sana yaadateeraatii.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Inni saba isaa gammachuun,","poem":1},{"text":"warra isaaf filataman immoo ililleedhaan baaseera;","poem":2}]},{"type":"verse","number":44,"content":[{"text":"inni biyya ormootaa isaaniif kenne;","poem":1},{"text":"isaanis waan saboonni sun itti dadhaban dhaalan;","poem":2}]},{"type":"verse","number":45,"content":[{"text":"kanas akka isaan sirna isaa eeganii","poem":1},{"text":"seera isaatiif bulaniif godhe.","poem":2},{"lineBreak":true},{"text":"Haalleluuyaa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":45}