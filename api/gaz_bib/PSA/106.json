{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":106,"content":[{"type":"verse","number":1,"content":[{"text":"Haalleluuyaa.","poem":1},{"lineBreak":true},{"text":"Waaqayyoof galata galchaa; inni gaariidhaatii;","poem":1},{"text":"jaalalli isaa bara baraan jiraata.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Eenyutu hojii Waaqayyoo jabaa sana labsuu,","poem":1},{"text":"yookaan galata isaa guutummaatti odeessuu dandaʼaa?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Warri jabeessanii murtii qajeelaa eegan,","poem":1},{"text":"warri yeroo hunda waan qajeelaa hojjetan eebbifamoo dha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yaa Waaqayyo, yommuu saba keetti faara toltutti na yaadadhu;","poem":1},{"text":"yommuu isaan oolchituttis na gargaari;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"akka ani badhaadhummaa filatamtoota keetii arguuf,","poem":1},{"text":"akka ani gammachuu saba keetii keessatti hirmaadhee","poem":2},{"lineBreak":true},{"text":"dhaala kee wajjin boonuuf na yaadadhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nu akkuma abbootii keenyaa cubbuu hojjenneerra;","poem":1},{"text":"yakka hojjenneerra; hamminas hojjenneerra.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abbootiin keenya yeroo biyya Gibxi keessa turanitti,","poem":1},{"text":"dinqii kee hin hubanne;","poem":2},{"text":"baayʼina araara keetiis hin yaadanne;","poem":1},{"text":"isaan galaana biratti, Galaana Diimaa biratti sitti fincilan.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Taʼus inni akka humni isaa guddaan sun beekamuuf,","poem":1},{"text":"maqaa isaatiif jedhee isaan oolche.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inni Galaana Diimaa ifate; galaanichis ni goge;","poem":1},{"text":"akkuma waan gammoojjii keessa dabarsuutti lafa gogaa irra isaan dabarse.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Harka amajaajii isaanii keessaa isaan baase;","poem":1},{"text":"humna diinaa jalaas isaan fure.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bishaanonni diinota isaanii liqimsan;","poem":1},{"text":"tokkoon isaanii iyyuu hin hafne.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ergasii isaan dubbii isaa amananii","poem":1},{"text":"faarfannaadhaan isa galateeffatan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Isaan garuu yommusuma waan inni hojjetee ture dagatan;","poem":1},{"text":"gorsa isaas obsaan hin eegganne.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Gammoojjii keessatti dharraa hamaadhaan guutaman;","poem":1},{"text":"lafa onaa keessattis Waaqa qoran.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kanaafuu inni waan isaan kadhatan kenneef;","poem":1},{"text":"garuu dhukkuba nama huqqisu isaanitti erge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Isaan qubata keessatti Musee fi","poem":1},{"text":"Aroon qulqullicha Waaqayyootti hinaafan.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Lafti afaan banattee Daataanin liqimsite;","poem":1},{"text":"garee Abiiraamis gad fudhatte.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Duuka buutoota isaanii gidduutti ibiddi bobaʼe;","poem":1},{"text":"arrabni ibiddaas hamoota fixe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Isaan Kooreebitti jabbii tolfatan;","poem":1},{"text":"fakkii baqfamee tolfames waaqeffatan.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Isa Ulfina isaanii taʼe sana,","poem":1},{"text":"fakkii sangaa marga dheeduutti geeddaran.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Waaqa isaan fayyise,","poem":1},{"text":"isa biyya Gibxitti waan gurguddaa hojjete sana irraanfatan.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Dinqii inni biyya Haam keessatti hojjete,","poem":1},{"text":"hojii sodaachisaa inni Galaana Diimaa irratti hojjetes ni irraanfatan.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kanaafuu utuu filatamaan isaa Museen","poem":1},{"text":"akka dheekkamsi Waaqaa isaan hin balleessineef","poem":2},{"text":"gidduu galee fuula isaa dura dhaabachuu baatee silaa","poem":1},{"text":"Waaqni akka isaan balleessu dubbatee ture.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Isaanis biyya namatti tolu sana tuffatan;","poem":1},{"text":"waadaa Waaqni gales hin amanne.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Dunkaanota isaanii keessatti ni guunguman;","poem":1},{"text":"Waaqayyoofis hin ajajamne.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kanaafuu inni akka gammoojjii keessatti","poem":1},{"text":"isaan gatu harka isaa ol qabatee kakate;","poem":2}]},{"type":"verse","number":27,"content":[{"text":"sanyii isaanii akka saboota gidduutti gatu,","poem":1},{"text":"biyyoota hunda keessas akka isaan bittinneessu kakate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Isaan Baʼaal Pheʼooritti of kennanii","poem":1},{"text":"aarsaa waaqota lubbuu hin qabneef dhiʼeeffame nyaatan.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Hojii isaanii hamaa sanaanWaaqayyoon dheekkamsaaf kakaasan;","poem":1},{"text":"dhaʼichis isaan irra buʼe.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Garuu Fiinehaas kaʼee gidduu seennaan","poem":1},{"text":"dhaʼichi sun dhaabate.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kunis dhalootaa hamma dhalootaatti,","poem":1},{"text":"akka qajeelummaatti isaaf herregame.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Isaan bishaan Mariibaa biratti akka Waaqayyo aaru godhan.","poem":1},{"text":"Museenis sababii isaaniitiif rakkate;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"sababii isaan Hafuura Waaqaatti fincilaniif","poem":1},{"text":"Museen utuu itti hin yaadin dubbate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Isaan akka Waaqayyo isaan ajajetti,","poem":1},{"text":"saboota hin balleessine;","poem":2}]},{"type":"verse","number":35,"content":[{"text":"isaan garuu ormootatti makamanii","poem":1},{"text":"duudhaa isaanii baratan.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Waaqota isaanii tolfamoo,","poem":1},{"text":"kanneen kiyyoo isaanitti taʼan waaqeffatan.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Ilmaan isaaniitii fi intallan isaanii","poem":1},{"text":"aarsaa godhanii hafuurota hamoof dhiʼeessan.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Isaanis dhiiga warra balleessaa hin qabnee,","poem":1},{"text":"dhiiga ilmaan isaaniitii fi intallan isaanii,","poem":2},{"text":"kan waaqota tolfamoo Kanaʼaaniif","poem":1},{"text":"aarsaa godhanii dhiʼeessan sana dhangalaasan;","poem":2},{"lineBreak":true},{"text":"biyyattiinis dhiiga isaaniitiin faalamte.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Isaan waanuma hojjetaniin of xureessan;","poem":1},{"text":"hojii isaaniitiin sagaagaltoota of taasisan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Kanaafuu Waaqayyo saba isaatti aare;","poem":1},{"text":"handhuuraa isaas ni balfe.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Inni dabarsee ormootatti isaan kenne;","poem":1},{"text":"amajaajonni isaaniis of jalatti isaan bulchan.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Diinonni isaanii isaan cunqursan;","poem":1},{"text":"humna isaanii jalas isaan galfatan.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Inni yeroo baayʼee isaan baraare;","poem":1},{"text":"isaan garuu ittuma fufanii fincilan;","poem":2},{"lineBreak":true},{"text":"ittuma caalchisaniis cubbuu hojjetan.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Inni garuu yommuu iyya isaanii dhagaʼetti,","poem":1},{"text":"rakkina isaanii hubate;","poem":2}]},{"type":"verse","number":45,"content":[{"text":"isaaniif jedhee kakuu isaa yaadate;","poem":1},{"text":"sababii jaalala isaa guddaa sanaatiif garaa laafeef.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Inni akka warri isaan boojiʼan hundinuu","poem":1},{"text":"garaa isaaniif laafaniif godhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Yaa Waaqayyo, Waaqa keenya nu oolchi;","poem":1},{"text":"akka nu maqaa kee qulqulluu sana galateeffannuuf,","poem":2},{"text":"akka galata keetiin of jajnuufis,","poem":1},{"text":"ormoota keessaa walitti nu qabi.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"Waaqayyo, Waaqa Israaʼeliitiif,","poem":1},{"text":"bara baraa hamma bara baraatti galanni haa gaʼu.","poem":2},{"lineBreak":true},{"text":"Namni hundinuu “Ameen!” haa jedhu.","poem":1},{"lineBreak":true},{"text":"Haalleluuyaa!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}