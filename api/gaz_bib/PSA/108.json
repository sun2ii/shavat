{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":108,"content":[{"type":"hebrew_subtitle","content":["Faarfannaa Daawit."]},{"type":"verse","number":1,"content":[{"text":"Yaa Waaqi, garaan koo hin raafamu; ani nan faarfadha;","poem":1},{"text":"lubbuu koo guutuudhaanis sin galateeffadha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yaa kiraaraa fi baganaa dammaqaa!","poem":1},{"text":"Anis ganamaan nan dammaqa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yaa Waaqayyo, ani saboota gidduutti galata siif nan galcha;","poem":1},{"text":"namoota gidduuttis waaʼee kee nan faarfadha.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Jaalalli kee guddaa dha; samiiwwanis caalaa ol dheeraadhaatii;","poem":1},{"text":"amanamummaan kees samiiwwan qaqqaba.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yaa Waaqi, ati samiiwwaniin olitti ol ol jedhi;","poem":1},{"text":"ulfinni kees lafa hunda irra haa jiraatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Akka warri ati jaallattu furamaniif,","poem":1},{"text":"harka kee mirgaatiin nu oolchi; nu gargaaris;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Waaqni iddoo qulqullummaa isaatii akkana jedhee dubbateera:","poem":1},{"text":"“Ani gammachuudhaan Sheekemin gargar nan qooda;","poem":2},{"lineBreak":true},{"text":"Sulula Sukootis nan safara.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Giliʼaad kan koo ti; Minaaseenis kan koo ti;","poem":1},{"text":"Efreem gonfoo sibiilaa koo ti;","poem":2},{"lineBreak":true},{"text":"Yihuudaanis bokkuu mootummaa koo ti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Moʼaab caabii dhiqannaa koo ti;","poem":1},{"text":"Edoom irra kophee koo darbadhee nan buusa;","poem":2},{"lineBreak":true},{"text":"Filisxeem irrattis moʼannaadhaan nan geerara.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Eenyutu magaalaa jabeeffamtee ijaaramtetti na fida?","poem":1},{"text":"Eenyutu Edoomitti na geessa?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yaa Waaqi kan nu gatte,","poem":1},{"text":"kan loltoota keenya wajjin baʼuu diddes suma mitii?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Diina keenya of irraa dhowwuu nu gargaar,","poem":1},{"text":"gargaarsi namaa faayidaa hin qabuutii.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nu Waaqa wajjin ni moʼanna;","poem":1},{"text":"innis diinota keenya gad dhidhiita.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}