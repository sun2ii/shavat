{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["Dura buʼaa Faarfattootaatiif. Faarfannaa Daawit."]},{"type":"verse","number":1,"content":[{"text":"Ani Waaqayyotti kooluu galeera.","poem":1},{"text":"Yoos isin akkamitti lubbuu kootiin akkana jechuu dandeessu:","poem":2},{"lineBreak":true},{"text":"“Ati akkuma simbirroo tulluu keetti barrisi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kunoo namoonni hamoon iddaa isaanii dabsataniiru;","poem":1},{"text":"isaan warra toloota taʼan,","poem":2},{"text":"dukkana keessa waraanuuf jedhanii,","poem":1},{"text":"xiyya isaanii ribuutti dhaabbataniiru.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yoo hundeewwan diigaman, namni qajeelaan","poem":1},{"text":"maal gochuu dandaʼa?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Waaqayyo mana qulqullummaa isaa qulqulluu sana keessa jira;","poem":1},{"text":"teessoon Waaqayyoo samii irra jira.","poem":2},{"text":"Inni ilmaan namootaa ni ilaala;","poem":1},{"text":"iji isaas namoota ni qora.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Waaqayyo qajeeltotaa fi jalʼoota ni qora;","poem":1},{"text":"lubbuun isaa garuu nama goolii jaallatu ni jibbiti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inni hamoota irratti, barbadaa ibiddaatii fi","poem":1},{"text":"dinyii bobaʼu ni roobsa;","poem":2},{"lineBreak":true},{"text":"qoodni isaaniis bubbee finiinaa dha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Waaqayyo waan qajeelaa taʼeef,","poem":1},{"text":"murtii qajeelaa jaallata;","poem":2},{"lineBreak":true},{"text":"toloonnis fuula isaa ni argu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}