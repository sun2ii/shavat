{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"Haalleluuyaa.","poem":1},{"lineBreak":true},{"text":"Namni Waaqayyoon sodaatu,","poem":1},{"text":"kan ajaja isaatti baayʼee gammadu eebbifamaa dha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Sanyiin isaa lafa irratti jabaa taʼa;","poem":1},{"text":"dhaloonni tolootaa ni eebbifama.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Qabeenyii fi badhaadhummaan mana isaa keessa jira;","poem":1},{"text":"qajeelummaan isaas bara baraan jiraata.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nama tolaa fi arjaadhaaf,","poem":1},{"text":"gara laafessaa fi qajeelaaf,dukkana keessatti iyyuu ifni ni baʼa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nama arjaa fi nama waa namaa liqeessuuf,","poem":1},{"text":"nama hojii isaa qajeelummaadhaan adeemsifatuufwaan gaariitu taʼa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dhugumaan inni gonkumaa hin raafamu;","poem":1},{"text":"namni qajeelaan bara baraan yaadatama.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni oduu hamaa hin sodaatu;","poem":1},{"text":"garaan isaas Waaqayyoon amanachuudhaanjabaatee dhaabata.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Garaan isaa hin raafamu; hin sodaatus;","poem":1},{"text":"dhuma irrattis diinota isaa moʼata.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inni ni bittinneesse; hiyyeeyyiifis ni kenne;","poem":1},{"text":"qajeelummaan isaa bara baraan ni jiraata;","poem":2},{"lineBreak":true},{"text":"gaanfi isaas ulfinaan ol qabama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Namni hamaan waan kana argee aara;","poem":1},{"text":"ilkaan isaa qara; baqees ni bada;","poem":2},{"lineBreak":true},{"text":"hawwiin hamootaa faayidaa malee hafa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}