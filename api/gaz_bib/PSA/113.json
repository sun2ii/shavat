{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Haalleluuyaa.","poem":1},{"lineBreak":true},{"text":"Yaa tajaajiltoota Waaqayyoo, galata galchaa;","poem":1},{"text":"maqaa Waaqayyoo jajadhaa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ammaa hamma bara baraatti","poem":1},{"text":"maqaan Waaqayyoo haa eebbifamu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Baʼa biiftuutii hamma lixa biiftuutti,","poem":1},{"text":"maqaan Waaqayyoo haa jajamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Waaqayyo saba hundaa ol jira;","poem":1},{"text":"ulfinni isaas samiiwwanii ol.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kan akka Waaqayyo Waaqa keenya","poem":1},{"text":"isa gubbaa teessoo isaa irra taaʼu sanaa eenyu?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kan gad jedhee","poem":1},{"text":"samii fi lafa ilaalu eenyu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Inni hiyyeessa awwaara keessaa ni kaasa;","poem":1},{"text":"rakkataas tuulaa daaraa keessaa ol fuudha;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"inni bulchitoota gidduu,","poem":1},{"text":"bulchitoota saba isaa gidduus isaan teessisa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inni akkuma haadha ijoollee kan gammachuudhaan jiraattuutti,","poem":1},{"text":"dubartii maseena mana ishee keessa ni jiraachisa.","poem":2},{"lineBreak":true},{"text":"Haalleluuyaa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}