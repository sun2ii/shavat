{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"Yeroo sabni Israaʼel biyya Gibxii, manni Yaaqoobis","poem":1},{"text":"saba afaan ormaa dubbatu keessaa baʼetti,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yihuudaan mana qulqullummaa Waaqaa,","poem":1},{"text":"Israaʼel immoo bulchiinsa isaa taʼe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Galaanni argee baqate;","poem":1},{"text":"Yordaanosis duubatti deebiʼe;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"tulluuwwan akka korbeeyyii hoolaa,","poem":1},{"text":"gaarranis akkuma xobbaallaawwan hoolaa burraaqan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yaa galaana, ati maaliif baqatte?","poem":1},{"text":"Yaa Yordaanos, atis maaliif duubatti deebite?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yaa tulluuwwan, isin maaliif akka korbeeyyii hoolaa,","poem":1},{"text":"yaa gaarran isinis maaliif akka xobbaallaawwan hoolaa burraaqxu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yaa lafa, fuula Gooftaa duratti,","poem":1},{"text":"fuula Waaqa Yaaqoob duratti holladhu;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"inni kattaa gara harootti,","poem":1},{"text":"kattaa jabaa immoo gara burqaa bishaaniitti geeddare.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}