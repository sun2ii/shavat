{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"verse","number":1,"content":[{"text":"Ani Waaqayyoon nan jaalladha;","poem":1},{"text":"inni sagalee waammata kootii naa dhagaʼeeraatii.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sababii inni gurra isaa gara kootti deebiseef,","poem":1},{"text":"ani hamman lubbuun jiraadhutti isa nan waammadha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kiyyoon duʼaa na marse;","poem":1},{"text":"dhiphinni Siiʼoolis na qabate;","poem":2},{"lineBreak":true},{"text":"ani rakkinaa fi gaddaan nan moʼame.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Anis, “Yaa Waaqayyo na oolchi!” jedhee","poem":1},{"text":"maqaa Waaqayyoo nan waammadhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Waaqayyo arjaa fi qajeelaa dha;","poem":1},{"text":"Waaqni keenya gara laaffessa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Waaqayyo garraamota ni eega;","poem":1},{"text":"yeroo ani baayʼee rakkadhetti isatu na gargaare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yaa lubbuu ko, boqonnaa keetti deebiʼi;","poem":1},{"text":"Waaqayyo waan gaarii siif godheeraatii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ati yaa Waaqayyo lubbuu koo duʼa irraa,","poem":1},{"text":"ija koo imimmaan irraa,","poem":2},{"lineBreak":true},{"text":"miilla koo gufachuu irraa waan oolchiteef,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ani biyya warra jiraatoo keessa,","poem":1},{"text":"fuula Waaqayyoo dura nan jiraadha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani yeroo, “Ani baayʼee dhiphadheera” jedhetti,","poem":1},{"text":"amantii koo eeggadheera.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ani yommuun burjaajaʼetti,","poem":1},{"text":"“Namni hundinuu sobduu dha” nan jedhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Waan gaarii inni naa godhe hundaaf,","poem":1},{"text":"ani Waaqayyoof maalan deebisa?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ani xoofoo fayyinaa ol kaasee","poem":1},{"text":"maqaa Waaqayyoo nan waammadha.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Fuula saba isaa hundumaa duratti,","poem":1},{"text":"ani wareega koo Waaqayyoof nan galcha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Duuti qulqulloota isaa,","poem":1},{"text":"fuula Waaqayyoo duratti ulfina qaba.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yaa Waaqayyo, ani dhugumaan tajaajilaa kee ti;","poem":1},{"text":"ani tajaajilaa kee ilma tajaajiltuu keetii ti;","poem":2},{"lineBreak":true},{"text":"ati foncaa koo narraa hiikteerta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ani aarsaa galataa siif nan dhiʼeessa;","poem":1},{"text":"maqaa Waaqayyoos nan waammadha.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Iddoo sabni isaa hundi jirutti,","poem":1},{"text":"ani wareega koo Waaqayyoof nan galcha;","poem":2}]},{"type":"verse","number":19,"content":[{"text":"yaa Yerusaalem si keessatti,","poem":1},{"text":"oobdii mana Waaqayyoo irrattis nan galcha.","poem":2},{"lineBreak":true},{"text":"Haalleluuyaa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}