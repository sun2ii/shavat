{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":118,"content":[{"type":"verse","number":1,"content":[{"text":"Waaqayyoof galata galchaa; inni gaariidhaatii;","poem":1},{"text":"jaalalli isaa bara baraan jiraata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Sabni Israaʼel, “Jaalalli isaa","poem":1},{"text":"bara baraan jiraata” haa jedhu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Manni Aroonis,","poem":1},{"text":"“Jaalalli isaa bara baraan jiraata” haa jedhu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Warri Waaqayyoon sodaatan,","poem":1},{"text":"“Jaalalli isaa bara baraan jiraata” haa jedhan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dhiphina koo keessatti ani Waaqayyotti nan iyyadhe;","poem":1},{"text":"innis deebii naa kenne; iddoo balʼaas na qubachiise.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Waaqayyo na wajjin jira; ani hin sodaadhu;","poem":1},{"text":"namni maal na gochuu dandaʼa?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Waaqayyo na wajjin jira; inni gargaaraa koo ti.","poem":1},{"text":"Anis diinota koo nan moʼadha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nama amanachuu irra,","poem":1},{"text":"Waaqayyotti kooluu galuu wayya.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Qondaaltota amanachuu irra,","poem":1},{"text":"Waaqayyotti kooluu galuu wayya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Saboonni hundinuu na marsan;","poem":1},{"text":"ani garuu maqaa Waaqayyootiin isaan nan barbadeesse.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isaan karaa hundaan na marsan;","poem":1},{"text":"ani garuu maqaa Waaqayyootiin isaan nan barbadeesse.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Akkuma tuuta kanniisaa na marsan;","poem":1},{"text":"garuu akka qoraattii gubatuutti barbadaaʼan;","poem":2},{"lineBreak":true},{"text":"anis maqaa Waaqayyootiin isaan nan barbadeesse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ani dhiibamee kufuu gaʼeen ture;","poem":1},{"text":"Waaqayyo garuu na gargaare.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Waaqayyo jabina kootii fi faarfannaa koo ti;","poem":1},{"text":"inni fayyina koo taʼeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Sagaleen gammachuutii fi moʼannaa dunkaanota","poem":1},{"text":"qajeeltotaa keessaa ni dhagaʼama;","poem":2},{"text":"“Harki Waaqayyoo kan mirgaa waan jabaa hojjeteera!","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Harki Waaqayyo mirgaa ol qabameera;","poem":2},{"lineBreak":true},{"text":"harki Waaqayyoo mirgaa waan jabaa hojjeteera!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ani nan jiraadha malee hin duʼu;","poem":1},{"text":"waan Waaqayyo hojjetes nan labsa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Waaqayyo jabeessee na adabeera;","poem":1},{"text":"garuu dabarsee duʼatti na hin kennine.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Karra qajeelummaa naa banaa;","poem":1},{"text":"anis ol galee Waaqayyoof galata nan galcha.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kun karra Waaqayyoo,","poem":1},{"text":"kan qajeeltonni ittiin ol galanii dha.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ati deebii naa kenniteertaatii, ani sin galateeffadha;","poem":1},{"text":"ati fayyina naa taateerta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Dhagaan ijaartonni tuffatan,","poem":1},{"text":"dhagaa golee taʼeera;","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Waaqayyo waan kana hojjeteera;","poem":1},{"text":"kunis ija keenyatti dinqii dha.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Guyyaan kun guyyaa Waaqayyo uumee dha;","poem":1},{"text":"kottaa ni ililchina; itti gammannas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Yaa Waaqayyo, si kadhannaa nu oolchi;","poem":1},{"text":"Yaa Waaqayyo, si kadhannaa nu milkoomsi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kan maqaa Waaqayyootiin dhufu eebbifamaa dha.","poem":1},{"text":"Nu mana Waaqayyoo keessaa isin eebbifna.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Waaqayyo Waaqa;","poem":1},{"text":"ifa isaas nuu irratti ibseera.","poem":2},{"text":"Dameewwan harkatti qabadhaatiiwarra ayyaaneffachuu dhaqanitti makamaa;","poem":1},{"text":"gara gaanfawwan iddoo aarsaas dhaqaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ati Waaqa koo ti; ani sin galateeffadha;","poem":1},{"text":"ati Waaqa koo ti; anis sin leellisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Waaqayyoof galata galchaa; inni gaariidhaatii;","poem":1},{"text":"jaalalli isaa bara baraan jiraata.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}