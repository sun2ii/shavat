{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"hebrew_subtitle","content":["Dura buʼaa Faarfattootaatiif. Faarfannaa Daawit kan akka sirna Shamiiniitiitti faarfatamu."]},{"type":"verse","number":1,"content":[{"text":"Yaa Waaqayyo, namni Waaqa sodaatu hin jiruutii ati na gargaar;","poem":1},{"text":"ilmaan namaa keessaas namni amanamu dhabameeraatii.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Namni hundinuu ollaa isaatti soba dubbata;","poem":1},{"text":"isaan nama saadanii garaa lamaan dubbatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Waaqayyo afaan nama saadu hunda,","poem":1},{"text":"arraba of tuulu hundas haa kukkutu;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"isaanis, “Nu arraba keenyaan ni moona;","poem":1},{"text":"hidhiin keenyas keenyuma;","poem":2},{"lineBreak":true},{"text":"eenyutu nurratti gooftummaa qaba?” jedhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Waaqayyo, “Ani sababii hacuucamuu hiyyeeyyiitiif,","poem":1},{"text":"sababii aaduu rakkattootaatiifis amma nan kaʼa.","poem":2},{"lineBreak":true},{"text":"Nagaa isaan hawwan keessas isaan nan jiraachisa” jedha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dubbiin Waaqayyoo hirʼina hin qabu;","poem":1},{"text":"innis akka meetii boolla ibiddaa keessatti baqfamee","poem":2},{"lineBreak":true},{"text":"yeroo torba qulqulleeffamee ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yaa Waaqayyo ati nu eegda;","poem":1},{"text":"dhaloota akkanaa irraas bara baraan nu oolchita.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yeroo wanni faayidaa hin qabne ilmaan namaa gidduutti kabajamutti","poem":1},{"text":"hamoonni of dhiibuudhaan kallattii hundaan asii fi achi naannaʼu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}