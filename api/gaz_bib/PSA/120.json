{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"hebrew_subtitle","content":["Faarfannaa Ol baʼuu."]},{"type":"verse","number":1,"content":[{"text":"Ani rakkina koo keessatti Waaqayyotti nan iyyadha;","poem":1},{"text":"innis deebii naa kenna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yaa Waaqayyo, afaan sobuu fi","poem":1},{"text":"arraba nama gowwoomsu jalaa na baasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yaa arraba gowwoomsituu nana, maaltu siif kennama?","poem":1},{"text":"Kana caalaas maal godhamta?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inni xiyya loltootaa kan qarameen,","poem":1},{"text":"barbadaa ibiddaa qacamaatiin si adaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ani waanan Meshek keessa taaʼee","poem":1},{"text":"dunkaanota Qeedaar gidduu jiraadhuuf, anaaf wayyoo!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Warra nagaa jibban gidduu,","poem":1},{"text":"ani yeroo dheeraa jiraadheera.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ani nama nagaa barbaadu dha;","poem":1},{"text":"isaan garuu yeroo ani dubbadhu lolaaf kakaʼan.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}