{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["Faarfannaa Ol baʼuu. Faarfannaa Daawit."]},{"type":"verse","number":1,"content":[{"text":"Yommuu isaan, “Kottu gara mana Waaqayyoo dhaqnaa”","poem":1},{"text":"naan jedhanitti, ani nan gammade.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yaa Yerusaalem,","poem":1},{"text":"miilli keenya karrawwan kee irra dhaabata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yerusaalem akka magaalaa walitti maxxantee","poem":1},{"text":"gobbatte tokkootti ijaaramte.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kunis iddoo gosoonni,","poem":1},{"text":"gosoonni Waaqayyo,","poem":2},{"text":"akka sirna Israaʼeliif kenname sanaatti,","poem":1},{"text":"maqaa Waaqayyoo galateeffachuuf itti ol baʼanii dha.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Teessoowwan murtii,","poem":1},{"text":"teessoowwan mana Daawit achi dhaabatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Akkana jedhaa nagaa Yerusaalemiif kadhadhaa:","poem":1},{"text":"“Warri si jaallatan nagaan haa jiraatan.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dallaa kee keessa nagaan,","poem":1},{"text":"masaraa mootummaa keetii keessa immoo tasgabbiin haa jiraatu.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ani obboloota kootii fi michoota kootiif jedhee,","poem":1},{"text":"“Nagaan si keessa haa jiraatu” nan jedha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mana Waaqayyo Waaqa keenyaatiif jedhee,","poem":1},{"text":"ani akka wanni gaariin siif taʼu nan hawwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}