an gaarii godhi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Warra karaa micciiramaatti garagalan garuu,","poem":1},{"text":"Waaqayyo akkuma warra hammina hojjetan balleessu jaras ni balleessa.","poem":2},{"lineBreak":true},{"text":"Nagaan Israaʼeliif haa taʼu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}