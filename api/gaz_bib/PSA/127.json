{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"hebrew_subtitle","content":["Faarfannaa Ol baʼuu. Faarfannaa Solomoon."]},{"type":"verse","number":1,"content":[{"text":"Waaqayyo mana ijaaruu baannaan,","poem":1},{"text":"warri ijaaran akkasumaan dadhabu.","poem":2},{"text":"Waaqayyo magaalaa eeguu baannaan,","poem":1},{"text":"warri eegan akkasumaan dhaabachaa bulu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isin buddeena dadhabbii guddaan argame nyaachuuf jettanii,","poem":1},{"text":"barii barraaqaan kaʼuun keessan,","poem":2},{"text":"turtanii rafuun keessan faayidaa hin qabu;","poem":1},{"text":"inni warra jaallatuuf utuma isaan rafanii iyyuuwaan isaan barbaachisu ni kennaaf.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kunoo, ijoolleen kennaa Waaqayyoo ti;","poem":1},{"text":"iji gadameessaas badhaasa isaa ti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ijoolleen dargaggummaa keessa dhalchan,","poem":1},{"text":"akkuma xiyya harka goota tokkoo keessa jiruu ti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Namni korojoon isaa xiyyaan guutame eebbifamaa dha.","poem":1},{"text":"Inni yommuu karra duratti diinota isaatiin falmutti hin qaanaʼu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}