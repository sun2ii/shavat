kootti gammadu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ani garuu araara kee nan amanadha;","poem":1},{"text":"garaan koos fayyisuu keetti ni gammada.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani Waaqayyoof nan faarfadha;","poem":1},{"text":"arjummaan isaa naa baayʼateeraatii.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}