{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["Faarfannaa ol baʼuu."]},{"type":"verse","number":1,"content":[{"text":"Yaa Waaqayyo, ani boolla gad fagoo keessaasitti nan iyyadha;","poem":1}]},{"type":"verse","number":2,"content":[{"text":"yaa Gooftaa, sagalee koo dhagaʼi.","poem":2},{"text":"Gurri kees sagalee waammata koo","poem":1},{"text":"xiyyeeffatee haa dhagaʼu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yaa Waaqayyo, utuu ati cubbuu lakkooftee,","poem":1},{"text":"yaa gooftaa silaa eenyutu dhaabachuu dandaʼa?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Garuu dhiifamni si bira jira;","poem":1},{"text":"kanaaf ati ni sodaatamta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ani Waaqayyoon nan eeggadha; lubbuun koos isa eeggatti;","poem":1},{"text":"dubbii isaas nan abdadha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eegdota barii lafaa eeggatan caalaa,","poem":1},{"text":"dhugumaan eegdota barii lafaa eeggatan caalaa","poem":2},{"lineBreak":true},{"text":"lubbuun koo Gooftaa eeggatti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yaa Israaʼel, ati Waaqayyoon abdadhu;","poem":1},{"text":"Waaqayyo bira jaalalli dhuma hin qabne,","poem":2},{"lineBreak":true},{"text":"furiin guutuunis ni jiraatii.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inni mataan isaa cubbuu isaanii","poem":1},{"text":"hundumaa irraa Israaʼelin ni fura.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}