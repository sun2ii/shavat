{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":135,"content":[{"type":"verse","number":1,"content":[{"text":"Haalleluuyaa.","poem":1},{"lineBreak":true},{"text":"Maqaa Waaqayyoo jajadhaa;","poem":1},{"text":"isin garboonni Waaqayyoo isa galateeffadhaa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isin warri mana Waaqayyoo keessa,","poem":1},{"text":"oobdii mana Waaqa keenyaa keessa tajaajiltan, isa galateeffadhaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Waaqayyo gaariidhaatii, Waaqayyoon galateeffadhaa;","poem":1},{"text":"inni arjaadhaatii maqaa isaatiif faarfadhaa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Waaqayyo Yaaqoobin ofii isaatiif,","poem":1},{"text":"Israaʼelin immoo dhaala dhuunfaa isaa godhee filateeraatii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ani akka Waaqayyo guddaa taʼe,","poem":1},{"text":"akka Gooftaan keenya waaqota hunda caalaa guddaa taʼe beeka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Waaqayyo samiiwwan keessattii fi lafa irratti,","poem":1},{"text":"galaanotaa fi tuujuba isaanii hunda keessatti,","poem":2},{"lineBreak":true},{"text":"waan isa gammachiisu kam iyyuu ni hojjeta.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni akka duumessoonni daarii lafaatii kaʼan ni godha;","poem":1},{"text":"bokkaa wajjin balaqqee erga;","poem":2},{"lineBreak":true},{"text":"gombisaa isaa keessaas bubbee gad baasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Inni hangafoota Gibxi,","poem":1},{"text":"kan namaatii fi kan horii ni dhaʼe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yaa Gibxi, inni gidduu keetti,","poem":1},{"text":"Faraʼoonii fi tajaajiltoota isaa hundatti mallattoo fi dinqii isaa ergeera.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Inni saboota baayʼee dhaʼee","poem":1},{"text":"mootota jajjaboo ajjeese;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sihoon mootii warra Amoorotaa,","poem":1},{"text":"Oogi mootii Baashaanii fi mootota Kanaʼaan hunda ni ajjeese;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"lafa isaanii dhaala godhee","poem":1},{"text":"akka dhaala isaanii taʼuufis saba isaa Israaʼeliif kenne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yaa Waaqayyo, maqaan kee bara baraan jiraata;","poem":1},{"text":"yaa Waaqayyo, ati dhaloota hunda keessatti ni yaadatamta.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Waaqayyo saba isaatiif ni falma;","poem":1},{"text":"tajaajiltoota isaatiifis garaa laafa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Waaqonni tolfamoon namoota ormaa meetii fi","poem":1},{"text":"warqee harka namaatiin hojjetamanii dha.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Isaan afaan qabu; garuu dubbachuu hin dandaʼan;","poem":1},{"text":"ijas qabu; garuu arguu hin dandaʼan;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"gurra qabu; garuu dhagaʼuu hin dandaʼan;","poem":1},{"text":"yookaan hafuurri tokko iyyuu afaan isaanii keessa hin jiru.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Warri isaan tolchan kanneen isaan amanatan hundi","poem":1},{"text":"akkuma isaanii taʼu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yaa mana Israaʼel Waaqayyoon eebbisaa;","poem":1},{"text":"yaa mana Aroon Waaqayyoon eebbisaa;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"yaa mana Lewwii Waaqayyoon eebbisaa;","poem":1},{"text":"isin warri isa sodaattanis, Waaqayyoon eebbisaa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Waaqayyo inni Yerusaalem keessa jiraatu sun,","poem":1},{"text":"Xiyoon irraa haa eebbifamu.","poem":2},{"lineBreak":true},{"text":"Haalleluuyaa!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}