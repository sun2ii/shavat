{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":136,"content":[{"type":"verse","number":1,"content":[{"text":"Waaqayyoof galata galchaa; inni gaariidhaatii.","poem":1},"Jaalalli isaa bara baraan jiraata."]},{"type":"verse","number":2,"content":[{"text":"Waaqa waaqotaatiif galata galchaa.","poem":1},"Jaalalli isaa bara baraan jiraata."]},{"type":"verse","number":3,"content":[{"text":"Gooftaa Gooftotaatiif galata galchaa:","poem":1},"Jaalalli isaa bara baraan jiraata."]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"inni kophaa isaa dinqii gurguddaa hojjeta;","poem":1},"Jaalalli isaa bara baraan jiraata."]},{"type":"verse","number":5,"content":[{"text":"inni ogummaa isaatiin samiiwwan uume;","poem":1},"Jaalalli isaa bara baraan jiraata."]},{"type":"verse","number":6,"content":[{"text":"inni bishaanota irratti lafa diriirse;","poem":1},"Jaalalli isaa bara baraan jiraata."]},{"type":"verse","number":7,"content":[{"text":"inni ifa gurguddaa hojjete;","poem":1},"Jaalalli isaa bara baraan jiraata."]},{"type":"verse","number":8,"content":[{"text":"inni akka biiftuun guyyaa mootu godhe;","poem":1},"Jaalalli isaa bara baraan jiraata."]},{"type":"verse","number":9,"content":[{"text":"inni akka jiʼii fi urjiiwwan halkan moʼan godhe;","poem":1},"Jaalalli isaa bara baraan jiraata."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"inni hangafa Gibxi dhaʼe;","poem":1},"Jaalalli isaa bara baraan jiraata."]},{"type":"verse","number":11,"content":[{"text":"inni isaan gidduudhaa Israaʼelin baase;","poem":1},"Jaalalli isaa bara baraan jiraata."]},{"type":"verse","number":12,"content":[{"text":"harka jabaa fi irree diriiraadhaan Israaʼelin baase;","poem":1},"Jaalalli isaa bara baraan jiraata."]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"inni Galaana Diimaa iddoo lamatti gargarii qoode;","poem":1},"Jaalalli isaa bara baraan jiraata."]},{"type":"verse","number":14,"content":[{"text":"inni galaana gidduudhaan Israaʼelin dabarse;","poem":1},"Jaalalli isaa bara baraan jiraata."]},{"type":"verse","number":15,"content":[{"text":"Faraʼoonii fi loltoota isaa garuu Galaana Diimaatti naqe;","poem":1},"Jaalalli isaa bara baraan jiraata."]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"inni saba ofii isaa gammoojjii keessa geggeesse;","poem":1},"Jaalalli isaa bara baraan jiraata."]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"inni mootota gurguddaa dhaʼe;","poem":1},"Jaalalli isaa bara baraan jiraata."]},{"type":"verse","number":18,"content":[{"text":"inni mootota jajjaboo fixe;","poem":1},"Jaalalli isaa bara baraan jiraata."]},{"type":"verse","number":19,"content":[{"text":"inni Sihoon mootii Amoorotaa ajjeese;","poem":1},"Jaalalli isaa bara baraan jiraata."]},{"type":"verse","number":20,"content":[{"text":"inni Oogi mootii Baashaan ajjeese;","poem":1},"Jaalalli isaa bara baraan jiraata."]},{"type":"verse","number":21,"content":[{"text":"inni biyya isaanii dhaala godhee kenne;","poem":1},"Jaalalli isaa bara baraan jiraata."]},{"type":"verse","number":22,"content":[{"text":"dhaala godhee garbicha isaa Israaʼeliif kenne;","poem":1},"Jaalalli isaa bara baraan jiraata."]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Inni yeroo nu gad deebinetti nu yaadate;","poem":1},"Jaalalli isaa bara baraan jiraata."]},{"type":"verse","number":24,"content":[{"text":"inni harka diinota keenyaatii nu baase,","poem":1},"Jaalalli isaa bara baraan jiraata."]},{"type":"verse","number":25,"content":[{"text":"inni uumama hundaaf soora kenna;","poem":1},"Jaalalli isaa bara baraan jiraata."]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Waaqa samiitiif galata galchaa.","poem":1},"Jaalalli isaa bara baraan jiraata."]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}