{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":147,"content":[{"type":"verse","number":1,"content":[{"text":"Haalleluuyaa.","poem":1},{"lineBreak":true},{"text":"Faarfannaadhaan Waaqa galateeffachuun akkam gaarii dha;","poem":1},{"text":"isa galateeffachuun akkam gammachiisaa fi kan maluu dha!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Waaqayyo Yerusaalemin ni ijaara;","poem":1},{"text":"Israaʼeloota boojiʼamanis walitti qaba.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Warra garaan cabe ni fayyisa;","poem":1},{"text":"madaa isaaniis walitti hodha.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inni baayʼina urjiiwwanii ni beeka;","poem":1},{"text":"tokkoo tokkoo isaaniis maqaa maqaadhaan waama.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gooftaan keenya guddaa dha; humni isaas jabaa dha;","poem":1},{"text":"hubannaan isaas dhuma hin qabu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Waaqayyo warra gad qabaman ni jiraachisa;","poem":1},{"text":"hamoota garuu lafatti darbata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Galata galchaa Waaqayyoon faarfadhaa;","poem":1},{"text":"baganaadhaanis Waaqa keenyaaf weeddisaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Inni samiiwwani duumessaan haguuga;","poem":1},{"text":"lafaafis bokkaa kenna;","poem":2},{"lineBreak":true},{"text":"tulluuwwan irrattis marga biqilcha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Horiidhaaf waan isaan dheedan,","poem":1},{"text":"yommuu ilmaan arraagessaa iyyanittinyaata isaaniif ni kenna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Inni jabina fardaatti hin gammadu;","poem":1},{"text":"yookaan miilli namaa isa hin gammachiisu;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Waaqayyo warra isa sodaatanitti,","poem":1},{"text":"warra araara isaa abdatanitti ni gammada.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yaa Yerusaalem, Waaqayyoon galateeffadhu;","poem":1},{"text":"Yaa Xiyoon Waaqa kee galateeffadhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Inni danqaraa karra keetii ni jabeessaatii;","poem":1},{"text":"ijoollee kees si keessatti eebbisa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Daarii keetiif nagaa kenna;","poem":1},{"text":"qamadii qulqulluudhaanis si quubsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Inni ajaja isaa gara lafaatti ni erga;","poem":1},{"text":"dubbiin isaas ni ariifata.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Inni cabbii akkuma suufiitti diriirsa;","poem":1},{"text":"qorras akkuma daaraatti bittinneessa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dhagaa cabbii akkuma cirrachaa gad darbata.","poem":1},{"text":"Dhaamocha isaa dura eenyutu dhaabachuu dandaʼa?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Inni dubbii isaa ergee isaan baqsa;","poem":1},{"text":"bubbee isaa ni kaasa; bishaanonnis ni yaaʼu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Inni dubbii isaa Yaaqoobitti,","poem":1},{"text":"seeraa fi sirna isaa immoo Israaʼelitti mulʼiseera.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Waan kana saba biraa tokkoof iyyuu hin goone;","poem":1},{"text":"isaan seera isaa hin beekan.","poem":2},{"lineBreak":true},{"text":"Haalleluuyaa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}