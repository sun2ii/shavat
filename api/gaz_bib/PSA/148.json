{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"Haalleluuyaa.","poem":1},{"lineBreak":true},{"text":"Samiiwwan irraa Waaqayyoon galateeffadhaa;","poem":1},{"text":"ol gubbaatti isa galateeffadhaa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ergamoonni isaa hundinuu isa galateeffadhaa;","poem":1},{"text":"raayyaan isaa hundinuus isa galateeffadhaa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Aduu fi jiʼi isa galateeffadhaa;","poem":1},{"text":"urjiiwwan ibsitan hundinuus isa galateeffadhaa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Samiiwwan samii isa galateeffadhaa;","poem":1},{"text":"bishaanonni samiin ol jirtanis isa galateeffadhaa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isaan maqaa Waaqayyoo haa galateeffatan;","poem":1},{"text":"inni ajajnaan, isaan uumamaniitii.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inni bara baraa hamma bara baraatti isaan dhaabeera;","poem":1},{"text":"seera hin geeddaramnes isaaniif kenneera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Uumamawwan galaanaatii fi tuujubawwan hundi,","poem":1},{"text":"lafa irraa Waaqayyoon galateeffadhaa;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"bakakkaa fi dhagaan cabbii, cabbii fi duumessi,","poem":1},{"text":"bubbeen jabaan ajaja isaa raawwatan,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"tulluuwwanii fi gaarran hundinuu,","poem":1},{"text":"mukkeen ija naqatanii fi birbirsi hundinuu,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"bineensonnii fi loon hundinuu,","poem":1},{"text":"uumamawwan xixinnoo fi simbirroonni barrisan,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"mootonni lafaatii fi saboonni hundinuu,","poem":1},{"text":"ilmaan moototaatii fi bulchitoonni lafaa hundinuu,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"dargaggoonnii fi shamarran,","poem":1},{"text":"jaarsolii fi daaʼimman isa galateeffadhaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Maqaan isaa qofti ol ol jedheeraatii,","poem":1},{"text":"isaan maqaa Waaqayyoo haa galateeffatan;","poem":2},{"lineBreak":true},{"text":"ulfinni isaas lafaa fi samiiwwanii ol jira.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Inni saba isaatiif gaanfa ol kaaseera;","poem":1},{"text":"kunis qulqulloota isaa hundaaf,","poem":2},{"lineBreak":true},{"text":"saba Israaʼel warra isatti dhiʼoo jiran hundaaf ulfina.","poem":2},{"lineBreak":true},{"text":"Haalleluuyaa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}