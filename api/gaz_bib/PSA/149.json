{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"Haalleluuyaa.","poem":1},{"lineBreak":true},{"text":"Faarfannaa haaraa Waaqayyoof faarfadhaa;","poem":1},{"text":"waldaa qulqullootaa keessatti illee isa jajadhaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Israaʼel Uumaa isaatti haa gammadu;","poem":1},{"text":"sabni Xiyoon Mootii isaatti haa gammadu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Maqaa isaas shuubbisuudhaan haa jajatu;","poem":1},{"text":"dibbee fi baganaadhaan isaaf haa faarfatu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Waaqayyo saba isaatti ni gammadaatii;","poem":1},{"text":"warra gad of qabanis fayyina gonfachiisa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Qulqulloonni ulfina kanatti haa gammadan;","poem":1},{"text":"siree isaanii irrattis gammachuudhaan haa faarfatan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Galanni Waaqaa afaan isaanii keessa haa jiraatu;","poem":1},{"text":"goraadeen afaan lamaas harka isaanii keessa haa jiraattu;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"kunis sabootatti haaloo baʼuu fi","poem":1},{"text":"namoota adabuudhaaf;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"mootota isaanii foncaan,","poem":1},{"text":"hangafoota isaaniis funyoo sibiilaatiin hidhuudhaaf,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"murtii barreeffame sana isaan irratti dhugaa baʼuudhaaf.","poem":1},{"text":"Kunis amanamtoota isaa hundaaf ulfina.","poem":2},{"lineBreak":true},{"text":"Haalleluuyaa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}