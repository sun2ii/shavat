egu,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"nama maallaqa isaa hiiqiidhaan hin liqeessinee fi","poem":1},{"text":"kan nama yakka hin qabne miidhuuf jedhee mattaʼaa hin fudhannee dha.","poem":2},{"lineBreak":true},{"text":"Namni wantoota kanneen hojjetu,","poem":1},{"text":"gonkumaa hin raafamu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}