{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":19,"content":[{"type":"hebrew_subtitle","content":["Dura Buʼaa Faarfattootaatiif. Faarfannaa Daawit."]},{"type":"verse","number":1,"content":[{"text":"Samiiwwan ulfina Waaqaa odeessu;","poem":1},{"text":"bantiin samiis hojii harka isaa labsa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Guyyaan tokko guyyaa kaanitti odeessa,","poem":1},{"text":"halkan tokkos halkan kaanitti beekumsa mulʼisa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Haasaan yookaan dubbiin hin jiru;","poem":1},{"text":"sagaleen isaaniis hin dhagaʼamu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taʼus sagaleen isaanii lafa hundumaa,","poem":1},{"text":"dubbiin isaaniis handaara addunyaa gaʼe.","poem":2},{"text":"Inni samiiwwan keessatti biiftuudhaaf dunkaana dhaabe;","poem":1}]},{"type":"verse","number":5,"content":[{"text":"biiftuunis akkuma misirricha dinqa isaatii baʼuutii fi","poem":2},{"lineBreak":true},{"text":"akkuma moʼataa fiigicha dorgomutti gammadu tokkoo ti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isheenis handaara samiiwwanii tokkoo baatee","poem":1},{"text":"gara handaara kaaniitti naannofti;","poem":2},{"lineBreak":true},{"text":"wanni hoʼa ishee jalaa dhokatu tokko iyyuu hin jiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Seerri Waaqayyoo mudaa hin qabu;","poem":1},{"text":"lubbuu namatti deebisa.","poem":2},{"text":"Ajajni Waaqayyoo amanamaa dha;","poem":1},{"text":"nama wallaalaa beekaa godha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Seerri Waaqayyoo qajeelaa dha;","poem":1},{"text":"garaadhaaf gammachuu kenna.","poem":2},{"text":"Ajajni Waaqayyoo qulqulluu dha;","poem":1},{"text":"ijaafis ifa kenna.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Waaqayyoon sodaachuun qulqulluu dha;","poem":1},{"text":"bara baraan jiraata.","poem":2},{"text":"Murtiin Waaqayyoo dhugaa dha;","poem":1},{"text":"walumaa galattis qajeelaa dha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Inni warqee caalaa, warqee akka malee qulqulleeffame","poem":1},{"text":"caalaa iyyuu gatii qabeessa;","poem":2},{"text":"inni damma caalaa,","poem":1},{"text":"nadhii dammaa caalaa miʼaawaa dha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Murtii kanaanis tajaajilaan kee ni gorfama;","poem":1},{"text":"isa eeguunis gatii guddaa qaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Eenyutu dogoggora isaa hubachuu dandaʼa?","poem":1},{"text":"Yakka koo isa dhokfamaa irraa na qulqulleessi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tajaajilaa kee cubbuu ija jabinaan hojjetamu irraa eegi;","poem":1},{"text":"cubbuun kunis na hin moʼatin.","poem":2},{"text":"Yoos ani hirʼina malee nan jiraadha;","poem":1},{"text":"dogoggora guddaa irraas qulqulluu nan taʼa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yaa Waaqayyo, Kattaa koo fi Furii ko,","poem":1},{"text":"dubbiin afaan kootii fi yaadni garaa koo","poem":2},{"lineBreak":true},{"text":"fuula kee duratti fudhatamaa haa taʼu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}