{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Namoonni maaliif akkanumaan malatu?","poem":1},{"text":"Saboonnis maaliif waan akkanumaan mariʼatu?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mootonni lafaa kaʼanii,","poem":1},{"text":"bulchitoonnis Waaqayyoo fi Masiihii isaatiin mormuuf","poem":2},{"lineBreak":true},{"text":"walitti qabaman;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"isaanis, “Kottaa foncaa isaanii of irraa kukkunnaa;","poem":1},{"text":"hidhaa isaaniis of irraa hiiknee gannaa” jedhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Inni samii keessa, teessoo irra taaʼee jiru ni kolfa;","poem":1},{"text":"Gooftaanis isaanitti qoosa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Innis aarii isaatiin isaan ifata;","poem":1},{"text":"dheekkamsa isaatiinis isaan naasisa;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"innis, “Ani tulluu koo qulqulluu irra, Xiyoon irra,","poem":1},{"text":"mootii koo teessifadheera” jedha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":["Ani seera Waaqayyoo nan labsa:",{"lineBreak":true},{"text":"innis akkana anaan jedhe; “Ati ilma koo ti;","poem":1},{"text":"ani harʼa si dhalcheera.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Na kadhadhu;","poem":1},{"text":"ani saboota dhaala kee,","poem":2},{"lineBreak":true},{"text":"handaara lafaas qabeenya kee godhee siifan kenna.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ati ulee sibiilaatiin isaan cabsita;","poem":1},{"text":"akka qodaa supheettis isaan hurreessita.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kanaafuu yaa mootota, qalbeeffadhaa;","poem":1},{"text":"bulchitoonni lafaas of eeggadhaa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sodaadhaan Waaqayyoon tajaajilaa;","poem":1},{"text":"hollachaas gammadaa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Akka inni hin aarreef,","poem":1},{"text":"isinis akka karaa irratti hin badneef ilma isaa dhungadhaa;","poem":2},{"text":"dheekkamsi isaa dafee bobaʼaatii.","poem":1},{"text":"Warri isatti kooluu galan hundi eebbifamoo dha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}