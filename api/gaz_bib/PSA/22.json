{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":22,"content":[{"type":"hebrew_subtitle","content":["Dura Buʼaa Faarfattootaatiif. Yeedaloo “Borofa Ganamaa” jedhu. Faarfannaa Daawit."]},{"type":"verse","number":1,"content":[{"text":"Yaa Waaqa ko, yaa Waaqa ko, ati maaliif na dhiifte?","poem":1},{"text":"Ati na gargaaruu irraa,","poem":2},{"lineBreak":true},{"text":"iyya koo irraas maaliif akkas fagaatta?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yaa Waaqa ko, ani guyyaa guyyaa sittin iyyadha;","poem":1},{"text":"ati garuu deebii naaf hin deebiftu;","poem":2},{"lineBreak":true},{"text":"halkan halkanis afaan hin qabadhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ati garuu Qulqullicha teessoo irra taaʼuu dha;","poem":1},{"text":"ati galata Israaʼel.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Abbootiin keenya si amanatan;","poem":1},{"text":"isaan si amanatan; atis isaan oolchite.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isaan sitti iyyatan; ni fayyifamanis;","poem":1},{"text":"si amanatan; hin qaanofnes.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ani garuu raammoodha malee nama miti;","poem":1},{"text":"ani nama namni itti qoosuu fi sabnis tuffatuu dha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Warri na argan hundinuu natti kolfu;","poem":1},{"text":"mataa isaanii raasanii na arrabsu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Akkanas jedhu; “Inni Waaqayyoon amanata;","poem":1},{"text":"mee Waaqayyo isa haa oolchu kaa.","poem":2},{"lineBreak":true},{"text":"Inni waan isatti gammaduuf, isa haa oolchu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ati garuu gadameessa keessaa na baafte;","poem":1},{"text":"harma haadha koo irrattis, situ nagaan na eege.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani gaafan dhaladhee jalqabee sirratti nan gatame;","poem":1},{"text":"erga haati koo na deessee jalqabdee ati Waaqa koo ti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ati narraa hin fagaatin;","poem":1},{"text":"rakkinni dhiʼaateeraatii;","poem":2},{"lineBreak":true},{"text":"namni na gargaarus hin jiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Korommiin baayʼeen na marsu;","poem":1},{"text":"korommiin Baashaan jajjaboonis karaa hundumaan na marsu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Isaanis akka leenca beelaʼee aaduu","poem":1},{"text":"afaan isaanii balʼisanii natti banatu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ani akkuma bishaaniitti nan dhangalaafame;","poem":1},{"text":"lafeen koo hundinuus wal gad dhiise.","poem":2},{"text":"Onneen koo gara gagaatti geeddarame;","poem":1},{"text":"na keessattis baqe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Jabinni koo akka qiraacii goge;","poem":1},{"text":"arrabni koo laagaatti na maxxane;","poem":2},{"lineBreak":true},{"text":"awwaara duʼaa keessas na ciibsite.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Saroonni na marsaniiru;","poem":1},{"text":"gareen namoota hamoo na marseera;","poem":2},{"lineBreak":true},{"text":"isaanis harkaa fi miilla koo waraananii fullaasaniiru.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ani lafee koo hunda lakkaaʼuu nan dandaʼa;","poem":1},{"text":"isaanis ija babaasanii na ilaalu; akkas taʼuu koottis ni gammadu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Isaan wayyaa koo hiratan;","poem":1},{"text":"uffata koottis ixaa buufatan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yaa Waaqayyo, ati garuu narraa hin fagaatin;","poem":1},{"text":"yaa Jabina koo na gargaaruuf ariifadhu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Lubbuu koo goraadee jalaa,","poem":1},{"text":"jireenya koo immoo humna sarootaa jalaa baasi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Afaan leencaa jalaa na miliqsi;","poem":1},{"text":"gaanfa gafarsaa jalaas na baasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Maqaa kee obboloota kootti nan labsa;","poem":1},{"text":"waldaa keessattis sin jajadha.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Isin warri Waaqayyoon sodaattan isa jajadhaa!","poem":1},{"text":"Isin sanyiin Yaaqoob hundinuu isa ulfeessaa!","poem":2},{"lineBreak":true},{"text":"Sanyiin Israaʼel hundinuus isa sodaadhaa!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Inni dhiphina nama dhiphatee hin tuffanne","poem":1},{"text":"yookaan hin balfineetii;","poem":2},{"text":"yommuu inni gargaarsaaf isatti iyyatettis,","poem":1},{"text":"ni dhagaʼeef malee fuula isaa hin dhokfanne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Galanni ani yaaʼii guddaa irratti siif galchu si biraa dhufa;","poem":1},{"text":"warra si sodaatan durattis wareega koo of irraa nan baasa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hiyyeeyyiin nyaatanii quufu;","poem":1},{"text":"warri Waaqayyoon barbaaddatanis isa ni jajatu;","poem":2},{"lineBreak":true},{"text":"garaan keessan bara baraan haa jiraatu!","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Handaarri lafaa hundinuu ni yaadata;","poem":1},{"text":"gara Waaqayyoottis ni deebiʼa;","poem":2},{"text":"maatiiwwan sabootaa hundinuus","poem":1},{"text":"fuula isaa duratti ni sagadu;","poem":2}]},{"type":"verse","number":28,"content":[{"text":"mootummaan kan Waaqayyootii;","poem":1},{"text":"innis saboota hunda ni bulcha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Sooreyyiin lafaa hundinuu ni nyaatu; ni waaqeffatus;","poem":1},{"text":"warri of jiraachisuu hin dandeenye kanneen biyyoo seenan hundi","poem":2},{"lineBreak":true},{"text":"fuula isaa duratti ni jilbeenfatu.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Dhaloonni dhufu isa tajaajila;","poem":1},{"text":"dhaloota boriittis waaʼeen Gooftaa ni himama.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Sababii inni waan kana hojjeteef,","poem":1},{"text":"isaan saba dhalachuuf jirutti qajeelummaa isaa ni labsu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}