{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["Faarfannaa Daawit."]},{"type":"verse","number":1,"content":[{"text":"Waaqayyo tiksee koo ti; ani homaa hin dhabu.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Inni marga lalisaa keessa na boqochiisa;","poem":2},{"text":"gara bishaan tasgabbaaʼaattis na geessa;","poem":1}]},{"type":"verse","number":3,"content":[{"text":"inni lubbuu natti deebisa.","poem":2},{"text":"Maqaa isaatiif jedhees","poem":1},{"text":"karaa qajeelaa irra na deemsisa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ani yoon sulula gaaddisa duʼaa keessa deeme illee","poem":1},{"text":"ati waan na wajjin jirtuuf, homaa hin sodaadhu;","poem":2},{"lineBreak":true},{"text":"uleen keetii fi bokkuun kee na jajjabeessu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ati utuma diinonni koo ilaalanuu","poem":1},{"text":"fuula koo duratti maaddii naa qopheessita.","poem":2},{"text":"Mataa koo zayitii dibda;","poem":1},{"text":"xoofoon koos guutuu irraan dhangalaʼaa dha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dhugumaan gaarummaan keetii fi araarri kee,","poem":1},{"text":"bara jireenya kootii hunda na duukaa buʼu;","poem":2},{"lineBreak":true},{"text":"anis bara baraan, mana Waaqayyoo keessa nan jiraadha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}