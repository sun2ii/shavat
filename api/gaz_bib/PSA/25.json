{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":25,"content":[{"type":"hebrew_subtitle","content":["Faarfannaa Daawit."]},{"type":"verse","number":1,"content":[{"text":"Yaa Waaqayyo, ani lubbuu koo gara keetti","poem":1},{"text":"ol nan qaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yaa Waaqa koo ani sin amanadha.","poem":1},{"text":"Ati na hin qaanessin;","poem":2},{"lineBreak":true},{"text":"akka diinonni koo na moʼatanis hin godhin.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Namni si eeggatu tokko iyyuu","poem":1},{"text":"yoom iyyuu hin qaaneffamu;","poem":2},{"text":"warri sababii malee yakka hojjetan","poem":1},{"text":"garuu ni qaaneffamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yaa Waaqayyo, karaa kee na argisiisi;","poem":1},{"text":"daandii kees na barsiisi;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ati Waaqa Fayyisaa koo waan taateef,","poem":1},{"text":"dhugaa keetiin na dura buʼi; na barsiisi;","poem":2},{"lineBreak":true},{"text":"anis guyyaa guutuu sin eeggadha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yaa Waaqayyo, araara keetii fi jaalala kee yaadadhu;","poem":1},{"text":"isaan durumaa jalqabanii jiruutii.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Cubbuu afaan kootii","poem":1},{"text":"yookaan dogoggora koo hin yaadatin;","poem":2},{"text":"yaa Waaqayyo, gaarummaa keetiif jedhiitii","poem":1},{"text":"akkuma araara keetiitti na yaadadhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Waaqayyo gaarii dha; tolaadhas;","poem":1},{"text":"kanaafuu inni daandii isaa cubbamootatti argisiisa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Warra gad of qaban waan qajeelaa taʼeen geggeessa;","poem":1},{"text":"karaa isaas isaan barsiisa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Karaan Waaqayyoo hundinuu","poem":1},{"text":"warra kakuu isaatii fi seera isaa eeganiif araaraa fi dhugaa dha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yaa Waaqayyo, cubbuun koo guddaa taʼu iyyuu","poem":1},{"text":"maqaa keetiif jedhiitii dhiifama naa godhi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Namni Waaqayyoon sodaatu eenyu?","poem":1},{"text":"Waaqayyo karaa inni filachuu qabu isa argisiisa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Lubbuun isaa badhaadhummaadhaan jiraatti;","poem":1},{"text":"sanyiin isaas lafa dhaala.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Waaqayyo icciitii isaa warra isa sodaatan duraa hin dhoksu;","poem":1},{"text":"kakuu isaa illee isaan beeksisa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Iji koo yeroo hunda gara Waaqayyoo ilaala;","poem":1},{"text":"inni miilla koo kiyyoo keessaa ni baasaatii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Gara kootti garagali; garaas naa laafi;","poem":1},{"text":"ani kophaa koon jiraatii; rakkataadhas.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yaaddoon garaa kootii baayʼateera;","poem":1},{"text":"dhiphina koo keessaas na baasi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Dhiphina kootii fi rakkina koo ilaali;","poem":1},{"text":"cubbuu koo hunda naa dhiisi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Akka diinonni koo baayʼatan,","poem":1},{"text":"hammam akka cimsanii na jibban argi!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Lubbuu koo eegi; na oolchis;","poem":1},{"text":"sababii ani kooluu sitti galeef,","poem":2},{"lineBreak":true},{"text":"akka ani qaanaʼu na hin godhin.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Waan ani si eeggadhuuf, amanamummaa fi","poem":1},{"text":"qajeelummaan ana haa eegan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yaa Waaqayyo, rakkina isaa hundumaa keessaa","poem":1},{"text":"Israaʼelin furi!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}