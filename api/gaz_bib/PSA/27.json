{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":27,"content":[{"type":"hebrew_subtitle","content":["Faarfannaa Daawit."]},{"type":"verse","number":1,"content":[{"text":"Waaqayyo ibsaa kootii fi fayyina koo ti;","poem":1},{"text":"ani eenyunan sodaadha?","poem":2},{"text":"Waaqayyo daʼoo jireenya kootii ti;","poem":1},{"text":"eenyutu na sodaachisa?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Namoonni hamoon yommuu","poem":1},{"text":"foon koo nyaachuudhaaf natti dhufan,","poem":2},{"text":"diinonni koo fi amajaajonni koo","poem":1},{"text":"yommuu na miidhuuf natti kaʼan, gufatanii kufu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yoo duulli na marse illee,","poem":1},{"text":"garaan koo hin sodaatu;","poem":2},{"text":"yoo waraanni natti baname illee","poem":1},{"text":"ani hin raafamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ani waan tokko Waaqayyoon nan kadhadha;","poem":1},{"text":"waan kanas nan barbaada:","poem":2},{"text":"Kunis bara jireenya kootii guutuu","poem":1},{"text":"mana Waaqayyoo keessa jiraachuu,","poem":2},{"text":"miidhagina Waaqayyoo ilaaluu fi mana qulqullummaa isaa","poem":1},{"text":"keessatti isa kadhachuu dha.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inni guyyaa rakkinaa","poem":1},{"text":"iddoo ofii jiraatu na kaaʼataatii;","poem":2},{"text":"daʼoo dunkaana isaa jala na dhoksa;","poem":1},{"text":"kattaa gubbaattis ol na baasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yommus diinota na marsanii olitti","poem":1},{"text":"mataan koo ol jedha;","poem":2},{"text":"dunkaana isaa keessatti illee ililleedhaan aarsaa nan dhiʼeessa;","poem":1},{"text":"Waaqayyoof nan faarfadha; nan weeddisas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yaa Waaqayyo, yommuu ani si waammadhu, sagalee koo dhagaʼi;","poem":1},{"text":"naaf araarami; deebiis naaf kenni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yommuu ati, “Fuula koo barbaadaa!” jettetti,","poem":1},{"text":"garaan koo, “Yaa Waaqayyo, ani fuula kee nan barbaada” siin jedha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Fuula kee na duraa hin dhoksin;","poem":1},{"text":"aartee tajaajilaa kee of irraa hin deebisin;","poem":2},{"lineBreak":true},{"text":"ati gargaaraa koo taateerta.","poem":2},{"text":"Yaa Waaqayyo, Fayyisaa ko,","poem":1},{"text":"na hin gatin; na hin dhiisinis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yoo abbaan kootii fi haati koo na dhiisan illee,","poem":1},{"text":"Waaqayyo na simata.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yaa Waaqayyo, karaa kee na barsiisi;","poem":1},{"text":"sababii ani diinota baayʼee qabuuf","poem":2},{"lineBreak":true},{"text":"daandii qajeelaa irra na buusi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Fedhii diinota kootiitti dabarsitee na hin kennin;","poem":1},{"text":"dhuga baatonni sobduun narratti kaʼaniiruutii;","poem":2},{"lineBreak":true},{"text":"isaanis hafuura jalʼinaa baafatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Anis biyya jiraattotaa keessatti","poem":1},{"text":"gaarummaa Waaqayyoo akkan argu","poem":2},{"lineBreak":true},{"text":"amma iyyuu nan amana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Waaqayyoon eeggadhu;","poem":1},{"text":"cimi; jabaadhus;","poem":2},{"lineBreak":true},{"text":"Waaqayyoon eeggadhu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}