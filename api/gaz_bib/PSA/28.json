{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":28,"content":[{"type":"hebrew_subtitle","content":["Faarfannaa Daawit."]},{"type":"verse","number":1,"content":[{"text":"Yaa Waaqayyo, Kattaa ko, ani sin waammadha;","poem":1},{"text":"ati na jalaa hin didin.","poem":2},{"text":"Yoo ati na jalaa didde,","poem":1},{"text":"ani akka warra boolla buʼanii nan taʼa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yommuu ani gargaarsaaf si waammadhee harka koo illee","poem":1},{"text":"gara Iddoo Qulqullummaa kee","poem":2},{"text":"kan Waan Hundumaa Caalaa Qulqulluu taʼe","poem":1},{"text":"sanaatti ol kaafadhu, sagalee kadhannaa koo naa dhagaʼi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Namoota hamoo warra jalʼina hojjetan wajjin,","poem":1},{"text":"warra garaa isaaniitti hammina qabatanii","poem":2},{"text":"olloota isaanii wajjin garuu","poem":1},{"text":"nagaa dubbatan wajjin na hin balleessin.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Akka hojii isaaniitti,","poem":1},{"text":"akkuma hojii isaanii hamaa sanaattis deebisiif;","poem":2},{"text":"akkuma hojii harka isaaniitti kenniif;","poem":1},{"text":"gatii isaaniif malu isaanumatti deebisi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sababii isaan hojii Waaqayyoo,","poem":1},{"text":"yookaan waan harki isaa hojjete hin kabajneef","poem":2},{"text":"inni isaan diiga;","poem":1},{"text":"deebisees isaan hin ijaaru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Waaqayyo haa eebbifamu!","poem":1},{"text":"Inni iyya kadhannaa kootii naa dhagaʼeeraatii.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Waaqayyo jabina koo fi gaachana koo ti;","poem":1},{"text":"garaan koo isa amanata; anis gargaarsa argadheera.","poem":2},{"text":"Garaan koo baayʼee gammada;","poem":1},{"text":"anis faarfannaadhaan isa nan galateeffadha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Waaqayyo jabina saba isaa ti;","poem":1},{"text":"dibamaa isaatiifis daʼoo fayyinaa ti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Saba kee fayyisi; dhaala kees eebbisi;","poem":1},{"text":"tiksee isaanii taʼii bara baraan isaan baadhu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}