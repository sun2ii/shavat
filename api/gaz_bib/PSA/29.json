{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"hebrew_subtitle","content":["Faarfannaa Daawit."]},{"type":"verse","number":1,"content":[{"text":"Isin jajjabeeyyiin, Waaqayyoof fidaa;","poem":1},{"text":"ulfinaa fi jabina Waaqayyoof fidaa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ulfina maqaa isaatiif malu Waaqayyoof kennaa;","poem":1},{"text":"iddoo qulqullummaa isaatti Waaqayyoon waaqeffadhaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Sagaleen Waaqayyoo bishaanota irra jira;","poem":1},{"text":"Waaqni ulfinaa ni qaqawweessaʼa;","poem":2},{"lineBreak":true},{"text":"Waaqayyo bishaanota baayʼee irratti ni qaqawweessaʼa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sagaleen Waaqayyoo humna qaba;","poem":1},{"text":"sagaleen Waaqayyoo surra qabeessa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sagaleen Waaqayyoo birbirsa ni cabsa;","poem":1},{"text":"Waaqayyo birbirsa Libaanoon ni caccabsa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inni Libaanoonin akka jabbiitti,","poem":1},{"text":"Siiriyoonin immoo akka dibicha gafarsaatti ni utaalchisa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sagaleen Waaqayyoo","poem":1},{"text":"balaqqeessa bakakkaatiin rukuta.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sagaleen Waaqayyoo gammoojjii sochoosa;","poem":1},{"text":"Waaqayyo Gammoojjii Qaadesh sochoosa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sagaleen Waaqayyoo qilxuu micciira;","poem":1},{"text":"bosonas qullaatti hambisa.","poem":2},{"text":"Hundinuus mana qulqullummaa isaa keessatti, “Ulfina!” jedhee iyya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Waaqayyo lolaa badiisaatiin olitti teessoo isaa irra taaʼa;","poem":1},{"text":"Waaqayyo Mootii taʼee bara baraan teessoo isaa irra taaʼa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Waaqayyo saba isaatiif jabina kenna;","poem":1},{"text":"Waaqayyo saba isaa nagaadhaan eebbisa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}