{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["Faarfannaa Daawit yeroo ilma isaa Abesaaloom jalaa baqatetti faarfate."]},{"type":"verse","number":1,"content":[{"text":"Yaa Waaqayyo, diinonni koo akkam baayʼatu!","poem":1},{"text":"Namoonni baayʼeen natti kaʼaniiru!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Namoonni baayʼeen, “Waaqni isa hin baraaru” jedhanii","poem":1},{"text":"waaʼee koo dubbatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yaa Waaqayyo, ati garuu naannoo kootti gaachana koo ti;","poem":1},{"text":"ulfina kootis; mataa koos kan ol qabdu suma.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ani guddisee Waaqayyotti nan iyyadha;","poem":1},{"text":"innis tulluu isaa qulqulluu irraa deebii naa kenna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ani nan ciisa; nan rafas;","poem":1},{"text":"waan Waaqayyo ol na qabuuf nan dammaqa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Saba kumaatama qixa hundaan","poem":1},{"text":"kaʼee na marse ani hin sodaadhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yaa Waaqayyo kaʼi!","poem":1},{"text":"Yaa Waaqa koo na baraari!","poem":2},{"text":"Mangaagaa diinota kootii hundumaa rukuti;","poem":1},{"text":"ilkaan hamootaa illee caccabsi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Fayyinni kan Waaqayyoo ti.","poem":1},{"text":"Eebbi kee saba kee irra haa jiraatu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}