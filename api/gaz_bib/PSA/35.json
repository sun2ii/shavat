{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":35,"content":[{"type":"hebrew_subtitle","content":["Faarfannaa Daawit."]},{"type":"verse","number":1,"content":[{"text":"Yaa Waaqayyo, warra anaan mormaniin mormi;","poem":1},{"text":"warra na lolanis loli.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gaachanaa fi miʼa lolaa qabadhu;","poem":1},{"text":"na gargaaruudhaafis kaʼi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Warra na ariʼanitti","poem":1},{"text":"eeboo fi bodee luqqifadhu.","poem":2},{"text":"Lubbuu kootiinis,","poem":1},{"text":"“Fayyinni kee ana” jedhi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Warri lubbuu koo barbaadan,","poem":1},{"text":"haa qaanaʼan; haa salphatanis;","poem":2},{"text":"warri na balleessuuf mariʼatanis,","poem":1},{"text":"abdii kutatanii duubatti haa deebiʼan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Akka habaqii qilleensaan fudhatamee haa taʼan;","poem":1},{"text":"ergamaan Waaqayyoos isaan haa ariʼu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Karaan isaanii dukkanaaʼaa fi mucucaataa haa taʼu;","poem":1},{"text":"ergamaan Waaqayyoos isaan haa ariʼu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Isaan sababii malee kiyyoo isaanii dhoksaniina dura kaaʼaniiruutii;","poem":1},{"text":"sababii malees boolla naa qotaniiru;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"utuu inni hin beekin badiisni isatti haa dhufu;","poem":1},{"text":"kiyyoon inni dhokse sunis isuma haa qabu;","poem":2},{"lineBreak":true},{"text":"boolluma qote sanattis haa kufu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yoos lubbuun ko, Waaqayyotti gammaddi;","poem":1},{"text":"fayyisuu isaattis ni ililchiti.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lafeen koo hundi akkana siin jedha:","poem":1},{"text":"“Yaa Waaqayyo, kan akka keetii eenyu?","poem":2},{"text":"Ati dadhabdoota warra isaan caalaa jabaatan jalaa baafta;","poem":1},{"text":"hiyyeeyyii fi rakkattoota illee saamtota jalaa baafta.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dhuga baatonni sobaa natti kaʼan;","poem":1},{"text":"waan ani waaʼee isaa hin beeknes na gaafatu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Isaan qooda waan gaarii waan hamaa naa deebisu;","poem":1},{"text":"lubbuu koos kophaatti hambisu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ani garuu yeroo isaan dhibamanitti,wayyaa gaddaa nan uffadhe;","poem":1},{"text":"lubbuu koos soomaan nan miidhe.","poem":2},{"text":"Yeroo kadhannaan koo deebii malee hafettis","poem":1}]},{"type":"verse","number":14,"content":[{"text":"ani akkuma waan michuu kootiif yookaan obboleessa kootiif gadduutti,","poem":2},{"lineBreak":true},{"text":"gaddaan asii fi achi deddeebiʼe.","poem":2},{"text":"Akkuma waan haadha kootiif booʼuuttis,","poem":1},{"text":"gaddaan mataa koo nan buuse.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Isaan garuu yeroo ani gufadhetti gammadanii walitti qabaman;","poem":1},{"text":"utuu ani hin beekin na marsan;","poem":2},{"lineBreak":true},{"text":"utuu wal irraa hin kutinis na cicciratan.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Isaan akkuma warra Waaqatti hin bulleetti hamminaan natti qoosan;","poem":1},{"text":"ilkaan isaanii illee natti qaratan.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yaa Gooftaa, ati hamma yoomiitti calʼistee ilaalta?","poem":1},{"text":"Lubbuu koo badiisa isaan fidan jalaa,","poem":2},{"lineBreak":true},{"text":"jireenya koos leenca jalaa baasi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ani wal gaʼii guddaa keessatti sin galateeffadha;","poem":1},{"text":"tuuta guddaa keessatti sin jajadha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Warri akkasumaan diina natti taʼan natti hin gammadin;","poem":1},{"text":"warri sababii malee na jibban sunis ija natti hin qisin.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Isaan nagaa hin dubbatan;","poem":1},{"text":"warra qabbanaan biyya keessa jiraatanittis,","poem":2},{"lineBreak":true},{"text":"mala sobaa malatu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Isaanis, “Baga! Baga! Ijuma keenyaan isa argine”","poem":1},{"text":"jedhanii afaan natti banatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yaa Waaqayyo, ati waan kana argiteerta; hin calʼisin.","poem":1},{"text":"Yaa gooftaa, narraa hin fagaatin.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yaa Waaqa koo fi Gooftaa ko, ati mirga kootiif,","poem":1},{"text":"dhimma kootiifis dammaqi; kaʼi!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yaa Waaqayyo Waaqa ko,","poem":1},{"text":"akkuma qajeelummaa keetiitti naa murteessi;","poem":2},{"lineBreak":true},{"text":"akka isaan natti gammadanis hin godhin.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Akka isaan, “Baga! Akkuma nu barbaanne taʼeera!” jedhan,","poem":1},{"text":"yookaan akka isaan, “Nu isa liqimsineerra” jedhan hin godhin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Warri dhiphina kootti gammadan hundinuu","poem":1},{"text":"haa qaanaʼan; haa burjaajaʼanis;","poem":2},{"text":"warri natti kooran hundinuus,","poem":1},{"text":"qaanii fi salphina haa uffatan.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Warri qajeelumma koo jaallatan,","poem":1},{"text":"sagalee guddaadhaan haa ililchan; haa gammadanis.","poem":2},{"text":"Isaan yeroo hunda,","poem":1},{"text":"“Waaqayyo inni nagaa garbicha isaatti gammaduguddaa dha” haa jedhan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Arrabni koo qajeelummaa kee,","poem":1},{"text":"guyyaa guutuus galata kee odeessa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}