{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":37,"content":[{"type":"hebrew_subtitle","content":["Faarfannaa Daawit."]},{"type":"verse","number":1,"content":[{"text":"Ati sababii namoota hamootiif jettee hin aarin","poem":1},{"text":"yookaan warra jalʼina hojjetanitti hin hinaafin.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isaan akkuma margaa dafanii coollagu;","poem":1},{"text":"akkuma biqiltuu misee dafanii gogu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Waaqayyoon amanadhu; waan gaariis hojjedhu;","poem":1},{"text":"biyyattii keessa jiraadhu; nagaas qabaadhu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Waaqayyotti gammadi;","poem":1},{"text":"innis hawwii garaa keetii siif guuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Karaa kee Waaqayyotti kennadhu;","poem":1},{"text":"isa amanadhu; inni siif milkeessa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inni qajeelummaa kee akka aduu ganamaatti,","poem":1},{"text":"murtii kee immoo akka aduu saafaatti ibsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Waaqayyo duratti calʼisi;","poem":1},{"text":"obsaanis isa eeggadhu;","poem":2},{"text":"nama karaan isaa qajeeleefitti,","poem":1},{"text":"kan hammina hojjetuttis hin hinaafin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Aarii irraa of eegi; dheekkamsa irraas deebiʼi;","poem":1},{"text":"hin aarin; aariin hammina qofatti nama geessaatii.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Namoonni hamoon ni balleeffamuutii;","poem":1},{"text":"warri Waaqayyoon abdatan garuu lafa dhaalu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Namoonni hamoon yeroo xinnoodhaaf malee siʼachi hin jiraatan;","poem":1},{"text":"yoo ati isaan barbaadde illee hin argaman.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Garraamonni garuu lafa ni dhaalu;","poem":1},{"text":"nagaa guddaadhaanis ni gammadu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Namoonni hamoon nama qajeelaatti mariʼatu;","poem":1},{"text":"ilkaan isaaniis isatti qaratu;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gooftaan hamootatti ni kolfa;","poem":1},{"text":"inni akka guyyaan isaanii dhiʼaate ni beekaatii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Namoonni hamoon hiyyeeyyii fi","poem":1},{"text":"rakkattoota lafaan dhaʼuudhaaf,","poem":2},{"text":"warra karaan isaanii qajeelaa taʼe immoo gorraʼuudhaaf,","poem":1},{"text":"goraadee isaanii luqqifatu; iddaa isaaniis ni dabsatu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Goraadeen isaanii garuu garaadhuma isaanii waraana;","poem":1},{"text":"iddaan isaaniis ni caccaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Badhaadhummaa hamoonni baayʼeen qaban irra,","poem":1},{"text":"waan xinnoo namni qajeelaan qabu wayya;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"humni hamootaa ni cabaatii;","poem":1},{"text":"Waaqayyo garuu qajeeltota jabeessee ni dhaaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Waaqayyo bara tolootaa ni beeka;","poem":1},{"text":"dhaalli isaaniis bara baraan jiraata.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Isaan bara hamaa keessa hin qaanaʼan;","poem":1},{"text":"bara beelaa keessas ni quufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Namoonni hamoon garuu ni barbadaaʼu;","poem":1},{"text":"diinonni Waaqayyoos akkuma miidhagina daraaraa dirree ti;","poem":2},{"lineBreak":true},{"text":"isaan ni badu; akkuma aaraa ni badu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Namoonni hamoon ni liqeeffatu;","poem":1},{"text":"garuu deebisanii of irraa hin baasan;","poem":2},{"lineBreak":true},{"text":"qajeeltonni garuu arjummaadhaan kennu;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"warri Waaqayyo eebbisu lafa ni dhaalu;","poem":1},{"text":"warri inni abaaru garuu ni balleeffamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Adeemsi nama Waaqayyo biraa ajajama;","poem":1},{"text":"inni karaa namicha sanaatti ni gammada.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Inni yoo gufate illee lafa hin gaʼu;","poem":1},{"text":"Waaqayyo harka isaatiin qabee isa dhaabaatii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ani dargaggeessan ture; amma immoo dulloomeera;","poem":1},{"text":"garuu qajeeltonni gatamuu isaanii","poem":2},{"lineBreak":true},{"text":"yookaan ijoolleen isaaniis buddeena kadhachuu isaanii hin argine.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Qajeeltonni yeroo hundumaa ni arjoomu; ni liqeessus;","poem":1},{"text":"ijoolleen isaaniis ni eebbifamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Waan hamaa irraa deebiʼiitii waan gaarii hojjedhu;","poem":1},{"text":"yoos ati bara baraan ni jiraatta.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Waaqayyo murtii qajeelaa jaallataatii;","poem":1},{"text":"warra isaaf amanamanis hin gatu.","poem":2},{"lineBreak":true},{"text":"Isaanis bara baraan ni eegamu;","poem":1},{"text":"sanyiin hamootaa garuu ni balleeffama.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Qajeeltonni lafa ni dhaalu;","poem":1},{"text":"bara baraanis ishee irra ni jiraatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Afaan nama qajeelaa ogummaa dubbata;","poem":1},{"text":"arrabni isaas murtii qajeelaa labsa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Seerri Waaqa isaa garaa isaa keessa jira;","poem":1},{"text":"miilli isaas hin mucucaatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Namoonni hamoon qajeeltota gaadu;","poem":1},{"text":"isaan ajjeesuus ni barbaadu;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Waaqayyo garuu harka isaaniitti jara hin dhiisu","poem":1},{"text":"yookaan yommuu isaan murtiitti dhiʼeeffamanitti,","poem":2},{"lineBreak":true},{"text":"akka isaanitti murteeffamu hin eeyyamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Waaqayyoon eeggadhu; karaa isaas eegi.","poem":1},{"text":"Inni akka ati lafa dhaaltuuf ulfina siif kenna;","poem":2},{"lineBreak":true},{"text":"atis badiisa hamootaa ni argita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Nama hamaa fi gara jabeessa,","poem":1},{"text":"isaa akkuma muka iddoon isaa itti tolee jiru nan arge.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ergasiis achiin nan darbe; inni garuu achi hin turre;","poem":1},{"text":"ani cimsee isa nan barbaade; inni garuu hin argamne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Nama mudaa hin qabne yaadatti qabadhu; tolootas ilaali;","poem":1},{"text":"sanyiin nama nagaa hin baduutii.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Cubbamoonni hundinuu garuu ni barbadeeffamu;","poem":1},{"text":"galgalli nama hamaas hin tolu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Fayyinni qajeeltotaa Waaqayyo biraa dhufa;","poem":1},{"text":"inni yeroo rakkinaatti daʼoo isaanii ti.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Waaqayyo isaan gargaara; isaan oolchas;","poem":1},{"text":"harka namoota hamoo jalaa isaan baasa;","poem":2},{"lineBreak":true},{"text":"isaan baraaras; isaan isatti kooluu galaniiruutii.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}