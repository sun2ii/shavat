{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":40,"content":[{"type":"hebrew_subtitle","content":["Dura buʼaa faarfattootaatiif. Faarfannaa Daawit."]},{"type":"verse","number":1,"content":[{"text":"Ani obsaan Waaqayyoon nan eeggadhe;","poem":1},{"text":"innis gara kootti garagalee iyya koo naa dhagaʼe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inni boolla sodaachisaa keessaa,","poem":1},{"text":"dhoqqee nama liqimsu keessaas na baase;","poem":2},{"text":"miilla koo kattaa irra dhaabe;","poem":1},{"text":"ejjeta koos naa jabeesse.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Innis faarfannaa haaraa,","poem":1},{"text":"faarfannaa galataas afaan koo keessaWaaqa keenyaaf kaaʼe.","poem":2},{"text":"Namoonni baayʼeen arganii Waaqayyo sodaatu;","poem":1},{"text":"isas ni amanatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Namni Waaqayyoon abdatu,","poem":1},{"text":"kan gara of tuultotaa hin ilaalle,","poem":2},{"text":"namni warra karaa irraa jalʼatanii","poem":1},{"text":"waaqota sobaa duukaa buʼinitti hin gara galleeebbifamaa dha.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yaa Waaqayyo Waaqa ko,","poem":1},{"text":"dinqiin ati hojjette baayʼee dha;","poem":2},{"text":"waan ati nuuf yaadde,","poem":1},{"text":"namni tokko tokkoon sitti himuu dandaʼu","poem":2},{"lineBreak":true},{"text":"tokko iyyuu hin jiru;","poem":2},{"text":"yoo ani waaʼee isaanii labsee dubbadhe illee,","poem":1},{"text":"baayʼinni isaanii hamma hin qabu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ati aarsaa fi kennaa hin feene;","poem":1},{"text":"gurra koo garuu naa banteerta;","poem":2},{"lineBreak":true},{"text":"aarsaa gubamuu fi aarsaa cubbuu ati hin barbaanne.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yeroo sana ani akkana nan jedhe; “Ani kunoo ti; ani dhufeera;","poem":1},{"text":"waaʼeen koo kitaaba maramaa keessatti barreeffameera.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yaa Waaqa ko, ani fedhii kee raawwachuutti nan gammada;","poem":1},{"text":"seerri kee garaa koo keessa jira.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ani yaaʼii guddaa keessatti qajeelummaa nan labsa;","poem":1},{"text":"Yaa Waaqayyo, akkuma ati beektu,","poem":2},{"lineBreak":true},{"text":"ani afaan koo hin qabadhu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani qajeelummaa kee garaa koo keessa hin dhoksu;","poem":1},{"text":"waaʼee amanamummaa keetiitii fi waaʼee fayyisuu keetii nan odeessa;","poem":2},{"text":"jaalala keetii fi dhugaa kees","poem":1},{"text":"yaaʼii guddaa duraa hin dhoksu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yaa Waaqayyo araara kee na hin dhowwatin;","poem":1},{"text":"jaalalli keetii fi dhugaan kee yeroo hunda ana haa eegan.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Rakkinni hamma hin qabne na marseeraatii;","poem":1},{"text":"cubbuun koos na liqimseera; arguus dadhabeera;","poem":2},{"text":"cubbuun koo rifeensa mataa koo caalaa baayʼata;","poem":1},{"text":"onneen koos na keessatti laafteerti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yaa Waaqayyo, na fayyisuutti gammadi;","poem":1},{"text":"yaa Waaqayyo, na gargaaruudhaaf dafii kottu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Warri lubbuu koo galaafachuu barbaadan hundinuu,","poem":1},{"text":"haa qaanaʼan; haa burjaajaʼanis.","poem":2},{"text":"Warri badii koo hawwan hundi,","poem":1},{"text":"qaanaʼanii duubatti haa deebiʼan.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Warri, “Baga! Baga!” anaan jedhan,","poem":1},{"text":"qaanii isaaniitiin haa rifatan.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Warri si barbaadan hundinuu garuu","poem":1},{"text":"sitti gammadanii haa ililchan.","poem":2},{"text":"Warri fayyisuu kee jaallatan yeroo hunda,","poem":1},{"text":"“Waaqayyo guddaa dha!” haa jedhan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ani garuu hiyyeessaa fi rakkataa dha;","poem":1},{"text":"taʼus Gooftaan naaf yaada.","poem":2},{"text":"Ati gargaarsa koo fi fayyisaa koo ti;","poem":1},{"text":"yaa Waaqa ko, hin turin.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}