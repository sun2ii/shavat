{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Yaa Waaqi, naa murteessi;","poem":1},{"text":"saba hin amanametti dubbii koo naa falmi;","poem":2},{"lineBreak":true},{"text":"gowwoomsitootaa fi jalʼoota jalaas na baasi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ati Waaqa jabina kootii ti.","poem":1},{"text":"Maaliif na gatte?","poem":2},{"text":"Ani maaliifin diinaan cunqurfamee","poem":1},{"text":"gaddaan jiraadha?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ifa keetii fi dhugaa kee ergi;","poem":1},{"text":"isaan na haa qajeelchan;","poem":2},{"text":"gara tulluu kee qulqulluutti,","poem":1},{"text":"gara iddoo ati jiraattu sanaatti ana haa fiddan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yoos ani gara iddoo aarsaa Waaqaa,","poem":1},{"text":"gara Waaqa gammachuu fi ilillee koo nan dhaqa.","poem":2},{"text":"Yaa Waaqayyo, Waaqa ko,","poem":1},{"text":"ani baganaadhaan sin galateeffadha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yaa lubbuu ko, ati maaliif gaddita?","poem":1},{"text":"Na keessattis maaliif raafamta?","poem":2},{"text":"Abdii kee Waaqa irra kaaʼadhu;","poem":1},{"text":"ani amma iyyuu isa nan galateeffadha;","poem":2},{"lineBreak":true},{"text":"Fayyisaa koo fi Waaqa koo nan jajadha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}