{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["Dura buʼaa faarfattootaatiif. Faarfannaa Ilmaan Qooraahi."]},{"type":"verse","number":1,"content":[{"text":"Isin saboonni hundinuu harka keessan rukutaa;","poem":1},{"text":"sagalee ol fudhadhaatii gammachuudhaan Waaqaaf ililchaa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Waaqayyo Waaqa Waan Hundaa Olii,","poem":1},{"text":"Mootichi guddaan lafa hundumaa, sodaachisaadhaatii!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inni saboota nu jala,","poem":1},{"text":"namootas miilla keenya jala galcheera.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Innis nu warra Yaaqoob isa inni jaallate sanaaf ulfina taaneef,","poem":1},{"text":"dhaala keenya nuu fileera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Waaqni ililleedhaan, Waaqayyo sagalee","poem":1},{"text":"malakataatiin ol baʼe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Faarfannaa galataa Waaqaaf faarfadhaa;","poem":1},{"text":"faarfannaa galataa faarfadhaa;","poem":2},{"text":"faarfannaa galataa Mootii keenyaaf faarfadhaa;","poem":1},{"text":"faarfannaa galataa faarfadhaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Waaqni Mootii lafa hundaa ti;","poem":1},{"text":"faarfannaa galataa hubannaadhaan faarfadhaa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Waaqni saboota irratti Mootii dha;","poem":1},{"text":"Waaqni teessoo isaa qulqulluu irra taaʼeera.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Qondaaltonni sabootaa,","poem":1},{"text":"akkuma saba Waaqa Abrahaamitti walitti qabamu;","poem":2},{"text":"mootonni lafa irraa kan Waaqaatii;","poem":1},{"text":"innis guddisee ol ol jedheera.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}