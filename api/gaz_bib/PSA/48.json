{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"hebrew_subtitle","content":["Weedduu. Faarfannaa Ilmaan Qooraahi."]},{"type":"verse","number":1,"content":[{"text":"Magaalaa Waaqa keenyaa keessatti,","poem":1},{"text":"tulluu isaa qulqulluu irrattis, Waaqayyo guddaa dha;","poem":2},{"lineBreak":true},{"text":"waan hundaa olittis galanni isaaf mala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Tulluun Xiyoon gara kaabaatti argama;","poem":1},{"text":"dheerina isaatiinis ni bareeda.","poem":2},{"text":"Innis gammachuu addunyaa hundaa ti;","poem":1},{"text":"magaalaa Mooticha Guddaatis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Waaqni daʼannoo ishee keessa jira;","poem":1},{"text":"inni daʼannoo ishee taʼuu isaa argisiiseera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mootonni humna walitti daratanii","poem":1},{"text":"tokkummaadhaan itti qajeelan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isaanis ishee arganii dinqifatan;","poem":1},{"text":"sodaataniis baqatan.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Achittis akkuma muddama dubartii ciniinsifattuutti,","poem":1},{"text":"hollannaan isaan qabate.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Atis bubbee baʼa biiftuutiin","poem":1},{"text":"dooniiwwan Tarshiish caccabsite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Akkuma dhageenye sana,","poem":1},{"text":"magaalaa Waaqayyoo Waan Hunda Dandaʼuu keessatti,","poem":2},{"text":"magaalaa Waaqa keenyaa keessatti, akkasuma argineerra;","poem":1},{"text":"Waaqni bara baraan jabeessee ishee dhaaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yaa Waaqayyo, nu mana qulqullummaa kee keessatti,","poem":1},{"text":"jaalala kee kan hin geeddaramne sana irra deddeebinee yaadna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yaa Waaqayyo, galanni kee akkuma maqaa keetii","poem":1},{"text":"handaara lafaa gaʼa;","poem":2},{"lineBreak":true},{"text":"harki kee mirgaas qajeelummaan guutameera.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sababii murtii keetiitiif,","poem":1},{"text":"Tulluun Xiyoon haa gammaddu;","poem":2},{"lineBreak":true},{"text":"intallan Yihuudaas haa ililchan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Xiyoon irra naannaʼaa; naannoo ishee irras adeemaa;","poem":1},{"text":"gamoowwan ishees lakkaaʼaa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dhaloota itti aanutti akka himtaniif,","poem":1},{"text":"dallaa eegumsa ishee sirriitti hubadhaa;","poem":2},{"lineBreak":true},{"text":"galma ishees ilaalaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Waaqni kun bara baraa hamma bara baraatti Waaqa keenyaatii;","poem":1},{"text":"inni hamma dhumaatti illee nu qajeelcha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}