{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["Dura buʼaa faarfattootaatiif. Miʼa ribuutiin. Maskiilii Daawit. Yeroo warri Ziif Saaʼol bira dhaqanii, “Daawit nu gidduu dhokatee jira” jedhanitti faarfatame."]},{"type":"verse","number":1,"content":[{"text":"Yaa Waaqi, maqaa keetiin na fayyisi;","poem":1},{"text":"humna keetiinis naa murteessi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yaa Waaqi, kadhannaa koo naa dhagaʼi,","poem":1},{"text":"dubbii afaan kootiis dhaggeeffadhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Keessumoonni natti kaʼaniiruutii;","poem":1},{"text":"warri garaa namaa hin laafne lubbuu koo galaafachuu barbaadu;","poem":2},{"lineBreak":true},{"text":"Isaanis warra Waaqaaf ulfina hin kenninee dha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kunoo, Waaqni gargaaraa koo ti;","poem":1},{"text":"Gooftaan jiraachisaa lubbuu koo ti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Hamminni warra maqaa na balleessanii isaanumatti haa deebiʼu;","poem":1},{"text":"atis amanamummaa keetiin isaan balleessi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ani fedhii kootiin aarsaa siif dhiʼeessa;","poem":1},{"text":"yaa Waaqayyo, ani maqaa kee nan galateeffadha;","poem":2},{"lineBreak":true},{"text":"inni gaariidhaatii.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni dhiphina koo hundumaa keessaa na baaseeraatii;","poem":1},{"text":"iji koos ol aantummaadhaan diinota koo of jalatti ilaaleera.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}