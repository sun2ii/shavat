{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":55,"content":[{"type":"hebrew_subtitle","content":["Dura buʼaa faarfattootaatiif. Miʼa ribuutiin. Maskiilii Daawit."]},{"type":"verse","number":1,"content":[{"text":"Yaa Waaqi, kadhannaa koo dhagaʼi;","poem":1},{"text":"waammata koo jalaas hin didin.","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Na dhagaʼiitii deebii naa kenni;","poem":2},{"text":"komiin koo na dhiphisa; anis nagaa dhabeera.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Sagalee diinaatiin,","poem":2},{"lineBreak":true},{"text":"cunqursa namoota hamoos dhufe;","poem":2},{"text":"isaan dhiphina natti fiduutii;","poem":1},{"text":"aariidhaanis na jibbu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lapheen koo na keessatti dhiphatte;","poem":1},{"text":"sodaan duʼaas na qabate.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sodaa fi hollannaan natti dhufeera;","poem":1},{"text":"naasuunis na fudhateera.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Anis akkana nan jedhe;“Utuu ani akkuma gugee qoochoo qabaadhee!","poem":1},{"text":"Silaa asii barrisee nan boqodhan ture.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Silaa fagootti baqadhee","poem":1},{"text":"gammoojjii keessa nan bubbula ture;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"silaa bubbee hamaa fi qilleensa jabaa irraa fagaadhee","poem":1},{"text":"gara iddoo boqonnaa kootti nan ariifadhan ture.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yaa Gooftaa, namoota hamoo burjaajessi;","poem":1},{"text":"dubbii isaaniis waliin dhaʼi;","poem":2},{"lineBreak":true},{"text":"ani magaalaa keessatti goolii fi lola argeeraatii.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Isaan halkanii guyyaa ol baʼanii dallaa ishee irra naannaʼu;","poem":1},{"text":"jalʼinnii fi rakkinni ishee keessa jira.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ishee keessa badiisatu jira;","poem":1},{"text":"nama cunqursuu fi gowwoomsuun daandii ishee irraa hin dhabamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Utuu diinni na arrabsee,","poem":1},{"text":"silaa obsuu nan dandaʼa ture;","poem":2},{"text":"utuu amajaajiin natti kaʼee,","poem":1},{"text":"silaa jalaa dhokachuu nan dandaʼa ture.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Garuu siʼi namuma akka kootii,","poem":1},{"text":"hiriyaa koo, michuu koo kan natti dhiʼaatutu waan kana godhe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tokkummaadhaan mana Waaqaa walii wajjin deemne;","poem":1},{"text":"haasaa miʼaawaas walii wajjin haasofne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Duuti tasa isaanitti haa dhufu;","poem":1},{"text":"utuma lubbuudhaan jiranuu siiʼool keessa haa buʼan;","poem":2},{"lineBreak":true},{"text":"hamminni mana isaaniitii fi garaa isaanii keessa jiraattii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ani garuu Waaqa nan waammadha;","poem":1},{"text":"Waaqayyos jalaa na baasa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ani galgala, ganamaa fi waareetti dhiphinaan nan iyya;","poem":1},{"text":"innis sagalee koo ni dhagaʼa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yoo namni baayʼeen anaan morme illee,","poem":1},{"text":"inni waraana natti kaʼe jalaa miidhaa malee na baasa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Waaqni inni durumaa jalqabee teessoo irra jiru sun,","poem":1},{"text":"Namoota karaa isaanii hin geeddaranne,","poem":2},{"text":"kanneen Waaqa hin sodaanne ni dhagaʼa;","poem":1},{"text":"isaan qaanessas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Hiriyaan koo michoota isaatti harka isaa ol fudhate;","poem":1},{"text":"kakuu isaa illee ni cabse.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Dubbiin isaa akkuma dhadhaa ti; nama hin quuqu;","poem":1},{"text":"garaa isaa keessa garuu lolatu jira;","poem":2},{"text":"dubbiin isaa zayitii caalaa lallaafa;","poem":1},{"text":"garuu goraadee luqqifamee dha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yaaddoo kee Waaqayyotti kennadhu;","poem":1},{"text":"inni si jiraachisa;","poem":2},{"lineBreak":true},{"text":"namni qajeelaan akka jeqamus hin godhu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yaa Waaqayyo, ati garuu","poem":1},{"text":"namoota hamoo boolla badiisaa keessa ni buufta;","poem":2},{"text":"warri dhiiga dhangalaasanii fi gowwoomsitoonni,","poem":1},{"text":"walakkaa bara jireenya isaanii iyyuu hin jiraatan.","poem":2},{"lineBreak":true},{"text":"Ani garuu sin amanadha.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}