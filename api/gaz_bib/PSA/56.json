{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":56,"content":[{"type":"hebrew_subtitle","content":["Dura buʼaa faarfattootaatiif. Yeedaloo “Gugee Qilxuu Fagoo irraa” jedhuun faarfatame. Miiktaamii Faarfannaa Daawit. Innis yeroo Filisxeemonni Gaati keessatti isa qaban faarfate."]},{"type":"verse","number":1,"content":[{"text":"Yaa Waaqi na maari;","poem":1},{"text":"diinonni koo akka malee na ariʼu;","poem":2},{"lineBreak":true},{"text":"guyyaa guutuus na cunqursu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Diinonni koo guyyaa guutuu na gaadu;","poem":1},{"text":"namoonni baayʼeen of tuulummaadhaan na lolu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ani yommuun sodaadhutti sin amanadha.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"Waaqa ani dubbii isaa jajadhu,","poem":2},{"text":"Waaqa nan amanadha; homaa hin sodaadhu.","poem":1},{"text":"Namni duʼa hin oolle maal na gochuu dandaʼa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Isaan guyyaa guutuu dubbii koo micciiru;","poem":1},{"text":"na miidhuudhaafis yeroo hunda natti malatu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isaan ni mariʼatu; ni riphus;","poem":1},{"text":"lubbuu koo galaafachuuf jedhanii","poem":2},{"lineBreak":true},{"text":"tarkaanfii koo eeggatu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sababii hammina isaaniitiif akka isaan miliqan hin godhin;","poem":1},{"text":"yaa Waaqi, dheekkamsa keetiin saboota gad deebisi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gadadamu koo galmeessi;","poem":1},{"text":"imimmaan koos kitaaba kee keessatti barreessi;","poem":2},{"lineBreak":true},{"text":"isaan galmee kee keessa jiru mitii?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yommuu ani gargaarsaaf si waammadhutti,","poem":1},{"text":"diinonni koo dugda duuba deebiʼu.","poem":2},{"lineBreak":true},{"text":"Anis kanaan akka Waaqni na wajjin jiru beeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Waaqa ani dubbii isaa jajadhu,","poem":1},{"text":"Waaqayyo ani dubbii isaa jajadhu,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Waaqa nan amanadha; ani homaa hin sodaadhu.","poem":1},{"text":"Namni maal na gochuu dandaʼa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yaa Waaqi wareegni kee narra jira;","poem":1},{"text":"aarsaa galataas siif nan dhiʼeessa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Akka ani fuula Waaqaa dura,","poem":1},{"text":"ifa jireenyaa keessa deddeebiʼuuf,","poem":2},{"text":"ati lubbuu koo duʼa jalaa,","poem":1},{"text":"miilla koos gufachuu oolchiteertaatii.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}