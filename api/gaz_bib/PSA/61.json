{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["Dura buʼaa faarfattootaatiif. Faarfannaa Daawit kan miʼa ribuutiin faarfatame."]},{"type":"verse","number":1,"content":[{"text":"Yaa Waaqi, iyyata koo dhagaʼi;","poem":1},{"text":"kadhannaa koos dhaggeeffadhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yeroo garaan koo citetti,","poem":1},{"text":"ani handaara lafaatii sin waammadha;","poem":2},{"lineBreak":true},{"text":"ati gara kattaa na caalaa ol dheeratuutti na geessi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ati iddoo ani itti kooluu galuudhaatii;","poem":1},{"text":"fuula diina koo durattis gamoo jabaa dha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ani bara baraan dunkaana kee keessa jiraachuu,","poem":1},{"text":"gaaddisa qoochoo keetii jalattis kooluu galuu nan hawwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yaa Waaqi, ati wareega koo dhageesseertaatii;","poem":1},{"text":"dhaala warri maqaa kee sodaatan argatanis naa kenniteerta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bara jireenya mootii, umurii isaa illee","poem":1},{"text":"dhalootaa gara dhalootaatti dheeressi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Innis fuula Waaqaa duratti bara baraan haa moʼu;","poem":1},{"text":"akka jaalalli keetii fi amanamummaan kee isa eeganis godhi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Anis faarfannaa galataa maqaa keetiif nan faarfadha;","poem":1},{"text":"guyyuma guyyaanis wareega koo nan guuttadha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}