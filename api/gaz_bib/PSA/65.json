keenya,","poem":1},{"text":"ati hojii qajeelummaa sodaachisaadhaandeebii nuu kennita;","poem":2},{"text":"daarii lafaa hundumaaf,","poem":1},{"text":"galaana fagootti argamuufis ati abdii dha;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ati humna uffatteerta;","poem":1},{"text":"jabina keetiinis tulluuwwan hundeessite;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ati huursaa galaanaa,","poem":1},{"text":"huursaa dhaʼaa bishaanii,","poem":2},{"lineBreak":true},{"text":"raafama uummataas ni calʼisiifte.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Warri fagoo jiraatan dinqiiwwan kee ni sodaatu;","poem":1},{"text":"ati yeroo bariʼuu fi yeroo dhiʼutti,","poem":2},{"lineBreak":true},{"text":"akka faarfannaan gammachuu faarfatamu ni goota.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ati lafa ni eegda; bishaanis ni obaafta;","poem":1},{"text":"akka malees ni gabbifta;","poem":2},{"text":"akka namootaaf midhaan kennaniifis","poem":1},{"text":"lageen Waaqaa bishaaniin guutamaniiru;","poem":2},{"lineBreak":true},{"text":"ati kanumaaf qopheessiteertaatii.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Boʼoo isaa bishaan quubsita;","poem":1},{"text":"biyyoo isaas wal qixxeessita;","poem":2},{"text":"tiifuu bokkaatiinis ni jiifta;","poem":1},{"text":"biqila isaas ni eebbifta.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gaarummaa keetiin bara ni gonfita;","poem":1},{"text":"daandiiwwan kees cooma coccobsu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lafti margaa kan gammoojjii akka malee misa;","poem":1},{"text":"gaarranis gammachuudhaan guutamu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dirreewwan bushaayeedhaan guutamu;","poem":1},{"text":"sululoonni midhaaniin haguugamu;","poem":2},{"lineBreak":true},{"text":"isaanis ililleedhaan iyyanii faarfatu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}