{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":66,"content":[{"type":"hebrew_subtitle","content":["Dura buʼaa faarfattootaatiif. Faarfannaa."]},{"type":"verse","number":1,"content":[{"text":"Isin lafti hundinuu ililleedhaan gara Waaqaatti iyyaa!","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Ulfina maqaa isaa faarfadhaa;","poem":2},{"lineBreak":true},{"text":"galata isaatiifis ulfina kennaa!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Waaqaan akkana jedhaa;","poem":1},{"text":"“Hojiin kee akkam sodaachisaa dha!","poem":2},{"text":"Sababii humni kee guddaa taʼeef,","poem":1},{"text":"diinonni kee fuula kee duratti hollatu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lafti hundinuu siif sagadu;","poem":1},{"text":"faarfannaa galataa siif faarfatu;","poem":2},{"lineBreak":true},{"text":"maqaa keetiifis faarfatu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kottaatii waan Waaqni hojjete,","poem":1},{"text":"hojii sodaachiisaa inni namaaf hojjete ilaalaa!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inni galaana lafa gogaatti geeddare;","poem":1},{"text":"isaanis miilla isaaniitiin laga ceʼan;","poem":2},{"lineBreak":true},{"text":"kottaa isatti haa gammannu!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni bara baraan humna isaatiin bulcha;","poem":1},{"text":"iji isaas saboota ilaala;","poem":2},{"lineBreak":true},{"text":"finciltoonni ol ol of hin qabin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yaa saboota, Waaqa keenya eebbisaa;","poem":1},{"text":"sagaleen isa galateeffatus haa dhagaʼamu;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"inni lubbuu keenya jiraachiseera;","poem":1},{"text":"miilla keenyas mucucaachuu oolcheera.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yaa Waaqayyo, ati nu qorteertaatii;","poem":1},{"text":"akkuma meetiis nu qulqulleessiteerta.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ati kiyyootti nu galchiteerta;","poem":1},{"text":"dugda keenya irras baʼaa keesseerta.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Akka namoonni mataa keenya yaabbatan gooteerta;","poem":1},{"text":"nu ibiddaa fi bishaan keessa dabarre;","poem":2},{"lineBreak":true},{"text":"ati garuu iddoo badhaadhummaatti nu fidde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Anis qalma gubamu qabadheemana qulqullummaa kee nan seena;","poem":1},{"text":"wareega koos siif nan galcha;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"kunis wareega yeroo ani rakkina keessa turetti","poem":1},{"text":"arrabni koo waadaa galee afaan koos dubbatee dha.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Anis horii coccoomoo, qalma gubamu,","poem":1},{"text":"korbeeyyii hoolaa immoo aarsaa godhee siif nan dhiʼeessa;","poem":2},{"lineBreak":true},{"text":"jibootaa fi reʼoota illee aarsaa siifin dhiʼeessa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Isin warri Waaqa sodaattan hundi kottaa dhaggeeffadhaa;","poem":1},{"text":"anis waan inni naaf godhe isinitti nan hima.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ani afaan kootiin isatti nan iyye;","poem":1},{"text":"galanni isaas arraba koo irra ture.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Utuu ani garaa koo keessa cubbuu kaaʼadhee jiraadhee,","poem":1},{"text":"silaa Gooftaan naaf hin dhagaʼu ture;","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Waaqni garuu dhugumaan na dhaggeeffateera;","poem":1},{"text":"sagalee kadhannaa kootiis dhagaʼeera.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Waaqni kadhannaa koo hin didin","poem":1},{"text":"yookaan jaalala isaa na hin dhowwatin haa eebbifamu!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}