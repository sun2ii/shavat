{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":69,"content":[{"type":"hebrew_subtitle","content":["Dura buʼaa faarfattootaatiif. Yeedaloo “Daraaraatiin.” Faarfannaa Daawit."]},{"type":"verse","number":1,"content":[{"text":"Yaa Waaqi, ati na baasi;","poem":1},{"text":"bishaan ol dhufee morma na gaʼeeraatii.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ani raaree keessa, lafa iddoon miilla dhaabatan","poem":1},{"text":"hin jirre keessa seeneera.","poem":2},{"text":"Ani tuujuba bishaanii keessa seeneera;","poem":1},{"text":"lolaanis narra garagaleera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ani iyyuudhaan dadhabeera;","poem":1},{"text":"laagaan koo babbaqaqeera;","poem":2},{"lineBreak":true},{"text":"iji koo, Waaqa koo eeggachuudhaan dadhabeera.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Warri lafumaa kaʼanii na jibban","poem":1},{"text":"rifeensa mataa kootii caalaa baayʼatu;","poem":2},{"text":"warri na ajjeesuu barbaadan,","poem":1},{"text":"warri akkasumaan diina koo taʼan baayʼee dha.","poem":2},{"text":"Ani akkan waan hin hatin","poem":1},{"text":"deebisu dirqameera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yaa Waaqi, ati gowwummaa koo ni beekta;","poem":1},{"text":"yakki koos si duraa hin dhokatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yaa Gooftaa, Waaqayyo Waan Hunda Dandeessu,","poem":1},{"text":"warri abdii sirra kaaʼatan,","poem":2},{"lineBreak":true},{"text":"sababii kootiif hin qaanaʼin;","poem":2},{"text":"yaa Waaqa Israaʼel, warri si barbaadan,","poem":1},{"text":"sababii kootiif hin qaaneffamin.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ani siif jedhee tuffii obseeraatii;","poem":1},{"text":"qaaniinis fuula koo haguugeera.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ani obboloota kootti keessummaa,","poem":1},{"text":"ilmaan haadha kootiittis alagaa dha;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hinaaffaan mana keetii na guggubeeraatii;","poem":1},{"text":"arrabsoon warra si arrabsaniis narra buʼeera.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Booʼuu fi soomuun koo,","poem":1},{"text":"arrabsoo natti taʼe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yommuu ani wayyaa gaddaa uffadhetti,","poem":1},{"text":"namoonni natti qoosu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Warri karra dura tataaʼan natti qoosu;","poem":1},{"text":"machooftonnis waaʼee kootiin sirbu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ani garuu yaa Waaqayyo,","poem":1},{"text":"yeroo ati filattutti sin kadhadha;","poem":2},{"text":"yaa Waaqi, jaalala kee guddichaan","poem":1},{"text":"fayyina kee kan dhugaatiinis deebii naaf kenni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Akka ani hin liqimfamneef,","poem":1},{"text":"raaree keessaa na baasi;","poem":2},{"text":"warra na jibban jalaa,","poem":1},{"text":"bishaanota gad fagoo keessaas na baasi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ati akka lolaan na hin fudhanne,","poem":1},{"text":"akka tuujubni na hin liqimsine,","poem":2},{"lineBreak":true},{"text":"akka boollis afaan isaa natti hin cufanne godhi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yaa Waaqayyo, gaarummaa jaalala keetiitiindeebii naaf kenni;","poem":1},{"text":"araara kee guddichaanis natti garagali.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Fuula kee tajaajilaa kee duraa hin dhokfatin;","poem":1},{"text":"waan ani rakkina keessa jiruuf dafiitii deebii naaf kenni.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Natti dhiʼaadhuutii na furi;","poem":1},{"text":"xiiqii diinota kootiif jedhii na baasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ati akka ani hammam tuffatamee,","poem":1},{"text":"salphifamee fi akka ani qaaneffame ni beekta;","poem":2},{"lineBreak":true},{"text":"diinonni koo hundinuus fuula koo dura jiru.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Arrabsoon garaa koo cabse;","poem":1},{"text":"anis abdii kutadheera.","poem":2},{"text":"Ani nama garaa naaf laafu nan barbaade; garuu nan dhabe;","poem":1},{"text":"nama na jajjabeessus nan barbaade;garuu tokko illee hin arganne.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nyaata kootti hadhooftuu makan;","poem":1},{"text":"akka ani dhuguuf immoo waan dhangaggaaʼaa naa kennan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Maaddiin isaanii iddaa isaanitti haa taʼu;","poem":1},{"text":"adabaa fi kiyyoo isaanitti haa taʼu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Akka arguu hin dandeenyeef iji isaanii haa haguuggamu;","poem":1},{"text":"dugdi isaaniis bara baraan haa goophatu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Dheekkamsa kee isaan irratti dhangalaasi;","poem":1},{"text":"aariin kee bobaʼaan sunis isaan irra haa buʼu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Qeʼeen isaanii haa onu;","poem":1},{"text":"namni dunkaana isaanii keessa jiraatu tokko iyyuu hin hafin.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Isaan warra ati madeessite sana ni ariʼatuutii;","poem":1},{"text":"waaʼee dhukkubbii warra ati miite sanaas ni odeessu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Yakka irratti yakka isaanitti dabali;","poem":1},{"text":"isaan gara qajeelumma keetii hin dhufin.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Maqaan isaanii kitaaba jireenyaa keessaa haa haqamu;","poem":1},{"text":"qajeeltota wajjinis hin galmeeffamin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Ani garuu dhiphinaa fi rakkina keessan jira;","poem":1},{"text":"yaa Waaqi, fayyinni kee ol na haa qabu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Ani faarfannaadhaan maqaa Waaqaa nan galateeffadha;","poem":1},{"text":"galataanis ulfina nan kennaaf.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kunis sangaa caalaa, korma gaanfaa fi","poem":1},{"text":"kottee qabu dhiʼeessuu caalaa Waaqayyoon gammachiisa.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Hiyyeeyyiin waan kana arganii ni gammadu;","poem":1},{"text":"isin warri Waaqa barbaaddan garaan keessan jiraata haa taʼu!","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Waaqayyo rakkattoota ni dhagaʼa;","poem":1},{"text":"namoota isaa warra hidhamanis hin tuffatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Samii fi lafti, galaanonnii fi","poem":1},{"text":"wanni isaan keessa jiraatan hundinuu isa haa leellissan.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Waaqni Xiyoonin ni fayyisaatii;","poem":1},{"text":"magaalaawwan Yihuudaas deebisee ni ijaara.","poem":2},{"text":"Sabni isaas achi qubata; ni dhaalas.","poem":1}]},{"type":"verse","number":36,"content":[{"text":"Sanyiin tajaajiltoota isaa magaalattii ni dhaalu;","poem":2},{"lineBreak":true},{"text":"warri maqaa isaa jaallatanis achi jiraatu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}