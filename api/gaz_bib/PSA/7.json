{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":7,"content":[{"type":"hebrew_subtitle","content":["Shiigaayoonni Daawit kan inni waaʼee Kuushi namicha gosa Beniyaamiif jedhee Waaqayyoof faarfate."]},{"type":"verse","number":1,"content":[{"text":"Yaa Waaqayyo Waaqa ko, ani kooluu sitti nan gala;","poem":1},{"text":"warra na ariʼatan hunda jalaa na baasi; na oolchis;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"yoo kanaa achii isaan yeroo namni na oolchu hin jirretti,","poem":1},{"text":"akka leencaa na cicciratu; na kukkutatus.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yaa Waaqayyo Waaqa ko, yoo ani waan kana godhee jiraadhe","poem":1},{"text":"yoo harka koo keessa yakki jiraate,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"yoo ani nama nagaadhaan na wajjin jiraatutti hamaa hojjedhee jiraadhe,","poem":1},{"text":"yookaan yoo ani sababii malee diina koo saamee jiraadhe,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"diinni koo ariʼee na haa qabatu;","poem":1},{"text":"jireenya koo lafatti haa dhidhiitu;","poem":2},{"lineBreak":true},{"text":"ulfina koos awwaara keessa haa buusu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yaa Waaqayyo aarii keetiin kaʼi;","poem":1},{"text":"dheekkamsa diinota kootti kaʼi.","poem":2},{"lineBreak":true},{"text":"Yaa Waaqa koo anaaf dammaqi; murtii qajeelaa labsi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yaaʼiin namootaa naannoo keetti walitti haa qabamu;","poem":1},{"text":"atis ol gubbaadhaa isaan bulchi.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Waaqayyo sabootaaf murtii haa kennu.","poem":2},{"text":"Yaa Waaqayyo, akka qajeelummaa kootiitti,","poem":1},{"text":"akka amanamummaa kootiittis naa murteessi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yaa Waaqa qajeelaa,","poem":1},{"text":"kan yaadaa fi garaa namaa qortu,","poem":2},{"text":"fincila hamootaa balleessi;","poem":1},{"text":"qajeeltota immoo jabeessii dhaabi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Gaachanni koo Waaqa;","poem":1},{"text":"inni gara toleeyyii ni oolcha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Waaqni abbaa murtii qajeelaa dha;","poem":1},{"text":"inni Waaqa guyyaa hunda dheekkamsa isaa mulʼisuu dha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yoo namni qalbii jijjiirrachuu baate,","poem":1},{"text":"inni goraadee isaa ni qarata;","poem":2},{"lineBreak":true},{"text":"iddaa isaas dabsee qopheeffata.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Inni meeshaa nama ajjeesu","poem":1},{"text":"qopheeffateera; xiyya bobaʼus ni qopheeffata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kunoo, namni hamaan hammina ulfaaʼa;","poem":1},{"text":"jalʼina garaatti baata; soba dhala.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Inni gad fageessee boolla qota;","poem":1},{"text":"boolla qopheesse sana keessas ni buʼa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dabni isaa matuma isaatti deebiʼa;","poem":1},{"text":"jalʼinni isaas gubbee mataa isaa irra buʼa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Qajeelummaa isaatiif Waaqayyoon nan galateeffadha;","poem":1},{"text":"maqaa Waaqayyoo Waaqa Waan Hundaa Oliis faarfannaadhaan nan jajadha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}