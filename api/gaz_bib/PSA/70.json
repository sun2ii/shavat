2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ani garuu hiyyeessaa fi rakkataa dha;","poem":1},{"text":"yaa Waaqi, dafii na qaqqabi.","poem":2},{"text":"Ati gargaaraa koo fi fayyisaa koo ti;","poem":1},{"text":"yaa Waaqayyo hin turin.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}