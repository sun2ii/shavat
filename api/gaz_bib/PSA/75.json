{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"hebrew_subtitle","content":["Dura Buʼaa Faarfattootaatiif. Faarfannaa Yeedaloo, “Hin balleessin” jedhuun faarfatame. Faarfannaa Asaaf."]},{"type":"verse","number":1,"content":[{"text":"Yaa Waaqi, nu si galateeffanna;","poem":1},{"text":"sababii Maqaan kee dhiʼoo taʼeef galata siif galchina;","poem":2},{"lineBreak":true},{"text":"namoonni waaʼee dinqii hojii keetii odeessu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ati akkana jetta; “Ani yeroo murteeffame nan filadha;","poem":1},{"text":"kan qajeelummaadhaan muru ana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yommuu laftii fi sabni ishee hundi raafamanitti,","poem":1},{"text":"kan utubaa ishee jabeessee qabu ana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ani of tuultotaan akkana nan jedha; ‘Of hin jajinaa.’","poem":1},{"text":"Hamootaanis, ‘Gaanfa keessan ol hin qabatinaa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gaanfa keessan samiitti hin kaasinaa;","poem":1},{"text":"morma keessan dheereffattanii hin dubbatinaa.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ulfinni baʼa biiftuutii yookaan lixa biiftuutii","poem":1},{"text":"yookaan lafa onaatii hin dhufuutii.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Garuu kan murtii kennu Waaqa;","poem":1},{"text":"inni nama tokko gad buusa; kaan immoo ol baasa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Harka Waaqayyoo keessa,","poem":1},{"text":"xoofoo wayinii urgooftuudhaan walitti makame","poem":2},{"lineBreak":true},{"text":"kan hoomachaan guutame tokkotu jira;","poem":2},{"text":"inni wayinii sana gad naqa;","poem":1},{"text":"hamoonni lafaa hundinuu utuu siicoo isaa illee hin hambisinxuruurfatanii dhugu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ani garuu bara baraan waan kana nan labsa;","poem":1},{"text":"Waaqa Yaaqoobis nan faarfadha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gaanfa hamoota hundaa nan caccabsa;","poem":1},{"text":"gaanfi qajeeltotaa garuu ol ol jedha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}