{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":76,"content":[{"type":"hebrew_subtitle","content":["Dura Buʼaa Faarfattootaatiif. Miʼa Ribuutiin. Faarfannaa Asaaf."]},{"type":"verse","number":1,"content":[{"text":"Yihuudaa keessatti Waaqni beekamaa dha;","poem":1},{"text":"maqaan isaas Israaʼel keessatti guddaa dha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dunkaanni isaa Saalem keessa,","poem":1},{"text":"iddoon jireenya isaa Xiyoon keessa jira.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Innis achitti xiyya bobaʼuu fi gaachana, goraadee fi","poem":1},{"text":"meeshaawwan waraanaa caccabse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ati ifa uffattee miidhagdeerta;","poem":1},{"text":"ati tulluuwwan bara baraa caalaa Surra qabeessa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gootonni boojiʼamaniiru;","poem":1},{"text":"hirribaanis fudhatamaniiru;","poem":2},{"text":"duultota keessaas namni tokko iyyuu","poem":1},{"text":"harka sochoofachuu hin dandeenye.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yaa Waaqa Yaaqoob, ifannaa keetiin fardeenii","poem":1},{"text":"fi warri fardeen yaabbatan of wallaalaniiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Siʼi qofatu sodaatamuu qaba.","poem":1},{"text":"Yommuu ati aartu eenyutu fuula kee dura dhaabachuu dandaʼaa?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ati samii irraa murtii kennite;","poem":1},{"text":"laftis ni sodaatte; ni calʼiftes;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"yaa Waaqi, wanni kunis yommuu ati murtii kennuudhaaf,","poem":1},{"text":"rakkattoota biyyattii fayyisuuf kaatetti taʼe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dheekkamsi ati namatti dheekkamtu dhugumaan ulfina siif fida;","poem":1},{"text":"warra dheekkamsa kee irraa hafanis ni hidhatta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Waaqayyo Waaqa keessaniif wareegaa; wareegichas guuttadhaa;","poem":1},{"text":"warri naannoo isaa jiraatan hundinuus","poem":2},{"lineBreak":true},{"text":"Waaqa sodaatamuu qabu sanaaf kennaawwan haa fidan.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Inni hafuura bulchitootaa ni cabsa;","poem":1},{"text":"mootonni lafaas isa sodaatu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}