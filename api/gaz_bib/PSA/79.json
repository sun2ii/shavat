{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":79,"content":[{"type":"hebrew_subtitle","content":["Faarfannaa Asaaf."]},{"type":"verse","number":1,"content":[{"text":"Yaa Waaqi, namoonni ormaa handhuuraa kee qabataniiru;","poem":1},{"text":"mana qulqullummaa kee qulqullicha xureessaniiru;","poem":2},{"lineBreak":true},{"text":"Yerusaaleminis barbadeessaniiru.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Akka isaan nyaata isaaniif taʼaniif,","poem":1},{"text":"reeffa garboota keetii allaattii samiitiif,","poem":2},{"lineBreak":true},{"text":"foon qulqulloota keetii immoo bineensota lafaatiif kennaniiru.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dhiiga isaaniis naannoo Yerusaalemitti","poem":1},{"text":"akkuma bishaanii dhangalaasan;","poem":2},{"lineBreak":true},{"text":"namni isaan awwaalu tokko illee hin argamne.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ollaa keenya biratti maqaan nu badeera;","poem":1},{"text":"warra naannoo keenya jiran birattis nama tuffii fi kolfaa taane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yaa Waaqayyo, kun hamma yoomiitti?","poem":1},{"text":"Ati hamma bara baraatti aartaa?","poem":2},{"lineBreak":true},{"text":"Hinaaffaan kees hamma yoomiitti akka ibiddaa bobaʼa?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dheekkamsa kee sana saboota si hin beekne irratti,","poem":1},{"text":"mootummoota maqaa kee hin waammanne irrattigad dhangalaasi;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"isaan Yaaqoobin liqimsaniiruutii;","poem":1},{"text":"iddoo jireenya isaas balleessaniiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Cubbuu abbootii keenyaa nutti hin herregin;","poem":1},{"text":"waan nu baayʼee gad deebifamneef,","poem":2},{"lineBreak":true},{"text":"araarri kee dafee nu bira haa gaʼu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yaa Waaqi Fayyisaa keenya,","poem":1},{"text":"ulfina maqaa keetiitiif jedhii nu gargaari;","poem":2},{"text":"maqaa keetiif jedhiitii nu oolchi;","poem":1},{"text":"cubbuu keenya illee nuu dhiisi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ormoonni maaliif,","poem":1},{"text":"“Waaqni isaanii eessa jira?” jedhu ree?","poem":2},{"lineBreak":true},{"text":"Dhiiga tajaajiltoota keetii kan dhangalaafame sanaaf,","poem":1},{"text":"akka haaloo baaftu ija keenya duratti saboota gidduutti beeksisi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Aaduun hidhamtootaa fuula kee dura haa gaʼu;","poem":1},{"text":"jabina irree keetiitiin warra duuti itti murame oolchi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yaa Gooftaa, arraba isaan ittiin si arrabsan,","poem":1},{"text":"dachaa torba godhiitii ollaa keenyatti deebisi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yoos nu sabni kee, hoolonni tika keetii,","poem":1},{"text":"bara baraan si jajanna;","poem":2},{"text":"dhalootaa hamma dhalootaattis,","poem":1},{"text":"galata kee ni odeessina.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}