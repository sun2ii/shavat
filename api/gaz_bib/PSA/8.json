{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"hebrew_subtitle","content":["Dura buʼaa faarfattootaatiif. Faarfannaa Daawit kan Gitiitiidhaan faarfatamu."]},{"type":"verse","number":1,"content":[{"text":"Yaa Waaqayyo Gooftaa keenya,","poem":1},{"text":"maqaan kee lafa hundatti akkam ulfina qabeessa!","poem":2},{"lineBreak":true},{"text":"Ati ulfina kee","poem":1},{"text":"samiiwwan irratti diriirsiteerta.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sababii diinota keetiitiif, amajaajii fi nama haaloo baafatu","poem":1},{"text":"afaan qabachiisuuf jettee, afaan daaʼimmaniitii fi","poem":2},{"lineBreak":true},{"text":"mucoolii harma hodhanii irraa galata qopheessiteerta.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yommuu ani hojii quba keetii,","poem":1},{"text":"samiiwwan kee,","poem":2},{"lineBreak":true},{"text":"jiʼaa fi urjiiwwan ati hundeessitee ilaalutti,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"akka ati isaaf yaadduuf namni maali?","poem":1},{"text":"Akka isaaf dhimmituuf ilmi namaa maali?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ati xinnoo ishee ofii keetii gad isa goote;","poem":1},{"text":"ulfinaa fi kabajaan isa gonfite.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hojii harka keetii irratti bulchaa isa goote;","poem":1},{"text":"waan hundas miilla isaa jala galchite;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"bushaayee fi loon hunda,","poem":1},{"text":"bineensota bosonaas,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"simbirroota samii irraa, qurxummii galaanaa,","poem":1},{"text":"waan daandii galaanaatiin darbu","poem":2},{"lineBreak":true},{"text":"hundas miilla isaa jala galchite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yaa Waaqayyo Gooftaa keenya,","poem":1},{"text":"maqaan kee lafa hundumaa irratti akkam ulfina qabeessa!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}