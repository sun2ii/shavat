{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["Faarfannaa Asaaf."]},{"type":"verse","number":1,"content":[{"text":"Waaqni, waldaa waaqotaa gidduu dhaabata;","poem":1},{"text":"“waaqota” gidduuttis murtii kenna; akkanas jedha:","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Isin hamma yoomiitti seera jalʼiftu?","poem":1},{"text":"Hamma yoomiittis jalʼootaaf dhaabattu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dadhabdootaa fi ijoollee abbaa hin qabneef murtii qajeelaa kennaa;","poem":1},{"text":"mirga hiyyeeyyiitii fi cunqurfamtootaas eegsisaa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Warra dadhabaa fi rakkattoota baraaraa;","poem":1},{"text":"harka jalʼootaatiis isaan baasaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Isaan homaa hin beekan; homaa illee hin hubatan.","poem":1},{"text":"Isaan dukkana keessa jiraatu;","poem":2},{"lineBreak":true},{"text":"hundeen lafaa hundinuu ni raafame.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Anis, ‘Isin, “waaqota;”","poem":1},{"text":"hundi keessan ilmaan Waaqa Waan Hundaa Olii ti’ jedheera.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Taʼus isin akkuma namatti ni duutu;","poem":1},{"text":"akkuma bulchitoota kamii iyyuu ni kuftu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yaa Waaqi kaʼi; lafatti muri;","poem":1},{"text":"sabni hundinuu kan keetiitii.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}