{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":83,"content":[{"type":"hebrew_subtitle","content":["Faarfannaa Asaaf."]},{"type":"verse","number":1,"content":[{"text":"Yaa Waaqi gab hin jedhin;","poem":1},{"text":"yaa Waaqi, hin calʼisin;","poem":2},{"lineBreak":true},{"text":"akkasumattis hin dhiisin.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Diinonni kee akkam akka kakaʼan,","poem":1},{"text":"warri si jibbanis akkam akka mataa ol qabatan ilaali.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isaan saba keetti daba karoorfatu;","poem":1},{"text":"warra ati eegdutti mariʼatu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isaanis, “Kottaa akka maqaan Israaʼel lammata hin yaadatamneef,","poem":1},{"text":"akka isaan saba hin taaneef isaan barbadeessinaa” jedhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Isaan yaada tokkoon walii galu;","poem":1},{"text":"sittis ni gurmaaʼu;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"isaanis dunkaanota Edoom, Ishmaaʼeeloota,","poem":1},{"text":"Moʼaabii fi gosa Aggaar,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gebaal, Amoonii fi Amaaleq,","poem":1},{"text":"Filisxeemii fi namoota biyya Xiiroos wajjin turan.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Warri Asooriis, ilmaan Looxiitiif irree jabaa","poem":1},{"text":"taʼuudhaaf isaanitti makaman.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ati akkuma Midiyaanin goote,","poem":1},{"text":"akkuma laga Qiishooniitti Siisaaraa fi Yaabiinin goote sana isaan godhi;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"isaan Eendooritti dhumanii","poem":1},{"text":"akkuma kosii lafaa taʼan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gurguddoota isaanii akka Hereebiitii fi Zeʼeeb,","poem":1},{"text":"ilmaan mootota isaanii immoo akka Zebaa fi Zalmunaa godhi;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"isaan warra, “Kottaa, lafa tika Waaqaa fudhannee","poem":1},{"text":"kan dhuunfaa keenyaa godhannaa” jedhanii dha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yaa Waaqa ko, akka awwaara bubbeen fudhatuu,","poem":1},{"text":"akka habaqii qilleensi bittinneessuu isaan godhi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Akkuma ibiddi bosona balleessu,","poem":1},{"text":"yookaan akkuma arrabni ibiddaa tulluuwwan gubu,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"atis akkasuma aarii keetiin isaan gugsi;","poem":1},{"text":"bubbee keetiin isaan sodaachisi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yaa Waaqayyo, akka isaan maqaa kee barbaaddataniif,","poem":1},{"text":"fuula isaanii qaaniin haguugi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Isaan yeroo hunda qaanaʼanii haa dhiphatan;","poem":1},{"text":"salphinaanis haa badan.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Isaan akka ati kan maqaan kee Waaqayyo taʼe sun qofti,","poem":1},{"text":"lafa hundumaa irratti Waaqa Waan Hundaa Olii taate haa beekan.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}