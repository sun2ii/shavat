{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["Faarfannaa Ilmaan Qooraahi."]},{"type":"verse","number":1,"content":[{"text":"Hundeen magaalaa isaa tulluu qulqulluu irra jira.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Waaqayyo iddoo jireenya Yaaqoob hunda caalaa,","poem":1},{"text":"karrawwan Xiyoon jaallata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yaa magaalaa Waaqaa,","poem":1},{"text":"waaʼee keetiif wanni kabajamaan akkana jedhamee ni dubbatama:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Ani Raʼaabii fi Baabilonin","poem":1},{"text":"warra na beekan gidduutti maqaa nan dhaʼa;","poem":2},{"text":"kunoo, Filisxeemii fi Xiiroos Itoophiyaa wajjin,","poem":1},{"text":"‘Namichi kun achitti dhalate’ jedhu.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dhugumaan waaʼee Xiyoon,","poem":1},{"text":"“Inni kunii fi inni sun ishee keessatti dhalatan;","poem":2},{"lineBreak":true},{"text":"Waaqni Waan Hunda Olii mataan isaa iyyuu ishee dhaaba” jedhama.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Waaqayyo yeroo saboota galmeessutti,","poem":1},{"text":"“Namichi kun achitti dhalate” jedhee barreessa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Warri faarfatanii fi warri meeshaa muuziiqaa taphatan,","poem":1},{"text":"“Burqaan koo hundi si keessatti argama” jedhu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}