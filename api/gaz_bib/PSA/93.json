{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"Waaqayyo ni moʼa; surraas ni uffata;","poem":1},{"text":"Waaqayyo surra ni uffata; jabinas hidhata.","poem":2},{"lineBreak":true},{"text":"Addunyaan cimtee dhaabamteerti; hin sochoofamtus.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Teessoon kee durumaa jalqabee cimee dhaabateera;","poem":1},{"text":"ati durii duriitii jalqabdee jirta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yaa Waaqayyo, galaanonni ol kaasaniiru;","poem":1},{"text":"galaanonni sagalee isaanii ol kaafataniiru;","poem":2},{"lineBreak":true},{"text":"galaanonni huursuu isaanii ol kaafataniiru.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sagalee bishaan baayʼee caalaa,","poem":1},{"text":"jabina dhaʼaa galaanaa caalaas,","poem":2},{"lineBreak":true},{"text":"Waaqayyo ol gubbaa jiru sun humna qabeessa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Seerri kee jabaatee ni dhaabata;","poem":1},{"text":"Yaa Waaqayyo, qulqullummaan bara baraan","poem":2},{"lineBreak":true},{"text":"faaya mana keetii ti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}