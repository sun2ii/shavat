{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"Waaqayyo moʼeera; lafti haa gammaddu;","poem":1},{"text":"biyyoonni qarqara galaanaa hedduunis haa ililchan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Duumessaa fi dukkanni limixiin isa marsaniiru;","poem":1},{"text":"qajeelummaa fi murtii qajeelaan hundee teessoo isaa ti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ibiddi fuula isaa dura deemee","poem":1},{"text":"diinota isaa naannoo isaatii fixa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Balaqqeen isaa addunyaa ibsa;","poem":1},{"text":"laftis argitee hollatti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tulluuwwan fuula Waaqayyoo duratti,","poem":1},{"text":"fuula Gooftaa lafa hundumaa durattis akkuma gagaa baqu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Samiiwwan qajeelummaa isaa labsu;","poem":1},{"text":"saboonni hundinuus ulfina isaa argu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Warri fakkii waaqeffatan,","poem":1},{"text":"kanneen waaqota tolfamoon of jajan hundi haa qaaneffaman;","poem":2},{"lineBreak":true},{"text":"isin waaqonni hundinuus isa waaqeffadhaa!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yaa Waaqayyo, sababii murtii keetiitiif,","poem":1},{"text":"Xiyoon dhageessee ililchiti;","poem":2},{"lineBreak":true},{"text":"gandoonni Yihuudaas ni gammadu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yaa Waaqayyo, ati lafa hundumaa irratti Waaqa Waan Hundaa Olii ti;","poem":1},{"text":"ati waaqota hundumaa irra akka malee ol ol jetteerta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Sababii inni lubbuu amanamoota isaa eegee,","poem":1},{"text":"harka hamootaa jalaa isaan baasuuf,","poem":2},{"lineBreak":true},{"text":"warri Waaqayyoon jaallatan hammina haa jibban.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Qajeeltota irratti ifni ni ifa;","poem":1},{"text":"gara tolootaafis gammachuun ni dhufa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Isin qajeeltonni Waaqayyotti gammadaa;","poem":1},{"text":"maqaa isaa qulqulluus galateeffadhaa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}