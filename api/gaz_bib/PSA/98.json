{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"hebrew_subtitle","content":["Faarfannaa."]},{"type":"verse","number":1,"content":[{"text":"Waaqayyoof faarfannaa haaraa faarfadhaa;","poem":1},{"text":"inni dinqii hojjeteeratii;","poem":2},{"text":"harki isaa inni mirgaatii fi irreen isaa qulqulluun,","poem":1},{"text":"akka inni moʼannaa argatu godhaniiru.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Waaqayyo akka fayyisuun isaa beekamu godheera;","poem":1},{"text":"qajeelummaa isaas sabootatti mulʼiseera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inni jaalala isaatii fi amanamummaa isaa","poem":1},{"text":"mana Israaʼeliif yaadateera;","poem":2},{"text":"daariin lafaa hundinuu,","poem":1},{"text":"fayyisuu Waaqa keenyaa arganiiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lafti hundinuu Waaqayyoof ililchaa;","poem":1},{"text":"faarfannaa gammachuutiin iyyaa; weedduu galataas weeddisaa;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"baganaadhaan faarfannaa galataa,","poem":1},{"text":"baganaa fi sagalee weedduutiin Waaqayyoof faarfadhaa;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"malakataa fi sagalee gaanfaatiin,","poem":1},{"text":"fuula Waaqayyo mootichaa duratti ililchaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Galaannii fi wanni isa keessa jiru hundinuu,","poem":1},{"text":"addunyaa fi wanti ishee keessa jiraatu hundinuu haa huursan.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lageen harka isaanii haa rurrukutan;","poem":1},{"text":"tulluuwwanis tokkummaadhaan haa ililchan;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"isaan fuula Waaqayyoo duratti haa faarfatan;","poem":1},{"text":"inni lafatti murteessuu ni dhufaatii.","poem":2},{"text":"Inni addunyaaf qajeelummaadhaan,","poem":1},{"text":"namootaaf immoo utuu wal hin caalchisin murtii kenna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}