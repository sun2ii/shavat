{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_bib","name":"Faarfannaa","commonName":"Faarfannaa","title":"Kitaabota Faarfannaa","order":19,"numberOfChapters":150,"sha256":"c7ff03a44af1aed7fc36bdde5cb782866f11edecd137c8ee25a2b9318432946d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"Waaqayyo moʼeera;","poem":1},{"text":"saboonni haa hollatan;","poem":2},{"text":"inni kiirubeel gidduu, teessoo isaa irra taaʼa;","poem":1},{"text":"lafti haa raafamtu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Waaqayyo Xiyoon keessatti guddaa dha;","poem":1},{"text":"inni saboota hunda irra ol ol jedheera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isaan maqaa kee guddichaa fi sodaachisaa sana haa jajan;","poem":1},{"text":"inni qulqulluu dha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mootichi humna qabeessa; inni murtii qajeelaa jaallata;","poem":1},{"text":"ati tola hundeessiteerta;","poem":2},{"text":"Yaaqoob keessattis haqaa fi","poem":1},{"text":"qajeelummaa hojjetteerta.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Waaqayyo Waaqa keenya leellisaa;","poem":1},{"text":"ejjeta miilla isaa jalatti sagadaa;","poem":2},{"lineBreak":true},{"text":"inni qulqulluu dha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Musee fi Aroon luboota isaa keessa turan;","poem":1},{"text":"Saamuʼeelis warra maqaa isaa waammatan keessa ture;","poem":2},{"text":"isaan Waaqayyoon waammatan;","poem":1},{"text":"innis deebii kenneef.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inni utubaa duumessaa keessaa isaanitti dubbate;","poem":1},{"text":"isaanis sirna isaatii fi seera inni isaaniif kenne eegan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yaa Waaqayyo Waaqa keenya,","poem":1},{"text":"ati deebii isaanii kennite;","poem":2},{"text":"ati balleessaa isaanii adabdu illee,","poem":1},{"text":"Israaʼeliif Waaqa dhiifama gootu turte.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Waaqa keenya Waaqayyoon leellisaa;","poem":1},{"text":"tulluu isaa qulqulluu irrattis waaqeffadhaa;","poem":2},{"lineBreak":true},{"text":"Waaqayyo Waaqni keenya Waaqa qulqulluudhaatii.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}