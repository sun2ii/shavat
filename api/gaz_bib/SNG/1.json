{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"SNG","translationId":"gaz_bib","name":"Weedduu","commonName":"Weedduu","title":"Weedduu Weeddotaa","order":22,"numberOfChapters":8,"sha256":"031a673eda98844c66842d41e8c3f02ebe9ced2461369b1a360d047b90a23c4f","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gaz_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Weedduu Weeddotaa Solomoon."]},{"type":"verse","number":2,"content":[{"text":"Inni dhungoo afaan isaatiin na haa dhungatu;","poem":1},{"text":"jaalalli kee daadhii wayinii caalaatii.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Urgaan shittoo keetii namatti tola;","poem":1},{"text":"maqaan kee akkuma shittoo dhangalaafamee ti.","poem":2},{"lineBreak":true},{"text":"Kanaafuu dubarran si jaallatu!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Na fudhadhuu deemi; si duukaa fiignaa!","poem":1},{"text":"Mootichi diinqa isaatti ol na galfate.","poem":2},"Michoota",{"text":"Nu sitti gammannee ililchina;","poem":1},{"text":"jaalala kees daadhii wayinii caalaa jajanna.","poem":2},"Ishee",{"text":"Si jaallachuun isaanii akkam sirrii dha!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Intallan Yerusaalem,","poem":1},{"text":"ani akkuma dunkaana Qeedaar,","poem":2},{"text":"akkuma golgaa dunkaana Solomoonis gurraattii dha;","poem":1},{"text":"garuu bareedduu dha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sababii ani gurraattii taʼeef, ija babaaftee na hin ilaalin;","poem":1},{"text":"aduutu na gurraachesseetii.","poem":2},{"text":"Ilmaan haadha koo natti aaranii","poem":1},{"text":"akka ani iddoo dhaabaa wayinii eegu na taasisan;","poem":2},{"lineBreak":true},{"text":"ani garuu iddoo dhaabaa wayinii koo hin eegganne.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yaa isa ani si jaalladhu,","poem":1},{"text":"iddoo bushaayee kee tikfattuu fi","poem":2},{"lineBreak":true},{"text":"iddoo itti guyyaa saafaa hoolota kee boqochiifattu natti himi.","poem":2},{"text":"Ani maaliifan akka dubartii fuula ishee haguugattee","poem":1},{"text":"bushaayee michoota keetii bira asii fi achi joortu tokkoo taʼa?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yaa dubartii dubartoota hunda caalaa bareeddu,","poem":1},{"text":"ati yoo beekuu baatte hoolota duukaa buʼi;","poem":2},{"text":"ilmoolee reʼoota keetiis","poem":1},{"text":"dunkaana tiksootaa bira tikfadhu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yaa jaalallee ko, ani akka farda dhalaa","poem":1},{"text":"fardeen gaarii Faraʼoon harkisan keessaa tokkootti sin ilaala.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Maddiin kee amartii gurraatiin,","poem":1},{"text":"mormii kees dirata warqeetiin miidhagfameera.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nu warqee gurraa","poem":1},{"text":"meetiidhaan wal make siif tolchina.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Utuma mootichi maaddiitti dhiʼaatee jiruu","poem":1},{"text":"shittoon koo urgaa isaa kenne.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Michuun koo anaaf korojoo qumbii ti;","poem":1},{"text":"inni guntuta koo gidduu boqota.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Michuun koo anaaf hurbuu daraaraa heennaa","poem":1},{"text":"kan iddoo dhaabaa wayinii Een Gaadiitii dhufee dha.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yaa jaalallee ko, ati akkam bareedda!","poem":1},{"text":"Dinqii akkam bareedda!","poem":2},{"lineBreak":true},{"text":"Iji kee gugee fakkaata.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yaa michuu ko, ati akkam miidhagda!","poem":1},{"text":"Dinqii akkam namatti tolta!","poem":2},{"lineBreak":true},{"text":"Margi lalisaan siree keenya.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dareersumaan mana keenyaa birbirsa;","poem":1},{"text":"dagaleen isaa immoo gaattiraa dha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}