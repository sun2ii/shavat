{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"SNG","translationId":"gaz_bib","name":"Weedduu","commonName":"Weedduu","title":"Weedduu Weeddotaa","order":22,"numberOfChapters":8,"sha256":"031a673eda98844c66842d41e8c3f02ebe9ced2461369b1a360d047b90a23c4f","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gaz_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Ani daraaraa Shaaroon;","poem":1},{"text":"daraaraa sulula keessaa ti.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jaalalleen koo dubarran kaan gidduu ti","poem":1},{"text":"akkuma daraaraa qoraattii keessaa ti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Michuun koo dargaggoota gidduutti","poem":1},{"text":"akkuma muka hudhaa kan mukkeen bosonaa keessa jiruu ti.","poem":2},{"text":"Ani gaaddisa isaa jala taaʼuu nan jaalladha;","poem":1},{"text":"iji isaas natti miʼaawa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inni galma cidhaatti na geesse;","poem":1},{"text":"akeekni inni naaf qabu jaalala.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sababii ani jaalalaan gaggabeef","poem":1},{"text":"isin bixxillee wayiniitiin na jajjabeessaa;","poem":2},{"lineBreak":true},{"text":"muka hudhaatiinis na haaromsaa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Harki isaa bitaa mataa koo jala jira;","poem":1},{"text":"harki isaa mirgaa immoo na hammata.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yaa intallan Yerusaalem,","poem":1},{"text":"ani kuruphee fi borofaan isin kakachiisa;","poem":2},{"text":"hamma isheen ofumaan feetee kaatutti","poem":1},{"text":"jaalala hin tuttuqinaa yookaan hin dadammaqsinaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Sagaleen michuu kootii, tulluuwwan irra utaalee","poem":1},{"text":"gaarran irras qaariʼee dhufaa jira.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Michuun koo akkuma kuruphee yookaan korma gadamsaa ti.","poem":1},{"text":"Kunoo inni dallaa keenya duuba dhaabatee","poem":2},{"text":"foddaa keessaan ilaalaa","poem":1},{"text":"qaawwa keessaanis mimilʼachaa jira.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Michuun koo dubbatee akkana naan jedhe;","poem":1},{"text":"“Yaa miidhagduu koo kaʼi!","poem":2},{"lineBreak":true},{"text":"Bareedduu koo kottuu na wajjin deemi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kunoo! Ganni darbeera;","poem":1},{"text":"bokkaanis caamee sokkeera.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Daraaraan lafa irratti mulʼateera;","poem":1},{"text":"waqtiin sirbaa gaʼeera;","poem":2},{"text":"wacni gugees","poem":1},{"text":"biyya keenya keessatti dhagaʼamaa jira.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mukni harbuu ija jalqabaa baasuu jalqabeera;","poem":1},{"text":"wayiniin daraares urgaa kenneera.","poem":2},{"text":"Yaa miidhagduu ko, kaʼii kottu;","poem":1},{"text":"yaa bareedduu koo na wajjin deemi.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Gugee koo kan holqa dhagaa keessaa,","poem":1},{"text":"kan iddoo dhoksaa tulluu cinaa keessaa,","poem":2},{"text":"mee fuula kee na argisiisi;","poem":1},{"text":"mee sagalee kee na dhageessisi;","poem":2},{"text":"sagaleen kee miʼaawaadhaatii;","poem":1},{"text":"fuulli kees namatti tola.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mee waangoo,","poem":1},{"text":"waangoodhuma xixinnoo ishee","poem":2},{"text":"kanneen iddoo dhaabaa wayinii balleessitu nuuf qabaa;","poem":1},{"text":"iddoon dhaabaa wayinii keenyaa daraaraa jiraatii.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Michuun koo kanuma koo ti; anis kan isaa ti;","poem":1},{"text":"inni daraaraa keessa dheechifata.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yaa michuu ko,","poem":1},{"text":"hamma bariʼee gaaddisni baddutti deebiʼi;","poem":2},{"text":"akkuma kuruphee yookaan akkuma korma gadamsaa","poem":1},{"text":"kan tulluuwwan irra jiruus taʼi.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}