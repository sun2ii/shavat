{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"SNG","translationId":"gaz_bib","name":"Weedduu","commonName":"Weedduu","title":"Weedduu Weeddotaa","order":22,"numberOfChapters":8,"sha256":"031a673eda98844c66842d41e8c3f02ebe9ced2461369b1a360d047b90a23c4f","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gaz_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Yaa ishee dubartoota hunda caalaa bareeddu,","poem":1},{"text":"michuun kee eessa dhaqe?","poem":2},{"text":"Akka nu si wajjin barbaannuuf","poem":1},{"text":"michuun kee garamitti gore?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Michuun koo iddoo biqiltuu keessa","poem":1},{"text":"hoolota isaa tikfachuu fi","poem":2},{"text":"daraaraa walitti qabachuuf jedhee gara iddoo biqiltuu,","poem":1},{"text":"lafa madabiin biqiltuu urgooftuuwwanii jirutti gad buʼeera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ani kan michuu koo ti; michuun koos kanuma koo ti;","poem":1},{"text":"inni daraaraa keessa dheechifata.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yaa jaalallee ko, ati akkuma Tiirzaa bareedduu dha;","poem":1},{"text":"akkuma Yerusaalem namatti tolta;","poem":2},{"lineBreak":true},{"text":"akkuma loltoota faajjii baataniis ulfina qabda.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ija kee narraa buqqisi;","poem":1},{"text":"inni na jeeqeeraatii.","poem":2},{"text":"Rifeensi mataa keetii akkuma karra reʼoota","poem":1},{"text":"Giliʼaad irraa gad buʼanii ti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ilkaan kee akkuma karra hoolotaa","poem":1},{"text":"kan dhiqamee ol dhufaa jiruu ti.","poem":2},{"text":"Tokkoon tokkoon isaanii lakkuu qabu;","poem":1},{"text":"isaan keessa maseenni tokko iyyuu hin jiru.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Maddiin kee lamaan haguuggii kee keessatti","poem":1},{"text":"roomaanii tokkicha iddoo lamatti qoodame fakkaata.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mootittiiwwan jaatamni,saajjatoon saddeettamnii fi","poem":1},{"text":"dubarran lakkoobsa hin qabne qulqulluunjiraachuu dandaʼu;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"gugeen koo kan mudaa tokko iyyuu hin qabne sun kan addaa ti;","poem":1},{"text":"isheen haadha isheetiif intala tokkittii dha;","poem":2},{"lineBreak":true},{"text":"haadha ishee deesseefis filatamtuu dha.","poem":2},{"text":"Dubarran ishee arganii ishee eebbisan;","poem":1},{"text":"mootittiiwwanii fi saajjatoowwanis ishee jajan.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kan akka boruu baqaquutti mulʼattu,","poem":1},{"text":"kan akka jiʼaa bareeddu, kan akka biiftuu iftu,","poem":2},{"lineBreak":true},{"text":"kan akka urjiiwwan tooraan yaaʼanii ulfina qabdu kun eenyu?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Anis daraaraa sulula keessatti dhiʼoo biqile arguuf,","poem":1},{"text":"akka wayiniin hudhaa baase","poem":2},{"text":"yookaan akka roomaaniin daraare ilaaluuf","poem":1},{"text":"gara lafa qotiisaa ocholooniitti gad nan buʼe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Utuu ani hin hubatin,","poem":1},{"text":"lubbuun koo gaarii mootii saba kootii keessa na teessiste.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yaa Sulaamaaxittii deebiʼi; deebiʼi;","poem":1},{"text":"akka nu si ilaalluuf deebiʼi; deebiʼi!","poem":2},"Isa",{"text":"Isin akkuma nama sirba Mahanayiim ilaaluutti","poem":1},{"text":"maaliif Sulaamaaxittii ilaaltu?","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}