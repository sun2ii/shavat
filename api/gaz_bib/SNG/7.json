{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"SNG","translationId":"gaz_bib","name":"Weedduu","commonName":"Weedduu","title":"Weedduu Weeddotaa","order":22,"numberOfChapters":8,"sha256":"031a673eda98844c66842d41e8c3f02ebe9ced2461369b1a360d047b90a23c4f","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gaz_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Yaa intala ilma mootii,","poem":1},{"text":"miilli kee kophee keessatti akkam bareeda!","poem":2},{"text":"Gudeedni kee miidhagaan sun dooqa gatii guddaa","poem":1},{"text":"kan ogeessi hojii harkaa tolche fakkaata.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Handhuurri kee xoofoo geengoo","poem":1},{"text":"kan takkumaa daadhiin wayinii wal makaan keessaahin dhabamin fakkaata.","poem":2},{"text":"Mudhiin kee immoo tuullaa qamadii","poem":1},{"text":"kan daraaraadhaan marfame fakkaata.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Guntunni kee lamaan akkuma ilmoolee kuruphee","poem":1},{"text":"kanneen lakkuu dhalatanii ti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mormi kee gamoo ilka arbaa fakkaata.","poem":1},{"lineBreak":true},{"text":"Iji kee haroo Heshboon","poem":1},{"text":"kan karra Baatrabii biraa fakkaata.","poem":2},{"text":"Funyaan kee gamoo Libaanoon","poem":1},{"text":"kan gara Damaasqoo gad ilaalu fakkaata.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mataan kee akkuma Tulluu Qarmeloos gonfoo siif taʼa.","poem":1},{"text":"Rifeensi mataa keetii afaa mana mootii fakkaata;","poem":2},{"lineBreak":true},{"text":"mootiin dheerina isaatiin qabamee boojiʼama.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yaa jaalallee ati gammachuu kee wajjin","poem":1},{"text":"akkam bareedda; akkamis namatti tolta!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dhaabni kee dhaaba meexxii fakkaata;","poem":1},{"text":"guntunni kees hurbuu ijaa fakkaata.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Anis, “Muka meexxii kana nan yaabbadha;","poem":1},{"text":"ija isaa nan qabadha” nan jedhe.","poem":2},{"text":"Guntunni kee akkuma hurbuu wayinii,","poem":1},{"text":"urgaan hafuura keetii akkuma urgaa hudhaa ti;","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"afaan kees akkuma daadhii wayinii kan akka malee gaarii taʼee ti.","poem":2},"Ishee",{"text":"Daadhiin wayinii suutumaan hidhii fi","poem":1},{"text":"ilkaan irra gad yaaʼee gara michuu koo haa dhaqu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani kan michuu koo ti;","poem":1},{"text":"hawwiin isaas anumaaf.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yaa michuu ko, kottu mee gara baadiyyaa haa deemnu;","poem":1},{"text":"gandoota achii keessa haa bullu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Akka mukni wayinii hudhaa baafate,","poem":1},{"text":"akka daraaraan ija banatee fi","poem":2},{"text":"akka roomaaniin daraare ilaaluuf ganama bariin kaanee","poem":1},{"text":"gara iddoo dhaabaa wayinii haa deemnu;","poem":2},{"lineBreak":true},{"text":"anis achitti jaalala koo siif nan kenna.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hudhaan urgaa isaa gad dhiisa;","poem":1},{"text":"yaa michuu ko, wanni ani siif kuuse,","poem":2},{"text":"haaraa fi moofaanis wanni filatamaan hundi","poem":1},{"text":"balbala keenya dura jira.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}