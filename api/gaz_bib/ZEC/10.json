{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ZEC","translationId":"gaz_bib","name":"Zakkaariyaas","commonName":"Zakkaariyaas","title":"Raajii Zakkaariyaas","order":38,"numberOfChapters":14,"sha256":"ac496242c63e09a9a24ee3b7d8ea215a8fd2b79f69d736f5934650ef4b77ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gaz_bib/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":10,"content":[{"type":"heading","content":["Waaqayyo Yihuudaa ni Kunuunsa"]},{"type":"verse","number":1,"content":[{"text":"Yeroo bokkaa isa booddeetti akka inni bokkaa isiniif kennuufWaaqayyoon kadhadhaa;","poem":1},{"text":"bakakkaa kan ergu Waaqayyoo dha.","poem":2},{"text":"Inni bokkaa lolaʼu nama hundaaf,","poem":1},{"text":"biqiltuu dirree immoo tokkoo tokkoo namaatiif ni kenna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Waaqonni tolfamoon gowwoomsaa dubbatu;","poem":1},{"text":"raajonni mulʼata sobaa argu;","poem":2},{"text":"isaan abjuu sobaa namatti himu;","poem":1},{"text":"waan faayidaa hin qabneen nama jajjabeessu.","poem":2},{"text":"Kanaafuu sabni kun akkuma hoolaa tiksee hin qabnee","poem":1},{"text":"hacuucamee asii fi achi joora.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Aariin koo tiksootatti bobaʼeera;","poem":1},{"text":"ani reʼoota nan adaba;","poem":2},{"text":"Waaqayyo Waan Hunda Dandaʼu","poem":1},{"text":"bushaayee isaa, mana Yihuudaa ni toʼata;","poem":2},{"lineBreak":true},{"text":"lola keessattis akka farda jabaa isaan taasisa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yihuudaa keessaa dhagaan golee,","poem":1},{"text":"isa keessaa qofoon dunkaanaa,","poem":2},{"text":"isa keessaa iddaan lolaa,","poem":1},{"text":"isa keessaa bulchaan hundi ni dhufa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isaan akkuma namoota jajjaboo","poem":1},{"text":"waraana keessatti tokkummaadhaan daandii dhoqqee irra deemu.","poem":2},{"text":"Sababii Waaqayyo isaan wajjin jiruuf","poem":1},{"text":"isaan lolanii abbootii fardeenii qaanessu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Ani mana Yihuudaa nan jajjabeessa;","poem":1},{"text":"mana Yoosefis nan oolcha.","poem":2},{"text":"Ani waanan garaa isaaniif laafuuf","poem":1},{"text":"deebisee isaan nan dhaaba.","poem":2},{"text":"Isaan akkuma waan ani duraanuu","poem":1},{"text":"isaan hin gatinii taʼu;","poem":2},{"text":"ani Waaqayyo Waaqa isaanii ti;","poem":1},{"text":"deebiis isaaniif nan kenna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Efreemonni akkuma namoota jajjaboo taʼu;","poem":1},{"text":"garaan isaaniis akkuma nama daadhii wayiniitiin gammaduu ni gammada.","poem":2},{"text":"Ijoolleen isaanii waan kana arganii ni gammadu;","poem":1},{"text":"garaan isaanii Waaqayyootti ni gammada.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ani siiqsee","poem":1},{"text":"walitti isaan nan qaba.","poem":2},{"text":"Ani dhugumaan isaan nan fura;","poem":1},{"text":"isaan akkuma duraa sana ni baayʼatu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yoo ani saboota gidduutti","poem":1},{"text":"isaan bittinneesse iyyuu isaan biyya fagootti na yaadatu.","poem":2},{"text":"Isaanii fi ijoolleen isaanii lubbuudhaan ni jiraatu;","poem":1},{"text":"ni deebiʼus.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani biyya Gibxiitii deebisee isaan nan fida;","poem":1},{"text":"Asoor keessaas walittin isaan qaba.","poem":2},{"text":"Ani gara Giliʼaadii fi Libaanoonitti isaan nan fida;","poem":1},{"text":"iddoon isaan gaʼus hin argamu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inni galaana rakkinaa keessa darba;","poem":1},{"text":"dhaʼaa galaanaas ni rukuta;","poem":2},{"lineBreak":true},{"text":"tuujubawwan Abbayyaa hundinuu ni gogu.","poem":2},{"text":"Of tuulummaan Asoor gad deebiʼa;","poem":1},{"text":"bokkuun mootummaa Gibxis ni bada.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ani Waaqayyoon isaan nan jabeessa;","poem":1},{"text":"isaanis maqaa isaatiin deddeebiʼu”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ZEC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ZEC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ZEC/9.json","previousChapterAudioLinks":{},"numberOfVerses":12}