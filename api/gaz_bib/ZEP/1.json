{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ZEP","translationId":"gaz_bib","name":"Sefaaniyaa","commonName":"Sefaaniyaa","title":"Raajii Sefaaniyaa","order":36,"numberOfChapters":3,"sha256":"6998a280f7a65a6c4211f85797013f5f06ed26040e0d0e4383e5bdff045c1512","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gaz_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Dubbiin Waaqayyoo kan bara Yosiyaas ilmi Aamoon mootii Yihuudaa ture keessa gara Sefaaniyaa ilma Kuushii, ilma Gedaaliyaas, ilma Amariyaa, ilma Hisqiyaas dhufe kanaa dha:"]},{"type":"line_break"},{"type":"heading","content":["Akeekkachiisa Waaʼee Badiisa Dhufaa Jiruu"]},{"type":"verse","number":2,"content":[{"text":"“Ani fuula lafaa irraa","poem":1},{"text":"waan hunda haxaaʼee nan balleessa”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Ani namaa fi horii haxaaʼee nan balleessa;","poem":1},{"text":"simbirroota samiitii fi qurxummii galaanaa,","poem":2},{"lineBreak":true},{"text":"waaqota tolfamoo namoota hamoo","poem":2},{"lineBreak":true},{"text":"gufachiisan haxaaʼee nan balleessa.”","poem":2},{"lineBreak":true},{"text":"“Ani sanyii namaa lafa irraa nan balleessa”","poem":1},{"text":"jedha Waaqayyo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Ani Yihuudaa fi warra Yerusaalem keessa","poem":1},{"text":"jiraatan hundatti harka koo ol nan fudhadha.","poem":2},{"text":"Ani hambaa Baʼaal hundaa fimaqaa luboota waaqota tolfamoo waaqeffatanii","poem":1},{"text":"iddoo kanaa nan balleessa;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"warra raayyaa samii waaqeffachuuf","poem":1},{"text":"qinaaxxii manaa irratti sagadan,","poem":2},{"text":"warra sagadanii fi Waaqayyoon kakatan,","poem":1},{"text":"warra Moolekiinis kakatan,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"warra Waaqayyoon duukaa buʼuu dhiisanii duubatti deebiʼan,","poem":1},{"text":"warra Waaqayyoon hin barbaanneyookaan gorsa isaa hin gaafanne nan balleessa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Guyyaan Waaqayyoo waan dhiʼaateef","poem":1},{"text":"fuula Waaqayyoo Gooftaa duratti calʼisaa.","poem":2},{"text":"Waaqayyo aarsaa tokko qopheesseera;","poem":1},{"text":"inni warra affeere qulqulleesseera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Guyyaa aarsaa Waaqayyootti","poem":1},{"text":"ani qondaaltota ilmaan mootichaatii fi","poem":2},{"lineBreak":true},{"text":"warra wayyaa ormaa uffatan hunda nan adaba.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ani gaafas warra buusaa irra utaalan,","poem":1},{"text":"kanneen galma waaqota isaanii jeequmsaa fi","poem":2},{"lineBreak":true},{"text":"gowwoomsaadhaan guutan nan adaba.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Waaqayyo akkana jedha;","poem":1},{"text":"“Gaafas Karra Qurxummii irraa iyya,","poem":2},{"text":"Waltajjii Lammaffaa irraa wawwaannaa,","poem":1},{"text":"gaarran irraa immoo","poem":2},{"lineBreak":true},{"text":"sagalee diigama guddaatu dhagaʼama.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isin warri Makteesh keessa jiraattan wawwaadhaa;","poem":1},{"text":"daldaltoonni keessan hundi lafa irraa haxaaʼamu;","poem":2},{"lineBreak":true},{"text":"warri meetii daldalan hundinuus ni barbadaaʼu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ani yeroo sana Yerusaalemin ibsaadhaan nan sakattaʼa;","poem":1},{"text":"warra qananiidhaan jiraatan,","poem":2},{"lineBreak":true},{"text":"kanneen akka daadhii wayinii siicoo irratti hafee taʼan,","poem":2},{"text":"kanneen, ‘Waaqayyo waan tolaas taʼu waan hamaa","poem":1},{"text":"homaa hin godhu’ jedhanii yaadan nan adaba.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Qabeenyi isaanii ni saamama;","poem":1},{"text":"manni isaanii ni ona.","poem":2},{"text":"Isaan mana ijaarratu;","poem":1},{"text":"garuu keessa hin jiraatan;","poem":2},{"text":"isaan biqiltuu wayinii ni dhaabbatu;","poem":1},{"text":"garuu daadhii wayinii hin dhugan.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Guyyaan Waaqayyoo guddichi dhiʼaateera;","poem":1},{"text":"dhiʼaatees dafee dhufaara.","poem":2},{"text":"Dhagaʼaa! Iyyi guyyaa Waaqayyoo hadhaaʼaa dha;","poem":1},{"text":"goonni achitti sagalee ol fudhatee iyya.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Guyyaan sun guyyaa dheekkamsaa,","poem":1},{"text":"guyyaa dhiphinaa fi gaddaa,","poem":2},{"text":"guyyaa rakkinaa fi badiisaa,","poem":3},{"text":"guyyaa dukkanaa fi dimimmisaa,","poem":2},{"text":"guyyaa duumessaa fi dukkana hamaa ni taʼa;","poem":3}]},{"type":"verse","number":16,"content":[{"text":"magaalaawwan dallaa jabaa qabanii fi","poem":2},{"text":"gamoowwan ol dhedheeroo irratti","poem":1},{"text":"guyyaa itti malakata afuufanii fi iyya waraanaa taʼa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Sababii isaan Waaqayyootti cubbuu hojjetaniif,","poem":1},{"text":"ani akka isaan akkuma jaamotaatti deemaniif","poem":2},{"lineBreak":true},{"text":"uummatatti dhiphina nan fida.","poem":2},{"text":"Dhiigni isaanii akkuma awwaaraa,","poem":1},{"text":"miʼi garaa isaaniis akkuma kosii gatama.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Guyyaa dheekkamsa Waaqayyootti","poem":1},{"text":"meetiin isaanii yookaan warqeen isaanii","poem":2},{"lineBreak":true},{"text":"isaan oolchuu hin dandaʼu.”","poem":2},{"lineBreak":true},{"text":"Ibidda hinaaffaa isaatiin","poem":1},{"text":"addunyaan hundi ni barbadoofti;","poem":2},{"text":"warra lafa irra jiraatan hundatti","poem":1},{"text":"inni badiisa tasaa ni fidaatii.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ZEP/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ZEP/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/HAB/3.json","previousChapterAudioLinks":{},"numberOfVerses":18}