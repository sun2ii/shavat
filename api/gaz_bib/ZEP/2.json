{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ZEP","translationId":"gaz_bib","name":"Sefaaniyaa","commonName":"Sefaaniyaa","title":"Raajii Sefaaniyaa","order":36,"numberOfChapters":3,"sha256":"6998a280f7a65a6c4211f85797013f5f06ed26040e0d0e4383e5bdff045c1512","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gaz_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":2,"content":[{"type":"heading","content":["Yihuudaa fi Yerusaalem Saboota waliin itti Murteeffame"]},{"type":"heading","content":["Yihuudaan akka Qalbii Jijjiirratuuf Akeekkachiifame"]},{"type":"verse","number":1,"content":[{"text":"Yaa saba qaanii hin qabne,","poem":1},{"text":"walitti qabamaa; walitti qabamaa;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"utuu yeroon murtaaʼe sun gaʼee","poem":1},{"text":"guyyaan sun akkuma habaqiitti isin hin haxaaʼin,","poem":2},{"text":"utuu aariin Waaqayyoo bobaʼaan sun","poem":1},{"text":"isinitti hin dhufin,","poem":2},{"text":"utuu guyyaan dheekkamsa Waaqayyoo","poem":1},{"text":"isinitti hin dhufin walitti qabamaa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isin garraamonni lafaa","poem":1},{"text":"kanneen waan inni ajaju hojjettan hundiWaaqayyoon barbaaddadhaa.","poem":2},{"text":"Qajeelummaa barbaadaa; gad of qabiisa barbaadaa;","poem":1},{"text":"isin guyyaa dheekkamsa Waaqayyootti","poem":2},{"lineBreak":true},{"text":"ni golbomamtu taʼaatii.","poem":2}]},{"type":"heading","content":["Filisxeemitti"]},{"type":"verse","number":4,"content":[{"text":"Gaazaan duwwaa hafti;","poem":1},{"text":"Ashqaloon immoo ni onti.","poem":2},{"text":"Sabni Ashdood guyyuma Saafaadhaan ariʼamee baʼa;","poem":1},{"text":"Eqroon immoo ni buqqifamti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yaa Kereetota qarqara galaanaa jiraattan,","poem":1},{"text":"isiniif wayyoo;","poem":2},{"text":"yaa Kanaʼaan, biyya Filisxeemotaa,","poem":1},{"text":"dubbiin Waaqayyoo akkana jedhee sitti dhufeera;","poem":2},{"text":"“Ani sin barbadeessa;","poem":1},{"text":"namni tokko iyyuu hin hafu.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Biyyi qarqara galaanaa,","poem":1},{"text":"iddoon Kaliitonni jiraatan,","poem":2},{"lineBreak":true},{"text":"iddoo tiksoonni jiraatanii fi gola bushaayee taʼa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Innis handhuuraa hambaa mana Yihuudaa taʼa;","poem":1},{"text":"isaan achitti lafa dheedaa argatu.","poem":2},{"text":"Isaan galgala galgala","poem":1},{"text":"mana Ashqaloon keessa ciciisu.","poem":2},{"text":"Waaqayyo Waaqni isaanii isaan tiksa;","poem":1},{"text":"boojuu isaaniis ni deebisaaf.","poem":2}]},{"type":"heading","content":["Moʼaabii fi Amoon"]},{"type":"verse","number":8,"content":[{"text":"“Ani arrabsoo Moʼaabii fi","poem":1},{"text":"Qoosaa Amoonotaa,","poem":2},{"text":"warra saba koo arrabsanii fi","poem":1},{"text":"biyya isaanii doorsisan sanaa dhagaʼeera.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kanaafuu akkuma ani dhugumaan jiraataa taʼe sana”","poem":1},{"text":"jedha Waaqayyo Waan Hunda Dandaʼu,","poem":2},{"lineBreak":true},{"text":"Waaqni Israaʼel;","poem":2},{"text":"“Moʼaab dhugumaan akkuma Sodoom,","poem":1},{"text":"Amoononnis akka Gomoraa,","poem":2},{"text":"iddoo aramaatii fi boolla soogiddaa,","poem":1},{"text":"lafa bara baraan one ni taʼu.","poem":2},{"text":"Hambaan uummata kootii isaan saamu;","poem":1},{"text":"warri saba koo keessaa badii jalaa baʼan biyya isaanii ni dhaalu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kun gatii isaan of tuulummaa isaaniitiif argatanii dha;","poem":1},{"text":"isaan saba Waaqayyoo Waan Hunda Dandaʼuu arrabsanii","poem":2},{"lineBreak":true},{"text":"itti qoosaniiruutii.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Waaqayyo yeroo waaqota biyyattii hunda barbadeessutti,","poem":1},{"text":"akka malee isaan sodaachisa.","poem":2},{"text":"Saboonni qarqara galaana hundaa irra jiraatan,","poem":1},{"text":"namni biyya isaa keessa jiraatu hundinuus isa waaqeffata.","poem":2}]},{"type":"heading","content":["Itoophiyaa"]},{"type":"verse","number":12,"content":[{"text":"“Yaa warra Itoophiyaa","poem":1},{"text":"isinis goraadee kootiin ni gorraʼamtu.”","poem":2}]},{"type":"heading","content":["Asoor"]},{"type":"verse","number":13,"content":[{"text":"Inni kaabatti harka ol fudhata;","poem":1},{"text":"Asoorinis ni barbadeessa;","poem":2},{"text":"Nanawwee guutumaan guutuutti ni onsa;","poem":1},{"text":"akkuma gammoojjiitti gogsee hambisa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bushaayee fi loon,","poem":1},{"text":"uumamawwan gosa hundaa achi ciciisu.","poem":2},{"text":"Urunguu fi dhaddeen","poem":1},{"text":"utubaa ishee irra boqotu.","poem":2},{"text":"Sagaleen isaanii foddaawwan keessaan dhagaʼama;","poem":1},{"text":"diigamni balbala isaanii dura jira;","poem":2},{"lineBreak":true},{"text":"demdemoon birbirsaa hundinuu qullaa hafa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kun magaalaa of hin eegganne","poem":1},{"text":"kan garuu nagumaan jiraattuu dha.","poem":2},{"text":"Magaalaan kun,","poem":1},{"text":"“Anuma qofa malee kan biraa na bira hin jiru” ofiin jette.","poem":2},{"text":"Isheen akkam akkas ontee,","poem":1},{"text":"iddoo bineensi bosonaa jiraatu taate!","poem":2},{"text":"Namni ishee bira baʼee darbu hundinuu ni qoosa;","poem":1},{"text":"harka isaas ni raasa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}