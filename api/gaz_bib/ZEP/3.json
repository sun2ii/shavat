{"translation":{"id":"gaz_bib","name":"Kitaaba Qulqulluu, Biblica® Hiikkaa Ammayyaa Banamaa Haaraa, Loqoda Dhiʼaa","website":"https://ebible.org/Scriptures/details.php?id=gaz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaz","licenseNotes":null,"shortName":"BIB","englishName":"New Oromo Contemporary Version","language":"gaz","textDirection":"ltr","sha256":"405c23e27f4733b1fa9e144cc9dfdd3e08a232f1b7668152275850f2c28564d6","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ZEP","translationId":"gaz_bib","name":"Sefaaniyaa","commonName":"Sefaaniyaa","title":"Raajii Sefaaniyaa","order":36,"numberOfChapters":3,"sha256":"6998a280f7a65a6c4211f85797013f5f06ed26040e0d0e4383e5bdff045c1512","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gaz_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["Yerusaalem"]},{"type":"verse","number":1,"content":[{"text":"Magaalaa cunqursitootaa,","poem":1},{"text":"finciltuu fi xurooftuu sanaaf wayyoo!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isheen nama tokkoof iyyuu hin ajajamtu;","poem":1},{"text":"sirreeffama tokko iyyuu hin fudhattu.","poem":2},{"text":"Isheen Waaqayyoon hin amanattu;","poem":1},{"text":"Waaqa isheettis hin dhiʼaattu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Qondaaltonni ishee leenca aaduu dha;","poem":1},{"text":"bulchitoonni ishee yeeyyii galgalaa","poem":2},{"lineBreak":true},{"text":"kanneen waan tokko illee ganamaafhin bulfannee dha.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Raajonni ishee of tuultota;","poem":1},{"text":"isaan namoota hin amanamnee dha.","poem":2},{"text":"Luboonni ishee iddoo qulqulluu","poem":1},{"text":"xureessanii seeras cabsu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Waaqayyo inni ishee keessa jiru qajeelaa dha;","poem":1},{"text":"inni dogoggora tokko illee hin hojjetu.","poem":2},{"text":"Inni ganama ganama murtii qajeelaa kenna;","poem":1},{"text":"guyyaa tokko iyyuu waan kana hojjechuu hin dadhabu;","poem":2},{"lineBreak":true},{"text":"jalʼoonni garuu qaanii tokko iyyuu hin beekan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Ani saboota nan balleessa;","poem":1},{"text":"daʼannoowwan isaanii diigamaniiru.","poem":2},{"text":"Akka namni tokko iyyuu achiin hin dabarreef","poem":1},{"text":"ani daandiiwwan ishee onseera.","poem":2},{"text":"Magaalaawwan isaanii onanii","poem":1},{"text":"nama malee, duwwaa hafu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ani magaalaa sanaan,","poem":1},{"text":"‘Ati dhugumaan na sodaatta;","poem":2},{"lineBreak":true},{"text":"sirreeffamas ni fudhatta!’ nan jedhe.","poem":2},{"text":"Ergasii iddoon jireenya ishee hin badu","poem":1},{"text":"yookaan adabbiin koo hundinuu isheetti hin dhufu.","poem":2},{"text":"Isaan garuu waan hojjetan hunda keessatti","poem":1},{"text":"daba hojjechuutti ciman.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kanaafuu guyyaa ani itti dhugaa baʼu eeggadhu”","poem":1},{"text":"jedha Waaqayyo;","poem":2},{"text":"“Ani sabootaa fi","poem":1},{"text":"mootummoota walitti qabee","poem":2},{"text":"dheekkamsa kootii fi","poem":1},{"text":"aarii koo sodaachisaa sana hunda","poem":2},{"lineBreak":true},{"text":"isaanitti dhangalaasuuf murteesseera.","poem":2},{"text":"Addunyaan guutuun ibidda","poem":1},{"text":"hinaaffaa kootiin gubattee barbadoofti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ergasii ani akka hundi isaaniimaqaa Waaqayyoo waammataniif,","poem":1},{"text":"akka walii galuudhaan isa tajaajilaniifis","poem":2},{"lineBreak":true},{"text":"afaan namootaa nan qulqulleessa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Warri anaaf sagadan,","poem":1},{"text":"intallan koo kanneen bittinnaaʼan","poem":2},{"lineBreak":true},{"text":"lageen Itoophiyaa gamaa kennaa naaf fidu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sababii ani warra of tuulummaa isaaniitti gammadan","poem":1},{"text":"magaalaa kana keessaa baasuuf,","poem":2},{"text":"gaafas yakka ati natti hojjette","poem":1},{"text":"sana hundaaf salphinni sitti hin dhufu.","poem":2},{"text":"Ati lammata gaara koo","poem":1},{"text":"qulqulluu irratti of hin tuultu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ani garuu garraamotaa fi","poem":1},{"text":"gad of qabeeyyii","poem":2},{"text":"kanneen maqaa Waaqayyoo amanatan","poem":1},{"text":"si keessatti nan hambisa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hambaan Israaʼel","poem":1},{"text":"yakka tokko illee hin hojjetan.","poem":2},{"text":"Isaan soba hin dubbatan","poem":1},{"text":"yookaan gowwoomsaan afaan isaanii keessatti hin argamu.","poem":2},{"text":"Isaan nyaatanii boqotu;","poem":1},{"text":"kan isaan sodaachisus hin jiru.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yaa Intala Xiyoon ati faarfadhu;","poem":1},{"text":"yaa Israaʼel sagalee ol fudhadhuu iyyi!","poem":2},{"text":"Yaa Intala Yerusaalem gammadiitii","poem":1},{"text":"garaa kee guutuudhaan ililchi!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Waaqayyo adaba kee sirraa fuudheera;","poem":1},{"text":"inni diinota kee sirraa deebiseera.","poem":2},{"text":"Waaqayyo Mootiin Israaʼel, si wajjin jira;","poem":1},{"text":"ati lammata balaa tokko illee hin sodaattu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Isaan gaafas","poem":1},{"text":"Yerusaalemiin akkana ni jedhu;","poem":2},{"text":"“Yaa Xiyoon hin sodaatin;","poem":1},{"text":"harki kees hin laafin.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Waaqayyo Waaqni kee","poem":1},{"text":"inni si wajjin jiru jabaa dha.","poem":2},{"text":"Inni baayʼee sitti gammada;","poem":1},{"text":"inni jaalala isaatiin si boqochiisa;","poem":2},{"lineBreak":true},{"text":"faarfannaadhaanis sitti gammada.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Ani gadda ati ayyaanota murteeffamaniif gadditu","poem":1},{"text":"sirraa nan fuudha;","poem":2},{"lineBreak":true},{"text":"isaan booʼichaa fi salphina sitti taʼu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ani yeroo sanatti","poem":1},{"text":"warra si cunqursan hunda nan adaba;","poem":2},{"text":"ani okkolaa nan baraara;","poem":1},{"text":"warra gatamanis walitti nan qaba.","poem":2},{"text":"Ani biyya isaan itti qaaneffaman hunda keessatti","poem":1},{"text":"maqaa fi ulfina isaaniifin kennaaf.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ani yeroo sanatti walittin isin qaba;","poem":1},{"text":"yeroo sanatti ani biyya keessanitti isin nan galcha.","poem":2},{"text":"Ani yeroo utuma isin argitanuu","poem":1},{"text":"boojuu keessan deebisutti","poem":2},{"text":"saba lafaa hunda gidduutti","poem":1},{"text":"ulfinaa fi maqaa isiniifin kenna”","poem":2},{"lineBreak":true},{"text":"jedha Waaqayyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_bib/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_bib/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_bib/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}