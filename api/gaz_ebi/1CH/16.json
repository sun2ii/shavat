{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"1CH","translationId":"gaz_ebi","name":"1 ሴና","commonName":"1 ሴና","title":"ክታበ ሴና ቶኮፋ","order":13,"numberOfChapters":29,"sha256":"bf3d4fe53a815cd9fdda2167cab36e9de1b400d3c82c20a9da8681b0b196cce2","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/gaz_ebi/1CH/29.json","totalNumberOfVerses":942},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":["እሳንስ ታቦተ ዋቃ ፍደኒ ዱንካነ ዳዊት ዻቤፍ ኬሰ ንካአን፤ ኣርሳ ጉበሙፊ ኣርሳ ነጋ ፉለ ዋቃ ዱረት ንዽኤሰን።"]},{"type":"verse","number":2,"content":["ዳዊትስ ኤርገ ኣርሳ ጉበሙፊ ኣርሳ ነጋ ዽኤሴ ቦዴ መቃ ዋቀዮቲን ነሞተ ንኤብሴ።"]},{"type":"verse","number":3,"content":["ኤርገሲስ እን ቶኮ ቶኮ ነመ እስራኤሊቲፍ፣ ዺራፊ ዱበርቲፍ ቡዴነ ቶኮ ቶኮ፣ ጉማ ፎኒ ቶኮ ቶኮፊ ብጥሌ እጀ ወይኒ ቶኮ ቶኮ ንኬኔ።"]},{"type":"verse","number":4,"content":["እንስ አከ እሳን ፉለ ታቦተ ዋቀዮ ዱረት ተጃጅለኒፍ፣ አከ እሳን ዋቀዮ ዋቀ እስራኤል ዋመተኒፍ፣ አከ እሰ ገለቴፈተኒፊ አከ እሰ ጀጀተኒፍ ሌዎተ ቶኮ ቶኮ ንሙደቴ፤"]},{"type":"verse","number":5,"content":["እሳንስ አሳፍ ሀንገፍትቸ፣ ዘካርያስ እት ኣናሳ፣ እት ፉፌስ ዬኢኤል፣ ሼሚራሞት፣ ዬሂኤል፣ መቲትያ፣ ኤሊያብ፣ ቤናያ፣ ኦቤድ ኤዶሚፊ ዬኢኤል ፈእ ቱረን። ጀር ኩኔን ክራራፊ በገና ተጰቱ ቱሬ፤ አሳፍሞ ክልሌ ዸጌስሰ ቱሬ፤"]},{"type":"verse","number":6,"content":["ቤናያፊ የህዚኤል ሉቦትን ዬሮ ሁንደ ፉለ ታቦተ ከኩ ዋቃ ዱረት መለከተ አፉፉ ቱረን።"]},{"type":"heading","content":["ፋርፈትና ዳዊት ከን ገለታ"]},{"type":"verse","number":7,"content":["ዳዊትስ ጋፈ ሰነ አከ አሳፊፊ ምቾተሳ ፋርፈትና ገለታ ከነ ዋቀዮፍ ፋርፈተኒፍ ጀልቀበት አጀጀ ኬኔ፦"]},{"type":"verse","number":8,"content":[{"text":"ዋቀዮፍ ገለተ ገልቻ፤ መቃሳስ ዋመዻ፤","poem":1},{"text":"ዋን እን ሆጄቴስ ሰቦተ ግዱት ቤክስሳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እሳፍ ፋርፈዻ፤ ፋርፈናዻን እሰ ገለቴፈዻ፤","poem":1},{"text":"ዋኤ ሆጂሳ እሰ ድንቅሲሳ ሁንዳስ ኦዴሳ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"መቃሳ ቁልቁሉ ሰናን ቦና፤","poem":1},{"text":"ገራን ወረ ዋቀዮን በርባደኒ ሃገመዱ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዋቀዮፊ ሁምነሳ በርባደዻ፤","poem":1},{"text":"ዬሮ ሁንደ ፉለሳ በርባዳ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ድንቂ እን ሆጄቴ፣ ሆጂሳ ድንቂ ሰናፊ","poem":1},{"text":"ሙርቲ እን ለብሴ ያደዻ፤","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እስን ተጃጅልቶትንሳ፣ ወር ሰኚ እስራኤል ታተን፣","poem":1},{"text":"እስን ፍለተምቶትንሳ፣ እልማን ያቆብስ ከነ ያደዻ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"እን ዋቀዮ ዋቀኬኘ፤","poem":1},{"text":"ሙርቲንሳስ ለፈ ሁንደረ ጅረ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እን ከኩሳ በረ በራን፣ ዋዳ ገሌ ሰነስ","poem":1},{"text":"ዸሎተ ኩማፍ ንያደተ፤","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እን ከኩ አብረሃም ወጅን ገሌ፣","poem":1},{"text":"ከኩ ይስሃቂፍ ከከቴስ ንያደተ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ከነስ ያቆቢፍ ሴረ፣","poem":1},{"text":"እስራኤሊፍሞ ከኩ በረ በራ ጎዼአከነ ጄዼ ምርከኔሴረ፤ እንስ፦","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“አን ብየ ከነኣን ቆደ አት ዻልቱ ጎዼ፣","poem":1},{"text":"ሲፍ ነንኬነ” ጄዼ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"እሳን ዬሮ ለኮብሳን ጥኖ ቱረንት፣","poem":1},{"text":"ዹጉማኑ ጥኖፊ ብየቲ ኬሰትስ ኬሱሞተ ቱረንት፣","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ሰባ ገረ ሰባት፣ ሞቱማ ቶኮ","poem":1},{"text":"ገረ ሞቱማ ብራት ጆረን።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"እን አከ ነምን ቶኮዩ እሳን ጩንቁርሱ ህንኤየምኔ፤","poem":1},{"text":"ሰበቢሳኒቲፍስ አከነ ጄዼ ሞቶተ እፈቴ፦","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“ድበምቶተኮ ህንቱቅና፤","poem":1},{"text":"ራጆተኮስ ህንሚዽና።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ለፍት ሁንድኑ ዋቀዮን ፋርፈዻ፤","poem":1},{"text":"ፈይሱሳስ ጉዩመ ጉያን ለብሳ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ኡልፍነሳ ሰቦተ ግዱት፣","poem":1},{"text":"ሆጂሳ ድንቅሲሳ ሰነሞ ነሞተ ሁንደ ኬሰት ለብሳ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዋቀዮ ጉዳዻቲ ገለን ባይኤን እሳፍ ንመለ፤","poem":1},{"text":"እን ዋቆተ ሁንዳ ኦልትስ ሶዳተሙ ቀበ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዋቆትን ሰቦተ ኦርማ ሁንድኑ ዋቆተ ቶልፈሞዻቲ፤","poem":1},{"text":"ዋቀዮ ገሩ ሰሚወን ኡሜ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ሚዸግኒፊ ሱራን ፉለሳ ዱረ ጅሩ፤","poem":1},{"text":"ጀብኒፊ ገመቹንስ እዶ ጅሬኘሳ ጅሩ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ያ ማቲወን ሰቦታ፣ ዋቀዮፍ ኬና፤","poem":1},{"text":"ኡልፍናፊ ጀብነ ዋቀዮፍ ኬና።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ኡልፍነ መቃሳቲፍ መሉ ዋቀዮፍ ኬና።","poem":1},{"text":"ኣርሳ ፍዳቲ ፉለሳ ዱረት ዽኣዻ።","poem":2},{"text":"በሬድነ ቁልቁሉማሳቲን ዋቀዮን ዋቄፈዻ።","poem":1}]},{"type":"verse","number":30,"content":[{"text":"እስን ለፍት ሁንድኑ ፉለሳ ዱረት ሆለዻ!","poem":2},{"lineBreak":true},{"text":"አዱኛን ጀባቴ ዻበቴርት፤ ሶቾፈሙስ ህንደንዴሱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"ሰሚወን ሃእልልቸን፤ ለፍትስ ሃገመዱ፤","poem":1},{"text":"እሳን ሰቦተ ግዱት፣ “ዋቀዮ ሞኤረ!” ሃጄዸን።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ገላኒፊ ወን እሰ ኬሰ ጅሩ ሁንድኑ ሃሁርሱ፤","poem":1},{"text":"ድሬወኒፊ ወን እሳንረ ጅረን ሁንድኑ ሃገመደን!","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ሙኬን ቦሶና ሃፋርፈተን፤","poem":1},{"text":"እሳን ገመቹዻን ፉለ ዋቀዮ ዱረት ሃፋርፈተን፤","poem":2},{"lineBreak":true},{"text":"እን ለፈት ሙሩዻፍ ንዹፋቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"ዋቀዮፍ ገለተ ገልቻ፤ እን ጋሪዻቲ፤","poem":1},{"text":"ጃለልሳ በረ በራን ጅራተ።","poem":2}]},{"type":"verse","number":35,"content":[{"text":"አከነ ጄዻቲ እያ፤ “ያ ዋቀዮ፣","poem":1},{"text":"ፈይሳኬኘ፣ አት ኑ ባስ፤","poem":2},{"text":"አከ ኑ መቃኬ ቁልቁሉ ሰነ ገለቴፈኑፍ፣","poem":1},{"text":"አከ ገለተኬቲን ኦፍ ጀጅኑፍስ፣ ወልት ኑ ቀቢቲ ሰቦተ ኦርማ ጀላ ኑ ኦልች።”","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ዋቀዮ ዋቀ እስራኤሊቲፍ","poem":1},{"text":"በረ በራ ሀመ በረ በራት ገለን ሃገኡ።","poem":2},"ከነረት ነምን ሁንድኑ፣ “አሜን፤ ዋቀዮ ሃገለቶሙ” ጄዼ።"]},{"type":"line_break"},{"type":"verse","number":37,"content":["ዳዊትስ አከ እሳን ፉለ ታቦታ ዱረ ዬሮ ሁንደ ተጃጅለኒፍ፣ አሳፊፊ ኦቦሎተሳ አቹመ ፉለ ታቦተ ከኩ ዋቀዮ ዱረት እሳን ዺሴ።"]},{"type":"verse","number":38,"content":["አከሱመስ ኦቤድ ኤዶሚፊ ወረ እሳን ወጅን ሆጄተን ጃተሚ ሰዴተን አከ እሳን ወጅን ተጃጅለኒፍ አችት ዺሴ። ኦቤድ ኤዶም እልም ዬዱቱኒቲፊ ሆሳን ኤግዶተ በልበላ ቱረን።"]},{"type":"verse","number":39,"content":["ዳዊት ዛዶቅ ሉብቻፊ ሉቦተ እሰ ወጅን ሆጄተን ካን ዱንካነ ዋቀዮ ቁልቁሉ ከን ግቤኦን ኬሰት ጋረ ሰገዳረት አርገሙ ብረት ዺሴ፤"]},{"type":"verse","number":40,"content":["ኩንስ እሳን አኩመ ዋን ሴረ ዋቀዮ ከን እን እስራኤሊፍ ኬኔ ሁንደ ኬሰት በሬፈሜ ሰናት ዬሮ ሁንደ ገልገላፊ ገነመ እዶ ኣርሳ ጉበሙረት ኣርሳ ጉበሙ ዋቀዮፍ አከ ዽኤሰኒፍ።"]},{"type":"verse","number":41,"content":["እሳን ወጅንስ ሄማኒፊ ዬዱቱን አከሱመስ ወረ አከ፣ “ጃለልሳ በረ በራን ጅራተ” ጄዸኒ ዋቀዮፍ ገለተ ገልቸኒፍ ፍለተመኒ መቃንሳኒ ቤከሜ ብራቱ ቱሬ።"]},{"type":"verse","number":42,"content":["ሄማኒፊ ዬዱቱን ሰገሌ መለከታቲፍ ክልሌ ዸጌስሱፊ አከሱመስ ሜሻ ሙዚቃ ከን ዋቃረት እት ጋፈተምቶተ ቱረን። እልማን ዬዱቱንሞ ከረ ኤገን።"]},{"type":"verse","number":43,"content":["ኤርገሲ ነሞትን ሁንድኑ አቺ ከአኒ ቶኮን ቶኮንሳኒ ገረ መነ ኦፊሳት ገለን፤ ዳዊትሞ ማቲ ኦፊ ኤብሱፍ ገረ መናት ንዴብኤ።"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/1CH/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/1CH/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/1CH/15.json","previousChapterAudioLinks":{},"numberOfVerses":43}