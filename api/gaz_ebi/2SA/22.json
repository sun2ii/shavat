{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"2SA","translationId":"gaz_ebi","name":"2 ሳሙኤል","commonName":"2 ሳሙኤል","title":"ክታበ ሳሙኤል ለመፋ","order":10,"numberOfChapters":24,"sha256":"40e1a10973c4ec07ca8cc282b9429a90d0a7de804a26180c0ab7224e3b20e8f1","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/gaz_ebi/2SA/24.json","totalNumberOfVerses":695},"chapter":{"number":22,"content":[{"type":"heading","content":["ፋርፈትና ገለታ ከን ዳዊት"]},{"type":"verse","number":1,"content":["ዳዊት ዮሙ ዋቀዮ ሀርከ ዲኖተሳ ሁንዳፊ ሀርከ ሳኦል ጀላ እሰ ባሴት ዱቢ ፋርፈትና ከነ ዋቀዮፍ ፋርፈቴ።"]},{"type":"verse","number":2,"content":["እንስ አከነ ጄዼ፦",{"text":"“ዋቀዮ ከታኮት፤ ደአትኖኮቲፊ ኦልቻኮት፤","poem":1}]},{"type":"verse","number":3,"content":[{"text":"ዋቅንኮ ከታኮ ከን አን ኮሉ እት ገሉዸ፤","poem":2},{"lineBreak":true},{"text":"እን ጋቸነኮቲፊ ጋንፈ ፈይነኮት።","poem":2},{"text":"እን ደአትኖኮ ጭማ፣ ኮሉኮቲፊ ፈይሳኮት፤","poem":1},{"text":"አት ነሞተ ሁምናን ነመት ከአን ጀላስ ነ ባስተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“አን ዋቀዮ ገለን እሳፍ መሉ ሰነ ነንዋመዸ፤","poem":1},{"text":"ዲኖተኮ ጀላስ ነንበራረመ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ደምበሊን ዱኣ ነ መርሴረ፤","poem":1},{"text":"ሎላን በዲሳስ ነ ልቅምሴረ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ፉኞን ሲኦል ነት መረሜ፤","poem":1},{"text":"ክዮን ዱኣስ ነት ዹፌ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“አን ዽጵነኮ ኬሰት ዋቀዮን ነንዋመዼ፤","poem":1},{"text":"ዋቀኮት ነንእየዼ።","poem":2},{"text":"እንስ መነ ቁልቁሉማሳቲ ሰገሌኮ ዸገኤ፤","poem":1},{"text":"እይኮስ ጉረሳ ሴኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ለፍት ንሆለቴ፤ ንሶቾቴስ፤","poem":1},{"text":"ሁንዴወን ሰሚወኒ ንራፈመን፤","poem":2},{"lineBreak":true},{"text":"ሰበቢ እን ዼከሜፍስ እሳን ንሆለተን።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኣር ፉኛንሳቲ ኦል በኤ፤","poem":1},{"text":"እብድ ዋ በርበዴሱ አፋንሳቲ በኤ፤","poem":2},{"lineBreak":true},{"text":"ጭሌን ቦበኡስ አፋንሳቲ በኤ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እን ሰሚወን ተርሳሴ ገድ ቡኤ፤","poem":1},{"text":"ዱሜሶን ጉራችስ ሚለሳ ጀለ ቱረን።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እን ኪሩቤልን ያበቴ በርሴ፤","poem":1},{"text":"ቆቾ ቅሌንሳቲንስ ኦል በኤ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እን ዱከነ፣ ዱሜሰ ሰሚ","poem":1},{"text":"ከን ቦካዻን ዱከናኤሞ ጎዶሳ ጎዸቴ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እፈ ፉለሳ ኬሳስ","poem":1},{"text":"በከካን በለቅሴ በኤ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዋቀዮ ሰሚዻ ንቀቀዌሰኤ፤","poem":1},{"text":"ሰገሌን ዋቀ ዋን ሁንዳ ኦሊስ ንዸገአሜ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እን ጥየሳ ደርበቴ ዲኖተ ብትኔሴ፤","poem":1},{"text":"በከካስ ገድ ዺሴ እሳን ፍጤ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዼከምሰ፣ ዋቀዮቲን","poem":1},{"text":"ሁምነ ሀፉረ ፉኛንሳቲ በኡቲንስ","poem":2},{"text":"ሱሉለወን ገላና እፈት ባፈመን፤","poem":1},{"text":"ሁንዴወን ለፋስ ቁላ ሀፈን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“እን ኦል ጉባዻ ገድ ሂጠቴ ነ ቀቤ፤","poem":1},{"text":"ብሻኖተ ገድ ፈጎ ኬሳስ ነ ባሴ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እን ዲነኮ እሰ ጀባ ጀላ፣ አመጃጆተኮ","poem":1},{"text":"ወረ አከ መሌ ነት ጭመን ጀላስ ነ ባሴ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እሳን ጉያ ረክነኮት ነት ዹፈን፤","poem":1},{"text":"ዋቀዮ ገሩ ገርጋርሰኮ ቱሬ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እን እዶ በልኣት ነ ባሴ፤","poem":1},{"text":"ዋን ነት ገመዴፍስ ነ ኦልቼ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“ዋቀዮ አኩመ ቀጄሉማኮቲት ና ኬኔረ፤","poem":1},{"text":"አኩመ ቁልቁልነ ሀርከኮትስ ነ በዻሴ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"አን ከራ ዋቀዮ ኤጌራቲ፤","poem":1},{"text":"ዋቀኮራ ገረገሌ ሀምነ ህንሆጄትኔ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ሴርሳ ሁንድኑ ፉለኮ ዱረ ጅረ፤","poem":1},{"text":"አንስ አጀጀሳራ ህንጀልአትኔ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"አን ፉለሳ ዱረት ሙዳ ህንቀቡ ቱሬ፤","poem":1},{"text":"ጩቡራስ ኦፍ ኤገዼረ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዋቀዮ አኩመ ቀጄሉመኮት፣","poem":1},{"text":"አኩመ አን ፉለሳ ዱረት ቁልቁሉ ተኤትስ ነ በዻሴረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“አት ነመ አመነማት አመነሙማኬ አርግሲፍተ፤","poem":1},{"text":"ነመ ሙዳ ህንቀብኔትስ ከን ሙዳ ህንቀብኔ ታተ፤","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ነመ ቁልቁሉት ቁልቁሉ ታተ፤","poem":1},{"text":"ነመ ጀልኣትሞ ጀልኣ ታተ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"አት ወረ ገድ ኦፍ ቀበን ንኦልችተ፤","poem":1},{"text":"ወረ ኦፍ ቱለንሞ ገድ ዴብሱፍ እጅኬ እሳን እላለ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ያ ዋቀዮ፣ አት እብሳኮት፤","poem":1},{"text":"ዋቀዮ ዱከነኮ እፈት ንጌደረ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"አን ገርጋርሰኬቲን ሎልቶተ ዺበዼ ነንዴመ፤","poem":1},{"text":"ዋቀኮቲንስ ደላ ኡታሉ ነንደንደአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“ዋቀ ከነ፣ ከራንሳ ሙዳ ህንቀቡ፤","poem":1},{"text":"ዱቢን ዋቀዮ ህርእነ ህንቀቡ።","poem":2},{"lineBreak":true},{"text":"ወረ እሰት ኮሉ ገለን ሁንዳፍ እን ጋቸነ ተአ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ዋቀዮ መሌ ዋቅን ኤኙ?","poem":1},{"text":"ዋቀኬኘ መሌስ ከታን ኤኙ?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ከን ሁምነ ነ ህዸቺሱ፣","poem":1},{"text":"ከን አከ ከራንኮስ ነጋ ተኡ ጎዹ ዋቀ።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"እን ሚለኮ አከ ሚለ ቦሮፋ ጎዸ፤","poem":1},{"text":"እዶ ኦል ዼራረስ ነ ዻበቺሰ።","poem":2}]},{"type":"verse","number":35,"content":[{"text":"እን ሀርከኮ ወራናፍ ሌንጅሰ፤","poem":1},{"text":"እሬንኮስ እዳ ናሲ ደብሱ ንደንደአ።","poem":2}]},{"type":"verse","number":36,"content":[{"text":"አት ገርጋርሰኬ ከን ነመ ፈይሱ ጋቸነ ናፍ ጎተ፤","poem":1},{"text":"ገርጋርስኬስ ነመ ጉዳ ነ ጎዼ።","poem":2}]},{"type":"verse","number":37,"content":[{"text":"አከ ኮሜንኮ ህንሙጩጫኔፍ፣","poem":1},{"text":"ሚለኮቲፍ ዳንዲ በልእፍቴርተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"“አን ዲኖተኮ አርኤ ነንበሌሴ፤","poem":1},{"text":"ሀመ እሳን በርበዳአንትስ አን ዱበት ህንዴብኔ።","poem":2}]},{"type":"verse","number":39,"content":[{"text":"አን ጉቱማን ጉቱት እሳን ነንበርበዴሴ፤","poem":1},{"text":"እሳን ዴብአኒ ከኡ ህንደንደአን፤","poem":2},{"lineBreak":true},{"text":"እሳንስ ሚለኮ ጀለት ንኩፈን።","poem":2}]},{"type":"verse","number":40,"content":[{"text":"አት ሎላፍ ሁምነ ነ ህዸቺፍቴ፤","poem":1},{"text":"አመጃጆተኮስ ፉለኮ ዱረት ገድ ዴብፍቴ።","poem":2}]},{"type":"verse","number":41,"content":[{"text":"አከ ዲኖትንኮ ዱግደ ዱበት ዴብአኒ በቀተን ጎቴርተ፤","poem":1},{"text":"አንስ አመጃጆተኮ በርበዴሴረ።","poem":2}]},{"type":"verse","number":42,"content":[{"text":"እሳን ገርጋርሳፍ እየን፤ ገሩ ከን እሳን ኦልቹ ቶኮዩ ህንቱሬ፤","poem":1},{"text":"ገረ ዋቀዮትስ ንእየተን፤ እን ገሩ ዴቢ ህንኬንኔፍ።","poem":2}]},{"type":"verse","number":43,"content":[{"text":"አንስ አኩመ አዋረ ለፋት እሳን ነንዳኬ፤","poem":1},{"text":"ቡሌሴስ አኩመ ዾቄ ዳንዲራት እሳን ዽዺቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"“አት ሎለ ነሞታ ጀላ ነ ባፍቴርተ፤","poem":1},{"text":"መታ ሰቦታ ጎቴ ነ ጅራችፍቴርተ።","poem":2},{"text":"ሰብን አን ህንቤክኔ ነ ተጃጅለ፤","poem":1}]},{"type":"verse","number":45,"content":[{"text":"ነሞትን ኦርማ ነ ሶሶበተን፤","poem":2},{"lineBreak":true},{"text":"እሳን አኩመ ዋኤኮ ዸገአኒን ናፍ አጀጀመን።","poem":2}]},{"type":"verse","number":46,"content":[{"text":"እሳን ሁንድ አብዲ ኩተተን፤","poem":1},{"text":"ሆለቻስ ደአትኖሳኒ ጀባ ኬሳ በአን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“ዋቀዮ ጅራታዸ! ከታንኮ ሃኤብፈሙ!","poem":1},{"text":"ዋቅንኮ፣ ከታን፣ ፈይሳንኮ ኦል ኦል ሃጄዹ!","poem":2}]},{"type":"verse","number":48,"content":[{"text":"እን ዋቀ ሃሎ ና ባሱ፣","poem":1},{"text":"ከን ሰቦተስ ነ ጀለ ገልቹ፣","poem":2}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"ከን ዲኖተኮ ጀላስ ብልሰ ነ ባሱዸ።","poem":2},{"text":"አት አመጃጆተኮቲ ኦል ነ ጎተ፤","poem":1},{"text":"ጎልቶተ ጀላስ ነ ባፍቴ።","poem":2}]},{"type":"verse","number":50,"content":[{"text":"ከናፉ ያ ዋቀዮ፣ አን ሰቦተ ግዱት ስን ሌልሰ፤","poem":1},{"text":"ፋርፈትና ገለታሌ መቃኬቲፍ ነንፋርፈዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"“እን ሞአናወን ጉርጉዳ ሞቲሳቲፍ ንኬነ፤","poem":1},{"text":"ድበማሳ ዳዊቲፊ ሰኚሳቲፍ፣","poem":2},{"lineBreak":true},{"text":"አራረ በረ በራ ንአርግሲሰ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}