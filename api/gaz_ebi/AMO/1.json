{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"AMO","translationId":"gaz_ebi","name":"አሞስ","commonName":"አሞስ","title":"ራጂ አሞስ","order":30,"numberOfChapters":9,"sha256":"1ff75efc7cda42dffedba984af057e61e6a62e47890b07f72d6cfe713acdbbe2","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gaz_ebi/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["ኩን ሙልአተ አሞስ እን ትክሴወን ቴቆኣ ኬሳ ቶኮ ቱሬ ሱን በረ ኡዝያን ሞቲ ይሁዳ፣ ዬሮብኣም እልም ዮኣሽሞ ሞቲ እስራኤል ቱሬት፣ ኡቱ ሶቺን ለፋ ህንተእን ወጋ ለመ ዱረ ዋኤ እስራኤል አርጌዸ።"]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":["እንስ አከነ ጄዼ፦",{"text":"“ዋቀዮ ጥዮን ኬሳ እየ፤","poem":1},{"text":"ዬሩሳሌም ኬሳ ሰገሌ ዸጌስሰ፤","poem":2},{"text":"ድሬን ትክሶትን እት ቦባሰን ንጎገ፤","poem":1},{"text":"ፊጤን ጋረ ቀርሜሎስስ ንጮለገ።”","poem":2}]},{"type":"heading","content":["ሙርቲ ኦሎተ እስራኤልት ሙረሜ"]},{"type":"verse","number":3,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“አን ጩቡ ደማስቆ ሰዲፍ፣","poem":1},{"text":"አፉሪፍስ ዼከምሰኮ ዱበት ህንዴብሱ።","poem":2},{"text":"ሰበቢ እሳን ሜሻ እቲን ምዻን ዸአን","poem":1},{"text":"ከን እልካን ስቢላ ቀቡን ግልኣድን ቱመኒፍ፣","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አን እብደ ደአትኖ ቤን-ሀዳድ","poem":1},{"text":"በርበዴሱ ቶኮ፣ መነ ሀዛኤልት ነንኤርገ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አን ከረ ደማስቆ ነንጨብሰ፤","poem":1},{"text":"ሞቲ ሱሉለ አዌን ኬሰ ጅሩፊ","poem":2},{"text":"እሰ ቤት ኤዴን ኬሰት ቦኩ ቀበቱ ነንበሌሰ።","poem":1},{"text":"ኡመትን ሶርያ ቦጅአሜ ቂርት ንጌፈመ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":6,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“አን ጩቡ ጋዛ ሰዲፍ፣","poem":1},{"text":"አፉሪፍስ ዼከምሰኮ ዱበት ህንዴብሱ።","poem":2},{"text":"ሰበቢ እሼን ሀዋሰ ሁንደ ቦጅቴ","poem":1},{"text":"ኤዶምት ጉርጉረቴፍ፣","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አን እብደ ደአትኖሼ በርበዴሱ ቶኮ","poem":1},{"text":"ደላ ጋዛት ነንኤርገ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አን ሞቲ አሽዶዲፊ እሰ አሽቀሎን ኬሰት","poem":1},{"text":"ቦኩ ቀበቱ ሰነ ነንበሌሰ።","poem":2},{"text":"አን ሀመ ሀምባን ፍልስጤሞታ ዱኡት","poem":1},{"text":"ሀርከኮ ኤቅሮንት ነንዴብፈዸ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ ጎፍታን።","poem":2}]},{"type":"verse","number":9,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“አን ጩቡ ጢሮስ ሰዲፍ፣","poem":1},{"text":"አፉሪፍስ ዼከምሰኮ ዱበት ህንዴብሱ።","poem":2},{"text":"ሰበቢ እሼን ወሊ ገልቴ ኦቦሉማ ጨብስቴ","poem":1},{"text":"ሀዋሰ ቦጅአሜ ጉቱ ኤዶምት ጉርጉረቴፍ","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አን እብደ ደአትኖሼ በርበዴሱ ቶኮ","poem":1},{"text":"ደላ ጢሮስት ነንኤርገ።”","poem":2}]},{"type":"verse","number":11,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“አን ጩቡ ኤዶም ሰዲፍ፣","poem":1},{"text":"አፉሪፍስ ዼከምሰኮ ዱበት ህንዴብሱ።","poem":2},{"text":"ሰበቢ እን ገረ ላፍነ ሁንደ ገቴ","poem":1},{"text":"ኦቦሌሰሳ ጎራዴዻን አርኤፍ፣","poem":2},{"text":"ሰበቢ ኣሪንሳ እቱመ ፉፌ ሆኤ","poem":1},{"text":"ዼከምስሳስ ኡቱ ህንዾወምን ቦበኤፍ፣","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አን እብደ ደአትኖ ቦዝራ በርበዴሱ ቶኮ","poem":1},{"text":"ቴማንት ነንኤርገ።”","poem":2}]},{"type":"verse","number":13,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“አን ጩቡ አሞን ሰዲፍ፣","poem":1},{"text":"አፉሪፍስ ዼከምሰኮ ዱበት ህንዴብሱ።","poem":2},{"text":"ሰበቢ እን ዳንጋሳ በበልእፈቹፍ ጄዼ","poem":1},{"text":"ዱበርቶተ ግልኣድ ከኔን ኡልፈ ቀበን በቀቅሴፍ","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አን ጉያ ሎላት ወጫን፣","poem":1},{"text":"ጉያ ቅሌንሰ ሀማትሞ ቡቤ ጀባዻን","poem":2},{"text":"እብደ ደአትኖሼ በርበዴሱ ቶኮ","poem":1},{"text":"ደላ ረባት ነንኤርገ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሞቲንሼ ቦጅአሜ እኒፊ","poem":1},{"text":"ቆንዳልቶትንሳ ወጅን ንቦጅአሙ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}