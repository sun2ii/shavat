{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"AMO","translationId":"gaz_ebi","name":"አሞስ","commonName":"አሞስ","title":"ራጂ አሞስ","order":30,"numberOfChapters":9,"sha256":"1ff75efc7cda42dffedba984af057e61e6a62e47890b07f72d6cfe713acdbbe2","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gaz_ebi/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“አን ጩቡ ሞኣብ ሰዲፍ፣","poem":1},{"text":"አፉሪፍስ ዼከምሰኮ ዱበት ህንዴብሱ።","poem":2},{"text":"ሰበቢ እን ለፌ ሞቲ ኤዶም","poem":1},{"text":"ጉቤ ዳራ ጎዼፍ፣","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አን እብደ ደአትኖ ኬሪዮት በርበዴሱ ቶኮ","poem":1},{"text":"ሞኣብት ነንኤርገ።","poem":2},{"text":"ሞኣብ እየ ወራናቲፊ","poem":1},{"text":"ሰገሌ መለከታቲን ዱአ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አን ቡልቻሼ አጄሴ","poem":1},{"text":"ቆንዳልቶተሼ ሁንደስ እሰ ወጅንን ፍጠ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":4,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“አን ጩቡ ይሁዳ ሰዲፍ፣","poem":1},{"text":"አፉሪፍስ ዼከምሰኮ ዱበት ህንዴብሱ።","poem":2},{"text":"ሰበቢ እሳን ሴረ ዋቀዮ ድደኒ","poem":1},{"text":"አጀጀሳስ ህንኤግኒፍ፣","poem":2},{"text":"ሰበቢ እሳን ዋቆተ ሶባ፣","poem":1},{"text":"ዋቆተ አቦቲንሳኒ ዱካ ቡአን ሰናንከራራ ጀልአተኒፍ፣","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አን እብደ ደአትኖ ዬሩሳሌም በርበዴሱ ቶኮ","poem":1},{"text":"ይሁዳት ነንኤርገ።”","poem":2}]},{"type":"heading","content":["ሙርቲ እስራኤልት ሙረሜ"]},{"type":"verse","number":6,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“አን ጩቡ እስራኤል ሰዲፍ፣","poem":1},{"text":"አፉሪፍስ ዼከምሰኮ ዱበት ህንዴብሱ።","poem":2},{"text":"እሳን ቀጄልቶተ ሜቲት፣","poem":1},{"text":"ረከቶተሞ ኮጴ ጭምዲ ቶኮት ጉርጉረተን።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እሳን አኩመ ብዮ ለፋት","poem":1},{"text":"መታ ህዬዪረ እጃጀኒ","poem":2},{"lineBreak":true},{"text":"ጩንቁርፈማስ ሙርቲ ቀጄላ ዾወተን።","poem":2},{"text":"አባፊ እልም ዱርበ ቶኮት ገለኒ","poem":1},{"text":"አከሲን መቃኮ ቁልቁሉ ጡሬሰን።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እሳን ኡፈተ ቀብዲዻን ነመራ","poem":1},{"text":"ፉዸተን እረ እዶ ኣርሳ ሁንደ ብረ ጭጪሰን።","poem":2},{"text":"እሳን ዳዺ ወይኒ ከን ወረ አደበመን ብራ ዹፌ፣","poem":1},{"text":"መነ ዋቀሳኒ ኬሰት ዹጉ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“እን አኩመ ብርብርሳ ዼረቴ","poem":1},{"text":"አከ ቅልጡ ጀባቱዩ፣","poem":2},{"lineBreak":true},{"text":"አን ነምቸ አሞር ሰነ ፉለሳኒ ዱረት ገላፈዼረ።","poem":2},{"text":"አን ጉባዻ እጀሳ፣","poem":1},{"text":"ጀላንሞ ህደሳ በሌሴረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“አን ብየ አሞሮታ እስኒፍ ኬኑፍ ጄዼ፣","poem":1},{"text":"ብየ ግብጢቲ እስን ባሴ","poem":2},{"lineBreak":true},{"text":"ወጋ አፉርተመ ገሞጂ ኬሰ እስነን ጌጌሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“አከሱመስ አን እልማንኬሰን ግዱዻ ራጆተ፣","poem":1},{"text":"ደርገጎተኬሰን ግዱዻሞ ናዝሮተ ካሴረ።","poem":2},{"text":"ያ ሰበ እስራኤል፣ ወን ኩን ዹጉመ ምቲ?”","poem":1},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“እስን ገሩ ናዝሮተ ዳዺ ወይኒ ኦባፍተኒ","poem":1},{"text":"አከ ራጆትንስ ራጂ ህንዱበትኔ አጀጀን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“አን አኩመ ጋሪን ዮሙ ምዻኒን ጉተሙ ጨጨቡ ሰነ፣","poem":1},{"text":"አመ እስነን ጨጨብሰ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሰፍሳን ህንምልቁ፤","poem":1},{"text":"ነሞትን ጀጀቦን ሁምነሳኒ ህንጀቤፈተን፤","poem":2},{"lineBreak":true},{"text":"ሎልቱንስ ሉቡሳ ህንኦልፈቱ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አባን ጥያ ጀባቴ ዻበቹ ህንደንደኡ፤","poem":1},{"text":"ሎልቱን ሰፍሳን ፊጌ ጀላ ህንበኡ፤","poem":2},{"lineBreak":true},{"text":"አባን ፈርዳስ ሉቡሳ ኦልፈቹ ህንደንደኡ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሎልቶትን አከ መሌ ጀጀቦንዩ","poem":1},{"text":"ጋፈስ ቁላሳኒ በቀቱ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}