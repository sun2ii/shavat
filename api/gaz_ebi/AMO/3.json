{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"AMO","translationId":"gaz_ebi","name":"አሞስ","commonName":"አሞስ","title":"ራጂ አሞስ","order":30,"numberOfChapters":9,"sha256":"1ff75efc7cda42dffedba984af057e61e6a62e47890b07f72d6cfe713acdbbe2","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gaz_ebi/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"heading","content":["ዹገ ባቶተ እስራኤልት ዹጋ በአን"]},{"type":"verse","number":1,"content":["ያ ሰበ እስራኤል፣ ዱቢ ዋቀዮ እስኒን ሞርሙዻን፣ ማቲ አን ብየ ግብጢ ባሴ ፍዴ ሁንዳን ሞርሙዻን ዱበቴ ከነ ዸገኣ፦"]},{"type":"verse","number":2,"content":[{"text":"“አን ማቲወን ለፈረ ጅራተን","poem":1},{"text":"ሁንደ ኬሳ እስን ቆፈ ፍለዼረ፤","poem":2},{"text":"ከናፉ አን ጩቡኬሰን","poem":1},{"text":"ሁንዳፍ እስነን አደበ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ዮ ወሊ ገለን መሌ","poem":1},{"text":"ነሞትን ለመ ወጅን ንዴሙ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሌንጭ ቶኮ ዮ ዋን አደምሱ ህንአርገትን","poem":1},{"text":"ቦሶነ ኬሳ ንኣዳ?","poem":2},{"text":"እን ዮ ዋ ቀበቴ መሌ","poem":1},{"text":"ሆልቀሳ ኬሳ ንኣዳ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ስምብር ቶኮ ለፈ ክዮን ህንካአምንት","poem":1},{"text":"ክዮ ኬሰ ንሴንቲ?","poem":2},{"text":"ክዮን ቶኮ ዮ ወን ቀበሙ ህንጅሬ","poem":1},{"text":"አከሱመት ለፋ ንኡታላ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዮ መጋላ ኬሰት መለከትን አፉፈሜ፣","poem":1},{"text":"ነሞትን ህንራፈመኒ?","poem":2},{"text":"በላን መጋላ ቶኮት ዮ ዹፌ፣","poem":1},{"text":"ዋቀዮቱ ዋን ሰነ ፍዴ ምቲ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ዹጉማን ዋቀዮ ጎፍታን","poem":1},{"text":"ኡቱ ተጃጅልቶተሳ ራጆተት ህንሙልእስን","poem":2},{"lineBreak":true},{"text":"ዋን ቶኮሌ ህንሆጄቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ሌንጭ ኣዴረ፤","poem":1},{"text":"ኤኙቱ ህንሶዳትኔሬ?","poem":2},{"text":"ዋቀዮ ጎፍታን ዱበቴረ፤","poem":1},{"text":"ዮስ ኤኙቱ ራጂ ህንዱበትኔሬ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ደአትኖ አሽዶዲቲፊ","poem":1},{"text":"ደአትኖ ግብጥት አከነ ጄዻ ለብሳ፦","poem":2},{"text":"“ቱሉወን ሰማርያረት ወልት ቀበማ፤","poem":1},{"text":"ጄቁምሰ ጉዳ እሼ ኬሰ ጅሩፊ","poem":2},{"lineBreak":true},{"text":"ጩንቁርሳ ኡመተሼ ኬሰ ጅሩ እላላ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ወር ደአትኖሳኒ ኬሰት ዋን ቦጅአሜፊዋን ሳመሜ ኩፈተን","poem":1},{"text":"አከ እት ዋን ቀጄላ ሆጄተን ህንቤከን”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":11,"content":["ከናፉ ዋቀዮ ጎፍታን አከነ ጄዸ፦",{"text":"“ዲን ብየኬሰን መርሰ፤","poem":1},{"text":"ጀብነኬሰን ገድ ቡሰ፤","poem":2},{"lineBreak":true},{"text":"ደአኖወንኬሰንስ ንሳመ።”","poem":2}]},{"type":"verse","number":12,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“አኩመ ትክሴን ቶኮ ለፌ ሚለ ለማኒ","poem":1},{"text":"ዮካን ፊጤ ጉራ ቆፈ አፋን ሌንጫቲ ቡሱ ሰነ፣","poem":2},{"text":"እስራኤሎን ሰማርያ ኬሰ፣ ቀርቀረ ስሬሳኒረ፣","poem":1},{"text":"ደማስቆ ኬሰስ ስሬሳኒ ድንኪረ ታአን","poem":2},{"lineBreak":true},{"text":"አከሱመ ንበራረሙ።”","poem":2}]},{"type":"verse","number":13,"content":["“ዋን ከነ ዸገኣቲ መነ ያቆብት ዹጋ በኣ” ጄዸ ጎፍታን፣ ዋቀዮ ዋቅን ዋን ሁንደ ደንደኡ።"]},{"type":"verse","number":14,"content":[{"text":"“ጉያ አን ጩቡ እሼቲፍ ጄዼ እስራኤልን አደቡት፣","poem":1},{"text":"እዶወን ኣርሳ ቤትኤል ነንበርበዴሰ፤","poem":2},{"text":"ጋንፈወን እዶ ኣርሳስ ጨጨበኒ","poem":1},{"text":"ለፈት ንሀርጨኡ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አን መነ ገናቲፊ","poem":1},{"text":"መነ ቦና ነንዲገ፤","poem":2},{"text":"መኔን እልከ አርባቲን ሚዸግፈመን ንዲገሙ፤","poem":1},{"text":"መኔን ጉርጉዳንስ ንበሌፈሙ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}