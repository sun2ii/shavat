{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"AMO","translationId":"gaz_ebi","name":"አሞስ","commonName":"አሞስ","title":"ራጂ አሞስ","order":30,"numberOfChapters":9,"sha256":"1ff75efc7cda42dffedba984af057e61e6a62e47890b07f72d6cfe713acdbbe2","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gaz_ebi/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":4,"content":[{"type":"heading","content":["እስራኤል ገረ ዋቃት ህንዴብኔ"]},{"type":"verse","number":1,"content":[{"text":"እስን ያ ሳወን ባሻን ከኔን ቱሉ ሰማርያረ ጅርተን፣","poem":1},{"text":"ያ ዱበርቶተ፣ እስን ወር ህዬዪፊ ረከቶተ ጩንቁርስተኒ","poem":2},{"lineBreak":true},{"text":"ዽርሶተኬሰኒን፣ “ዹጋቲ ኑፍ ፍዳ!” ጄተንዱቢ ከነ ዸገኣ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዋቀዮ ጎፍታን አከነ ጄዼቁልቁሉማሳቲን ከከቴረ፦","poem":1},{"text":"“ዬሮን እስን እት ሆኮዻን፣","poem":2},{"text":"እስን ኬሳ ነምን ዹማሞ ቀብዱ ቁርጡሚቲን","poem":1},{"text":"ቀበሙ ቶኮ ዹጉማን ንዹፈ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እስን ቶኮ ቶኮን ቀጄልተኒ","poem":1},{"text":"ቃወ ደላቲን ንባቱ፤","poem":2},{"text":"ገረ ሀርሞንትስ ንደርበተምቱ”","poem":1},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“ቤትኤል ዸቃቲ ጩቡ ሆጄዻ፤","poem":1},{"text":"ግልጋል ዸቃቲ ጩቡ ባይኤ ሆጄዻ።","poem":2},{"text":"ገነመ ገነመ ኣርሳኬሰን ዽኤሳ፤","poem":1},{"text":"ወጋ ሰዲ ሰዲትሞ ኬናኬሰን ሀርከ ኩዸን ኬሳሀርከ ቶኮ ፍዳ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ቡዴነ ራጭቲ ቀቡ ኣርሳ ገለታ ጎዻቲ ጉባ፤","poem":1},{"text":"ኣርሳ ፌዺዻን ኬንተን ለብሳ፤ ቤክስሳስ፤","poem":2},{"text":"ያ እስራኤሎተ፣ ወን እስን ሆጄቹ ጃለተን ከናቲ፣","poem":1},{"text":"እቲን ቦና”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ ጎፍታን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“አን መጋላ ሁንደ ኬሰት ገራ ዱዋ እስኒፍ ኬኔረ፤","poem":1},{"text":"መጋላ ሁንደ ኬሰትስ ቡዴነ እስን ዸብሲሴረ፤","poem":2},{"text":"እስን ገሩ ገረኮት ህንዴብኔ”","poem":1},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“አን ዬሮ ምዻን ሃመሙፍ ጅእ ሰዲ ሀፉት","poem":1},{"text":"ቦካ እስንራ ነንኩቴ።","poem":2},{"text":"አን መጋላ ቶኮት ቦካ ኤርጌ","poem":1},{"text":"ካንራሞ ነንዻቤ።","poem":2},{"text":"ለፍት ቆትና ቶኮ ቦካ አርገቴ","poem":1},{"text":"ካን ገሩ ሆማ ዸቤ ጎጌ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኡመትን ብሻን በርባቸ መጋላዻ ገረ መጋላት ጆሬ፤","poem":1},{"text":"ገሩ ዋን ዹጋቲፍ እሰ ገኡ ህንአርገትኔ፤","poem":2},{"text":"ተኡስ እስን ገረኮት ህንዴብኔ”","poem":1},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“አን ዬሮ ሄዱ እዶ ብቅልቱቲፊ","poem":1},{"text":"ወይኒኬሰን ዋጊፊ አዋሮዻን ዸኤን በሌሴ።","poem":2},{"text":"ሀዋንስን ሀርቡፊ ኤጄርሰኬሰን በርበዴሴ፤","poem":1},{"text":"ተኡስ እስን ገረኮት ህንዴብኔ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“አን አኩመን ብየ ግብጥ ጎዼ ሰነ","poem":1},{"text":"ዸእቸ እስንት ነንኤርጌ።","poem":2},{"text":"አን ፈርዴን እስን ቦጅተን ወጅን","poem":1},{"text":"ደርገጎተኬሰን ጎራዴዻን ነንፍጤ።","poem":2},{"text":"አጃ ቁበተኬሰኒቲን ፉኛንኬሰን ነንጉቴ፤","poem":1},{"text":"እስን ገሩ ገረኮት ህንዴብኔ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“አን አኩመን ሶዶሚፊ ጎሞራ ገረገልቼ ሰነ","poem":1},{"text":"እስን ኬሳ ነመ ቶኮ ቶኮ ገረገልቼረ።","poem":2},{"text":"እስን አኩመ ሙከ ቦበኡ ከን እብደ ኬሳ ቡተሜት፤","poem":1},{"text":"ተኡስ እስን ገረኮት ህንዴብኔ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ከናፉ ያ እስራኤል፣ አን አከነን እስን ጎዸ፤","poem":1},{"text":"ሰበቢ አን አከነ እስን ጎዹፍ","poem":2},{"lineBreak":true},{"text":"ያ እስራኤል ዋቀኬ አርጉፍ ቆጳእ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"እን ቱሉወን ቶልቼ","poem":1},{"text":"ቡቤ ኡሜ ያደሳ ነመት ሙልእሱ ሱን፣","poem":2},{"text":"እን በሪ ዱከኔሴ","poem":1},{"text":"እዶወን ለፈ ኦል ከኦረ ኤጄቱ ሱን፣","poem":2},{"lineBreak":true},{"text":"መቃንሳ ዋቀዮ፣ዋቀ ዋን ሁንደ ደንደኡዸ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/AMO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/AMO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/AMO/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}