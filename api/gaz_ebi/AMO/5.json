{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"AMO","translationId":"gaz_ebi","name":"አሞስ","commonName":"አሞስ","title":"ራጂ አሞስ","order":30,"numberOfChapters":9,"sha256":"1ff75efc7cda42dffedba984af057e61e6a62e47890b07f72d6cfe713acdbbe2","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gaz_ebi/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["ፋሩ ቦእቻቲፊ ዋምቸ ቀልቢ ጅጂረቹ"]},{"type":"verse","number":1,"content":["ያ መነ እስራኤል ዱቢ ከነ፣ ፋሩ ቦእቻ ከን አን ዋኤኬሰኒፍ ቦኡ ከነ ዸገኣ፦"]},{"type":"verse","number":2,"content":[{"text":"“ዱርብ ቁልቁልቲን እስራኤል ኩፍቴርት፤","poem":1},{"text":"እሼን ለመተ ህንካቱ፤","poem":2},{"text":"ብዩመሼ ኬሰት ገተምቴ","poem":1},{"text":"ነመ ኦል እሼ ቀቡ ቶኮሌ ዸብዴ።”","poem":2}]},{"type":"verse","number":3,"content":["ዋቀዮ ጎፍታን አከነ ጄዸ፦",{"text":"“መጋላ ሎልቶተ ኩመ ቶኮ እስራኤሊፍ ቦባፍቴፍ","poem":1},{"text":"ዽበ ቶኮ ቆፈቱ ሀፈ፤","poem":2},{"text":"መጋላ ሎልቶተ ዽበ ቶኮ ቦባፍቴፍ","poem":1},{"text":"ኩዸን ቆፈቱ ሀፈ።”","poem":2}]},{"type":"verse","number":4,"content":["ዋቀዮ መነ እስራኤሊን አከነ ጄዸ፦",{"text":"“ነ በርባደዻቲ ጅራዻ፤","poem":1}]},{"type":"verse","number":5,"content":[{"text":"ቤትኤልን ህንበርባደትና፤","poem":2},{"text":"ግልጋል ህንዸቅና፤","poem":1},{"text":"ቤርሼባትስ ህንጬእና።","poem":2},{"text":"ግልጋል ዹጉማን ንቦጅአምት፤","poem":1},{"text":"ቤትኤልስ ንዸበምት።”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዋቀዮን በርባደዻቲ ጅራዻ፤","poem":1},{"text":"ዮ ከና አቺ እን አኩመ እብዳመነ ዮሴፍ ኬሰ በኤ ሀጣኣ፤","poem":2},{"text":"እብድ ሱን እሼ ጉበ፤","poem":1},{"text":"ቤትኤልስ ነመ እራ ዻምሱ ቶኮዩህንቀባቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"እስን ወረ ሙርቲ ቀጄላ ሀዻት ጌደርተኒ","poem":1},{"text":"ቀጄሉማስ ለፈት ሀርጫፍተኒዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"እን ኡርጂወን ቶርቢፊ ኡርጂወን ሰዴ ኡሜ፣","poem":1},{"text":"ከን ዱከነ በሪት ጌደሩ፣","poem":2},{"lineBreak":true},{"text":"እን ጉያ ዱከኔሴ ሀልከን ጎዹ፣","poem":2},{"text":"ከን ገላነ ኬሳ ብሻን ኦል ዋሜ","poem":1},{"text":"ፉለ ለፈ ጎጋረት ዸንገላሱ","poem":2},{"lineBreak":true},{"text":"መቃንሳ ዋቀዮዸ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እን ደኦ ጀባት በዲሰ ተሳ ፍደ፤","poem":1},{"text":"መጋላ ደላ ጀባ ቀብዱስ ንበርበዴሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"እሳን ነመ ከረረት ነመ እፈቱ ንጅቡ፤","poem":1},{"text":"ከን ዹጋ ዱበቱስ ንበልፉ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"እስን ህዬዪ ዽዺተኒ","poem":1},{"text":"አከ እሳን ምዻን እስኒ ኬነን ድርቅሲፍቱ።","poem":2},{"text":"ከናፉ እስን መኔን ዸጋ ዮ እጃረተንዩ","poem":1},{"text":"መኔን ሰነ ኬሰ ህንጅራተን፤","poem":2},{"text":"እስን እዶወን ቆቲሳ ጋሪ ኬሰ ወይኒ ዮ ዻበተንዩ","poem":1},{"text":"ዳዺ ወይኒሳኒ ህንዹግደን።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"በሌሳንኬሰን ሀመም አከ ባይአቱፊ","poem":1},{"text":"ጩቡንኬሰንስ ሀመም ጉዳ አከ ተኤ ነንቤካቲ።","poem":2},{"lineBreak":true},{"text":"እሳን ቀጄልቶተ ሀጩጨኒ መተኣ እራ ፉዸቱ፤","poem":1},{"text":"ህዬዪስ መነ ሙርቲ ኬሰት ሙርቲ ቀጄላ ዾወቱ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ከናፉ ነምን ቀልቤፈታን ዬሮ አከሲት አፋን ቀበተ፤","poem":1},{"text":"በር ኩን በረ ሀማዻቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"አከ ሉቡዻን ጅራተኒፍ","poem":1},{"text":"ዋን ሀማ ዺሳቲ ዋን ጋሪ በርባዳ።","poem":2},{"text":"ዮስ አኩመ እስን ጄተን ሰነ","poem":1},{"text":"ዋቀዮ ዋቅን ዋን ሁንደ ደንደኡ እስን ወጅን ተአ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዋን ሀማ ጅባ፤ ዋን ጋሪ ጃለዻ፤","poem":1},{"text":"መነ ሙርቲ ኬሰት ሙርቲ ቀጄላ ጀቤሳ፤","poem":2},{"text":"ዋቀዮ ዋቅን ዋን ሁንደ ደንደኡ","poem":1},{"text":"ተሪ ሀምባ ዮሴፊፍ ገራ ላፈ ተኣቲ።","poem":2}]},{"type":"verse","number":16,"content":["ከናፉ ጎፍታን፣ ዋቀዮ ዋቅን ዋን ሁንደ ደንደኡ አከነ ጄዸ፦",{"text":"“ዳንዲ ሁንደረ ቦእቸ፣","poem":1},{"text":"ኦብዲ ኡመታ ሁንደረሞ እየ ዽጵናቱ ጅረ።","poem":2},{"text":"ቆናን ቡልቶትን አከ ቦአኒፍ፣","poem":1},{"text":"ወር ቦአንሞ አከ ወዋተኒፍ ንዋመሙ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አን ግዱኬሰን ዋነን ደርቡፍ","poem":1},{"text":"እዶ ዻባ ወይኒ ሁንደ ኬሳ ቦእቸቱ ተአ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"heading","content":["ጉያ ዋቀዮ"]},{"type":"verse","number":18,"content":[{"text":"እስን ወረ ጉያ ዋቀዮ","poem":1},{"text":"አርጉ ሀዊተኒፍ ወዮ!","poem":2},{"text":"እስን ማሊፍ ጉያ ዋቀዮ አርጉ ሀውቱ!","poem":1},{"text":"ጉያን ሱን ዱከነ መሌ እፈ ህንተኡቲ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ወን ኩን አኩመ ነመ ሌንጨ ጀላ በኤ","poem":1},{"text":"አፋን አማኬታ ቡኡ ቶኮት፤","poem":2},{"text":"ዮካን አከ ነመ መነሳ ሴኔ","poem":1},{"text":"ሀርከሳ ኬኘን መናረ ካአቴ","poem":2},{"lineBreak":true},{"text":"ቦፍት እሰ እዴ ቶኮት።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ጉያን ዋቀዮ እፈ ኡቱ ህንተእን ዱከነ ምቲ?","poem":1},{"text":"ዱከነ ሀማ እፈ ቶኮሌ ኦፍ ኬሳ ህንቀብኔ ምቲ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“አን አያነ አመንታኬሰኒ ነንጅበ፤ ነንቱፈዸስ፤","poem":1},{"text":"ወልዳኬሰንትስ ህንገመዱ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ኡቱ እስን ኣርሳ ጉበሙፊ ኬና ምዻኒ ና ፍደኒዩ","poem":1},{"text":"አን ጃለዼ እስንራ ህንፉዸዹ።","poem":2},{"text":"ኡቱ እስን ኣርሳ ነጋ ፍለተማ ና ፍደኒዩ","poem":1},{"text":"አን ሆማቱ እሰ ህንለካኡ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ወጨ ፋርፈትናኬሰኒ አሲ በሌሳ!","poem":1},{"text":"አን ሙዚቃ በገናኬሰኒ ህንዸጌፈዹ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ገሩ ሙርቲን ቀጄላን አኩመ ለጋ፣","poem":1},{"text":"ቀጄሉማንስ አኩመ ቡርቃ ህንጎግኔ ሃያኡ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“ያ መነ እስራኤል እስን ወጋ አፉርተመ","poem":1},{"text":"ገሞጂ ኬሰት ተኩማ ኣርሳፊ ኬና ና ፍደኒርቱ?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"እስን ዋን ሀርኩመኬሰኒን ቶልፈተን","poem":1},{"text":"ጄቹንስ ገልመ ዋቄፈትና ሞቲኬሰኒ፣","poem":2},{"lineBreak":true},{"text":"ኡቱባ ዋቀኬሰን ቶልፈማቲፊ","poem":2},{"lineBreak":true},{"text":"ፈኪ ኡርጂ ዋቀኬሰኒ ኦል ፉተኒርቱ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ከናፉ አን አከ እስን ቦጅአምተኒፍ፣","poem":1},{"text":"ደማስቆዻን ገመት እስነን ኤርገ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ እን መቃንሳዋቀ ዋን ሁንደ ደንደኡ ተኤ ሱን።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}