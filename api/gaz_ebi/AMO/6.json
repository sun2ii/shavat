{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"AMO","translationId":"gaz_ebi","name":"አሞስ","commonName":"አሞስ","title":"ራጂ አሞስ","order":30,"numberOfChapters":9,"sha256":"1ff75efc7cda42dffedba984af057e61e6a62e47890b07f72d6cfe713acdbbe2","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gaz_ebi/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":6,"content":[{"type":"heading","content":["ወረ ያዶ መሌ ጅራተኒፍ ወዮ"]},{"type":"verse","number":1,"content":[{"text":"ያ ወረ ያዶ መሌ ጥዮን ኬሰ ጅራተን፣","poem":1},{"text":"ከኔን ቱሉ ሰማርያረ ዋን ነጋዻን ጅራተን ሴተን፣","poem":2},{"text":"እሳን ነሞተ ኡልፋቶ ሰበ ዱሪ፣","poem":1},{"text":"ከኔን ሰብን እስራኤል ገረሳኒ ዹፉፍ ወዮ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ገረ ካልኔት ደርባቲ እላላ፤","poem":1},{"text":"አቺ ከኣቲ ገረ ሀማት ጉድቻ ዸቃ፤","poem":2},{"lineBreak":true},{"text":"ኤርገሲሞ ጋት ፍልስጤም ኬሳት ገድ ቡኣ።","poem":2},{"text":"እሳን ሞቱሞተኬሰን ለማን ጫሉ?","poem":1},{"text":"ብይሳኒ ብየኬሰን ጫላ በልአታ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እስን ጉያ ሀማ ፈጌስተኒ","poem":1},{"text":"ቡልቺንሰ ጄቁምሳ ፍዱ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እስን ስሬ እልከ አርባቲን ሚዸግፈሜረ ጪፍቱ፤","poem":1},{"text":"ስሬኬሰን ድንኪረ ቦቆቱ።","poem":2},{"text":"እስን ጦባላ ሆላ ፍለተሞፊ","poem":1},{"text":"ጀቢ ጮጮሞ ኛቱ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እስን ሰገሌ በገናቲን ዌዱ ፋይዳ ህንቀብኔ ዌድፍቱ፤","poem":1},{"text":"አኩመ ዳዊትስ ሜሻ ሙዚቃ ቀቀጄልፈቱ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እስን ጦፎ ኬሳ ዳዺ ወይኒ ዹግዱ፤","poem":1},{"text":"ድበተ አከ መሌ ጋሪ ድበቱ፤","poem":2},{"lineBreak":true},{"text":"ገሩ በዲሰ ዮሴፊፍ ህንገድተን።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ከናፉ እስን ወረ ጀልቀበት ቦጅአመን ወጅንቦጅአምተኒ ፉዸተምቱ፤","poem":1},{"text":"ቡራቁፊ በሸነኑንኬሰን ንሀፈ።","poem":2}]},{"type":"heading","content":["ዋቀዮ ኦፍ ቱሉማ እስራኤል ጅበ"]},{"type":"verse","number":8,"content":["ዋቀዮ ጎፍታን ኦፊሳቲን ከከቴረ፤ ዋቀዮ ዋቅን ዋን ሁንደ ደንደኡ አከነ ጄዸ፦",{"text":"“አን ኦፍ ቱሉማ ያቆብ ነንበልፈ፤","poem":1},{"text":"ደአትኖሳስ ነንጅበ፤","poem":2},{"text":"አን መጋለቲፊ ዋን እሼ ኬሰ ጅሩ ሁንደ","poem":1},{"text":"ደበርሴ ነንኬነ።”","poem":2}]},{"type":"verse","number":9,"content":["ነሞትን ኩዸን ዮ መነ ቶኮ ኬሰት ሀፈን እሳንስ ንዹሙ።"]},{"type":"verse","number":10,"content":["ዮ ፍር ሬፈ ባሴ ጉቡ ቶኮ መነ ሰነ ኬሳ ባሱፍ ዹፌ ነመ ዾከቴ አች ጅሩ ከሚንዩ፣ “ነምን ቶኮዩ ስ ወጅን ጅራ?” ጄዼ ጋፈቴ ነምች ሱን፣ “ህንጅሩ” ጄዼን፣ እን “ጨልእስ! ኑ መቃ ዋቀዮ ዸኡ ህንቀብኑ” ጄዻን።"]},{"type":"verse","number":11,"content":[{"text":"ኩኖ ዋቀዮ አጀጀ ኬኔራቲ፣","poem":1},{"text":"መኔን ጉርጉዳን ንበርበዳኡ፤","poem":2},{"lineBreak":true},{"text":"መኔን ጥጥኖንስ ንጨጨቡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ፈርዴን ከታወንረ ንፊጉ?","poem":1},{"text":"ነምን ቶኮ ቆትዮዻን አች ንቆታ?","poem":2},{"text":"እስን ገሩ ሙርቲ ቀጄላ ገረ ሱሚት፣","poem":1},{"text":"እጀ ቀጄሉማስ ገረ ሀዻት ጌደርተኒርቱ፤","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እስን ወረ ሎዴባር ሞአቹት ገመደኒ፣","poem":1},{"text":"“ኑ ሁምነኬኛን ቃርናይም ቀበትኔ ምቲ?” ጄተኒዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ዋቀዮ ዋቅን ዋን ሁንደ ደንደኡ አከነ ጄዻቲ፤","poem":1},{"text":"“ያ መነ እስራኤል፣ አን ሰበ ሌቦ ሀማቲ ጀልቀቤ","poem":2},{"text":"ሀመ ሱሉለ አረባት","poem":1},{"text":"ከራኬሰን ሁንደረት እስን ጩንቁርሱ ቶኮ እስንትን ካሰ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/AMO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/AMO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/AMO/5.json","previousChapterAudioLinks":{},"numberOfVerses":14}