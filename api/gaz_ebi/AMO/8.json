{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"AMO","translationId":"gaz_ebi","name":"አሞስ","commonName":"አሞስ","title":"ራጂ አሞስ","order":30,"numberOfChapters":9,"sha256":"1ff75efc7cda42dffedba984af057e61e6a62e47890b07f72d6cfe713acdbbe2","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gaz_ebi/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":8,"content":[{"type":"heading","content":["ጉቦ እጀ ብልቻቴን ጉተሜ"]},{"type":"verse","number":1,"content":["ዋቀዮ ጎፍታን ዋን ከነ ነት አርግሲሴ፦ ኩን ጉቦ እጀ ብልቻቴን ጉተሜዸ።"]},{"type":"verse","number":2,"content":["እንስ፣ “አሞስ፣ አት ማል አርጉት ጅርተ?” ጄዼ ነ ጋፈቴ። አንሞ፣ “ጉቦ እጀ ብልቻቴን ጉተሜ ቶኮ” ጄዼን ዴብሴፍ። ኤርገሲ ዋቀዮ አከነ ናን ጄዼ፤ “ሰበኮ እስራኤልት ዬሮን ዹፌረ፤ አን ስአች እሳን ህንበራሩ።”"]},{"type":"verse","number":3,"content":["ዋቀዮ ጎፍታን አከነ ጄዸ፤ “ጋፈስ ፋርፈትናን መነ ቁልቁሉማ ኬሳ ቦእቸት ጌደረመ። ሬፍ አከ መሌ ሄዱን ለፈ ሁንደት ገተመ! ጨልእሱንስ ንተአ!”"]},{"type":"verse","number":4,"content":[{"text":"እስን ወር ረከቶተ ዽዺተኒ","poem":1},{"text":"ህዬዪ ብየቲ በሌስተን ዋን ከነ ዸገኣ፤","poem":2}]},{"type":"verse","number":5,"content":["እስን አከነ ጄቱ፤",{"text":"“አከ ኑ ምዻን ጉርጉረኑፍ","poem":1},{"text":"ባቲን ሃራን ዮም ጎበነ?","poem":2},{"text":"አከ ኑ ቀመዲ ገባ ባፈትኑፍ","poem":1},{"text":"ሰንበትን ዮም ደርበ?”","poem":2},{"text":"እስን ወር ሰፈርቱ ጥኖት ፈየደምተኒ","poem":1},{"text":"ገቲሞ ኦል ካፍተን፣ መዳሊ ሶባቲን","poem":2},{"lineBreak":true},{"text":"ነመ ጎዎምስተኒ ሳምቱ፤","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ህዬዪ ሜቲዻን፣","poem":1},{"text":"ረከታሞ ኮጴ ሚለ ለማኒቲን ብተተኒ","poem":2},{"lineBreak":true},{"text":"ግርዲስ ቀመዲ ወጅን ጉርጉረቱ።","poem":2}]},{"type":"verse","number":7,"content":["ዋቀዮ አከነ ጄዼ ኡልፍነ ያቆቢን ከከቴረ፤ “አን ጎንኩማ ዋን እሳን ሆጄተን ቶኮሌ ህንእራንፈዹ።"]},{"type":"verse","number":8,"content":[{"text":"“ሰበቢ ከናፍ ለፍት ክርክርቴ","poem":1},{"text":"ነሞትን እሼ ኬሰ ጅራተን ሁንድ ህንቦአኒ?","poem":2},{"text":"ጉቱማን ብየ ሰና አኩመ ለገ አበያ ኦል ከአ፤","poem":1},{"text":"እሼን አኩመ ለገ ግብጥ","poem":2},{"lineBreak":true},{"text":"ኦል ደደርበተምቴ ልቅምፈምት።”","poem":2}]},{"type":"verse","number":9,"content":["ዋቀዮ ጎፍታን አከነ ጄዸ፤ “በረ ሰነ፣",{"text":"“አን አከ አዱን ሳፋዻን ዺቴ","poem":1},{"text":"ለፍትስ ጉዩመ አዲዻን ዱከኖፍቱ ነንጎዸ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አን አያነ አመንቲኬሰኒ ገደት፣","poem":1},{"text":"ስርበኬሰን ሁንደስ ቦእቸት ነንጌደረ።","poem":2},{"text":"አን አከ እስን ሁንድ ወያ ገዳ ኡፈተኒ","poem":1},{"text":"መታኬሰን ሃደተን ነንጎዸ።","poem":2},{"text":"አን ዬሮ ሰነ አኩመ ቦእቸ እልመ ቶክቻ፣","poem":1},{"text":"ዹመሳስ አከ ጉያ ሀዻኣ ነንጎዸ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ዋቀዮ ጎፍታን አከነ ጄዸ፤","poem":1},{"text":"“ዬሮን አን ብየቲት ቤለ ፍዱ ቶኮ ንዹፈ፤","poem":2},{"text":"እንስ ቤለ ዱቢ ዋቀዮ ዸገኡት መሌ","poem":1},{"text":"ቤለ ኛታ ዮካን ዼቡ ብሻኒ ምት።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ነሞትን ዱቢ ዋቀዮ በርባቸ","poem":1},{"text":"ገላና ገረ ገላናት፣","poem":2},{"text":"ካባ ገረ በአ ቢፍቱት ንጆሩ፤","poem":1},{"text":"ገሩ ህንአርገተን።","poem":2}]},{"type":"verse","number":13,"content":["“በረ ሰነ",{"text":"“ሸመረን በበሬዶፊ","poem":1},{"text":"ደርገጎትን ዺራ ጀጀቦን ዼቦተኒ ገገቡ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ወር ጩቡ ሰማርያቲን ከከተን","poem":1},{"text":"ዮካን ‘ያ ዳን ዹጋ ዋቀኬ ጅራታ’ ጄዸን፣","poem":2},{"lineBreak":true},{"text":"ዮካን ወር ‘ዹጋ ዋቀ ቤርሼባ’ ጄዸኒ","poem":2},{"lineBreak":true},{"text":"ከከተን አከ ለመተ ህንካኔፍ ንኩፉ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/AMO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/AMO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/AMO/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}