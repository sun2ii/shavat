{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"AMO","translationId":"gaz_ebi","name":"አሞስ","commonName":"አሞስ","title":"ራጂ አሞስ","order":30,"numberOfChapters":9,"sha256":"1ff75efc7cda42dffedba984af057e61e6a62e47890b07f72d6cfe713acdbbe2","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gaz_ebi/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":9,"content":[{"type":"heading","content":["በርበዴፈሙ እስራኤል"]},{"type":"verse","number":1,"content":["ኡቱ ጎፍታን እዶ ኣርሳ ብረ ዻበቱ ነንአርጌ፤ እንስ አከነ ጄዼ፦",{"text":"“አከ ቡሳወን በልበላ ራፈመኒፍ","poem":1},{"text":"ፊጤ ኡቱባ ዸእ።","poem":2},{"text":"መታ ነመ ሁንዳረት ገድ እሳን ሀርጫስ፤","poem":1},{"text":"ወረ ሀፈንሞ አነቱ ጎራዴዻን ፍጠ።","poem":2},{"text":"ቶኮንሳኒዩ በቀተኒ ህንበአን፤","poem":1},{"text":"እሳን ኬሳ ነምን ቶኮዩ ህንምልቁ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዮ እሳን ቦለ ቅሌ ቆተተንዩ","poem":1},{"text":"ሀርክኮ አቺ እሳን ፉዸ።","poem":2},{"text":"ዮ እሳን ሰሚት ኦል በአንዩ","poem":1},{"text":"አን አቺ ገድ እሳን ነንቡሰ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዮ እሳን ፊጤ ቀርሜሎስረ","poem":1},{"text":"ዾከተንዩ፣ አን አቺ አደምሴ ቀቤገድ እሳን ነንፍደ።","poem":2},{"text":"ዮ እሳን ገላነ ጀለ ነ ዾከተንዩ፣","poem":1},{"text":"አን አከ እን አችት እሳን እዱፍ ቦፈ እት ነንአጀጀ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዮ ዲኖትንሳኒ ቦጅአኒ እሳን ፉዸተን፣","poem":1},{"text":"አችት ጎራዴ እሳን ፍጡ እት ነንአጀጀ።","poem":2},{"lineBreak":true},{"text":"“አን ዋን ጋሪዻፍ ኡቱ ህንተእን","poem":1},{"text":"ዋን ሀማዻፍ እጀኮ እሳንረ ነንቡሰ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ጎፍታን፣ ዋቀዮ ዋን ሁንደ ደንደኡ ለፈ ንቱቀ፤","poem":1},{"lineBreak":true},{"text":"እሼንስ ንበቅጥ፤","poem":1},{"text":"ወን እሼረ ጅራቱ ሁንድኑ ንቦአ፤","poem":2},{"text":"ብየቲን ጉቱን አከ ለገ አበያ ኦል ካት፤","poem":1},{"text":"ኤርገሲስ አከ ለገ ግብጥ ገድ ገልት፤","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እን ደርቢሳ ኦል ዼራ ሰሚረት እጃረቴ","poem":1},{"text":"ሁንዴሳ ለፈረ ዻበቱ፣","poem":2},{"text":"እን ብሻኖተ ገላና ዋሜ","poem":1},{"text":"ፉለ ለፋረት ገድ ሮብሱ ሱን","poem":2},{"lineBreak":true},{"text":"መቃንሳ ዋቀዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“እስን እስራኤሎትን","poem":1},{"text":"አናፍ አኩመ ሰበ እቶጵያ ምቲ?”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2},{"text":"“አን እስራኤሎተ ብየ ግብጢቲ፣","poem":1},{"text":"ፍልስጤሞተ ከፍቶሪ፣","poem":2},{"lineBreak":true},{"text":"ወረ ሶርያሞ ቂሪ ባሴ ህንፍድኔ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ዹጉማን እጅ ዋቀዮ ጎፍታ","poem":1},{"text":"ሞቱማ ጩበማረ ጅረ።","poem":2},{"text":"አን ፉለ ለፋራ እሰ ነንበሌሰ፤","poem":1},{"text":"ተኡስ አን ጉቱማን ጉቱት መነ ያቆብ ህንበሌሱ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“አን አጀጀ ኬኔ","poem":1},{"text":"አኩመ ምዻን ግንግልቻዻን","poem":2},{"lineBreak":true},{"text":"ግንግልፈሜ እጅ ቶኮዩ ለፈ ህንቡኔ ሰነ","poem":2},{"text":"ሰቦተ ሁንደ ግዱት","poem":1},{"text":"መነ እስራኤል ነንግንግልቸ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጩበሞትን ሰበኮ ግዱ ጅራተን ሁንድ","poem":1},{"text":"ወር፣ ‘በላን ኑ ህንአርገቱ","poem":2},{"text":"ዮካን ኑት ህንዹፉ’ ጄዸን","poem":1},{"text":"ሁንድ ጎራዴዻን ዹሙ።","poem":2}]},{"type":"heading","content":["ሃሮምፈሙ እስራኤል"]},{"type":"verse","number":11,"content":["“አን በረ ሰነ ኬሰ ዱንካነ ዳዊት",{"text":"“ከን ኩፌ ሰነ ዴብሴ ነንዻበ።","poem":1},{"text":"ከን ተርሰኤስ ወልት ነንሱጰ፤","poem":2},{"lineBreak":true},{"text":"ዲገማሳ እዶት ዴብሴ","poem":2},{"lineBreak":true},{"text":"አከ ዱራት ነንእጃረ፤","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኩንስ አከ እሳን ሀምባ ኤዶሚፊ","poem":1},{"text":"ሰቦተ መቃኮቲን ዋመመን ሁንደ ዻለኒፍ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ፣ እን ዋን ከነ ሆጄቱ።","poem":2}]},{"type":"verse","number":13,"content":["ዋቀዮ አከነ ጄዸ፤ “ኩኖ፣ በር እት ነምን ሃሙ ቶኮ እሰ ቆቱ ቀቀቡ፣",{"text":"“ነምን ወይኒ ዻቡሞ","poem":1},{"text":"እሰ ጩንፉ ቀቀቡ ቶኮ ንዹፈ፤","poem":2},{"text":"ዳዺን ወይኒ ሃራን ቱሉወንራ ንጮጮጰ፤","poem":1},{"text":"ጋረን ሁንደ ኬሳስ ንያአ።","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"አን ሰበኮ እስራኤልን ቦጁዻ ነንዴብሰ።","poem":2},{"lineBreak":true},{"text":"“እሳንስ መጋላወን ዲገመን ዴብሰኒ እጃረኒ ኬሰ ንጅራቱ።","poem":1},{"text":"እሳን ወይኒ ዻበኒ፣ ዳዺ ወይኒሳኒ ንዹጉ፤","poem":2},{"lineBreak":true},{"text":"እሳን ብቅልቱ ዻበተኒ እጀሳ ንኛቱ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አን እስራኤሎተ ብየ ኦፊሳኒ ኬሰ ነንዻበ፤","poem":1},{"text":"እሳን ብየ አን እሳኒፍ ኬኔ ኬሳ","poem":2},{"lineBreak":true},{"text":"ለመተ ህንቡቅፈመን፣”","poem":2},"ጄዸ ዋቀዮ ዋቅንኬ።"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/AMO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/OBA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/AMO/8.json","previousChapterAudioLinks":{},"numberOfVerses":15}