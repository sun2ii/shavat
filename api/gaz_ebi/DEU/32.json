{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"DEU","translationId":"gaz_ebi","name":"ኬሰ ዴቢ","commonName":"ኬሰ ዴቢ","title":"ሴረ ኬሰ ዴቢ","order":5,"numberOfChapters":34,"sha256":"38e75047b82fecb66154872c0491f67f5a888f40e5aebee5809bde01cd75323d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/gaz_ebi/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":[{"text":"ያ ሰሚወን፣ ዸገኣ፤ አን ነንዱበዸ፤","poem":1},{"text":"ያ ለፈ፣ አትስ ዱቢ አፋንኮቲ ዸገእ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"በርሲስንኮ አከ ቦካ ሃሮቡ፤","poem":1},{"text":"ዱቢንኮስ አከ ፍጤንሳ ገድ ሃጮጮጱ፤","poem":2},{"text":"መርገረት አከ ቲፉ፣","poem":1},{"text":"ብቅልቱ ጮርቃረትስ አከ ቦካ ጉዳ ሃሮቡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"አን መቃ ዋቀዮ ነንለብሰ።","poem":1},{"text":"ጉድነ ዋቀኬኛ ጀጀዻ!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እን ከታዸ፤ ሆጂንሳ ሙዳ ህንቀቡ፤","poem":1},{"text":"ዳንዲወንሳ ሁንድኑስ ቀጄላዸ።","poem":2},{"text":"እን ዋቀ አመነማ ህንዶጎጎሬ፣","poem":1},{"text":"ቶላፊ ቀጄላዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"እሳን ሀምነ እሰት ሆጄተኒሩ፤","poem":1},{"text":"ስአች እሳን ሰበቢ ቃኒሳኒቲፍ እጆሌሳ ምት፤","poem":2},{"lineBreak":true},{"text":"እሳን ዸሎተ ጀልኣፊ ምጪረማዸ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ያ ሰበ ጎዋ፣ ከን ኦጉማ ህንቀብኔ፣","poem":1},{"text":"አት አከስት ዋቀዮፍ ዴቢ ኬንታ?","poem":2},{"text":"እን አባኬ፣ ኡማኬ፣","poem":1},{"text":"ከን ስ ሆጄቴፊ ስ ቶልቼ ምቲ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"በሮተ ዱሪ ያደዹ፤","poem":1},{"text":"ዸሎተ ደርቤሌ ቀልቤፈዹ።","poem":2},{"text":"እን ሲፍ እብሳቲ አባኬ ጋፈዹ፤","poem":1},{"text":"ማንጉዶተኬስ ጋፈዹ፤ እሳን ስት ህሙቲ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዋቅን ዋን ሁንዳ ኦሊ ዮሙ ሰቦታፍ ዻለ እሳኒፍ ኬኔት፣","poem":1},{"text":"ዮሙ ሰኚ ነማስ ገርገር ቆቆዴት፣","poem":2},{"text":"አኩመ ባይእነ እልማን እስራኤልት","poem":1},{"text":"ነሞታፍ ዳሪ ዻቤ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ቆድን ዋቀዮ ሰበሳት፤","poem":1},{"text":"ያቆብሞ ዻለ ዹንፋሳት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"እን ለፈ ገሞጂ፣ ለፈ ኦናቲፊ","poem":1},{"text":"ገሞጂ ነመ ጉቡ ኬሰት እሰ አርገቴ።","poem":2},{"text":"እን ጋቸነ ተኤፊ እሰ ኤጌ፤","poem":1},{"text":"አከ ቀሮ እጀ እሳትስ እሰ ኤጌ፤","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አኩመ ርሳን መነሼ ዲግዴ","poem":1},{"text":"እልማንሼረ ቆቾ ቀብዱ፣","poem":2},{"text":"አኩመ ቆቾሼ በልእፍቴ ኦል እሳን ፉዸቱ፣","poem":1},{"text":"አኩመ ቆቾ እሼቲንስ እሳን ባቱ ሰነ፣","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዋቀዮ ቆፈቱ እሰ ጌጌሴ፤","poem":1},{"text":"ዋቅን ኦርማ ቶኮዩ እሰ ወጅን ህንቱሬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"እን ለፈ ኦል ከኣረ እሰ ቡራቅስሴ፤","poem":1},{"text":"ምዻን ለፈ ቆቲሳ እሰ ሶሬ።","poem":2},{"text":"ከታ ኬሳ ደመ እሰ ኛችሴ፤","poem":1},{"text":"ዸጋ ጉራቸ ኬሳሞ ዘይቲ ኬኔፍ፤","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዸዻፊ ኣነን ሳወኒፊ ቡሻዬ፣","poem":1},{"text":"ጦባላወኒፊ ሬኦተ ጮመን፣","poem":2},{"text":"ኮርቤዪ ሆላ ፍለተሞ ባሻን፣","poem":1},{"text":"እጀ ቀመዲ ጋሪስ እሰ ሶሬ።","poem":2},{"text":"አት ጩንፋ ዺገ ወይኒ ቁልቁሉስ ንዹግዴ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ይሹሩን ንገበቴ፤ ንዺቴ፤","poem":1},{"text":"ኛቴ ቁፌ፤ ንኡልፋቴ፤ ንጩሉሉቄ።","poem":2},{"text":"ዋቀ እሰ ኡሜ ንዺሴ፤","poem":1},{"text":"ከታ ፈይሳሳ ተኤስ ንቱፈቴ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እሳን ዋቆተ ኦርማቲን እሰ ህናፍስሰን፤","poem":1},{"text":"ዋቆተ ጅብሲሶ እሳኒቲንስ እሰ ዼከምሲሰን።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እሳን ሀፉሮተ ሀሞ ዋቀ ህንተእኒፍ፣","poem":1},{"text":"ዋቆተ ህንቤክኒፍ፣","poem":2},{"lineBreak":true},{"text":"ዋቆተ ሬፉ ዹፈኒፍ፣","poem":2},{"lineBreak":true},{"text":"ዋቆተ አቦቲንኬሰን ህንሶዳቲኒፍ ኣርሳ ዽኤሰን።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"አት ከታ ስ ዸልቼ ገንቴ፤","poem":1},{"text":"ዋቀ ስ ኡሜ እራንፈቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ዋቀዮ ዋን ከነ አርጌ እሳን ቱፈቴ፤","poem":1},{"text":"እን እልማኒፊ እንተለን ኦፊሳት ኣሬራቲ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እንስ፣ “አን ፉለኮ እሳን ዱራ ነንዾክፈዸ፤","poem":1},{"text":"ዹመሳኒስ ነንአርገ” ጄዼ፤","poem":2},{"text":"እሳን ዸሎተ ጀልኣ፣","poem":1},{"text":"እጆሌ ህንአመነምኔዻቲ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"እሳን ዋን ዋቀ ህንተእኒን ነ ህናፍስሰን፤","poem":1},{"text":"ዋቆተ ቶልፈሞሳኒ ከኔን ፋይዳ ህንቀብኔንስ ነ ኣርሰን።","poem":2},{"text":"አንስ ወረ ሰበ ህንተእኒን አከ እሳን ህናፈን ነንጎዸ፤","poem":1},{"text":"ሰበ ሁበትና ህንቀብኔንስ እሳን ነንኣርሰ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዼከምሰኮቲን እብድ ቀብሲፈሜራቲ፤","poem":1},{"text":"እንስ ሀመ ሲኦልት ገድ ዽዽሜ ንቦበአ።","poem":2},{"text":"ለፋፊ ዋን እሼን ባፍቱ ንኛተ፤","poem":1},{"text":"ሁንዴ ቱሉወኒትሌ እብደ ቀብሲሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“አን ዋን ሀማ እሳንረ ነንቱለ፤","poem":1},{"text":"ጥየኮስ እሳንት ነንፍጠዸ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ቤለ ሀማ፣ ጎልፋ ኛቴ ነመ ፍጡፊ","poem":1},{"text":"ዸእቸ እሳንት ነንኤርገ፤","poem":2},{"text":"እልካን ብኔንሳ ቀረማሳ፣","poem":1},{"text":"ሀዻ ቡቲ ለፈረ ሎቱስ እሳንት ነንኤርገ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ከራ ጉዳረት ጎራዴን ወረ እጆሌ ህንቀብኔ እሳን ጎዸ፤","poem":1},{"text":"መነሳኒት ሶዳቱ ሞአ።","poem":2},{"text":"ደርገጎትኒፊ ደርገጌቲወን፣","poem":1},{"text":"ዳእመኒፊ ማንጉዶትን ንዹሙ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"አንስ እሳን ነንብትኔሰ፤","poem":1},{"text":"ያደኖሳኒስ ሰኚ ነማ ኬሳ ነንበሌሰ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ገሩ አከ ዲኖትንሳኒ ኦፍ ቱለኒ፣","poem":1},{"text":"‘ሀርከኬኘቱ ሞአቴ መሌ፣","poem":2},{"text":"ዋቀዮ ዋን ከነ ሁንደ ህንጎኔ’ ህንጄኔ፣","poem":1},{"text":"አን ዻደትኖ ዲና ሶዳዼረ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"እሳን ሰበ ቀልቢ ህንቀብኔ፣","poem":1},{"text":"ከን ሁበትና ቶኮሌ ህንቀብኔዸ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"እሳን ኡቱ ኦጌዪ ተአኒ ዋን ከነ ሁበተኒ","poem":1},{"text":"ስላ ዹመሳኒ ንቤኩ ቱረን!","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ዮ ከታንሳኒ እሳን ጉርጉሬ መሌ፣","poem":1},{"text":"ዮ ዋቀዮ ደበርሴ እሳን ኬኔ መሌ፣","poem":2},{"text":"አከምት ነምን ቶኮ ነመ ኩመ ቶኮ","poem":1},{"text":"ዮካን ነምን ለመ ነመ ኩመ ኩዸን ጉግሰ?","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ከታንሳኒ አከ ከታኬኛ ምት፤","poem":1},{"text":"ከነሞ ዲኖትንኬኘዩ ህንገነን።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ወይኒንሳኒ ወይኒ ሶዶሚቲፊ","poem":1},{"text":"ለፈ ቆቲሳ ጎሞራራ ዹፈ።","poem":2},{"text":"እጅ ወይኒሳኒ ሱሚዻን፣","poem":1},{"text":"ሁርቡንሳኒስ ዋን ሀዻኡን ጉተሜረ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ወይኒንሳኒ ሀዻ ቦፋ፣","poem":1},{"text":"ሱሚ ቦፈ ሀዻንሳ ነመ አጄሱት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“ኩን ዋን ነ ብረት ኤገሜ፣","poem":1},{"text":"ከን ገልሜኮ ኬሰትስ ቻፓዻን ጩፈሜ ምቲ?","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ሃሎ ባሱን ከንኮት፤ አን ገቲ ነንዴብሰ።","poem":1},{"text":"ዬሮሳት ሚልሳኒ ንሙጩጫተ፤","poem":2},{"text":"ጉያን በዲሰሳኒ ዽኣቴረ፤","poem":1},{"text":"በዲስንሳኒስ እሳንት አሪፈቴረ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"ዋቀዮ ዮሙ አከ እሳን ሁምነ ዸበን፣","poem":1},{"text":"አከ ገርብችስ ተኡ ነምን ብርመዱን ቶኮዩ ህንሀፍኔ አርጉት፣","poem":2},{"text":"ሰበሳቲፍ ንሙርቴሰ፤","poem":1},{"text":"ተጃጅልቶተሳቲፍስ ገራ ላፈ።","poem":2}]},{"type":"verse","number":37,"content":[{"text":"እንስ አከነ ጄዸ፦ “ከታን እሳን እት ደአተን፣","poem":1},{"text":"ዋቆትን ቶልፈሞንሳኒ አመ ኤሰ ጅሩ?","poem":2}]},{"type":"verse","number":38,"content":[{"text":"ዋቆትን ጮመ ቀልመሳኒ ኛተን፣","poem":1},{"text":"ከኔን ዽባዩ ዳዺ ወይኒሳኒ ዹገንስ ኤሰ ጅሩ?","poem":2},{"text":"ሜ ከአኒ እሳን ሃገርጋረን!","poem":1},{"text":"ሜ ደአትኖ ሃኬነኒፍ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“አከ አን መታንኮ እሰ ተኤ ቤካ!","poem":1},{"text":"አነ መሌ ዋቅን ብራ ህንጅሩ።","poem":2},{"text":"አን ነንአጄሰ፤ ነንጅራችሰስ፤","poem":1},{"text":"ነንመዴሰ፤ ነንፈይሰስ፤","poem":2},{"lineBreak":true},{"text":"ነምን ሀርከኮቲ ባሱ ደንደኡ ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"verse","number":40,"content":[{"text":"አን ዹጉማን በረ በራን ጅራታዻቲ","poem":1},{"text":"ሀርከኮ ሰሚት ኦል ቀቤ ነንከከዸ፤","poem":2}]},{"type":"verse","number":41,"content":[{"text":"አን ዮሙን ጎራዴኮ ጨለቅሳ ቀረዼ","poem":1},{"text":"ሀርክኮ ሙርቲዻፍ እሰ ቀበቱት፣","poem":2},{"text":"አን ዲኖተኮ ሃሎ ነንበአ፤","poem":1},{"text":"ወረ ነ ጅበኒፍሌ ዋን እሳኒፍ መሉ ነንኬነ።","poem":2}]},{"type":"verse","number":42,"content":[{"text":"ዮሙ ጎራዴንኮ ፎን ኛቱት፣","poem":1},{"text":"አን አከ ጥይኮ ዺጋን መቻኡ ነንጎዸ፤","poem":2},{"text":"ዺግን ሱንስ ዺገ ወረ ቀለመኒቲፊ ቦጅአመኒ","poem":1},{"text":"ከን መታ ሆገንቶተ ዲናት።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"ሰበቢ እን ሃሎ ዺገ ተጃጅልቶተሳ በኡፍ፣","poem":1},{"text":"ያ ሰቦታ፣ ነሞተሳ ወጅን ገመዳ።","poem":2},{"text":"እን ዲኖተሳ ሃሎ በአ፤","poem":1},{"text":"ብያፊ ሰበሳቲፍ አራረ ንቡሰ።","poem":2}]},{"type":"verse","number":44,"content":["ሙሴንስ እያሱ እልመ ኑን ወጅን ዹፌ ዱቢወን ፋርፈትና ከነ ሁንደ ነሞተ ዸጌስሴ።"]},{"type":"verse","number":45,"content":["እንስ ዮሙ ዱቢወን ከኔን ሁንደ እስራኤሎተ ሁንደት ዱበቴ ፍጤት፣"]},{"type":"verse","number":46,"content":["አከነ እሳኒን ጄዼ፤ “አከ እሳን ዱቢወን ሴረ ከና ሁንደ ኦፍ ኤገናዻን ኤገኒፍ አከ እስን እጆሌኬሰን አጀጀን፣ ዱቢወን አን ሀርአ እፈ ባሴ እስንት ህሙ ሁንደ ቀልቢት ቀበዻ።"]},{"type":"verse","number":47,"content":["እሳን እስኒፍ ጅሬኘ መሌ ዱቢ ፋይዳ ህንቀብኔ ምት። ዱቢወን ከናን ብየ ለገ ዮርዳኖስ ጬተኒ ዻልተን ኬሰ በረ ዼራ ንጅራቱ።”"]},{"type":"heading","content":["ሙሴን ቱሉ ኔቦረት ዱኡሳ"]},{"type":"verse","number":48,"content":["ጋፈሱመ ዋቀዮ አከነ ጄዼ ሙሴት ህሜ፤"]},{"type":"verse","number":49,"content":["“ብየ ሞኣብ ከን ፉሌ ዬርኮ ጅሩ፣ ቱሉወን አባሪም ኬሰ ቱሉ ኔቦት ኦል በኢቲ ብየ ከነኣን፣ ብየ አን እስራኤሎታፍ ዻለ ጎዼ ኬኑ ፉሌት እላል።"]},{"type":"verse","number":50,"content":["አኩመ ኦቦሌስኬ አሮን ቱሉ ሆርረት ዱኤ ገረ አቦቲሳት ወልት ቀበሜ ሰነ፣ አትስ ቱሉ ያበቱ ሰነረት ንዱተ፤ ገረ አቦቲኬቲትስ ወልት ቀበምተ።"]},{"type":"verse","number":51,"content":["ኩንስ ዋን እስን ለማኑ ገሞጂ ሲን፣ ቃዴሽ ኬሰት ብሻን መሪባ ብረት ፉለ እስራኤሎታ ዱረት ነ አመኑ ድደኒፊ ሰበቢ እስራኤሎተ ግዱት ቁልቁሉማኮ ህንኤግኒፍ።"]},{"type":"verse","number":52,"content":["ከናፉ አት ፈጎት አርግተ መሌ ብየ አን እስራኤሎታፍ ኬኑ ሰነት ህንገልቱ።”"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/DEU/32.json","thisChapterAudioLinks":{},"nextCh