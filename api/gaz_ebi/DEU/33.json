{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"DEU","translationId":"gaz_ebi","name":"ኬሰ ዴቢ","commonName":"ኬሰ ዴቢ","title":"ሴረ ኬሰ ዴቢ","order":5,"numberOfChapters":34,"sha256":"38e75047b82fecb66154872c0491f67f5a888f40e5aebee5809bde01cd75323d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/gaz_ebi/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":33,"content":[{"type":"heading","content":["ሙሴን ጎሶተ እስራኤል ኤብሱሳ"]},{"type":"verse","number":1,"content":["ኤብ ሙሴን ነምን ዋቃ ሱን ኡቱ ህንዱእን ዱረ እቲን እስራኤሎተ ኤብሴ ከነ፤"]},{"type":"verse","number":2,"content":["እንስ አከነ ጄዼ፦",{"text":"“ዋቀዮ ቱሉ ሲናራ ዹፌ፤","poem":1},{"text":"እሳንረትስ ሴኢርራ አከ አዱ ገነማት በኤ፤","poem":2},{"lineBreak":true},{"text":"ቱሉ ጳራንራ እሳን ኤብሴ።","poem":2},{"text":"እን ቁልቁሎተሳ ኩማተመ ወጅን ዹፌ፤","poem":1},{"text":"ከራ ሀርከሳ ምርጋቲን እብደ ቦበኡቱ በኤ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዹጉማን ስቱ ሰበ ጃለተ፤","poem":1},{"text":"ቁልቁሎትን ሁንድኑ ሀርከኬ ኬሰ ጅሩ።","poem":2},{"text":"ሁንድሳኒ ሚለኬ ጀለት ኩፉ፤","poem":1},{"text":"ቀጄልፈመስ ስራ አርገቱ፤","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሙሴን ሴረ ኑ ኬኔረ፤","poem":1},{"text":"ኩንስ ዻለ ወልዳ ያቆብ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዬሮ ሆገንቶትን ሰባ","poem":1},{"text":"ጎሶተ እስራኤል ወጅን ወልት ቀበመንት","poem":2},{"lineBreak":true},{"text":"እን ይሹሩንረት ሞቲ ቱሬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“ሩቤን ሃጅራቱ መሌ ህንዱእን፤","poem":1},{"text":"ዮካን ባይእን ነሞተሳ ህንጥናትን።”","poem":2}]},{"type":"verse","number":7,"content":["ዋኤ ይሁዳስ አከነ ጄዼ፦",{"text":"“ያ ዋቀዮ፣ እየ ይሁዳ ዸገእ፤","poem":1},{"text":"ገረ ሰበ እሳትስ እሰ ፍድ።","poem":2},{"text":"እን ሀርከ ኦፊሳቲን ኦፍ ሃኤጉ።","poem":1},{"text":"ዮሙ እን ዲኖተሳቲን ወል ሎሉት ገርጋራሳ ተእ!”","poem":2}]},{"type":"verse","number":8,"content":["እን ዋኤ ሌዊስ አከነ ጄዼ፦",{"text":"“ቱሚሚፊ ኡሪሚንኬ","poem":1},{"text":"ተጃጅላኬ አመነማዻፍ ሃተኡ።","poem":2},{"text":"አት ለፈ ማሳህ ጄዸሙት እሰ ቆርቴ፤","poem":1},{"text":"ብሻን መሪባረት እሰ ሎልቴ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዋኤ አባፊ ሃዸሳስ፣","poem":1},{"text":"‘አን እሰ ህንአርግኔ’ ጄዼ።","poem":2},{"text":"እን ኦቦሎተሳ አዳን ህንባፈትኔ፤","poem":1},{"text":"እጆሌሳስ ህንቤክኔ፤","poem":2},{"text":"እሳን ዱቢኬቲፍ አጀጀመኒ","poem":1},{"text":"ከኩኬ ኤገኒሩቲ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እን አጀጀኬ ያቆብን፣","poem":1},{"text":"ሴረ ኬሞ እስራኤልን ንበርሲሰ።","poem":2},{"text":"ፉለኬ ዱረት እጣነ፣","poem":1},{"text":"እዶ ኣርሳኬቲረትሌ ኣርሳ ጉበሙ ጉቱ ንዽኤሰ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ያ ዋቀዮ፣ ኦጉማሳ ሁንደ ኤብሲፍ፤","poem":1},{"text":"ዋን ሀርክሳ ሆጄቱትስ ገመድ።","poem":2},{"text":"ሞኦ ወረ እሰት ከአኒ ጨብስ፤","poem":1},{"text":"አከ እሳን ለመተ ህንካኔ ጎዺቲ ዲኖተሳ ዸእ።”","poem":2}]},{"type":"verse","number":12,"content":["ዋኤ ቤንያም አከነ ጄዼ፦",{"text":"“ነምን ዋቀዮ እሰ ጃለቱ ኤጉምሰሳቲን ነጋን ሃጅራቱ፤","poem":1},{"text":"እን ጉያ ጉቱ እሰ ኤጋቲ፤","poem":2},{"lineBreak":true},{"text":"ነምን ዋቀዮ እሰ ጃለቱ ገቲቲሳ ግዱ ቦቆተ።”","poem":2}]},{"type":"verse","number":13,"content":["ዋኤ ዮሴፍ አከነ ጄዼ፦",{"text":"“ዋቀዮ ብየሳ ሃኤብሱ፤","poem":1},{"text":"ፍጤንሰ ፍለተማ ሰሚዻ ቡሱዻን","poem":2},{"lineBreak":true},{"text":"ብሻን ቦለ ገድ ፈጎ ኬሳቲን፣","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ምዻን ፍለተማ አዱን ብቅልችቱን፣","poem":1},{"text":"ዋን አከ መሌ ጋሪ ከን ጅእ ኬኑን፣","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኬናወን ፍለተሞ ቱሉወን ዱሪቲን፣","poem":1},{"text":"በዻዹማ ጋረን በረ በራቲን፣","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኬና ፍለተማ ለፋቲፊ ጉቱማሳቲን፣","poem":1},{"text":"ሱራ እሰ ደገለ ቦበኡ ኬሰ ቱሬ ሰናቲን ሃኤብሱ።","poem":2},{"text":"እሳን ኩኔን ሁንድ መታ ዮሴፍ","poem":1},{"text":"ከን ኦቦሎተሳ ግዱት ቡልቻ ተኤ ሰናረ ሃቡአን።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እን ኡልፍናን ኮርመ ሀንገፈ ፈካተ፤","poem":1},{"text":"ጋንፈወንሳ አከ ጋንፈወን ገፈርሳት።","poem":2},{"text":"እሳኒንስ ሀመ ዳሪ ለፋት","poem":1},{"text":"ሰቦተ ንወራነ።","poem":2},{"text":"እሳንስ ኩመ ኩርነን ኤፍሬም፣","poem":1},{"text":"አከሱመስ ኩማተመ ምናሴት።”","poem":2}]},{"type":"verse","number":18,"content":["ዋኤ ዜቡሎንስ አከነ ጄዼ፦",{"text":"“ዜቡሎን አት ገድ በኡኬቲን፣","poem":1},{"text":"ይሳኮር አትስ ዱንካኖተኬ ኬሰት ገመድ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እሳን ሰቦተ ገረ ቱሉት ንዋሙ፤","poem":1},{"text":"አችትስ ኣርሳ ቀጄሉማ ንዽኤሱ፤","poem":2},{"text":"እሳን ሶሩመ እረ ዸንገለኣ ገላነ ኬሳቲን፣","poem":1},{"text":"ቀቤኘ ጭረቸ ኬሰ ዾክፈሜንስ ንገመዱ።”","poem":2}]},{"type":"verse","number":20,"content":["ዋኤ ጋድሞ አከነ ጄዼ፦",{"text":"“ነምን ቡልቺንሰ ጋድ በልእሱ ኤብፈማዸ!","poem":1},{"text":"ጋድ እሬፊ መታ ጨጨብሳ","poem":2},{"lineBreak":true},{"text":"አከ ሌንጫት አች ጅራተ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"እን ኦፊሳቲፍ ለፈ ገበታ ፍለቴ፤","poem":1},{"text":"ቆድን ሆገንቶታ እሳፍ ቱርፈሜ።","poem":2},{"text":"ዮሙ ሆገንቶትን ሰባ ወልት ቀበመንት፣","poem":1},{"text":"እን ፌዺ ቀጄሉመ ዋቀዮቲፊ","poem":2},{"lineBreak":true},{"text":"ሙርቲ እስራኤልት ሙሬ ሰነ ፊጣን ባሴ።”","poem":2}]},{"type":"verse","number":22,"content":["ዋኤ ዳንስ እን አከነ ጄዼ፦",{"text":"“ዳን አከ እልሞሌ ሌንጫ","poem":1},{"text":"ከን ባሻን ኬሳ ኡታሌ በኡት።”","poem":2}]},{"type":"verse","number":23,"content":["ዋኤ ንፍታሌምስ አከነ ጄዼ፦",{"text":"“ንፍታሌም ሱራ ጎንፈቴረ፤","poem":1},{"text":"ኤበ ዋቀዮቲንስ ጉተሜረ፤","poem":2},{"lineBreak":true},{"text":"እን ብየ ከራ ልጣቲፊ ክባቲን ጅሩ ንዻለ።”","poem":2}]},{"type":"verse","number":24,"content":["ዋኤ ኣሼርሞ አከነ ጄዼ፦",{"text":"“ኣሼር እልማን ሁንደ ጫላ ኤብፈማዸ፤","poem":1},{"text":"እን ኦቦሎተሳ ዱረት ፉዸተመ ሃአርገቱ፤","poem":2},{"lineBreak":true},{"text":"ሚለሳስ ዘይቲ ኬሰ ሃጩጰቱ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ደንቀራን በልበለኬቲ ስቢላፊ ናሲ ተአ፤","poem":1},{"text":"ጀብንኬስ አኩመ በሮተ ጅሬኘኬቲ ንተአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“ዋቅን አከ ዋቀ ይሹሩን፣","poem":1},{"text":"ከን ስ ገርጋሩፍ ጄዼ ሰሚወንረ፣","poem":2},{"lineBreak":true},{"text":"ሱራሳቲንስ ዱሜሶተረ ጉሉፉ ቶኮሌ ህንጅሩ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ዋቅን በረ በራ እዶ ጅሬኛኬቲት፤","poem":1},{"text":"እሬን በረ በራስ ስ ጀላን ጅረ።","poem":2},{"text":"እን፣ ‘እሳን በሌስ!’ ጄዼ","poem":1},{"text":"ዲኖተኬ ፉለኬ ዱራ ንአርአ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ከናፉ እስራኤል ኮጳሳ ነጋዻን ጅራተ፤","poem":1},{"text":"ለፈ ፍጤንስ ሰሚ እት ጮጮጱት፣","poem":2},{"text":"ብየ ምዻኒፊ ወይኒ ሃራት","poem":1},{"text":"ነምን ቡርቃ ያቆብ ቱቁ ህንጅሩ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ያ እስራኤል፣ አት ኤብፈማዸ!","poem":1},{"text":"ሰብን ዋቀዮ እሰ ፈይሴ፣","poem":2},{"lineBreak":true},{"text":"ከን አከኬቲ ኤኙ?","poem":2},{"text":"እን ጋቸነኬቲፊ ገርጋራኬት፤","poem":1},{"text":"ጎራዴ ኡልፍነኬቲትስ።","poem":2},{"text":"ዲኖትንኬ ሶዳዻን ፉለኬ ዱራ ዱበት ዴብኡ፤","poem":1},{"text":"አትሞ እዶወን ዋቄፈትናሳኒረ ኤጄተ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}