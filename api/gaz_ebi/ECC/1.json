{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ECC","translationId":"gaz_ebi","name":"ለለበ","commonName":"ለለበ","title":"ክታበ ለለባ","order":21,"numberOfChapters":12,"sha256":"5951536c4d20f4ed8cf17461d1040a1ba04ddb5a6a175aaa179001705f79529f","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/gaz_ebi/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":1,"content":[{"type":"heading","content":["ወንት ሁንድኑ ፋይዳ ህንቀቡ"]},{"type":"verse","number":1,"content":["ዱቢ ለለባ እልመ ዳዊት፣ እሰ ዬሩሳሌም ኬሳት ሞቲ ተኤ ሰና፦"]},{"type":"verse","number":2,"content":[{"text":"ለለብች፣","poem":1},{"text":"“ፋይዳ ህንቀቡ! ፋይዳ ህንቀቡ!","poem":2},{"text":"ጉቱማን ጉቱት ፋይዳ ህንቀቡ!","poem":1},{"text":"ወን ሁንድኑ ፋይዳ ህንቀቡ” ጄዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ነምን ሆጂሳ ከን አዱዻ ገድት እት ደዸቡ ሁንደ ኬሳ፣","poem":1},{"text":"ቡኣ ማሊ አርገተ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዸሎትን ንዹፈ፤ ዸሎትን ንደርበ፤","poem":1},{"text":"ለፍት ገሩ በረ በራን ጅራት።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ቢፍቱን ንባት፤ ቢፍቱን ንልጥ፤","poem":1},{"text":"ገረ ባቴ ሰነት ዴብኡፍስ ንአሪፈት።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ቡቤን ገረ ክባት ቡብሰ፤","poem":1},{"text":"ገረ ካባትስ ንዴብአ፤","poem":2},{"text":"እንስ ናነኡመ ናነኤ ዴመ፤","poem":1},{"text":"ከራሳረስ ዴዴብአ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ለግን ሁንድ ገላነት ያአ፤","poem":1},{"text":"ገላን ገሩ ህንጉቱ።","poem":2},{"text":"ለጌን ገሩመ ዹፈንት","poem":1},{"text":"ዴብአኒ ያኡ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ወን ሁንድኑ","poem":1},{"text":"ሀመ ነምን ቶኮ ዱበቹ ደንደኡ ጫላ ደዸብሲሳዸ።","poem":2},{"text":"እጅ አርጌ ህንቁፉ፤","poem":1},{"text":"ዮካን ጉር ዸገኤ ህንጉቱ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ወን ዱራን ቱሬ አመስ ንተአ፤","poem":1},{"text":"ወን ዱራን ሆጄተሜ አመስ ንሆጄተመ፤","poem":2},{"lineBreak":true},{"text":"አዱዻ ገድት ወን ሃራን ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ወን ነምን ቶኮ፣","poem":1},{"text":"“እላ! ወን ኩን ሃራዸ” ጄቹ ደንደኡ ከምዩ ጅራ?","poem":2},{"text":"ወን ኩን ዱራኑ በረ ዼራን ዱረ አስ ቱሬ፤","poem":1},{"text":"በረኬኛን ዱረዩ አሱመ ቱሬ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ነሞትን በረ ዱሪ ህንያደተመን፤","poem":1},{"text":"ከኔን ዹፉፍ ጅረንስወረ እሳን ዱባን ዹፈኒን ህንያደተመን።","poem":2}]},{"type":"heading","content":["ኦጉማን ፋይዳ ህንቀቡ"]},{"type":"verse","number":12,"content":["አን ለለባን፣ ዬሩሳሌም ኬሰት ሞቲ እስራኤልን ቱሬ።"]},{"type":"verse","number":13,"content":["አን ዋን ሰሚ ገድት ሆጄተሜ ሁንደ ኦጉማዻን ቁአዼ ቆረዼ ብረ ገኡፍ ኦፍ ኬኔን ቱሬ። ዋቅን በኣ ኡልፋታ አከሚ ነመረ ካኤ!"]},{"type":"verse","number":14,"content":["አን ዋን አዱዻ ገድት ሆጄተሜ ሁንደ አርጌረ፤ ሁንድሳኒዩ ፋይዳ ህንቀበን፤ ኩን አኩመ ነመ ቡቤ አርኡት።"]},{"type":"verse","number":15,"content":[{"text":"ወን ጀልእፈሜ ቶኮ ዴብኤ ህንቀጄልፈሙ፤","poem":1},{"text":"ወን ህንጅሬስ ለካአሙ ህንደንደኡ።","poem":2}]},{"type":"verse","number":16,"content":["አንስ አከነ ጄዼን ያዴ፤ “ኩኖ፣ አን ነመ አናን ዱረ ዬሩሳሌምን ቡልቻ ቱሬ ከምዩ ጫላ ጉደዼ ኦጉማስ ደበለዼረ፤ አን ሙጠኖ ኦጉማቲፊ ቤኩምሳ ጉዳ አርገዼረ።”"]},{"type":"verse","number":17,"content":["ከናፉ አን ኦጉማ፣ መራቱማፊ ጎዉማ ሁበቹፍን ኦፍ ኬኔ፤ ገሩ አን አከ ወን ኩንስ ቡቤ አርኡ ተኤ ነንበረዼ።"]},{"type":"verse","number":18,"content":[{"text":"ኦጉማ ጉዳ ኬሰ ገደ ባይኤቱ ጅራቲ፤","poem":1},{"text":"አኩመ ቤኩምስ ደበለሙን ገድስ ደበለመ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}