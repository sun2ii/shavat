{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ECC","translationId":"gaz_ebi","name":"ለለበ","commonName":"ለለበ","title":"ክታበ ለለባ","order":21,"numberOfChapters":12,"sha256":"5951536c4d20f4ed8cf17461d1040a1ba04ddb5a6a175aaa179001705f79529f","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/gaz_ebi/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"አኩመ ትሲስን ዱቴ ቶኮ ሽቶ አጄስቱ ሰነ","poem":1},{"text":"ጎዉማን ጥኖን ኦጉማፊ ኡልፍነ በሌሰ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ያድን ኦጌሳ ከራ ምርጋ፣","poem":1},{"text":"ያድን ጎዋሞ ከራ ብታ ጅረ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ጎዋን ዮ ከራ ዴሙሌ ቀልቢ ህንቀቡ፤","poem":1},{"text":"አከ ጎዋ ተኤስ ነመ ሁንደት አርግሲሰ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዮ ዼከምስ ቡልቻ ቶኮ ስት ሀማቴ፣","poem":1},{"text":"አት እዶኬ ገድ ህንዺስን፤","poem":2},{"lineBreak":true},{"text":"ተስገባኡን ዶጎጎረ ጉዳ ሀምብሱ ደንደኣቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ሀምን አን አዱዻ ገድት አርጌ ቶኮ ጅረ፤","poem":1},{"text":"ኩንስ ዶጎጎረ ቡልቻን ቶኮ ኡሙዸ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኡቱመ በዻዾን እዶ ገድ ኣኑ ቀበተኒ ጅረኑ፣","poem":1},{"text":"ጎዎትን እዶ ኡልፍና ቀበቱ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አን ኡቱመ እልማን ሞቶታ አከ ገርቦታ ሚላን ዴመኒ","poem":1},{"text":"ገርቦንሞ ፈርዳን ኡቱ ዴመኒ ነንአርጌ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ነምን ቦለ ቆቱ ከምዩ ኦፉመሳቲ ኬሰ ቡአ፤","poem":1},{"text":"ነመ ደላ ጨብሴ ኬሳን በኡ ከምዩ ቦፈቱ እደ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ነምን ዸጋ ባሱ ከምዩ ዸጋ ሰናን ሚዸሙ ደንደአ፤","poem":1},{"text":"ነምን ጅርመ በቀቅሱ ሁንድኑስ ጅርሙመ ሰናን ሚዸመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ቆቶን ዶሜ","poem":1},{"text":"አፋንሳ ዮ ህንቀረምን፣","poem":2},{"text":"ሁምነ ጉዳ በርባችሰ፤","poem":1},{"text":"ኦጉማን ገሩ ምልካእነ ፍደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ቦፍት ቶኮ ኡቱ ህንራቴፈምን ዮ ነመ እዴ፣","poem":1},{"text":"ነምች ቦፈ ራቴሱ ሱን ሆማ ህንአርገቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ዱቢን አፋን ኦጌሳቲ በኡ ኡልፍነ ቀበ፤","poem":1},{"text":"ነምን ጎዋንሞ ህዺ ኦፊሳቲን በደ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዱቢንሳ ጀልቀበት ጎዉማዸ፤","poem":1},{"text":"ዹመረት ገሩ መራቱማ ሀማዸ፤","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ነምን ጎዋን ዱቢ ባይእሰ።","poem":2},{"lineBreak":true},{"text":"ነምን ቶኮዩ ዋን ዹፉፍ ጅሩ ህንቤኩ፤","poem":1},{"text":"ኤኙቱ ዋን እሰ ዱባን ተኡ እሰት ህሙ ደንደአ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ደዸቢን ጎዋ እሱመ ቡቱችት፤","poem":1},{"text":"እን ከራ ገረ መጋላት ጌሱ ህንቤኩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ያ ብየ ሞቲንኬ ሙጫ ቱሬ፣","poem":1},{"text":"ከን እልማን ሞቶታኬ ገነማን ኛተኒ ዹገን ሲፍ ወዮ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ያ ብየ ሞቲንኬ ሰኚ ቤከማራ ዸለቴ፣","poem":1},{"text":"ከን እልማን ሞቶታ ኡቱ መቻኡፍ ህንተእን፣","poem":2},{"lineBreak":true},{"text":"ጀብነ አርገቹፍ ጄዸኒ ዬሮ መሉት ኛተኒ ዹገን፣አት ኤብፈምቱዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ዽባኡማን፣ መነ ዱፍሰ፤","poem":1},{"text":"ሀርክ ህንሆጄትኔስ መነ ዽምሲሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ጭዽ ኮልፋፍ ቆጴፈመ፤","poem":1},{"text":"ዳዺን ወይኒስ ጅሬኘ ገመቺሰ፤","poem":2},{"lineBreak":true},{"text":"ማለቅንሞ ዴቢ ዋን ሁንዳት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ሰበቢ ስምብር ሰሚ ዱቢኬ ጌስቱፍ፣","poem":1},{"text":"ዮካን ስምብር በርሳ ጅርቱ ዸቅጤ ዋን አት ጄቱ ህምቱፍ፣","poem":2},{"text":"አት ያደኬ ኬሰት ሞቲ ህንአረብስን፤","poem":1},{"text":"ዮካን ኩታ ህርባ ኬሰት ሶሬሰ ህንአባርን።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ECC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ECC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ECC/9.json","previousChapterAudioLinks":{},"numberOfVerses":20}