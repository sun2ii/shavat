{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ECC","translationId":"gaz_ebi","name":"ለለበ","commonName":"ለለበ","title":"ክታበ ለለባ","order":21,"numberOfChapters":12,"sha256":"5951536c4d20f4ed8cf17461d1040a1ba04ddb5a6a175aaa179001705f79529f","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/gaz_ebi/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":11,"content":[{"type":"heading","content":["ቡዴነ ብሻንራ"]},{"type":"verse","number":1,"content":[{"text":"ቡዴነኬ ብሻን ጉባ ቡስ፤","poem":1},{"text":"ጉያ ባይኤ ቦዴ ዴብፍቴ አርገታቲ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ቀቤኘኬ እዶ ቶርበት ዮካን ሰዴትት ቆድ፤","poem":1},{"text":"በላ ብየት ዹፉፍ ጅሩ ህንቤክቱቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ዱሜስ ዮ ብሻኒን ጉተሜ፣","poem":1},{"text":"ቦካ ለፈት ገድ ዸንገላሰ።","poem":2},{"text":"ሙክን ቶኮ ዮ ክበት ዮካን ካበት ጅጌ፣","poem":1},{"text":"እዱመ እት ኩፌ ሰነ ጪሰ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ነምን ቅሌንሰ ኤገቱ ቶኮ ህንፈጫፈቱ፤","poem":1},{"text":"ከን ዱሜሰ እላለቱስ ህንሃመቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"አት አኩመ ዳንዲ ቡቤ፣","poem":1},{"text":"ዮካን አከ እት ነምን ገደሜሰ ሃዻ ኬሰት ኡመሙህንቤክኔ ሰነ፣","poem":2},{"text":"ሆጂ ዋቃ፣ ኡማ ዋን ሁንዳ ሰነሌ","poem":1},{"text":"ቤኩ ህንደንዴሱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"እን ኩን ዮካን እን ሱን፣","poem":1},{"text":"ዮካን ለቸኑ ወል ቅጤ ቶሉ፤","poem":2},{"text":"እን ከም አከ ቶሉ ህንቤክቱቲ፤","poem":1},{"text":"አት ሰኚኬ ገነማን ፈጫፈዹ፤","poem":2},{"lineBreak":true},{"text":"ገልገለስ ሀርክኬ ሆጂ መሌ ህንታእን።","poem":2}]},{"type":"heading","content":["ደርገጉማት ኡማኬ ያደዹ"]},{"type":"verse","number":7,"content":[{"text":"እፍን ምኣኣዸ፤","poem":1},{"text":"አዱ አርጉንስ እጀ ገመቺሰ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ነምን ዮ ሀመም ወጎተ ባይኤ ጅራቴሌ፣","poem":1},{"text":"እን ሁንዱመሳት ገመዳ ሃጅራቱ።","poem":2},{"text":"ገሩ እን ጉዮተ ዱከና ሃያደቱ፤","poem":1},{"text":"እሳን ንባይአቱቲ።","poem":2},{"lineBreak":true},{"text":"ወን ዹፉፍ ጅሩ ሁንድኑ ፋይዳ ህንቀቡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ያ ደርገጌሰ፣ ሀመ ደርገጉማ ኬሰ ጅርቱት ገመድ፤","poem":1},{"text":"በረ ደርገጉማኬቲ ኬሰስ ገራንኬ ስ ሃገመቺሱ።","poem":2},{"text":"ያደ ገራኬቲ፣ ዋኑመ እጅኬ አርጉ ዱካ ቡእ፤","poem":1},{"text":"ገሩ አከ ዋቅን ዋን ከነ ሁንዳፍገረ ሙርቲት ስ ፍዱ ቤከዹ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ከናፉ ገራኬ ኬሳ ያዶ በሌስ፤","poem":1},{"text":"ሰበቢ ደርገጉማፊ ጀብን ፋይዳ ህንቀብኔፍ","poem":2},{"lineBreak":true},{"text":"ዸግነኬ ኬሳ ሀምነ ባሲ ገት።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ECC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ECC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ECC/10.json","previousChapterAudioLinks":{},"numberOfVerses":10}