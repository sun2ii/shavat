{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ECC","translationId":"gaz_ebi","name":"ለለበ","commonName":"ለለበ","title":"ክታበ ለለባ","order":21,"numberOfChapters":12,"sha256":"5951536c4d20f4ed8cf17461d1040a1ba04ddb5a6a175aaa179001705f79529f","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/gaz_ebi/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"ኡቱ ጉያን ረክና ህንዹፍን፣","poem":1},{"text":"ኡቱ በር አት እት፣ “አን እት ህንገመዱ” ጄቱ ህንገእን፣","poem":2},{"lineBreak":true},{"text":"በረ ደርገጉማኬቲ ኬሰ ኡማኬ ያደዹ፤","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ኡቱ አዱፊ እፍን፣","poem":1},{"text":"ጂኒፊ ኡርጂን ህንዱከናእን፣","poem":2},{"lineBreak":true},{"text":"ኡቱ ዱሜስ ቦካት ኣኔ ህንዴብእን፣","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዬሮ እት ኤግዶን መና ሆለተኒ","poem":1},{"text":"ነሞትን ጀጀቦንሞ ጉጉፈንት፣","poem":2},{"text":"ዬሮ እት ወር ምዻን ዳከን ሰበቢ ሙራሰ ተአኒፍሆጂ ዺሰኒ፣","poem":1},{"text":"ከኔን ፎዳ ኬሳን እላለን አርጉ ደዸበንት፣","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዬሮ እት በልበል ዳንዲ ጉዳት ጌሱ ጩፈሜ","poem":1},{"text":"ሰገሌን ዸጋ ዳኩሞ ገድ ቡኣ ዴሙት፣","poem":2},{"text":"ዬሮ እት ነምን ወጨ ስምብሮቲን ደመቄ","poem":1},{"text":"ስርብሼ ሁንድ ገሩ ገድ ቡኣ ዴሙት፣","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዬሮ እት ነምን ለፈ ኦል ዼራፊ","poem":1},{"text":"በላ ዳንዲራ ሶዳቱ፣","poem":2},{"text":"ዬሮ እት ሙክን ኦቾሎኒ ደራሩ፣","poem":1},{"text":"ዬሮ እት ኮሮጵስን ትረቱፊ","poem":2},{"lineBreak":true},{"text":"ሀዊን ነመ ኬሳ በዱት ኡማኬ ያደዹ።","poem":2},{"text":"ኤርገሲ ነምን መነሳ በረ በራት ገለ፤","poem":1},{"text":"ወር ቦአንስ ዳንዲረ ዴዴብኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ኡቱ ፉኞን ሜቲ ህንጭትን፣","poem":1},{"text":"ዮካን ኡቱ ወጪቲን ወርቄ ህንጨብን እሰ ያደዹ፤","poem":2},{"text":"ኡቱ ኦኮቴን ቡርቃ ብረት ህንጨጨብን፣","poem":1},{"text":"ዮካን ኡቱ ጌንጎን እቲን ብሻን ወራበንቦለ ብሻኒ ብረት ህንጨብን፣","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኡቱ ብዮን ለፈ ቱሬት ህንዴብእን፣","poem":1},{"text":"ኡቱ ሀፉርስ ዋቀ እሰ ኬኔት ህንዴብእን እሰ ያደዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ለለባንስ፣ “ወን ሁንድ ፋይዳ ህንቀቡ! ፋይዳ ህንቀቡ!","poem":1},{"text":"ወን ሁንድ ፋይዳ ህንቀቡ!” ጄዸ።","poem":2}]},{"type":"heading","content":["ጡሙረ ዱቢ"]},{"type":"verse","number":9,"content":["ለለባን ሱን ኦጌሰ ቆፈ ኡቱ ህንተእን ቤኩምሰስ ነማፍ ንቆደ ቱሬ። እን እት ያዴ፣ ቆረቴ ፈኬኘ ባይኤ ተርቲባን ካኤረ።"]},{"type":"verse","number":10,"content":["ለለባን ኩን ጄቸ ስሪ አርገቹፍ ጄዼ ቆረቴ፤ ወን እን በሬሴስ ቀጄላፊ ዹጋዸ።"]},{"type":"verse","number":11,"content":["ዱቢን ኦጌሳ አኩመ ሜሻ እቲን ሎን ኦፈኒት፤ ጄችሳ ከን ወልት ቀበሜስ አኩመ ምስማረ ጀቤፈሜ ሩኩተሜት፤ ከነስ ትክሴ ቶኮቱ ኬኔ።"]},{"type":"verse","number":12,"content":["ያ እልመኮ፣ ዋን ከነራ ሀፌ ሁንደ ኦፍ ኤገዹ። ክታበ ሄዱ በሬሱን ሆጂ ዹመ ህንቀብኔዸ፤ ቁአናን ባይኤንስ ነመ ደዸብሲሰ።"]},{"type":"verse","number":13,"content":[{"text":"አመ ወን ሁንድኑ ዸገአሜረ፤","poem":1},{"text":"ዹምን ዱቢ ኩኖት፤","poem":2},{"text":"ዋቀ ሶዳዹቲ ሴረሳ ኤግ፤","poem":1},{"text":"ወን ነምን ሆጄቹ መሉ ጉዳን እሰ ከናቲ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዋቅን ሆጂ ሁንደ፣","poem":1},{"text":"ዋን ዾክፈሜ ሁንደስ","poem":2},{"lineBreak":true},{"text":"ጋሪ ዮካን ሀማ ታናን ሙርቲት ዽኤሳቲ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ECC/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/SNG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ECC/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}