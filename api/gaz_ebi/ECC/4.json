{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ECC","translationId":"gaz_ebi","name":"ለለበ","commonName":"ለለበ","title":"ክታበ ለለባ","order":21,"numberOfChapters":12,"sha256":"5951536c4d20f4ed8cf17461d1040a1ba04ddb5a6a175aaa179001705f79529f","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/gaz_ebi/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":4,"content":[{"type":"heading","content":["ጩንቁርሳ፣ ሆጂዻን ደዸቡ፣ ምቹ ዸቡ"]},{"type":"verse","number":1,"content":["አን አመስ እላሌ ጩንቁርሳ አዱዻ ገድት አዴምስፈማ ጅሩ ሁንደ ነንአርጌ፦",{"text":"አን እምማን ጩንቁርፈምቶታ ነንአርጌ፤","poem":1},{"text":"ነመ እሳን ጀጀቤሱ ቶኮሌስ ህንቀበን፤","poem":2},{"text":"ሁምን ገመ ጩንቁርስቶተሳኒ ቱሬ፤","poem":1},{"text":"እሳን ነመ እሳን ጀጀቤሱ ቶኮሌ ህንቀበን።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አንስ አከ ወር ዱአን፣","poem":1},{"text":"ከኔን ከናን ዱረ ዱአን፣","poem":2},{"lineBreak":true},{"text":"ጅራቶተ አመ ሉቡዻን ጅራተን ጫለን ነንለብሴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ገሩ ነምን ሀመ አማት ህንዸለትን","poem":1},{"text":"ከን ሀምነ አዱዻ ገድት","poem":2},{"text":"ሆጄተሙ ህንአርግን፣","poem":1},{"text":"ለቸንሳኒረ ወየ።","poem":2}]},{"type":"verse","number":4,"content":["አንስ አከ ደዸቢን ሆጂ ሁንዲፊ ምልካኡን ሁንድ ህናፋ ነምን ኦላሳ ወጅን ቀቡራ ቡርቁ ነንአርገ። ኩንስ ቡቤ አርኡዸ፤ ፋይዳስ ህንቀቡ።"]},{"type":"verse","number":5,"content":[{"text":"ጎዋን ሀርከሳ መረቴ ታአ፤","poem":1},{"text":"ፎኑመ ኦፊሳስ ኛተ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ደዸቢፊ ቡቤ አርኡዻን","poem":1},{"text":"ኮኜ ለመ አርገቹረ","poem":2},{"lineBreak":true},{"text":"ነጋን ኮኜ ቶኮ አርገቹ ወየ።","poem":2}]},{"type":"verse","number":7,"content":["አን አመሌ ዋን ፋይዳ ህንቀብኔ ቶኮ አዱዻ ገድት ነንአርጌ፦"]},{"type":"verse","number":8,"content":[{"text":"ነመ ኮጳሳ ጅራቱ ቶኮቱ ጅረ፤","poem":1},{"text":"እንስ እልመ ዮካን ኦቦሌሰ ህንቀቡ ቱሬ።","poem":2},{"text":"ዬሮ ሁንደ ሆጂት ደዸበ፤","poem":1},{"text":"ተኡስ እጅሳ ቀቤኘሳ እላሌ ቁፌ ህንጄዹ።","poem":2},{"text":"እንስ፣ “አን ኤኙፍ ጄዼን ደዸበ?","poem":1},{"text":"ማሊፈን ገመቹስ ኦፍ ለገ?” ጄዼ ጋፈቴ።","poem":2},{"text":"ኩንስ ፋይዳ ህንቀቡ፤","poem":1},{"text":"ሆጂ ቡኣ ህንቀብኔዸ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"እሳን ሰበቢ ሆጂሳኒቲፍ ገቲ ጋሪ ዋን አርገተኒፍ","poem":1},{"text":"ነመ ቶኮረ ነመ ለመ ወየ፦","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዮ እን ቶኮ ኩፌ፣","poem":1},{"text":"እን ካን ኦል እሰ ቀበ።","poem":2},{"text":"ገሩ ነምን ኩፌ","poem":1},{"text":"ከን ኦል እሰ ካሱ ህንቀብኔ ገራ ነመ ኛተ!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዮ ነሞትን ለመ ወጅን ጪሰን እት ሆአ፤","poem":1},{"text":"ነመ ቶኮ ገሩ አከምት ኮጳሳ እት ሆኡ ደንደአ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ነምን ቶኮ ሞአተሙ ደንደአ፤","poem":1},{"text":"ነሞትን ለመ ገሩ ኦፍራ ዴብሱ ደንደኡ።","poem":2},{"text":"ፉኞን ፎኣ ሰዲን ፎአሜ ደፌ ህንጭቱ።","poem":1}]},{"type":"heading","content":["ጫለኒ አርገሙን ፋይዳ ህንቀቡ"]},{"type":"verse","number":13,"content":["ሞቲ ዱሎማፊ ጎዋ ስአች ጎርሰ ህንፉዸትኔረ፣ ደርገጌሰ ህዬሰ ኦጌሰ ወየ።"]},{"type":"verse","number":14,"content":["እን ዮ ህዩማን ሞቱማ ሰነ ኬሰት ዸለቴዩ መነ ህዻቲ በኤ ሞቲ ተኡ ደንደኣቲ።"]},{"type":"verse","number":15,"content":["አን አከ ነምን አዱዻ ገድ ጅራቴ ሁንድ ደርገጌሰ ሞቲ ዻሉ ሰነ ዱካ ቡኤ ነንአርጌ።"]},{"type":"verse","number":16,"content":["ባይእን ነመ ፉለሳኒ ዱረ ጅሩ ሀመ ህንቀቡ ቱሬ። ወር ዱባን ዹፈን ገሩ ደርገጌሰ ዻሉ ሰነት ህንገመድኔ። ኩን ሁንድስ ቡቤ አርኡዸ፤ ፋይዳስ ህንቀቡ።"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ECC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ECC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ECC/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}