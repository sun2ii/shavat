{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ECC","translationId":"gaz_ebi","name":"ለለበ","commonName":"ለለበ","title":"ክታበ ለለባ","order":21,"numberOfChapters":12,"sha256":"5951536c4d20f4ed8cf17461d1040a1ba04ddb5a6a175aaa179001705f79529f","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/gaz_ebi/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":5,"content":[{"type":"heading","content":["ዋቀ ሶዳዹ"]},{"type":"verse","number":1,"content":["አት ዬሮ ገረ መነ ዋቃ ዸቅጡ ተርካንፊኬ ኤገዹ። ዸጌፈቹፍ ዽኣቹን ኣርሳ ጎዎታ ዽኤሱ ጫለ፤ እሳን አከ ሀምነ ሆጄቻ ጅረን ህንቤከኒቲ።"]},{"type":"verse","number":2,"content":[{"text":"ፉለ ዋቃ ዱረት ዋን ቶኮ ዱበቹፍ","poem":1},{"text":"አፋንኬቲን ህንጀርጀርን፤","poem":2},{"lineBreak":true},{"text":"ገራንኬስ ህንአሪፈትን።","poem":2},{"text":"ዋቅን ሰሚ ኬሰ ጅረ፤","poem":1},{"text":"አትሞ ለፈረ ጅርተ፤","poem":2},{"lineBreak":true},{"text":"ከናፉ ዱቢንኬ ሃገባበቱ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አብጁን ባይእነ ሆጂቲን ዹፈ፤","poem":1},{"text":"ሃሳን ጎዋስ ባይእነ ዱቢቲን ቤከመ።","poem":2}]},{"type":"verse","number":4,"content":["አት ዬሮ ወሬገ ቶኮ ዋቃፍ ወሬግዱት ወሬገ ሰነ ኦፍራ ባሱፍ ለፈረ ህንሀርክፈትን። እን ጎዎተት ህንገመዱ፤ አት ወሬገኬ ኦፍራ ባስ።"]},{"type":"verse","number":5,"content":["ወሬገኒ ኦፍራ ባሱ ዺሱ መና ወሬጉ ዺሱ ወየ።"]},{"type":"verse","number":6,"content":["አፋንኬ ጩቡ ኬሰ ስ ህንቡስን። ኤርገማ መነ ቁልቁሉማቲንስ፣ “ወሬግንኮ ዶጎጎረ ቱሬ” ህንጄዽን። ዋቅን ማሊፍ ዋን አት ጄቴት ኣሬ ሆጂ ሀርከኬቲ በሌሰ?"]},{"type":"verse","number":7,"content":["አብጁን ባይኤኒፊ ዱቢን ባይኤን ፋይዳ ህንቀበን። ከናፉ ዋቀ ሶዳዹ።"]},{"type":"heading","content":["በዻዹማን ፋይዳ ህንቀቡ"]},{"type":"verse","number":8,"content":["አት ዮ ህዬሰ ኣና ቶኮ ኬሰት ሀጩጨሜ ሙርቲ ቀጄላፊ ምርግ ዾወተሜ አርግቴ፣ ዋን አከና ህንድንቅሲፈትን፤ ቆንዳል ቶኮ ቆንዳለሳ ኦሊቲን እላላማቲ፤ እሳኒን ኦልትስ ቆንዳልቶትን ብራ ጅሩ።"]},{"type":"verse","number":9,"content":["ፋይዳን ለፈራ አርገሙ ከን ነመ ሁንዳት፤ ሞትች መታንሳዩ ቆነ ለፋራ ፈየደመ።"]},{"type":"verse","number":10,"content":[{"text":"ነመ ማለቀ ጃለቱ ከምዩ ማለቅን እሰ ህንገኡ፤","poem":1},{"text":"ነመ ቀቤኘ ጃለቱሌ ገሊንሳ እሰ ህንቁብሱ።","poem":2},{"lineBreak":true},{"text":"ኩንስ ፋይዳ ህንቀቡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"አኩመ ቀቤኝ ባይአቱን፣","poem":1},{"text":"ወር ኛተንስ ንባይአቱ።","poem":2},{"text":"ዮስ አቦቲን ቀቤኛ እጁማን እላሉ መሌ","poem":1},{"text":"ፋይዳ ማሊ አርገቱሬ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ጥቃስ ኛቱ፣ ጉዳስ ኛቱ፣","poem":1},{"text":"ህርብን ሆጄታ ቶኮ ምኣኣዸ፤","poem":2},{"text":"ባይእን ቀቤኛ ገሩ","poem":1},{"text":"ሶሬሰ ቶኮ ህርበ ዾወ።","poem":2}]},{"type":"verse","number":13,"content":["አን አዱዻ ገድት ሀምነ ነመ ገድሲሱ ነንአርጌ፤ ኩንስ፦",{"text":"ቀቤኘ አቡመሳ ሚዹፍ ኩፈሜ፣","poem":1}]},{"type":"verse","number":14,"content":[{"text":"ዮካን ቀቤኘ ምልኪ ዸቡዻን በዴ","poem":2},{"text":"ዬሮ ነምች ሱን እልመ ዸልቼት","poem":1},{"text":"እልመሳቲፍ ሆማ ህንሀፍኒዸ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ነምን ቁላዹመሳ ገደሜሰ ሃዸሳቲ በአ፤","poem":1},{"text":"እን አኩመ ዹፌት ዴብኤ ዴመ።","poem":2},{"text":"እን ዋን እት ደዸቤ ኬሳ","poem":1},{"text":"ዋን ቶኮሌ ሀርከት ቀበቴ ህንዴሙ።","poem":2}]},{"type":"verse","number":16,"content":["ኩንስ ሀምነ ነመ ገድሲሱዸ፦",{"text":"ነምን አኩመ ዹፌት ዴመ፤","poem":1},{"text":"እን ዋን ቡቤዻፍ ደዸቡፍ","poem":2},{"lineBreak":true},{"text":"ፋይዳ ማሊ አርገተ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እን በረ ጅሬኘሳ ሁንደ ያዶ፣","poem":1},{"text":"ዹኩቢፊ ኣሪ ጉዳዻን ዱከነ ኬሰት ኛተ።","poem":2}]},{"type":"verse","number":18,"content":["አንስ አከ ነምን በረ ጅሬኘሳ ከን ዋቅን እሳፍ ኬኔ ገባባ ከነ ኬሰ ኛቴ ዹጌ ሆጂሳ ከን አዱዻ ገድት እት ደዸቤ ሰነትሌ ገመዱን እሳፍ ጋሪፊ በርባችሳ ተኤ ነንሁበዼ፤ ቆድንሳ ከኑማቲ።"]},{"type":"verse","number":19,"content":["አከሱመስ ዋቅን ነመ ከሚፉ በዻዹማፊ ቀቤኘ ኬኔ አከ እን እት ገመዱ፣ አከ እን ቆደ ኦፊሳ ፉዸቴ ሆጂ ኦፊሳት ገመዱ እሰ ጎዹንሳ፣ ኬና ዋቃት።"]},{"type":"verse","number":20,"content":["ሰበቢ ዋቅን ገራሳ ገመቹዻን ጉቴፍ እን በረ ጅሬኘሳ ባይኤ ህንያደቱ።"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ECC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ECC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ECC/4.json","previousChapterAudioLinks":{},"numberOfVerses":20}