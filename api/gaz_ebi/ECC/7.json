{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ECC","translationId":"gaz_ebi","name":"ለለበ","commonName":"ለለበ","title":"ክታበ ለለባ","order":21,"numberOfChapters":12,"sha256":"5951536c4d20f4ed8cf17461d1040a1ba04ddb5a6a175aaa179001705f79529f","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/gaz_ebi/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":7,"content":[{"type":"heading","content":["ኦጉማ"]},{"type":"verse","number":1,"content":[{"text":"ሽቶ ኡርጋኣረ መቃ ጋሪ ወየ፤","poem":1},{"text":"ጉያ ዸሎታረ ጉያ ዱኣ ወየ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"መነ ጭዻ ዸቁ መና","poem":1},{"text":"መነ ቦእቻ ዸቁ ወየ፤","poem":2},{"text":"ገልገል ነመ ሁንዳ ዱኡማቲ፤","poem":1},{"text":"ነምን ሉቡን ጅራቱ ዋን ከነ ገራት ሃቀበቱ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ፉል ገዱ ዋን ገራ ገመቺሱፍ","poem":1},{"text":"ኮልፈረ ገደ ወየ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ቀልቢን ኦጌሳ መነ ቦእቻ ጅረ፣","poem":1},{"text":"ቀልቢን ጎዋ ገሩ መነ ገመቹ ጅረ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ስርበ ጎዎታ ዸገኡ መና","poem":1},{"text":"እፈትና ኦጌሳ ዸጌፈቹ ወየ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኮልፍ ጎዋ","poem":1},{"text":"አኩመ ቆራቲ ጡዌ ጀላ ጣጠኡት።","poem":2},{"lineBreak":true},{"text":"ኩንስ ፋይዳ ህንቀቡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ጩንቁርሳን ኦጌሰ ጎዋ ጎዸ፤","poem":1},{"text":"መተኣንስ ሰሙ ነመ ጡሬሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ጀልቀበ ዋን ቶኮረ ዹመሳ ወየ፤","poem":1},{"text":"ኦፍ ቱሉረስ ኦብሰ ወየ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሀፉረኬቲን ኣሩፍ ህንአሪፈትን፤","poem":1},{"text":"ኣሪን ቦባ ጎዎታ ኬሰ ጅራቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"አት፣ “በር ዱሪ ማሊፍ በረ ከነ ጫሌ?” ህንጄዽን፤","poem":1},{"text":"ዋን ከነ ጋፈቹን ኦጉማ ምት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ኦጉማን አኩመ ዻላ ዋን ጋሪዸ፤","poem":1},{"text":"ወረ አዱ አርገኒፍስ ቡኣ ቀበ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አኩመ ማለቅን ደኦ ተኤ ሰነ","poem":1},{"text":"ኦጉማንስ ደኦዸ፤","poem":2},{"text":"ፋይዳን ቤኩምሳ ገሩ ከነ፦","poem":1},{"text":"እንስ ኦጉማን ወረ እሼ ቀበኒፍ ጅሬኘ ኬኑሼት።","poem":2}]},{"type":"verse","number":13,"content":["ዋን ዋቅን ሆጄቴ ሜ እላል፦",{"text":"ዋን እን ጀልእሴ","poem":1},{"text":"ኤኙቱ ቀጄልቹ ደንደአ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዮሙ ዬሮን ጋሪ ተኡት ገመድ፤","poem":1},{"text":"ዮሙ ዬሮን ሀማቱ ገሩ እት ያድ፦","poem":2},{"text":"ዋቅን እሰ ቶኮ ሆጄቴ እሰ ካንስ ሆጄቴረ።","poem":1},{"text":"ከናፉ ነምን ኤጌሬሳ ቤኩ ህንደንደኡ፤","poem":2}]},{"type":"verse","number":15,"content":["አን ጅሬኘኮ ከን ፋይዳ ህንቀብኔ ከነ ኬሰት ዋን ከነ ለቹ አርጌረ፤ ኩንስ፦",{"text":"ቀጄላን ቀጄሉማሳቲን በዱሳቲፊ","poem":1},{"text":"ሀማንሞ ሀምነሳቲን በረ ዼራ ጅራቹሳት።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አት አከ መሌ ቀጄላ ህንተእን፤","poem":1},{"text":"ዮካን አከ መሌ ኦጌሰ ህንተእን፤","poem":2},{"lineBreak":true},{"text":"ማሊፍ ኦፍ ገላፈተ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አት አከ መሌ ሀማ ህንተእን፤","poem":1},{"text":"ጎዋስ ህንተእን፤","poem":2},{"lineBreak":true},{"text":"ማሊፍ ኡቱ ዬሮንኬ ህንገእን ዱተ?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ኡቱ እሰ ካን ገድ ህንዺስን","poem":1},{"text":"ዋን ቶኮ ቀባቹን ጋሪዸ።","poem":2},{"lineBreak":true},{"text":"ነምን ዋቀ ሶዳቱ ዋን ሁንዳን ንምልካአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ኦጉማን፣ ቡልችቶተ መጋላ ቶኮ ኬሰ ጅረን ኩዸን ጫላ","poem":1},{"text":"ነመ ኦጌሰ ቶኮ ሁምነ ቀቤሰ ጎት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ነምን ቀጄላን ዋን ቀጄላ መሌ ጩቡ ቶኮሌ ህንሆጄትኔ","poem":1},{"text":"ለፈረ ህንጅሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ዋን ነምን ጄዹ ሁንደ ህንዸጌፈትን፤","poem":1},{"text":"ዮ ከነ ጎቴ ኡቱ ሆጄታንኬ ስ አባሩ ዸጌሳ፤","poem":2}]},{"type":"verse","number":22,"content":[{"text":"አት መታንኬዩ ዬሮ ባይኤ ነሞተ ካን አከ አባርቴ","poem":1},{"text":"ገራንኬ ቤካቲ።","poem":2}]},{"type":"verse","number":23,"content":["አን ዋን ከነ ሁንደ ኦጉማዻነን ቆረዼ፣",{"text":"“አን ኦጌሰን ተአ” ነንጄዼ።","poem":1},{"text":"ወን ኩን ገሩ ነራ ፈጎ ቱሬ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ወንት ጅሩ ሁንድ ፈጎዸ፤ ገድ ፈጎዸ፤","poem":1},{"text":"ኤኙቱ ቆረቴ ብረ ገኡ ደንደአ?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ከናፉ አን ገረ ኦጉማፊ ማሉማ ወንቶታ ሁበቹት፣","poem":1},{"text":"ሰከተኡት፣ ቆረቹት","poem":2},{"text":"አከሱመስ ሀምነ ጎዉማቲፊ","poem":1},{"text":"መራቱማ ጎዉማ ሁበቹት ቀልቢኮ ነንዴብፈዼ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"አን ዋን ዱአ ጫላ ሀዻኡ ነንአርጌ፤ ኩንስ፦","poem":1},{"text":"ዱበርቲ ክዮ ታቴ፣","poem":2},{"text":"ከን ያድንሼ ክዮ፣","poem":1},{"text":"ሀርክሼሞ ፎንጫ ተኤዸ።","poem":2},{"text":"ነምን ዋቀ ገመቺሱ እሼ ጀላ ንበአ፤","poem":1},{"text":"ጩበማን ገሩ እሼዻን ቀበመ።","poem":2}]},{"type":"verse","number":27,"content":["ለለባን አከነ ጄዸ፤ “ኩኖ ወን አን ቆረዼ ብረ ገኤ ከናዸ፦",{"text":"“መለሳ ቤኩፍ ዋን ቶኮ ፉዸኒ ዋን ካንት ደበሉዸ፤","poem":1}]},{"type":"verse","number":28,"content":[{"text":"አን አመስ ነንሰከተኤ፤","poem":2},{"lineBreak":true},{"text":"ገሩ ህንአርገትኔ።","poem":2},{"text":"አን ኩመ ኬሳ ዺረ ቀጄላ ቶኮ ነንአርገዼ፤","poem":1},{"text":"ሁንዱመሳኒ ኬሳ ገሩ ዱበርቲ ቀጄልቱ ቶኮዩ ህንአርገትኔ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ኩኖ አን ዋን ከነ ቆፈ ነንአርገዼ፦","poem":1},{"text":"ዋቅን ቀጄልቶተ ጎዼ እልማን ነማ ኡሜ፤","poem":2},{"lineBreak":true},{"text":"ነሞትን ገሩ መለ ባይኤ በርባቸ ዴመን።”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ECC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ECC/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ECC/6.json","previousChapterAudioLinks":{},"numberOfVerses":29}