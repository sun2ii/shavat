{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"EXO","translationId":"gaz_ebi","name":"በኡ","commonName":"በኡ","title":"ሴረ በኡ","order":2,"numberOfChapters":40,"sha256":"55c7c1ba5fd633929d1b7c8a27c2ab8770b8c310874233d42cf98c81969bcb8e","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/gaz_ebi/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":15,"content":[{"type":"heading","content":["ፋርፈትና ሙሴቲፊ ሚርያም"]},{"type":"verse","number":1,"content":["ዮሙስ ሙሴፊ እስራኤሎን ፋርፈትና ከነ ዋቀዮፍ ፋርፈተን፦",{"text":"“አን ዋቀዮፍ ነንፋርፈዸ፤","poem":1},{"text":"እን ኦል ኦል ጄዼራቲ።","poem":2},{"text":"እን ፈርዳፊ ነምቸ ፈርደ ያበቴ","poem":1},{"text":"ገላነት ገድ ደርበቴረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“ዋቀዮ ጀብነኮቲፊ ፋርፈትናኮት፤","poem":1},{"text":"እን ፈይነኮ ተኤረ።","poem":2},{"text":"እን ዋቀኮት፤ አንስ እሰ ነንጀጀዸ፤","poem":1},{"text":"እን ዋቀ አባኮቲት፤ አንስ እሰ ኦል ኦል ነንቀበ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዋቀዮ ጎተ ወራናት፤","poem":1},{"text":"መቃንሳ ዋቀዮ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እን ጋሪወን ፈረኦኒፊ ሎልቶተሳ","poem":1},{"text":"ገላነት ገድ ደርበቴረ።","poem":2},{"text":"ቆንዳልቶተ ፈረኦን ኬሳ ፍለተምቶትን፣","poem":1},{"text":"ገላነ ዲማ ኬሰ ዽዽመኒሩ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ቱጁብን እሳንረ ገረ ገሌ፤","poem":1},{"text":"እሳንስ አኩመ ዸጋ ቱጁበት ገድ ዽዽመን።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ያ ዋቀዮ፣","poem":1},{"text":"ሀርክኬ ምርጋ ሁምናን ኡልፍነ ቀቤሰ።","poem":2},{"text":"ያ ዋቀዮ፣","poem":1},{"text":"ሀርክኬ ምርጋ ዲነ ንሁሬሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“አት ጉድነ ኡልፍነኬቲቲን","poem":1},{"text":"ወረ ሲን ሞርመን ገድ ደርበቴ።","poem":2},{"text":"ኣሪኬ ቦበኣ ንኤርግቴ፤","poem":1},{"text":"እንስ አኩመ ሀበቂት ጉቤ እሳን ፍጤ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሀፉረ ፉኛንኬቲቲን","poem":1},{"text":"ብሻኖትን ቱለመን።","poem":2},{"text":"ብሻን ያኡ አኩመ ኬኘኒት ኦል ዻበቴ፤","poem":1},{"text":"ቱጁቦንስ ወለካ ገላናት እትተን።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዲን፣ ‘አን ፋነ ቡኤ እሳን ቀቀበ።","poem":1},{"text":"ቦጁ ነንቆደዸ፤","poem":2},{"lineBreak":true},{"text":"አን እሳንረት ፌዺኮ ነንጉተዸ።","poem":2},{"text":"ጎራዴኮ ነንሉቅፈዸ፤","poem":1},{"text":"ሀርክኮ እሳን በርበዴሰ’ ጄዼ ነንዻደቴ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አት ገሩ ቡቤኬ እት ቡብፍቴ፤","poem":1},{"text":"ገላንሞ እሳንረ ገረ ገሌ።","poem":2},{"text":"እሳንስ አኩመ ስቢላ","poem":1},{"text":"ብሻኖተ ጀጀቦዻን ልቅምፈመን።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ያ ዋቀዮ፣","poem":1},{"text":"ዋቆተ ኬሳ ኤኙቱ ስ ፈካተ?","poem":2},{"text":"ቁልቁልናን ስምቦ ቀቤስ፣","poem":1},{"text":"ኡልፍናን ሶዳችሳን፣","poem":2},{"text":"ሆጂ ድንቂ ሆጄቹትስ","poem":1},{"text":"ከን አከኬቲ ኤኙ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“አት ሀርከኬ ምርጋ ድሪርፈናን፣","poem":1},{"text":"ለፍት እሳን ልቅምስቴ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አት ሰበ ፉርቴ ሰነ፣","poem":1},{"text":"ጃለለኬ ህንጌደረምኔን ጌጌስተ።","poem":2},{"text":"ጀብነኬቲንስ","poem":1},{"text":"ገረ እዶ ጅሬኘኬቲ ቁልቁሉት እሳን ቀጄልችተ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሰቦትን ዸገአኒ ሆለቱ፤","poem":1},{"text":"ሙደምሱንስ ሰበ ፍልስጤም ቀበቴ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሀንገፎትን ኤዶም ንርፈቱ፤","poem":1},{"text":"ቡልችቶተ ሞኣብስ ናሱቱ ቀበተ፤","poem":2},{"text":"ወር ከነኣንስ ብሻኑመ ተኡ፤","poem":1}]},{"type":"verse","number":16,"content":[{"text":"ሶዳፊ አብዲ ኩተቹን እሳንረ ቡአ።","poem":2},{"text":"ያ ዋቀዮ፣ ሀመ ሰብንኬ ደርቡት፣","poem":1},{"text":"ሀመ ሰብን አት ብተቴ ሱን ደርቡት","poem":2},{"text":"ጀብነ ሀርከኬቲቲን","poem":1},{"text":"እሳን አኩመ ዸጋ ጨልእሱ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ያ ዋቀዮ፣ አት ገረ ቱሉ ዻለኬቲት፣","poem":1},{"text":"ገረ ለፈ እዶ ጅሬኘኬቲ ጎዸቹፍ ቶልፈቴት፣","poem":2},{"text":"ያ ጎፍታ አት ገረ እዶ ቁልቁሉ ሀርክኬ ሁንዴሴት","poem":1},{"text":"ኦል ገልችቴ እሳን ዻብደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“ዋቀዮ፣","poem":1},{"text":"በረ በራ ሀመ በረ በራት ሞአ።”","poem":2}]},{"type":"verse","number":19,"content":["ዮሙ ፈርዴን፣ ጋሪወኒፊ አቦቲን ፈርዳ ከን ፈረኦን ገላነ ሴነንት ዋቀዮ ብሻኖተ እሳንረ ገረገልቼ፤ እስራኤሎን ገሩ ለፈ ጎጋረ ዴመኒ ገላነ ኬሰ ደርበን።"]},{"type":"verse","number":20,"content":["ሚርያም ኦቦሌቲን አሮን ራጅቲን ሱን ድቤ ሀርከት ቀበቴ ካቴ፤ ዱበርቶትን ሁንድኑስ ድቤሳኒ ፉዸተኒ ስርባ እሼ ፋነ ቡአን።"]},{"type":"verse","number":21,"content":["ሚርያምስ አከነ ጄቴ እሳኒፍ ፋርፈቴ፦",{"text":"“ዋቀዮ ፋርፈዻ፤","poem":1},{"text":"እን ኡልፍናን ሞአቴራቲ።","poem":2},{"text":"እን ፈርዳፊ ነምቸ ፈርደ ያበቴ","poem":1},{"text":"ገላነት ገድ ደርበቴረ።”","poem":2}]},{"type":"heading","content":["ብሻን ማራቲፊ ብሻን ኤልም"]},{"type":"verse","number":22,"content":["ሙሴንስ ሰበ እስራኤል ገላነ ዲማ ብራ ፉዼ ቀጄልቼ፤ እሳንስ ገሞጂ ሹር ሴነን። እስራኤሎንስ ኡቱ ብሻን ህንአርገን ጉያ ሰዲ ገሞጂ ኬሰ ዴመን።"]},{"type":"verse","number":23,"content":["እሳንስ ዮሙ ማራ ገአንት ብሻንሳ ዹጉ ህንደንዴኜ፤ ብሻን ሱን ሀዻኣ ቱሬቲ። ወን እዶን ሱን ማራ ጄዸሜፍስ ከኑመ።"]},{"type":"verse","number":24,"content":["ጀር ሱንስ፣ “ኑ ማል ሃዹግኑ?” ጄዸኒ ሙሴት ጉንጉመን።"]},{"type":"verse","number":25,"content":["ዮሙስ ሙሴን ዋቀዮት እይናን፣ ዋቀዮ ሙከ ቶኮ እሰ አርግሲሴ። እንስ ሙከ ሰነ ብሻንት ገድ ደርበቴ፤ ብሻን ሱንስ ንምኣዌ። ዋቀዮስ እዶ ሰነት ስርናፊ ሴረ እሳኒፍ ባሴ፤ አችትስ እሳን ቆሬ።"]},{"type":"verse","number":26,"content":["እንስ አከነ ጄዼ፤ “አት ዮ ሰገሌ ዋቀዮ ዋቀኬቲ ገራ ቶኮን ዸጌሴ፣ ዮ ዋን ፉለሳ ዱረት ቀጄላ ተኤ ሆጄቴ፣ ዮ አጀጀሳ ቀልቤፈቴፊ ዮ ሴረሳ ሁንደ ኤግዴ፣ አን ዹኩበ ወረ ግብጥት ፍዴ ሰነ ኬሳ ቶኮዩ ስት ህንፍዱ፤ አን ዋቀዮ ስ ፈይሱዻቲ።”"]},{"type":"verse","number":27,"content":["እሳንስ ገረ ኤልም እዶ ቡርቃን ኩዸ ለማፊ ሙኬን ሜጢ ቶርባተምን ቱረን ዹፈኒ አች ብሻን ብረ ቁበተን።"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}