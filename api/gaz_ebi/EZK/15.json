{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"EZK","translationId":"gaz_ebi","name":"ህስቅኤል","commonName":"ህስቅኤል","title":"ራጂ ህስቅኤል","order":26,"numberOfChapters":48,"sha256":"af80acfc73efe6615d103dcab7543947061995ec1d09357c16394369c3075f2f","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/gaz_ebi/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":15,"content":[{"type":"heading","content":["ዬሩሳሌም ወይኒ ፋይዳ ህንቀብኔ"]},{"type":"verse","number":1,"content":["ኤርገሲ ዱቢን ዋቀዮ አከነ ጄዼ ገረኮ ዹፌ፦"]},{"type":"verse","number":2,"content":["“ያ እልመ ነማ፣ ሙክን ወይኒ አከምት ደሜ ሙከ ቦሶነ ኬሰ ጅሩ ከሚዩ ጫለ?"]},{"type":"verse","number":3,"content":["ዋን ፋይዳ ቀቡ ቶልፈቹፍ ሙከ ወይኒ ሰነራ ተኩማ ሙክን ፉዸተሜ ቤካ? ዋ እሰት ፈንፈቹፍ ነሞትን እሰረት ፈኖ ንሆጄቱ?"]},{"type":"verse","number":4,"content":["እን ኤርገ አኩመ ቆራን እብደት ነቀሜ እብድ ሱን ፊጤሳ ለማን ጉቤ ግዱ ጠጵ ጎዼ ቦዴ ዋን ቶኮፍዩ ፋይዳ ቀባ?"]},{"type":"verse","number":5,"content":["እን ኡቱ ህንቱቀምን ፋይዳ ዮ ህንቀባትን፣ ኤርገ እብዳን ጉበሜ ጠጵ ጄዼሞ ሀመም ፋይዳ ገድ ኣና ሃቀባቱሬ?"]},{"type":"verse","number":6,"content":["“ከናፉ ዋቀዮ ጎፍታን አከነ ጄዸ፦ አን አኩመ ሙከ ወይኒ ሙኬን ቦሶና ግዱ ጅሩ አከ እን ቦበኡፍ እብደት ነቄ ሰነ፣ ኡመተ ዬሩሳሌም ኬሰ ጅራቱሌ አከሱመ ነንጎዸ።"]},{"type":"verse","number":7,"content":["አን ሀምናን ፉለኮ እሳንት ነንዴብሰ። እሳን እብደ ኬሳ በአንዩ፣ እብድ አመዩ እሳን ንበሌሰ። ዬሮ አን ሀምናን ፉለኮ እሳንት ዴብፈዹት፣ እስን አከ አን ዋቀዮ ተኤ ንቤክቱ።"]},{"type":"verse","number":8,"content":["ሰበቢ እሳን አመነሙ ድደኒፍ አን ብየቲ ነንኦንሰ፣ ጄዸ ዋቀዮ ጎፍታን።”"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/EZK/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/EZK/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/EZK/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}