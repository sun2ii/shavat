{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"EZK","translationId":"gaz_ebi","name":"ህስቅኤል","commonName":"ህስቅኤል","title":"ራጂ ህስቅኤል","order":26,"numberOfChapters":48,"sha256":"af80acfc73efe6615d103dcab7543947061995ec1d09357c16394369c3075f2f","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/gaz_ebi/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":19,"content":[{"type":"heading","content":["ፋሩ ቦእቻ"]},{"type":"verse","number":1,"content":["“ዋኤ እልማን ሞቶተ እስራኤሊፍ ፋርሲ ቦእ፤"]},{"type":"verse","number":2,"content":["አከነስ ጄዽ፦",{"text":"“ ‘ሃትኬ ሌንጮተ ግዱት፣","poem":1},{"text":"ሌንጨ አከሚ ቱርቴ!","poem":2},{"text":"እሼን ሌንጮተ ግዱ ጪፍቴ","poem":1},{"text":"እልሞሌሼ ጉድፈቴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እልሞሌሼ ኬሳስ ቶኮ ጉድፈቴ፤","poem":1},{"text":"እንስ ሌንጨ ጀባ ተኤ።","poem":2},{"text":"እን ዋ አደምሴ ጭጭረቹ በረቴ፤","poem":1},{"text":"ነሞተ ስ ኛቴ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሰቦትን ዋኤሳ ዸገአን፤","poem":1},{"text":"እን ቦለሳኒ ኬሰት ቀበሜ።","poem":2},{"text":"እሳን ሆኮዻን ሀርክሰኒ","poem":1},{"text":"ገረ ብየ ግብጥት እሰ ጌሰን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ ‘እሼን ዮሙ አከ አብዲንሼ ህንጉተምን፣","poem":1},{"text":"አከ ወን እሼን ያዴስ ህንምልካእን አርግቴት፣","poem":2},{"text":"እልሞሌሼ ኬሳ ከን ብራ ፉዸቴ","poem":1},{"text":"ሌንጨ ጀባ ጎቴ ጉድፍቴ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እን ሌንጮተ ግዱ ብዲቄ፤","poem":1},{"text":"ሌንጨ ጀባ ተኤራቲ።","poem":2},{"text":"እን ዋ አደምሴ ጭጭረቹ በረቴ፤","poem":1},{"text":"ነሞተ ስ ኛቴ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እን ደአትኖሳኒ ዲጌ፤","poem":1},{"text":"መጋላወንሳኒስ ኦንሴ።","poem":2},{"text":"ብየቲፊ ከኔን እሼ ኬሰ ጅራተን ሁንድ","poem":1},{"text":"ኣዱሳቲን ራፈመን።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኤርገሲ ሰቦትን ወር ኩታሌ ብየ ናኖ","poem":1},{"text":"ሰና ጅረን እሰት ከአን።","poem":2},{"text":"እሳንስ ክዮሳኒ እሰ ዱረት ድሪርሰን፤","poem":1},{"text":"እንስ ቦለሳኒ ኬሰት ቀበሜ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እሳን ሆኮዻን ቀበኒ መነ ሽቦ ኬሰ እሰ ካአን፤","poem":1},{"text":"ገረ ሞቲ ባብሎንት እሰ ፍደን።","poem":2},{"text":"መነ ህዻት እሰ ገልቸን፤","poem":1},{"text":"ከናፉ ኣዱንሳ","poem":2},{"lineBreak":true},{"text":"ቱሉወን እስራኤልረት ኤርገሲ ህንዸገአምኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘ሃትኬ አኩመ ወይኒ","poem":1},{"text":"ለፈ ቆቲሳኬ ኬሰ ብሻን ብረ ዻበቴት፤","poem":2},{"text":"ብቅልቱን ሱንስ ሰበቢ ብሻን ባይኤ አርገቴፍ","poem":1},{"text":"ምስቴ ደሜ ሄዱ ባፈቴ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ደሜወንሳስ ጀጀቦ","poem":1},{"text":"ቦኩ ቡልቻቲፍ ተአን ቱረን።","poem":2},{"text":"እሼን ባለወን ጎበተን ግዱት","poem":1},{"text":"ኦል ዼርነሼቲፊ","poem":2},{"text":"ባይእነ ደሜወንሼቲን","poem":1},{"text":"ኦል ዼረቴ ሙልአት ቱርቴ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እሼን ገሩ ኣሪዻን ቡቅፈምቴ","poem":1},{"text":"ለፈት ገተምቴ።","poem":2},{"text":"ቡቤን በአ ቢፍቱ እሼ ጎግሴ","poem":1},{"text":"እጀሼ እራ ሀርጫሴ፤","poem":2},{"text":"ደሜወንሼ ጭጭሞንስ ንጮለገን፤","poem":1},{"text":"እብድስ እሳን ፍጤ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አመ እሼን ገሞጂ ኬሰ፣","poem":1},{"text":"ለፈ ጎጋ ዼቦቴረ ዻበምቴ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ደሜሼ ቶኮ ኬሳ እብድ በኤ","poem":1},{"text":"እጀሼ ፍጤ።","poem":2},{"text":"ደሜን ጀባን ቦኩ ቡልቻቲፍ ተኡ","poem":1},{"text":"ቶኮዩ እሼረት ህንሀፍኔ።’","poem":2},"ኩን ፋሩ ቦእቻ ከን ቦእቻፍ እት ፈየደመኒዸ።”"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}