{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"EZK","translationId":"gaz_ebi","name":"ህስቅኤል","commonName":"ህስቅኤል","title":"ራጂ ህስቅኤል","order":26,"numberOfChapters":48,"sha256":"af80acfc73efe6615d103dcab7543947061995ec1d09357c16394369c3075f2f","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/gaz_ebi/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":21,"content":[{"type":"heading","content":["ባብሎን ጎራዴ ሙርቲ ዋቃት"]},{"type":"verse","number":1,"content":["ዱቢን ዋቀዮ አከነ ጄዼ ገረኮ ዹፌ፦"]},{"type":"verse","number":2,"content":["“ያ እልመ ነማ፣ ፉለኬ ገረ ዬሩሳሌምት ገረገልፈዹቲ እዶ ቁልቁሉ ከናን ሞርሚ ለለብ። ብየ እስራኤሊንስ ሞርሚ ራጂ ዱበዹ፤"]},{"type":"verse","number":3,"content":["አከነስ እሼን ጄዽ፦ ‘ዋቀዮ አከነ ጄዸ፦ አን ስት ነንከአ። ጎራዴኮ መንኤሳ ኬሳ ሉቅፈዼ ነመ ቀጄላስ፣ ሀማስ ስ ኬሳ ነንበሌሰ።"]},{"type":"verse","number":4,"content":["ዋን አን ነመ ቀጄላስ፣ ነመ ሀማስ በሌሱዻፍ ጎራዴንኮ ሰበ ክባ ሀመ ካባት ጅሩት ንሉቅፈመ።"]},{"type":"verse","number":5,"content":["አከ አን ዋቀዮ ጎራዴኮ መንኤሳ ኬሳ ሉቅፈዼ፣ ነምን ሁንድ ንቤከ፤ እንስ መንኤሳት ህንዴብኡ።’"]},{"type":"verse","number":6,"content":["“ከናፉ ያ እልመ ነማ፣ ኣድ! ፉለሳኒ ዱረት ገራ ጨባፊ ገደ ሀዻኣዻን ኣድ።"]},{"type":"verse","number":7,"content":["ዮሙ እሳን፣ ‘አት ማሊፍ ኣደ?’ ጄዸኒ ስ ጋፈተንት፣ ‘ሰበቢ ኦዱ ዸገአማ ጅሩቲፍ። ኦኔን ሁንድ ንበቅጥ፤ ሀርክ ሁንድስ ንላፈ፤ ሀፉር ሁንድ ንገገበ፤ ጅልብ ሁንድስ ብሻን ተአ።’ ኦዱን ሱን ዸገአማ ጅረ! ዹጉማንስ ንተአ፣ ጄዸ ዋቀዮ ጎፍታን።”"]},{"type":"verse","number":8,"content":["ኤርገሲ ዱቢን ዋቀዮ አከነ ጄዼ ገረኮ ዹፌ፤"]},{"type":"verse","number":9,"content":["“ያ እልመ ነማ፣ ራጂ ዱበዹቲ፣ ‘ጎፍታን አከነ ጄዸ’ ጄዽ፦",{"text":"“ ‘ጎራዴ! ጎራዴ!","poem":1},{"text":"ጎራዴ ቀረሜ ጩሉሉቅፈሜ፣","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ከን አጄሱፍ ቀረሜ፣","poem":1},{"text":"አከ በለቄ ጨለቅሱዻፍ ጩሉሉቅፈሜ!","poem":2},"“ ‘ኑ ቦኩ እልመኮ ይሁዳቲን ገመድና? ጎራዴን ኡሌ አከሲ ሁንደ ቱፈተ።"]},{"type":"verse","number":11,"content":[{"text":"“ ‘ጎራዴን አከ ሀርካን ቀበተሙፍ","poem":1},{"text":"ጩሉሉቅፈሙፍ ረመደሜረ፤","poem":2},{"text":"ሀርከ ወረ ነመ ቀሉት ኬነሙፍ","poem":1},{"text":"ቀረሜ ጩሉሉቅፈሜረ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ያ እልመ ነማ፣ ኩን ሰበኮት፣","poem":1},{"text":"እልማን ሞቶተ እስራኤል ሁንደት ዹፌራቲ፣","poem":2},{"lineBreak":true},{"text":"እዪ ወዋዹ።","poem":2},{"text":"እሳን ሰበኮ ወጅን","poem":1},{"text":"ጎራዴዻፍ ኬነመኒሩ።","poem":2},{"text":"ከናፉ አት ለጴኬ ሩኩት።","poem":1}]},{"type":"verse","number":13,"content":["“ ‘ቆሩምስ ዹጉማን ንዹፈ። ዮ ቦኩን ጎራዴን ቱፈቴ ሱን እት ፉፉ ባቴሆ? ጄዸ ዋቀዮ ጎፍታን።’"]},{"type":"verse","number":14,"content":[{"text":"“ከናፉ ያ እልመ ነማ፣ አት ራጂ ዱበዹ፤","poem":1},{"text":"ሀርከኬስ ወልት ሩሩኩት።","poem":2},{"text":"ጎራዴን ዬሮ ለመ፣","poem":1},{"text":"ዬሮ ሰዲስ ሃዸኡ።","poem":2},{"text":"ጎራዴን ኩን ጎራዴ ነመ ፍጡ፣","poem":1},{"text":"ጎራዴ አከ መሌ ነመ ፍጡ፣","poem":2},{"lineBreak":true},{"text":"ከን ቅጠ ሁንዳን እሳን መርሱዸ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኩንስ አከ ኦኔን በቅጤ","poem":1},{"text":"ሄዱንሳኒ በርበዴፈመኒፍ","poem":2},{"text":"አን በልበለሳኒ ሁንደ ዱረ","poem":1},{"text":"አጄቻፍ ጎራዴ ካኤረ።","poem":2},{"text":"ወዮ! እን አከ ጨለቅሱፍ ሀጣአሜረ፤","poem":1},{"text":"እን ነመ አጄሱፍ ጩሉሉቅፈሜ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ያ ጎራዴ፣","poem":1},{"text":"ከለቲ ቀረኬቲ ሁንዳን","poem":2},{"lineBreak":true},{"text":"ከራ ምርጋቲንስ፣ ከራ ብታቲንስ ኩት።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አንስ ሀርከኮ ወልት ነንሩሩኩተ፤","poem":1},{"text":"ዼከምስኮስ ንቀበናአ።","poem":2},{"text":"አን ዋቀዮ ዱበዼራ።”","poem":1}]},{"type":"verse","number":18,"content":["ዱቢን ዋቀዮ አከነ ጄዼ ገረኮ ዹፌ፦"]},{"type":"verse","number":19,"content":["“ያ እልመ ነማ፣ አከ ጎራዴን ሞቲ ባብሎን እቲን ዹፉፍ ዳንዲ ለመ ባስ፤ ለቸኑ ብዩመ ቶኮ ከኡ። እዶ ዳንዲን ሱን ገረ መጋላት ጎሩረስ መለቶ ዻብ።"]},{"type":"verse","number":20,"content":["ጎራዴ ረባ አሞኖታት ዹፉፍ ዳንዲ ቶኮ መለቶ ጎዸዹ፤ ከን ይሁዳፊ መጋላ ዬሩሳሌም እሼ ደአትኖ ቀብዱ ሰነት ዹፉሞ ዳንዲ ለመፋ መለቶ ጎዸዹ።"]},{"type":"verse","number":21,"content":["ሞቲን ባብሎን ምልኪ እላለቹፍ ጄዼ እዶ ዳንዲን ሱን ወል ገኡረ፣ ፊጤ ዳንዲወን ለማኒረ ዻበተ፤ እንስ ጥያን እጣ ቡፈተ፤ ዋቆተሳ ቶልፈሞ ሰናን ንመርአተ፤ ትሩስ ንእላለተ።"]},{"type":"verse","number":22,"content":["አከ እን ዋን እቲን ደላ ዲጉ ዻቡፍ፣ አከ አጀጀ አጄቻ ኬኑፍ፣ አከ ወጨ ወራና ዸጌስሱፍ፣ አከ ዋን እቲን ደላ ዲገን ከረ ዱረ ካኡፍ፣ አከ ብዮ ቱሉፊ አከ ደአትኖ ሆጄቱፍ ሀርከሳ ምርጋት እጣን ዬሩሳሌሚፍ በኤ።"]},{"type":"verse","number":23,"content":["ወን ኩንስ ወረ እሰ ወጅን ከኩ ገለኒፍ ምልኪ ሶባ ፈካተ፤ እን ገሩ ዶጎጎረሳኒ እሳን ያደቺሴ ቦጁዻን እሳን ፉዸተ።"]},{"type":"verse","number":24,"content":["“ከናፉ ዋቀዮ ጎፍታን አከነ ጄዸ፦ ‘እስን ሰበቢ አከ ጩቡንኬሰን ዋን እስን ሆጄተን ሁንደ ኬሰት ሙልአቱፍ፣ አከ በሌሳንኬሰን ህንዾከትኔ ጎቹዻን ዋን አከ የክኬሰን ያደተሙ ጎተኒፍ ጄቹንስ ዋን አከነ ጎተኒፍ ንቦጅአምቱ።"]},{"type":"verse","number":25,"content":["“ ‘ያ እልመ ሞቲ እስራኤል ጡራኣፊ ሀማነነ፣ ከን ጉያንኬ ዽኣቴ፣ ከን ዬሮን አደበመኬቲ ፊጤ ገኤ፣"]},{"type":"verse","number":26,"content":["ዋቀዮ ጎፍታን አከነ ጄዸ፦ መረተ ኦፍራ ሂክ፤ ጎንፎስ ኦፍራ ፉዽ። ወንት አከ አመ ጅሩት ሀፉ ህንጅሩ፤ ከን ገድ ቀበሜ ኦል ቀበመ፤ ከን ኦል ቀበሜሞ ገድ ቀበመ።"]},{"type":"verse","number":27,"content":["ዲገመ! ዲገመ! አን እሼ ነንዲገ! ሀመ ነምን እሼን እሳፍ መልቱ ዹፉት እሼን አከ ከናን ዱራ ህንታቱ፤ እሼስ እሳፍ ነንኬነ።’"]},{"type":"verse","number":28,"content":["“ያ እልመ ነማ፣ አከነ ጄዺ ራጂ ዱበዹ፤ ‘ዋቀዮ ጎፍታን ዋኤ አሞኖታፊ አረብሶሳኒ አከነ ጄዸ፦",{"text":"“ ‘ጎራዴ፣ ጎራዴ፣","poem":1},{"text":"ከን አጄሱፍ ሉቅፈሜ፣","poem":2},{"text":"አከ ፍጡፊ አከ ጨለቅሱፍ","poem":1},{"text":"ከን ሀጣአሜ!","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ሙልአትን ሶባ ዋኤኬቲፍ፣","poem":1},{"text":"ራጂን ሶባ ሲፍ ጅራቱዩ፣","poem":2},{"text":"እን ሞርመ ሀሞተ አጄፈሙ ቀበን","poem":1},{"text":"ከኔን ጉያንሳኒ ዽኣቴ፣","poem":2},{"text":"ወረ ዬሮን አደቢሳኒ","poem":1},{"text":"ገኤረ ንካአመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“ ‘ጎራዴ መንኤሳት ዴብስ፤","poem":1},{"text":"እዶ አት እት ዸለቴት፣","poem":2},{"text":"ብየ አካከዩኬቲት፣","poem":1},{"text":"አን ስት ነንሙረ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"አን ዼከምሰኮ ስረት ነንዸንገላሰ፤","poem":1},{"text":"እብደ ኣሪኮቲስ ስት ነንቡፈ፤","poem":2},{"text":"አን ነሞተ ሀሞ ከኔን በሌሱዻን ቤከመንት","poem":1},{"text":"ደበርሴ ስን ኬነ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"አት ቆራን እብዳ ታተ፤","poem":1},{"text":"ዺግንኬ ብየኬ ኬሰት ዸንገለአ፤","poem":2},{"lineBreak":true},{"text":"ስአች ህንያደተምቱ፤","poem":2},{"text":"አን ዋቀዮ ዱበዼራቲ።’ ”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/EZK/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/EZK/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/EZK/20.json","previousChapterAudioLinks":{},"numberOfVerses":32}