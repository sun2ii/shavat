{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"EZK","translationId":"gaz_ebi","name":"ህስቅኤል","commonName":"ህስቅኤል","title":"ራጂ ህስቅኤል","order":26,"numberOfChapters":48,"sha256":"af80acfc73efe6615d103dcab7543947061995ec1d09357c16394369c3075f2f","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/gaz_ebi/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":27,"content":[{"type":"heading","content":["ፋሩ ቦእቻ ጢሮሲፍ ጎዸሜ"]},{"type":"verse","number":1,"content":["ኤርገሲ ዱቢን ዋቀዮ አከነ ጄዼ ገረኮ ዹፌ፦"]},{"type":"verse","number":2,"content":["“ያ እልመ ነማ፣ ዋኤ ጢሮስ ፋርሲ ቦእ።"]},{"type":"verse","number":3,"content":["ጢሮስ እሼ በልበለ ገላናረ ጅራቱ፣ ከን ኡመተ ቀርቀረ ገላና ሁንዳፍ ደልደልቱ ታቴ ሰናን አከነ ጄዽ፤ ‘ዋቀዮ ጎፍታን አከነ ጄዸ፦",{"text":"“ ‘ያ ጢሮስ፣","poem":1},{"text":"አት፣ “አን በሬድናን ህርእነ ህንቀቡ” ጄተ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዳንጋንኬ ገራ ገላና ኬሰ፤","poem":1},{"text":"ወር ስ እጃረን በሬዱ ህርእነ ህንቀብኔ ስ ታስሰኒሩ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እሳን ላጣ ዶኒኬቲ","poem":1},{"text":"ብርብርሰ ሴኒሪ ዹፌን ሆጄተን፤","poem":2},{"text":"ኡቱባ ዶኒ ሲፍ ቶልቹፍስ","poem":1},{"text":"ልባኖኒ ብርብርሰ ፍደን።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ቅልጡ ባሻኒ ዹፌን","poem":1},{"text":"በቶኬ ሆጄተን፤","poem":2},{"text":"ሙከ ብርብርሳ ከን ቀርቀረ ቆጵሮሲቲ ዹፌን","poem":1},{"text":"ለፈ ዶኒ ኬሳ እልከ አርባቲንሚዸግሰኒ ሲፍ ሆጄተን።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሸራን ዶኒኬቲ ቁንጬ ተልባ","poem":1},{"text":"ከን ሚዸግፈሜ ብየ ግብጢ ዹፌ ቱሬ፤","poem":2},{"lineBreak":true},{"text":"እንስ አከ ፋጂት ስ ፈየዴ፤","poem":2},{"text":"ሀጉጊንኬስ ብፈ ጩቁሊሳፊ ዲማ ዺልጌ","poem":1},{"text":"ከን ቀርቀረ ኤሊሻቲ ዹፌ ቱሬ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሞቅጦንኬ ነሞተ ሲዶናፊ አርዋዲ ዹፈን ቱረን፤","poem":1},{"text":"ያ ጢሮስ ሀዮትንኬ ኦፍቶተ ዶኒኬቲ ቱረን።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኦጌዪን ጌባል ከኔን ሙጠትኖ ጉዳ ቀበን፣","poem":1},{"text":"ቃወ ዶኒኬቲ ዱቹፍ ስ ግዱ ቱረን።","poem":2},{"text":"ዶኒወን ገላናቲፊ ኦፍቶትንሳኒ ሁንድ፣","poem":1},{"text":"ስ ወጅን ደልደሉፍ ገረኬ ዹፉ ቱረን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘ነሞትን ፋሬስ፣ ከን ሉዲፊ ከን ፉጢ፣","poem":1},{"text":"ሎልቱማዻን ሎልቶተኬ ግዱ ተጃጅለን።","poem":2},{"text":"እሳንስ ስ ሚዸግሱፍ ጋቸነወንሳኒፊ","poem":1},{"text":"ጎንፎሳኒ ስ ኬሰት ፈንሰን።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ነሞትን አርዋዲፊ ሄሌኪ","poem":1},{"text":"ደላኬ ቅጠ ሁንዳን ኤገን፤","poem":2},{"text":"ነሞትን ገማዲ","poem":1},{"text":"ገሞወንኬ ኬሰ ቱረን።","poem":2},{"text":"ጋቸነሳኒስ ናኔሰኒ ደላኬት ፈንሰን፤","poem":1},{"text":"እሳን በሬዱ ሀንቅነ ህንቀብኔ ስ ታስሰን።","poem":2}]},{"type":"verse","number":12,"content":["“ ‘ሰበቢ ጉድነ ቀቤኘኬቲቲፍ ተርሺሽ ስ ወጅን ደልደላ ቱርቴ፤ እሳን ሜቲ፣ ስቢለ፣ ቆርቆሮፊ ድላሊ ፍደኒ ስ ወጅን ወል ጌደራ ደልደላ ቱረን።"]},{"type":"verse","number":13,"content":["“ ‘ግሪክ፣ ቱባሊፊ ሜሼክ ስ ወጅን ደልደለን፤ እሳንስ ምኦተ ጉርጉራኬቲን ገርቦታፊ ምኦተ ናሲ ጌደሩ ቱረን።"]},{"type":"verse","number":14,"content":["“ ‘ነሞትን ቤት ቶገርማሞ ፈርዴን ፌእሳ፣ ፈርዴን ሎላቲፊ ጋንጎሊዻን ምአኬ ከን ደልደላ ጌደረቱ ቱሬ።"]},{"type":"verse","number":15,"content":["“ ‘ነሞትን ዴዳኒ ስ ወጅን ደልደለን፤ ብዮትን ቀርቀረ ገላና ባይኤንስ ማምሎተኬ ቱረን፤ እሳንስ እልከ አርባቲፊ ሙከ ሀርሰሜሳ ሲፍ ባሰን።"]},{"type":"verse","number":16,"content":["“ ‘ሰበቢ አት ኦምሸ ጉዳ ቀብዱፍ ሶርያን ስ ወጅን ደልደልት ቱሬ፤ እሳንስ መረግዲን፣ ኡፈተ ዲማ ዺልጌን፣ ወያ ፋዬፈሜን፣ ኡፈተ ቁንጬ ተልባራ ሆጄተሜ ሀጲሳቲን፣ ኤሌላኒፊ ሉለ ዲማዻን ምኦተኬ ደልደላ ጌደረተን።"]},{"type":"verse","number":17,"content":["“ ‘ይሁዳፊ እስራኤልስ ስ ወጅን ደልደለን፤ እሳንስ ቀመዲ ብየ ሚኒት፣ መጥኖ ምኣዋ፣ ደመ፣ ዘይቲፊ ባልሚን ምአ ደልደላኬ ጌደረተን።"]},{"type":"verse","number":18,"content":["“ ‘ሰበቢ ኦምሸኬ ሄዱቲፊ ቀቤኘ ምአኬ ጉዳ ሰናቲፍ ደማስቆን ዳዺ ወይኒ ሄልቦኒቲፊ ርፌንሰ ሆላ ዛሀሪቲን ስ ወጅን ደልደልቴርት።"]},{"type":"verse","number":19,"content":["ወር ዳኒፊ ያዋን ከኔን ኦሴሊ ዹፈን ምአ ደልደላኬ ብተተን፤ እሳንስ ስቢለ በቅፈሜ ሆጄተሜን ቡርጉዲፊ ቀረፋዻን ምኦተ ደልደላኬ ንጌደረቱ ቱሬ።"]},{"type":"verse","number":20,"content":["“ ‘ዴዳንሞ ኡፈተ ኮራ ስ ወጅን ደልደልቴ።"]},{"type":"verse","number":21,"content":["“ ‘ብይ አረባቲፊ እልማን ሞቶተ ቄዳር ሁንድ ማምሎተኬ ቱረን። እሳንስ ጦባላ ሆላ፣ ኮርቤዪ ሆላቲፊ ሬኦተ ስ ወጅን ደልደሉ ቱረን።"]},{"type":"verse","number":22,"content":["“ ‘ደልደልቶትን ሼባቲፊ ረእማ ስ ወጅን ደልደለኒሩ፤ ኡርጎፍቱወን ጎሰ ሁንዳ፣ ዸጋወን ገት ጀቤዪፊ ወርቄዻን ምኦተ ደልደላኬ ጌደረተኒሩ።"]},{"type":"verse","number":23,"content":["“ ‘ካራን፣ ከኔን፣ ኤዴን፣ ደልደልቶትን ሼባ፣ አሹሪፊ ክልማድ ስ ወጅን ደልደላ ቱረን።"]},{"type":"verse","number":24,"content":["እሳን እዶ ገባኬቲ ኬሰት ኡፈተ ምሚዸጋ፣ ኡፈተ ብፈ ጩቁሊሳ፣ ኡፈተ ፋዬፈሜፊ አፋ ሀሉ ገራ ገራ ከን ክሪ ምጪረሜ ጀቤፈሜ ዸአሜን ደልደለን።"]},{"type":"verse","number":25,"content":[{"text":"“ ‘ዶኒወን ተርሺሽ፣","poem":1},{"text":"ምኦተኬ ከን ደልደላ ሲፍ ፌአን።","poem":2},{"text":"አት ወለካ ገላናት","poem":1},{"text":"ፌኢሰ ኡልፋታዻን ጉተምቴርተ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ሞቅጦንኬ፣","poem":1},{"text":"ገረ ገላነ ጉዳት ስ ጌሰን።","poem":2},{"text":"ቡቤን በአ ቢፍቱ ገሩ","poem":1},{"text":"ገላነ ወለካት ስጨጨብሰ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ጋፈ ዶኒንኬ ጨጨቡት","poem":1},{"text":"ቀቤኝኬ፣ ሜሻንኬቲፊ ምእ ደልደላኬ፣","poem":2},{"text":"ነሞትንኬ ከኔን ዶኒዻን ሆጄተን፣","poem":1},{"text":"ኦፍቶትን ዶኒቲፊ ወር ዶኒ ሃሮምሰን፣","poem":2},{"lineBreak":true},{"text":"ደልደልቶትንኬቲፊ ሎልቶትንኬ ሁንድ","poem":2},{"text":"ነምን ዶኒረ ጅሩ ብራ ሁንድ","poem":1},{"text":"ገራ ገላና ኬሰት ገድ ልቅምፈሙ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ዬሮ ኦፍቶትን ዶኒኬቲ እየንት","poem":1},{"text":"ብዮትን ቀርቀረ ገላና ንራፈሙ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ወር በቶ ቀበተን ሁንድ፣","poem":1},{"text":"ወር ዶኒረ ሆጄተኒፊ ኦፍቶትን ዶኒ፣","poem":2},{"text":"ዶኒሳኒራ ቡአኒ","poem":1},{"text":"ቀርቀረ ገላና ዻበቱ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"እሳንስ ሰገሌሳኒ ኦል ፉዸተኒ","poem":1},{"text":"ህቅፈተኒ ሲፍ ቦኡ፤","poem":2},{"text":"መታሳኒትስ አዋረ ፍርፍርሰኒ","poem":1},{"text":"ዳራ ኬሰ ገንገለቱ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ዋኤኬቲፍስ መታ ሃደተኒ","poem":1},{"text":"ወያ ገዳ ኡፈቱ።","poem":2},{"text":"ሉቡሳኒቲን አከ መሌ ህቅፈተኒ","poem":1},{"text":"ገደ ጉዳዻን ንቦኡ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"እሳንስ ዬሮ ወዋተኒ ሲፍ ቦአንት፣","poem":1},{"text":"“ከን አከ ጢሮስ","poem":2},{"text":"ገላናን ልቅምፈሜ በዴ ኤኙ?”","poem":1},{"text":"ጄዸኒ ፋሩ ቦእቻ ሲፍ ፋርሱ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ዬሮ ምእ ደልደላኬ ገላነረ ኤርገሙት፣","poem":1},{"text":"አት ሰቦተ ሄዱ ቁፍስቴ፤","poem":2},{"text":"ቀቤኘኬ ጉዳፊ ምአኬቲን","poem":1},{"text":"ሞቶተ ለፋ ሶሮምስቴ።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"አመሞ አት ገላነ ኬሰት፣","poem":1},{"text":"ቱጁበ ብሻኒ ኬሰት ጨጨብዴርተ፤","poem":2},{"text":"ምኦትንኬቲፊ ሚልቶትንኬ ሁንድ","poem":1},{"text":"ሱመ ወጅን ልቅምፈመኒሩ።","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ወር ቀርቀረ ገላና ጅራተን ሁንድ","poem":1},{"text":"ዋኤኬቲን ርፈተኒሩ፤","poem":2},{"text":"ሞቶትንሳኒ ሶዳዻን ሆለተኒ","poem":1},{"text":"ፉልሳኒስ ናሱዻን ጌደረሜረ።","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ደልደልቶትን ሰቦተ ግዱ ጅረን ስት ሲቅሱ፤","poem":1},{"text":"ዹምንኬ ሱከኔሳ ተኤረ፤","poem":2},{"lineBreak":true},{"text":"አት ስአች በረ በራን ንዸበምተ።’ ”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/EZK/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/EZK/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/EZK/26.json","previousChapterAudioLinks":{},"numberOfVerses":36}