{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"EZK","translationId":"gaz_ebi","name":"ህስቅኤል","commonName":"ህስቅኤል","title":"ራጂ ህስቅኤል","order":26,"numberOfChapters":48,"sha256":"af80acfc73efe6615d103dcab7543947061995ec1d09357c16394369c3075f2f","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/gaz_ebi/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":28,"content":[{"type":"heading","content":["ራጂ ሞቲ ጢሮሲን ሞርሙዻን ዱበተሜ"]},{"type":"verse","number":1,"content":["ኤርገሲ ዱቢን ዋቀዮ አከነ ጄዼ ገረኮ ዹፌ፦"]},{"type":"verse","number":2,"content":["“ያ እልመ ነማ፣ ቡልቻ ጢሮሲን አከነ ጄዽ፤ ‘ዋቀዮ ጎፍታን አከነ ጄዸ፦",{"text":"“ ‘አት ኦፍ ቱሉማ ገራኬቲቲን፣","poem":1},{"text":"“አን ዋቀ፤","poem":2},{"text":"አን ሀንዹረ ገላና ኬሰ፣","poem":1},{"text":"ቴሶ ዋቃረ ነንታአ” ጄቴ።","poem":2},{"text":"ቀሮ አከ ዋቃ ኦፍ ሴቱዩ፣","poem":1},{"text":"አት ነመ መሌ ዋቀ ምት።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አት ዳንኤል ጫላ ኦጌሳ?","poem":1},{"text":"እጪቲን ቶኮዩ ስ ጀላ ህንዾከቱ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አት ኦጉማፊ ሁበትናኬቲን","poem":1},{"text":"ቀቤኘ አርገቴርተ፤","poem":2},{"text":"ወርቄፊ ሜቲ","poem":1},{"text":"መንኩሳኬ ኬሰት ኩፈቴርተ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አት ኦጉማ ጉዳ ደልደለ ኬሰት ቀብዱን","poem":1},{"text":"ቀቤኘኬ ባይእፈቴርተ፤","poem":2},{"text":"ሰበቢ ቀቤኘኬቲቲፍሞ","poem":1},{"text":"ገራንኬ ኦፍ ቱሉማዻን ጉተሜረ።","poem":2}]},{"type":"verse","number":6,"content":["“ ‘ከናፉ ዋቀዮ ጎፍታን አከነ ጄዸ፦",{"text":"“ ‘ሰበቢ አት ቀሮ አከ ዋቃ","poem":1},{"text":"ኦፍ ሴቱፍ፣","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አን ነሞተ ብየ ኦርማ","poem":1},{"text":"ሰቦተ አከ መሌ ገረ ጀቤዪ ስት ነንፍደ፤","poem":2},{"text":"እሳን ጎራዴሳኒ ሚዸግነኬቲፊ ኦጉማኬት ሉቅፈተኒ","poem":1},{"text":"ኡልፍነኬ ጉዳ ሰነ በሌሱ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እሳን ቦለ ኬሰ ስ ቡሱ፤","poem":1},{"text":"አትስ ገራ ገላና ኬሰት","poem":2},{"lineBreak":true},{"text":"ዱአ ሀማ ዱተ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዮስ አት ፉለ ወረ ስ አጄሰኒ ዱረት፣","poem":1},{"text":"“አን ዋቀ” ንጄታ?","poem":2},{"text":"አት ሀርከ ወረ ስ ጎረአኒ ኬሰት","poem":1},{"text":"ነሙመ መሌ ዋቀ ምት።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አት ሀርከ ነሞተ ብየ ኦርማት","poem":1},{"text":"ዱአ ነመ ዸግነ ህንቀበትኒ ዱተ።","poem":2},"አን ዱበዼረ፣ ጄዸ ዋቀዮ ጎፍታን።’ ”"]},{"type":"line_break"},{"type":"verse","number":11,"content":["ዱቢን ዋቀዮ አከነ ጄዼ ገረኮ ዹፌ፦"]},{"type":"verse","number":12,"content":["“ያ እልመ ነማ፣ ዋኤ ሞቲ ጢሮስ ፋርሲ ቦኢቲ አከነ ጄዺን፦ ‘ዋቀዮ ጎፍታን አከነ ጄዸ፦",{"text":"“ ‘አት ፈኬኘ ጉቱማት፤","poem":1},{"text":"ኦጉማዻን ጉተምቴርተ፤ ሚዸግናንስ ህርእነ ህንቀብዱ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አት እዶ ብቅልቱ ዋቃ፣","poem":1},{"text":"ኤዴን ኬሰ ቱርቴ፤","poem":2},{"text":"ዸጋወን ገት ጀቤዪን ሁንድ ስ በሬቹ፤ እሳንስ፦","poem":1},{"text":"ሉለ ዲማ፣ ቶጳዝዮን፣ አልማዚፊ መረግድ፣","poem":2},{"lineBreak":true},{"text":"ክርሶሊጦስ፣ ሰርዶንክሲፊ ያስጲድ፣","poem":2},{"lineBreak":true},{"text":"ሰንፔር፣ በሉሪፊ ቢረሌ።","poem":2},{"text":"ድረትንኬቲፊ ፋይንኬ ወርቄራ ቶልፈመን፤","poem":1},{"text":"እሳንስ ጉያ አት ኡመምቴ ቆጴፈመን።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አት ኪሩቢ ዋ ኤጉ ታቴ ድበምቴ፤","poem":1},{"text":"አንስ ከኑማፈን ስ ሙዴ።","poem":2},{"text":"አት ቱሉ ዋቃ ቁልቁልቸ ሰነረ ጅራቴ፤","poem":1},{"text":"ዸጋወን እብዳ ግዱስ ዴዴብቴ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አት ጋፈ ኡመምቴ ጀልቀብዴ","poem":1},{"text":"ሀመ ጋፈ ሀምን ስ ኬሰት አርገሜት","poem":2},{"lineBreak":true},{"text":"ጅሬኝኬ ህርእነ ህንቀቡ ቱሬ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"በበልእነ ደልደለኬቲቲን","poem":1},{"text":"ጎሊዻን ጉተምቴ ጩቡ ሆጄቴ።","poem":2},{"text":"ከናፉ ያ ኪሩቢ ኤጉምሳ፣","poem":1},{"text":"አን ቱሉ ዋቃራ","poem":2},{"text":"ዸጋወን እብዳ ግዱዻ","poem":1},{"text":"ስ ሰልጵሴ አርኤን ስ ባሴ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሰበቢ ሚዸግነኬቲቲፍ፣","poem":1},{"text":"አት ኮርቴርተ፤","poem":2},{"text":"ሰበቢ ኡልፍነኬቲቲፍ፣","poem":1},{"text":"ኦጉማኬ በሌስቴ።","poem":2},{"text":"ከናፉ አን ገረ ለፋተን ስ ደርበዼ፤","poem":1},{"text":"ፉለ ሞቶታ ዱረትስ ዋን ኮልፋን ስ ጎዼ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"አት ጩቡኬ ሄዱፊ ሸቀበ ደልደለኬቲቲን","poem":1},{"text":"እዶወንኬ ቁልቁሉ ጡሬስቴርተ።","poem":2},{"text":"ከናፉ አን አከ እብድ ስ ኬሳ በኡ ነንጎዼ፤","poem":1},{"text":"እንስ ጉቤ ስ ፍጤ፤","poem":2},{"text":"አንስ ፉለ ነሞተ ስ እላላ ቱረን ሁንዳ ዱረት","poem":1},{"text":"ለፈረት ዳራን ስ ታስሴ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሰቦትን ስ ቤከን ሁንድኑ","poem":1},{"text":"ስ አርገኒ ርፈተን፤","poem":2},{"text":"ዹምንኬ ሱከኔሳ ተኤረ፤","poem":1},{"text":"አት ስአች በረ በራን ንዸበምተ።’ ”","poem":2}]},{"type":"heading","content":["ራጂ ሲዶናዻን ሞርሙዻን ዱበተሜ"]},{"type":"verse","number":20,"content":["ኤርገሲ ዱቢን ዋቀዮ አከነ ጄዼ ገረኮ ዹፌ፤"]},{"type":"verse","number":21,"content":["“ያ እልመ ነማ፣ ፉለኬ ሲዶናት ገረገልፈዹቲ እሼዻን ሞርሙዻን ራጂ ዱበዹ፤"]},{"type":"verse","number":22,"content":["አከነስ ጄዽ፦ ‘ዋቀዮ ጎፍታን አከነ ጄዸ፦",{"text":"“ ‘ያ ሲዶና፣ አን ስት ከኤረ፤","poem":1},{"text":"ስ ኬሰት ኡልፍነ ነንአርገዸ።","poem":2},{"text":"ዬሮ አን እሼ አደቤ","poem":1},{"text":"አከ አን ቁልቁሉ ተኤ እሼ ኬሰት ኦፍ አርግሲሱት፣","poem":2},{"lineBreak":true},{"text":"እሳን አከ አን ዋቀዮ ተኤ ንቤኩ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"አን ዸእቸ እሼት ኤርጌ","poem":1},{"text":"አከ ዳንዲሼረ ዺግን ሎለኡ ነንጎዸ።","poem":2},{"text":"ነሞትን ጎራዴ ከራ ሁንዳን","poem":1},{"text":"እሼ መርሴን ጎረአመን እሼ ኬሰት ንሀርጨኡ።","poem":2},{"text":"ኤርገሲስ እሳን አከ አን ዋቀዮ ተኤ ንቤኩ።","poem":1}]},{"type":"verse","number":24,"content":["“ ‘ሰብን እስራኤል ስአች ኦሎተ ሀሞ አከ ሶኮሩ ነመ ወራነኒ አከ ቆራቲሞ ነመ መዴሰን ህንቀባቱ። ኤርገሲስ እሳን አከ አን ዋቀዮ ጎፍታ ተኤ ንቤኩ።"]},{"type":"verse","number":25,"content":["“ ‘ዋቀዮ ጎፍታን አከነ ጄዸ፦ ዬሮ አን መነ እስራኤል ሰቦተ እሳን ኬሰ ብብትናአን ኬሳ ወልት ቀቡት፣ አን አከን እሳን ግዱት ቁልቁሉ ተኤ ፉለ ሰቦታ ዱረት ኦፍ ነንአርግሲሰ። ኤርገሲ እሳን ብየ ኦፊሳኒ ከን አን ገርብቸኮ ያቆቢፍ ኬኔ ሰነ ኬሰ ንጅራቱ።"]},{"type":"verse","number":26,"content":["እሳን ነጋዻን አች ጅራተኒ መኔን እጃረተኒ ወይኒስ ዻበቱ፤ ዬሮ አን ኦሎተሳኒ ከኔን እሳን ጩንቁርሰን አደቡት፣ እሳን ነጉማን ጅራቱ። ኤርገሲ እሳን አከ አን ዋቀዮ ዋቀሳኒ ተኤ ንቤኩ።’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/EZK/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/EZK/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/EZK/27.json","previousChapterAudioLinks":{},"numberOfVerses":26}