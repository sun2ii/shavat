{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"EZK","translationId":"gaz_ebi","name":"ህስቅኤል","commonName":"ህስቅኤል","title":"ራጂ ህስቅኤል","order":26,"numberOfChapters":48,"sha256":"af80acfc73efe6615d103dcab7543947061995ec1d09357c16394369c3075f2f","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/gaz_ebi/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":30,"content":[{"type":"heading","content":["ፋሩ ቦእቻ ግብጢፍ ፋርሰሜ"]},{"type":"verse","number":1,"content":["ኤርገሲ ዱቢን ዋቀዮ አከነ ጄዼ ገረኮ ዹፌ፦"]},{"type":"verse","number":2,"content":["“ያ እልመ ነማ ራጅ፤ አከነስ ጄዽ፤ ‘ዋቀዮ ጎፍታን አከነ ጄዸ፦",{"text":"“ ‘ወዋዹቲ አከነ ጄዽ፤","poem":1},{"text":"“ጉያ ሰናፍ ወዮ!”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ጉያን ሱን ዽኦዸ፤","poem":1},{"text":"ጉያን ዋቀዮ ዽኦዸ፤","poem":2},{"text":"እንስ ጉያ ዱሜሳ፣","poem":1},{"text":"ሰቦታፍሞ ዬሮ በዲሳ ንተአ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ግብጥት ጎራዴን ንዹፈ፤","poem":1},{"text":"እቶጵያትሞ ዽጵን ንዹፈ።","poem":2},{"text":"ዮሙ ወር ቀለመን ግብጥ ኬሰት ኩኩፈንት፣","poem":1},{"text":"ቀቤኝሼ ሳመሜ ፉዸተመ፤","poem":2},{"lineBreak":true},{"text":"ሁንዴወንሼሞ ንዲገሙ።","poem":2}]},{"type":"verse","number":5,"content":["እቶጵያፊ ፉጥ፣ ሉዲፊ ብይ አረባ ሁንድ፣ ሊብያፊ ኡመትን ብየ ከኩ ግብጥ ወጅን ጎራዴዻን ንዹሙ።"]},{"type":"verse","number":6,"content":["“ ‘ዋቀዮ አከነ ጄዸ፦",{"text":"“ ‘ቱምስቶትን ግብጥ ንኩፉ፤","poem":1},{"text":"ሁምን እሼን እቲን ቦንቱ ንደዸበ።","poem":2},{"text":"ምግዶሊ ሀመ አስዋንት፣","poem":1},{"text":"እሳን እሼ ኬሰት ጎራዴዻን ንዹሙ፣","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ ጎፍታን።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እሳን ብዮተ ኦነን ግዱት፣ ኦነኒ ሀፉ፤","poem":1},{"text":"መጋላወንሳኒስ","poem":2},{"text":"መጋላወን ዲገመን","poem":1},{"text":"ግዱት አርገሙ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዮሙ አን ግብጥት እብደ ቀብሲሴ","poem":1},{"text":"ወር እሼ ገርጋረን ሁንድ በርበዳአንት፣","poem":2},{"lineBreak":true},{"text":"እሳን አከ አን ዋቀዮ ተኤ ንቤኩ።","poem":2}]},{"type":"verse","number":9,"content":["“ ‘ጋፈስ ነሞተ እቶጵያ ከኔን ያዶ መሌ ጅራተን ሶዳችሱፍ፣ ኤርገሞትን ዶኒዻን ነ ብራ ንበኡ። ጉያ በዲሰ ግብጥት ዽጵን እሳን ቀበተ፤ ወን ኩን ዹጉማን ንዹፋቲ።"]},{"type":"line_break"},{"type":"verse","number":10,"content":["“ ‘ዋቀዮ ጎፍታን አከነ ጄዸ፦",{"text":"“ ‘አን ሀርከ ኔቡከድኔዘር ሞትቸ ባብሎኒን","poem":1},{"text":"ነሞተ ግብጥ ሄዱ ነንበርበዴሰ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እኒፊ ሎልቶትንሳ ከኔን ሰቦተ ኬሳአከ መሌ ሀሞ ተአን፣","poem":1},{"text":"አከ ብየቲ በሌሰኒፍ ንፍደሙ።","poem":2},{"text":"እሳንስ ጎራዴሳኒ ግብጥት ሉቅፈተኒ","poem":1},{"text":"ሬፋን ብየቲ ጉቱ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አን ብሻን አበያ ነንጎግሰ፤","poem":1},{"text":"ብየቲስ ነሞተ ሀሞት ነንጉርጉረ፤","poem":2},{"text":"ሀርከ አለጎታቲን ብየቲፊ","poem":1},{"text":"ዋን እሼ ኬሰ ጅሩ ሁንደ ነንኦንሰ።","poem":2},"አን ዋቀዮ ዱበዼረ።"]},{"type":"line_break"},{"type":"verse","number":13,"content":["“ ‘ዋቀዮ ጎፍታን አከነ ጄዸ፦",{"text":"“ ‘አን ዋቆተ ቶልፈሞ ነንበሌሰ፤","poem":1},{"text":"ፈኪወን ሜምፊስ ኬሰ ጅረንስ ነንፈጫሰ።","poem":2},{"text":"ስአች ግብጥ ኬሰት ቡልቻን ህንአርገሙ፤","poem":1},{"text":"ብየቲ ጉቱ ኬሰስ ሶዳ ነንቡሰ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ጰጥሮስን ነንኦንሰ፤","poem":1},{"text":"ዞኣንት እብደ ነንቀብሲሰ፤","poem":2},{"lineBreak":true},{"text":"ቴቤሲንሞ ነንአደበ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ደአትኖ ግብጥ ጀባ ጄቹንስ","poem":1},{"text":"ሲንረት ዼከምሰኮ ነንዸንገላሰ፤","poem":2},{"lineBreak":true},{"text":"ኡመተ ቴቤስ ሄዱ ሰነሌ ነንበሌሰ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አን ግብጥት እብደ ነንቀብሲሰ፤","poem":1},{"text":"ሲን ዽጵናን ራፈምት።","poem":2},{"text":"ቴቤስ ደምበሊዻን ንፉዸተምት፤","poem":1},{"text":"ሜምፊስ ዽጵነ ወልራ ህንጭኔን ንዽጰት።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ደርገጎትን አዌኒፊ","poem":1},{"text":"ጲ-ቤሴት ጎራዴዻን ዹሙ፤","poem":2},{"lineBreak":true},{"text":"መጋላወን መታንሳኒዩ ንቦጅአሙ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዮሙ አን ዋንጆ ግብጥ ጨብሱት፣","poem":1},{"text":"ተህጳንሄስት ጉያን ንዱከናአ፤","poem":2},{"lineBreak":true},{"text":"ሁምን እሼን እቲን ቦንቱስ ንላፈ።","poem":2},{"text":"እሼን ሁሪዻን ሀጉገምት፤","poem":1},{"text":"ገንዶትንሼሞ ንቦጅአሙ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ከናፉ አን ግብጢን ነንአደበ፤","poem":1},{"text":"እሳንስ አከ አን ዋቀዮ ተኤ ንቤኩ።’ ”","poem":2}]},{"type":"verse","number":20,"content":["ወጋ ኩዸ ቶኮፋት፣ ጅአ ቶኮፋ ኬሰ፣ ጉያ ቶርበፋት ዱቢን ዋቀዮ አከነ ጄዼ ገረኮ ዹፌ፦"]},{"type":"verse","number":21,"content":["“ያ እልመ ነማ፣ አን እሬ ፈረኦን ሞትቸ ግብጥ ጨብሴረ። እን አከ ፈዩፍ ህንህዸምኔ ዮካን ሸምበቆን ህዸሜ አከ ጀባቴ ጎራዴ ቀበቹ ደንደኡ ህንጎዸምኔ።"]},{"type":"verse","number":22,"content":["ከናፉ ዋቀዮ ጎፍታን አከነ ጄዸ፦ አን ፈረኦን ሞትቸ ግብጥት ከኤረ። አን እሬሳ ለቸኑ፣ እሰ ፈያ፣ እሰ ጨቤ ሰነሌ ጨብሴ አከ ጎራዴን ሀርከሳቲ ቡኡ ነንጎዸ።"]},{"type":"verse","number":23,"content":["አን ነሞተ ግብጥ ሰቦተ ግዱት ነንፈፈጫሰ፤ ብዮተ ኬሰስ እሳን ነንብብትኔሰ።"]},{"type":"verse","number":24,"content":["እሬ ሞቲ ባብሎን ነንጀቤሰ፤ ጎራዴኮስ ሀርከሳ ኬሰ ነንካአ፤ እሬ ፈረኦን ገሩ ነንጨብሰ፤ እንስ ፉለሳ ዱረት አኩመ ነመ አከ መሌ መዳኤት ንኣደ።"]},{"type":"verse","number":25,"content":["እሬ ሞቲ ባብሎን ነንጀቤሰ፤ እሬን ፈረኦን ገሩ ንላፈ። ዮሙ አን ጎራዴኮ ሀርከ ሞቲ ባብሎን ኬሰ ካኤ እንሞ ግብጥት እሰ ምርምርሱት እሳን አከ አን ዋቀዮ ተኤ ንቤኩ።"]},{"type":"verse","number":26,"content":["አን ነሞተ ግብጥ ሰቦተ ግዱ ነንፈፈጫሰ፤ ብዮተ ኬሰስ እሳን ነንብብትኔሰ። እሳንስ አከ አን ዋቀዮ ተኤ ንቤኩ።”"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/EZK/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/EZK/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/EZK/29.json","previousChapterAudioLinks":{},"numberOfVerses":26}