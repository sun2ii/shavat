{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"EZK","translationId":"gaz_ebi","name":"ህስቅኤል","commonName":"ህስቅኤል","title":"ራጂ ህስቅኤል","order":26,"numberOfChapters":48,"sha256":"af80acfc73efe6615d103dcab7543947061995ec1d09357c16394369c3075f2f","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/gaz_ebi/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":31,"content":[{"type":"heading","content":["ጋትራ ልባኖን"]},{"type":"verse","number":1,"content":["ወጋ ኩዸ ቶኮፋት፣ ጅአ ሰደፋ ኬሰ፣ ጉያ ቶኮፋት ዱቢን ዋቀዮ አከነ ጄዼ ገረኮ ዹፌ፦"]},{"type":"verse","number":2,"content":["“ያ እልመ ነማ፣ ፈረኦን ሞትቸ ግብጢፊ ቱተ ነሞተሳቲን አከነ ጄዽ፦",{"text":"“ ‘ሱራዻን ኤኙቱ ሲን ቅጣተ?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ኩኖ አሶር አከ ብርብርሰ ልባኖን","poem":1},{"text":"ከን ደሜወን ምሚዸጎ ቀቡፊቦሶናፍ ጋድሰ ተኤ","poem":2},{"text":"አከ መሌ ኦል ዼራፊ","poem":1},{"text":"ከን ፊጤንሳ ዱሜሰ ቱቄ ቱሬ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ብሻን እሰ ብቅልቼ፤","poem":1},{"text":"ቡርቃወን ገድ ፈጎንሞ እሰ ጉድሴ፤","poem":2},{"text":"ለጌንሳኒ","poem":1},{"text":"ህደሳ ሁንደ መርሰኒ ያአኒ","poem":2},{"text":"ብሻንሳኒ","poem":1},{"text":"ገረ ሙኬን ቦሶና ሁንዳት ኤርጉ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ከናፉ እን ሙኬን ቦሶና ሁንዳን ኦልት","poem":1},{"text":"አከ መሌ ኦል ዼረቴ፤","poem":2},{"text":"ለታንሳ ንባይአቴ፤","poem":1},{"text":"ደሜንሳስ ንጉደቴ፤","poem":2},{"lineBreak":true},{"text":"እን ብሻን ባይኤ አርገቴ በበልአቴራቲ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ስምብሮትን ሰሚ ሁንድ","poem":1},{"text":"ደሜሳረት መንኤ እጃረተን፤","poem":2},{"text":"ብኔንሶትን ድሬ ሁንድ","poem":1},{"text":"ደሜሳ ጀለት ዸለን፤","poem":2},{"text":"ሰቦትን ጉርጉዳን ሁንድኑስ፣","poem":1},{"text":"ጋድሰሳ ጀለ ጅራተን።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እን ሰበቢ ህደሳ","poem":1},{"text":"ገረ ብሻን ባይኤት ገድ ፈጌፈቴፍ፣","poem":2},{"text":"ደሜወንሳ ከኔን በበልአተን ወጅን","poem":1},{"text":"አከ መሌ ሚዸጋ ቱሬ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጋትራወን እዶ ብቅልቱ ዋቃ ኬሰ ጅረን","poem":1},{"text":"እሰ ግቱ ህንደንዴኜ፤","poem":2},{"text":"ዮካን ሙኬን ብርብርሳ","poem":1},{"text":"ደሜወንሳቲን ህንቅጣተን፤","poem":2},{"text":"ሙክን ወዴሳስ","poem":1},{"text":"ደሜወንሳቲን ህንቅጣቱ፤","poem":2},{"text":"ሙክን እዶ ብቅልቱ ዋቃ ኬሰ ጅሩ ቶኮዩ","poem":1},{"text":"ሚዸግነሳቲን ወል ብረ ህንቀበሙ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አን ደሜወን ባይኤዻን","poem":1},{"text":"እሰ ነንሚዸግሴ፤","poem":2},{"text":"ሙኬን ኤዴንከኔን እዶ ብቅልቱ ዋቃ ኬሰ ጅረን ሁንድ","poem":1},{"text":"እሰት ህናፈን።","poem":2}]},{"type":"verse","number":10,"content":["“ ‘ከናፉ ዋቀዮ ጎፍታን አከነ ጄዸ፦ ሰበቢ እን ኦል ዼረቴ ፊጤንሳ ዱሜሰ ቱቄ እን ዼርነሳቲን ኦፍ ቱሌፍ፣"]},{"type":"verse","number":11,"content":["አከ እን ዋን ሀምነሳቲፍ መሉ እሳፍ ኬኑፍ፣ አን ደበርሴን ቡልቻ ሰቦታት እሰ ኬኔ። ደርበዼስ እሰ ነንገቴ፤"]},{"type":"verse","number":12,"content":["አለጎን አከ መሌ ሀሞንስ ጭጭረኒ እሰ ገተን። ለታወንሳ ጋረንራፊ ሱሉለወን ኬሰት ሀርጨአ፤ ደሜወንሳሞ ጭጭረመኒ ቦኦወን ብሻኒ ሁንደ ኬሰ ቡአን። ሰቦትን ለፋ ሁንድ ጋድሰሳ ጀላ በአኒ እሰ ዺሰኒ ዴመን።"]},{"type":"verse","number":13,"content":["ስምብሮትን ሰሚ ሁንድ ሙከ ጅጌ ሰነረ ቁበተን፤ ብኔንሶትን ድሬ ሁንድኑስ ደሜወንሳ ግዱ ቱረን።"]},{"type":"verse","number":14,"content":["ከናፉ ሙክን ብሻን ብረ ጅሩ ከምዩ አከ መሌ ህንጉደቱ ዮካን ፊጤንሳ ዱሜሰ ህንቱቁ። ሙክን አከስት ብሻን ቁፌ ከምዩ አከስ ኦል ዼረቴ ህንቤኩ። እሳን ሁንድ ወረ ዱአኒ ቦለ ቅሌት ገድ ቡአን ወጅን አከ ዱአን እት ሙርቴፈሜረ።"]},{"type":"verse","number":15,"content":["“ ‘ዋቀዮ ጎፍታን አከነ ጄዼ፦ ጉያ እን አዋለሜት አን እሳፍ ጄዼ ቡርቃወን ገድ ፈጎ ገዳን ነንጉቴ፤ ለጌንሳ ነንእትሴ፤ ብሻንሳ ጉድችስ ያኡ ዺሴ። ሰበቢሳቲፍ አን ልባኖንት ዱከነ ነንኡፍሴ፤ ሙኬን ድሬ ሁንድስ ንጎገን።"]},{"type":"verse","number":16,"content":["ዮሙ አን ወረ ቦለ ቡአን ሰነት ደበሌ አዋለ ኬሰ እሰ ቡሱት ሰገሌ ኩፋቲሳቲን አን ሰቦተ ነንሆለቺሰ። ኤርገሲስ ሙኬን ኤዴን ከኔን ልባኖን ኬሳ ፍለተሞፊ ከን አዳ ተአን ሁንድ፣ ሙኬን አከ ጋሪ ብሻን ኦባፈመን ሁንድ ቦለ ኬሰት ጀጀቤፈመን።"]},{"type":"verse","number":17,"content":["ወር ጋድሰሳ ጀለ ጅራተን ከኔን ሰቦተ ግዱዻ እሳፍ ቱምሰን፣ ወረ ጎራዴዻን አጄፈመንት መከሙፍ እሰ ወጅን አዋለ ኬሰ ቡአን።"]},{"type":"verse","number":18,"content":["“ ‘ሙኬን ኤዴን ኬሳ ከን ኡልፍናፊ ሱራዻን ሲን ቅጣቱ ከም? ተኡዩ ሙኬን ኤዴን ወጅን ቦለ ቡተ፤ አት ወረ ጎራዴዻን አጄፈመን ወጅን፣ ነሞተ ዸግነ ህንቀበትን ግዱ ጪፍተ። “ ‘ኩን ፈረኦኒፊ ወልዳ ኡመተሳ ሁንደ፣ ጄዸ ዋቀዮ ጎፍታን።’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/EZK/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/EZK/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/EZK/30.json","previousChapterAudioLinks":{},"numberOfVerses":18}