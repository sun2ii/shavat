{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"EZK","translationId":"gaz_ebi","name":"ህስቅኤል","commonName":"ህስቅኤል","title":"ራጂ ህስቅኤል","order":26,"numberOfChapters":48,"sha256":"af80acfc73efe6615d103dcab7543947061995ec1d09357c16394369c3075f2f","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/gaz_ebi/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":7,"content":[{"type":"heading","content":["ዹምን ዹፌረ"]},{"type":"verse","number":1,"content":["ኤርገሲ ዱቢን ዋቀዮ አከነ ጄዼ ገረኮ ዹፌ፦"]},{"type":"verse","number":2,"content":["“ያ እልመ ነማ፣ ዋቀዮ ጎፍታን ብየ እስራኤሊን አከነ ጄዸ፦",{"text":"“ ‘ዹመ! ጎሌ ብየቲ አፍረንት","poem":1},{"text":"ዹምን ዹፌረ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አመስ ዹምንኬ ገኤረ፤","poem":1},{"text":"ዼከምሰኮ ስረት ነንዸንገላሰ፤","poem":2},{"text":"አን አኩመ አመለኬቲት ስት ነንሙረ፤","poem":1},{"text":"ጎቸወንኬ ጅብሲሶ ሁንዳፍስ አን ስን አደበ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አን ገረ ላፍናን ስ ህንእላሉ","poem":1},{"text":"ዮካን ስ ህንባሱ፤","poem":2},{"text":"አን ሀመ ጎቸወንኬ ጅብሲሶን ሱን ስ ግዱ ጅረንት፣","poem":1},{"text":"አመለኬቲፍ ስን አደበ።","poem":2},"ኤርገሲስ እስን አከ አን ዋቀዮ ተኤ ንቤክቱ።’"]},{"type":"line_break"},{"type":"verse","number":5,"content":["“ዋቀዮ ጎፍታን አከነ ጄዸ፦",{"text":"“ ‘በዲ! በዲን ተካ ህንዸገአምን","poem":1},{"text":"ቶኮ ዹፋ ጅረ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዹምን ዹፌረ!","poem":1},{"text":"ዹምን ዹፌረ!","poem":2},{"text":"እን መታንሳ እስንት ከኤረ።","poem":1},{"text":"እን ዹፌረ!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ያ ወረ ብየቲ ኬሰ ጅራተን፣","poem":1},{"text":"በዲን እስንት ዹፌረ።","poem":2},{"text":"ዬሮን ገኤረ፤ ጉያን ዽኣቴረ፤","poem":1},{"text":"ቱሉወንረት ገመቹ ኡቱ ህንተእን ጄቁምሰቱ ተአ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አን ዼከምሰኮ ስት ዸንገላሱዻፈን ጅረ፤","poem":1},{"text":"ኣሪኮሌ ስት ነንበአ፤","poem":2},{"text":"አኩመ አመለኬቲትስ ስት ነንሙረ፤","poem":1},{"text":"ጎቻወንኬ ጅብሲሶ ሰነ ሁንዳፍስ ስን አደበ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አን ገረ ላፍናን ስ ህንእላሉ","poem":1},{"text":"ዮካን ስ ህንበራሩ።","poem":2},{"text":"ሀመ ጎቸወንኬ ጅብሲሶን ሱን ስ ግዱ ጅረንት","poem":1},{"text":"አን አኩመ አመለኬቲት ስን አደበ።","poem":2},{"lineBreak":true},"“ ‘ኤርገሲስ አከ ከን ሩኩቱ ሱን አነ ዋቀዮ ተኤ እስን ንቤክቱ።"]},{"type":"verse","number":10,"content":[{"text":"“ ‘ጉያን ሱን ኩኖት!","poem":1},{"text":"እን ዹፌረ!","poem":2},{"text":"በዲን ጨብሴ ዹፌረ፤","poem":1},{"text":"ኡሌን ለቴረ፤","poem":2},{"lineBreak":true},{"text":"ኦፍ ቱሉማን ደራሬረ!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጎሊን ጉደቴ ኡሌ ሀምነ አደቡ ተኤረ፤","poem":1},{"text":"እሳን ኬሳ ነምን ቶኮዩ ህንሀፉ፤","poem":2},{"text":"ወልዳሳኒ ኬሳ፣","poem":1},{"text":"ቀቤኘሳኒቲፊ","poem":2},{"text":"ዋን ፋይዳ ቀቡ ኬሳ","poem":1},{"text":"ቶኮዩ ህንሀፉ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዬሮን ሱን ዹፌረ፤","poem":1},{"text":"ጉያን ሱን ገኤረ።","poem":2},{"text":"እን ብቱ ህንገመድን፤","poem":1},{"text":"ከን ጉርጉሩስ ህንገድን፤","poem":2},{"lineBreak":true},{"text":"ዼከምስ ጉቱማሳኒት ዹፋቲ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሀመ ለማንሳኒዩ ሉቡን ጅረንት","poem":1},{"text":"እን ለፈ ጉርጉሬ ህንዴብፈቱ፤","poem":2},{"text":"ሙልአትን ዋኤ ሰባቲፍ ሙልአቴ","poem":1},{"text":"ዱበት ህንዴብኡቲ።","poem":2},{"text":"ሰበቢ ጩቡሳኒቲፍ እሳን ኬሳ ነምን ቶኮዩ","poem":1},{"text":"ሉቡ ኦፊሳ ህንኦልፈቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ ‘ሰበቢ ዼከምስኮ ወልዳ ሁንደረ ጅሩፍ","poem":1},{"text":"እሳን መለከተ አፉፈኒ","poem":2},{"text":"ዋን ሁንደ ቆጴፈተንዩ፣","poem":1},{"text":"ነምን ቶኮዩ ገረ አደ ወራና ህንዸቁ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አላን ጎራዴቱ ጅረ፤","poem":1},{"text":"ኬሳንሞ ዸእቻፊ ቤለቱ ጅረ፤","poem":2},{"text":"ወር ባድያ ጎራዴዻን ዱኡ፤","poem":1},{"text":"ወር መጋላ ኬሳሞ ቤላፊ ዸእቻን ዹሙ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"በቀቶትን ወር ምልቀን","poem":1},{"text":"ቱሉወንት በቀቱ።","poem":2},{"text":"ቶኮን ቶኮንሳኒ","poem":1},{"text":"አኩመ ጉጌወን ሱሉላ","poem":2},{"lineBreak":true},{"text":"ሰበቢ ጩቡሳኒቲፍ ንኣዱ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሀርክ ሁንድ ንናፈተ፤","poem":1},{"text":"ጅልብ ሁንድኑስ ብሻን ተአ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እሳን ወያ ገዳ ኡፈተኒ","poem":1},{"text":"ሶዳዻን ሀጉገሙ።","poem":2},{"text":"ፉልሳኒ ቃኒ ኡፈተ፤","poem":1},{"text":"መታንሳኒስ ንሃደመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“ ‘እሳን ሜቲሳኒ ዳንዲወንረት ገቱ፤","poem":1},{"text":"ወርቄንሳኒ አከ ዋን ጡራኣ ተአ።","poem":2},{"text":"ጉያ ዼከምሰ ዋቀዮት ሜቲፊ","poem":1},{"text":"ወርቄንሳኒ እሳን ኦልቹ ህንደንደኡ።","poem":2},{"text":"እሳን ኛተኒ ቤለ ህንበአን","poem":1},{"text":"ዮካን ገራሳኒ ህንጉተተን፤","poem":2},{"text":"ሜቲፊ ወርቄንሳኒ እሳን ጉፈቺሴ","poem":1},{"text":"ጩቡት እሳን ገልቼራቲ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እሳን ፋየ በሬዳሳኒቲን ኦፍ ቱለኒ","poem":1},{"text":"ዋቆተሳኒ ጅብሲሶፊ ፈኪወን ፋይዳ ህንቀብኔ ሰነ","poem":2},{"lineBreak":true},{"text":"ቶልቹፍ እት ፈየደመን።","poem":2},{"text":"ከናፉ አን ወንቶተ ከኔን","poem":1},{"text":"ገረ ዋን ጡራኣት እሳን ዱራ ነንጌደረ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አን ሀርከ ነሞተ ብየ ኦርማት ቦጁዻፍ፣","poem":1},{"text":"ሀሞተ ለፋትስ ሳምቻፍ ደበርሴ እሼ ነንኬነ፤","poem":2},{"lineBreak":true},{"text":"እሳንስ እሰ ንጡሬሱ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"አን ፉለኮ እሳንራ ነንዴብፈዸ፤","poem":1},{"text":"እሳንስ እዶኮ ጃለተማ ሰነ ንጡሬሱ፤","poem":2},{"lineBreak":true},{"text":"ሳምቶትንስ እት ሴነኒ ንጡሬሱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“ ‘ሰበቢ ብየቲን ዺገ ዸንገላሱዻን፣","poem":1},{"text":"መጋለቲንሞ ጎሊዻን ጉተምቴፍ","poem":2},{"lineBreak":true},{"text":"ፎንጫ ቆጴስ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"አን አከ እሳን መኔንሳኒ ዻለኒፍ","poem":1},{"text":"ወረ ሰቦተ ኬሳ አከ መሌ ሀሞ ተአን ነንፍደ፤","poem":2},{"text":"ኦፍ ቱሉማ ነሞተ ጀጀቦ ነንጨብሰ፤","poem":1},{"text":"መኔን ቁልቁሉማሳኒስ ነንጡሬሰ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዬሮ ራፈምን ዹፉት እሳን ነጋ በርባዱ፤","poem":1},{"text":"ገሩ ቶኮሌ ህንአርገተን።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"በዲን በዲረት፣","poem":1},{"text":"ኦዱንስ፣ ኦዱረት ንዹፈ።","poem":2},{"text":"እሳን ራጂራ ሙልአተ አርገቹ ንያሉ፤","poem":1},{"text":"ሴር ሉቦተ ብራ፣","poem":2},{"lineBreak":true},{"text":"ጎርስሞ ማንጉዶተ ብራ ንዸበመ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ሞቲን ንቦአ፤","poem":1},{"text":"እልም ሞቲ አብዲ ኩተተ፤","poem":2},{"lineBreak":true},{"text":"ሀርክ ኡመተ ብየቲ ንሆለተ።","poem":2},{"text":"አን አኩመ ሆጂሳኒት ገቲሳኒ ነንኬናፍ፤","poem":1},{"text":"አኩመ ሴረ ኦፊሳኒትስ ሙርቲ ነንኬናፍ።","poem":2},{"lineBreak":true},"“ ‘ኤርገሲስ እሳን አከ አን ዋቀዮ ተኤ ንቤኩ።’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/EZK/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/EZK/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/EZK/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}