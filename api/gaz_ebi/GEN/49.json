{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"GEN","translationId":"gaz_ebi","name":"ኡመመ","commonName":"ኡመመ","title":"ሴረ ኡመማ","order":1,"numberOfChapters":50,"sha256":"b5e507086d923a6a7029afb67d808080058954ab901ceff4afcca6a91df942e1","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/gaz_ebi/GEN/50.json","totalNumberOfVerses":1533},"chapter":{"number":49,"content":[{"type":"heading","content":["ያቆብ እልማንሳ ኤብሴ"]},{"type":"verse","number":1,"content":["ያቆብ እልማንሳ ኦፍት ዋሜ አከነ ጄዼ፦ “አከ አን ዋን በረ ዹማ ኬሰ እስንት ዹፉ እስንት ህሙፍ ሜ ወልት ቀበማ።"]},{"type":"verse","number":2,"content":[{"text":"“ያ እልማን ያቆብ ሜ ወልት ቀበማ ዸጌፈዻ፤","poem":1},{"text":"አባኬሰን እስራኤልን ዸጌፈዻ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“ያ ሩቤን፣ አት እልመኮ ሀንገፈ፤","poem":1},{"text":"ሁምነኮ፣ መለቶ ጀልቀባ ከን ጀብነኮቲት፤","poem":2},{"lineBreak":true},{"text":"አት ኡልፍናን ንጫልተ፤ ሁምናንሌ ንጫልተ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አት አከ ብሻኒ አሲፊ አች ራፈምተ፤ ኦል ኣንቱማስ ህንቀባቱ፤","poem":1},{"text":"አት ስሬ አባኬቲት ኦል ባቴ፣","poem":2},{"lineBreak":true},{"text":"አፈተኮት ኦል ባቴ ጡሬስቴርታቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ስምኦኒፊ ሌዊን ኦቦሎተ፤","poem":1},{"text":"ጎራዴንሳኒ ምአ ፍንጭላት።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሉቡንኮ መሪሳኒት ህንሴንን፤","poem":1},{"text":"ኡልፍንኮስ ያኢሳኒት ህንደበለምን፤","poem":2},{"text":"እሳን ዼከምሰሳኒቲን ነመ አጄሰኒሩቲ፤","poem":1},{"text":"ፌዺ ኦፊሳኒቲንስ ቆትዮ ናፈቺሰኒሩ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኣሪንሳኒ እን ሀማን፣","poem":1},{"text":"ዼከምስሳኒ እን ገረ ጀቤስ አባረማ ሃተኡ!","poem":2},{"text":"አን ያቆብ ኬሰ እሳን ነንብትኔሰ፤","poem":1},{"text":"እስራኤል ኬሰስ እሳን ነንፈጫሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ያ ይሁዳ ኦቦሎትንኬ ስ ሌልሱ፤","poem":1},{"text":"ሀርክኬ ሞርመ ዲነኬቲ ቀበ፤","poem":2},{"lineBreak":true},{"text":"እልማን አባኬቲ ሲፍ ሰገዱ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ያ ይሁዳ አት ሳፌለ ሌንጫት፤","poem":1},{"text":"ያ እልመኮ አት አደሞዻ ዴብተ።","poem":2},{"text":"እን አከ ሌንጫ፣ አከ ሌንጨ ዸላስ፣ ርጴ ጪሰ፤","poem":1},{"text":"ኤኙቱ እጀ ጀባቴ እሰ ካሰሬ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሀመ ቡልቻን ዹፉት","poem":1},{"text":"ቦኩን ሀርከ ይሁዳቲ፣","poem":2},{"text":"ኡሌን ቡልቺንሳ ሚለሳ ግዱዻ ህንዸበሙ፤","poem":1},{"text":"ሰቦትንስ እሳፍ ንአጀጀሙ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እን ሀሬሳ ሙከ ወይኒት፣","poem":1},{"text":"እልሞ ሀሬሳሞ ደሜ ፍለተማት ህዸተ፤","poem":2},{"text":"ወያሳ ዳዺ ወይኒቲን፣","poem":1},{"text":"ወንደቦሳሞ ዺገ ጉማ ወይኒቲን ሚጨተ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እጅሳ ዳዺ ወይኒረ ዲመተ፤","poem":1},{"text":"እልካንሳሞ ኣነንረ አዳተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ዜቡሎን ቀርቀረ ገላና ጅራተ፤","poem":1},{"text":"ቡፈተ ዶኒወኒስ ተአ፤","poem":2},{"lineBreak":true},{"text":"ዳንጋንሳስ ሀመ ሲዶናት በልአተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ይሳኮር ሀሬ ጀባ","poem":1},{"text":"ፌኢሰ ለመ ግዱ ጪሱዸ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እንስ ዬሮ አከ እዶን ቦቆናሳ ሀመም ጋሪ ተኤፊ","poem":1},{"text":"አከ ለፍትሳ ቶላ ተኤ አርጉት","poem":2},{"text":"በኣ ባቹፍ ገቲቲሳ ገድ ቀበተ፤","poem":1},{"text":"ሆጂ ሁምና ሆጄቹፍ ኦፍ ኬነ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“ዳን ጎሶተ እስራኤል ኬሳ አከ እሰ ቶኮት፣","poem":1},{"text":"ሰበሳቲፍ ሙርቲ ቀጄላ ንኬነ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዳን ቦፈ ቀርቀረ ከራት፤","poem":1},{"text":"አከ ቡቲ ዳንዲራ፣","poem":2},{"text":"ከን አከ ነምች ፈርደ ያበቱ ገረ ዱባት ኩፉፍ","poem":1},{"text":"ኮቴ ፈርዳ እዱ ንተአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“ያ ዋቀዮ፣ አን ፈይሱኬ ነንኤገዸ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“ጋድ ዌረርቶታን ንዸአመ፤","poem":1},{"text":"እን ገሩ ፋነ ቡኤ እሳን ዸአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ኣሼር ቡዴንሳ ፉርዳዸ፤","poem":1},{"text":"እን ሞቲዻፍ ኛተ ቶላ ንኬነ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“ንፍታሌም ቦሮፈ ሂከምቴዸ፤","poem":1},{"text":"ዱቢ ጋሪስ ንዱበተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“ዮሴፍ ሙከ ወይኒ እጀ ቀቤሰ፣","poem":1},{"text":"ሙከ ወይኒ እጀ ቀቤሰ ቡርቃ ብሻኒት ዽኦ ጅሩዸ፤","poem":2},{"lineBreak":true},{"text":"ደሜንሳ ደላረ ያአ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ወር እዳ ቀበተን ወራነ እሰት በነን፤","poem":1},{"text":"እሰት ፉታሰን፤ እሰ ጅበንስ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ገሩ እዳንሳ ጀባቴ ሀፌ፤","poem":1},{"text":"እሬን ሀርከሳ፣","poem":2},{"text":"ሀርከ ዋቀ ጀባ ያቆቢን ጀቤፈሜ።","poem":1},{"text":"አቺስ ትክሴ ሰናን፣ ከታ እስራኤሊን፣","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዋቀ አባኬቲ እሰ ስ ገርጋሩን፣","poem":1},{"text":"ዋቀ ዋን ሁንደ ደንደኡ እሰ","poem":2},{"text":"ኤበ ሰሚ ጉባቲን፣","poem":1},{"text":"ኤበ ገድ ፈጎ እሰ ጀላቲን፣","poem":2},{"lineBreak":true},{"text":"ኤበ ሀርማቲፊ ገደሜሳቲን ስኤብሱ ሰናንንኤብፈምተ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ኤብ አባኬቲ፣","poem":1},{"text":"ኤበ ቱሉወን ዱሪ፣","poem":2},{"lineBreak":true},{"text":"አርጁማ ጋረን ዱሪ ጫለ።","poem":2},{"text":"ኩን ሁንድ መታ ዮሴፊት፣","poem":1},{"text":"ጉቤ መታ እሰ ኦቦሎተሳ ኬሳሆገና ተኤት ሃቀበቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“ቤንያም ዬዪ ባይኤ ቤለኤዸ፤","poem":1},{"text":"ገነመ ዋን አደምሴ እት ገገቤ ኛተ፤","poem":2},{"lineBreak":true},{"text":"ገልገለሞ ቦጁ ህረ።”","poem":2}]},{"type":"verse","number":28,"content":["ወር ኩኔን ሁንድ ጎሶተ እስራኤል ኩዸ ለማን፤ ኩንስ ዋን አባንሳኒ ዬሮ ኤበ ቶኮ ቶኮ እሳኒፍ ተኡን እሳን ኤብሴት እሳንት ዱበቴዸ።"]},{"type":"heading","content":["ያቆብ ዱኡሳ"]},{"type":"verse","number":29,"content":["ኤርገሲስ ያቆብ አከነ ጄዼ እሳን አጀጄ፤ “አን ገረ ሰበኮቲት ወልት ቀበሙ ገኤረ፤ ሆልቀ ለፈ ቆቲሳ ኤፍሮን ነምቸ ጎሰ ሄት ሰናት አቦቲኮ ብረት ነ አዋላ።"]},{"type":"verse","number":30,"content":["ሆልቅ ኩንስ ሆልቀ ብየ ከነኣን ኬሰት መምሬ ብረት ለፈ ቆቲሳ መክፌላ ኬሰት አርገሙ ከን አብረሃም እዶ አዋላ ጎዸቹፍ ኤፍሮን ነምቸ ጎሰ ሄት ሰነራ ለፈ ቆቲሳ ወጅን ብተቴዸ።"]},{"type":"verse","number":31,"content":["አብረሃሚፊ ኒቲንሳ ሳራን አችት አዋለመን፤ ይስሃቂፊ ኒቲንሳ ርብቃን አችት አዋለመን፤ አንስ አቹመተን ልያ አዋሌ።"]},{"type":"verse","number":32,"content":["ለፍት ቆቲሳቲፊ ሆልቅ እሰ ኬሰ ጅሩ ሄቶተራ ብተመን።”"]},{"type":"verse","number":33,"content":["ያቆብ አኩመ እልማንሳ አጀጁ ራወቴን ሚለሳ ስሬረት ኦል ዴብፈቴ ሀፉረ ዹማ ባፈቴ፤ ገረ ሰበ እሳትስ ወልት ቀበሜ።"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}