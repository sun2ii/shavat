{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HAB","translationId":"gaz_ebi","name":"አንባቆም","commonName":"አንባቆም","title":"ራጂ አንባቆም","order":35,"numberOfChapters":3,"sha256":"e05480c41c36739cf6644b7f435b64ed60914c823ec5546a96e2ceb6b2d1cfb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gaz_ebi/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["ራጂ አንባቆም ራጅች አርጌ።"]},{"type":"line_break"},{"type":"heading","content":["ጉንጉሚ አንባቆም"]},{"type":"verse","number":2,"content":[{"text":"ያ ዋቀዮ፣ አን ሀመ ዮሚትን ገርጋርሳፍስት እየዸ?","poem":1},{"text":"አት ገሩ ነ ህንዸጌፈቱ፤","poem":2},{"text":"ዮካን አን ሀመ ዮሚት፣ “ጎሊ!”","poem":1},{"text":"ጄዼ ስት ቦኤ አት ገሩ ነ ህንኦልችቱ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አት ማሊፍ አከ አን ሙርቲ ደቤ አርጉ ነ ጎተ?","poem":1},{"text":"አት ማሊፍ በሌሳ ነማ ኦብስተ?","poem":2},{"text":"በዲስኒፊ ጎሊን ፉለኮ ዱረ ጅሩ፤","poem":1},{"text":"ሎሊፊ ወልዸቢንስ ባይአቴረ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ከናፉ ሴር ላምሸኤረ፤","poem":1},{"text":"ሙርቲን ቀጄላን ደብሰሜረ።","poem":2},{"text":"አከ ሙርቲን ቀጄላን ጀልእፈሙፍ፤","poem":1},{"text":"ነሞትን ሀሞን ቀጄሎተ መርሱ።","poem":2}]},{"type":"heading","content":["ዴቢ ዋቀዮ"]},{"type":"verse","number":5,"content":[{"text":"“ሰቦተ ሁበዻ እላላ፤","poem":1},{"text":"አከ መሌስ ድንቅሲፈዻ።","poem":2},{"text":"አን በረኬሰን ኬሰ","poem":1},{"text":"ዋን እስን ዮ እስንት ህመሜሌ","poem":2},{"lineBreak":true},{"text":"ህንአመኔ ቶኮ ነንሆጄዸ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አን ወረ ባብሎን፣","poem":1},{"text":"ኡመተ ገረ ጀቤሳፊ አሪፈታ፣","poem":2},{"text":"ከን እዶ ጅሬኘሳ ህንተእን ቀበቹፍ","poem":1},{"text":"ጉቱማ ለፋ ኬሰ ያኡ ሰነ ነንካሰ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እሳን ሰበ ሶዳተሙፊ ናስሱዸ፤","poem":1},{"text":"እሳን ኦፊሳኒቲፉ ሴረ፤","poem":2},{"lineBreak":true},{"text":"ኡልፍነሳኒስ ንጉድፈቱ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ፈርዴንሳኒ ቄረንሰ ጫላ ሰፍሱ፤","poem":1},{"text":"ዬዪ ገልገላ ጫላ ሶዳችሱ።","poem":2},{"text":"ነሞትንሳኒ ከኔን ፈርደ ያበተንአሪቲዻን ጉሉፉ፤","poem":1},{"text":"አቦቲን ፈርደሳኒስ ፈጎዻ ዹፉ።","poem":2},{"text":"እሳን አኩመ ርሳ ዋ ኛቹፍ አሪፈቱ በርሱ፤","poem":1}]},{"type":"verse","number":9,"content":[{"text":"እሳን ሁንድኑ ጄቁምሳፍ ዹፉ።","poem":2},{"text":"ቱትንሳኒ አኩመ ቡቤ ገሞጂ ገረ ፉለ ዱራት ቀጄለ፤","poem":1},{"text":"ነሞተ ህዸመንስ አኩመ ጭረቻ ወልት ቀበ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እሳን ሞቶተ ቱፈተኒ","poem":1},{"text":"ቡልችቶተት ቆሱ።","poem":2},{"text":"ደአትኖ ሁንደት ንኮልፉ፤","poem":1},{"text":"ብዮስ ቱለኒ እሰ ቀበቱ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኤርገሲ ነሞትን የከ ሆጄተን ከኔን ሁምነሳኒዋቀሳኒ ጎዸተን፣","poem":1},{"text":"አከ ቡቤ ለፈ ሀጣአኒ ከራሳኒ እት ፉፉ።”","poem":2}]},{"type":"heading","content":["ጉንጉሚ አንባቆም እሰ ለመፋ"]},{"type":"verse","number":12,"content":[{"text":"ያ ዋቀዮ፣ አት በረ በራ ጀልቀብዴ ጅርተ ምቲ?","poem":1},{"text":"ያ ዋቀኮ፣ ያ ቁልቁልቸኮ፣ አት ጎንኩማ ህንዱቱ።","poem":2},{"text":"ያ ዋቀዮ፣ አት አከ እሳን ሙርቲ ኬነኒፍእሳን ሙዴርተ፤","poem":1},{"text":"ያ ከታኮ፣ አት አከ እሳን ነመ አደበኒፍ እሳን ረመዴርተ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እጅኬ አከ ዋን ሀማ ህንእላሌፍ አከ መሌ ቁልቁሉዸ፤","poem":1},{"text":"አት ደበ አርግቴ ኦብሳን ዺሱ ህንደንዴሱ።","poem":2},{"text":"ዮስ አት ማሊፍ ኦብሳን ነሞተ ሀሞ እላልተ?","poem":1},{"text":"አት ማሊፍ ዬሮ ነሞትን ሀሞን","poem":2},{"lineBreak":true},{"text":"ወረ እሳን ጫላ ቀጄሎ ተአን ልቅምሰንት ጨልእስታ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አት ነሞተ አከ ቁርጡሚ ገላነ ኬሳ፣","poem":1},{"text":"አከ ኡመመወን ገላና ከኔን ቡልቻህንቀብኔ ጎቴርተ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዲን ሆኮዻን እሳን ሁንደ ኦል ባሰ፤","poem":1},{"text":"ክዮሳቲንስ እሳን ሀርክሰ፤","poem":2},{"text":"ክዮሳ ኬሰት ወልት እሳን ቀበተ፤","poem":1},{"text":"ከናፉ እን ንገመደ፤ ንእልልቸስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እን ሰበቢ ክዮሳቲን በሸነኔ","poem":1},{"text":"ኛተሳ ፍለተማት ገመዱፍ","poem":2},{"text":"ክዮሳቲፍ ኣርሳ ዽኤሰ፤","poem":1},{"text":"ክዮሳቲፍሌ እጣነ ኣርሰ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እን ክዮሳ ኬሳ ገረገልቹዻን፣","poem":1},{"text":"ገረ ላፍነ መሌ እቱመ ፉፌ ሰቦተ በሌሱ ቀባ?","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/HAB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/HAB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/NAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}