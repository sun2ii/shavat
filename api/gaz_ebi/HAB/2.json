{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HAB","translationId":"gaz_ebi","name":"አንባቆም","commonName":"አንባቆም","title":"ራጂ አንባቆም","order":35,"numberOfChapters":3,"sha256":"e05480c41c36739cf6644b7f435b64ed60914c823ec5546a96e2ceb6b2d1cfb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gaz_ebi/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"አን እዶኮ ዻበዼ","poem":1},{"text":"ደላ ኤጉምሳረ ነንቱረ፤","poem":2},{"text":"ሜ ዋን እን ናን ጄዹ አርጉፍ","poem":1},{"text":"ዴቢ አን ጉንጉሚ ከናፍ ኬኑ መሉ ቤኩፍ ነንእላለ።","poem":2}]},{"type":"heading","content":["ዴቢ ዋቀዮ"]},{"type":"verse","number":2,"content":["ኤርገሲ ዋቀዮ አከነ ጄዼ ዴቢ ኬኔ፦",{"text":"“አከ ነምን ዱብሱ ቶኮ ቀበቴ ፊጉፍ፣","poem":1},{"text":"ሙልአተ ሰነ እፈ ጎዺ","poem":2},{"lineBreak":true},{"text":"ገበቴረት በሬስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሙልአትን ኩን ዬሮ ሙርታኤ ቶኮ ኤገታቲ፤","poem":1},{"text":"እን ዋኤ ዹመሳ ዱበተ መሌ ህንሶቡ።","poem":2},{"text":"ዮ ቱሬስ እሰ ኤግ፤","poem":1},{"text":"እን ዹጉማን ንዹፈ፤ ህንቱሩስ።","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“ኩኖ እን ኦፍ ቦኮክሴረ፤","poem":1},{"text":"ሀዊንሳስ ስሪ ምት፤","poem":2},{"lineBreak":true},{"text":"ነምን ቀጄላን ገሩ አመንቲሳቲን ጅራተ፤","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዹጉማን እን ዳዺ ወይኒቲን ንጎዎምፈመ፤","poem":1},{"text":"ኦፍ ቱለ፤ ቦቆናስ ህንቀቡ።","poem":2},{"text":"እን አኩመ ሲኦል ሰሰተ፤","poem":1},{"text":"አከ ዱኣስ ከን ህንቁፍኔዸ።","poem":2},{"text":"እን ሰቦተ ሁንደ ወልት ቀበተ፤","poem":1},{"text":"ኡመተ ሁንደስ ቦጅኤ ፉዸተ።","poem":2}]},{"type":"verse","number":6,"content":["“እሳን ሁንድ እሰ ቱፈተኒ እት ኮልፋ፣",{"text":"“ ‘ነመ ምአ ሀተሜ ቱለቴ","poem":1},{"text":"ሳምቻን ኦፍ ሶሮምሱፍ ወዮ!","poem":2},{"lineBreak":true},{"text":"ወን ኩን ሀመ ዮሚት እት ፉፈ’ጄዸኒ እት ህንቆሰኒ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ወር ልቂ ስራ ቀበን አኩመ ተሳ ስት ህንከአኒ?","poem":1},{"text":"እሳን ከአኒ ስ ህንሆለቺሰኒ?","poem":2},{"lineBreak":true},{"text":"ኤርገሲ አት ሀርከሳኒ ጀለ ገልተ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሰበቢ አት ሰበ ሄዱ ሳምቴፍ","poem":1},{"text":"ነሞትን ሀፈን ስ ሳሙ።","poem":2},{"text":"አት ዺገ ነማ ዸንገላፍቴርታቲ፤","poem":1},{"text":"አት ብዮተ፣ መጋላወኒፊነሞተ እሳን ኬሰ ጅራተን ሁንደ በሌስቴርተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ነመ ቡኣ ህንመሌን መነ እጃረቱ","poem":1},{"text":"ከን በዲሰ ጀላ በኡፍ ጄዼ","poem":2},{"lineBreak":true},{"text":"ለፈ ኦል ከኣረት እዶ ጅሬኛ ቶልፈቱፍ ወዮ!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አት ሉቡ ነመ ባይኤ ገላፈቹዻፍ፣","poem":1},{"text":"ዋን ነመ ቃኔሱ መነኬት መለቴሉቡኬት በዲሰ ፍዴ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዸጋወን ኬኘን ኬሳ እዩ፤","poem":1},{"text":"ዴምዴሞን ሙካስ ጀላ ቀበ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ነመ ዺገ ዸንገላሱዻን መጋላ እጃሩፍ፣","poem":1},{"text":"ከን የካን መጋላ ሁንዴሱፍ ወዮ!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አከ ደዸቢን ነማ አኩመ ቆራን እብዳ ተኤ፣","poem":1},{"text":"አከ ሰቦትንስ አከሱማን ኦፍ ደዸብሲሰን","poem":2},{"lineBreak":true},{"text":"ዋቀዮ ዋን ሁንደ ደንደኡ ሙርቴሴረ ምቲ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አኩመ ብሻን ገላነ ጉቱ ሰነ","poem":1},{"text":"ለፍት ኡልፍነ ዋቀዮ ቤኩቲን ጉተምቲቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“ነመ ቁላ ዸግነ ኦላሳ እላሉፍ ጄዼ","poem":1},{"text":"ሀመ እን መቻኡት","poem":2},{"lineBreak":true},{"text":"ቀልቀሎ ኬሳ ዳዺ ወይኒ እሳፍ ቡሱፍ ወዮ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አት ቆደ ኡልፍና ቃኒዻን ጉተምተ።","poem":1},{"text":"አመ ደበሬን ከንኬት! አከ ቁላንኬ ሙልአቱፍ ዹግ።","poem":2},{"text":"ጦፎን ምርገ ዋቀዮ ስት ገረገለ፤","poem":1},{"text":"ሰልጵንስ ኡልፍነኬ ሀጉገ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ፍንጭል አት ልባኖንት ሆጄቴ ስልቅምሰ፤","poem":1},{"text":"ሆሪ ፍጡንኬ ስ ርፈቺሰ።","poem":2},{"text":"አት ዺገ ነማ ዸንገላፍቴርታቲ፤","poem":1},{"text":"አት ብዮተ፣ መጋላወኒፊ ነሞተ እሳን ኬሰ ጅራተንሁንደ በሌስቴርተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“ዋቅን ቶልፈማን ኦጌሰ ሀርካቲን ሶፈሙ","poem":1},{"text":"ዮካን ፈኪን ሶበ በርሲሱ ፋይዳ ማሊ ቀበ?","poem":2},{"text":"ነምን እሰ ቶልቹ ቶኮ ሆጂዹመ ሀርከሳ አመነታቲ፤","poem":1},{"text":"እን ዋቆተ ቶልፈሞ ዱበቹ ህንደንዴኜ ቶልቸ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ነመ ሙካን፣ ‘ደመቅ!’","poem":1},{"text":"ዮካን ዸጋ ሉቡ ህንቀብኔን፣ ‘ከእ!’ ጄዹፍ ወዮ።","poem":2},{"text":"እን በርሲሱ ንደንደኣ?","poem":1},{"text":"ኩኖ እን ወርቄፊ ሜቲ ድበሜረ፤","poem":2},{"lineBreak":true},{"text":"ሀፉር ቶኮዩ እሰ ኬሰ ህንጅሩ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ዋቀዮ ገሩ መነ ቁልቁሉማሳቁልቁሉ ሰነ ኬሰ ጅረ፤","poem":1},{"text":"ለፍት ሁንድ ፉለሳ ዱረት ሃጨልእስቱ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/HAB/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/HAB/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/HAB/1.json","previousChapterAudioLinks":{},"numberOfVerses":20}