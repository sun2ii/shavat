{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HAB","translationId":"gaz_ebi","name":"አንባቆም","commonName":"አንባቆም","title":"ራጂ አንባቆም","order":35,"numberOfChapters":3,"sha256":"e05480c41c36739cf6644b7f435b64ed60914c823ec5546a96e2ceb6b2d1cfb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gaz_ebi/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["ከዸትና አንባቆም"]},{"type":"verse","number":1,"content":[{"text":"ከዸትና አንባቆም ራጅቻ ሽግዮኖቲዻን።","descriptive":true},{"noteId":0}]},{"type":"verse","number":2,"content":[{"text":"ያ ዋቀዮ፣ አን ኦዱኬ ዸገኤረ፤","poem":1},{"text":"ያ ዋቀዮ፣ አን ጎቸወንኬ ነንሶዳዸ።","poem":2},{"text":"በረኬኘ ኬሰ እሳን ሃሮምስ፤","poem":1},{"text":"ጀበነኬኘ ኬሰ እሳን ቤከምሲስ፤","poem":2},{"lineBreak":true},{"text":"ዬሮ ዼከምቱት አራረ ያደዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ዋቅን ቴማንራ፣","poem":1},{"text":"እን ቁልቁልች ቱሉ ጳራኒቲ ዹፌ።","poem":2},{"text":"ኡልፍንሳ ሰሚወን ሀጉጌ፤","poem":1},{"text":"ገለንሳስ ለፈ ጉቴ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሚዸግንሳ አኩመ በኢሰ አዱት፤","poem":1},{"text":"ጋንፈወን ለመ ሀርከሳቲ በኡ፤","poem":2},{"lineBreak":true},{"text":"ሁምንሳስ አች ዾከቴረ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ፉለሳ ዱረ ዸእቸቱ ዴሜ፤","poem":1},{"text":"ጎልፋንስ እሰ ዱካ ቡኤ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እን ዻበቴ ለፈ ራሴ፤","poem":1},{"text":"እላሌ አከ ሰቦትን ሆለተን ጎዼ።","poem":2},{"text":"ቱሉወን ዱሪ ንቡርኩታአን፤","poem":1},{"text":"ጋረን በረ ሄዱ ጅራተንስ ንዲገመን።","poem":2},{"lineBreak":true},{"text":"ከራንሳ ከን በረ በራት።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አን ኡቱ ዱንካኖትን እቶጵያ ዽጰተኑ ነንአርጌ፤","poem":1},{"text":"ጎልጋወን ምድያኒስ ንሆለቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ያ ዋቀዮ፣ አት ለጌንት ኣርቴ ቱርቴ?","poem":1},{"text":"ቡርቃወንትስ ዼከምቴ?","poem":2},{"text":"አት ዬሮ ፈርዴንኬቲን ጉሉፍቴት፣","poem":1},{"text":"ዬሮ ጋሪወን ሞአትናኬ ያበቴት","poem":2},{"lineBreak":true},{"text":"ገላነት ዼከምቴ ቱርቴ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አት እዳኬ ሉቅፈቴ","poem":1},{"text":"ጥየ እት ዻበቴ።","poem":2},{"text":"ለፈስ ለጌኒን ገርገር በቀቅስቴ፤","poem":1}]},{"type":"verse","number":10,"content":[{"text":"ቱሉወን ስ አርገኒ ሆለተን።","poem":2},{"text":"ዸኣወን ብሻኒ አቺን ደርበን፤","poem":1},{"text":"ቱጁብን ንሁርሴ፤","poem":2},{"lineBreak":true},{"text":"ደምበሊሳስ ኦል ካሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ሰበቢ ጥየኬ ጨለቅሳ ፊጉ ሰናቲፊ","poem":1},{"text":"ሰበቢ እፈ ኤቦኬቲ ሰናቲፍ አዱፊ","poem":2},{"lineBreak":true},{"text":"ጅእ ሰሚ ኬሰ ዻበተኒ ሀፈን።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አት ዼከምሳን ለፈረ መርማርቴ፤","poem":1},{"text":"ኣሪዻንስ ሰቦተ ለፈት ዽዺቴ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አት ሰበኬ ፉሩፍ፣","poem":1},{"text":"ድበማኬ ኦልቹፍ ዹፍቴ።","poem":2},{"text":"ሆገና ብየ ሀሞታ ንዳክቴ፤","poem":1},{"text":"መታዻ ሀመ ሚላት ቁላ እሰ ሀምብፍቴ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዬሮ ሎልቶትንሳ ኑ ብትኔሱፍ ከአኒ፣","poem":1},{"text":"አኩመ ዋን ረከቶተ ዾከተኒ ጅረን","poem":2},{"text":"ፍጡ ገአኒት ገመደንት፣","poem":1},{"text":"አት ኤቦ ኦፊሳቲን መታሳ ወራንቴ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አት ፈርዴንኬቲን ብሻኖተ ጉርጉዳ","poem":1},{"text":"ሆመቼሳ ገላነረ ዴምቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"አን ዸገኤን ገራንኮ ራፈሜ፤","poem":1},{"text":"ህዺንኮ ሰገሌ ሰናን ሆለቴ፤","poem":2},{"text":"ቶርቶር ለፌኮ ሴኔ፤","poem":1},{"text":"ሚልኮስ ንሆለቴ።","poem":2},{"text":"ተኡስ አን ሀመ ጉያን በዲሳ","poem":1},{"text":"ሰቦተ ኑ ዌረረንት ዹፉት ኦብሳን ነንኤገዸ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዮ ሙክን ሀርቡ ደራሩ ባቴ","poem":1},{"text":"እጅ ወይኒ ሙከ ወይኒረ ጅራቹ ባቴዩ፣","poem":2},{"text":"ዮ ሙክን ኤጄርሳ እጀ ነቀቹ ድዴ","poem":1},{"text":"ለፍት ቆቲሳ ምዻን ዾወቴዩ፣","poem":2},{"text":"ዮ ሆሎትን ጎለ ኬሳ፣","poem":1},{"text":"ሎንስ ደላ ኬሳ ዸበመንዩ፣","poem":2}]},{"type":"verse","number":18,"content":[{"text":"አን ገሩ ዋቀዮት ነንገመደ፤","poem":1},{"text":"ዋቀ እሰ ነ ፈይሱት ነንገመደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ዋቀዮ ጎፍታን ጀብነኮት፤","poem":1},{"text":"እን ሚለኮ አከ ሚለ ቦሮፋ ጎዸ፤","poem":2},{"lineBreak":true},{"text":"ለፈ ኦል ከኣረስ ነ ዴምስሰ።","poem":2},{"text":"ዱረ ቡኣ ፋርፈናቲፍ። ሜሻኮ ከን ርቡቲን ከን ፋርፈተሜ።","descriptive":true}]}],"footnotes":[{"noteId":0,"caller":"+","text":"ሽግዮቲን ጎሰ ሙዚቃት።","reference":{"chapter":3,"verse":1}}]},"thisChapterLink":"/api/gaz_ebi/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}