{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HEB","translationId":"gaz_ebi","name":"እብሮተ","commonName":"እብሮተ","title":"እብሮተ","order":58,"numberOfChapters":13,"sha256":"eb7743fd7df6c2ec6232c70fa63a3dc7014d06b39e20d4eb71d09ba816ec71c0","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/gaz_ebi/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":3,"content":[{"type":"heading","content":["ዬሱስ ሙሴ ጫለ"]},{"type":"verse","number":1,"content":["ከናፉ ያ ኦቦሎተ ቁልቁሎተ፣ ወረ ዋምቸ ሰሚ ኬሰት ህርማተን፣ ዬሱስ ኤርገማፊ ሉበ ኦል ኣና አመንቲኬኛ ሰነ እላላ።"]},{"type":"verse","number":2,"content":["አኩመ ሙሴን መነ ዋቃ ሁንደ ኬሰት አመነማ ቱሬ ሰነ እንስ እሰ እሰ ሙዴፍ አመነማ ቱሬ።"]},{"type":"verse","number":3,"content":["አኩመ ነምን መነ እጃሩ ቶኮ መነ ሰነ ጫላ ከበጀ ጉዳ ቀቡ፣ እንስ ሙሴ ጫላ ከበጀ ጉዳ ቀበ።"]},{"type":"verse","number":4,"content":["ቶኮን ቶኮን መና ነማን እጃረማቲ፤ ከን ዋን ሁንደ እጃሬ ገሩ ዋቀ።"]},{"type":"verse","number":5,"content":["ሙሴን ዋን ፉልዱረት ዱበተሙፍ ጅሩ ዹጋ በኡፍ አከ ተጃጅላ ቶኮት መነ ዋቃ ሁንደ ኬሰት አመነማ ቱሬ።",{"noteId":11}]},{"type":"verse","number":6,"content":["ክርስቶስ ገሩ አከ እልማት መነ ዋቃረት አመነማዸ። ኑስ ዮ እጀ ጀብነኬኛፊ አብዲ እቲን ቦኑ ሰነ ጀቤስኔ ቀበትኔ፣ ኑ መነሳት።"]},{"type":"heading","content":["አኬከቺሰ አመንቲ ዸቡረት ኬነሜ"]},{"type":"verse","number":7,"content":["ከናፉ አኩመ ሀፉር ቁልቁሉን ጄዹ፦",{"text":"“እስን ዮ ሀርአ ሰገሌሳ ዸጌሰን፣","poem":1}]},{"type":"verse","number":8,"content":[{"text":"አከ ዬሮ ቆሩምሳ ገሞጂ ኬሰት","poem":2},{"text":"ፍንጭሉን ጎተን ሰነ፣","poem":1},{"text":"መታ ህንጀባትና፤","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አቦቲንኬሰን አችት ነ ቆረኒ ነ እላለን፤","poem":1},{"text":"ወጋ አፉርተመስ ዋን አን ሆጄዼ አርገን።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ከናፉ አን ዸሎተ ሰነት ኣሬ፣","poem":1},{"text":"‘ዬሮ ሁንደ ቀልቢሳኒቲን ዶጎጎሩ፤","poem":2},{"lineBreak":true},{"text":"እሳን ከራኮ ህንቤክኔ’ ጄዼ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ከናፉ አን ዼከምሰኮቲን፣","poem":1},{"text":"‘እሳን ቦቆናኮት ህንገለን’ ጄዼ ከከዼ።”","poem":2},{"noteId":12}]},{"type":"verse","number":12,"content":["ያ ኦቦሎተ፣ አከ እስን ኬሳ ነምን ቶኮዩ ገራ ሀማፊ ህንአመኔ ከን ዋቀ ጅራታራ ነመ ፈጌሱ ህንቀባትኔፍ ኦፍ ኤገዻ።"]},{"type":"verse","number":13,"content":["ገሩ እስን ኬሳ አከ ነምን ቶኮዩ ጎዎምሳ ጩቡቲን መተ ጀቤሰ ህንታኔፍ ኡቱ “ሀርአ” ጄዸማ ጅሩ ጉዩመ ጉያን ወል ጀጀቤሳ።"]},{"type":"verse","number":14,"content":["ኑስ ዮ አመንቲኬኘ እሰ ጀልቀባ ሰነ ሀመ ዹማት ጀቤስኔ ቀበትኔ ክርስቶስ ወጅን ህርማቶተ ንታናቲ።"]},{"type":"verse","number":15,"content":["ኩንስ አኩመ፣",{"text":"“እስን ዮ ሀርአ ሰገሌሳ ዸጌሰን፣","poem":1},{"text":"አከ ዬሮ ፍንጭላ ሰነ፣","poem":2},{"lineBreak":true},{"text":"መታ ህንጀባትና”","poem":2},{"noteId":13},"ጄዸሜ በሬፈሜዸ።"]},{"type":"verse","number":16,"content":["ወር ዸገአኒ ፍንጭለን ሱን ኤኙ? ወረ ሙሴን ቀጄልቼ ግብጢ ባሴ ሰነ ሁንደ ምቲ?"]},{"type":"verse","number":17,"content":["ዋቅን ወጋ አፉርተመ ኤኙ ፋት ኣሬ? ወሩመ ጩቡ ሆጄተኒ ሬፍሳኒ ገሞጂ ኬሰት ኩኩፌ ሰነት ምቲ?"]},{"type":"verse","number":18,"content":["ዮ ወሩመ አጀጀሙ ድደን ሰነ ተኤ መሌ ዋቅን አከ እሳን ጎንኩማ ቦቆናሳት ህንገሌፍ ኤኙ ፋት ከከቴሬ?"]},{"type":"verse","number":19,"content":["ከናፉ አከ እሳን ሰበቢ አመንቲ ዸቢሰሳኒቲፍ ቦቆና ሰነት ገሉ ህንደንደእን አርግነ።"]}],"footnotes":[{"noteId":11,"caller":"+","text":"ለኮ 12፥7","reference":{"chapter":3,"verse":5}},{"noteId":12,"caller":"+","text":"ፋር 95፥7‑11","reference":{"chapter":3,"verse":11}},{"noteId":13,"caller":"+","text":"ፋር 95፥7፣8","reference":{"chapter":3,"verse":15}}]},"thisChapterLink":"/api/gaz_ebi/HEB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/HEB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/HEB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}