{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HEB","translationId":"gaz_ebi","name":"እብሮተ","commonName":"እብሮተ","title":"እብሮተ","order":58,"numberOfChapters":13,"sha256":"eb7743fd7df6c2ec6232c70fa63a3dc7014d06b39e20d4eb71d09ba816ec71c0","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/gaz_ebi/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":["ቶኮን ቶኮን ሉበ ኦል ኣና ነሞተ ግዱዻ ፍለተሜ ዋን ዋቀ እላለቱረት ነሞተ እዶ ቡኤ ሰበቢ ጩቡቲፍ ኬናፊ ኣርሳ ዽኤሱፍ ሙደመ።"]},{"type":"verse","number":2,"content":["እን መታንሳዩ ዋን ደዸቢ ኬሰ ጅሩፍ ወላልቶታፊ ወረ ከራራ ጀለተኒፍ ገራ ላፉ ንደንደአ።"]},{"type":"verse","number":3,"content":["ሰበቢ ከናፍ እን ጩቡ ኦፊሳቲፍ፣ አከሱመስ ጩቡ ነሞታቲፍ ኣርሳ ዽኤሱ ቀበ።"]},{"type":"verse","number":4,"content":["ነመ አኩመ ኣሮንት ዋቃን ዋመሜ መሌ፣ ነምን ከምዩ ኡልፍነ ከነ ኦፊሳቲፍ ህንፉዸቱ።"]},{"type":"verse","number":5,"content":["ክርስቶስስ አከሱመ ሉበ ኦል ኣና ተኡፍ ኦፍ ህንኡልፌስኔ። ዋቅን ገሩ፣",{"text":"“አት እልመኮት፤","poem":1},{"text":"አን ሀርአ ስ ዸልቼረ”","poem":2},{"noteId":19},"ጄዼን።"]},{"type":"verse","number":6,"content":["እዶ ብራትስ፣",{"text":"“አኩመ ስርነ መልከሴዴቅት፣","poem":1},{"text":"አት ሉበ በረ በራት”","poem":2},{"noteId":20},"ጄዸ።"]},{"type":"verse","number":7,"content":["ዬሱስ ዬሮ ለፈረ ጅራቻ ቱሬት እየ ጉዳፊ እምማኒን እሰ ዱአ እሰ ኦልቹ ደንደኡ ሰነት ከዸትናፊ ዋመተ ዽኤፈቴ፤ ሰበቢ እን ሶዳ ዋቃ ቀቡፍስ ከዸትናንሳ ንዸገአሜፍ።"]},{"type":"verse","number":8,"content":["እን እልመ ተኡዩ ዽጵነሳ ሰነራ አጀጀሙ በረቴ፤"]},{"type":"verse","number":9,"content":["ኤርገ ከን ሙዳ ህንቀብኔ ታስፈሜሞ ወረ እሳፍ አጀጀመን ሁንዳፍ ቡርቃ ፈይነ በረ በራ ተኤ።"]},{"type":"verse","number":10,"content":["አከ ስርነ መልከሴዴቅትስ ሉበ ኦል ኣና ጄዸሜ ዋቃን ዋመሜ።"]},{"type":"heading","content":["አኬከቺሰ"]},{"type":"verse","number":11,"content":["ኑ ዋኤሳ ዋን ጄኑ ባይኤ ቀብነ፤ እስን ገሩ ዋን ሁበቹት ደዸቦ ታተኒፍ እስኒ እብሱን ረክሳዸ።"]},{"type":"verse","number":12,"content":["እስን ዬሮ ከነት በርሲስቶተ ተኡ ቀብዱ ቱሬ፤ እስንሞ ነመ ዋኤ ዹጋ ዱቢ ዋቃ ከን ጀልቀባ እረ ዴብኤ እስን በርሲሱቱ እስን በርባችሰ። ኛተ ጀባታስ ኡቱ ህንተእን ኣነን እስን በርባችሰ።"]},{"type":"verse","number":13,"content":["ነምን ኣነኒን ጅራቱ ከምዩ ዋን አመሌ ዳእመ ተኤፍ ዱቢ ቀጄሉማ ህንቤኩ።"]},{"type":"verse","number":14,"content":["ኛትን ጀባታን ገሩ ነሞተ ብልቻቶ ከኔን ዋን ጋሪፊ ዋን ሀማ ገርገር ባሰኒ ቤኩፍ ኦፍ ሌንጅሰኒፍ ተአ።"]}],"footnotes":[{"noteId":19,"caller":"+","text":"ፋር 2፥7","reference":{"chapter":5,"verse":5}},{"noteId":20,"caller":"+","text":"ፋር 110፥4","reference":{"chapter":5,"verse":6}}]},"thisChapterLink":"/api/gaz_ebi/HEB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/HEB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/HEB/4.json","previousChapterAudioLinks":{},"numberOfVerses":14}