{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HEB","translationId":"gaz_ebi","name":"እብሮተ","commonName":"እብሮተ","title":"እብሮተ","order":58,"numberOfChapters":13,"sha256":"eb7743fd7df6c2ec6232c70fa63a3dc7014d06b39e20d4eb71d09ba816ec71c0","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/gaz_ebi/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":8,"content":[{"type":"heading","content":["ሉበ ኦል ኣና ከኩ ሃራ"]},{"type":"verse","number":1,"content":["ዋን ኑ ዱበትኑ ኬሳ እጆን ከነ፦ ኑ ሉበ ኦል ኣና ሰሚረ ከራ ምርገ ቴሶ ሱራ ሰናቲን ታኤ አከሲ ቀብነ።"]},{"type":"verse","number":2,"content":["እንስ እዶ ቁልቁሉማፊ ዱንካነ እሰ ዹጋ ከን ኡቱ ነማን ህንተእን ጎፍታዻን ዻበሜ ኬሰ ተጃጅለ።"]},{"type":"verse","number":3,"content":["ሉብን ኦል ኣናን ከምዩ ኬናፊ ኣርሳ ዽኤሱፍ ሙደመ፤ ከናፉ ሉብን ኩን ዋን ዽኤሱ ቶኮ ቀባቹ ቀበ።"]},{"type":"verse","number":4,"content":["ዋን ሉቦትን አከ ሴራት ኬና ዽኤሰን ዱራኑ ጅረኒፍ፣ እን ኡቱ ለፈረ ጅራቴ ስላ ሉበ ህንተኡ ቱሬ።"]},{"type":"verse","number":5,"content":["እሳንስ እዶ ቁልቁሉማ ከን ፈኬኛፊ ጋድዱ ወንቶተ ሰሚ ተጃጅሉ። ዋቅንስ ዮሙ ሙሴን ዱንካነ ቁልቁሉ ዻቡፍ ከኤት፣ “ዋን ሁንደ አኩመ ፈኬኘ ቱሉረት ስት አርግሲፈሜ ሰናት ሆጄቹኬ ምርከኔፈዹ!”",{"noteId":24},"ጄዼ እሰ አኬከቺሱንሳ ከኑማፍ።"]},{"type":"verse","number":6,"content":["ገሩ አኩመ ከኩን እን ዬሱስ ግዱ ገሌሰ ተኤፍ ሱን ከኩ ሞፋ አከ መሌ ጫሉ ሰነ ተጃጅል እን ፉዸቴስ ተጃጅለሳኒረ ጉዳዸ፤ ከኩን ሃራን ዋዳ ጫሉረት ሁንዴፈሜቲ።"]},{"type":"verse","number":7,"content":["ኡቱ ከኩን ጀልቀባ ሱን ሙዳ ቀባቹ ባቴ ስላ ከኩን ለመፋን ህንበርባችሱ ቱሬ።"]},{"type":"verse","number":8,"content":["ዋቅን ገሩ ሰበ ሰነረት በሌሳ አርጌ አከነ ጄዸ፤",{"text":"“ዬሮን አን እት","poem":1},{"text":"መነ እስራኤል ወጅን፣","poem":2},{"text":"መነ ይሁዳ ወጅንስ፣","poem":1},{"text":"ከኩ ሃራ ገሉ ንዹፈ ጄዸ ጎፍታን።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ከኩን ኩንስ ከኩ አን፣","poem":1},{"text":"ዬሮ ብየ ግብጢቲ እሳን ባሱፍ ጄዼ","poem":2},{"text":"ሀርከሳኒ ቀቤ ሰነ","poem":1},{"text":"አቦቲሳኒ ወጅን ገሌ ሰናን ቶኮ ምት፤","poem":2},{"text":"እሳን ከኩኮት ጀባተኒ ዋን ህንዻበትኒፍ፣","poem":1},{"text":"አን እሳንራ ገረገሌረ፣","poem":2},{"lineBreak":true},{"text":"ጄዸ ጎፍታን።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ከኩን አን ዬሮ ሰነ ቦዴ","poem":1},{"text":"መነ እስራኤል ወጅን ገሉ ከናዸ፣ ጄዸ ጎፍታን።","poem":2},{"text":"አን ሴረኮ ቀልቢሳኒ ኬሰ ነንካአ፤","poem":1},{"text":"ገራሳኒ ኬሰትስ ነንበሬሰ።","poem":2},{"text":"አን ዋቀሳኒ ነንተአ፤","poem":1},{"text":"እሳንስ ሰበኮ ንተኡ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሰበቢ ሁንድሳኒ፣","poem":1},{"text":"ጥና ሀመ ጉዳት ነ ቤከኒፍ፣","poem":2},{"text":"ስአች ነምን ከምዩ፣ ‘ጎፍታ ቤክ’ ጄዼ፣","poem":1},{"text":"ኦላሳ ዮካን ኦቦሌሰሳ ህንበርሲሱ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አን ደበሳኒ ነንዺሳፍ፤","poem":1},{"text":"ጩቡሳኒስ ስአች ህንያደዹ።”","poem":2},{"noteId":25}]},{"type":"verse","number":13,"content":["እንስ ከኩ ከናን “ሃራ” ጄዼ ከኩ ጀልቀባ ሰነ ሞፌሴረ፤ ወን ሞፈኤፊ ወን ዱሎሜ ደፌ በደ።"]}],"footnotes":[{"noteId":24,"caller":"+","text":"በኡ 25፥40","reference":{"chapter":8,"verse":5}},{"noteId":25,"caller":"+","text":"ኤር 31፥31‑34","reference":{"chapter":8,"verse":12}}]},"thisChapterLink":"/api/gaz_ebi/HEB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/HEB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/HEB/7.json","previousChapterAudioLinks":{},"numberOfVerses":13}