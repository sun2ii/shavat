{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HOS","translationId":"gaz_ebi","name":"ሆሴኣ","commonName":"ሆሴኣ","title":"ራጂ ሆሴኣ","order":28,"numberOfChapters":14,"sha256":"72244536d9404b992eb62b15971a2e27bbd0b4642b4487007f0eedf6754ab5ea","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gaz_ebi/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"እስራኤል ሙከ ወይኒ ደጋጌ ቱሬ፤","poem":1},{"text":"እን መቱመሳቲፍ እጀ ነቀተ።","poem":2},{"text":"አኩመ እጅሳ ባይአቴን","poem":1},{"text":"እን እዶ ኣርሳ ሄዱ እጃረቴ፤","poem":2},{"text":"አኩመ ለፍትሳ ገበቴን","poem":1},{"text":"ኡቱባወን ዋቄፈትናሳ ሚዸግፈቴ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ገራንሳኒ ጎዎምሳዻን ጉተሜረ፤","poem":1},{"text":"እሳን አመ የከሳኒ ባዸቹ ቀቡ።","poem":2},{"text":"ዋቀዮ እዶ ኣርሳሳኒ ንዲገ፤","poem":1},{"text":"ኡቱባወን ዋቄፈትናሳኒስ ንበርበዴሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ኤርገሲ እሳን አከነ ጄዹ፤","poem":1},{"text":"“ኑ ሰበቢ ዋቀዮን ሶዳቹ ድድኔፍ ሞቲ ህንቀብኑ።","poem":2},{"text":"ገሩ ኡቱ ሞቲ ቀባትኔዩ","poem":1},{"text":"እን ስላ ማል ኑፍ ጎዸ?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እሳን ዋን ሄዱ ዋዳ ገሉ፤","poem":1},{"text":"ከኩ ሶባስ ሴነኒ","poem":2},{"lineBreak":true},{"text":"ወሊ ገልቴ ኡመቱ፤","poem":2},{"text":"ከናፉ ሴረ ዸቤዪን","poem":1},{"text":"አኩመ አረማ ሱሚ ቀቡ ከን ለፈ ቆቲሳ ኬሳት ለቱ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ነሞትን ሰማርያ ኬሰ ጅራተን","poem":1},{"text":"ሰበቢ ዋቀ ቶልፈማ ፈኪ ጀቢከን ቤት ኣዌን ኬሳ ሰናቲፍ ሶዳቱ።","poem":2},{"text":"ሰብንሼ እሼዻፍ ቦአ።","poem":1},{"text":"ሉቦትንሼ ኤጅቶትን","poem":2},{"text":"ወር ኡልፍነሼቲን ገመደን ሱንስ","poem":1},{"text":"ሰበቢ እሼን እሳንራ ቦጅአምቴፍ ንቦኡ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ጀብችስ አከ ሀርከ ፉዻት","poem":1},{"text":"ያሪም ሞትቻፍ አሶርት ጌፈመ።","poem":2},{"text":"ኤፍሬም ንሰልጵፈመ፤","poem":1},{"text":"እስራኤል ዋቆተሼ ከኔን ሙከራ ቶልፈመኒፍ ንቃኖፍት።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሰማርያፊ ሞቲንሼ","poem":1},{"text":"አኩመ ሆመቸ ብሻንራት ፉዸተመኒ በዱ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እዶወን ሰገዳ ከኔን አዌን ንበርበዴፈሙ፤","poem":1},{"text":"ኩንስ ጩቡ እስራኤል።","poem":2},{"text":"ቆራቲፊ ሶኮሩን እረት ብቅሌ","poem":1},{"text":"እዶ ኣርሳሳኒ ሀጉገ።","poem":2},{"text":"ዬሮ ሰነ ነሞትን ቱሉወኒን፣ “ኑረት ጅጋ!”","poem":1},{"text":"ጋረኒንሞ፣ “ኑ ዾክሳ!” ጄዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ያ እስራኤል እስን በረ ግቤኣቲ ጀልቀብደኒጩቡ ሆጄተኒርቱ፤","poem":1},{"text":"አመስ አቹመት ሀፍተኒርቱ።","poem":2},{"text":"ግቤኣ ኬሰት ወራን ከኤ","poem":1},{"text":"ጀልኦተ ህንፍጡ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አን ዮን ፌዼ እሳን ነንአደበ፤","poem":1},{"text":"ሰበቢ ጩቡሳኒ ደቻ ሰናቲፍ","poem":2},{"lineBreak":true},{"text":"ህዻ ኬሰ እሳን ቡሱፍሰቦትን ናኖሳኒት ወልት ቀበሙ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኤፍሬም ጎሮምሰ ሌንጅፈሜ","poem":1},{"text":"ከን ምዻን ስርብሲሱ ጃለቱዸ፤","poem":2},{"text":"ከናፉ አን ሞርመሼረ","poem":1},{"text":"ዋንጆ ነንካአ።","poem":2},{"text":"አን ኤፍሬምን ነንኦፈ፤","poem":1},{"text":"ይሁዳን ለፈ ቆቲሳ ቆቱ ቀበ፤","poem":2},{"lineBreak":true},{"text":"ያቆብስ ብዮ ቡሌሱ ቀበ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኦፊኬሰኒፍ ቀጄሉማ ፈጫፈዻቲ","poem":1},{"text":"እጀ ጃለላ ከን ህንዹምኔ ሃመዻ፤","poem":2},{"text":"ለፈኬሰን ከን ህንቆተምንሌ በቀቅሳ፤","poem":1},{"text":"ዬሮን ኩን ዬሮ ሀመ እን ዹፌ","poem":2},{"text":"ቀጄሉማ እስንት ሮብሱት","poem":1},{"text":"ዋቀዮን በርባደተኒቲ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እስን ገሩ ሀምነ ፈጫፈተኒ","poem":1},{"text":"ጀልእነ ሃመተን፤","poem":2},{"lineBreak":true},{"text":"እስን እጀ ሶባ ኛተኒርቱ።","poem":2},{"text":"ሰበቢ አት ጀብነኬቲፊ","poem":1},{"text":"ሎልቶተኬ ባይኤ ሰነ አብደቴፍ፣","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አኩመ ሸልማን ጋፈ ሎላት ቤት አርቤልን በሌሴ","poem":1},{"text":"ሃዾተ እጆሌሳኒ ወጅን ብዮት መከመን ሰነ፣","poem":2},{"text":"ደአኖወንኬ ሁንድ ንበርበዳኡ፤","poem":1},{"text":"ሁርሳን ወራናስ ሰበኬት ንከአ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ያ ቤትኤል፣ ሰበቢ ሀምንኬ አከ መሌ ጉዳ ተኤፍ፣","poem":1},{"text":"ወን አከሲ ስትስ ንዹፍት።","poem":2},{"text":"ጋፈ ጉያን ሱን በርኡት","poem":1},{"text":"ሞቲን እስራኤል ጉቱማን ጉቱት ንበርበዴፈመ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}