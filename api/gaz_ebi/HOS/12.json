{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HOS","translationId":"gaz_ebi","name":"ሆሴኣ","commonName":"ሆሴኣ","title":"ራጂ ሆሴኣ","order":28,"numberOfChapters":14,"sha256":"72244536d9404b992eb62b15971a2e27bbd0b4642b4487007f0eedf6754ab5ea","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gaz_ebi/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"ኤፍሬም ቡቤ ኛተ፤","poem":1},{"text":"እን ጉያ ጉቱ ቡቤ በአ ቢፍቱ ዱካ ፊገ፤","poem":2},{"lineBreak":true},{"text":"ሶባፊ ጎሊስ ንባይእሰ።","poem":2},{"text":"እን አሶር ወጅን ወሊ ገልቴ ጎዸቴ","poem":1},{"text":"ብየ ግብጢት ዘይቲ ኤጄርሳ ኤርገ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዋቀዮ ዋን ይሁዳ ህመቱ ቀበ፤","poem":1},{"text":"እን አኩመ አመለሳት ያቆብን አደበ፤","poem":2},{"lineBreak":true},{"text":"አኩመ ሆጂ እሳትስ ገቲሳ ኬናፍ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እን ገደሜሰ ኬሰት ኮሜ ኦቦሌሰሳ ቀቤ፤","poem":1},{"text":"ኤርገ ጉደቴሞ ዋቀ ወጅን ወልኣንሶ ቀቤ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እን ኤርገማ ዋቃ ወጅን ወልኣንሶ ቀቤ ሞአቴ፤","poem":1},{"text":"ቦኤስ ሱራ ከዸቴ።","poem":2},{"text":"እን ቤትኤልት እሰ አርገቴ","poem":1},{"text":"አችት እሰ ወጅን ሃሰኤ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዋቀዮ ዋቀ ዋን ሁንደ ደንደኡ፣","poem":1},{"text":"መቃንሳ ዋቀዮ!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አት ገሩ ዋቀኬት ዴብእ፤","poem":1},{"text":"ጃለላፊ ሙርቲ ቀጄላ ጀቤሲ","poem":2},{"lineBreak":true},{"text":"ዬሮ ሁንደ ዋቀኬ ኤገዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ደልደላን መዳሊ ሶባ ኦፍ ሀርካ ቀቡ","poem":1},{"text":"ነመ ጎዎምሱ ጃለተ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኤፍሬም አከነ ጄዼ ቦነ፤","poem":1},{"text":"“አን አከ መሌ ሶሬሰ፤ ቀቤኘ ጉዳ አርገዼረ።","poem":2},{"text":"እሳን ቀቤኘኮ ከነ ሁንደ ኬሰትዩ","poem":1},{"text":"በሌሳ ዮካን ጩቡ ቶኮሌነረት አርገቹ ህንደንደአን።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“አን ዋቀዮ ዋቀኬ","poem":1},{"text":"ከን ብየ ግብጢ ስ ባሴዸ፤","poem":2},{"text":"አን አከ አት አኩመ ጉያ አያኖተኬከኔን ሙርቴፈመን ሰናት","poem":1},{"text":"ዴብቴ ዱንካነ ኬሰ ጅራቱ ስን ጎዸ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አን ራጆተት ዱበዼ","poem":1},{"text":"ሙልአተ ሄዱ ኬኔፊ","poem":2},{"lineBreak":true},{"text":"ከራሳኒቲን ፈኬኛን ነንዱበዼ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ግልኣድ ሀማዻ?","poem":1},{"text":"ሰብንሼ ፋይዳ ህንቀቡ!","poem":2},{"text":"እሳን ግልጋል ኬሰት ኮርመ ቀሉ?","poem":1},{"text":"እዶን ኣርሳሳኒ አኩመ ቱላ ዸጋ እሰ ለፈ ቆቲሳ","poem":2},{"lineBreak":true},{"text":"ከን ቆተሜረ ጅሩ ንተአ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ያቆብ ገረ ሶርያት በቀቴ፤","poem":1},{"text":"እስራኤል ኒቲ አርገቹፍ ነመ ተጃጅሌ፤","poem":2},{"lineBreak":true},{"text":"ገበረሼ ባሱፍስ ሆሎተ ትክሴ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዋቀዮ ብየ ግብጢቲ እስራኤልን ባሱፍራጂት ፈየደሜ፤","poem":1},{"text":"እን ከሩመ ራጂ ሰናቲን እሰ ኩኑንሴ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኤፍሬም ገሩ ኣሪሳ ጉድቸ ከካሴ፤","poem":1},{"text":"ጎፍታንሳ የከ ዺገ ነማ ዸንገላሱ ሰነእሱመት ዴብሰ፤","poem":2},{"lineBreak":true},{"text":"አረብሶሳስ መቱመሳት ዴብሰ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}