{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HOS","translationId":"gaz_ebi","name":"ሆሴኣ","commonName":"ሆሴኣ","title":"ራጂ ሆሴኣ","order":28,"numberOfChapters":14,"sha256":"72244536d9404b992eb62b15971a2e27bbd0b4642b4487007f0eedf6754ab5ea","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gaz_ebi/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":13,"content":[{"type":"heading","content":["ዋቀዮ እስራኤልት ዼከሜ"]},{"type":"verse","number":1,"content":[{"text":"ዬሮ ኤፍሬም ዱበቴት ነሞትን ንሆለተን፤","poem":1},{"text":"እን እስራኤል ኬሰት ኦል ኦል ጄዼ ቱሬ።","poem":2},{"lineBreak":true},{"text":"ገሩ የከ በኣልን ዋቄፈቹቲን ዱኤ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እሳን አመስ እት ዴዴብአኒ ጩቡ ሆጄቱ፤","poem":1},{"text":"ሜቲ ኦፊሳኒቲን ዋቀ ቶልፈማ ቶልፈቱ፤","poem":2},{"text":"ፈኪ ምሚዸጋ ከኔን ሁንድሳኒ","poem":1},{"text":"ሀርከ ኦጌዪቲን ሆጄተመን።","poem":2},{"text":"ዋኤ ሰበ ከናስ፣","poem":1},{"text":"“እሳን ነመ ቀለኒ ኣርሳ ዽኤሱ፤","poem":2},{"lineBreak":true},{"text":"ዋቀ ቶልፈማ ጀቢስ ንዹንገቱ!” ጄዸሜ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ከናፉ እሳን አኩመ ሁሪ ገነማ፣","poem":1},{"text":"አኩመ ፍጤንሰ በሪ በዱ፣ አኩመ ሀበቂ","poem":2},{"lineBreak":true},{"text":"ኦብዲ ምዻን እት ዸአንራ ከኡ","poem":2},{"lineBreak":true},{"text":"አኩመ ኣረ ፎዳዻን በኡ ንተኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“አን ገሩ ዬሮ አት ግብጢ ባቴ ጀልቀቤ","poem":1},{"text":"ዋቀዮ ዋቀኬት።","poem":2},{"text":"አት አነ መሌ ዋቀ ቶኮሌ ቤኩ ህንቀብዱ፤","poem":1},{"text":"አነ መሌ ፈይሳ ቶኮሌ ህንቀብዱ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አን ገሞጂ ኬሰት፣","poem":1},{"text":"ብየ ሆአ ጉባ ኬሰት ስ ኩኑንሴረ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዬሮ አን እሳን ሶሬት ንቁፈን፤","poem":1},{"text":"እሳን ዬሮ ቁፈንት ኦፍ ቱለን፤","poem":2},{"lineBreak":true},{"text":"ኤርገሲሞ ነ እራንፈተን።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ከናፉ አን አኩመ ሌንጫ እሳንት ነንተአ፤","poem":1},{"text":"አኩመ ቄረንሳ ርጴ ዳንዲረት እሳን ነንኤገዸ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አን አኩመ አማኬተ እልማንሼ ጀላ ፉዸተመኒት","poem":1},{"text":"እሳን ሎሌ ገራሳኒ ነንበቀቅሰ።","poem":2},{"text":"አን አኩመ ሌንጫት ቆርቄ እሳን ነንኛዸ፤","poem":1},{"text":"ብኔንስ ቦሶና ገርገር እሳን ጭጭረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ያ እስራኤል፣ ዋን አነ ገርጋራኬ","poem":1},{"text":"ሞርምቴፍ አት በዴርተ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አከ ስ ኦልቹፍ ሞቲንኬ ኤሰ ጅረ?","poem":1},{"text":"ቡልችቶትንኬ ወር መጋላኬ ሁንደ ኬሳ","poem":2},{"text":"ከኔን አት፣ ‘ሞቲፊ እልማን ሞቶታ ናፍ ኬን’","poem":1},{"text":"ጄቴ ከዸቴ ሱን ኤሰ ጅሩ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አን ኣሪኮቲን ሞቲ ሲፈን ኬኔ፤","poem":1},{"text":"ዼከምሰኮቲንሞ እሰ ስራ ነንፉዸዼ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"በሌሳን ኤፍሬም ወልት ኩፈሜ","poem":1},{"text":"ጩቡንሳስ ገልሜፈሜረ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሚጡን አኩመ ዱበርቲ ጭኒንሱን ቀበቴት እሰት ዹፈ፤","poem":1},{"text":"እን ገሩ ዳእመ ወላላዸ፤","poem":2},{"text":"እን ዮሙ ዬሮን ገኡት፣","poem":1},{"text":"ገደሜሰ ኬሳ በኡ ህንፌዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“አን ሰበ ከነ ሁምነ አዋላ ጀላ ነንበራረ፤","poem":1},{"text":"ዱአ ጀላ እሳን ነንባሰ።","poem":2},{"text":"ያ ዱአ፣ ዸእችኬ ሜሬ?","poem":1},{"text":"ያ አዋለ፣ በሌሱንኬ ሜሬ?","poem":2},{"lineBreak":true},{"text":"“አን ገረ ላፍነ ቶኮሌ ህንቀባዹ፤","poem":1}]},{"type":"verse","number":15,"content":[{"text":"ዮ እን ኦቦሎተ ኦፊ ግዱ ጅሬኘ ቶላ ጅራቴዩ፣","poem":2},{"text":"ቡቤን በኣ ዋቀዮ ብራ ንዹፈ፤","poem":1},{"text":"ለፈ ገሞጂ ኬሳ ንቡብሰ፤","poem":2},{"text":"ቡርቃንሳ ብሻን ዸበ፤","poem":1},{"text":"ቦል ብሻንሳስ ንጎገ።","poem":2},{"text":"መንኩስንሳ፣","poem":1},{"text":"ቀቤኝ እን ቀቡ ሁንድስ ንሳመመ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሰብን ሰማርያ ዋን ዋቀሳት ፍንጭሌፍ","poem":1},{"text":"ገቲ በሌሳሳ ንአርገተ።","poem":2},{"text":"እሳን ጎራዴዻን ዹሙ፤","poem":1},{"text":"ዳእመንሳኒ ለፈት ሀርጫፈሙ፤","poem":2},{"lineBreak":true},{"text":"ዱበርቶትንሳኒ ከኔንኡልፈ ቀበንስ ንበቀቅፈሙ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":16}