{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HOS","translationId":"gaz_ebi","name":"ሆሴኣ","commonName":"ሆሴኣ","title":"ራጂ ሆሴኣ","order":28,"numberOfChapters":14,"sha256":"72244536d9404b992eb62b15971a2e27bbd0b4642b4487007f0eedf6754ab5ea","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gaz_ebi/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["“ኦቦሎተኬሰኒን፣ ‘ሰበኮ’ ኦቦሌቶተኬሰኒንሞ፣ ‘ጃለተምቱኮ’ ጄዻ።"]},{"type":"heading","content":["አደበሙፊ ሃሮምፈሙ እስራኤል"]},{"type":"verse","number":2,"content":[{"text":"“ሃዸኬሰንት ዼከማ፤ እሼት ዼከማ፤","poem":1},{"text":"እሼን ኒቲኮ ምቲቲ፤","poem":2},{"lineBreak":true},{"text":"አንስ ዽርሰሼ ምት።","poem":2},{"text":"እሼን ፉለሼራ እላልቸ ኤጁማ ሃበሌስቱ፤","poem":1},{"text":"አመነሙማ ዸቡስ ሀርመሼ ግዱዻ ሃበሌስቱ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዮ ከና አቺ አን ወያ እሼራ ባሴ","poem":1},{"text":"አኩመ ጉያ እሼን ዸለቴ ሰና ቁላሼ ነንሀምብሳ፤","poem":2},{"text":"አኩመ ገሞጂ እሼ ነንጎዸ፤","poem":1},{"text":"ለፈ ጎጎጋት እሼ ነንጌደረ፤","poem":2},{"lineBreak":true},{"text":"ዼቡዻንስ እሼ ነንአጄሰ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እሳን እጆሌ ኤጁማ ዋን ተአኒፍ፣","poem":1},{"text":"አን እጆሌ እሼቲፍ ገራ ህንላፉ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሃትሳኒ አመነሙማ ዸብዴ","poem":1},{"text":"ከራ ሰልጵናቲን እሳን ኡልፎፍቴ።","poem":2},{"text":"እሼን፣ ‘አን ወረ ነ ጃለቱ፣","poem":1},{"text":"ወረ ኛተኮፊ ብሻንኮ፣","poem":2},{"text":"ወረ ሱፊኮፊ ወያ ቁንጬ ተልባራ ሆጄተሜ፣","poem":1},{"text":"ወረ ድበታፊ ዹጋቲኮ ናፍ ኬነን","poem":2},{"lineBreak":true},{"text":"ዱካ ነንቡአ’ ጄቴ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ከናፉ አን ሃፈ ቆራቲቲን ዳንዲሼ ነንጩፈ፤","poem":1},{"text":"አከ እሼን ከራ እቲን ባቱ ህንአርገትኔፍ ደላ እት ነንእጃረ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እሼን ምቾተሼ ዱካ ቡት፤ ገሩ እሳን ህንቀቀብዱ፤","poem":1},{"text":"እሳን በርባድ፤ ገሩ ህንአርግቱ።","poem":2},{"text":"ኤርገሲ እሼን፣ ‘አን አኩመ ዱራ","poem":1},{"text":"ገረ ዽርሰኮት ነንዴብአ፤","poem":2},{"lineBreak":true},{"text":"አመ ጫላ ዬሮ ሰነ ወየ ቱሬቲ’ ጄት።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እሼን አከ አን ምዻን፣","poem":1},{"text":"ዳዺ ወይኒ ሃራፊ ዘይቲ እሼዻፍ ኬኔ፣","poem":2},{"text":"ሜቲፊ ወርቄ እሳን በኣሊፍ ዽኤሰንስ","poem":1},{"text":"ከን እሼረት ዸንገላሴ አኑመ አከ ተኤ ህንቤክኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ከናፉ አን ዬሮ እን ብልቻቱት ምዻንኮ፣","poem":1},{"text":"ዳዺ ወይኒኮ ሃራሌ ዬሮ እን ቆጳኡትእራ ነንፉዸዸ።","poem":2},{"text":"አን ሱፊኮፊ ወያኮ ከን ቁንጬ ተልባራ ሆጄተሜ","poem":1},{"text":"ከነን ቁላሼ ዾክሱዻፍ ኬኔፍስአመ እሼራ ነንፉዸዸ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አን አመ እጁመ ምቾተሼ ዱረት","poem":1},{"text":"አደጉማሼ ነንሳጥለ፤","poem":2},{"lineBreak":true},{"text":"ነምን ቶኮዩ ሀርከኮ ኬሳ እሼ ህንባሱ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አን አያነሼ ሁንደ ጄቹንስ፣","poem":1},{"text":"አያነሼ ከን ወጋ፣ አያነሼ ከን ጋፈ ባቲ ሃራ፣","poem":2},{"text":"አያነሼ ከን ሰንበታቲፊ","poem":1},{"text":"አያኖተሼ ከኔን ሙርታአን ሁንደ ነንሀምብሰ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አን ሙከ ወይኒሼቲፊ ሙከ ሀርቡሼ","poem":1},{"text":"ከን እሼን ምቾተኮቱ ናፍ ኬኔ ጄቱ ሰነ ነንበርበዴሰ።","poem":2},{"text":"አን ደገለ እሳን ነንጎዸ፤","poem":1},{"text":"ብኔንስ ቦሶና እሳን ዼደ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አን ጉዮተ እሼን እት","poem":1},{"text":"በኣሊፍ እጣነ ኣርስቴ ሰናፍ እሼ ነንአደበ፤","poem":2},{"text":"እሼን ቁቤላፊ ፋየ ገራ ገራቲን","poem":1},{"text":"ኦፍ ሚዸግስቴ ምቾተሼ ዱካ ቡቴ ነ እራንፈቴ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ከናፉ አን አመ እሼ ነንሶሶበ፤","poem":1},{"text":"ገረ ለፈ ገሞጂት እሼ ጌሴ","poem":2},{"lineBreak":true},{"text":"ጃለላን እት ነንዱበዸ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አን እዶ ዻባ ወይኒሼ ዴብሴ ነንኬናፍ፤","poem":1},{"text":"ሱሉለ ኣኮርስ በልበለ አብዲ ነንጎዸ።","poem":2},{"text":"እሼን አችት አኩመ ጋፈ ሸመሩማሼት፣","poem":1},{"text":"አኩመ ጋፈ ብየ ግብጢ ባቴት ስርብት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“አት ጋፈ ሰነ” ጄዸ ዋቀዮ፤","poem":1},{"text":"“ ‘ዽርሰኮ’ ጄቴ ነ ዋምተ፤","poem":2},{"lineBreak":true},{"text":"አት ለመተ ዴብቴ፣ ‘ጎፍታኮ’ ናን ህንጄቱ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አን መቃወን በኣል አፋንሼቲ ነንበሌሰ፤","poem":1},{"text":"መቃንሳኒ ለመተ ህንዸአሙ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"አን ጋፈስ ብኔንሰ ቦሶናቲፊ ስምብሮተ ሰሚ ወጅን፣","poem":1},{"text":"ኡመመወን ለፈረ ሙኙቀን ወጅን","poem":2},{"lineBreak":true},{"text":"እሳኒፍ ከኩ ነንገለ።","poem":2},{"text":"አን አከ እስን ነጋዻን ቡልተኒፍ","poem":1},{"text":"ጥየ፣ ጎራዴፊ ወራነ","poem":2},{"lineBreak":true},{"text":"ለፈራ ነንበሌሰ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አን በረ በራን ኦፊኮቲፍ ስን ካዽመዸ፤","poem":1},{"text":"አን ቀጄሉማፊ ዹጋዻን","poem":2},{"lineBreak":true},{"text":"ጃለላፊ ገረ ላፍናን ስን ካዽመዸ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አን አመነሙማዻን ስን ካዽመዸ፤","poem":1},{"text":"አትስ ዋቀዮን ንቤክተ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ዋቀዮ አከነ ጄዸ፤","poem":1},{"text":"“አን ጋፈስ ዴቢ ሲፍ ነንኬነ፤","poem":2},{"text":"አን ሰሚፍ ዴቢ ነንኬነ፤","poem":1},{"text":"ሰሚንስ ለፋፍ ዴቢ ንኬነ፤","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ለፍትስ ምዻኒፍ፣ ዳዺ ወይኒ ሃራፊ","poem":1},{"text":"ዘይቲፍ ዴቢ ኬንት፤","poem":2},{"lineBreak":true},{"text":"እሳንስ ይዝርኤሊፍ ዴቢ ኬኑ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"አን ኦፊኮቲፍ ለፈረ እሼ ነንዻበዸ፤","poem":1},{"text":"አን ከነን፣ ‘አት ጃለሌኮ ምት’ ጄዼን ሰነ ነንጃለዸ።","poem":2},{"text":"አን ወረ፣ ‘እስን ሰበኮ ምት’ ጄዸመን ሰናን፣ ‘እስን ሰበኮት’ ነንጄዸ፤","poem":1},{"text":"እሳንስ፣ ‘አት ዋቀኮት’ ናን ጄዹ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/HOS/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/HOS/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/HOS/1.json","previousChapterAudioLinks":{},"numberOfVerses":23}