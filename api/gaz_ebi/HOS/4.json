{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HOS","translationId":"gaz_ebi","name":"ሆሴኣ","commonName":"ሆሴኣ","title":"ራጂ ሆሴኣ","order":28,"numberOfChapters":14,"sha256":"72244536d9404b992eb62b15971a2e27bbd0b4642b4487007f0eedf6754ab5ea","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gaz_ebi/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"heading","content":["ህመተሙ እስራኤል"]},{"type":"verse","number":1,"content":[{"text":"ያ እስራኤሎተ፣ ዋቀዮ እስን ወረ ብየቲ ኬሰ ጅራተንረት","poem":1},{"text":"ህመተ ዽኤፈቱ ዋን ቀቡፍ","poem":2},{"lineBreak":true},{"text":"ዱቢ ዋቀዮ ዸገኣ፦","poem":2},{"text":"“ብየቲ ኬሰ አመነሙማን፣","poem":1},{"text":"ጃለሊፊ ዋቀ ቤኩን ህንጅሩ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አባሩ፣ ሶቡፊ አጄሱ፣","poem":1},{"text":"ሀትናፊ ኤጀ ቆፈቱ ጅረ፤","poem":2},{"text":"እሳን ከኩ ሁንደ ንጨብሱ፤","poem":1},{"text":"ዺገ ዸንገላሱቱ ባይአተ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሰበቢ ከናፍ ብየቲን ንገድት፤","poem":1},{"text":"ወር እሼ ኬሰ ጅራተን ሁንድስ ንበዱ፤","poem":2},{"text":"ብኔንሶትን ቦሶና፣ ስምብሮትን ሰሚቲፊ","poem":1},{"text":"ቁርጡሚን ገላና ዹማ ጅሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“ገሩ ነምን ቶኮዩ ዱቢ ህንካስን፤","poem":1},{"text":"ነምን ቶኮዩ ነመ ካን ህንህመትን፤","poem":2},{"text":"ሰብንኬሰን","poem":1},{"text":"አኩመ ነመ ሉበ ህመቱ ቶኮት።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አት ሀልከኒፊ ጉያ ጉፈተ፤","poem":1},{"text":"ራጆትንስ እስን ወጅን ጉፈቱ።","poem":2},{"text":"ከናፉ አን ሃዸኬ ነንበሌሰ፤","poem":1}]},{"type":"verse","number":6,"content":[{"text":"ሰብንኮ ቤኩምሰ ዸቡዻን በዴረ።","poem":2},{"lineBreak":true},{"text":"“ዋን አት ቤኩምሰ ቱፈቴፍ","poem":1},{"text":"አንስ አከ አት ሉበ ናፍ ህንታኔፍ ስ ቱፈዼረ፤","poem":2},{"text":"ሰበቢ አት ሴረ ዋቀኬቲ ገቴፍ","poem":1},{"text":"አንስ እልማንኬ ነንገተ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሉቦትን አኩመ ባይአቻ ዴመኒን፣","poem":1},{"text":"አከሱመ ጩቡ ነት ሆጄቹ ባይእሰን፤","poem":2},{"lineBreak":true},{"text":"እሳን ኡልፍነሳኒ ሰልጵነት ጌደረኒሩ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እሳን ጩቡ ሰበኮቲ ኛቱ፤","poem":1},{"text":"ሀምነሳኒስ ንሀዉ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ወን ኩንስ አኩመ ሰባ፣ አኩመ ሉቦታ ተአ።","poem":1},{"text":"አንስ ሰበቢ ከራሳኒቲፍለቸንሳኒዩ ነንአደበ፤","poem":2},{"lineBreak":true},{"text":"ሆጂሳኒስ እሳኑመት ነንዴብሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“እሳን ንኛቱ፤ ገሩ ህንቁፈን፤","poem":1},{"text":"ንሰጋገሉ፤ ገሩ ህንባይአተን፤","poem":2},{"text":"ኩንስ ሰበቢ እሳን ዋቀዮን ዺሰኒ","poem":1},{"text":"ደበርሰኒ","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሰጋገልቱማት፣","poem":2},{"text":"ዳዺ ወይኒ ሞፋፊ","poem":1},{"text":"ሃራ ሁበትናሳኒ ፉዸቴት ኦፍ ኬነኒፍ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሰብንኮ ዋቀ ሙከራ ቶልፈሜ ጎርሰ ጋፈተ፤","poem":1},{"text":"ኡሌን ፈልፈልቱስ እሳንት ዱበተ።","poem":2},{"text":"ሀፉር ሰጋገልቱማ ከራራ እሳን ጀልእሰ፤","poem":1},{"text":"እሳን ዋቀሳኒቲፍ ህንአመነመን።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እሳን ፊጤወን ቱሉረት ቀልመ፣","poem":1},{"text":"ኣርሳ ጉበሙሞ ጋረንረት፣","poem":2},{"text":"ቅልጡ ጀለት፣ አለልቱፊ ሆሚ","poem":1},{"text":"ጋድስንሳኒ ነመት ቶሉ ጀለት ዽኤሱ።","poem":2},{"text":"ከናፉ እንተለንኬሰን ሰጋገልቱማት ዴብኡ፤","poem":1},{"text":"ኒቶትን እልማንኬሰኒስ ኤጀት ዴብኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ሰበቢ ወር ዺራዩ ሰጋገልቱማት ዴብአኒ","poem":1},{"text":"ገልመ ዋቄፈትና ኤጃት ቀልመ ዽኤሰኒፍ፣","poem":2},{"text":"ዮሙ እንተለንኬሰን","poem":1},{"text":"ሰጋገልቱማት ዴብአንት","poem":2},{"text":"ዮካን ዮሙ ኒቶትን እልማንኬሰኒ","poem":1},{"text":"ኤጀት ዴብአንት አን እሳን ህንአደቡ፤","poem":2},{"lineBreak":true},{"text":"ሰብን ሁበትና ህንቀብኔ ንበዳቲ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“ያ እስራኤል፣ አት ዮ ኤጀ ሆጄቴሌ","poem":1},{"text":"አከ ይሁዳን የከ ቀባቱ ህንጎዽን።","poem":2},{"lineBreak":true},{"text":"“እስን ግልጋል ህንዸቅና፤","poem":1},{"text":"ቤት ኣዌንትስ ኦል ህንበእና።","poem":2},{"lineBreak":true},{"text":"‘ዹጋ ዋቀዮ ጅራታ!’ ጄተኒስ ህንከከትና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እስራኤሎትን አኩመ ጎሮምሰ","poem":1},{"text":"መታ ጀባቴ ቶኮ መታ ጀቤዪ ተአኒሩ።","poem":2},{"text":"ዮስ ዋቀዮ አከሚን አከ ጦባላወን ሆላት","poem":1},{"text":"ከሎ በልኣት እሳን ቦባሱ ደንደአሬ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኤፍሬም ዋቆተ ቶልፈሞት ገሌረ፤","poem":1},{"text":"እሰ እቱመ ዺሳ!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዹጋቲንሳኒ ዮ ዹሜዩ","poem":1},{"text":"እሳን ሰጋገልቱማሳኒ እቱመ ፉፉ፤","poem":2},{"lineBreak":true},{"text":"ቡልችቶትንሳኒ ኡልፍነረ ቃኒ ጃለቱ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ቡቤን ሀማን ሀጣኤ እሳን በሌሰ፤","poem":1},{"text":"ኣርሳንሳኒስ ቃኒ እሳንት ፍደ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}