{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HOS","translationId":"gaz_ebi","name":"ሆሴኣ","commonName":"ሆሴኣ","title":"ራጂ ሆሴኣ","order":28,"numberOfChapters":14,"sha256":"72244536d9404b992eb62b15971a2e27bbd0b4642b4487007f0eedf6754ab5ea","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gaz_ebi/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"heading","content":["ሙርቲ እስራኤልት ሙርቴፈሜ"]},{"type":"verse","number":1,"content":[{"text":"“እስን ሉቦትን ዋን ከነ ዸገኣ!","poem":1},{"text":"እስራኤሎንስ ቀልቤፈዻ!","poem":2},{"text":"ያ መነ ሞቲ ዸጌፈዹ!","poem":1},{"text":"ሙርቲን ኩን እስንት ሙረመ፦","poem":2},{"text":"እስን ሚስጳት ክዮ፣","poem":1},{"text":"ታቦርረትሞ ጠጦ ድሪርሳ ቱርተን።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ፍንጭልቶትን አጄቻት ጀባተኒሩ።","poem":1},{"text":"አን እሳን ሁንደ ነንአደበ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አን ዋኤ ኤፍሬም ሁንደ ቤከ፤","poem":1},{"text":"እስራኤልስ ነ ዱራ ህንዾከቱ።","poem":2},{"text":"ያ ኤፍሬም፣ አት አመ ሰጋገልቱማት ዴብቴርተ፤","poem":1},{"text":"እስራኤልስ ጡራኤረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“ሆጂንሳኒ አከ እሳን ገረ ዋቀሳኒት","poem":1},{"text":"ዴብአን ህንኤየሙፍ።","poem":2},{"text":"ሀፉር ሰጋገልቱማ ገራሳኒ ኬሰ ጅረ፤","poem":1},{"text":"እሳን ዋቀዮን ህንቤከን።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኦፍ ቱሉማን እስራኤል ዹጋ እሳንት በአ፤","poem":1},{"text":"እስራኤሎትን፣ ኤፍሬም መታንሳዩጩቡሳኒ ኬሰት ጉፈቱ፤","poem":2},{"lineBreak":true},{"text":"ይሁዳንስ እሳን ወጅን ጉፈተ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እሳን ዮሙ ዋቀዮን በርባዱዻፍ","poem":1},{"text":"ቡሻዬፊ ሎንሳኒ ፉዸተኒ ዴመንት፣","poem":2},{"text":"እሰ ህንአርገተን፤","poem":1},{"text":"እን እሳን ዺሴ ዴሜራቲ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እሳን ዋቀዮፍ አመነሞ ምት፤","poem":1},{"text":"ሴራን አለ እጆሌ ጎዸቱ።","poem":2},{"text":"ዬሮ እሳን አያነ ባቲ ሃራ አያኔፈተንት","poem":1},{"text":"እን ለፈ ቆቲሳሳኒ ንበሌሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ግቤኣ ኬሰት መለከተ፣","poem":1},{"text":"ራማ ኬሰትሞ ጋንፈ አፉፋ።","poem":2},{"text":"ቤት ኣዌን ኬሰት እየ ሎላ ዸጌስሳ፤","poem":1},{"text":"ያ ቤንያም፣ አት ዱረ ቀጄል።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ጉያ እፈትናት","poem":1},{"text":"ኤፍሬም ንኦነ።","poem":2},{"text":"አን ጎሶተ እስራኤል ግዱት","poem":1},{"text":"ዋን ምርከናኤ ነንለብሰ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ቡልችቶትን ይሁዳ","poem":1},{"text":"አኩመ ነመ ዸጋ ዳሪ ዺቡ ቶኮት።","poem":2},{"text":"አን አኩመ ሎላ ብሻኒ","poem":1},{"text":"ዼከምሰኮ እሳንት ገድ ነንሎላሰ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኤፍሬም ሰበቢ ዋቆተ ቶልፈሞ","poem":1},{"text":"ዱካ ቡኡ ጃለቴፍ አከ መሌ ሀጩጨሜ","poem":2},{"lineBreak":true},{"text":"ሙርቲዻን ለፈት ዽዺተሜ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አን ኤፍሬምት አከ ብሊ፣","poem":1},{"text":"ይሁዳትሞ አከ ዳነኦት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ዮሙ ኤፍሬም ዹኩበሳ፣","poem":1},{"text":"ይሁዳንስ መዳሳ አርጌት፣","poem":2},{"text":"ኤፍሬም ገረ አሶርት ገረገሌ","poem":1},{"text":"ሞትቸ ጉዳ ገርጋርሰ ከዸቹዻፍነመ እት ኤርጌ።","poem":2},{"text":"እን ገሩ እስን ፈይሱ፣","poem":1},{"text":"መዳኬሰንስ ወዬሱ ህንደንደኡ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አን ኤፍሬምት አኩመ ሌንጫ፣","poem":1},{"text":"ይሁዳትስ አኩመ ሳፌለ ሌንጫ ነንተአ።","poem":2},{"text":"አን ገርገር እሳን ጭጭሬን ብራ ዴመ፤","poem":1},{"text":"አን እሳን ጉሬን ዴመ፤ ነምን እሳን ኦልቹስ ህንጅሩ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኤርገሲ አን ሀመ እሳን","poem":1},{"text":"በሌሳሳኒ ፉዸተንት","poem":2},{"lineBreak":true},{"text":"እዶኮት ነንዴብአ።","poem":2},{"text":"እሳን ፉለኮ በርባደቱ፤","poem":1},{"text":"ረኮሳኒ ኬሰት ጀባተኒ ነ በርባደቱ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}