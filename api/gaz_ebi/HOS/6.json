{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HOS","translationId":"gaz_ebi","name":"ሆሴኣ","commonName":"ሆሴኣ","title":"ራጂ ሆሴኣ","order":28,"numberOfChapters":14,"sha256":"72244536d9404b992eb62b15971a2e27bbd0b4642b4487007f0eedf6754ab5ea","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gaz_ebi/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"heading","content":["እስራኤል ቀልቢ ጅጂረቹ ድዴ"]},{"type":"verse","number":1,"content":[{"text":"“ኮታ ገረ ዋቀዮት ዴብና።","poem":1},{"lineBreak":true},{"text":"እን ኑ ጭጭሬረ፤","poem":1},{"text":"ገሩ ኑ ፈይሰ፤","poem":2},{"text":"እን ኑ መዴሴረ፤","poem":1},{"text":"ገሩ መዳኬኘ ንወልዻነ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አከ ኑ ፉለሳ ዱረ ጅራኑፍ፣","poem":1},{"text":"ጉያ ለመ ቦዴ ኑ በየነቺሰ፤","poem":2},{"lineBreak":true},{"text":"ጉያ ሰደፋትሞ ዴብሴ ኑ ዻበ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኮታ ዋቀዮን ሃቤክኑ፤","poem":1},{"text":"እሰ ቤኩፍስ ሃተታፈትኑ።","poem":2},{"text":"አኩመ አዱን ዹጉማን ባቱ ሰነ","poem":1},{"text":"እን ዹጉማን ንዹፈ፤","poem":2},{"text":"እን አኩመ ቦካ ገና፣","poem":1},{"text":"አኩመ ቦካ ብራ ከን ለፈ ቁብሱ ሰናትገረኬኘ ንዹፈ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“ያ ኤፍሬም፣ አን ማለን ስ ጎዸ?","poem":1},{"text":"ያ ይሁዳ፣ አን ማለን ስ ጎዸ?","poem":2},{"text":"ጃለልኬሰን አኩመ ሁሪ ገነማ፣","poem":1},{"text":"አኩመ ፍጤንሰ በሪ በዱት።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ከናፉ አን ራጆተኮቲን እስን ጭጭሬ","poem":1},{"text":"ዱቢ አፋንኮቲን እስን ፍጤ፤","poem":2},{"lineBreak":true},{"text":"ሙርቲንኮስ አኩመ አዱ ንበአ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አን አራረን ፌዸ መሌ ኣርሳ ህንፌዹቲ፤","poem":1},{"text":"ኣርሳ ጉበሙ ጫላ ዋቀ ቤኩ ነንፌዸ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እሳን አኩመ አዳም ከኩ ጨብሰኒሩ፤","poem":1},{"text":"አችትስ አናፍ ህንአመነምኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ግልኣድ መጋላ ሀሞታ","poem":1},{"text":"ከን ዺጋን ፋለምቴዸ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አኩመ ሳምቱን ርጵጤ ነመ ኤገቱ ሰነ፣","poem":1},{"text":"ገሬን ሉቦታስ አከሱመ ጎዹ፤","poem":2},{"text":"እሳን የከ ቃኔሳ ሆጄቹዻን","poem":1},{"text":"ከራ ሼኬም እረት ነመ አጄሱ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አን መነ እስራኤል ኬሰት","poem":1},{"text":"ዋን ሱከኔሳ ቶኮ አርጌረ።","poem":2},{"text":"አችት ኤፍሬም ንሰጋገሌ፤","poem":1},{"text":"እስራኤልስ ንጡራኤ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ያ ይሁዳ ስትስ","poem":1},{"text":"ሃመሙን ሙርቴፈሜረ።","poem":2},{"lineBreak":true},{"text":"“ዬሮ አን ቦጁ ሰበኮ ዴብሱት፣","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}