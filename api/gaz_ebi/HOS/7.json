{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HOS","translationId":"gaz_ebi","name":"ሆሴኣ","commonName":"ሆሴኣ","title":"ራጂ ሆሴኣ","order":28,"numberOfChapters":14,"sha256":"72244536d9404b992eb62b15971a2e27bbd0b4642b4487007f0eedf6754ab5ea","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gaz_ebi/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"ዬሮ አን እስራኤልን ፈይሱት","poem":2},{"text":"ጩቡን ኤፍሬም ሳጥለሜ","poem":1},{"text":"የክ ሰማርያስ እፈት ባፈመ።","poem":2},{"text":"እሳን ነመ ጎዎምሱ፤","poem":1},{"text":"ሀቱን ጨብስቴ መነ ሴንት፤","poem":2},{"lineBreak":true},{"text":"ሳምቶትን ዳንዲረት ነመ ሳሙ፤","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እሳን ገሩ አከ አን ጀልእነሳኒ ሁንደ","poem":1},{"text":"ያደዹ ህንሁበተን።","poem":2},{"text":"ጩቡንሳኒ እሳን መርሴረ፤","poem":1},{"text":"ዬሮ ሁንደስ ፉለኮ ዱረ ጅረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“እሳን ሀምነሳኒቲን ሞቲ፣","poem":1},{"text":"ሶበሳኒቲንሞ እልማን ሞቲ ገመቺሱ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እሳን ሁንድኑ ኤጅቶተ፣","poem":1},{"text":"አኩመ በዳ እብዳ","poem":2},{"text":"ከን ቶልችቱን ቶኮ ዬሮ ቡኮ ሱኩመኒ ጀልቀቤ","poem":1},{"text":"ሀመ እን ቡካኡት እት ቱቱቁ ህንበርባድኔት።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ጉያ አያነ ሞቲኬኛት","poem":1},{"text":"እልማን ሞቶታ ዳዺ ወይኒቲን ፍኒነን፤","poem":2},{"lineBreak":true},{"text":"እንስ ቆስቶተ ወጅን ሀርከሳ ድሪርሰ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አኩመ በዳ እብዳት ገራሳኒ ቆጴሰኒሩ፤","poem":1},{"text":"እሳን ደባን ገረሳት ዽኣቱ።","poem":2},{"text":"ኣሪንሳኒ ሀልከን ጉቱ እራ ህንገሉ፤","poem":1},{"text":"ገነመሞ አኩመ አረበ እብዳ በለልአ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሁንድሳኒ አኩመ በዳ እብዳ ሆኡ፤","poem":1},{"text":"ቡልችቶተሳኒስ ንፍጡ።","poem":2},{"text":"ሞቶትንሳኒ ሁንድኑ ንዹሙ፤","poem":1},{"text":"ቶኮንሳኒዩ ነ ህንዋመተን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ኤፍሬም ሰቦታን ወልት መከመ፤","poem":1},{"text":"ኤፍሬም መጥኖ ገረ ህንገልፈምኒዸ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ነሞትን ኦርማ ሁምነሳ ኛተን፤","poem":1},{"text":"እን ገሩ ህንሁበቱ።","poem":2},{"text":"አሪን እሰት በኤ፤","poem":1},{"text":"እን ገሩ ህንቤኩ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኦፍ ቱሉማን እስራኤል ዹጋ እሰት በአ፤","poem":1},{"text":"እን ገሩ ኡቱ ወን ኩን ሁንድ አከነ ተኤ ጅሩ፣","poem":2},{"text":"ገረ ዋቀዮ ዋቀሳት ህንዴብኡ","poem":1},{"text":"ዮካን እሰ ህንበርባደቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ኤፍሬም አኩመ ጉጌ","poem":1},{"text":"ጎዋ ሰሙ ህንቀብኔት፤","poem":2},{"text":"እሳን ግብጥን ዋመቱ፤","poem":1},{"text":"እሳን ገረ አሶርት ዴብኡ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዮሙ እሳን ዴመን አን ክዮኮ እሳንረ ነንቡሰ፤","poem":1},{"text":"አን አኩመ ስምብሮ ሰሚ ገድ እሳን ነንሀርክሰ።","poem":2},{"text":"አን ዮሙን አከ እሳን ወሊ ወጅን ያአን ዸገኡት፣","poem":1},{"text":"እሳን ነንቀበ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዋን ነራ ጎረኒፍ","poem":1},{"text":"እሳኒፍ ወዮ!","poem":2},{"text":"ዋን ነት ፍንጭለኒፍ","poem":1},{"text":"በዲስን እሳኒፍ መለ!","poem":2},{"text":"አን እሳን ፉሩ ነንበርባደ፤","poem":1},{"text":"እሳን ገሩ ዋኤኮ ሶበ ዱበቱ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እሳን ገራሳኒ ጉቱዻን ገረኮት ህንእየተን፤","poem":1},{"text":"ገሩ ስሬሳኒረ ተታአኒ ቦኡ።","poem":2},{"text":"እሳን ምዻኒፊ ዳዺ ወይኒቲፍ ወልት ቀበሙ፤","poem":1},{"text":"ገሩ ነት ፍንጭሉ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አን ሌንጅሴን እሬሳኒ ጀጀቤሴ፤","poem":1},{"text":"እሳን ገሩ ዋን ሀማ ነት ያዱ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እሳን ገረ ዋቀ ዋን ሁንዳ ኦሊት ህንዴብአን፤","poem":1},{"text":"እሳን አኩመ ጥየ ጀልአቴት።","poem":2},{"text":"ሆገንቶትንሳኒ ሰበቢ ሶበ ዱበተኒፍ","poem":1},{"text":"ጎራዴዻን ዹሙ።","poem":2},{"text":"ሰበቢ ከናፍ እሳን ብየ ግብጥት","poem":1},{"text":"ንቱፈተሙ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}