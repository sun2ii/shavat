{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HOS","translationId":"gaz_ebi","name":"ሆሴኣ","commonName":"ሆሴኣ","title":"ራጂ ሆሴኣ","order":28,"numberOfChapters":14,"sha256":"72244536d9404b992eb62b15971a2e27bbd0b4642b4487007f0eedf6754ab5ea","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gaz_ebi/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["እስራኤል ቡቤ ሀማ ሃመተ"]},{"type":"verse","number":1,"content":[{"text":"“መለከተ አፋንኬት ካአዹ!","poem":1},{"text":"ሰበቢ ነሞትን ከኩኮ ጨብሰኒ","poem":2},{"text":"ሴረኮት ፍንጭለኒፍ","poem":1},{"text":"ርሳን ቶኮ መነ ዋቀዮቲን ኦል ጅረ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እስራኤል፣ ‘ያ ዋቀኬኘ ኑ ስ ቤክነ!’ ጄዼ","poem":1},{"text":"ገረኮት እየቴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ተኡዩ እስራኤል ዋን ጋሪ ድዴረ፤","poem":1},{"text":"ከናፉ ዲን እሰ አርአ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እሳን ወሊ ገልቴኮ መሌ ሞቶተ ሞስፈተን፤","poem":1},{"text":"ኡቱ አን ህንፉዸትኒፍ እልማን ሞቶታ ፍለተን።","poem":2},{"text":"እሳን ሜቲፊ ወርቄሳኒቲን","poem":1},{"text":"በዲሰሳኒቲፍ","poem":2},{"lineBreak":true},{"text":"ዋቆተ ቶልፈሞ ኦፊሳኒቲፍ ቶልፈተን።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ያ ሰማርያ፣ ዋቀኬ ቶልፈማ ብፈ ጀቢ ሰነ ባሲ ገት!","poem":1},{"text":"ዼከምስኮ እሳንት ቦበአ።","poem":2},{"text":"እሳን ሀመ ዮሚት ቁልቁላኡ ደዸቡ?","poem":1}]},{"type":"verse","number":6,"content":[{"text":"እሳን ወረ እስራኤል!","poem":2},{"text":"ጀቢ ከነ ኦጌሰ ሆጂ ሀርካቱ ቶልቼ፤","poem":1},{"text":"እን ዋቀ ምት።","poem":2},{"lineBreak":true},{"text":"ጀቢን ሰማርያ ንሁራአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“እሳን ቡቤ ፈጫፈተኒ","poem":1},{"text":"ቡቤ ሀማ ሃመቱ።","poem":2},{"text":"ሙክንሳ መታ ህንቀቡ፤","poem":1},{"text":"ደራራስ ህንባሱ።","poem":2},{"text":"ኡቱ እን ምዻን ነቀቴ","poem":1},{"text":"ስላ ነሞትን ኦርማ ንኛቱ ቱሬ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እስራኤል ልቅምፈሜረ፤","poem":1},{"text":"እሳን አመ ሰቦተ ግዱት","poem":2},{"lineBreak":true},{"text":"አከ ዋን ፋይዳ ህንቀብኔ ቶኮት።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እሳን አኩመ ሀሬ ዲዳ ከን አሲፊ","poem":1},{"text":"አች ኮጳ ጆሩ ገረ አሶሪት ኦል በአኒሩቲ፤","poem":2},{"lineBreak":true},{"text":"ኤፍሬምስ ምቾተት ኦፍ ጉርጉሬረ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እሳን ሰቦተ ግዱት ዮ ኦፍ ጉርጉረንዩ","poem":1},{"text":"አን አመ ወልት እሳን ነንቀበ።","poem":2},{"text":"እሳን ሀጩጫ ሞትቸ ጀባ ጀለት","poem":1},{"text":"ንሱኩመሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ኤፍሬም ኣርሳ ጩቡቲፍእዶ ኣርሳ ሄዱ ዮ ሆጄቴዩ፣","poem":1},{"text":"ለፍት ሱን እዶ ኣርሳ እት ጩቡ ሆጄቹፍቆጴሰን ተኤረ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አን ዋኤ ሴረኮ ዋን ባይኤ እሳኒፍ በሬሴረ፤","poem":1},{"text":"እሳን ገሩ አኩመ ዋን አላ ዹፌ ቶኮት እላሉ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እሳን ኣርሳ ናፍ ኬነሜ ዽኤሱ፤","poem":1},{"text":"ፎን ሰነስ ንኛቱ፤","poem":2},{"lineBreak":true},{"text":"ዋቀዮ ገሩ እሳንት ህንገመድኔ።","poem":2},{"text":"እን አመ ሀምነሳኒ ያደቴ","poem":1},{"text":"ጩቡሳኒ አደበ፦","poem":2},{"lineBreak":true},{"text":"እሳን ገረ ግብጥት ዴብኡ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እስራኤል ኡማሳ እራንፈቴ","poem":1},{"text":"መሰራወን ሞቱማ እጃሬ፤","poem":2},{"lineBreak":true},{"text":"ይሁዳን መጋላወን ሄዱት ደላ እጃሬ።","poem":2},{"text":"አን ገሩ እብደ ደአኖወንሳኒ","poem":1},{"text":"በርበዴሱ መጋላወንሳኒት ነንኤርገ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}