{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"HOS","translationId":"gaz_ebi","name":"ሆሴኣ","commonName":"ሆሴኣ","title":"ራጂ ሆሴኣ","order":28,"numberOfChapters":14,"sha256":"72244536d9404b992eb62b15971a2e27bbd0b4642b4487007f0eedf6754ab5ea","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gaz_ebi/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["አደቢ እስራኤልት ዹፉ"]},{"type":"verse","number":1,"content":[{"text":"ያ እስራኤል ህንእልልችን፤","poem":1},{"text":"አከ ሰቦተ ካኒ ህንገመድን።","poem":2},{"text":"አት ዋቀኬቲፍ አመነማ ህንቱሬቲ፤","poem":1},{"text":"አት ኦብዲ ሁንደረት ገቲ","poem":2},{"lineBreak":true},{"text":"ሰጋገልቱማዻፍ ባፈሙ ጃለቴርተ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ኦብዲወኒፊ እዶን ጩንፋ ወይኒ ሰበ ህንሶረን፤","poem":1},{"text":"ዳዺን ወይኒ ሃራን እሳኒፍ ህንቶሉ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እሳን ብየ ዋቀዮ ኬሰት ህንሀፈን፤","poem":1},{"text":"ኤፍሬም ገረ ግብጥት ዴብኤ","poem":2},{"lineBreak":true},{"text":"አሶር ኬሰት ኛተ ጡራኤ ኛተ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እሳን ዽባዩ ዳዺ ወይኒ ዋቀዮፍ ህንዽባፈተን፤","poem":1},{"text":"ዮካን ኣርሳንሳኒ እሰ ህንገመቺሱ።","poem":2},{"text":"ኣርሳን አከሲ አኩመ ቡዴነ ወረ ገዳ እሳንት ተአ፤","poem":1},{"text":"ነምን ቡዴነ ከነ ኛቱ ሁንድኑ ንጡራአ።","poem":2},{"text":"ኛትን ኩን ከኑመ መታሳኒ ተአ፤","poem":1},{"text":"መነ ቁልቁሉማ ዋቀዮስ ኦል ህንሴኑ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"እስን ጉያ አያነኬሰን ሙርቴፈሜት፣","poem":1},{"text":"ጉዮተ አያነ ዋቀዮ ሰነት ማል ሆጄቱ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዮ እሳን በዲሰ ጀላ በአንዩ","poem":1},{"text":"ግብጥ ወልት እሳን ቀብድ፤","poem":2},{"lineBreak":true},{"text":"ሜምፊስሞ እሳን አዋለ።","poem":2},{"text":"ቀቤኝ ሜቲሳኒ ሶኮሩዻን ልቅምፈመ፤","poem":1},{"text":"ዱንካነሳኒሞ ቆራቲቱ ሀጉገ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ጉዮትን አደቢ ዹፋ ጅሩ፤","poem":1},{"text":"ጉዮትን እት ገቲ ባሰን ዽኣተኒሩ።","poem":2},{"lineBreak":true},{"text":"እስራኤል ዋን ከነ ሃቤኩ።","poem":2},{"text":"ሰበቢ ጩቡንኬ አከ መሌ ባይአቴ","poem":1},{"text":"ሀምንኬስ አከ መሌ ጉዳ ተኤፍ፣","poem":2},{"text":"ራጂን አከ ራቱት እላለሜ፤","poem":1},{"text":"ነምን ሀፉረ ዋቃቲን ቀጄልፈሙሞአከ መራቱት ሄደሜ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ራጅች ዋቀኮ ወጅን","poem":1},{"text":"ኤግዱ ኤፍሬም ተኤ፤","poem":2},{"text":"ተኡስ ዳንዲሳ ሁንደረት ክዮን እሰ ኤገተ፤","poem":1},{"text":"መነ ዋቀሳ ኬሰትስ ጅብ እሰ ኤገተ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እሳን አኩመ በረ ግቤኣ ኬሰት ተኤ ሰነ","poem":1},{"text":"ጡራኡማ ኬሰ ዽዽመን።","poem":2},{"text":"ዋቅን ሀምነሳኒ ያደቴ","poem":1},{"text":"ሰበቢ ጩቡሳኒቲፍ እሳን አደበ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ዬሮ አን እስራኤልን አርጌት፣","poem":1},{"text":"እን አኩመ እጀ ወይኒ ገሞጂ ኬሰት አርገሜ ቱሬ፤","poem":2},{"text":"ዬሮ አን አቦቲኬሰን አርጌት፣","poem":1},{"text":"እሳን አኩመ ዋን እጀ ጀልቀባ ሀርቡረት አርገሜ ቱረን።","poem":2},{"text":"እሳን ገሩ ዮሙ ገረ በኣል ጴኦር ዹፈንት፣","poem":1},{"text":"ዋቀ ቶልፈማ ቃኔሳ ሰናፍ ኦፍ ቁልቁሌሰኒ","poem":2},{"lineBreak":true},{"text":"አኩመ ዋን ጃለተን ሰና ጅብሲሶ ተአን።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኡልፍን ኤፍሬም አኩመ ስምብሮ በርሴ በደ፤","poem":1},{"text":"ዸልቹን፣ ገራት ባቹን፣ ኡልፋኡን ህንጅሩ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዮ እሳን እጆሌ ጉድፈተንዩ","poem":1},{"text":"አን ጀላ ፍጤ እልማን መሌ እሳን ነንሀምብሰ።","poem":2},{"text":"ጋፈ አን እሳንራ ገረገሉ","poem":1},{"text":"እሳኒፍ ወዮ!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አን ኤፍሬምን እሳ አኩመ ጢሮስ","poem":1},{"text":"ለፈ ነመት ቶሉረ ዻበቴ ጅሩ ነንአርጌ።","poem":2},{"text":"ሰብን ኤፍሬም ገሩ እጆሌሳ ገድ ባሴ","poem":1},{"text":"ወረ ጎጎረኡት ኬነ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ያ ዋቀዮ እሳኒፍ ኬን፤","poem":1},{"text":"አት ማል እሳኒፍ ኬንተ?","poem":2},{"text":"ገደሜሰ ኡልፈ ህንባትኔፊ","poem":1},{"text":"ሀርመ ጎጎጋ ኬኒፍ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“ሰበቢ ሀምነሳኒ ከን ግልጋል ኬሰት ሆጄተሜ ሰነ ሁንዳቲፍ፣","poem":1},{"text":"አን አችት እሳን ነንጅቤ።","poem":2},{"text":"ሰበቢ ሆጂሳኒ ከን ጩቡዻን ጉተሜ ሰናቲፍ","poem":1},{"text":"አን መነኮ ኬሳ እሳን አርአ።","poem":2},{"text":"አን ስአች እሳን ህንጃለዹ፤","poem":1},{"text":"ቡልችቶትንሳኒ ሁንድኑ ፍንጭልቶተ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኤፍሬም ሩኩተሜረ፤","poem":1},{"text":"ህድሳኒ ጎጎጌረ፤","poem":2},{"lineBreak":true},{"text":"እሳን እጀ ቶኮሌ ህንጎዸተን።","poem":2},{"text":"ዮ እሳን እጆሌ ጎዸተንዩ","poem":1},{"text":"አን ሰኚሳኒ ጃለተሞ እሳን ጀላ ነንቀለ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ሰበቢ እሳን እሳፍ ህንአጀጀምኒፍ፣","poem":1},{"text":"ዋቅንኮ እሳን ድደ፤","poem":2},{"lineBreak":true},{"text":"እሳን ወረ አሲፊ አች ሰቦተ ግዱ ጆሩ ተኡ።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}