{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["ሙልአተ እሳያስ እልም አሞስ በረ ቡልቺንሰ ኡዝያን፣ በረ ዮታም፣ በረ ኣሃዚፊ በረ ህስቅያስ ኬሰ ዋኤ ይሁዳቲፊ ዬሩሳሌም አርጌ።"]},{"type":"line_break"},{"type":"heading","content":["ሰበ ፍንጭላ ቶኮ"]},{"type":"verse","number":2,"content":[{"text":"ያ ሰሚወን ዸገኣ! ያ ለፈ ዸጌፈዹ!","poem":1},{"text":"ዋቀዮ አከነ ጄዼ ዱበቴራቲ፦","poem":2},{"text":"“አን እጆሌ ሆረዼን ጉድፈዼ፤","poem":1},{"text":"እሳን ገሩ ነት ፍንጭለኒሩ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ቆትዮን ጎፍታሳ፣","poem":1},{"text":"ሀሬንስ ጎለ ጎፍታሳ ንቤከ፤","poem":2},{"text":"እስራኤል ገሩ ህንቤኩ፤","poem":1},{"text":"ሰብንኮ ህንሁበቱ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ያ ሰበ ጩበማ፣","poem":1},{"text":"ኡመተ በሌሳን እት ባይአቴ፣","poem":2},{"text":"እልማን ወረ ዋን ሀማ ሆጄቱ፣","poem":1},{"text":"እጆሌ ጡራኡማዻን ጉተምቴ እስኒፍ ወዮ!","poem":2},{"text":"እሳን ዋቀዮን ዺሰኒሩ፤","poem":1},{"text":"ቁልቁልቸ እስራኤል ሰነ ቱፈተኒ","poem":2},{"lineBreak":true},{"text":"ዱግደሳኒ እት ገረገልፈተኒሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"እስን ስአች ማሊፍ ሩኩተምቱ?","poem":1},{"text":"ማሊፍ ፍንጭለ ኬሰ ጅራቱ?","poem":2},{"text":"መታንኬሰን ጉቱን ሚዸሜረ፤","poem":1},{"text":"ገራንኬሰን ጉቱንስ ደዸቤረ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ፋነ ሚለኬሰኒቲ ሀመ ጉቤ መታኬሰኒት፣","poem":1},{"text":"ፈያ ህንቀብደን፤","poem":2},{"text":"መዳፊ ድርመሙን፣ መዳን ዺጉ፣","poem":1},{"text":"ከን ህንቁልቁሎፍኔ ዮካን ህንመረምኔ","poem":2},{"lineBreak":true},{"text":"ዮካን ዘይቲዻን ህንላፍኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ብይኬሰን ዱዋ ሀፍቴርት፤","poem":1},{"text":"መጋላወንኬሰን እብዳን ጉበመኒሩ፤","poem":2},{"text":"አለጎን ፉሉመኬሰን ዱረት","poem":1},{"text":"ለፈ ቆቲሳኬሰን ሳሙ፤","poem":2},{"lineBreak":true},{"text":"አኩመ ዋን ኦርም እሼ ሳሜትስ ኦንት።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እንተል ጥዮን አኩመ ደአትኖ እዶ","poem":1},{"text":"ዻባ ወይኒ ኬሳት፣","poem":2},{"text":"አኩመ ዳሲ ለፈ ቆቲሰ ቡቄ ኬሳት፣","poem":1},{"text":"አኩመ መጋላ መርፈሜ ቶኮት ዺፈምት።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኡቱ ዋቀዮ ዋን ሁንደ ደንደኡ","poem":1},{"text":"ሀምባ ሙራሰ ኑፍ ሀምብሱ ባቴ፣","poem":2},{"text":"ኑ ስላ አኩመ ሶዶም ታኔ፣","poem":1},{"text":"ጎሞራስ ፈካትነ ቱሬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ያ ቡልችቶተ ሶዶም","poem":1},{"text":"ዱቢ ዋቀዮ ዸገኣ፤","poem":2},{"text":"ያ ሰበ ጎሞራ፣","poem":1},{"text":"ሴረ ዋቀኬኛ ዸጌፈዻ!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዋቀዮ አከነ ጄዸ፤","poem":1},{"text":"“ባይእን ኣርሳኬሰኒ አናፍ ማል?”","poem":2},{"lineBreak":true},{"text":"አን ኣርሳ ጉበሙ ከን ኮርቤዪ ሆላቲፊሆሪ ገብፈመኒ ባይኤን ቀበ፤","poem":2},{"text":"አን ዺገ ኮሮሚ ሎኒት፣","poem":1},{"text":"ከን ጦባላወን ሆላቲፊ ሬኤት ህንገመዱ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እስን ዮሙ ፉለኮ ዱረት ሙልአቹፍ ዹፍተን፣","poem":1},{"text":"አከ ኦብዲኮ ዽዺተን","poem":2},{"lineBreak":true},{"text":"ኤኙቱ እስንራ በርባዴ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኬና ፋይዳ ህንቀብኔ ፍዱ ዺሳ!","poem":1},{"text":"እጣንኬሰን ነ ጅብሲሰ።","poem":2},{"text":"አያነ ባቲ፣ ሰንበታፊ ያኢኬሰን","poem":1},{"text":"ጄቹንስ ወል ገኢኬሰን ሀማ ሰነ አን ህንፌዹ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አያነ ባቲኬሰኒፊ","poem":1},{"text":"አያኖተኬሰን ቤቤከሞ ሉቡንኮ ንጅብት።","poem":2},{"text":"እሳን በኣ ነት ተአኒሩ፤","poem":1},{"text":"አንስ ኦብሱ ደዸቤረ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዬሮ እስን ከዸናፍ ሀርከኬሰን በልእፈተን፣","poem":1},{"text":"አን እጀኮ እስነን ዾክፈዸ፤","poem":2},{"lineBreak":true},{"text":"ዮ እስን ከዻ ባይኤ ከዸተንሌ አን ህንዸጌፈዹ።","poem":2},{"lineBreak":true},{"text":"ሀርክኬሰን ዺጋን ጉተሜረ!","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ዽቀዻቲ ኦፍ ቁልቁሌሳ።","poem":1},{"text":"ሆጂኬሰን ሀማ ሰነ ፉለኮ ዱራ በሌሳ!","poem":2},{"lineBreak":true},{"text":"የከ ሆጄቹስ ዺሳ፤","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዋን ቀጄላ ሆጄቹ በረዻ!","poem":1},{"text":"ሙርቲ ቀጄላ በርባዳ፤","poem":2},{"text":"ወረ ሀጩጨሜ ጀጀቤሳ።","poem":1},{"text":"እጆሌ አባ ህንቀብኔፍ ፈልማ፤","poem":2},{"lineBreak":true},{"text":"ሃዸ ህዬሳቲፍ ዻበዻ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ዋቀዮ አከነ ጄዸ፤","poem":1},{"text":"“ኮታ ወል ቆራ፤","poem":2},{"text":"ጩቡንኬሰን ዮ አከ ብልዲማ ተኤዩ፣","poem":1},{"text":"እን አዳቴ አከ ጨቢ ንተአ፤","poem":2},{"text":"ዮ አከ አለላ ዲመቴዩ፣","poem":1},{"text":"አከ ሱፊ ንአዳተ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እስን ዮ ፌዺ ቀባተኒ አጀጀምተን፣","poem":1},{"text":"ዋን ለፍት ባፍቱ ፍለተማ ንኛቱ፤","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ገሩ ዮ ድደኒ ፍንጭልተን ጎራዴቱ እስን ኛተ።”","poem":1},{"text":"አፋን ዋቀዮ ዋን ከነ ዱበቴራቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"አከ መጋላን አመነምቱን ሱን","poem":1},{"text":"ሰጋገልቱ ታቴ እላላ!","poem":2},{"text":"እሼን ዱር ሙርቲ ቀጄላዻን ጉተምቴ","poem":1},{"text":"ቀጄሉማን እሼ ኬሰ ጅራተ ቱሬ፤","poem":2},{"lineBreak":true},{"text":"አመሞ ነሞተ ነመ አጄሰንቱ እሼ ኬሰ ጅራተ!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ሜቲንኬ ልግዳኤረ፤","poem":1},{"text":"ዳዺን ወይኒኬ ፍለተማን ብሻኒን መከሜረ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ቡልችቶትንኬ ፍንጭልቶተ፤","poem":1},{"text":"ምቹ ሀቱወኒት፤","poem":2},{"text":"እሳን ሁንድኑ መተኣ ጃለቱ፤","poem":1},{"text":"ኬናስ አከ መሌ በርባዱ።","poem":2},{"text":"እሳን እጆሌ አባ ህንቀብኔፍ ህንፈልመን፤","poem":1},{"text":"ህመተ ሃዸ ህዬሳ ህንዸጌፈተን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ከናፉ ጎፍታን፣ ዋቀዮ ዋን ሁንደ ደንደኡ፣","poem":1},{"text":"ጀባን እስራኤል ሱን አከነ ጄዸ፦","poem":2},{"text":"“አን አመጃጆተኮራ ቦቆና ነንአርገዸ፤","poem":1},{"text":"ዲኖተኮስ ሃሎ ነንባፈዸ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"አን ሀርከኮ ስት ነንዴብሰ፤","poem":1},{"text":"ልግዳኡማኬስ አከ መሉት ስራ ነንሀቀ፤","poem":2},{"lineBreak":true},{"text":"ጡሪኬ ሁንደስ ስራ ነንበሌሰ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"አን አኩመ በረ ዱሪ አቦቲ ሙርቲ እዶት፣","poem":1},{"text":"አኩመ ጀልቀባት ጎርስቶተኬሌ ሲፍን ዴብሰ።","poem":2},{"text":"ኤርገሲ አት መጋላ ቀጄሉማ፣","poem":1},{"text":"መጋላ አመነምቱ ጄዸምቴ ንዋመምተ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ጥዮን ሙርቲ ቀጄላዻን፣","poem":1},{"text":"ቀልቢ ጅጂረቶትንሼሞ ቀጄሉማዻን ፉረሙ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ፍንጭልቶትኒፊ ጩበሞትን ገሩ ንጨጨቡ፤","poem":1},{"text":"ወር ዋቀዮን ዺሰንስ ንበዱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“እስን ሰበቢ ሙከ ቅልጡ እት ገመደን ሰናቲፍ ንቃኖፍቱ፤","poem":1},{"text":"ሰበቢ እዶ ብቅልቱ ፍለተን ሰናቲፍሞ ንሰልጰቱ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"እስን አከ ቅልጡ ባል እራ ሀርጨኤ፣","poem":1},{"text":"አከ እዶ ብቅልቱ ብሻን ህንቀብኔ ንታቱ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ነምን ጀባን አኩመ ሁባ፣","poem":1},{"text":"ሆጂንሳስ አኩመ ቃንቄ ተአ፤","poem":2},{"text":"እሳን ለቹ ወሉማን ጉበቱ፤","poem":1},{"text":"ነምን እብደ ሰነ ዻምሱስ ህንጅሩ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}