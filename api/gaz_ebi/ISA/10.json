{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"ወረ ሴረ ጀልኣ ባሰን፣","poem":1},{"text":"ከኔን ለብሲ ጩንቁርሳ ለብሰኒፍ ወዮ፤","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እሳን ሙርቲ ረከቶታ ጀልእሱ፤","poem":1},{"text":"ምርገ ህዬዪ ሰበኮስ ንዺቡ፤","poem":2},{"text":"ሃዾተ ህዬሳ ቦጁ ጎዸቱ፤","poem":1},{"text":"እጆሌ አባ ህንቀብኔስ ንሳሙ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እስን ዬሮ በዲስን ፈጎዻ ዹፉ","poem":1},{"text":"ጉያ አደቢት ማል ጎቱ?","poem":2},{"text":"ገርጋርሰ አርገቹፍ ኤኙት በቀቱ?","poem":1},{"text":"ቀቤኘኬሰን ኤሰት ዺፍቱ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ወረ ቦጅአመን ጀለ ጉጉፉ","poem":1},{"text":"ዮካን ወረ አጄፈመን ጀለት ኩፉ መሌ ሆምቱ ህንሀፉ።","poem":2},{"lineBreak":true},{"text":"ከነ ሁንዳንሌ ዼከምስሳ ህንቀበኖፍኔ፤","poem":1},{"text":"ሀርክሳስ አመዩ አኩመ ኦል ካፈሜት ጅረ።","poem":2}]},{"type":"heading","content":["ሙርቲ ዋቅን አሶርት ሙርቴሴ"]},{"type":"verse","number":5,"content":[{"text":"“አሶርቸ እሰ ኡሌ ኣሪኮቲ ተኤፍ፣","poem":1},{"text":"እሰ ቦኩን ዼከምሰኮቲ ሀርከሳ ጅሩፍ ወዮ!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አን አከ እን እሳን ሳሙፊ ቦጅኡፍ","poem":1},{"text":"አከ እን አኩመ ዾቄ ከራራ ለፈት እሳን ዽዺቱፍ","poem":2},{"text":"ሰበ ዋቀት ህንቡሌት እሰ ነንኤርገ፤","poem":1},{"text":"ኡመተ ነ ኣርሱትስ እሰ ነንአጀጀ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ገሩ ኩን ዋን እን ያዱ ምት፤","poem":1},{"text":"ያድን አከሲስ ገራሳ ኬሰ ህንጅሩ፤","poem":2},{"text":"ካዮንሳ በርበዴሱዸ፤","poem":1},{"text":"ሰበ ባይኤስ ፍጡዸ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እንስ አከነ ጄዸ፤ ‘አጀጆትንኮ ሁንድኑ ሞቶተ ምቲ?","poem":1}]},{"type":"verse","number":9,"content":[{"text":"ካልኖትን አኩመ ከርኬሚሽ ምቲ?","poem":2},{"text":"ሀማት አኩመ አርፋድ ምቲ?","poem":1},{"text":"ሰማርያንስ አኩመ ደማስቆ ምቲ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አኩመ ሀርክኮ ሞቱሞተ ዋቆተ ቶልፈሞ","poem":1},{"text":"ከኔን ፈኪወን ሶፈሞ ከን ዬሩሳሌሚፊሰማርያ ጫለን ቀቤ ሰነ፣","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አን ዋነን ሰማርያፊ ፈኪወንሼ ጎዼ ሰነ","poem":1},{"text":"ዬሩሳሌሚፊ ዋቆተሼ ቶልፈሞ ህንጎዹ?’ ”","poem":2}]},{"type":"verse","number":12,"content":["ጎፍታን ዬሮ ቱሉ ጥዮንረቲፊ ዬሩሳሌም ኬሰት ሆጂሳ ሁንደ ፍጠቱት አከነ ጄዸ፤ “አን ሰበቢ ኦፍ ጀጁ ገራሳቲፊ እላልቸሳ ከን ኦፍ ቱሉማን ጉተሜ ሰናቲፍ ጄዼ ሞትቸ አሶር ነንአደበ።"]},{"type":"verse","number":13,"content":["እን አከነ ጄዻቲ፦",{"text":"“ ‘አን ጀብነ ሀርከኮቲን ዋን ከነ ሆጄዼረ፤","poem":1},{"text":"አን ሰበቢን ሁበትና ቀቡፍ፣ኦጉማኮቲን ሆጄዼረ።","poem":2},{"text":"አን ዳንጋ ሰቦታ እዶዻ ቡቅሴረ፤","poem":1},{"text":"ቀቤኘሳኒሌ ሳሜረ።","poem":2},{"lineBreak":true},{"text":"አኩመ ነመ ጀባ ቶኮ አን ሞቶተሳኒኦፍ ጀለ ገልፈዼረ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አኩመ ነምን ቶኮ መንኤ ስምብራ ኬሰ ሀርከ ካኡ ሰነ","poem":1},{"text":"አንስ ሀርከኮ ቀቤኘ ሰቦታ ኬሰ ነንካአ፤","poem":2},{"text":"አኩመ ነሞትን ሀንቃቁ ደገተሜ","poem":1},{"text":"ወልት ቀበን ሰነ፣ አንስ ብየ ሁንደ ወልት ነንቀቤ፤","poem":2},{"text":"ከን ቆቾ ሁርጉፈቴ፣","poem":1},{"text":"ዮካን ወጩፍ አፋን በነቴ ቶኮዩ ህንቱሬ።’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ቆቶን ነመ እቲን ዋ ሙሩት ንኮራ?","poem":1},{"text":"ዮካን ወን እቲን ዋ ሙረን ነመ እት ፈየደሙት ኦፍ ጀጃ?","poem":2},{"text":"ኩንስ አከ ዋን ኡሌን ቶኮ ነመ እሰ ቀበቱት ኦፍ ምርምርሱት፤","poem":1},{"text":"ዮካን አኩመ ቦኩን ቶኮ አከ ዋን ሙከ ህንተእኒት ኦል ኦፍ ጉድሱት!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ከናፉ ጎፍታን፣ ዋቀዮ ዋን ሁንደ ደንደኡ፣","poem":1},{"text":"ሎልቶተ ገገበተን ከነት ዹኩበ ነመ ሁቅሱ ንኤርገ፤","poem":2},{"text":"ኡልፍነሳ ጀላንስ እብድ ቶኮ","poem":1},{"text":"አኩመ አረበ እብዳ ንቀብሲፈመ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እፍን እስራኤል እብደ፣","poem":1},{"text":"ቁልቁልችሳኒ ሱንስ አረበ እብዳ ተአ፤","poem":2},{"text":"እብድ ሱን ጉዩመ ቶኮን","poem":1},{"text":"ቆራቲሳቲፊ ሶኮሩሳ ጉቤ በሌሰ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"አኩመ ነምን ቶኮ ዬሮ ዹኩብሰቱ ሁቀቱ ሰነ፣","poem":1},{"text":"እብድ ሱን ኡልፍነ ቦሶናሳቲፊ ለፈ ቆቲሳ ገበታ፣","poem":2},{"lineBreak":true},{"text":"ሉቡፊ ፎንስ ንበርበዴሰ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሙኬን ቦሶነሳ ኬሰት ሀፈን ዋን አከ መሌ ሙራሰ ተአኒፍ","poem":1},{"text":"ሙጫን ቶኮ ገልሜሱ ንደንደአ።","poem":2}]},{"type":"heading","content":["ሀምባ እስራኤል"]},{"type":"verse","number":20,"content":[{"text":"በረ ሰነ ኬሰ ሀምባን እስራኤል፣","poem":1},{"text":"መነ ያቆብ ኬሳ ወር ሀፈን፣","poem":2},{"text":"ዹጉማን ዋቀዮ ቁልቁልቸ እስራኤል አብደቱ መሌ","poem":1},{"text":"ለመተ እሰ እሳን ዸኤ ሰነ ህንአብደተን።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሀምባን ቶኮ፣ ሀምባን ያቆብ","poem":1},{"text":"ገረ ዋቀ ጀባ ሰናት ንዴብአ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ያ እስራኤል፣ ዮ ሰብንኬ","poem":1},{"text":"አኩመ ጭረቸ ቀርቀረ ገላና ተኤዩ፣ሀምባ ቆፈቱ ዴብአ።","poem":2},{"lineBreak":true},{"text":"በዲስን ቀጄሉማዻን ጉተሜ ለብሰሜረ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ጎፍታን፣ ዋቀዮ ዋን ሁንደ ደንደኡ","poem":1},{"text":"በዲሰ ለፈ ሁንደት ለብሰሜ ንራወተ።","poem":2}]},{"type":"verse","number":24,"content":["ከናፉ ጎፍታን፣ ዋቀዮ ዋን ሁንደ ደንደኡ አከነ ጄዸ፦",{"text":"“ያ ሰበኮ ወር ጥዮን ኬሰ ጅራተን፣","poem":1},{"text":"ወረ አሶር ከኔን ኡሌዻን እስን ሩኩተን፣","poem":2},{"lineBreak":true},{"text":"ከኔን አኩመ ወረ ግብጥ ቦኩ ኦል እስንት ፉዸተን ህንሶዳትና።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ኣሪን አን እስንት ኣሬ ደፌ ቀበናአ፤","poem":1},{"text":"ዼከምስኮስ እሳን በሌሱፍ እት ገረገለ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ዋቀዮ ዋን ሁንደ ደንደኡ ሱን፣","poem":1},{"text":"አኩመ ከታ ሄሬብ ብረት ምድያንን ቀጬን ገረፌ ሰነ፣","poem":2},{"text":"አኩመ ብየ ግብጥ ኬሰት ጎዼ ሰነ፣","poem":1},{"text":"ኡሌሳ ብሻንረት ኦል ፉዸተ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ጋፈስ በኣንሳኒ ገቲቲኬሰንራ፣","poem":1},{"text":"ዋንጆንሳኒስ ሞርመኬሰንራ ፉዸመ፤","poem":2},{"lineBreak":true},{"text":"ዋን እስን አከ መሌ ገበተኒፍ ዋንጆን ንጨጨበ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"እሳን ገረ አየት ሴነን፤","poem":1},{"text":"ምግሮን ኬሰ በአን፤","poem":2},{"lineBreak":true},{"text":"ኛታፊ ህዸተሳኒስ ምክማስ ኬሰት ኩፍተን።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"እሳን ከራ ቀልኣረ በአኒ፣","poem":1},{"text":"“ኑ ጌባ ቁበትኔ ቡለ” ጄዸን።","poem":2},{"text":"ራማን ንሶዳት፤","poem":1},{"text":"ግቤኣን ሳኦልስ ንበቀት።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ያ እንተለ ገሊም፣ እይ!","poem":1},{"text":"ያ ላይሻ ዸጌፈዹ!","poem":2},{"lineBreak":true},{"text":"ያ አናቶት ዴቢ እሼፍ ኬን!","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ማድሜናን በቀታ ጅርት፤","poem":1},{"text":"ኡመትን ጌቢምስ በቀቹፍ ወልት ቀበመ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"እሳን ሀርአ ኖብ ገኡ፤","poem":1},{"text":"እሳን ቱሉ እንተለ ጥዮንት፣","poem":2},{"lineBreak":true},{"text":"ጋረ ዬሩሳሌምት ሀርከሳኒ ራሱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"ኩኖ ጎፍታን፣ ዋቀዮ ዋን ሁንደ ደንደኡ፣","poem":1},{"text":"ሁምነ ጉዳዻን ደሜወን ሙርሙረ፤","poem":2},{"text":"ሙኬን ጉርጉዳን ንጭጭረሙ፤","poem":1},{"text":"ሙኬን ዼዼሮንስ ገድ ቀበሙ።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"እን ቦሶነ ጎቡ ቆቶዻን ጭረ፤","poem":1},{"text":"ልባኖንስ ፉለ ዋቀ ጀባ ዱረት ኩፈ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/9.json","previousChapterAudioLinks":{},"numberOfVerses":34}