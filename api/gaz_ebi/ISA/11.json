{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":11,"content":[{"type":"heading","content":["ደሜ እሴይ"]},{"type":"verse","number":1,"content":[{"text":"ለታን ቶኮ ጅርመ እሴይራ ንለተ፤","poem":1},{"text":"ህደሳራስ ደሜን ቶኮ እጀ ነቀተ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሀፉር ዋቀዮ፣","poem":1},{"text":"ሀፉር ኦጉማቲፊ ሁበትና፣","poem":2},{"lineBreak":true},{"text":"ሀፉር ጎርሳቲፊ ሁምና፣","poem":2},{"lineBreak":true},{"text":"ሀፉር ቤኩምሳቲፊ ከን ዋቀዮን ሶዳቹ እሰረ ቁበተ፤","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እን ዋቀዮን ሶዳቹት ንገመደ።","poem":1},{"lineBreak":true},{"text":"እን ዋኑመ እጅሳ አርጉን ሙርቲ ህንኬኑ፤","poem":1},{"text":"ዮካን ዋኑመ ጉረሳቲን ዸገኡን ህንሙርቴሱ፤","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ገሩ ነመ ረከታፍ ቀጄሉማዻን ሙርቴሰ፤","poem":1},{"text":"ህዬዪ ለፈራቲፍስ ሙርቲ ቀጄላዻን ሙርቲ ኬነ።","poem":2},{"text":"እን ኡሌ አፋንሳቲን ለፈ ሩኩተ፤","poem":1},{"text":"ሀፉረ አፋንሳቲ በኡን ሀሞተ ንፍጠ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ቀጄሉማን ቴጰ ሙዺሳት፤","poem":1},{"text":"አመነሙማንሞ ሰበተ ሙዺሳት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ዬዪን ጦባላ ሆላ ወጅን ጅራተ፤","poem":1},{"text":"ቄረንስ እልሞ ሬኤ ብረ ጪሰ፤","poem":2},{"text":"ጀቢን፣ ሌንጪፊ ሆሪን ገበታን ወሊ ወጅን ቦበኡ፤","poem":1},{"text":"ሙጫን ጥናን እሳን ቦባሰ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሳን አማኬተ ወጅን ሶረተ፤","poem":1},{"text":"እልማንሳኒ ወል ጭነ ጭጪሱ፤","poem":2},{"lineBreak":true},{"text":"ሌንጭስ አከ ሰንጋ ጭዲ ኛተ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዳእምን ቦለ ቦፋረ ተጰተ፤","poem":1},{"text":"ሙጫን ጥናን ቦለ ቡቲ ኬሰ ሀርከ ካአ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እሳን ቱሉወንኮ ቁልቁሎተ ሁንደረት","poem":1},{"text":"ዋ ህንሚዸን ዮካን ዋ ህንበሌሰን፤","poem":2},{"text":"አኩመ ብሻን ገላነ ጉቱ ሰነ","poem":1},{"text":"ለፍት ዋቀዮን ቤኩዻን ጉተምቲቲ።","poem":2}]},{"type":"verse","number":10,"content":["በረ ሰነ ኬሰ ህድ እሴይ አኩመ ፋጂት ኡመታፍ ዻበተ፤ ሰቦትን ገረሳት ወልት ቀበሙ፤ ለፍት እን ቦቆቱስ ኡልፍነ ቀቤሰ ተአ።"]},{"type":"verse","number":11,"content":["ጋፈስ ጎፍታን ዬሮ ለመፋፍ ሀርከሳ ድሪርሴ አሶርራ፣ ግብጥ ገዲራ፣ ግብጥ ኦሊራ፣ እቶጵያራ፣ ኤላምራ፣ ባብሎንራ፣ ሀማቲፊ ብዮተ ብሻን ግዱ ገላናራ ሀምባወን ሰበሳ ወልት ቀበተ።"]},{"type":"verse","number":12,"content":[{"text":"እን ሰቦታፍ ፋጂ ኦል ካሴ","poem":1},{"text":"ቦጅአምቶተ እስራኤል ወልት ቀበ፤","poem":2},{"text":"እን ሮገ ለፋ አፍረንራ","poem":1},{"text":"ሰበ ይሁዳ ከን ብትናኤ ቱሬ ወልት ቀበ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ህናፋን ኤፍሬም ንበደ፤","poem":1},{"text":"ዲኖትን ይሁዳስ ንበርበዴፈሙ፤","poem":2},{"text":"ኤፍሬም ጋፈስ ይሁዳት ህንህናፉ፤","poem":1},{"text":"ዮካን ይሁዳን ኤፍሬምት ህንሀማቱ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እሳን ከራ ልጠ ቢፍቱቲን ገቲቲ ፍልስጤምት ገድ ቡኡ፤","poem":1},{"text":"ቶኮ ተአኒስ ኡመተ በአ ቢፍቱ ሳሙ።","poem":2},{"text":"እሳን ኤዶሚፊ ሞኣብን ቀበቱ፤","poem":1},{"text":"ወር አሞንስ እሳን ጀለት ቡሉ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዋቀዮ ጉቱማን ጉቱት፣","poem":1},{"text":"ገሎ ገላነ ግብጥ ንጎግሰ፤","poem":2},{"text":"እን ቡቤሳ ከን ነመ ወጠሉን","poem":1},{"text":"ሀርከሳ ለገ ኤፍራጢስረ ሶቾሰ።","poem":2},{"text":"አከ ነሞትን ኮጴን ጬአኒፍስ","poem":1},{"text":"እን ለገ ቶርበት ገርገር እሰ ቆደ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አኩመ ጋፈ እሳን ግብጢ በአንእስራኤሊፍ ተኤ ሰነ፣","poem":1},{"text":"ሀምባ ሰበሳ ከን አሶርራ ሀፌፍ","poem":2},{"lineBreak":true},{"text":"ከራን ጉዳን ንአርገመ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/10.json","previousChapterAudioLinks":{},"numberOfVerses":16}