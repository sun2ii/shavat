{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["ፋርፈትና ገለታ"]},{"type":"verse","number":1,"content":["አት ጋፈስ አከነ ጄተ፦",{"text":"“ያ ዋቀዮ፣ አት ነት ኣርቴ ቱርቴ፤","poem":1},{"text":"ኣሪንኬስ ነራ ዴብኤረ፤","poem":2},{"lineBreak":true},{"text":"ነ ጀጀቤስቴርታቲ ስን ገለቴፈዸ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዹጉማን ዋቅን ፈይነኮት፤","poem":1},{"text":"አን እሰ ነንአብደዸ፤ ህንሶዳዹስ።","poem":2},{"text":"ዋቀዮ፣ ዋቀዮ መታንሳ፣","poem":1},{"text":"ጀብናፊ ፋርፈትናኮት፤እን ፈይነኮ ተኤረ።”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እስን ቡርቃ ፈይና ኬሳ","poem":1},{"text":"ገመቹዻን ብሻን ወራበቱ።","poem":2}]},{"type":"verse","number":4,"content":["እስን በረ ሰነ ኬሰ አከነ ጄቱ፦",{"text":"“ዋቀዮፍ ገለተ ገልቻ፤ መቃሳ ዋመዻ፤","poem":1},{"text":"ዋን እን ሆጄቴ ሰቦተት ቤክስሳ፤","poem":2},{"lineBreak":true},{"text":"አከ መቃንሳ ኦል ኦል ጄዼ ለለባ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እን ዋን ኡልፍነ ቀቡ ሆጄቴራቲ ዋቀዮን ፋርፈዻ፤","poem":1},{"text":"ወን ኩን አዱኛ ሁንደ ኬሰት ሃቤከሙ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ያ ሰበ ጥዮን፣ ቁልቁልች እስራኤልእስን ግዱት ጉዳዻቲ","poem":1},{"text":"ሰገሌ ኦል ፉዸዻቲ ገመቹዻን ፋርፈዻ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}