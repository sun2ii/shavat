{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":13,"content":[{"type":"heading","content":["ራጂ ባብሎኒን ሞርሙ"]},{"type":"verse","number":1,"content":["ራጂ ዋኤ ባብሎን ከን እሳያስ እልም አሞስ አርጌ፦"]},{"type":"verse","number":2,"content":[{"text":"ቱሉ ሆማ እት ህንብቅልንረት","poem":1},{"text":"ፋጂ ኦል ካሳቲ እሳንት እያ፤","poem":2},{"text":"አከ እሳን ከረ ነሞተ","poem":1},{"text":"ቤቤከሞቲን ኦል ገለኒፍ ሀርካን እት ህማ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አን ቁልቁሎተኮ አጀጄረ፤","poem":1},{"text":"አከ እሳን ዼከምሰኮ ሆጂረ ና ኦልቸኒፍ","poem":2},{"lineBreak":true},{"text":"አን ሎልቶተኮ ከኔን ሞአትኖኮት ገመደንዋመዼረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ወጨ ቱሉወንራ፣","poem":1},{"text":"ከን አከ ቱተ ጉዳ ቶኮ ዸጌፈዻ!","poem":2},{"text":"ጉንጉሚ ሞቱሞታ","poem":1},{"text":"ከን ሰቦተ ወልት ቀበመኒ ዸጌፈዻ!","poem":2},{"text":"ዋቀዮ ዋን ሁንደ ደንደኡ","poem":1},{"text":"ሎላፍ ጄዼ ሎልቶተ ቆጴፈቻ ጅረ!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እሳን ብየ ፈጎዻ","poem":1},{"text":"ዳሪ ሰሚወኒቲ ዹፈን፤","poem":2},{"text":"ዋቀዮፊ ምአ ሎላ ከን ዼከምሰሳቲን","poem":1},{"text":"ጉቱማ ብየቲ በሌሱፍ ዹፉ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ዋን ጉያን ዋቀዮ ዽኣቴፍ ቦኣ፤","poem":1},{"text":"ጉያን ሱን አኩመ በዲሰ","poem":2},{"lineBreak":true},{"text":"ዋቀ ዋን ሁንደ ደንደኡ ብራ ኤርገሜት ንዹፈ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ከናፉ ሀርክ ሁንድኑ ንላምሸአ፤","poem":1},{"text":"ኦኔን ነመ ሁንዳስ ንበቀ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሶዳን እሳን ቀበተ፤","poem":1},{"text":"ዹኩቢፊ ገድ እሳን ቀበተ፤","poem":2},{"lineBreak":true},{"text":"አኩመ ዱበርቲ ጭኒንሱን ቀቤት ውጥርፈቱ።","poem":2},{"text":"እሳን ርፈተኒ ወል እላሉ፤","poem":1},{"text":"ፉልሳኒ አከ እብዳ ዲመተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ኩኖ ጉያን ዋቀዮ፣","poem":1},{"text":"ጉያን ሀማን፣ ዼከምሳፊ ኣሪ ሶዳችሳዻን፣","poem":2},{"text":"ለፈ ኦንሱፊ ጩበሞተ እሼ ኬሰ ጅራተን","poem":1},{"text":"በርበዴሱፍ ንዹፈ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኡርጂወን ሰሚቲፊ ቱትንሳኒ","poem":1},{"text":"እፈሳኒ ህንኬነን።","poem":2},{"text":"አዱን ባቱ ንዱከኖፍት፤","poem":1},{"text":"ጅእስ እፈሼ ህንኬንቱ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አን አዱኛ ከነ ሰበቢ ጀልእነሳቲፍ፣","poem":1},{"text":"ሀሞተ ሰበቢ ጩቡሳኒቲፍ ነንአደበ።","poem":2},{"text":"አን ኦፍ ቱሉማ ኦፍ ጀጆታ ነንበሌሰ፤","poem":1},{"text":"ኦፍ ጉድሱ ገረ ጀቤዪሌ ገድን ዴብሰ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አን አከ ነምን ወርቄ ቁልቁሉ ጫላ ገት ቀቤሰ፣","poem":1},{"text":"ወርቄ ኦፊር ጫላስ ሙራሰ ተኡ ነንጎዸ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ከናፉ አን አከ ሰሚወን ሆለተን ነንጎዸ፤","poem":1},{"text":"ጋፈ ኣሪንሳ ቦበኡት","poem":2},{"text":"ዼከምሰ ዋቀዮ ዋን ሁንደ ደንደኡቲን","poem":1},{"text":"ለፍት እዶሼቲ ንራፈምት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ነምን ሁንድኑ አኩመ ኩሩጴ አደምሰምቱ፣","poem":1},{"text":"አኩመ ሆሎተ ትክሴ ህንቀብኔ","poem":2},{"text":"ገረ ሰበሳት ዴብአ፤","poem":1},{"text":"ነምን ከምዩ ብየሳት በቀተ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ነምን ቦጅአሜ ሁንድኑ ንወራነመ፤","poem":1},{"text":"ከን ቀበሜ ከምዩ ጎራዴዻን ዱአ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዳእመንሳኒ ፉሉመሳኒ ዱረት ንጭጭረሙ፤","poem":1},{"text":"መኔንሳኒ ንሳመሙ፤ኒቶትንሳኒስ ሁምናን ጉዴደሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ኩኖ አን ወረ ሜዴ","poem":1},{"text":"ከኔን ሜቲራ ዽመ ህንቀብኔ","poem":2},{"lineBreak":true},{"text":"ወረ ወርቄን ህንገመቺፍኔ ጀረትን ከካሰ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እዳንሳኒ ደርገጎተ ፍጥ፤","poem":1},{"text":"እሳን ዳእመኒፍ ህንነአን፤","poem":2},{"lineBreak":true},{"text":"እጆሌፍስ ገራ ህንላፈን።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ባብሎን ኡልፍን ሞቶታ፣","poem":1},{"text":"ሚዸግን ኦፍ ጀጀ ወረ ባብሎን","poem":2},{"text":"አኩመ ሶዶሚፊ ጎሞራ","poem":1},{"text":"እሬ ዋቃቲን ገረገልፈምት።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ነምን እሼ ኬሰ ህንቁበቱ፤","poem":1},{"text":"ዮካን ዸሎተ ሁንደ ኬሰትነምን እሼ ኬሰ ህንጅራቱ፤","poem":2},{"text":"ነምን አረባ ቶኮዩ ዱንካነሳ አች ህንዻበቱ፤","poem":1},{"text":"ትክሴን ቶኮዩ ቡሻዬሳ አች ህንቦቆቺፈቱ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ገሩ ብኔንሶትን ቦሶና አች ጭጪሱ፤","poem":1},{"text":"ዋንጎወን መነሼ ንጉቱ፤","poem":2},{"text":"ኡሩንጉን አች ጅራት፤","poem":1},{"text":"ሬኤን ዲዳ አች ኬሰ ቡቡራቅጥ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ወራቤስ ደአኖወንሼ ኬሳ ዩሰ፤","poem":1},{"text":"ዋንጎንስ መኔንሼ ምሚዸጎ ከን ሞቱማኬሳ እይት።","poem":2},{"text":"ዬሮንሼ ገኤረ፤","poem":1},{"text":"በርሼስ ህንዼረቱ።","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}