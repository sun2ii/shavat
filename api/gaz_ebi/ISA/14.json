{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"ዋቀዮ ያቆቢፍ ገራ ንላፈ፤","poem":1},{"text":"እን አመሌ እስራኤልን ፍለቴ","poem":2},{"lineBreak":true},{"text":"ብየሳኒ ኬሰ እሳን ቁበቺሰ።","poem":2},{"text":"ኦርሞትን እሳንት ደበለሙ፤","poem":1},{"text":"መነ ያቆብ ወጅንስ ቶኮ ተኡ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሰቦትን እሳን ፉዸቱ፤","poem":1},{"text":"እዶ ኦፊሳኒት እሳን ዴብሱ።","poem":2},{"text":"መን እስራኤልሞ አኩመ ሆጄቶተ ዺራፊ ዱበርቲት","poem":1},{"text":"ለፈ ዋቀዮ ኬሰት ዻለ ጎዸኒ እሳን ፉዸቱ።","poem":2},{"text":"እሳን ቦጅቶተሳኒ ቦጅአኒ","poem":1},{"text":"ወረ እሳን ሀጩጨንስ ቡልቹ።","poem":2}]},{"type":"verse","number":3,"content":["ጉያ ዋቀዮ እት ዽጵነ፣ ረክናፊ ሆጂ ሀማ እስን እት ገርቦምፈምተኒ ቱርተን ሰነ ጀላ እስን ቦቆቺሱት፣"]},{"type":"verse","number":4,"content":["አከነ ጄቴ ሞቲ ባብሎንት ንቆስተ፦",{"text":"ጩንቁርስች አከምት በዴ!","poem":1},{"text":"ኣሪንሳስ አከምት እሰራ ገሌ!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዋቀዮ ኡሌ ሀሞታቲፊ","poem":1},{"text":"ቦኩ ቡልችቶታ፣","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ከን ዼከምሰ ወልራ ህንጭኔቲን","poem":1},{"text":"ኡመተ ሩኩቴ፤","poem":2},{"text":"ከን ገረ ላፍነ ቶኮ መሌ አርኤ","poem":1},{"text":"ሰቦተ ዸኤ ሰነ ጨጨብሴረ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ለፍት ሁንድ ቦቆናፊ ነጋ አርገት፤","poem":1},{"text":"ፋርፈቹትስ ካት።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጋትራወኒፊ ብርብርሰወን","poem":1},{"text":"ልባኖንዩ እስንት ቡራቀኒ፣","poem":2},{"text":"“አመ አት ኩፍቴርተ፤","poem":1},{"text":"ነምን ቶኮዩ ኑ ሙሩፍ ህንዹፉ” ጄዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ሲኦል እሼን ገዲ ዬሮ አት ዹፍቱት ስ ስመቹፍ ካት፤","poem":1},{"text":"እሼን አከ እሳን ስ ዱብሰኒፍ ሀፉሮተ ወረ ዱአኒ፣","poem":2},{"text":"ወረ አዱኛረት ሆገንቶተ","poem":1},{"text":"ቱረኒ ሁንደ ደመቅስቴርት፤","poem":2},{"text":"እሼን ወረ ሞቶተ ሰቦታ ቱረን ሁንደ","poem":1},{"text":"ቴሶሳኒራ ካፍት።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እሳን ሁንድኑ ዴብሰኒ አከነ ጄዹ፤","poem":1},{"text":"“አትስ አኩመኬኘ ደዸብዴርተ፤","poem":2},{"lineBreak":true},{"text":"አኩመኬኘ ታቴርተ።”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኡልፍንኬ ሁንድኑ፣ ሰገሌ በገናኬቲ ወጅን","poem":1},{"text":"አዋለ ኬሰ ቡፈሜረ፤","poem":2},{"text":"እልማን ራሞ ስ ጀለ አፈመኒ","poem":1},{"text":"ራሞን ስ ሀጉግድ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ያ በከልቸ በሪ፣ እልመ በሪ በራቃ፣","poem":1},{"text":"አት አከምት ሰሚራ ለፈ ዾፍቴ!","poem":2},{"text":"አት ከን ዱራን ሰቦተ ገድ ቀብዴ፣","poem":1},{"text":"ለፈት ገድ ደርበተምቴርተ!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አት ገራኬት አከነ ጄቴ፤","poem":1},{"text":"“አን ሰሚት ኦልን በአ፤","poem":2},{"text":"አን ኡርጂወን ዋቃቲ ኦልት","poem":1},{"text":"ቴሶኮ ኦልን ባፈዸ፤","poem":2},{"text":"አን ቱሉ ወል ገኢረ፣","poem":1},{"text":"ፊጤ ቱሉ ቁልቁልቻረ ቴሶረ ነንታአ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አን ፊጤ ዱሜሶታ ገረራት ኦል ነንበአ፤","poem":1},{"text":"አን አከ ዋቀ ዋን ሁንዳ ኦሊ ኦፍን ታስሰ።”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ገሩ አት ሲኦል ኬሰ፣","poem":1},{"text":"ቦለ ቅሌ ኬሰ ቡፈምቴርተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ወር ስ አርገን እጀ በባሰኒ ስ እላሉ፤","poem":1},{"text":"አከነ ጄዸኒስ ድንቅሲፈቱ፦","poem":2},{"text":"“ኩን ነምቹመ ለፈ ሶቾሴ","poem":1},{"text":"አከ ሞቱሞን ራፈመን ጎዼ፣","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ነምቸ አዱኛ ከነ ገሞጂ ጎዼ፣","poem":1},{"text":"ከን መጋላወንሼ ገገረገልቼ","poem":2},{"lineBreak":true},{"text":"አከ ወር ቦጅአመን መነሳኒት ህንዴብኔ ጎዼ ሰና?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ሞቶትን ሰቦታ ሁንድ፣","poem":1},{"text":"ኡልፍናን አዋለሳኒ ኬሰ ጭጪሰኒሩ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አት ገሩ አኩመ ደሜ ጅበሜ ቶኮት፣","poem":1},{"text":"አዋለኬ ኬሳ ባፈምቴ ገተምቴርተ፤","poem":2},{"text":"አት ወረ አጄፈመኒን፣","poem":1},{"text":"ወረ ጎራዴን ወራነመኒን፣","poem":2},{"lineBreak":true},{"text":"ወረ ገረ ዸጋ ቦላት ገድ ቡአኒን ሀጉገምቴርተ።","poem":2},{"text":"አኩመ ሬፋ ሚላን ዽዺተምቴርተ፤","poem":1}]},{"type":"verse","number":20,"content":[{"text":"አት ሰበቢ ብየኬ በሌስቴ","poem":2},{"text":"ነሞተኬ ፍጤፍ፣","poem":1},{"text":"እሳን ግዱት ህንአዋለምቱ።","poem":2},{"lineBreak":true},{"lineBreak":true},{"text":"መቃን ሰኚ ሀሞታ","poem":1},{"text":"ለመተ ህንዸአሙ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሰበቢ ጩቡ አቦቲሳኒቲፍ","poem":1},{"text":"እዶ እልማንሳ እት ቀለመን ቆጴሳ፤","poem":2},{"text":"እሳን ብየ ዻሉዻፍ፣","poem":1},{"text":"መጋላወንሳኒቲንስ ለፈ ጉቱፍ ህንከአን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“አን እሳንት ነንከአ፣”","poem":1},{"text":"ጄዸ ዋቀዮ ዋን ሁንደ ደንደኡ።","poem":2},{"text":"“አን ባብሎን ኬሳ መቃሼቲፊ ሀምባሼ፣","poem":1},{"text":"እልማንሼቲፊ ሰኚሼ ነንበሌሰ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"“አን እዶ ኡሩንጉን ኬሰ ጅራቱፊ","poem":1},{"text":"ለፈ ጨፌ እሼ ነንጎዸ፤","poem":2},{"text":"አን ሀርቱ በዲሳቲን እሼ ነንሀጣአ”","poem":1},{"text":"ጄዸ ዋቀዮ ዋን ሁንደ ደንደኡ።","poem":2}]},{"type":"heading","content":["ራጂ አሶሪን ሞርሙ"]},{"type":"verse","number":24,"content":["ዋቀዮ ዋን ሁንደ ደንደኡ አከነ ጄዼ ከከቴረ፤",{"text":"“ዹጉማን አኩመ አን ዱራን ከሮርፈዼ ሰነወን ኩን ንተአ፤","poem":1},{"text":"አኩመ አን ያዴ ሰነስ ንዻበተ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"አን ብየኮ ኬሰት አሶሮተ ነንበርበዴሰ፤","poem":1},{"text":"ቱሉወንኮረት አን እሰ ገድን ዽዺተ።","poem":2},{"text":"ዋንጆንሳ ሰበኮራ ንፉዸመ፤","poem":1},{"text":"በኣንሳስ ገቲቲሳኒራ ንቡአ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ከሮር ጉቱማ አዱኛቲፍ ሙርታኤ ከናዸ፤","poem":1},{"text":"ኩን ሀርከ ሰቦተ ሁንደረት ድሪርፈሜዸ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ዋቀዮ ዋን ሁንደ ደንደኡ","poem":1},{"text":"ዋን ከነ ያዴራቲ፣ ኤኙቱ እሰ ገረ ገልቸ?","poem":2},{"text":"ሀርክሳ ድሪርፈሜራ፤","poem":1},{"text":"ኤኙቱ ዱበት እሰ ዴብሱ ደንደአ?","poem":2}]},{"type":"heading","content":["ራጂ ፍልስጤሞታን ሞርሙ"]},{"type":"verse","number":28,"content":["ራጂን ኩን በረ ኣሃዝ ሞትች ዱኤ ኬሰ ዹፌ፦"]},{"type":"verse","number":29,"content":[{"text":"ያ ፍልስጤሞተ፣ ኡሌን እስን ዸኤ ዋን ጨቤፍ፣","poem":1},{"text":"እስን ሁንድኑ ህንገመድና፤","poem":2},{"text":"ህደ ቦፈ ሰና ኬሳ ቡቲቱ በአ፤","poem":1},{"text":"እጅሳ ቦፈ ደርበተማ ሱሚ ቀቡ ንተአ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ህዬስ ገደደማን እዶ እት ቦበኡ አርገተ፤","poem":1},{"text":"ረከታንስ ነጋዻን ጪሰ።","poem":2},{"text":"ህደኬ ገሩ አን ቤላን ነንበርበዴሰ፤","poem":1},{"text":"ቤልስ ሀምባኬ ንፍጠ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"ያ ከረ፣ አት ቦእ! ያ መጋላ፣ እይ!","poem":1},{"text":"ፍልስጤሞትን ሁንድ በቃቲ በዳ!","poem":2},{"text":"ዱሜስ ኣራ ቶኮ ከራ ካባቲን ንዹፈ፤","poem":1},{"text":"ራያ ወራነሳ ኬሰስ ከን ጭቴ ሀፉ ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ኤርገሞተ ሰበ ሰናቲፍ","poem":1},{"text":"ዴቢ አከሚቱ ኬነሙ መለ?","poem":2},{"text":"“ዋቀዮ ጀቤሴ ጥዮንን ዻቤረ፤","poem":1},{"text":"እሼ ኬሰትስ ነሞትንሳ ከኔን ሚዸመንደአትኖ ንአርገቱ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/13.json","previousChapterAudioLinks":{},"numberOfVerses":32}