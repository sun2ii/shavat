{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":15,"content":[{"type":"heading","content":["ራጂ ሞኣቢን ሞርሙ"]},{"type":"verse","number":1,"content":["ራጂ ዋኤ ሞኣብ፦",{"text":"ኣር እሼን ሞኣብ ኬሳ ዲገምቴርት፤","poem":1},{"text":"ሀልከኑመ ቶኮትስ በዴርት!","poem":2},{"text":"ቂር እሼን ሞኣብ ኬሳ ዲገምቴርት፤","poem":1},{"text":"ሀልከኑመ ቶኮትስ በዴርት!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዲቦን ገረ መነ ቁልቁሉማት፣","poem":1},{"text":"እዶወን ኦል ከኣት ቦኡፍ ኦል በአ፤","poem":2},{"lineBreak":true},{"text":"ሞኣብስ ኔቦፊ ሜዴባፍ ንቦአ።","poem":2},{"text":"መታን ሁንድኑ ሃደማዸ፤","poem":1},{"text":"አሬድን ሁንድኑስ ጭጭረማዸ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እሳን ዳንዲረት ወያ ገዳ ኡፈቱ፤","poem":1},{"text":"በንቲ መናቲፊ ወልተጂ ሰባረት","poem":2},{"text":"ሁንድሳኒ ንቦኡ፤","poem":1},{"text":"እምማንሳኒስ ንዸንገላሱ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሄሽቦኒፊ ኤሌኣሌን ንእዩ፤","poem":1},{"text":"ሰገሌንሳኒስ ሀመ ያሀዚት ፈጋቴ ዸገአሜ።","poem":2},{"text":"ከናፉ ሎልቶትን ሞኣብ ንእዩ፤","poem":1},{"text":"ሉቡንሳኒስ ንሮምእቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ገራንኮ ሞኣቢፍ እየ፤","poem":1},{"text":"ኮሉ ገልቶትንሼ ሀመ ዞኣሪት፣","poem":2},{"lineBreak":true},{"text":"ሀመ ኤግላት ሼልሽያት በቀቱ።","poem":2},{"text":"እሳን ቦኣ፣ ገረ ሉሂትት ኦል በኡ፤","poem":1},{"text":"ከራ ሆሮናይምረትስ፣","poem":2},{"lineBreak":true},{"text":"ዋኤ በዲሳኒ ፋርሰኒ ቦኡ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ብሻኖትን ኒምሪም ጎገኒሩ፤","poem":1},{"text":"መርግስ ጮለጌረ፤","poem":2},{"text":"ብቅልቱወን ለፋ በደኒሩ፤","poem":1},{"text":"ወን መገሪስን ቶኮዩ ህንሀፍኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ከናፉ እሳን ቀቤኘ አርገተኒ ኩፈተን ሰነ","poem":1},{"text":"ለገ አለልቱ እራን ባተኒ ደበርፈቱ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እይሳኒ ሀመ ዳሪ ሞኣብት ዸገአሜ፤","poem":1},{"text":"ወዋቹንሳኒ ሀመ ኤግለዪምት","poem":2},{"lineBreak":true},{"text":"ፋሩን ቦእቸሳኒስ ሀመ ቤኤር ኤሊሚንት ዸገአሜ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ብሻኖትን ዲሞን ዺጋን ጉተመኒሩ፤","poem":1},{"text":"አንሞ ዋን ከነ ጫሉዩ ዲሞንት ነንፍደ፤","poem":2},{"text":"ወረ ሞኣብ ኬሳ በቀተን","poem":1},{"text":"ከኔን ብየ ሰነት ሀፈንት ሌንጨ ነንኤርገ።","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}