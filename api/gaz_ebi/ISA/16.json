{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"ሴላ፣ ገሞጂ ገመ ጅርቱ ሰነራ","poem":1},{"text":"ቡልቻ ብየቲቲፍ፣","poem":2},{"text":"ገረ ቱሉ እንተለ ጥዮንት","poem":1},{"text":"ጦባላወን ሆላ ግብረ ኤርጋ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አኩመ ስምብረ መንኤሼ ኬሳ አርአምቴ","poem":1},{"text":"አሲፊ አች ፊግዱ ዱበርቶትን ሞኣብስ","poem":2},{"lineBreak":true},{"text":"መልካ ለገ አርኖንት አከሱመ ተኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“ጎርሰ ኑፍ ኬና፤ ሙርቲ ሙርቴሳ።","poem":1},{"text":"ጉያ ሳፋዻን ጋድዱኬሰን","poem":2},{"lineBreak":true},{"text":"አኩመ ሀልከኒ ዱከኔሳ።","poem":2},{"text":"በቀቶተስ ዾክሳ፤","poem":1},{"text":"ኮሉ ገልቶተ ህንገንና።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"በቀቶትን ሞኣብ እስን ወጅን ሃጅራተን፤","poem":1},{"text":"በሌስቱራ ደኦ እሳኒፍ ተኣ።”","poem":2},{"lineBreak":true},{"text":"ጩንቁርሳን ንበደ፤","poem":1},{"text":"በዲስንስ ንሀፈ፤","poem":2},{"lineBreak":true},{"text":"ወር ነመ ሚዸን ለፈራ በዱ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ቴሶን ጃለላን ሁንዴፈመ፤","poem":1},{"text":"መነ ዳዊት ኬሳ ነምን ሙርቲ ኬኑረት","poem":2},{"lineBreak":true},{"text":"ሙርቲ ቀጄላ በርባዱ፣","poem":2},{"text":"ከን ዋን ቀጄላ ሆጄቹፍ አሪፈቱ ቶኮ","poem":1},{"text":"አመነሙማዻን ቴሶ ሰነረ ንታአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ኑ ኦፍ ቱሉማ ሞኣብ፣","poem":1},{"text":"ኦፍ ጉድሱፊ ኮሩሼ፣","poem":2},{"text":"ኦፍ ቱሉፊ አደጌ ተኡሼ ዸጌኜረ፤","poem":1},{"text":"ኦፍ ጀጁንሼ ገሩ ፋይዳ ህንቀቡ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ከናፉ ሞኣቦን ንቦኡ፤","poem":1},{"text":"እሳን ቶኩማዻን ሞኣቢፍ ቦኡ።","poem":2},{"text":"ነሞተ ቂር ሀሬሼቲፍ","poem":1},{"text":"ፋርሰኒ ቦኡዻን ገዱ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ለፍት ቆቲሳ ሄሽቦን፣","poem":1},{"text":"ሙክን ወይኒ ስብማስ ጮለጌረ።","poem":2},{"text":"ቡልችቶትን ሰቦታ","poem":1},{"text":"ሙኬን ወይኒ ፍለተሞ","poem":2},{"text":"ከኔን ዱራን የእዜርን ገአኒ","poem":1},{"text":"ገረ ገሞጂት በበልአተን ዽዺተኒሩ።","poem":2},{"lineBreak":true},{"text":"ለታንሳኒ ዼረቴ ሀመ ገላናት ድሪሬ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ከናፉ አን አኩመ የእዜር ቦሴ ሰነ፣","poem":1},{"text":"ሙኬን ወይኒ ስብማቲፍ ነንቦአ።","poem":2},{"text":"ያ ሄሽቦን፣ ያ ኤሌኣሌ፣","poem":1},{"text":"አን እምማንኮቲን ስን ጂሰ!","poem":2},{"text":"እልሌን ዬሮ ምዻን ሲፍ ገኤቲፊ","poem":1},{"text":"ገመቹን ዬሮ ምዻን ሲፍሃመሙ ቱሬ ሱን ሀፌረ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እልልቹፊ ገመዱን እዶ ብቅልቱ ኬሳ በደኒሩ፤","poem":1},{"text":"ነምን ቶኮዩ እዶ ዻባ ወይኒ ኬሰትህንፋርፈቱ ዮካን ህንእልልቹ፦","poem":2},{"text":"ሰበቢ አን እልሌ በሌሴፍ","poem":1},{"text":"ነምን እዶ ወይኒ እት ጩንፈንት ወይኒ ዽዺቱ ቶኮ ህንጅሩ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ገራንኮ አኩመ በገና ፋርሴ ሞኣቢፍ ቦአ፤","poem":1},{"text":"ኬስኮስ ቂር ሀሬሼቲፍ ቦአ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሞኣብ ዮ እዶ ኦል ከኣት ሙልአቴ፣","poem":1},{"text":"እሼን ኦፉመ ደዸብሲፍት፤","poem":2},{"text":"ዮ ከዸናፍ ገረ እዶ ቁልቁሉሼ ዸቅጤ","poem":1},{"text":"ኩንስ ፋይዳ ቶኮሌ ህንቀቡ።","poem":2}]},{"type":"verse","number":13,"content":["ኩን ዱቢ ዋቀዮ ዱራኑ ዋኤ ሞኣብ ዱበቴዸ።"]},{"type":"verse","number":14,"content":["ዋቀዮ ገሩ አመ አከነ ጄዸ፦ “ወጋ ሰዲ ኬሰት፣ ኡልፍን ሞኣቢፊ ነሞትንሼ ሄዱን ሁንድ አኩመ ሆጄታን ቶኮ ጉያሳ ለካአቱ ሰነ ንቱፈተሙ፤ ከኔን ሀፈንስ አከ መሌ ሙራሳፊ ደዸቦ ተኡ።”"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/15.json","previousChapterAudioLinks":{},"numberOfVerses":14}