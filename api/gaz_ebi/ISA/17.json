{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":17,"content":[{"type":"heading","content":["ራጂ ደማስቆዻን ሞርሙ"]},{"type":"verse","number":1,"content":["ራጂ ደማስቆዻን ሞርሙ፦",{"text":"“ኩኖ፣ ደማስቆን ቱላ ዲገምቴ ታት መሌ","poem":1},{"text":"ስአች መጋላ ህንታቱ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"መጋላወን አሮኤር ንኦኑ፤","poem":1},{"text":"ቡሻዬን አች ጭጪሱ፤","poem":2},{"lineBreak":true},{"text":"ወን እሳን ሶዳችሱ ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"መጋላን ጀቤፈምቴ እጃረምቴ ኤፍሬም ኬሳ፣","poem":1},{"text":"ሁምን ሞቱማስ ደማስቆ ኬሳ ንበደ፤","poem":2},{"text":"ሀምባን ሶርያ አከ ኡልፍነ እስራኤሎታ ተአ”","poem":1},{"text":"ጄዸ ዋቀዮ ዋን ሁንደ ደንደኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“በረ ሰነ ኬሰ ኡልፍን ያቆብ ገድ ዴብአ፤","poem":1},{"text":"ፉርድን ዸግነሳስ ንሁቀተ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አኩመ ነምን ምዻን ሃሙ ቶኮ፣","poem":1},{"text":"ምዻን ዻበቱ ወልት ቀቤ እሬሳቲን ሃሙ ሰነ","poem":2},{"text":"ኩንስ አኩመ ዬሮ ነምን ቶኮ","poem":1},{"text":"ሱሉለ ሬፋይም ኬሳ ቀርሚ ፉናኑ ንተአ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ተኡስ አኩመ ዬሮ ሙክን ኤጄርሳ ዸአሙት፣","poem":1},{"text":"ቀርሚ ጉሩን አመዩ ጅረ፤","poem":2},{"text":"ፊጤ ኦል ኣኑረት ጉማ ለመ ዮካን ሰዲቱ ሀፈ፤","poem":1},{"text":"ደሜ ገድ ኣኑረት ጉማ አፉር ዮካን ሸንቱ ሀፈ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ፣ ዋቅን እስራኤል።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ጋፈስ ነሞትን ገረ ኡማሳኒ እላሉ፤","poem":1},{"text":"እጀሳኒስ ገረ ቁልቁልቸ እስራኤል ዴብፈቱ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እሳን ገረ እዶ ኣርሳ፣","poem":1},{"text":"ገረ ሆጂ ሀርከሳኒ ህንእላለን፤","poem":2},{"text":"እሳን ገልመ ዋቄፈትና ኣሼራ፣","poem":1},{"text":"እዶ ኣርሳ እጣና ከን ቁበሳኒቲን ቶልቸንስወይቱ ህንለካአን።","poem":2}]},{"type":"verse","number":9,"content":["ጋፈስ መጋላወን ጀጀቦን እሳን ሰበቢ እስራኤሎታቲፍ ኬሳ በአን ሱን አኩመ ለፈ ቦሶነ ኬሳ ከን ነምን ዺሴ ዴሜ ተኡ። ሁንድ ንኦኑ።"]},{"type":"verse","number":10,"content":[{"text":"አት ፈይሳኬ፣ ዋቀ እራንፈቴርተ፤","poem":1},{"text":"አት ከታ፣ ደኦኬ ህንያደትኔ።","poem":2},{"text":"ከናፉ ዮ ብቅልቱ አከ መሌ ጋሪ ዻበቴ","poem":1},{"text":"ሙከ ወይኒ ከን አላ ዹፌ ብቅልፈቴዩ፣","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዮ ጉዩመ ዻብዴ ሰነ አከ እን ብቅሉ ጎቴዩ","poem":1},{"text":"ገነመ ዬሮ ዻብዴት አከ እን ደራሩ ጎተ፤","poem":2},{"text":"ገሩ ጉያ ዹኩባፊ ዽቤ ህንፈይኔት","poem":1},{"text":"ወይንች ሆማ ህንፈየዱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ሰቦተ ባይኤ ከኔን ኣረኒፍ ወዮ!","poem":1},{"text":"እሳን አኩመ ገላነ ኣሩት ኣሩ!","poem":2},{"text":"ሰቦተ ወጨኒፍ ወዮ!","poem":1},{"text":"እሳን አኩመ ብሻን ጉዳን ሁርሱት ሁርሱ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሰቦትን አኩመ ሁርሳ ብሻን ጨብሴ ዴሙ","poem":1},{"text":"ዮ ሁርሴዩ ዮሙ እን እሳንት ዼከሙእሳን በቀተኒ በዱ፤","poem":2},{"text":"አኩመ ሀበቂን ቱሉራ ፉለ ቡቤ ዱረ አርአሙ፣","poem":1},{"text":"አኩመ አዋር ፉለ ቡቤ ሀማ ዱራ ብትናኡእሳን ንብትናኡ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ገልገለ ሶዳን አኩመ ተሳ እሳን ቀበት!","poem":1},{"text":"እሳን ኡቱ ለፍት ህንበርእን ንዸበሙ!","poem":2},{"text":"ኩን ቆደ ወረ ኑ ቦጅኤ፣","poem":1},{"text":"ህሬ ወረ ኑ ሳሜት።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/16.json","previousChapterAudioLinks":{},"numberOfVerses":14}