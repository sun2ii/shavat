{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":18,"content":[{"type":"heading","content":["ራጂ እቶጵያዻን ሞርሙ"]},{"type":"verse","number":1,"content":[{"text":"ብየ ለጌን እቶጵያቲን ገማ","poem":1},{"text":"ከን ቆቾሼቲን ሻክፍቱፍ ወዮ፤","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እሼን ገላነረ፣","poem":1},{"text":"ብድሩ ዸላዱቲን ኤርገሞተ ብሻንረ ኤርግት።","poem":2},{"lineBreak":true},{"text":"ያ ኤርገሞተ አሪፈቶተ፣","poem":1},{"lineBreak":true},{"text":"ገረ ሰበ ዼዼሮ ከኔን ጎጋንሳኒ ለላፉ፣","poem":1},{"text":"ገረ ሰበ ፈጎፊ ዽኦትስ ሶዳተሙ፣","poem":2},{"text":"ሰበ ጀባፊ አፋንሳ ህንቤከምኔ","poem":1},{"text":"ከን ብይሳኒ ለጌኒን ገርገር ቆደምቴ ሰና ዸቃ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"እስን ኡመትን አዱኛ ሁንድ፣","poem":1},{"text":"ወር ለፈረ ጅራተን ዬሮ መለቶን ጋረረትኦል ቀበሙ ንአርግቱ፤","poem":2},{"lineBreak":true},{"text":"ዬሮ መለከትን አፉፈሙስእኑመ ዸጌሱ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዋቀዮ አከነ ናን ጄዼ፦","poem":1},{"text":"“አን አኩመ ሆአ እፈ አዱ ኬሰት ጨለቅሱ፣","poem":2},{"text":"አኩመ ዱሜሰ ፍጤንሳ ከን ሆአ ዬሮ ምዻን ገልቸኒት","poem":1},{"text":"ጨልእሴ እዶ ጅሬኘኮቲ ነንእላለ።”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሃማ ምዻኒቲን ዱረ፣ ዬሮ ሁዻን ደራሬ","poem":1},{"text":"ደራራን ሱንስ እጀ ወይኒ ብልቻቴ ተኡት","poem":2},{"text":"እን ብላ እቲን ቆረኒን ለታሳ ንጭጭረ፤","poem":1},{"text":"ደሜ በበልአቴስ እራ ሙርሙሬ ንበሌሰ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እሳን ሁንድኑ አላቲ ቱሉ ከን ዋ አደምሱፊ","poem":1},{"text":"ብኔንሶተ ቦሶናቲፍ ዺፈሙ፤","poem":2},{"text":"አላቲን ቦነ ጉቱ፣","poem":1},{"text":"ብኔንሶትን ቦሶናስ ገነ ጉቱ እሳን ኛቱ።","poem":2}]},{"type":"verse","number":7,"content":["ጋፈስ ሰበ ዼዼሮ ከኔን ጎጋንሳኒ ለላፉራ፣",{"text":"ሰበ ፈጎፊ ዽኦትስ ሶዳተሙራ፣","poem":1},{"text":"ሰበ ጀባፊ አፋንሳ ህንቤከምኔ","poem":2},{"text":"ከን ብይሳኒ ለጌኒን ገርገር ቆደምቴራ","poem":1},{"text":"ዋቀዮ ዋን ሁንደ ደንደኡፍ ኬናን ንፍደመ፤","poem":2},"ኬናን ሱንስ ገረ ቱሉ ጥዮን፣ እዶ መቃን ዋቀዮ ዋን ሁንደ ደንደኡ ጅራቱት ንፍደመ።"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/17.json","previousChapterAudioLinks":{},"numberOfVerses":7}