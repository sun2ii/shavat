{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":19,"content":[{"type":"heading","content":["ራጂ ግብጢን ሞርሙ"]},{"type":"verse","number":1,"content":["ራጂ ግብጢን ሞርሙ፦",{"text":"ኩኖ ዋቀዮ ዱሜሰ","poem":1},{"text":"ሰፍሳ ያበቴ ገረ ግብጥ ዹፋ ጅረ።","poem":2},{"text":"ዋቆትን ግብጥ ቶልፈሞን ፉለሳ ዱረት ሆለቱ፤","poem":1},{"text":"ገራን ወረ ግብጥስ እሳን ኬሰት በቀ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“አን ወረ ግብጥ ወልት ነንነቀ፤","poem":1},{"text":"ኦቦሌስ ኦቦሌሰሳ፣ ኦላን ኦላሳ፣","poem":2},{"lineBreak":true},{"text":"መጋላን ቶኮ መጋላ ካን፣","poem":2},{"lineBreak":true},{"text":"ሞቱማንስ ሞቱማ ካን ሎለ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሀፉር ወረ ግብጥ እሳን ኬሰት ጄቀመ፤","poem":1},{"text":"አንስ ከሮረሳኒ ነንፈሸሌሰ፤","poem":2},{"text":"እሳንስ ዋቆተ ቶልፈሞፊ ሀፉሮተ ወረ ዱአኒ፣","poem":1},{"text":"እላልቶታፊ ኤኬር ዱብስቶተ ጎርሰ ጋፈቱ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አንስ ደበርሴ ወረ ግብጥ","poem":1},{"text":"ሁምነ ጎፍታ ገራ ጀባቱ ቶኮት ነንኬነ፤","poem":2},{"text":"ሞቲን ሀማን ቶኮስ እሳን ንቡልቸ” ጄዸ ጎፍታን፣","poem":1},{"text":"ዋቀዮ ዋን ሁንደ ደንደኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ብሻኖትን ገላና ንጎጉ፤","poem":1},{"text":"ለግንሳስ ንህርአተ፤ ንጎገስ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ቡርቃወንሳ ንአጃኡ፤","poem":1},{"text":"ለጌን ግብጢስ ቀልአተኒ ጎጉ።","poem":2},{"text":"ሸምበቆፊ ዸላዱን ንጮለጉ፤","poem":1}]},{"type":"verse","number":7,"content":[{"text":"ብቅልቱወን ኤዴደ አበያ፣","poem":2},{"lineBreak":true},{"text":"ከኔን ቀርቀረ ለግቻ ጅረንስ ንጮለጉ።","poem":2},{"text":"ወን ለገ አበያ ብረት ፈጫፈሜ ሁንድ ንጎገ፤","poem":1},{"text":"ቡቤዻን ፉዸተመ፤ ዴብኤስ ህንአርገሙ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ቁርጡሚ ቀብዶትን፣","poem":1},{"text":"ወር ሆኮ አበያ ኬሰ ቡሰንሁንድ ኣደኒ ቦኡ፤","poem":2},{"lineBreak":true},{"text":"ወር ክዮ ብሻንት ደርበተንስ ንደዸቡ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ወር ቁንጬ ተልባ እደሜ ቆጴሰን፣","poem":1},{"text":"ወያ ዾፍቶትንስ አብዲ ኩተቱ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ወር ወያ ዸአን መታ ቡሱ፤","poem":1},{"text":"ወር ምንዳዻን ሆጄተን ሁንድስ ንገዱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ቆንዳልቶትን ዞኣን ጎዎተ፤","poem":1},{"text":"ጎርስቶትን ፈረኦን ኦጌዪንስጎርሰ ፋይዳ ህንቀብኔ ኬኑ።","poem":2},{"text":"እስን አከምት ፈረኦኒን፣","poem":1},{"text":"“አን ነሞተ ኦጌዪ ኬሳ ቶኮዸ፤","poem":2},{"lineBreak":true},{"text":"አን በረታ ሞቶተ ዱሪት” ጄቹ ደንዴሱ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ነሞትንኬሰን ኦጌዪን አመ ኤሰ ጅሩ?","poem":1},{"text":"ሜ እሳን ዋን ዋቀዮ ዋን ሁንደ ደንደኡ","poem":2},{"text":"ግብጢን ሞርሙዻን ከሮርፈቴ፤","poem":1},{"text":"እስንት ሃህመን፤ ሃቤክስሰንስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ቆንዳልቶትን ዞኣን ጎዎተ ተአኒሩ፤","poem":1},{"text":"ቡልችቶትን ሜምፊስ ጎዎምፈመኒሩ፤","poem":2},{"text":"ጉርጉዶትን ሰበሼ","poem":1},{"text":"ግብጢን ከራራ ጀልእሰኒሩ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዋቀዮ ሀፉረ ነመ ሀዶቹ እሳንት ዸንገላሴረ፤","poem":1},{"text":"እሳን አኩመ መቻኣን ቶኮ ሆቅሳ ገተንተሩ ሰነ","poem":2},{"lineBreak":true},{"text":"ብየ ግብጥ ዋን እሼን ሆጄቱ ሁንደ ኬሰትገተንተርሰን።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ወን መታን ዮካን ኤጌን፣ ደሜን ሜጢዮካን ሸምበቆን፣","poem":1},{"text":"ግብጢፍ ጎቹ ደንደአን ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"verse","number":16,"content":["በረ ሰነ ወር ግብጥ አከ ዱበርቲ ተኡ። ሀርከ ኦል ከኤ ከን ዋቀዮ ዋን ሁንደ ደንደኡ እሳንት ኦል ፉዸቱ ሰነ አርገኒ ሶዳን ንሆለቱ።"]},{"type":"verse","number":17,"content":["ብይ ይሁዳስ ወረ ግብጥ ንናስሰ፤ ነምን መቃን ይሁዳ ብረት ዸአሙ ሁንድኑ ሰበቢ ዋን ዋቀዮ ዋን ሁንደ ደንደኡ እሳንት ከሮርፈቻ ጅሩ ሰናቲፍ ንነአ።"]},{"type":"verse","number":18,"content":["ጋፈስ ብየ ግብጥ ኬሰት መጋላወን ሸን አፋን ከነኣን ዱበቱ፤ እሳንስ ዋቀዮ ዋን ሁንደ ደንደኡፍ አመነሞ ተኡፍ ንከከቱ። እሳን ኬሳ ቶኮ መጋላ በዲሳ ጄዸምት።"]},{"type":"verse","number":19,"content":["ጋፈስ ዊርቱ ግብጥ ኬሰት እዶን ኣርሳ ቶኮ ዋቀዮፍ ንሆጄተመ፤ ዳንጋ ብየቲረትስ ሲዳን ቶኮ ዋቀዮፍ ንዻበመ።"]},{"type":"verse","number":20,"content":["ኩንስ ብየ ግብጥ ኬሰት ዋቀዮ ዋን ሁንደ ደንደኡፍ መለቶፊ ዹገ በኡምሰ ተአ። ዬሮ እሳን ሰበቢ ጩንቁርስቶተሳኒቲፍ ገረ ዋቀዮት እየተንት፣ እን ፈይሳፊ በራራ ቶኮ ኤርጌፊ እሳን ኦልቸ።"]},{"type":"verse","number":21,"content":["ከናፉ ዋቀዮ ወረ ግብጥት ኦፍ ቤክስሰ፤ እሳንስ ጋፈስ ዋቀዮን ንቤኩ። እሳንስ ቀልማፊ ኬና ምዻኒቲን ዋቄፈቱ፤ ዋቀዮፍስ ንወሬጉ፤ ወሬገ ሰነስ ንባፈቱ።"]},{"type":"verse","number":22,"content":["ዋቀዮ ብየ ግብጥ ንሩኩተ፤ ሩኩቴስ ንፈይሰ። እሳን ገረ ዋቀዮት ንዴብኡ፤ እንስ ከዸትናሳኒቲፍ ዴቢ ኬኔ እሳን ፈይሰ።"]},{"type":"verse","number":23,"content":["ጋፈስ ግብጢ ሀመ አሶርት ከራ ጉዳ ቶኮቱ ጅራተ። ወር አሶር ገረ ግብጥ፣ ወር ግብጥስ ገረ አሶር ንዸቁ። ወር ግብጢፊ ወር አሶር ወሊ ወጅን ንዋቄፈቱ።"]},{"type":"verse","number":24,"content":["እስራኤል በረ ሰነ ኬሰ ግብጢፊ አሶርት ደበለምቴ ሰደፋ ታት፤ ኩንስ ለፈረት ኤበ ተአ።"]},{"type":"verse","number":25,"content":["ዋቀዮ ዋን ሁንደ ደንደኡስ፣ “ግብጥ ሰብንኮ፣ አሶር ሆጂን ሀርከኮቲፊ እስራኤል ዻልኮ ሃኤብፈመን” ጄዼ እሳን ኤብሰ።"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/18.json","previousChapterAudioLinks":{},"numberOfVerses":25}