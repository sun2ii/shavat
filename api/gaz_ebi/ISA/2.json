{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":2,"content":[{"type":"heading","content":["ቱሉ ዋቀዮ"]},{"type":"verse","number":1,"content":["ወን እሳያስ እልም አሞስ ዋኤ ይሁዳቲፊ ዬሩሳሌም አርጌ ከናዸ፦"]},{"type":"line_break"},{"type":"verse","number":2,"content":["በረ ዹማ ኬሰ፣",{"text":"ቱሉን መነ ቁልቁሉማ ዋቀዮ","poem":1},{"text":"ቱሉወን ሁንደ ኬሳ ኦል ዼረቴ ዻበተ፤","poem":2},{"text":"እን ቱሉወን ጫላ ኦል ኦል ጄዸ፤","poem":1},{"text":"ሰቦትን ሁንድኑ ገረሳት ያኡ።","poem":2}]},{"type":"verse","number":3,"content":["ነሞትን ባይኤን ዹፈኒ አከነ ጄዹ፤",{"text":"“ኮታ ገረ ቱሉ ዋቀዮ፣","poem":1},{"text":"ገረ መነ ዋቀ ያቆብት ኦል ባና።","poem":2},{"text":"እን አከ ኑ ዳንዲሳረ ዴምኑፍ","poem":1},{"text":"ከራሳ ኑ በርሲሰ።”","poem":2},{"text":"ሴር ጥዮን ኬሳ፣","poem":1},{"text":"ዱቢን ዋቀዮሞዬሩሳሌም ኬሳ ንበአ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እን ሰቦተ ግዱት ሙርቲ ኬነ፤","poem":1},{"text":"ነሞተ ሄዱዻፍስ ንሙርቴሰ።","poem":2},{"text":"እሳን ጎራዴሳኒ ቱመኒ ማረሻ ቶልፈቱ፤","poem":1},{"text":"ኤቦሳኒስ ቱመኒ ሃምቱ ቶልፈቱ።","poem":2},{"text":"ሰብን ቶኮ ሰበ ብራት ጎራዴ ህንሉቅፈቱ፤","poem":1},{"text":"ዮካን ሎላፍ ነመ ህንሌንጅፈተን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ያ መነ ያቆብ፣","poem":1},{"text":"ኮታ እፈ ዋቀዮ ኬሰ ዴዴብና።","poem":2}]},{"type":"heading","content":["ጉያ ዋቀዮ"]},{"type":"verse","number":6,"content":[{"text":"ከናፉ ሰበኬ፣","poem":1},{"text":"መነ ያቆብ ዺፍቴርተ።","poem":2},{"text":"እሳን በርቴ በአ ቢፍቱቲን ጉተመኒሩ፤","poem":1},{"text":"አኩመ ፍልስጤሞታ ፈልፈለ ሆጄቱ፤","poem":2},{"lineBreak":true},{"text":"ዱዻ ነሞተ ኦርማትስ ንጭቹ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ብይሳኒ ሜቲፊ ወርቄን ጉተምቴርት፤","poem":1},{"text":"ቀቤኝሳኒ ዹመ ህንቀቡ።","poem":2},{"text":"ብይሳኒ ፈርዴኒን ጉተምቴርት፤","poem":1},{"text":"ጋሪወንሳኒስ ዹመ ህንቀበን።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ብይሳኒ ዋቆተ ቶልፈሞዻን ጉተምቴርት፤","poem":1},{"text":"እሳን ሆጂዹመ ሀርከሳኒ፣","poem":2},{"lineBreak":true},{"text":"ዋኑመ ቁብንሳኒ ቶልቼፍ ሰገዱ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ከናፉ ነምን ገድ ቀበመ፤","poem":1},{"text":"እልማን ነማ ገድ ዴብፈሙ፤","poem":2},{"lineBreak":true},{"text":"አት እሳኒፍ ህንዺስን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"አርገሙ ዋቀዮ እሰ ሶዳችሳፊ","poem":1},{"text":"ሱራ ኡልፍነሳ ዱራ፣ ከታ ኬሰ ልጡ፤","poem":2},{"lineBreak":true},{"text":"ለፈ ኬሰስ ዾከዹ!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እጅ ነመ ኦፍ ቱሉ ገድ ቀበመ፤","poem":1},{"text":"ኦፍ ጀጁን ነሞታስ ገድ ዴብፈመ፤","poem":2},{"text":"ጋፈስ ዋቀዮ ቆፈቱ ኦል ኦል ጄዸ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ዋቀዮ ዋን ሁንደ ደንደኡ","poem":1},{"text":"ወረ ኦፍ ጀጁፊ ወረ ኦፍ ቱሉ ሁንዳፍ፣","poem":2},{"text":"ወረ ኦል ኦል ጄዸን ሁንዳፍ ጉያ ቶኮ ቀበ፤","poem":1},{"text":"እሳንስ ገድ ዴብፈሙ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እን ብርብርሰ ልባኖን ዼራፊ","poem":1},{"text":"ጉዳ ሁንዳፍ፣ ቅልጡ ባሻን ሁንዳፍ፣","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ቱሉወን ኦል ዼዼሮ ሁንዳፍ፣","poem":1},{"text":"ጋረን ኦል ዼዼሮ ሁንዳፍ፣","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ገሞ ጉርጉዳ ሁንዳፍ፣","poem":1},{"text":"ደላ ዸጋዻን ጀቤፈሜ እጃረሜ ሁንዳፍ፣","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዶኒ ደልደላ ሁንዳፊ ዋን ገቲ ጉዳ ቀቡ ሁንዳፍ","poem":1},{"text":"ጉያ ሙርቴፈቴ ቶኮ ቀበ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኦፍ ቱሉማን ነማ ገድ ቀበመ፤","poem":1},{"text":"ኦፍ ጀጁን ነሞታስ ገድ ዴብፈመ፤","poem":2},{"text":"ጋፈስ ዋቀዮ ቆፈቱ ኦል ኦል ጄዸ፤","poem":1}]},{"type":"verse","number":18,"content":[{"text":"ዋቆትን ቶልፈሞን ጉቱማን ጉቱት ንበርበዴፈሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ነሞትን ዮሙ እን ለፈ ራሱፍ ከኡት፣","poem":1},{"text":"ሶዳችሰ ዋቀዮቲፊ","poem":2},{"text":"ሱራሳ ኡልፍነ ቀቤሰ ሰነ ዱራ","poem":1},{"text":"ገረ ሆልቀ ከታ ኬሳቲፊ","poem":2},{"lineBreak":true},{"text":"ቦለ ለፈ ኬሳት ንበቀቱ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ጋፈስ ነሞትን ዋቆተሳኒ ቶልፈሞ","poem":1},{"text":"ከኔን ዋቄፈቹፍ ጄዸኒ","poem":2},{"text":"ሜቲፊ ወርቄራ ቶልፈተን ሰነ","poem":1},{"text":"ቱቃፊ ስምብረ ሀልከኒቲፍ ደርበቱ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"እሳን ዮሙ እን ለፈ ራሱፍ ከኡት","poem":1},{"text":"ሶዳችሰ ዋቀዮቲፊ","poem":2},{"text":"ሱራ ኡልፍነሳ ዱራ ገረ ሆልቀ ጉዳ","poem":1},{"text":"ከታወን ኬሳቲፊ በቀቃ ከታት ንበቀቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ነመ ዱአ ህንኦሌ፣","poem":1},{"text":"ከን ሀፉርሳ ፉኛንረ ጅሩ አብደቹ ዺሳ።","poem":2},{"lineBreak":true},{"text":"እን ማልት ለካአመ?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}