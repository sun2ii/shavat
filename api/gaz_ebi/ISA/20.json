{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":20,"content":[{"type":"heading","content":["ራጂ ግብጢፊ እቶጵያዻን ሞርሙ"]},{"type":"verse","number":1,"content":["በረ አጀጃን ሙምች ሰርጎን ሞትቸ አሶሪን ኤርገሜ ሱን ገረ አሽዶድ ዹፌ ሎሌ እሼ ቀበቴ ሰነ ኬሰ፣"]},{"type":"verse","number":2,"content":["ዬሮዹመ ሰነት ዋቀዮ ከራ እሳያስ እልመ አሞሲቲን ዱበቴ። እንስ፣ “ኡፈተ ገዳ ዸግነኬራ፣ ኮጴስ ሚለኬራ ባስ” ጄዼን። እንስ አከሱመ ጎዼ፤ ቁላፊ ሚለ ዱዋ አሲፊ አች ዴሜ።"]},{"type":"verse","number":3,"content":["ከነረት ዋቀዮ አከነ ጄዼ፤ “አኩመ ገርብችኮ እሳያስ፣ አከ ግብጢፊ እቶጵያፍ መለቶፊ አኬከቺሰ ተኡፍ ጄዼ ወጋ ሰዲ ቁላፊ ሚለ ዱዋ ዴሜ ሰነ፣"]},{"type":"verse","number":4,"content":["አከሱመ ሞቲን አሶር ቦጅአምቶተ ግብጢፊ በቀቶተ እቶጵያ ደርገጌሳፊ ጃርሰ፣ ቁላፊ ሚለ ዱዋ ሀምብሴ ቴሱመሳኒሌ ቁላ ጎዼ ፉዸቴ ዴሜ፤ ኩን ወረ ግብጢቲፍ ቃኒዸ።"]},{"type":"verse","number":5,"content":["ወር እቶጵያ አመነተኒ ግብጢን ቦነን ንሶዳቱ፤ ንቃነኡስ።"]},{"type":"verse","number":6,"content":["ጋፈስ ወር ቀርቀረ ገላናረ ጅራተን አከነ ጄዹ፤ ‘ወረ ኑ እት እርከትኔ፣ ወረ ሞትቸ አሶር ጀላ ኑ ባሱ ጄኔ ገርጋርሳፍ እት በቀትኔ ሰነረ ዋን ገኤ ሜ እላላ! ዮስ ኑ አከምት ጀላ በኡ ደንዴኘ?’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/19.json","previousChapterAudioLinks":{},"numberOfVerses":6}