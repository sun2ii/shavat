{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":21,"content":[{"type":"heading","content":["ራጂ ባብሎኒን ሞርሙ"]},{"type":"verse","number":1,"content":["ራጂ ገሞጂ ገላነ ብረ ጅርቱን ሞርሙ፦",{"text":"አኩመ ቡቤን ሀማን ብየ ክባ ሀጣኡ ሰነ፣","poem":1},{"text":"ዌረራን ቶኮ ገሞጂዻ፣","poem":2},{"lineBreak":true},{"text":"ብየ ሶዳችሳ ኬሳ ንዹፈ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ሙልአትን ሀማን ቶኮ ነት ሙልአቴረ፦","poem":1},{"text":"ገንቱን ንገንት፤ ሳምቱንስ ንሳምት።","poem":2},{"text":"ያ ኤላም፣ ኦል በእ! ያ ሜዴ መርሲ ቀብ!","poem":1},{"text":"አን ኣዱ እሼን ፍዴ ሁንደ ነንጡሙረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ከነረት ዱግድ ነ ጭቴ፤","poem":1},{"text":"አኩመ ዱበርቲ ጭኒንስፈቱ ሙደምን ነ ቀቤ፤","poem":2},{"text":"አን ዋነን ዸገኤን ነንሆለዼ፤","poem":1},{"text":"ዋነን አርጌንስ ነንራፈሜ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ቀልቢንኮ ንራፈሜ፤","poem":1},{"text":"ሶዳን ነ ሆለቺሴ፤","poem":2},{"text":"ድምምስን አን ሀዌ ሱን","poem":1},{"text":"ሶዳት ነ ጀላ ጌደረሜ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"እሳን ማዲ ቆጴሱ፤","poem":1},{"text":"አፋ ድሪርሱ፤","poem":2},{"lineBreak":true},{"text":"ንኛቱ፣ ንዹጉ!","poem":2},{"text":"እስን ቆንዳልቶትን ከኣ፤","poem":1},{"text":"ጋቸነስ ዘይቲ ድባ።","poem":2}]},{"type":"verse","number":6,"content":["ጎፍታን አከነ ናን ጄዸ፦",{"text":"“ዸቂቲ ኤግዱ ቶኮ ረመድ፤","poem":1},{"text":"እንስ ዋን አርጉ ሃህሙ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እን ዮሙ ወረ ፈርደ ያበተን","poem":1},{"text":"ከኔን ለመ ለማን ያአን፣","poem":2},{"text":"ወረ ሀሬ ያበተን","poem":1},{"text":"ዮካን ወረ ጋለ ያበተን አርጉት፣","poem":2},{"text":"ሃደመቁ፤","poem":1},{"text":"ጉቱማን ጉቱት ሃደመቁ።”","poem":2}]},{"type":"verse","number":8,"content":["ኤግዱን ሱንስ አከነ ጄዼ እዬ፤",{"text":"“ያ ጎፍታኮ፣ አን ጉዩመ ጉያን","poem":1},{"text":"ቆጢ ኤጉምሳረ ነንዻበዸ፤","poem":2},{"lineBreak":true},{"text":"ሀልከን ሁንደስ አን ሆጂኮረ ነንቱረ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኩኖ፣ ወር ፈርደ ያበተን፣","poem":1},{"text":"ለመ ለማን ዹፋ ጅሩ፤","poem":2},{"text":"እን አከነ ጄዼ ዴብሴ፦","poem":1},{"text":"‘ባብሎን ጅግዴርት፤ ጅግዴርት!","poem":2},{"text":"ፈኪወን ዋቆተሼ ሁንድኑ","poem":1},{"text":"ቡርኩታአኒ ለፈ ዸአኒሩ!’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ያ ሰበኮ ወረ ኦብዲ ምዻኒረት ዸአምተን፣","poem":1},{"text":"አን ዋን ዋቀዮ ዋን ሁንደ ደንደኡ፣","poem":2},{"lineBreak":true},{"text":"ዋቀ እስራኤልራ ዸገኤ እስንትን ህመ።","poem":2}]},{"type":"heading","content":["ራጂ ኤዶሚን ሞርሙ"]},{"type":"verse","number":11,"content":["ራጂ ዱማን ሞርሙ፦",{"text":"ነምን ቶኮ ሴኢሪ ነ ዋሜ፣","poem":1},{"text":"“ያ ኤግዱ፣ ሀልከን ኩን በርኡፍ ሀመምቱ ሀፌ?","poem":2},{"lineBreak":true},{"text":"ያ ኤግዱ፣ ሀልከን ኩን በርኡፍ ሀመምቱ ሀፌ?” ጄዼ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኤግዱን ሱንስ፣","poem":1},{"text":"“በርኡ ገኤረ፤ ገሩ ዴብኤ ዽአ።","poem":2},{"text":"ዮ ጋፈቹ በርባደን ጋፈዻ፤","poem":1},{"text":"ገሩ ዴብኣ ኮታ” ጄዼ ዴብሰ።","poem":2}]},{"type":"heading","content":["ራጂ ብየ አረባቲን ሞርሙ"]},{"type":"verse","number":13,"content":["ራጂ ብየ አረባቲን ሞርሙ፦",{"text":"እስን እመልቶትን ዴዳን","poem":1},{"text":"ከኔን ቦሶነ አረባ ኬሰ ቁበተን፣","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ወረ ዼቦቴፍ ብሻን ፍዳ፤","poem":2},{"text":"እስን ወር ቴማ ኬሰ ጅራተን፣","poem":1},{"text":"በቀቶታፍ ዋን ኛተን ፍዳ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እሳን ጎራዴ ጀላ፣","poem":1},{"text":"ጎራዴ ሉቅፈሜ ጀላ፣","poem":2},{"text":"ጥየ አጋመሜ ጀላ፣","poem":1},{"text":"ሆአ ወራና ጀላ በቀተኒሩቲ።","poem":2}]},{"type":"verse","number":16,"content":["ጎፍታን አከነ ናን ጄዼ፦ “አኩመ ወጎተ ሆጄታ ቀጠረማ ቶኮት ኡልፍን ቄዳር ሁንድኑ ወጋ ቶኮ ኬሰት ንዹመ።"]},{"type":"verse","number":17,"content":["ወረ ጥየ ደርበተን ኬሳ ከኔን ሀፈን፣ ጎቶትን ቄዳር ሙራሰ ተኡ።” ዋቀዮ ዋቅን እስራኤል ዱበቴራቲ።"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}