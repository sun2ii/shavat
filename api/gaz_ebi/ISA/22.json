{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":22,"content":[{"type":"heading","content":["ራጂ ዋኤ ዬሩሳሌም"]},{"type":"verse","number":1,"content":["ራጂ ዋኤ ሱሉለ ሙልአታ፦",{"text":"አመ ማልቱ እስን ረክሴ","poem":1},{"text":"እስን ሁንድ ፊጤ መናት ኦል ባተን?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ያ መጋላ ወጫን ጉተምቴ፣","poem":1},{"text":"ያ መጋላ ጄቀምቱፊ ፈንደለልቱ፣","poem":2},{"text":"ነሞትን ስ ጀላ ቀለመን ጎራዴዻን ህንአጄፈምኔ","poem":1},{"text":"ዮካን ወራነ ኬሰት ህንዹምኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሆገንቶትንኬ ሁንድ ወሉማን በቀተን፤","poem":1},{"text":"እሳን ኡቱመ ጥየ ህንደርበትን ቀበመን።","poem":2},{"text":"እስን ኡቱመ ዲን ፈጎ ጅሩ በቀተንዩ","poem":1},{"text":"ወር ቀበምተን ሁንድ ወሉማን መነ ህዻት ገልፈምተኒርቱ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ከናፉ አን፣ “አነራ ገረገላ፤","poem":1},{"text":"አን ህቅፈዼ ነንቦአ።","poem":2},{"text":"በዲሰ ሰበኮረት","poem":1},{"text":"ነ ጀጀቤሱ ህንያልና” ነንጄዼ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ጎፍታን፣ ዋቀዮ ዋን ሁንደ ደንደኡ፣","poem":1},{"text":"ሱሉለ ሙልአታ ኬሰት፣ ጉያ ጄቁምሳ፣","poem":2},{"lineBreak":true},{"text":"ዽዺተሙቲፊ ቡርጃጂ፣","poem":2},{"text":"አከሱመስ ጉያ እት ደላ ዲጉቲፊ","poem":1},{"text":"ቱሉወንትስ እዩ ቀበ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኤላም መንኤ ጥያ ቀበቴ","poem":1},{"text":"ጋሪወኒፊ አቦቲ ፈርዳ ፉዸቴ ባት፤","poem":2},{"lineBreak":true},{"text":"ቂርስ ጋቸነሼ ቀበት።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሱሉለወንኬ ፍለተሞን ጋሪወኒን ጉተመኒሩ፤","poem":1},{"text":"አቦቲን ፈርዳስ ከረ መጋለቲረት ረመደመኒሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ጎፍታን እትሰ ይሁዳ እራ ሙልቄረ።","poem":1},{"text":"አትስ ጋፈስ ምአ ሎላ ከን መሰራ ቦሶና","poem":2},{"lineBreak":true},{"text":"ኬሰ ጅሩ ሰነ አብደተ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ደላን መጋላ ዳዊት","poem":1},{"text":"ከራ ባይኤ አከ ኡረሜ አርግተኒርቱ፤","poem":2},{"text":"ሀሮ ገድ ኣና ኬሰትስ","poem":1},{"text":"ብሻን ኩፈተኒርቱ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እስን መኔን ዬሩሳሌም ለኮፍተን፤","poem":1},{"text":"ደላሼ ዸጋ ጀቤሱፍ ጄተኒስ መኔን ሰነ ዲግደን።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ብሻን ሀሮ ሞፋቲፍ ደላ ለማን ግዱት","poem":1},{"text":"ኩሳ ብሻኒ ቶልችተን፤","poem":2},{"text":"ገሩ እስን ገረ እሰ ዋን ሰነ ሆጄቴ ህንእላሌ፤","poem":1},{"text":"ዮካን እሰ በረ ዼራን ዱረ ዋን ሰነ ከሮርሴፍኡልፍነ ህንኬንኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ጎፍታን፣ ዋቀዮ ዋን ሁንደ ደንደኡ፣","poem":1},{"text":"አከ አት ቦሴ ወዋቱፍ፣","poem":2},{"text":"አከ አት ርፌንሰ መታኬቲ ኦፍራ ጭርቴ","poem":1},{"text":"ወያ ገዳ ኡፈቱፍ ጉያ ሰነ ስ ዋሜ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ቆደ ከና ገሩ ገመቹፊ ፈንደለሉ፣","poem":1},{"text":"ሎን ጎረኡፊ ሆሎተ ቀሉ፣","poem":2},{"lineBreak":true},{"text":"ፎን ኛቹፊ ዳዺ ወይኒ ዹጉቱ ጅረ!","poem":2},{"text":"እስን፣ “ኮታ ንኛትና፤ ንዹግነስ፤","poem":1},{"text":"ቦር ንዱናቲ!” ጄቱ።","poem":2}]},{"type":"verse","number":14,"content":["ዋቀዮ ዋን ሁንደ ደንደኡ ኡቱመ ጉርኮ ዸገኡ ዋን ከነ ና እብሴ፦ “ሀመ ጉያ ዱአኬሰኒት ጩቡን ኩን እስንራ ህንሀቀሙ” ጄዸ ጎፍታን፣ ዋቀዮ ዋን ሁንደ ደንደኡ።"]},{"type":"verse","number":15,"content":["ጎፍታን፣ ዋቀዮ ዋን ሁንደ ደንደኡ አከነ ጄዸ፦",{"text":"“ዸቂቲ እት ጋፈተማ ከናን፣","poem":1},{"text":"ሼብና፣ ቡልቻ መሰራ ሞቱማቲን አከነ ጄዽ፦","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አት ማል አሲ ሆጄተ?","poem":1},{"text":"አከ አት እዶ ከነት እዶ አዋላ ቆጴፈቱ፣","poem":2},{"text":"አከ እዶ ኦል ከኣረት ቦለ አዋለኬቲ ቆተቱ፣","poem":1},{"text":"አከ ከታ ኬሰት እዶ ቦቆናኬቲ ቶልቸቱኤኙቱ ኤየመ ሲፍ ኬኔ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“ያ ነመ ጀባ ኩኖ፣","poem":1},{"text":"ዋቀዮ ጀቤሴ ቀቤ ስ ደርበቹፍ ጅረ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እን አኩመ ኩባ ፉሩርሴ","poem":1},{"text":"ብየ በልኣ ቶኮ ኬሰ ስ ቡሰ።","poem":2},{"text":"ያ ሰልጵነ መነ ጎፍታኬቲ፣ አት አችት ዱተ፤","poem":1},{"text":"ጋሪወንኬ ምሚዸጎንስ አችት ሀፉ!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አን ኣንጎኬራ ስን ቡሰ፤","poem":1},{"text":"አትስ ታይታኬራ ንአርአምተ።","poem":2}]},{"type":"verse","number":20,"content":["“አን ጋፈስ ገርብቸኮ ኤሊያቂምን እልመ ህልቅያ ነንዋመ።"]},{"type":"verse","number":21,"content":["አን ኡፈተኬ እሰት ነንኡፍሰ፤ ሰበተኬ ሙዺሳት ነንህዸ፤ ኣንጎኬስ ደበርሴ እሳፍ ነንኬነ። እን ወረ ዬሩሳሌም ኬሰ ጅራተኒፊ መነ ይሁዳቲፍ አባ ንተአ።"]},{"type":"verse","number":22,"content":["አን ፉርቱ መነ ዳዊት ገቲቲሳረ ነንካአ፤ ዋን እን በኑ ነምን ቶኮዩ ጩፉ ህንደንደኡ፤ ዋን እን ጩፉስ ነምን ቶኮዩ በኑ ህንደንደኡ።"]},{"type":"verse","number":23,"content":["አን አኩመ ፈኖ ዋ እት ፈንሰን ቶኮት እዶ ጀባረ እሰ ነንዻበ፤ እንስ መነ አባሳቲፍ ቴሶ ኡልፍና ንተአ።"]},{"type":"verse","number":24,"content":["እሳንስ ከበጀ መነ አባሳ ሁንደ፣ እጆሌሳቲፊ እጆሌ እጆሌሳ፣ ምአ ጥጥና ከን ወጪቲዻ ጀልቀቤ ሀመ ኦኮቴት ጅሩ ሁንደ እሰት ፈንሱ።”"]},{"type":"verse","number":25,"content":["ዋቀዮ ዋን ሁንደ ደንደኡ አከነ ጄዸ፤ “ጋፈስ ቆፎን እዶ ጀባ ዻበሜ ሱን ንቡቀአ፤ ሙረሜ ለፈ ቡአ፤ በኣን እሰት ፈንፈሜ ሱን ሀርጨኤ ጨጨበ።” ዋቀዮ ዋን ከነ ዱበቴራቲ።"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/21.json","previousChapterAudioLinks":{},"numberOfVerses":25}