{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":23,"content":[{"type":"heading","content":["ራጂ ዋኤ ጢሮስ"]},{"type":"verse","number":1,"content":["ራጂ ዋኤ ጢሮስ፦",{"text":"ያ ዶኒወን ተርሺሽ ወዋዻ!","poem":1},{"text":"ጢሮስ በርበዶፍቴ","poem":2},{"lineBreak":true},{"text":"መነ ዮካን ቡፈተ ዶኒ መሌ ሀፍቴርቲ።","poem":2},{"text":"ብየ ቆጵሮሲ","poem":1},{"text":"ኦዱን እሳን ቀቀቤረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"እስን ጅራቶትን ቀርቀረ ገላናቲፊ","poem":1},{"text":"ደልደልቶትን ሲዶና፣ ወር ገላነረ መርማረን","poem":2},{"lineBreak":true},{"text":"እስን ሶሮምሰን ጨልእሳ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ምዻን ሽሆር","poem":1},{"text":"ብሻኖተ ጉርጉዳ እራን ዹፌ፤","poem":2},{"text":"ኦምሽን አበያ ጢሮሲፍ ገሊ ቱሬ፤","poem":1},{"text":"እሼንስ ለፈ ገባ ከን ሰቦታ ታቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ያ ሲዶና፣ ያ ደአትኖ ገላና ቃነእ፤","poem":1},{"text":"ገላን አከነ ጄዼ ዱበቴራቲ፦","poem":2},{"text":"“አን ህንጭኒንስፈትኔ ዮካን ህንዴኜ፤","poem":1},{"text":"እልማን ህንሆረትኔ ዮካን እንተለን ህንጉድፈትኔ።”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዬሮ ኦዱን ገረ ግብጥ ዹፉት","poem":1},{"text":"እሳን ገባሰ ጢሮስራ ዹፉን ንዽጰቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"እስን ገረ ተርሺሽት ጬኣ፤","poem":1},{"text":"ያ ወረ ቀርቀረ ገላና ጅራተን ወዋዻ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"መጋላ ዱሎምቱን ዱሪ፣","poem":1},{"text":"ከን ሚልሼ እሼ ፉዼ፣","poem":2},{"text":"አከ እሼን ብየ ፈጎ ኬሰ ቁበቱፍ እሼ ጌሴ ኩን፣","poem":1},{"text":"መጋላኬ እሼ ፈንደለልቱዻ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጢሮስ እሼ ጎንፎ ነመ ጎንፈቺፍቱ","poem":1},{"text":"ከን ደልደልቶትንሼ እልማን ሞቶታ ተአን","poem":2},{"text":"ከን ደልደልቶትንሼ ለፈረት ከበጀሞ ተአንት","poem":1},{"text":"ኤኙቱ ዋን ከነ ከሮርፈቴ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዋቀዮ ዋን ሁንደ ደንደኡ","poem":1},{"text":"ኦፍ ጀጀሼ ከን ኡልፍነሼ ሁንደ ኬሰ ጅሩ ገድ ዴብሱፊ","poem":2},{"lineBreak":true},{"text":"ወረ ለፈረት ከበጀመን ሁንደ ሰልጵሱፍዋን ከነ ከሮርፈቴረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ያ እንተለ ተርሺሽ፣","poem":1},{"text":"አት ስአች ቡፈተ ዶኒ ህንቀባቱቲ፣","poem":2},{"lineBreak":true},{"text":"ለፈኬ ሀመ አበያ ብረ ገኡት ቆተዹ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዋቀዮ ሀርከሳ ገላነረ ቀቤ","poem":1},{"text":"ሞቱሞተ ሆለቺሴረ።","poem":2},{"text":"እን አከ ደአኖወንሼ ዲገመኒፍ","poem":1},{"text":"ዋኤ ከነኣን አጀጀ ኬኔረ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እንስ አከነ ጄዸ፤ “ያ ዱርበ ሲዶና፣","poem":1},{"text":"አት ከነ ጫላ ህንፈንደለልቱ!","poem":2},{"lineBreak":true},{"text":"“ከኢቲ ገረ ቆጵሮስት ጬእ፤","poem":1},{"text":"አት አችትዩ ቦቆና ህንአርገቱ።”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሜ ብየ ባብሎኖታ እላል፤","poem":1},{"text":"ኡመትን ኩን አመ ሴና ህንቀቡ!","poem":2},{"text":"ወር አሶር አከ እሼን","poem":1},{"text":"እዶ ጅሬኘ ኡመመወን ገሞጂ ታቱ ጎዸን፤","poem":2},{"text":"እሳን ስሬ ኤጉምሳ እጃረተን፤","poem":1},{"text":"ደአኖወንሼ ቁላ ሀምብሰን፤","poem":2},{"lineBreak":true},{"text":"እሼስ ንበርበዴሰን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ያ ዶኒወን ተርሺሽ ወዋዻ፤","poem":1},{"text":"ደአኖንኬሰን በርበዴፈሜራቲ!","poem":2}]},{"type":"verse","number":15,"content":["ዬሮ ሰና ጀልቀቤ ጢሮስ ሀመ ወጋ ቶርባተማት ንደገተምት፤ ኩንስ በረ ጅሬኘ ሞቲ ቶኮት። ዹመ ወጋ ቶርባተመን ሰናት ገሩ አኩመ ስርበ ሰጋገልቱ ቶኮፍ ስርበሜ ሰናት ጢሮስረ ገአ፦"]},{"type":"verse","number":16,"content":[{"text":"“ያ ሰጋገልቱ እራንፈተምቱ፣","poem":1},{"text":"በገና ቀበዹቲ መጋላ ኬሰ ናነእ፤","poem":2},{"text":"አት አከ ያደተምቱፍ በገና ስሪት ሩኩት፤","poem":1},{"text":"ስርበ ባይኤ ስርብ።”","poem":2}]},{"type":"verse","number":17,"content":["ዹመ ወጋ ቶርባተማት ዋቀዮ ጢሮስን ንያደተ፤ እሼንስ ገረ ደልደለሼት ዴብቴ ሞቱሞተ ፉለ ለፋረ ጅረን ሁንደ ወጅን ሰጋገልት።"]},{"type":"verse","number":18,"content":["ተኡስ ቡኣንሼቲፊ ወን እሼን አርገቱ ዋቀዮፍ አዳን ባፈመ፤ ህንኩፈሙ፤ ወልትስ ህንቀበሙ። ቡኣንሼስ ወረ ፉለ ዋቃ ዱረ ጅራተኒፍ ኛተ ገኣፊ ኡፈተ በበሬዳ ተአ።"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}