{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":24,"content":[{"type":"heading","content":["ዋቀዮ ለፈ ንበርበዴሰ"]},{"type":"verse","number":1,"content":[{"text":"ኩኖ፣ ዋቀዮ ለፈ ንኦንሰ፤","poem":1},{"text":"እሼስ ንበርበዴሰ፤","poem":2},{"text":"እን እሼ ገገረገልቼ","poem":1},{"text":"ወረ እሼረ ጅራተን ብትኔሰ፤","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ከን ሰበረ ገኡ ሉበረ፣","poem":1},{"text":"ከን ገርብቸረ ገኡ ጎፍታረ፣","poem":2},{"lineBreak":true},{"text":"ከን ገርብቲረ ገኡ ጊፍቲረ፣","poem":2},{"lineBreak":true},{"text":"ከን ብተታረ ገኡ ጉርጉረታረ፣","poem":2},{"lineBreak":true},{"text":"ከን እሰ ኤርግፈቱረ ገኡ፣ እሰ ኤርግሱረ፣","poem":2},{"lineBreak":true},{"text":"ከን ልቄፈታረ ገኡ፣ እሰ ልቄሱ ንገኣቲ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ለፍት ጉቱማን ጉቱት ንኦንት፤","poem":1},{"text":"ጉቱማን ጉቱትስ ንሳመምት።","poem":2},{"text":"ዋቀዮ ዋን ከነ ዱበቴራቲ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ለፍት ንጎግድ፤ ብፍትሼስ ንጌደረመ፤","poem":1},{"text":"አዱኛን ንቡቱት፤ ብፍትሼስ ንጌደረመ፤","poem":2},{"lineBreak":true},{"text":"ጉርጉዶትን ሰበ ለፋስ ንቡቱቱ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ለፍት ሰበሼቲን ጡሮፍቴርት፤","poem":1},{"text":"እሳን ሴራፍ አጀጀሙ ድደን፤","poem":2},{"text":"ስርናን ቡሉ ድደኒ","poem":1},{"text":"ከኩ በረ በራ ሰነ ጨብሰኒሩ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ከናፉ አባርስ ለፈ በሌሰ፤","poem":1},{"text":"ሰብንሼስ በሌሳሳቲፍ አደበመ።","poem":2},{"text":"ከናፉ ጅራቶትን ለፋ ንጉበቱ፤","poem":1},{"text":"ነመ ሙራሰቱ ሀፈ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዳዺን ወይኒ ሃራን ንጎገ፤","poem":1},{"text":"ሙክን ወይኒስ ንጮለገ፤","poem":2},{"lineBreak":true},{"text":"ወር ገመደን ሁንድኑ ንኣዱ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ድቤን ሰገሌንሳ ነመት ቶሉ ንጨልእሰ፤","poem":1},{"text":"ወጭን ፈንደለልቶታ ቀበናኤረ፤","poem":2},{"lineBreak":true},{"text":"በገናን ነመ ገመቺሱስ ጨልእሴረ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እሳን ስአች ስርባ ዳዺ ወይኒ ህንዹገን፤","poem":1},{"text":"ዹጋቲን ጀባን ወረ እሰ ዹገንት ንሀዻአ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"መጋላን ዲገምቴ ሱን ኦንቴ ሀፍት፤","poem":1},{"text":"አከ ነምን ቶኮዩ ኦል ህንሴኔፍ መን ሁንድ ንጩፈመ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እሳን ዳዺ ወይኒ ዸበኒ ዳንዲረት ቦኡ፤","poem":1},{"text":"ገመቹን ሁንድ ገደት ጌደረመ፤","poem":2},{"lineBreak":true},{"text":"እልልቹን ሁንድስ ለፈራ ዸበመ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"መጋላን ሱን ዲገምቴ ሀፍት፤","poem":1},{"text":"ከርሼስ ንጨጨበ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አኩመ ዬሮ ሙክን ኤጄርሳ ዸአሙፊ","poem":1},{"text":"አኩመ ዬሮ ወይኒን ገልፈሙት ቀርሚን ሀፉ ተኡ ሰነ፣","poem":2},{"text":"ለፈረት ሰቦተ ግዱትስ","poem":1},{"text":"አከሱመ ንተአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"እሳን ሰገሌ ኦል ፉዸተኒ ገመቹን እዩ፤","poem":1},{"text":"ገመ ልጠ ቢፍቱት ኡልፍነ ዋቀዮ ለብሱ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ከናፉ እስን በአ ቢፍቱራ ዋቀዮፍ ኡልፍነ ኬና፤","poem":1},{"text":"ቀርቀረ ገላናትስ መቃ ዋቀዮ","poem":2},{"lineBreak":true},{"text":"ዋቀ እስራኤል ሌልሳ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኑ ሞጋ ለፋራ ፋርፈትና፣","poem":1},{"text":"“እሰ ቀጄላ ሰናፍ ኡልፍን ሃተኡ” ጄዹ ዸጌኘ።","poem":2},{"lineBreak":true},{"text":"አን ገሩ አከነን ጄዼ፤","poem":1},{"text":"“አን በዴ፣ አን በዴ! አናፍ ወዮ!","poem":2},{"text":"ገንቶትን ንገኑ!","poem":1},{"text":"ገንቶትን ገንቱማሳኒቲን ገኑ!”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ያ ኡመተ ለፈራ፣","poem":1},{"text":"ሶዳን፣ ቅሌፊ ክዮን ስ ኤገቱ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ነምን ሰገሌ ጎሊ በቀቱ ከምዩ","poem":1},{"text":"ቅሌ ኬሰ ቡአ፤","poem":2},{"text":"ነምን ቅሌ ኬሳ ኦል በኡ ከምዩ","poem":1},{"text":"ክዮዻን ቀበመ።","poem":2},{"lineBreak":true},{"text":"ፎዳን ሰሚወኒ በነሜራቲ","poem":1},{"text":"ሁንዴወን ለፋ ንራፈሙ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ለፍት በቀቅጤርት፤","poem":1},{"text":"ለፍት ገርገር ባቴርት፤","poem":2},{"lineBreak":true},{"text":"ለፍት አከ መሌ ራፈምቴርት፤","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ለፍት አኩመ ነመ መቻኤ ገተንተርት፤","poem":1},{"text":"እሼን አኩመ ዳሲ ቡቤዻን ራፈምት፤","poem":2},{"text":"የክ ፍንጭለሼ አከ መሌ እት ኡልፋቴረ፤","poem":1},{"text":"እሼን ንጅግድ፤ ዴብቴስ ህንካቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ዋቀዮ ጋፈስ","poem":1},{"text":"ሁምኖተ ሰሚ፣ ሰሚረት፣","poem":2},{"lineBreak":true},{"text":"ሞቶተ ለፋሞ ለፈረት ንአደበ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"እሳን አኩመ ህዸምቶታ","poem":1},{"text":"ቦለ ኬሳት ወልት ቀበሙ፤","poem":2},{"text":"መን ህዻ እት ጩፈሜ","poem":1},{"text":"ጉያ ሄዱ ቦዴ አደበሙ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ጅእ ንቡርጃጆፍት፤ አዱንስ ንቃኖፍት፤","poem":1},{"text":"ዋቀዮ ዋን ሁንደ ደንደኡ፣","poem":2},{"text":"ቱሉ ጥዮንረቲፊ ዬሩሳሌም ኬሰት","poem":1},{"text":"ፉለ ማንጉዶታ ዱረት ኡልፍናን ንሞኣቲ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}