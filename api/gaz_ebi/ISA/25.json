{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":25,"content":[{"type":"heading","content":["ዋቀዮፍ ገለተ ገልቹ"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ፣ አት ዋቀኮት፤","poem":1},{"text":"ዋን አት አመነሙማኬ ከን ሙዳ ህንቀብኔን","poem":2},{"text":"ወንቶተ ድንቅሲሶ","poem":1},{"text":"በረ ዼራን ዱረ ከሮርፈሜ ሆጄቴፍ፣","poem":2},{"lineBreak":true},{"text":"አን ኡልፍነ ሲፍ ነንኬነ፤ መቃኬስ ነንሌልሰ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አት መጋላ ሰነ ቱላ ዸጋ፣","poem":1},{"text":"መጋላ ደላ ጀጀባ ቀብዱሞ ዲገማ ጎቴ፤","poem":2},{"text":"መጋላን ደአትኖ ነሞተ ኦርማ ቱርቴ ሱንስአች ህንጅራቱ፤","poem":1},{"text":"እሼን ጎንኩማ ዴብቴ ህንእጃረምቱ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ከናፉ ነሞትን ጀጀቦን ስ ከበጁ፤","poem":1},{"text":"መጋላወን ሰቦተ ገረ ጀቤዪ ስ ሶዳቱ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አት ህዬዪፍ ለፈ እት በቀተን፣","poem":1},{"text":"ረከታፍሞ ዽጵነሳ ኬሰት ደኦ፣","poem":2},{"text":"ቡቤ ሀማ ጀላ እዶ እት በቀቱ፣","poem":1},{"text":"ሆአ ጀላሞ እዶ እት ቀበኔፈቱ ቱርቴ።","poem":2},{"text":"ሀፉር ገረ ጀቤዪን ባፈተን፣","poem":1},{"text":"አኩመ ቡቤ ሀማ ደላ ዸጋ ዸኡቲፊ","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"አኩመ ሆአ ገሞጂት።","poem":2},{"text":"አት ወጨ አለጎታ ንጨልእሲፍተ፤","poem":1},{"text":"አኩመ ሆእ ጋድሰ ዱሜሳቲን ቀበናኡ ሰነ፣","poem":2},{"lineBreak":true},{"text":"ስርብ ገረ ጀቤዪስ ንቀበናአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ዋቀዮ ዋን ሁንደ ደንደኡ","poem":1},{"text":"ቱሉ ከነረት ኡመተ ሁንዳፍ ጭዸ ኛተ ጋሪ፣","poem":2},{"text":"አፌራ ዳዺ ወይኒ ጎጌ፣","poem":1},{"text":"ፎን ጮማፊ ዳዺ ወይኒ ፍለተማ ንቆጴሰ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እን ቱሉ ከነረት፣","poem":1},{"text":"ሀጉጊ ኡመተ ሁንደት ሀጉገሜ፣","poem":2},{"text":"ጎልጋ ሰበ ሁንደት ጎልገሜ ንበሌሰ፤","poem":1}]},{"type":"verse","number":8,"content":[{"text":"እን በረ በራን ዱአ ንልቅምሰ።","poem":2},{"text":"ዋቀዮ ጎፍታን ፉለ ሁንደራ እምማን ንሀቀ፤","poem":1},{"text":"እን ለፈ ሁንደረት ሰልጵነ ሰበሳ ንበሌሰ።","poem":2},{"lineBreak":true},{"text":"ዋቀዮ ዋን ከነ ዱበቴራቲ።","poem":2}]},{"type":"verse","number":9,"content":["እሳን ጋፈስ አከነ ጄዹ፤",{"text":"“ዹጉማን ኩን ዋቀኬኘ፤","poem":1},{"text":"ኑ እሰ አመነትኔ፤ እንስ ኑ ኦልቼ።","poem":2},{"text":"ኩን ዋቀዮዸ፤ ኑ እሰ አመነትኔ፤","poem":1},{"text":"ኮታ ፈይሱሳት ገመድና፤ ንእልልችነስ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ሀርክ ዋቀዮ ቱሉ ከነረ ንቦቆተ፤","poem":1},{"text":"ሞኣብ ገሩ አኩመ ጭዲን ድኬ ኬሰት ዽዺተሙ ሰነ","poem":2},{"lineBreak":true},{"text":"እሰ ጀለት ዽዺተመ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እንስ አኩመ ነምን ብሻን ዳኩ ቶኮ ዳኩፍ ሀርከ በልእፈቱ ሰነ፣","poem":1},{"text":"ጋረ ሰነረት ሀርከሳ ንበልእፈተ።","poem":2},{"text":"ዋቅንስ ኦፍ ቱሉማሳኒ፣","poem":1},{"text":"ኦጉማ ሀርከሳኒ ወጅን ገድ ዴብሰ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እን ደላኬ ኦል ዼራ ዸጋን እጃረሜ ሰነ፣","poem":1},{"text":"አከ እን ዱፉ ጎዸ፤","poem":2},{"lineBreak":true},{"text":"ለፈት ገድ ጅግሴስ ብዮት ደበለ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/24.json","previousChapterAudioLinks":{},"numberOfVerses":12}