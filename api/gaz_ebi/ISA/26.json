{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":26,"content":[{"type":"heading","content":["ፋርፈትና ገለታ"]},{"type":"verse","number":1,"content":["በረ ሰነ ፋርፈናን ኩን ብየ ይሁዳ ኬሰት ፋርፈተመ፦",{"text":"ኑ መጋላ ጀባ ቀብነ፤","poem":1},{"text":"ዋቅንስ ፈይነ፣","poem":2},{"lineBreak":true},{"text":"ደላ ኤጉምሰሼቲፊ ደአትኖሼ ታስሰ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አከ ሰብን ቀጄላን፣","poem":1},{"text":"ሰብን አመነሙማዻን ጅራቱ ኦል ሴኑፍ፣","poem":2},{"lineBreak":true},{"text":"ከረወን በና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እን ስት እርከቴራቲ፣","poem":1},{"text":"ነመ ያድን ገራሳ ስ ወጅን ጅሩ፣","poem":2},{"lineBreak":true},{"text":"አት ነጋ ህርእነ ህንቀብኔን እሰ ኤግደ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሰበቢ ዋቀዮ፣ ዋቀዮ መታንሳ፣","poem":1},{"text":"ከታ በረ በራ ተኤፍ፣ በረ በራን ዋቀዮን አመነዻ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እን ወረ እዶ ኦል ከኣረ ጅራተን ገድ ቀበ፤","poem":1},{"text":"መጋላ ተበረ ጅርቱ ገድ ቡሰ፤","poem":2},{"lineBreak":true},{"text":"ለፈት ገቴስ አዋረት እሼ መከ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሚል፣ ሚል ወረ ሀጩጨሜ፣","poem":1},{"text":"ፋን ህዬዪሼ ዽዺተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ዳንዲን ነመ ቀጄላ ወል ቅጣታዸ፤","poem":1},{"text":"ያ እሰ ቶላ፣ አት ቀጄልቶታፍ ከራ ባፍተ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ያ ዋቀዮ፣","poem":1},{"text":"ኑ ከራ ሴረኬቲረ ዴማ ስ ኤገትነ፣","poem":2},{"text":"መቃንኬቲፊ ቤከሙንኬ","poem":1},{"text":"ሀዊ ገራኬኛት።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሀልከን ሉቡንኮ ስ ያድ፤","poem":1},{"text":"ገነመስ ሀፉርኮ ባይእሴ ስ በርባደ።","poem":2},{"text":"ዬሮ ሙርቲንኬ ገረ ለፋ ዹፉት፣","poem":1},{"text":"ኡመትን አዱኛ ቀጄሉማ በረተ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ነምን ሀማን ገረ ላፍን ጎዸሙፍዩ፣","poem":1},{"text":"ቀጄሉማ ህንበረቱ፤","poem":2},{"text":"ብየ ቀጄሉማን ጅሩትዩ እን እቱመ ፉፌ ጀልእነ ሆጄተ፤","poem":1},{"text":"ሱራ ዋቀዮስ ህንሁበቱ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ያ ዋቀዮ፣ ሀርክኬ ኦል ካፈሜረ፤","poem":1},{"text":"እሳን ገሩ እሰ ህንአርገን።","poem":2},{"text":"እሳን ህናፋ አት ሰበኬቲፍ ቀብዱ አርገኒ ሃቃነአን፤","poem":1},{"text":"እብድ ዲኖተኬቲፍ ኩፈሜ ሱን እሳን ሃበሌሱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ያ ዋቀዮ፣ አት ነጋ ኑፍ ኬንቴርተ፤","poem":1},{"text":"አት ሆጂኬኘ ሁንደ ኑፍ ሆጄቴርታቲ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ያ ዋቀዮ ዋቀኬኘ፣","poem":1},{"text":"ስ መሌ ጎፍቶትን ብራ ኑ ቡልቸኒሩ፤","poem":2},{"lineBreak":true},{"text":"ኑ ገሩ መቃኬ ቆፈ ኡልፌስነ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እሳን አመ ዱአኒሩ፤ ስአች ህንጅራተን፤","poem":1},{"text":"እሳን ጋድዱዸ፤ ዴብአኒስ ህንከአን።","poem":2},{"text":"አት እሳን አደብዴ፤ እሳን በሌስቴስ፤","poem":1},{"text":"ያደኖሳኒ ሁንደስ ንበርበዴስቴ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ያ ዋቀዮ፣ አት ሰበ ባይእስቴርተ፤","poem":1},{"text":"አት ሰበ ባይእስቴርተ፤","poem":2},{"text":"አት ኦፊኬቲፍ ኡልፍነ አርገቴርተ፤","poem":1},{"text":"ዳሪ ብያ ሁንደ በልእፍቴርተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ያ ዋቀዮ፣ እሳን ዬሮ ዽጵናት ስ በርባደተን፤","poem":1},{"text":"ዬሮ አት እሳን አደብዴት","poem":2},{"lineBreak":true},{"text":"እሳን ከዸትና ገድ ሮብሰን።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አኩመ ዱበርቲን ኡልፋ ዬሮ ደኡ ጌሱት፣","poem":1},{"text":"ጭኒንሱዻን ውጥርፈቴ እይቱ ሰነ፣","poem":2},{"lineBreak":true},{"text":"ያ ዋቀዮ፣ ኑስ ፉለኬ ዱረት አከሱመ ታኔረ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ኑ ኡልፎፍኔ፣ ጭኒንሱዻን ውጥርፈትኔ፤","poem":1},{"text":"ኑ ገሩ ቡቤ ዴኜ።","poem":2},{"text":"ኑ ለፋፍ ፈይነ ህንፍድኔ፤","poem":1},{"text":"ኑ ኡመተ አዱኛ ህንዴኜ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ገሩ ነሞትንኬ ከኔን ዱአን ንጅራቱ፤","poem":1},{"text":"ዸግንሳኒስ ዱኣ ንከአ።","poem":2},{"text":"እስን ወር ብዮ ኬሰ ጅራተን፣","poem":1},{"text":"ደመቃቲ ገመቹዻን እልልቻ።","poem":2},{"text":"ፍጤንስኬ አኩመ ፍጤንሰ ገነማት፤","poem":1},{"text":"ለፍትስ ወረ ዱአን ኦፍ ኬሳ ባፍት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ያ ሰበኮ፣ ኩታ መነኬት ኦል ገሊቲ","poem":1},{"text":"ዱባን በልበለ ኦፍት ጩፍ፤","poem":2},{"text":"ሀመ ዼከምስሳ ደርቡት፣","poem":1},{"text":"ዬሮ ሙራሳፍ ኦፍ ዾክስ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ኩኖ፣ ዋቀዮ ሰበቢ ጩቡሳኒቲፍ","poem":1},{"text":"ኡመተ ለፈራ አደቡፍእዶ ጅሬኘሳቲ በኤ ዹፋ ጅረ።","poem":2},{"text":"ለፍት ዺገ እሼረት ዸንገላፈሜ ሰነ እፈ ባፍት፤","poem":1},{"text":"ስአች ወረ እሼረት ቀለመን ህንዾክስቱ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}