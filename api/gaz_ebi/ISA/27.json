{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":27,"content":[{"type":"heading","content":["ፉረሙ እስራኤል"]},{"type":"verse","number":1,"content":["በረ ሰነ፣",{"text":"ዋቀዮ ጎራዴሳቲን፣","poem":1},{"text":"ጎራዴሳ ሶዳችሳ፣ ጉዳፊ ጀባ ሰናን፣","poem":2},{"text":"ሌዋታን ቦፍቸ ምርምርፈሙ፣","poem":1},{"text":"ሌዋታን ቦፍቸ መርመረሙ ሰነ ንአደበ፤","poem":2},{"text":"እን ጀዌ ገላነ ኬሰ ጅራቱ ንኩኩተ።","poem":1}]},{"type":"verse","number":2,"content":["በረ ሰነ አከነ ጄዸመ፤",{"text":"“ዋኤ እዶ ዻባ ወይኒ ከን ነመት ቶሉ ሰና ፋርፈዻ፤","poem":1}]},{"type":"verse","number":3,"content":[{"text":"አን ዋቀዮ እሰ ነንኤገ፤","poem":2},{"lineBreak":true},{"text":"አን ዬሮ ሁንደ ብሻን ነንኦባሰ፤","poem":2},{"text":"አከ ነምን ቶኮዩ እሰ ህንሚኔፍ","poem":1},{"text":"አን ሀልከኒፊ ጉያ እሰ ነንኤገ።","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"አን ህንኣሩ።","poem":2},{"text":"ሶኮሩፊ ቆራቲን ወራናፍ ኡቱ ነት በአኒ!","poem":1},{"text":"አን ስላ እሳንት ነንዱለ፤","poem":2},{"lineBreak":true},{"text":"ወልት ቀቤስ እሳን ነንጉበ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዮ ከና አቺ እሳን ኮሉ ነት ሃገለን፤","poem":1},{"text":"እሳን ነ ወጅን ነጋ ሃኡመን፤","poem":2},{"lineBreak":true},{"text":"ኤዬ፣ እሳን ነ ወጅን ነጋ ሃኡመን።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"በረ ዹፉፍ ጅሩ ኬሰ ያቆብ ህደ ባሰ፤","poem":1},{"text":"እስራኤል ለቴ ደራረ፤","poem":2},{"lineBreak":true},{"text":"እጃንስ አዱኛ ሁንደ ጉተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ዋቀዮ አኩመ ወረ እሼ ሩኩተን ሰነ ሩኩቴ፣","poem":1},{"text":"እሼሌ ሩኩቴራ?","poem":2},{"text":"አኩመ ወር እሼ አጄሰን ሱን አጄፈመን፣","poem":1},{"text":"እሼንስ አጄፈምቴርቲ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አት ወራኑፊ አርኡዻን እሼዻን ወል ፈልምቴ፤","poem":1},{"text":"እን ጉያ ቡቤን በኣ ቡብሱት፣","poem":2},{"lineBreak":true},{"text":"ቡቤሳ ሶዳችሳ ሰናን እሼ በሌሰ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዮሙ እን ዸጎተ እዶ ኣርሳ ሁንደ","poem":1},{"text":"አኩመ ዸጋ ኖራ ጨጨብሰሜ ጎዹት፣","poem":2},{"text":"ሲዳን አሼራ ዮካን እዶን ኣርሳ እጣና ቶኮዩዻበቴ ህንሀፉ።","poem":1},{"text":"አከሲንስ በሌሳን ያቆብ ንሀቀማፍ፤","poem":2},{"lineBreak":true},{"text":"ኩንስ ጩቡንሳ ጉቱማን ጉቱት ሀቀሙሳ ምርከኔሰ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"መጋላን ደላ ጀባ ቀብዱ ንኦንት፤","poem":1},{"text":"አከ ገሞጂ ገተምቴቲፊ ዺፈምቴ ታት፤","poem":2},{"text":"ጀቦትን አች ዼድ፤","poem":1},{"text":"አችስ ንጭጪፍት፤","poem":2},{"lineBreak":true},{"text":"ጀቦትን ደሜሼ ቆርቀኒ ቁላ ሀምብሱ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ደሜንሼ ዬሮ ጎጉት እራ ጨጨበ፤","poem":1},{"text":"ዱበርቶትንስ ዹፈኒ እብደት ነቀቱ።","poem":2},{"text":"ኡመትን ኩን ሁበትና ህንቀቡቲ፤","poem":1},{"text":"ከናፉ ቶልቻንሳኒ ገራ ህንላፉፍ፤","poem":2},{"lineBreak":true},{"text":"ኡማንሳኒስ እሳኒፍ ህንአራረሙ።","poem":2}]},{"type":"verse","number":12,"content":["በረ ሰነ ዋቀዮ ለገ ኤፍራጢሲ ሀመ ለገ ግብጥት ምዻን ዸአ፤ ያ እስራኤሎተ፣ እስን ቶኮ ቶኮን ወልት ንቀበምቱ።"]},{"type":"verse","number":13,"content":["በረ ሰነ መለከትን ጉዳን ቶኮ ንአፉፈመ። ወር አሶር ኬሰት በደኒ ቱረኒፊ ወር ግብጥ ኬሰት ፈፈጨአኒ ቱረን ዹፈኒ ቱሉ ቁልቁሉረት ዬሩሳሌም ኬሰት ዋቀዮን ዋቄፈቱ።"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/26.json","previousChapterAudioLinks":{},"numberOfVerses":13}