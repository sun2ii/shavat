{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":28,"content":[{"type":"heading","content":["ሆገንቶተ ኤፍሬሚፍ ወዮ"]},{"type":"verse","number":1,"content":[{"text":"ጎንፎ ኦፍ ቱሉማ ከን መቾፍቶተ ኤፍሬም ሰናፍ፣","poem":1},{"text":"ደራራ ጮለጉ ከን ኡልፍነ ሚዸግነሳኒቲፍ፣","poem":2},{"text":"ከን መታ ሱሉለ ገበታረ ጅሩፍ፣","poem":1},{"text":"መጋላ ወረ ዳዺ ወይኒቲን ፉዸተመንሰናቲፍ ወዮ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ኩኖ፣ ጎፍታን እሰ ሁምነ ቀቤሳፊ ጀባ ቶኮ ቀበ።","poem":1},{"text":"እን አኩመ ጨቢቲፊ ቡቤ ዋ በሌሱ፣","poem":2},{"text":"አኩመ ቦካ ጀባቲፊ ብሻን ጉቴ እረ ዸንገለኡ፣","poem":1},{"text":"ሁምናን ለፈት ገድ እሼ ደርበተ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ጎንፎን ኦፍ ቱሉማ፣","poem":1},{"text":"መቾፍቶትን ኤፍሬም ሚለ ጀለት ዽዺተሙ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ደራራን ሀርጨኡ፣ ሚዸግንሳ ከበጀማን፣","poem":1},{"text":"ከን መታ ሱሉለ ገበታረ ጅሩ ሱን፣","poem":2},{"text":"አኩመ ሙከ ሀርቡ ኡቱ ቦን ህንገእን ብልቻቱ ሰና ተአ፤","poem":1},{"text":"ነምን እሰ አርጉ ሁንድ አኩመ እሰ ሀርከ ኬሰ ገልፈቴንእሰ ኛቴ ፍጠ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"በረ ሰነ ዋቀዮ ዋን ሁንደ ደንደኡ","poem":1},{"text":"ሀምባ ሰበሳቲፍ፣","poem":2},{"text":"ጎንፎ ኡልፍና፣","poem":1},{"text":"ምአ ሚዸግና ንተአ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እን ነመ ሙርቲ ኬኑፍ ታኡፍ ሀፉረ ሙርቲ ቀጄላ ተአ፤","poem":1},{"text":"ወረ ከረራ ወራነ ዴብሰኒፍሞመደ ጀብና ተአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ጀር ኩን ዳዺ ወይኒቲን ገተንተሩ፤","poem":1},{"text":"ዹጋቲ ጀባዻን ዶጎጎሩ፤","poem":2},{"text":"ሉቦትኒፊ ራጆትን ዹጋቲ ጀባዻን ገተንተሩ፤","poem":1},{"text":"ዳዺ ወይኒቲን ፉዸተሙ፤","poem":2},{"text":"እሳን ዹጋቲ ጀባዻን ከራራ በዱ፤","poem":1},{"text":"ዬሮ ሙልአተ አርገንትስ ንዶጎጎሩ፤","poem":2},{"lineBreak":true},{"text":"ዬሮ ሙርቲ ኬነንትስ ንዶጎጎሩ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ማዲን ሁንድኑ ድድጋን ጉተሜረ፤","poem":1},{"text":"እዶን ህንጡሬፈምን ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ነምን እን ዋ በርሲሱ ያሉ ኩን ኤኙ?","poem":1},{"text":"እን ኤኙፍ ኤርጋሳ እብሳ ጅረ?","poem":2},{"text":"እጆሌ ኣነን ዺፍቴፍሞ","poem":1},{"text":"እጆሌ ሀርመ ጉቴፍ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አጀጀረት አጀጀ፤ አጀጀረት አጀጀ፤","poem":1},{"text":"ስርነረት ስርነ፤ ስርነረት ስርነ፤","poem":2},{"lineBreak":true},{"text":"አስት ሙራሰ፤ አችት ሙራሰ” ተኣቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ዮስ ዋቅን አፋን አለጎታቲን፣","poem":1},{"text":"አፋን ህንቤከምኔንስ ሰበ ከነት ንዱበተ፤","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እን አከነ እሳኒን ጄዼ፤","poem":1},{"text":"“ኩን እዶ ቦቆናት፤ ወር ደዸበን ሃቦቆተን፤","poem":2},{"text":"ኩን እዶ ኣረ ገልፈትናት።”","poem":1},{"text":"እሳን ገሩ ዸገኡ ድደን።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዮ አከሲ ዱቢን ዋቀዮ አከነ እሳንት ተአ፤","poem":1},{"text":"አጀጀረት አጀጀ፤ አጀጀረት አጀጀ፤","poem":2},{"text":"ስርነረት ስርነ፤ ስርነረት ስርነ፤","poem":1},{"text":"አስት ሙራሰ፤ አችት ሙራሰ፤","poem":2},{"text":"ኩንስ አከ እሳን ዸቀኒ ዱግደ ዱበት ኩፈኒፊ","poem":1},{"text":"አከ እሳን ጨጨበኒ ክዮዻን ቀበመኒፍ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ከናፉ እስን ቆስቶትን","poem":1},{"text":"ወር ኡመተ ዬሩሳሌም ቡልችተን ዱቢዋቀዮ ዸገኣ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እስን አከነ ጄተኒ ኦፍ ቱልቱ፤ “ኑ ዱአ ወጅን ከኩ ገሌረ፤","poem":1},{"text":"ሲኦል ወጅንስ ወሊ ገልቴ ጎኔረ።","poem":2},{"text":"ሰበቢ ኑ ሶበ ደኦ ጎዸትኔ፣","poem":1},{"text":"ሶበስ እዶ እት ዾከትኑ ጎዸኔፍ፣","poem":2},{"text":"በላን ሀማን ዬሮ ዹፌ ለፈ በሌሱት","poem":1},{"text":"ኑ ቱቁ ህንደንደኡ።”","poem":2}]},{"type":"verse","number":16,"content":["ከናፉ ዋቀዮ ጎፍታን አከነ ጄዸ፤",{"text":"“ኩኖ አን ዸጋ ቶኮ፣ ዸጋ ቆረተሜ፣","poem":1},{"text":"ዸጋ ጎሌ ገት ጀቤሰ ቶኮ","poem":2},{"text":"ሁንዴ ምርከናኣዻፍ ጥዮን ኬሰ ነንካአ፤","poem":1},{"text":"ነምን አመኑ ከምዩ ህንቃነኡ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አን ሙርቲ ቀጄላ ፉኞ እቲን ሰፈረን፣","poem":1},{"text":"ቀጄሉማሞ መዳሊ ነንጎዸዸ፤","poem":2},{"text":"ሶበ እስን ደኦ ጎዸተን ሰነ ቦካን ጀባን ንበሌሰ፤","poem":1},{"text":"ብሻንስ ለፈ እስን እት ዾከተን ኬሰ ንሎለአ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ከኩን እስን ዱአ ወጅን ጎዸተን ንዲገመ፤","poem":1},{"text":"ወሊ ገልቴን እስን ሲኦል ወጅን ጎዸተንስንበርበዴፈመ።","poem":2},{"text":"ዬሮ በላን ሀማን ዹፌ ለፈ በሌሱት","poem":1},{"text":"እስን ለፈት ገድ ዽዺተምቱ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እን ዬሮ ዹፉ ሁንደ እስን ፉዸቴ ዴመ፤","poem":1},{"text":"ገነመ ገነመ ሀልከኒፊ ጉያስ፣እን ዋ በሌሰ።”","poem":2},{"lineBreak":true},{"text":"ኤርጋ ከነ ሁበቹን","poem":1},{"text":"ናሱ ጉዳ ነመት ፍደ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ስሬን እረት ድሪርፈቹፍ ባይኤ ገባባዸ፤","poem":1},{"text":"ኡፈተ ሀልከኒ ኦፍት መረቹፍ ባይኤ ዽጳዸ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዋቀዮ ሆጂሳ፣ ሆጂሳ ሃራ ሰነ ሆጄቹፍ፣","poem":1},{"text":"ጎቸሳ፣ ጎቸሳ ከን ህንቤከምኔ ሰነ ሆጄቹፍ፣","poem":2},{"text":"አኩመ ቱሉ ጴራዚም ኬሰት ጎዼ ሰነ ንከአ፤","poem":1},{"text":"አኩመ ሱሉለ ግቤኦንት ጎዼ ሰነ ንከአ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"አመ ቆሳኬሰን ዺሳ፤","poem":1},{"text":"ዮ አከስ ህንተእን ፎንጫንኬሰን እስንት ጀባተ፤","poem":2},{"text":"ጎፍታን፣ ዋቀዮ ዋን ሁንደ ደንደኡ፣","poem":1},{"text":"ለብሲ ጉቱማ ብየቲ በሌሱፍ ለብሴ ነት ህሜረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ዸጌፈዻቲ ሰገሌኮ ዸገኣ፤","poem":1},{"text":"ቀልቤፈዻቲ ዋን አን ዱበዹ ዸገኣ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ቆናን ቡላን ቶኮ ዬሮ ሰኚ ፈጫሱፍ ለፈ ቆተቱት፣እቱመ ፉፌ ቆታ?","poem":1},{"text":"እን እቱመ ፉፌ ብዮ ጨጨብሴ ቡሌሳ?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"እን ዬሮ ለፈ ወል ቅጤሱት","poem":1},{"text":"ድምብላላፊ ከሙኒ ህንፈጫሱ?","poem":2},{"text":"እን ቀመዲ ቶረ ቶራን፣","poem":1},{"text":"ገርቡ እዶሳረት፣","poem":2},{"lineBreak":true},{"text":"ሆንቦሪስ ለፈ ቆቲሳሳረት ህንፈጫሱ?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዋቅንሳ እሰ በርሲሰ፤","poem":1},{"text":"ከራ ቀጄላረስ እሰ ቡሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"አበሱድን ገንገልቻዻን ህንዸአሙ፤","poem":1},{"text":"ከሙኒ እረስ ጎማን ጋሪ ህንኦፈሙ፤","poem":2},{"text":"አበሱድን ኡሌዻን፣","poem":1},{"text":"እንስላልሞ ሽመላን ዸአመ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ምዻን ቡዴነ ቶልቹፍ ዳከሙ ቀበ፤","poem":1},{"text":"ከናፉ ነምን ቶኮ በረ በራን ምዻን ህንዸኡ።","poem":2},{"text":"እን ጎማ ጋሪ ከን ምዻን ዸኡ ምዻን ሰነረ ኦፉዩ","poem":1},{"text":"ፈርዴንሳ ምዻንቸ ህንቡሌሰን።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ወን ኩን ሁንድኑ ዋቀዮ ዋን ሁንደ ደንደኡ፣","poem":1},{"text":"እሰ መሪዻን ድንቅሲሳ፣","poem":2},{"lineBreak":true},{"text":"ኦጉማዻንስ ጉዳ ተኤ ብራ ዹፈ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/27.json","previousChapterAudioLinks":{},"numberOfVerses":29}