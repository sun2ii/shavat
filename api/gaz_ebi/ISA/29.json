{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":29,"content":[{"type":"heading","content":["መጋላ ዳዊቲፍ ወዮ"]},{"type":"verse","number":1,"content":[{"text":"ያ አሪኤል፣ ያ አሪኤል፣","poem":1},{"text":"መጋላ ዳዊት ኬሰ ጅራቴ፣ ሲፍ ወዮ!","poem":2},{"text":"ወጋረት ወጋ ደበላ፤","poem":1},{"text":"አያኖትን ወጋስ እቱመ ሃፉፈን።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ተኡስ አን አሪኤልን መርሴ ነንቀበ፤","poem":1},{"text":"እሼን ቦሴ ንወዋት፤","poem":2},{"lineBreak":true},{"text":"እሼን አናፍ አከ አሪኤል ታት።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አን ከራ ሁንዳን ናኖኬ ነንቁበዸ፤","poem":1},{"text":"ገሞወኒንስ ስን መርሰ፤","poem":2},{"lineBreak":true},{"text":"ቱላ ብዮስ ስት ናኔሴ ነንዻበ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አት ገድ ዴብፈምቴ ለፈራ ንዱበተ፤","poem":1},{"text":"ሃሳንኬ ብዮ ኬሳ ጉንጉመ።","poem":2},{"text":"ሰገሌንኬ አከ ሰገሌ ኤኬራ ለፈ ኬሳ በአ፤","poem":1},{"text":"ሃሳንኬስ ብዮ ኬሳ ሀሳሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ዲኖትንኬ ሄዱን ገሩ አከ አዋረ ቡላኤ፣","poem":1},{"text":"ገረ ጀቤዪን ባይኤንስ አከ ሀበቂ ቡቤን ፉዸቴ ተኡ።","poem":2},{"text":"አኩመ ተሳ ኡቱ ህንቤከምንስ፣","poem":1}]},{"type":"verse","number":6,"content":[{"text":"ዋቀዮ ዋን ሁንደ ደንደኡ፣","poem":2},{"text":"በከካዻን፣ ሶቺ ለፋቲፊ ወጨ ጉዳዻን፣","poem":1},{"text":"ቡቤዻን፣ ቡቤ ሀማፊ አረበ እብደ ዋ ፍጡቲን ንዹፈ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኤርገሲ ቱትን ሰቦተ ሁንዳ ከን አሪኤሊን ሎሉ፣","poem":1},{"text":"ከን እሼፊ ደኦሼ ጀጀቦ ዸኤ መርሴ ቀቡ፣","poem":2},{"text":"አኩመ አብጁ፣","poem":1},{"text":"አኩመ ሙልአተ ሀልከን ኬሳ ተአ፤","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኩንስ አኩመ ነምን ቤለኤ ቶኮ አከ ዋ ኛቻ ጅሩ አብጁዻን አርጌ","poem":1},{"text":"ዬሮ ደመቁት ገሩ አመሌ ቤለ ቀቡ ሰነ፣","poem":2},{"text":"ዮካን አኩመ ነምን ዼቦቴ ቶኮ አከ ዋ ዹጋ ጅሩ አብጁዻን አርጌ","poem":1},{"text":"ዬሮ ደመቁት ገሩ አመሌ ዼቡዻን ገገቡ ሰነ ተአ።","poem":2},{"text":"ቱተ ሰቦተ ሁንዳ","poem":1},{"text":"ከን ቱሉ ጥዮን ሎሉረትስ አከሱመ ተአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ርፈዻ፤ ድንቅሲፈዻስ፤","poem":1},{"text":"ኦፍ ጃምሳቲ ነመ ዋ ህንአርግኔ ተኣ፤","poem":2},{"text":"መቻኣ፤ ገሩ ዳዺ ወይኒቲን ህንተእን፤","poem":1},{"text":"ገተንተራ፤ ገሩ ዹጋቲ ጀባዻን ህንተእን።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዋቀዮ ህርበ ጭማ እስንት ቡሴረ፤","poem":1},{"text":"እጀኬሰን ራጆተ፣ ጩፌረ፤","poem":2},{"lineBreak":true},{"text":"መታኬሰን እላልቶተስ፣ ሀጉጌረ።","poem":2}]},{"type":"verse","number":11,"content":["ሙልአትን ኩን ሁንድ እስኒፍ ዱቢ ክታበ መረማረት ቻፔፈሜ መሌ ሆማ ምት። ዮ እስን ክታበ ከነ ነመ ዱብሱ ደንደኡ ቶኮት ኬንተኒ፣ “ማሎ ሜ ዋን ከነ ዱብስ” ጄተኒን እን፣ “ሰበቢ ክታብች ቻፔፈሜፍ አን ዱብሱ ህንደንደኡ” ጄዼ ዴብሰ።"]},{"type":"verse","number":12,"content":["ዮካን ዮ እስን ክታበ መረማ ከነ ነመ ዱብሱ ህንደንዴኜ ቶኮት ኬንተኒ፣ “ማሎ ሜ ዋን ከነ ዱብስ” ጄተኒን እን፣ “አን አከምት አከን ዱብሱ ህንቤኩ” ጄዼ ዴብሰ።"]},{"type":"verse","number":13,"content":["ጎፍታን አከነ ጄዸ፦",{"text":"“ኡመትን ኩን አፋንሳቲን ነት ዽኣተ፤","poem":1},{"text":"ህዺሳቲንስ ነ ከበጀ፤","poem":2},{"lineBreak":true},{"text":"ገራንሳ ገሩ ነራ ፈጎ ጅረ።","poem":2},{"text":"ዋቄፈትናን እሳን ነ ዋቄፈተንስ","poem":1},{"text":"ሴረ ነምን በርሲሱ ቆፋን ቶልፈሜ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ከናፉ አን አመሌ ድንቂረት ድንቂ ደበሌ","poem":1},{"text":"ኡመተ ከነ ነንድንቅሲሰ፤","poem":2},{"text":"ኦጉማን ነመ ኦጌሳ ንበደ፤","poem":1},{"text":"ሁበትናን ሁበቶታስ ንዾከተ።”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ወረ ከሮረሳኒ","poem":1},{"text":"ዋቀዮ ዱራ ዾክፈቹፍ ጄዸኒቅሌት ገድ ቡአኒፍ፣","poem":2},{"text":"ወረ ሆጂሳኒ ዱከነ ኬሰት ሆጄተኒ፣","poem":1},{"text":"“ኤኙቱ ኑ አርገ? ኤኙቱ ቤከ?”ጄዸኒ ያደኒፍ ወዮ!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኩን ጀልእነኬሰን፣","poem":1},{"text":"ሱጴ ዾፍቱ አከ ሱጴት እላልቱ!","poem":2},{"text":"ወን ቶልቸሜ ቶኮ ነመ እሰ ቶልቼን","poem":1},{"text":"“እን ነ ህንቶልችኔ” ጄዻ?","poem":2},{"text":"ኦኮቴን ቶኮ ሱጴ ዾፍቱዻን፣","poem":1},{"text":"“እን ሆማ ህንቤኩ” ጄቹ ደንደኣ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ልባኖን ዬሮ ገባባ ኬሰትለፈ ቆቲሳ ገበቴ ህንታቱ?","poem":1},{"text":"ለፍት ቆና ገበታን ሱንስ ቦሶነ ህንፈካቱ?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ጋፈስ ዱዳን ዱቢ ክታበ መረማ ንዸገአ፤","poem":1},{"text":"እጅ ነመ ጃማ ድምምሳፊ ዱከነ ኬሰት ንአርገ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ነምን ገድ ኦፍ ቀቡ አመስ ዋቀዮት ንገመደ፤","poem":1},{"text":"ረከቶትንስ ቁልቁልቸ እስራኤል ሰናን ንገመዱ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ገረ ጀቤዪን ንበዱ፤","poem":1},{"text":"ወር ነመት ቆሰን ንበርበዳኡ፤","poem":2},{"lineBreak":true},{"text":"ወር ሀምነ ሆጄቹ ጃለተን ሁንድኑ ንበሌፈሙ፤","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ወር ዱቢን የከማ ነመ ጎዸን፣","poem":1},{"text":"ወር ነምቸ መነ ሙርቲት ነማፍ ፈልሙ ዱረ ክዮ ካአኒ","poem":2},{"text":"ሶባን ዹጋ በኡዻን","poem":1},{"text":"ሙርቲ ቀጄላ ነመ የከ ህንቀብኔ ጀልእሰን ንበሌፈሙ።","poem":2}]},{"type":"verse","number":22,"content":["ከናፉ ዋቀዮ እን አብረሃምን ፉሬ ሱን መነ ያቆቢን አከነ ጄዸ፦",{"text":"“ያቆብ ስአች ዴብኤ ህንቃነኡ፤","poem":1},{"text":"ፉልሳስ ስአች ህንዱከናኡ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"እሳን ዬሮ ግዱሳኒት እጆሌሳኒ","poem":1},{"text":"ሆጂ ሀርከኮቲ ሰነ አርገንት፣","poem":2},{"text":"መቃኮ ንቁልቁሌሱ፤","poem":1},{"text":"እሳን ቁልቁሉማ ቁልቁልቸ ያቆብ ንቤኩ፤","poem":2},{"lineBreak":true},{"text":"ዋቀ እስራኤልስ ሶዳቹዻን ንጅራቱ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ወር ዶጎጎረን ሁበትና ንአርገቱ፤","poem":1},{"text":"ወር ጉንጉመንስ ቀጄልፈመ ንፉዸቱ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/28.json","previousChapterAudioLinks":{},"numberOfVerses":24}