{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":3,"content":[{"type":"heading","content":["ሙርቲ ዬሩሳሌሚፊ ይሁዳ ኤገቱ"]},{"type":"verse","number":1,"content":[{"text":"ኩኖ ጎፍታን፣","poem":1},{"text":"ዋቀዮ ዋን ሁንደ ደንደኡ","poem":2},{"text":"ዬሩሳሌሚፊ ይሁዳራ","poem":1},{"text":"ኬናፊ ገርጋርሰሳ","poem":2},{"text":"ከን ምዻኒቲፊ ከን ብሻኒ ሁንደ እራ ፉዸተ፤","poem":1}]},{"type":"verse","number":2,"content":[{"text":"ጎታፊ ሎልቱ፣","poem":2},{"text":"አባ ሙርቲቲፊ ራጂ፣","poem":1},{"text":"ሆደ ህማፊ ማንጉዶ፣","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አጀጃ ሸንተማቲፊ ነመ ኡልፍነ ቀቡ፣","poem":1},{"text":"ጎርስቱ፣ ኦጌሰ ሆጂ ሀርካቲፊኦጌሰ ዋ ደዌሱ ቤኩራ ፉዸተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“አን ደርገጎተ ቆንዳልቶተሳኒ ነንጎዸ፤","poem":1},{"text":"እጆሌን እሳን ቡልቹ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ነሞትን ወል ሀጩጩ፤","poem":1},{"text":"ነምን ቶኮ ነመ ካንት፣ ኦላንስ፣ ኦላሳት ከአ።","poem":2},{"text":"ደርገጌስ ጃርሰት፣","poem":1},{"text":"ቱፈተማንስ ከበጀማት ከአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ነምን ቶኮ መነ አባሳት፣","poem":1},{"text":"ኦቦሎተሳ ኬሳ ቶኮ ቀቤ፣","poem":2},{"text":"“አት ቆሎ ቀብደ፤ ከናፉ ቡልቻ ኑፍ ተእ፤","poem":1},{"text":"ቱላ ዋን ዲገሜ ከነትስ እት ጋፈተመ ፉዹ!” ጄዸ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እን ገሩ ጋፈስ፣","poem":1},{"text":"“አን ፉርማተ ተኡ ህንደንደኡ።","poem":2},{"text":"አን ኛተ ዮካን ኡፈተ ቶኮሌ መነኮቲ ህንቀቡ፤","poem":1},{"text":"ቡልቻ ሰባ ነ ህንታስስና” ጄዼ እየ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ዬሩሳሌም ገተንተራ ጅርት፤","poem":1},{"text":"ይሁዳንሞ ኩፍቴርት፤","poem":2},{"text":"ዱቢሳኒቲፊ ጎችሳኒ ዋቀዮን ሞርሙዻን","poem":1},{"text":"ኡልፍነ አርገሙሳ ጡሬሰ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሃል ፉለሳኒ ዹጋ እሳንት በአ፤","poem":1},{"text":"እሳን አኩመ ሶዶም ጩቡሳኒ እፈ ባሱ፤","poem":2},{"lineBreak":true},{"text":"እሳን ጩቡሳኒ ህንዾክፈተን።","poem":2},{"text":"እሳኒፍ ወዮ!","poem":1},{"text":"እሳን በላ ጉዳ ኦፍት ፍደኒሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"አከ ወን ኩን እሳኒፍ ቶሉ ቀጄልቶተት ህማ፤","poem":1},{"text":"እሳን ቡኣ ሆጂሳኒ ኛቱ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሀማዻፍ ወዮ!","poem":1},{"text":"በዲስን እሰት ንዹፈ!","poem":2},{"text":"እን ገቲ ሀርከሳ ንአርገተ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ደርገጎትን ሰበኮ ጩንቁርሱ፤","poem":1},{"text":"ዱበርቶትን እሳን ቡልቹ።","poem":2},{"text":"ያ ሰበኮ፣ ቀጄልችቶትንኬሰን ከራራ እስን ጀልእሰኒሩ፤","poem":1},{"text":"እሳንራ እስን ጎርሰኒሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ዋቀዮ ሙርቲ ኬኑፍ ታኤረ፤","poem":1},{"text":"ሰበ እሳትስ ሙሩፍ ከኤረ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዋቀዮ አከነ ጄዼ","poem":1},{"text":"ማንጉዶታፊ ሆገንቶተ ሰበሳት ሙረ፦","poem":2},{"text":"“ከን እዶ ዻባ ወይኒኮቲ በሌሴ እስን፤","poem":1},{"text":"ወን ህዬዪራ ሳመሜ መነኬሰን ጅረ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እስን ሰበኮ ጨጨብሱንኬሰን፣","poem":1},{"text":"ፉለ ህዬዪስ ቡቱቹንኬሰን ማል ጎቹኬሰን?” ጄዸ ጎፍታን፣","poem":2},{"lineBreak":true},{"text":"ዋቀዮ ዋን ሁንደ ደንደኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ዋቀዮ አከነ ጄዸ፤","poem":1},{"text":"“ዱበርቶትን ጥዮን ኦፍ ቱሉ፤","poem":2},{"text":"እሳን ሞርመ ዼሬፈተኒ ያኡ፤","poem":1},{"text":"እጃንስ ንዋመቱ፤","poem":2},{"lineBreak":true},{"text":"ፋየ ሚለሳኒ ክልልሳ ጭላንፈቻ ዴሙ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ከናፉ ጎፍታን መታ እንተለን ጥዮንት ቃቄ ንፍደ፤","poem":1},{"text":"ዋቀዮ ጉቤ መታሳኒ ሞሌሰ።”","poem":2}]},{"type":"verse","number":18,"content":["ጋፈስ ጎፍታን ፋየ ሚዸግነሳኒ፦ አልቡ፣ መረተ መታ፣ ፋየ ሞርማ ከን ባቲ ፈካቱ፣"]},{"type":"verse","number":19,"content":["አመርቲ ጉራ፣ ብተዎ፣ ሀጉጊ ፉላ፣"]},{"type":"verse","number":20,"content":["መረተ መታ፣ ፋየ ሚላ፣ ሰበተ፣ ብልቃጢ ሽቶ፣ ኩዻመ፣"]},{"type":"verse","number":21,"content":["ቁቤላ ቻፓ፣ አመርቲ ፉኛኒ"]},{"type":"verse","number":22,"content":["ወንደቦ ፍለተማ፣ ኮፍያ፣ ቆሎ፣ ኮሮጆ ሀርካ፣"]},{"type":"verse","number":23,"content":["ኦፍ እላሌወን፣ ወያ ቁንጬ ተልባራ ሆጄተሜ፣ ጎንፎ ዱበርቶታቲፊ ኡፈተ ሞርማ እሳንራ ሙልቀ።"]},{"type":"verse","number":24,"content":[{"text":"ቆደ ኡርጋ፣ አጃ፤","poem":1},{"text":"ቆደ ሰበታ፣ ፉኞ፤","poem":2},{"text":"ቆደ መታ ስሪት ዸአሜ፣ ሞሉ፤","poem":1},{"text":"ቆደ ኡፈተ ሚዸጋ፣ ወያ ገዳ፤","poem":2},{"lineBreak":true},{"text":"ቆደ ሚዸግና ፎክሱቱ ዹፈ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ነሞትንኬሰን ጎራዴዻን፣","poem":1},{"text":"ሎልቶትንኬሰንስ ሎለ ኬሰት ዹሙ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ከር ጥዮን ፋርስቴ ቦስ፤","poem":1},{"text":"እሼን ኦንቴ ለፈ ቴስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}