{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":30,"content":[{"type":"heading","content":["ሰበ ፍንጭላዻፍ ወዮ"]},{"type":"verse","number":1,"content":[{"text":"ዋቀዮ አከነ ጄዸ፦","poem":1},{"text":"“እጆሌ ፍንጭለን፣","poem":2},{"text":"ከኔን ከሮረ ከሮረኮ ህንተእን ዱካ ቡአን፣","poem":1},{"text":"ከኔን ፌዺኮቲን አለት ወሊ ገልቴ ኡመን፣","poem":2},{"lineBreak":true},{"text":"ከኔን ጩቡረት ጩቡ ደበለኒፍ ወዮ፤","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ከኔን ኡቱ አናን ህንመርአትን ግብጥት ገድ ቡአን፣","poem":1},{"text":"ከኔን ጋድሰ ግብጥ ደኦፍ፣","poem":2},{"text":"ኤጉምሰ ፈረኦንሞ","poem":1},{"text":"ገርጋርሳፍ አብደተኒፍ ወዮ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኤጉምስ ፈረኦን ገሩ ቃኒ እስንት ተአ፤","poem":1},{"text":"ጋድስን ግብጥስ ሰልጵነ እስንት ፍደ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እሳን ዮ ዞኣን ኬሰት ቆንዳልቶተ ቀባተንዩ፣","poem":1},{"text":"ዮ ኤርገሞትንሳኒስ ሃኔስ ገአንዩ፣","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ቶኮን ቶኮንሳኒ ሰበቢ ኡመተ እሳን ህንፈየድኔ","poem":1},{"text":"ከኔን ቃኒፊ ሰልጵነ መሌ","poem":2},{"text":"ገርጋርሰ ዮካን ቡኣ ህንኬንኔ","poem":1},{"text":"ሰናቲፍ ንቃኔፈሙ።”","poem":2}]},{"type":"verse","number":6,"content":["ራጂ ዋኤ ብኔንሶተ ኔጌብ ዱበተሜ፦",{"text":"ኤርገሞትን ቀቤኘሳኒ ሀሬት፣","poem":1},{"text":"ሜሻሳኒ ጋለት ፌአተኒ","poem":2},{"lineBreak":true},{"text":"ብየ ሌንጭ ኮርሚፊ ሌንጭ ዸላን፣","poem":2},{"text":"ቦፍት ሱሚ ቀቡፊ ቦፍት ደርበተሙ ጅራተን፣","poem":1},{"text":"ለፈ ረክናፊ ዽጵናን ጉቴ ኬሰ በአኒ","poem":2},{"text":"ገረ ብየ ሆማ ህንፈየድኔ","poem":1}]},{"type":"verse","number":7,"content":[{"text":"ገረ ግብጥ ከን ገርጋርስሼ ጎንኩማ ቡኣ ህንቀብኔ ሰና ዸቁ።","poem":2},{"text":"ከናፉ አን፣ “ረኣብ፣ ከን ሆማ ህንፈየድኔ”","poem":1},{"text":"ጄዼ እሼ ነንዋመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"አመ ዸቂቲ ገበቴረት በሬሲፍ፤","poem":1},{"text":"ክታበ መረማረት ከተቢፍ፤","poem":2},{"text":"ኩንስ አከ በሮተ ዹፉፍ ጅረን ኬሰ","poem":1},{"text":"ዹገ በኡምሰ በረ በራ ተኡፍ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ጀር ኩኔን ኡመተ ፍንጭላ፣ እጆሌ ሶብዱዸ፤","poem":1},{"text":"እጆሌ ሴረ ዋቀዮ ዸገኡፍ ፌዺ ህንቀብኔዸ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እሳን ሙልአተ አርግቶታን፣","poem":1},{"text":"“ስአች ሙልአተ ቶኮሌ ህንአርግና!” ጄዹ፤","poem":2},{"text":"ራጆታንስ አከነ ጄዹ፤","poem":1},{"text":"“እስን ስአች ሙልአተ ቀጄላ ተኤ ኑት ህንህምና!","poem":2},{"text":"ዋን ነመ ገመቺሱ ኑት ህማ፤","poem":1},{"text":"ጎዎምሳ ኑፍ ራጃ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ከራ ከነ ገድ ዺሳ፤","poem":1},{"text":"ዳንዲ ከነራ ጀልአዻ፤","poem":2},{"text":"ቁልቁልቸ እስራኤል ፉለኬኘ ዱራ","poem":1},{"text":"ዸበምሲሳ!” ጄዹ።","poem":2}]},{"type":"verse","number":12,"content":["ከናፉ ቁልቁልች እስራኤል አከነ ጄዸ፦",{"text":"“ሰበቢ እስን ኤርጋ ከነ ድደኒ","poem":1},{"text":"ነመ ሀጩጩ አብደተኒ","poem":2},{"lineBreak":true},{"text":"ጎዎምሳት እርከተኒፍ፣","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ጩቡን ኩን፣ አኩመ ደላ ኦል ዼራ","poem":1},{"text":"ዸጋን እጃረሜ ከን በቀቄ ቦሶሴ","poem":2},{"lineBreak":true},{"text":"ከን ኡቱ ህንቤከምን ተሰ ጅጉ እስንት ተአ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ደላን ሱን አኩመ ምአ ሱጴት፣","poem":1},{"text":"ሀመ ወን እቲን ጭሌ ቦበኡ","poem":2},{"text":"እዶ እብዳቲ ፉዸንዩ ህንሀፍኔት","poem":1},{"text":"ዮካን ሀመ ወን እቲን ቦለ ብሻኒ ኬሳ","poem":2},{"lineBreak":true},{"text":"ብሻን ቡዱቅሰን ህንሀፍኔት አከ መሌ ጨጨቤ ቡርኩታአ።”","poem":2}]},{"type":"verse","number":15,"content":["ዋቀዮ ጎፍታን፣ ቁልቁልች እስራኤል አከነ ጄዸ፦",{"text":"“ዴብኡፊ ቦቆቹዻን ንፈይቱ፤","poem":1},{"text":"ተስገባኡፊ አብደቹዻን ንጀባቱ፤","poem":2},{"lineBreak":true},{"text":"እስን ገሩ ከነ ህንጎኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እስንስ፣ ‘ለክ፣ ኑ ፈርዴኒን ንበቀትነ’ ጄቱ።","poem":1},{"text":"ከናፉ እስን ንበቀቱ!","poem":2},{"text":"እስን፣ ‘ኑ ፈርዴን አሪፈተኒ ፊገኒን ንጉሉፍነ’ ጄቱ።","poem":1},{"text":"ከናፉ ወር እስን ጉግሰን ንሰፍሱ!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዶርስሰ ነመ ቶኮቲን፣ ኩመቱ በቀተ፤","poem":1},{"text":"ዶርስሰ ነመ ሸኒቲንሞ፣","poem":2},{"lineBreak":true},{"text":"እስን ሀመ አኩመ ሙከ አላባ ፊጤ ቱሉረ ጅሩ፣","poem":2},{"text":"አኩመ ፋጂ ጋረረ ጅሩ ታተኒ ሀፍተንት","poem":1},{"text":"ሁንድኬሰን ንበቀቱ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ተኡስ ዋቀዮ እስኒፍ አርጆሙ በርባደ፤","poem":1},{"text":"እስኒፍ ነኡፍስ ንከአ፦","poem":2},{"text":"ዋቀዮ ዋቀ ሙርቲ ቀጄላት።","poem":1},{"text":"ወር እሰ ኤገተን ሁንድ ኤብፈሞዸ።","poem":2}]},{"type":"verse","number":19,"content":["ያ ሰበ ጥዮን፣ ወር ዬሩሳሌም ኬሰ ጅራተን፣ እስን ስአች ህንቦሰን። ዬሮ እስን ገርጋርሰ በርባቻፍ ገረሳት እየተንት እን ዹጉማን እስኒፍ አርጆመ! አኩመ ዸገኤንስ ዴቢ እስኒፍ ኬነ።"]},{"type":"verse","number":20,"content":["ጎፍታን ቡዴነ ረክናቲፊ ብሻን ዽጵና ሲፍ ኬኑሌ በርሲሳንኬ ስአች ህንዾከቱ፤ አት እጁመኬቲን እሰ አርግተ።"]},{"type":"verse","number":21,"content":["አት ዬሮ ገረ ምርጋት ዮካን ገረ ብታት ጎርቱት፣ ዱግደኬ ዱባን ሰገሌ፣ “ከራን ከነ፤ እሰረ ዴም” ጄዹ ቶኮ ጉርኬ ንዸገአ።"]},{"type":"verse","number":22,"content":["አት ኤርገሲ ዋቆተኬ ቶልፈሞ ከኔን ሜቲን እረ ድበሜፊ ፈኪወንኬ ከኔን ወርቄን እት ኡፍፈሜ ሰነ ንጡሬስተ፤ አኩመ ሁጩ ጡራኡማስ ኦፍራ እሳን ደርበቴ፣ “አሲ በዳ!” ጄታን።"]},{"type":"verse","number":23,"content":["እን ሰኚ አት ለፈት ፈጫፈቱፍ ቦካ ሲፍ ኬነ፤ ምዻን ለፍት ባፍቱስ ከን ምሴፊ ከን አከ መሌ ባይአቴ ተአ። በረ ሰነ ኬሰ ሎንኬ ለፈ ዼዳ በልኣረት ቦበኡ።"]},{"type":"verse","number":24,"content":["ቆትዮፊ ሀሬን ቆቲሳ ኦካ ፍለተማ ቆርቢፊ አፈርሳዻን ቁልቁሌፈሜ ኛቱ።"]},{"type":"verse","number":25,"content":["ጉያ በዲሰ ጉዳት፣ ዬሮ ቆጢወን ኤጉምሳ ጅጅገንት ያአወን ብሻኒ ቱሉወኒፊ ጋረን ኦል ዼዼሮ ሁንደረ ያኡ።"]},{"type":"verse","number":26,"content":["ጋፈ ዋቀዮ ጨባ ሰበሳ ህዼ ወረ መዴሴሌ ፈይሱት ጅእ አኩመ አዱ እፈ፤ እፍን አዱስ አኩመ እፈ ጉያ ቶርባ ደቻ ቶርበ ንእፈ።"]},{"type":"verse","number":27,"content":[{"text":"ኩኖ መቃን ዋቀዮ ኣሪ ቦበኡፊ","poem":1},{"text":"ዱሜሰ ጎቡ ኣራቲን ፈጎዻ ዹፋ ጅረ፤","poem":2},{"text":"አፋንሳ ዼከምሳን፣","poem":1},{"text":"አረብንሳስ እብደ ጉቤ በሌሱን ጉተሜረ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ሀፉር እን ባፈቱ አኩመ ለገ ጉቴ","poem":1},{"text":"ሀመ ሞርመ ገኡት ኦል ከኡት።","poem":2},{"text":"እን ግንግልቻ በዲሳቲን ሰቦተ ግንግልቸ፤","poem":1},{"text":"እን ሉገመ ከራራ እሳን በሌሱ","poem":2},{"lineBreak":true},{"text":"ሀኦ ሰቦታ ኬሰ ካአ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"እስን አኩመ ሀልከን አያነ ቁልቁሉ አያኔፈተንት፣","poem":1},{"text":"ፋርፈትና ንፋርፈቱ፤","poem":2},{"text":"ገራንኬሰን","poem":1},{"text":"አኩመ ዬሮ ነሞትን ኡሉሌ አፉፋ","poem":2},{"text":"ገረ ቱሉ ዋቀዮት፣","poem":1},{"text":"ገረ ከታ እስራኤልት ኦል በአን ሰና ንገመደ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ዋቀዮ አከ ነሞትን ሰገሌሳ ሱረ ቀቤሰ ሰነ ዸገአን ንጎዸ፤","poem":1},{"text":"እን አከ እሳን እሬሳ","poem":2},{"text":"ከን ኣሪ ጉዳፊ እብደ ጉቤ በሌሱን፣","poem":1},{"text":"ቦካ ሀማዻን፣ በከካፊ ጨቢዻንዹፋ ጅሩ አርገን ንጎዸ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ሰገሌን ዋቀዮ አሶርን ንጨጨብሰ፤","poem":1},{"text":"ቦኩሳቲንስ እሳን በርበዴሰ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"አደቢን ኡሌ ከን ዋቀዮ","poem":1},{"text":"እሳንረ ቡሱ ሁንድ ሰገሌ ድቤቲፊ","poem":2},{"text":"ሰገሌ ክራራ ኦፍ ኬሳ ቀበ፤","poem":1},{"text":"እንስ ሩኩታ እሬሳቲን ወራነ ኬሰት እሳን ሎለ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ቶፌት ዱር ቆጴፈሜ፤","poem":1},{"text":"እን ሞትቻፍ ቆጴፈሜ።","poem":2},{"text":"ቦል እብዳሳ ገድ ፈጌፈሜ በልእፈሜ ሆጄተሜ፤","poem":1},{"text":"እንስ እብዳፊ ቆራኒን ጉተሜረ፤","poem":2},{"text":"ሀፉር አፋን ዋቀዮቲ በኡስ","poem":1},{"text":"አኩመ ድኚ ዸንገለኡ አከ እን ቦበኡ ጎዸ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}