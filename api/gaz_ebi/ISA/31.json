{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":31,"content":[{"type":"heading","content":["ወረ ግብጥን አብደተኒፍ ወዮ"]},{"type":"verse","number":1,"content":[{"text":"ወረ ገርጋርሰ በርባቸ ገረ ግብጥት ገድ ቡአኒፍ፣","poem":1},{"text":"ወረ ፈርዴን አብደተኒፍ","poem":2},{"text":"ወረ ጋሪወንሳኒቲፊ","poem":1},{"text":"ጀብነ አቦቲ ፈርዴንሳኒ አመነተኒ","poem":2},{"text":"ገሩ ገረ ቁልቁልቸ እስራኤል ህንእላሌ","poem":1},{"text":"ዮካን ገርጋርሰ ዋቀዮ ህንበርባኔፍ ወዮ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ተኡስ እን ኦጌሰ፤ በላስ ፍዱ ደንደአ፤","poem":1},{"text":"እን ዋን ጄዼራ ዱበት ህንዴብኡ።","poem":2},{"text":"እን መነ ሀሞታት፣","poem":1},{"text":"ወረ ነሞተ ሀምነ ሆጄተን ገርጋረኒት ንከአ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ወር ግብጥ ነሞቱመ መሌ ዋቀ ምት፤","poem":1},{"text":"ፈርዴንሳኒስ ፎኑመ መሌ ሀፉረ ምት።","poem":2},{"text":"ዬሮ ዋቀዮ ሀርከሳ ድሪርፈቱት፣","poem":1},{"text":"እን ገርጋሩ ንጉፈተ፤","poem":2},{"lineBreak":true},{"text":"እን ገርጋረሙስ ንኩፈ፤","poem":2},{"lineBreak":true},{"text":"እሳን ለቹ ወሊ ወጅን በዱ።","poem":2}]},{"type":"verse","number":4,"content":["ዋቀዮ አከነ ናን ጄዸ፦",{"text":"“አኩመ ሌንጭ፣","poem":1},{"text":"ሌንጭ ጉዳን ቶኮ ዋን ቀበቴረት ኣዱ ሰነ፣","poem":2},{"lineBreak":true},{"text":"ቱትን ትክሶታ ጉቱን እሰት ወል ዋመተንዩ፣","poem":2},{"text":"እን እየሳኒ ህንሶዳቱ፤","poem":1},{"text":"ዮካን ወጨሳኒቲን ህንራፈሙ፤","poem":2},{"text":"አከሱመ ዋቀዮ ዋን ሁንደ ደንደኡ","poem":1},{"text":"ቱሉ ጥዮንረት ወራነ በኑፍ ገድ ቡአ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አኩመ ስምብሮትን መታ ነማረ ናኖፍቱ ሰነ","poem":1},{"text":"ዋቀዮ ዋን ሁንደ ደንደኡዬሩሳሌሚፍ ጋቸነ ተአ፤","poem":2},{"text":"እን ጋቸነ ተኤፊ እሼ በራረ፤","poem":1},{"text":"እሼ ብረ ደርበ፤ እሼ ኦልቸስ።”","poem":2}]},{"type":"verse","number":6,"content":["ያ ሰበ እስራኤል፣ ገረ እሰ አከ መሌ እት ፍንጭልተን ሰናት ዴብኣ።"]},{"type":"verse","number":7,"content":["በረ ሰነ ቶኮን ቶኮንኬሰን ዋቆተ ቶልፈሞ ሀርክኬሰን ጩበማን ሱን ሜቲፊ ወርቄራ ሆጄቴ ቱሬ ሰነ ንገቱቲ።"]},{"type":"verse","number":8,"content":[{"text":"“አሶር ጎራዴ ከን ነማ ህንተእኒን ኩፍት፤","poem":1},{"text":"ጎራዴን ነመ ዱአ ህንኦሌስ እሳን ፍጠ።","poem":2},{"text":"እሳን ጎራዴ ዱራ በቀቱ፤","poem":1},{"text":"ደርገጎንሳኒስ ድርቀማን ሆጂ ሁምና ሆጄቱ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ደኦንሳኒ ሰበቢ ሶዳቲፍ ንጅገ፤","poem":1},{"text":"አጀጆትንሳኒስ ፋጂ ወራና አርገኒ ሆለቱ”","poem":2},{"text":"ጄዸ ዋቀዮ፣ እን እብድሳ ጥዮን ኬሰ፣","poem":1},{"text":"ከን ቦል እብደሳሞ ዬሩሳሌም ኬሰ ጅሩ ሱን።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/30.json","previousChapterAudioLinks":{},"numberOfVerses":9}