{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":32,"content":[{"type":"heading","content":["ሞቱማ ቀጄሉማ"]},{"type":"verse","number":1,"content":[{"text":"ኩኖ ሞቲን ቀጄሉማዻን ሞአ፤","poem":1},{"text":"ቡልችቶትንስ ሙርቲ ቀጄላዻን ቡልቹ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ቶኮን ቶኮን ነማ አኩመ ደአትኖ ቡቤ ጀላ እት ደአተኒ፣","poem":1},{"text":"አኩመ እዶ እት ጀባ ጀላ በቀተኒት፣","poem":2},{"text":"አኩመ ብሻን ገሞጂ ኬሰ ያኡቲፊ","poem":1},{"text":"አኩመ ጋድሰ ከታ ጉዳ ከን ለፈ ጎጋ ኬሳ ንተአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ኤርገሲስ እጅ ወረ ዋ አርጉ ህንዱኑንፈቱ፤","poem":1},{"text":"ጉር ወረ ዋ ዸገኡስ ንዸጌፈተ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ቀልቢን ነመ ጀርጀሩ ቶኮ ንቤከ፤ ንሁበተ፤","poem":1},{"text":"አረብን ጊንጌስ ቀጄልቼ ቁልቁሌሴ ዱበተ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ስአች ጎዋን ኡልፍነ ቀቤሰ ህንጄዸሙ፤","poem":1},{"text":"አደጌንስ ባይኤ ህንከበጀሙ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ጎዋን ሰበቢ ጎዉማ ዱበቱፍ","poem":1},{"text":"ቀልቢንሳ ሀምነ ሆጄተ፤","poem":2},{"text":"እን ዋን ዋቅን ህንጃለትኔ ሆጄተ፤","poem":1},{"text":"ዋኤ ዋቀዮስ ዶጎጎረ ኦዴሰ፤","poem":2},{"text":"እን ነመ ቤለኤ ቤለ ህንባሱ፤","poem":1},{"text":"ነመ ዼቦቴሌ ብሻን ዾወተ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"መል አደጌ ሀምነ፤","poem":1},{"text":"እን ኡቱመ እየን ረከቶታ ቀጄላ ተኤ ጅሩ","poem":2},{"lineBreak":true},{"text":"ሶቡማን ህዬዪ በሌሱፍ ጄዼ ጀልእነ ያደ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ነምን ኡልፍነ ቀቤስ ገሩ ከሮረ ኡልፋታ ባሰ፤","poem":1},{"text":"ሆጂ ኡልፍነ ቀቤሰ ሰነትስ ንጀባተ።","poem":2}]},{"type":"heading","content":["ዱበርቶተ ዬሩሳሌም"]},{"type":"verse","number":9,"content":[{"text":"ያ ዱበርቶተ አከ መሌ ቦንተን","poem":1},{"text":"ከኣቲ ነ ዸጌፈዻ፤","poem":2},{"text":"ያ እንተለን ዋን ነጋ ቀብደን ኦፍ ሴተን","poem":1},{"text":"ዋን አን ጄዹ ዸገኣ!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እስን ወር ዋን ነጋ ቀብደን ኦፍ ሴተን","poem":1},{"text":"ኤርገ ወጋን ቶኮ ጥኑመ ደርቤ ቦዴ ንሆለቱ፤","poem":2},{"text":"ወይኒን እጀ ህንኬኑ፤","poem":1},{"text":"ዬሮን እት እጅ ወልት ቀበሙስ ህንዹፉ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ያ ዱበርቶተ ቦንቱወን እስን ሆለዻ፤","poem":1},{"text":"እንተለን ዋን ነጋ ቀብደን ኦፍ ሴተንስ ራፈማ!","poem":2},{"text":"ኡፈተኬሰን ኦፍራ ባሳቲ","poem":1},{"text":"ወያ ገዳ ሙዺኬሰንት ህዸዻ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ለፈ ቆቲሳ ጋሪፍ፣","poem":1},{"text":"ሙከ ወይኒ እጀ ነቀቱፍስ ለጴኬሰን ዸኣ፤","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ለፈ ኡመተኮ ከን ቆራቲፊ","poem":1},{"text":"ሶኮሩን እረት ጉደቱፍ ለጴኬሰን ዸኣ፤","poem":2},{"text":"ዹጉማን መኔን ገመቹ ሁንዳፊ","poem":1},{"text":"መጋላ ፈንደለልቱ ከናፍ ቦኣ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ደአኖን ንኦነ፤","poem":1},{"text":"መጋላን ነምን ኬሰ ጉቴስ ዱዋ ሀፍት፤","poem":2},{"text":"መጋላን ጀብዱኒፊ ቆጢን ኤጉምሳ በረ በራን ንኦኑ፤","poem":1},{"text":"እዶ ሀሬን ዲዳ ኬሰ ቡራቅጡፊ እዶ ቡሻዬን እት ቦበአን ተኡ፤","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኩንስ ሀመ ሀፉር ቁልቁሉንጉባዻ ኑረት ዸንገላፈሙፊ","poem":1},{"text":"ሀመ ገሞጂን ለፈ ቆቲሳ ገበታ ተኤ","poem":2},{"lineBreak":true},{"text":"ለፍት ቆቲሳ ገበታንሞ ቦሶነ ፈካቱት ተአ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሙርቲ ቀጄላን ገሞጂ ኬሰ ጅራተ፤","poem":1},{"text":"ቀጄሉማንሞ ለፈ ቆቲሳ ገበታ ኬሰ ጅራተ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ቡኣን ቀጄሉማ ነጋዸ፤","poem":1},{"text":"ፋይዳን ቀጄሉማሞ ኡቱ ህንብርአትን","poem":2},{"lineBreak":true},{"text":"ተስገቢን በረ በራን ጅራቹዸ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሰብንኮ እዶ ጅሬኛ ነጋ ቀቡ፣","poem":1},{"text":"መኔን ቡልቲ ሶዳ ህንቀብኔ","poem":2},{"lineBreak":true},{"text":"እዶ ቦቆና ጄቁምስ ህንጅሬ ኬሰ ጅራተ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዮሙ ጨቢን ቦሶነረት ቡኡ፣","poem":1},{"text":"መጋለቲን ጉቱማን ጉቱት ገድ ዴብት፤","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እስን ወር ቀርቀረ ለገ ሁንዳት ሰኚ ፈጫፈተኒ","poem":1},{"text":"ሎንኬሰኒፊ ሀሮተኬሰን","poem":2},{"lineBreak":true},{"text":"ነጋን ቦባፈተን አከም ኤብፈሞዸ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/31.json","previousChapterAudioLinks":{},"numberOfVerses":20}