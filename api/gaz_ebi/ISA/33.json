{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":33,"content":[{"type":"heading","content":["ዽጵናፊ ገርጋርሰ"]},{"type":"verse","number":1,"content":[{"text":"ያ በርበዴሳ፣","poem":1},{"text":"አት ከን ህንበርበዴፈምን ሲፍ ወዮ!","poem":2},{"text":"ያ ገንቱ፣ አት ከን ህንገነምን ሲፍ ወዮ!","poem":1},{"text":"አት ዮሙ በርበዴሱ ዺፍቱት ንበርበዴፈምተ፤","poem":2},{"lineBreak":true},{"text":"ዮሙ ገኑ ዺፍቱትስ ንገነምተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ያ ዋቀዮ፣ ኑ ማር፤ ኑ ስ ኤገትና።","poem":1},{"text":"አት ገነመ ገነመ ጀብነኬኘ፣","poem":2},{"lineBreak":true},{"text":"ዬሮ ዽጵናትሞ ፈይነኬኘ ኑፍ ተእ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሰገሌ ከከዌኬቲቲን፣ ነሞትን በቀቱ፤","poem":1},{"text":"ዬሮ አት ኦል ካቱት፣ ሰቦትን ንብትናኡ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ያ ሰቦተ፣ አኩመ ሀዋንስን ወልት ቀበሙ ሰነ","poem":1},{"text":"ቦጁንኬሰን ወልት ቀበመ፤","poem":2},{"lineBreak":true},{"text":"ነሞትንስ አኩመ ቱተ ሀዋንሳረ ኡኡታሉ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ዋቀዮ ኦል ኦል ጄዸ፤ እን ኦል ጉባ ጅራታቲ፤","poem":1},{"text":"እን ሙርቲ ቀጄላፊ ቀጄሉማዻን ጥዮንን ጉተ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እን በረኬቲፍ ሁንዴ አመንሲሳ፣ ኩሳ ፈይና፣","poem":1},{"text":"ከን ኦጉማቲፊ ከን ቤኩምሳ ተአ፤","poem":2},{"lineBreak":true},{"text":"ዋቀዮን ሶዳቹን ፉርቱ በዻዹማ ከናት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ኩኖ ጎቶትንሳኒ ሰገሌ ኦል ፉዸተኒ ዳንዲረት እዩ፤","poem":1},{"text":"ኤርገሞትን ነጋስ ህቅፈተኒ ቦኡ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ከራወን ጉርጉዳን ኦነኒሩ፤","poem":1},{"text":"ነምን ከራረ ዴሙ ህንጅሩ።","poem":2},{"text":"ወሊ ገልቴን ዲገሜረ፤","poem":1},{"text":"ዹገ ባቶትንሼ ቱፈተመኒሩ፤","poem":2},{"lineBreak":true},{"text":"ነምን ቶኮዩ ህንከበጀሙ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ለፍት ንቦስ፤ ንበርበዶፍት፤","poem":1},{"text":"ልባኖን ንቃኖፍት፤ ንጮለግድ፤","poem":2},{"text":"ሻሮን አከ ገሞጂ ታት፤","poem":1},{"text":"ባሻኒፊ ቀርሜሎስ ባለሳኒ ሀርጫፈቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ዋቀዮ አከነ ጄዸ፤ “አን አመ ነንከአ፤","poem":1},{"text":"አን አመ ኦል ኦል ነንጄዸ፤","poem":2},{"lineBreak":true},{"text":"አን አመ ነንከበጀመ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እስን ሀበቂ ኡልፎፍቱ፤ ጭዲ ዴሱ፤","poem":1},{"text":"ሀፉር እስን ባፈተን እብደ ጉቤ እስን ፍጡዸ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ነሞትን አኩመ ኖራ ጉበሙ፤","poem":1},{"text":"አኩመ ቆራቲ ጭረሜትስ እብድ እት ቀብሲፈመ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"እስን ወር ፈጎ ጅርተን ዋን አን ሆጄዼ ዸገኣ፤","poem":1},{"text":"ወር ዽኦ ጅርተንስ ሁምነኮ ቤካ!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ጩበሞትን ጥዮን ኬሳ ንሶዳቱ፤","poem":1},{"text":"ወር ዋቀት ህንቡሌስ ሆለቻ፣","poem":2},{"lineBreak":true},{"text":"“ኑ ኬሳ ኤኙቱ እብደ ዋ በሌሱ ወጅን ጅራቹ ደንደአ?","poem":2},{"text":"ኑ ኬሳ ኤኙቱ","poem":1},{"text":"እብደ በረ በራን ህንዻምኔ ወጅን ጅራቹ ደንደአ?” ጄዹ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ነምን ቀጄሉማን ጅራቴ ዹጋ ዱበቱ፣","poem":1},{"text":"ከን ፋይዳ ከራ ደባቲን አርገሙ ለገቴ","poem":2},{"lineBreak":true},{"text":"ሀርከሳ መተኣ ፉዸቹራ ኤገቱ፣","poem":2},{"text":"ነምን መሪ ነመ አጄሱራ ጉረሳ ጩቃለቴ","poem":1},{"text":"ጀልእነ እላሉራ እጀሳ ዱኑንፈቱ፣","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እዶ ኦል ከኣረ ጅራተ፤","poem":1},{"text":"ደአኖንሳስ ከታ ጀባ ተአ።","poem":2},{"text":"ቡዴን እሳፍ ንኬነመ፤","poem":1},{"text":"ብሻንስ እሰት ህንህርአቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"እጅኬ ሞትቸ ሚዸጉማሳቲን አርገ፤","poem":1},{"text":"ብየ ፈጎ ጅርቱሌ ንእላለ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"አትስ አከነ ጄቴ ገራኬት ራፈመ ዱሪ ሰነ ያደ፦","poem":1},{"text":"“አጀጃን ኦል ኣናን ሱን ኤሰ ጅረ?","poem":2},{"text":"ነምች ግብረ ፉዹ ሱን ኤሰ ጅረ?","poem":1},{"text":"አጀጃን እት ጋፈተማን ገሞወኒ ኤሰ ጅረ?”","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አት ስአች ሰበ ሀማ፣","poem":1},{"text":"ከን ሃሳንሳ ነማፍ ህንገሌ፣","poem":2},{"lineBreak":true},{"text":"ከን አፋንሳ ሃራ ተኤፊ ህንሁበተምኔ ህንአርግቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ጥዮን፣ መጋላ አያነኬኛ ሁበዹ እላል፤","poem":1},{"text":"እጅኬ ዬሩሳሌምን፣ እዶ ጅሬኛ ነጋ ቀቡ፣","poem":2},{"lineBreak":true},{"text":"ዱንካነ ህንቡቅፈምኔ አርገ፤","poem":2},{"text":"ቆፎንሼ ህንቡቅፈሙ፤","poem":1},{"text":"ዮካን ፉኞንሼ ቶኮዩ ህንጭቱ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዋቀዮ አችት ሁምነኬኘ ተአ።","poem":1},{"text":"እዶን ሱንስ አኩመ ለጌን ጉርጉዳቲፊ ቡርቃወኒ ተአ።","poem":2},{"text":"ዶኒን ወራና ከን በቶዻን ኦፈሙ ቶኮዩ","poem":1},{"text":"እሳንረ ህንዴሙ፤","poem":2},{"lineBreak":true},{"text":"ዶኒን ጀባን ቶኮዩ እሳንረ ህንቀጣሙሩ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዋቀዮ አባ ሙርቲኬኛቲ፤","poem":1},{"text":"ዋቀዮ ሴረ ኑፍ ኬነ፤","poem":2},{"text":"ዋቀዮ ሞቲኬኘ፤","poem":1},{"text":"እን ኑ ፈይሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ፉኞንኬ ላፌረ፤","poem":1},{"text":"ኡቱባንሳ ጀባቴ ህንዻበምኔ፤","poem":2},{"lineBreak":true},{"text":"ሸራንስ ህንድሪርፈምኔ።","poem":2},{"text":"ኤርገሲ ቦጁን ባይኤን ንቆደመ፤","poem":1},{"text":"ኦኮላንዩ ቦጁ ንፉዸተ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ነምን ጥዮን ኬሰ ጅራቱ ከምዩ፣ “ነ ዹኩበ” ህንጄዹ፤","poem":1},{"text":"ጩቡን ወረ አች ጅራተንስ ንዺፈማፍ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/32.json","previousChapterAudioLinks":{},"numberOfVerses":24}