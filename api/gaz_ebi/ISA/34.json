{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":34,"content":[{"type":"heading","content":["ሙርቲ ሰቦተ ኤገቱ"]},{"type":"verse","number":1,"content":[{"text":"ያ ሰቦተ፣ እስን አስ ዽኣዻቲ ዸጌፈዻ፤","poem":1},{"text":"ያ ነሞተ፣ እስንስ ቀልቤፈዻ!","poem":2},{"text":"ለፍት ሃዸጌሱ፤ ከን እሼ ኬሰ ጅራቱ ሁንድስ፣","poem":1},{"text":"አዱኛፊ ወን እሼ ኬሳ በኡ ሁንድኑ ሃዸገአን!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዋቀዮ ሰቦተ ሁንደት ኣሬረ፤","poem":1},{"text":"ዼከምስሳ ሎልቶተሳኒ ሁንደረ ቡኤረ።","poem":2},{"text":"እን ጉቱማን ጉቱት እሳን በርበዴሰ፤","poem":1},{"text":"እን አከ ቀለመኒፍ ደበርሴ እሳን ኬነ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እሳን ኬሳ ወር ዱአን አለት ገድ ደርበተመን፤","poem":1},{"text":"ሬፍሳኒ ንአጃአ፤","poem":2},{"lineBreak":true},{"text":"ቱሉወን ዺገሳኒቲን ቶርቶሩ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ራያወን ሰሚ ሁንድኑ ንበቁ፤","poem":1},{"text":"ሰሚንስ አኩመ ክታበ መረማ ንመርመረመ፤","poem":2},{"text":"ራያን ኡርጂወኒ ሁንድኑ አኩመ ባለ ወይኒ ጮለጌ፣","poem":1},{"text":"አኩመ ሀርቡ ሙከ ሀርቡራ ሀርጨኡት ሀርጨኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ጎራዴንኮ ሰሚ ኬሰት ሀመ ቁፉት ዹጌረ፤","poem":1},{"text":"ኩኖ እን ኤዶምት ሙሩፍ፣","poem":2},{"lineBreak":true},{"text":"ገረ ሰበ አን ጉቱማን ጉቱት በርበዴሴት ገድ ቡኤረ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ጎራዴን ዋቀዮ ዺገ ኬሰ ጩጰሜረ፤","poem":1},{"text":"እን ጮማን፣ ዺገ ጦባላወን ሆላቲፊ ሬኦታቲን፣","poem":2},{"lineBreak":true},{"text":"ሞረ ከሌ ኮርቤዪ ሆላቲን ሀጉገሜረ።","poem":2},{"text":"ዋቀዮ ቦዝራ ኬሰት ኣርሳ፣","poem":1},{"text":"ኤዶም ኬሰትሞ ቀልመ ጉዳ ቆጴሴራቲ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ገፈርስ እሳን ወጅን፣","poem":1},{"text":"ጅቦንስ ኮሮሚ ጉርጉዳ ወጅን ዹሙ።","poem":2},{"text":"ለፍትሳኒ ዺጋን ጂት፤","poem":1},{"text":"ብዮንሳኒስ ሞረ ቁፈ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ዋቀዮ ጉያ እት ሃሎ በኡ፣","poem":1},{"text":"ወጋ እት ዋኤ ጥዮን ፈልሙ ቀባቲ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ቡርቃወን ኤዶም ሌሌት፣","poem":1},{"text":"ብዮንሼስ ድኚ ቦበኡት ጌደረመ፤","poem":2},{"lineBreak":true},{"text":"ለፍትሼሞ ሌሌ ቦበኡ ተአ!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እን ሀልከን ዮካን ጉያ ህንዻሙ፤","poem":1},{"text":"ኣርሳስ በረ በራን ኦል በአ።","poem":2},{"text":"ለፍት ሱን ዸሎታ ሀመ ዸሎታት ኦንቴ ሀፍት፤","poem":1},{"text":"ነምን ቶኮዩ ዴብኤ እሼ ኬሳን ህንደርቡ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጩሉሌን ገሞጂቲፊ ዸዴን ለፈ ሰነ ንፉዸቱ፤","poem":1},{"text":"ኡሩንጉፊ አራጌስ መነሳኒ አችት እጃረቱ።","poem":2},{"text":"ዋቅን ኤዶምራ፣ ፉኞ ጄቁምሳቲፊ","poem":1},{"text":"መዳሊ በዲሳ ንድሪርሰ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ጉርጉዶትንሼ ዋን ሞቱማ ጄዸሜ ዋመሙአቺ ህንቀባተን፤","poem":1},{"text":"እልማን ሞቶተሼ ሁንድ ንበዱ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"መሰራሼ ቆራቲ፣","poem":1},{"text":"ደአትኖሼ ዶቢፊ ሶኮሩቱ ዻለ።","poem":2},{"text":"እሼን ቦለ ዋንጎ፣","poem":1},{"text":"እዶ ኡሩንጉን ጅራቱ ንታት።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኡመመወን ገሞጂ ወራቤሰ ወጅን ወል ገኡ፤","poem":1},{"text":"ሀፉሮትን ሀሞ ሬኤ ዲዳ ፈካተን ወል ዋሙ፤","poem":2},{"text":"ኡመመወን ሀልከኒ አች ቦቆተን፤","poem":1},{"text":"ኦፊሳኒቲፍስ እዶ ኣረ ገልፈትና አርገቱ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኡሩንጉን አችት መንኤ እጃረቴ ሀንቃቁ ሀንቃቅጥ፤","poem":1},{"text":"ጩጪ ያፍቴስ ቆቾ ጀለት ኩኑንፈት፤","poem":2},{"lineBreak":true},{"text":"አላቲንስ ዽርሳፊ ኒቲ ታቴ አችት ወልት ቀበምት።","poem":2}]},{"type":"verse","number":16,"content":["ክታበ ዋቀዮ ኬሳ እላላቲ ከን አከነ ጄዹ ዱብፈዻ፦",{"text":"እሳን ከኔን ኬሳ ቶኮዩ ህንዸበሙ፤","poem":1},{"text":"ቶክቲንዩ ዽርሰሼ ህንዸብዱ።","poem":2},{"text":"አፋን ዋቃ አጀጄራቲ፤","poem":1},{"text":"ሀፉርሳስ ወልት እሳን ቀበ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እሰቱ ቆደሳኒ ህራፍ፤","poem":1},{"text":"ሀርክሳ ሰፈርቱዻን እሳኒፍ ቆደ።","poem":2},{"text":"እሳን በረ በራን ቆደ ከነ ንቀባቱ፤","poem":1},{"text":"ዸሎታ ሀመ ዸሎታትስ አች ጅራቱ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":17}