{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":38,"content":[{"type":"heading","content":["ህስቅያስ ዹኩብሰቹሳ"]},{"type":"verse","number":1,"content":["በረ ሰነ ኬሰ ህስቅያስ ዹኩብሰቴ ዱኡ ገኤ ቱሬ። እሳያስ እልም አሞስ ራጅች ገረሳ ዸቄ፣ “ዋቀዮ አከነ ጄዸ፦ መነኬ ቶቶልፈዹ፤ አት ንዱተ መሌ ህንፈይቱቲ” ጄዼን።"]},{"type":"verse","number":2,"content":["ህስቅያስስ ፉለሳ ገረ ኬኘን መናት ገረገልፈቴ አከነ ጄዼ ዋቀዮን ከዸቴ፤"]},{"type":"verse","number":3,"content":["“ያ ዋቀዮ፣ አከ አን አመነሙማፊ ገራ ቶኮን ፉለኬ ዱረ ጅራዼ ዋን ፉለኬ ዱረት ጋሪ ተኤስ ሆጄዼ ያደዹ።” ህስቅያስስ ህቅፈቴ ንቦኤ።"]},{"type":"verse","number":4,"content":["ኤርገሲስ ዱቢን ዋቀዮ አከነ ጄዼ ገረ እሳያስ ዹፌ፦"]},{"type":"verse","number":5,"content":["“ዸቂቲ አከነ ጄዺ ህስቅያስት ህም፤ ‘ዋቀዮ ዋቅን አባኬ ዳዊት አከነ ጄዸ፦ አን ከዸትናኬ ዸገኤረ፤ እምማንኬስ አርጌረ፤ አን ኡሙሪኬረት ወጋ ኩዸ ሸን ሲፈን ደበለ።"]},{"type":"verse","number":6,"content":["አን ስኢፊ መጋላ ከነ ሀርከ ሞትቸ አሶሪቲ ነንባሰ። አን መጋላ ከነ ነንኤገ።"]},{"type":"verse","number":7,"content":["“ ‘ኩን መለቶ ዋቀዮ ከን አከ እን ዋን ዋዳ ገሌ ሰነ ጉቱ ምርከኔሱፍ ዋቀዮ ብራ ሲፍ ኬነሜዸ፦"]},{"type":"verse","number":8,"content":["አን አከ ጋድዱን አዱ ተርካንፊ ኩርነን ጉለንታ ኣሃዝ እራን ገድ ቡኤ ሰነ ዱግደ ዱበት ዴብኡ ነንጎዸ።’ ” ከናፉ ጋድዱን ተርካንፊ ኩርነን ገድ ቡኤ ቱሬ ሱን ዱግደ ዱበት ዴብኤ።"]},{"type":"verse","number":9,"content":["በሬፈመ ህስቅያስ ሞትች ይሁዳ ኤርገ ዹኩብሰቴ ፈዬ ቦዴ በሬሴ፦"]},{"type":"verse","number":10,"content":[{"text":"አንስ፣ “ወለካ ኡሙሪኮቲት፣","poem":1},{"text":"አን ሲኦል ሴኑን ቀባ?","poem":2},{"lineBreak":true},{"text":"በረ ጅሬኘኮ ከን ሀፌስ ዸቡን ቀባ?” ነንጄዼ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አን አከነን ጄዼ፤ “አን ብየ ጅራቶታ ኬሰት፣","poem":1},{"text":"ለመተ ዋቀዮን ህንአርጉ፤","poem":2},{"text":"አን ስአች ሰኚ ነማ ህንእላሉ፣","poem":1},{"text":"ዮካን ወረ አዱኛ ከነረ ጅራተን ወጅን ህንጅራዹ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"መንኮ አኩመ ዱንካነ ትክሶታ","poem":1},{"text":"ቡቅፈሜ ነራ ፉዸተሜረ።","poem":2},{"text":"አን አኩመ ወያ ዾፍቱ ጅሬኘኮ መርመሬረ፤","poem":1},{"text":"እን ምአ ወያ ዾፍቱራ ነ ኩቴረ፤","poem":2},{"lineBreak":true},{"text":"አት ሀልከኒ ጉያ ነ በሌስተ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አን ሀመ በሪት ኦብሳን ነንኤገዼ፤","poem":1},{"text":"እን ገሩ አከ ሌንጫ ለፌኮ ሁንደ ጨጨብሴ፤","poem":2},{"lineBreak":true},{"text":"አት ሀልከኒ ጉያስ ነ በሌስተ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አን አከ ስምብሮ ዮካን አኩመ ዳሎቴ ነንወጬ፤","poem":1},{"text":"አከ ጉጌ ቦሱስ ነንኣዴ፤","poem":2},{"text":"እጅኮ ገረ ሰሚ እላሉዻን ደዸቤ፤","poem":1},{"text":"ያ ጎፍታ አን ረከዼራ ኮቱ ነ ገርጋር!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"አን ገሩ ማል ጄቹን ደንደአ?","poem":1},{"text":"እን ነት ዱበቴ፤ እን መታንሳስ ዋን ከነ ጎዼ።","poem":2},{"text":"አን ዋኤ ዽጵና ሉቡኮቲፍ","poem":1},{"text":"ኡሙሪኮ ጉቱ ገድ ኦፍ ቀቤ ነንጅራዸ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ያ ጎፍታ፣ ነሞትን","poem":1},{"text":"ዋኑመ አከሲቲን ጅራቱ፤","poem":2},{"text":"ሀፉርኮስ እሳኑማን ጅሬኘ አርገተ።","poem":1},{"text":"አት ነ ፈይፍቴ ሉቡዻንስ ነ ጅራችፍቴ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዹጉማን አከስ ዽጰቹንኮ ፋይዳኮቲፍ።","poem":1},{"text":"አት ጃለለኬቲን ቦለ በዲሳራ ነ ኤግዴ፤","poem":2},{"lineBreak":true},{"text":"ጩቡኮ ሁንደስ፣ ዱግደኬ ዱበት ገቴ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሲኦል ስ ገለቴፈቹ ህንደንደኡቲ፤","poem":1},{"text":"ዱትስ ስ ጀጀቹ ህንደንደኡ።","poem":2},{"text":"ወር ቅሌት ገድ ቡአን፣","poem":1},{"text":"አመነሙማኬ አብደቹ ህንደንደአን።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እሳን አኩመ አን ሀርአ ጎቻ ጅሩ ከነ ያ ጅራታ፣","poem":1},{"text":"ያ ጅራታ ጄዸኒ ስ ጀጀቱ፤","poem":2},{"text":"አቦቲን ዋኤ አመነሙማኬቲ","poem":1},{"text":"እጆሌሳኒት ንኦዴሱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ዋቀዮ ነ በራረ፤","poem":1},{"text":"ኑስ በረ ጅሬኘኬኛ ጉቱ፣","poem":2},{"text":"መነ ቁልቁሉማ ዋቀዮ ኬሰት","poem":1},{"text":"ምአ ርቡራ ሆጄተሜን ፋርፈትነ።","poem":2}]},{"type":"verse","number":21,"content":["እሳያስ፣ “መጥኖ ሀርቡ ቶልቻቲ ዹላሳረ ካኣ፤ እንስ ንፈያ” ጄዼ ቱሬ።"]},{"type":"verse","number":22,"content":["ህስቅያስስ፣ “አከ አን ገረ መነ ቁልቁሉማ ዋቀዮት ኦል በኡፍ ማልቱ መለቶ ተአ?” ጄዼ ጋፈቴ።"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}