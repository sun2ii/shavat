{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"በረ ሰነ ኬሰ ዱበርቶትን ቶርበ","poem":1},{"text":"ነመ ቶክቸ ቀበተኒ፣","poem":2},{"text":"“ኑ ኛቱመኬኘ ኛትነ፤","poem":1},{"text":"ኡፈተኬኘ ኡፈትነ፤","poem":2},{"text":"ገሩ መቃኬቲን ሃዋመምኑ።","poem":1},{"text":"ሰልጵነኬኘ ኑራ ፈጌስ!” ጄዹን።","poem":2}]},{"type":"heading","content":["ደሜ ዋቀዮ"]},{"type":"verse","number":2,"content":["በረ ሰነ ኬሰ ደሜን ዋቀዮ በሬዴ ኡልፍነ ቀባተ፤ እጅ ለፋስ ሀምባ እስራኤሊፍ ዋን እሳን እቲን ቦነኒፊ ኡልፍነ ተአ።"]},{"type":"verse","number":3,"content":["ወር ጥዮን ኬሰት ሀፈን፣ ወር ዬሩሳሌም ኬሰት ሀምብፈመን፣ ወር ነሞተ ዬሩሳሌም ኬሰ ጅራተን ኬሰት ገልሜፈመን ሁንድ ቁልቁሎተ ጄዸመኒ ንዋመሙ።"]},{"type":"verse","number":4,"content":["ጎፍታን ጡሪ ዱበርቶተ ጥዮን እራ ዽቀ፤ እን ዬሩሳሌምራ ሀፉረ ሙርቲቲፊ ሀፉረ እብዳቲን ዺገ ንቁልቁሌሰ።"]},{"type":"verse","number":5,"content":["ኤርገሲስ ዋቀዮ ጉቱማ ቱሉ ጥዮኒፊ ወረ አችት ወልት ቀበመን ሁንዳረት ጉያዻን ዱሜሰ ኣራ፣ ሀልከኒንሞ እፈ አረበ እብዳ ንኡመ፤ ኡልፍነ ሰነ ሁንደረ ዱንካነቱ ጅራተ።"]},{"type":"verse","number":6,"content":["እንስ ሆአ ጉያራ ደኦፊ ጋድሰ፣ እዶ ቡቤ ሀማፊ ቦካ ጀላ እት በቀተኒፊ እዶ እት ዾከተን ተአ።"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/3.json","previousChapterAudioLinks":{},"numberOfVerses":6}