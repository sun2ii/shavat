{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":40,"content":[{"type":"heading","content":["ሰብን ዋቃ ጀጀቤፈሜ"]},{"type":"verse","number":1,"content":[{"text":"ጀጀቤሳ፤ ሰበኮ ጀጀቤሳ፤","poem":1},{"text":"ጄዸ ዋቅንኬሰን።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ገራ ዬሩሳሌምት ዱበዻ፤","poem":1},{"text":"ሆጂን ገርቡማሼ አከ ዹሜ፣","poem":2},{"text":"ገቲን ጩቡሼ አከ ባፈሜፍ፣","poem":1},{"text":"እሼን ጩቡሼ ሁንዳፍ","poem":2},{"text":"ሀርከ ዋቀዮቲ አደቢ ደቻ","poem":1},{"text":"አከ ፉዸቴ እሼት ለብሳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ሰገሌ አከነ ጄዼ እዩ ቶኮ፦","poem":1},{"lineBreak":true},{"text":"“ገሞጂ ኬሰት","poem":1},{"text":"ዋቀዮፍ ከራ ቆጴሳ፤","poem":2},{"text":"ገሞጂ ኬሰት ዋቀኬኛፍ","poem":1},{"text":"ከራ ጉድቸ ቀጄልቻ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሱሉል ሁንድ ንጉተመ፤","poem":1},{"text":"ቱሉፊ ጋር ሁንድኑስ ገድ ዴብፈመ፤","poem":2},{"text":"ለፍት ወል ጫሉ፣ ወል ቅጤፈመ፤","poem":1},{"text":"ለፍት ቡኣ በኢንስ ድሬ ተአ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኡልፍን ዋቀዮ ንሙልአተ፤","poem":1},{"text":"ሰኚን ነማ ሁንድኑስ ቶኩማዻን ንአርገ።","poem":2},{"text":"አፋን ዋቀዮ ዱበቴራቲ።”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ሰገሌን ቶኮ “እይ” ጄዸ።","poem":1},{"text":"አንስ፣ “ማል ጄዼን እየ?” ነንጄዼ።","poem":2},{"lineBreak":true},{"text":"“ነምን ሁንድ አኩመ መርጋት፤","poem":1},{"text":"ኡልፍንሳ ሁንድስ አኩመ ደራራ ድሬት።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሰበቢ ሀፉር ዋቀዮ ባፈቱ እሳንት ቡብሱፍ መርግ","poem":1},{"text":"ንጮለገ፤ ደራራንስ ንሀርጨአ።","poem":2},{"lineBreak":true},{"text":"ዹጉማን ነምን መርጉመ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"መርግ ንጮለገ፤ ደራራንስ ንሀርጨአ፤","poem":1},{"text":"ዱቢን ዋቀኬኛ ገሩ በረ በራን ንጅራተ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"አት ከን ጥዮኒፍ ኦዱ ጋሪ ፍዱ፣","poem":1},{"text":"ቱሉ ዼራት ኦል በእ።","poem":2},{"text":"አት ከን ዬሩሳሌሚፍ ኦዱ ጋሪ ፍዱ፣","poem":1},{"text":"ሰገሌኬ ኦል ፉዹቲ እይ፤","poem":2},{"text":"ኦል ፉዸዹ እይ፤ ህንሶዳትን፤","poem":1},{"text":"መጋላወን ይሁዳቲንስ፣","poem":2},{"lineBreak":true},{"text":"“ዋቅንኬሰን ኩኖት!” ጄዽ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኩኖ፣ ዋቀዮ ጎፍታን ሁምናን ንዹፈ፤","poem":1},{"text":"እሬንሳ ጀባዻንስ ንቡልቸ።","poem":2},{"text":"ኩኖ፣ ገቲንሳ እሰ ወጅን ጅረ፤","poem":1},{"text":"ገቲን እን ነማፍ ኬኑ እሱመ ሀርከ ጅረ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እን አኩመ ትክሴ ቶኮት ቡሻዬሳ ትክፈተ፤","poem":1},{"text":"ጦባላወን ሆላስ እሬሳቲን ወልት ቀበ፤","poem":2},{"text":"ኦፍት ቀቤስ ቆመሳት ሀመተ፤","poem":1},{"text":"ሃዾተ ሆሎታ ወረ ሆስሰንስ ሱቱመ ኦፈ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ብሻኖተ ኮኜሳቲን ከን ሰፈሬ","poem":1},{"text":"ዮካን ሰሚወን ታኩሳቲን ከን ሰፈሬ ኤኙ?","poem":2},{"text":"ብዮ ለፋ ሰፈርቱዻን ወልት ከን ቀቤ","poem":1},{"text":"ዮካን ቱሉወን መዳሊዻን","poem":2},{"lineBreak":true},{"text":"ጋረንሞ መዳሊዻን ከን መዳሌ ኤኙ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኤኙቱ ሀፉረ ዋቀዮ ቀጄልቹ ደንደኤ?","poem":1},{"text":"ዮካን ነምን ጎርሳሳ ተኤ እሰ በርሲሴ ኤኙ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዋቀዮ ሁበትና አርገቹፍ ኤኙን ጎርሰ ጋፈቴ?","poem":1},{"text":"ዳንዲ ቀጄላስ ኤኙቱ እሰ በርሲሴ?","poem":2},{"text":"ኤኙቱ ቤኩምሰ እሳፍ ኬኔ","poem":1},{"text":"ዮካን ዳንዲ ሁበትና እሰ አርግሲሴ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ዹጉማን ሰቦትን አኩመ ጮጰ ባልዲ ኬሳት፤","poem":1},{"text":"እሳን አኩመ አዋረ መዳሊረ ጅሩት እላለሙ፤","poem":2},{"lineBreak":true},{"text":"እን ብዮተ ብሻን ግዱሌ አኩመ ብዮ ቡላኣት መዳለ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ልባኖን ቆራን እዶ ኣርሳቲፍ ገኡ ህንቀብዱ፣","poem":1},{"text":"ዮካን ሆሪንሼ ኣርሳ ጉበሙፍ ህንገአን።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ፉለሳ ዱረት ሰቦትን ሁንድኑ ወይቱ ህንለካአመን፤","poem":1},{"text":"እሳን አከ እላልቸሳት ሆማቱ ህንሄደመን፤","poem":2},{"lineBreak":true},{"text":"ገቲስ ህንቀበን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ዮስ ዋቀ ኤኙት ፈኬስቱ?","poem":1},{"text":"ፈኪ ከም ወጅን እሰ ወል ብረ ቀብዱ?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዋቀ ቶልፈማ ቱምቱ ስቢላቱ በቅሴ ቶልቸ፤","poem":1},{"text":"ቱምቱን ወርቄስ ወርቄ እት ኡፍሰ፤","poem":2},{"lineBreak":true},{"text":"ፎንጫ ሜቲቲንስ ንሚዸግሰ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ህዬስ ኣርሳ አከሲ ዽኤሱ","poem":1},{"text":"ህንደንዴኜ ቶኮ ሙከ ህንቶርቶሬ ፍለተ።","poem":2},{"text":"ዋቀ ቶልፈማ ህንጅግኔ ዻቡፍስ","poem":1},{"text":"ነመ ኦጉማ ሆጂ ሀርካ ቀቡ በርባደተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"እስን ህንቤክተኒ?","poem":1},{"text":"እስን ህንዸጌኜ?","poem":2},{"text":"ወን ኩን ጀልቀቡማ ካሴ እስንት ህንህመምኔ?","poem":1},{"text":"እስን ኤርገ ለፍት ሁንዴፈምቴ ጀልቀቤ ህንሁበትኔ?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"እን ጌንጎ ለፋቲ ኦል ታአ፤","poem":1},{"text":"ኡመትን ለፋስ አኩመ ኮሮጵሳት።","poem":2},{"text":"እን ሰሚወን አኩመ ጎልጋት ድሪርሰ፤","poem":1},{"text":"አከ ዱንካነ ኬሰ ጅራተኒትስ እሳን ድሪርሰ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"እን እልማን ሞቶታ ፋይዳ ዸብሲሰ፤","poem":1},{"text":"ቡልችቶተ አዱኛስ ሀርከ ዱዋ ሀምብሰ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"አኩመ እሳን ዻበመኒን፣","poem":1},{"text":"አኩመ እሳን ፈጫፈመኒን፣","poem":2},{"lineBreak":true},{"text":"አኩመ እሳን ለፈ ኬሰት ህደ ያፈተኒን፣እን እሳንት ቡብሴ፤","poem":2},{"text":"እሳንስ ንጮለገን፤","poem":1},{"text":"ኦቦምቦሌቲንስ አኩመ ሀበቂት እሳን ሀጣኤ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“እስን ኤኙት ነ ፈኬስቱ?","poem":1},{"text":"ዮካን ኤኙቱ አናን ቅጣተ?” ጄዸ ቁልቁልች።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"እጀኬሰን ኦል ፉዸዻቲ ሰሚወን እላላ፦","poem":1},{"text":"ኤኙቱ ከኔን ሁንደ ኡሜ?","poem":2},{"text":"እሰ ቱተ ኡርጂወኒ ቶኮ ቶኮን ፍዴ","poem":1},{"text":"ቶኮ ቶኮሳኒ መቃ መቃዻን ዋሙ ሰናዸ።","poem":2},{"text":"ሰበቢ ሁምነሳ ጭማ ሰናቲፊ ጀብነሳ ጉዳ ሰናቲፍ","poem":1},{"text":"እሳን ኬሳ ቶኮዩ ህንዸበሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ያ ያቆብ፣ ያ እስራኤል፣ አት ማሊፍ፣","poem":1},{"text":"“ከራንኮ ዋቀዮ ዱራ ዾከቴረ፤","poem":2},{"text":"ሃጃንኮስ ፉለ ዋቀኮ ዱረት","poem":1},{"text":"ቱፈተሜረ” ጄቴ ጉንጉምተ?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"አት ህንቤክቱ?","poem":1},{"text":"አት ህንዸጌኜ?","poem":2},{"text":"ዋቀዮ ዋቀ በረ በራት፤","poem":1},{"text":"እን ኡማ ሀንዳረ ለፋት።","poem":2},{"text":"እን ህንደዸቡ ዮካን ሃረ ህንገልፈቱ፤","poem":1},{"text":"ሁበትናሳስ ከን ቆሬ ብረ ገኡ ህንጅሩ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"እን ደዸብዶታፍ ጀብነ ኬነ፤","poem":1},{"text":"ነመ ላፋፍሞ ሁምነ ደበለ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"እጆሌንዩ ንደዸቡ፤ ንቡቱቱስ፤","poem":1},{"text":"ደርገጎንስ ጉፈተኒ ኩፉ፤","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ወር ዋቀዮን አብደተን ገሩ","poem":1},{"text":"ሁምነሳኒ ንሃሮምፈቱ።","poem":2},{"text":"እሳን አኩመ ርሳ ቆቾዻን በርሱ፤","poem":1},{"text":"ንፊጉ፤ ህንደዸበን፤","poem":2},{"lineBreak":true},{"text":"ንዴሙ፤ ህንቡቱተን።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}