{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":41,"content":[{"type":"heading","content":["ገርጋራ እስራኤል"]},{"type":"verse","number":1,"content":[{"text":"ዋቀዮ አከነ ጄዸ፤","poem":1},{"text":"“ያ ብዮተ ብሻን ግዱ፣ ፉለኮ ዱረት ጨልእሳ!","poem":2},{"text":"ሰቦትን ጀብነሳኒ ሃሃሮምፈተን!","poem":1},{"text":"እሳን ፉለ ዱረት በአኒ ሃዱበተን፤","poem":2},{"lineBreak":true},{"text":"ወሊ ወጅን ሙርቲዻፍ ሃዽኣትኑ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“ከን በአ ቢፍቱቲ ነመ ቶኮ ከካሴ","poem":1},{"text":"ቀጄሉማዻን ተጃጅለሳቲፍ እሰ ዋሜ ኤኙ?","poem":2},{"text":"እን ሰቦተ ደበርሴ ሀርከሳት ኬነ፤","poem":1},{"text":"ሞቶተስ እሰ ጀለት ቡልቸ።","poem":2},{"text":"እን ጎራዴሳቲን ዳራ፣","poem":1},{"text":"ጥየሳቲንስ ሀበቂ ቡቤዻንብትናኡ እሳን ጎዸ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እን እሳን አርኤ፣","poem":1},{"text":"ዳንዲ ሚልሳረ ዴሜ ህንቤክኔረ ነጋን ደርበ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጀልቀባ ካሴ ዸሎተ ዋሜ","poem":1},{"text":"ዋን ከነ ከን ቶልቼፊ ሆጄቴ ኤኙ?","poem":2},{"text":"አን ዋቀዮ እሰ ዱራት፤","poem":1},{"text":"እሰ ዹማቲፍስ አን እሱመ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ብዮትን ብሻን ግዱ አርገኒ ሶዳቱ፤","poem":1},{"text":"ዳሪወን ለፋ ንሆለቱ።","poem":2},{"text":"እሳንስ ንዽኣቱ፤ ገረ ፉለ ዱራትስ ዹፉ፤","poem":1}]},{"type":"verse","number":6,"content":[{"text":"ቶኮን ቶኮን ነማ ወል ገርጋረ፤","poem":2},{"lineBreak":true},{"text":"ኦቦሌሰሳቲንስ፣ “ጀባዹ!” ጄዸ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ቱምቱን ስቢላ ቱምቱ ወርቄ ንጀጀቤሰ፤","poem":1},{"text":"እን ቡሩሳን ወል ቅጤሱስ፣","poem":2},{"lineBreak":true},{"text":"እሰ ጌሞረት ስቢለ ቱሙ ጀጀቤሰ።","poem":2},{"text":"ዋኤ ስቢለ ወልት በቅሱ፣ “ወን ኩን ጋሪዸ” ጄዸ።","poem":1},{"text":"አከ እን ህንሶቾኔፍስ ዋቀ ቶልፈማ ሰነምስማራን ወልት ቀብሲሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“አት ገሩ፣ ያ ገርብቸኮ እስራኤል፣","poem":1},{"text":"ያ ያቆብ ከን አን ፍለዼ፣","poem":2},{"lineBreak":true},{"text":"ሰኚ አብረሃም ምቹኮቲ፣","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አን ሀንዳረ ለፋቲ ስ ፉዸዼ፤","poem":1},{"text":"ጎሌ ፈጎዻን ስ ዋመዼ።","poem":2},{"text":"አን፣ ‘አት ገርብቸኮት’ ሲን ጄዼ፤","poem":1},{"text":"አን ስ ፍለዼረ፤ ስ ህንገኔስ፣","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ከናፉ አት ህንሶዳትን፤ አን ስ ወጅን ጅራቲ፤","poem":1},{"text":"ህንራፈምን፤ አን ዋቀኬቲ።","poem":2},{"text":"አን ስን ጀቤሰ፤ ስን ገርጋረስ፤","poem":1},{"text":"አን ሀርከኮ ምርጋ ቀጄላ ሰናን ህርክሴ ኦል ስን ቀበ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ኩኖ፣ ወር ስት ኣረን ሁንድ፣","poem":1},{"text":"ንቃነኡ፤ ንሰልጰቱስ፤","poem":2},{"lineBreak":true},{"text":"ወር ሲን ሞርመን አከ ዋን ህንጅሬ ተኡ፤ ንበዱስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አት ዲኖተኬ በርባዱዩ፣ እሳን ህንአርገቱ።","poem":1},{"text":"ወር ወራነ ስት በነን፣","poem":2},{"lineBreak":true},{"text":"ጉቱማን ጉቱት አከ ዋን ህንጅሬ ተአን።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አን ዋቀዮ ዋቅንኬ","poem":1},{"text":"ሀርከኬ ምርጋ ነንቀባቲ፤","poem":2},{"text":"እን፣ ‘ህንሶዳትን፤","poem":1},{"text":"አን ስን ገርጋራ’ ሲን ጄዹስ አኑመ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ያ ያቆብ ራሞነነ፣","poem":1},{"text":"ያ እስራኤል ጥኖነነ ህንሶዳትን፤","poem":2},{"text":"አን መታንኮ ስን ገርጋራቲ” ጄዸ ዋቀዮ፣","poem":1},{"text":"ፉራንኬ፣ ቁልቁልች እስራኤል ሱን።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“አን ኩኖ፣ ሜሻ እቲን ምዻን ዸአን፣","poem":1},{"text":"ሜሻ ሃራፊ ቀረማ ከን እልካን ባይኤ ቀቡ ስን ታስሰ።","poem":2},{"text":"አት ቱሉወን ዾፍቴ ጨጨብስተ፤","poem":1},{"text":"ጋረንሞ አከ ሀበቂ ጎተ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አት ጀረ ንአፈርስተ፤ ቅሌንስስ ኦል እሳን ፉዸተ፤","poem":1},{"text":"ቡቤን ጀባን እሳን ብትኔሰ።","poem":2},{"text":"አት ገሩ ዋቀዮት ንገመደ፤","poem":1},{"text":"ቁልቁልቸ እስራኤልንስ ኡልፍነ አርገተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“ህዬዪፊ ረከቶትን ብሻን በርባዱ፤","poem":1},{"text":"ገሩ ሆማ ህንአርገተን፤","poem":2},{"lineBreak":true},{"text":"አረብንሳኒ ዼቡዻን ጎጎጌረ።","poem":2},{"text":"አን ዋቀዮ ገሩ ዴቢ ነንኬናፍ፤","poem":1},{"text":"አን ዋቅን እስራኤል ጀረ ህንገቱ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ለፈ ኦል ከኣ ቁላረ ለጌን ነንያሰ፤","poem":1},{"text":"ሱሉሎተ ኬሰሞ ቡርቃ ነንቡርቅሲሰ።","poem":2},{"text":"ገሞጂ ሀሮ ብሻኒት፣","poem":1},{"text":"ለፈ ጎጌስ ቡርቃ ብሻኒት ነንጌደረ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ገሞጂ ኬሰት","poem":1},{"text":"ጋትራ፣ ላፍቶ፣ ኩሳዬፊ ኤጄርሰ ነንብቅልቸ።","poem":2},{"text":"ለፈ ኦና ኬሰትሞ፣","poem":1},{"text":"ብርብርሰ፣ ቀረሮፊ ሀዼሰ ወል ፋነ ነንዻበ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ኩንስ አከ ነሞትን","poem":1},{"text":"አከ ሀርክ ዋቀዮ ዋን ከነ ሆጄቴ፣","poem":2},{"text":"አከ ቁልቁልች እስራኤል ዋን ከነ ኡሜ አርገኒ ቤከኒፍ፣","poem":1},{"text":"አከሱመስ አከ ሁንድሳኒ ዋን ከነ ቀልቤፈተኒ ሁበተኒፍ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“ዽመኬሰን ዽኤፈዻ” ጄዸ ዋቀዮ፤","poem":1},{"text":"“ረጋኬሰን ፍደዻ” ጄዸ ሞቲን ያቆብ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“አከ እሳን ዋን ተኡፍ ጅሩ ኑት ህመኒፍ፣","poem":1},{"text":"ዋቆተኬሰን ቶልፈሞ ፍደዻ።","poem":2},{"text":"አከ ኑ እሳን ሁበትኔ","poem":1},{"text":"ዋን እሳን ዹመረት ተአን ቤክኑፍ፣","poem":2},{"text":"ወንቶትን በረ ዱር ማል አከ ቱረን ኑት ህማ።","poem":1},{"text":"ዮካን ወንቶተ ዹፉፍ ጅረን ኑት ኦዴሳ፤","poem":2}]},{"type":"verse","number":23,"content":[{"text":"አከ ኑ አከ እስን ዋቆተ ታተን ቤክኑፍ፣","poem":1},{"text":"ዋን ፉል ዱረት ተኡፍ ጅሩ ኑት ህማ።","poem":2},{"text":"አከ ኑ ርፈትኔ ሶዳን ጉተምኑፍ፣","poem":1},{"text":"ዋን ጋሪ ዮካን ዋን ሀማ ሆጄዻ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ኩኖ እስን ወይቱ ህንሄደምተን፤","poem":1},{"text":"ሆጂንኬሰንስ ጎንኩማ ገቲ ህንቀቡ፤","poem":2},{"lineBreak":true},{"text":"ከን እስን ፍለቱ ከምዩ ጅብሲሳዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“አን ነመ ቶኮ ካባ ነንካሴ፤ እንስ ዹፈ፤","poem":1},{"text":"እን በአ ቢፍቱቲ ዹፉስ መቃኮ ንዋመተ።","poem":2},{"text":"እን አኩመ ሱጴ ዾፍቱን ሱጴ ዽዺቱ ሰነ፣","poem":1},{"text":"ቡልችቶተ አከ ዾቄት ዽዺተ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"አከ ኑ ቤኩ ደንዴኙፍ","poem":1},{"text":"ኤኙቱ ጀልቀቡማ ካሴ ዋን ከነ ዱበቴ?","poem":2},{"text":"ዮካን አከ ኑ፣ ‘እን ስሪዸ’ ጄቹ ደንዴኙፍ","poem":1},{"text":"ኤኙቱ ዱራን ዱርሴ ዋን ከነ ዱበቴ?","poem":2},{"text":"ኤኙዩ ዋን ከነ ህንህምኔ፤","poem":1},{"text":"ነምን ቶኮዩ ዱራን ዱርሴ ህንህምኔ፤","poem":2},{"lineBreak":true},{"text":"ነምን ቶኮዩ ዱቢኬሰን ህንዸጌኜ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ነምን ጀልቀበት፣ ‘ኩኖ እሳን አስ ጅሩ!’","poem":1},{"text":"ጄዼ ጥዮንት ህሜ አነ ቱሬ።","poem":2},{"lineBreak":true},{"text":"አን ነመ ኦዱ ጋሪ ህሙ ቶኮ ዬሩሳሌሚፍ ኬኔረ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"አን ነንእላሌ፤ ገሩ ሆምቱ ህንቱሬ፤","poem":1},{"text":"እሳን ኬሳ ነምን ጎርሰ ኬኑ ቶኮዩ ህንጅሩ፤","poem":2},{"lineBreak":true},{"text":"ዮሙ አን እሳን ጋፈዹስ ነምን ዴቢ ኬኑ ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ኩኖ፣ ሁንድሳኒ ፋይዳ ህንቀበን!","poem":1},{"text":"ሆጂንሳኒስ ገቲ ህንቀቡ፤","poem":2},{"lineBreak":true},{"text":"ፈኪወንሳኒስ ቅሌንሱመ ዱዋዸ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":29}