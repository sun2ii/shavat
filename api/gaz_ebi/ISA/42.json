{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":42,"content":[{"type":"heading","content":["ገርብቸ ዋቀዮ"]},{"type":"verse","number":1,"content":[{"text":"“ተጃጅላንኮ እን አን ኡቱቤ ዻቡ፣","poem":1},{"text":"ፍለተማንኮ ከን አን እት ገመዱ እሰ ከነ፤","poem":2},{"text":"አን ሀፉረኮ እሰረ ነንካአ፤","poem":1},{"text":"እን ሰቦታፍ ሙርቲ ቀጄላ ንኬነ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እን ህንወጩ ዮካን ህንዩ፤","poem":1},{"text":"ዮካን ዳንዲረት ሰገሌሳ ህንዸጌስሱ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሸምበቆ ቡሩቄ ህንጨብሱ፤","poem":1},{"text":"ፎኣ እብሳ ከን ሴቁስ ህንዻምሱ።","poem":2},{"text":"እን አመነሙማዻን ሙርቲ ቀጄላ ንፍደ፤","poem":1}]},{"type":"verse","number":4,"content":[{"text":"ሀመ ሙርቲ ቀጄላ ለፈረት ፍዱት፣","poem":2},{"text":"እን ህንደዸቡ፤ አብዲስ ህንኩተቱ።","poem":1},{"text":"ብዮትን ብሻን ግዱ ሴረሳ ንአብደቱ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ዋቀዮ ዋቅን ሰሚወን ኡሜ ድሪርሴ፣","poem":1},{"lineBreak":true},{"text":"እን ለፋፊ ወንቶተ እሼ ኬሰ ጅረን ሁንደ ሆጄቴ፣","poem":1},{"text":"እን ሰበ እሼቲፍ ሀፉረ ባፈተን ኬኔ","poem":2},{"lineBreak":true},{"text":"ወረ እሼረ ጅራተኒፍስ","poem":2},{"lineBreak":true},{"text":"ጅሬኘ ኬኔ ሱን አከነ ጄዸ፦","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“አን ዋቀዮ ቀጄሉማዻን ስ ዋሜረ፤","poem":1},{"text":"ሀርከኬስ ነንቀበ።","poem":2},{"text":"አን ስ ኤጌ ሰቦታፍ ከኩ፣","poem":1},{"text":"ነሞተ ኦርማቲፍሞ እፈ ስን ታስሰ፤","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አትስ እጀ ጃሞታ ንበንተ፤","poem":1},{"text":"መነ ህዻቲ ቦጅአምቶተ ንሂክተ፤","poem":2},{"lineBreak":true},{"text":"ወረ ዱከነ ኬሰ ጅራተንስ ህዻዻ ንባፍተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“አን ዋቀዮ፤ መቃንኮስ ከናዸ!","poem":1},{"text":"አን ኡልፍነኮ ከን ብራቲፍ፣","poem":2},{"lineBreak":true},{"text":"ገለተኮስ ዋቆተ ቶልፈሞፍ ደበርሴ ህንኬኑ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኩኖ ወን ዱራኒ ራወተሜረ፤","poem":1},{"text":"አንስ ዋን ሃራ ነንዱበዸ፤","poem":2},{"text":"ኡቱ እሳን ህንብቅልን፣","poem":1},{"text":"አን ዋኤሳኒ ስት ነንኦዴሰ።”","poem":2}]},{"type":"heading","content":["ፋርፈትና ገለታ"]},{"type":"verse","number":10,"content":[{"text":"እስን ወር ገላነ ቡተኒፊ ወንቶትን አች ኬሰ ጅራተን ሁንድ፣","poem":1},{"text":"ብዮትን ብሻን ግዱፊ ወር አች ኬሰ ጅራተን ሁንድ፣","poem":2},{"text":"ፋርፈትና ሃራ ዋቀዮፍ ፋርፈዻ፤","poem":1},{"text":"ሀንዳረ ለፋቲስ ገለተሳ ፋርፈዻ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ገሞጂፊ መጋላወንሼ ሰገሌሳኒ ኦል ሃፉዸተን፤","poem":1},{"text":"ገንዶትን ቄዳር ኬሰ ጅራተን ሃገመደን።","poem":2},{"text":"ነሞትን ሴላ ገመቹዻን ሃፋርፈተን፤","poem":1},{"text":"ፊጤ ቱሉወኒራ ሃእየን።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እሳን ዋቀዮፍ ኡልፍነ ሃኬነን፤","poem":1},{"text":"ብዮተ ብሻን ግዱ ኬሰትስ ገለተሳ ሃለብሰን።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዋቀዮ አከ ነመ ጀባ ቶኮት ንዱለ፤","poem":1},{"text":"አከ ጎተ ቶኮትስ ኦኔሳ ከካሰ፤","poem":2},{"text":"ሰገሌ ኦል ፉዸቴስ ንዻደተ፤","poem":1},{"text":"ዲኖተሳረትስ ኦል ኣንቱማ አርገተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“አን ዬሮ ዼራፍ ጨልእሴረ፤","poem":1},{"text":"አን አፋን ቀበዼ ኦፍ ዾዌረ።","poem":2},{"text":"አመ ገሩ አከ ዱበርቲ ጭኒንሱን ቀቤት ነንእየ፤","poem":1},{"text":"ነንአርገነ፤ ሀፉርስ ነ ጭተ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አን ቱሉወኒፊ ጋረን ነንኦንሰ፤","poem":1},{"text":"ብቅልቱወንሳኒ ሁንደስ ነንጎግሰ፤","poem":2},{"text":"አን ለጌን ብዮተ ብሻን ግዱት ነንጌደረ፤","poem":1},{"text":"ሀሮወንስ ነንጎግሰ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አን ጃሞተ ከራ እሳን ህንቤክኔረ ነንቀጄልቸ፤","poem":1},{"text":"ዳንዲ ዱራን ህንቤከምንረ ነንዴምስሰ፤","poem":2},{"text":"አን ዱከነ ፉለሳኒ ዱረ ጅሩ እፈት ነንጌደረ፤","poem":1},{"text":"ለፈ ቡኣ በዪስ ወል ነንቅጤሰ።","poem":2},{"text":"ወን አን ሆጄዹ ከኔኒዸ፤","poem":1},{"text":"አን እሳን ህንዺሱ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ወር ዋቆተ ቶልፈሞ አመነተን፣","poem":1},{"text":"ከኔን ፈኪወኒን፣ ‘እስን ዋቆተኬኘ’ ጄዸን ገሩ","poem":2},{"lineBreak":true},{"text":"ዱበት ዴብኡ፤ ንሰልጰቱስ።","poem":2}]},{"type":"heading","content":["እስራኤል ጃማፊ ዱዳዸ"]},{"type":"verse","number":18,"content":[{"text":"“እስን ዱዶተነነ፣ ዸገኣ፤","poem":1},{"text":"ጃሞተነነ፣ እላላ፤ አርጋስ!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ተጃጅላኮ መሌ ጃማን ኤኙ?","poem":1},{"text":"ዱዳን አከ ኤርገማ አን ኤርጉ ሰናስ ኤኙ?","poem":2},{"text":"ጃማን አከ ነመ አናፍ ኦፍ ኬኔ፣","poem":1},{"text":"ጃማን አከ ገርብቸ ዋቀዮ ኤኙ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አት ዋን ባይኤ አርግቴ፤ ገሩ ህንቀልቤፈትኔ፤","poem":1},{"text":"ጉርኬ በናዸ፤ ገሩ አት ዋን ቶኮዩ ህንዸጌሱ።”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዋኤ ቀጄሉማሳቲፍ ጄዼ","poem":1},{"text":"ሴረሳ ጉድሱፊ ኡልፍነ ቀቤሰ ጎቹን","poem":2},{"lineBreak":true},{"text":"ዋቀዮን ገመቺሴረ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ሰብን ኩን ገሩ ሰበ ሳመሜ ቦጅአሜዸ፤","poem":1},{"text":"ሁንዲሳኒ ቦለ ኬሰት ክዮዻን ቀበመኒሩ፤","poem":2},{"lineBreak":true},{"text":"መነ ህዻ ኬሰስ ዾክፈመኒሩ።","poem":2},{"text":"እሳን ፉዸተመኒሩ፤","poem":1},{"text":"ከን እሳን በራሩስ ህንጅሩ፤","poem":2},{"text":"እሳን ቦጅአመኒሩ፤","poem":1},{"text":"ነምን፣ “እሳን ዴብሳ” ጄዹስ ህንጅሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"እስን ኬሳ ኤኙቱ ዋን ከነ ዸጌፈተ?","poem":1},{"text":"በረ ዹፉፍ ጅሩ ኬሰስ ኤኙቱ ቀልቤፈቴ ዸገአ?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ኤኙቱ ያቆብን ቦጁፍ፣","poem":1},{"text":"እስራኤልንስ ሳምቶተት ደበርሴ ኬኔ?","poem":2},{"text":"ከን ኑ ጩቡ እት ሆጄትኔ፣ ዋቀዮ ምቲ?","poem":1},{"text":"እሳን ሰበቢ ከራሳ ዱካ ህንቡኔፍ፣","poem":2},{"lineBreak":true},{"text":"ሴረሳቲፍ ህንአጀጀምኔ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ከናፉ እን ዼከምሰሳ ቦበኣ ሰነ፣","poem":1},{"text":"ወራነ ሀማስ እሳንት ኤርጌ።","poem":2},{"text":"አረበ እብዳቲን እሳን መርሴ፤ እሳን ገሩ ህንሁበትኔ፤","poem":1},{"text":"እብድ ሱንስ እሳን ጉቤ፤ እሳን ገሩ ህንቀልቤፈትኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/41.json","previousChapterAudioLinks":{},"numberOfVerses":25}