{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":43,"content":[{"type":"heading","content":["ፈይሳ እስራኤል ቶክቸ"]},{"type":"verse","number":1,"content":[{"text":"አመ ገሩ ያ ያቆብ፣ ዋቀዮ እን ስ ኡሜ፣","poem":1},{"text":"ያ እስራኤል፣ እን ስ ቶልቼ አከነ ጄዸ፦","poem":2},{"text":"“አን ስ ፉሬራቲ ህንሶዳትን፤","poem":1},{"text":"አን መቃኬቲን ስ ዋሜረ፤ አት ከንኮት።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዮሙ አት ብሻን ኬሰ ደበርቱ፣","poem":1},{"text":"አን ስ ወጅነን ጅረ፤","poem":2},{"lineBreak":true},{"text":"ዮሙ አት ለጌን ጬቱስ፣ እሳን ስ ህንልቅምሰን።","poem":2},{"text":"ዮሙ እብደ ኬሰ ዴምቱ፣","poem":1},{"text":"አት ህንጉበቱ፤","poem":2},{"lineBreak":true},{"text":"አረብን እብዳስ ስ ህንጉቡ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አን ዋቀዮ ዋቅንኬ፣","poem":1},{"text":"ቁልቁልች እስራኤል ፈይሳ ኬት፤","poem":2},{"text":"አን ብየ ግብጥ ፉሪኬቲፍ፣","poem":1},{"text":"ቆደ ኬሞ ኩሺፊ ሳባ ነንኬነ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዋን አት እጀኮ ዱረት ጃለተማፊ ከበጀማ ታቴፍ፣","poem":1},{"text":"አንስ ዋነን ስጃለዹፍ፣","poem":2},{"text":"ቆደኬ ነሞተ","poem":1},{"text":"ቆደ ሉቡኬቲሞ ሰቦተ ነንኬነ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አን ስ ወጅነን ጅራቲ ህንሶዳትን፤","poem":1},{"text":"አን እጆሌኬ በአ ቢፍቱቲ ነንፍደ፤","poem":2},{"lineBreak":true},{"text":"ልጠ ቢፍቱቲስ ወልት ስን ቀበ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አን ካባን፣ ‘እሳን ገድ ዺስ!’","poem":1},{"text":"ክባንሞ ‘እሳን ህንዾውን’ ነንጄዸ።","poem":2},{"text":"እልማንኮ ፈጎዻ፣","poem":1},{"text":"እንተለንኮሞ ሀንዳረ ለፋቲ ፍድ፤","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ከን መቃኮቲን ዋመሜ ሁንደ፣","poem":1},{"text":"ከኔን አን ኡልፍነኮቲፍ ኡሜ፣","poem":2},{"lineBreak":true},{"text":"ወረ አን ቶልቼፊ ሆጄዼ ሰነ ፍዳ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ወረ ኡቱ እጀ ቀበኑ ጃመኒ","poem":1},{"text":"ኡቱ ጉረ ቀበኑ ዱደን ገድ ባስ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሰብን ሁንድ ቶኩማዻን ወልት ሃቀበሙ፤","poem":1},{"text":"ነሞትንስ ወል ሃገአን።","poem":2},{"text":"እሳን ኬሳ ነምን ዱራን ዱርሴ ዋን ከነ ኑት ህሜ","poem":1},{"text":"ወንቶተ ዱራስ ኑፍ ለብሴ ኤኙ?","poem":2},{"text":"አከ ወር ካን ዸገአኒ፣ “ኩን ዹጋዸ” ጄዸኒፍ፣","poem":1},{"text":"አከ ዹጋ ቀቤዪ ተኡንሳኒ ምርከኔፈሙፍ","poem":2},{"lineBreak":true},{"text":"እሳን ዹገ ባቶተሳኒ ሃዽኤፈተን።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዋቀዮ አከነ ጄዸ፤","poem":1},{"text":"“አከ እስን ቤክተኒ ነ አመንተኒፍ","poem":2},{"text":"አከ አን እሰ ተኤስ አከ ሁበተኒፍ","poem":1},{"text":"እስን ዹገ ባቶተኮ፣ ገርብቸኮ ከን አን ፍለዼዸ።","poem":2},{"text":"አናን ዱረ ዋቅን ህንሆጄተምኔ፤","poem":1},{"text":"አናን ቦዴስ ህንጅራቱ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አነ፣ አኑመ ቆፈቱ ዋቀዮ፤","poem":1},{"text":"አነ መሌስ ፈይሳን ብራ ህንጅሩ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አን ሙልእሴረ፤ ፈይሴረ፤ ለብሴረስ፤","poem":1},{"text":"አነ መሌ ዋቅን ኦርማ ግዱኬሰን ህንቱሬ።","poem":2},{"text":"አከ አን ዋቀ ተኤ፣ እስን ዹገ ባቶተኮት”ጄዸ ዋቀዮ።","poem":1}]},{"type":"verse","number":13,"content":[{"text":"“በረ ዱሪቲ ጀልቀቤ አን እሱመ።","poem":2},{"text":"ነምን ቶኮዩ ሀርከኮቲ ዋ ባሱ ህንደንደኡ።","poem":1},{"text":"አን ነንሆጄዸ፤ ኤኙቱ ዾዉ ደንደአ?”","poem":2}]},{"type":"heading","content":["አራረ ዋቃቲፊ አመነሙማ ዸቡ እስራኤል"]},{"type":"verse","number":14,"content":[{"text":"ዋቀዮ ፉሪንኬ፣","poem":1},{"text":"ቁልቁልች እስራኤል አከነ ጄዸ፦","poem":2},{"text":"“አን እስኒፍ ጄዼ ባብሎንት ሎልቶተ ኤርጌ","poem":1},{"text":"ዶኒወን እሳን እቲን ቦነኒን","poem":2},{"lineBreak":true},{"text":"ነሞተ ባብሎን ሁንደ ቦጅኤ ነንፍደ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አን ዋቀዮ፣ ቁልቁልቸኬሰን፣","poem":1},{"text":"ኡማ እስራኤል፣ ሞቲኬሰኒዸ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ዋቀዮ እን፣ ገላነ ኬሳን ከራ፣","poem":1},{"text":"ብሻኖተ ጀጀቦ ኬሳንሞ ዳንዲ ቶልቼ አከነ ጄዸ፤","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እን ጋሪወኒፊ ፈርዴን፣ ሎልቶታፊ ገርጋርቶተሳኒ","poem":1},{"text":"ቶኩማዻን አርኤ ባሴ አከነ ጄዸ፤","poem":2},{"text":"እሳን አቹመ ጭጪሱ፤ ለመተስ ህንከአን፤","poem":1},{"text":"አኩመ ፎኣ እብሳትስ ዻመኒ በዱ፤","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“ወንቶተ ዱሪ እራንፈዻ፤","poem":1},{"text":"ዋን ደርቤትስ ህንጭችና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ኩኖ፣ አን ዋን ሃራ ቶኮ ነንሆጄዻ!","poem":1},{"text":"እንስ አመ ንብቅለ፤ እስን ህንሁበተኒ?","poem":2},{"text":"አን ገሞጂ ኬሰት ከራ ነንቆጴሰ፤","poem":1},{"text":"ለፈ ኦና ኬሰትስ ቡርቃ ነንቡርቅሲሰ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ብኔንሶትን ቦሶና፣","poem":1},{"text":"ዋንጎወኒፊ ጉቺወን ኡልፍነ ናፍ ኬኑ፤","poem":2},{"text":"አከ ሰብንኮ ከን አን ፍለዼ ዹጉፍ፣","poem":1},{"text":"አን ገሞጂ ኬሰት ብሻን፣","poem":2},{"lineBreak":true},{"text":"ለፈ ኦና ኬሰትስ ቡርቃ ነንኬናቲ፤","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሰብን አን ኦፊኮቲፍ ፍለዼ","poem":1},{"text":"አከ ነ ገለቴፈቱፍ ቱሬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“ያ ያቆብ፣ አት ገሩ ነ ህንዋመትኔ፤","poem":1},{"text":"ያ እስራኤል፣ አት ፉለኮ ዱረት ደዸብዴርተ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"አት ኣርሳ ጉበሙፊ ሆሎተ ናፍ ህንፍድኔ፤","poem":1},{"text":"ዮካን ኣርሳኬቲን ኡልፍነ ናፍ ህንኬንኔ።","poem":2},{"text":"አን ኣርሳ ምዻኒቲን ስ ህንረክፍኔ፤","poem":1},{"text":"ዮካን ኣርሳ እጣና ጋፈቹዻን ስ ህንደዸብሲፍኔ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"አት ቁንዺ ኡርጋ ጋሪ ቀቡ ና ህንብትኔ፤","poem":1},{"text":"ዮካን ጮመ ቀልመኬቲቲን ነ ህንቁብስኔ።","poem":2},{"text":"ገሩ በኣ ጩቡኬቲ ነት ፌቴ፤","poem":1},{"text":"የከኬቲንስ ነ ደዸብሲፍቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“ከን ኦፊኮቲፍ ጄዼ የከኬ ስራ ሀቄ","poem":1},{"text":"ጩቡኬስ ዴብኤ ህንያደትኔ፣ አን አኑመ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ሜ ዋን ደርቤረ ና ዴብእ፤","poem":1},{"text":"ወልት ዹፍኔ ዱቢ ከነረት ሃፈልምኑ፤","poem":2},{"lineBreak":true},{"text":"ዱቢኬ ዽኤፈዹቲ ቀጄላ ተኡኬ ምርከኔፈዹ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"አባንኬ ከን ጀልቀባ ጩቡ ሆጄቴ፤","poem":1},{"text":"በርሲስቶትንኬ ነት ፍንጭለን።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ከናፉ አን እት ጋፈተምቶተመነ ቁልቁሉማኬቲ ነንሰልጵሰ፤","poem":1},{"text":"ያቆብን በዲሳፍ፣","poem":2},{"lineBreak":true},{"text":"እስራኤልንሞ ቱፊፍ ደበርሴ ነንኬነ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":28}