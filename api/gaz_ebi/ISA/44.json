{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":44,"content":[{"type":"heading","content":["እስራኤል ሰበ ፍለተማ"]},{"type":"verse","number":1,"content":[{"text":"“አመ ገሩ ያ ያቆብ ገርብቸኮ፣","poem":1},{"text":"ያ እስራኤል ከን አን ስ ፍለዼ፣ ዸጌፈዹ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዋቀዮ እን ስ ኡሜ፣","poem":1},{"text":"ከን ገደሜሰ ኬሰት ስ ቶልቼ፣","poem":2},{"lineBreak":true},{"text":"እን ስ ገርጋሩ ሱን አከነ ጄዸ፦","poem":2},{"text":"ያ ገርብቸኮ ያቆብ፣","poem":1},{"text":"ያ ይሹሩን ከን አን ስ ፍለዼ ህንሶዳትን።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አን ለፈ ዼቦቴረት ብሻን፣","poem":1},{"text":"ለፈ ጎጋረት ቡርቃ ነንዸንገላሳቲ፤","poem":2},{"text":"አን እጆሌኬረት ሀፉረኮ፣","poem":1},{"text":"ሰኚኬረትሞ ኤበኮ ነንዸንገላሰ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እሳን አኩመ መርገ ብሻን ግዱቲፊ","poem":1},{"text":"አከ ሙከ አለልቱ ከን ቀርቀረ ለጋ ጅሩት ንለልሱ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ነምን ቶኮ፣ ‘አን ከን ዋቀዮት’ ኦፊን ጄዸ፤","poem":1},{"text":"ከን ብራ መቃ ያቆቢን ኦፍ ዋመ፤","poem":2},{"text":"ካንሞ ሀርከሳረት፣ ‘አን ከን ዋቀዮት’ጄዼ በሬፈተ፤","poem":1},{"text":"መቃ እስራኤሊንስ ኦፍ ዋመ።","poem":2}]},{"type":"heading","content":["ዋቀዮ ቶክቹመ"]},{"type":"verse","number":6,"content":[{"text":"“ዋቀዮ ሞቲፊ ፉሪን እስራኤል","poem":1},{"text":"ዋቀዮ ዋን ሁንደ ደንደኡ አከነ ጄዸ፦","poem":2},{"text":"አን ከን ጀልቀባት፤ አን ከን ዹማትስ፤","poem":1},{"text":"አነ መሌ ዋቅን ብራ ህንጅሩ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዮስ ከን አከኮ ኤኙ? ሜ እን ሀፉረ ሃባፈቱ።","poem":1},{"text":"እን ዋን ኤርገ አን ሰበኮ ከን ዱሪ ሁንዴሴ አስ ተኤ፣","poem":2},{"text":"ዋን ሀመ አማት ህንተእን ሃዱበቱ፤","poem":1},{"text":"ፉለኮ ዱረትስ ሃእብሱ፤","poem":2},{"lineBreak":true},{"text":"ዋን ገረ ፉልዱራት ተኡሌ ዱራን ዱርሴ ሃህሙ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ህንርፈትና፤ ህንሶዳትና።","poem":1},{"text":"አን ዋን ከነ ለብሴ በረ ዼራን ዱረ ስት ህንህምኔ?","poem":2},{"text":"እስን ዹገ ባቶተኮት። አነ መሌ ዋቅን ብራ ጅራ?","poem":1},{"text":"ለኪ፣ ከታን ብራ ህንጅሩ፤ አን ቶኮዩ ህንቤኩ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ወር ዋቆተ ቶልፈሞ ቶልቸን ሁንድ ገቲ ህንቀበን፤","poem":1},{"text":"ወን እሳን ሀወን ፋይዳ ህንቀቡ።","poem":2},{"text":"ወር እሳኒፍ ፈልመንስ ጃሞተ፤","poem":1},{"text":"እሳን ቤኩምሰ ህንቀበን፤ ከናፉ ንቃኔፈሙ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኤኙቱ ዋቀ ቶልፈማፊ","poem":1},{"text":"ፈኪ ሆማ እሰ ህንፈየድኔ ቶልቸ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እሳፊ ነምን አከሳ ንቃኔፈመ፤","poem":1},{"text":"ኦጌዪን ሆጂ ሀርካስ ነሞቱመ መሌ ሆማ ምት።","poem":2},{"text":"እሳን ሁንድ ወልት ቀበመኒ እዶ ቶኮ ሃዻበተን፤","poem":1},{"text":"እሳን ንነኡ፤ ንሰልጰቱስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ቱምቱን ሜሻ እቲን ዋ ቱሙ ሀርከት ቀበቴ","poem":1},{"text":"ጭሌ ቦበኡረት እቲን ሆጄተ፤","poem":2},{"text":"እን ቡሩሳን ዋቀ ቶልፈማ ቶልቸ፤","poem":1},{"text":"እሬሳ ጀባዻንስ ንሚዸግሰ።","poem":2},{"text":"እን ንቤለአ፤ ሁምነስ ንዸበ፤","poem":1},{"text":"ብሻን ህንዹጉ፤ ንገገበስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ነምን ሙከ ሶፉ ፉኞዻን ሰፈረ","poem":1},{"text":"ጭላቲዻን መለቶ እት ጎዸ፤","poem":2},{"text":"ቅርጢዻን ቅሪጤ","poem":1},{"text":"ሰፈርቱዻን መለቶ እት ጎዸ።","poem":2},{"text":"ፈኪ ነማቲን ሆጄተ፤","poem":1},{"text":"አከ እን ገልመ ዋቄፈትና ኬሰ ጅራቱፍስ","poem":2},{"lineBreak":true},{"text":"ሚዸግነ ነማ እት ቶልቸ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እን ብርብርሰ ሙረ፤","poem":1},{"text":"ጋትራ ዮካን ቅልጡ ፍለተ።","poem":2},{"text":"አከ እን ሙኬን ቦሶና ኬሰት ጉደቱፍ ንዺሰ፤","poem":1},{"text":"ዮካን ሀዼሰ ዻበ፤ ቦካንስ እሰ ጉድሰ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሙክን ሱን ቆራን ቦቤፈሙ ተአ፤","poem":1},{"text":"ነምን ሙራሰሳ ፉዸቴ ቦቤሴ ቀቃመተ፤","poem":2},{"lineBreak":true},{"text":"እብደ ቀብሲሴ ቡዴነ እቲን ቶልፈተ።","poem":2},{"text":"ዋቀ ሶባስ ቶልፈቴ ዋቄፈተ፤","poem":1},{"text":"ዋቀ ቶልፈማስ ቶልፈቴ ገድ ጄዼ ሰገዳፍ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ገርቶኬ ሙኬን ሰና ንቦቤሰ፤","poem":1},{"text":"እሰረት ኛተ ብልቼፈተ፤","poem":2},{"lineBreak":true},{"text":"ፎንስ እረት ዋደቴ ሀመ ቁፉት ኛተ።","poem":2},{"text":"እብደ ቀቃመቻስ፣","poem":1},{"text":"“እሾ! እብድ ነት ሆኤ፤ እብደ ነንአርገ” ጄዸ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሙኬን ሀፈኒንሞ ዋቀ ሶባ፣ዋቀሳ ቶልፈማ ቶልፈተ፤","poem":1},{"text":"ገድ ጄዼስ ንሰገዳፍ።","poem":2},{"text":"እሰ ከዸቴስ፣","poem":1},{"text":"“ስቱ ዋቀኮት፤ ነ በራር” ጄዻን።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እሳን ሆማ ህንቤከን፤ ሆማ ህንሁበተንስ፤","poem":1},{"text":"አከ አርጉ ህንደንዴኜፍ እጅሳኒ ሀጉገሜረ፤","poem":2},{"lineBreak":true},{"text":"አከ ህንሁበኔፍስ ቀልቢንሳኒ ጩፈሜረ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ነምን ቶኮዩ እት ህንያዱ፤","poem":1},{"text":"ነምን ቶኮዩ አከነ ጄቹፍ ቤኩምሰዮካን ሁበትና ህንቀቡ፤","poem":2},{"text":"“አን ወለካሳ ቆራን ጎዸዼረ፤","poem":1},{"text":"ጭሌሳረት ቡዴነ ቶልፈዼ","poem":2},{"lineBreak":true},{"text":"ፎን እቲን ዋደዼ ኛዼረ።","poem":2},{"text":"አን አመ ዋን ሀፌ ከናን ዋን ጅብሲሳ ነንሆጄዻ?","poem":1},{"text":"አን ገድ ጄዼ ጅርማፍ ሰገዱ ቀባ?”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እን ዳራ ኛተ፤ ገራን ጎዎምፈሜስ ከራራ እሰ ጀልእሴረ፤","poem":1},{"text":"እን ኦፍ ኦልቹ ዮካን፣","poem":2},{"lineBreak":true},{"text":"“ወን ሀርከኮ ምርጋ ኬሰ ጅሩ ኩን ሶበ ምቲ?”ጄቹ ህንደንደኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“ያ ያቆብ፣ አት ዋን ከነ ያደዹ፤","poem":1},{"text":"ያ እስራኤል፣ አት ገርብቸኮት።","poem":2},{"text":"አን ስ ቶልቼረ፤ አትስ ገርብቸኮት፤","poem":1},{"text":"ያ እስራኤል፣ አን ስ ህንደገዹ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"አን የከኬ አኩመ ዱሜሳ፣","poem":1},{"text":"ጩቡኬስ አኩመ ሁሪ ገነማ ሀጣኤ በሌሴረ።","poem":2},{"text":"አን ስ ፉሬራቲ፣","poem":1},{"text":"አት ገረኮት ዴብእ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ያ ሰሚወን፣ ዋቀዮ ዋን ከነ ጎዼራቲገመቹዻን ፋርፈዻ፤","poem":1},{"text":"ያ ቅሌወን ለፋ፣ ገመቹዻን እያ።","poem":2},{"text":"እስን ያ ቱሉወን፣ ቦሶኖትኒፊ ሙኬንኬሰን ሁንድ እልልቻ፤","poem":1},{"text":"ዋቀዮ ያቆብን ፉሬ እስራኤል ኬሰት ኡልፍነሳ እብሴራቲ።","poem":2}]},{"type":"heading","content":["ዬሩሳሌም ለፈ ጅሬኛ ንታት"]},{"type":"verse","number":24,"content":[{"text":"“ዋቀዮ ፉሪንኬ፣","poem":1},{"text":"ከን ገደሜሰ ኬሰት ስ ቶልቼ አከነ ጄዸ፦","poem":2},{"lineBreak":true},{"text":"አን ዋቀዮ ቶልቻን ዋን ሁንዳ","poem":1},{"text":"እሰ ሰሚወን ድሪርሴ፣","poem":2},{"lineBreak":true},{"text":"እሰ ኦፉመኮቲን ለፈሌ ድሪርሴዸ፤","poem":2}]},{"type":"verse","number":25,"content":[{"text":"እሰ መለቶ ራጆተ ሶባ","poem":1},{"text":"ቡሼሴ እላልቶተ ራቴሱ፣","poem":2},{"text":"እሰ ኦጌዪ ዱበት ዴብሴ","poem":1},{"text":"ቤኩምሰሳኒ ፋይዳ ዸብሲሱዸ፤","poem":2}]},{"type":"verse","number":26,"content":[{"text":"እሰ ዱቢ ገርቦተሳ ምርከኔሴ","poem":1},{"text":"ራጂ ኤርገሞተሳ ፊጣን ባሱ፣","poem":2},{"lineBreak":true},{"text":"እሰ፣ ‘እሼን እዶ ጅሬኛ ንታት’ ጄዼ","poem":1},{"text":"ዋኤ ዬሩሳሌም ዱበቴ፣ እሰ፣ ‘እሳን ንእጃረሙ፣","poem":2},{"lineBreak":true},{"text":"ዲገማሳኒስ ነንሃሮምሰ’ ጄዼ","poem":2},{"lineBreak":true},{"text":"ዋኤ መጋላወን ይሁዳ ዱበቱዸ፤","poem":2}]},{"type":"verse","number":27,"content":[{"text":"እሰ ቱጁባን፣ ‘አት ጎግ፤","poem":1},{"text":"አን ለጌንኬ ነንጎግሰ’ ጄዹ፣","poem":2}]},{"type":"verse","number":28,"content":[{"text":"እሰ ቂሮስን፣ ‘እን ትክሴኮት፤","poem":1},{"text":"ፌዺኮ ሁንደስ ንራወተ፤","poem":2},{"lineBreak":true},{"text":"እን ዋኤ ዬሩሳሌም፣ “እሼን ዴብፈምቴ ሃእጃረምቱ”","poem":2},{"text":"ዋኤ መነ ቁልቁሉማሞ፣ “ሁንዴንሳ ሃሁንዴፈሙ”","poem":1},{"text":"ጄዼ ዱበቱ ሱን አኑመ።’","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/43.json","previousChapterAudioLinks":{},"numberOfVerses":28}