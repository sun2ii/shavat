{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":45,"content":[{"type":"verse","number":1,"content":[{"text":"“ዋቀዮ ድበማሳ ቂሮስ፣","poem":1},{"text":"ከን አን ሰቦተ እሰ ጀለት ቡልቹፊ","poem":2},{"text":"ህዸትና ሞቶታ ሂክስሱፍ ጄዼ","poem":1},{"text":"ሀርከሳ ምርጋ ቀቤ","poem":2},{"text":"አከ ከረወን ህንጩፈምኔፍ፣","poem":1},{"text":"በልበለወን በኑፍ ሰናን አከነ ጄዸ፦","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አን ፉለኬ ዱረ ዴሜ","poem":1},{"text":"ቱሉወን ወል ነንቅጤሰ፤","poem":2},{"text":"ከረወን ናሲ ነንጨጨብሰ፤","poem":1},{"text":"ደንቀራወን ስቢላስ ነንኩኩተ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አት አከ አን ዋቀዮ","poem":1},{"text":"ዋቀ እስራኤል እሰ መቃኬቲን ስ ዋሙ ተኤ አከ ቤክቱፍ፣","poem":2},{"text":"አን በዻዹማ ዱከነ ኬሳ፣","poem":1},{"text":"ቀቤኘ ለፈ ዾክሳት ኩፈሜስ ሲፍ ነንኬነ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አት ነ ቤኩ ባቱዩ፣","poem":1},{"text":"አን ገርብቸኮ ያቆቢፍ፣","poem":2},{"text":"እስራኤል ፍለተማኮቲፍ ጄዼ","poem":1},{"text":"መቃኬቲን ስ ዋሜረ፤","poem":2},{"lineBreak":true},{"text":"መቃ ኡልፍናስ ሲፍ ኬኔረ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አን ዋቀዮ፤ አነ መሌ ከን ብራ ህንጅሩ፤","poem":1},{"text":"አነ መሌ ዋቅን ቶኮዩ ህንጅሩ።","poem":2},{"lineBreak":true},{"text":"አት ነ ቤኩ ባቱዩ፣ አን ስን ጀቤሰ፤","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኩንስ አከ ነሞትን በአ ቢፍቱቲ ሀመ ልጠ ቢፍቱት፣","poem":1},{"text":"አነ መሌ ከን ብራ አከ ህንጅሬ ቤከኒፍ።","poem":2},{"text":"አን ዋቀዮ፤ አነ መሌ","poem":1},{"text":"ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አን እፈ ነንቶልቸ፤ ዱከነስ ነንኡመ፤","poem":1},{"text":"በዻዹማ ነንፍደ፤ በላስ ነንኡመ፤","poem":2},{"lineBreak":true},{"text":"አን ዋቀዮ ወንቶተ ከኔን ሁንደ ነንጎዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ያ ሰሚወን፣ እስን ኦል ጉባዻ ቀጄሉማ ሮብሳ፤","poem":1},{"text":"ዱሜሶንስ ገድ ጮጮብሳ።","poem":2},{"text":"ለፍት ሃበነምቱ፤","poem":1},{"text":"ፈይን ሃብቅሉ፤","poem":2},{"text":"ቀጄሉማንስ እሰ ወጅን ሃጉደቱ፤","poem":1},{"text":"አን ዋቀዮ ዋን ከነ ኡሜረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ቅራጪ ቅራጪዹመ ለፋ ተኤ","poem":1},{"text":"ኡማሳቲን ወል ሎሉፍ ወዮ።","poem":2},{"text":"ሱጴን፣ ሱጴ ዾፍቱዻን፣","poem":1},{"text":"‘አት ማል ሆጄቻ ጅርተ?’ ጄዻ?","poem":2},{"text":"ሆጂን አት ሆጄቱስ፣","poem":1},{"text":"‘እን ሀርከ ህንቀቡ’ ሲን ጄዻ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ነመ አባዻን፣ ‘አት ማል ዸልችቴ?’","poem":1},{"text":"ዮካን ሃዻን፣ ‘አት ማል ዴሴ?’ ጄዹፍ ወዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ዋቀዮ፣ ቁልቁልች እስራኤል","poem":1},{"text":"ኡማንሼ ሱን አከነ ጄዸ፦","poem":2},{"text":"እስን ዋኤ ወንቶተ ዹፉፍ ጅረኒ ጄቹንስ፣","poem":1},{"text":"‘ዋኤ እጆሌኮ ነ ጋፈዻ፤","poem":2},{"lineBreak":true},{"text":"ዮካን ዋኤ ሆጂ ሀርከኮ ነ አጀጃ።’","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ከን ለፈ ቶልቼ ነመስሼረት ኡሜ አነ።","poem":1},{"text":"ሀርክኮ ሰሚወን ድሪርሴረ፤","poem":2},{"lineBreak":true},{"text":"ራያሳኒ ሁንደስ አጀጄረ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አን ቀጄሉማኮቲን ቂሮስን ኦል ነንካሰ፦","poem":1},{"text":"ከራሳ ሁንደስ ወል ነንቅጤሰ።","poem":2},{"text":"እን መጋላኮ ዴብሴ እጃረ፤","poem":1},{"text":"ቦጅአምቶተኮስ ብልሰ ባሰ፤","poem":2},{"text":"ገሩ ገቲዻን ዮካን በዻሳን ምት፣","poem":1},{"text":"ጄዸ ዋቀዮ ዋን ሁንደ ደንደኡ።”","poem":2}]},{"type":"verse","number":14,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“ቀቤኝ ግብጢፊ ደልደል እቶጵያ፣","poem":1},{"text":"ነሞትን ዼዼሮን ሳባ፣","poem":2},{"text":"ገረኬ ንዹፉ፤","poem":1},{"text":"ከንኬስ ንተኡ፤","poem":2},{"text":"እሳን ፎንጫዻን ህዸመኒ","poem":1},{"text":"ዱግደ ዱባን ስ ዱካ ቡኡ።","poem":2},{"text":"ፉለኬ ዱረትስ ገድ ጄዸኒ","poem":1},{"text":"‘ዹጉማን ዋቅን ስ ወጅን ጅረ፤እሰ መሌስ ቶኮዩ ህንጅሩ፤","poem":2},{"text":"እሰ መሌስ ዋቅን ብራ ህንጅሩ’","poem":1},{"text":"ጄዸኒ ስ ከዸቱ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ያ ዋቅ፣ ፈይሳ እስራኤል፣","poem":1},{"text":"አት ዹጉማን ዋቀ ኦፍ ዾክስቱዸ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ወር ዋቆተ ቶልፈሞ ቶልቸን ሁንድኑ ንቃነኡ፤ ንሰልጰቱ፤","poem":1},{"text":"ወሊ ወጅንስ ሰልጵነ ኬሰ ቡኡ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እስራኤል ገሩ ፈይነ በረ በራቲን","poem":1},{"text":"ዋቀዮ ንፈይፈመ፤","poem":2},{"text":"እስን በረ በራን ህንቃኖፍተን፤","poem":1},{"text":"ዮካን ህንሰልጰተን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ዋቀዮ አከነ ጄዸ፤","poem":1},{"lineBreak":true},{"text":"ከን ሰሚወን ኡሜ፣ እን ዋቀ፤","poem":1},{"text":"እን ለፈ ሚዸግሴ ቶልቼ እሼ ሁንዴሴ፤","poem":2},{"text":"እን አከ እሼን እዶ ጅሬኛ ታቱፍ እሼ ኡሜ መሌ","poem":1},{"text":"አከ እሼን ኦነ ታቱፍ እሼ ህንኡምኔ፤","poem":2},{"text":"እን አከነ ጄዸ፤","poem":1},{"text":"“አን ዋቀዮ፤ አነ መሌ ከን ብራ ህንጅሩ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አን ብየ ዱከና ኬሳ","poem":1},{"text":"ዾክሳዻን ህንዱበትኔ፤","poem":2},{"text":"አን ሰኚወን ያቆቢን፣","poem":1},{"text":"‘አከሱማን ነ በርባዳ’ ህንጄኔ።","poem":2},{"text":"አን ዋቀዮ ዹጋ ነንዱበዸ፤","poem":1},{"text":"ዋን ቀጄላስ ነንለብሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ወልት ቀበማ ኮታ፤","poem":1},{"text":"እስን በቀቶትን ሰቦታ ወል ገኣ።","poem":2},{"text":"ወር ዋቀ ቶልፈማ ሙከራ ሆጄተሜ ባተን፣","poem":1},{"text":"ከኔን ዋቆተ ፈይሱ ህንደንዴኜ ከዸተንሆማ ቤኩምሰ ህንቀበን።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዋነን ተኡ ቀቡ ዱበዻ፤ ዽኤፈዻስ፤","poem":1},{"text":"እሳንስ ወሊ ወጅን ሃመርአተን።","poem":2},{"text":"ኤኙቱ ዋን ከነ ዱራን ዱርሴ በረ ዼራን ዱረ ህሜ?","poem":1},{"text":"ዱሩመዩ ኤኙቱ ለብሴ?","poem":2},{"text":"አኑመ ዋቀዮ ምቲ?","poem":1},{"text":"አነ መሌ ዋቅን ቀጄላፊ","poem":2},{"text":"ፈይሳን ቶኮዩ ህንጅሩ፤","poem":1},{"text":"አነ መሌ ቶኮሌ ህንጅሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“እስን ወር ሀንዳረ ለፋ ሁንድ፣","poem":1},{"text":"ገረኮት ዴብኣቲ ፈያ፤","poem":2},{"lineBreak":true},{"text":"አን ዋቀ፤ አነ መሌ ከን ብራ ህንጅሩቲ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"አን መታኮቲን ከከዼረ፤","poem":1},{"text":"አፋንኮስ አከነ ጄዼ ቀጄሉማዻን","poem":2},{"lineBreak":true},{"text":"ዱቢ ህንጌደረምኔ ዱበቴረ፤","poem":2},{"text":"‘ጅልብ ሁንድ ፉለኮ ዱረት ንጅልቤንፈተ፤","poem":1},{"text":"አረብን ሁንድስ አናን ከከተ።’","poem":2}]},{"type":"verse","number":24,"content":[{"text":"እሳንስ፣ ‘ቀጄሉማፊ ጀብን ዋቀዮ ቆፋን አርገመ’","poem":1},{"text":"ጄዸኒ ዋኤኮ ንዱበቱ።”","poem":2},{"text":"ወር ኣሪዻን እሰት ከአን ሁንድ፣","poem":1},{"text":"ገረሳ ዹፈኒ ንቃነኡ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ሰኚን እስራኤል ሁንድ ገሩ፣","poem":1},{"text":"ዋቀዮን ቀጄልቶተ ታስፈሙ፤","poem":2},{"lineBreak":true},{"text":"ንከበጀሙስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}