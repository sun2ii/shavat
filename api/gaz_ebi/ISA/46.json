{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":46,"content":[{"type":"heading","content":["ዋቆተ ባብሎን"]},{"type":"verse","number":1,"content":[{"text":"ቤል ገድ ጄዸ፤ ኔቦ አከ መሌ ጉጉፈ፤","poem":1},{"text":"ዋቆንሳኒ ቶልፈሞን ኮቴ ዱዳፊ ሆሪት ፌአመኒሩ፤","poem":2},{"text":"ፈኪወን እሳን ቀበተኒ ጆረን በኣዸ፤","poem":1},{"text":"ሆሪ ደዸቤፍ በኣዸ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እሳን ጉጉፈኒ ወሊ ወጅን ገድ ጄዹ፤","poem":1},{"text":"በኣ ሰነ ኦልቹ ህንደንደአን፤","poem":2},{"lineBreak":true},{"text":"እሳንዩ ንቦጅአሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“ያ መነ ያቆብ፣","poem":1},{"text":"እስን ሀምባን መነ እስራኤል ሁንድ፣","poem":2},{"text":"ወር አን ጋፈ እስን ገደሜሰ ኬሰትኡመምተኒ ጀልቀቤ ኦል እስን ቀቤ","poem":1},{"text":"ጋፈ ዸለተኒ ጀልቀቤስ እስን ባዼ ሁንድ ዸጌፈዻ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሀመ ዱሎምተኒ አሪ ባፍተንት፣","poem":1},{"text":"አን እሰ፤ እሱመ እስን ጅራችሱዸ።","poem":2},{"text":"አን እስን ኡሜረ፤ እስነን ባዸስ፤","poem":1},{"text":"አን እስነን ጅራችሰ፤ እስነን በራረስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“እስን ኤኙን ወል ብረ ነ ቀብዱ ዮካን ኤኙን ወል ነ ቅጤስቱ?","poem":1},{"text":"አከ ወል መዳሉፍስ ኤኙት ነ ፈኬስቱ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ነሞትን ቶኮ ቶኮ ኮሮጆሳኒ ኬሳ ወርቄ ገድ ነቀኒ","poem":1},{"text":"መዳሊዻን ሜቲ መዳሉ፤","poem":2},{"text":"ዋቀ ቶልፈማ ቶልቹፍ ጄዸኒ ቱምቱ ወርቄ ቀጨሩ፤","poem":1},{"text":"እሳንስ ገድ ጄዸኒ ሰገዱፍ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኦል ፉዸኒ ገቲቲሳኒት ንባቱ፤","poem":1},{"text":"እዶሳት ንዴብሱ፤ እንስ አች ዻበተ።","poem":2},{"lineBreak":true},{"text":"እን እዶ ሰና ሶቾኡ ህንደንደኡ።","poem":2},{"text":"ዮ ነምን ገረሳት እዬዩ፣ እን ዴቢ ህንኬኑ፤","poem":1},{"text":"እን ረኮሳ ኬሳ እሰ ባሱ ህንደንደኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ያ ፍንጭልቶተ፣ ዋን ከነ ያደዻ፤","poem":1},{"text":"ቀልቢትስ ቀበዻ፤ ገራኬሰን ኬሰስ ካአዻ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ወንቶተ ደርበን ከኔን በረ ዱሪ ያደዻ፤","poem":1},{"text":"አን ዋቀ፤ ከን ብራ ህንጅሩ፤","poem":2},{"lineBreak":true},{"text":"አን ዋቀ፤ ከን አከኮ ህንጅሩ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አን ዹመ ዋን ቶኮ ጀልቀቡመት ነንለብሰ፤","poem":1},{"text":"ዋን አመዩ ዹፉፍ ጅሩ፣ አን ዱሩማ ጀልቀቤ ዱበዼረ።","poem":2},{"text":"አን፣ ‘ካዮንኮ ጭሜ ጅራተ፤","poem":1},{"text":"ዋን ነ ገመቺሱ ሁንደስ ነንሆጄዸ’ ነንጄዸ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"በአ ቢፍቱቲ አላቲ ዋ አደምስቱ፣","poem":1},{"text":"ለፈ ፈጎቲሞ ነመ ካዮኮ ፊጣን ባሱ ነንዋመ።","poem":2},{"text":"አን ዋነን ዱበዼ ነንጉተ፤","poem":1},{"text":"ዋነን ከሮርፈዼስ ነንራወዸ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ያ መተ ጀቤዪ፣","poem":1},{"text":"እስን ወር ቀጄሉማራ ፈጎ ጅርተን ነ ዸጌፈዻ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አን ቀጄሉማኮ ነንዽኤሰ፤","poem":1},{"text":"እንስ ፈጎ ህንጅሩ፤","poem":2},{"lineBreak":true},{"text":"ፈይሱንኮስ ህንበርፈቱ።","poem":2},{"text":"አን ጥዮኒፍ ፈይነ፣","poem":1},{"text":"እስራኤሊፍሞ ኡልፍነኮ ነንኬነ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/45.json","previousChapterAudioLinks":{},"numberOfVerses":13}