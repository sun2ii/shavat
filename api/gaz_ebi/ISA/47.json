{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":47,"content":[{"type":"heading","content":["ኩፋቲ ባብሎን"]},{"type":"verse","number":1,"content":[{"text":"“ያ እንተለ ባብሎን ዱርበ ቁልቁልቲ፣","poem":1},{"text":"ገድ ቡእ፤ አዋረረ ታእ፤","poem":2},{"text":"ያ እንተለ ባብሎኖታ፣","poem":1},{"text":"ቴሶ መሌ ለፈ ታእ!","poem":2},{"text":"አት ስአች በሬዱ","poem":1},{"text":"ዮካን ክቹ ጄዸምቴ ህንዋመምቱ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዸጋ ዳኩ ፉዸዹቲ ምዻን ዳክ፤","poem":1},{"text":"ሀጉጊኬ ኦፍራ ፉዽ።","poem":2},{"text":"ወንደቦኬ ሶቆለዹ፤","poem":1},{"text":"ጉዴደኬ ሙልእስ፤ ለገ ጬእ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ቁላንኬ እፈት ንበአ፤","poem":1},{"text":"ቃኒንኬስ ህንዾከቱ።","poem":2},{"text":"አን ሃሎ ነንበአ፤","poem":1},{"text":"አን ነመ ቶኮዩ ህንዺሱ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ፉሪንኬኘ መቃንሳ ዋቀዮ ዋን ሁንደ ደንደኡዸ፤","poem":1},{"text":"እን ቁልቁልቸ እስራኤል።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ያ እንተለ ባብሎኖታ፣","poem":1},{"text":"ጨልእሲ ታኢቲ ዱከነ ሴን፤","poem":2},{"text":"አት ስአች","poem":1},{"text":"ሞትቲ ሞቱሞታ ጄዸምቴ ህንዋመምቱ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አን ሰበኮት ዼከሜረ፤","poem":1},{"text":"ሀንዹራኮስ ጡሬሴረ፤","poem":2},{"text":"አን ደበርሴ ሀርከኬት እሳን ኬኔረ፤","poem":1},{"text":"አትስ ገራ ህንላፍኔፍ።","poem":2},{"text":"ወረ ዱሎመንረዩ","poem":1},{"text":"ዋንጆ ኡልፋታ ኬሴ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አት፣ ‘አን በረ በራን እት ፉፌ","poem":1},{"text":"ሞትቲ በረ በራ ነንተአ!’ ጄቴ።","poem":2},{"text":"አት ገሩ ወንቶተ ከነ ህንሁበትኔ","poem":1},{"text":"ዮካን ዹምንሳኒ ማል አከ ተኡ ህንያደትኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“አመስ ያ እሼ ቀነኒቱ፣","poem":1},{"text":"ከን ነጋን ጅራቴ","poem":2},{"text":"ገራኬ ኬሰትስ፣","poem":1},{"text":"‘አኑመ፤ አነ መሌ ቶኮዩ ህንጅሩ፤","poem":2},{"text":"አን ስአች ሃዸ ህዬሳ","poem":1},{"text":"ዮካን ነመ ዸሌ ዸቤ ህንተኡ’ ኦፊን ጄቱ ዸገእ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ወንቶትን ኩኔን ለማን፣","poem":1},{"text":"ዸለኒ ዸቡፊ ሃዸ ህዬሳ ተኡን","poem":2},{"lineBreak":true},{"text":"አኩመ ተሳ ጉዩመ ቶኮት ስት ዹፉ።","poem":2},{"text":"እሳን ባይእነ ፈልፈለኬቲቲፊ","poem":1},{"text":"ቶልቸኬ ጭማ ሰና ሁንደ እራንዩ","poem":2},{"lineBreak":true},{"text":"ሁምነሳኒ ጉቱዻን ስት ዹፉ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አት ሀምነኬ አመነቴ፣","poem":1},{"text":"‘ነምን ቶኮዩ ነ ህንአርጉ’ ጄቴ።","poem":2},{"text":"ዬሮ አት ገራኬ ኬሰት፣ ‘አነ፤","poem":1},{"text":"አነ መሌ ነምን ብራ ህንጅሩ’ ጄቱት፣","poem":2},{"lineBreak":true},{"text":"ኦጉማፊ ቤኩምስኬ ስ ዶጎጎርሱ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ወን ሀማን ስት ዹፈ፤","poem":1},{"text":"አትሞ ኤሳ አከ እን ዹፉ ህንቤክቱ።","poem":2},{"text":"በላን አት ኦፍራ እትሱ ህንደንዴኜ ቶኮ ስት ዹፈ፤","poem":1},{"text":"በዲስን አት ዱራን ዱርስቴ ህንቤክን አኩመ ተሳ ስት ዹፈ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ዮስ አት ቶልቸኬቲፊ","poem":1},{"text":"ፈልፈለኬ ባይኤ እጆሉማኬቲ ጀልቀብዴ","poem":2},{"lineBreak":true},{"text":"እት ደዸብዴ ሰነ ጀቤሲ ኤግ።","poem":2},{"text":"ዮ አከስ ተኤ አት ንምልኮፍተ፤","poem":1},{"text":"ዮ አከስ ተኤ ነመ ንሶዳችፍተ ተአ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ጎርስ አት አርገቴ ሁንድ ደዸቢ ቆፈ ስት ፍዴ!","poem":1},{"text":"ኡርጂ ለኮፍቶትንኬ","poem":2},{"text":"ወር ጅአ ጅኣን ኡርጂ እላለኒ ራጀን ሱን፣","poem":1},{"text":"ሜ ዋን ስት ዹፉ ዱራ ስ ሃባሰን ካ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዹጉማን እሳን አኩመ ጭዲት፤","poem":1},{"text":"እብድ እሳን ጉበ።","poem":2},{"text":"እሳን መታሳኒዩ፣","poem":1},{"text":"ሁምነ አረበ እብዳ ጀላ ባሱ ህንደንደአን።","poem":2},{"text":"በርበዳን እብዳ ከን ነምን ሆእፈቱቶኮዩ ህንጅሩ፤","poem":1},{"text":"እብድ ብረ ታአንስ ህንአርገሙ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ወን ወር አት ወጅን ደዸብዴ","poem":1},{"text":"እጆሉማኬቲ ጀልቀብዴ ወጅን ደልደልቴ ሱን","poem":2},{"lineBreak":true},{"text":"ሲፍ ጎቹ ደንደአን ከኑመ።","poem":2},{"text":"ቶኮን ቶኮንሳኒ ዶጎጎረሳኒ እት ፉፈን፤","poem":1},{"text":"ከን ስ ባሱ ደንደኡ ቶኮዩ ህንጅሩ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}