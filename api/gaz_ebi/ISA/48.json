{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":48,"content":[{"type":"heading","content":["መታ ጀባቹ እስራኤል"]},{"type":"verse","number":1,"content":[{"text":"“ያ መነ ያቆብ፣","poem":1},{"text":"እስን ወር መቃ እስራኤሊን ዋመምተን፣","poem":2},{"lineBreak":true},{"text":"ከኔን ሰኚ ይሁዳራ አርገምተን፣","poem":2},{"text":"እስን ወር መቃ ዋቀዮቲን ከከተኒ","poem":1},{"text":"ገሩ ዹጋዻን ዮካን ቀጄሉማዻን ኡቱ ህንተእን","poem":2},{"lineBreak":true},{"text":"መቃ ዋቀ እስራኤል ዾፍተን ዋን ከነ ዸጌፈዻ፤","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እስን ወር መቃ መጋላ ቁልቁልቲቲን ኦፍ ዋምተን፣","poem":1},{"text":"ከኔን ዋቀ እስራኤልት እርከተን፣ዋን ከነ ዸጌፈዻ፤","poem":2},{"lineBreak":true},{"text":"መቃንሳ ዋቀዮ ዋን ሁንደ ደንደኡዸ፦","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አን ወንቶተ ዱሪ ዱራን ዱርሴ ዱበዼረ፤","poem":1},{"text":"እሳን አፋንኮቲ በአን፤ 1 አንስ አከ እሳን ቤከመን ነንጎዼ፤","poem":2},{"lineBreak":true},{"text":"አንስ አኩመ ተሳ ሆጄዼ፤ እሳንስ ንራወተመን።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አን አከ አት መተ ጀቤሰ ታቴ ቤኬን ቱሬቲ፤","poem":1},{"text":"ርቡን ሞርመኬቲ ስቢለ ቱሬ፤","poem":2},{"lineBreak":true},{"text":"አድኬ ናሲ ቱሬ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ከናፉ አን ወንቶተ ከኔን በረ ዼራን ዱረ ስት ህሜረ፤","poem":1},{"text":"አን አከ አት፣ ‘ዋቆተኮ ቶልፈሞቱ እሳን ሆጄቴ፤","poem":2},{"text":"ፈኪኮ ከን ሙከራ ሆጄተሜፊ","poem":1},{"text":"ዋቀ ስቢለራ ሆጄተሜቱ ሙርቴሴ’ጄቹ ህንደንዴኜፍ","poem":2},{"lineBreak":true},{"text":"ኡቱ እሳን ህንኡመምኒን ዱረ ስት ህሜረ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አት ወንቶተ ከኔን ዸጌሴርተ፤ እሳን ሁንደ እላል።","poem":1},{"text":"አት እሳን አመንቴ ህንፉዸቱ?","poem":2},{"lineBreak":true},{"text":"“አን አማ ጀልቀቤ ዋን ሃራ፣","poem":1},{"text":"ዋን ዾክፈሜ ጅሩ ከን አት ህንቤክን ስት ነንህመ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እሳን አመ ኡመመን መሌ በረ ዼራን ዱረ ምት፤","poem":1},{"text":"አት ሀርኣን ዱረ ዋኤሳኒ ህንዸጌኜ።","poem":2},{"text":"ከናፉ አት፣","poem":1},{"text":"‘ኩኖ አን ዋኤሳኒ ቤኬን ቱሬ’ጄቹ ህንደንዴሱ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አት ተኩማ ዸጌሴ ዮካን ሁበቴ ህንቤክቱ፤","poem":1},{"text":"ጉርኬ ዱሩማ ጀልቀቤ ህንበነምኔ።","poem":2},{"text":"አን አከ አት ምጪረማ ታቴ ቤከ፤","poem":1},{"text":"አት ዸሎተኬቲ ጀልቀብዴ ፍንጭላ ጄዸምቴ ዋመምቴ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አን መቃኮቲፍ ጄዼ ዼከምሰኮ ነንቱርሲሰ፤","poem":1},{"text":"አን አከ ስ ህንበሌስኔፍ ገለተኮቲፍ ጄዼ","poem":2},{"lineBreak":true},{"text":"ዼከምሰኮ ዱበት ሀርክሰ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኩኖ፣ አን ዮ አከ ሜቲት ተኡ ባቴዩስ ቁልቁሌሴረ፤","poem":1},{"text":"እብደ ዽጵና ኬሰትስ ቆሬ ስ እላሌረ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አን ኦፊኮቲፍ ጄዼ፣ ኦፉመኮቲፍ ጄዼ ዋን ከነ ነንጎዸ።","poem":1},{"text":"መቃንኮ አከምት በዱ ደንደአ?","poem":2},{"lineBreak":true},{"text":"አን ኡልፍነኮ ደበርሴ ከን ብራቲፍ ህንኬኑ።","poem":2}]},{"type":"heading","content":["እስራኤል ብልሶምቴ"]},{"type":"verse","number":12,"content":[{"text":"“ያ ያቆብ፣ ያ እስራኤል ከን አን ስ ዋሜ፣","poem":1},{"text":"ነ ዸጌፈዹ፦","poem":2},{"text":"አን እሱመ፤ አን ከን ጀልቀባት፤","poem":1},{"text":"አን ከን ዹማት።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሀርክኮ ሁንዴወን ለፋ ዻቤ፤","poem":1},{"text":"ሀርክኮ ምርጋሞ ሰሚወን ድሪርሴ፤","poem":2},{"text":"ዮሙ አን እሳን ዋሙት፣","poem":1},{"text":"ሁንድሳኒ ወሊ ወጅን ዻበቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ሁንድኬሰን ወልት ቀበማቲ ዸጌፈዻ፤","poem":1},{"text":"ዋቆተ ቶልፈሞ ኬሳ ከምቱ ዱራን ዱርሴወንቶተ ከኔን ዱበቴ?","poem":2},{"text":"ምቹን ዋቀዮ ፍለተማን","poem":1},{"text":"ካዮ ዋቃ ባብሎንረት ፊጣን ባሰ፤","poem":2},{"lineBreak":true},{"text":"እሬንሳ ባብሎኖተት ከአ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አን፣ አን መታንኮ ዱበዼረ፤","poem":1},{"text":"ዹጉማን አን እሰ ዋሜረ።","poem":2},{"text":"አን እሰ ነንፍደ፤","poem":1},{"text":"እንስ ከራሳረት ንምልካአ።","poem":2}]},{"type":"verse","number":16,"content":["“ነት ዽኣዻቲ ዋን ከነ ዸገኣ፦",{"text":"“አን ጀልቀቡማ ካሴ ዾክሳት ህንዱበትኔ፤","poem":1},{"text":"ዬሮ ወን ሱን ተኤትስ አን አቹመን ቱሬ።”","poem":2},{"lineBreak":true},{"text":"አመስ ዋቀዮ ጎፍታኒፊ","poem":1},{"text":"ሀፉርሳ ነ ኤርገኒሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ዋቀዮ ፉሪንኬ፣","poem":1},{"text":"ቁልቁልች እስራኤል አከነ ጄዸ፦","poem":2},{"text":"“አን ዋቀዮ ዋቀኬ፣","poem":1},{"text":"ከን ዋን ሲፍ ቶሉ ስ በርሲሱ፣","poem":2},{"lineBreak":true},{"text":"ከን ከራ አት ዴሙ ቀብዱረ ስ ቀጄልቹዸ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"አት ኡቱ አጀጀኮ ቀልቤፈቴ ጅራቴ፣","poem":1},{"text":"ነጋንኬ አከ ለጋ፣","poem":2},{"lineBreak":true},{"text":"ቀጄሉማን ኬሞ አከ ዸኣ ገላና ተአ ቱሬ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሰኚንኬ አኩመ ጭረቻ፣","poem":1},{"text":"እጆሌንኬ አኩመ ብዮ ለፋ ባይአቱ ቱሬ፤","poem":2},{"text":"መቃንሳኒ ህንሀቀሙ፤","poem":1},{"text":"እሳንስ ፉለኮ ዱራ ህንዸበመን ቱሬ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ባብሎን ኬሳ በኣ፤","poem":1},{"text":"ባብሎኖተ ዱራ በቀዻ!","poem":2},{"text":"ዋን ከነ እየ ገመቹቲን ቤክስሳ፤ ለብሳስ።","poem":1},{"text":"ሀመ ሀንዳረ ለፋት ደበርሳ፤","poem":2},{"lineBreak":true},{"text":"“ዋቀዮ ገርብቸሳ ያቆብን ፉሬረ” ጄዻ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"እሳን ዮሙ እን ለፈ ገሞጂ ኬሰ እሳን ቀጄልቼትህንዼቦትኔ፤","poem":1},{"text":"እን ከታ ኬሳ ብሻን ቡርቅሲሴፍ፤","poem":2},{"text":"እን ከታ ዾሴ፣","poem":1},{"text":"ብሻንስ ሁምናን ጨብሴ በኤ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“ሀሞታፍ ነጋን ህንጅሩ” ጄዸ ዋቀዮ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/47.json","previousChapterAudioLinks":{},"numberOfVerses":22}