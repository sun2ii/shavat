{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":49,"content":[{"type":"heading","content":["ተጃጅላ ዋቀዮ"]},{"type":"verse","number":1,"content":[{"text":"ያ ብዮተ ብሻን ግዱ ነ ዸጌፈዻ፤","poem":1},{"text":"ያ ሰቦተ ፈጎ ጅራተን ዋን ከነ ዸገኣ፦","poem":2},{"text":"ኡቱ አን ህንዸለትን ዱረ ዋቀዮ ነ ዋሜ፤","poem":1},{"text":"ኡቱ አን ገደሜሰ ሃዸኮ ኬሰ ጅሩ መቃ ና ባሴ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እን አፋንኮ አከ ጎራዴ ቀረሜ ጎዼ፤","poem":1},{"text":"ጋድዱ ሀርከሳቲን ነ ዾክሴ፤","poem":2},{"text":"ጥየ ጩሉሉቅፈሜ ነ ጎዼ፣","poem":1},{"text":"መንኤ ጥየሳ ኬሰ ነ ካአቴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እንስ፣ “ያ እስራኤል፣ አት ገርብቸኮ","poem":1},{"text":"ከን አን ኡልፍነኮ እሰረት ሙልእሱዸ” አናን ጄዼ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አን ገሩ፣ “አከሱማነን እት ደዸቤ፤","poem":1},{"text":"ሁምነኮስ ዋኑመ ፋይዳ ህንቀብኔተን ፍጤ።","poem":2},{"text":"ተኡስ ዹጋንኮ ሀርከ ዋቀዮ፣","poem":1},{"text":"ገቲንኮስ ዋቀ ብረ ጅረ” ነንጄዼ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ዋን አን ፉለ ዋቀዮ ዱረት ኡልፍነ አርገዼ","poem":1},{"text":"ዋቅንኮ ጀብነ ና ተኤፍ፣","poem":2},{"text":"ዋቀዮ እን አከ አን ያቆብን ዴብሴ ገረሳት ፍዱፍ፣","poem":1},{"text":"እስራኤልን እሰ ብረት ወልት ቀቡፍ፣","poem":2},{"text":"አከ አን ገርብቸሳ ተኡፍ","poem":1},{"text":"ገደሜሰ ኬሰት ነ ቶልቼ ሱን አከነ ጄዸ፤","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እንስ፣ “አት ጎሶተ ያቆብ ዴብፍቴ ዻቡፍ፣","poem":1},{"text":"እስራኤሎተ አን ኤጌ ሰነስ ዴብፍቴ ፍዱፍ","poem":2},{"lineBreak":true},{"text":"ገርብቸኮ ተኡንኬ ሲፍ ባይኤ ሰልጳዸ።","poem":2},{"text":"አከ ፈይንኮ ቀርቀረ ለፋ ገኡፍ","poem":1},{"text":"አን ነሞተ ኦርማቲፍ እብሳ ስን ታስሰ” ጄዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ዋቀዮ ፉሪፊ ቁልቁልች እስራኤል፣","poem":1},{"text":"እሰ ነማን ቱፈተሜ ሰብንስ ጅቤ፣","poem":2},{"lineBreak":true},{"text":"ተጃጅላ ቡልችቶታ ሰናን አከነ ጄዸ፦","poem":2},{"text":"“ሰበቢ ዋቀዮ አመነማ","poem":1},{"text":"ቁልቁልቸ እስራኤል እሰ ስ ፍለቴ ሰናቲፍ","poem":2},{"text":"ጄዸኒ ሞቶትን ስ አርገኒ ኦል ከኡ፤","poem":1},{"text":"እልማን ሞቶታስ አርገኒ ሰገዱ።”","poem":2}]},{"type":"heading","content":["ዴብፈምቴ እጃረሙ እስራኤል"]},{"type":"verse","number":8,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“አን ዬሮ ፉዸተመ ቀቡት ሲፍን ዴብሰ፤","poem":1},{"text":"ጋፈ ፈይናትስ ስን ገርጋረ፤","poem":2},{"text":"አከ አት ዻለ አባ ህንቀብኔ","poem":1},{"text":"ዴብፍቴ ዻልችፍቱፍ፣","poem":2},{"text":"አን ስን ኤገ፤","poem":1},{"text":"አከ አት ሰባፍ ከኩ ታቱስ ስን ጎዸ፤","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አከ አት ወረ ቦጅአመኒን፣ ‘ኮታ በኣ’","poem":1},{"text":"ወረ ዱከነ ኬሰ ጅራተኒንሞ፣ ‘ብልሰ በኣ’ ጄቱ ስን ጎዸ።","poem":2},{"lineBreak":true},{"text":"“እሳን ከራረት ዋ ኛቱ፤","poem":1},{"text":"ጋረ ቁልቁላኣረትስ እዶ ቁበታ አርገቱ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እሳን ህንቤለአን፤ ህንዼቦተንስ፤","poem":1},{"text":"ሆእ ገሞጂ ዮካን አዱን እሳን ህንጉቡ።","poem":2},{"text":"እን እሳኒፍ ገራ ላፉ እሳን ጌጌሰ፤","poem":1},{"text":"ቀርቀረ ቡርቃ ብሻኒረ እሳን ቀጄልቸ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ቱሉወንኮ ሁንደ ከራት ነንጌደረ፤","poem":1},{"text":"ዳንዲወንኮ ጉርጉዳንስ ወል ቅጤፈሙ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኩኖ፣ እሳን ብየ ፈጎዻ ንዹፉ፤","poem":1},{"text":"ገሪን ካባ፣ ገሪን ዽኣ፣","poem":2},{"lineBreak":true},{"text":"ካንሞ ብየ አስዋኒቲ ንዹፉ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ያ ሰሚወን፣ እልልቻ፤","poem":1},{"text":"ያ ለፈ ገመድ፤","poem":2},{"lineBreak":true},{"text":"ያ ቱሉወን፣ ጉድሳ ፋርፈዻ!","poem":2},{"text":"ዋቀዮ ሰበሳ ንጀጀቤሰ፤","poem":1},{"text":"ወረ ረከተኒፍስ ገራ ንላፋቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ጥዮን ገሩ፣ “ዋቀዮ ነ ገቴረ፤","poem":1},{"text":"ጎፍታንስ ነ እራንፈቴረ” ጄቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“ሃት ዳእመሼ ከን ሆስፍቱ","poem":1},{"text":"እራንፈቹ ንደንዴሲ?","poem":2},{"text":"ሙጫ ዴሴፍስ ገራ ህንላፍቱ?","poem":1},{"text":"ዮ እሼን እራንፈቴዩ አን ስ ህንእራንፈዹ!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኩኖ፣ አን በሩ ሀርከኮረት ስ ቅርጤረ፤","poem":1},{"text":"ደላወንኬ ዬሮ ሁንደ ፉለኮ ዱረ ጅሩ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እልማንኬ አሪቲዻን ንደቸኡ፤","poem":1},{"text":"ወር ስ ዲገንስ ስራ በቀቱ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እጀኬ ኦል ፉዸዹቲ ናኖኬ እላል፤","poem":1},{"text":"እልማንኬ ሁንድ ወልት ቀበመኒ ገረኬ ንዹፉ።","poem":2},{"text":"አን ጅራታዻቲ” ጄዸ ዋቀዮ።","poem":1},{"text":"“አት እሳን ከኔን ሁንደ አከ ፋያት ንኡፈተ፤","poem":2},{"lineBreak":true},{"text":"አከ ምስሮትስ እቲን ሚዸግፈምተ።","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“አት ዲገምቴ ኦንቴ","poem":1},{"text":"ብይኬ በርበዳኡዩ","poem":2},{"text":"አመ ሰበኬት ለፍት ንዽጰተ፤","poem":1},{"text":"ወር ስ ልቅምሰን ስራ ንፈጋቱ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እጆሌን አት ዬሮ ገደኬቲት ዴሴ፣","poem":1},{"text":"ኡቱመ ጉርኬ ዸገኡ፣","poem":2},{"text":"‘ለፍት ኩን ኑት ዽጰቴረ፤","poem":1},{"text":"ለፈረ ጅራትኑ ኑፍ ኬን’ ሲን ጄዹ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ኤርገሲ አት ገራኬት አከነ ጄተ፤","poem":1},{"text":"‘ኤኙቱ ጀረ ከኔን ና ደኤ?","poem":2},{"text":"አን ገድቱፊ መሴንቱን ቱሬ፤","poem":1},{"text":"አን በቀቱፊ ጅበምቱን ቱሬ።","poem":2},{"lineBreak":true},{"text":"እሳን ከኔን ኤኙቱ ጉድሴ?","poem":2},{"text":"አን ኮጳት ሀፌን ቱሬ፤","poem":1},{"text":"ዮስ፣ እሳን ኩኔን ኤሳ ዹፈንሬ?’ ”","poem":2}]},{"type":"verse","number":22,"content":["ዋቀዮ ጎፍታን አከነ ጄዸ፦",{"text":"“ኩኖ አን ነሞተ ኦርማ ሀርካን ነንዋመ፤","poem":1},{"text":"ፋጂኮስ ኡመታፍ ኦል ነንቀበ፤","poem":2},{"text":"እሳን እልማንኬ ሀመተኒ ፍዱ፤","poem":1},{"text":"እንተለን ኬሞ ገቲቲሳኒት ባቱ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ሞቶትን አቦቲኬ ከኔን ስ ጉድሰን፣","poem":1},{"text":"ኒቶትንሳኒሞ ሃዾተኬ ከኔን ሀርመ ስ ሆስሰን ንተኡ።","poem":2},{"text":"እሳን አደሳኒቲን ለፈት ጎምብፈመኒ ሲፍ ሰገዱ፤","poem":1},{"text":"አዋረ ሚለኬቲሌ ንአራቡ።","poem":2},{"text":"ኤርገሲ አት አከ አን ዋቀዮ ተኤ ንቤክተ፤","poem":1},{"text":"ወር ነ አብደተን ህንሰልጰተን።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ጎቶተ ሀርካ ቦጁ ፉዸቹን፣","poem":1},{"text":"ገረ ጀቤዪ ሀርካስ ቦጁ ባሱን ንደንደአማ?","poem":2}]},{"type":"verse","number":25,"content":["ዋቀዮ ገሩ አከነ ጄዸ፦",{"text":"“ኤዬ፣ ጎቶተ ሀርካ ቦጅአምቶትን ንባፈሙ፤","poem":1},{"text":"ገረ ጀቤዪ ሀርካስ ቦጁን ንፉዸተመ፤","poem":2},{"text":"ወረ ሲን ፈልመኒን ነንፈልመ፤","poem":1},{"text":"እጆሌኬስ ነንበራረ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"አን አከ ወር ስ ሀጩጨን ፎን ኦፊሳኒ ኛተን ነንጎዸ፤","poem":1},{"text":"እሳን አኩመ ነመ ዳዺ ወይኒቲን መቻኡዺገ ኦፊሳኒቲን ንመቻኡ።","poem":2},{"text":"ኤርገሲ ሰኚን ነማ ሁንድ፣","poem":1},{"text":"አከ አን ዋቀዮ፣ ፈይሳንኬ፣","poem":2},{"lineBreak":true},{"text":"ፉሪንኬ፣ ጀባ ያቆብ ተኤ ንቤከ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/48.json","previousChapterAudioLinks":{},"numberOfVerses":26}