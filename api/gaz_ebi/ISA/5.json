{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":5,"content":[{"type":"heading","content":["ፋርፈትና እዶ ዻበ ወይኒ"]},{"type":"verse","number":1,"content":[{"text":"አን ነመን ጃለዹ ሰናፍ፣","poem":1},{"text":"ፋርፈትና ዋኤ እዶ ዻባ ወይኒሳ ነንፋርፈዸ፦","poem":2},{"text":"ምቹንኮ ጋረ ገበታራ","poem":1},{"text":"እዶ ዻባ ወይኒ ቀበ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እንስ ለፈ ሰነ ቆቴ እሰራ ዸጋ በሌሴ","poem":1},{"text":"ወይኒ ፍለተማ እሰረ ዻቤ።","poem":2},{"text":"ቆጢ ኤጉምሳ እሰ ኬሰት እጃሬ","poem":1},{"text":"ቦለ ወይኒ እት ጩንፈንሌ ቆቴ።","poem":2},{"text":"ኤርገሲ አከ ለፍት ቆቲሳ ሱን እጀ ጋሪ ኬኑ ኤገቴ፤","poem":1},{"text":"እን ገሩ እጀ ሀማ ቆፈ ኬኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“ያ ጅራቶተ ዬሩሳሌሚፊ ሰበ ይሁዳ፣","poem":1},{"text":"ሜ ዱቢ አናፊ እዶ ዻባ ወይኒኮግዱ ጅሩፍ ሙርቲ ኬና።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዋን አን ጎዼፍ ከነ ጫላ","poem":1},{"text":"ወን እዶ ዻባ ወይኒኮቲፍ ጎዸሙ መሉ ማል?","poem":2},{"text":"ዬሮ አን እጀ ወይኒ ጋሪ በርባዴት","poem":1},{"text":"እን ማሊፍ እጀ ሀዻኣ ቆፈ ነቀቴ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አን አመ ዋነን እዶ ዻባ ወይኒኮ ጎቹፍ ጅሩ","poem":1},{"text":"እስንት ነንህመ፤","poem":2},{"text":"አን ደላሳ ነንዲገ፤","poem":1},{"text":"እንስ ንበደ፤","poem":2},{"text":"ደላሳ ዸጋ ነንጅግሰ፤","poem":1},{"text":"እንስ ገድ ዽዺተመ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አን እሰ ነንኦንሰ፤","poem":1},{"text":"ሙክን ወይኒሳስ ህንቆረሙ ዮካን ለፍትሳ ህንቆተሙ።","poem":2},{"text":"ሶኮሩፊ ቆራቲን አች ኬሰት ጉደተ።","poem":1},{"text":"አን አከ ቦካን እት ህንሮብኔፍ ዱሜሰ ነንአጀጀ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"እዶን ዻባ ወይኒ","poem":1},{"text":"ዋቀዮ ዋን ሁንደ ደንደኡ መነ እስራኤል፤","poem":2},{"text":"ነሞትን ይሁዳሞ","poem":1},{"text":"እዶ ብቅልቱ እን እት ገመዱዸ።","poem":2},{"text":"እን ሙርቲ ቀጄላ በርባዴ፤","poem":1},{"text":"ገሩ ዺገ ዸንገላፈሙ አርጌ፤","poem":2},{"text":"ቀጄሉማ በርባዴ፤","poem":1},{"text":"ገሩ እየ ወረ ሚዸሜ ዸገኤ።","poem":2}]},{"type":"heading","content":["ወዮፊ ሙርቲ"]},{"type":"verse","number":8,"content":[{"text":"እስን ወረ ሀመ እዶን","poem":1},{"text":"ቶኮዩ ህንሀፍኔት መነረት መነ፣","poem":2},{"text":"ለፈ ቆቲሳረት ለፈ ቆቲሳ ደበለተኒ","poem":1},{"text":"ኮጱመኬሰን ብየ ኬሰ ጅራተኒፍ ወዮ!","poem":2}]},{"type":"verse","number":9,"content":["ዋቀዮ ዋን ሁንደ ደንደኡ ኡቱመ አን ዸገኡ አከነ ጄዼ ዱበቴ፦",{"text":"“ዹጉማን መኔን ሄዱን ንኦኑ፤","poem":1},{"text":"መኔን ጉርጉዳኒፊ በበሬዶን ነመ ኬሰ ጅራቱ ዸቡ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እዶ ዻባ ወይኒ ጭምዲ ኩዸንራ ዳዺ ወይኒባዶሲ ቶኮ ቆፈቱ ገልፈመ፤","poem":1},{"text":"ሰኚ ቆሮሲ ቶኮራ ምዻን ኢፊ ቶኮ ቆፈቱ ገልፈመ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ወረ ዹጋቲ በርባቻፍ ገነማን ከአን፣","poem":1},{"text":"ከኔን ሀመ ዳዺ ወይኒቲን መቻአንት","poem":2},{"lineBreak":true},{"text":"ሀልከን ዼሬፈተኒፍ ወዮ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እሳን ጭዸሳኒረት በገና፣ ክራራፊ ድቤ፣","poem":1},{"text":"ኡሉሌፊ ዳዺ ወይኒ ቀቡ፤","poem":2},{"text":"ገሩ ሆጂ ዋቀዮቲፍ ዽመ ህንቀበን፤","poem":1},{"text":"ሆጂ ሀርከሳቲፍስ ኡልፍነ ህንኬነን።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ከናፉ ሰብንኮ","poem":1},{"text":"ሰበቢ ሁበትና ዸቤፍ ቦጅአመ፤","poem":2},{"text":"ነሞትንሳኒ ቤቤከሞን ቤላን፣","poem":1},{"text":"ኡመትንሳኒስ ዼቡዻን ዹሙ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ከናፉ ሲኦል ገራሳ በልእፈቴ","poem":1},{"text":"አፋን ኦፊሳሌ ሀመ መሌ በነተ፤","poem":2},{"text":"ነሞትንሳኒ ቤቤከሞኒፊ ኡመትንሳኒ","poem":1},{"text":"ወር ወጨኒፊ ወር ገመደን ሁንድስ አች ኬሰ ቡኡ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ከናፉ ነምን ገድ ቀበመ፤","poem":1},{"text":"እልማን ነማ ገድ ዴብፈሙ፤","poem":2},{"lineBreak":true},{"text":"እጅ ኦፍ ቱልቶታስ ለፈ እላለ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዋቀዮ ዋን ሁንደ ደንደኡ ገሩ","poem":1},{"text":"ሙርቲ ቀጄላ ኦፊሳቲን ኦል ኦል ጄዸ፤","poem":2},{"text":"ዋቅን ቁልቁሉን ቀጄሉማ ኦፊሳቲን","poem":1},{"text":"አከ ቁልቁሉ ተኤ ኦፍ አርግሲሰ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዬሮ ሰነት ሆሎትን አኩመ ዋንለፈ ዼደሳኒ ኬሰ ጅረኒት ንዼዱ፤","poem":1},{"text":"ጦባላወን ሆላስ እዶ ሶሬዪን እት በርበዳአን ኬሰ ዼዱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ወረ ፉኞ ጎዎምሳቲን ጩቡ፣","poem":1},{"text":"ፉኞ ጋሪቲንስ ሀምነ ሀርክሰን፣","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ከኔን፣ “ዋቅን ሃአሪፈቱ፤","poem":1},{"text":"አከ ኑ አርግኑፍ እን ሆጂ ኦፊሳ ሃሰፍሲሱ፣","poem":2},{"text":"ወን ኩን ሃዽኣቱ፤","poem":1},{"text":"አከ ኑ ቤክኑፍስ","poem":2},{"lineBreak":true},{"text":"ከሮር ቁልቁልቸ እስራኤል ሃዹፉ”ጄዸኒፍ ወዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ወረ ሀማዻን ጋሪ፣","poem":1},{"text":"ጋሪዻንሞ ሀማ ጄዸኒፍ፣","poem":2},{"text":"ከኔን እፋን ዱከነ፣","poem":1},{"text":"ዱከናንሞ እፈ ጄዸኒፍ፣","poem":2},{"text":"ወረ ምኣዋዻን ሀዻኣ፣","poem":1},{"text":"ሀዻኣዻንሞ ምኣዋ ጄዸኒፍ ወዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ወረ አከ ያደሳኒት ኦጌዪ፣","poem":1},{"text":"አከ እላልቸሳኒትሞ አብሻለ ኦፍ ሴአኒፍ ወዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ወረ ዳዺ ወይኒ ዹጉት ጀባ፣","poem":1},{"text":"ዹጋቲ ወልት መኩትስ ጎተ ተአኒፍ፣","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ወረ መተኣ ፉዸተኒ የከማ ገድ ለክሰኒፍ፣","poem":1},{"text":"ሙርቲ ነመ በሌሳ ህንቀብኔሞ ጀልእሰኒፍ ወዮ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ከናፉ አኩመ አረብን እብዳ ጭዲ ለፈራ አራቡ፣","poem":1},{"text":"አኩመ ኦካን እብዳን ጉበቴ በዱ ሰነ ህድሳኒ ንቶርቶረ፤","poem":2},{"lineBreak":true},{"text":"ደራራንሳኒስ አኩመ አዋራ ብትናኤ በደ፤","poem":2},{"text":"እሳን ሴረ ዋቀዮ ዋን ሁንደ ደንደኡ ድደኒ","poem":1},{"text":"ዱቢ ቁልቁልቸ እስራኤል ቱፈተኒሩቲ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ከናፉ ዼከምስ ዋቀዮ ሰበሳት ንቦበአ፤","poem":1},{"text":"ሀርክሳ ኦል ከኤ እሳን ሩኩተ።","poem":2},{"text":"ቱሉወን ንራፈሙ፤","poem":1},{"text":"ሬፍሳኒስ አኩመ ኮሲ ዳንዲረት ገተሜ ተአ።","poem":2},{"lineBreak":true},{"text":"ከነ ሁንዳንሌ ዼከምስሳ ህንቀበኖፍኔ፤","poem":1},{"text":"ሀርክሳስ አኩመ ኦል ካፈሜት ጅረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"እን ሰቦተ ፈጎ ጅረኒፍ ፋጂ ኦል ቀበ፤","poem":1},{"text":"ወረ ሞጋ ለፋ ጅረንት ንሲቅሰ።","poem":2},{"lineBreak":true},{"text":"እሳንስ ኩኖ አሪፈተኒ ደፈኒ ዹፉ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"እሳን ኬሳ ነምን ቶኮዩ ህንደዸቡ ዮካን ህንጉፈቱ፤","poem":1},{"text":"ነምን ቶኮዩ ህንሙጉ ዮካን ህንረፉ፤","poem":2},{"text":"ሰበትን ሙዺሳኒ ህንላፉ፤","poem":1},{"text":"ህዻን ኮጴሳኒስ ህንጭቱ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ጥይሳኒ ቀረማዸ፤","poem":1},{"text":"እዳንሳኒ ሁንድ ቆጴፈሜረ፤","poem":2},{"text":"ኮቴን ፈርዴንሳኒ አኩመ ዸጋ ቀረ ቀቡት፤","poem":1},{"text":"ጎማን ጋሪሳኒስ አኩመ ቡቤ ሀማት።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ኣዱንሳኒ አኩመ ኣዱ ሌንጫት፤","poem":1},{"text":"እሳን አኩመ ሳፌለ ሌንጫ ኣዱ፤","poem":2},{"text":"ዬሮ ዋን አደምሰተን ቀበተንት ንጉሩርኡ፤","poem":1},{"text":"እሳን ዋን ቀበተን ፉዸተኒ ዴሙ፤","poem":2},{"lineBreak":true},{"text":"ነምን እሳን ሀርካ ቡሱ ደንደኡስ ህንጅሩ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ጋፈስ እሳን አኩመ ሁርሳ ገላና","poem":1},{"text":"ዋን ሰነራ ሁርሱ።","poem":2},{"text":"ነምን ቶኮ ዮ ብየ ሰነ እላሌ፣","poem":1},{"text":"እን ዱከናፊ ረክነ አርገ፤","poem":2},{"lineBreak":true},{"text":"አዱንስ ዱሜሳን ዱከኔፈመ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/4.json","previousChapterAudioLinks":{},"numberOfVerses":30}