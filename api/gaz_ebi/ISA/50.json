{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":50,"content":[{"type":"heading","content":["ጩቡ እስራኤሊፊ አጀጀሙ ተጃጅልትቻ"]},{"type":"verse","number":1,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“ወረቃን ረጋ፣ ከን አን እቲን ሃዸኬሰን ሂኬ","poem":1},{"text":"ኦፍራ እቲን እሼ ጌጌሴ ሜሬ?","poem":2},{"text":"ዮካን ነምን ልቂ ነራ ቀቡ","poem":1},{"text":"ከን አን እት እስን ጉርጉሬ ኤኙ?","poem":2},{"text":"እስን ሰበቢ ጩቡኬሰኒፍ ጉርጉረምተኒርቱ፤","poem":1},{"text":"ሰበቢ የከኬሰኒቲፍስ ሃትኬሰን አርአምቴርት።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዬሮ አን ዹፌት ነምን ማሊፍ አች ህንጅራትን?","poem":1},{"text":"ዬሮ አን ዋሜት ነምን ኦዋቱ ማሊፍ አቺ ዸበሜ?","poem":2},{"text":"ሀርክኮ አከ ፉሩ ህንደንዴኜፍ ገባበቴራ?","poem":1},{"text":"አን እስን በራሩፍ ሁምነ ዸቤራ?","poem":2},{"text":"አን ዼከምሰ ቆፋን ገላነ ነንጎግሰ፤","poem":1},{"text":"ለጌንስ ገሞጂት ነንጌደረ፤","poem":2},{"text":"ቁርጡሚወንሳኒ ብሻን ዸበኒ አጃኡ፤","poem":1},{"text":"ዼቡዻንስ ንዹሙ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አን ሰሚት ዱከነ ነንኡፍሰ፤","poem":1},{"text":"ወያ ገዳስ እት ነንሀጉገ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"አከ አን ወረ ደዸበን ጀጀቤሱፍ፣","poem":1},{"text":"ዋቀዮ ጎፍታን አረበ በረቴ ና ኬኔረ።","poem":2},{"text":"እን ገነመ ገነመ ነ ደመቅሰ፤","poem":1},{"text":"አከ እን አኩመ በረታ ቶኮት ዸጌፈቱፍስጉረኮ ደመቅሰ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዋቀዮ ጎፍታን ጉረኮ ና በኔረ፤","poem":1},{"text":"አንስ ፍንጭላ ህንቱሬ፤","poem":2},{"lineBreak":true},{"text":"አን ዱግደ ዱበት ህንዴብኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አን ወረ ነ ሩኩተንት ዱግደኮ፣","poem":1},{"text":"ወረ አሬደ ነራ ቡቅሰንትሞ መዲኮ ነንኬኔ፤","poem":2},{"text":"ዬሮ እሳን ነት ቆሰኒ ሀንጩፈ ነት ቱፈንት፣","poem":1},{"text":"አን ፉለኮ እሳን ህንዾክፈትኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሰበቢ ዋቀዮ ጎፍታን ነ ገርጋሩፍ፣","poem":1},{"text":"አን ህንሰልጵፈሙ።","poem":2},{"text":"ከናፉ አን ፉለኮ አኩመ ዸጋ ጉራቻ ጎዸዼረ፤","poem":1},{"text":"አን አከ ህንቃኔፈምኔሌ ነንቤከ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እን ዹጋ ናፍ ባሱ ዽኦ ጅረ።","poem":1},{"text":"ዮስ ኤኙቱ ነ ህመተሬ?","poem":2},{"lineBreak":true},{"text":"ሜ ወልት ገድ ሃባኑ!","poem":2},{"text":"ህመታንኮ ኤኙ?","poem":1},{"text":"እን ሜ ነት ገድ ሃበኡ!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዋቀዮ ጎፍታቱ ነ ገርጋረ።","poem":1},{"text":"ኤኙቱ ነት ሙረ?","poem":2},{"text":"እሳን ሁንድ አኩመ ወያ ሞፈኡ፤","poem":1},{"text":"ዾልዾሌንስ እሳን ኛት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"እስን ኬሳ ከን ዋቀዮን ሶዳቴ","poem":1},{"text":"ዱቢ ገርብቸሳቲፍ አጀጀሙ ኤኙ?","poem":2},{"text":"ነምን ዱከነ ኬሰ ዴዴብኡ፣","poem":1},{"text":"ከን እፈ ህንቀብኔ፣","poem":2},{"text":"መቃ ዋቀዮ አመነቴ","poem":1},{"text":"ዋቀሳት ሃእርከቱ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አመ ገሩ እስን ወር እብደ ቦቤስተኒ","poem":1},{"text":"ጉጨ ቦበኣ ዴሙ ቀበተን ሁንድኑ","poem":2},{"text":"እፈ እብዳኬሰኒቲፊ እፈ ጉጨ","poem":1},{"text":"ቦቤስተኒ ኬሰ ዴማ።","poem":2},{"text":"ወን እስን ሀርከኮራ አርገተን ከናዸ፤","poem":1},{"text":"እስን ዽጵናን ንጭጪፍቱ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":11}