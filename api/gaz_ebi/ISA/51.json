{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":51,"content":[{"type":"heading","content":["ፈይነ በረ በራ ጥዮኒፍ"]},{"type":"verse","number":1,"content":[{"text":"“እስን ወር ቀጄሉማ ዱካ ቡተን፣","poem":1},{"text":"ወር ዋቀዮን በርባደን ነ ዸጌፈዻ፦","poem":2},{"text":"እስን ከታራ አርገምተን፣","poem":1},{"text":"ቦለ ኬሳ ባፈምተን ሰነ እላላ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አባኬሰን አብረሃሚፊ","poem":1},{"text":"ሳራ እሼ እስን ዴሴ ሰነ እላላ።","poem":2},{"text":"ዬሮ አን እሰ ዋሜት፣ እን ቶክቸ ቱሬ፤","poem":1},{"text":"አን እሰ ነንኤብሴ፤ ነንባይእሴስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዋቀዮ ዹጉማን ጥዮንን ንጀጀቤሰ፤","poem":1},{"text":"ዲገመሼ ሁንደስ ገረ ላፍናን ንእላለ፤","poem":2},{"text":"እን ገሞጂሼ ጎጎጋ አከ ኤዴን፣","poem":1},{"text":"ለፈ ኦናሼስ አከ እዶ ብቅልቱ ዋቀዮ ንጎዸ።","poem":2},{"text":"እልልቹፊ ገመዱን፣","poem":1},{"text":"ገለትኒፊ ሰገሌን ፋርፈትናሼ ኬሰት አርገመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“ያ ኡመተኮ ነ ዸጌፈዻ፤","poem":1},{"text":"ያ ሰበኮ ነ ዸገኣ፤","poem":2},{"text":"ሴር ነ ብራ በአ፤","poem":1},{"text":"ሙርቲንኮስ ሰቦታፍ እፈ ተአ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ቀጄሉማንኮ ደፌ ዽኣተ፤","poem":1},{"text":"ፈይሱንኮስ ዹፋ ጅረ፤","poem":2},{"lineBreak":true},{"text":"እሬንኮ ሞቶታፍ ሙርቲ ቀጄላ ፍደ፤","poem":2},{"text":"ብዮትን ብሻን ግዱ ነ ኤገቱ፤","poem":1},{"text":"እሬኮስ ንአብደቱ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እጀኬሰን ገረ ሰሚወኒት ኦል ቀበዻ፤","poem":1},{"text":"ለፈስ ገድ እላላ፤","poem":2},{"text":"ሰሚወን አኩመ ኣራ ንበዱ፤","poem":1},{"text":"ለፍት አኩመ ወያ ሞፎፍት።","poem":2},{"lineBreak":true},{"text":"ጅራቶትንሼስ አኩመ ትሲሳ ንዱአን።","poem":2},{"text":"ፈይሱንኮ ገሩ በረ በራን ጅራተ፤","poem":1},{"text":"ቀጄሉማንኮስ ህንበዱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“እስን ወር ዋን ቀጄላ ቤክተን","poem":1},{"text":"ነሞትን ሴረኮ ገራ ኬሳ ቀብደን ነ ዸገኣ፤","poem":2},{"text":"ቱፊ ነሞታ ህንሶዳትና፤","poem":1},{"text":"ዮካን አረብሶሳኒቲን ህንራፈምና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ብሊን አከ ወያት እሳን ኛት፤","poem":1},{"text":"ራሞንስ አኩመ ርፌንሰ ሆላት እሳን ፍጥ።","poem":2},{"text":"ገሩ ቀጄሉማንኮ በረ በራን፣","poem":1},{"text":"ፈይሱንኮስ ዸሎታ ገረ ዸሎታት እት ፉፈ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ያ እሬ ዋቀዮ፣ ከእ፤ ከእ! ጀብነ ኡፈዹ፤","poem":1},{"text":"አኩመ በሮተ ደርበኒ፣","poem":2},{"lineBreak":true},{"text":"አኩመ ዸሎተ ዱሪ ኬሰት ተኤ ሰነ ከእ።","poem":2},{"text":"ከን ረኣብን ኩኩቴ፣","poem":1},{"text":"ከን ጀዌ ገላና ወራኔ ሱን ሱመ ምቲ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እን አከ ወር ፉረመን ጬአኒፍ፣ ገላንቸ፣","poem":1},{"text":"ብሻን ቱጁበ ጉድቻ ጎግሴ፣","poem":2},{"lineBreak":true},{"text":"ከን ዽዽመ ገላና ኬሳን ከራ ባሴ ሱመ ምቲ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ወር ዋቀዮ እሳን ፉሬ ንዴብኡ።","poem":1},{"text":"እሳን ፋርፈናዻን ጥዮን ሴኑ፤","poem":2},{"lineBreak":true},{"text":"ገመቹን በረ በራ መታሳኒረ ጅራተ።","poem":2},{"text":"እሳን ገመቹፊ እልሌዻን ጉተሙ፤","poem":1},{"text":"ገዲፊ ቦእች እሳንራ ፈጋቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ከን እስን ጀጀቤሱ አነ፤ አኑመ።","poem":1},{"text":"ዮስ ማሊፍ ነሞተ ዱአ ህንኦሌ፣","poem":2},{"lineBreak":true},{"text":"እልማን ነማ ከኔን አኩመ መርጋ ተአን ሶዳቱሬ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አት ከን ዋቀዮ ቶልቻኬ፣","poem":1},{"text":"እሰ ሰሚወን ድሪርሴ","poem":2},{"lineBreak":true},{"text":"ሁንዴ ለፋ ቡሴ ሰነ ደገቱ ኤኙ?","poem":2},{"text":"አት ከን ሰበቢ ዼከምሰ ጩንቁርሳ","poem":1},{"text":"ዋ በሌሱፍ ቆጳኤ ሰናቲፍ","poem":2},{"lineBreak":true},{"text":"ኡቱ ገርገር ህንኩትን ጉያ ጉያን ሶዳቱ ኤኙ?","poem":2},{"text":"ዮስ ዼከምስ ጩንቁርሳ ሰና ሜሬ?","poem":1}]},{"type":"verse","number":14,"content":[{"text":"ቦጅአምቶትን ህዸመን አሪቲዻን ገድ ዺፈሙ፤","poem":2},{"text":"እሳን ቦለ እት ህዸመን ኬሰት ህንዱአን","poem":1},{"text":"ዮካን ቡዴነ ህንዸበን።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አን ዋቀዮ ዋቀኬ፣","poem":1},{"text":"ከን አከ ዸኣን ብሻኒ ሁርሱፍ ገላነ ራሱዸ፤","poem":2},{"lineBreak":true},{"text":"መቃንሳስ ዋቀዮ ዋን ሁንደ ደንደኡዸ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አን ከን ሰሚወን እዶሳኒ ካኤ፣","poem":1},{"text":"ከን ሁንዴ ለፋ ሁንዴሴ","poem":2},{"text":"ጥዮኒን፣ ‘አት ሰበኮት’ ጄዼ ሱን፣","poem":1},{"text":"ዱቢኮ አፋንኬ ኬሰ ካኤረ፤","poem":2},{"lineBreak":true},{"text":"ጋድዱ ሀርከኮቲንስ ስ ሀጉጌረ።”","poem":2}]},{"type":"heading","content":["ጦፎ ዼከምሰ ዋቀዮ"]},{"type":"verse","number":17,"content":[{"text":"ያ ዬሩሳሌም፣ አት ከን ሀርከ ዋቀዮራ፣","poem":1},{"text":"ጦፎ ዼከምሰሳ ኬሳ ዹግዴ፣","poem":2},{"lineBreak":true},{"text":"አት ከን ጦፎ ዹጋቲ ነመ ገተንተርሱ ኬሳ","poem":2},{"text":"ሲጮሳ ጡሩርፈቴ ዹግዴ፣","poem":1},{"text":"ደመቅ፣ ደመቅ! ኦል ከእ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እልማን እሼን ዴሴ ሁንደ ኬሳ፣","poem":1},{"text":"ከን እሼ ቀጄልቹ ቶኮዩ ህንቱሬ፤","poem":2},{"text":"እልማን እሼን ጉድፍቴ ሁንደ ኬሳስ፣","poem":1},{"text":"ከን ሀርከሼ ቀቡ ቶኮዩ ህንቱሬ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"በላወን ኩኔን ደቻዻን ስት ዹፈኒሩ፤","poem":1},{"text":"ኤጋ ኤኙቱ ስ ጀጀቤሱ ደንደአ?","poem":2},{"text":"ዲገምኒፊ በዲስን፣ ቤሊፊ ጎራዴን ስት ዹፈኒሩ፤","poem":1},{"text":"ኤጋ ኤኙቱ ስ ጀጀቤሱ ደንደአ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እጆሌንኬ ገገበኒሩ፤","poem":1},{"text":"አኩመ ቦሮፈ ክዮን ቀበሜ ቶኮ፣","poem":2},{"lineBreak":true},{"text":"ሮገ ከራረ ጭጪሱ።","poem":2},{"text":"እሳን ዼከምሰ ዋቀዮቲን፣","poem":1},{"text":"እፈተ ዋቀኬቲንስ ጉተመኒሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ከናፉ ያ እሼ ሚዸምቴ፣","poem":1},{"text":"ከን ኡቱ ዳዺ ወይኒ ህንዹግን መቾፍቴ፣ዋን ከነ ዸገእ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዋቀዮ ጎፍታንኬ፣","poem":1},{"text":"ዋቅንኬ እን ሰበሳ ኤጉ አከነ ጄዸ፦","poem":2},{"text":"“ኩኖ አን ጦፎ ዹጋቲ ነመ ገተንተርሱ","poem":1},{"text":"ሀርከኬቲ ፉዼረ፤","poem":2},{"text":"አት ስአች ጦፎ ዼከምሰኮ","poem":1},{"text":"ኬሳ ዴብቴ ህንዹግዱ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"አንስ ጦፎ ሰነ ሀርከ ወረ ስ ዽጵሰን","poem":1},{"text":"ከኔን፣ ‘አከ ኑ ስረ ያኑፍ፣ ለፈረ ድሪርፈም’","poem":2},{"lineBreak":true},{"text":"ሲን ጄዸን ሰና ኬሰ ነንካአ።","poem":2},{"text":"አትሞ ዱግደኬ አኩመ ለፋ፣","poem":1},{"text":"አኩመ ዳንዲ ነምንረ ዴሙ ጎቴ።”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":23}