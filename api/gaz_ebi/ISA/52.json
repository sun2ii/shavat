{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":52,"content":[{"type":"verse","number":1,"content":[{"text":"ያ ጥዮን፣ ደመቅ፣ ደመቅ፤","poem":1},{"text":"ጀብነኬ ኡፈዹ!","poem":2},{"text":"ያ ዬሩሳሌም፣ ያ መጋላ ቁልቁልቲ፣","poem":1},{"text":"ወያኬ ሚዸጋ ሰነ ኡፈዹ።","poem":2},{"text":"ነሞትን ዸግነ ህንቀበምኒፊ","poem":1},{"text":"ጡራኦን ለመፋ ስት ህንሴነን።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ያ ዬሩሳሌም፣ አዋረ ኦፍራ ዸዸአዹ፤","poem":1},{"text":"ከኢቲ ቴሶረ ታእ።","poem":2},{"text":"ያ እንተለ ጥዮን ቦጅአምትቲ፣","poem":1},{"text":"ፎንጫ ሞርመኬቲ ኦፍራ ሂክ።","poem":2}]},{"type":"verse","number":3,"content":["ዋቀዮ አከነ ጄዻቲ፦",{"text":"“እስን ገቲ መሌ ጉርጉረምተኒ ቱርተን፤","poem":1},{"text":"አመሞ ማለቀ መሌ ፉረምተን።”","poem":2}]},{"type":"verse","number":4,"content":["ዋቀዮ ጎፍታን አከነ ጄዻቲ፦",{"text":"“ጀልቀበት ሰብንኮ ጅራቹፍ ጄዼ ግብጥት ገድ ቡኤ፤","poem":1},{"text":"ኤርገሲ አሶር ሰበቢ መሌ እሳን ጩንቁርሴ።","poem":2}]},{"type":"verse","number":5,"content":["“ዮስ አን አመ ማለን አሲ ቀበ?” ጄዸ ዋቀዮ።",{"text":"“ሰብንኮ ሰበቢ መሌ ፉዸተሜረ፤","poem":1},{"text":"ወር እሳን ቡልቸንስ ንቆሱ” ጄዸ ዋቀዮ።","poem":2},{"text":"“ጉያ ጉቱስ፣","poem":1},{"text":"መቃንኮ እቱመ ፉፌ አረብሰመ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ከናፉ ሰብንኮ መቃኮ ንቤከ፤","poem":1},{"text":"ከናፉ እሳን ጋፈስ ከን ዱራን ዱርሴ ዋን ሰነ ዱበቴ","poem":2},{"text":"አከ አነ ተኤ ንቤኩ።","poem":1},{"text":"ኤዬ፣ እን አኑመ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ሚል ወረ ወንጌለ ፍደኒ፣","poem":1},{"text":"ከን ነጋ ለብሰኒ፣","poem":2},{"text":"ከን ኦዱ ገመቺሳ ፍደኒ፣","poem":1},{"text":"ከን ፈይነ ለብሰኒ፣ ከን ጥዮኒን፣","poem":2},{"text":"“ዋቅንኬ ሞኤረ!” ጄዸኒ","poem":1},{"text":"ቱሉወንረት አከም ሚዸጋዸ!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዸጌፈዹ! ኤግዶንኬ ሰገሌሳኒ ኦል ፉዸተኒሩ፤","poem":1},{"text":"እሳን ቶኩማዻን ገመቹዻን እዩ።","poem":2},{"text":"ዬሮ ዋቀዮ ጥዮንት ዴብኡት፣","poem":1},{"text":"እሳን እጁመሳኒቲን ንአርጉ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ያ ዲገምቶተ ዬሩሳሌም","poem":1},{"text":"ቶኩማዻን ፋርፈትና ገመቹ ፋርፈዻ፤","poem":2},{"text":"ዋቀዮ ኡመተሳ ጀጀቤሴ","poem":1},{"text":"ዬሩሳሌምንስ ፉሬራ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዋቀዮ ፉለ ሰቦተ ሁንዳ ዱረት፣","poem":1},{"text":"እሬሳ ቁልቁሉ ሰነ ንሙልእሰ፤","poem":2},{"text":"ሀንዳር ለፋ ሁንድስ","poem":1},{"text":"ፈይሱ ዋቀኬኛ ንአርጉ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"እስን ወር ምአ ዋቀዮ ባተን፣ አዳን በኣ፤","poem":1},{"text":"አዳን በኣ፤ አቺ ፈጋዻ!","poem":2},{"text":"ዋን ጡራኣ ቶኮሌ ህንቱቅና!","poem":1},{"text":"እሼ ኬሳ በኣቲ ቁልቁሎተ ተአ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እስን ገሩ አሪቲዻን አቺ ህንባተን፤","poem":1},{"text":"ዮካን በቀተኒ ህንዴምተን፤","poem":2},{"text":"ዋቀዮ ፉለኬሰን ዱረ ዴማቲ፤","poem":1},{"text":"ዋቅን እስራኤል ዱግደ ዱባን እስን ኤገ።","poem":2}]},{"type":"heading","content":["ዽጵናፊ ኡልፍነ ገርብቸ ሰና"]},{"type":"verse","number":13,"content":[{"text":"ኩኖ፣ ገርብችኮ ኦጉማዻን ሆጄተ፤","poem":1},{"text":"እን ንከበጀመ፤ ኦል ካፈመ፤ ኡልፍነ ጉዳስ ንአርገተ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ነሞትን ባይኤን ዋኤሳ ሀመ ነአንት፣","poem":1},{"text":"ፉልሳ ነመ ሁንዱማ ጫላ ጎልጎላኤረ፤","poem":2},{"lineBreak":true},{"text":"ብፍትሳስ ነመ ሁንዱማ ጫላ በዴረ፤","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አከሲንስ እን ሰቦተ ሄዱ ድንቅሲፈቺሰ፤","poem":1},{"text":"ሞቶትን ሰበቢሳቲፍ አፋንሳኒ ቀበቱ።","poem":2},{"text":"እሳን ዋን እሳንት ህንህመምን አርጉቲ፤","poem":1},{"text":"ዋን ህንዸገእንስ ንሁበቱ።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}