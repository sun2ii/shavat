{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":[{"text":"ኤርጋኬኘ ኤኙቱ አመኔ?","poem":1},{"text":"እሬን ዋቀዮስ ኤኙት ሙልአቴ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እን ፉለሳ ዱረት አኩመ ብቅልቱ ክቹ፣","poem":1},{"text":"አኩመ ህደ ለፈ ጎጋ ኬሳ በኡ ቶኮት ጉደቴ።","poem":2},{"text":"አከ ኑ እሰ እላሉፍ፣ እን ብፈ ህንቶሉ፣ዮካን ስምቦ ህንቀቡ፤","poem":1},{"text":"አከ ኑ እሰ ሀውኑፍስ ሚዸግነ ህንቀቡ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እን ነመ ብረት ቱፈተሜ ጅበሜ፤","poem":1},{"text":"እን ነመ ገዳፊ ገደደሙን ጅራቱዸ።","poem":2},{"text":"አኩመ ነመ ነሞትን ፉለሳኒራ ገረገልፈተኒ፣","poem":1},{"text":"እን ንቱፈተሜ፤ ኑስ ኡልፍነ ህንኬንኔፍ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ዹጉማን እን ዹኩበኬኘ ፉዸቴ፤","poem":1},{"text":"ገደኬኘስ ባቴ፤","poem":2},{"text":"ኑ ገሩ አከ ዋን ዋቅን እሰ ዸኤት፣","poem":1},{"text":"አከ ዋን እን ሩኩቴ እሰ ሚዼት እሰ ሄድኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እን ገሩ ሰበቢ የከኬኛቲፍ ወራነሜ፤","poem":1},{"text":"በሌሳኬኛፍስ ጨጨብሰሜ፤","poem":2},{"text":"ኑ አደበሙሳቲን ነጋ አርገትኔ፤","poem":1},{"text":"መዳኡሳቲንሞ ፈይኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሁንድኬኘ አከ ሆላ","poem":1},{"text":"ከራራ በድኔ ቱሬ፤","poem":2},{"text":"ቶኮን ቶኮንኬኘ ገረ ከራኬኛት ጎሬ፤","poem":1},{"text":"ዋቀዮስ በሌሳ ሁንደኬኛ እሰረ ካኤ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"እን ንጩንቁርፈሜ፤ ንዽጰቴስ፤","poem":1},{"text":"ገሩ አፋንሳ ህንሳቀትኔ፤","poem":2},{"text":"እን አኩመ እልሞ ሆላ ከን እዶ ቀልማት ጌፈሙ፣","poem":1},{"text":"አኩመ ሆላ ፉለ ነመ ርፌንሰራ ሙርሙሩ ዱረት ጨልእሱ፣","poem":2},{"lineBreak":true},{"text":"አከሱመ አፋንሳ ህንሳቀትኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እን ጩንቁርሳፊ ሙርቲዻን ፉዸተሜ።","poem":1},{"text":"ኤኙቱ ዋኤ ዸሎተሳ ዱበቹ ደንደአ?","poem":2},{"text":"እን ብየ ጅራቶታራ ኩተሜራቲ፤","poem":1},{"text":"ዶጎጎረ ሰበኮቲፍስ ሩኩተሜረ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እን ጎሊ ካሱ ባቱዩ፣","poem":1},{"text":"ዮካን ሶብን አፋንሳቲ በኡ ባቱዩ","poem":2},{"text":"አከ አዋልሳ ሀሞተ ወጅን","poem":1},{"text":"ዱትሳስ ሶሬዪ ወጅን ተኡ ጎዸን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ተኡስ እሰ ድርመሜሱፊ እሰ ዽጵሱን ፌዺ ዋቀዮ ቱሬ፤","poem":1},{"text":"ዋቀዮ ሉቡሳ ኣርሳ የካ ጎዹዩ","poem":2},{"text":"እን ሰኚሳ ንአርገ፤ ኡሙሪሳስ ንዼሬሰ፤","poem":1},{"text":"ፌዺን ዋቀዮስ ሀርከሳት ንራወተመ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እን ኤርገ ሉቡንሳ ዽጰቴ ቦዴ፣","poem":1},{"text":"እፈ ንአርገ፤ ንገመደስ፤","poem":2},{"text":"ገርብችኮ ቀጄላን ሱን ቤኩምሰሳቲን ነሞተ ባይኤቀጄልቶተ ታስሰ፤","poem":1},{"text":"የከሳኒስ ንባተ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ከናፉ አን ጉርጉዶተ ግዱት ቆደ ነንኬናፍ፤","poem":1},{"text":"እንስ ጀጀቦተ ወጅን ቦጁ ንቆደተ፤","poem":2},{"text":"እን ሉቡሳ ዱኣፍ ኬኔ","poem":1},{"text":"የክቶተት ለካአሜራቲ።","poem":2},{"text":"ተኡስ እን ጩቡ ነመ ሄዱ ባቴ","poem":1},{"text":"የከምቶታፍ አራረ ቡሴረ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/52.json","previousChapterAudioLinks":{},"numberOfVerses":12}