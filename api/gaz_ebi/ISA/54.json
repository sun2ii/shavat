{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":54,"content":[{"type":"heading","content":["ኡልፍነ ኤጌሬ ጥዮን"]},{"type":"verse","number":1,"content":[{"text":"“ያ ዱበርቲ ዸብዱ፣","poem":1},{"text":"ከን ተኩማ ህንደእን፣ አመ ፋርፈዹ፤","poem":2},{"text":"አት ከን ተኩማ ጭኒንስፈቴ ህንቤክን እዪ ፋርፈዹ፤","poem":1},{"text":"ጉድሲቲ እልልች።","poem":2},{"text":"እጆሌ ዱበርቲ ዽርሰ ቀብዱ ጫላ","poem":1},{"text":"እጆሌን ዱበርቲ ገተምቴ ንባይአቱ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“እዶ ዱንካነኬቲ በልእፈዹ፤","poem":1},{"text":"ጎልጋ ዱንካነኬቲ በልእሲ ድሪርስ፤","poem":2},{"lineBreak":true},{"text":"ወልት ህንደቻስን፤","poem":2},{"text":"ፉኞኬ ዼሬፈዹ፤","poem":1},{"text":"ቆፎኬስ ጀቤፈዹ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አት ገረ ምርጋቲፊ ገረ ብታት ንበበልአታቲ፤","poem":1},{"text":"ሰኚወንኬ ሰቦተ ንዻሉ፤","poem":2},{"lineBreak":true},{"text":"መጋላወንሳኒ ከኔን ዱዋ ሀፈን ኬሰስ ንቁበቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“ህንሶዳትን፤ አት ህንቃኖፍቱቲ።","poem":1},{"text":"ህንያደእን፤ አት ህንሰልጰቱቲ፤","poem":2},{"text":"ቃኒ እጆሉማኬቲ ንደገተ፤","poem":1},{"text":"ቱፊ ዽርስኬ ስራ ዱናን ስረ ገኤስ ስአች ህንያደቱ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኡማንኬ ዽርሰኬት፤","poem":1},{"text":"መቃንሳስ ዋቀዮ ዋን ሁንደ ደንደኡዸ፤","poem":2},{"text":"ቁልቁልች እስራኤል ፉሪኬት፤","poem":1},{"text":"እንስ ዋቀ ጉቱማ ለፋ ጄዸመ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዋቀዮ አከ ዋን አት","poem":1},{"text":"አኩመ ኒቲ ገተምቴ ገራንሼ ገዴ፣","poem":2},{"text":"አከ ኒቲ ደርገጌሳ ከን ጅበምቴት","poem":1},{"text":"ዴብሴ ኦፍት ስ ዋመ” ጄዸ ዋቅንኬ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“አን ዬሮ ሙራሳፈን ስ ዺሴ፤","poem":1},{"text":"ገሩ ገረ ላፍነ ጉዳዻን ዴብሴ ስን ፍደ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አን ዼከምሰ ጉዳዻን","poem":1},{"text":"ዬሮ ሙራሳፍ ፉለኮ ስ ዾክፈዼን ቱሬ፤","poem":2},{"text":"ገሩ ጃለለ በረ በራቲን፣","poem":1},{"text":"ገራ ሲፍን ላፈ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ ፉሪንኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ወን ኩን አናፍ አኩመ በረ ኖህ፣","poem":1},{"text":"ዬሮ አን እት ብሻን ኖህ ዴብኤ ለፈረ ህንገረገሉ ጄዼከከዼ ሰናት።","poem":2},{"text":"ከናፉ አን አከን ስት ህንኣሬ፣","poem":1},{"text":"ጎንኩማስ ለመተ አከን ስ ህንእፈትኔ ከከዼረ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ቱሉወን ራፈመኒ፣","poem":1},{"text":"ጋረን ቡቅፈመንዩ፣","poem":2},{"text":"ጃለል ህንጌደረምኔ ከን አን ሲፍ ቀቡ ገሩ ህንራፈሙ፤","poem":1},{"text":"ዮካን ከኩንኮ ከን ነጋ ህንዲገሙ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ እን ገራ ሲፍ ላፉ ሱን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ያ መጋላ ሚዸምቴ ከን ደምበሊዻን ገረገልፈምቴነመ ስ ጀጀቤሱ ዸብዴ፣","poem":1},{"text":"አን ዸጋ ገቲ ጉዳቲን ስ እጃሬ","poem":2},{"lineBreak":true},{"text":"ሰንፔሪዻንስ ስ ሁንዴሰ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አን ፊጤኬ ሉለ ዲማዻን፣","poem":1},{"text":"ከረወንኬ ዶቀ ጨለቅሱን፣","poem":2},{"lineBreak":true},{"text":"ደላኬ ሁንደሞ ዸጋወን ገት ጀቤዪዻን ነንእጃረ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዋቀዮ እልማንኬ ሁንደ ንበርሲሰ፤","poem":1},{"text":"ነጋን እጆሌኬቲስ ጉዳ ተአ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አት ቀጄሉማዻን ሁንዴፈምተ፤","poem":1},{"lineBreak":true},{"text":"ጩንቁርፈሙን ስራ ፈጋተ፤","poem":1},{"text":"ወን ስ ሶዳችሱ ቶኮዩ ህንጅሩ።","poem":2},{"text":"ጎሊን ስራ ፈጌፈመ፤","poem":1},{"text":"ስትዩ ህንዽኣቱ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዮ ነምን ቶኮዩ ሎለ ስት ካሴ አን ኬሳ ህንቀቡ፤","poem":1},{"text":"ነምን ሎለ ስት ካሱ ከምዩ ሀርከ ስት ኬነተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“ኩኖ፣ ከን ቱምቱ ስቢላ ከን ጭሌ ቡፌ","poem":1},{"text":"እብደ ቦቤሴ ምአ ወራና ቱሜ","poem":2},{"lineBreak":true},{"text":"ሆጂሳቲፍ ምጄሱ ሰነ ኡሜ አኑመ።","poem":2},{"text":"ከን ነመ ዋ በሌሱ ቶኮ አከ እን በላ ቡሱፍ ኡሜስ አኑመ፤","poem":1}]},{"type":"verse","number":17,"content":[{"text":"ሜሻን ስ ሚዹፍ ቶልፈሜ ከምዩ ህንምልካኡ፤","poem":2},{"lineBreak":true},{"text":"አትስ አረበ ስ ህመቱ ሁንደ ኦፍራ ዴብፍተ።","poem":2},{"text":"ኩን ዻለ ተጃጅልቶተ ዋቀዮት፤","poem":1},{"text":"እንስ ቀጄሉማ እሳን ነራ አርገተኒዸ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}