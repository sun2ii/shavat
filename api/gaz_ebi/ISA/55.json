{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":55,"content":[{"type":"heading","content":["አፌራ ወረ ዼቦተኒፍ ጎዸሜ"]},{"type":"verse","number":1,"content":[{"text":"“እስን ወር ዼቦተን ሁንድኑ ኮታ፤","poem":1},{"text":"ገረ ብሻኒ ኮታ፤","poem":2},{"text":"እስን ወር ማለቀ ህንቀብኔ፣","poem":1},{"text":"ኮታቲ ብተዻ፤ ኛዻስ!","poem":2},{"text":"ኮታቲ ማለቃፊ ገቲ መሌ","poem":1},{"text":"ዳዺ ወይኒቲፊ ኣነን ብተዻ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እስን ማሊፍ ዋን ቡዴነ ህንተእንት ማለቀ ባፍቱ?","poem":1},{"text":"ዋን ነመ ህንቁብስኔረትስ ማሊፍ ሁምነኬሰን ፍጡ?","poem":2},{"text":"ዸገኣ፤ ነ ዸገኣ፤ ዋን ጋሪ ኛዻ፤","poem":1},{"text":"ሉቡንኬሰንስ ጮማን ሃገመዱ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ጉረ ናፍ ኬናቲ ገረኮ ኮታ፤","poem":1},{"text":"አከ ሉቡንኬሰን ጅራቱፍስ ነ ዸገኣ።","poem":2},{"text":"አን ከኩ በረ በራ እስን ወጅን ነንገለ፤","poem":1},{"text":"እንስ ጃለለ አመነማ እሰ ዳዊትአብደቺፈሜ ሰናዸ፤","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኩኖ አን ሰቦታፍ ዹገ ባቱ እሰ ጎዼረ፤","poem":1},{"text":"ሆገናፊ አጀጃ ሰቦታስ እሰ ታስሴረ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሰበቢ ዋቀዮ ዋቅንኬ፣","poem":1},{"text":"ቁልቁልች እስራኤል ሱን፣ ኡልፍነ ሲፍ ኬኔፍ፣","poem":2},{"text":"አት ዹጉማን ሰቦተ ህንቤክኔ ንዋምተ፤","poem":1},{"text":"ሰቦትን ስ ህንቤክኔስ አሪቲዻን ገረኬ ዹፉ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ዬሮ እን አርገሙት ዋቀዮን በርባደዻ፤","poem":1},{"text":"ዬሮ እን ዽኦ ጅሩትስ እሰ ዋመዻ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ነምን ሀማን ከራሳ፣","poem":1},{"text":"ነምን ጀልኣንሞ ያደሳ ሃዺሱ።","poem":2},{"text":"እን ገረ ዋቀዮት ሃዴብኡ፤ እንስ ንአራረማፍ፤","poem":1},{"text":"ገረ ዋቀኬኛት ሃዴብኡ፤ ዺፈምንሳ ባይኤዻቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ያድንኮ ያደኬሰን፣","poem":1},{"text":"ከራንኬሰንስ ከራኮ ምት”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“አኩመ ሰሚወን ለፈራ ኦል ፈጋተን ሰነ፣","poem":1},{"text":"ከራንኮ ከራኬሰንራ፣","poem":2},{"lineBreak":true},{"text":"ያድንኮስ ያደኬሰንራ ኦል ፈጎዸ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አኩመ ቦካፊ ጨቢን ሰሚዻ ሮቡ ሰነ፣","poem":1},{"text":"አከ ለፍት ብቅለ ብቅልችቴ እሰ ፈጫፈቱፍ ሰኚ፣","poem":2},{"text":"እሰ ኛቱፍሞ ቡዴነ ኬንቱፍ መሌ","poem":1},{"text":"ኡቱ እሼ ህንቁብስን ህንዴብኔ ሰነ፣","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዱቢንኮ ከን አፋንኮቲ በኡስ","poem":1},{"text":"ፌዺኮ ራወተ፤","poem":2},{"text":"ካዮ አን እሰ ኤርጌፍስ ገልማን ገአ መሌ","poem":1},{"text":"ሀርከ ዱዋ ገረኮት ህንዴብኡ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እስን ገመቹዻን ባቱ፤","poem":1},{"text":"ነጋዻን ጌጌፈምቱ፤","poem":2},{"text":"ቱሉወኒፊ ጋረን፣","poem":1},{"text":"ፉለኬሰን ዱረት እልልቸኒ ፋርፈቱ፤","poem":2},{"text":"ሙኬን ድሬ ሁንድኑስ","poem":1},{"text":"ሀርከ ወልት ሩኩቱ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ቆደ ቆራቲ ብርብርስ፣","poem":1},{"text":"ቆደ ሶኮሩስ ኩሳዬን ንብቅለ።","poem":2},{"text":"ኩንስ ዋቀዮፍ ያደኖ፣","poem":1},{"text":"መለቶ በረ በራ ከን ህንበድኔ ተአ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}