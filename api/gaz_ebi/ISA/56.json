{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":56,"content":[{"type":"heading","content":["ፈይነ ወረ ካኒፍ ኬነሜ"]},{"type":"verse","number":1,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"ሰበቢ ፈይሱንኮ ዽኣቴፊ","poem":1},{"text":"ቀጄሉማንኮ ደፌ ሙልአቱፍ፣","poem":2},{"text":"“ሙርቲ ቀጄላ ኤጋ፤","poem":1},{"text":"ዋን ቀጄላስ ሆጄዻ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ነምን ዋን ከነ ሆጄቱ፣","poem":1},{"text":"ከን ዋን ከነትስ ጭሙ፣","poem":2},{"text":"ከን ሰንበተ ኡቱ ህንጡሬስንኤጉፊ ዋን ሀማ ከምዩ","poem":1},{"text":"ሆጄቹራ ሀርከሳ ኤገቱ ኤብፈማዸ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"አለጋን ዋቀዮት ጭቼ ቶኮ፣","poem":1},{"text":"“ዋቀዮ ዹጉማንሰበሳራ አዳን ነ ባሰ” ህንጄዽን።","poem":2},{"text":"ጡኣሺን ከምዩስ፣","poem":1},{"text":"“አን ሙኩመ ጎጋዸ” ኦፊን ህንጄዽን።","poem":2}]},{"type":"verse","number":4,"content":["ዋቀዮ አከነ ጄዻቲ፦",{"text":"“ጡኣሺወን ሰንበቶተኮ ኤገን፣","poem":1},{"text":"ከኔን ዋን ነ ገመቺሱ","poem":2},{"lineBreak":true},{"text":"ፍለተኒፊ ከኩኮ ጀቤሰኒ ኤገኒፍ፣","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አን መነ ቁልቁሉማኮቲፊ","poem":1},{"text":"ደላሳ ኬሰት ያደኖፊ መቃ","poem":2},{"lineBreak":true},{"text":"እልማኒፊ እንተለን ጫሉ ቶኮ ነንኬናፍ፤","poem":2},{"text":"አን መቃ በረ በራ","poem":1},{"text":"ከን ህንሀቀምኔ እሳኒፍ ነንኬነ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አለጎተ እሰ ተጃጅሉፍ፣","poem":1},{"text":"መቃ ዋቀዮ ጃለቹፍ፣","poem":2},{"text":"እሰ ዋቄፈቹፍ","poem":1},{"text":"ዋቀዮት ጭቸን","poem":2},{"text":"ከኔን ሰንበተ ኡቱ ህንጡሬስን ኤገኒፊ","poem":1},{"text":"ከኩኮስ ጭምሰኒ ኤገን ሁንደ፣","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አን ገረ ቱሉኮ ቁልቁሉት እሳን ነንፍደ፤","poem":1},{"text":"መነ ከዸትናኮ ኬሰትስ ገመቹ እሳኒፍ ነንኬነ።","poem":2},{"text":"ኣርሳንሳኒ ከን ጉበሙፊ ቀልም፣","poem":1},{"text":"እዶ ኣርሳኮረት ፉዸተመ ንአርገተ፤","poem":2},{"text":"መንኮ ሰቦተ ሁንዳፍ፣","poem":1},{"text":"መነ ሰገዳ ጄዸሜ ዋመማቲ።”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዋቀዮ ጎፍታን፣","poem":1},{"text":"እን እስራኤሎተ ብትናአን ወልት ቀቡ ሱን አከነ ጄዸ፦","poem":2},{"text":"“አን ወረ ዱራን ወልት ቀበመን ብረት፣","poem":1},{"text":"ወረ ካንስ ገረ እሳኒት ወልት ነንቀበ።”","poem":2}]},{"type":"heading","content":["ዋቅን ዱረ ቡኦተ እስራኤል ህመቴ"]},{"type":"verse","number":9,"content":[{"text":"ብኔንሶትን ድሬ ሁንድ፣","poem":1},{"text":"ብኔንሶትን ቦሶና ሁንድስ ኮታቲ እት ገገባ ኛዻ!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኤግዶን እስራኤል ጃሞተ፣","poem":1},{"text":"እሳን ሁንድ ቤኩምሰ ህንቀበን፤","poem":2},{"text":"ሁንድሳኒ ሰሮተ ዱዳዸ፤","poem":1},{"text":"ዱቱስ ህንደንደአን፤","poem":2},{"text":"እሳን ጪሰኒ አብጆቱ፤","poem":1},{"text":"ረፉስ ንጃለቱ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እሳን ሰሮተ አልባዼዪዸ፤","poem":1},{"text":"ኛተኒስ ህንቁፈን።","poem":2},{"text":"እሳን ትክሶተ ሁበትና ህንቀብኔዸ፤","poem":1},{"text":"ሁንድሳኒ ዳንዲ ኦፊሳኒረ ዴሙ፤","poem":2},{"lineBreak":true},{"text":"ቶኮን ቶኮንሳኒ ፋይዳ ኦፊሳኒ በርባዱ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ቶኮን ቶኮንሳኒ አከነ ጄዹ፤“ኮታ ዳዺ ወይኒ ዹግና!","poem":1},{"text":"ኮታ ዹጋቲ ጭማ ዹግኔ ቁፍና!","poem":2},{"text":"ጉያን ቦሪ አኩመ ሀርኣ ተአ፤","poem":1},{"text":"ዮካን ጫሉዩ ንደንደአ።”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}