{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":57,"content":[{"type":"verse","number":1,"content":[{"text":"ነምን ቀጄላን ንዱአ፤","poem":1},{"text":"ከን ዋን ከነ ያደት ቀበቱ ቶኮዩ ህንጅሩ፤","poem":2},{"text":"ወር ዋቃፍ ኦፍ ኬነን ንፉዸተሙ፤","poem":1},{"text":"አከ ቀጄልቶትን","poem":2},{"text":"ዋን ሀማ ጀላ በራረሙፍ ፉዸተመን","poem":1},{"text":"ነምን ቶኮዩ ህንሁበቱ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ነምን ቀጄሉማዻን ጅራቱ፣","poem":1},{"text":"ገረ ነጋ ሴነ፤","poem":2},{"lineBreak":true},{"text":"እሳን ስሬሳኒረ ቦቆቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“እስን ገሩ ያ እልማን ፈልፈልትቲ፣","poem":1},{"text":"እስን ሰኚን ኤጅቱቲፊ ሰጋገልቱ አስ ኮታ!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እስን ኤኙት ቆስቱ?","poem":1},{"text":"ኤኙት አፋን በነቱ?","poem":2},{"lineBreak":true},{"text":"ኤኙትስ አረበ ባፍቱ?","poem":2},{"text":"እስን እልማን ፍንጭልቶታ፣","poem":1},{"text":"ሰኚ ሶብዶታ ምቲ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እስን ሙኬን ቅልጡ ግዱት፣","poem":1},{"text":"ሙኬን ደጋገን ሁንደ ጀለት ሀዊ ሀማዻን ጉበተን፤","poem":2},{"text":"ሱሉሎተ ኬሰት፣","poem":1},{"text":"ሆልቀ ከታ ኬሰትስ እጆሌኬሰን ቀልተን።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዸጋወን ጩሉሉቆን ሱሉለ ኬሳ ቆደኬት፤","poem":1},{"text":"ዹጉማን ጨራንኬ እሳኑመ።","poem":2},{"text":"አት ዽባዩ እሳኒፍ ዸንገላፍቴ፤","poem":1},{"text":"ኣርሳ ምዻኒ እሳኒፍ ዽኤስቴርተ።","poem":2},{"lineBreak":true},{"text":"አን ወንቶተ ከኔን ጨልእሴ ነንእላላ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አት ስሬኬ ቱሉ ጉዳፊ ኦል ዼራረ ዻበቴርተ፤","poem":1},{"text":"ኣርሳኬ ዽኤፈቹፍስ አች ኦል ባቴ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አት ጩፋኬቲፊ ምችችለ ጩፋኬቲ ዱባን፣","poem":1},{"text":"ያደኖኬ ፈንፈቴርተ።","poem":2},{"text":"አነ ዺፍቴ ስሬኬ ሳቀቴ፤","poem":1},{"text":"ያብዴስ በልእፍቴ በነቴ ኬሰ ሴንቴ፤","poem":2},{"text":"አት ወረ ስሬሳኒ ጃለቴ","poem":1},{"text":"ወጅን ወሊ ገልቴ ሰነ ቁላሳኒ እላልቴ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አት ዘይቲ ኤጄርሳ ፉዸቴ ገረ ሞሌክ ዸቅጤ፤","poem":1},{"text":"ሽቶኬሌ ንባይእፈቴ።","poem":2},{"text":"ኤርገሞተኬ ብየ ፈጎት ኤርግቴ፤","poem":1},{"text":"ሲኦልትስ ገድ ኤርግቴ!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዼርነ ከራኬቲቲን ደዸብዴ ቱርቴ፤","poem":1},{"text":"አት ገሩ፣ ‘ወን ኩን ፋይዳ ህንቀቡ’ ህንጄኔ።","poem":2},{"text":"ጀብነ ሃሮምፈሜ አርገቴ፤","poem":1},{"text":"ከናፉ አት ህንደዸብኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“አት አከ ነ ሶብዱፍ","poem":1},{"text":"አከ ነ ህንያደትኔፍ፣","poem":2},{"text":"ዮካን አከ ዋን ከነ ገራት ህንቀበኔፍ፣","poem":1},{"text":"ኤኙን ሶዳቴ አከስ ናቴ?","poem":2},{"text":"አት ሰበቢ አን ዬሮ ዼራ ጨልእሴፍ፣","poem":1},{"text":"ነ ሶዳቹ ዺፍቴ ምቲ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አን ቀጄሉማኬቲፊ ሆጂኬ እፈት ነንባሰ፤","poem":1},{"text":"እሳን ገሩ ስ ህንፈየደን።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዬሮ አት ገርጋርሳፍ እይቱት፣","poem":1},{"text":"ሜ ዋቆትን ቶልፈሞን አት ወልት ቀበቴ ሱን ስ ሃባሰን!","poem":2},{"text":"ቡቤን ሁንደሳኒ ፉዸቴ በደ፤","poem":1},{"text":"ሀፉር ባፈተንዩ አፉፌ እሳን በሌሰ።","poem":2},{"text":"ነምን ደአትኖሳ አነ ጎዸቱ ገሩብየቲ ንዻለ፤","poem":1},{"text":"ቱሉኮ ቁልቁሉ ሰነሌ ንዹንፈተ።”","poem":2}]},{"type":"heading","content":["አብዲ ወረ ገድ ቀበመኒፍ ኬነሜ"]},{"type":"verse","number":14,"content":["አከነስ ንጄዸመ፦",{"text":"“ቶልቻ፤ ቶልቻ፤ ዳንዲ ቆጴሳ!","poem":1},{"text":"ከራ ሰበኮቲራ ጉፉወን ቡቡቅሳ።”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እን ጉዳኒፊ ኦል ኦል ጄዼ፣","poem":1},{"text":"ከን በረ በራን ጅራቱፊከን መቃንሳ ቁልቁሉ ጄዸሙ ሱን አከነ ጄዸ፦","poem":2},{"text":"“አን እዶ ኦል ከኣፊ እዶ ቁልቁሉረ ነንጅራዸ፤","poem":1},{"text":"ሀፉረ ወረ ገድ ቀበመኒ በየነቺሱፍ፣","poem":2},{"text":"ገራ ወረ ገድ ኦፍ ቀበኒ ጀጀቤሱፍ ገራሚፊ","poem":1},{"text":"ከን ሀፉራን ገድ ቀበሜ ወጅንስ ነንጅራዸ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አን በረ በራን ነመት ህንፈልሙ፤","poem":1},{"text":"ዮካን ዬሮ ሁንደ ህንዼከሙ፤","poem":2},{"text":"ዮ አከስ ተኤ ሀፉር ነማ፣","poem":1},{"text":"ሀፉር ነምን አን ኡሜ ባፈቱ ንጭታቲ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አን ዸራሳ ከን ጩቡን ጉተሜ ሰነተን ዼከሜ፤","poem":1},{"text":"እሰ አደቤስ ኣሪዻን ፉለኮ እሰ ዱራ ነንዾክፈዼ፤","poem":2},{"lineBreak":true},{"text":"እን ገሩ ከሩመ ፌዺሳቲን እት ፉፌ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"አን ከራሳ አርጌረ፤ ገሩ እሰ ነንፈይሰ፤","poem":1},{"text":"አን እሰ ነንቀጄልቸ፤ ዴብሴስ ነንጀጀቤሰ፤","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"አረበ ቦሱወን እስራኤል ኬሰ ጅራተኒረትስገለተ ነንኡመ።","poem":2},{"text":"ወረ ፈጎ ጅራተኒፍ ነጋን፣ ወረ ዽኦ ጅራተኒፍስ ነጋን ሃተኡ።","poem":1},{"text":"አንስ እሳን ነንፈይሰ” ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ነሞትን ሀሞን ገሩ አኩመ ገላነ ኦሊ ገድ ደደርበተሙ፣","poem":1},{"text":"ከን ቦቆቹ ህንደንዴኜ፣","poem":2},{"lineBreak":true},{"text":"ከን ደምበሊንሳ ላቂፊ ዾቄ ቱፉት።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“ነሞተ ሀሞፍ ነጋን ህንጅሩ” ጄዸ ዋቅንኮ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":21}