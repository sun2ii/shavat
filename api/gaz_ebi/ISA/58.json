{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":58,"content":[{"type":"heading","content":["ሶመ ዋቅን እት ገመዱ"]},{"type":"verse","number":1,"content":[{"text":"“ጉድሲ እይ፤ ህንቁሰትን።","poem":1},{"text":"አኩመ መለከታ ሰገሌኬ ኦል ፉዸዹ።","poem":2},{"text":"ሰበኮት ፍንጭለሳኒ፣","poem":1},{"text":"መነ ያቆብትሞ ጩቡሳኒ ለብስ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እሳን ጉዩመ ጉያን ነ በርባዱቲ፤","poem":1},{"text":"እሳን አኩመ ሰበ ዋን ቀጄላ ሆጄቴ","poem":2},{"text":"አጀጀወን ዋቀሳ ህንዺስን ቶኮት","poem":1},{"text":"ዋን ከራኮ ቤኩ በርባደን ፈካቱ።","poem":2},{"text":"እሳን ሙርቲ ቀጄላ ነ ከዸቱ፤","poem":1},{"text":"አከ ዋቅን እሳንት ዽኣቱስ ዋን ሀወን ፈካቱ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እሳንስ፣ ‘ዮ አት ዋን ከነ ህንአርግኔ፣","poem":1},{"text":"ኑ ማሊፍ ሶምኔ?","poem":2},{"text":"ዮ አት ዋን ከነ ህንቀልቤፈትኔ","poem":1},{"text":"ኑ ማሊፍ ገድ ኦፍ ቀብኔ?’ ጄዹ።","poem":2},{"lineBreak":true},{"text":"“ተኡስ እስን ጉያ ሶመኬሰኒ ዋን ፌተን ጎተን፤","poem":1},{"text":"ሆጄቶተኬሰን ሁንደስ ንሀጩጨን።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሶምንኬሰን ወል ሎሉፊ ወል ቆጮሉዻን፣","poem":1},{"text":"አቦቴ ሀምናቲን ወል ቱሙዻን ራወተ።","poem":2},{"text":"ሶምን እስን ሀርአ ሶማ ጅርተን ኩን፣","poem":1},{"text":"አከ ሰገሌንኬሰን ጉባት ዸገአሙ ህንጎዹ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሶምን አን ፍለዼ ሶመ አከናቲ?","poem":1},{"text":"ነምን ቶኮ ጉዩመ ቶኮ ቆፋፍ ገድ ኦፍ ቀባ?","poem":2},{"text":"ወን ኩን አኩመ ዸላዱ መታ ገድ ቀበቹፊ","poem":1},{"text":"ወያ ገዳቲፊ ዳራረ ጪሱ ቆፋፊ?","poem":2},{"text":"ወን እስን ሶመ ጄተኒን","poem":1},{"text":"ጉያን ፉለ ዋቀዮ ዱረት ፉዸተመ ቀቡ ከና?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“ሶምን አን እት ገመዱ፣","poem":1},{"lineBreak":true},{"text":"ከን ፎንጫ ጀልእና ፉሩ፣","poem":1},{"text":"ከን ፉኞ ዋንጆ ሂኩ፣","poem":2},{"text":"ከን ጩንቁርፈምቶተ ብልሰ ባሱፊ","poem":1},{"text":"ዋንጆ ሁንደ ጨጨብሱ ምቲ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አከ አት ወረ ቤለአኒፍ ኛተኬ ቆዱፊ","poem":1},{"text":"አከ ህዬዪ መነ ህንቀብኔ መነኬት ስመቱ፣","poem":2},{"text":"አከ አት ዬሮ ነመ ዳሬ አርግቱትዳረ እሰ ባፍቱፊ","poem":1},{"text":"አከ ነመ ፎኒፊ ዺገኬ ተኤትዱግደ ህንገሌ ምቲ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዮስ እፍንኬ አከ ቢፍቱ ገነማ ንበአ፤","poem":1},{"text":"ፈይንኬስ ደፌ ንዹፈ፤","poem":2},{"text":"ቀጄሉማንኬ ፉለኬ ዱረ ዴመ፤","poem":1},{"text":"ኡልፍን ዋቀዮሞ ዱባን ስ ኤገ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዬሮ ሰነ አት ንዋመተ፤ ዋቀዮስ ዴቢ ሲፍ ኬነ፤","poem":1},{"text":"አት ገርጋርሰ በርባቸ እየተ፤ እንስ፣ ‘አን አሰን ጅረ’ ሲን ጄዸ።","poem":2},{"lineBreak":true},{"text":"“አት ዮ ዋንጆ ጩንቁርሳ፣ ሃሰአ ሀምናቲፊ","poem":1},{"text":"ቁበ ነመት ቀቡ ኦፍራ ፈጌስቴ፣","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አት ዮ ወረ ቤለአኒፍ ኛተ ኬንቴ፣","poem":1},{"text":"ወረ ረከተንስ ረክና ባፍቴ፣","poem":2},{"text":"እፍንኬ ዱከነ ኬሰ ንእብሰ፤","poem":1},{"text":"ሀልከንኬስ አከ ጉያ ሳፋ ተአ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዋቀዮ ዬሮ ሁንደ ስ ጌጌሰ፤","poem":1},{"text":"እን ለፈ አዱዻን ጉበቴ ኬሰትዩፌዺኬ ሲፍ ጉተ፤","poem":2},{"lineBreak":true},{"text":"ለፌኬስ ንጀቤሰ።","poem":2},{"text":"አት አከ ለፈ ብቅልቱ ብሻን ቁፌ፣","poem":1},{"text":"አከ ቡርቃ ህንጎግኔስ ንታተ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኡመትንኬ ዲገማ ዱሪ ዴብሴ ንእጃረ፤","poem":1},{"text":"አትስ ሁንዴ ዸሎተ ባይኤ ኦል ካስተ፤","poem":2},{"text":"አትስ፣ ሱጳ ደላወን ጅጅገኒ፣","poem":1},{"text":"ሃሮምሳ ዳንዲወን ጅሬኛ ጄዸምቴ ዋመምተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“አት ዮ ሚለኬ ሰንበተ ጨብሱራ ኤገቴ","poem":1},{"text":"ጉያኮ ቁልቁሉ ዋን ጃለቱ ጎቹ ዺፍቴ፣","poem":2},{"text":"አት ዮ ሰንበታን፣ ‘ገመቹ’","poem":1},{"text":"ጉያ ቁልቁላኣ ዋቀዮቲንሞ፣ ‘ከበጀማ’ ጄቴ፣","poem":2},{"text":"ዮ ዳንዲ ኦፊኬቲ ዴምቱፊ ዮ ዋን ፌቴ ጎቹ","poem":1},{"text":"ዮካን ሃሳ ፋይዳ ህንቀብኔ ሃሰኡ ባቴሰንበተ ኡልፌስቴ፣","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዬሮ ሰነ ዋቀዮት ንገመደ፤","poem":1},{"text":"አንስ አከ አት ለፈ ኦል ዼራረ ጉሉፍቱ፣","poem":2},{"lineBreak":true},{"text":"ዻለ አባኬ ያቆብ ኛቴ አከ ቁፍቱስ ስን ታስሰ።”","poem":2},{"text":"አፋን ዋቀዮ ዱበቴራቲ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/57.json","previousChapterAudioLinks":{},"numberOfVerses":14}