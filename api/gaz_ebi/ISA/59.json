{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":59,"content":[{"type":"heading","content":["ጩቡ፣ በሌሳ ህመቹፊ ፉረመ"]},{"type":"verse","number":1,"content":[{"text":"ዹጉማን ሀርክ ዋቀዮ ፈይሱፍ ገባባ ምት፤","poem":1},{"text":"ዮካን ጉርሳ ዸገኡ ህንድድኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"የክኬሰን ገሩ ዋቀኬሰኒን","poem":1},{"text":"ገርገር እስን ባሴረ፤","poem":2},{"text":"አከ እን እስን ህንዸጌኜፍ፣","poem":1},{"text":"ጩቡንኬሰን ፉለሳ እስን ዱራ ዾክሴረ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሀርክኬሰን ዺጋን፣","poem":1},{"text":"ቁብንኬሰንሞ የካን ፋለሜራቲ።","poem":2},{"text":"አፋንኬሰን ሶበ ዱበተ፤","poem":1},{"text":"አረብንኬሰንሞ ዋን ሀማ ጉንጉመ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ነምን ሙርቲ ቀጄላ በርባዱ ህንጅሩ፤","poem":1},{"text":"ከን ህመተሳ አመነሙማዻን ዽኤፈቱቶኮዩ ህንጅሩ።","poem":2},{"text":"እሳን ዋን ፋይዳ ህንቀብኔ አመነተን፤ ሶበ ዱበተን፤","poem":1},{"text":"ጎዎምሳ ኡልፋአኒ ሀምነ ዸለን።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እሳን ሀንቃቁ ቡቲ ያሰን፤ መንኤ ሰሪቲ ፎአን።","poem":1},{"text":"ነምን ሀንቃቁሳኒ ኛቱ ከምዩ ንዱአ፤","poem":2},{"text":"ዮሙ ቶኮንሳ ጨቡት","poem":1},{"text":"ቡቲቱ ኬሳ በአ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ፎኣንሳኒ ኡፈተ ህንተኡ፤","poem":1},{"text":"ዋን ቶልቸኒንስ ዸግነሳኒ ሀጉገቹ ህንደንደአን።","poem":2},{"text":"ሆጂንሳኒ ሆጂ ሀምናት፤","poem":1},{"text":"ሀርከሳኒ ኬሰስ ሆጂ ፍንጭላቱ ጅረ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሚልሳኒ ገረ ጩቡት ፊገ፤","poem":1},{"text":"እሳን ዺገ ቁልቁሉ ዸንገላሱፍ አሪፈተን።","poem":2},{"text":"ያድንሳኒ ጀልኣዸ፤","poem":1},{"text":"ዲጉፊ በርበዴሱን መለቶ ከራሳኒት።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እሳን ከራ ነጋ ህንቤከን፤","poem":1},{"text":"ሙርቲን ቀጄላን ከራሳኒረ ህንጅሩ።","poem":2},{"text":"ዳንዲሳኒ ጀልእሰኒሩ፤","poem":1},{"text":"ነምን አችረ ዴሙ ቶኮዩ ነጋ ህንቤኩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ከናፉ ሙርቲን ቀጄላን ኑራ ፈጋቴረ፤","poem":1},{"text":"ቀጄሉማንስ ኑ ብረ ህንገኡ።","poem":2},{"text":"ኑ እፈ በርባነ፤ ገሩ ሁንድኑ ዱከነ፤","poem":1},{"text":"እፈ ጉያ በርባነ፤ ገሩ ድምምሰ ኬሰ ዴምነ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኑ አኩመ ጃማ ደላ ቀቀበቻ ዴምነ፤","poem":1},{"text":"አኩመ ወረ እጀ ህንቀብኔ ሀርካን ከራኬኘ በርባደትነ።","poem":2},{"text":"አከ ነመ ሀልከኒን ዴሙ ጉያ ሳፋዻን ጉጉፈትኔ፤","poem":1},{"text":"ነሞተ ጀጀቦ ግዱት አከ ወረ ዱአኒ ታኔረ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኑ ሁንድ አከ አማኬታ ጉሩሪነ፤","poem":1},{"text":"አከ ጉጌስ ገዳን ኣድነ።","poem":2},{"text":"ሙርቲ ቀጄላ በርባነ፤ ገሩ ህንአርገኔ፤","poem":1},{"text":"ፈይነ በርባነ፤ እን ገሩ ኑራ ፈጋቴረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"የክኬኘ ፉለኬ ዱረት ባይአቴራቲ፤","poem":1},{"text":"ጩቡንኬኘስ ዹጋ ኑት በአ።","poem":2},{"text":"የክኬኘ ኑ ወጅን ጅራተ፤","poem":1},{"text":"ኑስ በሌሳኬኘ ንቤክነ፤","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኑ ፍንጭሌ ዋቀዮን ሶብኔ፤","poem":1},{"text":"ዋቀኬኘ ዱካ ቡኡራ ገረገሌረ፤","poem":2},{"text":"ጎሊፊ ፍንጭለ ከካፍኔረ፤","poem":1},{"text":"ሶበ ገራንኬኘ ያዴስ ዱበኔረ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ከናፉ ሙርቲ ቀጄላን ዱበት ዴብፈሜረ፤","poem":1},{"text":"ቀጄሉማንስ ፈጎ ዻበተ፤","poem":2},{"text":"ዹጋን ከራት ጉፈቴ፤","poem":1},{"text":"ቶልስ ኦል ሴኑ ህንደንደኡ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዹጋን ኤሱመቱ ህንአርገሙ፤","poem":1},{"text":"ነምን ጩቡራ ፈጋቱስ ዋን ሀማፍ ሳጥለመ።","poem":2},{"lineBreak":true},{"text":"ዋቀዮ አከ ሙርቲ ቀጄላን ህንጅሬ አርጌ፤","poem":1},{"text":"ኩንስ እሰ ገድሲሴ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እን አከ ነምን ቶኮዩ ህንጅሬ አርጌ፤","poem":1},{"text":"ከን ገረሳት ከዸትና ዽኤሱ ዋን ዸበሜፍስንድንቅሲፈቴ።","poem":2},{"text":"ከናፉ እሬንሳ ፈይነሳ ፍዴ፤","poem":1},{"text":"ቀጄሉማን ኦፊሳስ እሰ ኡቱቤ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ቀጄሉማ አከ ጋቸነ ቆማት ካአቴ","poem":1},{"text":"ጎንፎ ፈይናስ መታት ጎምብፈቴ፤","poem":2},{"text":"ወያ እቲን ሃሎ በኡ ኡፈቴ","poem":1},{"text":"አከ ነመ ዋሮ ኡፈቱትስ ህናፋ ኦፍት መረቴ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ከናፉ እን አኩመ ሆጂሳኒት፣","poem":1},{"text":"ዲኖተሳቲፍ ዼከምሰ፣","poem":2},{"text":"አመጃጆተሳኒቲፍሞ አደቢ መሉ ንኬነ፤","poem":1},{"text":"ብዮተ ብሻን ግዱቲፍስ ሆጂ ሀርከሳኒ ኬናፍ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ነሞትን ልጠ ቢፍቱ መቃ ዋቀዮ ሶዳቱ፤","poem":1},{"text":"ወር በአ ቢፍቱት አርገመንሞ ኡልፍነሳ ከበጁ።","poem":2},{"text":"እን አኩመ ሎላ፣","poem":1},{"text":"ከን ቡቤን ዋቀዮ ኦፉት ንዹፋቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ፉራን ገረ ጥዮን፣ ገረ ወረ መነ ያቆብ ኬሳ","poem":1},{"text":"ቀልቢ ጅጂረተኒ ንዹፈ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":21,"content":["“ገመኮቲን ከኩንኮ ከን አን እሳን ወጅን ቀቡ ከነ” ጄዸ ዋቀዮ። “ሀፉርኮ ከን ስረ ጅሩ፣ ዱቢንኮ ከን አን አፋንኬ ኬሰ ካኤ ሱን አፋንኬቲ ዮካን አፋን እጆሌኬቲቲ ዮካን አፋን እጆሌ እጆሌሳኒቲ ሀርኣ ጀልቀቤ በረ በራን ህንበዱ” ጄዸ ዋቀዮ።"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/58.json","previousChapterAudioLinks":{},"numberOfVerses":21}