{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":6,"content":[{"type":"heading","content":["ኤርገመ እሳያስ"]},{"type":"verse","number":1,"content":["በረ ኡዝያን ሞትች ዱኤ ኬሰ፣ አን ኡቱ ጎፍታን ቴሶ ኦል ዼራፊ ኡልፍነ ቀቤሰረ ታኤ፣ ሀንዳር ኡፈተሳ መነ ቁልቁሉማ ጉቴ ጅሩ ነንአርጌ።"]},{"type":"verse","number":2,"content":["እሳ ኦልትስ ሱራፌሎተ ቶኮን ቶኮንሳኒ ቆቾ ጀአ ጀአ ቀበንቱ ቱሬ፤ እሳንስ ቆቾ ለማን ፉለሳኒ ሀጉገቱ፤ ቆቾ ለማን ሚለሳኒ ሀጉገቱ፤ ቆቾ ለማንሞ ንበርሱ ቱረን።"]},{"type":"verse","number":3,"content":["እሳንስ፦",{"text":"“ዋቀዮ ዋን ሁንደ ደንደኡቁልቁሉ፣ ቁልቁሉ፣ ቁልቁሉዸ፤","poem":1},{"text":"ለፍት ሁንድኑ ኡልፍነሳቲን ጉተምቴርት”","poem":2},"ጄዸኒ ወልት ለለባ ቱረን።"]},{"type":"verse","number":4,"content":["ሰገሌሳኒቲን ሁንዴን ዻበ በልበላ ንራፈሜ፤ መን ቁልቁሉማስ ኣራን ጉተሜ።"]},{"type":"verse","number":5,"content":["አንስ አከነ ጄዼን እዬ፤ “አናፍ ወዮ! አን በዴ! አን ነመ ህዺ ጡራኣ ከን ነሞተ ህዺ ጡራኣ ቀበን ግዱ ጅራቱዻቲ፤ እጅኮ ሞትቸ፣ ዋቀዮ ዋን ሁንደ ደንደኡ አርጌራቲ።”"]},{"type":"verse","number":6,"content":["ሱራፌሎተ ኬሳ እን ቶኮ ጭሌ ቦበኡ ከን ቀብዱዻን እዶ ኣርሳራ ፉዼ ቶኮ ሀርከት ቀበቴ ገረኮት በርሴ።"]},{"type":"verse","number":7,"content":["እንስ ጭሌ ሰናን አፋንኮ ቱቄ፣ “እላል፣ ወን ኩን ህዺኬ ቱቄረ፤ በሌሳንኬ ስራ ፉዸሜረ፤ ጩቡንኬስ ሲፍ ዺፈሜረ” ጄዼ።"]},{"type":"verse","number":8,"content":["አንስ ሰገሌ ጎፍታ ከን፣ “አን ኤኙነን ኤርገዸ? ኤኙቱ ኑፍ ዴመ?” ጄዹ ነንዸገኤ። ከነረት አን፣ “ኩኖ አኑ ጅረ። ነ ኤርግ!” ነንጄዼ።"]},{"type":"verse","number":9,"content":["እንስ፣ “ዸቂቲ አከነ ጄዺ ሰበ ከነት ህም፦",{"text":"“ ‘ዸገኡ ንዸጌሱ፤ ገሩ ህንሁበተን፤","poem":1},{"text":"አርጉስ እኑመ አርግቱ፤ ገሩ ህንቀልቤፈተን!’","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ቀልቢ ሰበ ከና ዶምስ፤","poem":1},{"text":"ጉረሳኒ ጩቃል፤","poem":2},{"lineBreak":true},{"text":"እጀሳኒስ ጩፍ።","poem":2},{"text":"ዮ ከና አቺ እሳን እጀ ኦፊሳኒቲን አርገኒ","poem":1},{"text":"ጉረሳኒቲን ዸገአኒ","poem":2},{"lineBreak":true},{"text":"ቀልቢሳኒቲን ሁበተኒ ዴብአኒ ፈዩ።”","poem":2}]},{"type":"verse","number":11,"content":["አን፣ “ያ ጎፍታ፣ ወን ኩን ሀመ ዮሚት አከነ ተአ?” ነንጄዼ። እንስ አከነ ጄዼ ዴብሴ፦",{"text":"“ሀመ መጋላወን ዲገመኒ","poem":1},{"text":"ነመ እሳን ኬሰ ጅራቱ ዸበንት፣","poem":2},{"text":"ሀመ መኔን ኦነኒ ለፍት ቆቲሳስ","poem":1},{"text":"በርበዳኤ ዱዋ ሀፉት፣","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሀመ ዋቀዮ ነመ ሁንደ ፈጌሴ","poem":1},{"text":"ለፍት ሱን ጉቱማን ጉቱት ደገተሙት ተአ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኩዸን ኬሳ ቶኮ ዮ ሀፌዩ፣","poem":1},{"text":"ብይ ሱን አመሌ ዴብቴ ኦንት።","poem":2},{"text":"ገሩ አኩመ ሙክን ላፍቶቲፊ ቅልጡ፣","poem":1},{"text":"ዮ ሙረን ጉፉንሳ ለቱ ሰነ","poem":2},{"lineBreak":true},{"text":"አከሱመ ሰኚን ቁልቁሉን ጉፉ ተኤ አችት ሀፈ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}