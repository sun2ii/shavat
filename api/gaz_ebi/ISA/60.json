{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":60,"content":[{"type":"heading","content":["ኡልፍነ ጥዮን"]},{"type":"verse","number":1,"content":[{"text":"“እፍንኬ ዹፌራቲ ከኢ እብስ፤","poem":1},{"text":"ኡልፍን ዋቀዮ ሲፍ በኤረ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ኩኖ፣ ዱከን ለፈ፣","poem":1},{"text":"ዱከን ሀማንሞ ኡመቶተ ሀጉገ፤","poem":2},{"text":"ዋቀዮ ገሩ ሲፍ ከኤረ፤","poem":1},{"text":"ኡልፍንሳስ ስራ ሙልአተ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሰቦትን ገረ እፈኬቲ፣","poem":1},{"text":"ሞቶትንሞ ገረ እፈኬ እሰ በሪት ንዹፉ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“እጀኬ ኦል ፉዸዹቲ ናኖኬ እላል፤","poem":1},{"text":"ሁንድኑ ወል ገአኒ ገረኬ ንዹፉ፤","poem":2},{"text":"እልማንኬ ፈጎዻ፣","poem":1},{"text":"እንተለንኬስ ቆመት ባተመኒ ገረኬ ንዹፉ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኤርገሲ ንእላልተ፤ ንጨለቅፍተስ፤","poem":1},{"text":"ለጴንኬ ንዸአተ፤ ገመቹዻንስ ንጉተመ፤","poem":2},{"text":"ቀቤኝ ገላኖታ ሁንድኑ ገረኬ ዹፉ፤","poem":1},{"text":"በዻዹማን ሰቦታስ ከንኬ ተአ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ጋል ባይኤን፣ እልማን ጋላ ከን ምድያኒፊ","poem":1},{"text":"ከን ኤፋ ብየኬ ንጉቱ።","poem":2},{"text":"ነሞትን ሁንድ ወርቄፊ እጣነ ፍደኒ፣","poem":1},{"text":"ገለተ ዋቀዮ ለብሳ","poem":2},{"lineBreak":true},{"text":"ብየ ሼባቲ ንዹፉ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ቡሻዬን ቄዳር ሁንድኑ ገረኬት ወልት ቀበሙ፤","poem":1},{"text":"ኮርቤዪን ሆላ ነባዮት ስ ተጃጅሉ፤","poem":2},{"text":"እሳን እዶ ኣርሳኮረት ኣርሳወን ፉዸተመ ቀበን ንተኡ፤","poem":1},{"text":"አንስ መነ ኡልፍነኮቲ ነንከበጀ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ወር አኩመ ጉጌወኒ መኔንሳኒት በርሰን፣","poem":1},{"text":"ከኔን አከ ዱሜሳ ጉገተን ኩኔን ኤኙ ፈእ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዹጉማን ብዮትን ብሻን ግዱ ነ አብደቱ፤","poem":1},{"text":"ሰበቢ እን ኡልፍነ ስት ኡፍሴፍ፣","poem":2},{"text":"መቃ ዋቀዮ ዋቀኬቲ፣","poem":1},{"text":"ቁልቁልቸ እስራኤሊቲፍ ጄዸኒ","poem":2},{"text":"ዶኒወን ተርሺሽ ዱርሰኒ፣","poem":1},{"text":"ሜቲፊ ወርቄሳኒ ወጅን","poem":2},{"lineBreak":true},{"text":"እልማንኬ ፈጎዻ ንፍዱ።","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ነሞትን ኦርማ ደላኬ ንእጃሩ፤","poem":1},{"text":"ሞቶትንሳኒስ ስ ተጃጅሉ፤","poem":2},{"text":"አን ኣሪዻን ስ ዸኡሌ፣","poem":1},{"text":"ገረ ላፍነኮ ጃለላን ስት ነንአርግሲሰ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አከ ነሞትን በዻዽነ ሰቦታ ገረኬት ፍደኒፍ፣","poem":1},{"text":"አከ ሞቶትንሳኒስ ህሪራን ገረኬት ሴነኒፍ፣","poem":2},{"text":"ከረወንኬ ዬሮ ሁንደ በነማ ተኡ፤","poem":1},{"text":"እሳን ሀልከኒ ጉያ ጎንኩማ ህንጩፈመን፤","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሰብን ዮካን ሞቱማን ስ ህንተጃጅሌንበርበዳኡቲ፤","poem":1},{"text":"ጉቱማን ጉቱትስ ንበሌፈሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ኡልፍን ልባኖን፣","poem":1},{"text":"ጋትራን፣ ቀረሮፊ ሀዼስ፣","poem":2},{"text":"ለፈ እዶ ቁልቁሉኮ ሚዸግሱፍ ገረኬ ንዹፉ፤","poem":1},{"text":"አንስ እዶ ሚልኮ ዻበቱ ነንከበጀ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እልማን ወረ ስ ጩንቁርሰኒ ሲፍ ሰገዳ ገረኬ ዹፉ፤","poem":1},{"text":"ወር ስ ቱፈተን ሁንድኑስ ሚለኬት ኩፉ፤","poem":2},{"text":"እሳንስ መጋላ ዋቀዮ","poem":1},{"text":"ጥዮን ከን ቁልቁልቸ እስራኤል ጄዸኒ ስ ዋሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“ዮ አት ጅበምቴ ገተምቴ ነምን ቶኮዩ","poem":1},{"text":"ስ ኬሳን ደርቡ ለገቴዩ፣","poem":2},{"text":"አን ቦንቱ በረ በራቲፊ","poem":1},{"text":"ገመቹ ዸሎተ ሁንዳ ስን ታስሰ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አት ኣነን ሰቦታ ንዹግደ፤","poem":1},{"text":"ሀርመ ሞቶታስ ንሆተ።","poem":2},{"text":"ዮሙስ አን ዋቀዮ ጀባን ያቆብ፣","poem":1},{"text":"ፈይሳኬፊ ፉራኬ አከን ተኤ ንቤክተ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አን ቆደ ናሲ ወርቄ፣","poem":1},{"text":"ቆደ ስቢላሞ፣ ሜቲ ሲፍ ነንፍደ።","poem":2},{"text":"ቆደ ሙካ ናሲ፣","poem":1},{"text":"ቆደ ዸጋሞ፣ ስቢለ ሲፍ ነንፍደ።","poem":2},{"text":"ነጋ ሞቲኬ፣","poem":1},{"text":"ቀጄሉማሞ፣ ቡልቻኬ ነንጎዸ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ስአች ብየኬ ኬሰት ጎሊን፣","poem":1},{"text":"ዳሪኬ ኬሰትሞ ዲገምን ዮካን በዲስንህንዸገአሙ፤","poem":2},{"text":"አት ገሩ ደላኬ ፈይነ፣","poem":1},{"text":"ከረወን ኬሞ ገለተ ጄቴ ዋምተ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ስአች አዱን ጉያዻን፣","poem":1},{"text":"እፍን ጅኣስ ሀልከኒን እፈኬ ህንተኡ፤","poem":2},{"text":"ዋቀዮ እፈኬ በረ በራ ተኣቲ፤","poem":1},{"text":"ዋቅንኬ ኡልፍነኬ ንተአ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አዱንኬ ዴብቴ ህንዺቱ፤","poem":1},{"text":"ጅእኬ ህንበዱ፤","poem":2},{"text":"ዋቀዮ እፈኬ በረ በራ ንተአ፤","poem":1},{"text":"በር ገደኬስ ንራወተመ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዮስ ኡመትንኬ ሁንድ ቀጄላ ንተአ፤","poem":1},{"text":"በረ በራንስ ለፈ ንዻለ።","poem":2},{"text":"እሳን ብቅልቱ አን ዻበዼዸ፤","poem":1},{"text":"ሆጂ ሀርከኮ፣ ከን አን እቲን ኡልፍነኮ ሙልእሱፍጄዼ ሆጄዼዸ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ማቲን ሙራስን ኩመ፣","poem":1},{"text":"ገሬን ጥናንሞ ሰበ ጉዳ ተአ።","poem":2},{"text":"አን ዋቀዮዸ፤","poem":1},{"text":"ዋን ከነ ዬሮሳት ደፌ ነንሆጄዸ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/59.json","previousChapterAudioLinks":{},"numberOfVerses":22}