{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":61,"content":[{"type":"heading","content":["በረ ቶለ ዋቀዮ"]},{"type":"verse","number":1,"content":[{"text":"ሰበቢ ዋቀዮ አከ አን","poem":1},{"text":"ህዬዪት ኦዱ ጋሪ ለለቡፍ ነ ድቤፍ፣","poem":2},{"lineBreak":true},{"text":"ሀፉር ዋቀዮ ጎፍታ ነረ ጅረ።","poem":2},{"text":"እን አከ አን ገራ ጨቤ ፈይሱፍ፣","poem":1},{"text":"አከ አን ቦጅአምቶታፍ ብልሱማ፣","poem":2},{"lineBreak":true},{"text":"ወረ ህዸመኒፍሞ ሂከሙ ለለቡፍ ነ ኤርጌረ፤","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አከ አን በረ ቶለ ዋቀዮቲፊ","poem":1},{"text":"ጉያ ሃሎ በኡ ዋቀኬኛ ለብሱፍ፣","poem":2},{"text":"አከ አን ወረ ቦአን ሁንደ ጀጀቤሱፍ፣","poem":1}]},{"type":"verse","number":3,"content":[{"text":"አከ አን ወረ ጥዮን ኬሰት ገደኒፍ አርጆሜ፣","poem":2},{"text":"ቆደ ዳራ ሚዸግነ፣","poem":1},{"text":"ቆደ ቦእቻ፣ ዘይቲ ገመቹ፣","poem":2},{"text":"ቆደ አብዲ ኩተቹሞ፣","poem":1},{"text":"ወያ ገለታ ኬኑፍ ነ ኤርጌ።","poem":2},{"text":"እሳንስ ቅልጡ ቀጄሉማ፣ ብቅልቱ ዋቀዮ፣","poem":1},{"text":"ከን እን እቲን ከበጀሙ ጄዸመኒ ዋመመን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"እሳን ዋን ዱር ዲገሜ ዴብሰኒ እጃሩ፤","poem":1},{"text":"እዶወን በረ ዼራን ዱረ ኦነኒ ቱረንስአከ ዱራት ዴብሱ፤","poem":2},{"text":"መጋላወን ዲገመን፣","poem":1},{"text":"ከኔን ዸሎተ ሄዱን ዱረ ኦነኒ ቱረን ንሃሮምሱ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አለጎን ቡሻዬኬሰን ንትክሱ፤","poem":1},{"text":"ኦርሞንስ ለፈ ቆቲሳፊእዶ ዻባ ወይኒኬሰኒ ኬሰ ንሆጄቱ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እስን ሉቦተ ዋቀዮ ጄዸምተኒ ንዋመምቱ፤","poem":1},{"text":"ተጃጅልቶተ ዋቀኬኛ ጄዸምተኒስ ንሞጋፈምቱ።","poem":2},{"text":"እስን ቀቤኘ ሰቦታ ንኛቱ፤","poem":1},{"text":"በዻዹማሳኒቲንሌ ንቦንቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ቆደ ቃኒኬሰኒ ህሬ ደቻ ንአርገቱ፤","poem":1},{"text":"ቆደ ሰልጵና እስን ዻለኬሰንት ንገመዱ፤","poem":2},{"text":"ከናፉ እስን ብየኬሰን ኬሰት ህሬ ደቻ ንዻልቱ፤","poem":1},{"text":"ገመቹን በረ በራስ ከንኬሰን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“አን ዋቀዮ ሙርቲ ቀጄላ ነንጃለዻቲ፤","poem":1},{"text":"ሳምቻፊ የከ ነንጅበ።","poem":2},{"text":"አን አመነሙማኮቲን እሳን ነንበዻሰ፤","poem":1},{"text":"ከኩ በረ በራስ እሳን ወጅን ነንገለ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሰኚንሳኒ ሰቦተ ግዱት፣","poem":1},{"text":"እጆሌንሳኒሞ ኡመተ ግዱት ንቤከሙ።","poem":2},{"text":"ወር እሳን አርገን ሁንድ፣","poem":1},{"text":"አከ እሳን ሰበ ዋቀዮ ኤብሴ ተአን ንቤኩ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"አን ዋቀዮ እት ጉዳ ነንገመደ፤","poem":1},{"text":"ሉቡንኮስ አከ መሌ ዋቀኮት ገመድ።","poem":2},{"text":"እን አኩመ ምስርች አከ ሉባት መታሳ ሚዸግፈቱ፣","poem":1},{"text":"ምስርቲንሞ ፋያን ኦፍ በሬችቱ ሰነ፣","poem":2},{"text":"ወያ ፈይና ነት ኡፍሴረ","poem":1},{"text":"ኡፈተ ቀጄሉማ ነረ ቡሴራቲ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አኩመ ለፍት ብቅልቱ ብቅልችቴ","poem":1},{"text":"እዶን ብቅልቱሞ አከ ሰኚን ጉደቱ ጎዹ ሰነ","poem":2},{"text":"ዋቀዮ ጎፍታን አከ ቀጄሉማፊ","poem":1},{"text":"ገለን ፉለ ሰቦተ ሁንዳ ዱረት ብቅለን ንጎዸ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}