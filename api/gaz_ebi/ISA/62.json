{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":62,"content":[{"type":"heading","content":["መቃ ጥዮን ሃራ"]},{"type":"verse","number":1,"content":[{"text":"ሀመ ቀጄሉማንሼ አከ በሪ በራቃ፣","poem":1},{"text":"ፈይንሼ አከ ጉጨ ቦበኡ እፉት፣","poem":2},{"text":"አን ዋኤ ጥዮን ህንጨልእሱ፤","poem":1},{"text":"ዋኤ ዬሩሳሌምስ አፋን ህንቀበዹ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሰቦትን ቀጄሉማኬ፣","poem":1},{"text":"ሞቶትን ሁንድኑስ ኡልፍነኬ ንአርጉ፤","poem":2},{"text":"አት መቃ ሃራ፣","poem":1},{"text":"ከን አፋን ዋቀዮ ሲፍ ባሱን ንዋመምተ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አት ሀርከ ዋቀዮ ኬሰት ጎንፎ ኡልፍና፣","poem":1},{"text":"ሀርከ ዋቀኬቲ ኬሰትስ መረተ ሞቲ ንታተ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አት ስአች፣ ገተምቱ ህንጄዸምቱ፣","poem":1},{"text":"ዮካን ብይኬ ኦንቱ ህንጄዸምቱ።","poem":2},{"text":"አት ገሩ፣ “አን እሼት ነንገመደ” ጄዸምተ፤","poem":1},{"text":"ብይኬስ “ከን ሄሩምቴ” ጄዸምት፤","poem":2},{"text":"ዋቀዮ ስት ገመዳቲ፣","poem":1},{"text":"ብይኬ ንሄሩምት።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አኩመ ደርገጌስ ዱርበ ፉዹ፣","poem":1},{"text":"እልማንኬ ስ ፉዹ፤","poem":2},{"text":"አኩመ ምስርች ምስርቲት ገመዱ፣","poem":1},{"text":"ዋቅንኬስ ስት ገመደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ያ ዬሩሳሌም፣ አን ደላወንኬረትኤግዶተ ረመዴረ፤","poem":1},{"text":"እሳን ጎንኩማ ሀልከኒፊ ጉያ ህንጨልእሰን።","poem":2},{"text":"እስን ወር ዋቀዮን ዋመተን፣","poem":1},{"text":"ኦፊኬሰኒፍ ቦቆና ህንኬንና፤","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሀመ እን ዬሩሳሌምን ጭምሴ እጃሬ","poem":1},{"text":"አከ እሼን ለፈረት ሌልፈምቱ ታቱ ጎዹትቦቆና እሳፍ ህንኬንና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ዋቀዮ አከነ ጄዼ","poem":1},{"text":"ሀርከሳ ምርጋቲፊ እሬሳ ጀባ ሰናን ከከቴረ፤","poem":2},{"text":"“አን ለመተ ምዻንኬ","poem":1},{"text":"ኛተ ጎዼ ዲኖተኬቲፍ ህንኬኑ፤","poem":2},{"text":"ነሞትን ኦርማስ ለመተ ዳዺ ወይኒ ሃራ","poem":1},{"text":"ከን አት እት ደዸብዴ ህንዹገን፤","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ገሩ ወር ገልፈተን ምዻን ሰነ ንኛቱ፤","poem":1},{"text":"ዋቀዮንስ ንገለቴፈቱ፤","poem":2},{"text":"ወር እጀ ወይኒ ጉረተንስ","poem":1},{"text":"ኦብዲ እዶ ቁልቁሉኮ ኬሰት ንዹጉ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ኬሰ ደርባ፤ ከረወን ኬሳን ደርባ!","poem":1},{"text":"ኡመታፍ ከራ ቆጴሳ።","poem":2},{"text":"ቶልቻ፤ ከራ ጉዳ ቶልቻ!","poem":1},{"text":"ዸጋወን ቡቡቅሳ።","poem":2},{"text":"ሰቦታፍስ ፋጂ ኦል ቀባ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ዋቀዮ አከነ ጄዼ","poem":1},{"text":"ሀመ ሞጋ ለፋት ለብሴረ፤","poem":2},{"text":"“እንተለ ጥዮኒን አከነ ጄዻ፦","poem":1},{"text":"‘ኩኖ ፈይሳንኬ ንዹፈ!","poem":2},{"text":"በዻስንሳ ኩኖ እሰ ሀርከ ጅረ፤","poem":1},{"text":"ቤኛን እን ነማፍ ባሱስ እሱመ ወጅን ጅረ።’ ”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እሳንስ ሰበ ቁልቁሉ፣","poem":1},{"text":"ፉረምቶተ ዋቀዮ ጄዸመኒ ንዋመሙ፤","poem":2},{"text":"አትስ በርባደምቱ፣","poem":1},{"text":"መጋላ ስአች ህንኦኔ ንጄዸምተ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}