{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":63,"content":[{"type":"heading","content":["ጉያ ዋቀዮ ሃሎ በኡ"]},{"type":"verse","number":1,"content":[{"text":"ከን ኡፈተሳ ሀሉ ዲማ ጩጴ","poem":1},{"text":"ኤዶም ኬሳ፣ ቦዝራዻ ዹፋ ጅሩ ኩን ኤኙ?","poem":2},{"text":"ከን ኡልፍነ ኡፈቴ ጉድነ ጀብነሳቲን","poem":1},{"text":"ፉለ ዱረት ዴማ ጅሩ ኩን ኤኙ?","poem":2},{"lineBreak":true},{"text":"“እን አኑመ፣ ከን ቀጄሉማን ዱበቱ፣","poem":1},{"text":"ከን ኦልቹፍስ ሁምነ ቀቡ አናዸ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ኡፈትንኬ ማሊፍ አኩመ ኡፈተ","poem":1},{"text":"ነመ ቦለ ወይኒ እት ጩንፈን ኬሰትወይኒ ዽዺቱ ቶኮ ዲመተ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“አን ኮጳኮ ቦለ እት ወይኒ ጩንፈን ኬሰትወይኒ ነንዽዺቴ፤","poem":1},{"text":"ሰቦተ ኬሳ ነምን ቶኮዩ ነ ወጅን ህንቱሬ።","poem":2},{"text":"አን ኣሪኮቲን እሳንረ ዻበዼ","poem":1},{"text":"ዼከምሰኮቲን ገድ እሳን ዽዺቴ፤","poem":2},{"text":"ዺግንሳኒ ወያኮት ፈፈጨኤ፤","poem":1},{"text":"ወያኮ ሁንደስ ንፋሌ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጉያን ሃሎ በኡ ገራኮ ኬሰ ጅራቲ፤","poem":1},{"text":"ወጋን አን እት ነመ ፉሩስ ዹፌረ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አንስ ምልአዼ ነመ ነ ገርጋሩ ቶኮዩ ነንዸቤ፤","poem":1},{"text":"ገርጋርሰ ቶኮዩ ዸብናን ነንድንቅሲፈዼ፤","poem":2},{"text":"ከናፉ እሬንኮ ፈይነ ና ፍዴ፤","poem":1},{"text":"ዼከምስኮስ ነ ኡቱቤ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አን ኣሪኮቲን ሰቦተረ ነንዽዺቴ፤","poem":1},{"text":"ዼከምሰኮቲንስ እሳን ነንመቼሴ፤","poem":2},{"lineBreak":true},{"text":"ዺገሳኒ ለፈረ ነንሎላሴ።”","poem":2}]},{"type":"heading","content":["ገለቴፈትናፊ ከዸትና"]},{"type":"verse","number":7,"content":[{"text":"አኩመ ዋን እን ኑፍ ሆጄቴ ሁንዳት","poem":1},{"text":"አን ዋኤ ጃለለ ዋቀዮከን ህንጌደረምኔ ሰና","poem":2},{"lineBreak":true},{"text":"ሆጂ እን እቲን ገለቴፈሙ ቀቡ ነንኦዴሰ፤","poem":2},{"text":"ወንቶተ ገጋሪ እን አኩመ ገረ ላፍናፊ","poem":1},{"text":"አርጁማሳ ሄዱ ሰናት መነ እስራኤሊፍ ሆጄቴ ባይኤ","poem":2},{"lineBreak":true},{"text":"አን ዹጉማን ነንኦዴሰ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እንስ፣ “እሳን ዹጉማን ሰበኮት፤","poem":1},{"text":"እጆሌ ህንሶብኔዸ” ጄዼ፤","poem":2},{"lineBreak":true},{"text":"ከናፉ እን ፈይሳሳኒ ተኤ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዽጵነሳኒ ሁንደ ኬሰት፣ እንስ ንዽጰቴ፤","poem":1},{"text":"ኤርገማን ዋቀዮ ከን ፉለሳ ዱረ ዻበቱ እሳን በራሬ።","poem":2},{"text":"ጃለላፊ አራረሳቲን እሳን ፉሬ፤","poem":1},{"text":"በረ ዱሪ ሁንደ ኬሰ፣","poem":2},{"lineBreak":true},{"text":"እን ኦል ፉዼ እሳን ባቴ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እሳን ገሩ ፍንጭለኒ","poem":1},{"text":"ሀፉረሳ ቁልቁሉ ገድሲሰን።","poem":2},{"text":"ከናፉ እን ዴብኤ ዲነሳኒ ተኤ፤","poem":1},{"text":"እን መታንሳስ እሳን ሎሌ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ከነረት ሰብንሳ በረ ዱሪ፣","poem":1},{"text":"በረ ሙሴቲፊ ሰበሳ ያደቴ አከነ ጄዼ፦","poem":2},{"text":"እን ትክሴ ቡሻዬሳ ወጅንገላነ ኬሳ እሳን ባሴ ሱን ኤሰ ጅረ?","poem":1},{"text":"እን ሀፉረሳ ቁልቁሉ ግዱሳኒ ቡሴ፣","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ከን አከ እሬንሳ ኡልፍነ ቀቤስ ጀባን ሱን፣","poem":1},{"text":"ሀርከ ምርጋ ከን ሙሴ ወጅን ጅራቱፍ ኤርጌ፣","poem":2},{"text":"ከን መቃ በረ በራ ኦፊሳቲፍ ጎዸቹዻፍ","poem":1},{"text":"ፉለሳኒ ዱረት ብሻን ገርገር ቆዴ፣","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ከን ቱጁበ ኬሳን እሳን ቀጄልቼ ሱን ኤሰ ጅረ?","poem":1},{"text":"እሳን አኩመ ፈርደ ብየ በልኣ ኬሰ ጉሉፉ ቶኮ ህንጉፈትኔ፤","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አኩመ ሎን ድሬት ቦበአኒት፣","poem":1},{"text":"ሀፉር ዋቀዮ ቦቆና እሳኒፍ ኬኔ።","poem":2},{"text":"አክ አት እት መቃ ኡልፍነ ቀቡ ኦፊኬቲፍ ጎዸቹዻፍ ጄቴ","poem":1},{"text":"ሰበኬ ቀጄልችቴ ከናዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"አት ሰሚራ፣ ቴሶኬ ቁልቁሉፊ","poem":1},{"text":"ኡልፍነ ቀቤሰ ሰነራ ገድ እላል።","poem":2},{"text":"ህናፋንኬቲፊ ጀብንኬ ኤሰ ጅሩ?","poem":1},{"text":"ጃለሊፊ ገረ ላፍንኬ ኑራ እትፈመኒሩ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዮ አብረሃም ኑ ቤኩ ባቴ፣","poem":1},{"text":"ዮካን እስራኤል ኑ ያደቹ ባቴዩ፣","poem":2},{"lineBreak":true},{"text":"አት ዹጉማን አባኬኘ፤","poem":2},{"text":"ያ ዋቀዮ፣ አት አባኬኘ፤","poem":1},{"text":"ፉራንኬኘ ዱሩማ ጀልቀቤ መቃኬት።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ያ ዋቀዮ፣ አት ማሊፍ አከ ኑ ከራኬራ በድኑፊ","poem":1},{"text":"አከ ገራንኬኘ ጀባቴ ኑ ስ ሶዳቹ ድድኑ ኑ ጎተ?","poem":2},{"text":"ሰበቢ ገርቦተኬ፣","poem":1},{"text":"ጎሶተ ሀንዹራኬ ተአኒቲፍ ጄዺ ዴብእ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሰብንኬ ዬሮ የርቱፍ እዶኬ ቁልቁሉ ዻሌ ቱሬ፤","poem":1},{"text":"አመ ገሩ ዲኖትንኬኘ እዶኬ ቁልቁሉገድ ዽዺታ ጅሩ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ኑ ዱሩማ ጀልቀብኔ ከኑመኬት፤","poem":1},{"text":"አት ገሩ እሳን ህንቡልችኔ፤","poem":2},{"lineBreak":true},{"text":"እሳንስ መቃኬቲን ህንዋመምኔ።","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/62.json","previousChapterAudioLinks":{},"numberOfVerses":19}