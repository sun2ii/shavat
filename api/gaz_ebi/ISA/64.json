{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":64,"content":[{"type":"verse","number":1,"content":[{"text":"አከ ቱሉወን ፉለኬ ዱረት ራፈመኒፍ፣","poem":1},{"text":"ማሎ አት ኡቱ ሰሚወን ተርሳፍቴ ገድ ቡቴ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አኩመ እብድ ሀንጠጢ ጉቤ፣ ብሻን ደንፍሱ ሰነ፣","poem":1},{"text":"አከ መቃንኬ ዲኖተኬ ብረት ቤከሙፍ","poem":2},{"text":"ገድ ቡኢቲ አከ ሰቦትን ፉለኬ","poem":1},{"text":"ዱረት ሆለተን ጎዽ!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አት ዬሮ ዋን ሶዳችሳ ኑ ህንያድን ሆጄቴት ገድ ቡቴ፤","poem":1},{"text":"ቱሉወንስ ፉለኬ ዱረት ሆለተን።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ስ መሌ ዋቀ ወረ እሰ አብደተኒፍ ዻበቱ፣","poem":1},{"text":"በረ ዱሪቲ ጀልቀቤ ነምን ቶኮዩ ህንዸጌኜ፤","poem":2},{"text":"ዮካን ጉር ቶኮዩ ህንቀልቤፈትኔ፤","poem":1},{"text":"እጅ ቶኮዩ ህንአርግኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አት ወረ ገመቹዻን ዋን ቶላ ሆጄተን","poem":1},{"text":"ከኔን ከራኬ ያደተን ገርጋሩፍ ንዹፍተ።","poem":2},{"text":"ገሩ ዮሙ ኑ እቱመ ፉፍኔ","poem":1},{"text":"ጩቡ ሆጄትኔት አት ንዼከምቴ።","poem":2},{"lineBreak":true},{"text":"ዮስ ኑ አከምት ፈዩ ደንዴኘሬ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሁንድኬኘ አከ ነመ ቁልቁልነ ህንቀብኔ ታኔረ፤","poem":1},{"text":"ሆጂን ቀጄሉማኬኛ ሁንድስ አከ ሁጩ ጡራኡማት፤","poem":2},{"text":"ሁንድኬኘ አኩመ ባላ ጮለግኔ፤","poem":1},{"text":"ጩቡንኬኘስ አኩመ ቡቤ ሀጣኤ ኑ ፉዸቴ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ነምን መቃኬ ዋመቱ ቶኮዩ ህንጅሩ፤","poem":1},{"text":"ዮካን ነምን ስ ቀበቹፍ ጨራቁ ህንጅሩ፤","poem":2},{"text":"አት ፉለኬ ኑ ዾክፈቴ","poem":1},{"text":"ሰበቢ ጩቡኬኛቲፍስ ኑ ፍጤርታቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ተኡስ ያ ዋቀዮ፣ አት አባኬኘ።","poem":1},{"text":"ኑ ሱጴዸ፤ አትሞ ዾፍቱ ሱጴት፤","poem":2},{"lineBreak":true},{"text":"ሁንድኬኘ ሆጂ ሀርከኬቲት።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ያ ዋቀዮ፣ አት አከ መሌ ህንዼከምን፤","poem":1},{"text":"ጩቡኬኘስ በረ በራን ህንያደትን።","poem":2},{"text":"ማሎ ስ ከዸትና፣ ፉለኬ ኑፍ ዴብስ፤","poem":1},{"text":"ኑ ሁንድኑ ሰበኬቲ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"መጋላወንኬ ቁልቁሎትን ኦነኒሩ፤","poem":1},{"text":"ጥዮንዩ ኦንቴርት፤ ዬሩሳሌምስ ዱዋ ሀፍቴርት።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"መን ቁልቁሉማኬኘ ቁልቁልቺፊ ኡልፍነ ቀቤስ፣","poem":1},{"text":"እዶን አቦቲንኬኘ እት ስ ገለቴፈተን ሱን እብዳን ጉበሜረ፤","poem":2},{"lineBreak":true},{"text":"ወን ኑ እት ገመትኑ ሁንድስ በርበዴፈሜረ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ያ ዋቀዮ፣ አት ወንቶተ ከኔን ሁንደጨልኡመ ጄቴ እላልታ?","poem":1},{"text":"አት ጨልእስቴ አከ መሌ ኑ አደብዳ?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/63.json","previousChapterAudioLinks":{},"numberOfVerses":12}