{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":65,"content":[{"type":"heading","content":["ሙርቲፊ ፈይነ"]},{"type":"verse","number":1,"content":[{"text":"“አን ወረ ነ ህንእያፈትንት ነንሙልአዼ፤","poem":1},{"text":"ወር ነ ህንበርባድንስ ነ አርገተን።","poem":2},{"text":"አን ሰበ መቃኮ ህንዋመትኒን፣","poem":1},{"text":"‘አን አሰን ጅረ፤ አን አሰን ጅረ’ ነንጄዼ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አን ጉያ ጉቱ ገረ ኡመተ ድዳ ተኤት፣","poem":1},{"text":"ከን ከራ ጋሪ ህንተእንረ ዴሙ፣","poem":2},{"text":"ከን ያደ ኦፊሳ ዱካ ቡኡፍ","poem":1},{"text":"ሀርከኮ ነንድሪርፈዼ፤","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እሳን ሰበ እዶ ብቅልቱ ኬሰት ኣርሳ ዽኤሱዻን፣","poem":1},{"text":"እዶ ኣርሳ ከን ጡቢረትስ እጣነ ኣርሱዻን፣","poem":2},{"text":"ኡቱ ገርገር ህንኩትን፣ ኡቱመ አን አርጉ","poem":1},{"text":"ዼከምሳፍ ነ ከካሰኒዸ፤","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እሳን ወረ አዋለ ግዱ ተታአኒ","poem":1},{"text":"ለፈ ዾክሳ ቡለኒዸ፤","poem":2},{"text":"ወረ ፎን ቦዬ ኛተኒ","poem":1},{"text":"ኦኮቴንሳኒ ብሻን ፎን ጡራኣ ባቱዸ፤","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እሳን ወረ፣ ‘አች ፈጋዹ፤ ነት ህንዽኣትን፤","poem":1},{"text":"አን ስ ጫላ ቁልቁሉዻቲ!’ ጄዸኒዸ።","poem":2},{"text":"ሰብን አከሲ ፉኛንኮ ኬሰት አኩመ ኣራ፣","poem":1},{"text":"አኩመ እብደ ጉያ ጉቱ ቦበኡት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“ኩኖ፣ ወን ኩን አከነ ጄዸሜ ፉለኮ ዱረት በሬፈሜረ፦","poem":1},{"text":"አን ህንጨልእሱ፤ ገሩ ገቲ ሆጂሳኒ ጉቱ ነንኬናፍ፤","poem":2},{"lineBreak":true},{"text":"ዹጉማንስ ቆመት እሳን ነንባችሰ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኩንስ ጩቡኬሰኒፊ ጩቡ አቦቲኬሰኒት”","poem":1},{"text":"ጄዸ ዋቀዮ።","poem":2},{"text":"“እሳን ቱሉወንረት ኣርሳ ዽኤሰኒ፣","poem":1},{"text":"ጋረንረት ዋን ነ አረብሰኒፍ፣","poem":2},{"text":"አን ሆጂሳኒ ከን ዱሪቲፍ፣","poem":1},{"text":"ከፈልቲ ጉቱ እሳኒፍን ኬነ።”","poem":2}]},{"type":"verse","number":8,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“አኩመ ዬሮ ሁርቡ ወይኒ ኬሰ ጩንፋን ጅሩት፣","poem":1},{"text":"ነሞትን፣ ‘አመዩ ኤበቱ ኬሰ ጅራቲ፣","poem":2},{"lineBreak":true},{"text":"ህንበሌስና’ ጄዸን ሰነ፣","poem":2},{"text":"አንስ ተጃጅልቶተኮቲፍ አከሱመ ነንጎዸ፤","poem":1},{"text":"እሳን ሁንደስ ህንበሌሱ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አንስ ያቆብ ኬሳ ሰኚ ቶኮ፣","poem":1},{"text":"ይሁዳ ኬሳሞ ወረ ቱሉወንኮ ዻለን ነንብቅልቸ፤","poem":2},{"text":"ሰብንኮ ፍለተማን ቱሉወን ሰነ ዻለ፤","poem":1},{"text":"ተጃጅልቶትንኮስ አች ንጅራቱ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሰበኮ ከን ነ በርባዱፍ","poem":1},{"text":"ሻሮን ለፈ ቡሻዬን እት ቦበአን፣","poem":2},{"lineBreak":true},{"text":"ሱሉል ኣኮርሞ ለፈ ሎን ቦቆተን ንተአን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ገሩ እስን ወረ ዋቀዮን ዺፍተኒ","poem":1},{"text":"ቱሉኮ ቁልቁሉ ደገተን፣","poem":2},{"text":"ከኔን ዋቀ ‘ምልኪ’ ጄዸሙፍማዲ ቆጴስተኒ፣","poem":1},{"text":"ዋቀ፣ ‘ህሬ’ ጄዸሙፍሞ ዽባዩ ኩባያት ጉተን፣","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አን እርባተ ጎራዴ እስነን ጎዸ፤","poem":1},{"text":"እስን ሁንድስ ቀለሙፍ ገድ ጄቱ፤ አን እስን ዋሜን ቱሬ፤","poem":2},{"text":"እስን ገሩ ነ ጀላ ህንኦዋትኔ፤","poem":1},{"text":"አን ዱበዼን ቱሬ፤ እስን ገሩ ነ ህንዸጌፈትኔ።","poem":2},{"text":"እስን ፉሉመኮ ዱረት ዋን ሀማ ሆጄተኒ","poem":1},{"text":"ዋን ነ ህንገመቺፍኔ ፍለተን።”","poem":2}]},{"type":"verse","number":13,"content":["ከናፉ ዋቀዮ ጎፍታን አከነ ጄዸ፦",{"text":"“ገርቦንኮ ንኛቱ፤","poem":1},{"text":"እስን ገሩ ንቤሎፍቱ፤","poem":2},{"text":"ገርቦንኮ ንዹጉ፤","poem":1},{"text":"እስን ገሩ ንዼቦቱ፤","poem":2},{"text":"ገርቦንኮ ንገመዱ፤","poem":1},{"text":"እስን ገሩ ንቃኖፍቱ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ገርቦንኮ","poem":1},{"text":"ገመቹ ገራራ መዴን ንፋርፈቱ፤","poem":2},{"text":"እስን ገሩ፣","poem":1},{"text":"ዋን ገራንኬሰን ሚዸሜፍ ንቦሱ፤","poem":2},{"lineBreak":true},{"text":"ዋን ሀፉርኬሰን ገዴፍ ንወዋቱ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ፍለተምቶትንኮ መቃ እስን ደበርፈተን ሰነ","poem":1},{"text":"አባርሳፍ እት ፈየደሙ፤","poem":2},{"text":"ዋቀዮ ጎፍታን እስን ፍጠ፤","poem":1},{"text":"ገርቦተሳቲፍ ገሩ መቃ ብራ ንኬነ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ነምን ለፈረት ኤብፈሙ ከምዩ፣","poem":1},{"text":"ዋቀ ዹጋቲን ኤብፈመ፤","poem":2},{"text":"ነምን ለፈረት ከከቱስ፣","poem":1},{"text":"ዋቀ ዹጋቲን ከከተ።","poem":2},{"text":"ረክን ዱሪ ንእራንፈተመ፤","poem":1},{"text":"እጀኮ ዱራስ ንዾከታቲ።","poem":2}]},{"type":"heading","content":["ሰሚወን ሃራፊ ለፈ ሃራ"]},{"type":"verse","number":17,"content":[{"text":"“ኩኖ አን፣ ሰሚወን ሃራፊ","poem":1},{"text":"ለፈ ሃራ ነንኡመ።","poem":2},{"text":"ወን ዱሪ ህንያደተሙ፤","poem":1},{"text":"ዮካን ቀልቢ ነማት ህንዹፉ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እስን ገሩ ዋን አን ኡሙት፣","poem":1},{"text":"በረ በራን ገመዳ እልልቻ፤","poem":2},{"text":"አን ዬሩሳሌምን ገመቹፍ፣","poem":1},{"text":"ሰበሼሞ እልሌፍ ነንኡማቲ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አን ዬሩሳሌምት ነንገመደ፤","poem":1},{"text":"ሰበኮትስ ነንገመደ፤","poem":2},{"text":"ስአች ሰገሌን ቦእቻቲፊ","poem":1},{"text":"እያ እሼ ኬሰት ህንዸገአሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ስአች፣ ዳእምን ጉያ ሙራሰ ቆፈ ጅራቱ፣","poem":1},{"text":"ዮካን ጃርስ ኡሙሪንሳ ሀንቀቱ ቶኮዩ","poem":2},{"lineBreak":true},{"text":"እሼ ኬሰት ህንአርገሙ፤","poem":2},{"text":"ነምን ወጋ ዽበት ዱኡ፣","poem":1},{"text":"አከ ዋን ደርገጉማን ዱኤት ያደመ፤","poem":2},{"text":"ነምን ወጋ ዽበ ሀንቀቴ ቶኮ፣","poem":1},{"text":"አከ ዋን አባረሜት ሄደመ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ነሞትን መነ ንእጃረቱ፤ አች ኬሰስ ንጅራቱ፤","poem":1},{"text":"ወይኒ ዻበቱ፤ እጀሳስ ንኛቱ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ስአች እሳን መነ እጃረኒ ነሞትን ብራ ኬሰ ህንጅራተን፤","poem":1},{"text":"ዮካን እሳን ብቅልቱ ዻበኒ ነሞትን ብራ ህንኛተን።","poem":2},{"text":"ኡሙሪን ሰበኮ፣","poem":1},{"text":"አኩመ ኡሙሪ ሙካ ንተአ፤","poem":2},{"text":"ወር አን ፍለዼ፣","poem":1},{"text":"ሆጂ ሀርከሳኒቲን በረ ዼራ ንገመዱ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"እሳን አከሱማን ህንደዸበን","poem":1},{"text":"ዮካን እጆሌ በላን ኤገቱ ህንዸልቸን፤","poem":2},{"text":"እሳን ሰኚሳኒ ወጅን","poem":1},{"text":"ሰበ ዋቀዮ ኤብሱ ንተኡ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"አን ኡቱ እሳን ነ ህንዋመትን ነንዴብሳፍ፤","poem":1},{"text":"ኡቱ እሳን ዱበተኒ ህንፍጥንስ ነንዸገአ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዬዪፊ ጦባላን ሆላ ወሊ ወጅን ኛቱ፤","poem":1},{"text":"ሌንጭ አከ ሰንጋ ኦካ ኛተ፤","poem":2},{"lineBreak":true},{"text":"ብዮን ገሩ ሶረ ቦፋ ተአ።","poem":2},{"text":"እሳን ቱሉኮ ቁልቁሉ ሁንደረት ሆማ ህንሚዸን","poem":1},{"text":"ዮካን ሆማ ህንበሌሰን”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/64.json","previousChapterAudioLinks":{},"numberOfVerses":25}