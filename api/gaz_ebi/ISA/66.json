{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":66,"content":[{"type":"heading","content":["ሙርቲፊ አብዲ"]},{"type":"verse","number":1,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“ሰሚን ቴሶኮት፤","poem":1},{"text":"ለፍትስ ኤጄተ ሚለኮቲት።","poem":2},{"text":"መን እስን ናፍ እጃርተን ሜሬ?","poem":1},{"text":"ለፍት ቦቆናኮቲ ኤሰ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዋን ከነ ሁንደ ሀርክኮ ህንሆጄትኔ?","poem":1},{"text":"ከናፉ ወንቶትን ኩኔን ሁንድ ከኑመኮት”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2},{"lineBreak":true},{"text":"“አን ገሩ ነመ ገድ ኦፍ ቀቡፊ","poem":1},{"text":"ከን ገራሳ ኬሰት ጋቤ","poem":2},{"lineBreak":true},{"text":"ዱቢኮቲን ሆለቱ ነንእላለ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ገሩ ነምን ኮርመ ቀሉ ከምዩ","poem":1},{"text":"አኩመ ነመ ነመ አጄሱ ቶኮት፤","poem":2},{"text":"ነምን ጦባላ ሆላ ቀሉ ከምዩ","poem":1},{"text":"አኩመ ነመ ሞርመ ሰሬ ጨብሱ ቶኮት፤","poem":2},{"text":"ነምን ኣርሳ ምዻኒ ዽኤሱ ከምዩ","poem":1},{"text":"አኩመ ነመ ዺገ ቦዬ ዽኤሱ ቶኮት፤","poem":2},{"text":"ነምን እጣነ ያደኖ ኣርሱ ከምዩስ","poem":1},{"text":"አኩመ ነመ ዋቀ ቶልፈማ ዋቄፈቱ ቶኮት።","poem":2},{"text":"እሳን ከራ ኦፊሳኒ ፍለተኒሩ፤","poem":1},{"text":"ሉቡንሳኒስ ጡራኡማሳኒት ገመድ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ከናፉ አን ግድራ እሳኒፍ ነንፍለ፤","poem":1},{"text":"ዋን እሳን አከ መሌ ሶዳተንስ እሳንት ነንፍደ።","poem":2},{"text":"ዬሮ አን ዋሜት ነምን ቶኮዩ ነ ጀላ ህንኦዋትኔ፤","poem":1},{"text":"ዬሮ አን ዱበዼት ነምን ቶኮዩህንዸጌፈኔቲ።","poem":2},{"text":"እሳን ፉለኮ ዱረት ዋን ሀማ ሆጄተኒ","poem":1},{"text":"ዋን ነ ህንገመቺፍኔሌ ፍለተን።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ወር ዱቢሳቲን ሆለተን","poem":1},{"text":"ዱቢ ዋቀዮ ዸገኣ፦","poem":2},{"text":"“ኦቦሎትንኬሰን ወር ሰበቢ መቃኮቲፍ እስን ጅበኒ","poem":1},{"text":"እስን አርአን ሱን አከነ ጄዸን፤","poem":2},{"text":"‘አከ ኑ ገመቹኬሰን አርግኑፍ፣","poem":1},{"text":"ሜ ዋቀዮ ሃኡልፋቱ!’","poem":2},{"lineBreak":true},{"text":"ተኡስ እሳን ንቃነኡ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሁርሳ መጋላ ኬሳ ሰነ ዸገኣ፤","poem":1},{"text":"ወጨ መነ ቁልቁሉማ ኬሳ ዸገኣ!","poem":2},{"text":"ወን ኩን ሰገሌ ዋቀዮ ከን ዬሮ እን","poem":1},{"text":"ገቲ ዲኖተሳ ሁንዳፍ መሉ እሳኒፍ ኬኑት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“እሼን ኡቱ ህንጭኒንስፈትን፣","poem":1},{"text":"ንዴስ፤","poem":2},{"text":"ኡቱ ሚጡን ደኡምሳ እሼ ህንቀበን፣","poem":1},{"text":"እልመ ዴስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኤኙቱ ተኩማ ዋን አከሲ ዸገኤ?","poem":1},{"text":"ዋን ተኩማ አከሲ ኤኙቱ አርጌ?","poem":2},{"text":"ብይ ቶኮ ጉዩመ ቶኮት ዸለቹ ደንዴሲ?","poem":1},{"text":"ዮካን ሰብን ዬሩመ ቶኮት ብቅሉ ደንደኣ?","poem":2},{"text":"ጥዮን ገሩ አኩመ ጭኒንስፈቴን፣","poem":1},{"text":"እጆሌሼ ዴሴ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አን ዬሮ ደኡምሳቲን ነመ ገኤ","poem":1},{"text":"ደኡ ነንዾዋ?”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2},{"text":"“አን ደኡምሳን ገኤ","poem":1},{"text":"ገደሜሰ ነንጩፋ?”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቅንኬ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“እስን ወር እሼ ጃለተን ሁንድ፣","poem":1},{"text":"ዬሩሳሌም ወጅን ገመዳ፤ እሼፍስ እልልቻ፤","poem":2},{"text":"እስን ወር እሼፍ ቦሰን ሁንድ፣","poem":1},{"text":"ጉድሳቲ እሼ ወጅን ገመዳ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እስን ሀርመሼ ከን ነመ","poem":1},{"text":"ጀጀቤሱ ሰነ ሆተኒ ንቁፍቱቲ፤","poem":2},{"text":"ኡልፍነሼ ጉዳ ሰነራስ","poem":1},{"text":"ገመቹዻን ንዹግዱ።”","poem":2}]},{"type":"verse","number":12,"content":["ዋቀዮ አከነ ጄዻቲ፦",{"text":"“ኩኖ አን ነጋ አኩመ ብሻን ለጋ፣","poem":1},{"text":"በዻዹማ ሰቦታስ አኩመ ለገ ያኡእሼፍ ነንዸንገላሰ፤","poem":2},{"text":"እስን ንሆቱ፤ ሀርከሼረት ንባተምቱ፤","poem":1},{"text":"ጉዴደሼረሌ ንተጰቱ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አኩመ ሃት ዳእመሼ ኡሩርስቱ ሰነ፣","poem":1},{"text":"አንስ እስነን ኡሩርሰ፤","poem":2},{"lineBreak":true},{"text":"እስንስ ዬሩሳሌም ኬሰት ንኡሩርፈምቱ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"እስን ዮሙ ዋን ከነ አርግተንት ገራንኬሰን ንገመደ፤","poem":1},{"text":"ለፌንኬሰን አከ መርጋ ንሃሮምፈመ፤","poem":2},{"text":"ሀርክ ዋቀዮ አከ ገርቦተሳ ወጅን ጅሩስ ንቤከመ፤","poem":1},{"text":"ዼከምስሳ ገሩ አመጃጆተሳረት ንሙልእፈመ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኩኖ፣ ዋቀዮ እብዳን ንዹፈ፤","poem":1},{"text":"ጋሪወንሳስ አኩመ ቡቤ ሀማት፤","poem":2},{"text":"እን ኣሪሳ ዸእቻን፣","poem":1},{"text":"እፈትናሳሞ አረበ እብዳቲን ገድ ቡሰ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዋቀዮ እብዳፊ ጎራዴሳቲን","poem":1},{"text":"ነሞተ ሁንደረት ሙርቲ ራወታቲ፤","poem":2},{"lineBreak":true},{"text":"ነሞትን ዋቀዮን አጄፈመን ንባይአቱ።","poem":2}]},{"type":"verse","number":17,"content":["“ወር እዶ ብቅልቱ ሴኑፍ ጄዸኒ፣ እሰ ወረ ፎን ቦዬ፣ ፎን ሀንቱታቲፊ ወንቶተ ጅብሲሶ ብራ ኛተን ግዱት አርገሙ ዱካ ቡኡዻን አዳን ኦፍ ባሰኒ ኦፍ ቁልቁሌሰን ወጅን በርበዴፈሙ” ጄዸ ዋቀዮ።"]},{"type":"verse","number":18,"content":["“አን ዋነን ሆጂፊ ያደሳኒ ቤኩፍ፣ ሰቦታፊ አፋኖተ ሁንደ ወልት ቀቡፍ ጄዼ ነንዹፈ፤ እሳንስ ዹፈኒ ኡልፍነኮ ንአርጉ።"]},{"type":"verse","number":19,"content":["“አን ግዱሳኒ መለቶ ነንካአ፤ ሀምባወን ኬሳ ነሞተ ቶኮ ቶኮ ገረ ሰቦታ ጄቹንስ ገረ ተርሺሽ፣ ጱሊፊ ገረ ሉድ ወረ ጥያን ሎለን፣ ገረ ቱባሊፊ ያዋን አከሱመስ ገረ ብዮተ ብሻን ግዱ ፈጎ ጅረን ከኔን ዋኤኮ ህንዸገእኒ ዮካን ኡልፍነኮ ህንአርግኒት ነንኤርገ። እሳንስ ሰቦተ ግዱት ኡልፍነኮ ንለብሱ።"]},{"type":"verse","number":20,"content":["እሳንስ ሰቦተ ሁንደ ኬሳ ኦቦሎተኬሰን ሁንደ አኩመ ኣርሳ ዋቀዮፍ ዽኤፈሙ ቶኮት ፈርዴኒን፣ ጋሪወኒን፣ ሀሮታን፣ ጋንጎሊፊ ጋለወኒን ገረ ቱሉኮ ቁልቁሉት፣ ገረ ዬሩሳሌም ንፍዱ” ጄዸ ዋቀዮ። “እሳንስ አኩመ እስራኤሎን ምአ አከ ሴራት ቁልቁሉ ተኤን ኣርሳ ምዻንሳኒ ገረ መነ ቁልቁሉማ ዋቀዮት ፍደን ሰነት ጀረ ፍዱ።"]},{"type":"verse","number":21,"content":["አንስ እሳን ኬሳ ነሞተ ቶኮ ቶኮ አከ እሳን ሉቦታፊ ሌዎተ ተአኒፍ ነንፍለዸ” ጄዸ ዋቀዮ።"]},{"type":"verse","number":22,"content":["“አኩመ ሰሚን ሃራኒፊ ለፍት ሃራን አን ኡሙ እት ፉፈኒ ፉለኮ ዱረ ጅራተን ሰነ መቃፊ ሰኚንኬሰን እት ፉፈኒ ጅራቱ” ጄዸ ዋቀዮ።"]},{"type":"verse","number":23,"content":["“አያነ ባቲ ቶኮ ሀመ አያነ ባቲ ካኒት፣ ሰንበተ ቶኮ ሀመ ሰንበተ ካኒትስ ሰኚን ነማ ሁንድ ዹፌ ፉለኮ ዱረት ንሰገደ” ጄዸ ዋቀዮ።"]},{"type":"verse","number":24,"content":["“እሳንስ ገድ በአኒ ሬፈ ወረ ነት ፍንጭለኒ ንእላሉ፤ ራሞንሳኒ ህንዱኡ፤ እብድሳኒስ ህንዻሙ፤ እሳንስ ሰኚ ነማ ሁንዳፍ ጅብሲሶ ተኡ።”"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JER/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/65.json","previousChapterAudioLinks":{},"numberOfVerses":24}