{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":8,"content":[{"type":"heading","content":["እሳያሲፊ እጆሌሳ"]},{"type":"verse","number":1,"content":["ዋቀዮ አከነ ናን ጄዼ፤ “ገበቴ ጉዳ ቶኮ ፉዺቲ እሰረት፣ ‘መሄር-ሻላል-ሃሽ-ባዝ’",{"noteId":0},"ጄዺ ቁቤ ቤከማዻን በሬስ።”"]},{"type":"verse","number":2,"content":["አንስ አከ እሳን ዹገ ባቶተ አመነሞ ተአኒፍ ኡርያ ሉብቻፊ ዘካርያስ እልመ ዬቤሬክያ ነንዋመዸ።"]},{"type":"verse","number":3,"content":["አንስ ራጅቲ ብረ ነንገኤ፤ እሼንስ ኡልፎፍቴ እልመ ዴሴ። ዋቀዮ አከነ ናን ጄዼ፤ “መቃሳ መሄር-ሻላል-ሃሽ-ባዝ ጄዺ ሞጋስ።"]},{"type":"verse","number":4,"content":["ኡቱ ሙጫን ኩን ‘ኣቦ’ ዮካን ‘ኣዮ’ ጄቹ ህንቤክን ዱረ ቀቤኝ ደማስቆቲፊ ቦጁን ሰማርያ ሞቲ አሶሪን ፉዸተመ።”"]},{"type":"verse","number":5,"content":["ዋቀዮ አመስ አከነ ጄዼ ነት ዱበቴ፦"]},{"type":"verse","number":6,"content":[{"text":"“ሰብን ኩን ብሻን ሽሎኣ","poem":1},{"text":"ከን ሱተ ያኡ ሰነ ዺሴ","poem":2},{"text":"ሬዚኒፊ እልመ ሬማልያት","poem":1},{"text":"ገመዴራቲ፤","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ከናፉ ጎፍታን፣","poem":1},{"text":"ሎላ ጉዳ ከን ለገ ኤፍራጢስ ጄቹንስ ሞቲ አሶር","poem":2},{"lineBreak":true},{"text":"ኡልፍነሳ ሁንደ ወጅን ሰበ ከነት ፍደ።","poem":2},{"text":"ሎላን ሱንስ ጉቴ ቦኦሳረ ያኤ","poem":1},{"text":"ኤዴደሳ ሁንደረ ዸንገለአ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሎላን ሱንስ ሀመ ሞርመ ገኡት ጉቴ እረ ዸንገለኤ","poem":1},{"text":"ኬሰ ደርቡዻን ዋን ሁንዱማ ሀጣኤ ይሁዳት ጌሰ።","poem":2},{"text":"ያ አማኑኤል!","poem":1},{"noteId":1},{"text":"ቆቾንሳ በልእፈሜ ጉቱማ ብየኬቲ ንሀጉገ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ያ ሰቦተ፣ ቡርኩታኣ!","poem":1},{"text":"እስን ወር ብየ ፈጎ ጅርተን ሁንድ ዸጌፈዻ።","poem":2},{"text":"ወራናፍ ህዸዻ፤ ተኡስ ቡርኩታኣ!","poem":1},{"text":"ወራናፍ ህዸዻ፤ ተኡስ ቡርኩታኣ!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"መርአዻ፤ ገሩ ፋይዳ ህንቀቡ፤","poem":1},{"text":"ከሮርፈዻ፤ ገሩ ፊጣን ህንበኡ፤","poem":2},{"lineBreak":true},{"text":"ዋቅን ኑ ወጅን ጅራቲ።","poem":2}]},{"type":"verse","number":11,"content":["ዋቀዮ ሀርከሳ ጀባ ሰናን ነት ዱበቴ አከ አን ከራ ሰበ ከናረ ህንዴምኔፍ አከነ ጄዼ ነ አኬከቺሴራቲ፦"]},{"type":"verse","number":12,"content":[{"text":"“እስን ዋን ኡመትን ኩን ፍንጭለ ጄዹ","poem":1},{"text":"ሁንዳን ፍንጭለ ህንጄዽና፤","poem":2},{"text":"ዋን እሳን ሶዳተን ህንሶዳትና፤","poem":1},{"text":"ህንራፈምና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ከን እስን አከ ቁልቁሉት እላሉ ቀብደንዋቀዮ ዋን ሁንደ ደንደኡ ቶክቸ፤","poem":1},{"text":"ከን እስን ሶዳቹ ቀብደን እሱመ፤","poem":2},{"lineBreak":true},{"text":"ከን እስን ሆለቹፊ ቀብደንስ እሱመ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እን እዶ ቁልቁሉ ተአ፤","poem":1},{"text":"መኔን እስራኤል ለማኒፍ ገሩ","poem":2},{"text":"እን ዸጋ ነመ ጉፈቺሱ፣","poem":1},{"text":"ከታ ነመ ኩፍሱ ተአ።","poem":2},{"text":"ሰበ ዬሩሳሌምት ገሩ","poem":1},{"text":"እን ክዮፊ ፉታሳ ተአ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሄዱንሳኒ ንጉፈቱ፤","poem":1},{"text":"እሳን ኩፈኒ ጨጨቡ፤","poem":2},{"lineBreak":true},{"text":"ፉታሳ ሴነኒ ቀበሙ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ዹገ በኡምሰ ከነ ወልት ቀብሲስ፤","poem":1},{"text":"ሴረ ከነስ በረቶተኮ ግዱት ቻፓዻን ጩፍ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዋቀዮ መነ ያቆብ ዱራ","poem":1},{"text":"ፉለሳ ዾክፈቴ ሰነ ነንኤገዸ።","poem":2},{"text":"አን እሰ ነንአመነዸ።","poem":1}]},{"type":"verse","number":18,"content":["አኒፊ እጆሌን ዋቀዮ ና ኬኔ ኩኖት። ኑ እስራኤል ኬሰት ዋቀዮ ዋን ሁንደ ደንደኡ ከን ቱሉ ጥዮንረ ጅራቱ ሰናፍ መለቶፊ ፈኬኘ።"]},{"type":"heading","content":["ዱከን እፈት ጅጂረመ"]},{"type":"verse","number":19,"content":["ዮሙ ነምን ቶኮ ዸቃቲ እላልቶታፊ ኤኬር ዱብስቶተ ከኔን ሀሳሰኒፊ ጉንጉመን ዋ ጋፈዻ እስኒን ጄዹት ሰብን ቶኮ ዋቀሳ ጎርሰ ጋፈቹ ህንቀቡ? እሳን ዋኤ ጅራቶታ ማሊፍ ወረ ዱአን ጋፈቱ?"]},{"type":"verse","number":20,"content":["አከ ሴራፊ ዹገ በኡምሰ ሰናት ጅራዻ! እሳን ዮ አከ ዱቢ ከናት ዱበቹ ባተን እፈ በሪ ህንቀበን ጄቹዸ።"]},{"type":"verse","number":21,"content":["እሳን ረክነ ጉዳፊ ቤላን ብየ ኬሰ ጆሩ፤ ዮሙ ቤለአንትስ አከ መሌ ኣረኒ፣ ኦል እላለኒ ሞቲሳኒቲፊ ዋቀሳኒ አባሩ።"]},{"type":"verse","number":22,"content":["ኤርገሲስ ገረ ለፋ እላለኒ ረክነ ጉዳ፣ ዱከናፊ ሁሪ ሶዳችሳ አርጉ፤ እሳንስ ዱከነ ሀማት ደርበተሙ።"]}],"footnotes":[{"noteId":0,"caller":"+","text":"መሄር-ሻላል-ሃሽ-ባዝ ጄቹን ደፊ ቦጅእ፤ አሪፈዹ ሳም ጄቹዸ።","reference":{"chapter":8,"verse":1}},{"noteId":1,"caller":"+","text":"አማኑኤል ጄቹን ዋቅን ኑ ወጅን ጅረ ጄቹዸ።","reference":{"chapter":8,"verse":8}}]},"thisChapterLink":"/api/gaz_ebi/ISA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}