{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ISA","translationId":"gaz_ebi","name":"እሳያስ","commonName":"እሳያስ","title":"ራጂ እሳያስ","order":23,"numberOfChapters":66,"sha256":"facb2a44ef285c458e78c3b7f4f0eb40f3e78a02fd919a9bd75ad65e4f107304","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gaz_ebi/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":9,"content":[{"type":"heading","content":["ሙጫን ኑፍ ዸለቴረ"]},{"type":"verse","number":1,"content":["ወር ረክነ ጉዳ ኬሰ ቱረን ገሩ ስአች ገደ ኬሰ ህንጅራተን። እን ዱራን ብየ ዜቡሎኒፊ ብየ ንፍታሌም ገድ ዴብሴ፤ ገረ ፉልዱራት ገሩ ገሊላ ነሞተ ኦርማ ከን ዮርዳኖሲን ገመ፣ ቀርቀረ ዳንዲ ገላናረ ጅረን ሰነ ንከበጀ።"]},{"type":"verse","number":2,"content":[{"text":"ሰብን ዱከነ ኬሰ ጅራቱ እፈ ጉዳ አርጌረ፤","poem":1},{"text":"ወረ ብየ ዱከነ ልምጢ ኬሰ ጅራተኒፍስ እፍን በኤረ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አት ሰበ ባይእፍቴ","poem":1},{"text":"ገመቹሳኒሌ ጉድፍቴርተ፤","poem":2},{"text":"እሳን አኩመ ኡመትን ዬሮ","poem":1},{"text":"ምዻን ሃመሙት ገመዱ ሰነ፣","poem":2},{"text":"አኩመ ነሞትን ዬሮ ቦጁ ቆደተንት","poem":1},{"text":"ገመደን ሰነ ፉለኬ ዱረት ንእልልቹ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አት አኩመ በረ ምድያን ሞአተሜ ሰና፣","poem":1},{"text":"ዋንጆ እሳንት ኡልፋቴ","poem":2},{"text":"ሶማ ገቲቲሳኒራ","poem":1},{"text":"ኡሌ ጩንቁርሳሳኒሌ ጨጨብስቴርተ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኮጴን ሎልቱን እቲን ዱልቴ ሁንድ፣","poem":1},{"text":"ኡፈትን ዺገ ኬሰ ጩጰሜ ሁንድ","poem":2},{"text":"እብዳን ጉበመ፤","poem":1},{"text":"ቆራን እብዳስ ተአ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሙጫን ኑፍ ዸለቴረ፤","poem":1},{"text":"እልም ኑፍ ኬነሜረ፤","poem":2},{"lineBreak":true},{"text":"ሞቱማን ገቲቲሳረ ጅራተ።","poem":2},{"text":"እንስ ጎርሳ ድንቅሲሳ፣ ዋቀ ጀባ፣","poem":1},{"text":"አባ በረ በራ፣ ሞቲ ነጋ","poem":2},{"lineBreak":true},{"text":"ጄዸሜ ንዋመመ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"በበልእን ሞቱማሳቲፊ","poem":1},{"text":"ነጋንሳ ዹመ ህንቀቡ።","poem":2},{"text":"እንስ ሙርቲ ቀጄላፊ ቀጄሉማዻን","poem":1},{"text":"ሁንዴሴ ጀቤሴ ዻቡዻን","poem":2},{"text":"ዬሮ ሰና ጀልቀቤ በረ በራን","poem":1},{"text":"ቴሶ ዳዊትረ ታኤ ሞቱማሳ ቡልቸ።","poem":2},{"text":"ህናፋን ዋቀዮ ዋን ሁንደ ደንደኡስ","poem":1},{"text":"ዋን ከነ ንራወተ።","poem":2}]},{"type":"heading","content":["ዋቀዮ እስራኤልት ዼከሜ"]},{"type":"verse","number":8,"content":[{"text":"ጎፍታን ዻምሰ ቶኮ ያቆብት ኤርጌረ፤","poem":1},{"text":"ኩንስ እስራኤልረ ቡአ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኡመትን ሁንድ፣","poem":1},{"text":"ኤፍሬሚፊ ጅራቶትን ሰማርያ ዋን ከነ ንቤኩ፤","poem":2},{"lineBreak":true},{"text":"እሳንስ ኦፍ ቱሉፊ ገራ ኦፍ ጀጁን አከነ ጄዹ፤","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“ጡቢወን ዲገመኒሩ፤","poem":1},{"text":"ኑ ገሩ ዸጋ ሶፈሜን ዴብስኔ እጃረ፤","poem":2},{"text":"ሙኬን ሀርቡ ሙርሙረመኒሩ፤","poem":1},{"text":"ኑ ገሩ ብርብርሰ እዶ ቡስነ።”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ከናፉ ዋቀዮ አመጃጆተ ሬዚን እሳንት ጀቤሴ፤","poem":1},{"text":"ዲኖተሳኒሌ እሳንት ከካሴ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ወር ሶርያ ገመ በኣቲን፣ፍልስጤሞትንሞ ገመ ልጣቲን","poem":1},{"text":"አፋን በነተኒ እስራኤልን ልቅምሰን።","poem":2},{"lineBreak":true},{"text":"ከነ ሁንዳንሌ ዼከምስሳ ህንቀበኖፍኔ፤","poem":1},{"text":"ሀርክሳስ አመዩ አኩመ ኦል ካፈሜት ጅረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ሰብን ሱን ገሩ ገረ እሰ እሳን ዸኤ ሰናት ህንዴብኔ","poem":1},{"text":"ዮካን ዋቀዮ ዋን ሁንደ ደንደኡ ህንበርባደትኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ከናፉ ዋቀዮ እስራኤልራ መታፊ ኤጌ ኩተ፤","poem":1},{"text":"ደሜ ሜጢቲፊ ሸምበቆ ጉዩመ ቶኮን በሌሰ፤","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ማንጉዶትኒፊ ከበጀሞትን መታዸ፤","poem":1},{"text":"ራጆትን ሶበ በርሲሰንሞ ኤጌዸ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ነሞትን ሰበ ከነ ቀጄልቸን እሳን ዶጎጎርሱ፤","poem":1},{"text":"ወር እሳኒን ቀጄልፈመንስ ከራራ በዱ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ከናፉ ጎፍታን ደርገጎተት ህንገመዱ","poem":1},{"text":"ዮካን እጆሌ አባ ህንቀብኔፊሃዾተ ህዬሳቲፍ ህንነኡ፤","poem":2},{"text":"ነምን ሁንድኑ ከን ዋቀ ህንሶዳትኔፊ ሀማዻቲ፤","poem":1},{"text":"አፋን ሁንድኑስ ሀማ ዱበተ።","poem":2},{"lineBreak":true},{"text":"ከነ ሁንዳንሌ ዼከምስሳ ህንቀበኖፍኔ፤","poem":1},{"text":"ሀርክሳስ አመዩ አኩመ ኦል ካፈሜት ጅረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ሀምን ዹጉማን አከ እብዳ ቦበአ፤","poem":1},{"text":"እን ሶኮሩፊ ቆራቲሌ ጉቤ በሌሰ፣","poem":2},{"text":"ቦሶነ ጎቡስ ንቀበተ፤","poem":1},{"text":"አኩመ ኣረ ኦል በኡትስ ኦል በአ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዼከምሰ ዋቀዮ ዋን ሁንደ ደንደኡቲንለፍት ንጉበት፤","poem":1},{"text":"ነሞትንስ ቆራን እብዳ ተኡ፤","poem":2},{"lineBreak":true},{"text":"ነምን ከምዩ ኦቦሌሰሳ ኦልቹ ህንደንደኡ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ከራ ምርጋቲን ንቡተቱ፤","poem":1},{"text":"ገሩ ቤለ ህንበአን፤","poem":2},{"text":"ከራ ብታቲን ንኛቱ፤","poem":1},{"text":"ገሩ ህንቁፈን።","poem":2},{"text":"ቶኮን ቶኮንሳኒ ፎን ኣንቴሳ ኛተ፤","poem":1}]},{"type":"verse","number":21,"content":[{"text":"ምናሴን ኤፍሬምን ኛተ፤ ኤፍሬምስ ምናሴ ኛተ፤","poem":2},{"lineBreak":true},{"text":"እሳን ቶኩማዻን ይሁዳት ገረገሉ።","poem":2},{"lineBreak":true},{"text":"ከነ ሁንዳንሌ ዼከምስሳ ህንቀበኖፍኔ፤","poem":1},{"text":"ሀርክሳስ አመዩ አኩመ ኦል ካፈሜት ጅረ።","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}