{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JDG","translationId":"gaz_ebi","name":"አቦቲ ሙርቲ","commonName":"አቦቲ ሙርቲ","title":"ክታበ አቦቲ ሙርቲ","order":7,"numberOfChapters":21,"sha256":"e4229e4756bbdc2cd05293374452b2f33d2636f01b895e922950af591695f156","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/gaz_ebi/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":5,"content":[{"type":"heading","content":["ፋርፈትና ዴቦራ"]},{"type":"verse","number":1,"content":["ጋፈስ ዴቦራፊ ባራቅ እልም አቢኖአም አከነ ጄዸኒ ፋርፈተን፦"]},{"type":"verse","number":2,"content":[{"text":"“ዮሙ እልማን ሞቶታ እስራኤልን ሆገነን፣","poem":1},{"text":"ዮሙ ሰብን እስራኤልስ ጃለቴ ኦፍ ኬኑት","poem":2},{"lineBreak":true},{"text":"ዋቀዮን ገለቴፈዻ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“ያ ሞቶተ፣ ዋን ከነ ዸገኣ! ቡልችቶትንስ ዸጌፈዻ!","poem":1},{"text":"ዋቀዮን ነንፋርፈዸ፤ አመሌ ነንፋርፈዸ፤","poem":2},{"lineBreak":true},{"text":"ዋቀዮ ዋቀ እስራኤሊፍ ነንዌድሰ።","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“ያ ዋቀዮ፣ ዬሮ አት ብየ ሴኢሪ ባቴ፣","poem":1},{"text":"ዬሮ አት ብየ ኤዶሚ ካቴ፣","poem":2},{"text":"ለፍት ንሶቾቴ፤ ሰሚወንስ ቦካ፣","poem":1},{"text":"ዱሜሶትንስ ብሻን ገድ ሮብሰን።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ቱሉወን ፉለ ዋቀዮ ዋቀ ሲና ዱረት፣","poem":1},{"text":"ፉለ ዋቀዮ ዋቀ እስራኤል ዱረት ንራፈመን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“በረ እልመ አናት፣ ጀበነ ሸምጋር፣","poem":1},{"text":"በረ ያኤል ኬሰ ዳንዲወን ንኦነን፤","poem":2},{"lineBreak":true},{"text":"ከራ ዴምቶትንስ ዳንዲ ጀጀልኣረ ዴመን።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሀመ አን ዴቦራን፣","poem":1},{"text":"ሃዸ ተኤ እስራኤሊፍ ከኡት፣","poem":2},{"lineBreak":true},{"text":"ገንዶትን እስራኤል ዱዋ ሀፉ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዮሙ እሳን ዋቆተ ሃራ ፍለተንት፣","poem":1},{"text":"ወራን ሀመ ከረ መጋላት ዹፌ፤","poem":2},{"text":"ጋቸን ዮካን ኤቦን ቶኮ፣","poem":1},{"text":"እስራኤሎተ ኩመ አፉርተመ ግዱት ህንአርገምኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ገራንኮ ቡልችቶተ እስራኤል ከኔን ፌዺዻን","poem":1},{"text":"ሰበ ግዱት አርገመን ወጅን ጅረ።","poem":2},{"lineBreak":true},{"text":"ዋቀዮን ሌልሳ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“እስን ወር ሀሮተ አዳዲ ያበተን፣","poem":1},{"text":"ወር ኮራ በለዲ ቀቡረ ቴሰን፣","poem":2},{"lineBreak":true},{"text":"ወር ከራረ ዴምተን ሁበዻ፤","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሰገሌ ፋርፈቶታ ዸገኣ።","poem":1},{"text":"እሳን ሆጂ ቀጄሉማ ዋቀዮ፣","poem":2},{"lineBreak":true},{"text":"ሆጂ ቀጄሉማ ሎልቶትንሳ እስራኤል ኬሰት ጎዸን ኦዴሱ።","poem":2},{"lineBreak":true},{"text":"“ኤርገሲ ሰቦትን ዋቀዮ፣","poem":1},{"text":"ገረ ከረ መጋለቲት ገድ ቡአን።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"‘ያ ዴቦራ! ደመቅ፤ ደመቅ፤","poem":1},{"text":"ደመቅ፤ ደመቅ፤ ፋርፈናስ ፋርፈዹ!","poem":2},{"text":"ያ ባራቅ! ደመቅ፤","poem":1},{"text":"ያ እልመ አቢኖአም ቦጅአምቶተኬ ቦጅኢ ፉዸዹ።’","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ነሞትን ሀፈንስ፣ ገረ ወረ ጉርጉዳት ገድ ቡአን፤","poem":1},{"text":"ሰብን ዋቀዮስ፣ አከ ሎልቱ ጀባት ገረኮ ዹፌ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ወር ህድሳኒ አማሌቅ ኬሰ ጅሩ ቶኮ ቶኮስ ኤፍሬም ዹፈን፤","poem":1},{"text":"ቤንያምስ ነሞተ ስ ዱካ ቡአን ወጅን ቱሬ።","poem":2},{"text":"አጀጆትን ሎልቶተ ማኪር፣","poem":1},{"text":"ወር ቦኩ አጀጁ ቀበተንስ ዜቡሎኒ ገድ ቡአን።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሀንገፎትን ይሳኮር ዴቦራ ወጅን ቱረን፤","poem":1},{"text":"ይሳኮርስ ባራቅ ወጅን ቱሬ፤","poem":2},{"lineBreak":true},{"text":"እንስ ባራቅ ወጅን ገረ ሱሉላት ገድ ቡኤ።","poem":2},{"text":"ጎሰ ሩቤን ግዱ፣","poem":1},{"text":"ቆረትኖ ያዳ ጉዳቱ ቱሬ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አት ማሊፍ መርአቹሳኒ ዸገኡፍ ጄቴ","poem":1},{"text":"ጎለ ቡሻዬ ኬሰ ቱርቴ?","poem":2},{"text":"ጎሰ ሩቤን ግዱ፣","poem":1},{"text":"ቆረትኖ ያዳ ጉዳሳቱ ቱሬ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ግልኣድ ዮርዳኖስ ገመ ታኤ፤","poem":1},{"text":"ዳን ማሊፍ ዶኒወን ኬሰት ሀፌ?","poem":2},{"text":"ኣሼር ቀርቀረ ገላናት ሀፌ፤","poem":1},{"text":"ቡፈተሳ ኬሰስ ቱሬ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሰብን ዜቡሎን ዱኣፍ ኦፍ ሳጥሌ፤","poem":1},{"text":"ንፍታሌምስ ጋረን ብየሳረት አከሱመ ጎዼ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“ሞቶትን ዹፈኒ ሎለን፤","poem":1},{"text":"ሞቶትን ከነኣንስ ተአናክት","poem":2},{"text":"ብሻኖተ ሜግዶ ብረት ሎለን፤","poem":1},{"text":"ቦጁ ሜቲ ቶኮሌ ህንፉዸትኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ሰሚ ኬሳ ኡርጂወን ንሎለን፤","poem":1},{"text":"አዴምሰሳኒረትስ ሲሳራዻን ሎለን።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ለግን ዱሪ፣ ለግን ቂሾን፣","poem":1},{"text":"ለግን ቂሾን ሱን ሀጣኤ እሳን ፉዸቴ።","poem":2},{"lineBreak":true},{"text":"ያ ሉቡኮ፣ ጀባዹ ፉል ዱረት ዴም!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ኮቴን ፈርዴኒ ጉድሴ ድድቼ፤","poem":1},{"text":"ንጉሉፈን፤ ጀቤሰኒስ ጉሉፈን።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ኤርገማን ዋቀዮስ፣ ‘ሜሮዝን አባራ።","poem":1},{"text":"ሰበሼስ ጀቤሳቲ አባራ፤","poem":2},{"text":"አከ ዋቀዮ ወረ ጀጀቦት ከኡ ገርጋሩዻፍ፣","poem":1},{"text":"እሳን ዋቀዮን ገርጋሩዻፍ ህንዹፍኔቲ’ ጄዼ።","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“ያኤል ኒቲን ሄቤር ቄንቻ ሱን","poem":1},{"text":"ዱበርቶተ ሁንደ ኬሳ ሃኤብፈምቱ፤","poem":2},{"lineBreak":true},{"text":"እሼን ዱበርቶተ ዱንካነ ኬሰ ጅራተን ሁንደ ኬሳ ሃኤብፈምቱ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"እን ብሻን ከዸቴ፤ እሼንሞ ኣነን ኬንቴፍ፤","poem":1},{"text":"ቀቤ ኡልፍናት እትቱ ዽኤስቴፍ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ሀርከሼ ገረ ቆፎ ዱንካናት ሂጠቴ፤","poem":1},{"text":"ሀርከሼ ምርጋቲን ቡሩሰ ፉዸቴ፤","poem":2},{"text":"እሼንስ ሲሳራ ዾፍቴ መታሳ ቡሩቅስቴ፤","poem":1},{"text":"ወራንቴስ እሌሳ ኬሰ ፉላፍቴ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"እንስ ሚለሼ ጀለት ጎምብፈሜ፤","poem":1},{"text":"ኩፌ ድሪሬስ።","poem":2},{"text":"ሚለሼ ጀለት ጎምብፈሜ፤ ንኩፌ፤","poem":1},{"text":"እዶ ጎምብፈሜትስ ኩፌ ዱኤ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“ሃት ሲሳራ ፎዳ ኬሳን ገድ እላልቴ፤","poem":1},{"text":"ቃወ ኬሳንስ እይቴ፣","poem":2},{"text":"‘ጋሪንሳ ማሊፍ ዹፉፍ ለፈረ ሀርክፈቴ?","poem":1},{"text":"ድድቹን ጋሪወንሳ ማሊፍ ቱሬ?’ ጄቴ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ዱበርቶተሼ ኬሳ እሼን ኦጌቲን ዴቢ ኬንቴፍ፤","poem":1},{"text":"ተኡስ እሼን ኦፉመሼቲን ዴብፍቴ፣","poem":2}]},{"type":"verse","number":30,"content":[{"text":"‘እሳን ቦጁ አርገተኒ አዳን ቆደቹት ጅሩ ምቲ?","poem":1},{"text":"ቶኮን ቶኮን ነማ ዱበርቲ ቶኮ ቶኮ","poem":2},{"lineBreak":true},{"text":"ዮካን ለመ ለመ አርገተ ምቲ?","poem":2},{"text":"ሲሳራዻፍ ኡፈትን ቦጁ ከን ሀሉዻን ፋዬፈሜ፣","poem":1},{"text":"ኡፈትን ሀሉዻን ሚዸግፈሜ ሆዸሜ፣","poem":2},{"lineBreak":true},{"text":"ሞርመኮቲፍሞ ኡፈተ አከ መሌ","poem":2},{"text":"ሚዸግፈሜ ሆዸሜ ቆዱ ምቲ?","poem":1},{"text":"ኩን ሁንድ ቦጁዸ።’","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“ከናፉ ያ ዋቀዮ፣ ዲኖትንኬ ሁንድ ሃበርበዳአን!","poem":1},{"text":"ወር ስ ጃለተን ገሩ አከ ቢፍቱ፣","poem":2},{"lineBreak":true},{"text":"እሼ ሁምነ ጉቱን ባቱ ሰና ሃተአን።”","poem":2},"ኤርገሲ ብየቲን ወጋ አፉርተመ ነጋ አርገቴ።"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}