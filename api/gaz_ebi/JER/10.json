{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_ebi","name":"ኤርምያስ","commonName":"ኤርምያስ","title":"ራጂ ኤርምያስ","order":24,"numberOfChapters":52,"sha256":"e08276404fb1cf1f464d515eb4d9024ff6266c1a4a4283b37b28fd31b4fd4e55","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_ebi/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":10,"content":[{"type":"heading","content":["ዋቀዮፊ ዋቆተ ቶልፈሞ"]},{"type":"verse","number":1,"content":["ያ መነ እስራኤል፣ ዋን ዋቀዮ እስኒን ጄዹ ዸገኣ።"]},{"type":"verse","number":2,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“እስን ከራ ሰቦተ ኦርማ ህንበረትና፤","poem":1},{"text":"ሰቦትን ኦርማ እሳን ሶዳተንዩ","poem":2},{"lineBreak":true},{"text":"እስን መለቶወን ሰሚ ህንሶዳትና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"በርቴን ኡመቶታ ፋይዳ ህንቀቡ፤","poem":1},{"text":"እሳን ቦሶነ ኬሳ ሙከ ሙሩ፤","poem":2},{"lineBreak":true},{"text":"ኦጌስ ሆጂ ሀርካሞ ቆቶዻን ብፈ እት ባሰ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እሳንስ ሜቲፊ ወርቄዻን ሚዸግሱ፤","poem":1},{"text":"አከ እን ህንሶቾኔፍ","poem":2},{"lineBreak":true},{"text":"ቡሩሳፊ ምስማራን ወልት ቀብሲሱ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዋቆንሳኒ ቶልፈሞን","poem":1},{"text":"አኩመ ፈኬቲ እቲን ዋ ሶዳችሰን","poem":2},{"text":"ከን ለፈ ቆቲሳ ቡቄ ኬሳ ሰነ ዱበቹ ህንደንደአን፤","poem":1},{"text":"እሳን ዋን ዴሙ ህንደንዴኜፍ ባተሙ ቀቡ።","poem":2},{"text":"ሰበቢ እሳን ነመ ሚዹ","poem":1},{"text":"ዮካን ዋን ጋሪ ቶኮዩ ሆጄቹ ህንደንዴኜፍ","poem":2},{"lineBreak":true},{"text":"እሳን ህንሶዳትና።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ያ ዋቀዮ ከን አከኬቲ ቶኮዩ ህንጅሩ፤","poem":1},{"text":"አት ጉዳዸ፤","poem":2},{"lineBreak":true},{"text":"መቃንኬስ ሁምነ ጉዳ ቀበ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ያ ሞቲ ሰቦታ ኤኙቱ ስ ህንሶዳትኔ?","poem":1},{"text":"ኩን ሲፍ ንመላቲ።","poem":2},{"text":"ኦጌዪ ሰቦታ ሁንደ ኬሳ፣","poem":1},{"text":"ሞቱሞተሳኒ ሁንደ ኬሳስ","poem":2},{"lineBreak":true},{"text":"ከን አከኬቲ ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"እሳን ሁንድኑ ቀልቢ ህንቀበን፤ ጎዎተስ፤","poem":1},{"text":"እሳን ዋቆተ ቶልፈሞ ሙኬኒ ከኔን ፋይዳ ህንቀብኔን ቀጄልፈሙ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሜቲን ቱመሜ ተርሺሺ፣","poem":1},{"text":"ወርቄንሞ ኡፋዚ ፍደመ።","poem":2},{"text":"ወን ኦጌስ ሆጂ ሙካቲፊ ቱምቱን ወርቄ ሆጄተን፣","poem":1},{"text":"ወን ሆጄቶተ ኦጉማ ቀበኒን ሆጄተመን ሁንድ","poem":2},{"lineBreak":true},{"text":"ሀሉ ጩቁሊሳፊ ዲማ ዺልጌ ኡፍፈመኒሩ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዋቀዮ ገሩ ዋቀ ዹጋት፤","poem":1},{"text":"እን ዋቀ ጅራታ፣ ሞቲ በረ በራት።","poem":2},{"text":"ዬሮ እን ዼከሙት ለፍት ንሆለት፤","poem":1},{"text":"ሰቦትንስ ዼከምሰሳ ዱረ ዻበቹ ህንደንደአን።","poem":2}]},{"type":"verse","number":11,"content":["“እስን ዋን ከነ እሳንት ህማ፤ ‘ዋቆትን ሰሚፊ ለፈ ህንኡምን ኩኔን ለፈራፊ ሰሚ ጀላ ንበርበዳኡ።’ ”"]},{"type":"verse","number":12,"content":[{"text":"ዋቅን ገሩ ሁምነሳቲን ለፈ ኡሜ፤","poem":1},{"text":"ኦጉማሳቲን አዱኛ ሁንዴሴ፤","poem":2},{"lineBreak":true},{"text":"ሁበትናሳቲንስ ሰሚወን ድሪርሴ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዮሙ እን ቀቀዌሰኡት ብሻኖትን ሰሚ ንሁርሱ፤","poem":1},{"text":"እን አከ ዱሜሶን ዳሪ ለፋቲ ኦል ከአን ንጎዸ።","poem":2},{"text":"እን ቦካ ወጅን በለቄ ንኤርገ፤","poem":1},{"text":"መንኩሳሌሳ ኬሳሞ ቡቤ ንፍደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ቶኮን ቶኮን ነማ ጎዋፊ ከን ቤኩምሰ ህንቀብኔዸ፤","poem":1},{"text":"ቶኮን ቶኮን ቱምቱ ወርቄ ዋቆተ ቶልፈሞሳቲን ቃኔፈመ።","poem":2},{"text":"ፈኪወን እን ቶልቹ ከን ሶባት፤","poem":1},{"text":"እሳን ሀፉረ ባፈተን ኦፍ ኬሳ ህንቀበን።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እሳን ፋይዳ ህንቀበን፤ ሜሻ ቆሳት።","poem":1},{"text":"ዬሮ አደቢንሳኒ ገኡት ንበዱ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እን ቆደ ያቆብ ተኤ ሱን ገሩ አከ ወረ ከና ምት፤","poem":1},{"text":"እን ኡማ ዋን ሁንዱማት፣","poem":2},{"text":"እስራኤልሞ ጎሰ ዻለሳት፤","poem":1},{"text":"መቃንሳስ ዋቀዮ ዋን ሁንደ ደንደኡዸ።","poem":2}]},{"type":"heading","content":["በዲሰ ዹፋ ጅሩ"]},{"type":"verse","number":17,"content":[{"text":"አት ከን መርፈምቴ ጅርቱ፣","poem":1},{"text":"ብየቲ ኬሳ በኡፍ ቀቤኘኬወልት ቀበዹ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዋቀዮ አከነ ጄዻቲ፤","poem":1},{"text":"“ኩኖ፣ አን አመ ወረ ብየቲ ኬሰ ጅራተን","poem":2},{"lineBreak":true},{"text":"ፉርጉግሴ ነንባሰ፤","poem":2},{"text":"አከ እሳን ዽጰተኒፍስ","poem":1},{"text":"ረክነ እሳንት ነንፍደ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ዋን አን ሚዸሜፍ አናፍ ወዮ!","poem":1},{"text":"መዳንኮ ከን ህንፈይኔዸ!","poem":2},{"text":"ተኡስ አን ኦፊኮቲን፣","poem":1},{"text":"“ኩን ዹኩበኮት፤ አንስ እሰ ኦብሱን ቀበ” ነንጄዼ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዱንካንኮ ዲገሜረ፤","poem":1},{"text":"ፉኞንሳ ሁንድስ ጭጭቴረ።","poem":2},{"text":"እልማንኮ ነ ዺሰኒ ሶከኒሩ፤","poem":1},{"text":"እሳን ህንጅረን፤ ነምን ዱንካነ ና ዻቡ፣","poem":2},{"lineBreak":true},{"text":"ዮካን ጎልጋ ና ህዹ ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ትክሶትን ቀልቢ ህንቀበን፤","poem":1},{"text":"ዋቀዮንስ ህንበርባደተን፤","poem":2},{"text":"ከናፉ እሳን ህንምልካአን፤","poem":1},{"text":"ቡሻዬንሳኒ ሁንድኑስ ብትናአኒሩ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ኩኖ፣ ኦዱን፣ ራፈምን ጉዳን ቶኮ","poem":1},{"text":"ብየ ካባቲ ዹፋ ጅረ!","poem":2},{"text":"እንስ መጋላወን ይሁዳ ኦንሴ","poem":1},{"text":"እዶ ዋንጎትን ጅራተን ጎዸ።","poem":2}]},{"type":"heading","content":["ከዸትና ኤርምያስ"]},{"type":"verse","number":23,"content":[{"text":"ያ ዋቀዮ፣ አን አከ ጅሬኝ ነማከን መታሳ ህንተእን ነንቤከ፤","poem":1},{"text":"ነምን አዴምሰሳ ኦፉማን ቀጄልፈቹ ደንደኡ ህንጅሩ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ያ ዋቀዮ ዼከምሰኬቲን ኡቱ ህንተእን፣","poem":1},{"text":"ሙርቲ ቀጄላዻን ነ ስሬስ፤","poem":2},{"lineBreak":true},{"text":"ዮ ከና አቺ አት ነ በሌስታቲ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ሰቦተ ስ ህንቤክኔት","poem":1},{"text":"ኡመተ መቃኬ ህንዋመኔት","poem":2},{"lineBreak":true},{"text":"ዼከምሰኬ ዸንገላስ።","poem":2},{"text":"እሳን ያቆብን ኛተኒሩቲ፤","poem":1},{"text":"ጉቱማን ጉቱትስ እሰ ኛተኒ፤","poem":2},{"lineBreak":true},{"text":"እዶ ጅሬኘሳሌ በርበዴሰኒሩ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JER/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JER/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JER/9.json","previousChapterAudioLinks":{},"numberOfVerses":25}