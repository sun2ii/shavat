{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_ebi","name":"ኤርምያስ","commonName":"ኤርምያስ","title":"ራጂ ኤርምያስ","order":24,"numberOfChapters":52,"sha256":"e08276404fb1cf1f464d515eb4d9024ff6266c1a4a4283b37b28fd31b4fd4e55","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_ebi/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":12,"content":[{"type":"heading","content":["ጉንጉሚ ኤርምያስ"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ ዮሙ አን እየተኮ ፉለኬ ዱረት ዽኤፈዹት","poem":1},{"text":"አት ዬሮ ሁንደ ቀጄላዸ።","poem":2},{"text":"ተኡዩ አን ዋኤ ቀጄሉማኬቲ ነንዱበዸ፤","poem":1},{"text":"ከራን ጀልኦታ ማሊፍ ምልካአ?","poem":2},{"lineBreak":true},{"text":"ወር ህንአመነምኔ ሁንድ ማሊፍ ነጋን ጅራቱ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አት እሳን ዻብዴ፤ እሳንስ ህደ ገድ ፈጌፈተኒሩ፤","poem":1},{"text":"ንጉደቱ፤ እጀስ ንነቀቱ።","poem":2},{"text":"አት ዬሮ ሁንደ አፋንሳኒቲ ህንቡቱ፤","poem":1},{"text":"ገራሳኒራ ገሩ ፈጎ ጅርተ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ተኡስ ያ ዋቀዮ አት ነ ቤክተ፤","poem":1},{"text":"ነ እላልቴስ ያደ አን ሲፍ ቀቡ ንቆርተ።","poem":2},{"text":"አከ ሆላ ቀለሙፍ ዴሙትሀርክሲ እሳን ጌስ!","poem":1},{"text":"ጉያ ቀልማቲፍስ ኮጳት እሳን ባስ!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ብየቲን ሀመ ዮሚት ቦሴ","poem":1},{"text":"መርግ ድሬ ሁንድስ ጎገ?","poem":2},{"text":"ሰበቢ ሀምነ ወረ ብየቲ","poem":1},{"text":"ኬሰ ጅራተኒቲፊ ሰበቢ ነሞትን፣","poem":2},{"text":"“እን ዋን ኑረ ገኣ ጅሩ ህንአርጉ” ጄዸኒፍ","poem":1},{"text":"ሆሪፊ ስምብሮትን ዹመኒሩ።","poem":2}]},{"type":"heading","content":["ዴቢ ዋቀዮ"]},{"type":"verse","number":5,"content":[{"text":"“አት ነሞተ ለፎ ወጅን ፊግዴ ኤርገ","poem":1},{"text":"እሳን ስ ደዸብሲሰኒ፣","poem":2},{"lineBreak":true},{"text":"ፈርዴን ወጅን አከምት ዶርጎሙ ደንዴሰሬ?","poem":2},{"text":"አት ብየ ነጋ ኬሰት ኤርገ ጉፈቴ፣","poem":1},{"text":"ቦሶነ ዮርዳኖስ ኬሰት አከም ታተሬ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኦቦሎትንኬ፣ ማቲን አባኬቲ፣","poem":1},{"text":"እሳንዩ ስ ገነኒሩ፤","poem":2},{"lineBreak":true},{"text":"እሳን ሰገሌ ኦል ፉዸተኒ ስት እዩ።","poem":2},{"text":"ዮ እሳን አፋን ነጋ ስት ዱበተንዩ፣","poem":1},{"text":"አት እሳን ህንአመንን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“አን መነኮ ዺሴረ፤","poem":1},{"text":"ሀንዹራኮስ ገቴረ፤","poem":2},{"text":"አን እሼ ገራንኮ ጃለቱ ሰነ","poem":1},{"text":"ሀርከ ዲኖተሼት ደበርሴ ኬኔረ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሀንዹራንኮ","poem":1},{"text":"አኩመ ሌንጨ ቦሶና ነት ታቴርት።","poem":2},{"text":"እሼን ነት ኣዴ፤","poem":1},{"text":"ከናፉ አን እሼ ጅቤረ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሀንዹራንኮ አከ አላቲ ቡሬ","poem":1},{"text":"ከን አላቲወን ብራ መርሰኒ ሚዸን","poem":2},{"lineBreak":true},{"text":"ቶኮ ነት ህንታኔ?","poem":2},{"text":"ዸቃቲ ብኔንሶተ ቦሶና ሁንደ ወልት ቀባ፤","poem":1},{"text":"አከ እሼ ኛተኒፍስ እሳን ፍዳ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ትክሶትን ሄዱን","poem":1},{"text":"እዶ ዻባ ወይኒኮቲ ንበሌሱ፤","poem":2},{"text":"ቆደኮስ ንዽዺቱ፤","poem":1},{"text":"ቆደ ነት ቶሉስ ንኦንሱ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እሳን እሰ ኦንሱ፤","poem":1},{"text":"እን ኦኔ ገረኮት እየ፤","poem":2},{"text":"ነምን ዽመሳ ቀቡስ","poem":1},{"text":"ዋን ህንጅሬፍ ለፍት ጉቱን ኦኔ ሀፈ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ለፈ ኦል ከኣ ቁላ ገሞጂ","poem":1},{"text":"ኬሳ ሁንደረ በሌስቶትን ንራምእሱ፤","poem":2},{"text":"ጎራዴን ዋቀዮሞጋ ብየቲ ቶኮራ","poem":1},{"text":"ሀመ ሞጋ ካኒት ንፍጣቲ፤","poem":2},{"lineBreak":true},{"text":"ነምን ቶኮዩ ህንሀፉ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እሳን ቀመዲ ፈጫሱ ገሩ ቆራቲ ሃመቱ፤","poem":1},{"text":"ንዸመኡ ገሩ ሆማ ህንአርገተን።","poem":2},{"text":"ሰበቢ ዼከምሰ ዋቀዮ እሰ ጭማ ሰናቲፍ","poem":1},{"text":"ምዻን ገልፈተንት ንቃነኡ።”","poem":2}]},{"type":"verse","number":14,"content":["ዋቀዮ አከነ ጄዸ፤ “አን ኦሎተኮ ሀሞ ከኔን ሀንዹራ አን ሰበኮ እስራኤሊፍ ኬኔ ቀበተን ሁንደ ብየሳኒ ኬሳ ነንቡቅሰ፤ መነ ይሁዳስ እሳን ግዱዻ ነንቡቅሰ።"]},{"type":"verse","number":15,"content":["አን ኤርገን እሳን ቡቅሴ ቦዴ ዴብኤ ነኤፊ ቶኮ ቶኮሳኒ ገረ ሀንዹራሳኒቲፊ ገረ ብየ ኦፊሳኒት ነንዴብሰ።"]},{"type":"verse","number":16,"content":["ዮ እሳን ሃለ ጅሬኘ ሰበኮ አከ ጋሪ በረተኒ አኩመ ዱራን ሰበኮ በኣሊን ከከቹ በርሲሰን ሰነ፣ ‘ዹጋ ዋቀዮ ጅራታ’ ጄቹዻን መቃኮቲን ከከተን፣ እሳን ሰበኮ ግዱት ንሁንዴፈሙ።"]},{"type":"verse","number":17,"content":["ገሩ ዮ ሰብን ከምዩ ና አጀጀሙ ድዴ፣ አን ጉቱማን ጉቱት እሰ ነንቡቅሰ፤ ነንበሌሰስ” ጄዸ ዋቀዮ።"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JER/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JER/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JER/11.json","previousChapterAudioLinks":{},"numberOfVerses":17}