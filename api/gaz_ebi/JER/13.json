{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_ebi","name":"ኤርምያስ","commonName":"ኤርምያስ","title":"ራጂ ኤርምያስ","order":24,"numberOfChapters":52,"sha256":"e08276404fb1cf1f464d515eb4d9024ff6266c1a4a4283b37b28fd31b4fd4e55","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_ebi/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":13,"content":[{"type":"heading","content":["ሰበተ ቁንጬ ተልባራ ሆጄተሜ"]},{"type":"verse","number":1,"content":["ዋቀዮ አከነ ናን ጄዼ፦ “ዸቂቲ ሰበተ ቁንጬ ተልባራ ሆጄተሜ ብተዹ ሙዺኬት ህዸዹ፤ ገሩ ብሻን ህንቱቅሲስን።”"]},{"type":"verse","number":2,"content":["ከናፉ አን አኩመ ዋቀዮ ነ አጀጄት ሰበተ ብተዼ ሙዺኮት ነንህዸዼ።"]},{"type":"verse","number":3,"content":["ኤርገሲ ዱቢን ዋቀዮ አከነ ጄዼ ዬሮ ለመፋ ገረኮ ዹፌ፦"]},{"type":"verse","number":4,"content":["“ሰበተ ብተቴ ሙዺት ህዸቴ ሰነ ፉዺቲ ገረ ለገ ኤፍራጢስ ዸቅ፤ ሰበተ ሰነስ በቀቃ ከታ ኬሰ ዾክስ።”"]},{"type":"verse","number":5,"content":["ከናፉ አን አኩመ ዋቀዮ ነ አጀጄት ዸቄ ሰበተ ሰነ ለገ ኤፍራጢስ ብረ ነንዾክሴ።"]},{"type":"verse","number":6,"content":["ቡልቲ ሄዱ ቦዴ ዋቀዮ፣ “አመ ገረ ኤፍራጢስ ዸቂቲ ሰበተ አን አከ አት አችት ዾክስቱ ስ አጀጄ ሰነ ፉዸዹ” ናን ጄዼ።"]},{"type":"verse","number":7,"content":["ከናፉ አን ገረ ኤፍራጢስ ዸቄ ሰበተ ሰነ እዶን እት ዾክሴ ቱሬ ሰና ቆቴ ባሴ ነንፉዸዼ፤ ሰበትን ሱን ገሩ ዬሮ ሰነት ጭጭቴ ጉቱማን ጉቱት ሆሮማ በኤ ቱሬ።"]},{"type":"verse","number":8,"content":["ኤርገሲ ዱቢን ዋቀዮ አከነ ጄዼ ገረኮ ዹፌ፤"]},{"type":"verse","number":9,"content":["“ዋቀዮ አከነ ጄዸ፤ ‘አን ሃሉመ ወል ፈካቱን ኦፍ ቱሉማ ይሁዳቲፊ ኦፍ ቱሉማ ዬሩሳሌም ጉዳ ሰነ ነንበሌሰ።"]},{"type":"verse","number":10,"content":["ሰብን ሀማን ዱቢኮ ዸገኡ ድዴ መተ ጀብነ ገራሳ ዱካ ቡኤ ዋቆተ ብራ ተጃጅሉፊ ዋቄፈቹፍ እሳን ፋነ ቡኤ ኩን አኩመ ሰበተ ከና ንተአ፤ ጉቱማን ጉቱትስ ሆሮማ በአ።"]},{"type":"verse","number":11,"content":["አኩመ ሰበትን ቶኮ ሙዺ ነማት ህዸሙ ሰነ አንስ አከ እሳን ሰበ፣ መቃ፣ ገለታፊ ኡልፍነ ና ተአኒፍ ጉቱማ መነ እስራኤሊፊ ጉቱማ መነ ይሁዳ ኦፍት መጠንሴን ቱሬ። እሳን ገሩ ነ ህንዸጌፈትኔ’ ጄዸ ዋቀዮ።"]},{"type":"heading","content":["ቀልቀሎ ዳዺ ወይኒ"]},{"type":"verse","number":12,"content":["“አት አከነ እሳኒን ጄዽ፦ ‘ዋቀዮ ዋቅን እስራኤል አከነ ጄዸ፦ ቀልቀሎን ዳዺ ወይኒ ሁንድ ዳዺ ወይኒቲን ጉተሙ ቀበ።’ ዮ እሳን፣ ‘ኑ አከ ቀልቀሎን ዳዺ ወይኒ ሁንድ ዳዺ ወይኒቲን ጉተሙ ቀቡ ህንቤክኑ?’ ሲን ጄዸን፣"]},{"type":"verse","number":13,"content":["አት አከነ ጄዺን፤ ‘ዋቀዮ አከነ ጄዸ፦ አን ነሞተ ብየ ከነ ኬሰ ጅራተን ሁንደ፣ ሞቶተ ቴሶ ዳዊትረ ታአን፣ ሉቦተ፣ ራጆታፊ ወረ ዬሩሳሌም ኬሰ ጅራተን ሁንደ መቺዻን ነንጉተ።"]},{"type":"verse","number":14,"content":["አን ቶኮ ቶኮሳኒ ወልትን ቡሰ፤ አቦቲፊ እልማንስ አከሱመ ወልት ነንቡሰ፣ ጄዸ ዋቀዮ። አን እሳን ነንበሌሰ መሌ እሳኒፍ ህንነኡ ዮካን እሳኒፍ ህንአራረሙ ዮካን ገራ ህንላፉፍ።’ ”"]},{"type":"heading","content":["አኬከቺሰ ኦፍ ቱሉማረት ኬነሜ"]},{"type":"verse","number":15,"content":[{"text":"ዸገኣ፤ ቀልቤፈዻስ፤","poem":1},{"text":"ኦፍ ህንቱልና፤","poem":2},{"lineBreak":true},{"text":"ዋቀዮ ዱበቴራቲ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኡቱ እን ዱከነ ህንፍድን፣","poem":1},{"text":"ኡቱ ሚልኬሰን","poem":2},{"text":"ቱሉ ዱከናኣ ጅሩረት ህንጉፈትን","poem":1},{"text":"ዋቀዮ ዋቀኬሰኒፍ ኡልፍነ ኬና።","poem":2},{"text":"እስን እፈ አብደቱ፤ እን ገሩ እፈ ሰነ","poem":1},{"text":"ድምምሰት ዴብሴ","poem":2},{"lineBreak":true},{"text":"ዱከነ ዱዳት ጌደረ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዮ እስን ዸገኡ ባተን ገሩ፣","poem":1},{"text":"ሰበቢ ኦፍ ቱሉማኬሰኒቲፍ","poem":2},{"lineBreak":true},{"text":"ሉቡንኮ ዾክሳት ንቦስ፤","poem":2},{"text":"ሰበቢ ቡሻዬን ዋቀዮ ቦጁን ፉዸመኒፍ","poem":1},{"text":"እጅኮ አከ መሌ ቦሴ","poem":2},{"lineBreak":true},{"text":"እምማን እሼ ኬሳ ንሮበ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ሞትቻፊ ሃዸ ሞትቻቲን፣","poem":1},{"text":"“ቴሶኬሰንራ ቡኣ፤","poem":2},{"text":"ጎንፎንኬሰን ኡልፍነ ቀቤስ ሱን","poem":1},{"text":"መታኬሰንራ ንቡኣቲ” ጄዽ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"መጋላወን ኔጌብ ንጩፈሙ፤","poem":1},{"text":"ነምን እሳን በኑ ቶኮዩ ህንጅሩ።","poem":2},{"text":"ይሁዳን ሁንድ ንቦጅአምት፤","poem":1},{"text":"ጉቱማን ጉቱትስ ብያ ፉዸተምት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"እጀኬሰን ኦል ፉዸዻቲ","poem":1},{"text":"ወረ ገመ ካባቲ ዹፋ ጅረን እላላ።","poem":2},{"text":"ቡሻዬን እማና ስት ኬነመን፣","poem":1},{"text":"ሆሎትን አት እቲን ቦንቴ ሱን ኤሰ ጅሩ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዮሙ ዋቀዮ ወረ አት አከ እሳን ምቾተ ሲፍ ተአኒፍ ሌንጅፍቴ ሰነ","poem":1},{"text":"ስረት ሙዱት አት ማል ጄተ?","poem":2},{"text":"አኩመ ዱበርቲ ጭኒንስፈቱ ቶኮ","poem":1},{"text":"ዽጵን ስ ህንቀቡ?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዮ አት፣ “ወን ኩን ማሊፍ ነት ዹፌ?”","poem":1},{"text":"ጄቴ ኦፍ ጋፈቴ","poem":2},{"text":"ወን ወንደቦንኬ ስራ ሙልቀሜ","poem":1},{"text":"ዸግንኬ ሰልጵፈሜፍ","poem":2},{"lineBreak":true},{"text":"ሰበቢ ጩቡኬ ባይኤ ሰናቲፍ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ነምን እቶጵያ ቶኮ ብፈሳ","poem":1},{"text":"ዮካን ቄረንስ ቡቡርነሳ ጌደሩ ንደንደኣ?","poem":2},{"text":"እስን ወር ሀምነ ሆጄቹ በረተንስ","poem":1},{"text":"ዋን ጋሪ ሆጄቹ ህንደንዴሰን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“አኩመ ቡቤን ገሞጂ ሀበቂ ብትኔሱ ሰነ","poem":1},{"text":"አንስ እስን ነንብትኔሰ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ሰበቢ አት ነ እራንፈቴ","poem":1},{"text":"ዋቆተ ሶባ አመነቴፍ፣","poem":2},{"text":"ኩን እጣኬ፣ ቆደ አን ሲፍ ሰፈሬዸ”","poem":1},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"“አከ ቃኒንኬ ሙልአቱፍ","poem":1},{"text":"አን ወንደቦኬ ፉለኬት ኦል ነንሶቆለ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ኤጁማፊ ህምምሱንኬ፣","poem":1},{"text":"ሰጋገሉማንኬ ከን ቃኒ ህንቀብኔ ሱንስ ንሙልአተ!","poem":2},{"text":"አን ሆጂኬ ጅብሲሳ ሰነ","poem":1},{"text":"ጋረንራፊ በኬ ኬሰት አርጌረ።","poem":2},{"text":"ያ ዬሩሳሌም፣ ሲፍ ወዮ!","poem":1},{"text":"አት ሀመ ዮሚት ጡሮፍቴ ሀፍተ?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JER/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JER/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JER/12.json","previousChapterAudioLinks":{},"numberOfVerses":27}