{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_ebi","name":"ኤርምያስ","commonName":"ኤርምያስ","title":"ራጂ ኤርምያስ","order":24,"numberOfChapters":52,"sha256":"e08276404fb1cf1f464d515eb4d9024ff6266c1a4a4283b37b28fd31b4fd4e55","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_ebi/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":14,"content":[{"type":"heading","content":["ሆንጌ፣ ቤለ፣ ጎራዴ"]},{"type":"verse","number":1,"content":["ዱቢን ዋቀዮ ዋኤ ሆንጌ አከነ ጄዼ ገረ ኤርምያስ ዹፌ፦"]},{"type":"verse","number":2,"content":[{"text":"“ይሁዳን ንቦስ፤","poem":1},{"text":"መጋላወንሼስ ገድ ዴብኣ ጅሩ፤","poem":2},{"text":"እሳን ብየቲዻፍ ንወዋቱ፤","poem":1},{"text":"እይ ቶኮስ ዬሩሳሌሚ ዸገአማ ጅረ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ነሞትን ጉርጉዶትን ሆጄቶተሳኒ ብሻን ወራቡፍ ኤርገቱ፤","poem":1},{"text":"እሳንስ ገረ ቦለ ብሻኒ ዸቁ፤","poem":2},{"lineBreak":true},{"text":"ገሩ ብሻን ህንአርገተን።","poem":2},{"text":"እሳን ኦኮቴሳኒ ዱዋ ቀበተኒ ዴብኡ፤","poem":1},{"text":"እሳን ቃነአኒ አብዲ ኩተተኒ","poem":2},{"lineBreak":true},{"text":"መታሳኒ ሀጉገቱ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሰበቢ ብየቲ ኬሳ","poem":1},{"text":"ቦካን ዸበሜፍ ለፍት ንበበቀቅጤ፤","poem":2},{"text":"ቆናን ቡልቶትንስ አብዲ ኩተተኒ","poem":1},{"text":"መታሳኒ ሀጉገቱ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሰበቢ መርግ ህንጅሬፍ፣","poem":1},{"text":"ቦሮፍን በኬዩ","poem":2},{"lineBreak":true},{"text":"እልሞሼ ከን ሬፉ ዸለቴ ገቴ ዴምት።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሀሮትን ዲዳ ለፈ ኦል ከኣ ቁላረ እጃጀኒ","poem":1},{"text":"አኩመ ዋንጎታ አርገኑ፤","poem":2},{"text":"ሰበቢ ዋን ዼደን ዸበኒፍ","poem":1},{"text":"እጅሳኒ ዋ አርጉ ደዸቤ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ያ ዋቀዮ፣ ጩቡንኬኘ ኑት ዹጋ በኡዩ","poem":1},{"text":"አት መቃኬቲፍ ጄዺቲ ዋ ኑ ጎዽ።","poem":2},{"text":"ዱበት ዴብኡንኬኘ ባይአቴረ፤","poem":1},{"text":"ኑ ጩቡ ስት ሆጄትኔረ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ያ አብዲ እስራኤል፣","poem":1},{"text":"ፈይሳሼ ከን ዬሮ ረክና፣","poem":2},{"text":"አት ማሊፍ አኩመ ከረ ዴምቱ ሀልከን ቶኮ ቆፈ ቡልቱ","poem":1},{"text":"ብየቲ ኬሰት አኩመ ኬሱማ ታተ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አት ማሊፍ አከ ነመ ዋን ጎዹ ወላሌ ቶኮ፣","poem":1},{"text":"አኩመ ሎልቱ ነመ ኦልቹ ህንደንዴኜ ቶኮ ታተ?","poem":2},{"text":"ያ ዋቀዮ፣ አት ኑ ግዱ ጅርተ፤","poem":1},{"text":"ኑ መቃኬቲን ዋመምነ፤","poem":2},{"lineBreak":true},{"text":"አት ኑ ህንገትን።","poem":2}]},{"type":"verse","number":10,"content":["ዋቀዮ ዋኤ ሰበ ከና አከነ ጄዸ፦",{"text":"“እሳን ጆሩ ጃለቱ፤","poem":1},{"text":"ሚለሳኒ ህንእትፈተን።","poem":2},{"text":"ከናፉ ዋቀዮ እሳንት ህንገመዱ፤","poem":1},{"text":"እን አመ ሀምነሳኒ ንያደተ፤","poem":2},{"lineBreak":true},{"text":"ጩቡሳኒቲፍስ እሳን አደበ።”","poem":2}]},{"type":"verse","number":11,"content":["ዋቀዮ አከነ ናን ጄዼ፤ “አከ ሰብን ኩን ነጋን ጅራቱ ነ ህንከዸትን።"]},{"type":"verse","number":12,"content":["ዮ እሳን ሶመንዩ አን እየሳኒ ህንዸገኡ፤ ዮ እሳን ኣርሳ ጉበሙፊ ኣርሳ ምዻኒ ዽኤሰንዩ አን ህንፉዸዹ። ቆደ ከና አን ጎራዴዻን፣ ቤላፊ ዸእቻን እሳን ነንበሌሰ።”"]},{"type":"verse","number":13,"content":["አን ገሩ አከነ ነንጄዼ፤ “ወዮ ያ ዋቀዮ ጎፍታ፣ ራጆትን ሰበ ከናን፣ ‘እስን ጎራዴ ህንአርግተን ዮካን ህንቤሎፍተን። አን ዹጉማን ነጋ ዹመ ህንቀብኔ እዶ ከነት እስኒፍ ነንኬነ’ ጄዹ።”"]},{"type":"verse","number":14,"content":["አመሌ ዋቀዮ አከነ ናን ጄዼ፤ “ራጆን ሱን መቃኮቲን ሶበ ራጁ። አን እሳን ህንኤርግኔ ዮካን እሳን ህንሙድኔ ዮካን እሳንት ህንዱበትኔ። እሳን ሙልአታፊ ራጂ ሶባ፣ ዋቀ ቶልፈማ ዋቄፈቹፊ ዋን ኦፉመሳኒቲ ያደን እስንት ህሙ።"]},{"type":"verse","number":15,"content":["ከናፉ ዋቀዮ ዋኤ ራጆተ መቃሳቲን ራጀን ሰና አከነ ጄዸ፦ አን እሳን ህንኤርግኔ፤ እሳን ገሩ፣ ‘ጎራዴን ዮካን ቤል ቶኮዩ ብየ ከነ ህንቱቁ’ ጄዹ። ራጆትን ሱንዩ ጎራዴፊ ቤላን ዹሙ።"]},{"type":"verse","number":16,"content":["ነሞትን እሳን ራጂ ዱበተኒፍ ሱንስ ቤላፊ ጎራዴዻን ዳንዲወን ዬሩሳሌምረት ሀርጫፈሙ። ነምን እሳን ዮካን ኒቶተሳኒ፣ እልማንሳኒ ዮካን እንተለንሳኒ አዋሉ ቶኮዩ ህንጅሩ። አን በዲሰ እሳኒፍ መሉ እሳንት ነንዸንገላሳቲ።"]},{"type":"line_break"},{"type":"verse","number":17,"content":["“አከነ ጄዺ ዱቢ ከነ እሳንት ዱበዹ፦",{"text":"“ ‘እጅኮ ሀልከኒፊ ጉያ ኡቱ ገርገር","poem":1},{"text":"ህንኩትን እምማን ሃሎላሱ፤","poem":2},{"text":"እንተል፣ ዱርብ ቁልቁልቲን ሰበኮቲ","poem":1},{"text":"አከ መሌ መዶፍቴ","poem":2},{"lineBreak":true},{"text":"ዸእቸ ሀማዻን ዸአምቴ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"አን ዮን ባድያ ዸቄ፣","poem":1},{"text":"ወረ ጎራዴዻን ዹመን ነንአርገ፤","poem":2},{"text":"ዮን መጋላ ሴኔሞ፣","poem":1},{"text":"ወረ ቤላን ዹመን ነንአርገ።","poem":2},{"text":"ራጆትኒፊ ሉቦትን","poem":1},{"text":"ብየ ህንቤክኔ ኬሰ ጆሩ።’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"አት ይሁዳ ጉቱማን ጉቱት ገቴርታ?","poem":1},{"text":"ጥዮኒንስ ንቱፈታ?","poem":2},{"text":"አት ማሊፍ","poem":1},{"text":"አከ ኑ ፈዩ ህንደንዴኜፍ ኑ ሚተ?","poem":2},{"text":"ኑ ነጋ አብደትኔ፤","poem":1},{"text":"ገሩ ወን ጋሪን ቶኮዩ ህንዹፍኔ፤","poem":2},{"text":"ኑ ዬሮ ፈይና አብደትኔ፤","poem":1},{"text":"ገሩ ራፈመ ቆፈቱ ጅረ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ያ ዋቀዮ፣ ኑ ሀምነኬኛፊ","poem":1},{"text":"የከ አቦቲኬኛ ንቤክነ፤","poem":2},{"lineBreak":true},{"text":"ኑ ዹጉማን ጩቡ ስት ሆጄትኔረ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አት መቃኬቲፍ ጄዺቲ ኑ ህንቱፈትን፤","poem":1},{"text":"ቴሶኬ ኡልፍነ ቀቤሰ ሰነስ ህንቃኔስን።","poem":2},{"text":"ከኩ ኑ ወጅን ገልቴ ሰነ ያደዹ፤","poem":1},{"text":"እሰስ ህንጨብስን።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዋቆተ ነሞተ ኦርማ ከኔን ፋይዳ ህንቀብኔ ሰነ ኬሳቶኮዩ ቦካ ንሮብሳ?","poem":1},{"text":"ሰሚወን መታንሳኒዩ ቲፉ ገድ ኤርጉ?","poem":2},{"text":"ያ ዋቀዮ ዋቅንኬኘ ሱመ ምቲ?","poem":1},{"text":"ከናፉ አብዲንኬኘ ሱመ፤","poem":2},{"lineBreak":true},{"text":"ስቱ ዋን ከነ ሁንደ ሆጄታቲ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JER/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JER/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JER/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}