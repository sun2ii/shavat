{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_ebi","name":"ኤርምያስ","commonName":"ኤርምያስ","title":"ራጂ ኤርምያስ","order":24,"numberOfChapters":52,"sha256":"e08276404fb1cf1f464d515eb4d9024ff6266c1a4a4283b37b28fd31b4fd4e55","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_ebi/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":["ዋቀዮ አከነ ናን ጄዼ፤ “ዮ ሙሴፊ ሳሙኤል ፉለኮ ዱረ ዻበተንዩ ገራንኮ ገረ ሰበ ከናት ህንዴብኡ። ፉለኮ ዱራ እሳን አርእ! እሳን ሃዴመን!"]},{"type":"verse","number":2,"content":["ዮ እሳን፣ ‘ኤሰ ዸቅነ?’ ጄዸኒ ስ ጋፈተንሞ አከነ ጄዺ እሳንት ህም፤ ‘ዋቀዮ አከነ ጄዸ፦",{"text":"“ ‘ነምን ዱኣፍ ረመደሜ ገረ ዱኣ፣","poem":1},{"lineBreak":true},{"text":"ነምን ጎራዴዻፍ ረመደሜ ገረ ጎራዴ፣","poem":1},{"lineBreak":true},{"text":"ነምን ቤላፍ ረመደሜ ገረ ቤላ፣","poem":1},{"lineBreak":true},{"text":"ነምን ቦጁዻፍ ረመደሜሞ ገረ ቦጁ ዸቀ።’","poem":1}]},{"type":"verse","number":3,"content":["“አን ዋን እሳን በሌሱ ጎሰ አፉር እሳንት ነንኤርገ” ጄዸ ዋቀዮ። “አከ እሳን አጄሱፍ ጎራዴ፣ አከ እሳን ሀርክሰኒፍ ሰሮተ፣ አከ እሳን ኛተኒ ፍጠኒፍሞ አላቲወን ሰሚቲፊ ብኔንሶተ ለፋ እሳንት ነንኤርገ።"]},{"type":"verse","number":4,"content":["አን ሰበቢ ምናሴን እልም ህስቅያስ ሞትች ይሁዳ ዬሩሳሌም ኬሰት ሆጄቴ ዋን ሰናቲፍ ፉለ ሞቱሞተ ለፈራ ሁንደ ዱረት ጅበምቶተ እሳን ነንጎዸ።"]},{"type":"verse","number":5,"content":[{"text":"“ያ ዬሩሳሌም፣ ኤኙቱ ገራ ሲፍ ላፈ?","poem":1},{"text":"ኤኙቱ ሲፍ ቦአ?","poem":2},{"lineBreak":true},{"text":"ኤኙቱ ስ ዱብሱፍ ስት ጎረ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አት ነ ዺፍቴርተ፤","poem":1},{"text":"እቱመ ፉፍቴስ ዱበት ዴብኣ ጅርተ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2},{"text":"“ከናፉ አን ሀርከኮ ስት ሂጠዼ ስን በሌሰ፤","poem":1},{"text":"አን ስአች ሲፍ ነኡ ህንደንደኡ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አን ከረወን መጋላ ብየቲ ዱረት፣","poem":1},{"text":"ቆርቢዻን ቅሌንሰት እሳን ነንኬነ።","poem":2},{"text":"አን ሰበኮት ገዳፊ በዲሰ ነንፍደ፤","poem":1},{"text":"እሳን ከራሳኒራ ህንዴብኔቲ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አን ሃዾተ ህዬሳሳኒ","poem":1},{"text":"ጭረቸ ገላና ጫላ ነንባይእሰ።","poem":2},{"text":"አን ሃዾተ ደርገጎተሳኒት፣","poem":1},{"text":"ጉዩመ ሳፋዻንዋን እሳን በሌሱ ቶኮ ነንፍደ፤","poem":2},{"text":"አን ጎሊፊ ናሱ","poem":1},{"text":"አኩመ ተሳ እሳንት ነንገዺሰ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሃት እልማን ቶርባ ገገብዴ","poem":1},{"text":"ሀፉረ ዹማ ባፈት።","poem":2},{"text":"አዱንሼ ጉዩመ አዲዻን ዺት፤","poem":1},{"text":"እሼንስ ሰልጰቴ ነማ ገድ ታት።","poem":2},{"text":"አን ሀምባወንሳኒ ፉለ ዲኖተሳኒ ዱረት","poem":1},{"text":"ጎራዴፍ ደበርሴ ነንኬነ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ወዮ ያ ሃዸኮ፣","poem":1},{"text":"ከን አነ ነመ ብየቲ ጉቱሎሉፊ ፈልሙ ዴሴ?","poem":2},{"text":"አን ህንልቄስኔ ዮካን ህንልቄፈትኔ፤","poem":1},{"text":"ነምን ሁንድ ገሩ ነ አባረ።","poem":2}]},{"type":"verse","number":11,"content":["ዋቀዮ አከነ ጄዼ፤",{"text":"“አን ዹጉማን ካዮ ጋሪዻፍ ስን በራረ፤","poem":1},{"text":"አን ዹጉማን ዬሮ ረክናቲፊ ግድራት፣","poem":2},{"lineBreak":true},{"text":"አከ ዲኖትንኬ ስ ከዸተን ነንጎዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ነምን ከምዩ ስቢለ፣","poem":1},{"text":"ስቢለ ካባ ዹፌ ዮካን ናሲ ጨብሱ ንደንደኣ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ሰበቢ ጩቡኬ ሁንደ","poem":1},{"text":"ከን ብየኬ ጉቱ ኬሰ ጅሩ ሰናቲፍ","poem":2},{"text":"አን በዻዹማኬቲፊ","poem":1},{"text":"ቀቤኘኬ ቶሉመ ቦጁፍ ነንኬነ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሰበቢ ዼከምስኮ","poem":1},{"text":"እብደ እሼ ጉቡ ቀብሲሱፍ፣","poem":2},{"text":"አን ብየ አት ህንቤክኔ ኬሰት","poem":1},{"text":"ዲኖተኬቲፍ ስን ገርቦምሰ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ያ ዋቀዮ ስቱ ቤከ፤","poem":1},{"text":"ነ ያደዹ፤ ነ ትክስስ።","poem":2},{"lineBreak":true},{"text":"ወረ ነ አርአተን ሃሎ ናፍ በእ።","poem":2},{"text":"አት ኦብሰ ጉዳ ቀብዳቲ ነ ህንበሌስን፤","poem":1},{"text":"አከ አን ሲፍ ጄዼ ቱፈተሙ ቤክ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዱቢንኬ ንአርገሜ፤ አንስ ነንኛዼ፤","poem":1},{"text":"እንስ ነ ገመቺሴ፤ ገመቹ ገራኮቲስ ተኤ፤","poem":2},{"text":"ያ ዋቀዮ፣ ጎፍታ ዋን ሁንደ ደንዴሱ፣","poem":1},{"text":"አን መቃኬቲን ነንዋመማቲ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አን ጎንኩማ ቱተ ፈንደለልቶታ ወጅን ህንቴኜ፤","poem":1},{"text":"ጎንኩማ እሳን ወጅን ህንገመድኔ፤","poem":2},{"text":"ሰበቢ ሀርክኬ ነረ ቱሬፊ","poem":1},{"text":"ሰበቢ አት ኣሪዻን ነ ጉቴፍ አን ኮጳኮ ነንታኤ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ረክንኮ ማሊፍ ዹመ ዸቤ?","poem":1},{"text":"መዳንኮስ ማሊፍ ፈዩ ድዴ?","poem":2},{"text":"አት አከ ለገ ነመ ጎዎምሱ","poem":1},{"text":"አከ ቡርቃ ጎጉስ ነት ታታ?","poem":2}]},{"type":"verse","number":19,"content":["ከናፉ ዋቀዮ አከነ ጄዸ፦",{"text":"“ዮ አት ቀልቢ ጅጂረቴ፣","poem":1},{"text":"አን አከ አት ነ ተጃጅልቱፍ ዴብሴ ስን ዻበ፤","poem":2},{"text":"አት ዮ ዱቢ ፋይዳ ህንቀብኔ","poem":1},{"text":"ዺፍቴ ዱቢ ፋይዳ ቀቡ ዱበቴ አፋን ናፍ ታተ።","poem":2},{"text":"ሰብን ኩን ገረኬት ሃዴብኡ መሌ","poem":1},{"text":"አት ገረሳኒት ዴብኡ ህንቀብዱ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አን ሰበ ከናፍ ደላ ዸጋ፣","poem":1},{"text":"ደላ ናሲ ከን ጀቤፈሜ እጃረሜ ስን ታስሰ፤","poem":2},{"text":"እሳን ስ ሎሉ፤","poem":1},{"text":"ገሩ ስ ህንሞአተን፤","poem":2},{"text":"አን ስ በራሩፊ ስ ባሱፍ ስ ወጅን ጅራቲ”","poem":1},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“አን ሀርከ ነሞተ ሀሞ ጀላ ስን ባሰ፤","poem":1},{"text":"ሀርከ ወረ ገረ ጀቤዪ ጀላስ ስ ንፉረ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JER/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JER/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JER/14.json","previousChapterAudioLinks":{},"numberOfVerses":21}