{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_ebi","name":"ኤርምያስ","commonName":"ኤርምያስ","title":"ራጂ ኤርምያስ","order":24,"numberOfChapters":52,"sha256":"e08276404fb1cf1f464d515eb4d9024ff6266c1a4a4283b37b28fd31b4fd4e55","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_ebi/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"“ጩቡን ይሁዳ ሜሻ ስቢላቲን ቅርጠሜረ፤","poem":1},{"text":"ቀረ ዸጋቲንስ","poem":2},{"text":"ገበቴ ገራሳኒረቲፊ","poem":1},{"text":"ጋንፈ እዶ ኣርሳሳኒረት በሬፈሜረ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እጆሌንሳኒዩ","poem":1},{"text":"እዶወን ኣርሳሳኒቲፊ ሲዳ ኣሼራ","poem":2},{"text":"ከኔን ሙኬን ለልሳ ጭናቲፊ","poem":1},{"text":"ጋረን ኦል ዼሮራ ሰነ ያደተን።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አን ሰበቢ ጩቡ ብየኬ ጉቴ ሰናቲፍ","poem":1},{"text":"ቱሉኮ ከን ብየ ኬሳ፣","poem":2},{"text":"ቀቤኘኬቲፊ በዻዹማኬ ሁንደ","poem":1},{"text":"እዶ ኦል ከኣኬ ወጅን","poem":2},{"lineBreak":true},{"text":"ደበርሴ ቦጁፍ ነንኬነ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አት ዶጎጎረ መታኬቲቲን","poem":1},{"text":"ዻለ አን ሲፍ ኬኔ ንዸብደ።","poem":2},{"text":"አን ብየ አት ህንቤክኔ ኬሰት","poem":1},{"text":"ዲኖተኬቲፍ ስን ገርቦምሰ፤","poem":2},{"text":"አት ዼከምሰኮ ቀብሲፍቴርታቲ፤","poem":1},{"text":"እንስ በረ በራን ንቦበአ።”","poem":2}]},{"type":"verse","number":5,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“ነምን ነመ አመነቱ፣","poem":1},{"text":"ከን ጀብነ ፎኒ እሬሳ ጎዸቱ፣","poem":2},{"lineBreak":true},{"text":"ከን ገራንሳ ዋቀዮራ ገረገሉ አባረማዸ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እን አከ ደገለ ገሞጂ ኬሳ ተአ፤","poem":1},{"text":"ዬሮ ወን ጋሪን ዹፉት ህንአርጉ።","poem":2},{"text":"እን ገሞጂ ኬሳ እዶ ጎጋ","poem":1},{"text":"ብየ ሶግዳ ከን ነምን ቶኮዩ ህንጅራትኔ ኬሰ ጅራተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ነምን ዋቀዮን አመነቱ፣","poem":1},{"text":"ከን አብዲንሳስ እሱመ ተኤ ገሩ ኤብፈማዸ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እን አኩመ ሙከ ቀርቀረ ብሻኒ ዻበሜ፣","poem":1},{"text":"ከን ህደሳ ኤዴደ ለጋረ ያፈቱ ተአ።","poem":2},{"text":"ዮሙ ሆእ ዹፉ ህንሶዳቱ፤","poem":1},{"text":"ባልሳ ዬሮ ሁንደ ለልሳዸ።","poem":2},{"text":"ሙክን ሱን በረ ሆንጌሌ ህንያደኡ፤","poem":1},{"text":"እጀ ነቀቹስ ህንዺሱ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ገራን ነማ ዋን ሁንደ ጫላ ሀጤዸ፤","poem":1},{"text":"ገርመሌስ ሀማዸ።","poem":2},{"lineBreak":true},{"text":"ኤኙቱ እሰ ሁበቹ ደንደአ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“አን ዋቀዮ ነመ ሁንዳፍ አኩመ አመለሳት፣","poem":1},{"text":"አኩመ ዋን ሆጂሳቲፍ መሉት","poem":2},{"text":"ገቲ እሳፍ ኬኑፍ ገራሳ ነንሰከተአ፤","poem":1},{"text":"ቀልቢሳስ ነንቆረ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ነምን ከራ ህንመሌን በዻዹማ ወልት ቀበቱ","poem":1},{"text":"አኩመ ጎጎሪ ሀንቃቁ ህንሀንቃቅን ሀመቱት።","poem":2},{"text":"ወለካ ኡሙሪሳት በዻዹማን ሱን እሰ ዺሴ በደ፤","poem":1},{"text":"ዹመረትስ ጎዋ ተኡንሳ ንምርከኔፈመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ቴሶን ኡልፍነ ቀቤስ ዱሩማ ጀልቀቤ ኦል ኦል ጄዹ ሱን፣","poem":1},{"text":"እዶ ቁልቁሉማኬኛት።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ያ ዋቀዮ፣ አብዲ እስራኤል፣","poem":1},{"text":"ወር ስ ዺሰን ሁንድ ንቃኔፈሙ።","poem":2},{"text":"ወር ስራ ገረገለን ብዮ ኬሰት ገልሜፈመኒሩ፤","poem":1},{"text":"እሳን ዋቀዮን","poem":2},{"lineBreak":true},{"text":"ቡርቃ ብሻን ጅሬኛ ዺሰኒሩቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ያ ዋቀዮ ነ ፈይስ፤ አንስ ነንፈያ፤","poem":1},{"text":"ነ ኦልች፣ አንስ ነንኦልፈመ፤","poem":2},{"lineBreak":true},{"text":"ከን አን ጀጀዹ ሱማቲ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እሳን እቱመ ፉፈኒ፣","poem":1},{"text":"“ዱቢን ዋቀዮ ኤሰ ጅረ?","poem":2},{"lineBreak":true},{"text":"ሜ አመ ሃራወተሙ!” ናን ጄዹ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አን ትክሴ ተኤ ስ ተጃጅሉራ ዱበት ህንዴብኔ፤","poem":1},{"text":"አት አከ አን ጉያ በዲሳ ህንሀውኔ ንቤክተ።","poem":2},{"lineBreak":true},{"text":"ወን አፋንኮቲ በኡ ፉሉመኬ ዱረ ጅረ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አት ነ ህንርፈቺስን፤","poem":1},{"text":"ጉያ በዲሳት አት ደኦኮት።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ወር ነ አደምሰን ሃቃኔፈመን፤","poem":1},{"text":"አነ ገሩ ቃኒራ ነ ኦልች፤","poem":2},{"text":"እሳን ሃርፈተን፤","poem":1},{"text":"አነ ገሩ ርፋቲራ ነ ኤግ።","poem":2},{"text":"ጉያ በዲሳ እሳንት ፍድ፤","poem":1},{"text":"በዲሰ ደቻቲን እሳን በሌስ።","poem":2}]},{"type":"heading","content":["ሰንበተ ከበጁ"]},{"type":"verse","number":19,"content":["ዋቀዮ አከነ ናን ጄዼ፦ “ዸቂቲ ከረ ኡመታ ከራ ሞቶትን ይሁዳ እቲን ሴነኒ በአን ዱረ ዻበዹ፤ አከሱመስ ከረወን ዬሩሳሌም ካን ሁንደ ዱረ ዻበዹ።"]},{"type":"verse","number":20,"content":["አከነስ እሳኒን ጄዽ፤ ‘ያ ሞቶተ ይሁዳ፣ ሰብን ይሁዳ ሁንዲፊ ነሞትን ዬሩሳሌም ኬሰ ጅራተን ከኔን ከረ ከናን ኦል ገልተን ሁንድ ዱቢ ዋቀዮ ዸገኣ።"]},{"type":"verse","number":21,"content":["ዋቀዮ አከነ ጄዸ፦ አከ ጉያ ሰንበታቲን በኣ ህንባትኔ ዮካን ከረወን ዬሩሳሌሚን ኦል ህንገልችኔ ኦፍ ኤገዻ።"]},{"type":"verse","number":22,"content":["አኩመ አን አቦቲኬሰን አጀጄት ጉያ ሰንበታ ከበጃ መሌ ጉያ ሰንበታቲን መነኬሰኒ በኣ ገድ ህንባስና ዮካን ሆጂ ከምዩ ህንሆጄትና።"]},{"type":"verse","number":23,"content":["ተኡስ እሳን ህንዸጌፈትኔ ዮካን ህንቀልቤፈትኔ፤ ገሩ አከ ህንዸጌኜፊ አከ ቀጄልፈመ ህንፉዸኔፍ መታ ጀባተን።"]},{"type":"verse","number":24,"content":["ዋቀዮ አከነ ጄዸ፤ ዮ እስን ነ ዸጌሰኒ ጉያ ሰንበታቲን በኣ ቶኮሌ ከረወን መጋላ ከናቲን ኦል ገልቹ ዺፍተኒ ቆደ ከና ጋፈስ ሆጂ ከምዩ ሆጄቹ ዺሱዻን ጉያ ሰንበታ አዳን ባፍተኒ ኤግደን፣"]},{"type":"verse","number":25,"content":["ሞቶትን ቴሶ ዳዊትረ ታአን ቆንዳልቶተሳኒ ወጅን ከረወን መጋላ ከናቲን ኦል ሴኑ። እሳንስ ቆንዳልቶተሳኒ ወጅን ጋሪወኒፊ ፈርዴን ያበተኒ ነሞተ ይሁዳቲፊ ወረ ዬሩሳሌም ኬሰ ጅራተን ወጅን ንዹፉ፤ መጋላን ኩንስ መጋላ ነምን በረ በራን ኬሰ ጅራቱ ንተአ።"]},{"type":"verse","number":26,"content":["ነሞትንስ መጋላወን ይሁዳቲፊ ገንዶተ ናኖ ዬሩሳሌሚቲ፣ ብየ ቤንያሚቲፊ ብየ ጋረ ኬሳቲ፣ ብየ ጋራቲፊ ኔጌቢ ኣርሳ ጉበሙፊ ቀልመ፣ ኣርሳ ምዻኒ፣ እጣናፊ ኣርሳ ገለታ ፍደኒ ገረ መነ ዋቀዮ ንዹፉ።"]},{"type":"verse","number":27,"content":["ዮ እስን ጉያ ሰንበታ አዳን ባፍተኒ ኤጉፍ ጄተኒ ጉያ ሰንበታቲን በኣ ቶኮዩ ባተኒ ከረወን ዬሩሳሌሚን ኦል ሴኑ ዺሱዻን አናፍ አጀጀሙ ባተን ገሩ አን እብደ ህንዻምኔ ቶኮ ከረወን ዬሩሳሌምት ነንቀብሲሰ፤ እብድ ሱንስ ደአኖወን ዬሩሳሌም ጉቤ በርበዴሰ።’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JER/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JER/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JER/16.json","previousChapterAudioLinks":{},"numberOfVerses":27}