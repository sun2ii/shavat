{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_ebi","name":"ኤርምያስ","commonName":"ኤርምያስ","title":"ራጂ ኤርምያስ","order":24,"numberOfChapters":52,"sha256":"e08276404fb1cf1f464d515eb4d9024ff6266c1a4a4283b37b28fd31b4fd4e55","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_ebi/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":18,"content":[{"type":"heading","content":["መነ ነምቸ ሱጴ ዸኡ ቶኮት"]},{"type":"verse","number":1,"content":["ዱቢን ዋቀዮ ብራ ገረ ኤርምያስ ዹፌ እሰ ከናዸ፦"]},{"type":"verse","number":2,"content":["“ከኢቲ ገረ መነ ነምቸ ሱጴ ዸኡ ሰና ዸቅ። አንስ አችት ዱቢኮ ስት ነንህመ።”"]},{"type":"verse","number":3,"content":["ከናፉ አን ገረ መነ ነምቸ ሱጴ ዸኡ ሰናት ገድ ነንቡኤ፤ እንስ ጌንጎረት ዋ ሆጄቻ ቱሬ።"]},{"type":"verse","number":4,"content":["ኦኮቴን እን ሱጴራ ሆጄቻ ቱሬ ሱን ገሩ ሀርከሳት ፈሸላኤ፤ ከናፉ ነምች ሱጴ ዸኡ ሱን አኩመ እት ቶሌት ሱጴ ሰናን ኦኮቴ ከን ብራ ሆጄቴ።"]},{"type":"verse","number":5,"content":["ኤርገሲ ዱቢን ዋቀዮ አከነ ጄዼ ገረኮ ዹፌ፦"]},{"type":"verse","number":6,"content":["“ያ መነ እስራኤል፣ አንስ አኩመ ሱጴ ዾፍቱን ኩን ሆጄቱ እስን ጎቹ ህንደንደኡ?” ጄዸ ዋቀዮ። “ያ መነ እስራኤል፣ አኩመ ሱጴን ሀርከ ሱጴ ዾፍቱ ኬሰ ጅሩ እስንስ ሀርከኮ ኬሰ ጅርቱ።"]},{"type":"verse","number":7,"content":["ዬሮ አን አከ ሰብን ዮካን ሞቱማን ቶኮ ቡቅፈሙ፣ ገርገር ቆደሙፊ በርበዴፈሙ ለብሱት፣"]},{"type":"verse","number":8,"content":["ዮ ሰብን አን አኬከቺሴ ሱን ሀምነሳራ ዴብኤ፣ አን ዋን ሀማ እሰት ፍዱፍ ያዴ ሰነራ ነንዴብአ።"]},{"type":"verse","number":9,"content":["ዮ አን ዬሮ ብራሞ አከ ሰብን ዮካን ሞቱማን ቶኮ እጃረሜ ዻበሙ ለብሴ፣"]},{"type":"verse","number":10,"content":["ዮ እን ፉለኮ ዱረት ዋን ሀማ ሆጄቴ አናፍ አጀጀሙ ድዴ፣ አን ዋን ጋሪ እሳፍ ጎቹ በርባዴ ሰነ ነንዺሰ።"]},{"type":"verse","number":11,"content":["“ከናፉ አመ ሰበ ይሁዳቲፊ ወረ ዬሩሳሌም ኬሰ ጅራተኒን አከነ ጄዽ፤ ‘ዋቀዮ አከነ ጄዸ፦ ኩኖ! አን በዲሰ እስኒፍ ቆጴሴን መለ እስንት ከሮርሳ ጅረ። ከናፉ ቶኮን ቶኮንኬሰን ከራኬሰኒፊ ሆጂኬሰን ቀጄልፈዻ።’"]},{"type":"verse","number":12,"content":["እሳን ገሩ አከነ ጄዸኒ ዴቢ ኬነን፦ ‘ኩን ፋይዳ ህንቀቡ። ኑ ከሮሩመኬኛን እት ፉፍነ፤ ቶኮን ቶኮንኬኘ መተ ጀብናፊ ሀምነ ገራኬኛ ዱካ ቡነ።’ ”"]},{"type":"verse","number":13,"content":["ከናፉ ዋቀዮ አከነ ጄዸ፦",{"text":"“ሜ ሰቦተ ኬሰ እያፈዻ፦","poem":1},{"text":"ኤኙቱ ተኩማ ዋን አከና ዸገኤ ቤከ?","poem":2},{"text":"እስራኤል ዱርብ ቁልቁልቲን","poem":1},{"text":"ዋን ሱከኔሳ ቶኮ ሆጄቴርት።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ጨቢን ልባኖን","poem":1},{"text":"ተኩማ ኤዴደ ከታሳራ በዴ ቤካ?","poem":2},{"text":"ብሻንሳ ዲለላኣን ቡርቃ ፈጎቲ ዹፉ ሱን","poem":1},{"text":"ተኩማ ጭቴ ቤካ?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሰብንኮ ገሩ ነ እራንፈቴረ፤","poem":1},{"text":"እሳን ዋቆተ ቶልፈሞ ፋይዳ ህንቀብኔ","poem":2},{"text":"ከኔን ከራወንሳኒረቲፊ","poem":1},{"text":"ዳንዲወን ዱሪረት እሳን ጉፈቺሰኒፍእጣነ ኣርሱ።","poem":2},{"text":"እሳን ከራ ህንቶልፈምኔረ","poem":1},{"text":"ዳንዲ ቀልኦረ እሳን ዴምስሰኒሩ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ብይሳኒ ንኦነ፤","poem":1},{"text":"በረ በራንስ ብየ ቆሳ ተአ፤","poem":2},{"text":"ወር አቺን ደርበን ሁንድ ንነኡ፤","poem":1},{"text":"መታሳኒስ ንራሱ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አኩመ ቡቤ በአ ቢፍቱቲ ዹፉ፣","poem":1},{"text":"አን ፉለ ዲኖተሳኒ ዱረት እሳን ነንብትኔሰ፤","poem":2},{"text":"በረ በዲሰሳኒ ኬሰ፣","poem":1},{"text":"አን ዱግደኮ መሌ ፉለኮ እሳንት ህንአርግሲሱ።","poem":2}]},{"type":"verse","number":18,"content":["“ጀርስ፣ ‘ሴር ሉበ ብራ፣ ጎርስ ኦጌዪ ብራ፣ ዱቢንሞ ራጆተ ብራ ዋን ህንዸበምኔፍ ኮታ ኤርምያስት መርአትና፤ ከናፉ ኮታ ኑ አረበኬኛን እሰ ሚና፤ ዋን እን ዱበቱ ከምዩስ ህንፉዸትኑ’ ” ጄዸን።"]},{"type":"verse","number":19,"content":[{"text":"ያ ዋቀዮ፣ ነ ዸጌፈዹ፤","poem":1},{"text":"ዋን ወር ነ ህመተን ጄዸንስ ዸገእ!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ገቲን ዋን ጋሪ ዋን ሀማዻ?","poem":1},{"text":"እሳን ገሩ ቦለ አናፍ ቆተኒሩ።","poem":2},{"text":"አን አከን ዼከምሰኬ እሳንራ","poem":1},{"text":"ዴብሱፍ ፉለኬ ዱረ ዻበዼ","poem":2},{"lineBreak":true},{"text":"እዶሳኒ ቡኤ ዱበዼ ያደዹ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ከናፉ አት እጆሌሳኒ ደበርሲ ቤለት ኬን፤","poem":1},{"text":"ጀረሞ ደበርሲ ሁምነ ጎራዴት ኬን።","poem":2},{"text":"ኒቶተሳኒ ጀላ እጆሌፊ ዽርሶትን ሃዹመን፤","poem":1},{"text":"ዺሮንሳኒ ሃአጄፈመን፤","poem":2},{"lineBreak":true},{"text":"ደርገጎንሳኒሞ ሎለ ኬሰት ጎራዴዻን ሃቀለመን።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዬሮ አት አኩመ ተሳ ዌራርቶተ እሳንት ፍዱት፣","poem":1},{"text":"እይ መነሳኒቲ ሃዸገአሙ፤","poem":2},{"text":"እሳን ነ ቀቡፍ ቦለ ቆተኒ፣","poem":1},{"text":"ሚለኮቲፍስ ክዮ ካአኒሩቲ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ያ ዋቀዮ፣ አት ገሩ መለ እሳን ነ አጄሱፍ","poem":1},{"text":"መለተን ሁንደ ንቤክተ።","poem":2},{"text":"የከሳኒ ህንዺስኒፍ፤","poem":1},{"text":"ዮካን ጩቡሳኒ ፉለኬ ዱራ ህንሀቅን።","poem":2},{"text":"እሳን ፉለኬ ዱረት ለፈት ሃገተመን፤","poem":1},{"text":"ዬሮ ዼከምቱትስ እሳን አደብ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JER/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JER/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JER/17.json","previousChapterAudioLinks":{},"numberOfVerses":23}