{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_ebi","name":"ኤርምያስ","commonName":"ኤርምያስ","title":"ራጂ ኤርምያስ","order":24,"numberOfChapters":52,"sha256":"e08276404fb1cf1f464d515eb4d9024ff6266c1a4a4283b37b28fd31b4fd4e55","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_ebi/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":2,"content":[{"type":"heading","content":["እስራኤል ዋቀ ገንቴ"]},{"type":"verse","number":1,"content":["ዱቢን ዋቀዮ አከነ ጄዼ ገረኮ ዹፌ፤"]},{"type":"verse","number":2,"content":["“ዸቂቲ ጉረ ዬሩሳሌምት አከነ ጄዺ ለብስ፦",{"lineBreak":true},"“ዋቀዮ አከነ ጄዸ፦",{"text":"“ ‘አን አመነሙማኬ ከን ዬሮ ደርገጉማ፣","poem":1},{"text":"አከ አት አኩመ ምስርቲት ነ ጃለቴ","poem":2},{"text":"ለፈ ገሞጂ ኬሰ፣","poem":1},{"text":"ለፈ ምዻን እት ህንፈጫፈምን ኬሰ ነ ዱካ ቡቴነንያደዸ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እስራኤል ከን ዋቀዮፍ ቁልቁሎፍቴ ሱን፣","poem":1},{"text":"መታ ምዻንሳ ቱርቴ፤","poem":2},{"text":"ወር እሼ ኛተን ሁንድስ","poem":1},{"text":"አከ ነመ የከ ሆጄቴት እላለሙ ቱሬ፤","poem":2},{"lineBreak":true},{"text":"በዲስንስ እሳንት ዹፌ’ ” ጄዸ ዋቀዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ያ መነ ያቆብ፣","poem":1},{"text":"እስን ማቲወን መነ እስራኤል ሁንድኑስዱቢ ዋቀዮ ዸገኣ።","poem":2}]},{"type":"verse","number":5,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“አቦቲንኬሰን ከን አከስ ነራ ፈጋተን","poem":1},{"text":"በሌሳ ማሊ ነረት አርገኒቲ?","poem":2},{"text":"እሳን ዋቆተ ቶልፈሞ ፋይዳ ህንቀብኔ ፋነ ቡአኒ","poem":1},{"text":"እሳኑምቱ ወረ ፋይዳ ህንቀብኔ ተአን።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እሳንስ፣ ‘ዋቀዮ እን ግብጢ ኑ ባሴ፣","poem":1},{"text":"ገሞጂ ሆምቱ ኬሰ ህንጅሬ ኬሳን፣","poem":2},{"text":"ለፈ ገሞጂፊ ዾቃ ኬሳን","poem":1},{"text":"ለፈ ሆንጌፊ ዱከና፣","poem":2},{"text":"ብየ ነምን ቶኮዩ ኬሰ ህንደበሬፊ","poem":1},{"text":"ኬሰ ህንጅራትኔ ኬሳን ደበርሴ","poem":2},{"lineBreak":true},{"text":"ኑ ፍዴ ሱን ኤሰ ጅረ?’ ጄዸኒ ህንጋፈትኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አን አከ እስን እጀሼ ኛተኒ ምዻንሼት ገመደኒፍ","poem":1},{"text":"ገረ ለፈ ገበታት እስን ፍዴረ።","poem":2},{"text":"እስን ገሩ ዹፍተኒ ብየኮ ጡሬስተን፤","poem":1},{"text":"ሀንዹራኮስ አከ ጅበሙ ጎተን።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሉቦትንስ፣ ‘ዋቀዮ ኤሰ ጅረ?’","poem":1},{"text":"ጄዸኒ ህንጋፈትኔ።","poem":2},{"text":"ወር ሴረ ወጅን ኦለንስ ነ ህንቤክኔ፤","poem":1},{"text":"ቡልችቶትን ነት ፍንጭለን፤","poem":2},{"text":"ራጆትንስ ዋቆተ ፋይዳ ህንቀብኔ ዱካ ቡአኒ","poem":1},{"text":"መቃ በኣሊን ራጂ ዱበተን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ከናፉ አን አመዩ እስን ወጅን ፈልሚ ቀበ”","poem":1},{"text":"ጄዸ ዋቀዮ።","poem":2},{"lineBreak":true},{"text":"“እጆሌ እጆሌኬሰኒ ወጅንስ ፈልሚ ነንቀባዸ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሜ ገረ ቀርቀረ ክቲምት ጬኣቲ እላላ፤","poem":1},{"text":"ገረ ቄዳርትስ ነመ ኤርጋቲ ቀልቢዻን ቆረዻ፤","poem":2},{"lineBreak":true},{"text":"ዮ ዱራን ወን አከሲ ተኤ ጅራቴስ እላላ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዮ እሳን ዋቆተ ተኡ ባተንዩ","poem":1},{"text":"ሰብን ቶኮ ተኩማ ዋቆተሳ ጌደሬ ቤካ?","poem":2},{"text":"ኡመትንኮ ገሩ","poem":1},{"text":"ኡልፍነሳ ዋቆተ ቶልፈሞፋይዳ ህንቀብኔን ጌደሬረ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ያ ሰሚወን፣ ዋን ከነ ድንቅፈዻ፤","poem":1},{"text":"ናሱ ጉዳዻንስ ሆለዻ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“ኡመትንኮ ጩቡ ለመ ሆጄቴ፦","poem":1},{"lineBreak":true},{"text":"እሳን አነ ቡርቃ ብሻን ጅሬኛ ዺሰኒ","poem":1},{"text":"ቦለ ብሻኒ ኦፊሳኒ፣","poem":2},{"text":"ቦለ ብሻኒ በቀቃ","poem":1},{"text":"ብሻን ቀበቹ ህንደንዴኜ ቆተተኒሩ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እስራኤል ገርባ? እን ገርብቸ መነት ዸለቴ?","poem":1},{"text":"ዮስ እን ማሊፍ ቦጅአሜሬ?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሌንጮትን ኣደኒሩ፤","poem":1},{"text":"እሰትስ ጉሩርአኒሩ።","poem":2},{"text":"እሳን ብየሳ ኦንሰኒሩ፤","poem":1},{"text":"መጋላወንሳስ ጉበመኒ ዱዋ ሀፈኒሩ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አከሱመስ ነሞትን ሜምፊሲፊ","poem":1},{"text":"ተህጳንሄስ መታኬ ቡሩቅሰኒሩ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አት ዬሮ እን ከራረ ስ ቀጄልቼት፣","poem":1},{"text":"ዋቀዮን ዋቀኬ ዺሱዻን","poem":2},{"lineBreak":true},{"text":"ዋን ከነ ኦፍት ፍዴርተ ምቲ?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ኤጋ አት ማሊፍ ሽሆሪ ብሻን ዹጉፍ ጄቴ","poem":1},{"text":"ብየ ግብጥ ዸቅጠ?","poem":2},{"text":"ማሊፍስ ብሻን ለገ ኤፍራጢስ","poem":1},{"text":"ዹጉፍ ጄቴ አሶር ዸቅጠ?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሀምንኬ ስ አደበ፤","poem":1},{"text":"ዱበት ዴብኡንኬስ ስ እፈተ።","poem":2},{"text":"አት ዋቀዮን ዋቀኬ ዺፍቴ","poem":1},{"text":"ነ ሶዳቹ ድዱንኬ","poem":2},{"text":"ሀመም ሀማፊ ሀዻኣ አከ ስት ተኤ እላሊ ሁበዹ”","poem":1},{"text":"ጄዸ ጎፍታን፣ ዋቀዮ ዋን ሁንደ ደንደኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“አን በረ ዼራን ዱረ ዋንጆኬ ስራ ጨብሴረ፤","poem":1},{"text":"ህዻኬስ ስራ ኩኩቴረ።","poem":2},{"lineBreak":true},{"text":"አት ገሩ፣ ‘አን ስ ህንተጃጅሉ’ ጄቴ!","poem":2},{"text":"አት ገሩ አኩመ ሰጋገልቱ ቶኮት","poem":1},{"text":"ቱሉወን ዼዼሮ ሁንደራፊ","poem":2},{"lineBreak":true},{"text":"ሙኬን ለልሶ ሁንደ ጀለ ጪፍቴ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አን ገሩ ሙከ ወይኒ ፍለተማ፣","poem":1},{"text":"ከን ሰኚንሳ ጉቱማን ጉቱት ቁልቁሉ ተኤ ጎዼስ ዻበዼን ቱሬ።","poem":2},{"text":"ዮስ አት አከምት ወይኒ ዲዳ","poem":1},{"text":"ታቴ ነት ጌደረምቴሬ?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"አት ዮ ዳራዻን ዽቀቴ","poem":1},{"text":"ሳሙና ሄዱት ፈየደምቴዩ፣","poem":2},{"lineBreak":true},{"text":"ጡሪን የከኬቲ አመሌ ፉለኮ ዱረ ጅረ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ ጎፍታን።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"“አት አከምት፣ ‘አን ህንጡሮፍኔ፤","poem":1},{"text":"በኣል ዱካስ ህንቡኔ’ ጄቹ ደንዴሰ?","poem":2},{"text":"ዋን ሱሉለ ኬሰት ተኣ ቱርቴ ያደዹ፤","poem":1},{"text":"ዋን ሆጄቻ ቱርቴስ ቀልቤፈዹ።","poem":2},{"text":"አት ጋለ ዸላ አሲፊ","poem":1},{"text":"አች ፊግዱዸ፤","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ሀሬ ዲዳ ከን ገሞጂ በረቴ","poem":1},{"text":"ፌዺ ኮርማቲን ቅሌንሰ ሱፈቱ ቶኮ፣","poem":2},{"lineBreak":true},{"text":"ማልቱ ፌዺሼራ እሼ ዴብሱ ደንደአ?","poem":2},{"text":"ኮርም እሼ በርባዱ ከምዩ እሼ አርገቹፍ ህንረከቱ፤","poem":1},{"text":"እን ዬሮ ጋናት እሼ አርገተ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ሚለኬ ኮጴ መሌ ዴሙራ፣","poem":1},{"text":"ላጋኬሞ ዼቡራ ኤገዹ።","poem":2},{"text":"አት ገሩ፣ ‘ኩን ዋን አብዲ ህንቀብኔዸ!","poem":1},{"text":"አን ዋቆተ ኦርማ ነንጃለዸ፤","poem":2},{"lineBreak":true},{"text":"እሳን ፋነስ ነንቡአ’ ጄቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“አኩመ ሀቱን ዬሮ ቀበምቱ ሰልጵፈምቱ ሰነ","poem":1},{"text":"መን እስራኤል ንሰልጵፈመ፤","poem":2},{"text":"እሳን፣ ሞቶትንሳኒቲፊ ቆንዳልቶትንሳኒ፣","poem":1},{"text":"ሉቦትንሳኒቲፊ ራጆትንሳኒ ንሰልጵፈሙ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"እሳን ሙካን፣ ‘አት አባኮት፣’","poem":1},{"text":"ዸጋዻንሞ፣ ‘ስቱ ነ ዸሌ’ ጄዹ።","poem":2},{"text":"እሳን ዱግደሳኒ መሌ","poem":1},{"text":"ፉለሳኒ ነት ህንዴብፈትኔቲ፤","poem":2},{"text":"ተኡስ እሳን ዬሮ ረከተንት፣","poem":1},{"text":"‘ኮቱ ኑ ባስ!’ ጄዹ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ዋቆትን አት ኦፊፍ ቶልፈቴ ሱን ኤሰ ጅሩ?","poem":1},{"text":"እሳን ዮ ስ ባሱ ደንደአን","poem":2},{"lineBreak":true},{"text":"ሜ ዬሮ አት ረክነ ኬሰ ጅርቱት ሃዹፈን!","poem":2},{"text":"ያ ይሁዳ፣ አት አኩመ መጋላ ሄዱ ቀብዱ ሰነ","poem":1},{"text":"ዋቆተ ሄዱ ቀብዳቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“እስን ማሊፍ ነ ህመቱ?","poem":1},{"text":"እስን ሁንድኑ ነት ፍንጭልተኒርቱ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"“አን አከሱማነን እጆሌኬሰን አደቤ፤","poem":1},{"text":"እሳን ስሬፈመ ፉዸቹ ድደን።","poem":2},{"text":"ጎራዴንኬሰን አኩመ","poem":1},{"text":"ሌንጨ ቤለኤ ቶኮት ራጆተኬሰን ፍጤ።","poem":2}]},{"type":"verse","number":31,"content":["“እስን ዸሎትን አማ ዱቢ ዋቀዮ ቀልቤፈዻ፦",{"text":"“እስራኤሊፍ ገሞጂ","poem":1},{"text":"ዮካን ብየ ዱከነ ሀማን ቱሬ?","poem":2},{"text":"ሰብንኮ ማሊፍ፣ ‘ኑ አሲፊ አች ጆሩ ንደንዴኘ፤","poem":1},{"text":"ስአች ገረኬ ህንዹፍኑ’ ጄዸ?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ዱርብ ቶኮ ፋየሼ፣","poem":1},{"text":"ምስር