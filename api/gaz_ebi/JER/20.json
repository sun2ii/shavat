{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_ebi","name":"ኤርምያስ","commonName":"ኤርምያስ","title":"ራጂ ኤርምያስ","order":24,"numberOfChapters":52,"sha256":"e08276404fb1cf1f464d515eb4d9024ff6266c1a4a4283b37b28fd31b4fd4e55","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_ebi/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":20,"content":[{"type":"heading","content":["ኤርምያሲፊ ጳሽሁር"]},{"type":"verse","number":1,"content":["ጳሽሁር ሉብች፣ እልም እሜሪ እን መነ ቁልቁሉማ ዋቀዮ ኬሰት ቡልቻ ሀንገፈ ቱሬ ሱን ዮሙ ኤርምያሲ ዋን ከነ ራጁ ዸገኤት፣"]},{"type":"verse","number":2,"content":["አከ ኤርምያስ ራጅች ቱመሜ ከረ ቤንያም እሰ ኦል ኣኑ ከን መነ ዋቀዮ ብረት አርገሙ ሰነ ኬሰት ሚልሳ ጅርመ ለመ ግዱ ገሌ ህዸሙ ጎዼ።"]},{"type":"verse","number":3,"content":["ኤርምያስስ ጉያ እት ኣኑ ዬሮ ጳሽሁር ጅርመ ለማን ግዱዻ እሰ ባሴት አከነ ጄዼን፤ “መቃን ዋቀዮ ሲፍ ባሴ ማጎርሚሳቢብ መሌ ጳሽሁር ምት።"]},{"type":"verse","number":4,"content":["ዋቀዮ አከነ ጄዻቲ፤ ‘አን አከ አት ኦፊኬቲፊ ምቾተኬት ሶዳችሳ ታቱ ስን ጎዸ፤ ዬሮ እሳን ጎራዴ ዲኖተሳኒቲን ዹመን እጁመኬቲን አርግተ። አን ይሁዳ ሁንደ ደበርሴ ሞቲ ባብሎኒት ነንኬነ፤ እንስ ባብሎንት እሳን ጌሰ ዮካን ጎራዴዻን እሳን ፍጠ።"]},{"type":"verse","number":5,"content":["አን ቀቤኘ መጋላ ከና ሁንደ ጄቹንስ ኦምሸሼ ሁንደ፣ ዋን ገቲ ጉዳ ቀቡ ሁንዳፊ በዻዹማ ሞቶተ ይሁዳ ሁንደ ደበርሴ ዲኖተሳኒት ነንኬነ። እሳንስ ቦጅአኒ ፉዸተኒ ባብሎንት እሳን ጌሱ።"]},{"type":"verse","number":6,"content":["ያ ጳሽሁር አት፣ ወር መነኬ ጅራተን ሁንድስ ቦጅአምተኒ ባብሎንት ጌፈምቱ። አቲፊ ምቾተኬ ወር አት ራጂ ሶባ ዱበቴፍ ሁንድ አችት ዱተኒ አዋለምቱ።’ ”"]},{"type":"heading","content":["ጉንጉሚ ኤርምያስ"]},{"type":"verse","number":7,"content":[{"text":"ያ ዋቀዮ፣ አት ነ ጎዎምስቴ፤አንስ ነንጎዎምፈሜ፤","poem":1},{"text":"አት ሁምናን ነ ጫልቴ ነ ሞአቴ።","poem":2},{"text":"አን ጉያ ጉቱ ዋን ኮልፋ ነንተኤ፤","poem":1},{"text":"ነምን ሁንድስ ነት ቆሰ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አን ዬሮን ዱበዹ ሁንደ ነንእየ፤","poem":1},{"text":"“ጎሊ፣ በዲሰ” ጄዼስ ነንለብሰ።","poem":2},{"text":"ከናፉ ዱቢን ዋቀዮ","poem":1},{"text":"ጉያ ጉቱ አረብሶፊ ቱፊ ነት ፍዴ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ገሩ ዮ አን፣ “አን መቃሳ ህንዸኡ","poem":1},{"text":"ዮካን ስአች መቃሳቲን ህንዱበዹ” ጄዼ፣","poem":2},{"text":"ዱቢንሳ ኦኔኮ ኬሰት አከ እብዳ፣","poem":1},{"text":"አኩመ እብደ ለፌኮ ኬሰት ኡካምሰሜት።","poem":2},{"text":"አን ኦፍ ኬሰት እሰ ቀበቹ ነንደዸቤ፤","poem":1},{"text":"ዹጉመዩ አን ህንደንደኡ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አን ሀሳሰ፣ “ከራ ሁንዳን ሶዳ!","poem":1},{"text":"እሰ በላሌፈዻ! እሰ ሃበላሌፈትኑ!”","poem":2},{"lineBreak":true},{"text":"ጄዹ ሄዱ ነንዸገአ።","poem":2},{"text":"ምቾትንኮ ሁንድ፣","poem":1},{"text":"“እን ንጎዎምፈመ ተአ፤","poem":2},{"text":"ኑስ ኤርገሲ እሰ ንሞአትነ፤","poem":1},{"text":"ሃሎኬኘሌ ንባፈትነ” ጄቻ","poem":2},{"lineBreak":true},{"text":"ኩፋቲኮ ኤገቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ዋቀዮ ገሩ አኩመ ጎተ ሁምነ ቀቤሰ ቶኮትነ ወጅን ጅረ፤","poem":1},{"text":"ከናፉ ወር ነ አደምሰን ንጉፈቱ መሌ ህንሞአተን።","poem":2},{"text":"እሳን ባይኤ ቃኔፈመን፤ ህንምልካአኒቲ፤","poem":1},{"text":"ሰልጵንሳኒ ጎንኩማ ህንእራንፈተሙ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ያ ዋቀዮ ዋን ሁንደ ደንዴሱ፣","poem":1},{"text":"ከን ነመ ቀጄላ ቆርቱ፣","poem":2},{"lineBreak":true},{"text":"ከን ገራፊ ያደ ነማ ኬሰ አርግቱ፣","poem":2},{"text":"አን ፈልሚኮ ስት ኬነዼራቲ","poem":1},{"text":"አት ዬሮ እሳንት ሃሎ ባቱ ነ አርግሲስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ዋቀዮፍ ፋርፈዻ!","poem":1},{"text":"ዋቀዮን ገለቴፈዻ!","poem":2},{"text":"እን ሉቡ ነሞተ ህዬዪ","poem":1},{"text":"ሀርከ ሀሞታቲ ንባሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ጉያን አን ዸለዼ ሃአባረሙ!","poem":1},{"text":"ጉያን ሃትኮ ነ ዴሴ ሱንስ ህንኤብፈምን!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ነምች፣ “ዳእምን ቶኮ ጄቹንስ","poem":1},{"text":"እልም ሲፍ ዸለቴ ጅረ!” ጄዼ አባኮቲፍ ኦዱ ፍዴ","poem":2},{"lineBreak":true},{"text":"አከ መሌ እሰ ገመቺሴ ሱን ሃአባረሙ!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ነምች ሱን አኩመ መጋላወን","poem":1},{"text":"ዋቀዮ ገረ ላፍነ መሌ ገረገልቼ ሃተኡ።","poem":2},{"text":"እን ገነማን ወዋትና፣","poem":1},{"text":"ሳፋንሞ እየ ወራና ሃዸገኡ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አከ ሃትኮ አዋለ ና ታቱፍ፣","poem":1},{"text":"አከ ገደሜስሼስ እዶ ጅሬኘ በረ በራ ናፍ ተኡፍ","poem":2},{"lineBreak":true},{"text":"እን ኡቱ አን ገደሜሰ ኬሳ ህንበእን ነ ህንአጄፍኔቲ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"አን ማሊፈን ረክናፊ ገደ አርጉፍ","poem":1},{"text":"ጅሬኘኮስ ቃኒን ፍጡፍ","poem":2},{"lineBreak":true},{"text":"ገደሜሰ ኬሳ በኤ?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JER/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JER/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JER/19.json","previousChapterAudioLinks":{},"numberOfVerses":18}