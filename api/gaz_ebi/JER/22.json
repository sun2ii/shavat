{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_ebi","name":"ኤርምያስ","commonName":"ኤርምያስ","title":"ራጂ ኤርምያስ","order":24,"numberOfChapters":52,"sha256":"e08276404fb1cf1f464d515eb4d9024ff6266c1a4a4283b37b28fd31b4fd4e55","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_ebi/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":22,"content":[{"type":"heading","content":["ሙርቲ ሞቶተ ሀሞት ሙረሜ"]},{"type":"verse","number":1,"content":["ዋቀዮ አከነ ጄዸ፦ “ገረ መሰራ ሞቲ ይሁዳት ገድ ቡኢቲ አከነ ጄዺ ኤርጋ ከነ አችት ለብስ፤"]},{"type":"verse","number":2,"content":["‘ያ ሞቲ ይሁዳ፣ አት ከን ቴሶ ዳዊትረ ቴሱ፣ አት፣ ቆንዳልቶትንኬቲፊ ሰብንኬ ወር ከረ ከናን ኦል ገልተን ዱቢ ዋቀዮ ዸገኣ።"]},{"type":"verse","number":3,"content":["ዋቀዮ አከነ ጄዸ፦ ዋን ቀጄላፊ ስሪ ተኤ ሆጄዻ። ነመ ሳመሜ ቶኮ ሀርከ ነመ እሰ ጩንቁርሱቲ ባሳ። አለጋት፣ እጆሌ አባ ህንቀብኔት ዮካን ሃዸ ህዬሳት ደበ ዮካን ጀልእነ ህንሆጄትና፤ ዺገ ነመ በሌሳ ህንቀብኔስ እዶ ከነት ህንዸንገላስና።"]},{"type":"verse","number":4,"content":["ዮ እስን አጀጀወን ከኔን ስሪት ኤግደን ሞቶትን ቴሶ ዳዊትረ ታአን፣ ቆንዳልቶታፊ ሰበሳኒ ወጅን ጋሪ ሞቶታቲፊ ፈርዴን ያበተኒ ከረወን መሰራ ሞቱማ ከናን ኦል ገሉ።"]},{"type":"verse","number":5,"content":["ዮ እስን አጀጀወን ከኔን ኤጉ ባተን ገሩ አከ መሰራን ሞቱማ ኩን በርበዴፈሙ አን መቃኮቲን ከከዼረ፣ ጄዸ ዋቀዮ።’ ”"]},{"type":"verse","number":6,"content":["ዋቀዮ ዋኤ መሰራ ሞቲ ይሁዳ አከነ ጄዻቲ፦",{"text":"“አት አከ ግልኣድ፣","poem":1},{"text":"አከ ፊጤ ልባኖን ናፍ ታቴዩ፣","poem":2},{"text":"አን ዹጉማን አከ ገሞጂ፣","poem":1},{"text":"አከ መጋላወን ነምን ኬሰ ህንጅራትኔ ስን ታስሰ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አን በሌስቶተ ቶኮን ቶኮንሳኒ","poem":1},{"text":"ምአ ሎላ ቀበተን፣ ስት ነንኤርገ፤","poem":2},{"text":"እሳንስ ብርብርሰኬ ፍለተማ ንጭሩ፤","poem":1},{"text":"እብደትስ ንነቁ።","poem":2}]},{"type":"verse","number":8,"content":["“ነሞትን ብየ ሄዱስ ዮሙ መጋላ ከነ ብራን ደርበንት፣ ‘ዋቀዮ ማሊፍ መጋላ ጉዳ ከነት ዋን አከና ፍዴ?’ ጄዸኒ ወል ጋፈቱ።"]},{"type":"verse","number":9,"content":["እሳንስ፣ ‘ሰበቢ እሳን ከኩ ዋቀዮ ዋቀሳኒ ዺሰኒ ዋቆተ ብራ ዋቄፈተኒ ተጃጅለኒፊዸ’ ጄዸኒ ዴብሱ።”"]},{"type":"verse","number":10,"content":[{"text":"እስን ነመ ዱኤፍ ህንቦእና ዮካን ህንገድና፤","poem":1},{"text":"ቆደ ከና ነመ ቦጅአሜፍ ህቅፈዻ ቦኣ፤","poem":2},{"text":"እን ለመተ ህንዴብኡ","poem":1},{"text":"ዮካን ብየ እት ዸለቴ ህንአርጉቲ።","poem":2}]},{"type":"verse","number":11,"content":["ዋቀዮ ዋኤ ሸሉም እልመ ዮስያስ ከን ቆደ አባሳ ሞቲ ይሁዳ ተኤ ገሩ እዶ ከና ዴሜ ሰና አከነ ጄዻቲ፦ “እን ጎንኩማ ህንዴብኡ።"]},{"type":"verse","number":12,"content":["እን እዶ ቦጅአሜ እት ጌፈሜ ሰነት ዱአ፤ ብየ ከነስ ለመፋ ህንአርጉ።”"]},{"type":"verse","number":13,"content":[{"text":"“ነመ ኦላሳ ኡቱ ገቲ ሁምነሳ ህንኬንኒፍ","poem":1},{"text":"አከሱማን ሆጄቺፈቹዻን","poem":2},{"text":"መነሳ ከራ ቀጄላ ህንተእኒን፣","poem":1},{"text":"ኩታሳ ከን መነ ጉባሞ ከራ ስሪ ህንተእኒንእጃረቱፍ ወዮ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እን፣ ‘አን መሰራ ጉዳ ቶኮ፣","poem":1},{"text":"ኩታ መነ ጉባ በልኣሳ ወጅንኦፊኮቲፍ ነንእጃረዸ’ ጄዸ።","poem":2},{"text":"ከናፉ እን ፎዳወን እት ባሴ","poem":1},{"text":"ሙከ ብርብርሳቲን በሬቼ","poem":2},{"lineBreak":true},{"text":"ሀሉ ዲማዻን ሚዸግሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“ብርብርሰ ሄዱ ቀባቹንኬ ሞቲ ስ ታስሳ?","poem":1},{"text":"አባንኬ ኛታ ዹጋቲ ህንቀቡ ቱሬ?","poem":2},{"text":"እን ዋን ቀጄላፊ ሀቀ ሆጄቴ፤","poem":1},{"text":"ከናፉ ወን ሁንድኑ ንቀጄሌፍ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እን ህዬዪፊ ረከቶታፍ ንፈልሜ፤","poem":1},{"text":"ከናፉ ወን ሁንድ ንቀጄሌፍ።","poem":2},{"text":"ነ ቤኩ ጄቹን ከኑመ ምቲ?”","poem":1},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እጅኬቲፊ ገራንኬ ገሩ","poem":1},{"text":"ቡኣ ከራ ህንመልኒን አርገሙረ፣","poem":2},{"text":"ዺገ ነመ በሌሳ ህንቀብኔ ዸንገላሱረ፣","poem":1},{"text":"ጩንቁርሳፊ ጎሊ ካሱ ቆፈረ ቡኤረ።","poem":2}]},{"type":"verse","number":18,"content":["ከናፉ ዋቀዮ ዋኤ ዬሆያቂም ሞትቸ ይሁዳ፣ እልመ ዮስያስ አከነ ጄዸ፦",{"text":"“እሳን፣ ‘አናፍ ወዮ፣ ያ ኦቦሌሰኮ!","poem":1},{"text":"አናፍ ወዮ፣ ያ ኦቦሌቲኮ!’ጄዸኒ ህንቦአኒፍ።","poem":2},{"text":"እሳን፣ ‘አናፍ ወዮ፣ ያ ጎፍታኮ!","poem":1},{"text":"አናፍ ወዮ ያ ኡልፍነሳ!’ጄዸኒ ህንቦአኒፍ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እን አዋለ ሀሬ አርገተ፣","poem":1},{"text":"ጄቹንስ ለፈረ ሀርክፈሜ","poem":2},{"lineBreak":true},{"text":"ከረወን ዬሩሳሌም ኬሳ ገድ ባፈሜ ገተመ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ልባኖንት ኦል በኢ እይ፤","poem":1},{"text":"ሰገሌንኬ ባሻን ኬሰት ሃዸገአሙ፤","poem":2},{"text":"አባሪም ኬሳስ እይ፤","poem":1},{"text":"ምቾትንኬ ሁንድ በርበዴፈመኒሩቲ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አን ዬሮ አት ነጋ ቀብዱት ስ አኬከቺሴን ቱሬ፤","poem":1},{"text":"አት ገሩ፣ ‘አን ህንዸጌፈዹ!’ ጄቴ።","poem":2},{"text":"ኩን እጆሉማኬቲ ጀልቀቤ አመለኬ ቱሬ፤","poem":1},{"text":"አት ናፍ ህንአጀጀምኔ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ትክሶተኬ ሁንደ ቡቤን ፉዸቴ ሶከ፤","poem":1},{"text":"ምቾትንኬስ ንቦጅአሙ።","poem":2},{"text":"ሰበቢ ሀምነኬ ሁንዳቲፍ","poem":1},{"text":"አት ንቃኖፍተ፤ ንሰልጰተስ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"አት ከን ልባኖን ኬሰ ጅራቱ፣","poem":1},{"text":"ከን ሙከ ብርብርሳቲን መነ እጃረቱ፣","poem":2},{"text":"ዬሮ ዽጵን ስ ቀቤ አኩመ ዱበርቲ ጭኒንስፈቱ ቶኮ","poem":1},{"text":"ሚጠቱት አት አከም ኣደ!","poem":2}]},{"type":"verse","number":24,"content":["“አኩመ አን ዹጉማን ጅራታ ተኤ” ጄዸ ዋቀዮ፤ “ያ ዬሆያኪን ሞትቸ ይሁዳ፣ እልመ ዬሆያቂም፣ ዮ አት ቁቤላ ቻፓ ሀርከኮ ምርጋ ታቴሌ አን ባሴን ስ ገተ።"]},{"type":"verse","number":25,"content":["አን ወረ ሉቡኬ ገላፈቹ በርባደንት፣ ወረ አት ሶዳቱ ጄቹንስ ኔቡከድኔዘር ሞትቸ ባብሎኒፊ ባብሎኖተት ደበርሴ ስን ኬነ።"]},{"type":"verse","number":26,"content":["አን ስኢፊ ሃዸ ስ ዴሴ ብየ ብራት፣ ብየ ቶኮንኬሰንዩ እት ህንዸለትንት እስን ነንደርበዻ፤ እስን ለቹ አችት ዱቱ።"]},{"type":"verse","number":27,"content":["እስን ብየ እት ዴብኡ ሀውተንት ጎንኩማ ህንዴብተን።”"]},{"type":"verse","number":28,"content":[{"text":"ዬሆያኪን ኩን ነመ አኩመ ኦኮቴ ጨባ ቱፈተሜ፣","poem":1},{"text":"ምአ ነምን ቶኮዩ ህንበርባኔዻ?","poem":2},{"text":"እጆሌንሳቲፊ እን ማሊፍ","poem":1},{"text":"ደርበተመኒ ብየ ህንቤክኔት ገተመን?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ያ ለፋ፣ ያ ለፋ፣ ያ ለፋ፣","poem":1},{"text":"ዱቢ ዋቀዮ ዸገእ!","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ዋቀዮ አከነ ጄዸ፦","poem":1},{"lineBreak":true},{"text":"“ነምቸ ከነ አከ ነመ እጆሌ ህንቀብኔ ቶኮት፣","poem":1},{"text":"አከ ነመ በረ ጅሬኘሳ ኬሰ ህንምልኮፍኔ ቶኮት ገልሜሳ፤","poem":2},{"text":"ሰኚሳ ኬሳ ነምን ቶኮዩ ህንምልካኡ፣","poem":1},{"text":"ነምን ቶኮዩ ቴሶ ዳዊትራ ህንታኡ፣","poem":2},{"lineBreak":true},{"text":"ዮካን ስአች ይሁዳ ህንቡልቹቲ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JER/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JER/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JER/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}