{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_ebi","name":"ኤርምያስ","commonName":"ኤርምያስ","title":"ራጂ ኤርምያስ","order":24,"numberOfChapters":52,"sha256":"e08276404fb1cf1f464d515eb4d9024ff6266c1a4a4283b37b28fd31b4fd4e55","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_ebi/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"“ነምን ቶኮ ዮ ኒቲሳ ሂኬ","poem":1},{"text":"እሼንስ እሰ ዺፍቴ ነመ ብራት ሄሩምቴ፣","poem":2},{"text":"እን ለመተ እሼት ዴብኣ?","poem":1},{"text":"ብየቲንስ ጉቱማን ጉቱት ህንጡሮፍቱ?","poem":2},{"text":"አት ገሩ አከ ሰጋገልቱትሰኞወን ሄዱ ወጅን ጅራቴርተ፤","poem":1},{"text":"ተኡስ አመ ገረኮት ዴብእ?”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“ሜ ኦል ምልአዹቲ ጋረ ዱዋ እላል።","poem":1},{"text":"እዶን አት እት ህንሰጋገልን ቶኮዩ ጅራ?","poem":2},{"text":"አት አኩመ ጎዳንቱ ገሞጂ ኬሳ ቶኮት","poem":1},{"text":"ወረ ስ ጃለተን ኤገቹፍ ቀርቀረ ከራ ቴሴ፤","poem":2},{"text":"ሰጋገልቱማፊ ሀምነኬቲን","poem":1},{"text":"ብየቲ ጡሬስቴርተ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ከናፉ ቲፉን ንእትፈሜ፤","poem":1},{"text":"ብራ ኬሰሌ ቦካን ህንሮብኔ።","poem":2},{"text":"አት ገሩ ኛረ ሰጋገልቱ ቀብደ፤","poem":1},{"text":"ቃነኡስ ንድዴ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አት አመዩ አከነ ጄቴ ነ ህንዋምኔ?","poem":1},{"text":"‘አባኮ፣ እጆሉማኮቲ ጀልቀብዴ ምቹኮ፣","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አት ዬሮ ሁንደ ንኣርታ?","poem":1},{"text":"ዼከምስኬ በሩመ በራን እት ፉፋ?’","poem":2},{"text":"አት አከስት ዱበተ፤","poem":1},{"text":"ገሩ ዋን ሀማ ደንዴሱ ሁንደ ንሆጄተ።”","poem":2}]},{"type":"heading","content":["እስራኤል አመነሙማ ዸብዴ"]},{"type":"verse","number":6,"content":["ዋቀዮ በረ ዮስያስ ሞትቻ ኬሰ አከነ ናን ጄዼ፤ “አት ዋን እስራኤል እሼን አመነሙማ ህንቀብኔ ሱን ሆጄቴ አርግቴ? እሼን ዸቅጤ ቱሉ ኦል ዼራ ሁንደረቲፊ ሙከ ለልሳ ሁንደ ጀለት ሰጋገልቴ።"]},{"type":"verse","number":7,"content":["አን ዋን እሼን ኤርገ ወንቶተ ከኔን ሁንደ ሆጄቴ ቦዴ ገረኮት ዴብቱ ሴኤን ቱሬ፤ እሼን ገሩ ህንዴብኔ። ኦቦሌቲንሼ ይሁዳን ህንአመነምኔ ሱንስ ዋን ከነ አርግቴ።"]},{"type":"verse","number":8,"content":["አን ሰበቢ ኤጁማሼ ሁንዳቲፍ ወረቃ ረጋ ሂካ ኬኔፊን እስራኤል አመነሙማ ህንቀብኔ ሰነ ኦፍራ አርኤ፤ ተኡሌ አን አከ ኦቦሌቲንሼ ይሁዳን አመነሙማ ህንቀብኔ ሱን ህንሶዳትኔ ነንአርጌ፤ እሼንስ ዸቅጤ ኤጅቴ።"]},{"type":"verse","number":9,"content":["እስራኤል ሰበቢ ሰጋገሉማ ኦፊ አከ ዋን ሰልጳ ቶኮት እላልቴፍ ዸጋፊ ሙከ ወጅን ኤጁዻን ብየ ጡሬስቴ።"]},{"type":"verse","number":10,"content":["እሼን ዋን ከነ ሁንደ ሆጄቱዩ ኦቦሌቲንሼ ይሁዳን ህንአመነምኔ ሱን ፈኬሱፍ መሌ ገራ ጉቱዻን ገረኮት ህንዴብኔ” ጄዸ ዋቀዮ።"]},{"type":"verse","number":11,"content":["ዋቀዮ አከነ ናን ጄዼ፤ “ይሁዳ ህንአመነምኔረ እስራኤል አመንቲ ህንቀብኔቱ ቀጄልቱዸ።"]},{"type":"verse","number":12,"content":["ዸቂቲ ኤርጋ ከነ ካበት ለብስ፦",{"text":"“ ‘ያ እስራኤል አመንቲ ዸቤቲ፣ ዴብእ’ ጄዸ ዋቀዮ፤","poem":1},{"text":"‘አን ስአች እጀ ኣሪቲን ስ ህንእላሉ፤","poem":2},{"text":"አን አራረ ቀቤሳቲ’ ጄዸ ዋቀዮ።","poem":1},{"text":"‘አን በረ በራን ህንዼከሙ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አት አከ ዋቀዮ ዋቀኬት ፍንጭልቴ፣","poem":1},{"text":"አከ ሙኬን ለልሶ ሁንደ ጀለት","poem":2},{"text":"ጃለለኬ ዋቆተ ኦርማቲፍ ኬንቴ ና አጀጀሙ ድዴ፣","poem":1},{"text":"በሌሳኬ ሰነ ቆፈ ህመዹ’ ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":14,"content":["“ያ ሰበ አመንቲ ህንቀብኔ፣ ዴብኣ” ጄዸ ዋቀዮ፤ “አን ዽርሰኬሰኒቲ። አን መጋላ ቶኮራ ነመ ቶኮ፣ በልበለ ቶኮራ ነመ ለመ ፍለዼ ጥዮንት እስን ነንፍደ።"]},{"type":"verse","number":15,"content":["ኤርገሲ አን ትክሶተ አከ ገራኮቲ ተአን፣ ከኔን ቤኩምሳፊ ሁበትናዻን እስን ቀጄልቸን እስኒ ነንኬነ።"]},{"type":"verse","number":16,"content":["በረ ሰነ ኬሰ፣ ዬሮ ባይእንኬሰን ብየቲ ኬሰት አከ መሌ ጉደቱት፣” ጄዸ ዋቀዮ፣ “ነሞትን ስአች፣ ‘ታቦተ ከኩ ዋቀዮ’ ህንጄዸን።” ወን ኩን ጎንኩማ ሰሙሳኒ ኬሰ ህንሴኑ፣ ዮካን ህንያደተሙ፤ ከን እሰ በርባዱ ህንጅሩ፣ ዮካን ከን ብራ ህንቶልፈሙ።"]},{"type":"verse","number":17,"content":["እሳን ዬሮ ሰነት ዬሩሳሌሚን ቴሶ ዋቀዮ ጄዸኒ ዋሙ፤ ሰቦትን ሁንድኑስ መቃ ዋቀዮ ኡልፌሱፍ ዬሩሳሌምት ወልት ንቀበሙ። እሳን ስአች መተ ጀብነ ሀምነ ገራሳኒ ዱካ ህንቡአን።"]},{"type":"verse","number":18,"content":["በረ ሰነ ኬሰ መን ይሁዳ መነ እስራኤልት ንመከመ፤ እሳንስ ቶኩማዻን ብየ ካባቲ ገረ ብየ አን አከ ዻላት አቦቲኬሰኒፍ ኬኔ ሰና ንዹፉ።"]},{"type":"verse","number":19,"content":["“አን መታንኮ አከነ ነንጄዼ፤",{"text":"“ ‘አን ስላ ሀመን አኩመ እልማንኮት","poem":1},{"text":"ስ ፉዸዼ ብየ ነመት ቶልቱ፣","poem":2},{"lineBreak":true},{"text":"ዻለ አከ መሌ ሚዸጉ ከን ሰበ ከሚዩሲፍ ነንኬነ ቱሬ።’","poem":2},{"text":"አን ዋን አት፣ ‘አባኮ’ ጄቴ ነ ዋምቱፍ፣","poem":1},{"text":"ዋን አት ነ ዱካ ቡኡ ህንዺፍኔ ሴኤ ቱሬ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ያ መነ እስራኤል፣","poem":1},{"text":"አት ገሩ አኩመ ኒቲ ዽርሰሼቲፍ ህንአመነምኔ ቶኮ፣","poem":2},{"lineBreak":true},{"text":"አናፍ ህንአመነምኔ ቱርቴ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"እሳን ከራሳኒ ጀልእሰኒ","poem":1},{"text":"ዋቀዮ ዋቀሳኒ ዋን እራንፈተኒፍ","poem":2},{"text":"ጋረ ዱዋረት እይ፣","poem":1},{"text":"ቦእቺፊ ዋመናን ሰበ እስራኤል ንዸገአመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“ያ ሰበ አመንቲ ህንቀብኔ ዴብኣ፤","poem":1},{"text":"አን ዱበት ዴብኡኬሰን ነንፈይሳቲ።”","poem":2},{"lineBreak":true},{"text":"“ኩኖ፣ ኑ ገረኬ ንዹፍነ፤","poem":1},{"text":"አት ዋቀዮ ዋቀኬኛቲ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዹጉማን ወጭን ጋረኒፊ","poem":1},{"text":"ቱሉወንራ ጎዎምሳዸ፤","poem":2},{"text":"ዹጉማን ፈይን እስራኤል","poem":1},{"text":"ሀርከ ዋቀዮ ዋቀኬኛ ጅረ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"እጆሉማኬኛ ጀልቀብኔ ዋቆትን ነመ ቃኔሰን፣","poem":1},{"text":"ቡኣ ደዸቢ አቦቲኬኛ","poem":2},{"text":"ጄቹንስ ቡሻዬፊ ሎንሳኒ፣","poem":1},{"text":"እልማንሳኒቲፊ እንተለንሳኒ ፍጠኒሩ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ኑ ቃኒኬኛን ሃጪፍኑ፤","poem":1},{"text":"ሰልጵንኬኘስ ኑ ሃሀጉጉ።","poem":2},{"text":"ኑስ አቦቲንኬኘስ ዋቀዮ ዋቀኬኘት","poem":1},{"text":"ጩቡ ሆጄትኔረ፤","poem":2},{"text":"ኑ እጆሉማኬኛ ጀልቀብኔሀመ አማት","poem":1},{"text":"ዋቀዮ ዋቀኬኛፍ ህንአጀጀምኔ።”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JER/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JER/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JER/2.json","previousChapterAudioLinks":{},"numberOfVerses":25}