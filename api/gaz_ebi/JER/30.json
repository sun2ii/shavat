{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_ebi","name":"ኤርምያስ","commonName":"ኤርምያስ","title":"ራጂ ኤርምያስ","order":24,"numberOfChapters":52,"sha256":"e08276404fb1cf1f464d515eb4d9024ff6266c1a4a4283b37b28fd31b4fd4e55","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_ebi/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":30,"content":[{"type":"heading","content":["ሰብን እስራኤል ቦጁዻ ዴብኤ"]},{"type":"verse","number":1,"content":["ዱቢን ዋቀዮ ብራ ገረ ኤርምያስ ዹፌ እሰ ከናዸ፦"]},{"type":"verse","number":2,"content":["“ዋቀዮ ዋቅን እስራኤል አከነ ጄዸ፦ ‘ዱቢ አን ስት ዱበዼ ሁንደ ክታበት በሬስ።"]},{"type":"verse","number":3,"content":["በር ቶኮ ንዹፈ’ ጄዸ ዋቀዮ፤ ‘እንስ ዬሮ አን እት ሰበኮ እስራኤሊፊ ይሁዳ ቦጁዻ ዴብሴ ብየ አን አከ እሳን ዻለኒፍ አቦቲሳኒቲፍ ኬኔ ሰነት እሳን ገልቹዸ፣’ ጄዸ ዋቀዮ።”"]},{"type":"verse","number":4,"content":["ዱቢን ዋቀዮ ዋኤ እስራኤሊፊ ይሁዳ ዱበቴ ከናዸ፦"]},{"type":"verse","number":5,"content":["“ዋቀዮ አከነ ጄዸ፦",{"text":"“ ‘እይ ሶዳ ንዸገአመ፤","poem":1},{"text":"ኩን ራፈመ መሌ ነጋ ምት።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሜ እያፈዻ እላላ፦","poem":1},{"text":"ዺር ቶኮ ደኡ ንደንደኣ?","poem":2},{"text":"ዮስ አን ማሊፈን ዺረ ሁንደ እሳ አኩመ ዱበርቲ ጭኒንስፈቱ፣","poem":1},{"text":"ሀርከሳ ገራ ኦፊሳረ ካአቴ፣","poem":2},{"lineBreak":true},{"text":"ፉልሳስ አከ መሌ ጉራቸኤ አርገሬ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ጉያን ሱን አከም ሶዳችሳ ተአ!","poem":1},{"text":"ጉያን አከ ጉያ ሰና ቶኮዩ ህንጅራቱ።","poem":2},{"text":"ጉያን ሱን ያቆቢፍ ዬሮ ረክና ተአ፤","poem":1},{"text":"እን ገሩ ረክነ ሰነ ኬሳ ንበአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ ‘ጉያ ሰነ’ ጄዸ ዋቀዮ ዋን ሁንደ ደንደኡ፣","poem":1},{"text":"‘አን ሞርመሳኒራ ዋንጆ ነንጨብሰ፤","poem":2},{"text":"ህዻሳኒሌ ነንኩኩተ፤","poem":1},{"text":"ኤርገሲ ነሞትን ብየ ኦርማ እሳን ህንገርቦምፈተን።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ቆደ ከና እሳን ዋቀዮ ዋቀሳኒቲፊ","poem":1},{"text":"ዳዊት ሞቲሳኒ እሰ አን እሳኒፍ ካሱ ንተጃጅሉ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘ከናፉ ያ ተጃጅላኮ ያቆብ፣ አት ህንሶዳትን፤","poem":1},{"text":"ያ እስራኤል ህንርፈትን’","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2},{"text":"‘አን ዹጉማን ብየ ፈጎቲ ስን ባሰ፣","poem":1},{"text":"ሰኚወንኬሞ ብየ እሳን ቦጅአመኒ","poem":2},{"lineBreak":true},{"text":"እት ጌፈመኒ ነንባሰ።","poem":2},{"text":"ያቆብ አመስ ነጋፊ ተስገቢ ንቀባተ፤","poem":1},{"text":"ነምን እሰ ሶዳችሱ ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አን ስ ባሱፍ ስ ወጅነን ጅራቲ’","poem":1},{"text":"ጄዸ ዋቀዮ፤","poem":2},{"text":"‘አን ሰቦተን ግዱ እሳኒት ስ ብትኔሴ ሰነ","poem":1},{"text":"ጉቱማን ጉቱት በርበዴሱዩ","poem":2},{"lineBreak":true},{"text":"ስእ ገሩ ጉቱማን ጉቱት ህንበርበዴሱ።","poem":2},{"text":"አን ከራ ስሪ ተኤን ስን አደበ፤","poem":1},{"text":"ኡቱ ስ ህንአደብን አከሱመት ስ ህንዺሱ።’","poem":2}]},{"type":"verse","number":12,"content":["“ዋቀዮ አከነ ጄዸ፦",{"text":"“ ‘መዳንኬ ህንፈዩ፤","poem":1},{"text":"ሚዸምንኬ ወልዻንሰ ህንቀቡ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ነምን ሲፍ ፈልሙ ቶኮዩ ህንጅሩ፤","poem":1},{"text":"መዳኬቲፍ ቆርች ህንጅሩ፤","poem":2},{"lineBreak":true},{"text":"አት ህንፈይቱ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ምቾትንኬ ሁንድ ስ ደገተኒሩ፤","poem":1},{"text":"እሳን ዽመኬ ህንቀበን።","poem":2},{"text":"ሰበቢ የክኬ አከ መሌ ጉዳ ተኤ","poem":1},{"text":"ጩቡንኬስ ባይአቴፍ","poem":2},{"text":"አን አኩመ ዲናት ስ ዸኤ","poem":1},{"text":"አኩመ ነመ ገራ ጀባቱ ቶኮትስ ስ አደቤረ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አት ማሊፍ መዳኬቲፊ","poem":1},{"text":"ዹኩበኬ ከን ህንፈይኔ ሰናፍ እይተ?","poem":2},{"text":"ሰበቢ የክኬ ጉደቴ ጩቡንኬስ ባይአቴፍ፣","poem":1},{"text":"አን ወንቶተ ከኔን ስት ፍዴረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“ ‘ወር ስ ኛተን ሁንድ ገሩ ንኛተሙ፤","poem":1},{"text":"ዲኖትንኬ ሁንድስ ቦጁዻን ንፉዸተሙ።","poem":2},{"text":"ወር ቀቤኘኬ ቦጅአን ንቦጅአሙ፤","poem":1},{"text":"ወር ስ ሳመን ሁንድስ ንሳመሙ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አን ገሩ ፈያኬ ሲፍን ዴብሰ፤","poem":1},{"text":"መዳኬስ ሲፍ ነንፈይሰ’ ጄዸ ዋቀዮ።","poem":2},{"text":"‘አት ጥዮን ገተምቱ","poem":1},{"text":"ከን ነምን ቶኮዩ ዽመሼ ህንቀብኔ ጄዸምቴርታቲ።’","poem":2}]},{"type":"verse","number":18,"content":["“ዋቀዮ አከነ ጄዸ፦",{"text":"“ ‘አን ሀምባ ዱንካነ ያቆብ ከን ቦጅአሜ ዴብሴ ነንዻበ፤","poem":1},{"text":"እዶ ጅሬኘሳኒቲፍስ ገራ ነንላፈ፤","poem":2},{"text":"መጋለቲን እዱመ ዲገምቴ ሰነት ዴብቴ ንእጃረምት፤","poem":1},{"text":"መሰራንስ እዶ እሳፍ መሉ ንዻበተ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ፋርፈናን ገለታቲፊ ሰገሌን ገመቹ","poem":1},{"text":"እሳን ኬሳ ንዸገአመ።","poem":2},{"text":"አን እሳን ነንባይእሰ፤","poem":1},{"text":"እሳንስ ህንጥናተን፤","poem":2},{"text":"አን ኡልፍነ ነንኬናፍ፤","poem":1},{"text":"እሳንስ ህንቱፈተመን።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እጆሌንሳኒ አከ ወረ ጀበነ ዱሪ ተኡ፤","poem":1},{"text":"ወልዳንሳኒስ ጀባቴ ፉለኮ ዱረ ንዻበተ፤","poem":2},{"lineBreak":true},{"text":"አን ወረ እሳን ጩንቁርሱ ሁንደ ነንአደበ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሆገናንሳኒ ነሙመሳኒ ተአ፤","poem":1},{"text":"ቡልቻንሳኒ እሳኑመ ግዱዻ ከአ።","poem":2},{"text":"አን እሰ ኦፍት ነንዽኤሰ፤","poem":1},{"text":"እንስ ነት ዽኣተ፤","poem":2},{"lineBreak":true},{"text":"ዮ ከና አቺ ኤኙቱ ነት ዽኣቹፍ እጀ ጀባተ?’","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"‘አከሲን እስን ሰበኮ ንታቱ፤","poem":1},{"text":"አንስ ዋቀኬሰን ነንተአ።’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ኩኖ፣ ቡቤን ዋቀዮ፣","poem":1},{"text":"እን ጀባን ዼከምሳን ንቡአ፤","poem":2},{"text":"ቡቤን ሀማንስ","poem":1},{"text":"መታ ሀሞታረት ገድ ቡብሰ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ኣሪን ዋቀዮ፣ ሶዳችሳን ሱን","poem":1},{"text":"ሀመ እን ካዮ ያደሳ","poem":2},{"lineBreak":true},{"text":"ጉቱማን ጉቱት ፊጣን ባሱት ዱበት ህንዴብኡ።","poem":2},{"text":"እስን በረ ዹማ ኬሰ","poem":1},{"text":"ዋን ከነ ንሁበቱ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JER/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JER/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JER/29.json","previousChapterAudioLinks":{},"numberOfVerses":24}