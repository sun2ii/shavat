{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_ebi","name":"ኤርምያስ","commonName":"ኤርምያስ","title":"ራጂ ኤርምያስ","order":24,"numberOfChapters":52,"sha256":"e08276404fb1cf1f464d515eb4d9024ff6266c1a4a4283b37b28fd31b4fd4e55","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_ebi/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":["“ዬሮ ሰነት” ጄዸ ዋቀዮ፣ “አን በልበለ እስራኤል ሁንዳፍ ዋቀ ነንተአ፤ እሳንስ ሰበኮ ንተኡ።”"]},{"type":"verse","number":2,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“ነሞትን ጎራዴራ ሀፈን","poem":1},{"text":"ገሞጂ ኬሰት ፉዸተመ ንአርገቱ፤","poem":2},{"lineBreak":true},{"text":"አንስ እስራኤሊፍ ቦቆና ኬኑፍ ነንዹፈ።”","poem":2}]},{"type":"verse","number":3,"content":["ዋቀዮ ፈጎዻ ነት ሙልአቴ አከነ ጄዼ፦",{"text":"“አን ጃለለ በረ በራቲን ስ ጃለዼረ፤","poem":1},{"text":"ከናፉ አን አርጁማኮቲን ኦፍት ስ ሀርክሴረ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ያ እስራኤል ዱርበ ቁልቁልቲ፣ አን አመሌ ስን እጃረ፤","poem":1},{"text":"አትስ ዴብቴ ንእጃረምተ።","poem":2},{"text":"አት አመሌ ድቤኬ ፉዸቴ","poem":1},{"text":"ወረ ገመደን ወጅን ሹብሱፍ ገድ ባተ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አት አመሌ ጋረን","poem":1},{"text":"ሰማርያረት ወይኒ ንዻበተ፤","poem":2},{"text":"ቆቴ ቡላንስ ወይኒ ዻበቴ","poem":1},{"text":"እጀሳ ንኛተ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ጉያ እት ኤግዶትን","poem":1},{"text":"ጋረን ኤፍሬምረ ዻበተኒ፣","poem":2},{"text":"‘ኮታ ገረ ጥዮንት፣ ገረ ዋቀዮ ዋቀኬኛት ኦል ባና’","poem":1},{"text":"ጄዸኒ እየን ቶኮ ንዹፈ።”","poem":2}]},{"type":"verse","number":7,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“ያቆቢፍ ገመቹዻን ፋርፈዻ፤","poem":1},{"text":"ሀንገፈ ሰቦታቲፍ እልልቻ።","poem":2},{"text":"ገለተኬሰን ዸጌስሳቲ፣","poem":1},{"text":"‘ያ ዋቀዮ ሰበኬ፣","poem":2},{"lineBreak":true},{"text":"ሀምባ እስራኤል በራር’ ጄዻ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኩኖ፣ አን ብየ ካባቲ እሳን ነንፍደ፤","poem":1},{"text":"ሀንዳረ ለፋቲስ ወልት እሳን ነንቀበ።","poem":2},{"text":"እሳን ኬሰትስ ጃሞታፊ ናፎተ፣","poem":1},{"text":"ሃዾተ ኡልፋቲፊ ዱበርቶተ ጭኒንስፈተንቱ አርገመ፤","poem":2},{"lineBreak":true},{"text":"ሰበ ጉዳ ተአኒስ ንዴብኡ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እሳንስ ቦኣ ዹፉ፤","poem":1},{"text":"ዬሮ አን ዴብሴ እሳን ፍዱት ዋቀ ከዸቱ።","poem":2},{"text":"ዋን አን አባ እስራኤል ተኤፊ","poem":1},{"text":"ኤፍሬምሞ እልመኮ ሀንገፈ ተኤፍ፣","poem":2},{"text":"አን ቀርቀረ ቡርቃ ብሻኒረ፣","poem":1},{"text":"ዳንዲ ቀጄላ እሳን አችረት ህንጉፈትኔረ እሳን ነንቀጄልቸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ያ ሰቦተ፣ ዱቢ ዋቀዮ ዸገኣ፤","poem":1},{"text":"እስን፣ ‘እን እስራኤልን ብትኔሴ ሱን ወልት እሳን ቀቤ","poem":2},{"text":"አኩመ ትክሴ ቶኮት ቡሻዬሳ ንትክሰ’ ጄዻቲ","poem":1},{"text":"ብዮተ ቀርቀረ ገላና ከኔን ፈጎ ጅረንት ለብሳ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዋቀዮ ያቆብን ፉሬረ፣","poem":1},{"text":"ወረ እሰ ጫላ ጀጀቦ ተአን ሀርካስ እሰ ባሴራቲ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እሳን ዹፈኒ ጋረን ጥዮንረትስ ገመደኒ እልልቹ፤","poem":1},{"text":"እሳን አርጁማ ዋቀዮት ጄቹንስ","poem":2},{"text":"ምዻንት፣ ዳዺ ወይኒ ሃራፊ","poem":1},{"text":"ዘይቲት፣ እልሞሌ ቡሻዬቲፊ ጀቦታትስ ንገመዱ።","poem":2},{"text":"ጅሬኝሳኒ አኩመ ብቅልቱ ብሻን ቁፌ ተአ፤","poem":1},{"text":"እሳን ስአች ህንገደን።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኤርገሲስ ሸመረን ንሹብሱ፤ ንገመዱ፤","poem":1},{"text":"ደርገጎትኒፊ ማንጉዶትን አከሱመ ንገመዱ።","poem":2},{"text":"አን ቦእቸሳኒ ገመቹት ነንጌደረ፤","poem":1},{"text":"ቆደ ገዳ ጀጀብናፊ ገመቹ ነንኬናፍ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አን አርጁማዻን ሉቦተ ነንቁብሰ፤","poem":1},{"text":"ሰብንኮስ በዻዹማኮቲን ንጉተመ፣”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":15,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“ሰገሌን ቦእቻቲፊ ወዋትና ጉዳን ቶኮ","poem":1},{"text":"ራማ ኬሳ ዸገአሜ፤","poem":2},{"text":"ሰበቢ እሳን ህንጅሬፍ፣","poem":1},{"text":"ራሄል እጆሌሼቲፍ ቦኣ ጅርት፤","poem":2},{"lineBreak":true},{"text":"ጀጀባቹስ ንድዴ።”","poem":2}]},{"type":"verse","number":16,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“ሰገሌኬ ቦእቸራ፣","poem":1},{"text":"እጀኬሞ እምማንራ ኤገዹ፤","poem":2},{"text":"ሆጂንኬ ንበዻፈማቲ”","poem":1},{"text":"ጄዸ ዋቀዮ።","poem":2},{"lineBreak":true},{"text":"“እሳን ብየ ዲናቲ ንዴብኡ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ከናፉ ገልገልኬ አብዲ ቀበ”","poem":1},{"text":"ጄዸ ዋቀዮ።","poem":2},{"lineBreak":true},{"text":"እጆሌንኬ ብየ ኦፊሳኒት ንዴብኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“አን ዹጉማን ኤፍሬሚ አከነ ጄዼ ቦኡ ዸገኤረ፦","poem":1},{"text":"‘አት አኩመ ድብቸ ህንሌንጅፈምን","poem":2},{"lineBreak":true},{"text":"ቶኮት ነ አደብዴርተ፤ አንስ አደበሜረ።","poem":2},{"text":"አት ሰበቢ ዋቀዮ ዋቀኮ ታቴፍ፣","poem":1},{"text":"ነ ዴብስ፤ አንስ ነንዴብአ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አን ኤርገን ዱበት ዴብኤ ቦዴ፣","poem":1},{"text":"ቀልቢ ጅጂረዼረ፤","poem":2},{"text":"አን ኤርገን ሁበዼ ቦዴ፣","poem":1},{"text":"ቆመኮ ነንዸኤ።","poem":2},{"text":"አን ሰበቢን ሰልጵነ ደርገጉማኮ ባዹፍ፣","poem":1},{"text":"ነንቃነኤ፤ ገድ ነንዴብኤስ።’","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ኤፍሬም እልመኮ ጃለተማ፣","poem":1},{"text":"ሙጫ አን እት ገመዱ ምቲ?","poem":2},{"text":"አን ዬሮ ባይኤ ዮን እሳን ሞርሜዩ","poem":1},{"text":"አመሌ እሰ ነንያደዸ።","poem":2},{"text":"ከናፉ ገራንኮ እሳፍ ንያደ፤","poem":1},{"text":"ገራስ ነንላፋፍ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“አት መለቶ ዳንዲ ዻበዹ፤","poem":1},{"text":"ዋን ከራ ነመ አርግሲሱሌ ካአዹ።","poem":2},{"text":"ከራ እረ ዴምቱ፣","poem":1},{"text":"ዳንዲ ጉዳ ሰነ ሁበዹ።","poem":2},{"text":"ያ እስራኤል ዱርበ ቁልቁልቲ ዴብእ፤","poem":1},{"text":"መጋላወንኬት ዴብእ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ያ እንተለ ህንአመነምኔ፣","poem":1},{"text":"አት ሀመ ዮሚት አሲፊ አች ጆርተ?","poem":2},{"text":"ዋቀዮ ዋን ሃራ ቶኮ ለፈረት ንኡመ፤","poem":1},{"text":"ዱበርቲን ዺረ መርስት።”","poem":2}]},{"type":"verse","number":23,"content":["ዋቀዮ ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦ “ዬሮ አን ቦጅአምቶተሳኒ ዴብሱት ነሞትን ብየ ይሁዳቲፊ መጋላወንሼ ኬሰ ጅራተን አመሌ ዬሮ ቶኮ፣ ‘ያ እዶ ሙርቲን ቀጄላን ጅራቱ፣ ያ ቱሉ ቁልቁሉ፣ ዋቀዮ ስ ሃኤብሱ’ ጄዸኒ ዱበቱ።"]},{"type":"verse","number":24,"content":["ብየ ይሁዳቲፊ መጋላወንሳ ሁንደ ኬሰ ነሞትን ጄቹንስ ቆናን ቡልቶትኒፊ ወር ቡሻዬ ፉዸተኒ አሲፊ አች ነናነአን ቶኩማዻን አች ኬሰ ጅራቱ።"]},{"type":"verse","number":25,"content":["አን ወረ ደዸበን ነንጀጀቤሰ፤ ወረ ገገበንሌ ነንበየነቺሰ።”"]},{"type":"verse","number":26,"content":["ከነረት አን ደመቄ አሲፊ አች ነንእላሌ። ህርብንኮስ ነት ምኣዌ ቱሬ።"]},{"type":"verse","number":27,"content":["“በር አን እት መነ እስራኤሊፊ መነ ይሁዳ ሰኚ ነማቲፊ ሰኚ ሆሪቲን ጉቱ ቶኮ ንዹፈ” ጄዸ ዋቀዮ።"]},{"type":"verse","number":28,"content":["“አን አኩመን እሳን ቡቅሱፊ ዲጉፍ፣ እሳን ገረገልቹፍ፣ እሳን በርበዴሱፊ በዲሰ እሳንት ፍዱፍ እሳን እላሌ ሰነ አከሱመሞ እሳን እጃሩፊ እሳን ዻቡፍ ገረሳኒ ነንእላለ” ጄዸ ዋቀዮ።"]},{"type":"verse","number":29,"content":["“በረ ሰነ ኬሰ ነሞትን ለመተ፣",{"text":"“ ‘አቦቲንሳኒ እጀ ወይኒ ዸንገጋኣ ኛትናን","poem":1},{"text":"እልካን እጆሌ ሀዶዴ’ ህንጄዸን።","poem":2}]},{"type":"verse","number":30,"content":["ቆደ ከና ቶኮን ቶኮን ነማ ጩቡ ኦፊሳቲን ዱአ፤ ነመ እጀ ወይኒ ዸንገጋኣ ኛቱ ከምዩ እልካኑመሳቱ ሀዶደ።"]},{"type":"verse","number":31,"content":[{"text":"“ዬሮን አን እት መነ እስራኤል ወጅን፣","poem":1},{"text":"መነ ይሁዳ ወጅንስ","poem":2},{"text":"ከኩ ሃራ ገሉ ንዹፈ፣”","poem":1},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"“ከኩን ኩንስ ከኩ አን፣","poem":1},{"text":"ዬሮ ብየ ግብጢቲ እሳን ባሱፍ ጄዼ","poem":2},{"lineBreak":true},{"text":"ሀርከሳኒ ቀቤ ሰነ አቦቲሳኒ ወጅን ገሌ፣","poem":2},{"text":"ከኩኮ ከን ኡቱመ አን ዽርሰሳኒ ተኤ ጅሩ","poem":1},{"text":"እሳን ጨብሰን ሰናን ቶኮ ምት”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"“ከኩን አን ዬሮ ሰነ ቦዴ","poem":1},{"text":"መነ እስራኤል ወጅን ገሉ ከናዸ” ጄዸ ዋቀዮ።","poem":2},{"text":"“አን ሴረኮ ቀልቢሳኒ ኬሰ ነንካአ፤","poem":1},{"text":"ገራሳኒ ኬሰትስ ነንበሬሰ።","poem":2},{"text":"አን ዋቀሳኒ ነንተአ፤","poem":1},{"text":"እሳንስ ሰበኮ ተኡ።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ሰበቢ ሁንድሳኒ፣","poem":1},{"text":"ጥና ሀመ ጉዳት ነ ቤከኒፍ፣","poem":2},{"text":"ስአች ነምን ከምዩ፣ ‘ዋቀዮን ቤክ’ ጄዼ","poem":1},{"text":"ኦላሳ ዮካን ኦቦሌሰሳ ህንበርሲሱ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2},{"text":"“አን የከሳኒ ነንዺሳፍ፤","poem":1},{"text":"ጩቡሳኒስ ስአች ህንያደዹ።”","poem":2}]},{"type":"verse","number":35,"content":["ዋቀዮ አከነ ጄዸ፤",{"text":"እን አከ እሼን ጉያን እብስቱፍ አዱ ረመዱ፣","poem":1},{"text":"እን አከ እሳን ሀልከኒን እብሰኒፍ፣","poem":2},{"lineBreak":true},{"text":"ጅኣፊ ኡርጂወን አጀጁ፣","poem":2},{"text":"እን አከ ደምበሊንሳ ሁርሱፍ","poem":1},{"text":"ገላነ ራሱ ሱን መቃንሳ","poem":2},{"lineBreak":true},{"text":"ዋቀዮ ዋን ሁንደ ደንደኡዸ፦","poem":2}]},{"type":"verse","number":36,"content":[{"text":"“ዮ ሴር ኩን ፉለኮ","poem":1},{"text":"ዱራ በዴ ቆፈ፣ ሰኚን እስራኤል፣","poem":2},{"text":"ፉለኮ ዱረት በረ በራን ሰበ ተኡንሳ ሀፈ”","poem":1},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":37,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“ዮ ሰሚን ጉባ ሰፈረሙ ደንደኤፊ","poem":1},{"text":"ሁንዴን ለፋ ከን ገዲ ቆረተሜ አርገሙ ደንደኤ ቆፈ","poem":2},{"text":"አን ሰኚ እስራኤል ሁንደ","poem":1},{"text":"ሰበቢ ዋን እሳን ሆጄተን ሁንዳቲፍ ነንገተ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":38,"content":["ዋቀዮ አከነ ጄዸ፦ “በር እት መጋላን ኩን ገሞ ሀናንኤሊቲ ጀልቀቤ ሀመ ከረ ጎሌት ዴብኤ ናፍ እጃረሙ ቶኮ ንዹፈ።"]},{"type":"verse","number":39,"content":["ፉኞን ሰፈራስ አቺ ከኤ ገረ ቱሉ ጋሬብት ቀጄሌ ገረ ጎኣት ድሪርፈመ።"]},{"type":"verse","number":40,"content":["ሱሉል ሬፊፊ ዳራን እት ገተሙ ጉቱን፣ ከራ በኣስ ሱሉለ ቄድሮን ቀበቴ ድሬን ሀመ ከረ ፈርዳት ጅሩ ሁንድ ዋቀዮፍ ንቁልቁሌፈመ። መጋላን ኩን ጎንኩማ ለመፋ ህንቡቅፈምቱ ዮካን ህንዲገምቱ።”"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JER/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JER/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JER/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}