{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_ebi","name":"ኤርምያስ","commonName":"ኤርምያስ","title":"ራጂ ኤርምያስ","order":24,"numberOfChapters":52,"sha256":"e08276404fb1cf1f464d515eb4d9024ff6266c1a4a4283b37b28fd31b4fd4e55","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_ebi/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"“ያ እስራኤል፣ አት ዮ ዴብቴ፣","poem":1},{"text":"ገረኮት ዴብእ” ጄዸ ዋቀዮ።","poem":2},{"text":"“ዮ አት ዋቆተኬ ጅብሲሶ ሰነፉለኮ ዱራ በሌስቴ","poem":1},{"text":"ስአች ከራራ ጀልአቹ ባቴ፣","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዮ አት፣ ‘ዹጋ ዋቀዮ ጅራታ’ ጄቴ","poem":1},{"text":"ዹጋዻን፣ ሙርቲ ቀጄላፊ ቀጄሉማዻን ከከቴ፣","poem":2},{"text":"ሰቦትን እሳን ንኤብፈሙ፤","poem":1},{"text":"እሱማንስ ንከበጀሙ።”","poem":2}]},{"type":"verse","number":3,"content":["ዋቀዮ ነሞተ ይሁዳቲፊ ነሞተ ዬሩሳሌሚን አከነ ጄዸ፦",{"text":"“በጂኬሰን ቆተዻ፤","poem":1},{"text":"ቆራቲ ኬሰስ ህንፈጫስና።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ያ ነሞተ ይሁዳቲፊ ኡመተ ዬሩሳሌም","poem":1},{"text":"ዋቀዮፍ ዸግነ ኦፍ ቀባ፤","poem":2},{"lineBreak":true},{"text":"ቆለ ቀልቢኬሰኒስ ዸግነ ቀበዻ፤","poem":2},{"text":"ዮ ከና አቺ ሰበቢ ሀምነ እስን ሆጄተኒቲፍ","poem":1},{"text":"ዼከምስኮ ከኤ አከ እብዳ ንቦበአ፤","poem":2},{"lineBreak":true},{"text":"ነምን እሰ ዻምሱስ ህንጅሩ።","poem":2}]},{"type":"heading","content":["በላ ካበራ ዹፉ"]},{"type":"verse","number":5,"content":[{"text":"“ይሁዳ ኬሰት ቤክስሳ፤ዬሩሳሌም ኬሰትስ አከነ ጄዻ ለብሳ፦","poem":1},{"text":"‘ብየቲ ጉቱ ኬሰት መለከተ አፉፋ!","poem":2},{"text":"ሰገሌ ኦል ፉዸዻቲ አከነ ጄዻ፦","poem":1},{"text":"ወልት ቀበማ!","poem":2},{"lineBreak":true},{"text":"ኮታ ገረ መጋላወን ደላ ጀባ ቀበኒት በቀትና!’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ጥዮን ዸቁፍ ፋጂ ኦል ቀባ?","poem":1},{"text":"ደፋ በቀዻ መሌ ዱበት ህንሀርክፈትና!","poem":2},{"text":"አን ከራ ካባቲን በላ፣","poem":1},{"text":"በዲሰ ሱከኔሳስ ነንፍዳቲ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ሌንጭ ቦሶነሳቲ በኤረ፤","poem":1},{"text":"በርበዴሳን ሰቦታ ከራ ቀበቴረ።","poem":2},{"text":"እን ብየኬ ኦንሱፍ ጄዼ","poem":1},{"text":"እዶሳቲ ከኤረ።","poem":2},{"text":"መጋላወንኬ ኦነኒ","poem":1},{"text":"ጅራቶተ መሌ ንሀፉ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ከናፉ እስን ኡፈተ ገዳ ኡፈዻቲ","poem":1},{"text":"ቦኣ ወዋዻ፤","poem":2},{"text":"ዼከምስ ዋቀዮ ሶዳችሳን ሱን","poem":1},{"text":"ኑራ ህንዴብኔቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ዋቀዮ አከነ ጄዸ፦","poem":1},{"text":"“ጉያ ሰነ ሞቲኒፊ ቆንዳልቶትን ኦኔ ዸቡ፤","poem":2},{"text":"ሉቦትን አከ መሌ ነኡ፤","poem":1},{"text":"ራጆትንስ ንራፈሙ።”","poem":2}]},{"type":"verse","number":10,"content":["አንስ አከነ ነንጄዼ፤ “ያ ዋቀዮ ጎፍታ፣ አት ኡቱ ጎራዴን ኮኬኬኘረ ጅሩ፣ ‘እስን ነጋ ቀባቱ’ ጄቹዻን ሰበ ከናፊ ዬሩሳሌምን ጉቱማን ጉቱት ጎዎምስቴርተ?”"]},{"type":"verse","number":11,"content":["ዬሮ ሰነት ሰበ ከናፊ ዬሩሳሌምት አከነ ጄዸሜ ንህመመ፤ “ቡቤን ዋ ጉቡ ቶኮ እዶወን ኦል ከኦ ቁላ ከኔን ገሞጂ ኬሳራ ገረ ሰበኮቲት ንቡብሰ፤ ገሩ አፈርሱፍ ዮካን ቁልቁሌሱፍ ምት፤"]},{"type":"verse","number":12,"content":["ቡቤን ዋን ሰናፍ አከ መሌ ጭማ ተኤ ቶኮ ነ ብራ ንዹፈ። አንስ ሙርቲኮ እሳንት ነንለብሰ።”"]},{"type":"verse","number":13,"content":[{"text":"ኩኖ፣ እን አከ ዱሜሳት፣","poem":1},{"text":"ጋሪንሳስ አከ ቡቤት ንዹፈ፤","poem":2},{"text":"ፈርዴንሳ ርሳ ጫላ ሰፍሱ።","poem":1},{"text":"ወዮ ኑ በዱኬኘ!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ያ ዬሩሳሌም፣ አት አከ ፈይቱፍቀልቢኬ ኬሳ ሀምነ ዽቀዹ።","poem":1},{"text":"ሀመ ዮሚት ያድን ሀማን ስ ኬሰ ጅራተ?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሰገሌን ቶኮ ዳንራ ለለበ፤","poem":1},{"text":"ቱሉወን ኤፍሬምራስ በዲሰ ለብሰ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“ዋን ከነ ሰቦተት ህማ፤","poem":1},{"text":"ዬሩሳሌምትስ አከነ ጄዻ ለለባ፦","poem":2},{"text":"‘ሎልቶትን መርሰኒ ብየ ቀበተን ቶኮለፈ ፈጎዻ ንዹፉ፤","poem":1},{"text":"እሳንስ መጋላወን ይሁዳት ንእዩ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሰበቢ እሼን ነት ፍንጭልቴፍ፣","poem":1},{"text":"እሳን አኩመ ነመ ለፈ ቆቲሳ ኤጉ ቶኮትእሼ ንመርሱ፣’ ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“አመልኬቲፊ ሆጂንኬ","poem":1},{"text":"ዋን ከነ ስት ፍደኒሩ።","poem":2},{"text":"አደቢንኬ ከናዸ።","poem":1},{"text":"እንስ ሀመም ሀዻአ!","poem":2},{"lineBreak":true},{"text":"ኦኔስ ሀመም ወራነ!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"መርኡማንኮ፣ መርኡማንኮ!","poem":1},{"text":"አን ዹኩቢዻን ነንውጥርፈዸ።","poem":2},{"text":"ኦኔንኮ ነ ኬሳ ወጨ፤","poem":1},{"text":"ኦኔንኮ ነ ኬሰት ዸአተ፤","poem":2},{"lineBreak":true},{"text":"አን ጨልእሱ ህንደንደኡ።","poem":2},{"text":"አን ሰገሌ መለከታ ዸገኤራቲ፤","poem":1},{"text":"ወጨ ወራናስ ዸገኤረ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"በዲስን በዲሰ እራን ዹፈ፤","poem":1},{"text":"ብየቲን ጉቱማን ጉቱት ንኦንት።","poem":2},{"text":"ዱንካንኮ አኩመ ተሳ፣","poem":1},{"text":"ጎልጋንኮስ ዬሮ ገባባ ኬሰት በዴ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አን ሀመ ዮሚትን መለቶ ወራና እላለ?","poem":1},{"text":"ሀመ ዮሚትስ ሰገሌ መለከታ ዸገአ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“ኡመትንኮ ጎዋዸ፤","poem":1},{"text":"አነስ ህንቤከን።","poem":2},{"text":"እሳን እጆሌ ቀልቢ ህንቀብኔዸ፤","poem":1},{"text":"ሁበትናስ ህንቀበን።","poem":2},{"text":"እሳን ዋን ሀማ ሆጄቹት ኦጌዪዸ፤","poem":1},{"text":"ዋን ጋሪ ሆጄቹ ገሩ ህንቤከን።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"አን ለፈ ነንእላሌ፤","poem":1},{"text":"እሼንስ ብፈ ህንቀብዱ፤ ዱዋስ ቱርቴ፤","poem":2},{"text":"ሰሚወንስ ነንእላሌ፤","poem":1},{"text":"እፍንሳኒ ዻሜ ቱሬ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"አን ቱሉወን ነንእላሌ፤","poem":1},{"text":"እሳን ሶቾኣ ቱረን፤","poem":2},{"lineBreak":true},{"text":"ጋረን ሁንድኑስ ራፈማ ቱረን።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"አን ነንእላሌ፤ ነምን ቶኮዩ ህንቱሬ፤","poem":1},{"text":"ስምብሮትን ሰሚ ሁንድስ በርሰኒ በደኒ ቱረን።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"አን ነንእላሌ፤ ኩኖ ብይ ምዻን ባፍቱ ኦንቴ ቱርቴ፤","poem":1},{"text":"መጋላወንሼ ሁንድስ፣ፉለ ዋቀዮ ዱረት","poem":2},{"lineBreak":true},{"text":"ዼከምሰሳ ሶዳችሳ ሰናን ዲገመን።","poem":2}]},{"type":"verse","number":27,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“ዮ አን ጉቱማን ጉቱት እሼ በሌሱ ባዼዩ","poem":1},{"text":"ብየቲን ጉቱማን ጉቱት ንበርበዶፍት።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ከናፉ ለፍት ንቦስ፤","poem":1},{"text":"ሰሚወን ኦሊስ ንዱከናኡ፤","poem":2},{"text":"አን ዱበዼራቲ ህንጋቡ፤","poem":1},{"text":"ሙርቴሴረ፤ ዱግደ ዱበስ ህንዴብኡ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"ሰበቢ እየ አቦቲ ፈርዴኒቲፊ ፉታፍቶተ ጥያቲን፣","poem":1},{"text":"ቶኮን ቶኮን መጋላ ንበቀተ።","poem":2},{"text":"ገር ቶኮ ቦሶነ ጎቡ ሴነ፤","poem":1},{"text":"ካንሞ ከታት ኦል በአ፤","poem":2},{"text":"መጋላወን ሁንድ ዱዋ ሀፈኒሩ፤","poem":1},{"text":"ነምን ቶኮዩ እሳን ኬሰ ህንጅራቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"ያ ኦንቱነነ፣ አት ማል ጎቻ ጅርተ?","poem":1},{"text":"አት ማሊፍ ወያ ብልዲማ ኡፈቴ","poem":2},{"lineBreak":true},{"text":"ፋየ ወርቄ ካአቴ?","poem":2},{"text":"ማሊፍ እጀኬ ኩለቴ?","poem":1},{"text":"አት አከሱማን ኦፍ ሚዸግስተ።","poem":2},{"text":"ወር ጃለተን ስ ቱፈቱ፤","poem":1},{"text":"ሉቡኬስ በሌሱ በርባዱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"አን እየ አከ እየ ዱበርቲ ጭኒንስፈቱ ቶኮ፣","poem":1},{"text":"ሚጡ አከ ሚጡ ዱበርቲ ሙጫ","poem":2},{"lineBreak":true},{"text":"ሀንገፈ ዴሱ ቶኮ ነንዸገኤ፤","poem":2},{"text":"አን እየ እንተለ ጥዮን ከን ዬሮ ሀፉርሼ ጭቱት አርገንቴ","poem":1},{"text":"ሀርከሼ ፈጫሱዻን፣","poem":2},{"text":"“ወዮ! አን በዴ፤","poem":1},{"text":"ሉቡንኮ ሀርከ ወረ ነመ አጄሱት","poem":2},{"lineBreak":true},{"text":"ደበርፈምቴ ኬነምቴርት” ጄቱ ነንዸገኤ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JER/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JER/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JER/3.json","previousChapterAudioLinks":{},"numberOfVerses":31}