{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_ebi","name":"ኤርምያስ","commonName":"ኤርምያስ","title":"ራጂ ኤርምያስ","order":24,"numberOfChapters":52,"sha256":"e08276404fb1cf1f464d515eb4d9024ff6266c1a4a4283b37b28fd31b4fd4e55","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_ebi/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":45,"content":[{"type":"heading","content":["ዻምሰ ባሩክት ኤርገሜ"]},{"type":"verse","number":1,"content":["በረ ዬሆያቂም እልም ዮስያስ ሞቲ ይሁዳ ቱሬ ኬሰ ወጋ አፉረፋት ባሩክ እልም ኔርያ ዱቢ ኤርምያስራ ዸገኤ ክታበ መረማረት በሬሴ፤ ዱቢን ኤርምያስ ራጅች ባሩክት ህሜስ ከናዸ፦"]},{"type":"verse","number":2,"content":["“ያ ባሩክ፣ ዋቀዮ ዋቅን እስራኤል አከነ ሲን ጄዸ፦"]},{"type":"verse","number":3,"content":["አት፣ ‘አናፍ ወዮ! ዋቀዮ ዽቤኮረት ገደ ነት ደበሌረ፤ አን ኣዱዻን ላፌ ቦቆና ዸቤረ’ ጄቴ።"]},{"type":"verse","number":4,"content":["ዋቀዮ አከነ ጄዼ፤ ‘አከነ ጄዺን፦ ዋቀዮ አከነ ጄዸ፤ አን ጉቱማ ብየቲ ኬሳ ዋነን እጃሬ ነንዲገ፤ ዋነን ዻቤሌ ነንቡቅሰ።"]},{"type":"verse","number":5,"content":["ኤጋ አት ኦፊኬቲፍ ዋን ጉርጉዳ ንበርባዳ? እሳን ህንበርባድን። አን ሰበ ሁንደት በዲሰ ነንፍደ፤ ገሩ ለፈ ዸቅጡ ሁንደት ሉቡኬ ቦጁ ጎዼ ሲፈን ኬነ፣ ጄዸ ዋቀዮ።’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JER/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JER/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JER/44.json","previousChapterAudioLinks":{},"numberOfVerses":5}