{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_ebi","name":"ኤርምያስ","commonName":"ኤርምያስ","title":"ራጂ ኤርምያስ","order":24,"numberOfChapters":52,"sha256":"e08276404fb1cf1f464d515eb4d9024ff6266c1a4a4283b37b28fd31b4fd4e55","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_ebi/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":46,"content":[{"type":"heading","content":["ኤርጋ ዋኤ ግብጥ"]},{"type":"verse","number":1,"content":["ዱቢን ዋቀዮ ከን ዋኤ ሰቦታቲፍ ገረ ኤርምያስ ራጅቻ ዹፌ ከናዸ፦"]},{"type":"line_break"},{"type":"verse","number":2,"content":["ዋኤ ግብጥ፦",{"lineBreak":true},"በረ ዬሆያቂም እልም ዮስያስ ሞቲ ይሁዳ ቱሬ ኬሰ፣ ወጋ አፉረፋት ኤርጋን ኩን ገረ ወራነ ፈረኦን ኔኮ ሞትቸ ግብጥ ከን ኔቡከድኔዘር ሞትች ባብሎን ለገ ኤፍራጢስ ብረት ከርኬሚሽት ሞአቴ ሰና ዹፌ፦"]},{"type":"verse","number":3,"content":[{"text":"“ጋቸነኬሰን ጥናፊ","poem":1},{"text":"ጉዳ ቆጴፈዻቲ ሎላፍ በኣ!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ፈርዴን ፌአዻ፤","poem":1},{"text":"እሳን ያበዻስ!","poem":2},{"text":"ቆቢ ስቢላ ካአዻቲ","poem":1},{"text":"እዶ እዶኬሰን ቀበዻ።","poem":2},{"text":"ኤቦኬሰን ቀረዻ፤","poem":1},{"text":"ቆሜ ስቢላሌ ኡፈዻ!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አን ማል አርጋን ጅረ?","poem":1},{"text":"እሳን ነአኒ ጅሩ፤","poem":2},{"text":"ዱግደ ዱበት ዴብኣ ጅሩ፤","poem":1},{"text":"ጎቶትንሳኒ ሞአተመኒሩ።","poem":2},{"text":"እሳን ኡቱ ኦፍ ዱበ ህንምልአትን አሪቲን በቀቱ፤","poem":1},{"text":"ቅጠ ሁንዳኑ ጎሊቱ ጅረ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“ፊጋን በቀቹ ህንደንደኡ፤","poem":1},{"text":"ዮካን ነምን ጀባን ጀላ ህንበኡ።","poem":2},{"text":"እሳን ከራ ካባቲን","poem":1},{"text":"ለገ ኤፍራጢስ ብረት ጉጉፈተኒ ኩኩፉ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ከን አከ አበያ፣","poem":1},{"text":"አከ ለገ ብሻንሳ ጨብሴ ያኡ ኦል ከኡ ኩን ኤኙ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ግብጥ አኩመ አበያ፣","poem":1},{"text":"አኩመ ለገ ብሻንሳ ጨብሴ ያኡት ኦል ካት።","poem":2},{"text":"እሼንስ፣ ‘አን ኦል ከኤ ለፈ ነንሀጉገ፤","poem":1},{"text":"መጋላወኒፊ ሰበሳኒ ነንበሌሰ’ ጄት።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ያ ፈርዴን፣ እስን ገርማማ!","poem":1},{"text":"ያ ጋሪወን፣ እስንስ ጉላ!","poem":2},{"text":"ያ ጎቶተ እቶጵያቲፊ ፉጥ ወር ጋቸነ ባተን፣","poem":1},{"text":"ያ ነሞተ ሉድ ወር እዳ ቀበተን ከኣቲፉለ ዱረት ቀጄላ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጉያን ሱን ገሩ ጉያ ጎፍታ፣ከን ዋቀዮ ዋን ሁንደ ደንደኡ፣","poem":1},{"text":"ጉያ ሃሎ በኡ፣ ከን እን እት ዲኖተሳ ሃሎ ባፈቱዸ።","poem":2},{"text":"ጎራዴን ሀመ ቁፉት፣","poem":1},{"text":"ሀመ ዼቡ ዺጋን በኡት ኛተ።","poem":2},{"text":"ጎፍታን፣ ዋቀዮ ዋን ሁንደ ደንደኡ","poem":1},{"text":"ብየ ካባ ኬሰት፣ ለገ ኤፍራጢስ ብረት ኣርሳ ዽኤሳቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ያ ግብጥ ዱርበ ቁልቁልቲ፣","poem":1},{"text":"ግልኣድት ኦል በኢቲ ቆርቸ ፉዸዹ።","poem":2},{"text":"አት አከሱማን ቆርቸ ሄዱት ፈየደምተ፤","poem":1},{"text":"ገሩ ህንፈይቱ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሰቦትን ቃኒኬ ንዸገኡ፤","poem":1},{"text":"ቦእችኬ ለፈ ጉተ።","poem":2},{"text":"ጎን ቶኮ ጎተ ካንት ጉፈተ፤","poem":1},{"text":"እሳን ለማኑ ወል ቀበተኒ ኩፉ።”","poem":2}]},{"type":"verse","number":13,"content":["“ዱቢን ዋቀዮ አከ ኔቡከድኔዘር ሞቲን ባብሎን ዹፌ ግብጥ ዸኡ ኤርምያስ ራጅቸት ዱበቴ ከናዸ፦"]},{"type":"verse","number":14,"content":[{"text":"“ዋን ከነ ግብጥ ኬሰት ዱበዹ፤ ምግዶልትስ ለብስ፤","poem":1},{"text":"ሜምፊሲፊ ተህጳንሄስ ኬሰትሌ አከነ ጄዻ ለብሳ፦","poem":2},{"text":"‘ጎራዴን ወረ ናኖኬሰን ጅሩ ንፍጣቲ","poem":1},{"text":"እስን እዶ እዶኬሰን ቀበዻቲ ቆጳኣ።’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ጎቶትንኬ ማሊፍ ኩፈኒ ድሪሩ?","poem":1},{"text":"ሰበቢ ዋቀዮ ገድ እሳን ቀቡፍ እሳን ዻበቹ ህንደንደአን።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እሳን አሙማ አመ ጉፈቱ፤","poem":1},{"text":"ወልረትስ ኩኩፉ።","poem":2},{"text":"እሳንስ፣ ‘ከኣ ጎራዴ ጩንቁርሳ","poem":1},{"text":"ጀላ ባኔ ገረ ሰበኬኛቲፊ","poem":2},{"lineBreak":true},{"text":"ብየ እት ዸለኔት ንዴብና’ ወሊን ጄዹ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እሳን አችት፣","poem":1},{"text":"‘ፈረኦን ሞትች ግብጥ ወጨ ቆፈ፤","poem":2},{"lineBreak":true},{"text":"እን ጨራ ኦፊሳ ዸቤረ’ ጄዸኒ እዩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“ዹጋ አነ ጅራታ” ጄዸ ሞትች እን መቃንሳ","poem":1},{"text":"ዋቀዮ ዋን ሁንደ ደንደኡ ተኤ ሱን","poem":2},{"text":"“ከን ጋረን ኬሳ ታቦር ፈካቱ፣","poem":1},{"text":"እን ገላነ ጭነት ቀርሜሎስን ፈካቱ ቶኮ ንዹፈ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አት ከን ግብጥ ኬሰ ጅራቱ፣","poem":1},{"text":"ዋን ቀብዱ ወልት ቀበዹቲ በቃፍ ቆጳእ፤","poem":2},{"text":"ሜምፊስ ኦንቴ ዲገምቴ","poem":1},{"text":"ጅራቶተ መሌ ሀፍቲቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ግብጥ ጎሮምሰ በሬዱዸ፤","poem":1},{"text":"ገሩ ቀርጣሳን","poem":2},{"lineBreak":true},{"text":"ብየ ካባቲ እሼት ንዹፈ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሎልቶትን እሼን ክራዻን ብተቴ ግዱሼ ጅረንስ","poem":1},{"text":"አኩመ ጅቦተ ጮጮመኒት።","poem":2},{"text":"ሰበቢ ጉያን በዲሳ፣","poem":1},{"text":"ዬሮን እት እሳን አደበመን እሳንት ዹፌፍ","poem":2},{"text":"እሳንስ ገረ ገለኒ ወሉማን ንበቀቱ፤","poem":1},{"text":"እዶሳኒ ዻበተኒ ኦፍራ ዴብሱ ህንደንደአን።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ግብጥ ዬሮ ዲን እሼት ዹፉት","poem":1},{"text":"አኩመ ቦፈ ዋ በቀቱ ሲቅስት፤","poem":2},{"text":"እሳን አኩመ ነሞተ ሙከ ሙረኒት","poem":1},{"text":"ቆቶ ቀበተኒ እሼት ዹፉ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዮ እን ሀመ ፌዼ ጎበቴዩ፣","poem":1},{"text":"እሳን ቦሶነሼ ጭረኒ በሌሱ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2},{"text":"“እሳን ሀዋንሰ ጫላ ባይአቱ፤","poem":1},{"text":"ለካአሙስ ህንደንደአን።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"እንተል ግብጥ ንቃኔፈምት፤","poem":1},{"text":"ደበርፈምቴስ ነሞተ ካባት ንኬነምት።”","poem":2}]},{"type":"verse","number":25,"content":["ዋቀዮ ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦ “አን ኣሞን ዋቀ ቴቤስት፣ ፈረኦንት፣ ግብጢቲፊ ዋቀሼት፣ ሞቶተ እሼቲፊ ወረ ፈረኦንን አመነተንት አደቢ ነንፍደ።"]},{"type":"verse","number":26,"content":["አን ደበርሴ ወረ ሉቡሳኒ ገላፈቹ በርባደንት፣ ጄቹንስ ኔቡከድኔዘር ሞትቸ ባብሎንቲፊ ቆንዳልቶተሳት እሳን ኬነ። ኤርገሲ ገሩ ግብጥ አኩመ ዱሪ ለፈ ነምን ኬሰ ጅራቱ ንታት” ጄዸ ዋቀዮ።"]},{"type":"verse","number":27,"content":[{"text":"“ያ ያቆብ ተጃጅላኮ፣ አት ህንሶዳትን፤","poem":1},{"text":"ያ እስራኤል አትስ ህንነእን።","poem":2},{"text":"አን ለፈ ፈጎቲ ስን ባሰ፤","poem":1},{"text":"ሰኚ ኬሞ ብየ እሳን እት ቦጅአመኒ ነንፍደ።","poem":2},{"text":"ያቆብ አመስ ነጋፊ ተስገቢ ንቀባተ፤","poem":1},{"text":"ነምን እሰ ሶዳችሱ ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ያ ያቆብ ገርብቸኮ፣ አት ህንሶዳትን፤","poem":1},{"text":"አንስ ስ ወጅነን ጅራቲ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2},{"text":"“አን ዮ ሰቦተ ግዱሳኒት ስ ብትኔሴ ሰነ","poem":1},{"text":"ጉቱማን ጉቱት በሌሴዩ","poem":2},{"lineBreak":true},{"text":"አን ጉቱማን ጉቱት ስ ህንበሌሱ።","poem":2},{"text":"አን ስን አደበ፤ ገሩ ቀጄሉማ ቆፋን፤","poem":1},{"text":"አከ አት ኡቱ ህንአደበምኑ ገድ ዺፈምቱ ህንጎዹ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JER/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JER/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JER/45.json","previousChapterAudioLinks":{},"numberOfVerses":28}