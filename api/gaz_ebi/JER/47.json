{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_ebi","name":"ኤርምያስ","commonName":"ኤርምያስ","title":"ራጂ ኤርምያስ","order":24,"numberOfChapters":52,"sha256":"e08276404fb1cf1f464d515eb4d9024ff6266c1a4a4283b37b28fd31b4fd4e55","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_ebi/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":47,"content":[{"type":"heading","content":["ኤርጋ ዋኤ ፍልስጤሞታ"]},{"type":"verse","number":1,"content":["ዱቢን ዋቀዮ ከን ዋኤ ፍልስጤሞታ ከን ኡቱ ፈረኦን ጋዛ ህንዸእን ዱረ ገረ ኤርምያስ ራጅቻ ዹፌ ከናዸ፦"]},{"type":"line_break"},{"type":"verse","number":2,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“ኩኖ፣ ከራ ካባቲን ብሻን ኦል ከኣ ጅረ፤","poem":1},{"text":"ብሻን ኩንስ ሎላ ጉቴረ ዸንገለኡ ተአ።","poem":2},{"text":"እንስ ብየቲፊ ዋን እሼ ኬሰ ጅሩ፣","poem":1},{"text":"መጋላወኒፊ ወረ እሳን ኬሰ ጅራተን ሁንደረ ገረገለ።","poem":2},{"text":"ኡመትን ንቦአ፤","poem":1},{"text":"ወር እሼ ኬሰ ጅራተን ሁንድስ ንወዋቱ፤","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኩንስ ሰበቢ ድድቸ ኮቴ ፈርዴን ጉሉፈኒ፣","poem":1},{"text":"ግርሰ ጋሪወን ዲናቲፊ","poem":2},{"lineBreak":true},{"text":"ቀቀዌሰ ጎማሳኒቲፍ።","poem":2},{"text":"አቦቲን እጆሌሳኒ ገርጋሩፍ ዱበት ገረ ህንገለን፤","poem":1},{"text":"ሀርክሳኒስ እሳንረት ላምሸአ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ፍልስጤሞተ ሁንደ በሌሱፍ","poem":1},{"text":"ሀምባ ጢሮሲፊ ሲዶና","poem":2},{"text":"ገርጋሩፍ ሀፈን ሁንደስ በሌሱፍ","poem":1},{"text":"ጉያን ሱን ዹፌራቲ።","poem":2},{"text":"ዋቀዮ ፍልስጤሞተ፣","poem":1},{"text":"ሀምባ ቀርቀረ ከፍቶር በሌሱ ገኤረ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ጋዛን ገዳን መታሼ ሃደት፤","poem":1},{"text":"አሽቀሎን ንጨልእስት።","poem":2},{"text":"ያ ሀምባ ድሬራ","poem":1},{"text":"እስን ሀመ ዮሚት ኦፍ ጭጭርቱ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“እስን፣ ‘ያ ጎራዴ ዋቀዮ","poem":1},{"text":"አት ሀመ ዮሚት ህንቦቆትኔ?","poem":2},{"text":"መንኤኬት ዴብእ፤","poem":1},{"text":"ጨልእሲ ታእ’ ጄተኒ እይቱ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ገሩ ኡቱ ዋቀዮ እሰ አጀጁ፣","poem":1},{"text":"ዬሮ ዋቅን አከ እን አሽቀሎኒፊ","poem":2},{"text":"ቀርቀረ ገላና ዸኡፍ ቀጄልፈመሳ ኬኑት","poem":1},{"text":"እን አከምት ቦቆቹ ደንደአ?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}