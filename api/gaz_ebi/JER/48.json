{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_ebi","name":"ኤርምያስ","commonName":"ኤርምያስ","title":"ራጂ ኤርምያስ","order":24,"numberOfChapters":52,"sha256":"e08276404fb1cf1f464d515eb4d9024ff6266c1a4a4283b37b28fd31b4fd4e55","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_ebi/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":48,"content":[{"type":"heading","content":["ኤርጋ ዋኤ ሞኣብ"]},{"type":"verse","number":1,"content":["ዋኤ ሞኣብ፦",{"lineBreak":true},"ዋቀዮ ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦",{"text":"“ኔቦፍ ወዮ፤ እሼን ንዲገምቲቲ።","poem":1},{"text":"ክርያታይምስ ንሰልጰት፤ ንቀበምት፤","poem":2},{"lineBreak":true},{"text":"ደኦወንሼስ ንቃኔፈሙ፤ ንዲገሙስ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሞኣብ ስአች ህንጀጀምቱ፤","poem":1},{"text":"ነሞትን ሄሽቦን ኬሰት፣","poem":2},{"lineBreak":true},{"text":"‘ኮታ ሰበ ሰነ ንበሌስና’ጄዸኒ ዋኤ ኩፋቲሼ መርአቱ።","poem":2},{"text":"ያ መጋላ ማድሜን ጄዸምቱ አትስ ንጨልእስተ፤","poem":1},{"text":"ጎራዴን ስ አርኣቲ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እየ ሆሮናይሚ ዹፉ፣","poem":1},{"text":"እየ በርበዳኡፊ በዲሳ ጉዳ ዸገኣ!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሞኣብ ንጨብድ፤","poem":1},{"text":"እጆሌንሼስ ንቦኡ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እሳን አከ መሌ ቦኣ፣","poem":1},{"text":"ሉሂቲት ኦል በኡ፤","poem":2},{"text":"ከራ ገረ ሆሮናይምት ገድ ቡሱረት","poem":1},{"text":"እየ በዲሳ ዸገኡ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"በቀዻ! ሉቡኬሰን ባፈዻ፤","poem":1},{"text":"አከ ደገለ ገሞጂ ኬሳ ተኣ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እስን ዋን ሆጂኬሰኒፊ ቀቤኘኬሰን አመነተኒፍ፣","poem":1},{"text":"ቦጁዻን ፉዸተምተኒ ንዴምቱ፤","poem":2},{"text":"ኬሞሽስ ሉቦተሳቲፊ","poem":1},{"text":"ቆንዳልቶተሳ ወጅን ቦጅአሜ ንፉዸተመ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"በሌስቱን ሱን መጋላ ሁንደት ንዹፈ፤","poem":1},{"text":"መጋላን ቶኮዩ እሰ ጀላ ህንበኡ።","poem":2},{"text":"ሰበቢ ዋቀዮ ዱበቴፍ ሱሉል ንበደ፤","poem":1},{"text":"ድሬንስ ንበርበዴፈመ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሞኣብት ሶግደ ፍርፍርስ፤","poem":1},{"text":"እሼን ንበዲቲ፤","poem":2},{"text":"መጋላወንሼስ","poem":1},{"text":"ነመ እሳን ኬሰ ጅራቱ ዸበኒ ኦኑ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ነምን ገራ ህርኡዻን ሆጂ ዋቀዮ ሆጄቱ አባረማ ሃተኡ!","poem":1},{"text":"ነምን ጎራዴሳቲን ዺገ ዸንገላሱ ድዱስ አባረማ ሃተኡ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ሞኣብ አኩመ ዳዺ ወይኒ ከን ሲጮሳረት ሀፌ","poem":1},{"text":"ከን ኦኮቴ ቶኮ ኬሳ ገረ ኦኮቴ ካኒት ገረ ህንገልፈምኒ","poem":2},{"text":"እጆሉማሼቲ ጀልቀብዴ ቦቆቻ ቱርቴ፤","poem":1},{"text":"ቦጅአምቴስ ህንፉዸተምኔ።","poem":2},{"text":"ከናፉ እሼን አኩመ ዱሪ ምኦፍት፤","poem":1},{"text":"ኡርጋንሼስ ህንጌደረምኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ገሩ በር አን እት ነሞተ ኦኮቴ ኬሳ ዸንገላሰንኤርጉ ቶኮ ንዹፈ።","poem":1},{"lineBreak":true},{"text":"እሳንስ ገድ እሼ ነቁ፤","poem":1},{"text":"ኦኮቴሼ ዱዋ ሀምብሰኒ","poem":2},{"lineBreak":true},{"text":"ጋኒሼ ጨብሱ” ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“ዮስ አኩመ መን እስራኤል","poem":1},{"text":"ዬሮ ቤትኤልን አመነቴት ቃነኤ ሰነ","poem":2},{"lineBreak":true},{"text":"ሞኣብስ ኬሞሽት ንቃነአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“እስን አከሚን ‘ኑ ጎቶተ፤","poem":1},{"text":"ኑ ወራነ ኬሰት ጀጀቦዸ’ ጄቹ ደንዴሱ?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሞኣብ ንበርበዶፍት፤ መጋላወንሼስ ንቀበተሙ፤","poem":1},{"text":"ደርገጎንሼ ፍለተሞን ገረ ቀልማት ጌፈሙ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ሞትች መቃንሳ ዋቀዮ ዋን ሁንደ ደንደኡ ጄዸሙ ሱን።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“ኩፋቲን ሞኣብ ገኤረ፤","poem":1},{"text":"በዲስንሼስ ደፌ ንዹፈ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ወር ናኖሼ ጅራተን ሁንድ፣","poem":1},{"text":"ወር መቃሼ ቤክተን ሁንድ","poem":2},{"text":"‘ቦኩን ጀባን ሱን አከምት ጨቤ!","poem":1},{"text":"ኡሌን ኡልፍነ ቀቤስ ሱን አከምት ጨቤ!’ ጄዻ ቦኣፊ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“ያ ጅራቱ ዲቦን፣","poem":1},{"text":"ኡልፍነኬራ ገድ ቡኢቲ","poem":2},{"lineBreak":true},{"text":"ለፈ ጎጎጋረ ታእ!","poem":2},{"text":"በርበዴሳን ሞኣብ ሱን ስት ዹፌ","poem":1},{"text":"መጋላወንኬ ከኔን","poem":2},{"lineBreak":true},{"text":"ደላ ጀባን መርፈመን ንዲጋቲ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አት ከን አሮኤር ኬሰ ጅራቱ፣","poem":1},{"text":"ከራ ጭነ ዻበዹቲ እላል።","poem":2},{"text":"ዺረ በቀቱፊ ዱበርቲ ምልቅጡ ጋፈዹ፤","poem":1},{"text":"‘ማልቱ ዸለቴ?’ ጄዺ እሳን ጋፈዹ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ሞኣብ ዋን ዲገምቴፍ ቃኖፍቴርት።","poem":1},{"text":"ወዋዹ ቦእ!","poem":2},{"text":"አርኖን ብረት","poem":1},{"text":"አከ ሞኣብ በርበዶፍቴ ጅርቱ ለብስ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሙርቲን ድሬ ኦል ከኣት፦","poem":1},{"text":"ሆሎንት፣ ያህዛፊ ሜፍኣት፣","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ዲቦንት፣ ኔቦፊ ቤት ድብላታይምት፣","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ክርያታይምት፣ ቤት ጋሙሊፊ ቤት ሜኦንት፣","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ኬሪዮቲፊ ቦዝራት፣","poem":2},{"lineBreak":true},{"text":"መጋላወን ሞኣብ ከኔን ፈጎፊዽኦ ጅረን ሁንደት ዹፌረ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ጋንፍ ሞኣብራ ሙረሜረ፤","poem":1},{"text":"እሬንሼስ ጨጨቤረ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“ዋን እሼን ዋቀዮት ኮርቴፍ","poem":1},{"text":"ዹጋቲዻን እሼ መቼሳ።","poem":2},{"text":"ሞኣብ ድድገ ኦፊሼረ ሃገንገለቱ፤","poem":1},{"text":"ዋን ቆሳስ ሃታቱ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"እስራኤል ስ ዱረት ዋን ቆሳ ህንቱሬ?","poem":1},{"text":"አከ አት ዬሮ ዋኤሼ ዱበቱ ሁንደ","poem":2},{"text":"ቱፊዻን መታኬ እሼት ራፍቱፍ","poem":1},{"text":"እሼን ሀቶተ ግዱት ቀበምቴ?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"እስን ወር ሞኣብ ኬሰ ጅራተን፣","poem":1},{"text":"መጋላወንኬሰን ኬሳ በኣቲ ከታወን ኬሰ ጅራዻ።","poem":2},{"text":"አኩመ ጉጌ መነሼ","poem":1},{"text":"አፋን ሆልቃት እጃረቱ ተአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“ኑ ዋኤ ኦፍ ቱሉማ ሞኣብ","poem":1},{"text":"ጄቹንስ አከ መሌ ኦፍ ጉድሱፊ ኦፊን ቦኑሼ፣","poem":2},{"text":"ኦፍ ቱሉፊ ኦፍ ጀጁሼ፣","poem":1},{"text":"ኦፍ ቦኮክሱሼ ዸጌኜረ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"አን አደጉማ ሞኣብ ቤከ፤ገሩ ፋይዳ ህንቀባቱ” ጄዸ ዋቀዮ፤","poem":1},{"text":"“ኦፍ ቱሉንሼስ ሆማ ህንፈየዱፍ”","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ከናፉ አን ሞኣቢፍ ነንወዋዸ፤","poem":1},{"text":"ሞኣብ ሁንዳፍ ህቅፈዼ ቦአ፤","poem":2},{"lineBreak":true},{"text":"አን ነሞተ ቂር ሀሬሼቲፍ ነንገደ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ያ ሙከ ወይኒ ስብማ፣","poem":1},{"text":"አን አኩመ የእዜሪፍ ቦኡ ሰነ ሲፍን ቦአ።","poem":2},{"text":"ደሜንኬ ሀመ ገላናት ድሪርቴ ፈጋቴ፤","poem":1},{"text":"እሼን ሀመ ገላነ የእዜርት ድሪርቴ ዴምት።","poem":2},{"text":"በሌስቱን ሱን እጀኬ ብልቻታፊ","poem":1},{"text":"ሁርቡ ወይኒኬቲረ ቡኤረ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ለፈ ብቅልቱቲፊ ለፈ ቆቲሳ","poem":1},{"text":"ምዻን ሞኣብ ኬሳ እልሌፊ ገመቹን በዴረ።","poem":2},{"text":"አን እዶ እት ወይኒ ጩንፈንራ ወይኒ ኩቴረ፤","poem":1},{"text":"ነምን ቶኮዩ ገመዳ ስርቤ እሳን ህንጩንፉ።","poem":2},{"text":"ወጭን ዮ ጅራቴሌ","poem":1},{"text":"እን ወጨ ገመቹ ምት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“ሰበቢ ብሻን ኒምሪም ጎጌፍ፣","poem":1},{"text":"ሰገሌን እየሳኒ ኦል ከኤ፣","poem":2},{"text":"ሄሽቦኒ ሀመ ኤሌኣሌቲፊ ያሀዚት፣","poem":1},{"text":"ዞኣሪ ሀመ ሆሮናይምቲፊ ሀመ ኤግላት ሼልሽያትንዸገአመ ቱሬ።","poem":2}]},{"type":"verse","number":35,"content":[{"text":"አን ወረ እዶወን ሰገዳ ከኔን ጋረንራት","poem":1},{"text":"ኣርሳ ዽኤሰኒ ዋቆተ እሳኒፍ እጣነ ኣርሰን","poem":2},{"lineBreak":true},{"text":"ሞኣብ ኬሳ ነንበሌሰ” ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":36,"content":[{"text":"“ከናፉ ገራንኮ አኩመ ኡሉሌ ፋርሴ ሞኣቢፍ ቦአ፤","poem":1},{"text":"አኩመ ኡሉሌ ፋርሴ ነሞተ ቂር ሀሬሼቲፍ ቦአ።","poem":2},{"lineBreak":true},{"text":"ቀቤኝ እሳን ሆረተን ዱራ በዴረ።","poem":2}]},{"type":"verse","number":37,"content":[{"text":"መታን ሁንድኑ ሃደሜ","poem":1},{"text":"ሀሬድን ሁንድኑ ጭረሜረ፤","poem":2},{"text":"ሀርክ ሁንድኑ ሙረሜ ሙዺን ሁንድስ","poem":1},{"text":"ወያ ገዳቲን ህዸሜረ።","poem":2}]},{"type":"verse","number":38,"content":[{"text":"ዋን አን አኩመ ኦኮቴ ነምን ቶኮዩ ህንፌኔት","poem":1},{"text":"ሞኣብን ጨጨብሴፍ","poem":2},{"text":"በንቲ መነ ሞኣብ ሁንደራፊ ኦብዲ ሰባ ኬሰ","poem":1},{"text":"ቦእቸ መሌ ወን ቶኮዩ ህንጅሩ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":39,"content":[{"text":"“እሼን አከም አከስ ጨጨብዴ! እሳን አከም አከስ ወዋቱ!","poem":1},{"text":"ሞኣብ አከም አከስ ዱግደሼ ቃኒዻን ገረገልፈቴ!","poem":2},{"text":"ሞኣብ ዋን ኮልፋ ታቴ፣","poem":1},{"text":"ወረ ናኖሼ ጅራተን ሁንዳፍ ዋን ሶዳ ታቴርት።”","poem":2}]},{"type":"verse","number":40,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“እላ! ርሳን ቶኮ ሞኣብረት","poem":1},{"text":"ቆቾ በልእሴ ፉርጉግፈማ ገድ ቡኣ ጅረ።","poem":2}]},{"type":"verse","number":41,"content":[{"text":"ኬሪዮት ንቀበምት፤","poem":1},{"text":"ደአኖንሼ ጀጀቦንስ ንፉዸተሙ።","poem":2},{"text":"በረ ሰነ ኬሰ ገራን ሎልቶተ ሞኣብ","poem":1},{"text":"አኩመ ገራ ዱበርቲ ጭኒንስፈቹት ጅርቱ ቶኮ ተአ።","poem":2}]},{"type":"verse","number":42,"content":[{"text":"ሞኣብ ሰበቢ ዋቀዮን ቱፈቴፍ","poem":1},{"text":"በርበዶፍቴ ሰበ ተኡንሼ ንሀፈ።","poem":2}]},{"type":"verse","number":43,"content":[{"text":"ያ ሰበ ሞኣብ ሶዳን፣","poem":1},{"text":"ቦሊፊ ክዮን ስ ኤገተ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":44,"content":[{"text":"“ነምን ሶዳ ሰነ ዱራ በቀቱ","poem":1},{"text":"ከምዩ ቦለ ኬሰ ቡአ፤","poem":2},{"text":"ነምን ቦለ ሰነ ኬሳ ኦል በኡ","poem":1},{"text":"ከምዩ ክዮዻን ቀበመ፤","poem":2},{"text":"አን ሞኣብት","poem":1},{"text":"ወጋ አደበሙሼ ነንፍዳቲ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“በቀቶትን ዋን ተአን ዸበኒ","poem":1},{"text":"ጋድሰ ሄሽቦን ጀለ ዸዻበቱ፤","poem":2},{"text":"ሄሽቦን ኬሳ እብድ ቶኮ፣","poem":1},{"text":"ስሆን ግዱዻስ አረብን እብዳ ንከኣቲ፤","poem":2},{"text":"እን አደ ሞኣብ ጉበ፣","poem":1},{"text":"ቡቄ መታ ኦፍ ቱልቶታስ ንጉበ።","poem":2}]},{"type":"verse","number":46,"content":[{"text":"ያ ሞኣብ ሲፍ ወዮ!","poem":1},{"text":"ኡመትን ኬሞሽ በርበዳኤረ፤","poem":2},{"text":"እልማንኬ ቦጅአመኒ ፉዸተመኒሩ፤","poem":1},{"text":"እንተለንኬስ ቦጅአመኒሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“ተኡሌ አን በረ ዹፉፍ ጅሩ ኬሰ","poem":1},{"text":"ሀምባ ሞኣብ ዴብሴ ነንዻበ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2},"ሙርቲን ሞኣብት ሙረሜ ሱን አስት ዹመ።"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}