{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_ebi","name":"ኤርምያስ","commonName":"ኤርምያስ","title":"ራጂ ኤርምያስ","order":24,"numberOfChapters":52,"sha256":"e08276404fb1cf1f464d515eb4d9024ff6266c1a4a4283b37b28fd31b4fd4e55","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_ebi/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":49,"content":[{"type":"heading","content":["ኤርጋ ዋኤ አሞን"]},{"type":"verse","number":1,"content":["ዋኤ አሞኖታ፦",{"lineBreak":true},"ዋቀዮ አከነ ጄዸ፦",{"text":"“እስራኤል እልማን ህንቀቡ?","poem":1},{"text":"እን ነመ እሰ ዻሉ ህንቀቡ?","poem":2},{"text":"ዮስ ሞሌክ ማሊፍ ጋድን ዸልቼሬ?","poem":1},{"text":"ነሞትንሳ ማሊፍ መጋላሼ ኬሰ ጅራቱ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ገሩ በር አን እት ረባ አሞኖታት","poem":1},{"lineBreak":true},{"text":"ሰገሌ ወጨ ወራና ዸጌስሱ ቶኮ ንዹፈ”","poem":1},{"text":"ጄዸ ዋቀዮ።","poem":2},{"text":"“እሼን ቱላ በዲሳ ንታት፤","poem":1},{"text":"ገንዶትን ናኖሼ ጅረንስ እብዳን ጉበሙ።","poem":2},{"text":"ኤርገሲ እስራኤል ወረ እሼ አርኤ ባሴ ሰነ","poem":1},{"text":"አሪቴ ብያ ንባፍት፣”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“ያ ሄሽቦን ወዋዹ፣ ኣይ በርበዶፍቴርቲ!","poem":1},{"text":"ያ ጅራቶተ ረባ እያ!","poem":2},{"text":"ወያ ገዳ ኡፈዻቲ ቦኣ፤","poem":1},{"text":"ደላ ኬሰ አሲፊ አች ፊጋ፤","poem":2},{"text":"ሞሌክ ሉቦታፊ ቆንዳልቶተሳ ወጅን","poem":1},{"text":"ቦጅአሜ ንፉዸተማቲ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አት ማሊፍ ሱሉለኬቲን ቦንተ?","poem":1},{"text":"ማሊፍ ሱሉለኬ ገበታ ሰናን ቦንተ?","poem":2},{"text":"ያ እንተለ ህንአመነምኔ አት ሶሩመኬ አብደቴ፣","poem":1},{"text":"‘ኤኙቱ ነ ቱቀ?’ ጄተ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አን ወረ ናኖኬ ጅራተን ሁንደራ","poem":1},{"text":"ሶዳ ስት ነንፍደ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ጎፍታን፣ ዋቀዮ ዋን ሁንደ ደንደኡ።","poem":2},{"text":"“ቶኮን ቶኮንኬሰን ንአርአምቱ፤","poem":1},{"text":"ነምን በቀቶተ ወልት ቀቡ ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“ተኡሌ አን ኤርገሲ ሀምባወን አሞኖታ ዴብሴ ነንዻበ”","poem":1},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"heading","content":["ኤርጋ ዋኤ ኤዶም"]},{"type":"verse","number":7,"content":["ዋኤ ኤዶም፦",{"lineBreak":true},"ዋቀዮ ዋን ሁንደ ደንደኡ አከነ ጄዸ፦",{"text":"“ስአች ቴማን ኬሰ ኦጉማን ህንጅሩ?","poem":1},{"text":"ሁበቶተ ዱራ ጎርስ በዴራ?","poem":2},{"lineBreak":true},{"text":"ኦጉማንሳኒ ሰሜራ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ወር ዴዳን ኬሰ ጅራተን ገረገላ፣","poem":1},{"text":"በቀዻቲ ሆልቀ ገድ ፈጎ ኬሰ ዾከዻ፤","poem":2},{"text":"አን ዬሮ ኤሳዉን አደቡት","poem":1},{"text":"በዲሰ እሰት ነንፍዳቲ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ወር ጉማ ወይኒ ጉረን ኡቱ ገረኬ ዹፈኒ ስላ","poem":1},{"text":"ቀርሚ ወዪ ህንሀምብሰኒ?","poem":2},{"text":"ሀቱን ዮ ሀልከን ዹፍቴ፣","poem":1},{"text":"እሳን ሀሙመ በርባደን ቆፈ ፉዸተኒ ህንዴመኒ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አን ገሩ ኤሳዉን ቁላ ነንሀምብሰ፤","poem":1},{"text":"አከ እን እት ህንደአኔፍ","poem":2},{"lineBreak":true},{"text":"አን እዶ እን እት ዾከቱ እፈት ነንባሰ።","poem":2},{"text":"እጆሌንሳ፣ ፍሮንሳቲፊ ኦሎንሳ ንበዱ፤","poem":1},{"text":"እንስ ስአች ህንጅራቱ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"‘ዳእመንኬ ከኔን ወረ ህንቀብኔ ዺስ፤አነቱ እሳን ጅራችሳቲ።","poem":1},{"text":"ሃዾትን ህዬሳኬ ነ አመነቹ ደንደኡ።’ ”","poem":2}]},{"type":"verse","number":12,"content":["ዋቀዮ አከነ ጄዸ፦ “ዮ ወር ጦፎ ዹጉን እሳኒፍ ህንመልን እሼ ዹጉ ቀባተን፣ አት ማሊፍ ኡቱ ህንአደበምን ሀፍተሬ? አት እሼ ዹጉ ቀብደ መሌ ኡቱ ህንአደበምን ህንሀፍቱ።"]},{"type":"verse","number":13,"content":["አን አከ ቦዝራን ዲገምቴ ዋን ሶዳ፣ ዋን ፈፋቲፊ ዋን አባርሳ ታቱ መቃኮቲን ነንከከዸ” ጄዸ ዋቀዮ። “መጋላወንሼ ሁንድስ በረ በራን ንዲገሙ።”"]},{"type":"verse","number":14,"content":[{"text":"አን ኤርጋ ቶኮ ዋቀዮራ ዸገኤረ፦","poem":1},{"text":"ኤርገማን ቶኮ አከነ ጄቹፍ ገረ ሰቦታት ኤርገሜ፤","poem":2},{"text":"“እሼ ሎሉፍ ወልት ቀበማ!","poem":1},{"text":"ወራናፍስ በኣ!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“አን አመ ሰቦተ ግዱት ስን ጥኔሰ፤","poem":1},{"text":"ነሞተ ኬሰትሌ ቱፈተማ ስን ጎዸ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አት ከን ሀለያ ከታረ ጅራቴ","poem":1},{"text":"ፊጤ ቱሉ ቀበቴ ጅርቱ፣","poem":2},{"text":"ሶዳን አት ኦዴስቱፊ","poem":1},{"text":"ኦፍ ቱሉማን ገራኬቲ ስ ጎዎምሴረ።","poem":2},{"text":"ዮ አት አኩመ ርሳ ኦል ፈጌስቴ","poem":1},{"text":"መነ እጃረቱዩ አን አቺ ገድ ስን ቡሰ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“ኤዶም ዋን ሶዳ ታት፤","poem":1},{"text":"ነምን አቺን ደርቡ ሁንድስ ሰበቢ መዳሼ ሁንዳቲፍ","poem":2},{"lineBreak":true},{"text":"ድንቅሲፈቴ እሼት ኮልፈ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እሼን አኩመ ሶዶሚፊ ጎሞራን","poem":1},{"text":"መጋላወን ናኖሳኒ ጅረን ወጅን በሌፈመን ሰነ ንታት”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ፣","poem":2},{"text":"“ነምን ቶኮዩ አች ህንጅራቱ፣","poem":1},{"text":"ሰኚን ነማ ቶኮስ እሼ ኬሰ ህንቁበቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“አን አኩመ ሌንጨ ቦሶነ ዮርዳኖሲ በኤ","poem":1},{"text":"ገረ ለፈ ዼዳ ገበታ ዹፉ ቶኮ","poem":2},{"text":"ደፌ ኤዶምን ብየሼቲ ነንአርአ።","poem":1},{"text":"ፍለተማን አን ዋን ከናፍ ሙዱ ኤኙ?","poem":2},{"text":"ከን አከኮ ኤኙ? ኤኙቱስ ናን ሞርኩ ደንደአ?","poem":1},{"text":"ትክሴ አከሚቱ ፉለኮ ዱረ ዻበቹ ደንደአ?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ከናፉ ዋን ዋቀዮ ኤዶምት ከሮርፈቴ፣","poem":1},{"text":"ዋን እን ወረ ቴማን ኬሰ ጅራተንት ያዴስ ዸገኣ።","poem":2},{"text":"እልማን ቡሻዬ ሀርክፈመኒ ንፉዸተሙ፤","poem":1},{"text":"እንስ ሰበቢሳኒቲፍ ጄዼ ለፈ ዼደሳኒ ንበርበዴሰ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሰገሌ ኩፋቲሳኒቲን ለፍት ንራፈምት፤","poem":1},{"text":"እይሳኒ ሀመ ገላነ ዲማት ንዸገአመ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"እላ! ርሳን ቶኮ ቦዝራረት ቆቾ በልእሴ","poem":1},{"text":"ፉርጉግፈማ ገድ ቡኣ ጅረ።","poem":2},{"text":"በረ ሰነ ኬሰ ገራን ሎልቶተ ኤዶም","poem":1},{"text":"አኩመ ገራ ዱበርቲ ጭኒንስፈቹት ጅርቱ ቶኮ ተአ።","poem":2}]},{"type":"heading","content":["ኤርጋ ዋኤ ደማስቆ"]},{"type":"verse","number":23,"content":["ዋኤ ደማስቆ፦",{"text":"“ሀማቲፊ አርፋድ ንራፈሙ፤","poem":1},{"text":"እሳን ኦዱ ሀማ ዸገአኒሩቲ።","poem":2},{"text":"እሳን አብዲ ኩተተኒ አኩመ ገላነ ቦቆና","poem":1},{"text":"ህንቀብኔ ቶኮ ጄቀመኒሩ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ደማስቆን ደዸብዴርት፤","poem":1},{"text":"እሼን በቀቹፍ ገረ ገልቴርት፤","poem":2},{"lineBreak":true},{"text":"ሶዳን ጉዳን እሼ ቀበቴረ፤","poem":2},{"text":"አኩመ ሚጡ ዱበርቲ ጭኒንስፈቱ፣","poem":1},{"text":"ረክናፊ ሚጡን እሰ ቀቤረ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"መጋላን ቤከማን፣","poem":1},{"text":"መጋላን አን እት ገመዱ ሱን አከም ገተምት!","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዹጉማን ደርገጎንሼ ከራረት ዹሙ፤","poem":1},{"text":"ሎልቶትንሼ ሁንድኑ ጋፈስ አፋን ቀበቱ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"“አን ደላወን ደማስቆት እብደ ነንቀብሲሰ፤","poem":1},{"text":"እብድ ሱንስ ደአትኖ ቤን-ሀዳድ ጉቤ በሌሰ።”","poem":2}]},{"type":"heading","content":["ኤርጋ ዋኤ ቄዳሪቲፊ ሃዞር"]},{"type":"verse","number":28,"content":["ዋኤ ቄዳሪቲፊ ዋኤ ሞቱሞተ ሃዞር ከኔን ኔቡከድኔዘር ሞቲን ባብሎን ሎሌ ሰና፦",{"lineBreak":true},"ዋቀዮ አከነ ጄዸ፦",{"text":"“ከኣ፣ ቄዳርን ሎላቲ","poem":1},{"text":"ሰበ ገመ በአ ቢፍቱ በርበዴሳ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ዱንካኖትንሳኒቲፊ ቡሻዬንሳኒ ንፉዸተሙ፤","poem":1},{"text":"ጎልጋወንሳኒ ምኣፊ","poem":2},{"lineBreak":true},{"text":"ጋለወንሳኒ ወጅን ፉዸተሙ።","poem":2},{"text":"ነሞትንስ፣ ‘ገመ ሁንዳን ሶዳቱ ጅረ!’","poem":1},{"text":"ጄዸኒ እዩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“እስን ወር ሃዞር ኬሰ ጅራተን ደፋ በቀዻ!","poem":1},{"text":"ሆልቀ ገድ ፈጎ ኬሰ ዾከዻ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2},{"text":"“ኔቡከድኔዘር ሞቲን ባብሎን እስንት መለቴረ፤","poem":1},{"text":"እን ደበ እስንት ያዴረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“ከኣቲ ሰበ ነጋ ቀቡ ከን ኦፍ አመነቴ ጅራቱ","poem":1},{"text":"ሰበ ከረ ዮካን ደንቀራ ከራ ህንቀብኔ ሰነት ዱላ፤","poem":2},{"text":"ኡመትንሳ ኮጱመ ኦፊሳ ጅራተ”","poem":1},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"“ጋለወንሳኒ ንሀተሙ፣","poem":1},{"text":"ሆሪንሳኒ ባይኤንስ ንቦጅአመ።","poem":2},{"text":"አን ወረ ለፈ ፈጎ ጅረን ቅሌንሰት ብትኔሴ","poem":1},{"text":"ገመ ሁንዳን በላ እሳንት ነንፍደ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"“ሃዞር እዶ ጅሬኛ ዋንጎ፣","poem":1},{"text":"ለፈ በረ በራን ኦንቴ ታት።","poem":2},{"text":"ነምን ቶኮዩ አች ህንጅራቱ፤","poem":1},{"text":"ነምን ቶኮዩ እሼ ኬሰ ህንቁበቱ።”","poem":2}]},{"type":"heading","content":["ኤርጋ ዋኤ ኤላም"]},{"type":"verse","number":34,"content":["ጀልቀበ በረ ሞቱማ ዜዴቅያ ሞትቸ ይሁዳ ኬሰ ዱቢን ዋቀዮ ዋኤ ኤላም አከነ ጄዼ ገረ ኤርምያስ ራጅቻ ዹፌ፦"]},{"type":"line_break"},{"type":"verse","number":35,"content":["ዋቀዮ ዋን ሁንደ ደንደኡ አከነ ጄዸ፦",{"text":"“ኩኖ አን መደ ጀብነሳኒ፣","poem":1},{"text":"እዳ ኤላም ነንጨብሰ።","poem":2}]},{"type":"verse","number":36,"content":[{"text":"አን ኩታሌ ሰሚወኒ አፍረንራ","poem":1},{"text":"ቡቤ አፍረን ኤላምተን ፍደ፤","poem":2},{"text":"አን ቡቤ አፍረንት እሳን ነንብትኔሰ፤","poem":1},{"text":"ሰብን በቀቶትን ኤላም","poem":2},{"lineBreak":true},{"text":"እት ህንገሌ ቶኮዩ ህንጅራቱ።","poem":2}]},{"type":"verse","number":37,"content":[{"text":"አን ፉለ ዲኖተሳኒ፣","poem":1},{"text":"ፉለ ወረ ሉቡሳኒ ገላፈቹ በርባደኒ ዱረትኤላምን ነንበርበዴሰ፤","poem":2},{"text":"አን በላ እሳንተን ፍደ፤","poem":1},{"text":"ዼከምሰኮ ሶዳችሳ ሰነስ እሳንተን ፍደ፤","poem":2},{"text":"አን ሀመ እሳን ፍጡት ጎራዴዻን እሳን አርአ”","poem":1},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":38,"content":[{"text":"“አን ቴሶኮ ኤላም ኬሰ ዻበዼ","poem":1},{"text":"ሞቲፊ ቆንዳልቶተሼ ነንበርበዴሰ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“ተኡሌ አን በረ ዹፉፍ ጅሩ ኬሰ","poem":1},{"text":"ሀምባ ኤላም ዴብሴ ነንዻበ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JER/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JER/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JER/48.json","previousChapterAudioLinks":{},"numberOfVerses":39}