{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_ebi","name":"ኤርምያስ","commonName":"ኤርምያስ","title":"ራጂ ኤርምያስ","order":24,"numberOfChapters":52,"sha256":"e08276404fb1cf1f464d515eb4d9024ff6266c1a4a4283b37b28fd31b4fd4e55","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_ebi/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":5,"content":[{"type":"heading","content":["ነምን ቶላን ቶኮዩ ህንጅሩ"]},{"type":"verse","number":1,"content":[{"text":"“ዳንዲወን ዬሩሳሌምራ ኦሊ ገድ ዴዴብኣ፤","poem":1},{"text":"አሲፊ አች እላላቲ ቀልቤፈዻ፤","poem":2},{"lineBreak":true},{"text":"ኦብዲወንሼ ሰከተኣ።","poem":2},{"text":"እስን ዮ ነመ ዋን ቀጄላ ሆጄቱ፣","poem":1},{"text":"ከን ዹጋ በርባዱ ቶኮሌ አርገተን","poem":2},{"lineBreak":true},{"text":"አን መጋላ ከናፍ ዺፈመ ነንጎዸ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እሳን ኡቱመ ‘ዹጋ ዋቀዮ ጅራታ’ ጄዸኑ","poem":1},{"text":"አመዩ ሶባን ከከቱ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ያ ዋቀዮ፣ እጅኬ ዹጋ ህንበርባዱ?","poem":1},{"text":"አት እሳን ዾፍቴ፤ ገሩ እሳን ህንዹኩብኔ፤","poem":2},{"lineBreak":true},{"text":"አት እሳን ጨጨብስቴ፤ እሳን ገሩ ስሬፈሙ ድደን።","poem":2},{"text":"እሳን ዸጋ ጫላ መታ ጀባተኒ","poem":1},{"text":"ቀልቢ ጅጂረቹ ድደን።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አንስ አከነ ጄዼን ያዴ፤","poem":1},{"text":"“ጀር ኩኔን ህዬዪዸ፤ እሳን ጎዎተ፤","poem":2},{"text":"እሳን ከራ ዋቀዮ፣","poem":1},{"text":"ሴረ ዋቀሳኒ ህንቤከኒቲ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ከናፉ አን ሀንገፎተ ብረ ዸቄ እሳንት ነንዱበዸ፤","poem":1},{"text":"ዹጉማን እሳን ከራ ዋቀዮ፣","poem":2},{"lineBreak":true},{"text":"ሴረ ዋቀሳኒስ ንቤኩ።”","poem":2},{"text":"እሳንስ አከሱመ ዋንጆ ኦፍራ ጨጨብሰኒ","poem":1},{"text":"ህዻስ ኦፍራ ኩኩተኒሩ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ከናፉ ሌንጭ ቦሶና በኤ እሳን ኛተ፤","poem":1},{"text":"ዬዪን ገሞጂስ ዹፌ እሳን በሌሰ፤","poem":2},{"text":"ቄረንስ ወረ ገድ በአን ጭጭረቹፍ","poem":1},{"text":"መጋላወንሳኒ ብረት ርጴ ኤገተ፤","poem":2},{"text":"ፍንጭልሳኒ አከ መሌ ጉደቴ፤","poem":1},{"text":"ዱበት ዴብኡንሳኒስ ባይአቴራቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“አን አከሚነን ዺፈመ እስኒፍ ጎቹ ደንደአ?","poem":1},{"text":"እጆሌንኬ ነ ዺሰኒ","poem":2},{"lineBreak":true},{"text":"ዋቆተ ዋቆተ ህንተእኒን ከከተኒሩ።","poem":2},{"text":"አን ዋን እሳኒፍ በርባችሱ ሁንደ ኬኔፊን ቱሬ፤","poem":1},{"text":"እሳን ገሩ ንኤጀን፤","poem":2},{"lineBreak":true},{"text":"ገረ መኔን ሰጋገልቱወኒትስ ጉገተን።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እሳን ኮሮሚ ፈርዴኒ ከኔን አከ ጋሪት ሶረመኒዸ፤","poem":1},{"text":"ቶኮን ቶኮንሳኒ ኒቲ ነማት ህምምሱ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አን ዋን ከናፍ እሳን ህንአደቡሬ?”","poem":1},{"text":"ጄዸ ዋቀዮ።","poem":2},{"text":"“አን መታንኮ ሰበ አከ ሰበ ከና","poem":1},{"text":"ሃሎ ህንበኡ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ደላ ዸጋሼት ኦል በኣቲ በሌሳ፤","poem":1},{"text":"ገሩ ጉቱማን ጉቱት ምት።","poem":2},{"text":"ደሜወንሼ እራ ጭራ፤","poem":1},{"text":"ሰብን ኩን ሰበ ዋቀዮ ምት።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"መን እስራኤሊፊ መን ይሁዳ፣","poem":1},{"text":"ጉቱማን ጉቱት አናፍ ህንአመነምኔ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"እሳን ዋኤ ዋቀዮ ሶበ ዱበተን፤","poem":1},{"text":"አከነስ ጄዸን፤ “እን ሆማ ህንጎዹ!","poem":2},{"text":"ሚዻን ቶኮዩ ኑት ህንዹፉ፤","poem":1},{"text":"ጎራዴ ዮካን ቤለ ህንአርግኑ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ራጆትን ቡቤ መሌ ሆማ ምት፤","poem":1},{"text":"ዱቢን እሳን ኬሰ ህንጅሩ፤","poem":2},{"lineBreak":true},{"text":"ወን እሳን ዱበተን እሳኑመት ሃዴብኡ።”","poem":2}]},{"type":"verse","number":14,"content":["ከናፉ ዋቀዮ ዋን ሁንደ ደንደኡ አከነ ጄዸ፦",{"text":"“ሰብን ኩን ዋን ዱቢ ከነ ዱበቴፍ፣","poem":1},{"text":"አን ዱቢኮ አፋንኬ ኬሰት እብደ፣","poem":2},{"lineBreak":true},{"text":"ሰበ ከነሞ ቆራን እብድ ጉቡ ነንጎዸ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ያ መነ እስራኤል፣” ጄዸ ዋቀዮ፤","poem":1},{"text":"“አን ሰበ ዱሪቲፊ ጀባ፣","poem":2},{"text":"ሰበ አት አፋንሳ ህንቤክኔ፣","poem":1},{"text":"ከን አት ዱቢሳሌ ህንሁበትኔ ቶኮ","poem":2},{"lineBreak":true},{"text":"ብየ ፈጎዻ ስት ነንፍደ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"መንኤን ጥየሳኒ አኩመ አዋለ በነማት፤","poem":1},{"text":"ሁንድሳኒስ ሎልቶተ ጀጀቦዸ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እሳን ምዻንኬቲፊ ቡዴነኬ ንኛቱ፤","poem":1},{"text":"እልማንኬቲፊ እንተለንኬ ንአጄሱ፤","poem":2},{"text":"ቡሻዬፊ ሎንኬ ንኛቱ፤","poem":1},{"text":"ወይኒኬቲፊ ሙኬን ሀርቡኬቲ ንኛቱ።","poem":2},{"text":"መጋላወን ደላ ጀባ ቀበን","poem":1},{"text":"ከኔን አት አመነቴ ሰነ ጎራዴዻን በርበዴሱ።","poem":2}]},{"type":"verse","number":18,"content":["“ተኡስ አን በረ ሰነ ኬሰዩ ጉቱማን ጉቱት እስን ህንበሌሱ” ጄዸ ዋቀዮ።"]},{"type":"verse","number":19,"content":["“ዮሙ ነሞትን፣ ‘ዋቀዮ ዋቅንኬኘ ማሊፍ ዋን ከነ ሁንደ ኑት ፍዴ?’ ጄዸኒ ጋፈተንት፣ አት፣ ‘እስን አኩመ ነ ዺፍተኒ ብየኬሰን ኬሰት ዋቆተ ኦርማ ተጃጅልተን ሰነ፣ አመስ ብየ ከን መታኬሰኒ ህንተእን ኬሰት ኦርሞተ ንተጃጅልቱ’ ጄቴ እሳንት ህምተ።"]},{"type":"verse","number":20,"content":[{"text":"“ዋን ከነ መነ ያቆብት ህማ፤","poem":1},{"text":"ይሁዳ ኬሰትስ ለብሳ፦","poem":2}]},{"type":"verse","number":21,"content":[{"text":"እስን ኡመትን ጎዋን ሁበትና ህንቀብኔ፣","poem":1},{"text":"ወር ኡቱ እጀ ቀብደኑ ህንአርግኔ","poem":2},{"lineBreak":true},{"text":"ከኔን ኡቱ ጉረ ቀብደኑህንዸጌኜ ዋን ከነ ዸገአ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"እስን ነ ህንሶዳተኒ?”","poem":1},{"text":"ጄዸ ዋቀዮ።","poem":2},{"lineBreak":true},{"text":"“ፉለኮ ዱረት ህንሆለተኒ?","poem":2},{"text":"አን ገላናፍ ጭረቸ ዳሪ ደላ በረ በራ ከን እን","poem":1},{"text":"ቀጣሙሩ ህንደንዴኜ ጎዼ ቶልቼረ።","poem":2},{"text":"ዸኣን ገላና ዮ እት ቡኤዩ እሰ ዲጉ ህንደንደኡ፤","poem":1},{"text":"ገላንች ዮ ሁርሴዩ፣ እሰ ጨብሴ ደርቡ ህንደንደኡ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ሰብን ኩን ገሩ መተ ጀቤሳፊ ፍንጭላዸ፤","poem":1},{"text":"እንስ ከራራ ጀልአቴ በዴረ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"እሳን ገራሳኒት አከነ ህንጄዸን፤","poem":1},{"text":"‘ኮታ ዋቀዮ ዋቀኬኘ እሰ ቦካ አርፋሳቲፊቦካ ብራ ወቅቲዻን ኬኑ፣","poem":2},{"text":"እሰ ቶርበኖተ እት ምዻን ወልት ቀበትኑ","poem":1},{"text":"ዬሮሳኒት ኑ ኬኑ ሰነ ሃሶዳትኑ።’","poem":2}]},{"type":"verse","number":25,"content":[{"text":"በሌሳንኬሰን ዋን ከነ እስንራ ዴብሴረ፤","poem":1},{"text":"ጩቡንኬሰን ዋን ጋሪ እስን ዸብሲሴረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“ሰበኮ ግዱ ነሞተ ሀሞ","poem":1},{"text":"አከ ወረ ነመ ቀቡፍ ክዮ ካአኒት፣","poem":2},{"lineBreak":true},{"text":"አኩመ ነመ ክዮን ስምብሮ ቀቡትርጰኒ ኤገተንቱ ጅረ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"አኩመ መንኤን ስምብራን ጉተሙ፣","poem":1},{"text":"መኔንሳኒ ሶባን ጉተሙ፤","poem":2},{"text":"እሳንስ ሶሬዪፊ ጀጀቦ ተአኒ፣","poem":1}]},{"type":"verse","number":28,"content":[{"text":"ገበተኒ በሬደኒሩ፤","poem":2},{"text":"ሀምንሳኒ ዹመ ህንቀቡ፤","poem":1},{"text":"እሳን ሙርቲ ቀጄላ ህንበርባደን።","poem":2},{"text":"እሳን ዽመ እጆሌ አባ ህንቀብኔቲፍ ህንፈልመን፤","poem":1},{"text":"ምርገ ህዬዪቲፍስ ህንዻበተን።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"አን ዋን ከናፍ እሳን ህንአደቡ?”","poem":1},{"text":"ጄዸ ዋቀዮ።","poem":2},{"text":"“አን ሰበ አከሲ","poem":1},{"text":"ሃሎ ህንባፈዹ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“ወን ሱከኔሳን ነመ ርፈቺሱ ቶኮ","poem":1},{"text":"ብየቲ ኬሰት ተኤረ፦","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ራጆትን ራጂ ሶባ ዱበቱ፤","poem":1},{"text":"ሉቦትን ሁምኑመሳኒቲን ብየ ቡልቹ፤","poem":2},{"text":"ሰብንኮስ ዋን አከሲ ጃለተ፤","poem":1},{"text":"እስን ገሩ ዹመረት ማል ጎቹፍ ጅርቱ?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JER/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JER/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JER/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}