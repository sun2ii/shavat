{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_ebi","name":"ኤርምያስ","commonName":"ኤርምያስ","title":"ራጂ ኤርምያስ","order":24,"numberOfChapters":52,"sha256":"e08276404fb1cf1f464d515eb4d9024ff6266c1a4a4283b37b28fd31b4fd4e55","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_ebi/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":50,"content":[{"type":"heading","content":["ኤርጋ ዋኤ ባብሎን"]},{"type":"verse","number":1,"content":["ዱቢን ዋቀዮ ከራ ኤርምያስ ራጅቻቲን ዋኤ ባብሎኒፊ ዋኤ ብየ ባብሎኖታ ዱበቴ ከናዸ፦"]},{"type":"verse","number":2,"content":[{"text":"“ሰቦተ ግዱት ለለባቲ ለብሳ፤","poem":1},{"text":"ፋጂ ኦል ቀባቲ ለብሳ፤","poem":2},{"lineBreak":true},{"text":"ኡቱ ሆማ ህንሀምብስን አከነ ጄዻ፤","poem":2},{"text":"‘ባብሎን ንቀበምት፤","poem":1},{"text":"ቤል ንሰልጵፈመ፤","poem":2},{"lineBreak":true},{"text":"ሜሮደክ ጎሊዻን ጉተመ።","poem":2},{"text":"ፈኪወን ባብሎን ንሰልጵፈሙ፤","poem":1},{"text":"ዋቆንሼ ቶልፈሞንስ ሶዳን ጉተሙ።’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሰብን ካባ ዹፉ ቶኮ እሼ ሎሌ","poem":1},{"text":"ለፈሼ ዱዋ ሀምብሰ።","poem":2},{"text":"ነምን ቶኮዩ እሼ ኬሰ ህንጅራቱ፤","poem":1},{"text":"ነማፊ ሆሪን በቀቴ ኬሳ በአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“በረ ሰነ ኬሰ፣ ዬሮ ሰነት፣","poem":1},{"lineBreak":true},{"text":"ሰብን እስራኤሊፊ ሰብን ይሁዳ","poem":1},{"text":"እምማኒን ዋቀዮ ዋቀሳኒ በርባቸ","poem":2},{"lineBreak":true},{"text":"ቶኩማዻን ንዹፉ” ጄዸ ዋቀዮ፤","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“እሳን ከራ ገረ ጥዮን ጌሱ ንጋፈቱ፤","poem":1},{"text":"ፉለሳኒስ ገረስት ገረገልፈቱ።","poem":2},{"text":"እሳን ዹፈኒ ከኩ በረ በራ","poem":1},{"text":"ከን ጎንኩማ ህንእራንፈተምኔን","poem":2},{"lineBreak":true},{"text":"ዋቀዮት ኦፍ መጠንሱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“ሰብንኮ ሆሎተ በደን ተአኒሩ፤","poem":1},{"text":"ትክሴንሳኒ እሳን ዶጎጎርሴ","poem":2},{"lineBreak":true},{"text":"አከ እሳን ቱሉወንረ ጆረን ጎዼ።","poem":2},{"text":"እሳን ቱሉፊ ጋረረ ጆረኒ","poem":1},{"text":"ለፈ ቦቆናሳኒሌ ወላለን።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ከን እሳን አርጉ ሁንድ እሳን ልቅምሴ፤","poem":1},{"text":"ዲኖትንሳኒስ፣ ‘ኑ በሌሳ ህንቀብኑ፤","poem":2},{"text":"እሳን ዋቀዮ እዶ ጅሬኘሳኒ ከን ዹጋ ተኤ፣","poem":1},{"text":"ዋቀዮ አብዲ አቦቲሳኒት ጩቡ ሆጄተኒሩቲ’ ጄዸን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ባብሎኒ በቀዻ በኣ፤","poem":1},{"text":"ብየ ባብሎኖታ ኬሳ በኣ፤","poem":2},{"lineBreak":true},{"text":"አኩመ ኮርቤሰ ሬኤ ከን ቡሻዬ ቀጄልቹ ተኣ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አን ብየ ካባቲ ገሬ ሰቦተ ጉርጉዳ ካሴ","poem":1},{"text":"ባብሎንት ነንኤርጋቲ።","poem":2},{"text":"እሳንስ ህሪረኒ እሼት ዹፉ፤","poem":1},{"text":"እሼንስ ከራ ካባቲን ንቀበምት።","poem":2},{"text":"ጥይሳኒ አኩመ ሎልቶተ ኦጌዪ","poem":1},{"text":"ሀርከ ዱዋ ህንዴብኔት።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ባብሎንስ ንሳመምት፤","poem":1},{"text":"ወር እሼ ሳመን ሁንድስ ንቁፉ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“እስን ወር ሀንዹራኮ ሳምተን","poem":1},{"text":"ዋን ገመደኒፊ እልልችተኒፍ፣","poem":2},{"text":"አኩመ ራዳ መርገ ኬሳ ቡራቅጠኒ","poem":1},{"text":"አከ ኮርመ ፈርዳ እምምስተንሌ፣","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሃትኬሰን አከ መሌ ቃኖፍት፤","poem":1},{"text":"ከን እስን ዴሴስ ንሰልጰት።","poem":2},{"text":"እሼን ሰቦተ ሁንደ ኬሳ ገድ ኣንቱ፣","poem":1},{"text":"ለፈ ኦና፣ ለፈ ጎጋፊ ገሞጂ ታት።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እሼን ሰበቢ ዼከምሰ ዋቀዮቲፍ ጉቱማን ጉቱት","poem":1},{"text":"ንኦንት መሌ ነምን እሼ ኬሰ ህንጅራቱ።","poem":2},{"text":"ሰበቢ መዳሼ ሁንዳቲፍ","poem":1},{"text":"ነምን ባብሎን ኬሰ ደርቡ ሁንድ ንድንቅሲፈተ፤ እት ቆሰስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“እስን ወር እዳ ሉቅፈተን ሁንድኑ፣","poem":1},{"text":"ናኖ ባብሎንት ህሪራ።","poem":2},{"text":"ሰበቢ እሼን ዋቀዮት ጩቡ ሆጄቴፍ፣","poem":1},{"text":"ጥየወን እት ደርበዻ! ሆማ ህንሀምብስና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ከራ ሁንዳን እሼት እያ!","poem":1},{"text":"እሼን ሀርከኬነት፤ ገሞንሼ ንጅገ፤","poem":2},{"lineBreak":true},{"text":"ደላንሼ ዲገሜረ።","poem":2},{"text":"ኩን ሃሎ ዋቀዮ ዋን ተኤፍ","poem":1},{"text":"እሼት ሃሎ በኣ፤","poem":2},{"lineBreak":true},{"text":"ዋኑመ እሼን ወረ ካንት ሆጄቴ እሼት ሆጄዻ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ነመ ሰኚ ፈጫሱፊ ከን ዬሮ ምዻን ሃመሙት","poem":1},{"text":"ሃምቱ ቀበቱስ ባብሎን ኬሳ በሌሳ።","poem":2},{"text":"ሰበቢ ጎራዴ ጩንቁርሳቲን","poem":1},{"text":"ቶኮን ቶኮን ነማ ገረ ሰበ ኦፊሳት ሃዴብኡ፤","poem":2},{"lineBreak":true},{"text":"ቶኮን ቶኮን ነማ ገረ ብየ ኦፊ እሳትስ ሃበቀቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“እስራኤል ሆላ ብትናኤዸ፤","poem":1},{"text":"ሌንጮትን እሰ አርአን።","poem":2},{"text":"ከን ጀልቀበት እሰ ኛቴ ሞቲ አሶር፤","poem":1},{"text":"ከን ዹመረት ለፌሳ ጨጨብሴሞ","poem":2},{"lineBreak":true},{"text":"ኔቡከድኔዘር ሞትቸ ባብሎን ቱሬ።”","poem":2}]},{"type":"verse","number":18,"content":["ከናፉ ዋቀዮ ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦",{"text":"“አን አኩመ ሞቲ አሶር አደቤ ሰነ","poem":1},{"text":"ሞቲ ባብሎኒፊ ብየሳ ነንአደበ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እስራኤልን ገሩ ለፈ ትከሳት ነንዴብሰ፤","poem":1},{"text":"እንስ ቀርሜሎሲፊ ባሻንረ ንዼደ፤","poem":2},{"lineBreak":true},{"text":"ቱሉ ኤፍሬሚፊ ግልኣድራ ዼዴ ንቁፈ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"በረ ሰነ ኬሰ፣ ዬሮ ሰነት፣","poem":1},{"text":"የክ እስራኤል ንበርባደመ” ጄዸ ዋቀዮ፤","poem":2},{"text":"“ገሩ ቶኮዩ ህንጅሩ፤","poem":1},{"text":"ጩቡን ይሁዳስ ንበርባደመ፤","poem":2},{"text":"ገሩ ቶኮዩ ህንአርገሙ፤","poem":1},{"text":"አን ሀምባን በራሬ ሰናፍ","poem":2},{"lineBreak":true},{"text":"ዺፈመ ነንጎዻቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“ብየ ሜራታይሚፊ","poem":1},{"text":"ጅራቶተ ጴቆድ ሎላ።","poem":2},{"text":"አርኣ፣ አጄሳ፣ ጉቱማን ጉቱት እሳን በሌሳ፣”","poem":1},{"text":"ጄዸ ዋቀዮ።","poem":2},{"lineBreak":true},{"text":"“ዋን አን እስን አጀጄ ሁንደ ጎዻ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ሰገሌን ወራና፣","poem":1},{"text":"ሰገሌን በዲሰ ጉዳስ ብየ ሰነ ኬሰ ጅረ!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ቡሩስን ጉቱማ ለፋ አከምት ጨቤ!","poem":1},{"text":"አከምትስ ቡላኤ!","poem":2},{"text":"ባብሎን ሰቦተ ግዱት፣","poem":1},{"text":"አከም ኦንቴ!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ያ ባብሎን፣ አን ክዮ ሲፍ ድሪርሴረ፤","poem":1},{"text":"አትስ ኡቱ ህንቤክን ቀበምቴ፤","poem":2},{"text":"አት ሰበቢ ዋቀዮን ሞርምቴፍ፣","poem":1},{"text":"አርገምቴ ቀበምቴ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዋቀዮ መንኩሳ ምአ ሎላሳ በኔ","poem":1},{"text":"ምአ ሎለ ዼከምሰሳ ገድ ባፈቴረ፤","poem":2},{"text":"ጎፍታን፣ ዋቀዮ ዋን ሁንደ ደንደኡ","poem":1},{"text":"ዋን ብየ ባብሎኖታት ሆጄቱ ቀባቲ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ብየ ፈጎቲ እሼት ኮታ።","poem":1},{"text":"ጎምብሳወንሼ ዲጋ፤","poem":2},{"lineBreak":true},{"text":"አኩመ ቱላ ምዻኒት እሼ ቱላ።","poem":2},{"text":"ጉቱማን ጉቱት እሼ በሌሳ፤","poem":1},{"text":"ዋን ቶኮሌ እሼፍ ህንሀምብስና።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ኮሮሚሼ ሁንደ ቀላ፤","poem":1},{"text":"እሳን ገረ ቀልማት ሃጌፈመን!","poem":2},{"text":"እሳኒፍ ወዮ! ዬሮን እሳን እት አደበመን፣","poem":1},{"text":"ጉያንሳኒ ዹፌራቲ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"አከ ዋቀዮ ዋቅንኬኘ ሃሎ በኤ፣","poem":1},{"text":"አከ እን መነ ቁልቁሉማሳቲፍ ሃሎ በኤ፣","poem":2},{"text":"ኮሉ ገልቶታፊ በቀቶተ ባብሎኒ ዹፈኒ","poem":1},{"text":"ጥዮን ኬሰት ለለበንራ ዸገኣ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“ነሞተ ጥያን ሎለን","poem":1},{"text":"ከኔን እዳ ሉቅፈተን ሁንደ ባብሎንት ዋማ።","poem":2},{"text":"ናኖሼ ሁንደ መርሳ፤","poem":1},{"text":"ነምን ቶኮዩ ህንምልቅን።","poem":2},{"text":"ገቲ ሆጂሼ ኬናፊ፤","poem":1},{"text":"ዋኑመ እሼን ወረ ካንት ሆጄቴ እሼትስ ሆጄዻ።","poem":2},{"text":"እሼን ቁልቁልቸ እስራኤል፣","poem":1},{"text":"ዋቀዮት ኮርቴርቲ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ከናፉ ደርገጎንሼ ከራረት ዹሙ፤","poem":1},{"text":"ጋፈስ ሎልቶትንሼ ሁንድ ንበርበዳኡ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"“ያ ኮርቱነነ፣ ኩኖ አን ስት ከኤረ”","poem":1},{"text":"ጄዸ ጎፍታን፣ ዋቀዮ ዋን ሁንደ ደንደኡ፤","poem":2},{"text":"“ዬሮን አት እት አደበምቱ፣","poem":1},{"text":"ጉያንኬ ዹፌራቲ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ኮርቱን ሱን ጉፈቴ ለፈ ዾፍት፤","poem":1},{"text":"ነምን ገርጋሬ ኦል እሼ ቀቡ ቶኮዩ ህንጅሩ፤","poem":2},{"text":"አን መጋላወንሼ ኬሰት","poem":1},{"text":"እብደ ወረ ናኖሼ ጅሩ ሁንደጉቤ ፍጡ ነንቀብሲሰ።”","poem":2}]},{"type":"verse","number":33,"content":["ዋቀዮ ዋን ሁንደ ደንደኡ አከነ ጄዸ፦",{"text":"“ሰብን እስራኤል ጩንቁርፈሜረ፤","poem":1},{"text":"ሰብን ይሁዳስ አከሱመ ጩንቁርፈሜረ።","poem":2},{"text":"ወር እሳን ቦጅአን ሁንድ ጀቤሰኒ እሳን ቀበተኒሩ፤","poem":1},{"text":"እሳን ገድ ዺሱስ ድደኒሩ።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ተኡሌ ፉራንሳኒ ጀባዸ፤","poem":1},{"text":"መቃንሳስ ዋቀዮ ዋን ሁንደ ደንደኡዸ።","poem":2},{"text":"እን ብየሳኒቲፍ ቦቆና ኬኔ፤","poem":1},{"text":"ወረ ባብሎን ኬሰ ጅራተን ገሩ ቦቆና ዾዉፍ","poem":2},{"lineBreak":true},{"text":"ዽመሳኒቲፍ ጀቤሴ ንፈልመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"“ጎራዴን ቶኮ ባብሎኖተት ዹፌ!”","poem":1},{"text":"ጄዸ ዋቀዮ፤","poem":2},{"text":"“ወረ ባብሎን ኬሰ ጅራተንት፣","poem":1},{"text":"ቆንዳልቶታፊ ነሞተሼ ኦጌዪት ዹፌረ!","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ጎራዴን ራጆተሼ ሶብዶተት፣ ዹፌረ!","poem":1},{"text":"እሳን ጎዎተ ተኡ።","poem":2},{"text":"ጎራዴን ጎቶተሼት ዹፌረ!","poem":1},{"text":"እሳንስ ሶዳዻን ጉተሙ።","poem":2}]},{"type":"verse","number":37,"content":[{"text":"ጎራዴን ፈርዴኒፊ ጋሪወንሼት፣","poem":1},{"text":"ነሞተ ኦርማ ከኔን ግዱሼ ጅራተን ሁንደት ዹፌ!","poem":2},{"lineBreak":true},{"text":"እሳን ደዸቦ ተኡ።","poem":2},{"text":"ጎራዴን ቀቤኘሼት ዹፌ!","poem":1},{"text":"እሳን ንሳመሙ።","poem":2}]},{"type":"verse","number":38,"content":[{"text":"ጫምሳን ብሻንሼት ንዹፈ!","poem":1},{"text":"እሳንስ ንጎጉ።","poem":2},{"text":"እሼን ብየ ዋቆተ ቶልፈሞ፣","poem":1},{"text":"ከን ዋቆተ ቶልፈሞ ሶዳዻን መራተኒቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“ከናፉ ኡመመወን ገሞጂቲፊወራቤዪን አች ጅራቱ፤","poem":1},{"text":"ኡሩንጉንስ አች ጅራት።","poem":2},{"text":"ለመተ ነምን እሼ ኬሰ ህንጅራቱ፤","poem":1},{"text":"ዮካን ዸሎታ ሀመ ዸሎታትነምን ኬሰ ጅራቱ ህንጅሩ።","poem":2}]},{"type":"verse","number":40,"content":[{"text":"አኩመ ዋቅን ሶዶሚፊ ጎሞራ፣","poem":1},{"text":"መጋላወን ናኖሳኒ ጅረን ወጅን በሌሴ ሰነ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ፤","poem":2},{"text":"“ነምን ቶኮዩ አች ህንጅራቱ፤","poem":1},{"text":"ሰኚን ነማ ቶኮስ እሼ ኬሰ ህንቁበቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"“ኩኖ! ገሬን ሎልቶታ ቶኮ ካበራ ዹፋ ጅረ፤","poem":1},{"text":"ሰብን ጉዳን ቶኮፊ ሞቶትን ባይኤን","poem":2},{"lineBreak":true},{"text":"ሞጋ ለፋቲ ሶሶቾኣ ጅሩ።","poem":2}]},{"type":"verse","number":42,"content":[{"text":"እሳን ጥያፊ ኤቦ ቀበተኒሩ፤","poem":1},{"text":"እሳን ገረ ጀቤዪ ነማፍስ ናሱ ህንቀብኔዸ።","poem":2},{"text":"ዮሙ እሳን ፈርዴንሳኒ ጉሉፈንት","poem":1},{"text":"ግግግሱንሳኒ አኩመ ሁርሳ ገላናት፤","poem":2},{"text":"ያ እንተለ ባብሎን፣","poem":1},{"text":"እሳን አኩመ ነሞተ ዱላፍ ህሪረኒት ስ ሎሉፍ ዹፉ።","poem":2}]},{"type":"verse","number":43,"content":[{"text":"ሞቲን ባብሎን ኦዱ ዋኤሳኒ ዸገኤ፤","poem":1},{"text":"ሀርክሳስ እረት ዱኤ።","poem":2},{"text":"ዽጵን እሰ ቀበቴረ፤","poem":1},{"text":"ሚጡንስ አኩመ ዱበርቲ ጭኒንስፈቱ እሰ ቀቤረ።","poem":2}]},{"type":"verse","number":44,"content":[{"text":"አን አኩመ ሌንጨ ቦሶነ ዮርዳኖሲ በኤ","poem":1},{"text":"ገረ ለፈ ዼዳ ገበታ ዹፉ ቶኮ","poem":2},{"lineBreak":true},{"text":"ደፌ ባብሎንን ብየሼቲ ነንአርአ።","poem":2},{"text":"ፍለተማን አን ዋን ከናፍ ሙዱ ኤኙ?","poem":1},{"text":"ከን አከኮ ኤኙ?","poem":2},{"text":"ኤኙቱስ ናን ሞርኩ ደንደአ?","poem":1},{"text":"ትክሴ አከሚቱ ፉለኮ ዱረ ዻበቹ ደንደአ?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"ከናፉ ዋን ዋቀዮ ባብሎንት ከሮርፈቴ፣","poem":1},{"text":"ዋን እን ብየ ባብሎኖታት ያዴስ ዸገኣ፤","poem":2},{"text":"እልማን ቡሻዬ ሀርክፈመኒ ንፉዸተሙ፤","poem":1},{"text":"እንስ ሰበቢሳኒቲፍ ለፈ ዼደሳኒጉቱማን ጉቱት ንበርበዴሰ።","poem":2}]},{"type":"verse","number":46,"content":[{"text":"ወጨ ቀበሙ ባብሎኒቲን ለፍት ንራፈምት፤","poem":1},{"text":"እይሼስ ሰቦተ ግዱት ንዸገአመ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JER/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JER/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JER/49.json","previousChapterAudioLinks":{},"numberOfVerses":46}