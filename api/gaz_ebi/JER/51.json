{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_ebi","name":"ኤርምያስ","commonName":"ኤርምያስ","title":"ራጂ ኤርምያስ","order":24,"numberOfChapters":52,"sha256":"e08276404fb1cf1f464d515eb4d9024ff6266c1a4a4283b37b28fd31b4fd4e55","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_ebi/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“ኩኖ አን ባብሎኒፊ ሰበ እሼ ኬሰ ጅራቱት","poem":1},{"text":"ቡቤ ዋ በሌሱ ነንካሰ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አን አከ እሳን ግንግልቸኒ እሼ በሌሰኒፍ","poem":1},{"text":"ኦርሞተ ባብሎንት ነንኤርገ፤","poem":2},{"text":"እሳን ጋፈ በዲሰሼ፣","poem":1},{"text":"ከራ ሁንዳኑ እሼን ሞርሙ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አባን ጥያ እዳሳ ህንአጋምን፣","poem":1},{"text":"ዮካን ምአ ሎላ ህንህዸን።","poem":2},{"text":"ደርገጎተሼ ህንባስና፤","poem":1},{"text":"ሎልቶተሼሌ ጉቱማን ጉቱት በርበዴሳ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እሳን ቀለመኒ ባብሎን ኬሰ ንሀርጫፈሙ፤","poem":1},{"text":"ዳንዲወንሼረትስ ንመዳኡ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዮ ብይሳኒ ፉለ ቁልቁልቸ እስራኤል ዱረት","poem":1},{"text":"የካን ጉተምቴ ጅራቴዩ","poem":2},{"text":"ዋቅንሳኒ፣ ዋቀዮ ዋን ሁንደ ደንደኡ","poem":1},{"text":"እስራኤሊፊ ይሁዳ ህንገትኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“ባብሎን ኬሳ በቀዻ!","poem":1},{"text":"ሉቡኬሰን ኦልፈዻ!","poem":2},{"lineBreak":true},{"text":"እስን ሰበቢ ጩቡ እሼቲፍ ህንዹምና።","poem":2},{"text":"ዬሮን ኩን ዬሮ ሃሎ በኡ ዋቀዮት፤","poem":1},{"text":"እንስ ገቲ እሼፍ መሉ ንኬናፍ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ባብሎን ሀርከ ዋቀዮ ኬሰት ጦፎ ወርቄ ቱርቴ፤","poem":1},{"text":"እሼን ጉቱማ ለፋ ንመቼስቴ።","poem":2},{"text":"ሰቦትን ዳዺ ወይኒሼ ዹገን፤","poem":1},{"text":"ከናፉ አመ መራተኒሩ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ባብሎን አኩመ ተሳ","poem":1},{"text":"ኩፍቴ ጨጨብድ፤ እሼፍ ቦኣ!","poem":2},{"text":"ቆርቸ እሼን መዳ ድበቱ ፍዳፊ፤","poem":1},{"text":"ተሪ እሼን ንፈይት ተኣቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ ‘ኑ ባብሎንን ፈይሱ ያሌረ፤","poem":1},{"text":"እሼን ገሩ ፈዩ ህንደንዴሱ፤","poem":2},{"text":"ኮታ ቶኮን ቶኮንኬኘ እሼ ዺፍኔ","poem":1},{"text":"ገረ ብየ ኦፊኛት ሃቀጄሉ፤","poem":2},{"text":"ሙርቲንሼ ሀመ ሰሚት ኦል በኤ፣","poem":1},{"text":"ሀመ ዱሜሳት ኦል ፈጋቴራቲ።’","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘ዋቀዮ ቀጄሉማኬኘ ዹጋ ኑ በኤረ፤","poem":1},{"text":"ኮታ፣ ዋን ዋቀዮ ዋቅንኬኘ ሆጄቴ","poem":2},{"lineBreak":true},{"text":"ጥዮን ኬሰት ሃኦዴስኑ።’","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ጥየ ቀረዻ፤","poem":1},{"text":"ጋቸነሌ ፉዸዻ!","poem":2},{"text":"ሰበቢ ካዮንሳ ባብሎንን በሌሱ ተኤፍ","poem":1},{"text":"ዋቀዮ ሞቶተ ሜዴ ከካሴረ።","poem":2},{"text":"ዋቀዮ ሃሎ ንበአ፤","poem":1},{"text":"መነ ቁልቁሉማሳቲ ሃሎ ንበአ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ደላ ባብሎንት ፋጂ ካሳ!","poem":1},{"text":"ኤጉምሰ ጀጀቤሳ፤","poem":2},{"text":"ኤግዱ ዻባ፤","poem":1},{"text":"ወረ ርጴ ኤገቱ ቆጴሳ!","poem":2},{"text":"ዋቀዮ ካዮሳ","poem":1},{"text":"ዋን ሰበ ባብሎንት ሙሬ ሰነ ፊጣን ባፈተ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አት ከን ብሻን ባይኤ ቀብዱ፣","poem":1},{"text":"ከን ቀቤኛንስ በዻቴ፣","poem":2},{"text":"ዹምንኬ ዹፌረ፤","poem":1},{"text":"ዬሮን አት እት በዱ ገኤረ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዋቀዮ ዋን ሁንደ ደንደኡ ኦፊን ከከቴረ፦","poem":1},{"text":"አን ዹጉማን ነሞተ አኩመ ሆማ ሀዋንሳስት ገድ ዺሰ፤","poem":2},{"lineBreak":true},{"text":"እሳንስ ሞአናዻን ስት ዻደቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“እን ሁምነሳቲን ለፈ ኡሜ፤","poem":1},{"text":"ኦጉማሳቲን አዱኛ ሁንዴሴ፤","poem":2},{"lineBreak":true},{"text":"ሁበትናሳቲንስ ሰሚወን ድሪርሴ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዮሙ እን ቀቀዌሰኡት ብሻኖትን ሰሚ ንሁርሱ፤","poem":1},{"text":"እን አከ ዱሜሶን ዳሪ ለፋቲ ኦል ከአን ንጎዸ።","poem":2},{"text":"ቦካ ወጅን በለቄ ንኤርገ፤","poem":1},{"text":"መንኩሳሌሳ ኬሳሞ ቡቤ ንፍደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“ቶኮን ቶኮን ነማ ጎዋፊ ከን ቤኩምሰ ህንቀብኔዸ፤","poem":1},{"text":"ቶኮን ቶኮን ቱምቱ ወርቄ ዋቆተ ቶልፈሞሳቲን ቃኔፈመ።","poem":2},{"text":"ፈኪወን እን ቶልቹ ከን ሶባት፤","poem":1},{"text":"እሳን ሀፉረ ባፈተን ኦፍ ኬሳ ህንቀበን።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እሳን ፋይዳ ህንቀበን፤ ሜሻ ቆሳት፤","poem":1},{"text":"ዬሮ አደቢንሳኒ ገኡት ንበዱ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እን ቆደ ያቆብ ተኤ ሱን ገሩ አከ ወረ ከና ምት፤","poem":1},{"text":"እን ኡማ ዋን ሁንዱማት፤","poem":2},{"text":"እስራኤልሞ ጎሰ ዻለሳት፤","poem":1},{"text":"መቃንሳስ ዋቀዮ ዋን ሁንደ ደንደኡዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“አት ቦኩኮ ከን ዱላ","poem":1},{"text":"ምአ ሎላኮቲት፤","poem":2},{"text":"አን ሲን ሰቦተ ነንጨጨብሰ፤","poem":1},{"text":"ሲን ሞቱሞተ ነንበርበዴሰ፤","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አን ሲን ፈርዳፊ ያበታ ፈርዳ ነንጨጨብሰ፤","poem":1},{"text":"ሲን ጋሪፊ ኦፍቱሳ ነንጨጨብሰ፤","poem":2}]},{"type":"verse","number":22,"content":[{"text":"አን ሲን ዺራ ዱበርቶተ ነንጨጨብሰ፤","poem":1},{"text":"ሲን ጃርሳ ደርገጌሰ ነንጨጨብሰ፤","poem":2},{"lineBreak":true},{"text":"ሲን ገኤሳፊ ሸመሬ ነንጨጨብሰ፤","poem":2}]},{"type":"verse","number":23,"content":[{"text":"አን ሲን ትክሴፊ ቡሻዬ ነንጨጨብሰ፤","poem":1},{"text":"ሲን ቆቱፊ ቆትዮ ነንጨጨብሰ፤","poem":2},{"lineBreak":true},{"text":"ሲን ቡልችቶታፊ ቆንዳልቶተ ነንጨጨብሰ።","poem":2}]},{"type":"verse","number":24,"content":["“አን ኡቱመ እጅኬሰን አርጉ ዋን እሳን ጥዮን ጎዸን ሁንዳፍ ባብሎኒፊ ወረ ባብሎን ኬሰ ጅራተን ሁንዳፍ ገቲሳኒ ነንኬነ” ጄዸ ዋቀዮ።"]},{"type":"verse","number":25,"content":[{"text":"“ያ ቱሉ በርበዴሳ፣","poem":1},{"text":"አት ከን ለፈ ሁንደ በሌስቱ አን ስት ከኤረ፤","poem":2},{"lineBreak":true},{"text":"አን ሀርከኮ ስት ነንካፈዸ፤","poem":2},{"text":"ኤዴደራ ገድ ገንገልቼ","poem":1},{"text":"ቱሉ ጉበማ ስን ጎዸ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"“ዋን አት በረ በራን ኦንቱፍ፣","poem":1},{"text":"ከታን ዸጋ ጎሌ ተኡ፣","poem":2},{"text":"ዮካን ዸጋን ሁንዴፍ ተኡ ቶኮዩ ስ ኬሳ ህንፉዸተሙ”","poem":1},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“ብየቲ ኬሰት ፋጂ ኦል ቀባ!","poem":1},{"text":"ሰቦተ ግዱትስ መለከተ አፉፋ!","poem":2},{"text":"ሰቦተ ወራናፍ እሼት ቆጴሳ፤","poem":1},{"text":"ሞቱሞተ አራራት፣","poem":2},{"lineBreak":true},{"text":"ከን ሚኒቲፊ አሽኬነስ እሼት ዋማ።","poem":2},{"text":"አጀጃ ወራና እሼት ሹማ፤","poem":1},{"text":"ፈርዴን አከ ሆማ ሀዋንሳ እት ኤርጋ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"እሼ ወራኑዻፍ ሰቦተ ጄቹንስ፣","poem":1},{"text":"ሞቶተ ሜዴ","poem":2},{"text":"ቡልችቶተሳኒቲፊ ቆንዳልቶተሳኒ ሁንደ፣","poem":1},{"text":"ብዮተ እሳን ቡልቸን ሁንደስ ቆጴሳ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ሰበቢ ወን ዋቀዮ","poem":1},{"text":"አከ ነምን ቶኮዩ አች ህንጅራኔፍ","poem":2},{"text":"ብየ ባብሎን ኦንሱፍ ባብሎንት ከሮርፈቴ ሱን","poem":1},{"text":"ጀባቴ ዻበቱፍ ብየቲን ንራፈምት፤ ንዽዺተትስ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ጎቶትን ባብሎን ሎለ ዺሰኒሩ፤","poem":1},{"text":"እሳን ደአትኖሳኒ ኬሰት ሀፈኒሩ።","poem":2},{"text":"ጀብንሳኒ ዹሜረ፤","poem":1},{"text":"እሳን አኩመ ዱበርቶታ ተአኒሩ።","poem":2},{"text":"እዶ ጅሬኘሼት እብድ ቀብሲፈሜረ፤","poem":1},{"text":"ደንቀራወን በልበለሼስ ጨጨበኒሩ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"አከ መጋላንሳ ሞጋ ሀመ ሞጋት ቀበምቴ","poem":1},{"text":"ሞቲ ባብሎንት ህሙፍ፣","poem":2},{"text":"ፊግዱን ቶኮ እሰ ካን ቀቀቡፍ፣","poem":1},{"text":"ኤርገማን ቶኮስ ኤርገማ ካን ቀቀቡፍ ፊገ፤","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ኩንስ አከ መልካን ቀበሜ፣","poem":1},{"text":"አከ ደአኖወንሼ ጉበመኒፊ","poem":2},{"lineBreak":true},{"text":"አከ ሎልቶትንሼ ነአን ህሙዻፍ።”","poem":2}]},{"type":"verse","number":33,"content":["ዋቀዮ ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦",{"text":"“እንተል ባብሎን አኩመ ኦብዲት፤","poem":1},{"text":"ዬሮ ሰነት እሼን ንዽዺተምት፤","poem":2},{"lineBreak":true},{"text":"ዬሮን እሼን እት ሃመምቱስ ደፌ ንዹፈ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“ኔቡከድኔዘር ሞቲን ባብሎን ነ ኛቴረ፤","poem":1},{"text":"እን በርበዴሴረ፤","poem":2},{"lineBreak":true},{"text":"አኩመ ኦኮቴ ዱዋ ነ ጎዼ።","poem":2},{"text":"እን አኩመ ጀዌ ነ ልቅምሴ፤","poem":1},{"text":"ቀቤኘኮ ፍለተማዻንስ ገራ ጉተቴ፤","poem":2},{"lineBreak":true},{"text":"ኤርገሲሞ ነ ቱፌ።”","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ጅራቶትን ጥዮን፣","poem":1},{"text":"“ደብን ፎንኬኘት ሆጄተሜ ባብሎንትሌ ሃዹፉ” ጄዸን።","poem":2},{"text":"ዬሩሳሌምስ፣ “ዺግንኬኘ","poem":1},{"text":"ወረ ባብሎን ኬሰ ጅራተን ሃሎ ሃበኡ” ጄት።","poem":2}]},{"type":"verse","number":36,"content":["ከናፉ ዋቀዮ አከነ ጄዸ፦",{"text":"“ኩኖ፣ አን ዱቢኬ ሲፍ ፈልሜ","poem":1},{"text":"ሃሎ ሲፍን በአ፤","poem":2},{"text":"አን ገላነሼ ነንጎግሰ፤","poem":1},{"text":"ቡርቃሼሌ ነንኩተ።","poem":2}]},{"type":"verse","number":37,"content":[{"text":"ባብሎን ቱላ ዲገሜ፣","poem":1},{"text":"እዶ ዋንጎትን ኬሰ ቡራቀን፣","poem":2},{"text":"ዋን ናሱቲፊ ቆሳ፣","poem":1},{"text":"ለፈ ነምን ቶኮዩረ ህንጅራትኔ ንታት።","poem":2}]},{"type":"verse","number":38,"content":[{"text":"ሰብንሼ ሁንድ አከ ሳፌለ ሌንጫ ንኣደ፤","poem":1},{"text":"እሳንስ አከ እልማን ሌንጫ ጉሩርኡ።","poem":2}]},{"type":"verse","number":39,"content":[{"text":"ዮሙ ዸግንሳኒ ሆኡት፣","poem":1},{"text":"አን አከ እሳን ኮልፋ ገመደኒ","poem":2},{"lineBreak":true},{"text":"በረ በራን ረፈኒ ህንደመቅኔፍ","poem":2},{"text":"ጭዸሳኒፍ ቆጴሴ","poem":1},{"text":"አከ እሳን መቻአን ነንጎዸ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":40,"content":[{"text":"“አን አከ እልሞሌ ሆላ፣","poem":1},{"text":"አኩመ ኮርቤዪ ሆላቲፊ","poem":2},{"lineBreak":true},{"text":"ሬኤ ገረ ቀልማት ገድ እሳን ቡሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"“ሼሻክ አከምት ቦጅአምት!","poem":1},{"text":"ቦኑን ለፈ ሁንዳስ አከምት ቀበሜ!","poem":2},{"text":"ባብሎን ሰበ ግዱት","poem":1},{"text":"አከም ዋን ሶዳ ታት!","poem":2}]},{"type":"verse","number":42,"content":[{"text":"ባብሎንረ ገላን ገረገለ፤","poem":1},{"text":"ደምበሊን ገላናስ እሼ ሀጉገ።","poem":2}]},{"type":"verse","number":43,"content":[{"text":"መጋላወንሼ ኦነኒ","poem":1},{"text":"ብየ ጎጋፊ ገሞጂ፣","poem":2},{"text":"ብየ ነምን ቶኮዩ ኬሰ ህንጅራትኔ፣","poem":1},{"text":"ከን ነምን ኬሰ ህንደበሬ ንተኡ።","poem":2}]},{"type":"verse","number":44,"content":[{"text":"አን ባብሎን ኬሰት ቤልን ነንአደበ፤","poem":1},{"text":"ዋን እን ልቅምሴሌ ነንቱፍሲሰ።","poem":2},{"text":"ሰቦትን ለመተ ገረሳት ህንያአን፤","poem":1},{"text":"ደላን ባብሎንስ ንጅገ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“ያ ሰበኮ፣ እሼ ኬሳ በኣ!","poem":1},{"text":"ሉቡኬሰን ኦልፈቹፍ ፊጋ!","poem":2},{"lineBreak":true},{"text":"ዼከምሰ ዋቀዮ ሶዳችሳ ሰነ ጀላ በቀዻ።","poem":2}]},{"type":"verse","number":46,"content":[{"text":"ዬሮ ኦዱን ብየ ኬሰት ዸገአሙት","poem":1},{"text":"ገራንኬሰን ህንራፈምን ዮካን ህንሶዳትን፤","poem":2},{"text":"አከ ጎሊን ብየ ኬሰ ጅሩ፣","poem":1},{"text":"አከ ቡልቻን ቶኮ ቡልቻ ካንት ከኡ፣","poem":2},{"lineBreak":true},{"text":"ኦዱን ቶኮ በረነ፣ ካንሞ በረ ዹፉ ዸገአመ።","poem":2}]},{"type":"verse","number":47,"content":[{"text":"ዬሮን አን እት ዋቆተ ባብሎን ቶልፈሞ አደቡ","poem":1},{"text":"ዹጉማን ንዹፋቲ፤","poem":2},{"text":"ብይሼ ጉቱማን ጉቱት ንሰልጰት፤","poem":1},{"text":"ቀለምቶትንሼ ሁንድስ እሼ ኬሰት ኩኩፉ።","poem":2}]},{"type":"verse","number":48,"content":[{"text":"ኤርገሲ ሰሚፊ ለፍት፣ ወን እሳን ኬሰ ጅሩ ሁንድስ፣","poem":1},{"text":"ገመደኒ ባብሎንት እልልቹ፤","poem":2},{"text":"በርበዴስቶትን ካባ በአኒ","poem":1},{"text":"እሼ ወራኑቲ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"“አኩመ ቀለምቶትን ለፈራ ሁንድ","poem":1},{"text":"ሰበቢ ባብሎኒፍ ሀርጨአን ሰነ","poem":2},{"lineBreak":true},{"text":"ባብሎንስ ሰበቢ ቀለምቶተ እስራኤሊፍ ሀርጨኡ ቀብድ።","poem":2}]},{"type":"verse","number":50,"content":[{"text":"እስን ወር ጎራዴ ጀላ ምልቅጠን፣","poem":1},{"text":"ዴማ፤ ለፈረ ህንሀርክፈትና!","poem":2},{"text":"ብየ ፈጎትሌ ዋቀዮን ያደዻ፤","poem":1},{"text":"ዋኤ ዬሩሳሌምስ ያዳ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"“ሰበቢ ኦርሞትን እዶ ቁልቁላኣ","poem":1},{"text":"መነ ዋቀዮት ቀለኒፍ፣","poem":2},{"lineBreak":true},{"text":"ኑ ሰልጵፈምኔረ፤","poem":2},{"text":"ዋን አረብሰምኔፍስ","poem":1},{"text":"ቃኒዻን ፉለኬኘ ሀጉገትኔ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"“ገሩ በር አን እት፣","poem":1},{"text":"ዋቆተሼ ቶልፈሞ አደቡፊ","poem":2},{"text":"ዬሮን ጉቱማ ለፈሼረት","poem":1},{"text":"ወር መዳአን ኣደን ዹፋ ጅረ” ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":53,"content":[{"text":"“ዮ ባብሎን ሰሚት ኦል ባቴ","poem":1},{"text":"ደአትኖሼ ኦል ዼራ ጀቤፈቴዩ፣","poem":2},{"lineBreak":true},{"text":"አን ወረ እሼ በርበዴሰን እት ነንኤርገ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":54,"content":[{"text":"“ባብሎኒ እይ፣","poem":1},{"text":"ለፈ ባብሎኖታቲሞ","poem":2},{"lineBreak":true},{"text":"ሰገሌን በዲሰ ጉዳ ንዸገአመ።","poem":2}]},{"type":"verse","number":55,"content":[{"text":"ዋቀዮስ ባብሎንን ንበርበዴሰ፤","poem":1},{"text":"እን ወጨሼ ንጨልእሲሰ፣","poem":2},{"text":"ደምበሊንሳኒስ አኩመ ብሻን ጉዳ ንሁርሰ፤","poem":1},{"text":"ሰገሌን ሁርሳሳኒስ ንዸገአመ።","poem":2}]},{"type":"verse","number":56,"content":[{"text":"በርበዴሳን ቶኮ ባብሎንት ንዹፈ፤","poem":1},{"text":"ጎቶትንሼ ንቀበሙ፤","poem":2},{"lineBreak":true},{"text":"ፉታፍቱንሳኒስ ንጨጨበ፤","poem":2},{"text":"ዋቀዮ፣ ዋቀ ሃሎ በኡዻቲ፤","poem":1},{"text":"እን ጉቱማን ጉቱት ገቲሼ ንዴብሳፍ።","poem":2}]},{"type":"verse","number":57,"content":[{"text":"አን ቆንዳልቶታፊ ኦጌዪሼ፣","poem":1},{"text":"አከሱመስ ቡልችቶተ፣ አጀጆተ ወራናቲፊጎቶተሼ ነንመቼሰ፤","poem":2},{"text":"እሳንስ በረ በራን ንረፉ፤ ህንደመቀንስ፣”","poem":1},{"text":"ጄዸ ሞትች መቃንሳ ዋቀዮ ዋን ሁንደ ደንደኡ፣ጄዸሙ ሱን።","poem":2}]},{"type":"verse","number":58,"content":["ዋቀዮ ዋን ሁንደ ደንደኡ አከነ ጄዸ፤",{"text":"“ደላን ባብሎን የቡን ሱን ንጅገ፤","poem":1},{"text":"ከረወንሼ ዼዼሮን እብዳን ጉበሙ፤","poem":2},{"text":"ነሞትን አከሱማን ኦፍ ደዸብሲሱ፤","poem":1},{"text":"ደዸቢን ሰቦታ ቆራን እብዳ ቆፈ ተአ።”","poem":2}]},{"type":"verse","number":59,"content":["ዬሮ ሴራያን እልም ኔርያ፣ እልም መህሴያ በረ ዜዴቅያ ሞትቸ ይሁዳ ኬሰ ወጋ አፉረፋት ሞትቸ ወጅን ገረ ባብሎን ዴሜት አጀጅን ኤርምያስ ራጅች እሳፍ ኬኔ ከናዸ።"]},{"type":"verse","number":60,"content":["ኤርምያስ በዲሰ ባብሎንት ዹፉ ሁንደ፣ ጄቹንስ ዋኤ ባብሎን ከን በሬፈሜ ሁንደ ክታበ መረማረት በሬሴ ቱሬ።"]},{"type":"verse","number":61,"content":["እንስ ሴራያዻን አከነ ጄዼ፤ “ዮሙ ባብሎን ጌሱት ዱቢ ከነ ሁንደ ሰገሌ ኦል ፉዸቴ ዱብሱ ህንደገትን።"]},{"type":"verse","number":62,"content":["አከነስ ጄዽ፦ ‘ያ ዋቀዮ፣ አከ ነምን ዮካን ሆሪንሼ ኬሰ ህንጅራኔፍ አት አከ እዶ ከነ በርበዴስቱ ዱበቴርተ፤ እሼንስ በረ በራን ንኦንት።’"]},{"type":"verse","number":63,"content":["ዬሮ ክታበ መረማ ከነ ዱብፍቴ ፍጡት ዸጋ እት ህዺቲ ለገ ኤፍራጢስት ደርበዹ።"]},{"type":"verse","number":64,"content":["አከነስ ጄዽ፤ ‘ሰበቢ በዲሰ አን እሼት ፍዱቲን አከ ለመተ ህንካኔፍ ባብሎን አከስት ንልቅምፈምት። ኡመትንሼስ ንሀርጨአ።’ ”",{"lineBreak":true},{"lineBreak":true},"ዱቢን ኤርምያስ አስረት ራወተመ።"]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":64}