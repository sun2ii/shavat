{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_ebi","name":"ኤርምያስ","commonName":"ኤርምያስ","title":"ራጂ ኤርምያስ","order":24,"numberOfChapters":52,"sha256":"e08276404fb1cf1f464d515eb4d9024ff6266c1a4a4283b37b28fd31b4fd4e55","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_ebi/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":6,"content":[{"type":"heading","content":["ዬሩሳሌም መርፈምቴ"]},{"type":"verse","number":1,"content":[{"text":"“ያ ሰበ ቤንያም በቀዻ በኣ!","poem":1},{"text":"ዬሩሳሌም ኬሳ በቀዻ!","poem":2},{"text":"ቴቆኣ ኬሰት መለከተ አፉፋ!","poem":1},{"text":"ቤት ሀኬሬምረት መለቶ ኦል ቀባ!","poem":2},{"text":"ከራ ካባቲን በላን፣","poem":1},{"text":"በዲስን ሱከኔሳን ንዹፋቲ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አን እንተለ ጥዮን እሼ በሬዱፊ","poem":1},{"text":"ቀነኒቱ ሰነ ነንገላፈዸ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ትክሶትን ቡሻዬሳኒ ፉዸተኒ እሼት ዹፉ፤","poem":1},{"text":"ዱንካነሳኒስ እሼት ናኔሰኒ ዻበቱ።","poem":2},{"lineBreak":true},{"text":"ቶኮን ቶኮንሳኒስ እዶሳኒት ቦባፈቱ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“እሼት ወራነ ካሱፍ ቆጳኣ!","poem":1},{"text":"ከኣ፣ ጉያ ሳፋዻን እሼ ወራና!","poem":2},{"text":"ወዮ፣ አዱን ዽኣ ጅርት፤","poem":1},{"text":"ጋድስን ገልገላስ ዼረቴረ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ከናፉ ከኣ፣ ሀልከኒን እሼ ዾፍኔ","poem":1},{"text":"ደአኖወንሼ በርበዴስና!”","poem":2}]},{"type":"verse","number":6,"content":["ዋቀዮ ዋን ሁንደ ደንደኡ አከነ ጄዸ፤",{"text":"“ሙኬንሼ ጭራ፤","poem":1},{"text":"ናኖ ዬሩሳሌምት ቱላ ብዮ ቶልቻ፤","poem":2},{"text":"መጋላን ኩን አደበሙ ቀብድ፤","poem":1},{"text":"እሼን ጩንቁርሳዻን ጉተምቴርቲ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አኩመ ቦል ብሻኒ ብሻን ያሱ ሰነ፣","poem":1},{"text":"እሼንስ ሀምነሼ ገድ ያፍት፤","poem":2},{"text":"ጄቁምሲፊ በዲስንሼ ኬሰት ንዸገአመ።","poem":1},{"text":"ዹኩብኒፊ መዳንሼ ዬሮ ሁንደ ፉለኮ ዱረ ጅረን።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ያ ዬሩሳሌም ጎርሰኮ ዸገእ፤","poem":1},{"text":"ዮ ከና አቺ አን ስራ ገረገሌ፣","poem":2},{"text":"አከ ነምን ቶኮዩ ኬሰ ጅራቹ","poem":1},{"text":"ህንደንዴኜፍ፣ ብየኬ ነንኦንሰ።”","poem":2}]},{"type":"verse","number":9,"content":["ዋቀዮ ዋን ሁንደ ደንደኡ አከነ ጄዸ፦",{"text":"“አኩመ ወይኒን ስሪት ፉናነሙ ሰነ፣","poem":1},{"text":"እሳንስ ሀምባ እስራኤል ሃፉናነን፤","poem":2},{"text":"አኩመ ነመ እጀ ወይኒ ጭሩ ቶኮት፤","poem":1},{"text":"አመስ ሀርከኬ ገረ ደሜወኒት ሂጠዹ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"አን ኤኙን ዱበዼ አኬከቺሱ ደንደአ?","poem":1},{"text":"ኤኙቱ ነ ዸጌፈተ?","poem":2},{"text":"ኩኖ፣ ጉርሳኒ ዸግነ ህንቀበትኔ፤","poem":1},{"text":"ዸገኡስ ህንደንደአን።","poem":2},{"text":"ዱቢን ዋቀዮ እሳንት ህንቶሉ፤","poem":1},{"text":"እትስ ህንገመደን።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አን ገሩ ዼከምሰ ዋቀዮቲን ጉተሜረ፤","poem":1},{"text":"ኦብሱስ ህንደንደኡ።","poem":2},{"lineBreak":true},{"text":"“እጆሌ ዳንዲረ ጅረንረት፣","poem":1},{"text":"ደርገጎተ ወልት ቀበመንረት፣","poem":2},{"text":"ዽርሳፊ ኒቲረት፣","poem":1},{"text":"ወረ ዱሎመንትስ ዼከምሰ ነንዸንገላሰ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዬሮ አን ሀርከኮ","poem":1},{"text":"ወረ ብየቲ ኬሰ ጅራተንት ኦል ፉዸዹት","poem":2},{"text":"መኔንሳኒ፣ ለፈ ቆቲሳሳኒቲፊ","poem":1},{"text":"ኒቶተሳኒ ወጅን ነሞተ ካኒፍ ኬነሙ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“ጥናዻ ሀመ ጉዳት","poem":1},{"text":"ሁንድሳኒዩ ቡኣ አርገቹፍ ገገቡ፤","poem":2},{"text":"ራጆትኒፊ ሉቦትንስ አከሱመ","poem":1},{"text":"ሁንድሳኒ ነመ ጎዎምሱ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እሳን መዳ ሰበኮቲ","poem":1},{"text":"አኩመ ዋን ጥና ቶኮት እላለኒ ወልኣኑ።","poem":2},{"text":"ኡቱ ነጋን ህንጅራትንስ","poem":1},{"text":"‘ነጋ፣ ነጋ’ ጄዹ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እሳን አመለሳኒ ጅብሲሳ ሰነት ንቃነኡ?","poem":1},{"text":"ለኪ፣ እሳን ቃኒ ቶኮዩ ህንቀበን፤","poem":2},{"lineBreak":true},{"text":"ቃነኡን ማል አከ ተኤዩ ህንቤከን።","poem":2},{"text":"ከናፉ እሳን ወረ ኩፈን ወጅን ንኩፉ፤","poem":1},{"text":"ዬሮ አን እሳን አደቡት ገድ ገተሙ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":16,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“ከራ ቀጣሙራረ ዻበዻቲ እላላ፤","poem":1},{"text":"ዳንዲ ዱሪ እያፈዻ፤","poem":2},{"text":"ከራን ጋሪን ገረም አከ ጅሩ ጋፈዻቲረ ዴማ፤","poem":1},{"text":"ሉቡኬሰኒፍ ቦቆና ንአርገቱቲ።","poem":2},{"lineBreak":true},{"text":"እስን ገሩ፣ ‘ኑ እሰረ ህንዴምኑ’ ጄተን።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አን ኤግዶተ እስንት ረመዴን","poem":1},{"text":"‘ሰገሌ መለከታ ዸጌፈዻ!’ ጄዼ፣","poem":2},{"lineBreak":true},{"text":"እስን ገሩ፣ ‘ህንዸጌፈትኑ’ ጄተን።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ከናፉ ያ ሰቦተ ዸገኣ፤","poem":1},{"text":"ያ ወልዳ፣","poem":2},{"lineBreak":true},{"text":"ዋን እሳንት ዹፉፍ ጅሩ ሁበዻ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ያ ለፋ ዸገእ፦","poem":1},{"text":"አን ዋን እሳን ዱቢኮ ዸገኡ ድደኒ","poem":2},{"lineBreak":true},{"text":"ሴረኮስ ቱፈተኒፍ፣","poem":2},{"text":"ሰበ ከነት በዲሰ ነንፍደ፤","poem":1},{"text":"ኩንስ እጀ ደበሳኒት።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እጣን ብየ ሼባቲ ዹፉ፣","poem":1},{"text":"ዮካን ቀዪ ብየ ፈጎቲ ዹፉ ማል ነ ፈየደ?","poem":2},{"text":"ኣርሳንኬሰን ከን ጉበሙ ፉዸተመ ህንቀቡ፤","poem":1},{"text":"ቀልምኬሰንስ ህንቶሉ።”","poem":2}]},{"type":"verse","number":21,"content":["ከናፉ ዋቀዮ አከነ ጄዸ፦",{"text":"“አን ፉለ ሰበ ከና ዱረ ጉፉ ነንካአ።","poem":1},{"text":"አቦቲኒፊ እጆሌን ወሊ ወጅን እት ጉፈቱ፤","poem":2},{"lineBreak":true},{"text":"ኦሎትኒፊ ምቾትን ንበርበዳኡ።”","poem":2}]},{"type":"verse","number":22,"content":["ዋቀዮ አከነ ጄዸ፤",{"text":"“ኩኖ፣ ገሬን ሎልቶታ ቶኮ","poem":1},{"text":"ብየ ካባቲ ዹፋ ጅረ፤","poem":2},{"text":"ሰብን ጉዳን ቶኮስ","poem":1},{"text":"አንዳረ ለፋቲ ሶሶቾኣ ጅረ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"እሳን ጥያፊ ኤቦ ቀበተኒሩ፤","poem":1},{"text":"እሳን ገረ ጀቤዪ፣ ነማፍስ ናሱ ህንቀብኔዸ።","poem":2},{"text":"ዮሙ እሳን ፈርዴንሳኒ ጉሉፈንት","poem":1},{"text":"ግግግሱንሳኒ አኩመ ሁርሳ ገላናት፤","poem":2},{"text":"ያ እንተለ ጥዮን፣ እሳን አኩመ ነሞተ","poem":1},{"text":"ዱላፍ ህሪረኒት ስ ሎሉፍ ዹፉ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ኑ ኦዱ ዋኤሳኒ ዸጌኜረ፤","poem":1},{"text":"ሀርክኬኘስ ንላፌ።","poem":2},{"text":"ዽጵን ኑ ቀበቴረ፤","poem":1},{"text":"ሚጡንስ አኩመ ዱበርቲ ጭኒንስፈቱ ኑ ቀቤ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ሰበቢ ዲን ጎራዴ ቀበቴፊ","poem":1},{"text":"ሰበቢ እዶ ሁንደ ጎሊን ጅሩፍ","poem":2},{"text":"እስን ዲደት ገድ ህንበእና፤","poem":1},{"text":"ዮካን ከራረ ህንዴምና።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ያ ሰበኮ፣ ኡፈተ ገዳ ኡፈዻቲ","poem":1},{"text":"ዳራ ኬሰ ገንገለዻ፤","poem":2},{"text":"አከ ነመ እልመሳ ቶክቸ ዸቤት","poem":1},{"text":"ህቅፈዻ ቦኣ፤","poem":2},{"text":"እን ነመ በሌሱ ሱን","poem":1},{"text":"አኩመ ተሳ ኑት ዹፋቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“አከ አት ከራሳኒ ቆርቴ ቤክቱፍ","poem":1},{"text":"አን ሰበኮ ግዱት ቆረታ ስ ጎዼረ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ሁንድሳኒ ፍንጭልቶተ መተ ጀቤዪ","poem":1},{"text":"መቃ ነማ በሌሱፍ አሲፊ አች ጆረኒዸ።","poem":2},{"text":"እሳን ናሲፊ ስቢለ፤","poem":1},{"text":"እሳን ሁንድኑ መላ መልቱማ ሆጄቱ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ቡፋን ድላሊ እብዳን ጉቤ በሌሱፍ","poem":1},{"text":"ሁምነ ጉዳን ቡፈ፤","poem":2},{"text":"ሆጂን እብዳን ቁልቁሌሱ ኩን ፋይዳ መሌ ሆጄተመ፤","poem":1},{"text":"ነሞትን ሀሞን ህንበሌፈምኔቲ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ሰበቢ ዋቀዮ እሳን ገቴፍ","poem":1},{"text":"እሳን ሜቲ ገተማ ጄዸሙ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}