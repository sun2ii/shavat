{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_ebi","name":"ኤርምያስ","commonName":"ኤርምያስ","title":"ራጂ ኤርምያስ","order":24,"numberOfChapters":52,"sha256":"e08276404fb1cf1f464d515eb4d9024ff6266c1a4a4283b37b28fd31b4fd4e55","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_ebi/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["“ ‘በረ ሰነ ለፌን ሞቶታቲፊ ቆንዳልቶተ ይሁዳ፣ ለፌን ሉቦታቲፊ ራጆታ፣ ለፌን ነሞተ ዬሩሳሌም አዋለሳኒ ኬሳ ንባፈመ’ ጄዸ ዋቀዮ።"]},{"type":"verse","number":2,"content":["‘እሳን ፉለ አዱፊ ጅኣ ዱረት፣ ፉለ ጉቱማ ኡርጂወን ሰሚ ሁንዳ፣ ከኔን ጃለተኒፊ ተጃጅለኒ፣ ከኔን ፋነ ቡአኒ ጎርሰ ጋፈተኒፊ ዋቄፈተን ሰና ዱረት ንሳጥለሙ። እሳን አኩመ ኮሲ ለፈት ገተሜ ተአን መሌ ወልት ህንቀበመን ዮካን ህንአዋለመን።"]},{"type":"verse","number":3,"content":["ሀምባን ሰበ ሀማ ከና ሁንድ ለፈ አን እት እሳን አርኡ ሁንደት ጅሬኘረ ዱአ ፍለተ’ ጄዸ ዋቀዮ ዋን ሁንደ ደንደኡ።"]},{"type":"heading","content":["ጩቡፊ አደቢ"]},{"type":"verse","number":4,"content":["“አት አከነ እሳኒን ጄዽ፤ ‘ዋቀዮ አከነ ጄዸ፦",{"text":"“ ‘ነሞትን ዮ ኩፈን ህንከአኒ?","poem":1},{"text":"ነምን ቶኮ ዮ ከራራ በዴ ህንዴብኡ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዮስ ሰብን ኩን ማሊፍ ከራራ ጀልአተ?","poem":1},{"text":"ዬሩሳሌም ማሊፍ ዬሮ ሁንደ ከራራ ጀልአት?","poem":2},{"text":"እሳን ጎዎምሳት ጭቹ፤","poem":1},{"text":"ዴብኡስ ንድዱ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አን ቀልቤፈዼ ዸጌፈዼረ፤","poem":1},{"text":"እሳን ገሩ ዋን ቀጄላ ህንዱበተን።","poem":2},{"text":"ነምን ቶኮዩ፣ “አን ማለን በሌሴ?” ጄዼ","poem":1},{"text":"ሀምነሳራ ህንዴብኡ።","poem":2},{"text":"ቶኮን ቶኮንሳኒ አኩመ ፈርደ ሎለት ጉሉፉ","poem":1},{"text":"ከራ ኦፊሳኒረ ቀጄሉ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሁሞን ሰሚ ኬሳዩ","poem":1},{"text":"ወቅቲ እሼፍ ሙርታኤ ንቤክት፤","poem":2},{"text":"ጉጌን፣ ዳሎቴፊ ጩቁሊስንስ","poem":1},{"text":"ዬሮ ጎዳንሰሳኒ ንኤጉ።","poem":2},{"text":"ሰብንኮ ገሩ","poem":1},{"text":"ሴረ ዋቀዮ ህንቤኩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ ‘እስን አከምት፣ “ኑ ሴረ ዋቀዮ","poem":1},{"text":"ዋን ቀብኑፍ ኦጌዪዸ” ጄቹ ደንዴሱ?","poem":2},{"text":"ገሩ ኩኖ፣ ቀለምን ሶባ","poem":1},{"text":"ከን በሬስቶታ ሶቤ በሬሴረ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ነሞትን ኦጌዪን ንቃኔፈሙ፤","poem":1},{"text":"እሳን ነአኒ ክዮዻን ንቀበሙ፤","poem":2},{"text":"እሳን ኤርገ ዱቢ ዋቀዮ ቱፈተኒ፣","poem":1},{"text":"ኦጉማ አከሚ ቀቡሬ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ከናፉ አን ኒቶተሳኒ ነሞተ ብራቲፍ፣","poem":1},{"text":"ለፈ ቆቲሳሳኒሞ ሞአቶታፍ ነንኬነ።","poem":2},{"text":"ጥናዻ ሀመ ጉዳት","poem":1},{"text":"ሁንድሳኒዩ ቡኣ አርገቹፍ ገገቡ፤","poem":2},{"text":"ራጆትኒፊ ሉቦትንስ አከሱመ","poem":1},{"text":"ሁንድሳኒ ነመ ጎዎምሱ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እሳን መዳ ሰበኮቲ፣","poem":1},{"text":"አኩመ ዋን ጥና ቶኮት እላለኒ ወልኣኑ።","poem":2},{"text":"ኡቱ ነጋን ህንጅራትንስ","poem":1},{"text":"“ነጋ፣ ነጋ” ጄዹ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እሳን አመለሳኒ ጅብሲሳ ሰነት ንቃነኡ?","poem":1},{"text":"ለኪ፣ እሳን ቃኒ ቶኮዩ ህንቀበን፤","poem":2},{"lineBreak":true},{"text":"ቃነኡን ማል አከ ተኤዩ ህንቤከን።","poem":2},{"text":"ከናፉ እሳን ወረ ኩፈን ወጅን ንኩፉ፤","poem":1},{"text":"ዬሮ አደበመንት ገድ ገተሙ","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ ‘አን ጉቱማን ጉቱት እሳን ነንበሌሰ፤","poem":1},{"text":"ጄዸ ዋቀዮ።","poem":2},{"lineBreak":true},{"text":"ወይኒረት እጅ ህንአርገሙ።","poem":2},{"text":"እጅ ሀርቡ ሙከ ሀርቡረት ህንአርገሙ።","poem":1},{"text":"ባልሳኒስ ንጮለገ።","poem":2},{"text":"ወን አን እሳኒፍ ኬኔ","poem":1},{"text":"እሳንራ ንፉዸተመ።’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ኑ ማሊፍ አስ ቴኘ?","poem":1},{"text":"ወልት ቀበማ!","poem":2},{"text":"ኮታ ገረ መጋላወን","poem":1},{"text":"ደላ ጀባ ቀበኒት በቀትኔ አችት ሃዹምኑ!","poem":2},{"text":"ዋን ኑ ጩቡ እሰት ሆጄትኔፍ","poem":1},{"text":"ዋቀዮ ዋቅንኬኘ በዲሰትደበርሴ ኑ ኬኔራቲ፤","poem":2},{"lineBreak":true},{"text":"አከ ዹግኑፍስ ብሻን ሱማኣ ኑ ኬኔረ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኑ ነጋ አብደትኔ፤","poem":1},{"text":"ገሩ ወን ጋሪን ቶኮዩ ህንዹፍኔ፤","poem":2},{"text":"ኑ ዬሮ ፈይና አብደትኔ፤","poem":1},{"text":"ገሩ ጎሊ ቆፈቱ ቱሬ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዳን ኬሳ ኮርሱ ፈርዴን ዲናቱ ዸገአመ፤","poem":1},{"text":"ጉቱን ብየቲ ህምምሱ ኮሮሚ ፈርዴንሳኒቲን ሆለት።","poem":2},{"text":"እሳን ብየቲፊ ዋን እሼ ኬሰ ጅሩ ሁንደ፣","poem":1},{"text":"መጋላፊ ወረ እሼ ኬሰ ጅራተን ሁንደ፣","poem":2},{"lineBreak":true},{"text":"በሌሱፍ ዹፈኒሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“አን ኩኖ ቦፈ ሀዻ ቀቡ፣","poem":1},{"text":"ቡቲ ፈልፈል ደዌሱ ህንደንዴኜ እስንት ነንኤርገ፤","poem":2},{"lineBreak":true},{"text":"እሳንስ እስን እዱ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ያ እሰ ገደ ኬሰት ነ ጀጀቤስቱ፣","poem":1},{"text":"ኦኔንኮ ነ ኬሰት ገገብዴርት።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ኩኖ፣ እይ ሰበኮቲ","poem":1},{"text":"ብየ ፈጎዻ ንዸገአመ፦","poem":2},{"text":"“ዋቀዮ ጥዮን ኬሰ ህንጅሩ?","poem":1},{"text":"ሞቲንሼ አች ህንጅሩ?”","poem":2},{"lineBreak":true},{"text":"“እሳን ማሊፍ ፈኪወንሳኒቲን፣","poem":1},{"text":"ዋቆተሳኒ ቶልፈሞ ብየ ኦርማቲንዼከምሳፍ ነ ከካሱ?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ዬሮን እት ምዻን ገልፈሙ ደርቤረ፤","poem":1},{"text":"ቦንስ ሆበኤረ፤","poem":2},{"lineBreak":true},{"text":"ኑ ገሩ ህንፈይኔ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ሰብንኮ ዋን ሚዸሜፍ አንስ ሚዸሜረ፤","poem":1},{"text":"አን ነንቦኤ፤ ሶዳን ጉዳንስ ነ ቀበቴ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ቆርች ድበተን ግልኣድ ኬሰ ህንጅሩ?","poem":1},{"text":"አባን ቆርቻ ቶኮዩ አች ህንጅሩ?","poem":2},{"text":"ዮስ መዳን እንተለ ሰበኮቲ","poem":1},{"text":"ማሊፍ ህንፈዩሬ?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JER/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JER/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JER/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}