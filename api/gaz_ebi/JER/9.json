{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JER","translationId":"gaz_ebi","name":"ኤርምያስ","commonName":"ኤርምያስ","title":"ራጂ ኤርምያስ","order":24,"numberOfChapters":52,"sha256":"e08276404fb1cf1f464d515eb4d9024ff6266c1a4a4283b37b28fd31b4fd4e55","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gaz_ebi/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"አከ አን ሀልከኒ ጉያ፣","poem":1},{"text":"ሰበኮ ዹሜ ሰናፍ ቦኡፍ፣","poem":2},{"text":"ማሎ ኡቱ መታንኮ መደ ብሻኒ","poem":1},{"text":"እጅኮሞ ቡርቃ እምማኒ ተኤ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አን አከን ሰበኮ ዺሴ","poem":1},{"text":"ብራ ፈጋዹፍ፣","poem":2},{"text":"ማሎ ኡቱን ገሞጂ ኬሳ","poem":1},{"text":"ለፈ ቡልቲ ከረ ዴምቶታ ቀባዼ!","poem":2},{"text":"ሁንድሳኒ ሰጋገልቶተ፣","poem":1},{"text":"ቱተ ሰበ ህንአመነምኔ ቶኮት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“እሳን ሶበ ደርበቹፍ","poem":1},{"text":"አረበሳኒ አከ ጥያት ቆጴፈቱ፤","poem":2},{"text":"እሳን ብየቲ ኬሰት","poem":1},{"text":"ዹጋዻን ህንሞአትኔ።","poem":2},{"text":"እሳን ጩቡረት ጩቡ ደበሉ፤","poem":1},{"text":"አናንስ ህንቤከን”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“ምቾተኬሰንራ ኦፍ ኤጋ፤","poem":1},{"text":"ኦቦሌሰ ህንአመንና።","poem":2},{"text":"ኦቦሌስ ሁንድ ጎዎምስቱዸ፣","poem":1},{"text":"ምቹን ሁንድስ መቀ በሌስቱዻቲ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ምቹን ምቹ ጎዎምሰ፤","poem":1},{"text":"ነምን ቶኮዩ ዹጋ ህንዱበቱ።","poem":2},{"text":"እሳን አረበሳኒ ሶበ በርሲፈተኒሩ፤","poem":1},{"text":"ጩቡ ሆጄቹዻንስ ኦፍ ደዸብሲሰኒሩ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አት ግዱ ጎዎምስቶታ ጅራተ፤","poem":1},{"text":"እሳን ጎዎምሳሳኒ ኬሰት ነ ቤኩ ድደን”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":7,"content":["ከናፉ ዋቀዮ ዋን ሁንደ ደንደኡ አከነ ጄዸ፦",{"text":"“ኩኖ፣ አን ሰበቢ ጩቡ ሰበኮቲፍ በቅሴን እሳን ቆረ፤","poem":1},{"text":"አን ሰበቢ እንተለ ሰበኮቲቲፍ ማል ጎቹን ደንደአ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አረብንሳኒ ጥየ ነመ ገላፈቱዸ፤","poem":1},{"text":"እን ጎዎምሳ ዱበተ።","poem":2},{"text":"ቶኮን ቶኮን ነማ ኦላሳት አፋንሳቲን ነጋ ዱበተ፤","poem":1},{"text":"ገራሳ ኬሰ ገሩ ክዮ ካኣፍ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አን ዋን ከናፍ እሳን ህንአደቡሬ?”","poem":1},{"text":"ጄዸ ዋቀዮ።","poem":2},{"text":"“አን መታንኮ ሰበ አከ ሰበ ከና፣","poem":1},{"text":"ሃሎ ህንበኡሬ?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"አን ቱሉወኒፍ ገዶዴ ነንቦአ፤","poem":1},{"text":"ለፈ ዼዳ ገሞጂቲፍስ ፋርሴ ነንቦአ።","poem":2},{"text":"ሰበቢ እሳን ኦነኒ ሀፈኒፍ ነምን ቶኮዩ አቺን ህንደርቡ፤","poem":1},{"text":"መርአቹን ሎኒስ ህንዸገአሙ።","poem":2},{"text":"ስምብሮትን ሰሚ አቺ በቀተኒሩ፤","poem":1},{"text":"ብኔንሶትንስ ጎዳነኒሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“አን ዬሩሳሌምን ቱላ ዋን ዲገሜቲፊ","poem":1},{"text":"ቦለ ዋንጎ ነንጎዸ፤","poem":2},{"text":"አከ ነምን ቶኮዩ አች ጅራቹ ህንደንዴኜፍ","poem":1},{"text":"መጋላወን ይሁዳ ነንኦንሰ።”","poem":2}]},{"type":"verse","number":12,"content":["ኦጌስ ዋን ከነ ሁበቹ ደንደኡ ኤኙ? ነምን ዋቀዮን ቀጄልፈሜ ዋን ከነ እብሱ ደንደኡ ኤኙ? ብየቲን ማሊፍ አኩመ ገሞጂ ነምን ቶኮዩ ኬሰ ደርቡ ህንደንዴኜ ቶኮት ዲገምቴ ኦንቴ?"]},{"type":"verse","number":13,"content":["ዋቀዮ አከነ ጄዼ፤ “ኩን ሰበቢ እሳን ሴረኮ ከን አን ፉለሳኒ ዱረ ካኤ ሰነ ዺሰኒፊዸ፤ እሳን አናፍ ህንአጀጀምኔ ዮካን ሴረኮ ዱካ ህንቡኔ።"]},{"type":"verse","number":14,"content":["ቆደ ከና መተ ጀብናን ፌዺ ገራሳኒ ዱካ ቡአን፤ አኩመ አቦቲንሳኒ እሳን በርሲሰንትስ በኣል ዱካ ቡአን።”"]},{"type":"verse","number":15,"content":["ከናፉ ዋቀዮ ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦ “ኩኖ፣ አን አከ ሰብን ኩን ኛተ ሀዻኣ ኛቱፊ አከ እን ብሻን ሱማኣ ዹጉ ነንጎዸ።"]},{"type":"verse","number":16,"content":["አን ሰቦተ እሳን ዮካን አቦቲንሳኒ ህንቤክን ኬሰ እሳን ነንብትኔሰ፤ አን ሀመን ለፈራ እሳን በርበዴሱትስ ጎራዴዻን እሳን ነንአርአ።”"]},{"type":"verse","number":17,"content":["ዋቀዮ ዋን ሁንደ ደንደኡ አከነ ጄዸ፦",{"text":"“ሜ ቀልቤፈዻ!","poem":1},{"text":"አከ ዱበርቶትን ነመ ቦስሰን ዹፈኒፍ ዋማ፤","poem":2},{"lineBreak":true},{"text":"እሳን ኬሳ ወረ ኦጉማዻን ጫለንትነመ ኤርጋ ዋምስሳ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እሳን ደፈኒ ዹፈኒ","poem":1},{"text":"ሀመ እጅኬኘ እምማን ያሴ","poem":2},{"text":"ብሻንስ ባሌ እጀኬኛ ኬሳ ቡርቁት","poem":1},{"text":"እየኒ ኑፍ ሃቦአን።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሰገሌን ቦእቻ ከን፣","poem":1},{"text":"‘ኑ ሀመም በድኔረ!","poem":2},{"lineBreak":true},{"text":"ቃኒንኬኘስ ሀመም ጉዳዸ!","poem":2},{"text":"ሰበቢ መኔንኬኘ ዲገመኒፍ","poem":1},{"text":"ኑ ብየኬኘ ኬሳ በኡ ቀብነ’ ጄዹ ቶኮጥዮን ኬሳ ንዸገአመ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ያ ዱበርቶተ፣ ኤጋ ዱቢ ዋቀዮ ዸገኣ፤","poem":1},{"text":"ዱቢ አፋንሳቲ በኡፍ ጉረኬሰን በነዻ።","poem":2},{"text":"አከ እት ቦአን እንተለንኬሰን በርሲሳ፤","poem":1},{"text":"ፋሩስ ወል በርሲሳ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዱት ፎዳኬኛን ኦል ልጤረ፤","poem":1},{"text":"ደአኖወንኬኘስ ሴኔረ፤","poem":2},{"text":"እንስ ዳንዲወንራ እጆሌ","poem":1},{"text":"ኦብዲወን ሰባራ ደርገጎተ በሌሴረ።","poem":2}]},{"type":"verse","number":22,"content":["አት አከነ ጄዽ፦ “ዋቀዮ አከነ ጄዸ፦",{"text":"“ ‘ሬፍ ነሞታ","poem":1},{"text":"አኩመ ኮሲ ዲደት ገተሜ፣","poem":2},{"text":"አኩመ ብሲ ምዻኒ ከን ነመ ሃሙ ዱባን ሀፌ","poem":1},{"text":"ነመ ወልት ቀቡ ዸቤት ጭጪሰ።’ ”","poem":2}]},{"type":"verse","number":23,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“ኦጌስ፣ ኦጉማሳቲን ህንቦንን፤","poem":1},{"text":"ዮካን ነምን ጀባን፣ ጀብነሳቲን ህንቦንን","poem":2},{"lineBreak":true},{"text":"ዮካን ሶሬስ፣ ሶሮመሳቲን ህንቦንን፤","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ነምን ቦኑ ገሩ፣","poem":1},{"text":"አከ አን ዋቀዮ ገራ ነማፍ ላፉ፣","poem":2},{"text":"ከን ለፈረት ሙርቲ ቀጄላፊ ቀጄሉማ ሆጄቱ ተኤ","poem":1},{"text":"ሁበቴ ነ ቤኩሳቲን ሃቦኑ፤","poem":2},{"lineBreak":true},{"text":"አን ዋን ከነት ነንገመዳቲ፣”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":25,"content":["ዋቀዮ አከነ ጄዸ፤ “በር አን እት ወረ ፎንሳኒ ቆፋን ዸግነ ቀበመን ሁንደ አደቡ ንዹፈ፤ እሳንስ፦"]},{"type":"verse","number":26,"content":["ግብጥ፣ ይሁዳ፣ ኤዶም፣ አሞን፣ ሞኣቢፊ ወረ ገሞጂ ኬሰ እዶ ፈጎ ጅራተን ሁንደ። ሰቦትን ኩኔን ሁንድ ዹጉማን ዸግነ ህንቀበምኔ፤ ገራን መነ እስራኤል ሁንዳዩ ዸግነ ህንቀበምኔ።”"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JER/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JER/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JER/8.json","previousChapterAudioLinks":{},"numberOfVerses":26}