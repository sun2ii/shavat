{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"“አን ጅሬኘኮ አከ መሌ ጅቤረ፤","poem":1},{"text":"ከናፉ ጫልችሴ ነንጉንጉመ፤","poem":2},{"lineBreak":true},{"text":"ሀዻኡማ ሉቡኮቲንስ ነንዱበዸ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዋቃንስ አከነ ነንጄዸ፦","poem":1},{"text":"አት ማሊን አከ ነ ህመቱ ነት ህም መሌ ነት ህንሙርን።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሆጂ ጀልኦታ ገመቹዻን ፉዸቴ","poem":1},{"text":"አነሞ ዮሙ ጩንቁርስቱ፣","poem":2},{"lineBreak":true},{"text":"ሆጂ ሀርከኬቲስ ዮሙ ቱፈቱ ስት ቶላ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አት እጀ ፎኒ ቀብዳ?","poem":1},{"text":"አከ ነምን እላሉትስ ኒላልታ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"በርኬ አከ በረ ነማቲ?","poem":1},{"text":"ዮካን ወጎትንኬ አከ ወጎተ ነማቲ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዮስ አት ማሊፍ በሌሳኮ በርባዴ","poem":1},{"text":"ጩቡኮ ቆረተ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ተኡስ አት አከ አን የከ ህንቀብኔፊ","poem":1},{"text":"አከ ነምን ሀርከኬቲ ነ ባሱ ቶኮዩ ህንጅሬ ንቤክተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ሀርክኬ ቶልቼ ነ ኡሜ።","poem":1},{"text":"አት አመ ዴብቴ ነ በሌስታ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አከ ሱጴት ነ ቶልቹኬ ያደዹ።","poem":1},{"text":"አት አመ ገረ ብዮት ነ ዴብፍታ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አት አከ ኣነኒ ነ ህንዸንገላፍኔ?","poem":1},{"text":"አከ ባዱስ ነ ህንእትችኔ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አት ጎጋፊ ፎን ነት ኡፍፍቴ፤","poem":1},{"text":"ለፌፊ ርቡዻንስ ወልት ሆዽቴ ነ ቶልችቴ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አት ጅሬኘ ና ኬንቴ ጋሩማ ነት አርግሲፍቴ፤","poem":1},{"text":"ኩኑንስኬስ ሀፉረኮ ና ኤጌ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“አት ገሩ ዋን ከነ ሁንደ ገራት ቀበቴ፤","poem":1},{"text":"አንስ አከ ወን ኩን ያደኬ ኬሰ ጅሩ ነንቤከ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አት ዮ አን ጩቡ ሆጄዼ ነ አርግተ፤","poem":1},{"text":"በሌሳኮስ ኡቱ ህንአደብን ብረ ህንደበርቱ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዮ አን የከ ሆጄዼ፣ አናፍ ወዮ!","poem":1},{"text":"አን ዮ ነመ በሌሳ ህንቀብኔ ተኤሌ፣መታኮ ኦል ቀበቹ ህንደንደኡ፤","poem":2},{"text":"አን ሰልጵነ ኡፈዼ","poem":1},{"text":"ዽጵነ ኬሰ ሴኔራቲ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዮ አን መታ ኦል ቀበዼ አት አከ ሌንጨ ዋ አደምሱ ነ አደምስተ፤","poem":1},{"text":"ሁምነኬ ሶዳችሳ ሰነስ አሙማ አመ ነት አርግሲፍተ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አት ዹገ ባቶተ ሃራ ነት ፍዴ","poem":1},{"text":"ዼከምሰኬ ነት ደበልተ፤","poem":2},{"lineBreak":true},{"text":"ሎልቱስ ነት ፍደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“ኤጋ አት ማሊፍ ገደሜሰ ኬሳ ነ ባፍቴ?","poem":1},{"text":"ኡቱ እጅ ቶኮዩ ነ ህንአርግን ኡቱን ዱኤ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አን ኡቱን ዸለቹ ባዼ","poem":1},{"text":"ዮካን ኡቱን አኩመን ዸለዼን አዋለሜ ጅራዼ!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"በርኮ ገባባን ዹማ ጅረ ምቲ?","poem":1},{"text":"አከ አን ዬሮ ጥኖፍ ገመዱፍ ነራ ዴብእ፤","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ኡቱ አን ለፈ ዸቀኒ ህንዴብኔ፣","poem":1},{"text":"ብየ ድምምሳፊ ዱከነ ልምጢ ህንዸቅን ዱረ፣","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ገረ ብየ ድምምሳኣ አከ ዱከና፣","poem":1},{"text":"ብየ ጋድዱ ዱኣቲን ጉተሜ፣","poem":2},{"lineBreak":true},{"text":"ከን እፍንዩ አኩመ ዱከና ተኤ ህንዸቅን፣ ነራ ዴብእ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/9.json","previousChapterAudioLinks":{},"numberOfVerses":22}