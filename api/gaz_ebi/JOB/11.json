{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":11,"content":[{"type":"heading","content":["ዞፋር"]},{"type":"verse","number":1,"content":["ዞፋር ናእማትች አከነ ጄዼ ዴብሴ፦"]},{"type":"verse","number":2,"content":[{"text":"“ዱቢወን ኩኔን ሁንድ ዴቢ አርገቹ ህንቀበኒ?","poem":1},{"text":"ዱቢ ባይእሱን ቀጄላ ነመ ጎዻ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኦፍ ጀጁንኬ አፋን ነመ ቀበቺሳ?","poem":1},{"text":"ዮሙ አት ቆስቱ ነምን ስ እፈቱ ህንጅሩ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አት ዋቃን፣ ‘በርሲስንኮ ቁልቁሉዸ፤","poem":1},{"text":"አን ፉለኬ ዱረት ህርእነ ህንቀቡ’ ጄተ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ማሎ ኡቱ ዋቅን ስት ዱበቴ፣","poem":1},{"text":"ኡቱ አፋንሳስ ስት ሳቀቴ","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እጪቲ ኦጉማ ሲፍ እብሴ አን አከምን ሀወ!","poem":1},{"text":"ኦጉማን ዹጋን ብፈ ለመ ቀባቲ።","poem":2},{"lineBreak":true},{"text":"ከናፉ ዋቅን ጩቡኬ ሙራሰ አከ ሲፍ እራንፈቴ ቤክ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“እጪቲ ዋቃ ቆረቴ ብረ ገኡ","poem":1},{"text":"ዮካን ያደ ዋቀ ዋን ሁንደ ደንደኡ ቆረቴ ብረ ገኡ ደንዴሳ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እሳን ሰሚወን ጫላ ኦል ፈጋቱ፤ አት ማል ጎቹ ደንዴሰ?","poem":1},{"text":"ቅሌ አዋላ ጫላስ ገድ ፈጋቱ፤ አት ማል ቤኩ ደንዴሰ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሰፈርሳ ለፈ ጫላ ዼረተ፤","poem":1},{"text":"ገላነ ጫላ በልአተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ዮ እን ዹፌ መነ ህዻት ስ ገልቼ፣","poem":1},{"text":"ዮ ወልዳ ሙርቲስ ወልት ቀቤ ኤኙቱ እሰ ዾዉ ደንደአ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዹጉማን እን ሶብዶተ ንቤከ፤","poem":1},{"text":"እን ዮሙ ጀልእነ አርጉት ህንቀልቤፈቱ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዮ ሀሬን ዲዳ ነመ ተኤ ዸለቴ መሌ","poem":1},{"text":"ጎዋን ኦጌሰ ተኡ ህንደንደኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ተኡስ ዮ አት ያደኬ ገረሳት ዴብፍቴ","poem":1},{"text":"ሀርከኬስ ገረሳት ድሪርስቴ፣","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ጩቡ ሀርከኬ ኬሰ ጅሩ ዮ ኦፍራ ፈጌስቴ፣","poem":1},{"text":"አከ ወን ሀማንስ ዱንካነኬ ኬሰ ህንጅራትኔ ዮ ጎቴ፣","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አት ቃኒ ቶኮ መሌ ፉለኬ ኦል ቀበቹ ደንዴሰ፤","poem":1},{"text":"ሶዳ ቶኮ መሌስ ጀባቴ ዻበተ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አት ዹጉማን ረክነኬ ንእራንፈተ፤","poem":1},{"text":"አኩመ ሎላ ደርቤትስ ንለኮፍተ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ጅሬኝኬ አዱ ሳፋ ጫላ እፈ፤","poem":1},{"text":"ዱከንሳስ አኩመ በሪ ገነማ ተአ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዋን አብዲን ጅሩፍ አት ህንሶዳቱ፤","poem":1},{"text":"ናኖኬ ኒላልተ፤ ነጋዻንስ ንቦቆተ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አት ንረፍተ፤ ነምን ቶኮዩ ስ ህንሶዳችሱ፤","poem":1},{"text":"ነሞትን ባይኤንስ ፉለኬ በርባዱ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እጅ ሀሞታ ንደዸበ፤","poem":1},{"text":"ከራን እቲን በቀተንስ እሳን ጀላ በደ፤","poem":2},{"lineBreak":true},{"text":"አብዲንሳኒስ ዱአ ቆፈ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}