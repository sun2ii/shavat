{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":12,"content":[{"type":"heading","content":["እዮብ"]},{"type":"verse","number":1,"content":["እዮብ አከነ ጄዼ ዴብሴ፦"]},{"type":"verse","number":2,"content":[{"text":"“ነመ ጄቹን ዹጉማን እስን፤","poem":1},{"text":"ኦጉማንስ እስን ወጅን ዱት!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ገሩ አንስ አኩመኬሰን ሰሙን ቀበ፤","poem":1},{"text":"አን እስኒ ገድ ምት።","poem":2},{"lineBreak":true},{"text":"ነምን ዋን አከና ህንቤክኔ ኤኙ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“አን ነመ ዋቀ ዋመቴ ዴቢ አርገቴ ተኡሌ፣","poem":1},{"text":"ምቾተኮ ብረት ነመ ኮልፋ ተኤረ።","poem":2},{"lineBreak":true},{"text":"አን ኡቱን ነመ ቀጄላ ህርእነ ህንቀብኔ ተኤ ጅሩ ነመ ኮልፋ ተኤረ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ወር እት ቶሌ ረክነት ቆሱ፤","poem":1},{"text":"ነመ ኩፉፍ ሚልሳ ሙጩጫቴንስ ኩን ህሬ እሳት ጄዹ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዱንካን ሳምቶታ ህንጄቀሙ፤","poem":1},{"text":"ወር ዋቀሳኒ ሀርከት ባተኒ ጆረን፣","poem":2},{"lineBreak":true},{"text":"ወር ዋቀ ዼከምሲሰን ነጋን ጅራቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ሜ ሆሪ ጋፈዹ፤ እሳን ስ በርሲሱ፤","poem":1},{"text":"ዮካን ስምብሮተ ሰሚ ጋፈዹ፤ እሳን ስት ህሙ፤","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዮካን ለፈት ዱበዹ፤ እን ስበርሲሰ፤","poem":1},{"text":"ዮካን ቁርጡሚወን ገላና ስት ሃህመን።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አከ ሀርክ ዋቀዮ ዋን ከነ ሆጄቴ፣","poem":1},{"text":"እሳን ከኔን ሁንደ ኬሳ ኤኙቱ ህንቤክኔ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሉቡን ኡመመ ሁንዳ፣","poem":1},{"text":"ሀፉር ነመ ሁንዳስ ሀርከሳ ኬሰ ጅረ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አኩመ አረብን ኛተ አፋኒን ቀቡ፣","poem":1},{"text":"ጉርስ ዱቢ ዸገኤ አዳን ህንባሱ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኦጉማን ጃርሶሊ ብረት፣","poem":1},{"text":"ሁበትናንስ ወረ ኡሙሪን ዼረቴ ብረት አርገመ ምቲ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ኦጉማፊ ሁምን ከን ዋቃት፤","poem":1},{"text":"ጎርሲፊ ሁበትናንስ ከንሳት።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዋን እን ዲጉ ኤኙዩ ዴብሴ እጃሩ ህንደንደኡ፤","poem":1},{"text":"ነመ እን ህዼ ኤኙዩ ሂኩ ህንደንደኡ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዮ እን ብሻን ዾወቴ፣ ሆንጌቱ ቡአ፤","poem":1},{"text":"ዮ እን ገድ ዺሴሞ ብየ በሌሰ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ጀብኒፊ ኦጉማን ከንሳት፤","poem":1},{"text":"ነምን ጎዎምፈሙፊ እን ጎዎምሱስ ከኑመሳት።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እን ጎርስቶተ ቁላ ዴምስሰ፤","poem":1},{"text":"አቦቲ ሙርቲስ ጎዎተ ጎዸ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እን ሞቶተራ ህዻ ሂኬ፣","poem":1},{"text":"ሙዺሳኒት ሰበተ ህዸ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሉቦተ ቁላ ዴምስሰ፤","poem":1},{"text":"ጀጀቤዪስ ንገገረገልቸ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ጎርስቶተ አመነሞ አፋን ቀበቺሰ፤","poem":1},{"text":"ሁበትና ጃርሶሊስ እራ ፉዸ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ወረ ከበጀሞት ሰልጵነ ፍደ፤","poem":1},{"text":"ወረ ጀጀቦሞ ህዸተ ሂከቺሰ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"እን እጪቲ ዱከና ኬሳ እፈት ባሰ፤","poem":1},{"text":"ዱከነ ልምጢስ እፈት ጌደረ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"እን ሰቦተ ንጉድሰ፤ ንበሌሰስ፤","poem":1},{"text":"ሰቦተ ንባይእሰ፤ ንብትኔሰስ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ቡልችቶተ አዱኛ ሁበትና መሌ ሀምብሰ፤","poem":1},{"text":"ገሞጂ ዳንዲ ህንቀብኔ ኬሰስ እሳን ጆርሰ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"እሳን ዱከነ እፈ ህንቀብኔ ኬሰ ቀቀበናዻን ዴሙ፤","poem":1},{"text":"እን አከ እሳን አኩመ ነመ መቻኤት ገተንተረንስ ንጎዸ።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}