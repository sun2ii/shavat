{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"“ዋን ከነ ሁንደ እጅኮ አርጌረ፤","poem":1},{"text":"ጉርኮስ ዸገኤ ሁበቴረ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዋን እስን ቤክተን አንስ ቤከ፤","poem":1},{"text":"አን እስኒ ገድ ምት።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አን ገሩ ዋቀ ዋን ሁንደ ደንደኡት ነንዱበዸ፤","poem":1},{"text":"ዋኤ ዽመኮስ ዋቀት ፈልሙ ነንበርባደ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እስን ገሩ ሶባን ነመ ፋልቱ፤","poem":1},{"text":"ሁንድኬሰን አቦቲ ቆርቻ","poem":2},{"lineBreak":true},{"text":"ከኔን ፋይዳ ህንቀብኔዸ!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እስን ዮ ጨል ጄተን ማል ቀበ!","poem":1},{"text":"ወን ሱን ኦጉማ እስኒፍ ተአ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አመ ፈልሚኮ ዸገኣ፤","poem":1},{"text":"ከዸትና አፋንኮቲስ ዸጌፈዻ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እስን ጀልእናን ዋቃፍ ዱበቱ?","poem":1},{"text":"ጎዎምሳዻንስ እሳፍ ኦዴስቱ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እሳፍ ንሎግዱ?","poem":1},{"text":"ዋቃፍስ ንፈልምቱ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዮ እን እስን ቆሬ ወን ጋሪን እስንራ አርገማ?","poem":1},{"text":"እስን አከ ነመ ጎዎምስተን፣ እሰ ጎዎምሱ ደንዴሱ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዮ እስን ዾክሳዻን ሎጊ ሆጄተን፣","poem":1},{"text":"እን ዹጉማን እስንት ዼከመ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሱራንሳ እስን ህንሶዳችሱ?","poem":1},{"text":"ሶዳችሱንሳ እስንት ህንዸገአሙ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ፈኬኝኬሰን ፈኬኘ ዳራት፤","poem":1},{"text":"ደኦንኬሰንስ ደኦ ሱጴት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“አከ አን ዱበዹፍ እስን ጨል ጄዻ፤","poem":1},{"text":"ኤርገሲ ወን በርባዴ ነት ሃዹፉ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አን ማሊፍን ፎንኮ እልካንኮቲን፣","poem":1},{"text":"ሉቡኮስ ሀርከኮቲን ቀበዸ?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዮ እን ነ አጄሴዩ አን እሰ ነንአብደዸ፤","poem":1},{"text":"ዋኤ ዽመኮቲሌ ፉለሳ ዱረት ነንፈልመዸ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኩን ፈይነኮ ንተአ፤ ወር ዋቀት ህንቡሌ","poem":1},{"text":"ፉለሳ ዱረት ዽኣቹ ህንደንደአኒቲ!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዱቢኮ ቀልቤፈዻ ዸጌፈዻ፤","poem":1},{"text":"ዋን አን ጄዹስ ጉርኬሰን ሃዸገኡ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ኩኖ አን ህመተኮ ቆጴፈዼረ፤","poem":1},{"text":"አከ እን ሙርቲ ቀጄላ ና ኬኑስ ነንቤከ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ነምን ነ ህመቱ ጅራ?","poem":1},{"text":"ዮ ጅራቴ፣ አን ነንጨልእሰ፤ ነንዱአስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ያ ዋቀዮ፣ አት ወንቶተ ከኔን ለማን ና ኬን መሌ","poem":1},{"text":"አን ፉለኬ ዱራ ህንዾከዹ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሀርከኬ ነራ ፈጌስ፤","poem":1},{"text":"ሶዳችስንኬስ ነ ህንርፈቺስን።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ኤርገሲ ነ ዋም፤ አንስ ነንኦዋዸ፤","poem":1},{"text":"ዮካን ነንዱበዸ፤ አትሞ ዴቢ ና ኬንተ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"አን በሌሳፊ ጩቡ ሀመምን ሆጄዼ?","poem":1},{"text":"የከኮቲፊ ጩቡኮ ነ ቤክስስ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"አት ማሊፍ ፉለኬ ዾክፈቴ","poem":1},{"text":"አከ ዲናት ነ እላልተ?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ባለ ቅሌንስ ሀርጫሴ ንጭጭርታ?","poem":1},{"text":"ሀበቂ ጎጋ ንአሪታ?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"አት ዋን እቲን ነ ሀዼስቱ ነት በሬስታቲ፤","poem":1},{"text":"ጩቡ ደርገጉማኮቲስ ነ ዻልችፍተ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ሚለኮ ጅርመ ግዱ ገልችተ፤","poem":1},{"text":"ፋነ ሚለኮቲት መለቶ ጎቴ","poem":2},{"lineBreak":true},{"text":"ከራኮ ሁንደ ጥዬፈቴ ዱካ ቡተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“ነምንስ አኩመ ዋን ቦሶሴት፣","poem":1},{"text":"አኩመ ወያ ብሊን ኛቴት ንዹመ።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}