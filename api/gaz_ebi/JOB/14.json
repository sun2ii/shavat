{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"“ነመ ዱበርቶተራ ዸለቴ፣","poem":1},{"text":"በርሳ ገባባፊ ከን ረክናን ጉተሜዸ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እን አኩመ ደራራ ንብቅለ፤ ንጮለገስ፤","poem":1},{"text":"አኩመ ጋድዱ አሪፈቴ ደርበ መሌ ህንቱሩ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እጅኬ ነመ አከሲ ጥዬፈቴ እላላ?","poem":1},{"text":"አት ሙርቲፍ ፉለኬ ዱረት እሰ ፍዳ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኤኙቱ ዋን ጡራኣ ኬሳ ዋን ቁልቁላኣ ባሱ ደንደአ?","poem":1},{"text":"ነምን ቶኮዩ ህንደንደኡ!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"በር ጅሬኘ ነማ ሙርታኣዸ፤","poem":1},{"text":"ባይእን ጅኦተሳስ ስ ብረ ጅረ፤","poem":2},{"lineBreak":true},{"text":"ዳንጋ እን ደርቡ ህንደንዴኜ ዳንጌስቴፊ ጅርተ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሀመ እን አከ ሆጄታ ቶኮት በረሳ ራወቱት፣","poem":1},{"text":"ፉለኬ እሰራ ዴብፈዹ፤ እሰስ ዺስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ሙክንሌ አብዲ ቀበ፦","poem":1},{"text":"ዮ ሙረሜ ዴብኤ ንለተ፤","poem":2},{"lineBreak":true},{"text":"ደሜንሳ ሃራንስ ህንጎጉ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዮ ጉፉንሳ ለፈ ኬሰት ዱሎሜ","poem":1},{"text":"ጉፉንሳ ብዮ ኬሰት ቶርቶሬዩ፣","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ፎሊ ብሻኒቲን ለተ፤","poem":1},{"text":"አከ ብቅልቱትስ ደሜ ንባፈተ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ነምን ገሩ ዱኤ አዋለመ፤","poem":1},{"text":"ሉቡንሳ ኬሳ ባት፤ እንስ ህንጅራቱ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አኩመ ብሻን ገላና ጎጉ","poem":1},{"text":"ዮካን ለግንስ ዹሜ ጎጉ ሰነ፣","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ነምንስ አከሱመ ንጪሰ፤ ህንከኡስ፤","poem":1},{"text":"ሀመ ሰሚወን ደርበንትስ ህንደመቁ","poem":2},{"lineBreak":true},{"text":"ዮካን ህርባ ህንከኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ማሎ ኡቱ አዋለ ኬሰ ነ ዾክስቴ","poem":1},{"text":"ሀመ ዼከምስኬ ደርቡት ነ ሀጉግዴ!","poem":2},{"text":"ማሎ ኡቱ ቤለመ ና ኬንቴ","poem":1},{"text":"ኤርገሲሞ ነ ያደቴ!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ነምን ቶኮ ዮ ዱኤ ዴብኤ ንጅራታ?","poem":1},{"text":"አን ሀመ ሃሮምፈምንኮ ዹፉት፣","poem":2},{"lineBreak":true},{"text":"በረ ረኮኮ ሁንደ ኦብሳን ነንኤገዸ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አት ነ ዋምተ፤ አንስ ስ ጀላ ነንኦዋዸ፤","poem":1},{"text":"ሆጂ ሀርከኬቲስ ንሀውተ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዬሮ ሰነ አት ተርካንፊኮ ንለኮፍተ፤","poem":1},{"text":"ጩቡኮ ገሩ ህንቶአቱ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"የክኮ ኮሮጆት ነቀሜ ቻፔፈመ፤","poem":1},{"text":"አት ጩቡኮ ንሀጉግደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“ገሩ አኩመ ቱሉን ሎላዻን ዽቀሜ ጅጉ፣","poem":1},{"text":"ከታንስ እዶሳቲ ቡቀኡ ሰነ፣","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አኩመ ብሻን ዸጋ ኛቴ ሀጵሱ፣","poem":1},{"text":"አኩመ ሎላን ብዮ ዽቁ ሰነ፣","poem":2},{"lineBreak":true},{"text":"አትስ አከሱመ አብዲ ነማ ንበሌስተ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አት በረ በራን እሰ ንሞተ፤ እንስ ንበደ፤","poem":1},{"text":"ብፈሳ ንጌደርተ፤ ኦፍ እራስ እሰ ፈጌስተ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዮ እልማንሳ ኡልፍነ አርገተን እን ህንቤኩ፤","poem":1},{"text":"ዮ እሳን ሰልጰተንስ ህንአርጉ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዹኩበ ዸግነሳ ቆፈቱ እሰት ዸገአመ፤","poem":1},{"text":"እን መታሳ ቆፋፍ ቦአ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}