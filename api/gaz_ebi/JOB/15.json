{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":15,"content":[{"type":"heading","content":["ኤሊፋዝ"]},{"type":"verse","number":1,"content":["ኤሊፋዝ ቴማንች አከነ ጄዼ ዴብሴ፦"]},{"type":"verse","number":2,"content":[{"text":"“ነምን ኦጌስ ቶኮ ዱቢ ፋይዳ ህንቀብኔን ዴቢ ኬና?","poem":1},{"text":"ዮካን ቡቤ በአ ቢፍቱቲን ገራሳ ጉተታ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እን ዱቢ ፋይዳ ህንቀብኔን፣","poem":1},{"text":"ሃሳ ቡኣ ህንቀብኔንስ ንፈልማ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አት ገሩ ዋቀ ሶዳቹ ንቱፈተ፤","poem":1},{"text":"ዋቀ ከዸቹሌ ነመ ዾውተ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ጩቡንኬ አፋንኬ ንበርሲፍት፤","poem":1},{"text":"አትስ አፋን ጀልኦታ ፍለተ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አፋኑመ ኬቱ ስት ሙረ መሌ አፋንኮ ምት፤","poem":1},{"text":"አረቡመ ኬቱ ረጋ ስት ተአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ስቱ ነመ ሁንደ ዱረ ዸለቴ?","poem":1},{"text":"ዮካን ስቱ ቱሉወን ዱረ አርገሜ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አት ዾክሳ ዋቃ ዸጌሴርታ?","poem":1},{"text":"ኦጉማስ ኦፉመኬቲፍ ዹንፈታ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ወን አት ቤክቱ ከን ኑ ህንቤክኔ ማል?","poem":1},{"text":"ሁበትናን አት ቀብዱ ከን ኑ ህንቀብኔ ማል?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ነሞትን አሪ ባሰኒፊ ከኔን ጃረን፣","poem":1},{"text":"ወር አባ ኬዩ ጫላ ዱሎመን ኑ ግዱ ጅሩ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጎርስ ዋቃ ከን ነመ ጀጀቤሱ፣","poem":1},{"text":"ዱቢን ሱታን ስት ህመሜ ሱን ስ ሀንቀቴ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ያድንኬ ማሊፍ ስ ፉዸቴ በደ?","poem":1},{"text":"እጀስ ማሊፍ በባፍተ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ወን አከ አት ዋቀት ኣርቱ፣","poem":1},{"text":"አከ ዱቢን አከሲስ አፋንኬቲ በኡ ጎዼ ማል?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“አከ ቁልቁሉ ተኡፍ ነምን ማል?","poem":1},{"text":"ዮካን አከ ቀጄልቶተ ተአኒፍ ወር ዱበርቶተራ ዸለተን ማል?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዮ ዋቅን ቁልቁሎተሳሌ አመኑ ባቴ","poem":1},{"text":"ሰሚወንዩ ፉለሳ ዱረት ቁልቁሉ ተኡ ባተን፣","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዮስ ሰኚን ነማ እን ሀማፊ ጡራኣን፣","poem":1},{"text":"ከን አኩመ ብሻኒት ጩቡ ዹጉ ሱንሀመም ሀመሲ ገድ ሃተኡሬ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“ነ ዸጌፈዹ፤ አን ሲፈን እብሳ፤","poem":1},{"text":"ዋነን አርጌስ ስት ነንህመ፤","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዋን ነሞትን ኦጌዪን","poem":1},{"text":"ዋን አቦቲሳኒራ ዸገአን ኬሳ ቶኮሌ ኡቱ ህንዾክስን","poem":2},{"lineBreak":true},{"text":"ኦዴሰን ሰነ ነንዱበዸ፤","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ብየቲን አቦቲሳኒ ቆፋፍ ኬነምቴ፤","poem":1},{"text":"አለጋን ቶኮዩ እሳን ግዱ ህንጅራትኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ነምን ደባን በረ ጅሬኘሳ ጉቱ፣","poem":1},{"text":"ገረ ጀቤስስ በረ እሳፍ ቆደሜ ጉቱ ንረከተ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሰገሌን ሶዳችሳን ጉረሳት ንእየ፤","poem":1},{"text":"ኡቱመ እን ነጋን ጅራቱስ ሳምቶትን ተሱመ እት ዹፉ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"እን አከ ዴብኤ ዱከነ ኬሳ በኡ ህንአመኑ፤","poem":1},{"text":"ጎራዴቱ እሰ ኤገተ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"እን ዋን ኛተሙ በርባቸ አሲፊ አች ጆረ፤","poem":1},{"text":"አከ ጉያን ዱከና ዽኣቴስ ንቤከ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዽጵናፊ ገድ እሰ ሶዳችሱ፤","poem":1},{"text":"አኩመ ሞቲ ሎላፍ ቆጳኤትስ እሰት ጭሙ፤","poem":2}]},{"type":"verse","number":25,"content":[{"text":"እን ሀርከሳ ዋቀት ኦል ፉዸቴ","poem":1},{"text":"ዋቀ ዋን ሁንደ ደንደኡስ ቱፈቴረ፤","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ጋቸነ የቡፊ ጀባ ቀበቴ","poem":1},{"text":"እሳን ሞርሙፍ መተ ጀብናን በኤረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“ዮ ፉልሳ ጮማን ሀጉገሜ","poem":1},{"text":"ሙዺንሳ ፎን ባሴ ኢተኤዩ፣","poem":2}]},{"type":"verse","number":28,"content":[{"text":"እን መጋላወን በርበዳአን ኬሰ፣","poem":1},{"text":"መኔን ነምን ቶኮዩ ኬሰ ህንጅራትኔ፣","poem":2},{"lineBreak":true},{"text":"ከኔን ዲገመኒ ቱለሙ ገአን ኬሰ ጅራተ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"እን ስአች ህንሶሮሙ፤ ቀቤኝሳስ ህንጅራቱ፤","poem":1},{"text":"ዮካን ቀቤኝሳ ለፈረ ህንቱሩ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"እን ዱከነ ጀላ ህንበኡ፤","poem":1},{"text":"አረብን እብዳ ደሜሳ ንጎግሰ፤","poem":2},{"lineBreak":true},{"text":"ሀፉር አፋን ዋቃቲ በኡስ እሰ ፉዸተ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"እን ሰበቢ ቤኛ ቶኮሌ ህንአርገኔፍ፣","poem":1},{"text":"ዋን ፋይዳ ህንቀብኔ አመነቹዻን ኦፍ ህንጎዎምስን።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"እን ኡቱ ዬሮንሳ ህንገእን ንጮለገ፤","poem":1},{"text":"ደሜንሳስ ህንለልሱ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"እን አከ ሙከ ወይኒ እጅሳ ኡቱ ህንብልቻትን እራ ፉናነሜ፣","poem":1},{"text":"አከ ኤጄርሰ ደራራሳ ኦፍራ ሀርጫሴ ንተአ።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ገሬን ወረ ዋቃፍ ህንቡሌ ንመሴነ፤","poem":1},{"text":"እብድስ ዱንካነ ወረ መተኣ ጃለተኒ ንጉበ።","poem":2}]},{"type":"verse","number":35,"content":[{"text":"እሳን ረክነ ኡልፋአኒ ሀምነ ዸለን፤","poem":1},{"text":"ገራንሳኒስ ጀልእነ ያደ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}