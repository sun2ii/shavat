{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"ሀፉርኮ ደዸቤረ፤","poem":1},{"text":"በርኮ ገባበቴረ፤","poem":2},{"lineBreak":true},{"text":"አዋልስ ና ቆጴፈሜረ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዹጉማን ቆስቶትን ነ መርሰኒሩ፤","poem":1},{"text":"እጅኮስ ሆጂሳኒ እሰ ሀማ ሰነ ሁበቴ እላለ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“ያ ዋቅ፣ ቀብሲሰ ና ተእ፤","poem":1},{"text":"ስመሌ ኤኙቱ ወቢ ና ተአ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አከ እሳን ዋ ህንሁበኔፍ አት ሰሙሳኒ ጩፍቴርተ፤","poem":1},{"text":"ከናፉ አት አከ እሳን ሞአተን ህንጎቱ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዮ ነምን ቶኮ ፋይዳ አርገቹፍ","poem":1},{"text":"ምቹሳ መቃ በሌሴ፣ እጅ እጆሌሳ ንጃመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“ዋቅን ነመ ሁንደ ብረት ነመ ኮልፋ፣","poem":1},{"text":"ነመ ነምን ፉለሳት ቱፉ ነ ጎዼረ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እጅኮ ሰበቢ ገዳቲፍ አርጉ ዸቤ፤","poem":1},{"text":"ዸግንኮ ጉቱንስ አኩመ ጋድዱት።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ቀጄልቶትን ዋን ከናን ንርፈቱ፤","poem":1},{"text":"ነምን በሌሳ ህንቀብኔስ ወረ ዋቀት ህንቡሌረት ከአ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ቀጄላን ገሩ ከራሳት ጭመ፤","poem":1},{"text":"ወር ሀርክሳኒ ቁልቁሉ ተኤስ ጀባቻ ዴሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ሁንድኬሰን ገሩ ሜ ዴብኣ ያላ!","poem":1},{"text":"አን እስን ኬሳ ነመ ኦጌሰ ቶኮሌ ህንአርገዹ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"በርኮ ደርቤረ፤ ከሮርኮ ፈሸላኤረ፤","poem":1},{"text":"ሀዊን ገራኮስ አከሱመ ተኤረ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ነሞትን ኩኔን ሀልከን ጉያት ጌደረኒሩ፤","poem":1},{"text":"ኡቱመ ዱከነ አርገኑስ፣ ‘እፍን ዽኣቴረ’ ጄዹ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዮ መን አን አብደዹ አዋለ ቆፈ ተኤ፣","poem":1},{"text":"ዮ አን ዱከነ ኬሰት ስሬኮ አፈዼ፣","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዮ አን ቦለ ቅሌቲን፣ ‘አት አባኮት፤’","poem":1},{"text":"ራሞዻንሞ፣ ‘አት ሃዸኮት፤’","poem":2},{"lineBreak":true},{"text":"ዮካን ‘ኦቦሌቲኮት’ ጄዼ፣","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኤጋ አብዲንኮ ኤሰ ጅረ?","poem":1},{"text":"ኤኙቱስ አብዲ ቶኮሌ ና አርገ?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እን ነ ወጅን አዋለ ቡኣ?","poem":1},{"text":"ኑስ ወሉማን ብዮ ሴና?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}