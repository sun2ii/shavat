{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":18,"content":[{"type":"heading","content":["ብልዳድ"]},{"type":"verse","number":1,"content":["ብልዳድ ሹሃህች አከነ ጄዼ ዴብሴ፦"]},{"type":"verse","number":2,"content":[{"text":"“እስን ሃሳ ከነ ዮም ፍጡ?","poem":1},{"text":"ሜ ቀልቤፈዻ፤ ኤርገሲ ዱበቹ ደንዴኘ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኑ ማሊፍ አከ ሎኒት ሄደምነ?","poem":1},{"text":"ማሊፍስ ፉለኬ ዱረት አከ ጎዋት እላለምነ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አት ከን ኣሪዻን ኦፍ ጭጭርቱ፣","poem":1},{"text":"ለፍት ሰበቢኬቲፍ ዱዋት ሀፍቲ?","poem":2},{"lineBreak":true},{"text":"ዮካን ከታን እዶሳቲ ንቡቅፈማ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“እብሳን ነመ ሀማ ንዻመ፤","poem":1},{"text":"አረብን እብደሳ እፈ ህንኬኑ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እፍን ዱንካነሳ ኬሳ ንዱከናአ፤","poem":1},{"text":"እብሳን እሰ ብረ ጅሩስ ንዻመ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ጀብን ተርካንፊሳ ንደዸበ፤","poem":1},{"text":"መልሳስ እሱመ ኩፍሰ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሚልሳ ክዮ ኬሰ እሰ ቡሰ፤","poem":1},{"text":"እን ቦለ ክዬፈሜረ ንጆረ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ክዮን ኮቴሳ ቀበ፤","poem":1},{"text":"ፉታሳንስ ጀቤሴ እሰ ቀበ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ለፈረ ፉኞን እሳፍ ዾክፈሜረ፤","poem":1},{"text":"ከራሳረስ ክዮን ካአሜረ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ናሱን ከራ ሁንዳን እሰ ሶዳችሰ፤","poem":1},{"text":"ፋነሳ ቡኤስ እሰ አርአ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"በዲስን አፋን እት በነቴረ፤","poem":1},{"text":"በላንስ ቆጳኤ ጅጉሳ ኤገተ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ጎጋንሳ ዹኩባን ኛተሜ ዹመ፤","poem":1},{"text":"እልም ዱኣ ሀንገፍትች ሀርካፊ ሚለሳ ኛተ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እን ዱንካነ አብደቴ ኬሳ ቡቅፈሜ","poem":1},{"text":"ገረ ሞቲ ሶዳት ጌፈመ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዋን ከንሳ ህንተእንስ ዱንካነሳ ኬሰ ጅራተ፤","poem":1},{"text":"ድኚን ቦበኡስ እዶ እን ጅራቱረ ፈፈጨአ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ጀላን ህድሳ ንጎገ፤","poem":1},{"text":"እራንሞ ደሜንሳ ንጮለገ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ያደኖንሳ ለፈራ ንበደ፤","poem":1},{"text":"መቃንሳስ ለፈራ ንዸበመ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እን እፈ ኬሳ ገረ ዱከናት ደርበተመ፤","poem":1},{"text":"አዱኛራስ ንዸበመ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እን ሰበሳ ግዱት እጆሌ ዮካን ሰኚ፣","poem":1},{"text":"ብየ ዱራን ጅራቴ ኬሰት ሀምባ ህንቀባቱ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ነሞትን ዽኣ ዋኤሳ ዸገአኒ ርፈቱ፤","poem":1},{"text":"ወር በኣስ ሶዳዻን ጉተሙ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"እዶን ጅሬኘ ነመ ሀማ፣ ዹጉማን አከነ ተአ፤","poem":1},{"text":"እዶን ነመ ዋቀ ህንቤክኔስ ከኑመ ተአ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}