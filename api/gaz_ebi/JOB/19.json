{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":19,"content":[{"type":"heading","content":["እዮብ"]},{"type":"verse","number":1,"content":["እዮብስ አከነ ጄዼ ዴብሴ፦"]},{"type":"verse","number":2,"content":[{"text":"“እስን ሀመ ዮሚት ነ ዽጵስተኒ","poem":1},{"text":"ዱቢን ነ ጨብስቱ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አመ ስአ ኩዸን ነ አረብስተኒርቱ፤","poem":1},{"text":"ቃኒ መሌስ ነ ሚተኒርቱ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዮ አን ዹጉማን ከራራ ጎሬ ጅራዼ፣","poem":1},{"text":"ዶጎጎርኮ አኑመ ወጅን ጅራተ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዮ እስን ዹጉማን አና ኦልት ኦፍ ጉድፍተኒ","poem":1},{"text":"ነ ሚዹፍ ሰልጵነኮት ፈየደምተን፣","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አከ ዋቅን ነ ሚዼ","poem":1},{"text":"ክዮሳሌ ነት ጠጤ ቤካ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ ‘አን ሚዸሜረ!’ ጄዼ እየዹሌ ዴቢ ህንአርገዹ፤","poem":1},{"text":"ሰገሌ ኦል ፉዸዼ ገርጋርሳፍ እዩስሙርቲን ቀጄላን ህንጅሩ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አከ አን ህንደበሬፍ እን ከራኮ ጩፌረ፤","poem":1},{"text":"ዳንዲኮትስ ዱከነ ሀጉጌረ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኡልፍነኮ ነራ ሙልቄረ፤","poem":1},{"text":"መታ ኮራስ ጎንፎ ፉዼረ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እን ሀመ አን በዱት ገመ ሁንዳን ነ ዲገ፤","poem":1},{"text":"አብዲኮሌ አኩመ ሙካ ቡቅሰ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዼከምስሳ ነት ቦበአ፤","poem":1},{"text":"አኩመ ዲነ እሳትስ ነ ሄደ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሎልቶትንሳ ሁምናን ዹፈኒ","poem":1},{"text":"ናኖኮት ደአትና እጃረተን፤","poem":2},{"lineBreak":true},{"text":"ዱንካነኮስ ንመርሰን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“እን ኦቦሎተኮ ነራ ፈጌሴረ፤","poem":1},{"text":"ምቾትንኮስ ኬሱማ ነት ተአን።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ፍሮትንኮ ነ ዺሰኒሩ፤","poem":1},{"text":"ምቹወንኮስ ነ ደገተኒሩ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኬሱሞትን መነኮ ጅረኒፊ","poem":1},{"text":"ጦምቦሬወንኮ አከ አለጋት ነ እላለን፤","poem":2},{"lineBreak":true},{"text":"አከ ነመ ኦርማትስ ነ ሄደን።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሆጄታኮ ነንዋመ፤","poem":1},{"text":"አፋንኮቲንስ እሰ ነንከዸዸ፤","poem":2},{"lineBreak":true},{"text":"እን ገሩ ነ ጀላ ህንኦዋቱ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሀፉርኮ ኒቲኮትሌ ጅብሲሳዸ፤","poem":1},{"text":"አን ኦቦሎተኮትስ ጥራኣዸ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እጆሌን ጥጥኖንዩ ነ ቱፈቱ፤","poem":1},{"text":"ዮሙ አን ከኡስ ነት ቆሱ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ምቾትንኮ ከኔን ወልት ዽኣትኑ ሁንድ ነ በልፈን፤","poem":1},{"text":"ወር አን ጃለዹስ ነት ገረገለን።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አን ጎጋፊ ለፌዸ መሌ ሆማ ምት፤","poem":1},{"text":"ጎጋን እልካኒ ቆፍት ናፍ ሀፌን ጀላ በኤ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“ገራ ና ላፋ፣ ያ ምቾተኮ ገራ ና ላፋ፤","poem":1},{"text":"ሀርክ ዋቃ ነ ዸኤራቲ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"እስን ማሊፍ አኩመ ዋቅን ነ አርኡ ሰነ ነ አሪቱ?","poem":1},{"text":"አመሌ ፎንኮ እስን ህንጌኜ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“ማሎ ኡቱ ዱቢንኮ በሬፈሜ ጅራቴ!","poem":1},{"text":"ኡቱ ክታበ ኬሰት በሬፈሜ!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ኡቱ ስቢላን ከታረት በሬፈሜ","poem":1},{"text":"ዮካን በረ በራን ዸጋረት ቅርጠሜ ጅራቴ!","poem":2}]},{"type":"verse","number":25,"content":[{"text":"አን አከ ፉሪንኮ ጅራታ ተኤ፣","poem":1},{"text":"አከ እን ዹመረት ለፈረ ዻበቱስ ነንቤከ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ኤርገ ጎጋንኮ በዴ ቦዴ፣","poem":1},{"text":"አን አመዩ ፎንኮቲን ዋቀ ነንአርገ፤","poem":2}]},{"type":"verse","number":27,"content":[{"text":"አን መታንኮ እሰ ነንአርገ፤","poem":1},{"text":"ኡቱ ነመ ብራ ህንተእን አኑ እጀኮቲን እሰ ነንአርገ።","poem":2},{"lineBreak":true},{"text":"ኦኔንኮ አከም ነ ኬሰት ገገብድ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“ዮ እስን፣ ‘ሰበቢ ህድ ረክነ ሰና እሰ ኬሰ ጅሩፍ","poem":1},{"text":"ኑ አከምት እሰ አሪነ?’ ጄተን፣","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ሰበቢ ዼከምስ ጎራዴዻን አደበሙ ፍዱፍ","poem":1},{"text":"እስን መታንኬሰን ጎራዴ ሶዳቹ ቀብዱ፤","poem":2},{"lineBreak":true},{"text":"ኩንስ አከ እስን አከ ሙርቲን ጅሩ ቤክተኒፍ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}