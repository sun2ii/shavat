{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":20,"content":[{"type":"heading","content":["ዞፋር"]},{"type":"verse","number":1,"content":["ዞፋር ናእማትች አከነ ጄዼ ዴብሴ፦"]},{"type":"verse","number":2,"content":[{"text":"“ዋን አን አከ መሌ ጄቀሜፍ፣","poem":1},{"text":"ያድንኮ አከ አን ዴቢ ኬኑ ነ ከካሰ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አን ዼከምሰ ነ ቃኔሱ ዸገኣን ጅረ፤","poem":1},{"text":"ቀልቢንኮስ አከ አን ዴቢ ኬኑ ነ ከካሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“አት ኤርገ ነምን ለፈረ ካአሜ በረ ዱሪቲ ጀልቀቤ","poem":1},{"text":"ወን ኩን አከም አከ ቱሬ ንቤክተ ምቲ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ቡራቁን ጀልኦታ ዬሮ ገባባፍ ቱረ፤","poem":1},{"text":"ገመቹን ወረ ዋቃፍ ህንቡሌስ አኩመ ልጵሱ እጃት።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኦፍ ቱሉማንሳ ሰሚወን ገኤ","poem":1},{"text":"መታንሳ ዱሜሰወን ቱቁስ፣","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እን አኩመ አዋራ በረ በራን በደ፤","poem":1},{"text":"ወር ዱራን እሰ አርገንስ፣ ‘እን ኤሰ ጅረ?’ ጄዹ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እን አኩመ አብጁ ፊጌ በደ፤ ዴብኤስ ህንአርገሙ፤","poem":1},{"text":"አኩመ ሙልአተ ሀልከኒስ ደፌ ዸበመ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እጅሳ አርጌ ቱሬ ዴብኤ እሰ ህንአርጉ፤","poem":1},{"text":"እዶንሳስ ስአች እሰ ህንእላሉ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እጆሌንሳ ህዬዪፍ ቤኛ ባሱ፤","poem":1},{"text":"ሀርክሳስ ቀቤኘ እን ሳሜ ዴብሴ ኬኑ ቀበ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጀብን ደርገጉማ ከን ለፌሳ ኬሰ ጉቴ ሱን፣","poem":1},{"text":"እሰ ወጅን ብዮ ኬሰ ጪሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ሀምን አፋንሳ ኬሰት ምኣዌ","poem":1},{"text":"እን አረበሳ ጀለ ዾክፈቱዩ፣","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እን አፋኒ ባፈቴ ገቱ ጅቤ","poem":1},{"text":"አፋኑመ ኦፊሳ ኬሰ ቱርፈቱዩ፣","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኛትንሳ ገራሳ ኬሰት ዸንገጋአ፤","poem":1},{"text":"እሰ ኬሰትስ ሀዻ ቦፋ ተአ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እን ቀቤኘ ልቅምሴ ሰነ ንቱፈ፤","poem":1},{"text":"ዋቅንስ አከ ገራንሳ ዋን ሰነ ድድጉ ንጎዸ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እን ሱሚ ቦፋ ጡጠ፤","poem":1},{"text":"አረብን ቡቲስ እሰ አጄሰ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እን ለገ ያኡ፣","poem":1},{"text":"ቡርቃ ደማቲፊ ዸዻ ህንአርጉ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እን ዋን እት ደዸቤ ኡቱ ህንኛትን ዴብሰ፤","poem":1},{"text":"ቡኣ ደልደለሳራ አርገቴትስ ህንገመዱ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እን ህዬዪ ሀጩጬ ሀርከ ዱዋ ሀምብሴራቲ፤","poem":1},{"text":"መነ ኦፊ ህንእጃርንስ ሁምናን ፉዸቴረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ሀዊሳ ሀማ ሰነራ ቦቆና ህንአርገቱ፤","poem":1},{"text":"እን ቀቤኘሳቲን ኦፍ ኦልቹ ህንደንደኡ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ወን እን ኛቱ ቶኮዩ ህንሀፉፍ፤","poem":1},{"text":"በዻዹማንሳስ እት ፉፌ ህንጅራቱ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ኡቱመ እን ዋን ሁንደ ቀቡ ረክን እሰት ዹፈ፤","poem":1},{"text":"ዽጵን ጭማንስ እሰ ቀበተ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዬሮ እን ገራሳ ጉተቱት፣","poem":1},{"text":"ዋቅን ዼከምሰሳ ሶዳችሳ ሰነ እት ኤርገ፤","poem":2},{"lineBreak":true},{"text":"ዸእቸሳሌ እት ሮብሰ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"እን ምአ ሎላ ስቢላ በቀቱሌ፣","poem":1},{"text":"ጥየ ናሲቱ እሰ ወራነ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዱግደሳ ኬሳ ጥየ፣","poem":1},{"text":"ትሩሳ ኬሳሞ ፊጤ ጨለቅሱ ቡቅሰ።","poem":2},{"text":"ሶዳን ጉዳን እሰ ቀበተ፤","poem":1}]},{"type":"verse","number":26,"content":[{"text":"ዱከን ልምጢንስ ርጴ ቀቤኘሳ ኤገተ።","poem":2},{"text":"እብድ ነምን ቶኮዩ ህንአፈርስን ጉቤ እሰ ፍጠ፤","poem":1},{"text":"ዋን ዱንካነሳ ኬሰት ሀፌስ ንበርበዴሰ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ሰሚወን በሌሳሳ ሳጥሉ፤","poem":1},{"text":"ለፍትስ እሰት ካት።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ጉያ ዼከምሰ ዋቃት ሎላን መነሳ፣","poem":1},{"text":"ብሻን ያኡስ ምአሳ ፉዸቴ ዴመ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ጨራን ዋቅን ጩበሞታፍ ኬኑ፣","poem":1},{"text":"ዻል ዋቅን እሳኒፍ ቆዴስ ከኑመ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}