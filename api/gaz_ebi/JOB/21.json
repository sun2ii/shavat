{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":21,"content":[{"type":"heading","content":["እዮብ"]},{"type":"verse","number":1,"content":["እዮብ አከነ ጄዼ ዴብሴ፦"]},{"type":"verse","number":2,"content":[{"text":"“ዱቢኮ ቀልቤፈዻ ዸጌፈዻ፤","poem":1},{"text":"ኩን ዋን እስን እቲን ነ ጀጀቤስተን ሃተኡ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዬሮ አን ዱበዹ ና ኦብሳ፤","poem":1},{"text":"ኤርገ አን ዱበዼ ቦዴ እስን ነት ቆሱ ደንዴሱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“ዹጉማን ከን አን ኮመዹ ነማ?","poem":1},{"text":"አን ማሊፍ ኦብሰ ህንዸብኔሬ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ነ እላላቲ ድንቅሲፈዻ፤ ሀርከኬሰንስ","poem":1},{"text":"አፋንኬሰንረ ካአዻ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አን ዮሙ ዋን ከነ ያዱ ነንሶዳዸ፤","poem":1},{"text":"ሆለትናንስ ነ ቀበተ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሀሞን ማሊፍ እት ፉፈኒ ሉቡን ጅራቱ?","poem":1},{"text":"ማሊፍ ዱሎመኒ ሁምነስ አርገቻ ዴሙ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እጆሌንሳኒ ናኖሳኒት፣","poem":1},{"text":"ሰኚንሳኒስ ፉለሳኒ ዱረት ጀባተኒ ዻበቱ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"መንሳኒ ነጋዸ፤ ዋን ሶዳቱሌ ህንቀቡ፤","poem":1},{"text":"ኡሌን ዋቃስ እሳን ህንቱቅጡ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኮርምሳኒ ዸልቹ ህንደዸቡ፤","poem":1},{"text":"ሳወንሳኒ ንዸሉ፤ ህንገተተንስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እሳን እጆሌሳኒ አኩመ ቡሻዬት ቦባሱ፤","poem":1},{"text":"ዳእመንሳኒሞ ንቡራቁ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ድቤፊ ክራራን ስርቡ፤","poem":1},{"text":"ሰገሌ ኡሉሌቲንስ ንገመዱ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እሳን በረሳኒ በዻዹማዻን ፍጠቱ፤","poem":1},{"text":"ነጋዻንስ ንአዋለሙ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ተኡሌ እሳን ዋቃን አከነ ጄዹ፤ ‘ኑ ዺስ!","poem":1},{"text":"ኑ ከራኬ ቤኩፍ ፌዺ ህንቀብኑ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አከ ኑ እሰ ተጃጅሉፍ ዋቅን ዋን ሁንደ ደንደኡ ኤኙ?","poem":1},{"text":"ኑ እሰ ከዸትኔ ማል አርገትነ?’","poem":2}]},{"type":"verse","number":16,"content":[{"text":"በዻዹማንሳኒ ገሩ እሳን ሀርከ ህንጅሩ፤","poem":1},{"text":"ከናፉ አን ጎርሰ ሀሞታራ ነንፈጋዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“ገሩ እብሳን ሀሞታ ዮምዩ ንዻማ?","poem":1},{"text":"በላን ዮምዩ እሳንት ዹፋ?","poem":2},{"lineBreak":true},{"text":"ዋቅንስ ዼከምሰሳቲን በዲሰ እሳንት ፍዳ?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እሳን አኩመ ጭዲ ፉለ ቅሌንሳ ዱራት፤","poem":1},{"text":"አኩመ ሀበቂ ቡቤን ሀማን ፉዸቴ ዴሙት።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እስን፣ ‘ዋቅን በሌሳ ነመ ቶኮ እልማንሳቲፍ ኩሰ’ ጄቱ።","poem":1},{"text":"አከ እን ዋን ከነ ቤኩፍ ዋቅን ነምቹመ መታሳቲፍ","poem":2},{"lineBreak":true},{"text":"ገቲሳ ሃኬኑ!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እጅሳ በዲሰሳ ሃአርጉ፤","poem":1},{"text":"እን ጦፎ ዼከምሰ ዋቀ ዋን ሁንደ ደንደኡ ሃዹጉ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"እን ዬሮ ጅእ እሳፍ ቆደሜ ዹሙት፣","poem":1},{"text":"ዋኤ ማቲሳ ከን ዺሴ ብራ ዴሙ ሰናዽመ ማሊ ቀባተ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“ነምን ቶኮዩ ዋቀ ቤኩምሰ በርሲሱ ደንደኣ?","poem":1},{"text":"ዋቅን ኦል ኣንቶተትዩ ንሙራቲ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ነምን ቶኮ ኡቱመ እት ቶሌ ነጋን ጅራቱ፣","poem":1},{"text":"ኡቱመ ሁምነ ጉቱ ቀቡ፣","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ኡቱመ ዸግንሳ ገበቴ ጅሩ፣ ኡቱመ ለፌንሳ","poem":1},{"text":"ዹካን ጉተሜ ጅሩ ንዱአ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ነምን ብራሞ ኡቱ ገመቹ ቶኮሌ ህንአርግን፣","poem":1},{"text":"ጅሬኘ ሀዻኣ ጅራቻ ዱአ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"እሳን ብዮ ኬሰ ወል ብረ ጭጪሱ፤","poem":1},{"text":"ለቸንሳኒቱ ራሞን ንቱተአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“አን ያደኬሰኒፊ","poem":1},{"text":"መለ እስን እቲን ነ ሚዹ በርባደን ነንቤከ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"እስን፣ ‘መን ነምቸ ጉዳ፣","poem":1},{"text":"ዱንካን ነሞትን ሀሞን ኬሰ ጅራተን አመ ኤሰ ጅረ?’ ጄቱ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"እስን ነሞተ ከራ ዴመን ህንጋፈኔ?","poem":1},{"text":"ዋን እሳን ጄዸንስ ህንቀልቤፈትኔ?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"አከ ነምን ሀማን ጉያ በላ ኦልፈሙ፣","poem":1},{"text":"አከ እን ጉያ ዼከምሳሌ በራረሙ ህንቀልቤፈትኔ?","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ነምን ፉሉመሳ ዱረ ዻበቴ ሆጂሳ እት ህሙ ኤኙ?","poem":1},{"text":"ነምን ገቲ ዋን እን ሆጄቴ ባሱፍ ኤኙ?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"እን ገረ አዋላት ጌፈመ፤","poem":1},{"text":"አዋልሳስ ንኤገመ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ብዮን ሱሉለ ኬሳ እሰት ምኣወ፤","poem":1},{"text":"ነሞትን ሁንድ እሰ ዱካ ቡኡ፤","poem":2},{"lineBreak":true},{"text":"ነሞትን አከ መሌ ባይኤንስ ፉለሳ ዱረ ዴሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“ዮስ እስን አከሚን ዋን ፋይዳ ህንቀብኔንነ ጀጀቤሱ ደንዴሱሬ?","poem":1},{"text":"ዴቢንኬሰንስ ሶበ ቆፈ!”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/20.json","previousChapterAudioLinks":{},"numberOfVerses":34}