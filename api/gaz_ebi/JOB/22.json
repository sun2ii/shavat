{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":22,"content":[{"type":"heading","content":["ኤሊፋዝ"]},{"type":"verse","number":1,"content":["ኤሊፋዝ ቴማንች አከነ ጄዼ ዴብሴ፦"]},{"type":"verse","number":2,"content":[{"text":"“ነምን ዋቀ ፈየዱ ደንደኣ?","poem":1},{"text":"ነምን ኦጌስዩ ማል እሰ ፈየደ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዮ አት ነመ ቀጄላ ታቴ ወን ኩን ዋቀ ዋን ሁንደ ደንደኡፍገመቹ ማሊ ኬነ?","poem":1},{"text":"ዮ ከራንኬ ህርእነ ቀባቹ ባቴስ እን ቡኣ ማሊ አርገተ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“ወን ዋቅን ስት ዼከሜ ሙርቲት ስ ዽኤሱፍ","poem":1},{"text":"ዋን አት እሰ ሶዳቱፊ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሀምንኬ ጉዳዸ ምቲ?","poem":1},{"text":"ጩቡንኬስ ዹመ ህንቀቡ ምቲ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አት ሰበቢ መሌ ኦቦሎተኬራ ቀብዲ ፉዸቴርተ፤","poem":1},{"text":"ነሞተራ ኡፈተ ባፍቴ ቁላ እሳን ሀምብፍቴርተ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ወረ ደዸበን ብሻን ህንኦባፍኔ፤","poem":1},{"text":"ከኔን ቤለአንስ ኛተ ዾወቴርተ፤","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ነምን ሁምነ ቀቡ ብየ ቀባተ፤","poem":1},{"text":"ከን ኡልፍነ ቀቡስ ኬሰ ጅራተ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አት ዱበርቶተ ዽርሶትንራ ዱአን ሀርከ ዱዋ ገድ ዺፍቴ፤","poem":1},{"text":"እሬ እጆሌ አባ ህንቀብኔስ ንጨብስቴ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ከናፉ ክዮን ስ መርሴረ፤","poem":1},{"text":"ሶዳን ተሳስ ስ ቀበቴረ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አከ አት ህንአርግኔፍ እፍንኬ ዱከናኤረ፤","poem":1},{"text":"ሎላን ብሻኒስ ስረ ገረገለ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ዋቅን ሰሚ ኬሰ ኦል ፈጎ ጅራተ ምቲ?","poem":1},{"text":"እን ኡርጂወን ኦል ፈጎ ጅረንሌ ሀመም አከ ኦል ፈጋተን ኦፍ ጀለት ገድ እላለ!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አት ገሩ አከነ ጄተ፤ ‘ዋቅን ማል ቤከ?","poem":1},{"text":"እን ዱከነ አከሲ ኬሰት ሙርቲ ኬና?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዮሙ እን በንቲ ሰሚረ ዴሙ፣","poem":1},{"text":"አከ እን ኑ ህንአርግኔፍ ዱሜስ ጎቡን እሰ ሀጉገ።’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አት ዳንዲ ዱሪ","poem":1},{"text":"ከን ነሞትን ሀሞንረ ዴመን ዱካ ቡታ?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እሳን ኡቱ ዬሮንሳኒ ህንገእን ፉዸተመን፤","poem":1},{"text":"ሁንዴን እሳንስ ሎላዻን ሀጣአሜ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እሳንስ ዋቃን፣ ‘ኑ ዺስ! ዋቅን ዋን ሁንደ ደንደኡ","poem":1},{"text":"ማል ኑ ጎቹ ደንደአ?’ ጄዸን።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ገሩ ከን መነሳኒ ዋን ጋሪን ጉቴ እሱመ፤","poem":1},{"text":"ከናፉ አን ጎርሰ ሀሞታራ ነንፈጋዸ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ቀጄሎትንስ በዲሰሳኒ አርገኒ ንገመዱ፤","poem":1},{"text":"ወር በሌሳ ህንቀብኔስ አከነ ጄዸኒ እሳንት ቆሱ፤","poem":2}]},{"type":"verse","number":20,"content":[{"text":"‘ዹጉማን አመጃጆንኬኘ በሌፈመኒሩ፤","poem":1},{"text":"ቀቤኘሳኒስ እብድ በርበዴሴረ።’","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“ዋቃን ወሊ ገል፤ እሰ ወጅንስ ነጋን ጅራዹ፤","poem":1},{"text":"ሃለ ከናንስ ወን ጋሪን ሲፍ ዹፈ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"አፋንሳቲ ቀጄልፈመ ፉዸዹ፤","poem":1},{"text":"ዱቢሳሌ ገራት ቀበዹ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዮ ገረ ዋቀ ዋን ሁንደ ደንደኡት ዴብቴ፣አት ንሃሮምፈምተ፤","poem":1},{"text":"ዮ ዱንካነኬ ኬሳ ሀምነ በሌስቴ","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ወርቄኬ ብዮ ኬሰ ቡፍቴ፣","poem":1},{"text":"ዮ ወርቄ ኦፊሪሞ ዸጋ ኬሰት ገቴ፣","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዮስ ዋቅን ዋን ሁንደ ደንደኡ ወርቄ፣","poem":1},{"text":"ሜቲ ፍለተማስ ሲፍ ተአ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"አት ዬሮ ሰነት ዋቀ ዋን ሁንደ ደንደኡት ንገመደ፤","poem":1},{"text":"ፉለኬስ ገረ ዋቃት ኦል ቀበተ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"አት እሰ ከዸተ፤ እን ስ ዸገአ፤","poem":1},{"text":"አትሞ ወሬገኬ ንባፈተ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ወን አት ሙርቴስቴ ንተአ፤","poem":1},{"text":"እፍንስ ከራኬረት ንእፈ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ዬሮ ነሞትን ገድ ቀበመንት አትሞ፣ ‘ኦል እሳን ቀብ!’ ጄተ፤","poem":1},{"text":"እንስ ወረ ገድ ቀበመን ንበራረ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"እን ነመ በሌሳ ቀቡሌ ንኦልቸ፤","poem":1},{"text":"አት ቁልቁሉማ ሀርከኬቲቲን ፉረምተ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}