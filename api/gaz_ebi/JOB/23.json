{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":23,"content":[{"type":"heading","content":["እዮብ"]},{"type":"verse","number":1,"content":["እዮብ አከነ ጄዼ ዴብሴ፦"]},{"type":"verse","number":2,"content":[{"text":"“ሀርአዩ ጉንጉሚንኮ ሀዻኣዸ፤","poem":1},{"text":"ዮ አን አከም ኣዴዩ ሀርክሳ ነት ኡልፋቴረ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አን ኡቱን እዶ እት እሰ አርገዹ ቤኬ፣","poem":1},{"text":"ኡቱ እዶ እን ጅራቱሌ ዸቁ ደንደኤ!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ስላ ዽመኮ ፉለሳ ዱረት ዽኤፈዼ","poem":1},{"text":"አፋንኮ ፈልሚን ጉተዸ ቱሬ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዋን እን ና ዴብሱ ነንቤከን ቱሬ፤","poem":1},{"text":"ዋን እን ናን ጄዹስ ነንሁበዸን ቱሬ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እን ሁምነሳ ጉዳ ሰናን አናን ሞርማ?","poem":1},{"text":"ለክ፣ ነ ዸጌፈተ መሌ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ነምን ቀጄላን አቹመ ፉለሳ ዱረት ዽመሳ ንዽኤፈተ፤","poem":1},{"text":"አንስ እሰ ነት ሙሩ ጀላ በረ በራን ነንበአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ገሩ ዮ አን ገረ በአ ቢፍቱ ዴሜ፣ እን አች ህንጅሩ፤","poem":1},{"text":"አን ዮ ገረ ዽኣ ዸቄስ አችት እሰ ህንአርገዹ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዮሙ እን ካበት ሆጂረ ጅሩት አን እሰ ህንአርጉ፤","poem":1},{"text":"ዮሙ እን ገረ ክባት ዴብኡትስ","poem":2},{"lineBreak":true},{"text":"አን ሀመ ልብሱ እጃ እሰ አርጉ ህንደንደኡ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እን ገሩ ከራ አን በኡ ንቤከ፤","poem":1},{"text":"ዮሙ እን ነ ቆሩትስ አን አከ ወርቄ ተኤ ነንሙልአዸ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሚልኮ ተርካንፊሳት ዽኣቴ ዱካ ቡኤረ፤","poem":1},{"text":"አን ኡቱንራ ህንጎርን ከራሳ ኤጌረ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አን አጀጀ አፋንሳራ ህንፈጋትኔ፤","poem":1},{"text":"ኛተ ጉያ ጉያ ጫላስ ዱቢ አፋንሳ ነንጃለዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“እን ገሩ ኦፍ ደንደኤ ኮጳሳ ዻበተ፤","poem":1},{"text":"ከን እሳን ሞርሙ ደንደኡ ኤኙ?","poem":2},{"lineBreak":true},{"text":"እን ዋኑመ ጃለቱ ሆጄተ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እን ዋን ነት ሙሬ ንራወተ፤","poem":1},{"text":"አመሌ ከሮረ አከና ሄዱ ያደሳ ኬሳ ቀበ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ወን አን ፉለሳ ዱረት ነኡፍስ ከኑመ፤","poem":1},{"text":"አን ዮሙን ዋን ከነ ሁንደ ያዱት እሰ ነንሶዳዸ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዋቅን ገራኮ ንራሴ፤","poem":1},{"text":"ዋቅን ዋን ሁንደ ደንደኡ ነ ሶዳችሴ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሃተኡ መሌ ዱከን፣","poem":1},{"text":"ዱከን ልምጢን ፉለኮ ሀጉጉዩ ነ ህንበርበዴስኔ።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}