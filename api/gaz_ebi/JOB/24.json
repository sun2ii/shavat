{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"“ዋቅን ዋን ሁንደ ደንደኡ ሱን ማሊፍ ዬሮ ሙርቲ ህንሙርቴስኔ?","poem":1},{"text":"ወር እሰ ቤከን ማሊፍ አከሱማን ጉዮተሳ ህንአርግኔ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ነሞትን ዸጋ ዳሪ ንዺቡ፤","poem":1},{"text":"ቡሻዬ ሀተኒስ ንቦባሱ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እሳን ሀሬ እጆሌ አባ ህንቀብኔ ኦፈተኒ ዴሙ፤","poem":1},{"text":"ሰንጋ ሃዸ ህዬሳ ቀብዲ ፉዸቱ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ረከታ ከራራ በሌሱ፤","poem":1},{"text":"ህዬዪን ብያ ሁንድስ እሳን ጀላ ዾከቱ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ህዬዪን አኩመ ሀሬ ዲዳ ከን ገሞጂ ኬሳ","poem":1},{"text":"ኛተ በርባቸ አሲፊ አች ጆሩ፤","poem":2},{"lineBreak":true},{"text":"ገሞጂ ሰነ ኬሳስ እጆሌሳኒቲፍ ኛተ ኬነ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እሳን ድሬረት ኦካ ወልት ቀበቱ፤","poem":1},{"text":"እዶ ዻባ ወይኒ ነመ ሀማራስ ቀርሚ ፉናነቱ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኡፈተ ዸበኒ ሀልከን ቁላ ቡሉ፤","poem":1},{"text":"ዋን ዻሞቸ ኬሰት ኡፈተን ቶኮሌ ህንቀበን።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እሳን ቦካ ቱሉቲን ቶርቶረኒሩ፤","poem":1},{"text":"ዋን እት ደአተንሌ ዸበኒ ከታ ሀመቱ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሙጫን አባ ህንቀብኔ ሀርመራ ቡተሜረ፤","poem":1},{"text":"ዳእምን ህዬሳ ቀብዲ ኬነሜረ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እሳን ኡፈተ ዸበኒ ቁላ ዴሙ፤","poem":1},{"text":"ብሲ ባቱ፤ ገሩ ንቤለኡ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እሳን ዸጋ ግዱት ዘይቲ ኤጄርሳ ባሱ፤","poem":1},{"text":"ወይኒ ጩንፉ፤ ገሩ ንዼቦቱ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኣዱን ወረ ዱኡት ጅረኒ መጋላ ኬሳ ንዸገአመ፤","poem":1},{"text":"ሉቡን ወረ መዳአኒስ ገርጋርሰ በርባቸ እይት።","poem":2},{"lineBreak":true},{"text":"ዋቅን ገሩ በሌሳ ቶኮዩ እሳንት ህንለካኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ወር እፈት ፍንጭለን ከኔን ዳንዲሳ ህንቤክኔ","poem":1},{"text":"ዮካን ዳንዲ እፋረ ህንጅራትኔ ጅሩ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዮሙ አዱን ዺቱ፣ ነምን ነመ አጄሱ ንከአ፤","poem":1},{"text":"እንስ ህዬዪፊ ረከቶተ ንአጄሰ፤","poem":2},{"lineBreak":true},{"text":"ሀልከንሞ አኩመ ሀቱ ተአ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እጅ ኤጃን ድምምሰ ኤገተ፤","poem":1},{"text":"እንስ፣ ‘እጅ ነ አርጉ ህንጅርቱ’ ጄዸ፤","poem":2},{"lineBreak":true},{"text":"ፉለሳስ ንዾክፈተ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ነሞትን ዱከነ ኬሰ መነ ጨብሰኒ ሴኑ፤","poem":1},{"text":"ጉያ ገሩ ኦፍት ጩፈኒ ኦሉ፤","poem":2},{"lineBreak":true},{"text":"እሳን እፈ ህንቤከን።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሁንደሳኒቲፍ፣ ዱከን ጉዳን በሪሳኒት፤","poem":1},{"text":"እሳን ሶዳ ዱከነ ጉዳት ምቾሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“ተኡስ እሳን ሆመቸ ብሻን ጉባት፤","poem":1},{"text":"አከ ነምን ቶኮዩ ገረ እዶ ዻባ ወይኒ ህንዸቅኔፍ፣","poem":2},{"lineBreak":true},{"text":"ቆድን ለፈሳኒ አባረሜረ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አኩመ ሆኢፊ ሆንጌን ጨቢ በቄ ጡጤ ፍጡ፣","poem":1},{"text":"አዋል ነሞተ ጩቡ ሆጄተን ንቡተተ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ገደሜስ እሳን እራንፈተ፤","poem":1},{"text":"ራሞንስ እት ዱዴ እሳን ኛት፤","poem":2},{"text":"ነሞትን ሀሞን አኩመ ሙካ ንጨጨቡ፤","poem":1},{"text":"ስአችስ ህንያደተመን።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"እሳን ዱበርቲ ዸብዱ ንሳሙ፤","poem":1},{"text":"ሃዸ ህዬሳቲፍሌ ገራ ህንላፈን።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዋቅን ገሩ ሁምነሳቲን ጀጀቦተ አለት ሀርክሰ፤","poem":1},{"text":"እሳን ኦል ከኡ፤ ገሩ ወቢ ጅሬኛ ህንቀበን።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"እን አከ እሳን ዋን ነጋን ጅራተን ሴአኒፍ እቱመ ዺሱ ደንደአ፤","poem":1},{"text":"እጅሳ ገሩ ከራሳኒ ንቶአተ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"እሳን ዬሮ ጥኖፍ መታ ኦል ቀበቱ፤ ኤርገሲሞ ንበዱ፤","poem":1},{"text":"ገድ ዴብፈመኒስ አኩመ ወረ ካኒ ወልት ቀበሙ፤","poem":2},{"lineBreak":true},{"text":"አኩመ መታ ምዻኒስ ንሙረሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“ዮ ኩን አከስ ተኡ ባቴ","poem":1},{"text":"ኤኙቱ ሶብዱ ነ ጎዼ ዱቢኮ ቡሼሰ?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}