{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"heading","content":["እዮብ"]},{"type":"verse","number":1,"content":["እዮብ አከነ ጄዼ ዴብሴ፦"]},{"type":"verse","number":2,"content":[{"text":"“አት ነመ ሁምነ ህንቀብኔ ሀመም ገርጋርቴ!","poem":1},{"text":"እሬ ላፌስ ሀመም ጀጀቤስቴ!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ነመ ኦጉማ ህንቀብኔፍ ጎርሰ አከሚ ኬንቴ!","poem":1},{"text":"ቤኩምሰ ጉዳ አከሚስ አርግሲፍቴ!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አከ አት ዱቢ ከነ ዱበቱፍ ኤኙቱ ስ ገርጋሬ?","poem":1},{"text":"ሀፉረ ኤኙቱ አፋንኬ ኬሳ ዱበቴ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ወር ዱአን፣ ወር ብሻኒ ገዲቲፊ","poem":1},{"text":"ከኔን ብሻን ኬሰ ጅራተን ሁንዲ ንሆለቱ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዱት ፉለ ዋቃ ዱረት ቁላ ጅረ፤","poem":1},{"text":"በዲስንስ ዋን እሰ ዾክሱ ህንቀቡ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዋቅን እዶ ዱዋረ ሰሚ ካባ ድሪርሰ፤","poem":1},{"text":"ለፈስ እዶ ዱዋረት ረራሰ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እን ዱሜሰሳቲን ብሻኖተ ህዼ ቀበ፤","poem":1},{"text":"ዱሜስ ሱንስ ብሻኖተ ጀለት ህንዾኡ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እን ዱሜሶተሳ እት ኡፍሱዻን","poem":1},{"text":"ፉለ ጅኣ ንሀጉገ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እን ፉለ ብሻኖታረት፣","poem":1},{"text":"እፋፊ ዱከነ ግዱ ዳሪ ዻቤ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኡቱባወን ሰሚ ንሆለቱ፤","poem":1},{"text":"ዼከምሰሳቲንስ ንርፈቱ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እን ሁምነሳቲን ገላነ ንራሰ፤","poem":1},{"text":"ኦጉማሳቲንስ ረኣብን ንጭጭረ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሀፉረ ባፈቱን ሰሚወን ቁልቁሌሴ፤","poem":1},{"text":"ሀርክሳስ ቦፈ ሸውሳ ወራኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ወንቶትን ኩኔን ሆጂሳ ኬሳ ቀርቀሩመ ቆፈ፤","poem":1},{"text":"ሀሳስን ኑ ዋኤሳ ዸጌኙ ሀመም ጥናዸ!","poem":2},{"lineBreak":true},{"text":"ዮስ ከከዌ ሁምነሳ ኤኙቱ ሁበቹ ደንደአሬ?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}