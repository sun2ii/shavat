{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":["እዮብ ሃሳሳ እት ፉፌ አከነ ጄዼ፦"]},{"type":"verse","number":2,"content":[{"text":"“ዹጋ ዋቀ ጅራታ ሙርቲ ቀጄላ ነ ዾወቴ፣","poem":1},{"text":"ዋቀ ዋን ሁንደ ደንደኡ ከን ሉቡኮ ሀዼሴ ሰና፣","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሀመ ሉቡን ነ ኬሰ ጅርቱት፣","poem":1},{"text":"ሀመ ሀፉር ዋቃ ፉኛንኮ ኬሰ ጅሩት፣","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አፋንኮ ሀምነ ህንዱበቱ፤","poem":1},{"text":"አረብንኮስ ነመ ህንጎዎምሱ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እስን ቀጄልቶተ ጄቹ፣ ዋቅን አነራ ሃፈጋቱ፤","poem":1},{"text":"አን ሀመን ዱኡት አመነሙማኮ ህንዺሱ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ቀጄሉማኮ ጀቤሴ ነንቀበዸ፤ ገድስ ህንዺሱ፤","poem":1},{"text":"በረ ጅሬኘኮቲ ጉቱ ቀልቢንኮ ነ ህንኮመቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ዲንኮ አከ ነመ ሀማ፣ ሞርምቱንኮ","poem":1},{"text":"አከ ነመ ጀልኣ ሃተኡ!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዮሙ ዋቅን ሉቡሳ እሰራ ፉዸቴ እሰ በሌሱት፣","poem":1},{"text":"ነምን ዋቃፍ ህንቡሌ አብዲ ማሊ ቀበ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዬሮ ረክን እሰት ዹፉት፣","poem":1},{"text":"ዋቅን እየሳ ንዸገኣ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እን ዋቀ ዋን ሁንደ ደንደኡት ንገመዳ?","poem":1},{"text":"ዬሮ ሁንደስ ዋቀ ዋመታ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“አን ዋኤ ሀርከ ዋቃ እስን ነንበርሲሰ፤","poem":1},{"text":"ዋን ዋቀ ዋን ሁንደ ደንደኡ ብረ ጅሩስ እስን ህንዾክሱ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሁንድኬሰን ዋን ከነ አርግተኒርቱ፤","poem":1},{"text":"ዮስ ሃሳን ፋይዳ ህንቀብኔ ኩን ማል?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ጨራን ዋቅን ነመ ሀማፍ ቆዴ፣","poem":1},{"text":"ዻል ነምን ጀልኣን ዋቀ ዋን ሁንደ ደንደኡራ አርገቱ ከነ፦","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እጆሌንሳ አከ መሌ ባይአተንዩ ጎራዴቱ እሳን ኤገተ፤","poem":1},{"text":"ሰኚንሳስ ዋን ኛቴ ቁፉ ህንቀባቱ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሀምባሳ ዸእቸቱ አዋለ፤","poem":1},{"text":"ኒቶትንሳኒስ ህንቦአኒፍ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እን ሜቲ አኩመ ብዮት ቱለቴ","poem":1},{"text":"ኡፈተሞ አኩመ ሱጴት ኩፈቱሌ፣","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዋን እን ኩፈቴ ነመ ቀጄላቱ ኡፈተ፤","poem":1},{"text":"ሜቲሳሌ ነመ በሌሳ ህንቀብኔቱ ቆደተ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"መን እን እጃሩ አኩመ መነ ዾልዾሌት፤","poem":1},{"text":"አኩመ ዳሲ ኤግዱን እጃሩት።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እን ኡቱመ ቀቤኘ ቀቡ ዸቄ ጪሰ፤ ገሩ እት ህንዴብኡ፤","poem":1},{"text":"ዬሮ እን እጀ በነቱት፣ ቀቤኝሳ ሁንድ ህንጅሩ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ሶዳን አኩመ ሎላ እሰረ ገረገለ፤","poem":1},{"text":"ቡቤን ሀማንሞ ሀልከኒን እሰ ፉዸቴ ሶከ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ቡቤን በአ ቢፍቱ እሰ ፉዸተ፤","poem":1},{"text":"እንስ ህንአርገሙ፤ ቡቤን ሱንስ ለፈ እን ጅሩራ እሰ ሀጣአ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"እን ሁምነ ቡቤ ጀላ በኡፍ ጄዼ በቀተ፤","poem":1},{"text":"ቡቤን ሱንስ ገረ ላፍነ ቶኮ መሌ እት ኦፍ ደርበተ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ሀርከሳ ዸዸኤ እት ቆሰ፤","poem":1},{"text":"አፉፌስ እዶሳቲ እሰ በሌሰ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}