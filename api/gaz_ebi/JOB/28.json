{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"ዹጉማን እዶን ሜቲን ኬሳ ቆተሙ፣","poem":1},{"text":"ለፍት ወርቄን እት ባፈሜ ቁልቁሌፈሙ ጅረ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ስቢል ለፈ ኬሳ ባፈመ፤","poem":1},{"text":"ስቢል ዲማንሞ ዸጋ አልቡዳራ በቅፈመ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ነምን ሀመ ዹመ ዱከናት ዴመ፤","poem":1},{"text":"ሞጋ አከ መሌ ፈጎ ዸቄስ፣","poem":2},{"lineBreak":true},{"text":"ዱከነ ሀማ ኬሰ ዸጋ አልቡዳ በርባደ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እን ለፈ ነሞትን ጅራተንራ ፈጋቴ","poem":1},{"text":"እዶ ሚል ነማ ኤጄቴ ህንቤክኔት ቦለ ቆተ፤","poem":2},{"lineBreak":true},{"text":"ነሞተራ ፈጋቴ ንረረአ፤ አሲፊ አችስ ንራፈመ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ለፈራ ገሩ ኛተቱ አርገመ፤","poem":1},{"text":"ጀለሼቲንሞ አከ ዋን እብደ ታቴት ጌደረምት፤","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዸጋንሳ ቡርቃ ሰንፔሪት፤","poem":1},{"text":"ብዮንሳስ ወርቄ ቀበ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አላቲን ቶኮዩ ከራ ዾክፈሜ ሰነ ህንቤኩ፤","poem":1},{"text":"እጅ ጩሉሌስ ከራ ሰነ ህንአርግኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ብኔንሶትን ሶዳችሶን እረ ህንኤጄትኔ፤","poem":1},{"text":"ሌንጭስ ከራ ሰነ ህንደርብኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሀርክ ነማ ዸጋ ጀባ ጨብሰ፤","poem":1},{"text":"ሁንዴ ቱሉወኒሞ ንገገረገልቸ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እን ከታ ኬሳን ከራ ባሰ፤","poem":1},{"text":"እጅሳስ ዋን ገቲ ጉዳ ሁንደ አርገ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"መደ ለጌኒ ንሰከተአ፤","poem":1},{"text":"ዋን ዾክፈሜስ እፈት ንባሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ኦጉማን ገሩ ኤሳ አርገምት?","poem":1},{"text":"ሁበትናንስ ኤሰ ጅራተ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ነምን ገቲሳ ህንቤኩ፤","poem":1},{"text":"እን ብየ ጅራቶታ ኬሰት ህንአርገሙ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ቱጁብን፣ “እን ነ ኬሰ ህንጅሩ” ጄዸ፤","poem":1},{"text":"ገላንስ፣ “እን ነ ብረ ህንጅሩ” ጄዸ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ወርቄን ቁልቁሉን እሰ ብቱ ህንደንደኡ፤","poem":1},{"text":"ገቲንሳስ ሜቲዻን ህንመዳለሙ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ወርቄ ኦፊሪት፣ ዸጋ ገቲ ጉዳ ሰርዶንክሲት","poem":1},{"text":"ዮካን ሰንፔሪት ህንትልማመሙ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ወርቄፊ ዸጋን አከ ብልሌ ጨለቅሱ እቲን ህንቅጣቱ፤","poem":1},{"text":"እን ፋየ ወርቄ ቁልቁሉቲን ህንጌደረሙ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ኤሌላኒፊ ዶቅን አከ ዋን ገቲ ቀበኒት ህንሄደመን፤","poem":1},{"text":"ገቲን ኦጉማ ሉለ ዲማ ጫለ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ቶጳዝዮኒን እቶጵያ እት ቅጣቱ፤","poem":1},{"text":"ወርቄ ቁልቁሉዻንስ ብተሙ ህንደንደኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ዮስ ኦጉማን ኤሳ ዹፍትሬ?","poem":1},{"text":"ሁበትናንስ ኤሰ ጅራት?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"እሼን እጀ ኡመመ ሁንዳ ጀላ ዾከቴርት፤","poem":1},{"text":"ስምብሮተ ሰሚ ጀላስ በዴርት።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"በዲስኒፊ ዱት፣ “ኑ ኦዱሼ ቆፈ","poem":1},{"text":"ጉረኬኛን ዸጌኜ” ጄዹ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዋቀ ቆፈቱ ዳንዲ ገረሼ ጌሱ ሁበቴ፣","poem":1},{"text":"ለፈ እን ጅራቱስ ቤከ፤","poem":2}]},{"type":"verse","number":24,"content":[{"text":"እን ሀንዳረ ለፋ ንእላለ፤","poem":1},{"text":"ዋን ሰሚ ጀለ ጅሩ ሁንደ ንአርጋቲ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"እን ዮሙ ቡቤዻፍ ሁምነ ኬኔ","poem":1},{"text":"ብሻኖተ ሰፈሬት፣","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዮሙ ቦካዻፍ ሴረ ዻቤ","poem":1},{"text":"በከካፍሞ ዳንዲ ባሴት፣","poem":2}]},{"type":"verse","number":27,"content":[{"text":"እን ኦጉማ እላሌ መዳሌ፤","poem":1},{"text":"ጀቤሴ ዻቤ እሼ ቆረቴ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ኤርገሲ እልማን ነማቲን፣","poem":1},{"text":"“ጎፍታ ሶዳቹን ኦጉማ፤","poem":2},{"lineBreak":true},{"text":"ዋን ሀማራ ፈጋቹንስ ሁበትናዸ” ጄዼ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}