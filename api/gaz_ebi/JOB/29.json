{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":["እዮብ ሃሳሳ እት ፉፌ አከነ ጄዼ፦"]},{"type":"verse","number":2,"content":[{"text":"“አን ጅኦተ ደርበን፣ በረ ዋቅን ነ ኤጌ ሰነ","poem":1},{"text":"አከምን ሀወ ቱሬ፣","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዬሮ እብሳንሳ መታኮረት እፌ፣ አንስ እፈሳቲን","poem":1},{"text":"ዱከነ ኬሰ ደርቤ ዬሮን ዴሜ፣","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዬሮ አን ነመ ጀባ ቱሬ፣","poem":1},{"text":"ዬሮ ምቹማን ዋቃ መነኮ ኤብሴ፣","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዬሮ ዋቅን ዋን ሁንደ ደንደኡ ነ ወጅን ቱሬ፣","poem":1},{"text":"ዬሮ እጆሌንኮ ናኖኮ ቱረን፣","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዬሮ ዳንዲንኮ ዸዻዻን ጂፈሜ፣","poem":1},{"text":"ዬሮ ከታንስ ለገ ዘይቲ ኤጄርሳ ናፍ ያሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ዬሮ አን ገረ ከረ መጋላት ገድ በኤ","poem":1},{"text":"ኦብዲ ሰባ ኬሰ በርጩመኮረ ታኤ፣","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ደርገጌዪን ነ አርገኒ ከራራ ጎሩ፤","poem":1},{"text":"ማንጉዶትንስ ከአኒ ዻበቱ ቱሬ፤","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሀንገፎትን ሰባ ዱቢ አፋንት ቀበተኒ","poem":1},{"text":"ሀርከሳኒ አፋንረ ካአቱ ቱሬ፤","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሰገሌን ነሞተ ቤቤከሞ ህንዸገአሙ ቱሬ፤","poem":1},{"text":"አረብንሳኒስ ላጋሳኒት ንመጠነ ቱሬ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ነምን ነ ዸገኡ ከምዩ ነ ጀጀ፤","poem":1},{"text":"ከኔን ነ አርገንስ ነ ገለቴፈቱ ቱሬ፤","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አን ህዬሰ ገርጋርሰ በርባቻፍ ቦኡ፣","poem":1},{"text":"ነመ አባ ህንቀብኔ ከን ነምን እሰ ገርጋሩ ቶኮዩ ህንጅሬ ፉሬራቲ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ነምን ዱኡ ገኤ ነ ኤብሴረ፤","poem":1},{"text":"አን አከ ገራን ሃዸ ህዬሳ ገመቹን እልልቹስ ጎዼረ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ቀጄሉማ አከ ኡፈተኮት ኡፈዼረ፤","poem":1},{"text":"ሙርቲን ቀጄላንሞ ኡፈተኮፊ መረተ መታኮ ቱሬ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አን ነመ ጃሜፍ እጀ፣","poem":1},{"text":"ኦኮላፍሞ ሚለ ተኤን ቱሬ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አን ረከታዻፍ አባን ቱሬ፤","poem":1},{"text":"ነመ ኦርማቲፍሌ ነንፈልመን ቱሬ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ቀርፋ ነመ ሀማ ነንጨብሴ፤","poem":1},{"text":"ዋን እን ቀበቴስ አፋንሳቲ ቡሴረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“አን አከነ ጄዼን ያዴ ቱሬ፤ ‘መኑመኮኬሰትን ዱአ፤","poem":1},{"text":"በር ጅሬኘኮቲስ አኩመ ጭረቻ ባይአተ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ህድኮ ገድ ፈጋቴ ብሻን ቀቀበ፤","poem":1},{"text":"ፍጤንስስ ሀልከን ጉቱ ደሜወንኮረ ቡለ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ኡልፍንኮ ነ ኬሰት ሃራ ተኤ ጅራተ፤","poem":1},{"text":"እዳንስ ሀርከኮ ኬሰት ሃሮምፈመ።’","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“ነሞትን ጨልእሰኒ ጎርሰኮ ኤገቻ","poem":1},{"text":"አብዲዻን ነ ዸጌፈቱ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ኤርገ አን ዱበዼ ቦዴ እሳን ዴብአኒ ህንዱበትኔ፤","poem":1},{"text":"ዱቢንኮስ አከ ጋሪት ጉረሳኒ ሴነ ቱሬ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"እሳን አኩመ ነመ ቦካ ኤገቱት ነ ኤገተን፤","poem":1},{"text":"ዱቢኮስ አኩመ ቦካ አርፋሳ ዹገን።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዬሮ አን እሳኒፍ ሴቁት እሳን ህንአመኔ፤","poem":1},{"text":"እፍን ፉለኮስ እሳኒፍ ዋን ጉዳ ቱሬ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"አን ከራ እሳኒፍ ፍሌ አከ ሀንገፈ እሳኒት ነንታኤ፤","poem":1},{"text":"አከ ሞቲ ሎልቶተሳ ግዱ ጅራቱት ነንጅራዼ፤","poem":2},{"lineBreak":true},{"text":"አን አከ ነመ ወረ ቦአን ጀጀቤሱስ ተኤ።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/28.json","previousChapterAudioLinks":{},"numberOfVerses":25}