{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":3,"content":[{"type":"heading","content":["ዱቢ እዮብ"]},{"type":"verse","number":1,"content":["ከነረት እዮብ አፋንሳ በነቴ ጉያ እት ዸለቴ አባሬ።"]},{"type":"verse","number":2,"content":["እንስ አከነ ጄዼ፦"]},{"type":"heading","content":["እዮብ"]},{"type":"verse","number":3,"content":[{"text":"“ጉያን አን እት ዸለዼ ሃበዱ፤","poem":1},{"text":"ሀልከን፣ ‘እልም ዸለቴ!’ ጄዸሜ ሱንስ ሃበዱ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጉያን ሱን ሃዱከናኡ፤","poem":1},{"text":"ዋቅን ኦል ጉባዻ እሰ ህንእላልን፤","poem":2},{"lineBreak":true},{"text":"እፍንስ እት ህንእፍን።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዱከኒፊ ጋድዱን ጉዳን እሰ ሃዻለን፤","poem":1},{"text":"ዱሜስ እሰረ ሃቡኡ፤","poem":2},{"lineBreak":true},{"text":"እፈሳ ዱከን ሃልቅምሱ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሀልከን ሰነ ዱከን ልምጢን ሃቀበቱ፤","poem":1},{"text":"ጉዮተ ወጋ ኬሰ ጅረንትስ ህንደበለምን","poem":2},{"lineBreak":true},{"text":"ዮካን ጅኦተ ከምዩ ኬሰት ህንለካአምን።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሀልከን ሱን ሃመሴኑ፤","poem":1},{"text":"እልሌንስ ኬሰት ህንዸገአምን።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ወር ሌዋታንን ከካሱፍ ቆጳአን፣","poem":1},{"text":"ከኔን ጉዮተ አባረን ጉያ ሰነ ሃአባረን።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"በከልች በሪ ከን ጉያ ሰና ሃዱከናኡ፤","poem":1},{"text":"እፈ ኤገቴ ሃዸቡ፤","poem":2},{"lineBreak":true},{"text":"ቦሩ በቀቁስ ህንአርግን።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እን እጀኮ ዱራ ረክነ ዾክሱፍ፣","poem":1},{"text":"በልበለ ገደሜሰ ሃዸኮቲ ነት ህንጩፍኔቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“አን ማሊፍ ገደሜሰ ሃዸኮቲ ኬሰት ህንበድን?","poem":1},{"text":"ማሊፍስ ዬሩመን ገራ ኬሳ በኤት ህንዱእን?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ጅልበወን ነ ስመተን፣","poem":1},{"text":"ሀርመወን አን ሆዹስ ማሊፍ አችት አርገመን?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አን ስላ ዮነ ነጋን ነንጪሰ፤","poem":1},{"text":"ረፌስ ነንቦቆዸን ቱሬቲ፤","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሞቶታፊ ጎርስቶተ አዱኛ","poem":1},{"text":"ወረ እዶወን አመ ዲገመኒ ጅረን ኦፊሳኒቲፍ ቆጴፈተን ወጅን፣","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ቡልችቶተ ወርቄ ቀበን፣ ከኔን መኔንሳኒ","poem":1},{"text":"ሜቲዻን ጉተተን ወጅን ነንቦቆዸን ቱሬ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዮካን አን ማሊፍን አኩመ ሙጫ ዱኤ ገራ በኤ፣","poem":1},{"text":"አኩመ ዳእመ እፈ ጉያ ህንአርግኒት ህንአዋለምን?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አችትስ ነሞትን ሀሞን ጄቁ ንዺሱ፤","poem":1},{"text":"ደዸቦንስ አችት ንቦቆቱ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ቦጅአምቶትን ነጋዻን ወሊ ወጅን ጅራቱ፤","poem":1},{"text":"ወጨ ጩንቁርስቶተሳኒስ ህንዸገአን።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ጥናፊ ጉዳን አች ጅረ፤","poem":1},{"text":"ገርብችስ ጎፍታሳ ጀላ ብልሶሜረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ማሊፍ ወረ ገደዶ ኬሰ ጅረኒፍ እፍን","poem":1},{"text":"ወረ ሉቡንሳኒ ገድቴፍሞ ጅሬኝ ኬነመ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ወረ ዱአ ሀወኒ ዸበኒፍ","poem":1},{"text":"ወረ ቀቤኘ ዾክፈሜ ጫላ ዱአ በርባደኒፍ","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ወረ ዮሙ አዋለሙ ገአንት","poem":1},{"text":"ገመቹን ጉተመኒ እልልቸኒፍ ጅሬኝ ማሊፍ ኬነመ?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ነመ ከራንሳ ዱራ ዾከቴፍ","poem":1},{"text":"ነመ ዋቅን ደላ እት መርሴ","poem":2},{"lineBreak":true},{"text":"ጅሬኝ ማሊፍ ኬነመ?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ገድ ቡዴነ ና ተኤረ፤","poem":1},{"text":"ኣዱንኮስ አከ ብሻኒ ዸንገለአ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ወን አን ሶዳዼ ነት ዹፌረ፤","poem":1},{"text":"ወን ነ ናስሱስ ነረ ገኤረ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"አን ነጋ ህንቀቡ፤ ተስገቢስ ህንቀቡ፤","poem":1},{"text":"ጄቁምሰ መሌ ቦቆና ህንቀቡ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}