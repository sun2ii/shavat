{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":[{"text":"“አመ ገሩ ወር ኡሙሪዻን ና ገዲ፣","poem":1},{"text":"ከኔን አን አቦቲሳኒ","poem":2},{"text":"ሰሮተ ሆሎተኮ ትክስቱ ወጅንዩ","poem":1},{"text":"መዳሉ ቱፈዼ፣ ኩኖ ነት ቆሱ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ወረ ሁምነ ዸበን፣","poem":1},{"text":"ጀብን እሬሳኒ ማል ነ ፈየደ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እሳን ረክናፊ ቤላን ላፈን፤","poem":1},{"text":"ለፈ ጎጋ ኬሰ፣","poem":2},{"lineBreak":true},{"text":"ገሞጂ ነምን ኬሰ ህንጅራትኔ ኬሰ ሀልከኒን ጆረን።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ደገለ ኬሳ ብቅልቱ ሶግዳ ፉናነተን፤","poem":1},{"text":"ኛትንሳኒስ ህደ ሙካ ከን ህንምኦፍኔ ቱሬ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እሳን ነሞተ ግዱዻ አርአመን፤","poem":1},{"text":"ነሞትንስ አኩመ ዋን ሀቱት እየኒት እት እየን።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እሳን አከ ለገ ጎጋ ኬሰ፣","poem":1},{"text":"ከታ ግዱፊ ቦለ ለፋ ኬሰ ጅራተኒፍ ድርቀመመን።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ቦሶነ ኬሰት ንሀላኩ፤","poem":1},{"text":"ደገለ ኬሰትስ ወልት ቱተኡ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እሳን ጎዎተ መቃ ህንቀብኔ፣","poem":1},{"text":"ከኔን ብያ አርአመን ቱረን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“አመ እልማንሳኒ ስርበ ነት ባፈተን፤","poem":1},{"text":"አን እሳን ግዱት ዋን ኮልፋ ተኤረ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እሳን ጥሬፈተኒ ነራ ፈጋተን፤","poem":1},{"text":"ፉለኮት ቱፉራስ ዱበት ህንዴብአን።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሰበቢ ዋቅን እዳኮ ላፍሴ ገድ ነ ዴብሴፍ፣","poem":1},{"text":"እሳን ፉለኮ ዱረት ሉገመ ባፈተን።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ከራ ምርገኮቲን አደጌወን ከአኒሩ፤","poem":1},{"text":"ሚለኮቲፍ ክዮ ካአኒሩ፤","poem":2},{"lineBreak":true},{"text":"ብዮስ አከ ደላ ነት ናኔሰን።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እሳን ከራኮ ነት ጩፉ፤","poem":1},{"text":"ነ ገላፈቹፍስ ንምልካኡ፤","poem":2},{"lineBreak":true},{"text":"ነምን እሳን ዾዉ ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አኩመ ነመ ቃወ በልኣን ዹፉት፣","poem":1},{"text":"ኦነ ዲገማ ኬሰ ገንገለቻ ነት ዹፉ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሶዳን ነ ልቅምሴረ፤ ኡልፍንኮ አኩመ ዋን","poem":1},{"text":"ቡቤዻን ፉዸተሙት ነራ ፉዸተሜረ፤","poem":2},{"lineBreak":true},{"text":"በዻዹማንኮስ አኩመ ዱሜሳ በደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“አመ ሉቡንኮ ነ ኬሰት ዹምቴርት፤","poem":1},{"text":"በር ረክናስ ነ ቀበቴረ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሀልከን ኬሰ ለፌንኮ ንወራነመ፤","poem":1},{"text":"ዹኩቢን ነ ኛቱስ ነት ህንፉሩ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዋቅን ሁምነ ጀባዻን ኡፈተኮ ቀቤረ፤","poem":1},{"text":"አኩመ ሞርመ ወያኮት ሁዼ ነ ቀቤረ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እን ደርበቴ ዾቄ ኬሰ ነ ቡሰ፤","poem":1},{"text":"አንስ አኩመ ብዮፊ ዳራ ተኤረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ያ ዋቅ፣ አን ስት ነንእየዸ፤ አት ገሩ ዴቢ ና ህንኬንቱ፤","poem":1},{"text":"አን ነንዻበዸ፤ አት ገሩ ጨልእስቴ ነ እላልተ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አት ገረ ጀብናን ነት ገረገልተ፤","poem":1},{"text":"እሬኬ ጀባዻንስ ነ ዾፍተ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ኦል ነ ቡቴ ፉለ ቡቤ ዱረ ነ ኦፍተ፤","poem":1},{"text":"ቡቤ ሀማ ኬሰስ አሲፊ አች ነ ኣተ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"አን አከ አት ገረ ዱኣት፣","poem":1},{"text":"ገረ መነ ወረ ሉቡን ጅራተን ሁንዳፍ ረመደሜትነ ጌስቱ ነንቤከ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“ዹጉመዩ ዬሮ እን ረከቴ ገርጋርሰ በርባቻፍ እዩት፣","poem":1},{"text":"ነምን ሀርከሳ እሰረ ካኡ ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"አን ወረ ረክነ ኬሰ ጅረኒፍ ህንቦኜ?","poem":1},{"text":"ሉቡንኮስ ህዬዪፍ ህንገድኔ?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ገሩ ኡቱ አን ዋን ጋሪ አብደዹ፣ ወን ሀማን ነት ዹፌ፤","poem":1},{"text":"ኡቱ አን እፈ ኤገዹስ፣ ዱከን ነት ዹፌ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ኬስኮ ጄቀማ ጅረ፤ ጎንኩማ ህንቀበኖፍኔ፤","poem":1},{"text":"በር ግድራስ ነት ዹፌረ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"አን ጀጀብነ ዸቤ አሲፊ አች ዴሜ ነንቦአ፤","poem":1},{"text":"ወልዳ ኬሰ ዻበዼስ ገርጋርሳፍ ነንእየ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"አን ኦቦሌሰ ዋንጎ፣","poem":1},{"text":"ምቹ ኡሩንጉስ ተኤረ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ጎጋንኮ ጉራቸኤ ቆልራ ከኤረ፤","poem":1},{"text":"ዸግንኮስ ሆኣን ቦበኤረ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"በገናንኮ ቦእቻፍ፣ ኡሉሌንኮሞ","poem":1},{"text":"ሰገሌ እያቲፍ ቆጴፈሜረ።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/29.json","previousChapterAudioLinks":{},"numberOfVerses":31}