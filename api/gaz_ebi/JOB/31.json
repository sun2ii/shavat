{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":[{"text":"“አን እጀኮ ወጅን ከኩ ገሌረ፤","poem":1},{"text":"ዮስ አን አከሚን ሀዊዻን ገረ ዱርባ እላለሬ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ጨራን ነምን ዋቀ ሰሚ ብራ ቀቡ፣","poem":1},{"text":"ዻል እን ዋቀ ዋን ሁንደ ደንደኡራ አርገቱ ማል?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሀሞታፍ በዲሰ፣","poem":1},{"text":"ወረ ጀልእነ ሆጄተኒፍሞ ዸእቸ ምቲ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እን ከራኮ ህንአርጉ?","poem":1},{"text":"ተርካንፊኮ ሁንደስ ህንለካኡ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ዮ አን ከራ ሶባረ ዴሜ","poem":1},{"text":"ዮካን ሚልኮ ገረ ጎዎምሳት አሪፈቴ ጅራቴ፣","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዋቅን መዳሊ ዹጋቲን ነ ሃመዳሉ፤","poem":1},{"text":"አከ አን ህርእነ ህንቀብኔሌ ሃቤኩ፤","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዮ ተርካንፊንኮ ከራራ ጎሬ፣","poem":1},{"text":"ገራንኮ ዋን እጅኮ አርጉ ዱካ ቡኤ ጅራቴ","poem":2},{"lineBreak":true},{"text":"ዮካን ዮ ሀርክኮ ጡራኤ ጅራቴ፣","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዋን አን ፈጫፈዼ ነምን ብራ ሃኛቱ፤","poem":1},{"text":"ምዻንኮስ ሃቡቅፈሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ዮ ገራንኮ ዱበርቲዻን ጎዎምፈሜ ጅራቴ፣","poem":1},{"text":"ዮካን ዮ አን በልበለ ኦላኮ ጀለት ርጴ ኤገዼ፣","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኒቲንኮ ምዻን ነመ ብራ ሃዳክቱ፤","poem":1},{"text":"ነሞትን ብራስ እሼ ወጅን ሃጪሰን።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኩን ሀምነ፤","poem":1},{"text":"ከን አባ ሙርቲቲንስ አደበሙ ቀቡዸ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኩን እብደ ሀመ በርበዴሱት ዋ ጉቡዸ፤","poem":1},{"text":"ምዻን አን ቀቡ ሁንደስ ጉቤ በሌሰ ቱሬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ዮ አን ዬሮ እሳን ነ ህመተንት፣","poem":1},{"text":"ተጃጅልቶተኮ ዺራፊ ዱበርቲ","poem":2},{"lineBreak":true},{"text":"ሙርቲ ቀጄላ ዾወዼ ጅራዼ፣","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዬሮ ዋቅን ከኡት አን ማለን ጎዸ?","poem":1},{"text":"ዮ እን ነ ጋፈቴስ አን ማለን ዴብሰ?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እሱመ ገደሜሰ ኬሰት ነ ኡሜ ሰነቱ እሳን ኡሜ ምቲ?","poem":1},{"text":"ከን ሁንደኬኘ ገደሜሰ ኬሰት ቶልቼስ እሱመ ምቲ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“ዮ አን ዋን ህዬሳፍ በርባችሱ ዾወዼ ጅራዼ፣","poem":1},{"text":"ዮካን ዮ አን አከ እጅ ሃዸ ህዬሳ ደዸቡ ጎዼ ጅራዼ፣","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዮ አን ቡዴነኮ ኡቱ እልመ አባ ህንቀብኔፍ ህንቆድን","poem":1},{"text":"ኮጳኮ ኛዼ ጅራዼ፣","poem":2}]},{"type":"verse","number":18,"content":[{"text":"አን ገሩ ደርገጉማኮቲ ጀልቀቤ አኩመ አባን እሰ ጉድሴ፤","poem":1},{"text":"ዸሎተኮቲ ጀልቀቤስ ሃዸ ህዬሳ ከራ አርግሲሴ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አን ዮን ኡቱ ነምን ቶኮ ወያ ዸቤ አከ መሌ ሚዸሙ፣","poem":1},{"text":"ዮካን ረከታ ኡፈተ ኦፍራ ህንቀብኔ ቶኮ አርጌ","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ሰበቢ አን ርፌንሰ ሆሎተኮቲን እሰ ሆእሴፍ፣","poem":1},{"text":"ዮ ገራንሳ ነ ህንኤብስን፣","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዮ አን መነ ሙርቲት ፉዸተመ ቀበ ጄዼ","poem":1},{"text":"እጆሌ አባ ህንቀብኔት ሀርከኮ ኦል ካሴ ጅራዼ፣","poem":2}]},{"type":"verse","number":22,"content":[{"text":"እሬንኮ ገቲቲኮራ ሃቡቀኡ፤","poem":1},{"text":"እሬንኮ ቡሳሳት ሃጨቡ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"አን ሰበቢን ዸእቸ ዋቃ ሶዳዼፊ","poem":1},{"text":"ሰበቢን ሱራሳ ከበጄፍ ዋን አከና ሆጄቹ ህንደንዴኜ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“ዮ አን ወርቄ አብደዼ ዮካን ወርቄ ቁልቁሉዻን፣","poem":1},{"text":"‘አት እርኮኮት’ ጄዼ ጅራዼ፣","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዮ አን ቀቤኘኮ ጉዳት፣","poem":1},{"text":"ምልካእነ ሀርክኮ አርገቴት ገመዴ ጅራዼ፣","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዮ አን አዱ እፍቱ አርጌ","poem":1},{"text":"ዮካን ጅአ ሚዸግናን ዴሙ እላሌ ከበጄ፣","poem":2}]},{"type":"verse","number":27,"content":[{"text":"አከሲንስ ገራንኮ ዾክሳን ጎዎምፈሜ","poem":1},{"text":"አፋንኮ ሀርከኮ ዹንገቴ ጅራቴ፣","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ወን ኩን ጩቡ አደበሙ ቀቡዸ፤","poem":1},{"text":"አን ዋቀ ሰሚቲፍ ህንአመነምኔ ቱሬቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“ዮ አን በዲሰ ዲነኮቲት ገመዴ","poem":1},{"text":"ዮካን ረክነ እሰረ ገኤፍ እልልቼ ጅራዼ፣","poem":2}]},{"type":"verse","number":30,"content":[{"text":"አን ጅሬኘሳ አባሩዻን","poem":1},{"text":"አከ አፋንኮ ጩቡ ሆጄቱ ህንኤየምኔ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ዮ ነሞትን መነኮ ጅራተን፣","poem":1},{"text":"ተኩማ፣ ‘ኤኙቱ ቡዴነ መነ እዮብ ኛቴ ህንቁፍን?’ ህንጄዽን፣","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ሰበቢ መንኮ ከራ ዴምቱፍ በና ቱሬፍ፣","poem":1},{"text":"ኬሱማን ከምዩ አለ ህንቡሉ ቱሬ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ዮ አን አኩመ ነሞትን ጎዸን ሰነ በሌሳኮ ገራት ቀበዼ","poem":1},{"text":"ጩቡኮስ ዾክፈዼ ጅራዼ፣","poem":2}]},{"type":"verse","number":34,"content":[{"text":"አን ወልዳ ጉዳ ሶዳዼ","poem":1},{"text":"ዮካን ቱፊን ጎሳ ነ ናስሴ፣","poem":2},{"lineBreak":true},{"text":"ጨልእሴ ገድ በኡ ዺሴራ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"“ማሎ አን ኡቱ ነመ ነ ዸገኡ አርገዼ!","poem":1},{"text":"አን መለቶ ፈልሚኮ ነንመለቴሰ፤","poem":2},{"text":"ዋቅን ዋን ሁንደ ደንደኡ ዴቢ ናፍ ሃኬኑ፤","poem":1},{"text":"ህመታንኮ ዱቢሳ በሬፈማን ሃዽኤፈቱ።","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ዹጉማን አን ገቲቲኮረት ዋን ከነ ነንባዸ፤","poem":1},{"text":"አከ ጎንፎትስ መታረ ነንካአዸን ቱሬ።","poem":2}]},{"type":"verse","number":37,"content":[{"text":"ቶኮ ቶኮ ተርካንፊኮ እሰት ነንህመ፤","poem":1},{"text":"አኩመ እልመ ሞቲትስ እሰት ነንዽኣዸን ቱሬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"“ዮ ለፍትኮ ነት እይቴ","poem":1},{"text":"ቦኦንሼ ሁንድኑ እምማኒን ጂዼ፣","poem":2}]},{"type":"verse","number":39,"content":[{"text":"ዮ አን ከፈልቲ መሌ ምዻንሼ ኛዼ፣","poem":1},{"text":"ዮካን አከ ሆጄቶትንሳ ሉቡሳኒ ዸበን ጎዼ ጅራዼ፣","poem":2}]},{"type":"verse","number":40,"content":[{"text":"ቆደ ቀመዲ ቆራቲን፣","poem":1},{"text":"ቆደ ገርቡስ አረማን እት ሃብቅሉ።”","poem":2},"ዱቢን እዮብ ጡሙረሜ።"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}