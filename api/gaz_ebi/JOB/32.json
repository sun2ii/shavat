{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":32,"content":[{"type":"heading","content":["ኤሊሁ"]},{"type":"verse","number":1,"content":["ሰበቢ እዮብ ነመ ቀጄላ ኦፍ ሴኤፍ ነሞትን ሰደን ኩኔን ዴቢ ኬኑፊ ዺሰን።"]},{"type":"verse","number":2,"content":["ኤሊሁን እልም በረኬል ቡዝች ማቲን ራሚ ሱን ገሩ ሰበቢ እዮብ ቆደ ዋቃ ቀጄላ ኦፍ ጎዼፍ አከ መሌ እት ኣሬ።"]},{"type":"verse","number":3,"content":["አከሱመስ ሰበቢ እሳን እዮብት ሙሩ መሌ ዴቢ ህንቀባትኒፍ ኤሊሁን ምቾተ እዮብ ሰደንት አከ መሌ ኣሬ።"]},{"type":"verse","number":4,"content":["ኤሊሁን ዋን ነሞትን ሱን ኡሙሪዻን እሰ ጫለኒፍ ኡቱ ዱርሴ እዮብት ህንዱበትን ቱሬ።"]},{"type":"verse","number":5,"content":["ገሩ ዬሮ አከ ነሞትን ሱን ሰደን ዋን ዱበተን ዸበን አርጌት ኣሪንሳ እቱመ ጫሌ።"]},{"type":"verse","number":6,"content":["ከናፉ ኤሊሁን እልም በረኬል ቡዝቻ ሱን አከነ ጄዼ፦",{"text":"“አን ኡሙሪዻን ጥናዸ፤","poem":1},{"text":"እስን ገሩ ጃርሶሊዸ፤","poem":2},{"text":"ከናፉ አን ያደኮ እስንት ህሙ","poem":1},{"text":"ነንሳልፈዼ፤ ነንሶዳዼስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አን፣ ‘ኡምሪን ንዱበተ፤","poem":1},{"text":"በር ዼራንስ ኦጉማ በርሲሰ’ ጄዼ ያዴን ቱሬ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ገሩ ሀፉረ ነመ ኬሰ ጅሩ፣","poem":1},{"text":"ሀፉረ ዋቅን ዋን ሁንደ ደንደኡ እት ባፈቱቱ ሁበትና ኬናፍ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኦጌስ ጃርሰ ቆፈ ምት፤","poem":1},{"text":"ከን ዋን ቀጄላ ሁበቱስ፣ ነመ ኡሙሪ ዼራ ቆፈ ምት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ከናፉ አን አከነ ነንጄዻ ነ ዸጌፈዻ፤","poem":1},{"text":"አንስ ዋነን ቤኩ እስንት ነንህመ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አን ዬሮ እስን ዱበተን ነንኦብሴ፤","poem":1},{"text":"ዬሮ እስን ጄቾተ ፍለተንትሌ","poem":2},{"text":"አን ዱቢ ኦጉማ ከን እስን ዱበተን ነንዸጌፈዼ፤","poem":1}]},{"type":"verse","number":12,"content":[{"text":"አን ቀልቤፈዼን እስን ዸገኤ።","poem":2},{"text":"ገሩ እስን ኬሳ ነምን ቶኮዩ አከ እን ዶጎጎሬእዮብን ህንአመንሲፍኔ፤","poem":1},{"text":"ነምን ቶኮዩ ፈልሚሳቲፍ ዴቢ ህንኬንኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እስን፣ ‘ኑ ኦጉማ አርገኔረ፤","poem":1},{"text":"ነመ ኡቱ ህንተእን፣ ዋቅን እሰረ ሃኣኑ’ ህንጄዽና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እዮብ ገሩ ዱቢሳቲን ነ ህንቱቅኔ፤","poem":1},{"text":"አንስ ፈልሚኬሰኒን ዴቢ እሳፍ ህንኬኑ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“እሳን አብዲ ኩተተኒ ዋን ጄዸን ዸበን፤","poem":1},{"text":"ዱቢንስ እሳን ሀርካ በዴ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኤርገ እሳን ጨልእሰኒ፣","poem":1},{"text":"ኤርገ እሳን ዴቢ ኬነን ቶኮሌ ዸበኒ አች ዸዻበተኒ፣አን ኤጉን ቀባ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አን ዴቢኮ ነንኬነ፤","poem":1},{"text":"ዋነን ቤኩ ነንህመ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዱቢን ነ ኬሰ ጉቴራቲ፤","poem":1},{"text":"ሀፉር ነ ኬሰ ጅሩስ ነ ከካሰ፤","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ገራንኮ አኩመ ዳዺ ወይኒ ከን ቀዳደሜ፣","poem":1},{"text":"አኩመ ቀልቀሎ ዳዺ ወይኒ ሃራ ዾኡን ገኤቲ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አን ዱበዼ ቀበኔፈቹን ቀበ፤","poem":1},{"text":"አፋንኮ በነዼስ ዴቢ ኬኑን ቀበ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አን ነመ ወል ህንጫልችሱ፤","poem":1},{"text":"ዮካን ነመ ቶኮዩ ህንሳዱ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ኡቱ አን ነመ ሳዱ ቤኬ፣","poem":1},{"text":"ኡማንኮ ስላ ደፌ ለፈራ ነ በሌሰ ቱሬ።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/31.json","previousChapterAudioLinks":{},"numberOfVerses":22}