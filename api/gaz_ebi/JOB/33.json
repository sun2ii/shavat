{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"“ያ እዮብ አመ ገሩ አት ዱቢኮ ዸጌፈዹ፤","poem":1},{"text":"ዋን አን ጄዹ ሁንደስ ዸገእ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ኩኖ አን አፋንኮ ነንበነዸ፤","poem":1},{"text":"ዱቢንኮስ ፊጤ አረበኮቲረ ጅረ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዱቢንኮ ገራ ቀጄላ ኬሳ በአ፤","poem":1},{"text":"ህዺንኮስ ዋን አን ቤኩ እፈት ባሴ ዱበተ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሀፉረ ዋቃቱ ነ ኡሜ፤","poem":1},{"text":"ሀፉር ዋቅን ዋን ሁንደ ደንደኡ ባፈቱስ ጅሬኘ ና ኬነ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኤጋ ዮ ደንዴሴ ዴቢ ና ኬን፤","poem":1},{"text":"ቆጳኢቲ ፉለኮ ዱረ ዻበዹ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አን ፉለ ዋቃ ዱረት ነሙመ አከኬቲት፤","poem":1},{"text":"አንስ ብዮ እራን ሆጄተሜ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አት ነ ሶዳቴ ህንራፈምን፤","poem":1},{"text":"ሀርክኮስ ስት ህንኡልፋትን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ዹጉማን አት ኡቱመ አን ዸገኡ ዱበቴርተ፤","poem":1},{"text":"አንስ ዱቢኬ ዸገኤረ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አት አከነ ጄተ፦ ‘አን ቁልቁሉዸ፤ ጩቡሌ ህንቀቡ፤","poem":1},{"text":"አን በሌሳ ህንቀቡ፤ የከሌ ህንሆጄትኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዋቅን ገሩ በሌሳ ነረት አርጌረ፤","poem":1},{"text":"አከ ዲነ እሳትስ ነ እላሌረ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሚለኮ ጉዴልቸ ግዱ ገልቼ ህዸ፤","poem":1},{"text":"ከራኮ ሁንደስ ንኤገ።’","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ገሩ አን ስት ነንህመ፤ ከነረት አት ቀጄላ ምት፤","poem":1},{"text":"ዋቅን ነመ ጫላ ጉዳዻቲ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አት ማሊፍ አከ ዋን እን","poem":1},{"text":"ዱቢ ነማቲፍ ዴቢ ህንኬንኔት እሰት ጉንጉምተ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ነምን ሁበቹ ባቱዩ፣","poem":1},{"text":"ዋቅን ከራ ቶኮንስ፣ ከራ ብራቲንስ ንዱበተ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እን ኡቱመ እሳን ስሬሳኒረ ጪሰኑ፣","poem":1},{"text":"ዬሮ ህርብን ጭማን እሳን ቀቡት፣","poem":2},{"lineBreak":true},{"text":"አብጁዻን፣ ሙልአተ ሀልከኒቲንስ፣","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ጉረሳኒት ንዱበተ፤","poem":1},{"text":"ኦፍ ኤገቺሳንስ እሳን ርፈቺሰ፤","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ጀልእነራ ነመ ዴብሱፍ፣","poem":1},{"text":"ኦፍ ጀጁራስ እሰ ዾዉፍ፣","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሉቡሳ ቦለራ፣","poem":1},{"text":"ጅሬኘሳስ ጎራዴዻን በዱራ ኦልቹዻፍ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“ነምን ቶኮ ዽጵነ ለፌሳ ኬሳ","poem":1},{"text":"ከን ገርገር ህንጭኔን፣ ስሬ ዽጵናረት ንአደበመ ተአ፤","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ከናፉ ጅሬኝሳ ኛተ ጅበ፤","poem":1},{"text":"ሉቡንሳስ ኛተ ፍለተማ በልፍት።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ፎንሳ ኛተሜ ዹመ፤","poem":1},{"text":"ለፌንሳ ከን ዱራን ዾከቴ ቱሬ ሱን አለት ያአ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ሉቡንሳ ገረ ቦላት፣","poem":1},{"text":"ጅሬኝሳስ ኤርገሞተ ዱኣት ዽኣተ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ተኡስ ዮ ኩመ ኬሳ ኤርገማን ዋቀዮ ቶኮ","poem":1},{"text":"አከ እት ቀጄላ ተአን እሳንት ህሙፍ፣","poem":2},{"lineBreak":true},{"text":"ኤርገማን ዋቃሳኒ ዻበቴ ጅራቴ፣","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዮ ነምቻፍ ገራ ላፌ ‘ቦለ ቡኡራ እሰ ኦልቼ፤","poem":1},{"text":"አን ፉሪ እሳፍ አርጌን ጅረ’ ጄዼ፣","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዸግንሳ አኩመ ዸግነ ዳእማት ሃሮምፈመ፤","poem":1},{"text":"አከ በረ ደርገጉማ እሳትስ ንዴብአ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"እን ዋቀ ንከዸተ፤ እሰ ብረትስ ፉዸተመ አርገተ፤","poem":1},{"text":"ፉለ ዋቃ ንአርገ፤ ንእልልቸስ፤","poem":2},{"lineBreak":true},{"text":"ዋቅንስ ገረ ቀጄሉማሳ ከን ዱሪት እሰ ንዴብሰ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ኤርገሲስ ገረ ነሞታ ዹፌ አከነ ጄዸ፤","poem":1},{"text":"‘አን ጩቡ ሆጄዼረ፤ ዋን ቀጄላስ ጀልእሴረ፤","poem":2},{"lineBreak":true},{"text":"ገሩ ዋን ና መሉ ህንአርገኔ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"እን አከ እሼን ቦለ ህንቡኔፍ ሉቡኮ ፉሬረ፤","poem":1},{"text":"አንስ ጅራዼ እፈ ነንአርገ።’","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“ዋቅን ዋን ከነ ሁንደ","poem":1},{"text":"ዬሮ ለመ፣ ዬሮ ሰዲዩ ነማፍ ንጎዸ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ከነስ አከ እፍን ጅሬኛ እሳፍ እፉፍ፣","poem":1},{"text":"ሉቡሳስ ቦለራ ዴብሱፍ ጎዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“ያ እዮብ ቀልቤፈዹቲ ነ ዸጌፈዹ፤","poem":1},{"text":"አት ጨልእስ፤ አን ነንዱበዻ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ዮ ዋን ጄቱ ቶኮሌ ቀባቴ ዴቢ ና ኬን፤","poem":1},{"text":"ዱበዹ፣ አን አከ አት ቀጄላ ታቴ ምርከኔሱ ነንበርባዳቲ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ዮ አከስ ተኡ ባቴ ገሩ ነ ዸጌፈዹ፤","poem":1},{"text":"ጨልእስ፣ አንስ ኦጉማ ስን በርሲሳ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/32.json","previousChapterAudioLinks":{},"numberOfVerses":33}