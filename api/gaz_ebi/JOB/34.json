{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":34,"content":[{"type":"verse","number":1,"content":["ኤሊሁን አከነ ጄዼ፦"]},{"type":"verse","number":2,"content":[{"text":"“ያ ኦጌዪ፣ ዱቢኮ ዸገኣ፤","poem":1},{"text":"ቤክቶትንስ ነ ዸጌፈዻ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አኩመ አረብን ኛተ አፋኒን ቀቡ፣","poem":1},{"text":"ጉርስ ዱቢ ጨለላቲ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዋን ቀጄላ ተኤ ኦፊኬኛፍ ሃፍለትኑ፤","poem":1},{"text":"ዋን ጋሪስ ቶኩማዻን ሃበረትኑ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“እዮብ አከነ ጄዸ፤ ‘አን ቀጄላዸ፤","poem":1},{"text":"ዋቅን ገሩ ሙርቲ ቀጄላ ነራ ፉዸቴ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አን ኡቱመን ነመ ዹጋ ተኤ ጅሩ፣","poem":1},{"text":"አከ ሶብዱን ሄሬገሜ፤","poem":2},{"text":"አን የከ ቀባቹ ባዹሌ","poem":1},{"text":"ጥይሳ መዳ ህንፈይኔን ነ መዴሴረ።’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ነምን አከ ብሻኒት ቱፊ ዹጉ፣","poem":1},{"text":"ከን አከ እዮብ ኤኙ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እን ወረ ሀምነ ሆጄቱ ወጅን ወሊ ገለ፤","poem":1},{"text":"ጀልኦተ ወጅንስ ቶኩማ ቀባተ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እን፣ ‘ዋቀ ገመቺሱ ያሉን፣","poem":1},{"text":"ነማፍ ፋይዳ ቶኮዩ ህንቀቡ’ ጄዻቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ከናፉ እስን ያ ሁበቶተ፣ ነ ዸገኣ።","poem":1},{"text":"ዋን ሀማ ሆጄቹን ዋቀራ፣","poem":2},{"lineBreak":true},{"text":"ዶጎጎሩንስ ዋቀ ዋን ሁንደ ደንደኡራ ሃፈጋቱ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እን ነማፍ አኩመ ሆጂሳት ገቲ ንኬነ፤","poem":1},{"text":"ዋን ከራሳቲፍ መሉስ እት ፍደ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዹጉማን ዋቅን ሀምነ ህንሆጄቱ፤","poem":1},{"text":"ዋቅን ዋን ሁንደ ደንደኡ ሙርቲ ቀጄላ ህንጀልእሱ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኤኙቱ ለፈረት እሰ ሙዴ?","poem":1},{"text":"ኤኙቱስ አዱኛ ጉቱ እሰት ኬኔ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኡቱ እን ሀፉረሳ ዴብሴ ፉዸቴ፣","poem":1},{"text":"ሀፉረ ባፈቱሌ ገረ ኦፊሳት ዴብፈቴ፣","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ስላ ሰኚን ነማ ሁንድ ወሉማን በደ፤","poem":1},{"text":"ነምንስ ብዮት ዴብአ ቱሬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“አት ዮ ሁበትና ቀባቴ ዋን ከነ ዸገእ፤","poem":1},{"text":"ዋን አን ጄዹስ ዸጌፈዹ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ነምን ሙርቲ ቀጄላ ጅቡ ቡልቹ ደንደኣ?","poem":1},{"text":"አትስ እሰ ቀጄላፊ ሁምነ ቀቤሰ ሰነት ሙርታ?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ከን ሞቶታን፣ ‘እስን ፋይዳ ህንቀብደን፤’ ጄዼ","poem":1},{"text":"ቆንዳልቶታንስ፣ ‘እስን ሀሞዸ’ ጄዹ እሰ ምቲ?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እን እልማን ሞቶታቲፍሌ ህንሎጉ፤","poem":1},{"text":"ሶሬዪፊ ህዬዪ ወል ህንጫልችሱ፤","poem":2},{"lineBreak":true},{"text":"ሁንድሳኒ ሆጂ ሀርከሳቲ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እሳን ሀልከን ወለካ ተሰ ዱኡ፤","poem":1},{"text":"ነሞትን ሆለተኒ ዹሙ፤","poem":2},{"lineBreak":true},{"text":"ጀጀቦንስ ኡቱመ ሀርክ ነማ እሳን ህንቱቅን ንበዱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“እጅሳ ከራ ነሞታረ ጅረ፤","poem":1},{"text":"እን ተርካንፊሳኒ ሁንደ ንአርገ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"እዶን ወር ዋን ሀማ ሆጄተን እት ዾከተን፣","poem":1},{"text":"ዱከን ዮካን ጋድስን ጉዳን ህንጅሩ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"አከ እን ሙርቲዻፍ ፉለሳ ዱረት ዽኣቱፍ፣","poem":1},{"text":"ዋቅን ነመ ከምዩ ህንቤለሙ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"እን ጋፊ ቶኮ መሌ ነሞተ ጀጀቦ ንቡርኩቴሰ፤","poem":1},{"text":"ወረ ብራሞ እዶሳኒ ንካአ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"እን ሰበቢ ሆጂሳኒ ቤኩፍ፣","poem":1},{"text":"ሀልከን ኬሰ እሳን ገረ ገልቸ፤ እሳንስ ንበርበዳኡ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ሰበቢ ጀልእነሳኒቲፍስ","poem":1},{"text":"እን እዶ ነምን ሁንድ አርጉት እሳን አደበ፤","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ኩንስ ዋን እሳን እሰ ዱካ ቡኡራ ገረ ገለኒ","poem":1},{"text":"ከራሳ ሁንደ ዺሰኒፍ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"እሳን አከ እን እየ ረከቶታ ዸገኡፍ፣","poem":1},{"text":"አከ እይ ህዬዪ ፉለሳ ዱረት ዸገአሙ ጎዸኒሩ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ዮ እን ጨልእሴ ገሩ፣ ኤኙቱ እሰት ሙሩ ደንደአ?","poem":1},{"text":"ዮ እን ፉለሳ ዾክፈቴስ ኤኙቱ እሰ አርጉ ደንደአ?","poem":2},{"text":"ተኡስ እን ነማፊ ሰበሌ ንቶአተ፤","poem":1}]},{"type":"verse","number":30,"content":[{"text":"ኩንስ አከ ነምን ዋቃፍ ህንቡሌ","poem":2},{"lineBreak":true},{"text":"ሞቲ ህንታኔፊ አከ እሳን ሰባፍ ክዮ ህንኬኜፊዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“ነምን ቶኮ ዋቃን አከነ ጄዸ ሃጄኑ፤","poem":1},{"text":"‘አን የከ ሆጄዼረ፤ ገሩ እት ህንዴብኡ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ዋን አን አርጉ ህንደንዴኜ ነ በርሲስ፤","poem":1},{"text":"አን ዮን ዶጎጎረ ሆጄዼ ጅራዼ፣ ለመተ እት ህንዴብኡ።’","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ዋቅን ሰበቢ አት ቀልቢ ጅጂረቹ ድዱፍ","poem":1},{"text":"አኩመ ያደኬቲት ገቲ ሲፍ ባሳ?","poem":2},{"text":"ስቱ ሙርቴሱ ቀበ መሌ አነ ምት፤","poem":1},{"text":"ከናፉ አት ዋን ቤክቱ ነት ህም።","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“ነሞትን ሁበትና ቀበን ንዱበቱ፤","poem":1},{"text":"ነሞትን ኦጌዪን ነ ዸገአንስ አከነ ጄዹ፤","poem":2}]},{"type":"verse","number":35,"content":[{"text":"‘እዮብ ቤኩምሰ መሌ ዱበተ፤","poem":1},{"text":"ዱቢንሳስ ሁበትና ጭማ ህንቀቡ።’","poem":2}]},{"type":"verse","number":36,"content":[{"text":"እዮብ ሰበቢ አከ ነመ ሀማት ዴቢ ኬኔፍ","poem":1},{"text":"ማሎ ኡቱ ሀመ ዹማት ቆረሜ ጅራቴ!","poem":2}]},{"type":"verse","number":37,"content":[{"text":"እን ጩቡሳረት ፍንጭለ ደበለ፤","poem":1},{"text":"ቱፊዻን ግዱኬኘት ሀርከ ዸአ፤","poem":2},{"lineBreak":true},{"text":"ዋቀረትስ ዋን ባይኤ ዱበተ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/33.json","previousChapterAudioLinks":{},"numberOfVerses":37}