{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":["ኤሊሁንስ እት ፉፌ አከነ ጄዼ፦"]},{"type":"verse","number":2,"content":[{"text":"“አት ዋን ከነ ቀጄላ ሴታ?","poem":1},{"text":"አት፣ ‘አን ፉለ ዋቃ ዱረት ቀጄላዸ’ ጄተ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አት፣ ‘ወን ኩን ፋይዳ ማሊ ና ቀበ?","poem":1},{"text":"አን ጩቡ ሆጄቹ ዺሱዻን ማልን አርገዸ?’ ጄቴ ጋፈተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“አን ስኢፊ ምቾተኬ ከኔን ስ ወጅን ጅረኒፍ","poem":1},{"text":"ዴቢ ኬኑ ነንበርባደ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኦል ጄዺቲ ሰሚወን እላል፤","poem":1},{"text":"ዱሜሶተ ሲን ኦል ጅረንስ አርግ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አት ዮ ጩቡ ሆጄቴ ማል እሰ ሚተ?","poem":1},{"text":"ጩቡንኬስ ዮ ባይአቴ ማል እሰ ጎዸ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አት ዮ ቀጄላ ታቴ፣ ማል እሳፍ ኬንተ?","poem":1},{"text":"ዮካን እን ሀርከኬራ ማል አርገተ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሀምንኬ ነመ አከኬቲ ቆፈ ሚዸ፤","poem":1},{"text":"ቀጄሉማንኬስ እልማን ነማ ቆፈ ፈየደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ዋን ጩንቁርሳን እት ሀማቴፍ ነሞትን ንእዩ፤","poem":1},{"text":"እሬ ሁምነ ቀቤሳ ጀላ በኡፍስ ገርጋርሳፍ ወዋቱ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ገሩ ነምን ቶኮዩ አከነ ህንጄዹ፤","poem":1},{"text":"‘ዋቅን ኡማንኮ፣ እን ሀልከኒን ፋርፈትና ነማ ኬኑ፣","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ከን ብኔንሶተ ለፈራ ጫላ ቤክቶተ፣","poem":1},{"text":"ስምብሮ ሰሚ ጫላስ ኦጌዪ ኑ ጎዹ ኤሰ ጅረ?’","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እን ሰበቢ ኦፍ ቱሉማ ጀልኦታቲፍ","poem":1},{"text":"ዮሙ ነሞትን እየንት ዴቢ ህንኬኑ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዹጉማን ዋቅን እየሳኒ ከን ገቲ ህንቀብኔ ሰነ ህንዸጌፈቱ፤","poem":1},{"text":"ዋቅን ዋን ሁንደ ደንደኡ እየ ሰናፍ ጉረ ህንኬኑ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዮ አት፣ ‘ዱቢንኮ ፉለሳ ዱረ ጅረ፤","poem":1},{"text":"አን እሰ ኤገቻን ጅረ፤","poem":2},{"text":"ገሩ እሰ አርጉ ህንደንደኡ’ ጄቴ፣","poem":1},{"text":"እን ሀመም ከና ገድዩ ጥኔሴ ሃዸገኡ ሬ!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አመሌ ሰበቢ ዼከምስሳ ነመ ህንአደብኔፍ፣","poem":1},{"text":"ሰበቢ እን በሌሳ ነማ አከ ዋን ጉዳ ቶኮት ህንፉዸኔፍ፣","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እዮብ ኦዱ ፋይዳ ህንቀብኔን አፋን በነ፤","poem":1},{"text":"ቤኩምሰ መሌስ ዱቢ ባይእሰ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}