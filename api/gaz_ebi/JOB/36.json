{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":36,"content":[{"type":"verse","number":1,"content":["ኤሊሁን እቱመ ፉፌ አከነ ጄዼ፦"]},{"type":"verse","number":2,"content":[{"text":"“አን አከ ቆደ ዋቃ ወን ጄዸሙ ሄዱን ጅሩ","poem":1},{"text":"ስት ነንአርግሲሳቲ ሜ ጥኖ ና ኦብስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አን ቤኩምሰኮ ፈጎዻ ነንፍደ፤","poem":1},{"text":"ቀጄሉማ ኡማኮቲስ ነንለብሰ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አከ ዱቢንኮ ሶበ ህንተእን ምርከኔፈዹ፤","poem":1},{"text":"ከን ቤኩምሳን ህርእነ ህንቀብኔ ቶኮ ስ ወጅን ጅረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ዋቅን ጀባዸ፤ ገሩ ኤኙንዩ ህንቱፈቱ፤","poem":1},{"text":"እን ጀባዸ፤ ካዮ እሳትስ ጭሜ ዻበተ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እን ሀሞተ ህንጅራችሱ፤","poem":1},{"text":"ወረ ረከተኒፍ ገሩ ሙርቲ ቀጄላ ንኬነ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እጀሳ ቀጄልቶተራ ህንቡቅፈቱ፤","poem":1},{"text":"ሞቶተ ወጅን ቴሶረ እሳን ቴስሰ፤","poem":2},{"lineBreak":true},{"text":"በረ በራንስ ኦል እሳን ጉድሰ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ገሩ ዮ ነሞትን ፎንጫዻን ህዸመን፣","poem":1},{"text":"ዮ ፉኞ ረክናቲንስ ህዸመን፣","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እን ሆጂሳኒ፣","poem":1},{"text":"ደበ እሳን ኦፍ ቱሉማን ሆጄተንስ እሳንት ንህመ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እን ጉረሳኒ ስሬፈመ ዸጌፈቹፍ ንበነ፤","poem":1},{"text":"አከ እሳን ዋን ሀማራ ቀልቢ ጅጂረተንስ ንአጀጀ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እሳን ዮ አጀጀመኒ እሰ ተጃጅለን፣","poem":1},{"text":"በረ ጅሬኘሳኒ በዻዹማን፣","poem":2},{"lineBreak":true},{"text":"ኡሙሪሳኒስ ገመቹዻን ፍጠቱ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዮ አጀጀሙ ባተን ገሩ፣","poem":1},{"text":"ጎራዴዻን በዱ፤","poem":2},{"lineBreak":true},{"text":"ቤኩምሰ መሌስ ንዱኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ወር ገራንሳኒ ዋቀራ ፈጋቴ፣ ኣሪ ኦፍ ኬሰት ኩፈቱ፤","poem":1},{"text":"ዮሙ እን ፎንጫን እሳን ህዹትሌ ገርጋርሰ በርባቻፍ ህንእየን።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እሳን ደርገጉማሳኒ ኬሰ ዱኡ፤","poem":1},{"text":"ጅሬኝሳኒስ ጡራኦተ ግዱት በደ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እን ገሩ ወረ ዽጰተን ዽጵነሳኒ ኬሳ ባሰ፤","poem":1},{"text":"ረኮሳኒ ኬሰትስ እሳንት ዱበተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“እን ዽጵነ ኬሳ ስ ባሴ","poem":1},{"text":"ገረ ለፈ በልኣ ዽጵነ ህንቀብኔት፣","poem":2},{"lineBreak":true},{"text":"ማዲ ጮማን ጉተሜት ስ ጌሰ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አመ ገሩ ሙርቲን ሀሞታፍ መሉ ስረ ቱለሜረ፤","poem":1},{"text":"ሙርቲፊ ሀቅን ስ ቀበተኒሩ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"አከ በዻዹማን ህንጎዎምስኔ ኦፍ ኤገዹ፤","poem":1},{"text":"አከ ባይእን መተኣስ ከራራ ስ ጀልእሱ ህንጎዽን።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"በዻዹማንኬ ዮካን ተታፊንኬ ጉዳን ሱን ሁንድ","poem":1},{"text":"ረኮራ ስ ኤጉ ደንደኣ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ሀልከን እት ነሞትን","poem":1},{"text":"መነሳኒቲ ቡቅፈመን ህንሀውን።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አት አከ ሀምነት ህንዴብኔ ኦፍ ኤገዹ፤","poem":1},{"text":"ቆደ ረክና ዋን ከነ ፍለቴርታቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“ኩኖ ዋቅን ሁምነሳቲን ኦል ኦል ጄዼረ፤","poem":1},{"text":"በርሲሳን አከሳ ኤኙ?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ነምን ከራ እሰት ህሙ፣","poem":1},{"text":"ዮካን ከን፣ ‘አት ዶጎጎርቴርተ’ እሳን ጄዹ ኤኙ?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ሆጂሳ ከን ነሞትን ፋርፈናዻን ጀጀን ሰነ፣","poem":1},{"text":"ሌልሱ ህንደገትን።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ነምን ሁንድኑ አርጌረ፤","poem":1},{"text":"ቶኮን ቶኮን ነማስ ፈጎት ጥዬፈቴ እላለ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዹጉማን ዋቅን ጉዳዸ፤ ኑስ እሰ ህንቤክኑ፤","poem":1},{"text":"ባይእነ በረሳስ ነምን ቤኩ ህንደንደኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“እን ጮጰ ብሻኒ ኦል ባሰ፤","poem":1},{"text":"ሁሪሳስ ወልት ቀቤ ቦካት ጌደረ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ዱሜስስ ጂዸሳ ገድ ጮጮብሰ፤","poem":1},{"text":"ቦካን ጉዳንስ ነመት ሮበ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ኤኙቱ አከ እን እት ዱሜሶተ ድሪርሱ፣","poem":1},{"text":"አከ እን እት ዱንካነሳ ኬሳ ቀቀዌሰኡስ ሁበቹ ደንደአ?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"አከ እን እት በከካ ናኖሳት ብትኔሱ፣","poem":1},{"text":"አከ እን እት ቱጁበ ገላናሌ ሀጉጉ እላል።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ኩን ሃለ እን እቲን ሰቦተ ቡልቹፊ","poem":1},{"text":"ኛተ ባይእናን እሳኒፍ ኬኑዸ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"እን ሀርከሳ በከካዻን ንጉተ፤","poem":1},{"text":"አከ በከካን ሱን እዶ አኬከሳ ዸኡስ ንአጀጀ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ከከዌንሳ አከ በከካን ዹፉ ለብሰ፤","poem":1},{"text":"ሎንዩ አከ እን ዽኣቴ ቤክስሱ።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}