{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":37,"content":[{"type":"verse","number":1,"content":[{"text":"“ከነረት ኦኔንኮ ንዽክፈተ፤","poem":1},{"text":"እዶ እሳቲስ ንኡኡታለ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዸጌፈዻ! እየ ሰገሌሳ፣","poem":1},{"text":"ጉንጉሚ አፋንሳቲ በኡሌ ዸገኣ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እን በከካሳ ሰሚ ሁንደ ጀለት ገድ ዺሰ፤","poem":1},{"text":"ገረ ሀንዳረ ለፋትስ ንኤርገ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኤርገሲ ሰገሌን ጉንጉሚሳ ንዹፈ፤","poem":1},{"text":"እን ሰገሌሳ ኡልፍነ ቀቤሰ ሰናን ንቀቀዌሰአ።","poem":2},{"text":"ዮሙ ሰገሌንሳ ዸገአሙት፣","poem":1},{"text":"እን ዋን ቶኮሌ ህንቁሰቱ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሰገሌን ዋቃ ሃለ ድንቅሲሳዻን ንቀቀዌሰአ፤","poem":1},{"text":"እን ዋን ጉዳ ሁበትናኬኛ ኦል ተኤ ጎዸ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እን ጨቢዻን፣ ‘ለፈረ ቡእ፤’","poem":1},{"text":"ቲፉዻንስ፣ ‘ቦካ ጀባ ተእ’ ጄዸ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አከ ነምን እን ኡሜ ሁንድ ሆጂሳ ቤኩፍ፣","poem":1},{"text":"እን ሀርከ ቶኮ ቶኮ ነማ ቻፔሰ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ብኔንሶትን ሆልቀሳኒት ገሉ፤","poem":1},{"text":"ደአትኖሳኒ ኬሰስ ንቱሩ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ቡቤን ሀማን እዶሳቲ ንበአ፤","poem":1},{"text":"ዻሞችስ ቡቤ ብትኔሱ ኬሳ ንበአ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሀፉር ዋቅን ባፈቱ ጨቢ ኡመ፤","poem":1},{"text":"ብሻኖትን በበልኣንስ ንእትቱ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እን ዱሜሶተ ብሻን ባችሰ፤","poem":1},{"text":"በከካሳስ እሳን ኬሰ ፈጫሰ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እሳን ዋን እን አጀጁ ሁንደ ሆጄቹፍ፣","poem":1},{"text":"ቀጄልፈመ እን ኬኑን","poem":2},{"lineBreak":true},{"text":"አዱኛ ሁንደረ ናነኡ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እን ነሞተ አደቡፍ፣ ዮካን ለፈሳ ኦባሴ","poem":1},{"text":"ጃለለሳ አርግሲሱፍ ጄዼ ዱሜሰ ፍደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ያ እዮብ ዋን ከነ ዸጌፈዹ፤ ሜ ኦፍ ቀቢቲ","poem":1},{"text":"ሆጂ ዋቃ እሰ ድንቅሲሳ ሰነ ሁበዹ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዋቅን አከምት ዱሜሶተ","poem":1},{"text":"አከ አጀጁፊ አከምት አከ በለቄስሱ አት ንቤክታ?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አከ እት ዱሜሶን ወል ቅጣተኒ ረረአን፣","poem":1},{"text":"ሆጂ ድንቅሲሳ ዋቃ እሰ ቤኩምሳን ሙዳ ህንቀብኔ ሰና ቤክታ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አት ከን ዬሮ ለፍት ቡቤ ክባቲን ጨልእስቱት","poem":1},{"text":"ሆአ ወያኬቲቲን ወጠለምቱ፣","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሰሚ አኩመ ኦፍ-እላሌ ናሲ በቅፈሜ ጀባቱ ሰነ","poem":1},{"text":"ድሪርሱ ኬሰት እሰ ገርጋሩ ንደንዴሳ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“ዋን ኑ እሳን ጄኑ ኑት ህም፤","poem":1},{"text":"ኑ ሰበቢ ዱከነኬኛቲፉ ዱቢኬኘ ቀጄልፈቹ ህንደንዴኙ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አከ አን ዱበቹ ፌዹ እሰት ህመሙ ቀባ?","poem":1},{"text":"ነምን ከምዩ ልቅምፈሙፍ ንጋፈታ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ኤርገ ቅሌንስ ሰሚወን ቁልቁሌሴ ቦዴ፣","poem":1},{"text":"ነምን አዱ ሁምነ ጉቱን እፍቱ እላሉ ደንደኡ ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዋቅን በሬድነ ወርቄቲን ካባ ንዹፈ፤","poem":1},{"text":"እን ኡልፍነሳ እሰ ሶዳችሳ ሰናን ንዹፈ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዋቅን ዋን ሁንደ ደንደኡ ሁበትናኬኛ ኦል፤","poem":1},{"text":"እን ሁምናፊ ሙርቲ ቀጄላዻን ጉዳዸ፤","poem":2},{"lineBreak":true},{"text":"ቀጄሉማንሳ ባይኤዸ፤ እን ነመ ህንጩንቁርሱ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ከናፉ፣ ነሞትን እሰ ሶዳቱ፤","poem":1},{"text":"እን ወረ ኦጌዪ ኦፍ ሴአን ሁንደ ወእቱ ህንሄዱ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/36.json","previousChapterAudioLinks":{},"numberOfVerses":24}