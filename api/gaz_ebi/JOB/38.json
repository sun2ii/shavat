{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":38,"content":[{"type":"heading","content":["ዋቀዮ ንዱበተ"]},{"type":"verse","number":1,"content":["ከነረት ዋቀዮ ቡቤ ጀባ ኬሳ እዮብት ዱበቴ። አከነ ጄዼስ፦"]},{"type":"verse","number":2,"content":[{"text":"“ነምን ዱቢ ቤኩምሰ መሌ","poem":1},{"text":"ዱበተሙን ከሮረኮ ዱከኔሱ ኩን ኤኙ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሜ አከ ጎታ ሙዺኬ ህዸዹ፤","poem":1},{"text":"አን ስን ጋፈዸ፤","poem":2},{"lineBreak":true},{"text":"አትሞ ዴቢ ና ኬን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“ዬሮ አን ሁንዴ ለፋ ካኤት አት ኤሰ ቱርቴ?","poem":1},{"text":"ዮ ሁበቴ ሜ ነት ህም።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኤኙቱ በልእነሼ ሙርቴሴ? ዹጉማን ንቤክታ?","poem":1},{"text":"ኤኙቱ ኡሌ ሰፈራ እሼረ ሀርክሴ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሁንዴንሼ ማልራ ዻበሜ?","poem":1},{"text":"ዮካን ኤኙቱ ዸጋ ጎሌሼ ዻቤ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኩንስ ዬሮ በከልቾን በሪ ወሊ ወጅን ፋርፈተንት፣","poem":1},{"text":"ዬሮ እልማን ዋቀዮስ እልልቸንት ቱሬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ዬሮ ገላን ጨብሴ ገራ ለፋ ኬሳ በኤት","poem":1},{"text":"ኤኙቱ በልበለ እት ጩፌ እትሴ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዬሮ አን ዱሜሶተ ኡፈተሳ ጎዼ","poem":1},{"text":"ዱከነ ጉዳን መሬት፣","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዬሮ አን ዳንጋሳ ዻቤ","poem":1},{"text":"በልበላፊ ደንቀራ ሆጄዼፍት፣","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አንስ፣ ‘አት ሀመ አሲት ዹፍተ፤ ገሩ ደርቡ ህንደንዴሱ፤","poem":1},{"text":"ደምበሊን ኦፍ ጀጁኬቲሌ አሱመት ዻበተ!’ ጄዼን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“አት በረ ጅሬኘኬቲ በራቀ አጀጄ","poem":1},{"text":"ዮካን በሪ ኦቦሮት እዶሳ አርግሲፍቴ ቤክታ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አከ እን ሀንዳረ ለፋ ቀበቴ","poem":1},{"text":"ነሞተ ሀሞ አች ኬሳ ሁርጉፉ ጎቴርታ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ለፍት አከ ሱጴ ቻፓ ጀለ ጅሩት ብፈ ጌደረት፤","poem":1},{"text":"ብፍትሼስ አከ ብፈ ኡፈታት ሙልአተ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሀሞን እፈሳኒ ዾወተመኒሩ፤","poem":1},{"text":"እሬንሳኒ እን ኦል ከኤስ ጨቤረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“አት ገረ ቡርቃ ገላና ገድ ቡቴ","poem":1},{"text":"ዮካን ቱጁበ ብሻኒ ሴንቴ ሁንዴሳረ ዴምቴ ቤክታ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ከር ዱኣ ስት ሙልእፈሜራ?","poem":1},{"text":"ከረ ጋድዱ ዱኣስ አርግቴርታ?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"በልእነ ለፋ ጉዳ ሰነ ሁበቴርታ?","poem":1},{"text":"ዮ ከነ ሁንደ ቤክቴ ዱበዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“ከራን እዶ እፍን ጅሩት ነመ ጌሱ ከም?","poem":1},{"text":"ዱከንስ ኤሰ ጅራተ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እዶሳኒት እሳን ጌሱ ደንዴሳ?","poem":1},{"text":"ዳንዲ ለፈ ጅሬኘሳኒት ጌሱ ቤክታ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አት ዹጉማን ንቤክተ፤ ዬሮ ሰነ ዸለቴርታቲ!","poem":1},{"text":"አት በረ ሄዱ ጅራቴርተ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“መንኩሰ ጨቢ ሴንቴ ዮካን መንኩሰ","poem":1},{"text":"ዸጋ ጨቢ አርግቴርታ?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ከን አን ዬሮ ረክናቲፍ፣","poem":1},{"text":"ጉያ ወራናፊ ሎላቲፍ ኦል ካአዼ አርግቴርታ?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ከራን እዶ እፍን እት ብትናኡት","poem":1},{"text":"ዮካን ገረ እዶ ቡቤን በኣ እት ለፈረ ፈፈጨኡት ነመ ጌሱ ከም?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ኤኙቱ ሎላዻፍ ቦኦ፣","poem":1},{"text":"በከካዻፍሞ ዳንዲ ባሴ፣","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ለፈ ነምን ቶኮዩ ኬሰ ህንጅራትኔ፣","poem":1},{"text":"ገሞጂ ነምን ቶኮዩ ኬሰ ህንጅሬ ብሻን ኦባሱፍ፣","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ለፈ ነምን ኬሰ ህንጅራትኔፊ ለፈ ኦና ቁብሴ","poem":1},{"text":"መርገስ እት ብቅልቹ ኤኙ?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ሮብን አባ ቀባ?","poem":1},{"text":"ጮጰ ፍጤንሳ ኤኙቱ ዸልቼ?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ጨቢን ገራ ኤኙቲ በአ?","poem":1},{"text":"ቆረ ሰሚ ኤኙቱ ዸለ?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ብሻኖትን አከ ዸጋ ጀባቱ፣","poem":1},{"text":"ፉል ቱጁባስ አከ ጨቢ ተአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“ኡርጂወን በበሬዶ ቶርቢ ጄዸመን ህዹ ንደንዴሳ?","poem":1},{"text":"ዮካን ህዻ ኡርጂ ሰዴ ጄዸሙ ሂኩ ንደንዴሳ?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ቱተ ኡርጂወኒ ወቅቲሌሳኒት ፍዱ","poem":1},{"text":"ዮካን ኡርጂ አማኬተ ጄዸሙ እልማንሳ ወጅን ቦባሱ ንደንዴሳ?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ሴረ ሰሚወኒ ቤክታ?","poem":1},{"text":"ቡልቺንሰሳኒ ለፈረት ሁንዴሱ ንደንዴሳ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“አት ሰገሌኬ ገረ ዱሜሳት ኦል ፉዸቴ፣","poem":1},{"text":"ሎላ ብሻኒቲን ኦፍ ሀጉጉ ንደንዴሳ?","poem":2}]},{"type":"verse","number":35,"content":[{"text":"አት በከካ ዳንዲሳረ ኤርጉ ንደንዴሳ?","poem":1},{"text":"እንስ፣ ‘ኩኖ አን አሰን ጅረ’ ሲን ጄዻ?","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ኤኙቱ ያደ ገራቲፍ ኦጉማ","poem":1},{"text":"ዮካን ሰሙዻፍ ሁበትና ኬኔ?","poem":2}]},{"type":"verse","number":37,"content":[{"text":"ኤኙቱ ዱሜሶተ ለካኡፍ ኦጉማ ቀበ?","poem":1},{"text":"ኤኙቱ ኦኮቴ ብሻን ሰሚ","poem":2}]},{"type":"verse","number":38,"content":[{"text":"ዬሮ ብዮን ጀባቱት፣","poem":1},{"text":"ዬሮ ሱጴን ወል ቀበቱት ጀልእሱ ደንደአ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“አት ሌንጨ ዸላዻፍ ኛተ አደምስቴ","poem":1},{"text":"ሳፌለ ሌንጫስ ቤለ ባፍቴ","poem":2}]},{"type":"verse","number":40,"content":[{"text":"ዬሮ እሳን መንኤሳኒ ኬሰት ርጰንት","poem":1},{"text":"ዮካን ዬሮ እሳን ደገለ ኬሰት ርጰኒዋ ኤገተንት ቤለ ንባፍታ?","poem":2}]},{"type":"verse","number":41,"content":[{"text":"ኤኙቱ ዬሮ እልማንሼ ገረ ዋቃት እየን፣","poem":1},{"text":"ዬሮ እሳን ኛተ ዸበኒ ጆረንት፣","poem":2},{"lineBreak":true},{"text":"አራጌሳፍ ኛተ ኬነ?","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/37.json","previousChapterAudioLinks":{},"numberOfVerses":41}