{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":39,"content":[{"type":"heading","content":["እዮብ"]},{"type":"verse","number":1,"content":[{"text":"“ዬሮ እት ቄሌጄን ዸልቱ ቤክታ?","poem":1},{"text":"ዬሮ እት ቦሮፍን እልሞሼ ዸልቱ አርግቴርታ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ጅአ እሳን ገራት እልማን ባተን ንለኮፍታ?","poem":1},{"text":"ዬሮ እሳን እት ዸለን ንቤክታ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እሳን ጅልቤንፈተኒ እልማንሳኒ ዸሉ፤","poem":1},{"text":"ፎለቹሳኒስ ንሆባፈቱ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እልማንሳኒ ንጀባቱ፤ አለትስ ንጉደቱ፤","poem":1},{"text":"በአኒ ንዴሙ፤ ህንዴብአንስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ኤኙቱ ሀሬ ዲዳ ገድ ዺሴ?","poem":1},{"text":"ፉኞሳስ ኤኙቱ ሂኬ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አን ገሞጂ መነሳ፣","poem":1},{"text":"ለፈ ሶግዳስ እዶ ጅሬኘሳ ጎዼን ኬኔፍ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እን ወጨ መጋላ ኬሳት ንኮልፈ፤","poem":1},{"text":"እየ ኮንኮላችሳስ ህንዸገኡ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዋን ዼዱ አርገቹፍ ቱሉወንረ ለበ፤","poem":1},{"text":"ዋን ለልሳ ሁንደስ ንበርባደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ገፈርስ ስ ተጃጅሉፍ ሲፍ አጀጀማ?","poem":1},{"text":"ደላኬ ኬሰስ ንቡላ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አከ እን ለፈ ሲፍ ቆቱፍ ፉኞዻን እሰ ህዹ ንደንዴሳ?","poem":1},{"text":"ዮካን እን ስ ዱባን ቦኦ ንባሳ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አት ዋን እን ሁምነ ጉዳ ቀቡፍ እሰ ንአመነታ?","poem":1},{"text":"ሆጂኬ ጀባሌ እሰት ንዺፍታ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አከ እን ምዻንኬ ወልት ቀቤ","poem":1},{"text":"ኦብዲኬረት ሲፍ ቱሉፍ እሰ ንአብደታ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ጉቺን ገመቹዻን ቆቾሼ አፈርስት፤","poem":1},{"text":"ገሩ ቆቾፊ ባሌ ሁሞቲን ወል ብረ ህንቀበሙ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሀንቃቁሼ ለፈረት ቡፍት፤","poem":1},{"text":"አከ እት ሆኡፍስ ጭረቸ ኬሰት ዺፍት፤","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ገሩ አከ ሚል ወዪ ጨጨብሱ፣","poem":1},{"text":"አከ ብኔንስ እረ ኤጄቱ ህንያደቱ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ጩጪ እሼትስ አከ ዋን እሳን ከንሼ ህንተእኒት ገራ ጀባት፤","poem":1},{"text":"ዮ ደዸቢንሼ አከሱማን በዴሌ እሼፍ ሆማ ምት፤","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዋቅን ኦጉማዻን እሼ ህንበዻፍኔቲ፤","poem":1},{"text":"ዮካን ሁበትና እሼፍ ህንቆድኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዬሮ ፊጉፍ ቆቾሼ በልእፈቱት፣","poem":1},{"text":"እሼን ፈርዳፊ ነምቸ ጉሉፉት ኮፈልት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“አት ፈርዳፍ ጀብነ ንኬንታ?","poem":1},{"text":"ዮካን ሞርመሳት ገመ ኡፍሱ ደንዴሳ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አከ እን አኩመ ሀዋንሳት ኡታሉ ንጎታ?","poem":1},{"text":"ኡልፍን ኮርሰሳስ ሶዳችሳዸ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"እን ሁምነሳት ገመዴ አከ መሌ ጉሌ ለፈ ዽዺተ፤","poem":1},{"text":"በኤስ ምአ ሎላት ቀጄለ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"እን ሶዳት ንኮልፈ፤ ዋን ቶኮሌ ህንሶዳቱ፤","poem":1},{"text":"ጎራዴራስ ዱበት ህንዴብኡ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"መንኤን ጥያ፣ ኤቦፊ አንካሴን ጨለቅሱስ","poem":1},{"text":"ጭናቸሳት ቡቡኤ ክልልቸ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ስኣኤ ሮሙዻን ለፈ ሃዸ፤","poem":1},{"text":"ዬሮ መለከትን አፉፈሙትሌ ኦብሴ ዻበቹ ህንደንደኡ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"እን ዮሙ መለከትን አፉፈሙት","poem":1},{"text":"‘ኡፌ’ ጄዼ እምምሰ፤ ወጨ አጀጆታቲፊ እየ ወራና፣","poem":2},{"lineBreak":true},{"text":"ፎሊ ወራናሌ ፈጎቱ ሱፈ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“ጩሉሌን ኦጉማኬቲን በርፍቴ","poem":1},{"text":"ቆቾሼስ ገረ ክባት በልእፍቲ?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ርሳን አጀጀኬቲን ኦል በኤ","poem":1},{"text":"ኦል ፈጎት መነሳ እጃረታ?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"እን ቀርቀረ ሀለያረ ጅራተ፤ ሀልከንስ አቹመ ቡለ፤","poem":1},{"text":"ከታን ፎፎቶቃንስ ደኦሳት።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"አች ታኤስ ዋን ኛቱ አደምሰ፤","poem":1},{"text":"እጅሳስ ፈጎት ዋን ሰነ አርገ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ጩጮሊንሳ ዺገ ዹጉ፤","poem":1},{"text":"እንስ ለፈ ረቅን ጅሩ ህንዸበሙ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}