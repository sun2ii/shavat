{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":4,"content":[{"type":"heading","content":["ኤሊፋዝ"]},{"type":"verse","number":1,"content":["ኤሊፋዝ ነምች ቴማን ሱን አከነ ጄዼ ዴብሴ፦"]},{"type":"verse","number":2,"content":[{"text":"“ዮ ነምን ቶኮ ስት ዱበቹ ያሌ፣ አት ንኮመታ?","poem":1},{"text":"ገሩ ኤኙቱ ዱበቹ ዺሰ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አት አከ ነመ ባይኤ በርሲፍቴ፣","poem":1},{"text":"አከ ሀርከ ደዸባሌ ጀጀቤስቴ ያደዹ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዱቢንኬ ወረ ገተንተረን ገርጋሬ ዻቤረ፤","poem":1},{"text":"አትስ ጅልበ ላፌ ጀቤስቴርተ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አመ ገሩ ረክን ስረ ገኤ፤ አትስ አብዲ ኩተቴርተ፤","poem":1},{"text":"ረክን ስ ሚዼረ፤ አትስ ርፈቴርተ፤","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዋቀ ሶዳቹንኬ እርኮኬ፣","poem":1},{"text":"ቀጄልን ከራኬቲስ አብዲኬ ምቲ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“አመስ ያደዹ፤ ነምን ቁልቁሉን ተኩማ በዴ ቤካ?","poem":1},{"text":"ቀጄሎን ኤሰት በደኒ ቤኩ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አከ አን ሁበዼት ወር ዋን ሀማ ቆተተን፣","poem":1},{"text":"ከኔን ዋን ሀማ ፈጫሰንስ እሱመ ሃመቱ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እሳንስ ሀፉረ ዋቅን እሳንት ባፈቱን በዱ፤","poem":1},{"text":"ሀፉራ ዼከምሰሳኒቲንስ ንበርበዴፈሙ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሌንጭ ንኣደ፤ ንጉሩርአስ፤","poem":1},{"text":"እልካን ሌንጨ ሳፌላ ገሩ ንጨጨበ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሌንጭ ጀባን ዋን አደምሱ ዸቤ ንዱአ፤","poem":1},{"text":"እልማን ሌንጨ ዸልቱስ ንብትናኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ዱቢን ቶኮ እጪቲዻን ና ፍደሜ፤","poem":1},{"text":"ጉርኮስ አሳሰሳ ዸገኤ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አብጁ ሀልከኒ ሶዳችሳ ኬሰ፣","poem":1},{"text":"ዮሙ ህርብን ጭማን ነመ ቀበቱት፣","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሶዳፊ ሆለቹን ነ ቀበቴ","poem":1},{"text":"ለፌኮ ሁንደ ራሴ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሀፉር ሉፍ ጄዼ ፉለኮ ዱረ ደርቤ፤","poem":1},{"text":"ርፌንስ ዸግነኮስ ከኤ ዻበቴ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እንስ ንዻበቴ፤","poem":1},{"text":"አን ገሩ እን ማል አከ ተኤ ሁበቹ ህንደንዴኜ።","poem":2},{"text":"ፈኪን ቶኮ እጀኮ ዱረ ዻበቴ፤","poem":1},{"text":"አንስ ሰገሌ ተስገቢ ከን አከነ ጄዹ ቶኮን ዸገኤ፦","poem":2}]},{"type":"verse","number":17,"content":[{"text":"‘ነምን ዱአ ህንኦሌ፣ ዋቀ ጫላ ቀጄላ ተኡ ደንደኣ?","poem":1},{"text":"ነምን ኡማሳ ጫላ ቁልቁሉ ተኡ ደንደኣ?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዋቅን ተጃጅልቶተሳ ህንአመነቱ፤","poem":1},{"text":"ኤርገሞተሳስ በሌሳሳኒቲን ንጋፈተ፤","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዮስ ወር መኔን ሱጴ ኬሰ ጅራተን፣","poem":1},{"text":"ወር ሁንዴንሳኒ ብዮ ተኤ፣","poem":2},{"lineBreak":true},{"text":"ወር ብሊ ጫላ ቡርኩታአንሞ አከም ሃተአንሬ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እሳን ገነማፊ ገልገለ ግዱት ቡርኩታኡ፤","poem":1},{"text":"ተሱመስ በረ በራን ንበዱ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አከ እሳን ኦጉማ መሌ ዱአኒፍ","poem":1},{"text":"ፉኞን ዱንካነሳኒ ህንሉቅፈምኔ?’","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}