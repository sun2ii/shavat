{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"“አት ሆኮ ቁርጡሚቲን ሌዋታን ሀርክፍቴ ባሱ","poem":1},{"text":"ዮካን አረበሳ ፉኞዻን ህዹ ንደንዴሳ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ፉኛንሳ ኬሰ ፉኞ ባሱ","poem":1},{"text":"ዮካን ለፌ መንጋጋሳ ሆኮዻን ኡሩ ንደንዴሳ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እን አከ አት እሳፍ አራረምቱፍ ጉድሴ ስ ከዸታ?","poem":1},{"text":"አፋን ነጋቲንስ ስት ንዱበታ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አከ አት በረ በራን ገርብቸ ጎዸቱፍ","poem":1},{"text":"እን ስ ወጅን ከኩ ንገላ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አት አከ ስምብሮተ ወጅን ተጰቱ እሰ ወጅን ንተጰታ?","poem":1},{"text":"ዮካን ሸመረንኬቲፍ እሰ ንሂታ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ደልደልቶትን እሰረት ገቲ ወል ዱበቱ?","poem":1},{"text":"ወረ ብቴ ጉርጉሩፍስ እሰ ንቆዱ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አት ጎጋሳ ጥያን፣","poem":1},{"text":"ዮካን መታሳ ሆኮ እቲን ቁርጡሚ ቀበኒንወወራኑ ንደንዴሳ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዮ ሀርከኬቲን እሰ ቱቅጤ፣ ወልኣንሶ ሰነ ንያደተ፤","poem":1},{"text":"ዴብቴስ ዋን ሰነ ህንጎቱ!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እሰ ሞአትነ ጄዸኒ አብደቹን ሶበ፤","poem":1},{"text":"እጁማን እሰ እላሉኑ ነመ ሆለቺሰ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ነምን እሰ ደመቅሱፍ ገራ ቀባቱ ቶኮዩ ህንጅሩ።","poem":1},{"text":"ኤጋ ነምን ነ ዱረ ዻበቹ ደንደኡ ኤኙ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ነምን ዋ ነት ኬነቴ አን ዴብሱፊ ቀቡ ኤኙ?","poem":1},{"text":"ወን ሰሚ ጀለ ጅሩ ሁንድኑ ከኑመኮት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“አን ዋኤ ሀርካፊ ሚለሳ፣","poem":1},{"text":"ዋኤ ጀብናፊ ዻበ ቶሉሳ ዱበቹ ህንዺሱ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኤኙቱ ኡፈተ እን እራን ኡፈቱራ ባሰ?","poem":1},{"text":"ኤኙቱ ሉገመ ቀበቴ እሰት ዽኣተ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኤኙቱ በልበለ አፋንሳ","poem":1},{"text":"እሰ እልካንሳ ሶዳችሳ ሰናን መርፈሜ በኑ ደንደአ?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዱግድሳ ጋቸነወን ተሬ ገለን፣","poem":1},{"text":"ከኔን አከ መሌ ወልት መጠንፈመን ቀበ፤","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ቶኮን ቶኮን ጋቸነወን ሰና","poem":1},{"text":"አከ ቅሌንስ ግዱሳኒ ህንባኔፍ ባይኤ ወልት መጠኑ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እሳን ጀቤፈመኒ ወልት ቀብሲፈመን፤","poem":1},{"text":"ዋን ወልት ፈየኒፍ ገርገር ህንባፈመን።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሀጥሶንሳ በለቄሰ እፋ ባሰ፤","poem":1},{"text":"እጅሳሞ አኩመ እፈ ቢፍቱ ሬፉ ባቱት።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አፋንሳ ኬሳ አረበ እብዳቱ በአ፤","poem":1},{"text":"ቃንቄንስ አፋንሳ ኬሳ ንፈፈጨአ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አኩመ ኣረ ጡዌ እብደ ሸምበቆረት","poem":1},{"text":"ደፍቁ ኬሳ በኡ ፉኛንሳቲ ኣር ንበአ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሀፉር አፋንሳቲ በኡ ጭሌ እብዳ ቀብሲሰ፤","poem":1},{"text":"አፋንሳ ኬሳስ አረብን እብዳ ንበአ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ሞርመሳ ኬሰ ጀብነቱ ጅረ፤","poem":1},{"text":"ሶዳችሱንስ ፉለሳ ዱረ ንኡታለ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ደቻን ፎንሳ ወል ቀበቴረ፤","poem":1},{"text":"ደቻን ሱንስ ወልት ፈዬረ፤ ህንሶቾኡስ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ለጴንሳ አከ ከታ ጀባተ፤","poem":1},{"text":"አከ ዸጋ ዳኩስ ጀባዸ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዬሮ እን ኦል ከኡት፣ ጀጀቦን ንሶዳቱ፤","poem":1},{"text":"ዮሙ እን ለፈ ሶቾሳ ዹፉት እሳን ኦፍረ ገረ ገለኒ በቀቱ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ጎራዴን እት ቡኡሌ ሆማ እሰ ህንጎዹ፤","poem":1},{"text":"ኤቦን ዮካን ጥይ ዮካን አንካሴንስ ሆማ እሰ ህንጎዹ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"እን ስቢለ አከ ጭዲት፣","poem":1},{"text":"ናሲሞ አከ ሙከ ቶርቶሬት ሄደ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ጥይ እሰ ህንበቀቺሱ፤","poem":1},{"text":"ዸጋን ፉርሳ እሳፍ አኩመ ሀበቂት።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ቦኩን እሳፍ አኩመ ጭዲት፤","poem":1},{"text":"እን ምርምርፈሙ ኤቦት ንኮልፈ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ገራንሳ ጀል አከ ጨባ ኦኮቴ ከን ቀረ ቀቡት፤","poem":1},{"text":"አከ ሙከ እቲን ምዻን ዸአኒትስ ዾቄ በቀቅሰ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"እን ቱጁበ አከ ኦኮቴ ደፍቁት ኮቅሲሰ፤","poem":1},{"text":"ገላነስ አኩመ ብልቃጢ ድበታ ራሰ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"እን ዱበሳቲን አከ ከራን እፉ ንጎዸ፤","poem":1},{"text":"ነምን ዋን ቱጁብን ሱን ርፌንሰ አዲ ቀቡ ሴአ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ኡመምን ሆማ ህንሶዳትኔ፣","poem":1},{"text":"ከን እሳን ቅጣቱ ቶኮዩ ለፈረ ህንጅሩ።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"እን ወረ ኦፍ ቱሉ ንቱፈተ፤","poem":1},{"text":"ወረ ኦፍ ጀጁ ሁንደረት ሞቲዸ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":34}