{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"“ሜ ዋም፣ ነምን ዴቢ ሲፍ ኬኑ ጅራ?","poem":1},{"text":"ቁልቁሎተ ኬሳስ አት ገረ እሰ ከሚት ጎርተ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ነመ ጎዋ ኣሪቱ አጄሰ፤","poem":1},{"text":"ራቱስ ህናፋቱ ገላፈተ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ነምን ጎዋን ህደሳ ገድ ፈጌፈቴ ነንአርጌ፤","poem":1},{"text":"መንሳ ገሩ ዮሱመ አባረሜ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እጆሌንሳ ነጋ ህንቀበን፤","poem":1},{"text":"እሳን ከረ ዱረት ቡርኩታአን፤ ነምን እሳን ኦልቹስ ህንጅሩ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ነምን ቤለኤ ምዻንሳ ቆራቲ ኬሳዩ ፉዼ ኛተ፤","poem":1},{"text":"እን ዼቦቴስ ቀቤኘሳ ሀወ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ረክን ብዮ ኬሳ ህንቡርቁቲ፤","poem":1},{"text":"ዽጵንስ ለፈ ኬሳ ህንብቅሉ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አኩመ ቃንቄን እብዳ ኦል ፈጨኡ","poem":1},{"text":"ነምን ረክናፍ ዸለተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ገሩ ኡቱ አነ ተኤ ዋቀ ነንበርባደዸ፤","poem":1},{"text":"ዽመኮስ ፉለሳ ዱረት ነንዽኤፈዸን ቱሬ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እን ድንቂወን ቆረኒ ብረ ገኡ ህንደንዴኜ፣","poem":1},{"text":"ሆጂወን ድንቅሲሶ ለካአሙ ህንደንዴኜ ሆጄተ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እን ቦካዻን ለፈ ንቁብሰ፤","poem":1},{"text":"ለፈ ቆቲሳስ ብሻን ንኦባሰ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ወረ ገድ ቀበመን ኦል ባሰ፤","poem":1},{"text":"ወረ ገደንስ እዶ ነጋት ኦል ካሰ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አከ ሆጂን ሀርከሳኒ ህንምልኮፍኔፍ፣","poem":1},{"text":"እን ከሮረ ጀልኦታ ንፈሸሌሰ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እን ኦጌዪ ሀጡማሳኒቲን ቀበ፤","poem":1},{"text":"መል ጀልኦታሞ ደፌ ንበደ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ጉያን ዱከነ እሳንት ተአ፤ ጉያ ሳፋስ","poem":1},{"text":"አከ ነመ ዱከነ ኬሰ ጅሩ ቀቀበናዻን ዴሙ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እን ነመ ረከታ ጎራዴ አፋንሳኒ ጀላ፣","poem":1},{"text":"ሀርከ ነመ ጀባ ጀላስ ንባሰ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ከናፉ ህዬስ አብዲ ቀበ፤","poem":1},{"text":"ጀልእንስ አፋንሳ ንጩፈተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“ነምን ዋቅን አደቡ ኤብፈማዸ፤","poem":1},{"text":"ከናፉ አት አደቢ ዋቀ ዋን ሁንደ ደንደኡ ህንቱፈትን።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እን ንመዴሰ፤ ንፈይሰስ፤ እን ንጨብሰ፤","poem":1},{"text":"ሀርከሳቲንስ ዴብሴ ንፈይሰ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"በላ ጀአ ጀላ ስ ባሰ፤","poem":1},{"text":"ቶርበ ኬሰትስ ህንሚዸምቱ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"በረ ቤላ ዱአ ጀላ፣","poem":1},{"text":"ሎለ ኬሰትስ ሩኩታ ጎራዴ ጀላ ስ ባሰ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አት ገረፊ አረባ ጀላ ንዾክፈምተ፤","poem":1},{"text":"ዮሙ በዲስን ዹፉትስ ህንሶዳቱ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"በዲሳፊ ቤለት ንኮልፍተ፤","poem":1},{"text":"ብኔንሶተ ለፋስ ህንሶዳቱ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዸጎተ በኬ ወጅን ከኩ ገልተ፤","poem":1},{"text":"ብኔንሶትን ቦሶናስ ነጋዻን ስ ወጅን ጅራቱ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዱንካንኬ ነጋን አከ ጅሩ ንቤክተ፤","poem":1},{"text":"ቀቤኘኬ ንቶአተ፤ ወን ቶኮሌ ስ ጀላ ህንበዱ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"እጆሌንኬ አከ ባይአተን፣","poem":1},{"text":"ሰኚወንኬስ አኩመ መርገ ለፋ አከ ተአን ንቤክተ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"አኩመ ብሲን ምዻኒ ዬሮሳት ወልት ቀበሙ ሰነ፣","poem":1},{"text":"አትስ በረ ዼራ ጅራቴ አዋለ ሴንተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“ኑ ዋን ከነ ቆረኔረ፤ እንስ ዹጋዸ።","poem":1},{"text":"ከናፉ ቀልቤፈዹ፤ ኦፊኬቲፍስ ቤክ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}