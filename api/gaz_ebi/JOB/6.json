{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":6,"content":[{"type":"heading","content":["እዮብ"]},{"type":"verse","number":1,"content":["እዮብስ አከነ ጄዼ ዴብሴ፦"]},{"type":"verse","number":2,"content":[{"text":"“ኡቱ ገድኮ ሰፈረሜ","poem":1},{"text":"ዽጵንኮ ሁንድስ መዳሊረ ካአሜ ጅራቴ!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዋን እን ጭረቸ ገላና ጫላ ኡልፋቱፍ፣","poem":1},{"text":"አሪቲን ዱበቹንኮ ነመ ህንድንቅሲሱ ቱሬ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጥየወን ዋቀ ዋን ሁንደ ደንደኡ ነ ኬሰ ጅሩ፤","poem":1},{"text":"ሀፉርኮ ሱሚሳኒ ዹገ፤","poem":2},{"lineBreak":true},{"text":"ሶዳችሱን ዋቃ ነት ህሪሬረ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሀሬን ዲዳ ኡቱ መርገ ቀቡ ሀላካ?","poem":1},{"text":"ዮካን ቆትዮን ኡቱ ኦካ ቀቡ በሮዳ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኛትን ህንምኦፍኔ ሶግደ መሌ ኛተማ?","poem":1},{"text":"ዮካን ብሻን ሀንቃቁ ንምኣዋ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አን እሰ ቱቁ ህንፌዹ፤","poem":1},{"text":"ኛትን አከሲ ነ ዹኩብሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ኡቱ ከዸናንኮ ዴቢ አርገቴ፣","poem":1},{"text":"ዋቅንስ ዋን አን ሀዉ ና ኬኔ ጅራቴ፣","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኡቱ ነ ጨጨብሱን ፌዺ ዋቃ ተኤ፣","poem":1},{"text":"ኡቱ ሀርክሳ ሂከሜ ነ ገላፈቴ!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ስላ ኩን ጀጀብነ ና ተአ ቱሬ፤","poem":1},{"text":"ዹኩበ ሀማ ኬሰትዩ ነንገመደ ቱሬ፤","poem":2},{"lineBreak":true},{"text":"አን ዱቢ ቁልቁልቸ ሰና ህንገኔቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“አመስ አከን አብደዹፍ ጀብንኮ ማል?","poem":1},{"text":"አከን ኦብሱፍስ ሁምንኮ ማል?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አን ጀብነ ዸጋ ቀባ?","poem":1},{"text":"ፎንኮስ ናሲዻ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አን ኦፍ ገርጋሩፍ ሁምነ ቶኮሌ ቀባ?","poem":1},{"text":"ኦጉማን ነ ኬሳ በዴረ ምቲ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ነምን ምቹሳቲፍ ገራ ህንላፍኔ","poem":1},{"text":"ዋቀ ዋን ሁንደ ደንደኡዩ ሶዳቹ ዺሴረ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኦቦሎትንኮ ገሩ አከ ዶሎሎ፣","poem":1},{"text":"አኩመ ለገ ዬሮፍ ጉቴ ደርቡ ጎዎምስቶተ፤","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እሳን ለገ ጨቢዻን ቦረኤ","poem":1},{"text":"ዮሙ ጨቢን ሱን በቁትሞ ጉቴረ ያኡት።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ለጌን ዬሮ ቦን ጭሙት ንጎጎጉ፤","poem":1},{"text":"ዬሮ ሆኣትሞ እዶሳኒቲ በዱ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ወር ጋላን ደልደለን ከራሳኒራ ጀልአቱ፤","poem":1},{"text":"ገሞጂት ነምአኒ ዹሙ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ደልደልቶትን ቴማ ከኔን ጋላን ደልደለን ብሻን በርባዱ፤","poem":1},{"text":"ከራ አዴምቶትን ሼባሞ እሳን አብደቱ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እሳን ዋን አብደተኒ ቱረኒፍ ንቃነአን፤","poem":1},{"text":"አች ገአኒስ ዋን ጄዸን ወላለን።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አመስ እስን አከ ዋን ፋይዳ ህንቀብኔ ታተን፤","poem":1},{"text":"ግድራኮ አርግተኒ ሶዳተን።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"አን ተኩማ፣ ‘ዋ ናፍ ኬና’ ዮካን","poem":1},{"text":"‘ቀቤኘኬሰን ፉሪ ናፍ ጎዻ’ ጄዼራ?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዮካን፣ ‘ሀርከ ዲና ጀላ ነ ባሳ’ ዮካን፣","poem":1},{"text":"‘ሀርከ ጩንቁርስቶታ ጀላ ነ ፉራ’ ጄዼራ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“ነ በርሲሳ፤ አን ነንጨልእሰ፤","poem":1},{"text":"እዶ አን እት ዶጎጎሬስ ነ አርግሲሳ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዱቢን ቀጄላን አከም ኡልፋታዸ!","poem":1},{"text":"ፈልሚንኬሰን ገሩ ማል ምርከኔሰ?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"እስን ዋን አን ጄዹ ቀጄልቹ፣","poem":1},{"text":"ዱቢ ነመ አብዲ ኩተቴስ አከ ቡቤት ሄዱ በርባዱ?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"እስን እጆሌ አባ ህንቀብኔት እጣ ቡፈቱ፤","poem":1},{"text":"ምቾተኬሰኒፍስ ቦለ ቆቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“አመ ገሩ ዮ ፌዺኬሰን ተኤ ነ እላላ።","poem":1},{"text":"አን ፉለኬሰን ዱረት ነንሶባ?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ዴብኣ፤ ሙርቲስ ህንጀልእስና፤","poem":1},{"text":"ሁበዻ፤ አን ነመ ቀጄላዻቲ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ጀልእን አረበኮረ ጅራ?","poem":1},{"text":"አፋንኮ ደበ አዳን ባሱ ህንደንደኡ?","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}