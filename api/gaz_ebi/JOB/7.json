{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"“ጅሬኝ ነማ ለፈረት ቀብሶ ጭማ ምቲ?","poem":1},{"text":"በርሳስ አኩመ በረ ነመ ቀጨረማ ቶኮቲ ምቲ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አኩመ ገርብቸ ጋድሰ ገልገላ ሀዉ፣","poem":1},{"text":"ዮካን አኩመ ሆጄታ ምንዳሳ ኤገቱ ቶኮ፣","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ጅኦን ፋይዳ ህንቀብኔ ና ቆደመን፤","poem":1},{"text":"ሀልከኖትን ዽጵናስ ና ረመደመን።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዮሙን ጪሱት፣ ‘አን ዮምን ከአ?’ ጄዼን ያደ።","poem":1},{"text":"ሀልከን ነት ዼረተ፤ አንስ ሀመ በርኡት ነንገገረገለ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ነፍንኮ ራሞፊ ቆኘኛ ኡፈቴረ፤","poem":1},{"text":"ጎጋንኮ በበቀቄ መለኣ ጅረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“በርኮ ኮሎ ወየ ዾፍቱ ጫላ አሪፈተ፤","poem":1},{"text":"እንስ አብዲ መሌ ዹመ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኤጋ ያ ዋቀዮ፣ አከ ጅሬኝኮ","poem":1},{"text":"አኩመ ቅሌንሳ ተኤ ያደዹ፤","poem":2},{"lineBreak":true},{"text":"እጅኮ ለመተ ዋን ጋሪ ህንአርጉ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እጅ አመ ነ አርጉ ስአች ነ ህንአርጉ፤","poem":1},{"text":"አት ነ በርባደ፤ ገሩ አን ህንጅሩ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አኩመ ዱሜስ ብትናኤ በዱስ","poem":1},{"text":"ነምን አዋለሜ ህንዴብኡ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እን ለመተ መነሳት ህንዴብኡ፤","poem":1},{"text":"እዶንሳስ ስአች እሰ ህንቤኩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ከናፉ አን ጨል ህንጄዹ፤","poem":1},{"text":"አን ሀፉረኮ ዽጰቴ ሰናን ነንዱበዸ፤","poem":2},{"lineBreak":true},{"text":"ሀዻኡማ ሉቡኮቲንስ ነንጉንጉመ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አት ኤግዱ ነት ረመዱንኬ፣ አን ገላነሞ","poem":1},{"text":"ዮካን ብኔንሰ ገላናት?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዮሙ አን፣ ‘ስሬንኮ ነ ጀጀቤሰ፤","poem":1},{"text":"ወን አን እረ ጪሱ ጉንጉሚኮ ና ጥኔሰ’ ጄዹት፣","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አት አብጁ ኬሰ ነ ሶዳችፍተ፤","poem":1},{"text":"ሙልአታንስ ነ ርፈቺፍተ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ከናፉ አን አከስት ጅራቹረ","poem":1},{"text":"ኦፍ ሁዼ ዱኡ ነንፍለዸ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ጅሬኘኮ ነንጅበ፤ አን በረ በራን ህንጅራዹ።","poem":1},{"text":"ነ ዺስ፤ ጅራቹንኮ ፋይዳ ህንቀቡቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“አከ አት እሰ ሌልፍቱፍ፣","poem":1},{"text":"አከ ቀልቢኬ እሰረ ኬሱፍስ ነምን ማል?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"አት ገነመ ገነመ እሰ ጢንጠልቴ","poem":1},{"text":"ዬሮ ዬሮት እሰ ቆርተ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አት እጀኬ ነራ ህንቡቅፍቱ?","poem":1},{"text":"ሀመ አን ሀንጩፈ ልቅምሱት ኮጳኮ ነ ህንዺፍቱ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ያ እሰ ነመ ኤግዱ፣","poem":1},{"text":"ዮን ጩቡ ሆጄዼዩ አን ማለን ስ ጎዸ?","poem":2},{"text":"አት ማሊፍ ዋን እት አኬከቱ ነ ጎዸቴ?","poem":1},{"text":"አን በኣ ስት ተኤራ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አት ማሊፍ በሌሳኮረ ደበርቴ","poem":1},{"text":"ጩቡኮሌ ናፍ ህንዺፍኔ?","poem":2},{"text":"ዬሮን አን እት ብዮ ኬሰ ጪሱ ገኤራቲ፤","poem":1},{"text":"አት ነ በርባደ፤ ገሩ አን ህንአርገሙ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/6.json","previousChapterAudioLinks":{},"numberOfVerses":21}