{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":8,"content":[{"type":"heading","content":["ብልዳድ"]},{"type":"verse","number":1,"content":["ብልዳድ ሹሃህች አከነ ጄዼ ዴብሴ፦"]},{"type":"verse","number":2,"content":[{"text":"“አት ሀመ ዮሚት ዋን አከሲ ዱበተ?","poem":1},{"text":"ዱቢንኬ ቡቤ ጀባዸ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዋቅን ሙርቲ ቀጄላ ጀልእሳሬ?","poem":1},{"text":"ዋቅን ዋን ሁንደ ደንደኡ ዋን ቀጄላ ጀልእሳ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዮሙ እጆሌንኬ ጩቡ እሰት ሆጄተንት፣","poem":1},{"text":"እን አደቢ ጩቡሳኒት ደበርሴ እሳን ኬኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አት ገሩ ዮ ዋቀ በርባደቴ፣","poem":1},{"text":"ዋቀ ዋን ሁንደ ደንደኡ ዮ ዋመቴ፣","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዮ አት ቁልቁሉፊ ቀጄላ ታቴ፣","poem":1},{"text":"እን ዋኤኬቲፍ አሙመ ከአ፤","poem":2},{"lineBreak":true},{"text":"ጅሬኘ ቀጄሉማኬስ ሲፍ ዴብሰ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ጀልቀብንኬ ጥና ተኡሌ፣","poem":1},{"text":"ዹምንኬ ባይኤ ጉዳ ተአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ዸሎተ ደርቤ ጋፈዹ፤","poem":1},{"text":"ዋን አቦቲንሳኒ ቆረተኒ ብረ ገአንስ ሁበዹ፤","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኑ ዋን ከሌሰ ዸለኔፍ ዋ ቶኮሌ ህንቤክኑቲ፤","poem":1},{"text":"በሮትንኬኘስ ለፈረት አኩመ ጋድዱት።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እሳን ስ ህንበርሲሰኒ? ስትስ ህንህመኒ?","poem":1},{"text":"ዱቢ ገራሳኒ ኬሰ ጅሩስ ህንዱበተኒ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዸላዱን ለፈ ጨፌ ህንተእንት ጉደታ?","poem":1},{"text":"ሸምበቆንስ ብሻን መሌ ለልሳ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እሳን ኡቱመ ጉደቻ ጅረኑ፣ ኡቱ ህንሙረምን፣","poem":1},{"text":"ብቅልቱወን ካን ዱረ ደፈኒ ጎጉ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዹምን ወረ ዋቀ እራንፈተኒስ አከሱመ ተአ፤","poem":1},{"text":"አብዲን ወረ ዋቀ ህንቤክኔስ ንበደ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አብዲንሳ አኩመ ሰልጳት ጭተ፤","poem":1},{"text":"ኦፍት አመነቹንሳስ መንኤ ሰሪቲት።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እን መንኤሳት እርከተ፤ መንኤን ሱን ገሩ ህንዻበቱ፤","poem":1},{"text":"እት መጠነስ፤ መንኤን ሱን ገሩ ደንደኤ እሰ ህንባቱ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እን አከ ብቅልቱ አዱ ኬሰት ብሻን ኦባፈሜ ለልሱት፣","poem":1},{"text":"ደሜወንሳ ለፈ ብቅልቱረ ድሪርፈቱት።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ህደሳ ቱላ ዸጋት መረተ፤","poem":1},{"text":"ከታ ግዱስ እዶ ጅራቱ ንበርባደተ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዮሙ እን እዶሳቲ በዱት ገሩ፣","poem":1},{"text":"እዶን ሱን፣ ‘አን ስ አርጌ ህንቤኩ’ ጄዼ እሰ ገነ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ኩንስ ዹመ ጅሬኘሳት፤","poem":1},{"text":"ብቅልቱወን ብራስ ለፋ ንብቅሉ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ዋቅን ነመ ህርእነ ህንቀብኔ ህንገቱ፤","poem":1},{"text":"ዮካን ሀርከ ጀልኦታ ህንጀቤሱ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"እን አፋንኬ ኮልፋን፣","poem":1},{"text":"አረበ ኬሞ እልሌዻን ንጉተ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ወር ስ ጅበን ሰልጵነ ኡፈቱ።","poem":1},{"text":"ዱንካን ጀልኦታስ ስአች ህንጅራቱ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}