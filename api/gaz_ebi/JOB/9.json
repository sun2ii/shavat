{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOB","translationId":"gaz_ebi","name":"እዮብ","commonName":"እዮብ","title":"ክታበ እዮብ","order":18,"numberOfChapters":42,"sha256":"af3cbffdea372204dce76f6203c5eb51a175b29739f2a28f0efa756749af37e4","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gaz_ebi/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":9,"content":[{"type":"heading","content":["እዮብ"]},{"type":"verse","number":1,"content":["እዮብ አከነ ጄዼ ዴብሴ፦"]},{"type":"verse","number":2,"content":[{"text":"“አን አከ ወን ኩን ዹጋ ተኤ ቤከ።","poem":1},{"text":"ነምን ገሩ አከምት ፉለ ዋቃ ዱረት ቀጄላ ተኡ ደንደአ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ነምን ቶኮ ዮ እሰ ወጅን ፈልሙ በርባዴ","poem":1},{"text":"ኩመ ኬሳ ስአ ቶኮሌ እሳፍ ዴብሱ ህንደንደኡ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኦጉማንሳ ገድ ፈጎዸ፤ ሁምንሳስ ጉዳዸ።","poem":1},{"text":"ነምን እሳን ሞርሜ ኡቱ ህንሚዸምን ሀፉ ጅራ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እን ኡቱ እሳን ህንቤክን ቱሉወን እዶሳኒቲ ቡቅሰ፤","poem":1},{"text":"ዼከምሰሳቲንስ እሳን ገገረገልቸ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ለፈ እዶሼቲ ንሶቾሰ፤","poem":1},{"text":"ኡቱባወንሼስ ንራሰ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እን ቢፍቱ ንአጀጀ፤ እሼንስ ህንባቱ፤","poem":1},{"text":"ኡርጂወንስ ቻፓዻን ንጩፈ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እሰ ቆፈቱ ሰሚወን ድሪርሰ፤","poem":1},{"text":"ደምበሊ ገላናረስ ንዴመ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኡርጂወን አማኬታፊ ኡርጂ ሰዴ፣","poem":1},{"text":"ኡርጂ ቶርቢፊ ቱተ ‘ኡርጂወን ክባ’ ጄዸመን እሰቱ ኡሜ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እን ወንቶተ ጉርጉዳ ቆረተኒ ብረ ገኡን ህንደንደአምኔ፣","poem":1},{"text":"ድንቂወን ህንለካአምኔ ሆጄተ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዮሙ እን ነ ብረ ደርቡ አን እሰ አርጉ ህንደንደኡ፤","poem":1},{"text":"ዮሙ እን ነ ጭነ ዴሙስ አን እሰ ሁበቹ ህንደንደኡ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዮ እን ቡቴ ዴሜ ኤኙቱ እሰ ዾዉ ደንደአ?","poem":1},{"text":"ኤኙቱስ፣ ‘አት ማል ሆጄታ?’ እሳን ጄቹ ደንደአ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዋቅን ዼከምሰሳ ህንዴብሱ፤","poem":1},{"text":"ወር ረኣብን ገርጋረንዩ ገድ ዴብኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ዮስ አን አከምተን እሰት ፈልሙ ደንደአ?","poem":1},{"text":"እሰት ፈልሙፍስ አከምተን ዱቢ ፍለቹ ደንደአ?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አን ነመ በሌሳ ህንቀብኔ ኡቱን ተኤዩ፣","poem":1},{"text":"እሳፍ ዴብሱ ህንደንደኡ፤","poem":2},{"lineBreak":true},{"text":"አባ ሙርቲኮ አራረ ከዸቹ ቆፈ ነንደንደአ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዮ አን እሰ ዋመዼ እን ና ዴብሴሌ፣","poem":1},{"text":"አከ እን ነ ዸገኡ አን ህንአመኑ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እን ቡቤ ሀማዻን ነ ጨጨብሰ፤","poem":1},{"text":"መዳኮስ ሰበቢ መሌ ነት ባይእሰ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እን ዋን ሀዻኣዻን ነ ጉቴ መሌ","poem":1},{"text":"አከ አን ሀፉረ ፉዸዹፍሌ ዬሮ ናፍ ህንኬንኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዋኤ ጀብና ታናን እን ጀባዸ!","poem":1},{"text":"ዋኤ ሙርቲ ቀጄላስ ታናን ኤኙቱ እሰ ዋሙ ደንደአ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ኡቱ አን ነመ በሌሳ ህንቀብኔ ተኤዩ አፋንኮ ነት ሙረ፤","poem":1},{"text":"ኡቱመ አን ህርእነ ህንቀባኔስ የከማ ተኡኮ ህመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“አን ህርእነ ቀባቹ ባዹዩ፣","poem":1},{"text":"ዋኤ ኦፊኮቲ ህንያደኡ፤","poem":2},{"lineBreak":true},{"text":"ጅሬኘኮስ ነንቱፈዸ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ወን ሁንድኑ ቶኩመ፤","poem":1},{"text":"ከናፉ አን፣ ‘እን እሰ ህርእነ ህንቀብኔስ፣","poem":2},{"lineBreak":true},{"text":"እሰ ሀማስ ንበሌሰ’ ነንጄዸ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዮሙ ዸእች ቡኤ ዱአ ተሳ ፍዱት፣","poem":1},{"text":"እን በዲሰ ወረ የከ ህንቀብኔት ንቆሰ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዮሙ ለፍት ሀርከ ሀሞታ ጀለ ገልቱት፣","poem":1},{"text":"እን እጀ አቦቲ ሙርቲሼ ንጃምሰ፤","poem":2},{"lineBreak":true},{"text":"ኩን ዮ እሰ ተኡ ባቴ፣ ኤጋ ኤኙሬ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“በር ጅሬኘኮ ነመ ፊጉ ጫላ አሪፈተ፤","poem":1},{"text":"ኡቱ ገመቹ ቶኮሌ ህንአርግን ደርበ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"እን አኩመ ብድሩ ዸላዱራ ሆጄተሜ፣","poem":1},{"text":"አኩመ ርሳ ዋ ቡተቹፍ ገድ በርሱ አሪፈተ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ዮ አን፣ ‘ጉንጉሚኮ ነንዺሰ፤","poem":1},{"text":"ኛረ ጉሩስ ዺሴ ነንሴቀ’ ጄዼ፣","poem":2}]},{"type":"verse","number":28,"content":[{"text":"አን አመዩ ዽጵነኮ ሁንደ ነንሶዳዸ፤","poem":1},{"text":"አከ አት አከ ነመ በሌሳ ህንቀብኔት ነ ህንሄድኔ ነንቤካቲ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ኤርገ የከማ ተኡንኮ ቤከሜ፣","poem":1},{"text":"አን ማሊፍን አከሱማን ደዸበሬ?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ኡቱመ አን ሳሙናዻን ዽቀዼ","poem":1},{"text":"ሀንዶዴዻንስ ሀርከኮ ቁልቁሌፈዼዩ፣","poem":2}]},{"type":"verse","number":31,"content":[{"text":"አት ሀመ ኡፈትንኮስ ነ በልፉት፣","poem":1},{"text":"ቦለ ኬሰ ነ ዽዽምስተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"“አከ አንሳ ዴብሱፊ መነ ሙርቲትስ ወል ፈልምኑፍ፣","poem":1},{"text":"እን አከኮ ነመ ፎኒ ምት።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ኡቱ ነምን ኑ ለማንረ ሀርከ ካኡ፣","poem":1},{"text":"ከን ግዱኬኘትስ አራረ ቡሱ ቶኮ ጅራቴ፣","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ኡቱ ዋቅን ኡሌሳ ነራ ካሴ","poem":1},{"text":"ስላ ናስሱንሳ ነ ህንሶዳችሱ ቱሬ።","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ስላ አን ኡቱን እሰ ህንሶዳትን ነንዱበዸን ቱሬ፤","poem":1},{"text":"ሃለን አመ ኬሰ ጅሩን ገሩ ህንደንደኡ።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOB/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOB/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/8.json","previousChapterAudioLinks":{},"numberOfVerses":35}