{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOL","translationId":"gaz_ebi","name":"ዮኤል","commonName":"ዮኤል","title":"ራጂ ዮኤል","order":29,"numberOfChapters":3,"sha256":"16536dda2ec9109093fcc45c05843d75fa3e914e05e6ea4ea70c3c498a57ec97","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gaz_ebi/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["ዱቢ ዋቀዮ ከን ገረ ዮኤል እልመ ጴቱኤል ዹፌ።"]},{"type":"line_break"},{"type":"heading","content":["ዌረረ ሀዋንሳ"]},{"type":"verse","number":2,"content":[{"text":"ያ ማንጉዶተ፣ ዋን ከነ ዸገኣ፤","poem":1},{"text":"ወር ብየቲ ኬሰ ጅራተን ሁንድኑ ዸጌፈዻ።","poem":2},{"text":"ወን አከና ተኩማ በረኬሰን ኬሰ","poem":1},{"text":"ዮካን በረ አቦቲኬሰኒ ኬሰ ተኤ ቤካ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እስን ዋን ከነ እጆሌኬሰንት ህማ፤","poem":1},{"text":"እጆሌንኬሰንስ እጆሌ ኦፊሳኒት ሃህመን፤","poem":2},{"lineBreak":true},{"text":"እጆሌንሳኒሞ ዸሎተ እት ኣኑት ሃደበርሰን።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዋን ቱትን ሀዋንሳ ዺሴ፣","poem":1},{"text":"ሀዋንስን ጉዳን ፍጤ፤","poem":2},{"text":"ዋን ሀዋንስን ጉዳን ዺሴ፣","poem":1},{"text":"ሀዋንስን ጥጥናን ኛቴ ፍጤ፤","poem":2},{"text":"ዋን ሀዋንስን ጥጥናን ዺሴሞ","poem":1},{"text":"ሀዋንስን ብራ ዹፌ ኛቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ያ መቾፍቶተ፣ ከኣቲ ቦኣ!","poem":1},{"text":"እስን ወር ዳዺ ወይኒ ዹግደንሁንድኑ ወዋዻ፤","poem":2},{"text":"ሰበቢ ዳዺ ወይኒ ሃራቲፍወዋዻ፤","poem":1},{"text":"እን አፋንኬሰንራ ቡተሜራቲ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሰብን ጀባን አከ መሌ ባይኤን ቶኮ","poem":1},{"text":"ብየኮ ዌረሬረ፤","poem":2},{"text":"እን እልካን ሌንጫ፣","poem":1},{"text":"ቀርፋ ሌንጨ ዸላ ቀበ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እን ሙከ ወይኒኮ ኦንሴ","poem":1},{"text":"ሀርቡኮስ በርበዴሴረ።","poem":2},{"text":"እን ቆለሳኒራ ቁንጭሴ ለፈት ገቴ","poem":1},{"text":"ደሜሌሳኒ ዱዋ ሀምብሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"እስን አኩመ ዱርበ ወያ ገዳ ኡፈቴ","poem":1},{"text":"ዽርሰ እጆሉማሼቲፍ ገድቱት ቦኣ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኬናን ምዻኒቲፊ ዽባዩን","poem":1},{"text":"መነ ዋቀዮራ ጭተኒሩ።","poem":2},{"text":"ሉቦትን ፉለ ዋቀዮ ዱረ ተጃጅለን","poem":1},{"text":"ቦኣ ጅሩ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ለፍት ቆቲሳ ኦኔረ፤","poem":1},{"text":"ለፍትስ ጎጌረ፤","poem":2},{"text":"ምዻን በርበዳኤረ፤","poem":1},{"text":"ዳዺን ወይኒ ሃራን ዹሜረ፤","poem":2},{"lineBreak":true},{"text":"ዘይቲንስ ዸበሜረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ያ ቆናን ቡልቶተ፣ እስን ራፈማ፤","poem":1},{"text":"ወር ወይኒ ዻበተን ቦኣ፤","poem":2},{"text":"ሰበቢ ምዻን ለፈ ቆቲሳኬሰኒ","poem":1},{"text":"በርበዳኤፍ ቀመዲፊ ገርቡዻፍ ቦኣ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ወይኒን ጎጌረ፤","poem":1},{"text":"ሀርቡንስ ጮለጌረ፤","poem":2},{"text":"ሮማኒን፣ ሜጢፊ ሁዻን፣","poem":1},{"text":"ሙኬን ለፈ ቆቲሳ ሁንድኑ ጎገኒሩ።","poem":2},{"text":"ዹጉማን ገመቹን እልማን ነማ","poem":1},{"text":"እራ በዴረ።","poem":2}]},{"type":"heading","content":["ዋምቸ ቀልቢ ጅጂረቹ"]},{"type":"verse","number":13,"content":[{"text":"ያ ሉቦተ፣ ወያ ገዳ ኡፈዻቲ ቦኣ፤","poem":1},{"text":"እስን ወር እዶ ኣርሳ ዱረ ተጃጅልተን ወዋዻ።","poem":2},{"text":"እስን ወር ፉለ ዋቀኮ ዱረ ተጃጅልተን","poem":1},{"text":"ኮታቲ ወያ ገዳ ኡፈዻ ቡላ፤","poem":2},{"text":"ኬናን ምዻኒቲፊ ዽባዩን","poem":1},{"text":"መነ ዋቃራ ሀምብፈመኒሩቲ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሶመ ቁልቁሉ ለብሳ፤","poem":1},{"text":"ወልዳ ቁልቁሉ ዋማ።","poem":2},{"text":"ማንጉዶታፊ","poem":1},{"text":"ወረ ብየቲ ኬሰ ጅራተን ሁንደ","poem":2},{"text":"ገረ መነ ዋቀዮ ዋቀኬሰኒት ዋማቲ","poem":1},{"text":"ዋቀዮት ቦኣ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"በድኔካ! ጉያን ሱን ዽኣቴረ።","poem":1},{"text":"ጉያን ዋቀዮ ገኤራቲ፤","poem":2},{"lineBreak":true},{"text":"እን አኩመ በዲሳትዋቀ ዋን ሁንደ ደንደኡ ብራ ዹፈ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"እጁመኬኘ ዱረት","poem":1},{"text":"ኛትን ጭቴ፤","poem":2},{"text":"እልሌፊ ገመቹንስ","poem":1},{"text":"መነ ዋቀኬኛራ ህንጭትኔ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሰኚን ለፈ ኬሰት","poem":1},{"text":"ቶርቶሬ ሀፌ።","poem":2},{"text":"መንኩስን ዲገሜረ፤","poem":1},{"text":"ጎምብሳን ጨጨቤረ፤","poem":2},{"lineBreak":true},{"text":"ምዻን ጎጌ ሀፌራቲ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሎን አከም መርአቱ!","poem":1},{"text":"ከር ሎኒ ሰበቢ ዋን ዼዱ ዸቤፍ","poem":2},{"text":"አሲፊ አች ጆረ፤","poem":1},{"text":"ቡሻዬንስ ዽጰተኒሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ያ ዋቀዮ አን ስን ዋመዸ፤","poem":1},{"text":"እብድ ለፈ ዼዳ በርበዴሴ","poem":2},{"lineBreak":true},{"text":"አረብን እብዳሞ ሙኬን ዲዳ ሁንደ ጉቤ ፍጤራቲ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ብኔንሶትን ቦሶና ስት ገገቡ፤","poem":1},{"text":"ለግን ብሻኒ ጎጌረ፤","poem":2},{"lineBreak":true},{"text":"እብድስ ድሬ ዼዳ ጉቤ በሌሴረ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}