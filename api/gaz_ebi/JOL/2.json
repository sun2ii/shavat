{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOL","translationId":"gaz_ebi","name":"ዮኤል","commonName":"ዮኤል","title":"ራጂ ዮኤል","order":29,"numberOfChapters":3,"sha256":"16536dda2ec9109093fcc45c05843d75fa3e914e05e6ea4ea70c3c498a57ec97","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gaz_ebi/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["ራያ ሀዋንሳ"]},{"type":"verse","number":1,"content":[{"text":"ጥዮን ኬሰት መለከተ አፉፋ፤","poem":1},{"text":"ጋረኮ ቁልቁሉረት ሰገሌአኬከቺሳ ዸጌስሳ።","poem":2},{"lineBreak":true},{"text":"ጉያን ዋቀዮ ዹፋ ጅራቲ፤","poem":1},{"text":"ወር ለፈረ ጅራተን ሁንድ ሃሆለተን።","poem":2},{"text":"ጉያን ሱን ዽኣቴረ፤","poem":1}]},{"type":"verse","number":2,"content":[{"text":"ጉያን ዱከናቲፊ ድምምሳ፣","poem":2},{"lineBreak":true},{"text":"ጉያን ዱሜሳቲፊ ዱከነ ሀማ ንዹፈ።","poem":2},{"text":"ሰብን ጉዳፊ ጀባን ቶኮ","poem":1},{"text":"አኩመ እፈ ገነመ ቱሉወንረት በኡት ንዹፈ፤","poem":2},{"text":"ወን አከሲ ተኩማ በረ ዱሪ ኬሰ ተኤ ህንቤኩ","poem":1},{"text":"ዮካን ዸሎተ ዹፉፍ ጅሩ ኬሰትሌ ህንተኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ፉለሳኒ ዱራ እብድ ንበርበዴሰ፤","poem":1},{"text":"ዱግደሳኒ ዱባንሞ አረበ እብዳቱ ቦበአ።","poem":2},{"text":"ፉለሳኒ ዱራን ለፍት እዶ ብቅልቱ ኤዴን ፈካተ፤","poem":1},{"text":"ዱግደሳኒ ዱባንሞ ለፍት አኩመ ገሞጂ ኦኔት፤","poem":2},{"lineBreak":true},{"text":"ወን ቶኮዩ እሳን ዱራ ህንምልቁ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እሳን ብፈ ፈርዴኒ ቀቡ፤","poem":1},{"text":"አኩመ ፈርዴን ሎላስ ንጉሉፉ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እሳን ሰገሌ አከ ጋሪ ወራናቲን","poem":1},{"text":"ፊጤ ቱሉረ ኡታሉ፤","poem":2},{"text":"አኩመ እብደ ዬሮ ቀርሚ ጉቡት ጣጠኡ፣","poem":1},{"text":"አኩመ ወራነ ጀባ ሎላፍ በኤ ቶኮት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ሰቦትን ጀረ አርግኒ ዽጰቱ፤","poem":1},{"text":"ፉል ነመ ሁንዳስ ንጉራቸአ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እሳን አኩመ ነሞተ ጀጀቦ ፊጉ፤","poem":1},{"text":"አኩመ ሎልቶታ ደላ ያበተኒ ሴኑ።","poem":2},{"text":"ሁንድሳኒ ተሬ ገለኒ ዴሙ፤","poem":1},{"text":"እሳን ኬሳ ቶኮዩ ዳንዲሳራ ህንጀልአቱ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እሳን ወል ህንዺበን፤","poem":1},{"text":"ሁንድሳኒ ቀጄለኒ ፉለ ዱረት ዴሙ።","poem":2},{"text":"ኡቱ ቶረሳኒ ህንዺስን","poem":1},{"text":"እትሰ ጨብሰኒ ሴኑ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እሳን መጋላ ኬሰ አሲፊ አች ፊጉ፤","poem":1},{"text":"ደላረ ፊጉ።","poem":2},{"text":"እሳን መነ ያበቱ፤","poem":1},{"text":"አኩመ ሀቱስ ፎዳዻን ኦል ሴኑ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ፉለሳኒ ዱረት ለፍት ንሶቾት፤","poem":1},{"text":"ሰሚን ንራፈመ፤","poem":2},{"text":"አዱፊ ጅእ ንዱከናኡ፤","poem":1},{"text":"ኡርጂወን ዴብአኒ ህንእብሰን።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዋቀዮ ፉለ ሎልቶተሳ ዱረት","poem":1},{"text":"ሰገሌ ዸጌስሰ፤","poem":2},{"text":"ሎልቶትንሳ አከ መሌ ባይኤዸ፤","poem":1},{"text":"ወር አጀጀሳ ኤገን ጀጀቦዸ።","poem":2},{"text":"ጉያን ዋቀዮ ጉዳዸ፤","poem":1},{"text":"ጉያን ሱን አከ መሌ ነመ ሶዳችሰ።","poem":2},{"lineBreak":true},{"text":"ኤኙቱ ዱረ ዻበቹ ደንደአ?","poem":2}]},{"type":"heading","content":["ጩቡራ ዴብኣ"]},{"type":"verse","number":12,"content":[{"text":"“አመዩ ገራ ጉቱዻን፣","poem":1},{"text":"ሶማን፣ ቦእቻፊ ገዳን","poem":2},{"lineBreak":true},{"text":"ገረኮት ዴብኣ” ጄዸ ዋቀዮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"እስን ኡቱ ወያኬሰን ህንተእን","poem":1},{"text":"ገራኬሰን ተርሳሳ።","poem":2},{"text":"ገረ ዋቀዮ ዋቀኬሰኒት ዴብኣ፤","poem":1},{"text":"እን አርጃፊ ገረ ላፌሳቲ፤","poem":2},{"text":"እን ደፌ ህንኣሩ፤ ጃለልሳ ባይኤዸ፤","poem":1},{"text":"እን በዲሰ ኤርጉራ ኦፍ ቁሰተ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ማልቱ ቤከ? ተሪ እን ዴብኤ ጋቤ","poem":1},{"text":"ኤበ፣ ኬና ምዻኒቲፊ ኬና ዹጋቲ","poem":2},{"text":"ከን ዋቀዮ ዋቀኬሰኒፍ ተኡ","poem":1},{"text":"እስኒፍ ሀምብሰ ተአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ጥዮን ኬሰት መለከተ አፉፋ፤","poem":1},{"text":"ሶመ ቁልቁሉ ለብሳ፤","poem":2},{"lineBreak":true},{"text":"ወልዳ ቁልቁሉ ዋማ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሰበ ወልት ቀባ፤","poem":1},{"text":"ወልዳ ሰነ ቁልቁሌሳ፤","poem":2},{"text":"ማንጉዶተ ወልት ፍዳ፤","poem":1},{"text":"እጆሌ ወልት ቀባ፤","poem":2},{"lineBreak":true},{"text":"ዳእመን ሀርመ ሆዸንሌ ህንሀምብስና።","poem":2},{"text":"ምስርች ኩታሳ ኬሳ ሃበኡ፤","poem":1},{"text":"ምስርቲንስ ዲንቀሼቲ ሃባቱ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሉቦትን ፉለ ዋቀዮ ዱረ ተጃጅለን","poem":1},{"text":"ገርዳፎፊ እዶ ኣርሳ ግዱት ሃቦአን።","poem":2},{"text":"እሳን አከነ ሃጄዸን፤ “ያ ዋቀዮ ሰበኬ በራር።","poem":1},{"text":"ሀንዹራኬ ዋን ቆሳ፣","poem":2},{"lineBreak":true},{"text":"ሰቦተ ግዱትስ ዋን ኮልፋ ህንጎዽን።","poem":2},{"text":"እሳን ማሊፍ ነሞተ ግዱት፣","poem":1},{"text":"‘ዋቅንሳኒ ኤሰ ጅረ?’ ጄዹ?”","poem":2}]},{"type":"heading","content":["ዴቢ ዋቀዮ ኬኔ"]},{"type":"verse","number":18,"content":[{"text":"ዋቀዮ ብየሳቲፍ ንህናፈ፤","poem":1},{"text":"ሰበሳቲፍስ ገራ ላፈ።","poem":2}]},{"type":"verse","number":19,"content":["ዋቀዮ አከነ ጄዼ ዴቢ ኬናፍ፦",{"text":"“አን ምዻን፣ ዳዺ ወይኒ ሃራፊ ዘይቲ ኤጄርሳ","poem":1},{"text":"ከን እስን ቁብሱ እስኒፍ ነንኤርገ፤","poem":2},{"text":"አን ለመተ ሰቦተ ግዱት","poem":1},{"text":"ዋን ቆሳ እስን ህንጎዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“አን ሎልቶተ ካባ እስን ዱራ በሌሴ","poem":1},{"text":"ገረ ለፈ ጎጋፊ ዱዋት እሳን አርአ፤","poem":2},{"text":"ሎልቶትን ፉለ ዱራን ያአን ገላነ በአ ቢፍቱ፣","poem":1},{"text":"ከኔን ዱግደ ዱባን ያአንሞገላነ ገመ ልጠ ቢፍቱ ሴኑ።","poem":2},{"text":"ሬፍሳኒ ንጥራአ፤","poem":1},{"text":"ጥራንሳኒስ ኦል በአ።”","poem":2},{"lineBreak":true},{"text":"ዹጉማን እን ዋን ጉዳ ሆጄቴረ!","poem":1}]},{"type":"verse","number":21,"content":[{"text":"ያ ብየ ይሁዳ፣ ህንሶዳትን፤","poem":2},{"lineBreak":true},{"text":"ገመዲቲ እልልች።","poem":2},{"text":"ዋቀዮ ዹጉማን ዋን ጉዳ ሆጄቴረ!","poem":1}]},{"type":"verse","number":22,"content":[{"text":"ያ ብኔንሶተ ቦሶና፣ እስንስ ህንሶዳትና፤","poem":2},{"lineBreak":true},{"text":"ድሬን ዼዳ ገበቻ ጅራቲ።","poem":2},{"text":"ሙኬን እጀ ነቀቻ፣","poem":1},{"text":"ሀርቡፊ ወይኒንስ እጀ ኬና ጅሩ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ያ ኡመተ ጥዮን ገመድ፤","poem":1},{"text":"ዋቀዮ ዋቀኬት ገመድ፤","poem":2},{"text":"እን ቀጄሉማዻን","poem":1},{"text":"ሮበ አርፋሳ ሲፍ ኬኔራቲ።","poem":2},{"text":"እን አኩመ ዱሪ ቦካ ባይኤ፣","poem":1},{"text":"ሮበ አርፋሳፊ ከን ብራ ሲፍ ኤርገ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ኦብዲን ምዻኒን ጉተመ፤","poem":1},{"text":"ቦል እት ወይኒ ጩንፈንስ ዳዺ ወይኒ ሃራፊዘይቲዻን ጉተመኒ ዸንገላሱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“አን ዋን በረ ሀዋንስን ኛቴ፣","poem":1},{"text":"ዋን ሀዋንስን ጉርጉዳፊ ጥጥናን ኛቴ፣","poem":2},{"lineBreak":true},{"text":"ዋን ሀዋንስን ካኒፊ ቱትን ሀዋንሳ","poem":2},{"text":"ጄቹንስ ሎልቶትንኮ ጀጀቦን አን ግዱኬሰንት ኤርጌ ሱን ኛተንእዶ እስኒፍ ነንቡሰ።","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"እስን ዋን ሀመ ቁፍተንት ኛተን ባይኤ ንቀባቱ፤","poem":1},{"text":"መቃ ዋቀዮ ዋቀኬሰኒ","poem":2},{"lineBreak":true},{"text":"ከን ዋን ድንቂ እስኒፍ ሆጄቴ ሰና ንገለቴፈቱ፤","poem":2},{"text":"ኡመትንኮ ለመተ ህንቃኔፈሙ።","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ኤርገሲ እስን አከ አን እስራኤል ኬሰ ጅሩ","poem":1},{"text":"አከ አን ዋቀዮ ዋቀኬሰን ተኤ፣","poem":2},{"lineBreak":true},{"text":"አከ አነ መሌ ዋቅን ብራ ህንጅሬ ንቤክቱ፤","poem":2},{"text":"ኡመትንኮ ለመተ ህንቃኔፈሙ።","poem":1}]},{"type":"heading","content":["ጉያ ዋቀዮ"]},{"type":"verse","number":28,"content":[{"text":"“አንስ ከነ ቦዴ፣","poem":1},{"text":"ሀፉረኮ ነመ ሁንደረት ነንዸንገላሰ።","poem":2},{"text":"እልማኒፊ እንተለንኬሰን ራጂ ዱበቱ፤","poem":1},{"text":"ጃርሶሊንኬሰን አብጁ አብጆቱ፤","poem":2},{"lineBreak":true},{"text":"ደርገጎትንኬሰን ሙልአተ አርጉ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"በረ ሰነ ኬሰ፣ ገርቦተኮ","poem":1},{"text":"ወረ ዺራፊ ዱበርቲረትሌ","poem":2},{"lineBreak":true},{"text":"ሀፉረኮ ነንዸንገላሰ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"አን ኦል ሰሚረት ድንቂ፣","poem":1},{"text":"ገድ ለፈረትስ ዺገ፣","poem":2},{"lineBreak":true},{"text":"እብዳፊ ሁሪ ኣራ ነንአርግሲሰ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ኡቱ 