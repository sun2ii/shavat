{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JOL","translationId":"gaz_ebi","name":"ዮኤል","commonName":"ዮኤል","title":"ራጂ ዮኤል","order":29,"numberOfChapters":3,"sha256":"16536dda2ec9109093fcc45c05843d75fa3e914e05e6ea4ea70c3c498a57ec97","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gaz_ebi/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["ሰቦተት ሙረሜ"]},{"type":"verse","number":1,"content":[{"text":"“በረ ሰነ ኬሰ፣ ዬሮ ሰነት፣","poem":1},{"text":"አን ዮሙን ቦጁ ይሁዳቲፊዬሩሳሌም ዴብሱት፣","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሰቦተ ሁንደ ወልት ቀቤን","poem":1},{"text":"ገረ ሱሉለ ዬሆሻፋጥትገድ እሳን ነንቡሰ።","poem":2},{"text":"አንስ አችት ሰበቢ ዻለኮ፣","poem":1},{"text":"ሰበቢ እስራኤሊፍ እሳንት ነንሙረ፤","poem":2},{"text":"እሳን ሰቦተ ግዱት ሰበኮ","poem":1},{"text":"ብትኔሰኒ ብየኮስ ገርገር ቆደተኒሩቲ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እሳን ኡመተኮት እጣ ቡፈተኒ","poem":1},{"text":"እጆሌ ዺራስ ሰጋገሉማት ጌደረተኒሩ፤","poem":2},{"lineBreak":true},{"text":"አከ ዹገኒፍ ዱበረሌ ዳዺ ወይኒት ጉርጉረተን።","poem":2}]},{"type":"verse","number":4,"content":["“ያ ጢሮሲፊ ሲዶና፣ እስን ኩታሌን ፍልስጤም ሁንድኑ፣ አመ ማል ነራ ቀብዱ? እስን ዋን አን ጎዼፍ ሃሎ ነ ባፈቻ ጅርቱ? ዮ እስን ሃሎ ነ ባፈቻ ጅርቱ ተኤ አን ደፌ አሪቲዻን ዋን እስን ሆጄተን ሰነ መቱመኬሰንት ዴብሰ።"]},{"type":"verse","number":5,"content":["እስን ሜቲፊ ወርቄኮ ጉረተኒ ቀቤኘኮ ፍለተማስ መነ ዋቄፈትናኬሰንት ጌፈተኒርቱቲ።"]},{"type":"verse","number":6,"content":["እስን ብየሳኒራ እሳን ፈጌስተኒ ኡመተ ይሁዳቲፊ ዬሩሳሌም ግሪኮተት ጉርጉረተን።"]},{"type":"verse","number":7,"content":["“ኩኖ፣ አን ብየ እስን እት እሳን ጉርጉረተን ኬሳ እሳን ባሴ ዋን እስን ሆጄተን ሰነ መቱመኬሰንት ነንዴብሰ።"]},{"type":"verse","number":8,"content":["አን እልማኒፊ እንተለንኬሰን ሰበ ይሁዳት ነንጉርጉረ፤ እሳንሞ ሰበ ፈጎ ጅሩ ከን ሳባ ጄዸሙት ደበርሰኒ እሳን ጉርጉረቱ።” ዋቀዮ ዱበቴራቲ።"]},{"type":"verse","number":9,"content":[{"text":"ዋን ከነ ሰቦተ ግዱት ለብሳ፦","poem":1},{"text":"ወራናፍ ቆጳኣ!","poem":2},{"text":"ጎቶተ ከካሳ!","poem":1},{"text":"ሎልቶትን ሁንድ ዽኣተኒ ሃሎለን።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ማረሻኬሰን ቱማቲ ጎራዴ ጎዸዻ፤","poem":1},{"text":"ሃምቱኬሰንስ ቱማቲ ኤቦ ጎዸዻ።","poem":2},{"text":"ነምን ላፋን፣","poem":1},{"text":"“አን ጀባዸ!” ሃጄዹ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እስን ሰቦትን ቅጠ ሁንዳን ደፋ ኮታቲ","poem":1},{"text":"አችት ወልት ቀበማ።","poem":2},{"lineBreak":true},{"text":"ያ ዋቀዮ፣ ሎልቶተኬ ገድ ኤርግ!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ሰቦትን ሃከአን፤","poem":1},{"text":"እሳን ደፈኒ ገረ ሱሉለ ዬሆሻፋጥ ሃዹፈን፤","poem":2},{"text":"አን ሰቦተ ገመ ሁንዳን ጅረንት ሙሩፍ","poem":1},{"text":"አች ነንታኣቲ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ምዻን ገኤራቲ","poem":1},{"text":"ሃምቱ እት ካኣ።","poem":2},{"text":"ኮታቲ እጀ ወይኒ ዽዺታ፤","poem":1},{"text":"ቦል እት ወይኒ ጩንፈን ጉቴራቲ፤","poem":2},{"lineBreak":true},{"text":"ሰበቢ ሀምንሳኒ ጉዳ ተኤፍ","poem":2},{"text":"ቦል እት ወይኒ ጩንፈን ጉቴረ ዸንገለኤረ!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ወልዳን ጉዳን፣ ወልዳን ነመ ባይኤ","poem":1},{"text":"ሱሉለ ሙርቲ ኬሰት ወል ገኤረ!","poem":2},{"text":"ጉያን ዋቀዮ","poem":1},{"text":"ሱሉለ ሙርቲ ኬሰት ዹፉ ገኤራቲ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ቢፍቱፊ አዴስ ንዱከናኡ፤","poem":1},{"text":"ኡርጂወንስ ስአች እፈ ህንኬነን።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዋቀዮ ጥዮንራ ንእየ፤","poem":1},{"text":"ዬሩሳሌም ኬሳስ ሰገሌ ዸጌስሰ፤","poem":2},{"lineBreak":true},{"text":"ለፋፊ ሰሚን ንራፈሙ።","poem":2},{"text":"ዋቀዮ ገሩ ሰበሳቲፍ እዶ እት በቀተን፣","poem":1},{"text":"ሰበ እስራኤሊፍሞ ደኦ ንተአ።","poem":2}]},{"type":"heading","content":["ኤበ ሰበ ዋቃቲፍ ኬነሜ"]},{"type":"verse","number":17,"content":[{"text":"“ኤርገሲ እስን አከ አን ዋቀዮ ዋቅንኬሰን ጥዮን ኬሰ፣","poem":1},{"text":"ጋረኮ ቁልቁሉ ሰነረ ጅራዹ ንቤክቱ።","poem":2},{"text":"ዬሩሳሌም ቁልቁሉ ታት፤","poem":1},{"text":"ነሞትን ብየ አላ ጎንኩማ ለመተ እሼ ህንዌረረን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“ጋፈስ ቱሉወን ዳዺ ወይኒ ሃራ ንጮጮብሱ፤","poem":1},{"text":"ጋረንስ ኣነን ያሱ፤","poem":2},{"lineBreak":true},{"text":"ለጌን ይሁዳ ሁንድኑ ብሻኒን ጉተሙ።","poem":2},{"text":"ቡርቃን ቶኮ መነ ዋቀዮ ኬሳ","poem":1},{"text":"ቡርቄ ሱሉለ ሽጢም ንኦባሰ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ግብጥ ገሩ ንኦንት፤","poem":1},{"text":"ኤዶምስ ዱዋ ሀፍት፤","poem":2},{"text":"እሳን ዺገ ነመ የከ ህንቀብኔ ብየቲ ኬሰትዸንገላሱዻን","poem":1},{"text":"ሰበ ይሁዳት ደበ ሆጄተኒሩቲ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ይሁዳን በረ በራን፣","poem":1},{"text":"ዬሩሳሌምስ ዸሎተ ሁንዳፍ እዶ ጅሬኛ ንታት።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አን ዺገሳኒ ከን የከ ህንቀብኔ ሰነ","poem":1},{"text":"ኡቱን ሃሎ ህንበእን ነንዺሳ?","poem":2},{"lineBreak":true},{"text":"ለኪ፣ ህንዺሱ።”","poem":2},{"lineBreak":true},"ዋቀዮ ጥዮን ኬሰ ጅራተ!"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}