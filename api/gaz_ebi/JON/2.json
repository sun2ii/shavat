{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"JON","translationId":"gaz_ebi","name":"ዮናስ","commonName":"ዮናስ","title":"ራጂ ዮናስ","order":32,"numberOfChapters":4,"sha256":"66162ca5f5f2f481a63a8898650be826b7b821d5af23ddcc50f54f364357880c","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/gaz_ebi/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["ከዸትና ዮናስ"]},{"type":"verse","number":1,"content":["ዮናስ ገራ ቁርጡሚ ኬሳ ዋቀዮን ዋቀሳ ከዸቴ።"]},{"type":"verse","number":2,"content":["እንስ አከነ ጄዼ፦",{"text":"“አን ረክነኮ ኬሰት ዋቀዮን ዋመዼ፤","poem":1},{"text":"እንስ ዴቢ ናፍ ኬኔ።","poem":2},{"text":"አን ገርጋርሰ በርባቸ ገራ ሲኦል ኬሳ ነንእዬ፤","poem":1},{"text":"አትስ እየኮ ናፍ ዸጌሴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አት ቱጁበት፣","poem":1},{"text":"ገራ ገላናት ገድ ነ ደርበቴ፤","poem":2},{"lineBreak":true},{"text":"ሎላንስ ነ መርሴ፤","poem":2},{"text":"ደምበሊፊ ዸኣንኬ","poem":1},{"text":"ሁንድኑ ነረ ገረገለን።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አንስ፣ ‘ኩኖ አን ፉለኬ ዱራ በሌፈሜረ፤","poem":1},{"text":"ተኡስ አን ዴብኤ ገረ መነ ቁልቁሉማኬቲ","poem":2},{"lineBreak":true},{"text":"ቁልቁሉ ሰናን እላለ’ ነንጄዼ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ብሻኖትን ነ ሀጉገን፤","poem":1},{"text":"ቱጁብንሞ ነ መርሴ፤","poem":2},{"lineBreak":true},{"text":"አረማን ገላናስ መታት ነ መረሜ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አን ገረ ሁንዴ ቱሉወኒትን ገድ ልቅምፈሜ፤","poem":1},{"text":"በልበል ለፈ ጀላስ በረ በራን ነት ጩፈሜ።","poem":2},{"text":"ያ ዋቀዮ ዋቀኮ፣","poem":1},{"text":"አት ገሩ ሉቡኮ ቦለ ኬሳ ኦል ባፍቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ያ ዋቀዮ፣ ዬሮ ሉቡንኮ ደዸብዴት","poem":1},{"text":"አን ስን ያደዼ፤","poem":2},{"text":"ከዸናንኮስ ገረኬ","poem":1},{"text":"ገረ መነ ቁልቁሉማኬ ቁልቁልቻት ኦል በኤ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ወር ዋቆተ ቶልፈሞ ፋይዳ ህንቀብኔት ጭቸን","poem":1},{"text":"አራረ ዋቃራ ገረገሉ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አን ገሩ ፋርፈትና ገለታቲን","poem":1},{"text":"ኣርሳ ሲፍ ነንዽኤሰ።","poem":2},{"text":"አን ወሬገን ወሬጌ ሰነስ ነንባሰ።","poem":1},{"text":"አንስ፣ ‘ፈይን ዋቀዮ ብራ ዹፈ’ ” ነንጄዸ።","poem":2}]},{"type":"verse","number":10,"content":["ዋቀዮስ ቁርጡሚ ሰነ አጀጄ፤ ቁርጡሚን ሱንስ ለፈ ጎጋረት ዮናስን ቱፌ።"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}