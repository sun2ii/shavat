{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"LAM","translationId":"gaz_ebi","name":"ፋሩ","commonName":"ፋሩ","title":"ፋሩ ኤርምያስ","order":25,"numberOfChapters":5,"sha256":"4418abacaaf58e89ef11d175a933296ac6954dcbffce7e0aa47ba89f13a0fd7d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/gaz_ebi/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"መጋላን ዱር ነማን ጉተምቴ ቱርቴ ሱን","poem":1},{"text":"አከምት ኦንቴ ሀፍቴ!","poem":2},{"text":"እሼን ዬሮ ቶኮ ሰቦተ ግዱት ጉዶ ቱርቴ","poem":1},{"text":"አከምት አከ ሃዸ ህዬሳ ታቴ!","poem":2},{"text":"እሼን ኩታሌ ብያ ግዱት ሞቲ ቱርቴ ሱን","poem":1},{"text":"አመ ገርብቲ ታቴ ጅርት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"እሼን ሀልከን ሀልከን ህቅፈቴ ቦስ፤","poem":1},{"text":"መዲሼረ እምማንቱ ያአ።","poem":2},{"text":"ምቾተሼ ሁንደ ኬሳ","poem":1},{"text":"ከን እሼ ጀጀቤሱ ቶኮዩ ህንጅሩ።","poem":2},{"text":"ምቾትንሼ ሁንድኑ እሼ ገነኒሩ፤","poem":1},{"text":"እሳን ዲኖተሼ ተአኒሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ረክናፊ ጩንቁርፈመ ጉዳ ቦዴ","poem":1},{"text":"ይሁዳን ቦጅአምቴ ፉዸተምቴ ጅርት።","poem":2},{"text":"እሼን ሰቦተ ግዱ ጅራት፣","poem":1},{"text":"ለፈ እት ቦቆቱሌ ህንአርገትኔ።","poem":2},{"text":"ወር እሼ አርአን ሁንድ","poem":1},{"text":"ረክነሼ ኬሰት እሼ ቀበተን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ዳንዲወን ጥዮን ንቦኡ፤","poem":1},{"text":"ነምን አያነሼ ከን ሙርቴፈሜ ከበጁፍ ዹፉቶኮዩ ህንጅሩቲ።","poem":2},{"text":"ከረወንሼ ሁንድ ኦነኒ ጅሩ፤","poem":1},{"text":"ሉቦትንሼ ንኣዱ፤","poem":2},{"text":"ሸመረንሼ ንገዱ፣","poem":1},{"text":"እሼንስ ዽጵነ ጉዳ ኬሰ ጅርት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"አመጃጆንሼ ጎፍቶተሼ ተአኒሩ፤","poem":1},{"text":"ዲኖተሼት ቶሌረ።","poem":2},{"text":"ሰበቢ ጩቡሼ ባይኤ ሰናቲፍ","poem":1},{"text":"ዋቀዮ ገደ እት ፍዴረ።","poem":2},{"text":"እጆሌንሼ ፉዸተመኒ ዴመኒሩ፤","poem":1},{"text":"ፉለ አመጃጆተሼ ዱረት ቦጅአመኒሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"እንተለ ጥዮንራ","poem":1},{"text":"ሚዸግን ሁንድ ፉዸተሜረ።","poem":2},{"text":"እልማን ሞቶተሼ","poem":1},{"text":"አኩመ ገደምሰ ለፈ ዼዳ ዸቤ ተአኒሩ፤","poem":2},{"text":"እሳን ደዸቢዻን","poem":1},{"text":"ፉለ ወረ እሳን አርአኒ ዱረ በቀተን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"በሮተ ረክናፊ አሲ አች ጆሩሼ ኬሰ","poem":1},{"text":"ዬሩሳሌም ቀቤኘ","poem":2},{"lineBreak":true},{"text":"በረ ዱሪ ከንሼ ቱሬ ሁንደ ንያደት።","poem":2},{"text":"ዬሮ ነሞትንሼ ሀርከ ዲና ሴነንት","poem":1},{"text":"ነምን እሼ ገርጋሩ ቶኮዩ ህንቱሬ።","poem":2},{"text":"ዲኖትንሼ እሼ እላለኒ","poem":1},{"text":"በዲሰሼት ኮልፈን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ዬሩሳሌም አከ መሌ ጩቡ ሆጄቴ፤","poem":1},{"text":"አከሲንስ ጡሮፍቴ።","poem":2},{"text":"ወር ኡልፍነ ኬነኒፊ ቱረን ሁንድ እሼ ቱፈተን፤","poem":1},{"text":"እሳን ቁላት ሀፉሼ አርገኒሩቲ፤","poem":2},{"text":"እሼን መታንሼ ጉንጉምቴ","poem":1},{"text":"ኦፍረ ገረ ገልት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ጡራኡማንሼ ወንደቦሼት መጠኔ፤","poem":1},{"text":"እሼን ዋን ገረ ዱራት እት ዹፉ ህንያድኔ፤","poem":2},{"text":"ኩፋቲንሼ ነመ ርፈቺሰ፤","poem":1},{"text":"ከን እሼ ጀጀቤሱ ቶኮዩ ህንጅሩ ቱሬ።","poem":2},{"text":"“ያ ዋቀዮ ረክነኮ እላል፤","poem":1},{"text":"ዲን ሞአቴራቲ!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ቀቤኘሼ ሁንደት","poem":1},{"text":"ዲን ሀርከሳ ድሪርሴረ፤","poem":2},{"text":"እሼን ነሞተ ኦርማ","poem":1},{"text":"ወረ አት አከ እሳን","poem":2},{"text":"ወልዳኬ ህንሴኔ ዾውቴ ሰነ","poem":1},{"text":"ኡቱ እሳን እዶሼ ቁልቁሉ ሴነኑ አርግቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ነሞትንሼ ሁንድኑ ኡቱመ","poem":1},{"text":"ኣደኑ ቡዴነ በርባደቱ፤","poem":2},{"text":"እሳን ሉቡ ኦፊሳኒ ቱርፈቹፍ ጄቸ","poem":1},{"text":"ቀቤኘሳኒ ኛታን ጌደረቱ።","poem":2},{"text":"“ያ ዋቀዮ ነ እላል፣ ነ ያደዹስ፤","poem":1},{"text":"አን ቱፈተሜራቲ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ወረ ከራረ ደበርተን ሁንድ፣ ኩን እስኒፍ ሆማ ምቲ?","poem":1},{"text":"ናኖኬሰን እላላቲ አርጋ።","poem":2},{"text":"ረክን አከ ረክነኮ","poem":1},{"text":"ከን አን እቲን ረከዼ","poem":2},{"text":"ከን ዋቀዮ ጉያ ዼከምሰሳት","poem":1},{"text":"ነት ፍዴ ሰና ጅሩ ቶኮዩ ጅራ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“እን ኦል ጉባዻ እብደ ኤርጌ፤","poem":1},{"text":"እብደ ሰነ ለፌኮ ኬሰ ሴንስሰ።","poem":2},{"text":"እን ሚለኮቲፍ ክዮ ድሪርሴ","poem":1},{"text":"ዱግደ ዱበት ነ ዴብሴ፤","poem":2},{"text":"እን ኮጳት ነ ሀምብሴ","poem":1},{"text":"ጉያ ጉቱ ነ ደዸብሲሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ጩቡንኮ ዋንጆት ህዸሜረ፤","poem":1},{"text":"እሳን ሀርከሳቲን ወልት ፎአመን።","poem":2},{"text":"እሳን ሞርመኮት ረራፈመን፤","poem":1},{"text":"ጎፍታን ሁምነኮ ደዸብሲሴ።","poem":2},{"text":"እን ወረ አን ኦፍራ ዴብሱ ህንደንዴኜት","poem":1},{"text":"ደበርሴ ነ ኬኔረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“ጎፍታን ጎቶተ ነ ኬሰት አርገመን","poem":1},{"text":"ሁንደ ገቴረ፤","poem":2},{"text":"እን ደርገጎተኮ ጨጨብሱፍ","poem":1},{"text":"ያኢ ዋመቴ።","poem":2},{"text":"ጎፍታን እዶ ጩንፋ ወይኒሳት","poem":1},{"text":"ዱርበ ቁልቁልቲ እንተለ ይሁዳ ዽዺቴረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“ወን አን ቦኤ","poem":1},{"text":"እጅኮ እምማኒን ጉተሜፍ ከናዸ።","poem":2},{"text":"ነምን ነ ጀጀቤሱፍ ዽኦ ጅሩ ቶኮዩ ህንጅሩ፤","poem":1},{"text":"ከን ሀፉረኮ በየነቺሱስ ህንጅሩ።","poem":2},{"text":"ሰበቢ ዲን ሁምነ አርገቴፍ","poem":1},{"text":"እጆሌንኮ ሀርከ ዱዋ ሀፈን።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ጥዮን ሀርከሼ በልእፈቴ ጅርት፤","poem":1},{"text":"ገሩ ነምን እሼ ጀጀቤሱ ቶኮዩ ህንጅሩ።","poem":2},{"text":"አከ ኦሎንሳ አመጃጆተሳ ተአኒፍ","poem":1},{"text":"ዋቀዮ ያቆብት አጀጄረ፤","poem":2},{"text":"ዬሩሳሌምስ ግዱሳኒት","poem":1},{"text":"ዋን ጡራኣ ታቴርት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“ዋቀዮ ቀጄላዸ፤","poem":1},{"text":"ተኡስ አን አጀጀወንሳት ፍንጭሌን ቱሬ።","poem":2},{"text":"ያ ሰቦተ፣ ሁንድኬሰን ዸገኣ፤","poem":1},{"text":"ረክነኮስ እላላ።","poem":2},{"text":"ደርገጎትኒፊ ሸመረንኮ","poem":1},{"text":"ቦጅአመኒ ፉዸተመኒሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“አን ቱምስቶተኮ ነንዋመዼ፤","poem":1},{"text":"እሳን ገሩ ነ ገነን።","poem":2},{"text":"ሉቦትንኮፊ ማንጉዶትንኮ","poem":1},{"text":"ኡቱ ሉቡሳኒ ኦልፈቹፍ","poem":2},{"text":"ኛተ በርባደተኑ","poem":1},{"text":"መጋላ ኬሰት ዹመን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ያ ዋቀዮ አከ አን ዽጰዼ እላል!","poem":1},{"text":"አን ኬሰኮት ዽጰዼረ፤","poem":2},{"text":"ገራኮ ኬሰት ራፈሜረ፤","poem":1},{"text":"አን ነመ አከ መሌ ፍንጭሉን ቱሬቲ።","poem":2},{"text":"አላ ጎራዴን ነመ ቀለ፤","poem":1},{"text":"መነ ኬሰሞ ዱአ ቆፈቱ ጅረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“ነሞትን አከ አን ኣዳ ጅሩ ዸገአኒሩ፤","poem":1},{"text":"ከን ነ ጀጀቤሱ ገሩ ህንጅሩ።","poem":2},{"text":"ዲኖትንኮ ሁንድኑ ረክነኮ ዸገአኒሩ፤","poem":1},{"text":"እሳን ዋን አት ጎቴት ገመደኒሩ።","poem":2},{"text":"አከ እሳን አኩመኮ ተአኒፍ","poem":1},{"text":"ማሎ አት ጉያ ጄቴ ሰነ ፍድ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“ሀምንሳኒ ሁንድኑ","poem":1},{"text":"ፉለኬ ዱረት ሃዽኣቱ፤","poem":2},{"text":"ዋኑመ ሰበቢ ጩቡኮ ሁንዳቲፍ ነት ፍዴ ሰነ","poem":1},{"text":"እሳንትሌ ፍድ!","poem":2},{"text":"ኣዱንኮ ባይአቴራቲ፤","poem":1},{"text":"ኦኔንኮስ ደዸብዴርት።”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}