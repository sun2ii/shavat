{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"LAM","translationId":"gaz_ebi","name":"ፋሩ","commonName":"ፋሩ","title":"ፋሩ ኤርምያስ","order":25,"numberOfChapters":5,"sha256":"4418abacaaf58e89ef11d175a933296ac6954dcbffce7e0aa47ba89f13a0fd7d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/gaz_ebi/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"ጎፍታን አከምት ዱሜሰ ዼከምሰሳቲን","poem":1},{"text":"እንተለ ጥዮን ሀጉጌ!","poem":2},{"text":"እን ኡልፍነ እስራኤል","poem":1},{"text":"ሰሚዻ ለፈት ገድ ደደርበቴረ፤","poem":2},{"text":"እን ጉያ ዼከምሰሳት","poem":1},{"text":"ኤጄተ ሚለሳ ህንያደትኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ጎፍታን ገረ ላፍነ ቶኮ መሌ","poem":1},{"text":"እዶ ጅሬኘ ያቆብ ሁንደ ልቅምሴ ጅረ፤","poem":2},{"text":"ደአኖ እንተለ ይሁዳስ","poem":1},{"text":"ዼከምሰሳቲን ዲጌ።","poem":2},{"text":"እን ሞቱማሼቲፊ ቡልችቶተሼ","poem":1},{"text":"ሰልጵሴ ለፈት ገድ ዴብሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"እን ዼከምሰ ሶዳችሳዻን","poem":1},{"text":"ጋንፈ እስራኤል ሁንደ ጨጨብሴ።","poem":2},{"text":"ዮሙ ዲን ዽኣቴትስ","poem":1},{"text":"ሀርከሳ ምርጋ ዱበት ዴብፈቴ።","poem":2},{"text":"እን አኩመ አረበ እብዳ ከን ዋን ናኖሳ ጅሩ ጉቡ ሰና","poem":1},{"text":"ያቆብ ኬሰት ቦበኤ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"እን አኩመ ዲናት እዳሳ ደብሰቴ፤","poem":1},{"text":"ሀርክሳ ምርጋ ቆጳኤረ።","poem":2},{"text":"ወረ እጀት በሬደን ሁንደ","poem":1},{"text":"አኩመ አመጃጂት ቀሌ፤","poem":2},{"text":"ዱንካነ እንተለ ጥዮንት","poem":1},{"text":"ዼከምሰሳ አኩመ እብዳ ሮብሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ጎፍታን አኩመ ዲና ተኤ፤","poem":1},{"text":"እን እስራኤልን ልቅምሴረ።","poem":2},{"text":"እን መሰራወንሼ ሁንደ ልቅምሴ","poem":1},{"text":"ደአኖሼ ጀባሌ ዲጌረ።","poem":2},{"text":"እን እንተለ ይሁዳት","poem":1},{"text":"ቦእቻፊ ፋሩ ቦእቻ ባይእሴረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"እን ለፈ ጅሬኘሳ አኩመ እዶ ብቅልቱ ኦንሴረ፤","poem":1},{"text":"እዶ ወል ገኢሳስ በሌሴረ።","poem":2},{"text":"ዋቀዮ አከ ጥዮን","poem":1},{"text":"አያነሼ ከን ሙርታኤፊ ሰንበቶተሼ እራንፈቱ ጎዼረ፤","poem":2},{"text":"እን ዼከምሰሳ ሶዳችሳ ሰናን","poem":1},{"text":"ሞቶታፊ ሉቦተ አከ መሌ ቱፈቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ጎፍታን እዶ ኣርሳሳ ቱፈቴረ፤","poem":1},{"text":"እዶ ቁልቁሉሳሌ ዺሴረ።","poem":2},{"text":"ደላወን መሰራወንሼ","poem":1},{"text":"ደበርሴ ሀርከ ዲኖታት ኬኔረ፤","poem":2},{"text":"እሳን አኩመ ጉያ አያነ ሙርቴፈሜት","poem":1},{"text":"መነ ዋቀዮ ኬሰት ሰገሌ ኦል ፉዸተኒ እየን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ዋቀዮ ደላ ናኖ እንተለ ጥዮን ጅሩ","poem":1},{"text":"ዲጉፍ ሙርቴሴረ።","poem":2},{"text":"እን ሰፈርቱ ድሪርሴረ፤","poem":1},{"text":"በርበዴሱራስ ሀርከሳ ህንዴብፈትኔ።","poem":2},{"text":"አከ ደላን ኤጉምሳቲፊ ኬኘን ፋርሰኒ ቦአን ጎዼ፤","poem":1},{"text":"እሳንስ ቶኩማዻን በደን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ከረወንሼ ለፈ ኬሰ ዽዽመኒሩ፤","poem":1},{"text":"እን ደንቀራወን ስቢለሼ ጨጨብሴ በሌሴረ።","poem":2},{"text":"ሞቲንሼቲፊ እልማን ሞቶተሼ ቦጅአመኒሰቦተ ግዱ ብብትናአኒሩ፤","poem":1},{"text":"ሴር ስአች ህንጅራቱ፤","poem":2},{"text":"ራጆትንሼስ ስአች","poem":1},{"text":"ዋቀዮ ብራ ሙልአተ ህንአርገን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ማንጉዶትን እንተለ ጥዮን","poem":1},{"text":"ጨልእሰኒ ለፈ ተታአን፤","poem":2},{"text":"እሳን ዳራ መታት ፍርፍርፈተኒ","poem":1},{"text":"ኡፈተ ገዳስ ኡፈተን።","poem":2},{"text":"ሸመረን ዬሩሳሌም","poem":1},{"text":"መታሳኒ ገድ ቀበተን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"እጅኮ ቦእቻን ደዸቤረ፤","poem":1},{"text":"ኬሰኮት ዽጰዼረ፤","poem":2},{"text":"ሰበቢ ሰብንኮ ዹሜፍ","poem":1},{"text":"ሰበቢ እጆሌፊ ዳእመን","poem":2},{"text":"ዳንዲወን መጋላረት ገገበኒፍ","poem":1},{"text":"ገራንኮ ገዳን ላፌረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"እሳን ዮሙ ዳንዲወን መጋላረት","poem":1},{"text":"አኩመ ነሞተ መዳአኒት ገገበንት፣","poem":2},{"text":"ዮሙ ሉቡንሳኒ","poem":1},{"text":"ሀሙ ሃዸሳኒረት በኡፍ ጅርቱት","poem":2},{"text":"“ቡዴኒፊ ዳዺን ወይኒ ኤሰ ጅሩ?”","poem":1},{"text":"ጄዸኒ ሃዾተሳኒ ጋፈቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ያ እንተለ ዬሩሳሌም፣","poem":1},{"text":"አን ማል ሲፍ ጄቹን ደንደአ?","poem":2},{"lineBreak":true},{"text":"ማሊነን ወል ስ ቅጤሰ?","poem":2},{"text":"ያ እንተለ ጥዮን ዱርበ ቁልቁልቲ","poem":1},{"text":"አን አከን ስ ጀጀቤሱፍ","poem":2},{"lineBreak":true},{"text":"ማልን ስ ፈኬሱ ደንደአ?","poem":2},{"text":"መዳንኬ አኩመ ገላና ገድ ፈጎዸ።","poem":1},{"text":"ኤኙቱ ስ ፈይሱ ደንደአ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ሙልአትን ራጆተኬቲ","poem":1},{"text":"ሶባፊ ከን ፋይዳ ህንቀብኔዸ፤","poem":2},{"text":"እሳን ቦጅአሙኬ ሀምብሱፍ","poem":1},{"text":"ጩቡኬ እፈ ህንባፍኔ።","poem":2},{"text":"ራጂን እሳን ሲፍ ኬነንስ","poem":1},{"text":"ሶባፊ ከን ከራራ ነመ በሌሱዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ወር ከራኬቲን ደርበን ሁንድኑ","poem":1},{"text":"ሀርከሳኒ ስት ሩሩኩቱ፤","poem":2},{"text":"እሳንስ እንተለ ዬሩሳሌምት","poem":1},{"text":"ቆሱፊ መታ ራሱዻን፣","poem":2},{"text":"“መጋላን ሙሜ ሚዸግና","poem":1},{"text":"ገመቹ ጉቱ ለፋ","poem":2},{"lineBreak":true},{"text":"ጄዸምቴ ዋመምቴ ሱን ከና?” ጄዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ዲኖትንኬ ሁንድኑ","poem":1},{"text":"አፋንሳኒ ስት በነቱ፤","poem":2},{"text":"እሳን ቆሱፊ እልካንሳኒ ቀሩዻን","poem":1},{"text":"“ኑ እሼ ልቅምስኔረ።","poem":2},{"text":"ጉያን ኑ ኤገቻ ቱሬ ሱን ከናዸ፤","poem":1},{"text":"ኑ ዋን ከነ አርጉፍ ጅራትኔረ” ጄዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ዋቀዮ ዋን ከሮርፈቴ ሆጄቴረ፤","poem":1},{"text":"ዱቢሳ ከን በረ ዼራን ዱረ","poem":2},{"lineBreak":true},{"text":"ዱበቴ ሰነ ጉተቴረ።","poem":2},{"text":"እን ገረ ላፍነ ቶኮ መሌ ስ ገረገልቼረ፤","poem":1},{"text":"አከ ዲንኬ ስት ገመዱ ጎዼረ፤","poem":2},{"lineBreak":true},{"text":"ጋንፈ አመጃጂኬቲ ኦል ኦል ቀቤረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ኦኔን ነሞታ","poem":1},{"text":"ገረ ጎፍታት እየ።","poem":2},{"text":"ያ ደላ እንተለ ጥዮን","poem":1},{"text":"ሀልከኒ ጉያ","poem":2},{"lineBreak":true},{"text":"እምማንኬ አከ ለጋ ሃያኡ፤","poem":2},{"text":"ቦቆና ቶኮሌ ኦፊኬቲፍ ህንኬንን፤","poem":1},{"text":"እጅኬስ ህንቦቆትን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ዮሙ ኤጉምስ ሀልከኒ ጀልቀቡት","poem":1},{"text":"ከኢቲ ሀልከኒን እይ፤","poem":2},{"text":"ፉለ ጎፍታ ዱረት","poem":1},{"text":"ኦኔኬ አከ ብሻኒ ዸንገላስ።","poem":2},{"text":"ሉቡ እጆሌኬቲ","poem":1},{"text":"ከኔን ፊጤ ዳንዲ ሁንዳት","poem":2},{"text":"ቤላን ገገበኒቲፍ ጄዺቲ","poem":1},{"text":"ሀርከኬ ገረሳት ኦል ቀበዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ያ ዋቀዮ፣ አት እላል፤ አርግስ፦","poem":1},{"text":"አት ተኩማ ኤኙረት ዋን አከሲ ጎቴ ቤክተ?","poem":2},{"text":"ሃዾትን ዳእመንሳኒ፣","poem":1},{"text":"እጆሌ ኩኑንሰኒ ጉድሰን ኛቹ ቀቡ?","poem":2},{"text":"ሉብኒፊ ራጂን፣","poem":1},{"text":"እዶ ቁልቁሉ ከን ጎፍታ ኬሰት አጄፈሙ ቀቡ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“ደርገጎትኒፊ ማንጉዶትን፣","poem":1},{"text":"ወሊ ወጅን አዋረ ከራረ ጪሱ፤","poem":2},{"text":"ደርገጎትኒፊ ሸመረንኮ","poem":1},{"text":"ጎራዴዻን አጄፈመኒሩ።","poem":2},{"text":"አት ጋፈ ዼከምሰኬቲት እሳን ፍጤ፤","poem":1},{"text":"ገረ ላፍነ ቶኮ መሌ እሳን ቀልቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“አት አኩመ ጉያ አያነ ሙርቴፈሜት ነመ ዋምቱት","poem":1},{"text":"ቅጠ ሁንዳኑ ሶዳ ነት ዋምቴ።","poem":2},{"text":"ጉያ ዼከምሰ ዋቀዮት፣","poem":1},{"text":"ሆማ ህንምልቅኔ ዮካን ህንሀፍኔ፤","poem":2},{"text":"ወረ አን ደኤ ጉድሴ","poem":1},{"text":"ዲንኮ ነ ጀላ በሌሴረ።”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}