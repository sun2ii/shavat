{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"LAM","translationId":"gaz_ebi","name":"ፋሩ","commonName":"ፋሩ","title":"ፋሩ ኤርምያስ","order":25,"numberOfChapters":5,"sha256":"4418abacaaf58e89ef11d175a933296ac6954dcbffce7e0aa47ba89f13a0fd7d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/gaz_ebi/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"ወርቄን አከምት ቦረጃኤ?","poem":1},{"text":"ወርቄን ቁልቁሉንስ አከምት ጌደረሜ!","poem":2},{"text":"ዸጋወን እዶ ቁልቁሉ","poem":1},{"text":"ፊጤ ዳንዲወን ሁንዳረት ብብትናአኒሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"እልማን ጥዮን ከኔን አከ","poem":1},{"text":"ወርቄ ቁልቁሉት እላለማ ቱረን ሱን","poem":2},{"text":"አመ አከምት አከ ኦኮቴ ሱጴት፣","poem":1},{"text":"አከ ሆጂ ሱጴ ዾፍቱት እላለሙ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ዋንጎንዩ እልማንሳኒ ሆስሱፍ","poem":1},{"text":"ሀርመሳኒ ንኬኑ፤","poem":2},{"text":"ሰብንኮ ገሩ አኩመ ጉቺ ገሞጂ","poem":1},{"text":"ገረ ጀቤሰ ተኤረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ሰበቢ ዼቡቲፍ አረብን ዳእመኒ","poem":1},{"text":"ላጋት መጠነ፤","poem":2},{"text":"እጆሌን ቡዴነ ከዸት፦","poem":1},{"text":"ገሩ ነምንሳኒፍ ኬኑ ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ወር ዱር ጭዸ ኛቻ ቱረን፣","poem":1},{"text":"ረከተኒ ዳንዲረ ጅሩ።","poem":2},{"text":"ወር ዱር ኡፈተ ዲማ ዺልጌ ኡፈቻ ቱረን","poem":1},{"text":"ሀርአ ቱላ ድኬ ሀመቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"አደቢን የከ ሰበኮ","poem":1},{"text":"አደቢ የከ ሶዶም","poem":2},{"text":"ከን ኡቱ ሀርክ ነመ እሼ ገርጋሩፍ ህንቱቅን","poem":1},{"text":"ተሰ በዴ ሰና ጫላ ጉዳ ቱሬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"እልማን ሞቶተሳኒ ጨቢ ጫላ ቁልቁሉ፣","poem":1},{"text":"ኣነን ጫላ አዳዲ ቱረን፤","poem":2},{"text":"ዸግንሳኒ ሉለ ዲማ ጫላ ዲማ፣","poem":1},{"text":"ብፍትሳኒሞ ሰንፔር ፈካተ ቱሬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"አመ ገሩ ቀቃ ጫላ ጉራቸአኒሩ፤","poem":1},{"text":"ዳንዲረትስ ነምን እሳን ሁበቱ ህንጅሩ።","poem":2},{"text":"ጎጋንሳኒ ለፌሳኒት መጠኔረ፤","poem":1},{"text":"አከ ሙካስ ጎጌረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ወረ ቤላን ዹመኒ መና፣","poem":1},{"text":"ወረ ጎራዴዻን አጄፈመን ወየ፤","poem":2},{"text":"እሳን ዋን ኛተሙ ለፈ ቆቲሳራ ዸበኒ","poem":1},{"text":"ቤላን አለት ጎጎገኒ ዹሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ዬሮ ሰብንኮ ዹሜት","poem":1},{"text":"ዱበርቶትን ገረ ላፎን ሀርኩመሳኒቲን","poem":2},{"text":"አከ ኛተሳኒ ተአኒፍ","poem":1},{"text":"እጆሌ ኦፊ አፌለን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ዋቀዮ ዼከምሰሳ ጉቱ ገድ ዺሴ፤","poem":1},{"text":"ኣሪሳ ሶዳችሳ ሰነስ ንዸንገላሴ።","poem":2},{"text":"ጥዮን ኬሰትስ","poem":1},{"text":"እብደ ሁንዴወንሼ በርበዴሱ ቀብሲሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"አከ ዲኖትን ዮካን አመጃጆን","poem":1},{"text":"ከረወን ዬሩሳሌም ሴኑ ደንደአን፣","poem":2},{"text":"ሞቶትን ብየ ለፋ","poem":1},{"text":"ዮካን ሰብን አዱኛ ቶኮዩ ህንአመኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ገሩ ወን ኩን ሰበቢ ጩቡ ራጆተሼቲፊ","poem":1},{"text":"በሌሳ ሉቦተሼ","poem":2},{"text":"ከኔን እሼ ኬሰት ዺገ ቀጄሎታ","poem":1},{"text":"ዸንገላሰን ሰናቲፍ ተኤ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"እሳን አኩመ ጃሞታ","poem":1},{"text":"ዳንዲረ ገተንተሩ።","poem":2},{"text":"ሀመ ነምን ቶኮዩ ወያሳኒ ቱቁ ህንደንዴኜት","poem":1},{"text":"አከ መሌ ዺጋን ጡራአኒሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ነሞትንስ፣ “እስን ጡራኦዸ! አሲ በዳ!","poem":1},{"text":"በዳ! በዳ! ኑ ህንቱቅና!” ጄዸኒ እሳንት እዩ።","poem":2},{"text":"ዮሙ በቀተኒ አሲፊ አች ጆረንትስ","poem":1},{"text":"ሰቦትን ነሞተ ኦርማ ግዱ ጅረን፣","poem":2},{"lineBreak":true},{"text":"“እሳን ስአች አስ ጅራቹ ህንደንደአን” ጄዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ዋቀዮ መታሳቱ እሳን ብትኔሴ፤","poem":1},{"text":"እን ስአች እሳን ህንኤጉ።","poem":2},{"text":"ሉቦትን ህንከበጀምኔ፤","poem":1},{"text":"ማንጉዶትን ሱራ ህንአርገትኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"አከሱማን ገርጋርሰ ኤገቹዻን","poem":1},{"text":"እጅኬኘ ደዸቤ፤","poem":2},{"text":"ገሞኬኘረ ቴኜ","poem":1},{"text":"ሰበ ኑ ባሱ ህንደንዴኜራ ገርጋርሰ ኤገትኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"አከ ኑ ዳንዲኬኘረ ዴሙ ህንደንዴኜፍ","poem":1},{"text":"ነሞትን ተርካፊኬኘ ኤጉ።","poem":2},{"text":"ዹምንኬኘ ዽኣቴረ፤ጉዮትንኬኘስ ገባበተኒሩ፤","poem":1},{"text":"በዲስንኬኘ ዹፌራቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ወር ኑ አርአን","poem":1},{"text":"ርሳ ሰሚ ጫላ ሰፍሱ፤","poem":2},{"text":"እሳን ቱሉወንራ ኑ አርአኒ","poem":1},{"text":"ገሞጂ ኬሰት ርጰኒ ኑ ኤገቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ሀፉር ሉቡኬኛ ከን ዋቀዮ ድቤ፣","poem":1},{"text":"ክዮሳኒቲን ቀበሜ።","poem":2},{"text":"ኑ ዋን ጋድዱሳ ጀለ፣","poem":1},{"text":"ነሞተ ኦርማ ግዱ ጅራትኑ ሴኔ ቱሬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ያ እንተለ ኤዶም ከን ብየ ኡዝ ኬሰ ጅራቱ","poem":1},{"text":"አት እልልች፣ ገመድስ።","poem":2},{"text":"ገሩ ጦፎን ሱን ሲፍስ ንኬነመ፤","poem":1},{"text":"አትስ መቾፍቴ ቁላኬ ሀፍተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"እንተለ ጥዮን አደበሙንኬ ንዹመ፤","poem":1},{"text":"እን በረ ቦጅአሙኬቲ ህንዼሬሱ።","poem":2},{"text":"ገሩ ያ እንተለ ኤዶም፣ እን ጩቡኬ ንአደቤ፤","poem":1},{"text":"ሀምነኬስ እፈት ባሰ።","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}