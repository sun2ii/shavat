{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"LAM","translationId":"gaz_ebi","name":"ፋሩ","commonName":"ፋሩ","title":"ፋሩ ኤርምያስ","order":25,"numberOfChapters":5,"sha256":"4418abacaaf58e89ef11d175a933296ac6954dcbffce7e0aa47ba89f13a0fd7d","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/gaz_ebi/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ ዋን ኑረ ገኤ ያደዹ፤","poem":1},{"text":"እላል፤ ሰልጵነኬኘስ አርግ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሀንዹራንኬኘ አለጎታፍ፣","poem":1},{"text":"መኔንኬኘስ ነሞተ ኦርማቲፍ ደበርፈመኒ ኬነመኒሩ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኑ እጆሌ አባ ህንቀብኔ ታኔ፤","poem":1},{"text":"ሃዾትንኬኘሞ ሃዾተ ህዬሳ ተአኒሩ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኑ ብሻን ዹግኑፍ ከፈሉ ቀብነ ቱሬ፤","poem":1},{"text":"ቆራንስ ብታ ቆፋን አርገትነ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ወር ኑ አርአን ኮሜኬኘ ብረ ጅሩ፤","poem":1},{"text":"ኑ ደዸብኔረ፤ ቦቆናስ ህንቀብኑ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኑ ቡዴነ ገኣ አርገቹፍ ጄኔ","poem":1},{"text":"ወረ ግብጢፊ ወረ አሶሪት ሀርከ ኬንኔ፤","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አቦቲንኬኘ ጩቡ ሆጄተኒ ደርበን፤","poem":1},{"text":"ኑሞ አደቢሳኒ ባትኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ገርቦተቱ ኑ ቡልቸ፤","poem":1},{"text":"ነምን ሀርከሳኒቲ ብልሰ ኑ ባሱ ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሰበቢ ጎራዴ ገሞጂ ጅሩቲን","poem":1},{"text":"ሉቡኬኘ በላፍ ሳጥሌ ቡዴነ አርገትነ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጎጋንኬኘ ሰበቢ ቤላቲን","poem":1},{"text":"አኩመ በዳ እብዳ ሆአ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጥዮን ኬሰት ዱበርቶትን፣","poem":1},{"text":"መጋላወን ይሁዳ ኬሰትስ ዱበረን ቁልቁሉንሁምናን ጉዴደመን።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እልማን ሞቶታ ሀርከሳኒቲን ፈንፈመኒሩ፤","poem":1},{"text":"ማንጉዶትን ኡልፍነ ህንአርገትኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ገኤሶን አከ ምዻን ዳከን ድርቅሲፈመን፤","poem":1},{"text":"እጆሌን ዺራ ሙከ ባቹን ገተንተረን።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ማንጉዶትን ከረ መጋላ ዱራ ዴመኒሩ፤","poem":1},{"text":"ደርገጎንስ ዌዱሳኒ ዺሰኒሩ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ገመቹን ገራኬኘ ኬሳ በዴረ፤","poem":1},{"text":"ሹብሱንኬኘስ ቦእቸት ጌደረሜረ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ጎንፎን መታኬኘራ ቡኤረ።","poem":1},{"text":"ኑፍ ወዮ፤ ኑ ጩቡ ሆጄትኔራቲ!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሰበቢ ዋን ከናቲፍ ኦኔንኬኘ ንገገቤ፤","poem":1},{"text":"ሰበቢ ዋን ከናቲፍሞ እጅ ቴኘ ደዸብዴ፤","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ቱሉን ጥዮን ከን ኦኔ ሀፌ ሱን","poem":1},{"text":"ለፈ ዋንጎትን እረ ቡራቀን ተኤራቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ያ ዋቀዮ አት በረ በራን ቡልች፤","poem":1},{"text":"ቴሶንኬስ ዸሎታ ገረ ዸሎታት እት ፉፈ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አት ማሊፍ ጉቱማን ጉቱት ኑ እራንፈተ?","poem":1},{"text":"ማሊፍ በረ ዼራስ ኑ ዺፍተ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ያ ዋቀዮ አከ ኑ ዴብኑፍ ኦፍት ኑ ዴብስ፤","poem":1},{"text":"በረኬኘሌ አኩመ ዱሪት ሃሮምስ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"አት ዮ ጉቱማን ጉቱት ኑ ገቱ ባቴ፣","poem":1},{"text":"ዮ አከ መሌስ ኑት ዼከሙ ባቴ ዋን ከነ ጎዽ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}