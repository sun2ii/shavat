{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"MAL","translationId":"gaz_ebi","name":"ሚልክያስ","commonName":"ሚልክያስ","title":"ራጂ ሚልክያስ","order":39,"numberOfChapters":4,"sha256":"de5ce73e2274dcc2a90ac09ada9764f0b4421b7ad005a9409bec0e18ecdbcd62","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/MAL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/gaz_ebi/MAL/4.json","totalNumberOfVerses":55},"chapter":{"number":4,"content":[{"type":"heading","content":["ዹፋቲ ጉያ ዋቀዮ"]},{"type":"verse","number":1,"content":["“ዹጉማን ጉያን አከ በዳ እብዳ ቦበኡ ንዹፈ። ኦፍ ቱልቶትን ሁንዲፊ ወር ሀምነ ሆጄተን ሁንድ ጭዲ ተኡ፤ ጉያን ሱንስ እሳን ጉበ” ጄዸ ዋቀዮ ዋን ሁንደ ደንደኡ። “ህድ ዮካን ደሜን ቶኮዩ እሳኒፍ ህንሀፉ።"]},{"type":"verse","number":2,"content":["እስን ወረ መቃኮ ከበጀኒፍ ገሩ አዱን ቀጄሉማ ቆቾሳ ጀለት ፈይነ ቀበቴ ንበአ። እስንስ ባተኒ አኩመ ጀቢ ጎላ ገድ ዺፈምቴት ቡራቅጡ።"]},{"type":"verse","number":3,"content":["ኤርገሲ እስን ሀሞተ ንዽዺቱ፤ እሳንስ ጉያ አን ወንቶተ ከኔን ሆጄዹት ፋነ ሚለኬሰኒ ጀለት ዳራ ንተኡ” ጄዸ ዋቀዮ ዋን ሁንደ ደንደኡ።"]},{"type":"verse","number":4,"content":["“ሴረ ገርብቸኮ ሙሴ፣ ስርናፊ አጀጀ አን እስራኤሎተ ሁንዳፍ ኮሬብት እሰት ኬኔ ሰነ ያደዻ።"]},{"type":"verse","number":5,"content":["“ኩኖ አን፣ ጉያን ዋቀዮ እን ጉዳኒፊ ሶዳችሳን ሱን ኡቱ ህንዹፍን ዱረ ኤልያስ ራጅቸ እስኒፍ ነንኤርገ።"]},{"type":"verse","number":6,"content":["እን ቀልቢ አቦቲ ገረ እጆሌት፣ ቀልቢ እጆሌሞ ገረ አቦቲት ንዴብሰ፤ ዮ ከና አቺ አን ዹፌ አባርሳን ብየቲ ነንሩኩተ።”"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/MAL/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/MAT/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api