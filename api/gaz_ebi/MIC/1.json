{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"MIC","translationId":"gaz_ebi","name":"ሚክያስ","commonName":"ሚክያስ","title":"ራጂ ሚክያስ","order":33,"numberOfChapters":7,"sha256":"a1c9fdc47cce20e33c5070c5a0ea27846531aa297dc1d34a099b82c8894c04e9","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/gaz_ebi/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["በረ ዮታም፣ ኣሃዚፊ ህስቅያስ ሞቶተ ይሁዳ ቱረን ኬሰ ዱቢን ዋቀዮ ገረ ሚክያስ ነምቸ ሞሬሼት ዹፌ፤ ኩንስ ሙልአተ እን ዋኤ ሰማርያቲፊ ዋኤ ዬሩሳሌም አርጌዸ።"]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ያ ነሞተ፣ እስን ሁንድኑ ዸገኣ፤","poem":1},{"text":"ለፋፊ ወንቶትን እሼረ ጅራተን ሁንድኑ ዸጌፈዻ፤","poem":2},{"text":"ዋቀዮ ጎፍትች፣","poem":1},{"text":"ጎፍታን መነ ቁልቁሉማሳ ቁልቁሉ ሰነ ኬሳዹጋ እስንት በአ።","poem":2}]},{"type":"heading","content":["ሙርቲ ሰማርያፊ ዬሩሳሌምን ኤገቱ"]},{"type":"verse","number":3,"content":[{"text":"ኩኖ! ዋቀዮ እዶ ጅሬኘሳቲ ዹፋ ጅረ፤","poem":1},{"text":"እን ገድ ዹፌ እዶ ኦል ከኣ ለፋረ ንኤጄተ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አኩመ ገጋ ፉለ እብዳ ዱረ ጅሩ፣","poem":1},{"text":"አኩመ ብሻን ተበራ ገድ ያኡ","poem":2},{"text":"ቱሉወን እሰ ጀለት ንበቁ፤","poem":1},{"text":"ሱሉለወንስ ገርገር በቀቁ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ወን ኩን ሁንድ ሰበቢ ዶጎጎረ ያቆቢፍ፣","poem":1},{"text":"ሰበቢ ጩቡ መነ እስራኤሊፍ ተኤ።","poem":2},{"text":"ዶጎጎር ያቆብ ማል?","poem":1},{"text":"ሰማርያ ምቲ?","poem":2},{"text":"እዶን ሰገዳ ይሁዳ ማል?","poem":1},{"text":"ዬሩሳሌም ምቲ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“ከናፉ አን ሰማርያ ቱላ ዲገማ፣","poem":1},{"text":"ለፈ ወይኒ እት ዻበተን ነንጎዸ።","poem":2},{"text":"አን ዸጋወንሼ ሱሉለት ነቄ፣","poem":1},{"text":"ሁንዴሼ ቁላ ነንሀምብሰ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዋቆትንሼ ቶልፈሞን ሁንድኑ ንሁሬፈሙ፤","poem":1},{"text":"ኬናወን መነ ቁልቁሉማሼ ሁንድኑ እብዳን ጉበሙ፤","poem":2},{"lineBreak":true},{"text":"አን ፈኪሼ ሁንደ ነንበርበዴሰ።","poem":2},{"text":"እሼን ገቲ ሰጋገልቶታራ ኬናሼ ወልት ዋን ቀበቴፍ፣","poem":1},{"text":"ኬናን ሱን አመስ ገቲ ሰጋገልቶታ ተኤ ንዴብአ።”","poem":2}]},{"type":"heading","content":["ቦኡፊ ገዱ"]},{"type":"verse","number":8,"content":[{"text":"ሰበቢ ዋን ከናቲፍ አን ቦኤ ነንወዋዸ፤","poem":1},{"text":"አን ሚለ ዱዋፊ ቁላ ነንዴመ።","poem":2},{"text":"አን አኩመ ዋንጎ እዬ፣","poem":1},{"text":"አኩመ ኡሩንጉ ነንኣደ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"መዳንሼ ዋን ህንፈይኔፍ፣","poem":1},{"text":"ይሁዳትስ ደርቤረ።","poem":2},{"text":"ከረ ሰበኮ ዱረ ገኤረ፤","poem":1},{"text":"ዬሩሳሌምትስ ዹፌረ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እስን ዋን ከነ ጋት ኬሰት ህንዱበትና፤","poem":1},{"text":"ጎንኩማ ህንቦእና።","poem":2},{"text":"ቤት ሌአፍራት፣","poem":1},{"text":"አዋረ ኬሰ ገንገለዻ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እስን ወር ሻፊር ኬሰ ጅራተን፣","poem":1},{"text":"ቁላፊ ቃኒዻን ደርባ።","poem":2},{"text":"ወር ዘናን ኬሰ ጅራተን፣","poem":1},{"text":"ገድ ህንበአን።","poem":2},{"text":"ቤት ኤዜል ቦእቸረ ጅርት፤","poem":1},{"text":"ኤጉምስሼ እስንራ ፉዸሜረ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሰበቢ በላን ዋቀዮ ብራ ዹፌ","poem":1},{"text":"ከረ ዬሩሳሌምዩ ገኤፍ፣","poem":2},{"text":"ወር ማሮት ኬሰ ጅራተን","poem":1},{"text":"ገርጋርሰ አርገቹፍ ውጥርፈቱ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አት ላኪሽ ኬሰ ከን ጅራቱ፣","poem":1},{"text":"ፈርዴን ጋሪት ህዸዹ።","poem":2},{"text":"አት እንተለ ጥዮኒፍ","poem":1},{"text":"ጀልቀበ ጩቡት፤","poem":2},{"text":"ዶጎጎር እስራኤል","poem":1},{"text":"ስእ ኬሰት አርገማቲ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ከናፉ አት ሞሬሼት ጋቲፍ","poem":1},{"text":"ኬና ኬንተ።","poem":2},{"text":"መኔን አክዚብ ሞቶተ እስራኤሊፍ","poem":1},{"text":"ጎዎምስቶተ ተኡ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አን ወረ ማሬሻ ኬሰ ጅራተንት","poem":1},{"text":"ሞአታ ቶኮ ነንፍደ።","poem":2},{"text":"እን ኡልፍነ እስራኤል ተኤ","poem":1},{"text":"ገረ አዱላም ንዹፈ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሰበቢ ገደ እጆሌ እት ገመዱቲፍ ጄዺ","poem":1},{"text":"መታኬ ሃደዹ፤","poem":2},{"text":"አኩመ ጎጎጮሮ መታኬ ሞሌፈዹ፤","poem":1},{"text":"እሳን ቦጁዻን ስራ ፉዸተሙቲ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}