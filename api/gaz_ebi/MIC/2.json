{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"MIC","translationId":"gaz_ebi","name":"ሚክያስ","commonName":"ሚክያስ","title":"ራጂ ሚክያስ","order":33,"numberOfChapters":7,"sha256":"a1c9fdc47cce20e33c5070c5a0ea27846531aa297dc1d34a099b82c8894c04e9","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/gaz_ebi/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":2,"content":[{"type":"heading","content":["ከሮረ ነማቲፊ ከሮረ ዋቃ"]},{"type":"verse","number":1,"content":[{"text":"ወረ ደበ ከሮርፈተን","poem":1},{"text":"ከኔን ስሬሳኒረጪሰኒ ሀምነ ያደኒፍ ወዮ!","poem":2},{"text":"ሰበቢ ዋን ከነ ሆጄቹን ሁምነሳኒ ጀለ ጅሩፍ","poem":1},{"text":"እሳን እፈ በሪቲን ከአኒ ዋን ሰነ ሆጄቱ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እሳን ለፈ ቆቲሳ ከጄለኒ ቀበቱ፤","poem":1},{"text":"መኔንስ አከሱመ ከጄለኒ ፉዸቱ።","poem":2},{"text":"እሳን ጎዎምሳዻን መነ ነማ፣","poem":1},{"text":"ዻለሳስ ንፉዸቱ።","poem":2}]},{"type":"verse","number":3,"content":["ከናፉ ዋቀዮ አከነ ጄዸ፤",{"text":"“ኩኖ አን በላ እስን ጀላ በኡ ህንደንዴኜ ቶኮ","poem":1},{"text":"ሰበ ከነት ፍዱፍ ከሮርፈዼን ጅረ።","poem":2},{"text":"እስን ስአች ኦፍ ቱሉማዻን ጅራቹ ህንደንዴሰን፤","poem":1},{"text":"ዬሮን ኩን ዬሮ ረክና ተኣቲ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"በረ ሰነ ኬሰ ነሞትን እስንት ገእሱ፤","poem":1},{"text":"አከነ ጄዸኒስ ፋሩ ቦእቻ ከናን እስንት ቆሱ፤","poem":2},{"text":"‘ኑ ጉቱማን ጉቱት በርበዶፍኔረ፤","poem":1},{"text":"ቀቤኝ ሰበኮቲስ ገርገር ቆደተሜረ።","poem":2},{"text":"እን ነራ ፉዸተ!","poem":1},{"text":"ለፈ ቆቲሳኬኘ ወረ ኑ ሞአተኒፍ ኬነ።’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ከናፉ አት ነመ እጣዻን ለፈ ቆዱ ቶኮሌ","poem":1},{"text":"ወልዳ ዋቀዮ ኬሳ ህንቀባቱ።","poem":2}]},{"type":"heading","content":["ራጆተ ሶባ"]},{"type":"verse","number":6,"content":[{"text":"ራጆትንሳኒ፣ “እስን ራጂ ህንዱበትና፤","poem":1},{"text":"ዋኤ ዋን ከና ራጂ ህንዱበትና፤","poem":2},{"lineBreak":true},{"text":"ሰልጵን ኑት ህንዹፉ” ጄዹ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ያ መነ ያቆብ፣ “ወን ኩን አከነ ጄዸሙ ቀባ?","poem":1},{"text":"ሀፉር ዋቀዮ ኦብሰ ህንቀቡ?","poem":2},{"lineBreak":true},{"text":"እን ዋን አከሲ ንሆጄታ?”","poem":2},{"lineBreak":true},{"text":"“ነመ ከራንሳ ቀጄላ ተኤፍ","poem":1},{"text":"ዱቢንኮ ዋን ጋሪ ህንሆጄቱ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሰብንኮ አከ ዲናት ከኤረ።","poem":1},{"text":"እስን ነሞተ ያዶ መሌ አቺን ደርበን","poem":2},{"lineBreak":true},{"text":"ከኔን ዱላ ገላ ጅረንራ ኡፈተ ባፈቱ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እስን ዱበርቶተ ሰበኮቲ","poem":1},{"text":"መኔንሳኒ በበሬዶ ኬሳ አሪቱ።","poem":2},{"text":"ኤበኮስ በረ በራን","poem":1},{"text":"እጆሌሳኒራ ፉዸቱ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ከኣቲ አሲ ዴማ!","poem":1},{"text":"እዶን ኩን ለፈ ቦቆናኬሰኒ ምት፤","poem":2},{"lineBreak":true},{"text":"እሼን ጡሮፍቴ ዲገምቴ በዴርት።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ነምን ሶባፊ ጎዎምሳን ቶኮ ዮ ዹፌ፣","poem":1},{"text":"‘አን ዋኤ ዳዺ ወይኒቲፊ","poem":2},{"lineBreak":true},{"text":"ዹጋቲ ጭማ ራጂ ሲፍ ነንዱበዸ’ ጄዼ፤","poem":2},{"lineBreak":true},{"text":"እን ራጂ ሰበ ከና ተአ!","poem":2}]},{"type":"heading","content":["ፉረምን ዋዳ ገለሜ"]},{"type":"verse","number":12,"content":[{"text":"“ያ ያቆብ፣ አን ዹጉማን","poem":1},{"text":"እስን ሁንደ ወልት ነንቀበ፤","poem":2},{"lineBreak":true},{"text":"አን ሀምባ እስራኤል ወልት ነንፍደ።","poem":2},{"text":"አን አኩመ ሆሎተ ጎለ ኬሳት፣","poem":1},{"text":"አኩመ ቡሻዬ ለፈ ዼዳ ጅረኒት ወልት እሳን ነንፍደ፤","poem":2},{"lineBreak":true},{"text":"ለፍት ሱንስ ቱተ ነማቲን ጉተምት።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እን ጨብሴ ከራ ባሱ ፉለሳኒ ዱረ ዴመ፤","poem":1},{"text":"እሳን ጨብሰኒ ከራን በኡ።","poem":2},{"text":"ሞቲንሳኒ እሳን ዱረ በአ፤","poem":1},{"text":"ዋቀዮ ፉለሳኒ ዱረ ዴመ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/MIC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/MIC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/MIC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}