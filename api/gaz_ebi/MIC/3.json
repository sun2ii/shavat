{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"MIC","translationId":"gaz_ebi","name":"ሚክያስ","commonName":"ሚክያስ","title":"ራጂ ሚክያስ","order":33,"numberOfChapters":7,"sha256":"a1c9fdc47cce20e33c5070c5a0ea27846531aa297dc1d34a099b82c8894c04e9","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/gaz_ebi/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"heading","content":["ሆገንቶትኒፊ ራጆትን በላሌፈተመን"]},{"type":"verse","number":1,"content":["ኤርገሲ አን አከነን ጄዼ፤",{"text":"“እስን ሆገንቶትን ያቆብ፣","poem":1},{"text":"ቡልችቶትን መነ እስራኤል ሜ ዸጌፈዻ።","poem":2},{"text":"እስን ሙርቲ ቀጄላ ቤኩ ህንቀብደኒ?","poem":1}]},{"type":"verse","number":2,"content":[{"text":"እስን ወር ዋን ጋሪ ጅብተኒ ዋን ሀማ ጃለተን፣","poem":2},{"text":"ወር ሰበኮራ ጎጋ፣","poem":1},{"text":"ለፌሳኒራሞ ፎን ባፍተን፣","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ወር ፎን ሰበኮ ኛተን፣","poem":1},{"text":"ከኔን ጎጋሳኒ እራ ቁንጭፍተኒለፌሳኒ ጨጨብስተን፣","poem":2},{"text":"እስን ወር አከ ፎን ኤሌት ዋደሙቲፊ","poem":1},{"text":"ኦኮቴት አፌለሙ እሳን ጭጭርተን","poem":2},{"lineBreak":true},{"text":"ሙርቲ ቀጄላ ቤኩ ህንቀብደኒ?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ኤርገሲ እሳን ዋቀዮት እየቱ፤","poem":1},{"text":"እን ገሩ ዴቢ ህንኬኑፍ።","poem":2},{"text":"ዬሮ ሰነት እን ሰበቢ ጩቡ","poem":1},{"text":"እሳን ሆጄተኒቲፍ ፉለሳ እሳን ዱራ ንዾክፈተ።","poem":2}]},{"type":"verse","number":5,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“ዋኤ ራጆተ","poem":1},{"text":"ሰበኮ ከራራ ጀልእሰኒ፣","poem":2},{"text":"ዮ ነምን ቶኮ ኛተ ኬኔፍ","poem":1},{"text":"እሳን ‘ነጋ’ ለብሱ፤","poem":2},{"text":"ዮ እን አከስ ጎቹ ባቴሞ","poem":1},{"text":"ሎለ እሰት ካሱፍ ቆጳኡ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ከናፉ ኡቱ እስን ሙልአተ ህንአርግን ሀልከን፣","poem":1},{"text":"ኡቱ እስን ሆደ ህንዱበትንሞ ዱከን እስንት ዹፈ።","poem":2},{"text":"አዱን ራጆተት ዺት፤","poem":1},{"text":"ጉያንስ እሳንት ዱከናአ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እላልቶትን ንቃነኡ፤","poem":1},{"text":"ወር ሆደ ዱበተንስ ንሰልጵፈሙ።","poem":2},{"text":"ሰበቢ ዴቢን ቶኮዩ ዋቀ ብራ ህንዹፍኔፍ","poem":1},{"text":"እሳን ሁንድ ፉለ ሀጉገቱ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"አን ገሩ ያቆብት በሌሳሳ፣","poem":1},{"text":"እስራኤልትስ ጩቡሳ ህሙፍ","poem":2},{"lineBreak":true},{"text":"ሁምናን ጉተሜረ፤","poem":2},{"text":"ሀፉረ ዋቀዮቲን","poem":1},{"text":"ሙርቲ ቀጄላፊ ጀብናን ጉተሜረ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እስን ሆገንቶትን መነ ያቆብ","poem":1},{"text":"ቡልችቶትን መነ እስራኤል","poem":2},{"text":"ወር ሙርቲ ቀጄላ ቱፈተኒ","poem":1},{"text":"ዋን ስሪ ተኤ ሁንደ ጀልእፍተን ዋን ከነ ዸገኣ፤","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ወር ዺገ ዸንገላሱዻን ጥዮንን፣","poem":1},{"text":"ሀምናንሞ ዬሩሳሌምን እጃርተን ዋን ከነ ዸገኣ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሆገንቶትንሼ መተኣ ፉዸተኒ ሙርቲ ኬኑ፤","poem":1},{"text":"ሉቦትንሼ ገቲዻን በርሲሱ፤","poem":2},{"lineBreak":true},{"text":"ራጆትንሼስ ማለቀ ፉዸተኒ ሆደ ዱበቱ።","poem":2},{"text":"ተኡስ እሳን ዋቀዮት እርከተኒ፣","poem":1},{"text":"“ዋቀዮ ግዱኬኘ ጅረ ምቲ?","poem":2},{"lineBreak":true},{"text":"በላን ቶኮዩ ኑት ህንዹፉ” ጄዹ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ከናፉ ሰበቢኬሰኒፍ፣","poem":1},{"text":"ጥዮን አኩመ ለፈ ቆቲሳት ቆተምት፤","poem":2},{"text":"ዬሩሳሌምስ ቱላ ዋን ዲገሜ ታት፤","poem":1},{"text":"ጋር መነ ቁልቁሉማስ ተበ ደገላን ልቅምፈሜ ተአ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}