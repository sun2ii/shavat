{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"MIC","translationId":"gaz_ebi","name":"ሚክያስ","commonName":"ሚክያስ","title":"ራጂ ሚክያስ","order":33,"numberOfChapters":7,"sha256":"a1c9fdc47cce20e33c5070c5a0ea27846531aa297dc1d34a099b82c8894c04e9","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/gaz_ebi/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["ቱሉ ዋቀዮ"]},{"type":"verse","number":1,"content":["በረ ዹማ ኬሰ",{"text":"ቱሉን መነ ቁልቁሉማ ዋቀዮ","poem":1},{"text":"ቱሉወን ሁንደ ኬሳ ኦል ዼረቴ ዻበተ፤","poem":2},{"text":"እን ጋረን ጫላ ኦል ኦል ጄዸ፤","poem":1},{"text":"ነሞትንስ እት ያኡ።","poem":2}]},{"type":"verse","number":2,"content":["ሰቦትን ባይኤን ዹፈኒ አከነ ጄዹ፤",{"text":"“ኮታ ገረ ቱሉ ዋቀዮ፣","poem":1},{"text":"ገረ መነ ዋቀ ያቆብ ኦል ባና።","poem":2},{"text":"እን አከ ኑ ዳንዲሳረ ዴምኑፍ","poem":1},{"text":"ከራሳ ኑ በርሲሰ።”","poem":2},{"text":"ሴር ጥዮን ኬሳ፣","poem":1},{"text":"ዱቢን ዋቀዮሞ ዬሩሳሌም ኬሳ ዹፈ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እን ነሞተ ሄዱ ግዱት ሙርቲ ኬኔ","poem":1},{"text":"ሰቦተ ጀጀቦ ገርገር ፈጎ ጅረንስ ወልት አራርሰ።","poem":2},{"text":"እሳን ጎራዴሳኒ ቱመኒ ማረሻ፣","poem":1},{"text":"ኤቦሳኒሌ ሃምቱ ቶልፈቱ።","poem":2},{"text":"ሰብን ቶኮ ሰበ ብራት ጎራዴ ህንሉቅፈቱ","poem":1},{"text":"ዮካን ወራናፍ ጄዸኒ ስአች ነመ ህንሌንጅሰን።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ነምን ሁንድ ሙከ ወይኒሳቲፊ","poem":1},{"text":"ሙከ ሀርቡሳ ጀለ ታአ፤","poem":2},{"text":"ዋቀዮ ዋን ሁንደ ደንደኡ ዱበቴራቲ","poem":1},{"text":"ነምን እሳን ሶዳችሱ ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሰቦትን ሁንድኑ","poem":1},{"text":"መቃ ዋቆተሳኒቲን ዴዴብኡ፤","poem":2},{"text":"ኑሞ በረ በራ ሀመ በረ በራት","poem":1},{"text":"መቃ ዋቀዮ ዋቀኬኛቲን ዴዴብነ።","poem":2}]},{"type":"heading","content":["ከሮረ ዋቀዮ"]},{"type":"verse","number":6,"content":[{"text":"ዋቀዮ አከነ ጄዸ፤","poem":1},{"text":"“አን በረ ሰነ ናፈ ወልትን ቀበ፤","poem":2},{"text":"ወረ ቦጅአመኒፊ","poem":1},{"text":"ወረ አን ገድሲሴስ ወልትን ቀበ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አን ወረ ናፈ ሀምባ፣","poem":1},{"text":"ወረ አርአሜሞ ሰበ ጀባ ነንጎዸ።","poem":2},{"text":"ዋቀዮ ጉያ ሰና ጀልቀቤ","poem":1},{"text":"ሀመ በረ በራት ቱሉ ጥዮንረት ቡልቻሳኒ ተአ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ያ ገሞ ኤጉምሰ ቡሻዬ፣","poem":1},{"text":"ያ ደኦ እንተለ ጥዮን፣","poem":2},{"text":"ኦል ኣንቱማን ዱሪ ሲፍ ንዴብፈመ፤","poem":1},{"text":"ሞቱማን እንተለ ዬሩሳሌም ንዹፈ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"አት አመ ማሊፍ አከነ እይቴ ቦሰ?","poem":1},{"text":"አት ሞቲ ህንቀብዱ?","poem":2},{"text":"ወን አት አከ ዱበርቲ ጭኒንሱን ቀቤ ሚጠቱፍ","poem":1},{"text":"ጎርሳንኬ በዴቲ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ያ እንተለ ጥዮን፣","poem":1},{"text":"አኩመ ዱበርቲ ጭኒንሱን ቀቤት ኣድ፤","poem":2},{"text":"አት አመ በኬ ኬሰ ቁበቹፍ","poem":1},{"text":"መጋላ ኬሳ በኡ ቀብዳቲ።","poem":2},{"text":"አት ባብሎን ዸቅጠ፤","poem":1},{"text":"አችት ንበራረምተ።","poem":2},{"text":"ዋቀዮ አችት","poem":1},{"text":"ሀርከ ዲነኬቲ ኬሳ ስፉረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"አመ ገሩ ሰቦትን ሄዱን ስ መርሰኒሩ።","poem":1},{"text":"እሳንስ፣ “እሼን ሃጡሮፍቱ፤","poem":2},{"text":"እጅኬኘ ጥዬፈቴ","poem":1},{"text":"ጥዮንን ሃእላሉ!” ጄዹ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እሳን ገሩ ያደ ዋቀዮ ህንቤከን፤","poem":1},{"text":"እሳን ከሮረሳ ከን እን አኩመ ብሲ","poem":2},{"lineBreak":true},{"text":"ኦብዲት ወልት ቀቤ ሰነ ህንሁበተን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ያ እንተለ ጥዮን ከኢቲ ምዻን ዸእ፤","poem":1},{"text":"አን ጋንፈ ስቢላ ሲፍ ነንኬናቲ፤","poem":2},{"text":"አን ኮቴ ናሲ ሲፍ ነንኬነ፤","poem":1},{"text":"አትስ ሰቦተ ባይኤ ጨጨብስተ።”","poem":2},{"text":"አት ሆሪ እሳን ከራ ሀማዻን አርገተን ዋቀዮፍ ኬንተ፤","poem":1},{"text":"ቀቤኘሳኒስ ጎፍታ ለፈ ሁንዳቲፍ ኬንተ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}