{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"MIC","translationId":"gaz_ebi","name":"ሚክያስ","commonName":"ሚክያስ","title":"ራጂ ሚክያስ","order":33,"numberOfChapters":7,"sha256":"a1c9fdc47cce20e33c5070c5a0ea27846531aa297dc1d34a099b82c8894c04e9","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/gaz_ebi/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"heading","content":["ቡልቻ ቤትልሄሚ ዹፉ"]},{"type":"verse","number":1,"content":[{"text":"ያ መጋላ ራያ ወራና፣ ራያኬ ህሪርስ፤","poem":1},{"text":"ኑ መርፈምኔራቲ።","poem":2},{"text":"እሳን ኡሌዻን","poem":1},{"text":"መዲ ቡልቻ እስራኤል ዸኡ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“ገሩ ያ ቤትልሄም ኤፍራታ፣","poem":1},{"text":"አት ዮ በልበለ ይሁዳ ኬሳ ጥኖ ታቴዩ፣","poem":2},{"text":"ከን ቡልቻ እስራኤል ተኡ፣","poem":1},{"text":"ከን ጅራቹንሳ ዱሩማ፣","poem":2},{"text":"ከን በረ ዱሪቲ ጀልቀቤ ቱሬ ቶኮ","poem":1},{"text":"ስ ኬሳ በኤ ናፍ ዹፈ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ከናፉ እስራኤል","poem":1},{"text":"ሀመ እሼን ጭኒንስፈቻ ጅርቱ ዴሴ","poem":2},{"text":"ኦቦሎትንሳ ወር ሀፈን","poem":1},{"text":"እስራኤሎተት መከሙፍ ዴብአንት ኮጳ ሀፍት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"እን ጀብነ ዋቀዮቲን","poem":1},{"text":"ሱራ መቃ ዋቀዮ፣ ዋቀሳቲን","poem":2},{"lineBreak":true},{"text":"ዻበቴ ቡሻዬሳ ትክፈተ።","poem":2},{"text":"ዬሮ ሰነት ሱራንሳ","poem":1},{"text":"ዋን ዳሪ ለፋ ገኡፍ እሳን ነጋዻን ጅራቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"እን ነጋኬኘ ተአ፤","poem":1},{"text":"ዬሮ ወር አሶር ብየኬኘ ዌረረኒ","poem":2},{"lineBreak":true},{"text":"ደአትኖኬኘ ኬሰ በአንት","poem":2},{"text":"ኑ ትክሶተ ቶርባፊ","poem":1},{"text":"አጀጁወን ሰዴት እት ከካስነ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እሳን ብየ አሶር ጎራዴዻን","poem":1},{"text":"ብየ ናምሩድስ ጎራዴ ሉቅፈሜን ቡልቹ።","poem":2},{"text":"ዬሮ ወር አሶር ብየኬኘ ዌረረኒ","poem":1},{"text":"ዳሪኬኘ ኬሰ በአንት፣","poem":2},{"lineBreak":true},{"text":"እን ወረ አሶር ሰነ ጀላ ኑ ባሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ሀምባን ያቆብ","poem":1},{"text":"ነሞተ ሄዱ ግዱት","poem":2},{"text":"አኩመ ፍጤንሰ ዋቀዮ ብራ ዹፉ፣","poem":1},{"text":"አኩመ ቲፉ መርገራ","poem":2},{"text":"ከን ነመ ህንኤግኔ","poem":1},{"text":"ዮካን እልማን ነማ ህንኤገትኔ ተአ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሀምባን ያቆብ ሰቦተ ግዱት፣","poem":1},{"text":"ኡመተ ሄዱ ግዱትስ፣","poem":2},{"text":"አኩመ ሌንጨ ብኔንሶተ ቦሶና ግዱ ጅሩ፣","poem":1},{"text":"አኩመ ሌንጨ ሳፌለ ቡሻዬ ግዱ ጅሩ","poem":2},{"text":"ከን እረ ኤጄቴ እሳን ጭጭሩቲፊ","poem":1},{"text":"ከን ነምን ቶኮዩ ሀርካ ቡሱ ህንደንዴኜ ተአ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሀርክኬ ሞአናዻን ዲኖተኬት ከአ፤","poem":1},{"text":"አመጃጆንኬ ሁንድኑ ንበርበዴፈሙ።","poem":2}]},{"type":"verse","number":10,"content":["ዋቀዮ አከነ ጄዸ፤",{"text":"“ጋፈስ አን ፈርዴንኬሰን ግዱኬሰኒ ነንበሌሰ፤","poem":1},{"text":"ጋሪወንኬሰን ከን ወራናስ ነንበርበዴሰ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አን መጋላወን ብየኬሰኒ ነንበርበዴሰ፤","poem":1},{"text":"ደአኖወንኬሰን ሁንደስ ነንዲገ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አን ፈልፈልቶተኬሰን ነንበሌሰ፤","poem":1},{"text":"እስንስ ዴብተኒ ህንሞርተን።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አን ፈኪወንኬ ሶፈሞፊ ኡቱባወን ዋቄፈትናኬቲ","poem":1},{"text":"ግዱኬቲ ነንበሌሰ፤","poem":2},{"text":"አት ስአች ገድ ጄቴ","poem":1},{"text":"ሆጂ ሀርከኬቲቲፍ ህንሰገዱ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አን ሲዳ ኣሼራ ግዱኬቲ ቡቅሴ","poem":1},{"text":"መጋላወንኬስ ነንበርበዴሰ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አን ሰቦተ ናፍ ህንአጀጀምንረት","poem":1},{"text":"ኣሪፊ ዼከምሳን ሃሎ ነንበአ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}