{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"MIC","translationId":"gaz_ebi","name":"ሚክያስ","commonName":"ሚክያስ","title":"ራጂ ሚክያስ","order":33,"numberOfChapters":7,"sha256":"a1c9fdc47cce20e33c5070c5a0ea27846531aa297dc1d34a099b82c8894c04e9","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/gaz_ebi/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":6,"content":[{"type":"heading","content":["ዋቀዮ እስራኤልራ ዱቢ ቀበ"]},{"type":"verse","number":1,"content":["ዋን ዋቀዮ ጄዹ ዸጌፈዻ፦",{"text":"“ኦል ከከኣቲ ፉለ ቱሉወኒ ዱረት ዱቢኬሰን ዽኤፈዻ፤","poem":1},{"text":"ጋረንስ ዋን እስን ጄተን ሃዸገአን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“ያ ቱሉወን ህመተ ዋቀዮ ዸገኣ፤","poem":1},{"text":"ሁንዴወን ለፋ ከኔን በረ በራ እስንስ ዸጌፈዻ።","poem":2},{"text":"ዋቀዮ ሰበሳራ ዱቢ ቀባቲ፤","poem":1},{"text":"እን እስራኤል ወጅን ፈልሚ ቀበ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“ያ ሰበኮ፣ አን ማለን ስ ጎዼ?","poem":1},{"text":"አን ማሊነን ስ ደዸብሲሴ? ሜ ዴቢ ናፍ ኬን።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አን ብየ ግብጢ ስን ባሴ","poem":1},{"text":"ብየ ገርቡማ ኬሳ ስን ፉሬ።","poem":2},{"text":"አን አከ እን ስ ቀጄልቹፍ ሙሴ፣","poem":1},{"text":"አከሱመስ አሮኒፊ ሚርያምን ሲፈን ኤርጌ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ያ ሰበኮ፣ ሜ ጎርሰ ባላቅ ሞቲን ሞኣብ ጋፈቴፊ","poem":1},{"text":"ዴቢ በለኣም እልም ቤኦር ኬኔፍ ያደዹ።","poem":2},{"text":"አት አከ ሆጂ ቀጄሉማ ዋቀዮ ቤክቱፍ","poem":1},{"text":"ከራ አት ሽጢሚ ሀመ ግልጋልት ዴምቴ ሰነ ያደዹ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"አን ማሊነን ፉለ ዋቀዮ ዱረ ዹፌ","poem":1},{"text":"ፉለ ዋቀ ኦል ጉባ ጅሩ ዱረት ሰገደ?","poem":2},{"text":"አን ኣርሳ ጉበሙን፣","poem":1},{"text":"ጀቢ ወጋ ቶኮቲን ፉለሳ ዱረት ዽኣዹ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዋቀዮ ኮርቤዪ ሆላ ኩመ ሄዱት፣","poem":1},{"text":"ዘይቲ ለገ ኩመ ኩዸኒት ንገመዳ?","poem":2},{"text":"አን እልመኮ ሀንገፈ፣ ሰበቢ የከኮቲቲፍ፣","poem":1},{"text":"ሰበቢ ጩቡ ሉቡኮቲቲፍስ ዸለ ገራኮ ኣርሳ ዽኤሱ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ያ ነመ፣ እን ዋን ጋሪ ስ አርግሲሴረ።","poem":1},{"text":"ዋቀዮ ማል ስራ በርባደ?","poem":2},{"text":"ሙርቲ ቀጄላ ኬኑፊ አራረ ጃለቹ፣","poem":1},{"text":"አከ አት ገድ ኦፍ ቀብዴ ዋቀኬ ወጅን ዴምቱስራ በርባደ ምቲ?","poem":2}]},{"type":"heading","content":["የካፊ አደበሙ እስራኤል"]},{"type":"verse","number":9,"content":[{"text":"እስን ዸጌፈዻ! ዋቀዮ አከነ ጄዼ መጋለቲ ዋመ፦","poem":1},{"text":"መቃኬ ሶዳቹን ኦጉማዸ፤","poem":2},{"lineBreak":true},{"text":"“ኡሌፊ እሰ ኡሌ ሰነ ፍለቴ ቀልቤፈዻ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ያ መነ ሀማ፣ አን ቀቤኘ እስን ደባን አርገተኒፊ","poem":1},{"text":"መዳሊ ሶባ አባረማ ሰነ እራንፈዻ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አን ነመ መዳሊ ሶባቲን ሆጄቱፊ","poem":1},{"text":"ከን መዳሊ ሶባ ኮሮጆት ባቱ አከሱመት ዺሳ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሶሬዪንሼ ጀልኦተ፤","poem":1},{"text":"ኡመትንሼ ሶብዶተ፤","poem":2},{"lineBreak":true},{"text":"አረብንሳኒስ ጎዎምሳ ዱበተ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ከናፉ አን ሰበቢ ጩቡኬሰኒቲፍ እስን ዲጌ፣","poem":1},{"text":"እስን በሌሱ ጀልቀቤረ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አት እኑመ ኛተ፤ ገሩ ህንቁፍቱ፤","poem":1},{"text":"ገራንኬ አመሌ ዱዋዸ።","poem":2},{"text":"አት ንካአተ፤ ገሩ ሆማ ሲፍ ህንኩፈሙ፤","poem":1},{"text":"ዋን አት ኩፈቱ ሰነ አን ጎራዴት ኬናቲ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አት ንፈጫፈተ፤ ገሩ ህንሃመቱ፤","poem":1},{"text":"ኤጄርሰ ንጩንፈተ፤ ገሩ ዘይቲሳ ህንድበቱ፤","poem":2},{"lineBreak":true},{"text":"እጀ ወይኒ ንጩንፈተ፤ ገሩ ዳዺ ወይኒ ህንዹግዱ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አት ስርነ ኦምሪቲፊ","poem":1},{"text":"ሆጂ መነ አሃብ ሁንደ ጀቤስቴርተ፤","poem":2},{"lineBreak":true},{"text":"ጎርሰሳኒስ ዱካ ቡቴርተ።","poem":2},{"text":"ከናፉ አን ስበሌሴ፣","poem":1},{"text":"ኡመተኬ ነንሰልጵሰ፤","poem":2},{"lineBreak":true},{"text":"እስን ቱፊ ሰቦታ ንባቱ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/MIC/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/MIC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/MIC/5.json","previousChapterAudioLinks":{},"numberOfVerses":16}