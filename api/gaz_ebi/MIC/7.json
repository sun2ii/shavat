{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"MIC","translationId":"gaz_ebi","name":"ሚክያስ","commonName":"ሚክያስ","title":"ራጂ ሚክያስ","order":33,"numberOfChapters":7,"sha256":"a1c9fdc47cce20e33c5070c5a0ea27846531aa297dc1d34a099b82c8894c04e9","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/gaz_ebi/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["ዽጰቹ እስራኤል"]},{"type":"verse","number":1,"content":[{"text":"አናፍ ወዮ!","poem":1},{"lineBreak":true},{"text":"አን አኩመ ነመ ዬሮ ቀርሚ ቦና ፉናነንት","poem":1},{"text":"ወይኒ ወልት ቀቡ ቶኮ ተኤረ፤","poem":2},{"text":"ሁርቡን ወይኒ ከን ኛተሙ ቶኮዩ ህንጅሩ፤","poem":1},{"text":"እጅ ሀርቡ ጀልቀባ ከን አን ዸረኡ ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ነምን ጋሪን ለፈራ በዴረ፤","poem":1},{"text":"ነምን ቀጄላን ቶኮዩ ህንሀፍኔ።","poem":2},{"text":"ነሞትን ሁንድኑ ዺገዸንገላሱፍ ርጰኒ ኤገቱ፤","poem":1},{"text":"ቶኮን ቶኮን ነማክዮዻን ኦቦሌሰሳ ኤገተ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሀርክ ለቹ ዋን ሀማ ሆጄቹ በረቴረ፤","poem":1},{"text":"ቡልቻን ኬና በርባደ፤","poem":2},{"text":"አባን ሙርቲስ መተኣ ፉዸተ፤","poem":1},{"text":"ነምን ሁምነ ቀቡ ዋኑመ ፌዼ ዱበተ፤","poem":2},{"lineBreak":true},{"text":"ሁንድሳኒ ወሊ ወጅን መለቱ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ከን እሳን ሁንደ ጫላ ጋሪ ተኤ አከ ሶኮሩት፤","poem":1},{"text":"እን አከ መሌ ቀጄላንሞ ደላ ቆራቲ ጫለ።","poem":2},{"text":"ጉያን ኤግዶተኬቲ፣","poem":1},{"text":"ጉያን እት ዋቅን ስ እላሉ ዹፌረ።","poem":2},{"lineBreak":true},{"text":"አመ ዬሮ እት እሳን ጆንጀአኒዸ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኦላ ህንአመነትን፤","poem":1},{"text":"ምቹስ ህንአብደትን።","poem":2},{"text":"እሼ ሀመቴ ጪፍቱ ብረትዩ","poem":1},{"text":"አረበኬ ኤገዹ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እልም አባሳ ቱፈተ፤","poem":1},{"text":"እንተል ሃዸሼት፣","poem":2},{"text":"ኒቲን እልማስ አማቲሼት ካት፤","poem":1},{"text":"ዲኖትን ነማ ምሴንሶቱመ መነሳ ተኡቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"አን ገሩ አብዲዻን ዋቀዮን ነንኤገዸ፤","poem":1},{"text":"ፈይሳኮ ዋቀ ነንኤገዸ፤","poem":2},{"lineBreak":true},{"text":"ዋቅንኮ ነ ዸገአ።","poem":2}]},{"type":"heading","content":["እስራኤል ንካት"]},{"type":"verse","number":8,"content":[{"text":"ያ ዲነኮ ነት ህንገመድን!","poem":1},{"text":"አን ዮን ኩፌዩ ነንከአ።","poem":2},{"text":"አን ዱከነ ኬሰ ታኡዩ","poem":1},{"text":"ዋቀዮ እፈ ናፍ ተአ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አን ሰበቢን ጩቡ እሰት ሆጄዼፍ፣","poem":1},{"text":"ሀመ እን ዱቢኮ እላሌ ናፍ ሙርቴሱት","poem":2},{"lineBreak":true},{"text":"ዼከምሰ ዋቀዮ ነንባዸ።","poem":2},{"text":"እን እፈት ነ ባሰ፤","poem":1},{"text":"አንስ ቀጄሉማሳ ነንአርገ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኤርገሲ ዲንኮ እሼን፣","poem":1},{"text":"“ዋቀዮ ዋቅንኬ ኤሰ ጅረ?” ናን ጄቴ ሱን","poem":2},{"lineBreak":true},{"text":"ዋን ከነ አርግቴ ቃኒን ሀጉገምት።","poem":2},{"text":"እጅኮ ኩፋቲሼ ንአርገ፤","poem":1},{"text":"እሼን አመዩ ሚለ ጀለት","poem":2},{"lineBreak":true},{"text":"አኩመ ዾቄ ዳንዲራት ዽዺተምት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ጉያን እት ደላንኬ እጃረሙ፣","poem":1},{"text":"ጉያን እት ዳንጋንኬ በልእፈሙ ቶኮ ንዹፈ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ጋፈስ ነሞትን","poem":1},{"text":"አሶሪፊ መጋላወን ግብጥ፣","poem":2},{"text":"ግብጢ ሀመ ኤፍራጢስትዩ፣","poem":1},{"text":"ገላና ሀመ ገላናት፣","poem":2},{"lineBreak":true},{"text":"ቱሉዻ ሀመ ቱሉት ጅራተን ገረኬ ንዹፉ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሰበቢ ጅራቶተሼቲፊ","poem":1},{"text":"ሰበቢ ዋን እሳን ሆጄተኒቲፍ ለፍት ንኦንት።","poem":2}]},{"type":"heading","content":["ከዸትናፊ ገለተ"]},{"type":"verse","number":14,"content":[{"text":"ኡመተኬ፣ ቡሻዬ ዻለኬቲ","poem":1},{"text":"ከኔን ኦፉማን ቦሶነ ኬሰ፣","poem":2},{"text":"ለፈ ዼዳ ገበታረ ጅራተን","poem":1},{"text":"ኡሌኬቲን ትክፈዹ።","poem":2},{"text":"እሳን አኩመ በረ ዱሪት","poem":1},{"text":"ባሻኒፊ ግልኣድ ኬሰ ሃቦበአን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“አን አኩመ ዬሮ አት ግብጢ ባቴ ዹፍቴ ሰና","poem":1},{"text":"ድንቂኮ እሳን ነንአርግሲሰ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ሰቦትን አርገኒ ንቃነኡ፤","poem":1},{"text":"ሁምነ ኦፊ ሁንደዩ ንዸቡ።","poem":2},{"text":"እሳን አፋንሳኒ ቀበቱ፤","poem":1},{"text":"ጉርሳኒስ ንዱደ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እሳን አኩመ ቦፋ፣","poem":1},{"text":"አኩመ ኡመመወን ለፈረ ሎአኒ ብዮ አራቡ።","poem":2},{"text":"እሳን ሆለቻ ሆልቀ ኬሳ በአኒ ዹፉ፤","poem":1},{"text":"እሳን ዋቀዮ ዋቀኬኘ ሶዳቹዻን","poem":2},{"lineBreak":true},{"text":"ዴብአኒ ፉለኬ ዱረ ሶዳዻን ዻበቱ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዋቅን አከኬቲ ከን ጩቡ ነማ ብረ ደርቤ","poem":1},{"text":"በሌሳ ሀምባ ዻለሳ ዺሱፍ ኤኙ?","poem":2},{"text":"አት አራረ ጎቹት ገመደ መሌ","poem":1},{"text":"በረ በራን ህንዼከምቱ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አት ዴብቴ ገራ ኑ ላፍተ፤","poem":1},{"text":"ጩቡኬኘ ሚለኬ ጀለት ዽዺቴ","poem":2},{"lineBreak":true},{"text":"በሌሳኬኘ ሁንደስ ቱጁበ ገላናትገድ ደርበተ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አት አኩመ በረ ዱሪ","poem":1},{"text":"አቦቲኬኛፍ ከከቴ ሰነ","poem":2},{"text":"ያቆቢፍ አመነማ ታተ፤","poem":1},{"text":"አብረሃምትስ ጃለለ ንአርግሲፍተ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}