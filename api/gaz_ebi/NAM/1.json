{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"NAM","translationId":"gaz_ebi","name":"ነሆም","commonName":"ነሆም","title":"ራጂ ናሆም","order":34,"numberOfChapters":3,"sha256":"555779c156c044b0ab85c7b08623994e57343873b97db11c05f11755e6fea3f3","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gaz_ebi/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["ራጂ ዋኤ ነነዌ ዱበተሜ። ክታበ ሙልአተ ናሆም ኤልቆሽቸ።"]},{"type":"line_break"},{"type":"heading","content":["ኣሪ ዋቀዮ ነነዌት ኣሬ"]},{"type":"verse","number":2,"content":[{"text":"ዋቀዮ ዋቀ ህናፉፊ ዋቀ ሃሎ በኡዸ፤","poem":1},{"text":"ዋቀዮ ሃሎ ንበአ፤ ዼከምሳንስ ጉተሜረ።","poem":2},{"text":"ዋቀዮ ዲኖተሳ ሃሎ ንበአ፤","poem":1},{"text":"ዼከምሰሳስ አመጃጆተሳቲፍ ንኩሰ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዋቀዮ ዼከሙፍ ህንጀርጀሩ፤ ሁምንሳሞ ጉዳዸ፤","poem":1},{"text":"ዋቀዮ ነመ በሌሳ ቀቡ ኡቱ ህንአደብን ህንዺሱ።","poem":2},{"text":"ቡቤ ሀማፊ ዸኣ ገላና ኬሳስ ከራ ቀበ፤","poem":1},{"text":"ዱሜስሞ አዋረ ሚለሳት።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እን ገላነት ዼከሜ ጎግሰ፤","poem":1},{"text":"አከ ለግን ሁንድኑ ጎጉ ጎዸ።","poem":2},{"text":"ባሻኒፊ ቀርሜሎስ ንጮለጉ፤","poem":1},{"text":"ደራራን ልባኖንስ ንሀርጨአ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ፉለሳ ዱረት ቱሉወን ንክርክሩ፤","poem":1},{"text":"ጋረንስ በቀኒ በዱ።","poem":2},{"text":"እዶ እን ጅሩት ለፍት ንሆለት፤","poem":1},{"text":"አዱኛፊ ወን አዱኛረ ጅራቱ ሁንድ ንሆለተ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኤኙቱ ዼከምሰሳ ዱረ ዻበቹ ደንደአ?","poem":1},{"text":"ኤኙቱ ዼከምሰሳ ሶዳችሳ ሰነ ኦብሱ ደንደአ?","poem":2},{"text":"ዼከምስሳ አኩመ እብዳ ዸንገለአ፤","poem":1},{"text":"ፉለሳ ዱረት ከታወን ንቡርኩታኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ዋቀዮ ጋሪዸ፤","poem":1},{"text":"ዬሮ ረክናትስ ደኦዸ።","poem":2},{"text":"እን ወረ እሰ አመነተን ንቤከ፤","poem":1}]},{"type":"verse","number":8,"content":[{"text":"ገሩ እን ሎላ ጀባዻን","poem":2},{"text":"ነነዌ ንበሌሰ፤","poem":1},{"text":"አመጃጆተሳስ አርኤ ዱከነት ገልቸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ወን እስን ዋቀዮት ያደን ማል?","poem":1},{"text":"እን ጉቱማን ጉቱት ንበሌሰ፤","poem":2},{"lineBreak":true},{"text":"ረኮንስ ለመተ ህንዹፉ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እሳን ቆራቲ ኬሰት ጠጠመኒ","poem":1},{"text":"ዳዺ ወይኒሳቲን መቻኡ፤","poem":2},{"lineBreak":true},{"text":"አኩመ ጭዲ ጎጌት ጉበተኒ ዹሙ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ያ ነነዌ፣ ነምን ዋቀዮት ሀምነ መለቴ","poem":1},{"text":"ዋን ሀማ ከሮርፈቱ","poem":2},{"lineBreak":true},{"text":"ስ ኬሳ አርገሜረ።","poem":2}]},{"type":"verse","number":12,"content":["ዋቀዮ አከነ ጄዸ፦",{"text":"“እሳን ጀብናፊ ባይእነ ዮ ቀባተንዩ","poem":1},{"text":"ንበርበዴፈሙ፤ ንበዱስ።","poem":2},{"text":"ያ ይሁዳ፣ አን ዮን ዱራን ስ ሚዼ ጅራዼዩ፣","poem":1},{"text":"ስአች ስ ህንሚዹ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አን አመ ዋንጆሳኒ ጉርሙኬሰንራ ነንጨብሰ፤","poem":1},{"text":"ሁዻኬስ ስራ ነንኩተ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ያ ነነዌ፣ ዋቀዮ አከነ ጄዼ ዋኤኬ አጀጀ ኬኔ ጅረ፦","poem":1},{"text":"“አት ሰኚ መቃንኬ እቲን ዋመሙ ህንቀባቱ።","poem":2},{"text":"አን ፈኪወን ሶፈመኒፊ ዋቆተ ቶልፈሞ በቅፈመኒ ቶልፈመን","poem":1},{"text":"ከኔን ገልመወን ዋቆተኬቲ ኬሰ ጅረን ነንበርበዴሰ።","poem":2},{"text":"ዋን አት አከ መሌ በልፈማ ታቴፍ","poem":1},{"text":"አን አዋለ ሲፍ ነንቆጴሰ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ኩኖ፣ ሚል ነመ ኦዱ ጋሪ ፍዱ፣","poem":1},{"text":"ከን ነጋ ለብሱ ቶኮ ቱሉወንረ ጅረ!","poem":2},{"text":"ያ ይሁዳ፣ አያኖተኬ አያኔፈዹ፤","poem":1},{"text":"ወሬገኬስ ባፈዹ።","poem":2},{"text":"ስአች ሀማን ስ ህንዌረሩ፤","poem":1},{"text":"እን ጉቱማን ጉቱት ንበርበዴፈመ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/NAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/NAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/MIC/7.json","previousChapterAudioLinks":{},"numberOfVerses":15}