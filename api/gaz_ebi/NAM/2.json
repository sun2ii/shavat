{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"NAM","translationId":"gaz_ebi","name":"ነሆም","commonName":"ነሆም","title":"ራጂ ናሆም","order":34,"numberOfChapters":3,"sha256":"555779c156c044b0ab85c7b08623994e57343873b97db11c05f11755e6fea3f3","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gaz_ebi/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["ኩፋቲ ነነዌ"]},{"type":"verse","number":1,"content":[{"text":"ያ ነነዌ፣ ነምን ስ ሎሉ ስት ዹፌረ።","poem":1},{"text":"ደኦ ኤገዹ፤","poem":2},{"lineBreak":true},{"text":"ከራ እላለዹ።","poem":2},{"lineBreak":true},{"text":"ሙዺኬ ህዸዹ፤","poem":2},{"lineBreak":true},{"text":"ሁምነኬ ሁንደ ወልት ቀበዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ዮ በሌስቶትን እሳን ኦንሰኒ","poem":1},{"text":"ሙኬን ወይኒሳኒ በርበዴሰንዩ፣","poem":2},{"text":"ዋቀዮ አኩመ ኡልፍነ እስራኤል ዴብሴ ሰነ","poem":1},{"text":"ኡልፍነ ያቆብ እዶት ንዴብሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ጋቸነወን ሎልቶተሳ ድዲሞዸ፤","poem":1},{"text":"ጎቶትንስ ኡፈተ ብልዲማ ኡፈተኒሩ።","poem":2},{"text":"ጉያ እሳን እት ቆጴፈመን ሰነ፣","poem":1},{"text":"ስቢል ጋሪ ሎላረ ጅሩ ንጨለቅሰ፤","poem":2},{"lineBreak":true},{"text":"ኤቦንስ ጋትራንስ ንምርምርፈመ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጋሪወን ሎላ ከራረ ደደርበተሙ፤","poem":1},{"text":"ኦብዲወን ኬሰስ አሲፊ አች ጉሉፉ።","poem":2},{"text":"እሳን ጉጨ ቦበኡ ፈካቱ፤","poem":1},{"text":"አኩመ በከካስ ንደርበተሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"እን ጎቶተሳ ንያደተ፤","poem":1},{"text":"እሳን ገሩ ከራት ጉፈቱ።","poem":2},{"text":"እሳን ገረ ደላ መጋለቲት አሪፈቱ፤","poem":1},{"text":"ደኦንስ ቆጴፈሜፊ ጅረ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"በልበል ለጌኒ በነማዸ፤","poem":1},{"text":"መሰራን ሞቱማስ ንጅገ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"መጋለቲን ቁላት ሀፍቴ","poem":1},{"text":"አከ ቦጅአምቱ ሙርቴፈሜረ።","poem":2},{"text":"ጦምቦሬወንሼ","poem":1},{"text":"ቆመሳኒ ሩሩኩተኒ አከ ጉጌ ቦኡ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ነነዌን አኩመ ሀሮት፤","poem":1},{"text":"ብሻንሼስ ኬሳ ያኤ ዹመ።","poem":2},{"text":"እሳንስ፣ “ዻበዻ! ዻበዻ!” ጄዸኒ እዩ፤","poem":1},{"text":"ገሩ ነምን ቶኮዩ ዱግደ ዱበት ህንዴብኡ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሜቲ ሳማ!","poem":1},{"text":"ወርቄ ሳማ!","poem":2},{"text":"መድሼ፣","poem":1},{"text":"በዻዹማን ኩሳ ቀቤኘሼ ሁንዳስ ዹመ ህንቀቡ!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እሼን ዱዋ፣ ቁላፊ ኦነ ታቴርት!","poem":1},{"text":"ለጴን በቄረ፤ ጅልብ ላፌረ፤","poem":2},{"lineBreak":true},{"text":"ዸግን ሆለቴረ፤ ፉል ሁንድስ ጉራቸኤረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ሆልቅ ሌንጮታ፣","poem":1},{"text":"እዶን እሳን እት እልማንሳኒ ሶረን፣","poem":2},{"text":"እዶን ሌንጭ ኮርማፊ ዸላን ኬሰ ያአን፣","poem":1},{"text":"ሳፌልሳኒስ ሶዳ መሌ ነጋዻን ጅራተን ኤሰ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሌንጭ ዋን እልማንሳቲፍ ገኡ አጄፈቴ፤","poem":1},{"text":"ሌንጮተ ዸላሳቲፍስ ዋ ሁዼ አጄሴ፤","poem":2},{"text":"ቦለሳ ዋን አደምሴን፣","poem":1},{"text":"ሆልቀሳሞ ጉማ ፎኒቲን ጉተቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ዋቀዮ ዋን ሁንደ ደንደኡ አከነ ጄዸ፤","poem":1},{"text":"“አን ስት ከኤረ፤","poem":2},{"text":"አን ጋሪወንኬ ከኔን ወራና ጉቤ ዳራ ነንጎዸ፤","poem":1},{"text":"ጎራዴንስ ሌንጨኬ ሳፌለ ፍጠ።","poem":2},{"text":"አን ዋን አት አደምሰቱ ቶኮሌ","poem":1},{"text":"ለፈረት ሲፍ ህንሀምብሱ።","poem":2},{"text":"ሰገሌን ኤርገሞተኬቲ","poem":1},{"text":"ለመተ ህንዸገአሙ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}