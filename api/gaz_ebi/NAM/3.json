{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"NAM","translationId":"gaz_ebi","name":"ነሆም","commonName":"ነሆም","title":"ራጂ ናሆም","order":34,"numberOfChapters":3,"sha256":"555779c156c044b0ab85c7b08623994e57343873b97db11c05f11755e6fea3f3","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gaz_ebi/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"heading","content":["ነነዌፍ ወዮ"]},{"type":"verse","number":1,"content":[{"text":"መጋለቲ ዺጋቲፍ፣","poem":1},{"text":"ከን ሶባን ጉተምቴፍ፣","poem":2},{"text":"ከን ሳምቻን ጉተምቴፍ፣","poem":1},{"text":"ከን ወር ሀምነ ሆጄተን ኬሳህንዸበምኔ ሰናፍ ወዮ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እይ ቀጬ፣","poem":1},{"text":"ከከክሱን ጎማ፣","poem":2},{"text":"ጉሉፉን ፈርዳ፣","poem":1},{"text":"ድድቹን ጋሪ ሎላ ንዸገአመ!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አባን ፈርዳ ንጉሉፈ፤","poem":1},{"text":"ጎራዴን ንበለቅሰ፤","poem":2},{"lineBreak":true},{"text":"ኤቦን ንጨለቅሰ!","poem":2},{"text":"በላ ሄዱን ነመረ ገኤረ፤","poem":1},{"text":"ነምን ባይኤን ዱኤረ፤","poem":2},{"text":"ሬፍ ለኮብሰ ህንቀቡ፤","poem":1},{"text":"ነሞትንስ ሬፈሳኒ ጉፈቱ፤","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኩን ሁንድ ሰበቢ ባይእነ ሰጋገሉማ ሰጋገልቱቲን፣","poem":1},{"text":"ጊፍቲ ፈልፈልቶታ፣","poem":2},{"text":"ከን ሰጋገልቱማሼቲን ሰቦተ፣","poem":1},{"text":"ቶልቸሼቲንሞ ኡመተ ገርቦምፈቴ ሰናቲን ተኤ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ዋቀዮ ዋን ሁንደ ደንደኡ አከነ ጄዸ፦","poem":1},{"text":"“አን ስት ከኤን ጅረ።","poem":2},{"lineBreak":true},{"text":"አን ኡፈተኬ ፉለኬት ኦል ነንሶቆለ።","poem":2},{"text":"አን ሰቦተት ቁላኬ፣","poem":1},{"text":"ሞቱሞተትሞ ቃኒኬ ነንሙልእሰ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አን ጡሪዻን ስን ፋለ፤","poem":1},{"text":"አከ መሌ ስን ቱፈዸ፤","poem":2},{"lineBreak":true},{"text":"ዋን ኮልፋስ ስን ጎዸ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ነምን ስ አርጉ ሁንድ ስራ በቀቴ፣","poem":1},{"text":"‘ነነዌን በዱት ጅርት፤ ኤኙቱ ቦኣፍ?’ ሲን ጄዸ፤","poem":2},{"lineBreak":true},{"text":"አን ነመ ስ ጀጀቤሱ ቶኮሌ ኤሳን አርገዸ?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"አት፣ ኖእ አሞን","poem":1},{"text":"ብየ ለገ አበያራ","poem":2},{"lineBreak":true},{"text":"ከን ብሻኒን መርፈምቴ ሰነ ጫልታ?","poem":2},{"text":"ለግን ደኦሼት፤","poem":1},{"text":"ብሻንስ ደላሼት።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እቶጵያፊ ግብጥ ጀብነሼ ከን ዹመ ህንቀብኔዸ፤","poem":1},{"text":"ፉጢፊ ሊብያን ቱምስቶተሼት።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ተኡስ እሼን ቦጅአምቴ","poem":1},{"text":"ብየ ኦርማት ጌፈምቴ።","poem":2},{"text":"ዳእመንሼ መታ ዳንዲ ሁንዳረት","poem":1},{"text":"ምጭርቅፈመኒ ዹመን።","poem":2},{"text":"ነሞተሼ ኡልፋቶት እጣ ቡፈተኒ","poem":1},{"text":"ነሞትንሼ ጉርጉዶትን ሁንድኑፎንጫዻን ህዸመን።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አትስ ንመቾፍተ፤ ንዾከተስ፤","poem":1},{"text":"ዲነ ጀላ በኡፍስ ደኦ በርባደተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ደኦንኬ ሁንድ ሙኬን ሀርቡ","poem":1},{"text":"ከኔን እጀ ጀልቀበት ብልቻቴ ቀበን ፈካተ፤","poem":2},{"text":"ዬሮ ሙኬን ሱን ሁርጉፈመንት","poem":1},{"text":"እጅሳኒ አፋን ነመ ዋ ኛቱ ኬሰ ቡአ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሜ ራያኬ እላል፤","poem":1},{"text":"እሳን ሁንድኑ ዱበርቶተ!","poem":2},{"text":"ከረወን ብየኬቲ","poem":1},{"text":"ዲኖተኬቲፍ በልአተኒ በነመኒሩ፤","poem":2},{"lineBreak":true},{"text":"እብድስ ደንቀራሳኒ ጉቤ ፍጤረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ኡቱ ህንመርፈምን ብሻን ወራበዹ፤","poem":1},{"text":"ሁምነ እትሳኬ ጀጀቤፈዹ!","poem":2},{"text":"ሱጴ ቶልፈዹ፤","poem":1},{"text":"ዾቄ ሱጴ ዺተዹ፤","poem":2},{"lineBreak":true},{"text":"ጡቢ ቶልፈዹ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አችት እብድ ስ ፍጠ፤","poem":1},{"text":"ጎራዴንስ ስ ጭጭሬ","poem":2},{"lineBreak":true},{"text":"አኩመ ኮሮጵሳስ ስ በርበዴሰ።","poem":2},{"text":"አከ ኮሮጵሳ ሆር፤","poem":1},{"text":"አኩመ ሀዋንሳ ባይአዹ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አት ሀመ እሳን ኡርጂ ሰሚ ጫላ ባይአተንት","poem":1},{"text":"ደልደልቶተኬ ባይእፈቴርተ፤","poem":2},{"text":"እሳን ገሩ አኩመ ሀዋንሳ ብየቲ ቁላ ሀምብሰኒ","poem":1},{"text":"ኤርገሲ በርሰኒ ዴሙ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኤግዶንኬ አኩመ ሀዋንሳት፤","poem":1},{"text":"ቆንዳልቶትንኬስ አኩመ ቱተ ሀዋንሳ","poem":2},{"lineBreak":true},{"text":"ከን ጉያ ቀበና ደላረ ቁበቱት፤","poem":2},{"text":"ዬሮ አዱን ባቱ ገሩ በርሰኒ በዱ፤","poem":1},{"text":"ነምን ቶኮዩ ገረ እሳን ዸቀን ህንቤኩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ያ ሞቲ አሶር ትክስቶትንኬ ሙገኒሩ፤","poem":1},{"text":"ነሞትንኬ ኡልፋቶትን ቦቆቹፍ ገድ ጭጪሰኒሩ።","poem":2},{"text":"ነሞትንኬ ነመ ወልት እሳን ቀቡ ዸበኒ","poem":1},{"text":"ቱሉወንረት ብብትናአኒሩ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ወን ቶኮዩ መዳኬ ፈይሱ ህንደንደኡ፤","poem":1},{"text":"ሚዸምንኬስ ከን ዱኣን ስ ገኡዸ።","poem":2},{"text":"ነምን ኦዱ ዋኤኬቲ ዸገኡ ሁንድኑ","poem":1},{"text":"ኩፋቲኬት ሀርከ ወልት ሩሩኩተ፤","poem":2},{"text":"ገረ ጀብነኬ ከን ዹመ ህንቀብኔ ሰናን","poem":1},{"text":"ኤኙቱ ህንሚዸምን?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}