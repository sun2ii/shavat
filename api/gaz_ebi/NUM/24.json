{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"NUM","translationId":"gaz_ebi","name":"ለኮብሰ","commonName":"ለኮብሰ","title":"ሴረ ለኮብሳ","order":4,"numberOfChapters":36,"sha256":"fadcf57bba8944fdd6052d96d6a09761313b9c52a2e36aa12ecc1f97474a9229","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/gaz_ebi/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["በለኣም ዬሮ አከ እስራኤልን ኤብሱን ዋቀዮን ገመቺሴ አርጌት አከ ዬሮ ካኒ ፈልፈለ በርባቸ ህንዸቅኔ፤ ገሩ ፉለሳ ገረ ገሞጂት ዴብፈቴ።"]},{"type":"verse","number":2,"content":["ዮሙ በለኣም ኦል ምልአቴ አከ እስራኤል ጎሰ ጎሳን ቁበቴ አርጌት ሀፉር ዋቃ እሰረ ቡኤ፤"]},{"type":"verse","number":3,"content":["እንስ አከነ ጄዼ ኤርጋሳ ዱበቴ፦",{"text":"“ኤርጋ በለኣም እልመ ቤኦር፣","poem":1},{"text":"ኤርጋ ነመ እጅሳ ስሪት አርጉ፣","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኤርጋ ነመ ዱቢ ዋቃ ዸገኡ","poem":1},{"text":"እሰ ዋቀ ዋን ሁንደ ደንደኡራ ሙልአተ አርጉ","poem":2},{"lineBreak":true},{"text":"ከን ኩፌ እጅሳ በነሙ ሰና፦","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ያ ያቆብ፣ ዱንካኖትንኬ፣","poem":1},{"text":"ያ እስራኤል፣ እዶን አት ጅራቱ አከም ሚዸገ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“እሳን አኩመ ሱሉለ ድሪራ፣","poem":1},{"text":"አኩመ እዶ ብቅልቱ ከን አፋን ለጋ፣","poem":2},{"text":"አኩመ አርጌሰ ዋቀዮ ዻቤ፣","poem":1},{"text":"አኩመ ብርብርሳ ቀርቀረ ብሻኒት።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኦኮሌሳ ኬሳ ብሻንቱ ሎለአ፤","poem":1},{"text":"ሰኚንሳ ብሻን ባይኤ አርገተ።","poem":2},{"lineBreak":true},{"text":"“ሞቲንሳ አጋግ ጫለ፤","poem":1},{"text":"ሞቱማንሳ ንከበጀመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ዋቀዮ ግብጢ እሰ ባሴ፤","poem":1},{"text":"እን ጀብነ አከ ጀብነ ገፈርሳ ቀበ።","poem":2},{"text":"እን ሰበ ዲኖተሳ ተኤ ኛተ፤","poem":1},{"text":"ለፌሳኒ ንጨጨብሰ፤","poem":2},{"lineBreak":true},{"text":"ጥየ ኦፊሳቲን እሳን ወራነ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እን አኩመ ሌንጫ ጪሴረ፤","poem":1},{"text":"አኩመ ሌንጨ ዸላስ ጪሴረ፤ ኤኙቱ እሰ ደመቅሰ?","poem":2},{"lineBreak":true},{"text":"“ወር ስ ኤብሰን ሃኤብፈመን፤","poem":1},{"text":"ወር ስ አባረንስ ሃአባረመን!”","poem":2}]},{"type":"verse","number":10,"content":["ባላቅ በለኣምት ኣሬ። እንስ ሀርከ ኦፊሳ ወልት ሩሩኩቴ በለኣሚን አከነ ጄዼ፤ “አን አከ አት ዲነኮ አባርቱፈን ስ ዋመዼ፤ አት ኩኖ ዬሮ ሰደን ከነ እሳን ኤብፍቴ።"]},{"type":"verse","number":11,"content":["አመ ደፊ አሲ ዴሚ መነኬት ገል! አን ኡልፍነ ጉዳ ሲፍ ነንኬነ ጄዼን ቱሬ፤ አመ ገሩ ዋቀዮ አከ አት ኡልፍነ ህንአርገትኔ ስ ጎዼረ።”"]},{"type":"verse","number":12,"content":["በለኣምስ ባላቂን አከነ ጄዼ፤ “አን ኤርገሞተ አት ነት ኤርግቴ ሰነት አከነ ጄዼን ህሜ ምቲ?"]},{"type":"verse","number":13,"content":["‘ኡቱ ባላቅ መሰራ ሜቲፊ ወርቄን ጉተሜ ሰነ ናፍ ኬኔዩ፣ አን ዋኑመ ዋቀዮ ጄዼ ቆፈን ዱበዸ መሌ አጀጀ ዋቀዮቲን አለት ዋን ያደኮ ጋሪ ዮካን ሀማ ቶኮዩ ሆጄቹ ህንደንደኡ።’"]},{"type":"verse","number":14,"content":["ኩኖ አን አመ ሰበኮት ነንዴብአ፤ ገሩ ሜ ኮቱ አን ዋን ሰብን ኩን በረ ዹፉ ኬሰ ሰበኬቲፍ ጎዹ ስን ቤክስሳ።”"]},{"type":"heading","content":["ኤርጋ በለኣም ከን አፉረፋ"]},{"type":"verse","number":15,"content":["እን አከነ ጄዼ ኤርጋሳ ዱበቴ፦",{"text":"ኤርጋ በለኣም እልመ ቤኦር፣","poem":1},{"text":"ኤርጋ ነመ እጅሳ ስሪት አርጉ፣","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኤርጋ ነመ ዱቢ ዋቃ ዸገኡ","poem":1},{"text":"ከን ቤኩምሰ ዋቀ ዋን ሁንዳ ኦሊ ቀቡ","poem":2},{"text":"ከን ዋቀ ዋን ሁንደ ደንደኡራ ሙልአተ አርጉ","poem":1},{"text":"ከን ኩፌ ድሪሩ፣ እጅሳስ ከን በነሙ ሰና፦","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“አን እሰ ነንአርገ፤ ገሩ አመ ምት፤","poem":1},{"text":"አን እሰ ነንእላለ፤ ገሩ ዽኦት ምት።","poem":2},{"text":"ያቆብ ኬሳ ኡርጂን ቶኮ ንበአ፤","poem":1},{"text":"እስራኤል ኬሳ ቦኩን ቶኮ ኦል ከአ።","poem":2},{"text":"እን አደ ወረ ሞኣብ፣","poem":1},{"text":"ቡቄ መታ እልማን ሴት ሁንዳስ ንጨጨብሰ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ኤዶም ንሞአተመ፤","poem":1},{"text":"ሴኢር፣ ዲንሳ ንሞአተመ፤","poem":2},{"lineBreak":true},{"text":"እስራኤል ገሩ ጀባቻ ዴመ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ያቆብ ኬሳ ቡልቻን ቶኮ ንከአ፤","poem":1},{"text":"ወረ መጋላ ሰነ ኬሰት ሉቡዻን ሀፈንስ ንበርበዴሰ።”","poem":2}]},{"type":"heading","content":["ኤርጋ በለኣም ከን ዹማ"]},{"type":"verse","number":20,"content":["ኤርገሲስ በለኣም አማሌቅን አርጌ አከነ ጄዼ ኤርጋ ኦፊ እሰ ዱበቴ፦",{"text":"“አማሌቅ ሰቦተ ኬሳ ከን ጀልቀባ ቱሬ፤","poem":1},{"text":"ዹምንሳ ገሩ በርበዳኡዸ።”","poem":2}]},{"type":"verse","number":21,"content":["ኤርገሲ ቄኖተ አርጌ አከነ ጄዼ ኤርጋ ኦፊሳ እት ዱበቴ፦",{"text":"“እዶን አት ጅራቱ ጀባዸ፤","poem":1},{"text":"መንኬስ ከታ ኬሰት እጃረሜ፤","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ተኡስ እስን ወር ቄኖታ፣","poem":1},{"text":"ጋፈ አሶር እስን ቦጅኡ ንበዱ።”","poem":2}]},{"type":"verse","number":23,"content":["እንስ አከነ ጄዼ ኤርጋሳ እት ዱበቴ፦",{"text":"“ወዮ! ዬሮ ዋቀዮ ዋን ከነ ሆጄቱኤኙቱ ጅራቹ ደንደአ?","poem":1}]},{"type":"verse","number":24,"content":[{"text":"ዶኒወን ቀርቀረ ክቲምራ ንዹፉ፤","poem":2},{"text":"እሳንስ አሶሪፊ ኤቤርን ንቀበቱ፤","poem":1},{"text":"ገሩ እሳንስ ንበርበዴፈሙ።”","poem":2}]},{"type":"verse","number":25,"content":["ኤርገሲ በለኣም ከኤ መነ ኦፊሳት ዴብኤ፤ ባላቅሞ ከራ ኦፊሳ ቀጄሌ።"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/NUM/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/NUM/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/NUM/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}