{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"OBA","translationId":"gaz_ebi","name":"ኦባድያ","commonName":"ኦባድያ","title":"ራጂ ኦባድያ","order":31,"numberOfChapters":1,"sha256":"1fcbd13ae300e98b1cacd7d2ff0040e49740231fb845d0d7127b4a7059b7d2f2","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/OBA/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/gaz_ebi/OBA/1.json","totalNumberOfVerses":21},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["ሙልአተ ኦባድያ። 1‑4 ኩወፈ – ኤር 49፥14‑16 5‑6 ኩወፈ – ኤር 49፥9‑10 ዋቀዮ ጎፍታን ዋኤ ኤዶም አከነ ጄዸ።",{"lineBreak":true},{"lineBreak":true},{"text":"ኑ ኤርጋ ቶኮ ዋቀዮራ ዸጌኜረ፦","poem":1},{"text":"ኤርገማን ቶኮ፣ “ከኣ ዸቅኔ እሼ ሎላ፤","poem":2},{"text":"ወራናፍስ በኣ” ጄቹፍ ገረ ሰቦታት ኤርገሜ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“ኩኖ፣ አን ሰቦተ ግዱት ስን ጥኔሰ፤","poem":1},{"text":"አትስ አከ መሌ ቱፈተምተ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አት ከን በቀቃ ከታ ኬሰ ጅራቴ","poem":1},{"text":"መነኬ ለፈ ኦል ከኣረት እጃረቱ፣","poem":2},{"text":"ከን፣ ‘ኤኙቱ ለፈት ገድ ነ ቡሰ?’ ኦፊን ጄቱ፣","poem":1},{"text":"ኦፍ ቱሉማን ገራኬቲ ስ ጎዎምሴረ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዮ አት አኩመ ርሳ ኦል ፈጋቴ","poem":1},{"text":"ኡርጂወን ግዱት መንኤኬ እጃረቴዩ፣","poem":2},{"lineBreak":true},{"text":"አን አቺ ገድ ስን ቡሰ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“ሀቱን ዮ ስት ዹፍቴ","poem":1},{"text":"ሳምቱን ሀልከኒን ስት ሴንቴ፣","poem":2},{"text":"በላ አከሚቱ ስ ኤገተ!","poem":1},{"text":"እሳን ሀሙመ በርባደን ቆፈ ፉዸተኒ ህንዴመኒ?","poem":2},{"text":"ወር እጀ ወይኒ ጉረን ኡቱ ገረኬ ዹፈኒ፣","poem":1},{"text":"ስላ ቀርሚ ወዪ ህንዺሰኒ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኤሳዉ ገሩ አከም ሳመሜ","poem":1},{"text":"ቀቤኝሳ ዾክፈማንስ ጀላ ጉረሜ!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ገሬንኬ ሁንድኑ ገረ ሞጋት ስ ዺበ፤","poem":1},{"text":"ምቾትንኬ ስ ጎዎምሰኒ ስ ሞአቱ፤","poem":2},{"text":"ወር ቡዴነኬ ኛተን ክዮ ስ ዱረ ካኡ፤","poem":1},{"text":"አት ገሩ ዋን ከነ ህንሁበቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“አን በረ ሰነ ኦጌዪ ኤዶም፣","poem":1},{"text":"ነሞተ ሁበትና ቀበን ቱሉወን ኤሳውራ","poem":2},{"lineBreak":true},{"text":"ህንበሌሱ?” ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“ያ ቴማን ቀብሳኦንኬ ንርፈቱ፤","poem":1},{"text":"ነምን ቱሉወን ኤሳዉረ","poem":2},{"lineBreak":true},{"text":"ጅራቱ ሁንድኑስ ጎረአሜ ዹመ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሰበቢ ደበ ኦቦሌሰኬ ያቆብት ሆጄተሜቲፍ","poem":1},{"text":"አት ቃኒዻን ሀጉገምተ፤","poem":2},{"lineBreak":true},{"text":"በረ በራንስ ንበሌፈምተ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጋፈ አለጎን ቀቤኘሳ","poem":1},{"text":"ጉረተኒ ነሞትን ኦርማሞ ከረሳ ሴነኒ","poem":2},{"text":"ዬሩሳሌምት እጣ ቡፈተንት፣","poem":1},{"text":"አትስ ኮጳ ዻበቴ","poem":2},{"lineBreak":true},{"text":"እሳን ኬሳ አከ እሰ ቶኮ ታቴ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ጋፈ እን ምልኪ ዸቤት","poem":1},{"text":"አት ኦቦሌሰኬ ቱፈቹ ህንቀብዱ ቱርቴ፤","poem":2},{"text":"ዮካን ጉያ በዲሳኒት","poem":1},{"text":"ሰበ ይሁዳት ገመዱ ህንቀብዱ ቱርቴ፤","poem":2},{"text":"ዮካን በረ ረክነሳኒ ኬሰ","poem":1},{"text":"አከ መሌ ኦፍ ቱሉ ህንቀብዱ ቱርቴ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"በረ በላን እሳንት ዹፌ ኬሰ","poem":1},{"text":"ከረ ሰበኮቲን ኦል ሴኑ ህንቀብዱ ቱርቴ፤","poem":2},{"text":"ዮካን በረ ዸእች እሳንት ዹፌ ኬሰ","poem":1},{"text":"ረክነሳኒ ኬሰት እሳን ቱፈቹ ህንቀብዱ ቱርቴ፤","poem":2},{"text":"ዮካን በረ በላን እሳንት ዹፌ ኬሰ","poem":1},{"text":"ቀቤኘሳኒ ሳሙ ህንቀብዱ ቱርቴ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"በቀቶተሳ ፍጡፍ ጄቴ ቀጣሙረ ከራት","poem":1},{"text":"እሳን ኤገቹ ህንቀብዱ ቱርቴ፤","poem":2},{"text":"ዮካን በረ ረክነሳ ኬሰ","poem":1},{"text":"ሀምባሳ ደበርስቴ ኬኑ ህንቀብዱ ቱርቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“ጉያን ዋቀዮ","poem":1},{"text":"ሰቦተ ሁንዳፍ ዽኣቴረ።","poem":2},{"text":"አኩመ አት ሆጄቴ ስትስ ንሆጄተመ፤","poem":1},{"text":"ሆጂንኬስ መቱመኬት ዴብአ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አኩመ እስን ጋረኮ ቁልቁሉረት ዹግደን ሰነ፣","poem":1},{"text":"ሰቦትን ሁንድኑ እቱመ ፉፈኒ ንዹጉ፤","poem":2},{"text":"እሳን እት ዴዴብአኒ ዹጉ፤","poem":1},{"text":"አከ ዋን ጎንኩማ ህንዹግኒ ተኡ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ቱሉ ጥዮንረ ገሩ ፉረሙን ንጅራተ፤","poem":1},{"text":"እን ንቁልቁላአ፤","poem":2},{"lineBreak":true},{"text":"መን ያቆብስ ዻለሳኒ ንዹንፈቱ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"መን ያቆብ እብደ፣","poem":1},{"text":"መን ዮሴፍሞ አረበ እብዳ ተአ፤","poem":2},{"text":"መን ኤሳው ሁረ ተአ፤","poem":1},{"text":"እሳንስ እብደ እት ቀብሲሰኒ ጉበኒ በርበዴሱ።","poem":2},{"text":"መነ ኤሳው ኬሳ","poem":1},{"text":"ነምን ቶኮዩ ህንሀፉ”","poem":2},{"text":"ጄዼ ዱበቴረ ዋቀዮ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ነሞትን ኔጌብ","poem":1},{"text":"ቱሉወን ኤሳው ንቀበቱ፤","poem":2},{"text":"ነሞትን ጋረን ጀለ ጅራተንሞ","poem":1},{"text":"ብየ ፍልስጤሞታ ቀበቱ።","poem":2},{"text":"እሳን ድሬ ኤፍሬሚፊ ሰማርያ ንቀበቱ፤","poem":1},{"text":"ቤንያምሞ ብየ ግልኣድ ቀበተ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ገሬን ቦጅአምቶተ እስራኤል ከን ከነኣን ጅራቱ ኩን","poem":1},{"text":"ብየ ሀመ ሳረፕታት ጅሩ ዻለ፤","poem":2},{"text":"ቦጅአምቶትን ዬሩሳሌም ከኔን","poem":1},{"text":"ሴፋራድ ጅራተን መጋላወን ኔጌብ ዻሉ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ብልሰ ባስቶትን ቱሉወን ኤሳው ቡልቹዻፍ","poem":1},{"text":"ቱሉ ጥዮንት ኦል በኡ።","poem":2},{"lineBreak":true},{"text":"ሞቱማንስ ከን ዋቀዮ ተአ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/OBA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/JON/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/AMO/9.json","previousChapterAudioLinks":{},"numberOfVerses":21}