{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["ፈኬኘ ሶሎሞን እልመ ዳዊት፣ ሞቲ እስራኤል፦"]},{"type":"verse","number":2,"content":[{"text":"ኦጉማፊ ቀጄልፈመ ቀባቹዻፍ፣","poem":1},{"text":"ዱቢ ቤኩምሰ ጉዳ ሁበቹዻፍ፤","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኦጉማዻን ጅራቹዻን፣ ቀጄሉማዻን፣","poem":1},{"text":"ሙርቲ ቀጄላ ኬኑፊ ነመ ወል ቅጤሱዻንቀጄልፈመ አርገቹዻፍ፤","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ወረ ዋ ህንቤክኔፍ ኦፍ ኤገትኖ ኬኑዻፍ፣","poem":1},{"text":"ደርገጎታፍሞ ቤኩምሳፊ ሁበትና ኬኑዻፍ፣","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኦጌዪን ዸጌፈተኒ በሩምሰሳኒረት ዋ ሃደበለተን፤","poem":1},{"text":"ወር ቀልቢ ቀበንስ ቀጄልፈመ ሃአርገተን፤","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኩንስ ፈኬኛፊ ሂካ፣","poem":1},{"text":"ጄቻፊ ህቦ ኦጌዪ ሁበቹዻፍ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ዋቀዮን ሶዳቹን ጀልቀበ ኦጉማት፤","poem":1},{"text":"ጎዎትን ገሩ ኦጉማፊ አደበሙ ቱፈቱ።","poem":2}]},{"type":"heading","content":["ጎዎምፈሙራ ኦፍ ኤጉ"]},{"type":"verse","number":8,"content":[{"text":"ያ እልመኮ፣ ጎርሰ አባኬቲ ዸጌፈዹ፤","poem":1},{"text":"በርሲሰ ሃዸኬቲሌ ህንገትን።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ወን ኩን መታኬ ሚዸግሱዻፍ ጎንፎ፣","poem":1},{"text":"ሞርመኬ በሬቹዻፍሞ ፋየ ሲፍ ተአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ያ እልመኮ፣ ዮ ጩበሞትን ሶሶበኒ","poem":1},{"text":"ኦፍት ስ ሀርክሰን፣ ቶሌ ህንጄዽኒፍ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዮ እሳን፣ “ኑ ወጅን ኮቱ፤","poem":1},{"text":"ርጵኔ ዺገ ነማ ዸንገላስና፤","poem":2},{"lineBreak":true},{"text":"ነመ በሌሳ ህንቀብኔ ገላፈቹዻፍስዾከትኔ ኤገትና፤","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኮቱ አኩመ አዋላ ጅራት እሳን ልቅምስና፤","poem":1},{"text":"አኩመ ወረ ቦለ ኬሰ ቡፈመኒስ","poem":2},{"lineBreak":true},{"text":"ጉቱማን ጉቱት እሳን ልቅምስና፤","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኑ ዋን ገቲ ቀቡ ከን ጎሰ ሁንዳ ንአርገትነ፤","poem":1},{"text":"መኔንኬኘሌ ቦጁዻን ጉተትነ፤","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እጣኬ ኑ ወጅን ቡፈዹ፤","poem":1},{"text":"ኑስ ኮሮጆ ቶኮ ስ ወጅን ቆደትና” ሲን ጄዸን፣","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ያ እልመኮ፣ አት እሳን ወጅን ህንዴምን፤","poem":1},{"text":"ሚለኬቲን ከራሳኒረሌ ህንኤጄትን፤","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሚልሳኒ ጩቡት አሪፈታቲ፤","poem":1},{"text":"እሳን ዺገ ዸንገላሱፍ ጀርጀሩ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኡቱመ ስምብሮትን ሁንድ አርገኑ፣","poem":1},{"text":"ክዮ ቡሱን ዋን ገቲ ህንቀብኔዸ!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ነሞትን ኩኔን ዺጉመ ኦፊሳኒ ርጰኒ ኤገቱ፤","poem":1},{"text":"ሉቡመ ኦፊሳኒ ጋዱ!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ኩን ዹመ ወረ ቀቤኘ ከራ ሀማዻን አርገሙ ዱካ ቡአን ሁንዳት፤","poem":1},{"text":"ወን አከሲ ጅሬኘ ወረ እሰ አርገተኒ በሌሰ።","poem":2}]},{"type":"heading","content":["አኬከቺሰ ኦጉማ ቱፈቹረት ኬነሜ"]},{"type":"verse","number":20,"content":[{"text":"ኦጉማን ከራረት ጉድፍቴ እይት፤","poem":1},{"text":"እዶ ወል ገኢ ኡመታትስ ሰገሌሼ ኦል ፉዸት።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"እሼን ፊጤ ዳንዲራ እይት፤","poem":1},{"text":"ከረ መጋላ ዱራስ አከነ ጄቴ ዱበት፦","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“እስን ወር ሆማ ህንቤክኔ","poem":1},{"text":"ኩን ሀመ ዮሚት ከራኬሰን ከን ፋይዳ ህንቀብኔ ሰነ ጃለቱ?","poem":2},{"text":"ወር ነመት ቆሰን ሀመ ዮሚት ቆሳ ሰነት ገመደኒ","poem":1},{"text":"ጎዎትንስ ቤኩምሰ ጅቡ?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ሞርሚኮ ቀልቤፈዻ፤","poem":1},{"text":"አን ያደኮ እስኒ ነንዸንገላሰ፤","poem":2},{"lineBreak":true},{"text":"ዱቢኮስ እስኒፍን እብሰ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ገሩ ሰበቢ እስን ዬሮ አን እስን ዋሜት ድደኒ","poem":1},{"text":"ዬሮ አን ሀርከ በልእፈዼት ነምን ቶኮዩ ነ ህንዸጌፈትኒፍ፣","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዋን እስን ጎርሰኮ ሁንደ ቱፈተኒ","poem":1},{"text":"ዼከምሰኮ ዸገኡ ድደኒፍ፣","poem":2}]},{"type":"verse","number":26,"content":[{"text":"አንስ በዲሰኬሰንት ነንኮልፈ፣","poem":1},{"text":"ዬሮ በላን እስንት ዹፉትስ ነንቆሰ፤","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ዬሮ በላን አኩመ ቡቤት እስን ፉዸቱት፣","poem":1},{"text":"ዬሮ በዲስን አኩመ ቡቤ ሀማት እስን ሀጣኡት፣","poem":2},{"lineBreak":true},{"text":"ዬሮ ዽጵናፊ ረክን እስንት ዹፉት አን እስንተን ቆሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“ዬሮ ሰነ እሳን ነ ዋመቱ፤ አን ገሩ እሳን ጀላ ህንኦዋዹ፤","poem":1},{"text":"እሳን ነ በርባዱ፤ ገሩ ነ ህንአርገተን።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"እሳን ዋን ቤኩምሰ ጅበኒ","poem":1},{"text":"ዋቀዮን ሶዳቹሌ ፍለቹ ድደኒፍ፣","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ዋን ጎርሰኮ ፉዸቹ ድደኒ","poem":1},{"text":"ዼከምሰኮስ ቱፈተኒፍ፣","poem":2}]},{"type":"verse","number":31,"content":[{"text":"እሳን ገቲ ከራሳኒ ንኛቱ፤","poem":1},{"text":"ቡኣ ጀልእነሳኒስ ንቁፉ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ጎዎተ ዋ ደገቹቱ እሳን በሌሳቲ፤","poem":1},{"text":"ቁፍን ጎዎታ እሳኑመ በሌሰ፤","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ነምን ነ ዸጌፈቱ ከምዩ ገሩ ነጋዻን ጅራተ፤","poem":1},{"text":"እን ቀበናን ጅራተ፤ ወን ሀማንስ እሰ ህንሶዳችሱ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}