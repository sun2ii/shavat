{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"ዋቀዮ መዳሊ ህንአመነምኔ ንበልፈ፤","poem":1},{"text":"መዳሊ ዹጋትሞ ንገመደ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ጋፈ ኦፍ ቱሉን ዹፉ፣ ሰልጵነቱ ዹፈ፤","poem":1},{"text":"ገድ ኦፍ ቀቢሰ ወጅንሞ ኦጉማቱ ዹፈ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"አመነሙማን ቶሎታ እሳን ዱረ ዴመ፤","poem":1},{"text":"ወር ህንአመነምኔ ገሩ ደቡመሳኒቲን በዱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ጉያ ዼከምሳት ቀቤኝ ፋይዳ ህንቀቡ፤","poem":1},{"text":"ቀጄሉማን ገሩ ዱአ ጀላ ነመ ባሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ቀጄሉማን ወረ ሙዳ ህንቀብኔከራ ቀጄላ ባሳፍ፤","poem":1},{"text":"ሀሞን ገሩ ሀምኑመሳኒቲን በዱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ቀጄሉማን ቶሎታ እሳን ኦልቸ፤","poem":1},{"text":"ወር ህንአመነምኔ ገሩሀዊ ሀማዻን ቀበሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ዬሮ ነምን ሀማን ዱኡ፣ አብዲንሳስ ንበደ፤","poem":1},{"text":"ወን ነምን ሀማን ኤገቱስ ንበርበዴፈመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ነምን ቀጄላን ረኮ ጀላ ንባፈመ፤","poem":1},{"text":"ረኮን ሱንስ ቆደሳ ነመ ሀማረ ገአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ነምን ዋቀት ህንቡሌ ዱቢ አፋንሳቲን ኦላሳ በሌሰ፤","poem":1},{"text":"ነምን ቀጄላንሞ ቤኩምሳን ምልቀ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ዮሙ ነምን ቀጄላን በዻዹ መጋላን ንገመደ፤","poem":1},{"text":"ዮሙ ነምን ሀማን በርበዳኡሞ እየ ገመቹቱ ዸገአመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ኤበ ነመ ቶላቲን መጋላን ኡልፍነ አርገተ፤","poem":1},{"text":"አፋን ነመ ሀማቲን ገሩ ንበርበዴፈመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ነምን ሰሙ ህንቀብኔ ኦላሳ ቱፈተ፤","poem":1},{"text":"ከን ሁበትና ቀቡ ገሩ ንጨልእሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ነምን ኦዴሱ ዾክሳ ገድ ባሰ፤","poem":1},{"text":"ከን አመነሙ ገሩ እጪቲ ኤገ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ቀጄልፈመ ዸቢሳን ሰብን ንኩፈ፤","poem":1},{"text":"ባይእነ ጎርስቶታቲን ገሩ ነጋቱ አርገመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ነምን ነመ ህንቤክኔፍ ወቢ ተኡ ንረከተ፤","poem":1},{"text":"ነምን ነማፍ ከከቹፍ ጄዼ ሀርከ ዸኡ ድዱሞነጋን ጅራተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ዱበርቲን ገረ ላፌቲን ኡልፍነ አርገት፤","poem":1},{"text":"ነሞትን ገራ ዸጋሞ ቀቤኘ ቆፈ አርገቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ነምን ጋሪን ኦፍ ፈየደ፤","poem":1},{"text":"ገረ ጀቤስ ገሩ ረክነ ኦፍት ፍደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ነምን ሀማን ምንዳ ሶባ አርገተ፤","poem":1},{"text":"ከን ቀጄሉማ ፈጫፈቱሞ በዻሰ ዹጋ አርገተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ነምን ቀጄላን ዹጉማን ጅሬኘ አርገተ፤","poem":1},{"text":"ከን ዋን ሀማ ዱካ ቡኡ ገሩ ገረ ዱኣ አርገተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ዋቀዮ ወረ ያደ ጀልኣ ቀበን በልፈ፤","poem":1},{"text":"ወረ ከራንሳኒ ሙዳ ህንቀብኔትሞ ንገመደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ዋን ከነ ሁበዹ፦ ነምን ሀማን ኡቱ ህንአደበምን ህንሀፉ፤","poem":1},{"text":"ቀጄልቶትን ገሩ ብልሰ በኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ዱበርቲን ሚዸግዱን ቀልቢ ህንቀብኔ","poem":1},{"text":"አኩመ ቁቤላ ወርቄ ከን ፉኛን ቦዬት ጅርቱት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ወን ቀጄልቶትን ሀወን ጋሪ ተኣፍ፤","poem":1},{"text":"አብዲን ሀሞታ ገሩ ዼከምሰ ቆፈ ተአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ነምን ቶኮ ቶሉመ ዋ ነማ ኬነ፤","poem":1},{"text":"ተኡስ እቱመ ጫልችሴ ሶሮመ፤","poem":2},{"lineBreak":true},{"text":"ካንሞ ዋን ኬኑ መሉ ዾወተ፤ተኡስ እኑመ ህዮመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ነምን አርጃን ንበዻዸ፤","poem":1},{"text":"ነምን ወረ ካን ዼቡ ባሱ ኦፊሳቲሌ ዼቡ በአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ነመ ዾክሴ ምዻን ኩፈቱ ሰብን ንአባረ፤","poem":1},{"text":"ከን ጉርጉሩፍ ፌዺ ቀቡሞ ኤበቱ ጎንፎ ተኣፍ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ነምን ዋን ጋሪ በርባዱ ጨራ ጋሪ አርገተ፤","poem":1},{"text":"ሀምን ገሩ ነመ ሀምነ በርባዱት ዹፈ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ነምን ሶሩመ ኦፊሳ አብደቱ ከምዩ ንኩፈ፤","poem":1},{"text":"ቀጄላን ገሩ አኩመ ባለ መገሪሳት ለልሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"ነምን ማቲሳት ረኮ ፍዱ ቡቤ ቆፈ ዻለ፤","poem":1},{"text":"ጎዋንሞ ገርብቸ ነመ ኦጌሳ ተአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"እጅ ነመ ቀጄላ ሙከ ጅሬኛት፤","poem":1},{"text":"ነምን ሉቡ ነማ በራሩሞ ኦጌሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"ኤርገ ቀጄልቶትን ለፈረት ገቲሳኒ አርገተኒ፣","poem":1},{"text":"ነምን ዋቀት ህንቡሌፊ ጩበማንሀመም ጫላ ሃአርገተኒ ሬ!","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/10.json","previousChapterAudioLinks":{},"numberOfVerses":31}