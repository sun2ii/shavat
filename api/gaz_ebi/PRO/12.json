{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"ነምን አደበሙ ጃለቱ ከምዩ ቤኩምሰ ጃለተ፤","poem":1},{"text":"ከን ስሬፈሙ ጅቡ ገሩ ጎዋዸ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ነምን ጋሪን ዋቀዮ ብረት ፉዸተመ አርገተ፤","poem":1},{"text":"ዋቀዮ ገሩ ነመ ሀምነ መለቱት ንሙረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ነምን ቶኮ ሀምናን ጀባቴ ህንዻበቱ፤","poem":1},{"text":"ቀጄላን ገሩ ህንቡቅፈሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ኒቲን አመለ ጋሪ ዽርሰሼቲፍ ጎንፎዸ፤","poem":1},{"text":"ኒቲን ቃኔስቱ ገሩ አኩመ ቶርቶረ ለፌሳ ኬሳት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ከሮር ቀጄልቶታ ቀጄላዸ፤","poem":1},{"text":"ጎርስ ጀልኦታ ገሩ ጎዎምሳዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ዱቢን ሀሞታ ዺገ ዸንገላሱፍርጴ ነመ ኤገተ፤","poem":1},{"text":"ሃሳን ቶሎታ ገሩ ዱአ ጀላ ነመ ባሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ነሞትን ሀሞን ንገረገልፈሙ፤ ዴብአኒስ ህንአርገመን፤","poem":1},{"text":"መን ቀጄልቶታ ገሩ ጀባቴ ዻበተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ነምን ቶኮ አኩመ ኦጉማሳት ጀጀመ፤","poem":1},{"text":"ነምን ያደ ጀልኣ ቀቡሞ ንቱፈተመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ነምን ቱፈተማን ሆጄታ ቀቡ ቶኮ፣","poem":1},{"text":"ነመ ኦፍ ከበጁ ከን ዋን ኛቱዩ ህንቀብኔ ጫለ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ነምን ቀጄላን ሉቡ ሆሪሳቲፍ ያደ፤","poem":1},{"text":"ሆጂን ጀልኦታ ገሩ ቶላንሳዩ ሀምነ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ነምን ለፈሳ ቆተቱ ኛተ ጉዳ አርገተ፤","poem":1},{"text":"ከን ያደ ፋይዳ ህንቀብኔ ዱካ ቡኡ ገሩ ሁበትና ህንቀቡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ሀሞን ቦጁ ጀልኦታ ሀዉ፤","poem":1},{"text":"ህድ ቀጄልቶታ ገሩ ንለልሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ነምን ሀማን ጩቡ አፋንሳቲን ቀበመ፤","poem":1},{"text":"ነምን ቀጄላን ገሩ ረኮ ጀላ ምልቀ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ነምን ዋን አፋንሳቲ በኡን ዋን ጋሪን ጉተመ፤","poem":1},{"text":"ሆጂን ሀርከ ነማስ እሱማፍ ዴብአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ነመ ጎዋ ከራንሳ ቀጄላ እት ፈካተ፤","poem":1},{"text":"ነምን ኦጌስ ገሩ ጎርሰ ዸገአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ኣሪን ጎዋ ዮሙሱመ እሰራ ቤከመ፤","poem":1},{"text":"ነምን ሁበታን ገሩ አረብሶ ቱፈተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ነምኒ ዹጋ ዱበቱ ረጋ አመነማ ኬነ፤","poem":1},{"text":"ዹገ ባቱን ሶባ ገሩ ሶበ ዱበት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ዱቢን ኦፍ ኤገትና ህንቀብኔአኩመ ጎራዴ ነመ ወራነ፤","poem":1},{"text":"አረብን ነመ ኦጌሳ ገሩ ነመ ፈይሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"አፋን ዹጋ ዱበቱ በረ በራን ጅራተ፤","poem":1},{"text":"አረብን ሶበ ዱበቱ ገሩ ዬሮ ገባባ ቆፈ ጅራተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ገራ ወረ ዋን ሀማ መለተኒ ኬሰጎዎምሳቱ ጅረ፤","poem":1},{"text":"ወር ነጋ ቡሰን ገሩ ገመቹ ቀቡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ቀጄልቶተት ሚዻን ቶኮዩ ህንዹፉ፤","poem":1},{"text":"ሀሞን ረክናን ጉተሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ዋቀዮ አረበ ሶቡ ንጅበ፤","poem":1},{"text":"ወረ ዹጋ ዱበቱት ገሩ ንገመደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ነምን ሁበታን ቤካ ተኡሳ ዾክፈተ፤","poem":1},{"text":"ጎዎትን ገሩ ጎዉማሳኒ ለብሱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ሀርክ ነመ ጀባቴ ሆጄቱ ንሞአ፤","poem":1},{"text":"ዽባኡማን ገሩ ገርቡማት ነመ ጌሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ገራን ያደኡ ገድ ነመ ዴብሰ፤","poem":1},{"text":"ዱቢን ቶላንሞ ነመ ገመቺሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ነምን ቀጄላን ኦላሳ ከራ አርግሲሰ፤","poem":1},{"text":"ከራን ሀሞታ ገሩ ከራራ ነመ ጀልእሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ነምን ዽባኣን ዋን አደምሴ አጄሴ ህንዋደቱ፤","poem":1},{"text":"ከን ጀባቴ ሆጄቱሞ ቀቤኘ ገቲ ጉዳ አርገተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ከራ ቀጄሉማረ ጅሬኘቱ ጅረ፤","poem":1},{"text":"ዳንዲ ሰነረ ዱት ህንጅሩ።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/11.json","previousChapterAudioLinks":{},"numberOfVerses":28}