{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"እልም ኦጌስ ጎርሰ አባሳ ዸገአ፤","poem":1},{"text":"ቆስቱን ነማሞ ዼከምሰ ህንዸጌፈቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ነምን ዋን አፋንሳቲ በኡን ዋን ጋሪን ገመደ፤","poem":1},{"text":"ነምን ህንአመነምኔ ገሩ ጄቁምሳፍ አሪፈተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ነምን አረበሳ ኤገቱ፣ ጅሬኘሳ ኤገተ፤","poem":1},{"text":"ከን ኦፍ ኤገቹ መሌ ዱበቱሞ በዱፍ አሪፈተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ፌዺን ዽባኣ ዮምዩ ህንጉተሙ፤","poem":1},{"text":"ፌዺን ነመ ጀባቴ ሆጄቱሞ ጉቱማን ንምልካአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ነምን ቀጄላን ሶበ ጅበ፤","poem":1},{"text":"ነምን ሀማን ገሩ ቃኒፊ ሰልጵነ ፍደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ቀጄሉማቱ ነመ ቶላ ትክሰ፤","poem":1},{"text":"ሀምን ገሩ ጩበማ ገላፈተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ነምን ቶኮ ሶሬሰ ኦፍ ፈኬሰ፤ ገሩ ሆማ ህንቀቡ፤","poem":1},{"text":"ቶኮሞ ህዬሰ ኦፍ ፈኬሰ፤ ገሩ ቀቤኘ ጉዳ ቀበ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ሶሩምን ነመ ቶኮ ፉሪ ጅሬኘሳ ተኡ ደንደአ፤","poem":1},{"text":"ህዬስ ገሩ እፈትና ህንዸገኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"እፍን ነመ ቀጄላ አከ ጋሪ እፈ፤","poem":1},{"text":"እብሳን ነመ ሀማ ገሩ ንዻመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ኦፍ ቱሉማን ሎለ ቆፈ ባይእሰ፤ ኦጉማን ገሩ","poem":1},{"text":"ወረ ጎርሰ ዸገአን ብረት አርገምት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ማለቅን ከራ ሶባቲን ዹፉ ደፌ በደ፤","poem":1},{"text":"ነምን ጥኖ ጥኖን ማለቀ ወልት ቀበቱ ገሩ ንኩፈተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"አብዲን ለፈረ ሀርክፈቱ ገራ ነመ ዹኩብሰ፤","poem":1},{"text":"ሀዊን ጉተሙ ገሩ ሙከ ጅሬኛት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ነምን ጎርሰ ቱፈቱ በዲሰ ኦፍት ፍደ፤","poem":1},{"text":"ከን አጀጀ ኡልፌሱሞ በዻሰ አርገተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"በርሲስን ነመ ኦጌሳ ቡርቃ ጅሬኛት፤","poem":1},{"text":"ክዮ ዱኣራስ ነመ ዴብሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ሁበትናን ጋሪን ሱራ አርገምሲሰ፤","poem":1},{"text":"ከራን ወረ ህንአመነምኔ ገሩበዲሰት እሳን ጌሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ነምን ቀልቢ ቀቡ ከምዩ ቤኩምሳን ሆጄተ፤","poem":1},{"text":"ጎዋንሞ ጎዉማሳ ሙልእሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ኤርገማን ሀማን ረኮ ኬሰ ሴነ፤","poem":1},{"text":"ኤርገማን አመነማን ገሩ ፈይነ ፍደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ነምን አደበሙ ጅቡ ንህዮመ፤ ንቃነአስ፤","poem":1},{"text":"ከን ስሬፈመ ከበጁሞ ኡልፍነ አርገተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ሀዊን ጉተሜ ነመት ምኣወ፤","poem":1},{"text":"ጎዎትን ገሩ ዋን ሀማራ ዴብኡ በልፉ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ነምን ነመ ኦጌሰ ወጅን ዴሙ ኦጌሰ ተአ፣","poem":1},{"text":"ምቹን ጎዎታ ገሩ ንሚዸመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ወን ሀማን ጩበሞተ አርአተ፤","poem":1},{"text":"በዻዹማንሞ በዻሰ ቀጄሎታት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ነምን ጋሪን እልማን እልማንሳቲፍ ዻለ ደበርሰ፤","poem":1},{"text":"ቀቤኝ ነመ ጩበማ ገሩ ቀጄልቶታፍ ኩፈመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ቆናን ህዬሳ ምዻን ጉዳ ባሰ፤","poem":1},{"text":"ሙርቲን ጀልኣን ገሩ ሀጣኤ ዱራ በሌሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ነምን ሀርጩሜ ቁሰቱ እልመሳ ጅበ፤","poem":1},{"text":"ከን እልመ ኦፊ ጃለቱሞ እላለቻ እሰ አደበ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ነምን ቀጄላን ሀመ ቁፉት ኛተ፤","poem":1},{"text":"ገራን ነመ ሀማ ገሩ ንቤለአ።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/12.json","previousChapterAudioLinks":{},"numberOfVerses":25}