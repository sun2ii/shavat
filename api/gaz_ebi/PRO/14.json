{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"ዱበርቲን ኦጌቲን መነሼ እጃረት፤","poem":1},{"text":"ጎዋንሞ ሀርኩመሼቲን መነ ኦፊ ዲግድ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ነምን ቀጄሉማን ጅራቱ ዋቀዮን ሶዳተ፤","poem":1},{"text":"ከን ከራንሳ ጀልኣ ተኤ ገሩ እሰ ቱፈተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"አፋን ነመ ጎዋ ዱግደሳት ኡሌ ኦፍ ቱሉማ ፍደ፤","poem":1},{"text":"አረብን ኦጌዪ ገሩ እሳን ኤገ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ዮ ቆትዮን ህንጅሬ፣ ደላን ዱዋ ተአ፤","poem":1},{"text":"ገሩ ሁምነ ቆትዮ ቶኮቲን ምዻን ባይኤን አርገመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ዹገ ባቱን አመነማን ህንሶቡ፤","poem":1},{"text":"ዹገ ባቱን ሶባሞ ዸረ ኦፍ ኬሳ ገድ ነቀ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ቆስቱን ነማ ኦጉማ በርባዴ ህንአርገቱ፤","poem":1},{"text":"ነመ ዋ ሁበቱፍ ገሩ ቤኩምስ ደዸቢ መሌ ዹፈ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"አት ነመ ጎዋራ ፈጋዹ፤","poem":1},{"text":"አረበሳራ ቤኩምሰ ህንአርገቱቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ኦጉማን ሁበቶታ አከ እሳን ከራሳኒ ቤከን እሳን ጎዸ፤","poem":1},{"text":"ጎዉማን ጎዎታ ገሩ ከራራ እሳን በሌሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ጎዎትን ጩቡት ቆሱ፤","poem":1},{"text":"ቀጄልቶተ ግዱት ገሩ ሀዊ ጋሪቱ አርገመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ገራን ገደ ኦፊሳ ንቤከ፤","poem":1},{"text":"ነምን ብራ ቶኮዩ ገመቹሳራ ህንቆደቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"መን ነመ ሀማ ንበደ፤","poem":1},{"text":"ዱንካን ነመ ቀጄላሞ ንደራረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ከራን ቀጄላ ነመት ፈካቱ ቶኮ ጅረ፤","poem":1},{"text":"ዹመረት ገሩ ዱአት ነመ ጌሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ኮልፈ ኬሰትዩ ገራን ነመ ዹኩቡ ደንደአ፤","poem":1},{"text":"ገመቹንስ ገዳን ዹሙ ደንደአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ነምን ህንአመነምኔ ገቲ ከራሳ፣","poem":1},{"text":"ነምን ጋሪንሞ ገቲ ሆጂሳ አርገተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ነምን ሆማ ህንቤክኔ ዋን ሁንደ አመነ፤","poem":1},{"text":"ነምን ቀልቢ ቀቡ ገሩ ተርካንፊሳ እላለተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ነምን ኦጌስ ኦፍ ኤገተ፤ ዋን ሀማራስ ንዴብአ፤","poem":1},{"text":"ጎዋን ገሩ ዋን ሁንደት ጀርጀረ፤ ኦፍሌ ህንኤገቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ነምን ደፌ ኣሩ ጎዉማ ሆጄተ፤","poem":1},{"text":"ነምን ደበ ሆጄቱ ገሩ ንጅበመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ነምን ሆማ ህንቤክኔ ጎዉማ ዻለ፤","poem":1},{"text":"ቀልቤፈታን ገሩ ቤኩምሰ ጎንፈተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ነሞትን ሀሞን ፉለ ነሞተ ጋሪ ዱረት፣","poem":1},{"text":"ጀልኦንስ ከረ ቀጄልቶታ ዱረት ሰገዱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ህዬዪ ኦሎንሳኒዩ ንጅቡ፤","poem":1},{"text":"ሶሬዪንሞ ምቾተ ሄዱ ቀቡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ነምን ኦላሳ ቱፈቱ ጩቡ ሆጄተ፤","poem":1},{"text":"ከን ረከታፍ ገራ ላፉ ገሩ ኤብፈማዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ነምን ሀምነ ያዱ ከራራ ህንበዱ?","poem":1},{"text":"ወር ዋን ጋሪ ከሮርሰን ገሩ ጃለላፊአመነሙማ አርገቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ጀባተኒ ሆጄቹን ሁንድ ቡኣ ቡሰ፤","poem":1},{"text":"ኦዱን ፋይዳ ህንቀብኔ ገሩ ህዩማ ቆፈ ፍደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ጎንፎን ኦጌዪ ቀቤኘሳኒት፤","poem":1},{"text":"ጎዉማን ጎዎታ ገሩ ጎዉማ ዸለ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ዹገ ባቱን ዹጋ ሉቡ በራረ፤","poem":1},{"text":"ዹገ ባቱን ሶባሞ ሶበ ዱበተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ነምን ዋቀዮን ሶዳቱ ደአኖ ጀባ ቀበ፤","poem":1},{"text":"እጆሌንሳስ ደኦ አርገቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ዋቀዮን ሶዳቹን ቡርቃ ጅሬኛት፤","poem":1},{"text":"ክዮ ዱኣራስ ነመ ዴብሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ኡልፍን ሞቲ ቶኮ ባይእነ ኡመተሳት፤","poem":1},{"text":"ዮ ኡመትን ህንጅሬ ገሩ እልም ሞቲስ ንበደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"ነምን ኦብሰ ቀቡ ሁበትና ጉዳ ቀበ፤","poem":1},{"text":"ከን ደፌ ኣሩ ገሩ ጎዉማ ሙልእሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"ገራን ነጋ ቀቡ ዸግናፍ ጅሬኘ ኬነ፤","poem":1},{"text":"ህናፋን ገሩ ለፌ ቶርቶርሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"ነምን ህዬሰ ጩንቁርሱ ከን እሰ ኡሜ ቱፈተ፤","poem":1},{"text":"ነምን ህዬሳፍ ገራ ላፉሞ ዋቀ ከበጀ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"ሀሞን ጀልእኑመሳኒቲን በዱ፤","poem":1},{"text":"ቀጄልቶትን ገሩ ዱአ ኬሰትሌአመነሙማሳኒቲን ደአትኖ አርገቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"ኦጉማን ቀልቢ ነመ ዋ ሁበቱ ኬሰ ጅርት፤","poem":1},{"text":"ገራ ጎዎታ ኬሰት ገሩ ህንቤከምቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"ቀጄሉማን ሰበ ኦል ጉድሰ፤","poem":1},{"text":"ጩቡን ገሩ ሰበ ከሚፍዩ ሰልጵነ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"ሞቲን ተጃጅላ ኦጌሰት ንገመደ፤","poem":1},{"text":"ከን እሰ ቃኔሱት ገሩ ንዼከመ።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/13.json","previousChapterAudioLinks":{},"numberOfVerses":35}