,{"type":"verse","number":8,"content":[{"text":"ዋቀዮ ኣርሳ ሀሞታ ንበልፈ፤","poem":1},{"text":"ከዸናን ቶሎታ ገሩ እሰ ገመቺሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ዋቀዮ ከራ ሀሞታ ንበልፈ፤","poem":1},{"text":"ወረ ቀጄሉማ ዱካ ቡአን ገሩ ንጃለተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ነመ ዳንዲራ ጀልአቱ አደቢ ሀማቱ እሰ ኤገተ፤","poem":1},{"text":"ከን ስሬፈመ ጅቡ ንዱአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ዱኣፊ በዲስን ፉለ ዋቀዮ ዱረት ቤከሞዸ፤","poem":1},{"text":"ዮስ ገራን ነማ ሀመም ጫላ ሃቤከሙ ሬ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ነምን ቆሱ ስሬፈመ ህንጃለቱ፤","poem":1},{"text":"ነመ ኦጌሳንስ ህንመርአቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ገራን ገመዱ አከ ፉል እፉ ጎዸ፤","poem":1},{"text":"ገድ ገራ ገሩ ሀፉረ ጨብሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ገራን ዋ ቀልቤፈቱ ቤኩምሰ በርባደ፤","poem":1},{"text":"አፋን ጎዋ ገሩ ጎዉማ ኛተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"በር ነመ ሀጩጨሜ ጉቱማን ጉቱት ገደዶዸ፤","poem":1},{"text":"ገራ ገመዱፍ ገሩ ጉያን ሁንድኑ ጭዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ቀቤኘ ጉዳ ረክነ ኦፍ ኬሳ ቀቡ መና፣","poem":1},{"text":"ዋቀዮን ሶዳቻ ዋን ጥና ቀባቹ ወየ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ጅባን ጮመ ሰንጋ ኛቹ መና፣","poem":1},{"text":"ጃለላን ራፉ ኛቹ ወየ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ነምን ደፌ ኣሩ ሎለ ከካሰ፤","poem":1},{"text":"ነምን ኦብሰ ቀቡ ገሩ ሎለ ቀበኔሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ከራን ነመ ዽባኣ ቆራቲዻን ጩፈመ፤","poem":1},{"text":"ዳንዲን ቶሎታ ገሩ ከራ ድሪራዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"እልም ኦጌስ አባሳ ገመቺሰ፤","poem":1},{"text":"ነምን ጎዋን ገሩ ሃዸሳ ቱፈተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ነመ ቀልቢ ህንቀብኔ ጎዉማቱ እሰ ገመቺሰ፤","poem":1},{"text":"ነምን ሁበታን ገሩ ዳንዲ ቀጄላረ ዴመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ከሮር ጎርሰ ህንቀብኔ ፊጣን ህንበኡ፤","poem":1},{"text":"ገሩ ጎርስቶተ ሄዱዻን ንምልካአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ነምን ቶኮ ዴቢ መሉ ኬኑዻን ገመቹ አርገተ፤","poem":1},{"text":"ዱቢን ዬሮሳት ዱበተሙ አከም ጋሪዸ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ዳንዲን ነመ ሁበታ አከ እን ሲኦልት ገድ ህንቡኔፍ","poem":1},{"text":"ገረ ጅሬኛት ኦል እሰ ባሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ዋቀዮ መነ ነመ ኦፍ ቱሉ ንዲገ፤","poem":1},{"text":"ዳንጋ ሃዸ ህዬሳ ገሩ ንዻበ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ዋቀዮ ያደ ነመ ሀማ ንበልፈ፤","poem":1},{"text":"ያድን ነመ ቁልቁሉ ገሩ እሰ ገመቺሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ነምን ዶቅን ማቲሳት ረክነ ፍደ፤","poem":1},{"text":"ከን መተኣ ጅቡ ገሩ ንጅራተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ገራን ነመ ቀጄላ ሃለ እቲን ዴቢ ኬኑ ያደ፤","poem":1},{"text":"አፋን ነመ ሀማ ገሩ ሀምነ ዸንገላሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"ዋቀዮ ነመ ሀማራ ፈጎ ጅረ፤","poem":1},{"text":"ከዸትና ነመ ቀጄላ ገሩ ንዸገአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"ፉል እፋን ገራ ገመቺሰ፤","poem":1},{"text":"ኦዱን ጋሪንስ ለፌ ሃሮምሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"ነምን አደቢ ጅሬኘ ኬኑ ዸጌፈቱ፣","poem":1},{"text":"ኦጌዪ ግዱ ጅራተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"ነምን አደቢ ቱፈቱ ኦፉመ ቱፈተ፤","poem":1},{"text":"ከን ስሬፈመ ፉዸቱ ገሩ ሁበትና አርገተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"ዋቀዮን ሶዳቹን ኦጉማ ነመ በርሲሰ፤","poem":1},{"text":"ገድ ኦፍ ቀቡንስ ኡልፍነ ዱረ ዹፈ።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/14.json","previousChapterAudioLinks":{},"numberOfVerses":33}