{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"ከሮር ገራ ከን ነማት፤","poem":1},{"text":"ዴቢን አረባ ገሩ ዋቀዮ ብራ ዹፈ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ነመ ቶኮ ከራንሳ ሁንድ ቁልቁሉ እት ፈካተ፤","poem":1},{"text":"ያደ ነማ ገሩ ዋቀዮቱ መዳለ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ዋን ሆጄቱ ሁንደ ዋቀዮት ኬነዹ፤","poem":1},{"text":"ከሮርኬስ ሲፍ ምልካአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ዋቀዮ ዋን ሁንደ ካዮ ኦፊሳቲፍ ሆጄተ፤","poem":1},{"text":"ሀሞተዩ ጉያ በዲሳቲፍ ቆጴሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ነምን ኦፍ ቱሉ ከምዩ ፉለ ዋቀዮ ዱረት በልፈማዸ፤","poem":1},{"text":"ዹጉማን እን ኡቱ ህንአደበምን ህንሀፉ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ነምን ጃለላፊ አመነሙማዻን አራረ ጩቡ አርገተ፤","poem":1},{"text":"ዋቀዮን ሶዳቹዻንስ ሀምነራ ጭተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ዮ ከራን ነማ ዋቀዮን ገመቺሴ፣","poem":1},{"text":"እን አከ ዲኖትንሳስ ነጋን እሰ ወጅን ጅራተን ንጎዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ገሊ ጉዳ ጀልእናን አርገተን መና","poem":1},{"text":"ዋን ጥኖ ቀጄሉማን አርገተን ወየ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ነምን ገራሳ ኬሰት ከራሳ ከሮርፈተ፤","poem":1},{"text":"ዋቀዮ ገሩ ተርካንፊሳሌ ንሙርቴሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ህዺን ሞቲ ሆደ ዱበተ፤","poem":1},{"text":"አፋንሳሌ ሙርቲ ህንጀልእሱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"መዳሊፊ ሰፈርቱን ቀጄላን ከን ዋቀዮት፤","poem":1},{"text":"ኡልፍን ኮሮጆ ኬሰ ጅሩ ሁንድኑ ሆጂሳት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ሰበቢ ቴሶን ቀጄሉማዻን ጀባቴ ዻበቱፍ","poem":1},{"text":"ሞቶትን ዋን ሀማ ሆጄቹ ንበልፉ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ሞቶትን አፋን ዹጋ ዱበቱት ንገመዱ፤","poem":1},{"text":"እሳን ነመ ዹጋ ዱበቱ ንጃለቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ዼከምስ ሞቲ ኤርገማ ዱኣት፤","poem":1},{"text":"ነምን ኦጌስ ገሩ ንቀበኔሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ጅሬኝ እፈ ፉለ ሞቲ ኬሰ ጅረ፤","poem":1},{"text":"ሱራንሳ አኩመ ዱሜሰ ቦካ አርፋሳት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ኦጉማ አርገቹን ወርቄ ጫለ፤","poem":1},{"text":"ሁበትና አርገቹንስ ሜቲ ጫለ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ዳንዲን ነመ ቶላ ሀምነራ ፈጎዸ፤","poem":1},{"text":"ነምን ከራሳ ኤጉስ ጅሬኘሳ ኤገተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ኦፍ ቱሉን በዲሳን ዱረ፣","poem":1},{"text":"ኦፍ ቦኮክሱንስ ኩፋቲን ዱረ ዴመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ወረ ኦፍ ቱሉ ወጅን ቦጁ ቆደቹ መና፣","poem":1},{"text":"ሀፉራን ገድ ኦፍ ቀበኒ ወረ ጩንቁርፈሜ ወጅን ጅራቹ ወየ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ነምን ጎርሰ ፉዸቱ ከምዩ ንምልካአ፤","poem":1},{"text":"ከን ዋቀዮን አመነቱስ ኤብፈማዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ነምን ገራዻን ኦጌሰ ተኤ ቀልቤፈታ ጄዸመ፤","poem":1},{"text":"ዱቢን ምኣዉሞ ጎርሰ ደበለ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ሁበትናን ነመ እሰ ቀቡፍ መደ ጅሬኛት፤","poem":1},{"text":"ጎዉማን ገሩ ጎዎተት አደቢ ፍደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ገራን ነመ ኦጌሳ አረበሳ ቀጄልቸ፤","poem":1},{"text":"አፋንሳስ ጎርሰ ደበለ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ዱቢን ነመ ገመቺሱ ዻበ ደማት፤","poem":1},{"text":"እን ሉቡት ንምኣወ፤ ለፌስ ንፈይሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ከራን ቀጄላ ነመት ፈካቱ ቶኮ ጅረ፤","poem":1},{"text":"ዹመረት ገሩ ዱአት ነመ ጌሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ፌዺን ሆጄታን ቶኮ ኛታፍ ቀቡ","poem":1},{"text":"ሆጂፍ እሰ ከካሰ፤ ቤለኡንሳስ እቱመ ጭመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ነምን ፋይዳ ህንቀብኔ ሀምነ መለተ፤","poem":1},{"text":"ሃሳንሳስ አኩመ እብደ ዋ ጉቡት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ነምን ጀልኣን ሎለ ከካሰ፤ ሀመቱንሞ","poem":1},{"text":"ምቾተ ወልት ዽኣተን ገርገር ባፍት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"ነምን ጄቁምሳን ዴሙ ኦላሳ ጎዎምሴ","poem":1},{"text":"ከራ ጀልኣት እሰ ጌሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"ነምን እጀ ቅሱ ጀልእነ ከሮርፈተ፤","poem":1},{"text":"ከን ህዺ ጭኒነቱሞ ሀምነ ፍደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"አሪን ጎንፎ ኡልፍናት፤","poem":1},{"text":"እንስ ከራ ቀጄላዻን አርገመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"ጎተ ወራናረ ነመ ኦብሰ ቀቡ፣","poem":1},{"text":"ነመ መጋላ ቶኮ ቦጅኤ ፉዸቱረ ከን ኦፍ ቀቡ ወየ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"እጣን ጉዴደረት ቡፈመ፤","poem":1},{"text":"ሙርቶትንሳ ገሩ ጉቱማን ጉቱት ዋቀዮ ብራ ዹፈ።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/15.json","previousChapterAudioLinks":{},"numberOfVerses":33}