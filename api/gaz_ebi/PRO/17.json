{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"መነ ኛታ ዹጋቲን ጉተሜ ከን ሎለ ቀቡ መና፣","poem":1},{"text":"እዶ ነጋን ጅሩት ሁራኣ ቡዴነ ጎጎጋ ወየ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ገርብች ሁበታን እልመ ሰልጳ ቡልቸ፤","poem":1},{"text":"ኦቦሎተ ግዱትስ ዻለ ቆደተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ኦኮቴን ዋ እት በቅሰን ሜቲፍ፣ ቦል እብዳሞ ወርቄፍ፤","poem":1},{"text":"ዋቀዮ ገሩ ገራ ነማ ቆረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ነምን ሀማን ዱቢ ጎዎምሳ ዸጌፈተ፤","poem":1},{"text":"ሶባንስ አረበ በለአማዻፍ ጉረ ኬነ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ነምን ህዬዪት ቆሱ ከን እሳን ኡሜ ሰነ ቱፈተ፤","poem":1},{"text":"ከን በዲሰ ነማት ገመዱ ኡቱ ህንአደበምን ህንሀፉ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ነመ ጃሬ ቶኮፍ እልማን እልማንሳ ጎንፎዸ፤","poem":1},{"text":"ሃዻፊ አባንስ እጆሌሳኒቲፍ ኡልፍነ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ዱቢን በኤስ ነመ ጎዋት ህንቶሉ፤","poem":1},{"text":"ህዺን ሶቡሞ ሀመም ቡልቻ ቶኮት ሃሀማቱሬ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"መተኣን ነምቸ ኬኑፍ ምአ ፈልፈላት፤","poem":1},{"text":"እን ለፈ ዸቁ ከምትዩ ንምልካአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ነምን በሌሳ ነማፍ ዺሱ ጃለለ ጉድሰ፤","poem":1},{"text":"ነምን ዋን ቶኮረ ዴዴብኡ፣ገሩ ምቾተ ወልት ዽኣተን ገርገር ባሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ሀመ ጎዋን ዬሮ ዽበ ገረፈሜ እት ዸገአሙ ጫላ","poem":1},{"text":"እፈትናን ነመ ዋ ሁበቱት ዸገአመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ነምን ሀማን ፍንጭለ ቆፈ በርባደ፤","poem":1},{"text":"ኤርገማን ነማ ህንናኔ እሰት ንኤርገመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ጎዋ ጎዉማ እሰ ኬሰ ጅሩን","poem":1},{"text":"ወልት ዹፉ መና አማኬተ ዸልቱ እልማንሼጀላ ፉዸተመኒን ወልት ዹፉ ወየ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ነመ ቆደ ጋሪ ሀማ ዴብሱ፣","poem":1},{"text":"ሀምን መነሳ ኬሳ ህንበኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ሎለ ጀልቀቡን አኩመ ብሻን ጨብሰኒ ያሱት፤","poem":1},{"text":"ከናፉ ኡቱ ሎል ህንሆእን ዱቢ ዺስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ዋቀዮ ዋን ከነ ለቹ ንበልፈ፤","poem":1},{"text":"ኩንስ ነመ የከ ቀቡ ቁልቁሉ ጎቹፊነመ በሌሳ ህንቀብኔት ሙሩዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ሰበቢ እን ኦጉማ አርገቹፍ ፌዺ ህንቀብኔፍ፣","poem":1},{"text":"ማለቅን ሀርከ ጎዋ ጅሩ ፋይዳ ማሊ ቀበ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ምቹን ዬሮ ሁንደ ነመ ጃለተ፤","poem":1},{"text":"ኦቦሌስሞ ጉያ ረኮቲፍ ዸለተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ነምን ቀልቢ ህንቀብኔ ሀርከ ዸኤ ዋ ነማፍ ከከተ፤","poem":1},{"text":"ፉለ ኦላ ኦፊሳ ዱረትስ ወቢ ተአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ነምን ሎለ ጃለቱ ጩቡ ጃለተ፤","poem":1},{"text":"ነምን ከረ ኦል ዼራ እጃሩስ በዲሰ ዋመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ነምን ያደ ሀማ ቀቡ ህንምልካኡ፤","poem":1},{"text":"ከን አረብንሳ ነመ ጎዎምሱስ ረኮ ኬሰ ሴነ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"እልም ጎዋን አባሳት ገደ ፍደ፤","poem":1},{"text":"አባን እልመ ጎዋስ ህንገመዱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ገራን ገመዱ ቆርቸ ጋሪዸ፤","poem":1},{"text":"ሀፉር ጨቤሞ ለፌ ጎግሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ነምን ሀማን ከራ ሙርቲ ቀጄላ ጀልእሱፍ ጄዼ","poem":1},{"text":"ዾክሳዻን መተኣ ፉዸተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ነምን ሁበታን ፉለሳ ገረ ኦጉማት ዴብፈተ፤","poem":1},{"text":"እጅ ጎዋ ገሩ ሀመ ሀንዳረ ለፋት ጆረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"እልም ጎዋን አባሳት ገደ ፍደ፤","poem":1},{"text":"ሃዸ እሰ ዴሴትስ ጅሬኘ ሀዼሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ነመ በሌሳ ህንቀብኔ ቶኮ አደቡን ጋሪ ምት፤","poem":1},{"text":"ቆንዳልቶተ አመነሞ ሩኩቱንስ ስሪ ምት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ነምን ቤካን ኦፍ ቁሰቻ ዱበተ፤","poem":1},{"text":"ነምን ሁበታንስ ሀፉረ ቀበናኣ ቀበ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ጎዋንዩ ዮሙ ጨልእሱ ኦጌሰ ፈካተ፤","poem":1},{"text":"ዮሙ አረበሳ ቶአቱስ ሁበታ ፈካተ።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/16.json","previousChapterAudioLinks":{},"numberOfVerses":28}