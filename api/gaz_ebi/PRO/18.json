{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":[{"text":"ነምን አዳን ኦፍ ባሱ ኦፍቱማ ዱካ ቡአ፤","poem":1},{"text":"ሙርቲ ዹጋ ሁንዳንስ ንሞርመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ነምን ጎዋን ሁበትና አርገቹት ህንገመዱ፤","poem":1},{"text":"ገሩ ያዱመሳ እብሱት ገመደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ዬሮ ሀምን ዹፉ ቱፊን ዹፈ፤","poem":1},{"text":"ሰልጵንስ ቃኒ ወጅን ዹፈ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ዱቢን አፋን ነማ ብሻን ገድ ፈጎዸ፤","poem":1},{"text":"ቡርቃን ኦጉማ ገሩ ብሻን ያኡዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ገረ ነመ ሀማ ጎሩንዮካን ነመ በሌሳ ህንቀብኔ","poem":1},{"text":"ሙርቲ ቀጄላ ዾወቹን ጋሪ ምት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ህዺን ጎዋ ሎለ ፍደ፤","poem":1},{"text":"አፋንሳስ ሩኩተሙ እት ዋመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"አፋን ጎዋ በዲሰሳት፤","poem":1},{"text":"ህዺንሳስ ክዮ ሉቡሳት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ዱቢን ሀመቱ አኩመ ጉርሻ ምኣዉት፤","poem":1},{"text":"ገረ ኩታ ገራትስ ገድ ቡአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ነምን ሆጂሳረት ዽባኡ፣","poem":1},{"text":"ኦቦሌሰ ነመ ዋ በሌሱት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"መቃን ዋቀዮ ገሞ ጀባዸ፤","poem":1},{"text":"ነምን ቀጄላን እት በቀቴ በዲሰ ኦለ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ቀቤኝ ሶሬዪ እሳኒፍ መጋላ ደኦ ቀብዱዸ፤","poem":1},{"text":"እሳንስ አከ ደላ ኦል ዼራት ሄዱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ኩፋቲዻን ዱረ ገራን ነማ ኦፍ ቱለ፤","poem":1},{"text":"ገድ ኦፍ ቀቡን ገሩ ኡልፍናን ዱረ ዹፈ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ኡቱ ህንዸጌፈትን ዴቢ ኬኑን፣","poem":1},{"text":"ጎዉማፊ ቃኒዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ሀፉር ነማ ዹኩበ ንኦብሰ፤","poem":1},{"text":"ሀፉረ ጨቤ ገሩ ኤኙቱ ኦብሱ ደንደአ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ገራን ነመ ሁበታ ቤኩምሰ አርገተ፤","poem":1},{"text":"ጉር ኦጌሳስ ዋን ከነ በርባደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ኬናን አብቸ ኬኑፍ ከራ በነ፤","poem":1},{"text":"ፉለ ነሞተ ጉርጉዳ ዱረትስ እሰ ዽኤሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ሀመ ነምን ብራ ዹፌ እሳን ሞርሙት፣","poem":1},{"text":"ነምን ጀልቀበት ህመተሳ ዽኤፈቱ ቶኮዹጋ ቀቤሰ ፈካተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"እጣ ቡሱን ወል ፈልሚ ቀበኔሰ፤","poem":1},{"text":"ነሞተ ወል ሎለን ጀጀቦስ አዳን ገልቸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ኦቦሌሰ የከሜ ቶኮ ዴብሱንመጋላ ደኦ ቀብዱረ ኡልፋተ፤","poem":1},{"text":"ወል ፈልሚንስ አኩመ ደንቀራ ከረ ደላ ዸጋት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"እጀ አፋንሳቲን ገራን ነማ ቁፈ፤","poem":1},{"text":"ዱቢ አረበሳቲንስ ንጉተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"አረብን ሁምነ ጅሬኛቲፊ ዱኣ ቀበ፤","poem":1},{"text":"ወር እሰ ጃለተንስ እጀሳ ኛቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ነምን ኒቲ አርገቱ ዋን ጋሪ አርገተ፤","poem":1},{"text":"ፉለ ዋቀዮ ዱረትስ ሱራ አርገተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ህዬስ አረበ ላፋዻን ዱበተ፤","poem":1},{"text":"ሶሬስ ገሩ ሰገሌ ጀባዻን ዴቢ ኬነ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ነምን ምቾተ ባይእሱ ንበደ፤","poem":1},{"text":"ገሩ ምቹን ኦቦሌሰ ጫላ ነመት ኣኑ ንጅረ።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}