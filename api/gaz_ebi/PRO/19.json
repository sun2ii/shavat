{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"ጎዋ ደበ ዱበቱ መና","poem":1},{"text":"ህዬሰ አመነሙማዻን ጅራቱ ወየ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ነምን ቤኩምሰ ህንቀብኔ ጋሪ ምት፤","poem":1},{"text":"ሚል ጀርጀሩስ ከራራ ጀልአተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ጎዉማን ነማ ከራሳ ጀልእሰ፤","poem":1},{"text":"ገራንሳሞ ዋቀዮት ኣረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"በዻዹማን ምቾተ ሄዱ ነመ አርገቺሰ፤","poem":1},{"text":"ህዬስ ገሩ ምቾተሳራ ገርገር በአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ነምን ሶባን ዹጋ በኡ ኡቱ ህንአደበምን ህንሀፉ፤","poem":1},{"text":"ነምን ሶበ ኦዴሱስ ጀላ ህንበኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ነምን ሄዱን ቡልቻ ብረት ሱራ አርገቹ በርባደ፤","poem":1},{"text":"ነምን ሁንድስ ምቹ ነመ ዋ ነማ ኬኑት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ኦቦሎትን ህዬሳ ሁንድኑ እሰ ጅቡ፤","poem":1},{"text":"ዮስ ምቾትንሳ ሀመም ጫላ እሰራ ሃፈጋተን ሬ!","poem":2},{"text":"እን ከዸቻ እሳን ዱካ ቡኡዩ","poem":1},{"text":"እሳን ኤሰቱ ህንአርገመን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ነምን ቀልቢ ቀቡ ኦፊሳ ጃለተ፤","poem":1},{"text":"ነምን ሁበትና ጃለቱ ንምልካአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ነምን ሶባን ዹጋ በኡ ኡቱ ህንአደበምን ህንሀፉ፤","poem":1},{"text":"ነምን ሶበ ኦዴሱስ ንበደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ጅሬኘ ቀነኒ ጅራቹን ጎዋፍ ህንመሉ፤","poem":1},{"text":"ዮስ እልማን ሞቲ ቡልቹን ገርብቻፍሀመም ጫላ ሃሀማቱሬ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ኦጉማን ነመ ቶኮ ኦብሰ ኬናፍ፤","poem":1},{"text":"በሌሳ ነማረ ደርቡንስ እሳፍ ኡልፍነ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ዼከምስ ሞቲ አኩመ ኣዱ ሌንጫት፣","poem":1},{"text":"ሱራንሳሞ አኩመ ፍጤንሰ መርገረት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"እልም ጎዋን አባሳቲፍ በዲሰ፤","poem":1},{"text":"ኒቲን ኘክፍቱንስ","poem":2},{"lineBreak":true},{"text":"አከ መነ ዬሮ ሁንዱማ ዽምሱት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"መናፊ ቀቤኝ ወረ ኦፊራ ዻለሙ፤","poem":1},{"text":"ኒቲ ቀልቢ ቀብዱ ገሩ ዋቀዮቱ ነማፍ ኬነ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ዽባኡማን ህርበ ጉዳ ነመት ቡሰ፤","poem":1},{"text":"ነምን ሆጂ መሌ ታኡስ ንቤለአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ነምን አጀጀ ኤጉ ሉቡሳ ኤገተ፤","poem":1},{"text":"ከን ከራሳ ቱፈቱሞ ንዱአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ነምን ህዬሳፍ ገራ ላፉ ዋቀዮፍ ልቄሰ፤","poem":1},{"text":"ዋቅንስ ዋን እን ሆጄቴ ሰናፍ እሰ በዻሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ዬሮ አብዲን ጅሩት እልመኬ አደበዹ፤","poem":1},{"text":"አከ እን ዱኡፍስ ጨልእስቴ ህንእላልን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ነምን ደፌ ኣሩ አደበሙ ቀበ፤","poem":1},{"text":"አት ዮ እሰ ኦልችቴ፣ አመሌ አከሱመ ጎቹ ቀብደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ጎርሰ ነማ ዸጌፈዹ፤ ስሬፈመስ ፉዸዹ፤","poem":1},{"text":"ዹመረት አት ነመ ኦጌሰ ታተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ገራ ነማ ኬሰ ከሮረ ባይኤቱ ጅረ፤","poem":1},{"text":"ገሩ ወን ፊጣን በኡ ካዮ ዋቀዮት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ወን ነምን ሀዉ ጃለለ ዹመ ህንቀብኔዸ፤","poem":1},{"text":"ሶብዱ ተኡ መና ህዬሰ ተኡ ወየ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ዋቀዮን ሶዳቹን ጅሬኘት ነመ ጌሰ፤","poem":1},{"text":"ዮስ ነምን ቦቆናዻን ጅራተ፤ረክንስ እሰ ህንአርገቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ዽባኣን ሀርከሳ ወጪቲ ኬሰ ካአ፤","poem":1},{"text":"ገረ አፋን እሳትስ ህንዴብፈቱ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ቆስቱ ገረፍ፤ ወላላን ሁበትና አርገታ፤","poem":1},{"text":"ነመ ቀልቢ ቀቡ እፈዹ፤ እን ቤኩምሰ አርገታቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ነምን አባሳ ሳሙ፣ ሃዸሳስ ከን መና አርኡ፣","poem":1},{"text":"እልመ ቃኒፊ ሰልጵነ ፍዱዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ያ እልመኮ፣ ሜ ቀጄልፈመ ዸጌፈቹ ዺስ፤","poem":1},{"text":"አት ዱቢ ቤኩምሳራ ንበዳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ዹገ በኣን ፋይዳ ህንቀብኔ ሙርቲ ቀጄላ ቱፈተ፤","poem":1},{"text":"አፋን ሀሞታሞ ሀምነ ልቅምሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"ቆስቶታፍ አደቢ፣","poem":1},{"text":"ዱግደ ጎዎታቲፍሞ ሩኩታቱ ቆጴፈመ።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}