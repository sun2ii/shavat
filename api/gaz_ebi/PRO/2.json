{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":2,"content":[{"type":"heading","content":["በዻሰ ኦጉማ"]},{"type":"verse","number":1,"content":[{"text":"ያ እልመኮ፣ ዮ አት ዱቢኮ ፉዸቴ","poem":1},{"text":"አጀጀኮስ ኦፍ ኬሰት ኩፈቴ፣","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዮ አት ጉረኬ ኦጉማት ገረገልፈቴ","poem":1},{"text":"ያደኬ ሁበትናት ዴብፈቴ፣","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዮ አት ጀባቴ ቀልቤፈትና በርባዴ","poem":1},{"text":"ሁበትና አርገቹፍ ጄቴ እይቴ ከዸቴ፣","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዮ አት አኩመ ሜቲት እሰ በርባደቴ","poem":1},{"text":"አኩመ ቀቤኘ ዾክፈሜት እሰ በርባዴ፣","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አት ዋቀዮን ሶዳቹ ንሁበተ፤","poem":1},{"text":"ዋቀ ቤኩስ ንአርገተ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዋቀዮ ኦጉማ ነማ ኬናቲ፤","poem":1},{"text":"አፋንሳ ኬሳሌ ቤኩምሳፊ ሁበትናቱ በአ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እን ቀጄልቶታፍ ኦጉማ ዹጋ ኩሰ፤","poem":1},{"text":"ወረ አዴምስሳኒ ሙዳ ህንቀብኔፍ ጋቸነ፤","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እን ዳንዲ ቶሎታ ንኤገ፤","poem":1},{"text":"ከራ ቁልቁሎተሳሌ ንትክሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ኤርገሲ አት ቀጄሉማፊ ሙርቲ ቀጄላ፣","poem":1},{"text":"ነመ ወል ቅጤሱ፣ ከራ ቀጄላ ሁንደስ ንሁበተ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኦጉማን ገራኬ ሴነ፤","poem":1},{"text":"ቤኩምስስ ሉቡኬ ገመቺሰ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ቀልቤፈናን ስ ኤገ፤","poem":1},{"text":"ሁበትናንስ ስ ትክሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ኦጉማን ከራ ሀሞታራ፣","poem":1},{"text":"ነሞተ ደበ ዱበተን ጀላስ ስ በራረ፤","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ወረ ከራ ዱከናረ ዴሙዻፍ ጄዸኒ","poem":1},{"text":"ዳንዲ ቀጄላ ዺሰን፣","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ወረ ዋን ሀማ ሆጄቹት ገመደን፣","poem":1},{"text":"ወረ ጀልእነ ሆጄቹን እት ቶሉ፣","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ወረ ዳንዲንሳኒ ጀልአቴ፣","poem":1},{"text":"ወረ ከራንሳኒ ደቤ ጀላ ስ በራረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ኦጉማቱ ዱበርቲ ገንደ ለቤ፣","poem":1},{"text":"ኒቲ ዱቢዻን ሶሶብዴ ኦፍት ነመ ሀርክፍቱ ጀላ ስ በራረ፤","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኒቲ ዽርሰሼ ከን ጀልቀባ ዺፍቴ","poem":1},{"text":"ከኩ ፉለ ዋቃ ዱረት ገልቴ ሰነ ደገቴ ጀላ ስ በራረ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"መንሼ ገረ ዱኣት፣ ከራንሼሞ","poem":1},{"text":"ገረ ሀፉሮተ ወረ ዱአኒት ነመ ጌሳቲ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ነምን ገረሼ ዸቁ ቶኮዩ ህንዴብኡ","poem":1},{"text":"ዮካን ከራ ጅሬኛ ህንአርገቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ከናፉ አት ከራ ነሞተ ገጋሪረ ንዴምተ፤","poem":1},{"text":"ዳንዲ ቀጄልቶታራስ ህንጀልአቱ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ቶሎን ብየቲ ኬሰ ንጅራቱቲ፤","poem":1},{"text":"ወር ሙዳ ህንቀብኔስ አች ኬሰ ጅራቱ፤","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ሀሞን ገሩ ብየቲ ኬሳ ንበሌፈሙ፤","poem":1},{"text":"ወር ህንአመነምኔስ እሼ ኬሳ ቡቅፈሙ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/