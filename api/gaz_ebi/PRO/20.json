{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"ዳዺን ወይኒ ነመ ቆስቱ፣ዹጋቲን ጭማንሞ ወጩ ነመ ጎዸ፤","poem":1},{"text":"ነምን እሳኒን ፉዸተሙስ ኦጌሰ ምት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ዼከምስ ሞቲ አኩመ ኣዱ ሌንጫት፤","poem":1},{"text":"ነምን እሰ ኣርሱስ ሉቡ ኦፊሳ ዸበ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ሎለራ ፈጋቹን ኡልፍነ፤","poem":1},{"text":"ጎዋን ሁንድ ገሩ ሎለት አሪፈተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ዽባኣን ዬሮዻን ህንቆተቱ፤","poem":1},{"text":"ከናፉ እን ዬሮ ሃማት ንእላለ መሌሆማ ህንአርገቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ያድን ቀልቢ ነማ አኩመ ብሻን ገድ ፈጎት፤","poem":1},{"text":"ሁበታን ነማ ገሩ ንወራበተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ነምን ሄዱን አከ ጃለለ ህንዹምኔ ቀቡ ዱበተ፤","poem":1},{"text":"ነመ አመነማ ገሩ ኤኙቱ አርገቹ ደንደአ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ነምን ቀጄላን አመነሙማዻን ጅራተ፤","poem":1},{"text":"እጆሌንሳ ወር ቦዴ ዸለተንስ ንኤብፈሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ሞቲን ቶኮ ዬሮ ሙርቲ ኬኑፍ ቴሶሳረ ታኡት፣","poem":1},{"text":"ዋን ሀማ ሁንደ እጁመሳቲን ግንግልቼ አዳን ባሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ኤኙቱ፣ “አን ገራኮ ቁልቁሌፈዼረ፤","poem":1},{"text":"አን ቁልቁሉዸ፤ ጩቡስ ህንቀቡ” ጄቹ ደንደአ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"መዳሊ ጀልኣፊ ሰፈርቱ ጀልኣ","poem":1},{"text":"ለማኑ ዋቀዮ ንበልፈ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ሙጫን ጥናንዩ አመልሳ ቁልቁሉፊ","poem":1},{"text":"ቀጄላ ተኡንሳ ሆጂሳቲን ቤከመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ጉረ ዸገኡፊ እጀ አርጉ፣","poem":1},{"text":"ለቸኑ ዋቀዮቱ ኡሜ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"አከ ህንህዮምኔፍ፣ ህርበ ህንጃለትን፤","poem":1},{"text":"ምዻን አከ ቁፍቱፍ፣ ደመቂ ጅራዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ነምን ዋ ብተቱ፣ “ወን ኩን ጋሪ ምት፤ወን ኩን ጋሪ ምት!” ጄዸ፤","poem":1},{"text":"ኤርገሲሞ ዸቄ ዋኤ ዋን ብተቴ ሰና ቦነ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ወርቄን ንጅረ፤ ሉል ዲማንስ ባይእናን ጅረ፤","poem":1},{"text":"አረብን ቤኩምሰ ዱበቱ ገሩ ፋየ ገቲ ጉዳት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ነመ ነመ ኦርማቲፍ ወቢ ተኤራ ኡፈተሳ ፉዸዹ፤","poem":1},{"text":"ዮ እን ዱበርቲ ኦርማቲፍ ወቢ ተኤስ ኡፈተ ሰነ ቀብዲ ቀበዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ኛትን ጎዎምሳዻን አርገሜ ነመት ምኣወ፤","poem":1},{"text":"ዹመረት ገሩ አፋን ነመ ሰና ጭረቸቱ ጉተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ጎርሳን ከሮረ ባፈዹ፤","poem":1},{"text":"ቀጄልፈመ ኦጉማቲን ወራነ በን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ሀመቱን እጪቲ ባፍት፤","poem":1},{"text":"ከናፉ ኦዴስቱ ወጅን ቶኩማ ህንቀባትን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ነምን ቶኮ ዮ አባሳ ዮካን ሃዸሳ አባሬ፣","poem":1},{"text":"እብሳንሳ ዱከነ ሀማ ኬሰት ዻመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ዻል ጀልቀቡመት ደፌ አርገሜ","poem":1},{"text":"ዹምንሳ ኤበ ህንቀባቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"አት፣ “የከ አት ሆጄቴ ከናፍአን ገቲኬ ሲፍን ኬነ!” ህንጄዽን፤","poem":1},{"text":"ዋቀዮን ኤገዹ፤ እን ስ ባሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ዋቀዮ መዳሊ ጀልኣ ንበልፈ፤","poem":1},{"text":"ሰፈርቱ ሶባትስ ህንገመዱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"አዴምስ ነማ ዋቀዮን ቀጄልፈመ።","poem":1},{"text":"ዮስ ነምን ከምዩ አከሚን ከራ ኦፊሳ ሁበቹ ደንደአሬ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ነምን ኡቱ እት ህንያድን፣“ወን ኩን ዋቃፍ ቁልቁሌፈሜረ” ጄዼ","poem":1},{"text":"ኤርገሲሞ ዋን ወሬጌ ሰነ ጋቤ ክዮ እሰት ተአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ሞቲን ኦጌስ ሀሞተ ግንግልቼ አዳን ባሰ፤","poem":1},{"text":"ጌንጎ እቲን ምዻን ዸአንሌ እሳንረ ኦፈ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"እብሳን ዋቀዮ ሀፉረ ነማ ሰከተአ፤","poem":1},{"text":"እን ኬሰ ነማሌ እሱማን ቆረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ጃለሊፊ አመነሙማን ሞቲ ቶኮ ነጋን ጅራችሱ፤","poem":1},{"text":"ቴሶን ሞቱማሳስ ጃለላን ኤገመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"ኡልፍን ደርገጎታ ጀብነሳኒት፤","poem":1},{"text":"አሪን መታ ከበጀ ነመ ኡሙሪን ዼረቴት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"አቦቴን ነመ መዴሱ ሀምነ ነመራ ቁልቁሌሰ፤","poem":1},{"text":"ገረፊንሞ ኬሰ ነማ ጌደረ።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/19.json","previousChapterAudioLinks":{},"numberOfVerses":30}