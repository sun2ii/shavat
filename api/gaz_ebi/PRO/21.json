{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"ያድን ሞቲ አኩመ ያኣ ብሻኒ ሀርከ ዋቀዮ ኬሰ ጅረ፤","poem":1},{"text":"እንስ ገሩመ ፌዼት ቀጄልቸ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ከራን ነማ ሁንድኑ እጀ ኦፊሳ ዱረት ቀጄላ እት ፈካተ፤","poem":1},{"text":"ዋቀዮ ገሩ ያደ ነማ መዳለ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ፉለ ዋቀዮ ዱረት ኣርሳ ጫላ፣","poem":1},{"text":"ዋን ቀጄላፊ ስሪ ተኤ ሆጄቹቱ ፉዸተመ ቀበ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"እጅ ኦፍ ጀጁፊ ገራን ኦፍ ቱሉ ማሲ ሀሞታ","poem":1},{"text":"ከን ህንቆተምኒዸ፤እንስ ጩቡ ዸለ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ከሮር ነመ ተታፈቱ ቡኣ አርገምሲሰ፤","poem":1},{"text":"ነምን አሪፈቱ ገሩ ንህዮመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ቀቤኝ አረበ ሶቡን አርገሙ፣","poem":1},{"text":"ኡሪ ብትናኤ በዱፊ ክዮ ዱኣት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ሰበቢ እሳን ዋን ቀጄላ ሆጄቹ ድደኒፍ፣","poem":1},{"text":"ፍንጭል ሀሞታ እሳኑመ በሌሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ከራን ነመ በሌሳ ቀቡ ጀልኣዸ፤","poem":1},{"text":"አመል ነመ ቁልቁሉ ገሩ ቀጄላዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ኒቲ ኘክፍቱ ወጅን መነ ቶኮ ኬሰ ጅራቹ መና፣","poem":1},{"text":"ጎሌ በንቲ መናረ ጅራቹ ወየ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ነምን ሀማን ጀልእነ ዸረአ፤","poem":1},{"text":"ኦላንሳ ገረ ላፍነ ቶኮዩ እሰራ ህንአርገቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ዬሮ ነምን ቆሱ ቶኮ አደበሙት፣ወላላን ኦጉማ አርገተ፤","poem":1},{"text":"ነምን ኦጌስ ዬሮ ጎርፈሙት ቤኩምሰ አርገተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ነምን ቀጄላን መነ ሀሞታ ቀልቤፈቴ እላለ፤","poem":1},{"text":"ሀሞተስ ንበሌሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ነምን ቶኮ ዮ እየ ህዬሳቲፍ ጉረ ኬኑ ድዴ፣","poem":1},{"text":"እንስ ንእየ፤ ዴቢስ ህንአርገቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ወን ዾክሳዻን ነማፍ ኬነን ኣሪ ቀበኔሰ፤","poem":1},{"text":"መተኣን ሀርከ ቦባ ጀላቲን ኬነንስዼከምሰ ጉዳ ገብ ጎዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ሙርቲ ቀጄላ ኬኑን ቀጄልቶታፍ ገመቹ ኬነ፤","poem":1},{"text":"ሀሞተትሞ ራፈመ ፍደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ነምን ከራ ሁበትናራ በዱ ከምዩ","poem":1},{"text":"ወልዳ ወረ ዱአኒት ደበለመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ነምን ቀነኒ ጃለቱ ንዴገ፤","poem":1},{"text":"ከን ዳዺ ወይኒቲፊ ዘይቲ ጃለቱሞ ህንሶሮሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ነምን ሀማን ነመ ቀጄላዻፍ፣","poem":1},{"text":"ከን ህንአመነምኔሞ ነመ ቶላዻፍ ፉሪ ተአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ኒቲ ኘክፍቱፊ ከን ደፍቴ ኣርቱ ወጅን ጅራቹ መና፣","poem":1},{"text":"ገሞጂ ኬሰ ጅራቹ ወየ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"መነ ነመ ኦጌሳ ኬሰ ቀቤኘ ገቲ ጉዳቲፊ ዘይቲቱ ጅረ፤","poem":1},{"text":"ጎዋን ገሩ ዋን ቀቡ ሁንደ ኛቴ ፍጠ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ነምን ቀጄሉማፊ ጃለለ ዱካ ቡኡ፣","poem":1},{"text":"ጅሬኘ፣ በዻዹማፊ ኡልፍነ አርገተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ነምን ኦጌስ መጋላ ነመ ጀባት በኤ","poem":1},{"text":"ደኦ ጀባ እን አመነቱ ጀላ ዲገ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ነምን አፋንሳቲፊ አረበሳ ኤገቱ፣","poem":1},{"text":"በላራ ኦፍ ኤገ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ነመ ኦፍ ጀጁፊ ኦፍ ቱሉ መቃንሳ፣ “ቆስቱዸ፤”","poem":1},{"text":"እን አከ መሌ ኮረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ሰበቢ ሀርክሳ ሆጂ ሆጄቹ ህንጃለኔፍ፣","poem":1},{"text":"ሀዊን ነመ ዽባኣ ዱአ እሰት ፍደ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"እን ጉያ ጉቱ ከጄለ፤","poem":1},{"text":"ነምን ቀጄላን ገሩ ኡቱ ህንቁሰትን ኬነ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ኣርሳን ነመ ሀማ በልፈማዸ፤","poem":1},{"text":"ዮስ ዮ እን ያደ ሀማዻን ዽኤሴሀመም ሰነ ጫላ ሃበልፈሙ ሬ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ዹገ ባቱን ሶባ ንበደ፤","poem":1},{"text":"ነምን እሰ ዸገኡ ከምዩስ በረ በራን በደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"ነምን ሀማን እጀ ጀባተ፤","poem":1},{"text":"ነምን ቶላን ገሩ ከራሳ ቀጄልፈተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"ኦጉማን፣ ሁበትናኒፊ ከሮር","poem":1},{"text":"ዋቀዮን ሞርሜ ምልካኡ ህንጅሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"ፈርድ ጉያ ወራናቲፍ ቆጴፈመ፤","poem":1},{"text":"ሞእች ገሩ ከን ዋቀዮት።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":31}