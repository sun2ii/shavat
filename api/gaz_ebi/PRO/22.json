{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":[{"text":"መቃን ጋሪን በዻዹማ ጉዳ ጫላ ፍለተማዸ፤","poem":1},{"text":"ከበጀሙንስ ሜቲፊ ወርቄ ጫለ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ወን ሶሬሳፊ ህዬሰ ወል ፈኬሱ ከናዸ፦","poem":1},{"text":"ኡማን ሁንደሳኒ ዋቀዮዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ነምን ሁበታን በላ አርጌ ጀላ ዾከተ፤","poem":1},{"text":"ወላላንሞ እቱመ ዴሜ አደበመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ገድ ኦፍ ቀቢስኒፊ ዋቀዮን ሶዳቹን፣","poem":1},{"text":"ቀቤኘ፣ ኡልፍናፊ ጅሬኘ ነማ ኬኑ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ከራ ሀሞታረ ቆራቲፊ ክዮቱ ጅረ፤","poem":1},{"text":"ነምን ሉቡሳ ኤገቱ ገሩዋን ከነራ ፈጋቴ ጅራተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ዳእመ ቶኮ ከራ እንረ ዴሙ ቀቡ በርሲስ፤","poem":1},{"text":"እን ጋፈ ዱሎሜዩ ከራ ሰነራ ህንጀልአቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ሶሬስ ህዬሰ ቡልቸ፤","poem":1},{"text":"ልቄፈታን ገርብቸ ልቄስቱት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ነምን ሀምነ ፈጫሱ ረክነ ሃመተ፤","poem":1},{"text":"ኡሌን ኣሪሳስ ንሁራኣ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ነምን አርጃን ዋን ኛተሳ ህዬዪፍ ቆዱፍ","poem":1},{"text":"ኦፊሳቲ ንኤብፈመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ቆስቱ ኦፍ ብራ አርእ፤ ሎል ንቀበናኣ፤","poem":1},{"text":"ወል ድዳፊ አረብሶንስ ህንጅራቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ነመ ቁልቁልነ ገራ ጃለቱፊ","poem":1},{"text":"ዱቢንሳ ነመት ቶሉ ሞቲን ምቹ እሳፍ ተአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"እጅ ዋቀዮ ጥዬፈቴ ቤኩምሰ እላለ፤","poem":1},{"text":"እን ገሩ ዱቢ ነመ ህንአመነምኔ ንቡሼሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ዽባኣን፣ “ሌንጭ አለ ጅረ!","poem":1},{"text":"አን ከራ ጉባት ነንአጄፈመ!” ጄዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"አፋን ኤጅቱ ቦለ ገድ ፈጎዸ፤","poem":1},{"text":"ነምን ዼከምሰ ዋቀዮ ጀለ ጅሩ አች ኬሰ ቡአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ጎዉማን ያደ ዳእማ ኬሰት ህዸሜረ፤","poem":1},{"text":"ኡሌን እቲን አደበን ገሩ እራ ፈጌሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ነምን ቀቤኘሳ ጉድፈቹፍ ጄዼ","poem":1},{"text":"ህዬሰ ሀጩጩፊ ከን ሶሬሳፍ ኬና ኬኑ ንዴገ።","poem":2}]},{"type":"heading","content":["ጄቸ ቶኮፋ"]},{"type":"verse","number":17,"content":[{"text":"ቀልቤፈዹቲ ዋን ነምን ኦጌስ ጄዹ ዸጌፈዹ፤","poem":1},{"text":"ያደኬስ ገረ ዋን አን በርሲሱት ዴብፈዹ፤","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዮ አት ቀልቢት ቀበቴሁንዱመሳ ህዺኬረት ቆጴፈቴ","poem":1},{"text":"ወን ኩን ነመ ገመቺሳቲ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አከ አብዲንኬ ዋቀዮ ተኡፍ","poem":1},{"text":"አን ሀርአ ሱመ መታ ኬዩ ነንበርሲሰ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አን ጄቸ ሶዶመ፣ ጄቸ ጎርሳቲፊ","poem":1},{"text":"ቤኩምሳ ሲፍ ህንበሬስኔ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ከነስ አን አከ አት ወረ ስ ኤርገኒፍ","poem":1},{"text":"ዴቢ ዹጋ ኬንቱፍ ዋን ቀጄላፊ","poem":2},{"lineBreak":true},{"text":"ዹጋ ስ አርግሲሱፍን በሬሴ ምቲ?","poem":2}]},{"type":"heading","content":["ጄቸ ለመፋ"]},{"type":"verse","number":22,"content":[{"text":"አት ሰበቢ እን ህዬሰ ተኤፍ ጄቴ ህዬሰ ህንሳምን፤","poem":1},{"text":"ረከታስ መነ ሙርቲት ህንጩንቁርስን፤","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዋቀዮ ዱቢሳኒ ንእላላፍ፤","poem":1},{"text":"ጅሬኘ ወረ እሳን ሳመኒስ ንሳማቲ።","poem":2}]},{"type":"heading","content":["ጄቸ ሰደፋ"]},{"type":"verse","number":24,"content":[{"text":"ነመ ደፌ ኣሩ ምቹ ህንጎዸትን፤","poem":1},{"text":"ነመ አከ ሰልጳት ዼከሙ ወጅንስቶኩማ ህንቀባትን፤","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዮ ከነ ጎቴ ከራሳ በረተ፤","poem":1},{"text":"ኦፊኬስ ክዮት ገልችተ።","poem":2}]},{"type":"heading","content":["ጄቸ አፍረፋ"]},{"type":"verse","number":26,"content":[{"text":"ነመ ሀርከ ዸኤ ዋዳ ገሉ","poem":1},{"text":"ዮካን ነመ ልቂ ነማቲፍ ወቢ ተኡ ህንተእን፤","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ዮ አት ዋን ባፍቱ ዸብዴ፣","poem":1},{"text":"ስሬን ኬዩ ስ ጀላ ፉዸተመ።","poem":2}]},{"type":"heading","content":["ጄቸ ሸነፋ"]},{"type":"verse","number":28,"content":[{"text":"ዸጋ ዳሪ ዱሪ፣","poem":1},{"text":"ከን አቦቲንኬ ዻበን ህንዺብን።","poem":2}]},{"type":"heading","content":["ጄቸ ጀአፋ"]},{"type":"verse","number":29,"content":[{"text":"ነመ ሆጂሳ ኬሰት ኦጉማ ቀቡ አርግቴ?","poem":1},{"text":"እን ፉለ ሞቶታ ዱረ ዻበተ፤","poem":2},{"lineBreak":true},{"text":"ፉለ ነሞተ ካኒ ዱረ ገሩ ህንዻበቱ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/21.json","previousChapterAudioLinks":{},"numberOfVerses":29}