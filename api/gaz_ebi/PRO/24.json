":1},{"text":"እብሳን ሀሞታስ ንዻመ።","poem":2}]},{"type":"heading","content":["ጄቸ ሶዶመፋ"]},{"type":"verse","number":21,"content":[{"text":"ያ እልመኮ፣ ዋቀዮፊ ሞቲ ሶዳዹ፤","poem":1},{"text":"ፍንጭልቶተትስ ህንመከምን፤","poem":2}]},{"type":"verse","number":22,"content":[{"text":"በዲስን አኩመ ተሳ እሳንት ዹፋቲ፤","poem":1},{"text":"በላ እሳን ለቹ ፍደን ኤኙቱ ቤከ?","poem":2}]},{"type":"verse","number":23,"content":["ኩኔንስ ጄቾተ ኦጌሳት፦",{"text":"ሙርቲ ኬኑረት ነመ ወል ጫልችሱን ጋሪ ምት፦","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ከን ነመ የከ ቀቡን፣ “አት በሌሳ ህንቀብዱ”","poem":1},{"text":"ጄዹ ከምዩ ነምን እሰ አባረ፤ ሰብንስ እሰ በላሌፈተ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ወር ነመ የከ ሆጄቱ እፈተን ገሩ ንገመዱ፤","poem":1},{"text":"ኤብ ጉዳንስ ንዹፋፍ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ዴቢን ቀጄላን፣","poem":1},{"text":"አኩመ ህዺ ዹንገቹት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ሆጂኬ ከን ዲዳ ራወዹቲ","poem":1},{"text":"ለፈ ቆቲሳኬስ ቆጴፈዹ፤","poem":2},{"lineBreak":true},{"text":"ኤርገሲ መነኬ እጃረዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ሰበቢ ቶኮ መሌ ኦላኬት ዹጋ ህንበእን","poem":1},{"text":"ዮካን ህዺኬቲን ህንጎዎምስን።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"አት፣ “ዋኑመ እን ነ ጎዼ አንስ እሰ ነንጎዸ፤","poem":1},{"text":"ዋን እን ሆጄቴፍስ ገቲሳ ነንዴብሰ” ህንጄዽን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"አን ለፈ ቆቲሳ ነመ ዽባኣ ኬሰ በኤ፣","poem":1},{"text":"እዶ ዻባ ወይኒ ነመ ቀልቢ ህንቀብኔ ኬሰስ ደርቤ፤","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ቆራቲን ለፈ ሁንደ ጉቴረ፤","poem":1},{"text":"ለፍትስ አረማዻን ፉዸተሜረ፤","poem":2},{"lineBreak":true},{"text":"ደላን ዸጋስ ዲገሜረ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"አን አርጌን ዋን ሰነ ቀልቤፈዼ፤","poem":1},{"text":"ዋነን አርጌ ሰነራስ በሩምሰ ነንአርገዼ፦","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ህርበ ጥና፤ ሙጋቲ ጥና፤","poem":1},{"text":"ጥኖ ሀርከ ወልት መረቹ፤","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ህዩማንስ አኩመ ሀቱት፣","poem":1},{"text":"ዴጉማንስ አኩመ ሎልቱ ህዸቴት ስት ዹፈ።","p