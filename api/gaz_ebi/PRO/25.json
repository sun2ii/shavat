{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":["ፈኬኘወን ኩኔን ፈኬኘወን ሶሎሞን ከኔን ነሞትን ህስቅያስ፣ ሞትቸ ይሁዳ ገረገልቸኒዸ፦"]},{"type":"verse","number":2,"content":[{"text":"ዋ ዾክሱን ዋቃፍ ኡልፍነሳት፤","poem":1},{"text":"ዋ ሰከተአኒ ብረ ገኡንሞ ኡልፍነ ሞቶታት።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አኩመ ሰሚወን ኦል ዼረተኒ","poem":1},{"text":"ለፍትስ ገድ ፈጋቱ ሰነ፣ ያድን ሞቶታ ቆረተሜ ብረ ህንገአሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ሜቲራ ጡሪ ባስ፤","poem":1},{"text":"ኤርገሲ ቱምቱን ቆዳ ቶልቹ ደንደአ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ነመ ሀማ ፉለ ሞቲ ዱራ በሌስ፤","poem":1},{"text":"ኤርገሲ ቴሶንሳ ቀጄሉማዻን ንጀባተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ፉለ ሞቲ ዱረት ኦል ኦፍ ህንቀብን፤","poem":1},{"text":"እዶ ነሞተ ጉርጉዳስ ህንዻበትን፤","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እን ፉለ ነሞተ ቤቤከሞ ዱረት ስ ሰልጵሱረ፣","poem":1},{"text":"ዮ እን፣ “አስ ኦል ኮቱ” ሲን ጄዼ ወያ።","poem":2},{"lineBreak":true},{"text":"አት ዋን እጀኬቲን አርግቴ፣","poem":1}]},{"type":"verse","number":8,"content":[{"text":"ደፍቴ መነ ሙርቲት ህንፍድን፤","poem":2},{"text":"ዮ ኦላንኬ ስ ቃኔሴ፣","poem":1},{"text":"ዹመረት አት ማል ጎቹ ደንዴሰ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ዽመኬ ኦላኬ ወጅን ፈልመዹ፤","poem":1},{"text":"እጭቲ ነመ ካኒሞ ህንባስን፤","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዮ ከና አቺ ነምን ዋን ሰነ ዸገኤ ስ ቃኔሰ፤","poem":1},{"text":"መቃን ሀማን ሲፍ ኬነሜ ሱንስ ስራ ህንበኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ዱቢን ዬሮሳት ዱበተሜ፣","poem":1},{"text":"አኩመ ሁዻ ወርቄ ከን ሜቲረት ሆጄተሜት።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እፈትን ነመ ኦጌሳ ጉረ ዸጌፈቱፍ፣","poem":1},{"text":"ሎቲ ወርቄ ዮካን ፋየ ወርቄ ቁልቁሉት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ኤርገማን አመነማን ቶኮ ወረ እሰ ኤርገተኒፍ","poem":1},{"text":"አኩመ ቀበነ ጨቢ ከን ዬሮ ምዻን ሃመኒት፤","poem":2},{"lineBreak":true},{"text":"እን ሀፉረ ጎፍቶተሳ ሃሮምሳቲ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ነምን ኬና ነማፍ ህንኬንኔን ቦኑ ቶኮ","poem":1},{"text":"አኩመ ዱሜሳፊ ቡቤ ቦካ ህንቀብኔት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ኦብሳን ቡልቻ ቶኮ ገራ ላፍፈቹን ንደንደአመ፤","poem":1},{"text":"ዱቢን መላን ዱበተሜ ለፌ ንጨብሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ደመ ዮ አርገቴ ሀመ ስ ገኡ ኛዹ፤","poem":1},{"text":"ዮ ባይእፍቴ ኛቴ ንድድግደ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"መነ ኦላኬቲ ዸቁ ህንባይእስን፤","poem":1},{"text":"ዮ አት ሚለ እት ባይእፍቴ እን ስ ጅበ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ነምን ሶባን ኦላሳት ዹጋ በኡ፣ አኩመ ቦኩ ዮካን","poem":1},{"text":"ጎራዴ ዮካን ጥየ ቀረ ቀቡት።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ነመ ህንአመነምኔ ቶኮ ዬሮ ረኮት አብደቹን","poem":1},{"text":"አኩመ እልካን ጨቤ ዮካን ሚለ ኦኮሉት።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ነመ ገራንሳ ገዴፍ ስርበ ስርቡን","poem":1},{"text":"አኩመ ነመ ጉያ ዻሞቻ ወያ ኦፍራ ባሱ፣","poem":2},{"lineBreak":true},{"text":"ዮካን መዳረት ዸንገጋኣ ዸንገላሱት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ዮ ዲንኬ ቤለኤ ዋን እን ኛቱ ኬኒፍ፤","poem":1},{"text":"ዮ እን ዼቦቴስ ብሻን እን ዹጉ ኬኒፍ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ከነ ጎቹኬቲን በርበዳ እብዳ መታሳረ ቱልተ፤","poem":1},{"text":"ዋቀዮስ ስበዻሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"አኩመ ቡቤን ካባ ቦካ ፍዱ፣","poem":1},{"text":"አረብን ሀመቱስ ፉለ ዼከሙ ፍደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ኒቲ ኘክፍቱ ወጅን መነ ቶኮ ኬሰ ጅራቹ መና፣","poem":1},{"text":"ጎሌ በንቲ መናረ ጅራቹ ወየ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ኦዱን ጋሪን ብየ ፈጎቲ ዹፉ፣","poem":1},{"text":"አኩመ ብሻን ቀበናኣ ሉቡ ዼቦቴፍ ተኡት።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ነምን ቀጄላን ፉለ ሀሞታ ዱረት ኩፉ፣","poem":1},{"text":"አኩመ ቡርቃ ዾቃኤ ዮካን ቦለ ብሻኒ ፋለሜ ቶኮት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ደመ ባይኤ ኛቹን ጋሪ ምት፤","poem":1},{"text":"ኡልፍነ መታ ኦፊ በርባዱንስ ኡልፍነ ምት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ነምን ኦፍ ህንቀብኔ፣","poem":1},{"text":"አኩመ መጋላ ደላንሳ ዲገሜት።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/24.json","previousChapterAudioLinks":{},"numberOfVerses":28}