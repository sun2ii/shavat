{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"አኩመ ጨቢ ዬሮ ቦና ዮካን ቦካ ዬሮ ሃማ፣","poem":1},{"text":"ነመ ጎዋፍ ኡልፍን ህንመሉ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አኩመ ስምብር በርፍቱ ዮካን ዳሎቴን በርፍቱ","poem":1},{"text":"አባርስ ሰበቢ መሌ ዹፉ ነመረ ህንቡኡ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አለንጋን ፈርዳፍ፣ ሉገምን ሀሬፍ፣","poem":1},{"text":"ኡሌንሞ ዱግደ ጎዋቲፍ መለ!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጎዋዻፍ አከ ጎዉማሳት ህንዴብስን፤","poem":1},{"text":"ዮ አከስ ጎቴ አት መታንኬዩ አኩመሳ ታተ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ጎዋዻፍ ዴቢ ጎዉማሳቲፍ መሉ ኬን፤","poem":1},{"text":"ዮ ከና አቺ እን ኦጌሰ ኦፍ ሴኣ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሀርከ ነመ ጎዋት ኤርጋ ኤርገቹን፣","poem":1},{"text":"አኩመ ሚለ ኦፊራ ሙሩ ዮካን ሱሚ ዹጉት።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አፋን ነመ ጎዋ ኬሰት፣","poem":1},{"text":"ፈኬኝ አኩመ ሚለ ናፋት።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ነምን ጎዋዻፍ ኡልፍነ ኬኑ፣","poem":1},{"text":"አኩመ ነመ ፉርሳት ዸጋ ጉዱንፉት።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ፈኬኝ አፋን ጎዋ ኬሰት","poem":1},{"text":"አኩመ ቆራቲ ሀርከ ነመ መቻኤ ኬሳት።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ነምን ጎዋ ዮካን ከረ ዴማ ቀጠረቱ","poem":1},{"text":"አኩመ አደምሳ ነመ ሁንደ ጥያን መዴሱት።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አኩመ ሰሬን ድድገሼት ዴብቱ ሰነ፣","poem":1},{"text":"ጎዋን ጎዉማሳረ ዴዴብአ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አት ነመ አከ እላልቸ ኦፊሳት ኦጌሰ ተኤ አርግታ?","poem":1},{"text":"እሳረ ጎዋቱ አብዲ ጫሉ ቀበ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ዽባኣን፣ “ሌንጭ ከራረ ጅረ፤","poem":1},{"text":"ሌንጭ ሶዳችሳን ዳንዲረ ጅረ!” ጄዸ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አኩመ ሳንቃን ሙቾሳረ ናነኡ፣","poem":1},{"text":"ዽባኣን ስሬ ኦፊረ ገገረገለ","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዽባኣን ሀርከሳ ወጪቲ ኬሰ ካአ፤","poem":1},{"text":"ገረ አፋንሳት ዴብፈቹፍ ንዽባአ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዽባኣን ነሞተ ሁበትናዻን","poem":1},{"text":"ዴቢ ኬነን ቶርበ ጫላ ኦጌሰ ኦፍ ሴአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ነምን ሎለ ነመ ብራ ኬሰ ሴኑ፣","poem":1},{"text":"አኩመ ነመ ሀርካን ጉረ ሰሬ ቀቡት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"አኩመ መራቱ እብደ ዮካን ጥየ","poem":1},{"text":"ነመት ገድ ዺሱ ቶኮ","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ነምን፣ “አን ነንቆሴ!” ጄዼ","poem":1},{"text":"ኦላሳ ጎዎምሱስ አከሱመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"እብድ ዮ ቆራን ዸቤ ንዻመ፤","poem":1},{"text":"ሀሚን ዮ ህንጅራትኔ፣ ሎል ንቀበናአ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አኩመ ጭሌን በርበዳ እብዳ ቦቤሴቆራን እብደ ቀብሲሱ ሰነ","poem":1},{"text":"ነምን ሎለ ጃለቱ ሎለ ከካሰ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዱቢን ሀመቱ አኩመ ጉርሻ ምኣዉት፤","poem":1},{"text":"ገረ ኩታ ገራትስ ገድ ቡአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ዱቢን ጋሪን ገራ ሀማ ኬሳ በኡ","poem":1},{"text":"አኩመ ኦኮቴ ሜቲንረ ድበሜት።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ነምን መቃ ነማ በሌሱ ቶኮአረቡመ ኦፊቲን ነመ ቶላ ኦፍ ፈኬሰ፤","poem":1},{"text":"ገራሳ ኬሰትሞ ጎዎምሳ ጉዱንፈተ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዮ ዱቢንሳ ስት ምኣዌዩ እሰ ህንአመንን፤","poem":1},{"text":"ወን ጅብሲሳን ቶርበ ገራሳ ጉቴራቲ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ጀልእንሳ ሶባን ሀጉገሜ ዾክፈሙ ደንደአ፤","poem":1},{"text":"ሀምንሳ ገሩ ፉለ ወልዳ ዱረት እፈት በአ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ነምን ቦለ ቆቱ ቦለ ኬሰ ቡአ፤","poem":1},{"text":"ነመ ዸጋ ገንገልቹስ፣ዸጋን ሱን እሱመት ዴብአ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"አረብን ሶቡ ቶኮ ወሩመ ሚዹ ሰነ ጅበ፤","poem":1},{"text":"አፋን ሳዱ ቶኮስ በዲሰ ፍደ።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/25.json","previousChapterAudioLinks":{},"numberOfVerses":28}