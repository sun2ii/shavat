{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"አት ዋኤ ቦሪቲን ህንቦንን፤","poem":1},{"text":"ዋን ጉያን ፍዱ ህንቤክቱቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ነምን ብራ ስ ሃጀጁ መሌ አት አፋንኬቲን ኦፍ ህንጀጅን፤","poem":1},{"text":"ነምን ካን ስ ሃጀጁ መሌ ህዺንኬ ስ ህንጀጅን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ዸጋን ንኡልፋተ፤ ጭረችስ በኣዸ፤","poem":1},{"text":"ቱቱቃን ጎዋ ገሩ ለቹ ጫላ ኡልፋተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ዼከምስ ገረ ጀቤሰ፤ ኣሪንስ ጉቴ ዸንገለአ፤","poem":1},{"text":"ህናፋ ዱረ ገሩ ኤኙቱ ዻበቹ ደንደአ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ጃለለ ዾክፈሜ መና","poem":1},{"text":"እፈትና እፈት በኤ ወየ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"መዳን ምቹን ነመ መዴሱ አመነማዸ፤","poem":1},{"text":"ዹንገቹን ዲና ገሩ ጎዎምሳዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ነምን ቁፌ ደመሌ ንበልፈ፤","poem":1},{"text":"ከን ቤለኤ ገሩ ወን ሀዻኡዩ እት ምኣወ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ነምን መነሳቲ በዱ ቶኮ፣","poem":1},{"text":"አኩመ ስምብሮ መንኤሼቲ በዱት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ሽቶፊ እጣን ገራ ነመ ገመቺሱ፤","poem":1},{"text":"ጎርስ ምቹስ ገራ ነመ ጪብሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ምቾተኬቲፊ ምቾተ አባኬቲ ህንገትን፤","poem":1},{"text":"ዮ በላን ስት ዹፌ መነ ኦቦሌሰኬቲ ህንዸቅን፤","poem":2},{"lineBreak":true},{"text":"ኦቦሌሰ ፈጎ ጅሩረ ኦላ ዽኦ ጅሩ ወየ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ያ እልመኮ፣ ኦጌሰ ተኢቲ ገራኮ ገመቺስ፤","poem":1},{"text":"ኤርገሲ አን ነመ ነ ቱፈቱ ሁንዳፍዴቢ ኬኑ ነንደንደአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ነምን ሁበታን በላ አርጌ ጀላ ዾከተ፤","poem":1},{"text":"ወላላንሞ እቱመ ዴሜ አደበመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ነመ ነመ ኦርማቲፍ ወቢ ተኤራ ኡፈተሳ ፉዸዹ፤","poem":1},{"text":"ዮ እን ዱበርቲ ኦርማቲፍ ወቢ ተኤስ ኡፈተ ሰነ ቀብዲ ቀበዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ነምን ቶኮ ገነማን ሰገሌ ኦል ፉዸቴኦላሳ ዮ ኤብሴ","poem":1},{"text":"ወን ሱን አከ አባርሳት ፉዸተመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ኒቲን ኘክፍቱን፣ አኩመ ቦካ ጉያ ሮባ","poem":1},{"text":"ዽምሳ ኦሉት፤","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እሼ እትሱን አኩመ ቡቤ እትሱት","poem":1},{"text":"ዮካን አኩመ ዘይቲ ሀርካን ቀቡት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"አኩመ ስቢል ስቢለ ቀሩ፣","poem":1},{"text":"ነምን ቶኮ ነመ ካን ቀረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ነምን ሙከ ሀርቡ ኤገቱ ቶኮ እጀሳ ኛተ፤","poem":1},{"text":"ነምን ጎፍታሳ ኤገቱስ ኡልፍነ አርገተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"አኩመ ብሻን ፉለ ነማ አርግሲሱ ሰነ","poem":1},{"text":"ገራን ነመ ቶኮ ኤኙማ ነምቻ አርግሲሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ዱኣፊ በዲስን ጎንኩማ ህንቁፈን፤","poem":1},{"text":"እጅ ነማስ አከሱመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ኦኮቴን ዋ እት በቅሰን ሜቲፍ፤","poem":1},{"text":"ቦል እብዳሞ ወርቄፍ፤","poem":2},{"lineBreak":true},{"text":"ነምንሞ ኡልፍነ አርገቱን ቆረመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ጎዋ ሞዬ ኬሰት ዮ ቱምቴዩ፣","poem":1},{"text":"አኩመ ምዻኒት ሙከ ሞዬቲን እሰ ቡሌስቴዩ፣","poem":2},{"lineBreak":true},{"text":"አት ጎዉማ እሰራ ህንበሌስቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ሃለ ቡሻዬንኬ ኬሰ ጅረን ስሪት ቤክ፤","poem":1},{"text":"ሎንኬቲፍስ ጥዬፈትና ኬን፤","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ሶሩምን በረ በራን እት ህንፉፉቲ፤","poem":1},{"text":"ጎንፎንስ ዸሎተራ ዸሎተት ህንደርቡ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዬሮ ኦካን ሃመሜ ብቅላ ሃራን ጀላን ብቅሌ","poem":1},{"text":"መርግ ቱሉራ ወልት ቀበሙት፣","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ጦባላወኒን ዳረ ባተ፤","poem":1},{"text":"ሬኦትንሞ ገቲ ለፈ ቆቲሳ ሲፍ ተኡ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"አት ኦፊኬቲፊ ማቲኬ፣ጦምቦሬወንኬስ እቲን ጅራችሱፍ","poem":1},{"text":"ኣነን ሬኦታ ባይኤ ንቀባተ።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":27}