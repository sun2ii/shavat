{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"ነምን ሀማን ኡቱ ነምን ቶኮዩ እሰ ህንአርእን በቀተ፤","poem":1},{"text":"ቀጄልቶትን ገሩ አኩመ ሌንጫ እጀ ጀባቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ብየ ፍንጭሉ ኬሰ ቡልችቶተ ሄዱቱ ጅረ፤","poem":1},{"text":"ቡልቻን ሁበታኒፊ ቤካን ገሩ ሴረ ኤግስሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ቡልቻን ህዬሰ ሀጩጩ ቶኮ","poem":1},{"text":"አኩመ ቦካ ጀባ ምዻን ለፈራ በሌሱት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ወር ሴረ ድደን ሀሞተ ጀጁ፤","poem":1},{"text":"ወር ሴረ ኤገን ገሩ እሳኒን ሞርሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ጀልኦትን ሙርቲ ቀጄላ ህንሁበተን፤","poem":1},{"text":"ወር ዋቀዮን በርባደንሞጉቱማን ጉቱት ሁበቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ሶሬሰ ከራንሳ ጀልኣ ተኤ መና","poem":1},{"text":"ህዬሰ አዴምስሳ ሙዳ ህንቀብኔ ወየ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ነምን ሴረ ኤጉ እልመ ኦጌሰ፤","poem":1},{"text":"ምቹን አልባዼሳሞ አባሳ ቃኔሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ነምን ዸላፊ ሂቂዻን ቀቤኘሳ ጉድፈቱ ከምዩ፣","poem":1},{"text":"ነመ ህዬሳፍ ገራ ላፉፍ ወልት ቀበ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ነመ ሴራፍ ጉረ ኬኑ ድዱ ከምዩ፣","poem":1},{"text":"ከዸናንሳ በልፈማዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ነምን ነመ ቶላ ከራ ጀልኣረ አዴምስሱ ከምዩ","poem":1},{"text":"ክዮ ኦፊሳ ኬሰ ሴነ፤","poem":2},{"lineBreak":true},{"text":"ነምን በሌሳ ህንቀብኔ ገሩ ዻለ ጋሪ አርገተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ነምን ሶሬስ ኦጌሰ ኦፍ ሴአ፤","poem":1},{"text":"ህዬስ ሁበትና ቀቡ ገሩ እሰ ቆሬ ብረ ገአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ዬሮ ነምን ቀጄላን ሞአቱት ገመቹ ጉዳቱ ተአ፤","poem":1},{"text":"ዬሮ ነምን ሀማን ኣንጎ ቀበቱት ገሩነሞትን ንዾከቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ነምን ጩቡ ኦፊ ዾክፈቱ ህንምልካኡ፤","poem":1},{"text":"ከን ጩቡሳ ህመቴራ ዴብኡ ገሩ አራረ አርገተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ነምን ዬሮ ሁንደ ዋቀዮን ሶዳቱ ኤብፈማዸ፤","poem":1},{"text":"ከን መታ ጀባቱ ገሩ ረኮ ኬሰት ኩፈ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ነምን ሀማን ህዬዪ ቡልቹ፣","poem":1},{"text":"አኩመ ሌንጨ ኣዱ ዮካን አማኬተ ወይት አሪፈቱት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ቡልቻን አከ መሌ ነመ ጩንቁርሱ ሁበትና ህንቀቡ፤","poem":1},{"text":"ከን ቡኣ ከራ ህንመሌን አርገሙ ጅቡ ገሩ በረ ዼራ ጅራተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ነምን የክ ዺገ ነማ ዸንገላሱ እሰረ ጅሩ፣","poem":1},{"text":"ቦለት በቀተ፤","poem":2},{"lineBreak":true},{"text":"ነምን ቶኮዩ እሰ ህንገርጋርን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ነምን አዴምስሳ ሙዳ ህንቀብኔ ነጉማን ጅራተ፤","poem":1},{"text":"ከን ከራንሳ ጀልኣ ተኤ ገሩ ቦለት ኩፈ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ነምን ለፈሳ ቆተቱ ኛተ ጉዳ አርገተ፤","poem":1},{"text":"ከን ያደ ፋይዳ ህንቀብኔ ዱካ ቡኡ ገሩህዩማን ጉተመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ነምን አመነማን ኤበ ቁፈ፤","poem":1},{"text":"ከን ሶሮሙት ገገቡ ገሩ አደቢ ጀላ ህንበኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ነመ ወል ጫልችሱን ጋሪ ምት፤","poem":1},{"text":"ነምን ገሩ ሙራ ቡዴና አርገቹፍ ጄዼ የከ ሆጄተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ነምን ዋ ከጄሉ ሶሮሙፍ ጀርጀረ፤","poem":1},{"text":"እን አከ ህዩማን እሰ ኤገቱ ህንቤኩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ነምን ነመ እፈቱ ዹመረት","poem":1},{"text":"ነመ አረባን ነመ ሳዱ ጫላ ሱራ አርገተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ነምን አባ ዮካን ሃዸሳ ሳሜ፣","poem":1},{"text":"“ኩን በሌሳ ምት” ጄዹ","poem":2},{"lineBreak":true},{"text":"ገሬ ነመ ዋ በሌሱት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ነምን ወይት ገገቡ ሎለ ከካሰ፤","poem":1},{"text":"ከን ዋቀዮን አመነቱ ገሩ ንበዻዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ነምን ኦፍ አመነቱ ጎዋዸ፤","poem":1},{"text":"ከን ኦጉማዻን ዴሙሞ ነጋዻን ጅራተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ነምን ህዬሳፍ ኬኑ ዋን ቶኮሌ ህንዸቡ፤","poem":1},{"text":"ከን እጀ ዱኑንፈቱ ገሩ አባርሰ ባይኤ አርገተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ዬሮ ነምን ሀማን ኣንጎ ቀበቱትነሞትን ንዾከቱ፤","poem":1},{"text":"ዬሮ ነምን ሀማን በዱት ገሩ ቀጄልቶትን ንባይአቱ።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}