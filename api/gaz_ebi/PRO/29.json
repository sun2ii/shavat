{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"text":"ነምን እፈትና ባይኤ ቦዴ","poem":1},{"text":"መታ ጀባቱ ከምዩ አኩመ ተሳ ጨበ፤ ህንፈዩስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ዮሙ ነምን ቀጄላን ኣንጎ ቀበቱት፣ ሰብን ንእልልቸ፤","poem":1},{"text":"ዮሙ ነምን ሀማን ቡልቹ ገሩ ሰብን ንጉንጉመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ነምን ኦጉማ ጃለቱ አባሳ ገመቺሰ፤","poem":1},{"text":"ሚልቶትን ሰጋገልቱ ገሩ ቀቤኘሳ በርበዴሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ሞቲን ሙርቲ ቀጄላዻን ብያፍ ነጋ ቡሰ፤","poem":1},{"text":"ከን መተኣፍ ገገቡሞ ብየ ገርገር ቆቆደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ነምን ኦላሳ ጀጁ፣","poem":1},{"text":"ሚሉመሳቲፍ ክዮ ካአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ነምን ሀማን ጩቡ ኦፊሳቲን ቀበመ፤","poem":1},{"text":"ቀጄላን ገሩ ንፋርፈተ፤ ንእልልቸስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ነምን ቀጄላን ምርገ ህዬሳቲፍ ዻበተ፤","poem":1},{"text":"ነምን ሀማን ገሩ ዽመ አከና ህንቀቡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ቆስቶትን መጋላ ጄቁ፤","poem":1},{"text":"ኦጌዪን ገሩ ኣሪ ቀበኔሱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ዮ ኦጌስ ጎዋ ወጅን መነ ሙርቲ ዸቄ፣","poem":1},{"text":"ጎዋን ሱን ንኣረ ዮካን ንኮልፈ፤ ነጋንስ ህንጅራቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ነሞትን ዺገ ዼቦተን፣ ነመ አመነማ ጅቡ፤","poem":1},{"text":"ነመ ቶላስ አጄሱ በርባዱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ጎዋን ጉቱማን ጉቱት ኣሪት ኦፍ ኬነ፤","poem":1},{"text":"ኦጌስ ገሩ ኦፍ ቀበ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ዮ ቡልቻን ቶኮ ሶበ ዸጌፈቴ፣","poem":1},{"text":"ቆንዳልቶትንሳ ሁንድ ንሀማቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ህዬሳፊ ነምን ነመ ጩንቁርሱ ዋን ከናን ወል ፈካቱ፦","poem":1},{"text":"ዋቀዮ እጀ ለቸን እሳኒቲፉ አገርቱ ኬነ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ዮ ሞቲን ቶኮ ወል ቅጡማዻንህዬዪፍ ሙርቲ ኬኔ፣","poem":1},{"text":"ቴሶንሳ በረ በራን ጀባቴ ዻበተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ኡሌፊ እፈትናን ኦጉማ ኬኑ፤ ዳእምን አከሱመት","poem":1},{"text":"ገድ ዺፈሜ ገሩ ሃዸሳ ሰልጵሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ዮሙ ሀሞን ኣንጎ ቀበተን፣ ጩቡቱ ባይአተ፤","poem":1},{"text":"ቀጄልቶትን ገሩ ኩፋቲ ጀራ አርጉ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"እልመኬ አደበዹ፣ እን ነጋ ሲፍ ኬነ፤","poem":1},{"text":"ሉቡኬስ ንገመቺሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"እዶ ሙልአትን ህንጅሬት ሰብን ገድ ዺሲ ተአ፤","poem":1},{"text":"ነምን ሴረ ኤጉ ገሩ ኤብፈማዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ገርብች ዱቢ አፋኒ ቆፋን ህንስሬፈሙ፤","poem":1},{"text":"እን ዮ ሁበቴሌ ዴቢ ህንኬኑቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"አት ነመ ጀርጀርሱን ዱበቱ አርግቴ?","poem":1},{"text":"እሳረ ጎዋቱ አብዲ ጫሉ ቀበ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ነመ ገርብቸ ኦፊሳእጆሉማሳቲ ጀልቀቤ ቀነንሲሱ፣","poem":1},{"text":"ገልገልሳ ረክነ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ነምን ኣሩ ሎለ ከካሰ፤","poem":1},{"text":"ከን ደፌ ኣሩስ ጩቡ ሄዱ ሆጄተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ኦፍ ቱሉማን ነማ እሱመ ገድ ዴብሰ፤","poem":1},{"text":"ነምን ሀፉራን ገድ ኦፍ ቀቡ ገሩ ኡልፍነ አርገተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ነምን ሀቱ ወጅን ቆደቱ ሉቡ ኦፊሳ ጅበ፤","poem":1},{"text":"እን ንከከተ፤ ገሩ ዋን ቶኮሌ ህንህሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ነመ ሶዳቹን ክዮ ነመት ተአ፤","poem":1},{"text":"ከን ዋቀዮን አመነቱ ገሩ ነጋዻን ጅራተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ነምን ሄዱን ቡልቻ ብረት ሱራ አርገቹ በርባደ፤","poem":1},{"text":"ሙርቲን ቀጄላን ገሩ ዋቀዮ ብራ ዹፈ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ቀጄላን ሶብዱ ጥሬፈተ፤","poem":1},{"text":"ሀማንሞ ነመ ቶላ ጅበ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/28.json","previousChapterAudioLinks":{},"numberOfVerses":27}