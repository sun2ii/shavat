{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":3,"content":[{"type":"heading","content":["ኤበ ኦጉማ"]},{"type":"verse","number":1,"content":[{"text":"ያ እልመኮ፣ በሩምሰ አን ሲፍ ኬኑ ህንደገትን፤","poem":1},{"text":"አጀጀኮስ ገራት ቀበዹ፤","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እሳን በረ ባይኤፊ ኡሙሪ ዼራ፣","poem":1},{"text":"ነጋፊ በዻዹማ ሲፍ ደበሉቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ጃለሊፊ አመነሙማን ዮምዩ ስራ ህንፈጋትን፤","poem":1},{"text":"ሞርመኬት ህዸዹ፤","poem":2},{"lineBreak":true},{"text":"ገበቴ ገራኬረትስ በሬፈዹ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አት ከራ ከናን ፉለ ዋቃቲፊ","poem":1},{"text":"ፉለ ነማ ዱረት ሱራፊ መቃ ጋሪ ንአርገተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ገራኬ ጉቱን ዋቀዮን አመነዹ፤","poem":1},{"text":"ሁበትናኬስ ህንአብደትን፤","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ከራኬ ሁንደ ኬሰት እሰ ዱርስ፤","poem":1},{"text":"እንስ ዳንዲኬ ሲፍ ቀጄልቸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"አን ኦጌሰ ኦፊን ህንጄዽን፤","poem":1},{"text":"ዋቀዮን ሶዳዹ፤ ዋን ሀማራስ ፈጋዹ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ወን ኩን ዸግነኬቲፍ ፈያ ኬነ፤","poem":1},{"text":"ለፌኬሌ ንሃሮምሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ቀቤኘኬቲን፣","poem":1},{"text":"መታ ምዻንኬቲ ሁንዳንስ ዋቀዮን ከበጅ፤","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዮስ ጎምብሳንኬ ሀመ እራን ዸንገለኡት ጉተመ፤","poem":1},{"text":"እዶን ጩንፋ ወይኒኬቲስዳዺዻን ጉተሜ እራን ዸንገለአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ያ እልመኮ፣ አደቢ ዋቀዮ ህንቱፈትን፤","poem":1},{"text":"ዼከምሰሳስ ህንጅብን።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዋቀዮ አኩመ አባ እልመ ኦፊሳ ጃለቱ ቶኮት","poem":1},{"text":"ወረ ጃለቱ ንአደባቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ነምን ኦጉማ አርገቱ","poem":1},{"text":"ከን ሁበትናስ አርገቱ ኤብፈማዸ፤","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኦጉማን ሜቲ ጫላ ፋይዳ ቀባቲ፤","poem":1},{"text":"ወርቄ ጫላስ ቡኣ ነማፍ ቡሰ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ገቲንሼ ገቲ ሉለ ዲማ ጫለ፤","poem":1},{"text":"ወን አት አከ መሌ ሀውቱ ከምዩ እሼዻን ወል ቅጣቹ ህንደንደኡ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ጅሬኝ ዼራን ሀርከሼ ምርጋ ኬሰ ጅረ፤","poem":1},{"text":"በዻዹማፊ ኡልፍን ሀርከሼ ብታ ኬሰ ጅሩ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ከራንሼ ከራ ነመ ገመቺሱዸ፤","poem":1},{"text":"ዳንዲንሼ ሁንድስ ነጋዸ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እሼን ወረ ጀቤሰኒ እሼ ቀበተኒፍ ሙከ ጅሬኛት፤","poem":1},{"text":"ወር እት ጭቸኒ እሼ ቀበተንሞ ንኤብፈሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ዋቀዮ ኦጉማዻን ሁንዴ ለፋ ቡሴ፤","poem":1},{"text":"ሁበትናዻንስ ሰሚወን እዶሳኒ ካኤ፤","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ቤኩምሰሳቲን ቱጁበወን ገርገር ቆደመን፤","poem":1},{"text":"ዱሜሶንስ ፍጤንሰ ጮጮብሰን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ያ እልመኮ ኦጉማፊ ሁበትና ዹጋ ኤገዹ፤","poem":1},{"text":"እሳንስ ፉለኬ ዱራ ህንዸበምን፤","poem":2}]},{"type":"verse","number":22,"content":[{"text":"እሳን ጅሬኘ ሲፍ ተኡ፤","poem":1},{"text":"ሞርመኬ ሚዸግሱፍስ ፋየ ሞርማ ሲፍ ተኡ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዮስ አት ከራኬ ነጉማን ዴምተ፤","poem":1},{"text":"ሚልኬስ ህንጉፈቱ፤","poem":2}]},{"type":"verse","number":24,"content":[{"text":"አት ዮ ረፍቱ ህንሶዳቱ፤","poem":1},{"text":"ህርብንኬስ ዮ አት ረፍቱ ስት ምኣወ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"በላ አኩመ ተሳ ስት ዹፉ","poem":1},{"text":"ዮካን በዲሰ ሀሞተ ገላፈቱ ህንሶዳትን፤","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዋቀዮ እርኮ ሲፍ ተኣቲ፤","poem":1},{"text":"አከ ሚልኬ ክዮዻን ህንቀበምኔስ ስ ኤገ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"አት ዬሮ ዋን ቶኮ ጎቹዻፍ ኣንጎ ቀብዱት፣","poem":1},{"text":"ወረ ወን ጋሪን እሳኒፍ መሉራ ዋን ሰነ ህንሀንቅስን።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ኡቱ አመ ዋ ቀብዱ፣","poem":1},{"text":"ኦላኬቲን፣ “ዬሮ ብራ ዴብኢ ኮቱ፤","poem":2},{"lineBreak":true},{"text":"አን ቦር ሲፍን ኬናቲ” ህንጄዽን።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ኦላኬ ከን ስ አመኔ ስ ጭነ ጅራቱ ሚዹፍ ጄቴ","poem":1},{"text":"ዋን ሀማ እት ህንያድን።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ነመ ቶኮ ኡቱ እን ሆማ ስ ህንጎዽን","poem":1},{"text":"አከሱማን ህንሚዽን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"ነመ ደባት ህንህናፍን፤","poem":1},{"text":"ዮካን ከራሳ ቶኮሌ ህንፍለን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"ዋቀዮ ነመ ጀልኣ ንጅባቲ፤","poem":1},{"text":"ነመ ቀጄላ ገሩ ኦፍት ኣንፈተ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"አባርስ ዋቀዮ መነ ነመ ሀማረ ቡአ፤","poem":1},{"text":"እን ገሩ መነ ነመ ቀጄላ ንኤብሰ።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"እን ቆስቶተ ኦፍ ቱልቶተት ንቆሰ፤","poem":1},{"text":"ወረ ገድ ኦፍ ቀበኒፍሞ አያነ ኬነ።","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ኦጌዪን ኡልፍነ ዻሉ፤","poem":1},{"text":"ጎዎተ ገሩ እን ንቃኔሰ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}