{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":["ጄቸ አጉር እልመ ያቄ።",{"text":"ዱቢን ነመ ከና አከነ ጄዼ ኢቲኤሊት ዱበተሜ፦","poem":1},{"lineBreak":true},{"text":"“እንስ ኢቲኤሊቲፊ ኡካልት ዱበቴ፦","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አን ዹጉማን ዶፋ ነመ ሁንዳ ገዲት፤","poem":1},{"text":"አን ሁበትና ነምን ቀቡ ህንቀቡ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አን ኦጉማ ህንበረትኔ ዮካን ቤኩምሰ","poem":1},{"text":"እሰ ቁልቁሉ ሰና ህንቀቡ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኤኙቱ ሰሚት ኦል በኤ ዴብኤ ዹፌ?","poem":1},{"text":"ከን ሀርክሳ ቡቤ ወልት ቀቤ ኤኙ?","poem":2},{"text":"ነምን ብሻን ኡፈታን መሬ ኤኙ?","poem":1},{"text":"ከን ዳሪ ለፋ ሁንደ ጀቤሴ ዻቤ ኤኙ?","poem":2},{"text":"መቃንሳቲፊ መቃን እልመሳ ኤኙ?","poem":1},{"text":"ሜ ዮ ቤክቴ ነት ህም!","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ዱቢን ዋቃ ሁንድኑ ህርእነ ህንቀቡ፤","poem":1},{"text":"ወረ እሰት ኮሉ ገለኒፍ፣ እን ጋቸነ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዱቢሳት ሆማ ህንደበልን፤","poem":1},{"text":"ዮ ከና አቺ እን ስ እፈተ፤ አትስ ሶብዱ ታቴ አርገምተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ያ ዋቀዮ አን ወንቶተ ለመ ስን ከዸዸ፤","poem":1},{"text":"እሳንስ ኡቱ ሀመን ጅሩት አነ ህንዾወትን።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጎዎምሳፊ ሶበ ነራ ፈጌስ፤","poem":1},{"text":"ህዩማ ዮካን ሶሩመ ናፍ ህንኬንን፤","poem":2},{"lineBreak":true},{"text":"ገሩ ቡዴነኮ ጉያ ጉያን ናፍ ኬን።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዮ ከና አቺ አን አከ መሌ ቁፌ ስ ገኔ","poem":1},{"text":"‘ዋቀዮ ኤኙዸ?’ ነንጄዸ፤","poem":2},{"text":"ዮካን ህዮሜ ሀቴ፣","poem":1},{"text":"አከሲን መቃ ዋቀኮ ነንሰልጵሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ገርብቸ ቶኮ ጎፍታሳ ብረት ህንሀመትን፣","poem":1},{"text":"ዮ ከና አቺ እን ስ አባራ፤ አትስ ዋን ከነት ንጋፈተምተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ዸሎተ አባሳ አባሩ","poem":1},{"text":"ከን ሃዸሳሌ ህንኤብፍኔቱ ጅረ፤","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዸሎተ ቁልቁሉ ኦፍ ሴኡ፣","poem":1},{"text":"ከን ጡሪሳራ ህንቁልቁሌፈምንቱ ጅሩ፤","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዸሎተ እጅሳ አከ መሌ ኦፍ ቱሉ፣","poem":1},{"text":"ከን ባሌን እጀሳስ ነመ ቱፈቱቱ ጅረ፤","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዸሎተ ህዬዪ ለፈራ ፍጡፍ","poem":1},{"text":"ረከቶተሌ ግዱ ነማቲ በሌሱፍ","poem":2},{"text":"እልካንሳ ጎራዴ፣","poem":1},{"text":"ሀኦንሳሞ ብላ ተኤ ጅረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“ዹላንዹል እንተለን፣","poem":1},{"text":"‘ኬን! ኬን!’ ጄዸኒ እየን ለመ ቀብድ።","poem":2},{"lineBreak":true},"“ወንቶተ ጎንኩማ ህንቁፍኔ ሰዲቱ ጅረ፤ ከኔን ጎንኩማ፣ ‘ኑ ገኤ!’ ህንጄኔሞ አፉርቱ ጅረ፦"]},{"type":"verse","number":16,"content":["እሳንስ ሲኦል፣ ገደሜሰ መሴኔ፣ ለፈ ጎንኩማ ብሻን ህንቁፍኔፊ እብደ ጎንኩማ፣ ‘ነ ገኤ!’ ህንጄኔዸ።"]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“እጀ አባት ቆሱ፣","poem":1},{"text":"ከን አጀጀ ሃዻ ቱፈቱ","poem":2},{"text":"አራጌሰ ሱሉላቲን ባፈመ፤","poem":1},{"text":"ጆብራንስ ንኛተመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":["“ወንቶትን አከ መሌ ነ ድንቅሲሰን ሰዲቱ ጅረ፤ አፉርሞ አን ህንሁበዹ፤ ኩንስ፦"]},{"type":"verse","number":19,"content":["ከራን ርሳ ሰሚረ፣ ከራን ቦፋ ከታረ፣ ከራን ዶኒ ገላነ ጉዳረ፣ ከራን ዺራሞ ዱበርቲ ወጅን ተኡሳት።"]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ከራን ኤጅቱ ከነ፦","poem":1},{"text":"እሼን ዋ ኛቴ አፋን ሀቀት፤","poem":2},{"lineBreak":true},{"text":"ኤርገሲሞ፣ ‘አን ሆማ ህንበሌስኔ’ ጄት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":["“ለፍት ዋን ሰዲ ጀለት ሆለት፤ አፉርሞ ባቹ ህንደንዴሱ፤ ኩንስ፦"]},{"type":"verse","number":22,"content":["ገርብቸ ሞቲ ተኡ፣ ጎዋ ኛቴ ቁፉ፣"]},{"type":"verse","number":23,"content":["ዱበርቲን ጅበምቴ ዬሮ ዽርሰ አርገቱ፣ ገርብቲ ጊፍቲሼ ዻልቱ።"]},{"type":"line_break"},{"type":"verse","number":24,"content":["“ወንቶትን ጥጥኖን አፉር ለፈረ ጅሩ፤ ተኡሌ እሳን አከ መሌ ኦጌዪዸ፤ እሳንስ፦"]},{"type":"verse","number":25,"content":["ጎንዳወን ቱተ ጀብነ ህንቀብኔዸ፤ ተኡስ እሳን ዬሮ ቦና ኛተሳኒ ወልት ቀበን፤"]},{"type":"verse","number":26,"content":["ኦሶሌወን ኡመመወን ሁምነ ህንቀብኔዸ፤ ገሩ ከታ ኬሰ ጅራቱ፤"]},{"type":"verse","number":27,"content":["ሀዋንስን ሞቲ ህንቀቡ፤ ገሩ ተሬ ገሌ ያአ፤"]},{"type":"verse","number":28,"content":["ሎጩን ሀርካን ቀበሙ ደንዴስ፤ ገሩ መሰራ ሞቲ ኬሰት አርገምት።"]},{"type":"line_break"},{"type":"verse","number":29,"content":["“ወንቶተ ዴምሰ ቶለን ሰዲቱ ጅረ፤ ከኔን ተርካንፊ በሬደንስ አፉርቱ ጅረ፤ እሳንስ፦"]},{"type":"verse","number":30,"content":["ሌንጨ ብኔንሰ ሁንደ ኬሳ ጀባ፣ ከን ዋን ቶኮሌ ሶዳቴ ዱበት ህንዴብኔ፤"]},{"type":"verse","number":31,"content":["ኮርመ እንዳንቆ ከን ኮራ ዴሙ፣ ኮርቤሰ ሬኤቲፊ፣ ሞቲ ሎልቶተሳ ዱረ ዴሙ።"]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"“አት ዮ ኦፍ ጀጁዻን ጎዎምቴ፣","poem":1},{"text":"ዮካን ዮ ሀምነ መለቴ፣","poem":2},{"lineBreak":true},{"text":"ሀርከኬ አፋንኬረ ካአዹ!","poem":2}]},{"type":"verse","number":33,"content":[{"text":"አኩመ ኣነን ራሱን ዸዻ ባሱ፣","poem":1},{"text":"ፉኛን ምጪሩንስ ዺገ ባሱ ሰነ፣","poem":2},{"lineBreak":true},{"text":"ኣሪ ከካሱን ሎለ ፍደ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}