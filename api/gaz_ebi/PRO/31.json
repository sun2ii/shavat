{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":["ጄቸ ሌሙኤል ሞትቻ ከን ሃትሳ እሰ በርሲፍቴ፦"]},{"type":"verse","number":2,"content":[{"text":"“ማል ያ እልመኮ፣ ማል ያ እልመ ገደሜሰኮ፣","poem":1},{"text":"ማል ያ እልመ ወሬገኮ፣","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሁምነኬ ዱበርቶተረት፣","poem":1},{"text":"ጀብነኬ ወረ ሞቶተ በሌሰንረት ህንፍጥን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“ያ ሌሙኤል፣ ወን ኩን ሞቶታፍ ህንመሉ፤","poem":1},{"text":"ዳዺ ወይኒ ዹጉን ሞቶታፍ ህንመሉ፤","poem":2},{"lineBreak":true},{"text":"ዹጋቲ ጭማት ገገቡንስ ቡልችቶታፍ ህንመሉ፤","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኩንስ አከ እሳን ዹገኒ ዋን ሴር ጄዹ ደገተኒ","poem":1},{"text":"ወረ ሀጩጨመን ሁንደ ምርገሳኒ ህንዾወኔፍ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ወረ በዱፍ ጅረኒፍ ዹጋቲ ጭማ፣","poem":1},{"text":"ወረ ጅሬኝ እት ሀዻኤፍ ዳዺ ወይኒ ኬን፤","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እሳን ዹገኒ ህዩማሳኒ ሃእራንፈተን፤","poem":1},{"text":"ረክነሳኒስ ዴብአኒ ህንያደትን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ወረ ኦፊሳኒቲፍ ዱበቹ ህንደንዴኜፍ፣","poem":1},{"text":"ምርገ ወረ ገተመኒቲፍስ ፈልም።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አፋንኬ በነዹ፤ ሙርቲ ቀጄላስ ኬን፤","poem":1},{"text":"ምርገ ህዬዪቲፊ ረከቶታቲፍ ፈልም።”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኒቲ አመለ ጋሪ ቀብዱ ኤኙቱ አርገቹ ደንደአ?","poem":1},{"text":"እሼን ሉለ ዲማ ጫላ ገት ቀቤቲዸ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዽርስሼ ጉድሴ እሼ አመነተ፤","poem":1},{"text":"እን ዋን ፋይዳ ቀቡ ቶኮሌ ህንዸቡ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እሼን በረ ጅሬኘሼ ጉቱ","poem":1},{"text":"ዋን ጋሪ እሳፍ ፍድ መሌ እሰ ህንሚቱ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እሼን ሱፊፊ ቁንጬ ተልባ በርባዴ","poem":1},{"text":"ሀርከሼ ከን ሆጂ ጃለቱን ፎት።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እሼን አኩመ ዶኒ ደልደላት","poem":1},{"text":"ለፈ ፈጎዻ ኛተሼ ፍደት።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እሼን ኡቱ ለፍት ህንበርእን ህርባ ካቴ","poem":1},{"text":"ማቲ እሼቲፍ ኛተ ኬንት፤","poem":2},{"lineBreak":true},{"text":"ጦምቦሬወን እሼፍስ ሆጂ ቆድ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እሼን ለፈ ቆቲሳ ሁበቴ እላልቴ ብት፤","poem":1},{"text":"ዋን ሆጄቴ አርገቱ ኬሳ ወይኒ ዻብድ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እሼን ጀብናን ሙዺሼ ህዸቴ","poem":1},{"text":"ሆጂዻፍ እሬሼ ጀቤፈት።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እሼን አከ ደልደልሼ ቡኣ ቀቡ ሁበት፤","poem":1},{"text":"እብሳንሼስ ሀልከኒን ህንዻሙ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሙክን እት ጅርቢ መረን ሀርከሼ ኬሰ ጅረ፤","poem":1},{"text":"ቁበሼቲንሞ ጨሊ ቀበት።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እሼን ህዬሳፍ ሀርከ ሂጠት፤","poem":1},{"text":"ዸባዻፍሌ ሀርከ በልእፍት።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዮ ጨቢን ቡኤሌ እሼን ማቲሼቲፍ ህንያዶፍቱ፤","poem":1},{"text":"እሳን ሁንድኑ ኡፈተ ብልዲማ ኡፈተኒሩቲ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"እሼን ወያ ስሬ ዸአት፤","poem":1},{"text":"ኡፈተ ዺልጌ ቁንጬ ተልባ ሀጲራሆጄተሜስ ኡፈት።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዽርስሼ ዮሙ ከረ መጋላ ዱረ፣","poem":1},{"text":"ጃርሶሊ ብያ ግዱ ታኡ ንከበጀመ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"እሼን ወያ ቁንጬ ተልባ ዾፍቴ ጉርጉርት፤","poem":1},{"text":"ደልደልቶታፍስ ሰበተ ዽኤስት።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"እሼን ጀብናፊ ኡልፍነ ኡፈት፤","poem":1},{"text":"በረ ዹፋ ጅሩትስ ኮልፉ ደንዴስ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"አፋንሼ ኦጉማዻን በነት፤","poem":1},{"text":"ጎርስ ገረ ላፍናስ አረበሼረ ጅረ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"እሼን መነሼ ቶአት፤","poem":1},{"text":"እሼን ቡዴነ ዽባኡማስ ህንኛቱ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"እጆሌንሼ ከአኒ፣ ኤብፈምቱ ጄዹን፤","poem":1},{"text":"ዽርስሼስ አከሱመ ጄዻን፤ አከነ ጄዼስ እሼ ጀጀ፦","poem":2}]},{"type":"verse","number":29,"content":[{"text":"“ዱበርቶትን ሄዱን ዋን ጋሪ ሆጄቱ፤","poem":1},{"text":"አት ገሩ እሳን ሁንደ ጫልተ።”","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ስምቦን ነመ ጎዎምሰ፤ ሚዸግንስ ንደርበ፤","poem":1},{"text":"ዱበርቲን ዋቀዮን ሶዳቱ ገሩ ገለቴፈምቱዸ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ቡኣ ሀርከሼ ኬናፊ፤","poem":1},{"text":"ሆጂንሼ ከረ መጋላ ዱረት እሼ ሃጀጁ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}