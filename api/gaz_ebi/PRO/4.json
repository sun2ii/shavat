{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":4,"content":[{"type":"heading","content":["ኦጉማን ዋን ሁንደ ጫልት"]},{"type":"verse","number":1,"content":[{"text":"ያ እልማንኮ፣ ሜ ጎርሰ አባን ነማፍ ኬኑ ዸገኣ፤","poem":1},{"text":"ቀልቤፈዻቲ ሁበትና አርገዻ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አን በሩምሰ ጋሪ እስኒ ነንኬነ፤","poem":1},{"text":"ከናፉ በርሲሰኮ ህንዺስና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዬሮ አን ሙጫ ጥና ተኤ መነ አባኮ ቱሬት፣","poem":1},{"text":"ዬሮ አን ዳእመ ዺገ ተኤ ሃዸኮቲፍ እልመ ቶክቸ ቱሬት፣","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እን አከነ ጄዼ ነ በርሲሴ፤","poem":1},{"text":"“ገራኬ ጉቱዻን ዱቢኮ ጀቤሲ ቀበዹ፤","poem":2},{"lineBreak":true},{"text":"ሴረኮ ኤግ፤ አት ንጅራታቲ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኦጉማ አርገዹ፤ ሁበትናስ አርገዹ፤","poem":1},{"text":"ዱቢኮ ህንደገትን ዮካን እራ ህንጀልአትን።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኦጉማ ህንዺስን፤ እሼን ስ ኤግዲ፤","poem":1},{"text":"እሼ ጃለዹ፤ እሼንስ ስ ትክስቲ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኦጉማን ዋን ሁንደ ጫልት፤ ከናፉ ኦጉማ አርገዹ።","poem":1},{"text":"ዮ እሼን ዋን አት ቀብዱ ሁንደ ስ ባስፍቴሌ ሁበትና አርገዹ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኦጉማ ከበጅ፤ እን ኦል ስ ጉድሳቲ፤","poem":1},{"text":"እሰ ሀመዹ፤ እንስ ስ ከበጃቲ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እሼን ከለቸ በሬዳ መታኬረ ሲፍ ኬስ፤","poem":1},{"text":"ጎንፎ ሚዸጋሌ ሲፍ ኬንት።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ያ እልመኮ ዸገእ፤ ዋን አን ጄዹሌ ፉዸዹ፤","poem":1},{"text":"በር ጅሬኘኬቲስ ንባይአታ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አን ከራ ኦጉማረ ስን ቀጄልቸ፤","poem":1},{"text":"ዳንዲ ቀጄላረስ ስን ቡሰ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዬሮ አት ዴምቱ፣ ተርካንፊንኬ ህንእትፈሙ፤","poem":1},{"text":"ዮ ፊግዱሌ አት ህንጉፈቱ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ቀጄልፈመ ጀቤሲ ቀበዹ፤ ገድ ህንዺስን፤","poem":1},{"text":"ዋን እን ጅሬኘኬ ተኤፍ ጀቤሲ ኤገዹ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዳንዲ ሀሞታረ ሚለኬ ህንዻብን","poem":1},{"text":"ዮካን ከራ ጀልኦታረ ህንዴምን።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እራ ፈጋዹ፤ እረስ ህንዴምን፤","poem":1},{"text":"እራ ጎሪቲ ከራኬረ ቀጄል።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እሳን ዋን ሀማ ሆጄተን መሌ ረፉ ህንደንደአኒቲ፤","poem":1},{"text":"እሳን ሀመ ነመ ጉፈቺሰንት ህርበ ህንአርገተን።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እሳን ቡዴነ ሀምና ኛቱ፤","poem":1},{"text":"ዳዺ ወይኒ ከን ደባን አርገሜ ዹጉ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ከራን ቀጄልቶታ አኩመ እፈ በሪ በራቃ","poem":1},{"text":"ከን ሀመ ሳፋት እቱመ ፉፌ እፋ ዴሙት።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ከራን ሀሞታ ገሩ አኩመ ዱከነ ጉዳት፤","poem":1},{"text":"እሳን ዋን እሳን ጉፈቺሱ ህንቤከን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ያ እልመኮ፣ ዋን አን ጄዹ ቀልቤፈዹ፤","poem":1},{"text":"ዱቢኮቲፍስ ጉረ ኬን።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አከ እን ፉለኬ ዱራ ዸበሙ ህንጎዽን፤","poem":1},{"text":"ገራኬ ኬሰ ኦል ካአዹ፤","poem":2}]},{"type":"verse","number":22,"content":[{"text":"እን ወረ እሰ አርገቱፍ ጅሬኘ፣","poem":1},{"text":"ዸግነ ነማ ጉቱፍስ ፈይናቲ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዋን ሁንደ ጫላ ቀልቢኬ ኤገዹ፤","poem":1},{"text":"ቡርቃን ጅሬኛ አቺ በኣቲ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዱቢ ጀልእና አፋንኬ ኬሳ በሌስ፤","poem":1},{"text":"ሃሳ ሀማስ አረበኬራ ፈጌስ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"እጅኬ ከለቲዻን ቀጄልቼ ሃእላሉ፤","poem":1},{"text":"አትስ ጥዬፈዹ ፉለኬ ዱረ እላል።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ሚለኬቲፍ ዳንዲ ወል ቅጤፈዹ፤","poem":1},{"text":"ከራንኬ ሁንድኑ ሃጀባቱ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ገረ ምርጋት ዮካን ገረ ብታት ህንጎርን፤","poem":1},{"text":"ሚለኬ ሀምነራ ኤገዹ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}