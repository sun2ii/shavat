{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":5,"content":[{"type":"heading","content":["ኤጀራ ኦፍ ኤገቹ"]},{"type":"verse","number":1,"content":[{"text":"ያ እልመኮ፣ ኦጉማኮ ቀልቤፈዹ፤","poem":1},{"text":"ሁበትናኮቲፍሌ ጉረ ኬን፤","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ኩንስ አከ አት ሁበትና ቱርፈቴ","poem":1},{"text":"አረብንኬስ ቤኩምሰ ኩፈቱፍ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ህዺን ኤጅቱ ደመ ጮጮብሰ፤","poem":1},{"text":"ሃሳንሼ ዘይቲ ጫላ ለላፈ፤","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዹመረት ገሩ እሼን አኩመ ሀዾፍቱ ሀዾፍት፤","poem":1},{"text":"አኩመ ጎራዴ አፋን ለማስ ቀረ ቀቤቲዸ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሚልሼ ገረ ዱኣት ገድ ቡአ፤","poem":1},{"text":"ተርካንፊንሼ አዋለት ነመ ጌሰ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እሼን ዋኤ ከራ ጅሬኛ ዽመ ህንቀብዱ፤","poem":1},{"text":"ዳንዲንሼ ጀልኣዸ፤ እሼን ገሩ ከነ ህንቤክቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ኤጋ ያ እልማንኮ፣ ሜ ነ ዸገኣ፤","poem":1},{"text":"ዋን አን ጄዹራ ገረ ከምትዩ ህንጎርና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ከራኬሰን እሼራ ፈጌፈዻ፤","poem":1},{"text":"በልበለ መነሼት ህንዽኣና፤","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኩንስ አከ አት ኡልፍነኬ ነመ ብራቲፍ፣","poem":1},{"text":"ኡሙሪኬስ ነመ ነማፍ ህናኔፍ ህንኬንኔፍ፤","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አከሱመስ ቀቤኘኬ ኦርመቱ ኛተ፤","poem":1},{"text":"ደዸቢንኬስ መነ አለጋ በዻሰ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዹመ ጅሬኘኬቲት፣","poem":1},{"text":"ዬሮ ፎኒፊ ዸግንኬ ዹሙት አት ንኣደ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አትስ አከነ ጄተ፤ “አን አከምን አደበሙ ጅቤ!","poem":1},{"text":"ገራንኮስ አከም ስሬፈሙ ቱፈቴ!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አን በርሲስቶተኮቲፍ ህንአጀጀምኔ","poem":1},{"text":"ዮካን ቀጄልችቶተኮ ህንዸጌፈትኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አን ወልዳ ጉቱ ግዱት","poem":1},{"text":"ቀርቀረ በዲሳ ገኤን ቱሬ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ኤለኬ ኬሳ ብሻን፣","poem":1},{"text":"ቦለ ብሻኒኬ ኬሳሞ ብሻን ቁልቁሉ ዹግ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ቡርቃንኬ ጉቴ ዳንዲረ፣ ብሻንኬ ከን ያኡስ","poem":1},{"text":"ኦብዲ ኬሰ ዸንገለኡ ቀባ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እሳን ከንኬ ሃተአን፤","poem":1},{"text":"ኦርም ስ ወጅን ቆደቹ ህንቀቡ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ቡርቃንኬ ሃኤብፈሙ፤","poem":1},{"text":"ኒቲ ደርገጉማኬቲት ገመድ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እሼን ሚዸግዱ አከ ቦሮፋ፣ በሬዱ አከ ገደምሳት፤","poem":1},{"text":"ሀርምሼ ዬሮ ሁንደ ስት ሃቶሉ፤","poem":2},{"lineBreak":true},{"text":"ዬሮ ሁንደ ጃለልሼ ስ ሃቦጅኡ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ያ እልመኮ፣ አት ማሊፍ ኤጅቱዻን ቦጅአምተ?","poem":1},{"text":"ማሊፍ ቦባ ኒቲ ነመ ብራ ሀመተ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ከራን ነማ ጉቱማን ጉቱት ፉለ ዋቀዮ ዱረ ጅራቲ፤","poem":1},{"text":"እንስ ዳንዲ ነማ ሁንደ ንቶአተ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"በሌሳን ነመ ሀማ እሱመ ቀባተ፤","poem":1},{"text":"ፉኞን ጩቡሳ ጀቤሴ እሰ ቀበ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"እን ሰበቢ አደበሙ ዸቤፍ ዱአ፤","poem":1},{"text":"ጉድን ጎዉማሳስ ከራራ እሰ በሌሰ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}