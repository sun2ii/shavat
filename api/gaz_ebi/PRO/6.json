{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":6,"content":[{"type":"heading","content":["አኬከቺሰ ዋኤ ጎዉማረት ኬነሜ"]},{"type":"verse","number":1,"content":[{"text":"ያ እልመኮ፣ አት ዮ ኦላኬቲፍ ወቢ ታቴ","poem":1},{"text":"ሀርከ ዾፍቴ ነመ ኦርማቲፍ ከከቴ፣","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዮ ዋኑመ ዱበቴን ቀበምቴ","poem":1},{"text":"ዱቡመ አፋንኬቲቲን ክዮ ሴንቴ፣","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዮስ ያ እልመኮ፣አት ሰበቢ ሀርከ ኦላኬቲ ሴንቴ ጅርቱፍ","poem":1},{"text":"አት ኦፍ ባሱዻፍ","poem":2},{"text":"ደፊ ዸቂቲ ገድ ኦፍ ቀቢ","poem":1},{"text":"ጀቤሲቲ ኦላኬ ከዸዹ!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እጀኬቲፍ ህርበ፣","poem":1},{"text":"ባሌ እጀኬቲቲፍሞ ሙጋቲ ህንኤየምን።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አት አኩመ ኩሩጴ ሀርከ አደምስቱቲ ባቱት፣","poem":1},{"text":"አኩመ ስምብሮ ክዮ ነመ እሼ ቀቡ ጀላ ባቱት ኦፍ ኦልች።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ያ ዽባኣነነ ሜ ገረ ጎንዳ ዸቅ፤","poem":1},{"text":"ከራሼ ቀልቤፈዹቲ ኦጌሰ ተእ!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እን አጀጃ ህንቀቡ፤","poem":1},{"text":"ቶአታ ዮካን ቡልቻ ህንቀቡ፤","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ተኡሌ እን ቦነ ኬሰ ኛተሳ ኩፈተ፤","poem":1},{"text":"ዬሮ ምዻን ገልፈሙትሞ ኛተሳ ወልት ቀበተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ያ ዽባኣነነ፣ አት ሀመ ዮሚት ጪፍተ?","poem":1},{"text":"አት ዮም ህርበኬቲ ካተ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ህርበ ጥና፣ ሙጋቲ ጥና፣","poem":1},{"text":"ጥኖ ሀርከ ወልት መረቹ፣","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ህዩማንስ አኩመ ሀቱት ስት ዹፈ፤","poem":1},{"text":"ዴጉማንስ አኩመ ሎልቱ ህዸቴት ስት ዹፈ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ነምን ረክሳን፣ ነምን ሀማን፣","poem":1},{"text":"ዱቢ ሶባቲን አሲፊ አች ናነአ፤","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"እን እጃን ዸአ፤","poem":2},{"lineBreak":true},{"text":"ሚለሳቲንስ መለቶ ኬነ፤","poem":2},{"lineBreak":true},{"text":"ቁበሳቲን አርግሲሰ፤","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"እን ገራሳ እሰ ሶባዻን ሀምነ ያደ፤","poem":2},{"lineBreak":true},{"text":"ዬሮ ሁንደስ ሎለ ከካሰ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ከናፉ በዲስን ዮሙሱመ እሰት ዹፈ፤","poem":1},{"text":"እን አኩመ ተሳ ጨበ፤ ዴብኤስ ህንፈዩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":["ዋቀዮ ዋን ጀአ ጅበ፤ ዋን ቶርበሞ ንጥሬፈተ፤ እሳንስ፦"]},{"type":"verse","number":17,"content":["እጀ ኦፍ ቱሉ፣ አረበ ሶቡ፣ ሀርከ ዺገ ነመ በሌሳ ህንቀብኔ ዸንገላሱ፣"]},{"type":"verse","number":18,"content":["ገራ መለ ሀማ መሉ፣ ሚለ ገረ ጀልእናት አሪፈቱ፣"]},{"type":"verse","number":19,"content":["ዹገ ባቱ ሶባ ከን ሶበ ዸንገላሱ፣ ነመ ኦቦሎተ ግዱት ሎለ ከካሱዸ።"]},{"type":"heading","content":["አኬከቺሰ ዋኤ ኤጃረት ኬነሜ"]},{"type":"verse","number":20,"content":[{"text":"ያ እልመኮ፣ አጀጀ አባኬቲ ኤግ፤","poem":1},{"text":"በርሲሰ ሃዸኬቲሌ ህንገትን።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"በረ በራን ገራኬት ቀበዹ፤","poem":1},{"text":"ሞርመ ኬትስ ህዸዹ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዬሮ አት ዴምቱ እሳን ስ ቀጄልቹ፤","poem":1},{"text":"ዬሮ አት ረፍቱ ስ ኤጉ፤","poem":2},{"lineBreak":true},{"text":"ዬሮ አት ህርባ ካቱሌ ስ ሃሶፍሲሱ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"አጀጅን ኩን እብሳዻቲ፤","poem":1},{"text":"በርሲስን ኩንስ እፈ፤","poem":2},{"lineBreak":true},{"text":"ስሬፈምን አመላሞ ከራ ጅሬኛት፤","poem":2}]},{"type":"verse","number":24,"content":[{"text":"እሳን ዱበርቲ ሀምቱራ፣","poem":1},{"text":"ኒቲ ከሽለቤ አፋን ደማራ ስ ኤጉ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ገራኬ ኬሰት በሬድነሼ ህንዸረእን፤","poem":1},{"text":"ዮካን አከ እሼን እጀ እሼቲን ስ ቦጅቱ ህንጎዽን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ሰጋገልቱን ቡዴነ ቶኮን ብተምቲቲ፤","poem":1},{"text":"ኤጅቱንስ ጅሬኙመኬ አደምስት።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ነምን ቦባ ጀለት እብደ ባዸቴ","poem":1},{"text":"ወያንሳ ህንጉበትኔ ጅራ?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ነምን እብደ ጭሌረ ኤጄቴ","poem":1},{"text":"ሚልሳ ህንጉበትኔ ጅራ?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ነምን ኒቲ ነመ ብራ ወጅን ጪሱስ አከሱመ ተአ፤","poem":1},{"text":"ነምን እሼ ቱቁ ከምዩ ኡቱ ህንአደበምን ህንሀፉ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"ዮ ሀቱን ቶኮ ቤለ በኡፍ ጄዼ ሀቴ፣","poem":1},{"text":"ነሞትን ህንቱፈተን።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ገሩ እን ዮ ቀበሜ ደቻ ቶርበ ባሰ፤","poem":1},{"text":"ምአ መነሳ ሁንደስ ንኬነ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ነምን ሰጋገሉ ቀልቢ ህንቀቡ፤","poem":1},{"text":"ነምን ዋን አከሲ ሆጄቱ ኦፉመ ገላፈተ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ቆድንሳ ዻነሙፊ ሰልጰቹዸ፤","poem":1},{"text":"ቃኒንሳ ዮምዩ እሰራ ህንሀቀሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"ህናፋን ኣሪ ዽርሳ ከካሳቲ፤","poem":1},{"text":"እን ዬሮ ሃሎ በኡት ዺፈመ ቶኮዩ ህንጎዹ።","poem":2}]},{"type":"verse","number":35,"content":[{"text":"እን ቤኛ ቶኮሌ ህንፉዸቱ፤","poem":1},{"text":"ሀመም ባይአቱዩ እን መተኣ ንድደ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}