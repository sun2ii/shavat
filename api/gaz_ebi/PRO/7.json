{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":7,"content":[{"type":"heading","content":["ሰጋገልቱራ ኦፍ ኤገቹ"]},{"type":"verse","number":1,"content":[{"text":"ያ እልመኮ፣ ዱቢኮ ኤጊቲ","poem":1},{"text":"አጀጀኮስ ኦፍ ኬሰት ኩፈዹ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አጀጀኮ ኤግ፣ አት ንጅራታቲ፤","poem":1},{"text":"በርሲሰኮስ አኩመ ቀሮ እጀኬቲት ኤግ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ቁበኬት እሳን ህዸዹ፤","poem":1},{"text":"ገበቴ ገራኬቲረትስ በሬፈዹ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኦጉማን፣ “አት ኦቦሌቲኮት” ጄዽ፤","poem":1},{"text":"ሁበትናሞ፣ ፍረኮ ጄዺ ዋም፤","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እሳን ሰጋገልቱራ፣ ኒቲ ከሽለቤ ዱቢ እሼቲን","poem":1},{"text":"ነመ ሀርክፍቱራ ስ ኤጉ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"አን ፎዳ መነኮ ብራ ኬሳን፣","poem":1},{"text":"ከራ ቃዋቲን አለ እላሌ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አን ወረ ሆማ ህንደንዴኜ ኬሰት፣","poem":1},{"text":"ደርገጎተ ኬሰት ሁበዼ","poem":2},{"lineBreak":true},{"text":"ደርገጌሰ ቀልቢ ህንቀብኔ ቶኮ አርጌ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እንስ ከራ መነሼ ዸቁ ቀበቴ","poem":1},{"text":"ዳንዲ ጎሌ መነሼ ብረ ጅሩቲን ገድ ቡኣ ቱሬ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኩንስ ዬሮ አዱን ዺቴ ለፍት ድምምሳኣ ቱሬት፣","poem":1},{"text":"ዬሮ ሀልከን ዱከናኡ ጀልቀቤት ቱሬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ዱበርቲን ቶኮ አከ ሰጋገልቱት ኡፈቴ","poem":1},{"text":"ያደ ሀጡማቲን እሰ ስመቹፍ ገድ ባቴ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እሼን እይቱፊ ከሽለቤዸ፤","poem":1},{"text":"ሚልሼ መነ ህንዻበቱ፤","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ተከ ዳንዲረት፣ ተከ ኦብዲረት፣","poem":1},{"text":"ጎሌ ሁንደት ርጵጤ ነመ ኤገት።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እሼን ቀብዴ እሰ ዹንገት፤","poem":1},{"text":"ፉለ ቃኒ ህንቀብኔን አከነ ጄቲን፦","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“አን ኣርሳ ነጋ ዽኤሱን ቀበ፤","poem":1},{"text":"ሀርአ ወሬገኮ ጉተዼረ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ከናፉ አን ስ ስመቹፍን ገድ በኤ፤","poem":1},{"text":"አን በርባዴ ስ አርገዼረ!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አን ወያ በሬዱ ቁንጬ ተልባራ ሆጄተሜ ከን ግብጢ ዹፌን፣","poem":1},{"text":"ስሬኮ አፌ ሚዸግሴረ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አን ቁምቢን፣ አርጌሳፊ ቀረፋን","poem":1},{"text":"ስሬኮ ኡርጌሴረ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ኮቱ ሜ ሀመ በሪት ገድ ፈጌኘ ጃለላ ወሊ ወጅን ዹግና፤","poem":1},{"text":"ኮቱ ጃለላን ኦፍ ገመቺፍና!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዽርስኮ መነ ህንጅሩ፤","poem":1},{"text":"እን ከራ ዼራ ዴሜረ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እን ቦርሳሳ ማለቃን ጉተቴ ዴሜ፤","poem":1},{"text":"ሀመ ጅእ ጎበኑት መነት ህንዴብኡ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"እሼን ዱቢ ምኦፍቱዻን ከራራ እሰ ጀልእፍቴ፤","poem":1},{"text":"ሃሳ ነመ ሶሶቡንስ እሰ ድርቅሲፍቴ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"እንስ አኩመ ሰንጋ ቀለሙፍ ዴሙት፣","poem":1},{"text":"አኩመ ገደምሰ ክዮ ኬሰ ሴኑትስ","poem":2},{"text":"ዮሙሱመ ከኤ እሼ ዱካ ቡኤ፤","poem":1}]},{"type":"verse","number":23,"content":[{"text":"አኩመ ስምብረ ክዮት አሪፈቱት፣","poem":2},{"text":"እን ሀመ ጥይ ትሩሳ ወራኑት","poem":1},{"text":"አከ ወን ኩን ሉቡሳ ገላፈቱ ህንቤኩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ኤጋ ያ እልማንኮ፣ ነ ዸጌፈዻ፤","poem":1},{"text":"ዋን አን ጄዹስ ቀልቤፈዻ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"አከ ገራንኬ ከራሼት ገረገሉ ህንጎዽን፤","poem":1},{"text":"ከራኬራስ በዴ ዳንዲሼረ ህንቡእን።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ነሞትን ሄዱን ወረ እሼን ለፋን ዾፍቴዸ፤","poem":1},{"text":"ነሞትን ጀጀቦን ባይኤንስ ሀርከሼት ዹመኒሩ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"መንሼ ከራ ቅሌት ነመ ጌሱ፣","poem":1},{"text":"ከን ጎለ ዱኣት ገድ ነመ ቡሱዸ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}