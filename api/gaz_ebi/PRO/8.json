{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":8,"content":[{"type":"heading","content":["ዋምቸ ኦጉማ"]},{"type":"verse","number":1,"content":[{"text":"ኦጉማን ህንዩ?","poem":1},{"text":"ሁበትናንስ ሰገሌሳ ኦል ህንፉዸቱ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እሼን ቀርቀረ ከራ፣ ለፈ ኦል ከኣረ፣","poem":1},{"text":"እዶ ዳንዲን እት ወል ገኡ ዻበት፤","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ከረ መጋላት ነመ ገልቹ ብረ፣","poem":1},{"text":"በልበለ ዱረ ዻበቴ አከነ ጄቴ እይት፦","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“ያ ነሞተ፣ አን እዬን እስን ዋመ፤","poem":1},{"text":"አን እልማን ነማ ሁንደት ሰገሌኮ ኦል ነንፉዸዸ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እስን ወር ሆማ ህንቤክኔ፣ ቀልቢ ሆረዻ፤","poem":1},{"text":"እስን ወር ጎዋን ሁበትና አርገዻ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አን ዋን ፋይዳ ቀቡ ነንዱበዻቲ፣ ዸገኣ፤","poem":1},{"text":"ዋን ቀጄላ ዱበቹፍስ አፋንኮ ነንበነዸ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አፋንኮ ዹጋ ዱበተ፤","poem":1},{"text":"አረብንኮ ሀምነ ጅባቲ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዱቢን አፋንኮ ሁንድኑ ቀጄላዸ፤","poem":1},{"text":"ዱቢኮ ኬሳ ቶኮዩ ጀልኣ ዮካን ምጪረማ ምት።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ነመ ዋ ሁበቱፍ ዱቢንኮ ሁንድኑ ቀጄላዸ፤","poem":1},{"text":"ወረ ቤኩምሰ ቀቡፍስ ህርእነ ህንቀቡ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ቆደ ሜቲ ጎርሰኮ፣","poem":1},{"text":"ወርቄ ቁልቁሉ ጫላስ ቤኩምሰ ፍለዹ፤","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኦጉማን ሉለ ዲማ ጫላ ገቲ ጉዳ ቀብዲ፤","poem":1},{"text":"ወን አት ሀውቱ ቶኮዩ እሼዻን ወል ህንመዳሉ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“አን ኦጉማን፣ ቀልቢ ወጅን ነንጅራዸ፤","poem":1},{"text":"አን ቤኩምሳፊ ሁበትና ቀበ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዋቀዮን ሶዳቹን ጅቡዸ፤","poem":1},{"text":"ሀምነ አን ኦፍ ቱሉማፊ ኦፍ ጉድሱ፣","poem":2},{"lineBreak":true},{"text":"አመለ ሀማፊ ሃሳ ጀልኣ ነንጅበ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ጎርሳፊ ሙርቲን ዹጋ ከንኮት፤","poem":1},{"text":"አን ሁበትናፊ ሁምነ ቀበ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሞቶትን አናን ሞኡ፤","poem":1},{"text":"ቡልችቶትንስ አናን ሴረ ቀጄላ ባሱ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እልማን ሞቶታ አናን ቡልቹ፤","poem":1},{"text":"ነሞትን ቤቤከሞን ሁንድስ አናን ብየ ቡልቹ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አን ወረ ነ ጃለተን ነንጃለዸ፤","poem":1},{"text":"ወር ነ በርባደንስ ነ አርገቱ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሶሩምኒፊ ኡልፍን፣ ቀቤኚፊ","poem":1},{"text":"በዻዹማን ዹመ ህንቀብኔ ሀርኩመኮ ጅሩ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እጅኮ ወርቄ ቁልቁሉ ጫለ፤","poem":1},{"text":"ቡኣን ነራ አርገሙስ ሜቲ ፍለተማ ጫለ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አን ከራ ቀጄሉማረ፣","poem":1},{"text":"ዳንዲ ቀጄላረስ ነንዴመ፤","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ወረ ነ ጃለቱት ቀቤኘ ነንዸንገላሰ፤","poem":1},{"text":"መንኩሰ ቀቤኘሳኒሌ ነንጉተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“ዋቀዮ ዋን በረ ዱሪ ሆጄቴን ዱረ፣","poem":1},{"text":"ሆጂሳ ከን ጀልቀባቲን ዱረ ነ ኣንፈቴ፤","poem":2}]},{"type":"verse","number":23,"content":[{"text":"አን ኡቱ አዱኛን ህንኡመምን ዱረ፣","poem":1},{"text":"ጀልቀቡመት፣ በረ ሀመ ህንቀብኔን ዱረ ነንሙደሜ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"አን ኡቱ ቱጁብን ህንጅራትን፣","poem":1},{"text":"ኡቱ ቡርቃወን ብሻኒን ህንጉተምን ዸለዼ፤","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ኡቱ ቱሉወን እዶሳኒ ህንዻበምን ዱረ፣","poem":1},{"text":"አን ጋረኒን ዱረ ነንዸለዼ፤","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ኡቱ እን ለፈ ዮካን ድሬሼ","poem":1},{"text":"ዮካን ብዮ አዱኛ ቶኮዩህንኡምን ዱረ ነንዸለዼ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ዬሮ እን ሰሚወን ሁንዴሴት፣","poem":1},{"text":"ዬሮ እን ዽዽመረ ሙሜ ካኤት አን አችን ቱሬ፤","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ዬሮ እን ጉባት ዱሜሰ ጀቤሴ ዻቤ","poem":1},{"text":"መደ ቱጁባሌ ሁንዴሴት አን አችን ቱሬ፤","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ዬሮ እን አከ ብሻኖትን አጀጀሳ ህንጨብስኔፍ ጄዼ፣","poem":1},{"text":"ገላናፍ ዳንጋ ዻቤት፣","poem":2},{"text":"ዬሮ እን ለፈ ሁንዴሴት አን አችን ቱሬ።","poem":1}]},{"type":"verse","number":30,"content":[{"text":"ዬሮ ሰነት አን ኦጌሰ ሆጂ ሀርካ ተኤ እሰ ብረን ቱሬ።","poem":2},{"text":"አን ዬሮ ሁንደ ፉለሳ ዱረ ቡራቃ፣","poem":1},{"text":"ጉዩመ ጉያዻን ገመቹዻን ጉተማን ቱሬ፤","poem":2}]},{"type":"verse","number":31,"content":[{"text":"አን ጉቱማ አዱኛሳ ኬሰት እልልቻ፣","poem":1},{"text":"እልማን ነማትሌ ገመዳን ቱሬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"“ኤጋ ያ እልማንኮ፣ ሜ ነ ዸገኣ፤","poem":1},{"text":"ወር ከራኮ ኤገን ኤብፈሞዸ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ጎርሰኮ ዸጌፈዻቲ ኦጌዪ ተኣ፤","poem":1},{"text":"እሰ ህንቱፈትና።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ነምን ነ ዸገኡ፣","poem":1},{"text":"ከን ጉያ ሁንደ በልበለኮ ኤጉ፣","poem":2},{"lineBreak":true},{"text":"ከን ከረኮ ዱረ ቱሩ ኤብፈማዸ።","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ነምን ነ አርገቱ ከምዩ ጅሬኘ አርገተ፤","poem":1},{"text":"ዋቀዮ ብረትሌ ፉዸተመ አርገተ።","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ነምን ነ ህንአርገትኔ ገሩ ኦፉመ ሚዸ፤","poem":1},{"text":"ነምን ነ ጅቡ ሁንድኑ ዱአ ጃለተ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}