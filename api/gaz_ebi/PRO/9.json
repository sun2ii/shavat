{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PRO","translationId":"gaz_ebi","name":"ፈኬኘ","commonName":"ፈኬኘ","title":"ክታበ ፈኬኛ","order":20,"numberOfChapters":31,"sha256":"fa5e4c8942702c02a0bcbe38fdb157c17fae25424eec4a3edc2f79b18561d975","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gaz_ebi/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":9,"content":[{"type":"heading","content":["ኦጉማፊ ጎዉማ"]},{"type":"verse","number":1,"content":[{"text":"ኦጉማን መነሼ እጃረቴ፤","poem":1},{"text":"ኡቱባሼ ቶርበንስ ዸጋራ ቆጴፈቴ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እሼን ሆሪ ቀለቴ ዳዺ ወይኒሼ ቡልቡለቴ፤","poem":1},{"text":"ማዲሼሌ ቆጴፈቴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ተጃጅልቶተሼ ዱበረን ኤርገቴ","poem":1},{"text":"ፊጤ መጋላራ ለለብዴ።","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"እሼን ወረ ቀልቢ ህንቀብኔን አከነ ጄት፤","poem":2},{"text":"“እስን ወር ሆማ ህንቤክኔ ሁንድ አስ ኮታ!","poem":1}]},{"type":"verse","number":5,"content":[{"text":"ኮታቲ ኛተኮ ኛዻ፤","poem":2},{"lineBreak":true},{"text":"ዳዺ ወይኒ አን ቡልቡለዼሌ ዹጋ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ከራ ጎዉማኬሰኒ ሰነ ዺሳቲ ጅራዻ፤","poem":1},{"text":"ከራ ሁበትናረ ዴማ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ነምን ነመ ነመት ቆሱ ጎርሱ ከምዩ ንአረብሰመ፤","poem":1},{"text":"ነምን ነመ ሀማ እፈቱ ከምዩ ንሰልጰተ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አት ነመ ነመት ቆሱ ህንፈትን፤ እን ስ ጅባቲ፤","poem":1},{"text":"ነመ ኦጌሰ እፈዹ፤ እን ስ ጃለታቲ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ነመ ኦጌሰ ጎርስ፤ እን እቱመ ጫልችሴ ኦጌሰ ተኣ፤","poem":1},{"text":"ነመ ቀጄላፍ በሩምሰ ኬን፤ እን ቤኩምሰሳት ደበላቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ዋቀዮን ሶዳቹን ጀልቀበ ኦጉማት፤","poem":1},{"text":"እሰ ቁልቁሉ ሰነ ቤኩን ሁበትናዸ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ከራኮቲን በሪ ጅሬኘኬቲ ንዼረተ፤","poem":1},{"text":"ጅሬኘኬረትስ ወጎትን ንደበለሙቲ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዮ አት ነመ ኦጌሰ ታቴ፣ ኦጉማንኬ ስ በዻሰ፤","poem":1},{"text":"ዮ አት ከን ነመት ቆስቱ ታቴ ሱመ ቆፈቱ ግድረመ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ዱበርቲን ጎዋን ኦዱ ባይእፍት፤","poem":1},{"text":"እሼን ራቱ ሆማ ህንቤክኔዸ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እሼን በልበለ መነሼ ዱረ፣","poem":1},{"text":"ፊጤ መጋላ ጉባ በርጩመረ ቴሴ","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ወረ አቺን ደርበን፣ ከኔን ቀጄለኒ","poem":1},{"text":"ዳንዲሳኒረ ዴመን ዋምት።","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"እሼን ወረ ቀልቢ ህንቀብኔን አከነ ጄት።","poem":2},{"text":"“እስን ወር ሆማ ህንቤክኔ ሁንድ አስ ኮታ!","poem":1}]},{"type":"verse","number":17,"content":[{"text":"ብሻን ሀተን ንምኣወ፤","poem":2},{"lineBreak":true},{"text":"ኛትን ዾክሳን ኛተንስ ጉዶ ነመት ቶለ!”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እሳን ገሩ አከ ወር ዱአን አች ጅረን፣","poem":1},{"text":"አከ ኬሱሞንሼ ዽዽመ አዋላ ኬሰ ጅረንሌጥኑመ ቤኩ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}