{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"ነምን ጎርሰ ሀሞታቲን ህንዴዴብኔ፣","poem":1},{"text":"ዮካን ከራ ጩበሞታረ ህንዻበትኔ፣","poem":2},{"lineBreak":true},{"text":"ዮካን በርጩመ ቆስቶታረ ህንቴኜ፣ ኤብፈማዸ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ገሩ እን ሴረ ዋቀዮት ገመደ፤","poem":1},{"text":"ሴረሳስ ሀልከኒ ጉያ እረ ዴዴብኤ እት ያደ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እን አኩመ ሙከ ቀርቀረ ብሻን ያኡ ዻበሜ","poem":1},{"text":"ዬሮሳት እጀሳ ኬኑ፣","poem":2},{"text":"ከን ባልሳስ ህንጮለግኔት፤","poem":1},{"text":"ወን እን ሆጄቱ ሁንድኑስ ንቶላፍ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ሀሞን ገሩ አከነ ምት፤","poem":1},{"text":"እሳን አከ ሀበቂ ቅሌንስ ፉዸቴ በሌሱት።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ከናፉ ሀሞን ሙርቲ ዱረ፣","poem":1},{"text":"ዮካን ጩበሞትን ወልዳ ቀጄልቶታ ኬሰ ህንዻበተን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ዋቀዮ ከራ ቀጄልቶታ ንቤካቲ፤","poem":1},{"text":"ከራን ሀሞታ ገሩ ገረ በዲት ጌሰ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}