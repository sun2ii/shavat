{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ፣ አት ማሊፍ አች ፈጋቴ ዻበተ?","poem":1},{"text":"ዬሮ ረክናትስ ማሊፍ ኦፍ ዾክስተ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ነምን ሀማን ኦፍ ቱሉማሳቲን ህዬሰ አደምሰ፤","poem":1},{"text":"እን መሉመ መለቱን ሃቀበሙ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ነምን ሀማን ሀዊሳቲን ኦፍ ጀጀ፤ ኦፍቶ ንኤብሰ፤","poem":1},{"text":"ዋቀዮንሞ ንአረብሰ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ነምን ሀማን ሰበቢ ኦፍ ቱሉፍ ዋቀ ህንበርባዱ፤","poem":1},{"text":"ያደሳ ሁንዱማ ኬሰስ ዋቅን ህንጅሩ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ከራንሳ ዬሮ ሁንደ ንምልካኣፍ፤ እን ኦፍ ቱለ፤","poem":1},{"text":"ሴርኬስ እሰራ ፈጎዸ፤","poem":2},{"lineBreak":true},{"text":"ዲኖተሳ ሁንደትስ ቱፊዻን ቁማደ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እንስ፣ “ወን ነ ሶቾሱ ህንጅሩ፤","poem":1},{"text":"ረክንስ ጎንኩማ ነ ህንአርገቱ” ኦፊን ጄዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"አፋንሳ አባርሳን፣ ሶባፊ ዶርስሳን ጉተሜረ፤","poem":1},{"text":"ደባፊ ሀምን አረበሳ ጀለ ጅሩ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እን ገንዶተ ኬሰት ርጴ ኤገተ፤","poem":1},{"text":"እዶ ዾከታትስ ወረ የከ ህንቀብኔ አጄሰ።","poem":2},{"text":"እጀሳቲንስ ህዬዪ ጋደ።","poem":1}]},{"type":"verse","number":9,"content":[{"text":"አከ ሌንጨ ደገለሳ ኬሳት ርጴ ኤገተ።","poem":2},{"text":"ህዬሰ ቀበቹዻፍ ዾከቴ ኤገተ፤","poem":1},{"text":"ህዬሰስ ቀበቴ ክዮሳቲን ሀርክፈተ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ህዬስ ሱንስ ንጨጨበ፤ ገድ ኦፍ ቀበስ፤","poem":1},{"text":"ሁምነ ነመ ሀማ ጀለትስ ንኩፈ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እንስ፣ “ዋቀ እራንፈቴረ፤","poem":1},{"text":"ፉለሳስ ዾክፈቴረ፤ ጎንኩማ ህንአርጉ” ኦፊን ጄዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ያ ዋቀዮ ከእ! ያ ዋቅ ሀርከኬ ኦል ካፈዹ።","poem":1},{"text":"ረከታስ ህንደገትን።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ነምን ሀማን ማሊፍ ዋቀ አረብሰ?","poem":1},{"text":"ማሊፍስ ገራሳት፣","poem":2},{"lineBreak":true},{"text":"“እን ዋን ከነት ነ ህንጋፈቱ” ጄዸ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ያ ዋቅ፣ አት ገሩ ረክናፊ ገደ ወረ ሚዸመኒ ንአርግተ፤","poem":1},{"text":"ሀርከኬቲንስ ገቲ ባስፍተ።","poem":2},{"text":"ዴጋን ደበርሴ ስት ኦፍ ኬነ፤","poem":1},{"text":"አት እጆሌ አባ ህንቀብኔፍ ገርጋራዸ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እሬ ነመ ሀማቲፊ ጀልኣ ጨብስ፤","poem":1},{"text":"ሀመ ሀምንሳ ዹሜ ዸበሙት፣","poem":2},{"lineBreak":true},{"text":"ሀምነሳት እሰ ጋፈዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ዋቀዮ በረ በራ ሀመ በረ በራት ሞቲዸ፤","poem":1},{"text":"ኦርሞትን ለፈሳራ ንበርበዳኡ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ያ ዋቀዮ፣ አት ሀዊ ረከቶታ ንዸጌሰ፤","poem":1},{"text":"እሳን ጀጀቤስተ፤ እየሳኒሌ ንዸጌፈተ፤","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ኩንስ አከ ነምን ብዮራ ኡመሜ ስአች እሳን ህንጩንቁርስኔፍ","poem":1},{"text":"አት እጆሌ አባ ህንቀብኔፊ","poem":2},{"lineBreak":true},{"text":"ጩንቁርፈምቶታፍ አከ ዻበቱፍ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}