{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":102,"content":[{"type":"hebrew_subtitle","content":["ከዸትና ነምን ዽጰቴ ቶኮ ፋሩ ቦእቻ ፋርሴ ፉለ ዋቀዮ ዱረት ዽኤፈቱ።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ፣ ከዸትናኮ ና ዸገእ፤","poem":1},{"text":"እይ አን ገርጋርሳፍ እየዹስ ስ ብረ ሃገኡ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዬሮ አን ዽጰዼት፣","poem":1},{"text":"ፉለኬ ነ ዱራ ህንዾክስን።","poem":2},{"text":"ጉረኬ ገረኮት ዴብስ፤","poem":1},{"text":"ዮሙ አን ስ ዋመዹ ደፊቲ ዴቢ ና ኬን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"በርኮ አኩመ ኣራት ንበዳቲ፤","poem":1},{"text":"ለፌንኮስ አኩመ በርበዳ እብዳ ቦበኣ ጅረ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ገራንኮ ዹኩብሰቴ አኩመ መርጋ ጮለጌረ፤","poem":1},{"text":"አን ኛተኮ ኛቹ እራንፈዼረ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሰበቢ አን ጉድሴ ኣዱፍ፣","poem":1},{"text":"ለፌንኮ ጎጋኮት መጠኔረ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አን አከ ኡሩንጉ ገሞጂ፣","poem":1},{"text":"አከ ኡሩንጉ ለፈ በርበዳኤ ኬሳ ነንተኤ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አን ህርበ መሌ ነንቡለ፤","poem":1},{"text":"አከ ስምብሮ ኮጳሼ ጉቱ መናረ ጅርቱስ ተኤረ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዲኖትንኮ ጉያ ጉቱ ነ አረብሱ፤","poem":1},{"text":"ወር ነት ቆሰንስ አባርሳፍ መቃኮት ፈየደሙ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አን አኩመ ቡዴናት ዳራ ኛዼራቲ፤","poem":1},{"text":"ዹጋቲኮትስ እምማን መከዼረ፤","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኩንስ ሰበቢ ኣሪፊ ዼከምሰኬቲቲፍ ነት ዹፌ፤","poem":1},{"text":"አት ኦል ነ ፉቴ ገድ ነ ደርበቴርታቲ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"በርኮ አኩመ ጋድዱ ገልገላት፤","poem":1},{"text":"አንስ አኩመ መርጋ ጎጌረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ያ ዋቀዮ፣ አት በረ በራን ቴሶረ ጅርተ፤","poem":1},{"text":"ያደኖንኬስ ዸሎተ ሁንደት ደርበ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አት ካቴ ጥዮኒፍ ገራ ንላፍተ፤","poem":1},{"text":"ዬሮን እት እሼን ፉዸተመ አርገቹ ቀብዱ አሙማቲ፤","poem":2},{"lineBreak":true},{"text":"ዬሮን ሙርቴፈሜ ሱን ገኤራ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ገርቦንኬ ዸጋሼት ገመዱቲ፤","poem":1},{"text":"ብዮሼስ ንመረርፈቱ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሰቦትን መቃ ዋቀዮ ንሶዳቱ፤","poem":1},{"text":"ሞቶትን ለፋ ሁንድኑስ ኡልፍነኬ ንከበጁ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዋቀዮ ዴብሴ ጥዮንን እጃራቲ፤","poem":1},{"text":"ኡልፍነሳቲንስ ንሙልአተ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እን ከዸትና ገደደምቶታ ንዸገአ፤","poem":1},{"text":"ዋመተሳኒስ ህንቱፈቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"አከ ሰብን ሀመ አማት ህንዸለትን ዋቀዮን ገለቴፈቱፍ፣","poem":1},{"text":"ወን ኩን አከነ ጄዸሜ ዸሎተ ዹፉፍ ሃበሬፈሙ፦","poem":2}]},{"type":"verse","number":19,"content":[{"text":"“ዋቀዮ እዶ ቁልቁሉማሳ ጉባራ ገድ እላሌ፤","poem":1},{"text":"ሰሚራስ ገረ ለፋ ገድ ምልአቴ፤","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ከነስ ኣዱ ወረ ህዸመኒ ዸገኡፊ","poem":1},{"text":"ወረ ዱት እት ሙረሜ ባሱዻፍ ሆጄቴ።”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አከሲን መቃን ዋቀዮ ጥዮን ኬሰት፣","poem":1},{"text":"ገለንሳስ ዬሩሳሌም ኬሰት ንለብሰመ፤","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ኩንስ ዮሙ ሰቦትኒፊ ሞቱሞን፣","poem":1},{"text":"ዋቀዮን ዋቄፈቹፍ ወልት ቀበመንት ተአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"እን ጀብነኮ ከራት ሀምብሴ፤","poem":1},{"text":"ኡሙሪኮስ ንገባብሴ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"አንስ አከነን ጄዼ፦","poem":1},{"text":"“ያ ዋቀኮ፣ ወለካ ኡሙሪኮት ነ ህንፉዸትን፤","poem":2},{"lineBreak":true},{"text":"ወጎትንኬ ዸሎታ ሀመ ዸሎተ ሁንዳት እት ፉፉ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"አት ጀልቀበት ለፈ ሁንዴስቴ፤","poem":1},{"text":"ሰሚወንስ ሆጂ ሀርከኬቲት።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"እሳን ንበዱ፤ አት ገሩ ንጅራተ፤","poem":1},{"text":"ሁንዱምትሳኒ አኩመ ወያ ንዹሙ።","poem":2},{"text":"አት አኩመ ኡፈታ እሳን ጌደርተ፤","poem":1},{"text":"እሳንስ ንበዱ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"አት ገሩ ሰኑመ፤","poem":1},{"text":"ኡሙሪንኬስ ጎንኩማ ዹመ ህንቀቡ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"እጆሌን ገርቦተኬቲ ሶዳ መሌ ጅራቱ፤","poem":1},{"text":"ሰኚንሳኒስ ፉለኬ ዱረ ጅራተ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}