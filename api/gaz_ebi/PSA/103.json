{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":103,"content":[{"type":"hebrew_subtitle","content":["ፋርፈትና ዳዊት።"]},{"type":"verse","number":1,"content":[{"text":"ያ ሉቡኮ፣ ዋቀዮን ኤብስ፤","poem":1},{"text":"ኬስ ነሙማኮ ሁንድ መቃሳ ቁልቁሉ ሰነ ኤብሳ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ያ ሉቡኮ ዋቀዮን ኤብስ፤","poem":1},{"text":"ቶለሳ ሁንደስ ህንእራንፈትን።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እን ጩቡኬ ሁንዱማ ሲፍ ዺሰ፤","poem":1},{"text":"ዹኩበኬ ሁንዱማ ንፈይሰ፤","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጅሬኘኬ ቦለራ ንበራረ፤","poem":1},{"text":"ጃለላፊ ገረ ላፍናን ስ ጎንፈ፤","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አከ ደርገጉማንኬ አኩመ ርሳ ሃሮምፈሙፍስ፣","poem":1},{"text":"እን ፌዺኬ ዋን ጋሪዻን ንጉተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ዋቀዮ ወረ ጩንቁርፈመን","poem":1},{"text":"ሁንዳፍ ቀጄሉማፊ ሙርቲ ቀጄላ ኬነ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"እን ከራሳ ሙሴት፣","poem":1},{"text":"ሆጂሳሞ ሰበ እስራኤልት ቤክስሴ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዋቀዮ ገረ ላፌሳፊ አርጃዸ፤","poem":1},{"text":"እን ኣሩፍ ህንአሪፈቱ፤ ጃለልሳስ ባይኤዸ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እን ዬሮ ሁንደ ህንዼከሙ፤","poem":1},{"text":"ኣሪሳሌ በረ በራን ህንኩፈቱ፤","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እን አከ ጩቡኬኛት ኑ ህንአደብኔ፤","poem":1},{"text":"ዮካን አከ በሌሳኬኛት ኑፍ ህንዴብፍኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አኩመ ሰሚወን ለፈራ ኦል ፈጋተን ሰነ፣","poem":1},{"text":"ጃለል እን ወረ እሰ ሶዳተኒፍ ቀቡ አከሱመ ጉዳዸ፤","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አኩመ በእ ቢፍቱ ልጠ ቢፍቱራ ፈጋቱ፣","poem":1},{"text":"አከሱመ እን በሌሳኬኘ ኑራ ሀቄረ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አኩመ አባን እጆሌሳቲፍ ገራ ላፉ፣","poem":1},{"text":"ዋቀዮ ወረ እሰ ሶዳተኒፍ ገራ ንላፈ፤","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እን አከ ኑ እት ኡመምኔ ንቤካቲ፤","poem":1},{"text":"አከ ኑ ብዮ ታኔስ ንያደተ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"በር ነማ አኩመ መርጋት፤","poem":1},{"text":"አከ አባቦ ድሬስ ንምሰ፤","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እን ዬሮ ቡቤን እት ቡብሱት ንበደ፤","poem":1},{"text":"እዶንሳስ ዴብኤ እሰ ህንያደቱ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ጃለል ዋቀዮ ገሩ በረ በራ ሀመ በረ በራት","poem":1},{"text":"ወረ እሰ ሶዳተን ወጅን ንጅራተ፤","poem":2},{"lineBreak":true},{"text":"ቀጄሉማንሳሞ እጆሌ እጆሌሳኒት ደርበ፤","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ወረ ከኩሳ ኤገንት፣","poem":1},{"text":"ወረ አጀጀሳት ቡሉ ያደተንትስ ንደርበ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ዋቀዮ ቴሶሳ ሰሚ ኬሰ ዻበቴረ፤","poem":1},{"text":"ሞቱማንሳስ ዋን ሁንደ ቡልቸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"እስን ኤርገሞትንሳ፣ ወር አጀጀሳ ኤግደን ጀጀቦን፣","poem":1},{"text":"ወር ዱቢሳቲፍ አጀጀምተንስ ዋቀዮን ኤብሳ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ራያንሳ ሁንድኑ፣ እስን ተጃጅልቶትንሳ","poem":1},{"text":"ወር ፌዺሳ ጉተን ዋቀዮን ኤብሳ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ኡመመወን ቡልቺንሰሳ","poem":1},{"text":"ጀለ ለፈ ሁንደ ጅርተን ሁንድ ዋቀዮን ኤብሳ።","poem":2},{"lineBreak":true},{"text":"ያ ሉቡኮ፣ ዋቀዮን ኤብስ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}