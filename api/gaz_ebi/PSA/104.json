{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":104,"content":[{"type":"verse","number":1,"content":[{"text":"ያ ሉቡኮ፣ ዋቀዮን ኤብስ።","poem":1},{"lineBreak":true},{"text":"ያ ዋቀዮ፣ ዋቀኮ፣ አት አከ መሌ ጉዳዸ፤","poem":1},{"text":"ሚዸግናፊ ሱራ ኡፈቴርተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"አት አኩመ ወያ እፈ ኡፈተ፤","poem":1},{"text":"ሰሚወንስ አኩመ ዱንካና ድሪርስተ።","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ደሬራ ዲንቀሳ ብሻኖተረ ቡፍተ።","poem":2},{"text":"ዱሜሶተ ጋሪሳ ጎዸተ፤","poem":1},{"text":"ቆቾ ቡቤ ያበቴ ዴመ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እን ኤርገሞተሳ ሀፉሮተ፣","poem":1},{"text":"ተጃጅልቶተሳሞ አረበ እብዳ ጎዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"እን ለፈ ሁንዴሼረ ዻቤረ፤","poem":1},{"text":"እሼንስ ጎንኩማ ህንሶቾቱ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አት አኩመ ወያት ቱጁባን እሼ ሀጉግዴ፤","poem":1},{"text":"ብሻኖትንስ ቱሉወኒ ኦል ዻበተን።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አት እፈትናን ብሻኖትን በቀተን፤","poem":1},{"text":"ሰገሌ ቀቀዌኬቲ ዸጌኛን ጉገተን።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እሳን ቱሉወን እራን ዸንገለአን፤","poem":1},{"text":"ገረ እዶ አት እሳኒ ቆጴስቴ፣","poem":2},{"lineBreak":true},{"text":"ገረ ሱሉሎታት ገድ ያአን።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አከ እሳን ዴብአኒ ለፈ ህንሀጉግኔፍ","poem":1},{"text":"አት ዳሪ እሳን ደርቡ ህንደንዴኜ እሳን ዱረ ዻብዴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"አከ ቡርቃወን ሱሉሎተ ኬሰ ያአን ጎተ፤","poem":1},{"text":"እሳንስ ቱሉወን ግዱ ያኡ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እሳን ብኔንሶተ በኬ ሁንዳፍ ብሻን ኬኑ፤","poem":1},{"text":"ሀሮትን ዲዳስ ዼቡ በኡ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ስምብሮትን ሰሚ ብሻኖተ ብረት መንዼ እጃረተን፤","poem":1},{"text":"ደሜወን ግዱት ንፋርፈተን።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እን መነሳ ከን ኦሊራ ቱሉወን ብሻን ኦባፍተ፤","poem":1},{"text":"ለፍትስ እጀ ሆጂኬቲቲን ቁፍት።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እን ለፈራ ኛተ ኬኑፍ ጄዼ ሎኒፍ መርገ፣","poem":1},{"text":"ፋይዳ ነማቲፍሞ ብቅልቱወን ብቅልቸ፤","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አከ ዳዺን ወይኒ ገራ ነመ ገመቺሱ፣","poem":1},{"text":"አከ ዘይቲን ፉለ ነመ ጩሉሉቅሱፊ","poem":2},{"lineBreak":true},{"text":"አከ ምዻን ነመ ጀጀቤሱ ንጎተ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሙኬን ዋቀዮ፣","poem":1},{"text":"ብርብርስ ልባኖን ከን እን ዻቤ ሱን ብሻን ቁፈኒሩ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ስምብሮትን አችት መንዼሳኒ እጃረቱ፤","poem":1},{"text":"ሁሞንስ ብርብርሰራ መነ ቀብድ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ቱሉወን ዼዼሮን ደኦ ሬኤ ዲዳት፤","poem":1},{"text":"ሆልቅ ከታወኒሞ ደኦ ኦሶሌት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"እን አከ ጅእ ወቅቲሌ ገርገር ቆዱ ጎዸ፤","poem":1},{"text":"ቢፍቱንስ ዬሮ እት ልጡ ንቤክት።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አት ዱከነ ኡምተ፤ ሀልከንስ ንተአ፤","poem":1},{"text":"ብኔንሶትን ቦሶና ሁንድስ ገድ ያኡ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሌንጭ ሳፌል ዋን ኛቱ በርባዴ ኣደ፤","poem":1},{"text":"ኛተሳስ ዋቀ ብረ በርባደ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"እሳን ዮሙ ቢፍቱን ባቱት ወልት ቀበሙ፤","poem":1},{"text":"ደቸአኒስ ጎደሳኒ ኬሰ ጭጪሱ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ነምን ገረ ሆጂሳት፣","poem":1},{"text":"ሀመ ገልገላትስ ገረ ጅሩሳት ንበአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ያ ዋቀዮ፣ ሆጂንኬ አከም ባይኤዸ!","poem":1},{"text":"አት ሁንደሳኒ ኦጉማዻን ሆጄቴ፤","poem":2},{"lineBreak":true},{"text":"ለፍትስ ኡመመወንኬቲን ጉተምቴ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ገላን ጉዳፊ በልኣን ኩን፣","poem":1},{"text":"ኡመመወን ሀመ ህንቀብኔን ጉተሜ፤","poem":2},{"lineBreak":true},{"text":"ከን ሉቡ ቀቤዪን ጉርጉዳፊጥጥኖን ኬሰ ጅራተን ኩኖ ጅረ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዶኒወን አስረ ዴዴብኡ፤","poem":1},{"text":"ሌዋታን ከን አከ እን አች ኬሰተጰቱፍ አት ኡምቴስ አች ጅረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"አከ አት ኛተሳኒ ዬሮ በርባችሱት እሳኒፍ ኬንቱፍ፣","poem":1},{"text":"እሳን ሁንድ ስ ኤገቱ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ዬሮ አት እሳኒፍ ኬንቱት፣","poem":1},{"text":"እሳን ወልት ቀበቱ፤","poem":2},{"text":"ዬሮ አት ሀርከኬ በልእፍቱት፣","poem":1},{"text":"እሳን ዋን ጋሪ ቁፉ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ዬሮ አት ፉለኬ ዾክፈቱት፣","poem":1},{"text":"እሳን ንነኡ፤","poem":2},{"text":"ዬሮ አት ሀፉረሳኒ ፉዸቱት፣","poem":1},{"text":"እሳን ዱአኒ ብዮት ዴብኡ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ዬሮ አት ሀፉረኬ ኤርግቱት እሳን ንኡመሙ፤","poem":1},{"text":"አትስ ፉለ ለፋ ንሃሮምስተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"ኡልፍን ዋቀዮ በረ በራን ሃጅራቱ፤","poem":1},{"text":"ዋቀዮ ሆጂሳት ሃገመዱ፤","poem":2}]},{"type":"verse","number":32,"content":[{"text":"እን እላላን ለፍት ሆለቴ፤","poem":1},{"text":"እን ቱቅናን ቱሉወን ኬሳ ኣሪ በኤ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"በረ ጅሬኘኮ ጉቱ አን ዋቀዮፍ ነንፋርፈዸ፤","poem":1},{"text":"ሀመ ሉቡንኮ ጅርቱትስ ፋርፈናዻንዋቀኮ ነንገለቴፈዸ።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"እረ ዴዴብኤ ያዱንኮ እሰ ሃገመቺሱ፤","poem":1},{"text":"አን ዋቀዮት ነንገመዳቲ።","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ጩበሞትን ለፈራ ሃበደን፤","poem":1},{"text":"ሀሞንስ ስአች ህንጅራትን።","poem":2},{"lineBreak":true},{"text":"ያ ሉቡኮ ዋቀዮን ኤብስ።","poem":1},{"lineBreak":true},{"text":"ሃሌሉያ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}