{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":105,"content":[{"type":"verse","number":1,"content":[{"text":"ዋቀዮፍ ገለተ ገልቻ፤ መቃሳስ ዋመዻ፤","poem":1},{"text":"ዋን እን ሆጄቴስ ሰቦተ ግዱት ቤክስሳ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እሳፍ ፋርፈዻ፤ ፋርፈናዻን እሰ ገለቴፈዻ፤","poem":1},{"text":"ዋኤ ሆጂሳ እሰ ድንቅሲሳ ሁንዳስ ኦዴሳ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"መቃሳ ቁልቁሉ ሰናን ቦና፤","poem":1},{"text":"ገራን ወረ ዋቀዮን በርባደኒ ሃገመዱ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዋቀዮፊ ሁምነሳ በርባደዻ፤","poem":1},{"text":"ዬሮ ሁንደ ፉለሳ በርባዳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ድንቂ እን ሆጄቴ፣","poem":1},{"text":"ሆጂሳ ድንቂ ሰናፊ ሙርቲ እን ለብሴ ያደዻ፤","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እስን ተጃጅልቶትንሳ፣ ወር ሰኚ አብረሃም ታተን፣","poem":1},{"text":"እስን ፍለተምቶትንሳ፣ እልማን ያቆብስ ከነ ያደዻ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እን ዋቀዮ ዋቀኬኘ፤","poem":1},{"text":"ሙርቲንሳስ ለፈ ሁንደረ ጅረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"እን ከኩሳ በረ በራን፣","poem":1},{"text":"ዋዳ ገሌ ሰነስ ዸሎተ ኩማፍ ንያደተ፤","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እን ከኩ አብረሃም ወጅን ገሌ፣","poem":1},{"text":"ከኩ ይስሃቂፍ ከከቴስ ንያደተ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ከነስ ያቆቢፍ ሴረ፣","poem":1},{"text":"እስራኤሊፍሞ ከኩ በረ በራ ጎዼአከነ ጄዼ ምርከኔሴረ፦","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“አን ብየ ከነኣን","poem":1},{"text":"ቆደ አት ዻልቱ ጎዼ ሲፍ ነንኬነ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"እሳን ዬሮ ለኮብሳን ጥኖ ቱረንት፣","poem":1},{"text":"ዹጉማኑ ጥኖፊ ብየቲ ኬሰትስኬሱሞተ ቱረንት፣","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሰባ ገረ ሰባት፣ ሞቱማ ቶኮ ገረ","poem":1},{"text":"ሞቱማ ብራት ጆረን።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እን አከ ነምን ቶኮዩ እሳን ጩንቁርሱ ህንኤየምኔ፤","poem":1},{"text":"ሰበቢሳኒቲፍስ አከነ ጄዼ ሞቶተ እፈቴ፦","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“ድበምቶተኮ ህንቱቅና፤","poem":1},{"text":"ራጆተኮስ ህንሚዽና።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"እን ቤለ ብየቲት ዋሜ፤","poem":1},{"text":"ምዻን ኛታ ሁንደስ ንበሌሴ፤","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እንስ ዮሴፍ ነምቸ አከ ገርባት","poem":1},{"text":"ጉርጉረሜ ቶኮ እሳን ዱረ ኤርጌ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እሳን ፎንጫዻን ሚለሳ ሉቅሰን፤","poem":1},{"text":"ሞርምሳስ ስቢለ ኬሰ ገልፈሜ፤","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሀመ ወን እን ዱራን ዱርሴ ዱበቴ ጉተሙት","poem":1},{"text":"ዱቢን ዋቀዮ እሰ ቆሬ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ሞቲን ነመ ኤርጌ ገድ እሰ ዺስሴ፤","poem":1},{"text":"ቡልቻን ሰባ እሰ ሂክስሴ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሞትችስ መነሳረት አጀጃ፣","poem":1},{"text":"ቀቤኘሳ ሁንደረትሞ ቡልቻ እሰ ጎዸቴ፤","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ከነስ አከ እን አኩመ ፌዼት ቆንዳልቶተሳ ጎርሱፍ፣","poem":1},{"text":"አከ እን ማንጉዶተሳ ኦጉማ በርሲሱፍ ጎዼ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"እስራኤል ብየ ግብጥ ዸቄ፤","poem":1},{"text":"ያቆብስ አከ አለጋት ብየ ሃም ኬሰ ጅራቴ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዋቀዮ ሰበሳ አከ መሌ ባይእሴ፤","poem":1},{"text":"አከ እሳን አመጃጆተሳኒ ጫላ ጀባተንስ ጎዼ፤","poem":2}]},{"type":"verse","number":25,"content":[{"text":"እንስ አከ እሳን ሰበሳ ጅበኒፊ","poem":1},{"text":"አከ እሳን ተጃጅልቶተሳት መርአተኒፍ ያደሳኒ ጌደሬ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዋቅንስ ሙሴ ተጃጅላሳቲፊ","poem":1},{"text":"አሮን ፍለተማሳ ኤርጌ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"እሳንስ ጀረ ግዱት መለቶሳ፣","poem":1},{"text":"ብየ ሃም ኬሰትሞ ድንቂሳ አርግሲሰን።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"እን ዱከነ ኤርጌ ብየቲ ዱከኔሴ፤","poem":1},{"text":"እሳን ዱቢሳት ፍንጭለኒሩቲ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"እን ብሻኖተሳኒ ዺገት ጌደሬ","poem":1},{"text":"አከ ቁርጡሚወንሳኒ ዹመን ጎዼ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ፈቴን ብየሳኒ ጉቴ","poem":1},{"text":"ዲንቀ ሞቶተሳኒ ኬሰ ያኤ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"እን ዱበናን ቱትን ትሲሳቲፊ","poem":1},{"text":"ቦኬን ብየሳኒ ሁንደ ኬሰ ጉቴ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"እን ቆደ ቦካ ጨቢ እሳኒፍ ሮብሴ፤","poem":1},{"text":"በከካስ ብየሳኒት ኤርጌ፤","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ወይኒሳኒቲፊ ሙከ ሀርቡሳኒ በሌሴ፤","poem":1},{"text":"ሙኬን ብየሳኒስ ንጨጨብሴ።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"እን ዱበናን ሀዋንስኒፊ","poem":1},{"text":"ኮሮጵስን ሄዱን ዹፈን፤","poem":2}]},{"type":"verse","number":35,"content":[{"text":"እሳንስ ብቅልቱ ብየ ጀራ ሁንደ ኛተን፤","poem":1},{"text":"ዋን ለፍትሳኒ ባሴስ ንፍጠን።","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ኤርገሲ እን ሀንገፈ ብየሳኒ ሁንደ፣","poem":1},{"text":"ጀብነሳኒ ጀልቀባስ ንዸኤ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"አከ ሰብን እስራኤል ሜቲፊ ወርቄ ባዸቴ በኡ ጎዼ፤","poem":1},{"text":"ጎሰሳኒ ኬሳ ነምን ቶኮዩ ህንጉፈትኔ።","poem":2}]},{"type":"verse","number":38,"content":[{"text":"እስራኤሎን ባናን ወር ግብጥ ገመደን፤","poem":1},{"text":"እሳን እስራኤልን ሶዳተኒ ቱረኒቲ።","poem":2}]},{"type":"verse","number":39,"content":[{"text":"እን አከ ጋድሳት ዱሜሰ እሳንረ ቀቤ፤","poem":1},{"text":"አከ ሀልከኒን እሳኒፍ እብሱፍሞ እብደ ቀብሲሴፍ።","poem":2}]},{"type":"verse","number":40,"content":[{"text":"እሳን ከዸናን እን ድምብርቄ ኬኔፍ፤","poem":1},{"text":"ቡዴነ ሰሚቲንስ እሳን ቁፍሴ።","poem":2}]},{"type":"verse","number":41,"content":[{"text":"እንስ ከታ በኔ፤ ብሻንስ ኬሳ ገድ ዸንገለኤ፤","poem":1},{"text":"አኩመ ብሻን ለጋትስ ገሞጂ ኬሳ ያኤ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":42,"content":[{"text":"እን ዋዳሳ ቁልቁሉ፣","poem":1},{"text":"ከን ገርብቸሳ አብረሃሚፍ ገሌ ሰነ ያደቴራቲ።","poem":2}]},{"type":"verse","number":43,"content":[{"text":"እን ሰበሳ ገመቹን፣","poem":1},{"text":"ወረ እሳፍ ፍለተመንሞ እልሌዻን ባሴረ፤","poem":2}]},{"type":"verse","number":44,"content":[{"text":"እን ብየ ኦርሞታ እሳኒፍ ኬኔ፤","poem":1},{"text":"እሳንስ ዋን ሰቦትን ሱን እት ደዸበን ዻለን፤","poem":2}]},{"type":"verse","number":45,"content":[{"text":"ከነስ አከ እሳን ስርነሳ ኤገኒ","poem":1},{"text":"ሴረሳቲፍ ቡለኒፍ ጎዼ።","poem":2},{"lineBreak":true},{"text":"ሃሌሉያ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":45}