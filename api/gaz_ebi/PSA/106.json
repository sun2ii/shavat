{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":106,"content":[{"type":"verse","number":1,"content":[{"text":"ሃሌሉያ።","poem":1},{"lineBreak":true},{"text":"ዋቀዮፍ ገለተ ገልቻ፤ እን ጋሪዻቲ፤","poem":1},{"text":"ጃለልሳ በረ በራን ጅራተ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ኤኙቱ ሆጂ ዋቀዮ ጀባ ሰነ ለብሱ፣","poem":1},{"text":"ዮካን ገለተሳ ጉቱማት ኦዴሱ ደንደኣ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ወር ጀቤሰኒ ሙርቲ ቀጄላ ኤገን፣","poem":1},{"text":"ወር ዬሮ ሁንደ ዋን ቀጄላ ሆጄተን ኤብፈሞዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ያ ዋቀዮ፣ ዮሙ ሰበኬት ፋረ ቶልቱት ነ ያደዹ፤","poem":1},{"text":"ዮሙ እሳን ኦልችቱትስ ነ ገርጋር፤","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አከ አን በዻዹማ ፍለተምቶተኬቲ አርጉፍ፣","poem":1},{"text":"አከ አን ገመቹ ሰበኬቲ ኬሰት ህርማዼ","poem":2},{"lineBreak":true},{"text":"ዻለኬ ወጅን ቦኑፍ ነ ያደዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ኑ አኩመ አቦቲኬኛ ጩቡ ሆጄትኔረ፤","poem":1},{"text":"የከ ሆጄትኔረ፤ ሀምነስ ሆጄትኔረ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አቦቲንኬኘ ዬሮ ብየ ግብጥ ኬሰ ቱረንት፣","poem":1},{"text":"ድንቂኬ ህንሁበትኔ፤","poem":2},{"text":"ባይእነ አራረኬቲስ ህንያደትኔ፤","poem":1},{"text":"እሳን ገላነ ብረት፣ ገላነ ዲማ ብረት ስት ፍንጭለን።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ተኡስ እን አከ ሁምንሳ ጉዳን ሱን ቤከሙፍ፣","poem":1},{"text":"መቃሳቲፍ ጄዼ እሳን ኦልቼ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እን ገላነ ዲማ እፈቴ፤ ገላንችስ ንጎጌ፤","poem":1},{"text":"አኩመ ዋን ገሞጂ ኬሰ ደበርሱት ለፈ ጎጋረ እሳን ደበርሴ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሀርከ አመጃጂሳኒ ኬሳ እሳን ባሴ፤","poem":1},{"text":"ሁምነ ዲና ጀላስ እሳን ፉሬ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ብሻኖትን ዲኖተሳኒ ልቅምሰን፤","poem":1},{"text":"ቶኮንሳኒዩ ህንሀፍኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኤርገሲ እሳን ዱቢሳ አመነኒ","poem":1},{"text":"ፋርፈናዻን እሰ ገለቴፈተን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"እሳን ገሩ ዮሙሱመ ዋን እን ሆጄቴ ቱሬ ደገተን፤","poem":1},{"text":"ጎርሰሳስ ኦብሳን ህንኤገትኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ገሞጂ ኬሰት ዸራ ሀማዻን ጉተመን፤","poem":1},{"text":"ለፈ ኦና ኬሰትስ ዋቀ ቆረን።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ከናፉ እን ዋን እሳን ከዸተን ኬኔፍ፤","poem":1},{"text":"ገሩ ዹኩበ ነመ ሁቅሱ እሳንት ኤርጌ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"እሳን ቁበተ ኬሰት ሙሴፊ","poem":1},{"text":"አሮን ቁልቁልቸ ዋቀዮት ህናፈን።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ለፍት አፋን በነቴ ዳታንን ልቅምስቴ፤","poem":1},{"text":"ገሬ አቢራምስ ገድ ፉዸቴ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዱከ ቡቶተሳኒ ግዱት እብድ ቦበኤ፤","poem":1},{"text":"አረብን እብዳስ ሀሞተ ፍጤ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"እሳን ኮሬብት ጀቢ ቶልፈተን፤","poem":1},{"text":"ፈኪ በቅፈሜ ቶልፈሜስ ዋቄፈተን።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እሰ ኡልፍነሳኒ ተኤ ሰነ፣","poem":1},{"text":"ፈኪ ሰንጋ መርገ ዼዱት ጌደረን።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዋቀ እሳን ፈይሴ፣","poem":1},{"text":"እሰ ብየ ግብጥት ዋን ጉርጉዳ ሆጄቴ ሰነ እራንፈተን።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ድንቂ እን ብየ ሃም ኬሰት ሆጄቴ፣","poem":1},{"text":"ሆጂ ሶዳችሳ እን ገላነ ዲማረት ሆጄቴስ ንእራንፈተን።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ከናፉ ኡቱ ፍለተማንሳ ሙሴን","poem":1},{"text":"አከ ዼከምስ ዋቃ እሳን ህንበሌስኔፍ","poem":2},{"text":"ግዱ ገሌ ፉለሳ ዱረ ዻበቹ ባቴ ስላ","poem":1},{"text":"ዋቅን አከ እሳን በሌሱ ዱበቴ ቱሬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"እሳንስ ብየ ነመት ቶሉ ሰነ ቱፈተን፤","poem":1},{"text":"ዋዳ ዋቅን ገሌስ ህንአመኔ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዱንካኖተሳኒ ኬሰት ንጉንጉመን፤","poem":1},{"text":"ዋቀዮፍስ ህንአጀጀምኔ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ከናፉ እን አከ ገሞጂ ኬሰት","poem":1},{"text":"እሳን ገቱ ሀርከሳ ኦል ቀበቴ ከከቴ፤","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ሰኚሳኒ አከ ሰቦተ ግዱት ገቱ፣","poem":1},{"text":"ብዮተ ሁንደ ኬሰስ አከ እሳን ብትኔሱ ከከቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"እሳን በኣል ጴኦርት ኦፍ ኬነኒ","poem":1},{"text":"ኣርሳ ዋቆተ ሉቡ ህንቀብኔፍ ዽኤፈሜ ኛተን።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ሆጂሳኒ ሀማ ሰናንዋቀዮን ዼከምሳፍ ከካሰን፤","poem":1},{"text":"ዸእችስ እሳንረ ቡኤ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ገሩ ፊኔሃስ ከኤ ግዱ ሴናን","poem":1},{"text":"ዸእች ሱን ዻበቴ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ኩንስ ዸሎታ ሀመ ዸሎታት፣","poem":1},{"text":"አከ ቀጄሉማት እሳፍ ሄሬገሜ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"እሳን ብሻን መሪባ ብረት አከ ዋቀዮ ኣሩ ጎዸን።","poem":1},{"text":"ሙሴንስ ሰበቢሳኒቲፍ ረከቴ፤","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ሰበቢ እሳን ሀፉረ ዋቃት ፍንጭለኒፍ","poem":1},{"text":"ሙሴን ኡቱ እት ህንያድን ዱበቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"እሳን አከ ዋቀዮ እሳን አጀጄት፣","poem":1},{"text":"ሰቦተ ህንበሌስኔ፤","poem":2}]},{"type":"verse","number":35,"content":[{"text":"እሳን ገሩ ኦርሞተት መከመኒ","poem":1},{"text":"ዱዻሳኒ በረተን።","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ዋቆተሳኒ ቶልፈሞ፣","poem":1},{"text":"ከኔን ክዮ እሳንት ተአን ዋቄፈተን።","poem":2}]},{"type":"verse","number":37,"content":[{"text":"እልማንሳ