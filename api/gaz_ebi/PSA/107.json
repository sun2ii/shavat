{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":107,"content":[{"type":"verse","number":1,"content":[{"text":"ዋቀዮፍ ገለተ ገልቻ፤ እን ጋሪዻቲ፤","poem":1},{"text":"ጃለልሳ በረ በራን ጅራተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ወር ዋቀዮ እሳን ፉሬ፣","poem":1},{"text":"ወር እን ሀርከ ዲናቲ ባሴ፣","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ወር እን ብየ ገረ ገራቲ፣","poem":1},{"text":"በኣፊ ልጠ ቢፍቱቲ፣ ካባፊ ክባ ወልት ቀቤ ዋን ከነ ሃዱበተን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"እሳን ኬሳ ቶኮ ቶኮ ገሞጂ ጎጎጋ ኬሰ ጆረን፤","poem":1},{"text":"መጋላ ኬሰ ጅራቹ ደንደአንስ ህንአርገኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እሳን ንቤለአን፤ ንዼቦተንስ፤","poem":1},{"text":"ሉቡንሳኒስ እሳን ኬሰት ገገብዴ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እሳን ረክነሳኒ ኬሰት ዋቀዮት እየተን፤","poem":1},{"text":"እንስ ዽጵነሳኒ ኬሳ እሳን ባሴ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እን ሀመ እሳን መጋላ ኬሰ ጅራቹ ደንደአን ገአንት","poem":1},{"text":"ከራ ቀጄላረ እሳን ቀጄልቼ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እሳን ሰበቢ ጃለለሳ ከን ህንጌደረምኔ ሰናቲፊ","poem":1},{"text":"ሆጂ ድንቂ ከን እን እልማን ነማቲፍ ሆጄቴ ሰናቲፍዋቀዮን ሃገለቴፈተን፤","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እን ወረ ዼቦተን ዼቡ ባሴ","poem":1},{"text":"ወረ ቤለአንሌ ዋን ጋሪዻን ቁፍሳቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"እሳን ኬሳስ ቶኮ ቶኮ ስቢላን ህዸመኒ ረከቻ፣","poem":1},{"text":"ዱከናፊ ድምምሰ ኬሰ ጅራተን፤","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እሳን ዱቢ ዋቃት ፍንጭለኒ","poem":1},{"text":"ጎርሰ ዋቀ ዋን ሁንዳ ኦሊስ ቱፈተኒሩቲ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ከናፉ እን ደበርሴ ሆጂ ደዸብሲሳት እሳን ኬኔ፤","poem":1},{"text":"እሳንስ ንጉፈተን፤ ነምን እሳን ገርጋሩ ቶኮዩ ህንአርገምኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እሳን ረክነሳኒ ኬሰት ዋቀዮት እየተን፤","poem":1},{"text":"እንስ ዽጵነሳኒ ኬሳ እሳን ባሴ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እን ዱከናፊ ድምምሰ ኬሳ እሳን ባሴ፤","poem":1},{"text":"ፎንጫ እሳንስ ገርገር ኩኩቴ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እሳን ሰበቢ ጃለለሳ ከን ህንጌደረምኔ ሰናቲፊ","poem":1},{"text":"ሆጂ ድንቂ ከን እን እልማን ነማቲፍ ሆጄቴ ሰናቲፍዋቀዮን ሃገለቴፈተን፤","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እን በልበለወን ናሲ ጨጨብሴ","poem":1},{"text":"ደንቀራወን ስቢላሌ ኩኩታቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"እሳን ኬሳ ቶኮ ቶኮ ጩቡ መታሳኒቲን ጎዎመን፤","poem":1},{"text":"ሰበቢ በሌሳሳኒቲፍስ ገደዶ ኬሰ ሴነን።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እሳን ኛተ ጎሰ ከሚዩ በልፈኒ","poem":1},{"text":"አፋን ቦለ ዱኣ ገአን።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ረክነሳኒ ኬሰት ዋቀዮት እየተን፤","poem":1},{"text":"እንስ ዽጵነሳኒ ኬሳ እሳን ባሴ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እን ዱቢሳ ኤርጌ እሳን ፈይሴ፤","poem":1},{"text":"አዋለ ኬሳስ እሳን ባሴ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"እሳን ሰበቢ ጃለለሳ ከን ህንጌደረምኔ ሰናቲፊ","poem":1},{"text":"ሆጂ ድንቂ ከን እን እልማን ነማቲፍ ሆጄቴ ሰናቲፍ፣ዋቀዮን ሃገለቴፈተን!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ኣርሳ ገለታ ሃዽኤሰን፤","poem":1},{"text":"ፋርፈትና ገመቹቲንስ ሆጂሳ ሃህመን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"እሳን ኬሳ ቶኮ ቶኮ ዶኒዻን ገላነረ ዴመኒ","poem":1},{"text":"ብሻኖተ ጉርጉዳረት ደልደለን።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"እሳንስ ሆጂ ዋቀዮቲፊ","poem":1},{"text":"ሆጂሳ ድንቅሲሳ ሰነ ቱጁበ ኬሰት አርገን።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"እን ዱበቴ ቡቤ ጀባ","poem":1},{"text":"ደምበሊ ገላና ኦል ፉዹ ቶኮ ካሴራቲ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"እሳን ሰሚት ኦል በአኒ ቱጁበት ገድ ቡአን፤","poem":1},{"text":"ረክነሳኒ ኬሰትስ አብዲ ኩተተን።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"አከ ነመ መቻኤ ደደርበተመኒ ገተንተረን","poem":1},{"text":"ኦጉማን እሳንስ ፋይዳ ዸቤ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"እሳን ረክነሳኒ ኬሰት ዋቀዮት እየተን፤","poem":1},{"text":"እንስ ዽጵነሳኒ ኬሳ እሳን ባሴ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"እን አከ ደምበሊን ሱን ቀበናኡፍ","poem":1},{"text":"ዸኣ ገላና ጨልእሲሴ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"እሳን ዋን ደምበሊፊ ዸኣን ገላና ሱን ጨልእሰኒፍ ንገመደን፤","poem":1},{"text":"ሃለ ከናንስ ገረ ቁበተ ዶኒ በርባደኒት እሳን ጌሴ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"እሳን ሰበቢ ጃለለሳ ከን ህንጌደረምኔ ሰናቲፊ","poem":1},{"text":"ሆጂ ድንቂ ከን እን እልማን ነማቲፍ ሆጄቴ ሰናቲፍዋቀዮን ሃገለቴፈተን።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ወልዳ ነሞታ ኬሰት እሰ ሃሌልሰን፤","poem":1},{"text":"ወል ገኢ ማንጉዶታ ኬሰትስ እሰ ሃጀጀን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"እንስ ለጎተ ገሞጂ ታስሴ","poem":1},{"text":"ቡርቃወን ብሻንስ ገረ ለፈ ጎጎጋት ጌደሬ፤","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ሰበቢ ሀምነ ወረ አች ጅራተኒቲፍ፣","poem":1},{"text":"ብየ ምዻን ባሱ ለፈ ሶግዳ ታስሴ።","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ገሞጂ ኩሳ ብሻኒት፣","poem":1},{"text":"ለፈ ጎጎጋሞ ቡርቃ ብሻኒት ጌደሬ፤","poem":2}]},{"type":"verse","number":36,"content":[{"text":"እን አከ ወር ቤለአን አች ጅራተን ጎዼ፤","poem":1},{"text":"እሳንስ መጋላ ኬሰ ጅራተን እጃረተን።","poem":2}]},{"type":"verse","number":37,"content":[{"text":"ለፈ ቆቲሳሳኒ ፈጫፈተኒ ወይኒስ ንዻበተን፤","poem":1},{"text":"ምዻን ጋሪስ አርገተን።","poem":2}]},{"type":"verse","number":38,"content":[{"text":"እን እሳን ኤብሴ፤ ባይእነሳኒስ አከ መሌ ደበሌ፤","poem":1},{"text":"አከ ሎንሳኒ ለኮብሳን የረቻ ዴመን ህንጎኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"ዬሮ እሳን ጩንቁርሳዻን፣ ረክናፊ","poem":1},{"text":"ገዳን ጥናተኒ ገድ ዴብአንት፣","poem":2}]},{"type":"verse","number":40,"content":[{"text":"እን ነሞተ ቤቤከሞረት ቱፊ ሮብሴ","poem":1},{"text":"አከ እሳን ገሞጂ ከራ ህንቀብኔ ኬሰ ጆረን ጎዼ።","poem":2}]},{"type":"verse","number":41,"content":[{"text":"እን ገሩ ረከቶተ ዽጵነሳኒ ኬሳ ባሴ፤","poem":1},{"text":"ማቲ እሳንስ አኩመ ቡሻዬ ባይእሴ።","poem":2}]},{"type":"verse","number":42,"content":[{"text":"ቀጄልቶትን ዋን ከነ አርገኒ እልልቹ፤","poem":1},{"text":"ሀሞን ሁንድኑ ገሩ አፋን ቀበቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"ኦጌስ ከምዩ ዋን ከነ ያደት ሃቀበቱ፤","poem":1},{"text":"ጃለለ ዋቀዮ ከን ዹመ ህንቀብኔ ሰነሌ ሃሁበቱ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/107.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/108.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/106.json","previousChapterAudioLinks":{},"numberOfVerses":43}