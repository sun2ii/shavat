{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":108,"content":[{"type":"hebrew_subtitle","content":["ፋርፈትና ዳዊት።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቅ፣ ገራንኮ ህንራፈሙ፤ አን ነንፋርፈዸ፤","poem":1},{"text":"ሉቡኮ ጉቱዻንስ ስን ገለቴፈዸ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ያ ክራራፊ በገና ደመቃ!","poem":1},{"text":"አንስ ገነማን ነንደመቀ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ያ ዋቀዮ፣ አን ሰቦተ ግዱት ገለተ ሲፍ ነንገልቸ፤","poem":1},{"text":"ነሞተ ግዱትስ ዋኤኬ ነንፋርፈዸ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጃለልኬ ጉዳዸ፤ ሰሚወንስ ጫላ ኦል ዼራዻቲ፤","poem":1},{"text":"አመነሙማንኬስ ሰሚወን ቀቀበ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ያ ዋቅ፣ አት ሰሚወኒን ኦልት ኦል ኦል ጄዽ፤","poem":1},{"text":"ኡልፍንኬስ ለፈ ሁንደረ ሃጅራቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"አከ ወር አት ጃለቱ ፉረመኒፍ፣","poem":1},{"text":"ሀርከኬ ምርጋቲን ኑ ኦልች፤ ኑ ገርጋርስ፤","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዋቅን እዶ ቁልቁሉማሳቲ አከነ ጄዼ ዱበቴረ፦","poem":1},{"text":"“አን ገመቹዻን ሼኬምን ገርገር ነንቆደ፤","poem":2},{"lineBreak":true},{"text":"ሱሉለ ሱኮትስ ነንሰፈረ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ግልኣድ ከንኮት፤ ምናሴንስ ከንኮት፤","poem":1},{"text":"ኤፍሬም ጎንፎ ስቢላኮት፤","poem":2},{"lineBreak":true},{"text":"ይሁዳንስ ቦኩ ሞቱማኮት።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሞኣብ ጫቢ ዽቀትናኮት፤","poem":1},{"text":"ኤዶምራ ኮጴኮ ደርበዼ ነንቡሰ፤","poem":2},{"lineBreak":true},{"text":"ፍልስጤምረትስ ሞአናዻን ነንጌረረ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ኤኙቱ መጋላ ጀቤፈምቴ እጃረምቴት ነ ፍደ?","poem":1},{"text":"ኤኙቱ ኤዶምት ነ ጌሰ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ያ ዋቅ ከን ኑ ገቴ፣","poem":1},{"text":"ከን ሎልቶተኬኘ ወጅን በኡ ድዴስ ሱመ ምቲ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዲነኬኘ ኦፍራ ዾዉ ኑ ገርጋር፣","poem":1},{"text":"ገርጋርስ ነማ ፋይዳ ህንቀቡቲ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኑ ዋቀ ወጅን ንሞአትነ፤","poem":1},{"text":"እንስ ዲኖተኬኘ ገድ ዽዺተ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}