e":"verse","number":8,"content":[{"text":"ኡሙሪንሳ ሃገባበቱ፣","poem":1},{"text":"ኣንጎሳ ነምን ብራ ሃፉዸቱ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እጆሌንሳ አባ መሌ ሃሀፈን፤","poem":1},{"text":"ኒቲንሳስ ሃዸ ህዬሳ ሃታቱ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እጆሌንሳ ከዸቶተ አሲፊ አች ጆረን ሃተአን፤","poem":1},{"text":"መነሳኒ ዲገማ ኬሳሌ ሃአርአመን።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዋን እን ቀቡ ሁንደ ነምን እሰራ ልቂ ቀቡ ሃፉዸቱ፤","poem":1},{"text":"ቡኣ ደዸቢሳሌ ከራ አዴምቶትን ሃሳመን።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ነምን ቶኮዩ እሳፍ ህንነእን፣","poem":1},{"text":"ዮካን እጆሌሳ ከኔን አባ ህንቀብኔፍ ገራ ህንላፍን።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሰኚንሳ ሃዹሙ፤","poem":1},{"text":"መቃንሳኒ ዸሎተ እት ኣኑ ኬሳ ሃበሌፈሙ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"በሌሳን አቦቲሳ ፉለ ዋቀዮ ዱረት ሃያደተሙ፤","poem":1},{"text":"ጩቡን ሃዸሳስ ህንሀቀምን።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አከ እን ሴናሳኒ ለፈራ በሌሱፍ፣","poem":1},{"text":"ጩቡንሳኒ ዬሮ ሁንደ ፉለ ዋቀዮ ዱረ ሃጅራቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"እን ህዬዪፊ ረከቶተ፣","poem":1},{"text":"ወረ ገራንሳኒ መዳኤስ ሀመ ዱኣት ጉግሴ መሌ","poem":2},{"lineBreak":true},{"text":"ገራሳኒፍ ላፉ ህንያድኔቲ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እን አባሩ ጃለቴ፤","poem":1},{"text":"አባርስ ሱን እሱመት ሃዴብኡ፤","poem":2},{"text":"እን ኤብሱ ህንጃለትኔ፤","poem":1},{"text":"ኤብስ እሰራ ሃፈጋቱ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እን አኩመ ኡፈተሳት አባርሰ ኡፈተ፤","poem":1},{"text":"አባርስስ አኩመ ብሻኒ ዸግነሳ ሴነ፤","poem":2},{"lineBreak":true},{"text":"አኩመ ዘይቲስ ለፌሳ ልጠ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አባርስ ሱን አኩመ ኡፈተ እን እቲን ኦፍ ሀጉጉ፣","poem":1},{"text":"ሰበተ እን ዬሮ ሁንደ ህዸቱስ እሰት ሃተኡ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ከፈልቲን ዋቀዮ ወረ ነ ህመተኒፊ","poem":1},{"text":"ወረ ጅሬኘኮረት ዋን ሀማ ዱበተኒፍ ከፈሉ ከኑመ ሃተኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ያ ዋቀዮ ጎፍታ፣","poem":1},{"text":"አት ገሩ መቃኬቲፍ ጄዺ ነ ገርጋር፤","poem":2},{"lineBreak":true},{"text":"ጋሩማ ጃለለኬቲቲፍ ጄዺቲ ነ ኦልች።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"አን ህዬሳፊ ረከታዻቲ፤","poem":1},{"text":"ገራንኮስ ነ ኬሰት መዳኤረ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"አን አኩመ ጋድዱ ገልገላ በዴረ፤","poem":1},{"text":"አኩመ ሀዋንሳስ ኦሊ ገድ ኦፈሜረ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ጅልብኮ ሶሙዻን ደዸቤረ፤","poem":1},{"text":"ዸግንኮስ ሁቀቴ ለፌት በኤረ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"አን ወረ ነ ህመተን ብረት ዋን ቱፊ ተኤረ፤","poem":1},{"text":"እሳን ዮሙ ነ አርገን መታሳኒ ራሱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ያ ዋቀዮ ዋቀኮ፣ ነ ገርጋር፤","poem":1},{"text":"አኩመ ጃለለኬቲትስ ነ ኦልች።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ያ ዋቀዮ፣ አከ ወን ኩን ሀርከኬ ተኤ፣","poem":1},{"text":"አከ አት ዋን ከነ ሆጄቴ እሳን ሃቤከን።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"እሳን ንአባሩ፤ አት ገሩ ንኤብፍተ፤","poem":1},{"text":"ዮሙ ነት ከአን እሳን ንቃነኡ፤","poem":2},{"lineBreak":true},{"text":"ተጃጅላንኬ ገሩ ንገመደ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ህመቶትንኮ ሰልጵነ ሃኡፈተን፤","poem":1},{"text":"አኩመ ነመ ዋሮ ኡፈቱት ቃኒዻን ሃሀጉገመን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"አን አፋንኮቲን ጉድሴ ዋቀዮን ነንገለቴፈዸ፤","poem":1},{"text":"ወልዳ ጉዳ ግዱትስ እሰ ነንጀጀዸ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"እንስ ወረ ሉቡሳት ሙረን ጀላ እሰ ባሱፍ ጄዼ፣","poem":1},{"text":"ከራ ሀርከ ምርገ ረከታቲን ዻበታቲ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}