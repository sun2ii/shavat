{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።"]},{"type":"verse","number":1,"content":[{"text":"አን ዋቀዮት ኮሉ ገሌረ።","poem":1},{"text":"ዮስ እስን አከምት ሉቡኮቲን አከነ ጄቹ ደንዴሱ፦","poem":2},{"lineBreak":true},{"text":"“አት አኩመ ስምብሮ ቱሉኬት በርስ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ኩኖ ነሞትን ሀሞን እዳሳኒ ደብሰተኒሩ፤","poem":1},{"text":"እሳን ወረ ቶሎተ ተአን፣","poem":2},{"text":"ዱከነ ኬሰ ወራኑፍ ጄዸኒ፣","poem":1},{"text":"ጥየሳኒ ርቡት ዻበተኒሩ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዮ ሁንዴወን ዲገመን፣ ነምን ቀጄላን","poem":1},{"text":"ማል ጎቹ ደንደአ?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ዋቀዮ መነ ቁልቁሉማሳ ቁልቁሉ ሰነ ኬሰ ጅረ፤","poem":1},{"text":"ቴሶን ዋቀዮ ሰሚረ ጅረ።","poem":2},{"text":"እን እልማን ነሞታ ንእላለ፤","poem":1},{"text":"እጅሳስ ነሞተ ንቆረ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዋቀዮ ቀጄልቶታፊ ጀልኦተ ንቆረ፤","poem":1},{"text":"ሉቡንሳ ገሩ ነመ ጎሊ ጃለቱ ንጅብት።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እን ሀሞተረት፣ በርበዳ እብዳቲፊ","poem":1},{"text":"ድኚ ቦበኡ ንሮብሰ፤","poem":2},{"lineBreak":true},{"text":"ቆድንሳኒስ ቡቤ ፍኒናዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ዋቀዮ ዋን ቀጄላ ተኤፍ፣","poem":1},{"text":"ሙርቲ ቀጄላ ጃለተ፤","poem":2},{"lineBreak":true},{"text":"ቶሎንስ ፉለሳ ንአርጉ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}