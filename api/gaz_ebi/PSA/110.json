ን ሬፈ ቱሉዻን፣ ቡልችቶተ ጉቱማ ለፋ","poem":1},{"text":"በርበዴሱዻን ሰቦተት ሙረ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እንስ ለገ ከራ ጭነ ጅሩ ኬሳ ንዹገ፤","poem":1},{"text":"ከናፉ መታ ኦል ቀበተ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}