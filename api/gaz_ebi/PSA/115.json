{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"ኑፍ ምት፤ ያ ዋቀዮ፣ ኑፍ ምት፤","poem":1},{"text":"ገሩ ጃለላፊ አመነሙማኬቲፍ ጄዺቲ","poem":2},{"lineBreak":true},{"text":"መቃኬቲፍ ኡልፍነ ኬን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ሰቦትን ማሊፍ፣","poem":1},{"text":"“ዋቅንሳኒ ኤሰ ጅረ?” ጄዹ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዋቅንኬኘ ሰሚ ኬሰ ጅረ፤","poem":1},{"text":"እን ዋን እሰ ገመቺሱ ከምዩ ንሆጄተ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዋቆንሳኒ ቶልፈሞን ገሩ ሜቲፊ","poem":1},{"text":"ወርቄ ሀርከ ነማቲን ሆጄተመኒዸ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እሳን አፋን ቀቡ፤ ገሩ ዱበቹ ህንደንደአን፤","poem":1},{"text":"እጀስ ቀቡ፤ ገሩ አርጉ ህንደንደአን፤","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ጉረ ቀቡ፤ ገሩ ዸገኡ ህንደንደአን፤","poem":1},{"text":"ፉኛን ቀቡ፤ ገሩ ፉንፈቹ ህንደንደአን፤","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሀርከ ቀቡ፤ ገሩ ቀቀበቹ ህንደንደአን፤","poem":1},{"text":"ሚለ ቀቡ፤ ገሩ ዴሙ ህንደንደአን፤","poem":2},{"lineBreak":true},{"text":"ላጋሳኒ ኬሰትስ ሰገሌ