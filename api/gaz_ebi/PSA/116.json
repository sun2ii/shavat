"verse","number":8,"content":[{"text":"አት ያ ዋቀዮ ሉቡኮ ዱአራ፣","poem":1},{"text":"እጀኮ እምማንራ፣","poem":2},{"lineBreak":true},{"text":"ሚለኮ ጉፈቹራ ዋን ኦልችቴፍ፣","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አን ብየ ወረ ጅራቶ ኬሰ፣","poem":1},{"text":"ፉለ ዋቀዮ ዱረ ነንጅራዸ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አን ዬሮ፣ “አን ባይኤ ዽጰዼረ” ጄዼት፣","poem":1},{"text":"አመንቲኮ ኤገዼረ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አን ዮሙን ቡርጃጀኤት፣","poem":1},{"text":"“ነምን ሁንድኑ ሶብዱዸ” ነንጄዼ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ዋን ጋሪ እን ና ጎዼ ሁንዳፍ፣","poem":1},{"text":"አን ዋቀዮፍ ማለን ዴብሰ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አን ጦፎ ፈይና ኦል ካሴ","poem":1},{"text":"መቃ ዋቀዮ ነንዋመዸ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ፉለ ሰበሳ ሁንዱማ ዱረት፣","poem":1},{"text":"አን ወሬገኮ ዋቀዮፍ ነንገልቸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ዱት ቁልቁሎተሳ፣","poem":1},{"text":"ፉለ ዋቀዮ ዱረት ኡልፍነ ቀበ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ያ ዋቀዮ፣ አን ዹጉማን ተጃጅላኬት፤","poem":1},{"text":"አን ተጃጅላኬ እልመ ተጃጅልቱኬቲት፤","poem":2},{"lineBreak":true},{"text":"አት ፎንጫኮ ነራ ሂክቴርተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"አን ኣርሳ ገለታ ሲፍ ነንዽኤሰ፤","poem":1},{"text":"መቃ ዋቀዮስ ነንዋመዸ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እዶ ሰብንሳ ሁንድ ጅሩት፣","poem":1},{"text":"አን ወሬገኮ ዋቀዮፍ ነንገልቸ፤","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ያ ዬሩሳሌም ስ ኬሰት፣","poem":1},{"text":"ኦብዲ መነ ዋቀዮረትስ ነንገልቸ።","poem":2},{"lineBreak":true},{"text":"ሃሌሉያ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}