{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት ከን አከ ስርነ ሸሚኒቲት ፋርፈተሙ።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ፣ ነምን ዋቀ ሶዳቱ ህንጅሩቲ አት ነ ገርጋር፤","poem":1},{"text":"እልማን ነማ ኬሳስ ነምን አመነሙ ዸበሜራቲ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ነምን ሁንድኑ ኦላሳት ሶበ ዱበተ፤","poem":1},{"text":"እሳን ነመ ሳደኒ ገራ ለማን ዱበቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ዋቀዮ አፋን ነመ ሳዱ ሁንደ፣","poem":1},{"text":"አረበ ኦፍ ቱሉ ሁንደስ ሃኩኩቱ፤","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እሳንስ፣ “ኑ አረበኬኛን ንሞነ፤","poem":1},{"text":"ህዺንኬኘስ ኬኙመ፤","poem":2},{"lineBreak":true},{"text":"ኤኙቱ ኑረት ጎፍቱማ ቀበ?” ጄዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ዋቀዮ፣ “አን ሰበቢ ሀጩጨሙ ህዬዪቲፍ፣","poem":1},{"text":"ሰበቢ ኣዱ ረከቶታቲፍስ አመ ነንከአ።","poem":2},{"lineBreak":true},{"text":"ነጋ እሳን ሀወን ኬሰስ እሳን ነንጅራችሰ” ጄዸ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዱቢን ዋቀዮ ህርእነ ህንቀቡ፤","poem":1},{"text":"እንስ አከ ሜቲ ቦለ እብዳ ኬሰት በቅፈሜ","poem":2},{"lineBreak":true},{"text":"ዬሮ ቶርበ ቁልቁሌፈሜት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ያ ዋቀዮ አት ኑ ኤግደ፤","poem":1},{"text":"ዸሎተ አከናራስ በረ በራን ኑ ኦልችተ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዬሮ ወን ፋይዳ ህንቀብኔ እልማን ነማ ግዱት ከበጀሙት","poem":1},{"text":"ሀሞን ኦፍ ዺቡዻን ከለቲ ሁንዳን አሲፊ አች ናነኡ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}