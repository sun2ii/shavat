{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":132,"content":[{"type":"hebrew_subtitle","content":["ፋርፈትና ኦል በኡ።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ፣ ዳዊቲፊ","poem":1},{"text":"ረክነ እን ኦብሴ ሁንዱማ ያደዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"እን ከኩ ቶኮ ዋቀዮፍ ከከቴ","poem":1},{"text":"ዋቀ ያቆብ ጀባ ሰናፍ አከነ ጄዼ ወሬጌ፦","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“አን መነኮ ኦል ህንሴኑ፤","poem":1},{"text":"ዮካን ስሬኮት ኦል ህንበኡ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አን እጀኮቲፍ ህርበ፣","poem":1},{"text":"ባሌ እጀኮቲቲፍሞ ሙጋቲ ህንኤየሙ፤","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኩንስ ሀመ አን ዋቀዮፍ እዶ አርጉት፣","poem":1},{"text":"ዋቀ ያቆብ ጀባ ሰናፍ እዶ ጅሬኛ አርጉት።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ኩኖ፣ ኤፍራታት ዋኤሳ ዸጌኜ፤","poem":1},{"text":"ያኣርትስ እሰ አርገትኔ፦","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“ኮታ እዶ ጅሬኘሳ ዸቅና፤","poem":1},{"text":"ኤጄተ ሚለሳ ጀለትስ ኩፍኔ ዋቄፈትና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"‘ያ ዋቀዮ ከኢቲ፣ ገረ እዶ ቦቆናኬቲ ኮቱ፤","poem":1},{"text":"አቲፊ ታቦትን ጀብነኬቲስ ኮታ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሉቦትንኬ ቀጄሉማ ሃኡፈተን፤","poem":1},{"text":"ቁልቁሎትንኬስ ገመቹዻን ሃፋርፈተን።’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ሰበቢ ገርብቸኬ ዳዊቲፍ ጄዺቲ፣","poem":1},{"text":"ድበማኬ ህንገትን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ዋቀዮ አከነ ጄዼ ከኩ ዹጋ ቶኮ ዳዊቲፍ ከከቴረ፤","poem":1},{"text":"እን ከኩ ከነራ ዱበት ህንዴብኡ፦","poem":2},{"lineBreak":true},{"text":"“አን እልማንኬ ኬሳ እሰ ቶኮ ቴሶኬረ ነንቴስሰ፤","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዮ እልማንኬ ከኩኮፊ ሴረ አን እሳን በርሲሱ ኤገን፣","poem":1},{"text":"እልማንሳኒስ አከሱመ በረ በራ ሀመ በረ በራትቴሶኬረ ንታኡ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ዋቀዮ ጥዮንን ፍለቴራቲ፤","poem":1},{"text":"አከ እሼን እዶ ጅሬኘሳ ታቱስ ፌዼ አከነ ጄዼረ፦","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“ኩን በረ በራ ሀመ በረ በራት እዶ ጅሬኛኮት፤","poem":1},{"text":"ከነስ አን ዋነን ፌዼፍ፣ አስ ነንጅራዸ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አን ዋን ሁንዳን እሼ ነንኤብሰ፤","poem":1},{"text":"ህዬዪሼሌ ቡዴነ ነንቁብሰ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሉቦተሼት ፈይነ ነንኡፍሰ፤","poem":1},{"text":"ቁልቁሎንሼስ ገመቹዻን ንፋርፈቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“አን አችት አከ ጋንፍ ቶኮ ዳዊቲፍ ብቅሉ ነንጎዸ፤","poem":1},{"text":"ድበማኮፍስ እብሳ ቆጴሴረ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዲኖተሳት ቃኒ ነንኡፍሰ፤","poem":1},{"text":"ጎንፎን መታሳራ ገሩ ንእፈ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}