{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":135,"content":[{"type":"verse","number":1,"content":[{"text":"ሃሌሉያ።","poem":1},{"lineBreak":true},{"text":"መቃ ዋቀዮ ጀጀዻ፤","poem":1},{"text":"እስን ገርቦን ዋቀዮ እሰ ገለቴፈዻ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እስን ወር መነ ዋቀዮ ኬሰ፣","poem":1},{"text":"ኦብዲ መነ ዋቀኬኛ ኬሰ ተጃጅልተን፣ እሰ ገለቴፈዻ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ዋቀዮ ጋሪዻቲ፣ ዋቀዮን ገለቴፈዻ፤","poem":1},{"text":"እን አርጃዻቲ መቃሳቲፍ ፋርፈዻ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዋቀዮ ያቆብን ኦፊሳቲፍ፣","poem":1},{"text":"እስራኤልንሞ ዻለ ዹንፋሳ ጎዼ ፍለቴራቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"አን አከ ዋቀዮ ጉዳ ተኤ፣","poem":1},{"text":"አከ ጎፍታንኬኘ ዋቆተ ሁንደ ጫላ ጉዳ ተኤ ቤከ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዋቀዮ ሰሚወን ኬሰቲፊ ለፈረት፣","poem":1},{"text":"ገላኖታፊ ቱጁበሳኒ ሁንደ ኬሰት፣","poem":2},{"lineBreak":true},{"text":"ዋን እሰ ገመቺሱ ከምዩ ንሆጄተ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እን አከ ዱሜሶን ዳሪ ለፋቲ ከአን ንጎዸ፤","poem":1},{"text":"ቦካ ወጅን በለቄ ኤርገ፤","poem":2},{"lineBreak":true},{"text":"ጎምብሳሳ ኬሳስ ቡቤ ገድ ባሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"እን ሀንገፎተ ግብጥ፣","poem":1},{"text":"ከን ነማቲፊ ከን ሆሪ ንዸኤ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ያ ግብጥ፣ እን ግዱኬት፣","poem":1},{"text":"ፈረኦኒፊ ተጃጅልቶተሳ ሁንደት መለቶፊ ድንቂሳ ኤርጌረ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እን ሰቦተ ባይኤ ዸኤ","poem":1},{"text":"ሞቶተ ጀጀቦ አጄሴ፤","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ስሆን ሞቲ ወረ አሞሮታ፣","poem":1},{"text":"ኦግ ሞቲ ባሻኒፊ ሞቶተ ከነኣን ሁንደ ንአጄሴ፤","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ለፈሳኒ ዻለ ጎዼ","poem":1},{"text":"አከ ዻለሳኒ ተኡፍስ ሰበሳ እስራኤሊፍ ኬኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ያ ዋቀዮ፣ መቃንኬ በረ በራን ጅራተ፤","poem":1},{"text":"ያ ዋቀዮ፣ አት ዸሎተ ሁንደ ኬሰት ንያደተምተ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዋቀዮ ሰበሳቲፍ ንፈልመ፤","poem":1},{"text":"ተጃጅልቶተሳቲፍስ ገራ ላፈ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ዋቆትን ቶልፈሞን ነሞተ ኦርማ ሜቲፊ","poem":1},{"text":"ወርቄ ሀርከ ነማቲን ሆጄተመኒዸ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እሳን አፋን ቀቡ፤ ገሩ ዱበቹ ህንደንደአን፤","poem":1},{"text":"እጀስ ቀቡ፤ ገሩ አርጉ ህንደንደአን፤","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ጉረ ቀቡ፤ ገሩ ዸገኡ ህንደንደአን፤","poem":1},{"text":"ዮካን ሀፉር ቶኮዩ አፋንሳኒ ኬሰ ህንጅሩ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ወር እሳን ቶልቸን ከኔን እሳን አመነተን ሁንድ","poem":1},{"text":"አኩመሳኒ ተኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ያ መነ እስራኤል ዋቀዮን ኤብሳ፤","poem":1},{"text":"ያ መነ አሮን ዋቀዮን ኤብሳ፤","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ያ መነ ሌዊ ዋቀዮን ኤብሳ፤","poem":1},{"text":"እስን ወር እሰ ሶዳተንስ፣ ዋቀዮን ኤብሳ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዋቀዮ እን ዬሩሳሌም ኬሰ ጅራቱ ሱን፣","poem":1},{"text":"ጥዮንራ ሃኤብፈሙ።","poem":2},{"lineBreak":true},{"text":"ሃሌሉያ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}