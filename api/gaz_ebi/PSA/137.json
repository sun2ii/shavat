{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"ኑ ዬሮ ጥዮንን ያደኔት፣","poem":1},{"text":"ለጌን ባብሎን ብረ ቴኜ ቦኜ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አችትስ ክራረኬኘ","poem":1},{"text":"ሙከ አለልቱት ፈንፍኔ፤","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አችት ወር ኑ ቦጅአን ፋርፈትና፣ ወር ኑ ዽጵሰንስ፣","poem":1},{"text":"“ፋርፈናወን ጥዮን ኬሳ ቶኮ ኑ ፋርፈዻ!”","poem":2},{"lineBreak":true},{"text":"ጄዸኒ አከ ኑ ፋርፈትና ገመቹ እሳኒፍ ፋርፈትኑ ኑ ጋፈተን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ኑ ኡቱ ብየ ኦርማ ጅሩ፣","poem":1},{"text":"አከምት ፋርፈትና ዋቀዮ ፋርፈቹ ደንዴኘ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ያ ዬሩሳሌም፣ ዮ አን ስ እራንፈዼ፣","poem":1},{"text":"ሀርክኮ ምርጋ ኦጉማሳ ሃእራንፈቱ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዮ አን ስ ያደቹ ባዼ፣","poem":1},{"text":"ዮ አን ገመቹኮ ጉድቻ ኦልት","poem":2},{"text":"ዬሩሳሌምን እላሉ ባዼ፣","poem":1},{"text":"አረብንኮ ላጋኮት ሃመጠኑ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ያ ዋቀዮ፣ ዋን ወር ኤዶም","poem":1},{"text":"ጋፈ ዬሩሳሌም ዲገምቴ ጄዸን ሰነ ያደዹ፤","poem":2},{"text":"እሳንስ፣ “እሼ ዲጋ!","poem":1},{"text":"ሀመ ሁንዴሼት እሼ ዲጋ!” ጄዸኒ እየን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ያ እንተለ ባብሎን፣ ከን በዱዻፍ ቆጶፍቴ፣","poem":1},{"text":"እን ዋን አት ኑ ጎቴ ሰናፍ፣","poem":2},{"lineBreak":true},{"text":"ገቲኬ ሲፍ ኬኑ ኤብፈማዸ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እን ዳእመንኬ ቀቤ","poem":1},{"text":"ዸጋረት ጨጨብሱ ሱን ኤብፈማዸ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}