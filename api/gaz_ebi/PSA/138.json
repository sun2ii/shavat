content":[{"text":"አን ረክነ ኬሰ ጅራዹዩ፣","poem":1},{"text":"አት ሉቡኮ ንኤግደ፤","poem":2},{"text":"ኣሪ ዲነኮት ሀርከኬ ንድሪርስተ፤","poem":1},{"text":"ሀርከኬ ምርጋቲንስ ነ ኦልችተ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዋቀዮ ካዮሳ ፊጣን ና ባሰ፤","poem":1},{"text":"ያ ዋቀዮ፣ ጃለልኬ በረ በራን ጅራተ፤","poem":2},{"lineBreak":true},{"text":"ሆጂ ሀርከኬቲ ህንገትን።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}