{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":139,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ፣ አት ነ ቆርቴርተ፤","poem":1},{"text":"ነ ቤክቴርተስ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አት ዬሮ አን ገድ ታኡፊ ዬሮ አን ኦል ከኡ ንቤክተ፤","poem":1},{"text":"ያደኮስ ፈጎት ሁበተ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዴሙኮፊ ጪሱኮ አዳን ባፍቴ ቤክተ፤","poem":1},{"text":"ከራኮ ሁንደስ ቤክተ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ያ ዋቀዮ፣ አከ ዱቢን ቶኮዩ አረበኮ ህንጅሬ፣","poem":1},{"text":"አት ጉቱማን ጉቱት ንቤክተ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አት ዱራፊ ዱባን ነ መርስቴርተ፤","poem":1},{"text":"ሀርከኬስ ነረ ኬሴርተ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ቤኩምስ አከና አናፍ አከ መሌ ድንቂዸ፤","poem":1},{"text":"ሁበቹፍስ አከ መሌ ነራ ፈጎዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ሀፉረኬ ብራ አን ኤሰ ዸቁን ደንደአ?","poem":1},{"text":"ፉለኬ ዱራስ አን ኤሰት በቀቹን ደንደአ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዮ አን ሰሚወንት ኦል በኤ፣ አት አች ጅርተ፤","poem":1},{"text":"ዮ አን ስሬኮ ሲኦል ኬሰ ዻበዼስ፣ አችስ ንጅርተ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዮ አን ቆቾ ገነማቲን","poem":1},{"text":"በርሴ ቀርቀረ ገላና ፈጎረ ቁበዼ፣","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አችትስ ሀርክኬ ከራ ነ አርግሲሰ፤","poem":1},{"text":"ሀርክኬ ምርጋስ ጀቤሴ ነ ቀበ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዮ አን፣ “ዹጉማን ዱከን ነ ዾክሰ፤","poem":1},{"text":"እፍንስ ናኖኮት ሀልከን ተአ” ጄዼ፣","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዱከንዩ ሲፍ ዱከነ ህንተኡ፤","poem":1},{"text":"ሀልከንስ አኩመ ጉያ እፈ፤","poem":2},{"lineBreak":true},{"text":"ዱከን ሲፍ አኩመ እፋቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"አት ነሙማኮ እሰ ኬሳ ኡምቴርታቲ፤","poem":1},{"text":"ገደሜሰ ሃዸኮ ኬሰትስ ነ ቶልችቴ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አን ሰበቢ ሃለ ሶዳችሳፊ ድንቅሲሳዻን ኡመሜፍ","poem":1},{"text":"ስን ገለቴፈዸ፤","poem":2},{"text":"ሆጂንኬ ድንቅሲሳዸ፤","poem":1},{"text":"ከነስ አን አከ ጋሪተን ቤከ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዬሮ አን እዶ ዾክሳት ኡመሜ፣","poem":1},{"text":"ለፌንኮ ስ ዱራ ህንዾከትኔ።","poem":2},{"lineBreak":true},{"text":"ዬሮ አን ዽዽመ ለፋ ኬሰት ቶልፈሜ፣","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እጅኬ ዸግነኮ ከን ህንቶልፈምን አርጌ።","poem":1},{"text":"ጉዮትን ዱራን ዱርሰኒ ናፍ ሙርቴፈመን ሁንድኡቱ ህንጅራትን፣","poem":2},{"lineBreak":true},{"text":"ክታበኬ ኬሰት በሬፈመኒሩ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ያ ዋቅ፣ ያደኬ ሁበቹን አከም ኡልፋተ!","poem":1},{"text":"ባይእንሳስ አከም ጉዳዸ!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ኡቱ አን እሳን ለካኤ ጅራዼ፣","poem":1},{"text":"ስላ ለኮብስሳኒ ጭረቸረ ባይአተ።","poem":2},{"lineBreak":true},{"text":"አን ዬሮን ደመቁት፣ አመዩ ሱመ ወጅነን ጅረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ማሎ ያ ዋቅ፣ አት ኡቱ ሀሞተ ፍጤ!","poem":1},{"text":"ወር ዺገ ነማ ዸንገላፍተን፣ ነራ ፈጋዻ!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እሳን ያደ ሀማዻን ዋኤኬ ዱበቱ፤","poem":1},{"text":"ዲኖትንኬ አከሱማን መቃኬ ዸኡ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ያ ዋቀዮ፣ አን ወረ ስ ጅበን ህንጅቡ?","poem":1},{"text":"ወረ ስት ከአንስ ህንጥሬፈዹ?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"አን ሀመ ዹማት እሳን ጅቤረ፤","poem":1},{"text":"አከ ዲነኮትስ እሳን ነንሄደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ያ ዋቅ፣ ነ ሰከተእ፤ ገራኮስ ቤክ፤","poem":1},{"text":"ቆሪቲ ነ እላል፤ ያደኮስ ቤክ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዮ ከራን ሀምና ነ ኬሰ ጅራቴ ሜ እላል፤","poem":1},{"text":"ከራ በረ በራረስ ነ አዴምስስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}