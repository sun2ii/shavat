{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።"]},{"type":"verse","number":1,"content":[{"text":"ጎዋን ገራሳት፣","poem":1},{"text":"“ዋቅን ህንጅሩ” ጄዸ።","poem":2},{"text":"እሳን ጡራአኒሩ፤ ሆጂንሳኒስ ጅብሲሳዸ፤","poem":1},{"text":"ነምን ዋን ጋሪ ሆጄቱ ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ዋቀዮ ዮ ነምን ዋ ሁበቱ፣","poem":1},{"text":"ከን ዋቀስ በርባዱ፣ ቶኮዩ ጅራቴ አርጉፍ ጄዼ፣","poem":2},{"lineBreak":true},{"text":"ሰሚራ እልማን ነሞታ ገድ እላለ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሁንድኑ ዶጎጎረኒሩ፤ ሁንድሳኒስ ጡራአኒሩ፤","poem":1},{"text":"ነምን ዋን ጋሪ ሆጄቱ ቶኮ ህንጅሩ፤","poem":2},{"lineBreak":true},{"text":"ቶኩምትዩ ህንጅሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ወር ሀምነ ሆጄተን","poem":1},{"text":"ከኔን አኩመ ዋን ቡዴነ ኛተኒት ሰበኮ ኛተን፣","poem":2},{"lineBreak":true},{"text":"ወር ዋቀዮን ህንዋመትኔ ሁንድኑ ሆማ ህንቤከኒ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እሳን ሶዳዻን ልቅምፈመኒሩ፤","poem":1},{"text":"ዋቅን ዸሎተ ቀጄልቶታ ወጅን ጅራቲ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እስን ጀልኦትን ከሮረ ህዬዪ ጀላ ፈሸሌስቱ፤","poem":1},{"text":"ዋቀዮ ገሩ ደኦሳኒት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ማሎ ኡቱ ጥዮን ኬሳ ፈይን እስራኤሊፍ ዹፌ!","poem":1},{"text":"ዮሙ ዋቀዮ ሰበሳ ወረ ቦጅአመን ዴብሱት፣","poem":2},{"lineBreak":true},{"text":"ያቆብ ሃእልልቹ፤ እስራኤልስ ሃገመዱ!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}