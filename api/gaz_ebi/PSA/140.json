{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":140,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ፣ ነሞተ ሀሞ ጀላ ነ ባስ፤","poem":1},{"text":"ነሞተ ፍንጭልቶተ","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ወረ ገራሳኒ ኬሰት ሀምነ ያደኒ","poem":1},{"text":"ጉያ ሁንደ ወራነ ካሰን ነራ ኤግ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እሳን አረበሳኒ አኩመ ቦፋ ቀረቱ፤","poem":1},{"text":"ሀዻን ቡቲ ህዺሳኒ ጀለ ጅረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ያ ዋቀዮ፣ ሀርከ ሀሞታ ነራ ኤግ፤","poem":1},{"text":"ነሞተ ፍንጭልቶተወረ ሚለኮ ክዮት ገልቹ ያደን ጀላ ነ ባስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኦፍ ቱልቶትን ዾክሰኒ ክዮ ነ ዱረ ካአኒሩ፤","poem":1},{"text":"ርቡ ክዮሳኒ ድሪርሰኒሩ፤","poem":2},{"lineBreak":true},{"text":"ከራኮረስ ክዮሳኒ ካአኒሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ያ ዋቀዮ፣ አን፣ “አት ዋቀኮት” ሲን ነንጄዸ።","poem":1},{"text":"ያ ዋቀዮ፣ ዋመተኮ ዸገእ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ያ ዋቀዮ ጎፍታ፣ ፈይሳኮ ጀባ፣","poem":1},{"text":"አት ጉያ ወራናት ጋቸነ መታ ና ታቴ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ያ ዋቀዮ፣ አከ ፌዺን ሀሞታ ፊጣን በኡ ህንጎዽን፤","poem":1},{"text":"አከ እሳን ኦፍ ህንቱሌፍ፣ አከ ከሮርሳኒ ምልካኡ ህንጎዽን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"መታን ወረ ነ መርሰኒ፣","poem":1},{"text":"ሀምነ አፋንሳኒቲ በኡን ሃሀጉገሙ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"በርበዳን እብዳ እሳንረ ሃቡኡ፤","poem":1},{"text":"እሳን እብደትሌ ሃደርበተመን፤","poem":2},{"lineBreak":true},{"text":"አከ ለመተ ህንካኔፍስ ቦለ ቅሌት ሃደርበተመን።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"መቀ በሌስቶትን ለፈረ ህንጅራትን፤","poem":1},{"text":"ነምን ጀልኣን ዋን ሀማዻን ሃበዱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ዋቀዮ ረከቶታፍ ፈልሜ","poem":1},{"text":"ህዬዪፍሌ ሙርቲ ቀጄላ አከ ኬኑ አን ቤከ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዹጉማን ነምን ቀጄላን መቃኬ ንገለቴፈተ፤","poem":1},{"text":"ነምን ቶላንስ ፉለኬ ዱረ ንጅራተ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}