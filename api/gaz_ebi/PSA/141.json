{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":141,"content":[{"type":"hebrew_subtitle","content":["ፋርፈትና ዳዊት።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ፣ አን ስን ዋመዸ፤ ደፊ ነ ቀቀብ።","poem":1},{"text":"ዮሙ አን ስ ዋመዹስ ሰገሌኮ ዸገእ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ከዸናንኮ ፉለኬ ዱረት አከ እጣናት አናፍ ሃፉዸተሙ፤","poem":1},{"text":"ሀርከኮ ኦል ቀበቹንኮስ አከ ኣርሳ ገልገላ አናፍ ሃተኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ያ ዋቀዮ፣ አፋንኮቲፍ ኤግዱ ና ዻብ፤","poem":1},{"text":"በልበለ አፋንኮቲስ ና ኤግ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ገራንኮ ነሞተ ዋን ሀማ ሆጄተን ወጅን፣","poem":1},{"text":"ሆጂ ሀምና ኬሰት ህርማቹፍ፣","poem":2},{"text":"ገረ ጀልእነ ከሚትዩ ህንሀርክፈምን፤","poem":1},{"text":"አከ አን ኛተሳኒ ምኣዋ ኛዹስ አናፍ ህንኤየምን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ነምን ቀጄላን ነ ሃሩኩቱ፤ ኩን ገረ ላፍናቲ፤","poem":1},{"text":"እን አነ ሃእፈቱ፤ ኩንስ ዘይቲ መታ ኮራት።","poem":2},{"text":"መታንኮ ዋን ከነ ህንድዱ።","poem":1},{"text":"ተኡስ ከዸናንኮ ዮምዩ ሆጂ ሀሞታቲን ሞርሙዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ቡልችቶትንሳኒ ኤዴደ ቦላራ ገድ ንደርበተሙ፤","poem":1},{"text":"እሳን ዱቢኮ ንዸገኡ፤ ዱቢንኮ ንምኣዋቲ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እሳንስ፣ “አኩመ ነምን ለፈ ቆቱ ብዮ ቡሌሱ ሰነ፣","poem":1},{"text":"ለፌንኬኘ አፋን ሲኦልረት ብትኔፈሜ ጅረ” ጄዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ያ ዋቀዮ ጎፍታ፣ አን ገሩ እጀኮ ስራ ህንቡቅፈዹ፤","poem":1},{"text":"አን ኮሉ ስት ገሌረ፤ ደበርስቴ ዱአት ነ ህንኬንን።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ክዮ እሳን ናፍ ካአንራ፣","poem":1},{"text":"ክዮ ወር ጀልእነ ሆጄተን ናፍ ቆጴሰንራስ ነ ኤግ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ወር ሀሞን ክዮ ኦፊሳኒቲን ሃቀበመን፤","poem":1},{"text":"አን ገሩ ነጉማን ነንበአ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}