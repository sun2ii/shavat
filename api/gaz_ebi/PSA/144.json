{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":144,"content":[{"type":"hebrew_subtitle","content":["ፋርፈትና ዳዊት።"]},{"type":"verse","number":1,"content":[{"text":"ዋቀዮ ከታኮ፣","poem":1},{"text":"እሰ ሀርከኮ ወራናፍ፣","poem":2},{"lineBreak":true},{"text":"ቁበኮስ ሎላፍ ሌንጅሱ ሰናፍ ገለን ሃገኡ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እን ዋቀ ነ ጃለቱፊ ደኦኮት፤","poem":1},{"text":"እዶ አን እት ደአዹፊ ፈይሳኮት።","poem":2},{"text":"ጋቸነኮ፣ እዶ አን እት ኮሉ ገሉ፣","poem":1},{"text":"ከን ነ ጀለት ሰበ ናፍ ቡልቹዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ያ ዋቀዮ፣ አከ አት ዋኤሳ ያዱፍ፣ ነምን ማል?","poem":1},{"text":"አከ አት እሳፍ ያዱፍ እልም ነማ ማል?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ነምን አኩመ ቅሌንሰ ሹፍ ጄዼ ደርቡት፣","poem":1},{"text":"በርሳስ አኩመ ጋድሰ ደርቡት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ያ ዋቀዮ፣ ሰሚወንኬ ተርሳሲ ገድ ቡእ፤","poem":1},{"text":"አከ ኣር እሳን ኬሳ ያኡፍስ ቱሉወን ቱቅ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"በከካ ኤርጊቲ ዲነ ብትኔስ፤","poem":1},{"text":"ጥየኬ ደርበዹቲ እሳን በሌስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኦል ጉባዻ ሀርከኬ ገድ ሂጠዹቲ","poem":1},{"text":"ብሻን ጀባ ጀላ፣","poem":2},{"text":"ሀርከ አለጋ ዱራስ፣","poem":1},{"text":"ነ ባስ፤ ነ ኦልችስ፤","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ወረ አፋንሳኒ ሶባን ጉተሜ፣","poem":1},{"text":"ወረ ሀርክሳኒ ምርጋ ነመ ዶጎጎርሱ ዱራ ነ ባስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ያ ዋቅ፣ አን ፋርፈትና ሃራ ሲፍ ነንፋርፈዸ፤","poem":1},{"text":"ክራረ ርቡ ኩዸኒቲንስ ሲፍን ዌድሰ፤","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እሰ ሞቶታፍ ሞአትኖ ኬኑፍ፣ እሰ ገርብቸሳ ዳዊትን","poem":1},{"text":"ጎራዴ ነመ አጄሱ ጀላ ባሱፍ ነንፋርፈዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ሀርከ ኦርሞታ ዱራ፣","poem":1},{"text":"ወረ አፋንሳኒ ሶባን ጉተሜ፣","poem":2},{"text":"ወረ ሀርክሳኒ ምርጋ","poem":1},{"text":"ነመ ዶጎጎርሱ ጀላ ነ ባስ፤ ነ ኦልችስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"እልማንኬኘ ደርገጉማሳኒ ኬሰት፣","poem":1},{"text":"አከ ብቅልቱ ቶሌ ጉደቴ ሃተአን፤","poem":2},{"text":"እንተለንኬኘስ አከ ኡቱባ ጎሌ፣","poem":1},{"text":"ከን መሰራ ሞቱማ ሚዸግሱፍሶፈሜ ሃተአን።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ጎምብሳወንኬኘ፣","poem":1},{"text":"ምዻን ጎሰ ገራ ገራቲን ሃጉተመን።","poem":2},{"text":"ሆሎትንኬኘ ኩማተመ ሃዸለን፤","poem":1},{"text":"ድሬኬኘረትስ ኩማተመ ኩዸኒንሃባይአተን፤","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ሎንኬኘ ሃዶሮበን ህንገተትን","poem":2},{"text":"ዮካን ዬሮ መሌ ህንዸልን፤","poem":1},{"text":"ቦጅአሙንስ ህንጅራትን፤","poem":2},{"lineBreak":true},{"text":"ወዋቹንስ ከራኬኘረት ህንዸገአምን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ወር ኤብ ኩን ተኤፍ ሃገመደን፤","poem":1},{"text":"ወር ዋቀዮ ዋቀሳኒ ተኤፍ ኤብፈሞዸ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}