{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":145,"content":[{"type":"hebrew_subtitle","content":["ፋርፈትና ዳዊት።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቀኮ ሞትቸ፣ አን ስን ሌልሰ፤","poem":1},{"text":"በረ በራ ሀመ በረ በራትስ መቃኬ ነንገለቴፈዸ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አን ጉዩመ ጉያን ስን ገለቴፈዸ፤","poem":1},{"text":"በረ በራ ሀመ በረ በራትስ መቃኬ ነንሌልሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ዋቀዮ ጉዳዸ፤ ገለቴፈሙንስ ባይኤ መላፍ፤","poem":1},{"text":"ጉድነሳ ቆረተኒ እት በኡን ህንደንደአሙ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዸሎትን ቶኮ ዸሎተ ብራት ሆጂኬ ንህመ፤","poem":1},{"text":"ሆጂወንኬ ጀጀቦስ ንለብሰ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እሳንስ ዋኤ ሚዸግነ ኡልፍነ ቀቤሰሱራኬ ሰና ንዱበቱ፤","poem":1},{"text":"አንስ ዋኤ ሆጂኬ ድንቅሲሳ ሰናረ ዴዴብኤእት ነንያደ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እሳን ዋኤ ሆጂኬ ሶዳችሳ ሰና ንኦዴሱ፤","poem":1},{"text":"አንስ ጉድነኬ ነንለብሰ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እሳን ያደኖ ጋሩማኬቲ ባይእሰኒ ኦዴሱ፤","poem":1},{"text":"ዋኤ ቀጄሉማኬቲስ እልልቸኒ ፋርፈቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ዋቀዮ አርጃፊ ገረ ላፌሰ፤","poem":1},{"text":"እን ኣሩፍ ህንአሪፈቱ፤ ጃለልሳስ ባይኤዸ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዋቀዮ፣ ነመ ሁንዳፍ ጋሪዸ፤","poem":1},{"text":"እን ዋን ኡሜ ሁንዳፍ ገራ ንላፈ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ያ ዋቀዮ፣ ሆጂንኬ ሁንድኑ ስ ገለቴፈተ፤","poem":1},{"text":"ቁልቁሎትንኬስ ስ ሌልሱ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እሳን ዋኤ ኡልፍነ ሞቱማኬቲ ንኦዴሱ፤","poem":1},{"text":"ዋኤ ሁምነኬቲስ ንዱበቱ፤","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኩንስ አከ ነሞትን ሁንድ ሆጂኬ ሁምነ ቀቤሰ፣","poem":1},{"text":"ሱራ ኡልፍነ ቀቤሰ ሞቱማኬ ሰናስ ቤከኒፍ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሞቱማንኬ ሞቱማ በረ በራት፤","poem":1},{"text":"ቡልቺንስኬስ ዸሎታ ገረ ዸሎታት ደርበ።","poem":2},{"lineBreak":true},{"text":"ዋቀዮ ዱቢሳ ሁንዳን አመነማዸ፤","poem":1},{"text":"ሆጂሳ ሁንዳንስ አርጃዸ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዋቀዮ ወረ ኩፈን ሁንደ ኦል ቀበ፤","poem":1},{"text":"ወረ ገድ ቀበመን ሁንደስ ንካሰ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እጅ ነመ ሁንዳ ስ ኤገተ፤","poem":1},{"text":"አትስ ዬሮ በርባችሱት ኛተ እሳኒፍ ንኬንተ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አት ሀርከኬ በልእፍቴ","poem":1},{"text":"ፌዺ ወረ ሉቡ ቀበን ሁንዳ ንጉተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ዋቀዮ ከራሳ ሁንዳን ቀጄላዸ፤","poem":1},{"text":"ሆጂሳ ሁንዳንስ አርጃዸ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዋቀዮ ወረ እሰ ዋመተን ሁንደት፣","poem":1},{"text":"ወረ ዹጋዻን እሰ ዋመተን ሁንደት ዽኦዸ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እን ፌዺ ወረ እሰ ሶዳተኒ ንጉተ፤","poem":1},{"text":"ከዸትና እሳንስ ዸገኤ እሳን ኦልቸ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዋቀዮ ወረ እሰ ጃለተን ሁንደ ንኤገ፤","poem":1},{"text":"ጀልኦተ ሁንደ ገሩ ንበሌሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"አፋንኮ ዋቀዮን ገለቴፈቹዻን ንዱበተ።","poem":1},{"text":"ኡመምን ሁንድኑ መቃሳ ቁልቁሉ ሰነ","poem":2},{"lineBreak":true},{"text":"በረ በራ ሀመ በረ በራት ሃኤብሱ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}