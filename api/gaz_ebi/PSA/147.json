{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":147,"content":[{"type":"verse","number":1,"content":[{"text":"ሃሌሉያ።","poem":1},{"lineBreak":true},{"text":"ፋርፈናዻን ዋቀ ገለቴፈቹን አከም ጋሪዸ፤","poem":1},{"text":"እሰ ገለቴፈቹን አከም ገመቺሳፊ ከን መሉዸ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ዋቀዮ ዬሩሳሌምን ንእጃረ፤","poem":1},{"text":"እስራኤሎተ ቦጅአመንስ ወልት ቀበ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ወረ ገራን ጨቤ ንፈይሰ፤","poem":1},{"text":"መዳሳኒስ ወልት ሆዸ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እን ባይእነ ኡርጂወኒ ንቤከ፤","poem":1},{"text":"ቶኮ ቶኮሳኒስ መቃ መቃዻን ዋመ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ጎፍታንኬኘ ጉዳዸ፤ ሁምንሳስ ጀባዸ፤","poem":1},{"text":"ሁበትናንሳስ ዹመ ህንቀቡ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዋቀዮ ወረ ገድ ቀበመን ንጅራችሰ፤","poem":1},{"text":"ሀሞተ ገሩ ለፈት ደርበተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ገለተ ገልቻ ዋቀዮን ፋርፈዻ፤","poem":1},{"text":"በገናዻንስ ዋቀኬኛፍ ዌድሳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"እን ሰሚወን ዱሜሳን ሀጉገ፤","poem":1},{"text":"ለፋፍስ ቦካ ኬነ፤","poem":2},{"lineBreak":true},{"text":"ቱሉወንረትስ መርገ ብቅልቸ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሆሪዻፍ ዋን እሳን ዼደን፣","poem":1},{"text":"ዮሙ እልማን አራጌሳ እየንትኛተ እሳኒፍ ንኬነ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"እን ጀብነ ፈርዳት ህንገመዱ፤","poem":1},{"text":"ዮካን ሚል ነማ እሰ ህንገመቺሱ፤","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዋቀዮ ወረ እሰ ሶዳተንት፣","poem":1},{"text":"ወረ አራረሳ አብደተንት ንገመደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ያ ዬሩሳሌም፣ ዋቀዮን ገለቴፈዹ፤","poem":1},{"text":"ያ ጥዮን ዋቀኬ ገለቴፈዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"እን ደንቀራ ከረኬቲ ንጀቤሳቲ፤","poem":1},{"text":"እጆሌኬስ ስ ኬሰት ኤብሰ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዳሪኬቲፍ ነጋ ኬነ፤","poem":1},{"text":"ቀመዲ ቁልቁሉዻንስ ስ ቁብሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"እን አጀጀሳ ገረ ለፋት ንኤርገ፤","poem":1},{"text":"ዱቢንሳስ ንአሪፈተ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እን ጨቢ አኩመ ሱፊት ድሪርሰ፤","poem":1},{"text":"ቆረስ አኩመ ዳራት ብትኔሰ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዸጋ ጨቢ አኩመ ጭረቻ ገድ ደርበተ።","poem":1},{"text":"ዻሞቸሳ ዱረ ኤኙቱ ዻበቹ ደንደአ?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እን ዱቢሳ ኤርጌ እሳን በቅሰ፤","poem":1},{"text":"ቡቤሳ ንካሰ፤ ብሻኖትንስ ንያኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"እን ዱቢሳ ያቆብት፣","poem":1},{"text":"ሴራፊ ስርነሳሞ እስራኤልት ሙልእሴረ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዋን ከነ ሰበ ብራ ቶኮፍዩ ህንጎኔ፤","poem":1},{"text":"እሳን ሴረሳ ህንቤከን።","poem":2},{"lineBreak":true},{"text":"ሃሌሉያ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}