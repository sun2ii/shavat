{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"ሃሌሉያ።","poem":1},{"lineBreak":true},{"text":"ሰሚወንራ ዋቀዮን ገለቴፈዻ፤","poem":1},{"text":"ኦል ጉባት እሰ ገለቴፈዻ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ኤርገሞትንሳ ሁንድኑ እሰ ገለቴፈዻ፤","poem":1},{"text":"ራያንሳ ሁንድኑስ እሰ ገለቴፈዻ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አዱፊ ጅእ እሰ ገለቴፈዻ፤","poem":1},{"text":"ኡርጂወን እብስተን ሁንድኑስ እሰ ገለቴፈዻ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሰሚወን ሰሚ እሰ ገለቴፈዻ፤","poem":1},{"text":"ብሻኖትን ሰሚን ኦል ጅርተንስ እሰ ገለቴፈዻ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እሳን መቃ ዋቀዮ ሃገለቴፈተን፤","poem":1},{"text":"እን አጀጅናን፣ እሳን ኡመመኒቲ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እን በረ በራ ሀመ በረ በራት እሳን ዻቤረ፤","poem":1},{"text":"ሴረ ህንጌደረምኔስ እሳኒፍ ኬኔረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ኡመመወን ገላናቲፊ ቱጁበወን ሁንድ፣","poem":1},{"text":"ለፈራ ዋቀዮን ገለቴፈዻ፤","poem":2}]},{"type":"verse","number":8,"content":[{"text":"በከካፊ ዸጋን ጨቢ፣ ጨቢፊ ዱሜስ፣","poem":1},{"text":"ቡቤን ጀባን አጀጀሳ ራወተን፣","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ቱሉወኒፊ ጋረን ሁንድኑ፣","poem":1},{"text":"ሙኬን እጀ ነቀተኒፊ ብርብርስ ሁንድኑ፣","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ብኔንሶትኒፊ ሎን ሁንድኑ፣","poem":1},{"text":"ኡመመወን ጥጥኖፊ ስምብሮትን በርሰን፣","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሞቶትን ለፋቲፊ ሰቦትን ሁንድኑ፣","poem":1},{"text":"እልማን ሞቶታቲፊ ቡልችቶትን ለፋ ሁንድኑ፣","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ደርገጎትኒፊ ሸመረን፣","poem":1},{"text":"ጃርሶሊፊ ዳእመን እሰ ገለቴፈዻ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"መቃንሳ ቆፍት ኦል ኦል ጄዼራቲ፣","poem":1},{"text":"እሳን መቃ ዋቀዮ ሃገለቴፈተን፤","poem":2},{"lineBreak":true},{"text":"ኡልፍንሳስ ለፋፊ ሰሚወኒ ኦል ጅረ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እን ሰበሳቲፍ ጋንፈ ኦል ካሴረ፤","poem":1},{"text":"ኩንስ ቁልቁሎተሳ ሁንዳፍ፣","poem":2},{"lineBreak":true},{"text":"ሰበ እስራኤል ወረ እሰት ዽኦ ጅረን ሁንዳፍ ኡልፍነ።","poem":2},{"lineBreak":true},{"text":"ሃሌሉያ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}