":"ሞቶተሳኒ ፎንጫን፣","poem":1},{"text":"ሀንገፎተሳኒስ ፉኞ ስቢላቲን ህዹዻፍ፣","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሙርቲ በሬፈሜ ሰነ እሳንረት ዹጋ በኡዻፍ።","poem":1},{"text":"ኩንስ አመነምቶተሳ ሁንዳፍ ኡልፍነ።","poem":2},{"lineBreak":true},{"text":"ሃሌሉያ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}