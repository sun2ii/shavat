{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":17,"content":[{"type":"hebrew_subtitle","content":["ከዸትና ዳዊት።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ፣ እየተ አን ሙርቲ ቀጄላፍ እየዹ ዸገእ፤","poem":1},{"text":"ቦእቸኮስ ዸጌፈዹ።","poem":2},{"text":"ከዸትናኮ ከን አፋን ነመ ህንጎዎምስኔ","poem":1},{"text":"ኬሳ በኡፍስ ጉረ ኬን።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሙርቲንኮ ስ ብራ ሃዹፉ፤","poem":1},{"text":"እጅኬስ ዋን ቀጄላ ሃአርጉ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"አት ዮ ገራኮ ቆርቴ፣ ሀልከኒንስ ዮ ነ እላልቴ፣","poem":1},{"text":"ዮ ነ ሰከታቴስ፣ ሆማ ነረት ህንአርገቱ፤","poem":2},{"lineBreak":true},{"text":"አን አከ አፋንኮ ጩቡ ህንሆጄትኔፍ ኩተዼራቲ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዋኤ ሆጂ ነሞታሞ አን ዱቢ አፋንኬቲቲን","poem":1},{"text":"ከራ ጎልቶታራ ኦፍ ኤገዼረ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ተርካንፊንኮ ከራኬረት ጭሜረ፤","poem":1},{"text":"ሚልኮስ ህንሙጩጫትኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ያ ዋቅ፣ ዋን አት ዴቢ ና ኬንቱፍ አን ስን ዋመዸ፤","poem":1},{"text":"ጉረኬ ገረኮት ቀቢቲ ከዸትናኮ ዸገእ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ያ እሰ ወረ ዲኖተሳኒ ጀላ ስት በቀተን","poem":1},{"text":"ሀርከኬ ምርጋቲን ኦልችቱ፣","poem":2},{"lineBreak":true},{"text":"አት ጃለለኬ እሰ ህንጌደረምኔ ሰነ ሃለ ድንቅሲሳዻን አርግሲስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አከ አገርቱ እጀኬቲት ነ ኤግ፤","poem":1},{"text":"ጋድዱ ቆቾኬቲቲንስ ነ ዾክስ፤","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሀሞተ ነ ዽጵሰን ጀላ፣","poem":1},{"text":"ዲኖተ ነ አጄሱፍ ነ መርሰን ጀላ ነ ባስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"እሳን ገራሳኒ ከን ነማ ህንናኔ ሰነ ንጉዱንፉ፤","poem":1},{"text":"አፋንሳኒስ ኦፍ ቱሉማዻን ዱበተ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እሳን ፋነ ነ ዸኡ፤ አመስ ነ መርሰኒሩ፤","poem":1},{"text":"ለፋን ነ ዸኡዻፍስ እጀ በባሱ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እሳን አከ ሌንጨ ዋ ኩኩተቹ ከጄሉት፤","poem":1},{"text":"አከ ሌንጨ ጉዳ ርጴ ዋ ጋዱት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ያ ዋቀዮ ከእ፤ እት በኢቲ እሳን ኩፍስ፤","poem":1},{"text":"ጎራዴኬቲንስ ሀሞተ ጀላ ነ ባስ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ያ ዋቀዮ፣ ነሞተ አከና ጀላ፣","poem":1},{"text":"ነሞተ አዱኛ ከና ወረ ቆድንሳኒ ጅሬኙመ አማ ተኤ ጀላሀርከኬቲን ነ በራር።","poem":2},{"text":"ገራንሳኒ ዋን አት እሳኒፍ ኩፍቴ ሃቁፉ፤","poem":1},{"text":"እጆሌንሳኒስ አከ መሌ ሃቁፈን፤","poem":2},{"lineBreak":true},{"text":"እሳንስ ዋን እሳንራ ሀፌ ዳእመንሳኒቲፍ ሃካአን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"አን ገሩ ቀጄሉማዻን ፉለኬ ነንአርገ፤","poem":1},{"text":"ዮሙን ደመቁትስ አን ኡልፍነኬ አርጉዻን ነንቁፈ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}