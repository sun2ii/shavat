{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":18,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት ገርብቸ ዋቀዮ፤ እንስ ዮሙ ዋቀዮ ሀርከ ዲኖተሳ ሁንዳፊ ሀርከ ሳኦል ጀላ እሰ ባሴት ዱቢ ፋርፈትና ከነ ዋቀዮፍ ፋርፈቴ። እንስ አከነ ጄዼ፦"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ ጀብነኮ፣ አን ስን ጃለዸ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ዋቀዮ ከታኮ፣ ደአትኖኮቲፊ ኦልቻኮት፤","poem":1},{"text":"ዋቅንኮ ከታኮ ከን አን ኮሉ እት ገሉዸ፤","poem":2},{"lineBreak":true},{"text":"እን ጋቸነኮቲፊ ጋንፈ ፈይነኮት፤ ደአትኖኮ ጭማዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"አን ዋቀዮ ገለን እሳፍ መሉ ሰነ ነንዋመዸ፤","poem":1},{"text":"ዲኖተኮ ጀላስ ነንበራረመ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ፉኞን ዱኣ ነ ጠጤ፤","poem":1},{"text":"ሎላን በዲሳስ ነ ልቅምሴረ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ፉኞን ሲኦል ነት መረሜ፤","poem":1},{"text":"ክዮን ዱኣስ ነት ዹፌ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"አን ዽጵነኮ ኬሰት ዋቀዮን ነንዋመዼ፤","poem":1},{"text":"ገርጋርሳፍስ ዋቀኮት ነንእየዼ።","poem":2},{"text":"እንስ መነ ቁልቁሉማሳቲ ሰገሌኮ ዸገኤ፤","poem":1},{"text":"እይኮስ ጉረሳ ሴኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ለፍት ንሆለቴ፤ ንሶቾቴስ፤","poem":1},{"text":"ሁንዴወን ቱሉወኒስ ንራፈመን፤","poem":2},{"lineBreak":true},{"text":"ሰበቢ እን ዼከሜፍስ እሳን ንሆለተን።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኣር ፉኛንሳቲ ኦል በኤ፤","poem":1},{"text":"እብድ ዋ በርበዴሱ አፋንሳቲ በኤ፤","poem":2},{"lineBreak":true},{"text":"ጭሌን ቦበኡስ አፋንሳቲ በኤ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እን ሰሚወን ተርሳሴ ገድ ቡኤ፤","poem":1},{"text":"ዱሜሶን ጉራችስ ሚለሳ ጀለ ቱረን።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እን ኪሩቤልን ያበቴ በርሴ፤","poem":1},{"text":"ቆቾ ቅሌንሳቲንስ ኦል በኤ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እን ዱከነ ሀጉጊሳ፣ ዱሜሰ ሰሚ ከን","poem":1},{"text":"ቦካዻን ዱከናኤሞ ጎዶሳ ጎዸቴ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እፈ ፉለሳ ኬሳስ ዱሜስ ዸጋ ጨቢቲፊ","poem":1},{"text":"በከካዻን ተርሳሴ በኤ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዋቀዮ ሰሚዻ ንቀቀዌሰኤ፤","poem":1},{"text":"ሰገሌን ዋቀ ዋን ሁንዳ ኦሊስ ንዸገአሜ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እን ጥየሳ ደርበቴ ዲኖተ ብትኔሴ፤","poem":1},{"text":"በከካስ ገድ ዺሴ እሳን ፍጤ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ያ ዋቀዮ፣ ዼከምሰኬቲን፣","poem":1},{"text":"ሁምነ ሀፉረ ፉኛንኬቲ በኡቲንስ፣","poem":2},{"text":"ሱሉለወን ገላና እፈት ባፈመን፤","poem":1},{"text":"ሁንዴወን ለፋስ ቁላ ሀፈን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"እን ኦል ጉባዻ ገድ ሂጠቴ ነ ቀቤ፤","poem":1},{"text":"ብሻኖተ ገድ ፈጎ ኬሳስ ነ ባሴ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እን ዲነኮ እሰ ጀባ ጀላ፣ አመጃጆተኮ","poem":1},{"text":"ወረ አከ መሌ ነት ጭመን ጀላስ ነ ባሴ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እሳን ጉያ ረክነኮት ነት ዹፈን፤","poem":1},{"text":"ዋቀዮ ገሩ ገርጋርሰኮ ቱሬ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እን እዶ በልኣት ነ ባሴ፤","poem":1},{"text":"ዋን ነት ገመዴፍስ ነ ኦልቼ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ዋቀዮ አኩመ ቀጄሉማኮቲት ና ኬኔረ፤","poem":1},{"text":"አኩመ ቁልቁልነ ሀርከኮትስ ነ በዻሴ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አን ከራ ዋቀዮ ኤጌራቲ፤","poem":1},{"text":"ዋቀኮራ ገረገሌ ሀምነ ህንሆጄትኔ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ሴርሳ ሁንድኑ ፉለኮ ዱረ ጅረ፤","poem":1},{"text":"አንስ ለብሲሳራ ህንጎሬ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"አን ፉለሳ ዱረት ሙዳ ህንቀቡ ቱሬ፤","poem":1},{"text":"ጩቡራስ ኦፍ ኤገዼረ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዋቀዮ አኩመ ቀጄሉመኮት፣","poem":1},{"text":"አኩመ ሀርክኮ ፉለሳ ዱረት ቁልቁሉ ተኤትስ ነ በዻሴረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"አት ነመ አመነማት አመነሙማኬ አርግሲፍተ፤","poem":1},{"text":"ነመ ሙዳ ህንቀብኔትስ ከን ሙዳ ህንቀብኔ ታተ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ነመ ቁልቁሉት ቁልቁሉ ታተ፤","poem":1},{"text":"ነመ ጀልኣትሞ ጀልኣ ታተ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"አት ወረ ገድ ኦፍ ቀበን ንኦልችተ፤","poem":1},{"text":"እጀ ኦፍ ቱሉ ገሩ ገድ ዴብፍተ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ያ ዋቀዮ አት እብሳኮ ጀቤስቴ ንእብስተ፤","poem":1},{"text":"ዋቅንኮ ዱከነኮ እፈት ንጌደረ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"አን ገርጋርሰኬቲን ሎልቶተ ዺበዼ ነንዴመ፤","poem":1},{"text":"ዋቀኮቲንስ ደላ ኡታሉ ነንደንደአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"ዋቀ ከነ ከራንሳ ሙዳ ህንቀቡ፤","poem":1},{"text":"ዱቢን ዋቀዮ ህርእነ ህንቀቡ፤","poem":2},{"lineBreak":true},{"text":"ወረ እሰት ኮሉ ገለን ሁንዳፍ ዋቀዮ ጋቸነ ተአ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ዋቀዮ መሌ ዋቅን ኤኙ?","poem":1},{"text":"ዋቀኬኘ መሌስ ከታን ኤኙ?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ከን ሁምነ ነ ህዸቺሱ፣","poem":1},{"text":"ከን አከ ከራንኮስ ነጋ ተኡ ጎዹ ዋቀ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"እን ሚለኮ አከ ሚለ ቦሮፋ ጎዸ፤","poem":1},{"text":"እዶ ኦል ዼራረስ ነ ዻበቺሰ።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"እን ሀርከኮ ወራናፍ ሌንጅሰ፤","poem":1},{"text":"እሬንኮስ እዳ ናሲ ደብሱ ንደንደአ።","poem":2}]},{"type":"verse","number":35,"content":[{"text":"አት ገርጋርሰኬ ከን ነመ ፈይሱ ጋቸነ ናፍ ጎተ፤","poem":1},{"text":"ሀርክኬ ምርጋ ኦል ነ ቀቤረ፤","poem":2},{"lineBreak":true},{"text":"ገርጋርስኬስ ነመ ጉዳ ነ ጎዼ።","poem":2}]},{"type":"verse","number":36,"content":[{"text":"አከ ኮሜንኮ ህንሙጩጫኔፍ፣","poem":1},{"text":"ሚለኮቲፍ ዳንዲ በልእፍቴርተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"አን ዲኖተኮ አርኤ ነንቀቀበዼ፤","poem":1},{"text":"ሀመ እሳን በርበዳአንትስ አን ዱበት ህንዴብኔ።","poem":2}]},{"type":"verse","number":38,"content":[{"text":"አን አከ እሳን ዴብአኒ ከኡ ህንደንዴኜፍ እሳን ነንበርበዴሴ፤","poem":1},{"text":"እሳንስ ሚለኮ ጀለት ንኩፈን።","poem":2}]},{"type":"verse","number":39,"content":[{"text":"አት ሎላፍ ሁምነ ነ ህዸቺፍቴ፤","poem":1},{"text":"አመጃጆተኮስ ፉለኮ ዱረት ገድ ዴብፍቴ።","poem":2}]},{"type":"verse","number":40,"content":[{"text":"አከ ዲኖትንኮ ዱግደ ዱበት ዴብአኒ በቀተን ጎቴርተ፤","poem":1},{"text":"አንስ አመጃጆተኮ በርበዴሴረ።","poem":2}]},{"type":"verse","number":41,"content":[{"text":"እሳን ገርጋርሳፍ እየን፤ ገሩ ከን እሳን ኦልቹ ቶኮዩ ህንቱሬ፤","poem":1},{"text":"ገረ ዋቀዮትስ ንእየተን፤ እን ገሩ ዴቢ ህንኬንኔፍ።","poem":2}]},{"type":"verse","number":42,"content":[{"text":"አንስ አኩመ አዋረ ቡቤን ፉዸቱት እሳን ነንዳኬ፤","poem":1},{"text":"አኩመ ዾቄ ዳንዲራት እሳን ነንዽዺቴ።","poem":2}]},{"type":"verse","number":43,"content":[{"text":"አት ሎለ ነሞታ ጀላ ነ ባፍቴርተ፤","poem":1},{"text":"መታ ሰቦታ ነ ጎቴርተ፤","poem":2},{"lineBreak":true},{"text":"ሰብን አን ህንቤክኔ ነ ተጃጅለ።","poem":2}]},{"type":"verse","number":44,"content":[{"text":"ነሞትን ኦርማ ነ ሶሶበተን፤","poem":1},{"text":"እሳን አኩመ ዋኤኮ ዸገአኒን ናፍ አጀጀመን።","poem":2}]},{"type":"verse","number":45,"content":[{"text":"እሳን ሁንድ አብዲ ኩተተን፤","poem":1},{"text":"ሆለቻስ ደአትኖሳኒ ጀባ ኬሳ በአን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"ዋቀዮ ጅራታዸ! ከታንኮ ሃኤብፈሙ!","poem":1},{"text":"ዋቅን ፈይሳንኮ ኦል ኦል ሃጄዹ!","poem":2}]},{"type":"verse","number":47,"content":[{"text":"እን ዋቀ ሃሎ ና ባሱ፣","poem":1},{"text":"ከን ሰቦተስ ነ ጀለት ቡልቹዸ፤","poem":2}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"ዲኖተኮ ጀላስ ነ ባሰ።","poem":2},{"text":"አት አመጃጆተኮቲ ኦል ነ ጎተ፤","poem":1},{"text":"ጎልቶተ ጀላስ ነ ባፍቴ።","poem":2}]},{"type":"verse","number":49,"content":[{"text":"ከናፉ ያ ዋቀዮ፣ አን ሰቦተ ግዱት ስን ሌልሰ፤","poem":1},{"text":"ፋርፈትና ገለታሌ መቃኬቲፍ ነንፋርፈዸ።","poem":2}]},