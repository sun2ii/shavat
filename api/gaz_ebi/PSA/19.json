{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":19,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።"]},{"type":"verse","number":1,"content":[{"text":"ሰሚወን ኡልፍነ ዋቃ ኦዴሱ፤","poem":1},{"text":"በንቲን ሰሚስ ሆጂ ሀርከሳ ለብሰ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ጉያን ቶኮ ጉያ ካንት ኦዴሰ፣","poem":1},{"text":"ሀልከን ቶኮስ ሀልከን ካንት ቤኩምሰ ሙልእሰ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሃሳን ዮካን ዱቢን ህንጅሩ፤","poem":1},{"text":"ሰገሌንሳኒስ ህንዸገአሙ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ተኡስ ሰገሌንሳኒ ለፈ ሁንዱማ፣","poem":1},{"text":"ዱቢንሳኒስ ሀንዳረ አዱኛ ገኤ።","poem":2},{"text":"እን ሰሚወን ኬሰት ቢፍቱዻፍ ዱንካነ ዻቤ፤","poem":1}]},{"type":"verse","number":5,"content":[{"text":"ቢፍቱንስ አኩመ ምስርቸ ድንቀሳቲ በኡቲፊ","poem":2},{"lineBreak":true},{"text":"አኩመ ሞአታ ፊግቸ ዶርጎሙት ገመዱ ቶኮት።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እሼንስ ሀንዳረ ሰሚወኒ ቶኮ ባቴ","poem":1},{"text":"ገረ ሀንዳረ ካኒት ናኖፍት፤","poem":2},{"lineBreak":true},{"text":"ወን ሆአሼ ጀላ ዾከቱ ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ሴር ዋቀዮ ሙዳ ህንቀቡ፤","poem":1},{"text":"ሉቡ ነመት ዴብሰ።","poem":2},{"text":"አጀጅን ዋቀዮ አመነማዸ፤","poem":1},{"text":"ነመ ወላላ ቤካ ጎዸ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሴር ዋቀዮ ቀጄላዸ፤","poem":1},{"text":"ገራዻፍ ገመቹ ኬነ።","poem":2},{"text":"አጀጅን ዋቀዮ ቁልቁሉዸ፤","poem":1},{"text":"እጃፍስ እፈ ኬነ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዋቀዮን ሶዳቹን ቁልቁሉዸ፤","poem":1},{"text":"በረ በራን ጅራተ።","poem":2},{"text":"ሙርቲን ዋቀዮ ዹጋዸ፤","poem":1},{"text":"ወሉማ ገለትስ ቀጄላዸ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እን ወርቄ ጫላ፣ ወርቄ አከ መሌ ቁልቁሌፈሜ","poem":1},{"text":"ጫላዩ ገቲ ቀቤሰ፤","poem":2},{"text":"እን ደመ ጫላ፣","poem":1},{"text":"ነዺ ደማ ጫላ ምኣዋዸ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሙርቲ ከናንስ ተጃጅላንኬ ንጎርፈመ፤","poem":1},{"text":"እሰ ኤጉንስ ገቲ ጉዳ ቀበ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ኤኙቱ ዶጎጎረሳ ሁበቹ ደንደአ?","poem":1},{"text":"የከኮ እሰ ዾክፈማራ ነ ቁልቁሌስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ተጃጅላኬ ጩቡ እጀ ጀብናን ሆጄተሙራ ኤግ፤","poem":1},{"text":"ጩቡን ኩንስ ነ ህንሞአን።","poem":2},{"text":"ዮስ አን ህርእነ መሌ ነንጅራዸ፤","poem":1},{"text":"ዶጎጎረ ጉዳራስ ቁልቁሉ ነንተአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ያ ዋቀዮ፣ ከታኮፊ ፉሪኮ፣","poem":1},{"text":"ዱቢን አፋንኮቲፊ ያድን ገራኮ","poem":2},{"lineBreak":true},{"text":"ፉለኬ ዱረት ፉዸተማ ሃተኡ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}