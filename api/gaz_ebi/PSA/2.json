em":2}]},{"type":"verse","number":8,"content":[{"text":"ነ ከዸዹ፤","poem":1},{"text":"አን ሰቦተ ዻለኬ፣","poem":2},{"lineBreak":true},{"text":"ሀንዳረ ለፋስ ቀቤኘኬ ጎዼ ሲፈን ኬነ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አት ኡሌ ስቢላቲን እሳን ጨብስተ፤","poem":1},{"text":"አከ ቆዳ ሱጴትስ እሳን ሁሬስተ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ከናፉ ያ ሞቶተ፣ ቀልቤፈዻ፤","poem":1},{"text":"ቡልችቶትን ለፋስ ኦፍ ኤገዻ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሶዳዻን ዋቀዮን ተጃጅላ፤","poem":1},{"text":"ሆለቻስ ገመዳ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አከ እን ህንኣሬፍ፣","poem":1},{"text":"እስንስ አከ ከራረት ህንበድኔፍ እልመሳ ዹንገዻ፤","poem":2},{"text":"ዼከምስሳ ደፌ ቦበኣቲ።","poem":1},{"text":"ወር እሰት ኮሉ ገለን ሁንድ ኤብፈሞዸ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}