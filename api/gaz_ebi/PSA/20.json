{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።"]},{"type":"verse","number":1,"content":[{"text":"ጉያ ረክናት ዋቀዮ ዴቢ ሲፍ ሃኬኑ፤","poem":1},{"text":"መቃን ዋቀ ያቆብስ ስ ሃኤጉ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እን እዶ ቁልቁሉዻ ገርጋርሰ ሲፍ ሃኤርጉ፤","poem":1},{"text":"ጥዮንራስ ጀብነ ሲፍ ሃኬኑ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኣርሳኬ ሁንደ ሲፍ ሃያደቱ፤","poem":1},{"text":"ቀልመኬ ከን ጉበሙስ ሲፍ ሃፉዸቱ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሀዊ ገራኬቲ ሲፍ ሃኬኑ፤","poem":1},{"text":"ከሮረኬ ሁንደስ ፊጣን ሲፍ ሃባሱ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዮሙ አት ሞአቱት እልልችኔ","poem":1},{"text":"መቃ ዋቀኬኛቲን ፋጂኬኘ ኦል ፉዸትነ።","poem":2},{"lineBreak":true},{"text":"ዋቀዮ ዋን አት ከዸቱ ሁንዱማ ሲፍ ሃኬኑ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"አን አከ ዋቀዮ ድበማሳ ፈይሱ አመ ቤከ፤","poem":1},{"text":"ዋቀዮ ሁምነ ነመ ፈይሱ ከን ሀርከሳ ምርጋ ኬሰ ጅሩ ሰናን","poem":2},{"lineBreak":true},{"text":"ሰሚሳ ቁልቁሉ ኬሳ ዴቢ ንኬናፍ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ነሞትን ቶኮ ቶኮ ጋሪወን አመነቱ፤ ካንሞ ፈርዴን አመነቱ፤","poem":1},{"text":"ኑ ገሩ መቃ ዋቀዮ ዋቀኬኛ አመነትነ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እሳን ጉፈተኒ ኩፉ፤ ኑ ገሩ ኦል ካነ፤","poem":1},{"text":"ጀባኔስ ንዻበትነ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ያ ዋቀዮ፣ አት ሞቲዻፍ ሞአትና ኬን!","poem":1},{"text":"ዮሙ ኑ ስ ዋመኑትስ ዴቢ ኑ ኬን!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}