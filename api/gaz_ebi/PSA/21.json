{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":21,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ፣ ሞቲን ጀብነኬት ባይኤ ገመደ።","poem":1},{"text":"ገርጋርሰ ኬትስ ገመቹንሳ ሀመም ጉዳዸ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"አት ሀዊ ገራሳ ኬንቴፊ ጅርተ፤","poem":1},{"text":"ከዸትና አፋንሳስ እሰ ህንዾወትኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አት ኤበ ጉዳዻን እሰ ስመቴ፤","poem":1},{"text":"ጎንፎ ወርቄ ቁልቁሉስ መታሳረ ኬሴ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እን ጅሬኘ ስ ከዸቴ፤ አትስ ንኬንቴፍ፤","poem":1},{"text":"በረ ዼራስ በረ በራ ሀመ በረ በራት ኬንቴፍ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኡልፍንሳ ሞአትና አት እሳፍ ኬንቴን ጉዳ ተኤ፤","poem":1},{"text":"አትስ ኡልፍናፊ ሱራ እሰት ኡውፍቴ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አት ኤበ በረ በራ ኬንቴፍ፤","poem":1},{"text":"አከ እን ገመቹ አርገመኬቲቲን ገመዱስ ጎቴ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሞትች ዋቀዮን አመነታቲ፤","poem":1},{"text":"ሰበቢ ጃለለ ዋቀ ዋን ሁንዳ ኦሊ","poem":2},{"lineBreak":true},{"text":"ከን ህንጌደረምኔ ሰናቲፍስ እን ህንራፈሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ሀርክኬ ዲኖተኬ ሁንደ ንቀበተ፤","poem":1},{"text":"ሀርክኬ ምርጋስ ወረ ስ ጅበን ንቀበ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዬሮ ሙልአቹኬቲት፣","poem":1},{"text":"አከ ቦለ እብድ ኬሳ ቦበኡ እሳን ጎተ።","poem":2},{"text":"ዋቀዮ ዼከምሰሳቲን እሳን ልቅምሰ፤","poem":1},{"text":"እብድስ እሳን ፍጠ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አት ሰኚሳኒ ለፈራ፣","poem":1},{"text":"እጆሌሳኒስ እልማን ነማ ግዱዻ ንበሌስተ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እሳን ዮ ዋን ሀማ ስት ያደን፣","poem":1},{"text":"ዮ ደበ ስት መርአተንስ ህንምልካአን።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አት ዮሙ እዳኬ እሳንት ቀብዱት፣","poem":1},{"text":"አከ እሳን በቀተን ጎታቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ያ ዋቀዮ፣ ጀብነኬቲን ኦል ኦል ጄዽ፤","poem":1},{"text":"ኑ ሁምነኬ ንጀጀትነ፤ ንፋርፈነስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}