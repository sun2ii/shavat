{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":22,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ዬደሎ “ቦሮፈ ገነማ” ጄዹ። ፋርፈትና ዳዊት።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቀኮ፣ ያ ዋቀኮ፣ አት ማሊፍ ነ ዺፍቴ?","poem":1},{"text":"አት ነ ገርጋሩራ፣","poem":2},{"lineBreak":true},{"text":"እየ ኮራስ ማሊፍ አከስ ፈጋተ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ያ ዋቀኮ፣ አን ጉያ ጉያ ስትን እየዸ፤","poem":1},{"text":"አት ገሩ ዴቢ ናፍ ህንዴብፍቱ፤","poem":2},{"lineBreak":true},{"text":"ሀልከን ሀልከንስ አፋን ህንቀበዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"አት ገሩ ቁልቁልቸ ቴሶረ ታኡዸ፤","poem":1},{"text":"አት ገለተ እስራኤል።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አቦቲንኬኘ ስ አመነተን፤","poem":1},{"text":"እሳን ስ አመነተን፤ አትስ እሳን ኦልችቴ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እሳን ስት እየተን፤ ንፈይፈመንስ፤","poem":1},{"text":"ስ አመነተን፤ ህንቃኖፍኔስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"አን ገሩ ራሞዸ መሌ ነመ ምት፤","poem":1},{"text":"አን ነመ ነምን እት ቆሱፊ ሰብንስ ቱፈቱዸ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ወር ነ አርገን ሁንድኑ ነት ኮልፉ፤","poem":1},{"text":"መታሳኒ ራሰኒ ነ አረብሱ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አከነስ ጄዹ፤ “እን ዋቀዮን አመነተ፤","poem":1},{"text":"ሜ ዋቀዮ እሰ ሃኦልቹ ካ።","poem":2},{"lineBreak":true},{"text":"እን ዋን እሰት ገመዱፍ፣ እሰ ሃኦልቹ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"አት ገሩ ገደሜሰ ኬሳ ነ ባፍቴ፤","poem":1},{"text":"ሀርመ ሃዸኮረትስ፣ ስቱ ነጋን ነ ኤጌ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አን ጋፈን ዸለዼ ጀልቀቤ ስረት ነንገተሜ፤","poem":1},{"text":"ኤርገ ሃትኮ ነ ዴሴ ጀልቀብዴ አት ዋቀኮት።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አት ነራ ህንፈጋትን፤","poem":1},{"text":"ረክን ዽኣቴራቲ፤","poem":2},{"lineBreak":true},{"text":"ነምን ነ ገርጋሩስ ህንጅሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ኮሮሚን ባይኤን ነ መርሱ፤","poem":1},{"text":"ኮሮሚን ባሻን ጀጀቦንስ ከራ ሁንዱማን ነ መርሱ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እሳንስ አከ ሌንጨ ቤለኤ ኣዱ","poem":1},{"text":"አፋንሳኒ በልእሰኒ ነት በነቱ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አን አኩመ ብሻኒት ነንዸንገላፈሜ፤","poem":1},{"text":"ለፌንኮ ሁንድኑስ ወል ገድ ዺሴ።","poem":2},{"text":"ኦኔንኮ ገረ ገጋት ጌደረሜ፤","poem":1},{"text":"ነ ኬሰትስ በቄ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ጀብንኮ አከ ቅራጪ ጎጌ፤","poem":1},{"text":"አረብንኮ ላጋት ነ መጠኔ፤","poem":2},{"lineBreak":true},{"text":"አዋረ ዱኣ ኬሰስ ነ ጪብስቴ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሰሮትን ነ መርሰኒሩ፤","poem":1},{"text":"ገሬን ነሞተ ሀሞ ነ መርሴረ፤","poem":2},{"lineBreak":true},{"text":"እሳንስ ሀርካፊ ሚለኮ ወራነኒ ፉላሰኒሩ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አን ለፌኮ ሁንደ ለካኡ ነንደንደአ፤","poem":1},{"text":"እሳንስ እጀ በባሰኒ ነ እላሉ፤ አከስ ተኡኮትስ ንገመዱ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እሳን ወያኮ ህረተን፤","poem":1},{"text":"ኡፈተኮትስ እጣ ቡፈተን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ያ ዋቀዮ፣ አት ገሩ ነራ ህንፈጋትን፤","poem":1},{"text":"ያ ጀብነኮ ነ ገርጋሩፍ አሪፈዹ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ሉቡኮ ጎራዴ ጀላ፣","poem":1},{"text":"ጅሬኘኮሞ ሁምነ ሰሮታ ጀላ ባስ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አፋን ሌንጫ ጀላ ነ ምልቅስ፤","poem":1},{"text":"ጋንፈ ገፈርሳ ጀላስ ነ ባስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"መቃኬ ኦቦሎተኮት ነንለብሰ፤","poem":1},{"text":"ወልዳ ኬሰትስ ስን ጀጀዸ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"እስን ወር ዋቀዮን ሶዳተን እሰ ጀጀዻ!","poem":1},{"text":"እስን ሰኚን ያቆብ ሁንድኑ እሰ ኡልፌሳ!","poem":2},{"lineBreak":true},{"text":"ሰኚን እስራኤል ሁንድኑስ እሰ ሶዳዻ!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"እን ዽጵነ ነመ ዽጰቴ ህንቱፈትኔ","poem":1},{"text":"ዮካን ህንበልፍኔቲ፤","poem":2},{"text":"ዮሙ እን ገርጋርሳፍ እሰት እየቴትስ፣","poem":1},{"text":"ንዸገኤፍ መሌ ፉለሳ ህንዾክፈትኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ገለን አን ያኢ ጉዳረት ሲፍ ገልቹ ስ ብራ ዹፈ፤","poem":1},{"text":"ወረ ስ ሶዳተን ዱረትስ ወሬገኮ ኦፍራ ነንባሰ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ህዬዪን ኛተኒ ቁፉ፤","poem":1},{"text":"ወር ዋቀዮን በርባደተንስ እሰ ንጀጀቱ፤","poem":2},{"lineBreak":true},{"text":"ገራንኬሰን በረ በራን ሃጅራቱ!","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ሀንዳር ለፋ ሁንድኑ ንያደተ፤","poem":1},{"text":"ገረ ዋቀዮትስ ንዴብአ፤","poem":2},{"text":"ማቲወን ሰቦታ ሁንድኑስ","poem":1},{"text":"ፉለሳ ዱረት ንሰገዱ፤","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ሞቱማን ከን ዋቀዮቲ፤","poem":1},{"text":"እንስ ሰቦተ ሁንደ ንቡልቸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"ሶሬዪን ለፋ ሁንድኑ ንኛቱ፤ ንዋቄፈቱስ፤","poem":1},{"text":"ወር ኦፍ ጅራችሱ ህንደንዴኜ ከኔን ብዮ ሴነን ሁንድ","poem":2},{"lineBreak":true},{"text":"ፉለሳ ዱረት ንጅልቤንፈቱ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ዸሎትን ዹፉ እሰ ተጃጅለ፤","poem":1},{"text":"ዸሎተ ቦሪትስ ዋኤን ጎፍታ ንህመመ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ሰበቢ እን ዋን ከነ ሆጄቴፍ፣","poem":1},{"text":"እሳን ሰበ ዸለቹፍ ጅሩት ቀጄሉማሳ ንለብሱ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}