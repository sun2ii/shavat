":"verse","number":7,"content":[{"text":"ጩቡ አፋንኮቲ","poem":1},{"text":"ዮካን ዶጎጎረኮ ህንያደትን፤","poem":2},{"text":"ያ ዋቀዮ፣ ጋሩማኬቲፍ ጄዺቲ","poem":1},{"text":"አኩመ አራረኬቲት ነ ያደዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ዋቀዮ ጋሪዸ፤ ቶላዸስ፤","poem":1},{"text":"ከናፉ እን ዳንዲሳ ጩበሞተት አርግሲሰ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ወረ ገድ ኦፍ ቀበን ዋን ቀጄላ ተኤን ጌጌሰ፤","poem":1},{"text":"ከራሳስ እሳን በርሲሰ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ከራን ዋቀዮ ሁንድኑ","poem":1},{"text":"ወረ ከኩሳቲፊ ሴረሳ ኤገኒፍ አራራፊ ዹጋዸ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ያ ዋቀዮ፣ ጩቡንኮ ጉዳ ተኡዩ","poem":1},{"text":"መቃኬቲፍ ጄዺቲ ዺፈመ ና ጎዽ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ነምን ዋቀዮን ሶዳቱ ኤኙ?","poem":1},{"text":"ዋቀዮ ከራ እን ፍለቹ ቀቡ እሰ አርግሲሰ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሉቡንሳ በዻዹማዻን ጅራት፤","poem":1},{"text":"ሰኚንሳስ ለፈ ዻለ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዋቀዮ እጪቲሳ ወረ እሰ ሶዳተን ዱራ ህንዾክሱ፤","poem":1},{"text":"ከኩሳሌ እሳን ቤክስሰ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እጅኮ ዬሮ ሁንደ ገረ ዋቀዮ እላለ፤","poem":1},{"text":"እን ሚለኮ ክዮ ኬሳ ንባሳቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ገረኮት ገረገል፤ ገራስ ና ላፍ፤","poem":1},{"text":"አን ኮጳኮን ጅራቲ፤ ረከታዸስ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ያዶን ገራኮቲ ባይአቴረ፤","poem":1},{"text":"ዽጵነኮ ኬሳስ ነ ባስ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዽጵነኮቲፊ ረክነኮ እላል፤","poem":1},{"text":"ጩቡኮ ሁንደ ና ዺስ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አከ ዲኖትንኮ ባይአተን፣","poem":1},{"text":"ሀመም አከ ጭምሰኒ ነ ጅበን አርግ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ሉቡኮ ኤግ፤ ነ ኦልችስ፤","poem":1},{"text":"ሰበቢ አን ኮሉ ስት ገሌፍ፣","poem":2},{"lineBreak":true},{"text":"አከ አን ቃነኡ ነ ህንጎዽን።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዋን አን ስ ኤገዹፍ፣ አመነሙማፊ","poem":1},{"text":"ቀጄሉማን አነ ሃኤገን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ያ ዋቀዮ፣ ረክነሳ ሁንዱማ ኬሳ","poem":1},{"text":"እስራኤልን ፉር!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}