{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":30,"content":[{"type":"hebrew_subtitle","content":["ፋርፈትና ኤበ መነ ቁልቁሉማቲፍ ፋርፈተሜ። ፋርፈትና ዳዊት።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ፣ ሰበቢ አት ኦል ነ ፉቴ","poem":1},{"text":"አከ ዲኖትንኮ ነት ህንገመኔ ጎቴፍ፣","poem":2},{"lineBreak":true},{"text":"አን ስን ጀጀዸ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ያ ዋቀዮ ዋቀኮ፣","poem":1},{"text":"አን ገርጋርሳፍ ስን ዋመዼ፤ አትስ ነ ፈይፍቴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ያ ዋቀዮ፣ አት ሉቡኮ ሲኦሊ ባፍቴ፤","poem":1},{"text":"አከ አን ቦለ ህንቡኔ ጎቴስ ነ ጅራችፍቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"እስን ቁልቁሎንሳ፣ ፋርፈናዻን ዋቀዮን ጀጀዻ፤","poem":1},{"text":"መቃሳ ቁልቁሉ ሰናፍስ ገለተ ገልቻ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዼከምስሳ ሀመ ልጵሱ እጃት፤","poem":1},{"text":"ጋሩማንሳሞ በረ ጅሬኛ ጉቱዻፍ ቱረ፤","poem":2},{"text":"ቦእች ገልገለ ቶኮ ቆፋፍ ቱረ፤","poem":1},{"text":"ገነመ ገሩ እልሌቱ ተአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"አንስ ዮሙን ነጋ አርገዼት፣","poem":1},{"text":"“አን ጎንኩማ ህንራፈሙ” ነንጄዼ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ያ ዋቀዮ፣ አት ጃለለኬቲን","poem":1},{"text":"አከ ቱሉ ጀባት ነ ዻብዴ፤","poem":2},{"text":"ዬሮ አት ፉለኬ ነ ዱራ ዾክስቴት ገሩ","poem":1},{"text":"ናሱቱ ነ ቀበቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ያ ዋቀዮ፣ አን ስን ዋመዸ፤","poem":1},{"text":"አን ገረ ጎፍታት አከነ ጄዼ አራራፍ ነንእየዸ፦","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“ዱኡኮ ኬሳ፣ ቦለ ቡኡኮ ኬሳስ","poem":1},{"text":"ፋይዳ ማሊቱ አርገመ?","poem":2},{"text":"ብዮን ስ ገለቴፈታ?","poem":1},{"text":"አመነሙማኬስ ንኦዴሳ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ያ ዋቀዮ ነ ዸገእ፤ ነ ማርስ፤","poem":1},{"text":"ያ ዋቀዮ፣ ገርጋርሰ ና ተእ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"አት ቦእቸኮ ሹብሱት ጌደርቴ፤","poem":1},{"text":"ወያ ገዳ ነራ ባፍቴ ገመቹ ነት ኡውፍቴ፤","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኩንስ አከ ሉቡንኮ ፋርፈናዻን ስ ጀጀቱፊአከ እሼን ህንጨልእስኔፊዸ።","poem":1},{"text":"ያ ዋቀዮ ዋቀኮ፣ አን በረ በራን ስን ገለቴፈዸ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}