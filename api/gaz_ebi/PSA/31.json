{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":31,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ፣ አን ኮሉ ስት ገሌረ፤","poem":1},{"text":"አት ጎንኩማ ነ ህንቃኔስን፤","poem":2},{"lineBreak":true},{"text":"ቀጄሉማኬቲን ነ ኦልች።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ጉረኬ ገረኮት ቀብ፤ ደፊቲ ነ ኦልች፤","poem":1},{"text":"ከታ አን እት ኮሉ ገሉ ና ተእ፤","poem":2},{"lineBreak":true},{"text":"ነ ኦልቹዻፍስ ደኦ ጀባ ና ተእ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አት ዋን ከታኮፊ ደኦኮ ታቴፍ፣","poem":1},{"text":"መቃኬቲፍ ጄዺቲ ነ ቀጄልች፤ ከራረስ ነ ቡስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አት እዶ አን እት በቀዹ ዋን ታቴፍ፣","poem":1},{"text":"ክዮ ዲኖትንኮ ና ካአን ኬሳ ነ ባስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አን ሀፉረኮ ደበርሴ ሀርከ ኬን ኬነዸ፤","poem":1},{"text":"ያ ዋቀዮ ዋቀ ዹጋ፣ አት ነ ፉር።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"አን ወረ ዋቆተ ፋይዳ ህንቀብኔ አብደተን ነንጅበ፤","poem":1},{"text":"ዋቀዮን ገሩ ነንአመነዸ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አን ጃለለኬ ከን ህንጌደረምኔ ሰነት ነንገመደ፤ ነንእልልቸስ፤","poem":1},{"text":"አት ዽጵነኮ አርግቴርታቲ፤","poem":2},{"lineBreak":true},{"text":"ረክነ ሉቡኮቲሌ ቤክቴርተ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አት ደበርስቴ ዲነት ነ ህንኬንኔ፤","poem":1},{"text":"ሚለኮስ እዶ በልኣረ ዻብዴርተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ያ ዋቀዮ፣ አን ዽጵነኬሰን ጅራቲ ነ ባስ፤","poem":1},{"text":"እጅኮ ገዳን፣ ሉቡንኮፊ ዸግንኮ ገዳን ደዸበኒሩ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጅሬኝኮ ገዳን፣ ኡሙሪንኮ ኣዱዻን ዹሜረ፤","poem":1},{"text":"ጀብንኮ ሰበቢ ዽጵነኮቲቲፍ ላፌረ፤","poem":2},{"lineBreak":true},{"text":"ለፌንኮስ ጡጠሜረ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሰበቢ ዲኖተኮ ሁንዳቲፍ፣","poem":1},{"text":"አን ኦሎተኮ ብረት ዋን ሶዳችሳ፣","poem":2},{"text":"ምቾተኮ ብረትሞ ዋን ጅብሲሳ ተኤረ፤","poem":1},{"text":"ወር ከራረት ነ አርገንስ ነ በቀቱ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አን አኩመ ነመ ዱኤት እራንፈተሜረ፤","poem":1},{"text":"አኩመ ቆዳ ጨባስ ነንተኤ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አሳሰ ነሞተ ባይኤ ነንዸገኣቲ፤","poem":1},{"text":"ከለቲ ሁንዳን ሶዳቱ ጅረ!","poem":2},{"text":"እሳን ነት መለተኒ","poem":1},{"text":"ሉቡኮ በሌሱፍ መርአተን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ያ ዋቀዮ፣ አን ገሩ ስን አመነዸ፤","poem":1},{"text":"“አት ዋቀኮት” ነንጄዸ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"በርኮ ስ ሀርከ ጅረ፤ ዲኖተኮ ጀላ፣","poem":1},{"text":"ወረ ነ አርአተን ሀርካስ ነ ባስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ፉልኬ ተጃጅላኬረት ሃእፉ፤","poem":1},{"text":"ጃለለኬ ከን ህንጌደረምኔ ሰናንስ ነ በራር።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ያ ዋቀዮ፣ አን ህንቃኔፈምን፤","poem":1},{"text":"አን ስ ዋመዼራቲ፤","poem":2},{"text":"ወር ሀሞን ገሩ ሃቃኔፈመን፤","poem":1},{"text":"ጨልእሰኒስ ሲኦል ኬሰ ሃቡአን።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"አፋን ሶበ ዱበቱ፣","poem":1},{"text":"ከን ኦፍ ቱሉማፊ ቱፊዻን፣","poem":2},{"lineBreak":true},{"text":"ነመ ቀጄላት ኮሬ ዱበቱ ሃዱዱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ጋሩማንኬ ከን አት ወረ ስ ሶዳተኒፍ ኦል ኬሴ፣","poem":1},{"text":"ከን አት ፉለ ነሞታ ዱረት","poem":2},{"lineBreak":true},{"text":"ወረ ኮሉ ስት ገለኒፍ ኬንቴ አከም ጉዳዸ!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ደኦ ፉለኬቲቲን፣","poem":1},{"text":"ዋን ነሞትን እሳንት መለተን ጀላ እሳን ዾክስተ፤","poem":2},{"lineBreak":true},{"text":"ዱንካነኬ ኬሰትስ ዱቢን ቱቱቁ ጀላ እሳን ደኤስተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ዋቀዮ ሃኤብፈሙ፤","poem":1},{"text":"እን ዬሮ አን መጋላ መርፈምቴ ኬሰ ቱሬት፣","poem":2},{"lineBreak":true},{"text":"ጃለለሳ ድንቅሲሳ ሰነ ነ አርግሲሴራቲ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"አን ዬሮን አከ መሌ ዽጰዼት፣","poem":1},{"text":"“አን ፉለኬ ዱራ በዴረ!” ጄዼን ቱሬ።","poem":2},{"text":"አት ገሩ ዬሮ አን ገርጋርሳፍ ስት እየዼት፣","poem":1},{"text":"ከዸትናኮ ና ዸጌሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ቁልቁሎንሳ ሁንድኑ፣ ዋቀዮን ጃለዻ!","poem":1},{"text":"ዋቀዮ አመነሞተ ንኤገ፤","poem":2},{"lineBreak":true},{"text":"ኦፍ ቱልቶታፍ ገሩ አኩመ ሆጂሳኒት እረ ደበርሴ ዴብሳፍ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ወር ዋቀዮን አብደተን ሁንድኑ ጀባዻ፤","poem":1},{"text":"ገራንኬሰን ህንሶዳትን።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}