{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":32,"content":[{"type":"hebrew_subtitle","content":["ፋርፈትና ዳዊት። መስኪል።"]},{"type":"verse","number":1,"content":[{"text":"ነምን የክሳ ዺፈሜፍ፣","poem":1},{"text":"ከን ጩቡንሳስ ሀጉገሜፍ፣","poem":2},{"lineBreak":true},{"text":"ኤብፈማዸ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ነምን ዋቀዮ ጩቡ እት ህንለኮፍኔ፣","poem":1},{"text":"ከን ሀፉረሳ ኬሰስ ጎዎምሳን ህንጅሬ፣","poem":2},{"lineBreak":true},{"text":"ኤብፈማዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ዬሮ አን ጩቡኮ ህመቹ ዺሴት፣","poem":1},{"text":"ጉያ ጉቱ ኣዱኮቲን፣","poem":2},{"lineBreak":true},{"text":"ለፌንኮ ንቦሶሴ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሀርክኬ ሀልከኒፊ ጉያ ነት ኡልፋቴራቲ፤","poem":1},{"text":"ጀብንኮስ አኩመ ዋን ሆአ ቦናቲን ተኡት ጡጠሜ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኤርገሲስ ጩቡኮ ስት ነንህመዼ፤","poem":1},{"text":"በሌሳኮስ ስ ህንዾክፈትኔ።","poem":2},{"text":"አንስ፣ “እረ ደደርበኮ፣ ዋቀዮት ነንህመዸ” ነንጄዼ፤","poem":1},{"text":"አትስ የከ ጩቡኮቲ፣ ና ዺፍቴርተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ከናፉ ነምን አመነማን ከምዩ፣","poem":1},{"text":"ዬሮ አት እት አርገምቱት ስ ሃከዸቱ፤","poem":2},{"lineBreak":true},{"text":"ሎላን ብሻን ጉዳስ እሰ ብረ ህንገኡ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አት እዶ አን እት ዾከዹዸ፤","poem":1},{"text":"ረክነራ ነ ኤግደ፤","poem":2},{"lineBreak":true},{"text":"ፋርፈትና ሞአናቲንስ ነ መርስተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"አን ከራ አት እረ ዴምቱረት ስን ቀጄልቸ፤ ስን በርሲሰስ፤","poem":1},{"text":"አን እጀኮ ጃለላቲን ስን እላላ፤ ስን ጎርሰ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እስን አከ ፈርደ ዮካን ጋንጎ","poem":1},{"text":"ሁበትና ህንቀብኔ ህንተእና፤","poem":2},{"text":"እሳን ዮ ሉገማፊ ፉሎዻን ቀበመን መሌ","poem":1},{"text":"ገረኬ ህንዹፈን።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዽጵን ነሞተ ሀሞ ባይኤዸ፤","poem":1},{"text":"አራር ዋቀዮ ገሩ ነመ እሰ አመነቱ ንመርሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ያ ቀጄልቶተ፣ እስን ዋቀዮት ገመዳ፤ እልልቻስ፤","poem":1},{"text":"ወር ገራ ቁልቁሉ ቀብደን ሁንድኑ እልልቻ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}