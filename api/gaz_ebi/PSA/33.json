{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"ያ ቀጄልቶተ፣ እስን ዋቀዮት ገመዳ፤","poem":1},{"text":"እሰ ጀጁን ቶሎታፍ ንመለ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ክራራን ዋቀዮን ገለቴፈዻ፤","poem":1},{"text":"በገና ርቡ ኩዸን ቀቡን እሳፍ ፋርፈዻ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ፋርፈትና ሃራ እሳፍ ፋርፈዻ፤ ርቡ ሃላን ሩኩታ፤","poem":1},{"text":"ስሪት ሩኩታ፤ ገመቹዻንስ እልልቻ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ዱቢን ዋቀዮ ቀጄላዻቲ፤","poem":1},{"text":"እን ዋን ሆጄቱ ሁንዱማት አመነማዸ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዋቀዮ ቀጄሉማፊ ሙርቲ ቀጄላ ጃለተ፤","poem":1},{"text":"ለፍትስ ጃለለሳ ከን ህንጌደረምኔን ጉተምቴርት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ሰሚወን ዱቢ ዋቀዮቲን ሆጄተመን፤","poem":1},{"text":"ቱትን ኡርጂወኒ ሁንድኑስሀፉረ አፋንሳቲ በኡን ኡመመን።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እን ብሻን ገላና አከ ቱላት ወልት ቀበ፤","poem":1},{"text":"ብሻን ቱጁባስ ኩሳ ኬሰ ካአ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ለፍት ሁንድ ዋቀዮን ሃሶዳቱ፤","poem":1},{"text":"ሰብን አዱኛረ ጅራቱ ሁንድኑስ፣ ጉድሴ እሰ ሃሶዳቱ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እን ዱበቴራቲ፣ ወን እን ዱበቴ ንተኤ፤","poem":1},{"text":"እን ንአጀጄ፤ ወን እን አጀጄስ ንራወቴ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዋቀዮ መሪ ሰቦታ ንፈሸሌሰ፤","poem":1},{"text":"አከ ከሮር ነሞታ ሆጂረ ህንኦሌስ ንጎዸ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ከሮር ዋቀዮ ገሩ በረ በራን፣ ያድን ገራሳስ","poem":1},{"text":"ዸሎተ ሁንዱማ ኬሰት ጭሜ ንዻበተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ሰብን ዋቀዮ ዋቀ እሳፍ ተኤ፣","poem":1},{"text":"ነሞትን እን አከ ዻለ ኦፊሳት ፍለቴ ኤብፈሞዸ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዋቀዮ ሰሚራ ገድ ንእላለ፤","poem":1},{"text":"እልማን ነሞታ ሁንደስ ንአርገ፤","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እን ቴሶሳረ ታኤ፣","poem":1},{"text":"ወረ ለፈረ ጅራተን ሁንደ ገድ እላለ፤","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እን ገራ ነመ ሁንዱማ ኡሙ ሱን፣","poem":1},{"text":"ሆጂሳኒ ሁንደ ንሁበተ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሞቲን ባይእነ ሎልቶተሳቲን ዱአ ህንኦሉ፤","poem":1},{"text":"ጀግንስ ጉድነ ሁምነሳቲን ዱአ ጀላ ህንበኡ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ፈርድ ሞአናዻፍ አብዲ ገቲ ህንቀብኔዸ፤","poem":1},{"text":"ጉድን ሁምነሳስ ነመ ህንኦልቹ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ገሩ እጅ ዋቀዮ ወረ እሰ ሶዳተንረ፣","poem":1},{"text":"ወረ አራረሳ አብደተንረስ ጅረ፤","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እን ሉቡሳኒ ዱአ ጀላ ንባሰ፤","poem":1},{"text":"በረ ቤላስ እሳን ንጅራችሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ሉቡንኬኘ አብዲዻን ዋቀዮን ኤገት፤","poem":1},{"text":"እንስ ገርጋርሰኬኛፊ ጋቸነኬኘ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ገራንኬኘ እሰት ንገመዳቲ፤","poem":1},{"text":"ኑ መቃሳ ቁልቁሉ ንአመነናቲ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ያ ዋቀዮ፣ አኩመ ኑ አብዲኬኘ","poem":1},{"text":"ስረ ካአኑት፣ አራርኬ ኑረ ሃቡኡ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}