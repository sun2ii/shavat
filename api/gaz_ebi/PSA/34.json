{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":34,"content":[{"type":"hebrew_subtitle","content":["ፋርፈትና ዳዊት። እንስ ፉለ አቢሜሌክ ዱረት መራቱ ኦፍ ፈኬሴፍ አቢሜሌክ እሰ አሪናን ዬሮ አቺ ዴሜት ፋርፈቴ።"]},{"type":"verse","number":1,"content":[{"text":"አን ዬሮ ሁንደ ዋቀዮን ነንኤብሰ፤","poem":1},{"text":"ገለንሳስ ዬሮ ሁንደ አፋኒ ነ ህንቡኡ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሉቡንኮ ዋቀዮን ቦንት፤","poem":1},{"text":"ጩንቁርፈምቶትን ዸገአኒ ሃገመደን።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ነ ወጅን ዋቀዮፍ ኡልፍነ ኬና፤","poem":1},{"text":"ኮታ ወሊ ወጅን መቃሳ ኦል ካፍና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ዋቀዮን ነንበርባደዼ፤ እንስ ዴቢ ና ኬኔ፤","poem":1},{"text":"ሶዳኮ ሁንደ ኬሳስ ነ ባሴ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ወር ገረሳ እላለን ንእፉ፤","poem":1},{"text":"ፉልሳኒስ ዮምዩ ህንቃነኡ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ህዬስ ኩን ንእዬ፤ ዋቀዮስ እሰ ዸገኤ፤","poem":1},{"text":"ረክነሳ ሁንዱማ ኬሳስ እሰ ባሴ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኤርገማን ዋቀዮ ናኖ ወረ ዋቀ ሶዳተኒ","poem":1},{"text":"ንቁበተ፤ እሳን ንኦልቸስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"አከ ዋቀዮ ጋሪ ተኤ ሜ ምኤፈዻ እላላ፤","poem":1},{"text":"ነምን እሰት ኮሉ ገሉ ኤብፈማዸ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እስን ቁልቁሎንሳ ዋቀዮን ሶዳዻ፤","poem":1},{"text":"ወር እሰ ሶዳተን ሆማ ህንዸበኒቲ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሌንጭ ሳፌልዩ ዋ ንዸበ፤ ንቤለአስ፤","poem":1},{"text":"ነምን ዋቀዮን በርባደቱ ገሩዋን ጋሪ ቶኮሌ ህንዸቡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ያ እጆሌኮ፣ ኮታ ነ ዸገኣ፤","poem":1},{"text":"አንስ ዋቀዮን ሶዳቹ እስነን በርሲሰ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ነምን ጅሬኘ ጃለቱ፣ ከን በረ ጋሪ አርጉዻፍስ","poem":1},{"text":"በረ ባይኤ ሀዉ ኤኙ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አረበኬ ዋን ሀማራ፣","poem":1},{"text":"አፋንኬስ ሶበ ዱበቹራ ኤገዹ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሀምነራ ዴብእ፤ ጋሪ ሆጄዹ፤","poem":1},{"text":"ነጋ በርባድ፤ ዱካ ቡእስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"እጅ ዋቀዮ ቀጄልቶተረ ጅረ፤","poem":1},{"text":"ጉርሳስ እየሳኒቲፍ በነማዸ፤","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ያደኖሳኒ ለፈራ በሌሱዻፍ፣","poem":1},{"text":"ፉል ዋቀዮ ወረ ሀማ ሆጄተንት ንሀማተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ቀጄልቶትን ገርጋርሳፍ እየቱ፤ ዋቀዮስ እሳን ዸገአ።","poem":1},{"text":"ረክነሳኒ ሁንደ ኬሳስ እሳን ባሰ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዋቀዮ ወረ ገራንሳኒ ጨቤት ዽኦዸ፤","poem":1},{"text":"ወረ አብዲ ኩተተንስ ንፈይሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ረክን ነመ ቀጄላ ባይኤዸ፤","poem":1},{"text":"ዋቀዮ ገሩ ሁንደሳ ጀላ እሰ ባሰ፤","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ለፌሳ ሁንደ ንኤገ፤","poem":1},{"text":"እሳን ኬሳስ ቶኮሌ ህንጨቡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ሀሞተ ሀምነቱ አጄሰ፤","poem":1},{"text":"ወረ ነመ ቀጄላ ጅበንት ንሙርቴፈመ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዋቀዮ ሉቡ ተጃጅልቶተሳ ንፉረ፤","poem":1},{"text":"ወረ እሰት ኮሉ ገለን ኬሳ ቶኮትሌ ህንሙርቴፈሙ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}