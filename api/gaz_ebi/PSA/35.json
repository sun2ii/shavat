{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":35,"content":[{"type":"hebrew_subtitle","content":["ፋርፈትና ዳዊት።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ፣ ወረ አናን ሞርመኒን ሞርም፤","poem":1},{"text":"ወረ ነ ሎለንስ ሎል።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ጋቸናፊ ምአ ሎላ ቀበዹ፤","poem":1},{"text":"ነ ገርጋሩዻፍስ ከእ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ወረ ነ አርአንት","poem":1},{"text":"ኤቦፊ ቦዴ ሉቅፈዹ።","poem":2},{"text":"ሉቡኮቲንስ፣","poem":1},{"text":"“ፈይንኬ አነ” ጄዽ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ወር ሉቡኮ በርባደን፣","poem":1},{"text":"ሃቃነአን፤ ሃሰልጰተንስ፤","poem":2},{"text":"ወር ነ በሌሱፍ መርአተንስ፣","poem":1},{"text":"አብዲ ኩተተኒ ዱበት ሃዴብአን።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አከ ሀበቂ ቅሌንሳን ፉዸተሜ ሃተአን፤","poem":1},{"text":"ኤርገማን ዋቀዮስ እሳን ሃአርኡ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ከራንሳኒ ዱከናኣፊ ሙጩጫታ ሃተኡ፤","poem":1},{"text":"ኤርገማን ዋቀዮስ እሳን ሃአርኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"እሳን ሰበቢ መሌ ክዮሳኒ ዾክሰኒነ ዱረ ካአኒሩቲ፤","poem":1},{"text":"ሰበቢ መሌስ ቦለ ና ቆተኒሩ፤","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኡቱ እን ህንቤክን በዲስን እሰት ሃዹፉ፤","poem":1},{"text":"ክዮን እን ዾክሴ ሱንስ እሱመ ሃቀቡ፤","poem":2},{"lineBreak":true},{"text":"ቦሉመ ቆቴ ሰነትስ ሃኩፉ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዮስ ሉቡንኮ፣ ዋቀዮት ገመድ፤","poem":1},{"text":"ፈይሱ እሳትስ ንእልልችት።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ለፌንኮ ሁንድ አከነ ሲን ጄዸ፦","poem":1},{"text":"“ያ ዋቀዮ፣ ከን አከኬቲ ኤኙ?","poem":2},{"text":"አት ደዸብዶተ ወረ እሳን ጫላ ጀባተን ጀላ ባፍተ፤","poem":1},{"text":"ህዬዪፊ ረከቶተሌ ሳምቶተ ጀላ ባፍተ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ዹገ ባቶትን ሶባ ነት ከአን፤","poem":1},{"text":"ዋን አን ዋኤሳ ህንቤክኔስ ነ ጋፈቱ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እሳን ቆደ ዋን ጋሪ ዋን ሀማ ና ዴብሱ፤","poem":1},{"text":"ሉቡኮስ ኮጳት ሀምብሱ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አን ገሩ ዬሮ እሳን ዽበመንት፣ወያ ገዳ ነንኡፈዼ፤","poem":1},{"text":"ሉቡኮስ ሶማን ነንሚዼ።","poem":2},{"text":"ዬሮ ከዸናንኮ ዴቢ መሌ ሀፌትስ","poem":1}]},{"type":"verse","number":14,"content":[{"text":"አን አኩመ ዋን ምቹኮቲፍ ዮካን ኦቦሌሰኮቲፍ ገዱት፣","poem":2},{"lineBreak":true},{"text":"ገዳን አሲፊ አች ዴዴብኤ።","poem":2},{"text":"አኩመ ዋን ሃዸኮቲፍ ቦኡትስ፣","poem":1},{"text":"ገዳን መታኮ ነንቡሴ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እሳን ገሩ ዬሮ አን ጉፈዼት ገመደኒ ወልት ቀበመን፤","poem":1},{"text":"ኡቱ አን ህንቤክን ነ መርሰን፤","poem":2},{"lineBreak":true},{"text":"ኡቱ ወልራ ህንኩትንስ ነ ጭጭረተን።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እሳን አኩመ ወረ ዋቀት ህንቡሌት ሀምናን ነት ቆሰን፤","poem":1},{"text":"እልካንሳኒሌ ነት ቀረተን።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ያ ጎፍታ፣ አት ሀመ ዮሚት ጨልእስቴ እላልተ?","poem":1},{"text":"ሉቡኮ በዲሰ እሳን ፍደን ጀላ፣","poem":2},{"lineBreak":true},{"text":"ጅሬኘኮስ ሌንጨ ጀላ ባስ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"አን ወል ገኢ ጉዳ ኬሰት ስን ገለቴፈዸ፤","poem":1},{"text":"ቱተ ጉዳ ኬሰት ስን ጀጀዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ወር አከሱማን ዲነ ነት ተአን ነት ህንገመድን፤","poem":1},{"text":"ወር ሰበቢ መሌ ነ ጅበን ሱንስ እጀ ነት ህንቅስን።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እሳን ነጋ ህንዱበተን፤","poem":1},{"text":"ወረ ቀበናን ብየ ኬሰ ጅራተንትስ፣","poem":2},{"lineBreak":true},{"text":"መለ ሶባ መለቱ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"እሳንስ፣ “በገ! በገ! እጁመኬኛን እሰ አርግኔ”","poem":1},{"text":"ጄዸኒ አፋን ነት በነቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ያ ዋቀዮ፣ አት ዋን ከነ አርግቴርተ፤ ህንጨልእስን።","poem":1},{"text":"ያ ጎፍታ፣ ነራ ህንፈጋትን።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ያ ዋቀኮፊ ጎፍታኮ፣ አት ምርገኮቲፍ፣","poem":1},{"text":"ዽመኮቲፍስ ደመቅ፤ ከእ!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ያ ዋቀዮ ዋቀኮ፣","poem":1},{"text":"አኩመ ቀጄሉማኬቲት ና ሙርቴስ፤","poem":2},{"lineBreak":true},{"text":"አከ እሳን ነት ገመደንስ ህንጎዽን።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"አከ እሳን፣ “በገ! አኩመ ኑ በርባኔ ተኤረ!” ጄዸን፣","poem":1},{"text":"ዮካን አከ እሳን፣ “ኑ እሰ ልቅምስኔረ” ጄዸን ህንጎዽን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ወር ዽጵነኮት ገመደን ሁንድኑ","poem":1},{"text":"ሃቃነአን፤ ሃቡርጃጀአንስ፤","poem":2},{"text":"ወር ነት ኮረን ሁንድኑስ፣","poem":1},{"text":"ቃኒፊ ሰልጵነ ሃኡፈተን።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ወር ቀጄሉመኮ ጃለተን፣","poem":1},{"text":"ሰገሌ ጉዳዻን ሃእልልቸን፤ ሃገመደንስ።","poem":2},{"text":"እሳን ዬሮ ሁንደ፣","poem":1},{"text":"“ዋቀዮ እን ነጋ ገርብቸሳት ገመዱጉዳዸ” ሃጄዸን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"አረብንኮ ቀጄሉማኬ፣","poem":1},{"text":"ጉያ ጉቱስ ገለተኬ ኦዴሰ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}