{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":36,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት ገርብቸ ዋቀዮ።"]},{"type":"verse","number":1,"content":[{"text":"አን ዋኤ ጩበሞታ፣","poem":1},{"text":"ኤርጋ ዋቀ ብረ ዹፌ ገራኮ ኬሳ ቀበ፦","poem":2},{"lineBreak":true},{"text":"ዋቀ ሶዳቹን እጀሳኒ ዱረ ህንጅሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"አከ ጩቡንሳኒ እፈት በኤ ህንጅበምኔፍስ፣","poem":1},{"text":"እሳን እጁመ ኦፊሳኒ ዱረት አከ መሌ ኦፍ ሳዱ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዱቢን አፋንሳኒ ጀልእናፊ ጎዎምሳዸ፤","poem":1},{"text":"እሳን ኦጉማዻን ሆጄቹፊ ዋን ጋሪ ጎቹ ዺሰኒሩ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ስሬሳኒረትዩ እሳን ሀምነ ጠጡ፤","poem":1},{"text":"ከራ ጩቡት ኦፍ ኬኑ፤ ዋን ሀማስ ህንለገተን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ያ ዋቀዮ፣ አራርኬ ሰሚወን ብረ፣","poem":1},{"text":"አመነሙማንኬስ ዱሜሰ ብረ ገአ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ቀጄሉማንኬ አከ ቱሉወን ጉርጉዳት፤","poem":1},{"text":"ሙርቲንኬስ አኩመ ቱጁበ ጉዳት።","poem":2},{"lineBreak":true},{"text":"ያ ዋቀዮ፣ አት ነማፊ ብኔንሰ ንጅራችፍተ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ያ ዋቅ፣ ጃለልኬ እን ህንጌደረምኔ ሱን አከም ኡልፍነ ቀቤሰ!","poem":1},{"text":"እልማን ነሞታ፣ ጋድሰ ቆቾኬቲ ጀለት ኮሉ ገሉ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እሳን በዻዹማ መነኬቲ ኛተኒ ቁፉ፤","poem":1},{"text":"አትስ ለገ ገመቹኬቲራ እሳን ኦባፍተ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ቡርቃን ጅሬኛ ስ ብረ ጅራቲ፤","poem":1},{"text":"ኑ እፈኬቲን እፈ አርግነ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ጃለለኬ ወረ ስ ቤከኒፍ፣","poem":1},{"text":"ቀጄሉማኬስ ገረ ቶሌዪዻፍ እቱመ ፉፍ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሚል ኦፍ ቱልቶታ ነት ህንዹፍን፤","poem":1},{"text":"ሀርክ ሀሞታስ ዺቤ ነ ህንፈጌስን።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ወር ዋን ሀማ ሆጄተን ኩኖ ኩፈኒ ድሪረኒሩ፤","poem":1},{"text":"ገድ ደርበተመኒሩ፤ ከኡስ ህንደንደአን!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}