{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":39,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ዬዱቱኒፍ። ፋርፈትና ዳዊት።"]},{"type":"verse","number":1,"content":[{"text":"አን አከነ ነንጄዼ፤ “አን ከራኮ ነንኤገዸ፤","poem":1},{"text":"አረበኮስ ጩቡራ ነንእትሰ፤","poem":2},{"text":"ሀመ ነምን ሀማን ነ ብረ ጅሩትስ፣","poem":1},{"text":"አፋንኮት ሉገመ ነንካአዸ።”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አን ጨልእሴ አኩመ ዱዳ ነንተኤ፤","poem":1},{"text":"ዋን ጋሪ ዱበቹራስ ኦፍ ነንቁሰዼ፤","poem":2},{"lineBreak":true},{"text":"ዽጵንኮ ገሩ እቱመ ጫሌ፤","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኦኔንኮ ነ ኬሰት ቡሉቃ ዴሜ፤","poem":1},{"text":"ዬሮ አንረ ዴዴብኤ ያዴትስ እብድ ሱን ንቦበኤ፤","poem":2},{"lineBreak":true},{"text":"አንስ አረበኮቲን አከነ ጄዼን ዱበዼ፦","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ያ ዋቀዮ፣ አት ዹመ ጅሬኘኮቲ ነ አርግሲስ፤","poem":1},{"text":"ዼርነ ኡሙሪኮቲስ ነ በርሲስ፤","poem":2},{"lineBreak":true},{"text":"ጅሬኝኮ አከም ደፌ አከ ደርቡስ ነ ቤክስስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኩኖ፣ አት በረኮ ታኩ ቶክቲ ጎቴርተ፤","poem":1},{"text":"ኡሙሪንኮስ ፉለኬ ዱረት ሆማቱ ህንሄደሙ፤","poem":2},{"lineBreak":true},{"text":"ጅሬኝ ነመ ሁንዱማስ አኩመ ቅሌንሰ ሹፍ ጄዼ ደርቡት።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዹጉመዩ ነምን አኩመ ጋድዱ ዴዴብአ፤","poem":1},{"text":"ዹጉማን እን አከሱማን ጎለመ፤","poem":2},{"lineBreak":true},{"text":"ነምን ቀቤኘ ንኩሰ፤ ገሩ ኤኙፍ አከ ወልት ቀቡ ህንቤኩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ኤጋ አመ ያ ጎፍታ፣ አን ማልን ኤገዸ?","poem":1},{"text":"አብዲንኮ ሱመረ ጅረ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዶጎጎረኮ ሁንደራ ነ ኦልች፤","poem":1},{"text":"ነመ ጎዎትን እት ኮልፈን ነ ህንጎዽን።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አን ዱዳዸ፤ አፋንኮስ ህንሳቀዹ፤","poem":1},{"text":"ከን ዋን ከነ ጎዼ ሱማቲ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አን ሩኩታ ሀርከኬቲቲን ዹሜራቲ፤","poem":1},{"text":"ዸእቸኬ ነራ ፉዽ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አት ሰበቢ ጩቡሳኒቲፍ ነሞተ እፈተ፤ ንአደብደስ፤","poem":1},{"text":"አኩመ ብሊስ ቀቤኘሳኒ ንበሌስተ፤","poem":2},{"lineBreak":true},{"text":"ዹጉማን ነምን ሁንድኑ ቅሌንሱመ ሹፍ ጄዼ ደርቡዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ያ ዋቀዮ፣ ከዸትናኮ ና ዸገእ፤","poem":1},{"text":"እየ አን ገርጋርሰ በርባቻፍ እዩስ ዸጌፈዹ፤","poem":2},{"lineBreak":true},{"text":"ቦእቸኮስ ጨልእስቴ ህንእላልን።","poem":2},{"text":"አን አከ አለጋት ስ ብረ ነንጅራዻቲ፤","poem":1},{"text":"አኩመ አቦቲኮ ሁንዱማትስ አን ነመ ብየ ኦርማት።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኡቱን ጎዳኔ ለፈራ ህንዸበምን ዱረ","poem":1},{"text":"አከን ዴብኤ ገመዱፍ፣ እጀኬ ነራ ዴብፈዹ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}