ext":"ነሞትን፣ “ኤኙቱ ዋን ጋሪ ኑ አርግሲሰ?” ጄዸን ባይኤዸ፤","poem":1},{"text":"ያ ዋቀዮ፣ እፍን ፉለኬቲ ኑረት ሃእፉ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ገመቹ እሳን ዬሮ ምዻኒፊ ዳዺን ወይኒሳኒ ባይአቱት አርገተን ጫላ፣","poem":1},{"text":"አት ገራኮ ገመቹ ጉዳዻን ጉቴርተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"አን ነጋዻን ነንጪሰ፤ ነንረፈስ፤","poem":1},{"text":"ያ ዋቀዮ ስ ቆፈቱ፣","poem":2},{"lineBreak":true},{"text":"ሶዳ መሌ ነ ጅራችሳቲ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}