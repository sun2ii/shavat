},{"lineBreak":true},{"text":"ቶኮዩ ህንጅሩ፤","poem":2},{"text":"ዮ አን ዋኤሳኒ ለብሴ ዱበዼሌ፣","poem":1},{"text":"ባይእንሳኒ ሀመ ህንቀቡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"አት ኣርሳፊ ኬና ህንፌኔ፤","poem":1},{"text":"ጉረኮ ገሩ ና በንቴርተ፤","poem":2},{"lineBreak":true},{"text":"ኣርሳ ጉበሙፊ ኣርሳ ጩቡ አት ህንበርባድኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዬሮ ሰነ አን አከነ ነንጄዼ፤ “አን ኩኖት፤ አን ዹፌረ፤","poem":1},{"text":"ዋኤንኮ ክታበ መረማ ኬሰት በሬፈሜረ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ያ ዋቀኮ፣ አን ፌዺኬ ራወቹት ነንገመደ፤","poem":1},{"text":"ሴርኬ ገራኮ ኬሰ ጅረ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"አን ያኢ ጉዳ ኬሰት ቀጄሉማ ነንለብሰ፤","poem":1},{"text":"ያ ዋቀዮ፣ አኩመ አት ቤክቱ፣","poem":2},{"lineBreak":true},{"text":"አን አፋንኮ ህንቀበዹ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አን ቀጄሉማኬ ገራኮ ኬሰ ህንዾክሱ፤","poem":1},{"text":"ዋኤ አመነሙማኬቲቲፊ ዋኤ ፈይሱኬቲ ነንኦዴሰ፤","poem":2},{"text":"ጃለለኬቲፊ ዹጋኬስ","poem":1},{"text":"ያኢ ጉዳ ዱራ ህንዾክሱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ያ ዋቀዮ አራረኬ ነ ህንዾወትን፤","poem":1},{"text":"ጃለልኬቲፊ ዹጋንኬ ዬሮ ሁንደ አነ ሃኤገን።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ረክን ሀመ ህንቀብኔ ነ መርሴራቲ፤","poem":1},{"text":"ጩቡንኮስ ነ ልቅምሴረ፤ አርጉስ ደዸቤረ፤","poem":2},{"text":"ጩቡንኮ ርፌንሰ መታኮ ጫላ ባይአተ፤","poem":1},{"text":"ኦኔንኮስ ነ ኬሰት ላፍቴርት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ያ ዋቀዮ፣ ነ ፈይሱት ገመድ፤","poem":1},{"text":"ያ ዋቀዮ፣ ነ ገርጋሩዻፍ ደፊ ኮቱ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ወር ሉቡኮ ገላፈቹ በርባደን ሁንድኑ፣","poem":1},{"text":"ሃቃነአን፤ ሃቡርጃጀአንስ።","poem":2},{"text":"ወር በዲኮ ሀወን ሁንድ፣","poem":1},{"text":"ቃነአኒ ዱበት ሃዴብአን።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ወር፣ “በገ! በገ!” አናን ጄዸን፣","poem":1},{"text":"ቃኒሳኒቲን ሃርፈተን።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ወር ስ በርባደን ሁንድኑ ገሩ","poem":1},{"text":"ስት ገመደኒ ሃእልልቸን።","poem":2},{"text":"ወር ፈይሱኬ ጃለተን ዬሮ ሁንደ፣","poem":1},{"text":"“ዋቀዮ ጉዳዸ!” ሃጄዸን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"አን ገሩ ህዬሳፊ ረከታዸ፤","poem":1},{"text":"ተኡስ ጎፍታን ናፍ ያደ።","poem":2},{"text":"አት ገርጋርሰኮፊ ፈይሳኮት፤","poem":1},{"text":"ያ ዋቀኮ፣ ህንቱርን።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}