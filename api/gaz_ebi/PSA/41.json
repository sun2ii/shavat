{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":41,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።"]},{"type":"verse","number":1,"content":[{"text":"ነምን ህዬሳፍ ያዱ ኤብፈማዸ፤","poem":1},{"text":"ጉያ ረክናት ዋቀዮ እሰ ንኦልቸ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዋቀዮ እሰ ንኤገ፤ በረ ጅሬኘሳስ ንዼሬሰ፤","poem":1},{"text":"ለፈረት እሰ ኤብሰ፤","poem":2},{"lineBreak":true},{"text":"ሀዊ ዲኖተ እሳትስ ደበርሴ እሰ ህንኬኑ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዋቀዮ ስሬ እን ዹኩብሰቴረ ጪሱረት እሰ ኩኑንሰ፤","poem":1},{"text":"ፈይሴስ ስሬ ዹኩባራ እሰ ንካሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"አንስ፣ “ያ ዋቀዮ ነ ማር፤","poem":1},{"text":"አን ጩቡ ስት ሆጄዼራቲ ነ ፈይስ” ነንጄዼ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዲኖትንኮ ሀምናን፣ “እን ዮም ዱኤ መቃንሳ","poem":1},{"text":"ለፈራ በደ?” ጄዸኒ ዋኤኮ ዱበቱ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ነምን ቶኮ ዬሮ ነ ጋፈቹ ዹፉት፣","poem":1},{"text":"ኡቱመ ገራሳት ሀምነ ኩፈቴ ቀቡ፣ ሶቤ ዱበተ፤","poem":2},{"lineBreak":true},{"text":"ገድ በኤስ እዶ ሁንዱመት ኦዴሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ወር ነ ጅበን ሁንድኑ ዋኤኮ ወልት ሀሳሱ፤","poem":1},{"text":"ዋን አከ መሌ ሀማ ተኤስ ነት መርአቱ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እሳንስ፣ “ዹኩብን ሀማን እሰ ቀበቴረ፤","poem":1},{"text":"እን ስአች እዶ ጪሱ ሰና ህንከኡ” ጄዹ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ምቹንኮ እን ነት ዽኣቱ፣","poem":1},{"text":"እን አን አመነዼ፣","poem":2},{"text":"እን ቡዴነኮ ኛቴ","poem":1},{"text":"ኮሜሳ ነት ኦል ፉዸቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"አት ገሩ ያ ዋቀዮ ነ ባስ፤","poem":1},{"text":"አከ አን ሃሎ ባፈዹፍስ ኦል ነ ካስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አከ አት ነት ገመዱ አን ቤከ፤","poem":1},{"text":"ዲንኮ ነረ ህንኣኑቲ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አት ሰበቢ አመነሙማኮቲቲፍ ኡቱብዴ ነ ቀብደ፤","poem":1},{"text":"በሩመ በራንስ ፉለኬ ዱረ ነ ዻብደ።","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ዋቀዮ ዋቅን እስራኤል፣","poem":1},{"text":"በረ በራ ሀመ በረ በራት ሃኤብፈሙ።","poem":2},"አሜን፤ አሜን።"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}