{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":42,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። መስኪሊ እልማን ቆራህ።"]},{"type":"verse","number":1,"content":[{"text":"አኩመ ገደምስ ብሻን ያኡት ገገቡ ሰነ፣","poem":1},{"text":"ያ ዋቀኮ፣ ሉቡንኮ ስት ገገብድ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሉቡንኮ ዋቀዮን ዋቀ ጅራታ ዼቦት።","poem":1},{"text":"አን ዮምን ዸቄ ፉለ ዋቃ አርገ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እምማንኮ ሀልከኒ ጉያ ሶረ ና ተኤረ፤","poem":1},{"text":"ነሞትን ጉያ ጉቱ “ዋቅንኬ ኤሰ ጅረ?” አናን ጄዹቲ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አን ዮሙን ዋን ከነ ያደዹት፣","poem":1},{"text":"ሉቡኮ ኦፍ ኬሰት ነንዸንገላሰ፦","poem":2},{"text":"እልሌፊ ፋርፈትና ገለታቲን","poem":1},{"text":"ቱተ አያነ አያኔፈቱ ቶኮ፣","poem":2},{"text":"ህሪራን ገረ መነ ዋቃት ጌጌሳ","poem":1},{"text":"ቱትቸ ወጅን አከምት አከ አን ዴማ ቱሬ ያደዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ያ ሉቡኮ፣ አት ማሊፍ ገድተ?","poem":1},{"text":"ነ ኬሰትስ ማሊፍ ራፈምተ?","poem":2},{"text":"አብዲኬ ዋቀረ ኬየዹ፤","poem":1},{"text":"አን አመዩ እሰ ነንጀጀዸ።","poem":2},{"lineBreak":true},{"text":"ፈይሳኮፊ ዋቀኮ ነንጀጀዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ሉቡንኮ ነ ኬሰት ገድቴርት፤","poem":1},{"text":"ከናፉ አን ብየ ዮርዳኖስራ፣","poem":2},{"text":"ፊጤ ሄርሞኒፊ","poem":1},{"text":"ጋረ ሚዛሪራ ስ ያደዸ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሁርሳ ፍንጫኣኬቲቲን፣","poem":1},{"text":"ቱጁብን ቱጁበ ዋመ፤","poem":2},{"lineBreak":true},{"text":"ደምበሊፊ ዸኣንኬ ሁንድኑ፣ ነረ ያአን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ዋቀዮ ጉያዻን ጃለለሳ ከን ህንጌደረምኔ ንአጀጀ፤","poem":1},{"text":"ሀልከንሞ ፋርፈናንሳ ነ ወጅን ጅረ፤","poem":2},{"lineBreak":true},{"text":"ኩንስ ከዸትና አን ዋቀ ጅሬኘኮቲ ከዸዹዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"አንስ ዋቀ ከታኮቲን አከነ ነንጄዸ፤","poem":1},{"text":"“አት ማሊፍ ነ ደገቴ?","poem":2},{"lineBreak":true},{"text":"ማሊፍ አን ዲናን ጩንቁርፈሜ ገዳን ጅራዸ?”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አመጃጆንኮ ጉያ ጉቱ፣","poem":1},{"text":"“ዋቅንኬ ኤሰ ጅረ?” ጄዸኒ ነት ቆሱዻን፣","poem":2},{"lineBreak":true},{"text":"አኩመ ጎራዴ ለፌኮ ኬሳት ነ ዽጵሱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ያ ሉቡኮ፣ አት ማሊፍ ገድተ?","poem":1},{"text":"ነ ኬሰትስ ማሊፍ ራፈምተ?","poem":2},{"text":"አብዲኬ ዋቀረ ካአዹ፤","poem":1},{"text":"አን አመዩ እሰ ነንገለቴፈዸ፤","poem":2},{"lineBreak":true},{"text":"ፈይሳኮፊ ዋቀኮ ነንጀጀዸ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}