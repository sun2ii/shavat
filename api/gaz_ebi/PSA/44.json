{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":44,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። መስኪሊ እልማን ቆራህ።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቅ፣ ዋን አት በረ ዱሪ፣","poem":1},{"text":"ጀበነሳኒ ኬሰ ሆጄቴ ሰነ፣","poem":2},{"text":"አቦቲንኬኘ ኑት ህመኒሩ፤","poem":1},{"text":"ኑስ ጉረኬኛን ዸጌኜረ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አት ሀርከኬቲን ሰቦተ አሪቴ ባፍቴ፤","poem":1},{"text":"አቦቲኬኘሞ ንዻብዴ፤","poem":2},{"text":"ነሞተ ንበሌስቴ፤","poem":1},{"text":"አቦቲኬኘ ገሩ ብልሰ ባፍቴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሀርከኬ ምርጋቲን፣ እሬኬቲፊ እፈ ፉለኬቲቲን ዻለን መሌ","poem":1},{"text":"እሳን ጎራዴሳኒቲን ለፈ ሰነ ህንዻሌ፤","poem":2},{"text":"ዮካን እሬንሳኒ ሞአትኖ እሳኒፍ ህንፍድኔ፤","poem":1},{"text":"አት እሳን ጃለቴርታቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"አት ሞቲኮፊ ዋቀኮ","poem":1},{"text":"ከን ያቆቢፍ ሞእቸ አጀጁዸ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኑ ሲን ዲኖተኬኘ ዱበት ዴብፍነ፤","poem":1},{"text":"መቃኬቲንስ አመጃጆተኬኘ ገድ ዽዺትነ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አን እዳኮ ህንአመነዹ፤","poem":1},{"text":"ጎራዴንኮስ ሞአትና ና ህንፍዱ፤","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አት ገሩ ዲኖተኬኘ ጀላ ኑ ኦልችተ፤","poem":1},{"text":"ወረ ኑ ጅበንሞ ንቃኔስተ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኑ ዬሮ ሁንዱማ ዋቃን ዻደትነ፤","poem":1},{"text":"መቃኬስ በረ በራን ንገለቴፈትነ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"አመ ገሩ አት ኑ ገቴርተ፤ ገድስ ኑ ዴብፍቴርተ፤","poem":1},{"text":"አት ሎልቶተኬኘ ወጅን ህንባኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አከ ኑ ዲኖተኬኘ በቀኑ ኑ ጎቴርተ፤","poem":1},{"text":"ወር ኑ ጅበንስ ኑ ሳመኒሩ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አት አከ ሆሎተ ቀለሙፍ ቆጴፈመኒ ኑ ጎቴርተ፤","poem":1},{"text":"ኦርሞተ ኬሰስ ኑ ብትኔስቴርተ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሰበኬ ገቲ ጥናት ጉርጉርቴርተ፤","poem":1},{"text":"ጉርጉርታሳኒራስ ቡኣ ህንአርገኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ኦላኬኘ ዱረት ነመ ኮልፋ፣","poem":1},{"text":"ወረ ናኖኬኛ ብረትስዋን ቆሳቲፊ ነመ ቱፊ ኑ ጎቴርተ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኦርሞተ ኬሰት ዋን መማክሳ ኑ ጎቴ፤","poem":1},{"text":"ነሞትንስ መታ ኑት ራሰን።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሰልጵንኮ ጉያ ጉቱ ፉለኮ ዱረ ጅረ፤","poem":1},{"text":"ፉልኮስ ቃኒዻን ሀጉገሜረ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኩንስ ሰበቢ ዱቢ ወረ ነ ቱፈተኒቲፊ ወረ ነ አረብሰኒቲፍ፣","poem":1},{"text":"ሰበቢ ዲናቲፊ ሰበቢ ነመ ሃሎ ባፈቱቲፍ ተኤ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ኩን ሁንድ ኑት ዹፌረ፤","poem":1},{"text":"ተኡስ ኑ ስ ህንደገትኔ፤","poem":2},{"lineBreak":true},{"text":"ዮካን ከኩኬ ኬሰት አመነሙማ ህንዸብኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ገራንኬኘ ዱግደ ዱበት ህንዴብኔ፤","poem":1},{"text":"ተርካንፊንኬኘስ ከራኬራ ህንጀልአትኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አት ገሩ እዶ ዋንጎትን ጅራተንት ኑ ጨጨብስቴ፤","poem":1},{"text":"ዱከነ ሀማዻን ኑ ሀጉግዴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ኡቱ ኑ መቃ ዋቀኬኛ እራንፈትኔ፣","poem":1},{"text":"ዮካን ኡቱ ሀርከኬኘ ገረ ዋቀ ኦርማት በልእፈትኔ ጅራትኔ፣","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ስላ ዋቅን ዋን ከነ ብረ ህንገኡ ቱሬ?","poem":1},{"text":"እን እጪቲ ገራ ነማ ቤካቲ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ኑ ሲፍ ጄኔ ጉያ ጉቱ ንአጄፈምነ፤","poem":1},{"text":"አከ ሆሎተ ቀለሙፍ ጅረኒትስ ለካአምኔረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ያ ጎፍታ ደመቅ! አት ማሊፍ ረፍተ?","poem":1},{"text":"ከእ! በረ በራንስ ኑ ህንገትን።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"አት ማሊፍ ፉለኬ ዾክፈተ?","poem":1},{"text":"ማሊፍስ ዽጵናፊ ሀጩጨሙኬኘ እራንፈተ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ሉቡንኬኘ ብዮት ደበለምቴርቲ፤","poem":1},{"text":"ገራንኬኘስ ለፈት መጠኔረ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ከኢቲ ኑ ገርጋር፤ ሰበቢ ጃለለኬ","poem":1},{"text":"ከን ህንጌደረምኔቲፍስ ኑ ፉር።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}