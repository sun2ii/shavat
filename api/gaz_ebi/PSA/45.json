{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":45,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ዬደሎ እልማን ቆራህ ከን “ደራራ” ጄዸሙ። መስኪል። ፋርፈትና ጭዻ።"]},{"type":"verse","number":1,"content":[{"text":"ዮሙ አን ሞቲዻፍ ፋርፈዹት፣","poem":1},{"text":"ያድን ጋሪን ገራኮ ጉቴረ ዸንገለአ፤","poem":2},{"lineBreak":true},{"text":"አረብንኮስ አኩመ ቢሪ በሬሳ ኦጌሰ ቶኮት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"አት ነመ ሁንዱማ ጫላ ሚዸጋዸ፤","poem":1},{"text":"ህዺኬረ ሱራቱ ዸንገለአ፤","poem":2},{"lineBreak":true},{"text":"ከናፉ ዋቅን በረ በራን ስ ኤብሴረ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ያ ጎትቸ፣ ጎራዴኬ ሉቄቱት ህዸዹ፤","poem":1},{"text":"ኡልፍናፊ ሱራ ኡፈዹ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሰበቢ ዱቢ ዹጋቲፍ፣ ገድ ኦፍ ቀቢሳፊ ቀጄሉማቲፍ፣","poem":1},{"text":"ሚዸግነኬቲን ሞአናዻን ፉለ ዱረት ጉሉፍ፤","poem":2},{"lineBreak":true},{"text":"ሀርክኬ ምርጋስ ሆጂ ሶዳችሳ ሃሆጄቱ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ጥየወንኬ ቀረ ቀቤዪን ሱን ኦኔ ዲኖተ ሞቲ ሃወራነን፤","poem":1},{"text":"ሰቦትንስ ሚለኬ ጀለት ሃጅጅገኒ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ያ ዋቀዮ፣ ቴሶንኬ በረ በራ ሀመ በረ በራት ንጅራተ፤","poem":1},{"text":"ቦኩን ቀጄሉማስ ቦኩ ሞቱማኬቲ ንተአ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አት ቀጄሉማ ጃለተ፤ ጀልእነሞ ንጅብተ፤","poem":1},{"text":"ከናፉ ዋቀዮ፣ ዋቅንኬ ህርዮተኬ ጫላት፣","poem":2},{"lineBreak":true},{"text":"ዘይቲዻን ገመቹ ስ ድቤረ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኡፈትንኬ ሁንድኑ ቁምቢዻን፣","poem":1},{"text":"አርጌሳፊ ቁንዺዻን ንኡርጋአ፤","poem":2},{"text":"መሰራወን እልከ አርባቲን ሚዸግፈመን ኬሰትስ","poem":1},{"text":"ሙዚቃን ምአ ርቡ ስ ገመቺሰ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እንተለን ሞቶታ ዱበርቶተኬ ወረ ከበጀሞ ኬሰ ጅሩ፤","poem":1},{"text":"ሞትቲንስ ወርቄ ኦፊሪቲን ሚዸግፈምቴ","poem":2},{"lineBreak":true},{"text":"ከራ ሀርከ ምርገኬቲ ዻበት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ያ እንተላ ዸገእ፤ ሁበዹ፤ ጉረኬስ አስ ቀብ፤","poem":1},{"text":"ሰበኬቲፊ መነ አባኬቲ እራንፈዹ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሞቲን ሚዸግነኬ ሀወ፤","poem":1},{"text":"ዋን እን ጎፍታኬ ተኤፍ እሰ ከበጅ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እንተል ጢሮስ ኬና ፍዴ ዹፍት፤","poem":1},{"text":"ሶሬዪንስ ገራ ስ ላፍፈቹ በርባዱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"እንተል ሞቲ ኡልፍነ ጉዳዻን ዲንቀሼ ጅርት፤","poem":1},{"text":"ኡፈትን እሼስ ወርቄዻን ዸአሜ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እሼንስ ኡፈተ ሀሉ ገራ ገራ ቀቡ ኡፈቴገረ ሞቲት ጌፈምት፤","poem":1},{"text":"ዱርቦን ዋኤልሼስ እሼ ዱካ ቡአኒገረኬት ፍደሙ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እሳንስ ገመቹፊ እልሌዻን ኦል ገልፈሙ፤","poem":1},{"text":"መሰራ ሞትቻስ ንሴኑ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"እልማንኬ እዶ አቦቲኬቲ ቡአን፤","poem":1},{"text":"አትስ ለፈ ሁንደረት እሳን ንሞስፍተ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አን አከ መቃንኬ ዸሎተ ሁንደ ኬሰት ያደተሙ ነንጎዸ፤","poem":1},{"text":"ከናፉ ሰቦትን በረ በራ ሀመ በረ በራት ስ ጀጀቱ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":17}