{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና እልማን ቆራህ። ሃለ አላሞቲቲን።"]},{"type":"verse","number":1,"content":[{"text":"ዋቅን ደኦፊ ጀብነኬኘ፤","poem":1},{"text":"እን ገርጋርሰ ዬሮ ሁንደ ረክነ ኬሰት ኑ ወጅን ጅሩዸ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ከናፉ ዮ ለፍት ራፈምቴ","poem":1},{"text":"ቱሉወንስ ገራ ገላና ኬሰ ገድ ቡአንዩ ኑ ህንሶዳትኑ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኡቱ ብሻንሳስ ሁርሴ ሆመቻኤ","poem":1},{"text":"ቱሉወንስ ራፈመሳቲን ሶቾአንዩ ኑ ህንሶዳትኑ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ለግን ያኣንሳ መጋላ ዋቃ ገመቺሱ","poem":1},{"text":"ከን እዶ ቁልቁሉ ዋቅን ዋን ሁንዳ ኦሊ ጅራቱፍገመቹ ኬኑ ቶኮ ጅረ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዋቅን መጋለቲ ኬሰ ጅረ፤ እሼንስ ህንራፈምቱ፤","poem":1},{"text":"ገነመ በሪ ዋቅን እሼ ገርጋረ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሰቦትን ንራፈመን፤ ሞቱሞንስ ንኩፈን፤","poem":1},{"text":"እን ሰገሌሳ ዸጌስሴ፤ ለፍትስ ንበቅጤ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ዋቀዮ ዋን ሁንደ ደንደኡ ኑ ወጅን ጅረ፤","poem":1},{"text":"ዋቅን ያቆብ ደኦኬኘ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ኮታ፣ ሆጂ ዋቀዮ እላላ፤","poem":1},{"text":"በዲሰ እን ለፈረት ፍዴስ አርጋ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እን ሀመ ሀንዳረ ለፋት ወራነ ንበሌሰ፤","poem":1},{"text":"እዳ ንጨብሰ፤ ኤቦ ንቡርኩቴሰ፤","poem":2},{"lineBreak":true},{"text":"ጋቸነስ እብዳን ጉበ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“ጨልእሳ፤ አከ አን ዋቀ ተኤስ ቤካ፤","poem":1},{"text":"አን ሰቦተ ግዱት ኦል ኦል ነንጄዸ፤","poem":2},{"lineBreak":true},{"text":"ለፈረትስ ኦል ኦል ነንጄዸ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ዋቀዮ ዋን ሁንደ ደንደኡ ኑ ወጅን ጅረ፤","poem":1},{"text":"ዋቅን ያቆብ ደኦኬኘ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}