{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና እልማን ቆራህ።"]},{"type":"verse","number":1,"content":[{"text":"እስን ሰቦትን ሁንድኑ ሀርከኬሰን ሩኩታ፤","poem":1},{"text":"ሰገሌ ኦል ፉዸዻቲ ገመቹዻን ዋቃፍ እልልቻ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዋቀዮ ዋቀ ዋን ሁንዳ ኦሊ፣","poem":1},{"text":"ሞትች ጉዳን ለፈ ሁንዱማ፣ ሶዳችሳዻቲ!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እን ሰቦተ ኑ ጀለ፣","poem":1},{"text":"ነሞተ ስ ሚለኬኘ ጀለ ገልቼረ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እንስ ኑ ወረ ያቆብ እሰ እን ጃለቴ ሰናፍ ኡልፍነ ታኔፍ፣","poem":1},{"text":"ዻለኬኘ ኑ ፍሌረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ዋቅን እልሌዻን፣ ዋቀዮ ሰገሌ","poem":1},{"text":"መለከታቲን ኦል በኤ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ፋርፈትና ገለታ ዋቃፍ ፋርፈዻ፤","poem":1},{"text":"ፋርፈትና ገለታ ፋርፈዻ፤","poem":2},{"text":"ፋርፈትና ገለታ ሞቲኬኛፍ ፋርፈዻ፤","poem":1},{"text":"ፋርፈትና ገለታ ፋርፈዻ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ዋቅን ሞቲ ለፈ ሁንዳት፤","poem":1},{"text":"ፋርፈትና ገለታ ሁበትናዻን ፋርፈዻ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዋቅን ሰቦተረት ሞቲዸ፤","poem":1},{"text":"ዋቅን ቴሶሳ ቁልቁሉረ ታኤረ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ቆንዳልቶትን ሰቦታ፣","poem":1},{"text":"አኩመ ሰበ ዋቀ አብረሃምት ወልት ቀበሙ፤","poem":2},{"text":"ሞቶትን ለፈራ ከን ዋቃቲ፤","poem":1},{"text":"እንስ ጉድሴ ኦል ኦል ጄዼረ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}