[{"text":"አትስ ቡቤ በአ ቢፍቱቲን","poem":1},{"text":"ዶኒወን ተርሺሽ ጨጨብስቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"አኩመ ዸጌኜ ሰነ፣","poem":1},{"text":"መጋላ ዋቀዮ ዋን ሁንደ ደንደኡ ኬሰት፣","poem":2},{"text":"መጋላ ዋቀኬኛ ኬሰት፣ አከሱመ አርግኔረ፤","poem":1},{"text":"ዋቅን በረ በራን ጀቤሴ እሼ ዻበ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ያ ዋቀዮ፣ ኑ መነ ቁልቁሉማኬ ኬሰት፣","poem":1},{"text":"ጃለለኬ ከን ህንጌደረምኔ ሰነረ ዴዴብኔ ያድነ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ያ ዋቀዮ፣ ገለንኬ አኩመ መቃኬቲ","poem":1},{"text":"ሀንዳረ ለፋ ገአ፤","poem":2},{"lineBreak":true},{"text":"ሀርክኬ ምርጋስ ቀጄሉማን ጉተሜረ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሰበቢ ሙርቲኬቲቲፍ፣","poem":1},{"text":"ቱሉን ጥዮን ሃገመዱ፤","poem":2},{"lineBreak":true},{"text":"እንተለን ይሁዳስ ሃእልልቸን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ጥዮንረ ናነኣ፤ ናኖሼረስ አዴማ፤","poem":1},{"text":"ገሞወንሼስ ለካኣ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዸሎተ እት ኣኑት አከ ህምተኒፍ፣","poem":1},{"text":"ደላ ኤጉምሰሼ ስሪት ሁበዻ፤","poem":2},{"lineBreak":true},{"text":"ገልመሼስ እላላ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ዋቅን ኩን በረ በራ ሀመ በረ በራት ዋቀኬኛቲ፤","poem":1},{"text":"እን ሀመ ዹማትሌ ኑ ቀጄልቸ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}