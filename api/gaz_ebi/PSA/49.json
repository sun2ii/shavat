{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":49,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና እልማን ቆራህ።"]},{"type":"verse","number":1,"content":[{"text":"ያ ነሞተ፣ እስን ሁንድ ዋን ከነ ዸገኣ፤","poem":1},{"text":"ወር አዱኛ ከነረ ጅራተን ሁንድኑ ዸጌፈዻ፤","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ጥናፊ ጉዳን፣ ሶሬሲፊ ህዬስ ወሉማን","poem":1},{"text":"ዸጌፈዻ፤ ኩንስ፦","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አፋንኮ ዱቢ ኦጉማ ዱበተ፤","poem":1},{"text":"ወንት አን ገራት ያዱስ ሁበትና ኬነ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጉረኮ ገረ መማክሳት ነንቀበዸ፤","poem":1},{"text":"ህቦኮስ በገናዻን ነንእብሰዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"በረ ረክና፣ ዬሮ ጎዎምስቶትን ሀሞን","poem":1},{"text":"ነ መርሰንት፣ አን ማሊፈን ሶዳዸ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እሳን ቀቤኘሳኒ አመነቱ፤","poem":1},{"text":"ጉድነ ሶሩመሳኒቲንስ ቦኑ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ነምን ሉቡ ነመ ገረ ብራ ፉሩ፣","poem":1},{"text":"ዮካን ገቲ ፉሪ ነመ ሰና ዋቃፍ ባሱ ቶኮዩ ህንጅሩ፤","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ፉሪን ሉቡ ነማ ገቲ ጉዳ ቀባቲ፤","poem":1},{"text":"ገቲን ቁፍሳንስ ዮምዩ ህንአርገሙ፤","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ስላ እን በረ በራን ንጅራተ፤","poem":1},{"text":"ህንቶርቶሩስ ቱሬ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አከ ኦጌዪን ዱአን ነምን ሁንድኑ ንአርገ፤","poem":1},{"text":"ጎዎትኒፊ ራቱወንስ አከሱመ ንበዱ፤","poem":2},{"lineBreak":true},{"text":"ቀቤኘሳኒስ ወረ ካኒፍ ዺሱ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እሳን ዮ ለፈ መቃሳኒቲን ዋመምቱ ቀባተንሌ፣","poem":1},{"text":"አዋልሳኒ በረ በራን መነሳኒ፣","poem":2},{"lineBreak":true},{"text":"ዸሎታ ሀመ ዸሎታትስ እዶ ቦቆናሳኒ ተኤ ሀፈ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ነምን ገሩ ቀቤኘ ቀባቱሌ በረ ዼራ ህንጅራቱ፤","poem":1},{"text":"እን አኩመ ብኔንሰ ዱኤ በዱት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ወን ነሞተ ኦፍት አመነተኒፊ","poem":1},{"text":"ወረ እሳን ዱካ ቡአኒ ዱቢሳኒ ሆእሰን ኤገቱ ከኑመ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እሳን አኩመ ሆላ ዱኣፍ ረመደመኒሩ፤","poem":1},{"text":"ዱት ትክሴሳኒት፤","poem":2},{"lineBreak":true},{"text":"ቶሎን ገነማን እሳንረት ኣንጎ ቀባቱ፤","poem":2},{"text":"ዸግንሳኒ መነሳኒራ ፈጋቴ አዋለ ኬሰት ንቶርቶረ፤","poem":1},{"text":"አዋልስ መነ ጅሬኘሳኒት።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዋቅን ገሩ ሉቡኮ ሁምነ ሲኦል ጀላ ባሰ፤","poem":1},{"text":"እን ዹጉማን ኦፍት ነ ፉዸተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ዮሙ ነምን ቶኮ ሶሮሙ፣","poem":1},{"text":"ዮሙ ኡልፍን መነሳስ ጉደቱ ህንሶዳትን።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እን ዮሙ ዱኡት ዋኑመ ቶኮሌ ፉዸቴ ህንዴሙቲ፤","poem":1},{"text":"ኡልፍንሳስ እሰ ወጅን ህንዸቁ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እን በረ ጅሬኘሳ ሉቡሳ ኤብሱዩ፣","poem":1},{"text":"ዮ ነሞትን ዬሮ አት ዋን ጋሪ ኦፊኬቲ ጎዸቱት ስ ጀጀንሌ፣","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እን ገረ ዸሎተ አቦቲሳ፣","poem":1},{"text":"ገረ ወረ ጎንኩማ ዴብአኒ እፈ ጅሬኛ ህንአርግኔ ንዸቀ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ነምን በዻዻን ሁበትና ህንቀብኔ፣","poem":1},{"text":"አኩመ ብኔንሳ ዱኤ በደ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":20}