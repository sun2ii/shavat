{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":5,"content":[{"type":"hebrew_subtitle","content":["ፋርፈትና ዳዊቲ ከን ኡሉሌዻን ፋርፈተሙ።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ፣ ጉረኬ ዱቢኮት ቀብ፤","poem":1},{"text":"ኣዱኮሌ ና ሁበዹ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ያ ሞቲኮፊ ዋቀኮ፣","poem":1},{"text":"እየ አን ገርጋርሳፍ እየዹ ዸጌፈዹ፤","poem":2},{"lineBreak":true},{"text":"አን ስን ከዸዻቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ያ ዋቀዮ፣ ገነማን ሰገሌኮ ንዸጌሰ፤","poem":1},{"text":"አንስ ገነማን ከዸተኮ ፉለኬ ዱረት ነንዽኤሰ፤","poem":2},{"lineBreak":true},{"text":"አብዲዻንስ ነንኤገዸ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አት ዋቀ ሀምነት ገመዱ ምት፤","poem":1},{"text":"ሀማንስ ስ ወጅን ህንጅራቱ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኦፍ ቱልቶትን ፉለኬ ዱረ ዻበቹ ህንደንደአን።","poem":1},{"text":"አትስ ወረ ጀልእነ ሆጄተን ሁንደ ንጅብተ፤","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"አት ወረ ሶበ ዱበተን ንበሌስተ።","poem":2},{"text":"ዋቀዮ ወረ ዺገ ዼቦተኒፊ","poem":1},{"text":"ወረ ነመ ጎዎምሰን ንጥሬፈተ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አን ገሩ አራረኬ ባይኤ ሰናን መነኬት ኦል ነንገለ፤","poem":1},{"text":"ስ ሶዳቹዻንስ ገድ ጄዼ","poem":2},{"lineBreak":true},{"text":"ገረ መነ ቁልቁሉማኬ ቁልቁሉ ሰናት ገረገሌ ነንሰገደ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ያ ዋቀዮ፣ ሰበቢ ዲኖተኮቲፍ ጄዺቲ","poem":1},{"text":"ቀጄሉማኬቲን ነ ዱረ ቡእ፤","poem":2},{"lineBreak":true},{"text":"ከራኬስ ፉለኮ ዱረት ና ቀጄልች።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዱቢን አፋንሳኒቲ በኡ ቶኮዩ ህንአመነሙ፤","poem":1},{"text":"ገራንሳኒ በዲሳን ጉተሜረ።","poem":2},{"text":"ላጋንሳኒ አዋለ በነማዸ፤","poem":1},{"text":"አረበሳኒቲን ንሶቡ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ያ ዋቀዮ፣ የክቶተ ተኡሳኒ እሳንት ቤክስስ!","poem":1},{"text":"ደበሳኒቲንስ ሃኩፈን።","poem":2},{"text":"ባይእነ ጩቡሳኒቲን እሳን በሌስ፤","poem":1},{"text":"እሳን ስት ፍንጭለኒሩቲ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ወር ኮሉ ስት ገለን ሁንድኑ ገሩ ሃገመደን፤","poem":1},{"text":"በረ በራንስ ገመቹዻን ሃፋርፈተን።","poem":2},{"text":"አከ ወር መቃኬ ጃለተን ስት ገመደኒፍ","poem":1},{"text":"አት ኤጉምሰኬ እሳንረ ድሪርስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ያ ዋቀዮ፣ አት ቀጄልቶተ ንኤብፍታቲ፤","poem":1},{"text":"አከ ጋቸናትስ ሱራኬቲን እሳን መርስተ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}