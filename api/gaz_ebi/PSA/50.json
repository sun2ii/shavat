{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":50,"content":[{"type":"hebrew_subtitle","content":["ፋርፈትና አሳፍ።"]},{"type":"verse","number":1,"content":[{"text":"ዋቀዮ፣ ሁምነ ቀቤስ ዱበቴ","poem":1},{"text":"በአ ቢፍቱቲ ጀልቀቤ ሀመ ልጠ ቢፍቱት","poem":2},{"lineBreak":true},{"text":"ለፈ ዋሜረ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ጥዮን እሼ ሚዸግንሼ","poem":1},{"text":"ህርእነ ህንቀብኔራ ዋቅን ንእብሰ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዋቅንኬኘ ንዹፈ፤ ህንጨልእሱስ፤","poem":1},{"text":"እብድ ሀማን ፉለሳ ዱረ፣","poem":2},{"lineBreak":true},{"text":"ቡቤን ጀባንስ ናኖሳ ጅረ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እን ሰበሳት ሙሩፍ ጄዼ፣","poem":1},{"text":"ሰሚወን ኦሊቲፊ ለፈ አከነ ጄዼ ንዋመ፦","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“ቁልቁሎተኮ ወረ ኣርሳዻን ነ ወጅን ከኩ ገለን፣","poem":1},{"text":"ገረኮት ወልት ና ቀባ።”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሰሚወን ቀጄሉማሳ ንለብሱ፤","poem":1},{"text":"ዋቅን መታንሳ አባ ሙርቲቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ያ ሰበኮ፣ ነንዱበዻቲ ዸገእ፤","poem":1},{"text":"ያ እስራኤል፣ አን ዹጋ ስት ነንበአ፦","poem":2},{"lineBreak":true},{"text":"አን ዋቅን ዋቀኬት።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አን ኣርሳኬቲፍ ስት ህንዼከሙ፤","poem":1},{"text":"ኣርሳንኬ እን ጉበሙ ዬሮ ሁንደ ፉለኮ ዱረ ጅረ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አን ደላኬ ኬሳ ኮርመ፣","poem":1},{"text":"ዮካን ከረኬ ኬሳ ኮርቤሰ ሬኤ ህንበርባዱ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ብኔንስ ቦሶና ሁንድኑ፣","poem":1},{"text":"ሆሪን ቱሉ ኩመረት ቦበኡስ ከንኮቲ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አን ስምብሮተ ቱሉወንራ ሁንደ ቤከ፤","poem":1},{"text":"ወን ለፈረ ሶሶቾኡ ሁንድኑስ ከንኮት።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አን ኡቱን ቤለኤዩ ስት ህንህመዹ ቱሬ፤","poem":1},{"text":"አዱኛፊ ወን እሼ ኬሰ ጅሩ ሁንድ ከኑመኮቲ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አን ፎን ኮሮሚ ነንኛዻ?","poem":1},{"text":"ዮካን ዺገ ሬኦታ ነንዹጋ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ኣርሳ ገለታ ዋቃፍ ዽኤስ፤ ወሬገኬሌ","poem":1},{"text":"ዋቀ ዋን ሁንዳ ኦሊቲፍ ገልች፤","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ጉያ ረክና ነ ዋመዹ፤","poem":1},{"text":"አን ስን ኦልቻ፤ አትስ ኡልፍነ ና ኬንተ።”","poem":2}]},{"type":"verse","number":16,"content":["ዋቅን ገሩ ነመ ሀማዻን አከነ ጄዸ፦",{"text":"“አት ሴረኮ ለብሱዻፍ፣","poem":1},{"text":"ከኩኮስ አፋንኬቲን ዱበቹዻፍምርገ ማሊ ቀብደ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አት አደበኮ ንጅብተ፤","poem":1},{"text":"ዱቢኮስ ኦፍ ዱበት ገተ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"አት ዮ ሀቱ አርግቴ እሰ ምቹ ጎዸተ፤","poem":1},{"text":"ኤጅቶተ ወጅንስ ቆደ ቀባተ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አት አፋንኬ ዋን ሀማ ዱበቹፍ እት ፈየደምተ፤","poem":1},{"text":"አረበኬስ ጎዎምሳዻፍ ዼሬፈተ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አት ቴሴ ኦቦሌሰኬ ሀመተ፤","poem":1},{"text":"እልመ ሃዸኬ መቃ በሌስተ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አት ዋን ከነ ሁንደ ሆጄቴርተ፤ አንሞ እኑመ ጨልእሴ፤","poem":1},{"text":"አት አኩመ ኦፊኬቲ ነ ሴቴ።","poem":2},{"text":"አመ ገሩ አን ስን እፈዸ፤","poem":1},{"text":"እፈት ባሴስ ስን ህመዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“እስን ወር ዋቀ እራንፈተን ዋን ከነ ሁበዻ፤","poem":1},{"text":"ዮ ከና አቺ አን እስን ነንጭጭረ፤","poem":2},{"lineBreak":true},{"text":"ነምን እስን ኦልቹ ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ነምን ኣርሳ ገለታ ዽኤሱ ኡልፍነ ና ኬነ፤","poem":1},{"text":"አንስ ወረ ህርእነ ህንቀብኔት ፈይሱ ዋቃ ነንአርግሲሰ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}