{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":51,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት። ፋርፈትና ከነስ እን ኤርገ በትሼባ ብረ ገኤ ቦዴ ዬሮ ናታን ራጅች ገረሳ ዹፌት ፋርፈቴ።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ፣ አኩመ ጃለለኬ","poem":1},{"text":"ከን ህንጌደረምኔ ሰናት ነ ማር፤","poem":2},{"text":"አኩመ ባይእነ አራረኬቲት፣","poem":1},{"text":"የከኮ ነራ ሀቅ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"የከኮ ሁንዱማ ነራ ዽቅ፤","poem":1},{"text":"ጩቡ ኮራስ ነ ቁልቁሌስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"አን የከኮ ቤካቲ፤","poem":1},{"text":"ጩቡንኮስ ዬሮ ሁንደ ፉለኮ ዱረ ጅረ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አን ስት፣ ሱመ ቆፈት ጩቡ ሆጄዼረ፤","poem":1},{"text":"ዋን ፉለኬ ዱረት ሀማ ተኤስ ሆጄዼረ፤","poem":2},{"text":"ከናፉ አት ሙርቲኬቲን ቀጄላዸ፤","poem":1},{"text":"ዮሙ ሙርቲ ኬንቱትስ ህንዶጎጎርቱ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዹጉመዩ አን ጩቡዻነን ዸለዼ፤","poem":1},{"text":"ዬሮ ሃትኮ ነ ኡልፎፍቴ ጀልቀቤስ ጩበማን ቱሬ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አት ኬሰ ነማት ዹጋ ሀውተ፤","poem":1},{"text":"ከናፉ ኬሰኮት ኦጉማ ነ በርሲስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ሂሶጲዻን ጩቡራ ነ ቁልቁሌስ፤ አንስ ነንቁልቁላአ፤","poem":1},{"text":"ነ ዽቅ፤ አንስ ጨቢ ጫላት ነንአዳዸ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ገመቹፊ እልሌ ነ ዸጌስስ፤","poem":1},{"text":"ለፌን አት ጨጨብስቴስ ሃእልልቹ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ፉለኬ ጩቡኮራ ዴብፈዹ፤","poem":1},{"text":"የከኮ ሁንደስ ነራ ሀቅ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ያ ዋቀዮ፣ ገራ ቁልቁሉ ነ ኬሰት ኡም፤","poem":1},{"text":"ሀፉረ ቀጄላስ ነ ኬሰት ሃሮምስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ፉለኬ ዱራ ነ ህንበሌስን፤","poem":1},{"text":"ሀፉረኬ ቁልቁሉስ ነራ ህንፉዸን።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ገመቹ ፈይነኬቲ ና ዴብስ፤","poem":1},{"text":"ነ ጅራችሱዻፍስ ሀፉረ ሰርሙ ና ኬን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"አንስ ወረ ከራኬራ ጀልአተን ነንበርሲሰ፤","poem":1},{"text":"ጩበሞትንስ ገረኬ ንዴብኡ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ያ ዋቅ፣ ዋቀ ነ ፈይፍቱ፣","poem":1},{"text":"አት ዺገ ዸንገላሱራ ነ ኦልች፤","poem":2},{"lineBreak":true},{"text":"አረብንኮስ ቀጄሉማኬ ንፋርፈተ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ያ ጎፍታ፣ ህዺኮ ና በን፤","poem":1},{"text":"አፋንኮስ ገለተኬ ለብሰ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አት ኣርሳት ህንገመዱ መሌ ስላ ነንዽኤሰ ቱሬ፤","poem":1},{"text":"ኣርሳ ጉበሙትስ ህንገመዱ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኣርሳን ዋቅን ፉዸቱ ሀፉረ ጨባዸ፤","poem":1},{"text":"ያ ዋቅ፣ አት ገራ ጨባፊ ከን ጋቡ ህንቱፈቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ጃለለኬቲን ጥዮኒፍ ዋን ጋሪ ጎዽ፤","poem":1},{"text":"ደላ ዬሩሳሌም እጃር።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዮስ አት ኣርሳ ቀጄላት፣ ቀልመ ጉበሙፊ","poem":1},{"text":"ቀልመ አኩመ ጅሩት ጉበሙት ንገመደ፤","poem":2},{"lineBreak":true},{"text":"ኮሮሚንስ እዶ ኣርሳኬረት ንዽኤፈመን።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}