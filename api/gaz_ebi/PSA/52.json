{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":52,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። መስኪሊ ዳዊት። ዶኤግ ነምን ብየ ኤዶሚ ዬሮ ገረ ሳኦሊ ዸቄ፣ “ዳዊት ገረ መነ አሂሜሌኪ ዹፌረ” ጄዼ እት ህሜት ፋርፈተሜ።"]},{"type":"verse","number":1,"content":[{"text":"ያ ነመ ጀባነነ፣ አት ማሊፍ ሀምናን ኮርተ?","poem":1},{"text":"አት ነምን ፉለ ዋቃ ዱረት ቱፈተምቱ፣","poem":2},{"lineBreak":true},{"text":"ማሊፍ ጉያ ጉቱ ኮርተ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አት ነምን ነመ ጎዎምስቱ፣","poem":1},{"text":"አረብንኬ በዲሰ ቆጴሰ፤","poem":2},{"lineBreak":true},{"text":"አረብንኬ አኩመ ቀረባ ቀረሜት።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አት ዋን ጋሪረ ዋን ሀማ ጃለተ፤","poem":1},{"text":"ዹጋ ዱበቹረሞ ሶበ ዱበቹ ጃለተ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ያ አረበ ጎዎምስቱነነ፣","poem":1},{"text":"አት ዱቢ ነመ ሚዹ ሁንደ ጃለተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ከናፉ ዋቅን በረ በራን ስ በሌሰ፦","poem":1},{"text":"እን ዱንካነኬ ኬሳ ቡቴ ስ ጭጭረ፤","poem":2},{"lineBreak":true},{"text":"ብየ ጅራቶታ ኬሳስ ስ ቡቅሰ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ቀጄልቶትን ዋን ከነ አርገኒ ሶዳተን፤","poem":1},{"text":"እሳንስ አከነ ጄዸኒ እሰት ኮልፈን፤","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“ኩኖ፣ ነምቸ ዋቀ ደኦሳ ህንጎዸን፣","poem":1},{"text":"ቆደ ከናሞ ባይእነ ቀቤኘሳ አመነቴ","poem":2},{"lineBreak":true},{"text":"ጀልእነ ኦፊት ጭቼ!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"አን ገሩ አኩመ ኤጄርሰ","poem":1},{"text":"መነ ዋቃ ኬሰት ለልሱት፤","poem":2},{"text":"በራ ሀመ በረ በራትስ፣ ጃለለ ዋቃ ከን","poem":1},{"text":"ህንጌደረምኔ ሰነ ነንአመነዸ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሰበቢ አት ዋን ከነ ጎቴፍ","poem":1},{"text":"አን በረ በራን ስን ገለቴፈዸ፤","poem":2},{"text":"ሰበቢ መቃንኬ ጋሪ ተኤፍ አን መቃኬ ነንአብደዸ።","poem":1},{"text":"ፉለ ቁልቁሎተኬ ዱረትስ ስን ሌልሰ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}