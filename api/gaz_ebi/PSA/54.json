{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ምአ ርቡቲን። መስኪሊ ዳዊት። ዬሮ ወር ዚፍ ሳኦል ብረ ዸቀኒ፣ “ዳዊት ኑ ግዱ ዾከቴ ጅረ” ጄዸንት ፋርፈተሜ።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቅ፣ መቃኬቲን ነ ፈይስ፤","poem":1},{"text":"ሁምነኬቲንስ ና ሙርቴስ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ያ ዋቅ፣ ከዸትናኮ ና ዸገእ፣","poem":1},{"text":"ዱቢ አፋንኮቲስ ዸጌፈዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ኬሱሞትን ነት ከአኒሩቲ፤","poem":1},{"text":"ወር ገራ ነማ ህንላፍኔ ሉቡኮ ገላፈቹ በርባዱ፤","poem":2},{"lineBreak":true},{"text":"እሳንስ ወረ ዋቃፍ ኡልፍነ ህንኬንኔዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ኩኖ፣ ዋቅን ገርጋራኮት፤","poem":1},{"text":"ጎፍታን ጅራችሳ ሉቡኮት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ሀምን ወረ መቃ ነ በሌሰኒ እሳኑመት ሃዴብኡ፤","poem":1},{"text":"አትስ አመነሙማኬቲን እሳን በሌስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"አን ፌዺኮቲን ኣርሳ ሲፍ ዽኤሰ፤","poem":1},{"text":"ያ ዋቀዮ፣ አን መቃኬ ነንገለቴፈዸ፤","poem":2},{"lineBreak":true},{"text":"እን ጋሪዻቲ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እን ዽጵነኮ ሁንዱማ ኬሳ ነ ባሴራቲ፤","poem":1},{"text":"እጅኮስ ኦል ኣንቱማዻን ዲኖተኮ ኦፍ ጀለት እላሌረ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}