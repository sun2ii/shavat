ext":"ገሞጂ ኬሰ ነንቡቡለ ቱሬ፤","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ስላ ቡቤ ሀማፊ ቅሌንሰ ጀባራ ፈጋዼ","poem":1},{"text":"ገረ እዶ ቦቆናኮት ነንአሪፈዸን ቱሬ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ያ ጎፍታ፣ ነሞተ ሀሞ ቡርጃጄስ፤","poem":1},{"text":"ዱቢሳኒስ ወሊን ዸእ፤","poem":2},{"lineBreak":true},{"text":"አን መጋላ ኬሰት ጎሊፊ ሎለ አርጌራቲ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እሳን ሀልከኒ ጉያ ኦል በአኒ ደላሼረ ናነኡ፤","poem":1},{"text":"ጀልእኒፊ ረክን እሼ ኬሰ ጅረ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እሼ ኬሰ በዲሰቱ ጅረ፤","poem":1},{"text":"ነመ ጩንቁርሱፊ ጎዎምሱን ዳንዲሼራ ህንዸበሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ኡቱ ዲን ነ አረብሴ፣","poem":1},{"text":"ስላ ኦብሱ ነንደንደአ ቱሬ፤","poem":2},{"text":"ኡቱ አመጃጂን ነት ከኤ፣","poem":1},{"text":"ስላ ጀላ ዾከቹ ነንደንደአ ቱሬ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ገሩ ስእ ነሙመ አከኮቲ፣","poem":1},{"text":"ህርያኮ፣ ምቹኮ ከን ነት ዽኣቱቱ ዋን ከነ ጎዼ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ቶኩማዻን መነ ዋቃ ወሊ ወጅን ዴምኔ፤","poem":1},{"text":"ሃሳ ምኣዋስ ወሊ ወጅን ሃሶፍኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ዱት ተሰ እሳንት ሃዹፉ፤","poem":1},{"text":"ኡቱመ ሉቡዻን ጅረኑ ሲኦል ኬሰ ሃቡአን፤","poem":2},{"lineBreak":true},{"text":"ሀምን መነሳኒቲፊ ገራሳኒ ኬሰ ጅራቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"አን ገሩ ዋቀ ነንዋመዸ፤","poem":1},{"text":"ዋቀዮስ ጀላ ነ ባሰ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አን ገልገለ፣ ገነማፊ ዋሬት ዽጵናን ነንእየ፤","poem":1},{"text":"እንስ ሰገሌኮ ንዸገአ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዮ ነምን ባይኤን አናን ሞርሜሌ፣","poem":1},{"text":"እን ወራነ ነት ከኤ ጀላ ሚዻ መሌ ነ ባሰ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዋቅን እን ዱሩማ ጀልቀቤ ቴሶረ ጅሩ ሱን፣","poem":1},{"text":"ነሞተ ከራሳኒ ህንጌደረትኔ፣","poem":2},{"text":"ከኔን ዋቀ ህንሶዳትኔ ንዸገአ፤","poem":1},{"text":"እሳን ቃኔሰስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ህርያንኮ ምቾተሳት ሀርከሳ ኦል ፉዸቴ፤","poem":1},{"text":"ከኩሳሌ ንጨብሴ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዱቢንሳ አኩመ ዸዻት፤ ነመ ህንቁቁ፤","poem":1},{"text":"ገራሳ ኬሰ ገሩ ሎለቱ ጅረ፤","poem":2},{"text":"ዱቢንሳ ዘይቲ ጫላ ለላፈ፤","poem":1},{"text":"ገሩ ጎራዴ ሉቅፈሜዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ያዶኬ ዋቀዮት ኬነዹ፤","poem":1},{"text":"እን ስ ጅራችሰ፤","poem":2},{"lineBreak":true},{"text":"ነምን ቀጄላን አከ ጄቀሙስ ህንጎዹ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ያ ዋቀዮ፣ አት ገሩ","poem":1},{"text":"ነሞተ ሀሞ ቦለ በዲሳ ኬሰ ንቡፍተ፤","poem":2},{"text":"ወር ዺገ ዸንገላሰኒፊ ጎዎምስቶትን፣","poem":1},{"text":"ወለካ በረ ጅሬኘሳኒዩ ህንጅራተን።","poem":2},{"lineBreak":true},{"text":"አን ገሩ ስንአመነዸ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}