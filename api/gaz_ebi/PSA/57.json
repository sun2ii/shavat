{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":57,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ዬደሎ “ህንበሌስን” ጄዹን ፋርፈተሜ። ፋርፈትና ዳዊት። ሚክታሚ። እንስ ዬሮ ሳኦል ጀላ በቀቴ ሆልቀት ገሌ ፋርፈቴ።"]},{"type":"verse","number":1,"content":[{"text":"ነ ማር፤ ያ ዋቅ ነ ማር፤","poem":1},{"text":"ሉቡንኮ ስት ኮሉ ገልቲቲ።","poem":2},{"text":"አንስ ሀመ በላን ደርቡት፣","poem":1},{"text":"ጋድሰ ቆቾኬቲ ጀለት ኮሉ ነንገለ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"አን ገረ ዋቀ ዋን ሁንዳ ኦሊት፣","poem":1},{"text":"ገረ ዋቀ ሃሎ ና ባሱት ነንእየ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እን ሰሚራ ኤርጌ ነ ኦልቸ፤","poem":1},{"text":"ወረ አከ መሌ ነ አርአን ንእፈተ፤","poem":2},{"lineBreak":true},{"text":"ዋቅን ጃለለሳቲፊ አመነሙማሳ ንኤርገ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"አን ሌንጮተ ግዱን ጅረ፤","poem":1},{"text":"አን ብኔንሶተ ነመ ኛተን፣","poem":2},{"text":"ነሞተ እልካንሳኒ ኤቦፊ ጥያ","poem":1},{"text":"ከኔን አረብንሳኒ አከ ጎራዴ ቀረማ ግዱ ጪሴረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ያ ዋቅ፣ አት ሰሚወኒን ኦልት ኦል ኦል ጄዽ፤","poem":1},{"text":"ኡልፍንኬስ ለፈ ሁንደረ ሃጅራቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"እሳንስ ክዮ ሚለኮቲፍ ካአን፤","poem":1},{"text":"ሉቡንኮስ ዽጵናን ገድ ጎግዴርት።","poem":2},{"text":"እሳን ከራኮረት ቦለ ቆተን፤","poem":1},{"text":"ገሩ እሳኑመቱ ኬሰት ኩፌ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ያ ዋቅ፣ ገራንኮ ህንራፈሙ፤","poem":1},{"text":"ገራንኮ ህንራፈሙ፤","poem":2},{"lineBreak":true},{"text":"አን ነንፋርፈዸ፤ ነንዌድሰስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ያ ሉቡኮ፣ ደመቅ!","poem":1},{"text":"ያ ክራራፊ በገና ደመቃ!","poem":2},{"lineBreak":true},{"text":"አንስ ገነማን ነንደመቀ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ያ ጎፍታ፣ አን ሰቦተ ግዱት ገለተ ሲፍ ነንገልቸ፤","poem":1},{"text":"ነሞተ ግዱትስ ዋኤኬ ነንፋርፈዸ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጃለልኬ ጉዳዸ፤ ሰሚወንስ ገኣቲ፤","poem":1},{"text":"አመነሙማንኬስ ሰሚወን ቀቀበ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ያ ዋቅ፣ አት ሰሚወኒን ኦልት ኦል ኦል ጄዽ፤","poem":1},{"text":"ኡልፍንኬስ ለፈ ሁንደረ ሃጅራቱ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}