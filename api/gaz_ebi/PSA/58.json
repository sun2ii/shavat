{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":58,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ዬደሎ “ህንበሌስን” ጄዹን ፋርፈተሜ። ፋርፈትና ዳዊት። ሚክታሚ።"]},{"type":"verse","number":1,"content":[{"text":"ያ ቡልችቶተ፣ እስን ዹጉማን ዋን ቀጄላ ዱበተኒ?","poem":1},{"text":"ነመ ግዱትስ ሙርቲ ቀጄላ ኬንተኒ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አከስ ምት፤ እስን ገራኬሰን ኬሰት ሀምነ ያዱ፤","poem":1},{"text":"ሀርክኬሰንስ ለፈረት ጎሊ ካሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ነሞትን ሀሞን ዸሎቱማ ካሰኒ ከራራ ጀልአቱ፤","poem":1},{"text":"ገደሜሰ ሃዸሳኒቲ ጀልቀበኒስ ከራራ ጎረኒ ሶበ ዱበቱ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሀዻንሳኒ አኩመ ሀዻ ቦፋት፤","poem":1},{"text":"እሳን አኩመ ቡቲ ዱዳ ጉረሳ ጩቃለቴ","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሰገሌ ነመ እሰ ራቴሱ ዮካን ነመ ዋን እቲን እሰ ራቴሱ","poem":1},{"text":"ሆጄቱ ቶኮ ዸገኡ ድዱት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ያ ዋቅ አት እልካንሳኒ አፋንሳኒ ኬሰት ጨጨብስ፤","poem":1},{"text":"ቀርፋ ሌንጮታስ ዳክ፣ ያ ዋቀዮ!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እሳን አኩመ ብሻን ዸንገለኤ በዱት ሃበደን፤","poem":1},{"text":"ዬሮ እዳ ፉታሰንት ጥይሳኒ ሃዶሙ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አኩመ ጪለሉ ዮሙ ዴሙ በቁት፣","poem":1},{"text":"አኩመ ዳእመ ኡቱ ዬሮን ህንገእን ዸለቱትስ አዱ ህንአርግን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ኡቱ ኦኮቴንኬሰን እብደ ቆራቲቲን ህንሆእን፣","poem":1},{"text":"ጂዻስ ተኡ ጎጋንሳኒ ሀጣአመኒ በሌፈሙ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ነምን ቀጄላን ዮሙ ሃሎ በኡ ከነ አርጉት ንገመደ፤","poem":1},{"text":"ሚለሳስ ዺገ ነሞተ ሀሞቲን ንዽቀተ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዮሙስ ነሞትን አከነ ንጄዹ፤","poem":1},{"text":"“ዹጉማን ነመ ቀጄላዻፍ በዻስን ጅረ፤","poem":2},{"lineBreak":true},{"text":"ዹጉማን ዋቅን ለፈረት ሙርቲ ኬኑ ጅረ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}