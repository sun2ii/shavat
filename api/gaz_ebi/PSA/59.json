{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":59,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ዬደሎ ዳዊት ከን “ህንበሌስን” ጄዹን ፋርፈተሜ። ሚክታሚ። ዳዊትስ ዬሮ ሳኦል እሰ አጄሱዻፍ ጄዼ ነሞተ ኤርጌ መነሳ ኤግስሴት ፋርፈቴ።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቅ፣ ዲኖተኮ ጀላ ነ ባስ፤","poem":1},{"text":"ወረ ነት ከአን ጀላስ ነ ፉር።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ወረ ሀምነ ሆጄተን ጀላ ነ ባስ፤","poem":1},{"text":"ነሞተ ዺገ ዸንገላሰን ጀላስ ነ በራር።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"እላ፣ እሳን ርጰኒ ነ ኤገቻ ጅሩ!","poem":1},{"text":"ያ ዋቀዮ፣ ነሞትን ሀሞን፣","poem":2},{"lineBreak":true},{"text":"ኡቱ አን በሌሳፊ ጩቡ ህንቀባትን ሎለ ነት ካሱ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አን በሌሳ ቶኮሌ ህንሆጄትኔ፤","poem":1},{"text":"እሳን ገሩ ነ ሎሉፍ ቆጳአኒሩ።","poem":2},{"lineBreak":true},{"text":"ነ ገርጋሩዻፍ ከእ፤ ረክነኮስ እላል!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ያ ዋቀዮ፣ ዋቀ ዋን ሁንደ ደንደኡ፣","poem":1},{"text":"ያ ዋቀ እስራኤል፣ ሰቦተ ሁንደ አደቡዻፍ ከእ፤","poem":2},{"lineBreak":true},{"text":"ወረ ሀምነሳኒቲን የከ ሆጄተን ቶኮሌ ህንማርን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"እሳንስ ገልገለ ገልገለ ዴብአኒ፣","poem":1},{"text":"አከ ሰሬ ጉሩርኣ መጋለቲረ ናነኡ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዋን እሳን አፋንሳኒቲ ባሰን እላል፤","poem":1},{"text":"ህዺሳኒረ ጎራዴቱ ጅረ፤","poem":2},{"lineBreak":true},{"text":"እሳንስ፣ “ኤኙቱ ኑ ዸገኡ ደንደአ?” ጄዹ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ያ ዋቀዮ፣ አት ገሩ እሳንት ኮልፍተ፤","poem":1},{"text":"ሰቦተ ሰነ ሁንዱመትስ ንቆስተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ያ ጀብነኮ፣ አን ስን ኤገዸ፤","poem":1},{"text":"ያ ዋቅ አት ደኦኮ፣","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ዋቀ ነ ጃለቱዸ።","poem":2},{"lineBreak":true},{"text":"ዋቅን ፉለኮ ዱረ ዴመ፤","poem":1},{"text":"አከ አን ዲኖተኮ ሞአኖዻን ኦፍ ጀለት እላሉ ጎዸ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ያ ጎፍታ፣ ያ ጋቸነኬኘ፣","poem":1},{"text":"አት ገሩ እሳን ህንአጄስን፤","poem":2},{"text":"ዮ ከና አቺ ሰብንኮ ንእራንፈተ።","poem":1},{"text":"ሁምነኬቲን አከ እሳን ጆረን ጎዽ፤ ገድ እሳን ዴብስስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሰበቢ ጩቡ አፋንሳኒቲፍ፣","poem":1},{"text":"ሰበቢ ዱቢ ህዺሳኒቲፍ፣","poem":2},{"lineBreak":true},{"text":"እሳን ኦፍ ቱሉማሳኒቲን ሃቀበመን።","poem":2},{"text":"ሰበቢ አባርሳፊ ሶበ እሳን ዱበተኒቲፍ፣","poem":1}]},{"type":"verse","number":13,"content":[{"text":"ዼከምሳን እሳን በሌስ፤","poem":2},{"lineBreak":true},{"text":"አከ እሳን ዴብአኒ ህንአርገምኔፍ እሳን በሌስ።","poem":2},{"text":"ከናንስ አከ ዋቅን ያቆብረት ሞቲ ተኤ፣","poem":1},{"text":"ሀመ ሀንዳረ ለፋት ንቤከመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"እሳንስ ገልገለ ገልገለ ዴብአኒ፣","poem":1},{"text":"አከ ሰሬ ጉሩርኣ፣ መጋለቲረ ናነኡ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እሳን ዋን ኛተን በርባቸ አሲፊ አች ጆሩ፤","poem":1},{"text":"ዮ ቁፉ ባተንሞ ንእዩ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አን ገሩ ዋኤ ጀብነኬቲ ነንፋርፈዸ፤","poem":1},{"text":"ገነማንስ ዋኤ ጃለለኬቲ ነንፋርፈዸ፤","poem":2},{"text":"አት ደኦኮቲ፤ ዬሮ ረክነኮትስ","poem":1},{"text":"አት እዶ አን እት ኮሉ ገሉዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ያ ጀብነኮ፣ አን ፋርፈትና ገለታ ሲፍን ፋርፈዸ፤","poem":1},{"text":"ያ ዋቅ፣ አት ደኦኮት፤","poem":2},{"lineBreak":true},{"text":"አት ዋቀ አን አብደዹዸ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}