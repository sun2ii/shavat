tent":[{"text":"እጅኮ ገዳን ፈጀጄረ፤","poem":1},{"text":"ሰበቢ ዲኖተኮ ሁንዳቲፍስ ደዸቤረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ወር ሀማ ሆጄተን ሁንድኑ ነራ ፈጋዻ፤","poem":1},{"text":"ዋቀዮ ሰገሌ ቦእቸኮ ዸገኤራቲ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዋቀዮ ዋመተኮ ዸገኤረ፤","poem":1},{"text":"ዋቀዮ ከዸትናኮ ንፉዸተ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዲኖትንኮ ሁንድኑ ሃቃነአን፤ አከ መሌስ ሃርፈተን፤","poem":1},{"text":"ቃኒ ተሳቲንስ ኦፍረ ሃገረገለን።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}