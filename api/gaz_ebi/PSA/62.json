em":1},{"text":"እን ደኦኮት፤ አን ህንራፈሙ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ፈይንኮቲፊ ኡልፍንኮ ሀርከ ዋቃ ኬሰ ጅረ፤","poem":1},{"text":"ከታንኮ ጀባን፣ እዶን አን እት ኮሉ ገሉ ዋቀ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ያ ነሞተ፣ ዬሮ ሁንደ እሰ አመነዻ፤","poem":1},{"text":"ገራኬሰንስ ፉለሳ ዱረት ዸንገላሳ፤","poem":2},{"lineBreak":true},{"text":"ዋቅን እዶ ኑ እት ኮሉ ገሉዻቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ጎሰ ቱፈተማራ ዸለቹን ሆማ ምት፤","poem":1},{"text":"ጎሰ ከበጀማራ ዸለቹንስ ሶቡመ፤","poem":2},{"text":"ዮ መዳሊዻን መዳለመን","poem":1},{"text":"ለቸኑ ቅሌንሰ ጫላ ሰልጰቱ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዋን ሳምቻን አርገተን ህንአመነትና፤","poem":1},{"text":"ዋን ሀተሜንስ ህንኮርና።","poem":2},{"text":"ዮ ቀቤኝኬሰን ጉደቴሌ፣","poem":1},{"text":"ቀልቢኬሰን እሰረ ህንካአትና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ዋቅን ዬሮ ቶኮ ዱበቴ፤","poem":1},{"text":"አንሞ ዬሮ ለመ ነንዸገኤ፤","poem":2},{"text":"ኩንስ አከ ሁምን ከን ዋቃ ተኤዸ።","poem":1}]},{"type":"verse","number":12,"content":[{"text":"ያ ጎፍታ አራር ከንኬት።","poem":2},{"text":"አት ዹጉማን ቶኮ ቶኮ ነማ","poem":1},{"text":"አኩመ ሆጂሳት ገቲሳ ንኬንታፍ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}