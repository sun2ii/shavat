rse","number":7,"content":[{"text":"ዋን አት ገርጋርሰኮ ታቴፍ፣","poem":1},{"text":"አን ጋድሰ ቆቾኬቲ ጀለት ገመቹዻን ነንፋርፈዸ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሉቡንኮ ስት መጠንት፤","poem":1},{"text":"ሀርክኬ ምርጋ ኦል ነ ቀበ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ወር ሉቡኮ ገላፈቹ በርባደን ገሩ","poem":1},{"text":"ቦለ ለፋ እሰ ገድ ፈጎ ኬሰ ቡኡ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እሳን ደበርፈመኒ ጎራዴት ኬነሙ፤","poem":1},{"text":"ኛተ ዋንጎስ ንተኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ሞቲን ገሩ ዋቃት ንገመደ፤","poem":1},{"text":"ነምን ዋቃን ከከቱ ሁንድኑ ኡልፍነ አርገተ፤","poem":2},{"lineBreak":true},{"text":"አፋን ወረ ሶበ ዱበቱሞ ንጩፈመ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}