{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቅ፣ ዮሙ አን እየዹ ሰገሌኮ ዸገእ፤","poem":1},{"text":"ሉቡኮስ ዶርስሱ ዲና ዱራ ባስ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"መሪ ጀልኦታ ዱራ፣","poem":1},{"text":"መለ ነሞተ ሀሞ ዱራስ ነ ዾክስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"እሳን አረበሳኒ አከ ጎራዴ ቀረተን፤","poem":1},{"text":"ዱቢ ሀዻኣስ አኩመ ጥያት ቆጴፈቱ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እሳን ርጰኒ ነመ የከ ህንቀብኔት ፉታሱ፤","poem":1},{"text":"አኩመ ተሳስ ሶዳ መሌ እት ገድ ዺሱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ካዮ ጀልእናረት ወል ጀጀቤሱ፤","poem":1},{"text":"ዋኤ ዾክሰኒ ክዮ ካኡስ ንመርአቱ፤","poem":2},{"lineBreak":true},{"text":"“ኤኙቱ እሰ አርጉ ደንደአ?” ጄዸኒስ ንያዱ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እሳንስ ጀልእነ ያዱዻን፣","poem":1},{"text":"“ኑ መለ ህርእነ ህንቀብኔ መለኔረ!” ጄዹ፤","poem":2},{"lineBreak":true},{"text":"ያድኒፊ ኬስ ገራ ነማ ገድ ፈጎዻቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ዋቅን ገሩ ጥየሳ እሳንት ፉታሰ፤","poem":1},{"text":"እሳንስ አኩመ ተሳ መዳኡ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እንስ አረቡመ እሳኒቲን እሳን በሌሰ፤","poem":1},{"text":"ወር እሳን አርገን ሁንድኑ ቱፊዻን መታ ራሱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ነሞትን ሁንድኑ ንሶዳቱ፤","poem":1},{"text":"እሳን ሆጂ ዋቃ ንለብሱ፤","poem":2},{"lineBreak":true},{"text":"ዋን እን ሆጄቴሌ ንቀልቤፈቱ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ነምን ቀጄላን ዋቀዮት ገመደ፤","poem":1},{"text":"እሰትስ ኮሉ ገለ፤","poem":2},{"lineBreak":true},{"text":"ገረ ቶሌዪን ሁንድኑ እሳን ኡልፍነ አርገቱ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}