{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":65,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቅ፣ ጥዮን ኬሰት ገለተቱ ስ ኤገተ፤","poem":1},{"text":"ወሬግንኬኘስ ሲፍ ገልፈመ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ያ እሰ ከዸትና ነማ ዸጌሱ፣","poem":1},{"text":"ነምን ሁንድኑ ገረኬ ንዹፈ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዬሮ ጩቡን ነ ሞአቴት፣","poem":1},{"text":"አት የከኬኘ ኑ ዺፍቴርተ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ወር አት ፍለቴ አከ እሳን ቄኤኬ ጅራተኒፍ","poem":1},{"text":"ኦፍት ዽኤስቴ ኤብፈሞዸ!","poem":2},{"text":"ኑስ ዋን ጋሪ መነኬቲቲን፣","poem":1},{"text":"ከን መነ ቁልቁሉማኬቲቲንስ ንቁፍነ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ያ ዋቅ ፈይሳኬኘ፣","poem":1},{"text":"አት ሆጂ ቀጄሉማ ሶዳችሳዻንዴቢ ኑ ኬንተ፤","poem":2},{"text":"ዳሪ ለፋ ሁንዱማፍ፣","poem":1},{"text":"ገላነ ፈጎት አርገሙፍስ አት አብዲዸ፤","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አት ሁምነ ኡፈቴርተ፤","poem":1},{"text":"ጀብነኬቲንስ ቱሉወን ሁንዴስቴ፤","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አት ሁርሳ ገላና፣","poem":1},{"text":"ሁርሳ ዸኣ ብሻኒ፣","poem":2},{"lineBreak":true},{"text":"ራፈመ ኡመታስ ንጨልእሲፍቴ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ወር ፈጎ ጅራተን ድንቂወንኬ ንሶዳቱ፤","poem":1},{"text":"አት ዬሮ በርኡፊ ዬሮ ዽኡት፣","poem":2},{"lineBreak":true},{"text":"አከ ፋርፈናን ገመቹ ፋርፈተሙ ንጎተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"አት ለፈ ንኤግደ፤ ብሻንስ ንኦባፍተ፤","poem":1},{"text":"አከ መሌስ ንገብፍተ፤","poem":2},{"text":"አከ ነሞታፍ ምዻን ኬነኒፍስ","poem":1},{"text":"ለጌን ዋቃ ብሻኒን ጉተመኒሩ፤","poem":2},{"lineBreak":true},{"text":"አት ከኑማፍ ቆጴስቴርታቲ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ቦኦሳ ብሻን ቁብስተ፤","poem":1},{"text":"ብዮሳስ ወል ቅጤስተ፤","poem":2},{"text":"ቲፉ ቦካቲንስ ንጂፍተ፤","poem":1},{"text":"ብቅለሳስ ንኤብፍተ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጋሩማኬቲን በረ ንጎንፍተ፤","poem":1},{"text":"ዳንዲወንኬስ ጮመ ጮጮብሱ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ለፍት መርጋ ከን ገሞጂ አከ መሌ ምሰ፤","poem":1},{"text":"ጋረንስ ገመቹዻን ጉተሙ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ድሬወን ቡሻዬዻን ጉተሙ፤","poem":1},{"text":"ሱሉሎን ምዻኒን ሀጉገሙ፤","poem":2},{"lineBreak":true},{"text":"እሳንስ እልሌዻን እየኒ ፋርፈቱ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}