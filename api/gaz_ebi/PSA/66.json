{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":66,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና።"]},{"type":"verse","number":1,"content":[{"text":"እስን ለፍት ሁንድኑ እልሌዻን ገረ ዋቃት እያ!","poem":1}]},{"type":"verse","number":2,"content":[{"text":"ኡልፍነ መቃሳ ፋርፈዻ፤","poem":2},{"lineBreak":true},{"text":"ገለተሳቲፍስ ኡልፍነ ኬና!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዋቃን አከነ ጄዻ፤","poem":1},{"text":"“ሆጂንኬ አከም ሶዳችሳዸ!","poem":2},{"text":"ሰበቢ ሁምንኬ ጉዳ ተኤፍ፣","poem":1},{"text":"ዲኖትንኬ ፉለኬ ዱረት ሆለቱ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ለፍት ሁንድኑ ሲፍ ሰገዱ፤","poem":1},{"text":"ፋርፈትና ገለታ ሲፍ ፋርፈቱ፤","poem":2},{"lineBreak":true},{"text":"መቃኬቲፍስ ፋርፈቱ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ኮታቲ ዋን ዋቅን ሆጄቴ፣","poem":1},{"text":"ሆጂ ሶዳቺሳ እን ነማፍ ሆጄቴ እላላ!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እን ገላነ ለፈ ጎጋት ጌደሬ፤","poem":1},{"text":"እሳንስ ሚለሳኒቲን ለገ ጬአን፤","poem":2},{"lineBreak":true},{"text":"ኮታ እሰት ሃገመኑ!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እን በረ በራን ሁምነሳቲን ቡልቸ፤","poem":1},{"text":"እጅሳስ ሰቦተ እላለ፤","poem":2},{"lineBreak":true},{"text":"ፍንጭልቶትን ኦል ኦል ኦፍ ህንቀብን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ያ ሰቦተ፣ ዋቀኬኘ ኤብሳ፤","poem":1},{"text":"ሰገሌን እሰ ገለቴፈቱስ ሃዸገአሙ፤","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እን ሉቡኬኘ ጅራችሴረ፤","poem":1},{"text":"ሚለኬኘስ ሙጩጫቹ ኦልቼረ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ያ ዋቀዮ፣ አት ኑ ቆርቴርታቲ፤","poem":1},{"text":"አኩመ ሜቲስ ኑ ቁልቁሌስቴርተ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አት ክዮት ኑ ገልችቴርተ፤","poem":1},{"text":"ዱግደኬኘረስ በኣ ኬሴርተ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አከ ነሞትን መታኬኘ ያበተን ጎቴርተ፤","poem":1},{"text":"ኑ እብዳፊ ብሻን ኬሰ ደበሬ፤","poem":2},{"lineBreak":true},{"text":"አት ገሩ እዶ በዻዹማት ኑ ፍዴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"አንስ ቀልመ ጉበሙ ቀበዼመነ ቁልቁሉማኬ ነንሴነ፤","poem":1},{"text":"ወሬገኮስ ሲፍ ነንገልቸ፤","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኩንስ ወሬገ ዬሮ አን ረክነ ኬሰ ቱሬት","poem":1},{"text":"አረብንኮ ዋዳ ገሌ አፋንኮስ ዱበቴዸ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አንስ ሆሪ ጮጮሞ፣ ቀልመ ጉበሙ፣","poem":1},{"text":"ኮርቤዪ ሆላሞ ኣርሳ ጎዼ ሲፍ ነንዽኤሰ፤","poem":2},{"lineBreak":true},{"text":"ጅቦታፊ ሬኦተሌ ኣርሳ ሲፍን ዽኤሰ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እስን ወር ዋቀ ሶዳተን ሁንድ ኮታ ዸጌፈዻ፤","poem":1},{"text":"አንስ ዋን እን ናፍ ጎዼ እስንት ነንህመ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አን አፋንኮቲን እሰት ነንእዬ፤","poem":1},{"text":"ገለንሳስ አረበኮረ ቱሬ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ኡቱ አን ገራኮ ኬሰ ጩቡ ካአዼ ጅራዼ፣","poem":1},{"text":"ስላ ጎፍታን ናፍ ህንዸገኡ ቱሬ፤","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዋቅን ገሩ ዹጉማን ነ ዸጌፈቴረ፤","poem":1},{"text":"ሰገሌ ከዸትናኮቲስ ዸገኤረ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዋቅን ከዸትናኮ ህንድድን","poem":1},{"text":"ዮካን ጃለለሳ ነ ህንዾወትን ሃኤብፈሙ!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}