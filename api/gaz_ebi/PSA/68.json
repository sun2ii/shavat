{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":68,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።"]},{"type":"verse","number":1,"content":[{"text":"ዋቅን ሃከኡ፤ ዲኖትንሳስ ሃብትናአን፤","poem":1},{"text":"ወር እሰ ጅበንስ ፉለሳ ዱራ ሃበቀተን።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አኩመ ኣር ብትናኡ፣ አት እሳን ብትኔስ፤","poem":1},{"text":"አኩመ ገጋን እብደ ዱረት በቁ፣","poem":2},{"lineBreak":true},{"text":"ሀሞን ፉለ ዋቃ ዱራ ሃበደን።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ቀጄሎን ገሩ ሃገመደን፤","poem":1},{"text":"ፉለ ዋቃ ዱረትስ ባይኤ ሃገመደን፤","poem":2},{"lineBreak":true},{"text":"እሳን ገመቹዻን ሃእልልቸን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ዋቃፍ ፋርፈዻ፤","poem":1},{"text":"ፋርፈትና ገለታ መቃሳቲፍ ፋርፈዻ፤","poem":2},{"lineBreak":true},{"text":"እሰ ዱሜሳን ጉሉፉ ሰነ ጀጀዻ፤","poem":2},{"text":"መቃንሳ ዋቀዮዸ፤","poem":1},{"text":"ፉለሳ ዱረትስ ባይኤ ገመዳ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዋቅን ወረ አባ ህንቀብኔፍ አባ፣","poem":1},{"text":"ኒቶተ ዽርሶትንራ ዱአኒፍስ ፈልማ ተኤ ሱን","poem":2},{"lineBreak":true},{"text":"እዶ ጅሬኘሳ ቁልቁሉ ኬሰ ጅረ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዋቅን ወረ ኮጳ ተአን ማቲ ኬሰ ጅራችሰ፤","poem":1},{"text":"ወረ ህዸመንስ መነ ህዻቲ ባሰ፤","poem":2},{"lineBreak":true},{"text":"ፍንጭልቶትን ገሩ ለፈ ጎጋረ ጅራቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ያ ዋቀዮ፣ ጋፈ አት ሰበኬ ዱረ ባቴ፣","poem":1},{"text":"ጋፈ አት ገሞጂ ኬሰ ደበርቴ፣","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ፉለ ዋቃ፣ ዋቀ ሲና ዱረት፣","poem":1},{"text":"ፉለ ዋቃ፣ ዋቀ እስራኤል ዱረት፣","poem":2},{"lineBreak":true},{"text":"ለፍት ንራፈምቴ፤ ሰሚወንስ ቦካ ሮብሰን።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ያ ዋቀዮ፣ አት ቦካ ባይኤ ሮብስቴ፤","poem":1},{"text":"ዻለኬ ከን ደዸቤሌ ንቁብስቴ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሰብንኬ አች ቁበቴ፤","poem":1},{"text":"ያ ዋቀዮ፣ አት በዻዹማኬ ኬሳህዬዪ ሶርቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ጎፍታን ዱቢሳ ኬኔ፤","poem":1},{"text":"ዱበርቶትን ዱቢ ሰነ ለብሰንስ ባይኤዸ፦","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“ሞቶትኒፊ ሎልቶትን አሪቲን በቀተን፤","poem":1},{"text":"ዱበርቶትን ቄኤ ኦለን ቦጁ ቆደተን።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዮ ጎለ ሆሎታ ግዱት አርገምተንሌ፣","poem":1},{"text":"እስን አከ ጉጌ ቆቾንሼ ሜቲዻን ኡፍፈሜ","poem":2},{"lineBreak":true},{"text":"ባሌንሼሞ ወርቄ ጨለቅሱን ኡፍፈሜት።”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዮሙ ዋቅን ዋን ሁንደ ደንደኡ","poem":1},{"text":"ሞቶተ አችት ብትኔሴት፣ዘልሞንረት ጨቢን ቡኤ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ያ ቱሉ ባሻን፣ ያ ቱሉ ሱረ ቀቤሰ፣","poem":1},{"text":"ያ ቱሉ ባሻን፣ ያ ቱሉ ፊጤ ባይኤ ቀቡ፣","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ያ ቱሉ ፊጤ ባይኤ ቀብዱ፣","poem":1},{"text":"አት ማሊፍ ቱሉ ዋቅን ቡልቹፍ ፍለቴ፣","poem":2},{"lineBreak":true},{"text":"እዶ ዋቀዮ በረ በራን ጅራቱ ሰነህናፋዻን እላልተ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ጋሪወን ዋቃ ኩመ ሄዱዸ፤","poem":1},{"text":"እሳን ኩማተመ ዬሮ ኩማተማት፤","poem":2},{"lineBreak":true},{"text":"ጎፍታንስ ሲናዻ ገረ እዶ ቁልቁሉ ዹፌረ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"አት ዮሙ ኦል ጉባ ባቴት","poem":1},{"text":"ቦጁ ባይኤ ፉዸቴ፤","poem":2},{"text":"ያ ዋቀዮ፣ ያ ዋቅ፣ አት አች ጅራቹፍ ጄቴ፣","poem":1},{"text":"ነሞተራ፣ ፍንጭልቶተራስ ኬና ፉዸቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ጎፍታን ጉዩመ ጉያን በኣኬኘ ባቱ፣","poem":1},{"text":"ዋቅን ፈይሳኬኘ ተኤ ሱን ሃኤብፈሙ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዋቅንኬኘ ዋቀ ፈይናት፤ ዱአ ጀላ በኡንስ","poem":1},{"text":"ዋቀዮ ጎፍትቸ ብራ ዹፈ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዋቅን ዹጉማን መታ ዲነሳ፣","poem":1},{"text":"ጉቤ መታ ወረ ጩቡሳኒት ፉፈኒከን ርፌንሰ ቀቡ ንጨጨብሰ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ጎፍታን አከነ ጄዸ፤ “አን ዴብሴ ባሻኒ እሳን ነንፍደ፤","poem":1},{"text":"ቱጁበ ገላና ኬሳስ ዴብሴ እሳን ነንፍደ፤","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ኩንስ አከ አት ዺገ ዲኖተኬቲ ሚለኬቲን ቦርጭቱፍ፤","poem":1},{"text":"አረብን ሰሮተኬቲስ አከ ቆደሳኒ ቀባቱፍ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ያ ዋቀዮ፣ ህሪርኬ ሙልአቴረ፤","poem":1},{"text":"ህሪር ዋቀኮቲቲፊ ሞቲኮቲ እዶ ቁልቁሉት ኦል ገሌረ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ፉለ ዱራን ፋርፈቶተ፣","poem":1},{"text":"ዱግደ ዱባንሞ ወረ ሙዚቃ ተጰተንቱ ቱሬ፤","poem":2},{"lineBreak":true},{"text":"ዱበርቶትን ድቤ ሩኩተንስ ግዱሳኒ ቱረን።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ወልዳ ጉዳ ኬሰት ዋቀ ጀጀዻ፤","poem":1},{"text":"ያኢ እስራኤል ኬሰትስ ዋቀዮን ጀጀዻ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ቤንያም ጎስት ጥንች እሳን ዱረ ዴመ፤","poem":1},{"text":"ቱትን እልማን ሞቶተ ይሁዳስ አች ቱረን፤","poem":2},{"lineBreak":true},{"text":"እልማን ሞቶተ ዜቡሎኒፊ ንፍታሌምስ አች ቱረን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ያ ዋቀዮ፣ ሁምነኬ አጀጅ፤","poem":1},{"text":"ያ ዋቀኬኘ፣ አኩመ ዱራን ጎቴ ሰነጀብነኬ ኑ አርግሲስ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ሰበቢ መነ ቁልቁሉማኬቲ ከን ዬሩሳሌም ኬሳቲፍ","poem":1},{"text":"ሞቶትን ኬና ሲፍ ፍዱ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ብኔንሶተ ሸምበቆ ኬሳ፣","poem":1},{"text":"ከረ ኮሮሚ ጀቦተ ሰቦታ ኬሳስ እፈዹ።","poem":2},{"text":"ወረ ሜቲ ፍደን ገድ ዴብስ።","poem":1},{"text":"ወረ ወራነት ገመደንስ ብትኔስ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ኤርገሞትን ግብጥ ንዹፉ፤","poem":1},{"text":"እቶጵያንስ ደፍቴ ሀርከሼ ዋቀት በልእፈት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"ያ ሞቱሞተ ለፋ፣ ዋቀ ፋርፈዻ፤","poem":1},{"text":"ፋርፈትና ገለታስ ጎፍታዻፍ ፋርፈዻ፤","poem":2}]},{"type":"verse","number":33,"content":[{"text":"እሰ ሰሚወን ዱሪ ኬሰ ጉሉፉ፣","poem":1},{"text":"እሰ ሰገሌ ጀባዻን ቀቀዌሰኡ ሰነ ፋርፈዻ።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ዋቀ ኡልፍንሳ እስራኤልራ ጅሩ፣","poem":1},{"text":"እሰ ሚዸግንሳ","poem":2},{"lineBreak":true},{"text":"ሰሚወን ኬሰ ጅሩ ሰነ ሁምነሳ ለብሳ።","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ያ ዋቀዮ፣ አት እዶ ቁልቁሉማኬቲት ሶዳችሳዸ፤","poem":1},{"text":"ዋቅን እስራኤል ሰበሳቲፍ ሁምናፊ ጀብነ ንኬነ።","poem":2},{"lineBreak":true},{"text":"ዋቅን ሃኤብፈሙ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":35}