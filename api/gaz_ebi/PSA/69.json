{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":69,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ዬደሎ “ደራራቲን።” ፋርፈትና ዳዊት።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቅ፣ አት ነ ባስ፤","poem":1},{"text":"ብሻን ኦል ዹፌ ሞርመ ነ ገኤራቲ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አን ራሬ ኬሰ፣ ለፈ እዶን ሚለ ዻበተን","poem":1},{"text":"ህንጅሬ ኬሰ ሴኔረ።","poem":2},{"text":"አን ቱጁበ ብሻኒ ኬሰ ሴኔረ፤","poem":1},{"text":"ሎላንስ ነረ ገረገሌረ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አን እዩዻን ደዸቤረ፤","poem":1},{"text":"ላጋንኮ በበቀቄረ፤","poem":2},{"lineBreak":true},{"text":"እጅኮ፣ ዋቀኮ ኤገቹዻን ደዸቤረ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ወር ለፉማ ከአኒ ነ ጅበን","poem":1},{"text":"ርፌንሰ መታኮቲ ጫላ ባይአቱ፤","poem":2},{"text":"ወር ነ አጄሱ በርባደን፣","poem":1},{"text":"ወር አከሱማን ዲነኮ ተአን ባይኤዸ።","poem":2},{"text":"አን አከን ዋን ህንሀትን","poem":1},{"text":"ዴብሱ ድርቀሜረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ያ ዋቅ፣ አት ጎዉማኮ ንቤክተ፤","poem":1},{"text":"የክኮስ ስ ዱራ ህንዾከቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ያ ጎፍታ፣ ዋቀዮ ዋን ሁንደ ደንዴሱ፣","poem":1},{"text":"ወር አብዲ ስረ ካአተን፣","poem":2},{"lineBreak":true},{"text":"ሰበቢኮቲፍ ህንቃነእን፤","poem":2},{"text":"ያ ዋቀ እስራኤል፣ ወር ስ በርባደን፣","poem":1},{"text":"ሰበቢኮቲፍ ህንቃኔፈምን።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አን ሲፍ ጄዼ ቱፊ ኦብሴራቲ፤","poem":1},{"text":"ቃኒንስ ፉለኮ ሀጉጌረ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አን ኦቦሎተኮት ኬሱማ፣","poem":1},{"text":"እልማን ሃዸኮቲትስ አለጋዸ፤","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ህናፋን መነኬቲ ነ ጉጉቤራቲ፤","poem":1},{"text":"አረብሶን ወረ ስ አረብሰኒስ ነረ ቡኤረ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ቦኡፊ ሶሙንኮ፣","poem":1},{"text":"አረብሶ ነት ተኤ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዮሙ አን ወያ ገዳ ኡፈዼት፣","poem":1},{"text":"ነሞትን ነት ቆሱ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ወር ከረ ዱረ ተታአን ነት ቆሱ፤","poem":1},{"text":"መቾፍቶትንስ ዋኤኮቲን ስርቡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"አን ገሩ ያ ዋቀዮ፣","poem":1},{"text":"ዬሮ አት ፍለቱት ስን ከዸዸ፤","poem":2},{"text":"ያ ዋቅ፣ ጃለለኬ ጉድቻን","poem":1},{"text":"ፈይነኬ ከን ዹጋቲንስ ዴቢ ናፍ ኬን።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አከ አን ህንልቅምፈምኔፍ፣","poem":1},{"text":"ራሬ ኬሳ ነ ባስ፤","poem":2},{"text":"ወረ ነ ጅበን ጀላ፣","poem":1},{"text":"ብሻኖተ ገድ ፈጎ ኬሳስ ነ ባስ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አት አከ ሎላን ነ ህንፉዸትኔ፣","poem":1},{"text":"አከ ቱጁብን ነ ህንልቅምስኔ፣","poem":2},{"lineBreak":true},{"text":"አከ ቦልስ አፋንሳ ነት ህንጩፈትኔ ጎዽ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ያ ዋቀዮ፣ ጋሩማ ጃለለኬቲቲንዴቢ ናፍ ኬን፤","poem":1},{"text":"አራረኬ ጉድቻንስ ነት ገረገል።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ፉለኬ ተጃጅላኬ ዱራ ህንዾክፈትን፤","poem":1},{"text":"ዋን አን ረክነ ኬሰ ጅሩፍ ደፊቲ ዴቢ ናፍ ኬን።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ነት ዽኣዹቲ ነ ፉር፤","poem":1},{"text":"ጢቂ ዲኖተኮቲፍ ጄዺ ነ ባስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"አት አከ አን ሀመም ቱፈተሜ፣","poem":1},{"text":"ሰልጵፈሜፊ አከ አን ቃኔፈሜ ንቤክተ፤","poem":2},{"lineBreak":true},{"text":"ዲኖትንኮ ሁንድኑስ ፉለኮ ዱረ ጅሩ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አረብሶን ገራኮ ጨብሴ፤","poem":1},{"text":"አንስ አብዲ ኩተዼረ።","poem":2},{"text":"አን ነመ ገራ ናፍ ላፉ ነንበርባዴ፤ ገሩ ነንዸቤ፤","poem":1},{"text":"ነመ ነ ጀጀቤሱስ ነንበርባዴ፤ገሩ ቶኮሌ ህንአርገኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ኛተኮት ሀዾፍቱ መከን፤","poem":1},{"text":"አከ አን ዹጉፍሞ ዋን ዸንገጋኣ ና ኬነን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ማዲንሳኒ እዳ እሳንት ሃተኡ፤","poem":1},{"text":"አደባፊ ክዮ እሳንት ሃተኡ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"አከ አርጉ ህንደንዴኜፍ እጅሳኒ ሃሀጉገሙ፤","poem":1},{"text":"ዱግድሳኒስ በረ በራን ሃጎጰቱ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዼከምሰኬ እሳንረት ዸንገላስ፤","poem":1},{"text":"ኣሪንኬ ቦበኣን ሱንስ እሳንረ ሃቡኡ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ቄኤንሳኒ ሃኦኑ፤","poem":1},{"text":"ነምን ዱንካነሳኒ ኬሰ ጅራቱ ቶኮዩ ህንሀፍን።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"እሳን ወረ አት መዴስቴ ሰነ ንአርአቱቲ፤","poem":1},{"text":"ዋኤ ዹኩቢ ወረ አት ሚቴ ሰናስ ንኦዴሱ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"የከረት የከ እሳንት ደበል፤","poem":1},{"text":"እሳን ገረ ቀጄሉመኬቲ ህንዹፍን።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"መቃንሳኒ ክታበ ጅሬኛ ኬሳ ሃሀቀሙ፤","poem":1},{"text":"ቀጄልቶተ ወጅንስ ህንገልሜፈምን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"አን ገሩ ዽጵናፊ ረክነኬሰን ጅረ፤","poem":1},{"text":"ያ ዋቅ፣ ፈይንኬ ኦል ነ ሃቀቡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"አን ፋርፈናዻን መቃ ዋቃ ነንገለቴፈዸ፤","poem":1},{"text":"ገለታንስ ኡልፍነ ነንኬናፍ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ኩንስ ሰንጋ ጫላ፣ ኮርመ ጋንፋፊ","poem":1},{"text":"ኮቴ ቀቡ ዽኤሱ ጫላ ዋቀዮን ገመቺሰ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ህዬዪን ዋን ከነ አርገኒ ንገመዱ፤","poem":1},{"text":"እስን ወር ዋቀ በርባደን ገራንኬሰን ጅራተ ሃተኡ!","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ዋቀዮ ረከቶተ ንዸገአ፤","poem":1},{"text":"ነሞተሳ ወረ ህዸመንስ ህንቱፈቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"ሰሚፊ ለፍት፣ ገላኖትኒፊ","poem":1},{"text":"ወን እሳን ኬሰ ጅራተን ሁንድኑ እሰ ሃሌልሰን።","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ዋቅን ጥዮንን ንፈይሳቲ፤","poem":1},{"text":"መጋላወን ይሁዳስ ዴብሴ ንእጃረ።","poem":2},{"text":"ሰብንሳስ አች ቁበተ፤ ንዻለስ።","poem":1}]},{"type":"verse","number":36,"content":[{"text":"ሰኚን ተጃጅልቶተሳ መጋለቲ ንዻሉ፤","poem":2},{"lineBreak":true},{"text":"ወር መቃሳ ጃለተንስ አች ጅራቱ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}