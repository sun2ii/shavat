{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":7,"content":[{"type":"hebrew_subtitle","content":["ሺጋዮን ዳዊት ከን እን ዋኤ ኩሽ ነምቸ ጎሰ ቤንያሚፍ ጄዼ ዋቀዮፍ ፋርፈቴ።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ ዋቀኮ፣ አን ኮሉ ስት ነንገለ፤","poem":1},{"text":"ወረ ነ አርአተን ሁንደ ጀላ ነ ባስ፤ ነ ኦልችስ፤","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዮ ከና አቺ እሳን ዬሮ ነምን ነ ኦልቹ ህንጅሬት፣","poem":1},{"text":"አከ ሌንጫ ነ ጭጭረቱ፤ ነ ኩኩተቱስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ያ ዋቀዮ ዋቀኮ፣ ዮ አን ዋን ከነ ጎዼ ጅራዼ","poem":1},{"text":"ዮ ሀርከኮ ኬሰ የክ ጅራቴ፣","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዮ አን ነመ ነጋዻን ነ ወጅን ጅራቱት ሀማ ሆጄዼ ጅራዼ፣","poem":1},{"text":"ዮካን ዮ አን ሰበቢ መሌ ዲነኮ ሳሜ ጅራዼ፣","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዲንኮ አርኤ ነ ሃቀበቱ፤","poem":1},{"text":"ጅሬኘኮ ለፈት ሃዽዺቱ፤","poem":2},{"lineBreak":true},{"text":"ኡልፍነኮስ አዋረ ኬሰ ሃቡሱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ያ ዋቀዮ ኣሪኬቲን ከእ፤","poem":1},{"text":"ዼከምሰ ዲኖተኮት ከእ።","poem":2},{"lineBreak":true},{"text":"ያ ዋቀኮ አናፍ ደመቅ፤ ሙርቲ ቀጄላ ለብስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ያኢን ነሞታ ናኖኬት ወልት ሃቀበሙ፤","poem":1},{"text":"አትስ ኦል ጉባዻ እሳን ቡልች።","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ዋቀዮ ሰቦታፍ ሙርቲ ሃኬኑ።","poem":2},{"text":"ያ ዋቀዮ፣ አከ ቀጄሉማኮቲት፣","poem":1},{"text":"አከ አመነሙማኮቲትስ ና ሙርቴስ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ያ ዋቀ ቀጄላ፣","poem":1},{"text":"ከን ያዳፊ ገራ ነማ ቆርቱ፣","poem":2},{"text":"ፍንጭለ ሀሞታ በሌስ፤","poem":1},{"text":"ቀጄልቶተሞ ጀቤሲ ዻብ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ጋቸንኮ ዋቀ፤","poem":1},{"text":"እን ገረ ቶሌዪ ንኦልቸ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዋቅን አባ ሙርቲ ቀጄላዸ፤","poem":1},{"text":"እን ዋቀ ጉያ ሁንደ ዼከምሰሳ ሙልእሱዸ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዮ ነምን ቀልቢ ጅጂረቹ ባቴ፣","poem":1},{"text":"እን ጎራዴሳ ንቀረተ፤","poem":2},{"lineBreak":true},{"text":"እዳሳስ ደብሴ ቆጴፈተ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እን ሜሻ ነመ አጄሱ","poem":1},{"text":"ቆጴፈቴረ፤ ጥየ ቦበኡስ ንቆጴፈተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ኩኖ፣ ነምን ሀማን ሀምነ ኡልፋአ፤","poem":1},{"text":"ጀልእነ ገራት ባተ፤ ሶበ ዸለ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እን ገድ ፈጌሴ ቦለ ቆተ፤","poem":1},{"text":"ቦለ ቆጴሴ ሰነ ኬሰስ ንቡአ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ደብንሳ መቱመሳት ዴብአ፤","poem":1},{"text":"ጀልእንሳስ ጉቤ መታሳረ ቡአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ቀጄሉማሳቲፍ ዋቀዮን ነንገለቴፈዸ፤","poem":1},{"text":"መቃ ዋቀዮ ዋቀ ዋን ሁንዳ ኦሊስ ፋርፈናዻን ነንጀጀዸ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}