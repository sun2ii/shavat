{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":71,"content":[{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ፣ አን ኮሉ ስት ገሌረ፤","poem":1},{"text":"አት ጎንኩማ ነ ህንቃኔስን።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ቀጄሉማኬቲን ነ ባስ፤ ነ ኦልችስ፤","poem":1},{"text":"ጉረኬ ገረኮት ቀብ፤ ነ ፈይስስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አት ከታ አን ኮሉ እት ገሉ፣","poem":1},{"text":"እዶ አን ዬሮ ሁንደ እት በቀዹ ና ተእ፤","poem":2},{"text":"አት ዋን ከታኮፊ ደኦኮ ታቴፍ፣","poem":1},{"text":"ነ በራሩፍ አጀጀ ኬን።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ያ ዋቀኮ፣ ሀርከ ነመ ሀማ፣","poem":1},{"text":"ቀባ ነመ ጀልኣቲፊ ገረ ጀቤሳ ኬሳ ነ ባስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ያ ዋቀዮ ጎፍታ፣ አት አብዲኮቲ፤","poem":1},{"text":"እጆሉማኮቲ ካፍቴስ አት ዋቀ አን አመነዹዸ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አን ጋፈን ዸለዼ ጀልቀቤ ስት እርከዼረ፤","poem":1},{"text":"ገደሜሰ ሃዸኮ ኬሳስ ስቱ ነ ባሴ።","poem":2},{"lineBreak":true},{"text":"አን ዬሮ ሁንደ ስን ገለቴፈዸ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አን ነሞተ ባይኤዻፍ መለቶ ተኤረ፤","poem":1},{"text":"አት ገሩ ደኦኮ እሰ ጀባዸ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አፋንኮ ጉያ ጉቱ፣","poem":1},{"text":"ገለታፊ ኡልፍነኬቲን ጉተመ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ዬሮ አን ዱሎሙት አት ነ ህንገትን፤","poem":1},{"text":"ዬሮ ሁምንኮ ዹሙትስ ነ ህንዺስን።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዲኖትንኮ ነት መርአቱቲ፤","poem":1},{"text":"ወር ነ አጄሱፍ ርጰኒ ኤገተንስ ወሊ ወጅን ነት መርአቱ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እሳንስ፣ “ዋቅን እሰ ዺሴረ፤","poem":1},{"text":"ነምን እሰ ኦልቹ ቶኮዩ ህንጅሩቲ","poem":2},{"lineBreak":true},{"text":"ፋነ ቡኣቲ ቀባ” ጄዹ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ያ ዋቅ፣ ነራ ህንፈጋትን፤","poem":1},{"text":"ያ ዋቀኮ፣ ነ ገርጋሩፍ ደፊ ኮቱ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ወር ነ ህመተን ቃነአኒ ሃበደን፤","poem":1},{"text":"ወር ነ ሚዹ በርባደንስ","poem":2},{"lineBreak":true},{"text":"ቱፊፊ ሰልጵነ ሃኡፈተን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"አን ገሩ ዬሮ ሁንዱማ አብዲ ቀበ፤","poem":1},{"text":"እቱመ ጫልችሴስ ስን ገለቴፈዸ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አን ዮ ሀመም አከ እን ገኡ ቤኩ ባዼሌ፣","poem":1},{"text":"አፋንኮ ዋኤ ቀጄሉማኬቲቲፊ","poem":2},{"lineBreak":true},{"text":"ዋኤ ፈይሱኬቲ ጉያ ጉቱ ንኦዴሰ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ያ ዋቀዮ ጎፍታ፣ አን ዹፌ","poem":1},{"text":"ሆጂኬ ሁምነ ቀቤሰ ሰነ ነንኦዴሰ፤","poem":2},{"lineBreak":true},{"text":"አን ቀጄሉማኬ ቆፈ ለብሰ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ያ ዋቅ፣ አት እጆሉማኮቲ ጀልቀብዴ ነ በርሲፍቴርተ፤","poem":1},{"text":"አንስ ሀመ ሀርኣት ሆጂኬ ድንቅሲሳ ሰነ ነንለብሰ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ያ ዋቀዮ፣ ዬሮ አን ዱሎሜ መታንኮ አሪ ተኡትሌ፣","poem":1},{"text":"ሀመ አን ሁምነኬ ዸሎተ ከነት፣","poem":2},{"text":"ጀብነኬስ ዸሎተ ዹፉፍ ጅሩ ሁንደት ለብሱት፣","poem":1},{"text":"አት ነ ህንዺስን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ያ ዋቅ፣ ቀጄሉማንኬ ሰሚወን ብረ ገአ፤","poem":1},{"text":"አት ዋን ጉርጉዳ ሆጄቴርተ፤","poem":2},{"lineBreak":true},{"text":"ያ ዋቅ፣ ከን አከኬቲ ኤኙ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አት ረክናፊ ዽጵነ ባይኤ ነ አርግሲፍቴርተ፤","poem":1},{"text":"ተኡስ ጅሬኘኮ ዴብፍቴ ንሃሮምስተ፣","poem":2},{"lineBreak":true},{"text":"ቅሌ ለፋ ኬሳስ ዴብፍቴ ኦል ነ ባፍተ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ኡልፍነኮ ንጉድፍተ፤","poem":1},{"text":"አመሌ ነ ጀጀቤስተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ያ ዋቀኮ፣ አን አመነሙማኬቲፍ፣","poem":1},{"text":"ክራራን ስን ፋርፈዸ፤","poem":2},{"text":"ያ ቁልቁልቸ እስራኤል","poem":1},{"text":"አን ክራራን ፋርፈትና ገለታ ሲፍ ፋርፈዸ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዮሙ አን ፋርፈትና ገለታ ሲፍ ፋርፈዹት፣ ህዺንኮ፣","poem":1},{"text":"ሉቡንኮ ከን አት ፉርቴስ ጉድሰኒ ንእልልቹ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ወር ነ ሚዹ በርባደን፣","poem":1},{"text":"ዋን ቃነአኒ ቡርጃጀአኒፍ","poem":2},{"text":"አረብንኮ ጉያ ጉቱ","poem":1},{"text":"ቀጄሉማኬ ኦዴሰ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}