{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":72,"content":[{"type":"hebrew_subtitle","content":["ፋርፈትና ሶሎሞን።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቅ፣ ሙርቲኬ ሞቲዻፍ፣","poem":1},{"text":"ቀጄሉመ ኬሞ እልመ ሞቲቲፍ ኬን።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እንስ ሰበኬቲፍ ቀጄሉማዻን ሙርቴሰ፤","poem":1},{"text":"ህዬዪፍስ ሙርቲ ቀጄላ ኬነ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ቱሉወን በዻዹማ፣","poem":1},{"text":"ጋረንሞ እጀ ቀጄሉማ ሰባፍ ሃፍደን።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እን ህዬዪ ሰበ ኬሰ ጅራተኒፍ ንፈልመ፤","poem":1},{"text":"እጆሌ ረከቶታ ንኦልቸ፤","poem":2},{"lineBreak":true},{"text":"ጩንቁርስቱሞ ንበርበዴሰ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ነሞትን ሀመ አዱን ጅራቱፊ ሀመ ጅእ ጅራቱት፣","poem":1},{"text":"ዸሎታ ሀመ ዸሎታት ስ ሶዳቱ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እን አኩመ ቦካ መርገ ሃመሜረት ሮቡ፣","poem":1},{"text":"አኩመ ቲፉ ለፈ ጂሱትስ ንዹፈ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"በረሳ ኬሰ ቀጄሉማን ንደራረ፤","poem":1},{"text":"ነጌኝስ ሀመ ጅእ ዸበሙት ንባይአተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"እንስ ገላና ሀመ ገላናት፣","poem":1},{"text":"ለገ ኤፍራጢሲ ሀመ ሞጋ ለፋት ንቡልቸ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ወር ገሞጂ ኬሰ ጅራተን ፉለሳ ዱረት ንሰገዱ፤","poem":1},{"text":"ዲኖትንሳስ ብዮ አራቡ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሞቶትን ተርሺሺፊ ሞቶትን","poem":1},{"text":"ብዮተ ቀርቀረወን ገላነ ፈጎ ግብረ እሳፍ ንፍዱ፤","poem":2},{"lineBreak":true},{"text":"ሞቶትን ሼባቲፊ ሞቶትን ሳባ ኬና ንፍዱፍ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሞቶትን ሁንድኑስ እሳፍ ንሰገዱ፤","poem":1},{"text":"ሰቦትን ሁንድኑስ እሰ ንተጃጅሉ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"እን ነመ ረከቴ ገረሳት እዩ፣","poem":1},{"text":"ህዬሳፊ ነመ ገርጋርሰ ህንቀብኔ ንበራራቲ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ነመ ደዸባፊ ረከታፍ ገራ ለፈ፤","poem":1},{"text":"ነመ ረከታስ ዱአ ጀላ ባሰ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሉቡሳኒስ ሀጩጫፊ ጩንቁርሳ ጀላ ንፉረ፤","poem":1},{"text":"ዺግንሳኒ ፉለሳ ዱረት ገቲ ጉዳ ቀባቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ኡሙሪንሳ ሃዼረቱ፤","poem":1},{"text":"ወርቄን ሼባ እሳፍ ሃኬነሙ።","poem":2},{"text":"ዬሮ ሁንደ ዋቀ እሳፍ ሃከዸተን፤","poem":1},{"text":"ጉያ ጉቱስ እሰ ሃኤብሰን።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ለፈረት ምዻን አከ መሌ ሃባይአቱ፤","poem":1},{"text":"ፊጤ ቱሉወኒረስ አሲፊ አች ሃራፈሙ።","poem":2},{"text":"እጅሳ አከ ልባኖን ሃቶሉ፤","poem":1},{"text":"አከ መርገ ለፋስ ሃምሱ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"መቃንሳ በረ በራን ሃጅራቱ፤","poem":1},{"text":"አኩመ አዱስ እት ፉፌ ሃጅራቱ።","poem":2},{"lineBreak":true},{"text":"ሰቦትን ሁንድኑ እሳን ንኤብፈሙ፤","poem":1},{"text":"ጀርስ ኤብፈማ ጄዻኒ እሰ ዋሙ።","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"እን ኮጳሳ ዋን ድንቂ ሆጄቱ፣","poem":1},{"text":"ዋቀዮ ዋቅን፣ ዋቅን እስራኤል ሃኤብፈሙ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"መቃሳ ኡልፋታ ሰናፍ በረ በራን ገለን ሃተኡ፤","poem":1},{"text":"ለፍት ሁንድኑ ኡልፍነሳቲን ሃጉተሙ።","poem":2},"አሜን፤ አሜን።"]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ከዸናን ዳዊት እልመ እሴይ አስረት ጡሙረሜ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}