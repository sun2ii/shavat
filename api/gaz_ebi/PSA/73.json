:[{"text":"እሳን ንቆሱ፤ ሀምነስ ንዱበቱ፤","poem":1},{"text":"ኦፍ ቱላ ጩንቁርሳዻን ነመ ዶርስሱ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አፋንሳኒ ሰሚ ፈልመተ፤","poem":1},{"text":"አረብንሳኒስ ለፈ ዻለ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ከናፉ ሰብን ገረሳኒት ደቸኤ","poem":1},{"text":"ብሻን ባይኤ ዹገ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እሳንስ፣ “ዋቅን አከምት ቤኩ ደንደኣ?","poem":1},{"text":"ዋቅን ዋን ሁንዳ ኦሊ ቤኩምሰ ቀባ?” ጄዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ኤጋ ነሞትን ሀሞን አከነ፤","poem":1},{"text":"እሳን ዬሮ ሁንደ ያዶ መሌ ጅራቱ፤","poem":2},{"lineBreak":true},{"text":"በዻዹማንስ ጉደቻ ዴሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ዮስ አን አከሱማን ገራኮ ቁልቁልናን ኤገዼ","poem":1},{"text":"ሀርከኮስ አከሱማን ዽቀዼ ካ!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አን ጉያ ጉቱ ዸአሜረ፤","poem":1},{"text":"ገነመ ገነመስ አደበሜረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"አን ኡቱ፣ “አከነ ነንዱበዸ” ጄዼ ጅራዼ","poem":1},{"text":"ስላ እጆሌኬ ነንየከን ቱሬ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ገሩ ዮሙ አን ዋን ከነ ሁንደ ሁበቹ ያሌት፣","poem":1},{"text":"ወን ኩን ሆጂ ደዸብሲሳ ነት ተኤ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኩንስ ሀመ አን እዶ ቁልቁሉማ ዋቃ ሴኑት ቱሬ፤","poem":1},{"text":"ኤርገሲስ አን ገልገለሳኒ ነንሁበዼ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ዹጉማን አት እዶ ሙጩጫታረ እሳን ዻብዴ፤","poem":1},{"text":"አከ እሳን ኩፈኒ ጨጨበኒፍስ ገድ እሳን ደርበቴ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እሳን አከሚን ጉቱማን ጉቱት ሶዳዻን ፉዸተመኒ","poem":1},{"text":"አኩመ ተሳ በርበዳአን!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አኩመ አብጁን ዬሮ ነምን ህርባ ደመቁት ተኡ ሰነ፣","poem":1},{"text":"አትስ ያ ጎፍታ፣ አከሱመ ዮሙ ኦል ካቱ፣","poem":2},{"lineBreak":true},{"text":"ሀዊ ገራሳኒ ንቡሼስተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ዮሙ ሉቡንኮ ገድቴ","poem":1},{"text":"ኦኔንኮስ ወራነምቴት፣","poem":2}]},{"type":"verse","number":22,"content":[{"text":"አን ጎዋፊ ወላላን ቱሬ፤","poem":1},{"text":"ፉለኬ ዱረትስ አከ ሆሪ ነንተኤ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ተኡስ አን ዬሮ ሁንደ ስ ወጅነን ጅረ፤","poem":1},{"text":"አትስ ሀርከኮ ምርጋ ንቀብደ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"አት ጎርሰኬቲን ነ ቀጄልችተ፤","poem":1},{"text":"ኤርገሲሞ ኡልፍነት ነ ገልችተ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"አን ሰሚ ኬሳ ኤኙነን ቀበ?","poem":1},{"text":"ለፈራስ ስ መሌ ሆማ ህንፌዹ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ፎንኮፊ ኦኔንኮ ደዸቡ ደንደኡ፤","poem":1},{"text":"ዋቅን ገሩ ጀብነ ገራኮት፤","poem":2},{"lineBreak":true},{"text":"በረ በራንስ እን ቆደኮ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ወር ስራ ፈጎ ጅረን ንበዱ፤","poem":1},{"text":"አትስ ወረ ሲፍ ህንአመነምኔ ሁንደ ንበሌስተ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"አከ አን ያዱት ገሩ ዋቀት ዽኣቹን ጋሪዸ፤","poem":1},{"text":"ዋቀዮ ጎፍታ ደኦኮ ጎዸዼረ፤","poem":2},{"lineBreak":true},{"text":"አን ሆጂኬ ሁንደ ነንለብሰ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}