{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":74,"content":[{"type":"hebrew_subtitle","content":["መስኪሊ አሳፍ።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቅ፣ አት ማሊፍ በረ በራን ኑ ገቴ?","poem":1},{"text":"ኣሪንኬ ማሊፍ ሆሎተ አት ቦባፍቴረት አከ መሌ ቦበአ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሰበ አት ዱር ፍለቴ፣","poem":1},{"text":"ጎሰ ዻለኬቲ፣ ወረ አት ፉርቴ፣","poem":2},{"lineBreak":true},{"text":"ቱሉ ጥዮን እዶ አት ጅራቴስ ያደዹ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ተርካንፊኬ ገረ ዋን በረ በራን ዲገሜት ቀጄልፈዹ፤","poem":1},{"text":"ዲን ዋን መነ ቁልቁሉማ ኬሰ ጅሩ ሁንደ በርበዴሴረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ዲኖትንኬ እዶ ቁልቁሉኬ ኬሰት ቦክሰን፤","poem":1},{"text":"መለቶሳኒስ መለቶ ጎዸኒ ዻበተን።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እሳን ነመ ቦሶነ ኬሰት ሙከ ሙሩፍ","poem":1},{"text":"ቆቶ ኦል ፉዸቱ ፈካቱ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እሳንስ ዋን ሶፈሜ ሁንደ፣","poem":1},{"text":"ቆቶፊ ቡሩሳን ጨጨብሰን።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እሳን መነ ቁልቁሉማኬ ጉበን፤","poem":1},{"text":"ለፈ ጅሬኘ መቃኬቲስ ንጡሬሰን።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ገራሳኒ ኬሰት፣ “ኑ ጉቱማን ጉቱትእሳን በርበዴስነ!” ጄዸን።","poem":1},{"text":"እዶ ዋቅን ብየቲ ኬሰት እት ዋቄፈማ ቱሬ ሁንዱመስ ንጉበን።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"መለቶን ድንቂ ኑ ህንኬነምኔ፤","poem":1},{"text":"ስአች ራጂን ቶኮሌ ህንጅሩ፤","poem":2},{"lineBreak":true},{"text":"ወን ኩን ሀመ ዮሚት አከ ቱሩኑ ኬሳ ነምን ቤኩ ህንጅሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ያ ዋቅ፣ ሀመ ዮሚት ዲን ስት ቆሰ?","poem":1},{"text":"አመጃጂንስ በረ በራን መቃኬ ጡሬሳ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አት ማሊፍ ሀርከኬ፣ ሀርከኬ ምርጋ ደቻፈተ?","poem":1},{"text":"ሀርከኬ ቦባ ጀላ ባፈዹቲ እሳን በርበዴስ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ያ ዋቅ፣ አት ዱሩማ ጀልቀብዴ ሞቲኮት፤","poem":1},{"text":"ለፈረትስ ሆጂ ፈይና ሆጄተ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ስቱ ሁምነኬቲን ገላነ ገርገር ቆዴ፤","poem":1},{"text":"አት ብሻን ኬሰትስ መታ ብኔንሰ ጀዌ ፈካቱ ጨጨብስቴ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ስቱ መታ ሌዋታን ጨጨብሴ ኛተ ጎዼ","poem":1},{"text":"ኡመመወን ገሞጂ ጅራተኒፍ ኬኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ስቱ ቡርቃወኒፊ ብሻን ያኡፍ ከራ በኔ፤","poem":1},{"text":"አት ለገ ዬሮ ሁንደ ያኡሌ ጎግስቴርተ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ጉያን ከንኬት፤ ሀልከንስ ኬቱመ፤","poem":1},{"text":"አት አዱፊ ጅአ ኡምቴርተ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ስቱ ዳሪ ለፋ ሁንደ ዻቤ፤","poem":1},{"text":"አት ቦናፊ ገነ ኡምቴርተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ያ ዋቀዮ፣ አከምት አከ ዲን ስት ቆሱ፣","poem":1},{"text":"አከምት አከ ነሞትን ጎዎንስ መቃኬ ጡሬሰን ያደዹ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሉቡ ጉጌኬቲ ደበርስቴ ብኔንሰ ቦሶናት ህንኬንን፤","poem":1},{"text":"ጅሬኘ ሰበኬ ህዮሜ በረ በራን ህንእራንፈትን።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ከኩኬ ኤግ፤","poem":1},{"text":"እዶን ለፋ ዱከናኣን ሁንድኑጎሊዻን ጉተሜራቲ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ወር ጩንቁርፈመን ቃነአኒ ዱበት ህንዴብእን፤","poem":1},{"text":"ህዬዪፊ ረከቶትን መቃኬ ሃገለቴፈተን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ያ ዋቅ ከእ፤ ዱቢኬስ ፈልመዹ፤","poem":1},{"text":"አከ ጎዎትን ጉያ ጉቱ ስት ቆሰን ያደዹ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዻደቹ ዲኖተኬቲ፣ ቦክሱ ዲነኬቲ","poem":1},{"text":"ከን ገርገር ህንጭትኔ ሰነ ህንደገትን።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":23}