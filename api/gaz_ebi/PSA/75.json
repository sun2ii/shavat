{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዬደሎ፣ “ህንበሌስን” ጄዹን ፋርፈተሜ። ፋርፈትና አሳፍ።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቅ፣ ኑ ስ ገለቴፈትነ፤","poem":1},{"text":"ሰበቢ መቃንኬ ዽኦ ተኤፍ ገለተ ሲፍ ገልችነ፤","poem":2},{"lineBreak":true},{"text":"ነሞትን ዋኤ ድንቂ ሆጂኬቲ ኦዴሱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"አት አከነ ጄተ፤ “አን ዬሮ ሙርቴፈሜ ነንፍለዸ፤","poem":1},{"text":"ከን ቀጄሉማዻን ሙሩ አነ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዮሙ ለፍቲፊ ሰብንሼ ሁንድ ራፈመንት፣","poem":1},{"text":"ከን ኡቱባሼ ጀቤሴ ቀቡ አነ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አን ኦፍ ቱልቶታን አከነ ነንጄዸ፤ ‘ኦፍ ህንጀጅና።’","poem":1},{"text":"ሀሞታንስ፣ ‘ጋንፈኬሰን ኦል ህንቀበትና።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ጋንፈኬሰን ሰሚት ህንካስና፤","poem":1},{"text":"ሞርመኬሰን ዼሬፈተኒ ህንዱበትና።’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ኡልፍን በአ ቢፍቱቲ ዮካን ልጠ ቢፍቱቲ","poem":1},{"text":"ዮካን ለፈ ኦናቲ ህንዹፉቲ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ገሩ ከን ሙርቲ ኬኑ ዋቀ፤","poem":1},{"text":"እን ነመ ቶኮ ገድ ቡሰ፤ ካንሞ ኦል ባሰ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሀርከ ዋቀዮ ኬሰ፣","poem":1},{"text":"ጦፎ ወይኒ ኡርጎፍቱዻን ወልት መከሜ","poem":2},{"lineBreak":true},{"text":"ከን ሆመቻን ጉተሜ ቶኮቱ ጅረ፤","poem":2},{"text":"እን ወይኒ ሰነ ገድ ነቀ፤","poem":1},{"text":"ሀሞን ለፋ ሁንድኑ ኡቱ ሲጮሳሌ ህንሀምብስንጡሩርፈተኒ ዹጉ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"አን ገሩ በረ በራን ዋን ከነ ነንለብሰ፤","poem":1},{"text":"ዋቀ ያቆብስ ነንፋርፈዸ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጋንፈ ሀሞተ ሁንዳ ነንጨጨብሰ፤","poem":1},{"text":"ጋንፍ ቀጄልቶታ ገሩ ኦል ኦል ጄዸ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}