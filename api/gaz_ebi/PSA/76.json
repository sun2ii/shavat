m":1},{"text":"ዮሙ አት ኣርቱ ኤኙቱ ፉለኬ ዱረ ዻበቹ ደንደኣ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አት ሰሚራ ሙርቲ ኬንቴ፤","poem":1},{"text":"ለፍትስ ንሶዳቴ፤ ንጨልእፍቴስ፤","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ያ ዋቅ፣ ወን ኩንስ ዮሙ አት ሙርቲ ኬኑዻፍ፣","poem":1},{"text":"ረከቶተ ብየቲ ፈይሱፍ ካቴት ተኤ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዼከምስ አት ነመት ዼከምቱ ዹጉማን ኡልፍነ ሲፍ ፍደ፤","poem":1},{"text":"ወረ ዼከምሰኬራ ሀፈንስ ንህዸተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ዋቀዮ ዋቀኬሰኒፍ ወሬጋ፤ ወሬግቸስ ጉተዻ፤","poem":1},{"text":"ወር ናኖሳ ጅራተን ሁንድኑስ","poem":2},{"lineBreak":true},{"text":"ዋቀ ሶዳተሙ ቀቡ ሰናፍ ኬናወን ሃፍደን።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እን ሀፉረ ቡልችቶታ ንጨብሰ፤","poem":1},{"text":"ሞቶትን ለፋስ እሰ ሶዳቱ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}