{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":77,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ዬዱቱኒፍ። ፋርፈትና አሳፍ።"]},{"type":"verse","number":1,"content":[{"text":"አን ገርጋርሳፍ ገረ ዋቃት ነንእየዼ፤","poem":1},{"text":"አን አከ ዋቅን ነ ዸገኡፍ ነንእየዼ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዬሮ ረክነኮቲት ጎፍታ ነንበርባደዼ፤","poem":1},{"text":"ሀልከንስ ኡቱ ህንደዸብን ሀርከኮ ነንድሪርፈዼ፤","poem":2},{"lineBreak":true},{"text":"ሉቡንኮስ ጀጀባቹ ድዴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ያ ዋቅ፣ አን ዮሙን ስ ያደዹ ነንኣደ፤","poem":1},{"text":"አን እረ ዴዴብኤ ነንያዴ፤ ሀፉርኮስ ንላፌ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አት አከ እጅኮ ህንዱኑንፈትኔ ጎቴ፤","poem":1},{"text":"አን አከ መሌ ሉበሜ ዱበቹዩ ደዸቤ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አን ዋኤ በረ ዱሪ፣","poem":1},{"text":"ዋኤ ወጎተ ዱሪ ዱሪስ ነንያዴ፤","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አን ሀልከኒን ፋርፈትናኮ ነንያደዼ።","poem":1},{"text":"አን እረ ዴዴብኤ ነንያዴ፤ሀፉርኮስ አከነ ጄዼ ቆረቴ፦","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ጎፍታን በረ በራን ነመ ገታ?","poem":1},{"text":"እን ዴብኤ ገራ ህንላፉ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አራርሳ በረ በራን በዴ?","poem":1},{"text":"ዋዳንሳ በረ በራን ጉተሙ ዸቤ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዋቅን አርጆሙ እራንፈቴራ?","poem":1},{"text":"እን ኣሪዻን ገረ ላፍነሳ ዺሴራ?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"አንስ፣ “ሀርክ ምርጋ ከን ዋቀ ዋን ሁንዳ ኦሊ","poem":1},{"text":"ጅጂረሜረ ጄዼ ያዱንኮ፣ ደዸቢኮት” ነንጄዼ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አን ሆጂ ዋቀዮ ነንያደዸ፤","poem":1},{"text":"ዹጉማን ድንቂኬ ከን ዱሪ ነንያደዸ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አን ዋን አት ሆጄቴ ሁንደረ ዴዴብኤ ነንያደ፤","poem":1},{"text":"ዋኤ ሆጂኬቲሌ ነንዱበዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ያ ዋቅ፣ ከራንኬ ቁልቁሉዸ።","poem":1},{"text":"ዋቅን ጉዳን አከ ዋቀኬኛ ኤሰ ጅረ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አት ዋቀ ሆጂ ድንቂ ሆጄቱዸ፤","poem":1},{"text":"ሰቦተ ግዱትስ ሁምነኬ ንአርግሲፍተ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እሬኬ ጭማዻን ሰበኬ፣","poem":1},{"text":"ሰኚ ያቆቢፊ ሰኚ ዮሴፍ ፉርቴርተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ያ ዋቅ፣ ብሻኖትን ስ አርገን፤","poem":1},{"text":"ብሻኖትን ስ አርገኒ ሶዳተን፤","poem":2},{"lineBreak":true},{"text":"ቱጁበወን ንሆለተን።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዱሜስ ብሻን ገድ ዸንገላሴ፤","poem":1},{"text":"ሰሚወን ንቀቀዌሰአን፤","poem":2},{"lineBreak":true},{"text":"ጥይኬስ ቅጠ ሁንዳን በለቅሴ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"በከካንኬ ቡቤ ሀማ ኬሳ ዸገአሜ፤","poem":1},{"text":"በለቄስኬ አዱኛ እብሴ፤","poem":2},{"lineBreak":true},{"text":"ለፍትስ ሆለቴ ሶቾቴ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዳንዲንኬ ገላነ ኬሰ፣","poem":1},{"text":"ከራን ኬሞ ብሻኖተ ጉርጉዳ ኬሰ በአ፤","poem":2},{"lineBreak":true},{"text":"ገሩ ፋንኬ ህንአርገምኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"አት ሀርከ ሙሴቲፊ ሀርከ አሮኒን፣","poem":1},{"text":"ሰበኬ አከ ቡሻዬት ጌጌስቴ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/