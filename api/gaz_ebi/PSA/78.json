{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":78,"content":[{"type":"hebrew_subtitle","content":["መስኪሊ አሳፍ።"]},{"type":"verse","number":1,"content":[{"text":"ያ ሰበኮ፣ በርሲሰኮ ዸገኣ፤","poem":1},{"text":"ዱቢ አፋንኮ ዸጌፈዻ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አን ፈኬኛን አፋንኮ ነንበነዸ፤","poem":1},{"text":"ዋን ዱሩማ ጀልቀቤ ዾክፈሜስ ነንዱበዸ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኩንስ ዋኑመ ኑ ዸጌኜፊ ዋኑመ ኑ ቤክኑ፣","poem":1},{"text":"ዋን አቦቲንኬኘ ኑት ህመኒዸ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኑስ ዋን ከነ እጆሌሳኒ ዱራ ህንዾክስኑ፤","poem":1},{"text":"ሆጂ ዋቀዮ ኡልፍነ ቀቤሰ ሰነ፣","poem":2},{"text":"ሁምነሳቲፊ ድንቂ እን ሆጄቴ፣","poem":1},{"text":"ዸሎተ እት ኣኑት ንህምነ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እን ያቆቢፍ ስርነ ዻቤ፤","poem":1},{"text":"እስራኤሊፍሞ ሴረ ኬኔ፤","poem":2},{"text":"ዋን ከነሌ አከ እሳንእጆሌሳኒ በርሲሰኒፍ፣","poem":1},{"text":"አቦቲኬኘ አጀጄ፤","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኩንስ አከ ዸሎትን እት ኣኑ ቤኩ፣","poem":1},{"text":"አከ እጆሌን አመዩ ህንዸለትን ቤከን፣","poem":2},{"lineBreak":true},{"text":"እሳንስ አከ እጆሌሳኒት ደበርሰኒ ህመኒፍ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዮስ እሳን ዋቀ አመነቱ፤","poem":1},{"text":"አጀጀሳስ ንኤጉ መሌ ሆጂሳ ህንእራንፈተን።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እሳን አከ አቦቲሳኒ፣","poem":1},{"text":"አከ ዸሎተ መተ ጀቤሳፊ ፍንጭላ፣","poem":2},{"text":"ወረ ገራንሳኒ ዋቃፍ ህንአጀጀምኔ፣","poem":1},{"text":"አከ ወረ ሀፉርሳኒ እሳፍ ህንአመነምን ሰና ህንተአን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ነሞትን ኤፍሬም ጥየ ቀበተኒ ቱረን፤","poem":1},{"text":"ተኡስ ጋፈ ሎላ ዱበት ዴብአን።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እሳን ከኩ ዋቃ ህንኤግኔ፤","poem":1},{"text":"ሴረ እሳትስ ቡሉ ድደን።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እሳን ሆጂ እን ሆጄቴ፣","poem":1},{"text":"ድንቂ እን እሳንት አርግሲሴስ ንእራንፈተን።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እን ፉለ አቦቲሳኒ ዱረት፣","poem":1},{"text":"ብየ ግብጥ ኩታ ዞኣንት ዋን ነመ ድንቅሲሱ ሆጄቴ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እን ገላነ ገርገር ቆዴ ግዱን እሳን ደበርሴ፤","poem":1},{"text":"ብሻን ሰነስ አኩመ ኬኘን መና ዻበቺሴ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ጉያ ዱሜሳን፣ ሀልከን ጉቱሞ","poem":1},{"text":"እፈ እብዳቲን እሳን ጌጌሴ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እን ገሞጂ ኬሰት ከታ ደያሴ","poem":1},{"text":"ብሻን አከ ገላና ባይአቱ እሳኒ ኬኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ከታ ኬሳ ቡርቃ ቡርቅሲሴ","poem":1},{"text":"አከ ብሻን አኩመ ለጋት ያኡ ጎዼ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"እሳን ገሩ ገሞጂ ኬሰት ዋቀ ዋን ሁንዳ ኦሊት ፍንጭለን፤","poem":1},{"text":"እቱመ ፉፈኒስ እሰት ጩቡ ሆጄተን።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እሳን ኛተ ዸረአኒ፣ “ፍድ” ጄቹዻን","poem":1},{"text":"ቤኩምሰ ዋቃ ቆረን።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አከነ ጄዸኒ ዋቀ ሀመተን፤","poem":1},{"text":"“ዋቅን ገሞጂ ኬሰት ማዲ ቆጴሱ ደንደኣ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እን ከታ ሩኩናን ብሻን ሁምናን ኬሳ ቡርቄ፤","poem":1},{"text":"ቡርቃን ጉቴ እራን ዸንገለኤ።","poem":2},{"text":"ገሩ እን ኛተ ኑ ኬኑ ደንደኣ?","poem":1},{"text":"ሰበሳቲፍስ ፎን ኬኑ ደንደኣ?”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዋቀዮ ዮሙ ዋን ከነ ዸገኤት ባይኤ ኣሬ፤","poem":1},{"text":"ያቆብረት እብድሳ ንቀብሲፈሜ፤","poem":2},{"lineBreak":true},{"text":"ዼከምስሳስ እስራኤልት ዹፌ፤","poem":2}]},{"type":"verse","number":22,"content":[{"text":"እሳን ዋቀ ህንአመነኔቲ፤","poem":1},{"text":"ፈይሱ እሳትስ ህንአመኔ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"እን ገሩ ሰሚ ጉባቲፍ አጀጀ ኬኔ፤","poem":1},{"text":"በልበለ ሰሚስ ንበኔ፤","poem":2}]},{"type":"verse","number":24,"content":[{"text":"አከ እሳን ኛተኒፍ መና ገድ ሮብሴፍ፤","poem":1},{"text":"ምዻን ሰሚስ እሳኒፍ ኬኔ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ነሞትን ቡዴነ ኤርገሞተ ዋቀዮ ኛተን፤","poem":1},{"text":"እን ዋን እሳን ኛተኒ ቁፈን ኤርጌፍ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"እን አከ ቡቤን በአ ቢፍቱ ሰሚ ኬሳ ቡብሱ ጎዼ፤","poem":1},{"text":"ቡቤ ክባስ ሁምነ ኦፊሳቲን ኦፌ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ፎን አኩመ አዋራት፣ ስምብሮተ በርሰንስ","poem":1},{"text":"አኩመ ጭረቸ ገላናት ገድ እሳኒፍ ሮብሴ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"እንስ አከ እሳን ቁበተሳኒ ኬሰት","poem":1},{"text":"ናኖ ዱንካኖተሳኒት ገድ ሀርጨአን ጎዼ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"እሳንስ ኛተኒ ቁፈን፤","poem":1},{"text":"እን ዋን እሳን ዸረአን እሳኒፍ ኬኔራቲ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ገሩ ኡቱ እሳን ኛተ ዸረአን ሰነ ህንቁፍን፣","poem":1},{"text":"ኡቱመ ኛትን ሱን አፋንሳኒ ኬሰ ጅሩ፣","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ዼከምስ ዋቃ እሳንት ዹፌ፤","poem":1},{"text":"እንስ እሳን ኬሳ ወረ ጀጀቤዪ ገላፈቴ፤","poem":2},{"lineBreak":true},{"text":"ደርገጌዪ እስራኤልስ ንፍጤ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"እሳን ዋን ከነ ሁንደረ ደርበኒ ጩቡ ሆጄቹት ፉፈን፤","poem":1},{"text":"ድንቂ እሳትስ ህንአመኔ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ከናፉ እን አከ በርሳኒ ፋይዳ መሌ ደርቡ፣","poem":1},{"text":"አከ ወጎትንሳኒስ ሶዳዻን ዹመን ጎዼ።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ዬሮ ዋቅን እሳን አጄሴ ከምትዩ፣እሳን እሰ በርባደተን፤","poem":1},{"text":"እሳን አመስ ፌዺዻን ገረሳት ዴብአን።","poem":2}]},{"type":"verse","number":35,"content":[{"text":"አከ ዋቅን ከታሳኒ ተኤ፣","poem":1},{"text":"አከ ዋቅን ዋን ሁንዳ ኦሊ ፉሪሳኒ ተኤ ያደተን