{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":79,"content":[{"type":"hebrew_subtitle","content":["ፋርፈትና አሳፍ።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቅ፣ ነሞትን ኦርማ ሀንዹራኬ ቀበተኒሩ፤","poem":1},{"text":"መነ ቁልቁሉማኬ ቁልቁልቸ ጡሬሰኒሩ፤","poem":2},{"lineBreak":true},{"text":"ዬሩሳሌምንስ በርበዴሰኒሩ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አከ እሳን ኛተ እሳኒፍ ተአኒፍ፣","poem":1},{"text":"ሬፈ ገርቦተኬቲ አላቲ ሰሚቲፍ፣","poem":2},{"lineBreak":true},{"text":"ፎን ቁልቁሎተኬቲሞ ብኔንሶተ ለፋቲፍ ኬነኒሩ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዺገሳኒስ ናኖ ዬሩሳሌምት","poem":1},{"text":"አኩመ ብሻኒ ዸንገላሰን፤","poem":2},{"lineBreak":true},{"text":"ነምን እሳን አዋሉ ቶኮሌ ህንአርገምኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኦላኬኘ ብረት መቃን ኑ በዴረ፤","poem":1},{"text":"ወረ ናኖኬኘ ጅረን ብረትስ ነመ ቱፊፊ ኮልፋ ታኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ያ ዋቀዮ፣ ኩን ሀመ ዮሚት?","poem":1},{"text":"አት ሀመ በረ በራት ኣርታ?","poem":2},{"lineBreak":true},{"text":"ህናፋንኬስ ሀመ ዮሚት አከ እብዳ ቦበአ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዼከምሰኬ ሰነ ሰቦተ ስ ህንቤክኔረት፣","poem":1},{"text":"ሞቱሞተ መቃኬ ህንዋመትኔረትገድ ዸንገላስ፤","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እሳን ያቆብን ልቅምሰኒሩቲ፤","poem":1},{"text":"እዶ ጅሬኘሳስ በሌሰኒሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ጩቡ አቦቲኬኛ ኑት ህንሄሬግን፤","poem":1},{"text":"ዋን ኑ ባይኤ ገድ ዴብፈምኔፍ፣","poem":2},{"lineBreak":true},{"text":"አራርኬ ደፌ ኑ ብረ ሃገኡ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ያ ዋቅ ፈይሳኬኘ፣","poem":1},{"text":"ኡልፍነ መቃኬቲቲፍ ጄዺ ኑ ገርጋር፤","poem":2},{"text":"መቃኬቲፍ ጄዺቲ ኑ ኦልች፤","poem":1},{"text":"ጩቡኬኘሌ ኑ ዺስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኦርሞትን ማሊፍ፣","poem":1},{"text":"“ዋቅንሳኒ ኤሰ ጅረ?” ጄዹሬ?","poem":2},{"lineBreak":true},{"text":"ዺገ ተጃጅልቶተኬቲ ከን ዸንገላፈሜ ሰናፍ፣","poem":1},{"text":"አከ ሃሎ ባፍቱ እጀኬኘ ዱረት ሰቦተ ግዱት ቤክስስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኣዱን ህዸምቶታ ፉለኬ ዱረ ሃገኡ፤","poem":1},{"text":"ጀብነ እሬኬቲቲን ወረ ዱት እት ሙረሜ ኦልች።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ያ ጎፍታ፣ አረበ እሳን እቲን ስ አረብሰን፣","poem":1},{"text":"ደቻ ቶርበ ጎዺቲ ኦላኬኘት ዴብስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዮስ ኑ ሰብንኬ፣ ሆሎትን ትከኬቲ፣","poem":1},{"text":"በረ በራን ስ ጀጀትነ፤","poem":2},{"text":"ዸሎታ ሀመ ዸሎታትስ፣","poem":1},{"text":"ገለተኬ ንኦዴስነ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}