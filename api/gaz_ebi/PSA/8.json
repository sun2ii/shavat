{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት ከን ግቲቲዻን ፋርፈተሙ።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ ጎፍታኬኘ፣","poem":1},{"text":"መቃንኬ ለፈ ሁንደት አከም ኡልፍነ ቀቤሰ!","poem":2},{"lineBreak":true},{"text":"አት ኡልፍነኬ","poem":1},{"text":"ሰሚወንረት ድሪርስቴርተ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሰበቢ ዲኖተኬቲቲፍ፣ አመጃጂፊ ነመ ሃሎ ባፈቱ","poem":1},{"text":"አፋን ቀበቺሱፍ ጄቴ፣ አፋን ዳእመኒቲፊ","poem":2},{"lineBreak":true},{"text":"ሙጮሊ ሀርመ ሆዸኒራ ገለተ ቆጴስቴርተ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዮሙ አን ሆጂ ቁበኬቲ፣","poem":1},{"text":"ሰሚወንኬ፣","poem":2},{"lineBreak":true},{"text":"ጅኣፊ ኡርጂወን አት ሁንዴስቴ እላሉት፣","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አከ አት እሳፍ ያዱፍ ነምን ማል?","poem":1},{"text":"አከ እሳፍ ዽምቱፍ እልም ነማ ማል?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"አት ጥኖሼ ኦፊኬቲ ገድ እሰ ጎቴ፤","poem":1},{"text":"ኡልፍናፊ ከበጃን እሰ ጎንፍቴ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሆጂ ሀርከኬቲረት ቡልቻ እሰ ጎቴ፤","poem":1},{"text":"ዋን ሁንደስ ሚለሳ ጀለ ገልችቴ፤","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ቡሻዬፊ ሎን ሁንደ፣","poem":1},{"text":"ብኔንሶተ ቦሶናስ፣","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ስምብሮተ ሰሚራ፣ ቁርጡሚ ገላና፣","poem":1},{"text":"ዋን ዳንዲ ገላናቲን ደርቡ","poem":2},{"lineBreak":true},{"text":"ሁንደስ ሚለሳ ጀለ ገልችቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ያ ዋቀዮ ጎፍታኬኘ፣","poem":1},{"text":"መቃንኬ ለፈ ሁንዱማረት አከም ኡልፍነ ቀቤሰ!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}