{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":80,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ዬደሎ፣ “ደራራ ከኩቲን” ፋርፈተሜ። ፋርፈትና አሳፍ።"]},{"type":"verse","number":1,"content":[{"text":"ያ ትክሴ ሰበ እስራኤል፣","poem":1},{"text":"ከን አኩመ ቡሻዬት ዮሴፍን ጌጌስቱ ኑ ዸገእ፤","poem":2},{"lineBreak":true},{"text":"አት ከን ኪሩቤል ግዱ ቴሶረ ቴሱ፣ እፊቲ ሙልአዹ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ፉለ ኤፍሬም፣ ቤንያሚፊ ምናሴ ዱረት","poem":1},{"text":"ሁምነኬ ሶቾስ፤ ኮቱቲ ኑ ፈይስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ያ ዋቅ፣ እዶኬኘት ኑ ዴብስ፤","poem":1},{"text":"አከ ፈይኑፍስ ፉለኬ ኑረት እብስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ያ ዋቀዮ፣ ዋቀ ዋን ሁንደ ደንዴሱ፣","poem":1},{"text":"አት ሀመ ዮሚት ከዸትና ሰበኬቲት ኣርተ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አት ቡዴነ እምማኒ እሳን ኛችፍቴ፤","poem":1},{"text":"እምማን ወጪቲ ጉቱስ እሳን ኦባፍቴ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አት አከ ኦሎንኬኘ ኑ ቱፈተን ጎቴ፤","poem":1},{"text":"ዲኖትንኬኘስ ኑት ቆሱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ያ ዋቀ ዋን ሁንደ ደንዴሱ፣እዶኬኘት ኑ ዴብስ፤","poem":1},{"text":"አከ ኑ ፈይኑፍስ ፉለኬ ኑረት እብስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"አት ሙከ ወይኒ ብየ ግብጢ ቡቅፍቴ ፍዴ፤","poem":1},{"text":"ኦርሞተስ አሪቴ ሙከ ሰነ ዻብዴ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሙክቻፍስ ለፈ ቆጴስቴ፤","poem":1},{"text":"ሙክን ሱንስ ህደ ገድ ፈጌፈቴ ብየቲ ጉቴ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ቱሉወን ጋድሰሳቲን፣","poem":1},{"text":"ብርብርሰወን ጉርጉዳንስደሜወንሳቲን ሀጉገመን።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እንስ ደሜወንሳ ገረ ገላናት፣","poem":1},{"text":"ለተሳስ ሀመ ለጋት ድሪርፈቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ዮስ አት ማሊፍ አከ ነምን አቺን ደርቡ ሁንድኑ","poem":1},{"text":"እጀሳ ጭረቱ ጎቹፍ ጄቴ ደላሳ ዲግዴሬ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኮርም ቦዬ ቦሶነ ኬሳ በኤ እሰ ንበሌሰ፤","poem":1},{"text":"ብኔንስ ድሬስ እሰ ንኛተ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ያ ዋቀ ዋን ሁንደ ደንዴሱ፣ስ ከዸትና ገረኬኘት ዴብእ!","poem":1},{"text":"ሰሚራ ገድ እላሊ አርግ!","poem":2},{"text":"ሙከ ወይኒ ከነ ኤግ፤","poem":1}]},{"type":"verse","number":15,"content":[{"text":"ሙክን ኩን ሙከ ወይኒ ከን ሀርክኬ ምርጋ ዻቤዸ፤","poem":2},{"lineBreak":true},{"text":"ብቅልቱ አት ኦፊኬቲፍ ጉድፈቴዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ወይኒንኬ ጭረሜ እብዳን ጉበሜረ፤","poem":1},{"text":"ሰብንኬስ ዼከምሰኬቲን በደ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሀርክኬ ነምቸ ከራ ሀርከኬ ምርጋ ጅሩረ፣","poem":1},{"text":"እልመ ነማ ከን አት ኦፊኬቲፍ ጉድፈቴረ ሃቦቆቱ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዮስ ኑ ስራ ህንገረገሉ፤","poem":1},{"text":"ጅሬኘ ኑ ኬን፤ ኑስ መቃኬ ንዋመትና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ያ ዋቀዮ፣ ዋቀ ዋን ሁንደ ደንዴሱ","poem":1},{"text":"እዶኬኘት ኑ ዴብስ፤","poem":2},{"lineBreak":true},{"text":"አከ ኑ ፈይኑፍስ ፉለኬ ኑረት እብስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/81.json","nextChapterAudioLi