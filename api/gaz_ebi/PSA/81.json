{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":81,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና አሳፍ ከን ግቲቲዻን ፋርፈተሙ።"]},{"type":"verse","number":1,"content":[{"text":"ዋቀ ጀብነ ኑ ተኤፍ ገመቹዻን ፋርፈዻ፤","poem":1},{"text":"ዋቀ ያቆቢቲፍ ገመቹዻን እልልቻ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ፋርፈቹ ጀልቀባ፤ ድቤስ ሩኩታ፤","poem":1},{"text":"በገናፊ ክራረ ሰገሌ ጋሪ ቀቡ ሩኩታ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ዬሮ ባቲን ዸለቱ፣ ዮሙ ጅእ ጎበኑት፣","poem":1},{"text":"ጉያ አያነኬኛ መለከተ አፉፋ፤","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኩን ሴረ እስራኤሊፍ ኬነሜ፣","poem":1},{"text":"አጀጀ ዋቀ ያቆብ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እን ዬሮ ብየ ግብጥ ዸኡፍ በኤት፣","poem":1},{"text":"ዋን ከነ ዮሴፊፍ ሴረ ጎዼ ዻቤ።","poem":2},{"lineBreak":true},{"text":"አንስ አፋን ዱራን ህንቤክን ቶኮ ዸገኤ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"እንስ አከነ ጄዼ፤“አን ገቲቲሳኒራ በኣ ቡሴረ፤","poem":1},{"text":"ሀርክ እሳንስ ጉቦ ባቹ ጀላ በኤ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አት ዽጵነኬ ኬሰት ነ ዋመቴ፤ አንስ ስን ኦልቼ፤","poem":1},{"text":"አንስ ለፈ በከካን እት ዾከቱ ኬሳ ዴቢ ሲፍን ኬኔ፤","poem":2},{"lineBreak":true},{"text":"ብሻን መሪባ ብረትስ ስን ቆሬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ያ ሰበኮ ዸገእ፤ አን ሲን አኬከቺሰ፤","poem":1},{"text":"ያ እስራኤል አት ኡቱ ነ ዸጌፈቴ!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዋቅን ኦርማ ቶኮዩ እስን ግዱ ህንጅራትን፤","poem":1},{"text":"አነ መሌ ዋቀ ብራ ህንዋቄፈትን።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አን ዋቀዮ ዋቀኬ፣","poem":1},{"text":"ከን ግብጢ ባሴ እስን ፍዴዸ።","poem":2},{"lineBreak":true},{"text":"አፋንኬ በልእሲ በነዹ፤ አን ነንጉታ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ሰብንኮ ገሩ ነ ህንዸጌፈትኔ፤","poem":1},{"text":"እስራኤል አናፍ ህንቡሌ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ከናፉ አን አከ እሳን ከራ ፌዺሳኒ ዴመኒፍ","poem":1},{"text":"ደበርሴ መተ ጀብነሳኒት እሳን ኬኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ኡቱ ሰብንኮ ነ ዸጌፈቴ፣","poem":1},{"text":"ኡቱ እስራኤል ከራኮረ ዴሜ ጅራቴ፣","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አን ስላ አከም ደፌ ዲኖተሳኒ ጅልቤንፈቺሴ","poem":1},{"text":"ሀርከኮስ አመጃጆተሳኒት ነንካሰ ቱሬ!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ወር ዋቀዮን ጅበን ፉለሳ ዱረት ንጉጉፉ፤","poem":1},{"text":"አደቢንሳኒስ በረ በራን እት ፉፈ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አን ገሩ ቀመዲ ቁልቁሉ እስን ሶረ፤","poem":1},{"text":"ደመ ከታ ኬሳ ባፈሜስ እስነን ቁብሰ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}