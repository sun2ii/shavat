{"text":"ተኡስ እስን አኩመ ነመት ንዱቱ፤","poem":1},{"text":"አኩመ ቡልችቶተ ከሚዩ ንኩፍቱ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ያ ዋቅ ከእ፤ ለፈት ሙር፤","poem":1},{"text":"ሰብን ሁንድኑ ከንኬቲቲ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}