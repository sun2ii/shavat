{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":83,"content":[{"type":"hebrew_subtitle","content":["ፋርፈትና አሳፍ።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቅ ገብ ህንጄዽን፤","poem":1},{"text":"ያ ዋቅ፣ ህንጨልእስን፤","poem":2},{"lineBreak":true},{"text":"አከሱመትስ ህንዺስን።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዲኖትንኬ አከም አከ ከከአን፣","poem":1},{"text":"ወር ስ ጅበንስ አከም አከ መታ ኦል ቀበተን እላል።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እሳን ሰበኬት ደበ ከሮርፈቱ፤","poem":1},{"text":"ወረ አት ኤግዱት መርአቱ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እሳንስ፣ “ኮታ አከ መቃን እስራኤል ለመተ ህንያደተምኔፍ፣","poem":1},{"text":"አከ እሳን ሰበ ህንታኔፍ እሳን በርበዴስና” ጄዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"እሳን ያደ ቶኮን ወሊ ገሉ፤","poem":1},{"text":"ስ ትስ ንጉርማኡ፤","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እሳንስ ዱንካኖተ ኤዶም፣ እሽማኤሎተ፣","poem":1},{"text":"ሞኣቢፊ ጎሰ አጋር፣","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ጌባል፣ አሞኒፊ አማሌቅ፣","poem":1},{"text":"ፍልስጤሚፊ ነሞተ ብየ ጢሮስ ወጅን ቱረን።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ወር አሶሪስ፣ እልማን ሎጢቲፍ እሬ ጀባ","poem":1},{"text":"ተኡዻፍ እሳንት መከመን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"አት አኩመ ምድያንን ጎቴ፣","poem":1},{"text":"አኩመ ለገ ቂሾኒት ሲሳራፊ ያቢንን ጎቴ ሰነ እሳን ጎዽ፤","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እሳን ኤንዶርት ዹመኒ","poem":1},{"text":"አኩመ ኮሲ ለፋ ተአን።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጉርጉዶተሳኒ አከ ሄሬቢቲፊ ዜኤብ፣","poem":1},{"text":"እልማን ሞቶተሳኒሞ አከ ዜባፊ ዘልሙና ጎዽ፤","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እሳን ወረ፣ “ኮታ፣ ለፈ ትከ ዋቃ ፉዸትኔ","poem":1},{"text":"ከን ዹንፋኬኛ ጎዸትና” ጄዸኒዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ያ ዋቀኮ፣ አከ አዋረ ቡቤን ፉዸቱ፣","poem":1},{"text":"አከ ሀበቂ ቅሌንስ ብትኔሱ እሳን ጎዽ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አኩመ እብድ ቦሶነ በሌሱ፣","poem":1},{"text":"ዮካን አኩመ አረብን እብዳ ቱሉወን ጉቡ፣","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አትስ አከሱመ ኣሪኬቲን እሳን ጉግስ፤","poem":1},{"text":"ቡቤኬቲን እሳን ሶዳችስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ያ ዋቀዮ፣ አከ እሳን መቃኬ በርባደተኒፍ፣","poem":1},{"text":"ፉለሳኒ ቃኒን ሀጉግ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"እሳን ዬሮ ሁንደ ቃነአኒ ሃዽጰተን፤","poem":1},{"text":"ሰልጵናንስ ሃበደን።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እሳን አከ አት ከን መቃንኬ ዋቀዮ ተኤ ሱን ቆፍት፣","poem":1},{"text":"ለፈ ሁንዱማረት ዋቀ ዋን ሁንዳ ኦሊ ታቴ ሃቤከን።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}