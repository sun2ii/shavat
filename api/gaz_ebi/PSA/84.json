{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":84,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ከን ግቲቲዻን ፋርፈተሙ። ፋርፈትና እልማን ቆራህ።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ ዋን ሁንደ ደንዴሱ፣","poem":1},{"text":"እዶን አት ጅራቱ አከም ነመት ቶለ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሉቡንኮ ኦብዲወን ዋቀዮ ሀውት፤","poem":1},{"text":"አከ መሌስ እት ገገብድ፤","poem":2},{"text":"ኦኔንኮፊ ፎንኮ","poem":1},{"text":"ዋቀ ጅራታዻፍ እልሌዻን ንፋርፈቱ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ያ ዋቀዮ ዋን ሁንደ ደንዴሱ፣","poem":1},{"text":"ሞቲኮፊ ዋቀኮ፣","poem":2},{"text":"እዶ ኣርሳኬቲ ብረት፣ ድምቢቲን እዶ ጅሬኛ፣","poem":1},{"text":"ግርስንስ ኦፊሼቲፍ መንኤ ጩጪሼ ኬሰ ካአቱ አርገት።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ወር መነኬ ኬሰ ጅራተን ኤብፈሞዸ፤","poem":1},{"text":"እሳን ዬሮ ሁንዱማ ስ ጀጀቱቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ወር ስራ ጀብነ አርገተን፣","poem":1},{"text":"ከኔን ገራሳኒቲን ከራኬ ያደን ኤብፈሞዸ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እሳን ዮሙ ሱሉለ ባካ ኬሰ ደርበንት፣","poem":1},{"text":"እዶ ሰነ ለፈ ብሻን ኬሳ ቡርቁ ጎዸቱ፤","poem":2},{"lineBreak":true},{"text":"ቦካን ጀልቀባስ ኤበ እት ዸንገላሰ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እሳን ሀመ ጥዮን ኬሰት ፉለ ዋቃ ዱረት ሙልአተንት፣","poem":1},{"text":"ጀብነራ ገረ ጀብናት ንደርቡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ያ ዋቀዮ፣ ዋቀ ዋን ሁንደ ደንዴሱ፣ከዸትናኮ ዸገእ፤","poem":1},{"text":"ያ ዋቀ ያቆብ ነ ዸጌፈዹ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ያ ዋቀዮ፣ ገረ ጋቸነኬኛ እላል፤","poem":1},{"text":"ፉለ ድበማኬ ሰናስ እላል።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ጉያ ኩመ ቶኮ እዶ ብራ ጅራቹረ፣","poem":1},{"text":"ጉያ ቶኮ ኦብዲኬቲረ ኦሉ ወየ፤","poem":2},{"text":"ዱንካነ ሀሞታ ኬሰ ጅራቹረ፣","poem":1},{"text":"ኤግዱ በልበለ መነ ዋቀኮ ተኡ ና ወየ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዋቀዮ ዋቅን አዱፊ ጋቸናቲ፤","poem":1},{"text":"ዋቀዮ ሱራፊ ኡልፍነ ንኬነ፤","poem":2},{"lineBreak":true},{"text":"እን ቶሎተ ዋን ጋሪ ህንዾወቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ያ ዋቀዮ ዋን ሁንደ ደንዴሱ፣","poem":1},{"text":"ነምን ስ አመነቱ ኤብፈማዸ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}