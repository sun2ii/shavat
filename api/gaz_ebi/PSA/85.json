{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":85,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና እልማን ቆራህ።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ፣ አት ለፈኬቲፍ አርጆምቴርተ፤","poem":1},{"text":"ቦጁ ያቆብስ ዴብፍቴርተ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አት በሌሳ ኡመተኬቲ ዺፍቴርታፍ፤","poem":1},{"text":"ጩቡሳኒ ሁንዱማስ ዾክስቴርተ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዼከምሰኬ ሁንደ ፈጌስቴርተ፤","poem":1},{"text":"ኣሪኬ ሶዳችሳ ሰነራስ ዴብቴርተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ያ ዋቀ ፈይሳኬኘ፣ እዶኬኘት ኑ ዴብስ፤","poem":1},{"text":"ዼከምሰኬስ ኑራ ቀብ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አት በረ በራን ኑት ኣርታ? ዼከምሰኬ","poem":1},{"text":"ዸሎተ ቶኮራ ዸሎተ ካንት ደበርስታ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አከ ሰብንኬ ስት ገመዱፍ፣","poem":1},{"text":"አት ሉቡ ኑት ህንዴብፍቱ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ያ ዋቀዮ፣ አራረኬ ኑት ሙልእስ፤","poem":1},{"text":"ፈይነኬስ ኑ ኬን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"አን ዋን ዋቀዮ ዋቅን ጄዹ ነንዸጌፈዸ፤","poem":1},{"text":"እን ሰበሳ ቁልቁሎታፍ ነጋ አብደቺሰ፤","poem":2},{"lineBreak":true},{"text":"እሳን ገሩ ገረ ጎዉማት ህንዴብእን።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አከ ኡልፍንሳ ለፈኬኘረ ጅራቱፍ፣","poem":1},{"text":"ፈይሱንሳ ዹጉማን ወረ እሰ ሶዳተንት ዽኦ ጅረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ጃለሊፊ አመነሙማን ወል ገአን፤","poem":1},{"text":"ቀጄሉማፊ ነጋን ወል ዹንገተን።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አመነሙማን ለፈ ኬሳ ቡርቀ፤","poem":1},{"text":"ቀጄሉማንሞ ሰሚራ ገድ እላለ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዋቀዮ ዹጉማን ዋን ጋሪ ንኬነ፤","poem":1},{"text":"ለፍትኬኘስ ምዻንሼ ንኬንት።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ቀጄሉማን ፉለሳ ዱረ ዴመ፤","poem":1},{"text":"ሚለ እሳቲፍስ ከራ ቆጴሰ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}