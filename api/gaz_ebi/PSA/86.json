e_break"},{"type":"verse","number":8,"content":[{"text":"ያ ጎፍታ፣ ዋቆተ ኬሳ ከን አከኬቲ ህንጅሩ፤","poem":1},{"text":"ሆጂን ሆጂኬቲን ወል ቅጣቱ ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ያ ጎፍታ፣ ሰቦትን አት ኡምቴ ሁንድኑ ዹፈኒ፣","poem":1},{"text":"ፉለኬ ዱረት ንሰገዱ፤","poem":2},{"lineBreak":true},{"text":"መቃኬቲፍስ ኡልፍነ ፍዱ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አት ጉዳፊ ከን ሆጂ ድንቅሲሳ ሆጄቱዸ፤","poem":1},{"text":"ዋቅን ሱመ ቆፈ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ያ ዋቀዮ፣ ከራኬ ነ በርሲስ፤","poem":1},{"text":"አንስ ዹጋኬቲን ነንቡለ፤","poem":2},{"text":"አከ አን መቃኬ ሶዳዹፍ፣","poem":1},{"text":"ገራ ገርገር ህንቆደምኔ ና ኬን።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ያ ዋቀኮ ጎፍታ፣ አን ገራኮ ጉቱዻን ስን ገለቴፈዸ፤","poem":1},{"text":"መቃኬሌ በረ በራን ነንኡልፌሰ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ጃለል አት ና ቀብዱ ጉዳዻቲ፤","poem":1},{"text":"ሉቡኮ ዽዽመ ሲኦል ኬሳ ባፍቴርተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ያ ዋቅ፣ ኦፍ ቱልቶትን ነት ከአኒሩ፤","poem":1},{"text":"ቱትን ፍንጭልቶታ፣ ነሞትን ስ ህንሶዳትኔ","poem":2},{"lineBreak":true},{"text":"ሉቡኮ ገላፈቹ በርባዱ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ያ ጎፍታ፣ አት ገሩ ዋቀ ገራ ላፌሳፊ አርጃዸ፤","poem":1},{"text":"ደፍቴ ህንኣርቱ፤ ጃለሊፊ አመነሙማንኬ ዹመ ህንቀቡ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ገረኮት ዴብኢቲ ነ ማር፤","poem":1},{"text":"ጀብነኬ ተጃጅላኬቲ ኬን፤","poem":2},{"lineBreak":true},{"text":"እልመ ገርብቲኬቲስ ኦልች።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አከ ዲኖትንኮ አርገኒ ቃነአኒፍ፣","poem":1},{"text":"መለቶ ጋሩማኬቲ ና ኬን፤","poem":2},{"lineBreak":true},{"text":"ያ ዋቀዮ፣ አት ነ ገርጋርቴ ነ ጀጀቤስቴርታቲ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}