"number":7,"content":[{"text":"ወር ፋርፈተኒፊ ወር ሜሻ ሙዚቃ ተጰተን፣","poem":1},{"text":"“ቡርቃንኮ ሁንድ ስ ኬሰት አርገመ” ጄዹ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}