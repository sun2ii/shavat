{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":88,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና እልማን ቆራህ ከን ማህላት ሊኖቲን",{"noteId":0},"ፋርፈተሜ። መስኪሊ ሄማን እዝራህቻ።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ፣ ዋቀ ነ ፈይፍቱ፣","poem":1},{"text":"አን ሀልከኒፊ ጉያ ፉለኬ ዱረት ነንእየዸ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ከዸናንኮ ፉለኬ ዱረት ሃዽኣቱ፤","poem":1},{"text":"አትስ ጉረኬ ገረ እየትናኮቲት ቀብ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ሉቡንኮ ረክናን ጉተምቴርቲ፤","poem":1},{"text":"ጅሬኝኮስ አዋለት ዽኣቴረ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አን ወረ ቦለ ኬሰ ቡአንት ነንለካአሜ፤","poem":1},{"text":"አከ ነመ ሁምነ ህንቀብኔስ ነንተኤ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አን አከ ነመ ጎረአሜ አዋለ ኬሰ ጪሱት፣","poem":1},{"text":"አከ ነመ አት ዴብቴ ህንያደኔት፣","poem":2},{"text":"አከ ወረ ኤጉምሰኬ ጀላ በአኒት፣","poem":1},{"text":"ወረ ዱአን ወጅን ገተሜረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"አት ቦለ ገድ ፈጎ ኬሰ፣","poem":1},{"text":"ዱከነ ሀማ ኬሰስ ነ ቡፍቴርተ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዼከምስኬ ኡልፋቴ ነረ ጪሴረ፤","poem":1},{"text":"ደምበሊኬ ሁንደስ ነረ ገረገልችቴርተ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ምቾተኮ ነራ ፈጌስቴርተ፤","poem":1},{"text":"እሳን ብረት ጅበማ ነ ጎቴርተ፤","poem":2},{"text":"አከ አን ጀላ ህንባኔትስ በልበል ነት ጩፈሜረ።","poem":1}]},{"type":"verse","number":9,"content":[{"text":"እጅኮ ገዳን ደዸቤረ።","poem":2},{"lineBreak":true},{"text":"ያ ዋቀዮ፣ አን ጉዩመ ጉያን ስን ዋመዸ፤","poem":1},{"text":"ሀርከኮሌ ገረኬት ነንበልእፈዸ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አት ድንቂኬ ወረ ዱአንት ንአርግሲፍታ?","poem":1},{"text":"ወር ዱአንስ ከአኒ ስ ገለቴፈቱ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጃለልኬ አዋለ ኬሰት፣","poem":1},{"text":"አመነሙማን ኬሞ ቅሌ ኬሰት ንለብሰማ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ድንቂወንኬ ዱከነ ኬሰት፣","poem":1},{"text":"ዮካን ቀጄሉማንኬ ብየ እራንፈትና ኬሰት ንቤከማ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ያ ዋቀዮ፣ አን ገሩ አከ አት ነ ገርጋርቱፍገረኬት ነንእየዸ፤","poem":1},{"text":"ገነማንስ ከዸናንኮ ፉለኬ ዱረት ንዽኣተ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ያ ዋቀዮ፣ አት ማሊፍ ነ ገተ?","poem":1},{"text":"ፉለኬስ ማሊፍ ነ ዱራ ዾክፈተ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"አን እጆሉማኮቲ ጀልቀቤ ረከዼ ዱኡ ገኤን ቱሬ፤","poem":1},{"text":"ናስሱንኬ ነ ዽጵሴረ፤ አብዲስ ኩተዼረ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዼከምስኬ ነረ ያኤ፤","poem":1},{"text":"ናስሱንኬስ ነ በሌሴረ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እሳን ጉያ ጉቱ አኩመ ሎላ ብሻኒ ነ መርሱ፤","poem":1},{"text":"ጉቱማን ጉቱትስ ነ ልቅምሰኒሩ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ምቾተኮፊ ወረ ነ ጃለተን ነራ ፉዸቴርተ፤","poem":1},{"text":"ዱከነ ቆፈቱ ምቹ ና ተኤ።","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"ማህላት ሊኖቲን ጎሰ ሙዚቃት።","reference":{"chapter":88,"verse":0}}]},"thisChapterLink":"/api/gaz_ebi/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/87.json","previousChapterAudioLinks":{},"numberO