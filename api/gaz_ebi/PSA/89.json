{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":89,"content":[{"type":"hebrew_subtitle","content":["መስኪሊ ኤታን እዝራህቻ።"]},{"type":"verse","number":1,"content":[{"text":"አን ዋኤ አራረ ዋቀዮ በረ በራን ነንፋርፈዸ፤","poem":1},{"text":"አፋንኮቲንስ አመነሙማኬ ዸሎተ ሁንዱመት ነንለብሰ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አከ አራርኬ በረ በራን ጅራቱ፣","poem":1},{"text":"አከ አት አመነሙማኬ ሰሚ ኬሰት ጀቤስቴ ዻብዴ ነንለብሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"አት አከነ ጄቴርተ፤ “አን ፍለተማኮ ወጅን ከኩ ገሌረ፤","poem":1},{"text":"ዳዊት ተጃጅላኮቲፍሌ አከነ ጄዼ ከከዼረ፤","poem":2}]},{"type":"verse","number":4,"content":[{"text":"‘አን በረ በራን ሰኚኬ ነንዻበ፤","poem":1},{"text":"ቴሶኬስ ዸሎተ ሁንዳፍ ነንጭምሰ።’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ያ ዋቀዮ፣ ሰሚወን ድንቂኬ ጀጁ፤","poem":1},{"text":"ያኢ ቁልቁሎታ ኬሰትስ አመነሙማኬ ጀጁ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሰሚ ኬሰት ኤኙቱ ዋቀዮን ቅጣቹ ደንደአ?","poem":1},{"text":"ኡመመወን ሰሚ ኬሳ ከን ዋቀዮን ፈካቱ ኤኙ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዋቅን ወልዳ ቁልቁሎታ ኬሰት ባይኤ ሶዳተመ፤","poem":1},{"text":"ወረ ናኖሳ ጅረን ሁንደ ኬሳስ እሰቱ ሶዳችሳዸ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ያ ዋቀዮ፣ ዋቀ ዋን ሁንደ ደንዴሱ፣ከን አከኬቲ ኤኙ?","poem":1},{"text":"ያ ዋቀዮ፣ አት ጀባዸ፤ አመነሙማንኬስ ስ መርሰ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"አት ራፈመ ገላና ንሞተ፤","poem":1},{"text":"ዮሙ ዸኣንሳ ጀባቱስ ንተስገቤስተ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አከ ወረ ቀለመኒት ረኣብን ቡሌስቴ፤","poem":1},{"text":"እሬኬ ጀባ ሰናንስ ዲኖተኬ ንብትኔስቴ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሰሚወን ከንኬት፤ ለፍትስ አከሱመ ከንኬት፤","poem":1},{"text":"አት አዱኛፊ ዋን እሼ ኬሰ ጅሩ ሁንደ ሁንዴስቴርተ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ካባፊ ክበ ስቱ ኡሜ፤","poem":1},{"text":"ታቦሪፊ ሄርሞን ገመቹዻንመቃኬ ገለቴፈቱ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አት እሬ ጀባ ቀብደ፤ ሀርክኬ ጀባዸ፤","poem":1},{"text":"ሀርክኬ ምርጋስ ኦል ከኤረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ቀጄሉማፊ ሙርቲን ቀጄላን ሁንዴ ቴሶኬቲት፤","poem":1},{"text":"አራሪፊ አመነሙማን ፉለኬ ዱረ ዴሙ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ያ ዋቀዮ፣ ወር ሲፍ እልልቹ ቤከን፣","poem":1},{"text":"ወር እፈ እዶ አት ጅርቱ ኬሰ ጅራተን ኤብፈሞዸ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እሳን ጉያ ጉቱ መቃኬቲን ገመዱ፤","poem":1},{"text":"ቀጄሉማኬቲንስ ስ ጀጀቱ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አት ኡልፍነ ጀብነሳኒት፤","poem":1},{"text":"ጃለለኬቲንስ ጋንፈኬኘ ኦል ቀብዴርተ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዹጉማን ጋቸንኬኘ ከን ዋቀዮት፤","poem":1},{"text":"ከን ሞቲኬኘ ቁልቁልቸ እስራኤሊት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"አት ዱር አከነ ጄቴ ሰበኬ አመነማት","poem":1},{"text":"ሙልአታን ዱበቴርተ፦","poem":2},{"text":"“አን ሎልቱ ቶኮፍ ሁምነ ኬኔረ፤","poem":1},{"text":"ደርገጌሰ ሰበ ኬሳ ፍለተሜ ቶኮስ አን ኦል ጉድሴረ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አን ገርብቸኮ ዳዊትን አርገዼረ፤","poem":1},{"text":"ዘይቲኮ ቁልቁሉንስ እሰ ድቤረ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሀርክኮ እሰ ወጅን ጅረ፤","poem":1},{"text":"እሬንኮስ እሰ ጀጀቤሰ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዲን ቶኮዩ እሰ ህንሞአቱ፤","poem":1},{"text":"ነምን ሀማንስ እሰ ህንሀጩጩ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"አመጃጆተሳ ፉለሳ ዱረት ነንበርበዴሰ፤","poem":1},{"text":"ወረ እሰ ጅበንስ ነንዸአ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"አመነሙማፊ አራርኮ እሰ ወጅን ጅራተ፤","poem":1},{"text":"ጋንፍሳስ መቃኮቲን ኦል ጄዸ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"አን ሀርከሳ ገላነረ፣","poem":1},{"text":"ሀርከሳ ምርጋስ ለጌንረ ነንካአ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"እንስ፣ ‘አት አባኮት፤","poem":1},{"text":"ዋቀኮት፣ ከታ ፈይነኮት’ ጄዼ ነ ዋመተ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"አንስ እልመኮ ሀንገፈ፣","poem":1},{"text":"ከን ሞቶተ ለፋ ሁንዳ ኦሊ እሰ ነንጎዸ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ጃለለኮስ በረ በራን እሳፍ ነንቱርሰ፤","poem":1},{"text":"ከኩን አን እሰ ወጅን ቀቡስ ህንጨቡ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ህደ ሰኚሳ በረ በራን፣","poem":1},{"text":"ቴሶሳሌ ሀመ ሰሚወን ጅራተንት ነንዻበ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“ዮ እልማንሳ ሴረኮ ኤጉ ድደን፣","poem":1},{"text":"ዮ እሳን አጀጀኮ ፋነ ቡኡ ባተን፣","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ዮ እሳን ስርነኮ ጨብሰኒ","poem":1},{"text":"አጀጀኮሌ ኤጉ ባተን፣","poem":2}]},{"type":"verse","number":32,"content":[{"text":"አን ጩቡሳኒ ኡሌዻን፣","poem":1},{"text":"የከሳኒሞ ቀጬዻን ነንአደበ፤","poem":2}]},{"type":"verse","number":33,"content":[{"text":"አን ገሩ ጃለለኮ እሰራ ህንፉዸዹ፤","poem":1},{"text":"ዮካን አመነሙማኮ ሶበት ህንጌደሩ።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"አን ከኩኮ ህንጨብሱ፤","poem":1},{"text":"ዮካን ዋን አፋንኮ ዱበቴስ ህንጌደሩ።","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ስአ ቶኮ ዬሮ ሁንዳፍ፣ ቁልቁልነኮቲን ከከዼረ፤","poem":1},{"text":"አን ዳዊትን ህንሶቡ።","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ሰኚንሳ በረ በራን እት ፉፈ፤","poem":1},{"text":"ቴሶንሳስ አኩመ አዱ ፉለኮ ዱረ ጅራተ፤","poem":2}]},{"type":"verse","number":37,"content":[{"text":"አኩመ ጅኣስ በረ በራን ንጅራተ፤","poem":1},{"text":"ሀመ ሰሚወን ጅረንትስ ጭሜ ዻበተ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"አት አመ ገሩ እሰ ዺፍቴርተ፤ ቱፈቴርተስ፤","poem":1},{"text":"እሰ ድብዴ ሰነት ባይኤ ኣርቴርተ።","poem":2}]},{"type":"verse","number":39,"content":[{"text":"ከኩ ተጃጅላኬ ወጅን ገልቴ ጨብስቴርተ፤","poem":1},{"text":"ጎንፎሳስ አዋረ ኬሰ ቡፍቴ ጡሬስቴርተ።","poem":2}]},{"type":"verse","number":40,"content":[{"text":"ደላሳ ሁንደ ጨጨብስቴርተ፤","poem":1},{"text":"ደኦሳ ጀጀባስ በርበዴስቴርተ።","poem":2}]},{"type":"verse","number":41,"content":[{"text":"ወር አቺን ደርበን ሁንድ እሰ ሳሙ፤","poem":1},{"text":"ኦሎንሳስ እት ቆሱ።","poem":2}]},{"type":"verse","number":42,"content":[{"text":"አት ሀርከ አመጃጂሳ ምርጋ ኦል ቀብዴርተ፤","poem":1},{"text":"አከ ዲኖትንሳ ሁንድ ገመደን ጎቴርተ።","poem":2}]},{"type":"verse","number":43,"content":[{"text":"አርፊ ጎራዴሳ ዱበት ዴብፍቴርተ፤","poem":1},{"text":"ወራነ ኬሰትስ እሰ ህንገርጋሬ።","poem":2}]},{"type":"verse","number":44,"content":[{"text":"ሱራሳ እሰራ በሌስቴርተ፤","poem":1},{"text":"ቴሶሳስ ለፈት ገቴርተ።","poem":2}]},{"type":"verse","number":45,"content":[{"text":"ኡሙሪ ደርገጉማሳ ገባብስቴርተ፤","poem":1},{"text":"ቃኒዻንስ እሰ ሀጉግዴርተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"ያ ዋቀዮ፣ ኩን ሀመ ዮሚት?","poem":1},{"text":"አት በረ በራን ኦፍ ዾክስታ?","poem":2},{"lineBreak":true},{"text":"ዼከምስኬ ሀመ ዮሚት አከ እብዳ ቦበአ?","poem":2}]},{"type":"verse","number":47,"content":[{"text":"ኡሙሪንኮ ሀመም አከ ገባባ ተኤ ያደዹ።","poem":1},{"text":"አት በዲሰ አከሚቲፍ እልማን ነማ ሁንደ ኡምቴ!","poem":2}]},{"type":"verse","number":48,"content":[{"text":"ኡቱ ዱአ ህንአርግን ጅራቹ ከን ደንደኡ","poem":1},{"text":"ዮካን ሁምነ ሲኦል ጀላ ኦፍ ባሱከን ደንደኡ ነመ አከሚት?","poem":2}]},{"type":"verse","number":49,"content":[{"text":"ያ ጎፍታ፣ ጃለልኬ ጉዳን ዱሪ ከን አት አመነሙማኬቲን","poem":1},{"text":"ዳዊቲፍ ከከቴ ሱን ኤሰ ጅረ?","poem":2}]},{"type":"verse","number":50,"content":[{"text":"ያ ጎፍታ፣ አከምት አከ ተጃጅላንኬ ቱፈተሜ፣","poem":1},{"text":"አከምት አከ አን አረብሶ ሰቦተ ሁንዳቦባት ባዼ ያደዹ፤","poem":2}]},{"type":"verse","number":51,"content":[{"text":"ያ ዋቀዮ፣ ቆሳ ዲኖትንኬ ነት ቆሰን፣","poem":1},{"text":"ከን እሳን እቲን ተርካንፊ ድበማኬቲ ሁንደት ቆሰን ያደዹ።","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"ገለን በረ በራን ዋቀዮፍ ሃተኡ!","poem":1},"አሜን፤ አሜን።"]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":52}