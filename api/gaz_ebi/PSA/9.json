{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":9,"content":[{"type":"hebrew_subtitle","content":["ዱረ ቡኣ ፋርፈቶታቲፍ፤ ዬደሎ፣ “ዱአ እልማ” ጄዸሙ። ፋርፈትና ዳዊት።"]},{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ፣ አን ገራኮ ጉቱዻን ስን ገለቴፈዸ፤","poem":1},{"text":"ዋኤ ድንቂኬ ሁንዱማስ ነንኦዴሰ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አን ስትን ገመደ፤ ነንእልልቸስ፤","poem":1},{"text":"ያ ዋቀ ዋን ሁንዳ ኦሊ፣ ፋርፈናዻን መቃኬ ነንጀጀዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ዲኖትንኮ ዱግደ ዱበት ንዴብኡ፤","poem":1},{"text":"ንጉፈቱ፤ ፉለኬ ዱራስ ንበዱ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ምርገኮፊ ዽመኮ ቀበቴርተ፤","poem":1},{"text":"አትስ ሙርቲ ቀጄላ ኬና ቴሶኬረ ቴሴርተ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሰቦተ እፈቴ ሀሞተስ በሌስቴርተ፤","poem":1},{"text":"መቃሳኒስ በራ ሀመ በረ በራት ሀቅጤርተ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዲኖትን በዲሰ በረ በራቲን በሌፈሙ፤","poem":1},{"text":"አት መጋላወንሳኒ ቡቡቅፍቴርተ፤","poem":2},{"lineBreak":true},{"text":"ሴናንሳኒስ በርበዴፈሜረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ዋቀዮ ገሩ በረ በራን ንሞአ፤","poem":1},{"text":"ቴሶሳስ ሙርቲዻፍ ዻበቴረ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እን ቀጄሉማዻን አዱኛዻፍ ሙርቲ ንኬነ፤","poem":1},{"text":"ሰቦተስ ሙርቲ ቀጄላዻን ቡልቸ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዋቀዮ ወረ ጩንቁርፈመኒፍ እርኮዸ፤","poem":1},{"text":"ዬሮ ረክናትስ ደኦዸ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ወር መቃኬ ቤከን ስ አመነቱ፤","poem":1},{"text":"ያ ዋቀዮ፣ አት ወረ ስ በርባደን ገቴ ህንቤክቱቲ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ዋቀዮ እሰ ጥዮንረ ጅራቱ ፋርፈናዻን ጀጀዻ፤","poem":1},{"text":"ሆጂሳሌ ሰቦተ ኬሰት ለብሳ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እን ሃሎ ዺጋ ባሱ ሱንስ እሳን ያደታቲ፤","poem":1},{"text":"እየ ወረ ዽጰተኒስ ህንእራንፈቱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ያ ዋቀዮ፣ ሀመም አከ ዲኖትንኮ ነ አርአተን እላል!","poem":1},{"text":"ናፍ አራረሚቲ አፋን ቦለ ዱኣ ኬሳ ነ ባስ፤","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኩንስ አን ከረ እንተለ ጥዮንረት","poem":1},{"text":"አከ ገለተኬ ለብሱፊ ፈይሱ ኬትስ","poem":2},{"lineBreak":true},{"text":"ባይእሴ ገመዱፍ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ሰቦትን ቦለ ቆተን ኬሰ ቡአን፤","poem":1},{"text":"ሚልሳኒስ ክዮዹመ እሳን ዾክሰኒን ቀበሜ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዋቀዮ ሙርቲ ቀጄላ ኬኑዻን ቤከመ፤","poem":1},{"text":"ሀሞን ገሩ ሆጂ ሀርከሳኒቲን ክዮ ሴኑ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ነሞትን ሀሞን፣","poem":1},{"text":"ወር ዋቀ እራንፈተን ሁንድኑስ ሲኦልት ገድ ቡኡ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ረከቶትን ገሩ ዮምዩ ህንእራንፈተመን፤","poem":1},{"text":"አብዲን ህዬዪስ በረ በራን ህንበዱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ያ ዋቀዮ ከእ፤ ጀብን ነማ ህንሙልአትን፤","poem":1},{"text":"ፉለኬ ዱረት ሰቦተት ሃሙረሙ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ያ ዋቀዮ፣ ሶዳ እሳንት ቡስ፤","poem":1},{"text":"ሰቦትንስ አከ ነሙመ ተአን ሃቤከን።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/10.js