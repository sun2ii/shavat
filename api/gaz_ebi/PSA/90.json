e","number":7,"content":[{"text":"ኣሪንኬ ኑ ፍጤረ፤","poem":1},{"text":"ዼከምስኬስ ኑ ናስሴረ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"የከኬኘ ፉለኬ ዱረ፣","poem":1},{"text":"ጩቡኬኘ ዾከታ ሰነስ እፈ ፉለኬቲ ዱረ ኬሴርተ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"በርኬኘ ሁንድኑ ዼከምሰኬቲን ዹሜራቲ፤","poem":1},{"text":"ኡሙሪኬኘስ ኣዱዻን ፍጠትነ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዼርን በረኬኛ ወጋ ቶርባተመ፣","poem":1},{"text":"ዮ ጀባትኔሞ ወጋ ሰዴተመ ተአ፤","poem":2},{"text":"ኩንዩ ገር ጫላንሳ ደዸቢፊ ረክናን ጉተሜረ፤","poem":1},{"text":"እን ደፌ ደርባቲ፤ ኑስ በርፍኔ ንሶክነ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ሁምነ ኣሪኬቲ ኤኙቱ ቤከ?","poem":1},{"text":"ዼከምስኬ አኩመ ሶዳ ኑ ሲፍ ቀባቹ ቀብኑ ሰናጉዳዻቲ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አከ ኑ ገራ ኦጉማዻን ጉተሜ ቀባኑፍ፣","poem":1},{"text":"በረኬኘ ለካኡ ኑ በርሲስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ያ ዋቀዮ፣ ዴብእ! ኩን ሀመ ዮሚት ተአ?","poem":1},{"text":"ተጃጅልቶተኬቲፍስ ገራ ላፍ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አከ ኑ በረኬኘ ጉቱ ገመድኔ እልልችኑፍ፣","poem":1},{"text":"ገነመ ገነመ አራረኬቲን ኑ ቁፍስ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሀመ ባይእነ ጉዮተ አት ኑ ሚቴ ሰና፣","poem":1},{"text":"ሀመ ባይእነ ወጎተ ኑ ረከትኔ ሰናስ ኑ ገመቺስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሆጂንኬ ተጃጅልቶተኬት፣","poem":1},{"text":"ኡልፍንኬስ እጆሌሳኒት ሃሙልእፈሙ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ኤብ ዋቀኬኘ ጎፍትቻ ኑረ ሃቡኡ፤","poem":1},{"text":"ሆጂ ሀርከኬኛስ ጀቤሲ ኑ ዻብ፤","poem":2},{"lineBreak":true},{"text":"ኤዬ፣ ሆጂ ሀርከኬኛ ጀቤሲ ኑ ዻብ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}