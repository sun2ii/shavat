{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":91,"content":[{"type":"verse","number":1,"content":[{"text":"ነምን ደኦ ዋቀ ዋን ሁንዳ ኦሊ ኬሰ ጅራቱ፣","poem":1},{"text":"ጋድሰ ዋቀ ዋን ሁንደ ደንደኡ ሰና ጀለ ቦቆተ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አንስ ዋቀዮን፣ “እን እዶ አን እት ኮሉ ገሉፊደአትኖኮት፤","poem":1},{"text":"ዋቀኮ ከን አን አመነዹዸ” ነንጄዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"እን ዹጉማን ክዮ አደምሳ ጀላ፣","poem":1},{"text":"ዹኩበ ነመ ፍጡ ጀላስ ስ ባሰ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እን ባሌሳቲን ስ ዾክሰ፤","poem":1},{"text":"አትስ ቆቾሳ ጀለት ኮሉ ንገልተ፤","poem":2},{"lineBreak":true},{"text":"አመነሙማንሳ ጋቸናፊ ደላ ኤጉምሳ ሲፍ ተአ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አትስ ናሱ ሀልከኒ፣","poem":1},{"text":"ዮካን ጥየ ጉያን ፉታፈሙ ህንሶዳቱ፤","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ጎልፋ ዱከነ ኬሰ ዴሙ፣","poem":1},{"text":"ዮካን ዸእቸ ጉያ ሳፋን ነመ በሌሱ ህንሶዳትኑ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኩምን ቶኮ ስ ጭነት፣","poem":1},{"text":"ኩምን ኩዸንሞ ምርገኬት ንኩፈ፤","poem":2},{"lineBreak":true},{"text":"ገሩ ስት ህንዽኣቱ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አት እጁመኬ ቆፋን እላልተ፤","poem":1},{"text":"አደበ ሀሞተት ዹፉስ ንአርግተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"አት ዋን ዋቀዮን እዶ ኮሉ እት ገልቱ፣","poem":1},{"text":"ዋቀ ዋን ሁንዳ ኦሊ እዶ ጅሬኘኬቲ ጎዸቴፍ፣","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ወን ሀማን ስ ህንቱቁ፤","poem":1},{"text":"ዸእችስ ዱንካነኬት ህንዽኣቱ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እን አከ እሳን ከራኬ ሁንደረት ስ ኤገኒፍ፣","poem":1},{"text":"ኤርገሞተሳ ሲፍ ንአጀጀ፤","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እሳንስ አከ ሚለኬቲን ዸጋት ህንቡኔፍ","poem":1},{"text":"ሀርከሳኒቲን ኦል ስ ፉዹ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አት ሌንጫፊ ቡቲረ ኤጄተ፤","poem":1},{"text":"ሌንጨ ሳፌላፊ ጀዌ ንዽዺተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ዋቀዮስ አከነ ጄዸ፤","poem":1},{"text":"“ሰበቢ እን ነ ጃለቱፍ፣ አን እሰ ነንኦልቸ፤","poem":2},{"lineBreak":true},{"text":"ዋን እን መቃኮ ቤኩፍ እሰ ነንኤገ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እን ነ ዋመተ፤ አንስ ነንዴብሳፍ፤","poem":1},{"text":"ረክነ ኬሰት አን እሰ ወጅን ነንተአ፤","poem":2},{"lineBreak":true},{"text":"እሰ ነንኦልቸ፤ ኡልፍነስ ነንኬናፍ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አን ኡሙሪ ዼራ እሰ ነንቁፍሰ፤","poem":1},{"text":"ፈይሱኮስ እሰት ነንአርግሲሰ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}