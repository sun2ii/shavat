{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":92,"content":[{"type":"hebrew_subtitle","content":["ፋርፈትና ጉያ ሰንበታ ፋርፈተሙ።"]},{"type":"verse","number":1,"content":[{"text":"ዋቀዮን፣ ገለቴፈቹን፣ ያ ዋቀ ዋን ሁንዳ ኦሊ፣","poem":1},{"text":"መቃኬቲፍ ፋርፈቹን ጋሪዸ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ጃለለኬ ገነማን፣","poem":1},{"text":"አመነሙማኬስ ሀልከኒን ለብሱን፣","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ክራረ ርቡ ኩዸኒቲን፣","poem":1},{"text":"ሰገሌ በገናቲንስ ለብሱን ጋሪዸ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ያ ዋቀዮ፣ አት ሆጂኬቲን ነ ገመቺፍታቲ፤","poem":1},{"text":"አን ሰበቢ ሆጂ ሀርከኬቲቲፍ ገመቹዻን ነንፋርፈዸ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ያ ዋቀዮ፣ ሆጂንኬ አከም ጉዳዸ፤","poem":1},{"text":"ያድንኬስ አከም ገድ ፈጎዸ!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ነምን ቀልቢ ህንቀብኔ ዋን ከነ ቤኩ ህንደንደኡ፤","poem":1},{"text":"ጎዋንስ ህንሁበቱ፤","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሀሞን ዮ አኩመ መርጋ ብቅለንዩ፣","poem":1},{"text":"ጀልኦትን ሁንድኑስ ዮ ደራረንዩ፣","poem":2},{"lineBreak":true},{"text":"እሳን በረ በራን ንበርበዳኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ያ ዋቀዮ፣ አት ገሩ በረ በራን ኦል ኦል ጄተ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ያ ዋቀዮ፣ ኩኖ ዲኖተኬ፣","poem":1},{"text":"ኩኖ ዲኖትንኬ ንበዱ፤","poem":2},{"lineBreak":true},{"text":"ወር ጀልእነ ሆጄተን ሁንድኑስ ንብትኔፈሙ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አት ጋንፈኮ አከ ጋንፈ ገፈርሳ ኦል ኦል ቀብዴ፤","poem":1},{"text":"ዘይቲ ሃራ ነት ዸንገላፍቴ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እጅኮ ሞአተሙ ዲኖተኮ አርጌረ፤","poem":1},{"text":"ጉርኮስ በዲሰ ጀልኦተ ነት ከአኒ ዸገኤረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ቀጄልቶትን አኩመ ሙከ ሜጢ ንደጋጉ፤","poem":1},{"text":"አኩመ ብርብርሰ ልባኖንት ንጉደቱ፤","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እሳን መነ ዋቀዮ ኬሰ ዻበመኒ ጅሩ፤","poem":1},{"text":"ኦብዲ ዋቀኬኛ ኬሰትስ እት ቶሌ ምሰኒ ጅረን።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እሳን አመዩ በረ ዱሉማ ኬሰ እጀ ነቀቱ፤","poem":1},{"text":"ገበተኒስ ደጋገኒ ጅራቱ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እሳንስ፣ “ዋቀዮ ቶላዸ፤ እን ከታኮት፤","poem":1},{"text":"ሀምን እሰ ኬሰ ህንጅሩ” ጄዸኒ ለብሱ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}