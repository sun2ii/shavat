{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":94,"content":[{"type":"verse","number":1,"content":[{"text":"ያ ዋቀዮ፣ ዋቀ ሃሎ ባፍቱ፣","poem":1},{"text":"ያ ዋቀ ሃሎ ባፍቱ፣ እፊ ሙልአዹ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ያ አባ ሙርቲ ለፈ ከና ከእ፤","poem":1},{"text":"ኦፍ ቱልቶታፍሌ ዋንሳኒ መሉ ኬን።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ያ ዋቀዮ፣ ሀመ ዮሚት ወር ሀሞን፣","poem":1},{"text":"ወር ሀሞን ሀመ ዮሚት ቡራቁ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"እሳን ዱቢ ኦፍ ቱሉማ ገድ ሮብሱ፤","poem":1},{"text":"ጀልኦትን ሁንድኑ ኦፍ ዺቡዻን ጉተመን።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ያ ዋቀዮ፣ እሳን ሰበኬ ሚዹ፤","poem":1},{"text":"ሀንዹራኬስ ንሀጩጩ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሃዸ ህዬሳቲፊ ኬሱማ ንጎረኡ፤","poem":1},{"text":"እጆሌ አባ ህንቀብኔስ ንአጄሱ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እሳን፣ “ዋቀዮ ህንአርጉ፤","poem":1},{"text":"ዋቅን ያቆብ ህንቀልቤፈቱ” ጄዹ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ወር ሰበ ኬሳ ራቶፍተን ሜ ሁበዻ፤","poem":1},{"text":"እስን ወር ጎዎትን ዮም ኦጌዪ ታቱ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እን ጉረ ኡሜ ሱን ህንዸገኡ?","poem":1},{"text":"እን እጀ ኡሜ ህንአርጉ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እን ሰቦተ ስሬሱ ሱን ህንአደቡ?","poem":1},{"text":"እን ነመ በርሲሱ ሱን ቤኩምሰ ህንቀቡ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዋቀዮ ያደ ነማ ቤከ፤","poem":1},{"text":"አከ ያድን ነማ ፋይዳ ህንቀብኔስ ንቤከ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ያ ዋቀዮ፣ ነምን አት አደብዱ፣","poem":1},{"text":"ነምን አት ሴረኬራ በርሲፍቱ ኤብፈማዸ፤","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሀመ ሀሞታፍ ቦል ቆተሙት፣","poem":1},{"text":"ጉያ ረክናት አት ቦቆና ኬንታፍ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዋቀዮ ሰበሳ ህንገቱቲ፤","poem":1},{"text":"እን አከነሌ ጄዼ ሀንዹራ ኦፊሳ ህንዺሱ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሙርቲን ቀጄሉማረት ሁንዴፈመ፤","poem":1},{"text":"ቶሎን ሁንድኑስ እሰ ፋነ ቡኡ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ኤኙቱ ሀሞተት ና ከአ?","poem":1},{"text":"ኤኙቱ ነ ጭነ ዻበቴ ወረ ጀልእነ ሆጄተኒን ሞርመ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኡቱ ዋቀዮ ነ ገርጋሩ ባቴ፣","poem":1},{"text":"ስላ ዮነ ሉቡንኮ ቦለ ዱኣ ኬሰ ጅርት።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ያ ዋቀዮ ዬሮ አን፣ “ሚልኮ ሙጩጫቴረ” ጄዼት፣","poem":1},{"text":"አራርኬ ኦል ቀቤ ነ ዻቤ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዮሙ ያዶን ነት ባይአቴት፣","poem":1},{"text":"ጀጀቤሱንኬ ሉቡኮ ገመቺሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ቡልችቶትን ሀሞን፣ ወር ሴረት ፈየደመኒ ጀልእነ ሆጄተን","poem":1},{"text":"ስ ወጅን ቶኩማ ቀባቹ ደንደኡ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"እሳን ቶኩማዻን ነመ ቀጄላት ከአኒ","poem":1},{"text":"ነመ የከ ህንቀብኔት ዱአ ሙሩ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዋቀዮ ገሩ ደኦ፣","poem":1},{"text":"ዋቅንኮስ፣ ከታ አን እት በቀዹ ና ተኤረ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"እን ገቲ ጩቡሳኒ እሳኑመት ዴብሰ፤","poem":1},{"text":"ሰበቢ ሀምነሳኒቲፍሌ እሳን በሌሰ፤","poem":2},{"lineBreak":true},{"text":"ዋቀዮ ዋቅንኬኘ እሳን በርበዴሰ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}