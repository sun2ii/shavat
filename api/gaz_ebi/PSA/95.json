ype":"verse","number":8,"content":[{"lineBreak":true},{"text":"አከ መሪባት ጎተን ሰነ፣","poem":1},{"text":"አከ ጋፈ ገሞጂ ኬሰት ማሳት ጎተን ሰናመታ ህንጀባትና፤","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አቦቲንኬሰን ኡቱመ ሆጂኮ አርገኑ፣","poem":1},{"text":"አችት ቆረኒ ነ እላለን።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዸሎተ ሰነት አን ወጋ አፉርተመ ነንዼከሜ፤","poem":1},{"text":"አንስ፣ “እሳን ሰበ ገራንሳኒ ከራራ ጀልአቴዸ፤","poem":2},{"lineBreak":true},{"text":"እሳን ከራኮ ህንቤክኔ” ነንጄዼን።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ከናፉ አን ዼከምሰኮቲን፣","poem":1},{"text":"“እሳን ቦቆናኮት ህንገለን” ጄዼ ከከዼ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}