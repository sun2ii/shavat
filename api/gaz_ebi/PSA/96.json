{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":96,"content":[{"type":"verse","number":1,"content":[{"text":"ፋርፈትና ሃራ ዋቀዮፍ ፋርፈዻ፤","poem":1},{"text":"ለፍት ሁንድኑ ዋቀዮን ፋርፈዻ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዋቀዮን ፋርፈዻ፤ መቃሳ ኤብሳ፤","poem":1},{"text":"ፈይሱሳስ ጉዩመ ጉያን ለብሳ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኡልፍነሳ ሰቦተ ግዱት፣","poem":1},{"text":"ሆጂሳ ድንቅሲሳ ሰነሞ ነሞተ ሁንደ ኬሰት ለብሳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ዋቀዮ ጉዳዻቲ ገለን ባይኤን እሳፍ ንመለ፤","poem":1},{"text":"እን ዋቆተ ሁንዳ ኦልትስ ሶዳተሙ ቀበ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዋቆትን ሰቦተ ኦርማ ሁንድኑ ዋቆተ ቶልፈሞዻቲ፤","poem":1},{"text":"ዋቀዮ ገሩ ሰሚወን ኡሜ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሚዸግኒፊ ሱራን ፉለሳ ዱረ ጅሩ፤","poem":1},{"text":"ጀብኒፊ ኡልፍን እዶ ቁልቁሉማሳ ኬሰ ጅሩ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ያ ማቲወን ሰቦታ ዋቀዮፍ ኬና፤","poem":1},{"text":"ኡልፍናፊ ጀብነ ዋቀዮፍ ኬና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኡልፍነ መቃሳቲፍ መሉ ዋቀዮፍ ኬና፤","poem":1},{"text":"ኣርሳ ፍዳቲ ኦብዲሳ ሴና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"በሬድነ ቁልቁሉማሳቲን ዋቀዮን ዋቄፈዻ፤","poem":1},{"text":"እስን ለፍት ሁንድኑ ፉለሳ ዱረት ሆለዻ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሰቦተ ግዱት፣ “ዋቀዮ ሞቲዸ” ጄዻ፤","poem":1},{"text":"አዱኛን ጀባቴ ዻበቴርት፤ ሶቾፈሙስ ህንደንዴሱ።","poem":2},{"lineBreak":true},{"text":"እን ቀጄሉማዻን ሰቦታፍ ሙርቲ ኬነ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ሰሚወን ሃእልልቸን፤ ለፍትስ ሃገመዱ፤","poem":1},{"text":"ገላኒፊ ወን እሰ ኬሰ ጅሩ ሁንድኑ ሃሁርሱ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ድሬወኒፊ ወን እሳንረ ጅረን ሁንድኑ ሃገመደን።","poem":1},{"text":"ሙኬን ቦሶና ሁንድኑስ ገመቹዻን ሃፋርፈተን።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኡመምን ሁንድ ፉለ ዋቀዮ ዱረት ሃፋርፈቱ፤ እን ንዹፋቲ፤","poem":1},{"text":"እን ለፈት ሙርቴሱፍ ንዹፈ።","poem":2},{"text":"አዱኛት ቀጄሉማዻን፣","poem":1},{"text":"ሰቦተትሞ ዹጋ እሳቲን ንሙረ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}