{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"PSA","translationId":"gaz_ebi","name":"ፋርፈትና","commonName":"ፋርፈትና","title":"ክታቦተ ፋርፈትና","order":19,"numberOfChapters":150,"sha256":"1bec4e1be87ca4cffff093235b0486b252f8ec47b4c03b5847b3779998e78988","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gaz_ebi/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"ዋቀዮ ሞኤረ፤ ለፍት ሃገመዱ፤","poem":1},{"text":"ብዮን ቀርቀረ ገላና ሄዱንስ ሃእልልቸን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ዱሜሳፊ ዱከን ልምጢን እሰ መርሰኒሩ፤","poem":1},{"text":"ቀጄሉማፊ ሙርቲ ቀጄላን ሁንዴ ቴሶሳት።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እብድ ፉለሳ ዱረ ዴሜ","poem":1},{"text":"ዲኖተሳ ናኖሳቲ ፍጠ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"በለቄንሳ አዱኛ እብሰ፤","poem":1},{"text":"ለፍትስ አርግቴ ሆለት።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ቱሉወን ፉለ ዋቀዮ ዱረት፣","poem":1},{"text":"ፉለ ጎፍታ ለፈ ሁንዱማ ዱረትስ አኩመ ገጋ በቁ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሰሚወን ቀጄሉማሳ ለብሱ፤","poem":1},{"text":"ሰቦትን ሁንድኑስ ኡልፍነሳ አርጉ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ወር ፈኪ ዋቄፈተን፣","poem":1},{"text":"ከኔን ዋቆተ ቶልፈሞን ኦፍ ጀጀን ሁንድ ሃቃኔፈመን፤","poem":2},{"lineBreak":true},{"text":"እስን ዋቆትን ሁንድኑስ እሰ ዋቄፈዻ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ያ ዋቀዮ፣ ሰበቢ ሙርቲኬቲቲፍ፣","poem":1},{"text":"ጥዮን ዸጌሴ እልልችት፤","poem":2},{"lineBreak":true},{"text":"ገንዶትን ይሁዳስ ንገመዱ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ያ ዋቀዮ፣ አት ለፈ ሁንዱማረት ዋቀ ዋን ሁንዳ ኦሊት፤","poem":1},{"text":"አት ዋቆተ ሁንዱማረ አከ መሌ ኦል ኦል ጄቴርተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ሰበቢ እን ሉቡ አመነሞተሳ ኤጌ፣","poem":1},{"text":"ሀርከ ሀሞታ ጀላ እሳን ባሱፍ፣","poem":2},{"lineBreak":true},{"text":"ወር ዋቀዮን ጃለተን ሀምነ ሃጅበን።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ቀጄልቶተረት እፍን ንእፈ፤","poem":1},{"text":"ገረ ቶሎታፍስ ገመቹን ንዹፈ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እስን ቀጄልቶትን ዋቀዮት ገመዳ፤","poem":1},{"text":"መቃሳ ቁልቁሉስ ገለቴፈዻ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}