"verse","number":7,"content":[{"text":"ገላኒፊ ወን እሰ ኬሰ ጅሩ ሁንድኑ፣","poem":1},{"text":"አዱኛፊ ወንት እሼ ኬሰ ጅራቱ ሁንድኑ ሃሁርሰን።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ለጌን ሀርከሳኒ ሃሩሩኩተን፤","poem":1},{"text":"ቱሉወንስ ቶኩማዻን ሃእልልቸን፤","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እሳን ፉለ ዋቀዮ ዱረት ሃፋርፈተን፤","poem":1},{"text":"እን ለፈት ሙርቴሱ ንዹፋቲ።","poem":2},{"text":"እን አዱኛፍ ቀጄሉማዻን፣","poem":1},{"text":"ነሞታፍሞ ኡቱ ወል ህንጫልችስን ሙርቲ ኬነ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}