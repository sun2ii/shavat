{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"REV","translationId":"gaz_ebi","name":"ሙልአተ","commonName":"ሙልአተ","title":"ሙልአተ ዮሀንስ","order":66,"numberOfChapters":22,"sha256":"fed6e44b12d855ec38f5bd050986788f77becd31c388cf2d5759bf89ac65cfb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/gaz_ebi/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":18,"content":[{"type":"heading","content":["ኩፋቲ ባብሎኒቲፍ ቦኡ"]},{"type":"verse","number":1,"content":["ኤርገሲስ ኡቱ ኤርገማን ብራ ሰሚራ ገድ ቡኡ ነንአርጌ። እንስ ታይታ ጉዳ ቀበ ቱሬ፤ ኡልፍነሳቲንስ ለፍት ንእፍቴ።"]},{"type":"verse","number":2,"content":["እንስ አከነ ጄዼ ሰገሌ ጉዳዻን እዬ፦",{"text":"“ኩፍቴርት! ባብሎን ጉድቲን ኩፍቴርት!","poem":1},{"text":"ለፈ ጅሬኘ ሀፉሮተ ሀሞ፣","poem":2},{"text":"ለፈ ቁበተ ሀፉሮተ ጡራኦ ሁንዳ፣","poem":1},{"text":"እዶ ጅሬኘ ስምብሮተ ጡራኦ፣","poem":2},{"lineBreak":true},{"text":"እዶ ጅሬኘ ብኔንሶተ ጡራኦፊጅብሲሶ ሁንዳ ታቴርት።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሰቦትን ሁንድኑስ፣","poem":1},{"text":"ዳዺ ወይኒ ዼከምሰ ሰጋገለሼ ዹገኒሩቲ።","poem":2},{"text":"ሞቶትን ለፋስ እሼ ወጅን ሰጋገለኒሩ፤","poem":1},{"text":"ደልደልቶትን አዱኛስ ቀነኒሼጉዳ ሰናን ሶሮመኒሩ።”","poem":2}]},{"type":"line_break"},{"type":"heading","content":["ሙርቲ ባብሎን ጀላ ምልቁ"]},{"type":"verse","number":4,"content":["ሰገሌ ብራስ ሰሚራ ነንዸገኤ፤ እንስ አከነ ጄዸ፦",{"text":"“ ‘ያ ሰበኮ፣ እስን አከ ጩቡሼ ኬሰት ህንህርማትኔፍ፣","poem":1},{"text":"በላ እሼረ ገኡስ አከ ህንቆደትኔፍ፣","poem":2},{"lineBreak":true},{"text":"ኮታ እሼ ኬሳ በኣ፤’","poem":2},{"noteId":31}]},{"type":"verse","number":5,"content":[{"text":"ጩቡንሼ ሀመ ሰሚት ኦል ቱለሜራቲ፤","poem":1},{"text":"ዋቅንስ ጀልእነሼ ያደቴረ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አኩመ እሼን ኬንቴት እስንስ እሼፍ ኬና፤","poem":1},{"text":"አኩመ ሆጂሼትስ ደቻ ለመ ጎዻቲ እሼፍ ዴብሳ።","poem":2},{"lineBreak":true},{"text":"ጦፎ እሼን እት ቡልቡልቴትስ ደቻ ለመ ጎዻቲ እሼፍ ቡልቡላ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሀሙመ እሼን ኡልፍነ ኦፊ ኬንቴ ቀነኒ ጉዳዻን ጅራቴ ሰነ፣","poem":1},{"text":"ቅጤዹመሳ ዽጵናፊ ገደ እሼፍ ኬና።","poem":2},{"text":"እሼንስ ገራሼ ኬሰት፣","poem":1},{"text":"‘አን አከ ሞትቲ ቶኮት ነንታአ፤","poem":2},{"text":"አን ሃዸ ህዬሳ ምት፤","poem":1},{"text":"ጎንኩማስ ህንገዱ’ ጄቴ ኦፍ ጀጅ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ከናፉ ዸእች ገራ ገራ ጄቹንስ፣","poem":1},{"text":"ዱት፣ ገዲፊ ቤል ጉዩመ ቶኮት እሼረ ንገአ።","poem":2},{"text":"ዋቅን ጎፍታን እሼት ሙርቴሱ ሱን ዋን ጀባ ተኤፍ፣","poem":1},{"text":"እሼን እብዳን ንጉበምት።","poem":2}]},{"type":"heading","content":["ዋኤ ኩፋቲ ባብሎኒቲፍ ወዮ"]},{"type":"verse","number":9,"content":["“ሞቶትን ለፋ ወር እሼ ወጅን ሰጋገለኒፊ ወር ቀነኒ ጉዳዻን እሼ ወጅን ጅራተን ዮሙ ኣረ ጉበሙሼ አርገንት እሼፍ ንቦኡ፤ ንወዋቱስ።"]},{"type":"verse","number":10,"content":["እሳንስ ዽጵነሼ ዋን ሶዳተኒፍ ፈጎ ዻበተኒ፣",{"text":"“ ‘ወዮ! ወዮ! ያ መጋላ ጉድቲ፣","poem":1},{"text":"ያ ባብሎን መጋለቲ ጀብዱ!","poem":2},{"text":"በዲንኬ ሰኣቱመ ቶኮ ኬሰት ዹፌራቲ!’ ጄዹ።","poem":1}]},{"type":"verse","number":11,"content":["“ደልደልቶትን ለፋስ ስአች ዋን ነምን ቶኮዩ ምአ ደልደለሳኒ ህንብትኔፍ እሼፍ ንቦኡ፤ ንወዋቱስ።"]},{"type":"verse","number":12,"content":["ምእ ደልደለሳኒስ ወርቄ፣ ሜቲ፣ ዸጋወን ገቲ ጉዳቲፊ ሉለ፣ ኡፈተ ሀጲ ቁንጬ ተልባራ ሆጄተሜ፣ ኡፈተ ዺልጌ፣ ኡፈተ ሃሪቲፊ ብልዲማ፣ ሙከ ኡርጋኣ ጎሰ ሁንዳ፣ ምአ እልከ አርባራ ሆጄተሜ ሁንደ፣ ምአ ሙከ ገቲ ጉዳራ ሆጄተሜ ሁንደ፣ ምአ ናሲራ ሆጄተሜ ሁንደ፣ ምአ ስቢላቲፊ ምአ ዸጋ አዲራ ሆጄተሜ ሁንዳፊ"]},{"type":"verse","number":13,"content":["ቀረፋፊ ኡርጎፍቱ፣ እጣነ፣ ቁምቢ፣ ሀጴ ኡርጋኣ፣ ዳዺ ወይኒቲፊ ዘይቲ ኤጄርሳ፣ ዳኩ ቡላኣፊ ቀመዲ፣ ሎወኒፊ ሆሎተ፣ ፈርዴኒፊ ጋሪወን፣ አከሱመስ ገርቦታፊ ሉቡወን ነሞታ ፈእ።"]},{"type":"verse","number":14,"content":["“እሳንስ፣ ‘እጅ ዋን አት ሀውቴ ሰና ስ ዱራ በዴረ። በዻዹማፊ በሬድንኬ ሁንድኑ ስራ በዴረ፤ ጎንኩማስ ዴብቴ ህንአርገቱ’ እሼዻን ጄዹ።"]},{"type":"verse","number":15,"content":["ደልደልቶትን ምአ ከኔን ጉርጉረተኒ እሼራ በዻዹማ አርገተንስ ዽጵነሼ ሶዳተኒ ፈጎ ዻበቱ። እሳንስ ቦኣ፣ ወዋቻስ፣"]},{"type":"verse","number":16,"content":["ሰገሌ ጉዳዻን አከነ ጄዹ፦",{"text":"“ ‘ወዮ! ወዮ፣ ያ መጋላ ጉድቲ፤","poem":1},{"text":"ያ እሼ ኡፈተ ሀጲ ቁንጬ ተልባራ ሆጄተሜ፣","poem":2},{"lineBreak":true},{"text":"ኡፈተ ዺልጌፊ ኡፈተ ብልዲማ ኡፈቴ፣","poem":2},{"text":"ያ እሼ ወርቄዻን፣","poem":1},{"text":"ዸጋ ገቲ ጉዳቲፊ ሉላን ሚዸግፈምቴ!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"በዻዹማን ጉዳን አከና ሰኣቱመ ቶኮ ኬሰት በርበዳኤ!’","poem":1},"“አጀጁን ዶኒ ሁንድኑ፣ ወር ዶኒን እመለ ዴመን ሁንድኑ፣ ወር ዶኒረ ሆጄተኒፊ ወር ገላነረ ሆጄቹን ጅራተን ሁንድኑ ፈጋተኒ ንዻበቱ።"]},{"type":"verse","number":18,"content":["እሳን ዮሙ ኣረ ጉበሙሼ አርገንት፣ ‘መጋላን አከ መጋላ ጉድቲ ከና ጅራቴ ቤክቲ?’ ጄዸኒ እዩ።"]},{"type":"verse","number":19,"content":["እሳንስ አዋረ መታት ፍርፍርፈተኒ ቦኣ፣ ወዋቻስ አከነ ጄዸኒ እዩ፦",{"text":"“ ‘ወዮ! ወዮ፣ ያ መጋላ ጉድቲ፣","poem":1},{"text":"ያ እሼ ወር ገላነራ ዶኒወን ቀበን ሁንድኑ","poem":2},{"lineBreak":true},{"text":"ቀቤኘሼቲን ሶሮመን!","poem":2},{"text":"እሼ ሰኣቱመ ቶኮ ኬሰት በርበዶፍቴ!’","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ያ ሰሚ ኩፋቲሼት ገመድ!","poem":1},{"text":"እስን ሰብን ዋቃ ገመዳ!","poem":2},{"text":"ኤርገሞትኒፊ ራጆትን ገመዳ!","poem":1},{"text":"ዋቅን እሼረት እስኒፍ ሙሬራቲ።”","poem":2}]},{"type":"heading","content":["ጡሙረ በዲሰ ባብሎን"]},{"type":"verse","number":21,"content":["ኤርገማን ጀባን ቶኮስ ዸጋ ሀመ ዸጋ ዳኩ ገኡ ቶኮ ፉዼ ገላነት ገድ ደርበቴ አከነ ጄዼ፦",{"text":"“ባብሎን መጋላ ጉድቲን፣","poem":1},{"text":"አከሱመ ፉርጉግፈምቴ ንደርበተምት፤","poem":2},{"lineBreak":true},{"text":"ጎንኩማስ ዴብቴ ህንአርገምቱ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ሰገሌን ወረ በገናፊ ሙዚቃ ተጰተኒ፣","poem":1},{"text":"ሰገሌን ወረ ኡሉሌፊ መለከተ አፉፈኒ","poem":2},{"lineBreak":true},{"text":"ስአች ስ ኬሰት ህንዸገአሙ።","poem":2},{"text":"ኦጌስ ኦጉማ ሆጂ ሀርካ ቶኮሌ፣","poem":1},{"text":"ስአች ስ ኬሰት ህንአርገሙ።","poem":2},{"text":"ሰገሌን ዸጋ ዳኩስ፣","poem":1},{"text":"ስአች ስ ኬሰት ህንዸገአሙ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"እፍን እብሳ፣ ለመተ ስ ኬሰት ህንእፉ።","poem":1},{"text":"ሰገሌን ምስርቻቲፊ ምስርቲ፣","poem":2},{"lineBreak":true},{"text":"ለመተ ስ ኬሰት ህንዸገአሙ።","poem":2},{"text":"ደልደልቶትንኬ ነሞተ ጉርጉዳ አዱኛ ቱረን።","poem":1},{"text":"ፈልፈለኬቲን ሰብን ሁንድኑ ጎዎምፈሜረ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዺግን ራጆታቲፊ ዺግን ቁልቁሎታ፣","poem":1},{"text":"ዺግን ወረ ለፈረት ጎረአመን ሁንዱማስእሼ ኬሰት አርገሜ።”","poem":2}]}],"footnotes":[{"noteId":31,"caller":"+","text":"ኤር 51፥45","reference":{"chapter":18,"verse":4}}]},"thisChapterLink":"/api/gaz_ebi/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}