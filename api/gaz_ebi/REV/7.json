{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"REV","translationId":"gaz_ebi","name":"ሙልአተ","commonName":"ሙልአተ","title":"ሙልአተ ዮሀንስ","order":66,"numberOfChapters":22,"sha256":"fed6e44b12d855ec38f5bd050986788f77becd31c388cf2d5759bf89ac65cfb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/gaz_ebi/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":7,"content":[{"type":"heading","content":["ነሞትን 144,000 ቻፔፈመን"]},{"type":"verse","number":1,"content":["ኤርገሲስ አን ኡቱ ኤርገሞትን አፉር ጎሌ ለፋ አፍረንረ ዻበተኒ አከ ቡቤን ለፈት ዮካን ገላነት ዮካን ሙከ ከምትዩ ህንቡብፍኔ ቡቤ ለፋ አፍረን ዾወኑ ነንአርጌ።"]},{"type":"verse","number":2,"content":["ኤርገማን ቻፓ ዋቀ ጅራታ ቀቡ ካንሞ ኡቱ ከራ በአ ቢፍቱቲን ኦል በኡ ነንአርጌ። እንስ ኤርገሞተ አፍረን አከ እሳን ለፋፊ ገላነ ሚዸኒፍ ሁምን ኬነሜፍ ሰነ ሰገሌ ጉዳዻን ዋሜ፣"]},{"type":"verse","number":3,"content":["“ሀመ ኑ አደ ተጃጅልቶተ ዋቀኬኛረት ቻፓ ጎኑት ለፈ ዮካን ገላነ ዮካን ሙከ ህንሚዽና” ጄዼ።"]},{"type":"verse","number":4,"content":["አንስ ባይእነ ወረ ቻፔፈመኒ ዸገኤ፦ ጎሰ እስራኤል ሁንደ ኬሳ 144,000 ቱሬ።"]},{"type":"line_break"},{"type":"verse","number":5,"content":["ጎሰ ይሁዳ ኬሳ 12,000፣ ጎሰ ሩቤን ኬሳ 12,000፣ ጎሰ ጋድ ኬሳ 12,000፣"]},{"type":"verse","number":6,"content":["ጎሰ አሴር ኬሳ 12,000፣ ጎሰ ንፍታሌም ኬሳ 12,000፣ ጎሰ ምናሴ ኬሳ 12,000፣"]},{"type":"verse","number":7,"content":["ጎሰ ስምኦን ኬሳ 12,000፣ ጎሰ ሌዊ ኬሳ 12,000፣ ጎሰ ይሳኮር ኬሳ 12,000፣"]},{"type":"verse","number":8,"content":["ጎሰ ዜቡሎን ኬሳ 12,000፣ ጎሰ ዮሴፍ ኬሳ 12,000፣ ጎሰ ቤንያም ኬሳ 12,000 ቱረን።"]},{"type":"heading","content":["ቱተ ነሞተ ኡፈተ አዳዲ ኡፈተኒ"]},{"type":"verse","number":9,"content":["አንስ ከነ ቦዴ ነንእላሌ፤ ኩኖ፣ ቱትን ጉዳን ነምን ቶኮዩ ለካኡ ህንደንዴኜ ከን ሰበ ሁንዱማ፣ ጎሰ ሁንዱማ፣ ነመ ሁንዱማፊ አፋን ሁንዱማ ኬሳ ወልት ቀበሜ ቶኮ ቴሶ ሰነ ዱራፊ ፉለ ሆልቻ ዱረ ዻበቴ ቱሬ። እሳንስ ኡፈተ አዳዲ ኡፈተኒ፣ ደሜ ሜጢስ ሀርከት ቀበተኒ ቱረን።"]},{"type":"verse","number":10,"content":["እሳንስ ሰገሌ ጉዳዻን፣",{"text":"“ፈይን ከን ዋቀኬኘ","poem":1},{"lineBreak":true},{"text":"እሰ ቴሶረ ታኡቲፊ","poem":1},{"lineBreak":true},{"text":"ከን ሆልቻት”","poem":1},"ጄዸኒ እየን።"]},{"type":"verse","number":11,"content":["ኤርገሞትን ሁንድኑ ቴስቸት፣ ማንጉዶታፊ ኡመመወን ሉቡ ቀቤዪ አፍረንት ናነአኒ ዸዻበቻ ቱረን። እሳንስ አደሳኒቲን ፉለ ቴሶ ሰና ዱረት ጎምብፈመኒ ዋቃፍ ሰገደን፤"]},{"type":"verse","number":12,"content":["አከነስ ጄዸን፦",{"text":"“አሜን!","poem":1},{"lineBreak":true},{"text":"ኤቢፊ ኡልፍን፣ ኦጉማን፣ ገለን፣","poem":1},{"lineBreak":true},{"text":"ከበጅን፣ ሁምኒፊ ጀብን፣","poem":1},{"lineBreak":true},{"text":"በረ በራ ሀመ በረ በራት","poem":1},{"lineBreak":true},{"text":"ዋቀኬኛፍ ሃተኡ።","poem":1},{"lineBreak":true},{"text":"አሜን!”","poem":1}]},{"type":"verse","number":13,"content":["ማንጉዶተ ኬሳስ እን ቶኮ፣ “ወር ኡፈተ አዳዲ ኡፈተን ኩኔን ኤኙ ፈእ? ኤሳ ዹፈን?” ጄዼ ነ ጋፈቴ።"]},{"type":"verse","number":14,"content":["አንስ፣ “ያ ጎፍታ፣ ስቱ ቤከ” ጄዼን ዴብሴፍ። እንሞ አከነ ናን ጄዼ፤ “እሳን ኩኔን ወረ ዽጵነ ጉዳ ኬሳ በአኒ ዹፈኒዸ፤ እሳንስ ዺገ ሆልቻቲን ኡፈተሳኒ ሚጨተኒ አዴፈተኒሩ።"]},{"type":"verse","number":15,"content":["ከናፉ፣",{"text":"“እሳን ቴሶ ዋቃ ዱረ ጅሩ፤","poem":1},{"text":"ሀልከኒ ጉያስ መነ ቁልቁሉማሳኬሰት እሰ ተጃጅሉ፤","poem":2},{"text":"እን ቴስቸረ ታኤ ጅሩ ሱንስ","poem":1},{"text":"እሳን ግዱ ጅራተ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"‘እሳንስ ስአች ጎንኩማ ህንቤለአን፤","poem":1},{"text":"ስአችስ ጎንኩማ ህንዼቦተን።","poem":2},{"text":"አዱን እሳን ህንዸኡ፤’","poem":1},{"noteId":23},{"text":"ሆእ ፍኒናንስ እሳን ህንጉቡ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሆልች ወለካ ቴሶ ሰና ጅሩ","poem":1},{"text":"ትክሴሳኒ ንተኣቲ፤","poem":2},{"text":"‘እን ገረ ቡርቃ ብሻን ጅሬኛት እሳን ጌሰ።’","poem":1},{"text":"‘ዋቅንስ እምማን ሁንደ እጀሳኒራ ንሀቀ።’ ”","poem":2}]}],"footnotes":[{"noteId":23,"caller":"+","text":"እሳ 49፥10","reference":{"chapter":7,"verse":16}}]},"thisChapterLink":"/api/gaz_ebi/REV/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/REV/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/REV/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}