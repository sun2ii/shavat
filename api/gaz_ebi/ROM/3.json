{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ROM","translationId":"gaz_ebi","name":"ሮማ","commonName":"ሮማ","title":"ሮማ","order":45,"numberOfChapters":16,"sha256":"5c08214fe481e249f2ff787d91012d83692712b207660f175655c11c700e04b7","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ROM/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/gaz_ebi/ROM/16.json","totalNumberOfVerses":433},"chapter":{"number":3,"content":[{"type":"heading","content":["አመነሙማ ዋቃ"]},{"type":"verse","number":1,"content":["ኤጋ ይሁዲ ተኡን ፋይዳ ማሊ ቀበ? ዮካን ቡኣን ዸግነ ቀባ ማሊ?"]},{"type":"verse","number":2,"content":["ከራ ሁንዳኑ ቡኣ ጉዳ ቀበ! ጀልቀበት ዱቢን ዋቃ ይሁዶተት እማና ኬነሜ።"]},{"type":"verse","number":3,"content":["እሳን ኬሳ ቶኮ ቶኮ ዮ ህንአመንን ማልሬ? አመንቲ ዸቡንሳኒ አመነሙማ ዋቃ ንበሌሳ?"]},{"type":"verse","number":4,"content":["ጎንኩማ ህንተኡ! ነሞትን ሁንድኑ ሶብዶተ፣ ዋቅንሞ ዹጋ ቀቤሰ ሃተኡ። ኩንስ አኩመ፣",{"text":"“አከ አት ዱቢኬቲን ዹገ ቀቤሰ ታቱፍ፣","poem":1},{"text":"ዮሙ ሙርቲት ዽኣቱትስ አከ ሞአቱፍ”","poem":2},{"noteId":3},"ጄዸሜ በሬፈሜዸ።"]},{"type":"verse","number":5,"content":["ዮ ጀልእንኬኘ ቀጄሉማ ዋቃ እፈ ባሴ ገሩ ማል ጄነሬ? ዋቅን ዼከምሰሳ ኑት ፍዱንሳ ቀጄሉማ ዸቤቲ? ከነስ አን አከ ነማትን ዱበዸ።"]},{"type":"verse","number":6,"content":["ጎንኩማ ህንተኡ! ኡቱ አከስ ተኤ ስላ ዋቅን አከምት አዱኛት ሙሩ ደንደአሬ?"]},{"type":"verse","number":7,"content":["ነምን ቶኮ፣ “ዮ ሶበኮቲን ዹገ ቀቤሱማን ዋቃ ጉደቴ ኡልፍንሳስ ባይአቴ ማሊፍ ሀመ አማት አከ ጩበማ ቶኮት ነት ሙረመሬ?” ጄዼ ፈልመ ተአ።"]},{"type":"verse","number":8,"content":["ኩንስ እሰ ነሞትን ቶኮ ቶኮ፣ “እሳን፣ ‘አከ ወን ጋሪን ዹፉፍ ሀምነ ሃሆጄትኑ?’ ጄዹ” ጄዸኒ ኑረት ኦዴስሰኒዸ። ሙርቲን እሳንት ሙረሙስ ዋኑመ መሉዸ!"]},{"type":"heading","content":["ነምን ከምዩ ቀጄላ ምት"]},{"type":"verse","number":9,"content":["ኤጋ ማል ጄነሬ? ኑ ይሁዶትን ወረ ካን ጫላ? ጎንኩማ አከስ ምት! አከ ይሁዶትኒፊ ግሪኮትን ሁንድኑ ጩቡ ጀለ ጅረን ዱራን ዱርስኔ ምርከኔስኔራቲ።"]},{"type":"verse","number":10,"content":["ኩንስ ከን አከነ ጄዸሜ በሬፈሜዸ፦",{"text":"“ቀጄላን ቶኮዩ ህንጅሩ፤ ነምን ቶኮዩ፤","poem":1}]},{"type":"verse","number":11,"content":[{"text":"ነምን ሁበትና ቀቡ፣","poem":2},{"lineBreak":true},{"text":"ከን ዋቀ በርባዱ ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሁንድኑ ዶጎጎረኒሩ፤","poem":1},{"text":"ወሉመት ወረ ፋይዳ ህንቀብኔ ተአኒሩ፤","poem":2},{"text":"ነምን ዋን ጋሪ ሆጄቱ ቶኮዩ ህንጅሩ፤","poem":1},{"text":"ቶኩምትዩ ህንጅሩ።”","poem":2},{"noteId":4}]},{"type":"verse","number":13,"content":[{"text":"“ላጋንሳኒ አዋለ በነማዸ፤","poem":1},{"text":"አረበሳኒቲን ንጎዎምሱ።”","poem":2},{"noteId":5},{"text":"“ሀዻን ቡቲ ህዺሳኒ ጀለ ጅረ።”","poem":1},{"noteId":6}]},{"type":"verse","number":14,"content":[{"text":"“አፋንሳኒ አባርሳፊ ሀዻኡማን ጉተሜ።”","poem":2},{"noteId":7}]},{"type":"verse","number":15,"content":[{"text":"“ሚልሳኒ ዺገ ዸንገላሱት አሪፈተ፤","poem":1}]},{"type":"verse","number":16,"content":[{"text":"በዲሳፊ ገደዶቱ ከራሳኒረ ጅረ፤","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ከራ ነጋስ ህንቤከን።”","poem":1},{"noteId":8}]},{"type":"verse","number":18,"content":[{"text":"“ዋቀ ሶዳቹን እጀሳኒ ዱረ ህንጅሩ።”","poem":2},{"noteId":9}]},{"type":"verse","number":19,"content":["አከ አፋን ሁንድ ጩፈሙፊ አከ አዱኛን ሁንድኑ ሙርቲ ዋቃ ጀለ ገሉፍ፣ ወን ሴር ጄዹ ሁንድኑ አከ ወረ ሴረ ጀለ ጅረኒፍ ዱበቱ ንቤክነ።"]},{"type":"verse","number":20,"content":["ከናፍስ ኤኙዩ ሴረ ኤጉዻን ፉለ ዋቃ ዱረት ቀጄላ ህንተኡ፤ ሴረቱ ጩቡ ኑ ሁበቺሳቲ።"]},{"type":"heading","content":["ቀጄሉማ አመንቲን አርገሙ"]},{"type":"verse","number":21,"content":["አመ ገሩ ቀጄሉማን ዋቃን ኬነሙ ከን ሴራን አደ ተኤ፣ ከን ሴሪፊ ራጆትን ዹጋ በአኒፍ ሙልአቴረ።"]},{"type":"verse","number":22,"content":["ቀጄሉማን ዋቃ ኩን አመንቲዻን ወረ ዬሱስ ክርስቶስት አመነን ሁንዳፍ ኬነመ፤ ነመ ወል ጫልችሱን ህንጅሩ፤"]},{"type":"verse","number":23,"content":["ሰበቢ ሁንድሳኒዩ ጩቡ ሆጄተኒፍ እሳን ኡልፍነ ዋቃራ ጭተኒሩቲ፤"]},{"type":"verse","number":24,"content":["እሳንስ አያነ ዋቃ እሰ ፉረመ ከራ ክርስቶስ ዬሱሲን ቶሉመ ኬነሜፊን ቀጄልቶተ ታስፈመኒሩ።"]},{"type":"verse","number":25,"content":["ዺገሳት አመንቲ ቀባቹዻንስ አከ እን ኣርሳ አራራ ተኡፍ ዋቅን እሰ ዽኤሴ። ዋን ከነ ጎቹንሳስ ጩቡ ከናን ዱረ ሆጄተሜ ኡቱ ህንአደብን ዋን ኦብሳን ብረ ደርቤፍ ቀጄሉማሳ አርግሲሱፍ ጄዼት፤"]},{"type":"verse","number":26,"content":["ዋቅን ዬሮ አማ ቀጄሉማሳ አርግሲሱፊ አከ ነመ ዬሱስት አመኑስ ቀጄላ ተኡሳ ለብሱፍ ዋን ከነ ጎዼ።"]},{"type":"heading","content":["ሴር ኬነሙሳ"]},{"type":"verse","number":27,"content":["ዮስ ኦፍ ቱሉን ኤሰ ጅረሬ? እን ሀፌረ። ሴረ ከሚን? ሴረ ኤጉዻንሞ? ምት፤ ሴረ አመንቲቲን መሌ።"]},{"type":"verse","number":28,"content":["ኑ አከ ነምን ሴረ ኤጉዻን ኡቱ ህንተእን አመንቲዻን ቀጄላ ታስፈሙ ንአመናቲ።"]},{"type":"verse","number":29,"content":["ዋቅን ዋቀ ይሁዶታ ቆፈሞ? እን ዋቀ ነሞተ ኦርማስ ምቲ? ኤዬ፣ እን ዋቀ ነሞተ ኦርማትስ፤"]},{"type":"verse","number":30,"content":["ኤጋ ከን ዸግነ ቀበቴስ አመንቲን፣ ከን ዸግነ ህንቀበትንስ አመንቲዹመ ሰናን ቀጄላ ከን ታስሱ ዋቁመ ቶክቸ።"]},{"type":"verse","number":31,"content":["ዮስ ኑ አመንቲ ከናን ሴረ ሰነ ጨብስናሬ? ጎንኩማ አከስ ምት! ሴርቸ ንጭምስነ መሌ።"]}],"footnotes":[{"noteId":3,"caller":"+","text":"ፋር 51፥4","reference":{"chapter":3,"verse":4}},{"noteId":4,"caller":"+","text":"ፋር 14፥1‑3፤ 53፥1‑3፤ ለለ 7፥20","reference":{"chapter":3,"verse":12}},{"noteId":5,"caller":"+","text":"ፋር 5፥9","reference":{"chapter":3,"verse":13}},{"noteId":6,"caller":"+","text":"ፋር 140፥3","reference":{"chapter":3,"verse":13}},{"noteId":7,"caller":"+","text":"ፋር 10፥7","reference":{"chapter":3,"verse":14}},{"noteId":8,"caller":"+","text":"እሳ 59፥7፣8","reference":{"chapter":3,"verse":17}},{"noteId":9,"caller":"+","text":"ፋር 36፥1","reference":{"chapter":3,"verse":18}}]},"thisChapterLink":"/api/gaz_ebi/ROM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ROM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ROM/2.json","previousChapterAudioLinks":{},"numberOfVerses":31}