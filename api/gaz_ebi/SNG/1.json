{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"SNG","translationId":"gaz_ebi","name":"ዌዱ","commonName":"ዌዱ","title":"ዌዱ ዌዶታ","order":22,"numberOfChapters":8,"sha256":"3430f9d1f1fac27f4e3c70e7e96930715f05fe0b3b02c3e506f8d07959efeb81","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gaz_ebi/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["ዌዱ ዌዶታ ሶሎሞን።"]},{"type":"verse","number":2,"content":[{"text":"እን ዹንጎ አፋንሳቲን ነ ሃዹንገቱ፤","poem":1},{"text":"ጃለልኬ ዳዺ ወይኒ ጫላቲ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኡርጋን ሽቶኬቲ ነመት ቶለ፤","poem":1},{"text":"መቃንኬ አኩመ ሽቶ ዸንገላፈሜት።","poem":2},{"lineBreak":true},{"text":"ከናፉ ዱበረን ስ ጃለቱ!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ነ ፉዸዹ ዴም፤ ስ ዱካ ፊግና!","poem":1},{"text":"ሞትች ዲንቀሳት ኦል ነ ገልፈቴ።","poem":2},"ምቾተ",{"text":"ኑ ስት ገመድኔ እልልችነ፤","poem":1},{"text":"ጃለለ ኬስ ዳዺ ወይኒ ጫላ ጀጀትነ።","poem":2},"እሼ",{"text":"ስጃለቹንሳኒ አከም ስሪዸ!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"እንተለን ዬሩሳሌም፣","poem":1},{"text":"አን አኩመ ዱንካነ ቄዳር፣","poem":2},{"text":"አኩመ ጎልጋ ዱንካነ ሶሎሞንስ ጉራቲዸ፤","poem":1},{"text":"ገሩ በሬዱዸ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሰበቢ አን ጉራቲ ተኤፍ፣ እጀ በባፍቴ ነ ህንእላልን፤","poem":1},{"text":"አዱቱ ነ ጉራቼሴቲ።","poem":2},{"text":"እልማን ሃዸኮ ነት ኣረኒ","poem":1},{"text":"አከ አን እዶ ዻባ ወይኒ ኤጉ ነ ታስሰን፤","poem":2},{"lineBreak":true},{"text":"አን ገሩ እዶ ዻባ ወይኒኮ ህንኤገትኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ያ እሰ አን ስጃለዹ፣","poem":1},{"text":"እዶ ቡሻዬኬ ትክፈቱፊ","poem":2},{"lineBreak":true},{"text":"እዶ እት ጉያ ሳፋ ሆሎተኬ ቦቆቺፈቱ ነት ህም።","poem":2},{"text":"አን ማሊፈን አከ ዱበርቲ ፉለሼ ሀጉገቴ","poem":1},{"text":"ቡሻዬ ምቾተኬቲ ብረ አሲፊ አች ጆርቱ ቶኮ ተአ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ያ ዱበርቲ ዱበርቶተ ሁንደ ጫላ በሬዱ፣","poem":1},{"text":"አት ዮ ቤኩ ባቴ ሆሎተ ዱካ ቡእ፤","poem":2},{"text":"እልሞሌ ሬኦተኬቲስ","poem":1},{"text":"ዱንካነ ትክሶታ ብረ ትክፈዹ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ያ ጃለሌኮ፣ አን አከ ፈርደ ዸላ","poem":1},{"text":"ፈርዴን ጋሪ ፈረኦን ሀርክሰን ኬሳ ቶኮት ስን እላለ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"መዲንኬ አመርቲ ጉራቲን፣","poem":1},{"text":"ሞርሚኬስ ድረተ ወርቄቲን ሚዸግፈሜረ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኑ ወርቄ ጉራ","poem":1},{"text":"ሜቲዻን ወል መኬ ሲፍ ቶልችነ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኡቱመ ሞትች ማዲት ዽኣቴ ጅሩ","poem":1},{"text":"ሽቶንኮ ኡርጋሳ ኬኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ምቹንኮ አናፍ ኮሮጆ ቁምቢት፤","poem":1},{"text":"እን ጉንቱተኮ ግዱ ቦቆተ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ምቹንኮ አናፍ ሁርቡ ደራራ ሄና","poem":1},{"text":"ከን እዶ ዻባ ወይኒ ኤን ጋዲቲ ዹፌዸ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ያ ጃለሌኮ፣ አት አከም በሬደ!","poem":1},{"text":"ድንቂ አከም በሬደ!","poem":2},{"lineBreak":true},{"text":"እጅኬ ጉጌ ፈካተ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ያ ምቹኮ፣ አት አከም ሚዸግደ!","poem":1},{"text":"ድንቂ አከም ነመት ቶልተ!","poem":2},{"lineBreak":true},{"text":"መርግ ለልሳን ስሬኬኘ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ደሬርሱማን መነኬኛ ብርብርሰ፤","poem":1},{"text":"ደገሌንሳሞ ጋትራዸ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}