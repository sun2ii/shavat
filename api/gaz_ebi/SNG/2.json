{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"SNG","translationId":"gaz_ebi","name":"ዌዱ","commonName":"ዌዱ","title":"ዌዱ ዌዶታ","order":22,"numberOfChapters":8,"sha256":"3430f9d1f1fac27f4e3c70e7e96930715f05fe0b3b02c3e506f8d07959efeb81","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gaz_ebi/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"አን ደራራ ሻሮን፤","poem":1},{"text":"ደራራ ሱሉለ ኬሳት።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ጃለሌንኮ ዱበረን ካን ግዱት","poem":1},{"text":"አኩመ ደራራ ቆራቲ ኬሳት።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ምቹንኮ ደርገጎተ ግዱት","poem":1},{"text":"አኩመ ሙከ ሁዻ ከን ሙኬን ቦሶና ኬሰ ጅሩት።","poem":2},{"text":"አን ጋድሰሳ ጀለ ታኡ ነንጃለዸ፤","poem":1},{"text":"እጅሳስ ነት ምኣወ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እን ገልመ ጭዻት ነ ጌሴ፤","poem":1},{"text":"አኬክን እን ናፍ ቀቡ ጃለለ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሰበቢ አን ጃለላን ገገቤፍ","poem":1},{"text":"እስን ብጥሌ ወይኒቲን ነ ጀጀቤሳ፤","poem":2},{"lineBreak":true},{"text":"ሙከ ሁዻቲንስ ነ ሃሮምሳ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሀርክሳ ብታ መታኮ ጀለ ጅረ፤","poem":1},{"text":"ሀርክሳ ምርጋሞ ነ ሀመተ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ያ እንተለን ዬሩሳሌም፣","poem":1},{"text":"አን ኩሩጴፊ ቦሮፋን እስን ከከቺሰ፤","poem":2},{"text":"ሀመ እሼን ኦፉማን ፌቴ ካቱት","poem":1},{"text":"ጃለለ ህንቱቱቅና ዮካን ህንደደመቅስና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ሰገሌን ምቹኮቲ፣ ቱሉወንረ ኡታሌ","poem":1},{"text":"ጋረንረስ ቃርኤ ዹፋ ጅረ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ምቹንኮ አኩመ ኩሩጴ ዮካን ኮርመ ገደምሳት።","poem":1},{"text":"ኩኖ እን ደላኬኘ ዱበ ዻበቴ","poem":2},{"text":"ፎዳ ኬሳን እላላ","poem":1},{"text":"ቃወ ኬሳንስ ምምልአቻ ጅረ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ምቹንኮ ዱበቴ አከነ ናን ጄዼ፤","poem":1},{"text":"“ያ ሚዸግዱኮ ከእ!","poem":2},{"lineBreak":true},{"text":"በሬዱኮ ኮቱ ነ ወጅን ዴም።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኩኖ! ገን ደርቤረ፤","poem":1},{"text":"ቦካንስ ጫሜ ሶኬረ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ደራራን ለፈረት ሙልአቴረ፤","poem":1},{"text":"ወቅቲን ስርባ ገኤረ፤","poem":2},{"text":"ወጭን ጉጌስ","poem":1},{"text":"ብየኬኘ ኬሰት ዸገአማ ጅረ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሙክን ሀርቡ እጀ ጀልቀባ ባሱ ጀልቀቤረ፤","poem":1},{"text":"ወይኒን ደራሬስ ኡርጋ ኬኔረ።","poem":2},{"text":"ያ ሚዸግዱኮ፣ ከኢ ኮቱ፤","poem":1},{"text":"ያ በሬዱኮ ነ ወጅን ዴም።”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ጉጌኮ ከን ሆልቀ ዸጋ ኬሳ፣","poem":1},{"text":"ከን እዶ ዾክሳ ቱሉ ጭና ኬሳ፣","poem":2},{"text":"ሜ ፉለኬ ነ አርግሲስ፤","poem":1},{"text":"ሜ ሰገሌኬ ነ ዸጌስስ፤","poem":2},{"text":"ሰገሌንኬ ምኣዋዻቲ፤","poem":1},{"text":"ፉልኬስ ነመት ቶለ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሜ ዋንጎ፣","poem":1},{"text":"ዋንጎዹመ ጥጥኖሼ","poem":2},{"text":"ከኔን እዶ ዻባ ወይኒ በሌስቱ ኑፍ ቀባ፤","poem":1},{"text":"እዶን ዻባ ወይኒኬኛ ደራራ ጅራቲ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ምቹንኮ ከኑመኮት፤ አንስ ከንሳት፤","poem":1},{"text":"እን ደራራ ኬሰ ዼችፈተ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ያ ምቹኮ፣","poem":1},{"text":"ሀመ በርኤ ጋድስን በዱት ዴብእ፤","poem":2},{"text":"አኩመ ኩሩጴ ዮካን አኩመ ኮርመ ገደምሳ","poem":1},{"text":"ከን ቱሉወንረ ጅሩስ ተእ።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}