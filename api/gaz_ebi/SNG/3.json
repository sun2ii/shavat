{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"SNG","translationId":"gaz_ebi","name":"ዌዱ","commonName":"ዌዱ","title":"ዌዱ ዌዶታ","order":22,"numberOfChapters":8,"sha256":"3430f9d1f1fac27f4e3c70e7e96930715f05fe0b3b02c3e506f8d07959efeb81","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gaz_ebi/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"አን ሀልከን ጉቱ ስሬኮረ ጪሴ","poem":1},{"text":"ነመ ገራንኮ ጃለቱ ሰነ ነንበርባዴ፤","poem":2},{"lineBreak":true},{"text":"አን እሰ ነንበርባዴ፤ ገሩ እሰ ህንአርገኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አን አመ ከኤን መጋላ ኬሰ፣","poem":1},{"text":"ዳንዲወኒፊ ኦብዲወንረ ነንዴመ፤","poem":2},{"text":"ነመ ገራንኮ ጃለቱ ሰነ ነንበርባደ።","poem":1},{"text":"ከናፉ አን እሰ ነንበርባዴ፤","poem":2},{"lineBreak":true},{"text":"ገሩ እሰ ህንአርገኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኤግዶን ኡቱ መጋላ ኬሰ ናነአኑ ነ አርገን፤","poem":1},{"text":"አንስ፣ “ምቹኮ አርግተኒ?”","poem":2},{"lineBreak":true},{"text":"ጄዼን እሳን ጋፈዼ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አን አኩመን ጥኖ እሳን ብረ ደርቤን፣","poem":1},{"text":"ነመ ሉቡንኮ ጃለቱ ሰነ ነንአርገዼ።","poem":2},{"text":"አንስ እሰ ነንቀበዼ፤ ሀመን መነ ሃዸኮት፣","poem":1},{"text":"ዲንቀ ሃዸኮ እሼ ገራት ነ ባቴ ሰናት","poem":2},{"lineBreak":true},{"text":"ኦል ገልቹት ገድ እሰ ህንዺስኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ያ እንተለን ዬሩሳሌም፣","poem":1},{"text":"አን ኩሩጴፊ ቦሮፋን እስን ከከቺሰ፤","poem":2},{"text":"ሀመ እሼን ኦፉማን ፌቴ ካቱት፣","poem":1},{"text":"ጃለለ ህንቱቱቅና ዮካን ህንደደመቅስና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"እሼን ቁምቢፊ እጣነ","poem":1},{"text":"ኡርጎፍቱ ደልደልቶታ ሁንደራ ሆጄተሜን ኡርጌፈምቴ","poem":2},{"text":"አኩመ ኡቱባ ኣራ","poem":1},{"text":"ገሞጂ ኬሳ ኦል ባቱ ኩን ኤኙ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኩኖ! ስሬ ሶሎሞን ከን ሎልቶተ ጃተመ","poem":1},{"text":"ወረ እስራኤል ኬሳ ቤቤከሞ ተአኒን መርፈምቴርት።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሁንድሳኒ ጎራዴ ህዸቱ፤","poem":1},{"text":"ሁንድኑ ሙጠትኖ ወራና ቀቡ፤","poem":2},{"text":"ቶኮን ቶኮንሳኒ ጎራዴሳኒ","poem":1},{"text":"ሉቄቱት ህዸተኒ ሎለ ሀልከኒቲፍ ቆጳአን።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሶሎሞን ሞትች ኦፊሳቲ ጋሪ ቶልፈቴ፤","poem":1},{"text":"እንስ ሙከ ልባኖንራ ቶልፈቴ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እን ኡቱባሳ ሜቲዻን ሆጄቴ፤","poem":1},{"text":"ጀለሳ ገሩ ወርቄዻን ሆጄቴ።","poem":2},{"text":"ቴሶንሳ ክሪ ዲማ ዺልጌዻን ሆጄተሜ፤","poem":1},{"text":"ኬስሳስ ጃለለ እንተለን ዬሩሳሌሚቲን በሬቸሜ ሆጄተሜ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ያ እንተለን ጥዮን ገድ በኣቲ ሶሎሞን ሞትቸ እላላ፤","poem":1},{"text":"እን ጎንፎ ሃትሳ ጋፈ ፉዸሳ፣","poem":2},{"text":"ጉያ ገራንሳ ገመዴት፣","poem":1},{"text":"መታሳረ ኬሴፍ ሰነ ካአቴረ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}