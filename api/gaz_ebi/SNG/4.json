{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"SNG","translationId":"gaz_ebi","name":"ዌዱ","commonName":"ዌዱ","title":"ዌዱ ዌዶታ","order":22,"numberOfChapters":8,"sha256":"3430f9d1f1fac27f4e3c70e7e96930715f05fe0b3b02c3e506f8d07959efeb81","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gaz_ebi/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"ያ በሬዱኮ፣ አት አከም ሚዸግደ!","poem":1},{"text":"ድንቂ አት አከም በሬደ!","poem":2},{"lineBreak":true},{"text":"እጅኬ ሀጉጊኬ ዱባን ጉጌ ፈካተ።","poem":2},{"text":"ርፌንስ መታኬቲ አኩመ ከረ ሬኦታ","poem":1},{"text":"ከን ጋረ ግልኣድራ ገድ ቡኡት።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እልካንኬ አኩመ ከረ ሆሎታ ከን ርፌንስ እራ ሃደሜ","poem":1},{"text":"ዽቀሜ ኦል ዹፋ ጅሩት።","poem":2},{"text":"ቶኮን ቶኮንሳኒ ለኩ ቀቡ፤","poem":1},{"text":"እሳን ኬሰ መሴን ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ህዺንኬ አኩመ ክሪ ብልዲማት፤","poem":1},{"text":"ሃሳንኬ ነመት ቶለ።","poem":2},{"text":"መዲንኬ ለማን ሀጉጊኬ ኬሰት","poem":1},{"text":"ሮማኒ ቶክቸ እዶ ለመት ቆደሜ ፈካተ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሞርምኬ ገሞ ዳዊት","poem":1},{"text":"ከን ምአ ሎላ እት ኩሱፍ እጃረሜ ሰነ ፈካተ፤","poem":2},{"text":"እሰረት ጋቸነ ኩመቱ ረራፈመ፤","poem":1},{"text":"ሁንድኑ ጋቸነ ሎልቶታት።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ጉንቱንኬ ለማን አኩመ እልሞሌ ኩሩጴ","poem":1},{"text":"ከኔን ለኩ ዸለተኒ ደራራ ኬሰ ዼደኒት።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሀመ በርኤ ጋድስን በዱት፣","poem":1},{"text":"አን ገረ ቱሉ ቁምቢቲፊ ገረ ጋረ እጣና ነንዸቀ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ያ ጃለሌኮ፣ አት ጉቱማን ጉቱት በሬዱዸ፤","poem":1},{"text":"አት ሙዳ ቶኮሌ ህንቀብዱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ያ ምስርቲኮ፣ ልባኖኒ ነ ወጅን ኮቱ፤","poem":1},{"text":"ልባኖኒ ነ ወጅን ኮቱ።","poem":2},{"text":"ፊጤ አማናራ፣","poem":1},{"text":"ፊጤ ሴኒር፣ ፊጤ ሄርሞንራ ገድ ቡእ፤","poem":2},{"text":"ሆልቀ ሌንጫ ኬሳ፣","poem":1},{"text":"ቱሉ ኦልማ ቄረንሳራስ ገድ ቡእ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ያ ኦቦሌቲኮ፣ ያ ምስርቲኮ፣ አት ቀልቢኮ ሀቴርተ፤","poem":1},{"text":"አት ምልኡ እጀኬቲ ቶኮን፣","poem":2},{"lineBreak":true},{"text":"ፋየ ሞርመኬቲ ቶኮን ቀልቢኮ ሀቴርተ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ያ ኦቦሌቲኮ፣ ያ ምስርቲኮ፣ጃለልኬ አከም ነመ ገመቺሰ!","poem":1},{"text":"ጃለልኬ ዳዺ ወይኒ ጫላ፣ ኡርጋን ሽቶኬቲስ","poem":2},{"lineBreak":true},{"text":"ኡርጎፍቱ ከምዩ ጫላ አከም ነመት ቶለ!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ያ ምስርቲኮ፣","poem":1},{"text":"ህዺንኬ አኩመ ዻበ ደማ ነዺ ጮጮብሰ፤","poem":2},{"lineBreak":true},{"text":"ኣነኒፊ ደም አረበኬ ጀለ ጅረ።","poem":2},{"text":"ኡርጋን ኡፈተኬቲ","poem":1},{"text":"አኩመ ኡርጋ ልባኖን።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ያ ኦቦሌቲኮ፣ ያ ምስርቲኮ፣","poem":1},{"text":"አት አኩመ እዶ ብቅልቱ ጩፈሜት፤","poem":2},{"lineBreak":true},{"text":"አት ቡርቃ ደላን እት እጃረሜፊ መደ ቻፓን ጩፈሜዸ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ብቅልቱንኬ እዶ ሮማኒ","poem":1},{"text":"ከን እጀ ፍለተማ ሄናፊ ናርዶስ ቀቡዸ፤","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"አከሱመስ ናርዶሲፊ መርገ ኡርጋኡ፣","poem":2},{"lineBreak":true},{"text":"ቁንዺፊ ቀረፋ፣ ሙከ እጣና ጎሰ ገራ ገራ፣","poem":2},{"lineBreak":true},{"text":"ቁምቢ፣ አርጌሳፊ ኡርጎፍቱ አከ መሌ ጋሪ ሁንደ ቀበ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አት ቡርቃ ብቅልቱ ኬሳት፤","poem":1},{"text":"ብሻን ቦላ ያኡ","poem":2},{"lineBreak":true},{"text":"ከን ልባኖንራ ገድ ዸንገለኡዸ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ያ ቡቤ ካባ ደመቅ፤","poem":1},{"text":"ቡቤን ክባስ ኮቱ!","poem":2},{"text":"አከ ኡርጋንሳ ናኖ ሁንደ ወሊን ገኡፍ","poem":1},{"text":"ብቅልቱኮረት ቡብስ።","poem":2},{"text":"ምቹንኮ ዹፌ፣ ብቅልቱ ሴኔ","poem":1},{"text":"እጀ ፍለተማ ሃኛቱ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}