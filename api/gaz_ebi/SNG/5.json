{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"SNG","translationId":"gaz_ebi","name":"ዌዱ","commonName":"ዌዱ","title":"ዌዱ ዌዶታ","order":22,"numberOfChapters":8,"sha256":"3430f9d1f1fac27f4e3c70e7e96930715f05fe0b3b02c3e506f8d07959efeb81","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gaz_ebi/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"ያ ኦቦሌቲኮ፣ ምስርቲኮ፣አን ዹፌ ብቅልቱኮ ሴኔረ፤","poem":1},{"text":"አን ቁምቢኮ ኡርጎፍቱኮ ወጅን ወልት ቀበዼረ።","poem":2},{"text":"አን ዻበ ደመኮ ነዺሳ ወጅን ኛዼረ፤","poem":1},{"text":"ዳዺ ወይኒኮስ ኣነንኮ ወጅን ዹጌረ።","poem":2},"ምቾተ",{"text":"ያ ምቾተ፣ ኛዻ ዹጋ፤","poem":1},{"text":"ጃለለስ ዹጋ ቁፋ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አን ረፌረ፤ ገራንኮ ገሩ ደመቄረ።","poem":1},{"text":"ሜ ዸጌፈዻ! ምቹንኮ በልበለ ሩሩኩታ ጅራቲ፤","poem":2},{"text":"እን አከነ ጄዸ፤ “ያ ኦቦሌቲኮ፣ ሚዸግዱኮ፣","poem":1},{"text":"ጉጌኮ ከን ሙዳ ህንቀብኔ፣ በልበለ ናፍ በን።","poem":2},{"text":"መታንኮ ፍጤንሳን፣","poem":1},{"text":"ርፌንስኮስ ጂዸ ሀልከኒቲን ቶርቶሬረ።”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አን ኡፈተኮ ኦፍራ ባሴረ፤","poem":1},{"text":"አከምተን ዴብሴ ኡፈዸሬ?","poem":2},{"text":"ሚለኮ ዽቀዼረ፤","poem":1},{"text":"አከምተን ዴብሴ ጡሬሰሬ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ምቹንኮ ቃወ በልበላቲን ሀርከ ገልቼ፤","poem":1},{"text":"ለጴንኮ እሳፍ ንዸአቴ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አን ምቹኮቲፍ በልበለ በኑፍ ነንከኤ፤","poem":1},{"text":"ቀበትኖ በልበላረትስ ሀርከኮራ ቁምቢን፣","poem":2},{"lineBreak":true},{"text":"ቁበኮራሞ ቁምቢን ዸንገለኣን ጮጮቤ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አን ምቹኮቲፍ በልበለ ነንበኔ፤","poem":1},{"text":"ምቹንኮ ገሩ አች ህንጅሩ፤ እን ዴሜረ።","poem":2},{"lineBreak":true},{"text":"ዴሙ እሳትስ ገራንኮ ንርፈቴ።","poem":2},{"text":"አን እሰ ነንበርባዴ፤ ገሩ ህንአርገኔ።","poem":1},{"text":"አን እሰ ነንዋሜ፤ እን ገሩ ህንኦዋትኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኤግዶን ኡቱ መጋላ ኬሰ ናነአኑ ነ አርገን።","poem":1},{"text":"እሳንስ ነ ሬበኒ ነ መዴሰን፤","poem":2},{"lineBreak":true},{"text":"ወር ደላ ኤገን ሱንስ ወያኮ ነራ ባፈተን!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ያ እንተለን ዬሩሳሌም፣","poem":1},{"text":"እስን ምቹንኮ ዮ አርግተን","poem":2},{"text":"ጃለላን ዹኩብሰቹኮ አከ","poem":1},{"text":"እሰት ናፍ ህምተን እስነን ከከቺሰ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ያ እሼ ዱበርቶተ ሁንደ ጫላ በሬዱ፣","poem":1},{"text":"ምቹንኬ ማሊን ወረ ካን ጫለ?","poem":2},{"text":"አት ከን አከስ ኑ ከከቺፍቱ፣","poem":1},{"text":"ምቹንኬ ማሊን ወረ ካን ጫለ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ምቹንኮ ዲማ ጩሉሉቃዸ፤","poem":1},{"text":"እን ነሞተ ኩመ ኩዸን ኬሳ ንሙልአተ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"መታንሳ ወርቄ አከ መሌ ቁልቁሉዸ፤","poem":1},{"text":"ርፌንስ መታሳ ጅጋዸ፤","poem":2},{"lineBreak":true},{"text":"አኩመ አራጌሳስ ጉራቸ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እጅሳ አኩመ ጉጌ ቡርቃ ብሻኒ ብራ","poem":1},{"text":"ከን ኣነኒን ዽቀሜ አከ ፋያት ካአተሙዸ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"መዲንሳ አኩመ መደቢ ብቅልቱ ኡርጎፍቱ ከን ሽቶ ባሱት።","poem":1},{"text":"ህዺንሳ አኩመ ደራራ ቁምቢንራ ጮጮቡት።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሀርክሳ ኡሌ ወርቄ","poem":1},{"text":"ከን ቢረሌዻን ፋዬፈሜዸ።","poem":2},{"text":"ዸግንሳ አኩመ እልከ አርባ","poem":1},{"text":"ከን ሰንፔሪን ሚዸግፈሜዸ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሚልሳ ኡቱባ ዸጋ አዲ","poem":1},{"text":"ከን ባቱ ወርቄ ቁልቁሉራ ሆጄተሜረ ዻበሜዸ።","poem":2},{"text":"ብፍትሳ አኩመ ልባኖን፣","poem":1},{"text":"አኩመ ብርብርሳ ልባኖን ፍለተማዸ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዱቢንሳ ዋን ሁንደ ጫላ ምኣዋዸ፤","poem":1},{"text":"እን ጉቱማን ጉቱት ነመት ቶለ።","poem":2},{"text":"ያ እንተለን ዬሩሳሌም፣","poem":1},{"text":"ኩን ምቹኮት፤ ኩን ምቹኮት።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}