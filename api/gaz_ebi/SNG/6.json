{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"SNG","translationId":"gaz_ebi","name":"ዌዱ","commonName":"ዌዱ","title":"ዌዱ ዌዶታ","order":22,"numberOfChapters":8,"sha256":"3430f9d1f1fac27f4e3c70e7e96930715f05fe0b3b02c3e506f8d07959efeb81","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gaz_ebi/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"ያ እሼ ዱበርቶተ ሁንደ ጫላ በሬዱ፣","poem":1},{"text":"ምቹንኬ ኤሰ ዸቄ?","poem":2},{"text":"አከ ኑ ስ ወጅን በርባኑፍ","poem":1},{"text":"ምቹንኬ ገረምት ጎሬ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ምቹንኮ እዶ ብቅልቱ ኬሰ","poem":1},{"text":"ሆሎተሳ ትክፈቹፊ","poem":2},{"text":"ደራራ ወልት ቀበቹፍ ጄዼ ገረ እዶ ብቅልቱ፣","poem":1},{"text":"ለፈ መደቢን ብቅልቱ ኡርጎፍቱወኒ ጅሩት ገድ ቡኤረ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አን ከን ምቹኮት፤ ምቹንኮስ ከኑመኮት፤","poem":1},{"text":"እን ደራራ ኬሰ ዼችፈተ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ያ ጃለሌኮ፣ አት አኩመ ቲርዛ በሬዱዸ፤","poem":1},{"text":"አኩመ ዬሩሳሌም ነመት ቶልተ፤","poem":2},{"lineBreak":true},{"text":"አኩመ ሎልቶተ ፋጂ ባተኒስ ኡልፍነ ቀብደ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እጀኬ ነራ ቡቅስ፤","poem":1},{"text":"እን ነ ጄቄራቲ።","poem":2},{"text":"ርፌንስ መታኬቲ አኩመ ከረ ሬኦተ","poem":1},{"text":"ግልኣድራ ገድ ቡአኒት።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እልካንኬ አኩመ ከረ ሆሎታ","poem":1},{"text":"ከን ዽቀሜ ኦል ዹፋ ጅሩት።","poem":2},{"text":"ቶኮን ቶኮንሳኒ ለኩ ቀቡ፤","poem":1},{"text":"እሳን ኬሰ መሴን ቶኮዩ ህንጅሩ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"መዲንኬ ለማን ሀጉጊኬ ኬሰት","poem":1},{"text":"ሮማኒ ቶክቸ እዶ ለመት ቆደሜ ፈካተ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሞትቲወን ጃተምን፣ሳጀቶን ሰዴተምኒፊ","poem":1},{"text":"ዱበረን ለኮብሰ ህንቀብኔ ቁልቁሉንጅራቹ ደንደኡ፤","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ጉጌንኮ ከን ሙዳ ቶኮዩ ህንቀብኔ ሱን ከን አዳት፤","poem":1},{"text":"እሼን ሃዸሼቲፍ እንተለ ቶክቲዸ፤","poem":2},{"lineBreak":true},{"text":"ሃዸሼ ዴሴፍስ ፍለተምቱዸ።","poem":2},{"text":"ዱበረን እሼ አርገኒ እሼ ኤብሰን፤","poem":1},{"text":"ሞትቲወኒፊ ሳጀቶወንስ እሼ ጀጀን።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ከን አከ ቦሩ በቀቁት ሙልአቱ፣","poem":1},{"text":"ከን አከ ጅኣ በሬዱ፣ ከን አከ ቢፍቱ እፍቱ፣","poem":2},{"lineBreak":true},{"text":"ከን አከ ኡርጂወን ቶራን ያአኒ ኡልፍነ ቀብዱ ኩን ኤኙ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አንስ ደራራ ሱሉለ ኬሰት ዽኦ ብቅሌ አርጉፍ፣","poem":1},{"text":"አከ ወይኒን ሁዻ ባሴ","poem":2},{"text":"ዮካን አከ ሮማኒን ደራሬ እላሉፍ","poem":1},{"text":"ገረ ለፈ ቆቲሳ ኦቾሎኒት ገድ ነንቡኤ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኡቱ አን ህንሁበትን፣","poem":1},{"text":"ሉቡንኮ ጋሪ ሞቲ ሰበኮቲ ኬሰ ነ ቴስስቴ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ያ ሱላማጥቲ ዴብእ፤ ዴብእ፤","poem":1},{"text":"አከ ኑ ሲላሉፍ ዴብእ፤ ዴብእ!","poem":2},"እሰ",{"text":"እስን አኩመ ነመ ስርበ መሀነዪም እላሉት","poem":1},{"text":"ማሊፍ ሱላማጥቲ እላልቱ?","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}