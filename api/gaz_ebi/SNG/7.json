{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"SNG","translationId":"gaz_ebi","name":"ዌዱ","commonName":"ዌዱ","title":"ዌዱ ዌዶታ","order":22,"numberOfChapters":8,"sha256":"3430f9d1f1fac27f4e3c70e7e96930715f05fe0b3b02c3e506f8d07959efeb81","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gaz_ebi/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"ያ እንተለ እልመ ሞቲ፣","poem":1},{"text":"ሚልኬ ኮጴ ኬሰት አከም በሬደ!","poem":2},{"text":"ጉዴድንኬ ሚዸጋን ሱን ዶቀ ገቲ ጉዳ","poem":1},{"text":"ከን ኦጌስ ሆጂ ሀርካ ቶልቼ ፈካተ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሀንዹርኬ ጦፎ ጌንጎ","poem":1},{"text":"ከን ተኩማ ዳዺን ወይኒ ወል መካን ኬሳህንዸበምን ፈካተ።","poem":2},{"text":"ሙዺን ኬሞ ቱላ ቀመዲ","poem":1},{"text":"ከን ደራራዻን መርፈሜ ፈካተ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ጉንቱንኬ ለማን አኩመ እልሞሌ ኩሩጴ","poem":1},{"text":"ከኔን ለኩ ዸለተኒት።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሞርምኬ ገሞ እልከ አርባ ፈካተ።","poem":1},{"lineBreak":true},{"text":"እጅኬ ሀሮ ሄሽቦን","poem":1},{"text":"ከን ከረ ባትረቢ ብራ ፈካተ።","poem":2},{"text":"ፉኛንኬ ገሞ ልባኖን","poem":1},{"text":"ከን ገረ ደማስቆ ገድ እላሉ ፈካተ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"መታንኬ አኩመ ቱሉ ቀርሜሎስ ጎንፎ ሲፍ ተአ።","poem":1},{"text":"ርፌንስ መታኬቲ አፋ መነ ሞቲ ፈካተ፤","poem":2},{"lineBreak":true},{"text":"ሞቲን ዼርነሳቲን ቀበሜ ቦጅአመ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ያ ጃለሌ አት ገመቹኬ ወጅን","poem":1},{"text":"አከም በሬደ፤ አከምስ ነመት ቶልተ!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዻብንኬ ዻበ ሜጢ ፈካተ፤","poem":1},{"text":"ጉንቱንኬስ ሁርቡ እጃ ፈካተ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አንስ፣ “ሙከ ሜጢ ከነ ነንያበዸ፤","poem":1},{"text":"እጀሳ ነንቀበዸ” ነንጄዼ።","poem":2},{"text":"ጉንቱንኬ አኩመ ሁርቡ ወይኒ፣","poem":1},{"text":"ኡርጋን ሀፉረኬቲ አኩመ ኡርጋ ሁዻት፤","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"አፋንኬስ አኩመ ዳዺ ወይኒ ከን አከ መሌ ጋሪ ተኤት።","poem":2},"እሼ",{"text":"ዳዺን ወይኒ ሱቱማን ህዺፊ","poem":1},{"text":"እልካንረ ገድ ያኤ ገረ ምቹኮ ሃዸቁ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አን ከን ምቹኮት፤","poem":1},{"text":"ሀዊንሳስ አኑማፍ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ያ ምቹኮ፣ ኮቱ ሜ ገረ ባድያ ሃዴምኑ፤","poem":1},{"text":"ገንዶተ አቺ ኬሰ ሃቡሉ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አከ ሙክን ወይኒ ሁዻ ባፈቴ፣","poem":1},{"text":"አከ ደራራን እጀ በነቴፊ","poem":2},{"text":"አከ ሮማኒን ደራሬ እላሉፍ ገነመ በሪን ካኔ","poem":1},{"text":"ገረ እዶ ዻባ ወይኒ ሃዴምኑ፤","poem":2},{"lineBreak":true},{"text":"አንስ አችት ጃለለኮ ሲፍ ነንኬነ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሁዻን ኡርጋሳ ገድ ዺሰ፤","poem":1},{"text":"ያ ምቹኮ፣ ወን አን ሲፍ ኩሴ፣","poem":2},{"text":"ሃራፊ ሞፋንስ ወን ፍለተማን ሁንድ","poem":1},{"text":"በልበለኬኘ ዱረ ጅረ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}