{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"SNG","translationId":"gaz_ebi","name":"ዌዱ","commonName":"ዌዱ","title":"ዌዱ ዌዶታ","order":22,"numberOfChapters":8,"sha256":"3430f9d1f1fac27f4e3c70e7e96930715f05fe0b3b02c3e506f8d07959efeb81","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gaz_ebi/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"ኡቱ አት አከ ኦቦሌሰኮ","poem":1},{"text":"ከን ሀርመ ሃዸኮ ሆዼ ጉደቴ ና ታቴ!","poem":2},{"text":"አን ዮን አለት ስ አርጌ ስን ዹንገዸን ቱሬ፤","poem":1},{"text":"ነምን ቶኮዩ ነ ህንቱፈቱ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አንስ ስ ዱረ ዴሜ መነ ሃዸኮ","poem":1},{"text":"እሼ ነ በርሲፍቴ ሰናት ስን ጌሰ ቱሬ።","poem":2},{"text":"አከ አት ዹግዱፍስ ዳዺ ወይኒ ከን ምኤፈሜ","poem":1},{"text":"ጩንፋ ሮማኒኮስ ሲፍን ኬነ ቱሬ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሀርክሳ ብታ መታኮ ጀለ ጅረ፤","poem":1},{"text":"ሀርክሳ ምርጋሞ ነ ሀመተ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ያ እንተለን ዬሩሳሌም፣ አን እስን ከከቺሰ፤","poem":1},{"text":"ሀመ እሼን ኦፉማን ፌቴ ካቱት","poem":2},{"lineBreak":true},{"text":"ጃለለ ህንቱቱቅና ዮካን ህንደደመቅስና።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ከን ምቹሼት እርከቴ","poem":1},{"text":"ገሞጂ ኬሳ ኦል ዹፋ ጅርቱ ኩን ኤኙ?","poem":2},"እሼ",{"text":"አን ሙከ ሁዻ ጀለት ስን ከካሴ፤","poem":1},{"text":"ሃትኬ አችት ስ ኡልፎፍቴ፤","poem":2},{"lineBreak":true},{"text":"አቹመትስ ጭኒንስፈቴ ስ ዴሴ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አኩመ ቻፓት ለጴኬረ፣","poem":1},{"text":"አኩመ ቻፓት እሬኬረ ነ ካአዹ፤","poem":2},{"text":"ጃለል አኩመ ዱኣ ጀብዱዻቲ፤","poem":1},{"text":"ህናፋንሳስ አኩመ አዋላ ሀማዸ።","poem":2},{"text":"እን አኩመ እብደ በለልኡ፣","poem":1},{"text":"አኩመ አረበ እብደ ጀባ ቦበአ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ብሻን ባይኤን ጃለለ ዻምሱ ህንደንደኡ፤","poem":1},{"text":"ለግንስ ዽቄ እሰ በሌሱ ህንደንደኡ።","poem":2},{"text":"ነምን ቶኮ ቀቤኘ መነሳ ሁንደ","poem":1},{"text":"ዮ ጃለላፍ ኬኔ","poem":2},{"lineBreak":true},{"text":"ቀቤኝ ሱን ጉቱማን ጉቱት ንቱፈተመ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኑ ኦቦሌቲ ጥኖ ቶኮ ቀብነ፤","poem":1},{"text":"እሼን ጉንቱተዩ ህንባፍኔ።","poem":2},{"text":"ጉያ እሼን ሄሩማፍ ከዸተምቱት","poem":1},{"text":"ኑ ኦቦሌቲኬኛፍ ማል ጎነ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኡቱ እሼን ደላ ዸጋ ታቴ","poem":1},{"text":"ኑ ስላ ገሞ ሜቲሼረት እጃረ ቱሬ።","poem":2},{"text":"ኡቱ እሼን በልበለ ታቴ","poem":1},{"text":"ኑ ስላ ብርብርሳን እሼ መርስነ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አን ደላ ዸጋት፤","poem":1},{"text":"ጉንቱንኮስ አኩመ ገሞት።","poem":2},{"text":"ከናፉ አን ፉለሳ ዱረት","poem":1},{"text":"አኩመ ነመ ነጋ ፍዱ ቶኮት ነንእላለመን ቱሬ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሶሎሞን በኣል ሃሞን ኬሳ እዶ ዻባ ወይኒ ቀበ ቱሬ፤","poem":1},{"text":"እንስ እዶ ዻባ ወይኒ ኦፊሳ ቆቱወንት ክራ ኬነቴ።","poem":2},{"text":"ቶኮን ቶኮንሳኒስ እጀ አርገተንራ","poem":1},{"text":"ሜቲ ሰቅሊ ኩመ ቶኮ ፍዱፊ ቀቡ ቱሬ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እዶን ዻባ ወይኒኮቲ፣ ከኑመኮት፤","poem":1},{"text":"ያ ሶሎሞን፣ ሰቅሊን ኩምን ሱን ሱማፍ፤","poem":2},{"lineBreak":true},{"text":"ዽብ ለመሞ ከን ወረ እጀሳ ኤገኒት።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ያ እሼ እዶ ብቅልቱ ኬሰ ጅራቱ፣","poem":1},{"text":"ምቾትን ሰገሌኬ ዸጌፈቻ ጅሩ፤","poem":2},{"lineBreak":true},{"text":"ሜ አንስ ነንዸገአ!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ያ ምቹኮ፣ ደፊ ኮቱ፤","poem":1},{"text":"አከ ኩሩጴ","poem":2},{"text":"ዮካን አከ ኮርመ ገደምሳ","poem":1},{"text":"ከን ጋረ ኡርጎፍቱረ ቡራቁ ተእ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}