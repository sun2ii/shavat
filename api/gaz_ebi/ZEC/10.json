{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ZEC","translationId":"gaz_ebi","name":"ዘካርያስ","commonName":"ዘካርያስ","title":"ራጂ ዘካርያስ","order":38,"numberOfChapters":14,"sha256":"a915fbe3db76607f1291f55b8cb6bc3026b428b4c016f47e8f66cf8ab426f889","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gaz_ebi/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":10,"content":[{"type":"heading","content":["ዋቀዮ ይሁዳ ንኩኑንሰ"]},{"type":"verse","number":1,"content":[{"text":"ዬሮ ቦካ እሰ ቦዴት አከ እን ቦካ እስኒፍ ኬኑፍዋቀዮን ከዸዻ፤","poem":1},{"text":"በከካ ከን ኤርጉ ዋቀዮዸ።","poem":2},{"text":"እን ቦካ ሎለኡ ነመ ሁንዳፍ፣","poem":1},{"text":"ብቅልቱ ድሬሞ ቶኮ ቶኮ ነማቲፍ ንኬነ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዋቆትን ቶልፈሞን ጎዎምሳ ዱበቱ፤","poem":1},{"text":"ራጆትን ሙልአተ ሶባ አርጉ፤","poem":2},{"text":"እሳን አብጁ ሶባ ነመት ህሙ፤","poem":1},{"text":"ዋን ፋይዳ ህንቀብኔን ነመ ጀጀቤሱ።","poem":2},{"text":"ከናፉ ሰብን ኩን አኩመ ሆላ ትክሴ ህንቀብኔ","poem":1},{"text":"ሀጩጨሜ አሲፊ አች ጆረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“ኣሪንኮ ትክሶተት ቦበኤረ፤","poem":1},{"text":"አን ሬኦተ ነንአደበ፤","poem":2},{"text":"ዋቀዮ ዋን ሁንደ ደንደኡ","poem":1},{"text":"ቡሻዬሳ፣ መነ ይሁዳ ንቶአተ፤","poem":2},{"lineBreak":true},{"text":"ሎለ ኬሰትስ አከ ፈርደ ጀባ እሳን ታስሰ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ይሁዳ ኬሳ ዸጋን ጎሌ፣","poem":1},{"text":"እሰ ኬሳ ቆፎን ዱንካና፣","poem":2},{"text":"እሰ ኬሳ እዳን ሎላ፣","poem":1},{"text":"እሰ ኬሳ ቡልቻን ሁንድ ንዹፈ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እሳን አኩመ ነሞተ ጀጀቦ","poem":1},{"text":"ወራነ ኬሰት ቶኩማዻን ዳንዲ ዾቄረ ዴሙ።","poem":2},{"text":"ሰበቢ ዋቀዮ እሳን ወጅን ጅሩፍ","poem":1},{"text":"እሳን ሎለኒ አቦቲ ፈርዴኒ ቃኔሱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“አን መነ ይሁዳ ነንጀጀቤሰ፤","poem":1},{"text":"መነ ዮሴፍስ ነንኦልቸ።","poem":2},{"text":"አን ዋነን ገራ እሳኒፍ ላፉፍ","poem":1},{"text":"ዴብሴ እሳን ነንዻበ።","poem":2},{"text":"እሳን አኩመ ዋን አን ዱራኑ","poem":1},{"text":"እሳን ህንገትኒ ተኡ፤","poem":2},{"text":"አን ዋቀዮ ዋቀሳኒት፤","poem":1},{"text":"ዴቢስ እሳኒፍ ነንኬነ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኤፍሬሞትን አኩመ ነሞተ ጀጀቦ ተኡ፤","poem":1},{"text":"ገራንሳኒስ አኩመ ነመ ዳዺ ወይኒቲን ገመዱ ንገመደ።","poem":2},{"text":"እጆሌንሳኒ ዋን ከነ አርገኒ ንገመዱ፤","poem":1},{"text":"ገራንሳኒ ዋቀዮት ንገመደ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አን ሲቅሴ","poem":1},{"text":"ወልት እሳን ነንቀበ።","poem":2},{"text":"አን ዹጉማን እሳን ነንፉረ፤","poem":1},{"text":"እሳን አኩመ ዱራ ሰነ ንባይአቱ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዮ አን ሰቦተ ግዱት","poem":1},{"text":"እሳን ብትኔሴዩ እሳን ብየ ፈጎት ነ ያደቱ።","poem":2},{"text":"እሳኒፊ እጆሌንሳኒ ሉቡዻን ንጅራቱ፤","poem":1},{"text":"ንዴብኡስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አን ብየ ግብጢቲ ዴብሴ እሳን ነንፍደ፤","poem":1},{"text":"አሶር ኬሳስ ወልትን እሳን ቀበ።","poem":2},{"text":"አን ገረ ግልኣዲፊ ልባኖንት እሳን ነንፍደ፤","poem":1},{"text":"እዶን እሳን ገኡስ ህንአርገሙ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እን ገላነ ረክና ኬሰ ደርበ፤","poem":1},{"text":"ዸኣ ገላናስ ንሩኩተ፤","poem":2},{"lineBreak":true},{"text":"ቱጁበወን አበያ ሁንድኑ ንጎጉ።","poem":2},{"text":"ኦፍ ቱሉማን አሶር ገድ ዴብአ፤","poem":1},{"text":"ቦኩን ሞቱማ ግብጥስ ንበደ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አን ዋቀዮን እሳን ነንጀቤሰ፤","poem":1},{"text":"እሳንስ መቃሳቲን ዴዴብኡ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ZEC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ZEC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ZEC/9.json","previousChapterAudioLinks":{},"numberOfVerses":12}