{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ZEC","translationId":"gaz_ebi","name":"ዘካርያስ","commonName":"ዘካርያስ","title":"ራጂ ዘካርያስ","order":38,"numberOfChapters":14,"sha256":"a915fbe3db76607f1291f55b8cb6bc3026b428b4c016f47e8f66cf8ab426f889","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gaz_ebi/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":13,"content":[{"type":"heading","content":["ጩቡራ ቁልቁላኡ"]},{"type":"verse","number":1,"content":["“ጋፈስ መነ ዳዊቲፊ ጅራቶተ ዬሩሳሌም ጩቡፊ ጡራኡማራ አከ ቁልቁሌሱፍ ቡርቃን ቶኮ ንበነመ።"]},{"type":"verse","number":2,"content":["“አን ጋፈስ መቃ ዋቆተ ቶልፈሞ ብየቲ ኬሳ ነንበሌሰ፤ እሳን ለመተ ህንያደተመን” ጄዸ ዋቀዮ ዋን ሁንደ ደንደኡ። “አን ራጆታፊ ሀፉረ ጡራኡማ ብየቲ ኬሳ ነንበሌሰ።"]},{"type":"verse","number":3,"content":["ዮ ነምን ቶኮ አመስ ራጂ ዱበቴ፣ አባፊ ሃትሳ፣ ወር እሰ ዸልቼ፣ ‘አት መቃ ዋቀዮቲን ዋን ሶበ ዱበቴፍ ዱኡ ቀብደ’ ጄዹን። ዬሮ እን ራጂ ዱበቱት አባፊ ሃትሳ ወር እሰ ዸልቼ እሰ ወራኑ።"]},{"type":"verse","number":4,"content":["“ጉያ ሰነ ራጂን ሁንድኑ ሰበቢ ሙልአተ ራጂሳቲፍ ንቃነአ፤ እን ጎዎምሱዻፍ ወያ ራጂ ከን ርፌንሰራ ሆጄተሜ ህንኡፈቱ።"]},{"type":"verse","number":5,"content":["እን፣ ‘አን ቆቴ ቡላዸ መሌ ራጂ ምት፤ እጆሉማኮቲ ጀልቀቤ ነምን ነ ጉርጉሬ ቱሬ’ ጄዸ።"]},{"type":"verse","number":6,"content":["ዮ ነምን ቶኮ፣ ‘መዳን ዸግነኬራ ኩን ማል?’ ጄዼ ጋፈቴ፣ እን፣ ‘መዳን ኩን መዳ አን መነ ምቾተኮት መዳኤዸ’ ጄዼ ዴብሰ።"]},{"type":"heading","content":["ትክሴን ንሩኩተመ፣ ሆሎትን ንብትናኡ"]},{"type":"verse","number":7,"content":[{"text":"“ያ ጎራዴ፣ ትክሴኮት፣","poem":1},{"text":"ነመ ነት ዽኣቱ ሰነት ከእ!” ጄዸ","poem":2},{"lineBreak":true},{"text":"ዋቀዮ ዋን ሁንደ ደንደኡ።","poem":2},{"text":"“አት ትክሴ ሩኩት፤","poem":1},{"text":"ሆሎትን ንብትኔፈሙ፤","poem":2},{"lineBreak":true},{"text":"አንስ ሀርከኮ ወረ ጥጥናት ነንዴብፈዸ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ለፈ ሁንደረት” ጄዸ ዋቀዮ፣","poem":1},{"text":"“ሀርከ ሰዲ ኬሳ ሀርክ ለመ ሩኩተሜ በደ፤","poem":2},{"lineBreak":true},{"text":"ተኡስ ሀርከ ሰዲ ኬሳ ሀርክ ቶኮ አችት ሀፈ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አን ሀርከ ሰደፋ ከነ እብደትን ነቀ፤","poem":1},{"text":"አኩመ ሜቲ በቅሴ እሳን ነንቁልቁሌሰ፤","poem":2},{"lineBreak":true},{"text":"አከ ወርቄት እሳን ነንቆረ።","poem":2},{"text":"እሳን መቃኮ ንዋመቱ፤","poem":1},{"text":"አንስ ዴቢ ነንኬናፍ፤","poem":2},{"text":"አን፣ ‘እሳን ሰበኮት’ ነንጄዸ፤","poem":1},{"text":"እሳንሞ፣ ‘ዋቀዮ ዋቀኬኘ’ ጄዹ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ZEC/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ZEC/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ZEC/12.json","previousChapterAudioLinks":{},"numberOfVerses":9}