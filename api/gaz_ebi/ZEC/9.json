{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ZEC","translationId":"gaz_ebi","name":"ዘካርያስ","commonName":"ዘካርያስ","title":"ራጂ ዘካርያስ","order":38,"numberOfChapters":14,"sha256":"a915fbe3db76607f1291f55b8cb6bc3026b428b4c016f47e8f66cf8ab426f889","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gaz_ebi/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":9,"content":[{"type":"heading","content":["ሙርቲ ዲኖተ እስራኤልት ሙረሜ"]},{"type":"verse","number":1,"content":[{"text":"ራጂን ዱቢ ዋቀዮ ብየ ሀድራክት ንዹፈ፤","poem":1},{"text":"ደማስቆረስ ንቡአ፤","poem":2},{"text":"እጅ ነሞተ ሁንዳፊ ጎሶተ እስራኤል ሁንዳ ገረ","poem":1},{"text":"ዋቀዮ ንእላላቲ፤","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አከሱመስ ገረ ሀማት እሼ ዳንጋራ፣","poem":1},{"text":"እሳን ኦጌዪ ተአንዩ ገረ ጢሮሲፊ ሲዶናስ ንእላለ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ጢሮስ ደአትኖ ጀባ እጃረቴርት፤","poem":1},{"text":"ሜቲ አከ አዋራት፣","poem":2},{"lineBreak":true},{"text":"ወርቄስ አኩመ ኮሲ ዳንዲራት ቱለቴርት።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጎፍታን ገሩ ቀቤኘሼራ ፉዼ ሁምነሼ","poem":1},{"text":"ገላነረት በርበዴሰ፤","poem":2},{"lineBreak":true},{"text":"እሼንስ እብዳን ዹምት።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አሽቀሎን ዋን ከነ አርግቴ ንሶዳት፤","poem":1},{"text":"ጋዛንሞ ዹኩብሰቴ ኣድ፤","poem":2},{"lineBreak":true},{"text":"ኤቅሮንስ አከሱመ ታት፤ አብዲንሼ ጮለጌራቲ።","poem":2},{"text":"ጋዛን ሞቲሼ ንዸብድ፤","poem":1},{"text":"ኤቅሮንስ ኦንቴ ሀፍት።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ነሞትን ኦርማ አሽዶድን ንቀበቱ፤","poem":1},{"text":"አንስ ኦፍ ቱሉማ ፍልስጤሞታ ነንበሌሰ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አን ዺገ አፋንሳኒ ኬሰ ጅሩ፣","poem":1},{"text":"ኛተ ዾወሜስ እልካንሳኒ ግዱዻ ነንባሰ።","poem":2},{"text":"ወር ሀፈንስ ከን ዋቀኬኛ ተአኒ","poem":1},{"text":"ይሁዳ ኬሰትስ ቡልችቶተ ተኡ፤","poem":2},{"lineBreak":true},{"text":"ኤቅሮንሞ አከ ወረ ዬቡሶታ ንታት።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አን ገሩ ሎልቱ ጨብስቴ ሴንቱ","poem":1},{"text":"መነኮራ ነንዾወ።","poem":2},{"text":"ለመተ ሀጩጩን ሰበኮረ ህንቡራቅጡ፤","poem":1},{"text":"አን አመ ደመቄ ነንኤጋቲ።","poem":2}]},{"type":"heading","content":["ዹፋቲ ሞትቸ ጥዮን"]},{"type":"verse","number":9,"content":[{"text":"ያ እንተለ ጥዮን አት ጉድሲ ገመድ!","poem":1},{"text":"ያ እንተለ ዬሩሳሌም እይ!","poem":2},{"text":"ኩኖ ሞቲንኬ ቀጄላን፣","poem":1},{"text":"ፈይነ ቀበቴ፣","poem":2},{"text":"ገድ ኦፍ ቀቤ ሀሬ ያበቴ፣","poem":1},{"text":"እልሞ ሀሬ ጄቹንስ ሀሬ ጥኖ ያበቴ ገረኬ ዹፋ ጅረ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አን ጋሪወን ሎላ ኤፍሬም ኬሳ፣","poem":1},{"text":"ፈርዴን ሎላስ ዬሩሳሌም ኬሳ ነንበሌሰ፤","poem":2},{"lineBreak":true},{"text":"እዳን ወራናስ ንጨጨበ።","poem":2},{"text":"እን ሰቦተት ነጋ ንለብሰ፤","poem":1},{"text":"ቡልቺንስሳ ገላነ ቶኮራ ሀመ ገላነ ብራት፣","poem":2},{"lineBreak":true},{"text":"ለገ ኤፍራጢሲቲ ሀመ ዳሪ ለፋት በልአተ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ስእሞ፣ ሰበቢ ዺገ ከኩ አን ስ ወጅን ቀቡቲፍ","poem":1},{"text":"ህዸምቶተኬ አን ቦለ ብሻን ህንቀብኔ ኬሳ ባሴገድ ነንዺሰ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ያ ህዸምቶተ አብዲ ቀብደን፣ ደአትኖኬሰንት ዴብኣ፤","poem":1},{"text":"አን አመስ ሀርከ ለመ ጎዼ እስኒፍ ነንዴብሰ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አን አከን እዳኮ ደብሰዹት ይሁዳ ደብሴ","poem":1},{"text":"ኤፍሬም ኬሰ ነንጉተ።","poem":2},{"text":"ያ ጥዮን፣ አን እልማንኬ","poem":1},{"text":"እልማን ግሪክት ነንካሰ፤","poem":2},{"lineBreak":true},{"text":"ስእሞ አከ ጎራዴ ጎተ ቶኮ ነንጎዸዸ።","poem":2}]},{"type":"heading","content":["ዋቀዮ ንሙልአተ"]},{"type":"verse","number":14,"content":[{"text":"ዋቀዮ እሳንረት ንሙልአተ፤","poem":1},{"text":"ጥይሳ አከ በከካ ንበለቅሰ።","poem":2},{"text":"ዋቀዮ ጎፍታን መለከተ ንአፉፈ፤","poem":1},{"text":"እን ቡቤ ክባቲን ዴመ፤","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ዋቀዮ ዋን ሁንደ ደንደኡ እሳን ኤገ።","poem":2},{"text":"እሳን ዸጋ ፉርሳቲን በርበዴሰኒ ሞአቱ።","poem":1},{"text":"እሳን አኩመ ዳዺ ወይኒ ዹገኒ","poem":2},{"lineBreak":true},{"text":"አኩመ ወጪቲ እቲን ጎሌ እዶ ኣርሳት ፈጫሰኒት ንጉተሙ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አኩመ ትክሴን ቡሻዬሳ ኦልቹ ሰነ፣","poem":1},{"text":"ዋቀዮ ዋቅንሳኒ ጋፈስ ሰበሳ ንኦልቸ።","poem":2},{"text":"እሳን አኩመ ፋየ ጎንፎራት","poem":1},{"text":"ብየሳ ኬሰት ንጨለቅሱ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እሳን አከም ነመ ሀወቱ! አከምስ ሚዸጉ!","poem":1},{"text":"ምዻን ደርገጎተ፣","poem":2},{"lineBreak":true},{"text":"ዳዺን ወይኒ ሃራንሞ ሸመረን ጀጀቤሰ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ZEC/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ZEC/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ZEC/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}