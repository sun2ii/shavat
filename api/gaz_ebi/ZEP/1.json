{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ZEP","translationId":"gaz_ebi","name":"ሴፋንያ","commonName":"ሴፋንያ","title":"ራጂ ሴፋንያ","order":36,"numberOfChapters":3,"sha256":"d491413ca2e5bbe8956493ace9dd3bed3913ab6eaa73e992db876bc6da071d9e","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gaz_ebi/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["ዱቢን ዋቀዮ ከን በረ ዮስያስ እልም ኣሞን ሞቲ ይሁዳ ቱሬ ኬሰ ገረ ሴፋንያ እልመ ኩሺ፣ እልመ ጌዳልያስ፣ እልመ አመርያ፣ እልመ ህስቅያስ ዹፌ ከናዸ፦"]},{"type":"line_break"},{"type":"heading","content":["አኬከቺሰ ዋኤ በዲሰ ዹፋ ጅሩ"]},{"type":"verse","number":2,"content":[{"text":"“አን ፉለ ለፋራ","poem":1},{"text":"ዋን ሁንደ ሀጣኤ ነንበሌሰ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“አን ነማፊ ሆሪ ሀጣኤ ነንበሌሰ፤","poem":1},{"text":"ስምብሮ ሰሚቲፊ","poem":2},{"lineBreak":true},{"text":"ቁርጡሚ ገላና፣","poem":2},{"lineBreak":true},{"text":"ዋቆተ ቶልፈሞ ነሞተ ሀሞ ጉፈቺሰንስ ሀጣኤ ነንበሌሰ።”","poem":2},{"lineBreak":true},{"text":"“አን ሰኚ ነማ ለፈራ ነንበሌሰ”","poem":1},{"text":"ጄዸ ዋቀዮ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“አን ይሁዳፊ","poem":1},{"text":"ወረ ዬሩሳሌም ኬሰ ጅራተን ሁንደት ሀርከኮ ኦል ነንፉዸዸ።","poem":2},{"text":"አን ሀምባ በኣል ሁንዳፊመቃ ሉቦተ ዋቆተ ቶልፈሞ ዋቄፈተኒ","poem":1},{"text":"እዶ ከና ነንበሌሰ፤","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ወረ ራያ ሰሚ ዋቄፈቹፍ","poem":1},{"text":"ቅናጢ መናረት ሰገደን፣","poem":2},{"text":"ወረ ሰገደኒፊ ዋቀዮን ከከተን፣","poem":1},{"text":"ወረ ሞሌኪንስ ከከተን፣","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ወረ ዋቀዮን ዱካ ቡኡ ዺሰኒ ዱበት ዴብአን፣","poem":1},{"text":"ወረ ዋቀዮን ህንበርባድኔዮካን ጎርሰሳ ህንጋፈትኔ ነንበሌሰ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ጉያን ዋቀዮ ዋን ዽኣቴፍ","poem":1},{"text":"ፉለ ዋቀዮ ጎፍታ ዱረት ጨልእሳ።","poem":2},{"text":"ዋቀዮ ቀልመ ቶኮ ቆጴሴረ፤","poem":1},{"text":"እን ወረ አፌሬ ቁልቁሌሴረ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ጉያ ቀልመ ዋቀዮት","poem":1},{"text":"አን ቆንዳልቶተ እልማን ሞትቻቲፊ","poem":2},{"lineBreak":true},{"text":"ወረ ወያ ኦርማ ኡፈተን ሁንደ ነንአደበ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አን ጋፈስ ወረ ቡሳረ ኡታለን፣","poem":1},{"text":"ከኔን ገልመ ዋቆተሳኒ","poem":2},{"lineBreak":true},{"text":"ጄቁምሳፊ ጎዎምሳዻን ጉተን ነንአደበ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ዋቀዮ አከነ ጄዸ፤","poem":1},{"text":"“ጋፈስ ከረ ቁርጡሚራ እየ፣","poem":2},{"text":"ወልተጂ ለመፋራ ወዋትና፣","poem":1},{"text":"ጋረንራሞ","poem":2},{"lineBreak":true},{"text":"ሰገሌ ዲገመ ጉዳቱ ዸጋአመ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እስን ወር መክቴሽ ኬሰ ጅራተን ወዋዻ፤","poem":1},{"text":"ደልደልቶትንኬሰን ሁንድ ለፈራ ሀጣአሙ፤","poem":2},{"lineBreak":true},{"text":"ወር ሜቲ ደልደለን ሁንድኑስ ንበርበዳኡ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አን ዬሮ ሰነ ዬሩሳሌምን እብሳዻን ነንሰከተአ፤","poem":1},{"text":"ወረ ቀነኒዻን ጅራተን፣","poem":2},{"lineBreak":true},{"text":"ከኔን አከ ዳዺ ወይኒ ሲጮ እረት ሀፌ ተአን፣","poem":2},{"text":"ከኔን፣ ‘ዋቀዮ ዋን ቶላስ ተኡ ዋን ሀማ","poem":1},{"text":"ሆማ ህንጎዹ’ ጄዸኒ ያደን ነንአደበ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ቀቤኝሳኒ ንሳመመ፤","poem":1},{"text":"መንሳኒ ንኦነ።","poem":2},{"text":"እሳን መነ እጃረቱ፤","poem":1},{"text":"ገሩ ኬሰ ህንጅራተን፤","poem":2},{"text":"እሳን ብቅልቱ ወይኒ ንዻበቱ፤","poem":1},{"text":"ገሩ ዳዺ ወይኒ ህንዹገን።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ጉያን ዋቀዮ ጉድች ዽኣቴረ፤","poem":1},{"text":"ዽኣቴስ ደፌ ዹፋ ጅረ።","poem":2},{"text":"ዸገኣ! እይ ጉያ ዋቀዮ ሀዻኣዸ፤","poem":1},{"text":"ጎትን አችት ሰገሌ ኦል ፉዸቴ እየ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ጉያን ሱን ጉያ ዼከምሳ፣","poem":1},{"text":"ጉያ ዽጵናፊ ገዳ፣","poem":2},{"text":"ጉያ ረክናፊ በዲሳ፣","poem":3},{"text":"ጉያ ዱከናፊ ድምምሳ፣","poem":2},{"text":"ጉያ ዱሜሳቲፊ ዱከነ ሀማ ንተአ፤","poem":3}]},{"type":"verse","number":16,"content":[{"text":"መጋላወን ደላ ቀበኒፊ","poem":2},{"text":"ገሞወን ኦል ዼዼሮረት","poem":1},{"text":"ጉያ እት መለከተ አፉፈኒፊ እየ ወራና ተአ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“ሰበቢ እሳን ዋቀዮት ጩቡ ሆጄተኒፍ፣","poem":1},{"text":"አን አከ እሳን አኩመ ጃማት ዴመኒፍ","poem":2},{"lineBreak":true},{"text":"ኡመተት ዽጵነ ነንፍደ።","poem":2},{"text":"ዺግንሳኒ አኩመ አዋራ፣","poem":1},{"text":"ምእ ገራሳኒስ አኩመ ኮሲ ገተመ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ጉያ ዼከምሰ ዋቀዮት","poem":1},{"text":"ሜቲንሳኒ ዮካን ወርቄንሳኒ","poem":2},{"lineBreak":true},{"text":"እሳን ኦልቹ ህንደንደኡ።”","poem":2},{"lineBreak":true},{"text":"እብደ ህናፋሳቲን","poem":1},{"text":"አዱኛን ሁንድ ንበርበዶፍት፤","poem":2},{"text":"ወረ ለፈረ ጅራተን ሁንደት","poem":1},{"text":"እን በዲሰ ተሳ ንፍዳቲ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ZEP/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ZEP/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/HAB/3.json","previousChapterAudioLinks":{},"numberOfVerses":18}