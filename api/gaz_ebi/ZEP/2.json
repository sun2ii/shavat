{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ZEP","translationId":"gaz_ebi","name":"ሴፋንያ","commonName":"ሴፋንያ","title":"ራጂ ሴፋንያ","order":36,"numberOfChapters":3,"sha256":"d491413ca2e5bbe8956493ace9dd3bed3913ab6eaa73e992db876bc6da071d9e","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gaz_ebi/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":2,"content":[{"type":"heading","content":["ይሁዳፊ ዬሩሳሌም ሰቦተ ወሊን እት ሙርቴፈሜ"]},{"type":"heading","content":["ይሁዳን አከ ቀልቢ ጅጂረቱፍ አኬከቺፈሜ"]},{"type":"verse","number":1,"content":[{"text":"ያ ሰበ ቃኒ ህንቀብኔ፣","poem":1},{"text":"ወልት ቀበማ፤ ወልት ቀበማ፤","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ኡቱ ዬሮን ሙርታኤ ሱን ገኤ","poem":1},{"text":"ጉያን ሱን አኩመ ሀበቂት እስን ህንሀጣእን፣","poem":2},{"text":"ኡቱ ኣሪን ዋቀዮ እን ቦበኣን ሱን","poem":1},{"text":"እስንት ህንዹፍን፣","poem":2},{"text":"ኡቱ ጉያን ዼከምሰ ዋቀዮ","poem":1},{"text":"እስንት ህንዹፍን ወልት ቀበማ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እስን ገራሞን ለፋ","poem":1},{"text":"ከኔን ዋን እን አጀጁ ሆጄተን ሁንድዋቀዮን በርባደዻ።","poem":2},{"text":"ቀጄሉማ በርባዳ፤ ገድ ኦፍ ቀቢሰ በርባዳ፤","poem":1},{"text":"እስን ጉያ ዼከምሰ ዋቀዮት","poem":2},{"lineBreak":true},{"text":"ንጎልቦበምቱ ተኣቲ።","poem":2}]},{"type":"heading","content":["ፍልስጤም"]},{"type":"verse","number":4,"content":[{"text":"ጋዛን ዱዋ ሀፍት፤","poem":1},{"text":"አሽቀሎንሞ ንኦንት።","poem":2},{"text":"ሰብን አሽዶድ ጉዩመ ሳፋዻን አርአሜ በአ፤","poem":1},{"text":"ኤቅሮንሞ ንቡቅፈምት።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ያ ኬሬቶተ ቀርቀረ ገላና ጅራተን፣","poem":1},{"text":"እስኒፍ ወዮ፤","poem":2},{"text":"ያ ከነኣን፣ ብየ ፍልስጤሞታ፣","poem":1},{"text":"ዱቢን ዋቀዮ አከነ ጄዼ ስት ዹፌረ፤","poem":2},{"text":"“አን ስን በርበዴሰ፤","poem":1},{"text":"ነምን ቶኮዩ ህንሀፉ።”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ብይ ቀርቀረ ገላና፣","poem":1},{"text":"እዶን ከሊቶትን ጅራተን፣","poem":2},{"lineBreak":true},{"text":"እዶ ትክስቶትን ጅራተኒፊ ጎለ ቡሻዬ ተአ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እንስ ሀንዹራ ሀምባ መነ ይሁዳ ተአ፤","poem":1},{"text":"እሳን አችት ለፈ ዼዳ አርገቱ።","poem":2},{"text":"እሳን ገልገለ ገልገለ","poem":1},{"text":"መነ አሽቀሎን ኬሰ ጭጪሱ።","poem":2},{"text":"ዋቀዮ ዋቅንሳኒ እሳን ትክሰ፤","poem":1},{"text":"ቦጁሳኒስ ንዴብሳፍ።","poem":2}]},{"type":"heading","content":["ሞኣቢፊ አሞን"]},{"type":"verse","number":8,"content":[{"text":"“አን አረብሶ ሞኣቢፊ","poem":1},{"text":"ቆሳ አሞኖታ፣","poem":2},{"text":"ወረ ሰበኮ አረብሰኒፊ","poem":1},{"text":"ብየሳኒ ዶርስሰን ሰና ዸገኤረ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ከናፉ አኩመ አን ዹጉማን ጅራታ ተኤ ሰነ፣”","poem":1},{"text":"ጄዸ ዋቀዮ ዋን ሁንደ ደንደኡ፣","poem":2},{"lineBreak":true},{"text":"ዋቅን እስራኤል አከነ ጄዸ፤","poem":2},{"text":"“ሞኣብ ዹጉማን አኩመ ሶዶም፣","poem":1},{"text":"አሞኖትንስ አከ ጎሞራ፣","poem":2},{"text":"እዶ አረማቲፊ ቦለ ሶግዳ፣","poem":1},{"text":"ለፈ በረ በራን ኦኔ ንተኡ።","poem":2},{"text":"ሀፍቴን ኡመተኮቲ እሳን ሳሙ፤","poem":1},{"text":"ወር ሰበኮ ኬሳ በዲ ጀላ በአን ብየሳኒ ንዻሉ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ኩን ገቲ እሳን ኦፍ ቱሉማሳኒቲፍ አርገተኒዸ፤","poem":1},{"text":"እሳን ሰበ ዋቀዮ ዋን ሁንደ ደንደኡ አረብሰኒ","poem":2},{"lineBreak":true},{"text":"እት ቆሰኒሩቲ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዋቀዮ ዬሮ ዋቆተ ብየቲ ሁንደ በርበዴሱት፣","poem":1},{"text":"አከ መሌ እሳን ሶዳችሰ።","poem":2},{"text":"ሰቦትን ቀርቀረ ገላነ ሁንዳረ ጅራተን፣","poem":1},{"text":"ነምን ብየሳ ኬሰ ጅራቱ ሁንድኑስ እሰ ዋቄፈተ።","poem":2}]},{"type":"heading","content":["እቶጵያ"]},{"type":"verse","number":12,"content":[{"text":"“ያ ወረ እቶጵያ","poem":1},{"text":"እስንስ ጎራዴኮቲን ንጎረአምቱ።”","poem":2}]},{"type":"heading","content":["አሶር"]},{"type":"verse","number":13,"content":[{"text":"እን ካበት ሀርከ ኦል ፉዸተ፤","poem":1},{"text":"አሶርንስ ንበርበዴሰ፤","poem":2},{"text":"ነነዌ ጉቱማን ጉቱት ንኦንሰ፤","poem":1},{"text":"አኩመ ገሞጂት ጎግሴ ሀምብሰ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ቡሻዬፊ ሎን፣","poem":1},{"text":"ኡመመወን ጎሰ ሁንዳ አች ጭጪሱ።","poem":2},{"text":"ኡሩንጉፊ ዸዴን","poem":1},{"text":"ኡቱባሼረ ቦቆቱ።","poem":2},{"text":"ሰገሌንሳኒ ፎዳወን ኬሳን ዸገአመ፤","poem":1},{"text":"ዲገምን በልበለሳኒ ዱረ ጅረ፤","poem":2},{"lineBreak":true},{"text":"ዴምዴሞን ብርብርሳ ሁንድኑ ቁላ ሀፈ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኩን መጋላ ኦፍ ህንኤገትኔ","poem":1},{"text":"ከን ገሩ ነጉማን ጅራቱዸ።","poem":2},{"text":"መጋላን ኩን፣","poem":1},{"text":"“አኑመ ቆፈ መሌ ከን ብራ ነ ብረ ህንጅሩ” ኦፊን ጄቴ።","poem":2},{"text":"እሼን አከም አከስ ኦንቴ፣","poem":1},{"text":"እዶ ብኔንስ ቦሶና ጅራቱ ታቴ!","poem":2},{"text":"ነምን እሼ ብረ በኤ ደርቡ ሁንድኑ ንቆሰ፤","poem":1},{"text":"ሀርከሳስ ንራሰ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}