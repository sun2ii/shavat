{"translation":{"id":"gaz_ebi","name":"ክታበ ቁልቁሉ, Biblica® ሂካ አመያ በነማ ሃራ, ሎቆደ ዽኣ","website":"https://ebible.org/Scriptures/details.php?id=gaze","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gaze","licenseNotes":null,"shortName":"EBI","englishName":"West Central Oromo Bible","language":"gaz","textDirection":"ltr","sha256":"f3eeb22163e62abd4aeeda7f1c58a68dfa1fff2482db437ee160fb95280d59e5","availableFormats":["json"],"listOfBooksApiLink":"/api/gaz_ebi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Oromoo","languageEnglishName":"Oromo"},"book":{"id":"ZEP","translationId":"gaz_ebi","name":"ሴፋንያ","commonName":"ሴፋንያ","title":"ራጂ ሴፋንያ","order":36,"numberOfChapters":3,"sha256":"d491413ca2e5bbe8956493ace9dd3bed3913ab6eaa73e992db876bc6da071d9e","firstChapterNumber":1,"firstChapterApiLink":"/api/gaz_ebi/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gaz_ebi/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["ዬሩሳሌም"]},{"type":"verse","number":1,"content":[{"text":"መጋላ ጩንቁርስቶታ፣","poem":1},{"text":"ፍንጭልቱፊ ጡሮፍቱ ሰናፍ ወዮ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እሼን ነመ ቶኮፍዩ ህንአጀጀምቱ፤","poem":1},{"text":"ስሬፈመ ቶኮዩ ህንፉዸቱ።","poem":2},{"text":"እሼን ዋቀዮን ህንአመነቱ፤","poem":1},{"text":"ዋቀ እሼትስ ህንዽኣቱ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ቆንዳልቶትንሼ ሌንጨ ኣዱዸ፤","poem":1},{"text":"ቡልችቶትንሼ ዬዪ ገልገላ","poem":2},{"lineBreak":true},{"text":"ከኔን ዋን ቶኮሌ ገነማፍህንቡልፈኔዸ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ራጆትንሼ ኦፍ ቱልቶተ፤","poem":1},{"text":"እሳን ነሞተ ህንአመነምኔዸ።","poem":2},{"text":"ሉቦትንሼ እዶ ቁልቁሉ ጡሬሰኒ","poem":1},{"text":"ሴረስ ጨብሱ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዋቀዮ እን እሼ ኬሰ ጅሩ ቀጄላዸ፤","poem":1},{"text":"እን ዶጎጎረ ቶኮሌ ህንሆጄቱ።","poem":2},{"text":"እን ገነመ ገነመ ሙርቲ ቀጄላ ኬነ፤","poem":1},{"text":"ጉያ ቶኮዩ ዋን ከነ ሆጄቹ ህንደዸቡ፤","poem":2},{"lineBreak":true},{"text":"ጀልኦትን ገሩ ቃኒ ቶኮዩ ህንቤከን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“አን ሰቦተ ነንበሌሰ፤","poem":1},{"text":"ደአኖወንሳኒ ዲገመኒሩ።","poem":2},{"text":"አከ ነምን ቶኮዩ አቺን ህንደበሬፍ","poem":1},{"text":"አን ዳንዲወንሼ ኦንሴረ።","poem":2},{"text":"መጋላወንሳኒ ኦነኒ","poem":1},{"text":"ነመ መሌ፣ ዱዋ ሀፉ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አን መጋላ ሰናን፣","poem":1},{"text":"‘አት ዹጉማን ነ ሶዳተ፤","poem":2},{"lineBreak":true},{"text":"ስሬፈመስ ንፉዸተ!’ ነንጄዼ።","poem":2},{"text":"ኤርገሲ እዶን ጅሬኘሼ ህንበዱ","poem":1},{"text":"ዮካን አደቢንኮ ሁንድኑ እሼት ህንዹፉ።","poem":2},{"text":"እሳን ገሩ ዋን ሆጄተን ሁንደ ኬሰት","poem":1},{"text":"ደበ ሆጄቹት ጭመን።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ከናፉ ጉያ አን እት ዹጋ በኡ ኤገዹ።”","poem":1},{"text":"ጄዸ ዋቀዮ፤","poem":2},{"text":"“አን ሰቦታፊ","poem":1},{"text":"ሞቱሞተ ወልት ቀቤ","poem":2},{"text":"ዼከምሰኮቲፊ","poem":1},{"text":"ኣሪኮ ሶዳችሳ ሰነ ሁንደ","poem":2},{"lineBreak":true},{"text":"እሳንት ዸንገላሱፍ ሙርቴሴረ።","poem":2},{"text":"አዱኛን ጉቱን እብደ ህናፋኮቲን","poem":1},{"text":"ጉበቴ በርበዶፍት።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ኤርገሲ አን አከ ሁንድሳኒመቃ ዋቀዮ ዋመተኒፍ፣","poem":1},{"text":"አከ ወሊ ገሉዻን እሰ ተጃጅለኒፍስ","poem":2},{"lineBreak":true},{"text":"አፋን ነሞታ ነንቁልቁሌሰ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ወር አናፍ ሰገደን፣ እንተለንኮ ከኔን ብትናአን","poem":1},{"text":"ለጌን እቶጵያ ገማ","poem":2},{"lineBreak":true},{"text":"ኬና ናፍ ፍዱ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሰበቢ አን ወረ ኦፍ ቱሉማሳኒት ገመደን","poem":1},{"text":"መጋላ ከነ ኬሳ ባሱፍ፣","poem":2},{"text":"ጋፈስ የከ አት ነት ሆጄቴ","poem":1},{"text":"ሰነ ሁንዳፍ ሰልጵን ስት ህንዹፉ።","poem":2},{"text":"አት ለመተ","poem":1},{"text":"ጋረኮ ቁልቁሉረት ኦፍ ህንቱልቱ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አን ገሩ ገራሞታፊ","poem":1},{"text":"ገድ ኦፍ ቀቤዪ","poem":2},{"text":"ከኔን መቃ ዋቀዮ አመነተን","poem":1},{"text":"ስ ኬሰት ነንሀምብሰ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሀምባን እስራኤል","poem":1},{"text":"የከ ቶኮሌ ህንሆጄተን።","poem":2},{"text":"እሳን ሶበ ህንዱበተን","poem":1},{"text":"ዮካን ጎዎምሳን አፋንሳኒ ኬሰት ህንአርገሙ።","poem":2},{"text":"እሳን ኛተኒ ቦቆቱ፤","poem":1},{"text":"ከን እሳን ሶዳችሱስ ይንጅሩ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ያ እንተለ ጥዮን አት ፋርፈዹ፤","poem":1},{"text":"ያ እስራኤል ሰገሌ ኦል ፉዸዹ እይ!","poem":2},{"text":"ያ እንተለ ዬሩሳሌም ገመዲቲ","poem":1},{"text":"ገራኬ ጉቱዻን እልልች!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዋቀዮ አደበኬ ስራ ፉዼረ፤","poem":1},{"text":"እን ዲኖተኬ ስራ ዴብሴረ።","poem":2},{"text":"ዋቀዮ ሞቲን እስራኤል፣ ስ ወጅን ጅረ፤","poem":1},{"text":"አት ለመተ በላ ቶኮሌ ህንሶዳቱ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እሳን ጋፈስ","poem":1},{"text":"ዬሩሳሌሚን አከነ ንጄዹ፤","poem":2},{"text":"“ያ ጥዮን ህንሶዳትን፤","poem":1},{"text":"ሀርክኬስ ህንላፍን።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዋቀዮ ዋቅንኬ","poem":1},{"text":"እን ስ ወጅን ጅሩ ጀባዸ።","poem":2},{"text":"እን ባይኤ ስት ገመደ፤","poem":1},{"text":"እን ጃለለሳቲን ስ ቦቆቺሰ፤","poem":2},{"lineBreak":true},{"text":"ፋርፈትናዻንስ ስት ገመደ።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“አን ገደ አት አያኖተ ሙርቴፈመኒፍ ገድቱ","poem":1},{"text":"ስራ ነንፉዸ፤","poem":2},{"lineBreak":true},{"text":"እሳን ቦእቻፊ ሰልጵነ ስት ተኡ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አን ዬሮ ሰነት","poem":1},{"text":"ወረ ስ ጩንቁርሰን ሁንደ ነንአደበ፤","poem":2},{"text":"አን ኦኮላ ነንበራረ፤","poem":1},{"text":"ወረ ገተመንስ ወልት ነንቀበ።","poem":2},{"text":"አን ብየ እሳን እት ቃኔፈመን ሁንደ ኬሰት","poem":1},{"text":"መቃፊ ኡልፍነ እሳኒፍን ኬናፍ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አን ዬሮ ሰነት ወልትን እስን ቀበ፤","poem":1},{"text":"ዬሮ ሰነት አን ብየኬሰንት እስን ነንገልቸ።","poem":2},{"text":"አን ዬሮ ኡቱመ እስን አርግተኒ","poem":1},{"text":"ቦጁኬሰን ዴብሱት","poem":2},{"text":"ሰበ ለፋ ሁንደ ግዱት","poem":1},{"text":"ኡልፍናፊ መቃ እስኒፍን ኬነ”","poem":2},{"lineBreak":true},{"text":"ጄዸ ዋቀዮ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gaz_ebi/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gaz_ebi/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gaz_ebi/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}