{"translation":{"id":"gel_wbt","name":"ut-Mai'n Scripture portions","website":"https://ebible.org/Scriptures/details.php?id=gel","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gel","licenseNotes":null,"shortName":"WBT","englishName":"ut-Ma’in: ut-Mai'n Scripture portions (Bible)","language":"gel","textDirection":"ltr","sha256":"9e9a165288be44638df33a82d019efcee5a938525c0b5dc8deb6d3f6805d8799","availableFormats":["json"],"listOfBooksApiLink":"/api/gel_wbt/books.json","numberOfBooks":12,"totalNumberOfChapters":184,"totalNumberOfVerses":5255,"languageName":"ut-Ma'in","languageEnglishName":"ut-Ma'in"},"book":{"id":"GEN","translationId":"gel_wbt","name":"U̱r-Taku̱n","commonName":"U̱r-Taku̱n","title":"Ran-u̱ U̱r-Taku̱n","order":1,"numberOfChapters":50,"sha256":"f4aedcd5969a6708a9ae3c76a5b9ec10d59395d57afae8232f13b806cf59eed7","firstChapterNumber":1,"firstChapterApiLink":"/api/gel_wbt/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/gel_wbt/GEN/50.json","totalNumberOfVerses":1531},"chapter":{"number":49,"content":[{"type":"heading","content":["Yakubu wa'agu̱ ya'ag-u̱campa-ne̱ wa nu-u so̱-o̱"]},{"type":"verse","number":1,"content":["Se̱ Yakubu fog ya'ag-u̱ campa-ne̱ wa tu̱msu̱ wa zu̱: <<Kargu̱n u̱du̱ ri, u̱m waru̱ no̱ no̱m-u̱ do̱'e̱ kwu̱m-du̱ no̱ u̱ da-u̱ de'e̱ u̱ haan.>>"]},{"type":"verse","number":2,"content":[{"text":"<<Kargu̱n no̱ e̱r,","poem":1},{"text":"Yaag-u̱ ri Yakubu;","poem":2},{"text":"E̱re̱n Isra u̱so-u no̱.>>","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Rube̱n, bo̱ o̱ye̱ mat-du̱ u-shu̱ ri.","poem":1},{"text":"Bo̱ wa u̱m mate̱ da-u̱","poem":2},{"text":"u̱m o̱o̱ge̱ u̱ fa-u̱r ri,","poem":1},{"text":"u̱ da-u̱ u̱m o̱o̱ge̱ u̱ ho̱g-mu̱ u̱r-be̱b.","poem":2},{"text":"Bo̱ wa o̱ yu̱-shu̱","poem":1},{"text":"tu̱msu̱ wu̱ ze̱ge̱ u̱r-be̱b.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ko̱ ba shu̱'u̱te̱ zu̱","poem":1},{"text":"bo̱ wa-ko̱b-du̱ shu̱p-du̱ u̱r-hi wa","poem":2},{"text":"u̱ka bu̱-mu̱ u̱r-be̱b.","poem":1},{"text":"U̱ da-o̱ bo̱ za kwu̱m-du̱","poem":2},{"lineBreak":true},{"text":"re̱-u̱ u-shu̱ da,","poem":2},{"text":"remu̱ zu̱ bo̱ daag","poem":1},{"text":"u̱ yu̱n-u ri bo̱ naas o̱.","poem":2},{"text":"Bo̱ roogte̱ u̱ to̱k-ne̱,","poem":1},{"text":"wu̱ shu̱'u̱te̱ wa-gan","poem":2},{"text":"u̱ te̱k-u̱ ne̱ta-u̱t ri.","poem":1},{"text":"Bo̱ wa'ag me̱ u̱so-u ró","poem":2},{"text":"u̱ ho̱g-du̱ m-'e̱.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Simiyo̱n e̱ Re̱wi jab-u̱s e̱ o̱ u̱s-gan,","poem":1},{"text":"van-su̱ m-wu̱r u̱n","poem":2},{"text":"no̱m-tu̱ yu̱nu̱s-du̱ jab-su̱ u̱t-ne̱t se̱.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"U̱m zaar u̱ cwadu̱ mo̱ro̱g-u̱r u̱n da,","poem":1},{"text":"U̱m za tu̱msu̱ same̱ u̱t-hi","poem":2},{"text":"u̱ no̱m-du̱ no̱m-u̱t yo̱-to̱ u̱n ne̱ da.","poem":1},{"lineBreak":true},{"text":"U̱n ho̱o̱rte̱ u̱t-ne̱t remu̱ ryab-u̱s u̱n.","poem":1},{"text":"Tu̱msu̱ e̱ kwu̱pru̱sse̱ tu̱ru̱g-su̱ na,","poem":2},{"text":"remu̱ ho̱g-du̱ u̱r-zwaru̱ u̱n.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Nu-u yo̱-o̱ u̱du̱ ryab-u̱s u̱n,","poem":2},{"lineBreak":true},{"text":"remu̱ zu̱ ryab-u̱s u̱n no̱ng u-tát.","poem":2},{"text":"Me̱ bu̱ru̱gse̱ u̱n du̱gu̱ ko̱-u̱r Yakubu,","poem":1},{"text":"u̱m bu̱ru̱gse̱ u̱n du̱gu̱ me̱ Isra-ne̱.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"<<Yahuda, o̱r-u̱t ró ne̱","poem":1},{"text":"do̱'e̱ no̱mu̱ bo̱ u̱t-vam.","poem":2},{"text":"Bo̱ do̱'e̱ u̱ shu̱p-du̱ ge̱ku̱stu̱","poem":1},{"text":"hu̱u̱b-u̱t yo̱-to̱ ró.","poem":2},{"text":"Yaag-u̱ u̱so-u ró do̱'e̱ u̱t-he̱","poem":1},{"text":"u̱t-jwu̱n u̱ shu̱ ró.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yahuda wa'-u̱ ri,","poem":1},{"text":"ya-du̱ u-zur de̱ wa o̱o̱ge̱,","poem":2},{"lineBreak":true},{"text":"wu̱ tase̱ tu̱du̱ ap-mu̱ u̱r-do̱g mu̱ wa mase̱,","poem":2},{"text":"Wa ru̱t wa nu̱ku̱s m-kim","poem":1},{"text":"da-u̱ wa tase̱ re̱-du̱ no̱m u̱t-re̱.","poem":2},{"text":"Bo̱ o̱ sha-mu̱ ya-du̱ uzur,","poem":1},{"text":"waku̱n zaar wu̱ de̱ yu̱nsu̱ bo̱ da.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bo̱ Yahuda, ko̱m-yu̱ u̱r-faru̱k","poem":1},{"text":"za u̱t-rwu̱ du̱gu̱-du̱ ró da.","poem":2},{"lineBreak":true},{"text":"Ko̱m-yu̱ u̱r-faru̱k zaar u̱t-mo̱t","poem":2},{"text":"u̱ ne̱t-u̱t ró ne̱ da.","poem":1},{"text":"Se̱ teeg u̱du̱ wu̱ kame̱ wa re̱.","poem":2},{"lineBreak":true},{"text":"U̱t-dak u̱t-be̱e̱t to̱ ya'u̱ bo̱ m-ze̱g.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bo̱ gagu̱ janka-u ró","poem":1},{"text":"u̱ te-yu̱ inabi,","poem":2},{"text":"jwaak-u wu̱n u̱t-no̱m","poem":1},{"text":"u̱t-re̱e̱g u̱s-nag-nag su̱ cite̱ e̱,","poem":2},{"text":"Wa jasu̱ kus-u̱t wa","poem":1},{"text":"u̱ bu̱-mu̱ inabi,","poem":2},{"text":"no̱ u̱t-no̱m m-jaas","poem":1},{"text":"u̱ bu̱-mu̱ inabi mu̱ o̱","poem":2},{"text":"u̱ jaz-mo̱ u̱ka m-hyu̱.","poem":1}]},{"type":"verse","number":12,"content":[{"text":"Is-u̱ ró u̱t-no̱m u̱s-rim","poem":2},{"text":"m-ze̱g bu̱-mu̱ ke̱,","poem":1},{"text":"tu̱msu̱ ni-nu̱ wu̱n u̱t-no̱m","poem":2},{"text":"u̱r-myak m-ze̱g m-me̱.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"<<Ze̱burun u̱t-shu̱'u̱t u̱ kit-yu̱ m-sa.","poem":1},{"text":"U̱ shu̱'u̱t be-du̱ e̱e̱s-du̱ hat-su̱ m-bu̱,","poem":2},{"lineBreak":true},{"text":"Ma-du̱ u-bo̱r wa u̱t-te bo̱-u̱ Sidon.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"<<Issakar, janka-yu̱ u̱r-be̱b ya.","poem":1},{"text":"Wa o̱ m-ru̱t u̱ te̱k-u̱ kapu-tu̱","poem":2},{"text":"gag-du̱ u̱t-cwu̱ u̱t-yu̱r.","poem":1}]},{"type":"verse","number":15,"content":[{"text":"Wa u̱t-hyan u̱zu̱","poem":2},{"text":"be-du̱ u̱r-hure̱ wa o̱ so̱-de̱,","poem":1},{"text":"tu̱msu̱ wa u̱t-ho̱g","poem":2},{"text":"u̱ka re̱me̱r-mu̱ u-dak o̱tte̱.","poem":1},{"text":"Wa yasu̱ shin-u wa remu̱","poem":2},{"text":"kab-du̱ cwu̱-tu̱ m-no,","poem":1},{"text":"wa yase̱ hi-u̱r wa","poem":2},{"text":"u̱ no̱m-du̱ m-to̱k mu̱ u̱r-be̱b.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dan, do̱'e̱ u̱t-shu̱'u̱t wa kwu̱p-du̱ u̱s-rem","poem":1},{"text":"u-me̱ ne̱t-u̱t wa,","poem":2},{"text":"u̱ka to̱ku̱n ko̱-to̱ u̱-me̱ Isra-ne̱.","poem":1}]},{"type":"verse","number":17,"content":[{"text":"Dan wa do̱'e̱ u̱t-shu̱'u̱t","poem":2},{"text":"u-fa u̱ kit-u̱ u-fu̱n,","poem":1},{"text":"fa-yu̱ m-rab u̱ kit u-fu̱n,","poem":2},{"text":"Yu̱ epe̱ du̱ku̱nte̱ du̱ jwaak,","poem":1},{"text":"remu̱ i o̱ m-sak e̱ he̱'e̱ u̱-dim.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yawe, u̱m o̱ wadu̱ is u̱ u̱ku̱r-u ró.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"<<Gad, hyu̱w-ne̱ kwu̱p-du̱ u̱s-fu̱n ne̱","poem":1},{"text":"do̱'e̱ u̱ haan u̱ bo̱,","poem":2},{"text":"se̱di bo̱ doru̱ dim-u̱ u̱n","poem":1},{"text":"wa to̱p u̱r-mag.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"<<Ashu̱r, bo̱ no̱mu̱ no̱m u̱t-re̱","poem":1},{"text":"tu̱ m-re̱rem u-tát tu̱ farkina-ne̱.","poem":2},{"text":"Tu̱msu̱ i nome̱ no̱m-tu̱ u̱t-re̱","poem":1},{"text":"tu̱ m-re̱me̱r tu̱ faru̱k.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"<<Napari, bo̱ do̱'e̱ u̱t-shu̱'u̱t u̱ka u-nu̱m,","poem":1},{"text":"wa do̱'e̱ mat-du̱ yaag-u̱ so̱ye̱.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"<<Yusuhu, bo̱ matu̱ yaag u-tát,","poem":1},{"text":"bo̱ o̱ sha-mu̱ te-yu̱ inabi","poem":2},{"text":"yu̱ o̱o̱ge̱ kit-u̱ u-gi yu̱ mu̱te̱ u̱t-ya,","poem":1},{"text":"yu̱ fe̱k-u̱s wa rogme̱","poem":2},{"text":"m-pas ja-mu̱ u̱r-bo̱ngo̱.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Hu̱u̱b-u̱t yo̱-to̱ u̱n do̱'e̱ he̱e̱se̱ u̱n","poem":1},{"text":"m-dum za u̱r-o̱n,","poem":2},{"text":"hu̱u̱b-u̱t yo̱-to̱ u̱n do̱'e̱","poem":1},{"text":"tadu̱ wu̱n u̱s-ta u̱t-e̱r ne̱.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Se̱di ta-u wu̱n u̱t-shu̱'u̱t","poem":1},{"text":"u̱ go̱ri-go̱ri,","poem":2},{"text":"tu̱msu̱ kom-u̱t wu̱n","poem":1},{"text":"u̱t-shu̱'u̱t u̱r-be̱b ne̱,","poem":2},{"text":"U̱-remu̱ kom-u̱ wa-u̱r-be̱b","poem":1},{"text":"wu̱ Yakubu, tu̱msu̱ u̱","poem":2},{"lineBreak":true},{"text":"remu̱ wa-gwat-du̱ na,","poem":2},{"text":"ta'ar-du̱ Isra-ne̱.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"U-Ru̱, wu̱ u̱m no̱me̱ u̱t-huuk,","poem":1},{"text":"wa no̱me̱ ko̱-u̱r ró u̱r-se̱ge̱.","poem":2},{"text":"Ru̱-u̱ ko̱-uyan wa wa'-u̱","poem":1},{"text":"u̱n kom-u so̱-o̱,","poem":2},{"text":"u̱ to̱mto̱n u̱n m-bu̱ du̱gu̱ do̱m u-ru̱,","poem":1},{"text":"tu̱msu̱ wa ya'u̱ u̱n bu̱-mu̱ ta u-dak,","poem":2},{"text":"m-ra u̱ ta u-dak-ne̱.","poem":1},{"text":"Wa ya'u̱ u̱n na u-tát u̱ yaag ne̱.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Yage̱ nu-u so̱-o̱ tu̱ u̱so-u ró,","poem":1},{"text":"to̱ ze̱k nu-u so̱-o̱ tu̱ ro̱r-tu̱ da-u̱","poem":2},{"lineBreak":true},{"text":"tu̱ arke̱ m-tumb ne̱,","poem":2},{"text":"m-te jamu̱ ro̱r-tu̱ mo̱mmo.","poem":1},{"text":"Yusuhu, u̱m no̱ng u̱s-ko̱n","poem":2},{"text":"u̱zu̱ na ya'u̱ bo̱ to̱ haan u̱du̱ ró,","poem":1},{"text":"bo̱ yu̱ shu̱'u̱te̱ yu̱-shu̱ o̱r-u̱t ró ne̱.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"<<Banyamin bo̱ o̱ye̱ u-go yu̱ u̱r-do̱g","poem":1},{"text":"yu̱ o̱o̱ge̱ ho̱g-du̱ u̱s-me̱r,","poem":2},{"text":"u̱r-wu̱n bo̱ ho̱ hu̱u̱b-u̱ u̱t-yo̱-to̱ ró,","poem":1},{"text":"tu̱msu̱ m-rim bo̱ de̱ mo̱t-du̱ kwu̱m-tu̱","poem":2},{"lineBreak":true},{"text":"bo̱ o̱nke̱ du̱gu̱-du̱ hu̱u̱b-u̱t yo̱-to̱ ró.>>","poem":2}]},{"type":"verse","number":28,"content":["Tun-to̱ to̱ o̱ye̱ ko̱-tu̱ Isra-ne̱ o̱p-u̱t yu̱r, tu̱msu̱ no̱mu̱ u̱so-u̱ u̱n zu̱ye̱ u̱n u̱ ya da-u̱ wa o̱o̱ge̱ wa'-u̱ u̱n nu-u so̱-o̱. Wa wa'-u̱ ko̱wan nu-u so̱-o̱ u̱ kame̱ wa."]},{"type":"heading","content":["Mar-m Yakubu"]},{"type":"verse","number":29,"content":["Yakubu yu̱ u̱n tunto̱ bo̱r-to̱: <<U̱m o̱ u̱t-mo̱r m-mar ne̱ u̱m byu̱tu̱n u̱so-u̱t ri. Jwaku̱n me̱ u̱ u̱so-u̱t ri ne̱ u-pu̱ku̱s u-tak u̱ Eparo̱n ne̱t-u̱ He̱t-ne̱."]},{"type":"verse","number":30,"content":["Pu̱ku̱s u̱ o̱o̱ge̱ tak-u̱ Mape̱ra, u̱ dapu̱s Mamre Kan'ana, u̱ Ibrahi o̱ye̱ u̱ka be-du̱ u-dok u̱du̱ Eparo̱n ne̱t-u̱ He̱t-ne̱, u̱r-same̱ u-tak ne̱."]},{"type":"verse","number":31,"content":["Ku̱na na dokte̱ Ibrahi e̱ ne̱ta wa Saratu. Ku̱na na dokte̱ Ishaku e̱ ne̱ta wa Rebeka. Ku̱na tu̱msu̱ na dokte̱ Riya."]},{"type":"verse","number":32,"content":["Ibrahi o̱o̱g u-tak u̱ pu̱ku̱s ne̱ du̱gu̱-du̱ ne̱t-tu̱ He̱t.>>"]},{"type":"verse","number":33,"content":["Da-u̱ Yakubu tase̱ waru̱ ya'ag-u̱ wa u̱s-rem, se̱ wa ru̱t u̱-do̱m u-yu̱n. Wa nom vu̱'e̱ su̱ m-vaste̱, wa dor u̱so-u̱t wa, wa mu̱ru̱s."]}],"footnotes":[]},"thisChapterLink":"/api/gel_wbt/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gel_wbt/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gel_wbt/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}