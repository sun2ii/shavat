{"translation":{"id":"gel_wbt","name":"ut-Mai'n Scripture portions","website":"https://ebible.org/Scriptures/details.php?id=gel","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gel","licenseNotes":null,"shortName":"WBT","englishName":"ut-Ma’in: ut-Mai'n Scripture portions (Bible)","language":"gel","textDirection":"ltr","sha256":"9e9a165288be44638df33a82d019efcee5a938525c0b5dc8deb6d3f6805d8799","availableFormats":["json"],"listOfBooksApiLink":"/api/gel_wbt/books.json","numberOfBooks":12,"totalNumberOfChapters":184,"totalNumberOfVerses":5255,"languageName":"ut-Ma'in","languageEnglishName":"ut-Ma'in"},"book":{"id":"JON","translationId":"gel_wbt","name":"Yunana","commonName":"Yunana","title":"Ran-u Yunana","order":32,"numberOfChapters":4,"sha256":"0f5d184919967bac7bd00325d4a7dd452f356afe99345a752934706eeb7e8d4e","firstChapterNumber":1,"firstChapterApiLink":"/api/gel_wbt/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/gel_wbt/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["To̱o̱g-u̱s Yunana u̱du̱ u-Ru̱"]},{"type":"verse","number":1,"content":["Da-u̱ wa o̱o̱ge̱ u̱-me̱ me̱n-tu̱ u-jan, Yunana no̱ng u̱s-to̱o̱g u̱du̱ Yawe u-Ru̱."]},{"type":"verse","number":2,"content":["Wa zu̱,",{"text":"<<U̱m fak Yawe u̱ te̱k-u̱","poem":1},{"text":"swadu̱ u̱r-ko̱b u̱ ri,","poem":2},{"text":"tu̱msu̱ wa shu̱s to̱o̱g-u̱s ri.","poem":1},{"text":"U̱-me̱ be-du̱ u̱r-shu̱'u̱t","poem":2},{"lineBreak":true},{"text":"du̱ marimari ne̱,","poem":2},{"text":"tu̱msu̱ bo̱ hog ko̱n-u̱s ri.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bo̱ gwu̱nu̱g me̱ u̱-me̱ m-bu̱ mu̱ u̱r-ra,","poem":1},{"text":"u̱ te̱k-u̱ dak-u̱ m-sa.","poem":2},{"text":"U̱m o̱ u̱-me̱ m-bu̱,","poem":1},{"text":"tu̱msu̱ jwak m-bu̱, re̱e̱g be̱b-u̱r ri.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"U̱m zu̱u̱g, <Ko̱ bo̱ hastu̱ me̱ du̱gu̱-du̱ ró,","poem":1},{"text":"ko ba shu̱'u̱te̱ iya,","poem":2},{"text":"me̱ u̱t-sur m-hyan","poem":1},{"text":"pyu̱-u̱ u-he̱n u̱ ró.>","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bu̱-mu̱ re̱e̱g me̱ u̱r-hi,","poem":1},{"text":"bu̱-mu̱ m-sa taku̱ste̱ me̱ u-be̱e̱t.","poem":2},{"text":"Gwa-su̱ me̱ m-sa","poem":1},{"text":"taku̱ste̱ hi-u̱r ri.","poem":2},{"noteId":1}]},{"type":"verse","number":6,"content":[{"text":"U̱m yi'iste̱ u̱-ta","poem":1},{"text":"m-sa m-te u̱ be-du̱ u̱t-ta'ar.","poem":2},{"text":"U̱m o̱ u̱-me̱ be-du̱ marimari ne̱.","poem":1},{"text":"Yawe, u-Ru̱ u̱ ri,","poem":2},{"text":"bo̱ wa ruutu̱ me̱ u̱-me̱ u-kub.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"<<Yawe, da-u̱ u̱m ho̱ge̱ fat-u̱r ri","poem":1},{"text":"o̱ m-rwu̱;","poem":2},{"text":"tu̱msu̱ u̱m nom u̱s-to̱o̱g u̱du̱ ró,","poem":1},{"text":"Tu̱msu̱ bo̱ hog ko̱n-u̱s ri","poem":2},{"text":"u̱-me̱ be-du̱ u-he̱n u̱ ró.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"<<Ne̱t-tu̱ o̱o̱ge̱ no̱m-du̱ u̱t-huuk m-gir,","poem":1},{"text":"e̱ gu̱gu̱mte̱ o̱n-du̱ u̱","poem":2},{"lineBreak":true},{"text":"cwan-tu̱ u-Ru̱ ne̱.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Se̱di me̱, u̱ nu-u̱ u̱t-vam.","poem":1},{"text":"U̱m de̱ no̱m-du̱ to̱o̱g u̱du̱ ró.","poem":2},{"text":"Me̱ shu̱su̱ este̱du̱ u̱s-rem u̱ ri,","poem":1},{"text":"remu̱ u̱ku̱r u̱ o̱o̱n du̱gu̱ Yawe.>>","poem":2}]},{"type":"verse","number":10,"content":["Se̱ Yawe wu̱' jan-yu̱ gwa'u̱n Yunana u̱-kit m-sa."]}],"footnotes":[{"noteId":1,"caller":"+","text":"Gwa-tu̱ apne̱ u̱-me̱ m-sa.","reference":{"chapter":2,"verse":5}}]},"thisChapterLink":"/api/gel_wbt/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gel_wbt/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gel_wbt/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}