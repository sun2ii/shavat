{"translation":{"id":"gfk_tbl","name":"No Sigar Kunubus tika ma Ira Ninge na Lotu","website":"https://ebible.org/Scriptures/details.php?id=gfk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gfk","licenseNotes":null,"shortName":"TBL","englishName":"Patpatar NT and Psalms","language":"gfk","textDirection":"ltr","sha256":"4d2ca23b12dd64204813f4c77bb1d54fc768362e410bd3736643d297af93cb9b","availableFormats":["json"],"listOfBooksApiLink":"/api/gfk_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10160,"languageName":"Patpatar","languageEnglishName":"Patpatar"},"book":{"id":"PSA","translationId":"gfk_tbl","name":"Ninge","commonName":"Ninge","title":"IRA NINGE NA LOTU","order":19,"numberOfChapters":150,"sha256":"6d5a24890ba59b6f96dacf8429fe2051ca3f61ed14315a9c6e4fa91f090d3ec0","firstChapterNumber":1,"firstChapterApiLink":"/api/gfk_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gfk_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Pirlat no Watong.","poem":1},{"lineBreak":true},{"text":"Muat ira tultulai tano Watong, muat na pirlat ie.","poem":2},{"lineBreak":true},{"text":"Pirlat no hinsana no Watong.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Da pirlat no hinsana no Watong,","poem":1},{"text":"kaiken ma namur ma pa na pataam.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Da pirlat no hinsana no Watong merau laah hoing no kasakes i la tutut hut kaia","poem":1},{"text":"tuk taar ares hoing i la sungsuguh kaia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"No Watong i manga tamat naliu ta ira kaba kantri bakut,","poem":1},{"text":"ma no minamarine i naliu saakit tano mawe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Taie tikai i haruat hoing no Watong, no nudahat God,","poem":1},{"text":"nong i la kis taar aram naliu saakit,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ma i la tuntudu suur wara nasnas","poem":1},{"text":"no mawe ma no ula hanuo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"I raun haut no maris mekaia ra kaabus","poem":1},{"text":"ma i tatik haut no malahahin sukun ira tahuna iaah.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"I hakisi tikane ie ma ira tamat na lualua,","poem":1},{"text":"kaike ira lualua ta ira uno matanaiabar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I haguama no hinkaho ing na kapis bulu,","poem":1},{"text":"ma na hakisi timaan ie huo narako tano ngasiana.","poem":2},{"lineBreak":true},{"text":"Pirlat no Watong.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gfk_tbl/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gfk_tbl/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gfk_tbl/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}