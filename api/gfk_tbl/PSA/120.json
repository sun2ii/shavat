{"translation":{"id":"gfk_tbl","name":"No Sigar Kunubus tika ma Ira Ninge na Lotu","website":"https://ebible.org/Scriptures/details.php?id=gfk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gfk","licenseNotes":null,"shortName":"TBL","englishName":"Patpatar NT and Psalms","language":"gfk","textDirection":"ltr","sha256":"4d2ca23b12dd64204813f4c77bb1d54fc768362e410bd3736643d297af93cb9b","availableFormats":["json"],"listOfBooksApiLink":"/api/gfk_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10160,"languageName":"Patpatar","languageEnglishName":"Patpatar"},"book":{"id":"PSA","translationId":"gfk_tbl","name":"Ninge","commonName":"Ninge","title":"IRA NINGE NA LOTU","order":19,"numberOfChapters":150,"sha256":"6d5a24890ba59b6f96dacf8429fe2051ca3f61ed14315a9c6e4fa91f090d3ec0","firstChapterNumber":1,"firstChapterApiLink":"/api/gfk_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gfk_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":120,"content":[{"type":"hebrew_subtitle","content":["A ninge utano hinahaan uram Ierusalem."]},{"type":"verse","number":1,"content":[{"text":"Ta ira nugu tinirih iau ga tataau uram tano Watong","poem":1},{"text":"ma ga taram iau.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Watong, halon iau sukun ira ut na harabota","poem":1},{"text":"ma ira ina bis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"No Watong na gil ra sa ta muat ira ut na harabota?","poem":1},{"text":"A tamat na harpidanau sa bia na ubal muat mei?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Na hapidanau muat ma ira rumus gar na umri ing i manga iaiaan","poem":1},{"text":"tika ma ra kalangaruan na kukurto na kuhule.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Maris tagu, i hoing bia iau gaar goota ares Mesek ing i tapaka saakit,","poem":1},{"text":"bia iau gaar kis longai ta ira palpalih arau Kedar!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iau te lon lawas","poem":1},{"text":"nalamin ta diet ing diet malentakuane ra malum.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"A tunotuno na malum iau,","poem":1},{"text":"iesen ing iau la iangianga, diet sip wara hinarubu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gfk_tbl/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gfk_tbl/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gfk_tbl/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}