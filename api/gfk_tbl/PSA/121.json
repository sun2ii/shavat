{"translation":{"id":"gfk_tbl","name":"No Sigar Kunubus tika ma Ira Ninge na Lotu","website":"https://ebible.org/Scriptures/details.php?id=gfk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gfk","licenseNotes":null,"shortName":"TBL","englishName":"Patpatar NT and Psalms","language":"gfk","textDirection":"ltr","sha256":"4d2ca23b12dd64204813f4c77bb1d54fc768362e410bd3736643d297af93cb9b","availableFormats":["json"],"listOfBooksApiLink":"/api/gfk_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10160,"languageName":"Patpatar","languageEnglishName":"Patpatar"},"book":{"id":"PSA","translationId":"gfk_tbl","name":"Ninge","commonName":"Ninge","title":"IRA NINGE NA LOTU","order":19,"numberOfChapters":150,"sha256":"6d5a24890ba59b6f96dacf8429fe2051ca3f61ed14315a9c6e4fa91f090d3ec0","firstChapterNumber":1,"firstChapterApiLink":"/api/gfk_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gfk_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":121,"content":[{"type":"hebrew_subtitle","content":["A ninge utano hinahaan uram Ierusalem."]},{"type":"verse","number":1,"content":[{"text":"Iau nanaas uram ta ira uladih.","poem":1},{"text":"No nugu harharahut na hanuat meh?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"No nugu harharahut i hanuat mekaia tano Watong","poem":1},{"text":"nong ga hakisi no mawe ma no ula hanuo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Pa na bale ira kakim bia na malmalagir wara punuko.","poem":1},{"text":"Aie nong i nes mur tar ugu pa na sumsumela.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tutun saakit, aie nong i nes mur tar ira Israel","poem":1},{"text":"pa na sumsumela ma pa na kubaba mah.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"No Watong i la nesnes mur ugu.","poem":1},{"text":"No Watong aie no ududuh tano kata na limaam.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"No kasakes pa na rang hagahe ugu tano tingena kasakes,","poem":1},{"text":"ma bia no teka mah tano bung.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"No Watong na balaure bat ugu ta ira saksakena bakut.","poem":1},{"text":"Na nes mur no num lon.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"No Watong na nes mur ugu tano num hinaan laah ma no num hinanuat mah,","poem":1},{"text":"kaiken ma namur ma pa na pataam.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gfk_tbl/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gfk_tbl/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gfk_tbl/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}