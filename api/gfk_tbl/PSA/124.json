{"translation":{"id":"gfk_tbl","name":"No Sigar Kunubus tika ma Ira Ninge na Lotu","website":"https://ebible.org/Scriptures/details.php?id=gfk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gfk","licenseNotes":null,"shortName":"TBL","englishName":"Patpatar NT and Psalms","language":"gfk","textDirection":"ltr","sha256":"4d2ca23b12dd64204813f4c77bb1d54fc768362e410bd3736643d297af93cb9b","availableFormats":["json"],"listOfBooksApiLink":"/api/gfk_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10160,"languageName":"Patpatar","languageEnglishName":"Patpatar"},"book":{"id":"PSA","translationId":"gfk_tbl","name":"Ninge","commonName":"Ninge","title":"IRA NINGE NA LOTU","order":19,"numberOfChapters":150,"sha256":"6d5a24890ba59b6f96dacf8429fe2051ca3f61ed14315a9c6e4fa91f090d3ec0","firstChapterNumber":1,"firstChapterApiLink":"/api/gfk_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gfk_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":124,"content":[{"type":"hebrew_subtitle","content":["A ninge utano hinahaan uram Ierusalem. Devit ga pit ie."]},{"type":"verse","number":1,"content":[{"text":"“Gor ngan hohe ing bia no Watong pa gate tur wara harharahut dahat?”","poem":1},{"text":"Na tahut bia Israel na tange habaling hoken:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Gor ngan hohe ing bia no Watong pa gate tur wara harharahut dahat","poem":1},{"text":"tano pakana bung ing ira tunotuno diet ga tut na hinarubu ma dahat?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Io, diet gor kanam halilon dahat","poem":1},{"text":"tano pakana bung ing diet ga bala mamahien ma ra tamat na ngalngaluan taar ta dahat.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"No taahit gor kanam dahat,","poem":1},{"text":"ma no taah gor burung dahat.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"No tektek gor salirane dahat.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"A pirharlat tupas no Watong,","poem":1},{"text":"nong pai le bale dahat bia da sapak dahat ma ira ngise diet.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dahat te langalanga haruat ma ra maan i tamalapus laah tano kuun, a uno no ut na hakuni maan.","poem":1},{"text":"No kuun i te tamarapat, ma dahat te langalanga sukun ie.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"No udahat harharahut ie ke tano Watong,","poem":1},{"text":"nong ga hakisi no mawe ma no ula hanuo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gfk_tbl/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gfk_tbl/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gfk_tbl/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}