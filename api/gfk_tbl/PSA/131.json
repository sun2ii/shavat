{"translation":{"id":"gfk_tbl","name":"No Sigar Kunubus tika ma Ira Ninge na Lotu","website":"https://ebible.org/Scriptures/details.php?id=gfk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gfk","licenseNotes":null,"shortName":"TBL","englishName":"Patpatar NT and Psalms","language":"gfk","textDirection":"ltr","sha256":"4d2ca23b12dd64204813f4c77bb1d54fc768362e410bd3736643d297af93cb9b","availableFormats":["json"],"listOfBooksApiLink":"/api/gfk_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10160,"languageName":"Patpatar","languageEnglishName":"Patpatar"},"book":{"id":"PSA","translationId":"gfk_tbl","name":"Ninge","commonName":"Ninge","title":"IRA NINGE NA LOTU","order":19,"numberOfChapters":150,"sha256":"6d5a24890ba59b6f96dacf8429fe2051ca3f61ed14315a9c6e4fa91f090d3ec0","firstChapterNumber":1,"firstChapterApiLink":"/api/gfk_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gfk_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":131,"content":[{"type":"hebrew_subtitle","content":["A ninge utano hinahaan uram Ierusalem. Devit ga pit ie."]},{"type":"verse","number":1,"content":[{"text":"Watong, iau pai latlaat,","poem":1},{"text":"ma iau pai la nas hatamat tar iau.","poem":2},{"text":"Iau pai la madung taar ma ira linge tamat,","poem":1},{"text":"bia ira linge i kalkalala bia iau ni nunure.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iesen iau te hamarur ma iau te hamatien no nugu lon.","poem":1},{"text":"Hoing tiga bulu di te hatabunei wara sunus i kis matien taar at ma no pawasine,","poem":2},{"lineBreak":true},{"text":"no nugu lon i haruat huo aram narakoman tagu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ira Israel, muat na kis nanaho ma ra nurnuruan tano Watong","poem":1},{"text":"kaiken ma namur ma pa na pataam.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gfk_tbl/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gfk_tbl/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gfk_tbl/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}