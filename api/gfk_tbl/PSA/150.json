{"translation":{"id":"gfk_tbl","name":"No Sigar Kunubus tika ma Ira Ninge na Lotu","website":"https://ebible.org/Scriptures/details.php?id=gfk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gfk","licenseNotes":null,"shortName":"TBL","englishName":"Patpatar NT and Psalms","language":"gfk","textDirection":"ltr","sha256":"4d2ca23b12dd64204813f4c77bb1d54fc768362e410bd3736643d297af93cb9b","availableFormats":["json"],"listOfBooksApiLink":"/api/gfk_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10160,"languageName":"Patpatar","languageEnglishName":"Patpatar"},"book":{"id":"PSA","translationId":"gfk_tbl","name":"Ninge","commonName":"Ninge","title":"IRA NINGE NA LOTU","order":19,"numberOfChapters":150,"sha256":"6d5a24890ba59b6f96dacf8429fe2051ca3f61ed14315a9c6e4fa91f090d3ec0","firstChapterNumber":1,"firstChapterApiLink":"/api/gfk_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gfk_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":150,"content":[{"type":"verse","number":1,"content":[{"text":"Da pirlat no Watong.","poem":1},{"lineBreak":true},{"text":"A pirhakasing tupas God aram narako tano uno hala na lotu.","poem":1},{"text":"A pirhakasing tupas ie aram ra mawe ing i hamines no uno dadas.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Da pirlat ie ta ira uno dadas na gingilaan.","poem":1},{"text":"Da pirlat ie kanong i manga tamat saakit.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Da pirlat ie ma no kinkel tano tahur.","poem":1},{"text":"Da pirlat ie ma ra haap ma ra gita.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Da pirlat ie ma ra kudu ma ra minangata.","poem":1},{"text":"Da pirlat ie ma tiga mangana gita ma ra tulaal.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Da pirlat ie ma ra pala karkar.","poem":1},{"text":"Da pirlat ie ma ra tamat na kinkel ta ira pala karkar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ira linge bakut ing diet manmanasung,","poem":1},{"text":"i tahut bia diet na pirlat no Watong.","poem":2},{"lineBreak":true},{"text":"Da pirlat no Watong.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gfk_tbl/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gfk_tbl/MAT/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gfk_tbl/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}