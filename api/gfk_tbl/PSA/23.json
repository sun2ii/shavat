{"translation":{"id":"gfk_tbl","name":"No Sigar Kunubus tika ma Ira Ninge na Lotu","website":"https://ebible.org/Scriptures/details.php?id=gfk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gfk","licenseNotes":null,"shortName":"TBL","englishName":"Patpatar NT and Psalms","language":"gfk","textDirection":"ltr","sha256":"4d2ca23b12dd64204813f4c77bb1d54fc768362e410bd3736643d297af93cb9b","availableFormats":["json"],"listOfBooksApiLink":"/api/gfk_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10160,"languageName":"Patpatar","languageEnglishName":"Patpatar"},"book":{"id":"PSA","translationId":"gfk_tbl","name":"Ninge","commonName":"Ninge","title":"IRA NINGE NA LOTU","order":19,"numberOfChapters":150,"sha256":"6d5a24890ba59b6f96dacf8429fe2051ca3f61ed14315a9c6e4fa91f090d3ec0","firstChapterNumber":1,"firstChapterApiLink":"/api/gfk_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gfk_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["Devit ga pit iakan ra ninge."]},{"type":"verse","number":1,"content":[{"text":"No Watong aie no nugu ut na harbalaurai. Iau pa ni supi baal um tiga linge.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"I la waak tar iau bia ni sangeh kai ra bilai na huro i nuhnuhuan.","poem":2},{"text":"I la lamlamus iau ta ira gagena ira taah ing i la salsaal kunkun.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"I la hasigarine habaling iau.","poem":2},{"text":"I la lulue iau ta ira ngaas na taktakodas","poem":1},{"text":"waing daga urur tana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ing mah bia iau haan","poem":1},{"text":"narako tano kankado na salil na minaat,","poem":2},{"text":"iau pa ni burte tiga saksakena.","poem":1},{"text":"Kanong warah, u sakate iau.","poem":2},{"text":"No num kapsil ma no num buko na harharahut,","poem":1},{"text":"dir habalaraan tar iau.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"U tagure tiga suuh na nian menalua tagu,","poem":1},{"text":"ra matmataan ta ira nugu ebar.","poem":2},{"text":"U puk no ulugu ma ra wel.","poem":1},{"text":"No nugu gingop i manga hung, gi bureng.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tutun saakit, a bilbilai ma ra harmarsai na mur iau","poem":1},{"text":"ta ira nugu bungbung na nilon bakut.","poem":2},{"text":"Ma iau ni kis hathatikai narako tano ngasina no Watong.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gfk_tbl/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gfk_tbl/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gfk_tbl/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}