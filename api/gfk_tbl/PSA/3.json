{"translation":{"id":"gfk_tbl","name":"No Sigar Kunubus tika ma Ira Ninge na Lotu","website":"https://ebible.org/Scriptures/details.php?id=gfk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gfk","licenseNotes":null,"shortName":"TBL","englishName":"Patpatar NT and Psalms","language":"gfk","textDirection":"ltr","sha256":"4d2ca23b12dd64204813f4c77bb1d54fc768362e410bd3736643d297af93cb9b","availableFormats":["json"],"listOfBooksApiLink":"/api/gfk_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10160,"languageName":"Patpatar","languageEnglishName":"Patpatar"},"book":{"id":"PSA","translationId":"gfk_tbl","name":"Ninge","commonName":"Ninge","title":"IRA NINGE NA LOTU","order":19,"numberOfChapters":150,"sha256":"6d5a24890ba59b6f96dacf8429fe2051ca3f61ed14315a9c6e4fa91f090d3ec0","firstChapterNumber":1,"firstChapterApiLink":"/api/gfk_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gfk_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["Devit ga pit iakan ra ninge na lotu. I hinhinawas utano pakana bung ing ga hilau pas ne Absalom no natine."]},{"type":"verse","number":1,"content":[{"text":"Watong, haleng saakit um diet malentakuane iau!","poem":1},{"text":"Haleng mah diet tut hut wara hinarubu ma iau!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Haleng diet tangtange utagu hoken,","poem":1},{"text":"“God pa na halon ie.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Iesen, Watong, augu tiga bahbahit luhutane iau.","poem":1},{"text":"U la sukal tar iau ma iau balaraan baling um.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Uram hono Watong iau manga suah,","poem":1},{"text":"ma i taram iau meram ra auno halhaliana uladih.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Iau noh suur ma iau kubaba.","poem":1},{"text":"Iau tangahun baling kanong warah no Watong i hadadas iau.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iau pa ni burte ira sangahul na arip ing diet hanuat luhutane iau wara suksukuane iau.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Watong, taman tut!","poem":1},{"text":"Halangalanga iau, nugu God!","poem":2},{"text":"Pasar ira iase diet ira nugu ebar.","poem":1},{"text":"Warat ira ngise diet ira ut na sakena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"A harhalon i la hanhanuat meram tano Watong.","poem":1},{"text":"Iau sasaring bia no num haraidaan na kis ta ira num matanaiabar.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gfk_tbl/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gfk_tbl/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gfk_tbl/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}