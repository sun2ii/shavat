{"translation":{"id":"gfk_tbl","name":"No Sigar Kunubus tika ma Ira Ninge na Lotu","website":"https://ebible.org/Scriptures/details.php?id=gfk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gfk","licenseNotes":null,"shortName":"TBL","englishName":"Patpatar NT and Psalms","language":"gfk","textDirection":"ltr","sha256":"4d2ca23b12dd64204813f4c77bb1d54fc768362e410bd3736643d297af93cb9b","availableFormats":["json"],"listOfBooksApiLink":"/api/gfk_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10160,"languageName":"Patpatar","languageEnglishName":"Patpatar"},"book":{"id":"PSA","translationId":"gfk_tbl","name":"Ninge","commonName":"Ninge","title":"IRA NINGE NA LOTU","order":19,"numberOfChapters":150,"sha256":"6d5a24890ba59b6f96dacf8429fe2051ca3f61ed14315a9c6e4fa91f090d3ec0","firstChapterNumber":1,"firstChapterApiLink":"/api/gfk_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gfk_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"No Watong i kap taman taar ma i sigasigam taar ma ra tamat na minamarine.","poem":1},{"text":"No Watong i sigasigam taar ma ra tamat na minamarine","poem":2},{"lineBreak":true},{"text":"ma i baan taar ma ra baso.","poem":2},{"text":"No Watong i te hakisi hadikdikit no ula hanuo,","poem":1},{"text":"ma pai tale bia na gunagune.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"U ga hakisi hadikdikit tar no num kinkinis na king nalua saakit.","poem":1},{"text":"U gabe lon menalua tano haburen ta ira pakana bung.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Watong, no tes i te tut,","poem":1},{"text":"i te raun haut no ingana.","poem":2},{"lineBreak":true},{"text":"Ira pakananoh diet te tut harmuri.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"No Watong nam naliu i dadas,","poem":1},{"text":"i dadas saakit tano wawaang ing no tes i suarlup,","poem":2},{"lineBreak":true},{"text":"i dadas saakit tano rarapus na tes.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Watong, ira num harkurai i tur dikdikit taar.","poem":1},{"text":"No num hala i maamar hatika taar ma ira num halhaliana magingin.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gfk_tbl/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gfk_tbl/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gfk_tbl/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}