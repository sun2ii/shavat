{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"1CH","translationId":"gmv_etw","name":"1ታሪኬ ማጻፋ","commonName":"1ታሪኬ ማጻፋ","title":"1ታሪኬ ማጻፋ","order":13,"numberOfChapters":29,"sha256":"c4a962cc2452cd77bf8ec212c802a2262c03ce6a54d826a11333eb32006dd26f","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/gmv_etw/1CH/29.json","totalNumberOfVerses":939},"chapter":{"number":11,"content":[{"type":"heading","content":["ዳዊቴ ካዎቴ"]},{"type":"verse","number":1,"content":["ሄሳፌ ጉዬ ኢስራኤሌ ኣሳይ ኡባይ ኢሲፌ ዳዊቴኮ ኬብሮኔ ቢዲ፥ «ኑኒ ኢሲ ኣሾኔ ኢሲ ሜቄ፤"]},{"type":"verse","number":2,"content":["ካሴ ሳኦሌ ካዎቴ ዎዴካ ኢስራኤሌ ኣሳ ኦላስ ካሌዳይ ኔና፤ ጎዳ ኔ ጾሳይ ኔና፥ ‹ታ ዴራ ኢስራኤሌ ኔኒ ሄማና፤ ኢስታ ቦላካ ኔኒ ካዎታና› ጊዴስ» ጊዳ።"]},{"type":"verse","number":3,"content":["ሄሳ ጊሻስ ኢስራኤሌ ጪማቲ ኡባይ ካዎ ዳዊቴኮ ኬብሮኔ ካታማ ዪዳ፤ ኢዚ ኢስታራ ኬብሮኔን ጎዳ ሲንን ጫቄቲዴስ፤ ጎዳይ ሳሜላ ባጋራ ሃሳይዳ ቃላ ማላ ዳዊቲ ኢስራኤሌ ቦላ ካዎታና ማላ ቲይዳ።"]},{"type":"heading","content":["ዳዊቲ ዬሩሳላሜ ኦይኪዴስ"]},{"type":"verse","number":4,"content":["ዳዊቲኔ ኢስራኤሌ ኣሳይ ኡባይ ዬሩሳላሜ ካታማ ቢዳ፤ ሄ ዎዴ ያቡሴ ኣሳቲ ሄን ዲዛ ጊሻስ ሄ ካታማያ ያቡሴ ጌቴታዉስ።"]},{"type":"verse","number":5,"content":["ያቡሴ ኣሳቲ ዳዊቴ፥ «ኔኒ ሃ ካታማ ሙሌካ ጌላካ» ጊዳ፤ ጊዲኮካ ዳዊቲ ጺዮኔን ዲዛ ኢስታ ሚጻ ኦይኪዴስ፤ ሂስቲን ኢዛ ዳዊቴ ካታማ ጌቴታዱስ።"]},{"type":"verse","number":6,"content":["ዳዊቲ፥ «ኮይሮቲ ቢዲ ያቡሴ ኣሳታ ሾጪዛዴይ ኦላ ጋዳዋ ጊዳና» ጊዴስ፤ ሂስቲን ጹሪያ ና ኢዮኣቤይ ኮይሮቲ ቢ ኦሊዳ ጊሻስ ኦላ ጋዳዋ ጊዲዴስ።"]},{"type":"verse","number":7,"content":["ዳዊቲ ሄ ሚጻዮ ባስ ዱሳሶ ሂስቲዳ ጊሻስ ሚጻያ ዳዊቴ ካታማ ጌቴታዱስ።"]},{"type":"verse","number":8,"content":["ዳዊቲ ሄ ካታማይ ዩሾን ኬቻታ ኬጪዲ ካታማዮ ዛሪ ኬጺዴስ፤ ኣቲዳ ካታማ ቃሴ ኢዮኣቤይ ዛሪዲ ኬጺዴስ።",{"noteId":2}]},{"type":"verse","number":9,"content":["ኡባፌ ዎልቃማ ጎዳይ ኢዛራ ዲዛ ጊሻስ ዳዊቲ ሚኒ ሚኒ ቢዴስ።"]},{"type":"heading","content":["ሚኖ ጊዲዳ ዳዊቴ ኦላንቻታ"]},{"type":"verse","number":10,"content":["ሚኖ ጊዲዳ ዳዊቴ ኦላንቻቲ ሃይሳፌ ካሊዲ ጻፌቲዳ፤ ኢስቲካ ሃንኮ ኢስራኤሌ ኣሳታራ ጊዲዲ ጎዳይ ኢዛስ ኢሚዳ ሂዶታ ቃላ ማላ ኢዛ ካዎቴይ ኣካና ማላ ኬሂ ማዲዳኔ ሚንዳ።"]},{"type":"verse","number":11,"content":["ሚኖ ጊዲዳ ዳዊቴ ኦላንቻታፔ ኮይሮይሲ ሃኪሞኔ ዛርኬፌ ጊዲዳ ያሾቢኣሜ፤ ኢዚ ኦላ ጋዳዋ ሄታስ ሃላቃ፤ ኢዚ ኢሲቶ ኦላን 300 ኣስ ዎዴስ።"]},{"type":"verse","number":12,"content":["ሄ ሄ ሚኖ ኦላንቻታፔ ናምኣንዚ ኣሂሆሄ ዛርኬፌ ዶዴ ና ኤልኤዜሬ።"]},{"type":"verse","number":13,"content":["ፊሊስጼሜ ኣሳቲ ኦሌታናስ ኤፍሲ-ዴሚሜ ጌቴቲዛሶ ሺቂዳ ዎዴ ኣላዛሬይ ዳዊቴራ ኢሲፌ ዴስ፤ ባንጋይ ኩሚዳ ጎሻ ጋዴ ጊዶን ኢስራኤሌ ኦላንቻቲ ፊሊስጼሜታ ሲንፌ ባቃቲዳ።"]},{"type":"verse","number":14,"content":["ጊዶ ኣቲን ኢዚኔ ኢዛ ካሊዛይቲ ሄን ሶሆ ኦይኪዲ ፊሊስጼሜ ኣሳታራ ኤቄቲዳ፤ ጎዳይ ኢስታስ ዎልቃማ ጾኖ ኢሚዴስ።"]},{"type":"verse","number":15,"content":["ፊሊስጼሜ ኦላንቻቲ ኤራፋይሜ ሾባን ዱንካኒ ዲዛ ዎዴ 30 ሃላቃታፔ ሄቲ ዳዊቲ ዲዛሶ ኣዱላሜ ጎንጎሎ ማታን ዲዛ ዛላኮ ዎዳ።"]},{"type":"verse","number":16,"content":["ሄ ዎዴ ዳዊቲ ሚጻ ጊዶን ዴስ፤ ፊሊስጼሜ ኦላንቻታ ቡቴይ ቤቴሊሄሜን ዴስ።"]},{"type":"verse","number":17,"content":["ዳዊቲ ሃ ኡያናስ ኣሞቲዲ፥ «ቤቴሊሄሜ ካታማ ፔንጌ ላንቄን ዲዛ ፑልቶ ሃፌ ታና ኦኔ ኡሻናይ!» ጊዴስ።"]},{"type":"verse","number":18,"content":["ሄ ሚኖ ዳዊቴ ኦላንቻቲ ፊሊስጼሜ ኣሳቲ ዱንካኒ ኡቲዳሶሆራ ካን ቢዲ ቤቴሊሄሜ ካታማ ፔንጌን ዲዛ ፑልቶዛፔ ሃ ዱቂዲ ዳዊቴስ ኤሂዳ፤ ጊዶ ኣቲን ዳዊቲ ኡዮንታ ኢጺዲ ሄ ሃ ጎዳ ሲንን ጉሲዴስ።"]},{"type":"verse","number":19,"content":["ሂስቲዲ፥ «ሃይሳ ማላ ኦሶፔ ታና ጾሲ ናጎ! ታ ሃይሳ ኡይኮ ባ ሼምፖ ባይዚዲ ኤሂዳ ኣሳታ ሱ ኡሻ ማላ ጊዴኔ?» ጊዴስ፤ ሄሳ ጊሻስ ዳዊቲ ሄ ሃ ኡዪቤና፤ ሄ ሄ ሚኖ ኦላንቻቲ ሄሳ ኦዳ።"]},{"type":"verse","number":20,"content":["ኢዮኣቤ ኢሻ ኣቢሳዬይ ሄታስ ሃላቃ፤ ኢዚ ባ ቶራን 300 ኣሳታ ኦሊ ዎዴስ፤ ሄሳ ጋሶን ኢዚካ ሄታ",{"noteId":3},"ማላ ኤሬቲዴስ።"]},{"type":"verse","number":21,"content":["ኢዚ ሄታራ ቆዴቶንታ ኣጊኮካ ኢስታፌ ኣዳ ቦንቾ ዴሚዴስ፤ ኢስታስካ ሃላቃ ጊዲዴስ።"]},{"type":"verse","number":22,"content":["ቃብጺኤሌፔ ዪዳ ዮዳሄ ና ባናያይ ኤሬቲዳ ኦላንቻኔ ዎልቃማ ሚሽ ኦዳ ኣሳ፤ ኢዚ ናምኡ ኤሬቲዳ ሞኣቤ ቢታ ኣሳታ ዎዴስ፤ ቃሴ ሻቺ ዳሪዳ ኢሲ ጋላስ ጎንጎሎ ጊዶ ጌሊዲ ጋሞ ዎዴስ።"]},{"type":"verse","number":23,"content":["ባናያይ ኢዛስ ጌሳይ ኢቻሹ ዋ ጊዲዛ ጊብጼ ቢታ ኣስ ዎዴስ፤ ሄ ጊብጼ ኣዴዛ ኩሼን ሼማኔ ዎንዲራሼ ኬና ቶራይ ዴስ፤ ባናያይ ጊዲኮ ጉፌ ኦይኪ ቢዲ ኢዛ ኩሼን ዲዛ ቶራ ዳፊ ኤኪዲ ኢዛ ቶራን ኢዛ ዛሪ ዎዴስ።"]},{"type":"verse","number":24,"content":["ዮዳሄ ና ባናያይ ሃይታንታ ኦዴስ፤ ኢዚካ ሄታ ማላ ኤሬቲዳ ኣስ ጊዲዴስ።"]},{"type":"verse","number":25,"content":["ኢዚ ሄታራ ቆዴቶንታ ኣጊኮካ 30 ኦላንቻታፔ ኣ ቦንቼቲዴስ፤ ዳዊቲ ኢዛ ባና ናጊዛይታ ቦላ ሃላቃ ሂስቲ ሹሚዴስ።"]},{"type":"verse","number":26,"content":["ኣሳ ጊዶን ዲዛ ሚኖ ኦላንቻቲ ሃይሳፌ ካሊ ዲዛይታ፥",{"text":"ኢዮኣቤ ኢሻ ኣሳሄሌ፥","poem":1},{"text":"ቤቴሊሄሜ ኣስ","poem":2},{"lineBreak":true},{"text":"ዶዴ ና ኤልያኔ፥","poem":2}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ሃሮዴ ኣስ ሻሞቴ፥","poem":2},{"lineBreak":true},{"text":"ፒሎኔ ኣስ ሄሌጼ፥","poem":2}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"ቴቁሄ ኣስ ኢቄሻ ና ኢራ፥","poem":2},{"lineBreak":true},{"text":"ኣናቶቴ ኣስ ኣቢኤዜሬ፥","poem":2}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"ሁሼ ኣስ ሲቢካዬ፥","poem":2},{"lineBreak":true},{"text":"ኣሂሆሄ ኣስ ኤላዬ፥","poem":2}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"ናጾፌ ኣስ ማሂራዬ፥","poem":2},{"lineBreak":true},{"text":"ናጾፌ ኣስ ባኣና ና ሄሌዴ፥","poem":2}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"ቢኒያሜ ዛርኬፌ ጊቢኣ ኣስ","poem":2},{"lineBreak":true},{"text":"ኤሪባዬ ና ኢታዬ፥","poem":2},{"lineBreak":true},{"text":"ፒራቶኔ ኣስ ባናያ፥","poem":2}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"ጋኣሼ ሾባ ኣስ ሁራዬ፥","poem":2},{"lineBreak":true},{"text":"ኣራቤ ኣስ ኣቢኤሌ፥","poem":2}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"ባሂሩሜ ኣስ ኣዚሞቴ፥","poem":2},{"lineBreak":true},{"text":"ሻልቦኔ ኣስ ኤሊያሂቤ፥","poem":2}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"ጊዞኔ ኣስ ሃሼሜ፥","poem":2},{"lineBreak":true},{"text":"ሃራሬ ዴሬ ኣስ","poem":2},{"lineBreak":true},{"text":"ሻጌ ና ዮናታኔ፥","poem":2}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"ሃራሬ ዴሬ ኣስ","poem":2},{"lineBreak":true},{"text":"ሳካሬ ና ኣሂኣሜ፥","poem":2},{"lineBreak":true},{"text":"ኡሬ ና ኤልፋሌ፥","poem":2}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"ማኬሬ ዴሬ ኣስ ሄፌሬ፥","poem":2},{"lineBre