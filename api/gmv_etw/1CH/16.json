"ኢዚ ኦዳ ኡባ","poem":2},{"lineBreak":true},{"text":"ካዎቴታስ ዮቲቴ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኢዛ ሳቢቴ፤","poem":1},{"text":"ጋላታ ዬካ ኢዛስ ዬጺቴ፤","poem":2},{"lineBreak":true},{"text":"ኢዚ ኦዳ ማላሊሲዛ ኦሶ","poem":2},{"lineBreak":true},{"text":"ኡባ ዮቲቴ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኢዛ ጌሻ ሱንን","poem":1},{"text":"ቦንቺቴ፤","poem":2},{"lineBreak":true},{"text":"ጎዳ ኮይዛይታ","poem":2},{"lineBreak":true},{"text":"ዎዚናይ ኡፋዬቶ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጎዳኔ ኢዛ ዎልቃ ጾሞሲቴ፤","poem":1},{"text":"ኡባ ዎዴ ኢዛ ኮዪቴ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኢዚ ኦዳ ማላሊሲዛ ኦሶታ፥","poem":1},{"text":"ማላታታኔ ኢዛ ፒርዳ ኣኬኪቴ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኢንቴኖ ጾሳ ኣይሌ","poem":1},{"text":"ኢስራኤሌ ዜሬቶ!","poem":2},{"lineBreak":true},{"text":"ኢንቴኖ ዶሬቲዳ","poem":2},{"lineBreak":true},{"text":"ያቆቤ ናይቶ!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኢዚ ጎዳይ ኑ ጾሳ፤","poem":1},{"text":"ኢዛ ፒርዳይ ኡባ ቦላና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ባ ጫቂዳ ቃላ ሜርናስ፥","poem":1},{"text":"ባ ኣዛዚዳይሳካ ሺ ዬሌታ","poem":2},{"lineBreak":true},{"text":"ጋካናስ ቆፔስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኣብራሃሜስ ጫቂዳ ጫቃ፥","poem":1},{"text":"ዪሳቃስ ኢሚዳ ሂዶታ ቃላ፥","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ያቆቤስ ዎጋ ጊዳና ማላ፥","poem":2},{"lineBreak":true},{"text":"ኢስራኤሌሲካ ሜርና ጫቆ","poem":2},{"lineBreak":true},{"text":"ቃላ ጊዳና ማላ ሚንዴስ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"«ካናኔይ ኔስ","poem":1},{"text":"ጺንጾ ጊዳና ማላ","poem":2},{"lineBreak":true},{"text":"ታ ኔና ላቲሳና» ጊዴስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ኢስቲ ቆዳን ጉ ጊዲ ዲዛ ዎዴ፥","poem":1},{"text":"ዴራሲካ ኢማ ጊዲ ዲዛ ዎዴ፥","poem":2}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ኢሲ ዴሬፔ ሃራ ዴሬ፥","poem":2},{"lineBreak":true},{"text":"ኢሲ ካዎቴፌ","poem":2},{"lineBreak":true},{"text":"ሃራ ካዎቴ ቶይላቲዳ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ኦኒካ ኢስታ ኡንኤና ማላ","poem":1},{"text":"ኣ ኢሚቤና፤","poem":2},{"lineBreak":true},{"text":"ኢስታ ጊሻስ ካዎታ ሴሪዴስ፤","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"«ታ ቲይዳይታ ቦቾፍቴ፤","poem":2},{"lineBreak":true},{"text":"ታ ናቤታ ቆሆፒቴ» ጊዴስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ቢታ ኡባይ ጎዳስ ዬጺቴ፤","poem":1},{"text":"ኢዚ ኣሺዛይሳ","poem":2},{"lineBreak":true},{"text":"ሃች ሃች ዮቲቴ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ካዎቴታስ","poem":1},{"text":"ኢዛ ቦንቾ ኣዋጂቴ፤","poem":2},{"lineBreak":true},{"text":"ኢዚ ኦዳ ማላሊሲዛ","poem":2},{"lineBreak":true},{"text":"ሚሻታ ዴሬ","poem":2},{"lineBreak":true},{"text":"ኡባስ ዮቲቴ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ጎዳይ ጊታ፤","poem":1},{"text":"ኢዛስ ቤሲዛ ጋላታይካ ቃ፤","poem":2},{"lineBreak":true},{"text":"ጾሳታ ኡባፌ ኣስ፤","poem":2},{"text":"ኢዛስ ያያናስ ቤሴስ።","poem":3}]},{"type":"verse","number":26,"content":[{"text":"ኣይዛቤታ ጾሳቲ","poem":1},{"text":"ኡባይ ኤቃ ጾሳታ፤","poem":2},{"lineBreak":true},{"text":"ጎዳይ ጊዲኮ","poem":2},{"lineBreak":true},{"text":"ሳሎታ ሜዳ ጾሳ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ቦንቾይኔ ቴማይ ኢዛስ ዴስ፤","poem":1},{"text":"ሚኖቴኔ ኡፋይሲ","poem":2},{"lineBreak":true},{"text":"ኢዛ ኬን ዴስ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ኢንቴኖ ኣሳ ዛሬ ኡባቶ!","poem":1},{"text":"ጎዳ ሳቢቴ፤","poem":2},{"lineBreak":true},{"text":"«ቦንቾይኔ ዎልቃይ","poem":2},{"lineBreak":true},{"text":"ጎዳሳ» ጊ ዮቲቴ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ጎዳ ሱንስ ቤሲዛ","poem":1},{"text":"ቦንቾ ኢሚቴ፤","poem":2},{"lineBreak":true},{"text":"ያርሾ ኤኪዲ ኢዛ ሲን ሺቂቴ፤","poem":2},{"lineBreak":true},{"text":"ኢዛ ጌሻቴ ቦንቾ","poem":2},{"lineBreak":true},{"text":"ጊሻስ ጎዳስ ጎይኒቴ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ቢታን ዲዛ ኣስ ኡባይ","poem":1},{"text":"ኢዛ ሲንን ኮኮሪቴ፤","poem":2},{"lineBreak":true},{"text":"ሳኣይ ሚኒ ኤቂዴስ፤","poem":2},{"lineBreak":true},{"text":"ሙሌካ ቃጼና።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ሳሎቲ ኡፋዬቴቶ!","poem":1},{"text":"ሳኣይካ ሃሹ ጎ!","poem":2},{"lineBreak":true},{"text":"ካዎቴታ ጊዶን ኢስታስ፥","poem":2},{"lineBreak":true},{"text":"«ጎዳይ ካዎቲዴስ!» ጌቶ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ኣባይኔ ኢዛ ጊዶን ዲዛ","poem":1},{"text":"ኡባይ ጉሜቶ፤","poem":2},{"lineBreak":true},{"text":"ዴምባቲኔ ኢስታ ቦላ ዲዛ","poem":2},{"lineBreak":true},{"text":"ኡባቲ ኡፋዬቴቶ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ኢዚ ቢታ ቦላ ፒርዳናስ ያና።","poem":1},{"text":"ሄ ዎዴ ዎራ ሚቲ","poem":2},{"lineBreak":true},{"text":"ጎዳ ጾሳ","poem":2},{"lineBreak":true},{"text":"ሲንን ኡፋይሳን ዬጻና።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ጎዳይ ኪያ፤","poem":1},{"text":"ኢዛ ማሮቴይካ ሜርናሳ፤","poem":2},{"lineBreak":true},{"text":"ሄሳ ጊሻስ ጎዳ ጋላቲቴ።","poem":2}]},{"type":"verse","number":35,"content":[{"text":"«ኣቤት ኑና ኣሺዛ ጎዳዉ!","poem":1},{"text":"ኑና ኣሻ፤","poem":2},{"lineBreak":true},{"text":"ኔ ጌሻ ሱን","poem":2},{"lineBreak":true},{"text":"ኑ ጋላታና ማላ፥","poem":2},{"text":"ኑ ኔና ጋላታን","poem":3},{"lineBreak":true},{"text":"ቦንቻና ማላ","poem":3},{"lineBreak":true},{"text":"ካዎቴታ ጊዶፌ ኑና","poem":3},{"lineBreak":true},{"text":"ሺሻዳ ኣሻ» ጊቴ።","poem":3}]},{"type":"verse","number":36,"content":[{"text":"ጎዳ ኢስራኤሌ ጾሳይ","poem":1},{"text":"ሜርናፔ ሜርና ጋካናስ ጋላቴቶ!","poem":2},"ሄሳፌ ጉዬ ዴሬ ኡባይ፥ «ኣሚን» ጊዲ ጎዳ ጋላቲዴስ።"]},{"type":"heading","content":["ዬሩሳላሜኒኔ ጌባኦኔን ሃኒዳ ጎይኖ ማራ"]},{"type":"verse","number":37,"content":["ጎዳ ታቦታ ሲንን ሃች ሃች ጎይኖስ ኮሺዛዝ ኡባ ዎዴ ኢስቲ ኦና ማላ ዳዊቲ ኣሳፌኔ ኢዛ ዳቦታ ዎዴስ።"]},{"type":"verse","number":38,"content":["ቃሴካ ኦቤድ-ኤዶሜኔ ኢዛ ዳቦታ ኡሱፑን ታማኔ ኦስፑናታ ኢስታራ ኦና ማላ ዎዴስ፤ ኤዶታኔ ና ኦቤድ-ኤዶሜኔ ሆሳ ዲርሳ ፔንጌ ናጋና ማላ ዎዴስ።"]},{"type":"verse","number":39,"content":["ቄሴ ሳዶቄኔ ኢዛራ ኦዛ ቄሴቲ ጌባኦኔን ቃሶሆን ዲዛ ጎዳ ዱንካኔዛ ሲንን ኦና ማላ ሄን ዎዴስ።"]},{"type":"verse","number":40,"content":["ጋሶይካ ጎዳይ ኢስራኤሌስ ኢሚዳ ዎጋ ማላ ኢስቲ ኡባ ዎዴ ጹጌቲዛ ያርሾይ ያርሼቲዛሶን ማላዶኔ ኦማርስ ጹጌቲዛ ያርሾ ያርሻናሳ።"]},{"type":"verse","number":41,"content":["ኢዛ ማሮታይ ሜርናስ ጊዲዳ ጊሻስ ጎዳ ጋላታና ማላ ሄማኔ፥ ኤዶታኔኔ ዶሬቲዳ ሃራታ ዳዊቲ ኢስታራ ኢሲፌ ኤሲዴስ።"]},{"type":"verse","number":42,"content":["ሄማኔሲኔ ኤዶታኔስ ጹሩምባ ፑናናስ፥ ዳላ ጊሪሳናሲኔ ዬ ዬጺሼ ጎኤቲዛ ሃራ ማሳራታ ቦላ ኣዋቴ ኢስታስ ኢሜቲዴስ፤ ኤዶታኔ ናይቲ ዲርሳ ፔንጌ ናጋና ማላ ኣላፌቴ ኢሜቲዴስ።"]},{"type":"verse","number":43,"content":["ሄሳፌ ጉዬ ኡባ ኣሳይ ባሶ ባሶ ቢዴስ፤ ዳዊቲካ ባሶ ኣሳ ኣንጃናስ ሶ ሲሚዴስ።"]}],"footnotes":[{"noteId":5,"caller":"+","text":"16፡3 ኮምፓ ጌቴቲዛይሲ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ቦ ዎይኮ ሊቻኮ ጌቴቴስ።","reference":{"chapter":16,"verse":3}},{"noteId":6,"caller":"+","text":"16፡5 ዳላ ጊዛይሲ ጺናጺሌ ጊዛይሳ ቤሴስ።","reference":{"chapter":16,"verse":5}}]},"thisChapterLink":"/api/gmv_etw/1CH/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/1CH/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/1CH/15.json","previousChapterAudioLinks":{},"numberOfVerses":43}