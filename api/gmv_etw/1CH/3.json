e":"verse","number":18,"content":["ማሊክራሜ፥ ፓዳያ፥ ሼናጻሬ፥ ዪቃሚያ፥ ሆሻሜኔ ናዳቢያ ጌቴቲዛይታ።"]},{"type":"verse","number":19,"content":["ፓዳያይ ዜሩባቤሌኔ ሺምኤ ዬሊዴስ፤ ዜሩባቤሌይካ ማሹላሜ፥ ሃናኒያኔ ኢስታ ሚቾ ሻሎሚቶ ዬሊዴስ።"]},{"type":"verse","number":20,"content":["ቃሴካ ሃራ ኢቻሽ ኣቱማ ናይቲ ኢዛስ ዴቴስ፤ ሄይቲካ ሃሹቤ፥ ኦሄሌ፥ ባራካዬ፥ ሃሳዲያኔ ዮሻቢ-ሄሲዴ።"]},{"type":"verse","number":21,"content":["ሃናኒያይ ፓላጺያኔ ዬሻኢያ ጌቴቲዛ ናምኡ ኣቱማ ናይታ ዬሊዴስ፤ ዬሻኢያይካ ኤራፋያ ዬሊዴስ፤ ኤራፋያይ ኦርናኔ ዬሊዴስ፤ ኦርናኔይ ኣብዲዩ ዬሊዴስ፤ ኣብዲዩይ ሻካኒያ ዬሊዴስ።"]},{"type":"verse","number":22,"content":["ሻካኒያይካ ሻማኤ ዬሊዴስ፤ ሻማኤይ ሃጹሼ፥ ዪጊኣሌ፥ ባርያሄ፥ ናራያኔ ሳፋጼ ጌቴቲዛይታ 5 ኣቱማ ናይታ ዬሊዴስ፤ ሻካኒያ ዜሬቲ ኩሜ ኡሱፑና።"]},{"type":"verse","number":23,"content":["ናራያይ ኤልዮኤናዬ፥ ሂዝቂያሳኔ ኣዚርቃሜ ጌቴቲዛ 3 ኣቱማ ናይታ ዬሊዴስ።"]},{"type":"verse","number":24,"content":["ኤልዮኤናዬይ ሆዳዬ፥ ኤልያሼቤ፥ ፔላያ፥ ኣቁቤ፥ ዮሃናኔ፥ ዳላያኔ ኣናኔ ጌቴቲዛ 7 ኣቱማ ናይታ ዬሊዴስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/1CH/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/1CH/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/1CH/2.json","previousChapterAudioLinks":{},"numberOfVerses":24}