{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"1JN","translationId":"gmv_etw","name":"1ዮሃኒሳ ኪታ","commonName":"1ዮሃኒሳ ኪታ","title":"ዮሃኒሲ ጻፊዳ ኮይሮ ኪታ","order":62,"numberOfChapters":5,"sha256":"7e6169c4394cdbd9023b620c532f6eaba7c23bd507043e7aff7d5862c0105ebd","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/1JN/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/gmv_etw/1JN/5.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"heading","content":["ዴኦ ቃላ"]},{"type":"verse","number":1,"content":["ዴኦ ቃላ ጊሻስ ኮይሮፔ ዲዛይሳ ኑኒ ኑ ሃይን ሲዪዳይሳኔ ኑ ኣይፌራ ቤኢዳይሳ ሎኤ ጼሊዳይሳ፥ ኑ ኩሼራ ኦይኪ ቤኢዳይሳ ጊሻስ ሃሳዮስ።"]},{"type":"verse","number":2,"content":["ዴኦይካ ቆንጪዴስ፤ ኑኒካ ኑ ኣይፌራ ቤኢዲ ማርካቶስ። ኢዛስ ኢዛ ኣዋ ኣቻን ዲዛይሳኔ ኑስካ ቆንጪዳ ሜርና ዴኦ ጊሻስ ኑ ኢንቴስ ዮቶስ።"]},{"type":"verse","number":3,"content":["ኢንቴስካ ኑናራ ኢሲፌቴ ዳና ማላ ኑኒ ቤኢዳይሳኔ ሲዪዳይሳ ኢንቴስ ዮቶስ፤ ኑ ኢሲፌቴይካ ኣዋራኔ ኢዛ ና ዬሱስ ኪርስቶሳራ።"]},{"type":"verse","number":4,"content":["ኑ ኡፋይሳይ",{"noteId":0},"ኩሜ ጊዳና ማላ ኑ ሃይሳ ኢንቴስ ጻፎስ።"]},{"type":"heading","content":["ፖኦን ሲሜሬቴ"]},{"type":"verse","number":5,"content":["ኑ ኢዛፔ ሲዪዲ ኢንቴስ ዮቲዛ ኪታይ፥ «ጾሲ ፖኦ፤ ኢዛ ኣቻን ሙሌካ ማይ ዴና» ጊዛይሳ።"]},{"type":"verse","number":6,"content":["«ኑ ማን ሲሜሬቲሼ ኢዛራ ኑስ ኢሲፌቴ ዴስ» ጊኮ ዎርዶቶስ ኣቲን ቱማን ዶኮ።"]},{"type":"verse","number":7,"content":["ጊዶ ኣቲን ኢዚ ፖኦን ዲዛ ማላ ኑኒካ ፖኦን ሲሜሬቲኮ ኑ ጋርሳን ኑስ ኢሲፌቴ ዴስ፤ ኢዛ ና ዬሱስ ኪርስቶሳ ሱ ኑና ናጋራ ኡባፌ ጌሼስ።"]},{"type":"verse","number":8,"content":["ኑኒ ኑናን ናጋራይ ባ ጊኮ ኑርካ ኑና ባሌስ፤ ቱማይካ ኑናን ዴና።"]},{"type":"verse","number":9,"content":["ኑኒ ኑ ናጋራ ፓጺኮ ኢዚ ኑ ናጋራ ኣቶ ጋናሲኔ ኑ ቆሆፔ ኑና ዉርሲ ጌሻናስ ኢዚ ኣማኔቲዳዴኔ ጺሎ።"]},{"type":"verse","number":10,"content":["ኑኒ ናጋራ ኦቤኮ ጊኮ ኢዛ ኑ ዎርዳንቻ ኬሶሲኔ ኢዛ ቃላይካ ኑናን ዴና።"]}],"footnotes":[{"noteId":0,"caller":"+","text":"1፡4 ኑ ኡፋይሳይ፡ ኑ ኡፋይሳይ ጊዛይሲ ኢሲ ኢሲ ቢርሼታን ኢንቴ ኡፋይሳይ ጌቴቲዴስ።","reference":{"chapter":1,"verse":4}}]},"thisChapterLink":"/api/gmv_etw/1JN/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/1JN/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/2PE/3.json","previousChapterAudioLinks":{},"numberOfVerses":10}