{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"1TI","translationId":"gmv_etw","name":"1ጺምቶሳስ","commonName":"1ጺምቶሳስ","title":"ጳዉሎሲ ጺምቶሳስ ጻፊዳ ኮይሮ ኪታ","order":54,"numberOfChapters":6,"sha256":"226603411990625e1658c73fe7f11e12f8531770a7cc6533fcbe0167f71fc22e","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/1TI/1.json","lastChapterNumber":6,"lastChapterApiLink":"/api/gmv_etw/1TI/6.json","totalNumberOfVerses":113},"chapter":{"number":3,"content":[{"type":"heading","content":["ዎሳ ኬ ካሌዛይታ"]},{"type":"verse","number":1,"content":["«ኦኒካ ዎሳ ኬ ጪማ ጊዳና ኮይኮ ሎኦ ኦሶ ኣሞቴስ» ጊዛ ቃላይ ቱማ።"]},{"type":"verse","number":2,"content":["ሄሳ ጊዲኮ ዎሳ ኬ ካሌዛዴይ ቦሬይ ባይንዳዴ፥ ኢሲ ማቻ ዲዛ ኣዴ፥ ጊናራ ዲዛዴ፥ ባና ሃሪዛዴ፥ ዎጋራ ኣቂዛዴ፥ ኢማ ሞኪዛዴ፥ ታማርሳናስ ዳንዳይዛዴ፥"]},{"type":"verse","number":3,"content":["ማቶንታዴ፥ ኦሽ ኦዬቶንታዴ፥ ቃሴ ማራጌ ኣስ፥ ኣሳራ ፓላሜቶንታዴ፥ ሚሽ ጎዶንታዴ ጊዳናስ ቤሴስ።"]},{"type":"verse","number":4,"content":["ባ ናይታ ኣዛዜቲዛይታኔ ኣስ ቦንቺዛይታ ሂስቲ ዲቺዲ ባ ኬ ኣሳ ዎጋራ ኣይሲዛዴ ጊዳናስ ቤሴስ።"]},{"type":"verse","number":5,"content":["ኢሳዴይ ባ ኬ ኣሳ ዎጋራ ኣይሶ ኤሮንታ ኣጊኮ ጾሳ ዎሳ ኬ ዎስቲ ናጋና ዳንዳይዜ?"]},{"type":"verse","number":6,"content":["ኦቶሬቴን ፑሪዲ ጻላኤይ ኩንዲዳ ፒርዳን ኢዚ ኩንዶንታ ማላ ኦራ ኣማኒዛዴ ጊዶፖ።"]},{"type":"verse","number":7,"content":["ቃሴካ ኢዛ ሱንን ቦሬቶንታ ማላኔ ጻላኤ ናርጻን ኢዚ ጌሎንታ ማላ ኣማኖንታ ኣሳ ኣቻን ሎኦ ማርካቴ ዳናስ ኮሼስ።"]},{"type":"verse","number":8,"content":["ዳቆኔቲካ ሄሳ ቦንቼቲዳይታኔ ባ ጊዳ ቃላ ላሚ ላሚ ዬጎንታይታ፥ ዳሮ ዎይኔ ኡሻስ ኣሞቶንታይታ፥ ኦጌይ ባይንዳ ጎኣ ጎዶንታይታ ጊዳናስ ቤሴስ።"]},{"type":"verse","number":9,"content":["ኣማኖ ጹራ፥ ሎኦ ቆፋራ ናጋናስ ቤሴስ።"]},{"type":"verse","number":10,"content":["ሃይታንቲካ ኮይሮቲ ፓጬቴቶ፤ ኢሲ ኢታይ ኢስታ ቦላ ቤቶንታ ኣጊኮ ሄሳፌ ጉዬ ዳቆኔቴን ኦቶ።"]},{"type":"verse","number":11,"content":["ማጫ ዳቆኔቲካ ቦንቼቲዳይታ፥ ዚጊሮንታይታ፥ ቃሴ ዎጋራ ዲዛይታ፥ ሃኖ ኡባን ኣማኔቲዳይታ ጊዳናስ ቤሴስ።"]},{"type":"verse","number":12,"content":["ዳቆኔቲ ኢሲ ማቺ ኣዚና ጊዳናስ ቤሴስ፤ ቃሴካ ባ ናይታኔ ባ ኬ ኣሳ ዎጋራ ኣይሲዛይታ ጊዳናስ ቤሴስ።"]},{"type":"verse","number":13,"content":["ዎጋራ ኦዳይቲ ባስ ጊታ ቦንቾኔ ዬሱስ ኪርስቶሳን ኢስታስ ዲዛ ኣማኖን ዳሮ ጻላቴ ዴማና።"]},{"type":"verse","number":14,"content":["ታ ኔኮ ኤሌ ባና ኮይኮካ ሃይታ ኣዛዞታ ኔስ ጻፋይስ።"]},{"type":"verse","number":15,"content":["ታ ሃኖ ኔስ ጻፊዛይ ታ ጋምኢዛ ጊዲኮካ ኣሳይ ጾሳ ኬን ዋኒ ዳናኮ ኔ ኤራና ማላ ጋዳኮ! ኬይ ዴኦ ጾሳ ዎሳ ኬ፤ ሄሲካ ቱሙ ቱሲኔ ጻጶ።"]},{"type":"verse","number":16,"content":["ቱሙ ኣያና ዱሳ ጹራይ ሲይ ባይንዳ ጊታ፤ ኢዚካ፥",{"text":"«ኣሴ ጊዲዴስ፤","poem":1},{"text":"ኢዛ ጺሎቴ","poem":2},{"lineBreak":true},{"text":"ጺሎ ኣያናን ቆንጪዴስ፤","poem":2},{"lineBreak":true},{"text":"ኪታንቻታስ ቤቲዴስ፤","poem":2},{"lineBreak":true},{"text":"ዴሬ ኡባስ ሳባኬቲዴስ፤","poem":2},{"lineBreak":true},{"text":"ኣላሜን ዲዛይታን ኣማኔቲዴስ፤","poem":2},{"lineBreak":true},{"text":"ቦንቾራ ፑዴ ዴንዲ ቢዴስ» ጊዛይሳ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/1TI/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/1TI/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/1TI/2.json","previousChapterAudioLinks":{},"numberOfVerses":16}