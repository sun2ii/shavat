{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"2KI","translationId":"gmv_etw","name":"2ካዎታ ማጻፋ","commonName":"2ካዎታ ማጻፋ","title":"2ካዎታ ማጻፋ","order":12,"numberOfChapters":25,"sha256":"69d4b53c2e7eb0413e7cd3f78aaec773ed4d9bcde0185851288db86af68722b2","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/2KI/1.json","lastChapterNumber":25,"lastChapterApiLink":"/api/gmv_etw/2KI/25.json","totalNumberOfVerses":719},"chapter":{"number":19,"content":[{"type":"heading","content":["ካዎ ሂዝቂያሲ ናቤ ኢሳያሳ ኦይቺዳ ዞሬ"]},{"type":"verse","number":1,"content":["ካዎ ሂዝቂያሲ ሄሳ ሲዪዲ ባ ማይኦ ዳኪዴስ፤ ማቃ ማይኢዲ ጾሳ ኬ ጌሊዴስ።"]},{"type":"verse","number":2,"content":["ሄሳፌካ ካዎቴ ኬን ኣዛዚዛ ኤልያቄሜይ፥ ጻፌ ሼቢናይኔ ዋና ቄሴቲ ማቃ ማይኢዲ ኣሞጼ ና ናቤ ኢሳያሳኮ ባና ማላ ኡባ ኪቲ ዬዲዴስ።"]},{"type":"verse","number":3,"content":["ኢስቲካ ኢዛስ፥ «ሂዝቂያሲ፥ ‹ሃና ጋላሳያ ሜቶ፥ ሚሬኔ ካዉሻቴ ጋላስ፤ ሃና ጋላሳያ ናይ ዬሌታናስ ኣያ ኬሃ ሚጻታሼ ዬላ ዬጋናስ ዎልቃ ይዳ ጋላሳ።"]},{"type":"verse","number":4,"content":["ዴኦ ጾሳ ካዉሻናስ ባ ጎዳ ኣሶሬ ካዎይ ዬዲዳ ጋዳዋ ቃላ ኡባካ ጎዳ ኔ ጾሳይ ሲዪዳ ጊዳና፤ ኢዚ ሲዪዳ ቃላ ጊሻስ ጎዳ ኔ ጾሳይ ኢዛ ሃንቃና ማላ ኔኒ ሼምፖራ ፓጻ ዲዛ ኣሳስ ጾሳ ዎሳርኪ!› ጊዴስ» ጊዳ።"]},{"type":"verse","number":5,"content":["ካዎ ሂዝቂያሳ ሹሜቲ ኢሳያሳኮ ዪዳ ዎዴ፥"]},{"type":"verse","number":6,"content":["ኢሳያሲ ኢስታስ፥ «ኢንቴ ኢንቴ ጎዳስ፥ ‹ጎዳይ ኔስ ኣሶሬ ካዎ ኦሳንቻቲ ታ ቦላ ጫሻ ቃላ ሃሳይዳይሳ ሲያዳ ባቦፋ፤"]},{"type":"verse","number":7,"content":["ታኒ ኢዛ ቦላ ሄሳ ማላ ኣያና ዬዳና፤ ኢዚካ ዎሬ ሲዪዲ ጉዬ ባ ዴሬ ሲሚ ባና፤ ኢዚ ሄን ማሻን ሃይቃና ማላ ታ ኢዛ ኦና› ጊ ዮቲቴ» ጊዴስ።"]},{"type":"verse","number":8,"content":["ኦላንቻታ ጋዳዋዚካ ኣሶሬ ካዎይ ላኪሼፔ ዴንዲ ቢዳይሳ ሲዪዲ ጉዬ ሲሚዴስ፤ ካዎዚ ሊቢናራ ኦሌቲሺን ዴሚዴስ።"]},{"type":"verse","number":9,"content":["ሄ ዎዴ ቶጵያ ዴሬ ዬሌታ ጊዲዳ ጊብጼ ካዎ ቲራቄይ ኢዛ ኦላናስ ዩሳ ቦላ ዲዛይሳ ሴናኪሬሜይ ሲዪዴስ፤ ሄሳ ጊሻስ ዛሬዲ ሂዝቂያሳኮ ቃስታኔታ ቦላ ዳብዳቤ፥"]},{"type":"verse","number":10,"content":["«ኢንቴ ቢዲ ዩሁዳ ካዎ ሂዝቂያሳስ፥ ‹ኔ ኢዛን ኣማኔቲዛ ጾሳይ ዬሩሳላሜይ ኣሶሬ ኩሼን ኩንዱኩ› ጊዲ ኔና ባሌፎ።"]},{"type":"verse","number":11,"content":["ሃይሳፌ ካሴ ኣይዴካ ኣሶሬ ካዎቲ ዴሬ ኡባ ቦላ ኣይ ኦዳኮ ኔ ሲያዳሳ፤ ኢዚ ኢስታ ሙሌራ ይሲዴስ፤ ሂስቲን ኔኒ ኬሳ ኤካዳ ኣታናዝ ኔስ ሚሳቲዜ?"]},{"type":"verse","number":12,"content":["ካሴ ታ ኣዋቲ ይሲዳ ካዎቴታ ጎዛኔን፥ ካራኔን፥ ኤራፋሴን ሄሳካ ታላሳሬን ዲዛ ኤዴኔ ኣሳታ ኢስታ ኤቃ ጾሳቲ ኢስታ ኣሺዶ?"]},{"type":"verse","number":13,"content":["ሃማቴ ካዎቲኔ ኣርፋዴ ካዎቲ ሃኢ ኣዋን ዲዞ? ሴፋርዋይሜ ካታማ ካዎዚ ኣዋን ዲዜ? ቃሴካ ሄና ካዎይኔ ኢዋ ካዎቲ ሃኢ ኣዋን ዲዞ?» ጊ ኪቲዴስ።"]},{"type":"heading","content":["ሂዝቂያሳ ዎሳ"]},{"type":"verse","number":14,"content":["ሂዝቂያሲ ዳብዳቤዛ ቃስታኔታ ኩሼፔ ኤኪ ናባቢዴስ፤ ሄሳፌ ጉዬ ፑዴ ጎዳ ኬ ኬዚዲ ዳብዳቤዛ ጎዳ ሲንን ሚጪዴስ።"]},{"type":"verse","number":15,"content":["ሄሳፌ ጉዬ ሂዝቂያሲ ጎዳኮ፥ «ኪሩቤ ቦላ ኔ ኣራታን ኡቲዳ ጎዳ ኢስራኤሌ ጾሶ! ቢታ ቦላ ዲዛ ኡባ ቦላ ጾሲ ኔና፤ ሳሎኔ ሳኣ ሜዳይ ኔና።"]},{"type":"verse","number":16,"content":["ጎዳዉ! ሃኢ ኔኒ ኔ ሃይ ዬጋዳ ሃይሳ ሲያ፤ ኔኒ ኔ ኣይፌታካ ዶያዳ ጼላ፤ ሴናኪሬሜይ ዴኦ ጾሳ ጫያናስ ኪቲዳ ቃላ ኤዝጋ።"]},{"type":"verse","number":17,"content":["«ኣቤት ጎዳዉ፤ ኣሶሬ ካዎቲ ሃይታ ካዎቴታኔ ኢስቲ ቢታ ቱሙካ ይሲዳ፤"]},{"type":"verse","number":18,"content":["ኢስታ ኤቃ ጾሳታካ ታማን ዬጊ ጹጊ ይሲዳ፤ ኢስቲካ ኣሳ ኩሼን ሚፌኔ ሹቻፌ ኦሴቲዳይታ ኣቲን ጾስ ጊዴቴና።"]},{"type":"verse","number":19,"content":["ሃኢካ ጎዳዉ ኑ ጾሳዉ! ኔኒ ጻላ ጾሳ ጊዲዳይሳ ሃ ቢታ ቦላ ዲዛ ካዎቴቲ ኤራና ማላ ኢዛ ኩሼፔ ኑና ኣሻ» ጊ ዎሲዴስ።"]},{"type":"heading","content":["ኢሳያሲ ሴናኪሬሜ ጊሻስ ዮቲዳ ቲንቢቴ"]},{"type":"verse","number":20,"content":["ሄሳፌ ጉዬ ኣሞጼ ና ኢሳያሲ ካዎ ሂዝቂያሳስ ሃይሳፌ ካሊ ዲዛ ኪታ ዬዲዴስ። «ጎዳ ኢስራኤሌ ጾሳይ፥ ‹ኣሶሬ ካዎ ሴናኪሬሜ ቦላ ኔ ዎሲዳ ዎሳ ታኒ ሲያዲስ› ጊዴስ።"]},{"type":"verse","number":21,"content":["ሄሳ ጊሻስ ጎዳይ ኢዛ ቦላ ዮቲዳ ቃላይ ሃይሳ።",{"text":"«ጌላኦ ጺዮኔ ናያ","poem":1},{"text":"ኔና ካዱሲኔ","poem":2},{"lineBreak":true},{"text":"ካዉሻዱስ፤","poem":2},{"lineBreak":true},{"text":"ዬሩሳላሜ ናያ ኔ ኢዚ ቦላራ","poem":2},{"lineBreak":true},{"text":"ፒራ ቢሺን","poem":2},{"text":"ባ ቆ ኔ ቦላ ቃዉስ።","poem":3}]},{"type":"verse","number":22,"content":[{"text":"ሂስቲን ኔ ጫዪዳይኔ","poem":1},{"text":"ካዉሺዳይ ኦኔ?","poem":2},{"lineBreak":true},{"text":"ኔኒ ኔ ቃላ ቁ ሂስቲዳይ","poem":2},{"lineBreak":true},{"text":"ኦና ቦላ?","poem":2},{"lineBreak":true},{"text":"ኔ ኦቶሬቴን ዴሬቃ ጼሊዛይ","poem":2},{"lineBreak":true},{"text":"ኦና ቦላ?","poem":2},{"lineBreak":true},{"text":"ኢስራኤሌ ጌሻዛ ቦላዬ!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ኔኒ ቃስታኒዳይታ ባጋራ","poem":1},{"text":"ጎዳ ቦላ ጫሽ ኮራዳሳ።","poem":2},{"lineBreak":true},{"text":"ኔኒ፥ ‹ታኒ ታስ ዲዛ ዳሮ","poem":2},{"lineBreak":true},{"text":"ፓራ-ጋሬታን","poem":2},{"text":"ፑዴ ቃ","poem":3},{"lineBreak":true},{"text":"ዙማታ ቦላ ኬዛዲስ፤","poem":3},{"lineBreak":true},{"text":"ሊባኖሴ ዙማስ ጼራ ጋካዲስ፤","poem":3},{"text":"ሄፔ ኣዱሳ ዚጋ ሚታኔ","poem":2},{"lineBreak":true},{"text":"ዶሬቲዳ ጺዳ","poem":2},{"lineBreak":true},{"text":"ሚታካ ቃንጻዳሳ፤","poem":2},{"lineBreak":true},{"text":"ታኒ ኢዛስ ዉርሴ ዛዋኔ","poem":2},{"lineBreak":true},{"text":"ፒ ጊዳ ዎራን ጋካዲስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"« ‹ታኒ ሃራ ዴሬታንካ","poem":1},{"text":"ሃ ኦላ ቦካዲስ፤","poem":2},{"lineBreak":true},{"text":"ኢስታፌ ሃ ኡያዲስ፤","poem":2},{"lineBreak":true},{"text":"ታኒ ታ ቶሆ","poem":2},{"lineBreak":true},{"text":"ጫማታን ዬዳ","poem":2},{"text":"ጊብጼ ቢታ ፑልቶታ","poem":3},{"text":"ሜሊሳዲስ› ጋዳሳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"«ዳሮ ዎዴፔ ሲንን","poem":1},{"text":"ኔኒ ጊምቤቲዳ","poem":2},{"lineBreak":true},{"text":"ካታማታ ቆቆፋዳ፥","poem":2},{"text":"ሹቻ ኬላ ኬሳና ማላ፥","poem":3},{"lineBreak":true},{"text":"ታኒ ቆፋ ቃቻ","poem":3},{"text":"ዎዳይሳ ሲያቤኪ?","poem":2},{"lineBreak":true},{"text":"ቤኒ ሃልቻ","poem":2},{"lineBreak":true},{"text":"ዎዳይሳ ሃኢ ፖላይስ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ሄን ዲዛ ኣሳ ዎልቃይካ","poem":1},{"text":"ጪንጊ ዉሪዴስ፤","poem":2},{"lineBreak":true},{"text":"ኢስቲ ዳጋሚዲ ዬላ ማይኢዳ፤","poem":2},{"lineBreak":true},{"text":"ጮ ሜላ ዴምባን ሞኪዳ","poem":2},{"lineBreak":true},{"text":"ኣታኪልቴ ማላ፥","poem":2},{"lineBreak":true},{"text":"ቡሮ ጻጶ ዬዶንታ","poem":2},{"lineBreak":true},{"text":"ጫሬቻ ማላ፥","poem":2},{"text":"ኬ ቦላ ሞኪዲ","poem":3},{"lineBreak":true},{"text":"ቡሮ ዲጮንታ ሹሊዳ",