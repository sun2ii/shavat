{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"2SA","translationId":"gmv_etw","name":"2ሳሜላ ማጻፋ","commonName":"2ሳሜላ ማጻፋ","title":"2ሳሜላ ማጻፋ","order":10,"numberOfChapters":24,"sha256":"7849faff0e12262c9be56490494fca568633177f7b0d7da1ca2dd46b9c848032","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/gmv_etw/2SA/24.json","totalNumberOfVerses":694},"chapter":{"number":1,"content":[{"type":"heading","content":["ዳዊቲ ሳኦሌ ሃይቆ ሲስ"]},{"type":"verse","number":1,"content":["ሳኦሊ ሃይቂዳፔ ጉዬ ዳዊቲ ኣማሌቄ ኣሳ ኦሊ ጾኒዲ ሲሚዴስ፤ ጺጊላጌንካ ናምኡ ጋላስ ጋምኢዴስ።"]},{"type":"verse","number":2,"content":["ሄን ጋላስ ዳኬቲዳ ማይኦ ማይኢዲ ባ ሁኤ ቦላ ጉዱላ ላሊዲ ኢሲ ናቴ ና ዳይሲ ሳኦሌ ጉታፔ ዪዴስ። ዳዊቴኮ ጋኪዳ ማላ ዛቁል ዚርጺ ጊዲ ቦንቾስ ኩሼ ዴንዴስ።"]},{"type":"verse","number":3,"content":["ዳዊቲካ ኢዛ፥ «ኔ ኣዋፔ ያዲ?» ጊዲ ኦይቺዴስ። ኢዚ ቃሴ፥ «ታኒ ኢስራኤሌ ኣሳይ ዲዛሶፔ ኬሳ ኤካ ያዲስ» ጊዴስ።"]},{"type":"verse","number":4,"content":["ዳዊቲ ቃሴ ኢዛ፥ «ኣዜ ዋኒዳይ ኣኔ ታስ ኡባ ዮታ» ጊዲ ኦይቺዴስ። ኢዚካ ዳዊቴስ፥ «ኣሳዚ ኦላሶፔ ባቃቲዴስ፤ ዳሮይ ኩንዲዴስ፤ ሳኦሊኔ ኢዛ ና ዮናታኔይ ሃይቂዳ» ጊዴስ።"]},{"type":"verse","number":5,"content":["ሄሳፌ ጉዬ ዳዊቲ ዎሬዛ ኢዛስ ዮቲዳ ናዛ፥ «ሳኦሊኔ ኢዛ ና ዮናታኔይ ሃይቂዳይሳ ኣዛን ኤራዲ?» ጊ ኦይቺዴስ።"]},{"type":"verse","number":6,"content":["ዎሬዛ ኢዛስ ዮቲዳ ናቴ ናዚ ኢዛስ ዛሪዲ፥ «ቶሮንታ ዳሼ ታኒ ፑዴ ጊልቦኣ ዙማ ቦላ ኬዛዲስ፤ ሳኦሊ ሄን ባ ቶራ ቦላ ዜምፒ ዲሺን ፓራ-ጋሬቲኔ ቶጋ ኣሳይ ጎዴሬሼ ኢዛ ቦላ ጋኪ ዎዳ።"]},{"type":"verse","number":7,"content":["ኢዚካ ጉዬ ሲሚ ጼሊዲ ታና ቤኢዲ ጼይጊዴስ፤ ታኒካ፥ ‹ታ ኔስ ኣይ ኦ?› ጋዲስ።"]},{"type":"verse","number":8,"content":["«ኢዚካ ታና፥ ‹ኔ ኦኔ?› ጊ ኦይቺዴስ። ታኒካ ኢዛስ፥ ‹ታኒ ኣማሌቄ ኣሳ› ጋዳ ዮታዲስ።"]},{"type":"verse","number":9,"content":["«ኢዚካ ታስ፥ ‹ታ ሃይቃናስ ቶቃይስ፤ ጊዶ ኣቲን ታስ ሼምፖይ ኬዞንታ ኢጺዴስ፤ ዛይ ሃ ያ፤ ታና ሼምፒሳ› ጊዴስ።"]},{"type":"verse","number":10,"content":["ሂስቲን ታኒ ኢዚ ኩንዲቺዳፔ ጉዬ ኣቶንታይሳ ኤራዳ ታ ኢዛኮ ሺቃዳ ኢዛ ዎዲስ። ኢዛ ሁኤ ቦላ ዲዛ ካላቻዛኔ ኢዛ ቄሴ ሳጋዮዛ ኤካዳ ሄኮ ታ ጎዳስ ኤሃዲስ» ጊዴስ።"]},{"type":"verse","number":11,"content":["ሄሳፌ ጉዬ ዳዊቲኔ ኢዛራ ዲዛ ኣሳይ ኡባይ ባንታ ማይኦ ዳኪዳ።"]},{"type":"verse","number":12,"content":["ኢስቲ ማሻን ሲፌቲዳ ጊሻስ ሳኦሌሲኔ ኢዛ ና ዮናታኔስ፥ ጎዳ ኦላንቻታሲኔ ኩሜ ኢስራኤሌ ኣሳስ ካዮቲዳ፥ ዬኪዳኔ ኦማርስ ጋካናስ ጾሚዳ።"]},{"type":"verse","number":13,"content":["ዳዊቲ ቃሴ ሄ ዎሬዛ ኢዛስ ኤሂዳ ናቴዛ፥ «ኔ ኣዋፔ ያዲ?» ጊ ኦይቺዴስ። ናዚካ፥ «ታኒ ኔ ዴሬን ቤቲ ዲዛ ኣማሌቄ ኣሳ ና» ጊዴስ።"]},{"type":"verse","number":14,"content":["ዳዊቲ ቃሴ፥ «ሂስቲን ኔኒ ጎዳይ ቲይዳይሳ ይሳናስ ኔ ኩሼ ዋና ጻላ ዴንዲ?» ጊ ኦይቺዴስ።"]},{"type":"verse","number":15,"content":["ሄሳፌ ጉዬ ዳዊቲ ናቴታፔ ኢሳ ጼይጊዲ፥ «ኔኒ ኢዛኮ ሺቃዳ ኢዛ ዎ» ጊዴስ። ሄ ናቴዚ ኣማሌቄዛ ጫዲ ዎዴስ።"]},{"type":"verse","number":16,"content":["ዳዊቲካ ኣማሌቄዛ፥ « ‹ጎዳይ ቲይዳይሳ ታኒ ዎዲስ› ጋዳ ኔ ቦላ ኔርካ ኔ ማርካቲዳ ጊሻስ ኔ ሱ ጎሜይ ኔ ቦላ ጊዶ!» ጊዴስ።"]},{"type":"heading","content":["ሳኦሌ ጊሻሲኔ ዮናታኔ ጊሻስ ሺቂዳ ዚላሳ ጊንጾ"]},{"type":"verse","number":17,"content":["ዳዊቲ ሳኦሌ ጊሻሲኔ ዮናታኔ ሃይቆ ጊሻስ ዚላሊሼ ዬኪዴስ።"]},{"type":"verse","number":18,"content":["ቃሴካ፥ «ዎንዳፌ ሚላስ» ጌቴቲዛ ዚላሳ ዩሁዳ ዴራ ታማርሳና ማላ ኣዛዚዴስ። ሄሲ ያሻሬ ማጻፋን ጻፌቲ ኡቲዴስ።"]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«ሃይሶ ኢስራኤሌ!","poem":1},{"text":"ኔ ቦንቾይ ዙምቡላታ ቦላ","poem":2},{"lineBreak":true},{"text":"ጫዴቲ ሃይቂዴስ፤","poem":2},{"lineBreak":true},{"text":"ኦላ ቃራቲ ዋኒ","poem":2},{"lineBreak":true},{"text":"ሃይሳ ኩንዲዶ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«ፊሊስጼሜ ማጫ ናይቲ","poem":1},{"text":"ኡፋዬቶንታ ማላ፥","poem":2},{"lineBreak":true},{"text":"ቃጻሬቶንታ ኣሳ ማጫ ናይቲ","poem":2},{"lineBreak":true},{"text":"ኢሊሎንታ ማላ፥","poem":2},{"text":"ሃይሳ ጌቴን ዎሬሶፒቴ፤","poem":3},{"lineBreak":true},{"text":"ኣስቄሎናንካ ኣዋጆፍቴ።","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«ኢንቴኖ ጊልቦኣ ዙማቶ!","poem":1},{"text":"ኢንቴ ቦላ ኢራይ ቡኮፎ፤","poem":2},{"lineBreak":true},{"text":"ጻዛይካ ኢንቴ ቦላ ዶፖ፤","poem":2},{"lineBreak":true},{"text":"ያርሾስ ጊዲዛ ካ","poem":2},{"text":"ኢንቴ ጎሻ ቢታን ሞኮፎ።","poem":3},{"lineBreak":true},{"text":"ሄን ኦላ ቃራዛ","poem":3},{"lineBreak":true},{"text":"ጎንዳሌይ ቱኒዴስ፤","poem":3},{"text":"ሳኦሌ ጎንዳሌይ","poem":2},{"lineBreak":true},{"text":"ሃይሳፌ ጉዬን","poem":2},{"lineBreak":true},{"text":"ዛይቴን ቁጬቴና።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዮናታኔ ዎንዳፌይ","poem":1},{"text":"ዎንታ ሲሚ ኤሬና፤","poem":2},{"lineBreak":true},{"text":"ሳኦሌ ማሻይካ","poem":2},{"lineBreak":true},{"text":"ሞርኬ ቃንጼሬ ዬጌስ፤","poem":2},{"lineBreak":true},{"text":"ዎልቃማታካ","poem":2},{"lineBreak":true},{"text":"ሜንሬ ዬጌስ፤","poem":2},{"lineBreak":true},{"text":"ኢዛ ሞርኬታካ ዎዴስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"«ሳኦሊኔ ዮናታኔይ","poem":1},{"text":"ሼምፖራ ፓጻ ዲሼ","poem":2},{"lineBreak":true},{"text":"ሲቄቲዛይታኔ ቆፋን ጋይቲዛይታ።","poem":2},{"lineBreak":true},{"text":"ሃይቂሼካ ሻኬቶንታይታ፤","poem":2},{"text":"ጎሌ ካፎፔ ፒላቲዛይታ፤","poem":3},{"lineBreak":true},{"text":"ጋሞፌካ ሚኒዛይታ።","poem":3}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"«ኢንቴኖ ኢስራኤሌ ማጫሳቶ!","poem":1},{"text":"ኦቻ ቴራ ሚሳቲዛ ኣልኦ","poem":2},{"lineBreak":true},{"text":"ቃሚሳ ኢንቴና ማይዚዳ፤","poem":2},{"lineBreak":true},{"text":"ኢንቴ ማይኦዛ ዎርቃ","poem":2},{"lineBreak":true},{"text":"ጺባቤን ኣሌቂሲዳ፤","poem":2},{"text":"ሳኦሌስ ዬኪቴ።","poem":3}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"«ኦላ ቃራቲ","poem":1},{"text":"ዋኒ ሃይሳ ማላ ኦላሶን ኩንዲዶ!","poem":2},{"lineBreak":true},{"text":"ዮናታኔይ ኔ ዙምቡላታ ቦላ","poem":2},{"lineBreak":true},{"text":"ጫዴቲ ሃይቂዴስ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ታ ኢሻ ዮናታኔ!","poem":1},{"text":"ታኒ ኔ ጊሻስ ካዮታዲስ፤","poem":2},{"text":"ኔ ታስ ኬሃ ኣልኦኮሺን፤","poem":3},{"lineBreak":true},{"text":"ኔ ሲቆይ ታና","poem":3},{"lineBreak":true},{"text":"ማላሊሲዛዛኮሺን","poem":3},{"lineBreak":true},{"text":"ማጫ ሲቆፔካ ኬሂ","poem":3},{"lineBreak":true},{"text":"ኣስኮሺን።","poem":3}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"«ኦላ ቃራቲ ዋኒ ኩንዲዶ!","poem":1},{"text":"ኦላ ማሳራቲካ ዋኒ","poem":2},{"lineBreak":true},{"text":"ሃዳ ጊዳኔ!»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/2SA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/2SA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/1SA/31.json","previousChapterAudioLinks":{},"numberOfVerses":27}