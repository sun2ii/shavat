{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"2SA","translationId":"gmv_etw","name":"2ሳሜላ ማጻፋ","commonName":"2ሳሜላ ማጻፋ","title":"2ሳሜላ ማጻፋ","order":10,"numberOfChapters":24,"sha256":"7849faff0e12262c9be56490494fca568633177f7b0d7da1ca2dd46b9c848032","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/gmv_etw/2SA/24.json","totalNumberOfVerses":694},"chapter":{"number":23,"content":[{"type":"heading","content":["ዳዊቲ ዉርሴን ዮቲዳ ቃላ"]},{"type":"verse","number":1,"content":["ዳዊቲ ዉርሴን ሃሳይዳ ቃላይ ሃይሳፌ ካሊዛይሳ፤",{"text":"«ያቆቤ ጾሳን ቲዬቲዳይሲ፥","poem":1},{"text":"ኡባፌ ቃ ጾሳይ","poem":2},{"lineBreak":true},{"text":"ቁ ቁ ሂስቲዳ ኣሲ፥","poem":2},{"lineBreak":true},{"text":"ኢስራኤሌን ዶሴቲዳ ዬንቻይ፥","poem":2},{"text":"ኢሴዬ ና ዳዊቴ ቲንቢቴ","poem":3},{"lineBreak":true},{"text":"ቃላይ ሃይሳ፤","poem":3}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«ጎዳ ኣያናይ","poem":1},{"text":"ታ ባጋራ ሃሳይዴስ፤","poem":2},{"lineBreak":true},{"text":"ኢዛ ቃላይ ታ ዶናን ዴስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኢስራኤሌ ጾሲ ሃሳይዴስ፤","poem":1},{"text":"ኢስራኤሌ ዛላይ ታስ፥","poem":2},{"text":"‹ኣሳ ጺሎቴን ሃሪዛይ፥","poem":3},{"lineBreak":true},{"text":"ጾሳ ያሻቴን ኣይሲዛይ፥","poem":3}]},{"type":"verse","number":4,"content":[{"text":"ኢዚ ሻራይ ባይንዳሶን፥","poem":2},{"lineBreak":true},{"text":"ማላዶ ጻልቄይ ኬዚዛ","poem":2},{"lineBreak":true},{"text":"ዎዴ ዲዛ ፖኦ ማላ፤","poem":2},{"text":"ኢዚ ቢታ ቦላ ማታ","poem":3},{"text":"ፑርጪሲዛ ጻልቄ ማላ፥","poem":2},{"text":"ኢራይ ቡኪ ኣሺን","poem":3},{"text":"ኬኢዛ ኣዋ ማላ› ጊዴስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«ታ ኬ ጾሳ ማታን","poem":1},{"text":"ሊኬ ጊዴኔ?","poem":2},{"lineBreak":true},{"text":"ኡባ ሚሽ ጊግሲዲኔ ናጊዲ፥","poem":2},{"text":"ታናራ ሜርና ጫቆ ቃላ","poem":3},{"lineBreak":true},{"text":"ጌሊዳይ ኢዛ ጊዴኔ?","poem":3},{"text":"ታ ኣቶቴ ፖሎ ጋናይ","poem":1},{"text":"ታ ኣሞ ኡባ ታስ ኢማናይ","poem":2},{"lineBreak":true},{"text":"ኢዛ ጊዴኔ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ጊዶ ኣቲን ኢታ ኣሳቲ ኡባይ፥","poem":1},{"text":"ኩሼን ሺሻና ዳንዳዬቶንታ","poem":2},{"lineBreak":true},{"text":"ኣጉን ማላ","poem":2},{"text":"ዎራ ዎና።","poem":3}]},{"type":"verse","number":7,"content":[{"text":"ኣጉን ቦቺዛ ኡባስ፥","poem":1},{"text":"ቢራታ ዎይኮ","poem":2},{"lineBreak":true},{"text":"ቶራ ቶማ ኮሼስ፤","poem":2},{"text":"ኢስቲ ባ ዲዛሶን ሙሌራ","poem":3},{"lineBreak":true},{"text":"ታማን ጹጌታና።»","poem":3}]},{"type":"heading","content":["ኤሬቲዳ ቃራ ኣሳታ"]},{"type":"verse","number":8,"content":["ዳዊቴስ ኤሬቲዳ ቃራ ኣሳታ ሱን ሃይሳፌ ካሊዛይሳ፤ ኮይሮይሲ ታሂኪሞኔ ዴሬ ኣስ ዮሼቢ-ባሼቤቴ ጊዲሺን ኢዚ ሄ ሃላቃታስ ሃላቃ፤ ኢዚካ ኢሲ ኦላን ባ ቶራ ጾንጊዲ 800 ኣስ ዎዳ ቃራ።"]},{"type":"verse","number":9,"content":["ናምኣንዚ ኣሂሆሄ ዴሬ ኣስ ዶዴ ና ኤልኤዜሬ፤ ኦሌታናስ ኢሲ ቦላ ሺቂዳ ፊሊስጼሜ ኣሳይ ኤቄቲዛ ዎዴ ኢስራኤሌ ኣሳይ ባቃቲዴስ፤ ዳዊቴራ ዲዛ ሄ ቃራታ ጋርሳፌ ኢሶይ ኢዛ።"]},{"type":"verse","number":10,"content":["ኢዚ ጊዲኮ ባ ኤቂዳሶ ዬዲቤና፤ ኢዛ ኩሼይ ኣርጋጫናሼኔ ማሻራ ኢሲፌ ኦይኬታናሼ ጋካናስ ፊሊስጼሜታ ኦሊዴስ፤ ሄ ጋላስ ጎዳይ ኢዛስ ጊታ ጾኖ ኢሚዴስ። ባቃቲ ቢዳ ኦላንቻቲ ሃይቂዳ ኣሳፔ ኦላ ሚሺኔ ማይኦ ጻላ ቃራታናስ ኤሌኤዜሬኮ ጉዬ ሲሚዳ።"]},{"type":"verse","number":11,"content":["ሄንዚ ሃራሬ ዴሬ ኣስ ኣጌ ና ሻማ፤ ፊሊስጼሜቲ ሌሃን ኩሜ ሚሲራይ ዜሬቲዳ ጋዴን ኢስቲ ኢሲ ቦላ ሺቂ ዲሺን ኢስራኤሌ ኦላንቻቲ ፊሊስጼሜታ ሲንፌ ባቃቲዳ።"]},{"type":"verse","number":12,"content":["ሻማይ ጊዲኮ ባ ኤቂዳሶ ዬዲቤና፤ ሄ ኦላ ኤቄቲዲ ፊሊስጼሜታ ዎዴስ፤ ሄ ጋላስ ጎዳይ ጊታ ጾኖ ኢሚዴስ።"]},{"type":"verse","number":13,"content":["ካ ሺሾ ዎዴ ፊሊስጼሜ ኦላንቻቲ ኤራፋይሜ ዙሌን ዱንካኒ ኡቲዳሼ ሄ ታሙ ሃላቃታፔ ሄቲ ዳዊቲ ዲዛሶ ኣዱላሜ ጎንጎሎ ዪዳ።"]},{"type":"verse","number":14,"content":["ሄ ዎዴ ዳዊቲ ሚጻ ጊዶን ዴስ፤ ፊሊስጼሜ ኦላንቻቲ ቤቴሊሄሜን ዴቴስ።"]},{"type":"verse","number":15,"content":["ዳዊቲ ላሞቲዲ፥ «ቤቴሊሄሜ ፔንጌ ኣቻን ዲዛ ኦላ ሃፌ ታስ ኦኔ ኤሃናይ!» ጊዴስ።"]},{"type":"verse","number":16,"content":["ሄሳ ጊሻስ ኤሬቲዳ ኦላ ቃራ ሄቲ ፊሊስጼሜ ኦላንቻታ ጊዶራ ካን ቢዲ ቤቴሊሄሜ ፔንጌ ኣቻን ዲዛ ሃ ኦላፌ ዱቂ ዳዊቴስ ኤሂዳ፤ ኢዚ ጊዲኮ ጎዳ ሲንን ያርሾ ሂስቲ ጉሲዴስ ኣቲን ኡዪቤና።"]},{"type":"verse","number":17,"content":["«ኣቤት ጎዳዉ! ሃይሳ ማላ ኦሶ ታ ዎስታ ኦ? ሃይሲ ታፔ ሃኮ! ሃይሲ ባንታ ሼምፖ ቦላ ፒርዲዳ ኣሳታ ሱ ዴኔ?» ጊዲ ዳዊቲ ኡያና ኮዪቤና፤ ሄኮ ኤሬቲዳ ሄ ኦላ ቃራቲ ኦዳ ጎባቴ ኦሶይ ሄሳ።"]},{"type":"verse","number":18,"content":["ጹሪያ ና ኢዮኣቤ ኢሻ ኣቢሳዬይ ሄ ኤሬቲዳ ኦላ ቃራታስ ሃላቃ፤ ሄ ጼቱ ኣሳ ቦላ ባ ቶራ ጾንጊዲ ዎዳኔ ሃ ሄ ቃራታ ማላ ኤሬቲዳ ጎባ ኣሳ።"]},{"type":"verse","number":19,"content":["ኣቢሳዬይ ሄታፔ ቦላራ ኬሂ ኤሬቲዳ ኣስ ጊዴኔ? ኢዚ ኢስታፌ ጊዶንታ ኣጊኮካ ኢዚ ኢስታስ ሃላቃ።"]},{"type":"verse","number":20,"content":["ሃራ ኤሬቲዳ ቃራይ ቃብጺኤሌ ዴሬ ኣስ ዮዳሄ ና ባናያይ ጊታ ኤሬቲዳ ኦሶ ኦዴስ። ኢዚካ ናምኡ ኤሬቲዳ ሞኣቤ ኣሳታ ዎዴስ፤ ቃሴካ ሻቺ ቡኪዳ ጋላስ ኦላ ጊዶ ጌሊዲ ጋሞ ዎዴስ።"]},{"type":"verse","number":21,"content":["ሄሳካ ኢሲ ጊታ ጊብጼ ኣስ ዎዴስ፤ ሄ ጊብጼ ኣዴዚ ባ ኩሼን ቶራ ኦይኪዴስ፤ ጊዶ ኣቲን ባናያይ ኢዛራ ኦሌታናስ ጉፌ ኦይኪዲ ኢዛኮ ቢዴስ፤ ጊብጼ ኣዴዛ ኩሼፔ ኢዛ ቶራ ዎ ኤኪዲ ኢዛ ቶራን ኢዛ ዎዴስ።"]},{"type":"verse","number":22,"content":["ዮዳሄ ና ባናያ ጎባቴ ሄሳ፤ ኢዚካ ኤሬቲዳ ሄ ቃራ ኣሳታ ማላ ኤሬቲዳ ጎባ ኣሳ።"]},{"type":"verse","number":23,"content":["ኢዚ ሄ ሄ ታሙ ኣሳታፔ ኣ ቦንቼቲዳዴ፤ ጊዶ ኣቲን ኤሬቲዳ ሄ ቃራ ኣሳታ ማላ ሳቤቴና። ዳዊቲ ባናያ ባ ቦንቾ ዛቤታ ቦላ ሹሚዴስ።"]},{"type":"verse","number":24,"content":["ሄ ሄ ታማታፔ ባጋይታ ሱን ሃይሳፌ ካሊዛይሳ።",{"text":"ኢዮኣቤ ኢሻ ኣሳሄሌ፥","poem":1},{"lineBreak":true},{"text":"ቤቴሊሄሜ ዴሬ ኣስ ዶዴ","poem":1},{"text":"ና ኤልያኔ፥","poem":2}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"ሃራሬ ዴሬ ኣስ ሻማሃ፥","poem":2},{"text":"ሃራሬ ዴሬ ኣስ ኤሊቃ፥","poem":1}]},{"type":"verse","number":26,"content":[{"text":"ፓሊጼ ዴሬ ኣስ ሄሌጼ፥","poem":2},{"text":"ቴቁሄ ዴሬ ኣስ ኢቄሻ","poem":1},{"text":"ና ኢራ፥","poem":2}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ኣናቶቴ ዴሬ ኣስ ኣቢኤዜሬ፥","poem":2},{"text":"ሁሼ ዴሬ ኣስ ሜቡናዬ፥","poem":1}]},{"type":"verse","number":28,"content":[{"text":"ኣሂሆሄ ዴሬ ኣስ ጻልሞኔ፥","poem":2},{"text":"ናጾፌ ዴሬ ኣስ ማሂራዬ፥","poem":1}]},{"type":"verse","number":29,"content":[{"text":"ናጾፌ ዴሬ ኣስ ባኣና","poem":2},{"lineBreak":true},{"text":"ና ሄሌቤ፥","poem":2},{"text":"ቢኒያሜ ባጋፌ ጊቢኣ ዴሬ ኣስ ኤሪባዬ ና ኢታዬ፥","poem":1}]},{"type":"verse","number":30,"content":[{"text":"ፒራቶኔ ዴሬ ኣስ ባናያ፥","poem":2},{"text":"ጋኣሼ ዙሌ ኣስ ሂዳዬ፥","poem":1}]},{"type":"verse","number":31,"content":[{"text":"ኣራቤ ዴሬ ኣስ ኣቢ-ኤልቦኔ፥","poem":2},{"text":"ባርሁሜ ዴሬ ኣስ ኣዚሞቴ፥","poem":1}]},{"type":"verse","number":32,"content":[{"text":"ሻልቦኔ ዴሬ ኣስ ኤሊያሂቤ፥","poem":2},{"text":"ያሼኔ ናይታ፥","poem":1},{"text":"ዮናታኔ፥","poem":2}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"ሃራሬ ዴሬ ኣስ ሻማሃ ና፥","poem":2},{"text":"ሃራሬ ዴሬ ኣስ","poem":1},{"text":"ሻራሬ ና ኣሂኣሜ፥","poem":2}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"ማኢካቴ ዴሬ ኣስ","poem":2},{"lineBreak":true},{"text":"ኣሃሲባ ና ኤልፋሌጼ፥","poem":2},{"text":"ጊሎ ዴሬ ኣስ","poem":1},{"text":"ኣክጾፌሌ ና ኤልኣሜ፥","poem":2}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"ቃርሜሎሴ ዴሬ ኣስ ሄጺሮ፥","poem":2},{"text":"ኣራቤ ዴሬ ኣስ ፓራዬ፥","poem":1}]},{"type":"verse","number":36,"content":[{"text":"ጾባ ዴሬ ኣስ","poem":2},{"lineBreak":true},{"text":"ናታኔ ና ዪጊኣሌ፥","poem":2},{"text":"ጋዴ ዴሬ ኣስ ባኔ፥","poem":1}]},{"type":"verse","number":37,"content":[{"text":"ኣሞኔ ዴሬ ኣስ ዛላቃ፥","poem":2},{"text":"ጹሪያ ና ኢዮኣቤስ","poem":1},{"text":"ጎንዳሌ ኦይኪዛ ቢኤሮቴ","poem":2},{"lineBreak":true},{"text":"ዴሬ ኣስ ናሂራዬ፥","poem":2}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"ያቲሬ ዴሬ ኣስ ኢራ፥","poem":2},{"lineBreak":true},{"text":"ያቲሬ ዴሬ ኣስ ጋሬቤ፥","poem":2}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"ሄሳካ ሂቴ","poem":2},{"lineBreak":true},{"text":"ዴሬ ኣስ ኦሪዮ፥","poem":2},{"lineBreak":true},{"text":"ኢስቲ ኢሲ ቦላ ሄ","poem":2},{"lineBreak":true},{"text":"ታማኔ ላፑና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/2SA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/2SA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/2SA/22.json","previousChapterAudioLinks":{},"numberOfVerses":39}