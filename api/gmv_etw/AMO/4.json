{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"AMO","translationId":"gmv_etw","name":"ኣሞጼ ቲንቢቴ","commonName":"ኣሞጼ ቲንቢቴ","title":"ኣሞጼ ቲንቢቴ","order":30,"numberOfChapters":9,"sha256":"296c3fc8de872ee3432ccec8aa0221e4d99566bedcef932283308cc2a175f0e9","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gmv_etw/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":["ኬቲዳ ባሳኔ ሚዛታ ማላ ኢንቴ ኣሳቴ ኦርዲሲዳ ሳማሪያ ማጫሳቶ! ሃይሳ ቃላ ሲዪቴ! ኢንቴ ዳቡራንቻታ ካዉሼታ፤ ማንቆታ ቦላካ ጎዳቴታ፤ ኢንቴ ኣዚናታ፥ «ኑስ ማሲዛ ኡሹ ኤሂቴ» ጌታ።"]},{"type":"verse","number":2,"content":["ሄሳ ጊሻስ ጎዳይ ባ ጌሻቴን፥ «ኢንቴስ ሲን ዳፎይ ኣን ኢንቴ ባና ዎዴይ ያና፤ ኢንቴፌ ሄን ቢታ ቦላ ኣቲዳይቲ ቃሴ ማንጻኮን ኦይኬቲ ቢዛ ሞሌ ማላ ኦይኬቲ ባና።"]},{"type":"verse","number":3,"content":["«ኢንቴፌ ኢሶይ ኢሶይ ኢንቴ ማታን ዲዛ ሉኮራ ጎሼቲ ጎሼቲ ኬዚዲ ጌዴ ሄሪሞኔን ዬጌታና» ጊ ጫቂዴስ።"]},{"type":"heading","content":["ኢስራኤሌ ኣሳይ ባንታ ባላፔ ሲሚቤቴና"]},{"type":"verse","number":4,"content":["ጎዳይ፥ «ኢስራኤሌ ዴሬዞ!",{"text":"ቤቴሌ ቢዲ ናጋራ ኦቴ!","poem":2},{"lineBreak":true},{"text":"ጌልጌላካ ቢዲ","poem":2},{"lineBreak":true},{"text":"ናጋራ ጉጂ ኦቴ!","poem":2},{"lineBreak":true},{"text":"ጋላስ ጋላስ","poem":2},{"lineBreak":true},{"text":"ኢንቴ ያርሾ ያርሺቴ!","poem":2},{"lineBreak":true},{"text":"ሄን ጋላስ ጋላስ","poem":2},{"text":"ኢንቴ ኣስራታ ኢሚቴ።","poem":3}]},{"type":"verse","number":5,"content":[{"text":"ኢንቴ ኦናስ ኮይዛይ","poem":1},{"text":"ሄሳ ጊዲዳ ጊሻስ","poem":2},{"lineBreak":true},{"text":"ኢርሾይ ኢዛን ዲዛ ኡኬ","poem":2},{"lineBreak":true},{"text":"ጋላታ ያርሾ ሺሺቴ፤","poem":2},{"lineBreak":true},{"text":"ኢንቴ ሄሳ ኢንቴ ሼኔ ማላ","poem":2},{"lineBreak":true},{"text":"ሺሺዛ ጊሻስ","poem":2},{"lineBreak":true},{"text":"ኢዛን ጬቄቲቴ» ጌስ።","poem":2}]},{"type":"verse","number":6,"content":["«ኢንቴስ ዶናን ባና ካራ ታ ይሳዳ ኢንቴ ካታማታን ኡባን ኮሻ ዬዳዲስ። ኢንቴ ጊዲኮ ሃ ታኮ ሲሚቤኬታ።"]},{"type":"verse","number":7,"content":["ኢንቴ ካይ ጋካናፔ ቡሮ ሄ ኣጊናይ ዲሺን ሲንታ ታ ኢንቴስ ኢራይ ቡኮንታ ማላ ዲጋዲስ፤ ኢሲ ካታማን ቡኪሺን ሃራ ካታማን ቡኮንታ ማላ ዲጋዲስ፤ ኢሲ ጋዴን ቡኪሺን ሃንኮ ኢሳ ጋዴን ኢራይ ዪን ሜሊዴስ።"]},{"type":"verse","number":8,"content":["ኣሳይ ሃ ኡያናስ ኮዪሼ ሃ ካታማፔ ሄ ካታማ ቢዴስ፤ ጊዶ ኣቲን ባስ ጊዲዛ ሃ ዴሞንታ ኣጊዳ ጊሻስ ኡዪዲ ኣላናስ ዳንዳይቤቴና፤ ኢንቴካ ታኮ ሲሚቤኬታ።"]},{"type":"verse","number":9,"content":["«ኢንቴ ካ ሜሊሲዛ ሃርጌ ታ ኪታዲስ፤ ኢንቴ ኢንቴ ኣታኪልቴኔ ዎይኔ ሚታ፥ ባላሴኔ ዎጋራ ሚታ ኡባ ቦሌይ ሚዴስ፤ ጊዶ ኣቲን ኢንቴ ሃ ታኮ ሲሚቤኬታ» ጌስ።"]},{"type":"verse","number":10,"content":["«ታ ካሴ ጊብጼ ቢታ ቦላ ዬዲዳ ኢታ ሃርጌዛ ማላ ሃርጌ ኢንቴ ቦላ ዬዳዲስ፤ ኢንቴ ናቴ ናይታ ማሻን ሃይቃና ማላ ኦዲስ፤ ኢንቴ ፓራታካ ዲኤታና ማላ ታ ኦዲስ፤ ኢንቴ ዲዛሶን ሃይቂዳ ኣሳ ኣሃ ጺንቆይ ኢንቴ ሲ ቱጪዴስ፤ ኢንቴ ጊዲኮ ሃ ታኮ ሲሚቤኬታ።"]},{"type":"verse","number":11,"content":["ሶዶሜኔ ጋሞራ ካሴ ታ ይሲዳ ማላ ኢንቴፌ ዳሮታካ ታ ይሳዲስ፤ ኢንቴ ኣቲዳይቲካ ታማይ ሚሺን ኣቲዳ ሚ ዱርጫ ማላ ጊዲዴታ ሺን ኢንቴ ሃ ታኮ ሲሚቤኬታ።"]},{"type":"verse","number":12,"content":[{"text":"«ኢንቴኖ ኢስራኤሌ ኣሳቶ","poem":1},{"text":"ታኒካ ኢንቴ ቦላ","poem":2},{"lineBreak":true},{"text":"ሄሳ ኦና፤","poem":2},{"lineBreak":true},{"text":"ሄሳ ጊሻስ ኢንቴ ታናራ","poem":2},{"lineBreak":true},{"text":"ኢንቴ ጎዳራ ጋይታናስ","poem":2},{"text":"ኣኔ ጊጌቲቴ!» ጌስ።","poem":3}]},{"type":"verse","number":13,"content":[{"text":"ዙማታ ኦዳዴይ","poem":1},{"text":"ጫርኮታ ሜዳዴይ","poem":2},{"lineBreak":true},{"text":"ባ ቆፒዳይሳ ኣሳስ ቆንጪሲዛይ","poem":2},{"lineBreak":true},{"text":"ጋላሳ ፖኦ","poem":2},{"lineBreak":true},{"text":"ጌዴ ማን ላሚዛይ","poem":2},{"lineBreak":true},{"text":"ቢታ ቦላ ቃሶሆን","poem":2},{"lineBreak":true},{"text":"ሄሜቲዛይሳ","poem":2},{"lineBreak":true},{"text":"ሱንይ ጎዳ ሳሎ ጾሳ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/AMO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/AMO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/AMO/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}