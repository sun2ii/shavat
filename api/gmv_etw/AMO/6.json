{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"AMO","translationId":"gmv_etw","name":"ኣሞጼ ቲንቢቴ","commonName":"ኣሞጼ ቲንቢቴ","title":"ኣሞጼ ቲንቢቴ","order":30,"numberOfChapters":9,"sha256":"296c3fc8de872ee3432ccec8aa0221e4d99566bedcef932283308cc2a175f0e9","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gmv_etw/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":6,"content":[{"type":"heading","content":["ኢስራኤሌ ቃጻዬቴ"]},{"type":"verse","number":1,"content":["ጺዮኔን ባ ጊ ኡቲዳይቶ! ሳማሪያ ዙማ ቦላ ሂርጋይ ባይንዳ ዲዛይቶ! ኢስራኤሌ ኣሳይ ማዶ ኮዪዲ ኢንቴኮ ዪዛይቶ! ኢንቴኖ ዴሬ ሃላቃቶ! ኢንቴስ ኣዬ ኣና!"]},{"type":"verse","number":2,"content":["ኣኔ ኢንቴ ጌዴ ካላናሄ ካታማ ቢዲ ጼሊቴ፤ ሄፔካ ኣዲ ሃማቴ ጌቴቲ ጼይጌቲዛ ጊታ ካታማዮኔ ዱጌ ፊሊስጼሜ ካታማ ጌቴ ዎቴ፤ ኢስቲ ኢንቴ ናምኡ ካዎቴታፔ ሎኢዞ? ኢስታ ቢታይ ኢንቴ ቢታፌ ኣኪዜ?"]},{"type":"verse","number":3,"content":["ኢንቴ ቃሴ፥ «ኢታ ጋላሲ ኤሌ ጋኬና» ጊዛ ቆፋን ኢንቴ ዳናቴን ጌኔ ኦሶ ኤሶሴታ።"]},{"type":"verse","number":4,"content":["ኢንቴ ዳንጋርሳ ዛሌፔ ኦሴቲዳ ኣልጋን ኢቼታ፤ ኦሃላ ላቃ ኣሾኔ ማራ ኣሾ ሚሼ ሶፋ ቦላ ኡቲ ሼምፔታ።"]},{"type":"verse","number":5,"content":["ዳዊቴ ማላ ዬ ሚሽ ኢንቴስ ጊግሲዲ ባጋናኒኔ ዱማ ዱማ ማዛሙሬ ዬጺዛይቶ!"]},{"type":"verse","number":6,"content":["ዎይኔ ኡሹ ቢሪሌራ ጊዶንታ ኦቶራ ኡዪዛይቶ! ኬሂ ኣልኦ ጊዲዳ ሺቶ ቲዬቲዛይቶ! ኢስራኤሌ ዴራ ቦላ ጋኪዳ ሜቶ ጊሻስ ቃቶንታይቶ ኢንቴና ኣዬ ኣና!"]},{"type":"verse","number":7,"content":[{"text":"ሄሳ ጊሻስ ሄራ ኣሳፔ","poem":1},{"text":"ኮይሮ ኢንቴ ዲኤታና፤","poem":2},{"lineBreak":true},{"text":"ሄ ዎዴ ኢንቴ ካሴ ኡፋይሳን","poem":2},{"text":"ጉፒዛ ጉፋይኔ","poem":3},{"lineBreak":true},{"text":"ባ ጊ ዲዛ ዱሲ ኣታና።","poem":3}]},{"type":"verse","number":8,"content":["ጎዳይ ሳሎ ጾሳይ፥",{"text":"«ኢስራኤሌ ኣሳ ኦቶሬቴ","poem":1},{"text":"ታኒ ሃራሴታዲስ፤","poem":2},{"lineBreak":true},{"text":"ኢስታ ሚጻቲካ","poem":2},{"lineBreak":true},{"text":"ታና ሹኔቴስ፤","poem":2},{"text":"ሄሳ ጊሻስ ታኒ ካታማዮኔ","poem":3},{"lineBreak":true},{"text":"ኢዚን ዲዛይታ ኡባ","poem":3},{"lineBreak":true},{"text":"ሞርኬስ ኣ ኢማና» ጊዲ","poem":3},{"text":"ባርካ ባናን ጫቂዴስ።","poem":2}]},{"type":"verse","number":9,"content":["ኢሲ ኬን ታማቲ ኣቲኮ ሄ ኣቲዳይቲካ ሃይቃና።"]},{"type":"verse","number":10,"content":["ሃይቂዳይታፔ ኢሳዴስ ማታ ዳቦ ጊዲዳዴይኔ ሞጎ ዎጋ ፖሊዛዴይ ኣሃዛ ኬፌ ኬሲ ኤፋና፤ ሄ ዎዴ ኢዛዴይ ሶን ዲዛ ኢሲ ኣስ ጼይጊዲ፥ «ኔናራ ኣቲዳ ሃራ ኣሲ ዲዜ?» ጊዲ ኢዛ ኦይቻና ሺን ኢዛዴይ ቃሴ፥ «ኣቲዳ ኣሲ ኦኒካ ዴና» ጋና። ኦይቺዛይሲካ ዛሪዲ፥ «ጎዳ ኑ ጾሳ ሱን ጼይጋናስ ቤሶንታ ጊሻስ ጮኡ ጋ!» ጋና።"]},{"type":"verse","number":11,"content":[{"text":"ጎዳ ኣዛዞን","poem":1},{"text":"ዎጋ ኬቲ ላሌታና፤","poem":2},{"lineBreak":true},{"text":"ጉ ኬቲካ","poem":2},{"lineBreak":true},{"text":"ላሌቲ ኣታና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ፓራይ ሹቻ ቦላ ቶጌቲዜ?","poem":1},{"text":"ጎሻንቻይ ኣባ ጊዶን","poem":2},{"lineBreak":true},{"text":"ቦራ ዋጺ ጎያናስ","poem":2},{"lineBreak":true},{"text":"ዳንዳይዜ?","poem":2},{"lineBreak":true},{"text":"ኢንቴ ጊዲኮ","poem":2},{"lineBreak":true},{"text":"ፒርዳ ማርዜን ላሚዴታ፤","poem":2},{"lineBreak":true},{"text":"ቱማካ ጌዴ ጫሞን ሺርዴታ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኢንቴ ሎዲባሬ ካታማ","poem":1},{"text":"ጾኒዳ ጊሻስ ኡፋዬቲዴታ፤","poem":2},{"noteId":0},{"lineBreak":true},{"text":"«ቃርናይሜ ካታማዮ","poem":2},{"text":"ኑኒ ኑ ዎልቃን ኦይኪዶስ»","poem":3},{"lineBreak":true},{"text":"ጊዲ ጬቄቴታ።","poem":3},{"noteId":1}]},{"type":"verse","number":14,"content":["ጎዳይ ሳሎ ጾሳይ፥",{"text":"«ኢስራኤሌ ኣሳዉ!","poem":1},{"text":"ታኒ ኢንቴ ቦላ","poem":2},{"lineBreak":true},{"text":"ሃራ ዎልቃማ ዴሬ ዴንና፤","poem":2},{"lineBreak":true},{"text":"ሄሲካ ፑዴሃ ባጋፌ","poem":2},{"text":"ሃማቴ ፔንጌፌ ዶሚዲ","poem":3},{"text":"ዱጌሃ ባጋራ ኣራቤ","poem":2},{"text":"ሾባ ጋካናስ ኢንቴና","poem":3},{"text":"ኡንኤና» ጌስ።","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"6፡13 ሎዲባሬ ጌቴቲዛይሲ ካታማ ሱን ጊዲሺን ኢብራዌታ ቃላራ ሃዳ ሚሽ ጉሳ።","reference":{"ch