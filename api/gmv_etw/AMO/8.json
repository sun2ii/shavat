k":true},{"text":"ሄ ባኣሌይ ኣኮ","poem":2},{"lineBreak":true},{"text":"ኑኒ ማካ","poem":2},{"lineBreak":true},{"text":"ሚሻ ጉዲ","poem":2},{"text":"ኣልኦ ዋጋን ባይዛና፤","poem":3},{"text":"ቃሴካ ዎርዶ ሜዛኔን","poem":2},{"text":"ኣሳ ባሌና።","poem":3}]},{"type":"verse","number":6,"content":[{"text":"ጊስቴ ሃርቆካ ሙሩታ","poem":1},{"text":"ጊስቴ ዋጋን ባይዛና፤","poem":2},{"lineBreak":true},{"text":"ማንቆታ ቢራን፥ ሜቶቲዳይታካ","poem":2},{"lineBreak":true},{"text":"ቶሆ ጫማን ሻማና» ጌታ።","poem":2}]},{"type":"verse","number":7,"content":["ያቆቤይኔ ኢዛ ዜሬቲ ኢዛን ጬቄቲዛ ጎዳይ፥ «ኢስቲ ኦዳ ኦሶ ኡባ ታኒ ባሊኬ፤"]},{"type":"verse","number":8,"content":["ሃይሳ ጌዶን ቢታይ ቡሮ ቃጻና፤ ቢታይ ቦላ ዲዛይ ዉሪካ ዬካና፤ ኣባዬ ሻፋይ ኪጺዲ ጉሚዛይሳ ቢታ ኡባይ ቃ ዮሺኩዮሺካና» ጊዲ ባርካ ባናን ጫቂዴስ።"]},{"type":"verse","number":9,"content":["ኡባፌ ዎልቃማ ጎዳይ፥ «ሄ ዎዴ ታኒ ጋላሳ ሴታን ኣዋ ኣርሼ ዉልሳና፤ ጋላሳ ሴታን ጋዴ ሚሳና።"]},{"type":"verse","number":10,"content":["ኢንቴ ላይን ላይን ቦንቺዛ ባኣሌዛ ዬሆን ላማና፤ ኢንቴ ዬጺዛ ዬካ ዋሶን ላማና፤ ዲዛ ፔጺ ኢሲ ናይ ሃይቂን ጫሞ ዬሆ ዬኪዛ ኣሳ ማላ ኢንቴ ኢንቴ ሁኤ ቢናና ቡጪዲ ማቃ ማይኣና ማላ ታኒ ኢንቴና ኦና፤ ሄ ዉርሴ ጋላሳይ ጫሞ ጋላስ ጊዳና።"]},{"type":"verse","number":11,"content":["ሄኮ ታኒ ቢታ ቦላ ኮሻ ኤሃና ዎዴይ ያና፤",{"text":"ሄሲካ ኣሳይ ጾሳ ቃላ","poem":2},{"lineBreak":true},{"text":"ሲያና ጋፋኔ","poem":2},{"text":"ሳሞ ኣቲን ካ ጋፋኔ","poem":3},{"lineBreak":true},{"text":"ሃ ሳሞ ጊዴና።","poem":3}]},{"type":"verse","number":12,"content":[{"text":"ዴሬይ ዉሪ ፑዴሃፔ","poem":1},{"text":"ዱጌሃ ጋካናስ","poem":2},{"lineBreak":true},{"text":"ኣርሼይ ሞኪዛሶፔ","poem":2},{"lineBreak":true},{"text":"ዉሊዛሶ ጋካናስ","poem":2},{"text":"ጎዳ ቃላ ኮሽ","poem":3},{"lineBreak":true},{"text":"ያኔ ሃ ዬሞታናሺን","poem":3},{"lineBreak":true},{"text":"ዴሜና።","poem":3}]},{"type":"verse","number":13,"content":["ሄ ዎዴ ሎኦ ጌላኦቲኔ",{"text":"ሚኖ ፓንቲ","poem":2},{"lineBreak":true},{"text":"ሳሞፔ ዴንዳናይሳን","poem":2},{"lineBreak":true},{"text":"ዳቡራና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሳማሪያ ዴሬን፥ ‹ኣሻሞ›","poem":1},{"text":"ጌቴታ ጼይጌቲዛ","poem":2},{"text":"ኤቃ ጾሳይን ጫቂዛይቲ፥","poem":3},{"text":"‹ዳኔ ጾሳይ ቤዪን›","poem":2},{"text":"ዎይኮ፥ ‹ቤርሳቤሄ","poem":3},{"lineBreak":true},{"text":"ጾሳይ ቤዪን›","poem":3},{"lineBreak":true},{"text":"ጊ ጫቂዛይቲ ዉሪካ ኩንዳና፤","poem":3},{"lineBreak":true},{"text":"ባ ኩንዲዳሶሆፔ ሙሌካ","poem":3},{"lineBreak":true},{"text":"ዴንዳናስ ዳንዳዬቴና» ጌስ።","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/AMO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/AMO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/AMO/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}