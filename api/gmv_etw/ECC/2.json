{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"ECC","translationId":"gmv_etw","name":"ኤራንቻታ ማጻፋ","commonName":"ኤራንቻታ ማጻፋ","title":"ኤራንቻታ ማጻፋ","order":21,"numberOfChapters":12,"sha256":"ef2d039b472f6010481ea3abe3a6997cc818fd9909cac0db2f8841ca1e6b6b71","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/gmv_etw/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":2,"content":[{"type":"heading","content":["ባና ጻላ ሲቆይ ሃዳ"]},{"type":"verse","number":1,"content":["ታኒ ታ ዎዚናን፥ «ኣኔ ታስ ጊታ ኡፋይስ ኢሚዛይ ኣዛኮ፥ ቃሴ ሎኦ ሚሺ ኣዛኮ ኤራናስ ኮያይስ» ጋ ቆፓዲስ፤ ጊዶ ኣቲን ሄሲ ሃዳ።"]},{"type":"verse","number":2,"content":["ቃሴካ፥ «ሚቺ ኤያቴ፤ ኢሻሎሲኔ ኡፋይሳስ ኣይ ጎኣይ ዲዜ?» ጋዲስ።"]},{"type":"verse","number":3,"content":["ሄሲ ዉሪ ሃኒንካ ኣ ኤራቴ ዴማናስ ታ ዎዚናን ኣሞታዳ ታና ዎይኔ ኡሻን ኡፋይሳናሲኔ ኤያቴ ኦይካናስ ባጼታዲስ፤ ቃሴ ኣሳይ ሳኣ ቦላ ዲዛ ቃን ላይን ሳሎ ጉፋንን ዲዛ ሚሽ ኡባ ቦላ ኦዳኮ ኢስታ ጎኢዛዚ ኣዛኮ ታ ኤራና ኮያዲስ።"]},{"type":"verse","number":4,"content":["ሄሳ ጊሻስ ሃራ ኢሲ ጊታ ሚሻታ ኦዲስ፤ ታስ ኬታካ ኬጻዲስ፤ ዎይኔ ቱራካ ቶካዲስ።"]},{"type":"verse","number":5,"content":["ዱማ ዱማ ኣታኪልቴታ፥ ዱማ ዱማ ኣይፌ ኣይፊዛ ሚታ ቶካዲስ፤ ዩዪ ኡፋዬቲዛሶ ጊጊሳዲስ።"]},{"type":"verse","number":6,"content":["ሄ ዲጪዛ ሚታ ኡሻናስ ሃ ኤሊሲዛሶ ዜራ ጊጊሳዲስ።"]},{"type":"verse","number":7,"content":["ኣቱማኔ ማጫ ኣይሌታ ሻማዲስ፤ ታስ ሶን ዬሌቲዳ ሃራ ኣይሌቲካ ዴቴስ፤ ታፔ ካሴ ዬሩሳላሜን ዴኢዳ ኦናፔካ ቦላራ ዳሮ ሜሄ፥ ዴይሺኔ ዶርሳ ዉዴ ሃራዲስ።"]},{"type":"verse","number":8,"content":["ታኒ ዱማ ዱማ ቢታታፔ ጊታ ኣሳታፔኔ ካዎታፔ ኣቆታ፥ ዎርቃኔ ቢራ ታስ ዳጋሳዲስ። ቃሴ ኣዴኔ ማጫ ዬንቻታ ሺሻዲስ፤ ጉጃዳካ ኣሳ ኡፋይሳናስ ዳሮ ማጫ ናይታ ኤሃዲስ።"]},{"type":"verse","number":9,"content":["ሄሳ ጊሻስ ታኒ ታፔ ካሴ ዬሩሳላሜን ዴኢዳ ኦፔኔ ኣዳ ጊታ ኣስ ጊዳዲስ፤ ታ ኣ ኤራቴይካ ታናራ ዴኢዴስ።"]},{"type":"verse","number":10,"content":[{"text":"ታ ኣይፌይ ጼሊዳይሳ ዲጋቤኬ፤","poem":1},{"text":"ታ ዎዚናይ ኣሞቲዳይሳ","poem":2},{"lineBreak":true},{"text":"ኡባ ዲጋቤኬ፤","poem":2},{"text":"ታኒ ኦዳ ኡባ","poem":3},{"lineBreak":true},{"text":"ታ ዎዚናይ ኡፋዬቲዴስ፤","poem":3},{"lineBreak":true},{"text":"ታ ዳቡራስ ዎይ ሄሳ።","poem":3}]},{"type":"verse","number":11,"content":[{"text":"ጊዶ ኣቲን ሄሳ ኡባ","poem":1},{"text":"ኦ ሲማዳ","poem":2},{"lineBreak":true},{"text":"ታኒ ኣኬኪዛ ዎዴ","poem":2},{"lineBreak":true},{"text":"ታኒ ኬሃ ዴማና ጋዳ","poem":2},{"text":"ዳቡርዳ ዳቡራ ኡባ","poem":3},{"lineBreak":true},{"text":"ታ ቆፒዛ ዎዴ ኡባይካ ሃዳ፤","poem":3},{"text":"ሳሎ ጉፋንን","poem":2},{"lineBreak":true},{"text":"ኣይ ዎይካ ዴና፤","poem":2},{"lineBreak":true},{"text":"ኡባይካ ጫርኮ ኦይካናስ","poem":2},{"text":"ዬዴዛ ማላ።","poem":3}]},{"type":"verse","number":12,"content":[{"text":"ሄሳፌ ጉዬ","poem":1},{"text":"ታኒ ኣ ኤራቴ፥","poem":2},{"lineBreak":true},{"text":"ኤያቴኔ ጎሻቴ","poem":2},{"lineBreak":true},{"text":"ኣዛኮ ፒልጋ ኤራናስ","poem":2},{"text":"ቆፋ ዶማዲስ፤","poem":3},{"lineBreak":true},{"text":"ካዎ ሶሆን ካዎቲዳ","poem":3},{"lineBreak":true},{"text":"ሃራ ካዎይ","poem":3},{"lineBreak":true},{"text":"ካሴ ኦሴቲዳይሳፌ","poem":3},{"lineBreak":true},{"text":"ሃራ ኣይ ኦኔ?","poem":3}]},{"type":"verse","number":13,"content":[{"text":"ቱሙካ ፖኦይ","poem":1},{"lineBreak":true},{"text":"ማፔ ሎኢዛ ማላ","poem":1},{"text":"ኣ ኤራቴካ ኤያቴፌ","poem":2},{"text":"ኣዛይሳ ቤኣዲስ።","poem":3}]},{"type":"verse","number":14,"content":[{"text":"ኤራ ኣሳ ኣይፌይ","poem":1},{"text":"ኢዛዴስ ሁኤ ቦላ ዴስ፤","poem":2},{"lineBreak":true},{"text":"ኤያይ ጊዲኮ","poem":2},{"lineBreak":true},{"text":"ማ ጊዶራ ሄሜቴስ፤","poem":2},{"text":"ጊዶ ኣቲን","poem":3},{"lineBreak":true},{"text":"ኢስታ ናምኣ ቃዳይካ","poem":3},{"lineBreak":true},{"text":"ኢሲኖ ጊዲዳይሳ ኣኬካዲስ።","poem":3}]},{"type":"verse","number":15,"content":[{"text":"ታኒ ታ ዎዚናን፥","poem":1},{"text":"«ኤያ ጋኪዛ ቃዳይ","poem":2},{"lineBreak":true},{"text":"ታናካ ጋካና፤","poem":2},{"text":"ሂስቲን ታኒ","poem":3},{"lineBreak":true},{"text":"ኣ ኤራንቻ ጊዶይሳስ","poem":3},{"lineBreak":true},{"text":"ዎይ ኣዜ?» ጋዳ ቆፓዲስ።","poem":3},{"lineBreak":true},{"text":"ቃሴ ታኒ ታ ዎዚናን፥","poem":3},{"lineBreak":true},{"text":"«ሃይሲ ኡባይካ ሃዳ» ጋዲስ።","poem":3}]},{"type":"verse","number":16,"content":[{"text":"ኣ ኤራንቻይካ ኤያዛ ማላ","poem":1},{"text":"ሜርናስ ሃሳኤቴና፤","poem":2},{"lineBreak":true},{"text":"ሲንፌ ያና ላይታን","poem":2},{"lineBreak":true},{"text":"ናምኣይካ ዶጌታና፤","poem":2},{"text":"ኤያይ ሃይቂዛ ማላ","poem":3},{"lineBreak":true},{"text":"ኣ ኤራንቻሲካ","poem":3},{"lineBreak":true},{"text":"ሃይቆይ ኣቴና።","poem":3}]},{"type":"heading","content":["ኣሳ ዳፌቴ ሃዳ"]},{"type":"verse","number":17,"content":["ሳሎ ጉፋንን ሃኒዛ ሚሺ ኡባይ ኢቲዛ ጊሻስ ሃ ሳኣ ዱሳይ ታና ኢቴስ፤ ሄሲ ኡባይካ ሃዳ፤ ጫርኮ ኦይካናስ ዬዴዛ ማላ።"]},{"type":"verse","number":18,"content":["ሳሎ ጉፋንን ታኒ ኬሃ ዳቡራ ዴሚዳ ኡባ ታፔ ጉዬን ዪዛ ዬሌታስ ዬጋዳ ቢዛ ጊሻስ ታኒ ዳቡራ ዴሚዳ ኡባይ ታና ኢቴስ።"]},{"type":"verse","number":19,"content":["ታፔ ጉዬራ ያናይሲ ኢዚ ኣ ኤራንቻ ጊዲን ዎይኮ ኤያ ጊዲን ኦኔ ኤሪዛይ? ኢዚ ኦና ጊዲኮካ ታኒ ኬሃ ዳቡርዳይሳኔ ታ ኣ ኤራቴን ታኒ ዴሚዳ ኡባ ቦላ ጎዳ ጊዳና፤ ሄሲካ ሃዳ።"]},{"type":"verse","number":20,"content":["ሄሳ ጊሻስ ሳሎ ጉፋንን ሃይሳ ኬና ኣይስ ዳቡራዲና ጋዳ ታ ዎዚናን ሂዶታ ቃንጾ ዶማዲስ።"]},{"type":"verse","number":21,"content":["ጋሶይካ ኣሲ ባ ኡባ ኣ ኤራቴን፥ ኤራኒኔ ሂላን ዳቡርዲ ዴሚዳ ኡባ ኣይኮካ ዳቡሮንታ ኣሳስ ኣጊ ቤስ፤ ሄሲካ ሃዳኔ ጊታ ቆሆ።"]},{"type":"verse","number":22,"content":["ሄሳ ጊሻስ ሳሎ ጉፋንን ኣሲ ኬሂ ዳፌቲኮኔ ዳቡርኮ ኢዛስ ኣይ ዎይ ዲዜ?"]},{"type":"verse","number":23,"content":["ኢዚ ባ ዴኦ ላይን ዳቡርዛ ዳቡራይ ኡባይ ዋዬኔ ሜቶ ጻላ፤ ኦማርሲካ ኢዛ ጉጌይ ሼምፖ ዴሜና፤ ሄሲ ኡባይካ ሃዳ።"]},{"type":"verse","number":24,"content":["ኣሳስ ሙሳፌኔ ኡሻፌ ቃሴ ባ ኦዳ ኦሶን ኡፋዬቴፌ ሃራ ሎኢዛ ሚሺ ዴና፤ ሄሲካ ጾሳ ኩሼፔ ኢሜቲዛይሳ ታ ቤያዲስ።"]},{"type":"verse","number":25,"content":["ኢዛ ኣቻፌ ኢሜቶንታ ኣጊኮ ኦኒ ማናሲኔ ኡፋዬታናስ ዳንዳይዜ?"]},{"type":"verse","number":26,"content":["ጾሲ ባና ኡፋይሲዛ ኣሳስ ኣ ኤራቴ፥ ኤራቴኔ ኡፋይስ ኢሜስ፤ ጊዶ ኣቲን ናጋራንቻይ ጾሳ ኡፋይሲዛይታስ ዬጊ ባና ማላ ኣቆታ ዳጋሳናሲኔ ኦናስ ዎልቃ ኢሜስ፤ ሄሲካ ሃዳኔ ጫርኮ ኦይካናስ ዬዴዛ ማላ።"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/ECC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/ECC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/ECC/1.json","previousChapterAudioLinks":{},"numberOfVerses":26}