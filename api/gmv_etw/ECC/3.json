rue},{"text":"ሱሬ ፒርዳ ሶሆን ጌኔይ ዴስ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ታኒካ ታ ዎዚናን፥","poem":1},{"text":"«ኡባ ዮኦሲኔ ኦሶስ","poem":2},{"lineBreak":true},{"text":"ዎዴይ ዲዛ ጊሻስ","poem":2},{"text":"ጾሲ ጺሎዛኔ ዎርዳንቻዛ","poem":3},{"lineBreak":true},{"text":"ፒርዳስ ሺሻና»","poem":3},{"lineBreak":true},{"text":"ጋዳ ቆፓዲስ።","poem":3}]},{"type":"verse","number":18,"content":["ቃሴ ታኒ ታ ዎዚናን፥ «ኣሲ ሜሄ ማላ ጊዲዳይሳ ኢስቲ ኤራና ማላ ጾሲ ፓጬስ።"]},{"type":"verse","number":19,"content":["ኣሳ ቃዳይካ ሜሄይሳ ማላ፤ ናምኣ ቃዳይካ ኢሲኖ፤ ኢሶይ ሃይቂዛ ማላ ሃንኮይሲካ ሃይቄስ፤ ናምኣስካ ኢሲ ቆሞ ፔኖይ ዴስ፤ ሄሳ ጊሻስ ኢዚ ሜሄፔ ዱማቴና፤ ሄሲካ ሃዳ።"]},{"type":"verse","number":20,"content":["ናምኣይካ ኢሲ ሶሆ ቤቴስ፤ ናምኣይካ ቢታፌ ሜቲዳ ጊሻስ ቢታን ሲሜቴስ።"]},{"type":"verse","number":21,"content":["ሂስቲን ኣሳ ሼምፖይ ፑዴ ሳሎ ኬዚዛይሳ፥ ሜሄታ ሼምፖይካ ዱጌ ቢታን ጌሊዛይሳ ኦኔ ኤሪዛይ?» ጋዳ ቆፓዲስ።"]},{"type":"verse","number":22,"content":["ሄሳ ጊሻስ ኣሲ ባ ኦዳ ኦሶን ኡፋይሳፌ ሃራ ኣዛ ሚሺ ባይንዳይሳ ታ ቤኣዲስ፤ ሄሲካ ኣሳስ ኢሜቲዳ ቃዳ፤ ኢዚ ሃይቂዳፔ ጉዬ ኦሴቲዳ ኦሶታ ኢዛ ዛሪ ኤሂዲ ቤሳናይ ኦኔ?"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/ECC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/ECC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/ECC/2.json","previousChapterAudioLinks":{},"numberOfVerses":22}