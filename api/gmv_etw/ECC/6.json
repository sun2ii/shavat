{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"ECC","translationId":"gmv_etw","name":"ኤራንቻታ ማጻፋ","commonName":"ኤራንቻታ ማጻፋ","title":"ኤራንቻታ ማጻፋ","order":21,"numberOfChapters":12,"sha256":"ef2d039b472f6010481ea3abe3a6997cc818fd9909cac0db2f8841ca1e6b6b71","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/gmv_etw/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":["ሳሎ ጉፋንን ሃራ ኢታ ሚሽ ታኒ ቤኣዲስ፤ ሄሲካ ኣሳስ ኬሂ ዴጾ።"]},{"type":"verse","number":2,"content":["ኣሲ ባ ዎዚናን ኣሞቲዳ ሚሽ ዴማና ማላ ጾሲ ኣሳስ ኣቆታ፥ ዱሬቴኔ ቦንቾ ኢሜስ፤ ጊዶ ኣቲን ኬዋይ ኢስታን ኡፋዬታና ማላ ኩሜ ማታ ኢዛስ ኢሜና፤ ኢዚ ዳቡሪ ዴሚዳይሳን ሃራይ ኡፋዬቴስ፤ ሄሲካ ሃዳኔ ኬሂ ኢታ ሚሻ።"]},{"type":"verse","number":3,"content":["ኢሲ ኣሲ ጼቱ ናይታ ጋካናስ ዬሊ ጪሚዲ ኣዱሳ ላይ ዴኣናዉ ዳንዳዬስ፤ ጊዶ ኣቲን ኢዚ ባ ኣቆታን ኡፋዬቶንታ ኣጊኮኔ ሃይቂዲ ዎጋራ ሞጌቶንታ ኣጊኮ ኢዛፔ ኣዉጫያይ ኪያ።"]},{"type":"verse","number":4,"content":["ጋሶይካ ጮ ሃዳ ዪዲ ማን ቤስ፤ ኢዛ ሱንካ ማን ካሜቲዴስ።"]},{"type":"verse","number":5,"content":["ኢዚ ኤሮንታኔ ፖኦ ቤኦንታ ኣጊኮካ ሄ ኣዴዛፔ ኢዛስ ኣ ዎፓይ ዴስ።"]},{"type":"verse","number":6,"content":["ኡፋይሲ ባይንዳ ዲሺን ናምኡ ሺ ላይ ዴኢኮካ ኢዛስ ኣዛ ጎኣይ ዲዜ? ዉርሴን ናምኣይካ ኢሲ ሶሆ ባና ዴቴኔ?"]},{"type":"verse","number":7,"content":[{"text":"ኣሲ ዳቡርዲ ኦዛ","poem":1},{"text":"ኡባይ ኡሎሳ፤","poem":2},{"lineBreak":true},{"text":"ጊዶ ኣቲን ኢዛ ኣሞይ","poem":2},{"text":"ሙሌካ ካሊ ኤሬና።","poem":3}]},{"type":"verse","number":8,"content":[{"text":"ሂስቲን ኣ ኤራንቻይ","poem":1},{"text":"ኤያፔ ኣዛን ኣዜ?","poem":2},{"lineBreak":true},{"text":"ማንቆይ ሃራታ ሲንን","poem":2},{"text":"ዋኒ ሲሜሬታናኮ ኤሮይ","poem":3},{"lineBreak":true},{"text":"ኢዛ ኣይ ማዲዜ?","poem":3}]},{"type":"verse","number":9,"content":[{"text":"ኣሞን ቶይላታናፔ","poem":1},{"text":"ኣይፌን ቤኦይ ኪያ፤","poem":2},{"lineBreak":true},{"text":"ሄሲካ ሃዳኔ ጫርኮ ኦይካናስ","poem":2},{"text":"ዬዴዛ ማላ","poem":3}]},{"type":"verse","number":10,"content":[{"text":"ሃኢ ዲዛ ኡባስ","poem":1},{"text":"ካሴቲ ሱን","poem":2},{"lineBreak":true},{"text":"ኢሜቲ ኡቲዴስ፤","poem":2},{"lineBreak":true},{"text":"ኣሲ ሃናናዚ ኤሬቲ ኡቲዴስ፤","poem":2},{"lineBreak":true},{"text":"ኣሲ ባፔ ሚኒዛይሳራ","poem":2},{"lineBreak":true},{"text":"ባጼቴና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሃሳያይ ዳሪሺን","poem":1},{"text":"ሃዳ ዮኦይ ዳሬስ፤","poem":2},{"lineBreak":true},{"text":"ሂስቲን ሄሲ ኣስ ኣይ ጎኣኔ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሃዳኔ ኤሾ ማላ ኤሌ ኣዛ","poem":1},{"text":"ጉ ላይታን","poem":2},{"lineBreak":true},{"text":"ኣሳስ ሎኦ ሚሺ ሃናናይሳ","poem":2},{"text":"ኤሪዛይ ኦኔ?","poem":3},{"lineBreak":true},{"text":"ቃሴካ ኢዚ ሃይቂዳፔ ጉዬ","poem":3},{"lineBreak":true},{"text":"ሳሎ ጉፋንን ሃኒዛ ሚሽ","poem":3},{"lineBreak":true},{"text":"ኢዛስ ዮታና ዳንዳይዛይ ኦኔ?","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/ECC/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/ECC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/ECC/5.json","previousChapterAudioLinks":{},"numberOfVerses":12}