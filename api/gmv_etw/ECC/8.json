","poem":2},{"lineBreak":true},{"text":"ሊኬ ዎዴይኔ","poem":2},{"text":"ቤሲዛ ኦሶ ኦጌይ ዴስ።","poem":3}]},{"type":"verse","number":7,"content":[{"text":"ሲንፌ ሃናናይሳ","poem":1},{"text":"ኤሪዛይ ዴና፤","poem":2},{"lineBreak":true},{"text":"ሄሳ ጊሻስ","poem":2},{"lineBreak":true},{"text":"ሲንፌ ሃናናይሳ","poem":2},{"text":"ዮታናስ ዳንዳይዛይ ኦኔ?","poem":3}]},{"type":"verse","number":8,"content":[{"text":"ኣሲ ባ ሼምፖ","poem":1},{"text":"ናጊ ኣሻናስ ዳንዳዬና፤","poem":2},{"lineBreak":true},{"text":"ዎይኮ ባ ሃይቃና","poem":2},{"lineBreak":true},{"text":"ጋላሳ ቦላ","poem":2},{"text":"ማታይ ዲዛ ኣሲ ዴና፤","poem":3},{"text":"ኦላ ጋላስ ኦኒካ ኦላ ዬጊዲ","poem":2},{"text":"ጉዬ ሲሞንታይሳ ማላ","poem":3},{"lineBreak":true},{"text":"ኢታ ኦሶይካ","poem":3},{"lineBreak":true},{"text":"ባናራ ሜዜቲዳይታ ዬዴና።","poem":3}]},{"type":"heading","content":["ኢታ ኣሳታ ሃኖታኔ ኪያ ኣሳታ ሃኖታ"]},{"type":"verse","number":9,"content":[{"text":"ሳሎ ጉፋንን","poem":1},{"text":"ሃኒዛ ሚሽ ኡባ","poem":2},{"lineBreak":true},{"text":"ታኒ ፒልጋ ቤኣዲስ፤","poem":2},{"text":"ኣሲ ኣስ ቆሃናስ","poem":3},{"lineBreak":true},{"text":"ዳናቲዛ ዎዴይ ዴስ።","poem":3}]},{"type":"verse","number":10,"content":[{"text":"ቃሴ ኢታቲ ቦንቾን","poem":1},{"text":"ሞጌቲሺኒኔ","poem":2},{"lineBreak":true},{"text":"ጌሻ ካታማን ሳቤቲሺን፥","poem":2},{"text":"ጾሳ ኣሳቲ ጌሻ ካታማን","poem":3},{"lineBreak":true},{"text":"ዶጌቲሺን ታ ቤኣዲስ፤","poem":3},{"lineBreak":true},{"text":"ሄሲ ኡባይካ ሃዳ።","poem":3}]},{"type":"verse","number":11,"content":["ኢታ ኦዳ ኣሳ ቦላ ኤሶን ፒርዶንታ ኣጊኮ ኣሳ ዎዚናይ ኢታ ኦና ሃልቾን ኩሜስ።"]},{"type":"verse","number":12,"content":["ናጋራንቻይ ጼቱቶ ኢታ ሚሽ ኦሺን ኢዛ ላይይ ኣዱቂኮካ፥ ጾሳ ቦንቺዛይታሲኔ ጾሳ ያዪዛይታስ ሎኦይ ሃናናይሳ ታ ኤራይስ።"]},{"type":"verse","number":13,"content":["ጊዶ ኣቲን ኢታቲ ጾሳስ ያዮንታ ጊሻስ ሎኦ ሚሺ ኢስታስ ሃኔና፤ ኢስታ ላይ ኤሾ ማላ ኤሌ ኣና።"]},{"type":"verse","number":14,"content":["ሳኣ ቦላ ኦሴቲዛ ሃራይ ሃዳ ሚሺ ዴስ፤ ሄሲካ ጺሎቲ ኢታታስ ቤሲዛ ቂጻቴ፥ ኢታቲ ጺሎታስ ቤሲዛ ሎኦ ሚሽ ኤኬቴስ። ሄይቲ ኡባይካ ሃዳ።"]},{"type":"verse","number":15,"content":["ሳሎ ጉፋንን ኣሳስ ሙሳፌ፥ ኡሻፌኔ ኡፋዬቴፌ ኣዛ ሃራ ሚሺ ባይንዳ ጊሻስ ባ ዴኦ ላይን ኡፋዬቴ ሎኦ ጋዲስ፤ ሄሳ ጊሻስ ጾሲ ሳሎ ጉፋንን ኢዛስ ኢሚዳ ላይታን ኢዚ ባ ኦሶን ኡፋዬታና።"]},{"type":"verse","number":16,"content":["ታኒ ኣ ኤራቴ ኤራናሲኔ ኣሲ ሃ ሳኣ ቦላን ኦማርሲኔ ጋላስ ስኮይ ባይንዳ ዳቡርዛ ዳቡራ ኤራናስ ታ ዎዚናን ፒልጋዲስ።"]},{"type":"verse","number":17,"content":["ሄሳፌ ጉዬ ጾሲ ኦዳ ኡባ ቤኣዲስ፤ ሳሎ ጉፋንን ኦሴቲዛ ሚሽ ኦኒካ ኤሬና፤ ኣሲ ኬሂ ዳፌቲዲ ፒልጊ ጼሊኮካ ኢዛ ቢርሼ ዴማናስ ዳንዳዬና። ኣ ኤራንቻይ፥ «ታ ኤራይስ» ጊኮካ ኡባ ኤራናስ ዳንዳዬና።"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/ECC/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/ECC/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/ECC/7.json","previousChapterAudioLinks":{},"numberOfVerses":17}