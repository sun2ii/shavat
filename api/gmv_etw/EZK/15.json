{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"EZK","translationId":"gmv_etw","name":"ሂዚቄላ ቲንቢቴ","commonName":"ሂዚቄላ ቲንቢቴ","title":"ሂዚቄላ ቲንቢቴ","order":26,"numberOfChapters":48,"sha256":"b44159411667f31b79393681b743ebc32afee0d84df6da95c65fc3dbb430b693","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/gmv_etw/EZK/48.json","totalNumberOfVerses":1268},"chapter":{"number":15,"content":[{"type":"heading","content":["ዎይኔ ቱራ ሌሚሶ"]},{"type":"verse","number":1,"content":["ጎዳ ቃላይ ታኮ ዪዲ፥"]},{"type":"verse","number":2,"content":["«ሃይሶ ኣሳ ናዉ! ዎይኔ ቱራይ ዎራን ዲዛ ሃራ ሚታ ኡባ ሃጋፌ ኣዛን ኣዜ?"]},{"type":"verse","number":3,"content":["ጎኢዛ ሚሽ ኦናስ ኢዛ ኣኖፔ ኤኬቲ ኤሪዜ? ኢሲ ሚሽ ካቃናስ ኮጫይ ኢዛፔ ኤኬቲ ኤሪዜ?"]},{"type":"verse","number":4,"content":["ኢዚ ኤጻና ማላ ታማን ዬጊዳፔ ጉዬን ናምኡ ባጋ ጼራ ታማይ ሚዲ ጊዶዛ ላቢኮ ሄሲ ጎኣናስ ዳንዳይዜ?"]},{"type":"verse","number":5,"content":["ሎኦ ጊዲ ኡቲዲ ኣይ ጎኣካ ኢሞንታ ኣጊኮ ታማይ ጹጊዳፔኔ ላቢዳፔ ጉዬ ኬሂ ጎኣይ ባይንዳዝ ጊዳና።"]},{"type":"verse","number":6,"content":["«ሄሳ ጊሻስ ኡባ ሃሪዛ ጎዳይ፥ ‹ታኒ ዎራ ሚ ጊዶን ዲዛ ዎይኔ ኣኖ ታማን ኤጻና ማላ ታ ኣ ኢሚዳይሳ ዬሩሳላሜን ዲዛይታካ ኣ ኢማና።"]},{"type":"verse","number":7,"content":["ታኒ ታ ኣይፌሶ ኢታቴን ኢስታ ቦላ ዛራና፤ ኢስቲ ታማፔ ኬሲ ኤኪ ኣቲዳ ጊዲኮካ ቡሮ ኢስታ ታማይ ማና፤ ታኒ ታ ሲን ኢታቴን ኢስታኮ ዛሪዛ ዎዴ ታኒ ጎዳ ጊዲዳይሳ ኢንቴ ኤራና።"]},{"type":"verse","number":8,"content":["ኢስቲ ኣማኔቶንታ ኣጊዳ ጊሻስ ታኒ ቢታዮ ኣሲ ባይንዳ ቡላ ኬሳዲስ› ጌስ» ጊዴስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/EZK/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/EZK/16.json","next