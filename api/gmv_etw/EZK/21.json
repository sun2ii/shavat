2}]},{"type":"verse","number":10,"content":[{"text":"ሌፌቲዳይ ሲፋናስ፥","poem":1},{"text":"ቁጬቲዳይ ዎልቃን ማላ","poem":2},{"lineBreak":true},{"text":"ጶላናሳ።","poem":2},{"lineBreak":true},{"text":"ሂስቲን ሄሲ ኑና","poem":2},{"text":"ዋኒ ኡፋይሳና ዳንዳይዜ?","poem":3},{"text":"ኢዛ ማሻዚ ታ ናዛ","poem":2},{"lineBreak":true},{"text":"ካዎቴ ጉፌ","poem":2},{"text":"ጮ ጉፌ ማላ ካዴስ።","poem":3}]},{"type":"verse","number":11,"content":[{"text":"ኩሼን ኦይካና ማላ","poem":1},{"text":"ማሻይ ቁጬቲዲ ኢሜቲዴስ፤","poem":2},{"lineBreak":true},{"text":"ዎዛይሲ ኩሼን ኦይካናስ","poem":2},{"text":"ማሻይ ሌፌቲዲ ኢሜቲዴስ።","poem":3}]},{"type":"verse","number":12,"content":[{"text":"ሃይሶ ኣሳ ናዉ!","poem":1},{"text":"ሃይሲ ታ ዴሬ ቦላ","poem":2},{"lineBreak":true},{"text":"ኢስራኤሌ ዳናታ","poem":2},{"lineBreak":true},{"text":"ኡባ ቦላ ዪዴስ፤","poem":2},{"lineBreak":true},{"text":"ሄሳ ጊሻስ ዬሆኔ","poem":2},{"lineBreak":true},{"text":"ዋሶ ሲሳ፤","poem":2},{"lineBreak":true},{"text":"ኢስቲ ታ ዴሬዛራ ኢሲፌ","poem":2},{"text":"ማሻስ ኢሜቲዳ፤","poem":3},{"text":"ሄሳስ ኔ ጊሻስ ኔ ቲራ ኢጫ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ቱማፔ ፓጬይ ያና፤","poem":1},{"text":"ኢዛ ማሻይ ካዳ","poem":2},{"lineBreak":true},{"text":"ካዎቴ ጉፌዛስ","poem":2},{"lineBreak":true},{"text":"ዉርሴ ባይንዳ","poem":2},{"text":"ኣጊኮ ዋናኔ?› ጌስ።","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«ሃኢካ ኣሳ ናዉ! ቲንቢቴ ዮታ፤","poem":1},{"text":"ኔ ኩሼካ ባቃ።","poem":2},{"lineBreak":true},{"text":"ማሻይ ናምኡቶ ዎይኮ","poem":2},{"lineBreak":true},{"text":"ሄቶ ሾጮ፤","poem":2},{"lineBreak":true},{"text":"ሄሲካ ኬሂ ዎዛ፥ ሲፊዛኔ","poem":2},{"lineBreak":true},{"text":"ኡባሶራ ኢስታ ዶዲ","poem":2},{"lineBreak":true},{"text":"ኦይኪዳ ማሻ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዎዚና ኡባይ ታሃና ማላ፥","poem":1},{"text":"ኩንዲዛይቲ ዳራና ማላ፥","poem":2},{"lineBreak":true},{"text":"ታኒ ኢስታ ፔንጌታ ኡባን","poem":2},{"text":"ፖፖልኡ ጊዛ ማሻ","poem":3},{"lineBreak":true},{"text":"ዎዲስ።","poem":3},{"text":"ኣዬ ኣና፥ ፖፖልኡ","poem":2},{"lineBreak":true},{"text":"ጋና ማላ ቁጬቲዴስ፤","poem":2},{"lineBreak":true},{"text":"ሲፋናስካ ኮሆፔ","poem":2},{"text":"ሾዴቲዴስ።","poem":3}]},{"type":"verse","number":16,"content":[{"text":"ሃይሶ ማሻዞ!","poem":1},{"text":"ኔ ቃራቲዳ ባጋራ ሃዲርሲኔ","poem":2},{"text":"ኡሻች ቃንጻ።","poem":3}]},{"type":"verse","number":17,"content":[{"text":"ታኒካ ታ ኩሼ ባቃና፤","poem":1},{"text":"ታ ሃንቆይካ ኢርጻና ጋዲስ","poem":2},{"text":"ታኒ ጎዳይ» ጊዴስ።","poem":3}]},{"type":"heading","content":["ባቢሎኔ ካዎዛ ማሻ"]},{"type":"verse","number":18,"content":["ጎዳ ቃላይ ታኮ ዪዲ፥"]},{"type":"verse","number":19,"content":["«ሃይሶ ኣሳ ናዉ! ባቢሎኔ ካዎዛ ማሻይ ዪዛ ናምኡ ኦጌታን ማላታ ቱስ ኤሳ። ናምኡ ኦጌቲካ ኢሲ ዴሬፔ ዶሜቴስ። ካታማ ኤፊዛ ኦጌቲ ሻኬቲዛሶን ማላታ ቱስ ኤሳ።"]},{"type":"verse","number":20,"content":["ኣሞኔታ ካታማ ኤራባ ቢዛ ማሻስ ኢሲ ኦጌዛን ማላታ ቱስ ኤሳ፤ ቃሴ ዩሁዳኔ ጊምቤቲዳ ዬሩሳላሜ ካታማ ቢዛ ማሻስ ናምኣን ኦጌዛን ማላታ ቱስ ኤሳ።"]},{"type":"verse","number":21,"content":["ባቢሎኔ ካዎዚ ባ ባናሶ ማሮ ዴማናስ ዳጋላ ኦጌታን ኤቃና፤ ባ ዎንዳፌታ ቃሴዲ ሳማ ዬጋና፤ ባ ኤቃ ጾሳታካ ዞሬ ኦይቻና፤ ቲሬ ሚጪ ጼላና።"]},{"type":"verse","number":22,"content":["ኢዚ ቢዲ ጊምቤ ፔንጌ ላሊዛ ዱሩማታ ኤሃና ማላ፥ ዎናስ ኣዛዛና ማላ፥ ጬቄቴ ሲሳና ማላ፥ ጊምቤ ፔንጌዛ ላሊዛ ዱሩማታ ካታማታ ፔንጌን ኤሳና ማላ፥ ቢታ ሺሺ ዶራና ማላኔ ሚጻታ ጊጊሳና ማላ ዬሩሳላሜ ሳማይ ኢዛስ ኡሻቻ ኩሼን ኬዚዴስ።"]},{"type":"verse","number":23,"content":["ሄሲካ ኢዛራ ጫቄቲዳ ኣሳታስ ባላ ካሌ ሚሳቲዴስ። ኢዚ ጊዲኮ ኢስታ ቆሆ ኢስታ ቆፍሳና፤ ኢስቲ ዲኢ ኤኪዲካ ባና።"]},{"type":"verse","number":24,"content":["«ሄሳ ጊሻስ ኡባ ሃሪዛ ጎዳይ፥ ‹ኢንቴ ኦዳ ሚሽ ኡባን ኢንቴ ቆንጬራ ናጋራ ኦዲ ኢንቴ ቆሆዛ ኢንቴ ቆፍሲዳ ጊሻሲኔ ሄሳካ ኢንቴ ኦዳ ጊሻስ ኢንቴ ዲኤቲ ባና።"]},{"type":"verse","number":25,"content":["« ‹ሃይሶ ጌኔኔ ቱና ጊዲዳ ኢስራኤሌ ዳናዞ! ኔ ቃጻዬቲዛ ዎዴይ ጋኪዴስ› ጌስ፤ ቱናኒኔ ኢታቴን ኩሚዳ ኢስራኤሌ ዳናዞ፥"]},{"type":"verse","number":26,"content":["ኡባ ሃሪዛ ጎዳይ፥ ‹ኔ ሁኤን ዲዛ ጎሳ ቢርሻ፤ ኔ ካላቻ ዴን። ሃይሳፌ ጉዬ ካሴይሳ ማላ ሃኔና፤ ዚቂ ጊዳይ ቁ ጋና፤ ቁ ጊዳይካ ዚቂ ጋና።"]},{"type":"verse","number":27,"content":["ቡላሳና! ቡላሳና! ኣዋቴ ቤሲዛዴይ ያና ጋካናስ ኢዛ ቤኒ ማላ ሃኑኩ፤ ታ ኢዛስ ኢዞ ኣ ኢማና› ጌስ።"]},{"type":"verse","number":28,"content":["«ሃይሶ ኣሳ ናዉ! ኡባ ሃሪዛ ጎዳይ ኔና ኣሞኔታ ጊሻሲኔ ኢስታ ጫሻ ጊሻስ፥",{"text":"‹ማሻ! ማሻ!","poem":2},{"lineBreak":true},{"text":"ዎናስ ሾዴቲዳ","poem":2},{"lineBreak":true},{"text":"ይሳናስ ቁጬቲዳ፥","poem":2},{"lineBreak":true},{"text":"ዎልቃን ማላ ፖፖልኡ","poem":2},{"text":"ጋና ቁጬቲዳ ማሻ።","poem":3}]},{"type":"verse","number":29,"content":[{"text":"ኔ ጊሻስ ቤኢዳ ዎርዶ ኣጁታይ፥","poem":1},{