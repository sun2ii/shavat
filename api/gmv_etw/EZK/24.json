{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"EZK","translationId":"gmv_etw","name":"ሂዚቄላ ቲንቢቴ","commonName":"ሂዚቄላ ቲንቢቴ","title":"ሂዚቄላ ቲንቢቴ","order":26,"numberOfChapters":48,"sha256":"b44159411667f31b79393681b743ebc32afee0d84df6da95c65fc3dbb430b693","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/gmv_etw/EZK/48.json","totalNumberOfVerses":1268},"chapter":{"number":24,"content":[{"type":"heading","content":["ዲስቴ ሌሚሶ"]},{"type":"verse","number":1,"content":["ኑኒ ዲኤቲዳ ኡዱፉን ላይን፥ ታማን ኣጊናን፥ ታማን ጋላሳን ጎዳ ቃላይ ታኮ ዪዲ፥"]},{"type":"verse","number":2,"content":["«ሃይሶ ኣሳ ናዉ! ሃች ሃኖ ጋላሳዮ ዱማ ማዝጋባ፤ ባቢሎኔ ካዎይ ዬሩሳላሜ ሃ ጋላሳይን ዶዲ ኦይኪዴስ።"]},{"type":"verse","number":3,"content":["ሃ ማካላንቻ ኬስ ሃይሳፌ ካሊ ዲዛ ሌሚሶዛ ዮታ፤ ኡባ ሃሪዛ ጎዳይ፥",{"text":"« ‹ቢራታ ዲስቴ ታማ ቦላ ዎ፤","poem":1},{"text":"ሄሳፌ ጉዬ ኢዛን ሃ ጉጃ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጌዳፔኔ ሚሳፌ ቃንጻዳ፥","poem":1},{"text":"ሎኦ ሎኦ ኣሾ ሙጻዳ፥","poem":2},{"lineBreak":true},{"text":"ዶሬቲዳ ሜቄታ","poem":2},{"lineBreak":true},{"text":"ጩኬሬዳ","poem":2},{"text":"ኢዛን ዬጋ።","poem":3}]},{"type":"verse","number":5,"content":[{"text":"ዉዴዛፔ ሞ ዶርስ","poem":1},{"text":"ኤካ ሹካ፤","poem":2},{"lineBreak":true},{"text":"ኢዛ ሜቄ ዶይሳናስ","poem":2},{"lineBreak":true},{"text":"ኤሶ ሚ ዳርሳ ዎ፤","poem":2},{"lineBreak":true},{"text":"ሱ ጋናሼ","poem":2},{"lineBreak":true},{"text":"ጋካናስ ዶይሳ፤","poem":2},{"lineBreak":true},{"text":"ሜቄዚካ ካጾ› ጌስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«ኡባ ሃሪዛ ጎዳይ፥","poem":1},{"text":"‹ሺኢዳ ቢራታ ዲስቴይስ፥","poem":2},{"lineBreak":true},{"text":"ኢዚ ሺኢ ዬዶንታሪስ፥","poem":2},{"lineBreak":true},{"text":"ሱ ጉሲዳ ካታማይስ","poem":2},{"lineBreak":true},{"text":"ኣዬ ኣና!","poem":2},{"text":"ሻካናስ ሳማ ዬጎንታ","poem":3},{"lineBreak":true},{"text":"ኢሳ ኢሳ ኬሳዳ ካይስ ኣሻ።","poem":3}]},{"type":"verse","number":7,"content":[{"text":"ኢዚ ጊዶን ኣሳ ሱ ዴስ፤","poem":1},{"text":"ዛላ ቦላ ቆንጬሶን","poem":2},{"text":"ጉሳዱስ ኣቲን","poem":1},{"text":"ቢታይ ካማናስ ዳንዳይዛ","poem":2},{"text":"ጋዴን ጉሳቤኩ።","poem":3}]},{"type":"verse","number":8,"content":[{"text":"ታ ሃንቆይ ኤጻና ማላኔ","poem":1},{"text":"ሃሎ ኬሳናስ","poem":2},{"lineBreak":true},{"text":"ታስ ኢንጄታና ማላ፥","poem":2},{"lineBreak":true},{"text":"ኢዚ ካማናስ ዳንዳዮንታ ማላ፥","poem":2},{"lineBreak":true},{"text":"ኢዚ ሱ ዛላ ቦላ","poem":2},{"text":"ቆንጬሶን ጉሳዲስ› ጌስ።","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«ሄሳ ጊሻስ","poem":1},{"text":"ኡባ ሃሪዛ ጎዳይ፥","poem":2},{"lineBreak":true},{"text":"‹ሱ ጉሲዳ ካታማይስ","poem":2},{"lineBreak":true},{"text":"ኣዬ ኣና!","poem":2},{"lineBreak":true},{"text":"ታኒ ኢዛ ጹጌታና","poem":2},{"lineBreak":true},{"text":"ሚ ጉፓና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኤሶ ሚ ዶራ፤","poem":1},{"text":"ታማካ ኤ።","poem":2},{"lineBreak":true},{"text":"ሳዎ ጉጃዳ ኣሾዛ","poem":2},{"lineBreak":true},{"text":"ሎኤ ዶይሳ፤","poem":2},{"lineBreak":true},{"text":"ሜቄዚካ ሚጮ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሺኣዚ ሴራና ማላኔ","poem":1},{"text":"ቢራታ ሺኣዚ","poem":2},{"text":"ታማን ጹጌታና ማላ፥","poem":3},{"text":"ሜላ ዲስቴይ ሴላና ጋካናስ፥","poem":2},{"lineBreak":true},{"text":"ታማዚ ቦንቃናሼ ጋካናስ","poem":2},{"text":"ጮጬዛ ቦላ ዎ።","poem":3}]},{"type":"verse","number":12,"content":[{"text":"ዳሮ ዎልቃይ ዉሪኮካ","poem":1},{"text":"ዶሬቲዳ ቢራታ ሺኢ","poem":2},{"lineBreak":true},{"text":"ታማንካ ዬዳና ዳንዳዬና።","poem":2}]},{"type":"verse","number":13,"content":["« ‹ኔ ቱኒዳይ ኔ ባላጌ ኦሶና፤ ታ ሃንቆይ ኔ ቦላ ፖሌታናሼ ጋካናስ ሃይሳፌ ጉዬ ኔ ጌሽ ጊዳካ፤ ጋሶይካ ታኒ ኔና ኔ ቱናቴፌ ጌሻና ኮዪንካ ኔ ጌያና ዶሳቤካ።"]},{"type":"verse","number":14,"content":["« ‹ታኒ ጎዳይ ሃይሳ ዮታዲስ፤ ታ ኦናስ ዎዴይ ጋኪዴስ፤ ታ ጉዬ ጊኬ፤ ቃቲኬኔ ሲኬ፤ ኔ ኦጌ ማላኔ ኔ ኦሶ ማላ ኔ ቦላ ፒርዴታና› ጌስ» ጊዴስ።"]},{"type":"heading","content":["ሂዚቄላ ማቼይ ሃይቆ"]},{"type":"verse","number":15,"content":["ጎዳ ቃላይ ታኮ ዪዲ፥"]},{"type":"verse","number":16,"content":["«ሃይሶ ኣሳ ናዉ! ኔኒ ኔ ኣይፌ ሼምፒሲዛ ሚሽ ታኒ ታ ሃንቆን ኔፔ ኤካ ዲጋና፤ ኔኒ ጊዲኮ ዋሶፋ፤ ዬኮፋ፤ ኣፉንካ ጉሶፋ።"]},{"type":"verse","number":17,"content":["ኔ ቃላ ዚቂ ሂስታዳ ካዮታሼ ሚላላ ኣቲን ሃይቂዳይሳስ ዬኮፋ፤ ኔ ሁኤፔ ቁራጬ ዲጎፋ፤ ኔ ቶሆፔ ጫማ ኬሶፋ፤ ኔ ዶና ጋ ካሞፋ፤ ሾቺካ ሞፓ» ጊዴስ።"]},{"type":"verse","number":18,"content":["ታኒካ ዎንታራ ዴራስ ሄሳ ዮታዲስ፤ ሄ ጋላሳ ኦማርሳ ዎዴ ታ ኬ ኣዬያ ሃይቃዱስ፤ ዎንቴ ጋላስ ማላዶ ጎዳይ ታና ኣዛዚዳ ማላ ኦዲስ።"]},{"type":"verse","number":19,"content":["ዴሬዚ ታና፥ «ኑስ ኣይ ኪታ ዮታና ኮያዳ ኔ ሃይሳ ኦዳኮ ኑስ ዮቲኪ?» ጊ ኦይቺዴስ።"]},{"type":"verse","number":20,"content":["ታኒካ ዴራስ ዛራዳ፥ «ጎዳ ቃላይ ታኮ ዪዲ፥"]},{"type":"verse","number":21,"content":["ኢስራኤሌ ኬስ ኡባ ሃሪዛ ጎዳይ፥ ‹ኢንቴ ጬቄቲዛ ዎልቃ፥ ኢንቴ ኣይፌ ሼምፒሲዛሶዛኔ ኢንቴ ዎዚናስ ኡፋይስ ጊዲዳ ጾሳ ኬ ታይሳ ታ ቱኒሳና። ኢንቴ ዬጊ ቢዳ ኢንቴ ማጫ ናይቲኔ ኣቱማ ናይቲ ማሻን ዉራና።"]},{"type":"verse","number":22,"content":["ታ ኦዳ ማላ ሄ ዎዴ ኢንቴካ ኦና፤ ኢንቴ ዶና ጋ ካሜኬታ፤ ሾቺካ ሜኬታ።"]},{"type":"verse","number":23,"content":["ኢንቴ ሁኤፔ ቁራጬ ዲጌኬታ፤ ኢንቴ ቶሆፔ ጫማ ኬሴኬታ፤ ኢንቴ ኢንቴ ናጋራን ጊልቃና፤ ኢሶይ ኢሳራ ቶኪ ሼምፓና ኣቲን ካዮስ ኡቴኬታኔ ዬኬኬታ።"]},{"type":"verse","number":24,"content":["ሄ ዎዴን ሂዚቄሊ ኢንቴስ ማላታ ጊዳና፤ ኢዚ ኦዳ ማላ ኢንቴካ ኦና› ጊዴስ። ኡባ ሃሪዛ ጎዳይ ታና ጊዲዳይሳ ሃይሲ ሃኒዛ ዎዴ ኢንቴ ኤራና» ጌስ።"]},{"type":"verse","number":25,"content":["ጎዳይ ታና፥ «ሃይሶ ኣሳ ናዉ! ባንታ ዎልቃ፥ ባንታ ኡፋይሳ፥ ባንታ ቦንቾ፥ ኢስታ ኣይፌስ ሼምፖሶኔ ኢስታ ዎዚናስ ኡፋይስ ጊዲዳ ኢስታ ማጫ ናይታኔ ኣቱማ ናይታ ጋ ታ ኢስታፌ ኤኪዛ ዎዴ፥"]},{"type":"verse","number":26,"content":["ሄ ጋላስ ኬሲ ኤኪ ኣቲዳ ኣሲ ሄ ፓፑን ዮታናስ ኔኮ ያና።"]},{"type":"verse","number":27,"content":["ሄ ጋላስ ኔ ዶናይ ዶዬታና፤ ኔኒካ ኢዛራ ሃሳያና፤ ሄሳፌ ጉዬ ኔ ዶና ዱዴ ጊዳካ፤ ኔ ኢስታስ ማላታ ጊዳና፤ ታኒ ጎዳ ጊዲዳይሳ ኢስቲ ሄ ዎዴ ኤራና» ጊዴስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/EZK/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/EZK/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/EZK/23.json","previousChapterAudioLinks":{},"numberOfVerses":27}