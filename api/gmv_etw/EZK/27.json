2,"content":["«ኬሂ ዳሮ ጊዲዳ ኔ ዱሬቴ ጋሶን ታርሴሴይ ኔናራ ዛልኤን ጋይታዱስ፤ ኢዛ ቢራኔ ቢራታ፥ ቆርቆሮኔ ኢርሳሴ ኤሃዳ ኔ ሻቃጬታ ላሜ ኤካዉስ።"]},{"type":"verse","number":13,"content":["«ያዋኔይ፥ ቱባሌይኔ ሜሼኬይ ኔናራ ኢሲፌ ዛልኤቴስ፤ ኣይሌታኔ ጻርቂማላፔ ኦሴቲዳ ሚሻታ ሻቃጬራ ላሜቴስ።"]},{"type":"verse","number":14,"content":["«ቤቲ-ቶጋርማ ኣሳቲ ጫና ፓራታ፥ ኦላ ፓራታኔ ባቁሎታ ሻቃጬን ላሜቴስ።"]},{"type":"verse","number":15,"content":["«ኤሮዶሴ",{"noteId":4},"ኣሳቲ ዛልኤን ኔናራ ጋይቲዳ፤ ዳሮ ሃሩሮ ዴሬቲ ኔ ሻቃጬታ ዳንጋርሳ ዛሌኒኔ ዞጴ ጌቴቲዛ ሚን ላሜቴስ።"]},{"type":"verse","number":16,"content":["«ኬሂ ዳሮ ጊዲዳ ኔ ኣቆታ ጋሶን ኣራሜይ ኔናራ ዛልኤን ጋይታዱስ፤ ኔ ሻቃጬካ ቤሉሬን፥ ኦቻ ቴራ ሚሳቲዛ ጫርቃን፥ ጺባቤን፥ ሎኦ ላይኖን፥ ሄሌሎኒኔ ዞኦ ኢንቁን ላሜቴስ።"]},{"type":"verse","number":17,"content":["«ዩሁዳይኔ ኢስራኤሌይካ ኣቶንታ ኔናራ ዛልኤን ጋይቲዳ፤ ኢስቲ ሚኒቴፔ ዪዳ ጊስቴ፥ ማሊዶ፥ ኤስ፥ ዛይቴኔ ባላሳኔ ጌቴቲዛ ሊዛ ዛይቴ ኔ ሻቃጬዛራ ላሜቴስ።"]},{"type":"verse","number":18,"content":["«ኔ ዳሮ ዱሬቴኔ ኢሻሎ ዱሳ ጋሶን ዳማስቆ ኣሳቲ ሄልቦኔ ዎይኔ ኡሺኔ ዛሃሬ ዴሬ ዶርሳ ኢስኬ ሺሺዲ ኔናራ ዛልኤቲዳ።"]},{"type":"verse","number":19,"content":["«ኦዜሌን ዲዛ ዳኔይኔ ጊርኬ ኣሳይ ኔ ዱማ ዱማ ሚሻ ሻሚዳ፤ ኢስቲ ኔ ሚሻራ ላማናስ ኣሌቄቲዳ ቢራታ፥ ዱማ ዱማ ሳዎታኔ ቃራፋ ኤሂዳ።"]},{"type":"verse","number":20,"content":["«ዳዳኔይ ኔ ሻቃጬ ጊላሴራ ላማዉስ።"]},{"type":"verse","number":21,"content":["«ኣራቢያ ሃላቃቲኔ ቄዳሬ ሃላቃቲ ኡባይ ኔ ላጌታ፤ ኢስቲ ላቃ፥ ርሾኔ ዴይሼ ኤሂዲ ኔናራ ዛልኤቴስ።"]},{"type":"verse","number":22,"content":["«ሳባ ዛልኣንቻቲኔ ኤራኢሜ ዛልኣንቻቲ ኔናራ ዛልኤቴቴስ፤ ዶሬቲዳ ቂማሜ ኡባ፥ ኣልኦ ሹቺኔ ዎርቃ ሺሺዲ ሻቃጬን ኔናራ ዛልኤቴቴስ።"]},{"type":"verse","number":23,"content":["«ካራኔ፥ ካኔ፥ ኤዴኔ፥ ሳባ፥ ኣሶሬኔ ኪልማዴ ዛልኣንቻቲ ኔናራ ዛልኤቴቴስ።"]},{"type":"verse","number":24,"content":["ሄይቲካ ኔ ጊያ ጊዶን ሎኦ ማይኦ፥ ሳሎ ሚሳቲዛ ካባ፥ ጺባቤ፥ ሄሳካ ቢራታ ቃላሜን ጶሊዛኔ ሚኒ ዳዴቲዳ ሲጋጃ ኤሂዲ ኔናራ ዛልኤቴቴስ።"]},{"type":"verse","number":25,"content":[{"text":"«ታርሴሴ ማርካቤቲ","poem":1},{"text":"ኔ ሻቃጬ ጫኒ ጫኒ ኤፊዳ፤","poem":2},{"lineBreak":true},{"text":"ኔኒ ኣባ ጊዶን ዴጾ ጫና","poem":2},{"text":"ጫኔታዳ ዳሳ።","poem":3}]},{"type":"verse","number":26,"content":[{"text":"ማርካቤ ሶሎሊሲዛይቲ ጪማ","poem":1},{"text":"ኣባ ጊዶን ኔና ኤፊዳ፤","poem":2},{"lineBreak":true},{"text":"ጊዶ ኣቲን ኣርሼይ","poem":2},{"text":"ሞኪዛ ባጋ ጫርኮይ","poem":3},{"lineBreak":true},{"text":"ኣባ ጊዶን","poem":3},{"lineBreak":true},{"text":"ኔና ሜንሬዴስ።","poem":3}]},{"type":"verse","number":27,"