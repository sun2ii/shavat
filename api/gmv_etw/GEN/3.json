{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"GEN","translationId":"gmv_etw","name":"ሜቴ","commonName":"ሜቴ","title":"ሜቴ ማጻፋ","order":1,"numberOfChapters":50,"sha256":"86f26ee6d179e74b035a62ccb6394d1ddc7169d9f6a48fcd5a7a7e8a43984ccf","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/gmv_etw/GEN/50.json","totalNumberOfVerses":1511},"chapter":{"number":3,"content":[{"type":"heading","content":["ኣሲ ኣዛዜቶንታ ኢጾ"]},{"type":"verse","number":1,"content":["ሾሻይ ጎዳ ጾሳይ ሜዳ ዶኣ ኡባፌ ኣዳ ጌናንቻ፤ ኢሲ ጋላስ ሾሻይ ሄ ማጫሳዮ፥ «ጾሲ ቱሙ ኢንቴና፥ ‹ኤዴኔን ዲዛ ሚ ኣይፌ ኡባፌካ ሞፒቴ› ጊዴ?» ጊ ኦይቺዴስ።"]},{"type":"verse","number":2,"content":["ማጫሳያ ሾሻስ ዛራዳ፥ «ጊዴና! ጾሲ ሄሳ ጊቤና፤ ኑኒ ኤዴኔን ዲዛ ሚታ ኣይፌ ማናስ ዳንዳዮስ፤ ጊዶ ኣቲን ጾሲ ኑና፥ ‹ኤዴኔ ጊዶን ዲዛ ሚ ኣይፌ ሞፒቴ፤ ቦቾፍቴ፤ ሂስቶንታ ኣጊኮ ኢንቴ ሃይቃና› ጊዴስ» ጋዱስ።"]},{"type":"verse","number":4,"content":["ሾሻይ ማጫሳዮ፥ «ጊዴና! ኢንቴ ቱማ ሃይቄኬታ፤"]},{"type":"verse","number":5,"content":["ጾሲ ሄሳ ጊዳይ ሄ ሚይ ኣይፌ ኢንቴ ሚኮ ኢንቴ ኣይፌይ ዶዬቲን፥ ጾሳ ማላ ኢንቴ ሎኦኔ ኢታ ሻኪ ኤራናይሳ ኢዚ ኤሪዛ ጊሻሳ» ጊዴስ።"]},{"type":"verse","number":6,"content":["ማጫሳያ ሄ ሚ ኣይፌይ ማናስ ማልኢዛይሳ፥ ጼላናስ ሎኢዛይሳ፥ ቃሴ ኣሲ ኣ ኤራቴ ዴማናስ ኣሞሲዛዝ ጊዲዳይሳ ቤያዳ ሄ ሚ ኣይፌፔ ኤካዳ ማዱስ፤ ቃሴ ባናራ ዲዛ ባ ኣዚናስካ ሄሳፌ ኢሚን ኢዚካ ሚዴስ።"]},{"type":"verse","number":7,"content":["ሚዳ ዎዴ ኢስታ ናምኣ ኣይፌይካ ዶዬቲን ኢስቲ ፓጻ ካሎ ዲዛይሳ ኤሪዲ ባላሴ",{"noteId":3},"ጌቴቲዛ ሚ ሃይ ሲኪዲ ባ ጼሳን ጊጺዳ።"]},{"type":"verse","number":8,"content":["ኦማርሳ ዎዴ፥ ኤዴኔ ጊዶን ጎዳ ጾሳይ ሄሜቲሺን፥ ኢዛ ጬንጉርሳ ኣዴዚኔ ኢዛ ማቼያ ሲዪዲ ጎዳ ጾሳፌ ኤዴኔ ሚ ጊዶን ቆቴቲዳ።"]},{"type":"verse","number":9,"content":["ጊዶ ኣቲን ጎዳ ጾሳይ ኣዴዛ ጼይጊዲ፥ «ኣዳሜ ኣዋን ዳይ?» ጊዴስ።"]},{"type":"verse","number":10,"content":["ኣዴዚካ፥ «ኤዴኔ ጊዶን ኔ ጬንጉርሳ ሲያዳ ታኒ ካሎ ዲዛ ጊሻስ ባባዳ ቆቴታዲስ» ጊዴስ።"]},{"type":"verse","number":11,"content":["ጎዳ ጾሳይ ኢዛ፥ «ኔኒ ካሎ ዳሳ ጊዲ ኔስ ዮቲዳይ ኦኔ? ታኒ ኔና፥ ‹ሞፓ› ጋዳ ኣዛዚዳ ሚ ኣይፌፔ ማዲ?» ጊ ኦይቺዴስ።"]},{"type":"verse","number":12,"content":["ኢዚካ፥ «ታናራ ዳና ማላ ኔ ኢሚዳ ማጫሳያ ሄ ሚ ኣይፌፔ ታስ ኢሚን ማዲስ» ጊዴስ።"]},{"type":"verse","number":13,"content":["ጎዳ ጾሳይ ሄሳፌ ጉዬ ማጫሳዮ፥ «ኔኒ ሄሳ ኣይስ ኦዲ?» ጊ ኦይቺዴስ። ማጫሳያካ፥ «ታና ሾሻይ ባሌን ማዲስ» ጋዱስ።"]},{"type":"heading","content":["ጾሳ ፒርዳ"]},{"type":"verse","number":14,"content":["ጎዳ ጾሳይ ሄሳፌ ጉዬ ሾሻ፥",{"text":"«ኔኒ ሃይሳ ኦዳ ጊሻስ፥","poem":1},{"text":"ሜሄ ኡባኔ","poem":2},{"lineBreak":true},{"text":"ዶኣ ኡባ ጋርሳን","poem":2},{"lineBreak":true},{"text":"ኔ ጻላይ ቃንጌቲዳዛ!","poem":2},{"text":"ኔኒ ኔ ኡሎን ቢታራ ጎሼታና፤","poem":3},{"lineBreak":true},{"text":"ኔ ዴኦ ላይ ኡባንካ","poem":3},{"text":"ቢታ ጉዱላ ላጫ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታኒ ኔሲኔ ማጫሳይስ፥","poem":1},{"text":"ኔ ዜሬሲኔ","poem":2},{"lineBreak":true},{"text":"ኢዚ ዜሬስ ጊዶን","poem":2},{"lineBreak":true},{"text":"ሞርኬቴ ሜና፤","poem":2},{"lineBreak":true},{"text":"ኢዚ ኔ ሁኤ ቆጻና፤","poem":2},{"lineBreak":true},{"text":"ኔኒካ ኢዛ ቂርጴ","poem":2},{"lineBreak":true},{"text":"ዱካና» ጊዴስ።","poem":2}]},{"type":"verse","number":16,"content":["ማጫሳዮካ ጎዳ ጾሳይ፥",{"text":"«ኔ ሻሪዛ","poem":1},{"noteId":4},{"text":"ኣጊናን","poem":1},{"text":"ኔኒ ዳሮ ቱጋታና፤","poem":2},{"lineBreak":true},{"text":"ቃሴ ኔኒ ዎልቃማ ሚጻን","poem":2},{"lineBreak":true},{"text":"ናይታ ዬላና።","poem":2},{"lineBreak":true},{"text":"ጊዲኮካ ኔኒ ኔ ኣዚናራ","poem":2},{"lineBreak":true},{"text":"ኣቃናስ ኣሞታና፤","poem":2},{"lineBreak":true},{"text":"ኢዚካ ኔና ሃራና» ጊዴስ።","poem":2}]},{"type":"verse","number":17,"content":["ኣዳሜካ ጎዳ ጾሳይ፥ «ኔኒ ኔ ማቼይ ቃላ ሲዪዳ ጊሻስ ታኒ ኔና፥ ‹ሄ ሚ ኣይፌ ሞፓ› ጋዳ ኣዛዚዳ ሚ ኣይፌፔ ኔኒ ሚዳ ጊሻስ፥",{"text":"«ኔ ጌዶን ቢታይ","poem":1},{"text":"ቃንጌቲዳዝ ጊዶ!","poem":2},{"lineBreak":true},{"text":"ኔኒ ኔ ዴኦ ላይ ኡባን","poem":2},{"lineBreak":true},{"text":"ጊታ ዳቡራን","poem":2},{"lineBreak":true},{"text":"ቢታ ኦዳ ማና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ቢታይ ኔስ ኣጉንኔ","poem":1},{"text":"ኪንዲቾ ሞኪሳና፤","poem":2},{"lineBreak":true},{"text":"ኔኒ ቢታፌ ሞኪዳይሳ ማና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ኔኒ ቢታን ሲማና ጋካናስ","poem":1},{"text":"ዳቡራን ኔ ጫዋ ጉሳ","poem":2},{"lineBreak":true},{"text":"ኦዳ ማና፤","poem":2},{"text":"ኔኒ ቢታፌ ሜቲዳ ጊሻስ","poem":3},{"lineBreak":true},{"text":"ቢታን ሲማንዳሳ» ጊዴስ።","poem":3}]},{"type":"verse","number":20,"content":["ኣዳሜይ ባ ማቺዮ ሄዋኖ",{"noteId":5},"ጊ ሱንዴስ፤ ኣይስ ጊኮ ኢዛ ኣሳ ኡባስ ኣዮ።"]},{"type":"verse","number":21,"content":["ጎዳ ጾሳይ ኣዳሜሲኔ ኢዛ ማቼይስ ኢቴ ጊግሲዲ ኢስታ ማይዚዴስ።"]},{"type":"verse","number":22,"content":["ሄሳፌ ጉዬ ጎዳ ጾሳይ፥ «ሂስቲን ኣሲ ኑፔ ኢሳዴ ማላ ሎኦኔ ኢታ ኤሪዛዴ ጊዲዴስ፤ ኢዚ ባ ኩሼ ዬዲዲ ዴኦ ኢሚዛ ሚፌ ኤኪዲ ቃሴ ሞንታ ማላኔ ሜርናስ ፓጻ ዴኦንታ ማላ ቴቄታናስ ኮሼስ» ጊዴስ።"]},{"type":"verse","number":23,"content":["ሄሳ ጊሻስ ኢዚ ባ ሜቲዳ ቢታ ኦና ማላ፥ ጎዳ ጾሳይ ኤዴኔፔ ኢዛ ኬሲዴስ።"]},{"type":"verse","number":24,"content":["ኢዛ ኬሲዲ፥ ዴኦ ሚኮ ኤፊዛ ኦጌ ናጋና ማላ፥ ኪሩቤ ጌቴቲዛ ኪታንቻታኔ ፖፖልኡ ጊ ኣ ኣ ዎዛ ታማ ላጮ ሚሳቲዛ ጊ ማሻ ኤዴኔፔ ኣርሼይ ሞኪዛ ባጋራ ዎዴስ።"]}],"footnotes":[{"noteId":3,"caller":"+","text":"3፡7 ባላሴ ጌቴቲዛ ሚይ ቶጵያን ኢሲ ኢሲ ሶሆን ኤሬቲዛ ማላ ኤ ሚሳቲዛ ኢዛስ ሃይይ ኣጉን ባይንዳዝ ጊዲ ኡቲዲ ኢዛስ ኣይፌዚ ማልኢዛ ሚ።","reference":{"chapter":3,"verse":7}},{"noteId":4,"caller":"+","text":"3፡16 ሻሪዛ፡ ሻሪዛ ጊዛይሳ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ኣቤ ኢጼታ፥ ቃን ጌስ።","reference":{"chapter":3,"verse":16}},{"noteId":5,"caller":"+","text":"3፡20 ሄዋኖ፡ ሄዋኖ ጉሲ ፓጻ ዱስ ጉሳ።","reference":{"chapter":3,"verse":20}}]},"thisChapterLink":"/api/gmv_etw/GEN/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/GEN/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/GEN/2.json","previousChapterAudioLinks":{},"numberOfVerses":23}