{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"HEB","translationId":"gmv_etw","name":"ኢብራዌ ኣሳስ","commonName":"ኢብራዌ ኣሳስ","title":"ኢብራዌ ኣሳስ ጻፌቲዳ ኪታ","order":58,"numberOfChapters":13,"sha256":"0044eb398f93d2a656681f10ac208bd139f9fef04eb37c9cfdc6e984e702bfe9","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/gmv_etw/HEB/13.json","totalNumberOfVerses":302},"chapter":{"number":1,"content":[{"type":"heading","content":["ባ ናዛ ባጋራ ጾሲ ዮቲዳ ቃላ"]},{"type":"verse","number":1,"content":["ቤኒ ዎዴፔ ኦይኪዲ ጾሲ ዱማ ዱማ ኦጌራ ናቤታ ባጋራ ካሴ ኑ ኣዋታስ ዳሮ ዎዴ ዮቲዴስ።"]},{"type":"verse","number":2,"content":["ቃሴ ሃይሳ ዉርሴ ዎዴ ቦላ ዉርሲ ላቲሲዳዴኔ ሃ ኣላሜዛ ሜዳ ባ ናዛ ባጋራ ኑስ ዮቲዴስ።"]},{"type":"verse","number":3,"content":["ኢዚካ ጾሳ ቦንቾ ቤሲዛዴኔ ጾሳ ጾሳቴስ ሎኦ ሌሚሶ ጊዲዲ ባ ዎልቃማ ቃላን ዉርሲካ ሺሺ ኦይኪዴስ፤ ኢዚ ኣሳ ናጋራፔ ጌሺዳፔ ጉዬ ሳሎን ቦንቾ ጾሳ ኡሻቻን ኡቲዴስ።"]},{"type":"heading","content":["ኪታንቻታፔ ጾሳ ና ኣ"]},{"type":"verse","number":4,"content":["ሄሳ ጊሻስ ኢዛስ ኢሜቲዳ ሱንይ ኪታንቻታ ሱንፌ ኣዛይሳ ማላ ኢዚካ ኪታንቻታፔ ኬሂ ኣስ።"]},{"type":"verse","number":5,"content":["ጾሲ ኪታንቻፌ፥",{"text":"«ኔኒ ታ ና፤","poem":1},{"text":"ታ ኔና ሃች ዬላዲስ።","poem":2},{"lineBreak":true},{"text":"ዎይኮ ታ ኢዛስ ኣዋ ጊዳና፤","poem":2},{"text":"ኢዚካ ታ ና ጊዳና»","poem":3},{"lineBreak":true},{"text":"ኦናስ ጊዴ?","poem":3}]},{"type":"verse","number":6,"content":["ቃሴካ ጾሲ ባ ባይራ ናዛ ዱጌ ሃ ቢታ ቦላ ዬዲሼ፥ «ጾሳ ኪታንቻቲ ዉሪካ ኢዛስ ጎይኔቶ» ጊዴስ።"]},{"type":"verse","number":7,"content":["ኪታንቻታ ጊሻስ ሃሳይሼ ቃሴ፥ «ኪታንቻታ ኣያናታ፤ ባ ኦሳንቻታካ ታማ ላጮ ኬሴስ» ጊዴስ።"]},{"type":"verse","number":8,"content":["ናዛ ጊሻስ ቃሴ፥ «ጎዶ! ኔ ዙፋኔይ ሜርናፔ ሜርና ጋካናስ ሚኒ ዳና፤ ኔኒ ኔ ካዎቴ ሊኬ ካሌሳ።"]},{"type":"verse","number":9,"content":["ኔኒ ጺሎቴ ዶሳዳሳ፤ ማካላካ ኢጻሳ፤ ሄሳ ጊሻስ ጾሲ ኔ ጎዳይ ኔና ኔ ላጌታፔ ቦላ ኬሲዴስ፤ ኔና ኡፋይሳ ዛይቴ ቲይዴስ» ጌስ።"]},{"type":"verse","number":10,"content":["ቃሴ፥ «ጎዶ! ኮይሮ ኔኒ ቢታ ሜዳሳ፤ ሳሎቲካ ኔ ኩሼን ኦሴቲዳ።"]},{"type":"verse","number":11,"content":["ኢስቲ ያና፤ ኔኒ ጊዲኮ ሚና ዳና፤ ኢስቲ ዉሪካ ማይኦ ማላ ጋልኣና።"]},{"type":"verse","number":12,"content":["ኔኒ ኢስታ ማይኦ ማላ ቃላምኣና፤ ኢስቲካ ማይኦ ማላ ላሜታና፤ ኔ ጊዲኮ ኣይዴካ ኔኒ ኔና፤ ኔ ዱሳስ ዉርሴ ዴና» ጌስ።"]},{"type":"verse","number":13,"content":["ጾሲ ኪታንቻታፔ፥ «ታኒ ኔ ሞርኬታ ኔ ቶሆ ጋርሳን ዬሳና ጋካናስ ኔ ታ ኡሻቻን ኡታ» ኦና ጊዴ?"]},{"type":"verse","number":14,"content":["ኪታንቻቲ ዉሪካ ኣቶቴ ላታና ኣሳታ ኦናስ ጾሳፌ ኪቴቲዛ ኦሳንቻ ኣያና ጊዴቴኔ?"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}