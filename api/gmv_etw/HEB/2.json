{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"HEB","translationId":"gmv_etw","name":"ኢብራዌ ኣሳስ","commonName":"ኢብራዌ ኣሳስ","title":"ኢብራዌ ኣሳስ ጻፌቲዳ ኪታ","order":58,"numberOfChapters":13,"sha256":"0044eb398f93d2a656681f10ac208bd139f9fef04eb37c9cfdc6e984e702bfe9","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/gmv_etw/HEB/13.json","totalNumberOfVerses":302},"chapter":{"number":2,"content":[{"type":"heading","content":["ጊታ ማሮቴ"]},{"type":"verse","number":1,"content":["ሄሳ ጊሻስ ኑኒ ሲዪዳ ቃላፔ ባሌቲዲ ኩንዶንታ ማላ ኑ ሲዪዳ ቃላ ሎኤ ናጋናስ ቤሴስ።"]},{"type":"verse","number":2,"content":["ኣዛስ ጊኮ ካሴ ኪታንቻታ ባጋራ ዮቴቲዳ ቃላይ ቱሙ ጊዲዳ ሄ ቃላ ዬ ኣዳይ ባስ ቤሲዛ ቂጻቴ ኤኬስ።"]},{"type":"verse","number":3,"content":["ኑ ቃሴ ሄሳ ማላ ጊታ ማሮቴ ጮ ሌፒ ሂስቲኮ ዋኒ ኣታኔ? ሃይሲ ማሮቴይ ኮይሮ ጎዳ ባጋራ ኑስ ዮቴቲዴስ፤ ኢዛፔ ሲዪዳይቲካ ኑስ ጌሺ ዮቲዳ።"]},{"type":"verse","number":4,"content":["ጾሲ ቃሴካ ማላታታ፥ ማላሊሲዛ ሚሻታ፥ ዱማ ዱማ ማላታታ ኦሶኒኔ ባ ሼኔ ማላ ኢሚዳ ጺሎ ኣያና ኢሞታታ ባጋራ ኢስታ ማርካቴ ሚንዴስ።"]},{"type":"heading","content":["ኣሳ ዜሬ ኣሺዳይ ዬሱሳ"]},{"type":"verse","number":5,"content":["ጾሲ ሃይሳ ኑ ኢዛ ጊሻስ ሃሳይዛ ቡሮ ያና ኣላሜዛ ኪታንቻስ ሃሪሲቤና።"]},{"type":"verse","number":6,"content":["ጊዶ ኣቲን ጌሻ ማጻፋይ ሃራሶን፥",{"text":"«ኔ ኢዛስ ዩሻ ቆፓናስ","poem":1},{"text":"ኣሲ ኣዜ?","poem":2},{"lineBreak":true},{"text":"ኢዛስ ኔ ቆፓናስ ኣሳ ናይ","poem":2},{"lineBreak":true},{"text":"ኢዚ ኣዜ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኔ ኢዛ ኪታንቻታፔ","poem":1},{"text":"ጉራ ጉዳሳ።","poem":2},{"lineBreak":true},{"text":"ቦንቾ ዛዉዴኔ ጋላታ","poem":2},{"lineBreak":true},{"text":"ኢዛ ሁኤን ዎዳሳ።","poem":2},{"lineBreak":true},{"text":"ኔኒ ኢዛ ኔ ኩሼ","poem":2},{"lineBreak":true},{"text":"ኦሶታ ቦላ ሹማዳሳ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኔ ዉርሳካ ኢዛ ቶሆ","poem":1},{"text":"ጋርሳን ሃሪሳዳሳ፤","poem":2},{"lineBreak":true},{"text":"ጾሲ ኡባካ ኢዛፔ ጋርሳራ","poem":2},{"lineBreak":true},{"text":"ኢዛስ ሃሪሲሺን","poem":2},{"text":"ኣቲዳይ ኣይ ሚሺካ ዴና።","poem":3},{"text":"ሃኢ ቃሴ","poem":2},{"lineBreak":true},{"text":"ዉሪካ ኢዛስ ሃሬቲሺን","poem":2},{"text":"ኑ ቤዪቤኮ» ጊዴስ።","poem":3}]},{"type":"verse","number":9,"content":["ጊዶ ኣቲን ጾሳ ኪያቴን ኣሳ ኡባ ጊሻስ ሃይቃናስ ኪታንቻታፔ ጉ ዎዴ ጉጺዳ ዬሱሲ ዋዬ ሃይቆ ሃይቂዲ ሃኢ ቦንቾኔ ጋላታ ዛዉዴ ባ ሁኤን ዎዳይሳ ኑ ቤዮስ።"]},{"type":"verse","number":10,"content":["ሃኒዛይ ዉሪካ ኢዛፔ ኢዛስ ሜቲዳ ጾሲ ዳሮ ናይታ ቦንቾስ ኤፋናስ ኢስታ ማሮቴስ ሁኤ ጊዲዳ ዬሱሲ ዋዬን ፖላናስ ኮሺዛዝ ጊዲዴስ።"]},{"type":"verse","number":11,"content":["ኣስ ጌሺዛይኔ ኢዛን ጌይዛ ኣሳይ ሄይቲ ኢሲ ኬ ኣሳታ። ሄሳ ጊሻስ ዬሱሲ ኢስታ፥ «ታ ኢሻቶ» ጊ ጼይጋናስ ዬላቴና።"]},{"type":"verse","number":12,"content":["«ታኒ ኔ ሱንን ታ ኢሻታስ ዮታና ሺቂዳ ዴሬዛ ሲንን ኔና ጋላቲዛ ማዛሙሬ ታ ዬጻና።»"]},{"type":"verse","number":13,"content":["ሄሳካ፥ «ታ ኢዛን ኣማኔታና» ቃሴካ፥ «ታኒኔ ታስ ጾሲ ኢሚዳ ናይቲ ኑ ሃን ዶስ» ጌስ ጌሻ ማጻፋይ።"]},{"type":"verse","number":14,"content":["ናይታስ ኣሾይኔ ሱ ዲዛ ማላ ኢዚካ ኢስታ ማላ ኣሳ፤ ሄሲካ ሃይቆ ቦላ ኢዛስ ዎልቃይ ዲዛ ዳቡሎሳ ኢዚ ባ ሃይቆ ዎልቃን ዛራናሳ።"]},{"type":"verse","number":15,"content":["ሄሳካ ባ ዲዛ ዎዴ ኡባን ሃይቆስ ባቦን ሃሬቲ ቃሼቲዳይታ ሃይቆፔ ዎዛናሳ።"]},{"type":"verse","number":16,"content":["ኢዚ ሃ ዪዳይ ኪታንቻታ ማዳናስ ጊዶንታ ኣብራሃሜ ዜሬታ ማዳናስ ዪዴስ።"]},{"type":"verse","number":17,"content":["ሄሳ ጊሻስ ኡባ ባጋራ ኢዚ ባ ኢሻታ ሚሳታናስ ቤሲዛዴ ጊዲዴስ፤ ኢዚ ሄሳ ኦዳይ ማሪዛዴኔ ኣማኔቲዳ ዋና ቄሴ ሃላቃ ጊዲዲ ጾሳስ ኦናሲኔ ዴሬዛ ናጋራፔ ማራናሳ።"]},{"type":"verse","number":18,"content":["ኢዚ ባ ሁኤን ፓጬቲዲ ሜቶ ኤኪዳ ጊሻስ ፓጬቲዛይታ ማዳናስ ዳንዳዬስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/HEB/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/HEB/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/HEB/1.json","previousChapterAudioLinks":{},"numberOfVerses":18}