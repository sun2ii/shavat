{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"HEB","translationId":"gmv_etw","name":"ኢብራዌ ኣሳስ","commonName":"ኢብራዌ ኣሳስ","title":"ኢብራዌ ኣሳስ ጻፌቲዳ ኪታ","order":58,"numberOfChapters":13,"sha256":"0044eb398f93d2a656681f10ac208bd139f9fef04eb37c9cfdc6e984e702bfe9","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/gmv_etw/HEB/13.json","totalNumberOfVerses":302},"chapter":{"number":3,"content":[{"type":"heading","content":["ዬሱሲ ሙሴፔ ኣስ"]},{"type":"verse","number":1,"content":["ሄሳ ጊሻስ ሳሎፔ ጼይሲ ኢንቴና ጋኪን ኣማኒዛ ኑ ኢሻቶ! ኑ ኣማኖስ ሃዋሬኔ ቄሴታ ሃላቃ ጊዲዳ ዬሱሳ ቆፒቴ።"]},{"type":"verse","number":2,"content":["ሙሴይ ጾሳ ኬ ኡባ ቦላ ኣማኔቲዳዴ ጊዲዳ ማላ ዬሱሲካ ባና ሹሚዳዴስ ኣማኔቲዳዴ።"]},{"type":"verse","number":3,"content":["ኬ ኬጺዳዴስ ኬፌ ቦላራ ቦንቾይ ዲዛ ማላ ዬሱሳስካ ሙሴፔ ኣዛ ቦንቾይ ቤሲዛዴ ጊዳናስ ቤሴስ።"]},{"type":"verse","number":4,"content":["ኬ ኡባሲካ ኬጺዳዴይ ዴስ፤ ጊዶ ኣቲን ዉርሲካ ኦዳይ ጾሳ።"]},{"type":"verse","number":5,"content":["ሙሴይ ቲንቢቴ ማርካቲሼ ጾሳ ኬ ኡባ ቦላ ኢሲ ኣማኔቲዳ ኦሳንቻ ማላ ጊዲ ዴኢዴስ።"]},{"type":"verse","number":6,"content":["ኪርስቶሲ ጊዲኮ ጾሳ ኬ ቦላ ኣማኔቲዳ ና ማላ። ኑኒካ ኢዛ ቦላ ኣማኔቲዛ ኡፋይሳይኔ ጬቄቲዛ ሂዶታ ሎኤ ኦይኪኮ ኑ ኢዛስ ዱሳ ኬ።"]},{"type":"heading","content":["ጾሳ ኣሳስ ኢሜቲዳ ቆፊሶ ቃላ"]},{"type":"verse","number":7,"content":["ሄሳ ጊሻስ ጺሎ ኣያናይ ጊዛ ማላ፥",{"text":"«ኢንቴ ሃች ኢዛ ቃላ ሲዪኮ","poem":1}]},{"type":"verse","number":8,"content":[{"text":"ባዞ ቢታን ኢንቴ ታና","poem":2},{"lineBreak":true},{"text":"ፓጪዳ ዎዴ ማካሊዳይሳ","poem":2},{"text":"ኢንቴ ዎዚና","poem":3},{"text":"ሙሚሶፒቴ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኢንቴ ኣዋቲ ካሴ","poem":1},{"text":"ሄን ታና ፓጪዳኔ","poem":2},{"lineBreak":true},{"text":"ታናራ ኤቄቲዳ።","poem":2},{"lineBreak":true},{"text":"ታ ኦዳይሳ ዉርሲ","poem":2},{"text":"ኦይዱ ታሙ ላይ","poem":3},{"text":"ጋካናስ ቤኢዳ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሄ ዎዴ ዬሌታታ ቦላ","poem":1},{"text":"ታ ሃንቄቲን","poem":2},{"lineBreak":true},{"text":"ኢስታ ዎዚናይ ኡባ ዎዴ","poem":2},{"lineBreak":true},{"text":"ባሌቴስ፤","poem":2},{"lineBreak":true},{"text":"ኢስቲ ታ ኦጌ ኤሪቤቴና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ቃሴ፥ ‹ታ ኢስታስ ኢሚዛ ሼምፖሶ","poem":1},{"text":"ኢስቲ ሙሌካ ጌሌቴና!›","poem":2},"ጋዳ ታኒ ታ ሃንቆን ጫቃዲስ» ጌስ።"]},{"type":"verse","number":12,"content":["ታ ኢሻቶ! ኢንቴፌ ኦኒካ ዴኦ ጾሳፌ ሃራሶ ኢንቴና ሃሲዛ ኢታኔ ኣማኖንታ ዎዚናይ ዶንታ ማላ ናጌቲቴ።"]},{"type":"verse","number":13,"content":["ሃራፔካ ኢንቴ ጋርሳፌ ኦኒካ ናጋራን ባሌቲዲ ባ ዎዚና ሙሚሶንታ ማላ፥ «ሃች» ጌቴቲሺን ሃች ሃች ኢንቴ ኢንቴ ጋርሳን ሚኔቲቴ።"]},{"type":"verse","number":14,"content":["ኑስ ካሴ ኮይሮፔ ዲዛ ኣማኖ ኑኒ ዉርሴ ጋካናስ ሎኤ ሚን ኦይኪኮ ኑኒ ኪርስቶሳራ ኢሲፌ ላታና።"]},{"type":"verse","number":15,"content":["ሄሲካ፥ «ኢንቴ ሃች ኢዛ ቃላ ሲዪኮ ካሴ ማካሊዳይታይሳ ማላ ሃኢካ ኢንቴ ዎዚና ኢንቴ ሚንንታ ማላ» ጌቴቲ ጌሻ ማጻፋን ጻፌቲዳይሳ ሃኒዴስ።"]},{"type":"verse","number":16,"content":["ሲዪዲ ማካሊዳይቲ ኢስቲ ኦናንቴ? ሙሴይ ጊብጼፔ ካሌ ኬሲዳይታ ኡባታ ጊዴቴኔ?"]},{"type":"verse","number":17,"content":["ጾሲ ኢስታ ቦላ ኦይዱ ታሙ ላይ ሃንቄቲዳይቲ ኢስቲ ኦናንቴ? ናጋራ ኦን ኢስታ ኣሃይ ባዞ ቢታን ኩንዲ ኣቲዳይታ ጊዴቴኔ?"]},{"type":"verse","number":18,"content":["ኢዛስ ኣዛዜቶንታ ኢጺዳይታፔ ኣቲን ኢዛ ሼምፖሶ ጌሎንታ ማላ ኢዚ ጫቂ ዲጊዳይ ሃራይ ኦናንቴ?"]},{"type":"verse","number":19,"content":["ሄሳ ጊሻስ ኢስቲ ጌሎንታ ኣቲዳይ ኣማኖይ ባይንዳ ጊሻስ ጊዲዳይሳ ኑ ኤሮስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/HEB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/HEB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/HEB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}