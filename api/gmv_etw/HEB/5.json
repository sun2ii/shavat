{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"HEB","translationId":"gmv_etw","name":"ኢብራዌ ኣሳስ","commonName":"ኢብራዌ ኣሳስ","title":"ኢብራዌ ኣሳስ ጻፌቲዳ ኪታ","order":58,"numberOfChapters":13,"sha256":"0044eb398f93d2a656681f10ac208bd139f9fef04eb37c9cfdc6e984e702bfe9","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/gmv_etw/HEB/13.json","totalNumberOfVerses":302},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":["ቄሴታ ሃላቃ ጊዲ ሹሜቲዛዴይ ዳሮ ኣሳ ጊዶፌ ዶሬቴሲኔ ኣሳ ጊሻስ ጊዲዲ ኢሞታኔ ናጋራ ጊሻስ ያርሾ ሺሻናስ ዶሬቴስ።"]},{"type":"verse","number":2,"content":["ኢዚካ ባ ባጋራ ዳቡራንቻ ጊዲዳ ጊሻስ ኤሮንታ ኣሳታሲኔ ኦጌ ባሊዳይታስ ቃታና ዳንዳዬስ።"]},{"type":"verse","number":3,"content":["ኢዚ ባ ናጋራ ጊሻሲኔ ሃራ ኣሳታ ናጋራ ጊሻስ ያርሾ ሺሻናስ ኢዛስ ቤሲዛይ ሄሳ ጊሻሳ።"]},{"type":"verse","number":4,"content":["ኣሮኔይ ጼይጌቲዳይሳ ኢዚ ጾሲ ጼይጊዳዴ ጊዳናስ ቤሴስ ኣቲን ሄሳ ሄ ቦንቾዛ ባርካ ባስ ኤኪዛዴይ ዴና።"]},{"type":"verse","number":5,"content":["ሄሳካ ኪርስቶሲ ቄሴታ ሃላቃ ጊዳና ቦንቾ ባርካ ባስ ኤኪቤና፤ ጊዶ ኣቲን፥",{"text":"«ኔ ታ ናኮ፤","poem":1},{"text":"ታ ኔስ ሃች ኣዋ ጊዳዲስ»","poem":2},{"lineBreak":true},{"text":"ጊዳ ጾሳፌ ኤኪዴስ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሄሳካ ሃራሶን","poem":1},{"text":"«ማልኬጼዴቄ ሹሜታ ማላ","poem":2},{"lineBreak":true},{"text":"ኔኒ ሜርናስ","poem":2},{"lineBreak":true},{"text":"ቄሴታ ሃላቃ» ጌስ።","poem":2}]},{"type":"verse","number":7,"content":["ዬሱሲ ሃይሳ ቢታ ቦላ ዲዛ ዎዴ ኢዛ ሃይቆፔ ኣሻና ዳንዳይዛይሳኮ ኣፉንጺሼ ቃላ ቁ ሂስቲ ዎሲዴስ። ኣዳፌ ኣሽኬቴራ ኢዚ ኣዛዜቲዳ ጊሻስ ኢዛ ዎሳካ ጾሲ ሲዪዴስ።"]},{"type":"verse","number":8,"content":["ኢዚ ጾሳ ና ጊዲኮካ ባ ኤኪዳ ዋዬዛፔ ኣዛዜቴ ታማርዴስ።"]},{"type":"verse","number":9,"content":["ሄሳ ባጋራ ፓጬይ ባይንዳዴ ጊዲ ቤቲዳይሳፌ ጉዬ ባስ ኣዛዜቲዛይታስ ኡባስ ሜርና ኣቶቴስ ጋሶ ጊዲዴስ።"]},{"type":"verse","number":10,"content":["ማልኬጼዴቄ ሹሜቴ ማላ ቄሴታ ሃላቃ ጌቴቲ ጾሳን ሹሜቲዴስ።"]},{"type":"heading","content":["ኣማኖን ሚናና ማላ ኢሜቲዳ ቆፊሶ"]},{"type":"verse","number":11,"content":["ሄሳ ጊሻስ ኑ ሃሳያና ሚሺ ቡሮ ዳሮይ ዴስ፤ ጊዶ ኣቲን ኢንቴ ዶታኣታ ጊዲዳ ጊሻስ ኢንቴና ኤሪሶይ ሜቶ።"]},{"type":"verse","number":12,"content":["ኢንቴ ሃኒ ዎዴ ኣስታማሬ ጊዳናስ ቤሲሺን ጾሳ ቃላ ቡሮ ኮይሮፔ ዴንዲ ኢንቴና ታማርሲዛ ኣስ ኢንቴስ ኮሼስ። ኢንቴስ ሚኖ ካ ጊዶንታ ማ ኮሼስ።"]},{"type":"verse","number":13,"content":["ማ ፓሄቲዛይ ቂ ጉ ና ጊዲዛ ጊሻስ ሎኦኔ ኢታ ሻኪዛ ቲሚርቴ ሻኪ ኤሬና።"]},{"type":"verse","number":14,"content":["ሚኖ ካ ጊዲኮ ሎኦኔ ኢታ ሻኪ ኤራናስ ዳንዳይዛ ዎዚና ኩንዳ ኣሳታሳ።"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/HEB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/HEB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/HEB/4.json","previousChapterAudioLinks":{},"numberOfVerses":14}