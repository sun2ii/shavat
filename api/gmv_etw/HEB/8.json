{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"HEB","translationId":"gmv_etw","name":"ኢብራዌ ኣሳስ","commonName":"ኢብራዌ ኣሳስ","title":"ኢብራዌ ኣሳስ ጻፌቲዳ ኪታ","order":58,"numberOfChapters":13,"sha256":"0044eb398f93d2a656681f10ac208bd139f9fef04eb37c9cfdc6e984e702bfe9","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/gmv_etw/HEB/13.json","totalNumberOfVerses":302},"chapter":{"number":8,"content":[{"type":"heading","content":["ኦራ ጫቆ ቄሴ ሃላቃ ዬሱሳ"]},{"type":"verse","number":1,"content":["ሄሳ ጊሻስ ኑ ሃኢ ኦና ዋና ዮኦይ ሃይሳ፤ ሃይሳ ማላ ሳሎ ቦላ ጾሳ ቦንቾ ኣልጋ ኡሻቻን ኡቲዳ ቄሴታ ሃላቃይ ኑስ ዴስ።"]},{"type":"verse","number":2,"content":["ኢዚ ኣሲ ቶኪዳ ዱንካኔ ጊዶን ኦዛዴ ጊዶንታ ጎዳ ጾሳይ ቶኪዳ ቱሙ ዱንካኔን ጌሻሶሆን ኦዛዴ።"]},{"type":"verse","number":3,"content":["ቄሴታ ሃላቃይ ሹሜቲዛይ ኣሳይ ጾሳስ ኢሚዛይሳ ጾሳስ ሺሻናሲኔ ያርሾ ያርሻናሳ፤ ሄሳ ጊሻስ ሃይሲ ሃ ቄሴታ ሃላቃይካ ጾሳስ ሺሻናስ ኢሲ ሺሺዛ ሚሽ ኢዛስ ኮሼስ።"]},{"type":"verse","number":4,"content":["ኢዚ ቢታ ቦላ ዲዛኮ ቄሴ ጊዴና፤ ኣዛስ ጊኮ ዎጋይ ጊዛ ማላ ያርሾ ሺሺዛ ሃራ ቄሴቲ ዴቴስ።"]},{"type":"verse","number":5,"content":["ኢስቲ ካሴ ሳሎን ዲዛ ጾሳ ኬይስ ሌሚሶኔ ኤሾ፤ ሙሴይ ዱንካኔዛ ኦና ጊሺን፥ «ኔስ ዙማ ቦላ ቆንጪዳይሳ ዉርሳ ኦናስ ናጌታ» ጊዛ ኣዛዞይ ሄሳ ጊሻስ ኢዛስ ኢሜቲዴስ።"]},{"type":"verse","number":6,"content":["ጊዶ ኣቲን ዬሱሲ ጊዶ ጌሊ ጋናቲዛይ ጫቆ ቃላይ ካሴይሳፌ ኣዛይሳ ማላ ኢዚ ኤኪዳ ኦሶይካ ካሴይታ ኦሶፔ ኣስ፤ ሄሲካ ካሴይሳፌ ሎኢዛ ሂዶታ ቃላና።"]},{"type":"verse","number":7,"content":["ካሴ ጫቆ ቃላን ፓጬይ ባይንዳኮ ናምኣን ሃራ ጫቃናስ ኮሼና።"]},{"type":"verse","number":8,"content":["ጊዶ ኣቲን ጾሲ ዴሬዛ ቦላ ፓጬይ ዲዛይሳ ዴሚዳ ጊሻስ፥ «ኢስራኤሌ ኣሳራኔ ዩሁዳ ኣሳራ ታኒ ኦራ ጫቆ ጫቄታና ዎዴይ ያና።"]},{"type":"verse","number":9,"content":["ሄሲካ ታ ኢስታ ጊብጼፔ ኬሳናስ ኢስታ ኩሼ ኦይካዳ ካሴ ኢስታ ኣዋታራ ጫቄቲዳ ቃላ ማላ ጊዴና፤ ጋሶይካ ኢስቲ ካሴ ታ ጫቆ ቃላን ኤቂቤቴና፤ ታኒካ ኢስታ ዬዳ ቤሳዲስ።"]},{"type":"verse","number":10,"content":[{"text":"«ሄሳፌ ጉዬ","poem":1},{"text":"ኢስራኤሌ ኣሳራ","poem":2},{"lineBreak":true},{"text":"ታ ጫቄታና ቃላይ","poem":2},{"lineBreak":true},{"text":"ሃይሳ ማላ ጌስ ጎዳይ።","poem":2},{"lineBreak":true},{"text":"ታኒ ታ ዎጋ","poem":2},{"lineBreak":true},{"text":"ኢስታ ዎዚናን ዎና፤","poem":2},{"lineBreak":true},{"text":"ኢስታ ዎዚና ቦላካ ጻፋና።","poem":2},{"lineBreak":true},{"text":"ታ ኢስታ ጾስ ጊዳና፤","poem":2},{"lineBreak":true},{"text":"ኢስቲካ ታ ዴሬ ጊዳና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሃይሳፌ ጉዬ ኣሲ","poem":1},{"text":"ባ ጉታ ኣሳ ዎይኮ","poem":2},{"lineBreak":true},{"text":"ባ ኢሻ፥ ‹ኔ ጎዳ ኤራ›","poem":2},{"lineBreak":true},{"text":"ጊ ታማርሴና።","poem":2},{"lineBreak":true},{"text":"ጋሶይካ ኣሲ ጉፌ","poem":2},{"lineBreak":true},{"text":"ጊታታ ጋካናስ","poem":2},{"text":"ዉሪካ ታና ኤራና።","poem":3}]},{"type":"verse","number":12,"content":[{"text":"ኢስታ ቆሆዛ ታ ማራና።","poem":1},{"text":"ሃይሳፌ ሲንን ታ ኣሳ ናጋራ","poem":2},{"text":"ናምኣን ዛራ","poem":3},{"lineBreak":true},{"text":"ቆፒኬ» ጌስ።","poem":3}]},{"type":"verse","number":13,"content":["ሃይሳ ሃ ጫቆዛ ኢዚ፥ «ኦራ ጫቆ» ጊዲ ካሴ ጫቆዛ ጋልኣ ኬሲዴስ፤ ሄሳ ጊሻስ ጋልኢዲ ዉሪዳይሲ ያና ዎዴይ ማቲዴስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/HEB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/HEB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/HEB/7.json","previousChapterAudioLinks":{},"numberOfVerses":13}