{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"HOS","translationId":"gmv_etw","name":"ሆሴኤ ቲንቢቴ","commonName":"ሆሴኤ ቲንቢቴ","title":"ሆሴኤ ቲንቢቴ","order":28,"numberOfChapters":14,"sha256":"c6b1fd83ed91ea34ba4271c5f6c336eefe06ad9dfe8203b471ba96812ee0fafc","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gmv_etw/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":3,"content":[{"type":"heading","content":["ሆሴኤይ ባ ማቼይራ ማቃይኒዴስ"]},{"type":"verse","number":1,"content":["ጎዳይ ታና፥ «ኢስራኤሌ ኣሳይ ሃራ ጾሳታኮ ሲሚዲ ዛቢቤ ኡኬ ሺሻና ኮዪዴስ፤ ሄሳራካ ጎዳይ ኢስታ ሲቂዛይሳ ማላ ኔካ ባዳ ባ ላጌታ ሲቃዳ ላይማታሼ ዲዛ ካሴ ኔ ማቼዮ ዛራዳ ሲቃ» ጊዴስ።"]},{"type":"verse","number":2,"content":["ሄሳ ጊሻስ ታ ኢዞ ታማኔ ኢቻሹ ሳቂሌ ቢራኒኔ 150 ኪሎ ባንጋን ሻማዲስ።"]},{"type":"verse","number":3,"content":["ታ ኢዞ፥ «ኔ ላይማቲዛይሳኔ ሃራ ኣስ ካሊዛይሳ ኣጋዳ ታናራ ዳሮ ዎዴ ጺሎቴን ዴኣ፤ ታኒካ ኔናራ ኣማኔቴን ዳና» ጋ ዞራዲስ።"]},{"type":"verse","number":4,"content":["ሄሳካ ኢስራኤሌ ኣሳይ ካዎይ ባይንዳ ዎይኮ ካሌዛዴይ ባይንዳ፥ ያርሾይ ባይንዳ ዎይኮ ኤቃ ጾሳታ ሃዉልቴይ ባይንዳ፥ ቄሴቴ ማይኦይ ባይንዳ ዎይኮ ኤቃ ጾሳታ ሚስሌይ ባይንዳ ዳሮ ዎዴ ዴኣና።"]},{"type":"verse","number":5,"content":["ሄሳፌ ጉዬ ኢስራኤሌ ዴሬይ ጎዳ ባ ጾሳኮኔ ባ ካዎ ዳዊቴኮ ሲማና። ዉርሴ ዎዴ ኢስቲ ያሻን ኮኮሪሼ ጎዳኮኔ ኢዛ ኣንጆኮ ያና።"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/HOS/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/HOS/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/HOS/2.json","previousChapterAudioLinks":{},"numberOfVerses":5}