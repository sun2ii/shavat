{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"ISA","translationId":"gmv_etw","name":"ኢሳያሳ ቲንቢቴ","commonName":"ኢሳያሳ ቲንቢቴ","title":"ኢሳያሳ ቲንቢቴ","order":23,"numberOfChapters":66,"sha256":"85f0c7972c1a613e985c5483deba657815ddc48c8c7747b53b9a068fc53fdc7d","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gmv_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":20,"content":[{"type":"heading","content":["ጊብጼ ቦላኔ ቶጵያ ቦላ ዮቴቲዳ ቲንቢቴ"]},{"type":"verse","number":1,"content":["ኣሶሬ ካዎ ሳርጎኔይ ኦላ ጋዳዋ ኪቲን ኣሽዶዴ ጌቴቲዛ ፊሊስጼሜ ካታማ ኦሊ ኦይኪዳ ላይ፥"]},{"type":"verse","number":2,"content":["ሄ ዎዴ ጎዳይ ኣሞጼ ና ኢሳያሳ፥ «ማቃ ኔ ቦላፌ ቃራ፤ ኔ ጫማ ቶሆፔ ኬሳ» ጊ ዮቲዴስ፤ ኢዚካ ሄሳ ኦዴስ፤ ካሎኔ ጫማይ ባይንዳ ሲሜሬቲዴስ።"]},{"type":"verse","number":3,"content":["ሄሳፌ ጎዳይ፥ «ታ ኣይሌ ኢሳያሲ ጊብጼ ቦላኔ ቶጵያ ቦላ ጋካናይሳስ ማላታ ጊዳና ማላ ሄ ላይ ማይኦ ማይኦንታኔ ጫማ ኣንታ ዴኢዳ ማላ፥"]},{"type":"verse","number":4,"content":["ኣሶሬ ካዎይ ጊብጼፔ ዲኤቲዳ ጪማታኔ ዬላጋታ፥ ቶጵያፔ ቤቲ ዪዳይታ ካሎኔ ጫማ ኣንታ ኤኪ ባና፤ ኢስቲ ዱጫ ካሎ ቃሪ ዬጊዲ ዬዴሬሼ ጊብጼታ ካዉሻና።"]},{"type":"verse","number":5,"content":["ቶጵያ ሂዶታ ኦዳይቲኔ ጊብጼን ጬቄቲዛይቲ ባባናኔ ካዉያና።"]},{"type":"verse","number":6,"content":["ሄ ዎዴ ኣባ ማታን ዴኢዛ ዴሬይ፥ ‹ካሴ ኢስቲ ጬቄቲዳይቲ፥ ኣሶሬ ካዎፔ ኣታናሲኔ ላኣ ኬዛናስ ኑ ኢስታ ጊዶን ቆቴቲዳይታ ኣዚ ጋኪዳኮ ኣኔ ጼሊቴ፤ ሂስቲን ኑኒ ዋኒ ኬሲ ኤኪ ኣታኔ? ጋና› » ጊዴስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/ISA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/ISA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/ISA/19.json","