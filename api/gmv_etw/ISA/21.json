:[{"text":"ታ ዎዚናይ ፖዱ ጊዴስ፤","poem":1},{"text":"ታና ያሺ ኮኮሪሲዴስ፤","poem":2},{"lineBreak":true},{"text":"ታ ኡፋይሳን ናጊዳ ኦማርሳይ","poem":2},{"text":"ታ ቦላ ሂርጋ ዬጊዴስ።","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ኢስቲ ማዳ ጊግሲዳ፤","poem":1},{"text":"ኡቲዛሶ ጊግሲዳ፤","poem":2},{"lineBreak":true},{"text":"ሚዳኔ ኡዪዳ።","poem":2},{"lineBreak":true},{"text":"ኢንቴኖ ሹሜቶ ዴንዲቴ!","poem":2},{"lineBreak":true},{"text":"ጎንዳሌዛ ዛይቴን ቁጪቴ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ጎዳይ ታና፥","poem":1},{"text":"«ባ፤ ዎቺዛ ኣስ ዎ፤","poem":2},{"lineBreak":true},{"text":"ኢዚ ባ ቤኢዳይሳ ዮቶ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ፓራን ጎሼቲዛ","poem":1},{"text":"ፓራ-ጋሬታ ቤኢዛ ዎዴ","poem":2},{"lineBreak":true},{"text":"ሃሬ ቶጊዛይታ","poem":2},{"lineBreak":true},{"text":"ጋሜላ ቶጊዛይታ","poem":2},{"text":"ቤኢዛ ዎዴ ኢዚ ዩሺ ቆፖ፤","poem":3},{"lineBreak":true},{"text":"ሎኤ ዎቾ» ጊዴስ።","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ናጊዛይሲካ ዋሲሼ፥","poem":1},{"text":"«ጎዳዉ፥ ታኒ ጋላስ ጋላስ","poem":2},{"text":"ፓጬይ ባይንዳ","poem":3},{"lineBreak":true},{"text":"ሻኮ ቦላ ኤቃዲስ፤","poem":3},{"lineBreak":true},{"text":"ኦማርስ ኡባን","poem":3},{"lineBreak":true},{"text":"ታ ናጊዛሶሆን ኤቃዲስ።","poem":3}]},{"type":"verse","number":9,"content":[{"text":"ቤኢቴ፥ ኢሲ ኣሲ ፓራታን","poem":1},{"text":"ጎሼቲዛ ፓራ-ጋሬታን ዪዴስ፤","poem":2},{"lineBreak":true},{"text":"ሂስቲዲ፥ ‹ባቢሎኔይ","poem":2},{"lineBreak":true},{"text":"ኩንዳዱስ! ኩንዳዱስ!","poem":2},{"lineBreak":true},{"text":"ኢዚ ኤቃ ጾሳ ሚስሌቲካ","poem":2},{"lineBreak":true},{"text":"ሜቄሬቲ ጋዴን ኩንዲዳ›","poem":2},{"text":"ጊ ዛሪዴስ» ጊ ዋሲዴስ።","poem":3}]},{"type":"verse","number":10,"content":[{"text":"ባሌን ቡኬቲዳ ታ ዴሬዞ!","poem":1},{"text":"ኡባፌ ዎልቃማ ጎዳ","poem":2},{"text":"ኢስራኤሌ ጾሳፌ","poem":3},{"lineBreak":true},{"text":"ታ ሲዪዳ ቃላ ኔስ ዮታይስ።","poem":3}]},{"type":"heading","content":["ኤዶሜ ቦላ ዮቴቲዳ ቲንቢቴ"]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ኤዶሜ ጊሻስ ዮቴቲዳ","poem":1},{"text":"ሚኖ ዮኦ፤","poem":2},{"lineBreak":true},{"text":"ኢሲ ኣሲ ሴይሬፔ","poem":2},{"text":"ታና ጼይጊዲ «ናጊዛይሶ!","poem":3},{"text":"ጋዴይ ዎንታናስ","poem":2},{"text":"ኣይ ኬና ሳቴይ ኣቲዴ?","poem":3},{"text":"ናጊዛይሶ! ጋዴይ ዎንታናስ","poem":2},{"lineBreak":true},{"text":"ኣይ ኬና ሳቴይ ኣቲዴ?» ጊዴስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ናጊዛይሲ ዛሪዲ፥ «ዎንታና፤","poem":1},{"text":"ጊዶ ኣቲን ሲሚዲ ቃማና፤","poem":2},{"lineBreak":true},{"text":"ኦይቻና ኮይኮ ኦይቺቴ፤","poem":2},{"lineBreak":true},{"text":"ጊዶ ኣቲን ሲሚዲ","poem":2},{"text":"ሃ ዪቴ» ጊዴስ።","poem":3}]},{"type":"heading","content":["ኣራቤ ቦላ ዮቴቲዳ ቲንቢቴ"]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ኣራቤ ጊሻስ ዮቴቲዳ ሚኖ ዮኦ፤","poem":1},{"text":"ኢንቴኖ ዳዳኔ ዛልኣንቻቶ!","poem":2},{"lineBreak":true},{"text":"ኢንቴ ኢንቴ ጫና","poem":2},{"lineBreak":true},{"text":"ጋሜላታራ ኣራቤ ባዞን ኣቃና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሳሜቲዳይታስ ሃ ኤሂቴ፤","poem":1},{"text":"ኢንቴኖ ቴማኔን ዲዛይቶ!","poem":2},{"text":"ቤቴ ኣሳታስ ካ ኤሂቴ።","poem":3}]},{"type":"verse","number":15,"content":[{"text":"ኢስቲ ጊ ማሻፌኔ","poem":1},{"text":"ኮሆፔ ሾዴቲዳ ጊ ማሻፌ፥","poem":2},{"lineBreak":true},{"text":"ዋጼቲዳ ዎንዳፌፔኔ","poem":2},{"lineBreak":true},{"text":"ሱሊዳ ኦላፔ ባቃቲዳ።","poem":2}]},{"type":"verse","number":16,"content":["ጎዳይ ታና፥ «ኮንቲራቴ ኦሳንቻ ኦሶ ጋላሲ ዉሪዛ ማላ ኢሲ ላይ ጊዶን ቄዳሬ ቦንቾይ ኡባይ ዉራና።"]},{"type":"verse","number":17,"content":["ቄዳሬ ቢታን ዎንዳፌን ዱኪዛ ዎልቃማ ኦላንቻታፔ ጉቲ ኣታና፤ ሄሳ ጎዳ ኢስራኤሌ ጾሳይ ዮቲዴስ» ጊዴስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}