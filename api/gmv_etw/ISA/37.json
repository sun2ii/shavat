{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"ISA","translationId":"gmv_etw","name":"ኢሳያሳ ቲንቢቴ","commonName":"ኢሳያሳ ቲንቢቴ","title":"ኢሳያሳ ቲንቢቴ","order":23,"numberOfChapters":66,"sha256":"85f0c7972c1a613e985c5483deba657815ddc48c8c7747b53b9a068fc53fdc7d","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gmv_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":37,"content":[{"type":"heading","content":["ካዎ ሂዝቂያሲ ኢሳያሳ ኦይቺዳ ዞሬ"]},{"type":"verse","number":1,"content":["ካዎ ሂዝቂያሲ ሄሳ ሲዪዳ ማላ ባ ማይኦ ዳኪዴስ፤ ሄሳፌ ጉዬ ማቃ ማይኢዲ ጎዳ ኬ ጌሊዴስ።"]},{"type":"verse","number":2,"content":["ካዎ ኬ ኣይሲዛ ኤልያቄሜይ፥ ጻፌ ሼቢናይኔ ቄሴታፔ ኤሬቲዳይቲ ኡባይ ማቃ ማይኢዲ ኣሞጼ ና ናቤ ኢሳያሳኮ ባና ማላ ኪቲዴስ።"]},{"type":"verse","number":3,"content":["ኢስቲካ ኢሳያሳስ ቢዲ፥ «ሂዝቂያሲ፥ ‹ሃ ጋላሳይ ጬጬ፥ ቂጻቴኔ ካዉሻቴ ጋላሳ፤ ሄሲካ ናይ ዬሌታና ሃኒሺን ኣቤይ ኢጺዛ ጋላሳ ማላ ጊዲዴስ።"]},{"type":"verse","number":4,"content":["ዴኦ ጾሳ ጫያና ማላ ኢዛ ጎዳ ኣሶሬ ካዎይ ኪቲዳ ኦላ ጋዳዋ ቃላ ጎዳ ኔ ጾሳይ ሲዮንታ ኣጌና። ቃሴ ጎዳ ኔ ጾሳይ ሄ ሲዪዳ ቃላ ጋሶን ኢዛ ቃጻዮንታ ኣጌና። ሄሳ ጊሻስ ኔኒ ሼምፖራ ፓጻ ኣቲዳ ጫሻታ ጊሻስ ዎሳ› ጌስ» ጊዳ።"]},{"type":"verse","number":5,"content":["ካዎ ሂዝቂያሲ ኪቲዳይቲ ኢሳያሳኮ ዪዳ ዎዴ፥"]},{"type":"verse","number":6,"content":["ኢሳያሲ ኢስታስ ዛሪዲ፥ «ኢንቴ ጎዳሲ ቢዲ፥ ‹ጎዳይ ኔና፥ ኣሶሬ ካዎ ኣሽካራቲ ታና ጫዪሺን ኔኒ ሲዪዳ ጫሻ ቃላስ ሂርጎፋ።"]},{"type":"verse","number":7,"content":["ቤያ፥ ታ ኢዛ ቦላ ኣያና ኪታና፤ ኢዚ ዎሬ ሲዪዲ ባ ዴሬ ሲሚ ባና፤ ሄን ባ ዴሬን ማሻን ሃይቃና ማላ ታ ኦና› ጊቴ» ጊዴስ።"]},{"type":"heading","content":["ኣሶሬቲ ናምኣን ኪቲዳ ማንዴ ቃላ"]},{"type":"verse","number":8,"content":["ኣሶሬ ካዎይ ላኪሼ ካታማፔ ዴንዲ ቢዳይሳ ኦላ ጋዳዋዚ ሲዪዲ ጉዬ ሲሚዴስ። ሂስቲዲ ካዎዚ ሊቢና ካታማ ኦሊሺን ዴሚዴስ።"]},{"type":"verse","number":9,"content":["ካዎ ሴናኪሬሜይ፥ ቶጵያ ካዎ ቲራቄይ ኢዛ ኦላና ዪዛይሳ ሲዪዴስ፤ ሄሳ ሲዪዳ ማላ ሂዝቂያሳስ ኪታ ዬዲዲ፥"]},{"type":"verse","number":10,"content":["«ዩሁዳ ካዎ ሂዝቂያሳስ፥ ‹ዬሩሳላሜይ ኣሶሬ ካዎ ኩሼን ጌሌና› ጊን ኔ ኣማኔቲዳ ጾሲ ኔና ጪሞፎ።"]},{"type":"verse","number":11,"content":["ሄኮ ኣሶሬ ካዎቲ ቢታ ኡባ ቦላ ኢስቲ ኦዳይሳኔ ሙሌራ ኢስታ ይሲዳይሳ ኔ ሲያዳሳ። ሂስቲን ኔ ኬሳ ኤካ ኣታና ሚሳቲዜ?"]},{"type":"verse","number":12,"content":["ካሴ ታ ኣዋቲ ይሲዳ ጎዛኔን፥ ካራኔኒኔ ኤራፌሴን ሄሳካ ታላሳሬን ዴኢዛ ኤዴኔ ኣሳ ኢስታ ጾሳቲ ሄ ቢታታ ኣሺዶ?"]},{"type":"verse","number":13,"content":["ሃማቴ ካዎይ፥ ኣርፋዴ ካዎይ፥ ሴፋርዋይሜ ካዎይ፥ ሄና ካዎይኔ ኢዋ ካዎይ ኣዋን ዲዞ?» ጊዴስ።"]},{"type":"heading","content":["ሂዝቂያሳ ዎሳ"]},{"type":"verse","number":14,"content":["ሂዝቂያሲ ዳብዳቤዛ ኪቴቲዳ ኣሳታፔ ኤኪዲ ናባቢዴስ። ጎዳ ኬ ኤኪ ኤፊዲ ጎዳ ሲንን ሚጪዴስ።"]},{"type":"verse","number":15,"content":["ሂስቲዲ ጎዳ ዎሲሼ፥"]},{"type":"verse","number":16,"content":["«ኣቤት ጎዳዉ፥ ኡባፌ ዎልቃማ ጾሳዉ፥ ኪሩቤታፔ ጊዶን ኡቲዛ ኢስራኤሌ ጾሳዉ፥ ሳኣ ካዎቴታ ኡባ ቦላ ኔ ጻላ ጾሳ። ሳሎኔ ሳኣ ኔኒ ሜዳሳ።"]},{"type":"verse","number":17,"content":["ኣቤት ጎዳዉ፥ ኔ ሃይ ሃ ዬጋዳ ኤዝጋ። ኣቤት ጎዳዉ፥ ኔ ኣይፌ ፖጋዳ ሃ ጼላ። ኔና ዴኦ ጾሳ ጫያናስ ሴናኪሬሜይ ኪቲዳ ቃላ ሲያ።"]},{"type":"verse","number":18,"content":["«ኣቤት ጎዳዉ ቱማካ፥ ኣሶሬ ካዎቲ ሃ ካዎቴታኔ ኢስታ ቢታ ኡባ ባዞ ኬሲዳ።"]},{"type":"verse","number":19,"content":["ኢስታ ጾሳታ ታማን ጹጊዳ፤ ኢስታ ጾሳቲ ዎኒካ ሚፌኔ ሹቻፌ ኣሳ ኩሼን ማሴቲ ኬዚዳ ሚስሌፔ ኣቲን ጾሳታ ጊዴቴና።"]},{"type":"verse","number":20,"content":["ሃኢካ ኣቤት ጎዳዉ፥ ኑ ጾሳዉ ኔኒ ጎዳይ ጻላ ጾሳ ጊዲዳይሳ ሳኣ ካዎቴቲ ኡባይ ኤራና ማላ ኑና ኢዛ ኩሼፔ ኣሻ!» ጊ ዎሲዴስ።"]},{"type":"heading","content":["ኢሳያሲ ካዎ ሂዝቂያሳስ ዬዲዳ ኪታ"]},{"type":"verse","number":21,"content":["ሄሳፌ ጉዬ ኣሞጼ ና ኢሳያሲ ካዎ ሂዝቂያሳሲ፥ «ጎዳይ ኢስራኤሌ ጾሳይ፥ ‹ኔኒ ኣሶሬ ካዎ ሴናኪሬሜይ ማንዲዳ ማንዴ ጊሻስ ዎሲዳ ዎሳ ታ ሲያዲስ› ጌስ።"]},{"type":"verse","number":22,"content":["«ጎዳይ ሴናኪሬሜ ጊሻስ ዮቲዳ ቃላይ፥",{"text":"«ጌላኦያ ጺዮኔ ናያ","poem":1},{"text":"ኔና ካዱሲኔ ሌቃዱስ።","poem":2},{"lineBreak":true},{"text":"ዬሩሳላሜ ናያ","poem":2},{"lineBreak":true},{"text":"ኔ ባቃቲሺን ቤኣዳ","poem":2},{"lineBreak":true},{"text":"ባ ቆ","poem":2},{"lineBreak":true},{"text":"ቃዱስ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ኔ ኦና ጫያይኔ ካዉሻይ?","poem":1},{"text":"ኦና ቦ