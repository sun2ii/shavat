{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"ISA","translationId":"gmv_etw","name":"ኢሳያሳ ቲንቢቴ","commonName":"ኢሳያሳ ቲንቢቴ","title":"ኢሳያሳ ቲንቢቴ","order":23,"numberOfChapters":66,"sha256":"85f0c7972c1a613e985c5483deba657815ddc48c8c7747b53b9a068fc53fdc7d","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gmv_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":38,"content":[{"type":"heading","content":["ሃርጌፌ ሂዝቂያሳ ፓጾ"]},{"type":"verse","number":1,"content":["ሄ ዎዴ ካዎ ሂዝቂያሲ ሃርጊዲ፥ ሃይቃና ማቲዴስ። ሂስቲን ኣሞጼ ና ናቤ ኢሳያሲ ኢዛኮ ቢዲ፥ «ጎዳይ ኔና፥ ‹ኔኒ ሃይቃናፔ ኣቲን ሃርጌዛፔ ፓጻካ፤ ሄሳ ጊሻስ ኔ ኬ ጊጊሳ› ጌስ» ጊዴስ።"]},{"type":"verse","number":2,"content":["ሂስቲን ሂዝቂያሲ ኬ ጎዳኮ ሲሚዲ ጎዳ ዎሲዴስ።"]},{"type":"verse","number":3,"content":["ዎሲሼ፥ «ኣቤት ጎዳዉ፥ ታኒ ኔ ሲንን ኣማኔቴኒኔ ኩሜ ዎዚናፔ ኔና ኡፋይሲዛ ሚሽ ኦሼ ታ ዋና ዴኢዳኮ ኔኒ ኣኬካና ማላ ታኒ ኔና ዎሳይስ» ጊ ዎሲዴስ፤ ሂዝቂያሲካ ኬሂ ጫሞ ዬሆ ዬኪዴስ።"]},{"type":"verse","number":4,"content":["ሄሳፌ ጉዬ ጎዳ ቃላይ ኢሳያሳኮ ዪዴስ።"]},{"type":"verse","number":5,"content":["ሂስቲዲ፥ «ኔኒ ባዳ ሂዝቂያሳ፥ ‹ጎዳይ ኔ ኣዋ ዳዊቴ ጾሳይ፥ ታኒ ኔ ዎሳ ሲያዲስ፤ ኔ ኣፉንካ ቤኣዲስ። ኔ ላይ ቦላ ታኒ ኔስ ታማኔ ኢቻሹ ላይ ጉጃና።"]},{"type":"verse","number":6,"content":["ኔናኔ ሃ ካታማዮ ኣሶሬ ቢታ ካዎዛ ኩሼፔ ኣሻና፤ ታኒ ሃ ካታማይ ቦላ ዪዛይሳ ቴቃና› ጌስ» ጊዴስ።"]},{"type":"verse","number":7,"content":["ኢሳያሲ ጉጂዲካ፥ «ጎዳይ ኔስ ጊዳ ቃላ ፖላናይሳስ ማላታይ ሃይሳፌ ካሊዛይሳ፤"]},{"type":"verse","number":8,"content":["ቤያ፥ ኣካዜይ ፑዴ ኬኣናስ ጊግሲዳ ኬቻታ ቦላ ዎዛ ኣዋ ኩዋይ ታሙ ኬች ጉዬ ሲሚ ባና ማላ ታኒ ኦና» ጊዴስ። ሂስቲን ኩዋይ ታሙ ኬች ጉዬ ሲሚዲ ቢዴስ።"]},{"type":"verse","number":9,"conten