text":"ታ ዴኦ ላይ ኡባን","poem":2},{"text":"ኣሽኬቴን ባና።","poem":3}]},{"type":"verse","number":16,"content":[{"text":"ኣቤት ጎዳዉ ሄይታንታ ማላ","poem":1},{"text":"ዮኦታን ኣሳይ ፓጻ ዴስ።","poem":2},{"lineBreak":true},{"text":"ታ ኣያናይካ ሄይታንታን","poem":2},{"text":"ዴኦ ዴማና።","poem":3},{"text":"ኔ ታና ፓዳሳ፥","poem":2},{"lineBreak":true},{"text":"ታና ሼምፖራ ፓጻ ዎዳሳ!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሄኮ ታ ሜቶን ጬጪዳይሲ","poem":1},{"text":"ታስ ጎኣስ ጊዲዴስ።","poem":2},{"lineBreak":true},{"text":"ኔኒ ታ ሼምፖ ባሻ ኦላፌ","poem":2},{"text":"ኔ ሲቆን ናጋዳሳ፤","poem":3},{"text":"ኔኒ ታ ናጋራ ኡባ","poem":2},{"text":"ኔፔ ጉዬ ዛራዳ ኦላዳሳ።","poem":3}]},{"type":"verse","number":18,"content":[{"text":"ዱፎይ ኔና ጋላቴና፤","poem":1},{"text":"ሃይቆይካ ኔና ሳቤና።","poem":2},{"lineBreak":true},{"text":"ዱጌ ኦላን ዎዛይቲ","poem":2},{"lineBreak":true},{"text":"ኔ ኣማኔቴ ሂዶታ ኦሴቴና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ታኒ ሃች ኔና ጋላቲዛይሳ ማላ","poem":1},{"text":"ሼምፖራ ፓጻ ዴኢዛይቲ ጻላ","poem":2},{"text":"ኔና ጋላታና፤","poem":3},{"text":"ኔ ኣማኔቴ ጊሻስ","poem":2},{"lineBreak":true},{"text":"ኣዋቲ ባ ናይታስ ዮቴቴስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ጎዳይ ታና ኣሻና፤","poem":1},{"text":"ሄሳ ጊሻስ ኑኒ","poem":2},{"text":"ኑ ዴኢዛ ላይታ ኡባን፥","poem":3},{"text":"ጎዳ ኬን","poem":2},{"lineBreak":true},{"text":"ዋጼቲዳ ዲን ዬጻና።","poem":2}]},{"type":"verse","number":21,"content":["ኢሳያሲ ካሴ፥ «ባላሴ ሚ ኣይፌ ዳጺዲ፥ ኢዛ ኪጻ ቦላ ዎቴ። ሂስቲኮ ኢዚ ፓጻና»",{"text":"ጊ ዎዴስ።","poem":2}]},{"type":"verse","number":22,"content":["ሂዝቂያሲካ፥ «ታኒ ፓጻዳ ጎዳ ኬ ፑዴ ኬዛናይሳስ ማላታይ ኣዜ?» ጊዲ ኢሳያሳ ኦይቺ ዎዴስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/ISA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/ISA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/ISA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}