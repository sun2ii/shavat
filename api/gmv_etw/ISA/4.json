{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"ISA","translationId":"gmv_etw","name":"ኢሳያሳ ቲንቢቴ","commonName":"ኢሳያሳ ቲንቢቴ","title":"ኢሳያሳ ቲንቢቴ","order":23,"numberOfChapters":66,"sha256":"85f0c7972c1a613e985c5483deba657815ddc48c8c7747b53b9a068fc53fdc7d","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gmv_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":["ሄ ዎዴ ላፑን ማጫሳቲ ኢሲ ኣዴ ኦይኪዲ፥",{"text":"«ማና ካ ጊዲን","poem":2},{"lineBreak":true},{"text":"ማይኣና ማይኦ","poem":2},{"lineBreak":true},{"text":"ኑኒ ኑርካ ኑና ዳንዳያና፤","poem":2},{"text":"ኔ ሱንን ጻላ","poem":3},{"lineBreak":true},{"text":"ጼይጌታና ማላ ሂስታዳ","poem":3},{"lineBreak":true},{"text":"ኑ ካዉሻቴ","poem":3},{"text":"ኑፔ ዲጋርኪ!» ጊ ዎሳና።","poem":2}]},{"type":"heading","content":["ዬሩሳላሜ ኦራቴ"]},{"type":"verse","number":2,"content":["ሄ ዎዴ ጎዳ ሚ ሃጋይ ሎኣናኔ ቦንቼታና፤ ኢስራኤሌ ኣሳፔ ይሼ ኣቲዳይታስ ሄ ቢታ ካይ ጬቆሲኔ ቦንቾስ ጊዳና።"]},{"type":"verse","number":3,"content":["ጺዮኔን ኣቲዳይቲ፥ ዬሩሳላሜን ዮንታ ኣቲዳይቲ፥ ዬሩሳላሜን ሼምፖራ ፓጻ ዲሼ ጻፌቲዳ ኡባታራ፥ «ኢስቲ ጌሻታ» ጌቴታና።"]},{"type":"verse","number":4,"content":["ጎዳይ ጺዮኔ ማጫሳታ ቂታ ሜጫና፤ ማቲ ኡቲዳ ሱፌ ዬሩሳላሜ ፒርዳ ኣያናኒኔ ጹጊዛ ኣያናን ጌሻና።"]},{"type":"verse","number":5,"content":["ጎዳይ ጺዮኔ ዙማ ቦላኔ ሄን ሺቂዛ ኡባታ ቦላ ጋላስ ሻራኔ ጩዋ፥ ኦማርስ ኤጺዛ ታማ ፖኦ ኪታና፤ ጾሳ ቦንቾይ ካታማዮ ዱንካኔ ማላ ካሚ ናጋና።"]},{"type":"verse","number":6,"content":["ኢዚ ጋላሳ ኣዋ ሱሌፔ ኣሺዛ ኩዋ፥ ኡሾፔኔ ኢራፔ ባቃቲ ኣቲዛሶሆ ጊዳና።"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/I