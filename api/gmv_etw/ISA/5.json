:"«ኢንቴኖ ዬሩሳላሜን","poem":2},{"lineBreak":true},{"text":"ዴኢዛይቶ!","poem":2},{"lineBreak":true},{"text":"ኢንቴኖ ዩሁዳ ኣሳቶ!","poem":2},{"lineBreak":true},{"text":"ታፔኔ ታ ዎይኔ ቱራ","poem":2},{"lineBreak":true},{"text":"ቶኪዛ ሶሆዛፔ ጊዶን","poem":2},{"lineBreak":true},{"text":"ዴኢዛ ዮኦዛ","poem":2},{"lineBreak":true},{"text":"ኣኔ ሃኢ ኢንቴ ፒርዲቴ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታኒ ታ ዎይኔ ቱራ","poem":1},{"text":"ሶሆዛሲ ኦዳይሳፌ","poem":2},{"lineBreak":true},{"text":"ሃራ ኣይ ኦናይሲ ኣቲዴ?","poem":2},{"lineBreak":true},{"text":"ኢዚ ሎኦ ኣይፌ ኣይፋና ጋዳ","poem":2},{"text":"ታ ናጊሺን ኣይስ ጫላ ጳንቂዳ","poem":3},{"lineBreak":true},{"text":"ኣይፌ ኣይፊዴ?","poem":3}]},{"type":"verse","number":5,"content":[{"text":"ሃኢ ታኒ ታ ዎይኔ","poem":1},{"text":"ቶኪዛ ጋዴዛ ቦላ","poem":2},{"lineBreak":true},{"text":"ኦናዝ ኢንቴስ ዮታይስ።","poem":2},{"text":"ዲርሳ ሾዳና፤","poem":3},{"lineBreak":true},{"text":"ኢዚካ ያና ማላ ኦና፤","poem":3},{"lineBreak":true},{"text":"ታኒ ጊምቤዛ ላላና፤","poem":3},{"lineBreak":true},{"text":"ሄ ሶሆይካ ዱሬታና።","poem":3}]},{"type":"verse","number":6,"content":[{"text":"ታኒ ሄ ሶሆዛ","poem":1},{"text":"ማጎ ቢታ ኦና።","poem":2},{"lineBreak":true},{"text":"ሄ ቱራይ ጹንቄቴናኔ","poem":2},{"lineBreak":true},{"text":"ቡልኤቴና፤","poem":2},{"lineBreak":true},{"text":"ሂስቲን ኪንዲቾይኔ","poem":2},{"lineBreak":true},{"text":"ኣጉን ኢዛን ሞካና።","poem":2},{"lineBreak":true},{"text":"ኢራይ ኢዛን ቡኮንታ ማላ፥","poem":2},{"lineBreak":true},{"text":"ታኒ ሻራታ ኣዛዛና» ጊዴስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ኡባፌ ዎልቃማ","poem":1},{"text":"ጎዳ ዎይኔ ቶኪዛ ጋዴይ","poem":2},{"lineBreak":true},{"text":"ኢስራኤሌ ኣሳ።","poem":2},{"lineBreak":true},{"text":"ዩሁዳ ኣሳይ","poem":2},{"lineBreak":true},{"text":"ኢዚ ኡፋዬቲዛ ኣታኪልቴ።","poem":2},{"lineBreak":true},{"text":"ኢስቲ ሱሬ ፒርዳ ፒርዳና","poem":2},{"text":"ጊዲ ናጊዴስ፤","poem":3},{"text":"ጊዶ ኣቲን","poem":2},{"lineBreak":true},{"text":"ሱ ጉሲሺን ቤዪዴስ።","poem":2},{"lineBreak":true},{"text":"ኢዚ ጺሎቴ ኮዪዴስ፤","poem":2},{"text":"ጊዶ ኣቲን ሜቶ ዋሶ ሲዪዴስ።","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":