":["ታማ ቦንቆዛን ታ ዶና ቦቺዲ፥ «ቤኣ፤ ሃይሲ ታማ ቦንቆዚ ኔ ዶና ቦቺዴስ፤ ኔ ሞሮይ ኔፔ ኪቺዴስ፤ ኔ ናጋራይካ ቁጬቲ ኪቺዴስ» ጊዴስ።"]},{"type":"verse","number":8,"content":["ሄሳፌ ጉዬ ጎዳይ፥ «ኦና ኪቶ? ኑስ ኦኔ ኪቴታናይ?» ጊሺን ሲያዲስ። ታኒካ ዛራዳ፥ «ሄኮ፥ ታና ኪታ» ጋዲስ።"]},{"type":"verse","number":9,"content":["ሂስቲን ጎዳይ፤",{"text":"«ባ፤ ባዳ ሃ ኣሳስ፥","poem":1},{"text":"‹ኢንቴ ሲሲ ሲዬታ፤","poem":2},{"lineBreak":true},{"text":"ጊዶ ኣቲን ዩሺ ቆፔኬታ፤","poem":2},{"lineBreak":true},{"text":"ኣይፌን ጼሌታ ሺን ኣኬኬኬታ›","poem":2},{"text":"ጋዳ ኢስታስ ዮታ።","poem":3}]},{"type":"verse","number":10,"content":[{"text":"ሃይሳ ዴራ ዎዚና ዳሚሳ፤","poem":1},{"text":"ኢስታ ሃይካ ቱሊሳ፤","poem":2},{"lineBreak":true},{"text":"ኢስታ ኣይፌዛካ ቆቂሳ፤","poem":2},{"text":"ሂስቶንታ ኣጊኮ","poem":3},{"lineBreak":true},{"text":"ኢስቲ ባንታ ኣይፌን ቤኣና፤","poem":3},{"lineBreak":true},{"text":"ባንታ ሃይን ሲያና፤","poem":3},{"lineBreak":true},{"text":"ባንታ ዎዚናንካ ኣኬካና፤","poem":3},{"lineBreak":true},{"text":"ሂስቲዲ ኢስቲ ታኮ","poem":3},{"lineBreak":true},{"text":"ሲሚዲ ፓጻና» ጊዴስ።","poem":3}]},{"type":"verse","number":11,"content":["ታኒካ፥ «ኣቤት ጎዳዉ!",{"text":"ሃይሲ ኣይዴ ጋካናስ","poem":2},{"text":"ሃናኔ?» ጋዲስ።","poem":3},{"text":"ኢዚካ ዛሪዲ ታስ፥","poem":2},{"text":"«ካታማቲ ኢስታን ዴኢዛ ኣሲ","poem":3},{"lineBreak":true},{"text":"ዪን ኢስቲ ላሌታና","poem":3},{"lineBreak":true},{"text":"ጋካናስ፥","poem":3},{"lineBreak":true},{"text":"ኬቲካ ኡባይ","poem":3},{"lineBreak":true},{"text":"ካይዛና ጋካናሲኔ","poem":3},{"lineBreak":true},{"text":"ቢታይካ ሙሌራ ኣይኮይ ባይንዳ","poem":3},{"lineBreak":true},{"text":"ቡላ ጊዳና ጋካናሳ።","poem":3}]},{"type":"verse","number":12,"content":[{"text":"ታኒ ጎዳይ ኣሳ","poem":1},{"text":"ሃሳና ጋካናሳ፤","poem":2},{"lineBreak":true},{"text":"ቢታካ ኣይኮይ ባይንዳ","poem":2},{"text":"ባዞ ኬሳና ጋካናሳ።","poem":3}]},{"type":"verse","number":13,"content":[{"text":"ታሙ ኣሳፔ ኢሲ ኣሲ","poem":1},{"text":"ቢታ ቦላ ኣቲኮ፥","poem":2},{"lineBreak":true},{"text":"ኢዚካ ያና፤","poem":2},{"text":"ቃንጺ ዬጊን ኣቲዳ","poem":3},{"lineBreak":true},{"text":"ዎላ ዱሩማ ማላ ጊዳና፤","poem":3},{"lineBreak":true},{"text":"ጌሻ ዛሬይ ሄሳ","poem":3},{"lineBreak":true},{"text":"ሄ ዱሩማ ማላ ጊዳና» ጊዴስ።","poem":3}]}],"footnotes":[]},"thisChapterLink":"/