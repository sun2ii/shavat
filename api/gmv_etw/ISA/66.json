em":3},{"lineBreak":true},{"text":"ቤቲ ኤሪዞ?","poem":3},{"lineBreak":true},{"text":"ጺዮኖ ቡሮ ሚጻይ ኦይኪሺን","poem":3},{"lineBreak":true},{"text":"ሄራካ ባ ናይታ ዬላዉስ።","poem":3}]},{"type":"verse","number":9,"content":[{"text":"ዬሌታና ማቲዳይሳ","poem":1},{"text":"ዬሌቶንታ ማላ","poem":2},{"text":"ታኒ ዲጋዚና?» ጌስ ጎዳይ።","poem":3},{"text":"«ዬሊሺን ዬሊዛ ኡሎ","poem":2},{"lineBreak":true},{"text":"ታ ጎርዳ ኤራዚና?»","poem":2},{"text":"ጌስ ኔ ጎዳይ።","poem":3}]},{"type":"verse","number":10,"content":[{"text":"«ኢንቴኖ ዬሩሳላሞ","poem":1},{"text":"ሲቂዛ ኡባቶ፥","poem":2},{"lineBreak":true},{"text":"ኢዚራ ኡፋዬቲቴ፤","poem":2},{"lineBreak":true},{"text":"ኢንቴ ኢዚራ ሆምቦጪቴ፤","poem":2},{"lineBreak":true},{"text":"ኢዚስ ዬኪዳ ኡባቲ","poem":2},{"text":"ኢዚራ ኬሂ ኡፋዬቲቴ።","poem":3}]},{"type":"verse","number":11,"content":[{"text":"ሚንዛ ኢዚ ን","poem":1},{"text":"ኢንቴ ሚዲ ካላና፤","poem":2},{"lineBreak":true},{"text":"ኢንቴስ ጊዳናሼ ጋካናስ","poem":2},{"text":"ኢንቴ ኡያና፤","poem":3},{"text":"ኬሂፔ ዳሮ ጊዲዳ","poem":2},{"lineBreak":true},{"text":"ኢዚ ዱሬቴን","poem":2},{"lineBreak":true},{"text":"ኢንቴ ኡፋዬታና» ጌስ ጎዳይ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ጎዳይ፥ «ቤኢቴ፥","poem":1},{"text":"ታኒ ኢዚስ ሳሮቴ","poem":2},{"text":"ጊታ ሻፋ ማላ ጎጊሳና፤","poem":3},{"text":"ካዎቴታ ኣቆታ","poem":2},{"text":"ሻፋ ሃ ማላ ጎጊሳና","poem":3},{"text":"ኢንቴ ኢዚ ኪኦን","poem":2},{"text":"ኢዲሜቲ ማና፤","poem":3},{"text":"ኢዚ ኪኦን ኡቲዲ ኢንቴ ጉፓና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኣያ ባ ና ኣልኢሲዛ ማላ","poem":1},{"text":"ታካ ኢንቴና ኣልኢሳና፤","poem":2},{"lineBreak":true},{"text":"ኢንቴ ዬሩሳላሜን","poem":2},{"lineBreak":true},{"text":"ሚኔታና» ጌስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ኢንቴ ሄሳ ቤኢዛ ዎዴ","poem":1},{"text":"ኢንቴ ዎዚናይ ኡፋዬታና፤","poem":2},{"lineBreak":true},{"text":"ኢንቴ ሜቄይካ","poem":2},{"text":"ማታ ማላ ጪሊላና፤","poem":3},{"text":"ቃሴ ጎዳ ኩሼይ","poem":2},{"lineBreak":true},{"text":"ኢዛ ኣይሌታ ቦላ ዲዛይሲ ኤሬታና፤","poem":2},{"lineBreak":true},{"text":"ኢዛ ሃንቆይ ጊዲኮ","poem":2},{"text":"ኢዛ ሞርኬታ ቦላ ቆንጫና።","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ሄኮ ጎዳይ ታማ ላጮን ያና፤","poem":1},{"text":"ኢዛ ፓራ-ጋሬቲ ጎቴ ጫርኮ ማላ፤","poem":2},{"lineBreak":true},{"text":"ኢዚ ባ ዪሎ ሃንቆን፥","poem":2},{"lineBreak":true},{"text":"ባ ሴራ ታማ ላጮን ቆንጪሳና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታማኒኔ ማሻን","poem":1},{"text":"ጎዳይ ባ ፒርዳ","poem":2},{"text":"ኣሳ ኡባ ቦላ ኤሃና፤","poem":3},{"text":"ዳሮቲ ጎዳ","poem":2},{"lineBreak":true},{"text":"ማሻን ሹኬታና።","poem":2}]},{"type":"verse","number":17,"content":["ጎዳይ፥ «ኣታኪልቴይ ዲዛሶሆ ቢዲ ኢስታፌ ኢሳስ ጎይናናስ ባና ጌሺዛይቲኔ ዱማሲዛይቲ፥ ጉዱን ኣሾኔ ኤጬሬ ኣሾ፥ ቱኒዳ ሚሻታ ሚዛ ኡባቲ ባ ፒርዳ ዉርሴን ኢሲፌ ኤካና» ጌስ።"]},{"type":"verse","number":18,"content":["«ታኒ ኢስታ ኦሶኔ ኢስታ ቆፋ ኤሪዛ ጊሻስ፥ ካዎቴታ ኡባኔ ዱማ ዱማ ቃላን ሃሳይዛ ኡባታ ኢሲፌ ሺሻናስ ያና፤ ኢስቲካ ዪዲ ታ ቦንቾ ቤኣና።"]},{"type":"verse","number":19,"content":["ታኒ ኢስታ ጊዶን ማላታ ኦና፤ ኢስታፌ ኣቲዳ ኢሲ ኢሲኔታ ጌዴ ካዎቴታኮ፥ ታርሴሴ፥ ፑጼ፥ ዎንዳፌን ኦሌቲዛ ኤሬቲዳ ሉዴታኮ፥ ቱባሌኔ ያዋኔ ሄሳካ ታ ጎባቴ ሲዮንታይታኮኔ ታ ቦንቾ ቤዮንታይታኮ ሃኮን ዲዛ ኣባ ጊዶን ዲዛ ሃሩሮታኮ ታ ዬዳና፤ ታ ቦንቾ ካዎቴታ ጊዶን ዮታና።"]},{"type":"verse","number":20,"content":["ጎዳስ ያርሾ ጊዳና ማላ ኢንቴ ኢሻታ ኡባታ ካዎቴታፔ ቦንቼቲዳ ታ ዙማ ዬሩሳላሜ ፓራን፥ ፓራ-ጋሬኒኔ ጋሬን፥ ባቁሎኒኔ ጋሜላን ኢስታ ኤሃና። ኢስራኤሌ ኣሳይ ካ ያርሾ ዎጋን ዲዛ ማላ ጌሻ ሚሻን ዎዲ ጎዳ ኬ ሺሺዛ ማላ ሃይታካ ሺሻና።"]},{"type":"verse","number":21,"content":["ታኒካ ኢስታፌ ባጋይታ ቄሴታኔ ሌዌታ ጊዳና ማላ ታ ዶራና» ጌስ።"]},{"type":"verse","number":22,"content":["ጎዳይ፥ «ታኒ ሜና ኦራ ሳሎቲኔ ኦራ ሳኣይ ታ ሲንን ሚኒ ዳናይሳ ኢንቴ ሱንኔ ኢንቴ ዜሬ ሱን ሄሳ ሚኒ ዳና።"]},{"type":"verse","number":23,"content":["ኣጊና ጼሮፔ ቢዲ ሃራ ኣጊናይ ጼራና ጋካናስ፥ ኢሲ ሳምባታፔ ቢዲ ሃራ ሳምባታ ጋካናስ፥ ኣስ ጊዲዳ ኡባይ ታስ ጎይናና ያና።"]},{"type":"verse","number":24,"content":["ኢስቲ ኬዚዲ ታ ቦላ ማካሊዳ ኣሳታ ኣሃ ቤኣና። ኢስታ ሚዛ ጉጹኔይካ ሃይቄና፤ ኢስታ ሚዛ ታማይካ ቶኤና። ኢስቲ ኣሳ ዜሬ ኡባስ ሃራሲዛዝ ጊዳና» ጌስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/ISA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/JER/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/ISA/65.json","previousChapterAudioLinks":{},"numberOfVerses":24}