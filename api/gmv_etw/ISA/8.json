reak":true},{"text":"ቦንቾዛራ ኢስታ ቦላ ኤሃና፤","poem":2},{"text":"ሃዚ ሻፋዛ","poem":3},{"lineBreak":true},{"text":"ኩሚ ፖሊችዲ","poem":3},{"lineBreak":true},{"text":"ሻፋ ዶናን ዲዛ","poem":3},{"lineBreak":true},{"text":"ቢታ ኡባ ሚታና።","poem":3}]},{"type":"verse","number":8,"content":[{"text":"ቡሪ ኤኪዲ","poem":1},{"text":"ዱጌ ዩሁዳ ዎና፤","poem":2},{"lineBreak":true},{"text":"ቢታ ኩሚዲ ኣና፤","poem":2},{"lineBreak":true},{"text":"ቆ ጋካናስ","poem":2},{"lineBreak":true},{"text":"ሚታና» ጊዴስ።","poem":2},{"text":"ጊዶ ኣቲን ኣማኑኤሌ!","poem":3},{"lineBreak":true},{"text":"ሚጬቲዳ ኢዛ ቄፌይ","poem":3},{"lineBreak":true},{"text":"ኔ ቢታ ጋጻፔ","poem":3},{"lineBreak":true},{"text":"ጋጻ ጋካናስ","poem":3},{"lineBreak":true},{"text":"ካሚ ኦይኪዴስ።","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ኢንቴኖ ካዎቴቶ!","poem":1},{"text":"ኦላስ ዴንዲዲ ዋሲቴ፤","poem":2},{"lineBreak":true},{"text":"ኢንቴ ዲፒ ጋና፤","poem":2},{"lineBreak":true},{"text":"ሃሆ ዴሬን ዲዛይቲ ኤዝጊቴ!","poem":2},{"lineBreak":true},{"text":"ኦላስካ ጊጌቲቴ!","poem":2},{"lineBreak":true},{"text":"ኢንቴ ዲፒ ጋና፤","poem":2},{"lineBreak":true},{"text":"ኦላስካ ጊጌቲቴ!","poem":2},{"text":"ኢንቴ ሜቄሬታና፤","poem":3}]},{"type":"verse","number":10,"content":[{"text":"ኦላስ ዞሬቲቴ፤","poem":1},{"text":"ጊዶ ኣቲን ኢንቴስ ሱሬና፤","poem":2},{"lineBreak":true},{"text":"ሃልቾ ኬሲቴ፤","poem":2},{"lineBreak":true},{"text":"ጊዶ ኣቲን ኢንቴስ ሚኔና።","poem":2},{"text":"ጋሶይካ ጾሳይ ኑናራ ዴስ።","poem":3}]},{"type":"heading","content":["ጎዳን ኣማኔቴ"]},{"type":"verse","number":11,"content":["ጎዳይ ባ ሚኖ ኩሼ ታ ቦላ ዎዲ ታኒ ሃ ኣሳ ኦጌ ካሎንታ ማላ ሴሪዴስ፤"]},{"type":"verse","number":12,"content":[{"text":"«ሃይሲ ኣሳይ፥ ‹ኢታ ማቆ›","poem":1},{"text":"ጊ ጼይጊዛ ሚሽ","poem":2},{"lineBreak":true},{"text":"ኢንቴ ኣይኮካ፥","poem":2},{"text":"‹ኢታ ማቆ› ጎፒቴ፤","poem":3},{"text":"ኢስቲ ባቢዛይሳስ ኢንቴ ባቦፍቴ፤","poem":2},{"lineBreak":true},{"text":"ኢዛስ ያርኪያርኮፍቴ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኢንቴ ዱማሳና ቤሲዛይ","poem":1},{"text":"ኡባፌ ዎልቃማ ጎዳ ጻላ፤","poem":2},{"text":"ኢንቴ ያያናሲኔ","poem":3},{"lineBreak":true},{"text":"ኮኮራናስ ቤሲዛይ ኢዛ።","poem":3}]},{"type":"verse","number":14,"content":[{"text":"ኢዚ ጌሻሶሆ ጊዳና፤","poem":1},{"text":"ጊዶ ኣቲን ኢዚ","poem":2},{"lineBreak":true},{"text":"ዩሁዳ ቢታ ኣሳሲኔ","poem":2},{"lineBreak":true},{"text":"ኢስራኤሌ ኬ ኣሳስ","poem":2},{"lineBreak":true},{"text":"ጲዛ ሹቺኔ","poem":2},{"lineBreak":true},{"text":"ኩንዲሲዛ ዛላ ጊዳና፤","poem":2},{"lineBreak":true},{"text":"ዬሩሳላሜን ዲዛ ኣሳስ","poem":2},{"lineBreak":true},{"text":"ኢዚ ጊቴኔ ዎጺማዴ ጊዳና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኢስታፌ ዳሮቲ ጴታና፤","poem":1},{"text":"ኩንዲዲካ ሜቃና፤","poem":2},{"lineBreak":true},{"text":"ዎጺማዴን","poem":2},{"text":"ጌሊ ኦይኬታና» ጊዴስ።","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ማርካቴ ሎኤ ኦይካ፤","poem":1},{"text":"ታ ታማሬታ ጊዶን","poem":2},{"text":"ዎጋ ማታሜን ሾጫ።","poem":3}]},{"type":"verse","number":17,"content":[{"text":"ታኒ ባ ሲን ያቆቤ ዛሬታፔ","poem":1},{"text":"ጌንዳ ጎዳ ናጋና፤","poem":2},{"lineBreak":true},{"text":"ኢዛካ ሂዶታ ኦና።","poem":2}]},{"type":"verse","number":18,"content":["ታናኔ ታስ ጎዳይ ኢሚዳ ናይታ ቤኢቴ። ኑኒ ጺዮኔ ዙማን ዲዛ ኡባፌ ዎልቃማ ጎዳፔ ኢስራኤሌስ ማላታኔ ማርካ።"]},{"type":"verse","number":19,"content":["ኣሳይ ኢንቴና፥ «ቤሶንታዝ ታታፌቲሼኔ ሳሱኬቲሼ ሃሳዬቲዛ ቢቲዛይታኔ ሞይቲሌ ጼይጊዛይታ ኦይቺቴ» ጊኮ ዴሬይ ባ ጎዳ ኦይቻናስ ቤሴኔ? ዴኦ ጾሳ ኣጊዲ ሃይቂዳይታ ኦይሾ ኣይስ ኮሺዜ?"]},{"type":"verse","number":20,"content":["ዎጋኮኔ ማርካቴ ቃላኮ ቢቴ! ኢስቲ ሃይሳ ማላ ቃላ ኢንቴስ ዮቶንታ ኣጊኮ ዎንታ ፖኦይ ኢስታስ ፖኤና።"]},{"type":"verse","number":21,"content":["ኢስቲ ጬጪሼኔ ጋፊሼ ቢታ ቦላ ቶይላታና፤ ኢስቲ ኬሂ ጋፊዳ ዎዴ ሃንቄታና፤ ፑዴ ጼሊዲ ባንታ ካዋኔ ባንታ ጾሳ ቃንጋና።"]},{"type":"verse","number":22,"content":["ሄሳፌ ጉዬ ኢስቲ ዱጌ ቢታ ጼላና፤ ኢስቲ ጼላናይሲካ ዋዬ፥ ማኔ ፒ ጊዳ ባቢሲዛ ሚሽ ጻላ፤ ኢስቲ ጊርዲ ጊዳ ማን ዬጌታና።"]}],"footnotes":[{"noteId":2,"caller":"+","text":"8፡1 ማሄር-ሻላል ሃሽ-ባዝ ጉሲ ዲኣናሲኔ ቦንቃናስ ኤሌላ።","reference":{"chapter":8,"verse":1}}]},"thisChapterLink":"/api/gmv_etw/ISA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/ISA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/ISA/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}