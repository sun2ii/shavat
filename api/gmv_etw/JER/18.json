{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"JER","translationId":"gmv_etw","name":"ኤርማሳ ቲንቢቴ","commonName":"ኤርማሳ ቲንቢቴ","title":"ኤርማሳ ቲንቢቴ","order":24,"numberOfChapters":52,"sha256":"c48b849a64ad1199a0e346049834074db7498e08e4bd02bc4dea07d0ac10be81","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gmv_etw/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":18,"content":[{"type":"heading","content":["ማና ኬን ኤርማሳ"]},{"type":"verse","number":1,"content":["ጎዳ ማታፔ ኤርማሳኮ፥"]},{"type":"verse","number":2,"content":["«ዴንዳዳ ማናሶ ባ፤ ሄን ታ ኔስ ታ ኪታ ዮታና» ጊዛ ቃላይ ዪዴስ።"]},{"type":"verse","number":3,"content":["ታኒካ ዱጌ ማናዛሶ ባዲስ፤ ኢዚ ባ ሜዛ ኢርዞ ቦላ ኦቶ ሜሺን ቤኣዲስ።"]},{"type":"verse","number":4,"content":["ኢዚ ሜሺን ኦቶዚ ኢዛ ኩሼን ሞሬቲዴስ፤ ሂስቲን ኢዚ ሄ ኡርቃ ዛሪዲ ባ ኮዪዳ ማላ ሜዴስ።"]},{"type":"verse","number":5,"content":["ሄ ዎዴ ጎዳ ቃላይ፥"]},{"type":"verse","number":6,"content":["«ኢስራኤሌ ኣሳዉ! ማናዚ ኦዛይሳ ታ ኢንቴና ኦናስ ዳንዳይኪና? ኢስራኤሌ ኣሳዉ! ኡርቃይ ማና ኩሼን ዲዛይሳ ኢንቴካ ታ ኩሼን ዴታ።"]},{"type":"verse","number":7,"content":["ታኒ ኢሲ ዴሬይ ዎይኮ ኢሲ ካዎቴ ሾዴታና ማላ፥ ላሌታና ማላኔ ያና ማላ ዮቲኮ፥"]},{"type":"verse","number":8,"content":["ሄ ታኒ ዮቲዳ ካዎቴይ ባ ኢታቴፌ ኣጊዲ ሲሚኮ፥ ታኒ ኢስታ ቦላ ኤሃና ጊዳ ኢታ ሚሽ ኤሆንታ ኣጋጋና።"]},{"type":"verse","number":9,"content":["ቃሴ ሃራ ዎዴካ ታኒ ኢሲ ዴሬ ዎይኮ ኢሲ ካዎቴ ሚን ኤሳናስ ዮቲኮ፥"]},{"type":"verse","number":10,"content":["ታ ሲንን ኢታ ሚሽ ኦኮኔ ታስ ኣዛዜቶንታ ኢጺኮ፥ ‹ታ ኢዛስ ኦና› ጊዳ ሎኦ ሚሻ ኡባ ኦንታ ኣጋጋና» ጌስ።"]},{"type":"verse","number":11,"content":["ጎዳይ፥ «ሄሳ ጊሻስ፥ ኤርማሳ ሃኢ ዩሁዳ ኣሳታሲኔ ዬሩሳላሜን ዲዛይታስ ባዳ፥ ‹ሄኮ ታኒ ኢንቴ ቦላ ባሽ ጊጊሶ ቦላ ዳይስ፤ ኢንቴ ቦላ ኢታ ሚሽ ሜሼ ዳይስ፤ ሄሳ ጊሻስ ኢንቴ ኡባይካ ኢንቴ ቢዛ ኢታ ኦጌፔ ሲሚቴ፤ ኢንቴ ኦጌኔ ኢንቴ ኦሶ ሱሪሲቴ› ጋ ዮታ።"]},{"type":"verse","number":12,"content":["ጊዶ ኣቲን ኢስታስ፥ ‹ዳቡሮፓ፤ ኑ ሃልቺዳ ኦጌራ ባና፤ ኑኒ ኢሶይ ኢሶይ ኑ ኢታ ዎዚና ቆፋ ካላና› ጌቴስ» ጊዴስ።"]},{"type":"verse","number":13,"content":[{"text":"ሄሳ ጊሻስ ጎዳይ፥","poem":1},{"text":"«ኣኔ ካዎቴታ፥","poem":2},{"lineBreak":true},{"text":"‹ሃይሳ ማላ ሚሺ","poem":2},{"lineBreak":true},{"text":"ኢንቴ ጊዶን ሴቴቲ ኤሪዜ?›","poem":2},{"text":"ጊ ኦይቺቴ።","poem":3},{"text":"ጌላኦያ ኢስራኤሌይ ሃራሲዛ","poem":2},{"text":"ኢታ ሚሽ ኦዱስ።","poem":3}]},{"type":"verse","number":14,"content":[{"text":"ሹች ጻላ ጊዲዳ","poem":1},{"text":"ሊባኖሴ ዙማታ","poem":2},{"lineBreak":true},{"text":"ቦላፌ ሻቺ ዪ ኤሪዜ?","poem":2},{"lineBreak":true},{"text":"ላዴ ቦላፌ ዱጌ ጎጊዛ","poem":2},{"lineBreak":true},{"text":"ኢርጻ ሃ","poem":2},{"text":"ጎጌ ኣጊ ኤሪዜ?","poem":3}]},{"type":"verse","number":15,"content":[{"text":"ታ ዴሬይ ጊዲኮ ታና ባሊዴስ፤","poem":1},{"text":"ኢስቲ ጎኦንታ ጾሳታስ","poem":2},{"text":"ኤጻኔ ጩዋሴቴስ፤","poem":3},{"text":"ባንታ ኦጌራ ቢዲ ጴቲዳ፤","poem":2},{"lineBreak":true},{"text":"ቤኒ ኦጌፔ ካሬ ኬዚዳ፤","poem":2},{"lineBreak":true},{"text":"ባሴቶንታ ዲዛ ኩንዱኩርጮ","poem":2},{"text":"ኦጌራ ቢዳ።","poem":3}]},{"type":"verse","number":16,"content":[{"text":"ኢስታ ቢታይ ቡላኔ","poem":1},{"text":"ሜርናስ ካቲዳዝ ጊዳና፤","poem":2},{"lineBreak":true},{"text":"ሄራ ኣዛ","poem":2},{"lineBreak":true},{"text":"ኡባይ ማላሌታና፤","poem":2},{"lineBreak":true},{"text":"ባ ሁኤካ ቂሼ ቃና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኣርሼይ ሞኪዛ ባጋ ጫርኮ ማላ","poem":1},{"text":"ታኒ ኢስታ ኢስታ","poem":2},{"text":"ሞርኬታ","poem":3},{"text":"ሲንን ላላና።","poem":2},{"lineBreak":true},{"text":"ኢስቲ ይዛ ጋላስ ታ ኢስታስ","poem":2},{"text":"ዞኮ ዛራና ኣቲን","poem":3},{"text":"ታ ኣይፌሶ ቤሲኬ» ጌስ።","poem":2}]},{"type":"heading","content":["ኤርማሳ ቦላ ማቄቲዳ ማቆ"]},{"type":"verse","number":18,"content":["ኢስቲካ፥ «ኣኔ ሃ ዪቴ፤ ኤርማሳ ቦላ ማቄቶስ፤ ዎጋይ ቄሴታ ኣቻን፥ ዞሬይ ኣ ኤራንቻታ ኣቻን፥ ቃላይካ ናቤታ ኣቻን ዬና፤ ኣኔ ሃ ዪቴ፤ ኑ ኢንጻርሳን ኢዛ ቶቾስ፤ ኢዚ ጊዛይሳካ ኡባ ሲዮኮ» ጊዳ።"]},{"type":"verse","number":19,"content":[{"text":"ኣቤት ጎዳዉ! ታ ጊዛዝ ሲያ፤","poem":1},{"text":"ታ ሞርኬቲ ታ ቦላ","poem":2},{"text":"ሃሳይዛይሳ ኤዝጋ።","poem":3}]},{"type":"verse","number":20,"content":[{"text":"ሎኦ ኦዳዴስ ኢታ ዛሪዞ?","poem":1},{"text":"ኢስቲ ጊዲኮ","poem":2},{"lineBreak":true},{"text":"ታስ ኦላ ቦኪዳ፤","poem":2},{"text":"ኔ ሃንቆይ ኢስታፌ ሲማና ማላ","poem":3},{"lineBreak":true},{"text":"ኔ ሲንን ኤቃዳ","poem":3},{"text":"ኢስታ ጊሻስ","poem":2},{"text":"ታ ዮቲዳይሳ ቆፓ።","poem":3}]},{"type":"verse","number":21,"content":[{"text":"ሄሳ ጊሻስ","poem":1},{"text":"ኢስታ ናይታ ኮሻሲኔ","poem":2},{"lineBreak":true},{"text":"ማሻስ ኣ ኢማ፤","poem":2},{"lineBreak":true},{"text":"ኢስታ ማጫሳቲ ማይኔኔ","poem":2},{"text":"ኣምኤታ ጊዴቶ፤","poem":3},{"text":"ኢስታ ኣቱማሳቲካ","poem":2},{"text":"ፓራ ሃይቆን ዉሬቶ፤","poem":3},{"text":"ኢስታ ናቴ ናይቲ","poem":2},{"text":"ኦላሶን ማሻስ ጊዴቶ","poem":3}]},{"type":"verse","number":22,"content":[{"text":"ኢስቲ ታና ኩንዲሳናስ","poem":1},{"text":"ኦላ ቦኪዛ ጊሻሲኔ","poem":2},{"lineBreak":true},{"text":"ታ ቶሆስካ ዎጺማዴ","poem":2},{"lineBreak":true},{"text":"ዎዳ ጊሻስ","poem":2},{"text":"ኢስቲ ቆፖንታ ኔኒ ኢስታ ቦላ","poem":3},{"lineBreak":true},{"text":"ቦንቂዛይታ ዬዲን","poem":3},{"lineBreak":true},{"text":"ኢስታ ኬን ዋሶይ ኬዞ።","poem":3}]},{"type":"verse","number":23,"content":[{"text":"ጊዶ ኣቲን ኣቤት ጎዳዉ!","poem":1},{"text":"ኢስቲ ታና ዎናስ ማቄቲዳይሳ","poem":2},{"text":"ኡባ ኔኒ ኤራሳ፤","poem":3},{"text":"ኔኒ ኢስታ ኢታቴ","poem":2},{"lineBreak":true},{"text":"ኣቶ ጎፓ፥","poem":2},{"lineBreak":true},{"text":"ዎይኮ ኢስታ ናጋራ","poem":2},{"text":"ኔ ሲንፌ ቁጮፋ፤","poem":3},{"text":"ኢስቲ ኔ ሲንን","poem":2},{"lineBreak":true},{"text":"ጾኔቲዲ ኩንዴቶ፤","poem":2},{"lineBreak":true},{"text":"ኔ ሃንቆ ጋላስ","poem":2},{"text":"ኔ ኢስታ ማሮፓ።","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/JER/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/JER/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/JER/17.json","previousChapterAudioLinks":{},"numberOfVerses":23}