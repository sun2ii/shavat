{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"JER","translationId":"gmv_etw","name":"ኤርማሳ ቲንቢቴ","commonName":"ኤርማሳ ቲንቢቴ","title":"ኤርማሳ ቲንቢቴ","order":24,"numberOfChapters":52,"sha256":"c48b849a64ad1199a0e346049834074db7498e08e4bd02bc4dea07d0ac10be81","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gmv_etw/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":20,"content":[{"type":"heading","content":["ኤርማሳኔ ፓሽኩሬ"]},{"type":"verse","number":1,"content":["ሄ ዎዴ ጎዳ ኬን ኢሜሬ ና ቄሴ ፓሽኩሬይ ኤርማሲ ቲንቢቴ ዮቲሺን ሲዪዲ፥"]},{"type":"verse","number":2,"content":["ናቤ ኤርማሳ ሾጪዴስ፤ ጾሳ ኬፌ ፑዴ ባጋራ ዲዛ ቢኒያሜ ጊምቤ ፔንጌ ቦላ ኣግሪሞቄን ቃቺዴስ።"]},{"type":"verse","number":3,"content":["ዎንቴ ጋላስ ፓሽኩሬይ ኤርማሳ ቃሾፔ ቢርሺን ኤርማሲ ኢዛስ፥ «ሃቺፌ ዶሚን ጎዳይ ኔ ሱን ማጎርሚሳቢቤ",{"noteId":3},"ጋና ኣቲን ፓሽኩሬ ጌና።"]},{"type":"verse","number":4,"content":["ጋሶይካ ጎዳይ፥ ‹ታኒ ኔናኔ ኔ ላጌታ ኡባ ዳጋማስ ኣ ኢማና፤ ኢስቲ ኔኒ ጼሊሺን ባንታ ሞርኬታ ማሻን ዉራና፤ ታኒ ዩሁዳ ኣሳ ኡባ ባቢሎኔ ካዎ ኩሼን ኣ ኢማና፤ ኢዚ ኢስታ ዲኢዲ ባቢሎኔ ኤፋና፤ ሂስቲዲ ሄን ኢስታ ማሻን ሲፋና።"]},{"type":"verse","number":5,"content":["ሃ ካታማይ ኣቆታ፥ ኢዛ ኦ ዴሚዳ ኡባ፥ ዩሁዳ ካዎታ ኣቆታኔ ኢስታስ ዲዛ ኣልኦ ሚሽ ኡባ ታኒ ኢስታ ሞርኬታስ ኣ ኢማና፤ ኢስቲካ ዲኢ ኤኪዲ ባቢሎኔ ኤፋና።"]},{"type":"verse","number":6,"content":["ፓሽኩሬ! ኔኒኔ ኔ ሶሆን ዲዛ ኡባይካ ዲኤቲዲ ባቢሎኔ ባና። ኔኒኔ ኔ ኢስታስ ዎርዶ ቲንቢቴ ዮቲዳ ኔ ላጌቲ ኡባይ ሄን ሃይቃናኔ ሞጌታና› ጌስ» ጊዴስ።"]},{"type":"heading","content":["ኤርማሳ ዙዙን"]},{"type":"verse","number":7,"content":[{"text":"ኣቤት ጎዳዉ!","poem":1},{"text":"ኔኒ ታና ጪማዳሳ፤","poem":2},{"lineBreak":true},{"text":"ታኒካ ጪሜታዲስ።","poem":2},{"lineBreak":true},{"text":"ኔኒ ታፔ ኬሃ ሚናዳ","poem":2},{"lineBreak":true},{"text":"ታና ጾናዳሳ።","poem":2},{"lineBreak":true},{"text":"ጋላስ ኩሜ ታኒ ኣሳስ","poem":2},{"text":"ሚቻስ ኣታዲስ፤","poem":3},{"text":"ኡባይካ ታና ቂስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታኒ ሃሳይዛ ዎዴ","poem":1},{"text":"ኡባን ዋሳይስ፤","poem":2},{"lineBreak":true},{"text":"«ሺሮኔ ባሽ» ጋ ኣዋጃይስ፤","poem":2},{"text":"ሄሳ ጊሻስ ጎዳ ቃላይ","poem":3},{"lineBreak":true},{"text":"ታስ ኩሜ ጋላስ ታ ቦላ","poem":3},{"lineBreak":true},{"text":"ጫሼኔ ቂ ኤሂዴስ።","poem":3}]},{"type":"verse","number":9,"content":[{"text":"ታኒ፥ «ሃይሳፌ ጉዬ","poem":1},{"text":"ጎዳ ሱን ዴንኬ፤","poem":2},{"lineBreak":true},{"text":"ኢዛ ሱንንካ","poem":2},{"lineBreak":true},{"text":"ሃሳይኬ» ጊኮ","poem":2},{"lineBreak":true},{"text":"ኢዛ ቃላይ ታ ዎዚና ጊዶን","poem":2},{"lineBreak":true},{"text":"ታማ ማላ፥","poem":2},{"lineBreak":true},{"text":"ታ ሜቄ ጊዶንካ","poem":2},{"text":"ሱርቁንቶ ማላ ጊዲዴስ፤","poem":3},{"text":"ሄሳ ጊሻስ","poem":2},{"text":"ታ ካማ ኦይካናስ ጾኒዴስ፤","poem":3},{"lineBreak":true},{"text":"ሙሌራካ ኤቄታናዉ","poem":3},{"lineBreak":true},{"text":"ዳንዳያቤኬ።","poem":3}]},{"type":"verse","number":10,"content":[{"text":"«ኡባሶን ሺሮይ ዴስ፤","poem":1},{"text":"ሂሊቴ ኣኔ ኑኒካ ሂሎስ» ጊዲ","poem":2},{"lineBreak":true},{"text":"ዳሮቲ ሳሱኬቲሺን ታ ሲያዲስ፤","poem":2},{"text":"ታ ኩንዴ ናጌቲሼ ዲዛ","poem":3},{"lineBreak":true},{"text":"ታ ላጌቲ ኡባይ፥","poem":3},{"lineBreak":true},{"text":"«ኦኔ ኤሪዛይ","poem":3},{"lineBreak":true},{"text":"ባሌታና ዳንዳይዛኮ","poem":3},{"lineBreak":true},{"text":"ሂስቲኮ ኑኒ ኢዛ ጾናናኮኔ","poem":3},{"lineBreak":true},{"text":"ኑ ሃሎ ኬሳናኮ» ጌቴስ።","poem":3}]},{"type":"verse","number":11,"content":[{"text":"ጊዶ ኣቲን ጎዳይ ያሺሲዛ","poem":1},{"text":"ቶራ ቃራ ማላ ታናራ ዴስ፤","poem":2},{"lineBreak":true},{"text":"ሄሳ ጊሻስ ታና ዬዴዛይቲ","poem":2},{"text":"ጴታና ኣቲን ታና ጾኔቴና፤","poem":3},{"text":"ኢስቲ ኢታ ካዉሽ ካዉያና ኣቲን","poem":2},{"text":"ኢስታስ ጊጌና፤","poem":3},{"lineBreak":true},{"text":"ኢስታ ካዉሻቴይ","poem":3},{"lineBreak":true},{"text":"ሙሌካ ዶጌቴና።","poem":3}]},{"type":"verse","number":12,"content":[{"text":"ኣቤት ኡባፌ","poem":1},{"text":"ዎልቃማ ጎዳዉ!","poem":2},{"lineBreak":true},{"text":"ጺሎዛ ፓጪዛይሶ!","poem":2},{"lineBreak":true},{"text":"ዎዚናኔ ካሃ","poem":2},{"lineBreak":true},{"text":"ፒልጋ ጼሊዛይሶ!","poem":2},{"text":"ታኒ ታ ሞቶ ኔስ","poem":3},{"lineBreak":true},{"text":"ኣ ኢሚዳ ጊሻስ","poem":3},{"lineBreak":true},{"text":"ኔኒ ኢስታ ቦላ ሃሎ ኬሲሺን","poem":3},{"lineBreak":true},{"text":"ታ ኣይፌን ቤኣናስ ታና ጋ።","poem":3}]},{"type":"verse","number":13,"content":[{"text":"ጎዳስ ዬጺቴ!","poem":1},{"text":"ኢዛስ ጋላታ ሺሺቴ፤","poem":2},{"lineBreak":true},{"text":"ኢዚ ሜቶታንቻታ ሼምፖ","poem":2},{"lineBreak":true},{"text":"ኢታታ ኩሼፔ ኣሼስ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታኒ ዬሌቲዳ ጋላሳያ","poem":1},{"text":"ቃንጌቲዳሮ ጊዱ!","poem":2},{"lineBreak":true},{"text":"ታ ኣዬያ ታና ዬሊዳ","poem":2},{"text":"ጋላሳያ ኣንጄቱፉ!","poem":3}]},{"type":"verse","number":15,"content":[{"text":"ታ ኣዋስ፥ «ኔስ ሚሺራቾ፤","poem":1},{"text":"ኔስ ኣቱማ ናይ ዬሌቲዴስ!»","poem":2},{"lineBreak":true},{"text":"ጊ ዮቲዳይ ቃንጌቲዳዴ ጊዶ!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሄሳዴይ ጎዳይ ቃታይ ባይንዳ","poem":1},{"text":"ሺሬቺ ዬጊዳ","poem":2},{"lineBreak":true},{"text":"ካታማታ ማላ ጊዶ፤","poem":2},{"lineBreak":true},{"text":"ማላዶ ዋሶ፥ ጋላሳ ሴታን","poem":2},{"text":"ኦላ ሺሮ ሲዮ።","poem":3}]},{"type":"verse","number":17,"content":[{"text":"ታ ኣያ ታስ ዱፎ ጊዳና ማላ፥","poem":1},{"text":"ኢዚ ኡሎይ ታስ ሜርና","poem":2},{"text":"ዱሳሶ ጊዳና ማላ","poem":3},{"text":"ታና ሄን ኣይስ ዎቤኔ?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ታኒ ሜቶኔ ጬጬ ቤኣናሲኔ","poem":1},{"text":"ታ ዴኦ ላይ ኡባ","poem":2},{"lineBreak":true},{"text":"ካዉሻቴን","poem":2},{"lineBreak":true},{"text":"ዉርሳናስ ታ ኣዪ ኡሎፔ","poem":2},{"text":"ኣይስ ኬዛዲና?","poem":3}]}],"footnotes":[{"noteId":3,"caller":"+","text":"20፡3 ማጎርሚሳቢቤ፡ ማጎርሚሳቢቤ ጌቴቲዛይሳ ኢብራዌታ ቃላ ቢርሼ ኡባ ሚሻንካ ዳጋማ ጉሳ።","reference":{"chapter":20,"verse":3}}]},"thisChapterLink":"/api/gmv_etw/JER/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/JER/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/JER/19.json","previousChapterAudioLinks":{},"numberOfVerses":18}