{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"JER","translationId":"gmv_etw","name":"ኤርማሳ ቲንቢቴ","commonName":"ኤርማሳ ቲንቢቴ","title":"ኤርማሳ ቲንቢቴ","order":24,"numberOfChapters":52,"sha256":"c48b849a64ad1199a0e346049834074db7498e08e4bd02bc4dea07d0ac10be81","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gmv_etw/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":21,"content":[{"type":"heading","content":["ዬሩሳላሜ ጾኔቴ ጊሻስ ዮቴቲዳ ቲንቢቴ"]},{"type":"verse","number":1,"content":["ዩሁዳ ካዎ ሴዴቂያሲ ማልኪያ ና ፓሽኩሬኔ ማኢሳያ ና ቄሴ ሶፎናሳ ኤርማሳኮ ኪቲዳ ዎዴ ጎዳ ቃላይ ኤርማሳኮ ዪዴስ።"]},{"type":"verse","number":2,"content":["ኪቴቲዳይቲካ፥ «ባቢሎኔ ካዎ ናቡካዳናጾሬይ ባ ኦላንቻታራ ሃ ካታማ ጊዶዳ ጊሻስ ኣኔ ኑስ ጎዳ ኦይቻ። ጎዳይ ቤኒይሳ ማላ ማላሊሲዛ ኦሶ ኑ ጊሻስ ኦዲ ኢዛ ጉዬ ዛራናኮ ኦኒ ኤሪዜ» ጊ ኦይቺዳ።"]},{"type":"verse","number":3,"content":["ኤርማሲ ጊዲኮ ኢስታስ፥ «ቢዲ ሴዴቂያሳስ፥"]},{"type":"verse","number":4,"content":["‹ጎዳ ኢስራኤሌ ጾሳይ ኔና ጊምቤዛፔ ካሬ ባጋራ ዶዲ ኡቲዳ ባቢሎኔ ካዎኔ ኢዛ ኦላንቻታ ኦላናስ ኢንቴ ኩሼን ኢንቴ ኦይኪዳ ኦላ ሚሻ ታኒ ኢንቴ ቦላ ጉዬ ዛራና። ኢስታ ሃ ካታማዮ ዛራ ጌልና።"]},{"type":"verse","number":5,"content":["ታኒ ታ ሁኤራ ቂጻቴስ ዴንዳ ኩሼኒኔ ሚኖ ቄሴን፥ ሃንቆኒኔ ባሻን፥ ጊታ ቦሻን ታ ኢንቴና ጫዳና።"]},{"type":"verse","number":6,"content":["ታኒ ሃ ካታማይን ዲዛ ኣሳኔ ሜሃ ሾጫና፤ ኢስቲካ ኢታ ሃርጌን ዉራና።"]},{"type":"verse","number":7,"content":["ሄሳፌ ጉዬ ዩሁዳ ካዎ ሴዴቂያሳኔ ኢዛ ሹሜታ፥ ኢታ ሃርጌፌ፥ ማሻፌኔ ኮሻፔ ኣቲዳ ዴራ ባቢሎኔ ካዎ ናቡካዳናጾሬሲኔ ኢስታ ዎናስ ኮይዛ ሞርኬታስ ታኒ ጎዳይ ኣ ኢማና። ኢዚ ኢስታ ቃራ ማሻን ዎና፤ ኢስታ ማሬና፤ ኢስታስ ሚሼቴናኔ ቃቴና› ጌስ» ጊቴ።"]},{"type":"verse","number":8,"content":["ጎዳይ ኤርማሳ፥ «ጉጃዳካ ሃይሳ ዴራስ፥ ‹ጎዳይ ሄኮ ታኒ ኢንቴ ሲንን ዴኦ ኦጌኔ ሃይቆ ኦጌ ዎዲስ።"]},{"type":"verse","number":9,"content":["ሃኖ ሃ ካታማይን ታኪዛ ኡባይ ማሻን፥ ኮሻኒኔ ኢታ ሃርጌን ሃይቃና፤ ጊዶ ኣቲን ካታማይፔ ኬዚ ቢዲ ካታማ ዶዲ ኦይኪዳ ባቢሎኔ ኣሳታስ ባ ኩሼ ኢሚዳ ኣሲ ባ ሼምፖ ኣሻናኔ ዴኦን ዳና።"]},{"type":"verse","number":10,"content":["ታኒ ሃ ካታማስ ሎኦ ኦናስ ጊዶንታ ኢታ ኦናስ ቃቻዲስ፤ ኢዛ ባቢሎኔ ካዎስ ኣ ኢሜታና፤ ኢዚካ ኢዞ ታማን ጹጋና› ጌስ።"]},{"type":"verse","number":11,"content":["«ቃሴካ ዩሁዳ ካዎ ኬ ኣሳስ፥",{"text":"‹ጎዳ ቃላ ሲዪቴ!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኢንቴኖ ዳዊቴ ሶ ኣሳዉ!","poem":1},{"text":"ኢንቴ ኦዳ ኢታ ኦሶ ጋሶን","poem":2},{"text":"ኤጺን ኦኒካ ቶይሳና","poem":3},{"lineBreak":true},{"text":"ዳንዳዮንታ ታማ ማላ","poem":3},{"lineBreak":true},{"text":"ታ ሃንቆይ ኢንቴ ቦላ","poem":3},{"lineBreak":true},{"text":"ኤጾንታ ማላ","poem":3},{"lineBreak":true},{"text":"ዎንታን ዎንታን ሱሬ ፒርዲቴ፤","poem":3},{"text":"ቦንቄቲዳይታ ኡንኤዛይታ","poem":2},{"text":"ኩሼፔ ኣሺቴ› ጌስ ጋ።","poem":3}]},{"type":"verse","number":13,"content":[{"text":"‹ሃኔ ሾባፌ ፑዴ ባጋራ","poem":1},{"text":"ሹቺ ዳሪ ዲዛሶን ዲዛ","poem":2},{"lineBreak":true},{"text":"ዬሩሳላሜ!","poem":2},{"lineBreak":true},{"text":"ታኒ ኔ ቦላ ዴንዳዲስ፤","poem":2},{"lineBreak":true},{"text":"ኑ ቦላ ኦኔ ዴንዳናይ?","poem":2},{"lineBreak":true},{"text":"ኑ ኬ ኦኔ","poem":2},{"lineBreak":true},{"text":"ጻሊ ጌላናይ?› ጊዛሬ!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታኒ ኔና ኔ ኦሶ ማላ ቃጻያና፤","poem":1},{"text":"ታኒ ኔ ዎራን ታማ ዬዳና፤","poem":2},{"lineBreak":true},{"text":"ኢዛ ዩሾን ዲዛይሳካ","poem":2},{"text":"ኡባ ጹጋና» ጌስ።","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/JER/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/JER/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/JER/20.json","previousChapterAudioLinks":{},"numberOfVerses":14}