:true},{"text":"ሄሳ ማላ ጋላሲ ዴና፤","poem":2},{"lineBreak":true},{"text":"ሄ ጋላሳይ ያቆቤ","poem":2},{"lineBreak":true},{"text":"ዜሬታስ","poem":2},{"text":"ሜቶ ጋላስ ጊዳና፤","poem":3},{"text":"ጊዶ ኣቲን ኢስቲ","poem":2},{"text":"ሄ ሜቶዛፔ ኣታና» ጌስ።","poem":3}]},{"type":"verse","number":8,"content":[{"text":"ጎዳይ ኡባፌ","poem":1},{"text":"ዎልቃማ ጾሳይ፥","poem":2},{"lineBreak":true},{"text":"«ሄ ጋላስ ታኒ ኢስታ ሞርጌፌ","poem":2},{"text":"ቃምባራ ሜንና፤","poem":3},{"text":"ኢስቲ ቃሼቲዳ","poem":2},{"lineBreak":true},{"text":"ሳንሳላታካ ዱና፤","poem":2},{"lineBreak":true},{"text":"ሃይሳፌ ጉዬን","poem":2},{"lineBreak":true},{"text":"ኣላጋይ ኢስታ ሃሬና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ጊዶ ኣቲን ጎዳስ","poem":1},{"text":"ባንታ ጾሳሲኔ","poem":2},{"lineBreak":true},{"text":"ታኒ ኢስታስ ካዎዳ","poem":2},{"text":"ካዎ ዳዊቴ ዛሬስ","poem":3},{"lineBreak":true},{"text":"ኢስቲ ሃሬታና» ጌስ።","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«ሄሳ ጊሻስ ታ ኣይሌ","poem":1},{"text":"ያቆቤ ዛሬቶ ያዮፍቴ!","poem":2},{"lineBreak":true},{"text":"ኢንቴኖ ኢስራኤሌቶ ዳጋሞፍቴ!","poem":2},{"lineBreak":true},{"text":"ኢንቴ ሃሆሶን ዲሺን","poem":2},{"text":"ታኒ ኢንቴና ኣሻና፤","poem":3},{"text":"ኢንቴ ዛሬታካ ኢስቲ ዲኤቲዳ","poem":2},{"text":"ቢታፌ ኬሳ ኤካና፤","poem":3},{"text":"ያቆቤ ዛሬቲ ሲሚዲ","poem":2},{"text":"ሳሮኒኔ ዎፓን ኡታና፤","poem":3},{"text":"ኢስታ ያሺሳና","poem":2},{"lineBreak":true},{"text":"ኣይ ሚሺካ ዴና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታኒ ኢንቴና ኣሻናስ","poem":1},{"text":"ኢንቴናራ ዳይስ፤","poem":2},{"lineBreak":true},{"text":"ታኒ ኢንቴና","poem":2},{"text":"ካዎቴታ ጊዶን ላላዲስ፤","poem":3},{"text":"ሄ ካዎቴታ","poem":2},{"text":"ሙሌራ ይሳና፤","poem":1},{"text":"ጊዶ ኣቲን ኢንቴና","poem":2},{"text":"ሙሌራ ይሲኬ፤","poem":3},{"text":"ታኒ ቂጻቴይ ባይንዳ ጮ ኣጊኬ፤","poem":2},{"lineBreak":true},{"text":"ጊዲኮካ ታኒ ኢንቴና","poem":2},{"text":"ጊናራ ቃጻያና» ጌስ ጎዳይ።","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ጎዳይ፥ «ኢንቴ ሜቆይ ኮሌቴና፤","poem":1},{"text":"ኢንቴ ማዱንይ ፓጼና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኢንቴ ጊሻስ ሞቴቲዛይ ዴና፤","poem":1},{"text":"ኢንቴ ማዱን