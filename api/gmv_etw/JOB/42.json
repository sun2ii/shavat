{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"JOB","translationId":"gmv_etw","name":"ኢዮቤ ማጻፋ","commonName":"ኢዮቤ ማጻፋ","title":"ኢዮቤ ማጻፋ","order":18,"numberOfChapters":42,"sha256":"a91ef69ff34acda59d1d12eeee65a95cdb930d195048517600b042a39ef18b30","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gmv_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":42,"content":[{"type":"heading","content":["ኢዮቢ ባና ካዉሺዴስ"]},{"type":"verse","number":1,"content":["ሃይሳፌ ጉዬን ኢዮቢ ጾሳስ ሂዝጊ ዛሪዴስ፤"]},{"type":"verse","number":2,"content":[{"text":"«ታ ጎዳዉ!","poem":1},{"text":"ኔኒ ኡባ ሚሽ ኦናስ","poem":2},{"text":"ዳንዳይዛይሳ ታ ኤራዲስ፤","poem":3},{"text":"ኔ ቆፋካ","poem":2},{"lineBreak":true},{"text":"ጲ ዲጋናይ ዴና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታ ኤሪዛራ ኬሂ ጉ ጊዲሺን","poem":1},{"text":"ታ ዳሮ ሃሳይዛይሳ","poem":2},{"lineBreak":true},{"text":"ኣዛስ ጊዲዳኮ","poem":2},{"lineBreak":true},{"text":"ኔ ኦይቻዳሳ፤","poem":2},{"lineBreak":true},{"text":"ቱሙካ ታኒ ኤሮንታይሳኔ","poem":2},{"text":"ኣኬኮንታ ኡባ ሃሳያዲስ።","poem":3}]},{"type":"verse","number":4,"content":[{"text":"‹ታ ኦይሻ ኤዝጋ ሲያዳ","poem":1},{"text":"ታስ ዛሮ ኢማ› ጋዳሳ።","poem":3}]},{"type":"verse","number":5,"content":[{"text":"ታ ሃኖ ጋካናስ ኔ ጊሻስ ኤሪዛይሲ","poem":1},{"text":"ኣሳፔ ሲዮይሳን ጻላ፤","poem":2},{"lineBreak":true},{"text":"ሃኢ ጊዲኮ ታ ኣይፌታን","poem":2},{"text":"ታ ኔና ቤያዲስ።","poem":3}]},{"type":"verse","number":6,"content":[{"text":"ሄሳፌ ዴንዲዳይሳን","poem":1},{"text":"ታ ሃሳይዳ ሚሻቲ","poem":2},{"text":"ታና ዬላቺዳ ጊሻስ","poem":3},{"lineBreak":true},{"text":"ቢዲንኒኔ ጉዱላን ኡታዳ","poem":3},{"lineBreak":true},{"text":"ታ ኔፔ ማሬታና።»","poem":3}]},{"type":"heading","content":["ኩሻ ቆፋ"]},{"type":"verse","number":7,"content":["ጾሲ ኢዮቤራ ሃይታንታ ኡባ ሃሳዬቲዳፔ ጉዬ ቴማኔ ዴሬ ኣስ ኤልፋዜስ፥ «ኢንቴ ታ ኣይሌ ኢዮቤ ማላ ታ ጊሻስ ሊኬ ሃሳዮንታ ጊሻስ ታኒ ኔ ቦላኔ ኔ ላጌታ ቦላ ሃንቄታዲስ።"]},{"type":"verse","number":8,"content":["ሄሳ ጊሻስ ሃኢ ላፑን ዎፋኖታኔ ላፑን ርሾታ ኤኪዲ ታ ኦሳንቻ ኢዮቤኮ ቢቴ። ሄን ኢንቴ ናጋራ ጊሻስ ጹጌቲዛ ያርሾ ሺሺቴ። ታ ኦሳንቻ ኢዮቢ ኢንቴስ ዎሳና፤ ታኒካ ኢዛ ዎሳ ሲያዳ ኢንቴና ኢንቴ ናጋራ ማላ ቃጻይኬ። ኢንቴ ታስ ኢዮቤ ማላ ሎኦ ሚሽ ሃሳይቤኬታ» ጊዴስ።"]},{"type":"verse","number":9,"content":["ሄሳፌ ጉዬ ቴማኔ ዴሬ ኣስ ኤልፋዜይ፥ ሹሃ ዴሬ ኣስ ቤሊዳዲኔ ናኢማኔ ዴሬ ኣስ ዞፋሬይ ቢዲ ጾሲ ኢስታ ኣዛዚዳ ማላ ኦዳ። ጾሲካ ኢዮቤ ዎሳ ሲዪዴስ።"]},{"type":"verse","number":10,"content":["ኢዮቢ ባ ሄ ላጌታስ ዎሲዳፔ ጉዬ ጾሲ ኢዚ ዛሪ ዱሬታና ማላ ኦዴስ። ካሴ ኢዛስ ዲዛይሳፌ ኣዲ ዳኮ ኢዛስ ኢሚዴስ።"]},{"type":"verse","number":11,"content":["ሄ ዎዴ ኢዮቤ ኢሻቲ፥ ኢዛ ሚቼቲኔ ካሴ ኢዛ ኤሪዛይቲ ኡባይ ኢዛ ቤያናስ ዪዳ። ኢዛራ ኢሲፌ ኢዛሶን ካ ሚዳ፤ ኢስቲ ኢዛስ ሚሼቲዛይሳ ቆንጪሲዲ ጾሲ ኢዛ ቦላ ጋዳ ሜቶዛ ጊሻስ ኢዛ ሚንዳ። ኢሶይ ኢሶይ ቢራፔኔ ዎርቃፌ ኦሴቲዳ ሚዲጋ ኢዛስ ኢሞታ ኢሚዳ።"]},{"type":"verse","number":12,"content":["ጾሲ ኢዮቤስ ዉርሴ ዴኦዛ ኮይሮይሳፌ ኣ ኣንጂዴስ። ሄሳ ጊሻስ ኢዮቤስ 14,000 ዶርሲ፥ 6,000 ጋሜላቲ፥ 1,000 ዋ ቦራቲ፥ 1,000 ማጫ ሃሬቲ ዴቴስ።"]},{"type":"verse","number":13,"content":["ቃሴካ ላፑን ኣቱማ ናይታኔ ሄ ማጫ ናይታ ዛሪ ዬሊዴስ።"]},{"type":"verse","number":14,"content":["ማጫ ናይታፔ ኮይሮሮ ዪሚማ፥ ናምኣንዮ ቄጺኦ፥ ሄንዮ ቄሬኔ-ሃፊኮ ጊዲ ሱንዴስ።"]},{"type":"verse","number":15,"content":["ቢታ ቦላ ኢዮቤ ማጫ ናይታ ማላ ሜ ሎኦ ማጫይ ቤቲቤና። ኢስታ ኣዋይ ኢስታስ ኢስታ ኢሻታራ ቢታ ላታና ማላ ሻኪ ኢሚዴስ።"]},{"type":"verse","number":16,"content":["ሄሳፌ ጉዬ ኢዮቢ 140 ዴኢዴስ። ባ ናይታ ኦይዳን ዬሌታ ጋካናስ ቤዪዴስ።"]},{"type":"verse","number":17,"content":["ኢዮቢ ዳሮ ላይ ዲዲ ሎኦ ጪማ ጪሚዲ ሃይቂዴስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/JOB/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/PSA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/JOB/41.json","previousChapterAudioLinks":{},"numberOfVerses":17}