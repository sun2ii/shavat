{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"JON","translationId":"gmv_etw","name":"ዮናሳ ቲንቢቴ","commonName":"ዮናሳ ቲንቢቴ","title":"ዮናሳ ቲንቢቴ","order":32,"numberOfChapters":4,"sha256":"29ac4c061a51c787455368fdb6166b78ec0cb90641341621e5cd7dad951b33c1","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/gmv_etw/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["ዮናሳ ዎሳ"]},{"type":"verse","number":1,"content":["ዮናሲ ሞሌዛ ኡሎን ዲሼ ባ ጎዳኮ፥"]},{"type":"verse","number":2,"content":["«ታኒ ቱጋ ጊዶን ዳሼ ጎዳ ጼይጊን ኢዚ ታስ ኮዪዴስ፤ ታኒ ሃይቂዳይቲ ዲዛ ጪማ ጊዶን ዳሼ ኔኮ ዋሳዲስ፤ ኔካ ታ ዋሶ ሲያዳሳ።"]},{"type":"verse","number":3,"content":["ኔ ታና ጪማ ኣባ ጊዶ ዱጌ ዬጋዳሳ፤ ሃ ታና ዶዲዴስ፤ ኔ ዳምባላይ ታ ቦላራ ኣዴስ።"]},{"type":"verse","number":4,"content":["ሄሳ ጊሻስ ታኒ፥ ‹ታ ኔ ሲንፌ ዎራ ኦሌታዲስ፤ ጊዲኮካ ታ ኔ ጌሻ ኬ ቃሴካ ዛራ ቤኣና› ጋዲስ።"]},{"type":"verse","number":5,"content":["«ሃይ ታስ ቆ ጋካናስ ሚቲዴስ፤ ጪማ ኣባይ ታና ሚቲዴስ፤ ኣባ ጊዶን ዲዛ ማታይካ ታ ሁኤ ቦላ ጻጼቲዴስ።"]},{"type":"verse","number":6,"content":["ታኒ ዙማታ ጋርስ ዱጌ ዎዲስ፤ ሄን ቢታ ጋርሳን ሜርናስ ጎርዳን ኡታዲስ፤ ጊዲኮካ ኣቤት ታ ጎዳዉ! ኔኒ ታ ሼምፖ ጪማ ኦላፌ ኬሳዳሳ።"]},{"type":"verse","number":7,"content":["«ታኒ ሃይቃና ማቲዳ ዎዴ ኔና ጎዳ ቆፓዲስ። ታ ዎሳይካ ኔኮ ፑዴ ጌሻ ኬ ጋኪዴስ።"]},{"type":"verse","number":8,"content":["ሃዳ ኤቃታ ካሊዛይቲ ዉሪ ኔናን ጎዳን ኣማኔታናይሳ ኣጊዳ።"]},{"type":"verse","number":9,"content":["ጊዶ ኣቲን ታ ጋላታ ኔስ ያርሻና፤ ታ ኣዲኔቲዳይሳ ኡባካ ጋና፤ ኣይስ ጊኮ ኣቶቴ ጎዳፔ ዬስ» ጊ ዎሲዴስ።"]},{"type":"verse","number":10,"content":["ሄሳፌ ጉዬ ጎዳይ ሞሌዛ ኣዛዚን ሞሌዚ ዮናሳ ቢታ ቦላ ጮዪዴስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}