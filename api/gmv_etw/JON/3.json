{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"JON","translationId":"gmv_etw","name":"ዮናሳ ቲንቢቴ","commonName":"ዮናሳ ቲንቢቴ","title":"ዮናሳ ቲንቢቴ","order":32,"numberOfChapters":4,"sha256":"29ac4c061a51c787455368fdb6166b78ec0cb90641341621e5cd7dad951b33c1","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/gmv_etw/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":3,"content":[{"type":"heading","content":["ዮናሳ ኣዛዜቴ"]},{"type":"verse","number":1,"content":["ጎዳ ቃላይ ናምኣን ዮናሳኮ፥"]},{"type":"verse","number":2,"content":["«ዴንዳዳ ሄ ጊታ ካታማ ናናዌ ባዳ ታኒ ኔስ ዮቲዛ ቃላ ኢስታስ ኣዋጃ» ጊሼ ዪዴስ።"]},{"type":"verse","number":3,"content":["ሂስቲን ዮናሲ ዴንዲዲ ጎዳ ቃላ ናናዌ ቢዴስ። ናናዌይ ኬሂ ጊታ ካታማ፤ ሃ ጋጻፔ ሄ ጋጻ ጋካናስ ሄ ጋላስ ሄሜስ።"]},{"type":"verse","number":4,"content":["ዮናሲ ናናዌ ካታማ ቢ ጋኪዲ ኢሲ ጋላሳ ኦጌ ማላ ካታማስ ጊዶ ቢዲ፥ «ኦይዱ ታሙ",{"noteId":0},"ጋላሳፌ ጉዬ ናናዌይ ያና» ጊዲ ኣዋጂዴስ።"]},{"type":"verse","number":5,"content":["ሂስቲን ናናዌ ኣሳይ ጾሳ ኣማኒዲ ጾማ ኣዋጂዴስ፤ ጊታታፔ ጉታ ጋካናስ ዉሪካ ማቃ ማይኢዳ።"]},{"type":"verse","number":6,"content":["ዮኦዚ ናናዌ ካዎኮ ጋኪን ኢዚ ባ ካዎቴ ኣራታፔ ዎዲ ካዎቴ ማይኦ ማይኢዳይሳ ቃሪዲ ማቃ ማይኢዲ ቢዲንን ኡቲዴስ።"]},{"type":"verse","number":7,"content":["ሂስቲዲ ናናዌ ኣሳስ፥ «ካዎዛፔኔ ካዎ ኦሳንቻታፔ ኢሜቲዳ ኣዛዞ ማላ ሃቺፌ ዶሚዲ ኣሲኔ ሜሄይ ኡባይ ኣይኮካ ሞፖ፤ ሃካ ኡዮፖ።"]},{"type":"verse","number":8,"content":["ኣሳይካ ሜሄይካ ዉሪ ማቃ ማይኦ፤ ኣሲ ዉሪ ሚንዲ ጾሳኮ ዋሶ፤ ባ ኢታ ኦጌፔኔ ቆሆ ኦሶፔካ ሲሞ።"]},{"type":"verse","number":9,"content":["ሂስቲኮ ጾሳይ ኑስ ቃቲዲ ኑ ዮንታ ማላ ባ ዎልቃማ ሃንቆፌ ሲማናኮ ኦኔ ኤሪዛይ» ጊዴስ።"]},{"type":"verse","number":10,"content":["ኢስቲ ባ ኢታ ኦጌፔ ሲሚዳይሳ ጾሳይ ቤኢዲ ኢስታስ ቃቲዲ ኢስታ ቦላ ኤሃና ጊዳ ፒርዳ ኣጊዴስ።"]}],"footnotes":[{"noteId":0,"caller":"+","text":"3፡4 ኦይዱ ታሙ ጊዛይሳ ላፑን ታሙ ኤራንቻታ ቢርሼን ሄ ጋላስ ጌስ።","reference":{"chapter":3,"verse":4}}]},"thisChapterLink":"/api/gmv_etw/JON/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/JON/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/JON/2.json","previousChapterAudioLinks":{},"numberOfVerses":10}