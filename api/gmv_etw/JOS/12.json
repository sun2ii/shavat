{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"JOS","translationId":"gmv_etw","name":"ኢያሶ ማጻፋ","commonName":"ኢያሶ ማጻፋ","title":"ኢያሶ ማጻፋ","order":6,"numberOfChapters":24,"sha256":"5d90d8f00856a0268d9621bc8b24673641a625b0c0c6be9d3098075a9ccf2222","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/JOS/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/gmv_etw/JOS/24.json","totalNumberOfVerses":657},"chapter":{"number":12,"content":[{"type":"heading","content":["ሙሴይኔ ኢያሶይ ጾኒዳ ካዎታ"]},{"type":"verse","number":1,"content":["ኢስራኤሌ ኣሳይ ዮርዳኖሴ ሻፋፔ ኣርሼይ ሞኪዛ ባጋራ ዲዛ ኣራቤ ቢታ ኡባ ኦይኪዲ ኣርኖኔ ዙሌራ ቢዲ ሄርሞኔ ዙማ ጋካናስ ዲዛ ሄ ዴሬ ካዎታ ጾኒዲ ዎ ኤኪዴስ። ሄ ጾኔቲዳ ካዎቲ ሃይሳፌ ካሊ ጻፌቲዳይታ።"]},{"type":"verse","number":2,"content":["ሃሴቦኔ ካታማን ኡቲዲ ኣይሲዛ ኣሞሬታ ካዎይ ሲሆኔ። ኢዚ ኣርኖኔ ሾባ ላንቄን ዲዛ ኣሮኤሬ ዙሌራ ካን ቢዲ ኣሞኔታ ዛዋ ያቦቄ ሻፋ ጋካናስ ሃሪዴስ፤ ሄሲ ጋላኣዴ ቢታፌ ባጋ ጉጂ ኤኬስ።"]},{"type":"verse","number":3,"content":["ቃሴካ ኣርሼይ ሞኪዛ ባጋራ ዮርዳኖሴ ሾባፌ ቢዲ ጋሊላ ኣባ ጋካናስ፥ ቤቲ-ያሺሞቴ ባጋራ ቢዲ ማጺኔ ኣባፌ ዱጌሃ ባጋራ ዲዛ ፒዝጋ ዙማስ ዳንኤ ባጋ ጋካናስ ዲዛሶዛ ሃሪዴስ።"]},{"type":"verse","number":4,"content":["ኣስታሮቴኒኔ ኤዲራኤን ኡቲዲ ሃሪዛ ኤራፋይሜ ዜሬታፔ ዉርሴ ቦላ ካዎቲዳይ ባሳኔ ካዎ ኣጌ።"]},{"type":"verse","number":5,"content":["ኢዚ ሄርሞኔ ዙማ፥ ሳላካ፥ ባሳኔ ቢታ ኡባ፥ ቢዲ ጌሹሬታኔ ማኢካቴ ዛዋ ጋካናስ፥ ቃሴካ ጋላኣዴ ቢታፌ ባጋ ኤኪ ቢዲ ሃሴቦኔ ካዎ ሲሆኔ ዛዋ ጋካናስ ሃሪዴስ።"]},{"type":"verse","number":6,"content":["ጎዳ ኣሽካራ ሙሴይኔ ኢስራኤሌ ኣሳይ ሃ ካዎታ ጾኒዳ፤ ሂስቲዲ ጎዳ ኣይሌ ሙሴይ ኢስታ ቢታ ኦሮቤሌ ቆሞታስ፥ ጋዴ ቆሞታሲኔ ሚናሴ ቆሞታፔ ባጋይታስ ጺንጾ ጊዳና ማላ ሻኪ ኢሚዴስ።"]},{"type":"verse","number":7,"content":["ኢያሶይኔ ኢስራኤሌ ኣሳይ ዮርዳኖሴ ሻፋፔ ኣርሼይ ዉሊዛ ባጋን ዲዛ ካዎታ ኡባ ጾኒዳ። ሄይቲ ሃሪዛ ዛዋይ ሊባኖሴ ሾባን ዲዛ ባኣሊ-ጋዴፔ ዶሚዲ ሴይሬን ሃላቄ ዙማ ጋኬስ፤ ኢያሶይ ሄ ቢታታ ሻኪዲ ኢስራኤሌ ቆሞታስ ጺንጾ ሂስቲ ኢሚዴስ።"]},{"type":"verse","number":8,"content":["ሄ ቢታቲ፥ ጌዜ ዴሬ፥ ኣርሼይ ዉሊዛሶ ባጋን ዲዛ ዙምቡላታ ላዴ፥ ኣራቤ ዙማታ ላዴ፥ ባዞ ቢታኔ ኔጌቤ ቢታ። ሄ ቢታቲ ካሴ ሂቴቲ፥ ኣሞሬቲ፥ ካናኔቲ፥ ፓሪዜቲ፥ ሂዌቲኔ ያቡሴቲ ዴኢዛ ቢታ።"]},{"type":"verse","number":9,"content":["ኢስራኤሌ ኣሳይ ጾኒዳ ካዎቲ ሃይሳፌ ካሊ ዲዛይታ፤ ኢያርኮ ካዎ፥ ቤቴሌ ማታን ዲዛ ኣዬ ካዎ፥"]},{"type":"verse","number":10,"content":["ዬሩሳላሜ ካዎ፥ ኬብሮኔ ካዎ፥"]},{"type":"verse","number":11,"content":["ያርሙቴ ካዎ፥ ላኪሼ ካዎ፥"]},{"type":"verse","number":12,"content":["ኤጊሎኔ ካዎ፥ ጌዜሬ ካዎ፥"]},{"type":"verse","number":13,"content":["ዳቢሬ ካዎ፥ ቤቲ-ጋዴራ ካዎ፥"]},{"type":"verse","number":14,"content":["ሆርማ ካዎ፥ ኣራዴ ካዎ፥"]},{"type":"verse","number":15,"content":["ሊቢና ካዎ፥ ኣዱላሜ ካዎ፥"]},{"type":"verse","number":16,"content":["ማቄዳ ካዎ፥ ቤቴሌ ካዎ፥"]},{"type":"verse","number":17,"content":["ታጱሄ ካዎ፥ ሄፌሬ ካዎ፥"]},{"type":"verse","number":18,"content":["ኣፌቄ ካዎ፥ ላሻሮኔ ካዎ፥"]},{"type":"verse","number":19,"content":["ሜዶኔ ካዎ፥ ሃጾሬ ካዎ፥"]},{"type":"verse","number":20,"content":["ሺሚሮኔ-ሚሮኔ ካዎ፥ ኣኪሻፌ ካዎ፥"]},{"type":"verse","number":21,"content":["ታኢናኬ ካዎ፥ ማጊዶ ካዎ፥"]},{"type":"verse","number":22,"content":["ቃዴሴ ካዎ፥ ቃርሜሎሴን ዲዛ ዮቂናኣሜ ካዎ፥"]},{"type":"verse","number":23,"content":["ዙምቡላታ ቦላ ዲዛ ዶሬ ካዎ፥ ጌልጌላን ዲዛ ጎይሜ ካዎ፥"]},{"type":"verse","number":24,"content":["ቲርጻ ካዎ። ሄይቲ ኢሲ ቦላ 31 ካዎታ።"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/JOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/JOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/JOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":24}