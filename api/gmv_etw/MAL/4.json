{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"MAL","translationId":"gmv_etw","name":"ሚልካሳ ቲንቢቴ","commonName":"ሚልካሳ ቲንቢቴ","title":"ሚልካሳ ቲንቢቴ","order":39,"numberOfChapters":4,"sha256":"3f5e374ece4fcff4a8f93b4e4f1f3c0c77a36b9c1aa80855ba1f468f79cea747","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/MAL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/gmv_etw/MAL/4.json","totalNumberOfVerses":55},"chapter":{"number":4,"content":[{"type":"heading","content":["ፒርዳ ጋላስ"]},{"type":"verse","number":1,"content":["«ሄኮ ጮጬ ታማ ማላ ኤጺዛ ጋላሲ ያና፤ ኦቶራንቻቲኔ ኢታ ኦዛይቲ ዉሪካ ሜላ ሃፓ ማላ ጊዳና፤ ሄ ያና ጋላሳይካ ኢስታ ጹጋና፤ ጼራካ ጻጶካ ኣሼና» ጌስ ኡባፌ ዎልቃማ ጎዳ ጾሳይ።"]},{"type":"verse","number":2,"content":["«ታ ሱንስ ባቢዛ ኢንቴስ ቃሴ ጺሎቴ ኣርሼይ ባ ቄፌ ጋርሳን ፓዛዝ ኤካ ያና፤ ኢንቴካ ቢርሺ ዬዲዳ ጋሎ ማራ ማላ ጺኬቲሼ ኬዛና።"]},{"type":"verse","number":3,"content":["ታኒ ኦዛ ጋላስ ኢንቴ ኢታታ ኢንቴ ቶሆ ጋርሳን ዬና፤ ኢስቲ ኢንቴ ቶሆ ጫማ ጋርሳን ቢዲን ጊዳና» ጌስ ኡባፌ ዎልቃማ ጎዳ ጾሳይ።"]},{"type":"verse","number":4,"content":["«ኢስራኤሌ ናይቲ ኡባይ ኣዛዜታና ማላ ታኒ ታ ኦሳንቻ ሙሴ ባጋራ ኮሬቤ ዙማ ቦላ ታ ኢሚዳ ዎጋኔ ኣዛዞታ ቆፒቴ» ጌስ ኡባፌ ዎልቃማ ጎዳ ጾሳይ።"]},{"type":"verse","number":5,"content":["«ሄኮ ኬሂ ጊታኔ ያሺሲዛ ኡባፌ ዎልቃማ ጎዳ ጋላሳይ ጋካናፔ ካሴ ታ ኢንቴስ ናቤ ኤላሳ ዬዳና» ጌስ ኡባፌ ዎልቃማ ጎዳይ።"]},{"type":"verse","number":6,"content":["«ታ ያዳ ቢታ ቃንጌን ይሶንታ ማላ ኢዚ ኣዋታ ዎዚና ናይታኮ፥ ቃሴ ናይታ ዎዚና ኣዋታኮ ዛራና» ጌስ ኡባፌ ዎልቃማ ጎዳይ።"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/MAL/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/MAT/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/MAL/