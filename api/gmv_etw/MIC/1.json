{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"MIC","translationId":"gmv_etw","name":"ሚኪያሳ ቲንቢቴ","commonName":"ሚኪያሳ ቲንቢቴ","title":"ሚኪያሳ ቲንቢቴ","order":33,"numberOfChapters":7,"sha256":"21e8246d270a60253c5252fb9da8faec8e791d6fb7f8b9f0e07d0a4bbcbdc44f","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/gmv_etw/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["ዩሁዳ ካዎ ኢዮኣታሜ፥ ኣካዜኔ ሂዝቂያሳ ዎዴ ሞሬሼቴ ኣስ ጊዲዳ ሚኪያሳኮ ሳማሪያ ጊሻሲኔ ዬሩሳላሜ ጊሻስ ዪዳ ጾሳ ቃላይ ሃይሳ፥"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ኢንቴኖ ዴሬቶ፤","poem":1},{"text":"ኢንቴ ዉሪካ ሲዪቴ!","poem":2},{"lineBreak":true},{"text":"ሃ ቢታ ቦላ ዲዛይቲ ዉሪካ","poem":2},{"text":"ሃ ኤዝጊ ሲዪቴ፤","poem":3},{"text":"ሳሎ ጎዳይ ባ ጌሻ ኬን","poem":2},{"text":"ኡቲዲ ኢንቴ ኢታ ኦሶዛ","poem":3},{"lineBreak":true},{"text":"ኢንቴ ቦላ ማርካቴስ።","poem":3}]},{"type":"heading","content":["ሳማሪያ ቦላኔ ዬሩሳላሜ ቦላ ዪዳ ፒርዳ"]},{"type":"verse","number":3,"content":[{"text":"ሄኮ ጾሲ ባ ዲዛሶፔ ያና፤","poem":1},{"text":"ዪዲካ ቢታ ቦላን","poem":2},{"lineBreak":true},{"text":"ቃሶሆን","poem":2},{"text":"ቃሶሆን ሄሜታና።","poem":3}]},{"type":"verse","number":4,"content":[{"text":"ሙቃዳይ ታማ ቤኢዲ","poem":1},{"text":"ሴሪዛ ማላኔ","poem":2},{"lineBreak":true},{"text":"ሃ ኣፎራ","poem":2},{"lineBreak":true},{"text":"ዱጌ ጎጊዛ ማላ","poem":2},{"text":"ሄ ዎዴ ዙማቲ","poem":3},{"lineBreak":true},{"text":"ኢዛ ቶሆ ጋርሳን ሴራና፤","poem":3},{"text":"ሾባቲካ ጳልቄቲ","poem":2},{"lineBreak":true},{"text":"ዎና።","poem":2}]},{"type":"verse","number":5,"content":["ሄሲ ዉሪ ሃናናይ ያቆቤይ ኦዳ ሞሮ ጊሻሲኔ ኢስራኤሌ ናይታ ናጋራ ጊሻሳ፤ ኢስራኤሌ ኣሳይ ኢታ ኦናስ ጋሶ ጊዲዳይ ኦኔ? ኢዚስ ዋና ካታማዮ ሳማሪያ ጊዴኬ? ዩሁዳ ኣሳይ ኤቃ ጎይኒዲ ናጋራ ኦና ማላ ጋዳይ ኦኔ? ዬሩሳላሜ ጊዴኬ?"]},{"type":"verse","number":6,"content":["ሄሳ ጊሻስ ታኒ ሳማሪያ ኬ ላሌቲዳሶኔ ዎይኔ ሚ ቶኬቲዛሶ ኬሳና፤ ኢዛ ኬጼቲዳ ዮቻ ሹቻ ታ ዱጌ ሾባን ኦላናኔ ኢዚ ጻጶ ሾዳ ይሳና።"]},{"type":"verse","number":7,"content":["ኢዚ ኤቃቲ ዉሪካ ሜቄሬታና፤ ኢዚ ኤቃ ኬን ዲዛ ላይማቲዛይታስ ኢሜቲዳዚ ዉሪ ታማን ጹጌታና፤ ኢዚ ሚስሌታካ ኡባ ታ ይሳና፤ ኢዛ ባስ ኢሜቲዳይሳ ላይማን ሺሺዳ ማላ ሃኢካ ኢዚስ ዲዛዚ ላይማን ኤኪዛዝ ጊዳና።"]},{"type":"heading","content":["ዬሆኔ ጬጬ"]},{"type":"verse","number":8,"content":["ሄሳ ጌዶን ታኒ ዬካይስ፥ ዉ! ዉይ ጋይስ፤ ታ ጫማይ ባይንዳ ሜላ ቶሆኒኔ ሜላ ካሎ ባይስ፤ ዎራካና ማላ ዋሳይስ፤ ጉቶ ማላ ዋሳይስ።"]},{"type":"verse","number":9,"content":["ኢዚ ማዱንይ ፓጾንታዝ ጊዳና፤ ኢዚፔ ኣ ዩሁዳሳራ ጊዳና፤ ታ ዴሬይ ጌሊዛ ፔንጌ ዬሩሳላሜ ጋኪዴስ።"]},{"type":"verse","number":10,"content":["ጌቴ ዴሬን ሃሳዮፒቴ፤ ዬሆ ሙሌካ ዬኮፍቴ፤ ቤቲ-ሊኦፋራን ጉዱላ ቦላ ጌንዴሬቲቴ።"]},{"type":"verse","number":11,"content":["ኢንቴኖ ሻፊሬን ዲዛይቶ ማይኦይ ባይንዳ ካሎ ዬላቲሼ ኣቴ፤ ጻኢናን ዲዛይቲ ሄፔ ኬዜቴና፤ ቤቲ-ኤዜሌይ ጬጬ ቦላ ዳዉስ፤ ኢንቴስካ ጋኪ ሼምፓናሶ ጊዳናስ ዳንዳዩኩ።"]},{"type":"verse","number":12,"content":["ሜቶፔ ሼምፓናስ ኮሻን ማሮቴን ዲዛይቲ ሜቶን ዋዬቴቴስ፤ ሄሲካ ዬሩሳላሜ ፔንጌ ጋካናስ ኢታ ሜቶይ ጾሳ ኣቻፌ ዪዳ ጊሻሳ።"]},{"type":"verse","number":13,"content":["ኢንቴኖ ላኪሼን ዲዛይቶ ፓራታ ጋሬራ ጋ ኦይሴቴ። ጺዮኔ ማጫ ናይታስ ኮይሮ ናጋራይ ኢንቴናኮ። ኢስራኤሌስ ቆሆይ ኢንቴ ኣቻፌ ቤቲዴስ።"]},{"type":"verse","number":14,"content":["ሄሳ ጊሻስ ኢንቴ ሞሬሼት-ጋቴስ ኢሞታ ኢማና፤ ኣኪዚቤ ካታማይ ኢስራኤሌ ካዎታ ባሌዛ ካታማ ጊዳና።"]},{"type":"verse","number":15,"content":["ኢንቴኖ ማሬሻን ዲዛይቶ! ታ ኢንቴና ጾኒዛዴ ኢንቴ ቦላ ኤሃና፤ ኢስራኤሌስ ቦንቾ ጊዲዳዚ ኣዱላሜ ሃ ያና።"]},{"type":"verse","number":16,"content":["ኢንቴ ኢስታን ኡፋዬቲዛ ኢንቴ ናይቲ ኢንቴፌ ዲኤቲ ባና ጊሻስ ኢንቴ ሁኤ ቡሉሲቴ።"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}