{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"MIC","translationId":"gmv_etw","name":"ሚኪያሳ ቲንቢቴ","commonName":"ሚኪያሳ ቲንቢቴ","title":"ሚኪያሳ ቲንቢቴ","order":33,"numberOfChapters":7,"sha256":"21e8246d270a60253c5252fb9da8faec8e791d6fb7f8b9f0e07d0a4bbcbdc44f","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/gmv_etw/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["ጾሳ ዙማ"]},{"type":"verse","number":1,"content":["ዉርሴ ዎዴ",{"text":"ጾሳ ኬ","poem":1},{"text":"ኢዛ ቦላ ዲዛ ዙማይ","poem":2},{"lineBreak":true},{"text":"ሃራ ዙማ ኡባፌ","poem":2},{"lineBreak":true},{"text":"ኣ ቤታና፤","poem":2},{"lineBreak":true},{"text":"ሃራ ዙማታፔ ቦላራ","poem":2},{"lineBreak":true},{"text":"ቁ ጋና፤","poem":2},{"lineBreak":true},{"text":"ዴሬይካ ኢዛኮ ጎቻና።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዳሮ ካዎቴቲ ኢዛኮ ዪዲ፥","poem":1},{"text":"«ጾሳ ዙማኮ ሃ ዪቴ፤","poem":2},{"lineBreak":true},{"text":"ያቆቤ ጎዳኮ ኣኔ ቦስ፤","poem":2},{"lineBreak":true},{"text":"ኑ ኢዛ ኦጌራ ባና ማላ","poem":2},{"text":"ኑና ኢዚ ባ ኦጌ","poem":3},{"lineBreak":true},{"text":"ታማርሳና» ጊዳ፤","poem":3},{"text":"ዎጋይ ጺዮኔፔ፥ ጾሳ ቃላይ","poem":2},{"text":"ቃሴ ዬሩሳላሜፔ ያና።","poem":3}]},{"type":"verse","number":3,"content":[{"text":"ኢዚ ዳሮ ኣሳ ጊዶን ፒርዳና፤","poem":1},{"text":"ሃሆኒኔ ማታን ዲዛ","poem":2},{"text":"ዎልቃማ ካታማ ጊዶን ዲዛ","poem":3},{"lineBreak":true},{"text":"ኦሽ ኤሳና፤","poem":3},{"text":"ኢስቲ ባ ጊ","poem":2},{"lineBreak":true},{"text":"ማሻ ማራሻ፥","poem":2},{"lineBreak":true},{"text":"ባ ቶራካ ባጫ ሂስቲ ቆጻና፤","poem":2},{"lineBreak":true},{"text":"ኢሲ ካዎይ ሃራ ካዎ ቦላ","poem":2},{"text":"ማሻ ዴንና፤","poem":3},{"text":"ሄሳፌ ጉዬ ኢስቲ","poem":2},{"lineBreak":true},{"text":"ኦላ ቲሚርቴ ታማሬቴና።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኢሲ ኣሲ ባ ዎይኔ ሚ ጋርሳንካ","poem":1},{"text":"ባ ባላሴ ሚ ጋርሳን ኡታና፤","poem":2},{"lineBreak":true},{"text":"ኢስታ ባቢሲዛ ሚሺ ዴና፤","poem":2},{"lineBreak":true},{"text":"ኡባፌ ዎልቃማ","poem":2},{"lineBreak":true},{"text":"ጎዳ ዶናይ","poem":2},{"text":"ሃይሳ ዮቲዴስ።","poem":3}]},{"type":"verse","number":5,"content":["ሃንኮ ዴሬይ ባ ኤቃ ሱንን ቤስ፤ ኑኒ ቃሴ ሜርናፔ ሜርና ጋካናስ ኑ ጎዳ ሱንን ባና።"]},{"type":"heading","content":["ቡሮፔ ሃናና ጾሳ ቆፋ"]},{"type":"verse","number":6,"content":["ጎዳይ፥ «ታኒ ሄ ጋላስ ጉንዲዳይታ ሺሻና፤ ቤቴ ቢዳይታኔ ሙዞታና ማላ ታ ኣ ኢሚዳይታ ኡባ ኢሲሶ ሺሻና።"]},{"type":"verse","number":7,"content":["ጉንዳታፔ ኣቲዳይታኔ ቆሄቲዳይታ ታ ኢስታ ሚኖ ዴሬ ኬሳና፤ ሄ ጋላሳይፌ ዶሚዲ ሜርና ጋካናስ ጎዳይ ጺዮኔ ዙማን ኢስታ ቦላ ካዎታና።"]},{"type":"verse","number":8,"content":["ሃይሶ ኔናን ኡቲዲ ሜሄ ሄሚዛ ቃ ዙማዞ! ጺዮኔ ማጫ ናይታ ናጋና ጊጋ ኡቲዳ ዙማዞ! ቤኒ ኔ ሃሪዛ ዴሬይ ኔስ ሲማና፤ ኔ ካዎቴይ ዬሩሳላሜ ማጫ ናይስ ጊዳና።"]},{"type":"verse","number":9,"content":["ሂስቲን ኔ ሃኢ ኣዛስ ዋሳይ? ኔስ ካዎይ ባዬ? ኔኒ ሚጻይ ኦይኪዳ ማጫሳይ ማላ ኡንኤቲዳይ ኔና ዞሪዛይ ይኔ?"]},{"type":"verse","number":10,"content":["ሃኔ ጺዮኔ ማጫ ናዬ! ሚጻቲዛ ማጫሳይ ማላ ኔ ሜቶታና፤ ሃኢ ቃሴ ኔ ካታማፔ ጌዴ ኬዛዳ ጮ ዴምባን ዴኣና ቤሲዛ ጊሻስ ባቢሎኔ ባና፤ ኔ ሄ ባዳ ሄን ኔ ሞርኬታ ኩሼፔ ኣታና፤ ጎዳይ ኔና ሄን ኔ ሞርኬታፔ ኣሻና።"]},{"type":"verse","number":11,"content":["ሃኢ ቃሴ ዳሮ ሃንኮ ዴሬ ኣሳይ ኔ ቦላ ሺቂዴስ፤ ኢስቲካ፥ ‹ሃና ቱኒዳዝ ጊዱ! ኑ ኣይፌይ ጺዮኖ ቂን ጼሎ› ጋና።"]},{"type":"verse","number":12,"content":["ጊዶ ኣቲን ኢስቲ ጾሳ ቆፋ ኤሬቴና፤ ቡኬታናስ ባሌን ሺቂዛ ሚርቄ ካ ማላ ባና ሺሺዛዴ ቆፋ ኢስቲ ኤሬቴና።"]},{"type":"verse","number":13,"content":["ሃኔ ጺዮኔ ናዬ ዴንዳዳ ካ ቡካ፤ ታ ኔስ ቢራታ ካጬኔ ጻርቂማላ ጹጉን ኢማና፤ ኔካ ሃንኮ ዴሬዛ ኢዛን ሊቂሳና» ጊዴስ። ኢስቲ ጌኔን ሺሺዳይሳ ጾሳስ፥ ኢስታ ሃሮካ ኡባ ቢታ ኡባ ሃሪዛ ጎዳስ ኔ ሺሻንዳሳ።"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}