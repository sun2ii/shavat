{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"NUM","translationId":"gmv_etw","name":"ታይቦ","commonName":"ታይቦ","title":"ታይቦ ማጻፋ","order":4,"numberOfChapters":36,"sha256":"142a1508486607d8cc174463cf303de9e2b5ed8fea10663f9f3ce8f863876692","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/gmv_etw/NUM/36.json","totalNumberOfVerses":1271},"chapter":{"number":12,"content":[{"type":"heading","content":["ሙሴ ቦላ ማራሚኔ ኣሮኔ ዴንዶ"]},{"type":"verse","number":1,"content":["ሙሴይ ቶጵያፔ ማቾ ኤኪዳ ጊሻስ ማራማኔ ኣሮኔይ ዚጊርሳን ኢዛ ሂዝጊ ካዳ፥"]},{"type":"verse","number":2,"content":["«ጎዳይ ሙሴ ባጋራ ጻላ ሃሳይዴ? ኑ ባጋራ ሃሳይቤኔ?» ጎዳይ ኢስቲ ጊዳይሳ ኡባካ ሲዪዴስ።"]},{"type":"verse","number":3,"content":["ሙሴይ ጊዲኮ ቢታ ቦላ ዲዛ ኣሳ ኡባፌ ኣዳ ኣሽኬ ኣሳ።"]},{"type":"verse","number":4,"content":["ሄራካ ጎዳይ ሙሴ፥ ኣሮኔኔ ማራሞ፥ «ኢንቴ ሄይ ጋይቶቴ ዱንካኔኮ ሃ ዪቴ!» ጊዴስ፤ ኢስቲካ ቢዳ።"]},{"type":"verse","number":5,"content":["ሂስቲን ጎዳይ ቱስ ሚሳቲዛ ሻራ ጊዶራ ዎዲ ዱንካኔዛ ፔንጌን ኤቂዲ፥ «ሃይሶ ኣሮኔ! ሃኔ ማራሜ!» ጊ ጼይጊዴስ፤ ናምኣቲካ ጌዴ ኢዛ ሲን ሺቂዳ።"]},{"type":"verse","number":6,"content":["ጎዳይ ኢስታስ፥ «ሄኮ ሃኢ ታ ኢንቴና ጊዛይሳ ኣኬኪ ሲዪቴ!",{"text":"«ኢንቴ ጊዶን ናቤቲ ዲኮ፥","poem":1},{"text":"ታኒ ታና ኢስታስ","poem":2},{"lineBreak":true},{"text":"ኣጁታን ቆንጪሳይስ፤","poem":2},{"lineBreak":true},{"text":"ኣጉሞን ኢስታ ሃሳይሳይስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታኒ ታስ ሃጋዚዛ","poem":1},{"text":"ሙሴራ ጊዲኮ","poem":2},{"lineBreak":true},{"text":"ሄሳ ማላን ሃሳይኬ፤","poem":2},{"lineBreak":true},{"text":"ኢዚ ታ ኬን","poem":2},{"lineBreak":true},{"text":"ኣማኔቲዳ ኣሳ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሄሳ ጊሻስ ታኒ ኢዛራ ሲንን","poem":1},{"text":"ቆንጬራ ሃሳያይስ ኣቲን","poem":2},{"text":"ጉዬራ ቆታን ሃሳይኬ፤","poem":3},{"text":"ኢዚ ታ ሜ ቤዬስ፤","poem":2},{"lineBreak":true},{"text":"ሂስቲን ኢንቴ ታ ኦሳንቻዛ","poem":2},{"lineBreak":true},{"text":"ሙሴ ቦላ","poem":2},{"text":"ዋኒ ያዮንታ ካ ቃላ","poem":3},{"lineBreak":true},{"text":"ሃሳይዴቲ?» ጊዴስ።","poem":3}]},{"type":"verse","number":9,"content":["ጎዳ ሃንቆይ ኢስታ ቦላ ታማ ማላ ኤጺ ኬዚዴስ፤ ኢዚካ ኢስታ ሄን ኣጊ ቢዴስ።"]},{"type":"verse","number":10,"content":["ሻራዚ ዱንካኔዛ ቦላፌ ዴንዲ ቢን ማራማ ኢንቺራቻ ሃርጋንቻ ጊዳዱስ፤ ኢንቺራቻ ሃርጌዚካ ኢዚ ቦላ ሻቻ ማላ ቦዴስ፤ ኣሮኔይ ማራሞ ቤዪሺን ኢዛ ኢዛስ ኢንቺራቻ ሃርጋንቻ ጊዳ ቤታዱስ።"]},{"type":"verse","number":11,"content":["ኣሮኔይ ሙሴስ፥ «ታ ጎዶ! ኑኒ ኔ ቦላ ኦዳ ናጋራ ጋሶን ሃይሲ ኢታ ቂጻቴይ ኑ ቦላ ፖሌታና ማላ ኦፋርኪ!"]},{"type":"verse","number":12,"content":["ኢዛካ ባ ኣዪ ኡሎን ሃይቃዳ ኢዚስ ባጋ ኣሳቴይ ሜቴቲቺን ዬሌቲዳ ኣዉጫያ ና ማላ ኦፋርኪ!» ጊዴስ።"]},{"type":"verse","number":13,"content":["ሄሳ ጊሻስ ሙሴይ፥ «ጾሳዉ! ኢዞ ፓርኪ!» ጊዲ ፑዴ ጎዳኮ ዋሲዴስ።"]},{"type":"verse","number":14,"content":["ጎዳይካ ሙሴስ፥ «ኢዚ ኣዋይ ኣይፌሶን ጩች ጩቲዳራካ ዬላታዳ ላፑን ጋላስ ጋካናስ ጋምኣ ኤሬኬ? ሄሳ ጊሻስ ኢዛ ኣሳይ ዲዛ ሄራፔ ኬዛዳ ላፑን ጋላስ ጋካናስ ኣሲ ባይንዳሶን ታካሹ፤ ሄሳፌ ጉዬ ኣሳይ ዲዛሶ ጌላናስ ዳንዳያዉስ» ጊ ዛሪዴስ።"]},{"type":"verse","number":15,"content":["ሄሳ ጊሻስ ማራማ ኣሲ ዲዛ ጉታፔ ካሬ ኬዛዳ ላፑን ጋላስ ጋካናስ ባና ጌንዱስ፤ ኢዛ ሄፔ ሲማና ጋካናስ ዴሬዚ ባ ዲዛሶፔ ሃራሶ ቃጺቤና።"]},{"type":"verse","number":16,"content":["ሄሳፌ ጉዬ ኣሳይ ሃጺሮቴፔ ዴንዲዲ ፓራኔ ባዞን ዱንካኒ ኡቲዴስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/NUM/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/NUM/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/NUM/11.json","previousChapterAudioLinks":{},"numberOfVerses":16}